;; Arbace's C target, x86_64-linux-musl: the facts its predefined macros are computed from (c/README.md; test/c/target.ae,
;; `bin/repr-c target gen`). Sources: the System V Application Binary Interface, AMD64 Architecture Processor Supplement
;; (version 1.0, §3.1.2 "Data Representation": the types' sizes and alignments, LP64), ISO/IEC 9899:2024 (C23) §5.2.5.3
;; (the limits and the floating characteristics' formulas, §5.2.5.3.3 and Annex H for the interchange and extended types),
;; IEEE 754-2019 (binary16, binary32, binary64, binary128; decimal32, decimal64, decimal128 in the BID encoding), Intel's
;; x87 extended format (64-bit significand, explicit integer bit, the exponent range of binary128) and bfloat16 (8-bit
;; significand, binary32's exponent). The dialect's identification (the GNU dialect Arbace reads, CS14 (a)) is in :dialect.
;; Read with the Clojure reader.
{:data-model :lp64
 :char-bit 8
 :char-signed true
 :byte-order :little
 ;; the integer types: size in bytes, signedness; :name is the spelling the type macros use (the declaration
 ;; specifiers in the order int, its sign, then its length: "long unsigned int")
 :int-types
 {:schar {:size 1 :signed true :name "signed char"}
  :uchar {:size 1 :signed false :name "unsigned char"}
  :short {:size 2 :signed true :name "short int"}
  :ushort {:size 2 :signed false :name "short unsigned int"}
  :int {:size 4 :signed true :name "int"}
  :uint {:size 4 :signed false :name "unsigned int"}
  :long {:size 8 :signed true :name "long int"}
  :ulong {:size 8 :signed false :name "long unsigned int"}
  :llong {:size 8 :signed true :name "long long int"}
  :ullong {:size 8 :signed false :name "long long unsigned int"}}
 ;; the integer constants' suffixes by type (after the integer promotions: a type narrower than int takes none)
 :suffix {:schar "" :uchar "" :short "" :ushort "" :int "" :uint "U" :long "L" :ulong "UL" :llong "LL" :ullong "ULL"}
 ;; <stdint.h>'s and <stddef.h>'s types as the ABI and musl's arch/x86_64 choose them
 :typedefs
 {"INT8" :schar "INT16" :short "INT32" :int "INT64" :long
  "UINT8" :uchar "UINT16" :ushort "UINT32" :uint "UINT64" :ulong
  "INT_LEAST8" :schar "INT_LEAST16" :short "INT_LEAST32" :int "INT_LEAST64" :long
  "UINT_LEAST8" :uchar "UINT_LEAST16" :ushort "UINT_LEAST32" :uint "UINT_LEAST64" :ulong
  "INT_FAST8" :schar "INT_FAST16" :int "INT_FAST32" :int "INT_FAST64" :long
  "UINT_FAST8" :uchar "UINT_FAST16" :uint "UINT_FAST32" :uint "UINT_FAST64" :ulong
  "INTMAX" :long "UINTMAX" :ulong "INTPTR" :long "UINTPTR" :ulong
  "PTRDIFF" :long "SIZE" :ulong "WCHAR" :int "WINT" :uint "SIG_ATOMIC" :int
  "CHAR8" :uchar "CHAR16" :ushort "CHAR32" :uint}
 ;; the sizes __SIZEOF_X__ names (bytes)
 :sizeof {"SHORT" 2 "INT" 4 "LONG" 8 "LONG_LONG" 8 "POINTER" 8 "SIZE_T" 8 "PTRDIFF_T" 8 "WCHAR_T" 4 "WINT_T" 4
          "FLOAT" 4 "DOUBLE" 8 "LONG_DOUBLE" 16 "FLOAT80" 16 "FLOAT128" 16 "INT128" 16}
 :biggest-alignment 16
 :bitint-maxwidth 65535
 ;; the binary floating types: the significand's digits p (with the integer bit), the exponent range [emin, emax] of
 ;; C23 §5.2.5.3.3 (x = s 2^e sum f_k 2^-k, emin <= e <= emax), IEC 60559 conformance, the constants' suffix; :cast wraps
 ;; the constants of double, written as long double's and cast (so that FLT_EVAL_METHOD's wider evaluation keeps them exact)
 :binary
 [{:id "FLT" :p 24 :emin -125 :emax 128 :iec true :suffix "F"}
  {:id "DBL" :p 53 :emin -1021 :emax 1024 :iec true :suffix "L" :cast "double"}
  {:id "LDBL" :p 64 :emin -16381 :emax 16384 :iec true :suffix "L"}
  {:id "FLT16" :p 11 :emin -13 :emax 16 :iec true :suffix "F16"}
  {:id "FLT32" :p 24 :emin -125 :emax 128 :iec true :suffix "F32"}
  {:id "FLT64" :p 53 :emin -1021 :emax 1024 :iec true :suffix "F64"}
  {:id "FLT128" :p 113 :emin -16381 :emax 16384 :iec true :suffix "F128"}
  {:id "FLT32X" :p 53 :emin -1021 :emax 1024 :iec true :suffix "F32x"}
  {:id "FLT64X" :p 64 :emin -16381 :emax 16384 :iec true :suffix "F64x"}
  {:id "BFLT16" :p 8 :emin -125 :emax 128 :iec false :suffix "BF16"}]
 ;; the constants' significant digits: binary128's DECIMAL_DIG, enough for every type here
 :float-digits 36
 :flt-eval-method 0
 ;; the decimal floating types (IEEE 754 BID): digits p and the exponent range of C23 §5.2.5.3.3 (x = s 10^e sum f_k 10^-k)
 :decimal
 [{:id "DEC32" :p 7 :emin -94 :emax 97 :suffix "DF"}
  {:id "DEC64" :p 16 :emin -382 :emax 385 :suffix "DD"}
  {:id "DEC128" :p 34 :emin -6142 :emax 6145 :suffix "DL"}
  {:id "DEC64X" :p 34 :emin -6142 :emax 6145 :suffix "D64x"}]
 :dec-eval-method 2
 ;; lock-free atomics (x86_64: every size up to 8 bytes, CMPXCHG8B; 2: always lock-free), the cache line
 :atomic-lock-free ["BOOL" "CHAR" "CHAR8_T" "CHAR16_T" "CHAR32_T" "WCHAR_T" "SHORT" "INT" "LONG" "LLONG" "POINTER"]
 :sync-cas [1 2 4 8]
 :cache-line 64
 ;; C11 7.17.3's memory orders as the __atomic builtins number them, x86's HLE flags
 :memory-orders [["RELAXED" 0] ["CONSUME" 1] ["ACQUIRE" 2] ["RELEASE" 3] ["ACQ_REL" 4] ["SEQ_CST" 5]
                 ["HLE_ACQUIRE" 65536] ["HLE_RELEASE" 131072]]
 ;; the ISA baseline (x86-64 v1: MMX, SSE, SSE2, FXSR; SSE for float math), the OS and object format
 :isa ["__MMX__" "__SSE__" "__SSE2__" "__FXSR__" "__SSE_MATH__" "__SSE2_MATH__" "__MMX_WITH_SSE__"
       "__SEG_FS" "__SEG_GS" "__code_model_small__" "__k8" "__k8__"]
 :system ["__amd64" "__amd64__" "__x86_64" "__x86_64__" "__linux" "__linux__" "__unix" "__unix__" "__ELF__"]
 ;; the names outside the implementation's namespace, defined in the GNU modes only
 :system-gnu ["linux" "unix"]
 ;; position-independent executables (2: -fPIE's large model), the stack protector (3: strong)
 :pic 2
 :ssp-strong 3
 ;; the execution character sets
 :charset "UTF-8"
 :wide-charset "UTF-32LE"
 ;; the macros of the implementation's <stdc-predef.h>, which it includes first (musl 1.2.6's, include/stdc-predef.h)
 :stdc-predef [["_STDC_PREDEF_H" ""] ["__STDC_ISO_10646__" "201206L"] ["__STDC_IEC_559__" "1"]]
 :stdc-utf [16 32]
 ;; C23 6.10.4's #embed results
 :embed [["NOT_FOUND" 0] ["FOUND" 1] ["EMPTY" 2]]
 ;; the dialect (CS14 (a): Arbace reads the GNU dialect of C as gcc 15.2 defines it, and identifies as it)
 :dialect {:gnuc [15 2 0] :version "15.2.0" :gxx-abi 1020
           :flags [["__GCC_ASM_FLAG_OUTPUTS__" "1"] ["__GCC_HAVE_DWARF2_CFI_ASM" "1"] ["__GCC_IEC_559" "2"]
                   ["__GCC_IEC_559_COMPLEX" "2"] ["__HAVE_SPECULATION_SAFE_VALUE" "1"] ["__NO_INLINE__" "1"]
                   ["__FINITE_MATH_ONLY__" "0"] ["__PRAGMA_REDEFINE_EXTNAME" "1"] ["__REGISTER_PREFIX__" ""]
                   ["__USER_LABEL_PREFIX__" ""]]}
 ;; the standards: __STDC_VERSION__ (none for C89), char8_t (C23 on), C99's inline semantics (C99 on), strict (the
 ;; ISO modes)
 :stds {"c89" {:version nil :strict true} "c94" {:version "199409L" :strict true} "c99" {:version "199901L" :strict true}
        "c11" {:version "201112L" :strict true} "c17" {:version "201710L" :strict true}
        "c23" {:version "202311L" :strict true} "c2y" {:version "202500L" :strict true}
        "gnu89" {:version nil} "gnu99" {:version "199901L"} "gnu11" {:version "201112L"} "gnu17" {:version "201710L"}
        "gnu23" {:version "202311L"} "gnu2y" {:version "202500L"}}
 ;; the date macros' fixed time (CS43 (a): 2026-10-28 00:00:00 UTC)
 :epoch 1793145600}

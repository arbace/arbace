;; The dialect Arbace's C reads (c/README.md; CS14 (a): GNU C as gcc 15.2's manual defines it, with C23's attributes): what
;; its __has_attribute, __has_c_attribute, __has_cpp_attribute, __has_builtin, __has_feature and __has_extension answer.
;; test/c/target.ae makes c/target/has.tsv from it and c/target/probes.tsv (the names the corpora and the headers spell,
;; harvested by grep as `bin/repr-c host record` harvests them: a fact of the corpora, not of a compiler). The rules:
;;   __has_c_attribute   a C23 standard attribute (ISO/IEC 9899:2024 §6.7.13.1, the attribute and its __X__ spelling): 202311;
;;                       a vendor attribute gnu::X or __gnu__::X (X or __X__, X among :gnu-attributes), clang::X of
;;                       :clang-attributes: 1; anything else 0
;;   __has_attribute     the GNU operator: X, __X__, gnu::X, gnu::__X__ for X among :gnu-attributes: 1, but an unscoped
;;   __has_cpp_attribute name that is also a C23 standard attribute answers 202311; the C23 standard attributes outside
;;                       :gnu-attributes are not GNU attributes (0); __has_cpp_attribute also takes :clang-attributes
;;   __has_builtin       a name of :builtins: 1; a library function L of :library-builtins (and __builtin_L): 1
;;   __has_feature       :features: 1
;;   __has_extension     :features and :extensions: 1
;; Read with the Clojure reader.
{:c23-attributes ["deprecated" "fallthrough" "maybe_unused" "nodiscard" "noreturn" "_Noreturn" "unsequenced" "reproducible"]
 :c23-attribute-version 202311
 :gnu-attributes ["alloc_size" "always_inline" "assume" "cleanup" "const" "deprecated" "fallthrough" "flag_enum" "format"
                  "format_arg" "indirect_return" "malloc" "may_alias" "musttail" "no_instrument_function" "noinline"
                  "nonstring" "noreturn" "objc_root_class" "packed" "pure" "sentinel" "unused" "warn_unused_result"]
 :clang-attributes ["musttail"]
 :builtins ["__atomic_exchange" "__atomic_exchange_n" "__atomic_load" "__atomic_load_n" "__atomic_store" "__atomic_store_n"
            "__builtin_LINE" "__builtin_add_overflow" "__builtin_add_overflow_p" "__builtin_alloca" "__builtin_apply"
            "__builtin_bswap16" "__builtin_bswap32" "__builtin_c23_va_start" "__builtin_clear_padding" "__builtin_expect"
            "__builtin_extract_return_addr" "__builtin_frame_address" "__builtin_frob_return_addr"
            "__builtin_has_attribute" "__builtin_ia32_pause" "__builtin_inf" "__builtin_longjmp" "__builtin_nan"
            "__builtin_object_size" "__builtin_offsetof" "__builtin_return" "__builtin_return_address"
            "__builtin_sadd_overflow" "__builtin_setjmp" "__builtin_shufflevector" "__builtin_stdc_bit_ceil"
            "__builtin_stdc_bit_floor" "__builtin_stdc_bit_width" "__builtin_stdc_count_ones" "__builtin_stdc_count_zeros"
            "__builtin_stdc_first_leading_one" "__builtin_stdc_first_leading_zero" "__builtin_stdc_first_trailing_one"
            "__builtin_stdc_first_trailing_zero" "__builtin_stdc_has_single_bit" "__builtin_stdc_leading_ones"
            "__builtin_stdc_leading_zeros" "__builtin_stdc_rotate_left" "__builtin_stdc_rotate_right"
            "__builtin_stdc_trailing_ones" "__builtin_stdc_trailing_zeros" "__builtin_sub_overflow" "__builtin_trap"
            "__builtin_types_compatible_p" "__builtin_unreachable" "__builtin_va_arg" "__builtin_va_end" "__builtin_va_start"
            "__sync_add_and_fetch" "__sync_bool_compare_and_swap" "__sync_fetch_and_add" "__sync_synchronize"
            "__sync_val_compare_and_swap"]
 ;; the library functions the dialect knows as builtins (each also as __builtin_NAME)
 :library-builtins ["_Exit" "abs" "isalpha" "sprintf" "vsnprintf"]
 :features ["c_alignas" "c_alignof" "c_atomic" "c_generic_selections" "c_static_assert" "c_thread_local" "cxx_binary_literals"
            "tls"]
 :extensions ["attribute_deprecated_with_message" "attribute_unavailable_with_message" "gnu_asm_goto_with_outputs"]}

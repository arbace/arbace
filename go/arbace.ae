;; The package arbace (doc/go/GOI-SPEC.md §7.3, G6; GR5): Go forms' API to Arbace, hand-written Go
;; forms printed with the program and listed in goi's table (go/arbace/gotable.edn), so that Go
;; forms at the REPL import it as any package: [[arbace "arbace"]]. It imports std only: its
;; calls into Arbace go through Hooks, which goi sets at initialization (goi holds Arbace's bridge,
;; arbace.lang.GoBridge; as built: GR5, the spec's lang and jrt imports replaced).
(ns go.arbace
  (:require [arbace.go :as go]))

(go/package arbace
  :path "arbace"
  :files ["api.go"])

(load "arbace/api")

(ns go.arbace.x86i
  (:require [arbace.go :as go]))

(go/package x86i
  :path "arbace/x86i"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["cpu.go" "decode.go" "dectab.go" "flags.go" "lockstep_linux.go" "sem.go" "sem_bit.go" "signal.go" "tables.go"]
  :init-order [gpr8 gpr16 gpr32 gpr64 segNames segRegs world regNames prefixInsn auxMasked auxSkipped FamilyNames families]
  :positions :lines)

(load "x86i/cpu")
(load "x86i/decode")
(load "x86i/dectab")
(load "x86i/flags")
(load "x86i/lockstep_linux")
(load "x86i/sem")
(load "x86i/sem_bit")
(load "x86i/signal")
(load "x86i/tables")

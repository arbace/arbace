;; The pragma handling ported from src/cmd/compile/internal/noder (noder.go, lex.go, writer.go)
;; and ir/node.go of TamaGo's go1.27.1 tree, and types2's checks ported from
;; src/cmd/compile/internal/types2 (range.go, stmt.go, index.go, operand.go) of the same tree:
;; Copyright 2009, 2016 The Go Authors. All rights reserved.
;; Use of this source code is governed by a BSD-style
;; license that can be found in the LICENSE file.

(in-ns 'go.arbace.repr.go.gcsyntax)

(go/file "errors.go" :doc "Package gcsyntax reports a Go file's errors of gc's front end that come before and beside its type checker, as gc reports them: cmd/compile/internal/syntax's (the parse, its branch checks), noder's pragmas', and the declarations' checks of noder's writer, kept and ordered as gc's base.ErrorfAt and base.FlushErrors keep and order them (doc/go/GO-PARSER-SURVEY.md GP6, GPS41 (c)).\n\nThe pragma handler, checkUnusedDuringParse, pragcgo and their helpers are ported from TamaGo's go1.27.1 src/cmd/compile/internal/noder/noder.go and lex.go, the declarations' checks from writer.go's collectDecls, checkPragmas and funcExt, and the pragma flags from ir/node.go, for gc compiling a package p (-p=p) for linux/amd64 outside the standard library and the runtime, no GOEXPERIMENT.\n" :imports [
    [bytes "bytes"]
    [fmt "fmt"]
    [os "os"]
    [filepath "path/filepath"]
    [sort "sort"]
    [strconv "strconv"]
    [strings "strings"]
    [unicode "unicode"]
    [utf8 "unicode/utf8"]

    [syntax "arbace/repr/go/internal/syntax"]])

(go/const ^{:val 5 :doc "Revision is the driver's revision, raised with every change to it: arbace.repr.go.syntax runs the checkout's driver, interpreted by goi, when a program's compiled one is of another revision (the tools' host built before the change).\n"} Revision 5)

(go/const "gc's configuration: base.Ctxt.Pkgpath, buildcfg.GOOS and GOARCH\n"
  [^{:val "p"} pkgpath "p"]
  [^{:val "linux"} goos "linux"]
  [^{:val "amd64"} goarch "amd64"])

(go/type serr "serr is an error at line and col of the file (its order), printed at file and rline, its position after //line directives (file empty: the file's own name).\n" (struct
    ^{:tag uint} line
    ^{:tag uint} col
    ^{:tag string} file
    ^{:tag uint} rline
    ^{:tag string} msg))

(go/type errorList "errorList keeps errors as base.ErrorfAt does: one syntax error per line, one of equal other errors per line.\n" (struct
    ^{:tag (slice serr)} errs
    ^{:tag bool} syn
    ^{:tag uint} lastSyntax
    ^{:tag uint} lastOther
    ^{:tag string} lastMsg))

(go/method add [^{:tag (* errorList)} l ^syntax/Pos pos ^string msg]
  (let [line (.Line pos)]
    (if (strings/HasPrefix msg "syntax error") (do
        (when (and (!= (.-lastSyntax l) 0) (== line (.-lastSyntax l)))
          (return))

        (set! (.-lastSyntax l) line)
        (set! (.-syn l) true))
      (do
        (when (and (!= (.-lastOther l) 0) (== line (.-lastOther l)) (== msg (.-lastMsg l)))
          (return))

        (set! (.-lastOther l) line)
        (set! (.-lastMsg l) msg)))

    ;; base.FmtPos: a position after a line directive is printed as the directive says (its file, its line)
    (let [file ""
        rline line
        b (.Base pos)]
      (when (and (!= b nil) (not (.IsFileBase b)))
        (set! file (.RelFilename pos))
        (set! rline (.RelLine pos)))

      (set! (.-errs l) (append (.-errs l) (lit serr :line line :col (.Col pos) :file file :rline rline :msg msg))))))

(go/method text "text: the errors as base.FlushErrors prints them with -C (sorted by position, an error equal to the one before it once), a line each, name:LINE: MESSAGE.\n" ^string [^{:tag (* errorList)} l ^string name]
  (let [errs (.-errs l)]
    (sort/SliceStable errs (fn ^bool [^int i ^int j]
        (let [(values a b) (values (aget errs i) (aget errs j))]
          (or (< (.-line a) (.-line b)) (and (== (.-line a) (.-line b)) (< (.-col a) (.-col b)))))))

    (let [out ""
        prev ""]
      (range [_ e errs]
        (let [f name]
          (when (!= (.-file e) "")
            (set! f (.-file e)))

          (let [s (+ f ":" (strconv/FormatUint (conv uint64 (.-rline e)) 10) ": " (.-msg e) "\n")]
            (when (!= s prev)
              (set! out + s))

            (set! prev s))))

      out)))

(go/const "pragma flags (ir.PragmaFlag)\n"
  [^{:tag uint16 :val 1} Nointerface (<< 1 iota)]
  [^{:val 2} Noescape]
  [^{:val 4} Norace]
  [^{:val 8} Nosplit]
  [^{:val 16} Noinline]
  [^{:val 32} NoCheckPtr]
  [^{:val 64} CgoUnsafeArgs]
  [^{:val 128} UintptrKeepAlive]
  [^{:val 256} UintptrEscapes]
  [^{:val 512} Systemstack]
  [^{:val 1024} Nowritebarrier]
  [^{:val 2048} Nowritebarrierrec]
  [^{:val 4096} Yeswritebarrierrec]
  [^{:val 8192} GoBuildPragma]
  [^{:val 16384} RegisterParams])

(go/const ^{:val 24575} funcPragmas (bit-or Nointerface Noescape Norace Nosplit Noinline NoCheckPtr RegisterParams CgoUnsafeArgs UintptrKeepAlive UintptrEscapes Systemstack Nowritebarrier Nowritebarrierrec Yeswritebarrierrec))

(go/type pragmas "pragmas: the value stored in a syntax.Pragma during parsing (noder's *pragmas).\n" (struct
    ^{:tag uint16} Flag
    ^{:tag (slice pragmaPos)} Pos
    ^{:tag (slice pragmaEmbed)} Embeds
    ^{:tag (* syntax/Pos)} WasmImport
    ^{:tag (* syntax/Pos)} WasmExport))

(go/type pragmaPos (struct
    ^{:tag uint16} Flag
    ^{:tag syntax/Pos} Pos))

(go/type pragmaEmbed (struct
    ^{:tag syntax/Pos} Pos
    ^{:tag (slice string)} Patterns))

(go/type linkname (struct
    ^{:tag syntax/Pos} pos
    ^{:tag bool} std
    ^{:tag string} local
    ^{:tag string} remote))

(go/type noder "noder: a file's parse (noder's noder).\n" (struct
    ^{:tag errorList} errs
    ^{:tag (* syntax/File)} file
    ^{:tag (slice linkname)} linknames
    ^{:tag (slice (slice string))} pragcgobuf))

(go/method error [^{:tag (* noder)} p ^error err]
  (let [e (assert syntax/Error err)]
    (.add (.-errs p) (.-Pos e) (.-Msg e))))

(go/func pragmaFlag ^uint16 [^string verb]
  (switch verb
    (case ["go:build"]
      (return GoBuildPragma))
    (case ["go:nointerface"])
    ;; buildcfg.Experiment.FieldTrack: off
    (case ["go:noescape"]
      (return Noescape))
    (case ["go:norace"]
      (return Norace))
    (case ["go:nosplit"]
      (return (bit-or Nosplit NoCheckPtr)))
    (case ["go:noinline"]
      (return Noinline))
    (case ["go:nocheckptr"]
      (return NoCheckPtr))
    (case ["go:systemstack"]
      (return Systemstack))
    (case ["go:nowritebarrier"]
      (return Nowritebarrier))
    (case ["go:nowritebarrierrec"]
      (return (bit-or Nowritebarrierrec Nowritebarrier)))
    (case ["go:yeswritebarrierrec"]
      (return Yeswritebarrierrec))
    (case ["go:cgo_unsafe_args"]
      (return (bit-or CgoUnsafeArgs NoCheckPtr)))
    (case ["go:uintptrkeepalive"]
      (return UintptrKeepAlive))
    (case ["go:uintptrescapes"]
      (return (bit-or UintptrEscapes UintptrKeepAlive)))
    (case ["go:registerparams"]
      (return RegisterParams)))

  0)

(go/method checkUnusedDuringParse [^{:tag (* noder)} p ^{:tag (* pragmas)} pragma]
  (range [_ pos (.-Pos pragma)]
    (when (!= (bit-and (.-Flag pos) (.-Flag pragma)) 0)
      (.error p (lit syntax/Error :Pos (.-Pos pos) :Msg "misplaced compiler directive"))))

  (when (> (len (.-Embeds pragma)) 0)
    (range [_ e (.-Embeds pragma)]
      (.error p (lit syntax/Error :Pos (.-Pos e) :Msg "misplaced go:embed directive"))))

  (when (!= (.-WasmImport pragma) nil)
    (.error p (lit syntax/Error :Pos @(.-WasmImport pragma) :Msg "misplaced go:wasmimport directive")))

  (when (!= (.-WasmExport pragma) nil)
    (.error p (lit syntax/Error :Pos @(.-WasmExport pragma) :Msg "misplaced go:wasmexport directive"))))

(go/method pragma "pragma: noder's pragma handler (base.Flag.Std and base.Flag.CompilingRuntime false, GOARCH not wasm).\n" ^syntax/Pragma [^{:tag (* noder)} p ^syntax/Pos pos ^bool blankLine ^string text ^syntax/Pragma old]
  (let [(values pragma _) (assert (* pragmas) old)]
    (when (== pragma nil)
      (set! pragma (new pragmas)))

    (when (== text "")
      ;; unused pragma; only called with old != nil.
      (.checkUnusedDuringParse p pragma)
      (return nil))

    (when (strings/HasPrefix text "line ")
      ;; line directives are handled by syntax package
      (panic "unreachable"))

    (when (not blankLine)
      ;; directive must be on line by itself
      (.error p (lit syntax/Error :Pos pos :Msg "misplaced compiler directive"))
      (return pragma))

    (switch
      (case [(strings/HasPrefix text "go:wasmimport ")]
        (let [f (strings/Fields text)]
          (when (!= (len f) 3)
            (.error p (lit syntax/Error :Pos pos :Msg "usage: //go:wasmimport importmodule importname"))
            (break))

          (when (== goarch "wasm")
            (set! (.-WasmImport pragma) (addr pos)))))

      (case [(strings/HasPrefix text "go:wasmexport ")]
        (let [f (strings/Fields text)]
          (when (!= (len f) 2)
            (.error p (lit syntax/Error :Pos pos :Msg "usage: //go:wasmexport exportname"))
            (break))

          (when (== goarch "wasm")
            (set! (.-WasmExport pragma) (addr pos)))))

      (case [(strings/HasPrefix text "go:linkname ") (strings/HasPrefix text "go:linknamestd ")]
        (let [f (strings/Fields text)]
          (when (not (and (<= 2 (len f)) (<= (len f) 3)))
            (.error p (lit syntax/Error :Pos pos :Msg (fmt/Sprintf "usage: //%s localname [linkname]" (aget f 0))))
            (break))

          (let [^string target (zero string)]
            (if (== (len f) 3)
              (set! target (aget f 2))

              (set! target (+ pkgpath "." (aget f 1))))

            (set! (.-linknames p) (append (.-linknames p) (lit linkname pos (== (aget f 0) "go:linknamestd") (aget f 1) target))))))

      (case [(== text "go:embed") (strings/HasPrefix text "go:embed ")]
        (let [(values args err) (parseGoEmbed (subslice text (len "go:embed")))]
          (when (!= err nil)
            (.error p (lit syntax/Error :Pos pos :Msg (.Error err))))

          (when (== (len args) 0)
            (.error p (lit syntax/Error :Pos pos :Msg "usage: //go:embed pattern..."))
            (break))

          (set! (.-Embeds pragma) (append (.-Embeds pragma) (lit pragmaEmbed pos args)))))

      (case [(strings/HasPrefix text "go:cgo_import_dynamic ")]
        ;; This is permitted for general use because Solaris
        ;; code relies on it in golang.org/x/sys/unix and others.
        (let [fields (pragmaFields text)]
          (when (>= (len fields) 4)
            (let [lib (strings/Trim (aget fields 3) "\"")]
              (when (and (!= lib "") (not (safeArg lib)) (not (isCgoGeneratedFile pos)))
                (.error p (lit syntax/Error :Pos pos :Msg (fmt/Sprintf "invalid library name %q in cgo_import_dynamic directive" lib))))

              (.pragcgo p pos text)
              (set! (.-Flag pragma) bit-or (pragmaFlag "go:cgo_import_dynamic"))
              (break)))

          (.pragmaCgo p pos text pragma)))
      (case [(strings/HasPrefix text "go:cgo_")]
        (.pragmaCgo p pos text pragma))
      (default
        (.pragmaVerb p pos text pragma)))

    pragma))

(go/method pragmaCgo "pragmaCgo: noder's case \"go:cgo_\" and its fallthrough to the default.\n" [^{:tag (* noder)} p ^syntax/Pos pos ^string text ^{:tag (* pragmas)} pragma]
  ;; For security, we disallow //go:cgo_* directives other
  ;; than cgo_import_dynamic outside cgo-generated files.
  (when (not (isCgoGeneratedFile pos))
    (.error p (lit syntax/Error :Pos pos :Msg (fmt/Sprintf "//%s only allowed in cgo-generated code" text))))

  (.pragcgo p pos text)
  (.pragmaVerb p pos text pragma)) ; because of //go:cgo_unsafe_args

(go/method pragmaVerb "pragmaVerb: noder's default case (base.Flag.CompilingRuntime and base.Flag.Std false).\n" [^{:tag (* noder)} p ^syntax/Pos pos ^string text ^{:tag (* pragmas)} pragma]
  (let [verb text]
    (when [i (strings/Index text " ")] (>= i 0)
      (set! verb (subslice verb _ i)))

    (let [flag (pragmaFlag verb)
        ^:const ^{:val 7680} runtimePragmas (bit-or Systemstack Nowritebarrier Nowritebarrierrec Yeswritebarrierrec)]
      (when (!= (bit-and flag runtimePragmas) 0)
        (.error p (lit syntax/Error :Pos pos :Msg (fmt/Sprintf "//%s only allowed in runtime" verb))))

      (when (== flag UintptrKeepAlive)
        (.error p (lit syntax/Error :Pos pos :Msg (fmt/Sprintf "//%s is only allowed in the standard library" verb))))

      (set! (.-Flag pragma) bit-or flag)
      (set! (.-Pos pragma) (append (.-Pos pragma) (lit pragmaPos flag pos))))))

(go/func isCgoGeneratedFile "isCgoGeneratedFile reports whether pos is in a file generated by cgo, a file whose name begins with \"_cgo_\".\n" ^bool [^syntax/Pos pos]
  (strings/HasPrefix (filepath/Base (.Filename (.Base (.Pos (.Base pos))))) "_cgo_"))

(go/func safeArg "safeArg reports whether arg is a \"safe\" command-line argument.\n" ^bool [^string name]
  (when (== name "")
    (return false))

  (let [c (aget name 0)]
    (or (and (<= \0 c) (<= c \9)) (and (<= \A c) (<= c \Z)) (and (<= \a c) (<= c \z)) (== c \.) (== c \_) (== c \/) (>= c utf8/RuneSelf))))

(go/func parseGoEmbed "parseGoEmbed parses the text following \"//go:embed\" to extract the glob patterns.\n" [^string args] :results [(slice string) error]
  (let [^{:tag (slice string)} list (zero (slice string))]
    (for [(set! args (strings/TrimSpace args))] (!= args "") (set! args (strings/TrimSpace args))
      (let [^string path (zero string)]
        (label :Switch
          (switch (aget args 0)
            (default
              (let [i (len args)]
                (range [j c args]
                  (when (unicode/IsSpace c)
                    (set! i j)
                    (break)))

                (set! path (subslice args _ i))
                (set! args (subslice args i))))

            (case [\`]
              (let [i (strings/Index (subslice args 1) "`")]
                (when (< i 0)
                  (return nil (fmt/Errorf "invalid quoted string in //go:embed: %s" args)))

                (set! path (subslice args 1 (+ 1 i)))
                (set! args (subslice args (+ 1 i 1)))))

            (case [\"]
              (let [i 1]
                (for [] (< i (len args)) (inc! i)
                  (when (== (aget args i) \\)
                    (inc! i)
                    (continue))

                  (when (== (aget args i) \")
                    (let [(values q err) (strconv/Unquote (subslice args _ (+ i 1)))]
                      (when (!= err nil)
                        (return nil (fmt/Errorf "invalid quoted string in //go:embed: %s" (subslice args _ (+ i 1)))))

                      (set! path q)
                      (set! args (subslice args (+ i 1)))
                      (break :Switch))))

                (when (>= i (len args))
                  (return nil (fmt/Errorf "invalid quoted string in //go:embed: %s" args)))))))

        (when (!= args "")
          (let [(values r _) (utf8/DecodeRuneInString args)]
            (when (not (unicode/IsSpace r))
              (return nil (fmt/Errorf "invalid quoted string in //go:embed: %s" args)))))

        (set! list (append list path))))

    (return list nil)))

(go/func isSpace ^bool [^rune c]
  (or (== c \space) (== c \tab) (== c \newline) (== c \return)))

(go/func isQuoted ^bool [^string s]
  (and (>= (len s) 2) (== (aget s 0) \") (== (aget s (- (len s) 1)) \")))

(go/method pragcgo "pragcgo: lex.go's (buildcfg.GOOS linux).\n" [^{:tag (* noder)} p ^syntax/Pos pos ^string text]
  (let [f (pragmaFields text)

      verb (strings/TrimPrefix (aget f 0) "go:")]
    (aset f 0 verb)

    (switch verb
      (case ["cgo_export_static" "cgo_export_dynamic"]
        (switch
          (case [(and (== (len f) 2) (not (isQuoted (aget f 1))))])
          (case [(and (== (len f) 3) (not (isQuoted (aget f 1))) (not (isQuoted (aget f 2))))])
          (default
            (.error p (lit syntax/Error :Pos pos :Msg (fmt/Sprintf "usage: //go:%s local [remote]" verb)))
            (return))))

      (case ["cgo_import_dynamic"]
        (switch
          (case [(and (== (len f) 2) (not (isQuoted (aget f 1))))])
          (case [(and (== (len f) 3) (not (isQuoted (aget f 1))) (not (isQuoted (aget f 2))))])
          (case [(and (== (len f) 4) (not (isQuoted (aget f 1))) (not (isQuoted (aget f 2))) (isQuoted (aget f 3)))]
            (aset f 3 (strings/Trim (aget f 3) "\""))
            (when (and (== goos "aix") (!= (aget f 3) ""))
              (let [n (strings/Split (aget f 3) "/")]
                (when (or (!= (len n) 2) (not (strings/HasSuffix (aget n 0) ".a")) ^:go/paren (and (not (strings/HasSuffix (aget n 1) ".o")) (not (strings/Contains (aget n 1) ".so."))))
                  (.error p (lit syntax/Error :Pos pos :Msg "usage: //go:cgo_import_dynamic local [remote [\"lib.a/object.o\"]]"))
                  (return)))))

          (default
            (.error p (lit syntax/Error :Pos pos :Msg "usage: //go:cgo_import_dynamic local [remote [\"library\"]]"))
            (return))))

      (case ["cgo_import_static"]
        (switch
          (case [(and (== (len f) 2) (not (isQuoted (aget f 1))))])
          (default
            (.error p (lit syntax/Error :Pos pos :Msg "usage: //go:cgo_import_static local"))
            (return))))

      (case ["cgo_dynamic_linker"]
        (switch
          (case [(and (== (len f) 2) (isQuoted (aget f 1)))]
            (aset f 1 (strings/Trim (aget f 1) "\"")))
          (default
            (.error p (lit syntax/Error :Pos pos :Msg "usage: //go:cgo_dynamic_linker \"path\""))
            (return))))

      (case ["cgo_ldflag"]
        (switch
          (case [(and (== (len f) 2) (isQuoted (aget f 1)))]
            (aset f 1 (strings/Trim (aget f 1) "\"")))
          (default
            (.error p (lit syntax/Error :Pos pos :Msg "usage: //go:cgo_ldflag \"arg\""))
            (return))))

      (default
        (return)))

    (set! (.-pragcgobuf p) (append (.-pragcgobuf p) f))))

(go/func pragmaFields "pragmaFields is similar to strings.FieldsFunc(s, isSpace) but does not split when inside double quoted regions and always splits before the start and after the end of a double quoted region.\n" ^{:tag (slice string)} [^string s]
  (let [^{:tag (slice string)} a (zero (slice string))
      inQuote false
      fieldStart -1] ; Set to -1 when looking for start of field.
    (range [i c s]
      (switch
        (case [(== c \")]
          (if inQuote (do
              (set! inQuote false)
              (set! a (append a (subslice s fieldStart (+ i 1))))
              (set! fieldStart -1))
            (do
              (set! inQuote true)
              (when (>= fieldStart 0)
                (set! a (append a (subslice s fieldStart i))))

              (set! fieldStart i))))

        (case [(and (not inQuote) (isSpace c))]
          (when (>= fieldStart 0)
            (set! a (append a (subslice s fieldStart i)))
            (set! fieldStart -1)))

        (default
          (when (== fieldStart -1)
            (set! fieldStart i)))))

    (when (and (not inQuote) (>= fieldStart 0)) ; Last field might end at the end of the string.
      (set! a (append a (subslice s fieldStart))))

    a))

(go/func parse "parse parses the Go file at path as gc's noder does (noder.LoadPackage: syntax.Parse with its errors to a handler, noder's pragma handler, CheckBranches).\n" ^{:tag (* noder)} [^string path]
  (let [p (addr (lit noder))
      (values src err) (os/ReadFile path)]
    (when (!= err nil)
      (.error p (lit syntax/Error :Msg (.Error err)))
      (return p))

    (set! (values (.-file p) _) (syntax/Parse (syntax/NewFileBase path) (bytes/NewReader src) (.-error p) (.-pragma p) syntax/CheckBranches))
    p))

(go/func Errors "Errors parses the Go file at path as gc's noder does (syntax.Parse, its errors to a handler, noder's pragma handler, CheckBranches) and returns its errors as gc prints them with -C (with types2's go and defer check, and on a file go/parser rejects types2's range and slice checks: tchecker), a line each, name:LINE: MESSAGE, after a first character S when one of them is a syntax error (gc stops after the parse), else -.\n" ^string [^string path ^string name]
  (let [p (parse path)]
    (when (.-syn (.-errs p))
      (return (+ "S" (.text (.-errs p) name))))

    (when (!= (.-file p) nil)
      (suspendedCalls (.-file p) (addr (.-errs p)))
      (when (goParserRejects (.-file p))
        (.file (addr (lit tchecker :errs (addr (.-errs p)))) (.-file p))))

    (+ "-" (.text (.-errs p) name))))

(go/func suspendedCalls "suspendedCalls: types2's check of a go or defer statement's expression on syntax's tree (stmt.go, suspendedCall: expression in go must be function call), which gc reports with the parse's errors that are not syntax errors (noder goes on to types2): a check of types2's that go/parser's rejection of the file hides from goi's checker, a statement go/parser accepts never failing it (the others: tchecker).\n" [^syntax/Node f ^{:tag (* errorList)} errs]
  (syntax/Inspect f (fn ^bool [^syntax/Node n]
      (when [(values s ok) (assert (* syntax/CallStmt) n)] ok
        (when [(values _ call) (assert (* syntax/CallExpr) (.-Call s))] (not call)
          (.add errs (.Pos (.-Call s)) (+ "expression in " (.String (.-Tok s)) " must be function call"))))

      true)))

(go/func goParserRejects "goParserRejects reports whether the tree has a node go/parser rejects though gc's syntax accepts it (a range clause of more than two iteration variables, a 3-index slice missing an index, a go or defer statement whose expression is not a call): the files without forms on which types2's checks below run, so that a file go/parser accepts, checked by goi's checker, has the errors it had.\n" ^bool [^{:tag (* syntax/File)} f]
  (let [found false]
    (syntax/Inspect f (fn ^bool [^syntax/Node n]
        (type-switch [n n]
          (case [(* syntax/RangeClause)]
            (when [(values l ok) (assert (* syntax/ListExpr) (.-Lhs n))] (and ok (> (len (.-ElemList l)) 2))
              (set! found true)))
          (case [(* syntax/SliceExpr)]
            (when (.-Full n)
              (range [_ x (subslice (.-Index n) 1)]
                (when [(values _ bad) (assert (* syntax/BadExpr) x)] bad
                  (set! found true)))))
          (case [(* syntax/CallStmt)]
            (when [(values _ call) (assert (* syntax/CallExpr) (.-Call n))] (not call)
              (set! found true))))

        (not found)))

    found))

(go/type ttype "ttype: a type types2 would give an operand, as far as the checks below know it from the file's syntax alone: a basic type (its name; \"untyped string\" a string constant's), an array of a constant length, a pointer, a slice, a map or a channel of such types; nil (unknown) for any other, a named type's among them.\n" (struct
    ^{:tag string} kind
    ^{:tag string} name
    ^{:tag int64} n
    ^{:tag (* ttype)} elem
    ^{:tag (* ttype)} key
    ^{:tag syntax/ChanDir} dir))

(go/method String "String: the type as types2's TypeString prints it.\n" ^string [^{:tag (* ttype)} t]
  (switch (.-kind t)
    (case ["array"]
      (return (+ "[" (strconv/FormatInt (.-n t) 10) "]" (.String (.-elem t)))))
    (case ["pointer"]
      (return (+ "*" (.String (.-elem t)))))
    (case ["slice"]
      (return (+ "[]" (.String (.-elem t)))))
    (case ["map"]
      (return (+ "map[" (.String (.-key t)) "]" (.String (.-elem t)))))
    (case ["chan"]
      (switch (.-dir t)
        (case [syntax/SendOnly]
          (return (+ "chan<- " (.String (.-elem t)))))
        (case [syntax/RecvOnly]
          (return (+ "<-chan " (.String (.-elem t))))))

      (return (+ "chan " (.String (.-elem t))))))

  (.-name t))

(go/func isString ^bool [^{:tag (* ttype)} t]
  (and (== (.-kind t) "basic") (or (== (.-name t) "string") (== (.-name t) "untyped string"))))

(go/var ^{:doc "basicNames: the universe's basic types the checks know.\n"} basicNames (lit (map string bool) ["bool" true] ["string" true] ["int" true] ["int8" true] ["int16" true] ["int32" true] ["int64" true] ["uint" true] ["uint8" true] ["uint16" true] ["uint32" true] ["uint64" true] ["uintptr" true] ["float32" true] ["float64" true] ["complex64" true] ["complex128" true] ["byte" true] ["rune" true]))

(go/type tobj "tobj: an object of a scope: a variable (its type, nil when unknown) or another name.\n" (struct
    ^{:tag bool} isVar
    ^{:tag (* ttype)} typ))

(go/type tscope "tscope: a scope of the file, its names' objects.\n" (struct
    ^{:tag (* tscope)} parent
    ^{:tag (map string (* tobj))} objs))

(go/func newScope ^{:tag (* tscope)} [^{:tag (* tscope)} parent]
  (addr (lit tscope :parent parent :objs (lit (map string (* tobj))))))

(go/method declare [^{:tag (* tscope)} s ^{:tag (* syntax/Name)} n ^{:tag (* tobj)} o]
  (when (and (!= n nil) (!= (.-Value n) "_"))
    (aset (.-objs s) (.-Value n) o)))

(go/method lookup "lookup: the object of name in s or a scope around it, and whether it is declared there (not: the universe's, or another file's).\n" [^{:tag (* tscope)} s ^string name] :results [(* tobj) bool]
  (for [sc s] (!= sc nil) (set! sc (.-parent sc))
    (when [(values o ok) (aget (.-objs sc) name)] ok
      (return o true)))

  (return nil false))

(go/type toperand "toperand: an operand as types2 has it, as far as the checks know: a variable of a known type (mode 1) or an untyped string constant of length slen (mode 2); mode 0 unknown.\n" (struct
    ^{:tag int} mode
    ^{:tag (* ttype)} typ
    ^{:tag int64} slen))

(go/type tchecker "tchecker: the checks of types2 (cmd/compile/internal/types2) on syntax's tree of a file go/parser rejects, which goi's checker cannot run without forms (doc/go/GO-PARSER-SURVEY.md GPS43 (b)): range.go's rangeStmt's checks of the iteration variables and index.go's sliceExpr's checks of a slice's indices, on the operands whose types the file's syntax gives (typeOf, operand); an operand of any other type is not checked, so that the checks report only errors types2 reports.\n" (struct
    ^{:tag (* errorList)} errs))

(go/method typeOf "typeOf: the type the type expression e denotes in scope s, or nil (unknown).\n" ^{:tag (* ttype)} [^{:tag (* tchecker)} c ^{:tag (* tscope)} s ^syntax/Expr e]
  (type-switch [e e]
    (case [(* syntax/Name)]
      (let [(values _ found) (.lookup s (.-Value e))]
        (when (and (not found) (aget basicNames (.-Value e)))
          (return (addr (lit ttype :kind "basic" :name (.-Value e)))))))
    (case [(* syntax/ParenExpr)]
      (return (.typeOf c s (.-X e))))
    (case [(* syntax/ArrayType)]
      (when [(values l ok) (assert (* syntax/BasicLit) (.-Len e))] (and ok (== (.-Kind l) syntax/IntLit) (not (.-Bad l)))
        (when [(values n err) (strconv/ParseInt (.-Value l) 0 64)] (== err nil)
          (when [el (.typeOf c s (.-Elem e))] (!= el nil)
            (return (addr (lit ttype :kind "array" :n n :elem el)))))))
    (case [(* syntax/SliceType)]
      (when [el (.typeOf c s (.-Elem e))] (!= el nil)
        (return (addr (lit ttype :kind "slice" :elem el)))))
    (case [(* syntax/Operation)]
      (when (and (== (.-Op e) syntax/Mul) (== (.-Y e) nil))
        (when [el (.typeOf c s (.-X e))] (!= el nil)
          (return (addr (lit ttype :kind "pointer" :elem el))))))
    (case [(* syntax/MapType)]
      (let [k (.typeOf c s (.-Key e))
          v (.typeOf c s (.-Value e))]
        (when (and (!= k nil) (!= v nil))
          (return (addr (lit ttype :kind "map" :key k :elem v))))))
    (case [(* syntax/ChanType)]
      (when [el (.typeOf c s (.-Elem e))] (and (!= el nil) (!= (.-kind el) "chan"))
        (return (addr (lit ttype :kind "chan" :elem el :dir (.-Dir e)))))))

  nil)

(go/method operand "operand: the operand of the expression e in scope s (toperand).\n" ^toperand [^{:tag (* tchecker)} c ^{:tag (* tscope)} s ^syntax/Expr e]
  (type-switch [e e]
    (case [(* syntax/ParenExpr)]
      (return (.operand c s (.-X e))))
    (case [(* syntax/Name)]
      (when [(values o found) (.lookup s (.-Value e))] (and found (.-isVar o) (!= (.-typ o) nil))
        (return (lit toperand :mode 1 :typ (.-typ o)))))
    (case [(* syntax/BasicLit)]
      (when (and (== (.-Kind e) syntax/StringLit) (not (.-Bad e)))
        (when [(values v err) (strconv/Unquote (.-Value e))] (== err nil)
          (return (lit toperand :mode 2 :typ (addr (lit ttype :kind "basic" :name "untyped string")) :slen (conv int64 (len v))))))))

  (lit toperand))

(go/method file "file: the checks over the file's declarations: its package scope first (every name of the file's declarations; a dot import's names unknown, so none is checked), then the variables' types, then the initializers and the functions' bodies.\n" [^{:tag (* tchecker)} c ^{:tag (* syntax/File)} f]
  (let [pkg (newScope nil)]
    (range [_ d (.-DeclList f)]
      (type-switch [d d]
        (case [(* syntax/ImportDecl)]
          (if (!= (.-LocalPkgName d) nil)
            (do
              (when (== (.-Value (.-LocalPkgName d)) ".")
                (return))

              (.declare pkg (.-LocalPkgName d) (addr (lit tobj))))

            (when (!= (.-Path d) nil)
              (when [(values path err) (strconv/Unquote (.-Value (.-Path d)))] (== err nil)
                (aset (.-objs pkg) (filepath/Base path) (addr (lit tobj)))))))
        (case [(* syntax/ConstDecl)]
          (range [_ n (.-NameList d)]
            (.declare pkg n (addr (lit tobj)))))
        (case [(* syntax/TypeDecl)]
          (.declare pkg (.-Name d) (addr (lit tobj))))
        (case [(* syntax/VarDecl)]
          (range [_ n (.-NameList d)]
            (.declare pkg n (addr (lit tobj :isVar true)))))
        (case [(* syntax/FuncDecl)]
          (when (== (.-Recv d) nil)
            (.declare pkg (.-Name d) (addr (lit tobj)))))))

    (range [_ d (.-DeclList f)]
      (when [(values v ok) (assert (* syntax/VarDecl) d)] (and ok (!= (.-Type v) nil))
        (let [t (.typeOf c pkg (.-Type v))]
          (range [_ n (.-NameList v)]
            (when [(values o found) (aget (.-objs pkg) (.-Value n))] (and found (.-isVar o))
              (set! (.-typ o) t))))))

    (range [_ d (.-DeclList f)]
      (type-switch [d d]
        (case [(* syntax/ConstDecl)]
          (.expr c pkg (.-Values d)))
        (case [(* syntax/VarDecl)]
          (.expr c pkg (.-Values d)))
        (case [(* syntax/FuncDecl)]
          (.function c pkg (.-Recv d) (.-TParamList d) (.-Type d) (.-Body d)))))))

(go/method function "function: a function's body in its scope: its type parameters, then its receiver, parameters and results, their types resolved before them (a parameter's scope is the body).\n" [^{:tag (* tchecker)} c ^{:tag (* tscope)} s ^{:tag (* syntax/Field)} recv ^{:tag (slice (* syntax/Field))} tparams ^{:tag (* syntax/FuncType)} t ^{:tag (* syntax/BlockStmt)} body]
  (let [fs (newScope s)]
    (range [_ p tparams]
      (.declare fs (.-Name p) (addr (lit tobj))))

    (let [^{:tag (slice (* syntax/Field))} fields (zero (slice (* syntax/Field)))]
      (when (!= recv nil)
        (set! fields (append fields recv)))

      (when (!= t nil)
        (set! fields (append fields (spread (.-ParamList t))))
        (set! fields (append fields (spread (.-ResultList t)))))

      (let [types (make (slice (* ttype)) (len fields))]
        (range [i p fields]
          (aset types i (.typeOf c fs (.-Type p))))

        (range [i p fields]
          (.declare fs (.-Name p) (addr (lit tobj :isVar true :typ (aget types i)))))))

    (when (!= body nil)
      (.stmts c (newScope fs) (.-List body)))))

(go/method expr "expr: the checks of the slice expressions in e, a function literal's body in its scope.\n" [^{:tag (* tchecker)} c ^{:tag (* tscope)} s ^syntax/Expr e]
  (when (== e nil)
    (return))

  (syntax/Inspect e (fn ^bool [^syntax/Node n]
      (type-switch [n n]
        (case [(* syntax/FuncLit)]
          (.function c s nil nil (.-Type n) (.-Body n))
          (return false))
        (case [(* syntax/SliceExpr)]
          (.slice c s n)))

      true)))

(go/method define "define: the variables a short variable declaration's left-hand side lhs declares in s (their types unknown).\n" [^{:tag (* tchecker)} c ^{:tag (* tscope)} s ^syntax/Expr lhs]
  (type-switch [lhs lhs]
    (case [(* syntax/Name)]
      (.declare s lhs (addr (lit tobj :isVar true))))
    (case [(* syntax/ListExpr)]
      (range [_ x (.-ElemList lhs)]
        (when [(values n ok) (assert (* syntax/Name) x)] ok
          (.declare s n (addr (lit tobj :isVar true))))))))

(go/method stmts [^{:tag (* tchecker)} c ^{:tag (* tscope)} s ^{:tag (slice syntax/Stmt)} list]
  (range [_ st list]
    (.stmt c s st)))

(go/method stmt "stmt: the checks of a statement, the scopes of its blocks and declarations as types2's.\n" [^{:tag (* tchecker)} c ^{:tag (* tscope)} s ^syntax/Stmt st]
  (type-switch [st st]
    (case [(* syntax/DeclStmt)]
      (range [_ d (.-DeclList st)]
        (type-switch [d d]
          (case [(* syntax/ConstDecl)]
            (.expr c s (.-Values d))
            (range [_ n (.-NameList d)]
              (.declare s n (addr (lit tobj)))))
          (case [(* syntax/VarDecl)]
            (.expr c s (.-Values d))
            (let [^{:tag (* ttype)} t (zero (* ttype))]
              (when (!= (.-Type d) nil)
                (set! t (.typeOf c s (.-Type d))))

              (range [_ n (.-NameList d)]
                (.declare s n (addr (lit tobj :isVar true :typ t))))))
          (case [(* syntax/TypeDecl)]
            (.declare s (.-Name d) (addr (lit tobj)))))))
    (case [(* syntax/LabeledStmt)]
      (.stmt c s (.-Stmt st)))
    (case [(* syntax/BlockStmt)]
      (.stmts c (newScope s) (.-List st)))
    (case [(* syntax/ExprStmt)]
      (.expr c s (.-X st)))
    (case [(* syntax/SendStmt)]
      (.expr c s (.-Chan st))
      (.expr c s (.-Value st)))
    (case [(* syntax/AssignStmt)]
      (.expr c s (.-Rhs st))
      (if (== (.-Op st) syntax/Def)
        (.define c s (.-Lhs st))

        (.expr c s (.-Lhs st))))
    (case [(* syntax/CallStmt)]
      (.expr c s (.-Call st)))
    (case [(* syntax/ReturnStmt)]
      (.expr c s (.-Results st)))
    (case [(* syntax/IfStmt)]
      (let [is (newScope s)]
        (.stmt c is (.-Init st))
        (.expr c is (.-Cond st))
        (.stmt c is (.-Then st))
        (.stmt c is (.-Else st))))
    (case [(* syntax/ForStmt)]
      (let [fs (newScope s)]
        (if [(values r ok) (assert (* syntax/RangeClause) (.-Init st))] ok
          (do
            (.expr c s (.-X r))
            (.rangeClause c s r)
            (if (.-Def r)
              (.define c fs (.-Lhs r))

              (.expr c s (.-Lhs r))))

          (do
            (.stmt c fs (.-Init st))
            (.expr c fs (.-Cond st))
            (.stmt c fs (.-Post st))))

        (.stmt c fs (.-Body st))))
    (case [(* syntax/SwitchStmt)]
      (let [ss (newScope s)
          ^{:tag (* syntax/Name)} guard (zero (* syntax/Name))]
        (.stmt c ss (.-Init st))
        (if [(values g ok) (assert (* syntax/TypeSwitchGuard) (.-Tag st))] ok
          (do
            (.expr c ss (.-X g))
            (set! guard (.-Lhs g)))

          (.expr c ss (.-Tag st)))

        (range [_ cc (.-Body st)]
          (let [cs (newScope ss)]
            (.expr c cs (.-Cases cc))
            (when (!= guard nil)
              (.declare cs guard (addr (lit tobj :isVar true))))

            (.stmts c cs (.-Body cc))))))
    (case [(* syntax/SelectStmt)]
      (range [_ cc (.-Body st)]
        (let [cs (newScope s)]
          (.stmt c cs (.-Comm cc))
          (.stmts c cs (.-Body cc)))))))

(go/func rangeKeyVal "rangeKeyVal: range.go's, the key and value types of a range over an operand of type t, and whether the checks know them (a range over an integer, a function or a send-only channel not: types2's language version and iterator checks).\n" [^{:tag (* ttype)} t] :results [(* ttype) (* ttype) bool]
  (let [u t
      i (addr (lit ttype :kind "basic" :name "int"))]
    (when (and (== (.-kind t) "pointer") (== (.-kind (.-elem t)) "array"))
      (set! u (.-elem t)))

    (switch (.-kind u)
      (case ["basic"]
        (when (isString u)
          (return i (addr (lit ttype :kind "basic" :name "rune")) true)))
      (case ["array" "slice"]
        (return i (.-elem u) true))
      (case ["map"]
        (return (.-key u) (.-elem u) true))
      (case ["chan"]
        (when (!= (.-dir u) syntax/SendOnly)
          (return (.-elem u) nil true))))

    (return nil nil false)))

(go/method rangeClause "rangeClause: range.go's rangeStmt's checks of the iteration variables (stmt.go's extraction of sKey, sValue and sExtra from the clause).\n" [^{:tag (* tchecker)} c ^{:tag (* tscope)} s ^{:tag (* syntax/RangeClause)} r]
  (let [sKey (.-Lhs r)
      ^syntax/Expr sValue (zero syntax/Expr)
      ^syntax/Expr sExtra (zero syntax/Expr)]
    (when [(values p ok) (assert (* syntax/ListExpr) sKey)] ok
      (when (< (len (.-ElemList p)) 2)
        (return))

      (set! sKey (aget (.-ElemList p) 0))
      (set! sValue (aget (.-ElemList p) 1))
      (when (> (len (.-ElemList p)) 2)
        (set! sExtra (aget (.-ElemList p) 2))))

    (let [x (.operand c s (.-X r))]
      (when (== (.-mode x) 0)
        (return))

      (let [(values k v ok) (rangeKeyVal (.-typ x))]
        (when (not ok)
          (return))

        (switch
          (case [(and (== k nil) (!= sKey nil))])
          (case [(and (== v nil) (!= sValue nil))]
            (.add (.-errs c) (syntax/StartPos sValue) (fmt/Sprintf "range over %s permits only one iteration variable" (operandString (.-X r) x))))
          (case [(!= sExtra nil)]
            (.add (.-errs c) (syntax/StartPos sExtra) "range clause permits at most two iteration variables")))))))

(go/func operandString "operandString: operand.go's, for the operands the checks know.\n" ^string [^syntax/Expr e ^toperand x]
  (when (== (.-mode x) 2)
    (return (+ (syntax/String e) " (untyped string constant)")))

  (+ (syntax/String e) " (variable of type " (.String (.-typ x)) ")"))

(go/method slice "slice: index.go's sliceExpr's checks of a slice expression whose operand the checks know: a 3-index slice of a string, the constant indices out of bounds and inverted.\n" [^{:tag (* tchecker)} c ^{:tag (* tscope)} s ^{:tag (* syntax/SliceExpr)} e]
  (let [x (.operand c s (.-X e))
      length (conv int64 -1)]
    (when (== (.-mode x) 0)
      (return))

    (let [t (.-typ x)]
      (switch
        (case [(isString t)]
          (when (.-Full e)
            (let [at (syntax/StartPos e)]
              (when (!= (aget (.-Index e) 2) nil)
                (set! at (syntax/StartPos (aget (.-Index e) 2))))

              (.add (.-errs c) at "invalid operation: 3-index slice of string")
              (return)))

          (when (== (.-mode x) 2)
            (set! length (.-slen x))))
        (case [(== (.-kind t) "array")]
          (set! length (.-n t)))
        (case [(and (== (.-kind t) "pointer") (== (.-kind (.-elem t)) "array"))]
          (set! length (.-n (.-elem t))))
        (case [(== (.-kind t) "slice")])
        (default
          (return))))

    (when (and (.-Full e) (or (== (aget (.-Index e) 1) nil) (== (aget (.-Index e) 2) nil)))
      (return))

    (let [^{:tag (array 3 int64)} ind (zero (array 3 int64))]
      (range [i expr (.-Index e)]
        (let [v (conv int64 -1)]
          (switch
            (case [(!= expr nil)]
              (let [max (conv int64 -1)]
                (when (>= length 0)
                  (set! max (+ length 1)))

                (set! v (.index c expr max))))
            (case [(== i 0)]
              (set! v 0))
            (case [(>= length 0)]
              (set! v length)))

          (aset ind i v)))

      (label :L
        (range [i v (subslice ind _ 2)]
          (when (> v 0)
            (range [j y (subslice ind (+ i 1))]
              (when (and (>= y 0) (< y v))
                (.add (.-errs c) (syntax/StartPos (aget (.-Index e) (+ i 1 j))) (fmt/Sprintf "invalid slice indices: %d < %d" y v))
                (break :L)))))))))

(go/method index "index: index.go's index for a constant index the checks know (an integer literal): its value, an error when it is max or more (max at least 0); -1 for any other index.\n" ^int64 [^{:tag (* tchecker)} c ^syntax/Expr e ^int64 max]
  (when [(values l ok) (assert (* syntax/BasicLit) (syntax/Unparen e))] (and ok (== (.-Kind l) syntax/IntLit) (not (.-Bad l)))
    (when [(values v err) (strconv/ParseInt (.-Value l) 0 64)] (== err nil)
      (when (and (>= max 0) (>= v max))
        (.add (.-errs c) (syntax/StartPos e) (fmt/Sprintf "invalid argument: index %d out of bounds [0:%d]" v max))
        (return -1))

      (return v)))

  -1)

(go/type collector "collector: writer.go's declCollector, its checks of pragmas and go:embed.\n" (struct
    ^{:tag (* errorList)} errs
    ^{:tag int} minor
    ^{:tag string} lang
    ^{:tag bool} withinFunc
    ^{:tag (* bool)} importedEmbed
    ^{:tag (* bool)} importedUnsafe
    ^{:tag (* (slice (* syntax/FuncDecl)))} funcs))

(go/method checkPragmas [^collector c ^syntax/Pragma p ^uint16 allowed ^bool embedOK]
  (when (== p nil)
    (return))

  (let [pragma (assert (* pragmas) p)]
    (range [_ pos (.-Pos pragma)]
      (when (!= (bit-and-not (.-Flag pos) allowed) 0)
        (.add (.-errs c) (.-Pos pos) "misplaced compiler directive")))

    (when (not embedOK)
      (range [_ e (.-Embeds pragma)]
        (.add (.-errs c) (.-Pos e) "misplaced go:embed directive")))))

(go/method Visit ^syntax/Visitor [^collector c ^syntax/Node n]
  (type-switch [n n]
    (case [(* syntax/File)]
      (.checkPragmas c (.-Pragma n) GoBuildPragma false))
    (case [(* syntax/ImportDecl)]
      (.checkPragmas c (.-Pragma n) 0 false)
      (when (!= (.-Path n) nil)
        (when [(values path err) (strconv/Unquote (.-Value (.-Path n)))] (== err nil)
          (switch path
            (case ["embed"]
              (set! @(.-importedEmbed c) true))
            (case ["unsafe"]
              (set! @(.-importedUnsafe c) true))))))

    (case [(* syntax/ConstDecl)]
      (.checkPragmas c (.-Pragma n) 0 false))
    (case [(* syntax/FuncDecl)]
      (.checkPragmas c (.-Pragma n) funcPragmas false)
      (set! @(.-funcs c) (append @(.-funcs c) n)))
    (case [(* syntax/TypeDecl)]
      (.checkPragmas c (.-Pragma n) 0 false))
    (case [(* syntax/VarDecl)]
      (.checkPragmas c (.-Pragma n) 0 true)
      (when [(values p ok) (assert (* pragmas) (.-Pragma n))] (and ok (> (len (.-Embeds p)) 0))
        (when [msg (checkEmbed n @(.-importedEmbed c) (.-withinFunc c) (.-minor c) (.-lang c))] (!= msg "")
          (.add (.-errs c) (.-Pos (aget (.-Embeds p) 0)) msg))))

    (case [(* syntax/BlockStmt)]
      (when (not (.-withinFunc c))
        (set! (.-withinFunc c) true)
        (return c))))

  c)

(go/func checkEmbed "checkEmbed: noder.go's, at language version go1.minor.\n" ^string [^{:tag (* syntax/VarDecl)} decl ^bool haveEmbed ^bool withinFunc ^int minor ^string lang]
  (switch
    (case [(not haveEmbed)]
      (return "go:embed requires import \"embed\" (or import _ \"embed\", if package is not used)"))
    (case [(> (len (.-NameList decl)) 1)]
      (return "go:embed cannot apply to multiple vars"))
    (case [(!= (.-Values decl) nil)]
      (return "go:embed cannot apply to var with initializer"))
    (case [(== (.-Type decl) nil)]
      (return "go:embed cannot apply to var without type"))
    (case [withinFunc]
      (return "go:embed cannot apply to var inside func"))
    (case [(< minor 16)]
      (return (fmt/Sprintf "go:embed requires go1.16 or later (-lang was set to %s; check go.mod)" lang)))
    (default
      (return ""))))

(go/func DeclErrors "DeclErrors returns the errors of the declarations' checks of gc's noder writer (collectDecls: misplaced directives, go:embed, go:linkname; funcExt: functions' directives) over the Go file at path, as Errors does, without its first character, at language version lang (gc's -lang, go1.N; empty: the latest); gc reports them when neither the parse nor the type checker reports an error. The package's scope is the file's: its functions and variables.\n" ^string [^string path ^string name ^string lang]
  (let [p (parse path)]
    (when (or (== (.-file p) nil) (> (len (.-errs (.-errs p))) 0))
      (return ""))

    (let [minor 27]
      (when (strings/HasPrefix lang "go1.")
        (when [(values n err) (strconv/Atoi (subslice lang (len "go1.")))] (== err nil)
          (set! minor n)))

      (let [errs (addr (lit errorList))
          (values importedEmbed importedUnsafe) (values false false)
          ^{:tag (slice (* syntax/FuncDecl))} funcs (zero (slice (* syntax/FuncDecl)))]
        (syntax/Walk (.-file p) (lit collector :errs errs :minor minor :lang lang :importedEmbed (addr importedEmbed) :importedUnsafe (addr importedUnsafe) :funcs (addr funcs)))

        ;; the package's scope: its functions (not methods, not init) and variables
        (let [objs (lit (map string bool))]
          (range [_ d (.-DeclList (.-file p))]
            (type-switch [d d]
              (case [(* syntax/FuncDecl)]
                (when (and (== (.-Recv d) nil) (!= (.-Value (.-Name d)) "init") (!= (.-Value (.-Name d)) "_"))
                  (aset objs (.-Value (.-Name d)) true)))

              (case [(* syntax/VarDecl)]
                (range [_ n (.-NameList d)]
                  (when (!= (.-Value n) "_")
                    (aset objs (.-Value n) true))))))

          (let [linked (lit (map string bool))]
            (range [_ l (.-linknames p)]
              (let [directive "go:linkname"]
                (when (.-std l)
                  (set! directive "go:linknamestd"))

                (when (not importedUnsafe)
                  (.add errs (.-pos l) (fmt/Sprintf "//%s only allowed in Go files that import \"unsafe\"" directive))
                  (continue))

                (when (and (strings/Contains (.-remote l) "[") (strings/Contains (.-remote l) "]"))
                  (.add errs (.-pos l) (fmt/Sprintf "//%s reference of an instantiation is not allowed" directive))
                  (continue))

                (cond (aget objs (.-local l))
                  (if (not (aget linked (.-local l)))
                    (aset linked (.-local l) true)

                    (.add errs (.-pos l) (fmt/Sprintf "duplicate //%s for %s" directive (.-local l))))

                  (>= minor 18)
                  (.add errs (.-pos l) (fmt/Sprintf "//%s must refer to declared function or variable" directive)))))

            ;; funcExt's checks of a function's directives
            (range [_ decl funcs]
              (let [^uint16 pragma (zero uint16)]
                (when [(values pr ok) (assert (* pragmas) (.-Pragma decl))] ok
                  (set! pragma (.-Flag pr)))

                (when (and (!= (bit-and pragma Systemstack) 0) (!= (bit-and pragma Nosplit) 0))
                  (.add errs ^{:go/via [decl node]} (.Pos decl) "go:nosplit and go:systemstack cannot be combined"))

                (when (!= (.-Body decl) nil)
                  (when (!= (bit-and pragma Noescape) 0)
                    (.add errs ^{:go/via [decl node]} (.Pos decl) "can only use //go:noescape with external func implementations"))

                  (when (and ^:go/paren (and (!= (bit-and pragma UintptrKeepAlive) 0) (== (bit-and pragma UintptrEscapes) 0)) (== (bit-and pragma Nosplit) 0))
                    (.add errs ^{:go/via [decl node]} (.Pos decl) "go:uintptrkeepalive requires go:nosplit")))))

            (.text errs name)))))))

;; Generated by arbace.repr.go.parse (bin/generated-check --update) from go/ast's forms,
;; tamago/goroot/go/go/ast/ast.ae (doc/go/GO-PARSER-SURVEY.md, GP1, GP7: GPS5 (a), GPS13 (b));
;; do not edit.
(in-ns 'go.arbace.repr.go.godump)

(go/file "dump.go"
  :doc "Package godump builds the tree of repr/go's dump (doc/go/HELPER-NOTES.md, \"The tree\") of a Go file as Arbace data: generated by arbace.repr.go.parse from go/ast's forms.\n"
  :imports [[arbace "arbace"]
            [ast "go/ast"]
            [parser "go/parser"]
            [token "go/token"]
            [os "os"]
            [filepath "path/filepath"]
            [strconv "strconv"]
            [strings "strings"]
            [time "time"]
            [utf8 "unicode/utf8"]])

(go/type dumper
  (struct ^{:tag (* token/FileSet)} fset
    ^{:tag (* token/File)} tf
    ^{:tag (slice byte)} src
    ^{:tag (map (* ast/CommentGroup) bool)} docs
    ^{:tag (slice any)} dirs
    ^{:tag (slice any)} warns))

(go/var ^{:tag any :doc "mkFn makes a node, (head {key value ...}) from head key value ...\n"} mkFn)

(go/var ^{:tag any :doc "vecFn is arbace.core/vector.\n"} vecFn)

(go/var ^{:tag any :doc "mapFn is arbace.core/array-map.\n"} mapFn)


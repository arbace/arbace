        (when (!= (.-Init x) nil) (set! kv (append kv kw_init (.node d (.-Init x)))))
        (when (!= (.-Cond x) nil) (set! kv (append kv kw_cond (.node d (.-Cond x)))))
        (when (!= (.-Post x) nil) (set! kv (append kv kw_post (.node d (.-Post x)))))
        (when (!= (.-Body x) nil) (set! kv (append kv kw_body (.node d (.-Body x)))))
        (return (arbace/Call mkFn (spread kv)))))
    (case [(* ast/RangeStmt)]
      (when (== x nil) (return nil))
      (let [kv (make (slice any) 1 17)]
        (aset kv 0 kw_range_stmt)
        (when (.IsValid (.-For x)) (set! kv (append kv kw_for (.pos d (.-For x)))))
        (when (!= (.-Key x) nil) (set! kv (append kv kw_key (.node d (.-Key x)))))
        (when (!= (.-Value x) nil) (set! kv (append kv kw_value (.node d (.-Value x)))))
        (when (.IsValid (.-TokPos x)) (set! kv (append kv kw_tok_pos (.pos d (.-TokPos x)))))
        (when (!= (.-Tok x) token/ILLEGAL) (set! kv (append kv kw_tok (.String (.-Tok x)))))
        (when (.IsValid (.-Range x)) (set! kv (append kv kw_range (.pos d (.-Range x)))))
        (when (!= (.-X x) nil) (set! kv (append kv kw_x (.node d (.-X x)))))
        (when (!= (.-Body x) nil) (set! kv (append kv kw_body (.node d (.-Body x)))))
        (return (arbace/Call mkFn (spread kv)))))
    (case [(* ast/ImportSpec)]
      (when (== x nil) (return nil))
      (let [kv (make (slice any) 1 11)]
        (aset kv 0 kw_import_spec)
        (when (!= (.-Doc x) nil)
          (set! kv (append kv kw_doc (.pos d (.Pos (.-Doc x)))))
          (aset (.-docs d) (.-Doc x) true))
        (when (!= (.-Name x) nil) (set! kv (append kv kw_name (.node d (.-Name x)))))
        (when (!= (.-Path x) nil) (set! kv (append kv kw_path (.node d (.-Path x)))))
        (when (!= (.-Comment x) nil) (set! kv (append kv kw_comment (.pos d (.Pos (.-Comment x))))))
        (when (.IsValid (.-EndPos x)) (set! kv (append kv kw_end_pos (.pos d (.-EndPos x)))))
        (return (arbace/Call mkFn (spread kv)))))
    (case [(* ast/ValueSpec)]
      (when (== x nil) (return nil))
      (let [kv (make (slice any) 1 11)]
        (aset kv 0 kw_value_spec)
        (when (!= (.-Doc x) nil)
          (set! kv (append kv kw_doc (.pos d (.Pos (.-Doc x)))))
          (aset (.-docs d) (.-Doc x) true))
        (when (!= (.-Names x) nil)
          (let [xs (make (slice any) (len (.-Names x)))]
            (range [i e (.-Names x)] (aset xs i (.node d e)))
            (set! kv (append kv kw_names (arbace/Call vecFn (spread xs))))))
        (when (!= (.-Type x) nil) (set! kv (append kv kw_type (.node d (.-Type x)))))
        (when (!= (.-Values x) nil)
          (let [xs (make (slice any) (len (.-Values x)))]
            (range [i e (.-Values x)] (aset xs i (.node d e)))
            (set! kv (append kv kw_values (arbace/Call vecFn (spread xs))))))
        (when (!= (.-Comment x) nil) (set! kv (append kv kw_comment (.pos d (.Pos (.-Comment x))))))
        (return (arbace/Call mkFn (spread kv)))))
    (case [(* ast/TypeSpec)]
      (when (== x nil) (return nil))
      (let [kv (make (slice any) 1 13)]
        (aset kv 0 kw_type_spec)
        (when (!= (.-Doc x) nil)
          (set! kv (append kv kw_doc (.pos d (.Pos (.-Doc x)))))
          (aset (.-docs d) (.-Doc x) true))
        (when (!= (.-Name x) nil) (set! kv (append kv kw_name (.node d (.-Name x)))))
        (when (!= (.-TypeParams x) nil)
          (set! kv (append kv kw_type_params (.node d (.-TypeParams x)))))
        (when (.IsValid (.-Assign x)) (set! kv (append kv kw_assign (.pos d (.-Assign x)))))
        (when (!= (.-Type x) nil) (set! kv (append kv kw_type (.node d (.-Type x)))))
        (when (!= (.-Comment x) nil) (set! kv (append kv kw_comment (.pos d (.Pos (.-Comment x))))))
        (return (arbace/Call mkFn (spread kv)))))
    (case [(* ast/BadDecl)]
      (when (== x nil) (return nil))
      (let [kv (make (slice any) 1 5)]
        (aset kv 0 kw_bad_decl)
        (when (.IsValid (.-From x)) (set! kv (append kv kw_from (.pos d (.-From x)))))
        (when (.IsValid (.-To x)) (set! kv (append kv kw_to (.pos d (.-To x)))))
        (return (arbace/Call mkFn (spread kv)))))
    (case [(* ast/GenDecl)]
      (when (== x nil) (return nil))
      (let [kv (make (slice any) 1 13)]
        (aset kv 0 kw_gen_decl)
        (when (!= (.-Doc x) nil)
          (set! kv (append kv kw_doc (.pos d (.Pos (.-Doc x)))))
          (aset (.-docs d) (.-Doc x) true))
        (when (.IsValid (.-TokPos x)) (set! kv (append kv kw_tok_pos (.pos d (.-TokPos x)))))
        (when (!= (.-Tok x) token/ILLEGAL) (set! kv (append kv kw_tok (.String (.-Tok x)))))
        (when (.IsValid (.-Lparen x)) (set! kv (append kv kw_lparen (.pos d (.-Lparen x)))))
        (when (!= (.-Specs x) nil)
          (let [xs (make (slice any) (len (.-Specs x)))]
            (range [i e (.-Specs x)] (aset xs i (.node d e)))
            (set! kv (append kv kw_specs (arbace/Call vecFn (spread xs))))))
        (when (.IsValid (.-Rparen x)) (set! kv (append kv kw_rparen (.pos d (.-Rparen x)))))
        (return (arbace/Call mkFn (spread kv)))))
    (case [(* ast/FuncDecl)]
      (when (== x nil) (return nil))
      (let [kv (make (slice any) 1 11)]
        (aset kv 0 kw_func_decl)
        (when (!= (.-Doc x) nil)
          (set! kv (append kv kw_doc (.pos d (.Pos (.-Doc x)))))
          (aset (.-docs d) (.-Doc x) true))
        (when (!= (.-Recv x) nil) (set! kv (append kv kw_recv (.node d (.-Recv x)))))
        (when (!= (.-Name x) nil) (set! kv (append kv kw_name (.node d (.-Name x)))))
        (when (!= (.-Type x) nil) (set! kv (append kv kw_type (.node d (.-Type x)))))
        (when (!= (.-Body x) nil) (set! kv (append kv kw_body (.node d (.-Body x)))))
        (return (arbace/Call mkFn (spread kv)))))
    (case [(* ast/File)]
      (when (== x nil) (return nil))
      (let [kv (make (slice any) 1 15)]
        (aset kv 0 kw_file)
        (when (!= (.-Doc x) nil)
          (set! kv (append kv kw_doc (.pos d (.Pos (.-Doc x)))))
          (aset (.-docs d) (.-Doc x) true))
        (when (.IsValid (.-Package x)) (set! kv (append kv kw_package (.pos d (.-Package x)))))
        (when (!= (.-Name x) nil) (set! kv (append kv kw_name (.node d (.-Name x)))))
        (when (!= (.-Decls x) nil)
          (let [xs (make (slice any) (len (.-Decls x)))]
            (range [i e (.-Decls x)] (aset xs i (.node d e)))
            (set! kv (append kv kw_decls (arbace/Call vecFn (spread xs))))))
        (when (.IsValid (.-FileStart x))
          (set! kv (append kv kw_file_start (.pos d (.-FileStart x)))))
        (when (.IsValid (.-FileEnd x)) (set! kv (append kv kw_file_end (.pos d (.-FileEnd x)))))
        (when (!= (.-GoVersion x) "") (set! kv (append kv kw_go_version (.str d (.-GoVersion x)))))
        (return (arbace/Call mkFn (spread kv)))))
    (case [(* ast/Package)]
      (when (== x nil) (return nil))
      (panic "godump: field Package.Files of type (map string (* File))")))
  (panic "godump: a node of a type go/ast does not declare"))

(go/func DumpFile
  "DumpFile parses the Go file at path (ParseComments, SkipObjectResolution) and dumps it: [tree comments directives warnings parse-ns dump-ns], or the error's text.\n"
  ^any [^string path]
  (let [(values src err) (os/ReadFile path)]
    (when (!= err nil) (return (.Error err)))
    (let
      [t0
       (time/Now)
       fset
       (token/NewFileSet)
       (values f ^:assign err)
       (parser/ParseFile fset path src (bit-or parser/ParseComments parser/SkipObjectResolution))]
      (when (!= err nil) (return (.Error err)))
      (let
        [t1
         (time/Now)
         d
         (addr
           (lit dumper
             :fset fset
             :src src
             :tf (.File fset (.-FileStart f))
             :docs (make (map (* ast/CommentGroup) bool))))
         tree
         (.node d f)
         cs
         (.comments d f)
         ws
         (make (slice any) (len (.-warns d)))]
        (range [i w (.-warns d)] (aset ws i w))
        (arbace/Call vecFn
          tree
          cs
          (arbace/Call vecFn (spread (.-dirs d)))
          (arbace/Call vecFn (spread ws))
          (.Nanoseconds (.Sub t1 t0))
          (.Nanoseconds (time/Since t1)))))))

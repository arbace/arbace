(go/method pos
  "pos is p as \"L:C\": raw (not adjusted by //line), byte columns from 1; nil when not valid.\n"
  ^any [^{:tag (* dumper)} d ^token/Pos p]
  (when (not (.IsValid p)) (return nil))
  (let [pp (.PositionFor (.-fset d) p false)]
    (+ (strconv/Itoa (.-Line pp)) ":" (strconv/Itoa (.-Column pp)))))

(go/method posFile
  "posFile is p as \"FILE:L:C\", FILE a base name.\n"
  ^string [^{:tag (* dumper)} d ^token/Pos p]
  (let [pp (.PositionFor (.-fset d) p false)]
    (+ (filepath/Base (.-Filename pp))
      ":"
      (strconv/Itoa (.-Line pp))
      ":"
      (strconv/Itoa (.-Column pp)))))

(go/method str
  "str is s, or (:bytes [b ...]) when s is not valid UTF-8.\n"
  ^any [^{:tag (* dumper)} d ^string s]
  (when (not (utf8/ValidString s))
    (let [bs (make (slice any) (len s))]
      (for [i 0] (< i (len s)) (inc! i) (aset bs i (conv int64 (aget s i))))
      (return (arbace/Call "arbace.core/list" kw_bytes (arbace/Call vecFn (spread bs))))))
  s)

(go/func chanDir
  ^any [^ast/ChanDir dir]
  (switch dir (case [ast/SEND] (return kw_send)) (case [ast/RECV] (return kw_recv)))
  kw_both)

(go/method dotAfter
  "dotAfter is the position of the first \".\" at or after from, skipping white space and comments; NoPos if another token comes first.\n"
  ^token/Pos [^{:tag (* dumper)} d ^token/Pos from]
  (let [src (.-src d) tf (.-tf d)]
    (when (or (== tf nil) (not (.IsValid from))) (return token/NoPos))
    (let [off (.Offset tf from)]
      (while (< off (len src))
        (let [c (aget src off)]
          (cond (or (== c \space) (== c \tab) (== c \newline) (== c \return))
            (inc! off)
            (and (== c \/) (< (+ off 1) (len src)) (== (aget src (+ off 1)) \/))
            (while (and (< off (len src)) (!= (aget src off) \newline)) (inc! off))
            (and (== c \/) (< (+ off 1) (len src)) (== (aget src (+ off 1)) \*))
            (let [end (strings/Index (conv string (subslice src (+ off 2))) "*/")]
              (when (< end 0) (return token/NoPos))
              (set! off + (+ 2 end 2)))
            (== c \.)
            (return (.Pos tf off))
            :else (return token/NoPos))))
      token/NoPos)))

(go/func isDirective
  "isDirective: //go: directives, build constraints, line directives, cgo's //export, gccgo's //extern, and every other directive go/ast recognises.\n"
  ^bool [^string text]
  (when
    (or (strings/HasPrefix text "//go:")
      (strings/HasPrefix text "//line ")
      (strings/HasPrefix text "/*line ")
      (strings/HasPrefix text "// +build")
      (strings/HasPrefix text "//export ")
      (strings/HasPrefix text "//extern "))
    (return true))
  (let [(values _ ok) (ast/ParseDirective token/NoPos text)] ok))

(go/func inExpr
  "inExpr reports whether position p lies strictly inside an expression of f.\n"
  ^bool [^{:tag (* ast/File)} f ^token/Pos p]
  (let [found false]
    (ast/Inspect f
      (fn ^bool [^ast/Node n]
        (when (or found (== n nil) (< p (.Pos n)) (>= p (.End n))) (return false))
        (let [(values _ ok) (assert ast/Expr n)] (when (and ok (< (.Pos n) p)) (set! found true)))
        (not found)))
    found))

(go/method comments
  "comments is the file's comment groups, [{:list [[\"L:C\" text] ...] [:text ...]} ...], :text on doc groups; it collects the directives and the warnings.\n"
  ^any [^{:tag (* dumper)} d ^{:tag (* ast/File)} f]
  (let [gs (make (slice any) (len (.-Comments f)))]
    (range [i g (.-Comments f)]
      (let [cs (make (slice any) (len (.-List g)))]
        (range [k c (.-List g)]
          (aset cs k (arbace/Call vecFn (.pos d (.-Slash c)) (.str d (.-Text c))))
          (when (isDirective (.-Text c))
            (set! (.-dirs d)
              (append (.-dirs d) (arbace/Call vecFn (.posFile d (.-Slash c)) (.str d (.-Text c)))))
            (when (and (strings/HasPrefix (.-Text c) "/*line ") (inExpr f (.-Slash c)))
              (set! (.-warns d)
                (append (.-warns d)
                  (+ (.posFile d (.-Slash c)) ": /*line*/ directive inside an expression"))))))
        (if (aget (.-docs d) g)
          (aset gs
            i
            (arbace/Call mapFn kw_list (arbace/Call vecFn (spread cs)) kw_text (.str d (.Text g))))
          (aset gs i (arbace/Call mapFn kw_list (arbace/Call vecFn (spread cs)))))))
    (arbace/Call vecFn (spread gs))))

(go/method node
  "node is n as the dump's tree: (:kebab-type {:kebab-field value ...}), fields in go/ast's order, those at their zero value left out.\n"
  ^any [^{:tag (* dumper)} d ^ast/Node n]
  (type-switch [x n]
    (case [(* ast/Comment)]
      (when (== x nil) (return nil))
      (let [kv (make (slice any) 1 5)]
        (aset kv 0 kw_comment)
        (when (.IsValid (.-Slash x)) (set! kv (append kv kw_slash (.pos d (.-Slash x)))))
        (when (!= (.-Text x) "") (set! kv (append kv kw_text (.str d (.-Text x)))))
        (return (arbace/Call mkFn (spread kv)))))
    (case [(* ast/CommentGroup)]
      (when (== x nil) (return nil))
      (let [kv (make (slice any) 1 3)]
        (aset kv 0 kw_comment_group)
        (when (!= (.-List x) nil)
          (let [xs (make (slice any) (len (.-List x)))]
            (range [i e (.-List x)] (aset xs i (.node d e)))
            (set! kv (append kv kw_list (arbace/Call vecFn (spread xs))))))
        (return (arbace/Call mkFn (spread kv)))))
    (case [(* ast/Field)]
      (when (== x nil) (return nil))
      (let [kv (make (slice any) 1 11)]
        (aset kv 0 kw_field)
        (when (!= (.-Doc x) nil)
          (set! kv (append kv kw_doc (.pos d (.Pos (.-Doc x)))))
          (aset (.-docs d) (.-Doc x) true))
        (when (!= (.-Names x) nil)
          (let [xs (make (slice any) (len (.-Names x)))]
            (range [i e (.-Names x)] (aset xs i (.node d e)))
            (set! kv (append kv kw_names (arbace/Call vecFn (spread xs))))))
        (when (!= (.-Type x) nil) (set! kv (append kv kw_type (.node d (.-Type x)))))
        (when (!= (.-Tag x) nil) (set! kv (append kv kw_tag (.node d (.-Tag x)))))
        (when (!= (.-Comment x) nil) (set! kv (append kv kw_comment (.pos d (.Pos (.-Comment x))))))
        (return (arbace/Call mkFn (spread kv)))))
    (case [(* ast/FieldList)]
      (when (== x nil) (return nil))
      (let [kv (make (slice any) 1 7)]
        (aset kv 0 kw_field_list)
        (when (.IsValid (.-Opening x)) (set! kv (append kv kw_opening (.pos d (.-Opening x)))))
        (when (!= (.-List x) nil)
          (let [xs (make (slice any) (len (.-List x)))]
            (range [i e (.-List x)] (aset xs i (.node d e)))
            (set! kv (append kv kw_list (arbace/Call vecFn (spread xs))))))
        (when (.IsValid (.-Closing x)) (set! kv (append kv kw_closing (.pos d (.-Closing x)))))
        (return (arbace/Call mkFn (spread kv)))))
    (case [(* ast/BadExpr)]
      (when (== x nil) (return nil))
      (let [kv (make (slice any) 1 5)]
        (aset kv 0 kw_bad_expr)
        (when (.IsValid (.-From x)) (set! kv (append kv kw_from (.pos d (.-From x)))))
        (when (.IsValid (.-To x)) (set! kv (append kv kw_to (.pos d (.-To x)))))

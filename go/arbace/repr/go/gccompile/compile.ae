(in-ns 'go.arbace.repr.go.gccompile)

(go/file "compile.go" :doc "Package gccompile runs gc's compiler, cmd/compile of TamaGo's go1.27.1 compiled into the program from its forms (the renamed copy arbace/repr/go/internal/gc), with a command line as go tool compile takes it: goi's errorcheck of the programs whose flags or errors need gc's own passes (liveness, write barriers, the SSA back end's passes and their -d output, the stack frame's size).\n" :imports [
    [fmt "fmt"]
    [log "log"]
    [os "os"]
    [strings "strings"]

    [amd64 "arbace/repr/go/internal/gc/compile/amd64"]
    [arm "arbace/repr/go/internal/gc/compile/arm"]
    [arm64 "arbace/repr/go/internal/gc/compile/arm64"]
    [base "arbace/repr/go/internal/gc/compile/base"]
    [gc "arbace/repr/go/internal/gc/compile/gc"]
    [loong64 "arbace/repr/go/internal/gc/compile/loong64"]
    [mips "arbace/repr/go/internal/gc/compile/mips"]
    [mips64 "arbace/repr/go/internal/gc/compile/mips64"]
    [ppc64 "arbace/repr/go/internal/gc/compile/ppc64"]
    [riscv64 "arbace/repr/go/internal/gc/compile/riscv64"]
    [s390x "arbace/repr/go/internal/gc/compile/s390x"]
    [ssagen "arbace/repr/go/internal/gc/compile/ssagen"]
    [wasm "arbace/repr/go/internal/gc/compile/wasm"]
    [x86 "arbace/repr/go/internal/gc/compile/x86"]
    [buildcfg "arbace/repr/go/internal/gc/std/buildcfg"]])

(go/const ^{:val 1 :doc "Revision is the driver's revision, raised with every change to it.\n"} Revision 1)

(go/var ^{:doc "archInits: cmd/compile's, each architecture's back end.\n"} archInits (lit (map string (func [(* ssagen/ArchInfo)]))
    ["386" x86/Init]
    ["amd64" amd64/Init]
    ["arm" arm/Init]
    ["arm64" arm64/Init]
    ["loong64" loong64/Init]
    ["mips" mips/Init]
    ["mipsle" mips/Init]
    ["mips64" mips64/Init]
    ["mips64le" mips64/Init]
    ["ppc64" ppc64/Init]
    ["ppc64le" ppc64/Init]
    ["riscv64" riscv64/Init]
    ["s390x" s390x/Init]
    ["wasm" wasm/Init]))

(go/func Compile "Compile runs gc's compile command as go tool compile runs it, args its arguments, one a line (none when empty): cmd/compile's main with them as its command line (os.Args). gc ends the process with its status (os.Exit: 0 when the package compiles, 2 when it reports errors), its messages on standard output and its object file where -o says, so Compile does not return. The environment's GOOS, GOARCH, GOAMD64, GOEXPERIMENT and GOROOT were read when the program started (internal/buildcfg's initialization): they are gc's configuration.\n" ^int [^string args]
  (let [argv (lit (slice string) "compile")]
    (when (!= args "")
      (set! argv (append argv (spread (strings/Split args "\n")))))
    (set! os/Args argv)

    ;; cmd/compile's main: disable timestamps for reproducible output
    (log/SetFlags 0)
    (log/SetPrefix "compile: ")

    (buildcfg/Check)
    (let [(values archInit ok) (aget archInits buildcfg/GOARCH)]
      (when (not ok)
        (fmt/Fprintf os/Stderr "compile: unknown architecture %q\n" buildcfg/GOARCH)
        (os/Exit 2))

      (gc/Main archInit)
      (base/Exit 0)
      0)))

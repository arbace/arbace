;; The package arbace/repr/go/gcsyntax (doc/go/GO-PARSER-SURVEY.md, GP6, GP7, GPS41 (c)): a Go
;; file's errors of gc's front end before its type checker (syntax errors, branches, pragmas) and
;; its declarations' checks after it, as gc reports them, by gc's own parser and noder's pragma
;; handler (ported from TamaGo's go1.27.1 src/cmd/compile/internal/noder: noder.go, lex.go,
;; writer.go; doc/ARBACE.md). Written in Go and read into these forms by repr/go (bin/repr-go
;; read), then maintained as forms. Hand-written Go forms, printed with the program
;; and listed in goi's table (go/arbace/gotable.edn), so that arbace.repr.go.syntax calls it
;; compiled; on an executable whose table does not list it (the tools' host until a re-seed), goi
;; loads it from ARBACE_PATH and interprets it, as it does when the compiled one's Revision is
;; another than the checkout's (arbace.repr.go.syntax/load!). It imports gc's syntax as the renamed copy
;; arbace/repr/go/internal/syntax (gc's cmd/compile/internal/syntax: cmd's internal packages are
;; not importable from the program; bin/generated-check keeps the copy tamago/cmd's).
(ns go.arbace.repr.go.gcsyntax
  (:require [arbace.go :as go]))

(go/package gcsyntax
  :path "arbace/repr/go/gcsyntax"
  :files ["errors.go"])

(load "gcsyntax/errors")

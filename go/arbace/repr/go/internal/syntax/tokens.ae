(in-ns 'go.arbace.repr.go.internal.syntax) (go/file "tokens.go" :imports [])

(go/type Token uint)

(go/type ^:alias token Token)

(go/directive "//go:generate stringer -type token -linecomment tokens.go")

(go/const
  ^{:line 14} [^{:tag token :val 0} _ iota]
  ^{:line 15} [^{:val 1} _EOF] ; EOF


  ^{:line 18} [^{:val 2 :doc "names and literals\n"} _Name] ; name
  ^{:line 19} [^{:val 3} _Literal] ; literal



  ^{:line 23} [^{:val 4 :doc "operators and operations\n_Operator is excluding '*' (_Star)\n"} _Operator] ; op
  ^{:line 24} [^{:val 5} _AssignOp] ; op=
  ^{:line 25} [^{:val 6} _IncOp] ; opop
  ^{:line 26} [^{:val 7} _Assign] ; =
  ^{:line 27} [^{:val 8} _Define] ; :=
  ^{:line 28} [^{:val 9} _Arrow] ; <-
  ^{:line 29} [^{:val 10} _Star] ; *


  ^{:line 32} [^{:val 11 :doc "delimiters\n"} _Lparen] ; (
  ^{:line 33} [^{:val 12} _Lbrack] ; [
  ^{:line 34} [^{:val 13} _Lbrace] ; {
  ^{:line 35} [^{:val 14} _Rparen] ; )
  ^{:line 36} [^{:val 15} _Rbrack] ; ]
  ^{:line 37} [^{:val 16} _Rbrace] ; }
  ^{:line 38} [^{:val 17} _Comma] ; ,
  ^{:line 39} [^{:val 18} _Semi] ; ;
  ^{:line 40} [^{:val 19} _Colon] ; :
  ^{:line 41} [^{:val 20} _Dot] ; .
  ^{:line 42} [^{:val 21} _DotDotDot] ; ...


  ^{:line 45} [^{:val 22 :doc "keywords\n"} _Break] ; break
  ^{:line 46} [^{:val 23} _Case] ; case
  ^{:line 47} [^{:val 24} _Chan] ; chan
  ^{:line 48} [^{:val 25} _Const] ; const
  ^{:line 49} [^{:val 26} _Continue] ; continue
  ^{:line 50} [^{:val 27} _Default] ; default
  ^{:line 51} [^{:val 28} _Defer] ; defer
  ^{:line 52} [^{:val 29} _Else] ; else
  ^{:line 53} [^{:val 30} _Fallthrough] ; fallthrough
  ^{:line 54} [^{:val 31} _For] ; for
  ^{:line 55} [^{:val 32} _Func] ; func
  ^{:line 56} [^{:val 33} _Go] ; go
  ^{:line 57} [^{:val 34} _Goto] ; goto
  ^{:line 58} [^{:val 35} _If] ; if
  ^{:line 59} [^{:val 36} _Import] ; import
  ^{:line 60} [^{:val 37} _Interface] ; interface
  ^{:line 61} [^{:val 38} _Map] ; map
  ^{:line 62} [^{:val 39} _Package] ; package
  ^{:line 63} [^{:val 40} _Range] ; range
  ^{:line 64} [^{:val 41} _Return] ; return
  ^{:line 65} [^{:val 42} _Select] ; select
  ^{:line 66} [^{:val 43} _Struct] ; struct
  ^{:line 67} [^{:val 44} _Switch] ; switch
  ^{:line 68} [^{:val 45} _Type] ; type
  ^{:line 69} [^{:val 46} _Var] ; var


  ^{:line 72} [^{:val 47 :doc "empty line comment to exclude it from .String\n"} tokenCount]) ;


(go/const

  ^{:line 77} [^{:val 22 :doc "for BranchStmt\n"} Break _Break]
  ^{:line 78} [^{:val 26} Continue _Continue]
  ^{:line 79} [^{:val 30} Fallthrough _Fallthrough]
  ^{:line 80} [^{:val 34} Goto _Goto]


  ^{:line 83} [^{:val 33 :doc "for CallStmt\n"} Go _Go]
  ^{:line 84} [^{:val 28} Defer _Defer])



(go/const ^{:tag uint64 :val 70368744177664 :doc "Make sure we have at most 64 tokens so we can use them in a set.\n"} _ (<< 1 (- tokenCount 1)))


^{:go/end 93} (go/func contains "contains reports whether tok is in tokset.\n" ^bool [^uint64 tokset ^token tok]
  (!= (bit-and tokset ^uint64 (<< 1 tok)) 0))


(go/type LitKind uint8)




(go/const "TODO(gri) With the 'i' (imaginary) suffix now permitted on integer\nand floating-point numbers, having a single ImagLit does\nnot represent the literal kind well anymore. Remove it?\n"
  ^{:line 101} [^{:tag LitKind :val 0} IntLit iota]
  ^{:line 102} [^{:val 1} FloatLit]
  ^{:line 103} [^{:val 2} ImagLit]
  ^{:line 104} [^{:val 3} RuneLit]
  ^{:line 105} [^{:val 4} StringLit])


(go/type Operator uint)

(go/directive "//go:generate stringer -type Operator -linecomment tokens.go")

(go/const
  ^{:line 113} [^{:tag Operator :val 0} _ iota]


  ^{:line 116} [^{:val 1 :doc "Def is the : in :=\n"} Def] ; :
  ^{:line 117} [^{:val 2} Not] ; !
  ^{:line 118} [^{:val 3} Recv] ; <-
  ^{:line 119} [^{:val 4} Tilde] ; ~


  ^{:line 122} [^{:val 5 :doc "precOrOr\n"} OrOr] ; ||


  ^{:line 125} [^{:val 6 :doc "precAndAnd\n"} AndAnd] ; &&


  ^{:line 128} [^{:val 7 :doc "precCmp\n"} Eql] ; ==
  ^{:line 129} [^{:val 8} Neq] ; !=
  ^{:line 130} [^{:val 9} Lss] ; <
  ^{:line 131} [^{:val 10} Leq] ; <=
  ^{:line 132} [^{:val 11} Gtr] ; >
  ^{:line 133} [^{:val 12} Geq] ; >=


  ^{:line 136} [^{:val 13 :doc "precAdd\n"} Add] ; +
  ^{:line 137} [^{:val 14} Sub] ; -
  ^{:line 138} [^{:val 15} Or] ; |
  ^{:line 139} [^{:val 16} Xor] ; ^


  ^{:line 142} [^{:val 17 :doc "precMul\n"} Mul] ; *
  ^{:line 143} [^{:val 18} Div] ; /
  ^{:line 144} [^{:val 19} Rem] ; %
  ^{:line 145} [^{:val 20} And] ; &
  ^{:line 146} [^{:val 21} AndNot] ; &^
  ^{:line 147} [^{:val 22} Shl] ; <<
  ^{:line 148} [^{:val 23} Shr]) ; >>



(go/const "Operator precedences\n"
  ^{:line 153} [^{:val 0} _ iota]
  ^{:line 154} [^{:val 1} precOrOr]
  ^{:line 155} [^{:val 2} precAndAnd]
  ^{:line 156} [^{:val 3} precCmp]
  ^{:line 157} [^{:val 4} precAdd]
  ^{:line 158} [^{:val 5} precMul])

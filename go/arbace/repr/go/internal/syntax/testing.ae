;; This file implements testing support.

(in-ns 'go.arbace.repr.go.internal.syntax) (go/file "testing.go" :imports [


    ^{:line 10} [io "io"]
    ^{:line 11} [regexp "regexp"]])





^{:go/end 23} (go/func CommentsDo "CommentsDo parses the given source and calls the provided handler for each\ncomment or error. If the text provided to handler starts with a '/' it is\nthe comment text; otherwise it is the error message.\n" [^io/Reader src ^{:tag (func [^uint line ^uint col ^string text])} handler]
  (let [^scanner s (zero scanner)]
    (.init s src handler comments)
    (while (!= (.-tok s) _EOF)
      (.next s))))














^{:go/end 69} (go/func CommentMap "CommentMap collects all comments in the given src with comment text\nthat matches the supplied regular expression rx and returns them as\n[]Error lists in a map indexed by line number. The comment text is\nthe comment with any comment markers (\"//\", \"/*\", or \"*/\") stripped.\nThe position for each Error is the position of the token immediately\npreceding the comment and the Error message is the comment text,\nwith all comments that are on the same line collected in a slice, in\nsource order. If there is no preceding token (the matching comment\nappears at the beginning of the file), then the recorded position\nis unknown (line, col = 0, 0). If there are no matching comments,\nthe result is nil.\n" [^io/Reader src ^{:tag (* regexp/Regexp)} rx] :results [^{:tag (map uint (slice Error))} res]
  ;; position of previous token
  (let [^{:tag (* PosBase)} base (zero (* PosBase))
      ^{:line 39 :tag (struct ^uint line ^uint col)} prev (zero (struct ^uint line ^uint col))

      ^{:line 41 :tag scanner} s (zero scanner)]
    (.init s src ^{:go/end 58} (fn [^uint _ ^uint _ ^string text]
        (when (!= (aget text 0) \/)
          (return)) ; not a comment, ignore

        (when (== (aget text 1) \*)
          (set! text (subslice text _ (- (len text) 2)))) ; strip trailing */

        (set! text (subslice text 2)) ; strip leading // or /*
        (when (.MatchString rx text)
          (let [pos (MakePos base (.-line prev) (.-col prev))
              ^{:line 52} err (lit Error pos text)]
            (when (== res nil)
              (set! res (make (map uint (slice Error)))))

            (aset res (.-line prev) (append (aget res (.-line prev)) err)))))

      ^{:line 58} comments)

    (while (!= (.-tok s) _EOF)
      (.next s)
      (when (and (== (.-tok s) _Semi) (!= (.-lit s) "semicolon"))
        (continue)) ; ignore automatically inserted semicolons

      (set! (values (.-line prev) (.-col prev)) (values (.-line s) (.-col s))))


    (return)))

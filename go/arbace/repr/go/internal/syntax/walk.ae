;; This file implements syntax tree walking.

(in-ns 'go.arbace.repr.go.internal.syntax) (go/file "walk.go" :imports [

    ^{:line 9} [fmt "fmt"]])






^{:go/end 18} (go/func Inspect "Inspect traverses an AST in pre-order: it starts by calling f(root);\nroot must not be nil. If f returns true, Inspect invokes f recursively\nfor each of the non-nil children of root, followed by a call of f(nil).\n\nSee Walk for caveats about shared nodes.\n" [^Node root ^{:tag (func [Node] [bool])} f]
  (Walk root (conv inspector f)))


(go/type inspector (func [Node] [bool]))

^{:go/breaks [[4 26]] :go/end 27} (go/method Visit ^Visitor [^inspector v ^Node node]
  (when (v node)
    (return v))

  nil)













^{:go/end 42} (go/func Walk "Walk traverses an AST in pre-order: It starts by calling\nv.Visit(node); node must not be nil. If the visitor w returned by\nv.Visit(node) is not nil, Walk is invoked recursively with visitor\nw for each of the non-nil children of node, followed by a call of\nw.Visit(nil).\n\nSome nodes may be shared among multiple parent nodes (e.g., types in\nfield lists such as type T in \"a, b, c T\"). Such shared nodes are\nwalked multiple times.\nTODO(gri) Revisit this design. It may make sense to walk those nodes\nonly once. A place where this matters is types2.TestResolveIdents.\n" [^Node root ^Visitor v]
  (.node (lit walker v) root))





(go/type Visitor "A Visitor's Visit method is invoked for each node encountered by Walk.\nIf the result visitor w is not nil, Walk visits each of the children\nof node with the visitor w, followed by a call of w.Visit(nil).\n" (interface
    (Visit [^Node node] :results [^Visitor w])))


(go/type walker (struct
    ^{:line 52 :tag Visitor} v))


^{:go/end 316} (go/method node [^walker w ^Node n]
  (when (== n nil)
    (panic "nil node"))


  (set! (.-v w) (.Visit (.-v w) n))
  (when (== (.-v w) nil)
    (return))


  (type-switch [n n]
    ;; packages
    (case [(* File)]
      (.node w (.-PkgName n))
      (.declList w (.-DeclList n)))

    ;; declarations
    (case [(* ImportDecl)]
      (when (!= (.-LocalPkgName n) nil)
        (.node w (.-LocalPkgName n)))

      (.node w (.-Path n)))

    (case [(* ConstDecl)]
      (.nameList w (.-NameList n))
      (when (!= (.-Type n) nil)
        (.node w (.-Type n)))

      (when (!= (.-Values n) nil)
        (.node w (.-Values n))))


    (case [(* TypeDecl)]
      (.node w (.-Name n))
      (.fieldList w (.-TParamList n))
      (.node w (.-Type n)))

    (case [(* VarDecl)]
      (.nameList w (.-NameList n))
      (when (!= (.-Type n) nil)
        (.node w (.-Type n)))

      (when (!= (.-Values n) nil)
        (.node w (.-Values n))))


    (case [(* FuncDecl)]
      (when (!= (.-Recv n) nil)
        (.node w (.-Recv n)))

      (.node w (.-Name n))
      (.fieldList w (.-TParamList n))
      (.node w (.-Type n))
      (when (!= (.-Body n) nil)
        (.node w (.-Body n))))


    ;; expressions
    (case [(* BadExpr)]) ; nothing to do
    (case [(* Name)]) ; nothing to do
    (case [(* BasicLit)]) ; nothing to do

    (case [(* CompositeLit)]
      (when (!= (.-Type n) nil)
        (.node w (.-Type n)))

      (.exprList w (.-ElemList n)))

    (case [(* KeyValueExpr)]
      (.node w (.-Key n))
      (.node w (.-Value n)))

    (case [(* FuncLit)]
      (.node w (.-Type n))
      (.node w (.-Body n)))

    (case [(* ParenExpr)]
      (.node w (.-X n)))

    (case [(* SelectorExpr)]
      (.node w (.-X n))
      (.node w (.-Sel n)))

    (case [(* IndexExpr)]
      (.node w (.-X n))
      (.node w (.-Index n)))

    (case [(* SliceExpr)]
      (.node w (.-X n))
      (range [_ x (.-Index n)]
        (when (!= x nil)
          (.node w x))))



    (case [(* AssertExpr)]
      (.node w (.-X n))
      (.node w (.-Type n)))

    (case [(* TypeSwitchGuard)]
      (when (!= (.-Lhs n) nil)
        (.node w (.-Lhs n)))

      (.node w (.-X n)))

    (case [(* Operation)]
      (.node w (.-X n))
      (when (!= (.-Y n) nil)
        (.node w (.-Y n))))


    (case [(* CallExpr)]
      (.node w (.-Fun n))
      (.exprList w (.-ArgList n)))

    (case [(* ListExpr)]
      (.exprList w (.-ElemList n)))

    ;; types
    (case [(* ArrayType)]
      (when (!= (.-Len n) nil)
        (.node w (.-Len n)))

      (.node w (.-Elem n)))

    (case [(* SliceType)]
      (.node w (.-Elem n)))

    (case [(* DotsType)]
      (.node w (.-Elem n)))

    (case [(* StructType)]
      (.fieldList w (.-FieldList n))
      (range [_ t (.-TagList n)]
        (when (!= t nil)
          (.node w t))))



    (case [(* Field)]
      (when (!= (.-Name n) nil)
        (.node w (.-Name n)))

      (.node w (.-Type n)))

    (case [(* InterfaceType)]
      (.fieldList w (.-MethodList n)))

    (case [(* FuncType)]
      (.fieldList w (.-ParamList n))
      (.fieldList w (.-ResultList n)))

    (case [(* MapType)]
      (.node w (.-Key n))
      (.node w (.-Value n)))

    (case [(* ChanType)]
      (.node w (.-Elem n)))

    ;; statements
    (case [(* EmptyStmt)]) ; nothing to do

    (case [(* LabeledStmt)]
      (.node w (.-Label n))
      (.node w (.-Stmt n)))

    (case [(* BlockStmt)]
      (.stmtList w (.-List n)))

    (case [(* ExprStmt)]
      (.node w (.-X n)))

    (case [(* SendStmt)]
      (.node w (.-Chan n))
      (.node w (.-Value n)))

    (case [(* DeclStmt)]
      (.declList w (.-DeclList n)))

    (case [(* AssignStmt)]
      (.node w (.-Lhs n))
      (when (!= (.-Rhs n) nil)
        (.node w (.-Rhs n))))


    (case [(* BranchStmt)]
      (when (!= (.-Label n) nil)
        (.node w (.-Label n))))

    ;; Target points to nodes elsewhere in the syntax tree

    (case [(* CallStmt)]
      (.node w (.-Call n)))

    (case [(* ReturnStmt)]
      (when (!= (.-Results n) nil)
        (.node w (.-Results n))))


    (case [(* IfStmt)]
      (when (!= (.-Init n) nil)
        (.node w (.-Init n)))

      (.node w (.-Cond n))
      (.node w (.-Then n))
      (when (!= (.-Else n) nil)
        (.node w (.-Else n))))


    (case [(* ForStmt)]
      (when (!= (.-Init n) nil)
        (.node w (.-Init n)))

      (when (!= (.-Cond n) nil)
        (.node w (.-Cond n)))

      (when (!= (.-Post n) nil)
        (.node w (.-Post n)))

      (.node w (.-Body n)))

    (case [(* SwitchStmt)]
      (when (!= (.-Init n) nil)
        (.node w (.-Init n)))

      (when (!= (.-Tag n) nil)
        (.node w (.-Tag n)))

      (range [_ s (.-Body n)]
        (.node w s)))


    (case [(* SelectStmt)]
      (range [_ s (.-Body n)]
        (.node w s)))


    ;; helper nodes
    (case [(* RangeClause)]
      (when (!= (.-Lhs n) nil)
        (.node w (.-Lhs n)))

      (.node w (.-X n)))

    (case [(* CaseClause)]
      (when (!= (.-Cases n) nil)
        (.node w (.-Cases n)))

      (.stmtList w (.-Body n)))

    (case [(* CommClause)]
      (when (!= (.-Comm n) nil)
        (.node w (.-Comm n)))

      (.stmtList w (.-Body n)))

    (default
      (panic (fmt/Sprintf "internal error: unknown node type %T" n))))


  (.Visit (.-v w) nil))


^{:go/end 322} (go/method declList [^walker w ^{:tag (slice Decl)} list]
  (range [_ n list]
    (.node w n)))



^{:go/end 328} (go/method exprList [^walker w ^{:tag (slice Expr)} list]
  (range [_ n list]
    (.node w n)))



^{:go/end 334} (go/method stmtList [^walker w ^{:tag (slice Stmt)} list]
  (range [_ n list]
    (.node w n)))



^{:go/end 340} (go/method nameList [^walker w ^{:tag (slice (* Name))} list]
  (range [_ n list]
    (.node w n)))



^{:go/end 346} (go/method fieldList [^walker w ^{:tag (slice (* Field))} list]
  (range [_ n list]
    (.node w n)))

(in-ns 'go.arbace.repr.go.internal.gc.compile.riscv64) (go/file "gsubr.go" :imports [


    ^{:line 8} [objw "arbace/repr/go/internal/gc/compile/objw"]
    ^{:line 9} [obj "arbace/repr/go/internal/gc/cmd/obj"]
    ^{:line 10} [riscv "arbace/repr/go/internal/gc/cmd/obj/riscv"]])


^{:go/end 20} (go/func ginsnop ^{:tag (* obj/Prog)} [^{:tag (* objw/Progs)} pp]
  ;; Hardware nop is ADD $0, ZERO
  (let [p (.Prog pp riscv/AADD)]
    (set! (.-Type (.-From p)) obj/TYPE_CONST)
    (set! (.-Reg p) riscv/REG_ZERO)
    (set! (.-To p) (lit obj/Addr :Type obj/TYPE_REG :Reg riscv/REG_ZERO))
    ^{:line 19} p))

(ns go.arbace.pytls
  (:require [arbace.go :as go]))

(go/package tls
  :path "arbace/pytls"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["alert.go" "arbace_keylog_alerts.go" "arbace_pha.go" "arbace_psk.go" "auth.go" "cache.go" "cipher_suites.go" "common.go" "common_string.go" "conn.go" "defaults.go" "defaults_fips140.go" "ech.go" "handshake_client.go" "handshake_client_tls13.go" "handshake_messages.go" "handshake_server.go" "handshake_server_tls13.go" "key_agreement.go" "key_schedule.go" "prf.go" "quic.go" "ticket.go" "tls.go"]
  :test-files ["arbace_features_test.go"]
  :init-order [["alert.go" 15 5] alertText ErrPostHandshakeAuthNotTLS13 ErrPostHandshakeAuthNotOffered ErrPostHandshakeAuthPending ErrPostHandshakeAuthHandshake ErrPostHandshakeAuthClient signaturePadding rsaSignatureSchemes globalCertCache supportedUpToTLS12 supportedOnlyTLS12 supportedOnlyTLS13 cipherSuites cipherSuitesTLS13 cipherSuitesPreferenceOrder cipherSuitesPreferenceOrderNoAES disabledCipherSuites hasGCMAsmAMD64 hasGCMAsmARM64 hasGCMAsmS390X hasGCMAsmPPC64 hasAESGCMHardwareSupport aesgcmCiphers directSigning helloRetryRequestRandom deprecatedSessionTicketKey supportedVersions errNoCertificates tlssha1 _SignatureScheme_index_8 _SignatureScheme_index_9 _CurveID_index_0 _CurveID_index_3 _ClientAuthType_index outBufPool errShutdown errEarlyCloseWrite tlsmlkem tlssecpmlkem defaultCipherSuitesTLS13 defaultCipherSuitesTLS13NoAES allowedSupportedVersionsFIPS allowedCurvePreferencesFIPS allowedSignatureAlgorithmsFIPS allowedCipherSuitesFIPS allowedCipherSuitesTLS13FIPS errMalformedECHConfigList errMalformedECHExt errInvalidECHExt fips140ems tlsmaxrsasize errClientKeyExchange errServerKeyExchange ["tls.go" 115 5] arbacePSKKey arbacePSKOther arbacePSKSuites]
  :positions :full)

(load "pytls/alert")
(load "pytls/arbace_keylog_alerts")
(load "pytls/arbace_pha")
(load "pytls/arbace_psk")
(load "pytls/auth")
(load "pytls/cache")
(load "pytls/cipher_suites")
(load "pytls/common")
(load "pytls/common_string")
(load "pytls/conn")
(load "pytls/defaults")
(load "pytls/defaults_fips140")
(load "pytls/ech")
(load "pytls/handshake_client")
(load "pytls/handshake_client_tls13")
(load "pytls/handshake_messages")
(load "pytls/handshake_server")
(load "pytls/handshake_server_tls13")
(load "pytls/key_agreement")
(load "pytls/key_schedule")
(load "pytls/prf")
(load "pytls/quic")
(load "pytls/ticket")
(load "pytls/tls")
(load "pytls/arbace_features_test")

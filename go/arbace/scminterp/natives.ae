;; scminterp: arbace.lang.SchemeInterp's natives.
(in-ns 'go.arbace.scminterp)

(go/file "natives.go"
  :doc "Package scminterp holds the natives of arbace.lang.SchemeInterp, si (arbace/scm) reached from Arbace: a Scheme
program run as test/scheme/si-driver runs one, psyntax booted from its expanded system given as text.\n"
  :imports [[fmt "fmt"] [os "os"] [scm "arbace/scm"] [jrt "arbace/jrt"]])

(go/func goStrings "goStrings is a String[]'s elements as Go strings.\n" ^{:tag (slice string)} [^{:tag (* jrt/RefArray)} a]
  (let [xs (make (slice string) 0 (len (.-A a)))]
    (range [_ x (.-A a)]
      (set! xs (append xs (.String (assert (* jrt/String) x)))))
    xs))

(go/func SchemeInterp_RunProgram_String_String1_String_String1_I__I_native
  "SchemeInterp_RunProgram_String_String1_String_String1_I__I_native runs the program in the file named file on si, as
test/scheme/si-driver runs one: psyntax booted from pp (psyntax.pp as Scheme text) with the library path libs, (command-line)
file then args, on the process's standard streams. flags: 1 the driver's --case, 2 --r7rs, 4 --core. The program's exit
status, 255 for an uncaught raise (reported on stderr as Chez reports it), 2 when the file cannot be read.\n"
  ^int32 [^{:tag (* jrt/String)} pp ^{:tag (* jrt/RefArray)} libs ^{:tag (* jrt/String)} file ^{:tag (* jrt/RefArray)} args ^int32 flags]
  (let [cases (!= (bit-and flags 1) 0)
        r7rs (!= (bit-and flags 2) 0)
        core (!= (bit-and flags 4) 0)
        name (.String file)
        (values b err) (os/ReadFile name)]
    (when (!= err nil)
      (fmt/Fprintln os/Stderr "si:" err)
      (return 2))
    ;; the package's globals are the process's: each run sets them all
    (set! scm/ReportData cases)
    (set! scm/OnRun nil)
    (when cases
      (set! scm/OnRun (fn [] (scm/FlushAll) (fmt/Fprintln os/Stderr "SI-RUN"))))
    (set! scm/CommandLine (append (lit (slice string) name) (spread (goStrings args))))
    (let [m (scm/NewM)
          status (scm/Report (fn []
                   (when (not core)
                     (.Boot m (scm/ReadAllString (.String pp)))
                     (.SetLibraryPath m (goStrings libs)))
                   (set! scm/R7RS r7rs)
                   (let [(values forms _) (scm/ReadProgram (conv string b))]
                     (cond
                       core (range [_ f forms]
                              (.Eval m f))
                       cases (.RunFile m forms)
                       :else (.RunProgram m forms)))))]
      (conv int32 status))))

;; goi's back end, the package arbace/goi (doc/go/GOI-SPEC.md §1.3, §4, §5): hand-written Go
;; forms, printed with the program as jrt is (j2g --program copies them). GR1: the frames and
;; nodes the table's invokers make, the table's registry, the boundary conversions between
;; Arbace and Go values, calls of compiled Go from Arbace, the GoValue protocol, and the natives
;; of arbace.lang.GoInterp. GR3: the interpreter's core: threads, frames, cells, descriptors
;; (types), functions, calls, defer, panic and recover (func), statements (stmt), expressions
;; (expr), the operators (ops, generated) and the registry of factories the builder calls
;; through GoInterp's op native (registry, generated by test/goi/gen_nodes.ae). GR4: methods,
;; interfaces' dispatch, assertions and type switches (method);
;; goroutines, channels, select, range over functions (chan). GR5: typed adapters, Arbace fns as
;; Go funcs, the bridge to Arbace and the package arbace's hooks (adapt); traces and panics
;; leaving Go (trace). GR9a-c: interpreted named types as runtime types of their own (types, over
;; reflect's overlay), their methods' typed stubs (stubs). GR8b: reflect's method members as
;; interpreted code calls them (reflect).
(ns go.arbace.goi
  (:require [arbace.go :as go]))

(go/package goi
  :path "arbace/goi"
  :files ["adapt.go" "call.go" "chan.go" "convert.go" "expr.go" "frame.go" "func.go" "method.go" "natives.go" "ops.go" "reflect.go" "registry.go" "stmt.go"
          "stubs.go" "table.go" "trace.go" "types.go" "value.go"])

(load "goi/adapt")
(load "goi/call")
(load "goi/chan")
(load "goi/convert")
(load "goi/expr")
(load "goi/frame")
(load "goi/func")
(load "goi/method")
(load "goi/natives")
(load "goi/ops")
(load "goi/reflect")
(load "goi/registry")
(load "goi/stmt")
(load "goi/stubs")
(load "goi/table")
(load "goi/trace")
(load "goi/types")
(load "goi/value")

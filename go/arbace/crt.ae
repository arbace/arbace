(ns go.arbace.crt
  (:require [arbace.go :as go]))

(go/package crt
  :path "arbace/crt"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["mem.go" "sys_linux.go" "sys_other.go" "syscall.go" "wide.go"]
  :init-order []
  :positions :lines)

(load "crt/mem")
(load "crt/sys_linux")
(load "crt/sys_other")
(load "crt/syscall")
(load "crt/wide")

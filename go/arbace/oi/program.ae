^{:go/end 187} (go/method RunInit "RunInit runs a unit's initialisation on th.\n" ^Value [^{:tag (* Program)} p ^{:tag (* Thread)} th ^{:tag (* Code)} code]
  (let [fr (addr (lit Frame :S (make (slice Value) (.-NSlots code)) :Th th))]

          (set! (values (.-tcF th) (.-tcA th)) (values resumeFn (lit (slice Value) (ContinuationUse k) raiseFn (addr (lit Block :Tag 0 :F (lit (slice Value) ctor eff))) 0)))
          (return tailMark))))

    (let [k2 (addr (lit Block :Tag TagCont :F (lit (slice Value) pf pf)))
        ^{:line 278} r (.-reply pf)]
      (.Unlock gil)
      (>! r (lit fiberMsg :kind msgEffect :v eff :k k2))
      (let [m (<! (.-resumeCh pf))]
        (.Lock gil)
        (set! (.-reply pf) (.-reply m))
        (set! (values (.-tcF th) (.-tcA th)) (values resumeFn (lit (slice Value) (ContinuationUse k) (.-f m) (.-arg m) 0)))
        ^{:line 285} tailMark))))

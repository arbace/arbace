        (regIfAbsent "caml_ba_reshape" ^{:go/end 503} (fn ^Value [^{:tag (* Thread)} _ ^{:tag (slice Value)} a]
            (let [b (baOf (aget a 0))
                ^{:line 498} dims (intsOf (aget a 1))]
              ;; caml_ba_reshape's checks: the number of dimensions, negative ones, an overflow of the product (a mismatch)
              (when (> (len dims) 16)
                (InvalidArg "Bigarray.reshape: bad number of dimensions"))
              (range [_ d dims]
                (when (< d 0)
                  (InvalidArg "Bigarray.reshape: negative dimension")))
              (when [(values n ok) (baElements dims)] (or (not ok) (!= n (len (.-data b))))
                (InvalidArg "Bigarray.reshape: size mismatch"))

              (.wrap b (.-data b) dims))))

        (regIfAbsent "caml_ba_change_layout" ^{:go/end 511} (fn ^Value [^{:tag (* Thread)} _ ^{:tag (slice Value)} a]
            (let [b (baOf (aget a 0))
                ^{:line 506} nb (addr (lit bigarray :kind (.-kind b) :layout (AsInt (aget a 1)) :data (.-data b)))]
              (for [i (- (len (.-dims b)) 1)] (>= i 0) (dec! i)
                (set! (.-dims nb) (append (.-dims nb) (aget (.-dims b) i))))

              (addr (lit Custom :Name "_bigarr02" :V nb)))))))))

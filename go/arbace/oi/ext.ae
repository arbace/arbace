(go/type Ext "Ext is an external's implementation (the runtime's C primitive of that name), over its\narguments as the call evaluated them.\n" (func [^{:tag (* Thread)} th ^{:tag (slice Value)} a] [Value]))



(go/var ^{:doc "Externals are the implemented externals by C name (the runtime's primitives that the stdlib\nand the programs name in their external declarations).\n"} Externals (lit (map string Ext)))


^{:go/end 19} (go/func RegisterExt "RegisterExt registers the external name; files register theirs in init.\n" [^string name ^Ext f]
  (when [(values _ dup) (aget Externals name)] dup
    (panic (+ "oi: external registered twice: " name)))

  (aset Externals name f))



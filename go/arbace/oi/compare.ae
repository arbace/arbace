    (return -1 true))

  (when (> d1 d2)
    (return 1 true))

  (when (!= d1 d2)
    (when (not total)
      (return unordered true))

    (when (== d1 d1)
      (return 1 true))

    (when (== d2 d2)
      (return -1 true)))


  (return 0 false))




;; oi's system interface where Linux's syscall package has it (OC170, doc/ocaml/OCAML-SURVEY.md, "As built: the embedding's gaps"):
;; getrusage(2), isatty's ioctl, O_NONBLOCK and SIGSTOP (ext_sys.ae). goi's table lists arbace/oi in the tamago configurations
;; too, whose syscall has none of them: ext_sys_other.ae there.
(in-ns 'go.arbace.oi)

(go/file "ext_sys_linux.go"
  :build ["//go:build linux"]
  :imports [[syscall "syscall"] [unsafe "unsafe"]])

;; open(2)'s O_NONBLOCK (Open_nonblock), getrusage(2)'s whos, SIGSTOP's number (no handler may take it)
(go/const [^{:val 2048} oNonblock syscall/O_NONBLOCK] [^{:val 0} rusageSelf syscall/RUSAGE_SELF] [^{:val -1} rusageChildren syscall/RUSAGE_CHILDREN]
  [^{:val 19} sigStop (conv int syscall/SIGSTOP)])

(go/func rusageSeconds "rusageSeconds is getrusage(2)'s user and system time of who in seconds, 0 when it fails.\n" ^float64 [^int who]
  (let [^syscall/Rusage ru (zero syscall/Rusage)]
    (when (!= (syscall/Getrusage who (addr ru)) nil)
      (return 0))
    (let [tv (fn ^float64 [^syscall/Timeval t] (+ (conv float64 (.-Sec t)) (/ (conv float64 (.-Usec t)) 1000000.0)))]
      (+ (tv (.-Utime ru)) (tv (.-Stime ru))))))

(go/func isatty "isatty is whether fd is a terminal (TCGETS succeeds).\n" ^bool [^int fd]
  (let [^syscall/Termios t (zero syscall/Termios)
        (values _ _ e) (syscall/Syscall syscall/SYS_IOCTL (conv uintptr fd) (conv uintptr syscall/TCGETS) (conv uintptr (conv unsafe/Pointer (addr t))))]
    (== e 0)))

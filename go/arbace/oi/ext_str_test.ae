(in-ns 'go.arbace.oi) (go/file "ext_str_test.go" :imports [

    ^{:line 3} [testing "testing"]])


^{:go/breaks [8] :go/end 22} (go/func invalidArg "invalidArg runs f and returns the Invalid_argument message it raised, \"\" if none.\n" [^{:tag (func [])} f] :results [^string msg]
  (defer (^{:go/end 19} (fn []
        (when [r (recover)] (!= r nil)
          (let [(values e ok) (assert (* Exn) r)]
            (when (not ok)
              (panic r))

            (let [b (assert (* Block) (.-V e))]
              (when (!= (aget (.-F b) 0) ExnInvalidArgument)
                (panic r))

              (set! msg (GoString (aget (.-F b) 1)))))))))


  (f)
  "")


^{:go/end 53} (go/func TestStrBasics [^{:tag (* testing/T)} t]
  (when (or (!= (call "caml_ml_string_length" (Str "héllo")) 6) (!= (call "caml_ml_bytes_length" (Str "")) 0))
    ^{:go/via [common]} (.Error t "length"))

  (when [m (invalidArg ^{:go/end 28} (fn [] (call "caml_create_bytes" -1)))] (!= m "Bytes.create")
    ^{:go/via [common]} (.Errorf t "create_bytes -1: %q" m))

  (when [m (invalidArg ^{:go/end 31} (fn [] (call "caml_create_bytes" (<< 1 60))))] (!= m "Bytes.create")
    ^{:go/via [common]} (.Errorf t "create_bytes huge: %q" m))

  (when [b (assert (* Bytes) (call "caml_create_bytes" 3))] (!= (len (.-B b)) 3)
    ^{:go/via [common]} (.Error t "create_bytes length"))

  (let [s (Str "abcdef")]
    (when (or (!= (call "caml_string_get" s 2) (conv int \c)) (!= (call "caml_bytes_get" s 5) (conv int \f)))
      ^{:go/via [common]} (.Error t "get"))

    (range [_ i (lit (slice int) -1 6)]
      (when [m (invalidArg ^{:go/end 42} (fn [] (call "caml_string_get" s i)))] (!= m "index out of bounds")
        ^{:go/via [common]} (.Errorf t "get %d: %q" i m))

      (when [m (invalidArg ^{:go/end 45} (fn [] (call "caml_bytes_set" s i 65)))] (!= m "index out of bounds")
        ^{:go/via [common]} (.Errorf t "set %d: %q" i m)))


    (call "caml_bytes_set" s 0 (conv int \X))
    (when (!= (GoString s) "Xbcdef")
      ^{:go/via [common]} (.Error t "set"))))



^{:go/end 92} (go/func TestStrWide [^{:tag (* testing/T)} t]
  (let [b (addr (lit Bytes :B (lit (slice byte) 1 2 3 4 5 6 7 8 0xff)))]
    (when (or (!= (call "caml_string_get16" b 0) 0x0201) (!= (call "caml_bytes_get16" b 7) 0xff08))
      ^{:go/via [common]} (.Error t "get16"))

    (when (or (!= (call "caml_string_get32" b 1) (conv int32 0x05040302)) (!= (call "caml_bytes_get32" b 0) (conv int32 0x04030201)))
      ^{:go/via [common]} (.Error t "get32"))

    (when (!= (call "caml_string_get64" b 1) (conv int64 -0x00f7f8f9fafbfcfe))
      ^{:go/via [common]} (.Errorf t "get64 %v" (call "caml_string_get64" b 1)))

    (when (!= (call "caml_bytes_get32" (addr (lit Bytes :B (lit (slice byte) 0xff 0xff 0xff 0xff))) 0) (conv int32 -1))
      ^{:go/via [common]} (.Error t "get32 neg"))

    (range [_ c (lit (slice (struct
              ^{:line 70 :tag string} name
              ^{:line 71 :tag int} i))
          (lit _ "caml_string_get16" 8) (lit _ "caml_bytes_get32" 6) (lit _ "caml_bytes_get64" 2) (lit _ "caml_bytes_get64" -1))]
      (when [m (invalidArg ^{:go/end 73} (fn [] (call (.-name c) b (.-i c))))] (!= m "index out of bounds")
        ^{:go/via [common]} (.Errorf t "%s %d: %q" (.-name c) (.-i c) m)))


    (let [w (addr (lit Bytes :B (make (slice byte) 8)))]
      (call "caml_bytes_set16" w 0 0x1234)
      (call "caml_bytes_set16" w 2 -2)
      (call "caml_bytes_set32" w 4 (conv int32 -2))
      (let [want (lit (slice byte) 0x34 0x12 0xfe 0xff 0xfe 0xff 0xff 0xff)]
        (when (!= (conv string (.-B w)) (conv string want))
          ^{:go/via [common]} (.Errorf t "set16/32: %x" (.-B w)))

        (call "caml_bytes_set64" w 0 (conv int64 0x0102030405060708))
        (when (!= (conv string (.-B w)) (conv string (lit (slice byte) 8 7 6 5 4 3 2 1)))
          ^{:go/via [common]} (.Errorf t "set64: %x" (.-B w)))

        (when [m (invalidArg ^{:go/end 89} (fn [] (call "caml_bytes_set64" w 1 (conv int64 0))))] (!= m "index out of bounds")
          ^{:go/via [common]} (.Errorf t "set64 oob: %q" m))))))



^{:go/end 118} (go/func TestStrCompare [^{:tag (* testing/T)} t]
  (let [cases (lit (slice (struct
            ^{:line 96 :tag string} a ^string b
            ^{:line 97 :tag int} cmp))
        (lit _ "" "" 0) (lit _ "a" "a" 0) (lit _ "a" "b" -1) (lit _ "b" "a" 1) (lit _ "ab" "a" 1) (lit _ "a" "ab" -1) (lit _ "a\u0000" "a" 1) (lit _ (byte-string 0xff) "a" 1) (lit _ "abc" "abd" -1))]
    (range [_ c cases]
      (range [_ k (lit (slice string) "string" "bytes")]
        (let [(values a b) (values (Str (.-a c)) (Str (.-b c)))]
          (when [got (call (+ "caml_" k "_compare") a b)] (!= got (.-cmp c))
            ^{:go/via [common]} (.Errorf t "%s_compare %q %q = %v" k (.-a c) (.-b c) got))

          (let [chk ^{:go/end 109} (fn [^string op ^bool want]
                (when (!= (call (+ "caml_" k "_" op) a b) (Bool want))
                  ^{:go/via [common]} (.Errorf t "%s_%s %q %q != %v" k op (.-a c) (.-b c) want)))]


            (chk "equal" (== (.-cmp c) 0))
            (chk "notequal" (!= (.-cmp c) 0))
            (chk "lessthan" (< (.-cmp c) 0))
            (chk "lessequal" (<= (.-cmp c) 0))
            (chk "greaterthan" (> (.-cmp c) 0))
            (chk "greaterequal" (>= (.-cmp c) 0))))))))




^{:go/end 139} (go/func TestStrBlitFill [^{:tag (* testing/T)} t]
  (let [src (Str "hello world")
      ^{:line 122} dst (Str "..........")]
    (call "caml_blit_string" src 6 dst 1 5)
    (when (!= (GoString dst) ".world....")
      ^{:go/via [common]} (.Errorf t "blit: %q" (GoString dst)))

    (let [ov (Str "abcdef")]
      (call "caml_blit_bytes" ov 0 ov 2 4) ; overlapping, memmove
      (when (!= (GoString ov) "ababcd")
        ^{:go/via [common]} (.Errorf t "overlap blit: %q" (GoString ov)))

      (call "caml_fill_bytes" dst 2 3 (conv int \z))
      (when (!= (GoString dst) ".wzzzd....")
        ^{:go/via [common]} (.Errorf t "fill: %q" (GoString dst)))

      (when (or (!= (call "caml_string_of_bytes" dst) (conv Value dst)) (!= (call "caml_bytes_of_string" dst) (conv Value dst)))
        ^{:go/via [common]} (.Error t "identity")))))

(in-ns 'go.arbace.oi) (go/file "exn.go" :imports [

    ^{:line 3} [fmt "fmt"]])



(go/type Exn "Exn is an OCaml exception in flight: a Go panic with *Exn (survey §6.2.5: raise is a panic,\ntry a recover; the depth of the raising thread is restored by the handler).\n" (struct ^Value V))

^{:go/end 9} (go/method Error ^string [^{:tag (* Exn)} e] (+ "OCaml exception " (FormatException (.-V e))))



(go/type InternalError "InternalError is a failure of oi itself (an unimplemented external, a value of the wrong\nrepresentation): never an OCaml exception, it ends the run with status 125 (Run).\n" (struct ^string Msg))

^{:go/end 15} (go/method Error ^string [^{:tag (* InternalError)} e] (+ "oi: " (.-Msg e)))


^{:go/end 20} (go/func Internalf "Internalf panics with an InternalError.\n" [^string format & ^{:tag (slice any)} args]
  (panic (addr (lit InternalError :Msg (fmt/Sprintf format (spread args))))))



(go/type FatalError "FatalError is the runtime's own fatal error: Msg on stderr and the status Code, no at_exit.\n" (struct
    ^{:line 24 :tag string} Msg
    ^{:line 25 :tag int} Code))



(go/type ExitSignal "ExitSignal is sys_exit's panic: the run ends with Code (the at_exit functions ran in OCaml).\n" (struct ^int Code))


^{:go/end 32} (go/func Raise "Raise raises the OCaml exception v.\n" [^Value v] (panic (addr (lit Exn :V v))))



(go/var "The predefined exceptions (typing/predef.ml's order, runtime/caml/fail.h's indexes): blocks of\nObject_tag [name; id], their ids negative as the bytecode runtime's caml_global_data gives them.\n"
  ^{:line 37} [ExnOutOfMemory (predefExn "Out_of_memory" 0)]
  ^{:line 38} [ExnSysError (predefExn "Sys_error" 1)]
  ^{:line 39} [ExnFailure (predefExn "Failure" 2)]
  ^{:line 40} [ExnInvalidArgument (predefExn "Invalid_argument" 3)]
  ^{:line 41} [ExnEndOfFile (predefExn "End_of_file" 4)]
  ^{:line 42} [ExnDivisionByZero (predefExn "Division_by_zero" 5)]
  ^{:line 43} [ExnNotFound (predefExn "Not_found" 6)]
  ^{:line 44} [ExnMatchFailure (predefExn "Match_failure" 7)]
  ^{:line 45} [ExnStackOverflow (predefExn "Stack_overflow" 8)]
  ^{:line 46} [ExnSysBlockedIO (predefExn "Sys_blocked_io" 9)]
  ^{:line 47} [ExnAssertFailure (predefExn "Assert_failure" 10)]
  ^{:line 48} [ExnUndefinedRecursiveModule (predefExn "Undefined_recursive_module" 11)])



(go/var ^{:doc "Predefs are the predefined exceptions by name.\n"} Predefs (lit (map string (* Block))))

^{:go/end 58} (go/func predefExn ^{:tag (* Block)} [^string name ^int i]
  (let [b (addr (lit Block :Tag TagObject :F (lit (slice Value) (Str name) (- (- i) 1))))]
    (aset Predefs name b)
    ^{:line 57} b))



^{:go/end 61} (go/func Failwith "Failwith raises Failure msg.\n" [^string msg] (Raise (addr (lit Block :Tag 0 :F (lit (slice Value) ExnFailure (Str msg))))))


^{:go/end 64} (go/func InvalidArg "InvalidArg raises Invalid_argument msg.\n" [^string msg] (Raise (addr (lit Block :Tag 0 :F (lit (slice Value) ExnInvalidArgument (Str msg))))))


^{:go/end 67} (go/func RaiseSysError "RaiseSysError raises Sys_error msg.\n" [^string msg] (Raise (addr (lit Block :Tag 0 :F (lit (slice Value) ExnSysError (Str msg))))))


^{:go/end 70} (go/func RaiseNotFound "RaiseNotFound raises Not_found.\n" [] (Raise ExnNotFound))


^{:go/end 73} (go/func RaiseEndOfFile "RaiseEndOfFile raises End_of_file.\n" [] (Raise ExnEndOfFile))


^{:go/end 76} (go/func RaiseDivisionByZero "RaiseDivisionByZero raises Division_by_zero.\n" [] (Raise ExnDivisionByZero))


^{:go/end 79} (go/func RaiseStackOverflow "RaiseStackOverflow raises Stack_overflow.\n" [] (Raise ExnStackOverflow))


^{:go/end 82} (go/func RaiseOutOfMemory "RaiseOutOfMemory raises Out_of_memory.\n" [] (Raise ExnOutOfMemory))



^{:go/end 101} (go/func RaiseNamed "RaiseNamed raises the exception registered under name by Callback.register_exception (with\narg when it is not nil), as caml_raise_with_arg (caml_named_value) does.\n" [^string name ^Value arg]
  (let [(values v ok) (NamedValue name)]
    (when (not ok)
      ;; runtime/fiber.c's cache_named_exception: the message and exit(2), no at_exit
      (panic (addr (lit FatalError :Msg (+ "Fatal error: exception " name) :Code 2))))

    (when (== arg nil)
      (Raise v))

    ;; a registered exception value: its constructor is field 0 (with arguments) or itself
    (let [ctor v]
      (when [(values b ok) (assert (* Block) v)] (and ok (== (.-Tag b) 0))
        (set! ctor (aget (.-F b) 0)))

      (Raise (addr (lit Block :Tag 0 :F (lit (slice Value) ctor arg)))))))



^{:go/end 118} (go/func ExnName "ExnName is the constructor name of an exception value.\n" ^string [^Value v]
  ^{:go/breaks [[5 117]]} (let [(values b ok) (assert (* Block) v)]
    (when (not ok)
      (return "?"))

    (when (== (.-Tag b) 0)
      (when [(values c ok) (assert (* Block) (aget (.-F b) 0))] (and ok (== (.-Tag c) TagObject))
        (return (GoString (aget (.-F c) 0)))))


    (when (== (.-Tag b) TagObject)
      (return (GoString (aget (.-F b) 0))))

    "?"))





^{:go/end 161} (go/func FormatException "FormatException is runtime/printexc.c's caml_format_exception: the constructor's name, then\nits arguments in parentheses (integers, strings quoted, others as _), the sole tuple\nargument of Match_failure and Assert_failure (and of exceptions declared like them) spread.\n" ^string [^Value v]
  (let [(values b ok) (assert (* Block) v)]
    (when (not ok)
      (return "_"))

    (when (!= (.-Tag b) 0)
      (return (ExnName v)))

    (let [out (ExnName v)
        ^{:line 132 :tag (slice Value)} args (zero (slice Value))
        ^{:line 133} start 1]
      (when (== (len (.-F b)) 2)
        (when [(values t ok) (assert (* Block) (aget (.-F b) 1))] (and ok (== (.-Tag t) 0) (isTupleSpread (aget (.-F b) 0)))
          (set! args (.-F t))
          (set! start 0)))


      (when (== args nil)
        (set! args (subslice (.-F b) start)))

      (when (== (len args) 0)
        (return out))

      (set! out + "(")
      (range [i a args]
        (when (> i 0)
          (set! out + ", "))

        (type-switch [x a]
          (case [int]
            (set! out + (fmt/Sprint x)))
          (case [(* Bytes)]
            (set! out + (+ "\"" (conv string (.-B x)) "\"")))
          (default
            (set! out + "_"))))


      (+ out ")"))))




^{:go/end 167} (go/func isTupleSpread "isTupleSpread: printexc.c spreads the tuple argument of Match_failure and Assert_failure\n(caml_is_special_exception: those two and Undefined_recursive_module).\n" ^bool [^Value ctor]
  (or (== ctor (conv Value ExnMatchFailure)) (== ctor (conv Value ExnAssertFailure)) (== ctor (conv Value ExnUndefinedRecursiveModule))))

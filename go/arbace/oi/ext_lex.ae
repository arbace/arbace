^{:go/end 66} (go/func runMem "runMem is lexing.c's run_mem.\n" [^{:tag (slice byte)} code ^int pc ^{:tag (* Block)} mem ^Value currPos]
  (while true
    (let [dst (aget code pc)]
      (inc! pc)
      (when (== dst 0xff)
        (return))

      (let [src (aget code pc)]
        (inc! pc)
        (if (== src 0xff)
          (aset (.-F mem) dst currPos)

          (aset (.-F mem) dst (aget (.-F mem) src)))))))





^{:go/end 84} (go/func runTag "runTag is lexing.c's run_tag.\n" [^{:tag (slice byte)} code ^int pc ^{:tag (* Block)} mem]

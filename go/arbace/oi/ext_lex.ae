^{:go/end 240} (go/func tokenName ^string [^Value names ^int number]
  (let [b (.-B (AsBytes names))
      ^{:line 225} pos 0]
    (for [] (> number 0) (dec! number)
      (when (or (>= pos (len b)) (== (aget b pos) 0))
        (return "<unknown token>"))

      (while (and (< pos (len b)) (!= (aget b pos) 0))
        (inc! pos))

      (inc! pos))

    (let [end pos]
      (while (and (< end (len b)) (!= (aget b end) 0))
        (inc! end))

      (conv string (subslice b pos end)))))


^{:go/end 259} (go/func printToken [^{:tag (slice Value)} tbl ^int state ^Value tok]
  (if [(values b ok) (assert (* Block) tok)] ok (do
      (fmt/Fprintf os/Stderr "State %d: read token %s(" state (tokenName (aget tbl ptNamesBlock) (.-Tag b)))
      (type-switch [v (aget (.-F b) 0)]
        (case [int]
          (fmt/Fprintf os/Stderr "%d" v))
        (case [(* Bytes)]
          (fmt/Fprintf os/Stderr "%s" (conv string (.-B v))))
        (case [float64]
          (fmt/Fprintf os/Stderr "%g" v))
        (default
          (fmt/Fprint os/Stderr "_")))

      (fmt/Fprint os/Stderr ")\n"))

    (fmt/Fprintf os/Stderr "State %d: read token %s\n" state (tokenName (aget tbl ptNamesConst) (AsInt tok)))))




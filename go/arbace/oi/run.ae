            (return))

          (when [(values _ ok) (assert (* Exn) r)] ok
            (return))

          (when [(values e ok) (assert (* ExitSignal) r)] ok
            (set! status (.-Code e))
            (return))

          (panic r)))))


  (when [(values h ok) (NamedValue "Printexc.handle_uncaught_exception")] ok
    (.Apply th h exn 0)
    (return 2))

  ^{:go/breaks [5]} (let [msg (FormatException exn)]
    (when [(values f ok) (NamedValue "Pervasives.do_at_exit")] ok
      (^{:go/end 191} (fn []
          (defer (^{:go/end 189} (fn [] (recover))))
          (.Apply th f Unit))))


    (when (== stderr nil)
      (set! stderr os/Stderr))

    (fmt/Fprintf stderr "Fatal error: exception %s\n" msg)
    2))

;; Package oi is oi, Arbace's interpreter of OCaml's Lambda (doc/ocaml/OCAML-SURVEY.md, O5; OC5 (a)):
;; the values of OCaml's runtime as Go values, the Lambda of a unit compiled into closures over
;; frames, the primitives of Lambda and the runtime's externals (the C part of OCaml's runtime, in
;; Go), exceptions as Go panics, proper tail calls by a trampoline in the call, effects as
;; goroutines with a channel hand-off (OC6 (a)), and the toplevel's value printing (OC12 (a)).
;; Its input is the Lambda dumps of tools/ocdump as forms (doc/ocaml/SPEC.md §11.2).
(in-ns 'go.arbace.oi) (go/file "value.go" :doc "Package oi is oi, Arbace's interpreter of OCaml's Lambda (doc/ocaml/OCAML-SURVEY.md, O5; OC5 (a)):\nthe values of OCaml's runtime as Go values, the Lambda of a unit compiled into closures over\nframes, the primitives of Lambda and the runtime's externals (the C part of OCaml's runtime, in\nGo), exceptions as Go panics, proper tail calls by a trampoline in the call, effects as\ngoroutines with a channel hand-off (OC6 (a)), and the toplevel's value printing (OC12 (a)).\nIts input is the Lambda dumps of tools/ocdump as forms (doc/ocaml/SPEC.md §11.2).\n" :imports [


    ^{:line 10} [math "math"]
    ^{:line 11} [strconv "strconv"]])













(go/type ^:alias Value "Value is an OCaml value. Its dynamic type is one of:\n\n\tint          an immediate: int, char, bool, unit, a constant constructor (63-bit, Int)\n\tfloat64      a boxed float (Double_tag)\n\t*Bytes       a string or bytes (String_tag; strings are bytes never written)\n\t*Block       a block of fields with a tag (0-245, Lazy, Forward, Object, Infix ...)\n\t*FloatArray  a flat float array or a record of floats (Double_array_tag)\n\tint32, int64, Nativeint  the boxed integers (Custom_tag)\n\t*Closure     a function (Closure_tag)\n\t*Custom      another custom block (channels, mutexes, ...), compared by identity\n\t*Fiber       a stack of effects (Cont_tag's stack; OC6 (a))\n" any)


(go/type Nativeint "Nativeint is OCaml's nativeint (64 bits on amd64), distinct from int64.\n" int64)


(go/type Bytes "Bytes is an OCaml string or bytes value.\n" (struct ^{:tag (slice byte)} B))


(go/type Block "Block is a block: a tag and its fields.\n" (struct
    ^{:line 35 :tag int} Tag
    ^{:line 36 :tag (slice Value)} F))



(go/type FloatArray "FloatArray is a flat array of floats (tag 254).\n" (struct ^{:tag (slice float64)} F))



(go/type Custom "Custom is a custom block that is neither a boxed integer nor a float: Name the custom\noperations' identifier (as caml_custom_ops' identifier: \"_chan\", \"_mutex\", ...), V its Go state.\n" (struct
    ^{:line 45 :tag string} Name
    ^{:line 46 :tag any} V))




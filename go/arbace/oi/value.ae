^{:go/end 157} (go/func List "List is the OCaml list of vs.\n" ^Value [& ^{:tag (slice Value)} vs]
  (let [^Value l 0]
    (for [i (- (len vs) 1)] (>= i 0) (dec! i)
      (set! l (addr (lit Block :Tag 0 :F (lit (slice Value) (aget vs i) l)))))


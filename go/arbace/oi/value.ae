^{:go/end 180} (go/func Tag "Tag is the tag of v as Obj.tag gives it.\n" ^int [^Value v]
  (type-switch [x v]
    (case [int]
      (return TagInt))
    (case [float64]
      (return TagDouble))
    (case [(* Bytes)]
      (return TagString))
    (case [(* Block)]
      (return (.-Tag x)))
    (case [(* FloatArray)]
      (return TagDoubleArray))
    (case [(* Closure)]
      (return TagClosure))
    (case [int32 int64 Nativeint (* Custom)]
      (return TagCustom))
    (case [(* Fiber)]
      (return TagCont)))

  ^{:line 179} TagOutOfHeap)



^{:go/breaks [[5 200]] :go/end 201} (go/func Size "Size is the number of fields (words) of a block as Obj.size gives it.\n" ^int [^Value v]
  (type-switch [x v]
    (case [(* Block)]
      (return (len (.-F x))))
    (case [(* FloatArray)]
      (return (len (.-F x))))
    (case [(* Bytes)]
      (return (/ (+ (len (.-B x)) 8) 8)))
    (case [float64]
      (return 1))
    (case [int32 int64 Nativeint]
      (return 2))
    (case [(* Closure)]
      (return (+ 2 (len (.-Env x)))))
    (case [(* Custom)]
      (return 2)))

  0)



^{:go/breaks [[5 234]] :go/end 235} (go/func Describe "Describe is a short text of v for internal errors and traces.\n" ^string [^Value v]
  (type-switch [x v]
    (case [nil]
      (return "<nil>"))
    (case [int]
      (return (strconv/Itoa x)))
    (case [float64]
      (return (strconv/FormatFloat x \g -1 64)))
    (case [(* Bytes)]
      (when (> (len (.-B x)) 40)
        (return (+ (strconv/Quote (conv string (subslice (.-B x) _ 40))) "...")))

      (return (strconv/Quote (conv string (.-B x)))))
    (case [(* Block)]
      (return (+ "<block " (strconv/Itoa (.-Tag x)) "/" (strconv/Itoa (len (.-F x))) ">")))
    (case [(* FloatArray)]
      (return (+ "<floatarray " (strconv/Itoa (len (.-F x))) ">")))
    (case [(* Closure)]
      (return (+ "<closure " (.Name x) ">")))
    (case [int32]
      (return (+ (strconv/Itoa (conv int x)) "l")))
    (case [int64]
      (return (+ (strconv/FormatInt x 10) "L")))
    (case [Nativeint]
      (return (+ (strconv/FormatInt (conv int64 x) 10) "n")))
    (case [(* Custom)]
      (return (+ "<custom " (.-Name x) ">")))
    (case [(* Fiber)]
      (return "<stack>")))

  "<?>")





^{:go/end 248} (go/func PhysEqual "PhysEqual is OCaml's == on two values: identity of blocks, equality of immediates; boxed\nnumbers are equal when their bits are (a divergence by design: OCaml compares their\naddresses, OC11).\n" ^bool [^Value a ^Value b]
  (when [(values fa ok) (assert float64 a)] ok
    (when [(values fb ok) (assert float64 b)] ok
      (return (== (math/Float64bits fa) (math/Float64bits fb))))

    (return false))

  (== a b))





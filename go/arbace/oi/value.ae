^{:go/breaks [[5 93]] :go/end 94} (go/func Truth "Truth is v as a condition: everything but the immediate 0 is true (a block is true, as\nLambda's ifthenelse on a list tests it).\n" ^bool [^Value v]
  (when [(values i ok) (assert int v)] ok
    (return (!= i 0)))


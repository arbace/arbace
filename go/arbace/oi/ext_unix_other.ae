;; oi's Unix library where syscall has none of Linux's calls below (TamaGo's box; ext_unix_linux.ae elsewhere): each call fails
;; with ENOSYS, as OCaml's Unix raises Unix_error (ENOSYS, ...) for a function the platform lacks; the flags and options keep
;; Linux's numbers (no call here takes them), the flags open(2) lacks here are none; stat(2)'s times are Stat_t's flat fields.
(in-ns 'go.arbace.oi)

(go/file "ext_unix_other.go"
  :build ["//go:build !linux"]
  :imports [[syscall "syscall"] [unsafe "unsafe"]])

(go/const [^{:val 28} sigWinch 28] [^{:val 23} sigUrg 23] [^{:val 18} sigCont 18] [^{:val 14} sigAlrm 14])

(go/const [^{:val 1} wNohang 1] [^{:val 2} wUntraced 2] [^{:val 1} fdCloexec 1]
  [^{:val 0} oNoctty 0] [^{:val 0} oDsync 0] [^{:val 0} oRsync 0])

(go/const [^{:val 1} msgOob 1] [^{:val 4} msgDontroute 4] [^{:val 2} msgPeek 2]
  [^{:val 1} soDebug 1] [^{:val 5} soDontroute 5] [^{:val 10} soOobinline 10]
  [^{:val 30} soAcceptconn 30] [^{:val 18} soRcvlowat 18] [^{:val 19} soSndlowat 19]
  [^{:val 20} soRcvtimeo 20] [^{:val 21} soSndtimeo 21] [^{:val 0} sockCloexec 0])

(go/func sysMmap "sysMmap fails: no mmap(2) here.\n" [^int fd ^int64 off ^int n ^bool shared] :results [(slice byte) error]
  (return nil syscall/ENOSYS))

(go/func ppoll "ppoll fails: no ppoll(2) here.\n" [^{:tag (slice pollFd)} fds ^float64 timeout] :results [int syscall/Errno]
  (return -1 syscall/ENOSYS))

(go/func sysPipe2 ^error [^{:tag (slice int)} p ^int flags]
  syscall/ENOSYS)

(go/func sysAccess ^error [^string p ^uint32 mode]
  syscall/ENOSYS)

(go/func sysItimer "sysItimer fails: no itimers here.\n" ^syscall/Errno [^bool set ^int which ^{:tag (* itimerval)} nv ^{:tag (* itimerval)} ov]
  syscall/ENOSYS)

(go/func sysForkExec [^string path ^{:tag (slice string)} args ^{:tag (* syscall/ProcAttr)} attr] :results [int error]
  (return 0 syscall/ENOSYS))

(go/func sysExec ^error [^string path ^{:tag (slice string)} args ^{:tag (slice string)} env]
  syscall/ENOSYS)

(go/func sysSetsid [] :results [int error]
  (return 0 syscall/ENOSYS))

(go/func sysGetpriority [] :results [int error]
  (return 0 syscall/ENOSYS))

(go/func sysSetpriority ^error [^int n]
  syscall/ENOSYS)

(go/func sysUmask "sysUmask is 0: no file mode creation mask here.\n" ^int [^int mask]
  0)

(go/func rusageTimes "rusageTimes is 0: no process time here.\n" [^int who] :results [float64 float64]
  (return 0 0))

(go/func statTime "statTime is st's access (0), modification (1) or change (2) time in seconds since the epoch.\n" ^float64 [^{:tag (* syscall/Stat_t)} st ^int i]
  (switch i
    (case [0] (return (+ (conv float64 (.-Atime st)) (/ (conv float64 (.-AtimeNsec st)) 1e9))))
    (case [1] (return (+ (conv float64 (.-Mtime st)) (/ (conv float64 (.-MtimeNsec st)) 1e9)))))
  (+ (conv float64 (.-Ctime st)) (/ (conv float64 (.-CtimeNsec st)) 1e9)))

(go/func sysDup3 ^error [^int src ^int dst ^int flags]
  syscall/ENOSYS)

(go/func sysMkfifo ^error [^string p ^uint32 mode]
  syscall/ENOSYS)

(go/func sysAccept4 [^int fd ^int flags] :results [int syscall/Sockaddr error]
  (return -1 nil syscall/ENOSYS))

(go/func getsockoptRaw "getsockoptRaw fails: no getsockopt(2) here.\n" ^syscall/Errno [^int fd ^int lvl ^int opt ^unsafe/Pointer p ^uintptr size]
  syscall/ENOSYS)

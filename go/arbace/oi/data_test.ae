^{:go/end 128} (go/func TestHashGolden [^{:tag (* testing/T)} t]
  (let [g (golden t)
      ^{:line 75} cases (commonCases)
      ^{:line 76} deep (make (slice Value) 100)]
    (range [i deep]
      (aset deep i (Tuple i (Str (strconv/Itoa i)))))

    (range [k v (lit (map string Value)
          ^{:line 81} ["str7" (Str "abcdefg")] ["str4" (Str "abcd")] ["f0" 0.0] ["fm0" (math/Copysign 0 -1)] ["nan" (math/NaN)] ["f15" 1.5]
          ^{:line 82} ["farr" (addr (lit FloatArray :F (lit (slice float64) 1 2 3)))] ["i64big" (conv int64 0x123456789abcdef)] ["i32neg" (conv int32 -7)]
          ^{:line 83} ["unit" 0] ["true" 1] ["char" (conv int \a)] ["nested" (List (List 1 2) (List 3) 0)] ["deep" (List (spread deep))])]

      (aset cases k v))

    (let [n 0]
      (range [k v cases]
        (let [(values want ok) (aget g (+ "hash_" k))]
          (when (not ok)
            (continue))

          (inc! n)
          (when [got (strconv/Itoa (Hash 10 100 0 v))] (!= got want)
            ^{:go/via [common]} (.Errorf t "hash %s: got %s want %s" k got want))))


      (let [want 0]
        (range [k g]
          (when (strings/HasPrefix k "hash_")
            (inc! want)))


        (when (!= n want)
          ^{:go/via [common]} (.Errorf t "%d hash cases checked of %d" n want))

        ;; nan with another payload hashes alike
        (when (!= (Hash 10 100 0 (math/Float64frombits 0x7FF8000000001234)) (Hash 10 100 0 (math/NaN)))
          ^{:go/via [common]} (.Error t "NaNs differ"))

        (let [chk ^{:go/end 115} (fn [^string name ^int got]
              (when (!= (strconv/Itoa got) (aget g name))
                ^{:go/via [common]} (.Errorf t "%s: got %d want %s" name got (aget g name))))]


          (chk "seeded_x" (StringHash 17 (conv (slice byte) "x")))
          (chk "seeded_int" (Hash 10 100 99 12345))
          (chk "param_10_100_list" (Hash 10 100 0 (intList 30)))
          (chk "param_3_5_tuple" (Hash 3 5 0 (Tuple 1 (pair 2 3) (Tuple 4 (pair 5 6)) 7)))
          (chk "param_0" (Hash 0 100 0 5))
          (chk "param_1_1" (Hash 1 1 0 (intList 2)))
          (chk "param_5_0" (Hash 5 0 0 (intList 2)))
          (chk "param_100_300" (Hash 100 300 0 (intList 400)))
          (chk "strhash" (StringHash 0 (conv (slice byte) "hello world, long string here!")))
          ;; the externals
          (chk "seeded_x" (assert int ((aget Externals "caml_string_hash") nil (lit (slice Value) 17 (Str "x")))))
          (chk "param_3_5_tuple" (assert int ((aget Externals "caml_hash") nil (lit (slice Value) 3 5 0 (Tuple 1 (pair 2 3) (Tuple 4 (pair 5 6)) 7))))))))))



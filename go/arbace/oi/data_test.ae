            (lit _ 7 (conv int64 1) -1 false true)
            (lit _ (conv int64 1) 7 1 false false)
            (lit _ (addr (lit FloatArray :F (lit (slice float64) 1 2))) (addr (lit FloatArray :F (lit (slice float64) 1 3))) -1 false true)
            (lit _ (addr (lit FloatArray :F (lit (slice float64) 1 nan))) (addr (lit FloatArray :F (lit (slice float64) 1 nan))) 0 false false)
            (lit _ (Tuple nan) (Tuple 1.0) -1 false false)

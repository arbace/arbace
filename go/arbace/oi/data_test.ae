            (lit _ (Tuple 1) (Tuple 1 2) -1 false true)
            (lit _ (addr (lit Block :Tag 0 :F (lit (slice Value) 5))) (addr (lit Block :Tag 1 :F (lit (slice Value) 1))) -1 false true)
            (lit _ (List 1 2 3) (List 1 2) 1 false false)

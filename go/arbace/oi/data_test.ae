^{:go/end 304} (go/func TestUnmarshalRoundTrip [^{:tag (* testing/T)} t]
  (let [g (golden t)
      ^{:line 255} n 0]
    (range [k v (marshalCases)]
      (let [(values want ok) (aget g (+ "m_" k))]
        (when (or (not ok) (== k "cyc") (== k "fnan"))
          (continue))

        (inc! n)
        (let [(values raw _) (hex/DecodeString want)
            (values got used) (UnmarshalValue raw 0)]
          (when (!= used (len raw))
            ^{:go/via [common]} (.Errorf t "%s: consumed %d of %d" k used (len raw)))

          (when (not (equalValues got v))
            ^{:go/via [common]} (.Errorf t "%s: unmarshalled %s differs from %s" k (Describe got) (Describe v)))

          ;; marshalling again gives the bytes back (sharing included)
          (when [again (hex/EncodeToString (MarshalValue got 0))] (and (!= again want) (!= k "ni_neg"))
            ^{:go/via [common]} (.Errorf t "%s: re-marshal differs:\n got %.120s\nwant %.120s" k again want)))))


    (when (< n 50)
      ^{:go/via [common]} (.Errorf t "only %d round trips" n))

    ;; offsets and data size
    (let [raw (MarshalValue (List 1 2 3) 0)
        ^{:line 280} buf (append (conv (slice byte) "xxx") (spread raw))]
      (set! buf (append buf (spread "trailing")))
      (let [(values v used) (UnmarshalValue buf 3)]
        (when (or (!= used (len raw)) (not (equalValues v (List 1 2 3))))
          ^{:go/via [common]} (.Errorf t "offset read: %d %v" used (Describe v)))

        (let [size (assert int ((aget Externals "caml_marshal_data_size") nil (lit (slice Value) (addr (lit Bytes :B buf)) 3)))]
          (when (!= size (- (len raw) 16))
            ^{:go/via [common]} (.Errorf t "data_size %d want %d" size (- (len raw) 16)))

          ;; sharing preserved
          (let [(values sh _) (UnmarshalValue (MarshalValue (Tuple (Str "a") (Str "a")) 0) 0)]
            (when (== (aget (.-F (assert (* Block) sh)) 0) (aget (.-F (assert (* Block) sh)) 1))
              ^{:go/via [common]} (.Error t "distinct strings became shared"))

            (let [s (Str "z")]
              (set! (values sh _) (UnmarshalValue (MarshalValue (Tuple s s) 0) 0))
              (when (!= (aget (.-F (assert (* Block) sh)) 0) (aget (.-F (assert (* Block) sh)) 1))
                ^{:go/via [common]} (.Error t "shared string lost sharing"))

              (let [(values cyc _) (UnmarshalValue (MarshalValue (aget (marshalCases) "cyc") 0) 0)]
                (when (!= (aget (.-F (assert (* Block) (aget (.-F (assert (* Block) cyc)) 1))) 1) cyc)
                  ^{:go/via [common]} (.Error t "cycle lost"))))))))))




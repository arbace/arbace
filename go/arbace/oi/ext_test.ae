^{:go/end 131} (go/func TestChannelBuffering [^{:tag (* testing/T)} t]
  (let [p (filepath/Join ^{:go/via [common]} (.TempDir t) "f")
      ^{:line 80} ch (openOut t p)]
    (outStr ch "hello\nworld\n")
    (when [n (fileSize t p)] (!= n 0)
      ^{:go/via [common]} (.Fatalf t "data reached the file before the flush: %d" n))

    (sysxCall "caml_ml_output_int" ch 0x01020304)
    (sysxCall "caml_ml_output_char" ch (conv int \x))
    (when [pos (sysxCall "caml_ml_pos_out" ch)] (!= pos 17)
      ^{:go/via [common]} (.Fatalf t "pos_out %v" pos))

    (sysxCall "caml_ml_flush" ch)
    (when [n (fileSize t p)] (!= n 17)
      ^{:go/via [common]} (.Fatalf t "flushed size %d" n))

    (sysxCall "caml_ml_close_channel" ch)
    (sysxCall "caml_ml_flush" ch) ; a closed channel flushes quietly
    (when [s (sysErrorText t ^{:go/end 96} (fn [] (outStr ch "a")))] (!= s "Bad file descriptor")
      ^{:go/via [common]} (.Fatalf t "write to closed channel: %q" s))

    (sysxCall "caml_ml_close_channel" ch) ; idempotent

    ;; a big write: whole buffers go out, the rest stays
    (set! ch (openOut t p))
    (outStr ch (strings/Repeat "a" 200000))
    (when [n (fileSize t p)] (!= n (* 3 IOBufferSize))
      ^{:go/via [common]} (.Fatalf t "size after a big write %d" n))

    (sysxCall "caml_ml_set_buffered" ch 0)
    (when [n (fileSize t p)] (!= n 200000)
      ^{:go/via [common]} (.Fatalf t "size after set_buffered false %d" n))

    (when (!= (sysxCall "caml_ml_is_buffered" ch) (conv Value 0))
      ^{:go/via [common]} (.Fatal t "is_buffered"))

    (outStr ch "zz")
    (when [n (fileSize t p)] (!= n 200002)
      ^{:go/via [common]} (.Fatalf t "unbuffered write %d" n))

    (when [got (sysxCall "caml_ml_channel_size" ch)] (!= got 200002)
      ^{:go/via [common]} (.Fatalf t "channel_size %v" got))

    (when [got (sysxCall "caml_ml_pos_out_64" ch)] (!= got (conv int64 200002))
      ^{:go/via [common]} (.Fatalf t "pos_out_64 %v" got))

    (sysxCall "caml_ml_seek_out" ch 5)
    (outStr ch "B")
    (sysxCall "caml_ml_close_channel" ch)
    (let [(values data _) (os/ReadFile p)]
      (when (or (!= (aget data 5) \B) (!= (aget data 4) \a) (!= (len data) 200002))
        ^{:go/via [common]} (.Fatal t "seek_out")))))



^{:go/end 201} (go/func TestChannelInput [^{:tag (* testing/T)} t]
  (let [p (filepath/Join ^{:go/via [common]} (.TempDir t) "f")]
    (os/WriteFile p (conv (slice byte) (byte-string "hello\nworld\n\u0001\u0002\u0003\u0004" 0xff "xtail")) 0644)
    (let [ch (openIn t p)]
      (when [n (sysxCall "caml_ml_input_scan_line" ch)] (!= n 6)
        ^{:go/via [common]} (.Fatalf t "scan_line %v" n))

      (let [buf (addr (lit Bytes :B (make (slice byte) 10)))]
        (when [n (sysxCall "caml_ml_input" ch buf 2 6)] (or (!= n 6) (!= (conv string (subslice (.-B buf) 2 8)) "hello\n"))
          ^{:go/via [common]} (.Fatalf t "input %v %q" n (.-B buf)))

        (when [n (sysxCall "caml_ml_input_scan_line" ch)] (!= n 6)
          ^{:go/via [common]} (.Fatalf t "scan_line 2 %v" n))

        (sysxCall "caml_ml_input" ch buf 0 6)
        (when [v (sysxCall "caml_ml_input_int" ch)] (!= v 0x01020304)
          ^{:go/via [common]} (.Fatalf t "input_int %v" v))

        (when [v (sysxCall "caml_ml_input_char" ch)] (!= v 0xff)
          ^{:go/via [common]} (.Fatalf t "input_char %v" v))

        (when [pos (sysxCall "caml_ml_pos_in" ch)] (!= pos 17)
          ^{:go/via [common]} (.Fatalf t "pos_in %v" pos))

        (when [n (sysxCall "caml_ml_input_scan_line" ch)] (!= n -5)
          ^{:go/via [common]} (.Fatalf t "partial line %v" n))

        (sysxCall "caml_ml_seek_in" ch 2)
        (when [v (sysxCall "caml_ml_input_char" ch)] (!= v (conv int \l))
          ^{:go/via [common]} (.Fatalf t "after seek %v" v))

        (sysxCall "caml_ml_seek_in_64" ch (conv int64 17))
        (when [v (sysxCall "caml_ml_input_char" ch)] (!= v (conv int \x))
          ^{:go/via [common]} (.Fatalf t "after seek 64 %v" v))

        (when [v (sysxCall "caml_ml_channel_size_64" ch)] (!= v (conv int64 22))
          ^{:go/via [common]} (.Fatalf t "size %v" v))

        (when [n (sysxCall "caml_ml_pos_in" ch)] (!= n 18)
          ^{:go/via [common]} (.Fatalf t "pos after size %v" n))

        (let [c (ChannelOf ch)]
          (when [e (exnOf ^{:go/end 175} (fn [] (.ReadFull c 100)))] (!= e (conv Value ExnEndOfFile))
            ^{:go/via [common]} (.Fatalf t "ReadFull past the end: %v" e))

          (when [e (exnOf ^{:go/end 178} (fn [] (sysxCall "caml_ml_input_char" ch)))] (!= e (conv Value ExnEndOfFile))
            ^{:go/via [common]} (.Fatalf t "input_char at the end: %v" e))

          (when [n (sysxCall "caml_ml_input" ch buf 0 3)] (!= n 0)
            ^{:go/via [common]} (.Fatalf t "input at the end %v" n))

          (sysxCall "caml_ml_seek_in" ch 0)
          (when [got (conv string (.ReadFull c 5))] (!= got "hello")
            ^{:go/via [common]} (.Fatalf t "ReadFull %q" got))

          ;; md5 of a number of bytes and of the rest
          (let [sum (md5/Sum (conv (slice byte) "\nworl"))]
            (when [got (.-B (assert (* Bytes) (sysxCall "caml_md5_chan" ch 5)))] (!= (conv string got) (conv string (subslice sum)))
              ^{:go/via [common]} (.Fatal t "md5_chan 5"))

            (let [rest (md5/Sum (conv (slice byte) (byte-string "d\n\u0001\u0002\u0003\u0004" 0xff "xtail")))]
              (when [got (.-B (assert (* Bytes) (sysxCall "caml_md5_chan" ch -1)))] (!= (conv string got) (conv string (subslice rest)))
                ^{:go/via [common]} (.Fatal t "md5_chan -1"))

              (sysxCall "caml_ml_close_channel" ch)
              (when [s (sysErrorText t ^{:go/end 198} (fn [] (sysxCall "caml_ml_input_char" ch)))] (!= s "Bad file descriptor")
                ^{:go/via [common]} (.Fatalf t "read on closed channel: %q" s)))))))))



^{:go/end 229} (go/func TestOutChannelsList [^{:tag (* testing/T)} t]
  (let [d ^{:go/via [common]} (.TempDir t)
      ^{:line 205} c1 (openOut t (filepath/Join d "1"))
      ^{:line 206} c2 (openOut t (filepath/Join d "2"))
      ^{:line 207} c3 (openOut t (filepath/Join d "3"))
      ^{:line 208} in (openIn t (filepath/Join d "1"))]

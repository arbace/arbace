^{:go/end 444} (go/func TestDigests [^{:tag (* testing/T)} t]
  (when [got (hex/EncodeToString (.-B (assert (* Bytes) (sysxCall "caml_md5_string" (Str "xhelloy") 1 5))))] (!= got "5d41402abc4b2a76b9719d911017c592")
    ^{:go/via [common]} (.Fatalf t "md5 %s" got))

  (let [b2 ^{:go/end 425} (fn ^string [^int n ^string key ^string s]
        (hex/EncodeToString (.-B (assert (* Bytes) (sysxCall "caml_blake2_string" n (Str key) (Str s) 0 (len s))))))]

    (when [got (b2 64 "" "hello")] (!= got "e4cfa39a3d37be31c59609e807970799caa68a19bfaa15135f165085e01d41a65ba1e1b146aeb6bd0092b49eac214c103ccfa3a365954bbbe52f74a2b3620c94")
      ^{:go/via [common]} (.Fatalf t "blake512 %s" got))

    (when [got (b2 32 "" (strings/Repeat "x" 300))] (!= got "5aa7fbbf37986bb2a5d547c0d3c4d4326a24d786e7d57bf93fc784176e38b33d")
      ^{:go/via [common]} (.Fatalf t "blake256 %s" got))


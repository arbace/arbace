    (let [l (listToSlice (sysxCall "caml_ml_out_channels_list"))
        ^{:line 211} pos (lit (map Value int))]
      (range [i v l]
        (aset pos v i))

      (when [(values _ ok) (aget pos c2)] ok
        ^{:go/via [common]} (.Fatal t "closed channel listed"))

      (when [(values _ ok) (aget pos in)] ok
        ^{:go/via [common]} (.Fatal t "input channel listed"))

      (when (not (< (aget pos c3) (aget pos c1)))
        ^{:go/via [common]} (.Fatalf t "not newest first: %v %v" (aget pos c3) (aget pos c1)))

      (outStr c3 "pending")
      (FlushStd)
      (when (!= (fileSize t (filepath/Join d "3")) 7)
        ^{:go/via [common]} (.Fatal t "FlushStd")))))




      ^{:go/via [common]} (.Fatalf t "blake128 %s" got))

    ;; incremental updates give the same digest
    (let [s (strings/Repeat "x" 300)
        ^{:line 437} ctx (sysxCall "caml_blake2_create" 32 (Str ""))]

;; oi's system interface where syscall has no getrusage(2), ioctl or O_NONBLOCK (TamaGo's box; OC170, doc/ocaml/OCAML-SURVEY.md,
;; "As built: the embedding's gaps"): Linux's numbers, no process time, no terminal (ext_sys_linux.ae elsewhere).
(in-ns 'go.arbace.oi)

(go/file "ext_sys_other.go"
  :build ["//go:build !linux"])

;; Linux's O_NONBLOCK (Open_nonblock; no file here takes it), getrusage(2)'s whos (no getrusage here), Linux's SIGSTOP number
(go/const [^{:val 2048} oNonblock 0x800] [^{:val 0} rusageSelf 0] [^{:val -1} rusageChildren -1] [^{:val 19} sigStop 19])

(go/func rusageSeconds "rusageSeconds is 0: no process time here.\n" ^float64 [^int who]
  0)

(go/func isatty "isatty is false: no terminal here.\n" ^bool [^int fd]
  false)

^{:go/end 1112} (go/func checkParse [^{:tag (* testing/T)} t ^string name ^{:tag (slice pcase)} cases ^{:tag (func [Value] [string])} show]
  (range [_ c cases]
    (let [^Value res (zero Value)
        ^{:line 1099} msg (failure ^{:go/end 1099} (fn [] (set! res (call name (Str (.-s c))))))]
      (when (== (.-status c) "fail")
        (when (!= msg (.-want c))
          ^{:go/via [common]} (.Errorf t "%s %q: failure %q, want %q" name (.-s c) msg (.-want c)))

        (continue))

      (if (!= msg "")
        ^{:go/via [common]} (.Errorf t "%s %q: unexpected Failure %q, want %s" name (.-s c) msg (.-want c))
        (when [got (show res)] (!= got (.-want c))
          ^{:go/via [common]} (.Errorf t "%s %q = %s, want %s" name (.-s c) got (.-want c)))))))





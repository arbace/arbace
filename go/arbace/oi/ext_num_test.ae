^{:go/end 567} (go/func TestFormatFloat [^{:tag (* testing/T)} t]
  (range [_ c floatFormats]
    (let [got (GoString (call "caml_format_float" (Str (.-fmt c)) (math/Float64frombits (.-bits c))))]
      (when (!= got (.-want c))
        ^{:go/via [common]} (.Errorf t "format_float %q %x = %q, want %q" (.-fmt c) (.-bits c) got (.-want c))))))





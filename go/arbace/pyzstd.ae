(ns go.arbace.pyzstd
  (:require [arbace.go :as go]))

(go/package pyzstd
  :path "arbace/pyzstd"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["pyzstd.go"]
  :init-order [zstdDictType zstdCompressorType zstdDecompressorType BUFFER_BLOCK_SIZE cp_list dp_list]
  :positions :full)

(load "pyzstd/pyzstd")

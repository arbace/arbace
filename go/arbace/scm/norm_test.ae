;; normalization's tests (SM6): string-normalize-nfd/nfc/nfkd/nfkc (nmNormalize).
;; TestNormalizationUAX15 (SCS37 (a), the user 2026-11-18; queue 366): against UAX #15's own conformance data, NormalizationTest.txt of
;; UCD 16.0.0 (pinned by test/scheme/ucd.edn; bin/si unit names it by SI_UCD_DIR, the main checkout's .tmp/scheme/ucd-16.0.0): every line
;;   c1;c2;c3;c4;c5; # comment       source; NFC; NFD; NFKC; NFKD (each one or more code points, hex)
;; of Parts 0 to 5 by the file's 20 invariants (NFC: c2 of c1, c2, c3 and c4 of c4, c5; NFD: c3 of c1, c2, c3 and c5 of c4, c5; NFKC: c4
;; of all five; NFKD: c5 of all five), and its Part 1 rule: every code point assigned in UCD 16.0.0 (Category, unicode.ae: not Cn) that
;; Part 1 does not list is its own NFC, NFD, NFKC and NFKD. Data only: nothing in the file is run. Its negative control is bin/si unit
;; --control's (one normdata.ae entry changed must make a known number of checks differ).
;; TestNormalizeChez, the oracle tier's since SCS37 (a), by hand (SI_NORM_ORACLE=1 bin/si unit -run TestNormalizeChez): against Chez
;; Scheme 10.3.0's recorded results (test/scheme/si/norm-chez.tsv, made by tools/scheme/normtests.ss; the format is in its header):
;; every scalar value as a one-character string in blocks of 1024 (the hash of the four forms), and 3500 random strings.
(in-ns 'go.arbace.scm)

(go/file "norm_test.go" :imports [[testing "testing"] [os "os"] [strings "strings"] [strconv "strconv"]])

(go/func nmtHash ^uint32 [^uint32 h ^{:tag (slice rune)} rs]
  (range [_ r rs]
    (set! h (+ (* h 31) (conv uint32 r))))
  h)

(go/func nmtHex ^string [^uint32 h]
  (let [s (strings/ToUpper (strconv/FormatUint (conv uint64 h) 16))]
    (+ (strings/Repeat "0" (- 8 (len s))) s)))

(go/func nmtSurrogate ^bool [^int n] (and (>= n 0xD800) (<= n 0xDFFF)))

(go/func nmtRunes ^{:tag (slice rune)} [^{:tag (* testing/T)} t ^int ln ^string col]
  (let [^{:tag (slice rune)} rs nil]
    (range [_ h (strings/Fields col)]
      (let [(values v e) (strconv/ParseUint h 16 32)]
        (when (!= e nil)
          (.Fatalf t "NormalizationTest.txt line %d: %q is no code point" ln h))
        (set! rs (append rs (conv rune v)))))
    rs))

(go/func nmtEq ^bool [^{:tag (slice rune)} a ^{:tag (slice rune)} b]
  (when (!= (len a) (len b))
    (return false))
  (range [i r a]
    (when (!= r (aget b i))
      (return false)))
  true)

(go/func nmtForm ^string [^int k] (aget (lit (slice string) "NFD" "NFC" "NFKD" "NFKC") k))

(go/func TestNormalizationUAX15 [^{:tag (* testing/T)} t]
  (let [dir (os/Getenv "SI_UCD_DIR")]
    (when (== dir "")
      (.Skip t "SI_UCD_DIR unset: the test needs the pinned UCD (bin/si unit sets it)")
      (return))
    (let [(values data err) (os/ReadFile (+ dir "/NormalizationTest.txt"))]
      (when (!= err nil)
        (.Fatalf t "NormalizationTest.txt: %v (bin/repr-scheme ucd fetch)" err))
      (when (not (strings/HasPrefix (conv string data) "# NormalizationTest-16.0.0.txt"))
        (.Fatalf t "NormalizationTest.txt: not UCD 16.0.0's"))
      (let [lines 0
            checks 0
            bad 0
            part ""
            listed (make (map rune bool))]
        (range [ln line (strings/Split (conv string data) "\n")]
          (let [body line
                h (strings/Index line "#")]
            (when (>= h 0)
              (set! body (subslice line 0 h)))
            (set! body (strings/TrimSpace body))
            (cond
              (== body "")
              (continue)
              (strings/HasPrefix body "@")
              (set! part body)
              :else
              (let [cols (strings/Split body ";")]
                (when (< (len cols) 5)
                  (.Fatalf t "NormalizationTest.txt line %d: %d columns" (+ ln 1) (len cols)))
                (let [c (make (slice (slice rune)) 5)]
                  (for [k 0] (< k 5) (inc! k)
                    (aset c k (nmtRunes t (+ ln 1) (aget cols k))))
                  (when (and (== part "@Part1") (== (len (aget c 0)) 1))
                    (aset listed (aget (aget c 0) 0) true))
                  (inc! lines)
                  ;; the invariants: [form (k: 0 NFD, 1 NFC, 2 NFKD, 3 NFKC), the column it must give, the columns it is applied to]
                  (range [_ inv (lit (slice (slice int)) (lit (slice int) 1 1 0 1 2) (lit (slice int) 1 3 3 4)
                                     (lit (slice int) 0 2 0 1 2) (lit (slice int) 0 4 3 4)
                                     (lit (slice int) 3 3 0 1 2 3 4) (lit (slice int) 2 4 0 1 2 3 4))]
                    (let [k (aget inv 0)
                          want (aget c (aget inv 1))]
                      (range [_ src (subslice inv 2)]
                        (inc! checks)
                        (let [got (nmNormalize (aget c src) (>= k 2) (== (% k 2) 1))]
                          (when (not (nmtEq got want))
                            (inc! bad)
                            (when (< bad 30)
                              (.Errorf t "line %d: %s(c%d) = %X, c%d = %X (%s)" (+ ln 1) (nmtForm k) (+ src 1) got (+ (aget inv 1) 1) want body))))))))))))
        ;; Part 1's rule over the code points it does not list
        (let [others 0
              obad 0]
          (for [n 0] (<= n 0x10FFFF) (inc! n)
            (let [r (conv rune n)]
              (when (and (!= (Category r) "Cn") (not (aget listed r)))
                (inc! others)
                (let [one (lit (slice rune) r)]
                  (for [k 0] (< k 4) (inc! k)
                    (when (not (nmtEq (nmNormalize one (>= k 2) (== (% k 2) 1)) one))
                      (inc! obad)
                      (when (< obad 30)
                        (.Errorf t "U+%04X not in Part 1: %s gives %X" n (nmtForm k) (nmNormalize one (>= k 2) (== (% k 2) 1))))))))))
          (.Logf t "NormalizationTest.txt: %d lines, %d checks, %d differ; Part 1's rule: %d code points not listed, %d differ"
                 lines checks bad others obad)
          (when (or (< lines 19000) (< others 100000))
            (.Fatalf t "NormalizationTest.txt: %d lines and %d other code points, at least 19000 and 100000 expected" lines others)))))))

(go/func TestNormalizeChez [^{:tag (* testing/T)} t]
  (let [root (os/Getenv "SI_TEST_ROOT")
        (values data err) (os/ReadFile (+ root "/test/scheme/si/norm-chez.tsv"))]
    (when (!= (os/Getenv "SI_NORM_ORACLE") "1")
      (.Skip t "the oracle tier's, by hand (SCS37 (a)): SI_NORM_ORACLE=1 runs it; TestNormalizationUAX15 is the unit test's judge")
      (return))
    (when (or (== root "") (!= err nil))
      (.Skip t "SI_TEST_ROOT unset or no recorded cases: the test needs the checkout")
      (return))
    (let [lines (strings/Split (strings/TrimSpace (conv string data)) "\n")
          bad 0
          blocks 0
          strs 0]
      (range [_ line lines]
        (let [f (strings/Split line "\t")
              ^{:tag (slice rune)} in nil]
          (cond
            (== (aget f 0) "B")
            (let [(values start _) (strconv/ParseInt (aget f 1) 16 32)
                  (values count _) (strconv/Atoi (aget f 2))
                  hs (make (slice uint32) 4)]
              (for [n (conv int start)] (< n (+ (conv int start) count)) (inc! n)
                (when (not (nmtSurrogate n))
                  (let [one (lit (slice rune) (conv rune n))]
                    (for [k 0] (< k 4) (inc! k)
                      (aset hs k (nmtHash (aget hs k) (nmNormalize one (>= k 2) (== (% k 2) 1))))))))
              (inc! blocks)
              (for [k 0] (< k 4) (inc! k)
                (when (!= (nmtHex (aget hs k)) (aget f (+ 3 k)))
                  (inc! bad)
                  (.Errorf t "block %s form %d: got %s want %s" (aget f 1) k (nmtHex (aget hs k)) (aget f (+ 3 k))))))
            (== (aget f 0) "S")
            (do
              (range [_ h (strings/Split (aget f 1) ".")]
                (let [(values v _) (strconv/ParseInt h 16 32)]
                  (set! in (append in (conv rune v)))))
              (inc! strs)
              (for [k 0] (< k 4) (inc! k)
                (let [got (nmtHex (nmtHash 0 (nmNormalize in (>= k 2) (== (% k 2) 1))))]
                  (when (!= got (aget f (+ 2 k)))
                    (inc! bad)
                    (when (< bad 30)
                      (.Errorf t "string %s form %d: got %s want %s" (aget f 1) k got (aget f (+ 2 k)))))))))))
      (.Logf t "%d blocks, %d strings, %d bad" blocks strs bad)
      (when (or (< blocks 1000) (< strs 3000))
        (.Errorf t "too few cases: %d blocks, %d strings" blocks strs)))))

;; a few cases by hand: the standard's examples
(go/func nmtStr ^string [^string s ^bool compat ^bool compose]
  (conv string (nmNormalize (conv (slice rune) s) compat compose)))

(go/func TestNormalizeExamples [^{:tag (* testing/T)} t]
  (do
    ;; nfd(U+1E9B U+0323) = U+017F U+0323 U+0307; nfc = U+1E9B U+0323; nfkd = s U+0323 U+0307; nfkc = U+1E69
    (let [in "ẛ̣"]
      (when (!= (nmtStr in false false) "ẛ̣") (.Errorf t "nfd"))
      (when (!= (nmtStr in false true) "ẛ̣") (.Errorf t "nfc"))
      (when (!= (nmtStr in true false) "ṩ") (.Errorf t "nfkd"))
      (when (!= (nmtStr in true true) "ṩ") (.Errorf t "nfkc")))
    (when (!= (nmtStr "각" false true) "각") (.Errorf t "hangul compose"))
    (when (!= (nmtStr "각" false false) "각") (.Errorf t "hangul decompose"))))

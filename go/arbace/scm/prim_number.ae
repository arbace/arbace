(go/func pnDefFl1 [^string name ^{:tag (func [float64] [float64])} f]
  (Def1 name (fn ^any [^any x] (f (pnFl name x)))))

(go/func pnDefFlCmp [^string name ^int kind]
  (let [test (fn ^bool [^float64 a ^float64 b]
        (switch kind
          (case [0]
            (return (== a b)))
          (case [1]
            (return (< a b)))
          (case [2]
            (return (> a b)))
          (case [3]
            (return (<= a b))))

        (>= a b))]

    (reg (addr ^{:go/breaks [8 10]} (lit Prim :Name name :Min 2 :Max -1
          :F2 (fn ^any [^any a ^any b] (test (pnFl name a) (pnFl name b)))
          :Fn ^{:go/breaks [[4 1629]] :go/end 1630} (fn ^any [^{:tag (slice any)} args]
            (range [_ x args]
              (pnFl name x))

            (for [i 0] (< (+ i 1) (len args)) (inc! i)
              (watchdogTick)
              (when (not (test (assert float64 (aget args i)) (assert float64 (aget args (+ i 1)))))
                (return false)))

            true))))))

(go/func pnDefFlDiv [^string name ^bool centered ^int which]
  (Def2 name (fn ^any [^any a ^any b]
      (let [(values x y) (values (pnFl name a) (pnFl name b))
          (values d m) (pnDivMod name centered x y)]
        (switch which
          (case [0]
            (return d))
          (case [1]
            (return m)))

        (addr (lit Values :V (lit (slice any) d m)))))))


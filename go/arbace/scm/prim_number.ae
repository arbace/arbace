        (when (> s e)
          (AssertionViolation "bitwise-reverse-bit-field" "start index ~s is greater than end index ~s" (aget args 1) (aget args 2)))

        (NormInt (pnReverseField x s e))))))

;; ---------------------------------------------------------------------------------------
;; Correctly rounded transcendental functions (Chez calls the C library's, which round correctly
;; in nearly all cases; Go's math package is within an ulp or two): evaluated in 200-bit big.Floats.

(go/const ^{:val 200} pnHP 200)

(go/var ^sync/Mutex pnConstMu)
(go/var pnPiCache (lit (map uint (* big/Float))))
(go/var pnLn2Cache (lit (map uint (* big/Float))))

(go/func pnNewF ^{:tag (* big/Float)} [^uint prec] (.SetPrec (new big/Float) prec))

(go/func pnFromInt ^{:tag (* big/Float)} [^int64 n ^uint prec] (.SetInt64 (pnNewF prec) n))

(go/func pnTiny ^bool [^{:tag (* big/Float)} x ^uint prec]
  (or (== (.Sign x) 0) (< (.MantExp x nil) (- (- (conv int prec)) 8))))

(go/func pnSeriesInv "pnSeriesInv is sum over k of sgn^k / ((2k+1) n^(2k+1)): atan(1/n) (alt) or atanh(1/n).\n" ^{:tag (* big/Float)} [^int64 n ^uint prec ^bool alt]
  (let [sum (pnNewF prec)
      n2 (pnFromInt (* n n) prec)
      pow (.Quo (pnNewF prec) (pnFromInt 1 prec) (pnFromInt n prec))]
    (for [k (conv int64 0)] (not (pnTiny pow prec)) (inc! k)
      (watchdogTick)
      (let [term (.Quo (pnNewF prec) pow (pnFromInt (+ (* 2 k) 1) prec))]
        (if (and alt (== (% k 2) 1))
          (.Sub sum sum term)

          (.Add sum sum term))

        (.Quo pow pow n2)))

    sum))

(go/func pnPi ^{:tag (* big/Float)} [^uint prec]
  (.Lock pnConstMu)
  (defer (.Unlock pnConstMu))
  (when [(values p ok) (aget pnPiCache prec)] ok
    (return p))

  (let [a (pnSeriesInv 5 (+ prec 8) true)
      b (pnSeriesInv 239 (+ prec 8) true)]
    (.Mul a a (pnFromInt 4 (+ prec 8)))
    (.Sub a a b)
    (.Mul a a (pnFromInt 4 (+ prec 8)))
    (let [p (.Set (pnNewF prec) a)]
      (aset pnPiCache prec p)
      p)))

(go/func pnLn2 ^{:tag (* big/Float)} [^uint prec]
  (.Lock pnConstMu)
  (defer (.Unlock pnConstMu))
  (when [(values p ok) (aget pnLn2Cache prec)] ok
    (return p))

  (let [a (pnSeriesInv 3 (+ prec 8) false)]
    (.Mul a a (pnFromInt 2 (+ prec 8)))
    (let [p (.Set (pnNewF prec) a)]
      (aset pnLn2Cache prec p)
      p)))

(go/func pnToF ^float64 [^{:tag (* big/Float)} x]
  (let [(values f _) (.Float64 x)]
    f))

(go/func pnHPExp ^{:tag (* big/Float)} [^{:tag (* big/Float)} x ^uint prec]
  (let [ln2 (pnLn2 prec)
      q (.Quo (pnNewF prec) x ln2)
      (values qf _) (.Float64 q)
      k (conv int (math/Round qf))
      r (.Sub (pnNewF prec) x (.Mul (pnNewF prec) (pnFromInt (conv int64 k) prec) ln2))]
    (.SetMantExp r r -10)
    (let [sum (pnFromInt 1 prec)
        term (pnFromInt 1 prec)]
      (for [i (conv int64 1)] (not (pnTiny term prec)) (inc! i)
        (watchdogTick)
        (.Mul term term r)
        (.Quo term term (pnFromInt i prec))
        (.Add sum sum term))

      (for [i 0] (< i 10) (inc! i)
        (watchdogTick)
        (.Mul sum sum sum))

      (.SetMantExp sum sum k))))

(go/func pnHPLn "pnHPLn is the natural logarithm of x > 0.\n" ^{:tag (* big/Float)} [^{:tag (* big/Float)} x ^uint prec]
  (let [m (pnNewF prec)
      e (.MantExp x m)]
    (when (< (.Cmp m (.SetFloat64 (pnNewF prec) 0.7071067811865476)) 0)
      (.SetMantExp m m 1)
      (dec! e))

    (let [one (pnFromInt 1 prec)
        z (.Quo (pnNewF prec) (.Sub (pnNewF prec) m one) (.Add (pnNewF prec) m one))
        z2 (.Mul (pnNewF prec) z z)
        sum (pnNewF prec)
        pow (.Set (pnNewF prec) z)]
      (for [k (conv int64 0)] (not (pnTiny pow prec)) (inc! k)
        (watchdogTick)
        (.Add sum sum (.Quo (pnNewF prec) pow (pnFromInt (+ (* 2 k) 1) prec)))
        (.Mul pow pow z2))

      (.Mul sum sum (pnFromInt 2 prec))
      (.Add sum sum (.Mul (pnNewF prec) (pnFromInt (conv int64 e) prec) (pnLn2 prec))))))

(go/func pnHPAtan ^{:tag (* big/Float)} [^{:tag (* big/Float)} x ^uint prec]
  (let [neg (< (.Sign x) 0)
      a (.Abs (pnNewF prec) x)
      one (pnFromInt 1 prec)
      inv (> (.Cmp a one) 0)]
    (when inv
      (.Quo a one a))

    (for [i 0] (< i 4) (inc! i)
      (watchdogTick)
      (let [t (.Mul (pnNewF prec) a a)]
        (.Add t t one)
        (.Sqrt t t)
        (.Add t t one)
        (.Quo a a t)))

    (let [a2 (.Mul (pnNewF prec) a a)
        sum (pnNewF prec)
        pow (.Set (pnNewF prec) a)]
      (for [k (conv int64 0)] (not (pnTiny pow prec)) (inc! k)
        (watchdogTick)
        (let [term (.Quo (pnNewF prec) pow (pnFromInt (+ (* 2 k) 1) prec))]
          (if (== (% k 2) 1)
            (.Sub sum sum term)

            (.Add sum sum term))

          (.Mul pow pow a2)))

      (.Mul sum sum (pnFromInt 16 prec))
      (when inv
        (let [h (.Set (pnNewF prec) (pnPi prec))]
          (.SetMantExp h h -1)
          (.Sub sum h sum)))

      (when neg
        (.Neg sum sum))

      sum)))

(go/func pnHPSinCos [^float64 x] :results [(* big/Float) (* big/Float) int]
  (let [(values _ ex) (math/Frexp x)]
    (when (< ex 0)
      (set! ex 0))

    (let [wp (* (/ (+ pnHP (conv uint ex) 20 63) 64) 64)
        half (.Set (pnNewF wp) (pnPi wp))]
      (.SetMantExp half half -1)
      (let [xf (.SetFloat64 (pnNewF wp) x)
          q (.Quo (pnNewF wp) xf half)]
        (.Add q q (.SetFloat64 (pnNewF wp) 0.5))
        (let [(values k acc) (.Int q nil)]
          (when (and (< (.Sign q) 0) (!= acc big/Exact))
            (.Sub k k (big/NewInt 1)))

          (let [r (.Sub (pnNewF wp) xf (.Mul (pnNewF wp) (.SetInt (pnNewF wp) k) half))
              r2 (.Mul (pnNewF wp) r r)
              s (.Set (pnNewF wp) r)
              st (.Set (pnNewF wp) r)
              c (pnFromInt 1 wp)
              ct (pnFromInt 1 wp)]
            (for [i (conv int64 1)] (or (not (pnTiny st wp)) (not (pnTiny ct wp))) (inc! i)
              (watchdogTick)
              (.Mul ct ct r2)
              (.Quo ct ct (pnFromInt (* (- (* 2 i) 1) (* 2 i)) wp))
              (.Neg ct ct)
              (.Add c c ct)
              (.Mul st st r2)
              (.Quo st st (pnFromInt (* 2 i (+ (* 2 i) 1)) wp))
              (.Neg st st)
              (.Add s s st))

            (return s c (conv int (.Int64 (.Mod (new big/Int) k (big/NewInt 4)))))))))))

(go/func pnSpecial ^bool [^float64 x] (or (math/IsNaN x) (math/IsInf x 0) (== x 0)))

(go/func pnExp ^float64 [^float64 x]
  (when (or (pnSpecial x) (> (math/Abs x) 746))
    (return (math/Exp x)))

  (pnToF (pnHPExp (.SetFloat64 (pnNewF pnHP) x) pnHP)))

(go/func pnLn ^float64 [^float64 x]
  (when (or (pnSpecial x) (< x 0) (== x 1))
    (return (math/Log x)))

  (pnToF (pnHPLn (.SetFloat64 (pnNewF pnHP) x) pnHP)))

(go/func pnSin ^float64 [^float64 x]
  (when (pnSpecial x)
    (return (math/Sin x)))

  (let [(values s c k) (pnHPSinCos x)]
    (switch k
      (case [0]
        (return (pnToF s)))
      (case [1]
        (return (pnToF c)))
      (case [2]
        (return (- (pnToF s)))))

    (- (pnToF c))))

(go/func pnCos ^float64 [^float64 x]
  (when (pnSpecial x)
    (return (math/Cos x)))

  (let [(values s c k) (pnHPSinCos x)]
    (switch k
      (case [0]
        (return (pnToF c)))
      (case [1]
        (return (- (pnToF s))))
      (case [2]
        (return (- (pnToF c)))))

    (pnToF s)))

(go/func pnTan ^float64 [^float64 x]
  (when (pnSpecial x)
    (return (math/Tan x)))

  (let [(values s c k) (pnHPSinCos x)]
    (when (== (% k 2) 0)
      (return (pnToF (.Quo (pnNewF (.Prec s)) s c))))

    (let [r (.Quo (pnNewF (.Prec s)) c s)]
      (- (pnToF r)))))

(go/func pnAtan ^float64 [^float64 x]
  (when (pnSpecial x)
    (return (math/Atan x)))

  (pnToF (pnHPAtan (.SetFloat64 (pnNewF pnHP) x) pnHP)))

(go/func pnAsin ^float64 [^float64 x]
  (when (or (pnSpecial x) (>= (math/Abs x) 1))
    (return (math/Asin x)))

  (let [xf (.SetFloat64 (pnNewF pnHP) x)
      d (.Mul (pnNewF pnHP) xf xf)]
    (.Sub d (pnFromInt 1 pnHP) d)
    (.Sqrt d d)
    (pnToF (pnHPAtan (.Quo (pnNewF pnHP) xf d) pnHP))))

(go/func pnAcos ^float64 [^float64 x]
  (when (or (pnSpecial x) (>= (math/Abs x) 1))
    (return (math/Acos x)))

  (let [xf (.SetFloat64 (pnNewF pnHP) x)
      one (pnFromInt 1 pnHP)
      q (.Quo (pnNewF pnHP) (.Sub (pnNewF pnHP) one xf) (.Add (pnNewF pnHP) one xf))]
    (.Sqrt q q)
    (let [r (pnHPAtan q pnHP)]
      (pnToF (.Mul r r (pnFromInt 2 pnHP))))))

(go/func pnAtan2 ^float64 [^float64 y ^float64 x]
  (when (or (pnSpecial x) (pnSpecial y))
    (return (math/Atan2 y x)))

  (let [q (.SetFloat64 (pnNewF pnHP) (/ y x))
      a (pnHPAtan q pnHP)]
    (when (< x 0)
      (if (> y 0)
        (.Add a a (pnPi pnHP))

        (.Sub a a (pnPi pnHP))))

    (pnToF a)))

(go/func pnPow ^float64 [^float64 x ^float64 y]
  (when (or (pnSpecial x) (pnSpecial y) (== x 1) (== y 1) (== y -1))
    (return (math/Pow x y)))

  (let [neg false]
    (when (< x 0)
      (when (!= y (math/Trunc y))
        (return (math/NaN)))

      (set! neg (and (< (math/Abs y) 9007199254740992) (!= (math/Mod y 2) 0)))
      (set! x (- x)))

    (let [t (.Mul (pnNewF pnHP) (pnHPLn (.SetFloat64 (pnNewF pnHP) x) pnHP) (.SetFloat64 (pnNewF pnHP) y))
        tf (pnToF t)
        ^{:line 2176 :tag float64} r (zero float64)]
      (cond (> tf 750)
        (set! r (math/Inf 1))
        (< tf -760)
        (set! r 0) :else

        (set! r (pnToF (pnHPExp t pnHP))))

      (when neg
        (return (- r)))

      r)))

(go/func inRanges "inRanges is whether r is in one of the flat ranges rs (lo hi pairs, ascending).\n" ^bool [^{:tag (slice int32)} rs ^rune r]
  (let [lo 0 hi (/ (len rs) 2)]
    (while (< lo hi)
      (let [m (/ (+ lo hi) 2)]
        (cond (< r (aget rs (* 2 m))) (set! hi m)
              (> r (aget rs (+ (* 2 m) 1))) (set! lo (+ m 1))
              :else (return true))))
    false))

(go/func IsIdentInitial "IsIdentInitial is whether r may start an identifier (R6RS 4.2.1 over UCD 16.0.0).\n" ^bool [^rune r]
  (when (< r 128)
    (return (or (and (>= r \a) (<= r \z)) (and (>= r \A) (<= r \Z))
                (== r \!) (== r \$) (== r \%) (== r \&) (== r \*) (== r \/) (== r \:) (== r \<) (== r \=)
                (== r \>) (== r \?) (== r \^) (== r \_) (== r \~))))
  (inRanges initialRanges r))

(go/func IsIdentSubsequent "IsIdentSubsequent is whether r may continue an identifier.\n" ^bool [^rune r]
  (when (< r 128)
    (return (or (IsIdentInitial r) (and (>= r \0) (<= r \9)) (== r \+) (== r \-) (== r \.) (== r \@))))
  (inRanges subsequentRanges r))

(go/var ^{:tag (slice int32)} whitespaceRanges
  (lit (slice int32)
    160 160 5760 5760 8192 8202 8232 8233 8239 8239 8287 8287 12288 12288))

(go/var ^{:tag (slice int32)} zsRanges
  (lit (slice int32)
    160 160 5760 5760 8192 8202 8239 8239 8287 8287 12288 12288))

(go/func IsWhitespace "IsWhitespace is whether r is a <whitespace> (R6RS 4.2.1: tab, line feed, line tabulation, form feed, carriage return, next line, Zs, Zl, Zp over UCD 16.0.0).\n" ^bool [^rune r]
  (when (< r 128)
    (return (or (== r 32) (and (>= r 9) (<= r 13)))))
  (or (== r 0x85) (inRanges whitespaceRanges r)))

(go/func IsIntralineSpace "IsIntralineSpace is whether r is an <intraline whitespace> (R6RS 4.2.1: tab, Zs over UCD 16.0.0).\n" ^bool [^rune r]
  (or (== r 9) (== r 32) (and (> r 127) (inRanges zsRanges r))))

;; the printer's escapes (SCS17 (c), doc/scheme/SPEC.md 7): a control of the ASCII range or a <line ending>'s first character,
;; in a string without a mnemonic escape (stringHexRanges), as a character without a name (charHexRanges)
(go/var ^{:tag (slice int32)} stringHexRanges
  (lit (slice int32)
    0 6 14 31 127 127 133 133 8232 8232))

(go/var ^{:tag (slice int32)} charHexRanges
  (lit (slice int32)
    1 6 14 26 28 31 133 133 8232 8232))

(go/func IsStringHex "IsStringHex is whether write gives the character r of a string as \\xHEX; (SPEC 7 :print-string).\n" ^bool [^rune r]
  (inRanges stringHexRanges r))

(go/func IsCharHex "IsCharHex is whether write gives the character r as #\\xHEX (SPEC 7 :print-char).\n" ^bool [^rune r]
  (inRanges charHexRanges r))


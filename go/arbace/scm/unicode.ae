(go/var ^{:tag (map rune rune)} simpleUpper (foldSimpleMap simpleUpperData))

(go/var ^{:tag (map rune rune)} simpleLower (foldSimpleMap simpleLowerData))

(go/var ^{:tag (map rune rune)} simpleTitle (foldSimpleMap simpleTitleData))

(go/var ^{:tag (map rune (slice rune))} specialUpper (foldFullMap specialUpperData))

(go/var ^{:tag (map rune (slice rune))} specialLower (foldFullMap specialLowerData))

(go/var ^{:tag (map rune (slice rune))} specialTitle (foldFullMap specialTitleData))

(go/func simpleOf ^rune [^{:tag (map rune rune)} m ^rune r]
  (let [(values f ok) (aget m r)]
    (when ok
      (return f))
    r))

(go/func UpcaseRune "UpcaseRune is r's simple uppercase mapping (UnicodeData.txt's field 12): char-upcase.\n" ^rune [^rune r] (simpleOf simpleUpper r))

(go/func DowncaseRune "DowncaseRune is r's simple lowercase mapping (field 13): char-downcase.\n" ^rune [^rune r] (simpleOf simpleLower r))

(go/func TitlecaseRune "TitlecaseRune is r's simple titlecase mapping (field 14, else 12): char-titlecase.\n" ^rune [^rune r] (simpleOf simpleTitle r))

(go/func SpecialUpcase "SpecialUpcase is r's unconditional full uppercase mapping of SpecialCasing.txt, ok false where it has none.\n" [^rune r] :results [(slice rune) bool]
  (let [(values f ok) (aget specialUpper r)]
    (return f ok)))

(go/func SpecialDowncase "SpecialDowncase is r's unconditional full lowercase mapping of SpecialCasing.txt, ok false where it has none.\n" [^rune r] :results [(slice rune) bool]
  (let [(values f ok) (aget specialLower r)]
    (return f ok)))

(go/func SpecialTitlecase "SpecialTitlecase is r's unconditional full titlecase mapping of SpecialCasing.txt, ok false where it has none.\n" [^rune r] :results [(slice rune) bool]
  (let [(values f ok) (aget specialTitle r)]
    (return f ok)))

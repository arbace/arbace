(go/func foldFullMap ^{:tag (map rune (slice rune))} [^{:tag (slice int32)} d]
  (let [m (make (map rune (slice rune)))
        i 0]
    (while (< i (len d))
      (let [n (conv int (aget d (+ i 1)))]
        (aset m (aget d i) (conv (slice rune) (subslice d (+ i 2) (+ i 2 n))))
        (set! i (+ i 2 n))))
    m))

(go/func foldSimpleMap ^{:tag (map rune rune)} [^{:tag (slice int32)} d]
  (let [m (make (map rune rune))]
    (for [i 0] (< i (len d)) (set! i (+ i 2))
      (aset m (aget d i) (aget d (+ i 1))))
    m))

(go/var ^{:tag (map rune (slice rune))} foldFull (foldFullMap foldFullData))

(go/var ^{:tag (map rune rune)} foldSimple (foldSimpleMap foldSimpleData))

(go/func FoldRune "FoldRune is r by simple case folding (CaseFolding.txt's C and S: char-foldcase).\n" ^rune [^rune r]
  (let [(values f ok) (aget foldSimple r)]
    (when ok
      (return f))
    r))

(go/func FoldRunes "FoldRunes is rs by full case folding (CaseFolding.txt's C and F: string-foldcase, #!fold-case).\n" ^{:tag (slice rune)} [^{:tag (slice rune)} rs]
  (let [out (make (slice rune) 0 (len rs))]
    (range [_ r rs]
      (let [(values f ok) (aget foldFull r)]
        (if ok
          (set! out (append out (spread f)))
          (set! out (append out r)))))
    out))

(go/func FoldCase "FoldCase is s by full case folding (#!fold-case's identifiers and character names).\n" ^string [^string s]
  (conv string (FoldRunes (conv (slice rune) s))))

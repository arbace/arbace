(go/func Category "Category is the general category of r, a two-letter name (Cn when it is unassigned; UnicodeData.txt's field 2).\n" ^string [^rune r]
  (let [lo 0 hi (/ (len catRuns) 3)]
    (while (< lo hi)
      (let [m (/ (+ lo hi) 2) b (* 3 m)]
        (cond (< r (aget catRuns b)) (set! hi m)
              (> r (aget catRuns (+ b 1))) (set! lo (+ m 1))
              :else (return (aget catNames (aget catRuns (+ b 2)))))))
    "Cn"))


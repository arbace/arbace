(go/func WordBreak "WordBreak is the Word_Break class of r (UAX #29, WordBreakProperty.txt of UCD 16.0.0), wbOther when it has none.\n" ^int [^rune r]
  (let [lo 0 hi (/ (len wbRuns) 3)]
    (while (< lo hi)
      (let [m (/ (+ lo hi) 2) b (* 3 m)]
        (cond (< r (aget wbRuns b)) (set! hi m)
              (> r (aget wbRuns (+ b 1))) (set! lo (+ m 1))
              :else (return (conv int (aget wbRuns (+ b 2)))))))
    wbOther))


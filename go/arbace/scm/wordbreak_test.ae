;; SCS24 (b) (the user 2026-11-09; doc/scheme/SCHEME-SURVEY.md, "As built: SCS22-SCS24"): dcWordBreak (prim_char.ae, UAX #29's rules
;; WB3 to WB16 over unicode.ae's Word_Break classes) against UAX #29's own conformance data, auxiliary/WordBreakTest.txt of UCD 16.0.0
;; (pinned by test/scheme/ucd.edn; bin/si unit names it by SI_UCD_DIR, the main checkout's .tmp/scheme/ucd-16.0.0): every line
;;   ÷ XXXX × YYYY ÷ ... ÷   # comment
;; is a string, ÷ a boundary and × none between two of its characters; each inner position is dcWordBreak's answer (the text's two ends,
;; WB1 and WB2, are boundaries by rule). Data only: nothing in the file is run.
(in-ns 'go.arbace.scm)

(go/file "wordbreak_test.go" :imports [[testing "testing"] [os "os"] [strings "strings"] [strconv "strconv"]])

(go/func TestWordBreakUAX29 [^{:tag (* testing/T)} t]
  (let [dir (os/Getenv "SI_UCD_DIR")]
    (when (== dir "")
      (.Skip t "SI_UCD_DIR unset: the test needs the pinned UCD (bin/si unit sets it)")
      (return))
    (let [(values data err) (os/ReadFile (+ dir "/auxiliary/WordBreakTest.txt"))]
      (when (!= err nil)
        (.Fatalf t "WordBreakTest.txt: %v (bin/repr-scheme ucd fetch)" err))
      (when (not (strings/HasPrefix (conv string data) "# WordBreakTest-16.0.0.txt"))
        (.Fatalf t "WordBreakTest.txt: not UCD 16.0.0's"))
      (let [cases 0
            positions 0
            bad 0]
        (range [ln line (strings/Split (conv string data) "\n")]
          (let [body line
                h (strings/Index line "#")]
            (when (>= h 0)
              (set! body (subslice line 0 h)))
            (let [fs (strings/Fields body)]
              (when (> (len fs) 0)
                (let [^{:tag (slice rune)} rs nil
                      ^{:tag (slice bool)} want nil]
                  ;; fs: ÷ cp op cp op ... cp ÷ (op ÷ or ×)
                  (for [k 1] (< k (len fs)) (set! k (+ k 2))
                    (let [(values v e) (strconv/ParseUint (aget fs k) 16 32)]
                      (when (!= e nil)
                        (.Fatalf t "line %d: %q is no code point" (+ ln 1) (aget fs k)))
                      (set! rs (append rs (conv rune v)))
                      (when (< (+ k 1) (len fs))
                        (set! want (append want (== (aget fs (+ k 1)) "÷"))))))
                  (inc! cases)
                  (let [wb (make (slice int) (len rs))]
                    (range [i r rs]
                      (aset wb i (WordBreak r)))
                    (for [i 1] (< i (len rs)) (inc! i)
                      (inc! positions)
                      (let [got (dcWordBreak rs wb i)]
                        (when (!= got (aget want (- i 1)))
                          (inc! bad)
                          (when (< bad 30)
                            (.Errorf t "line %d: between %04X and %04X: boundary %v, UAX #29 %v (%s)" (+ ln 1) (aget rs (- i 1)) (aget rs i) got
                                     (aget want (- i 1)) (strings/TrimSpace body))))))))))))
        (.Logf t "WordBreakTest.txt: %d strings, %d inner positions, %d differ" cases positions bad)
        (when (< cases 1800)
          (.Fatalf t "WordBreakTest.txt: %d strings, at least 1800 expected" cases))))))

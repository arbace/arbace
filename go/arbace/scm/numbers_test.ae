(in-ns 'go.arbace.scm)

(go/file "numbers_test.go" :imports [

    [fmt "fmt"]
    [math "math"]
    [big "math/big"]
    [testing "testing"]])

(go/type pnWant (struct
    ^{:line 11 :tag bool} err
    ^{:line 12 :tag string} who
    ^{:line 13 :tag string} msg
    ^{:line 14 :tag (slice any)} irr
    ^{:line 15 :tag (slice any)} vals
    ^{:line 16 :tag bool} unimpl))

(go/type pnCase (struct
    ^{:line 20 :tag string} name
    ^{:line 21 :tag (slice any)} args
    ^{:line 22 :tag pnWant} want))

(go/func pnOK ^pnWant [& ^{:tag (slice any)} v] (lit pnWant :vals v))

(go/func pnErr ^pnWant [^string who ^string msg & ^{:tag (slice any)} irr]
  (lit pnWant :err true :who who :msg msg :irr irr))

(go/func pnUnimpl ^pnWant [] (lit pnWant :err true :unimpl true))

(go/func pnBigLit ^any [^string s]
  (let [(values b _) (.SetString (new big/Int) s 10)]
    (NormInt b)))

(go/func pnRatLit ^any [^string s]
  (let [(values r _) (.SetString (new big/Rat) s)]
    (NormRat r)))

(go/func pnSame ^bool [^any a ^any b]
  (type-switch [x a]
    (case [float64]
      (let [(values y ok) (assert float64 b)]
        (when (not ok)
          (return false))

        (when (and (math/IsNaN x) (math/IsNaN y))
          (return true))

        (return (== (math/Float64bits x) (math/Float64bits y)))))
    (case [(* Values)]
      (let [(values y ok) (assert (* Values) b)]
        (when (or (not ok) (!= (len (.-V x)) (len (.-V y))))
          (return false))

        (range [i (.-V x)]
          (when (not (pnSame (aget (.-V x) i) (aget (.-V y) i)))
            (return false)))

        (return true))))

  (Eqv a b))

(go/func pnUlp1 "pnUlp1 is whether two flonums are within one ulp (Chez's libm is not correctly rounded everywhere).\n" ^bool [^any a ^any b]
  (let [(values x ok1) (assert float64 a)
      (values y ok2) (assert float64 b)]
    (when (or (not ok1) (not ok2) (math/IsNaN x) (math/IsNaN y) (!= (< x 0) (< y 0)))
      (return false))

    (let [d (- (conv int64 (math/Float64bits x)) (conv int64 (math/Float64bits y)))]
      (and (>= d -1) (<= d 1)))))

(go/var pnTolerant (lit (map string bool) ["sin" true] ["cos" true] ["tan" true] ["asin" true] ["acos" true] ["atan" true] ["exp" true] ["log" true] ["expt" true]
    ["flsin" true] ["flcos" true] ["fltan" true] ["flasin" true] ["flacos" true] ["flatan" true] ["flexp" true] ["fllog" true] ["flexpt" true]))

(go/func pnShow ^string [^any v]
  (type-switch [x v]
    (case [(* Symbol)]
      (return (.-Name x)))
    (case [(* Values)]
      (let [s "(values"]
        (range [_ e (.-V x)]
          (set! s + (+ " " (pnShow e))))

        (return (+ s ")"))))
    (case [float64]
      (return (fmt/Sprintf "%v/%x" x (math/Float64bits x))))
    (case [(* big/Int) (* big/Rat)]
      (return (fmt/Sprint x))))

  (fmt/Sprintf "%T:%v" v v))

(go/func pnRun [^{:tag (* Prim)} p ^{:tag (slice any)} args] :results [^any res ^any raised]
  (defer ((fn []
        (when [r (recover)] (!= r nil)
          (let [(values rr ok) (assert (* Raise) r)]
            (when (not ok)
              (panic r))

            (set! raised (.-Obj rr)))))))

  (when (not (.arityOK p (len args)))
    (return nil "arity"))

  (return (.call p args) nil))

(go/func pnCondText [^any c] :results [string string (slice any)]
  (let [(values who msg) (values "" "")]
    (when [(values w ok) (CondField c CondWho 0)] ok
      (when [(values s ok) (assert (* Symbol) w)] ok
        (set! who (.-Name s))))

    (when [(values m ok) (CondField c CondMessage 0)] ok
      (when [(values s ok) (assert (* String) m)] ok
        (set! msg (.String s))))

    (let [^{:tag (slice any)} irr (zero (slice any))]
      (when [(values i ok) (CondField c CondIrritants 0)] ok
        (set! (values irr _) (ListSlice i)))

      (return who msg irr))))

(go/func TestNumberCases [^{:tag (* testing/T)} t]
  (range [i c (append (append (lit (slice pnCase)) (spread pnCases)) (spread pnCases9))]
    (let [p (LookupPrim (.-name c))]
      (when (== p nil)
        ^{:go/via [common]} (.Errorf t "case %d: no primitive %s" i (.-name c))
        (continue))

      (let [args (make (slice any) (len (.-args c)))]
        (range [j a (.-args c)]
          (aset args j a))

        (let [(values res raised) (pnRun p args)
            desc (.-name c)]
          (range [_ a (.-args c)]
            (set! desc + (+ " " (pnShow a))))

          (when (!= raised nil)
            (when (not (.-err (.-want c)))
              (let [(values who msg irr) (pnCondText raised)]
                ^{:go/via [common]} (.Errorf t "(%s): raised %s: %s %v, want %v" desc who msg irr (.-vals (.-want c)))
                (continue)))

            (let [(values who msg irr) (pnCondText raised)
                ok (and (== who (.-who (.-want c))) (== msg (.-msg (.-want c))) (== (len irr) (len (.-irr (.-want c)))))]
              (when ok
                (range [j irr]
                  (when (not (pnSame (aget irr j) (aget (.-irr (.-want c)) j)))
                    (set! ok false))))

              (when (not ok)
                ^{:go/via [common]} (.Errorf t "(%s): raised %q %q %v, want %q %q %v" desc who msg irr (.-who (.-want c)) (.-msg (.-want c)) (.-irr (.-want c))))

              (continue)))

          (when (.-err (.-want c))
            ^{:go/via [common]} (.Errorf t "(%s): got %s, want error %s: %s" desc (pnShow res) (.-who (.-want c)) (.-msg (.-want c)))
            (continue))

          (let [^{:tag (slice any)} got (zero (slice any))]
            (if [(values v ok) (assert (* Values) res)] (and ok (!= (len (.-vals (.-want c))) 1))
              (set! got (.-V v))

              (set! got (lit (slice any) res)))

            (let [ok (== (len got) (len (.-vals (.-want c))))]
              (when ok
                (range [j got]
                  (when (and (not (pnSame (aget got j) (aget (.-vals (.-want c)) j))) (not (and (aget pnTolerant (.-name c)) (pnUlp1 (aget got j) (aget (.-vals (.-want c)) j)))))
                    (set! ok false))))

              (when (not ok)
                (let [ws ""]
                  (range [_ w (.-vals (.-want c))]
                    (set! ws + (+ " " (pnShow w))))

                  (let [gs ""]
                    (range [_ g got]
                      (set! gs + (+ " " (pnShow g))))

                    ^{:go/via [common]} (.Errorf t "(%s): got%s, want%s" desc gs ws)))))))))))

(go/func TestNumberUnimplemented "the complex results of Chez are Unimplemented in si (SC7)\n" [^{:tag (* testing/T)} t]
  (let [cases (lit (slice (struct
            ^{:line 207 :tag string} name
            ^{:line 208 :tag (slice any)} args))

        (lit _ "sqrt" (lit (slice any) (conv int64 -4)))
        (lit _ "sqrt" (lit (slice any) (conv float64 -4)))
        (lit _ "log" (lit (slice any) (conv int64 -1)))
        (lit _ "asin" (lit (slice any) (conv int64 2)))
        (lit _ "acos" (lit (slice any) (conv float64 2)))
        (lit _ "expt" (lit (slice any) (conv int64 -8) (pnRatLit "1/3")))
        (lit _ "expt" (lit (slice any) (conv int64 -4) (conv float64 0.5)))
        (lit _ "make-rectangular" (lit (slice any) (conv int64 1) (conv int64 2)))
        (lit _ "make-polar" (lit (slice any) (conv float64 1.1) (conv float64 2.2))))]

    (range [_ c cases]
      (let [(values _ raised) (pnRun (LookupPrim (.-name c)) (.-args c))]
        (when (!= raised nil)
          ^{:go/via [common]} (.Errorf t "%s %v: raised (complex numbers exist since SM6)" (.-name c) (.-args c))
          (continue))
        (continue)

        (when (== (CondPart raised CondImplRestriction) nil)
          ^{:go/via [common]} (.Errorf t "%s %v: not an implementation restriction" (.-name c) (.-args c)))))))

(go/func TestNumberArity [^{:tag (* testing/T)} t]
  (range [_ c (lit (slice (struct
            ^{:line 234 :tag string} name
            ^{:line 235 :tag int} n
            ^{:line 236 :tag bool} ok))

        (lit _ "+" 0 true) (lit _ "-" 0 false) (lit _ "/" 0 false) (lit _ "=" 1 false) (lit _ "<" 2 true) (lit _ "max" 0 false)
        (lit _ "fx+" 3 false) (lit _ "fx-" 1 true) (lit _ "fx-" 3 false) (lit _ "fx=?" 1 false) (lit _ "fl+" 0 true)
        (lit _ "fl-" 0 false) (lit _ "atan" 3 false) (lit _ "log" 3 false) (lit _ "number->string" 5 false) (lit _ "fxand" 0 true))]

    (when (!= (.arityOK (LookupPrim (.-name c)) (.-n c)) (.-ok c))
      ^{:go/via [common]} (.Errorf t "%s with %d arguments" (.-name c) (.-n c)))))

(go/func TestNumberStringArgs [^{:tag (* testing/T)} t]
  (range [_ c (lit (slice (struct
            ^{:line 250 :tag string} name
            ^{:line 251 :tag (slice any)} args
            ^{:line 252 :tag string} msg))

        (lit _ "number->string" (lit (slice any) (Intern "a")) "~s is not a number")
        (lit _ "number->string" (lit (slice any) (conv int64 10) (Intern "a")) "~s is not a valid radix")
        (lit _ "number->string" (lit (slice any) (conv int64 10) (conv int64 3)) "~s is not a valid radix")
        (lit _ "number->string" (lit (slice any) (conv int64 10) (conv int64 16) (conv int64 3)) "a precision is specified and radix ~s is not 10")
        (lit _ "number->string" (lit (slice any) (conv int64 3) (conv int64 10) (conv int64 5)) "a precision is specified and ~s is not inexact")
        (lit _ "string->number" (lit (slice any) (Intern "a")) "~s is not a string")
        (lit _ "string->number" (lit (slice any) (Str "1") (conv int64 3)) "~s is not a valid radix"))]

    (let [(values _ raised) (pnRun (LookupPrim (.-name c)) (.-args c))]
      (when (== raised nil)
        ^{:go/via [common]} (.Errorf t "%s: no error" (.-name c))
        (continue))

      (let [(values _ msg _) (pnCondText raised)]
        (when (!= msg (.-msg c))
          ^{:go/via [common]} (.Errorf t "%s: %q, want %q" (.-name c) msg (.-msg c)))))))

(go/func TestNumberMath [^{:tag (* testing/T)} t]
  (let [bad 0]
    (range [_ c pnCases8]
      (when (.-err (.-want c))
        (continue))

      (let [(values res raised) (pnRun (LookupPrim (.-name c)) (.-args c))]
        (when (or (!= raised nil) (not (or (pnSame res (aget (.-vals (.-want c)) 0)) (pnUlp1 res (aget (.-vals (.-want c)) 0)))))
          (inc! bad)
          ^{:go/via [common]} (.Logf t "(%s %s): got %s want %s" (.-name c) (pnShow (aget (.-args c) 0)) (pnShow res) (pnShow (aget (.-vals (.-want c)) 0))))))

    ^{:go/via [common]} (.Logf t "%d of %d differ" bad (len pnCases8))))

(go/func TestNumberNames [^{:tag (* testing/T)} t]
  (range [_ n ^{:go/breaks [73 118 164]} (lit (slice string) "number?" "complex?" "real?" "rational?" "integer?" "real-valued?" "rational-valued?" "integer-valued?" "exact?" "inexact?" "exact" "inexact" "exact->inexact" "inexact->exact" "=" "<" ">" "<=" ">=" "zero?" "positive?" "negative?" "odd?" "even?" "finite?" "infinite?" "nan?" "max" "min" "+" "*" "-" "/" "abs" "div" "mod" "div-and-mod" "div0" "mod0" "div0-and-mod0" "quotient" "remainder" "modulo" "gcd" "lcm" "numerator" "denominator" "floor" "ceiling" "truncate" "round" "rationalize" "exp" "log" "sin" "cos" "tan" "asin" "acos" "atan" "sqrt" "exact-integer-sqrt" "expt" "number->string" "string->number" "make-rectangular" "make-polar" "real-part" "imag-part" "magnitude" "angle"
        "fixnum?" "fixnum-width" "least-fixnum" "greatest-fixnum" "fx=?" "fx>?" "fx<?" "fx>=?" "fx<=?" "fxzero?" "fxpositive?" "fxnegative?" "fxodd?" "fxeven?" "fxmax" "fxmin" "fx+" "fx*" "fx-" "fxdiv-and-mod" "fxdiv" "fxmod" "fxdiv0-and-mod0" "fxdiv0" "fxmod0" "fx+/carry" "fx-/carry" "fx*/carry" "fxnot" "fxand" "fxior" "fxxor" "fxif" "fxbit-count" "fxlength" "fxfirst-bit-set" "fxbit-set?" "fxcopy-bit" "fxbit-field" "fxcopy-bit-field" "fxrotate-bit-field" "fxreverse-bit-field" "fxarithmetic-shift" "fxarithmetic-shift-left" "fxarithmetic-shift-right"
        "flonum?" "real->flonum" "fl=?" "fl<?" "fl>?" "fl<=?" "fl>=?" "flinteger?" "flzero?" "flpositive?" "flnegative?" "flodd?" "fleven?" "flfinite?" "flinfinite?" "flnan?" "flmax" "flmin" "fl+" "fl*" "fl-" "fl/" "flabs" "fldiv-and-mod" "fldiv" "flmod" "fldiv0-and-mod0" "fldiv0" "flmod0" "flnumerator" "fldenominator" "flfloor" "flceiling" "fltruncate" "flround" "flexp" "fllog" "flsin" "flcos" "fltan" "flasin" "flacos" "flatan" "flsqrt" "flexpt" "fixnum->flonum"
        "bitwise-not" "bitwise-and" "bitwise-ior" "bitwise-xor" "bitwise-if" "bitwise-bit-count" "bitwise-length" "bitwise-first-bit-set" "bitwise-bit-set?" "bitwise-copy-bit" "bitwise-bit-field" "bitwise-copy-bit-field" "bitwise-arithmetic-shift" "bitwise-arithmetic-shift-left" "bitwise-arithmetic-shift-right" "bitwise-rotate-bit-field" "bitwise-reverse-bit-field")]
    (when (== (LookupPrim n) nil)
      ^{:go/via [common]} (.Errorf t "missing %s" n))))

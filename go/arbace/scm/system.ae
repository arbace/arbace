;; si's runtime: the host's side of psyntax (doc/scheme/SCHEME-SURVEY.md, "As built: SM4", SC40 (a)): the
;; primitives psyntax's compat imports from (psyntax system $bootstrap) (the store of locations and labels,
;; gensym, eval-core, format, the library files), booting psyntax from its expanded form
;; (scheme/psyntax/psyntax.pp.ae, printed as Scheme text), and running a top-level program: expanded by
;; psyntax on si, its libraries invoked, its core form evaluated. Uncaught raises are reported as Chez
;; reports them.
(in-ns 'go.arbace.scm)

(go/file "system.go"
  :imports [[fmt "fmt"] [os "os"] [strconv "strconv"] [strings "strings"]])

(go/func ArgSymbolLoc ^{:tag (* Symbol)} [^string who ^any x] (ArgSymbol who x))

;; ---------------------------------------------------------------------------------------
;; format (Chez's directives ~a ~s ~d ~% ~n ~~, as psyntax and programs use them)

(go/func Format "Format is Chez's format of control string f with args.\n" ^string [^string f ^{:tag (slice any)} args]
  (let [^strings/Builder b (zero strings/Builder)
        rs (conv (slice rune) f)
        k 0]
    (for [i 0] (< i (len rs)) (inc! i)
      (let [c (aget rs i)]
        (if (and (== c \~) (< (+ i 1) (len rs)))
          (do
            (inc! i)
            (switch (aget rs i)
              (case [\a \A \d \D]
                (when (< k (len args))
                  (WriteTo (addr b) (aget args k) true)
                  (inc! k)))
              (case [\s \S]
                (when (< k (len args))
                  (WriteTo (addr b) (aget args k) false)
                  (inc! k)))
              (case [\% \n] (.WriteByte (addr b) \newline))
              (case [\~] (.WriteByte (addr b) \~))
              (default (.WriteRune (addr b) \~) (.WriteRune (addr b) (aget rs i)))))
          (.WriteRune (addr b) c))))
    (.String b)))

(go/func hasDirectives ^bool [^string s]
  (strings/Contains s "~"))

;; ---------------------------------------------------------------------------------------
;; Chez's report of an uncaught raise

(go/func ConditionMessage
  "ConditionMessage is how Chez reports raised object obj at top level: \"Exception in WHO: MESSAGE\",
the message formatted with the irritants when it has directives, else followed by \"with irritants
(...)\"; a non-condition \"Exception occurred with non-condition value V\"; a warning \"Warning in ...\".\n"
  ^string [^any obj]
  (when (not (IsCondition obj))
    (return (+ "Exception occurred with non-condition value " (WriteValue obj false))))
  (let [head "Exception"
        (values who hasWho) (CondField obj CondWho 0)
        (values msg hasMsg) (CondField obj CondMessage 0)
        (values irr hasIrr) (CondField obj CondIrritants 0)]
    (when (and (== (CondPart obj CondSerious) nil) (!= (CondPart obj CondWarning) nil))
      (set! head "Warning"))
    (when (and hasWho (!= who (conv any false)))
      (set! head (+ head " in " (WriteValue who true))))
    (let [text ""
          (values xs _) (ListSlice irr)]
      (when (not hasIrr)
        (set! xs nil))
      (if hasMsg
        (let [ms (WriteValue msg true)]
          (if (hasDirectives ms)
            (set! text (Format ms xs))
            (do (set! text ms)
                (when (> (len xs) 0)
                  (set! text (+ text " with irritants " (WriteValue irr false)))))))
        (set! text (+ "unknown condition " (WriteValue obj false))))
      (+ head ": " text))))

;; ---------------------------------------------------------------------------------------
;; psyntax's host

(go/func init []
  (DefCtl "symbol-value" 1 1 (fn [^{:tag (* M)} m ^{:tag (slice any)} a] :results [any bool]
    (let [l (.LocOf m (ArgSymbol "symbol-value" (aget a 0)))]
      (when (== (.-V l) (conv any Unbound))
        (Undefined (aget a 0)))
      (return (.-V l) true))))
  (DefCtl "set-symbol-value!" 2 2 (fn [^{:tag (* M)} m ^{:tag (slice any)} a] :results [any bool]
    (set! (.-V (.LocOf m (ArgSymbol "set-symbol-value!" (aget a 0)))) (aget a 1))
    (return Unspec true)))
  (DefCtl "label-binding" 1 1 (fn [^{:tag (* M)} m ^{:tag (slice any)} a] :results [any bool]
    (let [l (aget (.-Store m) (ArgSymbol "label-binding" (aget a 0)))]
      (when (or (== l nil) (== (.-V l) (conv any Unbound)))
        (return false true))
      (return (.-V l) true))))
  (Alias "set-label-binding!" "set-symbol-value!")
  (DefCtl "remove-location" 1 1 (fn [^{:tag (* M)} m ^{:tag (slice any)} a] :results [any bool]
    (delete (.-Store m) (ArgSymbol "remove-location" (aget a 0)))
    (return Unspec true)))
  (DefCtl "set-primitive-locations!" 1 1 (fn [^{:tag (* M)} m ^{:tag (slice any)} a] :results [any bool]
    (.SetPrimLocs m (aget a 0))
    (return Unspec true)))
  (Def1 "read-library-source-file" (fn ^any [^any f]
    (let [name (.String (ArgString "read-library-source-file" f))
          (values text err) (os/ReadFile name)]
      (when (!= err nil)
        (Violation CondIOFileDoesNotExist "read-library-source-file" "failed to open ~s" f))
      (let [xs (ReadAllString (conv string text))]
        (when (== (len xs) 0)
          (return Eof))
        (aget xs 0)))))
  (Def "format" 1 -1 (fn ^any [^{:tag (slice any)} a]
    (let [(values s ok) (assert (* String) (aget a 0))]
      (when ok
        (return (Str (Format (.String s) (subslice a 1)))))
      (when (< (len a) 2)
        (NotA "format" "string" (aget a 0)))
      (let [text (Format (.String (ArgString "format" (aget a 1))) (subslice a 2))]
        (when (== (aget a 0) (conv any false))
          (return (Str text)))
        (WriteString (aget a 0) text)
        Unspec)))))

(go/method Psyntax "Psyntax is psyntax's procedure exported as name (its primitive location's value).\n"
  ^any [^{:tag (* M)} m ^string name]
  (when (== (.-primLocs m) nil)
    (panic "scm: psyntax is not booted"))
  (let [loc (.Call m (.-primLocs m) (Intern name))
        (values s ok) (assert (* Symbol) loc)]
    (when (not ok)
      (panic (+ "scm: psyntax has no " name)))
    (let [l (.LocOf m s)]
      (.-V l))))

(go/method Boot "Boot evaluates psyntax's expanded system: the core forms of psyntax.pp.\n" [^{:tag (* M)} m ^{:tag (slice any)} forms]
  (range [_ f forms]
    (.Eval m f)))

(go/method SetLibraryPath "SetLibraryPath gives psyntax's library-path: the directories its file locator tries.\n"
  [^{:tag (* M)} m ^{:tag (slice string)} dirs]
  (let [^{:tag (slice any)} xs nil]
    (range [_ d dirs]
      (when (not (strings/HasSuffix d "/"))
        (set! d (+ d "/")))
      (set! xs (append xs (Str d))))
    (.Call m (.Psyntax m "library-path") (ListTail xs Null))))

(go/var ^{:tag (func []) :doc "OnRun, when set, is called between a program's expansion and its run (the driver's case mode).\n"} OnRun)

(go/var symLibrary (Intern "library"))

(go/var ^{:tag (func []) :doc "AtExit, when set, runs before the driver exits (a profile's end).\n"} AtExit)

(go/method RunFile
  "RunFile runs the forms of a file: its leading library forms expanded and installed by psyntax (as
the expander's test cases hold them), then the rest as a top-level program.\n"
  ^any [^{:tag (* M)} m ^{:tag (slice any)} forms]
  (let [i 0]
    (while (< i (len forms))
      (let [(values p ok) (assert (* Pair) (aget forms i))]
        (when (or (not ok) (!= (.-Car p) (conv any symLibrary)))
          (break))
        (.Call m (.Psyntax m "library-expander") p)
        (inc! i)))
    (when (== i (len forms))
      (when (!= OnRun nil) (OnRun))
      (return Unspec))
    (.RunProgram m (subslice forms i))))

(go/method RunProgram
  "RunProgram expands the top-level program forms by psyntax, invokes the libraries it needs and
evaluates it.\n"
  ^any [^{:tag (* M)} m ^{:tag (slice any)} forms]
  (let [r (Unpack (.Call m (.Psyntax m "program-expander") (ListTail forms Null)))]
    (when (!= OnRun nil)
      (OnRun))
    (when (< (len r) 2)
      (panic "scm: program-expander gave fewer than two values"))
    (let [(values libs _) (ListSlice (aget r 0))
          inv (.Psyntax m "invoke-library")]
      (range [_ l libs]
        (.Call m inv l))
      (.Eval m (aget r 1)))))

(go/func ConditionData
  "ConditionData is a raised object as one line of data for the expander's tests (the Clojure reader
reads it): its simple conditions' types, who, message, and &syntax's form and subform as written, as
tools/psyntax/run.ss records Chez's.\n"
  ^string [^any obj]
  (when (not (IsCondition obj))
    (return (+ "{:raised " (strconv/Quote (WriteValue obj false)) "}")))
  (let [^strings/Builder b (zero strings/Builder)]
    (.WriteString (addr b) "{:kinds [")
    (range [_ r (SimpleConditions obj)]
      (.WriteString (addr b) (+ (strconv/Quote (.-Name (.-Name (.-RTD r)))) " ")))
    (.WriteString (addr b) "]")
    (let [(values who ok) (CondField obj CondWho 0)]
      (when ok (.WriteString (addr b) (+ " :who " (strconv/Quote (WriteValue who false))))))
    (let [(values msg ok) (CondField obj CondMessage 0)]
      (when ok (.WriteString (addr b) (+ " :message " (strconv/Quote (WriteValue msg true))))))
    (let [(values form ok) (CondField obj CondSyntax 0)]
      (when ok
        (let [(values sub _) (CondField obj CondSyntax 1)]
          (.WriteString (addr b) (+ " :form " (strconv/Quote (WriteValue form false)) " :subform " (strconv/Quote (WriteValue sub false)))))))
    (.WriteString (addr b) "}")
    (.String b)))

(go/var ^{:tag bool :doc "ReportData makes Report print an uncaught raise as ConditionData (the driver's case mode).\n"} ReportData)

(go/func Report
  "Report runs f, the body of a program run: an uncaught raise is reported on stderr as Chez reports it
(status 255), an exit ends with its status; output is flushed. It gives the exit status.\n"
  [^{:tag (func [])} f] :results [^int status]
  (defer ((fn []
            (let [r (recover)]
              (when (!= r nil)
                (type-switch [x r]
                  (case [(* Uncaught)]
                    (FlushAll)
                    (if ReportData
                      (fmt/Fprintln os/Stderr (+ "SI-RAISE " (ConditionData (.-Obj x))))
                      (fmt/Fprintln os/Stderr (ConditionMessage (.-Obj x))))
                    (set! status 255))
                  (case [(* ExitPanic)]
                    (FlushAll)
                    (set! status (.-Code x)))
                  (default (FlushAll) (panic r))))))))
  (f)
  (FlushAll)
  (return 0))

;; si's runtime: characters and strings (R6RS (rnrs base), (rnrs unicode), (rnrs bytevectors)'s string
;; conversions), with Chez Scheme 10.3.0's values, conditions and messages (probed on Chez).
;;
;; Unicode (SCS16 (b), the user 2026-11-09; doc/scheme/SCHEME-SURVEY.md, "As built: SCS15-SCS18"): every table is the
;; Unicode Character Database 16.0.0's, pinned by test/scheme/ucd.edn and generated into unicode.ae by `bin/repr-scheme
;; ucd gen` (arbace.repr.scheme.ucd states the rules): the general categories, the properties (Alphabetic, Numeric,
;; White_Space, Uppercase, Lowercase, Cased, Case_Ignorable), the simple case mappings of UnicodeData.txt, the
;; unconditional full ones of SpecialCasing.txt and the foldings of CaseFolding.txt (SCS12 (c)). Before, the classes and
;; the simple mappings were Go's unicode tables (Unicode 17.0) and the full mappings data recorded from Chez 10.3.0;
;; checked against Chez's answers for every scalar value by test/scheme/unicode/scan.sps (test/scheme/unicode-scan.edn).
;; string-normalize-nfd/nfc/nfkd/nfkc are normalize.ae's (SM6).
(in-ns 'go.arbace.scm)

(go/file "prim_char.go"
  :imports [])

(go/const [wbOther 0] [wbAL 1] [wbNum 2] [wbENL 3] [wbExt 4] [wbMidL 5] [wbMidN 6] [wbMidNL 7])

(go/func dcCategory "dcCategory is the general category name of r (Cn when it has none).\n" ^string [^rune r]
  (Category r))

;; ---------------------------------------------------------------------------------------
;; Classes

(go/func dcAlphabetic ^bool [^rune r] (IsAlphabetic r))

(go/func dcUpperCase ^bool [^rune r] (IsUpperCase r))

(go/func dcLowerCase ^bool [^rune r] (IsLowerCase r))

(go/func dcTitleCase ^bool [^rune r] (== (Category r) "Lt"))

;; dcCased is Unicode's Cased, dcIgnorable its Case_Ignorable (DerivedCoreProperties.txt): the final sigma's context.
(go/func dcCased ^bool [^rune r] (IsCased r))

(go/func dcIgnorable ^bool [^rune r] (IsCaseIgnorable r))

;; dcWB is the word-break class of r (UAX #29, as far as titlecasing needs it).
(go/func dcWB ^int [^rune r]
  (switch r
    (case [0x3A 0xB7 0x387 0x55F 0x5F4 0x2027 0xFE13 0xFE55 0xFF1A] (return wbMidL))
    (case [0x2E 0x27 0x2018 0x2019 0x2024 0xFE52 0xFF07 0xFF0E] (return wbMidNL))
    (case [0x2C 0x3B 0x37E 0x589 0x60C 0x60D 0x66C 0x7F8 0x2044 0xFE10 0xFE14 0xFE50 0xFE54 0xFF0C 0xFF1B] (return wbMidN))
    (case [0x202F] (return wbENL)))
  (let [c (Category r)]
    (when (or (== c "Mn") (== c "Me") (== c "Mc") (== c "Cf"))
      (return wbExt))
    ;; a letter, Nl or Other_Alphabetic: Alphabetic (none of them Nd or Pc)
    (when (IsAlphabetic r)
      (return wbAL))
    (when (== c "Nd")
      (return wbNum))
    (when (== c "Pc")
      (return wbENL)))
  wbOther)

;; ---------------------------------------------------------------------------------------
;; Case mappings

(go/func dcFoldChar ^rune [^rune r] (FoldRune r))

(go/func dcFinalSigma "dcFinalSigma is Unicode's Final_Sigma condition at rs[i].\n" ^bool [^{:tag (slice rune)} rs ^int i]
  (let [before false after false]
    (for [j (- i 1)] (>= j 0) (dec! j)
      (watchdogTick)
      (when (not (dcIgnorable (aget rs j)))
        (set! before (dcCased (aget rs j)))
        (break)))
    (when (not before)
      (return false))
    (for [k (+ i 1)] (< k (len rs)) (inc! k)
      (watchdogTick)
      (when (not (dcIgnorable (aget rs k)))
        (set! after (dcCased (aget rs k)))
        (break)))
    (not after)))

;; dcLowerAt appends the lower case of rs[i] (in its context) to out.
(go/func dcLowerAt ^{:tag (slice rune)} [^{:tag (slice rune)} out ^{:tag (slice rune)} rs ^int i]
  (let [r (aget rs i)]
    (when (== r 0x3A3)
      (if (dcFinalSigma rs i)
        (return (append out 0x3C2))
        (return (append out 0x3C3))))
    (let [(values s ok) (SpecialDowncase r)]
      (when ok
        (return (append out (spread s)))))
    (append out (DowncaseRune r))))

(go/func dcLower ^{:tag (slice rune)} [^{:tag (slice rune)} rs]
  (let [out (make (slice rune) 0 (len rs))]
    (range [i _ rs]
      (set! out (dcLowerAt out rs i)))
    out))

(go/func dcUpper ^{:tag (slice rune)} [^{:tag (slice rune)} rs]
  (let [out (make (slice rune) 0 (len rs))]
    (range [_ r rs]
      (let [(values s ok) (SpecialUpcase r)]
        (if ok
          (set! out (append out (spread s)))
          (set! out (append out (UpcaseRune r))))))
    out))

(go/func dcFoldRunes ^{:tag (slice rune)} [^{:tag (slice rune)} rs] (FoldRunes rs))

;; dcWordEnd is the end of the word of rs that starts at i (UAX #29's rules, without the scripts' exceptions).
(go/func dcWordEnd ^int [^{:tag (slice rune)} rs ^int i]
  (let [n (len rs)
        j (+ i 1)]
    (while (< j n)
      (watchdogTick)
      (let [c (dcWB (aget rs j))]
        (if (or (== c wbAL) (== c wbNum) (== c wbENL) (== c wbExt))
          (inc! j)
          (if (or (== c wbMidL) (== c wbMidN) (== c wbMidNL))
            (let [pc wbOther
                  nc wbOther]
              (for [p (- j 1)] (>= p i) (dec! p)
                (watchdogTick)
                (when (!= (dcWB (aget rs p)) wbExt)
                  (set! pc (dcWB (aget rs p)))
                  (break)))
              (for [q (+ j 1)] (< q n) (inc! q)
                (watchdogTick)
                (when (!= (dcWB (aget rs q)) wbExt)
                  (set! nc (dcWB (aget rs q)))
                  (break)))
              (if (or (and (or (== c wbMidL) (== c wbMidNL)) (== pc wbAL) (== nc wbAL))
                      (and (or (== c wbMidN) (== c wbMidNL)) (== pc wbNum) (== nc wbNum)))
                (inc! j)
                (break)))
            (break)))))
    j))

(go/func dcTitle ^{:tag (slice rune)} [^{:tag (slice rune)} rs]
  (let [out (make (slice rune) 0 (len rs))
        n (len rs)
        i 0]
    (while (< i n)
      (watchdogTick)
      (let [c (dcWB (aget rs i))]
        (if (not (or (== c wbAL) (== c wbNum) (== c wbENL)))
          (do (set! out (append out (aget rs i)))
              (inc! i))
          (let [j (dcWordEnd rs i)
                first true]
            (for [k i] (< k j) (inc! k)
              (watchdogTick)
              (let [r (aget rs k)]
                (if (not (dcCased r))
                  (set! out (append out r))
                  (if first
                    (let [(values s ok) (SpecialTitlecase r)]
                      (set! first false)
                      (if ok
                        (set! out (append out (spread s)))
                        (set! out (append out (TitlecaseRune r)))))
                    (set! out (dcLowerAt out rs k))))))
            (set! i j)))))
    out))

;; ---------------------------------------------------------------------------------------
;; Characters

(go/func dcPred ^{:tag (func [any] [any])} [^string who ^{:tag (func [rune] [bool])} f]
  (fn ^any [^any x]
    (f (conv rune (ArgChar who x)))))

(go/func dcMap ^{:tag (func [any] [any])} [^string who ^{:tag (func [rune] [rune])} f]
  (fn ^any [^any x]
    (conv Char (f (conv rune (ArgChar who x))))))

(go/func dcCharToInteger ^any [^any x]
  (conv int64 (ArgChar "char->integer" x)))

(go/func dcIntegerToChar ^any [^any x]
  (let [(values n ok) (assert int64 x)]
    (when (or (not ok) (< n 0) (> n 0x10FFFF) (and (>= n 0xD800) (<= n 0xDFFF)))
      (Violation CondAssertion "integer->char" "~s is not a valid unicode scalar value" x))
    (conv Char n)))

(go/func dcCharCategory ^any [^any x]
  (Intern (dcCategory (conv rune (ArgChar "char-general-category" x)))))

;; op: 0 =, 1 <, 2 >, 3 <=, 4 >= on the comparison c of two adjacent arguments.
(go/func dcTest ^bool [^int op ^int c]
  (switch op
    (case [0] (return (== c 0)))
    (case [1] (return (< c 0)))
    (case [2] (return (> c 0)))
    (case [3] (return (<= c 0))))
  (>= c 0))

(go/func dcCharCmp ^{:tag (func [(slice any)] [any])} [^string who ^bool fold ^int op]
  (fn ^any [^{:tag (slice any)} a]
    (let [cs (make (slice rune) (len a))]
      (range [i x a]
        (aset cs i (conv rune (ArgChar who x)))
        (when fold
          (aset cs i (dcFoldChar (aget cs i)))))
      (let [r true]
        (for [i 0] (< i (- (len cs) 1)) (inc! i)
          (watchdogTick)
          (let [c 0]
            (cond (< (aget cs i) (aget cs (+ i 1))) (set! c -1)
                  (> (aget cs i) (aget cs (+ i 1))) (set! c 1))
            (when (not (dcTest op c))
              (set! r false))))
        r))))

;; ---------------------------------------------------------------------------------------
;; Strings

(go/func dcMk ^{:tag (* String)} [^{:tag (slice rune)} rs] (addr (lit String :R rs)))

(go/func dcCopy ^{:tag (slice rune)} [^{:tag (slice rune)} rs]
  (let [c (make (slice rune) (len rs))]
    (copy c rs)
    c))

(go/func dcMakeString ^any [^{:tag (slice any)} a]
  (let [n (dvLength "make-string" "string" (aget a 0))
        rs (make (slice rune) n)]
    (when (== (len a) 2)
      (let [c (conv rune (ArgChar "make-string" (aget a 1)))]
        (range [i _ rs]
          (aset rs i c))))
    (dcMk rs)))

(go/func dcString ^any [^{:tag (slice any)} a]
  (let [rs (make (slice rune) (len a))]
    (range [i x a]
      (aset rs i (conv rune (ArgChar "string" x))))
    (dcMk rs)))

(go/func dcStringLength ^any [^any x]
  (conv int64 (len (.-R (ArgString "string-length" x)))))

(go/func dcStringRef ^any [^any x ^any i]
  (let [s (ArgString "string-ref" x)
        k (ArgIndex "string-ref" i s)]
    (when (>= k (len (.-R s)))
      (BadIndex "string-ref" i s))
    (conv Char (aget (.-R s) k))))

(go/func dcStringSet ^any [^any x ^any i ^any c]
  (let [s (ArgMutString "string-set!" x)
        k (ArgIndex "string-set!" i s)]
    (when (>= k (len (.-R s)))
      (BadIndex "string-set!" i s))
    (aset (.-R s) k (conv rune (ArgChar "string-set!" c)))
    Unspec))

;; dcRange checks start/end indices a and b of s.
(go/func dcRange [^string who ^{:tag (* String)} s ^any a ^any b] :results [int int]
  (let [(values i ok1) (assert int64 a)
        (values j ok2) (assert int64 b)]
    (when (or (not ok1) (not ok2) (< i 0) (> i j) (> j (conv int64 (len (.-R s)))))
      (Violation CondAssertion who "~s and ~s are not valid start/end indices for ~s" a b s))
    (return (conv int i) (conv int j))))

(go/func dcSubstring ^any [^any x ^any a ^any b]
  (let [s (ArgString "substring" x)
        (values i j) (dcRange "substring" s a b)]
    (dcMk (dcCopy (subslice (.-R s) i j)))))

(go/func dcStringAppend ^any [^{:tag (slice any)} a]
  (let [out (make (slice rune) 0 0)]
    (range [_ x a]
      (set! out (append out (spread (.-R (ArgString "string-append" x))))))
    (dcMk out)))

(go/func dcStringToList ^any [^any x]
  (let [s (ArgString "string->list" x)
        ^any res Null]
    (for [i (- (len (.-R s)) 1)] (>= i 0) (dec! i)
      (watchdogTick)
      (set! res (Cons (conv Char (aget (.-R s) i)) res)))
    res))

(go/func dcListToString ^any [^any x]
  (let [xs (dlElems "list->string" x)
        rs (make (slice rune) (len xs))]
    (range [i e xs]
      (aset rs i (conv rune (ArgChar "list->string" e))))
    (dcMk rs)))

(go/func dcStringCopy ^any [^any x]
  (dcMk (dcCopy (.-R (ArgString "string-copy" x)))))

(go/func dcStringFill ^any [^any x ^any c]
  (let [s (ArgMutString "string-fill!" x)
        r (conv rune (ArgChar "string-fill!" c))]
    (range [i _ (.-R s)]
      (aset (.-R s) i r))
    Unspec))

(go/func dcCmpRunes ^int [^{:tag (slice rune)} a ^{:tag (slice rune)} b]
  (let [n (min (len a) (len b))]
    (for [i 0] (< i n) (inc! i)
      (watchdogTick)
      (cond (< (aget a i) (aget b i)) (return -1)
            (> (aget a i) (aget b i)) (return 1)))
    (cond (< (len a) (len b)) (return -1)
          (> (len a) (len b)) (return 1))
    0))

(go/func dcStringCmp ^{:tag (func [(slice any)] [any])} [^string who ^bool fold ^int op]
  (fn ^any [^{:tag (slice any)} a]
    (let [ss (make (slice (slice rune)) (len a))]
      (range [i x a]
        (aset ss i (.-R (ArgString who x)))
        (when fold
          (aset ss i (dcFoldRunes (aget ss i)))))
      (let [r true]
        (for [i 0] (< i (- (len ss) 1)) (inc! i)
          (watchdogTick)
          (when (not (dcTest op (dcCmpRunes (aget ss i) (aget ss (+ i 1)))))
            (set! r false)))
        r))))

(go/func dcStringMap ^{:tag (func [any] [any])} [^string who ^{:tag (func [(slice rune)] [(slice rune)])} f]
  (fn ^any [^any x]
    (dcMk (f (.-R (ArgString who x))))))

;; ---------------------------------------------------------------------------------------
;; Strings and bytevectors

(go/func dcBV ^any [^{:tag (slice byte)} b] (addr (lit Bytevector :B b)))

(go/func dcStringToUtf8 ^any [^any x]
  (dcBV (conv (slice byte) (conv string (.-R (ArgString "string->utf8" x))))))

(go/func dcDecode8 ^{:tag (slice rune)} [^{:tag (slice byte)} b]
  (let [out (make (slice rune) 0 (len b))
        n (len b)
        i 0]
    (when (and (>= n 3) (== (aget b 0) 0xEF) (== (aget b 1) 0xBB) (== (aget b 2) 0xBF))
      (set! i 3))
    (while (< i n)
      (watchdogTick)
      (let [c (conv int (aget b i))]
        (cond
          (< c 0x80) (do (set! out (append out (conv rune c))) (inc! i))
          (or (< c 0xC0) (>= c 0xF8)) (do (set! out (append out 0xFFFD)) (inc! i))
          :else
          (let [need 1
                cp (bit-and c 0x1F)]
            (when (>= c 0xE0) (set! need 2) (set! cp (bit-and c 0x0F)))
            (when (>= c 0xF0) (set! need 3) (set! cp (bit-and c 0x07)))
            (let [got 0]
              (while (and (< got need) (< (+ i 1 got) n) (== (bit-and (aget b (+ i 1 got)) 0xC0) 0x80))
                (watchdogTick)
                (set! cp (bit-or (<< cp 6) (conv int (bit-and (aget b (+ i 1 got)) 0x3F))))
                (inc! got))
              (if (< got need)
                (do (set! out (append out 0xFFFD)) (set! i (+ i 1 got)))
                (do
                  (if (or (and (== need 1) (< cp 0x80)) (and (== need 2) (< cp 0x800)) (and (== need 3) (< cp 0x10000))
                          (and (>= cp 0xD800) (<= cp 0xDFFF)) (> cp 0x10FFFF))
                    (set! out (append out 0xFFFD))
                    (set! out (append out (conv rune cp))))
                  (set! i (+ i 1 need)))))))))
    out))

(go/func dcUtf8ToString ^any [^any x]
  (dcMk (dcDecode8 (.-B (ArgBytevector "utf8->string" x)))))

(go/func dcEncode ^{:tag (slice byte)} [^{:tag (slice rune)} rs ^int unit ^bool little]
  (let [out (make (slice byte) 0 (* unit (len rs)))]
    (range [_ r rs]
      (if (and (== unit 2) (>= r 0x10000))
        (let [v (- (conv int r) 0x10000)
              hi (+ 0xD800 (>> v 10))
              lo (+ 0xDC00 (bit-and v 0x3FF))]
          (set! out (dcPutUnit out hi 2 little))
          (set! out (dcPutUnit out lo 2 little)))
        (set! out (dcPutUnit out (conv int r) unit little))))
    out))

(go/func dcPutUnit ^{:tag (slice byte)} [^{:tag (slice byte)} out ^int v ^int unit ^bool little]
  (for [k 0] (< k unit) (inc! k)
    (watchdogTick)
    (if little
      (set! out (append out (conv byte (>> v (* 8 k)))))
      (set! out (append out (conv byte (>> v (* 8 (- unit 1 k))))))))
  out)

(go/func dcStringToUtf16 ^any [^{:tag (slice any)} a]
  (let [s (ArgString "string->utf16" (aget a 0))
        little false]
    (when (== (len a) 2)
      (set! little (dvEndianMsg "string->utf16" "invalid endianness ~s" (aget a 1))))
    (dcBV (dcEncode (.-R s) 2 little))))

(go/func dcStringToUtf32 ^any [^{:tag (slice any)} a]
  (let [s (ArgString "string->utf32" (aget a 0))
        little false]
    (when (== (len a) 2)
      (set! little (dvEndianMsg "string->utf32" "invalid endianness ~s" (aget a 1))))
    (dcBV (dcEncode (.-R s) 4 little))))

(go/func dcUnit ^int [^{:tag (slice byte)} b ^int i ^int unit ^bool little]
  (let [v 0]
    (for [k 0] (< k unit) (inc! k)
      (watchdogTick)
      (if little
        (set! v (bit-or v (<< (conv int (aget b (+ i k))) (* 8 k))))
        (set! v (bit-or (<< v 8) (conv int (aget b (+ i k)))))))
    v))

(go/func dcDecode16 ^{:tag (slice rune)} [^{:tag (slice byte)} b ^bool little ^bool mandatory]
  (let [out (make (slice rune) 0 (/ (len b) 2))
        n (len b)
        i 0]
    (when (and (not mandatory) (>= n 2))
      (cond (and (== (aget b 0) 0xFE) (== (aget b 1) 0xFF)) (do (set! little false) (set! i 2))
            (and (== (aget b 0) 0xFF) (== (aget b 1) 0xFE)) (do (set! little true) (set! i 2))))
    (while (< i n)
      (watchdogTick)
      (if (> (+ i 2) n)
        (do (set! out (append out 0xFFFD))
            (set! i n))
        (let [u (dcUnit b i 2 little)]
          (cond
            (and (>= u 0xD800) (< u 0xDC00))
            (if (> (+ i 4) n)
              (do (set! out (append out 0xFFFD))
                  (set! i (+ i 2)))
              (let [u2 (dcUnit b (+ i 2) 2 little)]
                (if (and (>= u2 0xDC00) (< u2 0xE000))
                  (set! out (append out (conv rune (+ 0x10000 (<< (- u 0xD800) 10) (- u2 0xDC00)))))
                  (set! out (append out 0xFFFD)))
                (set! i (+ i 4))))
            (and (>= u 0xDC00) (< u 0xE000))
            (do (set! out (append out 0xFFFD))
                (set! i (+ i 2)))
            :else
            (do (set! out (append out (conv rune u)))
                (set! i (+ i 2)))))))
    out))

(go/func dcDecode32 ^{:tag (slice rune)} [^{:tag (slice byte)} b ^bool little ^bool mandatory]
  (let [out (make (slice rune) 0 (/ (len b) 4))
        n (len b)
        i 0]
    (when (and (not mandatory) (>= n 4))
      (let [u (dcUnit b 0 4 false)]
        (cond (== u 0xFEFF) (do (set! little false) (set! i 4))
              (== u 0xFFFE0000) (do (set! little true) (set! i 4)))))
    (while (< i n)
      (watchdogTick)
      (if (> (+ i 4) n)
        (do (set! out (append out 0xFFFD))
            (set! i n))
        (let [u (dcUnit b i 4 little)]
          (if (or (> u 0x10FFFF) (and (>= u 0xD800) (<= u 0xDFFF)))
            (set! out (append out 0xFFFD))
            (set! out (append out (conv rune u))))
          (set! i (+ i 4)))))
    out))

(go/func dcMkDecode ^{:tag (func [(slice any)] [any])} [^string who ^bool wide]
  (fn ^any [^{:tag (slice any)} a]
    (let [bv (ArgBytevector who (aget a 0))
          little (dvEndianMsg who "invalid endianness ~s" (aget a 1))
          mandatory false]
      (when (== (len a) 3)
        (set! mandatory (Truthy (aget a 2))))
      (when wide
        (return (dcMk (dcDecode32 (.-B bv) little mandatory))))
      (dcMk (dcDecode16 (.-B bv) little mandatory)))))

(go/func init []
  (Def1 "char?" (inst dlIs Char))
  (Def1 "char->integer" dcCharToInteger)
  (Def1 "integer->char" dcIntegerToChar)
  (Def1 "char-upcase" (dcMap "char-upcase" UpcaseRune))
  (Def1 "char-downcase" (dcMap "char-downcase" DowncaseRune))
  (Def1 "char-titlecase" (dcMap "char-titlecase" TitlecaseRune))
  (Def1 "char-foldcase" (dcMap "char-foldcase" dcFoldChar))
  (Def1 "char-alphabetic?" (dcPred "char-alphabetic?" dcAlphabetic))
  (Def1 "char-numeric?" (dcPred "char-numeric?" IsNumeric))
  (Def1 "char-whitespace?" (dcPred "char-whitespace?" IsWhiteSpaceProp))
  (Def1 "char-upper-case?" (dcPred "char-upper-case?" dcUpperCase))
  (Def1 "char-lower-case?" (dcPred "char-lower-case?" dcLowerCase))
  (Def1 "char-title-case?" (dcPred "char-title-case?" dcTitleCase))
  (Def1 "char-general-category" dcCharCategory)
  (range [op name (lit (slice string) "=?" "<?" ">?" "<=?" ">=?")]
    (Def (+ "char" name) 2 -1 (dcCharCmp (+ "char" name) false op))
    (Def (+ "char-ci" name) 2 -1 (dcCharCmp (+ "char-ci" name) true op))
    (Def (+ "string" name) 2 -1 (dcStringCmp (+ "string" name) false op))
    (Def (+ "string-ci" name) 2 -1 (dcStringCmp (+ "string-ci" name) true op)))
  (Def1 "string?" (inst dlIs (* String)))
  (Def "make-string" 1 2 dcMakeString)
  (Def "string" 0 -1 dcString)
  (Def1 "string-length" dcStringLength)
  (Def2 "string-ref" dcStringRef)
  (Def3 "string-set!" dcStringSet)
  (Def3 "substring" dcSubstring)
  (Def "string-append" 0 -1 dcStringAppend)
  (Def1 "string->list" dcStringToList)
  (Def1 "list->string" dcListToString)
  (Def1 "string-copy" dcStringCopy)
  (Def2 "string-fill!" dcStringFill)
  (Def1 "string-upcase" (dcStringMap "string-upcase" dcUpper))
  (Def1 "string-downcase" (dcStringMap "string-downcase" dcLower))
  (Def1 "string-titlecase" (dcStringMap "string-titlecase" dcTitle))
  (Def1 "string-foldcase" (dcStringMap "string-foldcase" dcFoldRunes))
  (Def1 "string-normalize-nfd" (nmForm "string-normalize-nfd" false false))
  (Def1 "string-normalize-nfc" (nmForm "string-normalize-nfc" false true))
  (Def1 "string-normalize-nfkd" (nmForm "string-normalize-nfkd" true false))
  (Def1 "string-normalize-nfkc" (nmForm "string-normalize-nfkc" true true))
  (Def1 "string->utf8" dcStringToUtf8)
  (Def1 "utf8->string" dcUtf8ToString)
  (Def "string->utf16" 1 2 dcStringToUtf16)
  (Def "string->utf32" 1 2 dcStringToUtf32)
  (Def "utf16->string" 2 3 (dcMkDecode "utf16->string" false))
  (Def "utf32->string" 2 3 (dcMkDecode "utf32->string" true)))

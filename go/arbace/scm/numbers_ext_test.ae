;; SMR4: string->number's extended syntax against Chez's recorded answers (numbers_ext_data_test.ae).
(in-ns 'go.arbace.scm)

(go/file "numbers_ext_test.go" :imports [[testing "testing"] [strings "strings"] [strconv "strconv"]])

(go/func extText ^string [^string s ^int radix ^bool ext]
  (set! s2nOut "")
  (defer ((fn []
            (let [r (recover)]
              (when (!= r nil)
                (set! s2nOut "COMPLEX"))))))
  (let [v (StringToNumberX s radix ext)]
    (when (== v (conv any false))
      (return "#f"))
    (when (isComplex v)
      (return "COMPLEX"))
    (return (NumberToString v 10)))
  "")

(go/func TestStringToNumberExtended [^{:tag (* testing/T)} t]
  (let [^int bad 0]
    (range [_ line (strings/Split extData "\n")]
      (when (!= line "")
        (let [fs (strings/SplitN line "\t" 3)
              (values radix _) (strconv/Atoi (aget fs 0))
              got (extText (aget fs 1) radix true)]
          (when (!= got (aget fs 2))
            (inc! bad)
            (when (< bad 30)
              (.Errorf t "radix %d %q: got %s want %s" radix (aget fs 1) got (aget fs 2)))))))
    (when (> bad 0)
      (.Errorf t "%d mismatches" bad))))

(go/func TestStringToNumberStrictKeepsR6RS [^{:tag (* testing/T)} t]
  (range [_ c (lit (slice (struct ^{:tag string} s ^{:tag string} want))
        (lit _ "1#" "#f") (lit _ "#x1.8" "#f") (lit _ "#12r10" "#f") (lit _ "#b1e1" "#f") (lit _ "1/2e3" "#f") (lit _ "#e1@1" "#f")
        (lit _ "1e2" "100.0") (lit _ "#xff" "255") (lit _ "1.5|53" "1.5"))]
    (let [got (extText (.-s c) 10 false)]
      (when (!= got (.-want c))
        (.Errorf t "%q: got %s want %s" (.-s c) got (.-want c))))))

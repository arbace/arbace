;; si's runtime: cpu-time where getrusage(2) is not (TamaGo's box): the time since the start (clock.ae).
(in-ns 'go.arbace.scm)

(go/file "clock_other.go"
  :build ["//go:build !linux"]
  :imports [[time "time"]])

(go/func cpuNanos "cpuNanos is the time since the start in nanoseconds (no process CPU time here).\n" ^int64 []
  (.Nanoseconds (time/Since start)))

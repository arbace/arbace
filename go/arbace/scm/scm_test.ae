;; si's runtime: unit tests (go test on the printed package, bin/si unit).
(in-ns 'go.arbace.scm)

(go/file "scm_test.go" :imports [[testing "testing"]])

(go/func TestAdd [^{:tag (* testing/T)} t]
  (when (!= (Add (conv int64 2) (conv int64 3)) (conv any (conv int64 5)))
    (.Fatal t "2+3")))

(go/func TestLateConstants
  "TestLateConstants: SC90 (b)'s late constants. Records of a type made while psyntax boots, written as the unit's
graph and built again by ReadLate: one object for each (a mark shared by two records and two constants, a gensym
by its uid), the strings fresh and mutable; a record of a type made outside the boot is refused.\n"
  [^{:tag (* testing/T)} t]
  (BootBegin)
  (let [rtd (NewRTD (Intern "rtd:latetest") nil false false false
                    (lit (slice Field) (lit Field :Name (Intern "a") :Mutable true) (lit Field :Name (Intern "b") :Mutable true)))]
    (BootEnd)
    (let [mark (NewString "m")
          g (addr (lit Symbol :Name "l" :Gensym true :Uid "latetest-uid-1"))
          rec (addr (lit Record :RTD rtd :F (lit (slice any) mark (List mark g))))
          c1 (List rec (conv int64 7))
          c2 (NewVector (lit (slice any) mark rec))
          u (newAotUnit nil)
          i1 (.konst u c1)
          i2 (.konst u c2)]
      (when (!= (.-refused u) "")
        (.Fatal t (.-refused u)))
      (let [K (make (slice any) 2)]
        (ReadLate K (.lateText u))
        (let [(values p1 ok) (assert (* Pair) (aget K i1))]
          (when (not ok)
            (.Fatal t "the first constant is not a pair"))
          (let [(values r ok2) (assert (* Record) (.-Car p1))]
            (when (or (not ok2) (!= (.-RTD r) rtd))
              (.Fatal t "the record's type is not the booted one"))
            (when (== (aget (.-F r) 0) (conv any mark))
              (.Fatal t "the mark is the dumper's object, not one built again"))
            (when (!= (aget (.-F r) 0) (nth (aget (.-F r) 1) 0))
              (.Fatal t "the mark is not one object within the record"))
            (when (.-RO ((inst As (* String)) (aget (.-F r) 0)))
              (.Fatal t "the mark is read-only"))
            (let [(values gs ok3) (assert (* Symbol) (nth (aget (.-F r) 1) 1))]
              (when (or (not ok3) (not (.-Gensym gs)) (!= (.-Uid gs) "latetest-uid-1"))
                (.Fatal t "the gensym is not read back by its uid")))
            (when (!= (nth (aget K i1) 1) (conv any (conv int64 7)))
              (.Fatal t "the fixnum is not read back"))
            (let [(values v ok4) (assert (* Vector) (aget K i2))]
              (when (or (not ok4) (!= (aget (.-V v) 1) (conv any r)) (!= (aget (.-V v) 0) (aget (.-F r) 0)))
                (.Fatal t "the second constant does not share the first's record and mark")))))))
    (let [other (NewRTD (Intern "rtd:latetest") nil false false false (lit (slice Field) (lit Field :Name (Intern "a"))))
          u (newAotUnit nil)]
      (.konst u (List (addr (lit Record :RTD other :F (lit (slice any) false)))))
      (when (== (.-refused u) "")
        (.Fatal t "a record of a type made outside psyntax's boot is not refused")))))

(go/func TestEvalFastPaths
  "TestEvalFastPaths: queue 334's evaluator paths on core forms (no psyntax), each against the value Chez gives: a self
tail loop that takes over its frame (frameSafe, markSelf), or's expansion as an Or, a thunk's application as its body, a
Let with an operand that is not simple (LetK), the closures a loop makes each over its own frame (a body with a lambda
is not frame-safe), (if (not x) ...), and a continuation re-entered into an operand of a call whose callee changed its
parameter: the frame is the callee's own, so the re-entered call sees the operand's value (((1 3) (1 2)), as Chez for a
callee it does not inline; si before queue 334: ((99 3) (1 2))), while into a let's init it sees the set! (((99 3) (1 2)),
as Chez's let and si before).\n"
  [^{:tag (* testing/T)} t]
  (let [cases (lit (slice (slice string))
                (lit (slice string) "(letrec ((loop (lambda (i acc) (if ((primitive =) i '0) acc (loop ((primitive -) i '1) ((primitive +) acc i)))))) (loop '100000 '0))" "5000050000")
                (lit (slice string) "((lambda (t) (if t t 'b)) '#f)" "b")
                (lit (slice string) "((lambda (t) (if t t 'b)) 'a)" "a")
                (lit (slice string) "((case-lambda ((t) (if t t ((primitive list) t)))) '#f)" "(#f)")
                (lit (slice string) "((lambda () '1 '2))" "2")
                (lit (slice string) "(letrec ((f (lambda (x) ((primitive *) x '10)))) ((lambda (a b) ((primitive list) a b)) (f '1) (f '2)))" "(10 20)")
                (lit (slice string) "(letrec ((loop (lambda (i acc) (if ((primitive =) i '0) acc (loop ((primitive -) i '1) ((primitive cons) (lambda () i) acc)))))) ((lambda (l) ((primitive list) ((primitive car) l) ((primitive car) ((primitive cdr) l)))) ((primitive map) (lambda (p) (p)) (loop '3 '()))))" "(1 2)")
                (lit (slice string) "(if ((primitive not) ((primitive null?) '())) 'yes 'no)" "no")
                (lit (slice string) "(letrec ((k '#f) (r '()) (f (lambda (a b) ((lambda (old) (begin (set! a '99) ((primitive list) old b))) a)))) (begin (set! r ((primitive cons) (f '1 ((primitive call-with-current-continuation) (lambda (c) (begin (set! k c) '2)))) r)) (if ((primitive =) ((primitive length) r) '1) (k '3) r)))" "((1 3) (1 2))")
                (lit (slice string) "(letrec ((k '#f) (r '())) (begin (set! r ((primitive cons) ((lambda (a b) ((lambda (old) (begin (set! a '99) ((primitive list) old b))) a)) '1 ((primitive call-with-current-continuation) (lambda (c) (begin (set! k c) '2)))) r)) (if ((primitive =) ((primitive length) r) '1) (k '3) r)))" "((99 3) (1 2))"))]
    (range [_ c cases]
      (let [m (NewM)
            ^any v nil]
        (range [_ f (ReadAllString (aget c 0))]
          (set! v (.Eval m f)))
        (when (!= (WriteValue v false) (aget c 1))
          (.Errorf t "%s: got %s, want %s" (aget c 0) (WriteValue v false) (aget c 1)))))))

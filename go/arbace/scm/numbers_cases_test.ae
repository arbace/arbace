(in-ns 'go.arbace.scm)

(go/file "numbers_cases_test.go" :imports [

    [math "math"]])

(go/var pnCases (lit (slice pnCase)
    (lit _ "+" (lit (slice any) (Intern "a") (conv int64 1)) (pnErr "+" "~s is not a number" (Intern "a")))
    (lit _ "+" (lit (slice any) (conv int64 1) (Intern "a")) (pnErr "+" "~s is not a number" (Intern "a")))
    (lit _ "+" (lit (slice any) (conv int64 1) (conv int64 2) (Intern "a")) (pnErr "+" "~s is not a number" (Intern "a")))

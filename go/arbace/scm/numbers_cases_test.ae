    (lit _ "/" (lit (slice any) (conv int64 2)) (pnOK (pnRatLit "1/2")))
    (lit _ "/" (lit (slice any) (conv int64 1) (conv int64 2) (conv int64 0)) (pnErr "/" "undefined for ~s" (conv int64 0)))

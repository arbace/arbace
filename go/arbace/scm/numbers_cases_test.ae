    (lit _ "-" (lit (slice any) (Intern "a")) (pnErr "-" "~s is not a number" (Intern "a")))
    (lit _ "*" (lit (slice any) (Intern "a") (conv int64 2)) (pnErr "*" "~s is not a number" (Intern "a")))
    (lit _ "/" (lit (slice any) (Intern "a") (conv int64 2)) (pnErr "/" "~s is not a number" (Intern "a")))
    (lit _ "/" (lit (slice any) (conv int64 1) (conv int64 0)) (pnErr "/" "undefined for ~s" (conv int64 0)))
    (lit _ "/" (lit (slice any) (conv float64 1.0) (conv int64 0)) (pnErr "/" "undefined for ~s" (conv int64 0)))

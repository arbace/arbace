;; si's runtime: the process's CPU time on Linux (getrusage(2): user and system), for cpu-time (clock.ae).
(in-ns 'go.arbace.scm)

(go/file "clock_linux.go"
  :build ["//go:build linux"]
  :imports [[syscall "syscall"] [time "time"]])

(go/func cpuNanos "cpuNanos is the process's CPU time (user and system) in nanoseconds.\n" ^int64 []
  (let [^syscall/Rusage ru (lit syscall/Rusage)]
    (when (!= (syscall/Getrusage syscall/RUSAGE_SELF (addr ru)) nil)
      (return (.Nanoseconds (time/Since start))))
    (+ (.Nano (.-Utime ru)) (.Nano (.-Stime ru)))))

;; tests of prim_enum.
(in-ns 'go.arbace.scm)

(go/file "enums_test.go" :imports [[testing "testing"]])

(go/func TestEnums [^{:tag (* testing/T)} t]
  (let [t1 (makeEnumType (lit (slice any) (Intern "c") (Intern "a") (Intern "c") (Intern "b")))
        e (newEnumSet t1)
        s (enumConstruct "x" t1 (List (Intern "c") (Intern "a")))
        u (enumConstruct "x" (makeEnumType (lit (slice any) (Intern "b") (Intern "c"))) (List (Intern "b")))]
    (when (!= (len (.-Syms t1)) 3)
      (.Fatal t "dups"))
    (when (!= (WriteValue (enumList s) false) "(c a)")
      (.Fatal t (WriteValue (enumList s) false)))
    (when (enumSubset s u)
      (.Fatal t "subset across universes"))
    (when (not (enumSubset s (enumConstruct "x" t1 (List (Intern "a") (Intern "c") (Intern "b")))))
      (.Fatal t "subset"))
    (when (!= (.String e) "#<enum-set>")
      (.Fatal t "string"))
    (when (not (.Has (enumConstruct "x" fileOptionsType (List (Intern "no-fail"))) "no-fail"))
      (.Fatal t "file options"))))

(ns go.arbace.emu
  (:require [arbace.go :as go]))

(go/package emu
  :path "arbace/emu"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["as.go" "elf.go" "elfread.go" "kernel.go" "stack.go"]
  :init-order [ErrDynamic errNotELF]
  :positions :lines)

(load "emu/as")
(load "emu/elf")
(load "emu/elfread")
(load "emu/kernel")
(load "emu/stack")

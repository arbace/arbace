(in-ns 'go.arbace.pyctypes) ^{:go/comments [[3 1 "// The limited C API's object protocol, containers and numbers (queue 262; doc/python/PYTHON-SURVEY.md, \"As built:"] [4 1 "// 262\"): natives over the handles, each written after CPython 3.14.10's function of the same name (Objects/object.c,"] [5 1 "// abstract.c, tupleobject.c, listobject.c, dictobject.c, longobject.c, floatobject.c, unicodeobject.c,"] [6 1 "// bytesobject.c, typeobject.c; Python/import.c), its result conventions kept: a new or a borrowed reference as the"] [7 1 "// documentation of the function says, NULL or -1 with the error indicator set. The operations themselves are pyi's"] [8 1 "// (GetAttr, GetItem, Call, ...), so their results and messages are pyi's Python's."] [19 1 "// nullError is abstract.c's null_error."] [22 1 "// objArgs are the arguments a..b as objects, nil for NULL."] [25 1 "// strOf is a C string argument decoded as PyUnicode_FromString decodes it."] [37 1 "// intRes is an int result: v, or -1 with err set."] [55 1 "// seqLen is len(o) (PyObject_Size)."] [75 1 "// hasMethod is whether type(o) defines name (a slot of its type: sq_item and the like)."] [81 1 "// isMapping is a dict (a mapping that is no sequence: PySequence_Check's rule)."] [84 1 "// seqIndex is PySequence_*Item's index: a negative i plus len(o) when o has a length; a still negative index is"] [85 1 "// given to the object below -len, so that its own IndexError is raised (sq_item's of an index out of range)."] [100 1 "// sequenceItem is PySequence_GetItem, SetItem (v non-nil) and DelItem (del)."] [136 1 "// DelItemOf is del o[k]."] [150 1 "// typeQualName is a type's __qualname__ (its name when it has none)."] [161 2 "// constants (Objects/object.c: Py_GetConstant, Py_GetConstantBorrowed; the singletons are immortal, the others"] [162 2 "// pinned once)"] [220 2 "// _Py_Dealloc: an inline Py_DECREF reached 0 (the proxy released when C's entry ends)"] [228 2 "// the object protocol (Objects/object.c, abstract.c)"] [238 2 "// PyObject_Repr and PyObject_Str give __repr__'s and __str__'s result as it is (a str subclass's instance kept);"] [239 2 "// PyObject_ASCII the repr itself when it is ASCII, else its escaped text (Objects/object.c)"] [341 2 "// PyObject_HasAttr, PyObject_HasAttrString: an error other than AttributeError is unraisable, the result 0"] [485 2 "// sequences (Objects/abstract.c)"] [519 2 "// tuples (Objects/tupleobject.c)"] [524 3 "// its items NULL until C sets them, as CPython's (queue 269: the mirror's ob_item, PyTuple_SET_ITEM)"] [560 20 "// NULL a NULL item, as CPython's (queue 269)"] [572 2 "// lists (Objects/listobject.c)"] [602 30 "// NULL a NULL item, as CPython's (queue 269)"] [606 2 "// dicts (Objects/dictobject.c)"] [646 2 "// numbers (Objects/longobject.c, floatobject.c, boolobject.c)"] [676 84 "// PyErr_BadArgument"] [688 2 "// strings (Objects/unicodeobject.c, bytesobject.c)"] [705 2 "// a str's UTF-8 in the world, kept for the str's life as a c_char_p's bytes are (bytesCopy)"] [743 3 "// the interpreter's interned str (queue 525: _decimal's rounding names are _pydecimal's constants)"] [771 36 "// the mirror's ob_sval (queue 269): C may write a new bytes' contents"] [774 2 "// types (Objects/typeobject.c)"] [789 21 "// the type watchers (queue 274)"] [814 2 "// imports (Python/import.c)"] [822 2 "// PyImport_Import (Python/import.c): builtins.__import__(name, None, None, ['__doc__'], 0) (its own TypeError for a"] [823 2 "// name that is no str, ValueError for ''), then sys.modules[name]; NULL is Py_BuildValue's SystemError"] [848 1 "// asciiObject is PyObject_ASCII: the repr as it is when it is all ASCII (a str subclass's instance kept), else its text"] [849 1 "// with the non-ASCII characters escaped as \\xhh, \\uxxxx or \\Uxxxxxxxx (a new str)."] [883 1 "// objectBytes is PyObject_Bytes: a bytes object itself, __bytes__'s result (a bytes subclass's instance kept; anything"] [884 1 "// else a TypeError), else PyBytes_FromObject's."] [906 1 "// bytesFromObject is PyBytes_FromObject (Objects/bytesobject.c): a bytes object itself, a buffer's bytes, else the"] [907 1 "// ints of an iterable that is no str; anything else a TypeError \"cannot convert 'T' object to bytes\" (an int is not"] [908 1 "// bytes(n)'s zeros here)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[152 39] [153 23] [165 20] [222 25] [326 22] [422 38] [437 35] [477 22] [566 20] [566 48] [715 25] [745 23] [788 36] [833 97] [917 31] [918 26] [919 22]]} (go/file "capi_objects.go" :imports [


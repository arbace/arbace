st use."] [1729 1 "// moduleStates are the md_state of the modules PyModule_Create2 made with a positive m_size (queue 269)."] [1732 1 "// checkPositional is _PyArg_CheckPositional (Python/getargs.c): nargs within [min, max], else its TypeError."] [1763 1 "// stringToDouble is _PyOS_ascii_strtod's longest prefix of b that is a float (its value, its length, whether it"] [1764 1 "// overflowed): no leading whitespace."] [1782 1 "// floatPack is PyFloat_Pack2, 4 and 8 (Objects/floatobject.c), little-endian: IEEE half (round half to even, its"] [1783 1 "// OverflowError), single (an OverflowError when a finite value rounds to infinity) and double."] [1797 4 "// the NaN's type and payload's top bits, a quiet NaN when none is left (queue 270)"] [1842 4 "// a NaN's sign and payload kept bit by bit, a signaling one signaling when its payload survives (CPython's"] [1843 4 "// sNaN correction; Go's conversion may quiet it; queue 270)"] [1860 1 "// floatUnpack is PyFloat_Unpack2, 4 and 8 of little-endian bytes."] [1875 4 "// the NaN's type and payload kept (queue 270)"] [1888 4 "// a NaN widened bit by bit: quiet, then signaling again when it was (queue 270)"] [1904 1 "// weakReferent is the referent of a weak reference or proxy r (nil when it is dead); isWeak false when r is neither. A"] [1905 1 "// proxy's referent is reached through the proxy's forwarding (r.__init__.__self__: the referent's bound __init__), a"] [1906 1 "// ReferenceError meaning dead."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[105 20] [108 29] [148 20] [212 13] [212 36] [224 28] [278 39] [290 39] [328 27] [332 24] [336 25] [340 25] [344 30] [348 49] [352 23] [402 29] [453 28] [522 14] [522 21] [523 40] [542 13] [542 31] [639 23] [671 23] [682 33] [687 34] [714 27] [749 22] [761 26] [809 36] [812 28] [822 29] [879 26] [881 31] [910 28] [943 22] [964 33] [986 21] [986 28] [992 22] [992 29] [1007 20] [1008 24] [1019 44] [1026 38] [1027 33] [1034 33] [1035 25] [1045 35] [1046 40] [1070 34] [1071 38] [1072 37] [1073 27] [1136 13] [1136 36] [1140 27] [1150 28] [1157 27] [1165 33] [1171 49] [1213 28] [1249 25] [1276 47] [1281 76] [1295 54] [1354 28] [1360 21] [1397 28] [1412 23] [1413 26] [1420 35] [1421 52] [1445 27] [1486 25] [1527 68] [1537 83] [1564 24] [1565 39] [1623 28] [1623 35] [1633 28] [1633 35] [1648 54] [1766 17] [1766 24] [1775 39] [1898 12] [1898 20] [1924 38] [1933 21]]} (go/file "capi_mirror.go" :imports [

    ;; The full C API's layouts (queue 269; doc/python/PYTHON-SURVEY.md, "As built: 269"; 262's DECISION (a), the user
    ;; 2026-11-10, and 268's DECISION (a), 2026-11-11). Without Py_LIMITED_API, CPython 3.14.10's Include/ reads objects in
    ;; place: Py_TYPE(o)->tp_flags (PyTuple_Check and the other subclass checks), PyList_Type.tp_new, PyTuple_GET_ITEM's
    ;; ob_item, PyList_GET_ITEM's ob_item array, PyBytes_AS_STRING's ob_sval, PyFloat_AS_DOUBLE's ob_fval. So:
    ;;
    ;;   - a type's handle is a PyTypeObject (PyHeapTypeObject's 936 bytes, or the world's static struct of a type
    ;;     Include/ names) filled as CPython's: tp_name, the sizes, tp_flags, tp_base, tp_bases, tp_mro, tp_dict, and its
    ;;     function slots (a type made from a spec its C functions, a pyi type the natives of the generic protocol);
    ;;   - a tuple's, list's, bytes' and float's handle is a mirror: the object's CPython layout in the world's memory,
    ;;     made when C first sees the object and kept in step with the pyi value at the C boundary, both ways (as PyPy's
    ;;     cpyext does): from Go to C before the world is called and when a native returns (the objects it touched), from
    ;;     C to Go when the world returns and when a native receives a mirrored object (its first use in the native). A
    ;;     container's mirror holds references to its items' handles, as CPython's container holds its items: a slot C
    ;;     writes (PyTuple_SET_ITEM, PyList_SET_ITEM) steals the reference C gave, a slot Go changes holds a new one and
    ;;     gives the old one back, and a mirror released gives its items back.
    ;;
    ;; Layouts from Include/cpython/{object,tupleobject,listobject,bytesobject,floatobject}.h (CPython 3.14.10, LP64; the
    ;; PSF's license, LICENSE.md); the slots' offsets are Objects/typeslots.inc's.


    ^{:go/apos {1 [23 2]} :go/pos {:lparen [22 8] :rparen [34 1] :tok-pos [22 1]}} [bytes "bytes"]
    ^{:go/apos {1 [24 2]}} [fmt "fmt"]
    ^{:go/apos {1 [25 2]}} [math "math"]
    ^{:go/apos {1 [26 2]}} [big "math/big"]
    ^{:go/apos {1 [27 2]}} [runtime "runtime"]
    ^{:go/apos {1 [28 2]}} [strconv "strconv"]
    ^{:go/apos {1 [29 2]}} [strings "strings"]

    ^{:go/apos {1 [31 2]}} [ci "arbace/ci"]

    ^{:go/apos {1 [33 4]}} [^{:go/pos {:name-pos [33 2]}} . "arbace/py"]])




stance over a built-in base allocated (bornNew), else the built-in's __new__"] [1273 2 "// slot_tp_new (Objects/typeobject.c): a class's tp_new whose __new__ is its own (classNew), the subtype's __new__"] [1274 2 "// called with the subtype first"] [1300 2 "// tp_dealloc of a pyi type: a C instance's built-in part given back and its memory freed (a pyi object's own"] [1301 2 "// memory is Go's: nothing)"] [1319 2 "// _PyTuple_Resize (Objects/tupleobject.c): *p a tuple only C holds, made newsize long (a new tuple: pyi's are"] [1320 2 "// Go's), the items past the end given back, the new ones NULL"] [1354 2 "// PyState_AddModule: capi_tail.go (modules by index)"] [1355 2 "// PyErr_NewException (Python/errors.c): a class NAME's last part, of base (Exception by default; a tuple of bases"] [1356 2 "// too) and dict, its __module__ NAME's first part"] [1387 2 "// PyObject_CallFunction, PyObject_CallMethod (Objects/call.c): the arguments Py_BuildValue's format makes, a tuple"] [1388 2 "// its items"] [1475 2 "// _PyObject_GC_New (Python/gc.c; the limited API's PyObject_GC_New before 3.8, xxlimited_35's, py-eval-1122): _PyObject_New's"] [1476 2 "// (pyi's collector tracks the object; PyObject_GC_Track and PyObject_GC_Del as before)"] [1499 2 "// PyWeakref_GetRef, PyWeakref_IsDead (Objects/weakrefobject.c) over pyi's references and proxies (PyWeakref_Check:"] [1500 2 "// a ref, a proxy or a callable proxy); the referent, or nil when it is dead"] [1574 21 "// big-endian"] [1592 2 "// PyCFunction_Call (Objects/methodobject.c, the stable ABI's): PyObject_Call"] [1594 2 "// _PyArg_ParseStack (Python/getargs.c): PyArg_ParseTuple's format over a vectorcall's stack (clinic's parsers)"] [1606 2 "// _PyBytes_Resize (Objects/bytesobject.c): *p a bytes only C holds, made newsize long (a new bytes: pyi's value"] [1607 2 "// is Go's; its contents copied from the mirror, which C may have written), NULL and the error on failure"] [1634 1 "// ---- instancemethod (Objects/classobject.c's PyInstanceMethod_Type; queue 269: _testcapi names it) ----"] [1638 1 "// instanceMethod is an instancemethod: its function bound as a method when looked up on an instance."] [1643 1 "// instanceMethodType is instancemethod (instancemethod_new, _call, _descr_get, its __func__), made on first use."] [1681 1 "// moduleStates are the md_state of the modules PyModule_Create2 made with a positive m_size (queue 269)."] [1684 1 "// checkPositional is _PyArg_CheckPositional (Python/getargs.c): nargs within [min, max], else its TypeError."] [1715 1 "// stringToDouble is _PyOS_ascii_strtod's longest prefix of b that is a float (its value, its length, whether it"] [1716 1 "// overflowed): no leading whitespace."] [1734 1 "// floatPack is PyFloat_Pack2, 4 and 8 (Objects/floatobject.c), little-endian: IEEE half (round half to even, its"] [1735 1 "// OverflowError), single (an OverflowError when a finite value rounds to infinity) and double."] [1749 4 "// the NaN's type and payload's top bits, a quiet NaN when none is left (queue 270)"] [1794 4 "// a NaN's sign and payload kept bit by bit, a signaling one signaling when its payload survives (CPython's"] [1795 4 "// sNaN correction; Go's conversion may quiet it; queue 270)"] [1812 1 "// floatUnpack is PyFloat_Unpack2, 4 and 8 of little-endian bytes."] [1827 4 "// the NaN's type and payload kept (queue 270)"] [1840 4 "// a NaN widened bit by bit: quiet, then signaling again when it was (queue 270)"] [1856 1 "// weakReferent is the referent of a weak reference or proxy r (nil when it is dead); isWeak false when r is neither. A"] [1857 1 "// proxy's referent is reached through the proxy's forwarding (r.__init__.__self__: the referent's bound __init__), a"] [1858 1 "// ReferenceError meaning dead."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[106 20] [109 29] [123 20] [187 13] [187 36] [199 28] [253 39] [265 39] [303 27] [307 24] [311 25] [315 25] [319 30] [323 49] [327 23] [377 29] [429 28] [501 13] [501 31] [598 23] [630 23] [641 33] [646 34] [710 22] [722 25] [767 36] [770 28] [780 29] [838 26] [840 31] [869 28] [902 22] [938 21] [938 28] [944 22] [944 29] [959 20] [960 24] [971 44] [978 38] [979 33] [986 33] [987 25] [997 35] [998 40] [1022 34] [1023 38] [1024 37] [1025 27] [1088 13] [1088 36] [1092 27] [1102 28] [1109 27] [1117 33] [1123 49] [1165 28] [1201 25] [1228 47] [1233 76] [1247 54] [1306 28] [1312 21] [1349 28] [1364 23] [1365 26] [1372 35] [1373 52] [1397 27] [1438 25] [1479 68] [1489 83] [1516 24] [1517 39] [1575 28] [1575 35] [1585 28] [1585 35] [1600 54] [1718 17] [1718 24] [1727 39] [1850 12] [1850 20] [1876 38] [1885 21]]} (go/file "capi_mirror.go" :imports [

    ;; The full C API's layouts (queue 269; doc/python/PYTHON-SURVEY.md, "As built: 269"; 262's DECISION (a), the user
    ;; 2026-11-10, and 268's DECISION (a), 2026-11-11). Without Py_LIMITED_API, CPython 3.14.10's Include/ reads objects in
    ;; place: Py_TYPE(o)->tp_flags (PyTuple_Check and the other subclass checks), PyList_Type.tp_new, PyTuple_GET_ITEM's
    ;; ob_item, PyList_GET_ITEM's ob_item array, PyBytes_AS_STRING's ob_sval, PyFloat_AS_DOUBLE's ob_fval. So:
    ;;
    ;;   - a type's handle is a PyTypeObject (PyHeapTypeObject's 936 bytes, or the world's static struct of a type
    ;;     Include/ names) filled as CPython's: tp_name, the sizes, tp_flags, tp_base, tp_bases, tp_mro, tp_dict, and its
    ;;     function slots (a type made from a spec its C functions, a pyi type the natives of the generic protocol);
    ;;   - a tuple's, list's, bytes' and float's handle is a mirror: the object's CPython layout in the world's memory,
    ;;     made when C first sees the object and kept in step with the pyi value at the C boundary, both ways (as PyPy's
    ;;     cpyext does): from Go to C before the world is called and when a native returns (the objects it touched), from
    ;;     C to Go when the world returns and when a native receives a mirrored object (its first use in the native). A
    ;;     container's mirror holds references to its items' handles, as CPython's container holds its items: a slot C
    ;;     writes (PyTuple_SET_ITEM, PyList_SET_ITEM) steals the reference C gave, a slot Go changes holds a new one and
    ;;     gives the old one back, and a mirror released gives its items back.
    ;;
    ;; Layouts from Include/cpython/{object,tupleobject,listobject,bytesobject,floatobject}.h (CPython 3.14.10, LP64; the
    ;; PSF's license, LICENSE.md); the slots' offsets are Objects/typeslots.inc's.


    ^{:go/apos {1 [23 2]} :go/pos {:lparen [22 8] :rparen [34 1] :tok-pos [22 1]}} [bytes "bytes"]
    ^{:go/apos {1 [24 2]}} [fmt "fmt"]
    ^{:go/apos {1 [25 2]}} [math "math"]
    ^{:go/apos {1 [26 2]}} [big "math/big"]
    ^{:go/apos {1 [27 2]}} [runtime "runtime"]
    ^{:go/apos {1 [28 2]}} [strconv "strconv"]
    ^{:go/apos {1 [29 2]}} [strings "strings"]

    ^{:go/apos {1 [31 2]}} [ci "arbace/ci"]

    ^{:go/apos {1 [33 4]}} [^{:go/pos {:name-pos [33 2]}} . "arbace/py"]])




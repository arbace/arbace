71 2 "// (pyi's collector tracks the object; PyObject_GC_Track and PyObject_GC_Del as before)"] [1594 2 "// PyWeakref_GetRef, PyWeakref_IsDead (Objects/weakrefobject.c) over pyi's references and proxies (PyWeakref_Check:"] [1595 2 "// a ref, a proxy or a callable proxy); the referent, or nil when it is dead"] [1669 21 "// big-endian"] [1687 2 "// PyCFunction_Call (Objects/methodobject.c, the stable ABI's): PyObject_Call"] [1689 2 "// _PyArg_ParseStack (Python/getargs.c): PyArg_ParseTuple's format over a vectorcall's stack (clinic's parsers)"] [1701 2 "// _PyBytes_Resize (Objects/bytesobject.c): *p a bytes only C holds, made newsize long (a new bytes: pyi's value"] [1702 2 "// is Go's; its contents copied from the mirror, which C may have written), NULL and the error on failure"] [1729 1 "// ---- instancemethod (Objects/classobject.c's PyInstanceMethod_Type; queue 269: _testcapi names it) ----"] [1733 1 "// instanceMethod is an instancemethod: its function bound as a method when looked up on an instance."] [1738 1 "// instanceMethodType is instancemethod (instancemethod_new, _call, _descr_get, its __func__), made on first use."] [1776 1 "// moduleStates are the md_state of the modules PyModule_Create2 made with a positive m_size (queue 269)."] [1779 1 "// checkPositional is _PyArg_CheckPositional (Python/getargs.c): nargs within [min, max], else its TypeError."] [1810 1 "// stringToDouble is _PyOS_ascii_strtod's longest prefix of b that is a float (its value, its length, whether it"] [1811 1 "// overflowed): no leading whitespace."] [1829 1 "// floatPack is PyFloat_Pack2, 4 and 8 (Objects/floatobject.c), little-endian: IEEE half (round half to even, its"] [1830 1 "// OverflowError), single (an OverflowError when a finite value rounds to infinity) and double."] [1844 4 "// the NaN's type and payload's top bits, a quiet NaN when none is left (queue 270)"] [1889 4 "// a NaN's sign and payload kept bit by bit, a signaling one signaling when its payload survives (CPython's"] [1890 4 "// sNaN correction; Go's conversion may quiet it; queue 270)"] [1907 1 "// floatUnpack is PyFloat_Unpack2, 4 and 8 of little-endian bytes."] [1922 4 "// the NaN's type and payload kept (queue 270)"] [1935 4 "// a NaN widened bit by bit: quiet, then signaling again when it was (queue 270)"] [1951 1 "// weakReferent is the referent of a weak reference or proxy r (nil when it is dead); isWeak false when r is neither. A"] [1952 1 "// proxy's referent is reached through the proxy's forwarding (r.__init__.__self__: the referent's bound __init__), a"] [1953 1 "// ReferenceError meaning dead."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[105 20] [108 29] [148 20] [212 13] [212 36] [224 28] [278 39] [290 39] [328 27] [332 24] [336 25] [340 25] [344 30] [348 49] [352 23] [360 30] [410 29] [455 35] [498 28] [567 14] [567 21] [568 40] [587 13] [587 31] [686 23] [718 23] [729 33] [734 34] [761 27] [796 22] [808 26] [856 36] [859 28] [869 29] [926 26] [928 31] [957 28] [990 22] [1011 33] [1033 21] [1033 28] [1039 22] [1039 29] [1054 20] [1055 24] [1066 44] [1073 38] [1074 33] [1081 33] [1082 25] [1092 35] [1093 40] [1117 34] [1118 38] [1119 37] [1120 27] [1183 13] [1183 36] [1187 27] [1197 28] [1204 27] [1212 33] [1218 49] [1260 28] [1296 25] [1323 47] [1328 76] [1342 54] [1401 28] [1407 21] [1444 28] [1459 23] [1460 26] [1467 35] [1468 52] [1492 27] [1533 25] [1574 68] [1584 83] [1611 24] [1612 39] [1670 28] [1670 35] [1680 28] [1680 35] [1695 54] [1813 17] [1813 24] [1822 39] [1945 12] [1945 20] [1971 38] [1980 21]]} (go/file "capi_mirror.go" :imports [

    ;; The full C API's layouts (queue 269; doc/python/PYTHON-SURVEY.md, "As built: 269"; 262's DECISION (a), the user
    ;; 2026-11-10, and 268's DECISION (a), 2026-11-11). Without Py_LIMITED_API, CPython 3.14.10's Include/ reads objects in
    ;; place: Py_TYPE(o)->tp_flags (PyTuple_Check and the other subclass checks), PyList_Type.tp_new, PyTuple_GET_ITEM's
    ;; ob_item, PyList_GET_ITEM's ob_item array, PyBytes_AS_STRING's ob_sval, PyFloat_AS_DOUBLE's ob_fval. So:
    ;;
    ;;   - a type's handle is a PyTypeObject (PyHeapTypeObject's 936 bytes, or the world's static struct of a type
    ;;     Include/ names) filled as CPython's: tp_name, the sizes, tp_flags, tp_base, tp_bases, tp_mro, tp_dict, and its
    ;;     function slots (a type made from a spec its C functions, a pyi type the natives of the generic protocol);
    ;;   - a tuple's, list's, bytes' and float's handle is a mirror: the object's CPython layout in the world's memory,
    ;;     made when C first sees the object and kept in step with the pyi value at the C boundary, both ways (as PyPy's
    ;;     cpyext does): from Go to C before the world is called and when a native returns (the objects it touched), from
    ;;     C to Go when the world returns and when a native receives a mirrored object (its first use in the native). A
    ;;     container's mirror holds references to its items' handles, as CPython's container holds its items: a slot C
    ;;     writes (PyTuple_SET_ITEM, PyList_SET_ITEM) steals the reference C gave, a slot Go changes holds a new one and
    ;;     gives the old one back, and a mirror released gives its items back.
    ;;
    ;; Layouts from Include/cpython/{object,tupleobject,listobject,bytesobject,floatobject}.h (CPython 3.14.10, LP64; the
    ;; PSF's license, LICENSE.md); the slots' offsets are Objects/typeslots.inc's.


    ^{:go/apos {1 [23 2]} :go/pos {:lparen [22 8] :rparen [34 1] :tok-pos [22 1]}} [bytes "bytes"]
    ^{:go/apos {1 [24 2]}} [fmt "fmt"]
    ^{:go/apos {1 [25 2]}} [math "math"]
    ^{:go/apos {1 [26 2]}} [big "math/big"]
    ^{:go/apos {1 [27 2]}} [runtime "runtime"]
    ^{:go/apos {1 [28 2]}} [strconv "strconv"]
    ^{:go/apos {1 [29 2]}} [strings "strings"]

    ^{:go/apos {1 [31 2]}} [ci "arbace/ci"]

    ^{:go/apos {1 [33 4]}} [^{:go/pos {:name-pos [33 2]}} . "arbace/py"]])




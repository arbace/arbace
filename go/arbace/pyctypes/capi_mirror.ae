(in-ns 'go.arbace.pyctypes) ^{:go/comments [[3 1 "// The full C API's layouts (queue 269; doc/python/PYTHON-SURVEY.md, \"As built: 269\"; 262's DECISION (a), the user"] [4 1 "// 2026-11-10, and 268's DECISION (a), 2026-11-11). Without Py_LIMITED_API, CPython 3.14.10's Include/ reads objects in"] [5 1 "// place: Py_TYPE(o)->tp_flags (PyTuple_Check and the other subclass checks), PyList_Type.tp_new, PyTuple_GET_ITEM's"] [6 1 "// ob_item, PyList_GET_ITEM's ob_item array, PyBytes_AS_STRING's ob_sval, PyFloat_AS_DOUBLE's ob_fval. So:"] [7 1 "//"] [8 1 "//   - a type's handle is a PyTypeObject (PyHeapTypeObject's 936 bytes, or the world's static struct of a type"] [9 1 "//     Include/ names) filled as CPython's: tp_name, the sizes, tp_flags, tp_base, tp_bases, tp_mro, tp_dict, and its"] [10 1 "//     function slots (a type made from a spec its C functions, a pyi type the natives of the generic protocol);"] [11 1 "//   - a tuple's, list's, bytes' and float's handle is a mirror: the object's CPython layout in the world's memory,"] [12 1 "//     made when C first sees the object and kept in step with the pyi value at the C boundary, both ways (as PyPy's"] [13 1 "//     cpyext does): from Go to C before the world is called and when a native returns (the objects it touched), from"] [14 1 "//     C to Go when the world returns and when a native receives a mirrored object (its first use in the native). A"] [15 1 "//     container's mirror holds references to its items' handles, as CPython's container holds its items: a slot C"] [16 1 "//     writes (PyTuple_SET_ITEM, PyList_SET_ITEM) steals the reference C gave, a slot Go changes holds a new one and"] [17 1 "//     gives the old one back, and a mirror released gives its items back."] [18 1 "//"] [19 1 "// Layouts from Include/cpython/{object,tupleobject,listobject,bytesobject,floatobject}.h (CPython 3.14.10, LP64; the"] [20 1 "// PSF's license, LICENSE.md); the slots' offsets are Objects/typeslots.inc's."] [36 1 "// PyTypeObject's and PyHeapTypeObject's fields (offsets, LP64)"] [38 28 "// sizeof(PyHeapTypeObject)"] [70 1 "// slotOffsets is Objects/typeslots.inc (slot id -> the sub-struct's field offset, -1 for none, and the type's field"] [71 1 "// offset), from CPython 3.14.10's headers by gcc (offsetof, LP64)."] [81 1 "// the heap type's own sub-structs (PyHeapTypeObject's as_async, as_number, ...), by the type's field that points"] [82 1 "// at one"] [86 1 "// builtinTpFlags are CPython 3.14.10's tp_flags of the types Include/ names (type.__flags__, python3 3.14.10)."] [102 1 "// typeFlags is t's tp_flags as a C reader sees them: CPython's own for the types Include/ names, a type's made from a"] [103 1 "// spec or by PyType_Ready its own, else the subclass bits, BASETYPE and HEAPTYPE pyi knows, READY, the version tag,"] [104 1 "// IMMUTABLETYPE for a static type, and HAVE_GC for a heap type."] [107 52 "// inherit_special: the base's fast-subclass bits"] [121 1 "// cTpName is tp_name: a C type's own, a heap class's __name__, a static type's module-qualified name outside builtins."] [132 1 "// genericSlots are the natives a pyi type's function slots point at (the generic protocol's functions of the same"] [133 1 "// signature), by slot id: C calling Py_TYPE(o)->tp_repr(o) calls PyObject_Repr."] [139 1 "// fillTypeObject writes t's PyTypeObject at a (its handle: the head is written by the caller; the fields of a"] [140 1 "// PyHeapTypeObject's size, or of a static struct's)."] [170 2 "// the function slots: a C type's own (its spec's or PyType_Ready's, inherited), else the generic natives"] [213 1 "// storeSlot writes the function fn into the slot id of the type object at a (its sub-struct's field when the type"] [214 1 "// has that sub-struct)."] [227 1 "// loadSlot reads the slot id of the type object at a (0: none, or no sub-struct)."] [240 1 "// ---- mirrors ----"] [242 1 "// mirror is the CPython layout of a tuple, list, bytes or float in the world's memory, a handle's."] [244 17 "// 't' tuple, 'l' list, 'b' bytes, 'f' float"] [245 17 "// the pyi object (a subclass's instance too: its built-in part is mirrored)"] [246 17 "// a tuple's or list's slots as last synchronized"] [247 17 "// a bytes' contents as last synchronized"] [248 17 "// the synchronization epoch of the last copy from C"] [252 2 "// held are the references mirrors hold on their items' handles because Go put the item there (a reference C"] [253 2 "// wrote into a slot is C's own): \"C holds the only reference\" (a brand-new object) is a count less these of 1"] [256 28 "// the mirrors a native (or a closure) used: synchronized to C when it returns"] [260 1 "// mirrorKind is the layout o's handle mirrors (0: a proxy's head only) and the bytes it needs."] [288 1 "// longDigits are an int's absolute value in CPython's 30-bit digits, least significant first (none for 0)."] [300 1 "// writeLong writes an int's PyLongObject fields at a (Include/cpython/longintrepr.h, 3.14: lv_tag is the digits'"] [301 1 "// count shifted by 3 with the sign in the low bits, 0 positive, 1 zero, 2 negative; then the digits)."] [319 1 "// asFloatValue is a float's (or a float subclass's instance's) value."] [333 1 "// newMirror writes o's layout at a (its handle, the head written) and records the mirror."] [348 31 "// ob_shash: -1, not computed"] [355 31 "// ob_hash: -1, not computed"] [364 1 "// syncToC writes the pyi value's state into its mirror (the slots Go changed: a new reference to the new item, the"] [365 1 "// old one's given back)."] [432 1 "// syncFromC copies what C wrote into its mirror to the pyi value (the slots C changed; a NULL slot is a nil item, as"] [433 1 "// CPython's NULL until C fills it), and does so for the mirrors its items name, once an epoch."] [503 1 "// holdRef and unholdRef are a mirror's reference to an item Go put in it, and its giving back."] [523 1 "// cOnly reports whether C holds the only reference to the handle h (its count, less the mirrors' own, is 1)."] [526 1 "// rawObj is the object a handle names without synchronizing it (nil for NULL)."] [535 1 "// freeMirror releases a mirror's own memory and its items' references (its handle released)."] [551 1 "// syncAllToC writes every mirror's pyi state into C (before the world is called: Python code may have changed any)."] [558 1 "// syncAllFromC copies every mirror's C state to its pyi value (when the world returns to Python)."] [566 1 "// nativeEnter and nativeLeave bracket a native's (or a closure's) run: what C wrote is copied to Go on the first use"] [567 1 "// of a mirrored object in it (fromHandle), and the mirrors it used are written back to C when it returns."] [588 1 "// touch marks a mirrored handle as used by the running native."] [597 1 "// ---- C types over a built-in base (268's DECISION (a), the user 2026-11-11) ----"] [599 1 "// born is a C type's instance over a built-in base (a type a spec or PyType_Ready made, deriving from list, tuple,"] [600 1 "// bytes or float): its memory is the world's, tp_basicsize bytes (and its items'), the built-in part a mirror of the"] [601 1 "// pyi value at its head, the extension's part C's after the base's size. The Go value is an instance of the type"] [602 1 "// keeping a built-in value, as a Python class deriving from the built-in keeps one; the record rides on it"] [603 1 "// (py.SetInstanceExt). Its memory lives as a C-born object's (queue 268): until Go collects the instance, then its"] [604 1 "// tp_dealloc runs on the world's next entry."] [612 1 "// bornKind is the mirrored layout of t's built-in base (0: none of them)."] [629 1 "// bornOf is o's record when o is a C type's instance over a built-in base (nil: none)."] [637 1 "// bornHandle is such an instance's handle: its memory's address, in the maps again (a count of 0: unowned until the"] [638 1 "// C entry ends; its mirror written from Go, which may have changed it meanwhile) when it had left them."] [653 1 "// bornNew is tp_alloc for a C type over a built-in base: the instance of sub with nitems items (a tuple's or bytes'),"] [654 1 "// a new reference."] [701 1 "// allocObj is tp_alloc's generic allocation of t (PyType_GenericAlloc): a C-born object, an instance over a built-in"] [702 1 "// base, or a type object's memory (type's own tp_alloc: a heap type C fills, then PyType_Ready's)."] [727 1 "// rawTypes are the type objects C allocated through type's tp_alloc, not ready yet."] [730 1 "// bornDealloc is a built-in base's tp_dealloc on a C instance's memory (list_dealloc, tupledealloc ...): its items'"] [731 1 "// references given back as CPython's do, read from its memory, the list's array and the memory freed."] [753 1 "// ---- PyType_Ready for a type object of C's memory (a static PyTypeObject, or one C filled after type's tp_alloc) ----"] [755 1 "// typeReady is PyType_Ready (Objects/typeobject.c, type_ready) of the type object at a: a pyi type made from its"] [756 1 "// fields (NewExtType), its slots the C functions it names and those it inherits, its handle a; the fields"] [757 1 "// PyType_Ready fills written back (tp_base, tp_bases, tp_mro, tp_dict, the inherited slots, Py_TPFLAGS_READY)."] [783 2 "// the base and the bases"] [846 39 "// type_ready_set_new: a static type over object without tp_new"] [848 2 "// inherit_slots: a C base's, else the generic natives of a pyi base"] [865 14 "// pyi's own (the base's slots) unless C's"] [874 2 "// the type's own"] [887 28 "// the base's own __new__ (tp_alloc's allocation through allocObj)"] [895 2 "// the handle is the C memory"] [914 2 "// what PyType_Ready writes back"] [948 2 "// a pyi base's protocol slots C reads in place (Py_TYPE(o)->tp_free, tp_alloc ...)"] [959 1 "// builtinBaseOf is the nearest type of t's MRO that is neither a C type nor a heap class (the built-in whose"] [960 1 "// tp_new and tp_init a C type's instance inherits)."] [970 1 "// callTupleDict calls f with a C call's positional tuple and keywords' dict (NULL: none) after the leading arguments."] [997 1 "// mirrorTable: the natives of the full API's layouts (queue 269)."] [1024 2 "// tp_new of a pyi type: a C type's instance over a built-in base allocated (bornNew), else the built-in's __new__"] [1073 2 "// tp_dealloc of a pyi type: a C instance's built-in part given back and its memory freed (a pyi object's own"] [1074 2 "// memory is Go's: nothing)"] [1092 2 "// _PyTuple_Resize (Objects/tupleobject.c): *p a tuple only C holds, made newsize long (a new tuple: pyi's are"] [1093 2 "// Go's), the items past the end given back, the new ones NULL"] [1128 2 "// PyErr_NewException (Python/errors.c): a class NAME's last part, of base (Exception by default; a tuple of bases"] [1129 2 "// too) and dict, its __module__ NAME's first part"] [1160 2 "// PyObject_CallFunction, PyObject_CallMethod (Objects/call.c): the arguments Py_BuildValue's format makes, a tuple"] [1161 2 "// its items"] [1269 2 "// PyWeakref_GetRef, PyWeakref_IsDead (Objects/weakrefobject.c) over pyi's references (a proxy not provided)"] [1348 21 "// big-endian"] [1366 2 "// PyCFunction_Call (Objects/methodobject.c, the stable ABI's): PyObject_Call"] [1368 2 "// _PyArg_ParseStack (Python/getargs.c): PyArg_ParseTuple's format over a vectorcall's stack (clinic's parsers)"] [1380 2 "// _PyBytes_Resize (Objects/bytesobject.c): *p a bytes only C holds, made newsize long (a new bytes: pyi's value"] [1381 2 "// is Go's; its contents copied from the mirror, which C may have written), NULL and the error on failure"] [1408 1 "// ---- instancemethod (Objects/classobject.c's PyInstanceMethod_Type; queue 269: _testcapi names it) ----"] [1412 1 "// instanceMethod is an instancemethod: its function bound as a method when looked up on an instance."] [1417 1 "// instanceMethodType is instancemethod (instancemethod_new, _call, _descr_get, its __func__), made on first use."] [1455 1 "// moduleStates are the md_state of the modules PyModule_Create2 made with a positive m_size (queue 269)."] [1458 1 "// checkPositional is _PyArg_CheckPositional (Python/getargs.c): nargs within [min, max], else its TypeError."] [1489 1 "// stringToDouble is _PyOS_ascii_strtod's longest prefix of b that is a float (its value, its length, whether it"] [1490 1 "// overflowed): no leading whitespace."] [1508 1 "// floatPack is PyFloat_Pack2, 4 and 8 (Objects/floatobject.c), little-endian: IEEE half (round half to even, its"] [1509 1 "// OverflowError), single (an OverflowError when a finite value rounds to infinity) and double."] [1572 1 "// floatUnpack is PyFloat_Unpack2, 4 and 8 of little-endian bytes."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[106 20] [109 29] [123 20] [176 13] [176 36] [185 28] [222 39] [234 39] [265 27] [269 24] [273 25] [277 30] [281 23] [327 29] [416 13] [416 31] [497 23] [529 23] [541 34] [579 22] [591 25] [631 36] [640 29] [738 21] [738 28] [744 22] [744 29] [759 20] [760 24] [771 44] [777 38] [778 33] [785 33] [786 25] [796 35] [797 40] [821 34] [822 38] [823 37] [824 27] [875 13] [875 36] [879 27] [889 28] [896 27] [904 33] [909 49] [951 28] [987 25] [1014 47] [1019 76] [1033 54] [1079 28] [1085 21] [1122 28] [1137 23] [1138 26] [1145 35] [1146 52] [1170 27] [1211 25] [1249 68] [1259 83] [1284 24] [1349 28] [1349 35] [1359 28] [1359 35] [1374 54] [1492 17] [1492 24] [1501 39] [1596 12] [1596 20]]} (go/file "capi_mirror.go" :imports [

    ;; The full C API's layouts (queue 269; doc/python/PYTHON-SURVEY.md, "As built: 269"; 262's DECISION (a), the user
    ;; 2026-11-10, and 268's DECISION (a), 2026-11-11). Without Py_LIMITED_API, CPython 3.14.10's Include/ reads objects in
    ;; place: Py_TYPE(o)->tp_flags (PyTuple_Check and the other subclass checks), PyList_Type.tp_new, PyTuple_GET_ITEM's
    ;; ob_item, PyList_GET_ITEM's ob_item array, PyBytes_AS_STRING's ob_sval, PyFloat_AS_DOUBLE's ob_fval. So:
    ;;
    ;;   - a type's handle is a PyTypeObject (PyHeapTypeObject's 936 bytes, or the world's static struct of a type
    ;;     Include/ names) filled as CPython's: tp_name, the sizes, tp_flags, tp_base, tp_bases, tp_mro, tp_dict, and its
    ;;     function slots (a type made from a spec its C functions, a pyi type the natives of the generic protocol);
    ;;   - a tuple's, list's, bytes' and float's handle is a mirror: the object's CPython layout in the world's memory,
    ;;     made when C first sees the object and kept in step with the pyi value at the C boundary, both ways (as PyPy's
    ;;     cpyext does): from Go to C before the world is called and when a native returns (the objects it touched), from
    ;;     C to Go when the world returns and when a native receives a mirrored object (its first use in the native). A
    ;;     container's mirror holds references to its items' handles, as CPython's container holds its items: a slot C
    ;;     writes (PyTuple_SET_ITEM, PyList_SET_ITEM) steals the reference C gave, a slot Go changes holds a new one and
    ;;     gives the old one back, and a mirror released gives its items back.
    ;;
    ;; Layouts from Include/cpython/{object,tupleobject,listobject,bytesobject,floatobject}.h (CPython 3.14.10, LP64; the
    ;; PSF's license, LICENSE.md); the slots' offsets are Objects/typeslots.inc's.


    ^{:go/apos {1 [23 2]} :go/pos {:lparen [22 8] :rparen [34 1] :tok-pos [22 1]}} [bytes "bytes"]
    ^{:go/apos {1 [24 2]}} [fmt "fmt"]
    ^{:go/apos {1 [25 2]}} [math "math"]
    ^{:go/apos {1 [26 2]}} [big "math/big"]
    ^{:go/apos {1 [27 2]}} [runtime "runtime"]
    ^{:go/apos {1 [28 2]}} [strconv "strconv"]
    ^{:go/apos {1 [29 2]}} [strings "strings"]

    ^{:go/apos {1 [31 2]}} [ci "arbace/ci"]

    ^{:go/apos {1 [33 4]}} [^{:go/pos {:name-pos [33 2]}} . "arbace/py"]])




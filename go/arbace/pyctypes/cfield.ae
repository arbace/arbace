es object is (bytesCopies)"] [546 1 "// bytesCopies are the world's copies of the bytes objects c_char_p values hold (one per object, for its life)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[87 23] [303 28] [327 26] [355 20] [355 27] [376 20] [376 32] [413 20] [413 30] [550 24]] :go/trails [[189 52]]} (go/file "cfield.go" :imports [


(in-ns 'go.arbace.pyctypes) ^{:go/comments [[3 1 "// The extension modules of the C world (py-capi-1122; the user's decision of 2026-11-22: C extension modules built by ci"] [4 1 "// into pyi's C world and loaded through the import system). A file NAME.arbace-314.so on sys.path (tools/pyi/lib-dynload)"] [5 1 "// is the module's export table: its first line \"pyi-c-world WORLD\", then the PyInit_ (PyInitU_) functions of the world it"] [6 1 "// exports, one a line (\"#\" a comment). _imp.create_dynamic(spec) finds the init function of spec.name's last component in"] [7 1 "// it, as dlsym finds it in a shared object, and runs it as Python/importdl.c and import.c do: a single-phase module given"] [8 1 "// back with its __file__, a multi-phase definition made into the module by PyModule_FromDefAndSpec2's create part"] [9 1 "// (Objects/moduleobject.c), its execution slots run by _imp.exec_dynamic (PyModule_ExecDef). CPython 3.14.10's"] [10 1 "// semantics and messages; the PSF's license (LICENSE.md)."] [22 1 "// dynExecuted are the multi-phase modules whose execution slots ran (exec_dynamic runs them once)."] [25 1 "// importError is ImportError(msg, name=name, path=path)."] [37 1 "// exportTable is the export table of an extension file: the world it names and the init functions it exports."] [56 1 "// initName is the init function's name of a module's last name component: PyInit_NAME, or PyInitU_ and the punycode"] [57 1 "// of a non-ASCII name with '-' as '_' (Python/importdl.c's get_encoded_name)."] [77 1 "// createDynamic is _imp.create_dynamic(spec, file): the module of spec.origin's export table."] [98 73 "// import_find_extension"] [101 21 "// a single-phase module in a subinterpreter that checks (queue 594)"] [146 33 "// ob_type: PyModuleDef_Init never ran on it"] [157 2 "// a single-phase module in a subinterpreter that checks (import_run_extension; queue 594)"] [163 2 "// single-phase: __file__, and the module definition's copy kept for a later load (fix_up_extension)"] [176 1 "// singleEntry is a single-phase module of the extensions cache: its definition and, for m_size -1, a copy of its"] [177 1 "// dictionary a later load gives a new module (import_find_extension's m_copy)."] [186 1 "// reload is a later load of a single-phase module: m_size -1's new module over a copy of the first one's dictionary"] [187 1 "// (nil: the init function runs again)."] [199 1 "// isModuleDef reports a pointer the init function gave as a PyModuleDef (PyModuleDef_Init's: no object of a handle,"] [200 1 "// ob_type PyModuleDef_Type or NULL)."] [208 1 "// moduleFromDefAndSpec2 is PyModule_FromDefAndSpec2 (Objects/moduleobject.c): the slots checked, Py_mod_create's object"] [209 1 "// (or a new module of the spec's name), its state and definition, its functions and doc."] [215 24 "// Py_MOD_MULTIPLE_INTERPRETERS_SUPPORTED when the slot is absent"] [244 2 "// Py_mod_multiple_interpreters (queue 594): NOT_SUPPORTED (0) refused in a subinterpreter that checks, SUPPORTED (1)"] [245 2 "// in one with its own GIL that checks; PER_INTERPRETER_GIL_SUPPORTED (2) anywhere"] [289 45 "// _add_methods_to_object"] [307 1 "// execDynamic is _imp.exec_dynamic(module): a multi-phase module's execution slots, once (PyModule_ExecDef)."] [348 1 "// fromCause is _PyErr_FormatFromCause(SystemError, msg): a SystemError whose __cause__ (and __context__) is err's"] [349 1 "// exception."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[49 30] [98 66] [99 32] [100 57] [104 23] [114 22] [114 30] [137 22] [145 30] [158 31] [159 56] [164 50] [170 68] [193 55] [216 16] [216 24] [246 33] [247 47] [256 23] [270 28] [283 29] [284 29] [285 34] [289 15] [289 33] [293 55] [299 30] [300 74] [323 29] [323 37] [334 23] [355 20]]} (go/file "capi_dynamic.go" :imports [


(in-ns 'go.arbace.pyctypes) ^{:go/comments [[3 1 "// Types made from specs and the objects C makes (queue 268; doc/python/PYTHON-SURVEY.md, \"As built: 268\"; the user's"] [4 1 "// 262 DECISION (a)): PyType_FromMetaclass and its three entries (FromSpec, FromSpecWithBases, FromModuleAndSpec),"] [5 1 "// PyType_GetSlot, the relative offsets of PEP 697 (PyObject_GetTypeData, PyType_GetTypeDataSize, Py_RELATIVE_OFFSET's"] [6 1 "// members), PyType_GenericAlloc and PyType_GenericNew, PyMember_GetOne and PyMember_SetOne, ported from CPython"] [7 1 "// 3.14.10's Objects/typeobject.c and Python/structmember.c (the PSF's license, LICENSE.md)."] [8 1 "//"] [9 1 "// A type made from a spec is a pyi type (NewExtType: static to pyi, its instances of a layout of their own, so a class"] [10 1 "// deriving from it keeps a C-born value as a class deriving from a built-in type does) whose slots call the spec's C"] [11 1 "// functions, and whose methods, members and getsets are descriptors that call C or read the instance's memory. Its"] [12 1 "// instances are C-born: their memory is the world's (tp_basicsize bytes, malloc'd, the PyObject head first), their"] [13 1 "// handle is that memory's address, and their ob_refcnt counts C's references as a proxy's does (world.go). Python's"] [14 1 "// references are Go's: the Go value (cObj) is in the handles' maps while C holds a reference or a C entry is in"] [15 1 "// progress (as a proxy is), and once it is Python's alone and Go collects it, its type's tp_dealloc runs (on the C"] [16 1 "// world's next entry, as cbuf's free): the C memory lives exactly as long as both sides need it."] [30 1 "// tp_flags (Include/object.h)"] [40 1 "// the slots' numbers (Include/typeslots.h)"] [80 23 "// Py_ARRAY_LENGTH(pyslot_offsets)"] [83 1 "// binSlots are the number protocol's binary slots by pyi's operator: the operator's and the in-place one's."] [88 1 "// alignMax is ALIGNOF_MAX_ALIGN_T (tools/pyi/capi/include/pyconfig.h)."] [93 1 "// cType is what PyType_FromMetaclass records of a type made from a spec (CPython's PyHeapTypeObject fields)."] [96 26 "// tp_name: the spec's name"] [99 34 "// tp_flags: the spec's, Py_TPFLAGS_HEAPTYPE"] [100 34 "// the slots the spec gives (pfunc), the inherited ones of a C base added"] [101 34 "// tp_members: the heap type's copy, offsets absolute"] [102 34 "// ht_module"] [103 34 "// ht_token"] [107 24 "// a static PyTypeObject C ready'd (queue 269): its handle is the C struct"] [112 1 "// cTypeOf is the nearest type of t's MRO made from a spec (nil: none)."] [122 1 "// builtinSizes are CPython 3.14's tp_basicsize and tp_itemsize of the built-in types a spec may name as a base (on a"] [123 1 "// 64-bit build), for the relative sizes' arithmetic."] [152 1 "// ---- C-born objects ----"] [154 1 "// cObj is an object whose memory is the world's: its handle is addr. outer is the instance of a class deriving from"] [155 1 "// its type that keeps it (nil: none), the object C's pointer names."] [160 17 "// its finalizer's object: in no cycle (the object and its outer instance make one)"] [165 1 "// deadObjs are the C-born objects Go collected while C held no reference (their life's finalizer's, from the"] [166 1 "// finalizer goroutine): their tp_dealloc runs on the world's next entry (reapDead)."] [177 1 "// newCObj is the Go value of the C-born object at addr (its memory's, of ct's layout), in the handles' maps."] [190 1 "// asCObj is the C-born object o is or keeps (nil: none)."] [206 1 "// cHandle is the handle of a C-born object: its address, in the maps again (a count of 0: unowned until the C entry"] [207 1 "// ends) when it had left them."] [219 1 "// pyOf is the Python object of a C-born object (the instance that keeps it, else itself)."] [227 1 "// reapDead deallocates the C-born objects Go collected (outside any C entry, before the next one)."] [235 13 "// a new object at the same address (cannot be: the memory was not freed) or still C's"] [241 1 "// dealloc is the object's tp_dealloc (its type's, a C base's, else subtype_dealloc's: the dict its memory holds"] [242 1 "// released, the memory freed), run with a Go value in the maps for the natives it calls."] [271 24 "// an instance over a built-in base (queue 269)"] [277 1 "// subtypeDealloc is subtype_dealloc for a C-born object (Objects/typeobject.c): the dict at tp_dictoffset released,"] [278 1 "// the memory freed (tp_free, PyObject_Free); the type is immortal to the handles (its reference left alone)."] [290 1 "// objectFree is PyObject_Free: the memory freed, a C-born object's Go value out of the maps."] [302 1 "// writeUnraisable reports a tp_dealloc's error as CPython's PyErr_WriteUnraisable does."] [305 1 "// genericAlloc is PyType_GenericAlloc (_PyType_AllocNoTrack): basicsize + (nitems+1) * itemsize bytes of the world,"] [306 1 "// zeroed, the head initialized (a new reference: ob_refcnt 1), its ob_size nitems for a variable-size type."] [331 3 "// a class deriving from the C type: the instance keeps the object, its memory names the class"] [337 1 "// ---- calling C ----"] [341 1 "// ccallT calls the C function fn with pointer-sized arguments; its result as ret (TPointer, TSInt32, TSInt64)."] [370 1 "// cEnter brackets a slot's call into C: the error indicator cleared, a missing native's panic its error."] [371 1 "// Usage: defer cExit(cEnter(), &err)."] [390 1 "// objResult is the object a C function returned (a new reference, stolen), or the error it set."] [409 1 "// intResult is an int a C function returned, -1 with the error it set."] [419 1 "// cAddrOf is the handle C gets for o (a C-born object's address)."] [427 1 "// ---- the slots ----"] [429 1 "// slot is the type's slot id: its spec's, a C base's (inherit_slots), else 0."] [440 1 "// fillSlots makes the spec's slots the type's: each pyi slot calls its C function."] [447 27 "// a built-in base's (queue 269): each takes the instance's built-in value"] [609 2 "// tp_new: the spec's (a C base's), else object's (tp_alloc, object_new's checks); tp_init: the spec's"] [672 1 "// argsTupleDict are the positional arguments' tuple and the keywords' dict (nil: none) of a vectorcall's arguments."] [686 1 "// callCObj calls a C-born object: its vectorcall (Py_TPFLAGS_HAVE_VECTORCALL, the function at tp_vectorcall_offset"] [687 1 "// in its memory), else tp_call (Objects/call.c, _PyObject_Vectorcall and _PyObject_MakeTpCall)."] [706 48 "// PY_VECTORCALL_ARGUMENTS_OFFSET"] [717 1 "// ---- PyType_FromMetaclass ----"] [719 1 "// specFrom is PyType_FromMetaclass (Objects/typeobject.c): the type of the PyType_Spec at spec."] [722 2 "// PyType_Spec: name, basicsize (int), itemsize (int), flags (unsigned int), slots"] [752 33 "// Py_RELATIVE_OFFSET"] [792 2 "// the bases (get_bases_tuple)"] [855 2 "// the metaclass: type only (PyType_FromMetaclass's other metaclasses are not provided)"] [863 2 "// best_base: every base must allow subclassing; the first is tp_base"] [874 2 "// the sizes"] [889 2 "// the special offsets (special_offset_from_member)"] [895 36 "// Py_T_PYSSIZET"] [900 11 "// Py_READONLY"] [902 15 "// Py_READONLY | Py_RELATIVE_OFFSET"] [919 2 "// a layout pyi can make: object's, or a type made from a spec, extended"] [922 10 "// object's, a C type's, or (queue 269) a mirrored built-in's"] [940 2 "// inherit_slots: a C base's slots first, then the spec's own"] [966 4 "// the members moved to the heap type, their relative offsets made absolute"] [983 27 "// Py_TP_USE_SPEC is NULL: the spec itself"] [992 2 "// check_basicsize_includes_size_and_offsets (for the generic allocator)"] [1008 2 "// the type's dict: __module__, __doc__, the methods, members and getsets, the sizes"] [1029 1 "// docWithoutSignature is _PyType_DocWithoutSignature: tp_doc less its \"name(sig)\\n--\\n\\n\" signature."] [1042 1 "// addCMethods puts the PyMethodDefs of the table at defs in the type's dict: methods bound to the instance (self"] [1043 1 "// first), class methods (METH_CLASS) and static methods (METH_STATIC); METH_METHOD's get the type as defining_class."] [1053 33 "// METH_STATIC: no self"] [1071 13 "// a slot wrapper's name: the first one stays (METH_COEXIST not set)"] [1078 1 "// addCMembers makes each member of the type's tp_members a member descriptor reading or writing the instance's"] [1079 1 "// memory (PyMember_GetOne, PyMember_SetOne); __dictoffset__ and __weaklistoffset__ are the type's sizes instead."] [1100 31 "// not Py_READONLY"] [1113 1 "// addCGetSets makes each PyGetSetDef (name, get, set, doc, closure) of the table at defs a getset descriptor that"] [1114 1 "// calls C."] [1146 1 "// ---- PyMember_GetOne, PyMember_SetOne (Python/structmember.c) ----"] [1148 1 "// memberGet is PyMember_GetOne for the PyMemberDef at mb over the object at addr."] [1156 11 "// Py_T_BOOL"] [1158 10 "// Py_T_BYTE"] [1160 10 "// Py_T_UBYTE"] [1162 10 "// Py_T_SHORT"] [1164 11 "// Py_T_USHORT"] [1166 10 "// Py_T_INT"] [1168 11 "// Py_T_UINT"] [1170 18 "// Py_T_LONG, Py_T_LONGLONG, Py_T_PYSSIZET"] [1172 15 "// Py_T_ULONG, Py_T_ULONGLONG"] [1174 10 "// Py_T_FLOAT"] [1176 10 "// Py_T_DOUBLE"] [1178 10 "// Py_T_STRING"] [1183 11 "// Py_T_STRING_INPLACE"] [1185 10 "// Py_T_CHAR"] [1187 10 "// _Py_T_OBJECT"] [1192 11 "// Py_T_OBJECT_EX"] [1202 11 "// _Py_T_NONE"] [1216 1 "// memberSet is PyMember_SetOne for the PyMemberDef at mb over the object at addr (v nil: delete)."] [1256 11 "// Py_T_BOOL"] [1266 23 "// Py_T_BYTE, Py_T_UBYTE, Py_T_SHORT, Py_T_USHORT, Py_T_INT"] [1298 11 "// Py_T_UINT"] [1302 14 "// Py_T_LONG, Py_T_LONGLONG"] [1308 15 "// Py_T_ULONG, Py_T_ULONGLONG"] [1317 11 "// Py_T_PYSSIZET"] [1323 13 "// Py_T_FLOAT, Py_T_DOUBLE"] [1333 14 "// _Py_T_OBJECT, Py_T_OBJECT_EX"] [1345 10 "// Py_T_CHAR"] [1351 14 "// Py_T_STRING, Py_T_STRING_INPLACE"] [1359 1 "// ---- the natives ----"] [1361 1 "// nativeAddrs are the addresses of natives C gets as function pointers (PyType_GetSlot's), made once."] [1373 1 "// getSlot is PyType_GetSlot: a type made from a spec its slot (its own or inherited); object's defaults otherwise."] [1381 18 "// a class deriving from it has members of its own (none to C)"] [1538 22 "// PyModule_AddObjectRef's"] [1551 2 "// the dict at tp_dictoffset (Objects/object.c: PyObject_GenericGetDict, PyObject_GenericSetDict)"] [1580 2 "// vectorcall (Objects/call.c)"] [1655 1 "// cDictOf is the dict a C-born object's memory holds at its type's tp_dictoffset (made when make and none yet; nil:"] [1656 1 "// the type has none)."] [1677 2 "// a C-born object's __dict__ for pyi's generic attribute access"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[115 21] [127 20] [139 21] [142 30] [196 42] [209 29] [234 30] [255 30] [270 24] [282 49] [295 35] [378 19] [379 31] [392 19] [412 20] [434 22] [454 27] [457 26] [460 27] [466 34] [471 27] [474 27] [477 31] [491 32] [493 34] [503 35] [509 37] [525 18] [532 31] [539 27] [547 27] [557 27] [567 23] [571 31] [574 28] [577 26] [580 28] [583 31] [586 31] [593 31] [602 31] [619 25] [630 25] [637 29] [692 60] [733 19] [733 21] [748 16] [748 35] [786 44] [789 38] [795 27] [806 25] [820 20] [820 39] [829 27] [850 23] [865 22] [871 24] [882 25] [927 44] [941 24] [960 19] [960 38] [970 14] [970 28] [973 31] [1016 49] [1031 42] [1035 42] [1049 16] [1049 35] [1056 30] [1085 22] [1085 41] [1120 16] [1120 35] [1179 22] [1188 34] [1193 34] [1311 29] [1365 31] [1383 22] [1504 36] [1511 89] [1532 22] [1534 44] [1569 35] [1585 33] [1641 35] [1643 25] [1664 21] [1679 24]]} (go/file "capi_types.go" :imports [

    ;; Types made from specs and the objects C makes (queue 268; doc/python/PYTHON-SURVEY.md, "As built: 268"; the user's
    ;; 262 DECISION (a)): PyType_FromMetaclass and its three entries (FromSpec, FromSpecWithBases, FromModuleAndSpec),
    ;; PyType_GetSlot, the relative offsets of PEP 697 (PyObject_GetTypeData, PyType_GetTypeDataSize, Py_RELATIVE_OFFSET's
    ;; members), PyType_GenericAlloc and PyType_GenericNew, PyMember_GetOne and PyMember_SetOne, ported from CPython
    ;; 3.14.10's Objects/typeobject.c and Python/structmember.c (the PSF's license, LICENSE.md).
    ;;
    ;; A type made from a spec is a pyi type (NewExtType: static to pyi, its instances of a layout of their own, so a class
    ;; deriving from it keeps a C-born value as a class deriving from a built-in type does) whose slots call the spec's C
    ;; functions, and whose methods, members and getsets are descriptors that call C or read the instance's memory. Its
    ;; instances are C-born: their memory is the world's (tp_basicsize bytes, malloc'd, the PyObject head first), their
    ;; handle is that memory's address, and their ob_refcnt counts C's references as a proxy's does (world.go). Python's
    ;; references are Go's: the Go value (cObj) is in the handles' maps while C holds a reference or a C entry is in
    ;; progress (as a proxy is), and once it is Python's alone and Go collects it, its type's tp_dealloc runs (on the C
    ;; world's next entry, as cbuf's free): the C memory lives exactly as long as both sides need it.


    ^{:go/apos {1 [19 2]} :go/pos {:lparen [18 8] :rparen [28 1] :tok-pos [18 1]}} [binary "encoding/binary"]
    ^{:go/apos {1 [20 2]}} [math "math"]
    ^{:go/apos {1 [21 2]}} [big "math/big"]
    ^{:go/apos {1 [22 2]}} [runtime "runtime"]
    ^{:go/apos {1 [23 2]}} [strings "strings"]
    ^{:go/apos {1 [24 2]}} [sync "sync"]

    ^{:go/apos {1 [26 2]}} [ci "arbace/ci"]
    ^{:go/apos {1 [27 4]}} [^{:go/pos {:name-pos [27 2]}} . "arbace/py"]])




    ;; Types made from specs and the objects C makes (queue 268; doc/python/PYTHON-SURVEY.md, "As built: 268"; the user's
    ;; 262 DECISION (a)): PyType_FromMetaclass and its three entries (FromSpec, FromSpecWithBases, FromModuleAndSpec),
    ;; PyType_GetSlot, the relative offsets of PEP 697 (PyObject_GetTypeData, PyType_GetTypeDataSize, Py_RELATIVE_OFFSET's
    ;; members), PyType_GenericAlloc and PyType_GenericNew, PyMember_GetOne and PyMember_SetOne, ported from CPython
    ;; 3.14.10's Objects/typeobject.c and Python/structmember.c (the PSF's license, LICENSE.md).
    ;;
    ;; A type made from a spec is a pyi type (NewExtType: static to pyi, its instances of a layout of their own, so a class
    ;; deriving from it keeps a C-born value as a class deriving from a built-in type does) whose slots call the spec's C
    ;; functions, and whose methods, members and getsets are descriptors that call C or read the instance's memory. Its
    ;; instances are C-born: their memory is the world's (tp_basicsize bytes, malloc'd, the PyObject head first), their
    ;; handle is that memory's address, and their ob_refcnt counts C's references as a proxy's does (world.go). Python's
    ;; references are Go's: the Go value (cObj) is in the handles' maps while C holds a reference or a C entry is in
    ;; progress (as a proxy is), and once it is Python's alone and Go collects it, its type's tp_dealloc runs (on the C
    ;; world's next entry, as cbuf's free): the C memory lives exactly as long as both sides need it.


    ^{:go/apos {1 [19 2]} :go/pos {:lparen [18 8] :rparen [28 1] :tok-pos [18 1]}} [binary "encoding/binary"]
    ^{:go/apos {1 [20 2]}} [math "math"]
    ^{:go/apos {1 [21 2]}} [big "math/big"]
    ^{:go/apos {1 [22 2]}} [runtime "runtime"]
    ^{:go/apos {1 [23 2]}} [strings "strings"]
    ^{:go/apos {1 [24 2]}} [sync "sync"]

    ^{:go/apos {1 [26 2]}} [ci "arbace/ci"]
    ^{:go/apos {1 [27 4]}} [^{:go/pos {:name-pos [27 2]}} . "arbace/py"]])




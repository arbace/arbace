(in-ns 'go.arbace.pyctypes) ^{:go/comments [[3 1 "// Types made from specs and the objects C makes (queue 268; doc/python/PYTHON-SURVEY.md, \"As built: 268\"; the user's"] [4 1 "// 262 DECISION (a)): PyType_FromMetaclass and its three entries (FromSpec, FromSpecWithBases, FromModuleAndSpec),"] [5 1 "// PyType_GetSlot, the relative offsets of PEP 697 (PyObject_GetTypeData, PyType_GetTypeDataSize, Py_RELATIVE_OFFSET's"] [6 1 "// members), PyType_GenericAlloc and PyType_GenericNew, PyMember_GetOne and PyMember_SetOne, ported from CPython"] [7 1 "// 3.14.10's Objects/typeobject.c and Python/structmember.c (the PSF's license, LICENSE.md)."] [8 1 "//"] [9 1 "// A type made from a spec is a pyi type (NewExtType: static to pyi, its instances of a layout of their own, so a class"] [10 1 "// deriving from it keeps a C-born value as a class deriving from a built-in type does) whose slots call the spec's C"] [11 1 "// functions, and whose methods, members and getsets are descriptors that call C or read the instance's memory. Its"] [12 1 "// instances are C-born: their memory is the world's (tp_basicsize bytes, malloc'd, the PyObject head first), their"] [13 1 "// handle is that memory's address, and their ob_refcnt counts C's references as a proxy's does (world.go). Python's"] [14 1 "// references are Go's: the Go value (cObj) is in the handles' maps while C holds a reference or a C entry is in"] [15 1 "// progress (as a proxy is), and once it is Python's alone and Go collects it, its type's tp_dealloc runs (on the C"] [16 1 "// world's next entry, as cbuf's free): the C memory lives exactly as long as both sides need it."] [30 1 "// tp_flags (Include/object.h)"] [42 1 "// fullyQualifiedName is _PyType_GetFullyQualifiedName (PyErr_Format's %N): module.qualname, the module left out for"] [43 1 "// builtins and __main__ (queue 270b)."] [53 1 "// metaCustomNew is a metaclass's tp_new other than type's (PyType_FromMetaclass refuses it, queue 270b): a C type's"] [54 1 "// own tp_new, or a Python metaclass's __new__, below type in its MRO."] [73 1 "// the slots' numbers (Include/typeslots.h)"] [113 23 "// Py_ARRAY_LENGTH(pyslot_offsets)"] [116 1 "// binSlots are the number protocol's binary slots by pyi's operator: the operator's and the in-place one's."] [121 1 "// alignMax is ALIGNOF_MAX_ALIGN_T (tools/pyi/capi/include/pyconfig.h)."] [126 1 "// cType is what PyType_FromMetaclass records of a type made from a spec (CPython's PyHeapTypeObject fields)."] [129 26 "// tp_name: the spec's name"] [132 34 "// tp_flags: the spec's, Py_TPFLAGS_HEAPTYPE"] [133 34 "// the slots the spec gives (pfunc), the inherited ones of a C base added"] [134 34 "// tp_members: the heap type's copy, offsets absolute"] [135 34 "// ht_module"] [136 34 "// ht_token"] [140 26 "// a static PyTypeObject C ready'd (queue 269): its handle is the C struct"] [141 26 "// the signature tp_doc begins with (queue 270b: __text_signature__), \"\" for none"] [142 26 "// tp_doc as the spec gave it (queue 270b), hasDoc whether it gave one"] [148 1 "// cTypeOf is the nearest type of t's MRO made from a spec (nil: none)."] [158 1 "// builtinSizes are CPython 3.14's tp_basicsize and tp_itemsize of the built-in types a spec may name as a base (on a"] [159 1 "// 64-bit build), for the relative sizes' arithmetic."] [188 1 "// ---- C-born objects ----"] [190 1 "// cObj is an object whose memory is the world's: its handle is addr. outer is the instance of a class deriving from"] [191 1 "// its type that keeps it (nil: none), the object C's pointer names."] [196 17 "// its finalizer's object: in no cycle (the object and its outer instance make one)"] [197 17 "// its managed dict (Py_TPFLAGS_MANAGED_DICT, queue 270b), made on first use"] [202 1 "// deadObjs are the C-born objects Go collected while C held no reference (their life's finalizer's, from the"] [203 1 "// finalizer goroutine): their tp_dealloc runs on the world's next entry (reapDead)."] [214 1 "// newCObj is the Go value of the C-born object at addr (its memory's, of ct's layout), in the handles' maps."] [227 1 "// asCObj is the C-born object o is or keeps (nil: none)."] [243 1 "// cHandle is the handle of a C-born object: its address, in the maps again (a count of 0: unowned until the C entry"] [244 1 "// ends) when it had left them."] [256 1 "// pyOf is the Python object of a C-born object (the instance that keeps it, else itself)."] [264 1 "// reapDead deallocates the C-born objects Go collected (outside any C entry, before the next one)."] [272 13 "// a new object at the same address (cannot be: the memory was not freed) or still C's"] [278 1 "// dealloc is the object's tp_dealloc (its type's, a C base's, else subtype_dealloc's: the dict its memory holds"] [279 1 "// released, the memory freed), run with a Go value in the maps for the natives it calls."] [308 24 "// an instance over a built-in base (queue 269)"] [314 1 "// subtypeDealloc is subtype_dealloc for a C-born object (Objects/typeobject.c): the dict at tp_dictoffset released,"] [315 1 "// the memory freed (tp_free, PyObject_Free); the type is immortal to the handles (its reference left alone)."] [327 1 "// objectFree is PyObject_Free: the memory freed, a C-born object's Go value out of the maps."] [339 1 "// writeUnraisable reports a tp_dealloc's error as CPython's PyErr_WriteUnraisable does."] [342 1 "// genericAlloc is PyType_GenericAlloc (_PyType_AllocNoTrack): basicsize + (nitems+1) * itemsize bytes of the world,"] [343 1 "// zeroed, the head initialized (a new reference: ob_refcnt 1), its ob_size nitems for a variable-size type."] [368 3 "// a class deriving from the C type: the instance keeps the object, its memory names the class"] [374 1 "// ---- calling C ----"] [378 1 "// ccallT calls the C function fn with pointer-sized arguments; its result as ret (TPointer, TSInt32, TSInt64)."] [407 1 "// cEnter brackets a slot's call into C: the error indicator cleared, a missing native's panic its error."] [408 1 "// Usage: defer cExit(cEnter(), &err)."] [427 1 "// objResult is the object a C function returned (a new reference, stolen), or the error it set."] [446 1 "// intResult is an int a C function returned, -1 with the error it set."] [456 1 "// cAddrOf is the handle C gets for o (a C-born object's address)."] [464 1 "// ---- the slots ----"] [466 1 "// slot is the type's slot id: its spec's, a C base's (inherit_slots), else 0."] [477 1 "// fillSlots makes the spec's slots the type's: each pyi slot calls its C function."] [481 39 "// a metaclass (queue 270b): its instances are pyi types, not wrapped values"] [485 27 "// a built-in base's (queue 269): each takes the instance's built-in value"] [647 2 "// tp_new: the spec's (a C base's), else object's (tp_alloc, object_new's checks); tp_init: the spec's"] [650 3 "// type's own __new__ (the metaclass's instances made by type_new), unless instantiation is disallowed"] [701 4 "// the base's __new__ makes the built-in value from the arguments (queue 270b), its memory C's"] [733 1 "// argsTupleDict are the positional arguments' tuple and the keywords' dict (nil: none) of a vectorcall's arguments."] [747 1 "// callCObj calls a C-born object: its vectorcall (Py_TPFLAGS_HAVE_VECTORCALL, the function at tp_vectorcall_offset"] [748 1 "// in its memory), else tp_call (Objects/call.c, _PyObject_Vectorcall and _PyObject_MakeTpCall)."] [767 48 "// PY_VECTORCALL_ARGUMENTS_OFFSET"] [778 1 "// ---- PyType_FromMetaclass ----"] [780 1 "// specFrom is PyType_FromMetaclass (Objects/typeobject.c): the type of the PyType_Spec at spec."] [783 2 "// PyType_Spec: name, basicsize (int), itemsize (int), flags (unsigned int), slots"] [813 33 "// Py_RELATIVE_OFFSET"] [853 2 "// the bases (get_bases_tuple)"] [916 2 "// the metaclass (_PyType_CalculateMetaclass over the bases; queue 270b: a metaclass other than type, a C one made"] [917 2 "// from a spec over type or a Python one, whose instances are pyi types with their Meta)"] [938 2 "// best_base: every base must allow subclassing; the first is tp_base"] [949 2 "// the sizes"] [964 2 "// inherit_special (queue 270b): the base's itemsize and Py_TPFLAGS_ITEMS_AT_END"] [971 2 "// the special offsets (special_offset_from_member)"] [977 36 "// Py_T_PYSSIZET"] [982 11 "// Py_READONLY"] [984 15 "// Py_READONLY | Py_RELATIVE_OFFSET"] [1001 2 "// a layout pyi can make: object's, or a type made from a spec, extended"] [1005 18 "// a Python class (queue 270b): its instances' layout is its base's, with a managed dict"] [1009 10 "// object's, a C type's, (queue 269) a mirrored built-in's, or (queue 270b) type's, int's, an exception's"] [1026 18 "// queue 270b: Py_SET_TYPE(res, metaclass)"] [1031 2 "// the managed dict and weak references (Py_TPFLAGS_MANAGED_DICT, MANAGED_WEAKREF): the spec's, a C base's, and a"] [1032 2 "// Python class's (queue 270b)"] [1043 2 "// inherit_slots: a C base's slots first, then the spec's own"] [1069 4 "// the members moved to the heap type, their relative offsets made absolute"] [1084 17 "// Py_TP_USE_SPEC is NULL: the spec itself (queue 270b)"] [1093 2 "// check_basicsize_includes_size_and_offsets (for the generic allocator)"] [1109 2 "// the type's dict: __module__, __doc__, the methods, members and getsets, the sizes"] [1132 1 "// textSignature is _PyType_GetTextSignatureFromInternalDoc: the \"(sig)\" of a tp_doc that begins with \"name(sig)\\n--\\n\\n\""] [1133 1 "// (\"\" for none)."] [1146 1 "// docWithoutSignature is _PyType_DocWithoutSignature: tp_doc less its \"name(sig)\\n--\\n\\n\" signature."] [1159 1 "// addCMethods puts the PyMethodDefs of the table at defs in the type's dict: methods bound to the instance (self"] [1160 1 "// first), class methods (METH_CLASS) and static methods (METH_STATIC); METH_METHOD's get the type as defining_class."] [1170 33 "// METH_STATIC: no self"] [1188 13 "// a slot wrapper's name: the first one stays (METH_COEXIST not set)"] [1195 1 "// addCMembers makes each member of the type's tp_members a member descriptor reading or writing the instance's"] [1196 1 "// memory (PyMember_GetOne, PyMember_SetOne); __dictoffset__ and __weaklistoffset__ are the type's sizes instead."] [1217 31 "// not Py_READONLY"] [1230 1 "// addCGetSets makes each PyGetSetDef (name, get, set, doc, closure) of the table at defs a getset descriptor that"] [1231 1 "// calls C."] [1263 1 "// ---- PyMember_GetOne, PyMember_SetOne (Python/structmember.c) ----"] [1265 1 "// memberGet is PyMember_GetOne for the PyMemberDef at mb over the object at addr."] [1273 11 "// Py_T_BOOL"] [1275 10 "// Py_T_BYTE"] [1277 10 "// Py_T_UBYTE"] [1279 10 "// Py_T_SHORT"] [1281 11 "// Py_T_USHORT"] [1283 10 "// Py_T_INT"] [1285 11 "// Py_T_UINT"] [1287 18 "// Py_T_LONG, Py_T_LONGLONG, Py_T_PYSSIZET"] [1289 15 "// Py_T_ULONG, Py_T_ULONGLONG"] [1291 10 "// Py_T_FLOAT"] [1293 10 "// Py_T_DOUBLE"] [1295 10 "// Py_T_STRING"] [1300 11 "// Py_T_STRING_INPLACE"] [1302 10 "// Py_T_CHAR"] [1304 10 "// _Py_T_OBJECT"] [1309 11 "// Py_T_OBJECT_EX"] [1319 11 "// _Py_T_NONE"] [1333 1 "// memberSet is PyMember_SetOne for the PyMemberDef at mb over the object at addr (v nil: delete)."] [1373 11 "// Py_T_BOOL"] [1383 23 "// Py_T_BYTE, Py_T_UBYTE, Py_T_SHORT, Py_T_USHORT, Py_T_INT"] [1415 11 "// Py_T_UINT"] [1419 14 "// Py_T_LONG, Py_T_LONGLONG"] [1425 15 "// Py_T_ULONG, Py_T_ULONGLONG"] [1434 11 "// Py_T_PYSSIZET"] [1440 13 "// Py_T_FLOAT, Py_T_DOUBLE"] [1450 14 "// _Py_T_OBJECT, Py_T_OBJECT_EX"] [1462 10 "// Py_T_CHAR"] [1468 14 "// Py_T_STRING, Py_T_STRING_INPLACE"] [1476 1 "// ---- the natives ----"] [1478 1 "// nativeAddrs are the addresses of natives C gets as function pointers (PyType_GetSlot's), made once."] [1490 1 "// getSlot is PyType_GetSlot: a type made from a spec its slot (its own or inherited); object's defaults otherwise."] [1497 25 "// ht_token: the type's own (queue 270b)"] [1504 18 "// a class deriving from it has members of its own (none to C)"] [1510 2 "// the type object's own field (queue 270b: Py_tp_base, a static type's slots as its struct holds them, as CPython's"] [1511 2 "// PyType_GetSlot reads them)"] [1657 4 "// a static type not ready yet: PyModule_AddType readies it (queue 270b: docstring.c's types)"] [1674 22 "// PyModule_AddObjectRef's"] [1687 2 "// the dict at tp_dictoffset (Objects/object.c: PyObject_GenericGetDict, PyObject_GenericSetDict)"] [1725 2 "// vectorcall (Objects/call.c)"] [1795 3 "// a C-born object's own vectorcall at tp_vectorcall_offset (queue 270b: not its type's tp_call again, which a"] [1796 3 "// class deriving from it overrides; PyVectorcall_Call is that tp_call: test_call's MethodDescriptorSuper recursed)"] [1813 1 "// cDictOf is the dict a C-born object's memory holds at its type's tp_dictoffset (made when make and none yet; nil:"] [1814 1 "// the type has none)."] [1821 3 "// the managed dict (queue 270b): Go's, beside the C memory"] [1844 1 "// cDictPtr is _PyObject_ComputedDictPointer: the address of a C-born object's dict at its type's tp_dictoffset, a"] [1845 1 "// negative one counted from the object's end (its basicsize and items; queue 270b)."] [1866 2 "// a C-born object's __dict__ for pyi's generic attribute access"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[60 21] [151 21] [163 20] [175 21] [178 30] [233 42] [246 29] [271 30] [292 30] [307 24] [318 49] [319 22] [332 35] [415 19] [416 31] [429 19] [449 20] [471 22] [492 27] [495 26] [498 27] [504 34] [509 27] [512 27] [515 31] [529 32] [531 34] [541 35] [547 37] [563 18] [570 31] [577 27] [585 27] [595 27] [605 23] [609 31] [612 28] [615 26] [618 28] [621 31] [624 31] [631 31] [640 31] [675 25] [686 25] [693 29] [753 60] [794 19] [794 21] [809 16] [809 35] [847 44] [850 38] [856 27] [867 25] [881 20] [881 39] [890 27] [927 24] [940 22] [946 24] [957 25] [968 24] [1014 44] [1034 23] [1044 24] [1063 19] [1063 38] [1073 14] [1073 28] [1076 31] [1119 49] [1135 42] [1139 42] [1148 42] [1152 42] [1166 16] [1166 35] [1173 30] [1202 22] [1202 41] [1237 16] [1237 35] [1296 22] [1305 34] [1310 34] [1428 29] [1482 31] [1496 21] [1506 22] [1513 34] [1634 36] [1641 89] [1658 39] [1668 22] [1670 44] [1730 33] [1786 35] [1788 25] [1797 20] [1832 21] [1868 24]]} (go/file "capi_types.go" :imports [

    ;; Types made from specs and the objects C makes (queue 268; doc/python/PYTHON-SURVEY.md, "As built: 268"; the user's
    ;; 262 DECISION (a)): PyType_FromMetaclass and its three entries (FromSpec, FromSpecWithBases, FromModuleAndSpec),
    ;; PyType_GetSlot, the relative offsets of PEP 697 (PyObject_GetTypeData, PyType_GetTypeDataSize, Py_RELATIVE_OFFSET's
    ;; members), PyType_GenericAlloc and PyType_GenericNew, PyMember_GetOne and PyMember_SetOne, ported from CPython
    ;; 3.14.10's Objects/typeobject.c and Python/structmember.c (the PSF's license, LICENSE.md).
    ;;
    ;; A type made from a spec is a pyi type (NewExtType: static to pyi, its instances of a layout of their own, so a class
    ;; deriving from it keeps a C-born value as a class deriving from a built-in type does) whose slots call the spec's C
    ;; functions, and whose methods, members and getsets are descriptors that call C or read the instance's memory. Its
    ;; instances are C-born: their memory is the world's (tp_basicsize bytes, malloc'd, the PyObject head first), their
    ;; handle is that memory's address, and their ob_refcnt counts C's references as a proxy's does (world.go). Python's
    ;; references are Go's: the Go value (cObj) is in the handles' maps while C holds a reference or a C entry is in
    ;; progress (as a proxy is), and once it is Python's alone and Go collects it, its type's tp_dealloc runs (on the C
    ;; world's next entry, as cbuf's free): the C memory lives exactly as long as both sides need it.


    ^{:go/apos {1 [19 2]} :go/pos {:lparen [18 8] :rparen [28 1] :tok-pos [18 1]}} [binary "encoding/binary"]
    ^{:go/apos {1 [20 2]}} [math "math"]
    ^{:go/apos {1 [21 2]}} [big "math/big"]
    ^{:go/apos {1 [22 2]}} [runtime "runtime"]
    ^{:go/apos {1 [23 2]}} [strings "strings"]
    ^{:go/apos {1 [24 2]}} [sync "sync"]

    ^{:go/apos {1 [26 2]}} [ci "arbace/ci"]
    ^{:go/apos {1 [27 4]}} [^{:go/pos {:name-pos [27 2]}} . "arbace/py"]])




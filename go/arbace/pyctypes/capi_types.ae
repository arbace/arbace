(in-ns 'go.arbace.pyctypes) ^{:go/comments [[3 1 "// Types made from specs and the objects C makes (queue 268; doc/python/PYTHON-SURVEY.md, \"As built: 268\"; the user's"] [4 1 "// 262 DECISION (a)): PyType_FromMetaclass and its three entries (FromSpec, FromSpecWithBases, FromModuleAndSpec),"] [5 1 "// PyType_GetSlot, the relative offsets of PEP 697 (PyObject_GetTypeData, PyType_GetTypeDataSize, Py_RELATIVE_OFFSET's"] [6 1 "// members), PyType_GenericAlloc and PyType_GenericNew, PyMember_GetOne and PyMember_SetOne, ported from CPython"] [7 1 "// 3.14.10's Objects/typeobject.c and Python/structmember.c (the PSF's license, LICENSE.md)."] [8 1 "//"] [9 1 "// A type made from a spec is a pyi type (NewExtType: static to pyi, its instances of a layout of their own, so a class"] [10 1 "// deriving from it keeps a C-born value as a class deriving from a built-in type does) whose slots call the spec's C"] [11 1 "// functions, and whose methods, members and getsets are descriptors that call C or read the instance's memory. Its"] [12 1 "// instances are C-born: their memory is the world's (tp_basicsize bytes, malloc'd, the PyObject head first), their"] [13 1 "// handle is that memory's address, and their ob_refcnt counts C's references as a proxy's does (world.go). Python's"] [14 1 "// references are Go's: the Go value (cObj) is in the handles' maps while C holds a reference or a C entry is in"] [15 1 "// progress (as a proxy is), and once it is Python's alone and Go collects it, its type's tp_dealloc runs (on the C"] [16 1 "// world's next entry, as cbuf's free): the C memory lives exactly as long as both sides need it."] [30 1 "// tp_flags (Include/object.h)"] [40 1 "// the slots' numbers (Include/typeslots.h)"] [80 23 "// Py_ARRAY_LENGTH(pyslot_offsets)"] [83 1 "// binSlots are the number protocol's binary slots by pyi's operator: the operator's and the in-place one's."] [88 1 "// alignMax is ALIGNOF_MAX_ALIGN_T (tools/pyi/capi/include/pyconfig.h)."] [93 1 "// cType is what PyType_FromMetaclass records of a type made from a spec (CPython's PyHeapTypeObject fields)."] [96 26 "// tp_name: the spec's name"] [99 34 "// tp_flags: the spec's, Py_TPFLAGS_HEAPTYPE"] [100 34 "// the slots the spec gives (pfunc), the inherited ones of a C base added"] [101 34 "// tp_members: the heap type's copy, offsets absolute"] [102 34 "// ht_module"] [103 34 "// ht_token"] [111 1 "// cTypeOf is the nearest type of t's MRO made from a spec (nil: none)."] [121 1 "// builtinSizes are CPython 3.14's tp_basicsize and tp_itemsize of the built-in types a spec may name as a base (on a"] [122 1 "// 64-bit build), for the relative sizes' arithmetic."] [151 1 "// ---- C-born objects ----"] [153 1 "// cObj is an object whose memory is the world's: its handle is addr. outer is the instance of a class deriving from"] [154 1 "// its type that keeps it (nil: none), the object C's pointer names."] [159 17 "// its finalizer's object: in no cycle (the object and its outer instance make one)"] [164 1 "// deadObjs are the C-born objects Go collected while C held no reference (their life's finalizer's, from the"] [165 1 "// finalizer goroutine): their tp_dealloc runs on the world's next entry (reapDead)."] [176 1 "// newCObj is the Go value of the C-born object at addr (its memory's, of ct's layout), in the handles' maps."] [189 1 "// asCObj is the C-born object o is or keeps (nil: none)."] [205 1 "// cHandle is the handle of a C-born object: its address, in the maps again (a count of 0: unowned until the C entry"] [206 1 "// ends) when it had left them."] [218 1 "// pyOf is the Python object of a C-born object (the instance that keeps it, else itself)."] [226 1 "// reapDead deallocates the C-born objects Go collected (outside any C entry, before the next one)."] [234 13 "// a new object at the same address (cannot be: the memory was not freed) or still C's"] [240 1 "// dealloc is the object's tp_dealloc (its type's, a C base's, else subtype_dealloc's: the dict its memory holds"] [241 1 "// released, the memory freed), run with a Go value in the maps for the natives it calls."] [272 1 "// subtypeDealloc is subtype_dealloc for a C-born object (Objects/typeobject.c): the dict at tp_dictoffset released,"] [273 1 "// the memory freed (tp_free, PyObject_Free); the type is immortal to the handles (its reference left alone)."] [285 1 "// objectFree is PyObject_Free: the memory freed, a C-born object's Go value out of the maps."] [297 1 "// writeUnraisable reports a tp_dealloc's error as CPython's PyErr_WriteUnraisable does."] [300 1 "// genericAlloc is PyType_GenericAlloc (_PyType_AllocNoTrack): basicsize + (nitems+1) * itemsize bytes of the world,"] [301 1 "// zeroed, the head initialized (a new reference: ob_refcnt 1), its ob_size nitems for a variable-size type."] [326 3 "// a class deriving from the C type: the instance keeps the object, its memory names the class"] [332 1 "// ---- calling C ----"] [336 1 "// ccallT calls the C function fn with pointer-sized arguments; its result as ret (TPointer, TSInt32, TSInt64)."] [365 1 "// cEnter brackets a slot's call into C: the error indicator cleared, a missing native's panic its error."] [366 1 "// Usage: defer cExit(cEnter(), &err)."] [385 1 "// objResult is the object a C function returned (a new reference, stolen), or the error it set."] [404 1 "// intResult is an int a C function returned, -1 with the error it set."] [414 1 "// cAddrOf is the handle C gets for o (a C-born object's address)."] [422 1 "// ---- the slots ----"] [424 1 "// slot is the type's slot id: its spec's, a C base's (inherit_slots), else 0."] [435 1 "// fillSlots makes the spec's slots the type's: each pyi slot calls its C function."] [602 2 "// tp_new: the spec's (a C base's), else object's (tp_alloc, object_new's checks); tp_init: the spec's"] [657 1 "// argsTupleDict are the positional arguments' tuple and the keywords' dict (nil: none) of a vectorcall's arguments."] [671 1 "// callCObj calls a C-born object: its vectorcall (Py_TPFLAGS_HAVE_VECTORCALL, the function at tp_vectorcall_offset"] [672 1 "// in its memory), else tp_call (Objects/call.c, _PyObject_Vectorcall and _PyObject_MakeTpCall)."] [691 48 "// PY_VECTORCALL_ARGUMENTS_OFFSET"] [702 1 "// ---- PyType_FromMetaclass ----"] [704 1 "// specFrom is PyType_FromMetaclass (Objects/typeobject.c): the type of the PyType_Spec at spec."] [707 2 "// PyType_Spec: name, basicsize (int), itemsize (int), flags (unsigned int), slots"] [737 33 "// Py_RELATIVE_OFFSET"] [777 2 "// the bases (get_bases_tuple)"] [840 2 "// the metaclass: type only (PyType_FromMetaclass's other metaclasses are not provided)"] [848 2 "// best_base: every base must allow subclassing; the first is tp_base"] [859 2 "// the sizes"] [874 2 "// the special offsets (special_offset_from_member)"] [880 36 "// Py_T_PYSSIZET"] [885 11 "// Py_READONLY"] [887 15 "// Py_READONLY | Py_RELATIVE_OFFSET"] [904 2 "// a layout pyi can make: object's, or a type made from a spec, extended"] [925 2 "// inherit_slots: a C base's slots first, then the spec's own"] [951 4 "// the members moved to the heap type, their relative offsets made absolute"] [968 27 "// Py_TP_USE_SPEC is NULL: the spec itself"] [977 2 "// check_basicsize_includes_size_and_offsets (for the generic allocator)"] [993 2 "// the type's dict: __module__, __doc__, the methods, members and getsets, the sizes"] [1014 1 "// docWithoutSignature is _PyType_DocWithoutSignature: tp_doc less its \"name(sig)\\n--\\n\\n\" signature."] [1027 1 "// addCMethods puts the PyMethodDefs of the table at defs in the type's dict: methods bound to the instance (self"] [1028 1 "// first), class methods (METH_CLASS) and static methods (METH_STATIC); METH_METHOD's get the type as defining_class."] [1038 33 "// METH_STATIC: no self"] [1056 13 "// a slot wrapper's name: the first one stays (METH_COEXIST not set)"] [1063 1 "// addCMembers makes each member of the type's tp_members a member descriptor reading or writing the instance's"] [1064 1 "// memory (PyMember_GetOne, PyMember_SetOne); __dictoffset__ and __weaklistoffset__ are the type's sizes instead."] [1085 31 "// not Py_READONLY"] [1098 1 "// addCGetSets makes each PyGetSetDef (name, get, set, doc, closure) of the table at defs a getset descriptor that"] [1099 1 "// calls C."] [1131 1 "// ---- PyMember_GetOne, PyMember_SetOne (Python/structmember.c) ----"] [1133 1 "// memberGet is PyMember_GetOne for the PyMemberDef at mb over the object at addr."] [1141 11 "// Py_T_BOOL"] [1143 10 "// Py_T_BYTE"] [1145 10 "// Py_T_UBYTE"] [1147 10 "// Py_T_SHORT"] [1149 11 "// Py_T_USHORT"] [1151 10 "// Py_T_INT"] [1153 11 "// Py_T_UINT"] [1155 18 "// Py_T_LONG, Py_T_LONGLONG, Py_T_PYSSIZET"] [1157 15 "// Py_T_ULONG, Py_T_ULONGLONG"] [1159 10 "// Py_T_FLOAT"] [1161 10 "// Py_T_DOUBLE"] [1163 10 "// Py_T_STRING"] [1168 11 "// Py_T_STRING_INPLACE"] [1170 10 "// Py_T_CHAR"] [1172 10 "// _Py_T_OBJECT"] [1177 11 "// Py_T_OBJECT_EX"] [1187 11 "// _Py_T_NONE"] [1201 1 "// memberSet is PyMember_SetOne for the PyMemberDef at mb over the object at addr (v nil: delete)."] [1241 11 "// Py_T_BOOL"] [1251 23 "// Py_T_BYTE, Py_T_UBYTE, Py_T_SHORT, Py_T_USHORT, Py_T_INT"] [1283 11 "// Py_T_UINT"] [1287 14 "// Py_T_LONG, Py_T_LONGLONG"] [1293 15 "// Py_T_ULONG, Py_T_ULONGLONG"] [1302 11 "// Py_T_PYSSIZET"] [1308 13 "// Py_T_FLOAT, Py_T_DOUBLE"] [1318 14 "// _Py_T_OBJECT, Py_T_OBJECT_EX"] [1330 10 "// Py_T_CHAR"] [1336 14 "// Py_T_STRING, Py_T_STRING_INPLACE"] [1344 1 "// ---- the natives ----"] [1346 1 "// nativeAddrs are the addresses of natives C gets as function pointers (PyType_GetSlot's), made once."] [1358 1 "// getSlot is PyType_GetSlot: a type made from a spec its slot (its own or inherited); object's defaults otherwise."] [1366 18 "// a class deriving from it has members of its own (none to C)"] [1523 22 "// PyModule_AddObjectRef's"] [1536 2 "// the dict at tp_dictoffset (Objects/object.c: PyObject_GenericGetDict, PyObject_GenericSetDict)"] [1565 2 "// vectorcall (Objects/call.c)"] [1640 1 "// cDictOf is the dict a C-born object's memory holds at its type's tp_dictoffset (made when make and none yet; nil:"] [1641 1 "// the type has none)."] [1662 2 "// a C-born object's __dict__ for pyi's generic attribute access"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[114 21] [126 20] [138 21] [141 30] [195 42] [208 29] [233 30] [254 30] [277 49] [290 35] [373 19] [374 31] [387 19] [407 20] [429 22] [447 27] [450 26] [453 27] [459 34] [464 27] [467 27] [470 31] [484 32] [486 34] [496 35] [502 37] [518 18] [525 31] [532 27] [540 27] [550 27] [560 23] [564 31] [567 28] [570 26] [573 28] [576 31] [579 31] [586 31] [595 31] [612 25] [623 25] [630 29] [677 60] [718 19] [718 21] [733 16] [733 35] [771 44] [774 38] [780 27] [791 25] [805 20] [805 39] [814 27] [835 23] [850 22] [856 24] [867 25] [912 44] [926 24] [945 19] [945 38] [955 14] [955 28] [958 31] [1001 49] [1016 42] [1020 42] [1034 16] [1034 35] [1041 30] [1070 22] [1070 41] [1105 16] [1105 35] [1164 22] [1173 34] [1178 34] [1296 29] [1350 31] [1368 22] [1489 36] [1496 89] [1517 22] [1519 44] [1554 35] [1570 33] [1626 35] [1628 25] [1649 21] [1664 24]]} (go/file "capi_types.go" :imports [

    ;; Types made from specs and the objects C makes (queue 268; doc/python/PYTHON-SURVEY.md, "As built: 268"; the user's
    ;; 262 DECISION (a)): PyType_FromMetaclass and its three entries (FromSpec, FromSpecWithBases, FromModuleAndSpec),
    ;; PyType_GetSlot, the relative offsets of PEP 697 (PyObject_GetTypeData, PyType_GetTypeDataSize, Py_RELATIVE_OFFSET's
    ;; members), PyType_GenericAlloc and PyType_GenericNew, PyMember_GetOne and PyMember_SetOne, ported from CPython
    ;; 3.14.10's Objects/typeobject.c and Python/structmember.c (the PSF's license, LICENSE.md).
    ;;
    ;; A type made from a spec is a pyi type (NewExtType: static to pyi, its instances of a layout of their own, so a class
    ;; deriving from it keeps a C-born value as a class deriving from a built-in type does) whose slots call the spec's C
    ;; functions, and whose methods, members and getsets are descriptors that call C or read the instance's memory. Its
    ;; instances are C-born: their memory is the world's (tp_basicsize bytes, malloc'd, the PyObject head first), their
    ;; handle is that memory's address, and their ob_refcnt counts C's references as a proxy's does (world.go). Python's
    ;; references are Go's: the Go value (cObj) is in the handles' maps while C holds a reference or a C entry is in
    ;; progress (as a proxy is), and once it is Python's alone and Go collects it, its type's tp_dealloc runs (on the C
    ;; world's next entry, as cbuf's free): the C memory lives exactly as long as both sides need it.


    ^{:go/apos {1 [19 2]} :go/pos {:lparen [18 8] :rparen [28 1] :tok-pos [18 1]}} [binary "encoding/binary"]
    ^{:go/apos {1 [20 2]}} [math "math"]
    ^{:go/apos {1 [21 2]}} [big "math/big"]
    ^{:go/apos {1 [22 2]}} [runtime "runtime"]
    ^{:go/apos {1 [23 2]}} [strings "strings"]
    ^{:go/apos {1 [24 2]}} [sync "sync"]

    ^{:go/apos {1 [26 2]}} [ci "arbace/ci"]
    ^{:go/apos {1 [27 4]}} [^{:go/pos {:name-pos [27 2]}} . "arbace/py"]])




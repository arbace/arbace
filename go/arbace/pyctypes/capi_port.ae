endian digits"] [550 2 "// PyType_Freeze (Objects/typeobject.c): Py_TPFLAGS_IMMUTABLETYPE set, every other type of the MRO immutable already"] [567 2 "// ---- Python/import.c: PyImport_ExecCodeModule and its variants (module_dict_for_exec, _fix_up_module, the code"] [568 2 "// run in the module's dict) ----"] [663 2 "// ---- Objects/frameobject.c ----"] [706 2 "// ---- Objects/fileobject.c: PyFile_FromFd, _io.open(fd, mode, buffering, encoding, errors, newline, closefd) ----"] [725 2 "// ---- Objects/unicodeobject.c, Objects/bytesobject.c: the charmap codec, the FS converter, escapes ----"] [775 22 "// Py_CLEANUP_SUPPORTED"] [789 2 "// ---- Python/pyhash.c: PyHash_GetFuncDef, a static PyHash_FuncDef {hash, name, hash_bits, seed_bits} ----"] [802 2 "// ---- Objects/codeobject.c: PyCode_NewEmpty(filename, funcname, firstlineno) ----"] [820 3 "// co_firstlineno is left (pyi's code.replace refuses it: its code is its IR; a Low of queue 270b)"] [823 2 "// ---- Modules/gcmodule.c: PyGC_Enable, Disable (the previous state), IsEnabled, over the gc module ----"] [848 2 "// ---- Python/pythonrun.c: PyRun_String, PyRun_SimpleString, Py_CompileString and their Flags variants, over"] [849 2 "// compile(), exec() and eval() ----"] [863 26 "// PyCF_IGNORE_COOKIE: the bytes are UTF-8 whatever their coding cookie says"] [876 73 "// run_eval_code_obj's"] [903 3 "// PyErr_Print: sys.excepthook(type, value, traceback)"] [939 2 "// ---- Objects/abstract.c: the number protocol's rest ----"] [964 2 "// ---- Objects/bytearrayobject.c ----"] [971 42 "// ob_start (the mirror's storage, queue 270)"] [976 1 "// littleEndianFlag is _resolve_endianness: -1 or Py_ASNATIVEBYTES_NATIVE_ENDIAN's bit is the platform's (little), else"] [977 1 "// the low bit."] [980 1 "// fitsInBits is _fits_in_n_bits: v in [-2^(b-1), 2^(b-1))."] [989 1 "// asNativeBytes is PyLong_AsNativeBytes (Objects/longobject.c, 3.14.10): v written into the n bytes at buf as two's"] [990 1 "// complement (truncated), the bytes it
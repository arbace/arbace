(in-ns 'go.arbace.pyctypes) ^{:go/comments [[3 1 "// The stable ABI's symbols (queue 598): CPython 3.14.10's Misc/stable_abi.toml, its functions and data less the ones"] [4 1 "// under an ifdef (the list Lib/test/test_stable_abi_ctypes.py's SYMBOL_NAMES holds, generated from the same file by"] [5 1 "// Tools/build/stable_abi.py), so that pythonapi finds each, as the shared libpython exports them. A function pyi gives"] [6 1 "// no native for is the world's missingNative (NotImplementedError \"pyi's C API does not provide NAME\" when called), as an"] [7 1 "// undefined function the world's own C references (bindMissing); a data symbol is made on its first lookup"] [8 1 "// (stableData). The PSF's license (LICENSE.md)."] [16 1 "// stableFuncNames and stableDataNames: Misc/stable_abi.toml's [function.NAME] and [data.NAME] entries without ifdef."] [26 2 "// the entries under an ifdef pyi's configuration defines (tools/pyi/capi/include/pyconfig.h's HAVE_FORK; Linux's"] [27 2 "// PY_HAVE_THREAD_NATIVE_ID, Include/pythread.h), as SYMBOL_NAMES adds them by _testcapi.get_feature_macros()"] [203 1 "// stableTypes are the stable ABI's type objects the world may not reference, by the Python expression whose value is"] [204 1 "// each (CPython's static types; pyi's types the same objects Python code sees)."] [232 1 "// stableObjs are the addresses stableSymbolAddr made for the objects of stableTypes (each object's handle, pinned)."] [235 1 "// stableSymbolAddr is the address of a stable ABI symbol that neither the world nor capiNatives defines, 0 for a name of"] [236 1 "// no stable ABI entry (or one whose value cannot be made): a function a missingNative; an object of stableTypes its"] [237 1 "// handle (a PyTypeObject or a singleton's struct is the symbol itself); a PyExc_ name a cell holding the exception"] [238 1 "// type's handle (PyAPI_DATA(PyObject *)); the other data as CPython 3.14.10 defines them on Linux."] [257 34 "// Objects/moduleobject.c's \"moduledef\", the type of the definitions PyModuleDef_Init makes objects"] [291 32 "// Objects/object.c: {Py_GT, Py_GE, Py_EQ, Py_NE, Py_LT, Py_LE}"] [297 47 "// Python/fileutils.c's, set from the configuration at start"] [305 50 "// 0: the two strings above are the runtime's, not static"] [315 29 "// PY_VERSION_HEX of 3.14.10 final"] [319 33 "// no input hook: NULL"] [321 48 "// Objects/structseq.c"] [329 1 "// moduleDefType is PyModuleDef_Type when the world does not define it (queue 598)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[250 30] [253 22] [262 34]] :go/trails [[229 72]]} (go/file "capi_stable.go" :imports [

    ;; The stable ABI's symbols (queue 598): CPython 3.14.10's Misc/stable_abi.toml, its functions and data less the ones
    ;; under an ifdef (the list Lib/test/test_stable_abi_ctypes.py's SYMBOL_NAMES holds, generated from the same file by
    ;; Tools/build/stable_abi.py), so that pythonapi finds each, as the shared libpython exports them. A function pyi gives
    ;; no native for is the world's missingNative (NotImplementedError "pyi's C API does not provide NAME" when called), as an
    ;; undefined function the world's own C references (bindMissing); a data symbol is made on its first lookup
    ;; (stableData). The PSF's license (LICENSE.md).


    ^{:go/apos {1 [11 2]} :go/pos {:lparen [10 8] :rparen [14 1] :tok-pos [10 1]}} [strings "strings"]

    ^{:go/apos {1 [13 4]}} [^{:go/pos {:name-pos [13 2]}} . "arbace/py"]])




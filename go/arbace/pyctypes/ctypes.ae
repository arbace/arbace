(in-ns 'go.arbace.pyctypes) ^{:go/comments [[3 1 "// Modules/_ctypes/_ctypes.c and stgdict.c: Copyright (c) the Python Software Foundation, under the PSF License"] [4 1 "// Agreement for Python 3.14 (LICENSE.md). The port to Go: Copyright (c) the Arbace authors, under the same license."] [5 1 "//"] [6 1 "// The module _ctypes (queue 244; doc/python/PYTHON-SURVEY.md, \"As built: 244\"; the user's 244-1 (a)): CPython"] [7 1 "// 3.14.10's types ported over pyi's objects, their memory the C world's (world.go), libffi's part ffi.go over ci."] [8 1 "// How the C maps onto Go here:"] [9 1 "//"] [10 1 "//   - CDataObject is CData, a built-in value of one of the five base types (_SimpleCData, Structure, Union, Array,"] [11 1 "//     _Pointer, CFuncPtr); a Python class deriving from one (c_int, a Structure subclass) holds it in its instance"] [12 1 "//     (pyi's built-in subclass wrapper). b_ptr is an address of the world; b_objects, b_base, b_index, b_length,"] [13 1 "//     b_size are CPython's."] [14 1 "//   - StgInfo (stgdict.c) is kept per class in a table (stgs): CPython keeps it in the type object."] [15 1 "//   - The metatypes PyCSimpleType, PyCStructType, UnionType, PyCArrayType, PyCPointerType, PyCFuncPtrType are"] [16 1 "//     built-in subclasses of type: their __new__ makes the class by type.__new__ and then its StgInfo, as their"] [17 1 "//     tp_new and tp_init do; CDataType's methods (from_address, from_buffer, from_buffer_copy, from_param, in_dll,"] [18 1 "//     __mul__) are theirs."] [19 1 "//   - Structures are laid out by Lib/ctypes/_layout.py (3.14's), which makes the CField objects."] [31 1 "// StgInfo is stgdict.c's StgInfo."] [36 21 "// a simple type's _type_ (a str), an array's or a pointer's item type"] [40 23 "// a function pointer type's"] [49 18 "// simpleKind, structKind, ..."] [77 1 "// stgOf is PyStgInfo_FromType: t's StgInfo, or nil (an abstract class, or not a ctypes type)."] [86 1 "// CData is CDataObject."] [88 16 "// the base type (Type())"] [89 16 "// its class"] [94 17 "// its own memory, else nil (a base's, an address's)"] [95 17 "// b_base"] [97 17 "// b_objects"] [99 2 "// a function pointer's state (PyCFuncPtrObject)"] [105 1 "// obj is c as a Python object (its class's instance)."] [113 1 "// cdataOf is the CData of o (a ctypes instance), or nil."] [143 23 "// ctypes.ArgumentError"] [152 1 "// _ctypes_simple_instance: true for a subclass of c_int and the like (its base is not _SimpleCData), false for"] [153 1 "// c_int itself (callproc.c: such a class is kept as an instance, not converted by its getfunc)."] [158 1 "// tpName is a type's tp_name as CPython prints it in these messages (its __name__ for a heap type)."] [161 1 "// newCData is generic_pycdata_new / PyCData_MallocBuffer: a zeroed instance of t of its own memory."] [174 1 "// baseKind is the built-in base of a ctypes class."] [185 1 "// fromBaseObj is PyCData_FromBaseObj: an instance of t on base's memory at adr (base nil: a copy of adr's bytes)."] [203 1 "// atAddress is PyCData_AtAddress: an instance of t over the memory at buf."] [214 1 "// container is PyCData_GetContainer."] [240 1 "// keepRef is KeepRef."] [254 1 "// cdataGet is PyCData_get."] [267 1 "// cdataSetInner is _PyCData_set."] [309 1 "// cdataSet is PyCData_set."] [318 1 "// extendError is _ctypes_extend_error: the exception err re-raised as cls with prefix and \"ExcType: msg\"."] [331 1 "// ---- the metatypes ----"] [333 1 "// newClass is type.__new__ for a metatype's class."] [348 1 "// simpleTypeNew is PyCSimpleType_new and PyCSimpleType_init."] [387 2 "// the swapped variant for the byte orders (__ctype_be__, __ctype_le__), as PyCSimpleType_init's create_other_endian_type"] [409 1 "// makeSwapped is create_other_endian_type: a class of the same name with the byte-swapped accessors."] [434 1 "// fmtOf is the buffer format of a simple type's code (_ctypes_alloc_format_string_for_type)."] [455 1 "// structTypeNew is PyCStructType_new/init (and UnionType's): the class, its StgInfo copied from its base's, its"] [456 1 "// _fields_ laid out when given."] [484 1 "// updateStginfo is PyCStructUnionType_update_stginfo: the layout by ctypes._layout.get_layout, then the fields made"] [485 1 "// descriptors of the class (MakeAnonFields included)."] [589 2 "// the aggregate's ffi type (a union: its largest member's elements, stgdict.c's rule, as one struct)"] [611 1 "// makeAnonFields is MakeAnonFields: the fields of each _anonymous_ field's type made the class's, at their offsets."] [639 1 "// makeFields is MakeFields: descr's type's fields as fields of t at offset."] [662 1 "// structTypeSetAttr is PyCStructType_setattro: _fields_ assigned lays the class out."] [681 1 "// arrayTypeNew is PyCArrayType_init."] [735 2 "// char and wchar_t arrays: value and raw"] [749 1 "// pointerTypeNew is PyCPointerType_new/init."] [767 1 "// pointerSetProto is PyCPointerType_SetProto: the item type, and the item type's __pointer_type__."] [783 1 "// funcPtrTypeNew is PyCFuncPtrType_new/init: _argtypes_, _restype_, _flags_."] [833 1 "// converters is converters_from_argtypes: each argtype's from_param."] [849 1 "// ---- CDataType's methods (on the metatypes) ----"] [902 3 "// CPython shares the buffer's memory; a Python buffer's bytes are Go memory, not the C world's: from_buffer"] [903 3 "// copies them (a write through either is not seen by the other: the class :ctypes-buffer-share)"] [1011 1 "// arrayFromCtype is PyCArrayType_from_ctype: the class \"NAME_Array_N\", cached."] [1030 1 "// ---- CField ----"] [1149 1 "// ---- instances ----"] [1151 1 "// simpleNew and genericNew are the types' tp_new."] [1191 1 "// structInit is Struct_init: positional arguments to the fields in order (the bases' first), keywords by name."] [1226 1 "// fieldNamesMRO: the names of the _fields_ of t and its bases, the bases' first (_init_pos_args)."] [1276 1 "// ---- arrays ----"] [1333 1 "// Slice_ is a slice's resolved indices."] [1410 1 "// ---- pointers ----"] [1473 1 "// ---- module functions ----"] [1495 1 "// CArgObject: byref's result, and from_param's."] [1498 15 "// the value's bytes (a pointer: 8)"] [1499 15 "// kept alive"] [1501 15 "// a struct by value: its address"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[115 41] [279 31] [292 38] [325 25] [362 26] [364 35] [393 46] [396 47] [399 47] [402 48] [412 61] [415 58] [467 23] [475 47] [476 42] [546 23] [576 49] [586 24] [596 29] [632 55] [647 66] [655 49] [667 22] [671 47] [728 12] [728 38] [759 44] [775 48] [776 57] [791 37] [800 40] [812 39] [817 52] [882 35] [915 28] [919 36] [944 35] [973 34] [1013 31] [1134 27] [1135 20] [1136 28] [1202 41] [1212 48] [1219 38] [1245 35] [1287 34] [1316 26] [1351 14] [1351 24] [1357 14] [1357 24] [1364 12] [1364 22] [1387 78] [1387 99] [1394 51] [1435 45] [1439 32] [1476 21] [1479 20] [1486 21] [1489 20] [1519 12] [1519 19]]} (go/file "ctypes.go" :imports [

    ;; Modules/_ctypes/_ctypes.c and stgdict.c: Copyright (c) the Python Software Foundation, under the PSF License
    ;; Agreement for Python 3.14 (LICENSE.md). The port to Go: Copyright (c) the Arbace authors, under the same license.
    ;;
    ;; The module _ctypes (queue 244; doc/python/PYTHON-SURVEY.md, "As built: 244"; the user's 244-1 (a)): CPython
    ;; 3.14.10's types ported over pyi's objects, their memory the C world's (world.go), libffi's part ffi.go over ci.
    ;; How the C maps onto Go here:
    ;;
    ;;   - CDataObject is CData, a built-in value of one of the five base types (_SimpleCData, Structure, Union, Array,
    ;;     _Pointer, CFuncPtr); a Python class deriving from one (c_int, a Structure subclass) holds it in its instance
    ;;     (pyi's built-in subclass wrapper). b_ptr is an address of the world; b_objects, b_base, b_index, b_length,
    ;;     b_size are CPython's.
    ;;   - StgInfo (stgdict.c) is kept per class in a table (stgs): CPython keeps it in the type object.
    ;;   - The metatypes PyCSimpleType, PyCStructType, UnionType, PyCArrayType, PyCPointerType, PyCFuncPtrType are
    ;;     built-in subclasses of type: their __new__ makes the class by type.__new__ and then its StgInfo, as their
    ;;     tp_new and tp_init do; CDataType's methods (from_address, from_buffer, from_buffer_copy, from_param, in_dll,
    ;;     __mul__) are theirs.
    ;;   - Structures are laid out by Lib/ctypes/_layout.py (3.14's), which makes the CField objects.



(in-ns 'go.arbace.pyctypes) ^{:go/comments [[3 1 "// Modules/_ctypes/_ctypes.c and stgdict.c: Copyright (c) the Python Software Foundation, under the PSF License"] [4 1 "// Agreement for Python 3.14 (LICENSE.md). The port to Go: Copyright (c) the Arbace authors, under the same license."] [5 1 "//"] [6 1 "// The module _ctypes (queue 244; doc/python/PYTHON-SURVEY.md, \"As built: 244\"; the user's 244-1 (a)): CPython"] [7 1 "// 3.14.10's types ported over pyi's objects, their memory the C world's (world.go), libffi's part ffi.go over ci."] [8 1 "// How the C maps onto Go here:"] [9 1 "//"] [10 1 "//   - CDataObject is CData, a built-in value of one of the five base types (_SimpleCData, Structure, Union, Array,"] [11 1 "//     _Pointer, CFuncPtr); a Python class deriving from one (c_int, a Structure subclass) holds it in its instance"] [12 1 "//     (pyi's built-in subclass wrapper). b_ptr is an address of the world; b_objects, b_base, b_index, b_length,"] [13 1 "//     b_size are CPython's."] [14 1 "//   - StgInfo (stgdict.c) is kept per class in a table (stgs): CPython keeps it in the type object."] [15 1 "//   - The metatypes PyCSimpleType, PyCStructType, UnionType, PyCArrayType, PyCPointerType, PyCFuncPtrType are"] [16 1 "//     built-in subclasses of type: their __new__ makes the class by type.__new__ and then its StgInfo, as their"] [17 1 "//     tp_new and tp_init do; CDataType's methods (from_address, from_buffer, from_buffer_copy, from_param, in_dll,"] [18 1 "//     __mul__) are theirs."] [19 1 "//   - Structures are laid out by Lib/ctypes/_layout.py (3.14's), which makes the CField objects."] [31 1 "// StgInfo is stgdict.c's StgInfo."] [36 21 "// a simple type's _type_ (a str), an array's or a pointer's item type"] [40 23 "// a function pointer type's"] [49 18 "// simpleKind, structKind, ..."] [77 1 "// stgOf is PyStgInfo_FromType: t's StgInfo, or nil (an abstract class, or not a ctypes type)."] [86 1 "// CData is CDataObject."] [88 16 "// the base type (Type())"] [89 16 "// its class"] [94 17 "// its own memory, else nil (a base's, an address's)"] [95 17 "// b_base"] [97 17 "// b_objects"] [99 2 "// a function pointer's state (PyCFuncPtrObject)"] [105 1 "// withFn gives a function pointer instance its PyCFuncPtrObject state (one made from memory: a result, a field)."] [113 1 "// obj is c as a Python object (its class's instance)."] [121 1 "// cdataOf is the CData of o (a ctypes instance), or nil."] [151 23 "// ctypes.ArgumentError"] [160 1 "// _ctypes_simple_instance: true for a subclass of c_int and the like (its base is not _SimpleCData), false for"] [161 1 "// c_int itself (callproc.c: such a class is kept as an instance, not converted by its getfunc)."] [166 1 "// tpName is a type's tp_name as CPython prints it in these messages (its __name__ for a heap type)."] [169 1 "// newCData is generic_pycdata_new / PyCData_MallocBuffer: a zeroed instance of t of its own memory."] [182 1 "// baseKind is the built-in base of a ctypes class."] [193 1 "// fromBaseObj is PyCData_FromBaseObj: an instance of t on base's memory at adr (base nil: a copy of adr's bytes)."] [211 1 "// atAddress is PyCData_AtAddress: an instance of t over the memory at buf."] [222 1 "// container is PyCData_GetContainer."] [248 1 "// keepRef is KeepRef."] [262 1 "// cdataGet is PyCData_get."] [275 1 "// cdataSetInner is _PyCData_set."] [317 1 "// cdataSet is PyCData_set."] [326 1 "// extendError is _ctypes_extend_error: the exception err re-raised as cls with prefix and \"ExcType: msg\"."] [339 1 "// ---- the metatypes ----"] [341 1 "// newClass is type.__new__ for a metatype's class."] [356 1 "// simpleTypeNew is PyCSimpleType_new and PyCSimpleType_init."] [395 2 "// the swapped variant for the byte orders (__ctype_be__, __ctype_le__), as PyCSimpleType_init's create_other_endian_type"] [417 1 "// makeSwapped is create_other_endian_type: a class of the same name with the byte-swapped accessors."] [442 1 "// fmtOf is the buffer format of a simple type's code (_ctypes_alloc_format_string_for_type)."] [463 1 "// structTypeNew is PyCStructType_new/init (and UnionType's): the class, its StgInfo copied from its base's, its"] [464 1 "// _fields_ laid out when given."] [492 1 "// updateStginfo is PyCStructUnionType_update_stginfo: the layout by ctypes._layout.get_layout, then the fields made"] [493 1 "// descriptors of the class (MakeAnonFields included)."] [597 2 "// the aggregate's ffi type (a union: its largest member's elements, stgdict.c's rule, as one struct)"] [619 1 "// makeAnonFields is MakeAnonFields: the fields of each _anonymous_ field's type made the class's, at their offsets."] [647 1 "// makeFields is MakeFields: descr's type's fields as fields of t at offset."] [670 1 "// structTypeSetAttr is PyCStructType_setattro: _fields_ assigned lays the class out."] [689 1 "// arrayTypeNew is PyCArrayType_init."] [743 2 "// char and wchar_t arrays: value and raw"] [757 1 "// pointerTypeNew is PyCPointerType_new/init."] [775 1 "// pointerSetProto is PyCPointerType_SetProto: the item type, and the item type's __pointer_type__."] [791 1 "// funcPtrTypeNew is PyCFuncPtrType_new/init: _argtypes_, _restype_, _flags_."] [848 1 "// converters is converters_from_argtypes: each argtype's from_param."] [864 1 "// ---- CDataType's methods (on the metatypes) ----"] [917 3 "// CPython shares the buffer's memory; a Python buffer's bytes are Go memory, not the C world's: from_buffer"] [918 3 "// copies them (a write through either is not seen by the other: the class :ctypes-buffer-share)"] [1026 1 "// arrayFromCtype is PyCArrayType_from_ctype: the class \"NAME_Array_N\", cached."] [1045 1 "// ---- CField ----"] [1164 1 "// ---- instances ----"] [1166 1 "// simpleNew and genericNew are the types' tp_new."] [1206 1 "// structInit is Struct_init: positional arguments to the fields in order (the bases' first), keywords by name."] [1241 1 "// fieldNamesMRO: the names of the _fields_ of t and its bases, the bases' first (_init_pos_args)."] [1291 1 "// ---- arrays ----"] [1348 1 "// Slice_ is a slice's resolved indices."] [1425 1 "// ---- pointers ----"] [1488 1 "// ---- module functions ----"] [1510 1 "// CArgObject: byref's result, and from_param's."] [1513 15 "// the value's bytes (a pointer: 8)"] [1514 15 "// kept alive"] [1516 15 "// a struct by value: its address"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[123 41] [287 31] [300 38] [333 25] [370 26] [372 35] [401 46] [404 47] [407 47] [410 48] [420 61] [423 58] [475 23] [483 47] [484 42] [554 23] [584 49] [594 24] [604 29] [640 55] [655 66] [663 49] [675 22] [679 47] [736 12] [736 38] [767 44] [783 48] [784 57] [799 37] [808 40] [827 39] [832 52] [897 35] [930 28] [934 36] [959 35] [988 34] [1028 31] [1149 27] [1150 20] [1151 28] [1217 41] [1227 48] [1234 38] [1260 35] [1302 34] [1331 26] [1366 14] [1366 24] [1372 14] [1372 24] [1379 12] [1379 22] [1402 78] [1402 99] [1409 51] [1450 45] [1454 32] [1491 21] [1494 20] [1501 21] [1504 20] [1534 12] [1534 19]]} (go/file "ctypes.go" :imports [

    ;; Modules/_ctypes/_ctypes.c and stgdict.c: Copyright (c) the Python Software Foundation, under the PSF License
    ;; Agreement for Python 3.14 (LICENSE.md). The port to Go: Copyright (c) the Arbace authors, under the same license.
    ;;
    ;; The module _ctypes (queue 244; doc/python/PYTHON-SURVEY.md, "As built: 244"; the user's 244-1 (a)): CPython
    ;; 3.14.10's types ported over pyi's objects, their memory the C world's (world.go), libffi's part ffi.go over ci.
    ;; How the C maps onto Go here:
    ;;
    ;;   - CDataObject is CData, a built-in value of one of the five base types (_SimpleCData, Structure, Union, Array,
    ;;     _Pointer, CFuncPtr); a Python class deriving from one (c_int, a Structure subclass) holds it in its instance
    ;;     (pyi's built-in subclass wrapper). b_ptr is an address of the world; b_objects, b_base, b_index, b_length,
    ;;     b_size are CPython's.
    ;;   - StgInfo (stgdict.c) is kept per class in a table (stgs): CPython keeps it in the type object.
    ;;   - The metatypes PyCSimpleType, PyCStructType, UnionType, PyCArrayType, PyCPointerType, PyCFuncPtrType are
    ;;     built-in subclasses of type: their __new__ makes the class by type.__new__ and then its StgInfo, as their
    ;;     tp_new and tp_init do; CDataType's methods (from_address, from_buffer, from_buffer_copy, from_param, in_dll,
    ;;     __mul__) are theirs.
    ;;   - Structures are laid out by Lib/ctypes/_layout.py (3.14's), which makes the CField objects.



[89 16 "// the base type (Type())"] [90 16 "// its class"] [95 17 "// its own memory, else nil (a base's, an address's)"] [96 17 "// b_base"] [98 17 "// b_objects"] [100 2 "// a function pointer's state (PyCFuncPtrObject)"] [106 1 "// withFn gives a function pointer instance its PyCFuncPtrObject state (one made from memory: a result, a field)."] [114 1 "// obj is c as a Python object (its class's instance)."] [122 1 "// cdataOf is the CData of o (a ctypes instance), or nil."] [152 23 "// ctypes.ArgumentError"] [161 1 "// _ctypes_simple_instance: true for a subclass of c_int and the like (its base is not _SimpleCData), false for"] [162 1 "// c_int itself (callproc.c: such a class is kept as an instance, not converted by its getfunc)."] [167 1 "// tpName is a type's tp_name as CPython prints it in these messages (its __name__ for a heap type)."] [170 1 "// newCData is generic_pycdata_new / PyCData_MallocBuffer: a zeroed instance of t of its own memory."] [183 1 "// baseKind is the built-in base of a ctypes class."] [194 1 "// fromBaseObj is PyCData_FromBaseObj: an instance of t on base's memory at adr (base nil: a copy of adr's bytes)."] [212 1 "// atAddress is PyCData_AtAddress: an instance of t over the memory at buf."] [223 1 "// container is PyCData_GetContainer."] [249 1 "// keepRef is KeepRef."] [263 1 "// cdataGet is PyCData_get."] [276 1 "// cdataSetInner is _PyCData_set."] [318 1 "// cdataSet is PyCData_set."] [327 1 "// extendError is _ctypes_extend_error: the exception err re-raised as cls with prefix and \"ExcType: msg\"."] [340 1 "// ---- the metatypes ----"] [342 1 "// newClass is type.__new__ for a metatype's class."] [357 1 "// simpleTypeNew is PyCSimpleType_new and PyCSimpleType_init."] [396 2 "// the swapped variant for the byte orders (__ctype_be__, __ctype_le__), as PyCSimpleType_init's create_other_endian_type"] [418 1 "// makeSwapped is create_other_endian_type: a class of the same name with the byte-swapped accessors."] [443 1 "// fmtOf is the buffer format of a simple type's code (_ctypes_alloc_format_string_for_type)."] [464 1 "// structTypeNew is PyCStructType_new/init (and UnionType's): the class, its StgInfo copied from its base's, its"] [465 1 "// _fields_ laid out when given."] [483 2 "// a class with _abstract_ in its namespace has no StgInfo (kept for compatibility: instantiating it is"] [484 2 "// \"abstract class\")"] [498 1 "// updateStginfo is PyCStructUnionType_update_stginfo: the layout by ctypes._layout.get_layout, then the fields made"] [499 1 "// descriptors of the class (MakeAnonFields included)."] [603 2 "// the aggregate's ffi type (a union: its largest member's elements, stgdict.c's rule, as one struct)"] [610 2 "// a field of the class's own type marked it final during the layout (stgdict.c's check)"] [626 1 "// makeAnonFields is MakeAnonFields: the fields of each _anonymous_ field's type made the class's, at their offsets."] [654 1 "// makeFields is MakeFields: descr's type's fields as fields of t at offset."] [677 1 "// structTypeSetAttr is PyCStructType_setattro: _fields_ assigned lays the class out."] [696 1 "// arrayTypeNew is PyCArrayType_init."] [750 2 "// char and wchar_t arrays: value and raw"] [764 1 "// pointerTypeNew is PyCPointerType_new/init."] [782 1 "// pointerSetProto is PyCPointerType_SetProto: the item type, and the item type's __pointer_type__."] [796 1 "// funcPtrTypeNew is PyCFuncPtrType_new/init: _argtypes_, _restype_, _flags_."] [853 1 "// converters is converters_from_argtypes: each argtype's from_param."] [869 1 "// ---- CDataType's methods (on the metatypes) ----"] [922 3 "// CPython shares the buffer's memory; a Python buffer's bytes are Go memory, not the C world's: from_buffer"] [923 3 "// copies them (a write through either is not seen by the other: the class :ctypes-buffer-share)"] [1031 1 "// arrayFromCtype is PyCArrayType_from_ctype: the class \"NAME_Array_N\", cached."] [1050 1 "// ---- CField ----"] [1121 20 "// a type used as a field's can no longer change its _fields_"] [1170 1 "// ---- instances ----"] [1172 1 "// simpleNew and genericNew are the types' tp_new."] [1215 1 "// structInit is Struct_init: positional arguments to the fields in order (the bases' first), keywords by name."] [1250 1 "// fieldNamesMRO: the names of the _fields_ of t and its bases, the bases' first (_init_pos_args)."] [1300 1 "// ---- arrays ----"] [1357 1 "// Slice_ is a slice's resolved indices."] [1434 1 "// ---- pointers ----"] [1497 1 "// ---- module functions ----"] [1519 1 "// CArgObject: byref's result, and from_param's."] [1522 15 "// the value's bytes (a pointer: 8)"] [1523 15 "// kept alive"] [1525 15 "// a struct by value: its address"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[124 41] [288 31] [301 38] [334 25] [371 26] [373 35] [402 46] [405 47] [408 47] [411 48] [421 61] [424 58] [476 23] [485 49] [489 47] [490 42] [560 23] [590 49] [600 24] [647 55] [662 66] [670 49] [682 22] [686 47] [743 12] [743 38] [774 44] [790 19] [804 37] [813 40] [832 39] [837 52] [902 35] [935 28] [939 36] [964 35] [993 34] [1033 31] [1155 27] [1156 20] [1157 28] [1174 20] [1226 41] [1236 48] [1243 38] [1269 35] [1311 34] [1340 26] [1375 14] [1375 24] [1381 14] [1381 24] [1388 12] [1388 22] [1411 78] [1411 99] [1418 51] [1459 45] [1463 32] [1500 21] [1503 20] [1510 21] [1513 20] [1543 12] [1543 19]]} (go/file "ctypes.go" :imports [


[89 16 "// the base type (Type())"] [90 16 "// its class"] [95 17 "// its own memory, else nil (a base's, an address's)"] [96 17 "// b_base"] [98 17 "// b_objects"] [100 2 "// a function pointer's state (PyCFuncPtrObject)"] [106 1 "// withFn gives a function pointer instance its PyCFuncPtrObject state (one made from memory: a result, a field)."] [114 1 "// obj is c as a Python object (its class's instance)."] [122 1 "// cdataOf is the CData of o (a ctypes instance), or nil."] [152 23 "// ctypes.ArgumentError"] [161 1 "// _ctypes_simple_instance: true for a subclass of c_int and the like (its base is not _SimpleCData), false for"] [162 1 "// c_int itself (callproc.c: such a class is kept as an instance, not converted by its getfunc)."] [167 1 "// tpName is a type's tp_name as CPython prints it in these messages (its __name__ for a heap type)."] [170 1 "// newCData is generic_pycdata_new / PyCData_MallocBuffer: a zeroed instance of t of its own memory."] [183 1 "// baseKind is the built-in base of a ctypes class."] [194 1 "// fromBaseObj is PyCData_FromBaseObj: an instance of t on base's memory at adr (base nil: a copy of adr's bytes)."] [212 1 "// atAddress is PyCData_AtAddress: an instance of t over the memory at buf."] [223 1 "// container is PyCData_GetContainer."] [249 1 "// keepRef is KeepRef."] [263 1 "// cdataGet is PyCData_get."] [276 1 "// cdataSetInner is _PyCData_set."] [318 1 "// cdataSet is PyCData_set."] [327 1 "// extendError is _ctypes_extend_error: the exception err re-raised as cls with prefix and \"ExcType: msg\"."] [340 1 "// ---- the metatypes ----"] [342 1 "// initTarget is the class a metatype's __init__ initializes: the metatypes' tp_new is type.__new__ alone and their"] [343 1 "// tp_init makes the StgInfo, as CPython's (metacls.__new__ without __init__ gives an abstract class); the init runs the"] [344 1 "// creation functions below on the class already made, which newClass hands them."] [347 1 "// newClass is type.__new__ for a metatype's class (the class being initialized when a metatype's __init__ runs)."] [366 1 "// simpleTypeNew is PyCSimpleType_new and PyCSimpleType_init."] [405 2 "// the swapped variant for the byte orders (__ctype_be__, __ctype_le__), as PyCSimpleType_init's create_other_endian_type"] [427 1 "// makeSwapped is create_other_endian_type: a class of the same name with the byte-swapped accessors."] [452 1 "// fmtOf is the buffer format of a simple type's code (_ctypes_alloc_format_string_for_type)."] [473 1 "// structTypeNew is PyCStructType_new/init (and UnionType's): the class, its StgInfo copied from its base's, its"] [474 1 "// _fields_ laid out when given."] [492 2 "// a class with _abstract_ in its namespace has no StgInfo (kept for compatibility: instantiating it is"] [493 2 "// \"abstract class\")"] [507 1 "// updateStginfo is PyCStructUnionType_update_stginfo: the layout by ctypes._layout.get_layout, then the fields made"] [508 1 "// descriptors of the class (MakeAnonFields included)."] [612 2 "// the aggregate's ffi type (a union: its largest member's elements, stgdict.c's rule, as one struct)"] [619 2 "// a field of the class's own type marked it final during the layout (stgdict.c's check)"] [635 1 "// makeAnonFields is MakeAnonFields: the fields of each _anonymous_ field's type made the class's, at their offsets."] [663 1 "// makeFields is MakeFields: descr's type's fields as fields of t at offset."] [686 1 "// structTypeSetAttr is PyCStructType_setattro: _fields_ assigned lays the class out."] [705 1 "// arrayTypeNew is PyCArrayType_init."] [759 2 "// char and wchar_t arrays: value and raw"] [773 1 "// pointerTypeNew is PyCPointerType_new/init."] [791 1 "// pointerSetProto is PyCPointerType_SetProto: the item type, and the item type's __pointer_type__."] [805 1 "// funcPtrTypeNew is PyCFuncPtrType_new/init: _argtypes_, _restype_, _flags_."] [862 1 "// converters is converters_from_argtypes: each argtype's from_param."] [878 1 "// ---- CDataType's methods (on the metatypes) ----"] [931 3 "// CPython shares the buffer's memory; a Python buffer's bytes are Go memory, not the C world's: from_buffer"] [932 3 "// copies them (a write through either is not seen by the other: the class :ctypes-buffer-share)"] [1040 1 "// arrayFromCtype is PyCArrayType_from_ctype: the class \"NAME_Array_N\", cached."] [1059 1 "// ---- CField ----"] [1130 20 "// a type used as a field's can no longer change its _fields_"] [1179 1 "// ---- instances ----"] [1181 1 "// simpleNew and genericNew are the types' tp_new."] [1224 1 "// structInit is Struct_init: positional arguments to the fields in order (the bases' first), keywords by name."] [1259 1 "// fieldNamesMRO: the names of the _fields_ of t and its bases, the bases' first (_init_pos_args)."] [1309 1 "// ---- arrays ----"] [1366 1 "// Slice_ is a slice's resolved indices."] [1443 1 "// ---- pointers ----"] [1506 1 "// ---- module functions ----"] [1528 1 "// CArgObject: byref's result, and from_param's."] [1531 15 "// the value's bytes (a pointer: 8)"] [1532 15 "// kept alive"] [1534 15 "// a struct by value: its address"] [1588 1 "// metaNew is a metatype's tp_new: type.__new__ alone."] [1591 1 "// metaInit is a metatype's tp_init: create (one of the creation functions) run on the class o."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[124 41] [288 31] [301 38] [334 25] [349 20] [380 26] [382 35] [411 46] [414 47] [417 47] [420 48] [430 61] [433 58] [485 23] [494 49] [498 47] [499 42] [569 23] [599 49] [609 24] [656 55] [671 66] [679 49] [691 22] [695 47] [752 12] [752 38] [783 44] [799 19] [813 37] [822 40] [841 39] [846 52] [911 35] [944 28] [948 36] [973 35] [1002 34] [1042 31] [1164 27] [1165 20] [1166 28] [1183 20] [1235 41] [1245 48] [1252 38] [1278 35] [1320 34] [1349 26] [1384 14] [1384 24] [1390 14] [1390 24] [1397 12] [1397 22] [1420 78] [1420 99] [1427 51] [1468 45] [1472 32] [1509 21] [1512 20] [1519 21] [1522 20] [1552 12] [1552 19]]} (go/file "ctypes.go" :imports [

    ;; Modules/_ctypes/_ctypes.c and stgdict.c: Copyright (c) the Python Software Foundation, under the PSF License

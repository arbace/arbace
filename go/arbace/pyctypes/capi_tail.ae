(in-ns 'go.arbace.pyctypes) ^{:go/comments [[3 1 "// The C API's natives test_capi's modules reach that the earlier tables leave (the burst of 2026-11-22, py-capi-1122;"] [4 1 "// doc/python/PYTHON-SURVEY.md, \"As built: py-capi\"): PEP 757's PyLong_Export and PyLongWriter (Objects/longobject.c),"] [5 1 "// each written after CPython 3.14.10's function of the same name. The PSF's license (LICENSE.md)."] [18 1 "// digitBits is PyLong's digit: 30 bits in a uint32 (PyLong_GetNativeLayout's)."] [23 2 "// PyLong_Export(obj, PyLongExport *e): {int64 value; uint8 negative; ssize ndigits; const void *digits; uintptr"] [24 2 "// _reserved}, 40 bytes. A value that fits in int64 is in value (digits NULL); else the absolute value's 30-bit"] [25 2 "// digits, least significant first, in memory of the world that _reserved names until PyLong_FreeExport."] [67 2 "// PyLongWriter_Create(negative, ndigits, void **digits): a writer of the world's memory, {int64 negative; int64"] [68 2 "// ndigits} then the ndigits digits C fills (*digits); ndigits <= 0 is a ValueError, *digits NULL"] [91 2 "// PyLongWriter_Finish(writer): the int of its digits (normalized: an int of -5 to 256 the interned one), the writer"] [92 2 "// freed"] [114 2 "// PyFrame_New(tstate, code, globals, locals) (Objects/frameobject.c): a frame of code not running (f_back None), its"] [115 2 "// globals and builtins (globals' __builtins__, a module's dict) and, for a code without CO_OPTIMIZED, its locals"] [138 2 "// PyImport_ImportFrozenModuleObject(name) and PyImport_ImportFrozenModule(char *) (Python/import.c): 1 when name is a"] [139 2 "// frozen module (pyi's, as _imp.find_frozen finds it), its code run in sys.modules' module of that name (a package"] [140 2 "// with __path__ []); 0 when name is none (no str, '', a module that is not frozen); -1 on an error"] [201 2 "// ---- Objects/complexobject.c: PyComplex_AsCComplex, RealAsDouble, ImagAsDouble and the _Py_c_ arithmetic ----"] [226 2 "// a Py_complex result is the caller's aggregate (a[0], ci's hidden pointer), a Py_complex argument its bytes"] [253 2 "// ---- wide characters (Objects/unicodeobject.c; wchar_t is ci's 4-byte UTF-32) ----"] [335 2 "// ---- small functions of test_capi's test_misc (Objects/object.c, genobject.c, codeobject.c, obmalloc.c, ...) ----"] [355 2 "// the allocator domains (Objects/obmalloc.c): RAW 0 (PyMem_Raw*), MEM 1 (PyMem_*), OBJ 2 (PyObject_*), each the"] [356 2 "// world's allocator (a zero size one byte, never NULL; OBJ's free also forgets a C-born object's handle) unless"] [357 2 "// PyMem_SetAllocator gave a PyMemAllocatorEx {ctx, malloc, calloc, realloc, free} of C's; PyMem_GetAllocator gives"] [358 2 "// the defaults as natives taking the domain as ctx"] [440 2 "// PyWeakref_GetObject (deprecated): the referent, borrowed, or None when it is dead"] [458 2 "// PyBuffer_FromContiguous(view, buf, len, order): buf's len bytes into view's (shape, strides) in C or Fortran order"] [462 3 "// Py_buffer: buf 0, obj 8, len 16, itemsize 24, readonly 32, ndim 36, format 40, shape 48, strides 56"] [503 2 "// PyThread_tss_* (Python/thread.c, one thread): a Py_tss_t is {int _is_initialized; pthread_key_t _key}, 8 bytes"] [543 33 "// the main thread's id is the process's"] [546 2 "// PyObject_Print(op, fp, flags) (Objects/object.c): \"<nil>\" for NULL, \"<refcnt N at P>\" for a count <= 0, else the"] [547 2 "// repr (str with Py_PRINT_RAW) by fwrite; a short write or the stream's error flag an OSError of errno (musl's FILE:"] [548 2 "// flags first, F_EOF 16, F_ERR 32)"] [552 35 "// clearerr"] [587 2 "// PyUnstable_IsImmortal: a handle of the immortal count (the types', the singletons', the small ints'), or the empty"] [588 2 "// tuple (CPython's immortal singleton)"] [599 2 "// Py_FrozenMain (Python/frozenmain.c): exported as CPython's binary exports it (test_misc's test_export_symbols);"] [600 2 "// pyi has no frozen main program, so it reports that and returns 1"] [605 2 "// PyStructSequence_NewType(desc) (Objects/structseq.c): a heap type deriving from tuple named by desc's \"module.name\","] [606 2 "// its doc, n_sequence_fields, n_fields and n_unnamed_fields, each named field of the sequence a property of its item"] [607 2 "// (PyStructSequence_Desc: name, doc, fields, n_in_sequence; PyStructSequence_Field: name, doc; a NULL name ends the"] [608 2 "// fields, PyStructSequence_UnnamedField an unnamed one)"] [624 22 "// PyStructSequence_UnnamedField's value (a const char * const of the C API's data)"] [663 2 "// PyErr_SetHandledException and PyErr_SetExcInfo (Python/errors.c): the exception being handled at this level"] [664 2 "// replaced (None or NULL clears it; SetExcInfo steals its three references and keeps the value alone)"] [686 2 "// ---- Python/errors.c: PyErr_SetString, SetObject, Restore and the unraisable reports, as CPython 3.14.10's ----"] [704 43 "// _PyErr_CreateException unless already normalized"] [727 2 "// PyErr_FormatUnraisable(format, ...): err_msg the formatted text (None for no format or one that does not format:"] [728 2 "// a non-ASCII format byte)"] [743 2 "// ---- Python/pystate.c: the interpreter state (PyThreadState.interp at offset 16 of P1's thread states), its dict,"] [744 2 "// PyUnstable_AtExit's callbacks (run by Py_EndInterpreter, the init below), PyGILState_GetThisThreadState; ceval.c's"] [745 2 "// and codeobject.c's code extra ----"] [781 2 "// PyGILState_GetThisThreadState: capi_port.go (P1's, 3ee81c30f)"] [807 2 "// PyUnstable_Exc_PrepReraiseStar(orig, excs) (Objects/exceptions.c, _PyExc_PrepReraiseStar): what an except* block"] [808 2 "// raises at its end, from the original group and the list of what its clauses raised or re-raised"] [828 2 "// PyState_FindModule, AddModule and RemoveModule (Python/pystate.c): single-phase modules by their definition's"] [829 2 "// m_index (PyModuleDef_Init's); a definition with slots (multi-phase) is refused"] [870 2 "// Py_AddPendingCall(func, arg) and Py_MakePendingCalls (Python/ceval_gil.c): the main thread's queue of 32 calls"] [871 2 "// (full: -1); they run when C returns to Python (CPython's eval breaker), or by Py_MakePendingCalls"] [888 2 "// PyNamespace_New and _PyNamespace_New(kwds) (Objects/namespaceobject.c): a types.SimpleNamespace of the dict's items"] [910 2 "// PyModule_New(name) (Objects/moduleobject.c): a new module of that name (UTF-8)"] [932 1 "// fromFormat is PyUnicode_FromFormatV (Objects/unicodeobject.c's unicode_from_format and unicode_fromformat_arg): the"] [933 1 "// ASCII format with its conversions over the variadic arguments (flags - 0 #, width and precision, * for an int argument,"] [934 1 "// the size modifiers l ll z t j); an invalid conversion \"invalid format string: %...\" (SystemError), a non-ASCII format"] [935 1 "// byte ValueError, %c outside range(0x110000) OverflowError."] [951 2 "// writeStr is unicode_fromformat_write_str: precision cuts, width pads with spaces (left with -)"] [986 4 "// cut at the precision (no NUL within it), a multi-byte sequence cut at the end is dropped"] [987 4 "// (PyUnicode_DecodeUTF8Stateful's consumed)"] [1090 13 "// 1 l, 2 ll, 3 z, 4 t, 5 j"] [1140 19 "// int, unsigned int"] [1247 55 "// _PyType_GetFullyQualifiedName(type, ':')"] [1258 1 "// isExceptionGroup is _PyBaseExceptionGroup_Check."] [1268 1 "// leafIDs adds the identities of an exception group's leaves (its exceptions that are no groups, recursively) to ids."] [1290 1 "// sameMetadata is is_same_exception_metadata: the same notes, traceback, cause and context objects."] [1302 1 "// prepReraiseStar is _PyExc_PrepReraiseStar over a list of exceptions or None."] [1321 2 "// exception_group_projection: orig's split by the leaves of the re-raised ones (identity), the match part"] [1376 41 "// an interpreter state's PyUnstable_AtExit callbacks (func, data)"] [1380 1 "// builtinNew is _PyObject_New(Var)'s object of a built-in type C did not make (object, bytes, ...: no C layout of its"] [1381 1 "// own to allocate): the type's own empty instance, a bytes or bytearray of nitems zeros; nil for the others."] [1401 1 "// init wraps _PyObject_New and adds _PyObject_NewVar (Objects/object.c): a built-in type's own instance (builtinNew),"] [1402 1 "// else the earlier _PyObject_New's C allocation."] [1424 1 "// init wraps Py_EndInterpreter (P1's, capi_port.go): the ending interpreter's PyUnstable_AtExit callbacks first, last"] [1425 1 "// registered first, while its thread state is current (Python/pylifecycle.c's finalize_modules' _PyAtExit_Call)."] [1444 1 "// writeUnraisableC is format_unraisable_v: sys.unraisablehook given err_msg msg and object obj (nil: None); without a"] [1445 1 "// hook of the user's (None, or sys.__unraisablehook__), write_unraisable_exc's header on sys.stderr first (\"MSG:"] [1446 1 "// repr(obj)\", \"Exception ignored in: repr(obj)\" for no message, \"MSG:\" for no object), then the traceback."] [1480 1 "// createException is _PyErr_CreateException: exc(), exc(*value) for a tuple, else exc(value)."] [1493 1 "// setObject is _PyErr_SetObject's exception: a class that is no exception a SystemError, a value that is an instance of"] [1494 1 "// a subclass of it (issubclass, its __subclasscheck__'s errors propagating) as it is, else the class called with it; a"] [1495 1 "// failed instantiation's exception noted \"Normalization failed: type=T args=REPR\" (REPR <unknown> when repr fails)."] [1532 1 "// asCComplex is PyComplex_AsCComplex's value: a complex's own, else __complex__'s (a complex; a strict subclass's"] [1533 1 "// instance warned of, DeprecationWarning; anything else a TypeError), else the float of o as its real part."] [1567 1 "// setErrno is the world's errno set to e (EDOM 33, ERANGE 34)."] [1581 1 "// cProd is _Py_c_prod with C11 Annex G.5.1's recovery of infinities computed as nan+nanj."] [1619 1 "// cQuot is _Py_c_quot (Smith's algorithm by cases; a zero divisor EDOM and 0; C11 Annex G.5.2's recovery)."] [1660 1 "// cPow is _Py_c_pow: b == 0 gives 1, a == 0 gives 0 (EDOM for b not real or b < 0), else the polar form, an infinite"] [1661 1 "// part ERANGE (_Py_ADJUST_ERANGE2)."] [1691 1 "// cAbs is _Py_c_abs: an infinite part's magnitude (even with a NaN), a NaN part NaN, else hypot, ERANGE on overflow."] [1714 1 "// toDigits is b >= 0's 30-bit digits, least significant first (one digit for 0)."] [1728 1 "// fromDigits is the value of 30-bit digits, least significant first."] [1738 1 "// memAlloc is a PyMemAllocatorEx C set for a domain (malloc 0: the default)."] [1743 1 "// modulesByIndex is the interpreter's modules_by_index (PyState_AddModule's)."] [1746 1 "// pendingCalls are Py_AddPendingCall's (func, arg), pendingRunning while they run."] [1752 1 "// runPendingCallsErr runs the pending calls in order (int func(void *arg)); a call's -1 stops them with its error."] [1776 1 "// runPendingCalls is runPendingCallsErr when C returns to Python: a call's error reported as unraisable."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[29 21] [29 29] [40 24] [61 31] [109 25] [126 45] [127 27] [129 32] [133 35] [169 29] [170 55] [178 25] [179 45] [180 46] [185 42] [303 20] [303 30] [379 26] [399 25] [479 23] [479 48] [486 15] [486 25] [487 17] [493 22] [493 30] [494 17] [512 25] [594 38] [614 43] [619 28] [625 51] [631 28] [631 30] [650 13] [650 31] [666 29] [713 53] [722 20] [736 60] [760 26] [823 55] [836 45] [853 25] [883 33] [898 24] [903 42] [958 8] [958 18] [963 7] [963 17] [979 21] [979 36] [988 14] [988 67] [1016 20] [1016 52] [1025 12] [1025 24] [1172 22] [1172 36] [1179 21] [1179 34] [1186 22] [1186 36] [1246 42] [1283 28] [1325 29] [1409 36] [1432 26] [1436 25] [1436 33] [1462 28] [1470 47] [1484 27] [1516 21] [1520 32] [1523 48] [1536 41] [1553 242] [1569 21] [1575 21] [1731 22] [1731 30] [1778 32]]} (go/file "capi_tail.go" :imports [


(in-ns 'go.arbace.pyctypes) ^{:go/comments [[3 1 "// The C API's natives pythonapi's tests look up that the world's C does not reference (queue 598; doc/python/PYTHON-SURVEY.md,"] [4 1 "// \"As built: 598\"), each written after CPython 3.14.10's function of the same name: PyBytes_FromFormat (Objects/bytesobject.c's"] [5 1 "// PyBytes_FromFormatV) and PyUnicodeWriter_Format (Objects/unicodeobject.c). The PSF's license (LICENSE.md)."] [15 1 "// refTracer and refTracerData are PyRefTracer_SetTracer's (queue 598)."] [23 2 "// PyUnicodeWriter_Format(writer, format, ...): PyUnicode_FromFormatV's text written to the writer; on an error the"] [24 2 "// writer is left as it was (unicode_from_format restores the writer's position)"] [38 2 "// PyThreadState_SetAsyncExc(id, exc) (Python/pystate.c): exc raised in the thread of that ident at its next check of the"] [39 2 "// eval breaker, NULL clearing it; the number of thread states changed"] [43 2 "// the capsule's setters and getters (Objects/capsule.c): each checks is_legal_capsule first"] [100 2 "// PyThreadState_EnterTracing and LeaveTracing (Python/pystate.c): the current thread's tracing off and on again"] [103 2 "// PyThreadState_GetFrame (Python/pystate.c): a new reference to the thread's current Python frame, NULL when none"] [104 2 "// (the thread is the caller's: pyi's C runs on the Python thread that called it)"] [117 2 "// PyThreadState_GetID: the thread state's unique id (CPython's counter from 1: here the thread's ident, from 1 too)"] [119 2 "// PyUnstable_Object_ClearWeakRefsNoCallbacks (Objects/weakrefobject.c): the weak references cleared, no callback run"] [126 2 "// PyUnstable_Object_GC_NewWithExtraData(type, extra_size) (Python/gc.c): an object of the C type with extra_size"] [127 2 "// zeroed bytes after its tp_basicsize"] [139 2 "// PyUnicode_Resize(&unicode, length) (Objects/unicodeobject.c): *unicode replaced by the string of length characters,"] [140 2 "// its prefix kept and the rest NUL (CPython resizes in place a string no one else holds, else copies; the copy here,"] [141 2 "// pyi's strings being immutable values), the empty string for 0, unchanged for its own length"] [174 2 "// PyUnstable_GC_VisitObjects(callback, arg) (Python/gc.c): callback(obj, arg) for each object of the collector's"] [175 2 "// until it returns 0. The objects C can name are the ones it holds handles to, so those are visited (the containers"] [176 2 "// among them: the collector tracks no atoms), a snapshot taken first"] [203 2 "// PyRefTracer_SetTracer and GetTracer (Objects/object.c): the tracer kept; pyi's objects are Go's, so it is not"] [204 2 "// called at their creation and destruction (the moments the C API's reference counts do not model)"] [215 2 "// PyUnstable_Object_IsUniquelyReferenced (Objects/object.c): not immortal and a reference count of 1 (C's count on"] [216 2 "// the handle: Python's own references are Go's)"] [227 2 "// PyUnstable_Object_IsUniqueReferencedTemporary: uniquely referenced and that reference a value of the calling"] [228 2 "// frame's stack; pyi's frames keep Go values, which C cannot see, so never (CPython's own answer may be false too)"] [230 2 "// PyUnstable_EnableTryIncRef and PyUnstable_TryIncRef (Objects/object.c, the default build's): a live object's"] [231 2 "// reference count raised, 1"] [240 1 "// bytesFromFormat is PyBytes_FromFormatV: the format's bytes with its conversions over the variadic arguments (the width"] [241 1 "// ignored, the precision for %s, the l and z flags for %d and %u); an unknown conversion copies the rest of the format"] [242 1 "// unformatted and ends, %c outside [0; 255] OverflowError."] [327 4 "// glibc's and musl's %p: 0x and the hex digits (CPython ensures the leading 0x)"] [332 4 "// invalid format string: the rest copied unformatted"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[101 93] [102 93] [121 23] [183 32] [210 25] [261 12] [261 24] [274 8] [274 24] [318 22] [318 32]]} (go/file "capi_q598.go" :impor
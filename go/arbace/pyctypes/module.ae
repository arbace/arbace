9 3 "// PyCArg_repr: the value as its union member holds it (signed for b/B, h/H, i/I, l/L, q/Q)"] [611 2 "// function pointers"] [698 2 "// queue 456: test_clinic's and test_buffer's modules, from their C sources (244-4 (a)); py-eval-1122: xxlimited and"] [699 2 "// xxlimited_35, the limited API's example modules (test_xxlimited)"] [707 2 "// queue 521: the C accelerators, from CPython's Modules/_datetimemodule.c and Modules/_decimal/_decimal.c (libmpdec);"] [708 2 "// PYI_C_ACCEL=0 leaves them out (datetime and decimal then import their pure twins, _pydatetime and _pydecimal)"] [715 3 "// py-accel: _zoneinfo (Modules/_zoneinfo.c, over _datetime's C API) and _elementtree (Modules/_elementtree.c,"] [716 3 "// over the world's Expat through the capsule pyexpat.expat_CAPI its glue makes)"] [722 3 "// queue 568: _pickle (Modules/_pickle.c; its PickleBuffer pyi's, PyPickleBuffer_Type bound to it)"] [730 1 "// makeElementtreeModule is CPython's _elementtree (py-accel): pyexpat.expat_CAPI made over the world's Expat first"] [731 1 "// (the glue's pyi_expat_install), then the module from its PyInit (multi-phase), whose exec imports that capsule."] [756 1 "// datetimeTypesReady: _PyDateTime_InitTypes ran (once a process, as CPython's pycore_init_types)."] [759 1 "// makeDatetimeModule is CPython's _datetime (queue 521): the world's module made from its PyInit (multi-phase, its"] [760 1 "// Py_mod_exec), its static types readied and their dicts filled first by _PyDateTime_InitTypes, as CPython's core does"] [761 1 "// at the interpreter's start (the glue's pyi_datetime_init_types)."] [789 1 "// makeTestCAPIModule is CPython's _testcapi (queue 269), the world's module made from its PyInit (single-phase), over"] [790 1 "// the full API's layouts (capi_mirror.go): Modules/_testcapimodule.c and the parts of Modules/_testcapi/ lib.conf"] [791 1 "// builds: all 38 since queue 274b (monitoring.c, capi_monitoring.go)."] [797 1 "// makeLimitedModule is CPython's _testlimitedcapi (queue 262), the world's module made from its PyInit (single-phase:"] [798 1 "// PyModule_Create2's module, whose functions are bound to it), its parts built by ci but heaptype_relative.c and"] [799 1 "// vectorcall_limited.c (types from specs, not provided)."] [856 1 "// pointerSlice is Pointer_subscript's slice case."] [921 1 "// getset is a property-like descriptor (char arrays' value and raw)."] [943 1 "// ---- the module ----"] [949 1 "// closureAddr is the address of a native of the world (the module's helpers C code may call: _string_at_addr ...)."] [961 35 "// queue 598: array.buffer_info()'s address is the world's"] [976 2 "// ArgumentError(Exception), in the module ctypes"] [1025 63 "// queue 598"] [1042 53 "// queue 598"] [1055 62 "// queue 598"] [1069 2 "// dllist (callproc.c, where dl_iterate_phdr exists: ctypes.util.dllist)"] [1079 75 "// py_dl_sym's (queue 598)"] [1127 16 "// the instance's value learns its wrapper (its __dict__ is the wrapper's)"] [1146 66 "// queue 598"] [1157 2 "// call_function(address, arguments) and call_cdeclfunction (callproc.c, queue 598): the function at the address"] [1158 2 "// called with the arguments converted by ConvParam, its result a C int (_ctypes_callproc with no argument types and"] [1159 2 "// no result type)"] [1177 2 "// the helpers' addresses: libc's memmove and memset, and natives of the world for string_at, wstring_at, cast and"] [1178 2 "// memoryview_at (CPython's are C functions of _ctypes taking PyObject *: here natives over the handles)"] [1184 80 "// queue 598"] [1203 81 "// queue 598"] [1224 3 "// queue 260: a view of the world's memory in place (PyMemoryView_FromMemory, PyBUF_READ or PyBUF_WRITE)"] [1228 133 "// queue 598"] [1256 1 "// pendingErr is an exception a native helper (cast) raised, raised again by the call that called it."] [1259 1 "// castImpl is callproc.c's cast: an instance of ctype whose pointer is ptr, keeping src alive."] [1275 3 "// cast's: the result shares the source's b_objects (a dict made when it is None: PyCData_GetContainer"] [1276 3 "// first, then obj->b_objects itself), the source kept in it by its id (queue 261: test_p2a_objects)"] [1292 1 "// the module _ctypes_test: the C library's file name (CDLL(_ctypes_test.__file__) is the world) and the module"] [1293 1 "// functions of Modules/_ctypes/_ctypes_test.c that read its state (the C API's part, 244-3, is not given yet)"] [1303 1 "// makeTestModuleGo was the module's Go stand-in before the C API (kept for none; unused)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[32 38] [46 58] [59 48] [64 25] [65 24] [66 51] [79 38] [84 27] [87 49] [99 56] [116 26] [130 38] [138 27] [139 25] [140 24] [145 56] [172 38] [177 24] [180 27] [183 24] [186 24] [187 23] [191 56] [275 24] [301 47] [347 52] [363 31] [364 53] [365 30] [366 57] [392 22] [514 27] [589 20] [602 20] [603 30] [617 25] [632 68] [648 25] [663 51] [744 20] [775 21] [807 21] [807 29] [819 21] [819 29] [864 36] [873 34] [898 14] [898 21] [904 14] [904 21] [911 12] [911 19] [1025 48] [1042 38] [1055 47] [1079 60] [1094 28] [1136 39] [1146 51] [1184 65] [1203 66] [1228 118] [1274 23] [1282 32] [1283 51]]} (go/file "module.go" :imports [


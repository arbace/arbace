8 3 "// PyCArg_repr: the value as its union member holds it (signed for b/B, h/H, i/I, l/L, q/Q)"] [610 2 "// function pointers"] [697 2 "// queue 456: test_clinic's and test_buffer's modules, from their C sources (244-4 (a))"] [705 2 "// queue 521: the C accelerators, from CPython's Modules/_datetimemodule.c and Modules/_decimal/_decimal.c (libmpdec)"] [713 1 "// datetimeTypesReady: _PyDateTime_InitTypes ran (once a process, as CPython's pycore_init_types)."] [716 1 "// makeDatetimeModule is CPython's _datetime (queue 521): the world's module made from its PyInit (multi-phase, its"] [717 1 "// Py_mod_exec), its static types readied and their dicts filled first by _PyDateTime_InitTypes, as CPython's core does"] [718 1 "// at the interpreter's start (the glue's pyi_datetime_init_types)."] [746 1 "// makeTestCAPIModule is CPython's _testcapi (queue 269), the world's module made from its PyInit (single-phase), over"] [747 1 "// the full API's layouts (capi_mirror.go): Modules/_testcapimodule.c and the parts of Modules/_testcapi/ lib.conf"] [748 1 "// builds: all 38 since queue 274b (monitoring.c, capi_monitoring.go)."] [754 1 "// makeLimitedModule is CPython's _testlimitedcapi (queue 262), the world's module made from its PyInit (single-phase:"] [755 1 "// PyModule_Create2's module, whose functions are bound to it), its parts built by ci but heaptype_relative.c and"] [756 1 "// vectorcall_limited.c (types from specs, not provided)."] [813 1 "// pointerSlice is Pointer_subscript's slice case."] [878 1 "// getset is a property-like descriptor (char arrays' value and raw)."] [900 1 "// ---- the module ----"] [906 1 "// closureAddr is the address of a native of the world (the module's helpers C code may call: _string_at_addr ...)."] [932 2 "// ArgumentError(Exception), in the module ctypes"] [1065 16 "// the instance's value learns its wrapper (its __dict__ is the wrapper's)"] [1099 2 "// the helpers' addresses: libc's memmove and memset, and natives of the world for string_at, wstring_at, cast and"] [1100 2 "// memoryview_at (CPython's are C functions of _ctypes taking PyObject *: here natives over the handles)"] [1138 3 "// queue 260: a view of the world's memory in place (PyMemoryView_FromMemory, PyBUF_READ or PyBUF_WRITE)"] [1166 1 "// pendingErr is an exception a native helper (cast) raised, raised again by the call that called it."] [1169 1 "// castImpl is callproc.c's cast: an instance of ctype whose pointer is ptr, keeping src alive."] [1185 3 "// cast's: the result shares the source's b_objects (a dict made when it is None: PyCData_GetContainer"] [1186 3 "// first, then obj->b_objects itself), the source kept in it by its id (queue 261: test_p2a_objects)"] [1202 1 "// the module _ctypes_test: the C library's file name (CDLL(_ctypes_test.__file__) is the world) and the module"] [1203 1 "// functions of Modules/_ctypes/_ctypes_test.c that read its state (the C API's part, 244-3, is not given yet)"] [1213 1 "// makeTestModuleGo was the module's Go stand-in before the C API (kept for none; unused)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[31 38] [45 58] [58 48] [63 25] [64 24] [65 51] [78 38] [83 27] [86 49] [98 56] [115 26] [129 38] [137 27] [138 25] [139 24] [144 56] [171 38] [176 24] [179 27] [182 24] [185 24] [186 23] [190 56] [274 24] [300 47] [346 52] [362 31] [363 53] [364 30] [365 57] [391 22] [513 27] [588 20] [601 20] [602 30] [616 25] [631 68] [647 25] [662 51] [732 21] [764 21] [764 29] [776 21] [776 29] [821 36] [830 34] [855 14] [855 21] [861 14] [861 21] [868 12] [868 19] [1032 28] [1074 39] [1184 23] [1192 32] [1193 51]]} (go/file "module.go" :imports [


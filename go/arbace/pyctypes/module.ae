8 3 "// PyCArg_repr: the value as its union member holds it (signed for b/B, h/H, i/I, l/L, q/Q)"] [610 2 "// function pointers"] [697 2 "// queue 456: test_clinic's and test_buffer's modules, from their C sources (244-4 (a))"] [707 1 "// makeTestCAPIModule is CPython's _testcapi (queue 269), the world's module made from its PyInit (single-phase), over"] [708 1 "// the full API's layouts (capi_mirror.go): Modules/_testcapimodule.c and the parts of Modules/_testcapi/ lib.conf"] [709 1 "// builds: all 38 since queue 274b (monitoring.c, capi_monitoring.go)."] [715 1 "// makeLimitedModule is CPython's _testlimitedcapi (queue 262), the world's module made from its PyInit (single-phase:"] [716 1 "// PyModule_Create2's module, whose functions are bound to it), its parts built by ci but heaptype_relative.c and"] [717 1 "// vectorcall_limited.c (types from specs, not provided)."] [774 1 "// pointerSlice is Pointer_subscript's slice case."] [839 1 "// getset is a property-like descriptor (char arrays' value and raw)."] [861 1 "// ---- the module ----"] [867 1 "// closureAddr is the address of a native of the world (the module's helpers C code may call: _string_at_addr ...)."] [893 2 "// ArgumentError(Exception), in the module ctypes"] [1026 16 "// the instance's value learns its wrapper (its __dict__ is the wrapper's)"] [1060 2 "// the helpers' addresses: libc's memmove and memset, and natives of the world for string_at, wstring_at, cast and"] [1061 2 "// memoryview_at (CPython's are C functions of _ctypes taking PyObject *: here natives over the handles)"] [1099 3 "// queue 260: a view of the world's memory in place (PyMemoryView_FromMemory, PyBUF_READ or PyBUF_WRITE)"] [1127 1 "// pendingErr is an exception a native helper (cast) raised, raised again by the call that called it."] [1130 1 "// castImpl is callproc.c's cast: an instance of ctype whose pointer is ptr, keeping src alive."] [1146 3 "// cast's: the result shares the source's b_objects (a dict made when it is None: PyCData_GetContainer"] [1147 3 "// first, then obj->b_objects itself), the source kept in it by its id (queue 261: test_p2a_objects)"] [1163 1 "// the module _ctypes_test: the C library's file name (CDLL(_ctypes_test.__file__) is the world) and the module"] [1164 1 "// functions of Modules/_ctypes/_ctypes_test.c that read its state (the C API's part, 244-3, is not given yet)"] [1174 1 "// makeTestModuleGo was the module's Go stand-in before the C API (kept for none; unused)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[31 38] [45 58] [58 48] [63 25] [64 24] [65 51] [78 38] [83 27] [86 49] [98 56] [115 26] [129 38] [137 27] [138 25] [139 24] [144 56] [171 38] [176 24] [179 27] [182 24] [185 24] [186 23] [190 56] [274 24] [300 47] [346 52] [362 31] [363 53] [364 30] [365 57] [391 22] [513 27] [588 20] [601 20] [602 30] [616 25] [631 68] [647 25] [662 51] [725 21] [725 29] [737 21] [737 29] [782 36] [791 34] [816 14] [816 21] [822 14] [822 21] [829 12] [829 19] [993 28] [1035 39] [1145 23] [1153 32] [1154 51]]} (go/file "module.go" :imports [


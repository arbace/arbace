9 3 "// PyCArg_repr: the value as its union member holds it (signed for b/B, h/H, i/I, l/L, q/Q)"] [611 2 "// function pointers"] [698 2 "// queue 456: test_clinic's and test_buffer's modules, from their C sources (244-4 (a))"] [706 2 "// queue 521: the C accelerators, from CPython's Modules/_datetimemodule.c and Modules/_decimal/_decimal.c (libmpdec);"] [707 2 "// PYI_C_ACCEL=0 leaves them out (datetime and decimal then import their pure twins, _pydatetime and _pydecimal)"] [717 1 "// datetimeTypesReady: _PyDateTime_InitTypes ran (once a process, as CPython's pycore_init_types)."] [720 1 "// makeDatetimeModule is CPython's _datetime (queue 521): the world's module made from its PyInit (multi-phase, its"] [721 1 "// Py_mod_exec), its static types readied and their dicts filled first by _PyDateTime_InitTypes, as CPython's core does"] [722 1 "// at the interpreter's start (the glue's pyi_datetime_init_types)."] [750 1 "// makeTestCAPIModule is CPython's _testcapi (queue 269), the world's module made from its PyInit (single-phase), over"] [751 1 "// the full API's layouts (capi_mirror.go): Modules/_testcapimodule.c and the parts of Modules/_testcapi/ lib.conf"] [752 1 "// builds: all 38 since queue 274b (monitoring.c, capi_monitoring.go)."] [758 1 "// makeLimitedModule is CPython's _testlimitedcapi (queue 262), the world's module made from its PyInit (single-phase:"] [759 1 "// PyModule_Create2's module, whose functions are bound to it), its parts built by ci but heaptype_relative.c and"] [760 1 "// vectorcall_limited.c (types from specs, not provided)."] [817 1 "// pointerSlice is Pointer_subscript's slice case."] [882 1 "// getset is a property-like descriptor (char arrays' value and raw)."] [904 1 "// ---- the module ----"] [910 1 "// closureAddr is the address of a native of the world (the module's helpers C code may call: _string_at_addr ...)."] [936 2 "// ArgumentError(Exception), in the module ctypes"] [1069 16 "// the instance's value learns its wrapper (its __dict__ is the wrapper's)"] [1103 2 "// the helpers' addresses: libc's memmove and memset, and natives of the world for string_at, wstring_at, cast and"] [1104 2 "// memoryview_at (CPython's are C functions of _ctypes taking PyObject *: here natives over the handles)"] [1142 3 "// queue 260: a view of the world's memory in place (PyMemoryView_FromMemory, PyBUF_READ or PyBUF_WRITE)"] [1170 1 "// pendingErr is an exception a native helper (cast) raised, raised again by the call that called it."] [1173 1 "// castImpl is callproc.c's cast: an instance of ctype whose pointer is ptr, keeping src alive."] [1189 3 "// cast's: the result shares the source's b_objects (a dict made when it is None: PyCData_GetContainer"] [1190 3 "// first, then obj->b_objects itself), the source kept in it by its id (queue 261: test_p2a_objects)"] [1206 1 "// the module _ctypes_test: the C library's file name (CDLL(_ctypes_test.__file__) is the world) and the module"] [1207 1 "// functions of Modules/_ctypes/_ctypes_test.c that read its state (the C API's part, 244-3, is not given yet)"] [1217 1 "// makeTestModuleGo was the module's Go stand-in before the C API (kept for none; unused)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[32 38] [46 58] [59 48] [64 25] [65 24] [66 51] [79 38] [84 27] [87 49] [99 56] [116 26] [130 38] [138 27] [139 25] [140 24] [145 56] [172 38] [177 24] [180 27] [183 24] [186 24] [187 23] [191 56] [275 24] [301 47] [347 52] [363 31] [364 53] [365 30] [366 57] [392 22] [514 27] [589 20] [602 20] [603 30] [617 25] [632 68] [648 25] [663 51] [736 21] [768 21] [768 29] [780 21] [780 29] [825 36] [834 34] [859 14] [859 21] [865 14] [865 21] [872 12] [872 19] [1036 28] [1078 39] [1188 23] [1196 32] [1197 51]]} (go/file "module.go" :imports [


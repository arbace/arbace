(in-ns 'go.arbace.pyctypes) ^{:go/comments [[3 1 "// The limited C API's remainder (queue 268; doc/python/PYTHON-SURVEY.md, \"As built: 268\"): the functions of queue 262's"] [4 1 "// list of natives not provided (`.tmp/q262/missing.txt`) that the world's _testlimitedcapi reaches and pyi's objects"] [5 1 "// answer directly: dicts, sets, lists, tuples, ints, floats, complex numbers, bytes, bytearrays, the number, mapping"] [6 1 "// and sequence protocols, str's core, weak references, imports' module table, PyMem. Each follows its CPython 3.14.10"] [7 1 "// definition (Objects/dictobject.c, setobject.c, listobject.c, tupleobject.c, longobject.c, floatobject.c,"] [8 1 "// complexobject.c, bytesobject.c, bytearrayobject.c, abstract.c, unicodeobject.c, weakrefobject.c, Python/import.c,"] [9 1 "// Objects/obmalloc.c): the type checks and their messages, the operation through pyi's own (its type's method or"] [10 1 "// protocol, as CPython's calls the type's slot). The PSF's license (LICENSE.md)."] [21 1 "// callMeth calls o's method name with args."] [30 1 "// each calls f on each item of iter(o) until it returns an error (Iterate's)."] [38 1 "// callBuiltin calls builtins.name with args."] [47 1 "// opArgs are a native's object arguments, nil for NULL; err when one is NULL (null_error)."] [67 1 "// bigOf is o as an int (its __index__), CPython's _PyNumber_Index."] [79 1 "// asUnsigned is PyLong_AsUnsignedLong's family: o an int (no __index__), in [0, 2**bits)."] [98 1 "// asSignedBits is PyLong_AsInt32's family: o's __index__ in the signed range of bits."] [110 1 "// unsignedIndex is PyLong_AsUInt32's family: o's __index__ in [0, 2**bits)."] [127 1 "// storeInt writes the int v of size bytes at p (an output argument), when p is not NULL."] [144 2 "// ---- dicts (Objects/dictobject.c) ----"] [185 34 "// _PyErr_SetKeyError"] [209 2 "// PyDict_GetItem and GetItemString: borrowed, errors suppressed"] [313 2 "// PyDict_Next(d, Py_ssize_t *pos, PyObject **key, PyObject **value): borrowed references"] [358 2 "// ---- sets (Objects/setobject.c) ----"] [384 3 "// set_contains_key: the key hashed as is (set's `in` retries an unhashable set as a frozenset; PySet_Contains not)"] [410 4 "// a brand new frozenset (C holds its only reference: PyFrozenSet_New's) is filled in place"] [418 4 "// _PyErr_BadInternalCall(__FILE__, __LINE__) of Objects/setobject.c's PySet_Add (a frozenset too: pyi's are"] [419 4 "// never brand new to C)"] [446 2 "// ---- lists and tuples (Objects/listobject.c, tupleobject.c) ----"] [544 2 "// ---- ints (Objects/longobject.c) ----"] [592 2 "// longobject.c's messages, as they are"] [635 2 "// PyLong_AsInt32 (o, int32_t *out) and the family: 0, or -1 with an error"] [640 24 "// *value left as it was"] [656 2 "// ---- floats and complex numbers ----"] [675 3 "// a new sys.float_info (floatobject.c's PyFloat_GetInfo makes one each call)"] [706 2 "// ---- the number protocol (Objects/abstract.c) ----"] [736 2 "// ---- the mapping and sequence protocols ----"] [950 2 "// ---- bytes and bytearrays (Objects/bytesobject.c, bytearrayobject.c) ----"] [1102 2 "// ---- str's core (Objects/unicodeobject.c) ----"] [1417 3 "// PyUnicode_DecodeXXX(const char *s, Py_ssize_t size, const char *errors)"] [1465 2 "// ---- weak references (Objects/weakrefobject.c) ----"] [1489 2 "// ---- the module table (Python/import.c) ----"] [1518 2 "// PYC_MAGIC_NUMBER_TOKEN (Include/internal/pycore_magic_number.h: 3627, CPython 3.14's) as import.c gives it"] [1576 2 "// ---- memory (Objects/obmalloc.c) ----"] [1586 2 "// the inline accessors of the old limited versions, functions since 3.14's (Include/object.h)"] [1601 1 "// appendStr is PyUnicode_Append (PyObject **pleft, PyObject *right) and AppendAndDel."] [1634 1 "// cmpRunes is PyUnicode_Compare's order: by code point."] [1654 1 "// builtinMethod is a built-in type's method by name (list.sort)."] [1660 1 "// skipUnit is getargs.c's skipitem for convert's units: the unit at f[*p] passed over, its pointers taken."] [1673 1 "// getargsKeywords is PyArg_ParseTupleAndKeywords (Python/getargs.c, vgetargskeywords): the positional arguments and the"] [1674 1 "// keywords of kwargs (nil: none) converted by format into the pointers, the parameters named by kwlist (a char *[] in"] [1675 1 "// the world, NULL-terminated; empty names are positional-only)."] [1826 27 "// (without _Py_CalculateSuggestions' \"Did you mean\")"] [1838 1 "// parseKeywords is PyArg_ParseTupleAndKeywords's native."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[50 12] [50 19] [153 35] [186 51] [203 51] [277 26] [305 32] [385 23] [386 35] [409 24] [434 52] [517 29] [532 32] [532 39] [538 29] [758 25] [816 23] [942 26] [943 22] [964 22] [1069 26] [1070 56] [1108 25] [1145 23] [1180 14] [1180 26] [1481 25] [1511 22] [1567 174] [1590 25] [1637 12] [1637 40] [1679 17] [1679 35] [1684 40] [1686 47] [1698 14] [1698 30] [1719 6] [1719 22] [1805 15] [1805 44] [1806 45] [1819 16] [1819 32] [1849 77]]} (go/file "capi_more.go" :imports [


(in-ns 'go.arbace.pyctypes) ^{:go/comments [[3 1 "// Argument Clinic's C API and the buffer helpers of CPython's _testclinic, _testclinic_limited and _testbuffer (queue"] [4 1 "// 456; doc/python/PYTHON-SURVEY.md, \"As built: 456\"; the user's 244-4 (a): the _test* modules from their C sources on"] [5 1 "// ci): the parsers clinic's generated code calls (_PyArg_UnpackKeywords, _PyArg_ParseTupleAndKeywordsFast,"] [6 1 "// _PyArg_ParseStackAndKeywords: Python/getargs.c), the unsigned converters (Objects/longobject.c), the slice indices"] [7 1 "// (Python/ceval.c), PyErr_WarnEx (Python/_warnings.c) and the Py_buffer helpers (Objects/abstract.c,"] [8 1 "// Objects/memoryobject.c), ported from CPython 3.14.10; the PSF's license (LICENSE.md)."] [17 1 "// struct _PyArg_Parser's fields (Include/cpython/modsupport.h, LP64): format, keywords, fname, custom_msg, once (one"] [18 1 "// byte), is_kwtuple_owned, pos, min, max, kwtuple, next"] [25 1 "// argParser is a _PyArg_Parser as parser_init leaves it: the positional-only count, the keyword names (kwtuple's"] [26 1 "// strings), the function's name (empty: none) for the messages."] [36 1 "// argParsers are the parsers by address, initialized once (parser_init's once flag)."] [39 1 "// parserOf is parser_init: the keywords scanned (scan_keywords), the name from fname or the format's ':' part."] [76 1 "// who is the function as getargs.c's messages name it: \"NAME()\" or \"function\"."] [84 1 "// kwSource is a call's keywords: a dict (kwargs) or the names of a vectorcall with their values after the"] [85 1 "// positionals."] [99 1 "// find is find_keyword (or the dict's item): the value given for key, nil when none."] [112 1 "// unexpected is error_unexpected_keyword_arg: the first keyword no parameter takes, with the closest name as"] [113 1 "// _Py_CalculateSuggestions gives it."] [154 1 "// Str_ is a str object's text (its repr's for another object)."] [166 1 "// handles reads n handles at p as objects."] [176 1 "// kwSourceOf is the keywords of a call: kwargs (a dict handle) or kwnames (a tuple handle, its values at"] [177 1 "// args+8*nargs)."] [197 1 "// unpackKeywords is _PyArg_UnpackKeywords: the arguments in buf, positionals first, then each keyword parameter's"] [198 1 "// value (NULL for an omitted optional one); the address of the arguments (args itself on the fast path)."] [289 1 "// parseFast is vgetargskeywordsfast_impl over the existing keyword parser: the positionals and the keywords (a dict)"] [290 1 "// converted by the parser's format against its keyword list."] [312 1 "// isIndex is PyIndex_Check: the type has nb_index."] [324 1 "// ---- the Py_buffer helpers (Objects/abstract.c, Objects/memoryobject.c) ----"] [326 1 "// pyView is a Py_buffer read from the world: its fields, shape, strides (C's when NULL) and suboffsets (nil: NULL)."] [363 1 "// contiguous is _IsCContiguous ('C') and _IsFortranContiguous ('F')."] [399 1 "// isContiguous is PyBuffer_IsContiguous."] [413 1 "// pointer is PyBuffer_GetPointer."] [426 1 "// toContiguous is PyBuffer_ToContiguous: the items copied in order ('F' Fortran's, else C's) into buf."] [464 1 "// clinicTable: this file's natives."] [475 2 "// _PyArg_ParseTupleAndKeywordsFast(args, kwargs, parser, ...)"] [496 2 "// _PyArg_ParseStackAndKeywords(args, nargs, kwnames, parser, ...)"] [510 2 "// _PyTuple_FromArray (Objects/tupleobject.c): a tuple of n items at src (new references to them)"] [521 2 "// PyErr_WarnEx (Python/_warnings.c): warnings.warn(message, category, stack_level); NULL is RuntimeWarning"] [539 2 "// the unsigned converters (Objects/longobject.c's UNSIGNED_INT_CONVERTER): PyLong_AsNativeBytes with"] [540 2 "// NATIVE_ENDIAN | ALLOW_INDEX | REJECT_NEGATIVE | UNSIGNED_BUFFER"] [561 2 "// _PyEval_SliceIndex (Python/ceval.c): 1 and *pi set (None leaves it), 0 with the error"] [589 2 "// _Py_convert_optional_to_ssize_t (Python/modsupport.c): None leaves *result, an index clamps no: an"] [590 2 "// overflow's OverflowError (PyNumber_AsSsize_t(obj, PyExc_OverflowError))"] [613 2 "// _PyObject_IsFreed (Objects/object.c): a live handle is never freed memory"] [615 2 "// PyObject_CallFunctionObjArgs (Objects/call.c): the arguments up to the NULL"] [630 2 "// PyMem_Realloc (Objects/obmalloc.c): the world's realloc (musl's), a NULL block a malloc"] [649 2 "// PyMemoryView_FromMemory (Objects/memoryobject.c): a view of the world's memory in place, PyBUF_READ (0x100) or"] [650 2 "// PyBUF_WRITE (0x200)"] [664 1 "// errInt0 sets the error indicator and gives 0 (getargs.c's failure)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[41 24] [47 39] [47 67] [53 17] [53 31] [59 36] [61 41] [64 42] [105 23] [144 66] [145 63] [156 22] [254 19] [254 30] [257 35] [257 48] [275 19] [275 37] [304 34] [338 12] [338 25] [355 23] [355 31] [382 23] [382 31] [390 12] [390 25] [417 12] [417 25] [443 19] [443 30] [446 14] [446 27] [447 16] [453 24] [453 32] [454 16] [489 60] [503 73] [516 20] [516 32] [531 71] [568 34] [582 34]]} (go/file "capi_clinic.go" :imports [


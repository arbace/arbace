(in-ns 'go.arbace.pyctypes) ^{:go/comments [[3 1 "// PyConfig_Get, PyConfig_GetInt and PyConfig_Names (Python/initconfig.c, CPython 3.14.10; PEP 741): the configuration"] [4 1 "// pyi runs with, read as CPython's config_get reads it. _testcapi's config_get (Modules/_testcapi/config.c) calls"] [5 1 "// PyConfig_Get, and test.support.requires_debug_ranges() asks it for code_debug_ranges at the import of test_compile,"] [6 1 "// test_dis, test_marshal and test_code (2026-11-19, n-py-eval). The members CPython reads from sys (a SYS_ATTR, and"] [7 1 "// write_bytecode and int_max_str_digits) are read from sys here too; the others, which CPython keeps in the"] [8 1 "// interpreter's PyConfig, are pyi's own: its sys.flags where they mirror the member, else CPython's default for a"] [9 1 "// python3 started from its command line. The PSF's license (LICENSE.md)."] [18 1 "// configKind is a PyConfigSpec member's type (PyConfig_MEMBER_*)."] [31 1 "// configSpec is a PyConfigSpec: the member's name, type, the sys attribute CPython reads it from (SYS_ATTR), else the"] [32 1 "// sys.flags field that mirrors it (with not: the flag is the member negated), else nothing (the default's)."] [41 1 "// configSpecs is PYCONFIG_SPEC's public and read-only members, then PYPRECONFIG_SPEC's read-only ones (linux, no"] [42 1 "// Py_STATS, Py_DEBUG or Py_GIL_DISABLED): PyConfig_Names' set, in CPython's order."] [106 2 "// PYPRECONFIG_SPEC"] [123 1 "// sysAttr is sys.NAME, or _PySys_GetRequiredAttrString's RuntimeError \"lost sys.NAME\"."] [139 1 "// sysFlag is sys.flags.NAME as an int (0 when pyi's sys.flags has no such field)."] [162 1 "// xoption is sys._xoptions.get(name) (nil when absent)."] [174 1 "// sysValue is sys.NAME() (nil on an error)."] [183 1 "// configDefault is a member CPython keeps in the interpreter's PyConfig, as pyi's start sets it (a python3 run from its"] [184 1 "// command line with the environment pyi reads)."] [218 3 "// the start's: -u (bin/pyi python's PYI_UNBUFFERED, which the start reads and removes) or PYTHONUNBUFFERED"] [294 1 "// configGet is CPython's config_get with use_sys, for pyi."] [356 1 "// configPublic are PYCONFIG_SPEC's public members (PyConfig_Set may set them; the rest of configSpecs is read-only)."] [363 1 "// configFlagOf are the sys.flags fields of the public members PyConfig_Set writes through _PySys_SetFlagObj (the"] [364 1 "// member negated for use_environment and write_bytecode)."] [373 1 "// configSet is CPython's PyConfig_Set (Python/initconfig.c): the value checked by the member's type, then a sys"] [374 1 "// attribute set, or sys.flags replaced by a new flags object with the field set (write_bytecode also"] [375 1 "// sys.dont_write_bytecode), or int_max_str_digits through sys.set_int_max_str_digits."] [377 55 "// PySys_Audit(\"cpython.PyConfig_Set\", \"sO\", name, value)"] [413 37 "// a bool member keeps 0 or 1"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[149 23] [150 23] [168 23] [194 23] [203 45] [258 36] [259 25] [269 35] [270 43] [276 33] [331 23] [332 25] [377 40] [382 89] [466 32] [474 46] [488 50]] :go/trails [[111 48]]} (go/file "capi_config.go" :imports [


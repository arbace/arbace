(in-ns 'go.arbace.pyctypes) ^{:go/comments [[3 1 "// The limited C API's next slices (queue 262; doc/python/PYTHON-SURVEY.md, \"As built: 262\"; the user's 244-3 (a) and"] [4 1 "// 244-4 (a)): the functions CPython 3.14.10's Modules/_testlimitedcapi (built by ci into the world beside"] [5 1 "// _ctypes_test) and the pythonapi tests reach, as natives over the handles, ported from CPython 3.14.10's"] [6 1 "// Objects/ (capsule.c, sliceobject.c, moduleobject.c, abstract.c, object.c, longobject.c), Python/ (getargs.c,"] [7 1 "// modsupport.c, ceval.c, sysmodule.c, errors.c, pystrcmp.c, getversion.c) and Include/ (the limited API's"] [8 1 "// declarations, the constants). The PSF's license (LICENSE.md)."] [9 1 "//"] [10 1 "// A function the world's C calls and pyi does not provide is a native that raises NotImplementedError \"pyi's C API"] [11 1 "// does not provide NAME\" (capiMissing: the C stack unwound to the Python call that entered C, as a longjmp would),"] [12 1 "// so a module of the world loads whole and each of its functions fails alone, by a message the classes match."] [25 1 "// capiMissing is the panic of a C API function pyi does not provide."] [28 1 "// missingNative is the native of an undefined C API function."] [33 1 "// recoverMissing turns a capiMissing panic into the Python exception *err (the C stack is restored by World.guard)."] [45 1 "// isCAPIName is a name of the C API (its functions' prefixes)."] [50 1 "// bindMissing makes every undefined C API function of the world a missingNative."] [63 1 "// ---- the C API's data: types and exceptions ----"] [65 1 "// capiTypes are the type objects the limited API names as data (Include/*object.h's PyAPI_DATA(PyTypeObject))."] [78 1 "// cMethodType is PyCMethod_Type (Objects/methodobject.c, queue 481, 475-1 (a)): \"builtin_method\", a subtype of"] [79 1 "// builtin_function_or_method, which the full API's PyCMethod_Check and PyCFunction_GET_CLASS compare with. pyi's own"] [80 1 "// METH_METHOD functions stay builtin_function_or_method's instances."] [88 1 "// bindTypes binds the type objects' structs first (queue 269: every handle made after names them, as ob_type and"] [89 1 "// tp_base), then fills each as CPython's PyTypeObject."] [104 2 "// the types the full API's macros name that pyi's runtime has under another module's name (PyFunction_Check,"] [105 2 "// PyWeakref_CheckRef ...): bound by the type the module gives"] [138 1 "// capsuleType is PyCapsule's type (py's)."] [141 1 "// bindData binds the world's C API data: the type objects' structs become the types' handles, each PyExc_NAME"] [142 1 "// pointer the handle of builtins.NAME, _Py_EllipsisObject and _Py_NotImplementedStruct their singletons'."] [168 1 "// The offsets of _PyRuntime.static_objects.singletons.strings' one-character strings, as ci lays out CPython 3.14.10's"] [169 1 "// _PyRuntimeState (Include/internal/pycore_runtime_structs.h, pycore_global_strings.h) on 64 bits: the node program's"] [170 1 "// _Py_LATIN1_CHR reads them (_testclinic's deprecation checks: PySequence_Contains(kwnames, _Py_LATIN1_CHR('c'))) and"] [171 1 "// _PyLong_GetZero's static_objects offset."] [173 48 "// offsetof(_PyRuntimeState, static_objects)"] [174 48 "// .singletons (first), then .strings in it"] [175 48 "// .ascii[128]: struct { PyASCIIObject _ascii; uint8_t _data[2]; }"] [176 48 "// .latin1[128]: struct { PyCompactUnicodeObject _latin1; uint8_t _data[2]; }"] [179 27 "// sizeof(_PyRuntimeState): the static's size the offsets are checked against"] [182 1 "// bindStaticStrings binds _PyRuntime's static one-character strings (queue 475, 473-3 (a); Include/internal/"] [183 1 "// pycore_unicodeobject.h's _Py_LATIN1_CHR, a C module built with Py_BUILD_CORE): each of the 256 slots becomes the"] [184 1 "// handle of a str of its character, immortal, with its compact layout written in place (CPython's"] [185 1 "// _PyASCIIObject_INIT and _PyUnicode_LATIN1_INIT: ASCII ones a PyASCIIObject, the others a PyCompactUnicodeObject),"] [186 1 "// so C reads a real object there. Nothing when the world has no _PyRuntime or it is not the size these offsets are of."] [187 1 "// (_Py_ID's identifiers and _Py_STR's literals before the arrays: no C of the world names one.)"] [210 1 "// The small ints (Include/internal/pycore_runtime_structs.h): _PyRuntime.static_objects.singletons.small_ints, the"] [211 1 "// singletons' first member, PyLongObject[_PY_NSMALLNEGINTS + _PY_NSMALLPOSINTS] for -5..256, 32 bytes each on 64 bits"] [212 1 "// (PyObject_HEAD, lv_tag, one 30-bit digit, padded); strings' offset above, 20712, is theirs, bytes_empty's (40) and"] [213 1 "// bytes_characters' (256 of 48) summed."] [219 27 "// pycore_long.h's IMMORTALITY_BIT_MASK in lv_tag: _PyLong_IsSmallInt"] [222 1 "// bindSmallInts binds _PyRuntime's small ints (queue 481, 475-2 (a); pycore_long.h's _PyLong_GetZero, _PyLong_GetOne,"] [223 1 "// _PyLong_SMALL_INTS): each slot becomes the handle of pyi's interned int of its value (NewInt's -5..256), immortal,"] [224 1 "// its PyLongObject written in place with lv_tag's immortality bit as _PyLong_DIGIT_INIT writes it, so a C module's"] [225 1 "// first use, a read of the static or PyLong_FromLong's handle, sees CPython's object: Py_IS_TYPE, the value, and"] [226 1 "// _PyLong_IsSmallInt true for these and only these. They are bound when the world's data is (a C module's first use of"] [227 1 "// the world): C reads the static in place, with no call pyctypes could bind them on later. Nothing when the world has"] [228 1 "// no _PyRuntime or it is not the size these offsets are of."] [253 1 "// ---- helpers ----"] [255 1 "// excOf is the exception object the error indicator holds (nil: none)."] [263 1 "// badInternalCall is PyErr_BadInternalCall's SystemError."] [266 1 "// errInt sets the error indicator and gives the int -1."] [272 1 "// result is a new reference to o, or C's NULL with err set."] [280 1 "// cstrOrNil is a C string argument (nil for NULL)."] [288 1 "// fromUTF8 is PyUnicode_FromString's decoding of a C string."] [297 1 "// keepCString is s as a C string that lives as long as the process (a const char * the C API returns as borrowed"] [298 1 "// from an object CPython would hold: tp_name, ml_name, a version string), made once per distinct string."] [310 1 "// ssize is a Py_ssize_t clamp of an int (PyLong_AsSsize_t's overflow aside)."] [323 1 "// asLong is PyLong_AsLong (Objects/longobject.c): an int, or an object with __index__."] [339 1 "// asUnsignedMask is PyLong_AsUnsignedLongMask: the int's low 64 bits."] [349 1 "// ---- modules (Objects/moduleobject.c, Python/modsupport.c) ----"] [351 1 "// moduleOf is the module (or its dict) a module handle names."] [359 1 "// addFunctions is PyModule_AddFunctions: each PyMethodDef of the table at defs a built-in function of the module,"] [360 1 "// its self the module."] [388 1 "// cMethod is a PyCFunction of the world bound to self (PyCFunction_NewEx's object)."] [396 2 "// a type's method (queue 268): self is the call's first argument (selfFirst, but METH_STATIC's), defining its"] [397 2 "// type (METH_METHOD's defining_class), qual its name in the messages (Type.name)"] [407 1 "// Builtin is the method as pyi's built-in function."] [412 1 "// call is the vectorcall of a PyCFunction (Objects/methodobject.c: cfunction_call and the METH_* trampolines)."] [416 2 "// the messages name the function as _PyObject_FunctionStr does: module.name() (Objects/methodobject.c)"] [438 25 "// METH_METHOD | METH_FASTCALL | METH_KEYWORDS: (self, defining_class, args, nargsf, kwnames)"] [459 24 "// METH_FASTCALL (| METH_KEYWORDS)"] [481 23 "// METH_NOARGS"] [487 23 "// METH_O"] [493 11 "// METH_VARARGS (| METH_KEYWORDS)"] [533 1 "// moduleFromDef is PyModule_Create2's module: m_name, m_doc and m_methods of the PyModuleDef at def."] [539 24 "// queue 270b: PyModule_GetDef"] [541 46 "// md_state (queue 269: PyModule_GetState), zeroed"] [554 1 "// ---- PyArg_Parse, PyArg_ParseTuple (Python/getargs.c) ----"] [556 1 "// vgetargs is vgetargs1_impl: the arguments (one, compat, for PyArg_Parse) converted by format into the pointers."] [644 2 "// a unit left that is no unit's start (vgetargs1_impl's check; py-eval-1122: xxlimited_35's roj, \"O#\")"] [653 1 "// seterror is getargs.c's seterror: a conversion's message as \"fname() argument N must be ...\"."] [677 1 "// argState is the va_list of the pointers the units store through."] [681 21 "// converttuple's item numbers of the failing unit (queue 270)"] [682 21 "// the Py_buffers filled, released on failure (freelist)"] [683 21 "// the pointers to the encoded strings' blocks, freed on failure"] [684 21 "// the O& converters that returned Py_CLEANUP_SUPPORTED and their addresses (queue 270b)"] [687 1 "// convert is convertitem (queue 270: the parenthesized tuples, capi_getargs.go): a failure's message or error, the"] [688 1 "// buffers and blocks the call filled given back on failure as cleanreturn's freelist."] [705 1 "// convertBuffer is convertbuffer: a bytes' contents, else the message of an object whose buffer is not read-only"] [706 1 "// (its type has bf_releasebuffer: bytearray, memoryview, array ...) (nil and no message: it has none, getbuffer's TypeError; queue 270)."] [719 1 "// noBuffer is PyObject_GetBuffer's TypeError for an object with no buffer (getbuffer's pending exception)."] [724 1 "// converterr is getargs.c's converterr."] [736 1 "// convert is convertsimple's units (b B h H i I n l k L K f d p y y# s s# z z# O O! and the tuple units aside):"] [737 1 "// a message (the conversion's failure) or an error (an exception the conversion raised)."] [903 12 "// a bytes or bytearray of length 1 as a char (getargs.c's convertsimple, queue 269)"] [918 12 "// a str of length 1 as an int (its code point)"] [935 1 "// ---- Py_BuildValue (Python/modsupport.c) ----"] [937 1 "// buildValue is Py_BuildValue's do_mkvalue over the format's units and the variadic arguments."] [1055 2 "// the top level: one unit is its value, none is None, several a tuple"] [1077 1 "// ---- capsules (Objects/capsule.c) ----"] [1079 1 "// cCapsule is a capsule C made: its pointer, name (0: NULL), context and destructor in the world."] [1106 1 "// newCapsule is PyCapsule_New: a capsule of py's PyCapsule type, its destructor called on the library's next call"] [1107 1 "// after the capsule is collected."] [1122 5 "// the destructor gets the capsule (a fresh handle: the capsule is Go's until the call ends)"] [1133 1 "// capsuleImport is PyCapsule_Import."] [1167 1 "// decodeReplace is PyUnicode_FromFormat's %s: UTF-8 decoded with \"replace\"."] [1176 1 "// ---- slices (Objects/sliceobject.c) ----"] [1180 1 "// evalSliceIndex is _PyEval_SliceIndex: None leaves *v, an index clamps to Py_ssize_t."] [1206 1 "// sliceUnpack is PySlice_Unpack."] [1241 1 "// sliceAdjust is PySlice_AdjustIndices."] [1285 1 "// sliceGetIndices is PySlice_GetIndices: -1 without an exception for what it refuses."] [1338 1 "// ---- the frames (Python/ceval.c) ----"] [1340 1 "// callerFrame is the Python frame that called C (sys._getframe(0) seen from the native)."] [1361 1 "// frameLocals is PyEval_GetFrameLocals: a function's locals as a dict snapshot (PEP 667), a module's or class's"] [1362 1 "// namespace itself."] [1374 1 "// funcName and funcDesc are PyEval_GetFuncName and PyEval_GetFuncDesc."] [1410 1 "// sysCall calls sys.NAME(args...)."] [1423 1 "// sysGetObject is PySys_GetObject: sys's attribute (nil when absent; a decoding error is unraisable)."] [1442 1 "// ---- the natives ----"] [1444 1 "// version strings (Python/getversion.c, getplatform.c, getcopyright.c, getcompiler.c, Modules/getbuildinfo.c)"] [1460 2 "// version and build"] [1465 2 "// _Py_GetBuiltWithAssert (Python/getversion.c's): pyi's own runtime asserts nothing in C"] [1474 2 "// modules"] [1556 2 "// argument parsing and building"] [1581 2 "// errors (Python/errors.c)"] [1681 2 "// capsules"] [1715 2 "// the evaluation's state"] [1745 2 "// frames (Obje
(in-ns 'go.arbace.pyctypes) ^{:go/comments [[3 1 "// The limited C API's next slices (queue 262; doc/python/PYTHON-SURVEY.md, \"As built: 262\"; the user's 244-3 (a) and"] [4 1 "// 244-4 (a)): the functions CPython 3.14.10's Modules/_testlimitedcapi (built by ci into the world beside"] [5 1 "// _ctypes_test) and the pythonapi tests reach, as natives over the handles, ported from CPython 3.14.10's"] [6 1 "// Objects/ (capsule.c, sliceobject.c, moduleobject.c, abstract.c, object.c, longobject.c), Python/ (getargs.c,"] [7 1 "// modsupport.c, ceval.c, sysmodule.c, errors.c, pystrcmp.c, getversion.c) and Include/ (the limited API's"] [8 1 "// declarations, the constants). The PSF's license (LICENSE.md)."] [9 1 "//"] [10 1 "// A function the world's C calls and pyi does not provide is a native that raises NotImplementedError \"pyi's C API"] [11 1 "// does not provide NAME\" (capiMissing: the C stack unwound to the Python call that entered C, as a longjmp would),"] [12 1 "// so a module of the world loads whole and each of its functions fails alone, by a message the classes match."] [25 1 "// capiMissing is the panic of a C API function pyi does not provide."] [28 1 "// missingNative is the native of an undefined C API function."] [33 1 "// recoverMissing turns a capiMissing panic into the Python exception *err (the C stack is restored by World.guard)."] [45 1 "// isCAPIName is a name of the C API (its functions' prefixes)."] [50 1 "// bindMissing makes every undefined C API function of the world a missingNative."] [63 1 "// ---- the C API's data: types and exceptions ----"] [65 1 "// capiTypes are the type objects the limited API names as data (Include/*object.h's PyAPI_DATA(PyTypeObject))."] [75 1 "// capsuleType is PyCapsule's type (py's)."] [78 1 "// bindData binds the world's C API data: the type objects' structs become the types' handles, each PyExc_NAME"] [79 1 "// pointer the handle of builtins.NAME, _Py_EllipsisObject and _Py_NotImplementedStruct their singletons'."] [108 1 "// ---- helpers ----"] [110 1 "// excOf is the exception object the error indicator holds (nil: none)."] [118 1 "// badInternalCall is PyErr_BadInternalCall's SystemError."] [121 1 "// errInt sets the error indicator and gives the int -1."] [127 1 "// result is a new reference to o, or C's NULL with err set."] [135 1 "// cstrOrNil is a C string argument (nil for NULL)."] [143 1 "// fromUTF8 is PyUnicode_FromString's decoding of a C string."] [152 1 "// keepCString is s as a C string that lives as long as the process (a const char * the C API returns as borrowed"] [153 1 "// from an object CPython would hold: tp_name, ml_name, a version string), made once per distinct string."] [165 1 "// ssize is a Py_ssize_t clamp of an int (PyLong_AsSsize_t's overflow aside)."] [178 1 "// asLong is PyLong_AsLong (Objects/longobject.c): an int, or an object with __index__."] [194 1 "// asUnsignedMask is PyLong_AsUnsignedLongMask: the int's low 64 bits."] [204 1 "// ---- modules (Objects/moduleobject.c, Python/modsupport.c) ----"] [206 1 "// moduleOf is the module (or its dict) a module handle names."] [214 1 "// addFunctions is PyModule_AddFunctions: each PyMethodDef of the table at defs a built-in function of the module,"] [215 1 "// its self the module."] [243 1 "// cMethod is a PyCFunction of the world bound to self (PyCFunction_NewEx's object)."] [257 1 "// Builtin is the method as pyi's built-in function."] [262 1 "// call is the vectorcall of a PyCFunction (Objects/methodobject.c: cfunction_call and the METH_* trampolines)."] [266 2 "// the messages name the function as _PyObject_FunctionStr does: module.name() (Objects/methodobject.c)"] [278 24 "// METH_FASTCALL (| METH_KEYWORDS)"] [300 23 "// METH_NOARGS"] [306 23 "// METH_O"] [312 11 "// METH_VARARGS (| METH_KEYWORDS)"] [352 1 "// moduleFromDef is PyModule_Create2's module: m_name, m_doc and m_methods of the PyModuleDef at def."] [369 1 "// ---- PyArg_Parse, PyArg_ParseTuple (Python/getargs.c) ----"] [371 1 "// vgetargs is vgetargs1_impl: the arguments (one, compat, for PyArg_Parse) converted by format into the pointers."] [462 1 "// seterror is getargs.c's seterror: a conversion's message as \"fname() argument N must be ...\"."] [486 1 "// argState is the va_list of the pointers the units store through."] [500 1 "// converterr is getargs.c's converterr."] [512 1 "// convert is convertsimple's units (b B h H i I n l k L K f d p y y# s s# z z# O O! and the tuple units aside):"] [513 1 "// a message (the conversion's failure) or an error (an exception the conversion raised)."] [640 4 "// getbuffer's PyObject_GetBuffer raised (the message is the buffer protocol's)"] [675 1 "// ---- Py_BuildValue (Python/modsupport.c) ----"] [677 1 "// buildValue is Py_BuildValue's do_mkvalue over the format's units and the variadic arguments."] [795 2 "// the top level: one unit is its value, none is None, several a tuple"] [817 1 "// ---- capsules (Objects/capsule.c) ----"] [819 1 "// cCapsule is a capsule C made: its pointer, name (0: NULL), context and destructor in the world."] [846 1 "// newCapsule is PyCapsule_New: a capsule of py's PyCapsule type, its destructor called on the library's next call"] [847 1 "// after the capsule is collected."] [862 5 "// the destructor gets the capsule (a fresh handle: the capsule is Go's until the call ends)"] [873 1 "// capsuleImport is PyCapsule_Import."] [907 1 "// decodeReplace is PyUnicode_FromFormat's %s: UTF-8 decoded with \"replace\"."] [916 1 "// ---- slices (Objects/sliceobject.c) ----"] [920 1 "// evalSliceIndex is _PyEval_SliceIndex: None leaves *v, an index clamps to Py_ssize_t."] [946 1 "// sliceUnpack is PySlice_Unpack."] [981 1 "// sliceAdjust is PySlice_AdjustIndices."] [1025 1 "// sliceGetIndices is PySlice_GetIndices: -1 without an exception for what it refuses."] [1078 1 "// ---- the frames (Python/ceval.c) ----"] [1080 1 "// callerFrame is the Python frame that called C (sys._getframe(0) seen from the native)."] [1101 1 "// frameLocals is PyEval_GetFrameLocals: a function's locals as a dict snapshot (PEP 667), a module's or class's"] [1102 1 "// namespace itself."] [1114 1 "// funcName and funcDesc are PyEval_GetFuncName and PyEval_GetFuncDesc."] [1150 1 "// sysCall calls sys.NAME(args...)."] [1163 1 "// sysGetObject is PySys_GetObject: sys's attribute (nil when absent; a decoding error is unraisable)."] [1182 1 "// ---- the natives ----"] [1184 1 "// version strings (Python/getversion.c, getplatform.c, getcopyright.c, getcompiler.c, Modules/getbuildinfo.c)"] [1200 2 "// version and build"] [1205 2 "// _Py_GetBuiltWithAssert (Python/getversion.c's): pyi's own runtime asserts nothing in C"] [1214 2 "// modules"] [1296 2 "// argument parsing and building"] [1321 2 "// errors (Python/errors.c)"] [1421 2 "// capsules"] [1455 2 "// the evaluation's state"] [1485 2 "// frames (Objects/frameobject.c: PyFrame_GetLocals and the others, new references)"] [1521 2 "// the GIL (Python/pystate.c): pyi's threads hold it when they run Python, so a thread that calls C holds it"] [1522 2 "// already: PyGILState_Ensure gives PyGILState_LOCKED (0) and Release has nothing to give back"] [1526 2 "// sys (Python/sysmodule.c)"] [1566 2 "// slices"] [1638 2 "// strings compared (Python/pystrcmp.c)"] [1671 1 "// cstr8 is a C string argument's bytes (nil for NULL)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[35 19] [36 31] [54 30] [83 27] [88 27] [100 43] [101 25] [112 27] [208 25] [223 16] [223 25] [234 30] [268 29] [335 19] [358 30] [361 29] [362 34] [377 12] [377 24] [424 46] [450 12] [450 19] [563 48] [631 26] [637 35] [730 14] [730 32] [731 42] [926 45] [951 41] [966 49] [975 47] [1028 26] [1108 23] [1117 46] [1123 46] [1124 24] [1129 26] [1137 46] [1144 26] [1190 39] [1191 23] [1219 55] [1242 60] [1256 60] [1263 62] [1299 23] [1302 53] [1314 58] [1332 28] [1359 103] [1365 29] [1367 31] [1368 28] [1407 24] [1416 20] [1480 74] [1543 23] [1560 24] [1569 24] [1652 13] [1652 103]]} (go/file "capi_limited.go" :
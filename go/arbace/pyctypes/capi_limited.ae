(in-ns 'go.arbace.pyctypes) ^{:go/comments [[3 1 "// The limited C API's next slices (queue 262; doc/python/PYTHON-SURVEY.md, \"As built: 262\"; the user's 244-3 (a) and"] [4 1 "// 244-4 (a)): the functions CPython 3.14.10's Modules/_testlimitedcapi (built by ci into the world beside"] [5 1 "// _ctypes_test) and the pythonapi tests reach, as natives over the handles, ported from CPython 3.14.10's"] [6 1 "// Objects/ (capsule.c, sliceobject.c, moduleobject.c, abstract.c, object.c, longobject.c), Python/ (getargs.c,"] [7 1 "// modsupport.c, ceval.c, sysmodule.c, errors.c, pystrcmp.c, getversion.c) and Include/ (the limited API's"] [8 1 "// declarations, the constants). The PSF's license (LICENSE.md)."] [9 1 "//"] [10 1 "// A function the world's C calls and pyi does not provide is a native that raises NotImplementedError \"pyi's C API"] [11 1 "// does not provide NAME\" (capiMissing: the C stack unwound to the Python call that entered C, as a longjmp would),"] [12 1 "// so a module of the world loads whole and each of its functions fails alone, by a message the classes match."] [25 1 "// capiMissing is the panic of a C API function pyi does not provide."] [28 1 "// missingNative is the native of an undefined C API function."] [33 1 "// recoverMissing turns a capiMissing panic into the Python exception *err (the C stack is restored by World.guard)."] [45 1 "// isCAPIName is a name of the C API (its functions' prefixes)."] [50 1 "// bindMissing makes every undefined C API function of the world a missingNative."] [63 1 "// ---- the C API's data: types and exceptions ----"] [65 1 "// capiTypes are the type objects the limited API names as data (Include/*object.h's PyAPI_DATA(PyTypeObject))."] [74 49 "// queue 568: _pickle adds it to its module"] [79 1 "// cMethodType is PyCMethod_Type (Objects/methodobject.c, queue 481, 475-1 (a)): \"builtin_method\", a subtype of"] [80 1 "// builtin_function_or_method, which the full API's PyCMethod_Check and PyCFunction_GET_CLASS compare with. pyi's own"] [81 1 "// METH_METHOD functions stay builtin_function_or_method's instances."] [89 1 "// bindTypes binds the type objects' structs first (queue 269: every handle made after names them, as ob_type and"] [90 1 "// tp_base), then fills each as CPython's PyTypeObject."] [105 2 "// the types the full API's macros name that pyi's runtime has under another module's name (PyFunction_Check,"] [106 2 "// PyWeakref_CheckRef ...): bound by the type the module gives"] [112 3 "// queue 568: the singletons' types _pickle's save compares with"] [140 22 "// queue 521"] [143 1 "// capsuleType is PyCapsule's type (py's)."] [146 1 "// bindData binds the world's C API data: the type objects' structs become the types' handles, each PyExc_NAME"] [147 1 "// pointer the handle of builtins.NAME, _Py_EllipsisObject and _Py_NotImplementedStruct their singletons'."] [157 20 "// queue 521"] [174 1 "// The offsets of _PyRuntime.static_objects.singletons.strings' one-character strings, as ci lays out CPython 3.14.10's"] [175 1 "// _PyRuntimeState (Include/internal/pycore_runtime_structs.h, pycore_global_strings.h) on 64 bits: the node program's"] [176 1 "// _Py_LATIN1_CHR reads them (_testclinic's deprecation checks: PySequence_Contains(kwnames, _Py_LATIN1_CHR('c'))) and"] [177 1 "// _PyLong_GetZero's static_objects offset."] [179 48 "// offsetof(_PyRuntimeState, static_objects)"] [180 48 "// .singletons (first), then .strings in it"] [181 48 "// .ascii[128]: struct { PyASCIIObject _ascii; uint8_t _data[2]; }"] [182 48 "// .latin1[128]: struct { PyCompactUnicodeObject _latin1; uint8_t _data[2]; }"] [185 27 "// sizeof(_PyRuntimeState): the static's size the offsets are checked against"] [188 1 "// bindStaticStrings binds _PyRuntime's static one-character strings (queue 475, 473-3 (a); Include/internal/"] [189 1 "// pycore_unicodeobject.h's _Py_LATIN1_CHR, a C module built with Py_BUILD_CORE): each of the 256 slots becomes the"] [190 1 "// handle of a str of its character, immortal, with its compact layout written in place (CPython's"] [191 1 "// _PyASCIIObject_INIT and _PyUnicode_LATIN1_INIT: ASCII ones a PyASCIIObject, the others a PyCompactUnicodeObject),"] [192 1 "// so C reads a real object there. Nothing when the world has no _PyRuntime or it is not the size these offsets are of."] [193 1 "// (_Py_ID's identifiers and _Py_STR's literals before the arrays: no C of the world names one.)"] [216 1 "// The small ints (Include/internal/pycore_runtime_structs.h): _PyRuntime.static_objects.singletons.small_ints, the"] [217 1 "// singletons' first member, PyLongObject[_PY_NSMALLNEGINTS + _PY_NSMALLPOSINTS] for -5..256, 32 bytes each on 64 bits"] [218 1 "// (PyObject_HEAD, lv_tag, one 30-bit digit, padded); strings' offset above, 20712, is theirs, bytes_empty's (40) and"] [219 1 "// bytes_characters' (256 of 48) summed."] [225 27 "// pycore_long.h's IMMORTALITY_BIT_MASK in lv_tag: _PyLong_IsSmallInt"] [228 1 "// bindSmallInts binds _PyRuntime's small ints (queue 481, 475-2 (a); pycore_long.h's _PyLong_GetZero, _PyLong_GetOne,"] [229 1 "// _PyLong_SMALL_INTS): each slot becomes the handle of pyi's interned int of its value (NewInt's -5..256), immortal,"] [230 1 "// its PyLongObject written in place with lv_tag's immortality bit as _PyLong_DIGIT_INIT writes it, so a C module's"] [231 1 "// first use, a read of the static or PyLong_FromLong's handle, sees CPython's object: Py_IS_TYPE, the value, and"] [232 1 "// _PyLong_IsSmallInt true for these and only these. They are bound when the world's data is (a C module's first use of"] [233 1 "// the world): C reads the static in place, with no call pyctypes could bind them on later. Nothing when the world has"] [234 1 "// no _PyRuntime or it is not the size these offsets are of."] [259 1 "// ---- helpers ----"] [261 1 "// excOf is the exception object the error indicator holds (nil: none)."] [269 1 "// badInternalCall is PyErr_BadInternalCall's SystemError."] [272 1 "// errInt sets the error indicator and gives the int -1."] [278 1 "// result is a new reference to o, or C's NULL with err set."] [286 1 "// cstrOrNil is a C string argument (nil for NULL)."] [294 1 "// fromUTF8 is PyUnicode_FromString's decoding of a C string."] [303 1 "// keepCString is s as a C string that lives as long as the process (a const char * the C API returns as borrowed"] [304 1 "// from an object CPython would hold: tp_name, ml_name, a version string), made once per distinct string."] [316 1 "// ssize is a Py_ssize_t clamp of an int (PyLong_AsSsize_t's overflow aside)."] [329 1 "// asLong is PyLong_AsLong (Objects/longobject.c): an int, or an object with __index__."] [345 1 "// asUnsignedMask is PyLong_AsUnsignedLongMask: the int's low 64 bits."] [355 1 "// ---- modules (Objects/moduleobject.c, Python/modsupport.c) ----"] [357 1 "// moduleOf is the module (or its dict) a module handle names."] [365 1 "// addFunctions is PyModule_AddFunctions: each PyMethodDef of the table at defs a built-in function of the module,"] [366 1 "// its self the module."] [396 1 "// cMethod is a PyCFunction of the world bound to self (PyCFunction_NewEx's object)."] [404 2 "// a type's method (queue 268): self is the call's first argument (selfFirst, but METH_STATIC's), defining its"] [405 2 "// type (METH_METHOD's defining_class), qual its name in the messages (Type.name)"] [415 1 "// Builtin is the method as pyi's built-in function."] [425 1 "// cDoc is a PyMethodDef's ml_doc and ml_flags (queue 525: __text_signature__ and __doc__ as methodobject.c's"] [426 1 "// meth_get__text_signature__ and meth_get__doc__ give them)."] [432 1 "// cBuiltinDocs are the built-ins made from the world's PyMethodDefs: module functions and C types' methods."] [435 1 "// builtinDoc is ExtBuiltinDoc: b's PyMethodDef's doc and flags, a method bound to an instance or a class found by its"] [436 1 "// name in its C type's dict."] [465 1 "// call is the vectorcall of a PyCFunction (Objects/methodobject.c: cfunction_call and the METH_* trampolines)."] [469 2 "// the messages name the function as _PyObject_FunctionStr does: module.name() (Objects/methodobject.c)"] [491 25 "// METH_METHOD | METH_FASTCALL | METH_KEYWORDS: (self, defining_class, args, nargsf, kwnames)"] [512 24 "// METH_FASTCALL (| METH_KEYWORDS)"] [534 23 "// METH_NOARGS"] [540 23 "// METH_O"] [546 11 "// METH_VARARGS (| METH_KEYWORDS)"] [586 1 "// moduleFromDef is PyModule_Create2's module: m_name, m_doc and m_methods of the PyModuleDef at def."] [592 24 "// queue 270b: PyModule_GetDef"] [594 46 "// md_state (queue 269: PyModule_GetState), zeroed"] [607 1 "// ---- PyArg_Parse, PyArg_ParseTuple (Python/getargs.c) ----"] [609 1 "// vgetargs is vgetargs1_impl: the arguments (one, compat, for PyArg_Parse) converted by format into the pointers."] [697 2 "// a unit left that is no unit's start (vgetargs1_impl's check; py-eval-1122: xxlimited_35's roj, \"O#\")"] [706 1 "// seterror is getargs.c's seterror: a conversion's message as \"fname() argument N must be ...\"."] [730 1 "// argState is the va_list of the pointers the units store through."] [734 21 "// converttuple's item numbers of the failing unit (queue 270)"] [735 21 "// the Py_buffers filled, released on failure (freelist)"] [736 21 "// the pointers to the encoded strings' blocks, freed on failure"] [737 21 "// the O& converters that returned Py_CLEANUP_SUPPORTED and their addresses (queue 270b)"] [740 1 "// convert is convertitem (queue 270: the parenthesized tuples, capi_getargs.go): a failure's message or error, the"] [741 1 "// buffers and blocks the call filled given back on failure as cleanreturn's freelist."] [758 1 "// convertBuffer is convertbuffer: a bytes' contents, else the message of an object whose buffer is not read-only"] [759 1 "// (its type has bf_releasebuffer: bytearray, memoryview, array ...) (nil and no message: it has none, getbuffer's TypeError; queue 270)."] [772 1 "// noBuffer is PyObject_GetBuffer's TypeError for an object with no buffer (getbuffer's pending exception)."] [777 1 "// converterr is getargs.c's converterr."] [789 1 "// convert is convertsimple's units (b B h H i I n l k L K f d p y y# s s# z z# O O! and the tuple units aside):"] [790 1 "// a message (the conversion's failure) or an error (an exception the conversion raised)."] [956 12 "// a bytes or bytearray of length 1 as a char (getargs.c's convertsimple, queue 269)"] [971 12 "// a str of length 1 as an int (its code point)"] [988 1 "// ---- Py_BuildValue (Python/modsupport.c) ----"] [990 1 "// buildValue is Py_BuildValue's do_mkvalue over the format's units and the variadic arguments. As modsupport.c's, an"] [991 1 "// error (a NULL object, O&'s converter failing, a bad character, a dict of an odd count) does not stop the walk: every"] [992 1 "// argument is still consumed and each N's reference stolen, the first error given at the end."] [1063 13 "// a Py_complex *"] [1101 45 "// O&: converter(arg), a new reference"] [1134 2 "// the top level: one unit is its value, none is None, several a tuple"] [1155 1 "// ---- capsules (Objects/capsule.c) ----"] [1157 1 "// cCapsule is a capsule C made: its pointer, name (0: NULL), context and destructor in the world."] [1184 1 "// newCapsule is PyCapsule_New: a capsule of py's PyCapsule type, its destructor called on the library's next call"] [1185 1 "// after the capsule is collected."] [1200 5 "// the destructor gets the capsule (a fresh handle: the capsule is Go's until the call ends)"] [1211 1 "// capsuleImport is PyCapsule_Import."] [1245 1 "// decodeReplace is PyUnicode_FromFormat's %s: UTF-8 decoded with \"replace\"."] [1254 1 "// ---- slices (Objects/sliceobject.c) ----"] [1258 1 "// evalSliceIndex is _PyEval_SliceIndex: None leaves *v, an index clamps to Py_ssize_t."] [1284 1 "// sliceUnpack is PySlice_Unpack."] [1319 1 "// sliceAdjust is PySlice_AdjustIndices."] [1363 1 "// sliceGetIndices is PySlice_GetIndices: -1 without an exception for what it refuses."] [1416 1 "// ---- the frames (Python/ceval.c) ----"] [1418 1 "// callerFrame is the Python frame that called C (sys._getframe(0) seen from the native)."] [1439 1 "// frameLocals is PyEval_GetFrameLocals: a function's locals as a dict snapshot (PEP 667), a module's or class's"] [1440 1 "// namespace itself."] [1452 1 "// funcName and funcDesc are PyEval_GetFuncName and PyEval_GetFuncDesc."] [1488 1 "// sysCall calls sys.NAME(args...)."] [1501 1 "// sysGetObject is PySys_GetObject: sys's attribute (nil when absent; a decoding error is unraisable)."] [1520 1 "// ---- the natives ----"] [1522 1 "// version strings (Python/getversion.c, getplatform.c, getcopyright.c, getcompiler.c, Modules/getbuildinfo.c)"] [1538 2 "// version and build"] [1543 2 "// _Py_GetBuiltWithAssert (Python/getversion.c's): pyi's own runtime asserts nothing in C"] [1552 2 "// modules"] [1634 2 "// argument parsing and building"] [1659 2 "// errors (Python/errors.c)"] [1661 2 "// PyErr_SetObject: capi_tail.go (setObject)"] [1731 2 "// PyErr_WriteUnraisable: capi_tail.go"] [1732 2 "// capsules"] [1766 2 "// the evaluation's state"] [1796 2 "// frames (Objects/frameobject.c: PyFrame_GetLocals and the others, new references)"] [1832 2 "// the GIL (Python/pystate.c): pyi's threads hold it when they run Python, so a thread that calls C holds it"] [1833 2 "// already: PyGILState_Ensure gives PyGILState_LOCKED (0) and Release has nothing to give back"] [1837 2 "// sys (Python/sysmodule.c)"] [1877 2 "// slices"] [1949 2 "// strings compared (Python/pystrcmp.c)"] [1982 1 "// cstr8 is a C string argument's bytes (nil for NULL)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[35 19] [36 31] [54 30] [95 27] [96 29] [128 28] [151 27] [166 43] [167 25] [201 18] [201 27] [243 33] [243 54] [246 28] [263 27] [359 25] [374 16] [374 25] [385 30] [419 29] [438 29] [457 26] [458 30] [471 29] [569 19] [593 38] [596 30] [599 29] [600 34] [615 12] [615 24] [662 46] [688 12] [688 19] [699 15] [761 26] [765 46] [795 48] [843 48] [914 26] [973 26] [1042 15] [
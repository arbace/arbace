(in-ns 'go.arbace.pyctypes) ^{:go/comments [[3 1 "// The C API over the handles (queue 244; doc/python/PYTHON-SURVEY.md, \"As built: 244\"; the user's 244-3 (a)): the"] [4 1 "// limited API's functions an extension module of the world calls, given as ci natives (a function the node program"] [5 1 "// declares and does not define is the native of its name), over pyi's objects. A PyObject * is a handle (world.go):"] [6 1 "// the address of a proxy holding the documented head, ob_refcnt and ob_type (the handle of its type). Its functions are"] [7 1 "// written from the C API's documentation (docs.python.org/3.14/c-api), not from CPython's code."] [8 1 "//"] [9 1 "// The error indicator (PyErr_SetString, PyErr_Format) is held here and raised by the Python call that called the C"] [10 1 "// function (an extension module's method, a pythonapi function), as CPython's PyErr_Occurred after the call."] [11 1 "//"] [12 1 "// Extension modules: a module of the world (`_ctypes_test`) is made from its PyInit_NAME by multi-phase initialization"] [13 1 "// (PyModuleDef_Init gives the definition back; its m_methods become the module's functions, called with METH_NOARGS,"] [14 1 "// METH_O or METH_VARARGS)."] [28 1 "// errIndicator is the C API's current exception (nil: none)."] [31 1 "// takeErr is the pending C API exception, cleared."] [44 1 "// newRef is a new reference's handle: the proxy's ob_refcnt raised."] [51 1 "// setErr sets the error indicator and gives C's NULL."] [57 1 "// cfmt is PyUnicode_FromFormat's subset the module's messages use: %s %d %i %u %ld %lu %zd %zu %c %x %p %R %S %U %%,"] [58 1 "// its arguments taken from args in order."] [108 1 "// excType is the exception class a PyExc_* handle names (TypeError when it names none)."] [116 1 "// parseTuple is PyArg_ParseTuple's subset: the format units s, z, y, i, I, b, B, h, H, l, k, L, K, n, d, f, O, O!,"] [117 1 "// p, and | and the trailing :NAME and ;MSG; each unit stores through the next pointer argument."] [250 1 "// versionStr is Py_GetVersion's string in the world (made once)."] [253 1 "// keepAlive holds the strings PyArg_ParseTuple handed C (a borrowed char * lives as long as the argument tuple)."] [260 1 "// capiNatives are the C API's functions."] [265 2 "// queue 262's natives (capi_limited.go, capi_objects.go), merged here so that no init order matters"] [302 36 "// queue 456"] [305 34 "// py-capi-1122"] [308 34 "// py-eval-1122"] [376 4 "// its items NULL until C sets them, as CPython's (queue 269: the mirror's ob_item, PyList_SET_ITEM)"] [436 3 "// pythonapi's functions the tests call"] [454 1 "// sysWrite is PySys_WriteStdout's: the text written to sys.stdout (or stderr), truncated to max bytes when max >= 0"] [455 1 "// (PySys_WriteStdout's 1000), an exception during the write cleared."] [475 1 "// tpFlags are the tp_flags bits the limited API's checks read (Py_TPFLAGS_*_SUBCLASS, BASETYPE, HEAPTYPE)."] [495 1 "// sized is a native followed by refreshSizes (queue 262), bracketed by the mirrors' synchronization (queue 269:"] [496 1 "// nativeEnter, nativeLeave)."] [506 1 "// capiReady: the natives registered with ci and the C API's data (Py_None's struct, the exceptions' pointers) set."] [516 42 "// queue 269: each native named on stderr as C calls it (debugging)"] [527 14 "// queue 269: before any handle names a type"] [528 2 "// the singletons' structs are their proxies: the handle of None is _Py_NoneStruct's address"] [544 1 "// dataSymbol is a data symbol's address in the world, 0 when none."] [553 1 "// bindHandle makes a the handle of o (a singleton's struct of the world)."] [562 30 "// True and False: their PyLongObject fields (queue 269)"] [569 1 "// ---- extension modules ----"] [571 1 "// extModule is the module NAME of the world made from PyInit_NAME (multi-phase: PyModuleDef_Init's definition)."] [580 1 "// extModuleObj is the module NAME of the world: multi-phase (a PyModuleDef) or, since queue 262, single-phase (the"] [581 1 "// module PyInit made, kept as is: its functions are bound to it)."] [600 2 "// single-phase initialization (queue 262): PyInit gave the module (PyModule_Create2's), a new reference"] [606 2 "// PyModuleDef: m_base (40 bytes), m_name, m_doc, m_size, m_methods, m_slots, ..."] [628 1 "// slotsExec reports a definition's m_slots (PyModuleDef_Slot: int slot, void *value; 16 bytes, slot 0 last) holding a"] [629 1 "// Py_mod_create (1) or Py_mod_exec (2) slot."] [643 1 "// moduleFromDefAndSpec is multi-phase initialization with execution slots (PEP 489; Objects/moduleobject.c's"] [644 1 "// PyModule_FromDefAndSpec2 and PyModule_ExecDef; py-eval-1122, xxlimited's xx_modexec): the module made from its"] [645 1 "// definition as PyModule_Create2 makes one (moduleFromDef: md_state of m_size, its functions bound to it), then each"] [646 1 "// Py_mod_exec slot called with it in order (a nonzero status its error); Py_mod_create (no module of the world has one)"] [647 1 "// refused, the interpreter and GIL slots taken as given."] [681 1 "// cfunction is a PyCFunction of the module (its self NULL) as a built-in function."] [690 24 "// METH_NOARGS"] [694 24 "// METH_O"] [699 12 "// METH_VARARGS"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[69 12] [69 29] [100 38] [110 23] [124 40] [139 12] [139 29] [180 24] [182 34] [202 24] [230 28] [315 88] [316 88] [317 88] [318 88] [319 88] [320 88] [404 38] [409 76] [425 42] [426 48] [427 27] [447 114] [448 114] [449 112] [450 112] [530 27] [538 27] [547 30] [555 27] [563 23] [593 21] [601 41] [612 30] [615 30] [615 39] [632 16] [632 24] [650 16] [650 24] [651 30] [662 16] [662 24] [671 22] [706 22]] :go/trails [[450 128]]} (go/file "capi.go" :imports [


(in-ns 'go.arbace.pyctypes) ^{:go/comments [[3 1 "// The C API over the handles (queue 244; doc/python/PYTHON-SURVEY.md, \"As built: 244\"; the user's 244-3 (a)): the"] [4 1 "// limited API's functions an extension module of the world calls, given as ci natives (a function the node program"] [5 1 "// declares and does not define is the native of its name), over pyi's objects. A PyObject * is a handle (world.go):"] [6 1 "// the address of a proxy holding the documented head, ob_refcnt and ob_type (the handle of its type). Its functions are"] [7 1 "// written from the C API's documentation (docs.python.org/3.14/c-api), not from CPython's code."] [8 1 "//"] [9 1 "// The error indicator (PyErr_SetString, PyErr_Format) is held here and raised by the Python call that called the C"] [10 1 "// function (an extension module's method, a pythonapi function), as CPython's PyErr_Occurred after the call."] [11 1 "//"] [12 1 "// Extension modules: a module of the world (`_ctypes_test`) is made from its PyInit_NAME by multi-phase initialization"] [13 1 "// (PyModuleDef_Init gives the definition back; its m_methods become the module's functions, called with METH_NOARGS,"] [14 1 "// METH_O or METH_VARARGS)."] [29 1 "// errIndicator is the C API's current exception (nil: none)."] [32 1 "// takeErr is the pending C API exception, cleared."] [45 1 "// newRef is a new reference's handle: the proxy's ob_refcnt raised."] [52 1 "// setErr sets the error indicator and gives C's NULL."] [58 1 "// cfmt is PyUnicode_FromFormat (Objects/unicodeobject.c's unicode_fromformat_arg, CPython 3.14.10; queue 521: the"] [59 1 "// flags, width and precision too, datetime's \"%04d-%02d-%02d\"): the conversions c d i u x X o p s V U S R A T N and %%,"] [60 1 "// the flags '-' and '0' ('#' for T and N), a width and a precision (digits or '*'), the sizes l ll z t j h hh; its"] [61 1 "// arguments taken from args in order (a failing str() or repr() writes nothing)."] [255 1 "// asciiOf is ascii()'s escaping of a repr: the non-ASCII characters as \\x, \\u or \\U escapes."] [273 1 "// excType is the exception class a PyExc_* handle names (TypeError when it names none)."] [281 1 "// parseTuple is PyArg_ParseTuple's subset: the format units s, z, y, i, I, b, B, h, H, l, k, L, K, n, d, f, O, O!,"] [282 1 "// p, and | and the trailing :NAME and ;MSG; each unit stores through the next pointer argument."] [415 1 "// versionStr is Py_GetVersion's string in the world (made once)."] [418 1 "// keepAlive holds the strings PyArg_ParseTuple handed C (a borrowed char * lives as long as the argument tuple)."] [425 1 "// capiNatives are the C API's functions."] [430 2 "// queue 262's natives (capi_limited.go, capi_objects.go), merged here so that no init order matters"] [467 36 "// queue 456"] [470 35 "// queue 521: _datetime's and _decimal's"] [538 4 "// its items NULL until C sets them, as CPython's (queue 269: the mirror's ob_item, PyList_SET_ITEM)"] [598 3 "// pythonapi's functions the tests call"] [616 1 "// sysWrite is PySys_WriteStdout's: the text written to sys.stdout (or stderr), truncated to max bytes when max >= 0"] [617 1 "// (PySys_WriteStdout's 1000), an exception during the write cleared."] [637 1 "// tpFlags are the tp_flags bits the limited API's checks read (Py_TPFLAGS_*_SUBCLASS, BASETYPE, HEAPTYPE)."] [657 1 "// sized is a native followed by refreshSizes (queue 262), bracketed by the mirrors' synchronization (queue 269:"] [658 1 "// nativeEnter, nativeLeave)."] [668 1 "// capiReady: the natives registered with ci and the C API's data (Py_None's struct, the exceptions' pointers) set."] [678 42 "// queue 269: each native named on stderr as C calls it (debugging)"] [689 14 "// queue 269: before any handle names a type"] [690 2 "// the singletons' structs are their proxies: the handle of None is _Py_NoneStruct's address"] [706 1 "// dataSymbol is a data symbol's address in the world, 0 when none."] [715 1 "// bindHandle makes a the handle of o (a singleton's struct of the world)."] [724 30 "// True and False: their PyLongObject fields (queue 269)"] [731 1 "// ---- extension modules ----"] [733 1 "// extModule is the module NAME of the world made from PyInit_NAME (multi-phase: PyModuleDef_Init's definition)."] [742 1 "// extModuleObj is the module NAME of the world: multi-phase (a PyModuleDef) or, since queue 262, single-phase (the"] [743 1 "// module PyInit made, kept as is: its functions are bound to it)."] [762 2 "// single-phase initialization (queue 262): PyInit gave the module (PyModule_Create2's), a new reference"] [768 2 "// multi-phase initialization with slots (queue 521, PEP 489: _datetime's and _decimal's Py_mod_exec and state)"] [772 2 "// PyModuleDef: m_base (40 bytes), m_name, m_doc, m_size, m_methods, m_slots, ..."] [790 1 "// cfunction is a PyCFunction of the module (its self NULL) as a built-in function."] [799 24 "// METH_NOARGS"] [803 24 "// METH_O"] [808 12 "// METH_VARARGS"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[92 12] [92 29] [209 34] [217 56] [222 38] [229 27] [242 43] [275 23] [289 40] [304 12] [304 29] [345 24] [347 34] [367 24] [395 28] [477 88] [478 88] [479 88] [480 88] [481 88] [482 88] [566 38] [571 76] [587 42] [588 48] [589 27] [609 114] [610 114] [611 112] [612 112] [692 27] [700 27] [709 30] [717 27] [725 23] [755 21] [763 41] [769 32] [774 30] [777 30] [777 39] [815 22]] :go/trails [[612 128]]} (go/file "capi.go" :imports [


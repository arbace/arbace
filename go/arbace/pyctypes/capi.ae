(in-ns 'go.arbace.pyctypes) ^{:go/comments [[3 1 "// The C API over the handles (queue 244; doc/python/PYTHON-SURVEY.md, \"As built: 244\"; the user's 244-3 (a)): the"] [4 1 "// limited API's functions an extension module of the world calls, given as ci natives (a function the node program"] [5 1 "// declares and does not define is the native of its name), over pyi's objects. A PyObject * is a handle (world.go):"] [6 1 "// the address of a proxy holding the documented head, ob_refcnt and ob_type (the handle of its type). Its functions are"] [7 1 "// written from the C API's documentation (docs.python.org/3.14/c-api), not from CPython's code."] [8 1 "//"] [9 1 "// The error indicator (PyErr_SetString, PyErr_Format) is held here and raised by the Python call that called the C"] [10 1 "// function (an extension module's method, a pythonapi function), as CPython's PyErr_Occurred after the call."] [11 1 "//"] [12 1 "// Extension modules: a module of the world (`_ctypes_test`) is made from its PyInit_NAME by multi-phase initialization"] [13 1 "// (PyModuleDef_Init gives the definition back; its m_methods become the module's functions, called with METH_NOARGS,"] [14 1 "// METH_O or METH_VARARGS)."] [28 1 "// errIndicator is the C API's current exception (nil: none)."] [31 1 "// takeErr is the pending C API exception, cleared."] [44 1 "// newRef is a new reference's handle: the proxy's ob_refcnt raised."] [51 1 "// setErr sets the error indicator and gives C's NULL."] [57 1 "// cfmt is PyUnicode_FromFormat's subset the module's messages use: %s %d %i %u %ld %lu %zd %zu %c %x %p %R %S %U %%,"] [58 1 "// its arguments taken from args in order."] [108 1 "// excType is the exception class a PyExc_* handle names (TypeError when it names none)."] [116 1 "// parseTuple is PyArg_ParseTuple's subset: the format units s, z, y, i, I, b, B, h, H, l, k, L, K, n, d, f, O, O!,"] [117 1 "// p, and | and the trailing :NAME and ;MSG; each unit stores through the next pointer argument."] [250 1 "// versionStr is Py_GetVersion's string in the world (made once)."] [253 1 "// keepAlive holds the strings PyArg_ParseTuple handed C (a borrowed char * lives as long as the argument tuple)."] [260 1 "// capiNatives are the C API's functions."] [265 2 "// queue 262's natives (capi_limited.go, capi_objects.go), merged here so that no init order matters"] [349 4 "// its items NULL until C sets them, as CPython's (queue 269: the mirror's ob_item, PyList_SET_ITEM)"] [409 3 "// pythonapi's functions the tests call"] [427 1 "// sysWrite is PySys_WriteStdout's: the text written to sys.stdout (or stderr), truncated to max bytes when max >= 0"] [428 1 "// (PySys_WriteStdout's 1000), an exception during the write cleared."] [448 1 "// tpFlags are the tp_flags bits the limited API's checks read (Py_TPFLAGS_*_SUBCLASS, BASETYPE, HEAPTYPE)."] [468 1 "// sized is a native followed by refreshSizes (queue 262), bracketed by the mirrors' synchronization (queue 269:"] [469 1 "// nativeEnter, nativeLeave)."] [479 1 "// capiReady: the natives registered with ci and the C API's data (Py_None's struct, the exceptions' pointers) set."] [489 42 "// queue 269: each native named on stderr as C calls it (debugging)"] [500 14 "// queue 269: before any handle names a type"] [501 2 "// the singletons' structs are their proxies: the handle of None is _Py_NoneStruct's address"] [517 1 "// dataSymbol is a data symbol's address in the world, 0 when none."] [526 1 "// bindHandle makes a the handle of o (a singleton's struct of the world)."] [535 30 "// True and False: their PyLongObject fields (queue 269)"] [542 1 "// ---- extension modules ----"] [544 1 "// extModule is the module NAME of the world made from PyInit_NAME (multi-phase: PyModuleDef_Init's definition)."] [553 1 "// extModuleObj is the module NAME of the world: multi-phase (a PyModuleDef) or, since queue 262, single-phase (the"] [554 1 "// module PyInit made, kept as is: its functions are bound to it)."] [573 2 "// single-phase initialization (queue 262): PyInit gave the module (PyModule_Create2's), a new reference"] [579 2 "// PyModuleDef: m_base (40 bytes), m_name, m_doc, m_size, m_methods, m_slots, ..."] [597 1 "// cfunction is a PyCFunction of the module (its self NULL) as a built-in function."] [606 24 "// METH_NOARGS"] [610 24 "// METH_O"] [615 12 "// METH_VARARGS"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[69 12] [69 29] [100 38] [110 23] [124 40] [139 12] [139 29] [180 24] [182 34] [202 24] [230 28] [288 88] [289 88] [290 88] [291 88] [292 88] [293 88] [377 38] [382 76] [398 42] [399 48] [400 27] [420 114] [421 114] [422 112] [423 112] [503 27] [511 27] [520 30] [528 27] [536 23] [566 21] [574 41] [581 30] [584 30] [584 39] [622 22]] :go/trails [[423 128]]} (go/file "capi.go" :imports [

    ;; The C API over the handles (queue 244; doc/python/PYTHON-SURVEY.md, "As built: 244"; the user's 244-3 (a)): the
    ;; limited API's functions an extension module of the world calls, given as ci natives (a function the node program
    ;; declares and does not define is the native of its name), over pyi's objects. A PyObject * is a handle (world.go):
    ;; the address of a proxy holding the documented head, ob_refcnt and ob_type (the handle of its type). Its functions are
    ;; written from the C API's documentation (docs.python.org/3.14/c-api), not from CPython's code.
    ;;
    ;; The error indicator (PyErr_SetString, PyErr_Format) is held here and raised by the Python call that called the C
    ;; function (an extension module's method, a pythonapi function), as CPython's PyErr_Occurred after the call.
    ;;
    ;; Extension modules: a module of the world (`_ctypes_test`) is made from its PyInit_NAME by multi-phase initialization
    ;; (PyModuleDef_Init gives the definition back; its m_methods become the module's functions, called with METH_NOARGS,
    ;; METH_O or METH_VARARGS).



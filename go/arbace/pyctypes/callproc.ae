ult"] [361 1 "// written as restype; an exception is reported as unraisable and the result left zero."] [399 3 "// widened as ffi_arg, by its signedness"] [431 1 "// ---- PyCFuncPtr_new ----"] [449 3 "// (name_or_ordinal, dll)"] [502 1 "// dllHandle is the dll object's _handle (an int)."] [519 1 "// ---- dlopen ----"] [521 1 "// The world's names: the libraries a ctypes program may load (244-2 (a))."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[48 25] [54 22] [77 24] [101 24] [105 54] [126 25] [154 35] [390 49] [394 27] [401 22] [401 30] [448 26] [454 39] [458 26] [460 33] [462 35] [470 53] [471 25] [481 22] [535 28] [543 21] [543 29]]} (go/file "callproc.go" :imports [


teParamflags is _validate_paramflags (argtypes nil: the type's)."] [332 1 "// checkOutargType is _check_outarg_type: a pointer or array type, or c_void_p, c_char_p, c_wchar_p."] [347 1 "// buildCallargs is _build_callargs: the call's arguments from the paramflags, the masks of the out and inout"] [348 1 "// parameters, the count of the values returned."] [440 1 "// buildResult is _build_result: the out parameters' values (by __ctypes_from_outparam__) and the inout ones."] [478 1 "// resultType is the ffi type of a restype (None: void; nil: int; a callable that is no ctypes type: int)."] [499 1 "// aggElems: a struct's elements for ci's call, bytes of its size (ci copies the aggregate's bytes: only the size and"] [500 1 "// the alignment matter)."] [522 1 "// getResult is GetResult: the result's bytes as restype wants them."] [542 3 "// a py_object result is the reference the function returned, now Python's (GetResult's Py_XDECREF after O_get)"] [558 1 "// ---- callbacks (callbacks.c) ----"] [560 1 "// newCallback is _ctypes_alloc_callback: a closure of the type's interface calling callable."] [600 1 "// callPythonObject is _CallPythonObject: the C arguments made Python objects, the callable called, its result"] [601 1 "// written as restype; an exception is reported as unraisable and the result left zero."] [635 3 "// a result whose memory needs an object kept alive (a char *'s bytes) leaks past the callback (callbacks.c)"] [646 3 "// widened as ffi_arg, by its signedness"] [678 1 "// ---- PyCFuncPtr_new ----"] [707 3 "// (name_or_ordinal, dll)"] [725 76 "// PyCFuncPtr_FromDll's audit (queue 598)"] [763 1 "// dllHandle is the dll object's _handle (an int)."] [780 1 "// ---- dlopen ----"] [782 1 "// The world's names: the libraries a ctypes program may load (244-2 (a))."] [786 1 "// loadedLibs are the names dlopen opened, in order (py-accel: _ctypes.dllist's answer after the program and the world's libc)."] [792 1 "// dllist is callproc.c's dllist over dl_iterate_phdr: the loaded objects' names, the program first (named \"\", as"] [793 1 "// dl_iterate_phdr names it), then the world's musl as \"libc.so\", then each library a dlopen named (the world answers"] [794 1 "// every name of worldLibs)."] [810 56 "// py_dl_open's audit (queue 598)"] [846 1 "// callAddress is _ctypes_callproc for call_function and call_cdeclfunction (queue 598): the function at addr called"] [847 1 "// with args converted by ConvParam, no argument types, its result a C int."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[62 25] [70 22] [87 24] [111 24] [115 54] [134 25] [159 35] [198 101] [255 19] [322 47] [334 25] [337 23] [341 25] [362 26] [363 32] [371 26] [414 33] [434 33] [446 12] [446 41] [637 82] [641 27] [648 22] [648 30] [695 26] [712 39] [716 26] [718 33] [720 35] [725 61] [731 53] [732 25] [742 22] [810 41] [818 28] [824 40] [829 21] [829 29] [849 101]]} (go/file "callproc.go" :imports [


(in-ns 'go.arbace.pyctypes) ^{:go/comments [[3 1 "// The C API the C accelerators need (queue 521; the user's decision of 2026-11-22 reversing PY6g's DECISION 1): CPython"] [4 1 "// 3.14.10's Modules/_datetimemodule.c and Modules/_decimal/_decimal.c (over libmpdec) built by ci into the world as"] [5 1 "// CPython builds them, and the internal functions they call beyond the C API the world had, ported from CPython"] [6 1 "// 3.14.10's Objects/object.c, Objects/typeobject.c, Objects/longobject.c, Objects/unicodeobject.c, Objects/unicodectype.c,"] [7 1 "// Python/pytime.c and Python/pystate.c (the PSF's license, LICENSE.md): a multi-phase module's slots and state (PEP 489),"] [8 1 "// the static types of an extension (_PyStaticType_InitForExtension) and the static objects of their instances"] [9 1 "// (datetime's utc_timezone), _Py_ID's identifiers in _PyRuntime, _PyTime's conversions and broken-down times."] [21 1 "// The identifiers of _PyRuntime.static_objects.singletons.strings (Include/internal/pycore_global_strings.h's"] [22 1 "// STRUCT_FOR_ID, _Py_ID(NAME)) the world's C names, at their offsets from the strings' start as ci lays out CPython"] [23 1 "// 3.14.10's _PyRuntimeState on 64 bits (the same as gcc's: the layout's size and the arrays' offsets above agree):"] [24 1 "// _datetimemodule.c's."] [35 1 "// bindIdentifiers binds the identifiers of rtIdentifiers as bindStaticStrings binds the one-character strings: each a"] [36 1 "// str of its name, immortal, its compact ASCII layout (PyASCIIObject and the characters, the struct's size) written in"] [37 1 "// place. Nothing when the world has no _PyRuntime of the expected size."] [61 1 "// ---- the static objects of a C type (a PyObject_HEAD_INIT'd static of the world: datetime's utc_timezone) ----"] [64 31 "// the world's statics' addresses"] [65 31 "// the static objects made Go values: kept for the process (immortal)"] [68 1 "// staticObject is the Go value of the static object at a: a static of the world whose ob_type is a C type (nil: none)."] [94 1 "// ---- multi-phase initialization (PEP 489; Objects/moduleobject.c's PyModule_FromDefAndSpec2 and PyModule_ExecDef) ----"] [96 1 "// the module slots (Include/moduleobject.h)"] [102 1 "// moduleFromSlots is the module of the PyModuleDef at def whose m_slots is slots: made as PyModule_Create2 makes one"] [103 1 "// (its state of m_size bytes, its functions bound to it; a Py_mod_create slot is not provided), then each Py_mod_exec"] [104 1 "// slot run on it in order, a failing one's exception raised (\"execution of module %s failed without setting an"] [105 1 "// exception\" when it set none, as PyModule_ExecDef)."] [149 1 "// moduleObjSize is sizeof(PyModuleObject) (Objects/moduleobject.h without Py_GIL_DISABLED): PyObject_HEAD, md_dict,"] [150 1 "// md_def, md_state, md_weaklist, md_name."] [153 1 "// writeModuleHead writes a module's PyModuleObject fields into its proxy at a: md_def and md_state (pycore_moduleobject.h's"] [154 1 "// inline _PyModule_GetState reads md_state in place)."] [163 1 "// ---- natives ----"] [165 1 "// interpState is PyInterpreterState_Get's pointer (one interpreter: a block of the world no C reads) and interpDict"] [166 1 "// PyInterpreterState_GetDict's dict."] [172 1 "// tzNames keep the tm_zone strings _PyTime_localtime handed C (a struct tm's char * lives with the program)."] [175 1 "// timeTOverflow is pytime.c's error_time_t_overflow."] [180 1 "// pytimeRound is pytime.c's pytime_round: _PyTime_ROUND_FLOOR 0, CEILING 1, HALF_EVEN 2, UP 3."] [201 1 "// timeTMin is PY_TIME_T_MIN as a double."] [204 1 "// longAsTimeT is _PyLong_AsTime_t (Python/pytime.c): PyLong_AsLongLong, its OverflowError time_t's."] [216 1 "// objectToDenominator is pytime.c's pytime_object_to_denominator: a float split into seconds and a numerator of"] [217 1 "// denominator (pytime_double_to_denominator), an int seconds and 0."] [247 1 "// writeTm fills the struct tm at p (musl's: nine ints, then long tm_gmtoff at 40 and const char *tm_zone at 48) from a"] [248 1 "// time.struct_time."] [275 43 "// Python's Monday 0, C's Sunday 0"] [296 1 "// brokenDown is _PyTime_localtime or _PyTime_gmtime (Python/pytime.c): time.localtime's or time.gmtime's answer (the"] [297 1 "// same localtime_r and gmtime_r, their errors raised as theirs) written into the struct tm at p; 0, else -1 with the error."] [317 1 "// strMethod is the str method name of the one-character string of ch (unicodectype.c's predicates, as str's)."] [339 1 "// divmodNear is _PyLong_DivmodNear (Objects/longobject.c): (q, r) with a = b*q + r and abs(r) <= abs(b)/2, equality"] [340 1 "// only when q is even."] [352 20 "// Euclidean: 0 <= r < |y|"] [354 3 "// floor division's: r of y's sign"] [370 2 "// _Py_NewReference (Objects/object.c; pycore_object.h's inline _PyObject_Init after PyObject_Malloc, datetime's"] [371 2 "// time_alloc and datetime_alloc): the object at op, its ob_type set, a C-born object of its type with one reference"] [390 2 "// _PyStaticType_InitForExtension (Objects/typeobject.c): a static type of an extension readied (PyType_Ready's)"] [400 2 "// _PyType_GetDict (Objects/typeobject.c): the type's dict, borrowed"] [408 2 "// _PyType_Name (Objects/typeobject.c): tp_name past its last dot"] [434 2 "// PyObject_CallMethodObjArgs (Objects/call.c): obj.name(*args), the arguments up to a NULL"] [457 2 "// Py_VaBuildValue (Python/modsupport.c): Py_BuildValue over a va_list (ci's: the address of the next 8-byte slot)"] [470 2 "// PyUnicode_DecodeLocale (Objects/unicodeobject.c): the locale's encoding, UTF-8 (pyi's C.UTF-8), with errors"] [482 2 "// _PyUnicode_Copy (Objects/unicodeobject.c): a new str of the same characters"] [490 2 "// PyUnicode_WriteChar (Objects/unicodeobject.c): the character at index of a str only C holds (one _PyUnicode_Copy"] [491 2 "// made) replaced: pyi's strs are immutable, so the handle names a new str of the new characters"] [518 2 "// _PyUnicode_ToDecimalDigit (Objects/unicodectype.c): the character's decimal value, -1 for none"] [549 2 "// _PyObject_GetState (Objects/typeobject.c): obj.__getstate__()"] [557 2 "// _PyTime_ObjectToTime_t (Python/pytime.c): a float rounded, an int as is, into the time_t at p"] [584 2 "// _PyTime_ObjectToTimeval (Python/pytime.c): seconds and microseconds (a long)"] [595 2 "// _PyTime_AsTimevalTime_t (Python/pytime.c): a PyTime_t of nanoseconds as seconds and an int of microseconds"] [601 11 "// floor"] [605 11 "// ceiling"] [609 11 "// half even"] [621 12 "// up: away from zero"] [641 2 "// ---- _decimal's (Modules/_decimal/_decimal.c) ----"] [642 2 "// the methods bindNumberMethods puts in int's and float's tp_methods: self.NAME(), as PyCFunction(self, NULL)"] [653 2 "// PyComplex_AsCComplex (Objects/complexobject.c): a Py_complex by value (ci: the caller's temporary at the hidden"] [654 2 "// first argument), -1.0 and the error for a value with no complex"] [680 2 "// PyObject_HashNotImplemented (Objects/object.c): a type's tp_hash that makes it unhashable"] [692 2 "// PyThreadState_GetDict (Python/pystate.c): the thread's dict (pyi's C entries run on one thread at a time)"] [700 2 "// _PyLong_GCD (Objects/longobject.c): gcd(a, b) of two ints, non-negative"] [710 2 "// PyUnicode_FromWideChar (Objects/unicodeobject.c): wchar_t's UTF-32, size -1 for a NUL-terminated string"] [730 2 "// PyLong_Export and PyLong_FreeExport (PEP 757, Objects/longobject.c): an int as its int64 value, else as the native"] [731 2 "// layout's digits (30 bits in a uint32, least significant first) in a block of the world. PyLongExport: int64_t value,"] [732 2 "// uint8_t negative, Py_ssize_t ndigits, const void *digits, uintptr_t _reserved (the block)."] [769 2 "// PyLongWriter_Create, _Finish and _Discard (PEP 757): the digits written by C into a block of the world, the int"] [770 2 "// made from them at Finish (normalized: leading zero digits dropped). The writer is the block's address."] [809 2 "// PyContextVar_New, _Get, _Set and _Reset (Python/context.c), over contextvars.ContextVar"] [864 1 "// threadDict is PyThreadState_GetDict's dict; longWriters the PyLongWriters made (block -> negative, ndigits);"] [865 1 "// contextMissing the sentinel PyContextVar_Get passes ContextVar.get."] [890 1 "// bindNumberMethods gives the static type objects of int, float and complex (the glue's structs, bound to pyi's types by"] [891 1 "// bindTypes) a PyNumberMethods with their arithmetic slots (Include/cpython/object.h's order: nb_add 0, nb_subtract 8,"] [892 1 "// nb_multiply 16, nb_remainder 24, nb_divmod 32, nb_power 40, nb_negative 48, nb_positive 56, nb_absolute 64,"] [893 1 "// nb_floor_divide 232, nb_true_divide 240), the abstract protocol's natives: _decimal's exec reads"] [894 1 "// PyLong_Type.tp_as_number->nb_multiply, nb_floor_divide, nb_power and PyFloat_Type's nb_absolute and calls them on"] [895 1 "// operands of the type (queue 521). The other slots stay NULL, as before."] [909 23 "// sizeof(PyNumberMethods), zeroed"] [916 2 "// tp_methods (offset 232) of int and float: the METH_NOARGS methods _decimal's exec finds by name there"] [917 2 "// (cfunc_noargs: int.bit_length, float.as_integer_ratio) and calls as C functions, each a native calling the method"] [923 51 "// PyMethodDef: ml_name, ml_meth, ml_flags, ml_doc; a NULL entry last"] [931 26 "// METH_NOARGS"] [937 1 "// staticBufs keep the blocks bindNumberMethods made for the process."] [940 1 "// importLeaf is PyImport_Import's module (Python/import.c): the named module itself, a dotted name's leaf from"] [941 1 "// sys.modules after the import (ExtImportModule gives the top-level package, as __import__ does; queue 521: _decimal's"] [942 1 "// PyImport_ImportModule(\"collections.abc\"))."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[48 28] [109 16] [109 18] [123 35] [126 16] [126 18] [136 20] [158 27] [208 21] [276 47] [283 45] [284 23] [311 26] [392 35] [395 38] [415 48] [507 22] [718 20] [718 42] [741 24] [762 29] [791 20] [791
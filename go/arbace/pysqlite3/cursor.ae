(in-ns 'go.arbace.pysqlite3) ^{:go/comments [[7 1 "/* cursor.c */"] [19 22 "// the connection's Python object"] [31 22 "// a subclass's instance wrapping this Cursor"] [136 5 "/* Converter names are split at '(' and blanks. This allows 'INTEGER NOT NULL' to be treated as\n\t\t\t\t   'INTEGER' and 'NUMBER(10)' to be treated as 'NUMBER', for example. In other words, it will work as\n\t\t\t\t   people expect it to work.*/"] [172 1 "// column bytes: sqlite3_column_blob/text, then sqlite3_column_bytes (nil, false: NULL)"] [186 1 "/*\n * Returns a row from the currently active SQLite statement\n *\n * Precondidition:\n * - sqlite3_step() has been called before and it returned SQLITE_ROW.\n */"] [204 3 "/*\n\t\t * Note, sqlite3_column_bytes() must come after sqlite3_column_blob() or sqlite3_column_text().\n\t\t *\n\t\t * See https://sqlite.org/c3ref/column_blob.html for details.\n\t\t */"] [257 5 "/* coltype == SQLITE_BLOB */"] [276 1 "// check_cursor checks if a cursor object is usable."] [384 1 "/* returns 0 if the object is one of Python's internal ones that don't need to be adapted */"] [423 3 "/* parameters passed as sequence */"] [449 5 "// PyList_GetItemRef: the list as it is now (an adapter may mutate it)"] [468 3 "/* parameters passed as dictionary */"] [474 34 "/* skip first char (the colon) */"] [492 1 "// Len is len(o)."] [537 3 "/* sequence or iterator */"] [548 2 "/* reset description */"] [552 3 "// Reset pending statements on this cursor."] [581 2 "/* We start a transaction implicitly before a DML statement. SELECT is the only exception. See #9924. */"] [605 5 "/* there was an error that occurred in a user-defined callback */"] [610 4 "// no exception when the database has none (a NULL statement, \"\": sqlite3_step's misuse): the execution"] [611 4 "// ends as a success, lastrowid left as it was"] [650 1 "// tpName is Py_TYPE(o)->tp_name: the module's types with their module, a Python subclass its name."] [659 1 "// printError is PyErr_Print: sys.excepthook with the exception."] [680 1 "// formatFromCause is _PyErr_FormatFromCause: a new exception whose __cause__ (and __context__) is cause."] [700 2 "// Commit if needed"] [748 21 "// GH-80254: Prevent recursive use of cursors."] [762 71 "// nil: the iteration ends"] [794 1 "// uint32Arg is clinic's uint32 converter (PyLong_AsUInt32)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[53 37] [66 50] [104 19] [104 26] [159 7] [159 27] [197 12] [197 25] [270 25] [284 49] [287 53] [337 44] [426 34] [428 40] [441 13] [441 29] [448 34] [458 66] [462 48] [466 42] [469 20] [469 44] [482 39] [494 28] [510 30] [538 53] [584 47] [598 60] [604 25] [615 46] [622 21] [622 34] [683 29] [691 30] [741 30] [774 37] [780 50] [783 54] [894 37] [936 24]]} (go/file "cursor.go" :imports [



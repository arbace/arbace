(in-ns 'go.arbace.pysqlite3) ^{:go/comments [[7 1 "/* cursor.c */"] [19 22 "// the connection's Python object"] [31 22 "// a subclass's instance wrapping this Cursor"] [73 1 "// cursor_finalize is cursor_dealloc's reset (queue 241): a cursor's death resets its statement, so the statement"] [74 1 "// cache's copy no longer holds the table's lock (test_regression's test_table_lock_cursor_dealloc)."] [145 5 "/* Converter names are split at '(' and blanks. This allows 'INTEGER NOT NULL' to be treated as\n\t\t\t\t   'INTEGER' and 'NUMBER(10)' to be treated as 'NUMBER', for example. In other words, it will work as\n\t\t\t\t   people expect it to work.*/"] [181 1 "// column bytes: sqlite3_column_blob/text, then sqlite3_column_bytes (nil, false: NULL)"] [195 1 "/*\n * Returns a row from the currently active SQLite statement\n *\n * Precondidition:\n * - sqlite3_step() has been called before and it returned SQLITE_ROW.\n */"] [213 3 "/*\n\t\t * Note, sqlite3_column_bytes() must come after sqlite3_column_blob() or sqlite3_column_text().\n\t\t *\n\t\t * See https://sqlite.org/c3ref/column_blob.html for details.\n\t\t */"] [266 5 "/* coltype == SQLITE_BLOB */"] [285 1 "// check_cursor checks if a cursor object is usable."] [393 1 "/* returns 0 if the object is one of Python's internal ones that don't need to be adapted */"] [432 3 "/* parameters passed as sequence */"] [458 5 "// PyList_GetItemRef: the list as it is now (an adapter may mutate it)"] [477 3 "/* parameters passed as dictionary */"] [483 34 "/* skip first char (the colon) */"] [501 1 "// Len is len(o)."] [546 3 "/* sequence or iterator */"] [557 2 "/* reset description */"] [561 3 "// Reset pending statements on this cursor."] [590 2 "/* We start a transaction implicitly before a DML statement. SELECT is the only exception. See #9924. */"] [611 3 "// a write's commit is SQLite's at its end, held back by another statement still stepping: CPython's dead cursors"] [612 3 "// have reset theirs by now (queue 550)"] [619 5 "/* there was an error that occurred in a user-defined callback */"] [624 4 "// no exception when the database has none (a NULL statement, \"\": sqlite3_step's misuse): the execution"] [625 4 "// ends as a success, lastrowid left as it was"] [664 1 "// tpName is Py_TYPE(o)->tp_name: the module's types with their module, a Python subclass its name."] [673 1 "// printError is PyErr_Print: sys.excepthook with the exception."] [694 1 "// formatFromCause is _PyErr_FormatFromCause: a new exception whose __cause__ (and __context__) is cause."] [714 2 "// Commit if needed"] [762 21 "// GH-80254: Prevent recursive use of cursors."] [776 71 "// nil: the iteration ends"] [808 1 "// uint32Arg is clinic's uint32 converter (PyLong_AsUInt32)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[53 37] [66 50] [76 25] [113 19] [113 26] [168 7] [168 27] [206 12] [206 25] [279 25] [293 49] [296 53] [346 44] [435 34] [437 40] [450 13] [450 29] [457 34] [467 66] [471 48] [475 42] [478 20] [478 44] [491 39] [503 28] [519 30] [547 53] [593 47] [607 60] [618 25] [629 46] [636 21] [636 34] [697 29] [705 30] [755 30] [788 37] [794 50] [797 54] [912 37] [954 24]]} (go/file "cursor.go" :imports [



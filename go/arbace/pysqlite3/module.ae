sUTF8AndSize with no embedded NUL)."] [425 1 "/* prepare_protocol.c */"] [432 2 "// a C type's instance with state and no __getstate__ (object_getstate): \"cannot pickle 'TP_NAME' object\""] [433 2 "// (protocols 0 and 1: copyreg's _reduce_ex, with the type's __name__)"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[183 36] [211 80] [227 48] [268 38] [306 58] [439 34] [440 26]]} (go/file "module.go" :imports [



(in-ns 'go.arbace.pysqlite3) ^{:go/comments [[10 1 "/* connection.c */"] [26 15 "// sqlite3 *"] [29 2 "/* the type detection mode. Only 0, PARSE_DECLTYPES, PARSE_COLNAMES or a bitwise combination thereof makes\n\t   sense */"] [33 2 "/* NULL (has: false) for autocommit, otherwise a string with the isolation level */"] [38 2 "/* 1 if a check should be performed for each API call if the connection is used from the same thread it was\n\t   created in */"] [43 2 "/* thread identification of the thread the connection was created in */"] [48 2 "/* the blobs opened from this connection (CPython: weak references) */"] [51 2 "/* Counters for how many cursors were created in the connection. */"] [57 2 "// pyobj is a subclass's instance wrapping this Connection (nil: the Connection itself). The connection and its"] [58 2 "// statement cache (an lru_cache over the connection) form a cycle, which Go's collector does not finalize: a"] [59 2 "// connection never closed keeps its database open until the process ends."] [62 17 "// the finalizer set (once: __init__ may run again)"] [64 2 "// Remember contexts used by the trace, progress, and authoriser callbacks"] [83 1 "// isolation_level_converter: has false for None."] [132 1 "// prepare is sqlite3_prepare_v2(db, sql, len, &stmt, &tail): rc, the statement, the tail's offset in sql."] [175 2 "// Create and configure SQLite database object."] [195 3 "// There are no statements or other SQLite objects attached to the database, so sqlite3_close() should"] [196 3 "// always return SQLITE_OK."] [204 2 "// Create LRU statement cache; returns a new reference."] [210 2 "// Init connection state members."] [226 14 "// Don't goto error; at this point, dealloc will clean up."] [243 1 "// setFinalizer: connection_finalize when the object is collected without close() (CPython's ResourceWarning is not"] [244 1 "// given: the finalizer runs without the GIL); sqlite3_close_v2 waits for the statements' finalizers."] [254 1 "// sysAudit is PySys_Audit(event, \"O\", arg): sys.audit."] [268 1 "// fsConverter is PyUnicode_FSConverter: str (encoded with the file system's encoding), bytes, or a path-like."] [313 2 "/* The v2 close call always returns SQLITE_OK if given a valid database pointer (which we do), so we can safely\n\t   ignore the return value */"] [345 1 "// obj is the connection's Python object (a subclass's instance wraps the Connection)."] [384 2 "// Add our blob to connection blobs list"] [404 1 "// pysqlite_check_connection checks if a connection object is usable (i. e. not closed)."] [471 1 "// create_callback_context: a handle for callable, its refcount 1."] [525 3 "/* Workaround for SQLite bug: no error code or string is available here */"] [552 3 "/* Errors are not set on the database connection; use result code instead. */"] [573 3 "/* Workaround for SQLite bug: no error code or string is available here */"] [610 3 "/* None clears the progress handler previously set */"] [629 3 "/* None clears the trace callback previously set */"] [668 3 "// Execute a COMMIT to re-enable autocommit mode"] [740 2 "// PyImport_ImportModuleAttrString: the submodule itself (the import gives the package)"] [796 5 "/* Callback failed: abort backup and bail. */"] [801 3 "/* Sleep for a while if there are still further pages to copy and the engine could not make any progress */"] [834 3 "/* Unlike other sqlite3_* functions, the destructor callback is _not_ called if\n\t\t   sqlite3_create_collation_v2() fails, so we have to free the context before returning. */"] [851 2 "/* If SQLite has a contiguous memory representation of the database, we can avoid memory allocations, so we\n\t   try with the no-copy flag first. */"] [881 2 "/* Transfer ownership of the buffer to SQLite: move buffer from Py to SQLite, tell SQLite to free buffer\n\t   memory, tell SQLite that it is permitted to grow the resulting database. */"] [910 4 "/* Commit failed; try to rollback in order to unlock the database. If rollback also fails, chain the\n\t\t\t   exceptions. */"] [938 3 "// SQLITE_DBCONFIG_ENABLE_FKEY .. SQLITE_DBCONFIG_TRUSTED_SCHEMA"] [1034 1 "// strArg is clinic's \"str\" converter with _PyArg_BadArgument's message."] [1061 16 "// queue 263: 3.15.2's Connection(database, *, ...)"] [1184 2 "// queue 263: 3.15.2 made these parameters positional-only (connection.c's clinic, \"/\" after them): fewer positional"] [1185 2 "// arguments than they are is clinic's TypeError, and no DeprecationWarning is left to give"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[110 24] [160 49] [170 35] [225 55] [236 48] [247 16] [321 39] [324 43] [354 39] [357 43] [379 17] [390 39] [398 34] [416 39] [419 43] [424 50] [429 49] [432 48] [440 39] [443 43] [448 52] [453 51] [456 48] [508 39] [511 43] [514 48] [535 39] [538 43] [541 60] [559 39] [562 43] [565 50] [580 39] [583 43] [603 39] [606 43] [622 39] [625 43] [642 29] [653 43] [681 39] [684 43] [704 83] [719 52] [726 43] [734 43] [737 53] [763 39] [766 43] [769 45] [795 117] [817 39] [820 43] [845 39] [848 43] [875 39] [878 43] [912 57] [922 39] [925 43] [945 39] [948 43] [972 39] [975 43] [992 39] [995 43] [1011 39] [1014 43] [1068 37] [1086 37] [1091 38] [1096 63] [1101 45] [1109 36] [1114 31] [1119 51] [1155 31] [1163 60] [1168 35] [1179 41] [1187 37] [1213 62] [1222 100] [1247 61] [1256 88] [1269 41] [1306 25] [1354 60] [1363 83] [1369 67] [1378 80] [1388 64] [1397 78] [1435 63] [1448 29] [1451 44] [1456 65] [1481 36] [1487 62] [1504 34] [1531 41] [1537 41]]} (go/file "connection.go" :imports [



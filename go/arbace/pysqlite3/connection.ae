(in-ns 'go.arbace.pysqlite3) ^{:go/comments [[10 1 "/* connection.c */"] [26 15 "// sqlite3 *"] [29 2 "/* the type detection mode. Only 0, PARSE_DECLTYPES, PARSE_COLNAMES or a bitwise combination thereof makes\n\t   sense */"] [33 2 "/* NULL (has: false) for autocommit, otherwise a string with the isolation level */"] [38 2 "/* 1 if a check should be performed for each API call if the connection is used from the same thread it was\n\t   created in */"] [43 2 "/* thread identification of the thread the connection was created in */"] [48 2 "/* the blobs opened from this connection (CPython: weak references) */"] [51 2 "/* Counters for how many cursors were created in the connection. */"] [57 2 "// pyobj is a subclass's instance wrapping this Connection (nil: the Connection itself). The connection and its"] [58 2 "// statement cache (an lru_cache over the connection) form a cycle, which Go's collector does not finalize: a"] [59 2 "// connection never closed keeps its database open until the process ends."] [62 2 "// Remember contexts used by the trace, progress, and authoriser callbacks"] [81 1 "// isolation_level_converter: has false for None."] [130 1 "// prepare is sqlite3_prepare_v2(db, sql, len, &stmt, &tail): rc, the statement, the tail's offset in sql."] [170 2 "// Create and configure SQLite database object."] [190 3 "// There are no statements or other SQLite objects attached to the database, so sqlite3_close() should"] [191 3 "// always return SQLITE_OK."] [199 2 "// Create LRU statement cache; returns a new reference."] [205 2 "// Init connection state members."] [231 1 "// setFinalizer: connection_finalize when the object is collected without close() (CPython's ResourceWarning is not"] [232 1 "// given: the finalizer runs without the GIL); sqlite3_close_v2 waits for the statements' finalizers."] [242 1 "// fsConverter is PyUnicode_FSConverter: str (encoded with the file system's encoding), bytes, or a path-like."] [287 2 "/* The v2 close call always returns SQLITE_OK if given a valid database pointer (which we do), so we can safely\n\t   ignore the return value */"] [319 1 "// obj is the connection's Python object (a subclass's instance wraps the Connection)."] [358 2 "// Add our blob to connection blobs list"] [378 1 "// pysqlite_check_connection checks if a connection object is usable (i. e. not closed)."] [445 1 "// create_callback_context: a handle for callable, its refcount 1."] [499 3 "/* Workaround for SQLite bug: no error code or string is available here */"] [526 3 "/* Errors are not set on the database connection; use result code instead. */"] [547 3 "/* Workaround for SQLite bug: no error code or string is available here */"] [584 3 "/* None clears the progress handler previously set */"] [603 3 "/* None clears the trace callback previously set */"] [642 3 "// Execute a COMMIT to re-enable autocommit mode"] [714 2 "// PyImport_ImportModuleAttrString: the submodule itself (the import gives the package)"] [770 5 "/* Callback failed: abort backup and bail. */"] [775 3 "/* Sleep for a while if there are still further pages to copy and the engine could not make any progress */"] [808 3 "/* Unlike other sqlite3_* functions, the destructor callback is _not_ called if\n\t\t   sqlite3_create_collation_v2() fails, so we have to free the context before returning. */"] [825 2 "/* If SQLite has a contiguous memory representation of the database, we can avoid memory allocations, so we\n\t   try with the no-copy flag first. */"] [855 2 "/* Transfer ownership of the buffer to SQLite: move buffer from Py to SQLite, tell SQLite to free buffer\n\t   memory, tell SQLite that it is permitted to grow the resulting database. */"] [884 4 "/* Commit failed; try to rollback in order to unlock the database. If rollback also fails, chain the\n\t\t\t   exceptions. */"] [912 3 "// SQLITE_DBCONFIG_ENABLE_FKEY .. SQLITE_DBCONFIG_TRUSTED_SCHEMA"] [1008 1 "// strArg is clinic's \"str\" converter with _PyArg_BadArgument's message."]] :go/pos
(in-ns 'go.arbace.pysqlite3) ^{:go/comments [[10 1 "/* connection.c */"] [26 15 "// sqlite3 *"] [29 2 "/* the type detection mode. Only 0, PARSE_DECLTYPES, PARSE_COLNAMES or a bitwise combination thereof makes\n\t   sense */"] [33 2 "/* NULL (has: false) for autocommit, otherwise a string with the isolation level */"] [38 2 "/* 1 if a check should be performed for each API call if the connection is used from the same thread it was\n\t   created in */"] [43 2 "/* thread identification of the thread the connection was created in */"] [48 2 "/* the blobs opened from this connection (CPython: weak references) */"] [51 2 "/* Counters for how many cursors were created in the connection. */"] [57 2 "// pyobj is a subclass's instance wrapping this Connection (nil: the Connection itself). The connection and its"] [58 2 "// statement cache (an lru_cache over the connection) form a cycle, which Go's collector does not finalize: a"] [59 2 "// connection never closed keeps its database open until the process ends."] [62 17 "// the finalizer set (once: __init__ may run again)"] [64 2 "// stmts_final is the record of the handles close finalized (queue 550), which the connection's statements share"] [67 2 "// Remember contexts used by the trace, progress, and authoriser callbacks"] [86 1 "// isolation_level_converter: has false for None."] [135 1 "// prepare is sqlite3_prepare_v2(db, sql, len, &stmt, &tail): rc, the statement, the tail's offset in sql."] [178 2 "// Create and configure SQLite database object."] [198 3 "// There are no statements or other SQLite objects attached to the database, so sqlite3_close() should"] [199 3 "// always return SQLITE_OK."] [207 2 "// Create LRU statement cache; returns a new reference."] [213 2 "// Init connection state members."] [229 14 "// Don't goto error; at this point, dealloc will clean up."] [246 1 "// setFinalizer: connection_finalize when the object is collected without close() (CPython's ResourceWarning is not"] [247 1 "// given: the finalizer runs without the GIL); sqlite3_close_v2 waits for the statements' finalizers."] [257 1 "// sysAudit is PySys_Audit(event, \"O\", arg): sys.audit."] [271 1 "// fsConverter is PyUnicode_FSConverter: str (encoded with the file system's encoding), bytes, or a path-like."] [317 2 "/* The v2 close call always returns SQLITE_OK if given a valid database pointer (which we do), so we can safely\n\t   ignore the return value */"] [324 1 "// finalize_statements finalizes the connection's statements no cursor is stepping before close's sqlite3_close_v2"] [325 1 "// (queue 550), as CPython's close finds them gone: its statement cache cleared, its dead cursors' statements freed by"] [326 1 "// their reference counts (a statement not stepping is the cache's or a finished cursor's: a cursor drops its statement"] [327 1 "// once done). So the database is closed then (a WAL database checkpointed, its -wal and -shm removed) instead of when"] [328 1 "// Go's collector finalizes them. A stepping statement stays with the database left open, as CPython leaves a live"] [329 1 "// cursor's (test_connection_reinit reads the old database through one after __init__). The finalized handles are"] [330 1 "// recorded (final), so their statements' later reset and Go finalizer skip them."] [349 1 "// reset_dead_cursors is what CPython's reference counts have done before a write or a COMMIT (queue 550): a statement of"] [350 1 "// the connection still stepping (but except, the one about to run) keeps SQLite from committing (an autocommit write's"] [351 1 "// end or COMMIT: dbm.sqlite3's PRAGMA journal_mode cursor, never closed, held every write back), so when one is, the"] [352 1 "// finalizers of what is dead now run (ExtFinRounds), each dead cursor resetting its statement (cursor_finalize). A live"] [353 1 "// cursor's statement stays, as in CPython, where a cursor kept stepping holds the commit back too."] [388 1 "// obj is the connection's Python object (a subclass's instance wraps the Connection)."] [427 2 "// Add our blob to connection blobs list"] [447 1 "// pysqlite_check_connection checks if a connection object is usable (i. e. not closed)."] [515 1 "// create_callback_context: a handle for callable, its refcount 1."] [569 3 "/* Workaround for SQLite bug: no error code or string is available here */"] [596 3 "/* Errors are not set on the database connection; use result code instead. */"] [617 3 "/* Workaround for SQLite bug: no error code or string is available here */"] [654 3 "/* None clears the progress handler previously set */"] [673 3 "/* None clears the trace callback previously set */"] [712 3 "// Execute a COMMIT to re-enable autocommit mode"] [784 2 "// PyImport_ImportModuleAttrString: the submodule itself (the import gives the package)"] [840 5 "/* Callback failed: abort backup and bail. */"] [845 3 "/* Sleep for a while if there are still further pages to copy and the engine could not make any progress */"] [878 3 "/* Unlike other sqlite3_* functions, the destructor callback is _not_ called if\n\t\t   sqlite3_create_collation_v2() fails, so we have to free the context before returning. */"] [895 2 "/* If SQLite has a contiguous memory representation of the database, we can avoid memory allocations, so we\n\t   try with the no-copy flag first. */"] [925 2 "/* Transfer ownership of the buffer to SQLite: move buffer from Py to SQLite, tell SQLite to free buffer\n\t   memory, tell SQLite that it is permitted to grow the resulting database. */"] [954 4 "/* Commit failed; try to rollback in order to unlock the database. If rollback also fails, chain the\n\t\t\t   exceptions. */"] [982 3 "// SQLITE_DBCONFIG_ENABLE_FKEY .. SQLITE_DBCONFIG_TRUSTED_SCHEMA"] [1078 1 "// strArg is clinic's \"str\" converter with _PyArg_BadArgument's message."] [1105 16 "// queue 263: 3.15.2's Connection(database, *, ...)"] [1228 2 "// queue 263: 3.15.2 made these parameters positional-only (connection.c's clinic, \"/\" after them): fewer positional"] [1229 2 "// arguments than they are is clinic's TypeError, and no DeprecationWarning is left to give"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[113 24] [163 49] [173 35] [228 55] [239 48] [250 16] [338 56] [338 65] [355 56] [355 65] [364 39] [367 43] [397 39] [400 43] [422 17] [433 39] [441 34] [459 39] [462 43] [468 50] [473 49] [476 48] [484 39] [487 43] [492 52] [497 51] [500 48] [552 39] [555 43] [558 48] [579 39] [582 43] [585 60] [603 39] [606 43] [609 50] [624 39] [627 43] [647 39] [650 43] [666 39] [669 43] [686 29] [697 43] [725 39] [728 43] [748 83] [763 52] [770 43] [778 43] [781 53] [807 39] [810 43] [813 45] [839 117] [861 39] [864 43] [889 39] [892 43] [919 39] [922 43] [956 57] [966 39] [969 43] [989 39] [992 43] [1016 39] [1019 43] [1036 39] [1039 43] [1055 39] [1058 43] [1112 37] [1130 37] [1135 38] [1140 63] [1145 45] [1153 36] [1158 31] [1163 51] [1199 31] [1207 60] [1212 35] [1223 41] [1231 37] [1257 62] [1266 100] [1291 61] [1300 88] [1313 41] [1350 25] [1398 60] [1407 83] [1413 67] [1422 80] [1432 64] [1441 78] [1479 63] [1492 29] [1495 44] [1500 65] [1525 36] [1531 62] [1548 34] [1575 41] [1581 41]]} (go/file "connection.go" :imports [



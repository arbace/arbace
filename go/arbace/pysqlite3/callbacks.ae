(in-ns 'go.arbace.pysqlite3) ^{:go/comments [[8 1 "/* connection.c's callbacks, as ci's natives: tools/pyi/clib/sqlite/pysqlite.c declares them extern and hands them to\n   SQLite. They run on the goroutine that called into the library, the GIL held (CPython's PyGILState_Ensure). */"] [155 1 "// Checks the Python exception and sets the appropriate SQLite error code."] [187 1 "// aggregate_instance: sqlite3_aggregate_context's 8 bytes hold the instance's handle (0: none yet)."] [229 3 "/* No rows matched the query; the step handler was never called. */"] [234 3 "/* this branch is executed if there was an exception in the aggregate's __init__ */"] [240 2 "// Keep the exception (if any) of the last call to step, value, or inverse"] [256 3 "/* Note: contrary to the step, value, and inverse callbacks, SQLite does _not_, as of SQLite 3.38.0,\n\t\t   propagate errors to sqlite3_step() from the finalize callback. This implies that execute*() will not\n\t\t   raise OperationalError, as it normally would. */"] [269 1 "/*\n * Regarding the 'inverse' aggregate callback: this method is only required by window aggregate functions, not\n * ordinary aggregate function implementations. It is invoked to remove a row from the current window. The function\n * arguments, if any, correspond to the row being removed.\n */"] [295 1 "/*\n * Regarding the 'value' aggregate callback: this method is only required by window aggregate functions, not ordinary\n * aggregate function implementations. It is invoked to return the current value of the aggregate.\n */"] [359 3 "/* abort query if error occurred */"] [375 1 "/*\n * From https://sqlite.org/c3ref/trace_v2.html: the integer return value from the callback is currently ignored,\n * though this may change in future releases. Callback implementations should return zero to ensure future\n * compatibility.\n */"] [396 3 "// Fall back to unexpanded sql"] [411 1 "/* ------------------------- COLLATION CODE ------------------------ */"] [416 2 "/* This callback may be executed multiple times per sqlite3_step(). Bail if the previous call failed */"] [432 3 "/* execution failed */"] [438 3 "// PyLong_AsLongAndOverflow: __index__, else a TypeError cleared"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[82 40] [110 12] [110 22] [147 21] [221 57] [290 53] [316 53]]} (go/file "callbacks.go" :imports [


    ^{:go/apos {1 [4 2]} :go/pos {:lparen [3 8] :rparen [6 1] :tok-pos [3 1]}} [ci "arbace/ci"]
    ^{:go/apos {1 [5 4]}} [^{:go/pos {:name-pos [5 2]}} . "arbace/py"]])



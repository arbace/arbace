(in-ns 'go.arbace.clib.worlds)

(go/file "worlds.go"
  :doc "Package worlds links the C worlds compiled by cf2g into a program that lists it in goi's table (queue 521, DECISION\n521-2 (b): Arbace's executable): each world's package arbace/clib/LIB/aot (bin/pyi-clib aot-forms, committed under go/)\nregisters its setup with arbace/clib at the program's start, so arbace/clib's Open of LIB runs it compiled instead of\nloading its node program into ci's interpreter (25-90 s under goi for ctypestest). A world joins by its import here and its\nlib.conf's compiled=1; a process whose arbace/clib is interpreted (goi from source) never sees these registrations and\nloads the node program, the fallback.\n"
  :imports [[_ "arbace/clib/ctypestest/aot"]])

(go/var ^{:doc "Names are the worlds this package links, in import order.\n"} Names (lit (slice string) "ctypestest"))

;; Package libm is musl 1.2.6's libm, the functions GHC 9.14.1's code calls, shared by hsi (arbace/hs, HES37 (a),
;; doc/haskell/HASKELL-EVAL-SURVEY.md, "As built: HE4b, HE4c (write-ahead)", "As built: HES38's :full forms") and pyi;
;; ported to Go by hand from https://musl.libc.org/releases/musl-1.2.6.tar.gz
;; (SHA-256 d585fd3b613c66151fc3249e8ed44f77020cb5e6c1e635a616d3f9f82460512a), src/math: exp.c, exp_data.c, expm1.c,
;; log.c, log_data.c, log1p.c, pow.c, pow_data.c, sin.c, cos.c, tan.c, __sin.c, __cos.c, __tan.c, __rem_pio2.c,
;; __rem_pio2_large.c, scalbn.c, asin.c, acos.c, atan.c, atan2.c, sinh.c, cosh.c, tanh.c, __expo2.c, asinh.c,
;; acosh.c, atanh.c, __math_*.c and their float versions (expf.c, exp2f_data.c, expm1f.c, logf.c, logf_data.c,
;; log1pf.c, powf.c, powf_data.c, sinf.c, cosf.c, tanf.c, __sindf.c, __cosdf.c, __tandf.c, __rem_pio2f.c, asinf.c,
;; acosf.c, atanf.c, atan2f.c, sinhf.c, coshf.c, tanhf.c, __expo2f.c, asinhf.c, acoshf.c, atanhf.c), as x86_64
;; compiles them (FLT_EVAL_METHOD 0, no FMA, TOINT_INTRINSICS 0, WANT_ROUNDING 1). musl is Copyright (c) 2005-2020
;; Rich Felker et al., under the MIT license; the exp, log, pow, expf, logf and powf code and data are Copyright (c)
;; 2017-2018 Arm Limited (MIT), the rest from FreeBSD's msun (Copyright (C) 1993 Sun Microsystems, Inc.: "Permission
;; to use, copy, modify, and distribute this software is freely granted, provided that this notice is preserved");
;; LICENSE.md. The floating-point exceptions and errno are not kept (no caller reads them). Every named constant is a
;; variable, never a Go constant, so that each operation is rounded as C rounds it (Go folds constant expressions
;; exactly); a C literal without f is a double, and float arithmetic mixed with it is done in double, as in C.
(in-ns 'go.arbace.libm) ^{:go/comments [[1 1 "// Package libm is musl 1.2.6's libm, the functions GHC 9.14.1's code calls, shared by hsi (arbace/hs, HES37 (a),"] [2 1 "// doc/haskell/HASKELL-EVAL-SURVEY.md, \"As built: HE4b, HE4c (write-ahead)\", \"As built: HES38's :full forms\") and pyi;"] [3 1 "// ported to Go by hand from https://musl.libc.org/releases/musl-1.2.6.tar.gz"] [4 1 "// (SHA-256 d585fd3b613c66151fc3249e8ed44f77020cb5e6c1e635a616d3f9f82460512a), src/math: exp.c, exp_data.c, expm1.c,"] [5 1 "// log.c, log_data.c, log1p.c, pow.c, pow_data.c, sin.c, cos.c, tan.c, __sin.c, __cos.c, __tan.c, __rem_pio2.c,"] [6 1 "// __rem_pio2_large.c, scalbn.c, asin.c, acos.c, atan.c, atan2.c, sinh.c, cosh.c, tanh.c, __expo2.c, asinh.c,"] [7 1 "// acosh.c, atanh.c, __math_*.c and their float versions (expf.c, exp2f_data.c, expm1f.c, logf.c, logf_data.c,"] [8 1 "// log1pf.c, powf.c, powf_data.c, sinf.c, cosf.c, tanf.c, __sindf.c, __cosdf.c, __tandf.c, __rem_pio2f.c, asinf.c,"] [9 1 "// acosf.c, atanf.c, atan2f.c, sinhf.c, coshf.c, tanhf.c, __expo2f.c, asinhf.c, acoshf.c, atanhf.c), as x86_64"] [10 1 "// compiles them (FLT_EVAL_METHOD 0, no FMA, TOINT_INTRINSICS 0, WANT_ROUNDING 1). musl is Copyright (c) 2005-2020"] [11 1 "// Rich Felker et al., under the MIT license; the exp, log, pow, expf, logf and powf code and data are Copyright (c)"] [12 1 "// 2017-2018 Arm Limited (MIT), the rest from FreeBSD's msun (Copyright (C) 1993 Sun Microsystems, Inc.: \"Permission"] [13 1 "// to use, copy, modify, and distribute this software is freely granted, provided that this notice is preserved\");"] [14 1 "// LICENSE.md. The floating-point exceptions and errno are not kept (no caller reads them). Every named constant is a"] [15 1 "// variable, never a Go constant, so that each operation is rounded as C rounds it (Go folds constant expressions"] [16 1 "// exactly); a C literal without f is a double, and float arithmetic mixed with it is done in double, as in C."] [33 1 "// lmInvalid is __math_invalid: (x - x) / (x - x), the default NaN of x86's SSE for a finite x"] [125 1 "// ---- exp (exp.c)"] [189 1 "// ---- expm1 (expm1.c)"] [287 1 "// ---- log (log.c)"] [346 1 "// ---- log1p (log1p.c)"] [414 1 "// ---- pow (pow.c)"] [612 1 "// ---- the trigonometric functions' kernels (__sin.c, __cos.c, __tan.c)"] [712 1 "// ---- argument reduction (__rem_pio2.c, __rem_pio2_large.c, scalbn.c)"] [715 23 "// 1.5/DBL_EPSILON, written as its value (a variable, the port's rule)"] [1057 1 "// ---- sin, cos, tan (sin.c, cos.c, tan.c)"] [1125 1 "// ---- asin, acos, atan, atan2 (asin.c, acos.c, atan.c, atan2.c)"] [1301 1 "// lmNaN2 is the NaN C's x + y gives when x or y is one, as the host's x86_64 musl computes it: addsd keeps its first"] [1302 1 "// operand's NaN, quieted, and gcc made x the first in pow and y in atan2 (their callers pass them so); Go's x + y may"] [1303 1 "// be emitted with its operands either way (arm64's gc swaps them; review 189, L1)."] [1311 1 "// lmNaN2f is lmNaN2 of float32 operands."] [1398 1 "// ---- the hyperbolic functions (__expo2.c, sinh.c, cosh.c, tanh.c, asinh.c, acosh.c, atanh.c)"] [1526 1 "// ---- expf, logf, powf (expf.c, logf.c, powf.c, exp2f_data.c, logf_data.c, powf_data.c)"] [1724 1 "// ---- expm1f, log1pf (expm1f.c, log1pf.c)"] [1878 1 "// ---- sinf, cosf, tanf and their kernels (__sindf.c, __cosdf.c, __tandf.c, __rem_pio2f.c, sinf.c, cosf.c, tanf.c)"] [1934 24 "// 1.5/DBL_EPSILON, written as its value (a variable, the port's rule)"] [2124 1 "// ---- asinf, acosf, atanf, atan2f (asinf.c, acosf.c, atanf.c, atan2f.c)"] [2345 1 "// ---- sinhf, coshf, tanhf, asinhf, acoshf, atanhf (__expo2f.c and the rest)"] [2473 1 "// D and F: the C functions by name, for the ffi table, the primops and bin/hsi libm-check"] [2487 1 "// Call evaluates a libm function by its C name on arguments given as bit patterns (a double's 64 bits, a"] [2488 1 "// float's 32), its result as bits; ok false for an unknown name (bin/hsi libm-check's subject)"]] :go/pos {:name [17 9] :package [17 1]} :go/semis [[866 6] [866 13] [904 11] [904 19] [911 11] [911 20] [913 12] [913 21] [923 6] [923 13] [946 12] [946 20] [974 17] [974 26] [978 13] [978 28] [980 18] [980 29] [983 14] [983 23] [1012 12] [1012 20] [1016 12] [1016 20] [1018 12] [1018 34] [1026 13] [1026 21] [1036 13] [1036 21] [1045 12] [1045 21] [2490 21] [2493 21]] :go/trails [[665 28] [1217 28] [1224 28] [1238 28] [1915 24] [2477 62] [2484 18]]} (go/file "libm.go" :doc "Package libm is musl 1.2.6's libm, the functions GHC 9.14.1's code calls, shared by hsi (arbace/hs, HES37 (a),\ndoc/haskell/HASKELL-EVAL-SURVEY.md, \"As built: HE4b, HE4c (write-ahead)\", \"As built: HES38's :full forms\") and pyi;\nported to Go by hand from https://musl.libc.org/releases/musl-1.2.6.tar.gz\n(SHA-256 d585fd3b613c66151fc3249e8ed44f77020cb5e6c1e635a616d3f9f82460512a), src/math: exp.c, exp_data.c, expm1.c,\nlog.c, log_data.c, log1p.c, pow.c, pow_data.c, sin.c, cos.c, tan.c, __sin.c, __cos.c, __tan.c, __rem_pio2.c,\n__rem_pio2_large.c, scalbn.c, asin.c, acos.c, atan.c, atan2.c, sinh.c, cosh.c, tanh.c, __expo2.c, asinh.c,\nacosh.c, atanh.c, __math_*.c and their float versions (expf.c, exp2f_data.c, expm1f.c, logf.c, logf_data.c,\nlog1pf.c, powf.c, powf_data.c, sinf.c, cosf.c, tanf.c, __sindf.c, __cosdf.c, __tandf.c, __rem_pio2f.c, asinf.c,\nacosf.c, atanf.c, atan2f.c, sinhf.c, coshf.c, tanhf.c, __expo2f.c, asinhf.c, acoshf.c, atanhf.c), as x86_64\ncompiles them (FLT_EVAL_METHOD 0, no FMA, TOINT_INTRINSICS 0, WANT_ROUNDING 1). musl is Copyright (c) 2005-2020\nRich Felker et al., under the MIT license; the exp, log, pow, expf, logf and powf code and data are Copyright (c)\n2017-2018 Arm Limited (MIT), the rest from FreeBSD's msun (Copyright (C) 1993 Sun Microsystems, Inc.: \"Permission\nto use, copy, modify, and distribute this software is freely granted, provided that this notice is preserved\");\nLICENSE.md. The floating-point exceptions and errno are not kept (no caller reads them). Every named constant is a\nvariable, never a Go constant, so that each operation is rounded as C rounds it (Go folds constant expressions\nexactly); a C literal without f is a double, and float arithmetic mixed with it is done in double, as in C.\n" :imports [


              (set! (.-MmapNext k) addr)))

          (.Map (.-AS k) addr size (protPerm a3) "mmap")
          (return (conv int64 addr) nil))))
    (case [11] ; munmap
      (when (or (!= (bit-and a1 pageMask) 0) (== a2 0))
        (return (- eINVAL) nil))

      (.Unmap (.-AS k) a1 (pageUp a2))
      (return 0 nil))
    (case [10] ; mprotect
      (when (!= (bit-and a1 pageMask) 0)

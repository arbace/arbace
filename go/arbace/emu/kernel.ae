(in-ns 'go.arbace.emu) (go/file "kernel.go" :imports [


    ^{:line 4} [crt "arbace/crt"]])





(go/type Kernel "Kernel is the part of Linux's x86-64 system calls the machine's process needs beyond crt's (AXS52 (a)): the program\nbreak and the anonymous mappings at Linux's addresses, with their permissions; exit and exit_group; clone, fork,\nvfork and execve refused (one thread, AX5). Everything else is crt's Sys.Syscall, over the same Mem.\n" (struct
    ^{:line 11 :tag (* AS)} AS
    ^{:line 12 :tag (* crt/Sys)} Sys
    ^{:line 13 :tag uint64} BrkBase
    ^{:line 14 :tag uint64} Brk
    ^{:line 15 :tag uint64} MmapNext))



(go/const "Linux's errno values the layer returns.\n"
  ^{:line 20} [^{:val 12} eNOMEM 12]
  ^{:line 21} [^{:val 22} eINVAL 22]
  ^{:line 22} [^{:val 38} eNOSYS 38]
  ^{:line 23} [^{:val 19} eNODEV 19]
  ^{:line 24} [^{:val 9} eBADF 9]
  [^{:val 13} eACCES 13])



^{:go/end 30} (go/func NewKernel "NewKernel is the kernel of the program in a, its break from img.\n" ^{:tag (* Kernel)} [^{:tag (* AS)} a ^{:tag (* Image)} img ^{:tag (* crt/Sys)} sys]
  (addr (lit Kernel :AS a :Sys sys :BrkBase (.-BrkBase img) :Brk (.-BrkBase img) :MmapNext (- MmapTop VdsoSize))))


^{:go/end 32} (go/func pageUp ^uint64 [^uint64 n] (bit-and-not (+ n pageMask) pageMask))

^{:go/end 46} (go/func protPerm ^uint8 [^uint64 prot]
  (let [^uint8 p (zero uint8)]
    (when (!= (bit-and prot 1) 0)
      (set! p bit-or PermR))

    (when (!= (bit-and prot 2) 0)
      (set! p bit-or (bit-or PermW PermR)))

    (when (!= (bit-and prot 4) 0)
      (set! p bit-or (bit-or PermX PermR)))

    ^{:line 45} p))



(go/type Exited "Exited is a system call that ended the process.\n" (struct ^int Code))


^{:go/end 111} (go/method Syscall "Syscall performs system call n: its result (a value >= 0, or -errno), or the process's end.\n" [^{:tag (* Kernel)} k ^uint64 n ^uint64 a1 ^uint64 a2 ^uint64 a3 ^uint64 a4 ^uint64 a5 ^uint64 a6] :results [^int64 ret ^{:tag (* Exited)} exit]
  (switch n
    (case [60 231] ; exit, exit_group: one thread
      (return 0 (addr (lit Exited (conv int (bit-and a1 255))))))
    (case [12] ; brk
      (when (or (< a1 (.-BrkBase k)) (> a1 (+ (.-BrkBase k) (<< 1 30))))
        (return (conv int64 (.-Brk k)) nil))

      (let [(values old nw) (values (pageUp (.-Brk k)) (pageUp a1))]
        (cond (> nw old) (do
            (when (.Mapped (.-AS k) old (- nw old))
              (return (conv int64 (.-Brk k)) nil))

            (.Map (.-AS k) old (- nw old) (bit-or PermR PermW) "brk"))
          (< nw old)
          (.Unmap (.-AS k) nw (- old nw)))

        (set! (.-Brk k) a1)
        (return (conv int64 a1) nil)))
    (case [9] ; mmap(addr, len, prot, flags, fd, off)
      (let [size (pageUp a2)]
        (when (or (== size 0) (!= (bit-and a1 pageMask) 0))
          (return (- eINVAL) nil))

        (when (== (bit-and a4 0x20) 0) ; not MAP_ANONYMOUS: a file's mapping (AR22)
          (return (.fileMap k a1 size a3 a4 a5 a6)))

        (return (conv int64 (.MapAnon k a1 size a3 a4)) nil)))
    (case [11] ; munmap
      (when (or (!= (bit-and a1 pageMask) 0) (== a2 0))
        (return (- eINVAL) nil))

      (.Unmap (.-AS k) a1 (pageUp a2))
      (return 0 nil))
    (case [10] ; mprotect
      (when (!= (bit-and a1 pageMask) 0)
        (return (- eINVAL) nil))

      (when (not (.Protect (.-AS k) a1 (pageUp a2) (protPerm a3)))
        (return (- eNOMEM) nil))

      (return 0 nil))
    (case [25] ; mremap
      (return (- eNOMEM) nil))
    (case [56 57 58 59 435] ; clone, fork, vfork, execve, clone3: one thread, no exec (AX5)
      (return (- eNOSYS) nil))
    (case [0 1 17 18] ; read, write, pread64, pwrite64: a buffer over adjacent mappings (AR21)
      (let [oi -1]
        (when (or (== n 17) (== n 18))
          (set! oi 3))

        (return (.spanned k n (lit (array 6 uint64) a1 a2 a3 a4 a5 a6) 1 2 oi))))
    (case [318] ; getrandom(buf, count, flags)
      (return (.spanned k n (lit (array 6 uint64) a1 a2 a3 a4 a5 a6) 0 1 -1)))
    (case [217] ; getdents64: its count cut at the buffer's first mapping (fewer entries, as Linux may give)
      (return (.passthru k n a1 a2 (.within k a2 a3) a4 a5 a6))))

  (.passthru k n a1 a2 a3 a4 a5 a6))


(go/method MapAnon "MapAnon maps size bytes (page-aligned) of zeros with prot (mmap's) as mmap does under flags: at addr with MAP_FIXED, else\nat addr when it is free and below the stack's area, else at Linux's next address of mmap's area; the address.\n" ^uint64 [^{:tag (* Kernel)} k ^uint64 addr ^uint64 size ^uint64 prot ^uint64 flags]
  (cond (!= (bit-and flags 0x10) 0) ; MAP_FIXED
    (.Unmap (.-AS k) addr size)
    (or (== addr 0) (.Mapped (.-AS k) addr size) (> (+ addr size) (- StackTop StackSize))) (do
      (set! addr (- (.-MmapNext k) size))
      (while (.Mapped (.-AS k) addr size)
        (set! addr - pageSize))

      (set! (.-MmapNext k) addr)))

  (.Map (.-AS k) addr size (protPerm prot) "mmap")
  addr)


(go/method fileMap "fileMap is mmap of a file's descriptor fd (AR22, queue 294: cmd/compile's export data, cmd/internal/bio's and\nbase.MapFile's MAP_SHARED PROT_READ mappings): Linux's checks in its order (an offset not page-aligned EINVAL, the descriptor\nEBADF, no mapping type EINVAL, a descriptor not open for reading, or a shared writable mapping of one not open for writing,\nEACCES, not a regular file ENODEV), then MapAnon's pages with the file's bytes from off read in by crt's pread64, to the file's\nend (the rest zero). The mapping is a copy: a shared one does not see later writes to the file, a shared writable one (its\nwrites could not reach the file) is ENODEV, and the pages past the file's end read as zeros where Linux raises SIGBUS.\n" [^{:tag (* Kernel)} k ^uint64 addr ^uint64 size ^uint64 prot ^uint64 flags ^uint64 fd ^uint64 off] :results [^int64 ret ^{:tag (* Exited)} exit]
  (when (!= (bit-and off pageMask) 0)
    (return (- eINVAL) nil))

  (let [(values fl e) (.passthru k 72 fd 3 0 0 0 0)] ; fcntl(fd, F_GETFL)
    (when (!= e nil)
      (return 0 e))

    (when (< fl 0)
      (return fl nil))

    (let [typ (bit-and flags 3)
          acc (bit-and fl 3)
          shared (or (== typ 1) (== typ 3))
          writes (!= (bit-and prot 2) 0)]
      (when (== typ 0)
        (return (- eINVAL) nil))

      (when (or (== acc 1) (and shared writes (!= acc 2)))
        (return (- eACCES) nil))

      ;; pread64 of no bytes: a pipe's ESPIPE, a directory's EISDIR (not a regular file)
      (let [(values r e) (.passthru k 17 fd 0 0 off 0 0)]
        (when (!= e nil)
          (return 0 e))

        (when (== r (- eBADF))
          (return r nil))

        (when (< r 0)
          (return (- eNODEV) nil)))

      (when (and shared writes)
        (return (- eNODEV) nil))

      (let [a (.MapAnon k addr size prot flags)
            s (.Slab (.-M (.-AS k)) a)
            ro (.-RO s)
            ^uint64 done 0]
        ;; crt's pread64 writes into the slab even when the mapping is read-only
        (set! (.-RO s) false)
        (while (< done size)
          (let [(values r e) (.passthru k 17 fd (+ a done) (- size done) (+ off done) 0 0)]
            (when (!= e nil)
              (set! (.-RO s) ro)
              (return 0 e))

            (when (< r 0)
              (set! (.-RO s) ro)
              (.Unmap (.-AS k) a size)
              (return r nil))

            (when (== r 0)
              (break))

            (set! done + (conv uint64 r))))

        (set! (.-RO s) ro)
        (return (conv int64 a) nil)))))


(go/method within "within is n, or less: the bytes from a that lie in a's mapping (crt's slab), so that crt sees one slab; n when a is\nunmapped (crt's EFAULT then).\n" ^uint64 [^{:tag (* Kernel)} k ^uint64 a ^uint64 n]
  (let [s (.Slab (.-M (.-AS k)) a)]
    (when (or (== s nil) (<= n (- (.End s) a)))
      (return n))

    (- (.End s) a)))


(go/method spanned "spanned is a call whose buffer (args[bi], args[ci] bytes) adjacent mappings may hold (AR21, queue 292: Go's heap grows by\nadjacent mmaps, and crt's call sees one slab): read, write, pread64, pwrite64 and getrandom made a mapping's part at a time, the\noffset (args[oi], when oi >= 0) moved on, until a part is short, an error (the bytes done so far, else the error) or the end.\n" [^{:tag (* Kernel)} k ^uint64 n ^{:tag (array 6 uint64)} args ^int bi ^int ci ^int oi] :results [^int64 ret ^{:tag (* Exited)} exit]
  (let [^int64 total 0
        rem (aget args ci)]
    (while true
      (let [part (.within k (aget args bi) rem)
            a args]
        (aset a ci part)
        (let [(values r e) (.passthru k n (aget a 0) (aget a 1) (aget a 2) (aget a 3) (aget a 4) (aget a 5))]
          (when (!= e nil)
            (return 0 e))

          (when (< r 0)
            (when (> total 0)
              (return total nil))

            (return r nil))

          (set! total + r)
          (when (or (< (conv uint64 r) part) (== part rem))
            (return total nil))

          (aset args bi (+ (aget args bi) part))
          (set! rem - part)
          (when (>= oi 0)
            (aset args oi (+ (aget args oi) part))))))

    (return total nil)))

^{:go/end 124} (go/method passthru [^{:tag (* Kernel)} k ^uint64 n ^uint64 a1 ^uint64 a2 ^uint64 a3 ^uint64 a4 ^uint64 a5 ^uint64 a6] :results [^int64 ret ^{:tag (* Exited)} exit]
  (defer (^{:go/end 122} (fn []
        (when [r (recover)] (!= r nil)
          (when [(values e ok) (assert (* crt/Exit) r)] ok
            (set! (values ret exit) (values 0 (addr (lit Exited (.-Code e)))))
            (return))

          (panic r)))))


  (return (.Syscall (.-Sys k) (conv int64 n) a1 a2 a3 a4 a5 a6) nil))

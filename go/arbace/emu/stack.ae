(in-ns 'go.arbace.emu) (go/file "stack.go" :imports [])





^{:go/end 76} (go/func Stack "Stack builds the initial stack as Linux gives it to a new x86-64 process (the psABI §3.4.1, getauxval(3)): from the\ntop, eight zero bytes, the executable's name (AT_EXECFN), the environment's and the arguments' strings, then the\nplatform string, the 16 random bytes, the auxiliary vector, envp, argv and argc, RSP 16-aligned at argc. No\nAT_SYSINFO_EHDR: no vdso (musl falls back to the system call).\n" ^uint64 [^{:tag (* AS)} a ^{:tag (* Image)} img ^{:tag (slice string)} argv ^{:tag (slice string)} envp ^{:tag (array 16 byte)} random]
  (.Map a (- StackTop StackSize) StackSize (bit-or PermR PermW) "stack")
  (let [p (conv uint64 (- StackTop 8))
      ^{:line 10} put ^{:go/end 14} (fn ^uint64 [^string s]
        (set! p - (conv uint64 (+ (len s) 1)))
        (.WriteBytes a p (append (conv (slice byte) s) 0))
        ^{:line 13} p)

      ^{:line 15} execfn (put (aget argv 0))
      ^{:line 16} envAddr (make (slice uint64) (len envp))]
    (for [i (- (len envp) 1)] (>= i 0) (dec! i)
      (aset envAddr i (put (aget envp i))))

    (let [argAddr (make (slice uint64) (len argv))]
      (for [i (- (len argv) 1)] (>= i 0) (dec! i)
        (aset argAddr i (put (aget argv i))))

      (set! p bit-and-not 15)
      (let [platform (put "x86_64")]
        (set! p - 16)
        (let [rnd p]
          (.WriteBytes a rnd (subslice random))
          (let [aux (lit (slice (array 2 uint64))
                (lit _ 51 minSigStk) ; AT_MINSIGSTKSZ
                (lit _ 16 hwcapModel) ; AT_HWCAP
                (lit _ 6 pageSize) ; AT_PAGESZ
                (lit _ 17 100) ; AT_CLKTCK
                (lit _ 3 (.-Phdr img)) ; AT_PHDR
                (lit _ 4 (.-Phent img)) ; AT_PHENT
                (lit _ 5 (.-Phnum img)) ; AT_PHNUM
                (lit _ 7 0) ; AT_BASE
                (lit _ 8 0) ; AT_FLAGS
                (lit _ 9 (.-Entry img)) ; AT_ENTRY
                (lit _ 11 0) ; AT_UID
                (lit _ 12 0) ; AT_EUID
                (lit _ 13 0) ; AT_GID
                (lit _ 14 0) ; AT_EGID
                (lit _ 23 0) ; AT_SECURE
                (lit _ 25 rnd) ; AT_RANDOM
                (lit _ 26 2) ; AT_HWCAP2
                (lit _ 31 execfn) ; AT_EXECFN
                (lit _ 15 platform) ; AT_PLATFORM
                (lit _ 0 0)) ; AT_NULL

              ^{:line 51} words (+ 1 (len argv) 1 (len envp) 1 (* 2 (len aux)))
              ^{:line 52} sp (bit-and-not (- p (conv uint64 (* 8 words))) 15)
              ^{:line 53} w sp
              ^{:line 54} put8 ^{:go/end 61} (fn [^uint64 v]
                (let [^{:tag (array 8 byte)} b (zero (array 8 byte))]
                  (for [k 0] (< k 8) (inc! k)
                    (aset b k (conv byte (>> v (* 8 k)))))

                  (.WriteBytes a w (subslice b))
                  (set! w + 8)))]

            (put8 (conv uint64 (len argv)))
            (range [_ x argAddr]
              (put8 x))

            (put8 0)
            (range [_ x envAddr]
              (put8 x))

            (put8 0)
            (range [_ kv aux]
              (put8 (aget kv 0))
              (put8 (aget kv 1)))

            ^{:line 75} sp))))))

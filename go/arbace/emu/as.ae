^{:go/end 238} (go/method Fetch "Fetch copies up to len(buf) executable bytes at addr into buf: the count copied (it stops at the first byte that is not\nexecutable; FaultAddr is that byte's address).\n" ^int [^{:tag (* AS)} a ^uint64 addr ^{:tag (slice byte)} buf]

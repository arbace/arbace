;; Package emu is the frame of Arbace's machine emulators (doc/asm/AMD64.md §10; AX5-DESIGN §1, AXS52 (a)): a Linux
;; process's address space over crt's Mem (crt's slabs hold the bytes; emu keeps the permissions per page, Linux's layout and
;; a software TLB), its loader (a static ELF executable and the stack Linux builds for it) and the part of the kernel a
;; machine needs beyond crt's system calls (brk, mmap, munmap, mprotect). It imports std and arbace/crt only.
(in-ns 'go.arbace.emu) (go/file "as.go" :doc "Package emu is the frame of Arbace's machine emulators (doc/asm/AMD64.md §10; AX5-DESIGN §1, AXS52 (a)): a Linux\nprocess's address space over crt's Mem (crt's slabs hold the bytes; emu keeps the permissions per page, Linux's layout and\na software TLB), its loader (a static ELF executable and the stack Linux builds for it) and the part of the kernel a\nmachine needs beyond crt's system calls (brk, mmap, munmap, mprotect). It imports std and arbace/crt only.\n" :imports [


    ^{:line 8} [crt "arbace/crt"]])



(go/const "Page permissions.\n"
  ^{:line 13} [^{:val 1} PermR 1]
  ^{:line 14} [^{:val 2} PermW 2]
  ^{:line 15} [^{:val 4} PermX 4]

  ^{:line 17} [^{:val 8 :doc "PermCode marks a page x86i holds decoded instructions of: a store into it goes the slow way and invalidates them.\n"} PermCode 8])


(go/const ^{:val 4096} pageSize 4096)
(go/const ^{:val 4095} pageMask (- pageSize 1))

(go/type tlbEntry (struct
    ^{:line 24 :tag uint64} page ; the page's address + 1 (0: empty)
    ^{:line 25 :tag (slice byte)} b ; the page's bytes
    ^{:line 26 :tag uint8} perm))



(go/type AS "AS is a process's address space.\n" (struct
    ^{:line 31 :tag (* crt/Mem)} M
    ^{:line 32 :tag (map uint64 uint8)} perm ; by page address
    ^{:line 33 :tag (array 256 tlbEntry)} tlb
    ^{:line 34 :tag (func [^uint64 page])} OnCode ; a store into a PermCode page: the decoded instructions there are stale

    ^{:line 36 :tag uint64 :doc "the last fault: its address and whether it was a write or a fetch\n"} FaultAddr))



^{:go/end 42} (go/func NewAS "NewAS is an empty address space (crt's Mem without its stack: the loader maps Linux's).\n" ^{:tag (* AS)} []
  (addr (lit AS :M (new crt/Mem) :perm (lit (map uint64 uint8)))))


^{:go/end 48} (go/method flush [^{:tag (* AS)} a]
  (range [i (.-tlb a)]
    (aset (.-tlb a) i (lit tlbEntry))))




^{:go/breaks [[5 57]] :go/end 58} (go/method Mapped "Mapped reports whether any page of [base, base+size) is mapped.\n" ^bool [^{:tag (* AS)} a ^uint64 base ^uint64 size]
  (for [p (bit-and-not base pageMask)] (< p (+ base size)) (set! p + pageSize)
    (when [(values _ ok) (aget (.-perm a) p)] ok
      (return true)))


  false)



^{:go/end 67} (go/method Map "Map maps [base, base+size) (page-aligned) with zero bytes and the permissions perm.\n" [^{:tag (* AS)} a ^uint64 base ^uint64 size ^uint8 perm ^string name]
  (.Map (.-M a) base size (== (bit-and perm PermW) 0) name)
  (for [p base] (< p (+ base size)) (set! p + pageSize)
    (aset (.-perm a) p perm))

  (.flush a))



^{:go/end 81} (go/method Unmap "Unmap removes [base, base+size) (page-aligned).\n" [^{:tag (* AS)} a ^uint64 base ^uint64 size]
  (.Unmap (.-M a) base size)
  (for [p base] (< p (+ base size)) (set! p + pageSize)
    (when [(values pr ok) (aget (.-perm a) p)] ok
      (when (and (!= (bit-and pr PermCode) 0) (!= (.-OnCode a) nil))
        ((.-OnCode a) p))

      (delete (.-perm a) p)))


  (.flush a))



^{:go/breaks [7] :go/end 99} (go/method Protect "Protect sets the permissions of the mapped pages of [base, base+size); false when a page is not mapped.\n" ^bool [^{:tag (* AS)} a ^uint64 base ^uint64 size ^uint8 perm]
  (for [p base] (< p (+ base size)) (set! p + pageSize)
    (when [(values _ ok) (aget (.-perm a) p)] (not ok)
      (return false)))


  (for [p base] (< p (+ base size)) (set! p + pageSize)
    (let [old (aget (.-perm a) p)]
      (when (and (!= (bit-and old PermCode) 0) (!= (.-OnCode a) nil))
        ((.-OnCode a) p))

      (aset (.-perm a) p perm)))

  (.flush a)
  true)



^{:go/end 102} (go/method Perm "Perm is the page's permissions (0: unmapped).\n" ^uint8 [^{:tag (* AS)} a ^uint64 addr] (aget (.-perm a) (bit-and-not addr pageMask)))


^{:go/end 111} (go/method MarkCode "MarkCode marks the page as holding decoded instructions.\n" [^{:tag (* AS)} a ^uint64 addr]
  (let [p (bit-and-not addr pageMask)]
    (when [(values pr ok) (aget (.-perm a) p)] (and ok (== (bit-and pr PermCode) 0))
      (aset (.-perm a) p (bit-or pr PermCode))
      (aset (.-tlb a) (bit-and (>> p 12) 255) (lit tlbEntry)))))




^{:go/end 120} (go/method ClearCode "ClearCode unmarks the page.\n" [^{:tag (* AS)} a ^uint64 addr]
  (let [p (bit-and-not addr pageMask)]
    (when [(values pr ok) (aget (.-perm a) p)] ok
      (aset (.-perm a) p (bit-and-not pr PermCode))
      (aset (.-tlb a) (bit-and (>> p 12) 255) (lit tlbEntry)))))





  (let [p (bit-and-not addr pageMask)
      ^{:line 125} e (addr (aget (.-tlb a) (bit-and (>> p 12) 255)))]
    (when (== (.-page e) (+ p 1))
      (return e))

    (let [(values pr ok) (aget (.-perm a) p)]
      (when (not ok)
        (return nil))

      (let [s (.Slab (.-M a) p)]
        (when (== s nil)
          (return nil))

        (let [o (- p (.-Base s))]
          (set! @e (lit tlbEntry :page (+ p 1) :b (subslice (.-B s) o (+ o pageSize) (+ o pageSize)) :perm pr))
          ^{:line 139} e)))))




^{:go/end 150} (go/method Bytes "Bytes is the page's bytes from addr to the page's end, nil when unmapped (no permission checked: the loader's and the\nkernel's own access).\n" ^{:tag (slice byte)} [^{:tag (* AS)} a ^uint64 addr]
  (let [e (.entry a addr)]
    (when (== e nil)
      (return nil))

    (subslice (.-b e) (bit-and addr pageMask))))



^{:go/end 183} (go/method Read "Read reads size (1, 2, 4, 8) bytes little-endian at addr; false (FaultAddr set) when a byte is not readable.\n" [^{:tag (* AS)} a ^uint64 addr ^int size] :results [uint64 bool]
  (let [o (bit-and addr pageMask)]
    (when (<= (+ o (conv uint64 size)) pageSize)
      (let [e (.entry a addr)]
        (when (or (== e nil) (== (bit-and (.-perm e) PermR) 0))
          (set! (.-FaultAddr a) addr)
          (return 0 false))

        (let [b (subslice (.-b e) o)]
          (switch size
            (case [1]
              (return (conv uint64 (aget b 0)) true))
            (case [2]
              (return (bit-or (conv uint64 (aget b 0)) (<< (conv uint64 (aget b 1)) 8)) true))
            (case [4]
              (return (bit-or (conv uint64 (aget b 0)) (<< (conv uint64 (aget b 1)) 8) (<< (conv uint64 (aget b 2)) 16) (<< (conv uint64 (aget b 3)) 24)) true))
            (default
              (return (bit-or (conv uint64 (aget b 0)) (<< (conv uint64 (aget b 1)) 8) (<< (conv uint64 (aget b 2)) 16) (<< (conv uint64 (aget b 3)) 24)
                  (<< (conv uint64 (aget b 4)) 32) (<< (conv uint64 (aget b 5)) 40) (<< (conv uint64 (aget b 6)) 48) (<< (conv uint64 (aget b 7)) 56)) true))))))


    (let [^uint64 v (zero uint64)]
      (for [k (- size 1)] (>= k 0) (dec! k)
        (let [(values x ok) (.Read a (+ addr (conv uint64 k)) 1)]
          (when (not ok)
            (return 0 false))

          (set! v (bit-or (<< v 8) x))))

      (return v true))))



^{:go/breaks [[5 194]] :go/end 195} (go/method Probe "Probe reports whether size bytes at addr are writable (FaultAddr set when not).\n" ^bool [^{:tag (* AS)} a ^uint64 addr ^int size]

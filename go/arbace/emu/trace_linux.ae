^{:go/end 235} (go/method FPRegs "FPRegs reads the tracee's FXSAVE image (PTRACE_GETFPREGS: 512 bytes; MXCSR at 24, XMM0-15 at 160).\n" [^{:tag (* Tracee)} t] :results [(array 512 byte) error]

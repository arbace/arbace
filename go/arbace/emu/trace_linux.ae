(go/type Mapping "Mapping is one line of /proc/PID/maps.\n" (struct
    ^{:line 239 :tag uint64} Lo ^uint64 Hi
    ^{:line 240 :tag string} Perm ; rwxp
    ^{:line 241 :tag string} Name))



^{:go/end 268} (go/method Mappings "Mappings are the tracee's mappings.\n" [^{:tag (* Tracee)} t] :results [(slice Mapping) error]
  (let [(values f err) (os/Open (+ "/proc/" (strconv/Itoa (.-Pid t)) "/maps"))]
    (when (!= err nil)
      (return nil err))

    (defer (.Close f))
    (let [^{:tag (slice Mapping)} out (zero (slice Mapping))
        ^{:line 252} sc (bufio/NewScanner f)]
      (while (.Scan sc)
        (let [fs (strings/Fields (.Text sc))]
          (when (< (len fs) 5)
            (continue))

          (let [(values lo hi _) (strings/Cut (aget fs 0) "-")
              ^{:line 259} m (lit Mapping :Perm (aget fs 1))]
            (set! (values (.-Lo m) _) (strconv/ParseUint lo 16 64))
            (set! (values (.-Hi m) _) (strconv/ParseUint hi 16 64))
            (when (>= (len fs) 6)

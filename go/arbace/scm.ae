;; si's runtime, the package arbace/scm (doc/scheme/SCHEME-SURVEY.md, "As built: SM5"): hand-written Go forms,
;; std only. Scheme's values and numeric tower (value, number, numtext), records and conditions (cond), the
;; evaluator of core forms on an explicit continuation (eval), the primitives (prim and prim_*), the printer
;; (write), the reader (read), ports (port), and the host's side of psyntax (system).
(ns go.arbace.scm
  (:require [arbace.go :as go]))

(go/package scm
  :path "arbace/scm"
  :files ["cond.go" "eval.go" "number.go" "numtext.go" "port.go" "prim.go" "prim_char.go" "prim_control.go" "prim_hash.go" "prim_io.go" "prim_list.go" "prim_number.go" "prim_record.go" "prim_vector.go" "read.go" "system.go" "unicode.go" "value.go" "write.go"]
  :test-files ["data_test.go" "numbers_cases8_test.go" "numbers_cases9_test.go" "numbers_cases_test.go" "numbers_test.go" "printer_data_test.go" "ports_test.go" "printer_test.go" "reader_test.go" "scm_test.go"])

(load "scm/cond")
(load "scm/eval")
(load "scm/number")
(load "scm/numtext")
(load "scm/port")
(load "scm/prim")
(load "scm/prim_char")
(load "scm/prim_control")
(load "scm/prim_hash")
(load "scm/prim_io")
(load "scm/prim_list")
(load "scm/prim_number")
(load "scm/prim_record")
(load "scm/prim_vector")
(load "scm/read")
(load "scm/system")
(load "scm/unicode")
(load "scm/value")
(load "scm/write")
(load "scm/data_test")
(load "scm/numbers_cases8_test")
(load "scm/numbers_cases9_test")
(load "scm/numbers_cases_test")
(load "scm/numbers_test")
(load "scm/printer_data")
(load "scm/ports_test")
(load "scm/printer_test")
(load "scm/reader_test")
(load "scm/scm_test")

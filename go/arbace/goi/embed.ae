;; goi: go:embed's file systems (GOI-SPEC.md "As built: GS14", GS14 (a)): an embed.FS made at
;; run time with the layout gc's compiler gives the static data of a //go:embed variable of type
;; embed.FS (cmd/compile/internal/staticdata/embed.go, WriteEmbed: a pointer to a []file, each
;; file its name, its data and its truncated SHA-256; embed/embed.go's FS and file).
(in-ns 'go.arbace.goi)

(go/file "embed.go"
  :imports [[sha256 "crypto/sha256"] [embed "embed"] [unsafe "unsafe"]])

(go/type embedFile "embedFile is embed's file: its name (a directory's with a final slash), data and hash.\n"
  (struct ^string name ^string data ^{:tag (array 16 byte)} hash))

(go/type embedFS "embedFS is embed.FS's layout: its files, sorted.\n"
  (struct ^{:tag (* (slice embedFile))} files))

(go/func EmbedFS
  "EmbedFS is an embed.FS of the files names, sorted as gc sorts them (embedFileLess: by
directory, then by name; a directory's name with a final slash), the contents of each in data
one after the other, lens long (a directory's 0).\n"
  ^any [^{:tag (slice string)} names ^string data ^{:tag (slice int)} lens]
  (let [fs (make (slice embedFile) (len names))
        off 0]
    (range [i n names]
      (let [d (subslice data off (+ off (aget lens i)))]
        (set! off (+ off (aget lens i)))
        (set! (.-name (aget fs i)) n)
        (when (or (== (len n) 0) (!= (aget n (- (len n) 1)) \/))
          (let [sum (sha256/Sum256 (conv (slice byte) d))]
            (set! (.-data (aget fs i)) d)
            (copy (subslice (.-hash (aget fs i))) (subslice sum _ 16))))))
    (let [v (lit embedFS :files (addr fs))]
      @(conv (* embed/FS) (conv unsafe/Pointer (addr v))))))

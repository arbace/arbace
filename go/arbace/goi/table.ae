;; goi: the registry of the table of compiled packages (GOI-SPEC.md §6.1, §6.2): the generated
;; package arbace/gotable registers each listed package and the digest of its configuration at
;; init.
(in-ns 'go.arbace.goi)

(go/file "table.go"
  :imports [[bytes "bytes"] [zlib "compress/zlib"] [io "io"] [reflect "reflect"] [sort "sort"] [strings "strings"] [sync "sync"]])

(go/type Invoker
  "Invoker is a signature's typed invoker (§6.4): given the function value f, the argument
nodes a (I, F, S or R by the parameters' kinds; a method's receiver an R) and the result slots
r of a call of several results, it returns the call node: I, F, S or R for one result, T for
none or several. The func is asserted to its type once, when the node is made.\n"
  (func [any (slice any) (slice int32)] [any]))

(go/type Member
  "Member is a function, method expression or variable of a listed package: its name (T.M for a
method), its value (the func, the method expression, or the variable's address) and its
invoker (nil: reflect.Value.Call).\n"
  (struct ^string Name ^any Value ^Invoker Inv))

(go/type TypeMember "TypeMember is a named type of a listed package.\n"
  (struct ^string Name ^{:tag reflect/Type} Type))

(go/type Package
  "Package is a listed package's table: its exported functions, variables, types, and its
types' and interfaces' methods as method expressions.\n"
  (struct ^string Path ^string Name
          ^{:tag (slice Member)} Funcs ^{:tag (slice Member)} Vars
          ^{:tag (slice TypeMember)} Types ^{:tag (slice Member)} Methods))

(go/var ^{:tag (map string (* Package))} packages (make (map string (* Package))))

(go/func Register
  "Register adds the tables of listed packages; arbace/gotable calls it at init.\n"
  [& ^{:tag (slice (* Package))} ps]
  (range [_ p ps]
    (aset packages (.-Path p) p)))

(go/func Lookup "Lookup is the table of the package of import path p, or nil.\n"
  ^{:tag (* Package)} [^string p]
  (aget packages p))

(go/func Paths "Paths are the listed packages' import paths, sorted.\n"
  ^{:tag (slice string)} []
  (let [ps (make (slice string) 0 (len packages))]
    (range [p packages]
      (set! ps (append ps p)))
    (sort/Strings ps)
    ps))

(go/func dirOf
  "dirOf is the forms directory of import path p (SPEC.md §4.1): go/ and the path, . and - in an
element as _.\n"
  ^string [^string p]
  (let [els (strings/Split p "/")]
    (range [i e els]
      (aset els i (strings/ReplaceAll (strings/ReplaceAll e "." "_") "-" "_")))
    (+ "go/" (strings/Join els "/"))))

(go/func PathOfResource
  "PathOfResource is the listed package whose namespace's resource base is base (go/strings
for strings), or \"\".\n"
  ^string [^string base]
  (range [p packages]
    (when (== (dirOf p) base)
      (return p)))
  "")

(go/var ^string digestZ)

(go/var ^{:tag sync/Once} digestOnce)

(go/var ^{:tag (slice byte)} digestText)

(go/func SetDigest
  "SetDigest records the digest of the configuration (§6.5), zlib-compressed; arbace/gotable
calls it at init.\n"
  [^string z]
  (set! digestZ z))

(go/func Digest
  "Digest is the digest's text, inflated on first use, or nil when there is none.\n"
  ^{:tag (slice byte)} []
  (.Do digestOnce
       (fn []
         (when (== digestZ "")
           (return))
         (let [(values r err) (zlib/NewReader (bytes/NewReader (conv (slice byte) digestZ)))]
           (when (!= err nil)
             (return))
           (let [(values b err2) (io/ReadAll r)]
             (when (== err2 nil)
               (set! digestText b))))))
  digestText)

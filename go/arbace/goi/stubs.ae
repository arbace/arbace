;; goi: the code behind the methods of interpreted types' runtime types (GOI-SPEC.md, "As built:
;; GR9a-c"; GC66 (a), GC67 (a)): typed Go stubs per method signature and slot, generated by the
;; table (arbace.go.table: stubs_sN.go, the families of go/arbace/gotable.edn's :stubs). A stub is
;; a Go function of the method's signature with the receiver word first; it enters the
;; interpreted method its slot names (the type's descriptor and the method's key: its current
;; entry, so a body redefined at the REPL is reached through the same code). A method whose
;; signature has no family, or whose family has no slot left, gets the panic stub.
(in-ns 'go.arbace.goi)

(go/file "stubs.go"
  :imports [[fmt "fmt"] [os "os"] [reflect "reflect"] [sync "sync"] [unsafe "unsafe"]])

(go/type StubSlot
  "StubSlot is what a stub calls: the method key of type T's method set (T the receiver's type:
the word the stub is given is a value of T when T is pointer-shaped, else a pointer to one);
NilMsg, when set, is gc's panicwrap message for a nil pointer (a value method's slot shared by
T's and *T's method tables).\n"
  (struct ^{:tag (* Type)} T ^string Key ^string NilMsg))

(go/type stubFamily "stubFamily is a signature's stubs: their slots and code, the next one free, the method names compiled code calls with that signature.\n"
  (struct ^{:tag (slice StubSlot)} slots ^{:tag (slice unsafe/Pointer)} codes ^int next ^string sig
          ^{:tag (map string bool)} names))

(go/var ^{:tag sync/Mutex} stubsMu)

(go/var ^{:tag (map reflect/Type (* stubFamily)) :doc "stubFamilies are the table's stub families by method type (FuncOf's, without the receiver).\n"}
  stubFamilies (make (map reflect/Type (* stubFamily))))

(go/func RegisterStubs
  "RegisterStubs records the table's stubs of method type sig: the method names compiled code
calls with it (a listed interface's methods', the list's common ones), their slots and the stubs
(Go funcs; their code is a method's Ifn).\n"
  [^{:tag reflect/Type} sig ^{:tag (slice string)} names ^{:tag (slice StubSlot)} slots ^{:tag (slice any)} fns]
  (let [codes (make (slice unsafe/Pointer) (len fns))
        nm (make (map string bool) (len names))]
    (range [_ n names]
      (aset nm n true))
    (range [i f fns]
      (aset codes i (conv unsafe/Pointer (.Pointer (reflect/ValueOf f)))))
    (.Lock stubsMu)
    (aset stubFamilies sig (addr (lit stubFamily :slots slots :codes codes :sig (.String sig) :names nm)))
    (.Unlock stubsMu)))

(go/type stubError "stubError is the panic of a method called by compiled code that has no stub (a runtime.Error).\n"
  (struct ^string msg))

(go/method Error ^string [^stubError e] (.-msg e))
(go/method RuntimeError [^stubError e])

(go/func panicStub
  "panicStub is the code of a method without a stub: it takes no argument (whatever its caller
passed is ignored) and panics.\n"
  []
  (panic (lit stubError "goi: compiled code called a method of an interpreted type whose signature has no stub left (go/arbace/gotable.edn, :stubs)")))

(go/var panicStubCode (conv unsafe/Pointer (.Pointer (reflect/ValueOf panicStub))))

(go/var ^{:tag (map string bool) :doc "stubWarned are the families whose exhaustion was reported, guarded by stubsMu.\n"}
  stubWarned (make (map string bool)))

(go/func takeStub
  "takeStub is the code of a new slot of method type sig's family, its slot reaching method
key of type t (nilMsg: a shared slot's panicwrap message), or the panic stub when the signature
has no family, the family no method of that name (no compiled code can call it: it takes no
slot) or no slot left (GC67: then goi warns once at the REPL, naming the
method; a program's run, whose output is the program's, does not).\n"
  ^unsafe/Pointer [^{:tag reflect/Type} sig ^{:tag (* Type)} t ^string key ^string nilMsg]
  (.Lock stubsMu)
  (defer (.Unlock stubsMu))
  (let [f (aget stubFamilies sig)]
    (when (or (== f nil) (not (aget (.-names f) (methodName key))))
      ;; no compiled code calls a method of that name and signature (an unexported one included)
      (return panicStubCode))
    (when (>= (.-next f) (len (.-slots f)))
      (when (and (not ProgramMode) (not (aget stubWarned (.-sig f))))
        (aset stubWarned (.-sig f) true)
        (fmt/Fprintf os/Stderr "goi: warning: no stub left for methods of type %s (go/arbace/gotable.edn :stubs): compiled code calling %s.%s panics\n"
                     (.-sig f) (typeName t) (methodName key)))
      (return panicStubCode))
    (let [i (.-next f)]
      (set! (.-next f) (+ i 1))
      (aset (.-slots f) i (lit StubSlot t key nilMsg))
      (aget (.-codes f) i))))

(go/func methodPkg
  "methodPkg is a method key's package path as gc's runtime has it (main for a command's), \"\"
for an exported method.\n"
  ^string [^string key]
  (let [n (lastName key)]
    (when (== (len n) (len key))
      (return ""))
    (let [p (subslice key _ (- (len key) (len n) 1))]
      (when (== p "command-line-arguments")
        (return "main"))
      p)))

(go/func setStubs
  "setStubs gives t's RT its method table, once (GC68: cached itabs, failed ones too, fix what
an interface sees), when t's RT is its own (an interpreted named type's, or the pointer type
made with it): each method of t's set its signature's FuncOf type and a stub. A value method of
a type that is not pointer-shaped has one slot for its type's table and the pointer type's (both
receive a pointer to the value); the pointer type's entry then shares it, with gc's panicwrap
message for a nil pointer.\n"
  [^{:tag (* Type)} t ^{:tag (slice string)} keys]
  (.Lock internMu)
  (when (or (.-stubbed t) (not (.-roomed t)))
    (.Unlock internMu)
    (return))
  (set! (.-stubbed t) true)
  (let [ms (.-Methods t)]
    (.Unlock internMu)
    (let [out (make (slice reflect/ArbaceMethod) 0 (len keys))
          elem (.-Elem t)
          shared (and (== (.-GK t) reflect/Pointer) (!= elem nil) (.-own elem) (!= (.-Name elem) "") (not (.-direct elem)))]
      (set! (.-stubs t) (make (map string unsafe/Pointer) (len keys)))
      (range [_ k keys]
        (let [m (aget ms k)
              sig (.rt (.-Sig m))
              code panicStubCode]
          (if (and shared (!= (.-stubs elem) nil) (!= (aget (.-stubs elem) k) nil))
            (set! code (aget (.-stubs elem) k))
            (set! code (takeStub sig t k "")))
          (aset (.-stubs t) k code)
          (let [am (lit reflect/ArbaceMethod :Name (methodName k) :PkgPath (methodPkg k) :Type sig :Ifn code)]
            (when (.-direct t)
              (set! (.-Tfn am) code))
            (set! out (append out am)))))
      (when (> (len out) (.-room t))
        (panic (fmt/Sprintf "goi: the method set of %s has %d methods, its runtime type room for %d" (typeName t) (len out) (.-room t))))
      (reflect/ArbaceSetMethods (.-RT t) out))))

(go/func EnterSlot
  "EnterSlot is a stub's call of the method its slot s names, receiver word p (§2.3 of the GR9
survey): its frame, the receiver in its slot, the arguments' slots the signature's (as a typed
adapter's, GC22).\n"
  ^{:tag (* Frame)} [^{:tag (* StubSlot)} s ^unsafe/Pointer p]
  (let [t (.-T s)
        m (aget (.-Methods t) (.-Key s))]
    (when (== m nil)
      (panic (fmt/Sprintf "goi: the type %s has no method %s" (typeName t) (.-Key s))))
    (when (and (== p nil) (not (.-direct t)))
      ;; a value method called through a nil pointer by the pointer type's table
      (panic (lit plainError (fmt/Sprintf "value method %s.%s called using nil *%s pointer" (.-Name t) (methodName (.-Key s)) (lastName (.-Name t))))))
    (let [th (CurrentThread)
          mk (.save th)
          code (.Code (.-Fn m))
          nf (.enter th code (.-Fn m))]
      (if (.-direct t)
        (setRecvAt nf m t (conv unsafe/Pointer (addr p)))
        (setRecvAt nf m t p))
      (set! (.-saved nf) mk)
      (set! (.-sig nf) (.-Sig m))
      (set! (.-ifn nf) nil)
      nf)))

(go/func setRecvAt
  "setRecvAt writes the receiver of method m, the value of type t at a, to its slot of frame nf.\n"
  [^{:tag (* Frame)} nf ^{:tag (* Method)} m ^{:tag (* Type)} t ^unsafe/Pointer a]
  (switch (.-RK m)
    (case [\I] (aset (.-I nf) (.-RS m) (loadI (.-GK t) a)))
    (case [\F] (aset (.-F nf) (.-RS m) (loadF (.-GK t) a)))
    (case [\S] (aset (.-S nf) (.-RS m) @(conv (* string) a)))
    (default (aset (.-R nf) (.-RS m) (.load t a)))))

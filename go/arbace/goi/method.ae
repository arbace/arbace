;; goi: methods and interfaces at run time (GOI-SPEC.md §4.6, §5.3; GR4, GR9a-c): the method sets
;; of interpreted types (each entry the method's function, or a thunk the builder makes for a method
;; reached through embedded fields or a pointer) and, for a type whose RT is its own, its runtime
;; method table (each method's code a typed stub of the table, its slot reaching the entry: stubs.ae),
;; the dynamic dispatch of interface method calls (an inline cache per call site keyed by the
;; content's reflect type: an interpreted type's entry, else the compiled method from the table),
;; method values, type assertions and type switches with gc's messages.
(in-ns 'go.arbace.goi)

(go/file "method.go"
  :imports [[fmt "fmt"] [reflect "reflect"] [strings "strings"] [sync "sync"] [atomic "sync/atomic"] [unsafe "unsafe"]])

;; ---------------------------------------------------------------------------------------
;; Method sets

(go/type Method
  "Method is an entry of an interpreted type's method set (§5.3): Fn the function called (the
method itself, or the builder's thunk reaching it through embedded fields or a pointer), its
receiver parameter's slot (kind RK, slot RS, of type RT; laid after the parameters and results,
so that the arguments' slots are the signature's), its key and signature Sig.\n"
  (struct ^string Name ^{:tag (* Func)} Fn ^byte RK ^int32 RS ^{:tag (* Type)} RT ^{:tag (* Type)} Sig))

(go/type IMethod "IMethod is an interface type's method: its key (a name, path.name when unexported) and signature.\n"
  (struct ^string Key ^{:tag (* Type)} Sig))

(go/func TSetMethods
  "TSetMethods gives type t its method set: keys, functions, receiver slots (kinds rks, slots
rss, types rts) and signatures. A type whose RT is its own gets the RT's method table once
(setStubs: compiled code calls the methods through the table's stubs), and every type with
methods enters the registry by its RT (an unnamed struct type with embedded fields too), so that
dispatch finds the entries from a value's reflect type (§5.3).\n"
  [^{:tag (* Type)} t ^{:tag (slice string)} keys ^{:tag (slice (* Func))} fns ^{:tag (slice int32)} rks
   ^{:tag (slice int32)} rss ^{:tag (slice (* Type))} rts ^{:tag (slice (* Type))} sigs]
  (let [ms (make (map string (* Method)) (len keys))]
    (range [i k keys]
      (aset ms k (addr (lit Method :Name k :Fn (aget fns i) :RK (conv byte (aget rks i)) :RS (aget rss i)
                            :RT (aget rts i) :Sig (aget sigs i)))))
    (.Lock internMu)
    (set! (.-Methods t) ms)
    (set! (.-methodsSet t) true)
    (.Unlock internMu)
    (when (and (> (len keys) 0) (not (.-Compiled t)) (not (.-Iface t)))
      (register t))
    (setStubs t keys)))

(go/func TMethodsSet "TMethodsSet says whether t's method set was given (TSetMethods).\n" ^bool [^{:tag (* Type)} t]
  (.Lock internMu)
  (defer (.Unlock internMu))
  (.-methodsSet t))

(go/func TSetIfaceMethods "TSetIfaceMethods gives interface type t its methods (keys and signatures).\n"
  [^{:tag (* Type)} t ^{:tag (slice string)} keys ^{:tag (slice (* Type))} sigs]
  (let [ms (make (slice IMethod) (len keys))]
    (range [i k keys]
      (aset ms i (lit IMethod k (aget sigs i))))
    (.Lock internMu)
    (set! (.-IMethods t) ms)
    (.Unlock internMu)))

;; ---------------------------------------------------------------------------------------
;; Receivers

(go/func goIntOf "goIntOf is Go value v of an integer kind or bool as an I value.\n" ^int64 [^any v]
  (type-switch [x v]
    (case [int] (return (conv int64 x)))
    (case [int64] (return x))
    (case [int32] (return (conv int64 x)))
    (case [uint8] (return (conv int64 x)))
    (case [bool] (return (B2I x)))
    (case [uint] (return (conv int64 x)))
    (case [uint64] (return (conv int64 x))))
  (intOfValue (reflect/ValueOf v)))

(go/func floatOf "floatOf is Go value v of a float kind as an F value.\n" ^float64 [^any v]
  (type-switch [x v]
    (case [float64] (return x))
    (case [float32] (return (conv float64 x))))
  (.Float (reflect/ValueOf v)))

(go/func stringOf "stringOf is Go value v of a string kind as an S value.\n" ^string [^any v]
  (let [(values s ok) (assert string v)]
    (when ok
      (return s)))
  (.String (reflect/ValueOf v)))

(go/func setRecv
  "setRecv writes receiver v, a Go value of type t (an interface's content's value), to slot s
of kind k of frame nf.\n"
  [^{:tag (* Frame)} nf ^byte k ^int32 s ^{:tag (* Type)} t ^any v]
  (switch k
    (case [\I] (aset (.-I nf) s (goIntOf v)))
    (case [\F] (aset (.-F nf) s (floatOf v)))
    (case [\S] (aset (.-S nf) s (stringOf v)))
    (default (aset (.-R nf) s (fromMem t v)))))

(go/func setFrameSlot "setFrameSlot writes frame value v (int64, float64, string or an R value) to slot s of kind k.\n"
  [^{:tag (* Frame)} nf ^byte k ^int32 s ^any v]
  (switch k
    (case [\I] (aset (.-I nf) s (assert int64 v)))
    (case [\F] (aset (.-F nf) s (assert float64 v)))
    (case [\S] (aset (.-S nf) s (assert string v)))
    (default (aset (.-R nf) s v))))

;; ---------------------------------------------------------------------------------------
;; Dynamic dispatch (§5.3): interpreted types' methods, cached per call site by reflect type

(go/type icache "icache is a call site's last dispatch: the content's reflect type and its interpreted method (nil: compiled).\n"
  (struct ^{:tag reflect/Type} rt ^{:tag (* Method)} m))

(go/func ifaceMethod
  "ifaceMethod is the interpreted method key of content v's dynamic type, cached in c, or nil
when that type is compiled (the compiled method's call then) or v nil.\n"
  ^{:tag (* Method)} [^any v ^string key ^{:tag (* (atomic/Pointer icache))} c]
  (when (== v nil)
    (return nil))
  (let [rt (reflect/TypeOf v)
        e (.Load c)]
    (when (and (!= e nil) (== (.-rt e) rt))
      (return (.-m e)))
    (let [d (descOfRT rt)
          ^{:tag (* Method)} m nil]
      (when (not (.-Compiled d))
        (set! m (aget (.-Methods d) key))
        (when (== m nil)
          (panic (fmt/Sprintf "goi: the type %s has no method %s" (typeName d) key))))
      (.Store c (addr (lit icache rt m)))
      m)))

(go/func enterMethod
  "enterMethod takes the frame of a call of method m from frame fr (the thread's stacks saved by
the caller), writes the arguments (args) and the receiver v (a Go value of m's receiver type)
and runs it: the callee's frame, to read its results from.\n"
  ^{:tag (* Frame)} [^{:tag (* Frame)} fr ^{:tag (* Method)} m ^any v ^{:tag (slice Setter)} args]
  (let [th (.-Th fr)
        c (.Code (.-Fn m))
        nf (.enter th c (.-Fn m))]
    (set! (.-rec nf) (.-passRec fr))
    (range [_ a args] (a fr nf))
    (setRecv nf (.-RK m) (.-RS m) (.-RT m) v)
    (run c nf)
    nf))

(go/func NonNilR "NonNilR is interface content x, gc's nil dereference when it is nil (a deferred interface method call's receiver).\n" ^R [^R x]
  (fn ^any [^{:tag (* Frame)} fr]
    (let [v (x fr)]
      (when (== v nil)
        (nilDeref))
      v)))

(go/func DerefWrapP
  "DerefWrapP is the variable pointer x points to, for a value method called through it by an
interface: a nil x panics with gc's panicwrap message msg.\n"
  ^P [^R x ^string msg]
  (fn ^unsafe/Pointer [^{:tag (* Frame)} fr]
    (let [p (efaceData (x fr))]
      (when (== p nil)
        (panic (lit plainError msg)))
      p)))

(go/func CallIfaceI
  "CallIfaceI is a call of interface method key on content x (§5.3) of one I result in the
callee's slot res: an interpreted type's method, else fb (the compiled method's call, reading x).\n"
  ^I [^R x ^string key ^{:tag (slice Setter)} args ^int32 res ^any fb]
  (let [c (new (inst atomic/Pointer icache))
        f (assert I fb)]
    (fn ^int64 [^{:tag (* Frame)} fr]
      (let [v (x fr)
            m (ifaceMethod v key c)]
        (when (== m nil)
          (return (f fr)))
        (let [th (.-Th fr)
              mk (.save th)
              nf (enterMethod fr m v args)
              r (aget (.-I nf) res)]
          (.restore th mk)
          r)))))

(go/func CallIfaceF
  ^F [^R x ^string key ^{:tag (slice Setter)} args ^int32 res ^any fb]
  (let [c (new (inst atomic/Pointer icache))
        f (assert F fb)]
    (fn ^float64 [^{:tag (* Frame)} fr]
      (let [v (x fr)
            m (ifaceMethod v key c)]
        (when (== m nil)
          (return (f fr)))
        (let [th (.-Th fr)
              mk (.save th)
              nf (enterMethod fr m v args)
              r (aget (.-F nf) res)]
          (.restore th mk)
          r)))))

(go/func CallIfaceS
  ^S [^R x ^string key ^{:tag (slice Setter)} args ^int32 res ^any fb]
  (let [c (new (inst atomic/Pointer icache))
        f (assert S fb)]
    (fn ^string [^{:tag (* Frame)} fr]
      (let [v (x fr)
            m (ifaceMethod v key c)]
        (when (== m nil)
          (return (f fr)))
        (let [th (.-Th fr)
              mk (.save th)
              nf (enterMethod fr m v args)
              r (aget (.-S nf) res)]
          (.restore th mk)
          r)))))

(go/func CallIfaceR
  ^R [^R x ^string key ^{:tag (slice Setter)} args ^int32 res ^any fb]
  (let [c (new (inst atomic/Pointer icache))
        f (assert R fb)]
    (fn ^any [^{:tag (* Frame)} fr]
      (let [v (x fr)
            m (ifaceMethod v key c)]
        (when (== m nil)
          (return (f fr)))
        (let [th (.-Th fr)
              mk (.save th)
              nf (enterMethod fr m v args)
              r (aget (.-R nf) res)]
          (.restore th mk)
          r)))))

(go/func CallIfaceT "CallIfaceT is a call of interface method key of no result, or of several copied by rs.\n"
  ^T [^R x ^string key ^{:tag (slice Setter)} args ^{:tag (slice resCopy)} rs ^any fb]
  (let [c (new (inst atomic/Pointer icache))
        f (assert T fb)]
    (fn [^{:tag (* Frame)} fr]
      (let [v (x fr)
            m (ifaceMethod v key c)]
        (when (== m nil)
          (f fr)
          (return))
        (let [th (.-Th fr)
              mk (.save th)
              nf (enterMethod fr m v args)]
          (copyResults fr nf rs)
          (.restore th mk))))))

;; Compiled dynamic types (§5.3): the table's method of the type, by its reflect type

(go/var ^{:tag sync/Once} typeIndexOnce)

(go/type typeRef "typeRef is a listed package's named type: its package's path and name.\n"
  (struct ^string path ^string name))

(go/var ^{:tag (map reflect/Type typeRef)} typeIndex)

(go/func tableTypeOf
  "tableTypeOf is the listed named type of reflect type rt (or of its element, for a pointer):
its package's path and name.\n"
  [^{:tag reflect/Type} rt] :results [^string path ^string name ^bool ok]
  (.Do typeIndexOnce
       (fn []
         (set! typeIndex (make (map reflect/Type typeRef)))
         (range [p pk packages]
           (range [_ t (.-Types pk)]
             (aset typeIndex (.-Type t) (lit typeRef p (.-Name t)))))))
  (let [(values r found) (aget typeIndex rt)]
    (when (and (not found) (== (.Kind rt) reflect/Pointer))
      (set! (values r found) (aget typeIndex (.Elem rt))))
    (return (.-path r) (.-name r) found)))

(go/func DerefR "DerefR is the value pointer x points to (a value method's receiver reached through a pointer).\n" ^R [^R x]
  (fn ^any [^{:tag (* Frame)} fr]
    (let [v (reflect/ValueOf (x fr))]
      (when (.IsNil v)
        (nilDeref))
      (.Interface (.Elem v)))))

(go/var errorType ((inst reflect/TypeFor error)))
(go/var stringerType ((inst reflect/TypeFor fmt/Stringer)))

(go/func compiledMethodCall
  "compiledMethodCall is the call node of method name of compiled type rt, its receiver node x
and argument nodes args (compiled calls' kinds), results to rs: the table's method expression,
else error's Error and fmt.Stringer's String.\n"
  ^any [^{:tag reflect/Type} rt ^string name ^R x ^{:tag (slice any)} args ^{:tag (slice int32)} rs]
  (let [(values path tname ok) (tableTypeOf rt)]
    (when ok
      (let [(values m ok2) (member path (+ tname "." name))]
        (when ok2
          (let [recv (conv any x)]
            (when (and (== (.Kind rt) reflect/Pointer) (!= (.In (reflect/TypeOf (.-Value m)) 0) rt))
              (set! recv (DerefR x)))
            (return (CallCompiled path (+ tname "." name) (append (lit (slice any) recv) (spread args)) rs)))))))
  (when (and (== name "Error") (.Implements rt errorType))
    (return (conv S (fn ^string [^{:tag (* Frame)} fr] (.Error (assert error (x fr)))))))
  (when (and (== name "String") (.Implements rt stringerType))
    (return (conv S (fn ^string [^{:tag (* Frame)} fr] (.String (assert fmt/Stringer (x fr)))))))
  (panic (fmt/Sprintf "goi cannot call %s on %s: the type is not in the table" name (.String rt))))

(go/type cdispatch "cdispatch is a call site's compiled method calls by dynamic type.\n"
  (struct ^R x ^string name ^{:tag (slice any)} args ^{:tag (slice int32)} rs ^{:tag sync/Map} nodes))

(go/method node "node is the call node for content v's dynamic type (made on first use).\n"
  ^any [^{:tag (* cdispatch)} d ^any v]
  (when (== v nil)
    (nilDeref))
  (let [rt (reflect/TypeOf v)
        (values n ok) (.Load (.-nodes d) rt)]
    (when ok
      (return n))
    (let [made (compiledMethodCall rt (.-name d) (.-x d) (.-args d) (.-rs d))]
      (.Store (.-nodes d) rt made)
      made)))

(go/func CompiledDispatchI
  "CompiledDispatchI is the call of method name on the compiled value of content x (an
interpreted interface's: the table's method of its dynamic type), of one I result.\n"
  ^I [^R x ^string name ^{:tag (slice any)} args]
  (let [d (addr (lit cdispatch :x x :name name :args args))]
    (fn ^int64 [^{:tag (* Frame)} fr] ((assert I (.node d (x fr))) fr))))

(go/func CompiledDispatchF ^F [^R x ^string name ^{:tag (slice any)} args]
  (let [d (addr (lit cdispatch :x x :name name :args args))]
    (fn ^float64 [^{:tag (* Frame)} fr] ((assert F (.node d (x fr))) fr))))

(go/func CompiledDispatchS ^S [^R x ^string name ^{:tag (slice any)} args]
  (let [d (addr (lit cdispatch :x x :name name :args args))]
    (fn ^string [^{:tag (* Frame)} fr] ((assert S (.node d (x fr))) fr))))

(go/func CompiledDispatchR ^R [^R x ^string name ^{:tag (slice any)} args]
  (let [d (addr (lit cdispatch :x x :name name :args args))]
    (fn ^any [^{:tag (* Frame)} fr] ((assert R (.node d (x fr))) fr))))

(go/func CompiledDispatchT ^T [^R x ^string name ^{:tag (slice any)} args ^{:tag (slice int32)} rs]
  (let [d (addr (lit cdispatch :x x :name name :args args :rs rs))]
    (fn [^{:tag (* Frame)} fr] ((assert T (.node d (x fr))) fr))))

(go/func ErrorCall "ErrorCall is x.Error() of a compiled value of type error.\n" ^S [^R x]
  (fn ^string [^{:tag (* Frame)} fr]
    (let [v (x fr)]
      (when (== v nil)
        (nilDeref))
      (.Error (assert error v)))))

;; ---------------------------------------------------------------------------------------
;; Method values (§4.6): a method bound to its receiver

(go/type Bound
  "Bound is a method value: method M with its receiver Recv (a frame value of M's receiver kind
when Frame, else a Go value of its type); or a compiled method expression Gofn with the receiver
Recv first. gofns are its Go funcs by type (adapters, as a closure's).\n"
  (struct ^{:tag (* Method)} M ^any Recv ^bool Frame ^any Gofn
          ^{:tag sync/Mutex} mu ^{:tag (map reflect/Type any)} gofns))

(go/method setRecvOf "setRecvOf writes the bound receiver to its slot of nf.\n" [^{:tag (* Bound)} b ^{:tag (* Frame)} nf]
  (if (.-Frame b)
    (setFrameSlot nf (.-RK (.-M b)) (.-RS (.-M b)) (.-Recv b))
    (setRecv nf (.-RK (.-M b)) (.-RS (.-M b)) (.-RT (.-M b)) (.-Recv b))))

(go/func MethodValue
  "MethodValue is x.M of a concrete type: method fn (its receiver slot rk, rs of type rt,
signature sig) bound to the receiver node recv's value, evaluated now (Go's rule).\n"
  ^R [^{:tag (* Func)} fn ^int32 rk ^int32 rs ^{:tag (* Type)} rt ^{:tag (* Type)} sig ^any recv]
  (let [m (addr (lit Method :Name (.-Name fn) :Fn fn :RK (conv byte rk) :RS rs :RT rt :Sig sig))]
    (switch (conv byte rk)
      (case [\I] (let [n (assert I recv)] (return (fn ^any [^{:tag (* Frame)} fr] (addr (lit Bound :M m :Recv (n fr) :Frame true))))))
      (case [\F] (let [n (assert F recv)] (return (fn ^any [^{:tag (* Frame)} fr] (addr (lit Bound :M m :Recv (n fr) :Frame true))))))
      (case [\S] (let [n (assert S recv)] (return (fn ^any [^{:tag (* Frame)} fr] (addr (lit Bound :M m :Recv (n fr) :Frame true)))))))
    (let [n (assert R recv)]
      (fn ^any [^{:tag (* Frame)} fr] (addr (lit Bound :M m :Recv (n fr) :Frame true))))))

(go/func BoundCompiled
  "BoundCompiled is x.M of a compiled type: its method expression gofn bound to the receiver
node recv's value (a Go value of the method expression's receiver type), evaluated now.\n"
  ^R [^any gofn ^R recv]
  (fn ^any [^{:tag (* Frame)} fr] (addr (lit Bound :Gofn gofn :Recv (recv fr)))))

(go/func IfaceMethodValue
  "IfaceMethodValue is x.M of an interface content x: an interpreted type's method bound to it, else
the compiled method expression gofn (the static interface's, or the table's of the dynamic
type when nil) bound to the content.\n"
  ^R [^R x ^string key ^string name ^any gofn]
  (let [c (new (inst atomic/Pointer icache))]
    (fn ^any [^{:tag (* Frame)} fr]
      (let [v (x fr)
            m (ifaceMethod v key c)]
        (when (!= m nil)
          (return (addr (lit Bound :M m :Recv v))))
        (when (== v nil)
          (nilDeref))
        (let [g gofn]
          (when (== g nil)
            (let [rt (reflect/TypeOf v)
                  (values path tname found) (tableTypeOf rt)]
              (when found
                (let [(values m ok2) (member path (+ tname "." name))]
                  (when ok2
                    (set! g (.-Value m))
                    (when (and (== (.Kind rt) reflect/Pointer) (!= (.In (reflect/TypeOf g) 0) rt))
                      (set! v (.Interface (.Elem (reflect/ValueOf v))))))))
              (when (== g nil)
                (cond
                  (== name "Error") (set! g (method-expr error Error))
                  (== name "String") (set! g (method-expr fmt/Stringer String))
                  :else (panic (fmt/Sprintf "goi cannot take the method value %s of %s: the type is not in the table" name (.String rt)))))))
          (addr (lit Bound :Gofn g :Recv v)))))))

(go/method callValues
  "callValues calls the method value with reflect.Values of its parameters (a Go func made from
it, called by compiled code; t its type), its results as reflect.Values.\n"
  ^{:tag (slice reflect/Value)} [^{:tag (* Bound)} b ^{:tag (* Type)} t ^{:tag (slice reflect/Value)} in]
  (when (!= (.-Gofn b) nil)
    (let [all (append (lit (slice reflect/Value) (reflect/ValueOf (.-Recv b))) (spread in))
          fv (reflect/ValueOf (.-Gofn b))]
      (when (.-Variadic t)
        (return (.CallSlice fv all)))
      (return (.Call fv all))))
  (let [th (CurrentThread)
        fn (.-Fn (.-M b))
        code (.Code fn)
        m (.save th)
        nf (.enter th code fn)
        (values _ ps rs) (slotCounts t)]
    (range [i v in]
      (let [pt (aget (.-Ins t) i)]
        (when (and (.-Variadic t) (== i (- (len (.-Ins t)) 1)))
          (set! pt (descOfRT (.Type v))))
        (setSlotValue nf (.-K pt) (aget ps i) pt v)))
    (.setRecvOf b nf)
    (run code nf)
    (let [out (make (slice reflect/Value) (len rs))]
      (range [i s rs]
        (aset out i (slotValue nf (aget (.-Outs t) i) s)))
      (.restore th m)
      out)))

(go/method goFunc "goFunc is the method value as a real Go func of type t (reflect.MakeFunc), made once per type.\n"
  ^any [^{:tag (* Bound)} b ^{:tag (* Type)} t]
  (.Lock (.-mu b))
  (defer (.Unlock (.-mu b)))
  (let [rt (.rt t)
        g (aget (.-gofns b) rt)]
    (when (!= g nil)
      (return g))
    (if (!= (.-M b) nil)
      (set! g (adaptTarget b t))
      (set! g (.Interface (reflect/MakeFunc rt (fn ^{:tag (slice reflect/Value)} [^{:tag (slice reflect/Value)} in]
                                                   (.callValues b t in))))))
    (when (== (.-gofns b) nil)
      (set! (.-gofns b) (make (map reflect/Type any))))
    (aset (.-gofns b) rt g)
    (.Store adapters (efaceData g) b)
    g))

;; ---------------------------------------------------------------------------------------
;; Interpreted methods called from Go (fmt's, the wrappers', Report's)

(go/func callMethodValues
  "callMethodValues calls method m on receiver v (a Go value of its receiver type) with
reflect.Values of its parameters, on the current goroutine's thread: its results.\n"
  ^{:tag (slice reflect/Value)} [^{:tag (* Method)} mt ^any v ^{:tag (slice reflect/Value)} in]
  (let [b (addr (lit Bound :M mt :Recv v))]
    (.callValues b (.-Sig mt) in)))

(go/func stringSig "stringSig says whether method m's signature is func() string.\n" ^bool [^{:tag (* Method)} m]
  (and (!= m nil) (== (len (.-Ins (.-Sig m))) 0) (== (len (.-Outs (.-Sig m))) 1) (== (.-GK (aget (.-Outs (.-Sig m)) 0)) reflect/String)))

;; ---------------------------------------------------------------------------------------
;; Type assertions and type switches (§5.3, §10.3)

(go/func dynType
  "dynType is the descriptor of content v's dynamic type: the registry's interpreted type of
its reflect type, else the compiled type's; nil for nil.\n"
  ^{:tag (* Type)} [^any v]
  (when (== v nil)
    (return nil))
  (descOfRT (reflect/TypeOf v)))

(go/func hasType "hasType says whether content v's dynamic type is concrete type t (every type's RT is its own: GR9a-c).\n"
  ^bool [^any v ^{:tag (* Type)} t]
  (and (!= v nil) (== (reflect/TypeOf v) (.-RT t))))

(go/func compiledHas
  "compiledHas says whether compiled type rt has method m (the table's method of that name and
signature; Error and String by the compiled interfaces).\n"
  ^bool [^{:tag reflect/Type} rt ^IMethod m]
  (let [sig (.mem (.-Sig m))]
    (when (and (== (.NumIn sig) 0) (== (.NumOut sig) 1) (== (.Out sig 0) ((inst reflect/TypeFor string))))
      (cond
        (== (.-Key m) "Error") (return (.Implements rt errorType))
        (== (.-Key m) "String") (return (.Implements rt stringerType))))
    (let [(values path tname ok) (tableTypeOf rt)]
      (when (not ok)
        (return false))
      (let [(values mb ok2) (member path (+ tname "." (.-Key m)))]
        (when (not ok2)
          (return false))
        (let [mt (reflect/TypeOf (.-Value mb))
              r0 (.In mt 0)]
          (when (and (!= r0 rt) (not (and (== (.Kind rt) reflect/Pointer) (== r0 (.Elem rt)))))
            (return false))
          (when (or (!= (.NumIn mt) (+ (.NumIn sig) 1)) (!= (.NumOut mt) (.NumOut sig)) (!= (.IsVariadic mt) (.IsVariadic sig)))
            (return false))
          (for [i 0] (< i (.NumIn sig)) (inc! i)
            (when (!= (.In mt (+ i 1)) (.In sig i))
              (return false)))
          (for [i 0] (< i (.NumOut sig)) (inc! i)
            (when (!= (.Out mt i) (.Out sig i))
              (return false)))
          true)))))

(go/func missingMethod
  "missingMethod is the first method of interface type it that content v's dynamic type lacks
(\"\" when it implements it; v not nil).\n"
  ^string [^any v ^{:tag (* Type)} it]
  (let [d (dynType v)]
    (when (not (.-Compiled d))
      (range [_ m (.-IMethods it)]
        (let [e (aget (.-Methods d) (.-Key m))]
          (when (or (== e nil) (!= (.-Sig e) (.-Sig m)))
            (return (methodName (.-Key m))))))
      (return "")))
  (let [rt (reflect/TypeOf v)]
    (when (and (.-Compiled it) (!= (.-RT it) anyType))
      (when (.Implements rt (.-RT it))
        (return ""))
      (range [_ m (.-IMethods it)]
        (when (not (compiledHas rt m))
          (return (methodName (.-Key m)))))
      (return "?"))
    (range [_ m (.-IMethods it)]
      (when (not (compiledHas rt m))
        (return (methodName (.-Key m)))))
    ""))

(go/func methodName "methodName is a method key's name (path.name: name).\n" ^string [^string k]
  (lastName k))

(go/func implements "implements says whether content v's dynamic type implements interface type it.\n"
  ^bool [^any v ^{:tag (* Type)} it]
  (when (== v nil)
    (return false))
  (== (missingMethod v it) ""))

(go/func matches "matches says whether content v asserts to type t (an interface or a concrete type).\n"
  ^bool [^any v ^{:tag (* Type)} t]
  (when (.-Iface t)
    (return (implements v t)))
  (hasType v t))

(go/func assertedValue "assertedValue is content v asserted to t, as a frame value of an R kind.\n"
  ^any [^any v ^{:tag (* Type)} t]
  (when (.-Iface t)
    (return v))
  (fromMem t v))

(go/type TypeAssertionError
  "TypeAssertionError is a failed type assertion, with gc's message (runtime.TypeAssertionError's;
a runtime.Error).\n"
  (struct ^string iface ^string concrete ^string asserted ^string missing ^bool samePkg))

(go/method Error ^string [^{:tag (* TypeAssertionError)} e]
  (let [inter "interface"]
    (when (!= (.-iface e) "")
      (set! inter (.-iface e)))
    (when (== (.-concrete e) "")
      (return (+ "interface conversion: " inter " is nil, not " (.-asserted e))))
    (when (== (.-missing e) "")
      (let [msg (+ "interface conversion: " inter " is " (.-concrete e) ", not " (.-asserted e))]
        (when (== (.-concrete e) (.-asserted e))
          (if (.-samePkg e)
            (set! msg (+ msg " (types from different scopes)"))
            (set! msg (+ msg " (types from different packages)"))))
        (return msg)))
    (+ "interface conversion: " (.-concrete e) " is not " (.-asserted e) ": missing method " (.-missing e))))

(go/method RuntimeError [^{:tag (* TypeAssertionError)} e])

(go/func assertFail "assertFail panics as gc for content v that does not assert to t (static interface iname).\n"
  [^any v ^{:tag (* Type)} t ^string iname]
  (let [e (addr (lit TypeAssertionError :iface iname :asserted (typeName t)))]
    (when (!= v nil)
      (set! (.-concrete e) (typeName (dynType v)))
      (set! (.-samePkg e) (== (typePkg (dynType v)) (typePkg t)))
      (when (.-Iface t)
        (set! (.-missing e) (missingMethod v t))))
    (panic e)))

(go/func typePkg "typePkg is t's package path as gc's runtime has it (a named type's; a struct's unexported fields').\n"
  ^string [^{:tag (* Type)} t]
  (when (== t nil)
    (return ""))
  (when (!= (.-Pkg t) "")
    (return (.-Pkg t)))
  (when (and (!= (.-RT t) nil) (== (.Kind (.-RT t)) reflect/Struct))
    (for [i 0] (< i (.NumField (.-RT t))) (inc! i)
      (when (!= (.-PkgPath (.Field (.-RT t) i)) "")
        (return (.-PkgPath (.Field (.-RT t) i))))))
  (when (!= (.-RT t) nil)
    (return (.PkgPath (.-RT t))))
  "")

(go/func AssertI "AssertI is x.(T) of an integer or bool type T.\n" ^I [^R x ^{:tag (* Type)} t ^string iname]
  (fn ^int64 [^{:tag (* Frame)} fr]
    (let [v (x fr)]
      (when (not (hasType v t))
        (assertFail v t iname))
      (goIntOf v))))

(go/func AssertF ^F [^R x ^{:tag (* Type)} t ^string iname]
  (fn ^float64 [^{:tag (* Frame)} fr]
    (let [v (x fr)]
      (when (not (hasType v t))
        (assertFail v t iname))
      (floatOf v))))

(go/func AssertS ^S [^R x ^{:tag (* Type)} t ^string iname]
  (fn ^string [^{:tag (* Frame)} fr]
    (let [v (x fr)]
      (when (not (hasType v t))
        (assertFail v t iname))
      (stringOf v))))

(go/func AssertR "AssertR is x.(T) of an R type T (a concrete type, or an interface: the content itself).\n"
  ^R [^R x ^{:tag (* Type)} t ^string iname]
  (fn ^any [^{:tag (* Frame)} fr]
    (let [v (x fr)]
      (when (not (matches v t))
        (assertFail v t iname))
      (assertedValue v t))))

(go/func Assert2
  "Assert2 is v, ok := x.(T): the value (the zero value when it fails) to slot vs of kind k, ok
to I slot oks.\n"
  ^T [^R x ^{:tag (* Type)} t ^int32 k ^int32 vs ^int32 oks]
  (let [kk (conv byte k)]
    (fn [^{:tag (* Frame)} fr]
      (let [v (x fr)
            ok (matches v t)]
        (aset (.-I fr) oks (B2I ok))
        (if ok
          (switch kk
            (case [\I] (aset (.-I fr) vs (goIntOf v)))
            (case [\F] (aset (.-F fr) vs (floatOf v)))
            (case [\S] (aset (.-S fr) vs (stringOf v)))
            (default (aset (.-R fr) vs (assertedValue v t))))
          (switch kk
            (case [\I] (aset (.-I fr) vs 0))
            (case [\F] (aset (.-F fr) vs 0))
            (case [\S] (aset (.-S fr) vs ""))
            (default (aset (.-R fr) vs (.Zero t)))))))))

(go/type TCase
  "TCase is a type switch's clause: its types (Nil: the case nil too), whether it is the
default, its body (binding the clause's variable first).\n"
  (struct ^{:tag (slice (* Type))} Types ^bool Nil ^bool Default ^Stmt Body))

(go/func NewTCase ^TCase [^{:tag (slice (* Type))} ts ^bool hasNil ^bool def ^Stmt body]
  (lit TCase ts hasNil def body))

(go/func TypeSwitch
  "TypeSwitch is a type switch over content x (pre: its init and the guard's evaluation), its
clauses tested in source order, brk its break code.\n"
  ^Stmt [^Stmt pre ^R x ^{:tag (slice TCase)} cases ^Ctl brk]
  (let [def -1]
    (range [i c cases]
      (when (.-Default c)
        (set! def i)))
    (fn ^Ctl [^{:tag (* Frame)} fr]
      (when (!= pre nil)
        (let [c (pre fr)]
          (when (!= c 0)
            (return c))))
      (let [v (x fr)
            chosen def]
        (label :find
          (range [i c cases]
            (when (and (.-Nil c) (== v nil))
              (set! chosen i)
              (break :find))
            (range [_ t (.-Types c)]
              (when (matches v t)
                (set! chosen i)
                (break :find)))))
        (when (< chosen 0)
          (return 0))
        (let [c ((.-Body (aget cases chosen)) fr)]
          (when (== c brk)
            (return 0))
          c)))))

;; ---------------------------------------------------------------------------------------
;; Types' names as gc writes them (messages)

(go/func typeName "typeName is t's name as gc's runtime writes it (interpreted named types by their descriptors).\n"
  ^string [^{:tag (* Type)} t]
  (when (== t nil)
    (return "nil"))
  (when (!= (.-Name t) "")
    (return (.-Name t)))
  (when (.-Compiled t)
    (when (== (.-RT t) anyType)
      (return "interface {}"))
    (return (.String (.-RT t))))
  (switch (.-GK t)
    (case [reflect/Pointer] (return (+ "*" (typeName (.-Elem t)))))
    (case [reflect/Slice] (return (+ "[]" (typeName (.-Elem t)))))
    (case [reflect/Array] (return (fmt/Sprintf "[%d]%s" (.-Len t) (typeName (.-Elem t)))))
    (case [reflect/Map] (return (+ "map[" (typeName (.-Key t)) "]" (typeName (.-Elem t)))))
    (case [reflect/Chan]
      (switch (.-ChanDir t)
        (case [1] (return (+ "<-chan " (typeName (.-Elem t)))))
        (case [2] (return (+ "chan<- " (typeName (.-Elem t))))))
      (return (+ "chan " (typeName (.-Elem t)))))
    (case [reflect/Func]
      (let [b (lit strings/Builder)]
        (.WriteString (addr b) "func(")
        (range [i x (.-Ins t)]
          (when (> i 0) (.WriteString (addr b) ", "))
          (if (and (.-Variadic t) (== i (- (len (.-Ins t)) 1)))
            (.WriteString (addr b) (+ "..." (typeName (.-Elem x))))
            (.WriteString (addr b) (typeName x))))
        (.WriteString (addr b) ")")
        (when (== (len (.-Outs t)) 1)
          (.WriteString (addr b) (+ " " (typeName (aget (.-Outs t) 0)))))
        (when (> (len (.-Outs t)) 1)
          (.WriteString (addr b) " (")
          (range [i x (.-Outs t)]
            (when (> i 0) (.WriteString (addr b) ", "))
            (.WriteString (addr b) (typeName x)))
          (.WriteString (addr b) ")"))
        (return (.String (addr b)))))
    (case [reflect/Struct]
      (when (== (len (.-Fields t)) 0)
        (return "struct {}"))
      (let [b (lit strings/Builder)]
        (.WriteString (addr b) "struct { ")
        (range [i f (.-Fields t)]
          (when (> i 0) (.WriteString (addr b) "; "))
          (if (.-Embedded f)
            (.WriteString (addr b) (typeName (.-T f)))
            (.WriteString (addr b) (+ (.-Name f) " " (typeName (.-T f))))))
        (.WriteString (addr b) " }")
        (return (.String (addr b))))))
  (when (.-Iface t)
    (when (== (len (.-IMethods t)) 0)
      (return "interface {}")))
  (.String t))

;; goi: types at run time (GOI-SPEC.md §5.2): descriptors and RT, the typed loads and stores
;; through addresses (§4.4, S25), cells, zero values, and the two representations of a value:
;; in a frame (its slot) and in Go memory. They differ for function types only: a frame value
;; may be an interpreted closure (*Closure) while Go memory holds a real Go func (an adapter,
;; §4.6). Since GR9a-c every interpreted named type's RT is a runtime type of its own, made at
;; run time by reflect's overlay (reflect.ArbaceNamed, overlay/go/reflect.ae) with its method set
;; (the table's typed stubs, GC66), and so is every composite of one: compiled code, fmt,
;; reflect and the runtime see it as gc's, and a value is held as itself everywhere (no proxies,
;; no wrappers, no erased pointers, no shapes in Go memory: GC69, GC70).
(in-ns 'go.arbace.goi)

(go/file "types.go"
  :imports [[fmt "fmt"] [reflect "reflect"] [strings "strings"] [sync "sync"] [unsafe "unsafe"]])

(go/const
  [^{:tag byte} convNone 0]
  [^{:tag byte} convFunc 2])

(go/type Field "Field is a struct field: its name, type and offset.\n"
  (struct ^string Name ^{:tag (* Type)} T ^uintptr Off ^bool Embedded))

(go/type Type
  "Type is a Go type's descriptor (§5.2). RT is the Go type of its values, in frames and in Go
memory alike (Mem is RT, kept for the callers that name Go memory's type); Conv convFunc marks
function types, whose frame values may be closures. K is the slot kind (I, F, S or R), GK the Go
kind. Name and Pkg name an interpreted named type (Gen its generation), Under its underlying
type's descriptor; Elem, Key, Len, Fields, Ins, Outs and Variadic the parts of composite types.
Compiled types are made from their reflect.Type alone (Compiled). Methods is the method set of
an interpreted type by key (an exported name, or path.name), IMethods an interface type's
methods (GR4, §5.3). own: the RT was made at run time for this type (an interpreted named type
that is not an interface, made by reflect.ArbaceNamed, or a composite of one), so that the
registry finds the descriptor from a value's reflect type; room, proom: the methods the RT
(and its pointer type's) have room for; layout: the RT has its shape's layout only, before its
underlying type (ArbaceSetLayout, GC70); stubbed: the RT's method table is set (once: itabs are
cached for good, GC68). Every descriptor but a compiled interface's is made once per type
(interned), so that descriptors compare by identity. Reify: an Arbace reify's type (G13), its
values a struct holding the Arbace object, its methods calling its fns.\n"
  (struct ^{:tag reflect/Type} RT ^{:tag reflect/Type} Mem ^byte Conv ^byte K ^{:tag reflect/Kind} GK
          ^string Name ^string Pkg ^int Gen ^bool Compiled ^bool Iface
          ^{:tag (* Type)} Under ^{:tag (* Type)} Elem ^{:tag (* Type)} Key ^int Len
          ^{:tag (slice Field)} Fields ^{:tag (slice (* Type))} Ins ^{:tag (slice (* Type))} Outs ^bool Variadic
          ^int ChanDir
          ^{:tag (map string (* Method))} Methods ^{:tag (slice IMethod)} IMethods
          ^bool complete ^bool own ^bool layout ^int room ^int proom ^bool roomed
          ^bool methodsSet ^bool stubbed ^bool Reify ^int mver
          ^bool direct ^bool zeroDone ^any zero))

(go/var ^{:tag sync/Mutex} typesMu)

(go/var ^{:tag (map reflect/Type (* Type)) :doc "types are the compiled types' descriptors, one per reflect.Type.\n"}
  types (make (map reflect/Type (* Type))))

(go/func slotKindOf "slotKindOf is the slot kind of Go kind k.\n" ^byte [^{:tag reflect/Kind} k]
  (switch k
    (case [reflect/Bool reflect/Int reflect/Int8 reflect/Int16 reflect/Int32 reflect/Int64
           reflect/Uint reflect/Uint8 reflect/Uint16 reflect/Uint32 reflect/Uint64 reflect/Uintptr]
      (return \I))
    (case [reflect/Float32 reflect/Float64] (return \F))
    (case [reflect/String] (return \S)))
  \R)

(go/func isDirect
  "isDirect says whether values of t are stored directly in an interface's data word
(pointer-shaped), as reflect's DirectIface.\n"
  ^bool [^{:tag reflect/Type} t]
  (switch (.Kind t)
    (case [reflect/Pointer reflect/Map reflect/Chan reflect/Func reflect/UnsafePointer] (return true))
    (case [reflect/Struct] (return (and (== (.NumField t) 1) (isDirect (.-Type (.Field t 0))))))
    (case [reflect/Array] (return (and (== (.Len t) 1) (isDirect (.Elem t))))))
  false)

(go/func TypeOf
  "TypeOf is the descriptor of compiled (or reflect-made) type t, one per type: its parts are
made from t on demand.\n"
  ^{:tag (* Type)} [^{:tag reflect/Type} t]
  (.Lock typesMu)
  (defer (.Unlock typesMu))
  (typeOfLocked t))

(go/func typeOfLocked ^{:tag (* Type)} [^{:tag reflect/Type} t]
  (let [d (aget types t)]
    (when (== d nil)
      (set! d (addr (lit Type :RT t :Mem t :K (slotKindOf (.Kind t)) :GK (.Kind t) :Compiled true
                         :direct (isDirect t) :Iface (== (.Kind t) reflect/Interface))))
      (when (== (.Kind t) reflect/Func)
        (set! (.-Conv d) convFunc))
      (aset types t d))
    d))

(go/method elem "elem is the element type of a pointer, slice, array, map or channel type.\n"
  ^{:tag (* Type)} [^{:tag (* Type)} t]
  (when (and (== (.-Elem t) nil) (.-Compiled t))
    (set! (.-Elem t) (TypeOf (.Elem (.-RT t)))))
  (.-Elem t))

(go/method key "key is a map type's key type.\n" ^{:tag (* Type)} [^{:tag (* Type)} t]
  (when (and (== (.-Key t) nil) (.-Compiled t))
    (set! (.-Key t) (TypeOf (.Key (.-RT t)))))
  (.-Key t))

(go/method rt "rt is the type's RT.\n" ^{:tag reflect/Type} [^{:tag (* Type)} t]
  (.-RT t))

(go/method mem "mem is the type's Go type in Go memory: its RT.\n" ^{:tag reflect/Type} [^{:tag (* Type)} t]
  (when (== (.-RT t) nil)
    (panic (fmt/Sprintf "goi: the type %s is used before it is complete" (.String t))))
  (.-RT t))

(go/method String "String is the type's name as gc writes it.\n" ^string [^{:tag (* Type)} t]
  (when (!= (.-Name t) "")
    (return (.-Name t)))
  (when (!= (.-RT t) nil)
    (return (.String (.-RT t))))
  (when (and (== (.-GK t) reflect/Pointer) (!= (.-Elem t) nil))
    (return (+ "*" (.String (.-Elem t)))))
  "?")

(go/method field "field is struct type t's field i (its descriptor made from RT for a compiled type).\n"
  ^Field [^{:tag (* Type)} t ^int i]
  (when (and (== (.-Fields t) nil) (.-Compiled t))
    (let [n (.NumField (.-RT t))
          fs (make (slice Field) n)]
      (for [j 0] (< j n) (inc! j)
        (let [sf (.Field (.-RT t) j)]
          (aset fs j (lit Field :Name (.-Name sf) :T (TypeOf (.-Type sf)) :Off (.-Offset sf) :Embedded (.-Anonymous sf)))))
      (set! (.-Fields t) fs)))
  (aget (.-Fields t) i))

(go/method Zero "Zero is the type's zero value as a frame holds it (R kinds).\n" ^any [^{:tag (* Type)} t]
  (when (not (.-zeroDone t))
    (when (and (!= (.-Conv t) convFunc) (not (.-Iface t)))
      (set! (.-zero t) (.Interface (reflect/Zero (.rt t)))))
    (set! (.-zeroDone t) true))
  (.-zero t))

;; ---------------------------------------------------------------------------------------
;; Making descriptors (the builder's, §4.1)

(go/var anyType ((inst reflect/TypeFor any)))
(go/var unsafePointerType ((inst reflect/TypeFor unsafe/Pointer)))

(go/func basicRT "basicRT is the reflect.Type of a basic type's name.\n" ^{:tag reflect/Type} [^string n]
  (switch n
    (case ["bool"] (return ((inst reflect/TypeFor bool))))
    (case ["int"] (return ((inst reflect/TypeFor int))))
    (case ["int8"] (return ((inst reflect/TypeFor int8))))
    (case ["int16"] (return ((inst reflect/TypeFor int16))))
    (case ["int32"] (return ((inst reflect/TypeFor int32))))
    (case ["int64"] (return ((inst reflect/TypeFor int64))))
    (case ["uint"] (return ((inst reflect/TypeFor uint))))
    (case ["uint8"] (return ((inst reflect/TypeFor uint8))))
    (case ["uint16"] (return ((inst reflect/TypeFor uint16))))
    (case ["uint32"] (return ((inst reflect/TypeFor uint32))))
    (case ["uint64"] (return ((inst reflect/TypeFor uint64))))
    (case ["uintptr"] (return ((inst reflect/TypeFor uintptr))))
    (case ["float32"] (return ((inst reflect/TypeFor float32))))
    (case ["float64"] (return ((inst reflect/TypeFor float64))))
    (case ["complex64"] (return ((inst reflect/TypeFor complex64))))
    (case ["complex128"] (return ((inst reflect/TypeFor complex128))))
    (case ["string"] (return ((inst reflect/TypeFor string))))
    (case ["unsafe.Pointer"] (return unsafePointerType))
    (case ["any"] (return anyType))
    (case ["error"] (return ((inst reflect/TypeFor error)))))
  (panic (+ "goi: no basic type " n)))

(go/func TBasic "TBasic is the descriptor of a basic type, any or error by name.\n" ^{:tag (* Type)} [^string n]
  (TypeOf (basicRT n)))

(go/func TIface
  "TIface is the descriptor of an interpreted interface type: its RT is any (§5.2); its methods
are given by TSetIfaceMethods. name is a named interface type's name, else its method set's
text: the interning key.\n"
  ^{:tag (* Type)} [^string name]
  (let [k (+ "iface " name)
        o (internedType k)]
    (when (!= o nil)
      (return o))
    (intern k (addr (lit Type :RT anyType :Mem anyType :K \R :GK reflect/Interface :Iface true :Name name)))))

(go/func composite
  "composite is the descriptor of an unnamed composite type of Go kind k and RT rt, made of
parts ps: its RT is its own (own) when one of its parts' is, and the registry then finds it.\n"
  ^{:tag (* Type)} [^{:tag reflect/Kind} k ^{:tag reflect/Type} rt & ^{:tag (slice (* Type))} ps]
  (let [t (addr (lit Type :RT rt :Mem rt :K (slotKindOf k) :GK k))]
    (when (!= rt nil)
      (set! (.-direct t) (reflect/ArbaceDirectIface rt)))
    (range [_ p ps]
      (when (and (!= p nil) (.-own p))
        (set! (.-own t) true)))
    t))

(go/var ^{:tag sync/Mutex} internMu)

(go/var ^{:tag (map string (* Type)) :doc "interned are the descriptors of unnamed composite and interpreted named types by their parts (GR4): one per type.\n"}
  interned (make (map string (* Type))))

(go/func internedType "internedType is the descriptor interned under key k, or nil.\n" ^{:tag (* Type)} [^string k]
  (.Lock internMu)
  (defer (.Unlock internMu))
  (aget interned k))

(go/func intern
  "intern records t under key k and gives the descriptor interned there (t, or one made first
by another goroutine); a descriptor with an RT of its own enters the registry by its RT.\n"
  ^{:tag (* Type)} [^string k ^{:tag (* Type)} t]
  (.Lock internMu)
  (let [o (aget interned k)]
    (when (!= o nil)
      (.Unlock internMu)
      (return o))
    (aset interned k t)
    (.Unlock internMu)
    (when (.-own t)
      (register t))
    t))

(go/func typesKey "typesKey is the identities of descriptors ts, for an interning key.\n" ^string [^{:tag (slice (* Type))} ts]
  (let [b (lit strings/Builder)]
    (range [_ t ts]
      (fmt/Fprintf (addr b) "%p," t))
    (.String b)))

(go/func TPtr
  "TPtr is the descriptor of *elem. Of an interpreted named type, its RT is the pointer type
reflect.ArbaceNamed made with it (its method table's room proom), whether elem is complete or
not: a type recursive through pointers needs nothing more (GC70).\n"
  ^{:tag (* Type)} [^{:tag (* Type)} elem]
  (let [k (fmt/Sprintf "*%p" elem)
        o (internedType k)]
    (when (!= o nil)
      (return o))
    (let [t (composite reflect/Pointer (reflect/PointerTo (.-RT elem)) elem)]
      (set! (.-Elem t) elem)
      (when (and (.-own elem) (!= (.-Name elem) "") (not (.-Iface elem)))
        (set! (.-room t) (.-proom elem))
        (set! (.-roomed t) true))
      (intern k t))))

(go/func TSlice ^{:tag (* Type)} [^{:tag (* Type)} elem]
  (let [k (fmt/Sprintf "[]%p" elem)
        o (internedType k)]
    (when (!= o nil)
      (return o))
    (let [t (composite reflect/Slice (reflect/SliceOf (.-RT elem)) elem)]
      (set! (.-Elem t) elem)
      (intern k t))))

(go/func TArray ^{:tag (* Type)} [^int n ^{:tag (* Type)} elem]
  (let [k (fmt/Sprintf "[%d]%p" n elem)
        o (internedType k)]
    (when (!= o nil)
      (return o))
    (let [t (composite reflect/Array (reflect/ArrayOf n (.mem elem)) elem)]
      (set! (.-Elem t) elem)
      (set! (.-Len t) n)
      (intern k t))))

(go/func TMap ^{:tag (* Type)} [^{:tag (* Type)} k ^{:tag (* Type)} v]
  (let [key (fmt/Sprintf "map[%p]%p" k v)
        o (internedType key)]
    (when (!= o nil)
      (return o))
    (let [t (composite reflect/Map (reflect/MapOf (.mem k) (.mem v)) k v)]
      (set! (.-Key t) k)
      (set! (.-Elem t) v)
      (intern key t))))

(go/func TChan ^{:tag (* Type)} [^int dir ^{:tag (* Type)} elem]
  (let [key (fmt/Sprintf "chan%d %p" dir elem)
        o (internedType key)]
    (when (!= o nil)
      (return o))
    (let [d reflect/BothDir]
      (when (== dir 1) (set! d reflect/RecvDir))
      (when (== dir 2) (set! d reflect/SendDir))
      (let [t (composite reflect/Chan (reflect/ChanOf d (.-RT elem)) elem)]
        (set! (.-Elem t) elem)
        (set! (.-ChanDir t) dir)
        (intern key t)))))

(go/func TFunc ^{:tag (* Type)} [^{:tag (slice (* Type))} ins ^{:tag (slice (* Type))} outs ^bool variadic]
  (let [key (fmt/Sprintf "func(%s)(%s)%v" (typesKey ins) (typesKey outs) variadic)
        o (internedType key)]
    (when (!= o nil)
      (return o))
    (let [ri (make (slice reflect/Type) (len ins))
          ro (make (slice reflect/Type) (len outs))]
      (range [i x ins] (aset ri i (.-RT x)))
      (range [i x outs] (aset ro i (.-RT x)))
      (let [t (composite reflect/Func (reflect/FuncOf ri ro variadic) (spread (append (append (lit (slice (* Type))) (spread ins)) (spread outs))))]
        (set! (.-Ins t) ins)
        (set! (.-Outs t) outs)
        (set! (.-Variadic t) variadic)
        (set! (.-Conv t) convFunc)
        (intern key t)))))

(go/func structFields
  "structFields are the reflect fields of a struct type: unexported names (blank ones too) with
their package path; embedded fields are plain fields of their type's name (StructOf refuses
embedded fields with methods): a named struct type marks them embedded in its own RT
(reflect.ArbaceSetUnderlying), an unnamed one keeps them plain (S36's difference, for unnamed
struct types only).\n"
  ^{:tag (slice reflect/StructField)} [^{:tag (slice string)} names ^{:tag (slice (* Type))} ts ^{:tag (slice string)} tags
                                       ^{:tag (slice string)} pkgs]
  (let [fs (make (slice reflect/StructField) (len names))]
    (range [i n names]
      (aset fs i (lit reflect/StructField :Name n :Type (.mem (aget ts i)) :Tag (conv reflect/StructTag (aget tags i)) :PkgPath (aget pkgs i))))
    fs))

(go/func fillFields "fillFields sets t's fields from its RT and the field types.\n"
  [^{:tag (* Type)} t ^{:tag (slice string)} names ^{:tag (slice (* Type))} ts ^{:tag (slice bool)} emb]
  (let [fs (make (slice Field) (len names))]
    (range [i n names]
      (aset fs i (lit Field :Name n :T (aget ts i) :Off (.-Offset (.Field (.-RT t) i)) :Embedded (aget emb i))))
    (set! (.-Fields t) fs)))

(go/func TStruct "TStruct is the descriptor of an unnamed struct type.\n"
  ^{:tag (* Type)} [^{:tag (slice string)} names ^{:tag (slice (* Type))} ts ^{:tag (slice string)} tags
                    ^{:tag (slice string)} pkgs ^{:tag (slice bool)} emb]
  (let [key (fmt/Sprintf "struct%q%s%q%q%v" names (typesKey ts) tags pkgs emb)
        o (internedType key)]
    (when (!= o nil)
      (return o))
    (let [t (composite reflect/Struct (reflect/StructOf (structFields names ts tags pkgs)) (spread ts))]
      (fillFields t names ts emb)
      (intern key t))))

;; ---------------------------------------------------------------------------------------
;; The registry: interpreted types by their RT (§5.2)

(go/var ^{:tag (map reflect/Type (* Type)) :doc "interp is the registry of interpreted types by RT (§5.2), guarded by typesMu.\n"}
  interp (make (map reflect/Type (* Type))))

(go/var ^{:tag sync/Map :doc "interpRT is interp as a sync.Map, read without the lock (dispatch, GR4).\n"} interpRT)

(go/func register
  "register enters interpreted type t into the registry by its RT: a type whose RT is its own,
or one whose RT reflect made from its fields (an unnamed struct type with embedded fields and a
method set of its own, TSetMethods); the first one stays.\n"
  [^{:tag (* Type)} t]
  (when (== (.-RT t) nil)
    (return))
  (.Lock typesMu)
  (when (== (aget interp (.-RT t)) nil)
    (aset interp (.-RT t) t)
    (.Store interpRT (.-RT t) t))
  (.Unlock typesMu))

(go/var ^{:tag sync/Map :doc "rtDescs are the descriptors descOfRT gave, by reflect type.\n"} rtDescs)

(go/func descOfRT
  "descOfRT is the descriptor of reflect type rt (a value's dynamic type): the registry's
interpreted type, a composite of one that compiled code made (reflect.SliceOf of an interpreted
named type ...), else the compiled type's.\n"
  ^{:tag (* Type)} [^{:tag reflect/Type} rt]
  (let [(values d ok) (.Load interpRT rt)]
    (when ok
      (return (assert (* Type) d))))
  (let [(values d ok) (.Load rtDescs rt)]
    (when ok
      (return (assert (* Type) d))))
  (let [^{:tag (* Type)} d nil]
    (switch (.Kind rt)
      (case [reflect/Pointer reflect/Slice reflect/Array reflect/Chan]
        (let [e (descOfRT (.Elem rt))]
          (when (.-own e)
            (switch (.Kind rt)
              (case [reflect/Pointer] (set! d (TPtr e)))
              (case [reflect/Slice] (set! d (TSlice e)))
              (case [reflect/Array] (set! d (TArray (.Len rt) e)))
              (case [reflect/Chan]
                (switch (.ChanDir rt)
                  (case [reflect/RecvDir] (set! d (TChan 1 e)))
                  (case [reflect/SendDir] (set! d (TChan 2 e)))
                  (default (set! d (TChan 0 e)))))))))
      (case [reflect/Map]
        (let [k (descOfRT (.Key rt))
              v (descOfRT (.Elem rt))]
          (when (or (.-own k) (.-own v))
            (set! d (TMap k v))))))
    (when (or (== d nil) (!= (.-RT d) rt))
      (set! d (TypeOf rt)))
    (.Store rtDescs rt d)
    d))

;; ---------------------------------------------------------------------------------------
;; Interpreted named types (§5.2; GR9a-c): runtime types of their own

(go/func TNamed
  "TNamed is the interpreted named type pkg.name of generation gen, of Go kind kind, its
underlying type set later (TSetUnder): a new runtime type (reflect.ArbaceNamed), named name
(gc's runtime name, pkgname.T) of package pkg (main for a command's), with its pointer type,
their method tables with room for nm and npm methods; nparams is the parameters' and results'
count of an underlying function type. One per type and generation (interned).\n"
  ^{:tag (* Type)} [^string name ^string pkg ^int gen ^int kind ^int nparams ^int nm ^int npm]
  (let [key (fmt/Sprintf "%s %s#%d" pkg name gen)
        o (internedType key)]
    (when (!= o nil)
      (return o))
    (let [rpkg pkg]
      (when (== rpkg "command-line-arguments")
        (set! rpkg "main"))
      (let [k (conv reflect/Kind kind)
            (values rt _) (reflect/ArbaceNamed rpkg name k nparams nm npm)
            t (addr (lit Type :Name name :Pkg pkg :Gen gen :RT rt :Mem rt :GK k :K (slotKindOf k) :own true
                         :room nm :proom npm :roomed true))]
        (when (== k reflect/Func)
          (set! (.-Conv t) convFunc))
        (intern key t)))))

(go/func embeddedIndexes "embeddedIndexes are the indexes of the true elements of emb.\n" ^{:tag (slice int)} [^{:tag (slice bool)} emb]
  (let [out (lit (slice int))]
    (range [i e emb]
      (when e
        (set! out (append out i))))
    out))

(go/func TSetUnder
  "TSetUnder completes named type t with its underlying type u (once: a runtime type does not
change, a REPL's new underlying type is a new generation, §2.5): its RT gets u's layout, kind
data and operations (reflect.ArbaceSetUnderlying), a struct's embedded fields marked embedded
(S36 ended) and its blank fields left out of its ==. For a struct, u's fields (names, types,
tags, package paths, embedded) are given again.\n"
  [^{:tag (* Type)} t ^{:tag (* Type)} u ^{:tag (slice string)} names ^{:tag (slice (* Type))} ts ^{:tag (slice string)} tags
   ^{:tag (slice string)} pkgs ^{:tag (slice bool)} emb]
  (when (.-complete t)
    (return))
  (set! (.-Under t) u)
  (set! (.-GK t) (.-GK u))
  (set! (.-K t) (.-K u))
  (set! (.-Iface t) (.-Iface u))
  (set! (.-Conv t) (.-Conv u))
  (set! (.-Elem t) (.-Elem u))
  (set! (.-Key t) (.-Key u))
  (set! (.-Len t) (.-Len u))
  (set! (.-Ins t) (.-Ins u))
  (set! (.-Outs t) (.-Outs u))
  (set! (.-Variadic t) (.-Variadic u))
  (set! (.-ChanDir t) (.-ChanDir u))
  (set! (.-IMethods t) (.-IMethods u))
  (reflect/ArbaceSetUnderlying (.-RT t) (.mem u) (embeddedIndexes emb))
  (set! (.-direct t) (reflect/ArbaceDirectIface (.-RT t)))
  (if (and (== (.-GK u) reflect/Struct) (> (len names) 0))
    (fillFields t names ts emb)
    (set! (.-Fields t) (.-Fields u)))
  (set! (.-layout t) false)
  (set! (.-complete t) true)
  (noteType t))

(go/func TShape
  "TShape gives named type t, before its underlying type is built, its shape's layout (the
layout and pointer words of shape: reflect.ArbaceSetLayout), for the constructors that read it
while types containing t are made (MapOf's, StructOf's, ArrayOf's: a type recursive through a
map or by value; GC70).\n"
  [^{:tag (* Type)} t ^{:tag (* Type)} shape]
  (when (or (.-complete t) (.-layout t))
    (return))
  (reflect/ArbaceSetLayout (.-RT t) (.mem shape))
  (set! (.-layout t) true))

(go/func TNamedIface
  "TNamedIface is interpreted named interface type pkg.name of generation gen, complete at once
(its RT is any: GC71), so that its methods' signatures may name it; its methods are given by
TSetIfaceMethods.\n"
  ^{:tag (* Type)} [^string name ^string pkg ^int gen]
  (let [key (fmt/Sprintf "%s %s#%d" pkg name gen)
        o (internedType key)]
    (when (!= o nil)
      (return o))
    (intern key (addr (lit Type :Name name :Pkg pkg :Gen gen :RT anyType :Mem anyType :K \R :GK reflect/Interface
                           :Iface true :complete true)))))

(go/func lastName "lastName is a qualified name's last element.\n" ^string [^string n]
  (let [i (strings/LastIndex n ".")]
    (when (>= i 0)
      (return (subslice n (+ i 1))))
    n))

;; ---------------------------------------------------------------------------------------
;; Interface data words, boxes

(go/func efaceData "efaceData is an interface value's data word.\n" ^unsafe/Pointer [^any x]
  (aget @(conv (* (array 2 unsafe/Pointer)) (conv unsafe/Pointer (addr x))) 1))

(go/func boxAddr
  "boxAddr is the address of the value an interface holds (a struct or array value in transit,
an R box): its data word, or for a pointer-shaped type a new variable holding it.\n"
  ^unsafe/Pointer [^any x ^{:tag (* Type)} t]
  (when (.-direct t)
    (let [p (new unsafe/Pointer)]
      (set! @p (efaceData x))
      (return (conv unsafe/Pointer p))))
  (efaceData x))

;; ---------------------------------------------------------------------------------------
;; The two representations (frames and Go memory)

(go/func toMem
  "toMem is frame value v of type t as Go memory holds it: an interpreted closure as a real Go
func of t (§4.6); any other value is itself (GR9a-c).\n"
  ^any [^{:tag (* Type)} t ^any v]
  (when (== (.-Conv t) convFunc)
    (when (== v nil)
      ;; a nil func in Go memory, an interface's content: typed
      (return (.Interface (reflect/Zero (.rt t)))))
    (type-switch [c v]
      (case [(* Closure)] (return (.goFunc c t)))
      (case [(* Bound)] (return (.goFunc c t)))
      (case [(* MethodExpr)] (return (.goFunc c t)))))
  v)

(go/func retype
  "retype is value v as a value of type to of the same kind and size: its bytes reinterpreted
(an unnamed struct value of a type reflect made with plain fields given for a named struct type
whose fields are embedded: their RTs are not identical, the layouts are); v itself when of type
to.\n"
  ^any [^any v ^{:tag reflect/Type} to]
  (when (== v nil)
    (return (.Interface (reflect/Zero to))))
  (let [rv (reflect/ValueOf v)]
    (when (== (.Type rv) to)
      (return v))
    (when (or (!= (.Size (.Type rv)) (.Size to)) (!= (.Kind (.Type rv)) (.Kind to)))
      (panic (fmt/Sprintf "goi: retyping a %s (%d bytes) as a %s (%d)" (.Type rv) (.Size (.Type rv)) to (.Size to))))
    (let [p (reflect/New (.Type rv))]
      (.Set (.Elem p) rv)
      (.Interface (.Elem (reflect/NewAt to (.UnsafePointer p)))))))

(go/func fromMem
  "fromMem is Go memory's value v of type t as a frame holds it: a Go func made from an
interpreted closure the closure again, a nil func nil.\n"
  ^any [^{:tag (* Type)} t ^any v]
  (when (== (.-Conv t) convFunc)
    (return (closureOf v)))
  v)

(go/method valueOf "valueOf is frame value v of t as a reflect.Value of t's Go memory type.\n"
  ^{:tag reflect/Value} [^{:tag (* Type)} t ^any v]
  (let [m (toMem t v)]
    (when (== m nil)
      (return (reflect/Zero (.mem t))))
    (let [rv (reflect/ValueOf m)]
      (when (!= (.Type rv) (.mem t))
        (when (.AssignableTo (.Type rv) (.mem t))
          (let [z (reflect/New (.mem t))]
            (.Set (.Elem z) rv)
            (return (.Elem z))))
        (when (.ConvertibleTo (.Type rv) (.mem t))
          (return (.Convert rv (.mem t))))
        (return (reflect/ValueOf (retype m (.mem t)))))
      rv)))

;; ---------------------------------------------------------------------------------------
;; Loads and stores through addresses (§4.4, S25): typed by the place's type

(go/method load "load is the value at p of type t as a frame holds it (R kinds; the others by kind too).\n"
  ^any [^{:tag (* Type)} t ^unsafe/Pointer p]
  (when (.-Iface t)
    (when (== (.mem t) anyType)
      (return @(conv (* any) p))))
  (switch (.-GK t)
    (case [reflect/Complex128] (return @(conv (* complex128) p)))
    (case [reflect/Complex64] (return @(conv (* complex64) p))))
  (fromMem t (.Interface (.Elem (reflect/NewAt (.mem t) p)))))

(go/method store "store writes frame value v of type t at p (a typed copy: the write barriers apply).\n"
  [^{:tag (* Type)} t ^unsafe/Pointer p ^any v]
  (when (and (.-Iface t) (== (.mem t) anyType))
    (set! @(conv (* any) p) v)
    (return))
  (.Set (.Elem (reflect/NewAt (.mem t) p)) (.valueOf t v)))

(go/method copyAt "copyAt copies the value of type t at src to dst (a typed copy).\n"
  [^{:tag (* Type)} t ^unsafe/Pointer dst ^unsafe/Pointer src]
  (.Set (.Elem (reflect/NewAt (.mem t) dst)) (.Elem (reflect/NewAt (.mem t) src))))

(go/method newCell "newCell is the address of a new zero variable of type t.\n" ^unsafe/Pointer [^{:tag (* Type)} t]
  (.UnsafePointer (reflect/New (.mem t))))

(go/method ptrTo "ptrTo is pointer p to a variable of type t as a frame holds a *t.\n" ^any [^{:tag (* Type)} t ^unsafe/Pointer p]
  (.Interface (reflect/NewAt (.mem t) p)))

(go/method box "box is the value of type t at p as a frame holds it in transit (a copy).\n"
  ^any [^{:tag (* Type)} t ^unsafe/Pointer p]
  (.load t p))

(go/func loadI "loadI is the integer (or bool) at p of Go kind k, normalized.\n" ^int64 [^{:tag reflect/Kind} k ^unsafe/Pointer p]
  (switch k
    (case [reflect/Bool] (return (B2I @(conv (* bool) p))))
    (case [reflect/Int8] (return (conv int64 @(conv (* int8) p))))
    (case [reflect/Int16] (return (conv int64 @(conv (* int16) p))))
    (case [reflect/Int32] (return (conv int64 @(conv (* int32) p))))
    (case [reflect/Uint8] (return (conv int64 @(conv (* uint8) p))))
    (case [reflect/Uint16] (return (conv int64 @(conv (* uint16) p))))
    (case [reflect/Uint32] (return (conv int64 @(conv (* uint32) p)))))
  @(conv (* int64) p))

(go/func storeI "storeI writes integer (or bool) v at p of Go kind k.\n" [^{:tag reflect/Kind} k ^unsafe/Pointer p ^int64 v]
  (switch k
    (case [reflect/Bool] (set! @(conv (* bool) p) (!= v 0)))
    (case [reflect/Int8 reflect/Uint8] (set! @(conv (* uint8) p) (conv uint8 v)))
    (case [reflect/Int16 reflect/Uint16] (set! @(conv (* uint16) p) (conv uint16 v)))
    (case [reflect/Int32 reflect/Uint32] (set! @(conv (* uint32) p) (conv uint32 v)))
    (default (set! @(conv (* int64) p) v))))

(go/func loadF ^float64 [^{:tag reflect/Kind} k ^unsafe/Pointer p]
  (when (== k reflect/Float32)
    (return (conv float64 @(conv (* float32) p))))
  @(conv (* float64) p))

(go/func storeF [^{:tag reflect/Kind} k ^unsafe/Pointer p ^float64 v]
  (if (== k reflect/Float32)
    (set! @(conv (* float32) p) (conv float32 v))
    (set! @(conv (* float64) p) v)))

;; ---------------------------------------------------------------------------------------
;; Values and reflect.Values by slot kind (maps, compiled calls without an invoker)

(go/method fromValue "fromValue is reflect.Value v of type t as an R frame value.\n" ^any [^{:tag (* Type)} t ^{:tag reflect/Value} v]
  (when (not (.IsValid v))
    (return (.Zero t)))
  (fromMem t (.Interface v)))

(go/func valueI "valueI is integer v as a reflect.Value of type rt.\n" ^{:tag reflect/Value} [^{:tag reflect/Type} rt ^int64 v]
  (let [x (.Elem (reflect/New rt))]
    (switch (.Kind rt)
      (case [reflect/Bool] (.SetBool x (!= v 0)))
      (case [reflect/Uint reflect/Uint8 reflect/Uint16 reflect/Uint32 reflect/Uint64 reflect/Uintptr] (.SetUint x (conv uint64 v)))
      (default (.SetInt x v)))
    x))

(go/func intOfValue "intOfValue is reflect.Value v of an integer or bool kind as an I value.\n" ^int64 [^{:tag reflect/Value} v]
  (when (not (.IsValid v))
    (return 0))
  (switch (.Kind v)
    (case [reflect/Bool] (return (B2I (.Bool v))))
    (case [reflect/Uint reflect/Uint8 reflect/Uint16 reflect/Uint32 reflect/Uint64 reflect/Uintptr] (return (conv int64 (.Uint v)))))
  (.Int v))

;; What the builder asks of descriptors

(go/func FieldOff "FieldOff is struct type t's field i's offset.\n" ^int [^{:tag (* Type)} t ^int i]
  (conv int (.-Off (.field t i))))

(go/func FieldType "FieldType is struct type t's field i's type.\n" ^{:tag (* Type)} [^{:tag (* Type)} t ^int i]
  (.-T (.field t i)))

(go/func ElemSize "ElemSize is the size of a value of type t in Go memory.\n" ^int [^{:tag (* Type)} t]
  (conv int (.Size (.mem t))))

(go/func ElemType "ElemType is t's element type.\n" ^{:tag (* Type)} [^{:tag (* Type)} t] (.elem t))

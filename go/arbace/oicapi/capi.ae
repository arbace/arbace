(in-ns 'go.arbace.oicapi) (go/file "capi.go" :doc "Package oicapi runs a program's own C stubs beside oi (doc/ocaml/OCAML-SURVEY.md, \"As built: the C API on ci\"): the stubs,\noi's C runtime (test/ocaml/capi/runtime.c) and what they need of musl, one node program (bin/oi cnodes), loaded into\nci over an address space of its own. An external oi does not implement is the stubs' C function of its name; its\narguments cross as OCaml's words: an integer tagged, a block a copy in ci's memory (its header the word before, OCaml's\nlayout), made when the stub is called and read back when it returns, around a callback and when it raises. The copies of a\ncall live in the boundary's memory until the outermost stub returns; a custom block the C allocates is static, kept for the\nrun (since queue 516 one whose operations have a finalize is held weakly, and its finalize runs once its value is unreachable,\nat the collection a program asks for). No collector moves them, so the C's roots need no registration.\n" :imports [
    [fmt "fmt"]
    [io "io"]
    [math "math"]
    [os "os"]
    [strconv "strconv"]
    [strings "strings"]
    [sync "sync"]
    [syscall "syscall"]
    [weak "weak"]
    [binary "encoding/binary"]
    [bytes "bytes"]
    [ci "arbace/ci"]
    [crt "arbace/crt"]
    [oi "arbace/oi"]])

(go/const "The tags of mlvalues.h the boundary writes.\n"
  [tagClosure 247]
  [tagAbstract 251]
  [tagString 252]
  [tagDouble 253]
  [tagDoubleArray 254]
  [tagCustom 255]
  [chunkSize (<< 1 20)])

(go/type baSnap "baSnap is a bigarray copy's elements as written: their address and bytes.\n" (struct ^uint64 d ^{:tag (slice byte)} b))

(go/type CBlock "CBlock is a custom block the C allocated (caml_alloc_custom): its address in ci's static memory, kept for the run.\n"
  (struct ^uint64 Addr))

(go/type capi "capi is the loaded C program and the boundary's state.\n" (struct
    ^{:tag (* ci/Prog)} p
    ^{:tag (* crt/Mem)} m
    ^{:tag (* oi/Thread)} th
    ^int depth
    ;; the boundary's memory: chunks of chunkSize, the current one's free part [cur, end)
    ^{:tag (slice uint64)} chunks
    ^int chunk
    ^uint64 cur
    ^uint64 end
    ^{:tag (slice (slice uint64))} big
    ;; the big blocks' mappings of the calls before, free again, by size (2026-11-24: a mapping a call's big block was fresh memory
    ;; each call, lib-bigarray/subarraystub's 41,000)
    ^{:tag (map uint64 (slice uint64))} bigFree
    ;; the call's bigarray copies: the elements' bytes as written, by the copy's address, so that one the C left alone is not read back
    ^{:tag (map uint64 baSnap)} snaps
    ;; the call's bigarrays the C allocated with memory of their own (CAML_BA_MANAGED, caml_ba_alloc's calloc): their data's address
    ;; by oi's value, freed when the call ends unless a root keeps the block (bigarray.c's caml_ba_finalize once the block is dead: the
    ;; copy dies with the boundary's memory, oi's value holds the elements; 2026-11-24, ocaml-eval: lib-bigarray/subarraystub's
    ;; 41,000 results grew the C's heap past 1.5 GB)
    ^{:tag (map any uint64)} cdata
    ;; the static memory (custom blocks, named values' slots, operations' records)
    ^uint64 scur
    ^uint64 send
    ;; the call's copies: each value's address and back, in the order made
    ^{:tag (map any uint64)} toC
    ^{:tag (map uint64 oi/Value)} toGo
    ^{:tag (slice uint64)} order
    ^{:tag (map uint64 int)} seen
    ^int pass
    ;; the run's: the C's custom blocks, the named values' slots, the operations' records by identifier
    ^{:tag (map uint64 oi/Value)} statics
    ;; the custom blocks whose operations have a finalize (queue 516): held weakly; finMu guards the finalisable ones' map
    ^{:tag (map uint64 (weak/Pointer oi/Custom))} wstatics
    ;; the AOT runtime's dead blocks a global root still reaches (queue 523, Collected), finalized once none does
    ^{:tag (slice uint64)} later
    ^{:tag sync/Mutex} finMu
    ;; the global roots (queue 516): the registered cells, those registered or modified in the outermost call (rehomed at its
    ;; end), and the static copies made for oi's values (one a value)
    ^{:tag (map uint64 bool)} roots
    ^{:tag (slice uint64)} dirty
    ^{:tag (map any uint64)} homes
    ^{:tag (map string uint64)} named
    ^{:tag (map string uint64)} customOps
    ^{:tag (array 4 uint64)} ops
    ^{:tag (* ci/Func)} flush
    ;; two words of static memory a helper's results are written into
    ^uint64 scratch
    ;; the C's threads (queue 530, threads.go): their registrations, the main thread stepped off the baton between the stubs, the
    ;; static timespec the stand-ins sleep with
    ^{:tag (map (* ci/Thread) (* cthread))} cthreads
    ^{:tag (* parker)} mainPk
    ^uint64 ts
    ;; the closures given to the C, by the index their copy holds in its first word (queue 530): a C thread may call one back after the
    ;; outermost call that gave it ended (lib-systhreads/test_c_thread_register's closure, unregistered, as OCaml's stays put)
    ^{:tag (slice (weak/Pointer oi/Closure))} closures
    ;; a C program that embeds OCaml (queue 539, Embed): the program's argv, and the OCaml program's initialisation while its main runs
    ^{:tag (slice string)} argv
    ^{:tag (func [])} start))

(go/var ^{:tag (* capi)} the)

;; The AOT runtime's boundary (OC215 (a), doc/ocaml/OCAML-SURVEY.md "As built: OC215"): the compiled level's main
;; (test/ocaml/o2j/capi) holds the program's values as oi's values (mirrors of the Java runtime's) and calls a stub through
;; Call; a callback and a named value are then the Java runtime's, through these two hooks (nil: oi's own).

(go/var ^{:tag (func [oi/Value (slice oi/Value)] [oi/Value oi/Value]) :doc "Apply, when set, applies a callback's closure f to vs in place of oi's thread: its result, or the OCaml exception it\nraised (exn, else nil).\n"}
  Apply)

(go/var ^{:tag (func [string] [oi/Value bool]) :doc "Named, when set, is caml_named_value in place of oi's table.\n"}
  Named)

(go/var ^{:tag (func [int string (slice int64)] [(slice int64)]) :doc "RuntimeEvents, when set, answers the C consumer of runtime events (__oi_re_control op 0, __oi_re_cursor 1, __oi_re_next 2,\ntheir arguments as RuntimeEventsControl's, RuntimeEventsCursor's and RuntimeEventsNext's, the results in their order) from the AOT\nruntime's ring in place of oi's (queue 583: a program's events are the runtime's).\n"}
  RuntimeEvents)

(go/var ^{:tag (func []) :doc "MajorCycle, when set, tells the AOT runtime that the stubs' allocations ended a major cycle of the simulated heap (oc-tail:\nthe runtime's collection then fires its own finalisers, which run at its next allocation: c-api/alloc_async), as oi's CAlloc fires\noi's.\n"}
  MajorCycle)

(go/var ^{:tag (map any bool) :doc "managedNew is the bigarrays the C allocated with memory the collector manages (CAML_BA_MANAGED) not yet sent to the AOT
runtime (oc-tail: kept only when MajorCycle is set, the light level's server).
"}
  managedNew)

(go/func Managed "Managed tells whether v is a bigarray the C allocated with memory the collector manages, not yet sent (managedNew; oc-tail: the
light level's server marks it so in the wire form, and the runtime samples its memory as oi does); it is then forgotten.
" ^bool [^oi/Value v]
  (when [(values _ ok) (aget managedNew (conv any v))] ok
    (delete managedNew (conv any v))
    (return true))
  false)

(go/var ^{:tag int :doc "cWords is the words the stubs allocated since the simulated major heap's last cycle end, as oi's CAlloc counts them\n(cMajorUsed; oc-tail: counted here, not read back through GcCount, whose figures read Go's memory statistics).\n"} cWords)
(go/var ^{:tag int :doc "cCycle is the words of a cycle, oi's minor heap's (OCAMLRUNPARAM's s as minorHeapInit normalizes it, else 256 Ki), read once.\n"} cCycle)

(go/func cycleWords "cycleWords is cCycle, read once from OCAMLRUNPARAM (or CAMLRUNPARAM) as oi's minorHeapInit reads it.\n" ^int []
  (when (== cCycle 0)
    (let [(values opt ok) (os/LookupEnv "OCAMLRUNPARAM")
          n 262144]
      (when (not ok)
        (set! opt (os/Getenv "CAMLRUNPARAM")))
      (range [_ o (strings/Split opt ",")]
        (when (strings/HasPrefix o "s=")
          (let [v (subslice o 2)
                m 1]
            (when (strings/HasSuffix v "k")
              (set! m 1024)
              (set! v (strings/TrimSuffix v "k")))
            (when (strings/HasSuffix v "M")
              (set! m 1048576)
              (set! v (strings/TrimSuffix v "M")))
            (when (strings/HasSuffix v "G")
              (set! m 1073741824)
              (set! v (strings/TrimSuffix v "G")))
            (when [(values x err) (strconv/Atoi v)] (== err nil)
              (set! n (* x m))
              (when (< n 257)
                (set! n 257))
              (set! n (* (/ (+ n 511) 512) 512))))))
      (set! cCycle n)))
  cCycle)

(go/func cAlloc "cAlloc is oi's CAlloc of a stub's block of wosize words, then MajorCycle when it ended a major cycle of the simulated heap\n(the stubs' words since the last reaching a minor heap's, as CAlloc's cMajorUsed).\n" [^int wosize]
  (oi/CAlloc wosize)
  (when (!= MajorCycle nil)
    (set! cWords (+ cWords (+ wosize 1)))
    (when (>= cWords (cycleWords))
      (set! cWords 0)
      (MajorCycle))))

(go/func reNext "reNext is the C consumer's read at pos: RuntimeEvents' (op 2), else oi's RuntimeEventsNext.\n" [^int pos]
  :results [^int status ^int next ^int kind ^int dom ^int64 ts ^int id ^int64 data]
  (when (!= RuntimeEvents nil)
    (let [r (RuntimeEvents 2 "" (lit (slice int64) (conv int64 pos)))]
      (return (conv int (aget r 0)) (conv int (aget r 1)) (conv int (aget r 2)) (conv int (aget r 3)) (aget r 4) (conv int (aget r 5)) (aget r 6))))
  (return (oi/RuntimeEventsNext pos)))

(go/func namedValue "namedValue is caml_named_value: Named's, else oi's.\n" [^string name] :results [oi/Value bool]
  (when (!= Named nil)
    (return (Named name)))
  (return (oi/NamedValue name)))

(go/func Has "Has tells whether the loaded stubs define the C function name.\n" ^bool [^string name]
  (when (== the nil)
    (return false))
  (let [f (aget (.-ByName (.-p the)) name)]
    (return (and (!= f nil) (!= (.-Code f) nil)))))

(go/func CallRaw "CallRaw calls the stubs' native function name with the representations reprs (Primitive's native_repr, one a\nletter: v a value, I an unboxed int64, i an unboxed int32, n an unboxed nativeint, F an unboxed float, t an untagged int; the\narguments' then the result's: OC199 (a)), its arguments oi's values: a value as Call passes it, the others as the words or\nfloats themselves.\n"
  ^oi/Value [^string name ^string reprs ^{:tag (slice oi/Value)} a]
  (.callRaw the (aget (.-ByName (.-p the)) name) reprs a))

(go/func Call "Call calls the stubs' function name with the arguments a (oi's values) outside oi's thread: Load first, and Has(name).\nIt raises (a panic of *oi.Exn) what the C raises; a callback is Apply's.\n"
  ^oi/Value [^string name ^{:tag (slice oi/Value)} a]
  (.call the nil (aget (.-ByName (.-p the)) name) a))

(go/func Load "Load loads the node program at path: its commands, the natives of the boundary, its static initializers, musl initialized\nas __libc_start_main would (__init_libc), the runtime's own initialization; then oi's externals fall back on its functions.\n"
  ^error [^string path ^{:tag (slice string)} argv]
  (let [(values text err) (os/ReadFile path)]
    (when (!= err nil)
      (return err))
    (let [(values tops err) (ci/Parse (conv string text))]
      (when (!= err nil)
        (return err))
      (let [m (crt/NewMem)
            (values sin sout serr) (stdio)
            sys (crt/NewSys m sin sout serr)
            p (ci/NewProg sys)
            l (ci/NewLoader p)
            objs (lit (map string int))
            c (addr (lit capi :p p :m m :toC (lit (map any uint64)) :toGo (lit (map uint64 oi/Value)) :seen (lit (map uint64 int))
                      :statics (lit (map uint64 oi/Value)) :wstatics (lit (map uint64 (weak/Pointer oi/Custom)))
                      :roots (lit (map uint64 bool)) :homes (lit (map any uint64)) :named (lit (map string uint64)) :customOps (lit (map string uint64))))]
        (set! (.-StdFiles sys) (lit (array 3 (* os/File)) os/Stdin os/Stdout os/Stderr))
        ;; (queue 547) the process's own standard streams: a stub's dup2 and lseek on them and on a channel's descriptor are the
        ;; host's, as oi's channels write the host's descriptors (not the light level's server, whose streams are Stdio's)
        (when (== Stdio nil)
          (set! (.-HostFds sys) true))
        (range [_ t tops]
          (when [(values x ok) (assert (slice any) t)] (and ok (> (len x) 5) (== (fmt/Sprint (aget x 0)) "static"))
            (when [(values s ok) (assert string (aget x 5))] (and ok (not (strings/HasPrefix s "[")))
              (when [(values i e) (strconv/Atoi (fmt/Sprint (aget x 1)))] (== e nil)
                (aset objs s i))))
          (.Top l t))
        (let [natives (.natives c)]
          (range [_ f (.-Funcs p)]
            (when (and (!= f nil) (== (.-Code f) nil) (== (.-Native f) nil))
              (when [n (aget natives (.-Name f))] (!= n nil)
                (set! (.-Native f) n))))
          ;; the process's own: its pid and its signals are the host's, which oi's handlers (Sys.signal) see, not ci's emulated ones
          (range [name n (.hostNatives c)]
            (when [f (aget (.-ByName p) name)] (!= f nil)
              (set! (.-Native f) n))))
        (let [t (.-Main p)]
          (range [_ in (.-Inits p)]
            (let [fr (addr (lit ci/Frame :T t :Base (- (.-SP t) 4096) :I (make (slice int64) (.-NI in)) :F (make (slice float64) (.-NF in))))]
              (.Run (.-S in) fr)))
          (when [il (aget (.-ByName p) "__init_libc")] (and (!= il nil) (!= (.-Code il) nil))
            (let [(values envp pn) (.stack c argv (os/Environ))]
              (.Call p t il (lit (slice ci/Arg) (lit ci/Arg :K \i :I (conv int64 envp)) (lit ci/Arg :K \i :I (conv int64 pn))))))
          (when [i (aget (.-ByName p) "__oi_c_init")] (!= i nil)
            (.Call p t i nil)))
        (when [(values i ok) (aget objs "__oi_ops")] (and ok (< i (len (.-Statics p))))
          (let [a (aget (.-Statics p) i)]
            (for [k 0] (< k 4) (inc! k)
              (aset (.-ops c) k (.Load64 m (+ a (conv uint64 (* 8 k))))))))
        (set! (.-flush c) (aget (.-ByName p) "__oi_c_flush"))
        (set! (.-argv c) argv)
        (set! the c)
        (set! oi/ExternalFallback (fn ^oi/Ext [^string name ^int nargs] (.external c name nargs)))
        (set! (.-scratch c) (.allocStatic c 2 tagAbstract))
        (set! oi/CustomSerialize (fn [^{:tag (* oi/Custom)} x] :results [(slice byte) uint64 uint64 bool] (.serialize c x)))
        (set! oi/CustomDeserialize (fn [^string name ^{:tag (slice byte)} data ^uint64 expected] :results [oi/Value int int bool]
                                     (.deserialize c name data expected)))
        nil))))

(go/var ^{:tag (func [] [io/Reader io/Writer io/Writer]) :doc "Stdio, when set, gives the C's standard streams in place of the process's (the light level's server, the driver's\n`oi capi`: its own standard streams carry the wire form, the C's output goes back to the runtime with each reply).\n"}
  Stdio)

(go/func stdio "stdio is the C's standard streams: Stdio's, else the process's.\n" [] :results [io/Reader io/Writer io/Writer]
  (when (!= Stdio nil)
    (return (Stdio)))
  (return os/Stdin os/Stdout os/Stderr))

(go/var ^{:tag (func [] [int]) :doc "Pid, when set, is the process the program is (the C's getpid) in place of this one's (the light level's server: its\nparent, the runtime that spawned it).\n"}
  Pid)

(go/var ^{:tag (func [int int] [error]) :doc "Signal, when set, is the C's kill(pid, sig) and raise in place of oi.SignalProcess (the light level's server: a signal\nto the program itself goes back to the runtime with the reply).\n"}
  Signal)

(go/func pid "pid is the C's getpid: Pid's, else the process's.\n" ^int []
  (when (!= Pid nil)
    (return (Pid)))
  (os/Getpid))

(go/func signal "signal is the C's kill: Signal's, else oi's.\n" ^error [^int p ^int sig]
  (when (!= Signal nil)
    (return (Signal p sig)))
  (oi/SignalProcess p sig))

(go/func Flush "Flush flushes C's stdio (libc's exit, after the OCaml channels' flush at the program's end).\n" []
  (when (and (!= the nil) (!= (.-flush the) nil))
    (defer ((fn [] (recover))))
    (.enter the)
    (.Call (.-p the) (.-Main (.-p the)) (.-flush the) nil)))

(go/func RunMain "RunMain runs a C program of its own on ci (a test's helper program, OC201 (a), doc/ocaml/OCAML-SURVEY.md \"As built:\nOC199-OC201\"): the node program at path loaded as Load loads the stubs (musl initialized, the process's getpid, kill and\nraise the host's: a helper's kill of another process reaches it, which ci's own emulation, crt's, refuses), then its main\ncalled with argv and the environment; main's status, C's stdio flushed.\n"
  [^string path ^{:tag (slice string)} argv] :results [int error]
  (when [err (Load path argv)] (!= err nil)
    (return 0 err))
  (let [c the
        f (aget (.-ByName (.-p c)) "main")]
    (when (or (== f nil) (== (.-Code f) nil))
      (return 0 (fmt/Errorf "%s: no main" path)))
    (let [env (os/Environ)
          (values envp _) (.stack c argv env)
          av (- envp (conv uint64 (* 8 (+ (len argv) 1))))
          r (.Call (.-p c) (.-Main (.-p c)) f (lit (slice ci/Arg) (lit ci/Arg :K \i :I (conv int64 (len argv))) (lit ci/Arg :K \i :I (conv int64 av))
                                                (lit ci/Arg :K \i :I (conv int64 envp))))]
      (Flush)
      (return (conv int (conv int32 (.-I r))) nil))))

(go/func OwnMain "OwnMain tells whether the loaded stubs have a main of their own (queue 539: a C program that embeds OCaml,
embedded/cmcaml); test/ocaml/capi/main.c, linked when they have none, defines __oi_no_main.\n" ^bool []
  (and (Has "main") (not (Has "__oi_no_main"))))

(go/func Embed "Embed runs the stubs' own main (OwnMain) for oi's thread th, with the program's argv and the environment: its caml_main
or caml_startup runs start, the OCaml program's initialisation (oi.RunEmbedded's: once), and its callbacks run on th; the whole of main
is one outermost call of the boundary (its copies live until main returns). main's status; the C's exit an exit of the run.\n"
  ^int [^{:tag (* oi/Thread)} th ^{:tag (func [])} start]
  (let [c the
        f (aget (.-ByName (.-p c)) "main")
        t (.-Main (.-p c))
        (values envp _) (.stack c (.-argv c) (os/Environ))
        av (- envp (conv uint64 (* 8 (+ (len (.-argv c)) 1))))
        prev (.-th c)]
    (set! (.-th c) th)
    (set! (.-start c) start)
    (inc! (.-depth c))
    (defer ((fn []
              (let [r (recover)]
                (dec! (.-depth c))
                (when (== (.-depth c) 0)
                  (.reset c))
                (set! (.-start c) nil)
                (set! (.-th c) prev)
                (when (!= r nil)
                  (when [(values flt ok) (assert (* crt/Fault) r)] ok
                    (oi/Internalf "the C main's fault: %s at %#x" (.-Msg flt) (.-Addr flt)))
                  (when [(values ex ok) (assert (* crt/Exit) r)] ok
                    (panic (addr (lit oi/ExitSignal :Code (.-Code ex)))))
                  (panic r))))))
    (let [r (.Call (.-p c) t f (lit (slice ci/Arg) (lit ci/Arg :K \i :I (conv int64 (len (.-argv c)))) (lit ci/Arg :K \i :I (conv int64 av))
                                   (lit ci/Arg :K \i :I (conv int64 envp))))]
      (conv int (conv int32 (.-I r))))))

(go/method stack "stack is an initial stack's vector as Linux's: argv's pointers, 0, the environment's, 0, the auxiliary vector\n(AT_PAGESZ, AT_RANDOM); the environment's address and argv[0]'s.\n"
  [^{:tag (* capi)} c ^{:tag (slice string)} argv ^{:tag (slice string)} env] :results [uint64 uint64]
  (let [m (.-m c)
        str (fn ^uint64 [^string s]
              (let [b (append (conv (slice byte) s) 0)
                    a (.Static m (conv uint64 (len b)) 1)]
                (copy (.W m a (conv uint64 (len b))) b)
                a))
        ^{:tag (slice uint64)} vec (zero (slice uint64))]
    (range [_ a argv]
      (set! vec (append vec (str a))))
    (set! vec (append vec 0))
    (let [ne (len vec)]
      (range [_ e env]
        (set! vec (append vec (str e))))
      (let [rnd (.Static m 16 16)]
        (set! vec (append vec 0 6 crt/PageSize 25 rnd 0 0))
        (let [av (.Static m (conv uint64 (* 8 (len vec))) 16)]
          (range [i v vec]
            (.Store64 m (+ av (conv uint64 (* 8 i))) v))
          (return (+ av (conv uint64 (* 8 ne))) (aget vec 0)))))))

;; ---- memory ----

(go/method alloc "alloc is a block of wosize words and tag in the boundary's memory (the header written, the fields zero).\n"
  ^uint64 [^{:tag (* capi)} c ^uint64 wosize ^int tag]
  (let [n (* 8 (+ wosize 1))]
    (when (> n (/ chunkSize 4))
      (let [n (* (/ (+ n 65535) 65536) 65536)
            a (conv uint64 0)]
        (if [fs (aget (.-bigFree c) n)] (> (len fs) 0)
          (do (set! a (aget fs (- (len fs) 1)))
              (aset (.-bigFree c) n (subslice fs _ (- (len fs) 1)))
              (.Fill (.-m c) a 0 n))
          (set! a (.Mmap (.-m c) 0 n)))
        (set! (.-big c) (append (.-big c) (lit (slice uint64) a n)))
        (.Store64 (.-m c) a (bit-or (<< wosize 10) (conv uint64 tag)))
        (return (+ a 8))))
    (when (> (+ (.-cur c) n) (.-end c))
      (when (>= (.-chunk c) (len (.-chunks c)))
        (set! (.-chunks c) (append (.-chunks c) (.Mmap (.-m c) 0 chunkSize))))
      (set! (.-cur c) (aget (.-chunks c) (.-chunk c)))
      (set! (.-end c) (+ (.-cur c) chunkSize))
      (inc! (.-chunk c)))
    (let [a (.-cur c)]
      (set! (.-cur c) (+ a n))
      (.Fill (.-m c) a 0 n)
      (.Store64 (.-m c) a (bit-or (<< wosize 10) (conv uint64 tag)))
      (+ a 8))))

(go/method allocStatic "allocStatic is a block of wosize words and tag in the static memory, kept for the run.\n"
  ^uint64 [^{:tag (* capi)} c ^uint64 wosize ^int tag]
  (let [n (* 8 (+ wosize 1))]
    (when (> (+ (.-scur c) n) (.-send c))
      (let [size (max n (conv uint64 chunkSize))]
        (set! (.-scur c) (.Mmap (.-m c) 0 size))
        (set! (.-send c) (+ (.-scur c) size))))
    (let [a (.-scur c)]
      (set! (.-scur c) (+ a n))
      (.Store64 (.-m c) a (bit-or (<< wosize 10) (conv uint64 tag)))
      (+ a 8))))

(go/method reset "reset ends the outermost call: the roots registered or modified in it rehomed, then the boundary's memory free again, the
call's copies forgotten.\n" [^{:tag (* capi)} c]
  (when (> (len (.-dirty c)) 0)
    (let [d (.-dirty c)]
      (set! (.-dirty c) nil)
      (range [_ r d]
        (when (aget (.-roots c) r)
          (.Store64 (.-m c) r (.rehome c (.Load64 (.-m c) r)))))))
  (when (> (len (.-cdata c)) 0)
    (let [cd (.-cdata c)
          f (aget (.-ByName (.-p c)) "free")]
      (set! (.-cdata c) nil)
      (when (and (!= f nil) (or (!= (.-Code f) nil) (!= (.-Native f) nil)))
        (range [v d cd]
          (when [(values _ kept) (aget (.-homes c) v)] (not kept)
            (.Call (.-p c) (.-Main (.-p c)) f (lit (slice ci/Arg) (lit ci/Arg :K \i :I (conv int64 d)))))))))
  (when (== (.-bigFree c) nil)
    (set! (.-bigFree c) (lit (map uint64 (slice uint64)))))
  (range [_ b (.-big c)]
    (if (< (len (aget (.-bigFree c) (aget b 1))) 4)
      (aset (.-bigFree c) (aget b 1) (append (aget (.-bigFree c) (aget b 1)) (aget b 0)))
      (.Unmap (.-m c) (aget b 0) (aget b 1))))
  (set! (.-big c) nil)
  (set! (.-chunk c) 0)
  (set! (.-cur c) 0)
  (set! (.-end c) 0)
  (set! (.-toC c) (lit (map any uint64)))
  (set! (.-toGo c) (lit (map uint64 oi/Value)))
  (set! (.-seen c) (lit (map uint64 int)))
  (set! (.-order c) nil)
  (set! (.-snaps c) nil))

(go/method opsFor "opsFor is the address of a custom operations' record whose identifier is name (static, one a name).\n"
  ^uint64 [^{:tag (* capi)} c ^string name]
  (when [(values a ok) (aget (.-customOps c) name)] ok
    (return a))
  (let [b (append (conv (slice byte) name) 0)
        s (.allocStatic c (conv uint64 (/ (+ (len b) 7) 8)) tagAbstract)
        r (.allocStatic c 8 tagAbstract)]
    (copy (.W (.-m c) s (conv uint64 (len b))) b)
    (.Store64 (.-m c) r s)
    (aset (.-customOps c) name r)
    r))

;; ---- values: oi's to the C's ----

(go/method remember [^{:tag (* capi)} c ^oi/Value v ^uint64 a]
  (aset (.-toC c) v a)
  (aset (.-toGo c) a v)
  (aset (.-seen c) a (.-pass c))
  (set! (.-order c) (append (.-order c) a)))

(go/method encode "encode is v as the C's word: an integer tagged, a block its copy (made, or brought up to date once a pass).\n"
  ^uint64 [^{:tag (* capi)} c ^oi/Value v]
  (let [m (.-m c)]
    (type-switch [x v]
      (case [int]
        (return (bit-or (<< (conv uint64 x) 1) 1)))
      (case [nil]
        (return 1))
      (case [float64]
        (let [a (.alloc c 1 tagDouble)]
          (.StoreF64 m a x)
          (return a)))
      (case [int32]
        (let [a (.alloc c 2 tagCustom)]
          (.Store64 m a (aget (.-ops c) 0))
          (.Store32 m (+ a 8) (conv uint32 x))
          (return a)))
      (case [int64]
        (let [a (.alloc c 2 tagCustom)]
          (.Store64 m a (aget (.-ops c) 1))
          (.Store64 m (+ a 8) (conv uint64 x))
          (return a)))
      (case [oi/Nativeint]
        (let [a (.alloc c 2 tagCustom)]
          (.Store64 m a (aget (.-ops c) 2))
          (.Store64 m (+ a 8) (conv uint64 x))
          (return a)))
      (case [(* oi/Custom)]
        (when [(values cb ok) (assert (* CBlock) (.-V x))] ok
          (return (.-Addr cb)))))
    (when [(values a ok) (aget (.-toC c) v)] ok
      (when (!= (aget (.-seen c) a) (.-pass c))
        (aset (.-seen c) a (.-pass c))
        (.write c a v))
      (return a))
    (let [a (.fresh c v)]
      (.remember c v a)
      (.write c a v)
      a)))

(go/method fresh "fresh is a new copy's block for the value v (its size and tag; write fills it).\n" ^uint64 [^{:tag (* capi)} c ^oi/Value v]
  (type-switch [x v]
    (case [(* oi/Block)]
      (return (.alloc c (conv uint64 (len (.-F x))) (.-Tag x))))
    (case [(* oi/Bytes)]
      (return (.alloc c (conv uint64 (/ (+ (len (.-B x)) 8) 8)) tagString)))
    (case [(* oi/FloatArray)]
      (when (== (len (.-F x)) 0)
        (return (.alloc c 0 0)))
      (return (.alloc c (conv uint64 (len (.-F x))) tagDoubleArray)))
    (case [(* oi/Closure)]
      ;; its first word the index of the closure in closures, tagged (queue 530)
      (let [a (.alloc c 2 tagClosure)]
        (.Store64 (.-m c) a (bit-or (<< (conv uint64 (len (.-closures c))) 1) 1))
        (set! (.-closures c) (append (.-closures c) (^{:inst [oi/Closure]} weak/Make x)))
        (return a)))
    (case [(* oi/Custom)]
      (when [(values _ _ dims _ ok) (oi/BigarrayParts v)] ok
        (return (.alloc c (conv uint64 (+ 5 (len dims))) tagCustom)))
      (return (.alloc c 2 tagCustom))))
  (.alloc c 1 tagAbstract))

(go/method write "write writes v's contents into its copy at a.\n" [^{:tag (* capi)} c ^uint64 a ^oi/Value v]
  (let [m (.-m c)]
    (type-switch [x v]
      (case [(* oi/Block)]
        (range [i f (.-F x)]
          (.Store64 m (+ a (conv uint64 (* 8 i))) (.encode c f))))
      (case [(* oi/Bytes)]
        (let [w (/ (+ (len (.-B x)) 8) 8)
              last (- (* 8 w) 1)]
          (.Store64 m (+ a (conv uint64 (* 8 (- w 1)))) 0)
          (when (> (len (.-B x)) 0)
            (copy (.W m a (conv uint64 (len (.-B x)))) (.-B x)))
          (.Store8 m (+ a (conv uint64 last)) (conv uint8 (- last (len (.-B x)))))))
      (case [(* oi/FloatArray)]
        (range [i f (.-F x)]
          (.StoreF64 m (+ a (conv uint64 (* 8 i))) f)))
      (case [(* oi/Custom)]
        (when [(values kind layout dims data ok) (oi/BigarrayParts v)] ok
          (.Store64 m a (aget (.-ops c) 3))
          (let [es (elemSize kind)
                n (len data)
                d (.Load64 m (+ a 8))]
            (when (== d 0)
              (set! d (.alloc c (conv uint64 (/ (+ (* n es) 7) 8)) tagAbstract))
              (.Store64 m (+ a 8) d))
            (.Store64 m (+ a 16) (conv uint64 (len dims)))
            (.Store64 m (+ a 24) (conv uint64 (bit-or kind (bit-or (<< layout 8) 0x200))))
            (.Store64 m (+ a 32) 0)
            (range [i dm dims]
              (.Store64 m (+ a (conv uint64 (+ 40 (* 8 i)))) (conv uint64 dm)))
            (storeElems m kind d es data)
            (when (== (.-snaps c) nil)
              (set! (.-snaps c) (lit (map uint64 baSnap))))
            (aset (.-snaps c) a (lit baSnap :d d :b (append (conv (slice byte) nil) (spread (.R m d (conv uint64 (* n es))))))))
          (return))
        (.Store64 m a (.opsFor c (.-Name x)))
        ;; (queue 547) a channel: its data a pointer to a struct channel whose fd (and offset) are the channel's, as a stub that
        ;; reaches into io.h's struct (ppx_expect's runtime: Channel(v)->fd, then dup2 and lseek on it, the host's descriptors
        ;; under crt's HostFds) reads them
        (when [(values fd off ok) (oi/ChannelFd v)] ok
          (let [st (.alloc c 2 tagAbstract)]
            (.Store32 m st (conv uint32 fd))
            (.Store64 m (+ st 8) (conv uint64 off))
            (.Store64 m (+ a 8) st)))))))

(go/func elemSize "elemSize is caml_ba_element_size of a kind.\n" ^int [^int kind]
  (aget (lit (slice int) 4 8 1 1 2 2 4 8 8 8 8 16 1 2) kind))

;; The bigarray's elements cross in one slice of ci's memory (queue ocaml-eval 2026-11-24: lib-bigarray/subarraystub's 41,000 calls,
;; each 131,072 elements in and 220,000 out, spent their time in Mem's lookup per element and in Go's collector over a boxed integer
;; per element read back): an integer element read back equal to the value's is left as it is, and a new one in the 16-bit range is
;; one of smallInts, boxed once.
(go/var ^{:tag (slice oi/Value)} smallInts)
(go/var ^{:tag sync/Once} smallIntsOnce)

(go/func smallIntsInit []
  (.Do smallIntsOnce (fn []
                       (let [t (make (slice oi/Value) 98304)]
                         (for [i 0] (< i 98304) (inc! i)
                           (aset t i (- i 32768)))
                         (set! smallInts t)))))

(go/func boxedInt "boxedInt is v as oi's value, without an allocation for a value of a 16-bit element's range (smallIntsInit first).\n" ^oi/Value [^int v]
  (when (and (>= v -32768) (< v 65536))
    (return (aget smallInts (+ v 32768))))
  v)

(go/func storeElems "storeElems stores a bigarray's elements of the kind at d, es bytes each.\n" [^{:tag (* crt/Mem)} m ^int kind ^uint64 d ^int es ^{:tag (slice oi/Value)} data]
  (when (== (len data) 0)
    (return))
  (let [b (.W m d (conv uint64 (* (len data) es)))]
    (switch kind
      (case [2 3 12]
        (range [i e data]
          (aset b i (conv uint8 (oi/AsInt e)))))
      (case [4 5]
        (range [i e data]
          (.PutUint16 binary/LittleEndian (subslice b (* 2 i)) (conv uint16 (oi/AsInt e)))))
      (case [8]
        (range [i e data]
          (.PutUint64 binary/LittleEndian (subslice b (* 8 i)) (conv uint64 (oi/AsInt e)))))
      (default
        (range [i e data]
          (storeElem m kind (+ d (conv uint64 (* i es))) e))))))

(go/func loadElems "loadElems reads a bigarray's elements of the kind at d, es bytes each, into data (an integer element equal to the one\nthere kept).\n" [^{:tag (* crt/Mem)} m ^int kind ^uint64 d ^int es ^{:tag (slice oi/Value)} data]
  (when (== (len data) 0)
    (return))
  (smallIntsInit)
  (let [b (.R m d (conv uint64 (* (len data) es)))
        put (fn [^int i ^int v]
              (when [(values o ok) (assert int (aget data i))] (and ok (== o v))
                (return))
              (aset data i (boxedInt v)))]
    (switch kind
      (case [2]
        (range [i x b]
          (put i (conv int (conv int8 x)))))
      (case [3 12]
        (range [i x b]
          (put i (conv int x))))
      (case [4]
        (range [i _ data]
          (put i (conv int (conv int16 (.Uint16 binary/LittleEndian (subslice b (* 2 i))))))))
      (case [5]
        (range [i _ data]
          (put i (conv int (.Uint16 binary/LittleEndian (subslice b (* 2 i)))))))
      (case [8]
        (range [i _ data]
          (put i (oi/Int (conv int (.Uint64 binary/LittleEndian (subslice b (* 8 i))))))))
      (default
        (range [i _ data]
          (aset data i (loadElem m kind (+ d (conv uint64 (* i es))))))))))

(go/func storeElem "storeElem stores a bigarray element of the kind at a.\n" [^{:tag (* crt/Mem)} m ^int kind ^uint64 a ^oi/Value e]
  (switch kind
    (case [0] (.StoreF32 m a (conv float32 (oi/AsFloat e))))
    (case [1] (.StoreF64 m a (oi/AsFloat e)))
    (case [2 3 12] (.Store8 m a (conv uint8 (oi/AsInt e))))
    (case [4 5] (.Store16 m a (conv uint16 (oi/AsInt e))))
    (case [6] (.Store32 m a (conv uint32 (assert int32 e))))
    (case [7] (.Store64 m a (conv uint64 (assert int64 e))))
    (case [8] (.Store64 m a (conv uint64 (oi/AsInt e))))
    (case [9] (.Store64 m a (conv uint64 (assert oi/Nativeint e))))
    (case [10]
      (let [f (.-F (assert (* oi/FloatArray) e))]
        (.StoreF32 m a (conv float32 (aget f 0)))
        (.StoreF32 m (+ a 4) (conv float32 (aget f 1)))))
    (case [11]
      (let [f (.-F (assert (* oi/FloatArray) e))]
        (.StoreF64 m a (aget f 0))
        (.StoreF64 m (+ a 8) (aget f 1))))
    (case [13] (.Store16 m a (f16Bits (oi/AsFloat e))))))

(go/func loadElem "loadElem is the bigarray element of the kind at a.\n" ^oi/Value [^{:tag (* crt/Mem)} m ^int kind ^uint64 a]
  (switch kind
    (case [0] (return (conv float64 (.LoadF32 m a))))
    (case [1] (return (.LoadF64 m a)))
    (case [2] (return (conv int (conv int8 (.Load8 m a)))))
    (case [3 12] (return (conv int (.Load8 m a))))
    (case [4] (return (conv int (conv int16 (.Load16 m a)))))
    (case [5] (return (conv int (.Load16 m a))))
    (case [6] (return (conv int32 (.Load32 m a))))
    (case [7] (return (conv int64 (.Load64 m a))))
    (case [8] (return (oi/Int (conv int (.Load64 m a)))))
    (case [9] (return (conv oi/Nativeint (.Load64 m a))))
    (case [10] (return (addr (lit oi/FloatArray :F (lit (slice float64) (conv float64 (.LoadF32 m a)) (conv float64 (.LoadF32 m (+ a 4))))))))
    (case [11] (return (addr (lit oi/FloatArray :F (lit (slice float64) (.LoadF64 m a) (.LoadF64 m (+ a 8))))))))
  (f16Value (.Load16 m a)))

(go/func f16Bits "f16Bits is a float as IEEE half precision's bits (rounded to nearest even; the element already holds a half's value).\n"
  ^uint16 [^float64 f]
  (let [b (math/Float32bits (conv float32 f))
        sign (conv uint16 (bit-and (>> b 16) 0x8000))
        e (- (conv int (bit-and (>> b 23) 0xff)) 112)
        mant (bit-and b 0x7fffff)]
    (switch
      (case [(== (bit-and (>> b 23) 0xff) 0xff)]
        (if (!= mant 0)
          (return (bit-or sign 0x7e00))
          (return (bit-or sign 0x7c00))))
      (case [(>= e 31)]
        (return (bit-or sign 0x7c00)))
      (case [(<= e 0)]
        (when (< e -10)
          (return sign))
        (let [mm (bit-or mant 0x800000)
              shift (conv uint (- 14 e))]
          (return (bit-or sign (conv uint16 (>> mm shift)))))))
    (bit-or sign (bit-or (<< (conv uint16 e) 10) (conv uint16 (>> mant 13))))))

(go/func f16Value ^float64 [^uint16 h]
  (let [sign 1.0
        e (conv int (bit-and (>> h 10) 0x1f))
        mant (conv float64 (bit-and h 0x3ff))]
    (when (!= (bit-and h 0x8000) 0)
      (set! sign -1.0))
    (switch
      (case [(== e 0)] (return (* sign (math/Ldexp mant -24))))
      (case [(== e 31)]
        (when (!= mant 0)
          (return (math/NaN)))
        (return (math/Inf (conv int sign)))))
    (* sign (math/Ldexp (+ 1024 mant) (- e 25)))))

;; ---- values: the C's to oi's ----

(go/method decode "decode is the C's word w as oi's value: an integer, a copy's value (read once a pass), or a block the C made.\n"
  ^oi/Value [^{:tag (* capi)} c ^uint64 w]
  (when (== (bit-and w 1) 1)
    (return (conv int (>> (conv int64 w) 1))))
  (when (== w 0)
    (oi/Internalf "a C stub's value is a null pointer"))
  (when [(values v ok) (aget (.-statics c) w)] ok
    (return v))
  (when [v (.weakStatic c w)] (!= v nil)
    (return v))
  (when [(values v ok) (aget (.-toGo c) w)] ok
    (when (!= (aget (.-seen c) w) (.-pass c))
      (aset (.-seen c) w (.-pass c))
      (.read c w v))
    (return v))
  (let [m (.-m c)
        hd (.Load64 m (- w 8))
        wosize (>> hd 10)
        tag (conv int (bit-and hd 0xff))]
    (switch tag
      (case [tagDouble]
        (return (.LoadF64 m w)))
      (case [tagString]
        (let [last (- (* 8 wosize) 1)
              n (- last (conv uint64 (.Load8 m (+ w last))))
              v (addr (lit oi/Bytes :B (make (slice byte) n)))]
          (when (> n 0)
            (copy (.-B v) (.R m w n)))
          (.remember c v w)
          (return v)))
      (case [tagDoubleArray]
        (let [v (addr (lit oi/FloatArray :F (make (slice float64) wosize)))]
          (.remember c v w)
          (.read c w v)
          (return v)))
      (case [tagCustom]
        (let [ops (.Load64 m w)
              id (.CString m (.Load64 m ops))]
          (switch id
            (case ["_i"] (return (conv int32 (.Load32 m (+ w 8)))))
            (case ["_j"] (return (conv int64 (.Load64 m (+ w 8)))))
            (case ["_n"] (return (conv oi/Nativeint (.Load64 m (+ w 8)))))
            (case ["_bigarr02"]
              (let [nd (conv int (.Load64 m (+ w 16)))
                    flags (conv int (.Load64 m (+ w 24)))
                    dims (make (slice int) nd)
                    n 1]
                (for [i 0] (< i nd) (inc! i)
                  (aset dims i (conv int (.Load64 m (+ w (conv uint64 (+ 40 (* 8 i)))))))
                  (set! n (* n (aget dims i))))
                (let [v (oi/NewBigarray (bit-and flags 0xff) (bit-and (>> flags 8) 1) dims (make (slice oi/Value) n))]
                  (.remember c v w)
                  (.read c w v)
                  ;; (queue 523) memory the collector manages (CAML_BA_MANAGED: caml_ba_alloc's own or given), sampled by Gc.Memprof
                  ;; as the C runtime's caml_ba_alloc does (caml_alloc_custom_mem); an external array's is not
                  (when (== (bit-and flags 0x600) 0x200)
                    (oi/MemprofCustom (.-th c) v)
                    (when (!= MajorCycle nil)
                      (when (== managedNew nil)
                        (set! managedNew (lit (map any bool))))
                      (aset managedNew (conv any v) true))
                    (when (== (.-cdata c) nil)
                      (set! (.-cdata c) (lit (map any uint64))))
                    (aset (.-cdata c) (conv any v) (.Load64 m (+ w 8))))
                  (return v)))))
          (let [v (addr (lit oi/Custom :Name id :V (addr (lit CBlock :Addr w))))]
            (if (!= (.Load64 m (+ ops 8)) 0)
              (.finalisable c w v)
              (aset (.-statics c) w v))
            (return v))))
      (case [tagClosure]
        ;; a copy of an earlier call (queue 530: a C thread's callback of a closure given before): its index, while it lives
        (let [i (>> (.Load64 m w) 1)]
          (when (< i (conv uint64 (len (.-closures c))))
            (when [v (.Value (aget (.-closures c) i))] (!= v nil)
              (return v))))
        (oi/Internalf "a C stub returned a closure oi did not give it")))
    (let [b (addr (lit oi/Block :Tag tag :F (make (slice oi/Value) wosize)))]
      (when (>= tag tagAbstract)
        (oi/Internalf "a C stub's block of tag %d" tag))
      (.remember c b w)
      (.read c w b)
      b)))

(go/method read "read reads the copy at a into its value v (the C may have stored into it).\n" [^{:tag (* capi)} c ^uint64 a ^oi/Value v]
  (let [m (.-m c)]
    (type-switch [x v]
      (case [(* oi/Block)]
        (range [i _ (.-F x)]
          (aset (.-F x) i (.decode c (.Load64 m (+ a (conv uint64 (* 8 i))))))))
      (case [(* oi/Bytes)]
        (when (> (len (.-B x)) 0)
          (copy (.-B x) (.R m a (conv uint64 (len (.-B x)))))))
      (case [(* oi/FloatArray)]
        (range [i _ (.-F x)]
          (aset (.-F x) i (.LoadF64 m (+ a (conv uint64 (* 8 i)))))))
      (case [(* oi/Custom)]
        (when [(values kind _ _ data ok) (oi/BigarrayParts v)] ok
          (let [d (.Load64 m (+ a 8))
                es (elemSize kind)]
            (when [(values sn ok) (aget (.-snaps c) a)] (and ok (== (.-d sn) d) (== (len (.-b sn)) (* (len data) es))
                                                             (bytes/Equal (.-b sn) (.R m d (conv uint64 (* (len data) es)))))
              (return))
            (loadElems m kind d es data)))))))

(go/method toCAll "toCAll brings every copy of the call up to date with its value (after a callback: OCaml may have stored into one).\n"
  [^{:tag (* capi)} c]
  (inc! (.-pass c))
  (for [i 0] (< i (len (.-order c))) (inc! i)
    (let [a (aget (.-order c) i)]
      (when (!= (aget (.-seen c) a) (.-pass c))
        (aset (.-seen c) a (.-pass c))
        (.write c a (aget (.-toGo c) a)))))
  (range [name slot (.-named c)]
    (when [(values v ok) (namedValue name)] ok
      (.Store64 (.-m c) slot (.encode c v)))))

(go/method fromCAll "fromCAll reads every copy of the call into its value (the C returned, raised or calls back).\n" [^{:tag (* capi)} c]
  (inc! (.-pass c))
  (for [i 0] (< i (len (.-order c))) (inc! i)
    (let [a (aget (.-order c) i)]
      (when (!= (aget (.-seen c) a) (.-pass c))
        (aset (.-seen c) a (.-pass c))
        (.read c a (aget (.-toGo c) a))))))

;; ---- calls ----

(go/method external "external is the call of the stubs' function name with nargs arguments, nil when they define none: up to five\nthe words themselves, more an array and its length (the bytecode's convention, as ocamlc calls an external's first name).\n"
  ^oi/Ext [^{:tag (* capi)} c ^string name ^int nargs]
  (let [f (aget (.-ByName (.-p c)) name)]
    (when (or (== f nil) (== (.-Code f) nil))
      (return nil))
    (fn ^oi/Value [^{:tag (* oi/Thread)} th ^{:tag (slice oi/Value)} a]
      (.call c th f a))))

(go/method call "call calls the C function f with oi's arguments a on ci's main thread.\n"
  ^oi/Value [^{:tag (* capi)} c ^{:tag (* oi/Thread)} th ^{:tag (* ci/Func)} f ^{:tag (slice oi/Value)} a]
  (let [parked (.enter c)
        t (.-Main (.-p c))
        sp (.-SP t)
        top (.-Top t)
        depth (.-Depth t)
        prev (.-th c)]
    (set! (.-th c) th)
    (inc! (.-depth c))
    (when (== (.-depth c) 1)
      (.toCAll c))
    (defer ((fn []
              (let [r (recover)]
                (set! (.-SP t) sp)
                (set! (.-Top t) top)
                (set! (.-Depth t) depth)
                (dec! (.-depth c))
                (when (== (.-depth c) 0)
                  (.reset c))
                (set! (.-th c) prev)
                (when (or parked (== (.-depth c) 0))
                  (.leave c))
                (when (!= r nil)
                  (when [(values flt ok) (assert (* crt/Fault) r)] ok
                    (oi/Internalf "a C stub's fault: %s at %#x" (.-Msg flt) (.-Addr flt)))
                  (when [(values ex ok) (assert (* crt/Exit) r)] ok
                    (panic (addr (lit oi/ExitSignal :Code (.-Code ex)))))
                  (panic r))))))
    (inc! (.-pass c))
    (let [^{:tag (slice ci/Arg)} args (zero (slice ci/Arg))]
      (if (<= (len a) 5)
        (range [_ v a]
          (set! args (append args (lit ci/Arg :K \i :I (conv int64 (.encode c v))))))
        (let [ws (make (slice uint64) (len a))]
          (range [i v a]
            (aset ws i (.encode c v)))
          (let [arr (.alloc c (conv uint64 (len a)) 0)]
            (range [i w ws]
              (.Store64 (.-m c) (+ arr (conv uint64 (* 8 i))) w))
            (set! args (lit (slice ci/Arg) (lit ci/Arg :K \i :I (conv int64 arr)) (lit ci/Arg :K \i :I (conv int64 (len a))))))))
      (let [r (.Call (.-p c) t f args)]
        (.fromCAll c)
        (.result c r)))))

(go/method result "result is a stub's result word as oi's value. A stub of C's void type (lib-runtime-events/test's start_runtime_events,
an external of type unit -> unit) leaves its result undefined, which OCaml's caller of a unit result never reads: ci's 0 is ()
here, not a null pointer (queue 478).
"
  ^oi/Value [^{:tag (* capi)} c ^ci/Arg r]
  (when (== (.-I r) 0)
    (return oi/Unit))
  (.decode c (conv uint64 (.-I r))))

(go/method callRaw "callRaw is call with the representations reprs (CallRaw's): a value encoded, an unboxed or untagged argument as\nitself, the result likewise.\n"
  ^oi/Value [^{:tag (* capi)} c ^{:tag (* ci/Func)} f ^string reprs ^{:tag (slice oi/Value)} a]
  (let [parked (.enter c)
        t (.-Main (.-p c))
        sp (.-SP t)
        top (.-Top t)
        depth (.-Depth t)]
    (inc! (.-depth c))
    (when (== (.-depth c) 1)
      (.toCAll c))
    (defer ((fn []
              (let [r (recover)]
                (set! (.-SP t) sp)
                (set! (.-Top t) top)
                (set! (.-Depth t) depth)
                (dec! (.-depth c))
                (when (== (.-depth c) 0)
                  (.reset c))
                (when (or parked (== (.-depth c) 0))
                  (.leave c))
                (when (!= r nil)
                  (when [(values flt ok) (assert (* crt/Fault) r)] ok
                    (oi/Internalf "a C stub's fault: %s at %#x" (.-Msg flt) (.-Addr flt)))
                  (when [(values ex ok) (assert (* crt/Exit) r)] ok
                    (panic (addr (lit oi/ExitSignal :Code (.-Code ex)))))
                  (panic r))))))
    (inc! (.-pass c))
    (let [args (make (slice ci/Arg) (len a))]
      (range [i v a]
        (switch (aget reprs i)
          (case [\F] (aset args i (lit ci/Arg :K \f :F (oi/AsFloat v))))
          (case [\I] (aset args i (lit ci/Arg :K \i :I (assert int64 v))))
          (case [\n] (aset args i (lit ci/Arg :K \i :I (conv int64 (assert oi/Nativeint v)))))
          (case [\i] (aset args i (lit ci/Arg :K \i :I (conv int64 (assert int32 v)))))
          (case [\t] (aset args i (lit ci/Arg :K \i :I (conv int64 (oi/AsInt v)))))
          (default (aset args i (lit ci/Arg :K \i :I (conv int64 (.encode c v)))))))
      (let [r (.Call (.-p c) t f args)]
        (.fromCAll c)
        (switch (aget reprs (len a))
          (case [\F] (return (.-F r)))
          (case [\I] (return (.-I r)))
          (case [\n] (return (conv oi/Nativeint (.-I r))))
          (case [\i] (return (conv int32 (.-I r))))
          (case [\t] (return (conv int (.-I r)))))
        (.result c r)))))

(go/method callback "callback is caml_callbackN_exn: the closure applied to the n arguments at args on oi's thread; the result, or\nthe exception raised marked as caml_callback_exn marks it.\n"
  ^uint64 [^{:tag (* capi)} c ^{:tag (* ci/Thread)} t ^uint64 clos ^int n ^uint64 args]
  (.fromCAll c)
  (let [f (.decode c clos)
        vs (make (slice oi/Value) n)]
    (for [i 0] (< i n) (inc! i)
      (aset vs i (.decode c (.Load64 (.-m c) (+ args (conv uint64 (* 8 i)))))))
    (let [^oi/Value r nil
          ^oi/Value exn nil]
      (if (or (== t nil) (== t (.-Main (.-p c))))
        (set! (values r exn) (.apply c f vs))
        ;; a C thread's callback (queue 530): OCaml's code runs off the baton, so the C's other threads and oi's stubs run meanwhile
        (.offBaton c (fn [] (set! (values r exn) (.apply c f vs)))))
      (.toCAll c)
      (when (!= exn nil)
        (return (bit-or (.encode c exn) 2)))
      (.encode c r))))

(go/method apply "apply applies f to vs; exn is the OCaml exception it raised, else nil.\n"
  [^{:tag (* capi)} c ^oi/Value f ^{:tag (slice oi/Value)} vs] :results [^oi/Value r ^oi/Value exn]
  (defer ((fn []
            (when [x (recover)] (!= x nil)
              (when [(values e ok) (assert (* oi/Exn) x)] ok
                (set! exn (.-V e))
                (return))
              (panic x)))))
  (when (!= Apply nil)
    (return (Apply f vs)))
  (set! r (.ApplyCallback (.-th c) f vs))
  (return r nil))

(go/method predef "predef is the predefined exception of fail.h's index i.\n" ^oi/Value [^{:tag (* capi)} c ^int i]
  (aget (lit (slice oi/Value) oi/ExnOutOfMemory oi/ExnSysError oi/ExnFailure oi/ExnInvalidArgument oi/ExnEndOfFile
          oi/ExnDivisionByZero oi/ExnNotFound oi/ExnMatchFailure oi/ExnStackOverflow oi/ExnSysBlockedIO oi/ExnAssertFailure
          oi/ExnUndefinedRecursiveModule) i))

(go/method natives "natives are the functions runtime.c declares and oi gives, by name.\n"
  ^{:tag (map string (func [(* ci/Thread) (slice ci/Arg)] [ci/Arg]))} [^{:tag (* capi)} c]
  (let [ai (fn ^ci/Arg [^uint64 v] (lit ci/Arg :K \i :I (conv int64 v)))
        arg (fn ^uint64 [^{:tag (slice ci/Arg)} a ^int i]
              (when (>= i (len a))
                (return 0))
              (conv uint64 (.-I (aget a i))))]
    (lit (map string (func [(* ci/Thread) (slice ci/Arg)] [ci/Arg]))
      ["__oi_alloc" (fn ^ci/Arg [^{:tag (* ci/Thread)} _ ^{:tag (slice ci/Arg)} a]
                      (when (== (.-depth c) 0)
                        (return (ai (.allocStatic c (arg a 0) (conv int (arg a 1))))))
                      ;; a stub's allocation counted by oi (queue 523: Gc's words, the simulated heaps' collections)
                      (cAlloc (conv int (arg a 0)))
                      (ai (.alloc c (arg a 0) (conv int (arg a 1)))))]
      ["__oi_alloc_static" (fn ^ci/Arg [^{:tag (* ci/Thread)} _ ^{:tag (slice ci/Arg)} a]
                             (when (> (.-depth c) 0)
                               (cAlloc (conv int (arg a 0))))
                             (ai (.allocStatic c (arg a 0) (conv int (arg a 1)))))]
      ["__oi_gc_count" (fn ^ci/Arg [^{:tag (* ci/Thread)} _ ^{:tag (slice ci/Arg)} a]
                         (ai (conv uint64 (oi/GcCount (conv int (arg a 0))))))]
      ["__oi_gc_request_minor" (fn ^ci/Arg [^{:tag (* ci/Thread)} _ ^{:tag (slice ci/Arg)} a]
                                 (oi/GcRequestMinor)
                                 (ai 0))]
      ["__oi_root" (fn ^ci/Arg [^{:tag (* ci/Thread)} _ ^{:tag (slice ci/Arg)} a]
                     (.root c (arg a 0) (conv int (conv int32 (arg a 1))))
                     (ai 0))]
      ["__oi_predef" (fn ^ci/Arg [^{:tag (* ci/Thread)} _ ^{:tag (slice ci/Arg)} a]
                       (ai (.encode c (.predef c (conv int (arg a 0))))))]
      ["caml_callbackN_exn" (fn ^ci/Arg [^{:tag (* ci/Thread)} t ^{:tag (slice ci/Arg)} a]
                              (ai (.callback c t (arg a 0) (conv int (conv int32 (arg a 1))) (arg a 2))))]
      ;; the C's threads (queue 530, threads.go)
      ["__oi_thread_register" (fn ^ci/Arg [^{:tag (* ci/Thread)} t ^{:tag (slice ci/Arg)} a]
                                (ai (conv uint64 (.register c t (conv int (conv int64 (arg a 0)))))))]
      ["__oi_thread_unregister" (fn ^ci/Arg [^{:tag (* ci/Thread)} t ^{:tag (slice ci/Arg)} a] (ai (conv uint64 (.unregister c t))))]
      ["__oi_thread_acquire" (fn ^ci/Arg [^{:tag (* ci/Thread)} t ^{:tag (slice ci/Arg)} a] (ai (conv uint64 (.acquire c t))))]
      ["__oi_thread_release" (fn ^ci/Arg [^{:tag (* ci/Thread)} t ^{:tag (slice ci/Arg)} a] (ai (conv uint64 (.release c t))))]
      ;; a C program that embeds OCaml (queue 539): runtime.c's caml_main and caml_startup, the OCaml program's initialisation (Embed)
      ["__oi_caml_main" (fn ^ci/Arg [^{:tag (* ci/Thread)} _ ^{:tag (slice ci/Arg)} a]
                          (when (!= (.-start c) nil)
                            ((.-start c)))
                          (ai 0))]
      ["caml_raise" (fn ^ci/Arg [^{:tag (* ci/Thread)} _ ^{:tag (slice ci/Arg)} a]
                      (.fromCAll c)
                      (oi/Raise (.decode c (arg a 0)))
                      (lit ci/Arg))]
      ["caml_named_value" (fn ^ci/Arg [^{:tag (* ci/Thread)} _ ^{:tag (slice ci/Arg)} a]
                            (let [name (.CString (.-m c) (arg a 0))
                                  (values v ok) (namedValue name)]
                              (when (not ok)
                                (return (ai 0)))
                              (let [slot (aget (.-named c) name)]
                                (when (== slot 0)
                                  (set! slot (.allocStatic c 1 tagAbstract))
                                  (aset (.-named c) name slot))
                                (.Store64 (.-m c) slot (.encode c v))
                                (ai slot))))]
      ["caml_output_value_to_block" (fn ^ci/Arg [^{:tag (* ci/Thread)} _ ^{:tag (slice ci/Arg)} a]
                                      (.fromCAll c)
                                      (let [b (oi/MarshalValue (.decode c (arg a 0)) (.decode c (arg a 1)))
                                            n (arg a 3)]
                                        (when (> (conv uint64 (len b)) n)
                                          (oi/Failwith "Marshal.to_buffer: buffer overflow"))
                                        (copy (.W (.-m c) (arg a 2) (conv uint64 (len b))) b)
                                        (ai (conv uint64 (len b)))))]
      ;; the C consumer of runtime events (runtime_events_consumer.h) over oi's ring (ext_runtime_events.go)
      ;; (queue 583) at the AOT levels the runtime's ring (RuntimeEvents), whose collections the program's events are
      ["__oi_re_control" (fn ^ci/Arg [^{:tag (* ci/Thread)} _ ^{:tag (slice ci/Arg)} a]
                           (when (!= RuntimeEvents nil)
                             (return (ai (conv uint64 (aget (RuntimeEvents 0 "" (lit (slice int64) (conv int64 (conv int (arg a 0))))) 0)))))
                           (ai (conv uint64 (oi/RuntimeEventsControl (conv int (arg a 0))))))]
      ["__oi_re_cursor" (fn ^ci/Arg [^{:tag (* ci/Thread)} _ ^{:tag (slice ci/Arg)} a]
                          (let [p (arg a 0)
                                pid (conv int (conv int32 (arg a 1)))
                                dir "."]
                            (when (!= p 0)
                              (set! dir (.CString (.-m c) p)))
                            (when (!= RuntimeEvents nil)
                              (let [own 0]
                                (when (and (== p 0) (< pid 0)) (set! own 1))
                                (return (ai (conv uint64 (aget (RuntimeEvents 1 dir (lit (slice int64) (conv int64 own) (conv int64 pid))) 0))))))
                            (ai (conv uint64 (conv int64 (oi/RuntimeEventsCursor (and (== p 0) (< pid 0)) dir pid))))))]
      ["__oi_re_next" (fn ^ci/Arg [^{:tag (* ci/Thread)} _ ^{:tag (slice ci/Arg)} a]
                        (let [(values st next kind dom ts id data) (reNext (conv int (conv int64 (arg a 0))))
                              out (arg a 1)]
                          (range [i w (lit (slice int64) (conv int64 next) (conv int64 kind) (conv int64 dom) ts (conv int64 id) data)]
                            (.Store64 (.-m c) (+ out (conv uint64 (* 8 i))) (conv uint64 w)))
                          (ai (conv uint64 (conv int64 st)))))]
      ["caml_input_value_from_block" (fn ^ci/Arg [^{:tag (* ci/Thread)} _ ^{:tag (slice ci/Arg)} a]
                                       (let [b (append (lit (slice byte)) (spread (.R (.-m c) (arg a 0) (arg a 1))))
                                             (values v _) (oi/UnmarshalValue b 0)]
                                         (ai (.encode c v))))])))

;; ---- the global roots (queue 516, DECISION 511-3 (a); memory.h's caml_register_global_root and the generational ones) ----

(go/method rehome "rehome is the word w a root holds, kept past the outermost call: an integer, a static block or a live finalisable custom
block as it is; a copy in the boundary's memory a block of the static memory with its header and contents (a scanned block's fields
rehomed in turn), oi's value of the copy its value (statics), one a value. Divergences: a root changed by plain assignment in a later
call than its registration is not rehomed (only the registering and the generational modify mark it); the static copies stay for the
run.\n" ^uint64 [^{:tag (* capi)} c ^uint64 w]
  (when (or (== w 0) (== (bit-and w 1) 1))
    (return w))
  (when [(values _ ok) (aget (.-statics c) w)] ok
    (return w))
  (when (!= (.weakStatic c w) nil)
    (return w))
  (let [v (.decode c w)]
    (when [(values h ok) (aget (.-homes c) (conv any v))] ok
      (return h))
    (let [m (.-m c)
          hd (.Load64 m (- w 8))
          wosize (>> hd 10)
          tag (conv int (bit-and hd 0xff))
          h (.allocStatic c wosize tag)]
      (aset (.-homes c) (conv any v) h)
      (aset (.-statics c) h v)
      (if (< tag tagAbstract)
        (for [i (conv uint64 0)] (< i wosize) (inc! i)
          (.Store64 m (+ h (* 8 i)) (.rehome c (.Load64 m (+ w (* 8 i))))))
        (when (> wosize 0)
          (copy (.W m h (* 8 wosize)) (.R m w (* 8 wosize)))))
      h)))

(go/method root "root is __oi_root: op 1 registers the cell r, 0 removes it, 2 notes its modification; registered or modified, it is rehomed
when the outermost call ends.\n" [^{:tag (* capi)} c ^uint64 r ^int op]
  (switch op
    (case [0] (delete (.-roots c) r))
    (case [1]
      (aset (.-roots c) r true)
      (set! (.-dirty c) (append (.-dirty c) r)))
    (default
      (when (aget (.-roots c) r)
        (set! (.-dirty c) (append (.-dirty c) r))))))

;; ---- custom blocks' finalization (queue 516, DECISION 511-3 (a); custom.h's finalize) ----

(go/method weakStatic "weakStatic is the live value of the finalisable custom block at w, nil when there is none.\n" ^oi/Value [^{:tag (* capi)} c ^uint64 w]
  (.Lock (.-finMu c))
  (defer (.Unlock (.-finMu c)))
  (when [(values p ok) (aget (.-wstatics c) w)] ok
    (when [x (.Value p)] (!= x nil)
      (return x)))
  nil)

(go/method finalisable "finalisable holds v, the value of the custom block at w whose operations have a finalize, weakly: once v is unreachable
the block's finalize runs (oi.CFinaliser: at the next collection the program asks for), as the C runtime's sweep calls it.\n" [^{:tag (* capi)} c ^uint64 w ^{:tag (* oi/Custom)} v]
  (.Lock (.-finMu c))
  (aset (.-wstatics c) w (^{:inst [oi/Custom]} weak/Make v))
  (.Unlock (.-finMu c))
  ;; (queue 523) a block that crosses again is alive again: not finalized by an earlier news (Collected's later)
  (when (> (len (.-later c)) 0)
    (let [^{:tag (slice uint64)} keep nil]
      (range [_ x (.-later c)]
        (when (!= x w)
          (set! keep (append keep x))))
      (set! (.-later c) keep)))
  ;; the AOT runtime's server (wireLoad set Apply): the value is the server's own copy, dead once the call returns; the runtime's
  ;; mirror of the block decides, and its collections send the dead ones' addresses (Collected, queue 523)
  (when (== Apply nil)
    (oi/CFinaliser v (fn [] (.finalise c w)))))

(go/func Collected "Collected is the AOT runtime's news of a collection it was asked for (wire.go's 'G', queue 523): the C's custom blocks at
addrs, whose mirrors the runtime found unreachable, finalized, those whose operations have a finalize (held in wstatics), each once, as
the C runtime's sweep calls a dead custom block's finalize. A block a registered global root still reaches (through the static copies
of the values it holds: regression/pr11865/mkroot's boxes, each holding the next one) is alive for the C runtime: it waits (later)
until a finalize removes that root, and is examined again at each such news; the blocks finalized in turn until none is freed.\n" [^{:tag (slice uint64)} addrs]
  (let [c the]
    (when (== c nil)
      (return))
    (let [^{:tag (slice uint64)} pending (.-later c)]
      (set! (.-later c) nil)
      (.Lock (.-finMu c))
      (range [_ w addrs]
        (when [(values _ ok) (aget (.-wstatics c) w)] ok
          (set! pending (append pending w))))
      (.Unlock (.-finMu c))
      (let [progress true]
        (while (and progress (> (len pending) 0))
          (set! progress false)
          (let [^{:tag (slice uint64)} rest nil
                reached (.rootsReach c)]
            (range [_ w pending]
              (if (aget reached w)
                (set! rest (append rest w))
                (do
                  (.Lock (.-finMu c))
                  (let [(values _ ok) (aget (.-wstatics c) w)]
                    (when ok
                      (delete (.-wstatics c) w))
                    (.Unlock (.-finMu c))
                    (when ok
                      (.ccall c "__oi_custom_finalize" w)
                      (set! progress true))))))
            (set! pending rest))))
      (set! (.-later c) pending))))

(go/method rootsReach "rootsReach is the words the registered global roots reach (queue 523): each root's word, and through a static copy of
a scanned block its fields, transitively.\n" ^{:tag (map uint64 bool)} [^{:tag (* capi)} c]
  (let [seen (lit (map uint64 bool))
        ^{:tag (slice uint64)} todo nil
        m (.-m c)]
    (range [r _ (.-roots c)]
      (set! todo (append todo (.Load64 m r))))
    (while (> (len todo) 0)
      (let [x (aget todo (- (len todo) 1))]
        (set! todo (subslice todo 0 (- (len todo) 1)))
        (when (and (!= x 0) (== (bit-and x 1) 0) (not (aget seen x)))
          (aset seen x true)
          (when [(values _ ok) (aget (.-statics c) x)] ok
            (let [hd (.Load64 m (- x 8))
                  wosize (>> hd 10)]
              (when (< (conv int (bit-and hd 0xff)) tagAbstract)
                (for [i (conv uint64 0)] (< i wosize) (inc! i)
                  (set! todo (append todo (.Load64 m (+ x (* 8 i))))))))))))
    seen))

(go/method finalise "finalise is the finalize of the custom block at w, its value collected: runtime.c's __oi_custom_finalize on ci's main thread.\n" [^{:tag (* capi)} c ^uint64 w]
  (.Lock (.-finMu c))
  (when [(values p ok) (aget (.-wstatics c) w)] ok
    (when (!= (.Value p) nil)
      ;; the address has a live value again (the C returned the block after its first value died): its own finaliser runs it
      (.Unlock (.-finMu c))
      (return))
    (delete (.-wstatics c) w))
  (.Unlock (.-finMu c))
  (.ccall c "__oi_custom_finalize" w))

;; ---- custom blocks' serialization (oi's Marshal: ext_capi.go's CustomSerialize, CustomDeserialize) ----

(go/method ccall "ccall calls runtime.c's helper name with integer arguments on ci's main thread, its state put back however it ends.\n"
  ^uint64 [^{:tag (* capi)} c ^string name & ^{:tag (slice uint64)} args]
  (let [f (aget (.-ByName (.-p c)) name)
        parked (.enter c)
        t (.-Main (.-p c))
        sp (.-SP t)
        top (.-Top t)
        depth (.-Depth t)
        as (make (slice ci/Arg) (len args))]
    (when (or (== f nil) (== (.-Code f) nil))
      (oi/Internalf "the C runtime has no %s" name))
    (defer ((fn []
              (set! (.-SP t) sp)
              (set! (.-Top t) top)
              (set! (.-Depth t) depth)
              (when parked
                (.leave c)))))
    (range [i a args]
      (aset as i (lit ci/Arg :K \i :I (conv int64 a))))
    (conv uint64 (.-I (.Call (.-p c) t f as)))))

(go/method serialize "serialize is a C custom block's bytes and sizes by its operations' serialize; ok false when it has none.\n"
  [^{:tag (* capi)} c ^{:tag (* oi/Custom)} x] :results [(slice byte) uint64 uint64 bool]
  (let [(values cb ok) (assert (* CBlock) (.-V x))]
    (when (not ok)
      (return nil 0 0 false))
    (let [n (conv int64 (.ccall c "__oi_custom_serialize" (.-Addr cb) (.-scratch c)))]
      (when (< n 0)
        (return nil 0 0 false))
      (let [data (make (slice byte) n)]
        (when (> n 0)
          (copy data (.R (.-m c) (.ccall c "__oi_custom_buffer") (conv uint64 n))))
        (return data (.Load64 (.-m c) (.-scratch c)) (.Load64 (.-m c) (+ (.-scratch c) 8)) true)))))

(go/method staticBytes "staticBytes is b copied into the static memory, NUL-terminated: its address.\n" ^uint64 [^{:tag (* capi)} c ^{:tag (slice byte)} b]
  (let [a (.allocStatic c (conv uint64 (+ (/ (len b) 8) 1)) tagAbstract)]
    (when (> (len b) 0)
      (copy (.W (.-m c) a (conv uint64 (len b))) b))
    a))

(go/method deserialize "deserialize is a custom block of the operations the C registered under name, read from data by their deserialize\n(expected bytes reserved for it): the block, the size deserialize returned, the bytes it read; ok false when none is registered.\n"
  [^{:tag (* capi)} c ^string name ^{:tag (slice byte)} data ^uint64 expected] :results [oi/Value int int bool]
  (let [na (.staticBytes c (conv (slice byte) name))
        da (.staticBytes c data)
        r (.ccall c "__oi_custom_deserialize" na da expected (.-scratch c))]
    (when (== r 0)
      (return nil 0 0 false))
    (return (.decode c r) (conv int (.Load64 (.-m c) (.-scratch c))) (conv int (.Load64 (.-m c) (+ (.-scratch c) 8))) true)))

(go/method hostNatives "hostNatives are musl's functions the stubs call that act on the process itself: getpid, kill and raise, fstat and\nclose, as the host's\n(a stub's kill of Unix.getpid's pid, a raise, reach the signal handlers oi installed).\n"
  ^{:tag (map string (func [(* ci/Thread) (slice ci/Arg)] [ci/Arg]))} [^{:tag (* capi)} c]
  (let [res (fn ^ci/Arg [^error err]
              (when (!= err nil)
                (return (lit ci/Arg :K \i :I -1)))
              (lit ci/Arg :K \i :I 0))]
    (lit (map string (func [(* ci/Thread) (slice ci/Arg)] [ci/Arg]))
      ["getpid" (fn ^ci/Arg [^{:tag (* ci/Thread)} _ ^{:tag (slice ci/Arg)} a] (lit ci/Arg :K \i :I (conv int64 (pid))))]
      ["kill" (fn ^ci/Arg [^{:tag (* ci/Thread)} _ ^{:tag (slice ci/Arg)} a]
                (res (signal (conv int (conv int32 (.-I (aget a 0)))) (conv int (conv int32 (.-I (aget a 1)))))))]
      ["raise" (fn ^ci/Arg [^{:tag (* ci/Thread)} _ ^{:tag (slice ci/Arg)} a]
                 (res (signal (pid) (conv int (conv int32 (.-I (aget a 0)))))))]
      ;; the process's descriptors (OC201 (a)): a stub's fstat and close of a descriptor are the host's, as OCaml's Unix.file_descr
      ;; oi gives it is (ci's own table, crt's, holds the standard streams alone); errno set as musl's wrapper sets it
      ["fstat" (fn ^ci/Arg [^{:tag (* ci/Thread)} t ^{:tag (slice ci/Arg)} a]
                 (let [^syscall/Stat_t st (zero syscall/Stat_t)]
                   (when [err (syscall/Fstat (conv int (conv int32 (.-I (aget a 0)))) (addr st))] (!= err nil)
                     (return (.failErrno c t err)))
                   (let [m (.-m c)
                         b (conv uint64 (.-I (aget a 1)))]
                     (.Store64 m b (.-Dev st)) (.Store64 m (+ b 8) (.-Ino st)) (.Store64 m (+ b 16) (conv uint64 (.-Nlink st)))
                     (.Store32 m (+ b 24) (.-Mode st)) (.Store32 m (+ b 28) (.-Uid st)) (.Store32 m (+ b 32) (.-Gid st)) (.Store32 m (+ b 36) 0)
                     (.Store64 m (+ b 40) (.-Rdev st)) (.Store64 m (+ b 48) (conv uint64 (.-Size st)))
                     (.Store64 m (+ b 56) (conv uint64 (.-Blksize st))) (.Store64 m (+ b 64) (conv uint64 (.-Blocks st)))
                     (.Store64 m (+ b 72) (conv uint64 (.-Sec (.-Atim st)))) (.Store64 m (+ b 80) (conv uint64 (.-Nsec (.-Atim st))))
                     (.Store64 m (+ b 88) (conv uint64 (.-Sec (.-Mtim st)))) (.Store64 m (+ b 96) (conv uint64 (.-Nsec (.-Mtim st))))
                     (.Store64 m (+ b 104) (conv uint64 (.-Sec (.-Ctim st)))) (.Store64 m (+ b 112) (conv uint64 (.-Nsec (.-Ctim st))))
                     (lit ci/Arg :K \i :I 0))))]
      ["close" (fn ^ci/Arg [^{:tag (* ci/Thread)} t ^{:tag (slice ci/Arg)} a]
                 (when [err (syscall/Close (conv int (conv int32 (.-I (aget a 0)))))] (!= err nil)
                   (return (.failErrno c t err)))
                 (lit ci/Arg :K \i :I 0))]
      ;; (2026-11-24, ocaml-eval) musl's memcpy, memmove and memset on ci's memory in one move, as the machine's: their C, interpreted
      ;; a byte or a word a turn, was most of lib-bigarray/subarraystub's stub (2,046 memcpy a call, 41,000 calls)
      ["memcpy" (fn ^ci/Arg [^{:tag (* ci/Thread)} _ ^{:tag (slice ci/Arg)} a]
                  (.Move (.-m c) (conv uint64 (.-I (aget a 0))) (conv uint64 (.-I (aget a 1))) (conv uint64 (.-I (aget a 2))))
                  (aget a 0))]
      ["memmove" (fn ^ci/Arg [^{:tag (* ci/Thread)} _ ^{:tag (slice ci/Arg)} a]
                   (.Move (.-m c) (conv uint64 (.-I (aget a 0))) (conv uint64 (.-I (aget a 1))) (conv uint64 (.-I (aget a 2))))
                   (aget a 0))]
      ["memset" (fn ^ci/Arg [^{:tag (* ci/Thread)} _ ^{:tag (slice ci/Arg)} a]
                  (.Fill (.-m c) (conv uint64 (.-I (aget a 0))) (conv byte (.-I (aget a 1))) (conv uint64 (.-I (aget a 2))))
                  (aget a 0))])))

(go/method failErrno "failErrno is a host native's failure as musl's wrappers return one: errno (its thread's, __errno_location's) set\nto err's number, -1.\n"
  ^ci/Arg [^{:tag (* capi)} c ^{:tag (* ci/Thread)} t ^error err]
  (let [n (conv uint32 22)]
    (when [(values e ok) (assert syscall/Errno err)] ok
      (set! n (conv uint32 e)))
    (when [f (aget (.-ByName (.-p c)) "__errno_location")] (and (!= f nil) (!= (.-Code f) nil))
      (.Store32 (.-m c) (conv uint64 (.-I (.Call (.-p c) t f nil))) n))
    (lit ci/Arg :K \i :I -1)))

;; The C API's wire form (OC215 (a), the user 2026-11-10; doc/ocaml/OCAML-SURVEY.md, "As built: OC215", "As built: queue 413"): the
;; AOT runtime's end of a test's C stubs. The Java runtime (jdk/ocaml/ocaml/rt/CApi.ae) sends a message and reads the reply; Handle is
;; the reply to one message. Its servers: the compiled level's main (test/ocaml/o2j/capi's capi.go, the file capiPath its host serves)
;; and, for the light level (stage 0's interpreter, which no main of ours serves), the driver's `oi capi` (test/ocaml/oi/cmd), a process
;; the runtime spawns and speaks to over its standard streams. The program's values cross as mirrors, oi's values (a Block, Bytes, a
;; FloatArray, a bigarray, a Closure or an opaque Custom standing for a Java object), and the boundary copies the mirrors into ci's
;; memory as it copies oi's. The C runs on a goroutine of its own (a worker), so that a callback or a named value the C asks for is a
;; reply to the runtime ('K', 'Q'), which answers with its next message ('A'); the runtime drives and Go never calls into the
;; translated code. Nested calls (a callback calling a stub) push a worker.
;;
;; The wire form of a value (big-endian): 'i' i64 an integer; 'd' f64 a float; 'l' i32 an int32; 'j' i64 an int64; 'n' i64 a nativeint;
;; 'r' u32 a node already known (the session's id); a new node, given the next id before its contents: 'b' u32 tag, u32 n, n values (a
;; block); 's' u32 n, n bytes; 'f' u32 n, n f64 (a float array); 'B' u32 kind, u32 layout, u32 nd, nd u32 dims, u32 n, n values (a
;; bigarray's elements); 'k' u32 a closure's handle (queue 530: one a closure for the run, the runtime's); 'h' another Java object; and, no node: 'c' u32 len, the identifier, u64 the address (a custom
;; block the C allocated, kept for the run); 'p' u32 i (Go to Java: fail.h's predefined exception i). A session is an outermost call:
;; the ids of both sides start again with it. The updates: u32 count, then the contents of each node of id below it in order (a
;; block's fields, a string's bytes, a float array's floats, a bigarray's elements; nothing for the others): the node's state as the
;; sender holds it when it writes (the C, OCaml's code or a callback may have stored into it).
;;
;; Ops, Java to Go: 'C' str name, str reprs, u32 n, n values (call the stub name; reprs "" a bytecode external's call, else the
;; native one's representations, CallRaw: OC199 (a)); 'A' then the answer: 'R' value, 'E' value (the exception the callback raised),
;; 'N' (no such named value), 'T' (a Java throwable the runtime keeps; the C call unwinds). Go to Java: 'R' value (the stub's result),
;; 'E' value (it raised), 'X' i32 (the C called exit), 'F' str (a fatal error), 'N' (no stub of that name, or no stubs: OI_CSTUBS
;; unset), 'T' (the call unwound for the runtime's throwable), 'K' value, u32 n, n values (a callback: apply the closure), 'Q' str
;; (caml_named_value); (queue 583) 'V' u32 op, str s, u32 n, n i64 (the C consumer of runtime events on the runtime's ring: RuntimeEvents),
;; answered 'R' a block of integers; (oc-tail) 'M' (a major cycle the stubs' allocations ended: MajorCycle), answered 'R' unit; 'G' u32 n, n u64 (queue 523: the C's custom blocks an asked collection found unreachable, at no call's depth),
;; answered 'N' once their finalize ran; (queue 527, Marshal of the C's custom blocks: extern_custom and intern's CODE_CUSTOM_LEN, as
;; ocamlopt's runtime calls the operations') 'S' u64 the address (its operations' serialize: 'R', no updates, u32 n, n bytes, u64 the
;; 32-bit size, u64 the 64-bit size), 'D' str the identifier, str the data from the identifier's sizes to the message's end, u64 the
;; size expected (the registered operations' deserialize: 'R', no updates, the block, u64 the size deserialize returned, u64 the bytes
;; it read), each answered 'N' when there are none, 'E' value when the C raised, 'F' str at a fault; at any depth, as an answer is (a
;; callback may marshal). The servers frame the messages (capi.go: a write a message, its reply u32 its length then it).
(in-ns 'go.arbace.oicapi)

(go/file "wire.go" :imports [[binary "encoding/binary"] [fmt "fmt"] [math "math"] [os "os"] [sync "sync"] [oi "arbace/oi"]])

;; ---- the session: the mirrors' ids, the workers

(go/type session "session is an outermost call's state: its nodes by id and back, its workers (the innermost last).\n"
  (struct ^{:tag (slice oi/Value)} nodes ^{:tag (map any int)} ids ^{:tag (slice (* worker))} workers))

(go/var ^{:tag (* session)} sess)

;; (queue 530) the closures that crossed, one mirror a handle for the run: the runtime gives each of its closures a handle at its first
;; crossing ('k' u32), so a closure the C keeps past the outermost call (a root, a C thread's) is the same mirror in a later session and
;; goes back to the runtime as its handle
(go/var ^{:tag (map int (* oi/Closure))} closureMirrors (make (map int (* oi/Closure))))
(go/var ^{:tag (map (* oi/Closure) int)} closureHandles (make (map (* oi/Closure) int)))
(go/var ^bool loaded)
(go/var ^string loadErr)

(go/type worker "worker is a C call on a goroutine of its own: in brings the runtime's answers, out its requests and its end.\n"
  (struct ^{:tag (chan (slice byte))} in ^{:tag (chan (slice byte))} out))

(go/type unwind "unwind is the panic that unwinds a C call for a throwable the runtime keeps (an answer 'T').\n" (struct))

(go/func wireLoad "wireLoad loads the stubs' node program (OI_CSTUBS) once; false when there is none.\n" ^bool []
  (when (not loaded)
    (set! loaded true)
    (let [path (os/Getenv "OI_CSTUBS")]
      (when (== path "")
        (set! loadErr "no C stubs (OI_CSTUBS)")
        (return false))
      (when [err (Load path os/Args)] (!= err nil)
        (set! loadErr (.Error err))
        (return false))
      (set! Apply wireApply)
      (set! Named wireNamed)
      (set! RuntimeEvents wireRuntimeEvents)
      (set! MajorCycle wireMajorCycle)))
  (== loadErr ""))

;; ---- the wire form

(go/type wbuf "wbuf is a message being written.\n" (struct ^{:tag (slice byte)} b))

(go/method u8 [^{:tag (* wbuf)} w ^byte x] (set! (.-b w) (append (.-b w) x)))
(go/method u32 [^{:tag (* wbuf)} w ^int x] (set! (.-b w) (.AppendUint32 binary/BigEndian (.-b w) (conv uint32 x))))
(go/method u64 [^{:tag (* wbuf)} w ^uint64 x] (set! (.-b w) (.AppendUint64 binary/BigEndian (.-b w) x)))
(go/method str [^{:tag (* wbuf)} w ^string s]
  (.u32 w (len s))
  (set! (.-b w) (append (.-b w) (spread s))))

(go/type rbuf "rbuf is a message being read.\n" (struct ^{:tag (slice byte)} b ^int i))

(go/method u8 ^byte [^{:tag (* rbuf)} r]
  (let [x (aget (.-b r) (.-i r))]
    (inc! (.-i r))
    x))
(go/method u32 ^int [^{:tag (* rbuf)} r]
  (let [x (.Uint32 binary/BigEndian (subslice (.-b r) (.-i r)))]
    (set! (.-i r) (+ (.-i r) 4))
    (conv int x)))
(go/method u64 ^uint64 [^{:tag (* rbuf)} r]
  (let [x (.Uint64 binary/BigEndian (subslice (.-b r) (.-i r)))]
    (set! (.-i r) (+ (.-i r) 8))
    x))
(go/method str ^string [^{:tag (* rbuf)} r]
  (let [n (.u32 r)
        s (conv string (subslice (.-b r) (.-i r) (+ (.-i r) n)))]
    (set! (.-i r) (+ (.-i r) n))
    s))

(go/method add "add gives the node v the next id.\n" [^{:tag (* session)} s ^oi/Value v]
  (aset (.-ids s) v (len (.-nodes s)))
  (set! (.-nodes s) (append (.-nodes s) v)))

(go/func predefIndex "predefIndex is oi's predefined exception v's index in fail.h, or -1.\n" ^int [^oi/Value v]
  (range [i p (lit (slice oi/Value) oi/ExnOutOfMemory oi/ExnSysError oi/ExnFailure oi/ExnInvalidArgument oi/ExnEndOfFile
                   oi/ExnDivisionByZero oi/ExnNotFound oi/ExnMatchFailure oi/ExnStackOverflow oi/ExnSysBlockedIO oi/ExnAssertFailure
                   oi/ExnUndefinedRecursiveModule)]
    (when (== p v)
      (return i)))
  -1)

(go/method put "put writes v in the wire form.\n" [^{:tag (* session)} s ^{:tag (* wbuf)} w ^oi/Value v]
  (type-switch [x v]
    (case [nil]
      (.u8 w \i)
      (.u64 w 0)
      (return))
    (case [int]
      (.u8 w \i)
      (.u64 w (conv uint64 x))
      (return))
    (case [float64]
      (.u8 w \d)
      (.u64 w (math/Float64bits x))
      (return))
    (case [int32]
      (.u8 w \l)
      (.u32 w (conv int (conv uint32 x)))
      (return))
    (case [int64]
      (.u8 w \j)
      (.u64 w (conv uint64 x))
      (return))
    (case [oi/Nativeint]
      (.u8 w \n)
      (.u64 w (conv uint64 x))
      (return)))
  (when [i (predefIndex v)] (>= i 0)
    (.u8 w \p)
    (.u32 w i)
    (return))
  (when [(values id ok) (aget (.-ids s) v)] ok
    (.u8 w \r)
    (.u32 w id)
    (return))
  (type-switch [x v]
    (case [(* oi/Block)]
      (.add s v)
      (.u8 w \b)
      (.u32 w (.-Tag x))
      (.u32 w (len (.-F x)))
      (range [_ f (.-F x)]
        (.put s w f)))
    (case [(* oi/Bytes)]
      (.add s v)
      (.u8 w \s)
      (.u32 w (len (.-B x)))
      (set! (.-b w) (append (.-b w) (spread (.-B x)))))
    (case [(* oi/FloatArray)]
      (.add s v)
      (.u8 w \f)
      (.u32 w (len (.-F x)))
      (range [_ f (.-F x)]
        (.u64 w (math/Float64bits f))))
    (case [(* oi/Custom)]
      (when [(values kind layout dims data ok) (oi/BigarrayParts v)] ok
        (.add s v)
        (.u8 w \B)
        ;; (oc-tail) 0x200 in the kind: the C allocated it with memory the collector manages (Managed), sampled by the runtime's Memprof
        (.u32 w (if (Managed v) (bit-or kind 0x200) kind))
        (.u32 w layout)
        (.u32 w (len dims))
        (range [_ d dims]
          (.u32 w d))
        (.u32 w (len data))
        (range [_ e data]
          (.put s w e))
        (return))
      (when [(values cb ok) (assert (* CBlock) (.-V x))] ok
        (.u8 w \c)
        (.str w (.-Name x))
        (.u64 w (.-Addr cb))
        (return))
      (oi/Internalf "the C API: a custom block %q the runtime does not know" (.-Name x)))
    (case [(* oi/Closure)]
      ;; a closure of an earlier session (queue 530): its handle
      (when [(values h ok) (aget closureHandles x)] ok
        (.add s v)
        (.u8 w \k)
        (.u32 w h)
        (return))
      (oi/Internalf "the C API: a closure the runtime did not give"))
    (default
      (oi/Internalf "the C API: a value %T the runtime does not know" v))))

(go/method get "get reads a value in the wire form.\n" ^oi/Value [^{:tag (* session)} s ^{:tag (* rbuf)} r]
  (let [op (.u8 r)]
    (switch op
      (case [\i] (return (conv int (conv int64 (.u64 r)))))
      (case [\d] (return (math/Float64frombits (.u64 r))))
      (case [\l] (return (conv int32 (conv uint32 (.u32 r)))))
      (case [\j] (return (conv int64 (.u64 r))))
      (case [\n] (return (conv oi/Nativeint (conv int64 (.u64 r)))))
      (case [\r] (return (aget (.-nodes s) (.u32 r))))
      (case [\b]
        (let [tag (.u32 r)
              n (.u32 r)
              b (addr (lit oi/Block :Tag tag :F (make (slice oi/Value) n)))]
          (.add s b)
          (for [i 0] (< i n) (inc! i)
            (aset (.-F b) i (.get s r)))
          (return b)))
      (case [\s]
        (let [n (.u32 r)
              b (addr (lit oi/Bytes :B (make (slice byte) n)))]
          (copy (.-B b) (subslice (.-b r) (.-i r) (+ (.-i r) n)))
          (set! (.-i r) (+ (.-i r) n))
          (.add s b)
          (return b)))
      (case [\f]
        (let [n (.u32 r)
              f (addr (lit oi/FloatArray :F (make (slice float64) n)))]
          (for [i 0] (< i n) (inc! i)
            (aset (.-F f) i (math/Float64frombits (.u64 r))))
          (.add s f)
          (return f)))
      (case [\B]
        (let [kind (.u32 r)
              layout (.u32 r)
              nd (.u32 r)
              dims (make (slice int) nd)]
          (for [i 0] (< i nd) (inc! i)
            (aset dims i (.u32 r)))
          (let [n (.u32 r)
                data (make (slice oi/Value) n)
                v (oi/NewBigarray kind layout dims data)]
            (.add s v)
            (for [i 0] (< i n) (inc! i)
              (aset data i (.get s r)))
            (return v))))
      (case [\k]
        (let [h (.u32 r)
              v (aget closureMirrors h)]
          (when (== v nil)
            (set! v (addr (lit oi/Closure)))
            (aset closureMirrors h v)
            (aset closureHandles v h))
          (.add s v)
          (return v)))
      (case [\h]
        (let [v (addr (lit oi/Custom :Name "_java"))]
          (.add s v)
          (return v)))
      (case [\c]
        (let [name (.str r)
              a (.u64 r)]
          (return (addr (lit oi/Custom :Name name :V (addr (lit CBlock :Addr a))))))))
    (oi/Internalf "the C API: a value of the wire form %q" op)
    nil))

(go/method putUpdates "putUpdates writes the contents of the nodes known now.\n" [^{:tag (* session)} s ^{:tag (* wbuf)} w]
  (let [n (len (.-nodes s))]
    (.u32 w n)
    (for [i 0] (< i n) (inc! i)
      (let [v (aget (.-nodes s) i)]
        (type-switch [x v]
          (case [(* oi/Block)]
            (range [_ f (.-F x)]
              (.put s w f)))
          (case [(* oi/Bytes)]
            (set! (.-b w) (append (.-b w) (spread (.-B x)))))
          (case [(* oi/FloatArray)]
            (range [_ f (.-F x)]
              (.u64 w (math/Float64bits f))))
          (case [(* oi/Custom)]
            (when [(values _ _ _ data ok) (oi/BigarrayParts v)] ok
              (range [_ e data]
                (.put s w e)))))))))

(go/method getUpdates "getUpdates reads the contents of the nodes the sender knew into them.\n" [^{:tag (* session)} s ^{:tag (* rbuf)} r]
  (let [n (.u32 r)]
    (for [i 0] (< i n) (inc! i)
      (let [v (aget (.-nodes s) i)]
        (type-switch [x v]
          (case [(* oi/Block)]
            (range [j _ (.-F x)]
              (aset (.-F x) j (.get s r))))
          (case [(* oi/Bytes)]
            (copy (.-B x) (subslice (.-b r) (.-i r) (+ (.-i r) (len (.-B x)))))
            (set! (.-i r) (+ (.-i r) (len (.-B x)))))
          (case [(* oi/FloatArray)]
            (range [j _ (.-F x)]
              (aset (.-F x) j (math/Float64frombits (.u64 r)))))
          (case [(* oi/Custom)]
            (when [(values _ _ _ data ok) (oi/BigarrayParts v)] ok
              (range [j _ data]
                (aset data j (.get s r))))))))))

;; ---- the worker's requests

(go/func ask "ask sends the innermost worker's request (op, then the updates, then body's payload) and waits for the answer,\nits updates read: the answer's reader after them.\n"
  ^{:tag (* rbuf)} [^byte op ^{:tag (func [(* wbuf)] [])} body]
  (let [s sess
        wk (aget (.-workers s) (- (len (.-workers s)) 1))
        w (addr (lit wbuf))]
    (.u8 w op)
    (.putUpdates s w)
    (body w)
    (>! (.-out wk) (.-b w))
    (let [r (addr (lit rbuf :b (<! (.-in wk))))]
      (.u8 r)
      (.getUpdates s r)
      r)))

(go/func wireApply "wireApply is Apply: the runtime applies the closure f to vs.\n" [^oi/Value f ^{:tag (slice oi/Value)} vs]
  :results [oi/Value oi/Value]
  (let [s sess
        r (ask \K (fn [^{:tag (* wbuf)} w]
                        (.put s w f)
                        (.u32 w (len vs))
                        (range [_ v vs]
                          (.put s w v))))]
    (switch (.u8 r)
      (case [\R] (return (.get s r) nil))
      (case [\E] (return nil (.get s r))))
    (panic (addr (lit unwind)))))

(go/func wireNamed "wireNamed is Named: the runtime's caml_named_value.\n" [^string name] :results [oi/Value bool]
  (let [s sess
        r (ask \Q (fn [^{:tag (* wbuf)} w] (.str w name)))]
    (switch (.u8 r)
      (case [\R] (return (.get s r) true))
      (case [\N] (return nil false)))
    (panic (addr (lit unwind)))))

;; A C program that embeds OCaml at the AOT levels (ocaml-aot, 2026-11-24; oi's level since queue 539: embedded/cmcaml): the runtime's
;; main calls "__oi_embed" with one closure, start, in place of the units' initialisation; the stubs' own main runs (Embed), its caml_main
;; or caml_startup applying start (the runtime's callback, 'K'), and the call's result is main's status ('R'), or 'N' when the stubs
;; have no main of their own (OwnMain), and the runtime initialises its units itself
(go/const ^{:val "__oi_embed"} embedName "__oi_embed")

(go/func wireEmbed "wireEmbed runs the stubs' own main (Embed) with start the runtime's closure f: an exception it raises is the C's.
"
  ^oi/Value [^oi/Value f]
  (conv oi/Value (Embed nil (fn []
                              (let [(values _ e) (wireApply f (lit (slice oi/Value) oi/Unit))]
                                (when (!= e nil)
                                  (panic (addr (lit oi/Exn :V e)))))))))

(go/func wireRuntimeEvents "wireRuntimeEvents is RuntimeEvents: the runtime's ring answers ('V' u32 op, str s, u32 n, n i64; the answer 'R' a block of\nits integer results).\n" ^{:tag (slice int64)} [^int op ^string s ^{:tag (slice int64)} args]
  (let [ss sess
        r (ask \V (fn [^{:tag (* wbuf)} w]
                        (.u32 w op)
                        (.str w s)
                        (.u32 w (len args))
                        (range [_ x args]
                          (.u64 w (conv uint64 x)))))]
    (when (== (.u8 r) \R)
      (let [b (oi/AsBlock (.get ss r))
            out (make (slice int64) (len (.-F b)))]
        (range [i x (.-F b)]
          (aset out i (conv int64 (oi/AsInt x))))
        (return out)))
    (panic (addr (lit unwind)))))

(go/func wireMajorCycle "wireMajorCycle is MajorCycle: 'M', answered 'R' once the runtime fired its finalisers (oc-tail).\n" []
  (let [ss sess
        r (ask \M (fn [^{:tag (* wbuf)} w]))]
    (when (== (.u8 r) \R)
      (.get ss r)
      (return))
    (panic (addr (lit unwind)))))

(go/func wireRun "wireRun is a worker's call: the stub name with the arguments read from r; its end the worker's last message.\n"
  [^{:tag (* worker)} wk ^string name ^string reprs ^{:tag (slice oi/Value)} args]
  (let [s sess
        w (addr (lit wbuf))]
    (defer ((fn []
              (when [x (recover)] (!= x nil)
                (set! (.-b w) nil)
                (type-switch [e x]
                  (case [(* oi/Exn)]
                    (.u8 w \E)
                    (.putUpdates s w)
                    (.put s w (.-V e)))
                  (case [(* oi/ExitSignal)]
                    (Flush)
                    (.u8 w \X)
                    (.putUpdates s w)
                    (.u32 w (.-Code e)))
                  (case [(* unwind)]
                    (.u8 w \T)
                    (.putUpdates s w))
                  (case [(* oi/InternalError)]
                    (.u8 w \F)
                    (.putUpdates s w)
                    (.str w (+ "o2j: " (.-Msg e))))
                  (default
                    (.u8 w \F)
                    (.putUpdates s w)
                    (.str w (fmt/Sprintf "o2j: the C API: %v" x)))))
              (>! (.-out wk) (.-b w)))))
    (let [^oi/Value v nil]
      (if (== name embedName)
        (set! v (wireEmbed (aget args 0)))
        (if (== reprs "")
          (set! v (Call name args))
          (set! v (CallRaw name reprs args))))
      (.u8 w \R)
      (.putUpdates s w)
      (.put s w v))))

(go/func Handle "Handle is the reply to the runtime's message msg: a call's start, or an answer to the innermost worker's request; the\nworker's next request or its end.\n"
  ^{:tag (slice byte)} [^{:tag (slice byte)} msg]
  (let [r (addr (lit rbuf :b msg))
        op (.u8 r)
        ^{:tag (* worker)} wk nil]
    (switch op
      (case [\C]
        (when (== sess nil)
          (set! sess (addr (lit session :ids (lit (map any int))))))
        (let [s sess]
          (.getUpdates s r)
          (let [name (.str r)
                reprs (.str r)
                n (.u32 r)
                args (make (slice oi/Value) n)]
            (for [i 0] (< i n) (inc! i)
              (aset args i (.get s r)))
            ;; (ocaml-aot, 2026-11-24) "__oi_embed": the stubs' own main (Embed), when they have one
            (when (or (not (wireLoad)) (and (== name embedName) (not (OwnMain))) (and (!= name embedName) (not (Has name))))
              (when (== (len (.-workers s)) 0)
                (set! sess nil))
              (return (lit (slice byte) \N)))
            (set! wk (addr (lit worker :in (make (chan (slice byte))) :out (make (chan (slice byte))))))
            (set! (.-workers s) (append (.-workers s) wk))
            (go (wireRun wk name reprs args)))))
      (case [\A]
        (set! wk (aget (.-workers sess) (- (len (.-workers sess)) 1)))
        (>! (.-in wk) msg))
      ;; (queue 530) 'P': the runtime's agent asks, at no call's depth, for a C thread's conversation ('D' or 'L', u32 the domain), or
      ;; nothing ('N')
      (case [\P]
        (.Lock asyncMu)
        (when (or (!= sess nil) (== (len asyncQ) 0))
          (.Unlock asyncMu)
          (return (lit (slice byte) \N)))
        (let [q (aget asyncQ 0)]
          (set! asyncQ (subslice asyncQ 1))
          (.Unlock asyncMu)
          (set! sess (addr (lit session :ids (lit (map any int)) :workers (lit (slice (* worker)) (.-wk q)))))
          (let [w (addr (lit wbuf))]
            (.u8 w (.-op q))
            (.putUpdates sess w)
            (.u32 w (.-dom q))
            (return (.-b w)))))
      ;; (queue 523) 'G' u32 n, n u64: the C's custom blocks the runtime's asked collection found unreachable (no call runs), finalized
      (case [\G]
        (let [n (.u32 r)
              addrs (make (slice uint64) n)]
          (for [i 0] (< i n) (inc! i)
            (aset addrs i (.u64 r)))
          (when (and loaded (== loadErr ""))
            (Collected addrs))
          (return (lit (slice byte) \N))))
      ;; (queue 527) 'S', 'D': a C custom block serialized, or one deserialized, for the runtime's Marshal (customOp)
      (case [\S \D]
        (return (customOp op r)))
      (default
        (let [w (addr (lit wbuf))]
          (.u8 w \F)
          (.u32 w 0)
          (.str w (fmt/Sprintf "o2j: the C API: a message %q" op))
          (return (.-b w)))))
    (let [out (<! (.-out wk))]
      (switch (aget out 0)
        (case [\K \Q \V \M])
        (default
          (set! (.-workers sess) (subslice (.-workers sess) 0 (- (len (.-workers sess)) 1)))
          (when (== (len (.-workers sess)) 0)
            (set! sess nil))))
      out)))

;; ---- the C's threads at the AOT levels (queue 530; threads.go): a thread the C started speaks to the runtime only when the runtime
;; asks ('P', its agent's poll, at no call's depth, once the server told it the C started a thread: the light level's 't' chunk). Its
;; conversation is the session's one worker: 'D' u32 dom (does the domain run? the answer 'R' 1 or 0), or 'L' u32 dom (the runtime
;; taken for a thread of that domain, answered 'R'; then the thread's callbacks, 'K' as a call's, until its release, 'N').

(go/type asyncReq "asyncReq is a C thread's conversation waiting for the runtime's poll.\n" (struct ^byte op ^int dom ^{:tag (* worker)} wk))

(go/var ^sync/Mutex asyncMu)
(go/var ^{:tag (slice (* asyncReq))} asyncQ)

(go/func asyncStart "asyncStart queues a C thread's conversation op about the domain dom and waits for the runtime's answer: its reader after\nthe updates, and the worker the conversation goes on with.\n"
  [^byte op ^int dom] :results [(* rbuf) (* worker)]
  (let [wk (addr (lit worker :in (make (chan (slice byte))) :out (make (chan (slice byte)))))]
    (.Lock asyncMu)
    (set! asyncQ (append asyncQ (addr (lit asyncReq :op op :dom dom :wk wk))))
    (.Unlock asyncMu)
    (let [r (addr (lit rbuf :b (<! (.-in wk))))]
      (.u8 r)
      (.getUpdates sess r)
      (return r wk))))

(go/func asyncEnd "asyncEnd ends a C thread's conversation ('N').\n" [^{:tag (* worker)} wk]
  (>! (.-out wk) (lit (slice byte) \N)))

(go/func wireDomain "wireDomain asks the runtime whether the domain dom runs (a C thread's registration).\n" ^bool [^int dom]
  (let [(values r wk) (asyncStart \D dom)
        ok false]
    (when (== (.u8 r) \R)
      (set! ok (== (.get sess r) 1)))
    (asyncEnd wk)
    ok))

(go/func wireAcquire "wireAcquire takes the runtime for a C thread of the domain dom: the conversation its callbacks and its release go on.\n"
  ^{:tag (* worker)} [^int dom]
  (let [(values _ wk) (asyncStart \L dom)]
    wk))

(go/func ThreadsStarted "ThreadsStarted tells whether the loaded stubs started a thread (the light level's server tells the runtime once: 't').\n" ^bool []
  (and (!= the nil) (!= (.-Sched (.-Sys (.-p the))) nil)))
(go/func customOp "customOp is the reply to 'S' or 'D' (queue 527): the C custom block at an address serialized by its operations' serialize\n(its bytes and sizes), or a block of the operations registered under an identifier deserialized from the data (the block, the size\nits deserialize returned, the bytes it read): oicapi's serialize and deserialize, which oi's Marshal calls (ext_capi.go's\nCustomSerialize, CustomDeserialize); 'N' when there are none, 'E' when the C raised, 'X' when it called exit, 'F' at a fault. A\nreply's new nodes are the session's, or a session of its own outside a call.\n"
  ^{:tag (slice byte)} [^byte op ^{:tag (* rbuf)} r]
  (let [s sess
        w (addr (lit wbuf))]
    (when (== s nil)
      (set! s (addr (lit session :ids (lit (map any int))))))
    ((fn []
       (defer ((fn []
                 (when [x (recover)] (!= x nil)
                   (set! (.-b w) nil)
                   (type-switch [e x]
                     (case [(* oi/Exn)]
                       (.u8 w \E)
                       (.u32 w 0)
                       (.put s w (.-V e)))
                     (case [(* oi/ExitSignal)]
                       (Flush)
                       (.u8 w \X)
                       (.u32 w 0)
                       (.u32 w (.-Code e)))
                     (case [(* oi/InternalError)]
                       (.u8 w \F)
                       (.u32 w 0)
                       (.str w (+ "o2j: " (.-Msg e))))
                     (default
                       (.u8 w \F)
                       (.u32 w 0)
                       (.str w (fmt/Sprintf "o2j: the C API: %v" x))))))))
       (when (or (not (wireLoad)) (== the nil))
         (.u8 w \N)
         (return))
       (if (== op \S)
         (let [a (.u64 r)
               (values data sz32 sz64 ok) (.serialize the (addr (lit oi/Custom :V (addr (lit CBlock :Addr a)))))]
           (when (not ok)
             (.u8 w \N)
             (return))
           (.u8 w \R)
           (.u32 w 0)
           (.u32 w (len data))
           (set! (.-b w) (append (.-b w) (spread data)))
           (.u64 w sz32)
           (.u64 w sz64))
         (let [name (.str r)
               data (conv (slice byte) (.str r))
               expected (.u64 r)
               (values v size used ok) (.deserialize the name data expected)]
           (when (not ok)
             (.u8 w \N)
             (return))
           (.u8 w \R)
           (.u32 w 0)
           (.put s w v)
           (.u64 w (conv uint64 size))
           (.u64 w (conv uint64 used))))))
    (.-b w)))

(go/func FlushStubs "FlushStubs flushes the C's stdio at the program's end (Flush), when the stubs were loaded.\n" []
  (when (and loaded (== loadErr ""))
    (Flush)))

(ns go.arbace.hs
  (:require [arbace.go :as go]))

(go/package hs
  :path "arbace/hs"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["alloc.go" "aot.go" "aotapi.go" "arena.go" "cbits.go" "cdata.go" "cformat.go" "compile.go" "cprog.go" "fdwait.go" "ffi.go" "image.go" "live.go" "load.go" "machine.go" "mem.go" "nodes.go" "posix.go" "prim_ctl.go" "prim_mem.go" "prim_scalar.go" "read.go" "repl.go" "rts.go" "rtsapi.go" "stm.go" "value.go"]
  :init-order [aotTable aotTrace aotLimit aotNo aotInline cdataBytes cdataWords rubbish cFirst ffiTable stores startTime md5s blockedE raiseLam dataLabels dttCase le elems apLams selLams primops primcalls contLam hsIface applyLam]
  :positions :full)

(load "hs/alloc")
(load "hs/aot")
(load "hs/aotapi")
(load "hs/arena")
(load "hs/cbits")
(load "hs/cdata")
(load "hs/cformat")
(load "hs/compile")
(load "hs/cprog")
(load "hs/fdwait")
(load "hs/ffi")
(load "hs/image")
(load "hs/live")
(load "hs/load")
(load "hs/machine")
(load "hs/mem")
(load "hs/nodes")
(load "hs/posix")
(load "hs/prim_ctl")
(load "hs/prim_mem")
(load "hs/prim_scalar")
(load "hs/read")
(load "hs/repl")
(load "hs/rts")
(load "hs/rtsapi")
(load "hs/stm")
(load "hs/value")

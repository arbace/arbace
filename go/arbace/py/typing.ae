(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// The intrinsics (PY5c; CPython's Python/intrinsics.c) and typing's runtime (Objects/typevarobject.c,"] [6 1 "// Objects/genericaliasobject.c, Objects/unionobject.c; queue 225: ported whole): TypeVar, TypeVarTuple, ParamSpec,"] [7 1 "// ParamSpecArgs, ParamSpecKwargs, TypeAliasType, _ConstEvaluator and Generic for PEP 695's type parameters,"] [8 1 "// types.GenericAlias for the built-in containers' subscriptions (PEP 585), typing.Union, typing.NoDefault."] [24 1 "// GenericType is typing.Generic."] [31 1 "// NoDefault is typing.NoDefault."] [34 1 "// TypeVar is a TypeVar, a TypeVarTuple or a ParamSpec (kind): typevarobject, paramspecobject and typevartupleobject, its"] [35 1 "// bound, constraints and default evaluated lazily from their functions, its dict the managed dict that holds __module__."] [39 45 "// the values once evaluated, nil before"] [48 1 "// paramSpecAttr is P.args or P.kwargs."] [56 1 "// constEvaluator is a _ConstEvaluator: the evaluate_* attribute of a value given to a constructor."] [61 1 "// TypeAlias is a TypeAliasType: of a type statement (its compute value function) or of the constructor (its value)."] [64 20 "// nil: none"] [72 1 "// GenericAlias is list[int] and the like: an origin and its arguments."] [82 1 "// gaIterator is ga_iter's iterator: one starred alias."] [87 1 "// asGenericAlias is _PyGenericAlias_Check's view of o."] [93 1 "// evalOnce is typevar_bound's lazy evaluation: the value kept in slot, else fn called with no arguments (its default"] [94 1 "// .format VALUE) and kept; ifNone when there is no function."] [110 1 "// evaluator is typevar_evaluate_bound: the function, else a value's constant evaluator, else None."] [121 1 "// typeRepr is _Py_typing_type_repr: a class's qualified name, else repr."] [146 21 "// it looks like a GenericAlias"] [185 1 "// typeSubscript is a class's subscription: __class_getitem__, or type[...] (PyObject_GetItem: type itself a GenericAlias)."] [201 1 "// classGetItem is {\"__class_getitem__\", Py_GenericAlias, METH_O|METH_CLASS}."] [211 1 "// typingParse binds a typing constructor's arguments as the clinic's _PyArg_UnpackKeywords does: names in order, the"] [212 1 "// first maxPos positional, minPos of them required; the values by name's index, nil when absent."] [249 1 "// typingName is the name argument's check, subclass_of PyUnicode_Type."] [258 1 "// typingCaller is typevarobject.c's caller(): the module of the running function."] [268 1 "// typingFlag is a clinic bool argument: false when absent."] [283 1 "// typingNew makes a TypeVar of a type parameter (PEP 695): its variance inferred, no __module__ of its own."] [292 1 "// typeCheck is typevarobject.c's type_check: None its type, else typing._type_check(arg, msg)."] [300 1 "// typeVarNew, paramSpecNew and typeVarTupleNew are typevar_new_impl, paramspec_new_impl and typevartuple_impl."] [347 1 "// variance is the variance arguments' check."] [405 1 "// typeAliasNew is typealias_new_impl."] [456 1 "// unpackTypeVarTuples is unpack_typevartuples: each TypeVarTuple of params as typing.Unpack[Ts]."] [492 1 "// makeParameters is _Py_make_parameters: the type variables of args (a tuple or a list's items), each once."] [501 18 "// not a bare class's __parameters__ descriptor"] [544 1 "// unpackedTupleArgs is _unpacked_tuple_args: nil for no unpacked tuple."] [551 19 "// _unpacked_tuple_args: an error left for the caller's PyErr_Occurred"] [559 1 "// unpackArgs is _unpack_args: item's elements with the unpacked fixed tuples among them spliced in."] [582 1 "// subsTvars is subs_tvars: obj subscripted with params' arguments in its own __parameters__' order."] [597 70 "// TypeVarTuple"] [607 1 "// subsParameters is _Py_subs_parameters: args with parameters replaced by item's arguments."] [658 42 "// recursively in lists and tuples"] [731 1 "// typeVarOr is make_union, the | of a TypeVar and a ParamSpec: typing.Union's checks, so a string is a forward reference."] [756 2 "// the PEP 585 classes of the built-ins: {\"__class_getitem__\", Py_GenericAlias, METH_O|METH_CLASS}"] [761 46 "// builtins_itertools.go's init ran first (files in name order)"] [773 2 "// _ConstEvaluator (constevaluator_call, constevaluator_repr)"] [823 2 "// TypeVar, TypeVarTuple, ParamSpec"] [832 3 "// the managed dict has no __dict__ attribute"] [882 2 "// the variances of a TypeVar and a ParamSpec (paramspec_attrs: a PEP 695 ParamSpec infers its variance)"] [892 2 "// P.args and P.kwargs (paramspecattr_new, paramspecargs_repr, paramspecattr_richcompare)"] [933 2 "// *Ts is typing.Unpack[Ts] (typevarobject.c's unpack_iter; queue 205g: typing's _is_unpacked_typevartuple)"] [941 2 "// substitution (queue 205g, typing's _GenericAlias): __typing_subst__ and __typing_prepare_subst__, typing's"] [942 2 "// _typevar_subst, _paramspec_subst, _paramspec_prepare_subst and _typevartuple_prepare_subst, a TypeVar's own"] [943 2 "// preparation typevar_typing_prepare_subst_impl's"] [1019 2 "// TypeAliasType"] [1070 2 "// GenericAlias"] [1072 2 "// GenericAlias(origin, args), and subclassable (_collections_abc's _CallableGenericAlias): PY5e, part 2b"] [1100 32 "// a ParamSpec's list of type arguments (ga_repr_items_list)"] [1104 29 "// PyList_GetItemRef: the list mutated by a callback"] [1125 14 "// ga_repr: a starred alias (*tuple[int]) its repr after a star"] [1131 2 "// ga_call: set_orig_class, an attribute that cannot be set left unset"] [1149 32 "// ga_richcompare: starred first, then the origin and the arguments"] [1174 2 "// ga_getitem: the parameters substituted, the origin kept"] [1189 2 "// *list[int] (genericaliasobject.c's ga_iter, ga_iternext; queue 205g: test_genericalias's _UNPACKED_TUPLES): one"] [1190 2 "// starred copy, where the sequence protocol over GetItem never ended"] [1214 62 "// attr_exceptions and attr_blocked"] [1217 4 "// a subclass's instance: its class's attributes and dict first"] [1236 2 "// ga_reduce: a starred alias as next(iter(alias))"] [1248 2 "// ga_dir: the origin's names and the alias's own"] [1340 1 "// callTyping is typing.NAME(*args) (typevarobject.c's call_typing_func_object and call_typing_args_kwargs: Generic's"] [1341 1 "// __class_getitem__ and __init_subclass__ are typing's _generic_class_getitem and _generic_init_subclass, queue 205g)"] [1354 1 "// unpackTypeVarTuple is typing.Unpack[ts] (typevarobject.c's unpack)."] [1367 1 "// typingArity refuses a method's call unless it has n positional arguments after self (METH_O's and the clinic's"] [1368 1 "// checks)."] [1382 1 "// subscriptGeneric is Generic[*params] of a class statement's type parameters (_Py_subscript_generic): a TypeVarTuple"] [1383 1 "// unpacked as typing.Unpack[Ts] (unpack_typevartuples), then typing._GenericAlias(Generic, params)"] [1395 1 "// readyGeneric completes typing.Generic once the built-in types are ready (its MRO, its slots)."] [1401 14 "// the type attribute cache: an MRO set"] [1406 1 "// ---- PEP 604 unions: X | Y (Objects/unionobject.c; 3.14's typing.Union). Added by PY5e as the"] [1407 1 "// integration's owner (part 2b: types.py's UnionType = type(int | str))."] [1409 1 "// UnionType is typing.Union, the type of int | str."] [1412 1 "// Union is X | Y: its arguments, flattened and without duplicates; the hashable ones as a frozenset, the others apart"] [1413 1 "// (unionobject's hashable_args, unhashable_args)."] [1423 1 "// unionable is is_unionable: an operand of | that makes a union."] [1436 1 "// unionOf is _Py_union_type_or: a | b, NotImplemented when an operand is not unionable."] [1451 1 "// unionFromTuple is _Py_union_from_tuple: each argument through type_check (a str a ForwardRef)."] [1482 2 "// union_nb_or: a union's | checked as Union[...] is (a string a forward reference)"] [1505 2 "// union_richcompare: unions_equal, the hashable arguments' sets and the others as sets"] [1542 2 "// union_hash: an unhashable argument's error"] [1580 2 "// Union[X, Y, ...] (union_class_getitem)"] [1589 1 "// unionArgs are a union's arguments as unionobject.c's unionbuilder_add_single_unchecked gathers them (queue 205f): a"] [1590 1 "// hashable argument dropped when an earlier hashable one of its hash is it or equal to it (the set's lookup), an"] [1591 1 "// unhashable one when an earlier unhashable one is (the list's contains), so an argument whose __eq__ answers"] [1592 1 "// anything truthy (annotationlib's _Stringifier, its hash its id) is not taken for str's duplicate"] [1602 20 "// PyErr_Clear: any error of the hash an unhashable argument"] [1622 1 "// addSingle is unionbuilder_add_single: None its type, a union's arguments each, checked by type_check when asked."] [1644 1 "// make is make_union."] [1667 1 "// builtinNamedObj is a builtin by name (_PyEval_GetBuiltin)."] [1675 1 "// callBuiltinDir is PyObject_Dir."] [1684 1 "// the types' docstrings (typevarobject.c's)"] [1696 1 "// __round__, __complex__ and __bytes__ of the built-in numbers and bytes (queue 225: typing's SupportsRound,"] [1697 1 "// SupportsComplex and SupportsBytes find them in the classes' __dict__), and a code object's refusal to pickle."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[167 27] [187 51] [241 12] [241 24] [260 31] [261 39] [321 40] [329 60] [350 38] [353 46] [356 45] [381 40] [460 27] [519 42] [523 68] [528 31] [546 33] [562 27] [572 32] [594 40] [597 29] [629 29] [632 58] [638 27] [681 31] [761 33] [795 30] [798 36] [869 22] [907 33] [945 57] [951 57] [957 57] [963 65] [969 65] [975 65] [1029 27] [1035 27] [1045 36] [1046 49] [1087 16] [1100 25] [1103 15] [1103 22] [1138 52] [1207 33] [1216 29] [1218 40] [1261 25] [1320 31] [1332 31] [1385 29] [1442 27] [1445 27] [1454 27] [1456 29] [1460 37] [1523 28] [1534 41] [1546 24] [1550 28] [1626 31] [1628 28] [1669 51]]} (go/file "typing.go" :imports [


(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// The intrinsics (PY5c; CPython's Python/intrinsics.c) and typing's runtime minimum"] [6 1 "// (Objects/typevarobject.c, Objects/genericaliasobject.c): TypeVar, TypeVarTuple, ParamSpec,"] [7 1 "// TypeAliasType and Generic for PEP 695's type parameters, types.GenericAlias for the built-in"] [8 1 "// containers' subscriptions (PEP 585), typing.NoDefault."] [20 1 "// GenericType is typing.Generic."] [27 1 "// NoDefault is typing.NoDefault."] [30 1 "// TypeVar is a TypeVar, a TypeVarTuple or a ParamSpec (kind), its bound, constraints and default"] [31 1 "// evaluated lazily from their functions."] [35 35 "// the values once evaluated, nil before"] [45 1 "// TypeAlias is a type statement's TypeAliasType."] [56 1 "// GenericAlias is list[int] and the like: an origin and its arguments."] [72 1 "// typeRepr is typing's _type_repr: a class's qualified name, else repr."] [110 1 "// classGetItemBuiltins are the built-in classes subscriptable by PEP 585."] [114 1 "// typeSubscript is a class's subscription: __class_getitem__, or a built-in container's GenericAlias."] [174 2 "// TypeVar, TypeVarTuple, ParamSpec"] [245 2 "// the variances of a TypeVar and a ParamSpec (paramspec_attrs: a PEP 695 ParamSpec infers its variance)"] [255 2 "// *Ts is typing.Unpack[Ts] (typevarobject.c's unpack_iter; queue 205g: typing's _is_unpacked_typevartuple)"] [263 2 "// substitution (queue 205g, typing's _GenericAlias): __typing_subst__ and __typing_prepare_subst__, typing's"] [264 2 "// _typevar_subst, _paramspec_subst, _paramspec_prepare_subst and _typevartuple_prepare_subst, a TypeVar's own"] [265 2 "// preparation typevar_typing_prepare_subst_impl's"] [341 2 "// TypeAliasType"] [370 2 "// GenericAlias"] [372 2 "// GenericAlias(origin, args), and subclassable (_collections_abc's _CallableGenericAlias): PY5e, part 2b"] [457 4 "// a subclass's instance: its class's attributes and dict first"] [543 1 "// callTyping is typing.NAME(*args) (typevarobject.c's call_typing_func_object and call_typing_args_kwargs: Generic's"] [544 1 "// __class_getitem__ and __init_subclass__ are typing's _generic_class_getitem and _generic_init_subclass, queue 205g)"] [557 1 "// unpackTypeVarTuple is typing.Unpack[ts] (typevarobject.c's unpack)."] [570 1 "// typingArity refuses a method's call unless it has n positional arguments after self (METH_O's and the clinic's"] [571 1 "// checks)."] [585 1 "// subscriptGeneric is Generic[*params] of a class statement's type parameters (_Py_subscript_generic): a TypeVarTuple"] [586 1 "// unpacked as typing.Unpack[Ts] (unpack_typevartuples), then typing._GenericAlias(Generic, params)"] [610 1 "// readyGeneric completes typing.Generic once the built-in types are ready (its MRO, its slots)."] [616 14 "// the type attribute cache: an MRO set"] [621 1 "// ---- PEP 604 unions: X | Y (Objects/unionobject.c; 3.14's typing.Union). Added by PY5e as the"] [622 1 "// integration's owner (part 2b: types.py's UnionType = type(int | str))."] [624 1 "// UnionType is typing.Union, the type of int | str."] [627 1 "// Union is X | Y: its arguments, flattened and without duplicates."] [632 1 "// unionable is an operand of | that makes a union (is_unionable)."] [641 1 "// unionOf is a | b, NotImplemented when an operand is not unionable."] [745 2 "// Union[X, Y, ...] (unionobject.c's union_class_getitem, _Py_union_from_tuple; queue 205: packaging's"] [746 2 "// tuple[Union[int, str], ...]): each argument through typing._type_check (a str a ForwardRef), unions"] [747 2 "// flattened, duplicates dropped, one argument itself, none a TypeError"] [790 1 "// unionArgs are a union's arguments as unionobject.c's unionbuilder_add_single_unchecked gathers them (queue 205f): a"] [791 1 "// hashable argument dropped when an earlier hashable one of its hash is it or equal to it (the set's lookup), an"] [792 1 "// unhashable one when an earlier unhashable one is (the list's contains), so an argument whose __eq__ answers"] [793 1 "// anything truthy (annotationlib's _Stringifier, its hash its id) is not taken for str's duplicate"] [802 20 "// PyErr_Clear: any error of the hash an unhashable argument"] [822 1 "// unionOfAny is unionOf without the unionable test (Union[...]'s arguments are checked by typing, not |)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[74 23] [80 50] [116 51] [136 31] [180 24] [267 57] [273 57] [279 57] [285 65] [291 65] [297 65] [356 27] [362 23] [387 28] [403 30] [425 31] [437 13] [437 42] [456 29] [458 40] [462 61] [523 32] [535 31] [588 29] [591 28] [654 25] [656 21] [660 26] [664 21] [753 31] [763 33] [772 96] [827 25] [829 21] [833 26] [837 21]]} (go/file "typing.go" :imports [


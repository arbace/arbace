plicates."] [494 1 "// unionable is an operand of | that makes a union (is_unionable)."] [503 1 "// unionOf is a | b, NotImplemented when an operand is not unionable."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[74 23] [80 50] [116 51] [136 31] [164 57] [165 60] [191 24] [285 27] [291 23] [316 28] [332 30] [354 31] [366 13] [366 42] [385 29] [387 40] [391 61] [452 32] [464 31] [526 25] [528 21] [532 26]]} (go/file "typing.go" :imports [


(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// The intrinsics (PY5c; CPython's Python/intrinsics.c) and typing's runtime (Objects/typevarobject.c,"] [6 1 "// Objects/genericaliasobject.c, Objects/unionobject.c; queue 225: ported whole): TypeVar, TypeVarTuple, ParamSpec,"] [7 1 "// ParamSpecArgs, ParamSpecKwargs, TypeAliasType, _ConstEvaluator and Generic for PEP 695's type parameters,"] [8 1 "// types.GenericAlias for the built-in containers' subscriptions (PEP 585), typing.Union, typing.NoDefault."] [24 1 "// GenericType is typing.Generic."] [31 1 "// NoDefault is typing.NoDefault."] [34 1 "// TypeVar is a TypeVar, a TypeVarTuple or a ParamSpec (kind): typevarobject, paramspecobject and typevartupleobject, its"] [35 1 "// bound, constraints and default evaluated lazily from their functions, its dict the managed dict that holds __module__."] [39 45 "// the values once evaluated, nil before"] [48 1 "// paramSpecAttr is P.args or P.kwargs."] [56 1 "// constEvaluator is a _ConstEvaluator: the evaluate_* attribute of a value given to a constructor."] [61 1 "// TypeAlias is a TypeAliasType: of a type statement (its compute value function) or of the constructor (its value)."] [64 20 "// nil: none"] [72 1 "// GenericAlias is list[int] and the like: an origin and its arguments."] [82 1 "// gaIterator is ga_iter's iterator: one starred alias."] [87 1 "// asGenericAlias is _PyGenericAlias_Check's view of o."] [93 1 "// evalOnce is typevar_bound's lazy evaluation: the value kept in slot, else fn called with no arguments (its default"] [94 1 "// .format VALUE) and kept; ifNone when there is no function."] [110 1 "// evaluator is typevar_evaluate_bound: the function, else a value's constant evaluator, else None."] [121 1 "// typeRepr is _Py_typing_type_repr: a class's qualified name, else repr."] [146 21 "// it looks like a GenericAlias"] [185 1 "// typeSubscript is a class's subscription: __class_getitem__, or type[...] (PyObject_GetItem: type itself a GenericAlias)."] [201 1 "// typingParse binds a typing constructor's arguments as the clinic's _PyArg_UnpackKeywords does: names in order, the"] [202 1 "// first maxPos positional, minPos of them required; the values by name's index, nil when absent."] [239 1 "// typingName is the name argument's check, subclass_of PyUnicode_Type."] [248 1 "// typingCaller is typevarobject.c's caller(): the module of the running function."] [258 1 "// typingFlag is a clinic bool argument: false when absent."] [273 1 "// typingNew makes a TypeVar of a type parameter (PEP 695): its variance inferred, no __module__ of its own."] [282 1 "// typeCheck is typevarobject.c's type_check: None its type, else typing._type_check(arg, msg)."] [290 1 "// typeVarNew, paramSpecNew and typeVarTupleNew are typevar_new_impl, paramspec_new_impl and typevartuple_impl."] [337 1 "// variance is the variance arguments' check."] [395 1 "// typeAliasNew is typealias_new_impl."] [446 1 "// unpackTypeVarTuples is unpack_typevartuples: each TypeVarTuple of params as typing.Unpack[Ts]."] [482 1 "// makeParameters is _Py_make_parameters: the type variables of args (a tuple or a list's items), each once."] [491 18 "// not a bare class's __parameters__ descriptor"] [534 1 "// unpackedTupleArgs is _unpacked_tuple_args: nil for no unpacked tuple."] [541 19 "// _unpacked_tuple_args: an error left for the caller's PyErr_Occurred"] [549 1 "// unpackArgs is _unpack_args: item's elements with the unpacked fixed tuples among them spliced in."] [572 1 "// subsTvars is subs_tvars: obj subscripted with params' arguments in its own __parameters__' order."] [587 70 "// TypeVarTuple"] [597 1 "// subsParameters is _Py_subs_parameters: args with parameters replaced by item's arguments."] [648 42 "// recursively in lists and tuples"] [721 1 "// typeVarOr is make_union, the | of a TypeVar and a ParamSpec: typing.Union's checks, so a string is a forward reference."] [746 2 "// the PEP 585 classes of the built-ins: {\"__class_getitem__\", Py_GenericAlias, METH_O|METH_CLASS}"] [764 2 "// _ConstEvaluator (constevaluator_call, constevaluator_repr)"] [814 2 "// TypeVar, TypeVarTuple, ParamSpec"] [823 3 "// the managed dict has no __dict__ attribute"] [873 2 "// the variances of a TypeVar and a ParamSpec (paramspec_attrs: a PEP 695 ParamSpec infers its variance)"] [883 2 "// P.args and P.kwargs (paramspecattr_new, paramspecargs_repr, paramspecattr_richcompare)"] [924 2 "// *Ts is typing.Unpack[Ts] (typevarobject.c's unpack_iter; queue 205g: typing's _is_unpacked_typevartuple)"] [932 2 "// substitution (queue 205g, typing's _GenericAlias): __typing_subst__ and __typing_prepare_subst__, typing's"] [933 2 "// _typevar_subst, _paramspec_subst, _paramspec_prepare_subst and _typevartuple_prepare_subst, a TypeVar's own"] [934 2 "// preparation typevar_typing_prepare_subst_impl's"] [1010 2 "// TypeAliasType"] [1061 2 "// GenericAlias"] [1063 2 "// GenericAlias(origin, args), and subclassable (_collections_abc's _CallableGenericAlias): PY5e, part 2b"] [1091 32 "// a ParamSpec's list of type arguments (ga_repr_items_list)"] [1112 14 "// ga_repr: a starred alias (*tuple[int]) its repr after a star"] [1118 2 "// ga_call: set_orig_class, an attribute that cannot be set left unset"] [1136 32 "// ga_richcompare: starred first, then the origin and the arguments"] [1161 2 "// ga_getitem: the parameters substituted, the origin kept"] [1176 2 "// *list[int] (genericaliasobject.c's ga_iter, ga_iternext; queue 205g: test_genericalias's _UNPACKED_TUPLES): one"] [1177 2 "// starred copy, where the sequence protocol over GetItem never ended"] [1201 62 "// attr_exceptions and attr_blocked"] [1204 4 "// a subclass's instance: its class's attributes and dict first"] [1223 2 "// ga_reduce: a starred alias as next(iter(alias))"] [1235 2 "// ga_dir: the origin's names and the alias's own"] [1327 1 "// callTyping is typing.NAME(*args) (typevarobject.c's call_typing_func_object and call_typing_args_kwargs: Generic's"] [1328 1 "// __class_getitem__ and __init_subclass__ are typing's _generic_class_getitem and _generic_init_subclass, queue 205g)"] [1341 1 "// unpackTypeVarTuple is typing.Unpack[ts] (typevarobject.c's unpack)."] [1354 1 "// typingArity refuses a method's call unless it has n positional arguments after self (METH_O's and the clinic's"] [1355 1 "// checks)."] [1369 1 "// subscriptGeneric is Generic[*params] of a class statement's type parameters (_Py_subscript_generic): a TypeVarTuple"] [1370 1 "// unpacked as typing.Unpack[Ts] (unpack_typevartuples), then typing._GenericAlias(Generic, params)"] [1382 1 "// readyGeneric completes typing.Generic once the built-in types are ready (its MRO, its slots)."] [1388 14 "// the type attribute cache: an MRO set"] [1393 1 "// ---- PEP 604 unions: X | Y (Objects/unionobject.c; 3.14's typing.Union). Added by PY5e as the"] [1394 1 "// integration's owner (part 2b: types.py's UnionType = type(int | str))."] [1396 1 "// UnionType is typing.Union, the type of int | str."] [1399 1 "// Union is X | Y: its arguments, flattened and without duplicates; the hashable ones as a frozenset, the others apart"] [1400 1 "// (unionobject's hashable_args, unhashable_args)."] [1410 1 "// unionable is is_unionable: an operand of | that makes a union."] [1423 1 "// unionOf is _Py_union_type_or: a | b, NotImplemented when an operand is not unionable."] [1438 1 "// unionFromTuple is _Py_union_from_tuple: each argument through type_check (a str a ForwardRef)."] [1469 2 "// union_nb_or: a union's | checked as Union[...] is (a string a forward reference)"] [1492 2 "// union_richcompare: unions_equal, the hashable arguments' sets and the others as sets"] [1529 2 "// union_hash: an unhashable argument's error"] [1567 2 "// Union[X, Y, ...] (union_class_getitem)"] [1576 1 "// unionArgs are a union's arguments as unionobject.c's unionbuilder_add_single_unchecked gathers them (queue 205f): a"] [1577 1 "// hashable argument dropped when an earlier hashable one of its hash is it or equal to it (the set's lookup), an"] [1578 1 "// unhashable one when an earlier unhashable one is (the list's contains), so an argument whose __eq__ answers"] [1579 1 "// anything truthy (annotationlib's _Stringifier, its hash its id) is not taken for str's duplicate"] [1589 20 "// PyErr_Clear: any error of the hash an unhashable argument"] [1609 1 "// addSingle is unionbuilder_add_single: None its type, a union's arguments each, checked by type_check when asked."] [1631 1 "// make is make_union."] [1654 1 "// builtinNamedObj is a builtin by name (_PyEval_GetBuiltin)."] [1662 1 "// callBuiltinDir is PyObject_Dir."] [1671 1 "// the types' docstrings (typevarobject.c's)"] [1683 1 "// __round__, __complex__ and __bytes__ of the built-in numbers and bytes (queue 225: typing's SupportsRound,"] [1684 1 "// SupportsComplex and SupportsBytes find them in the classes' __dict__), and a code object's refusal to pickle."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[167 27] [187 51] [231 12] [231 24] [250 31] [251 39] [311 40] [319 60] [340 38] [343 46] [346 45] [371 40] [450 27] [509 42] [513 68] [518 31] [536 33] [552 27] [562 32] [584 40] [587 29] [619 29] [622 58] [628 27] [671 31] [786 30] [789 36] [860 22] [898 33] [936 57] [942 57] [948 57] [954 65] [960 65] [966 65] [1020 27] [1026 27] [1036 36] [1037 49] [1078 16] [1091 25] [1125 52] [1194 33] [1203 29] [1205 40] [1248 25] [1307 31] [1319 31] [1372 29] [1429 27] [1432 27] [1441 27] [1443 29] [1447 37] [1510 28] [1521 41] [1533 24] [1537 28] [1613 31] [1615 28] [1656 51]]} (go/file "typing.go" :imports [


;; Package py is pyi's runtime (doc/python/PYI-SPEC.md §6-§9; PYS7 (a), PYS8 (a)): Python's objects and
;; types, the frame machine that runs the IR of arbace.python.compile on heap frames, and the built-in
;; modules. It is interpreted by goi on stage 0 until a re-seed lists it in goi's table.
(in-ns 'go.arbace.py) ^{:go/comments [[1 1 "// Package py is pyi's runtime (doc/python/PYI-SPEC.md §6-§9; PYS7 (a), PYS8 (a)): Python's objects and"] [2 1 "// types, the frame machine that runs the IR of arbace.python.compile on heap frames, and the built-in"] [3 1 "// modules. It is interpreted by goi on stage 0 until a re-seed lists it in goi's table."] [6 1 "// Object is a Python object. Every value the machine handles is an Object; its type is the object's"] [7 1 "// header (CPython's ob_type). Identity is Go's pointer identity, so every Object is a pointer, or the"] [8 1 "// singletons None, True, False and NotImplemented."] [13 1 "// Error is how a Go function of the runtime raises: a non-nil error is a Python exception in flight."] [14 1 "// Functions of the runtime return (Object, error); an error is always a *Raised (an exception object),"] [15 1 "// except errStopIteration, the iterator protocol's end without an object."] [18 2 "// Reraise is a re-raise (a bare raise, the IR's reraise): the frame it is raised in adds no"] [19 2 "// traceback entry, which it already has"] [21 2 "// monReraise: sys.monitoring's RERAISE in place of RAISE where the loop adds the frame's entry again (END_ASYNC_FOR's"] [22 2 "// re-raise; queue 281)"] [28 1 "// raise wraps an exception object as an error."] [31 1 "// Raise makes an exception of type t with a message and returns it as an error."] [34 1 "// Raisef is Raise with a formatted message."] [39 1 "// CompareOp is a rich comparison's operator, as CPython's Py_LT ... Py_GE."] [51 1 "// BinOp is a binary or in-place operator (the IR's :binary and :inplace ARG)."] [71 1 "// UnOp is a unary operator (the IR's :unary ARG)."] [80 1 "// BuiltinValueHook is PY5c's BuiltinValue: the built-in value an instance of a class deriving from a"] [81 1 "// built-in type keeps (o itself for any other object). The core types' accessors (asInt, AsStr, ...)"] [82 1 "// try it after their own cases, so a subclass's instance is accepted wherever its base is (§7.1)."] [92 1 "// BoundMethodHook is PY5c's: when o is a bound method of a Python function, the function and the"] [93 1 "// instance; the call operation then pushes the function's frame with the instance first, as for any"] [94 1 "// Python call (no nested run)."]] :go/pos {:name [4 9] :package [4 1]} :go/semis []} (go/file "object.go" :doc "Package py is pyi's runtime (doc/python/PYI-SPEC.md §6-§9; PYS7 (a), PYS8 (a)): Python's objects and\ntypes, the frame machine that runs the IR of arbace.python.compile on heap frames, and the built-in\nmodules. It is interpreted by goi on stage 0 until a re-seed lists it in goi's table.\n" :imports [])




^{:go/pos {:doc [6 1] :tok-pos [9 1]}} (go/type ^{:go/pos {:name-pos [9 6]}} Object "Object is a Python object. Every value the machine handles is an Object; its type is the object's\nheader (CPython's ob_type). Identity is Go's pointer identity, so every Object is a pointer, or the\nsingletons None, True, False and NotImplemented.\n" ^{:go/pos {:interface [9 13] :lbrace [9 23] :rbrace [11 1]}} (interface
    (^{:go/pos {:name-pos [10 2]}} Type ^{:tag ^{:go/pos {:star [10 9]}} (* ^{:go/pos {:name-pos [10 10]}} Type) :go/pos {:closing [10 7] :opening [10 6]}} [])))






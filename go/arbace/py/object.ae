;; Package py is pyi's runtime (doc/python/PYI-SPEC.md §6-§9; PYS7 (a), PYS8 (a)): Python's objects and
;; types, the frame machine that runs the IR of arbace.python.compile on heap frames, and the built-in
;; modules. It is interpreted by goi on stage 0 until a re-seed lists it in goi's table.
(in-ns 'go.arbace.py) ^{:go/comments [[1 1 "// Package py is pyi's runtime (doc/python/PYI-SPEC.md §6-§9; PYS7 (a), PYS8 (a)): Python's objects and"] [2 1 "// types, the frame machine that runs the IR of arbace.python.compile on heap frames, and the built-in"] [3 1 "// modules. It is interpreted by goi on stage 0 until a re-seed lists it in goi's table."] [6 1 "// Object is a Python object. Every value the machine handles is an Object; its type is the object's"] [7 1 "// header (CPython's ob_type). Identity is Go's pointer identity, so every Object is a pointer, or the"] [8 1 "// singletons None, True, False and NotImplemented."] [13 1 "// Error is how a Go function of the runtime raises: a non-nil error is a Python exception in flight."] [14 1 "// Functions of the runtime return (Object, error); an error is always a *Raised (an exception object),"] [15 1 "// except errStopIteration, the iterator protocol's end without an object."] [18 2 "// Reraise is a re-raise (a bare raise, the IR's reraise): the frame it is raised in adds no"] [19 2 "// traceback entry, which it already has"] [25 1 "// raise wraps an exception object as an error."] [28 1 "// Raise makes an exception of type t with a message and returns it as an error."] [31 1 "// Raisef is Raise with a formatted message."] [36 1 "// CompareOp is a rich comparison's operator, as CPython's Py_LT ... Py_GE."] [48 1 "// BinOp is a binary or in-place operator (the IR's :binary and :inplace ARG)."] [68 1 "// UnOp is a unary operator (the IR's :unary ARG)."]] :go/pos {:name [4 9] :package [4 1]} :go/semis []} (go/file "object.go" :doc "Package py is pyi's runtime (doc/python/PYI-SPEC.md §6-§9; PYS7 (a), PYS8 (a)): Python's objects and\ntypes, the frame machine that runs the IR of arbace.python.compile on heap frames, and the built-in\nmodules. It is interpreted by goi on stage 0 until a re-seed lists it in goi's table.\n" :imports [])





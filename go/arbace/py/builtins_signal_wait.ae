9 1 "// writeInterruptible is os.write's write to a blocking descriptor that would block, as write(2) is under CPython's"] [160 1 "// handlers (no SA_RESTART: a signal interrupts it, os.write's PyErr_CheckSignals runs the handlers, PEP 475's retry;"] [161 1 "// py-mods-1122, test_io's SignalsTest.test_interrupted_write_*): in the main thread with a Python handler's wake pipe,"] [162 1 "// the descriptor polled for writing with the pipe (the GIL released), each write made non-blocking for its call"] [163 1 "// (O_NONBLOCK set and restored) so that it never blocks past the poll, until every byte is written; a signal's handler"] [164 1 "// that raises ends it with its exception (CPython's partial count then the handler's exception at the next check),"] [165 1 "// one that returns lets it go on. handled false: not such a write (another thread, no handler, a non-blocking"] [166 1 "// descriptor, nothing to write), written as before."] [180 11 "// the write reports it"] [209 3 "// the poll's own error: the rest written as before, its error reported"]] :go/pos {:name [3 9] :package [3 1]} :go/semis [[97 40] [103 39] [115 33] [127 48] [133 35] [149 91] [152 12] [152 22] [179 35] [190 67]]} (go/file "builtins_signal_wait.go" :build ["//go:build linux"] :imports [



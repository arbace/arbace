  ^{:go/apos {1 [24 26]}} [^{:tag ^{:go/pos {:name-pos [24 18]}} int32 :val 16 :go/pos {:name-pos [24 2]}} breakMonitor 16] ; a sys.monitoring tool has events (queue 220: monitoring.go's frame starts; 16, as 218's finalizers took 8)
  [^{:val 5000000 :go/pos {:name-pos [25 2]}} switchDefaultNs ^{:go/pos {:lparen [25 31] :rparen [25 52]}} (conv ^{:go/pos {:name-pos [25 26]}} int64 ^{:go/apos {1 [25 32]} :go/pos {:op-pos [25 34]}} (* 5 ^{:go/pos {:dot [25 40] :name-pos [25 41] :x-pos [25 36]}} time/Millisecond))])





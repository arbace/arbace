  ^{:go/apos {1 [21 26]}} [^{:tag ^{:go/pos {:name-pos [21 18]}} int32 :val 2 :go/pos {:name-pos [21 2]}} breakSignals 2] ; a signal is pending (handled on the main thread)
  ^{:go/apos {1 [22 26]}} [^{:tag ^{:go/pos {:name-pos [22 18]}} int32 :val 4 :go/pos {:name-pos [22 2]}} breakAsyncExc 4] ; a thread has an asynchronous exception (unused)

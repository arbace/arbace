  ^{:go/apos {1 [21 26]}} [^{:tag ^{:go/pos {:name-pos [21 18]}} int32 :val 2 :go/pos {:name-pos [21 2]}} breakSignals 2] ; a signal is pending (handled on the main thread)
  ^{:go/apos {1 [22 26]}} [^{:tag ^{:go/pos {:name-pos [22 18]}} int32 :val 4 :go/pos {:name-pos [22 2]}} breakAsyncExc 4] ; a thread has an asynchronous exception (PyThreadState_SetAsyncExc, queue 598)
  ^{:go/apos {1 [23 26]}} [^{:tag ^{:go/pos {:name-pos [23 18]}} int32 :val 8 :go/pos {:name-pos [23 2]}} breakFinalizers 8] ; finalize.go's queue holds dead objects (drained by the GIL's holder)
  ^{:go/apos {1 [24 26]}} [^{:tag ^{:go/pos {:name-pos [24 18]}} int32 :val 16 :go/pos {:name-pos [24 2]}} breakMonitor 16] ; a sys.monitoring tool has events (queue 220: monitoring.go's frame starts; 16, as 218's finalizers took 8)
  ^{:go/apos {1 [25 26]}} [^{:tag ^{:go/pos {:name-pos [25 18]}} int32 :val 32 :go/pos {:name-pos [25 2]}} breakPending 32] ; an interpreter has pending calls (_PY_CALLS_TO_DO_BIT; _testinternalcapi's, queue 605)
  [^{:val 5000000 :go/pos {:name-pos [26 2]}} switchDefaultNs ^{:go/pos {:lparen [26 31] :rparen [26 52]}} (conv ^{:go/pos {:name-pos [26 26]}} int64 ^{:go/apos {1 [26 32]} :go/pos {:op-pos [26 34]}} (* 5 ^{:go/pos {:dot [26 40] :name-pos [26 41] :x-pos [26 36]}} time/Millisecond))])





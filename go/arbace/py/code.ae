(in-ns 'go.arbace.py) ^{:go/comments [[3 1 "// Code is a code object as the machine runs it: the IR's map (doc/python/PYI-SPEC.md §3.1) loaded"] [4 1 "// once into Go values (load.go)."] [9 21 "// positional parameters, the positional-only ones among them"] [12 26 "// fast locals, the parameters first"] [13 26 "// cell variables"] [14 26 "// free variables (the closure's cells, after the cells)"] [15 26 "// global, name and attribute names"] [18 27 "// the exception table, innermost first, sorted by Start"] [19 27 "// each instruction's line, 0 when unknown"] [20 27 "// a *Str or nil"] [21 27 "// co_filename (SetFilename), \"\" when unknown"] [22 27 "// co_firstlineno (the IR's :firstlineno), 0 when the IR has none"] [23 2 "// Warnings are the compiler's SyntaxWarnings of a compile()d module (the IR's :warnings), the runtime's to emit"] [25 2 "// CellParams maps each cell that is also a parameter to its local slot (copied on entry: MAKE_CELL)."] [27 2 "// Native is the code's compiled body (PY8's AOT, aot.go), run by the loop in place of step; nil"] [28 2 "// runs the instructions."] [30 2 "// names as Strs, made once"] [32 2 "// stackHint is the largest value stack a frame of the code returned with, less the 2 newFrame adds (202b)"] [34 2 "// free are frames of the code's calls to reuse (frame.go's releaseFrame)"] [36 2 "// kwnames are the calls' keyword names by constant (eval.go's kwnamesAt)"] [38 2 "// attrICs are the attribute instructions' inline caches, by instruction (attr.go's lookupAttrAt)"] [40 2 "// globalICs are load-global's inline caches, by instruction (eval.go's loadGlobalAt; queue 210)"] [42 2 "// slots are the names f_locals' proxy reads, in co_localsplusnames' order (tbobj.go's frameSlots; queue 219)"] [48 1 "// compileWarning is a SyntaxWarning the compiler made: its message and location (1-based offsets, 0 unknown)."] [54 1 "// NativeFunc is a code object's compiled body (PY8's AOT, aot.go): it runs f from f.PC as step does"] [55 1 "// (the value returned, an error raised, or a *pushFrame for a call of a Python function)."] [58 1 "// CodeKind is the IR's :kind."] [73 1 "// CodeFlags are the IR's :flags."] [84 24 "// CO_ITERABLE_COROUTINE: a generator types.coroutine marked (set at run time, PY5d)"] [87 1 "// Instr is an instruction: the operation and its argument decoded into two integers (§7.2's table:"] [88 1 "// an index, a count, a jump target, an operator, a flag ...)."] [94 1 "// Handler is a row of the exception table: instructions [Start, End) go to Target with the stack"] [95 1 "// popped to Depth, then the instruction's index pushed when Lasti, then the exception."] [101 1 "// Make-function's parts (the IR's [CONST PARTS]), as a bit set in B."] [109 1 "// Intrinsic is the IR's :call-intrinsic NAME (§3.4)."] [130 1 "// handlerAt is the handler covering instruction pc, or nil."] [141 1 "// Line is instruction pc's line, 0 when unknown."] [149 1 "// OpNames is the IR's operations the loader knows, in Op order (bin/pyi runtime check compares them"] [150 1 "// with arbace.python.ir/ops)."] [153 1 "// OpOwners is each operation's owner (PYI-SPEC.md §9), in Op order."] [156 1 "// SetFilename sets the code object's co_filename and its nested code objects'."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[160 31]] :go/trails [[127 75]]} (go/file "code.go" :imports [])




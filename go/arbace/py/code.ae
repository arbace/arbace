(in-ns 'go.arbace.py) ^{:go/comments [[9 1 "// Code is a code object as the machine runs it: the IR's map (doc/python/PYI-SPEC.md §3.1) loaded"] [10 1 "// once into Go values (load.go)."] [15 21 "// positional parameters, the positional-only ones among them"] [18 26 "// fast locals, the parameters first"] [19 26 "// cell variables"] [20 26 "// free variables (the closure's cells, after the cells)"] [21 26 "// global, name and attribute names"] [24 27 "// the exception table, innermost first, sorted by Start"] [25 27 "// each instruction's line, 0 when unknown"] [26 27 "// a *Str or nil"] [27 27 "// co_filename (SetFilename), \"\" when unknown"] [28 27 "// co_firstlineno (the IR's :firstlineno), 0 when the IR has none"] [29 2 "// positionsText is the IR's :positions (PEP 657, queue 223), each instruction's columns, decoded into positions"] [30 2 "// on the first Position (a traceback's display, co_positions); \"\" when the IR has none"] [32 26 "// decoded under the GIL (Position runs with it held)"] [33 2 "// Warnings are the compiler's SyntaxWarnings of a compile()d module (the IR's :warnings), the runtime's to emit"] [35 2 "// CellParams maps each cell that is also a parameter to its local slot (copied on entry: MAKE_CELL)."] [37 2 "// Native is the code's compiled body (PY8's AOT, aot.go), run by the loop in place of step; nil"] [38 2 "// runs the instructions."] [40 2 "// names as Strs, made once"] [42 2 "// stackHint is the largest value stack a frame of the code returned with, less the 2 newFrame adds (202b)"] [44 2 "// free are frames of the code's calls to reuse (frame.go's releaseFrame)"] [46 2 "// kwnames are the calls' keyword names by constant (eval.go's kwnamesAt)"] [48 2 "// attrICs are the attribute instructions' inline caches, by instruction (attr.go's lookupAttrAt), each made at its"] [49 2 "// first use"] [51 2 "// globalICs are load-global's inline caches, by instruction (eval.go's loadGlobalAt; queue 210)"] [53 2 "// slots are the names f_locals' proxy reads, in co_localsplusnames' order (tbobj.go's frameSlots; queue 219)"] [55 2 "// lineStarts are the instructions that may start a line event, by instruction (trace.go's traceLines; queue 219t)"] [57 2 "// monLocal are the code's local sys.monitoring events by tool (set_local_events, monitoring.go; queue 281), nil for none"] [59 2 "// obj is the code's object (co_* attributes), one per code so that frame.f_code is func.__code__ (queue 219t)"] [61 2 "// parent is the code whose constant this is; imports, on a module's, the names its scope binds by import (queue 229)"] [64 2 "// view is CPython's bytecode of the code, made when asked (bytecode_asm.go)"] [66 26 "// the jumps flow! threaded (the IR's :threaded)"] [68 2 "// cimpl is whether the code is of the Python code that stands for CPython's C (cImplModules; trace.go's inCImpl,"] [69 2 "// queue 293): 0 not known yet, 1 not, 2 it is"] [75 1 "// codePos is an instruction's end line (less its line) and columns (0-based UTF-8 byte offsets), Col -1 when unknown:"] [76 1 "// co_positions' last three items (the first, the line, is Lines')."] [84 1 "// debugRanges is config.code_debug_ranges: false under -X no_debug_ranges or PYTHONNODEBUGRANGES (the code objects then"] [85 1 "// carry no columns: co_positions' None, no caret lines)"] [94 1 "// Position is instruction pc's location as co_positions gives it: line, end line, column, end column, each 0 when"] [95 1 "// unknown (ok false for the columns)."] [113 1 "// decodePositions reads positionsText: per instruction \"COL,END-COL[,END-LINE-LESS-LINE]\" or \"\" (no columns), \";\""] [114 1 "// between them (arbace.python.compile's positions-of). codePos.EndLine holds the end line less the line."] [140 1 "// compileWarning is a SyntaxWarning the compiler made: its message and location (1-based offsets, 0 unknown)."] [146 1 "// NativeFunc is a code object's compiled body (PY8's AOT, aot.go): it runs f from f.PC as step does"] [147 1 "// (the value returned, an error raised, or a *pushFrame for a call of a Python function)."] [150 1 "// CodeKind is the IR's :kind."] [165 1 "// CodeFlags are the IR's :flags."] [176 24 "// CO_ITERABLE_COROUTINE: a generator types.coroutine marked (set at run time, PY5d)"] [177 2 "// CodeFutureAnnotations and CodeFutureBarry: the source's (or the compile's inherited) from __future__ import"] [178 2 "// annotations and barry_as_FLUFL, co_flags' CO_FUTURE_ANNOTATIONS and CO_FUTURE_BARRY_AS_BDFL (py-os-1124)"] [183 1 "// coFutureMask are the future features compile() takes in its flags and a code's co_flags reports (PyCF_MASK's that"] [184 1 "// future.c sets: CO_FUTURE_BARRY_AS_BDFL, CO_FUTURE_ANNOTATIONS)."] [187 1 "// futureMode is a compile mode with the future features of flags (co_flags' bits) the compile inherits (py-os-1124): +futA"] [188 1 "// for annotations, +futB for barry_as_FLUFL (the host's compile-source binds the reader's and the compiler's features)."] [199 1 "// Instr is an instruction: the operation and its argument decoded into two integers (§7.2's table:"] [200 1 "// an index, a count, a jump target, an operator, a flag ...)."] [206 1 "// Handler is a row of the exception table: instructions [Start, End) go to Target with the stack"] [207 1 "// popped to Depth, then the instruction's index pushed when Lasti, then the exception."] [213 1 "// Make-function's parts (the IR's [CONST PARTS]), as a bit set in B."] [221 1 "// Intrinsic is the IR's :call-intrinsic NAME (§3.4)."] [242 1 "// Type makes a Code a node of the cycle collection (finalize.go's cyTraverse, py-small-1127): the code object's type;"] [243 1 "// a Code is never a Python value itself (Object gives its code object)."] [246 1 "// Object is c's code object, the same each time (f_code, __code__, gi_code: CPython's one PyCodeObject; queue 219t)."] [254 1 "// handlerAt is the handler covering instruction pc, or nil."] [265 1 "// Line is instruction pc's line, 0 when unknown (-1: none, in a replaced line table)."] [268 3 "// a replaced line table (queue 248): the view's line of the instruction's code unit, -1 for none"] [273 14 "// past the table's end"] [283 1 "// OpNames is the IR's operations the loader knows, in Op order (bin/pyi runtime check compares them"] [284 1 "// with arbace.python.ir/ops)."] [287 1 "// OpOwners is each operation's owner (PYI-SPEC.md §9), in Op order."] [290 1 "// SetFilename sets the code object's co_filename and its nested code objects'."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[106 26] [267 16] [270 29] [294 31]] :go/trails [[239 75]]} (go/file "code.go" :imports [



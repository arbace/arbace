(in-ns 'go.arbace.py) ^{:go/comments [[3 1 "// Generators (doc/python/PYI-SPEC.md §7.4-§7.5; the survey's PYS7 (a); PY5d): a generator, a"] [4 1 "// coroutine and an async generator are the frame of their function's call kept between resumptions."] [5 1 "// The call makes the object without running the frame (newGeneratorHook); each resumption runs the"] [6 1 "// kept frame by (*Thread).run as an entry frame, a yield (yield-value, or yield-from delegating)"] [7 1 "// returns from the loop with Frame.Suspended set, and the frame's handler table sees an exception"] [8 1 "// thrown in at the instruction it is suspended at (Lasti). CPython's Objects/genobject.c and the"] [9 1 "// YIELD_VALUE, SEND and RETURN_GENERATOR parts of Python/bytecodes.c."] [26 1 "// Generator is a generator, a coroutine or an async generator (CPython's PyGenObject, PyCoroObject"] [27 1 "// and PyAsyncGenObject): the kept frame of its function's call."] [30 18 "// nil once finished (gi_frame None)"] [32 18 "// __name__, the function's"] [33 18 "// __qualname__"] [34 18 "// run at least once (FRAME_CREATED otherwise)"] [35 18 "// gi_running"] [36 2 "// handled is the exception the frame is handling while it is suspended (gi_exc_state), nil when none."] [38 2 "// origin is cr_origin: the frames that created a coroutine while origin tracking was on, nil otherwise"] [40 2 "// the async generator's state (PyAsyncGenObject)"] [41 20 "// ag_closed"] [42 20 "// ag_running_async: an asend or athrow awaits it"] [43 20 "// ag_hooks_inited: sys's firstiter hook called (PY6h's REQUEST, queue 200)"] [44 2 "// finalizer is sys's asyncgen finalizer hook at its first use (ag_origin_or_finalizer), nil when none"] [46 2 "// finTracked: its finalization is due at its death (finalize.go's workGen, queue 218)"] [48 2 "// finPending: in finalize.go's pendingGens, tracked at the flush when still not finished"] [62 1 "// newGenerator is a call's object of a function whose code is a generator's, a coroutine's or an"] [63 1 "// async generator's: f bound, not run."] [76 3 "// a coroutine never awaited warns at its death (_PyGen_Finalize; queue 218): tracked only if still not started"] [77 3 "// when the pending list is flushed (most are awaited at once)"] [85 1 "// genThrow is an exception thrown into a suspended frame: the resumption runs the frame's"] [86 1 "// yield-value or yield-from again (its PC set back to Lasti), which finds it here and raises it"] [87 1 "// there (yield-from first throws it into its delegate), so the frame's handlers see it at the"] [88 1 "// suspension point. One thread runs at a time, and the frame's first instruction run is that one."] [92 20 "// a GeneratorExit closes the delegate (false: aclose's, thrown into it)"] [95 1 "// genSuspendedAt is the operation f is suspended at, when it is."] [103 1 "// yieldFrom is the delegate the generator is suspended in (gi_yieldfrom), or nil."] [111 1 "// resume runs g with v sent into it (exc nil) or exc thrown into it (gen_send_ex2): the value it"] [112 1 "// yields (yielded non-nil), or the value it returns (returned, the generator finished), or what it"] [113 1 "// raises (err; a StopIteration raised in it is a RuntimeError, PEP 479)."] [122 4 "// throw() into an exhausted coroutine is a reuse (gen_send_ex2), close()'s GeneratorExit is not"] [135 4 "// thrown into a generator not started: raised at its start, it finishes"] [151 2 "// the generator's own exception slot over the resuming level's (gi_exc_state pushed on the exc_info stack)"] [169 3 "// a generator suspended where a handler can see close()'s GeneratorExit is closed at its death (queue 218)"] [185 1 "// stopIterationError is PEP 479's RuntimeError for a StopIteration (or, in an async generator, a"] [186 1 "// StopAsyncIteration) raised out of g's frame: its cause and context the exception, its traceback g's"] [187 1 "// frame's entry (CPython raises it in the frame, INTRINSIC_STOPITERATION_ERROR)."] [211 1 "// newStopIteration is StopIteration(v), with no arguments when v is None (gen_send_ex's)."] [219 1 "// stopIterationValue is a raised StopIteration's value (_PyGen_FetchStopIterationValue), ok false when"] [220 1 "// err is not one."] [232 1 "// isRaised is err a raised exception of type typ (or a subtype)."] [238 1 "// send is g.send(v): what it yields, or StopIteration with what it returns."] [250 1 "// throw is g.throw(exc), exc already an exception."] [262 1 "// close is g.close() (gen_close): GeneratorExit thrown in; its return value when it returns."] [284 1 "// throwArgs is throw's arguments as the exception to raise (_gen_throw's normalization): an"] [285 1 "// instance, or a class called with the value (none, an instance of it, a tuple of arguments, or the"] [286 1 "// one argument). The (type, value, traceback) signature is deprecated, not refused."] [327 1 "// genSendTo is a send into an iterator delegated to (SEND): a generator's or coroutine's resume, else"] [328 1 "// __next__ when v is None, else its send method; yielded non-nil, or the value it returned (a"] [329 1 "// StopIteration's, or None at an iterator's end)."] [355 1 "// genThrowTo throws exc into a delegate (_gen_throw's yf part): a GeneratorExit closes it (when"] [356 1 "// closeOnGenEx) and is raised in the delegating frame; else its throw, when it has one (handled false:"] [357 1 "// raise exc in the delegating frame)."] [386 1 "// genCloseIter closes a delegate (gen_close_iter): a generator's or coroutine's close, else its close"] [387 1 "// method when it has one."] [404 1 "// asyncGenWrapped is a value an async generator yields (CPython's _PyAsyncGenWrappedValue): its asend"] [405 1 "// and athrow see it apart from the values its awaits yield to the event loop."] [410 1 "// opYieldValue is yield-value: the value popped and yielded (wrapped in an async generator), f kept"] [411 1 "// suspended; resumed, the value sent is on the stack (pushed by resume), or an exception thrown in is"] [412 1 "// raised here."] [428 1 "// chainStackItem is _PyErr_ChainStackItem (gen_send_ex2 with an exception, queue 223): an exception thrown into a"] [429 1 "// generator's frame takes the exception being handled as its __context__ (_PyErr_SetObject's chaining) when the"] [430 1 "// generator's own exception state, pushed at its resumption, holds one."] [439 1 "// opYieldFrom is yield-from ([receiver value] -> its return value): CPython's SEND, YIELD_VALUE and"] [440 1 "// END_SEND loop as one operation. Each value the receiver yields suspends f with the instruction run"] [441 1 "// again on resumption (PC set back to it), the receiver kept below and the sent value pushed on it."] [448 11 "// the placeholder resume pushed"] [456 4 "// the delegate raised: _gen_throw's termination repetition, the error entering this frame"] [471 54 "// the delegate's end: STOP_ITERATION, or RAISE (queue 219t)"] [482 1 "// opGetYieldFromIter is get-yield-from-iter: a generator or a coroutine as it is (a coroutine only in a"] [483 1 "// coroutine's code), else iter(o)."] [502 1 "// genMethods are the methods of the types of PY5d's files, put into their dictionaries by d5Ready"] [503 1 "// (lazily: a dictionary's keys need str's hash, which str.go's init sets after these files' inits)."] [510 1 "// d5Method declares a method of a type of PY5d's: name in t's dictionary as a built-in method."] [521 1 "// d5Ready fills the dictionaries of PY5d's types with their methods, once (each of their GetAttr"] [522 1 "// slots and operations calls it first)."] [543 1 "// d5GetAttr is the GetAttr slot of PY5d's types: their methods ready, then extra (attributes not in"] [544 1 "// the dictionary), then object's lookup."] [557 1 "// d5Args checks a method's argument count: between min and max positional, no keywords."] [573 1 "// coroOriginDepth is sys.set_coroutine_origin_tracking_depth's depth (0: off)."] [576 1 "// coroOrigin is compute_cr_origin: (filename, lineno, function name) of the creating frame and up to depth-1 of its"] [577 1 "// callers, innermost first."] [593 1 "// genRepr is \"<KIND object QUALNAME at 0x...>\", the address an identity number."] [600 1 "// genAttrs are the attributes a generator, coroutine or async generator answers outside its"] [601 1 "// dictionary (prefix gi_, cr_ or ag_)."] [653 2 "// Next ends without the return value: the loop's for-iter and the abstract Next do not clear a"] [654 2 "// raised StopIteration yet (asked of PY5b and PY5c); __next__ and send raise it with the value."] [671 1 "// d5GenMethods declares send, throw and close of a generator or a coroutine."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[70 61] [105 38] [204 26] [304 32] [308 30] [331 31] [339 44] [344 38] [360 31] [365 31] [378 38] [389 31] [473 42] [486 28] [549 35] [581 18] [581 50] [584 54] [633 25] [660 62] [674 54] [690 55]]} (go/file "gen.go" :imports [])

;; Generators (doc/python/PYI-SPEC.md §7.4-§7.5; the survey's PYS7 (a); PY5d): a generator, a
;; coroutine and an async generator are the frame of their function's call kept between resumptions.
;; The call makes the object without running the frame (newGeneratorHook); each resumption runs the
;; kept frame by (*Thread).run as an entry frame, a yield (yield-value, or yield-from delegating)
;; returns from the loop with Frame.Suspended set, and the frame's handler table sees an exception
;; thrown in at the instruction it is suspended at (Lasti). CPython's Objects/genobject.c and the
;; YIELD_VALUE, SEND and RETURN_GENERATOR parts of Python/bytecodes.c.


e ndigits rounding to tens, hundreds ..."] [910 2 "// the exact decimal value of x, rounded half-even at n places after the point"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[20 48] [26 49] [36 47] [54 46] [60 48] [70 52] [85 41] [95 38] [104 41] [117 41] [133 52] [139 51] [171 31] [210 59] [214 32] [225 35] [252 46] [256 22] [266 28] [269 43] [299 34] [319 44] [374 45] [397 43] [411 43] [425 46] [442 46] [457 45] [465 23] [479 39] [486 49] [489 50] [495 37] [517 59] [551 25] [567 20] [567 28] [579 32] [604 40] [607 43] [622 37] [625 40] [638 37] [641 40] [711 44] [739 37] [742 40] [748 31] [764 36] [767 39] [777 24] [786 54] [794 44] [811 47] [812 27] [830 38] [833 41] [843 44] [847 33] [856 32] [920 30]]} (go/file "builtins.go" :imports [



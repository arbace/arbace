ii)"] [828 1 "// clinicStrArg is clinic's str converter's checks (PyUnicode_AsUTF8AndSize, then the NUL check): a lone surrogate a"] [829 1 "// UnicodeEncodeError, an embedded NUL a ValueError, as str.encode's and bytes.decode's encoding and errors are (email's"] [830 1 "// _encoded_words: a charset with surrogateescape'd bytes is a CharsetError, not a decode as utf-8)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[81 27] [81 34] [154 29] [202 22] [202 24] [213 14] [213 16] [227 46] [249 46] [258 48] [260 45] [268 34] [342 31] [373 47] [409 40] [425 32] [440 36] [462 35] [487 40] [537 42] [593 30] [601 40] [635 14] [635 24] [649 42] [669 47] [698 53] [708 53] [724 31] [735 16] [735 23] [761 29] [771 29] [789 29] [799 29] [816 30] [833 39]]} (go/file "strmethods.go" :imports [



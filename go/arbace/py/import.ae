(in-ns 'go.arbace.py) ^{:go/comments [[10 1 "// The import system (PY5e; PYI-SPEC.md §9's single-file imports): import-name, import-from and"] [11 1 "// import-star, and builtins.__import__, after importlib._bootstrap's __import__, _gcd_import,"] [12 1 "// _find_and_load and _handle_fromlist. A module is found on sys.path (a package's submodules on its"] [13 1 "// __path__): DIR/NAME/__init__.py (a package), DIR/NAME.py, else DIR/NAME as a namespace package; its"] [14 1 "// source is compiled to the IR by the host (SetCompiler: the reader and arbace.python.compile) and run"] [15 1 "// as the module's body. The built-in modules are builtins and sys; the C modules of CPython are PY6's"] [16 1 "// Go ports (survey §6.6), so their import is a ModuleNotFoundError until then. importlib._bootstrap as"] [17 1 "// the import system itself (PYS12) is PY6's: no finders, loaders or specs yet (__spec__ is None)."] [19 1 "// builtinModuleNames are sys.builtin_module_names."] [22 1 "// compileHook compiles a module's source text to the IR's text (arbace.python/ir-text); mode is \"exec\""] [23 1 "// or \"single\" (the REPL's). Any other result than a code object's map is an error \"Type: message\", or"] [24 1 "// \"incomplete\" for an interactive statement that needs more lines."] [27 1 "// SetCompiler sets the host's compiler of Python source (bin/pyi's host, arbace.python.run)."] [30 1 "// compileSource compiles source text by the host's compiler into a code object."] [55 1 "// errIncomplete is an interactive statement that needs more lines (codeop's incomplete input)."] [93 1 "// builtinImport is __import__(name, globals=None, locals=None, fromlist=(), level=0)."] [132 1 "// importName is IMPORT_NAME (importlib's __import__): the module named, relative to globals' package by"] [133 1 "// level; with an empty fromlist the top-level package of the name, else the module with fromlist's"] [134 1 "// submodules imported."] [178 1 "// handleFromlist imports the submodules a package's fromlist names (_handle_fromlist)."] [219 1 "// importFrom is IMPORT_FROM: module.name, else the submodule module.name already in sys.modules (a"] [220 1 "// circular import), else an ImportError."] [250 1 "// importStar is IMPORT_STAR: __all__'s names, else the module's public names, into ns."] [290 1 "// packageOf is the package a relative import is relative to (_calc___package__)."] [314 1 "// resolveName is _resolve_name: name relative to package by level."] [330 1 "// importModule is _gcd_import: the module of the absolute name, its parents imported first."] [396 1 "// findAndLoad finds the module child (fully name) in the directories of search and runs it."] [432 1 "// loadSource compiles a module's source file and runs it as name (a package when path is not nil)."] [482 1 "// notFound is ModuleNotFoundError(msg) for the module name (its .name, ImportError's attribute)."] [499 1 "// moduleDict is a module's namespace (a *Module's Dict), else nil."] [512 1 "// moduleName is a module's __name__, \"\" when it has none."] [528 1 "// modulePath is a module's __path__ (a package's), nil for a plain module."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[104 26] [142 46] [171 52] [203 31] [209 37] [210 29] [231 56] [239 27] [240 47] [263 24] [275 4] [283 25] [295 44] [297 40] [332 41] [339 38] [349 42] [358 24] [362 5] [374 42] [376 25] [389 32] [404 30] [412 23] [450 45] [492 43] [501 26] [504 45] [505 25] [514 26] [515 48] [520 45] [521 23] [530 26] [533 45]]} (go/file "import.go" :imports [



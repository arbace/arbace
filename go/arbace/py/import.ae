(in-ns 'go.arbace.py) ^{:go/comments [[10 1 "// The import system (PY5e; PYI-SPEC.md §9's single-file imports): import-name, import-from and"] [11 1 "// import-star, and builtins.__import__, after importlib._bootstrap's __import__, _gcd_import,"] [12 1 "// _find_and_load and _handle_fromlist. A module is found on sys.path (a package's submodules on its"] [13 1 "// __path__): DIR/NAME/__init__.py (a package), DIR/NAME.py, else DIR/NAME as a namespace package; its"] [14 1 "// source is compiled to the IR by the host (SetCompiler: the reader and arbace.python.compile) and run"] [15 1 "// as the module's body. The built-in modules are builtins and sys; the C modules of CPython are PY6's"] [16 1 "// Go ports (survey §6.6), so their import is a ModuleNotFoundError until then. importlib._bootstrap as"] [17 1 "// the import system itself (PYS12) is PY6's: no finders, loaders or specs yet (__spec__ is None)."] [19 1 "// builtinModuleNames are sys.builtin_module_names."] [22 1 "// builtinModules make the built-in modules other than builtins and sys, once per interpreter (their files'"] [23 1 "// init functions fill it: _string's builtins_string.go, _weakref's builtins_weakref.go)."] [26 1 "// builtinModulesErr are the built-in modules whose making may raise (those that run Python's machinery:"] [27 1 "// _ast's classes through type())."] [30 1 "// compileHook compiles a module's source text to the IR's text (arbace.python/ir-text); mode is \"exec\""] [31 1 "// or \"single\" (the REPL's). Any other result than a code object's map is an error \"Type: message\", or"] [32 1 "// \"incomplete\" for an interactive statement that needs more lines."] [35 1 "// SetCompiler sets the host's compiler of Python source (bin/pyi's host, arbace.python.run)."] [38 1 "// compileSource compiles source text by the host's compiler into a code object."] [61 1 "// syntaxError is the SyntaxError of the compiler's answer \"MSG\\x00LINE\\x00OFFSET\\x00END_LINE\\x00END_OFFSET\""] [62 1 "// (the location's parts empty or absent when unknown): its fields filename, lineno, offset, text (the"] [63 1 "// source line), end_lineno and end_offset, as CPython's compile() raises it."] [91 1 "// errIncomplete is an interactive statement that needs more lines (codeop's incomplete input)."] [104 4 "// builtins.__import__ replaced: called as CPython's import_name calls it"] [145 1 "// builtinImportFn is the runtime's builtins.__import__."] [148 1 "// isBuiltinImport is whether o is the runtime's builtins.__import__."] [151 1 "// builtinImport is __import__(name, globals=None, locals=None, fromlist=(), level=0)."] [190 1 "// importName is IMPORT_NAME (importlib's __import__): the module named, relative to globals' package by"] [191 1 "// level; with an empty fromlist the top-level package of the name, else the module with fromlist's"] [192 1 "// submodules imported."] [253 1 "// handleFromlist imports the submodules a package's fromlist names (_handle_fromlist)."] [286 5 "// _handle_fromlist: a missing submodule is skipped, unless sys.modules blocks it with None"] [297 1 "// importFrom is IMPORT_FROM: module.name, else the submodule module.name already in sys.modules (a"] [298 1 "// circular import), else an ImportError."] [336 2 "// import_from's ImportError: name the module, path its file, name_from the name (PY6b's request)"] [345 1 "// importStar is IMPORT_STAR: __all__'s names, else the module's public names, into ns."] [394 1 "// packageOf is the package a relative import is relative to (import.c's resolve_name, _calc___package__):"] [395 1 "// __package__, checked against __spec__.parent; else __spec__.parent; else, with an ImportWarning, __name__"] [396 1 "// (itself for a package)."] [456 1 "// resolveName is _resolve_name: name relative to package by level."] [472 1 "// importModule is _gcd_import: the module of the absolute name, its parents imported first."] [536 1 "// importBuiltin makes the built-in module name and puts it in sys.modules (ok false when name is not one):"] [537 1 "// the runtime's own import of them, and _imp.create_builtin's under importlib (PY6b)."] [563 1 "// findAndLoad finds the module child (fully name) in the directories of search and runs it."] [599 1 "// loadSource compiles a module's source file and runs it as name (a package when path is not nil)."] [649 1 "// notFound is ModuleNotFoundError(msg) for the module name (its .name, ImportError's attribute)."] [669 1 "// moduleDict is a module's namespace (a *Module's Dict), else nil."] [682 1 "// moduleName is a module's __name__, \"\" when it has none."] [698 1 "// modulePath is a module's __path__ (a package's), nil for a plain module."] [714 1 "// The runtime's import system seen by importlib (PY6a): sys.meta_path holds pyiFinder, whose find_spec imports"] [715 1 "// the module by the runtime's own finder (sys.path, packages, the built-in modules) and answers a"] [716 1 "// ModuleSpec of importlib._bootstrap whose loader hands that module over, so importlib.import_module and"] [717 1 "// importlib.util.find_spec work beside the import statement. importlib._bootstrap as the import system itself"] [718 1 "// is the import family's (PY6)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[68 39] [75 27] [76 23] [103 44] [162 26] [208 46] [246 52] [278 31] [284 37] [285 29] [287 44] [309 56] [319 27] [320 47] [324 39] [325 55] [379 4] [387 25] [418 83] [436 134] [474 41] [480 53] [484 38] [494 42] [503 24] [507 5] [511 42] [514 42] [516 25] [529 32] [547 31] [552 34] [571 30] [579 23] [617 45] [658 36] [662 43] [671 26] [674 45] [675 25] [684 26] [685 48] [690 45] [691 23] [700 26] [703 45] [744 29] [758 24] [759 32] [767 24] [768 68]]} (go/file "import.go" :imports [



h an empty fromlist the top-level package of the name, else the module with fromlist's"] [138 1 "// submodules imported."] [182 1 "// handleFromlist imports the submodules a package's fromlist names (_handle_fromlist)."] [223 1 "// importFrom is IMPORT_FROM: module.name, else the submodule module.name already in sys.modules (a"] [224 1 "// circular import), else an ImportError."] [254 1 "// importStar is IMPORT_STAR: __all__'s names, else the module's public names, into ns."] [294 1 "// packageOf is the package a relative import is relative to (_calc___package__)."] [318 1 "// resolveName is _resolve_name: name relative to package by level."] [334 1 "// importModule is _gcd_import: the module of the absolute name, its parents imported first."] [405 1 "// findAndLoad finds the module child (fully name) in the directories of search and runs it."] [441 1 "// loadSource compiles a module's source file and runs it as name (a package when path is not nil)."] [491 1 "// notFound is ModuleNotFoundError(msg) for the module name (its .name, ImportError's attribute)."] [508 1 "// moduleDict is a module's namespace (a *Module's Dict), else nil."] [521 1 "// moduleName is a module's __name__, \"\" when it has none."] [537 1 "// modulePath is a module's __path__ (a package's), nil for a plain module."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[108 26] [146 46] [175 52] [207 31] [213 37] [214 29] [235 56] [243 27] [244 47] [267 24] [279 4] [287 25] [299 44] [301 40] [336 41] [343 38] [353 42] [362 24] [366 5] [378 32] [383 42] [385 25] [398 32] [413 30] [421 23] [459 45] [501 43] [510 26] [513 45] [514 25] [523 26] [524 48] [529 45] [530 23] [539 26] [542 45]]} (go/file "import.go" :imports [



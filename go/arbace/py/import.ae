(in-ns 'go.arbace.py) ^{:go/comments [[10 1 "// The import system (PY5e; PYI-SPEC.md §9's single-file imports): import-name, import-from and"] [11 1 "// import-star, and builtins.__import__, after importlib._bootstrap's __import__, _gcd_import,"] [12 1 "// _find_and_load and _handle_fromlist. A module is found on sys.path (a package's submodules on its"] [13 1 "// __path__): DIR/NAME/__init__.py (a package), DIR/NAME.py, else DIR/NAME as a namespace package; its"] [14 1 "// source is compiled to the IR by the host (SetCompiler: the reader and arbace.python.compile) and run"] [15 1 "// as the module's body. The built-in modules are builtins and sys; the C modules of CPython are PY6's"] [16 1 "// Go ports (survey §6.6), so their import is a ModuleNotFoundError until then. importlib._bootstrap as"] [17 1 "// the import system itself (PYS12) is PY6's: no finders, loaders or specs yet (__spec__ is None)."] [19 1 "// builtinModuleNames are sys.builtin_module_names."] [22 1 "// builtinModules make the built-in modules other than builtins and sys, once per interpreter (their files'"] [23 1 "// init functions fill it: _string's builtins_string.go, _weakref's builtins_weakref.go)."] [26 1 "// builtinModulesErr are the built-in modules whose making may raise (those that run Python's machinery:"] [27 1 "// _ast's classes through type())."] [30 1 "// compileHook compiles a module's source text to the IR's text (arbace.python/ir-text); mode is \"exec\""] [31 1 "// or \"single\" (the REPL's). Any other result than a code object's map is an error \"Type: message\", or"] [32 1 "// \"incomplete\" for an interactive statement that needs more lines."] [35 1 "// SetCompiler sets the host's compiler of Python source (bin/pyi's host, arbace.python.run)."] [38 1 "// compileSource compiles source text by the host's compiler into a code object."] [65 1 "// syntaxError is the SyntaxError (IndentationError, TabError) of the compiler's answer"] [66 1 "// \"MSG\\x00LINE\\x00OFFSET\\x00END_LINE\\x00END_OFFSET\\x00KIND[\\x00TEXT]\" (the location's parts empty when unknown): its"] [67 1 "// fields filename, lineno, offset, text, end_lineno and end_offset, as CPython's compile() raises it. The text: a"] [68 1 "// parser's error (KIND p) the line as the parser gives it (TEXT, None when absent); a compiler's (KIND c) the line"] [69 1 "// of the file when it reads (PyErr_ProgramTextObject: None for \"<string>\"); an answer of no kind the source's line."] [119 1 "// emitCompileWarnings is _PyErr_EmitSyntaxWarning for each of the compiler's warnings, in order:"] [120 1 "// warnings.warn_explicit(msg, SyntaxWarning, file, line); a SyntaxWarning a filter turns into an error becomes"] [121 1 "// the SyntaxError of its location, the compile's result."] [162 1 "// errIncomplete is an interactive statement that needs more lines (codeop's incomplete input)."] [200 1 "// builtinImport is __import__(name, globals=None, locals=None, fromlist=(), level=0)."] [239 1 "// importName is IMPORT_NAME (importlib's __import__): the module named, relative to globals' package by"] [240 1 "// level; with an empty fromlist the top-level package of the name, else the module with fromlist's"] [241 1 "// submodules imported."] [285 1 "// handleFromlist imports the submodules a package's fromlist names (_handle_fromlist)."] [326 1 "// importFrom is IMPORT_FROM: module.name, else the submodule module.name already in sys.modules (a"] [327 1 "// circular import), else an ImportError."] [357 1 "// importStar is IMPORT_STAR: __all__'s names, else the module's public names, into ns."] [397 1 "// packageOf is the package a relative import is relative to (_calc___package__)."] [421 1 "// resolveName is _resolve_name: name relative to package by level."] [437 1 "// importModule is _gcd_import: the module of the absolute name, its parents imported first."] [516 1 "// findAndLoad finds the module child (fully name) in the directories of search and runs it."] [552 1 "// loadSource compiles a module's source file and runs it as name (a package when path is not nil)."] [602 1 "// notFound is ModuleNotFoundError(msg) for the module name (its .name, ImportError's attribute)."] [619 1 "// moduleDict is a module's namespace (a *Module's Dict), else nil."] [632 1 "// moduleName is a module's __name__, \"\" when it has none."] [648 1 "// modulePath is a module's __path__ (a package's), nil for a plain module."] [664 1 "// The runtime's import system seen by importlib (PY6a): sys.meta_path holds pyiFinder, whose find_spec imports"] [665 1 "// the module by the runtime's own finder (sys.path, packages, the built-in modules) and answers a"] [666 1 "// ModuleSpec of importlib._bootstrap whose loader hands that module over, so importlib.import_module and"] [667 1 "// importlib.util.find_spec work beside the import statement. importlib._bootstrap as the import system itself"] [668 1 "// is the import family's (PY6)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[74 39] [81 28] [82 24] [98 33] [141 111] [142 29] [144 36] [211 26] [249 46] [278 52] [310 31] [316 37] [317 29] [338 56] [346 27] [347 47] [370 24] [382 4] [390 25] [402 44] [404 40] [439 41] [446 38] [456 42] [465 24] [469 5] [481 32] [486 35] [494 42] [496 25] [509 32] [524 30] [532 23] [570 45] [612 43] [621 26] [624 45] [625 25] [634 26] [635 48] [640 45] [641 23] [650 26] [653 45] [694 29] [708 24] [709 32] [717 24] [718 68]]} (go/file "import.go" :imports [



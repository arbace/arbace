nce: the parse ends there, queue 228)."] [206 4 "// _PyPegen_number_token: a decimal literal over sys.set_int_max_str_digits's limit, which is the run's: the"] [207 4 "// reader records the digits of one past the lowest limit (p[1]) and the error's location"] [217 21 "// a compiler's warning: PyErr_ProgramTextObject's line"] [228 1 "// compileModuleName is 3.15's compile(..., module=NAME) while that compile runs (nil: none): the warnings' module"] [229 1 "// (_PyErr_EmitSyntaxWarning's PyErr_WarnExplicitObject(..., module, NULL); queue 239)"] [232 1 "// emitCompileWarnings is _PyErr_EmitSyntaxWarning for each of the compiler's warnings, in order:"] [233 1 "// warnings.warn_explicit(msg, SyntaxWarning, file, line); a SyntaxWarning a filter turns into an error becomes"] [234 1 "// the SyntaxError of its location, the compile's result."] [280 1 "// isIncomplete reports an interactive statement that needs more lines (codeop's incomplete input):"] [281 1 "// (PY7: a fresh _IncompleteInputError each time, isIncomplete tells it)"] [297 4 "// 3.15 (queue 239): _PyEval_LazyImportName, unless the compiler forced the import eager"] [332 1 "// eagerImportName is IMPORT_NAME's eager import (_PyEval_ImportName): builtins.__import__ called, or the runtime's."] [335 3 "// builtins.__import__ replaced: called as CPython's import_name calls it"] [356 4 "// a mapping's namespace (a dict subclass's, exec's mapping; queue 219): the names stored through it"] [370 1 "// builtinImportFn is the runtime's builtins.__import__."] [373 1 "// isBuiltinImport is whether o is the runtime's builtins.__import__."] [376 1 "// builtinImport is __import__(name, globals=None, locals=None, fromlist=(), level=0)."] [415 1 "// importName is IMPORT_NAME (importlib's __import__): the module named, relative to globals' package by"] [416 1 "// level; with an empty fromlist the top-level package of the name, else the module with fromlist's"] [417 1 "// submodules imported."] [446 3 "// PyImport_ImportModuleLevelObject: an imported module's pending registration on its parent settled (3.15)"] [491 1 "// handleFromlist imports the submodules a package's fromlist names (_handle_fromlist)."] [524 5 "// _handle_fromlist: a missing submodule is skipped, unless sys.modules blocks it with None"] [535 1 "// importFrom is IMPORT_FROM: module.name, else the submodule module.name already in sys.modules (a"] [536 1 "// circular import), else an ImportError."] [568 3 "// import_from's shadowing messages (ceval.c, queue 223): the spec's file origin, else __file__"] [588 2 "// import_from's ImportError: name the module, path its file, name_from the name (PY6b's request)"] [597 1 "// importStar is IMPORT_STAR: __all__'s names, else the module's public names, into ns."] [646 1 "// packageOf is the package a relative import is relative to (import.c's resolve_name, _calc___package__):"] [647 1 "// __package__, checked against __spec__.parent; else __spec__.parent; else, with an ImportWarning, __name__"] [648 1 "// (itself for a package)."] [708 1 "// resolveName is _resolve_name: name relative to package by level."] [724 1 "// importModule is _gcd_import: the module of the absolute name, its parents imported first."] [734 4 "// 3.15's _bootstrap calls _imp._set_lazy_attributes after a load (queue 239)"] [797 1 "// importBuiltin makes the built-in module name and puts it in sys.modules (ok false when name is not one):"] [798 1 "// the runtime's own import of them, and _imp.create_builtin's under importlib (PY6b)."] [808 23 "// a module whose Go package the host loads on demand (pyexpat)"] [811 25 "// PY6d's R5: the built-in functions' __module__"] [827 1 "// findAndLoad finds the module child (fully name) in the directories of search and runs it."] [863 1 "// loadSource compiles a module's source file and runs it as name (a package when path is not nil)."] [876 32 "// 3.15 no longer sets __cached__"] [915 1 "// notFound is ModuleNotFoundError(msg) for the module name (its .name, ImportError's attribute)."] [935 1 "// moduleDict is a module's namespace (a *Module's Dict), else nil."] [948 1 "// moduleName is a module's __name__, \"\" when it has none."] [964 1 "// modulePath is a module's __path__ (a package's), nil for a plain module."] [980 1 "// The runtime's import system seen by importlib (PY6a): sys.meta_path holds pyiFinder, whose find_spec imports"] [981 1 "// the module by the runtime's own finder (sys.path, packages, the built-in modules) and answers a"] [982 1 "// ModuleSpec of importlib._bootstrap whose loader hands that module over, so importlib.import_module and"] [983 1 "// importlib.util.find_spec work beside the import statement. importlib._bootstrap as the import system itself"] [984 1 "// is the import family's (PY6)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[99 39] [106 28] [107 24] [133 33] [136 27] [137 41] [208 33] [214 112] [215 30] [259 126] [260 29] [262 36] [315 37] [334 43] [358 31] [362 70] [387 26] [433 46] [445 25] [448 39] [449 47] [484 52] [516 41] [522 37] [523 29] [525 44] [547 56] [557 27] [558 47] [564 55] [572 48] [631 4] [639 25] [670 83] [688 134] [726 41] [732 53] [740 38] [750 42] [759 24] [763 5] [767 42] [770 42] [772 25] [785 33] [790 32] [809 31] [815 34] [835 30] [843 23] [883 45] [924 36] [928 43] [937 26] [940 45] [941 25] [950 26] [951 48] [956 45] [957 23] [966 26] [969 45] [1010 29] [1024 24] [1025 32] [1033 24] [1034 68]]} (go/file "import.go" :imports [



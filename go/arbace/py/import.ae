(in-ns 'go.arbace.py) ^{:go/comments [[10 1 "// The import system (PY5e; PYI-SPEC.md §9's single-file imports): import-name, import-from and"] [11 1 "// import-star, and builtins.__import__, after importlib._bootstrap's __import__, _gcd_import,"] [12 1 "// _find_and_load and _handle_fromlist. A module is found on sys.path (a package's submodules on its"] [13 1 "// __path__): DIR/NAME/__init__.py (a package), DIR/NAME.py, else DIR/NAME as a namespace package; its"] [14 1 "// source is compiled to the IR by the host (SetCompiler: the reader and arbace.python.compile) and run"] [15 1 "// as the module's body. The built-in modules are builtins and sys; the C modules of CPython are PY6's"] [16 1 "// Go ports (survey §6.6), so their import is a ModuleNotFoundError until then. importlib._bootstrap as"] [17 1 "// the import system itself (PYS12) is PY6's: no finders, loaders or specs yet (__spec__ is None)."] [19 1 "// builtinModuleNames are sys.builtin_module_names."] [22 1 "// builtinModules make the built-in modules other than builtins and sys, once per interpreter (their files'"] [23 1 "// init functions fill it: _string's builtins_string.go, _weakref's builtins_weakref.go)."] [26 1 "// builtinModulesErr are the built-in modules whose making may raise (those that run Python's machinery:"] [27 1 "// _ast's classes through type())."] [30 1 "// compileHook compiles a module's source text to the IR's text (arbace.python/ir-text); mode is \"exec\""] [31 1 "// or \"single\" (the REPL's). Any other result than a code object's map is an error \"Type: message\", or"] [32 1 "// \"incomplete\" for an interactive statement that needs more lines."] [35 1 "// SetCompiler sets the host's compiler of Python source (bin/pyi's host, arbace.python.run)."] [38 1 "// compileSource compiles source text by the host's compiler into a code object."] [61 1 "// syntaxError is the SyntaxError of the compiler's answer \"MSG\\x00LINE\\x00OFFSET\\x00END_LINE\\x00END_OFFSET\""] [62 1 "// (the location's parts empty or absent when unknown): its fields filename, lineno, offset, text (the"] [63 1 "// source line), end_lineno and end_offset, as CPython's compile() raises it."] [91 1 "// errIncomplete is an interactive statement that needs more lines (codeop's incomplete input)."] [129 1 "// builtinImport is __import__(name, globals=None, locals=None, fromlist=(), level=0)."] [168 1 "// importName is IMPORT_NAME (importlib's __import__): the module named, relative to globals' package by"] [169 1 "// level; with an empty fromlist the top-level package of the name, else the module with fromlist's"] [170 1 "// submodules imported."] [214 1 "// handleFromlist imports the submodules a package's fromlist names (_handle_fromlist)."] [255 1 "// importFrom is IMPORT_FROM: module.name, else the submodule module.name already in sys.modules (a"] [256 1 "// circular import), else an ImportError."] [286 1 "// importStar is IMPORT_STAR: __all__'s names, else the module's public names, into ns."] [326 1 "// packageOf is the package a relative import is relative to (_calc___package__)."] [350 1 "// resolveName is _resolve_name: name relative to package by level."] [366 1 "// importModule is _gcd_import: the module of the absolute name, its parents imported first."] [447 1 "// findAndLoad finds the module child (fully name) in the directories of search and runs it."] [483 1 "// loadSource compiles a module's source file and runs it as name (a package when path is not nil)."] [533 1 "// notFound is ModuleNotFoundError(msg) for the module name (its .name, ImportError's attribute)."] [550 1 "// moduleDict is a module's namespace (a *Module's Dict), else nil."] [563 1 "// moduleName is a module's __name__, \"\" when it has none."] [579 1 "// modulePath is a module's __path__ (a package's), nil for a plain module."] [595 1 "// The runtime's import system seen by importlib (PY6a): sys.meta_path holds pyiFinder, whose find_spec imports"] [596 1 "// the module by the runtime's own finder (sys.path, packages, the built-in modules) and answers a"] [597 1 "// ModuleSpec of importlib._bootstrap whose loader hands that module over, so importlib.import_module and"] [598 1 "// importlib.util.find_spec work beside the import statement. importlib._bootstrap as the import system itself"] [599 1 "// is the import family's (PY6)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[68 39] [75 27] [76 23] [140 26] [178 46] [207 52] [239 31] [245 37] [246 29] [267 56] [275 27] [276 47] [299 24] [311 4] [319 25] [331 44] [333 40] [368 41] [375 38] [385 42] [394 24] [398 5] [410 32] [416 35] [425 42] [427 25] [440 32] [455 30] [463 23] [501 45] [543 43] [552 26] [555 45] [556 25] [565 26] [566 48] [571 45] [572 23] [581 26] [584 45] [625 29] [639 24] [640 32] [648 24] [649 68]]} (go/file "import.go" :imports [



(in-ns 'go.arbace.py) ^{:go/comments [[11 1 "// The import system (PY5e; PYI-SPEC.md §9's single-file imports): import-name, import-from and"] [12 1 "// import-star, and builtins.__import__, after importlib._bootstrap's __import__, _gcd_import,"] [13 1 "// _find_and_load and _handle_fromlist. A module is found on sys.path (a package's submodules on its"] [14 1 "// __path__): DIR/NAME/__init__.py (a package), DIR/NAME.py, else DIR/NAME as a namespace package; its"] [15 1 "// source is compiled to the IR by the host (SetCompiler: the reader and arbace.python.compile) and run"] [16 1 "// as the module's body. The built-in modules are builtins and sys; the C modules of CPython are PY6's"] [17 1 "// Go ports (survey §6.6), so their import is a ModuleNotFoundError until then. importlib._bootstrap as"] [18 1 "// the import system itself (PYS12) is PY6's: no finders, loaders or specs yet (__spec__ is None)."] [20 1 "// builtinModuleNames are sys.builtin_module_names: every module the runtime makes (builtinModules', builtinModulesErr's),"] [21 1 "// with sys and builtins, sorted. Computed at first use, after every file's init registered its modules (PY6-core, queue"] [22 1 "// 200: a fixed list here missed the families' new modules, and importlib's BuiltinImporter then did not find them)."] [31 31 "// loaded on their first import (builtins_pyexpat_api.go)"] [42 1 "// builtinModules make the built-in modules other than builtins and sys, once per interpreter (their files'"] [43 1 "// init functions fill it: _string's builtins_string.go, _weakref's builtins_weakref.go)."] [46 1 "// builtinModulesErr are the built-in modules whose making may raise (those that run Python's machinery:"] [47 1 "// _ast's classes through type())."] [50 1 "// compileHook compiles a module's source text to the IR's text (arbace.python/ir-text); mode is \"exec\""] [51 1 "// or \"single\" (the REPL's). Any other result than a code object's map is an error \"Type: message\", or"] [52 1 "// \"incomplete\" for an interactive statement that needs more lines."] [55 1 "// SetCompiler sets the host's compiler of Python source (bin/pyi's host, arbace.python.run)."] [58 1 "// compileSource compiles source text by the host's compiler into a code object."] [85 1 "// syntaxError is the SyntaxError (IndentationError, TabError) of the compiler's answer"] [86 1 "// \"MSG\\x00LINE\\x00OFFSET\\x00END_LINE\\x00END_OFFSET\\x00KIND[\\x00TEXT]\" (the location's parts empty when unknown; KIND m"] [87 1 "// is p with \"\\x00STMT_LINE\\x00STMT_COL\" before the text, the exception's _metadata with the source): its"] [88 1 "// fields filename, lineno, offset, text, end_lineno and end_offset, as CPython's compile() raises it. The text: a"] [89 1 "// parser's error (KIND p) the line as the parser gives it (TEXT, None when absent); a compiler's (KIND c) the line"] [90 1 "// of the file when it reads (PyErr_ProgramTextObject: None for \"<string>\"); an answer of no kind the source's line."] [113 2 "// kind m (queue 202c): a parser's error with its _metadata, the last statement's line and column"] [114 2 "// (_PyPegen_set_syntax_error_metadata), then the text as kind p's"] [152 1 "// emitCompileWarnings is _PyErr_EmitSyntaxWarning for each of the compiler's warnings, in order:"] [153 1 "// warnings.warn_explicit(msg, SyntaxWarning, file, line); a SyntaxWarning a filter turns into an error becomes"] [154 1 "// the SyntaxError of its location, the compile's result."] [195 1 "// isIncomplete reports an interactive statement that needs more lines (codeop's incomplete input):"] [196 1 "// (PY7: a fresh _IncompleteInputError each time, isIncomplete tells it)"] [212 4 "// builtins.__import__ replaced: called as CPython's import_name calls it"] [253 1 "// builtinImportFn is the runtime's builtins.__import__."] [256 1 "// isBuiltinImport is whether o is the runtime's builtins.__import__."] [259 1 "// builtinImport is __import__(name, globals=None, locals=None, fromlist=(), level=0)."] [298 1 "// importName is IMPORT_NAME (importlib's __import__): the module named, relative to globals' package by"] [299 1 "// level; with an empty fromlist the top-level package of the name, else the module with fromlist's"] [300 1 "// submodules imported."] [361 1 "// handleFromlist imports the submodules a package's fromlist names (_handle_fromlist)."] [394 5 "// _handle_fromlist: a missing submodule is skipped, unless sys.modules blocks it with None"] [405 1 "// importFrom is IMPORT_FROM: module.name, else the submodule module.name already in sys.modules (a"] [406 1 "// circular import), else an ImportError."] [444 2 "// import_from's ImportError: name the module, path its file, name_from the name (PY6b's request)"] [453 1 "// importStar is IMPORT_STAR: __all__'s names, else the module's public names, into ns."] [502 1 "// packageOf is the package a relative import is relative to (import.c's resolve_name, _calc___package__):"] [503 1 "// __package__, checked against __spec__.parent; else __spec__.parent; else, with an ImportWarning, __name__"] [504 1 "// (itself for a package)."] [564 1 "// resolveName is _resolve_name: name relative to package by level."] [580 1 "// importModule is _gcd_import: the module of the absolute name, its parents imported first."] [644 1 "// importBuiltin makes the built-in module name and puts it in sys.modules (ok false when name is not one):"] [645 1 "// the runtime's own import of them, and _imp.create_builtin's under importlib (PY6b)."] [655 23 "// a module whose Go package the host loads on demand (pyexpat)"] [658 25 "// PY6d's R5: the built-in functions' __module__"] [674 1 "// findAndLoad finds the module child (fully name) in the directories of search and runs it."] [710 1 "// loadSource compiles a module's source file and runs it as name (a package when path is not nil)."] [760 1 "// notFound is ModuleNotFoundError(msg) for the module name (its .name, ImportError's attribute)."] [780 1 "// moduleDict is a module's namespace (a *Module's Dict), else nil."] [793 1 "// moduleName is a module's __name__, \"\" when it has none."] [809 1 "// modulePath is a module's __path__ (a package's), nil for a plain module."] [825 1 "// The runtime's import system seen by importlib (PY6a): sys.meta_path holds pyiFinder, whose find_spec imports"] [826 1 "// the module by the runtime's own finder (sys.path, packages, the built-in modules) and answers a"] [827 1 "// ModuleSpec of importlib._bootstrap whose loader hands that module over, so importlib.import_module and"] [828 1 "// importlib.util.find_spec work beside the import statement. importlib._bootstrap as the import system itself"] [829 1 "// is the import family's (PY6)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[95 39] [102 28] [103 24] [126 33] [174 111] [175 29] [177 36] [211 44] [270 26] [316 46] [354 52] [386 31] [392 37] [393 29] [395 44] [417 56] [427 27] [428 47] [432 39] [433 55] [487 4] [495 25] [526 83] [544 134] [582 41] [588 53] [592 38] [602 42] [611 24] [615 5] [619 42] [622 42] [624 25] [637 32] [656 31] [662 34] [682 30] [690 23] [728 45] [769 36] [773 43] [782 26] [785 45] [786 25] [795 26] [796 48] [801 45] [802 23] [811 26] [814 45] [855 29] [869 24] [870 32] [878 24] [879 68]]} (go/file "import.go" :imports [



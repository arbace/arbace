(in-ns 'go.arbace.py) ^{:go/comments [[9 1 "// The import system (PY5e; PYI-SPEC.md §9's single-file imports): import-name, import-from and"] [10 1 "// import-star, and builtins.__import__, after importlib._bootstrap's __import__, _gcd_import,"] [11 1 "// _find_and_load and _handle_fromlist. A module is found on sys.path (a package's submodules on its"] [12 1 "// __path__): DIR/NAME/__init__.py (a package), DIR/NAME.py, else DIR/NAME as a namespace package; its"] [13 1 "// source is compiled to the IR by the host (SetCompiler: the reader and arbace.python.compile) and run"] [14 1 "// as the module's body. The built-in modules are builtins and sys; the C modules of CPython are PY6's"] [15 1 "// Go ports (survey §6.6), so their import is a ModuleNotFoundError until then. importlib._bootstrap as"] [16 1 "// the import system itself (PYS12) is PY6's: no finders, loaders or specs yet (__spec__ is None)."] [18 1 "// builtinModuleNames are sys.builtin_module_names."] [21 1 "// compileHook compiles a module's source text to the IR's text (arbace.python/ir-text); mode is \"exec\""] [22 1 "// or \"single\" (the REPL's). Any other result than a code object's map is an error \"Type: message\", or"] [23 1 "// \"incomplete\" for an interactive statement that needs more lines."] [26 1 "// SetCompiler sets the host's compiler of Python source (bin/pyi's host, arbace.python.run)."] [29 1 "// compileSource compiles source text by the host's compiler into a code object."] [48 1 "// errIncomplete is an interactive statement that needs more lines (codeop's incomplete input)."] [86 1 "// builtinImport is __import__(name, globals=None, locals=None, fromlist=(), level=0)."] [125 1 "// importName is IMPORT_NAME (importlib's __import__): the module named, relative to globals' package by"] [126 1 "// level; with an empty fromlist the top-level package of the name, else the module with fromlist's"] [127 1 "// submodules imported."] [171 1 "// handleFromlist imports the submodules a package's fromlist names (_handle_fromlist)."] [212 1 "// importFrom is IMPORT_FROM: module.name, else the submodule module.name already in sys.modules (a"] [213 1 "// circular import), else an ImportError."] [243 1 "// importStar is IMPORT_STAR: __all__'s names, else the module's public names, into ns."] [283 1 "// packageOf is the package a relative import is relative to (_calc___package__)."] [307 1 "// resolveName is _resolve_name: name relative to package by level."] [323 1 "// importModule is _gcd_import: the module of the absolute name, its parents imported first."] [389 1 "// findAndLoad finds the module child (fully name) in the directories of search and runs it."] [425 1 "// loadSource compiles a module's source file and runs it as name (a package when path is not nil)."] [475 1 "// notFound is ModuleNotFoundError(msg) for the module name (its .name, ImportError's attribute)."] [492 1 "// moduleDict is a module's namespace (a *Module's Dict), else nil."] [505 1 "// moduleName is a module's __name__, \"\" when it has none."] [521 1 "// modulePath is a module's __path__ (a package's), nil for a plain module."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[97 26] [135 46] [164 52] [196 31] [202 37] [203 29] [224 56] [232 27] [233 47] [256 24] [268 4] [276 25] [288 44] [290 40] [325 41] [332 38] [342 42] [351 24] [355 5] [367 42] [369 25] [382 32] [397 30] [405 23] [443 45] [485 43] [494 26] [497 45] [498 25] [507 26] [508 48] [513 45] [514 23] [523 26] [526 45]]} (go/file "import.go" :imports [



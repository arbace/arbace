(in-ns 'go.arbace.py) ^{:go/comments [[10 1 "// The import system (PY5e; PYI-SPEC.md §9's single-file imports): import-name, import-from and"] [11 1 "// import-star, and builtins.__import__, after importlib._bootstrap's __import__, _gcd_import,"] [12 1 "// _find_and_load and _handle_fromlist. A module is found on sys.path (a package's submodules on its"] [13 1 "// __path__): DIR/NAME/__init__.py (a package), DIR/NAME.py, else DIR/NAME as a namespace package; its"] [14 1 "// source is compiled to the IR by the host (SetCompiler: the reader and arbace.python.compile) and run"] [15 1 "// as the module's body. The built-in modules are builtins and sys; the C modules of CPython are PY6's"] [16 1 "// Go ports (survey §6.6), so their import is a ModuleNotFoundError until then. importlib._bootstrap as"] [17 1 "// the import system itself (PYS12) is PY6's: no finders, loaders or specs yet (__spec__ is None)."] [19 1 "// builtinModuleNames are sys.builtin_module_names."] [22 1 "// builtinModules make the built-in modules other than builtins and sys, once per interpreter (their files'"] [23 1 "// init functions fill it: _string's builtins_string.go, _weakref's builtins_weakref.go)."] [26 1 "// builtinModulesErr are the built-in modules whose making may raise (those that run Python's machinery:"] [27 1 "// _ast's classes through type())."] [30 1 "// compileHook compiles a module's source text to the IR's text (arbace.python/ir-text); mode is \"exec\""] [31 1 "// or \"single\" (the REPL's). Any other result than a code object's map is an error \"Type: message\", or"] [32 1 "// \"incomplete\" for an interactive statement that needs more lines."] [35 1 "// SetCompiler sets the host's compiler of Python source (bin/pyi's host, arbace.python.run)."] [38 1 "// compileSource compiles source text by the host's compiler into a code object."] [61 1 "// syntaxError is the SyntaxError of the compiler's answer \"MSG\\x00LINE\\x00OFFSET\\x00END_LINE\\x00END_OFFSET\""] [62 1 "// (the location's parts empty or absent when unknown): its fields filename, lineno, offset, text (the"] [63 1 "// source line), end_lineno and end_offset, as CPython's compile() raises it."] [91 1 "// errIncomplete is an interactive statement that needs more lines (codeop's incomplete input)."] [104 4 "// builtins.__import__ replaced: called as CPython's import_name calls it"] [145 1 "// builtinImportFn is the runtime's builtins.__import__."] [148 1 "// isBuiltinImport is whether o is the runtime's builtins.__import__."] [151 1 "// builtinImport is __import__(name, globals=None, locals=None, fromlist=(), level=0)."] [190 1 "// importName is IMPORT_NAME (importlib's __import__): the module named, relative to globals' package by"] [191 1 "// level; with an empty fromlist the top-level package of the name, else the module with fromlist's"] [192 1 "// submodules imported."] [244 1 "// handleFromlist imports the submodules a package's fromlist names (_handle_fromlist)."] [285 1 "// importFrom is IMPORT_FROM: module.name, else the submodule module.name already in sys.modules (a"] [286 1 "// circular import), else an ImportError."] [322 1 "// importStar is IMPORT_STAR: __all__'s names, else the module's public names, into ns."] [362 1 "// packageOf is the package a relative import is relative to (_calc___package__)."] [386 1 "// resolveName is _resolve_name: name relative to package by level."] [402 1 "// importModule is _gcd_import: the module of the absolute name, its parents imported first."] [466 1 "// importBuiltin makes the built-in module name and puts it in sys.modules (ok false when name is not one):"] [467 1 "// the runtime's own import of them, and _imp.create_builtin's under importlib (PY6b)."] [493 1 "// findAndLoad finds the module child (fully name) in the directories of search and runs it."] [529 1 "// loadSource compiles a module's source file and runs it as name (a package when path is not nil)."] [579 1 "// notFound is ModuleNotFoundError(msg) for the module name (its .name, ImportError's attribute)."] [596 1 "// moduleDict is a module's namespace (a *Module's Dict), else nil."] [609 1 "// moduleName is a module's __name__, \"\" when it has none."] [625 1 "// modulePath is a module's __path__ (a package's), nil for a plain module."] [641 1 "// The runtime's import system seen by importlib (PY6a): sys.meta_path holds pyiFinder, whose find_spec imports"] [642 1 "// the module by the runtime's own finder (sys.path, packages, the built-in modules) and answers a"] [643 1 "// ModuleSpec of importlib._bootstrap whose loader hands that module over, so importlib.import_module and"] [644 1 "// importlib.util.find_spec work beside the import statement. importlib._bootstrap as the import system itself"] [645 1 "// is the import family's (PY6)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[68 39] [75 27] [76 23] [103 44] [162 26] [208 46] [237 52] [269 31] [275 37] [276 29] [297 56] [305 27] [306 47] [310 39] [311 55] [335 24] [347 4] [355 25] [367 44] [369 40] [404 41] [410 53] [414 38] [424 42] [433 24] [437 5] [441 42] [444 42] [446 25] [459 32] [477 31] [482 34] [501 30] [509 23] [547 45] [589 43] [598 26] [601 45] [602 25] [611 26] [612 48] [617 45] [618 23] [627 26] [630 45] [671 29] [685 24] [686 32] [694 24] [695 68]]} (go/file "import.go" :imports [



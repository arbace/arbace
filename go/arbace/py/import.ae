(in-ns 'go.arbace.py) ^{:go/comments [[11 1 "// The import system (PY5e; PYI-SPEC.md §9's single-file imports): import-name, import-from and"] [12 1 "// import-star, and builtins.__import__, after importlib._bootstrap's __import__, _gcd_import,"] [13 1 "// _find_and_load and _handle_fromlist. A module is found on sys.path (a package's submodules on its"] [14 1 "// __path__): DIR/NAME/__init__.py (a package), DIR/NAME.py, else DIR/NAME as a namespace package; its"] [15 1 "// source is compiled to the IR by the host (SetCompiler: the reader and arbace.python.compile) and run"] [16 1 "// as the module's body. The built-in modules are builtins and sys; the C modules of CPython are PY6's"] [17 1 "// Go ports (survey §6.6), so their import is a ModuleNotFoundError until then. importlib._bootstrap as"] [18 1 "// the import system itself (PYS12) is PY6's: no finders, loaders or specs yet (__spec__ is None)."] [20 1 "// builtinModuleNames are sys.builtin_module_names: every module the runtime makes (builtinModules', builtinModulesErr's),"] [21 1 "// with sys and builtins, sorted. Computed at first use, after every file's init registered its modules (PY6-core, queue"] [22 1 "// 200: a fixed list here missed the families' new modules, and importlib's BuiltinImporter then did not find them)."] [39 1 "// builtinModules make the built-in modules other than builtins and sys, once per interpreter (their files'"] [40 1 "// init functions fill it: _string's builtins_string.go, _weakref's builtins_weakref.go)."] [43 1 "// builtinModulesErr are the built-in modules whose making may raise (those that run Python's machinery:"] [44 1 "// _ast's classes through type())."] [47 1 "// compileHook compiles a module's source text to the IR's text (arbace.python/ir-text); mode is \"exec\""] [48 1 "// or \"single\" (the REPL's). Any other result than a code object's map is an error \"Type: message\", or"] [49 1 "// \"incomplete\" for an interactive statement that needs more lines."] [52 1 "// SetCompiler sets the host's compiler of Python source (bin/pyi's host, arbace.python.run)."] [55 1 "// compileSource compiles source text by the host's compiler into a code object."] [82 1 "// syntaxError is the SyntaxError (IndentationError, TabError) of the compiler's answer"] [83 1 "// \"MSG\\x00LINE\\x00OFFSET\\x00END_LINE\\x00END_OFFSET\\x00KIND[\\x00TEXT]\" (the location's parts empty when unknown): its"] [84 1 "// fields filename, lineno, offset, text, end_lineno and end_offset, as CPython's compile() raises it. The text: a"] [85 1 "// parser's error (KIND p) the line as the parser gives it (TEXT, None when absent); a compiler's (KIND c) the line"] [86 1 "// of the file when it reads (PyErr_ProgramTextObject: None for \"<string>\"); an answer of no kind the source's line."] [136 1 "// emitCompileWarnings is _PyErr_EmitSyntaxWarning for each of the compiler's warnings, in order:"] [137 1 "// warnings.warn_explicit(msg, SyntaxWarning, file, line); a SyntaxWarning a filter turns into an error becomes"] [138 1 "// the SyntaxError of its location, the compile's result."] [179 1 "// errIncomplete is an interactive statement that needs more lines (codeop's incomplete input)."] [192 4 "// builtins.__import__ replaced: called as CPython's import_name calls it"] [233 1 "// builtinImportFn is the runtime's builtins.__import__."] [236 1 "// isBuiltinImport is whether o is the runtime's builtins.__import__."] [239 1 "// builtinImport is __import__(name, globals=None, locals=None, fromlist=(), level=0)."] [278 1 "// importName is IMPORT_NAME (importlib's __import__): the module named, relative to globals' package by"] [279 1 "// level; with an empty fromlist the top-level package of the name, else the module with fromlist's"] [280 1 "// submodules imported."] [341 1 "// handleFromlist imports the submodules a package's fromlist names (_handle_fromlist)."] [374 5 "// _handle_fromlist: a missing submodule is skipped, unless sys.modules blocks it with None"] [385 1 "// importFrom is IMPORT_FROM: module.name, else the submodule module.name already in sys.modules (a"] [386 1 "// circular import), else an ImportError."] [424 2 "// import_from's ImportError: name the module, path its file, name_from the name (PY6b's request)"] [433 1 "// importStar is IMPORT_STAR: __all__'s names, else the module's public names, into ns."] [482 1 "// packageOf is the package a relative import is relative to (import.c's resolve_name, _calc___package__):"] [483 1 "// __package__, checked against __spec__.parent; else __spec__.parent; else, with an ImportWarning, __name__"] [484 1 "// (itself for a package)."] [544 1 "// resolveName is _resolve_name: name relative to package by level."] [560 1 "// importModule is _gcd_import: the module of the absolute name, its parents imported first."] [624 1 "// importBuiltin makes the built-in module name and puts it in sys.modules (ok false when name is not one):"] [625 1 "// the runtime's own import of them, and _imp.create_builtin's under importlib (PY6b)."] [637 25 "// PY6d's R5: the built-in functions' __module__"] [653 1 "// findAndLoad finds the module child (fully name) in the directories of search and runs it."] [689 1 "// loadSource compiles a module's source file and runs it as name (a package when path is not nil)."] [739 1 "// notFound is ModuleNotFoundError(msg) for the module name (its .name, ImportError's attribute)."] [759 1 "// moduleDict is a module's namespace (a *Module's Dict), else nil."] [772 1 "// moduleName is a module's __name__, \"\" when it has none."] [788 1 "// modulePath is a module's __path__ (a package's), nil for a plain module."] [804 1 "// The runtime's import system seen by importlib (PY6a): sys.meta_path holds pyiFinder, whose find_spec imports"] [805 1 "// the module by the runtime's own finder (sys.path, packages, the built-in modules) and answers a"] [806 1 "// ModuleSpec of importlib._bootstrap whose loader hands that module over, so importlib.import_module and"] [807 1 "// importlib.util.find_spec work beside the import statement. importlib._bootstrap as the import system itself"] [808 1 "// is the import family's (PY6)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[91 39] [98 28] [99 24] [115 33] [158 111] [159 29] [161 36] [191 44] [250 26] [296 46] [334 52] [366 31] [372 37] [373 29] [375 44] [397 56] [407 27] [408 47] [412 39] [413 55] [467 4] [475 25] [506 83] [524 134] [562 41] [568 53] [572 38] [582 42] [591 24] [595 5] [599 42] [602 42] [604 25] [617 32] [635 31] [641 34] [661 30] [669 23] [707 45] [748 36] [752 43] [761 26] [764 45] [765 25] [774 26] [775 48] [780 45] [781 23] [790 26] [793 45] [834 29] [848 24] [849 32] [857 24] [858 68]]} (go/file "import.go" :imports [



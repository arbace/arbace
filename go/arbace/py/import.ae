(in-ns 'go.arbace.py) ^{:go/comments [[10 1 "// The import system (PY5e; PYI-SPEC.md §9's single-file imports): import-name, import-from and"] [11 1 "// import-star, and builtins.__import__, after importlib._bootstrap's __import__, _gcd_import,"] [12 1 "// _find_and_load and _handle_fromlist. A module is found on sys.path (a package's submodules on its"] [13 1 "// __path__): DIR/NAME/__init__.py (a package), DIR/NAME.py, else DIR/NAME as a namespace package; its"] [14 1 "// source is compiled to the IR by the host (SetCompiler: the reader and arbace.python.compile) and run"] [15 1 "// as the module's body. The built-in modules are builtins and sys; the C modules of CPython are PY6's"] [16 1 "// Go ports (survey §6.6), so their import is a ModuleNotFoundError until then. importlib._bootstrap as"] [17 1 "// the import system itself (PYS12) is PY6's: no finders, loaders or specs yet (__spec__ is None)."] [19 1 "// builtinModuleNames are sys.builtin_module_names."] [22 1 "// builtinModules make the built-in modules other than builtins and sys, once per interpreter (their files'"] [23 1 "// init functions fill it: _string's builtins_string.go, _weakref's builtins_weakref.go)."] [26 1 "// compileHook compiles a module's source text to the IR's text (arbace.python/ir-text); mode is \"exec\""] [27 1 "// or \"single\" (the REPL's). Any other result than a code object's map is an error \"Type: message\", or"] [28 1 "// \"incomplete\" for an interactive statement that needs more lines."] [31 1 "// SetCompiler sets the host's compiler of Python source (bin/pyi's host, arbace.python.run)."] [34 1 "// compileSource compiles source text by the host's compiler into a code object."] [57 1 "// syntaxError is the SyntaxError of the compiler's answer \"MSG\\x00LINE\\x00OFFSET\\x00END_LINE\\x00END_OFFSET\""] [58 1 "// (the location's parts empty or absent when unknown): its fields filename, lineno, offset, text (the"] [59 1 "// source line), end_lineno and end_offset, as CPython's compile() raises it."] [87 1 "// errIncomplete is an interactive statement that needs more lines (codeop's incomplete input)."] [125 1 "// builtinImport is __import__(name, globals=None, locals=None, fromlist=(), level=0)."] [164 1 "// importName is IMPORT_NAME (importlib's __import__): the module named, relative to globals' package by"] [165 1 "// level; with an empty fromlist the top-level package of the name, else the module with fromlist's"] [166 1 "// submodules imported."] [210 1 "// handleFromlist imports the submodules a package's fromlist names (_handle_fromlist)."] [251 1 "// importFrom is IMPORT_FROM: module.name, else the submodule module.name already in sys.modules (a"] [252 1 "// circular import), else an ImportError."] [282 1 "// importStar is IMPORT_STAR: __all__'s names, else the module's public names, into ns."] [322 1 "// packageOf is the package a relative import is relative to (_calc___package__)."] [346 1 "// resolveName is _resolve_name: name relative to package by level."] [362 1 "// importModule is _gcd_import: the module of the absolute name, its parents imported first."] [433 1 "// findAndLoad finds the module child (fully name) in the directories of search and runs it."] [469 1 "// loadSource compiles a module's source file and runs it as name (a package when path is not nil)."] [519 1 "// notFound is ModuleNotFoundError(msg) for the module name (its .name, ImportError's attribute)."] [536 1 "// moduleDict is a module's namespace (a *Module's Dict), else nil."] [549 1 "// moduleName is a module's __name__, \"\" when it has none."] [565 1 "// modulePath is a module's __path__ (a package's), nil for a plain module."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[64 39] [71 27] [72 23] [136 26] [174 46] [203 52] [235 31] [241 37] [242 29] [263 56] [271 27] [272 47] [295 24] [307 4] [315 25] [327 44] [329 40] [364 41] [371 38] [381 42] [390 24] [394 5] [406 32] [411 42] [413 25] [426 32] [441 30] [449 23] [487 45] [529 43] [538 26] [541 45] [5
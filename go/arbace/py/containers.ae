(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// tuple and list (dict in dict.go): their slots and methods, CPython's listobject.c and"] [6 1 "// tupleobject.c."] [13 1 "// Tuple is a tuple; hash is its hash once computed (0: not yet), as CPython 3.14's ob_hash (queue 210)."] [21 1 "// BaseTuple is the tuple value of a tuple or of a tuple subclass's instance that embeds Tuple."] [26 1 "// NewTuple is the tuple of items (not copied)."] [34 1 "// List is a list."] [39 1 "// BaseList is the list value of a list or of a list subclass's instance that embeds List."] [42 1 "// NewList is the list of items (not copied)."] [45 12 "// _tracemalloc's allocation (queue 220)"] [77 1 "// AsTuple and AsList are asTuple and asList, exported for the other files."] [81 1 "// Iterate calls f on each item of iter(o) until it returns false or an error."] [106 1 "// ToSlice is list(o)'s items (a fresh slice)."] [119 1 "// ToTuple is tuple(o)."] [143 1 "// seqIndex is an int index into n items (negative from the end), or an IndexError with what."] [166 1 "// seqIndexInt is IndexInt for a sequence's subscript: an int too big an IndexError, as CPython's."] [177 1 "// itemAt is items[key] for an int key or a slice."] [200 1 "// seqCompare is list_richcompare and tuplerichcompare: the first items that differ decide, else the"] [201 1 "// lengths."] [228 1 "// pySsizeMax is PY_SSIZE_T_MAX (sys.maxsize on a 64-bit build)."] [242 2 "// list_repeat's and tuple_repeat's PyErr_NoMemory: the size past PY_SSIZE_T_MAX (len*k overflowed before:"] [243 2 "// test_list's test_overflow allocated until the OOM killer, 202b), or past what pyi allocates"] [440 22 "// the bounds' __index__ before the list's length (list_subscript)"] [535 3 "// __reduce__ and __setstate__ are tupleiter_reduce and listiter_reduce_general's: (iter, (seq,), index), an"] [536 3 "// exhausted one (iter, ((),)) or (iter, ([],)); the index set again clamped to the sequence, a list's below 0 exhausted (queue 211:"] [537 3 "// test_dict's iterator pickling tests pickle the list_iterator their unpickled dict iterator is)"] [569 33 "// listiter_setstate: an index below 0 exhausts it"] [588 1 "// newTupleSubclass and newListSubclass make instances of subclasses; PY5c sets them (by default the base value: PY5c wraps it)."] [597 1 "// listSetItem is l[k] = v and del l[k] (v nil), slices among them (an extended slice's sizes"] [598 1 "// matching)."] [602 3 "// the bounds' __index__ first, then the list's length (PySlice_Unpack, then PySlice_AdjustIndices with"] [603 3 "// Py_SIZE): an __index__ may change the list"] [637 4 "// converting v may have changed the list too (list_ass_slice clamps to Py_SIZE again)"] [643 38 "// in place, as item assignments (queue 210: fannkuch's perm[:k+1] = ...)"] [650 3 "// the extended slice's length after converting v, which may have changed the list (list_ass_subscript's"] [651 3 "// PySlice_AdjustIndices after PySequence_Fast, gh-120384; queue 203: test_list_index_modifing_operand)"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[58 25] [71 25] [83 24] [85 24] [100 23] [108 24] [111 23] [115 71] [121 24] [147 28] [170 28] [179 27] [185 23] [185 30] [207 6] [207 32] [248 12] [248 19] [284 16] [284 44] [334 51] [381 23] [382 27] [410 32] [420 48] [427 42] [434 49] [439 26] [539 48] [555 50] [601 25] [617 24] [617 31] [631 29] [652 58] [658 23] [658 30]]} (go/file "containers.go" :imports [


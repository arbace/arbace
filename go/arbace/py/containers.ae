(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// tuple and list (dict in dict.go): their slots and methods, CPython's listobject.c and"] [6 1 "// tupleobject.c."] [13 1 "// Tuple is a tuple; hash is its hash once computed (0: not yet), as CPython 3.14's ob_hash (queue 210)."] [21 1 "// BaseTuple is the tuple value of a tuple or of a tuple subclass's instance that embeds Tuple."] [26 1 "// NewTuple is the tuple of items (not copied)."] [34 1 "// List is a list."] [37 2 "// ident is its identity once id() took it (identityHash; 0: none yet), in the list itself (py-final-1126: a record"] [38 2 "// with a Go finalizer, queue 418's, made a chain of lists free a link a collection)"] [44 1 "// BaseList is the list value of a list or of a list subclass's instance that embeds List."] [47 1 "// NewList is the list of items (not copied)."] [50 12 "// _tracemalloc's allocation (queue 220)"] [82 1 "// AsTuple and AsList are asTuple and asList, exported for the other files."] [86 1 "// Iterate calls f on each item of iter(o) until it returns false or an error."] [111 1 "// ToSlice is list(o)'s items (a fresh slice)."] [113 2 "// a subclass with its own __iter__ is iterated (list_extend's fast path is for the exact types)"] [127 1 "// ToTuple is tuple(o)."] [143 24 "// an item C has not set yet (the C API's PyTuple_New, queue 269), as CPython 3.14's repr"] [155 1 "// seqIndex is an int index into n items (negative from the end), or an IndexError with what."] [178 1 "// seqIndexInt is IndexInt for a sequence's subscript: an int too big an IndexError, as CPython's."] [189 1 "// itemAt is items[key] for an int key or a slice."] [212 1 "// seqCompare is list_richcompare and tuplerichcompare: the first items that differ decide, else the"] [213 1 "// lengths."] [240 1 "// pySsizeMax is PY_SSIZE_T_MAX (sys.maxsize on a 64-bit build)."] [254 2 "// list_repeat's and tuple_repeat's PyErr_NoMemory: the size past PY_SSIZE_T_MAX (len*k overflowed before:"] [255 2 "// test_list's test_overflow allocated until the OOM killer, 202b), or past what pyi allocates"] [341 2 "// list_repr: a __repr__ may change the list, its length read at each item"] [349 29 "// an item C has not set yet (the C API's PyList_New, queue 269), as CPython 3.14's"] [367 1 "// listCompare is list_richcompare: an __eq__ may change the lists, their lengths read at each item."] [465 3 "// tuple_new: a class with its own __init__ may have taken keywords"] [508 22 "// the bounds' __index__ before the list's length (list_subscript)"] [542 3 "// binary_iop1 before sq_inplace_concat: list has no nb_add, so a class's reflected __radd__ answers first"] [543 3 "// (queue 328: test_userlist's test_mixed_iadd, list += UserList is a UserList)"] [577 3 "// list___init__: a class with its own __new__ may have taken keywords"] [616 3 "// __reduce__ and __setstate__ are tupleiter_reduce and listiter_reduce_general's: (iter, (seq,), index), an"] [617 3 "// exhausted one (iter, ((),)) or (iter, ([],)); the index set again clamped to the sequence, a list's below 0 exhausted (queue 211:"] [618 3 "// test_dict's iterator pickling tests pickle the list_iterator their unpickled dict iterator is)"] [650 33 "// listiter_setstate: an index below 0 exhausts it"] [669 1 "// newTupleSubclass and newListSubclass make instances of subclasses; PY5c sets them (by default the base value: PY5c wraps it)."] [678 1 "// listSetItem is l[k] = v and del l[k] (v nil), slices among them (an extended slice's sizes"] [679 1 "// matching)."] [683 3 "// the bounds' __index__ first, then the list's length (PySlice_Unpack, then PySlice_AdjustIndices with"] [684 3 "// Py_SIZE): an __index__ may change the list"] [718 4 "// converting v may have changed the list too (list_ass_slice clamps to Py_SIZE again)"] [724 38 "// in place, as item assignments (queue 210: fannkuch's perm[:k+1] = ...)"] [735 3 "// the extended slice's length after converting v, which may have changed the list (list_ass_subscript's"] [736 3 "// PySlice_AdjustIndices after PySequence_Fast, gh-120384; queue 203: test_list_index_modifing_operand)"] [765 1 "// overridesNew is a class of t's MRO defining __new__ in Python."] [771 1 "// lengthHint is PyObject_LengthHint's call of a class's __length_hint__ for list(x), the value only checked (the"] [772 1 "// list grows as it is filled): an object with __len__ answers by it."] [777 41 "// queue 304: PyObject_Size's error but a TypeError propagates (issue 1242657)"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[63 25] [76 25] [88 24] [90 24] [105 23] [114 28] [115 25] [118 24] [123 71] [129 24] [159 28] [182 28] [191 27] [197 23] [197 30] [219 6] [219 32] [260 12] [260 19] [296 16] [296 44] [344 12] [344 30] [373 6] [373 44] [400 51] [447 23] [448 27] [466 40] [478 32] [488 48] [495 42] [502 49] [507 26] [544 20] [588 33] [620 49] [682 25] [698 24] [698 31] [712 29] [737 58] [743 23] [743 30] [774 27] [777 28] [778 20]]} (go/file "containers.go" :imports [


(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// tuple and list (dict in dict.go): their slots and methods, CPython's listobject.c and"] [6 1 "// tupleobject.c."] [13 1 "// Tuple is a tuple."] [18 1 "// BaseTuple is the tuple value of a tuple or of a tuple subclass's instance that embeds Tuple."] [23 1 "// NewTuple is the tuple of items (not copied)."] [31 1 "// List is a list."] [36 1 "// BaseList is the list value of a list or of a list subclass's instance that embeds List."] [39 1 "// NewList is the list of items (not copied)."] [68 1 "// AsTuple and AsList are asTuple and asList, exported for the other files."] [72 1 "// Iterate calls f on each item of iter(o) until it returns false or an error."] [97 1 "// ToSlice is list(o)'s items (a fresh slice)."] [110 1 "// ToTuple is tuple(o)."] [134 1 "// seqIndex is an int index into n items (negative from the end), or an IndexError with what."] [157 1 "// seqIndexInt is IndexInt for a sequence's subscript: an int too big an IndexError, as CPython's."] [168 1 "// itemAt is items[key] for an int key or a slice."] [191 1 "// seqCompare is list_richcompare and tuplerichcompare: the first items that differ decide, else the"] [192 1 "// lengths."] [219 1 "// pySsizeMax is PY_SSIZE_T_MAX (sys.maxsize on a 64-bit build)."] [233 2 "// list_repeat's and tuple_repeat's PyErr_NoMemory: the size past PY_SSIZE_T_MAX (len*k overflowed before:"] [234 2 "// test_list's test_overflow allocated until the OOM killer, 202b), or past what pyi allocates"] [421 22 "// the bounds' __index__ before the list's length (list_subscript)"] [516 3 "// __reduce__ and __setstate__ are tupleiter_reduce and listiter_reduce_general's: (iter, (seq,), index), an"] [517 3 "// exhausted one (iter, ((),)) or (iter, ([],)); the index set again clamped to the sequence, a list's below 0 exhausted (queue 211:"] [518 3 "// test_dict's iterator pickling tests pickle the list_iterator their unpickled dict iterator is)"] [550 33 "// listiter_setstate: an index below 0 exhausts it"] [569 1 "// newTupleSubclass and newListSubclass make instances of subclasses; PY5c sets them (by default the base value: PY5c wraps it)."] [578 1 "// listSetItem is l[k] = v and del l[k] (v nil), slices among them (an extended slice's sizes"] [579 1 "// matching)."] [583 3 "// the bounds' __index__ first, then the list's length (PySlice_Unpack, then PySlice_AdjustIndices with"] [584 3 "// Py_SIZE): an __index__ may change the list"] [618 4 "// converting v may have changed the list too (list_ass_slice clamps to Py_SIZE again)"] [627 3 "// the extended slice's length after converting v, which may have changed the list (list_ass_subscript's"] [628 3 "// PySlice_AdjustIndices after PySequence_Fast, gh-120384; queue 203: test_list_index_modifing_operand)"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[49 25] [62 25] [74 24] [76 24] [91 23] [99 24] [102 23] [106 71] [112 24] [138 28] [161 28] [170 27] [176 23] [176 30] [198 6] [198 32] [239 12] [239 19] [275 16] [275 44] [325 51] [362 23] [363 27] [391 32] [401 48] [408 42] [415 49] [420 26] [520 48] [536 50] [582 25] [598 24] [598 31] [612 29] [629 58] [635 23] [635 30]]} (go/file "containers.go" :imports [


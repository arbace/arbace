(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// tuple and list (dict in dict.go): their slots and methods, CPython's listobject.c and"] [6 1 "// tupleobject.c."] [13 1 "// Tuple is a tuple; hash is its hash once computed (0: not yet), as CPython 3.14's ob_hash (queue 210)."] [21 1 "// BaseTuple is the tuple value of a tuple or of a tuple subclass's instance that embeds Tuple."] [26 1 "// NewTuple is the tuple of items (not copied)."] [34 1 "// List is a list."] [39 1 "// BaseList is the list value of a list or of a list subclass's instance that embeds List."] [42 1 "// NewList is the list of items (not copied)."] [45 12 "// _tracemalloc's allocation (queue 220)"] [77 1 "// AsTuple and AsList are asTuple and asList, exported for the other files."] [81 1 "// Iterate calls f on each item of iter(o) until it returns false or an error."] [106 1 "// ToSlice is list(o)'s items (a fresh slice)."] [108 2 "// a subclass with its own __iter__ is iterated (list_extend's fast path is for the exact types)"] [122 1 "// ToTuple is tuple(o)."] [138 24 "// an item C has not set yet (the C API's PyTuple_New, queue 269), as CPython 3.14's repr"] [150 1 "// seqIndex is an int index into n items (negative from the end), or an IndexError with what."] [173 1 "// seqIndexInt is IndexInt for a sequence's subscript: an int too big an IndexError, as CPython's."] [184 1 "// itemAt is items[key] for an int key or a slice."] [207 1 "// seqCompare is list_richcompare and tuplerichcompare: the first items that differ decide, else the"] [208 1 "// lengths."] [235 1 "// pySsizeMax is PY_SSIZE_T_MAX (sys.maxsize on a 64-bit build)."] [249 2 "// list_repeat's and tuple_repeat's PyErr_NoMemory: the size past PY_SSIZE_T_MAX (len*k overflowed before:"] [250 2 "// test_list's test_overflow allocated until the OOM killer, 202b), or past what pyi allocates"] [336 2 "// list_repr: a __repr__ may change the list, its length read at each item"] [344 29 "// an item C has not set yet (the C API's PyList_New, queue 269), as CPython 3.14's"] [362 1 "// listCompare is list_richcompare: an __eq__ may change the lists, their lengths read at each item."] [460 3 "// tuple_new: a class with its own __init__ may have taken keywords"] [503 22 "// the bounds' __index__ before the list's length (list_subscript)"] [537 3 "// binary_iop1 before sq_inplace_concat: list has no nb_add, so a class's reflected __radd__ answers first"] [538 3 "// (queue 328: test_userlist's test_mixed_iadd, list += UserList is a UserList)"] [572 3 "// list___init__: a class with its own __new__ may have taken keywords"] [611 3 "// __reduce__ and __setstate__ are tupleiter_reduce and listiter_reduce_general's: (iter, (seq,), index), an"] [612 3 "// exhausted one (iter, ((),)) or (iter, ([],)); the index set again clamped to the sequence, a list's below 0 exhausted (queue 211:"] [613 3 "// test_dict's iterator pickling tests pickle the list_iterator their unpickled dict iterator is)"] [645 33 "// listiter_setstate: an index below 0 exhausts it"] [664 1 "// newTupleSubclass and newListSubclass make instances of subclasses; PY5c sets them (by default the base value: PY5c wraps it)."] [673 1 "// listSetItem is l[k] = v and del l[k] (v nil), slices among them (an extended slice's sizes"] [674 1 "// matching)."] [678 3 "// the bounds' __index__ first, then the list's length (PySlice_Unpack, then PySlice_AdjustIndices with"] [679 3 "// Py_SIZE): an __index__ may change the list"] [713 4 "// converting v may have changed the list too (list_ass_slice clamps to Py_SIZE again)"] [719 38 "// in place, as item assignments (queue 210: fannkuch's perm[:k+1] = ...)"] [730 3 "// the extended slice's length after converting v, which may have changed the list (list_ass_subscript's"] [731 3 "// PySlice_AdjustIndices after PySequence_Fast, gh-120384; queue 203: test_list_index_modifing_operand)"] [760 1 "// overridesNew is a class of t's MRO defining __new__ in Python."] [766 1 "// lengthHint is PyObject_LengthHint's call of a class's __length_hint__ for list(x), the value only checked (the"] [767 1 "// list grows as it is filled): an object with __len__ answers by it."] [772 41 "// queue 304: PyObject_Size's error but a TypeError propagates (issue 1242657)"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[58 25] [71 25] [83 24] [85 24] [100 23] [109 28] [110 25] [113 24] [118 71] [124 24] [154 28] [177 28] [186 27] [192 23] [192 30] [214 6] [214 32] [255 12] [255 19] [291 16] [291 44] [339 12] [339 30] [368 6] [368 44] [395 51] [442 23] [443 27] [461 40] [473 32] [483 48] [490 42] [497 49] [502 26] [539 20] [583 33] [615 49] [677 25] [693 24] [693 31] [707 29] [732 58] [738 23] [738 30] [769 27] [772 28] [773 20]]} (go/file "containers.go" :imports [


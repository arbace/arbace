(in-ns 'go.arbace.py) ^{:go/comments [[8 1 "// Classes (PY5c; CPython's Objects/typeobject.c and builtin___build_class__ of Python/bltinmodule.c):"] [9 1 "// the class statement's __build_class__, type.__new__ with its C3 MRO, metaclasses, __prepare__,"] [10 1 "// __mro_entries__, __init_subclass__ and __set_name__, the instances of classes, object.__new__ and"] [11 1 "// object.__init__, and the slots of a class filled from its special methods (fixup_slot_dispatchers)."] [13 1 "// Instance is an instance of a class (a heap type): its class, its __dict__ (nil under __slots__"] [14 1 "// without __dict__), its __slots__' values, and, for a class deriving from a built-in type other than"] [15 1 "// object, BaseException and type, the built-in base's value the inherited slots work on."] [25 1 "// classInfo is what type.__new__ records of a class beyond the Type (CPython's heap type fields)."] [27 21 "// this class's own __slots__ (mangled), in order"] [28 21 "// the instance's slot count, the bases' included"] [29 21 "// its instances have a __dict__"] [30 21 "// the built-in solid base: object, BaseException, type, or another built-in"] [31 21 "// __abstractmethods__ non-empty"] [48 1 "// builtinSolid is the built-in type whose instance layout t's instances have (solid_base without the"] [49 1 "// heap types' __slots__)."] [70 1 "// solidBase is solid_base: the most derived type adding to the instance layout."] [83 1 "// unwrap is the built-in value of an instance of a class deriving from a built-in type, else o."] [91 1 "// ---- __build_class__ ----"] [116 1 "// dictArgs are a keyword dictionary as a call's trailing keyword arguments."] [231 1 "// updateBases resolves __mro_entries__ (PEP 560): the same tuple when no base has one."] [272 1 "// calculateMetaclass is _PyType_CalculateMetaclass: the most derived of meta and the bases' types."] [289 1 "// ---- type.__new__, type.__init__, type.__call__ ----"] [370 2 "// __module__, __qualname__, __doc__"] [392 2 "// __new__ a staticmethod, __init_subclass__ and __class_getitem__ classmethods"] [401 2 "// __slots__"] [473 2 "// __classcell__, __classdictcell__"] [490 2 "// __eq__ without __hash__ makes the class unhashable"] [498 2 "// __set_name__"] [510 2 "// __init_subclass__"] [525 1 "// checkLayouts refuses bases whose instance layouts conflict."] [536 1 "// bestBase is best_base: the base whose solid base is the most derived."] [554 1 "// c3MRO is the C3 linearization of t over its bases (mro_internal's mro_implementation)."] [613 1 "// mangle is _Py_Mangle: __x in class C is _C__x."] [636 1 "// ---- object.__new__, object.__init__ ----"] [638 1 "// overrides is a heap class of t's MRO defining name, or, for __new__, t's built-in solid base not"] [639 1 "// object (a built-in type's inherited slot cannot be told from its own: Go's functions do not compare)."] [708 2 "// The data model's slots of object and type (REQUEST to PY5b: leave these to class.go)."] [721 1 "// ---- the slots of a class (fixup_slot_dispatchers, update_slot) ----"] [727 1 "// pyDefined is name defined by a heap class of t's MRO (a Python method), and its value."] [736 1 "// fixupSlots fills t's slots: the built-in solid base's (unwrapping a built-in subclass's value),"] [737 1 "// then a dispatcher for each special method a class of the MRO defines. Rerun on a class's"] [738 1 "// special attribute's assignment, for it and its subclasses."] [1038 1 "// unwrapSlots makes a built-in base's slots work on its subclass's instances: each argument that is"] [1039 1 "// such an instance replaced by its value, and the base's __new__'s value wrapped in the instance."] [1107 1 "// wrapNew is a built-in __new__ called for a class deriving from it: its value in an instance."] [1124 1 "// callSpecial calls o's special method name (looked up on its type, as CPython's lookup_maybe_method)."] [1133 1 "// callSpecialOr is callSpecial, NotImplemented when o's type has no such method."] [1142 1 "// CallSpecial calls o's special method name, found reports whether o's type has it (for the"] [1143 1 "// built-ins with no slot: __abs__, __divmod__, __round__, __format__, __reversed__ ...)."] [1153 1 "// indexOf is operator.index(o)."] [1176 1 "// objectRichCompare is object's __eq__ (identity), __ne__ (__eq__ inverted), the rest NotImplemented."] [1202 1 "// updateSubclassSlots refills the slots of t and its subclasses after a special attribute changed"] [1203 1 "// (update_slot over the subclasses: the type version tags' invalidation)."] [1214 1 "// IsSubclass is issubclass(c, cls) with __subclasscheck__; IsInstanceOf isinstance(o, cls) with"] [1215 1 "// __instancecheck__ (PyObject_IsInstance, PyObject_IsSubclass)."] [1352 1 "// posArgs checks a built-in's positional argument count, CPython's messages."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[42 24] [73 25] [85 27] [109 32] [155 33] [184 32] [208 60] [217 26] [218 30] [236 24] [316 24] [332 48] [361 50] [367 33] [372 32] [373 40] [378 46] [381 37] [393 48] [397 41] [411 35] [413 24] [470 34] [474 38] [482 42] [500 76] [506 61] [518 33] [641 32] [661 61] [663 29] [669 26] [758 55] [759 38] [765 38] [841 55] [849 51] [864 38] [880 38] [902 31] [920 38] [933 42] [966 32] [978 32] [1041 16] [1044 15] [1047 16] [1050 16] [1053 15] [1056 23] [1059 16] [1062 16] [1065 19] [1068 19] [1071 20] [1075 22] [1078 23] [1081 23] [1086 21] [1090 17] [1093 15] [1096 17] [1099 15] [1102 16] [1155 22] [1158 30] [1163 31] [1217 25] [1220 28] [1229 60] [1240 25] [1244 47] [1245 26] [1251 33] [1262 28] [1271 60] [1283 31] [1286 33] [1321 43] [1331 55] [1341 55]]} (go/file "class.go" :imports [



"// importErrorType is ImportError when the runtime has it, else RuntimeError."] [1441 1 "// objectGetState is object.__getstate__: the instance's __dict__ (None when empty), with its"] [1442 1 "// __slots__' values as a second dictionary."] [1536 3 "// typeobject.c's object___reduce_ex___impl: a __reduce__ overriding object's, a built-in type's too"] [1562 1 "// BuiltinValue is the built-in value an instance of a class deriving from a built-in type carries"] [1563 1 "// (a list subclass's list), else o itself: for the core types' functions taking their subclasses."] [1566 1 "// builtinHasDict is a built-in type's tp_dictoffset: it, or a built-in type it derives from, shows a __dict__."] [1576 1 "// builtinHasWeak is a built-in type's tp_weaklistoffset, for the types one can derive from."] [1587 1 "// varSized is a type's tp_itemsize: its instances hold their items after the header, so that a class deriving"] [1588 1 "// from it can add no __slots__ and no __weakref__ (type has an itemsize too, and its own weak list)."] [1597 1 "// newSlots is type_new_slots over __slots__ (sl nil: none): the class's own slot names, sorted as"] [1598 1 "// type_new_copy_slots sorts them, and what it adds."] [1619 2 "// type_new_slots_impl's check: identifiers, __dict__ and __weakref__ once"] [1641 2 "// type_new_copy_slots"] [1651 5 "// CPython puts these names in the namespace itself: they leave it below"] [1659 2 "// type_new_slots_bases: a secondary base's __dict__ and __weakref__ come along"] [1676 1 "// addLayoutDescrs is type_add_getset of what the class added: subtype_getsets_full's __dict__ and __weakref__."] [1686 1 "// subtypeGetDict and subtypeSetDict are subtype_dict and subtype_setdict: a dict subclass's instance keeps its"] [1687 1 "// identity (the dict's self), deleting leaves a fresh dictionary (CPython's is made on the next use)."] [1691 46 "// get_builtin_base_with_dict: type's __dict__"] [1733 1 "// dictOf is the dict of a dict or of a dict subclass's instance, nil for anything else; the instance stays the"] [1734 1 "// dict's self for __dict__'s getter."] [1755 1 "// hasGC is HAVE_GC, tp_free's choice: a class that adds nothing to a base without it has none."] [1768 1 "// compatibleWithBase is compatible_with_tp_base. A built-in type: the exceptions that add no fields to theirs."] [1789 1 "// sameSlotsAdded is same_slots_added."] [1806 1 "// managedLayout is the flags compatible_for_assignment compares: Py_TPFLAGS_MANAGED_DICT, MANAGED_WEAKREF (the"] [1807 1 "// preheader: a class's own or inherited __dict__ and __weakref__, not a built-in type's) and INLINE_VALUES."] [1821 1 "// compatibleForAssignment is compatible_for_assignment."] [1841 1 "// objectSetClass is object_set_class."] [1874 1 "// slotsOf is the slot values of an object with __slots__ (an instance, a module subclass's), nil for none."] [1885 1 "// checkClassCells is type_new_set_classcell and type_new_set_classdictcell."] [1906 1 "// reprOrName is repr(o), or its type's name when repr fails."] [1914 1 "// mroInternal is mro_internal: the metaclass's mro() when it overrides type's, checked (mro_check), else C3. An"] [1915 1 "// inner call that already set the MRO (a reentrant mro()) wins: done false."] [1951 14 "// the type attribute cache: an MRO set"] [1955 1 "// sameMRO is the same list, not an equal one (CPython compares the tuple's identity)."] [1965 1 "// mroHierarchy is mro_hierarchy: t's MRO and its subclasses' computed again, the old ones kept in undo."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[47 24] [78 25] [90 27] [103 26] [104 35] [125 32] [171 33] [200 32] [227 60] [236 26] [237 30] [255 24] [335 24] [351 48] [382 23] [390 102] [401 36] [404 31] [409 32] [410 40] [415 46] [418 37] [427 48] [431 41] [439 72] [445 34] [466 76] [472 68] [491 33] [614 32] [638 61] [640 29] [646 26] [750 55] [752 38] [758 38] [834 55] [842 51] [857 38] [872 28] [882 38] [904 31] [922 38] [935 42] [968 32] [980 32] [1015 37] [1048 16] [1051 15] [1054 16] [105
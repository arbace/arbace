;; Classes (PY5c; CPython's Objects/typeobject.c and builtin___build_class__ of Python/bltinmodule.c):
;; the class statement's __build_class__, type.__new__ with its C3 MRO, metaclasses, __prepare__,
;; __mro_entries__, __init_subclass__ and __set_name__, the instances of classes, object.__new__ and
;; object.__init__, and the slots of a class filled from its special methods (fixup_slot_dispatchers).




^{:go/pos {:doc [13 1] :tok-pos [16 1]}} (go/type ^{:go/pos {:name-pos [16 6]}} Instance "Instance is an instance of a class (a heap type): its class, its __dict__ (nil under __slots__\nwithout __dict__), its __slots__' values, and, for a class deriving from a built-in type other than\nobject, BaseException and type, the built-in base's value the inherited slots work on.\n" ^{:go/pos {:lbrace [16 22] :rbrace [23 1] :struct [16 15]}} (struct

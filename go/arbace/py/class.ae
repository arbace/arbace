dule subclass's), nil for none."] [2033 1 "// checkClassCells is type_new_set_classcell and type_new_set_classdictcell."] [2054 1 "// reprOrName is repr(o), or its type's name when repr fails."] [2062 1 "// mroInternal is mro_internal: the metaclass's mro() when it overrides type's, checked (mro_check), else C3. An"] [2063 1 "// inner call that already set the MRO (a reentrant mro()) wins: done false."] [2099 14 "// the type attribute cache: an MRO set"] [2103 1 "// sameMRO is the same list, not an equal one (CPython compares the tuple's identity)."] [2113 1 "// mroHierarchy is mro_hierarchy: t's MRO and its subclasses' computed again, the old ones kept in undo."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[47 24] [78 25] [90 27] [103 26] [104 35] [125 32] [171 33] [200 32] [227 60] [236 26] [237 30] [255 24] [335 24] [351 48] [382 23] [390 102] [401 36] [404 31] [409 32] [410 40] [415 46] [418 37] [427 48] [431 41] [439 72] [445 34] [466 76] [472 68] [491 33] [617 32] [641 61] [643 29] [649 26] [759 55] [761 38] [767 38] [835 29] [836 36] [856 55] [864 51] [879 38] [894 28] [904 38] [926 31] [944 38] [957 42] [990 32] [1002 32] [1037 37] [1070 16] [1073 15] [1076 16] [1079 16] [1082 15] [1085 23] [1088 16] [1098 16] [1101 19] [1104 19] [1107 20] [1111 22] [1114 23] [1117 23] [1122 21] [1126 17] [1129 15] [1132 17] [1135 15] [1138 16] [1166 27] [1216 22] [1219 30] [1224 31] [1278 25] [1281 28] [1297 60] [1313 25] [1317 47] [1318 26] [1324 94] [1335 28] [1349 60] [1366 63] [1369 97] [1382 24] [1417 43] [1456 75] [1478 25] [1512 27] [1535 42] [1553 57] [1570 61] [1592 33] [1601 37] [1615 53] [1676 32] [1681 52] [1688 23] [1755 23] [1759 32] [1862 29] [1866 25] [1884 23] [1887 27] [1888 30] [1897 24] [1960 12] [1960 35] [2002 62] [2035 38] [2043 42] [2056 22] [2092 40] [2121 34]]} (go/file "class.go" :imports [



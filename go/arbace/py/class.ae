(in-ns 'go.arbace.py) ^{:go/comments [[8 1 "// Classes (PY5c; CPython's Objects/typeobject.c and builtin___build_class__ of Python/bltinmodule.c):"] [9 1 "// the class statement's __build_class__, type.__new__ with its C3 MRO, metaclasses, __prepare__,"] [10 1 "// __mro_entries__, __init_subclass__ and __set_name__, the instances of classes, object.__new__ and"] [11 1 "// object.__init__, and the slots of a class filled from its special methods (fixup_slot_dispatchers)."] [13 1 "// Instance is an instance of a class (a heap type): its class, its __dict__ (nil under __slots__"] [14 1 "// without __dict__), its __slots__' values, and, for a class deriving from a built-in type other than"] [15 1 "// object, BaseException and type, the built-in base's value the inherited slots work on."] [25 1 "// classInfo is what type.__new__ records of a class beyond the Type (CPython's heap type fields)."] [27 21 "// this class's own __slots__ (mangled), in order"] [28 21 "// the instance's slot count, the bases' included"] [29 21 "// its instances have a __dict__"] [30 21 "// the built-in solid base: object, BaseException, type, or another built-in"] [31 21 "// __abstractmethods__ non-empty"] [48 1 "// builtinSolid is the built-in type whose instance layout t's instances have (solid_base without the"] [49 1 "// heap types' __slots__)."] [70 1 "// solidBase is solid_base: the most derived type adding to the instance layout."] [83 1 "// unwrap is the built-in value of an instance of a class deriving from a built-in type, else o."] [91 1 "// ---- __build_class__ ----"] [94 2 "// PY5b's hooks (§7.1): the core accessors take a subclass's built-in value; a bound method of a Python"] [95 2 "// function is called by pushing its frame"] [127 1 "// dictArgs are a keyword dictionary as a call's trailing keyword arguments."] [214 20 "// a dict subclass's __setitem__ sees the body's names (PY5e, part 2b)"] [245 1 "// updateBases resolves __mro_entries__ (PEP 560): the same tuple when no base has one."] [286 1 "// calculateMetaclass is _PyType_CalculateMetaclass: the most derived of meta and the bases' types."] [303 1 "// ---- type.__new__, type.__init__, type.__call__ ----"] [385 2 "// __module__, __qualname__, __doc__"] [405 32 "// not when __slots__ names __doc__ (typing's _SpecialForm): the slot's descriptor is it"] [407 2 "// __new__ a staticmethod, __init_subclass__ and __class_getitem__ classmethods"] [416 2 "// __slots__"] [420 20 "// a class without __slots__ gives its instances a __dict__"] [481 2 "// __classcell__, __classdictcell__"] [498 2 "// __eq__ without __hash__ makes the class unhashable"] [506 2 "// __set_name__"] [518 2 "// __init_subclass__"] [533 1 "// checkLayouts refuses bases whose instance layouts conflict."] [544 1 "// bestBase is best_base: the base whose solid base is the most derived."] [562 1 "// c3MRO is the C3 linearization of t over its bases (mro_internal's mro_implementation)."] [621 1 "// mangle is _Py_Mangle: __x in class C is _C__x."] [644 1 "// ---- object.__new__, object.__init__ ----"] [646 1 "// overrides is a heap class of t's MRO defining name, or, for __new__, t's built-in solid base not"] [647 1 "// object (a built-in type's inherited slot cannot be told from its own: Go's functions do not compare)."] [716 2 "// The data model's slots of object and type (REQUEST to PY5b: leave these to class.go)."] [729 1 "// ---- the slots of a class (fixup_slot_dispatchers, update_slot) ----"] [735 1 "// pyDefined is name defined by a heap class of t's MRO (a Python method), and its value."] [744 1 "// fixupSlots fills t's slots: the built-in solid base's (unwrapping a built-in subclass's value),"] [745 1 "// then a dispatcher for each special method a class of the MRO defines. Rerun on a class's"] [746 1 "// special attribute's assignment, for it and its subclasses."] [767 4 "// dict's subscript sees the subclass's instance (its __missing__; dict's accessors take the"] [768 4 "// instance through BuiltinValueHook): PY5e, part 2b"] [891 4 "// slot_tp_call's _Py_EnterRecursiveCall (REQUEST of PY6g for PY6-core: test_descr's"] [892 4 "// test_recursive_call, A.__call__ = A(), overflowed Go's stack)"] [1061 1 "// unwrapSlots makes a built-in base's slots work on its subclass's instances: each argument that is"] [1062 1 "// such an instance replaced by its value, and the base's __new__'s value wrapped in the instance."] [1130 1 "// wrapNew is a built-in __new__ called for a class deriving from it: its value in an instance."] [1147 1 "// callSpecial calls o's special method name (looked up on its type, as CPython's lookup_maybe_method)."] [1153 2 "// the C level's recursion check (REQUEST of PY6g for PY6-core: test_descr's test_repr_as_str,"] [1154 2 "// __repr__ = __str__ through built-in slot wrappers, overflowed Go's stack)"] [1169 1 "// callSpecialOr is callSpecial, NotImplemented when o's type has no such method."] [1178 1 "// CallSpecial calls o's special method name, found reports whether o's type has it (for the"] [1179 1 "// built-ins with no slot: __abs__, __divmod__, __round__, __format__, __reversed__ ...)."] [1189 1 "// asIndex is operator.index(o)."] [1212 1 "// objectRichCompare is object's __eq__ (identity), __ne__ (__eq__ inverted), the rest NotImplemented."] [1238 1 "// updateSubclassSlots refills the slots of t and its subclasses after a special attribute changed"] [1239 1 "// (update_slot over the subclasses: the type version tags' invalidation)."] [1250 1 "// IsSubclass is issubclass(c, cls) with __subclasscheck__; IsInstanceOf isinstance(o, cls) with"] [1251 1 "// __instancecheck__ (PyObject_IsInstance, PyObject_IsSubclass)."] [1365 1 "// posArgs checks a built-in's positional argument count, CPython's messages."] [1383 1 "// ---- object's pickling protocol (typeobject.c's object___reduce_ex__, reduce_newobj, object_getstate) ----"] [1385 1 "// importModule is __import__(name) through the interpreter's builtins (PY5e's import system)."] [1394 1 "// importErrorType is 
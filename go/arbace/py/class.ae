    ^{:tag ^{:go/pos {:lbrack [19 8]}} (slice ^{:go/pos {:name-pos [19 10]}} Object) :go/pos {:name-pos [19 2]}} slots
    ^{:tag ^{:go/pos {:name-pos [20 8]}} Object :go/pos {:name-pos [20 2]}} value

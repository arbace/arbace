(in-ns 'go.arbace.py) ^{:go/comments [[8 1 "// Classes (PY5c; CPython's Objects/typeobject.c and builtin___build_class__ of Python/bltinmodule.c):"] [9 1 "// the class statement's __build_class__, type.__new__ with its C3 MRO, metaclasses, __prepare__,"] [10 1 "// __mro_entries__, __init_subclass__ and __set_name__, the instances of classes, object.__new__ and"] [11 1 "// object.__init__, and the slots of a class filled from its special methods (fixup_slot_dispatchers)."] [13 1 "// Instance is an instance of a class (a heap type): its class, its __dict__ (nil under __slots__"] [14 1 "// without __dict__), its __slots__' values, and, for a class deriving from a built-in type other than"] [15 1 "// object, BaseException and type, the built-in base's value the inherited slots work on."] [25 1 "// classInfo is what type.__new__ records of a class beyond the Type (CPython's heap type fields)."] [27 21 "// this class's own __slots__ (mangled), in order"] [28 21 "// the instance's slot count, the bases' included"] [29 21 "// its instances have a __dict__"] [30 21 "// the built-in solid base: object, BaseException, type, or another built-in"] [31 21 "// __abstractmethods__ non-empty"] [48 1 "// builtinSolid is the built-in type whose instance layout t's instances have (solid_base without the"] [49 1 "// heap types' __slots__)."] [70 1 "// solidBase is solid_base: the most derived type adding to the instance layout."] [83 1 "// unwrap is the built-in value of an instance of a class deriving from a built-in type, else o."] [91 1 "// ---- __build_class__ ----"] [94 2 "// PY5b's hooks (§7.1): the core accessors take a subclass's built-in value; a bound method of a Python"] [95 2 "// function is called by pushing its frame"] [127 1 "// dictArgs are a keyword dictionary as a call's trailing keyword arguments."] [214 20 "// a dict subclass's __setitem__ sees the body's names (PY5e, part 2b)"] [245 1 "// updateBases resolves __mro_entries__ (PEP 560): the same tuple when no base has one."] [286 1 "// calculateMetaclass is _PyType_CalculateMetaclass: the most derived of meta and the bases' types."] [303 1 "// ---- type.__new__, type.__init__, type.__call__ ----"] [384 2 "// __module__, __qualname__, __doc__"] [406 2 "// __new__ a staticmethod, __init_subclass__ and __class_getitem__ classmethods"] [415 2 "// __slots__"] [419 20 "// a class without __slots__ gives its instances a __dict__"] [480 2 "// __classcell__, __classdictcell__"] [497 2 "// __eq__ without __hash__ makes the class unhashable"] [505 2 "// __set_name__"] [517 2 "// __init_subclass__"] [532 1 "// checkLayouts refuses bases whose instance layouts conflict."] [543 1 "// bestBase is best_base: the base whose solid base is the most derived."] [561 1 "// c3MRO is the C3 linearization of t over its bases (mro_internal's mro_implementation)."] [620 1 "// mangle is _Py_Mangle: __x in class C is _C__x."] [643 1 "// ---- object.__new__, object.__init__ ----"] [645 1 "// overrides is a heap class of t's MRO defining name, or, for __new__, t's built-in solid base not"] [646 1 "// object (a built-in type's inherited slot cannot be told from its own: Go's functions do not compare)."] [715 2 "// The data model's slots of object and type (REQUEST to PY5b: leave these to class.go)."] [728 1 "// ---- the slots of a class (fixup_slot_dispatchers, update_slot) ----"] [734 1 "// pyDefined is name defined by a heap class of t's MRO (a Python method), and its value."] [743 1 "// fixupSlots fills t's slots: the built-in solid base's (unwrapping a built-in subclass's value),"] [744 1 "// then a dispatcher for each special method a class of the MRO defines. Rerun on a class's"] [745 1 "// special attribute's assignment, for it and its subclasses."] [766 4 "// dict's subscript sees the subclass's instance (its __missing__; dict's accessors take the"] [767 4 "// instance through BuiltinValueHook): PY5e, part 2b"] [1051 1 "// unwrapSlots makes a built-in base's slots work on its subclass's instances: each argument that is"] [1052 1 "// such an instance replaced by its value, and the base's __new__'s value wrapped in the instance."] [1120 1 "// wrapNew is a built-in __new__ called for a class deriving from it: its value in an instance."] [1137 1 "// callSpecial calls o's special method name (looked up on its type, as CPython's lookup_maybe_method)."] [1146 1 "// callSpecialOr is callSpecial, NotImplemented when o's type has no such method."] [1155 1 "// CallSpecial calls o's special method name, found reports whether o's type has it (for the"] [1156 1 "// built-ins with no slot: __abs__, __divmod__, __round__, __format__, __reversed__ ...)."] [1166 1 "// asIndex is operator.index(o)."] [1189 1 "// objectRichCompare is object's __eq__ (identity), __ne__ (__eq__ inverted), the rest NotImplemented."] [1215 1 "// updateSubclassSlots refills the slots of t and its subclasses after a special attribute changed"] [1216 1 "// (update_slot over the subclasses: the type version tags' invalidation)."] [1227 1 "// IsSubclass is issubclass(c, cls) with __subclasscheck__; IsInstanceOf isinstance(o, cls) with"] [1228 1 "// __instancecheck__ (PyObject_IsInstance, PyObject_IsSubclass)."] [1342 1 "// posArgs checks a built-in's positional argument count, CPython's messages."] [1360 1 "// ---- object's pickling protocol (typeobject.c's object___reduce_ex__, reduce_newobj, object_getstate) ----"] [1362 1 "// importModule is __import__(name) through the interpreter's builtins (PY5e's import system)."] [1371 1 "// importErrorType is ImportError when the runtime has it, else RuntimeError."] [1387 1 "// objectGetState is object.__getstate__: the instance's __dict__ (None when empty), with its"] [1388 1 "// __slots__' values as a second dictionary."] [1506 1 "// BuiltinValue is the built-in value an instance of a class deriving from a built-in type carries"] [1507 1 "// (a list subclass's list), else o itself: for the core types' functions taking their subclasses."]] :go/pos {:name [1 9] :pa
call's frame (its"] [325 1 "// code flagged :generator or :coroutine): PY5d's gen.go sets it."] [328 1 "// callFunction calls a Python function from Go: a frame run by a nested loop to its return."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[68 12] [68 30] [95 27] [95 35] [96 21] [165 47] [215 21] [215 43] [227 15] [227 30] [238 26] [252 19] [252 41] [269 28] [269 41] [276 12] [276 25] [285 18] [285 40]]} (go/file "frame.go" :imports [


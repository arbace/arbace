(in-ns 'go.arbace.py) ^{:go/comments [[10 1 "// IntType is int: arbitrary precision, an int64 when the value fits and a *big.Int beyond."] [13 1 "// Int is an int (and, embedded, a bool's value). b is nil when the value fits in v; otherwise v is 0"] [14 1 "// and b holds it (never a value that fits in int64: newIntBig normalizes)."] [22 1 "// BaseInt is the int value of an int, a bool, or an instance of an int subclass that embeds Int (the"] [23 1 "// subclass convention of PYI-SPEC.md §7.1)."] [26 25 "// -5 .. 256, interned as CPython's"] [34 1 "// NewInt is the int of v (the interned one for -5 to 256)."] [42 1 "// NewIntBig is the int of b (not retained when it fits in int64)."] [50 1 "// Int64 is the int's value; ok false when it does not fit in int64."] [58 1 "// Big is the int's value as a new *big.Int."] [66 1 "// Sign is -1, 0 or 1."] [80 1 "// asInt is o's int value when o is an int, a bool or an int subclass's instance."] [96 1 "// AsInt is o's int value when o is an int (a bool, an int subclass's instance): exported for the"] [97 1 "// other files' builtins."] [100 1 "// cmpInt is x <=> y."] [116 1 "// intToFloat is float(i) (OverflowError beyond the doubles), correctly rounded."] [128 1 "// maxStrDigits is sys.get_int_max_str_digits() (CPython's default 4300; 0 disables the limit)."] [131 1 "// intText is i in base 10, with the 4,300-digit limit."] [136 57 "// more than MaxStrDigits digits needs over 3.32 bits a digit"] [137 3 "// at least floor((bits-1)·log10 2) + 1 digits: past the limit for sure, refused before converting"] [138 3 "// (CPython's early check: test_int's test_denial_of_service_prevented_int_to_str times it, 202b)"] [152 1 "// IntBinary is a op b on two ints (BinTrueDiv a float, BinPow with a negative exponent a float)."] [250 62 "// 0 / -n is -0.0 (a Rat has no signed zero)"] [287 1 "// IntPow is pow(x, y) or pow(x, y, m) on ints (a negative exponent without m a float)."] [302 4 "// exact by squaring while it fits"] [368 1 "// ParseInt is int(s, base) (CPython's PyLong_FromString: whitespace, a sign, underscores between"] [369 1 "// digits, the 0x/0o/0b prefixes with base 0 or their own base)."] [374 1 "// ParseIntBytes is int(b, base) of a bytes-like object: its bytes as ASCII text, the error naming them as bytes"] [375 1 "// (_PyLong_FromBytes' %R of a bytes object; queue 286: test_int's test_error_message)."] [380 1 "// ParseIntStr is int(s, base) of a str: _PyUnicode_TransformDecimalAndSpaceToASCII first (queue 286: a Unicode"] [381 1 "// decimal digit as its ASCII digit, a Unicode space as ' ', any other non-ASCII character invalid; test_decimal's"] [382 1 "// test_unicode_digits), the error naming the str as given. An ASCII str (its flag) is parsed as it is: no pass over"] [383 1 "// its text before the digits limit's check (under goi an interpreted pass; test_int's"] [384 1 "// test_denial_of_service_prevented_str_to_int times the refusal of 1.2M digits against a conversion)."] [406 1 "// parseInt is ParseInt of text, its error naming orig's value."] [522 1 "// intNew is int(), int(x), int(s, base)."] [541 3 "// long_new_impl: a str (a subclass too), bytes or bytearray (theirs too), any other object a TypeError (queue"] [542 3 "// 286: a str subclass was refused, a memoryview taken; test_int's test_non_numeric_input_types)"] [566 1 "// newIntSubclass makes an instance of an int subclass; PY5c sets it (classes' instances)."] [593 1 "// ToInt is int(x): an int's value, __int__, __index__, a float truncated, a str or bytes parsed."] [596 3 "// PyNumber_Long: an exact int as it is; a subclass's nb_int, its own __int__ (int's gives the value; queue 537:"] [597 3 "// one that returns a strict subclass of int is deprecated, test_int's test_int_returns_int_subclass)"] [622 2 "// a str subclass, a bytearray, any other buffer (PyNumber_Long's PyUnicode_Check and the buffer's"] [623 2 "// _PyLong_FromBytes; queue 286: int() of a str subclass was a TypeError)"] [633 1 "// floatToInt is int(f): truncated toward zero."] [649 1 "// Index is operator.index(o): an int, or __index__'s."] [667 1 "// IndexInt is Index's value as an int (an OverflowError beyond, CPython's \"cannot fit 'int' into an"] [668 1 "// index-sized integer\")."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[90 25] [158 17] [162 17] [169 17] [307 22] [315 25] [479 20] [479 36] [543 30] [544 41] [547 31] [549 41] [556 28] [595 22] [598 19] [616 24] [624 22] [627 24] [651 22] [654 30] [659 23]]} (go/file "int.go" :imports [



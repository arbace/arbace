(in-ns 'go.arbace.py) ^{:go/comments [[3 1 "// The registry of built-in types and functions (doc/python/PYI-SPEC.md §7.3): each file of the runtime"] [4 1 "// declares its types as package variables made by NewBuiltinType (no slots: slots are set in the file's"] [5 1 "// init function, after every type exists, so the slots' functions may name any type) and registers"] [6 1 "// its built-in functions with RegisterBuiltin. The builtins module of an Interp is made from the"] [7 1 "// registry: every registered type and function whose name is public, in registration order."] [15 1 "// NewBuiltinType makes a built-in type with name, base (nil: object) and flags, registered for the"] [16 1 "// builtins module when public (its name not starting with \"_\" and not hidden by Private)."] [24 1 "// finishType computes a built-in type's bases and MRO: its Base's chain, or, when Bases was preset"] [25 1 "// with several (ExceptionGroup's), their C3 linearization (the bases finished first)."] [40 16 "// the type attribute cache: an MRO set"] [51 15 "// the type attribute cache: an MRO set"] [55 14 "// the type attribute cache: an MRO set"] [60 1 "// ComputeMRO is C3's linearization of t with bases (type.mro(): CPython's mro_implementation), or a"] [61 1 "// TypeError when the bases' orders conflict."] [117 1 "// OnTypesReady runs f once every registered type is ready (its slots set and inherited), before the"] [118 1 "// first interpreter: where a file fills its types' dictionaries when it needs other files' slots."] [123 1 "// RegisterBuiltin adds a function of the builtins module; a second function of one name is a"] [124 1 "// programming error (one owner per name, PYI-SPEC.md §9)."] [135 1 "// hiddenTypes are registered types not bound in builtins (CPython's types module names them)."] [141 1 "// newBuiltinsDict makes the dictionary of a new builtins module."] [155 62 "// builtins' one underscored type (PY7)"] [161 30 "// PY6a, by the integration's owner (test_grammar)"] [170 1 "// readyTypes completes every registered type once, after every file's init has set its slots"] [171 1 "// (CPython's PyType_Ready): bases, MRO, and the slots a type leaves nil inherited from its base."] [189 2 "// type_ready's type_dict_set_doc: a static type's dict always holds __doc__, its tp_doc or None (pyi has no C"] [190 2 "// docstrings yet: None), so an instance's __doc__ is found (\"abc\".__doc__ raised AttributeError; email's"] [191 2 "// _policybase reads attr.__doc__ of every class attribute); not where the type or a base answers __doc__ by a"] [192 2 "// getset (pyi's getsets are outside the dict: property's settable __doc__ would be shadowed)"] [195 33 "// CPython's tp_doc less its signature (py-core-1124)"] [204 1 "// docGetSet reports whether a type of t's MRO has a __doc__ getset."] [227 1 "// inheritSlots fills s's nil slots from b's (CPython's inherit_slots)."] [326 1 "// ownSlots are the special methods a built-in type defines itself, before inheritSlots fills the rest:"] [327 1 "// its __dict__ lists their slot wrappers, as CPython's does (enum's _find_data_type_ asks"] [328 1 "// '__new__' in int.__dict__). Added by PY5e as the integration's owner (part 2b)."] [345 2 "// add_operators: the number protocol's and the comparisons' wrappers (PY6e's REQUEST d27906db)"] [370 1 "// slottedName: the special methods recordOwnSlots records; ownsSlot is built-in type m showing name's wrapper in"] [371 1 "// its own __dict__: a subclass inherits the slot, so that bool.__add__ is int.__add__ as in CPython."] [379 1 "// inheritsNew are the built-in types whose tp_new is their base's (queue 545: _io's types but FileIO, BytesIO and"] [380 1 "// StringIO): no __new__ of their own, though their Slots.New makes their value."] [400 3 "// \"r\"+d and \"i\"+d compared without making them (queue 305: a concatenation per name, 5% of an import's start)"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[38 40] [195 26]] :go/trails [[138 122]]} (go/file "registry.g
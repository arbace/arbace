(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// Descriptors (PY5c; CPython's Objects/descrobject.c, funcobject.c's classmethod and staticmethod,"] [6 1 "// classobject.c's method, typeobject.c's super and slot wrappers): bound methods, functions as"] [7 1 "// descriptors, classmethod, staticmethod, property, __slots__' members, super, the slot wrappers"] [8 1 "// that show a built-in type's slots as methods, and the attributes of types, functions and methods."] [21 1 "// Method is a bound method: a function and the object it is bound to."] [28 1 "// ClassMethod and StaticMethod wrap a callable."] [43 1 "// Property is property(fget, fset, fdel, doc)."] [47 27 "// a subclass of property"] [57 1 "// Member is a __slots__ entry's descriptor."] [66 1 "// Super is super(type, obj)."] [75 1 "// slotWrapper is a built-in type's slot as a method (wrapper_descriptor)."] [84 1 "// mappingProxy is a type's __dict__ read only."] [87 10 "// the type whose __dict__ it is, or nil"] [106 1 "// newWrappers are the built-in types' __new__ objects, one each."] [114 1 "// slotWrappers keep one wrapper per type and name, so that int.__repr__ is int.__repr__ (enum compares"] [115 1 "// a class's methods with its data type's and object's; PY5e, part 2b)."] [118 1 "// slotWrapperFor is built-in type m's slot for the special method name, or nil."] [150 4 "// object_str: tp_repr, never the type's own __str__ (REQUEST of PY6g for PY6-core: a class with"] [151 4 "// __str__ = object.__str__, doctest's DocTestCase, recursed without end)"] [356 3 "// one object per type, so that object.__new__ is object.__new__ (enum's _find_new_ compares them;"] [357 3 "// PY5e, part 2b)"] [440 1 "// objectDir is object.__dir__: the instance's dictionary's keys and its class's attributes."] [484 1 "// superArgs are super()'s zero arguments: the running function's first argument and its __class__ cell."] [544 2 "// functions as descriptors, bound methods"] [551 2 "// types.MethodType(func, instance) (method_new)"] [611 2 "// slot wrappers"] [639 2 "// classmethod, staticmethod"] [747 2 "// property"] [879 2 "// __slots__' members"] [935 2 "// super"] [1028 2 "// mappingproxy"] [1030 2 "// mappingproxy(mapping), over a dict (PY6a: enum's __members__); other mappings are the data model's"] [1044 2 "// a built-in type's own slots' wrappers (ownSlots, registry.go) are in its __dict__ too (PY5e, part 2b)"] [1052 14 "// a built-in type's attribute descriptors (type.__dict__['__annotations__']: annotationlib)"] [1471 1 "// excSlots are the __slots__ values of exceptions (an exception class's instances are *Exception, not"] [1472 1 "// *Instance): PY6a, by the integration's owner, for test_exceptions' slotted exception classes."] [1475 1 "// newStaticBase is tp_new_wrapper's staticbase (REQUEST of PY6g for PY6-core: test_descr's test_bad_new): t, or"] [1476 1 "// the first base along __base__ whose __new__ is not a Python class's own (slot_tp_new)."] [1484 1 "// newOrigin is the built-in type whose __new__ t's tp_new is (inherited along __base__ from the first one"] [1485 1 "// that defines it), CPython's tp_new pointer compared."] [1499 1 "// newAliases: the built-in types whose own __new__ here is CPython's inherited one (defaultdict's is dict_new)"] [1502 1 "// isNewWrapper: v is a built-in type's __new__ (tp_new_wrapper); a class whose __new__ is one keeps the"] [1503 1 "// __new__ it inherits (update_one_slot's special case), so that class C(list): __new__ = object.__new__"] [1504 1 "// makes lists"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[121 29] [139 37] [152 67] [163 63] [168 68] [173 67] [189 37] [206 37] [228 37] [264 37] [275 38] [280 37] [290 37] [335 38] [340 37] [358 26] [372 29] [399 25] [401 38] [419 37] [443 25] [445 24] [460 24] [516 26] [526 23] [569 34] [572 36] [580 54] [603 55] [642 49] [659 50] [713 21] [714 36] [725 43] [778 38] [786 28] [788 56] [828 42] [854 50] [864 53] [869 48] [870 26] [885 31] [886 32] [895 30] [902 31] [938 43] [977 51] [982
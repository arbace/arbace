(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// Descriptors (PY5c; CPython's Objects/descrobject.c, funcobject.c's classmethod and staticmethod,"] [6 1 "// classobject.c's method, typeobject.c's super and slot wrappers): bound methods, functions as"] [7 1 "// descriptors, classmethod, staticmethod, property, __slots__' members, super, the slot wrappers"] [8 1 "// that show a built-in type's slots as methods, and the attributes of types, functions and methods."] [21 1 "// Method is a bound method: a function and the object it is bound to."] [28 1 "// ClassMethod and StaticMethod wrap a callable."] [43 1 "// Property is property(fget, fset, fdel, doc)."] [47 27 "// a subclass of property"] [57 1 "// Member is a __slots__ entry's descriptor."] [66 1 "// Super is super(type, obj)."] [75 1 "// slotWrapper is a built-in type's slot as a method (wrapper_descriptor)."] [84 1 "// mappingProxy is a type's __dict__ read only."] [87 10 "// the type whose __dict__ it is, or nil"] [106 1 "// newWrappers are the built-in types' __new__ objects, one each."] [114 1 "// slotWrappers keep one wrapper per type and name, so that int.__repr__ is int.__repr__ (enum compares"] [115 1 "// a class's methods with its data type's and object's; PY5e, part 2b)."] [118 1 "// slotWrapperFor is built-in type m's slot for the special method name, or nil."] [145 2 "// the number protocol's binary methods (__add__, __radd__, __iadd__ ...): the Binary, RBinary and InPlace"] [146 2 "// slots, NotImplemented when they do not apply (PY6h's REQUEST, queue 200: test_asyncio reads int.__add__)"] [168 6 "// wrap_ternaryfunc_r: the operands swapped, the modulus third"] [187 4 "// object_str: tp_repr, never the type's own __str__ (REQUEST of PY6g for PY6-core: a class with"] [188 4 "// __str__ = object.__str__, doctest's DocTestCase, recursed without end)"] [393 3 "// one object per type, so that object.__new__ is object.__new__ (enum's _find_new_ compares them;"] [394 3 "// PY5e, part 2b)"] [477 1 "// objectDir is object.__dir__: the instance's dictionary's keys and its class's attributes."] [521 1 "// superArgs are super()'s zero arguments: the running function's first argument and its __class__ cell."] [581 2 "// functions as descriptors, bound methods"] [588 2 "// types.MethodType(func, instance) (method_new)"] [648 2 "// slot wrappers"] [676 2 "// classmethod, staticmethod"] [784 2 "// property"] [916 2 "// __slots__' members"] [972 2 "// super"] [1065 2 "// mappingproxy"] [1067 2 "// mappingproxy(mapping), over a dict (PY6a: enum's __members__); other mappings are the data model's"] [1081 2 "// a built-in type's own slots' wrappers (ownSlots, registry.go) are in its __dict__ too (PY5e, part 2b)"] [1089 14 "// a built-in type's attribute descriptors (type.__dict__['__annotations__']: annotationlib)"] [1108 2 "// mappingproxy_richcompare: the mapping's own comparison (queue 202: mappingproxy({}) == {} was False; test_re's"] [1109 2 "// test_getattr compares a pattern's groupindex with a dict)"] [1505 2 "// __module__ is func.go's (PY6d's R5: the function's module), which this init's order let override this one"] [1508 1 "// excSlots are the __slots__ values of exceptions (an exception class's instances are *Exception, not"] [1509 1 "// *Instance): PY6a, by the integration's owner, for test_exceptions' slotted exception classes."] [1512 1 "// setTypeBases is type.__bases__'s setter (typeobject.c's type_set_bases; PY6b's request: typing.NamedTuple"] [1513 1 "// assigns a class's bases): a heap type's bases replaced by types of the same instance layout, its MRO and its"] [1514 1 "// subclasses' computed again and their slots refilled."] [1576 14 "// the type attribute cache: an MRO set"] [1585 1 "// newStaticBase is tp_new_wrapper's staticbase (REQUEST of PY6g for PY6-core: test_descr's test_bad_new): t, or"] [1586 1 "// the first base along __base__ whose __new__ is not a Python class's own (slot_tp_new)."] [1594 1 "// newOrigin is the built-in type whose __new__ t's tp_new is (inherited along __base__ from the first one"] [1595 1 "// that defines it), CPython's tp_new pointer compared."] [1609 1 "// newAliases: the built-in types whose own __new__ here is CPython's inherited one (defaultdict's is dict_new)"] [1612 1 "// isNewWrapper: v is a built-in type's __new__ (tp_new_wrapper); a class whose __new__ is one keeps the"] [1613 1 "// __new__ it inherits (update_one_slot's special case), so that class C(list): __new__ = object.__new__"] [1614 1 "// makes lists"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[121 29] [139 37] [176 37] [189 67] [200 63] [205 68] [210 67] [226 37] [243 37] [265 37] [301 37] [312 38] [317 37] [327 37] [372 38] [377 37] [395 26] [409 29] [436 25] [438 38] [456 37] [480 25] [482 24] [497 24] [553 26] [563 23] [606 34] [609 36] [617 54] [640 55] [679 49] [696 50] [750 21] [751 36] [762 43] [815 38] [823 28] [825 56] [865 42] [891 50] [901 53] [906 48] [907 26] [922 31] [923 32] [932 30] [939 31] [975 43] [1014 51] [1019 29] [1025 36] [1053 21] [1059 21] [1072 38] [1087 23] [1088 36] [1100 25] [1122 76] [1134 80] [1139 80] [1144 93] [1165 71] [1204 39] [1215 23] [1227 34] [1248 25] [1264 43] [1274 47] [1281 61] [1292 25] [1370 22] [1374 46] [1376 25] [1380 49] [1382 27] [1399 29] [1439 29] [1452 27] [1491 30] [1499 28] [1550 27] [1578 28] [1597 23] [1620 34]]} (go/file "descr.go" :imports [


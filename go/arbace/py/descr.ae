(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// Descriptors (PY5c; CPython's Objects/descrobject.c, funcobject.c's classmethod and staticmethod,"] [6 1 "// classobject.c's method, typeobject.c's super and slot wrappers): bound methods, functions as"] [7 1 "// descriptors, classmethod, staticmethod, property, __slots__' members, super, the slot wrappers"] [8 1 "// that show a built-in type's slots as methods, and the attributes of types, functions and methods."] [21 1 "// Method is a bound method: a function and the object it is bound to."] [28 1 "// ClassMethod and StaticMethod wrap a callable."] [43 1 "// Property is property(fget, fset, fdel, doc)."] [47 27 "// a subclass of property"] [57 1 "// Member is a __slots__ entry's descriptor."] [66 1 "// Super is super(type, obj)."] [75 1 "// slotWrapper is a built-in type's slot as a method (wrapper_descriptor)."] [84 1 "// mappingProxy is a type's __dict__ read only."] [87 10 "// the type whose __dict__ it is, or nil"] [106 1 "// newWrappers are the built-in types' __new__ objects, one each."] [114 1 "// slotWrappers keep one wrapper per type and name, so that int.__repr__ is int.__repr__ (enum compares"] [115 1 "// a class's methods with its data type's and object's; PY5e, part 2b)."] [118 1 "// slotWrapperFor is built-in type m's slot for the special method name, or nil."] [145 2 "// the number protocol's binary methods (__add__, __radd__, __iadd__ ...): the Binary, RBinary and InPlace"] [146 2 "// slots, NotImplemented when they do not apply (PY6h's REQUEST, queue 200: test_asyncio reads int.__add__)"] [168 6 "// wrap_ternaryfunc_r: the operands swapped, the modulus third"] [187 4 "// object_str: tp_repr, never the type's own __str__ (REQUEST of PY6g for PY6-core: a class with"] [188 4 "// __str__ = object.__str__, doctest's DocTestCase, recursed without end)"] [306 5 "// dict_subscript sees self's type: a subclass's d.__getitem__(k) calls its __missing__ as d[k] does"] [307 5 "// (queue 202: urllib.parse's _Quoter(safe).__getitem__ raised KeyError: test_http_cookies,"] [308 5 "// test_wsgiref's request_uri)"] [400 3 "// one object per type, so that object.__new__ is object.__new__ (enum's _find_new_ compares them;"] [401 3 "// PY5e, part 2b)"] [484 1 "// objectDir is object.__dir__: the instance's dictionary's keys and its class's attributes."] [528 1 "// superArgs are super()'s zero arguments: the running function's first argument and its __class__ cell."] [588 2 "// functions as descriptors, bound methods"] [595 2 "// types.MethodType(func, instance) (method_new)"] [655 2 "// slot wrappers"] [683 2 "// classmethod, staticmethod"] [791 2 "// property"] [923 2 "// __slots__' members"] [979 2 "// super"] [1072 2 "// mappingproxy"] [1074 2 "// mappingproxy(mapping), over a dict (PY6a: enum's __members__); other mappings are the data model's"] [1088 2 "// a built-in type's own slots' wrappers (ownSlots, registry.go) are in its __dict__ too (PY5e, part 2b)"] [1096 14 "// a built-in type's attribute descriptors (type.__dict__['__annotations__']: annotationlib)"] [1115 2 "// mappingproxy_richcompare: the mapping's own comparison (queue 202: mappingproxy({}) == {} was False; test_re's"] [1116 2 "// test_getattr compares a pattern's groupindex with a dict)"] [1512 2 "// __module__ is func.go's (PY6d's R5: the function's module), which this init's order let override this one"] [1515 1 "// excSlots are the __slots__ values of exceptions (an exception class's instances are *Exception, not"] [1516 1 "// *Instance): PY6a, by the integration's owner, for test_exceptions' slotted exception classes."] [1519 1 "// setTypeBases is type.__bases__'s setter (typeobject.c's type_set_bases; PY6b's request: typing.NamedTuple"] [1520 1 "// assigns a class's bases): a heap type's bases replaced by types of the same instance layout, its MRO and its"] [1521 1 "// subclasses' computed again and their slots refilled."] [1583 14 "// the type attribute cache: an MRO set"] [1592 1 "// newStaticBase is tp_new_wrapper's staticbase (REQUEST of PY6g for PY6-core: test_descr's test_bad_new): t, or"] [1593 1 "// the first base along __base__ whose __new__ is not a Python class's own (slot_tp_new)."] [1601 1 "// newOrigin is the built-in type whose __new__ t's tp_new is (inherited along __base__ from the first one"] [1602 1 "// that defines it), CPython's tp_new pointer compared."] [1616 1 "// newAliases: the built-in types whose own __new__ here is CPython's inherited one (defaultdict's is dict_new)"] [1619 1 "// isNewWrapper: v is a built-in type's __new__ (tp_new_wrapper); a class whose __new__ is one keeps the"] [1620 1 "// __new__ it inherits (update_one_slot's special case), so that class C(list): __new__ = object.__new__"] [1621 1 "// makes lists"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[121 29] [139 37] [176 37] [189 67] [200 63] [205 68] [210 67] [226 37] [243 37] [265 37] [301 37] [305 25] [319 38] [324 37] [334 37] [379 38] [384 37] [402 26] [416 29] [443 25] [445 38] [463 37] [487 25] [489 24] [504 24] [560 26] [570 23] [613 34] [616 36] [624 54] [647 55] [686 49] [703 50] [757 21] [758 36] [769 43] [822 38] [830 28] [832 56] [872 42] [898 50] [908 53] [913 48] [914 26] [929 31] [930 32] [939 30] [946 31] [982 43] [1021 51] [1026 29] [1032 36] [1060 21] [1066 21] [1079 38] [1094 23] [1095 36] [1107 25] [1129 76] [1141 80] [1146 80] [1151 93] [1172 71] [1211 39] [1222 23] [1234 34] [1255 25] [1271 43] [1281 47] [1288 61] [1299 25] [1377 22] [1381 46] [1383 25] [1387 49] [1389 27] [1406 29] [1446 29] [1459 27] [1498 30] [1506 28] [1557 27] [1585 28] [1604 23] [1627 34]]} (go/file "descr.go" :imports [


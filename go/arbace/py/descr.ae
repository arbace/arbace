(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// Descriptors (PY5c; CPython's Objects/descrobject.c, funcobject.c's classmethod and staticmethod,"] [6 1 "// classobject.c's method, typeobject.c's super and slot wrappers): bound methods, functions as"] [7 1 "// descriptors, classmethod, staticmethod, property, __slots__' members, super, the slot wrappers"] [8 1 "// that show a built-in type's slots as methods, and the attributes of types, functions and methods."] [21 1 "// Method is a bound method: a function and the object it is bound to."] [28 1 "// ClassMethod and StaticMethod wrap a callable."] [43 1 "// Property is property(fget, fset, fdel, doc)."] [47 27 "// a subclass of property"] [57 1 "// Member is a __slots__ entry's descriptor."] [66 1 "// Super is super(type, obj)."] [75 1 "// slotWrapper is a built-in type's slot as a method (wrapper_descriptor)."] [84 1 "// mappingProxy is a type's __dict__ read only."] [87 10 "// the type whose __dict__ it is, or nil"] [106 1 "// newWrappers are the built-in types' __new__ objects, one each."] [114 1 "// slotWrappers keep one wrapper per type and name, so that int.__repr__ is int.__repr__ (enum compares"] [115 1 "// a class's methods with its data type's and object's; PY5e, part 2b)."] [118 1 "// slotWrapperFor is built-in type m's slot for the special method name, or nil."] [354 3 "// one object per type, so that object.__new__ is object.__new__ (enum's _find_new_ compares them;"] [355 3 "// PY5e, part 2b)"] [435 1 "// objectDir is object.__dir__: the instance's dictionary's keys and its class's attributes."] [479 1 "// superArgs are super()'s zero arguments: the running function's first argument and its __class__ cell."] [539 2 "// functions as descriptors, bound methods"] [546 2 "// types.MethodType(func, instance) (method_new)"] [606 2 "// slot wrappers"] [634 2 "// classmethod, staticmethod"] [742 2 "// property"] [874 2 "// __slots__' members"] [930 2 "// super"] [1023 2 "// mappingproxy"] [1025 2 "// mappingprox
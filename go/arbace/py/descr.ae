(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// Descriptors (PY5c; CPython's Objects/descrobject.c, funcobject.c's classmethod and staticmethod,"] [6 1 "// classobject.c's method, typeobject.c's super and slot wrappers): bound methods, functions as"] [7 1 "// descriptors, classmethod, staticmethod, property, __slots__' members, super, the slot wrappers"] [8 1 "// that show a built-in type's slots as methods, and the attributes of types, functions and methods."] [21 1 "// Method is a bound method: a function and the object it is bound to."] [28 1 "// ClassMethod and StaticMethod wrap a callable."] [43 1 "// Property is property(fget, fset, fdel, doc)."] [47 27 "// a subclass of property"] [57 1 "// Member is a __slots__ entry's descriptor."] [66 1 "// Super is super(type, obj)."] [75 1 "// slotWrapper is a built-in type's slot as a method (wrapper_descriptor)."] [84 1 "// mappingProxy is a type's __dict__ read only."] [87 10 "// the type whose __dict__ it is, or nil"] [106 1 "// newWrappers are the built-in types' __new__ objects, one each."] [114 1 "// slotWrappers keep one wrapper per type and name, so that int.__repr__ is int.__repr__ (enum compares"] [115 1 "// a class's methods with its data type's and object's; PY5e, part 2b)."] [118 1 "// slotWrapperFor is built-in type m's slot for the special method name, or nil."] [145 2 "// the number protocol's binary methods (__add__, __radd__, __iadd__ ...): the Binary, RBinary and InPlace"] [146 2 "// slots, NotImplemented when they do not apply (PY6h's REQUEST, queue 200: test_asyncio reads int.__add__)"] [180 4 "// object_str: tp_repr, never the type's own __str__ (REQUEST of PY6g for PY6-core: a class with"] [181 4 "// __str__ = object.__str__, doctest's DocTestCase, recursed without end)"] [386 3 "// one object per type, so that object.__new__ is object.__new__ (enum's _find_new_ compares them;"] [387 3 "// PY5e, part 2b)"] [470 1 "// objectDir is object.__dir__: the instance's dictionary's keys and its class's attributes."] [514 1 "// superArgs are super()'s zero arguments: the running function's first argument and its __class__ cell."] [574 2 "// functions as descriptors, bound methods"] [581 2 "// types.MethodType(func, instance) (method_new)"] [641 2 "// slot wrappers"] [669 2 "// classmethod, staticmethod"] [777 2 "// property"] [909 2 "// __slots__' members"] [965 2 "// super"] [1058 2 "// mappingproxy"] [1060 2 "// mappingproxy(mapping), over a dict (PY6a: enum's __members__); other mappings are the data model's"] [1074 2 "// a built-in type's own slots' wrappers (ownSlots, registry.go) are in its __dict__ too (PY5e, part 2b)"] [1082 14 "// a built-in type's attribute descriptors (type.__dict__['__annotations__']: annotationlib)"] [1493 2 "// __module__ is func.go's (PY6d's R5: the function's module), which this init's order let override this one"] [1496 1 "// excSlots are the __slots__ values of exceptions (an exception class's instances are *Exception, not"] [1497 1 "// *Instance): PY6a, by the integration's owner, for test_exceptions' slotted exception classes."] [1500 1 "// setTypeBases is type.__bases__'s setter (typeobject.c's type_set_bases; PY6b's request: typing.NamedTuple"] [1501 1 "// assigns a class's bases): a heap type's bases replaced by types of the same instance layout, its MRO and its"] [1502 1 "// subclasses' computed again and their slots refilled."] [1564 14 "// the type attribute cache: an MRO set"] [1573 1 "// newStaticBase is tp_new_wrapper's staticbase (REQUEST of PY6g for PY6-core: test_descr's test_bad_new): t, or"] [1574 1 "// the first base along __base__ whose __new__ is not a Python class's own (slot_tp_new)."] [1582 1 "// newOrigin is the built-in type whose __new__ t's tp_new is (inherited along __base__ from the first one"] [1583 1 "// that defines it), CPython's tp_new pointer compared."] [1597 1 "// newAliases: the built-in types whose own __new__ here is CPython's inherited one (defaultdict's is dict_new)"] [1600 1 "// isNewWrapper: 
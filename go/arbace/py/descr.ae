(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// Descriptors (PY5c; CPython's Objects/descrobject.c, funcobject.c's classmethod and staticmethod,"] [6 1 "// classobject.c's method, typeobject.c's super and slot wrappers): bound methods, functions as"] [7 1 "// descriptors, classmethod, staticmethod, property, __slots__' members, super, the slot wrappers"] [8 1 "// that show a built-in type's slots as methods, and the attributes of types, functions and methods."] [21 1 "// Method is a bound method: a function and the object it is bound to."] [28 1 "// ClassMethod and StaticMethod wrap a callable."] [43 1 "// Property is property(fget, fset, fdel, doc)."] [47 27 "// a subclass of property"] [57 1 "// Member is a __slots__ entry's descriptor."] [66 1 "// Super is super(type, obj)."] [75 1 "// slotWrapper is a built-in type's slot as a method (wrapper_descriptor)."] [84 1 "// mappingProxy is a type's __dict__ read only."] [87 10 "// the type whose __dict__ it is, or nil"] [106 1 "// newWrappers are the built-in types' __new__ objects, one each."] [114 1 "// slotWrappers keep one wrapper per type and name, so that int.__repr__ is int.__repr__ (enum compares"] [115 1 "// a class's methods with its data type's and object's; PY5e, part 2b)."] [118 1 "// slotWrapperFor is built-in type m's slot for the special method name, or nil."] [354 3 "// one object per type, so that object.__new__ is object.__new__ (enum's _find_new_ compares them;"] [355 3 "// PY5e, part 2b)"] [438 1 "// objectDir is object.__dir__: the instance's dictionary's keys and its class's attributes."] [482 1 "// superArgs are super()'s zero arguments: the running function's first argument and its __class__ cell."] [542 2 "// functions as descriptors, bound methods"] [549 2 "// types.MethodType(func, instance) (method_new)"] [609 2 "// slot wrappers"] [637 2 "// classmethod, staticmethod"] [745 2 "// property"] [877 2 "// __slots__' members"] [933 2 "// super"] [1026 2 "// mappingproxy"] [1028 2 "// mappingproxy(mapping), over a dict (PY6a: enum's __members__); other mappings are the data model's"] [1042 2 "// a built-in type's own slots' wrappers (ownSlots, registry.go) are in its __dict__ too (PY5e, part 2b)"] [1050 14 "// a built-in type's attribute descriptors (type.__dict__['__annotations__']: annotationlib)"] [1469 1 "// excSlots are the __slots__ values of exceptions (an exception class's instances are *Exception, not"] [1470 1 "// *Instance): PY6a, by the integration's owner, for test_exceptions' slotted exception classes."] [1473 1 "// newStaticBase is tp_new_wrapper's staticbase (REQUEST of PY6g for PY6-core: test_descr's test_bad_new): t, or"] [1474 1 "// the first base along __base__ whose __new__ is not a Python class's own (slot_tp_new)."] [1482 1 "// newOrigin is the built-in type whose __new__ t's tp_new is (inherited along __base__ from the first one"] [1483 1 "// that defines it), CPython's tp_new pointer compared."] [1497 1 "// newAliases: the built-in types whose own __new__ here is CPython's inherited one (defaultdict's is dict_new)"] [1500 1 "// isNewWrapper: v is a built-in type's __new__ (tp_new_wrapper); a class whose __new__ is one keeps the"] [1501 1 "// __new__ it inherits (update_one_slot's special case), so that class C(list): __new__ = object.__new__"] [1502 1 "// makes lists"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[121 29] [139 37] [150 68] [161 63] [166 68] [171 67] [187 37] [204 37] [226 37] [262 37] [273 38] [278 37] [288 37] [333 38] [338 37] [356 26] [370 29] [397 25] [399 38] [417 37] [441 25] [443 24] [458 24] [514 26] [524 23] [567 34] [570 36] [578 54] [601 55] [640 49] [657 50] [711 21] [712 36] [723 43] [776 38] [784 28] [786 56] [826 42] [852 50] [862 53] [867 48] [868 26] [883 31] [884 32] [893 30] [900 31] [936 43] [975 51] [980 29] [986 36] [1014 21] [1020 21] [1033 38] [1048 23] [1049 36] [1061 25] [1078 76] [1090 80] [1095 80] [1100 93] [1121 71] [1160 39] [1171 23] [1183 34] [1204 25] [1220 43] [1230 47] [1237 6
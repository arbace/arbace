(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// Descriptors (PY5c; CPython's Objects/descrobject.c, funcobject.c's classmethod and staticmethod,"] [6 1 "// classobject.c's method, typeobject.c's super and slot wrappers): bound methods, functions as"] [7 1 "// descriptors, classmethod, staticmethod, property, __slots__' members, super, the slot wrappers"] [8 1 "// that show a built-in type's slots as methods, and the attributes of types, functions and methods."] [21 1 "// Method is a bound method: a function and the object it is bound to."] [28 1 "// ClassMethod and StaticMethod wrap a callable."] [43 1 "// Property is property(fget, fset, fdel, doc)."] [47 27 "// a subclass of property"] [57 1 "// Member is a __slots__ entry's descriptor."] [66 1 "// Super is super(type, obj)."] [75 1 "// slotWrapper is a built-in type's slot as a method (wrapper_descriptor)."] [84 1 "// mappingProxy is a type's __dict__ read only."] [87 10 "// the type whose __dict__ it is, or nil"] [106 1 "// newWrappers are the built-in types' __new__ objects, one each."] [114 1 "// slotWrappers keep one wrapper per type and name, so that int.__repr__ is int.__repr__ (enum compares"] [115 1 "// a class's methods with its data type's and object's; PY5e, part 2b)."] [118 1 "// slotWrapperFor is built-in type m's slot for the special method name, or nil."] [299 3 "// the number protocol's wrappers (PY6e's REQUEST: multiprocessing.reduction registers type(int.__add__)):"] [300 3 "// __add__ is Binary(self, other), __radd__ RBinary's or Binary(other, self), __iadd__ InPlace's"] [400 3 "// one object per type, so that object.__new__ is object.__new__ (enum's _find_new_ compares them;"] [401 3 "// PY5e, part 2b)"] [481 1 "// objectDir is object.__dir__: the instance's dictionary's keys and its class's attributes."] [525 1 "// superArgs are super()'s zero arguments: the running function's first argument and its __class__ cell."] [585 2 "// functions as descriptors, bound methods"] [592 2 "// types.MethodType(func, instance) (method_new)"] [652 2 "// slot wrappers"] [680 2 "// classmethod, staticmethod"] [788 2 "// property"] [920 2 "// __slots__' members"] [976 2 "// super"] [1069 2 "// mappingproxy"] [1071 2 "// mappingproxy(mapping), over a dict (PY6a: enum's __members__); other mappings are the data model's"] [1085 2 "// a built-in type's own slots' wrappers (ownSlots, registry.go) are in its __dict__ too (PY5e, part 2b)"] [1093 14 "// a built-in type's attribute descriptors (type.__dict__['__annotations__']: annotationlib)"] [1246 3 "// type_set_bases: a heap type's bases replaced, its MRO and slots computed again"] [1553 1 "// excSlots are the __slots__ values of exceptions (an exception class's instances are *Exception, not"] [1554 1 "// *Instance): PY6a, by the integration's owner, for test_exceptions' slotted exception classes."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[121 29] [139 37] [150 68] [161 63] [166 68] [171 67] [187 37] [204 37] [226 37] [262 37] [273 38] [278 37] [288 37] [334 38] [379 38] [384 37] [402 26] [440 25] [442 38] [460 37] [484 25] [486 24] [501 24] [557 26] [567 23] [610 34] [613 36] [621 54] [644 55] [683 49] [700 50] [754 21] [755 36] [766 43] [819 38] [827 28] [829 56] [869 42] [895 50] [905 53] [910 48] [911 26] [926 31] [927 32] [936 30] [943 31] [979 43] [1018 51] [1023 29] [1029 36] [1057 21] [1063 21] [1076 38] [1091 23] [1092 36] [1104 25] [1121 76] [1133 80] [1138 80] [1143 93] [1164 71] [1203 39] [1214 23] [1226 34] [1288 25] [1304 43] [1314 47] [1321 61] [1332 25] [1410 22] [1414 46] [1416 25] [1420 49] [1422 27] [1439 29] [1479 29] [1492 27] [1531 30] [1539 28]]} (go/file "descr.go" :imports [


(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// Descriptors (PY5c; CPython's Objects/descrobject.c, funcobject.c's classmethod and staticmethod,"] [6 1 "// classobject.c's method, typeobject.c's super and slot wrappers): bound methods, functions as"] [7 1 "// descriptors, classmethod, staticmethod, property, __slots__' members, super, the slot wrappers"] [8 1 "// that show a built-in type's slots as methods, and the attributes of types, functions and methods."] [21 1 "// Method is a bound method: a function and the object it is bound to."] [28 1 "// ClassMethod and StaticMethod wrap a callable."] [43 1 "// Property is property(fget, fset, fdel, doc)."] [47 27 "// a subclass of property"] [57 1 "// Member is a __slots__ entry's descriptor."] [66 1 "// Super is super(type, obj)."] [75 1 "// slotWrapper is a built-in type's slot as a method (wrapper_descriptor)."] [84 1 "// mappingProxy is a type's __dict__ read only."] [87 10 "// the type whose __dict__ it is, or nil"] [106 1 "// newWrappers are the built-in types' __new__ objects, one each."] [114 1 "// slotWrappers keep one wrapper per type and name, so that int.__repr__ is int.__repr__ (enum compares"] [115 1 "// a class's methods with its data type's and object's; PY5e, part 2b)."] [118 1 "// slotWrapperFor is built-in type m's slot for the special method name, or nil."] [150 4 "// object_str: tp_repr, never the type's own __str__ (REQUEST of PY6g for PY6-core: a class with"] [151 4 "// __str__ = object.__str__, doctest's DocTestCase, recursed without end)"] [301 3 "// the number protocol's wrappers (PY6e's REQUEST: multiprocessing.reduction registers type(int.__add__)):"] [302 3 "// __add__ is Binary(self, other), __radd__ RBinary's or Binary(other, self), __iadd__ InPlace's"] [402 3 "// one object per type, so that object.__new__ is object.__new__ (enum's _find_new_ compares them;"] [403 3 "// PY5e, part 2b)"] [486 1 "// objectDir is object.__dir__: the instance's dictionary's keys and its class's attributes."] [530 1 "// superArgs are super()'s zero arguments: the running function's first argument and its __class__ cell."] [590 2 "// functions as descriptors, bound methods"] [597 2 "// types.MethodType(func, instance) (method_new)"] [657 2 "// slot wrappers"] [685 2 "// classmethod, staticmethod"] [793 2 "// property"] [925 2 "// __slots__' members"] [981 2 "// super"] [1074 2 "// mappingproxy"] [1076 2 "// mappingproxy(mapping), over a dict (PY6a: enum's __members__); other mappings are the data model's"] [1090 2 "// a built-in type's own slots' wrappers (ownSlots, registry.go) are in its __dict__ too (PY5e, part 2b)"] [1098 14 "// a built-in type's attribute descriptors (type.__dict__['__annotations__']: annotationlib)"] [1509 2 "// __module__ is func.go's (PY6d's R5: the function's module), which this init's order let override this one"] [1512 1 "// excSlots are the __slots__ values of exceptions (an exception class's instances are *Exception, not"] [1513 1 "// *Instance): PY6a, by the integration's owner, for test_exceptions' slotted exception classes."] [1516 1 "// setTypeBases is type.__bases__'s setter (typeobject.c's type_set_bases; PY6b's request: typing.NamedTuple"] [1517 1 "// assigns a class's bases): a heap type's bases replaced by types of the same instance layout, its MRO and its"] [1518 1 "// subclasses' computed again and their slots refilled."] [1580 14 "// the type attribute cache: an MRO set"] [1589 1 "// newStaticBase is tp_new_wrapper's staticbase (REQUEST of PY6g for PY6-core: test_descr's test_bad_new): t, or"] [1590 1 "// the first base along __base__ whose __new__ is not a Python class's own (slot_tp_new)."] [1598 1 "// newOrigin is the built-in type whose __new__ t's tp_new is (inherited along __base__ from the first one"] [1599 1 "// that defines it), CPython's tp_new pointer compared."] [1613 1 "// newAliases: the built-in types whose own __new__ here is CPython's inherited one (defaultdict's is dict_new)"] [1616 1 "// isNewWrapper: v is a built-in type's __new__ (tp_new_wrapper); a class whose __new__ is one keeps the"] [1617 1 "// __new__ it inherits (update_one_slot's special case), so that class C(list): __new__ = object.__new__"] [1618 1 "// makes lists"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[121 29] [139 37] [152 67] [163 63] [168 68] [173 67] [189 37] [206 37] [228 37] [264 37] [275 38] [280 37] [290 37] [336 38] [381 38] [386 37] [404 26] [418 29] [445 25] [447 38] [465 37] [489 25] [491 24] [506 24] [562 26] [572 23] [615 34] [618 36] [626 54] [649 55] [688 49] [705 50] [759 21] [760 36] [771 43] [824 38] [832 28] [834 56] [874 42] [900 50] [910 53] [915 48] [916 26] [931 31] [932 32] [941 30] [948 31] [984 43] [1023 51] [1028 29] [1034 36] [1062 21] [1068 21] [1081 38] [1096 23] [1097 36] [1109 25] [1126 76] [1138 80] [1143 80] [1148 93] [1169 71] [1208 39] [1219 23] [1231 34] [1252 25] [1268 43] [1278 47] [1285 61] [1296 25] [1374 22] [1378 46] [1380 25] [1384 49] [1386 27] [1403 29] [1443 29] [1456 27] [1495 30] [1503 28] [1554 27] [1582 28] [1601 23] [1624 34]]} (go/file "descr.go" :imports [


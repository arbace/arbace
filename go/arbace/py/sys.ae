(in-ns 'go.arbace.py) ^{:go/comments [[10 1 "// The sys module (Python/sysmodule.c; PY5e): made once per interpreter on its first import (sysModule),"] [11 1 "// from the host's configuration (Configure: argv, the search path). sys.modules is the interpreter's"] [12 1 "// Modules, sys.stdout and sys.stderr write to its streams, sys.stdin reads the process's standard input."] [13 1 "// sys.implementation.name is \"arbace\" (PYS15 (a)): Lib/test's @cpython_only tests skip, as on PyPy."] [15 1 "// The host's configuration, set before a run (Configure)."] [21 1 "// Configure sets the next interpreters' sys.argv and sys.path (the script's directory first, then the"] [22 1 "// standard library's Lib), each list's items separated by NUL; bin/pyi's host calls it before RunModule"] [23 1 "// or Repl."] [45 1 "// sysVersion is sys.version: the language's version, then pyi's build in CPython's layout."] [48 1 "// pyVersion315 is the version under REPR_PYTHON_VERSION=3.15 (queue 252): the pin 3.15.2, its Lib on sys.path."] [56 1 "// textFile is a text stream of the process (sys.stdin, sys.stdout, sys.stderr): _io.TextIOWrapper's"] [57 1 "// interface over the interpreter's buffered streams. The rest of io is _pyio's (PY6)."] [63 2 "// enc, errs: reconfigure()'s encoding and errors, \"\" the process's (stdioConfig); lineBuf its line_buffering"] [64 2 "// (queue 286: inspect's command line reconfigures sys.stdout's errors)"] [69 1 "// encoding is the stream's encoding: reconfigure()'s, else the process's."] [77 1 "// errors is the stream's errors handler: reconfigure()'s, else the process's."] [91 1 "// processStdin is the process's standard input, buffered once for every interpreter."] [110 1 "// unsupportedOperation is io.UnsupportedOperation's stand-in until _pyio (PY6): a ValueError (its base, with OSError)."] [113 1 "// ioMethod is a built-in method of t (PY5c's AddMethod: the dictionary filled once str's hash is ready)."] [129 2 "// the standard streams' attributes (PY6b's request: doctest reads sys.stdout.encoding)"] [133 2 "// reconfigure (textio.c's _io_TextIOWrapper_reconfigure_impl; queue 286): encoding and errors (errors \"strict\" when"] [134 2 "// only the encoding is given), line_buffering (a line written flushes), write_through and newline checked; the"] [135 2 "// encoding looked up as the codec registry has it"] [243 4 "// a write error raises (queue 253: flush_std_files reports a failed flush at shutdown, status 120)"] [272 2 "// close (queue 249: multiprocessing's _close_stdin closes sys.stdin in a spawned child): the standard streams are"] [273 2 "// made with closefd=False (create_stdio), so the stream is flushed and marked closed, its descriptor left open"] [296 1 "// The standard streams' buffer (PY6e's REQUEST: subprocess's children write sys.stdout.buffer): a binary"] [297 1 "// view of the same bufio reader or writer, so text and bytes keep their order."] [394 1 "// exactArgsSelf checks a method's call: self and n arguments, no keywords."] [415 1 "// sysModule is the interpreter's sys module, made on first use."] [462 15 "// 3.15 (queue 252, PY315-SURVEY P7): the version the standard library (3.15.2's Lib) moves with"] [469 25 "// types.SimpleNamespace (PY6b: FrozenImporter makes them)"] [471 45 "// pyi's own .pyc files (PY6b): __pycache__/NAME.arbace-314.pyc, its own magic number"] [477 2 "// sys.flags as python3 -s -P -B runs (the references'): the struct sequence of sysmodule.c's flags_desc"] [490 2 "// -q, -E and -I (queue 296): config's quiet, use_environment and isolated (-I also -E's)"] [500 2 "// -i (queue 289): inspect and interactive; PYTHONINSPECT at start: inspect"] [509 3 "// 3.15's lazy imports (queue 239): sys.flags.lazy_imports, sys.lazy_modules and the mode's and filter's API"] [516 18 "// -X options (queue 220: bin/pyi python passes them in PYI_XOPTIONS)"] [525 2 "// the struct sequences of numbers and threads, with CPython 3.14's values (64-bit Linux)"] [538 2 "// sys.monitoring (PEP 669): its call-family events (queue 220, monitoring.go)"] [542 43 "// PY6c"] [545 2 "// pyi's own launcher when bin/pyi runs it (PY6e: tools/pyi/python3, CPython's command line), so that"] [546 2 "// script_helper and subprocess start pyi as CPython starts itself"] [567 3 "// PyErr_SetObject(PyExc_SystemExit, status): a tuple's items are the exception's arguments, None none"] [623 5 "// PyErr_GetExcInfo: the type, the exception, its __traceback__ (queue 223)"] [652 26 "// -X cpu_count unset (os.process_cpu_count from sched_getaffinity)"] [696 2 "// the hooks and introspection the stdlib reads at import (PY6a: threading, test.support)"] [702 4 "// _PyErr_Display: the traceback given put on an exception that has none (issue #18776)"] [710 4 "// traceback's display raises for a non-exception; the C fallback's print_exception line (queue 223)"] [719 2 "// is_remote_debug_enabled (queue 223): False, as a CPython built without Py_REMOTE_DEBUG answers (pyi has no"] [720 2 "// remote debugging, :remote-debugging); test_sys imports it at its top"] [778 3 "// dataclasses' slots=True (gh-135228): __dict__ and __weakref__ taken out of a heap type's dict"] [796 2 "// get_asyncgen_hooks and set_asyncgen_hooks (sysmodule.c; asyncio's event loops set theirs around run_forever):"] [797 2 "// the running thread's hooks, a sys.asyncgen_hooks; an argument left out keeps its hook, None clears it"] [831 2 "// _PySys_SetIntMaxStrDigits: 0 (no limit) or at least 640, sys.flags.int_max_str_digits with it (queue 202: a no-op,"] [832 2 "// so test_decimal's PyCoverage, which sets 7000, met the 4300 digits' limit)"] [855 2 "// sys.getprofile and sys.setprofile: the legacy profiler over sys.monitoring (queue 220, monitoring.go)"] [862 2 "// sys.gettrace and sys.settrace: the legacy tracer over sys.monitoring (queue 219t, trace.go)"] [889 2 "// threading.settrace_all_threads and setprofile_all_threads: every thread's trace or profile function"] [932 24 "// its functions' __module__ \"sys\" (PY6f's REQUEST 8, as importBuiltin tags the others)"] [936 1 "// displayHook is sys.displayhook: None prints nothing; another value's repr is written to sys.stdout and"] [937 1 "// bound to builtins._ (the REPL's expression statements)."] [958 1 "// sysAttr is sys.NAME when the sys module exists and has it, else nil."] [966 1 "// sysModuleIfAny is the interpreter's sys module once made (interp->sysdict: sys.modules' entry is not needed, queue"] [967 1 "// 253), else the one in sys.modules, else nil."] [978 1 "// writeTo writes s to a file object: the interpreter's stdout when f is nil or None, a textFile directly,"] [979 1 "// else f.write(s)."] [999 1 "// exactArgsN checks a function's call: n positional arguments, no keywords (CPython's messages)."] [1013 1 "// cpythonSizeof is sys.getsizeof as CPython 3.14 answers it on a 64-bit build for the core immutable types"] [1014 1 "// and the list and tuple (the list's allocation taken as its length), 0 for any other object (PY6b's"] [1015 1 "// request: test_marshal sizes its big-memory tests by sys.getsizeof of an int at import)."] [1031 36 "// sizeof(PyByteArrayObject) + ob_alloc"] [1056 1 "// versionInfoType is sys.version_info's struct sequence (PY6b's request: test_importlib reads its releaselevel):"] [1057 1 "// a tuple with the fields' names."] [1094 1 "// asyncgenHooks are each thread's async generator hooks (firstiter, finalizer; nil unset, None too), as the thread"] [1095 1 "// state's async_gen_firstiter and async_gen_finalizer: firstiter called on an async generator's first __anext__, asend,"] [1096 1 "// athrow or aclose (coro.go's asyncGenInitHooks; asyncio's tracking of unfinished async generators for"] [1097 1 "// shutdown_asyncgens); the finalizer kept, never called (pyi has no finalization, PY7)."] [1102 1 "// stdlibAdded315 and stdlibRemoved315 are 3.15.2's Python/stdlib_module_names.h against 3.14.10's (queue 252): its"] [1103 1 "// 296 names."] [1108 1 "// stdlibModuleNames is sys.stdlib_module_names (Python/stdlib_module_names.h of CPython 3.14.10, its 297 names; queue 223:"] [1109 1 "// traceback's \"Did you forget to import\" reads it)"] [1145 1 "// utf8Mode315 is 3.15's UTF-8 mode (PEP 686, Python/initconfig.c's config_init_utf8_mode; queue 237): on by default,"] [1146 1 "// -X utf8=0 (or PYTHONUTF8=0, which -E and -I ignore) turns it off, -X utf8 and -X utf8=1 on. 3.14's answer stays"] [1147 1 "// pyi's 1 (the locale's coercion pyi does not model)."] [1161 1 "// utf8ModeCheck315 is preconfig_init_utf8_mode's refusals (3.15; queue 237): -X utf8=V and PYTHONUTF8 other than 0 or 1"] [1162 1 "// are a fatal error at start, status 1"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[175 13] [175 21] [191 57] [222 53] [233 26] [242 30] [244 25] [275 53] [321 54] [339 34] [387 30] [420 48] [569 34] [579 54] [585 62] [591 62] [605 26] [612 54] [615 26] [621 26] [622 43] [634 63] [640 66] [646 70] [655 51] [665 56] [671 43] [674 46] [686 7] [686 30] [701 31] [703 37] [747 58] [756 56] [759 34] [772 62] [779 68] [790 41] [799 63] [838 28] [857 32] [864 30] [870 44] [880 42] [951 45] [960 29] [972 48] [988 28] [1149 37] [1165 37] [1169 39]] :go/trails [[1142 82]]} (go/file "sys.go" :imports [



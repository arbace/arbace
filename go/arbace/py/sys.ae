(in-ns 'go.arbace.py) ^{:go/comments [[12 1 "// The sys module (Python/sysmodule.c; PY5e): made once per interpreter on its first import (sysModule),"] [13 1 "// from the host's configuration (Configure: argv, the search path). sys.modules is the interpreter's"] [14 1 "// Modules, sys.stdout and sys.stderr write to its streams, sys.stdin reads the process's standard input."] [15 1 "// sys.implementation.name is \"arbace\" (PYS15 (a)): Lib/test's @cpython_only tests skip, as on PyPy."] [17 1 "// The host's configuration, set before a run (Configure)."] [23 1 "// Configure sets the next interpreters' sys.argv and sys.path (the script's directory first, then the"] [24 1 "// standard library's Lib), each list's items separated by NUL; bin/pyi's host calls it before RunModule"] [25 1 "// or Repl."] [47 1 "// sysVersion is sys.version: the language's version, then pyi's build in CPython's layout."] [50 1 "// pyVersion315 is the version under REPR_PYTHON_VERSION=3.15 (queue 252): the pin 3.15.2, its Lib on sys.path."] [58 1 "// textFile is a text stream of the process (sys.stdin, sys.stdout, sys.stderr): _io.TextIOWrapper's"] [59 1 "// interface over the interpreter's buffered streams. The rest of io is _pyio's (PY6)."] [63 19 "// what w buffers (writeErr)"] [66 2 "// enc, errs: reconfigure()'s encoding and errors, \"\" the process's (stdioConfig); lineBuf its line_buffering"] [67 2 "// (queue 286: inspect's command line reconfigures sys.stdout's errors)"] [72 1 "// writeErr is a failed write's or flush's OSError (py-eval-1122: with SIGPIPE ignored a closed pipe is EPIPE, a"] [73 1 "// BrokenPipeError, as CPython's BufferedWriter raises it). bufio keeps a write error for every later write and flush, so"] [74 1 "// the buffered bytes are dropped and the writer starts again on what it buffers: json.tool's handler dup2s /dev/null over"] [75 1 "// stdout and exits with EPIPE's status, which the shutdown's flush (status 120 when it fails) leaves."] [86 1 "// encoding is the stream's encoding: reconfigure()'s, else the process's."] [94 1 "// errors is the stream's errors handler: reconfigure()'s, else the process's."] [108 1 "// processStdin is the process's standard input, buffered once for every interpreter."] [127 1 "// unsupportedOperation is io.UnsupportedOperation's stand-in until _pyio (PY6): a ValueError (its base, with OSError)."] [130 1 "// ioMethod is a built-in method of t (PY5c's AddMethod: the dictionary filled once str's hash is ready)."] [146 2 "// the standard streams' attributes (PY6b's request: doctest reads sys.stdout.encoding)"] [150 2 "// reconfigure (textio.c's _io_TextIOWrapper_reconfigure_impl; queue 286): encoding and errors (errors \"strict\" when"] [151 2 "// only the encoding is given), line_buffering (a line written flushes), write_through and newline checked; the"] [152 2 "// encoding looked up as the codec registry has it"] [262 4 "// a write error raises (queue 253: flush_std_files reports a failed flush at shutdown, status 120)"] [290 2 "// readlines, __iter__ and __next__ as IOBase's over readline (py-eval-1122: python -m json --json-lines read"] [291 2 "// sys.stdin.readlines(), \"'TextIOWrapper' object has no attribute 'readlines'\"): the hint stops the list once the"] [292 2 "// lines read hold that many characters (iobase_readlines_impl)"] [341 2 "// close (queue 249: multiprocessing's _close_stdin closes sys.stdin in a spawned child): the standard streams are"] [342 2 "// made with closefd=False (create_stdio), so the stream is flushed and marked closed, its descriptor left open"] [350 4 "// a failed flush raises after the close (TextIOWrapper.close: flush, then the buffer's close in a finally)"] [368 1 "// The standard streams' buffer (PY6e's REQUEST: subprocess's children write sys.stdout.buffer): a binary"] [369 1 "// view of the same bufio reader or writer, so text and bytes keep their order."] [471 1 "// exactArgsSelf checks a method's call: self and n arguments, no keywords."] [492 1 "// sysModule is the interpreter's sys module, made on first use."] [539 15 "// 3.15 (queue 252, PY315-SURVEY P7): the version the standard library (3.15.2's Lib) moves with"] [546 25 "// types.SimpleNamespace (PY6b: FrozenImporter makes them)"] [548 45 "// pyi's own .pyc files (PY6b): __pycache__/NAME.arbace-314.pyc, its own magic number"] [554 2 "// sys.flags as python3 -s -P -B runs (the references'): the struct sequence of sysmodule.c's flags_desc"] [567 2 "// -q, -E and -I (queue 296): config's quiet, use_environment and isolated (-I also -E's)"] [577 2 "// -i (queue 289): inspect and interactive; PYTHONINSPECT at start: inspect"] [586 3 "// 3.15's lazy imports (queue 239): sys.flags.lazy_imports, sys.lazy_modules and the mode's and filter's API"] [599 18 "// -X options (queue 220: bin/pyi python passes them in PYI_XOPTIONS)"] [608 2 "// the struct sequences of numbers and threads, with CPython 3.14's values (64-bit Linux)"] [621 2 "// sys.monitoring (PEP 669): its call-family events (queue 220, monitoring.go)"] [625 43 "// PY6c"] [628 2 "// pyi's own launcher when bin/pyi runs it (PY6e: tools/pyi/python3, CPython's command line), so that"] [629 2 "// script_helper and subprocess start pyi as CPython starts itself"] [650 3 "// PyErr_SetObject(PyExc_SystemExit, status): a tuple's items are the exception's arguments, None none"] [706 5 "// PyErr_GetExcInfo: the type, the exception, its __traceback__ (queue 223)"] [735 26 "// -X cpu_count unset (os.process_cpu_count from sched_getaffinity)"] [779 2 "// breakpointhook (queue 304): sys_breakpointhook, $PYTHONBREAKPOINT's callable (pdb.set_trace when unset or empty, a"] [780 2 "// no-op for \"0\", a name without a dot builtins'), an unimportable one warned of and ignored; -E and -I ignore the"] [781 2 "// environment (Py_GETENV)"] [805 3 "// PyImport_Import: the leaf module (a non-empty fromlist)"] [823 2 "// the hooks and introspection the stdlib reads at import (PY6a: threading, test.support)"] [829 4 "// _PyErr_Display: the traceback given put on an exception that has none (issue #18776)"] [837 4 "// traceback's display raises for a non-exception; the C fallback's print_exception line (queue 223)"] [846 2 "// is_remote_debug_enabled (queue 223): False, as a CPython built without Py_REMOTE_DEBUG answers (pyi has no"] [847 2 "// remote debugging, :remote-debugging); test_sys imports it at its top"] [905 3 "// dataclasses' slots=True (gh-135228): __dict__ and __weakref__ taken out of a heap type's dict"] [923 2 "// get_asyncgen_hooks and set_asyncgen_hooks (sysmodule.c; asyncio's event loops set theirs around run_forever):"] [924 2 "// the running thread's hooks, a sys.asyncgen_hooks; an argument left out keeps its hook, None clears it"] [958 2 "// _PySys_SetIntMaxStrDigits: 0 (no limit) or at least 640, sys.flags.int_max_str_digits with it (queue 202: a no-op,"] [959 2 "// so test_decimal's PyCoverage, which sets 7000, met the 4300 digits' limit)"] [982 2 "// sys.getprofile and sys.setprofile: the legacy profiler over sys.monitoring (queue 220, monitoring.go)"] [989 2 "// sys.gettrace and sys.settrace: the legacy tracer over sys.monitoring (queue 219t, trace.go)"] [1016 2 "// threading.settrace_all_threads and setprofile_all_threads: every thread's trace or profile function"] [1059 24 "// its functions' __module__ \"sys\" (PY6f's REQUEST 8, as importBuiltin tags the others)"] [1063 1 "// displayHook is sys.displayhook: None prints nothing; another value's repr is written to sys.stdout and"] [1064 1 "// bound to builtins._ (the REPL's expression statements)."] [1085 1 "// sysAttr is sys.NAME when the sys module exists and has it, else nil."] [1093 1 "// sysModuleIfAny is the interpreter's sys module once made (interp->sysdict: sys.modules' entry is not needed, queue"] [1094 1 "// 253), else the one in sys.modules, else nil."] [1105 1 "// writeTo writes s to a file object: the interpreter's stdout when f is nil or None, a textFile directly,"] [1106 1 "// else f.write(s)."] [1126 1 "// exactArgsN checks a function's call: n positional arguments, no keywords (CPython's messages)."] [1140 1 "// cpythonSizeof is sys.getsizeof as CPython 3.14 answers it on a 64-bit build for the core immutable types"] [1141 1 "// and the list and tuple (the list's allocation taken as its length), 0 for any other object (PY6b's"] [1142 1 "// request: test_marshal sizes its big-memory tests by sys.getsizeof of an int at import)."] [1158 36 "// sizeof(PyByteArrayObject) + ob_alloc"] [1183 1 "// versionInfoType is sys.version_info's struct sequence (PY6b's request: test_importlib reads its releaselevel):"] [1184 1 "// a tuple with the fields' names."] [1221 1 "// asyncgenHooks are each thread's async generator hooks (firstiter, finalizer; nil unset, None too), as the thread"] [1222 1 "// state's async_gen_firstiter and async_gen_finalizer: firstiter called on an async generator's first __anext__, asend,"] [1223 1 "// athrow or aclose (coro.go's asyncGenInitHooks; asyncio's tracking of unfinished async generators for"] [1224 1 "// shutdown_asyncgens); the finalizer kept, never called (pyi has no finalization, PY7)."] [1229 1 "// stdlibAdded315 and stdlibRemoved315 are 3.15.2's Python/stdlib_module_names.h against 3.14.10's (queue 252): its"] [1230 1 "// 296 names."] [1235 1 "// stdlibModuleNames is sys.stdlib_module_names (Python/stdlib_module_names.h of CPython 3.14.10, its 297 names; queue 223:"] [1236 1 "// traceback's \"Did you forget to import\" reads it)"] [1272 1 "// utf8Mode315 is 3.15's UTF-8 mode (PEP 686, Python/initconfig.c's config_init_utf8_mode; queue 237): on by default,"] [1273 1 "// -X utf8=0 (or PYTHONUTF8=0, which -E and -I ignore) turns it off, -X utf8 and -X utf8=1 on. 3.14's answer stays"] [1274 1 "// pyi's 1 (the locale's coercion pyi does not model)."] [1288 1 "// utf8ModeCheck315 is preconfig_init_utf8_mode's refusals (3.15; queue 237): -X utf8=V and PYTHONUTF8 other than 0 or 1"] [1289 1 "// are a fatal error at start, status 1"] [1312 1 "// startWarnOptions is sys.warnoptions as config_init_warnoptions orders it (queue 328), the lowest precedence first:"] [1313 1 "// \"default\" in development mode, PYTHONWARNINGS's comma-separated options (not under -E or -I), the command line's -W"] [1314 1 "// options (bin/pyi python's PYI_WARNOPTIONS, one a line, read once and removed from the environment as PYI_XOPTIONS"] [1315 1 "// is), then -b's \"default::BytesWarning\" or -bb's \"error::BytesWarning\"."] [1346 1 "// startBytesWarning is -b's count (bin/pyi python's PYI_BYTES_WARNING, read once and removed from the environment):"] [1347 1 "// sys.flags.bytes_warning."] [1369 1 "// init_interp_main: the warnings module imported at start when sys.warnoptions holds an option, so its"] [1370 1 "// _processoptions applies them (and reports an invalid one) before the main module runs (queue 328: test_warnings'"] [1371 1 "// test_warnings_bootstrap and test_improper_option)"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[192 13] [192 21] [208 57] [239 53] [250 26] [254 37] [261 30] [263 37] [344 53] [351 37] [393 54] [408 29] [414 34] [415 38] [464 30] [497 48] [652 34] [662 54] [668 62] [674 62] [688 26] [695 54] [698 26] [704 26] [705 43] [717 63] [723 66] [729 70] [738 51] [748 56] [754 43] [757 46] [769 7] [769 30] [796 40] [828 31] [830 37] [874 58] [883 56] [886 34] [899 62] [906 68] [917 41] [926 63] [965 28] [984 32] [991 30] [997 44] [1007 42] [1078 45] [1087 29] [1099 48] [1115 28] [1276 37] [1292 37] [1296 39] [1327 46] [1335 34] [1350 48]] :go/trails [[1269 82]]} (go/file "sys.go" :imports [



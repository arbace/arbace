(in-ns 'go.arbace.py) ^{:go/comments [[10 1 "// The sys module (Python/sysmodule.c; PY5e): made once per interpreter on its first import (sysModule),"] [11 1 "// from the host's configuration (Configure: argv, the search path). sys.modules is the interpreter's"] [12 1 "// Modules, sys.stdout and sys.stderr write to its streams, sys.stdin reads the process's standard input."] [13 1 "// sys.implementation.name is \"arbace\" (PYS15 (a)): Lib/test's @cpython_only tests skip, as on PyPy."] [15 1 "// The host's configuration, set before a run (Configure)."] [21 1 "// Configure sets the next interpreters' sys.argv and sys.path (the script's directory first, then the"] [22 1 "// standard library's Lib), each list's items separated by NUL; bin/pyi's host calls it before RunModule"] [23 1 "// or Repl."] [45 1 "// sysVersion is sys.version: the language's version, then pyi's build in CPython's layout."] [48 1 "// textFile is a text stream of the process (sys.stdin, sys.stdout, sys.stderr): _io.TextIOWrapper's"] [49 1 "// interface over the interpreter's buffered streams. The rest of io is _pyio's (PY6)."] [63 1 "// processStdin is the process's standard input, buffered once for every interpreter."] [82 1 "// unsupportedOperation is io.UnsupportedOperation's stand-in until _pyio (PY6): a ValueError (its base, with OSError)."] [85 1 "// ioMethod is a built-in method of t (PY5c's AddMethod: the dictionary filled once str's hash is ready)."] [101 2 "// the standard streams' attributes (PY6b's request: doctest reads sys.stdout.encoding)"] [164 2 "// close (queue 249: multiprocessing's _close_stdin closes sys.stdin in a spawned child): the standard streams are"] [165 2 "// made with closefd=False (create_stdio), so the stream is flushed and marked closed, its descriptor left open"] [188 1 "// The standard streams' buffer (PY6e's REQUEST: subprocess's children write sys.stdout.buffer): a binary"] [189 1 "// view of the same bufio reader or writer, so text and bytes keep their order."] [286 1 "// exactArgsSelf checks a method's call: self and n arguments, no keywords."] [307 1 "// sysModule is the interpreter's sys module, made on first use."] [353 25 "// types.SimpleNamespace (PY6b: FrozenImporter makes them)"] [355 54 "// pyi's own .pyc files (PY6b): __pycache__/NAME.arbace-314.pyc, its own magic number"] [361 2 "// sys.flags as python3 -s -P -B runs (the references'): the struct sequence of sysmodule.c's flags_desc"] [376 3 "// 3.15's lazy imports (queue 239): sys.flags.lazy_imports, sys.lazy_modules and the mode's and filter's API"] [383 18 "// -X options (queue 220: bin/pyi python passes them in PYI_XOPTIONS)"] [392 2 "// the struct sequences of numbers and threads, with CPython 3.14's values (64-bit Linux)"] [405 2 "// sys.monitoring (PEP 669): its call-family events (queue 220, monitoring.go)"] [409 43 "// PY6c"] [412 2 "// pyi's own launcher when bin/pyi runs it (PY6e: tools/pyi/python3, CPython's command line), so that"] [413 2 "// script_helper and subprocess start pyi as CPython starts itself"] [434 3 "// PyErr_SetObject(PyExc_SystemExit, status): a tuple's items are the exception's arguments, None none"] [484 5 "// PyErr_GetExcInfo: the type, the exception, its __traceback__ (queue 223)"] [513 26 "// -X cpu_count unset (os.process_cpu_count from sched_getaffinity)"] [557 2 "// the hooks and introspection the stdlib reads at import (PY6a: threading, test.support)"] [563 4 "// _PyErr_Display: the traceback given put on an exception that has none (issue #18776)"] [571 4 "// traceback's display raises for a non-exception; the C fallback's print_exception line (queue 223)"] [580 2 "// is_remote_debug_enabled (queue 223): False, as a CPython built without Py_REMOTE_DEBUG answers (pyi has no"] [581 2 "// remote debugging, :remote-debugging); test_sys imports it at its top"] [639 3 "// dataclasses' slots=True (gh-135228): __dict__ and __weakref__ taken out of a heap type's dict"] [657 2 "// get_asyncgen_hooks and set_asyncgen_hooks (sysmodule.c; asyncio's event loops set theirs around run_forever):"] [658 2 "// the running thread's hooks, a sys.asyncgen_hooks; an argument left out keeps its hook, None clears it"] [692 2 "// _PySys_SetIntMaxStrDigits: 0 (no limit) or at least 640, sys.flags.int_max_str_digits with it (queue 202: a no-op,"] [693 2 "// so test_decimal's PyCoverage, which sets 7000, met the 4300 digits' limit)"] [716 2 "// sys.getprofile and sys.setprofile: the legacy profiler over sys.monitoring (queue 220, monitoring.go)"] [723 2 "// sys.gettrace and sys.settrace: the legacy tracer over sys.monitoring (queue 219t, trace.go)"] [750 2 "// threading.settrace_all_threads and setprofile_all_threads: every thread's trace or profile function"] [784 24 "// its functions' __module__ \"sys\" (PY6f's REQUEST 8, as importBuiltin tags the others)"] [788 1 "// displayHook is sys.displayhook: None prints nothing; another value's repr is written to sys.stdout and"] [789 1 "// bound to builtins._ (the REPL's expression statements)."] [810 1 "// sysAttr is sys.NAME when the sys module exists and has it, else nil."] [818 1 "// writeTo writes s to a file object: the interpreter's stdout when f is nil or None, a textFile directly,"] [819 1 "// else f.write(s)."] [839 1 "// exactArgsN checks a function's call: n positional arguments, no keywords (CPython's messages)."] [853 1 "// cpythonSizeof is sys.getsizeof as CPython 3.14 answers it on a 64-bit build for the core immutable types"] [854 1 "// and the list and tuple (the list's allocation taken as its length), 0 for any other object (PY6b's"] [855 1 "// request: test_marshal sizes its big-memory tests by sys.getsizeof of an int at import)."] [894 1 "// versionInfoType is sys.version_info's struct sequence (PY6b's request: test_importlib reads its releaselevel):"] [895 1 "// a tuple with the fields' names."] [932 1 "// asyncgenHooks are each thread's async generator hooks (firstiter, finalizer; nil unset, None too), as the thread"] [933 1 "// state's async_gen_firstiter and async_gen_finalizer: firstiter called on an async generator's first __anext__, asend,"] [934 1 "// athrow or aclose (coro.go's asyncGenInitHooks; asyncio's tracking of unfinished async generators for"] [935 1 "// shutdown_asyncgens); the finalizer kept, never called (pyi has no finalization, PY7)."] [940 1 "// stdlibModuleNames is sys.stdlib_module_names (Python/stdlib_module_names.h of CPython 3.14.10, its 297 names; queue 223:"] [941 1 "// traceback's \"Did you forget to import\" reads it)"] [977 1 "// utf8Mode315 is 3.15's UTF-8 mode (PEP 686, Python/initconfig.c's config_init_utf8_mode; queue 237): on by default,"] [978 1 "// -X utf8=0 (or PYTHONUTF8=0, which -E and -I ignore) turns it off, -X utf8 and -X utf8=1 on. 3.14's answer stays"] [979 1 "// pyi's 1 (the locale's coercion pyi does not model)."] [993 1 "// utf8ModeCheck315 is preconfig_init_utf8_mode's refusals (3.15; queue 237): -X utf8=V and PYTHONUTF8 other than 0 or 1"] [994 1 "// are a fatal error at start, status 1"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[117 53] [128 26] [137 30] [167 53] [213 54] [231 34] [279 30] [309 48] [436 34] [446 62] [452 62] [466 26] [473 54] [476 26] [482 26] [483 43] [495 63] [501 66] [507 70] [516 51] [526 56] [532 43] [535 46] [547 7] [547 30] [562 31] [564 37] [608 58] [617 56] [620 34] [633 62] [640 68] [651 41] [660 63] [699 28] [718 32] [725 30] [731 44] [741 42] [803 45] [812 48] [828 28] [981 37] [997 37] [1001 39]] :go/trails [[974 82]]} (go/file "sys.go" :imports [



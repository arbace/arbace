(in-ns 'go.arbace.py) ^{:go/comments [[12 1 "// The sys module (Python/sysmodule.c; PY5e): made once per interpreter on its first import (sysModule),"] [13 1 "// from the host's configuration (Configure: argv, the search path). sys.modules is the interpreter's"] [14 1 "// Modules, sys.stdout and sys.stderr write to its streams, sys.stdin reads the process's standard input."] [15 1 "// sys.implementation.name is \"arbace\" (PYS15 (a)): Lib/test's @cpython_only tests skip, as on PyPy."] [17 1 "// The host's configuration, set before a run (Configure)."] [23 1 "// Configure sets the next interpreters' sys.argv and sys.path (the script's directory first, then the"] [24 1 "// standard library's Lib), each list's items separated by NUL; bin/pyi's host calls it before RunModule"] [25 1 "// or Repl."] [47 1 "// sysVersion is sys.version: the language's version, then pyi's build in CPython's layout."] [50 1 "// pyVersion315 is the version under REPR_PYTHON_VERSION=3.15 (queue 252): the pin 3.15.2, its Lib on sys.path."] [58 1 "// textFile is a text stream of the process (sys.stdin, sys.stdout, sys.stderr): _io.TextIOWrapper's"] [59 1 "// interface over the interpreter's buffered streams. The rest of io is _pyio's (PY6)."] [63 19 "// what w buffers (writeErr)"] [66 2 "// enc, errs: reconfigure()'s encoding and errors, \"\" the process's (stdioConfig); lineBuf its line_buffering"] [67 2 "// (queue 286: inspect's command line reconfigures sys.stdout's errors)"] [70 2 "// writeThrough: every write flushed, write_through (py-mods-1122: create_stdio's !buffered_stdio, -u or"] [71 2 "// PYTHONUNBUFFERED; libregrtest's --fast-ci adds -u when sys.stdout.write_through is false; reconfigure sets it)"] [75 1 "// stdioUnbuffered is the start's buffered_stdio negated (pylifecycle.c's create_stdio): -u (bin/pyi python's"] [76 1 "// PYI_UNBUFFERED, read once and removed from the environment as PYI_IGNORE_ENV is) or PYTHONUNBUFFERED (not under -E or -I)"] [91 1 "// writeErr is a failed write's or flush's OSError (py-eval-1122: with SIGPIPE ignored a closed pipe is EPIPE, a"] [92 1 "// BrokenPipeError, as CPython's BufferedWriter raises it). bufio keeps a write error for every later write and flush, so"] [93 1 "// the buffered bytes are dropped and the writer starts again on what it buffers: json.tool's handler dup2s /dev/null over"] [94 1 "// stdout and exits with EPIPE's status, which the shutdown's flush (status 120 when it fails) leaves."] [105 1 "// encoding is the stream's encoding: reconfigure()'s, else the process's."] [113 1 "// errors is the stream's errors handler: reconfigure()'s, else the process's."] [127 1 "// processStdin is the process's standard input, buffered once for every interpreter."] [146 1 "// unsupportedOperation is io.UnsupportedOperation's stand-in until _pyio (PY6): a ValueError (its base, with OSError)."] [149 1 "// ioMethod is a built-in method of t (PY5c's AddMethod: the dictionary filled once str's hash is ready)."] [165 2 "// the standard streams' attributes (PY6b's request: doctest reads sys.stdout.encoding)"] [170 2 "// reconfigure (textio.c's _io_TextIOWrapper_reconfigure_impl; queue 286): encoding and errors (errors \"strict\" when"] [171 2 "// only the encoding is given), line_buffering (a line written flushes), write_through and newline checked; the"] [172 2 "// encoding looked up as the codec registry has it"] [286 2 "// writelines is IOBase's (iobase.c's _io__IOBase_writelines_impl): each line given to the stream's write (queue 574:"] [287 2 "// Tools/patchcheck/reindent.py without arguments writes sys.stdout's lines so, test_reindent's test_noargs)"] [311 4 "// a write error raises (queue 253: flush_std_files reports a failed flush at shutdown, status 120)"] [339 2 "// readlines(hint=-1) and iteration (py-design-1122: json.tool --json-lines reads sys.stdin.readlines()): IOBase's,"] [340 2 "// readline until the end, a positive hint stopping once the lines read hold that many characters"] [380 2 "// close (queue 249: multiprocessing's _close_stdin closes sys.stdin in a spawned child): the standard streams are"] [381 2 "// made with closefd=False (create_stdio), so the stream is flushed and marked closed, its descriptor left open"] [389 4 "// a failed flush raises after the close (TextIOWrapper.close: flush, then the buffer's close in a finally)"] [407 1 "// The standard streams' buffer (PY6e's REQUEST: subprocess's children write sys.stdout.buffer): a binary"] [408 1 "// view of the same bufio reader or writer, so text and bytes keep their order."] [510 1 "// exactArgsSelf checks a method's call: self and n arguments, no keywords."] [531 1 "// sysModule is the interpreter's sys module, made on first use."] [579 15 "// 3.15 (queue 252, PY315-SURVEY P7): the version the standard library (3.15.2's Lib) moves with"] [586 25 "// types.SimpleNamespace (PY6b: FrozenImporter makes them)"] [588 45 "// pyi's own .pyc files (PY6b): __pycache__/NAME.arbace-314.pyc, its own magic number"] [594 2 "// sys.flags as python3 -s -P -B runs (the references'): the struct sequence of sysmodule.c's flags_desc"] [607 47 "// -X int_max_str_digits, PYTHONINTMAXSTRDIGITS (py-eval-1122)"] [610 2 "// -q, -E and -I (queue 296): config's quiet, use_environment and isolated (-I also -E's)"] [611 56 "// -O, -OO (queue 557b)"] [621 2 "// -i (queue 289): inspect and interactive; PYTHONINSPECT at start: inspect"] [628 2 "// -X utf8[=0|1] and PYTHONUTF8 (py-mods-1122: 3.14's too, pyi's default 1 kept; test_io's test_text_encoding runs"] [629 2 "// children with -X utf8=0 and -X utf8=1); -X warn_default_encoding and PYTHONWARNDEFAULTENCODING (config's"] [630 2 "// warn_default_encoding, PEP 597: _pyio's text_encoding warns; test_io's test_check_encoding_warning)"] [636 3 "// 3.15's lazy imports (queue 239): sys.flags.lazy_imports, sys.lazy_modules and the mode's and filter's API"] [649 18 "// -X options (queue 220: bin/pyi python passes them in PYI_XOPTIONS)"] [658 2 "// the struct sequences of numbers and threads, with CPython 3.14's values (64-bit Linux)"] [671 2 "// sys.monitoring (PEP 669): its call-family events (queue 220, monitoring.go)"] [675 43 "// PY6c"] [678 2 "// pyi's own launcher when bin/pyi runs it (PY6e: tools/pyi/python3, CPython's command line), so that"] [679 2 "// script_helper and subprocess start pyi as CPython starts itself"] [685 2 "// sys.pycache_prefix (config_init_pycache_prefix, queue 557b): -X pycache_prefix=PATH, else PYTHONPYCACHEPREFIX (not"] [686 2 "// under -E or -I); -X pycache_prefix with no value or an empty one leaves it None"] [712 3 "// PyErr_SetObject(PyExc_SystemExit, status): a tuple's items are the exception's arguments, None none"] [768 5 "// PyErr_GetExcInfo: the type, the exception, its __traceback__ (queue 223)"] [797 40 "// -1: -X cpu_count unset (os.process_cpu_count from sched_getaffinity)"] [838 53 "// sys__getframe_impl's audit (queue 536)"] [844 2 "// breakpointhook (queue 304): sys_breakpointhook, $PYTHONBREAKPOINT's callable (pdb.set_trace when unset or empty, a"] [845 2 "// no-op for \"0\", a name without a dot builtins'), an unimportable one warned of and ignored; -E and -I ignore the"] [846 2 "// environment (Py_GETENV)"] [870 3 "// PyImport_Import: the leaf module (a non-empty fromlist)"] [888 2 "// the hooks and introspection the stdlib reads at import (PY6a: threading, test.support)"] [894 4 "// _PyErr_Display: the traceback given put on an exception that has none (issue #18776)"] [902 4 "// traceback's display raises for a non-exception; the C fallback's print_exception line (queue 223)"] [911 2 "// is_remote_debug_enabled (queue 223): False, as a CPython built without Py_REMOTE_DEBUG answers (pyi has no"] [912 2 "// remote debugging, :remote-debugging); test_sys imports it at its top"] [973 3 "// dataclasses' slots=True (gh-135228): __dict__ and __weakref__ taken out of a heap type's dict"] [991 2 "// get_asyncgen_hooks and set_asyncgen_hooks (sysmodule.c; asyncio's event loops set theirs around run_forever):"] [992 2 "// the running thread's hooks, a sys.asyncgen_hooks; an argument left out keeps its hook, None clears it"] [1026 2 "// _PySys_SetIntMaxStrDigits: 0 (no limit) or at least 640, sys.flags.int_max_str_digits with it (queue 202: a no-op,"] [1027 2 "// so test_decimal's PyCoverage, which sets 7000, met the 4300 digits' limit)"] [1050 2 "// sys.getprofile and sys.setprofile: the legacy profiler over sys.monitoring (queue 220, monitoring.go)"] [1057 2 "// sys.gettrace and sys.settrace: the legacy tracer over sys.monitoring (queue 219t, trace.go)"] [1084 2 "// threading.settrace_all_threads and setprofile_all_threads: every thread's trace or profile function"] [1127 24 "// its functions' __module__ \"sys\" (PY6f's REQUEST 8, as importBuiltin tags the others)"] [1131 1 "// displayHook is sys.displayhook: None prints nothing; another value's repr is written to sys.stdout and"] [1132 1 "// bound to builtins._ (the REPL's expression statements)."] [1153 1 "// sysAttr is sys.NAME when the sys module exists and has it, else nil."] [1161 1 "// sysModuleIfAny is the interpreter's sys module once made (interp->sysdict: sys.modules' entry is not needed, queue"] [1162 1 "// 253), else the one in sys.modules, else nil."] [1173 1 "// writeTo writes s to a file object: the interpreter's stdout when f is nil or None, a textFile directly,"] [1174 1 "// else f.write(s)."] [1194 1 "// exactArgsN checks a function's call: n positional arguments, no keywords (CPython's messages)."] [1208 1 "// cpythonSizeof is sys.getsizeof as CPython 3.14 answers it on a 64-bit build for the core immutable types"] [1209 1 "// and the list and tuple (the list's allocation taken as its length), 0 for any other object (PY6b's"] [1210 1 "// request: test_marshal sizes its big-memory tests by sys.getsizeof of an int at import). py-mods-1122: also a"] [1211 1 "// dict (dictSizeof), and in getsizeof a weak reference or proxy and a heap type's instance (objectSizeof:"] [1212 1 "// object.__sizeof__'s tp_basicsize, 16 and 8 a slot, with getsizeof's pre-header, the GC header and the managed"] [1213 1 "// __dict__ and __weakref__ pointers), so the pure OrderedDict's __sizeof__ (its __dict__, its map, its links and"] [1214 1 "// proxies) answers."] [1220 30 "// OrderedDict.__sizeof__ and the GC header"] [1234 36 "// sizeof(PyByteArrayObject) + ob_alloc"] [1259 1 "// objectSizeof is getsizeof's answer for a weak reference or proxy and a heap type's instance (sys.getsizeof's alone:"] [1260 1 "// tracemalloc's sizes are cpythonSizeof's), 0 for any other object."] [1264 18 "// sizeof(PyWeakReference), the GC header"] [1269 35 "// the built-in base's size (0: unknown here)"] [1274 12 "// Py_TPFLAGS_PREHEADER: the managed __dict__ and __weakref__ pointers"] [1276 17 "// the GC header (a heap type with a __dict__, a __weakref__ or slots is collected)"] [1281 1 "// dictSizeof is _PyDict_SizeOf with getsizeof's GC header: sizeof(PyDictObject) 48, the GC header 16, and a"] [1282 1 "// non-empty dict's keys object (PyDictKeysObject's 32 bytes, a byte of index a slot up to 256 slots, the usable"] [1283 1 "// two thirds of its slots as entries, 16 bytes each when every key is a str, else 24), its size the smallest power"] [1284 1 "// of two from 8 whose usable part holds the dict's entries."] [1314 1 "// versionInfoType is sys.version_info's struct sequence (PY6b's request: test_importlib reads its releaselevel):"] [1315 1 "// a tuple with the fields' names."] [1352 1 "// asyncgenHooks are each thread's async generator hooks (firstiter, finalizer; nil unset, None too), as the thread"] [1353 1 "// state's async_gen_firstiter and async_gen_finalizer: firstiter called on an async generator's first __anext__, asend,"] [1354 1 "// athrow or aclose (coro.go's asyncGenInitHooks; asyncio's tracking of unfinished async generators for"] [1355 1 "// shutdown_asyncgens); the finalizer kept, never called (pyi has no finalization, PY7)."] [1360 1 "// stdlibAdded315 and stdlibRemoved315 are 3.15.2's Python/stdlib_module_names.h against 3.14.10's (queue 252): its"] [1361 1 "// 296 names."] [1366 1 "// stdlibModuleNames is sys.stdlib_module_names (Python/stdlib_module_names.h of CPython 3.14.10, its 297 names; queue 223:"] [1367 1 "// traceback's \"Did you forget to import\" reads it)"] [1403 1 "// utf8Mode315 is 3.15's UTF-8 mode (PEP 686, Python/initconfig.c's config_init_utf8_mode; queue 237): on by default,"] [1404 1 "// -X utf8=0 (or PYTHONUTF8=0, which -E and -I ignore) turns it off, -X utf8 and -X utf8=1 on. 3.14's answer stays"] [1405 1 "// pyi's 1 (the locale's coercion pyi does not model)."] [1419 1 "// utf8ModeCheck315 is preconfig_init_utf8_mode's refusals (3.15; queue 237): -X utf8=V and PYTHONUTF8 other than 0 or 1"] [1420 1 "// are a fatal error at start, status 1"] [1443 1 "// startWarnOptions is sys.warnoptions as config_init_warnoptions orders it (queue 328), the lowest precedence first:"] [1444 1 "// \"default\" in development mode, PYTHONWARNINGS's comma-separated options (not under -E or -I), the command line's -W"] [1445 1 "// options (bin/pyi python's PYI_WARNOPTIONS, one a line, read once and removed from the environment as PYI_XOPTIONS"] [1446 1 "// is), then -b's \"default::BytesWarning\" or -bb's \"error::BytesWarning\"."] [1477 1 "// startBytesWarning is -b's count (bin/pyi python's PYI_BYTES_WARNING, read once and removed from the environment):"] [1478 1 "// sys.flags.bytes_warning."] [1500 1 "// init_interp_main: the warnings module imported at start when sys.warnoptions holds an option, so its"] [1501 1 "// _processoptions applies them (and reports an invalid one) before the main module runs (queue 328: test_warnings'"] [1502 1 "// test_warnings_bootstrap and test_improper_option)"] [1518 1 "// cpuCountConfig is PyConfig's cpu_count (py-eval-1122; Python/initconfig.c's config_init_cpu_count): -X cpu_count=N, else"] [1519 1 "// PYTHON_CPU_COUNT=N (not under -E or -I), N > 0; \"default\", unset or not a positive number: -1. os.cpu_count() answers it"] [1520 1 "// when set, and os.process_cpu_count() is then os.cpu_count() (os.py)."] [1541 1 "// intMaxStrDigitsConfig is PyConfig's int_max_str_digits (py-eval-1122; Python/initconfig.c's"] [1542 1 "// config_init_int_max_str_digits): -X int_max_str_digits=N, else PYTHONINTMAXSTRDIGITS=N (not under -E or -I), N 0 (no"] [1543 1 "// limit) or at least 640; -1 when neither is given; for any other N (none, not a number, under 640) the start's error."] [1544 1 "// The start (an atStartHook) sets sys.set_int_max_str_digits' limit from it; sys.flags.int_max_str_digits shows it."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[212 13] [212 21] [231 57] [265 53] [276 26] [280 37] [289 58] [310 30] [312 37] [348 32] [383 53] [390 37] [432 54] [447 29] [453 34] [454 38] [503 30] [536 48] [607 36] [632 54] [687 47] [693 48] [714 34] [724 54] [730 62] [736 62] [750 26] [757 54] [760 26] [766 26] [767 43] [779 63] [785 66] [791 70] [800 51] [810 56] [816 43] [819 46] [831 7] [831 30] [838 38] [861 40] [893 31] [895 37] [939 58] [948 56] [951 34] [954 33] [967 62] [974 68] [985 41] [994 63] [1033 28] [1052 32] [1059 30] [1065 44] [1075 42] [1146 45] [1155 29] [1167 48] [1183 28] [1268 29] [1305 23] [1407 37] [1423 37] [1427 39] [1458 46] [1466 34] [1481 48] [1528 62] [1556 52] [1558 51]] :go/trails [[1400 82]]} (go/file "sys.go" :imports [



(in-ns 'go.arbace.py) ^{:go/comments [[3 1 "// The module _io (queue 545, the user's 535-2 (a)): CPython's Modules/_io ported to Go, the C side of io.py, as"] [4 1 "// _iomodule.c, iobase.c, bytesio.c, stringio.c, fileio.c, bufferedio.c and textio.c have it; Lib/_pyio.py stays"] [5 1 "// the Python side (test_io's Py* classes). Ported from CPython 3.14.10 (python/cpython, tag v3.14.10, Modules/_io;"] [6 1 "// the pinned Python-3.14.10.tar.xz, SHA-256 de414a57119abef52784d8993e341d53aed635fc2b05c2607d9f98a2c5b72032),"] [7 1 "// with 3.15.2's differences under py315() (Python-3.15.2.tar.xz, SHA-256"] [8 1 "// 8b5536d280142ecf6cdfe15d12a21ba1c65e300bbf7b28a8d0cdb849575797de); the PSF's license, LICENSE.md."] [9 1 "//"] [10 1 "// This file: the module (_iomodule.c: open, open_code, text_encoding, DEFAULT_BUFFER_SIZE, UnsupportedOperation and"] [11 1 "// the helpers the parts share). The types are static (one set for every interpreter, where CPython's are each module"] [12 1 "// object's heap types); their instances carry iobase's __dict__ (ioDict) and are weakly referenceable."] [20 1 "// ioDefaultBufferSize is DEFAULT_BUFFER_SIZE (_iomodule.h: 128 KiB)."] [23 1 "// builtinOpen is builtins.open, which is also _io.open and io.open (one object, as CPython's: pickle saves open by"] [24 1 "// reference, finding _io.open the same object; test_pickle's test_builtin_functions)."] [32 1 "// ioUnsupported is io.UnsupportedOperation: PyInit__io's type(\"UnsupportedOperation\", (OSError, ValueError), {}),"] [33 1 "// its __module__ \"io\". Made once, at its first use."] [47 1 "// unsupportedOperation is io.UnsupportedOperation (the standard streams' errors, sys.go)."] [50 1 "// ioRaiseUnsupported is iobase_unsupported: UnsupportedOperation(message)."] [53 1 "// ioDict is iobase's dict (tp_dictoffset) every _io object holds: instanceDict answers it (attr.go)."] [63 1 "// ioDictGet is the __dict__ getter of the _io types (PyObject_GenericGetDict)."] [66 20 "// handed out as an object: a node of its own to the cycle collector (finalize.go)"] [72 1 "// ioCallMethod is PyObject_CallMethod(o, name, args...): the attribute as any attribute, then called."] [81 1 "// ioOptAttr is PyObject_GetOptionalAttr: nil (and no error) when o has no such attribute."] [84 1 "// ioChain is _PyErr_ChainExceptions1: the first error kept as the context of the later one (later nil: the first)."] [100 1 "// ioTrapEINTR is _PyIO_trap_eintr: whether err is an OSError of errno EINTR (then dropped by the caller, which retries)."] [118 1 "// ioSsizeOpt is clinic's Py_ssize_t(accept={int, NoneType}) (_Py_convert_optional_to_ssize_t): None (or absent) def,"] [119 1 "// an index its value (OverflowError past a Py_ssize_t), anything else a TypeError."] [130 1 "// ioSsize is clinic's Py_ssize_t: __index__, an OverflowError past a Py_ssize_t."] [133 1 "// ioCInt is clinic's int (PyLong_AsInt): __index__, an OverflowError past a C int."] [146 1 "// ioCLong is PyLong_AsLong: __index__, an OverflowError past a C long."] [159 1 "// ioOffT is PyNumber_AsOff_t(item, err): __index__ as an off_t; past it an OverflowError, or with errType that"] [160 1 "// error's \"cannot fit '%s' into an offset-sized integer\"."] [179 1 "// ioNoArgs is a METH_NOARGS method's check: \"T.name() takes no arguments (N given)\"."] [190 1 "// ioOneArg is a METH_O method's check: \"T.name() takes exactly one argument (N given)\"."] [201 1 "// ioPos is clinic's positional-only check (_PyArg_CheckPositional and _PyArg_NoKeywords): between min and max"] [202 1 "// arguments after self, no keywords; the arguments after self."] [214 1 "// ioRWBuffer is clinic's Py_buffer(accept={rwbuffer}) (\"w*\"): a writable contiguous buffer, else getargs' TypeError"] [215 1 "// naming the method's argument."] [227 1 "// ioROBuffer is clinic's Py_buffer (\"y*\"): a bytes-like object's contents, else getargs' TypeError."] [235 2 "// a class's __buffer__ (PEP 688), its view released once its bytes are taken"] [253 1 "// ioArgName is getargs' \"argument N\" (METH_O's \"argument\" for 0)."] [261 1 "// ioWarn is PyErr_WarnEx."] [264 1 "// ioOpen is _io_open_impl."] [432 1 "// isNumberObj is PyNumber_Check: __index__, __int__ or __float__, or a complex."] [441 1 "// osFSPath is PyOS_FSPath: a str or bytes as is, else its __fspath__'s str or bytes."] [469 1 "// ioOptStr is clinic's str(accept={str, NoneType}): None (or absent) is None, a str its value."] [478 53 "// clinic's str: UTF-8, a lone surrogate's UnicodeEncodeError"] [487 1 "// ioModuleTypes are the types _io's namespace holds."] [491 64 "// _BytesIOBuffer: _io's attribute (queue 594)"] [538 1 "// ioTextEncoding is _io_text_encoding_impl."] [554 1 "// warnDefaultEncoding is the configuration's warn_default_encoding (sys.flags')."] [622 2 "// open_code (PyFile_OpenCodeObject): path a str, then open(path, 'rb') (no open_code hook in pyi)"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[65 25] [208 42] [229 24] [232 44] [236 51] [245 32] [282 47] [291 12] [291 27] [353 143] [373 29] [426 53] [443 22] [446 38] [460 22] [463 38] [478 38] [512 29] [515 35] [521 47] [527 33] [542 90] [556 25] [557 39] [558 37] [559 61] [628 26] [638 50] [643 33]]} (go/file "builtins_io.go" :imports [


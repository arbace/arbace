(in-ns 'go.arbace.py) ^{:go/comments [[3 1 "// The module _io (queue 545, the user's 535-2 (a)): CPython's Modules/_io ported to Go, the C side of io.py, as"] [4 1 "// _iomodule.c, iobase.c, bytesio.c, stringio.c, fileio.c, bufferedio.c and textio.c have it; Lib/_pyio.py stays"] [5 1 "// the Python side (test_io's Py* classes). Ported from CPython 3.14.10 (python/cpython, tag v3.14.10, Modules/_io;"] [6 1 "// the pinned Python-3.14.10.tar.xz, SHA-256 de414a57119abef52784d8993e341d53aed635fc2b05c2607d9f98a2c5b72032),"] [7 1 "// with 3.15.2's differences under py315() (Python-3.15.2.tar.xz, SHA-256"] [8 1 "// 8b5536d280142ecf6cdfe15d12a21ba1c65e300bbf7b28a8d0cdb849575797de); the PSF's license, LICENSE.md."] [9 1 "//"] [10 1 "// This file: the module (_iomodule.c: open, open_code, text_encoding, DEFAULT_BUFFER_SIZE, UnsupportedOperation and"] [11 1 "// the helpers the parts share). The types are static (one set for every interpreter, where CPython's are each module"] [12 1 "// object's heap types); their instances carry iobase's __dict__ (ioDict) and are weakly referenceable."] [20 1 "// ioDefaultBufferSize is DEFAULT_BUFFER_SIZE (_iomodule.h: 128 KiB)."] [23 1 "// builtinOpen is builtins.open, which is also _io.open and io.open (one object, as CPython's: pickle saves open by"] [24 1 "// reference, finding _io.open the same object; test_pickle's test_builtin_functions)."] [32 1 "// ioUnsupported is io.UnsupportedOperation: PyInit__io's type(\"UnsupportedOperation\", (OSError, ValueError), {}),"] [33 1 "// its __module__ \"io\". Made once, at its first use."] [47 1 "// unsupportedOperation is io.UnsupportedOperation (the standard streams' errors, sys.go)."] [50 1 "// ioRaiseUnsupported is iobase_unsupported: UnsupportedOperation(message)."] [53 1 "// ioDict is iobase's dict (tp_dictoffset) every _io object holds: instanceDict answers it (attr.go)."] [63 1 "// ioDictGet is the __dict__ getter of the _io types (PyObject_GenericGetDict)."] [71 1 "// ioCallMethod is PyObject_CallMethod(o, name, args...): the attribute as any attribute, then called."] [80 1 "// ioOptAttr is PyObject_GetOptionalAttr: nil (and no error) when o has no such attribute."] [83 1 "// ioChain is _PyErr_ChainExceptions1: the first error kept as the context of the later one (later nil: the first)."] [99 1 "// ioTrapEINTR is _PyIO_trap_eintr: whether err is an OSError of errno EINTR (then dropped by the caller, which retries)."] [117 1 "// ioSsizeOpt is clinic's Py_ssize_t(accept={int, NoneType}) (_Py_convert_optional_to_ssize_t): None (or absent) def,"] [118 1 "// an index its value (OverflowError past a Py_ssize_t), anything else a TypeError."] [129 1 "// ioSsize is clinic's Py_ssize_t: __index__, an OverflowError past a Py_ssize_t."] [132 1 "// ioCInt is clinic's int (PyLong_AsInt): __index__, an OverflowError past a C int."] [145 1 "// ioCLong is PyLong_AsLong: __index__, an OverflowError past a C long."] [158 1 "// ioOffT is PyNumber_AsOff_t(item, err): __index__ as an off_t; past it an OverflowError, or with errType that"] [159 1 "// error's \"cannot fit '%s' into an offset-sized integer\"."] [178 1 "// ioNoArgs is a METH_NOARGS method's check: \"T.name() takes no arguments (N given)\"."] [189 1 "// ioOneArg is a METH_O method's check: \"T.name() takes exactly one argument (N given)\"."] [200 1 "// ioPos is clinic's positional-only check (_PyArg_CheckPositional and _PyArg_NoKeywords): between min and max"] [201 1 "// arguments after self, no keywords; the arguments after self."] [213 1 "// ioRWBuffer is clinic's Py_buffer(accept={rwbuffer}) (\"w*\"): a writable contiguous buffer, else getargs' TypeError"] [214 1 "// naming the method's argument."] [226 1 "// ioROBuffer is clinic's Py_buffer (\"y*\"): a bytes-like object's contents, else getargs' TypeError."] [234 2 "// a class's __buffer__ (PEP 688), its view released once its bytes are taken"] [252 1 "// ioArgName is getargs' \"argument N\" (METH_O's \"argument\" for 0)."] [260 1 "// ioWarn is PyErr_WarnEx."] [263 1 "// ioOpen is _io_open_impl."] [431 1 "// isNumberObj is PyNumber_Check: __index__, __int__ or __float__, or a complex."] [440 1 "// osFSPath is PyOS_FSPath: a str or bytes as is, else its __fspath__'s str or bytes."] [468 1 "// ioOptStr is clinic's str(accept={str, NoneType}): None (or absent) is None, a str its value."] [527 1 "// ioTextEncoding is _io_text_encoding_impl."] [543 1 "// warnDefaultEncoding is the configuration's warn_default_encoding (sys.flags')."] [571 44 "// step 1: the rest is _pyio's"] [614 2 "// open_code (PyFile_OpenCodeObject): path a str, then open(path, 'rb') (no open_code hook in pyi)"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[65 25] [207 42] [228 24] [231 44] [235 51] [244 32] [281 47] [290 12] [290 27] [352 143] [372 29] [425 53] [442 22] [445 38] [459 22] [462 38] [501 29] [504 35] [510 47] [516 33] [531 90] [545 25] [546 39] [547 37] [548 61] [571 29] [620 26] [630 50] [635 33]]} (go/file "builtins_io.go" :imports [


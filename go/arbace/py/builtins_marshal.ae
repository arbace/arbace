n\": replaced by \"unmarshallable object\", as CPython's"] [281 26 "// WTF-8 is UTF-8 with surrogatepass"] [391 1 "// pyLong is w_PyLong: the absolute value in base 2**15 digits, their count signed."] [418 1 "// marshalDumps is _PyMarshal_WriteObjectToString: the bytes, else the writer's error."] [442 1 "// MarshalDumps is marshal.dumps(v, version) for the other files."] [451 1 "// the reader (RFILE): from bytes (loads), or from a file's readinto (load)"] [455 19 "// load's file, nil for loads"] [457 21 "// nil: a reserved entry not yet filled"] [625 1 "// decodeSurrogatepass is the str of UTF-8 bytes with surrogates allowed (utf-8's surrogatepass)."] [662 1 "// object is r_object: (nil, nil) for TYPE_NULL."] [763 20 "// PyUnicode_1BYTE_KIND: latin-1"] [931 1 "// readObject is read_object: TYPE_NULL at the top an error."] [943 1 "// MarshalLoads is marshal.loads(b) for the other files."] [948 1 "// marshalArgs binds marshal's functions' arguments: the positional ones, then keyword-only allow_code."] [1017 4 "// PyMarshal_WriteObjectToString's audit (queue 536): dumps and dump alike"] [1036 4 "// PyMarshal_WriteObjectToString's audit (queue 536): dumps and dump alike"] [1059 88 "// queue 536"] [1081 50 "// queue 536"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[75 30] [147 29] [159 25] [183 25] [228 24] [301 13] [301 31] [367 25] [372 32] [373 64] [375 29] [483 25] [560 40] [580 19] [580 28] [627 12] [627 24] [666 29] [781 38] [805 13] [805 20] [823 13] [823 20] [852 25] [869 39] [872 13] [872 20] [880 22] [990 24] [1018 60] [1037 60] [1059 73] [1076 29] [1077 44] [1081 35]]} (go/file "builtins_marshal.go" :imports [



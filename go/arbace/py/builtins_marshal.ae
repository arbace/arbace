(in-ns 'go.arbace.py) ^{:go/comments [[13 1 "// The module marshal (PY6b, the import family): a port of CPython 3.14's Python/marshal.c, versions 0 to 5,"] [14 1 "// dumps, loads, dump and load with allow_code, references (version 3 on), interned strings (sys.intern's"] [15 1 "// table, internStr), sets in the order of their elements' dumps (bpo-37596) and the errors' messages."] [16 1 "// Two differences from CPython, both of its object model: an object is written with FLAG_REF whenever"] [17 1 "// references are on (CPython leaves out an object its reference count says is not shared; pyi has no"] [18 1 "// counts), so the bytes differ in that bit and every object read is kept in the reference list, which"] [19 1 "// loads either way; and a code object is pyi's (its IR, not CPython's bytecode): TYPE_CODE with CPython's"] [20 1 "// fields, co_code holding pyi's instructions (marshal_code.go), so CPython's .pyc code is refused and"] [21 1 "// pyi's own .pyc files carry their own magic number (_imp.pyc_magic_number_token)."] [60 1 "// the writer's errors (WFERR_*)"] [70 1 "// internTable is the interpreter's interned strs (sys.intern; marshal's TYPE_*INTERNED)."] [73 1 "// internStr is sys.intern(s): the interned str equal to s, s itself the first time."] [82 1 "// isInterned is PyUnicode_CHECK_INTERNED."] [91 27 "// the reference index of each object written (bit 31: a code or slice being written)"] [121 1 "// floatStr is PyOS_double_to_string(v, 'g', 17): version 0 and 1's floats."] [138 1 "// refKey is the identity an object is referenced by (a code object's: its code, as __code__ makes new"] [139 1 "// wrappers of one code)."] [147 1 "// ref is w_ref: a reference to an object written before (true), else the object registered and flag set."] [155 29 "// \"cannot marshal recursion\": replaced by \"unmarshallable object\", as CPython's"] [275 26 "// WTF-8 is UTF-8 with surrogatepass"] [385 1 "// pyLong is w_PyLong: the absolute value in base 2**15 digits, their count signed."] [412 1 "// marshalDumps is _PyMarshal_WriteObjectToString: the bytes, else the writer's error."] [436 1 "// MarshalDumps is marshal.dumps(v, version) for the other files."] [445 1 "// the reader (RFILE): from bytes (loads), or from a file's readinto (load)"] [449 19 "// load's file, nil for loads"] [451 21 "// nil: a reserved entry not yet filled"] [619 1 "// decodeSurrogatepass is the str of UTF-8 bytes with surrogates allowed (utf-8's surrogatepass)."] [656 1 "// object is r_object: (nil, nil) for TYPE_NULL."] [757 20 "// PyUnicode_1BYTE_KIND: latin-1"] [925 1 "// readObject is read_object: TYPE_NULL at the top an error."] [937 1 "// MarshalLoads is marshal.loads(b) for the other files."] [942 1 "// marshalArgs binds marshal's functions' arguments: the positional ones, then keyword-only allow_code."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[75 30] [141 29] [153 25] [177 25] [222 24] [295 13] [295 31] [361 25] [366 32] [367 64] [369 29] [477 25] [554 40] [574 19] [574 28] [621 12] [621 24] [660 29] [775 38] [799 13] [799 20] [817 13] [817 20] [846 25] [863 39] [866 13] [866 20] [874 22] [984 24] [1059 29] [1060 44]]} (go/file "builtins_marshal.go" :imports [



ass"] [388 1 "// pyLong is w_PyLong: the absolute value in base 2**15 digits, their count signed."] [415 1 "// marshalDumps is _PyMarshal_WriteObjectToString: the bytes, else the writer's error."] [439 1 "// MarshalDumps is marshal.dumps(v, version) for the other files."] [448 1 "// the reader (RFILE): from bytes (loads), or from a file's readinto (load)"] [452 19 "// load's file, nil for loads"] [454 21 "// nil: a reserved entry not yet filled"] [622 1 "// decodeSurrogatepass is the str of UTF-8 bytes with surrogates allowed (utf-8's surrogatepass)."] [659 1 "// object is r_object: (nil, nil) for TYPE_NULL."] [760 20 "// PyUnicode_1BYTE_KIND: latin-1"] [928 1 "// readObject is read_object: TYPE_NULL at the top an error."] [940 1 "// MarshalLoads is marshal.loads(b) for the other files."] [945 1 "// marshalArgs binds marshal's functions' arguments: the positional ones, then keyword-only allow_code."] [1014 4 "// PyMarshal_WriteObjectToString's audit (queue 536): dumps and dump alike"] [1033 4 "// PyMarshal_WriteObjectToString's audit (queue 536): dumps and dump alike"] [1056 88 "// queue 536"] [1078 50 "// queue 536"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[75 30] [144 29] [156 25] [180 25] [225 24] [298 13] [298 31] [364 25] [369 32] [370 64] [372 29] [480 25] [557 40] [577 19] [577 28] [624 12] [624 24] [663 29] [778 38] [802 13] [802 20] [820 13] [820 20] [849 25] [866 39] [869 13] [869 20] [877 22] [987 24] [1015 60] [1034 60] [1056 73] [1073 29] [1074 44] [1078 35]]} (go/file "builtins_marshal.go" :imports [



al name (the literal for a numeric host)."] [287 24 "// AI_V4MAPPED"] [302 4 "// inet_aton's forms: 127.1, 0x7f.1, a single number"] [308 22 "// AI_NUMERICHOST"] [341 1 "// inetAton is inet_aton(3): a.b.c.d, a.b.c, a.b or a, each part decimal, octal or hex."] [393 1 "// sockaddrArg is getsockaddrarg: an address object of the socket's family as a syscall.Sockaddr."] [503 1 "// sockaddrObj is makesockaddr: a syscall.Sockaddr as CPython's address object."] [512 22 "// unnamed (Go's anyToSockaddr turns its empty path's NUL into '@')"] [528 1 "// ---- buffers"] [530 1 "// writableBuf is a writable bytes-like object's bytes: a bytearray, or a memoryview of one."] [1565 21 "// NI_NUMERICHOST"] [1568 29 "// NI_NAMEREQD"] [1573 21 "// NI_NUMERICSERV"] [1575 23 "// NI_DGRAM"] [1768 1 "// hostsName is /etc/hosts' canonical name of an address, \"\" when none."] [1836 1 "// getaddrinfo is musl's: the host's addresses (numeric, /etc/hosts; None: loopback, or any with AI_PASSIVE) times"] [1837 1 "// the socket types asked (0: stream and datagram), canonname always set as musl sets it."] [1845 32 "// AI_NUMERICSERV"] [1870 21 "// AI_PASSIVE"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[43 34] [152 46] [255 39] [285 36] [297 36] [301 29] [303 30] [363 12] [363 21] [373 12] [373 21] [408 53] [484 36] [492 44] [494 42] [539 34] [547 24] [554 24] [681 31] [692 48] [703 49] [722 42] [729 36] [746 43] [791 36] [799 45] [815 48] [834 42] [857 45] [893 32] [934 42] [953 46] [997 29] [1026 45] [1035 33] [1069 45] [1080 5] [1109 6] [1119 51] [1135 46] [1142 41] [1181 79] [1186 31] [1187 65] [1196 53] [1202 48] [1277 35] [1280 39] [1315 30] [1338 50] [1366 43] [1500 37] [1525 24] [1566 27] [1578 38] [1645 40] [1675 40] [1696 37] [1721 29] [1723 38] [1735 29] [1793 39] [1843 37] [1854 39] [1883 50]]} (go/file "builtins_socket.go" :imports [



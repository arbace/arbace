(in-ns 'go.arbace.py) ^{:go/comments [[16 1 "// The module _socket (PY6e; Modules/socketmodule.c): BSD sockets over Go's syscall, for socket.py and what imports"] [17 1 "// it (doctest through pdb, subprocess's and asyncio's loopback pairs, test.support.socket_helper). A socket object"] [18 1 "// keeps its descriptor, family, type, protocol and timeout; a timeout is CPython's: the descriptor non-blocking and"] [19 1 "// each operation waiting on select(2) for at most the timeout (sock_call_ex). Addresses are CPython's tuples for"] [20 1 "// AF_INET and AF_INET6, a str or bytes path for AF_UNIX (a leading NUL: Linux's abstract namespace). Names resolve"] [21 1 "// as musl's getaddrinfo does through /etc/hosts and /etc/services (no DNS query: the tests run on loopback only)."] [28 29 "// seconds; < 0: blocking, no timeout"] [41 1 "// sockErr is a Go error of a socket call as OSError's subclass of its errno."] [49 1 "// errnoError is OSError(errno, strerror(errno)[, filename]): its subclass by errno."] [84 1 "// wait is select(2) on the socket for reading or writing, at most its timeout; false when it timed out."] [111 1 "// call runs op as CPython's sock_call: with a timeout, after waiting until the socket is ready, again while it"] [112 1 "// would block; without one, once (a blocking socket, or a non-blocking one's BlockingIOError)."] [159 1 "// timeoutArg is a timeout argument: None (-1) or a non-negative number of seconds."] [184 1 "// ---- addresses"] [192 5 "// IDNA: the names the tests use are ASCII; a non-ASCII one is encoded as CPython's idna codec does"] [212 1 "// resolveOne is a host's address of family (setipaddr): ” any, '<broadcast>', a literal, else /etc/hosts' first."] [271 1 "// precedence is RFC 3484's policy table, as musl sorts getaddrinfo's results (::1 first)."] [282 1 "// resolveHost is musl's name lookup: a numeric host, else the lines of /etc/hosts naming it, each address once,"] [283 1 "// sorted by precedence; canon the first line's canonical name (the literal for a numeric host)."] [287 24 "// AI_V4MAPPED"] [302 4 "// inet_aton's forms: 127.1, 0x7f.1, a single number"] [308 22 "// AI_NUMERICHOST"] [341 1 "// inetAton is inet_aton(3): a.b.c.d, a.b.c, a.b or a, each part decimal, octal or hex."] [393 1 "// sockaddrArg is getsockaddrarg: an address object of the socket's family as a syscall.Sockaddr."] [425 23 "// a file named \"@...\": Go's SockaddrUnix reads a leading '@' as the abstract namespace"] [505 1 "// sockaddrObj is makesockaddr: a syscall.Sockaddr as CPython's address object."] [514 22 "// unnamed (Go's anyToSockaddr turns its empty path's NUL into '@')"] [533 1 "// ---- buffers"] [535 1 "// writableBuf is a writable bytes-like object's bytes: a bytearray, or a memoryview of one."] [1570 21 "// NI_NUMERICHOST"] [1573 29 "// NI_NAMEREQD"] [1578 21 "// NI_NUMERICSERV"] [1580 23 "// NI_DGRAM"] [1773 1 "// hostsName is /etc/hosts' canonical name of an address, \"\" when none."] [1841 1 "// getaddrinfo is musl's: the host's addresses (numeric, /etc/hosts; None: loopback, or any with AI_PASSIVE) times"] [1842 1 "// the socket types asked (0: stream and datagram), canonname always set as musl sets it."] [1850 32 "// AI_NUMERICSERV"] [1875 21 "// AI_PASSIVE"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[43 34] [152 46] [255 39] [285 36] [297 36] [301 29] [303 30] [363 12] [363 21] [373 12] [373 21] [408 53] [486 36] [494 44] [496 42] [544 34] [552 24] [559 24] [686 31] [697 48] [708 49] [727 42] [734 36] [751 43] [796 36] [804 45] [820 48] [839 42] [862 45] [898 32] [939 42] [958 46] [1002 29] [1031 45] [1040 33] [1074 45] [1085 5] [1114 6] [1124 51] [1140 46] [1147 41] [1186 79] [1191 31] [1192 65] [1201 53] [1207 48] [1282 35] [1285 39] [1320 30] [1343 50] [1371 43] [1505 37] [1530 24] [1571 27] [1583 38] [1650 40] [1680 40] [1701 37] [1726 29] [1728 38] [1740 29] [1798 39] [1848 37] [1859 39] [1888 50]]} (go/file "builtins_socket.go" :imports [



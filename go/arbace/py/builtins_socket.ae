

(in-ns 'go.arbace.py) ^{:go/comments [[1 1 "//go:build linux"] [18 1 "// The module _socket (PY6e; Modules/socketmodule.c): BSD sockets over Go's syscall, for socket.py and what imports"] [19 1 "// it (doctest through pdb, subprocess's and asyncio's loopback pairs, test.support.socket_helper). A socket object"] [20 1 "// keeps its descriptor, family, type, protocol and timeout; a timeout is CPython's: the descriptor non-blocking and"] [21 1 "// each operation waiting on select(2) for at most the timeout (sock_call_ex). Addresses are CPython's tuples for"] [22 1 "// AF_INET and AF_INET6, a str or bytes path for AF_UNIX (a leading NUL: Linux's abstract namespace). Names resolve"] [23 1 "// as musl's getaddrinfo does through /etc/hosts and /etc/services (no DNS query: the tests run on loopback only)."] [30 29 "// seconds; < 0: blocking, no timeout"] [43 1 "// sockErr is a Go error of a socket call as OSError's subclass of its errno."] [51 1 "// errnoError is OSError(errno, strerror(errno)[, filename]): its subclass by errno."] [86 1 "// wait is select(2) on the socket for reading or writing, at most its timeout; false when it timed out."] [98 25 "// the GIL released while it blocks (PY6f's allowThreads; queue 200, PY6-core)"] [115 1 "// call runs op as CPython's sock_call: with a timeout, after waiting until the socket is ready, again while it"] [116 1 "// would block; without one, once (a blocking socket, or a non-blocking one's BlockingIOError)."] [124 40 "// the GIL released while it blocks (PY6f's allowThreads; queue 200, PY6-core)"] [165 1 "// timeoutArg is a timeout argument: None (-1) or a non-negative number of seconds."] [190 1 "// ---- addresses"] [198 5 "// IDNA: the names the tests use are ASCII; a non-ASCII one is encoded as CPython's idna codec does"] [218 1 "// resolveOne is a host's address of family (setipaddr): ” any, '<broadcast>', a literal, else /etc/hosts' first."] [277 1 "// precedence is RFC 3484's policy table, as musl sorts getaddrinfo's results (::1 first)."] [288 1 "// resolveHost is musl's name lookup: a numeric host, else the lines of /etc/hosts naming it, each address once,"] [289 1 "// sorted by precedence; canon the first line's canonical name (the literal for a numeric host)."] [293 24 "// AI_V4MAPPED"] [308 4 "// inet_aton's forms: 127.1, 0x7f.1, a single number"] [314 22 "// AI_NUMERICHOST"] [347 1 "// inetAton is inet_aton(3): a.b.c.d, a.b.c, a.b or a, each part decimal, octal or hex."] [399 1 "// sockaddrArg is getsockaddrarg: an address object of the socket's family as a syscall.Sockaddr."] [431 23 "// a file named \"@...\": Go's SockaddrUnix reads a leading '@' as the abstract namespace"] [511 1 "// sockaddrObj is makesockaddr: a syscall.Sockaddr as CPython's address object."] [520 22 "// unnamed (Go's anyToSockaddr turns its empty path's NUL into '@')"] [539 1 "// ---- buffers"] [541 1 "// writableBuf is a writable bytes-like object's bytes: a bytearray, or a memoryview of one."] [783 25 "// the GIL released while it blocks (PY6f's allowThreads; queue 200, PY6-core)"] [1597 21 "// NI_NUMERICHOST"] [1600 29 "// NI_NAMEREQD"] [1605 21 "// NI_NUMERICSERV"] [1607 23 "// NI_DGRAM"] [1790 4 "// CPython's get_CMSG_LEN and get_CMSG_SPACE: the length at most socklen_t's limit less CMSG_LEN(0),"] [1791 4 "// or less CMSG_SPACE(1)"] [1807 1 "// hostsName is /etc/hosts' canonical name of an address, \"\" when none."] [1875 1 "// getaddrinfo is musl's: the host's addresses (numeric, /etc/hosts; None: loopback, or any with AI_PASSIVE) times"] [1876 1 "// the socket types asked (0: stream and datagram), canonname always set as musl sets it."] [1884 32 "// AI_NUMERICSERV"] [1909 21 "// AI_PASSIVE"]] :go/pos {:name [3 9] :package [3 1]} :go/semis [[45 34] [158 46] [261 39] [291 36] [303 36] [307 29] [309 30] [369 12] [369 21] [379 12] [379 21] [414 53] [492 36] [500 44] [502 42] [550 34] [558 24] [565 24] [692 31] [703 48] [714 49] [733 42] [740 36] [757 43] [804 36] [812 45] [828 48] [847 42] [870 45] [
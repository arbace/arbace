

(in-ns 'go.arbace.py) ^{:go/comments [[1 1 "//go:build linux"] [18 1 "// The module _socket (PY6e; Modules/socketmodule.c): BSD sockets over Go's syscall, for socket.py and what imports"] [19 1 "// it (doctest through pdb, subprocess's and asyncio's loopback pairs, test.support.socket_helper). A socket object"] [20 1 "// keeps its descriptor, family, type, protocol and timeout; a timeout is CPython's: the descriptor non-blocking and"] [21 1 "// each operation waiting on select(2) for at most the timeout (sock_call_ex). Addresses are CPython's tuples for"] [22 1 "// AF_INET and AF_INET6, a str or bytes path for AF_UNIX (a leading NUL: Linux's abstract namespace). Names resolve"] [23 1 "// as musl's getaddrinfo does through /etc/hosts and /etc/services (no DNS query: the tests run on loopback only)."] [30 29 "// seconds; < 0: blocking, no timeout"] [43 1 "// sockErr is a Go error of a socket call as OSError's subclass of its errno."] [46 14 "// a signal handler's exception from an interrupted wait (queue 231)"] [54 1 "// errnoError is OSError(errno, strerror(errno)[, filename]): its subclass by errno."] [89 1 "// wait is select(2) on the socket for reading or writing, at most its timeout; false when it timed out."] [97 4 "// queue 231: the wait in ppoll with the wake pipe, a signal's handler run as at EINTR (sock_call's loop)"] [116 25 "// the GIL released while it blocks (PY6f's allowThreads; queue 200, PY6-core)"] [133 1 "// call runs op as CPython's sock_call: with a timeout, after waiting until the socket is ready, again while it"] [134 1 "// would block; without one, once (a blocking socket, or a non-blocking one's BlockingIOError)."] [142 40 "// the GIL released while it blocks (PY6f's allowThreads; queue 200, PY6-core)"] [183 1 "// timeoutArg is a timeout argument: None (-1) or a non-negative number of seconds."] [208 1 "// ---- addresses"] [216 5 "// IDNA: the names the tests use are ASCII; a non-ASCII one is encoded as CPython's idna codec does"] [236 1 "// resolveOne is a host's address of family (setipaddr): ” any, '<broadcast>', a literal, else /etc/hosts' first."] [295 1 "// precedence is RFC 3484's policy table, as musl sorts getaddrinfo's results (::1 first)."] [306 1 "// resolveHost is musl's name lookup: a numeric host, else the lines of /etc/hosts naming it, each address once,"] [307 1 "// sorted by precedence; canon the first line's canonical name (the literal for a numeric host)."] [311 24 "// AI_V4MAPPED"] [326 4 "// inet_aton's forms: 127.1, 0x7f.1, a single number"] [332 22 "// AI_NUMERICHOST"] [365 1 "// inetAton is inet_aton(3): a.b.c.d, a.b.c, a.b or a, each part decimal, octal or hex."] [417 1 "// sockaddrArg is getsockaddrarg: an address object of the socket's family as a syscall.Sockaddr."] [449 23 "// a file named \"@...\": Go's SockaddrUnix reads a leading '@' as the abstract namespace"] [529 1 "// sockaddrObj is makesockaddr: a syscall.Sockaddr as CPython's address object."] [538 22 "// unnamed (Go's anyToSockaddr turns its empty path's NUL into '@')"] [557 1 "// ---- buffers"] [559 1 "// writableBuf is a writable bytes-like object's bytes: a bytearray, or a memoryview of one."] [565 19 "// queue 231: an array's buffer is writable (recvmsg_into's testRecvmsgIntoArray)"] [581 2 "// a class's __buffer__ (queue 231: sendmsg's reentrant buffer), its view taken as Py_buffer is"] [623 3 "// sock_initobj_impl's audit (queue 536): the arguments as given (-1 for one not given)"] [769 61 "// sock_bind's audit (queue 536)"] [807 5 "// Go's Accept4 refuses the family it has no Sockaddr of; C's accept of AF_ALG has no address"] [831 25 "// the GIL released while it blocks (PY6f's allowThreads; queue 200, PY6-core)"] [1141 3 "// sock_sendmsg_iovec: the parts taken as a tuple first (PySequence_Tuple), so a part's __buffer__ that changes"] [1142 3 "// the sequence changes nothing sent (queue 249: test_sendmsg_reentrant_data_mutation)"] [1160 35 "// PySequence_Tuple, as the data's"] [1168 5 "// any sequence of length 3, as PySequence_Fast takes it (queue 231: test_aead_aes_gcm's lists)"] [1449 55 "// queue 536"] [1626 4 "// an int port outside 0-65535 as its decimal text, as CPython passes every int (PyObject_Str), the C"] [1627 4 "// library's to judge (gh-74895: no OverflowError; musl's EAI_SERVICE; queue 284)"] [1687 21 "// NI_NUMERICHOST"] [1690 29 "// NI_NAMEREQD"] [1695 21 "// NI_NUMERICSERV"] [1697 23 "// NI_DGRAM"] [1880 4 "// CPython's get_CMSG_LEN and get_CMSG_SPACE: the length at most socklen_t's limit less CMSG_LEN(0),"] [1881 4 "// or less CMSG_SPACE(1)"] [1897 1 "// hostsName is /etc/hosts' canonical name of an address, \"\" when none."] [1965 1 "// getaddrinfo is musl's: the host's addresses (numeric, /etc/hosts; None: loopback, or any with AI_PASSIVE) times"] [1966 1 "// the socket types asked (0: stream and datagram), canonname always set as musl sets it."] [1973 19 "// musl's __lookup_serv: a numeric service past 65535 is EAI_SERVICE"] [1977 32 "// AI_NUMERICSERV"] [2002 21 "// AI_PASSIVE"]] :go/pos {:name [3 9] :package [3 1]} :go/semis [[45 27] [48 34] [103 40] [176 46] [279 39] [309 36] [321 36] [325 29] [327 30] [387 12] [387 21] [397 12] [397 21] [432 53] [510 36] [518 44] [520 42] [570 29] [578 24] [582 34] [586 26] [594 24] [624 104] [725 31] [736 48] [747 49] [766 42] [769 46] [779 36] [796 43] [852 36] [860 45] [876 48] [895 42] [918 45] [954 36] [995 42] [1014 46] [1058 33] [1087 45] [1096 37] [1115 50] [1121 37] [1138 45] [1199 6] [1209 51] [1229 46] [1236 41] [1275 79] [1280 31] [1281 65] [1290 53] [1296 48] [1371 35] [1374 39] [1409 30] [1432 50] [1449 40] [1463 43] [1594 41] [1623 24] [1628 28] [1678 38] [1679 44] [1688 27] [1700 38] [1767 40] [1797 40] [1818 37] [1843 29] [1845 38] [1922 39] [1972 37] [1986 39] [2015 50] [2055 27] [2056 43] [2058 41]]} (go/file "builtins_socket.go" :build ["//go:build linux"] :imports [



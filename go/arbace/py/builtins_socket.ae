

(in-ns 'go.arbace.py) ^{:go/comments [[1 1 "//go:build linux"] [19 1 "// The module _socket (PY6e; Modules/socketmodule.c): BSD sockets over Go's syscall, for socket.py and what imports"] [20 1 "// it (doctest through pdb, subprocess's and asyncio's loopback pairs, test.support.socket_helper). A socket object"] [21 1 "// keeps its descriptor, family, type, protocol and timeout; a timeout is CPython's: the descriptor non-blocking and"] [22 1 "// each operation waiting on select(2) for at most the timeout (sock_call_ex). Addresses are CPython's tuples for"] [23 1 "// AF_INET and AF_INET6, a str or bytes path for AF_UNIX (a leading NUL: Linux's abstract namespace). Names resolve"] [24 1 "// as musl's getaddrinfo does through /etc/hosts and /etc/services (no DNS query: the tests run on loopback only)."] [31 29 "// seconds; < 0: blocking, no timeout"] [44 1 "// sockErr is a Go error of a socket call as OSError's subclass of its errno."] [47 14 "// a signal handler's exception from an interrupted wait (queue 231)"] [55 1 "// errnoError is OSError(errno, strerror(errno)[, filename]): its subclass by errno."] [90 1 "// wait is select(2) on the socket for reading or writing, at most its timeout; false when it timed out."] [98 4 "// queue 231: the wait in ppoll with the wake pipe, a signal's handler run as at EINTR (sock_call's loop)"] [117 25 "// the GIL released while it blocks (PY6f's allowThreads; queue 200, PY6-core)"] [134 1 "// call runs op as CPython's sock_call: with a timeout, after waiting until the socket is ready, again while it"] [135 1 "// would block; without one, once (a blocking socket, or a non-blocking one's BlockingIOError)."] [143 40 "// the GIL released while it blocks (PY6f's allowThreads; queue 200, PY6-core)"] [174 1 "// callWrite is call for a send whose flags op takes (py-os-1124; the user's decision of 2026-11-24): on a blocking socket in"] [175 1 "// the main thread, which runs the handlers, as CPython's send(2) under handlers installed without SA_RESTART, which Go's"] [176 1 "// are not: the wait for room in ppoll with the wake pipe (a signal's handlers run when it arrives; one that raises ends the"] [177 1 "// call with its exception, one that returns lets it go on), then the send with MSG_DONTWAIT, so it never blocks in the"] [178 1 "// kernel (the descriptor's own flags unchanged, as 545's writeInterruptible); EAGAIN waits again. Elsewhere call's."] [179 1 "// test_socket's test_sendall_interrupted, test_wsgiref's test_interrupted_write. Only AF_UNIX, AF_INET and AF_INET6, whose"] [180 1 "// poll reports room: an AF_ALG socket's never does (sock_no_poll; test_socket's LinuxKernelCryptoAPI hung on it)."] [192 17 "// the send reports the descriptor's error"] [219 1 "// timeoutArg is a timeout argument: None (-1) or a non-negative number of seconds."] [244 1 "// ---- addresses"] [252 5 "// IDNA: the names the tests use are ASCII; a non-ASCII one is encoded as CPython's idna codec does"] [272 1 "// resolveOne is a host's address of family (setipaddr): ” any, '<broadcast>', a literal, else /etc/hosts' first."] [331 1 "// precedence is RFC 3484's policy table, as musl sorts getaddrinfo's results (::1 first)."] [342 1 "// resolveHost is musl's name lookup: a numeric host, else the lines of /etc/hosts naming it, each address once,"] [343 1 "// sorted by precedence; canon the first line's canonical name (the literal for a numeric host)."] [347 24 "// AI_V4MAPPED"] [362 4 "// inet_aton's forms: 127.1, 0x7f.1, a single number"] [368 22 "// AI_NUMERICHOST"] [401 1 "// inetAton is inet_aton(3): a.b.c.d, a.b.c, a.b or a, each part decimal, octal or hex."] [453 1 "// sockaddrArg is getsockaddrarg: an address object of the socket's family as a syscall.Sockaddr."] [485 23 "// a file named \"@...\": Go's SockaddrUnix reads a leading '@' as the abstract namespace"] [565 1 "// unixSockName is getsockname or getpeername (call) of an AF_UNIX socket as makesockaddr makes it from the address and"] [566 1 "// its length (py-os-1124): Go's anyToSockaddr ends a path at its first NUL, so a Linux abstract name holding NULs"] [567 1 "// (test_socket's TestLinuxAbstractNamespace) came back cut; here an abstract name (a NUL first) is the bytes of the"] [568 1 "// whole length, a path the bytes up to its NUL decoded as a file name, none \"\"."] [595 1 "// sockaddrObj is makesockaddr: a syscall.Sockaddr as CPython's address object."] [604 22 "// unnamed (Go's anyToSockaddr turns its empty path's NUL into '@')"] [623 1 "// ---- buffers"] [625 1 "// writableBuf is a writable bytes-like object's bytes: a bytearray, or a memoryview of one."] [631 19 "// queue 231: an array's buffer is writable (recvmsg_into's testRecvmsgIntoArray)"] [647 2 "// a class's __buffer__ (queue 231: sendmsg's reentrant buffer), its view taken as Py_buffer is"] [689 3 "// sock_initobj_impl's audit (queue 536): the arguments as given (-1 for one not given)"] [835 61 "// sock_bind's audit (queue 536)"] [873 5 "// Go's Accept4 refuses the family it has no Sockaddr of; C's accept of AF_ALG has no address"] [897 25 "// the GIL released while it blocks (PY6f's allowThreads; queue 200, PY6-core)"] [1207 3 "// sock_sendmsg_iovec: the parts taken as a tuple first (PySequence_Tuple), so a part's __buffer__ that changes"] [1208 3 "// the sequence changes nothing sent (queue 249: test_sendmsg_reentrant_data_mutation)"] [1226 35 "// PySequence_Tuple, as the data's"] [1234 5 "// any sequence of length 3, as PySequence_Fast takes it (queue 231: test_aead_aes_gcm's lists)"] [1521 55 "// queue 536"] [1698 4 "// an int port outside 0-65535 as its decimal text, as CPython passes every int (PyObject_Str), the C"] [1699 4 "// library's to judge (gh-74895: no OverflowError; musl's EAI_SERVICE; queue 284)"] [1759 21 "// NI_NUMERICHOST"] [1762 29 "// NI_NAMEREQD"] [1767 21 "// NI_NUMERICSERV"] [1769 23 "// NI_DGRAM"] [1952 4 "// CPython's get_CMSG_LEN and get_CMSG_SPACE: the length at most socklen_t's limit less CMSG_LEN(0),"] [1953 4 "// or less CMSG_SPACE(1)"] [1969 1 "// hostsName is /etc/hosts' canonical name of an address, \"\" when none."] [2037 1 "// getaddrinfo is musl's: the host's addresses (numeric, /etc/hosts; None: loopback, or any with AI_PASSIVE) times"] [2038 1 "// the socket types asked (0: stream and datagram), canonname always set as musl sets it."] [2045 19 "// musl's __lookup_serv: a numeric service past 65535 is EAI_SERVICE"] [2049 32 "// AI_NUMERICSERV"] [2074 21 "// AI_PASSIVE"]] :go/pos {:name [3 9] :package [3 1]} :go/semis [[46 27] [49 34] [104 40] [189 40] [212 46] [315 39] [345 36] [357 36] [361 29] [363 30] [423 12] [423 21] [433 12] [433 21] [468 53] [546 36] [554 44] [556 42] [572 77] [586 44] [589 55] [636 29] [644 24] [648 34] [652 26] [660 24] [690 104] [791 31] [802 48] [813 49] [832 42] [835 46] [845 36] [862 43] [918 36] [926 45] [942 48] [961 42] [984 45] [1020 36] [1061 42] [1080 46] [1124 33] [1153 45] [1162 37] [1181 50] [1187 37] [1204 45] [1265 6] [1275 51] [1295 46] [1302 41] [1347 79] [1352 31] [1353 65] [1362 53] [1368 48] [1443 35] [1446 39] [1481 30] [1504 50] [1521 40] [1535 43] [1666 41] [1695 24] [1700 28] [1750 38] [1751 44] [1760 27] [1772 38] [1839 40] [1869 40] [1890 37] [1915 29] [1917 38] [1994 39] [2044 37] [2058 39] [2087 50] [2127 27] [2128 43] [2130 41]]} (go/file "builtins_socket.go" :build ["//go:build linux"] :imports [



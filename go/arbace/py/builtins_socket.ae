

(in-ns 'go.arbace.py) ^{:go/comments [[1 1 "//go:build linux"] [18 1 "// The module _socket (PY6e; Modules/socketmodule.c): BSD sockets over Go's syscall, for socket.py and what imports"] [19 1 "// it (doctest through pdb, subprocess's and asyncio's loopback pairs, test.support.socket_helper). A socket object"] [20 1 "// keeps its descriptor, family, type, protocol and timeout; a timeout is CPython's: the descriptor non-blocking and"] [21 1 "// each operation waiting on select(2) for at most the timeout (sock_call_ex). Addresses are CPython's tuples for"] [22 1 "// AF_INET and AF_INET6, a str or bytes path for AF_UNIX (a leading NUL: Linux's abstract namespace). Names resolve"] [23 1 "// as musl's getaddrinfo does through /etc/hosts and /etc/services (no DNS query: the tests run on loopback only)."] [30 29 "// seconds; < 0: blocking, no timeout"] [43 1 "// sockErr is a Go error of a socket call as OSError's subclass of its errno."] [46 14 "// a signal handler's exception from an interrupted wait (queue 231)"] [54 1 "// errnoError is OSError(errno, strerror(errno)[, filename]): its subclass by errno."] [89 1 "// wait is select(2) on the socket for reading or writing, at most its timeout; false when it timed out."] [97 4 "// queue 231: the wait in ppoll with the wake pipe, a signal's handler run as at EINTR (sock_call's loop)"] [116 25 "// the GIL released while it blocks (PY6f's allowThreads; queue 200, PY6-core)"] [133 1 "// call runs op as CPython's sock_call: with a timeout, after waiting until the socket is ready, again while it"] [134 1 "// would block; without one, once (a blocking socket, or a non-blocking one's BlockingIOError)."] [142 40 "// the GIL released while it blocks (PY6f's allowThreads; queue 200, PY6-core)"] [183 1 "// timeoutArg is a timeout argument: None (-1) or a non-negative number of seconds."] [208 1 "// ---- addresses"] [216 5 "// IDNA: the names the tests use are ASCII; a non-ASCII one is encoded as CPython's idna codec does"] [236 1 "// resolveOne is a host's address of family (setipaddr): ” any, '<broadcast>', a literal, else /etc/hosts' first."] [295 1 "// precedence is RFC 3484's policy table, as musl sorts getaddrinfo's results (::1 first)."] [306 1 "// resolveHost is musl's name lookup: a numeric host, else the lines of /etc/hosts naming it, each address once,"] [307 1 "// sorted by precedence; canon the first line's canonical name (the literal for a numeric host)."] [311 24 "// AI_V4MAPPED"] [326 4 "// inet_aton's forms: 127.1, 0x7f.1, a single number"] [332 22 "// AI_NUMERICHOST"] [365 1 "// inetAton is inet_aton(3): a.b.c.d, a.b.c, a.b or a, each part decimal, octal or hex."] [417 1 "// sockaddrArg is getsockaddrarg: an address object of the socket's family as a syscall.Sockaddr."] [449 23 "// a file named \"@...\": Go's SockaddrUnix reads a leading '@' as the abstract namespace"] [529 1 "// sockaddrObj is makesockaddr: a syscall.Sockaddr as CPython's address object."] [538 22 "// unnamed (Go's anyToSockaddr turns its empty path's NUL into '@')"] [557 1 "// ---- buffers"] [559 1 "// writableBuf is a writable bytes-like object's bytes: a bytearray, or a memoryview of one."] [789 5 "// Go's Accept4 refuses the family it has no Sockaddr of; C's accept of AF_ALG has no address"] [813 25 "// the GIL released while it blocks (PY6f's allowThreads; queue 200, PY6-core)"] [1635 21 "// NI_NUMERICHOST"] [1638 29 "// NI_NAMEREQD"] [1643 21 "// NI_NUMERICSERV"] [1645 23 "// NI_DGRAM"] [1828 4 "// CPython's get_CMSG_LEN and get_CMSG_SPACE: the length at most socklen_t's limit less CMSG_LEN(0),"] [1829 4 "// or less CMSG_SPACE(1)"] [1845 1 "// hostsName is /etc/hosts' canonical name of an address, \"\" when none."] [1913 1 "// getaddrinfo is musl's: the host's addresses (numeric, /etc/hosts; None: loopback, or any with AI_PASSIVE) times"] [1914 1 "// the socket types asked (0: stream and datagram), canonname always set as musl sets it."] [1922 32 "// AI_NUMERICSERV"] [1947 21 "// AI_PASSIVE"]] :go/pos {:
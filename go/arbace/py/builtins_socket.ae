

(in-ns 'go.arbace.py) ^{:go/comments [[1 1 "//go:build linux"] [18 1 "// The module _socket (PY6e; Modules/socketmodule.c): BSD sockets over Go's syscall, for socket.py and what imports"] [19 1 "// it (doctest through pdb, subprocess's and asyncio's loopback pairs, test.support.socket_helper). A socket object"] [20 1 "// keeps its descriptor, family, type, protocol and timeout; a timeout is CPython's: the descriptor non-blocking and"] [21 1 "// each operation waiting on select(2) for at most the timeout (sock_call_ex). Addresses are CPython's tuples for"] [22 1 "// AF_INET and AF_INET6, a str or bytes path for AF_UNIX (a leading NUL: Linux's abstract namespace). Names resolve"] [23 1 "// as musl's getaddrinfo does through /etc/hosts and /etc/services (no DNS query: the tests run on loopback only)."] [30 29 "// seconds; < 0: blocking, no timeout"] [43 1 "// sockErr is a Go error of a socket call as OSError's subclass of its errno."] [46 14 "// a signal handler's exception from an interrupted wait (queue 231)"] [54 1 "// errnoError is OSError(errno, strerror(errno)[, filename]): its subclass by errno."] [89 1 "// wait is select(2) on the socket for reading or writing, at most its timeout; false when it timed out."] [97 4 "// queue 231: the wait in ppoll with the wake pipe, a signal's handler run as at EINTR (sock_call's loop)"] [116 25 "// the GIL released while it blocks (PY6f's allowThreads; queue 200, PY6-core)"] [133 1 "// call runs op as CPython's sock_call: with a timeout, after waiting until the socket is ready, again while it"] [134 1 "// would block; without one, once (a blocking socket, or a non-blocking one's BlockingIOError)."] [142 40 "// the GIL released while it blocks (PY6f's allowThreads; queue 200, PY6-core)"] [183 1 "// timeoutArg is a timeout argument: None (-1) or a non-negative number of seconds."] [208 1 "// ---- addresses"] [216 5 "// IDNA: the names the tests use are ASCII; a non-ASCII one is encoded as CPython's idna codec does"] [236 1 "// resolveOne is a host's address of family (setipaddr): ” any, '<broadcast>', a literal, else /etc/hosts' first."] [295 1 "// precedence is RFC 3484's policy table, as musl sorts getaddrinfo's results (::1 first)."] [306 1 "// resolveHost is musl's name lookup: a numeric host, else the lines of /etc/hosts naming it, each address once,"] [307 1 "// sorted by precedence; canon the first line's canonical name (the literal for a numeric host)."] [311 24 "// AI_V4MAPPED"] [326 4 "// inet_aton's forms: 127.1, 0x7f.1, a single number"] [332 22 "// AI_NUMERICHOST"] [365 1 "// inetAton is inet_aton(3): a.b.c.d, a.b.c, a.b or a, each part decimal, octal or hex."] [417 1 "// sockaddrArg is getsockaddrarg: an address object of the socket's family as a syscall.Sockaddr."] [449 23 "// a file named \"@...\": Go's SockaddrUnix reads a leading '@' as the abstract namespace"] [529 1 "// sockaddrObj is makesockaddr: a syscall.Sockaddr as CPython's address object."] [538 22 "// unnamed (Go's anyToSockaddr turns its empty path's NUL into '@')"] [557 1 "// ---- buffers"] [559 1 "// writableBuf is a writable bytes-like object's bytes: a bytearray, or a memoryview of one."] [565 19 "// queue 231: an array's buffer is writable (recvmsg_into's testRecvmsgIntoArray)"] [581 2 "// a class's __buffer__ (queue 231: sendmsg's reentrant buffer), its view taken as Py_buffer is"] [800 5 "// Go's Accept4 refuses the family it has no Sockaddr of; C's accept of AF_ALG has no address"] [824 25 "// the GIL released while it blocks (PY6f's allowThreads; queue 200, PY6-core)"] [1148 5 "// any sequence of length 3, as PySequence_Fast takes it (queue 231: test_aead_aes_gcm's lists)"] [1658 21 "// NI_NUMERICHOST"] [1661 29 "// NI_NAMEREQD"] [1666 21 "// NI_NUMERICSERV"] [1668 23 "// NI_DGRAM"] [1851 4 "// CPython's get_CMSG_LEN and get_CMSG_SPACE: the length at most socklen_t's limit less CMSG_LEN(0),"] [1852 4 "// or less CMSG_SPACE(1)"] [1868 1 "// hostsName is /etc/hosts' canonical name of an address, \"\" when none."] [1936 1 "// getaddrinfo is musl's: the host's addresses (numeric, /etc/hosts; None: loopback, or any with AI_PASSIVE) times"] [1937 1 "// the socket types asked (0: stream and datagram), canonname always set as musl sets it."] [1945 32 "// AI_NUMERICSERV"] [1970 21 "// AI_PASSIVE"]] :go/pos {:name [3 9] :package [3 1]} :go/semis [[45 27] [48 34] [103 40] [176 46] [279 39] [309 36] [321 36] [325 29] [327 30] [387 12] [387 21] [397 12] [397 21] [432 53] [510 36] [518 44] [520 42] [570 34] [578 24] [582 34] [586 26] [594 24] [721 31] [732 48] [743 49] [762 42] [772 36] [789 43] [845 36] [853 45] [869 48] [888 42] [911 45] [947 36] [988 42] [1007 46] [1051 33] [1080 45] [1089 37] [1108 50] [1114 37] [1131 45] [1142 5] [1179 6] [1189 51] [1209 46] [1216 41] [1255 79] [1260 31] [1261 65] [1270 53] [1276 48] [1351 35] [1354 39] [1389 30] [1412 50] [1440 43] [1571 41] [1600 24] [1649 38] [1650 44] [1659 27] [1671 38] [1738 40] [1768 40] [1789 37] [1814 29] [1816 38] [1893 39] [1943 37] [1954 39] [1983 50] [2023 27] [2024 43] [2026 41]]} (go/file "builtins_socket.go" :build ["//go:build linux"] :imports [



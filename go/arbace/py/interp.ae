(in-ns 'go.arbace.py) ^{:go/comments [[13 1 "// Interp is an interpreter (PyInterpreterState): its builtins, its modules (sys.modules), its standard"] [14 1 "// streams and its recursion limit."] [21 2 "// replExit is the SystemExit that ended the REPL's loop (replLoop), which sys._baserepl raises on (queue 298)"] [23 2 "// displaying is set while traceback's display runs (displayByTraceback): an error displayed meanwhile takes the Go"] [24 2 "// display"] [26 2 "// xi is the interpreter's state for PEP 734 (interpreters.go, queue 230)"] [28 2 "// sysMod is the interpreter's sys module (interp->sysdict's), kept when sys.modules no longer has it (queue 253)"] [30 2 "// builtinsCopy is interp->builtins_copy, the builtins finalize_modules restores (queue 253)"] [32 2 "// finalPhase is the end's progress (pylifecycle.go, queue 253): 0 running, 1 finalizing (sys.is_finalizing()),"] [33 2 "// 2 the modules out of sys.modules (imports fail, no source lines in tracebacks)"] [35 2 "// final is what the end keeps of the warnings module (_warnings' state)"] [39 1 "// NewInterp is a fresh interpreter writing to stdout and stderr."] [52 1 "// startXOptions are the -X options of the command line (queue 220): bin/pyi python passes them in PYI_XOPTIONS, one"] [53 1 "// per line, NAME or NAME=VALUE; read once and removed from the environment (a child of the program does not inherit"] [54 1 "// them, as -X is not inherited)."] [74 1 "// startEnv is os.Getenv of a PYTHON* variable at start: \"\" under -E or -I (bin/pyi python's PYI_IGNORE_ENV, read once"] [75 1 "// and removed from the environment as PYI_XOPTIONS is)."] [92 2 "// atStartHooks run before the main module (Py_InitializeMain's late steps: queue 220, faulthandler's enable for"] [93 2 "// -X faulthandler and PYTHONFAULTHANDLER); an error is printed and the run's status is 1"] [97 1 "// startInspect is -i (bin/pyi python's PYI_INSPECT, queue 289, read once and removed from the environment as"] [98 1 "// PYI_SAFE_PATH is): 0 without it, 1 for -i, 2 for -i with no code to run (CPython's REPL on stdin, its banner but"] [99 1 "// under -q). PYTHONINSPECT at start (but under -E or -I) sets sys.flags.inspect, not interactive, as config's inspect."] [122 1 "// inspectAfter is pymain_repl's test (Modules/main.c): the REPL after the main module when -i was given or"] [123 1 "// PYTHONINSPECT is set (at start, or in the environment the program leaves), stdin a terminal or -i given."] [132 1 "// endMain is the main module's end with its status: Py_FinalizeEx's, or under -i the REPL on stdin in __main__'s"] [133 1 "// namespace (pymain_repl; the module's exception, SystemExit's too, printed before it), whose status is the run's."] [142 2 "// pymain_set_inspect(config, 0) before the REPL: sys.flags.inspect 0 in it (sys made first: an empty main module"] [143 2 "// has not made it)"] [149 3 "// no code to run: the REPL is the run, its __main__ the empty stdin module's without a __file__"] [154 21 "// stderr unbuffered, as CPython's: the banner before the hook's and _pyrepl's imports (queue 298)"] [161 2 "// sys.__interactivehook__ (pymain_run_interactive_hook; queue 298: site's register_readline, the history file)"] [165 2 "// on a terminal, _pyrepl (pymain_run_pyrepl; queue 298): pythonstartup after code (pymain_repl), not on stdin's run"] [166 2 "// (pymain_run_stdin ran the startup file above)"] [173 1 "// runInteractiveHook is pymain_run_interactive_hook (Modules/main.c; queue 298), before the REPL: sys.__interactivehook__"] [174 1 "// called when sys has one (site's register_readline: readline's or _pyrepl's history file read, its write at exit"] [175 1 "// registered); an error is \"Failed calling sys.__interactivehook__\" and printed, the session going on, but SystemExit,"] [176 1 "// whose status ends the run (exit true), as pymain_err_print."] [181 2 "// site, which CPython imports at start (pyi does not): imported here, before the REPL, so that its main sets the hook"] [182 2 "// (enablerlcompleter, but under -I)"] [206 1 "// runStartup is pymain_run_startup (Modules/main.c; queue 293), before the REPL on stdin when there is no code to run:"] [207 1 "// the file PYTHONSTARTUP names (not under -E or -I) run in __main__'s namespace g as _PyRun_SimpleFileObject runs it,"] [208 1 "// its __file__ set for the run, an error printed (sys.excepthook) and the session going on; SystemExit ends the run"] [209 1 "// with its status (exit true), as PyErr_Print's handle_system_exit; a file that does not open: \"Could not open"] [210 1 "// PYTHONSTARTUP\" and its OSError printed."] [253 1 "// cModeFile is the file bin/pyi python writes -c's code into (queue 220): run as CPython runs -c, its code's file"] [254 1 "// \"<string>\", no __file__, sys.path[0] \"\"."] [257 1 "// mModeFile and stdinModeFile are the files bin/pyi python writes for -m and for a program read from stdin (queue 250)."] [263 1 "// startSafePath is -P (safe_path) as bin/pyi python's command line gave it (PYI_SAFE_PATH: 1 under -P or -I, 0"] [264 1 "// without, read once and removed from the environment as PYI_IGNORE_ENV is); -1 when not run by bin/pyi python (bin/pyi"] [265 1 "// run's programs and the check's driver, whose sys.flags.safe_path is the reference driver's -P)."] [266 1 "// startIsolated is -I (bin/pyi python's PYI_ISOLATED, queue 298, read once and removed as PYI_SAFE_PATH is): 1 or 0,"] [267 1 "// sys.flags.isolated."] [303 1 "// ExecModule runs a module's code object as the module name (its namespace's __name__), returning"] [304 1 "// the module, or the uncaught exception."] [309 1 "// PrintException writes an uncaught exception as CPython's default excepthook does"] [310 1 "// (Lib/traceback.py's format): the chain first (__cause__, else __context__ unless suppressed), each"] [311 1 "// with its traceback (the file, line and function, and the source line when the file reads) and"] [312 1 "// \"Type: text\", a SyntaxError's location and caret, the notes. Carets under expressions are not"] [313 1 "// printed (PY5b: a recorded difference)."] [314 1 "//"] [315 1 "// The text goes to sys.stderr (PyErr_Display's file): the process's standard error while sys.stderr is"] [316 1 "// the one it started with, else the text is written by sys.stderr.write and flushed (support.captured_stderr),"] [317 1 "// nothing when sys.stderr is None or missing, write's errors ignored."] [331 1 "// PrintUncaught is PyErr_Print (Python/pythonrun.c's _PyErr_PrintEx with set_sys_last_vars, queue 223): an uncaught"] [332 1 "// exception, not SystemExit, stored as sys.last_exc, last_type, last_value and last_traceback, then given to"] [333 1 "// sys.excepthook(type, value, traceback); \"sys.excepthook is missing\" and the display when it is absent or None; when"] [334 1 "// the hook raises, \"Error in sys.excepthook:\", that error's display, then \"Original exception was:\" and the original's."] [341 22 "// after the main module's run: the hook runs on the main thread"] [369 1 "// registerCode is run_mod's interactive source (Python/pythonrun.c, queue 223): -c's code and its nested code objects"] [370 1 "// registered by linecache._register_code(code, source, name), so traceback's display shows -c's lines; an error dropped."] [384 1 "// displayByTraceback is _PyErr_Display's first way (Python/pythonrun.c, queue 223): the stdlib's"] [385 1 "// traceback._print_exception_bltin(exc), Lib/traceback.py's display with its caret lines (PEP 657's positions,"] [386 1 "// co_positions), chains, groups and notes; false when the module or its function is missing or the call raised (the"] [387 1 "// error dropped, as PyErr_Clear), the caller then printing the Go display (print_exception_recursive's fallback)."] [388 1 "// Not while traceback itself is being imported or displaying (a second error then printed by the fallback)."] [420 1 "// writeStderr writes text to sys.stderr: in.Stderr when it is the original stream."] [460 4 "// at shutdown CPython's display reads no source (the import of io fails: queue 253)"] [469 1 "// FormatExceptionOnly is traceback.format_exception_only's text: a SyntaxError's location, source"] [470 1 "// line and caret, then \"Type: text\" (the type qualified by its module unless builtins), then the notes."] [475 23 "// traceback's stype: the module unless __main__ or builtins"] [479 3 "// str(exc) (traceback's _safe_string): a class's own __str__"] [559 1 "// RegisterSource gives sourceLine the text of a source that is no file (\"<stdin>\", \"<string>\"): the"] [560 1 "// REPL's statements, as linecache keeps them (PY5e's REQUEST, part 2a). A later text replaces it."] [565 1 "// sourceLine is the stripped text of line n of the file, \"\" when it does not read (linecache)."] [587 1 "// RunModule reads a module's IR (arbace.python.compile's code object as pr-str prints it) and runs it"] [588 1 "// as __main__ with file as __file__, on the process's stdout and stderr; the exit status: 0, 1 for an"] [589 1 "// uncaught exception (its traceback on stderr), SystemExit's code. bin/pyi run calls it."] [590 1 "// mainSourceError is the main file's decoding error as the tokenizer reports a file it reads, the file named"] [591 1 "// (helpers.c's \" in file FILE\", as arbace.python.run/error-answer gives pyi on goi's; queue 284: the compiled"] [592 1 "// launcher's main module, which RunModule decodes): nil when its bytes decode."] [616 2 "// ir is the compiler's answer when the main module does not compile (queue 223): its SyntaxError raised as"] [617 2 "// compile() raises it and given to sys.excepthook, as CPython's pymain_run_file reports it"] [621 37 "// the reader's warnings, emitted once the interpreter stands (queue 228)"] [626 3 "// the coding spec is a codec of Python's the host has no charset for: decoded and compiled below"] [637 2 "// sys.path[0] as CPython's config computes sys_path_0 (sys is made from configPath on its first use; queue 250):"] [638 2 "// none under -P (safe_path), \"\" for -c and stdin, the working directory for -m, else the script's directory"] [713 4 "// a file's parser has no source string (tok->str NULL): _metadata's source None, traceback reads the file"] [728 3 "// -c's sys.path[0] \"\" (none under -P: the first entry is then the standard library's; queue 250)"] [743 22 "// handle_system_exit drops the exception before Py_FinalizeEx"] [756 2 "// Py_FinalizeEx (pylifecycle.go, queue 253): threading._shutdown, the atexit functions, the modules' end; under -i"] [757 2 "// the REPL first (queue 289)"] [761 1 "// ExecModuleFile is ExecModule with __file__."] [783 1 "// runIn runs code as a module's body in the namespace g."] [786 44 "// an inlined comprehension's hidden locals"] [798 1 "// systemExitStatus is handle_system_exit's exit status (pythonrun.c): the exception's code (its one argument, the tuple"] [799 1 "// of several), None 0, an int as C's int (a value beyond long, or an int that wraps, -1: status 255), else its str on"] [800 1 "// stderr and 1 (queue 242: the code of several arguments was their first one; an int out of range was kept whole)."] [824 4 "// written with the stream's encoding and errors (queue 242: backslashreplace, PYTHONIOENCODING)"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[139 53] [145 47] [157 38] [162 44] [167 51] [184 39] [194 35] [196 28] [217 33] [224 43] [243 27] [320 27] [361 53] [379 52] [407 41] [410 45] [411 29] [412 45] [423 28] [430 48] [433 43] [449 24] [449 35] [452 62] [461 37] [480 24] [500 47] [504 52] [507 56] [508 28] [512 56] [522 45] [533 24] [535 32] [606 20] [628 40] [632 34] [648 28] [658 18] [673 34] [679 44] [712 29] [714 50] [724 35] [729 52] [730 48] [741 28] [777 43] [813 25] [823 49]]} (go/file "interp.go" :imports [



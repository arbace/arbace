(in-ns 'go.arbace.py) ^{:go/comments [[13 1 "// Interp is an interpreter (PyInterpreterState): its builtins, its modules (sys.modules), its standard"] [14 1 "// streams and its recursion limit."] [21 2 "// replExit is the SystemExit that ended the REPL's loop (replLoop), which sys._baserepl raises on (queue 298)"] [23 2 "// displaying is set while traceback's display runs (displayByTraceback): an error displayed meanwhile takes the Go"] [24 2 "// display"] [26 2 "// xi is the interpreter's state for PEP 734 (interpreters.go, queue 230)"] [28 2 "// sysMod is the interpreter's sys module (interp->sysdict's), kept when sys.modules no longer has it (queue 253)"] [30 2 "// builtinsCopy is interp->builtins_copy, the builtins finalize_modules restores (queue 253)"] [32 2 "// finalPhase is the end's progress (pylifecycle.go, queue 253): 0 running, 1 finalizing (sys.is_finalizing()),"] [33 2 "// 2 the modules out of sys.modules (imports fail, no source lines in tracebacks)"] [35 2 "// final is what the end keeps of the warnings module (_warnings' state)"] [39 1 "// NewInterp is a fresh interpreter writing to stdout and stderr."] [52 1 "// startXOptions are the -X options of the command line (queue 220): bin/pyi python passes them in PYI_XOPTIONS, one"] [53 1 "// per line, NAME or NAME=VALUE; read once and removed from the environment (a child of the program does not inherit"] [54 1 "// them, as -X is not inherited)."] [74 1 "// startEnv is os.Getenv of a PYTHON* variable at start: \"\" under -E or -I (bin/pyi python's PYI_IGNORE_ENV, read once"] [75 1 "// and removed from the environment as PYI_XOPTIONS is)."] [92 2 "// atStartHooks run before the main module (Py_InitializeMain's late steps: queue 220, faulthandler's enable for"] [93 2 "// -X faulthandler and PYTHONFAULTHANDLER); an error is printed and the run's status is 1"] [97 1 "// startInspect is -i (bin/pyi python's PYI_INSPECT, queue 289, read once and removed from the environment as"] [98 1 "// PYI_SAFE_PATH is): 0 without it, 1 for -i, 2 for -i with no code to run (CPython's REPL on stdin, its banner but"] [99 1 "// under -q). PYTHONINSPECT at start (but under -E or -I) sets sys.flags.inspect, not interactive, as config's inspect."] [122 1 "// inspectAfter is pymain_repl's test (Modules/main.c): the REPL after the main module when -i was given or"] [123 1 "// PYTHONINSPECT is set (at start, or in the environment the program leaves), stdin a terminal or -i given."] [132 1 "// endMain is the main module's end with its status: Py_FinalizeEx's, or under -i the REPL on stdin in __main__'s"] [133 1 "// namespace (pymain_repl; the module's exception, SystemExit's too, printed before it), whose status is the run's."] [142 2 "// pymain_set_inspect(config, 0) before the REPL: sys.flags.inspect 0 in it (sys made first: an empty main module"] [143 2 "// has not made it)"] [149 3 "// no code to run: the REPL is the run, its __main__ the empty stdin module's without a __file__"] [160 2 "// sys.__interactivehook__ (pymain_run_interactive_hook; queue 298: site's register_readline, the history file)"] [164 2 "// on a terminal, _pyrepl (pymain_run_pyrepl; queue 298): pythonstartup after code (pymain_repl), not on stdin's run"] [165 2 "// (pymain_run_stdin ran the startup file above)"] [172 1 "// runInteractiveHook is pymain_run_interactive_hook (Modules/main.c; queue 298), before the REPL: sys.__interactivehook__"] [173 1 "// called when sys has one (site's register_readline: readline's or _pyrepl's history file read, its write at exit"] [174 1 "// registered); an error is \"Failed calling sys.__interactivehook__\" and printed, the session going on, but SystemExit,"] [175 1 "// whose status ends the run (exit true), as pymain_err_print."] [180 2 "// site, which CPython imports at start (pyi does not): imported here, before the REPL, so that its main sets the hook"] [181 2 "// (enablerlcompleter, but under -I)"] [205 1 "// runStartup is pymain_run_startup (Modules/main.c; queue 293), before the REPL on stdin when there is no code to run:"] [206 1 "// the file PYTHONSTARTUP names (not under -E or -I) run in __main__'s namespace g as _PyRun_SimpleFileObject runs it,"] [207 1 "// its __file__ set for the run, an error printed (sys.excepthook) and the session going on; SystemExit ends the run"] [208 1 "// with its status (exit true), as PyErr_Print's handle_system_exit; a file that does not open: \"Could not open"] [209 1 "// PYTHONSTARTUP\" and its OSError printed."] [252 1 "// cModeFile is the file bin/pyi python writes -c's code into (queue 220): run as CPython runs -c, its code's file"] [253 1 "// \"<string>\", no __file__, sys.path[0] \"\"."] [256 1 "// mModeFile and stdinModeFile are the files bin/pyi python writes for -m and for a program read from stdin (queue 250)."] [262 1 "// startSafePath is -P (safe_path) as bin/pyi python's command line gave it (PYI_SAFE_PATH: 1 under -P or -I, 0"] [263 1 "// without, read once and removed from the environment as PYI_IGNORE_ENV is); -1 when not run by bin/pyi python (bin/pyi"] [264 1 "// run's programs and the check's driver, whose sys.flags.safe_path is the reference driver's -P)."] [265 1 "// startIsolated is -I (bin/pyi python's PYI_ISOLATED, queue 298, read once and removed as PYI_SAFE_PATH is): 1 or 0,"] [266 1 "// sys.flags.isolated."] [302 1 "// ExecModule runs a module's code object as the module name (its namespace's __name__), returning"] [303 1 "// the module, or the uncaught exception."] [308 1 "// PrintException writes an uncaught exception as CPython's default excepthook does"] [309 1 "// (Lib/traceback.py's format): the chain first (__cause__, else __context__ unless suppressed), each"] [310 1 "// with its traceback (the file, line and function, and the source line when the file reads) and"] [311 1 "// \"Type: text\", a SyntaxError's location and caret, the notes. Carets under expressions are not"] [312 1 "// printed (PY5b: a recorded difference)."] [313 1 "//"] [314 1 "// The text goes to sys.stderr (PyErr_Display's file): the process's standard error while sys.stderr is"] [315 1 "// the one it started with, else the text is written by sys.stderr.write and flushed (support.captured_stderr),"] [316 1 "// nothing when sys.stderr is None or missing, write's errors ignored."] [330 1 "// PrintUncaught is PyErr_Print (Python/pythonrun.c's _PyErr_PrintEx with set_sys_last_vars, queue 223): an uncaught"] [331 1 "// exception, not SystemExit, stored as sys.last_exc, last_type, last_value and last_traceback, then given to"] [332 1 "// sys.excepthook(type, value, traceback); \"sys.excepthook is missing\" and the display when it is absent or None; when"] [333 1 "// the hook raises, \"Error in sys.excepthook:\", that error's display, then \"Original exception was:\" and the original's."] [340 22 "// after the main module's run: the hook runs on the main thread"] [368 1 "// registerCode is run_mod's interactive source (Python/pythonrun.c, queue 223): -c's code and its nested code objects"] [369 1 "// registered by linecache._register_code(code, source, name), so traceback's display shows -c's lines; an error dropped."] [383 1 "// displayByTraceback is _PyErr_Display's first way (Python/pythonrun.c, queue 223): the stdlib's"] [384 1 "// traceback._print_exception_bltin(exc), Lib/traceback.py's display with its caret lines (PEP 657's positions,"] [385 1 "// co_positions), chains, groups and notes; false when the module or its function is missing or the call raised (the"] [386 1 "// error dropped, as PyErr_Clear), the caller then printing the Go display (print_exception_recursive's fallback)."] [387 1 "// Not while traceback itself is being imported or displaying (a second error then printed by the fallback)."] [419 1 "// writeStderr writes text to sys.stderr: in.Stderr when it is the original stream."] [459 4 "// at shutdown CPython's display reads no source (the import of io fails: queue 253)"] [468 1 "// FormatExceptionOnly is traceback.format_exception_only's text: a SyntaxError's location, source"] [469 1 "// line and caret, then \"Type: text\" (the type qualified by its module unless builtins), then the notes."] [474 23 "// traceback's stype: the module unless __main__ or builtins"] [478 3 "// str(exc) (traceback's _safe_string): a class's own __str__"] [558 1 "// RegisterSource gives sourceLine the text of a source that is no file (\"<stdin>\", \"<string>\"): the"] [559 1 "// REPL's statements, as linecache keeps them (PY5e's REQUEST, part 2a). A later text replaces it."] [564 1 "// sourceLine is the stripped text of line n of the file, \"\" when it does not read (linecache)."] [586 1 "// RunModule reads a module's IR (arbace.python.compile's code object as pr-str prints it) and runs it"] [587 1 "// as __main__ with file as __file__, on the process's stdout and stderr; the exit status: 0, 1 for an"] [588 1 "// uncaught exception (its traceback on stderr), SystemExit's code. bin/pyi run calls it."] [589 1 "// mainSourceError is the main file's decoding error as the tokenizer reports a file it reads, the file named"] [590 1 "// (helpers.c's \" in file FILE\", as arbace.python.run/error-answer gives pyi on goi's; queue 284: the compiled"] [591 1 "// launcher's main module, which RunModule decodes): nil when its bytes decode."] [615 2 "// ir is the compiler's answer when the main module does not compile (queue 223): its SyntaxError raised as"] [616 2 "// compile() raises it and given to sys.excepthook, as CPython's pymain_run_file reports it"] [620 37 "// the reader's warnings, emitted once the interpreter stands (queue 228)"] [625 3 "// the coding spec is a codec of Python's the host has no charset for: decoded and compiled below"] [636 2 "// sys.path[0] as CPython's config computes sys_path_0 (sys is made from configPath on its first use; queue 250):"] [637 2 "// none under -P (safe_path), \"\" for -c and stdin, the working directory for -m, else the script's directory"] [712 4 "// a file's parser has no source string (tok->str NULL): _metadata's source None, traceback reads the file"] [727 3 "// -c's sys.path[0] \"\" (none under -P: the first entry is then the standard library's; queue 250)"] [742 22 "// handle_system_exit drops the exception before Py_FinalizeEx"] [755 2 "// Py_FinalizeEx (pylifecycle.go, queue 253): threading._shutdown, the atexit functions, the modules' end; under -i"] [756 2 "// the REPL first (queue 289)"] [760 1 "// ExecModuleFile is ExecModule with __file__."] [782 1 "// runIn runs code as a module's body in the namespace g."] [785 44 "// an inlined comprehension's hidden locals"] [797 1 "// systemExitStatus is handle_system_exit's exit status (pythonrun.c): the exception's code (its one argument, the tuple"] [798 1 "// of several), None 0, an int as C's int (a value beyond long, or an int that wraps, -1: status 255), else its str on"] [799 1 "// stderr and 1 (queue 242: the code of several arguments was their first one; an int out of range was kept whole)."] [823 4 "// written with the stream's encoding and errors (queue 242: backslashreplace, PYTHONIOENCODING)"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[139 53] [145 47] [156 38] [161 44] [166 51] [183 39] [193 35] [195 28] [216 33] [223 43] [242 27] [319 27] [360 53] [378 52] [406 41] [409 45] [410 29] [411 45] [422 28] [429 48] [432 43] [448 24] [448 35] [451 62] [460 37] [479 24] [499 47] [503 52] [506 56] [507 28] [511 56] [521 45] [532 24] [534 32] [605 20] [627 40] [631 34] [647 28] [657 18] [672 34] [678 44] [711 29] [713 50] [723 35] [728 52] [729 48] [740 28] [776 43] [812 25] [822 49]]} (go/file "interp.go" :imports [



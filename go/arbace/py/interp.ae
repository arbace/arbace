(in-ns 'go.arbace.py) ^{:go/comments [[13 1 "// Interp is an interpreter (PyInterpreterState): its builtins, its modules (sys.modules), its standard"] [14 1 "// streams and its recursion limit."] [21 2 "// displaying is set while traceback's display runs (displayByTraceback): an error displayed meanwhile takes the Go"] [22 2 "// display"] [24 2 "// xi is the interpreter's state for PEP 734 (interpreters.go, queue 230)"] [26 2 "// sysMod is the interpreter's sys module (interp->sysdict's), kept when sys.modules no longer has it (queue 253)"] [28 2 "// builtinsCopy is interp->builtins_copy, the builtins finalize_modules restores (queue 253)"] [30 2 "// finalPhase is the end's progress (pylifecycle.go, queue 253): 0 running, 1 finalizing (sys.is_finalizing()),"] [31 2 "// 2 the modules out of sys.modules (imports fail, no source lines in tracebacks)"] [33 2 "// final is what the end keeps of the warnings module (_warnings' state)"] [37 1 "// NewInterp is a fresh interpreter writing to stdout and stderr."] [50 1 "// startXOptions are the -X options of the command line (queue 220): bin/pyi python passes them in PYI_XOPTIONS, one"] [51 1 "// per line, NAME or NAME=VALUE; read once and removed from the environment (a child of the program does not inherit"] [52 1 "// them, as -X is not inherited)."] [72 1 "// startEnv is os.Getenv of a PYTHON* variable at start: \"\" under -E or -I (bin/pyi python's PYI_IGNORE_ENV, read once"] [73 1 "// and removed from the environment as PYI_XOPTIONS is)."] [90 2 "// atStartHooks run before the main module (Py_InitializeMain's late steps: queue 220, faulthandler's enable for"] [91 2 "// -X faulthandler and PYTHONFAULTHANDLER); an error is printed and the run's status is 1"] [95 1 "// cModeFile is the file bin/pyi python writes -c's code into (queue 220): run as CPython runs -c, its code's file"] [96 1 "// \"<string>\", no __file__, sys.path[0] \"\"."] [99 1 "// mModeFile and stdinModeFile are the files bin/pyi python writes for -m and for a program read from stdin (queue 250)."] [105 1 "// startSafePath is -P (safe_path) as bin/pyi python's command line gave it (PYI_SAFE_PATH: 1 under -P or -I, 0"] [106 1 "// without, read once and removed from the environment as PYI_IGNORE_ENV is); -1 when not run by bin/pyi python (bin/pyi"] [107 1 "// run's programs and the check's driver, whose sys.flags.safe_path is the reference driver's -P)."] [128 1 "// ExecModule runs a module's code object as the module name (its namespace's __name__), returning"] [129 1 "// the module, or the uncaught exception."] [134 1 "// PrintException writes an uncaught exception as CPython's default excepthook does"] [135 1 "// (Lib/traceback.py's format): the chain first (__cause__, else __context__ unless suppressed), each"] [136 1 "// with its traceback (the file, line and function, and the source line when the file reads) and"] [137 1 "// \"Type: text\", a SyntaxError's location and caret, the notes. Carets under expressions are not"] [138 1 "// printed (PY5b: a recorded difference)."] [139 1 "//"] [140 1 "// The text goes to sys.stderr (PyErr_Display's file): the process's standard error while sys.stderr is"] [141 1 "// the one it started with, else the text is written by sys.stderr.write and flushed (support.captured_stderr),"] [142 1 "// nothing when sys.stderr is None or missing, write's errors ignored."] [156 1 "// PrintUncaught is PyErr_Print (Python/pythonrun.c's _PyErr_PrintEx with set_sys_last_vars, queue 223): an uncaught"] [157 1 "// exception, not SystemExit, stored as sys.last_exc, last_type, last_value and last_traceback, then given to"] [158 1 "// sys.excepthook(type, value, traceback); \"sys.excepthook is missing\" and the display when it is absent or None; when"] [159 1 "// the hook raises, \"Error in sys.excepthook:\", that error's display, then \"Original exception was:\" and the original's."] [166 22 "// after the main module's run: the hook runs on the main thread"] [194 1 "// registerCode is run_mod's interactive source (Python/pythonrun.c, queue 223): -c's code and its nested code objects"] [195 1 "// registered by linecache._register_code(code, source, name), so traceback's display shows -c's lines; an error dropped."] [209 1 "// displayByTraceback is _PyErr_Display's first way (Python/pythonrun.c, queue 223): the stdlib's"] [210 1 "// traceback._print_exception_bltin(exc), Lib/traceback.py's display with its caret lines (PEP 657's positions,"] [211 1 "// co_positions), chains, groups and notes; false when the module or its function is missing or the call raised (the"] [212 1 "// error dropped, as PyErr_Clear), the caller then printing the Go display (print_exception_recursive's fallback)."] [213 1 "// Not while traceback itself is being imported or displaying (a second error then printed by the fallback)."] [245 1 "// writeStderr writes text to sys.stderr: in.Stderr when it is the original stream."] [285 4 "// at shutdown CPython's display reads no source (the import of io fails: queue 253)"] [294 1 "// FormatExceptionOnly is traceback.format_exception_only's text: a SyntaxError's location, source"] [295 1 "// line and caret, then \"Type: text\" (the type qualified by its module unless builtins), then the notes."] [300 23 "// traceback's stype: the module unless __main__ or builtins"] [304 3 "// str(exc) (traceback's _safe_string): a class's own __str__"] [384 1 "// RegisterSource gives sourceLine the text of a source that is no file (\"<stdin>\", \"<string>\"): the"] [385 1 "// REPL's statements, as linecache keeps them (PY5e's REQUEST, part 2a). A later text replaces it."] [390 1 "// sourceLine is the stripped text of line n of the file, \"\" when it does not read (linecache)."] [412 1 "// RunModule reads a module's IR (arbace.python.compile's code object as pr-str prints it) and runs it"] [413 1 "// as __main__ with file as __file__, on the process's stdout and stderr; the exit status: 0, 1 for an"] [414 1 "// uncaught exception (its traceback on stderr), SystemExit's code. bin/pyi run calls it."] [415 1 "// mainSourceError is the main file's decoding error as the tokenizer reports a file it reads, the file named"] [416 1 "// (helpers.c's \" in file FILE\", as arbace.python.run/error-answer gives pyi on goi's; queue 284: the compiled"] [417 1 "// launcher's main module, which RunModule decodes): nil when its bytes decode."] [441 2 "// ir is the compiler's answer when the main module does not compile (queue 223): its SyntaxError raised as"] [442 2 "// compile() raises it and given to sys.excepthook, as CPython's pymain_run_file reports it"] [446 37 "// the reader's warnings, emitted once the interpreter stands (queue 228)"] [451 3 "// the coding spec is a codec of Python's the host has no charset for: decoded and compiled below"] [462 2 "// sys.path[0] as CPython's config computes sys_path_0 (sys is made from configPath on its first use; queue 250):"] [463 2 "// none under -P (safe_path), \"\" for -c and stdin, the working directory for -m, else the script's directory"] [538 4 "// a file's parser has no source string (tok->str NULL): _metadata's source None, traceback reads the file"] [553 3 "// -c's sys.path[0] \"\" (none under -P: the first entry is then the standard library's; queue 250)"] [568 22 "// handle_system_exit drops the exception before Py_FinalizeEx"] [581 2 "// Py_FinalizeEx (pylifecycle.go, queue 253): threading._shutdown, the atexit functions, the modules' end"] [585 1 "// ExecModuleFile is ExecModule with __file__."] [605 44 "// an inlined comprehension's hidden locals"] [617 1 "// systemExitStatus is handle_system_exit's exit status (pythonrun.c): the exception's code (its one argument, the tuple"] [618 1 "// of several), None 0, an int as C's int (a value beyond long, or an int that wraps, -1: status 255), else its str on"] [619 1 "// stderr and 1 (queue 242: the code of several arguments was their first one; an int out of range was kept whole)."] [643 4 "// written with the stream's encoding and errors (queue 242: backslashreplace, PYTHONIOENCODING)"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[145 27] [186 53] [204 52] [232 41] [235 45] [236 29] [237 45] [248 28] [255 48] [258 43] [274 24] [274 35] [277 62] [286 37] [305 24] [325 47] [329 52] [332 56] [333 28] [337 56] [347 45] [358 24] [360 32] [431 20] [453 40] [457 34] [473 28] [483 18] [498 34] [504 44] [537 29] [539 50] [549 35] [554 52] [555 48] [566 28] [601 43] [632 25] [642 49]]} (go/file "interp.go" :imports [



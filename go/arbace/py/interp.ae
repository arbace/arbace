(in-ns 'go.arbace.py) ^{:go/comments [[12 1 "// Interp is an interpreter (PyInterpreterState): its builtins, its modules (sys.modules), its standard"] [13 1 "// streams and its recursion limit."] [20 2 "// displaying is set while traceback's display runs (displayByTraceback): an error displayed meanwhile takes the Go"] [21 2 "// display"] [23 2 "// xi is the interpreter's state for PEP 734 (interpreters.go, queue 230)"] [27 1 "// NewInterp is a fresh interpreter writing to stdout and stderr."] [39 1 "// startXOptions are the -X options of the command line (queue 220): bin/pyi python passes them in PYI_XOPTIONS, one"] [40 1 "// per line, NAME or NAME=VALUE; read once and removed from the environment (a child of the program does not inherit"] [41 1 "// them, as -X is not inherited)."] [61 1 "// startEnv is os.Getenv of a PYTHON* variable at start: \"\" under -E or -I (bin/pyi python's PYI_IGNORE_ENV, read once"] [62 1 "// and removed from the environment as PYI_XOPTIONS is)."] [79 2 "// atStartHooks run before the main module (Py_InitializeMain's late steps: queue 220, faulthandler's enable for"] [80 2 "// -X faulthandler and PYTHONFAULTHANDLER); an error is printed and the run's status is 1"] [84 1 "// cModeFile is the file bin/pyi python writes -c's code into (queue 220): run as CPython runs -c, its code's file"] [85 1 "// \"<string>\", no __file__, sys.path[0] \"\"."] [88 1 "// ExecModule runs a module's code object as the module name (its namespace's __name__), returning"] [89 1 "// the module, or the uncaught exception."] [94 1 "// PrintException writes an uncaught exception as CPython's default excepthook does"] [95 1 "// (Lib/traceback.py's format): the chain first (__cause__, else __context__ unless suppressed), each"] [96 1 "// with its traceback (the file, line and function, and the source line when the file reads) and"] [97 1 "// \"Type: text\", a SyntaxError's location and caret, the notes. Carets under expressions are not"] [98 1 "// printed (PY5b: a recorded difference)."] [99 1 "//"] [100 1 "// The text goes to sys.stderr (PyErr_Display's file): the process's standard error while sys.stderr is"] [101 1 "// the one it started with, else the text is written by sys.stderr.write and flushed (support.captured_stderr),"] [102 1 "// nothing when sys.stderr is None or missing, write's errors ignored."] [116 1 "// PrintUncaught is PyErr_Print (Python/pythonrun.c's _PyErr_PrintEx with set_sys_last_vars, queue 223): an uncaught"] [117 1 "// exception, not SystemExit, stored as sys.last_exc, last_type, last_value and last_traceback, then given to"] [118 1 "// sys.excepthook(type, value, traceback); \"sys.excepthook is missing\" and the display when it is absent or None; when"] [119 1 "// the hook raises, \"Error in sys.excepthook:\", that error's display, then \"Original exception was:\" and the original's."] [126 22 "// after the main module's run: the hook runs on the main thread"] [154 1 "// registerCode is run_mod's interactive source (Python/pythonrun.c, queue 223): -c's code and its nested code objects"] [155 1 "// registered by linecache._register_code(code, source, name), so traceback's display shows -c's lines; an error dropped."] [169 1 "// displayByTraceback is _PyErr_Display's first way (Python/pythonrun.c, queue 223): the stdlib's"] [170 1 "// traceback._print_exception_bltin(exc), Lib/traceback.py's display with its caret lines (PEP 657's positions,"] [171 1 "// co_positions), chains, groups and notes; false when the module or its function is missing or the call raised (the"] [172 1 "// error dropped, as PyErr_Clear), the caller then printing the Go display (print_exception_recursive's fallback)."] [173 1 "// Not while traceback itself is being imported or displaying (a second error then printed by the fallback)."] [205 1 "// writeStderr writes text to sys.stderr: in.Stderr when it is the original stream."] [253 1 "// FormatExceptionOnly is traceback.format_exception_only's text: a SyntaxError's location, source"] [254 1 "// line and caret, then \"Type: text\" (the type qualified by its module unless builtins), then the notes."] [259 23 "// traceback's stype: the module unless __main__ or builtins"] [263 3 "// str(exc) (traceback's _safe_string): a class's own __str__"] [343 1 "// RegisterSource gives sourceLine the text of a source that is no file (\"<stdin>\", \"<string>\"): the"] [344 1 "// REPL's statements, as linecache keeps them (PY5e's REQUEST, part 2a). A later text replaces it."] [349 1 "// sourceLine is the stripped text of line n of the file, \"\" when it does not read (linecache)."] [371 1 "// RunModule reads a module's IR (arbace.python.compile's code object as pr-str prints it) and runs it"] [372 1 "// as __main__ with file as __file__, on the process's stdout and stderr; the exit status: 0, 1 for an"] [373 1 "// uncaught exception (its traceback on stderr), SystemExit's code. bin/pyi run calls it."] [378 2 "// ir is the compiler's answer when the main module does not compile (queue 223): its SyntaxError raised as"] [379 2 "// compile() raises it and given to sys.excepthook, as CPython's pymain_run_file reports it"] [393 22 "// -c: sys.path[0] is \"\" (sys is made from configPath on its first use)"] [416 4 "// a file's parser has no source string (tok->str NULL): _metadata's source None, traceback reads the file"] [454 29 "// threading._shutdown: the non-daemon threads joined (Py_FinalizeEx, PY6f)"] [455 29 "// atexit's functions, as Py_FinalizeEx runs them (PY6a)"] [459 1 "// ExecModuleFile is ExecModule with __file__."] [479 44 "// an inlined comprehension's hidden locals"] [491 1 "// systemExitStatus is SystemExit's exit status: None 0, an int itself, else its str on stderr and 1."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[105 27] [146 53] [164 52] [192 41] [195 45] [196 29] [197 45] [208 28] [215 48] [218 43] [234 24] [234 35] [237 62] [245 37] [264 24] [284 47] [288 52] [291 56] [292 28] [296 56] [306 45] [317 24] [319 32] [383 40] [387 34] [40
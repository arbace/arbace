read (linecache)."] [220 1 "// RunModule reads a module's IR (arbace.python.compile's code object as pr-str prints it) and runs it"] [221 1 "// as __main__ with file as __file__, on the process's stdout and stderr; the exit status: 0, 1 for an"] [222 1 "// uncaught exception (its traceback on stderr), SystemExit's code. bin/pyi run calls it."] [247 29 "// threading._shutdown: the non-daemon threads joined (Py_FinalizeEx, PY6f)"] [248 29 "// atexit's functions, as Py_FinalizeEx runs them (PY6a)"] [252 1 "// ExecModuleFile is ExecModule with __file__."] [272 44 "// an inlined comprehension's hidden locals"] [284 1 "// systemExitStatus is SystemExit's exit status: None 0, an int itself, else its str on stderr and 1."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[46 27] [57 28] [64 48] [67 43] [83 24] [83 35] [86 62] [94 37] [113 24] [133 47] [137 52] [140 56] [141 28] [145 56] [155 45] [166 24] [168 32] [236 28] [268 43] [289 36]]} (go/file "interp.go" :imports [



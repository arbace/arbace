(in-ns 'go.arbace.py) ^{:go/comments [[12 1 "// Interp is an interpreter (PyInterpreterState): its builtins, its modules (sys.modules), its standard"] [13 1 "// streams and its recursion limit."] [20 2 "// displaying is set while traceback's display runs (displayByTraceback): an error displayed meanwhile takes the Go"] [21 2 "// display"] [25 1 "// NewInterp is a fresh interpreter writing to stdout and stderr."] [35 1 "// startXOptions are the -X options of the command line (queue 220): bin/pyi python passes them in PYI_XOPTIONS, one"] [36 1 "// per line, NAME or NAME=VALUE; read once and removed from the environment (a child of the program does not inherit"] [37 1 "// them, as -X is not inherited)."] [57 1 "// startEnv is os.Getenv of a PYTHON* variable at start: \"\" under -E or -I (bin/pyi python's PYI_IGNORE_ENV, read once"] [58 1 "// and removed from the environment as PYI_XOPTIONS is)."] [75 2 "// atStartHooks run before the main module (Py_InitializeMain's late steps: queue 220, faulthandler's enable for"] [76 2 "// -X faulthandler and PYTHONFAULTHANDLER); an error is printed and the run's status is 1"] [80 1 "// cModeFile is the file bin/pyi python writes -c's code into (queue 220): run as CPython runs -c, its code's file"] [81 1 "// \"<string>\", no __file__, sys.path[0] \"\"."] [84 1 "// ExecModule runs a module's code object as the module name (its namespace's __name__), returning"] [85 1 "// the module, or the uncaught exception."] [90 1 "// PrintException writes an uncaught exception as CPython's default excepthook does"] [91 1 "// (Lib/traceback.py's format): the chain first (__cause__, else __context__ unless suppressed), each"] [92 1 "// with its traceback (the file, line and function, and the source line when the file reads) and"] [93 1 "// \"Type: text\", a SyntaxError's location and caret, the notes. Carets under expressions are not"] [94 1 "// printed (PY5b: a recorded difference)."] [95 1 "//"] [96 1 "// The text goes to sys.stderr (PyErr_Display's file): the process's standard error while sys.stderr is"] [97 1 "// the one it started with, else the text is written by sys.stderr.write and flushed (support.captured_stderr),"] [98 1 "// nothing when sys.stderr is None or missing, write's errors ignored."] [112 1 "// PrintUncaught is PyErr_Print (Python/pythonrun.c's _PyErr_PrintEx with set_sys_last_vars, queue 223): an uncaught"] [113 1 "// exception, not SystemExit, stored as sys.last_exc, last_type, last_value and last_traceback, then given to"] [114 1 "// sys.excepthook(type, value, traceback); \"sys.excepthook is missing\" and the display when it is absent or None; when"] [115 1 "// the hook raises, \"Error in sys.excepthook:\", that error's display, then \"Original exception was:\" and the original's."] [122 22 "// after the main module's run: the hook runs on the main thread"] [150 1 "// registerCode is run_mod's interactive source (Python/pythonrun.c, queue 223): -c's code and its nested code objects"] [151 1 "// registered by linecache._register_code(code, source, name), so traceback's display shows -c's lines; an error dropped."] [165 1 "// displayByTraceback is _PyErr_Display's first way (Python/pythonrun.c, queue 223): the stdlib's"] [166 1 "// traceback._print_exception_bltin(exc), Lib/traceback.py's display with its caret lines (PEP 657's positions,"] [167 1 "// co_positions), chains, groups and notes; false when the module or its function is missing or the call raised (the"] [168 1 "// error dropped, as PyErr_Clear), the caller then printing the Go display (print_exception_recursive's fallback)."] [169 1 "// Not while traceback itself is being imported or displaying (a second error then printed by the fallback)."] [201 1 "// writeStderr writes text to sys.stderr: in.Stderr when it is the original stream."] [249 1 "// FormatExceptionOnly is traceback.format_exception_only's text: a SyntaxError's location, source"] [250 1 "// line and caret, then \"Type: text\" (the type qualified by its module unless builtins), then the notes."] [255 23 "// traceback's stype: the module unless __main__ or builtins"] [259 3 "// str(exc) (traceback's _safe_string): a class's own __str__"] [339 1 "// RegisterSource gives sourceLine the text of a source that is no file (\"<stdin>\", \"<string>\"): the"] [340 1 "// REPL's statements, as linecache keeps them (PY5e's REQUEST, part 2a). A later text replaces it."] [345 1 "// sourceLine is the stripped text of line n of the file, \"\" when it does not read (linecache)."] [367 1 "// RunModule reads a module's IR (arbace.python.compile's code object as pr-str prints it) and runs it"] [368 1 "// as __main__ with file as __file__, on the process's stdout and stderr; the exit status: 0, 1 for an"] [369 1 "// uncaught exception (its traceback on stderr), SystemExit's code. bin/pyi run calls it."] [374 2 "// ir is the compiler's answer when the main module does not compile (queue 223): its SyntaxError raised as"] [375 2 "// compile() raises it and given to sys.excepthook, as CPython's pymain_run_file reports it"] [389 22 "// -c: sys.path[0] is \"\" (sys is made from configPath on its first use)"] [412 4 "// a file's parser has no source string (tok->str NULL): _metadata's source None, traceback reads the file"] [450 29 "// threading._shutdown: the non-daemon threads joined (Py_FinalizeEx, PY6f)"] [451 29 "// atexit's functions, as Py_FinalizeEx runs them (PY6a)"] [455 1 "// ExecModuleFile is ExecModule with __file__."] [475 44 "// an inlined comprehension's hidden locals"] [487 1 "// systemExitStatus is SystemExit's exit status: None 0, an int itself, else its str on stderr and 1."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[101 27] [142 53] [160 52] [188 41] [191 45] [192 29] [193 45] [204 28] [211 48] [214 43] [230 24] [230 35] [233 62] [241 37] [260 24] [280 47] [284 52] [287 56] [288 28] [292 56] [302 45] [313 24] [315 32] [379 40] [383 34] [396 18] [411 29] [413 50] [423 35] [427 52] [428 48] [439 28] [471 43] [492 36]]} (go/fi
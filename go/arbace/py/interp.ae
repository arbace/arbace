(in-ns 'go.arbace.py) ^{:go/comments [[13 1 "// Interp is an interpreter (PyInterpreterState): its builtins, its modules (sys.modules), its standard"] [14 1 "// streams and its recursion limit."] [21 2 "// displaying is set while traceback's display runs (displayByTraceback): an error displayed meanwhile takes the Go"] [22 2 "// display"] [24 2 "// xi is the interpreter's state for PEP 734 (interpreters.go, queue 230)"] [26 2 "// sysMod is the interpreter's sys module (interp->sysdict's), kept when sys.modules no longer has it (queue 253)"] [28 2 "// builtinsCopy is interp->builtins_copy, the builtins finalize_modules restores (queue 253)"] [30 2 "// finalPhase is the end's progress (pylifecycle.go, queue 253): 0 running, 1 finalizing (sys.is_finalizing()),"] [31 2 "// 2 the modules out of sys.modules (imports fail, no source lines in tracebacks)"] [33 2 "// final is what the end keeps of the warnings module (_warnings' state)"] [37 1 "// NewInterp is a fresh interpreter writing to stdout and stderr."] [50 1 "// startXOptions are the -X options of the command line (queue 220): bin/pyi python passes them in PYI_XOPTIONS, one"] [51 1 "// per line, NAME or NAME=VALUE; read once and removed from the environment (a child of the program does not inherit"] [52 1 "// them, as -X is not inherited)."] [72 1 "// startEnv is os.Getenv of a PYTHON* variable at start: \"\" under -E or -I (bin/pyi python's PYI_IGNORE_ENV, read once"] [73 1 "// and removed from the environment as PYI_XOPTIONS is)."] [90 2 "// atStartHooks run before the main module (Py_InitializeMain's late steps: queue 220, faulthandler's enable for"] [91 2 "// -X faulthandler and PYTHONFAULTHANDLER); an error is printed and the run's status is 1"] [95 1 "// startInspect is -i (bin/pyi python's PYI_INSPECT, queue 289, read once and removed from the environment as"] [96 1 "// PYI_SAFE_PATH is): 0 without it, 1 for -i, 2 for -i with no code to run (CPython's REPL on stdin, its banner but"] [97 1 "// under -q). PYTHONINSPECT at start (but under -E or -I) sets sys.flags.inspect, not interactive, as config's inspect."] [120 1 "// inspectAfter is pymain_repl's test (Modules/main.c): the REPL after the main module when -i was given or"] [121 1 "// PYTHONINSPECT is set (at start, or in the environment the program leaves), stdin a terminal or -i given."] [130 1 "// endMain is the main module's end with its status: Py_FinalizeEx's, or under -i the REPL on stdin in __main__'s"] [131 1 "// namespace (pymain_repl; the module's exception, SystemExit's too, printed before it), whose status is the run's."] [140 2 "// pymain_set_inspect(config, 0) before the REPL: sys.flags.inspect 0 in it (sys made first: an empty main module"] [141 2 "// has not made it)"] [147 3 "// no code to run: the REPL is the run, its __main__ the empty stdin module's without a __file__"] [156 1 "// cModeFile is the file bin/pyi python writes -c's code into (queue 220): run as CPython runs -c, its code's file"] [157 1 "// \"<string>\", no __file__, sys.path[0] \"\"."] [160 1 "// mModeFile and stdinModeFile are the files bin/pyi python writes for -m and for a program read from stdin (queue 250)."] [166 1 "// startSafePath is -P (safe_path) as bin/pyi python's command line gave it (PYI_SAFE_PATH: 1 under -P or -I, 0"] [167 1 "// without, read once and removed from the environment as PYI_IGNORE_ENV is); -1 when not run by bin/pyi python (bin/pyi"] [168 1 "// run's programs and the check's driver, whose sys.flags.safe_path is the reference driver's -P)."] [189 1 "// ExecModule runs a module's code object as the module name (its namespace's __name__), returning"] [190 1 "// the module, or the uncaught exception."] [195 1 "// PrintException writes an uncaught exception as CPython's default excepthook does"] [196 1 "// (Lib/traceback.py's format): the chain first (__cause__, else __context__ unless suppressed), each"] [197 1 "// with its traceback (the file, line and function, and the source line when the file reads) and"] [198 1 "// \"Type: text\", a SyntaxError's location and caret, the notes. Carets under expressions are not"] [199 1 "// printed (PY5b: a recorded difference)."] [200 1 "//"] [201 1 "// The text goes to sys.stderr (PyErr_Display's file): the process's standard error while sys.stderr is"] [202 1 "// the one it started with, else the text is written by sys.stderr.write and flushed (support.captured_stderr),"] [203 1 "// nothing when sys.stderr is None or missing, write's errors ignored."] [217 1 "// PrintUncaught is PyErr_Print (Python/pythonrun.c's _PyErr_PrintEx with set_sys_last_vars, queue 223): an uncaught"] [218 1 "// exception, not SystemExit, stored as sys.last_exc, last_type, last_value and last_traceback, then given to"] [219 1 "// sys.excepthook(type, value, traceback); \"sys.excepthook is missing\" and the display when it is absent or None; when"] [220 1 "// the hook raises, \"Error in sys.excepthook:\", that error's display, then \"Original exception was:\" and the original's."] [227 22 "// after the main module's run: the hook runs on the main thread"] [255 1 "// registerCode is run_mod's interactive source (Python/pythonrun.c, queue 223): -c's code and its nested code objects"] [256 1 "// registered by linecache._register_code(code, source, name), so traceback's display shows -c's lines; an error dropped."] [270 1 "// displayByTraceback is _PyErr_Display's first way (Python/pythonrun.c, queue 223): the stdlib's"] [271 1 "// traceback._print_exception_bltin(exc), Lib/traceback.py's display with its caret lines (PEP 657's positions,"] [272 1 "// co_positions), chains, groups and notes; false when the module or its function is missing or the call raised (the"] [273 1 "// error dropped, as PyErr_Clear), the caller then printing the Go display (print_exception_recursive's fallback)."] [274 1 "// Not while traceback itself is being imported or displaying (a second error then printed by the fallback)."] [306 1 "// writeStderr writes text to sys.stderr: in.Stderr when it is the original stream."] [346 4 "// at shutdown CPython's display reads no source (the import of io fails: queue 253)"] [355 1 "// FormatExceptionOnly is traceback.format_exception_only's text: a SyntaxError's location, source"] [356 1 "// line and caret, then \"Type: text\" (the type qualified by its module unless builtins), then the notes."] [361 23 "// traceback's stype: the module unless __main__ or builtins"] [365 3 "// str(exc) (traceback's _safe_string): a class's own __str__"] [445 1 "// RegisterSource gives sourceLine the text of a source that is no file (\"<stdin>\", \"<string>\"): the"] [446 1 "// REPL's statements, as linecache keeps them (PY5e's REQUEST, part 2a). A later text replaces it."] [451 1 "// sourceLine is the stripped text of line n of the file, \"\" when it does not read (linecache)."] [473 1 "// RunModule reads a module's IR (arbace.python.compile's code object as pr-str prints it) and runs it"] [474 1 "// as __main__ with file as __file__, on the process's stdout and stderr; the exit status: 0, 1 for an"] [475 1 "// uncaught exception (its traceback on stderr), SystemExit's code. bin/pyi run calls it."] [476 1 "// mainSourceError is the main file's decoding error as the tokenizer reports a file it reads, the file named"] [477 1 "// (helpers.c's \" in file FILE\", as arbace.python.run/error-answer gives pyi on goi's; queue 284: the compiled"] [478 1 "// launcher's main module, which RunModule decodes): nil when its bytes decode."] [502 2 "// ir is the compiler's answer when the main module does not compile (queue 223): its SyntaxError raised as"] [503 2 "// compile() raises it and given to sys.excepthook, as CPython's pymain_run_file reports it"] [507 37 "// the reader's warnings, emitted once the interpreter stands (queue 228)"] [512 3 "// the coding spec is a codec of Python's the host has no charset for: decoded and compiled below"] [523 2 "// sys.path[0] as CPython's config computes sys_path_0 (sys is made from configPath on its first use; queue 250):"] [524 2 "// none under -P (safe_path), \"\" for -c and stdin, the working directory for -m, else the script's directory"] [599 4 "// a file's parser has no source string (tok->str NULL): _metadata's source None, traceback reads the file"] [614 3 "// -c's sys.path[0] \"\" (none under -P: the first entry is then the standard library's; queue 250)"] [629 22 "// handle_system_exit drops the exception before Py_FinalizeEx"] [642 2 "// Py_FinalizeEx (pylifecycle.go, queue 253): threading._shutdown, the atexit functions, the modules' end; under -i"] [643 2 "// the REPL first (queue 289)"] [647 1 "// ExecModuleFile is ExecModule with __file__."] [669 1 "// runIn runs code as a module's body in the namespace g."] [672 44 "// an inlined comprehension's hidden locals"] [684 1 "// systemExitStatus is handle_system_exit's exit status (pythonrun.c): the exception's code (its one argument, the tuple"] [685 1 "// of several), None 0, an int as C's int (a value beyond long, or an int that wraps, -1: status 255), else its str on"] [686 1 "// stderr and 1 (queue 242: the code of several arguments was their first one; an int out of range was kept whole)."] [710 4 "// written with the stream's encoding and errors (queue 242: backslashreplace, PYTHONIOENCODING)"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[137 53] [143 47] [206 27] [247 53] [265 52] [293 41] [296 45] [297 29] [298 45] [309 28] [316 48] [319 43] [335 24] [335 35] [338 62] [347 37] [366 24] [386 47] [390 52] [393 56] [394 28] [398 56] [408 45] [419 24] [421 32] [492 20] [514 40] [518 34] [534 28] [544 18] [559 34] [565 44] [598 29] [600 50] [610 35] [615 52] [616 48] [627 28] [663 43] [699 25] [709 49]]} (go/file "interp.go" :imports [



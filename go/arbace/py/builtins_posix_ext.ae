(in-ns 'go.arbace.py) ^{:go/comments [[15 1 "// posix's process and file functions (PY6e; Modules/posixmodule.c): stat_result with its float and nanosecond"] [16 1 "// times, scandir and DirEntry, the descriptors' functions (dup2, pread, readv, inheritable and blocking flags),"] [17 1 "// the processes' (waitpid, wait3, wait4, execv, execve, system, times, uname), sysconf, confstr and pathconf over"] [18 1 "// musl's tables, statvfs, the terminal's few (isatty from the device's major number). posix has no fork: Go's"] [19 1 "// runtime is multithreaded, so pyi starts children only through _posixsubprocess.fork_exec (Go's ForkExec), and"] [20 1 "// test.support's has_fork_support is False (the class no-fork)."] [42 2 "// stat_result(seq) of ten: its float times from the int slots (statresult_new)"] [71 1 "// fdArg is a file descriptor argument: an int, or an object's fileno()."] [113 1 "// isattyFd is isatty(3) without its ioctl: a character device of a terminal's major number (tty, console, pts)."] [123 1 "// pathOrFd is a path argument that may also be a descriptor (os.stat(fd)): path_converter with allow_fd, a bool a"] [124 1 "// descriptor after a RuntimeWarning as _fd_converter warns."] [146 1 "// posixWarnHook is warnings.warn(msg, category), set by makePosix for the converters' warnings."] [149 1 "// fdConv is _fd_converter: an int (a bool warns first) within C's int."] [170 1 "// isBytesPath is a path argument that is bytes, or os.PathLike of bytes: the results are bytes then."] [186 1 "// nameDecode is os.fsdecode of a name: UTF-8, an undecodable byte a surrogate (surrogateescape)."] [205 1 "// fildesWarns are the functions whose descriptor is CPython's fildes converter, which warns of a bool."] [208 1 "// fdDir marks listdir's and scandir's directory given as a descriptor."] [211 1 "// atFdCwd is AT_FDCWD, dir_fd's default."] [214 1 "// dirFd is a dir_fd argument by its keyword (dir_fd_converter): absent or None the current directory, else a"] [215 1 "// descriptor."] [227 1 "// atPath is the *at functions' path: p relative to the directory dirfd as a path the plain calls take, an"] [228 1 "// absolute path or one of the current directory unchanged, else /proc/self/fd/DIRFD/p, the descriptor checked"] [229 1 "// first so that a bad one is EBADF and a file's ENOTDIR, as openat(2) answers (Go's syscall has no linkat,"] [230 1 "// readlinkat, symlinkat or flags for unlinkat; every *at goes this one way)."] [248 1 "// noFollowPath is a path naming the symbolic link p itself, for the calls that have no l* form in Go's syscall"] [249 1 "// (utimensat's AT_SYMLINK_NOFOLLOW): /proc/self/fd/N of an O_PATH|O_NOFOLLOW descriptor, closed by done."] [258 24 "// O_PATH, the same on amd64 and arm64"] [260 1 "// atArgs are a path function's dir_fd and follow_symlinks checked as CPython checks them: fd with dir_fd or"] [261 1 "// follow_symlinks=False is a ValueError."] [290 1 "// splitKw is a call's positional arguments and its keyword ones by name."] [330 2 "// CPython's on musl Linux but those of functions pyi lacks (eventfd, memfd_create, ptsname_r, timerfd_create):"] [331 2 "// the *at functions through atPath, futimens and lutimes through /proc/self/fd"] [378 2 "// ---- stat"] [395 37 "// lstat takes no descriptor"] [467 19 "// AT_EACCESS"] [470 19 "// AT_SYMLINK_NOFOLLOW"] [560 4 "// fchmodat(AT_SYMLINK_NOFOLLOW) as musl answers it: a link's mode cannot change (EOPNOTSUPP, which"] [561 4 "// os_chmod_impl turns into NotImplementedError), anything else's does"] [697 5 "// linkat(AT_SYMLINK_FOLLOW) by default: the link's target linked, not the link"] [767 44 "// futimens(fd)"] [853 27 "// NODEV"] [870 28 "// makedev(NODEV, NODEV)"] [930 2 "// ---- listdir, scandir"] [944 4 "// fdopendir(dup(fd)) as a fresh open of the descriptor's directory, its entries' paths their names"] [1026 2 "// ---- descriptors"] [1189 3 "// no TIOCGWINSZ without unsafe: the size the environment gives, else 80x24"] [1330 2 "// ---- processes"] [1444 37 "// the kernel's 40..1, as libc's -20..19"] [1493 73 "// the GIL released while it blocks (PY6f's allowThreads; queue 200, PY6-core)"] [1583 45 "// fexecve"] [1642 2 "// ---- configuration"] [1731 1 "// sysconfDynamic is musl's sysconf of the values it computes (src/conf/sysconf.c)."] [1750 10 "// SC_ARG_MAX"] [1755 10 "// SC_CHILD_MAX"] [1757 10 "// SC_OPEN_MAX"] [1759 11 "// SC_PAGESIZE (SC_PAGE_SIZE)"] [1761 15 "// SC_NPROCESSORS_CONF, SC_NPROCESSORS_ONLN"] [1763 11 "// SC_PHYS_PAGES"] [1766 11 "// SC_AVPHYS_PAGES"] [1769 12 "// SC_MINSIGSTKSZ: the auxiliary vector's AT_MINSIGSTKSZ, at least MINSIGSTKSZ"] [1797 1 "// ---- DirEntry and scandir's iterator"] [1802 25 "// d_type's bits"] [1803 25 "// d_ino"] [1807 1 "// dirent is one linux_dirent64 of getdents64."] [1814 1 "// readDirents is readdir(3) over getdents64: each entry's name, d_ino and d_type, \".\" and \"..\" left out."] [1846 1 "// mode is d_type as os.FileMode's type bits; DT_UNKNOWN an lstat of the entry, as Go's ReadDir does."] [2013 1 "// openDir is opendir(3): the path opened O_DIRECTORY, so a FIFO or a file fails at once (os.Open of a FIFO blocks"] [2014 1 "// until a writer opens it: os.walk of a named pipe hung)."] [2023 1 "// posixMinArgs are the positional arguments posix's functions need (Argument Clinic's required ones), so that a"] [2024 1 "// short call is a TypeError, never an index past args (a Go panic ended test_os's driver in test_readinto_badarg)."] [2036 1 "// posixMaxArgs are the arguments of posix's functions that take a fixed few: none for the no-argument functions"] [2037 1 "// (testNoArgFunctions), more a TypeError."] [2063 1 "// devConv is a dev_t argument (_Py_Dev_Converter): an int of 64 bits, -1 NODEV; max the bound of major's and"] [2064 1 "// minor's unsigned int when not 0."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[44 13] [44 21] [73 22] [83 45] [87 23] [99 24] [126 22] [133 48] [134 24] [151 27] [152 83] [172 24] [179 48] [221 22] [236 37] [274 34] [356 35] [357
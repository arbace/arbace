

(in-ns 'go.arbace.py) ^{:go/comments [[1 1 "//go:build linux"] [19 1 "// posix's process and file functions (PY6e; Modules/posixmodule.c): stat_result with its float and nanosecond"] [20 1 "// times, scandir and DirEntry, the descriptors' functions (dup2, pread, readv, inheritable and blocking flags),"] [21 1 "// the processes' (waitpid, wait3, wait4, execv, execve, system, times, uname), sysconf, confstr and pathconf over"] [22 1 "// musl's tables, statvfs, the terminal's few (isatty from the device's major number). posix has no fork: Go's"] [23 1 "// runtime is multithreaded, so pyi starts children only through _posixsubprocess.fork_exec (Go's ForkExec), and"] [24 1 "// test.support's has_fork_support is False (the class no-fork)."] [46 2 "// stat_result(seq) of ten: its float times from the int slots (statresult_new)"] [75 1 "// fdArg is a file descriptor argument: an int, or an object's fileno()."] [117 1 "// isattyFd is isatty(3) without its ioctl: a character device of a terminal's major number (tty, console, pts)."] [118 1 "// isattyFd is musl's isatty: TIOCGWINSZ succeeds (queue 220: the ioctl's struct by its address, termios'; before, the"] [119 1 "// device's major number, which missed a pty's master)."] [126 1 "// pathOrFd is a path argument that may also be a descriptor (os.stat(fd)): path_converter with allow_fd, a bool a"] [127 1 "// descriptor after a RuntimeWarning as _fd_converter warns."] [149 1 "// posixWarnHook is warnings.warn(msg, category), set by makePosix for the converters' warnings."] [152 1 "// fdConv is _fd_converter: an int (a bool warns first) within C's int."] [173 1 "// isBytesPath is a path argument that is bytes, or os.PathLike of bytes: the results are bytes then."] [189 1 "// nameDecode is os.fsdecode of a name: UTF-8, an undecodable byte a surrogate (surrogateescape)."] [208 1 "// fildesWarns are the functions whose descriptor is CPython's fildes converter, which warns of a bool."] [211 1 "// fdDir marks listdir's and scandir's directory given as a descriptor."] [214 1 "// atFdCwd is AT_FDCWD, dir_fd's default."] [217 1 "// dirFd is a dir_fd argument by its keyword (dir_fd_converter): absent or None the current directory, else a"] [218 1 "// descriptor."] [230 1 "// atPath is the *at functions' path: p relative to the directory dirfd as a path the plain calls take, an"] [231 1 "// absolute path or one of the current directory unchanged, else /proc/self/fd/DIRFD/p, the descriptor checked"] [232 1 "// first so that a bad one is EBADF and a file's ENOTDIR, as openat(2) answers (Go's syscall has no linkat,"] [233 1 "// readlinkat, symlinkat or flags for unlinkat; every *at goes this one way)."] [251 1 "// noFollowPath is a path naming the symbolic link p itself, for the calls that have no l* form in Go's syscall"] [252 1 "// (utimensat's AT_SYMLINK_NOFOLLOW): /proc/self/fd/N of an O_PATH|O_NOFOLLOW descriptor, closed by done."] [261 24 "// O_PATH, the same on amd64 and arm64"] [263 1 "// atArgs are a path function's dir_fd and follow_symlinks checked as CPython checks them: fd with dir_fd or"] [264 1 "// follow_symlinks=False is a ValueError."] [293 1 "// splitKw is a call's positional arguments and its keyword ones by name."] [333 2 "// CPython's on musl Linux but those of functions pyi lacks (ptsname_r):"] [334 2 "// the *at functions through atPath, futimens and lutimes through /proc/self/fd"] [381 2 "// ---- stat"] [398 37 "// lstat takes no descriptor"] [470 19 "// AT_EACCESS"] [473 19 "// AT_SYMLINK_NOFOLLOW"] [563 4 "// fchmodat(AT_SYMLINK_NOFOLLOW) as musl answers it: a link's mode cannot change (EOPNOTSUPP, which"] [564 4 "// os_chmod_impl turns into NotImplementedError), anything else's does"] [700 5 "// linkat(AT_SYMLINK_FOLLOW) by default: the link's target linked, not the link"] [770 44 "// futimens(fd)"] [856 27 "// NODEV"] [873 28 "// makedev(NODEV, NODEV)"] [933 2 "// ---- listdir, scandir"] [947 4 "// fdopendir(dup(fd)) as a fresh open of the descriptor's directory, its entries' paths their names"] [1030 2 "// ---- descriptors"] [1193 3 "// no TIOCGWINSZ without unsafe: the size the environment gives, else 80x24"] [1313 3 "// the GIL released while it blocks, as posixmodule.c's Py_BEGIN_ALLOW_THREADS (PY7: a blocking socket's sendfile"] [1314 3 "// held it, so the thread reading the other end never ran: test_socket's SendfileUsingSendfileTest.testOffset)"] [1336 2 "// ---- processes"] [1441 37 "// the kernel's 40..1, as libc's -20..19"] [1490 73 "// the GIL released while it blocks (PY6f's allowThreads; queue 200, PY6-core)"] [1583 45 "// fexecve"] [1643 2 "// ---- configuration"] [1732 1 "// sysconfDynamic is musl's sysconf of the values it computes (src/conf/sysconf.c)."] [1751 10 "// SC_ARG_MAX"] [1756 10 "// SC_CHILD_MAX"] [1758 10 "// SC_OPEN_MAX"] [1760 11 "// SC_PAGESIZE (SC_PAGE_SIZE)"] [1762 15 "// SC_NPROCESSORS_CONF, SC_NPROCESSORS_ONLN"] [1764 11 "// SC_PHYS_PAGES"] [1767 11 "// SC_AVPHYS_PAGES"] [1770 12 "// SC_MINSIGSTKSZ: the auxiliary vector's AT_MINSIGSTKSZ, at least MINSIGSTKSZ"] [1798 1 "// ---- DirEntry and scandir's iterator"] [1803 25 "// d_type's bits"] [1804 25 "// d_ino"] [1808 1 "// dirent is one linux_dirent64 of getdents64."] [1815 1 "// readDirents is readdir(3) over getdents64: each entry's name, d_ino and d_type, \".\" and \"..\" left out."] [1847 1 "// mode is d_type as os.FileMode's type bits; DT_UNKNOWN an lstat of the entry, as Go's ReadDir does."] [1881 1 "// scandirFinalize is ScandirIterator_finalize (queue 241): an iterator not closed (nor exhausted) warns"] [1882 1 "// ResourceWarning \"unclosed scandir iterator %R\" (its source the iterator) and is closed."] [2027 1 "// openDir is opendir(3): the path opened O_DIRECTORY, so a FIFO or a file fails at once (os.Open of a FIFO blocks"] [2028 1 "// until a writer opens it: os.walk of a named pipe hung)."] [2037 1 "// posixMinArgs are the positional arguments posix's functions need (Argument Clinic's required ones), so that a"] [2038 1 "// short call is a TypeError, never an index past args (a Go panic ended test_os's driver in test_readinto_badarg)."] [2050 1 "// posixMaxArgs are the arguments of posix's functions that take a fixed few: none for the no-argument functions"] [2051 1 "// (testNoArgFunctions), more a TypeError."] [2077 1 "// devConv is a dev_t argument (_Py_Dev_Converter): an int of 64 bits, -1 NODEV; max the bound of major's and"] [2078 1 "// minor's unsigned int when not 0."] [2100 1 "// The system interface where TamaGo's syscall lacks it (queue 214: pyi's runtime listed in goi's table, checked in its"] [2101 1 "// tamago configurations too; builtins_os_other.go there): Linux's."] [2107 1 "// oNofollow is O_NOFOLLOW, the architecture's (a function: the constant's value differs between amd64 and arm64)."] [2112 1 "// ignorePipeSignals ignores SIGPIPE and SIGXFSZ, as CPython's startup does."]] :go/pos {:name [3 9] :package [3 1]} :go/semis [[48 13] [48 21] [77 22] [87 45] [91 23] [103 24] [129 22] [136 48] [137 24] [154 27] [155 83] [175 24] [182 48] [224 22] [239 37] [277 34] [359 35] [360 85] [373 32] [388 25] [408 31] [434 35] [445 20] [487 25] [501 30] [509 24] [537 20] [559 29] [566 35] [611 31] [644 21] [648 40] [682 37] [686 41] [689 41] [692 31] [696 30] [713 21] [752 24] [755 25] [772 36] [775 36] [871 29] [872 30] [909 37] [929 76] [949 36] [956 53] [1057 30] [1062 49] [1071 38] [1089 15] [1089 24] [1096 51] [1107 36] [1159 35] [1187 35] [1330 28] [1389 30] [1420 13] [1420 34] [1427 86] [1468 60] [1600 35] [1648 23] [1656 23] [1669 32] [1672 31] [1682 32] [1709 35] [1725 31] [1752 41] [1775 46] [1776 14] [1776 30] [1779 38] [1792 12] [1792 20] [1830 15] [1830 28] [1836 46] [1839 25] [1865 30] [1889 68] [2021 87] [2064 32] [2080 22] [2117 55]]} (go/file "builtins_posix_ext.go" :build ["//go:build linux"] :imports [



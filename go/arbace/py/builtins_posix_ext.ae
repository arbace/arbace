(in-ns 'go.arbace.py) ^{:go/comments [[14 1 "// posix's process and file functions (PY6e; Modules/posixmodule.c): stat_result with its float and nanosecond"] [15 1 "// times, scandir and DirEntry, the descriptors' functions (dup2, pread, readv, inheritable and blocking flags),"] [16 1 "// the processes' (waitpid, wait3, wait4, execv, execve, system, times, uname), sysconf, confstr and pathconf over"] [17 1 "// musl's tables, statvfs, the terminal's few (isatty from the device's major number). posix has no fork: Go's"] [18 1 "// runtime is multithreaded, so pyi starts children only through _posixsubprocess.fork_exec (Go's ForkExec), and"] [19 1 "// test.support's has_fork_support is False (the class no-fork)."] [41 2 "// stat_result(seq) of ten: its float times from the int slots (statresult_new)"] [70 1 "// fdArg is a file descriptor argument: an int, or an object's fileno()."] [112 1 "// isattyFd is isatty(3) without its ioctl: a character device of a terminal's major number (tty, console, pts)."] [122 1 "// pathOrFd is a path argument that may also be a descriptor (os.stat(fd))."] [150 1 "// splitKw is a call's positional arguments and its keyword ones by name."] [234 2 "// ---- stat"] [659 2 "// ---- listdir, scandir"] [750 2 "// ---- descriptors"] [905 3 "// no TIOCGWINSZ without unsafe: the size the environment gives, else 80x24"] [1046 2 "// ---- processes"] [1173 37 "// the kernel's 40..1, as libc's -20..19"] [1390 2 "// ---- configuration"] [1479 1 "// sysconfDynamic is musl's sysconf of the values it computes (src/conf/sysconf.c)."] [1498 10 "// SC_ARG_MAX"] [1503 10 "// SC_CHILD_MAX"] [1505 10 "// SC_OPEN_MAX"] [1507 11 "// SC_PAGESIZE (SC_PAGE_SIZE)"] [1509 15 "// SC_NPROCESSORS_CONF, SC_NPROCESSORS_ONLN"] [1511 11 "// SC_PHYS_PAGES"] [1514 11 "// SC_AVPHYS_PAGES"] [1517 12 "// SC_MINSIGSTKSZ: the auxiliary vector's AT_MINSIGSTKSZ, at least MINSIGSTKSZ"] [1545 1 "// ---- DirEntry and scandir's iterator"] [1550 25 "// d_type's bits"] [1693 1 "// openDir is opendir(3): the path opened O_DIRECTORY, so a FIFO or a file fails at once (os.Open of a FIFO blocks"] [1694 1 "// until a writer opens it: os.walk of a named pipe hung)."] [1703 1 "// posixMinArgs are the positional arguments posix's functions need (Argument Clinic's required ones), so that a"] [1704 1 "// short call is a TypeError, never an index past args (a Go panic ended test_os's driver in test_readinto_badarg)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[43 13] [43 21] [72 22] [82 45] [86 23] [98 24] [124 22] [125 28] [170 25] [226 32] [241 25] [247 31] [280 35] [291 20] [298 33] [317 25] [323 30] [338 24] [355 25] [366 20] [373 32] [467 21] [469 36] [515 24] [518 25] [524 32] [635 37] [655 76] [668 26] [777 30] [782 49] [791 38] [809 15] [809 24] [816 51] [827 36] [1040 28] [1112 30] [1143 13] [1143 34] [1152 13] [1152 35] [1153 37] [1159 86] [1200 60] [1350 35] [1395 23] [1403 23] [1416 32] [1419 31] [1429 32] [1456 35] [1472 31] [1499 41] [1522 46] [1523 14] [1523 30] [1526 38] [1539 12] [1539 20] [1687 87] [1722 32]]} (go/file "builtins_posix_ext.go" :imports [



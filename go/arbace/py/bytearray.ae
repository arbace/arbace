(in-ns 'go.arbace.py) ^{:go/comments [[10 1 "// bytearray (Objects/bytearrayobject.c), added by PY5e as the integration's owner (part 2b; PY5b's report:"] [11 1 "// \"bytearray and memoryview ... not done\"): a mutable bytes. _collections_abc, and so collections.abc,"] [12 1 "// typing, os, copy and every module importing them, need the type at import. Its own slots and mutating"] [13 1 "// methods are here; bytes' other methods are bytes.go's, called on a copy, their bytes results made"] [14 1 "// bytearrays (bytearray's methods return bytearrays where bytes' return bytes)."] [21 1 "// ByteArray is a bytearray; exports is its ob_exports (queue 249, buffer_export.go): the memoryviews holding it."] [27 1 "// bytearrayExports counts a bytearray's exports: memoryview(ba) holds one until released or found dead, as"] [28 1 "// bytearray_getbuffer's ob_exports (queue 595; PYI_BYTEARRAY_EXPORTS=0: none counted, pyi's behaviour before it). Off"] [29 1 "// by default from queue 249 to 595, while pyi's io was _pyio, whose FileIO.readall resizes a bytearray it has just made"] [30 1 "// temporary views of (every file read would have asked Go's collector whether they died, and under goi a view its"] [31 1 "// registers held failed an import's get_data); since queue 545 _io is fileio.c's port in Go (Go slices, no Python"] [32 1 "// view), so only _pyio itself (its tests' Py classes) asks, within the collections' budget (buffer_export.go)."] [35 1 "// Exports makes a bytearray a counting exporter (buffer_export.go) when bytearrayExports; nil (no count) otherwise."] [43 1 "// canResize is _canresize: BufferError while a view holds the buffer."] [48 1 "// resizeTo is a size change to n (PyByteArray_Resize's check: none when the size stays)."] [58 1 "// BytesLike makes a bytearray a bytes-like object for asBytes (bytes.go)."] [61 1 "// NewByteArray is a bytearray holding b (not copied)."] [65 13 "// the bytearray or subclass instance iterated (bytearrayiter_reduce)"] [82 1 "// toByteArrays makes bytes' results bytearrays: a bytes, the bytes in a list or tuple."] [101 1 "// byteValue is _getbytevalue (Objects/bytearrayobject.c): the byte o is as an int (__index__'s own errors propagate),"] [102 1 "// ValueError beyond range(0, 256) (an int too large for a long too)."] [115 1 "// maxBytesAlloc is what pyi allocates for one bytes or bytearray (larger: MemoryError, where Go's make panics)."] [118 1 "// sizeBytes is a size n for a new buffer: MemoryError past maxBytesAlloc (PyErr_NoMemory)."] [126 1 "// fromObject fills an emptied bytearray from o as bytearray's __init__ does after the int and str cases: the"] [127 1 "// buffer (__buffer__'s too), else an iterable of ints appended one by one (so a generator sees the bytes made so"] [128 1 "// far), each by _getbytevalue; a failure empties it again."] [143 2 "// an exact list or tuple is sized first and a failure resets it to empty (the uninitialized bytes are not"] [144 2 "// exposed); the slow path keeps what it appended before the failure"] [165 1 "// bufferData is a copy of the bytes o exports through the buffer protocol (a bytes-like object, or a class's"] [166 1 "// __buffer__, released once read); found is false for an object that exports none."] [168 37 "// queue 304: a released view's CHECK_RELEASED (bytes(m), bytearray(m))"] [190 1 "// pyNumberCheck is PyNumber_Check: an int, a float, a complex, or a class with __index__, __int__ or __float__."] [197 1 "// sliceValues is what a slice assignment takes from values that are not a bytearray (bytearray_ass_subscript): a"] [198 1 "// number or a str is a TypeError, anything else is converted as bytearray(values) does."] [210 1 "// allocSize is bytearray.__alloc__: the bytes allocated, one more than the size (the trailing NUL) once anything is"] [211 1 "// held, 0 for an empty buffer that never held any."] [221 39 "// bytearray_repr: a subclass's name"] [233 41 "// bytearray___init__'s PyByteArray_Resize(self, 0)"] [236 13 "// emptied first of all: a failure below leaves it empty (gh-91153's reinit)"] [237 3 "// encoding and errors as clinic's const char *: str only"] [329 3 "// bytearray_contains: the storage exported while the argument is converted (its __index__ or __buffer__ may"] [330 3 "// resize the bytearray: BufferError, gh-142560)"] [372 5 "// bytearray_setslice_linear: a growth either way is a resize"] [378 5 "// in place when the length is kept or the slice is the tail (queue 210: _pyio's BytesIO writes"] [379 5 "// b[pos:pos+n] at its end, and a copy of the whole buffer for each write made StringIO quadratic)"] [384 6 "// a shrink stays in the buffer (bytearray_setslice_linear's memmove: the allocation is kept)"] [396 5 "// the extended slice deleted (needed == 0, a value of no bytes too): _canresize first, even for no item"] [421 3 "// bytearray_ass_subscript: the index, then the value (before the size check: its __index__ may"] [422 3 "// resize the bytearray, gh-91153), then the bounds"] [468 2 "// bytearray_irepeat (queue 249: in place, a resize; pyi made a new bytearray, so b *= n rebound b)"] [510 3 "// bytearray_mod_lock_held: the format exported while its arguments' __repr__ and __str__ run (gh-142557)"] [520 58 "// bytearray_mod through __rmod__"] [553 3 "// bytearray_extend_impl: a buffer goes straight to bytearray_setslice(self, size, size, ...), the size read"] [554 3 "// before the buffer is acquired (its __buffer__ may resize self: gh-153578, the data lands at the old end, clamped)"] [568 45 "// queue 304: PyObject_LengthHint(iterable_of_ints, 64)"] [699 2 "// bytearray.take_bytes(n=None, /) (3.15, Objects/bytearrayobject.c's bytearray_take_bytes_impl; queue 237): the first n"] [700 2 "// bytes (negative: from the end, None: all) as bytes, the rest left in the bytearray"] [719 21 "// __index__ may have resized it"] [749 2 "// bytes' other methods, on a copy, their results made bytearrays (once bytes.go's are in its dict)"] [760 4 "// the methods bytearrayobject.c runs with self exported (ob_exports++ around the work, queue 595): a"] [761 4 "// resize from the Python code their arguments run is a BufferError (gh-143195's hex separator, join's"] [762 4 "// iterator, gh-142560's search and split arguments)"] [786 1 "// byteIndex is a bytearray's index k (negative from the end), CPython's errors."] [801 1 "// byteIndexRaw is a bytearray subscript that is not a slice, as PyNumber_AsSsize_t(index, PyExc_IndexError): an index"] [802 1 "// past a Py_ssize_t is an IndexError."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[73 28] [76 42] [130 35] [168 30] [175 24] [200 22] [204 29] [233 26] [261 28] [289 32] [338 26] [344 24] [344 31] [357 26] [364 34] [374 29] [397 28] [402 25] [402 32] [416 24] [416 31] [429 28] [440 27] [462 42] [488 34] [496 13] [496 24] [535 42] [546 26] [568 30] [581 32] [594 27] [624 26] [639 30] [649 26] [665 26] [672 26] [686 25] [689 26] [707 29] [731 27] [744 28] [744 35] [767 25] [804 22]]} (go/file "bytearray.go" :imports [



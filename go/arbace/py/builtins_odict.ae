(in-ns 'go.arbace.py) ^{:go/comments [[3 1 "// The C OrderedDict (py-mods-1122; Objects/odictobject.c and Objects/clinic/odictobject.c.h of CPython 3.14.10, PSF"] [4 1 "// License Agreement): _collections.OrderedDict, which collections takes in place of its pure-Python class, as"] [5 1 "// CPython's does. A dict subclass whose instances carry a doubly linked list of nodes beside the dict's entries, a"] [6 1 "// node a key (with its hash), found from a key through the dict (CPython's od_fast_nodes, by the entry's slot: here a"] [7 1 "// map by the entry's key object, the stored key, after the dict's own lookup), and od_state, moved by every change of"] [8 1 "// the list (a node added or removed, the list cleared): iteration (odict_iterator over the keys, values or items, or"] [9 1 "// reversed) follows the list, tracking the current key, so a change of the list during it is \"OrderedDict mutated"] [10 1 "// during iteration\" and of the size \"OrderedDict changed size during iteration\"; __eq__ between two OrderedDicts is"] [11 1 "// dict's then the keys' order compared node by node, a change of either list by a key's __eq__ a RuntimeError"] [12 1 "// (issue119004), as copy()'s (gh-148660). The dict's own methods called on an OrderedDict (dict.__setitem__,"] [13 1 "// dict.__delitem__, dict.pop ...) change the entries alone, as CPython's: the list then names a key the dict lacks"] [14 1 "// (iteration raises KeyError) or lacks a key the dict has. move_to_end also moves the dict's entry, so the Go"] [15 1 "// operations that read the entries (unpacking, the json and pickle helpers) see the list's order as CPython's see it"] [16 1 "// through keys()."] [26 1 "// odNode is a node of the list: a key and its hash."] [33 1 "// ODict is an OrderedDict: the dict, its list, od_state and the instance's __dict__ (tp_dictoffset)."] [35 2 "// the dict, a field and not embedded: an embedded Dict would give ODict Dict's methods, Len among them, a method of"] [36 2 "// the stub family goi's table holds 16 of (go/arbace/gotable.edn :stubs), which the runtime interpreted by goi"] [37 2 "// then exhausts (its warning on every process's stderr)"] [47 1 "// BaseDict makes an OrderedDict a dict for dict's slots and methods (asDict)."] [52 1 "// odOf is the OrderedDict of o: o, or a subclass's instance's built-in value; nil for none."] [68 1 "// findNode is _odict_find_node_hash: the node of key, found through the dict (its lookup, its keys' __eq__), nil"] [69 1 "// when the dict lacks the key or holds it without a node."] [78 1 "// addNewNode is _odict_add_new_node: a node for key (just set in the dict) at the list's end, none when it has one."] [122 1 "// removeNode is _odict_remove_node: n out of the list (its map entry kept: clearNode drops it)."] [140 1 "// clearNode is _odict_clear_node: key's node (or n) taken out of the list and the map; nothing when the list is"] [141 1 "// empty or the key has no node."] [162 1 "// clearNodes is _odict_clear_nodes."] [168 1 "// setItemHashed is _PyODict_SetItem_KnownHash: the dict's item, then a node for a new key."] [184 1 "// delItem is PyODict_DelItem: the node, then the dict's item (KeyError when the dict lacks it)."] [204 1 "// deleteAt makes entry i a hole (Delete's, by position)."] [217 1 "// moveEntry moves entry i last (a hole left, the entry appended) or first (the entries remade with it first), as"] [218 1 "// move_to_end moves the node (py-mods-1122: the dict's order kept the list's)."] [240 1 "// popKeyHashed is _odict_popkey_hash: key's node found, cleared, then its item popped from the dict; failobj (nil:"] [241 1 "// a KeyError) when the key has no node."] [269 1 "// keysEqual is _odict_keys_equal: the lists node by node, the keys compared (PyObject_RichCompareBool), a change of"] [270 1 "// either list meanwhile a RuntimeError."] [302 1 "// odictIter is odictiterobject: the OrderedDict (nil once done), the kind, di_size, di_state and the next key."] [325 1 "// nextKey is odictiter_nextkey_lock_held."] [339 16 "// sticky"] [369 1 "// next is odictiter_iternext_lock_held: the key, its value from the dict, or both."] [393 1 "// odUpdateArg is mutablemapping_update_arg: an exact dict's items, else keys() and __getitem__, else items(), else"] [394 1 "// pairs."] [428 1 "// odAddPairs is mutablemapping_add_pairs: each pair's two items, self[key] = value."] [460 1 "// odUpdate is mutablemapping_update: at most one positional argument, then the keyword arguments' pairs."] [479 1 "// odictSizeof is OrderedDict.__sizeof__: the dict's (dictSizeof less getsizeof's GC header), od_fast_nodes (a"] [480 1 "// pointer a slot of the dict's table) and a node (key, hash, two links: 32 bytes) a key."] [493 1 "// odMethod puts a method in OrderedDict's dictionary that takes the instance itself (objectDescr), not a subclass's"] [494 1 "// built-in value: setdefault, copy, update, __reduce__ and | ask the instance (its class, its __getitem__ and __setitem__,"] [495 1 "// its __dict__), as odictobject.c's methods get self."] [535 3 "// PyDict_Copy: dict_merge of a dict subclass with its own __iter__, by its keys() and __getitem__"] [546 2 "// dict's comparison looked up at the call: this file's init runs before dict.go's, which sets it"] [590 77 "// a the right operand"] [611 2 "// a method with clinic's keywords: params bound by position or name"] [774 2 "// fromkeys (OrderedDict_fromkeys_impl: _PyDict_FromKeys): cls() filled by its __setitem__, value None by default, by"] [775 2 "// position or by name"] [841 2 "// odict_iterator and the views"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[54 24] [62 17] [170 39] [190 36] [248 35] [396 25] [398 73] [401 43] [416 44] [467 38] [472 47] [509 30] [537 25] [552 24] [577 28] [584 34] [592 30] [601 44] [633 54] [635 44] [653 31] [661 35] [673 38] [721 43] [724 44] [741 44] [746 19] [746 29] [756 56] [764 34] [834 43] [845 47] [875 50]]} (go/file "builtins_odict.go" :imports [])

;; The C OrderedDict (py-mods-1122; Objects/odictobject.c and Objects/clinic/odictobject.c.h of CPython 3.14.10, PSF
;; License Agreement): _collections.OrderedDict, which collections takes in place of its pure-Python class, as
;; CPython's does. A dict subclass whose instances carry a doubly linked list of nodes beside the dict's entries, a
;; node a key (with its hash), found from a key through the dict (CPython's od_fast_nodes, by the entry's slot: here a
;; map by the entry's key object, the stored key, after the dict's own lookup), and od_state, moved by every change of
;; the list (a node added or removed, the list cleared): iteration (odict_iterator over the keys, values or items, or
;; reversed) follows the list, tracking the current key, so a change of the list during it is "OrderedDict mutated
;; during iteration" and of the size "OrderedDict changed size during iteration"; __eq__ between two OrderedDicts is
;; dict's then the keys' order compared node by node, a change of either list by a key's __eq__ a RuntimeError
;; (issue119004), as copy()'s (gh-148660). The dict's own methods called on an OrderedDict (dict.__setitem__,
;; dict.__delitem__, dict.pop ...) change the entries alone, as CPython's: the list then names a key the dict lacks
;; (iteration raises KeyError) or lacks a key the dict has. move_to_end also moves the dict's entry, so the Go
;; operations that read the entries (unpacking, the json and pickle helpers) see the list's order as CPython's see it
;; through keys().


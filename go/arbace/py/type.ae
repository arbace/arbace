(in-ns 'go.arbace.py) ^{:go/comments [[3 1 "// Type is a Python type object (CPython's PyTypeObject): its name, bases and MRO, its dictionary,"] [4 1 "// and the slots, the protocol functions the machine calls. A built-in type sets its slots in Go; a"] [5 1 "// class's slots are filled from its dictionary's special methods (PY5c: slot wrappers, invalidated"] [6 1 "// on assignment as CPython's type version tags are)."] [8 18 "// __name__"] [9 18 "// __qualname__"] [10 18 "// __module__ (\"builtins\" for the built-in types)"] [11 18 "// __base__ (nil for object)"] [14 17 "// the type's namespace: methods, descriptors, attributes"] [17 2 "// Meta is the type's own type (type, or a metaclass: PY5c); nil means type."] [21 1 "// TypeFlags are a type's properties, as CPython's tp_flags."] [25 40 "// may be subclassed"] [26 40 "// made by a class statement"] [27 40 "// the fast-subclass bits: isinstance checks without the MRO"] [37 1 "// Slots are a type's protocol functions (CPython's tp_* and the number, sequence and mapping"] [38 1 "// structs). A nil slot means the type does not support the protocol: the abstract functions"] [39 1 "// (abstract.go) fall back as CPython's do (the reflected operand, __eq__'s identity, ...)."] [40 1 "// Every function raises by returning a non-nil error."] [42 38 "// __repr__, a *Str"] [43 38 "// __str__; nil: Repr"] [44 38 "// __hash__; nil: identity (unhashable types set Unhashable)"] [45 2 "// Unhashable is __hash__ = None."] [47 42 "// __bool__; nil: Len, else true"] [48 42 "// __len__"] [50 62 "// NotImplemented when it does not apply"] [52 52 "// __getattribute__ (+ __getattr__); nil: GenericGetAttr"] [53 52 "// __setattr__; v nil: __delattr__"] [56 38 "// __iter__"] [57 2 "// Next is __next__: (nil, nil) at the end (StopIteration without a value)."] [60 47 "// __getitem__"] [61 47 "// __setitem__; v nil: __delitem__"] [62 47 "// __contains__"] [64 2 "// Number protocol: Binary[op] is the operator's method (a op b), RBinary[op] the reflected one"] [65 2 "// (b's __radd__ ...), InPlace[op] the in-place one; NotImplemented when it does not apply."] [70 44 "// __abs__ (PY5b)"] [71 44 "// __divmod__ (a tuple), NotImplemented when it does not apply (PY5b)"] [72 44 "// __rdivmod__, called with the right operand first (PY5b)"] [73 44 "// __index__, an *Int"] [74 44 "// __int__"] [75 44 "// __float__"] [77 62 "// __get__; obj nil: from the class"] [78 62 "// __set__; v nil: __delete__"] [80 2 "// Format is __format__ (format(o, spec), f-strings): PY5c fills it (the format mini-language)"] [83 68 "// __new__"] [84 68 "// __init__"] [94 1 "// IsSubtype is t's MRO containing u (PyType_IsSubtype)."] [107 1 "// Lookup finds name in the dictionaries of t's MRO (_PyType_Lookup); nil when absent."] [119 1 "// IsInstance is o's type a subtype of t."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[111 31]]} (go/file "type.go" :imports [])






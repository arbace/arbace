(in-ns 'go.arbace.py) ^{:go/comments [[3 1 "// Type is a Python type object (CPython's PyTypeObject): its name, bases and MRO, its dictionary,"] [4 1 "// and the slots, the protocol functions the machine calls. A built-in type sets its slots in Go; a"] [5 1 "// class's slots are filled from its dictionary's special methods (PY5c: slot wrappers, invalidated"] [6 1 "// on assignment as CPython's type version tags are)."] [8 18 "// __name__"] [9 18 "// __qualname__"] [10 18 "// __module__ (\"builtins\" for the built-in types)"] [11 18 "// __base__ (nil for object)"] [14 17 "// the type's namespace: methods, descriptors, attributes"] [17 2 "// Meta is the type's own type (type, or a metaclass: PY5c); nil means type."] [19 2 "// attrCache is lookupAttr's answers by name (absent ones too), valid while attrEpoch is typeEpoch (attr.go)"] [22 2 "// initFn is initInline's answer (eval.go; queue 210), valid while initEpoch is typeEpoch+1"] [25 2 "// watched: the C API's type watchers' bits (PyType_Watch); versioned: CPython's tp_version_tag set, kept only"] [26 2 "// once a type is watched (watchers.go, queue 274)"] [29 2 "// dictHint is the most entries an instance's dict of the class reached by store-attr (storeAttrAt), at most 32: a new"] [30 2 "// instance's dict made with that room (queue 305: the entries grown 1, 2, 4, 8 by __init__'s stores otherwise)"] [32 2 "// nameObj and qualObj: the str objects __name__ and __qualname__ last gave or were set to (ht_name, ht_qualname: one"] [33 2 "// object while the text stands; py-core-1124: inspect.classify_class_attrs finds a class's __name__ by identity)"] [37 1 "// TypeFlags are a type's properties, as CPython's tp_flags."] [41 40 "// may be subclassed"] [42 40 "// made by a class statement"] [43 40 "// the fast-subclass bits: isinstance checks without the MRO"] [51 2 "// FlagImmutable is Py_TPFLAGS_IMMUTABLETYPE on a heap class (PyType_Freeze, arbace/pyctypes; queue 270b)"] [55 1 "// ExtMutableType is a C extension's type made from a spec without Py_TPFLAGS_IMMUTABLETYPE (its attributes settable as"] [56 1 "// a heap type's; arbace/pyctypes, queue 270b)."] [59 1 "// typeImmutable is Py_TPFLAGS_IMMUTABLETYPE: a static type's, a frozen class's, a C type's made so."] [70 1 "// TypeImmutable is typeImmutable for arbace/pyctypes (PyType_Freeze's check of the bases)."] [73 1 "// Slots are a type's protocol functions (CPython's tp_* and the number, sequence and mapping"] [74 1 "// structs). A nil slot means the type does not support the protocol: the abstract functions"] [75 1 "// (abstract.go) fall back as CPython's do (the reflected operand, __eq__'s identity, ...)."] [76 1 "// Every function raises by returning a non-nil error."] [78 38 "// __repr__, a *Str"] [79 38 "// __str__; nil: Repr"] [80 38 "// __hash__; nil: identity (unhashable types set Unhashable)"] [81 2 "// Unhashable is __hash__ = None."] [83 42 "// __bool__; nil: Len, else true"] [84 42 "// __len__"] [86 62 "// NotImplemented when it does not apply"] [88 52 "// __getattribute__ (+ __getattr__); nil: GenericGetAttr"] [89 52 "// __setattr__; v nil: __delattr__"] [92 38 "// __iter__"] [93 2 "// Next is __next__: (nil, nil) at the end (StopIteration without a value)."] [96 47 "// __getitem__"] [97 47 "// __setitem__; v nil: __delitem__"] [98 47 "// __contains__"] [100 2 "// Number protocol: Binary[op] is the operator's method (a op b), RBinary[op] the reflected one"] [101 2 "// (b's __radd__ ...), InPlace[op] the in-place one; NotImplemented when it does not apply."] [106 47 "// __abs__ (PY5b)"] [107 47 "// pow(a, b, m), NotImplemented when it does not apply (PY5b)"] [108 47 "// __divmod__ (a tuple), NotImplemented when it does not apply (PY5b)"] [109 47 "// __rdivmod__, called with the right operand first (PY5b)"] [110 47 "// __index__, an *Int"] [111 47 "// __int__"] [112 47 "// __float__"] [114 62 "// __get__; obj nil: from the class"] [115 62 "// __set__; v nil: __delete__"] [117 2 "// Format is __format__ (format(o, spec), f-strings): PY5c fills it (the format mini-language)"] [120 68 "// __new__"] [121 68 "// __init__"] [131 1 "// IsSubtype is t's MRO containing u (PyType_IsSubtype)."] [144 1 "// Lookup finds name in the dictionaries of t's MRO (_PyType_Lookup); nil when absent."] [156 1 "// IsInstance is o's type a subtype of t."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[148 31]]} (go/file "type.go" :imports [])






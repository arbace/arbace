(in-ns 'go.arbace.py) ^{:go/comments [[3 1 "// Type is a Python type object (CPython's PyTypeObject): its name, bases and MRO, its dictionary,"] [4 1 "// and the slots, the protocol functions the machine calls. A built-in type sets its slots in Go; a"] [5 1 "// class's slots are filled from its dictionary's special methods (PY5c: slot wrappers, invalidated"] [6 1 "// on assignment as CPython's type version tags are)."] [8 18 "// __name__"] [9 18 "// __qualname__"] [10 18 "// __module__ (\"builtins\" for the built-in types)"] [11 18 "// __base__ (nil for object)"] [14 17 "// the type's namespace: methods, descriptors, attributes"] [17 2 "// Meta is the type's own type (type, or a metaclass: PY5c); nil means type."] [19 2 "// attrCache is lookupAttr's answers by name (absent ones too), valid while attrEpoch is typeEpoch (attr.go)"] [22 2 "// initFn is initInline's answer (eval.go; queue 210), valid while initEpoch is typeEpoch+1"] [27 1 "// TypeFlags are a type's properties, as CPython's tp_flags."] [31 40 "// may be subclassed"] [32 40 "// made by a class statement"] [33 40 "// the fast-subclass bits: isinstance checks without the MRO"] [43 1 "// Slots are a type's protocol functions (CPython's tp_* and the number, sequence and mapping"] [44 1 "// structs). A nil slot means the type does not support the protocol: the abstract functions"] [45 1 "// (abstract.go) fall back as CPython's do (the reflected operand, __eq__'s identity, ...)."] [46 1 "// Every function raises by returning a non-nil error."] [48 38 "// __repr__, a *Str"] [49 38 "// __str__; nil: Repr"] [50 38 "// __hash__; nil: identity (unhashable types set Unhashable)"] [51 2 "// Unhashable is __hash__ = None."] [53 42 "// __bool__; nil: Len, else true"] [54 42 "// __len__"] [56 62 "// NotImplemented when it does not apply"] [58 52 "// __getattribute__ (+ __getattr__); nil: GenericGetAttr"] [59 52 "// __setattr__; v nil: __delattr__"] [62 38 "// __iter__"] [63 2 "// Next is __next__: (nil, nil) at the end (StopIteration without a value)."] [66 47 "// __getitem__"] [67 47 "// __setitem__; v nil: __delitem__"] [68 47 "// __contains__"] [70 2 "// Number protocol: Binary[op] is the operator's method (a op b), RBinary[op] the reflected one"] [71 2 "// (b's __radd__ ...), InPlace[op] the in-place one; NotImplemented when it does not apply."] [76 47 "// __abs__ (PY5b)"] [77 47 "// pow(a, b, m), NotImplemented when it does not apply (PY5b)"] [78 47 "// __divmod__ (a tuple), NotImplemented when it does not apply (PY5b)"] [79 47 "// __rdivmod__, called with the right operand first (PY5b)"] [80 47 "// __index__, an *Int"] [81 47 "// __int__"] [82 47 "// __float__"] [84 62 "// __get__; obj nil: from the class"] [85 62 "// __set__; v nil: __delete__"] [87 2 "// Format is __format__ (format(o, spec), f-strings): PY5c fills it (the format mini-language)"] [90 68 "// __new__"] [91 68 "// __init__"] [101 1 "// IsSubtype is t's MRO containing u (PyType_IsSubtype)."] [114 1 "// Lookup finds name in the dictionaries of t's MRO (_PyType_Lookup); nil when absent."] [126 1 "// IsInstance is o's type a subtype of t."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[118 31]]} (go/file "type.go" :imports [])





^{:go/pos {:doc [3 1] :tok-pos [7 1]}} (go/type ^{:go/pos {:name-pos [7 6]}} Type "Type is a Python type object (CPython's PyTypeObject): its name, bases and MRO, its dictionary,\nand the slots, the protocol functions the machine calls. A built-in type sets its slots in Go; a\nclass's slots are filled from its dictionary's special methods (PY5c: slot wrappers, invalidated\non assignment as CPython's type version tags are).\n" ^{:go/pos {:lbrace [7 18] :rbrace [25 1] :struct [7 11]}} (struct

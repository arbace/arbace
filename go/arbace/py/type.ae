reflected one"] [65 2 "// (b's __radd__ ...), InPlace[op] the in-place one; NotImplemented when it does not apply."] [70 41 "// __index__, an *Int"] [71 41 "// __int__"] [72 41 "// __float__"] [74 62 "// __get__; obj nil: from the class"] [75 62 "// __set__; v nil: __delete__"] [77 68 "// __new__"] [78 68 "// __init__"] [88 1 "// IsSubtype is t's MRO containing u (PyType_IsSubtype)."] [101 1 "// Lookup finds name in the dictionaries of t's MRO (_PyType_Lookup); nil when absent."] [113 1 "// IsInstance is o's type a subtype of t."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[105 31]]} (go/file "type.go" :imports [])






lex 'imag'"] [473 2 "// complex_new's combination: a part is added only when it came from a complex, so that a zero's"] [474 2 "// sign survives (complex(1.0, -0.0) is (1-0j); REQUEST of PY6g for PY6-core)"] [495 1 "// ParseComplex is complex(s): \"1+2j\", \"-j\", \"(3e1-2.5j)\", \"inf\", surrounding whitespace."] [546 1 "// complexDeprecation is PyErr_WarnFormat(PyExc_DeprecationWarning, 1, msg): warnings.warn at the calling frame."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[36 25] [168 22] [168 45] [204 26] [294 64] [307 62] [314 27] [316 32] [318 30] [335 72] [344 86] [345 86] [403 23] [412 28] [413 54] [417 29] [427 28] [428 108] [434 28] [435 106] [441 28] [449 27] [514 24] [514 31]]} (go/file "complex.go" :imports [



(in-ns 'go.arbace.py) ^{:go/comments [[3 1 "// The exception types the builtins, sys and the import system raise that PY5b0's exc.go has not got"] [4 1 "// (PY5e). PY5b's exc.go completes the hierarchy: at the rebase onto it, this file goes (the names are"] [5 1 "// the ones exc.go's pattern gives, so the duplicates fail to compile rather than shadow)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis []} (go/file "builtins_exc.go" :imports [])

;; The exception types the builtins, sys and the import system raise that PY5b0's exc.go has not got
;; (PY5e). PY5b's exc.go completes the hierarchy: at the rebase onto it, this file goes (the names are
;; the ones exc.go's pattern gives, so the duplicates fail to compile rather than shadow).

^{:go/pos {:lparen [7 5] :rparen [12 1] :tok-pos [7 1]}} (go/var
  [^{:go/pos {:name-pos [8 2]}} ImportErrorType ^{:go/apos {1 [8 43]} :go/pos {:lparen [8 42] :rparen [8 107]}} (^{:go/pos {:name-pos [8 28]}} NewBuiltinType "ImportError" ^{:go/pos {:name-pos [8 58]}} ExceptionType ^{:go/pos {:op-pos [8 85]}} (bit-or ^{:go/pos {:name-pos [8 73]}} FlagBaseType ^{:go/pos {:name-pos [8 86]}} FlagExceptionSubclass))]
  [^{:go/pos {:name-pos [9 2]}} ModuleNotFoundErrorType ^{:go/apos {1 [9 43]} :go/pos {:lparen [9 42] :rparen [9 117]}} (^{:go/pos {:name-pos [9 28]}} NewBuiltinType "ModuleNotFoundError" ^{:go/pos {:name-pos [9 66]}} ImportErrorType ^{:go/pos {:op-pos [9 95]}} (bit-or ^{:go/pos {:name-pos [9 83]}} FlagBaseType ^{:go/pos {:name-pos [9 96]}} FlagExceptionSubclass))]
  [^{:go/pos {:name-pos [10 2]}} SyntaxErrorType ^{:go/apos {1 [10 43]} :go/pos {:lparen [10 42] :rparen [10 107]}} (^{:go/pos {:name-pos [10 28]}} NewBuiltinType "SyntaxError" ^{:go/pos {:name-pos [10 58]}} ExceptionType ^{:go/pos {:op-pos [10 85]}} (bit-or ^{:go/pos {:name-pos [10 73]}} FlagBaseType ^{:go/pos {:name-pos [10 86]}} FlagExceptionSubclass))]
  [^{:go/pos {:name-pos [11 2]}} EOFErrorType ^{:go/apos {1 [11 43]} :go/pos {:lparen [11 42] :rparen [11 104]}} (^{:go/pos {:name-pos [11 28]}} NewBuiltinType "EOFError" ^{:go/pos {:name-pos [11 55]}} ExceptionType ^{:go/pos {:op-pos [11 82]}} (bit-or ^{:go/pos {:name-pos [11 70]}} FlagBaseType ^{:go/pos {:name-pos [11 83]}} FlagExceptionSubclass))])

(in-ns 'go.arbace.py) ^{:go/comments [[7 1 "// PEP 734's interpreters (queue 230; doc/python/PYTHON-SURVEY.md, \"Design: 230\"): several Interps in one process over"] [8 1 "// the one GIL, CPython 3.14.10's Python/crossinterp.c, Python/crossinterp_data_lookup.h, Python/crossinterp_exceptions.h"] [9 1 "// and Modules/_interpretersmodule.c ported. An interpreter's state is its *Interp, reached through current.Interp as"] [10 1 "// before; nothing here runs in a program that creates no interpreter, but the comparison in gil.take (interpSwitch) and"] [11 1 "// finTrack's owner. A session (_PyXI_Enter, _PyXI_Exit) runs on the calling goroutine under a new *Thread of the target"] [12 1 "// interpreter: one OS thread, two thread states, as CPython's."] [23 1 "// interpConfig is PyInterpreterConfig. gil: \"default\", \"shared\" or \"own\": pyi has the one GIL (the design's table), the"] [24 1 "// value is data."] [30 1 "// xiState is an Interp's state for interpreters: what CPython keeps in PyInterpreterState beyond the module table."] [38 32 "// __main__.__loader__ set (the first session)"] [39 32 "// threads started and not finished (_thread._count)"] [40 32 "// the heap types' getters (_PyXIData_RegisterClass)"] [41 32 "// sync_module's per-interpreter cache, by __main__'s file"] [43 27 "// _interpqueues' module state"] [44 27 "// _interpchannels' module state"] [47 1 "// interpRegs are the active interpreter's registers (the design's table): package variables the hot paths read, an"] [48 1 "// interpreter's own, swapped by interpSwitch."] [54 2 "// the module states a native module keeps in package variables: _asyncio's, _csv's, os.register_at_fork's"] [58 2 "// maxStrDigits: sys.set_int_max_str_digits' limit, each interpreter's own (interp->long_state; py-eval-1122)"] [65 25 "// the live interpreters, oldest first"] [67 2 "// xiEndHooks run when an interpreter ends (the queues' and the channels' items unbound)"] [71 1 "// interpSwitch makes in's registers the active ones."] [87 1 "// switchThread makes t the running thread on this goroutine (PyThreadState_Swap)."] [100 41 "// the main interpreter has its own GIL, as CPython's reports it"] [103 1 "// namedConfig is init_named_config."] [107 94 "// _PyInterpreterConfig_INIT"] [129 1 "// update is _PyInterpreterConfig_UpdateFromDict (all: _InitFromDict, every field required)."] [201 1 "// newSubInterp is Py_NewInterpreterFromConfig: init_interp_settings' checks, then a fresh Interp: its sys, importlib and"] [202 1 "// the rest fill in at its first import, its __main__ exists at once."] [213 2 "// the limit the configuration gives (-X int_max_str_digits, PYTHONINTMAXSTRDIGITS, else 4300), not the main interpreter's"] [214 2 "// current one (py-eval-1122: test_int's test_int_max_str_digits_is_per_interpreter)"] [222 32 "// a new __main__'s, as pylifecycle.c's add_main_module leaves it"] [229 1 "// end is Py_EndInterpreter: the non-daemon threads joined, atexit's functions run, the streams flushed; the interpreter"] [230 1 "// leaves the table and its items in the queues and channels are unbound."] [275 1 "// isRunningMain is is_running_main: a thread runs __main__."] [278 1 "// the static exceptions (crossinterp_exceptions.h), made on first use: shared as CPython's static types are; pyi's"] [279 1 "// NotShareableError is shared too (CPython's heap type per interpreter), so `except` matches across a session"] [318 1 "// notShareable is set_notshareableerror with a cause."] [328 1 "// xiLookupFailure is _set_xid_lookup_failure."] [343 1 "// xiUnwrap is _PyXI_UnwrapNotShareableError: a NotShareableError's cause raised in its place."] [351 1 "// xiData is _PyXIData_t: the owner's id, new_object as a closure over a copy of the data, the release of what it binds."] [367 1 "// xiGetter is _PyXIData_getdata_t."] [372 1 "// xiLookup is lookup_getdata by the object's exact type."] [449 1 "// xiBufferViewType is _interpreters' XIBufferView: what a shared memoryview's obj shows."] [466 16 "// queue 249: the other interpreter's view holds no export of its own"] [471 1 "// xiGetBasic is _get_xidata."] [485 1 "// xiGetData is _PyObject_GetXIData; fallback: _PyXIDATA_FULL_FALLBACK."] [510 1 "// xiMainFile is _Py_GetMainfile: __main__.__file__, \"\" when none."] [520 1 "// xiPickleData is _PyPickle_GetXIData."] [541 1 "// xiMissingMainAttr is check_missing___main___attr."] [551 1 "// xiPickleLoads is _PyPickle_Loads: on a missing __main__ attribute, once more with a __main__ loaded from the original"] [552 1 "// file under a bogus name, cached per interpreter (ensure_isolated_main)."] [597 1 "// xiGlobalNames counts co's LOAD_GLOBALs (identify_unbound_names): in globals, in builtins, neither."] [616 1 "// xiVerifyStateless is _PyCode_VerifyStateless."] [631 1 "// xiVerifyFunction is _PyFunction_VerifyStateless."] [645 1 "// xiReturnsOnlyNone is _PyCode_ReturnsOnlyNone: no generator, each return's value the constant None."] [665 1 "// xiFunctionData is _PyFunction_GetXIData: only stateless functions; the code shared (marshal's copy would equal it),"] [666 1 "// a new function over the running __main__'s globals on the other side."] [690 1 "// xiScript is get_script_xidata (pure 0): the code of a function, a code object or a compiled text."] [733 1 "// xiExcInfo is _PyXI_excinfo."] [757 2 "// a traceback.TracebackException, formatted"] [786 1 "// format is _PyXI_excinfo_format, \"\" and false for None."] [808 1 "// asObject is _PyXI_excinfo_AsObject."] [836 1 "// apply is _PyXI_excinfo_Apply: exc of t with the snapshot's text."] [845 1 "// xiSession is _PyXI_session."] [852 1 "// xiEnter is _enter_session and _PyInterpreterState_SetRunningMain."] [867 3 "// init_importlib's part a new __main__ shows: its __loader__ is BuiltinImporter"] [880 1 "// exit is _exit_session."] [917 1 "// xiSharedNS is _create_sharedns and _fill_sharedns (no fallback)."] [927 3 "// _copy_string_obj_raw: the name as UTF-8 (PyUnicode_AsUTF8AndSize: a lone surrogate's UnicodeEncodeError)"] [947 1 "// xiCall is struct interp_call; xiRun is _run_in_interpreter."] [977 3 "// a dict goes by pickle (no getter for it)"] [992 1 "// wrapNotShareable is wrap_notshareable."] [1000 1 "// xiFailure is the override of a session's error: 0 uncaught, else its _PyXI_errcode's meaning."] [1008 1 "// xiApplyNotShareable is _PyXI_ApplyError's _PyXI_ERR_NOT_SHAREABLE."] [1017 1 "// xiRun runs a script (code) or a call in in, the updates applied to __main__ first: the result, the excinfo of an"] [1018 1 "// uncaught exception, or err raised directly."] [1084 2 "// the preserved result: a copy when the session switched interpreters"] [1136 1 "// xiProtect runs f with a Go panic as a SystemError, so that the session always exits."] [1168 1 "// interpID is _PyInterpreterState_ObjectToID."] [1203 1 "// resolveInterp is resolve_interp (every pyi interpreter is ready once made)."] [1572 1 "// ExtSubinterp is a legacy subinterpreter made through the C API (py-eval-1122: pyctypes' Py_NewInterpreter, for"] [1573 1 "// _testcapi's run_in_subinterp): the interpreter and the session the calling thread entered it with."] [1579 1 "// ExtNewInterpreter is Py_NewInterpreter: a legacy subinterpreter (whenceLegacyCAPI, the \"legacy\" config), entered by the"] [1580 1 "// calling thread, whose thread state is the new interpreter's until ExtEndInterpreter."] [1598 1 "// ExtEndInterpreter is Py_EndInterpreter: the session left (the thread back in the interpreter it came from), then the"] [1599 1 "// interpreter ended (its threads joined, its atexit functions run)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[76 22] [132 53] [153 28] [168 20] [182 22] [183 42] [216 36] [307 27] [345 20] [375 39] [404 58] [491 27] [492 31] [496 28] [512 65] [513 47] [578 25] [579 62] [668 31] [676 55] [704 24] [720 43] [749 49] [750 23] [754 23] [825 24] [869 52] [870 55] [871 31] [888 26] [906 53] [928 43] [961 28] [967 34] [971 27] [972 41] [976 28] [978 45] [1021 28] [1023 32] [1064 44] [1070 47] [10
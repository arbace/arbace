(in-ns 'go.arbace.py) ^{:go/comments [[7 1 "// PEP 734's interpreters (queue 230; doc/python/PYTHON-SURVEY.md, \"Design: 230\"): several Interps in one process over"] [8 1 "// the one GIL, CPython 3.14.10's Python/crossinterp.c, Python/crossinterp_data_lookup.h, Python/crossinterp_exceptions.h"] [9 1 "// and Modules/_interpretersmodule.c ported. An interpreter's state is its *Interp, reached through current.Interp as"] [10 1 "// before; nothing here runs in a program that creates no interpreter, but the comparison in gil.take (interpSwitch) and"] [11 1 "// finTrack's owner. A session (_PyXI_Enter, _PyXI_Exit) runs on the calling goroutine under a new *Thread of the target"] [12 1 "// interpreter: one OS thread, two thread states, as CPython's."] [23 1 "// interpConfig is PyInterpreterConfig. gil: \"default\", \"shared\" or \"own\": pyi has the one GIL (the design's table), the"] [24 1 "// value is data."] [30 1 "// xiState is an Interp's state for interpreters: what CPython keeps in PyInterpreterState beyond the module table."] [38 32 "// __main__.__loader__ set (the first session)"] [39 32 "// threads started and not finished (_thread._count)"] [40 32 "// the heap types' getters (_PyXIData_RegisterClass)"] [41 32 "// sync_module's per-interpreter cache, by __main__'s file"] [43 27 "// _interpqueues' module state"] [44 27 "// _interpchannels' module state"] [47 1 "// interpRegs are the active interpreter's registers (the design's table): package variables the hot paths read, an"] [48 1 "// interpreter's own, swapped by interpSwitch."] [54 2 "// the module states a native module keeps in package variables: _asyncio's, _csv's, os.register_at_fork's"] [63 25 "// the live interpreters, oldest first"] [65 2 "// xiEndHooks run when an interpreter ends (the queues' and the channels' items unbound)"] [69 1 "// interpSwitch makes in's registers the active ones."] [84 1 "// switchThread makes t the running thread on this goroutine (PyThreadState_Swap)."] [97 41 "// the main interpreter has its own GIL, as CPython's reports it"] [100 1 "// namedConfig is init_named_config."] [104 94 "// _PyInterpreterConfig_INIT"] [126 1 "// update is _PyInterpreterConfig_UpdateFromDict (all: _InitFromDict, every field required)."] [198 1 "// newSubInterp is Py_NewInterpreterFromConfig: init_interp_settings' checks, then a fresh Interp: its sys, importlib and"] [199 1 "// the rest fill in at its first import, its __main__ exists at once."] [219 1 "// end is Py_EndInterpreter: the non-daemon threads joined, atexit's functions run, the streams flushed; the interpreter"] [220 1 "// leaves the table and its items in the queues and channels are unbound."] [265 1 "// isRunningMain is is_running_main: a thread runs __main__."] [268 1 "// the static exceptions (crossinterp_exceptions.h), made on first use: shared as CPython's static types are; pyi's"] [269 1 "// NotShareableError is shared too (CPython's heap type per interpreter), so `except` matches across a session"] [308 1 "// notShareable is set_notshareableerror with a cause."] [318 1 "// xiLookupFailure is _set_xid_lookup_failure."] [333 1 "// xiUnwrap is _PyXI_UnwrapNotShareableError: a NotShareableError's cause raised in its place."] [341 1 "// xiData is _PyXIData_t: the owner's id, new_object as a closure over a copy of the data, the release of what it binds."] [357 1 "// xiGetter is _PyXIData_getdata_t."] [362 1 "// xiLookup is lookup_getdata by the object's exact type."] [439 1 "// xiBufferViewType is _interpreters' XIBufferView: what a shared memoryview's obj shows."] [461 1 "// xiGetBasic is _get_xidata."] [475 1 "// xiGetData is _PyObject_GetXIData; fallback: _PyXIDATA_FULL_FALLBACK."] [500 1 "// xiMainFile is _Py_GetMainfile: __main__.__file__, \"\" when none."] [510 1 "// xiPickleData is _PyPickle_GetXIData."] [531 1 "// xiMissingMainAttr is check_missing___main___attr."] [541 1 "// xiPickleLoads is _PyPickle_Loads: on a missing __main__ attribute, once more with a __main__ loaded from the original"] [542 1 "// file under a bogus name, cached per interpreter (ensure_isolated_main)."] [587 1 "// xiGlobalNames counts co's LOAD_GLOBALs (identify_unbound_names): in globals, in builtins, neither."] [606 1 "// xiVerifyStateless is _PyCode_VerifyStateless."] [621 1 "// xiVerifyFunction is _PyFunction_VerifyStateless."] [635 1 "// xiReturnsOnlyNone is _PyCode_ReturnsOnlyNone: no generator, each return's value the constant None."] [655 1 "// xiFunctionData is _PyFunction_GetXIData: only stateless functions; the code shared (marshal's copy would equal it),"] [656 1 "// a new function over the running __main__'s globals on the other side."] [680 1 "// xiScript is get_script_xidata (pure 0): the code of a function, a code object or a compiled text."] [723 1 "// xiExcInfo is _PyXI_excinfo."] [747 2 "// a traceback.TracebackException, formatted"] [776 1 "// format is _PyXI_excinfo_format, \"\" and false for None."] [798 1 "// asObject is _PyXI_excinfo_AsObject."] [826 1 "// apply is _PyXI_excinfo_Apply: exc of t with the snapshot's text."] [835 1 "// xiSession is _PyXI_session."] [842 1 "// xiEnter is _enter_session and _PyInterpreterState_SetRunningMain."] [857 3 "// init_importlib's part a new __main__ shows: its __loader__ is BuiltinImporter"] [870 1 "// exit is _exit_session."] [907 1 "// xiSharedNS is _create_sharedns and _fill_sharedns (no fallback)."] [932 1 "// xiCall is struct interp_call; xiRun is _run_in_interpreter."] [962 3 "// a dict goes by pickle (no getter for it)"] [977 1 "// wrapNotShareable is wrap_notshareable."] [985 1 "// xiFailure is the override of a session's error: 0 uncaught, else its _PyXI_errcode's meaning."] [993 1 "// xiApplyNotShareable is _PyXI_ApplyError's _PyXI_ERR_NOT_SHAREABLE."] [1002 1 "// xiRun runs a script (code) or a call in in, the updates applied to __main__ first: the result, the excinfo of an"] [1003 1 "// uncaught exception, or err raised directly."] [1069 2 "// the preserved result: a copy when the session switched interpreters"] [1121 1 "// xiProtect runs f with a Go panic as a SystemError, so that the session always exits."] [1153 1 "// interpID is _PyInterpreterState_ObjectToID."] [1188 1 "// resolveInterp is resolve_interp (every pyi interpreter is ready once made)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[74 22] [129 53] [150 28] [165 20] [179 22] [180 42] [297 27] [335 20] [365 39] [394 58] [481 27] [482 31] [486 28] [502 65] [503 47] [568 25] [569 62] [658 31] [666 55] [694 24] [710 43] [739 49] [740 23] [744 23] [815 24] [859 52] [860 55] [861 31] [878 26] [896 53] [946 28] [952 34] [956 27] [957 41] [961 28] [963 45] [1006 28] [1008 32] [1049 44] [1055 47] [1073 38] [1085 24] [1124 20] [1132 20] [1133 23] [1143 28] [1157 27] [1182 27] [1195 34] [1202 33] [1244 44] [1258 33] [1310 78] [1373 30] [1382 27] [1402 24] [1420 30] [1425 29] [1507 30] [1538 45] [1543 40]]} (go/file "interpreters.go" :imports [



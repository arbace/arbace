(in-ns 'go.arbace.py) ^{:go/comments [[7 1 "// PEP 734's interpreters (queue 230; doc/python/PYTHON-SURVEY.md, \"Design: 230\"): several Interps in one process over"] [8 1 "// the one GIL, CPython 3.14.10's Python/crossinterp.c, Python/crossinterp_data_lookup.h, Python/crossinterp_exceptions.h"] [9 1 "// and Modules/_interpretersmodule.c ported. An interpreter's state is its *Interp, reached through current.Interp as"] [10 1 "// before; nothing here runs in a program that creates no interpreter, but the comparison in gil.take (interpSwitch) and"] [11 1 "// finTrack's owner. A session (_PyXI_Enter, _PyXI_Exit) runs on the calling goroutine under a new *Thread of the target"] [12 1 "// interpreter: one OS thread, two thread states, as CPython's."] [23 1 "// interpConfig is PyInterpreterConfig. gil: \"default\", \"shared\" or \"own\": pyi has the one GIL (the design's table), the"] [24 1 "// value is data."] [30 1 "// xiState is an Interp's state for interpreters: what CPython keeps in PyInterpreterState beyond the module table."] [38 32 "// threads started and not finished (_thread._count)"] [39 32 "// the heap types' getters (_PyXIData_RegisterClass)"] [40 32 "// sync_module's per-interpreter cache, by __main__'s file"] [42 27 "// _interpqueues' module state"] [43 27 "// _interpchannels' module state"] [46 1 "// interpRegs are the active interpreter's registers (the design's table): package variables the hot paths read, an"] [47 1 "// interpreter's own, swapped by interpSwitch."] [58 25 "// the live interpreters, oldest first"] [60 2 "// xiEndHooks run when an interpreter ends (the queues' and the channels' items unbound)"] [64 1 "// interpSwitch makes in's registers the active ones."] [78 1 "// switchThread makes t the running thread on this goroutine (PyThreadState_Swap)."] [94 1 "// namedConfig is init_named_config."] [120 1 "// update is _PyInterpreterConfig_UpdateFromDict (all: _InitFromDict, every field required)."] [189 1 "// newSubInterp is Py_NewInterpreterFromConfig: init_interp_settings' checks, then a fresh Interp: its sys, importlib and"] [190 1 "// the rest fill in at its first import, its __main__ exists at once."] [210 1 "// end is Py_EndInterpreter: the non-daemon threads joined, atexit's functions run, the streams flushed; the interpreter"] [211 1 "// leaves the table and its items in the queues and channels are unbound."] [256 1 "// isRunningMain is is_running_main: a thread runs __main__."] [259 1 "// the static exceptions (crossinterp_exceptions.h), made on first use: shared as CPython's static types are; pyi's"] [260 1 "// NotShareableError is shared too (CPython's heap type per interpreter), so `except` matches across a session"] [299 1 "// notShareable is set_notshareableerror with a cause."] [309 1 "// xiLookupFailure is _set_xid_lookup_failure."] [324 1 "// xiUnwrap is _PyXI_UnwrapNotShareableError: a NotShareableError's cause raised in its place."] [332 1 "// xiData is _PyXIData_t: the owner's id, new_object as a closure over a copy of the data, the release of what it binds."] [348 1 "// xiGetter is _PyXIData_getdata_t."] [353 1 "// xiLookup is lookup_getdata by the object's exact type."] [430 1 "// xiBufferViewType is _interpreters' XIBufferView: what a shared memoryview's obj shows."] [452 1 "// xiGetBasic is _get_xidata."] [466 1 "// xiGetData is _PyObject_GetXIData; fallback: _PyXIDATA_FULL_FALLBACK."] [491 1 "// xiMainFile is _Py_GetMainfile: __main__.__file__, \"\" when none."] [501 1 "// xiPickleData is _PyPickle_GetXIData."] [522 1 "// xiMissingMainAttr is check_missing___main___attr."] [532 1 "// xiPickleLoads is _PyPickle_Loads: on a missing __main__ attribute, once more with a __main__ loaded from the original"] [533 1 "// file under a bogus name, cached per interpreter (ensure_isolated_main)."] [578 1 "// xiGlobalNames counts co's LOAD_GLOBALs (identify_unbound_names): in globals, in builtins, neither."] [597 1 "// xiVerifyStateless is _PyCode_VerifyStateless."] [612 1 "// xiVerifyFunction is _PyFunction_VerifyStateless."] [626 1 "// xiReturnsOnlyNone is _PyCode_ReturnsOnlyNone: no generator, each return's value the constant None."] [646 1 "// xiFunctionData is _PyFunction_GetXIData: only stateless functions; the code shared (marshal's copy would equal it),"] [647 1 "// a new function over the running __main__'s globals on the other side."] [671 1 "// xiScript is get_script_xidata (pure 0): the code of a function, a code object or a compiled text."] [714 1 "// xiExcInfo is _PyXI_excinfo."] [738 2 "// a traceback.TracebackException, formatted"] [767 1 "// format is _PyXI_excinfo_format, \"\" and false for None."] [789 1 "// asObject is _PyXI_excinfo_AsObject."] [817 1 "// apply is _PyXI_excinfo_Apply: exc of t with the snapshot's text."] [826 1 "// xiSession is _PyXI_session."] [833 1 "// xiEnter is _enter_session and _PyInterpreterState_SetRunningMain."] [850 1 "// exit is _exit_session."] [887 1 "// xiSharedNS is _create_sharedns and _fill_sharedns (no fallback)."] [912 1 "// xiCall is struct interp_call; xiRun is _run_in_interpreter."] [942 3 "// a dict goes by pickle (no getter for it)"] [957 1 "// wrapNotShareable is wrap_notshareable."] [965 1 "// xiFailure is the override of a session's error: 0 uncaught, else its _PyXI_errcode's meaning."] [973 1 "// xiApplyNotShareable is _PyXI_ApplyError's _PyXI_ERR_NOT_SHAREABLE."] [982 1 "// xiRun runs a script (code) or a call in in, the updates applied to __main__ first: the result, the excinfo of an"] [983 1 "// uncaught exception, or err raised directly."] [1047 2 "// the preserved result: a copy when the session switched interpreters"] [1121 1 "// interpID is _PyInterpreterState_ObjectToID."] [1156 1 "// resolveInterp is resolve_interp (every pyi interpreter is ready once made)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[69 22] [123 53] [144 28] [159 20] [173 22] [288 27] [326 20] [356 39] [385 58] [472 27] [473 31] [477 28] [493 65] [494 47] [559 25] [560 62] [649 31] [657 55] [685 24] [701 43] [730 49] [731 23] [735 23] [806 24] [858 26] [876 53] [926 28] [932 34] [936 27] [937 41] [941 28] [943 45] [986 28] [988 32] [1027 44] [1033 47] [1051 38] [1063 24] [1100 20] [1101 23] [1111 28] [1125 27] [1150 27] [1163 34] [1170 33] [1223 33] [1275 78] [1338 30] [1347 27] [1367 24] [1385 30] [1390 29] [1472 30] [1503 45] [1508 40]]} (go/file "interpreters.go" :imports [



(in-ns 'go.arbace.py) ^{:go/comments [[7 1 "// PEP 734's interpreters (queue 230; doc/python/PYTHON-SURVEY.md, \"Design: 230\"): several Interps in one process over"] [8 1 "// the one GIL, CPython 3.14.10's Python/crossinterp.c, Python/crossinterp_data_lookup.h, Python/crossinterp_exceptions.h"] [9 1 "// and Modules/_interpretersmodule.c ported. An interpreter's state is its *Interp, reached through current.Interp as"] [10 1 "// before; nothing here runs in a program that creates no interpreter, but the comparison in gil.take (interpSwitch) and"] [11 1 "// finTrack's owner. A session (_PyXI_Enter, _PyXI_Exit) runs on the calling goroutine under a new *Thread of the target"] [12 1 "// interpreter: one OS thread, two thread states, as CPython's."] [23 1 "// interpConfig is PyInterpreterConfig. gil: \"default\", \"shared\" or \"own\": pyi has the one GIL (the design's table), the"] [24 1 "// value is data."] [30 1 "// xiState is an Interp's state for interpreters: what CPython keeps in PyInterpreterState beyond the module table."] [38 32 "// __main__.__loader__ set (the first session)"] [39 32 "// threads started and not finished (_thread._count)"] [40 32 "// the heap types' getters (_PyXIData_RegisterClass)"] [41 32 "// sync_module's per-interpreter cache, by __main__'s file"] [43 27 "// _interpqueues' module state"] [44 27 "// _interpchannels' module state"] [47 1 "// interpRegs are the active interpreter's registers (the design's table): package variables the hot paths read, an"] [48 1 "// interpreter's own, swapped by interpSwitch."] [54 2 "// the module states a native module keeps in package variables: _asyncio's, _csv's, os.register_at_fork's"] [63 25 "// the live interpreters, oldest first"] [65 2 "// xiEndHooks run when an interpreter ends (the queues' and the channels' items unbound)"] [69 1 "// interpSwitch makes in's registers the active ones."] [84 1 "// switchThread makes t the running thread on this goroutine (PyThreadState_Swap)."] [97 41 "// the main interpreter has its own GIL, as CPython's reports it"] [100 1 "// namedConfig is init_named_config."] [104 94 "// _PyInterpreterConfig_INIT"] [126 1 "// update is _PyInterpreterConfig_UpdateFromDict (all: _InitFromDict, every field required)."] [198 1 "// newSubInterp is Py_NewInterpreterFromConfig: init_interp_settings' checks, then a fresh Interp: its sys, importlib and"] [199 1 "// the rest fill in at its first import, its __main__ exists at once."] [213 32 "// a new __main__'s, as pylifecycle.c's add_main_module leaves it"] [220 1 "// end is Py_EndInterpreter: the non-daemon threads joined, atexit's functions run, the streams flushed; the interpreter"] [221 1 "// leaves the table and its items in the queues and channels are unbound."] [266 1 "// isRunningMain is is_running_main: a thread runs __main__."] [269 1 "// the static exceptions (crossinterp_exceptions.h), made on first use: shared as CPython's static types are; pyi's"] [270 1 "// NotShareableError is shared too (CPython's heap type per interpreter), so `except` matches across a session"] [309 1 "// notShareable is set_notshareableerror with a cause."] [319 1 "// xiLookupFailure is _set_xid_lookup_failure."] [334 1 "// xiUnwrap is _PyXI_UnwrapNotShareableError: a NotShareableError's cause raised in its place."] [342 1 "// xiData is _PyXIData_t: the owner's id, new_object as a closure over a copy of the data, the release of what it binds."] [358 1 "// xiGetter is _PyXIData_getdata_t."] [363 1 "// xiLookup is lookup_getdata by the object's exact type."] [440 1 "// xiBufferViewType is _interpreters' XIBufferView: what a shared memoryview's obj shows."] [457 16 "// queue 249: the other interpreter's view holds no export of its own"] [462 1 "// xiGetBasic is _get_xidata."] [476 1 "// xiGetData is _PyObject_GetXIData; fallback: _PyXIDATA_FULL_FALLBACK."] [501 1 "// xiMainFile is _Py_GetMainfile: __main__.__file__, \"\" when none."] [511 1 "// xiPickleData is _PyPickle_GetXIData."] [532 1 "// xiMissingMainAttr is check_missing___main___attr."] [542 1 "// xiPickleLoads is _PyPickle_Loads: on a missing __main__ attribute, once more with a __main__ loaded from the original"] [543 1 "// file under a bogus name, cached per interpreter (ensure_isolated_main)."] [588 1 "// xiGlobalNames counts co's LOAD_GLOBALs (identify_unbound_names): in globals, in builtins, neither."] [607 1 "// xiVerifyStateless is _PyCode_VerifyStateless."] [622 1 "// xiVerifyFunction is _PyFunction_VerifyStateless."] [636 1 "// xiReturnsOnlyNone is _PyCode_ReturnsOnlyNone: no generator, each return's value the constant None."] [656 1 "// xiFunctionData is _PyFunction_GetXIData: only stateless functions; the code shared (marshal's copy would equal it),"] [657 1 "// a new function over the running __main__'s globals on the other side."] [681 1 "// xiScript is get_script_xidata (pure 0): the code of a function, a code object or a compiled text."] [724 1 "// xiExcInfo is _PyXI_excinfo."] [748 2 "// a traceback.TracebackException, formatted"] [777 1 "// format is _PyXI_excinfo_format, \"\" and false for None."] [799 1 "// asObject is _PyXI_excinfo_AsObject."] [827 1 "// apply is _PyXI_excinfo_Apply: exc of t with the snapshot's text."] [836 1 "// xiSession is _PyXI_session."] [843 1 "// xiEnter is _enter_session and _PyInterpreterState_SetRunningMain."] [858 3 "// init_importlib's part a new __main__ shows: its __loader__ is BuiltinImporter"] [871 1 "// exit is _exit_session."] [908 1 "// xiSharedNS is _create_sharedns and _fill_sharedns (no fallback)."] [918 3 "// _copy_string_obj_raw: the name as UTF-8 (PyUnicode_AsUTF8AndSize: a lone surrogate's UnicodeEncodeError)"] [938 1 "// xiCall is struct interp_call; xiRun is _run_in_interpreter."] [968 3 "// a dict goes by pickle (no getter for it)"] [983 1 "// wrapNotShareable is wrap_notshareable."] [991 1 "// xiFailure is the override of a session's error: 0 uncaught, else its _PyXI_errcode's meaning."] [999 1 "// xiApplyNotShareable is _PyXI_ApplyError's _PyXI_ERR_NOT_SHAREABLE."] [1008 1 "// xiRun runs a script (code) or a call in in, the updates applied to __main__ first: the result, the excinfo of an"] [1009 1 "// uncaught exception, or err raised directly."] [1075 2 "// the preserved result: a copy when the session switched interpreters"] [1127 1 "// xiProtect runs f with a Go panic as a SystemError, so that the session always exits."] [1159 1 "// interpID is _PyInterpreterState_ObjectToID."] [1194 1 "// resolveInterp is resolve_interp (every pyi interpreter is ready once made)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[74 22] [129 53] [150 28] [165 20] [179 22] [180 42] [298 27] [336 20] [366 39] [395 58] [482 27] [483 31] [487 28] [503 65] [504 47] [569 25] [570 62] [659 31] [667 55] [695 24] [711 43] [740 49] [741 23] [745 23] [816 24] [860 52] [861 55] [862 31] [879 26] [897 53] [919 43] [952 28] [958 34] [962 27] [963 41] [967 28] [969 45] [1012 28] [1014 32] [1055 44] [1061 47] [1079 38] [1091 24] [1130 20] [1138 20] [1139 23] [1149 28] [1163 27] [1188 27] [1201 34] [1208 33] [1250 44] [1264 33] [1316 78] [1379 30] [1388 27] [1408 24] [1426 30] [1431 29] [1513 30] [1544 45] [1549 40]]} (go/file "interpreters.go" :imports [



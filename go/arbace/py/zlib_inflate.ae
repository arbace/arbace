from window"] [911 13 "// copy from output"] [991 2 "// inf_leave: RESTORE, then the window, the totals and the check value updated"] [1024 1 "// SetDictionary is inflateSetDictionary."] [1029 2 "// check for correct dictionary identifier"] [1035 2 "// copy dictionary to window using updatewindow(), which will amend the existing"] [1036 2 "// dictionary if appropriate"] [1042 1 "// zlInflateTable is inftrees.c's inflate_table: the decoding table of the code lengths lens into"] [1043 1 "// table from *next, *next and *bits updated as zlib's *table and *bits are."] [1063 16 "// no symbols to code at all"] [1064 25 "// invalid code marker"] [1065 25 "// make a table to force an error"] [1070 12 "// no symbols, but wait for decoding to report error"] [1082 2 "// check for an over-subscribed or incomplete set of lengths"] [1088 14 "// over-subscribed"] [1092 13 "// incomplete set"] [1095 2 "// generate offsets into symbol table for each length for sorting"] [1101 2 "// sort symbols by length, by symbol order within each length"] [1109 2 "// set up for code type"] [1118 11 "// DISTS"] [1122 2 "// initialize state for loop"] [1123 21 "// starting code"] [1124 21 "// starting code symbol"] [1125 21 "// starting code length"] [1126 21 "// current table to fill in"] [1127 21 "// current table index bits"] [1128 21 "// current bits to drop from code for index"] [1129 21 "// trigger new sub-table when len > root"] [1130 21 "// use root table entries"] [1131 21 "// mask for comparing low"] [1133 2 "// check available table space"] [1138 2 "// process all codes and make table entries"] [1140 3 "// create table entry"] [1149 31 "// end of block"] [1153 3 "// replicate for those indices with low len bits equal to huff"] [1156 14 "// save offset to next table"] [1165 3 "// backwards increment the len-bit code huff"] [1177 3 "// go to next symbol, update count, len"] [1187 3 "// create new sub-table if needed"] [1189 4 "// if first time, transition to sub-tables"] [1193 4 "// increment past last table"] [1194 16 "// here min is 1 << curr"] [1196 4 "// determine length of next table"] [1208 4 "// check for enough space"] [1214 4 "// point entry in root table to sub-table"] [1220 2 "// fill in remaining table entry if code is incomplete (guaranteed to have at most one"] [1221 2 "// remaining entry, since if the code is incomplete, the maximum code length that was"] [1222 2 "// allowed to get this far is one bit)"] [1224 44 "// invalid code marker"] [1227 2 "// set return parameters"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[100 13] [100 23] [161 32] [726 10] [726 18] [920 8] [920 16] [1049 14] [1049 27] [1055 6] [1055 16] [1073 6] [1073 17] [1084 12] [1084 28] [1097 12] [1097 27] [1102 14] [1102 27]]} (go/file "zlib_inflate.go" :imports [])


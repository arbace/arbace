(in-ns 'go.arbace.py) ^{:go/comments [[3 1 "// inflate.c, inflate.h, inftrees.c and inftrees.h of zlib 1.3.2, in zlib's names, without"] [4 1 "// inflate_fast (inffast.c): an equivalent faster path of the LEN state whose output and"] [5 1 "// consumption are the slow path's. A code (inftrees.h's code) is a uint32: op in bits 24-31,"] [6 1 "// bits in 16-23, val in 0-15."] [19 1 "// inflate_mode, in inflate.h's order."] [71 1 "// The fixed codes' tables, built as inftrees.c's buildtables builds them (BUILDFIXED)."] [113 1 "// zlInflater is zlib's inflate_state, with its z_stream S."] [135 16 "// lencode is zlFixed (else codes)"] [154 1 "// zlInflateInit2 is inflateInit2_: an inflater, or nil and Z_STREAM_ERROR for invalid window bits."] [157 18 "// to pass state test in inflateReset2()"] [164 1 "// ResetKeep is inflateResetKeep."] [170 19 "// to support ill-conceived Java test suite"] [187 1 "// Reset is inflateReset."] [195 1 "// Reset2 is inflateReset2."] [221 1 "// Copy is inflateCopy: a deep copy of the state and its stream."] [232 1 "// updatewindow: the last wsize bytes of output ending at end into the window."] [288 1 "// Inflate is inflate(strm, flush)."] [297 21 "// skip check"] [299 2 "// LOAD"] [307 2 "// pull is PULLBYTE without the leave: false when no input is left."] [318 2 "// need is NEEDBITS(n) without the leave."] [347 41 "// gzip header"] [357 24 "// check if zlib header allowed"] [379 16 "// indicate zlib header"] [540 5 "// RESTORE"] [566 12 "// stored block"] [568 12 "// fixed block"] [573 21 "// decode codes"] [578 12 "// dynamic block"] [586 19 "// go to byte boundary"] [730 4 "// handle error breaks in while"] [735 4 "// check for end-of-block code (better have one)"] [742 4 "// build code tables"] [890 23 "// copy from window"] [908 13 "// copy from output"] [988 2 "// inf_leave: RESTORE, then the window, the totals and the check value updated"] [1021 1 "// SetDictionary is inflateSetDictionary."] [1026 2 "// check for correct dictionary identifier"] [1032 2 "// copy dictionary to window using updatewindow(), which will amend the existing"] [1033 2 "// dictionary if appropriate"] [1039 1 "// zlInflateTable is inftrees.c's inflate_table: the decoding table of the code lengths lens into"] [1040 1 "// table from *next, *next and *bits updated as zlib's *table and *bits are."] [1060 16 "// no symbols to code at all"] [1061 25 "// invalid code marker"] [1062 25 "// make a table to force an error"] [1067 12 "// no symbols, but wait for decoding to report error"] [1079 2 "// check for an over-subscribed or incomplete set of lengths"] [1085 14 "// over-subscribed"] [1089 13 "// incomplete set"] [1092 2 "// generate offsets into symbol table for each length for sorting"] [1098 2 "// sort symbols by length, by symbol order within each length"] [1106 2 "// set up for code type"] [1115 11 "// DISTS"] [1119 2 "// initialize state for loop"] [1120 21 "// starting code"] [1121 21 "// starting code symbol"] [1122 21 "// starting code length"] [1123 21 "// current table to fill in"] [1124 21 "// current table index bits"] [1125 21 "// current bits to drop from code for index"] [1126 21 "// trigger new sub-table when len > root"] [1127 21 "// use root table entries"] [1128 21 "// mask for comparing low"] [1130 2 "// check available table space"] [1135 2 "// process all codes and make table entries"] [1137 3 "// create table entry"] [1146 31 "// end of block"] [1150 3 "// replicate for those indices with low len bits equal to huff"] [1153 14 "// save offset to next table"] [1162 3 "// backwards increment the len-bit code huff"] [1174 3 "// go to next symbol, update count, len"] [1184 3 "// create new sub-table if needed"] [1186 4 "// if first time, transition to sub-tables"] [1190 4 "// increment past last table"] [1191 16 "// here min is 1 << curr"] [1193 4 "// determine length of next table"] [1205 4 "// check for enough space"] [1211 4 "// point entry in root table to sub-table"] [1217 2 "// fill in remaining table entry if code is incomplete (guaranteed to have at most one"] [1218 2 "// remaining entry, since if the code is incomplete, the maximum code length that was"] [1219 2 "// allowed to get this far is one bit)"] [1221 44 "// invalid code marker"] [1224 2 "// set return parameters"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[97 13] [97 23] [158 32] [723 10] [723 18] [917 8] [917 16] [1046 14] [1046 27] [1052 6] [1052 16] [1070 6] [1070 17] [1081 12] [1081 28] [1094 12] [1094 27] [1099 14] [1099 27]]} (go/file "zlib_inflate.go" :imports [])


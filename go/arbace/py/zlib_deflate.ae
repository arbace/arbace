(in-ns 'go.arbace.py) ^{:go/comments [[3 1 "// zlib: Copyright (C) 1995-2026 Jean-loup Gailly and Mark Adler, under the zlib License (LICENSE.md). The port to Go"] [4 1 "// (PY6d, for builtins_zlib.go): Copyright (c) the Arbace authors, under the same zlib License."] [6 1 "// deflate.c and deflate.h of zlib 1.3.2, in zlib's names."] [23 2 "// block_state"] [29 2 "// compress functions of configuration_table"] [35 1 "// zlConfig is configuration_table: good_length, max_lazy, nice_length, max_chain, func."] [49 1 "// zlTreeDesc is tree_desc with its static_tree_desc."] [51 21 "// the tree's freq/code and dad/len"] [53 21 "// the static tree's lengths, or nil"] [60 1 "// zlDeflater is zlib's deflate_state, with its z_stream S."] [136 1 "// zlDeflateInit2 is deflateInit2_: a deflater, or nil and Z_STREAM_ERROR for invalid parameters."] [142 22 "// suppress zlib wrapper"] [149 12 "// write gzip wrapper instead"] [158 18 "// until 256-byte window bug fixed"] [174 2 "// pending_buf and sym_buf apart (zlib overlays them, never overlapping what it uses)"] [185 1 "// resetKeep is deflateResetKeep."] [194 20 "// was made negative by deflate(..., Z_FINISH)"] [198 16 "// crc32(0L, Z_NULL, 0)"] [201 16 "// adler32(0L, Z_NULL, 0)"] [207 1 "// Reset is deflateReset: deflateResetKeep, then lm_init."] [232 1 "// Params is deflateParams."] [241 3 "// Flush the last buffer"] [266 1 "// SetDictionary is deflateSetDictionary."] [276 2 "// when using zlib wrappers, compute Adler-32 for provided dictionary"] [280 13 "// avoid computing Adler-32 in read_buf"] [281 2 "// if dictionary would fill window, just replace the history"] [283 18 "// already empty otherwise"] [289 53 "// use the tail"] [291 2 "// insert dictionary into window and hash"] [324 1 "// Copy is deflateCopy: a deep copy of the state and its stream."] [355 1 "// insertString is INSERT_STRING: returns match_head."] [386 1 "// readBuf is read_buf: up to size bytes of input into buf."] [467 1 "// flushPending is flush_pending."] [501 1 "// Deflate is deflate(strm, flush)."] [517 2 "// Flush as much pending output as possible"] [527 2 "// User must not provide more input after the first FINISH"] [535 3 "// zlib header"] [553 3 "// Save the adler32 of the preset dictionary"] [560 3 "// Compression must start with an empty pending buffer"] [568 3 "// gzip header, without gzhead"] [587 3 "// Compression must start with an empty pending buffer"] [595 2 "// Start a new block or continue the current one."] [615 22 "// avoid BUF_ERROR next call, see above"] [622 35 "// FULL_FLUSH or SYNC_FLUSH"] [625 20 "// forget history"] [635 22 "// avoid BUF_ERROR at next call, see above"] [647 2 "// Write the trailer"] [662 2 "// If avail_out is zero, the application will call deflate again to flush the rest."] [664 20 "// write the trailer only once!"] [672 1 "// longestMatch is longest_match."] [740 1 "// flushBlockOnly is FLUSH_BLOCK_ONLY."] [773 1 "// deflateStored is deflate_stored: level 0, the input copied as stored blocks."] [785 32 "// bytes in header"] [786 32 "// need room for header"] [789 31 "// maximum stored block length that fits"] [803 3 "// replace the lengths in the dummy stored block with len"] [809 3 "// copy uncompressed bytes from the window to next_out"] [820 3 "// copy uncompressed bytes directly from next_in to next_out"] [831 23 "// number of input bytes directly copied"] [833 24 "// supplant the previous history"] [834 18 "// clear hash"] [840 5 "// slide the window down"] [844 18 "// add a pending slide_hash()"] [860 2 "// If the last block was written to next_out, then done."] [864 2 "// If flushing and all input has been consumed, then done."] [870 2 "// Fill the window with any remaining input."] [873 3 "// Slide the window down."] [878 16 "// add a pending slide_hash()"] [880 19 "// more space now"] [897 2 "// There was not enough avail_out to write a complete worthy or flushed stored block to"] [898 2 "// next_out. Write a stored block to pending instead, if we have enough input for a worthy"] [899 2 "// block, or if flushing and there is enough room for the remaining input as a stored block"] [900 2 "// in the pending buffer."] [901 31 "// bytes in header"] [920 1 "// flushBlock is FLUSH_BLOCK's tail: the state to return when avail_out is 0, else -1."] [932 1 "// finishBlocks is the common end of deflate_fast, deflate_slow, deflate_rle and deflate_huff."] [948 1 "// deflateFast is deflate_fast."] [958 11 "// flush the current block"] [971 4 "// max_insert_length is max_lazy_match"] [973 21 "// string at strstart already in table"] [1008 1 "// deflateSlow is deflate_slow."] [1018 11 "// flush the current block"] [1087 1 "// deflateRle is deflate_rle: run-length encoding, matches of distance one only."] [1098 11 "// flush the current block"] [1101 3 "// See how many times the previous byte repeats"] [1128 3 "// Emit match if have run of MIN_MATCH or longer, else emit literal"] [1149 1 "// deflateHuff is deflate_huff: Huffman coding alone (Z_HUFFMAN_ONLY)."] [1153 3 "// Make sure that we have a literal to write."] [1160 11 "// flush the current block"] [1163 3 "// Output a literal byte"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[701 15] [701 22] [935 29] [941 30] [995 31] [1055 32] [1111 16] [1111 23] [1140 31] [1169 31]] :go/trails [[46 34]]} (go/file "zlib_deflate.go" :imports [])


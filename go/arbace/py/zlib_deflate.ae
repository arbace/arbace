(in-ns 'go.arbace.py) ^{:go/comments [[3 1 "// deflate.c and deflate.h of zlib 1.3.2, in zlib's names."] [20 2 "// block_state"] [26 2 "// compress functions of configuration_table"] [32 1 "// zlConfig is configuration_table: good_length, max_lazy, nice_length, max_chain, func."] [46 1 "// zlTreeDesc is tree_desc with its static_tree_desc."] [48 21 "// the tree's freq/code and dad/len"] [50 21 "// the static tree's lengths, or nil"] [57 1 "// zlDeflater is zlib's deflate_state, with its z_stream S."] [133 1 "// zlDeflateInit2 is deflateInit2_: a deflater, or nil and Z_STREAM_ERROR for invalid parameters."] [139 22 "// suppress zlib wrapper"] [146 12 "// write gzip wrapper instead"] [155 18 "// until 256-byte window bug fixed"] [171 2 "// pending_buf and sym_buf apart (zlib overlays them, never overlapping what it uses)"] [182 1 "// resetKeep is deflateResetKeep."] [191 20 "// was made negative by deflate(..., Z_FINISH)"] [195 16 "// crc32(0L, Z_NULL, 0)"] [198 16 "// adler32(0L, Z_NULL, 0)"] [204 1 "// Reset is deflateReset: deflateResetKeep, then lm_init."] [229 1 "// Params is deflateParams."] [238 3 "// Flush the last buffer"] [263 1 "// SetDictionary is deflateSetDictionary."] [273 2 "// when using zlib wrappers, compute Adler-32 for provided dictionary"] [277 13 "// avoid computing Adler-32 in read_buf"] [278 2 "// if dictionary would fill window, just replace the history"] [280 18 "// already empty otherwise"] [286 53 "// use the tail"] [288 2 "// insert dictionary into window and hash"] [321 1 "// Copy is deflateCopy: a deep copy of the state and its stream."] [352 1 "// insertString is INSERT_STRING: returns match_head."] [383 1 "// readBuf is read_buf: up to size bytes of input into buf."] [464 1 "// flushPending is flush_pending."] [498 1 "// Deflate is deflate(strm, flush)."] [514 2 "// Flush as much pending output as possible"] [524 2 "// User must not provide more input after the first FINISH"] [532 3 "// zlib header"] [550 3 "// Save the adler32 of the preset dictionary"] [557 3 "// Compression must start with an empty pending buffer"] [565 3 "// gzip header, without gzhead"] [584 3 "// Compression must start with an empty pending buffer"] [592 2 "// Start a new block or continue the current one."] [612 22 "// avoid BUF_ERROR next call, see above"] [619 35 "// FULL_FLUSH or SYNC_FLUSH"] [622 20 "// forget history"] [632 22 "// avoid BUF_ERROR at next call, see above"] [644 2 "// Write the trailer"] [659 2 "// If avail_out is zero, the application will call deflate again to flush the rest."] [661 20 "// write the trailer only once!"] [669 1 "// longestMatch is longest_match."] [737 1 "// flushBlockOnly is FLUSH_BLOCK_ONLY."] [770 1 "// deflateStored is deflate_stored: level 0, the input copied as stored blocks."] [782 32 "// bytes in header"] [783 32 "// need room for header"] [786 31 "// maximum stored block length that fits"] [800 3 "// replace the lengths in the dummy stored block with len"] [806 3 "// copy uncompressed bytes from the window to next_out"] [817 3 "// copy uncompressed bytes directly from next_in to next_out"] [828 23 "// number of input bytes directly copied"] [830 24 "// supplant the previous history"] [831 18 "// clear hash"] [837 5 "// slide the window down"] [841 18 "// add a pending slide_hash()"] [857 2 "// If the last block was written to next_out, then done."] [861 2 "// If flushing and all input has been consumed, then done."] [867 2 "// Fill the window with any remaining input."] [870 3 "// Slide the window down."] [875 16 "// add a pending slide_hash()"] [877 19 "// more space now"] [894 2 "// There was not enough avail_out to write a complete worthy or flushed stored block to"] [895 2 "// next_out. Write a stored block to pending instead, if we have enough input for a worthy"] [896 2 "// block, or if flushing and there is enough room for the remaining input as a stored block"] [897 2 "// in the pending buffer."] [898 31 "// bytes in header"] [917 1 "// flushBlock is FLUSH_BLOCK's tail: the state to return when avail_out is 0, else -1."] [929 1 "// finishBlocks is the common end of deflate_fast, deflate_slow, deflate_rle and deflate_huff."] [945 1 "// deflateFast is deflate_fast."] [955 11 "// flush the current block"] [968 4 "// max_insert_length is max_lazy_match"] [970 21 "// string at strstart already in table"] [1005 1 "// deflateSlow is deflate_slow."] [1015 11 "// flush the current block"] [1084 1 "// deflateRle is deflate_rle: run-length encoding, matches of distance one only."] [1095 11 "// flush the current block"] [1098 3 "// See how many times the previous byte repeats"] [1125 3 "// Emit match if have run of MIN_MATCH or longer, else emit literal"] [1146 1 "// deflateHuff is deflate_huff: Huffman coding alone (Z_HUFFMAN_ONLY)."] [1150 3 "// Make sure that we have a literal to write."] [1157 11 "// flush the current block"] [1160 3 "// Output a literal byte"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[698 15] [698 22] [932 29] [938 30] [992 31] [1052 32] [1108 16] [1108 23] [1137 31] [1166 31]] :go/trails [[43 34]]} (go/file "zlib_deflate.go" :imports [])


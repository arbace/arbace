  [^{:go/pos {:name-pos [36 2]}} aotNatives ^{:go/pos {:lbrace [36 38] :rbrace [36 39]}} (lit ^{:go/pos {:map [36 15]}} (map ^{:go/pos {:name-pos [36 19]}} string ^{:go/pos {:lbrack [36 26]}} (slice ^{:go/pos {:name-pos [36 28]}} NativeFunc)))] ; the IR -> its code objects' native functions
  [^{:tag ^{:go/pos {:lbrace [37 19] :rbrace [37 86] :struct [37 13]}} (struct ^{:tag ^{:go/pos {:name-pos [37 82]}} int :go/pos {:name-pos [37 21]}} native ^{:tag ^{:go/pos {:name-pos [37 82]}} int :go/pos {:name-pos [37 29]}} interpreted ^{:tag ^{:go/pos {:name-pos [37 82]}} int :go/pos {:name-pos [37 42]}} hostCompiles ^{:tag ^{:go/pos {:name-pos [37 82]}} int :go/pos {:name-pos [37 56]}} hostRequests ^{:tag ^{:go/pos {:name-pos [37 82]}} int :go/pos {:name-pos [37 70]}} irCacheHits) :go/pos {:name-pos [37 2]}} aotStats])





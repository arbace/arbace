  [^{:go/pos {:name-pos [38 2]}} aotNatives ^{:go/pos {:lbrace [38 38] :rbrace [38 39]}} (lit ^{:go/pos {:map [38 15]}} (map ^{:go/pos {:name-pos [38 19]}} string ^{:go/pos {:lbrack [38 26]}} (slice ^{:go/pos {:name-pos [38 28]}} NativeFunc)))] ; the IR -> its code objects' native functions
  [^{:tag ^{:go/pos {:lbrace [39 19] :rbrace [39 86] :struct [39 13]}} (struct ^{:tag ^{:go/pos {:name-pos [39 82]}} int :go/pos {:name-pos [39 21]}} native ^{:tag ^{:go/pos {:name-pos [39 82]}} int :go/pos {:name-pos [39 29]}} interpreted ^{:tag ^{:go/pos {:name-pos [39 82]}} int :go/pos {:name-pos [39 42]}} hostCompiles ^{:tag ^{:go/pos {:name-pos [39 82]}} int :go/pos {:name-pos [39 56]}} hostRequests ^{:tag ^{:go/pos {:name-pos [39 82]}} int :go/pos {:name-pos [39 70]}} irCacheHits) :go/pos {:name-pos [39 2]}} aotStats])





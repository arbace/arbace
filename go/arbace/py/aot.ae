  [^{:go/pos {:name-pos [35 2]}} aotNatives ^{:go/pos {:lbrace [35 38] :rbrace [35 39]}} (lit ^{:go/pos {:map [35 15]}} (map ^{:go/pos {:name-pos [35 19]}} string ^{:go/pos {:lbrack [35 26]}} (slice ^{:go/pos {:name-pos [35 28]}} NativeFunc)))] ; the IR text -> its code objects' native functions
  [^{:tag ^{:go/pos {:lbrace [36 19] :rbrace [36 86] :struct [36 13]}} (struct ^{:tag ^{:go/pos {:name-pos [36 82]}} int :go/pos {:name-pos [36 21]}} native ^{:tag ^{:go/pos {:name-pos [36 82]}} int :go/pos {:name-pos [36 29]}} interpreted ^{:tag ^{:go/pos {:name-pos [36 82]}} int :go/pos {:name-pos [36 42]}} hostCompiles ^{:tag ^{:go/pos {:name-pos [36 82]}} int :go/pos {:name-pos [36 56]}} hostRequests ^{:tag ^{:go/pos {:name-pos [36 82]}} int :go/pos {:name-pos [36 70]}} irCacheHits) :go/pos {:name-pos [36 2]}} aotStats])





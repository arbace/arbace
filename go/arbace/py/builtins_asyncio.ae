(in-ns 'go.arbace.py) ^{:go/comments [[3 1 "// The module _asyncio (queue 224; Modules/_asynciomodule.c of CPython 3.14.10): the C Future and Task, FutureIter,"] [4 1 "// TaskStepMethWrapper, the running loop and current task of each thread, the task registry and the call graph's"] [5 1 "// awaited-by sets. The functions follow the C file's, in its order, under the same names in Go's spelling. What C has"] [6 1 "// from its object model (doc/python/PYTHON-SURVEY.md, \"Design: 224\"): a Future or Task is an *Instance whose last slot"] [7 1 "// is a *futObj (not its value: unwrap would hand the state for the object), which never points back at it (Go does"] [8 1 "// not free a cycle through a finalized object); tp_finalize is the"] [9 1 "// built-in __del__ under finalize.go's workDel; the linked list of tasks, whose references are borrowed, is a short"] [10 1 "// strong list plus a mark in finalize.go's records, which hold no reference."] [19 1 "// fut_state"] [26 1 "// futCallback is a callback after the first: (callback, context), an item of fut_callbacks."] [29 1 "// futObj is FutureObj_HEAD and TaskObj's own fields."] [32 42 "// nil: fut_callbacks NULL"] [39 35 "// a Future or a Task, or (awaitedByIsSet) a *Set of them"] [41 33 "// fut_is_task: Task.__init__ ran"] [46 2 "// a Task's"] [47 25 "// an instance of Task (Task_Check), initialized or not"] [50 25 "// in the registry (task_node linked)"] [51 25 "// past the strong list: its finTrack's aioTask"] [52 25 "// its index in aioRecent while it is there"] [55 27 "// str, or the *Int of the deferred \"Task-N\""] [61 1 "// fo is o's Future or Task state, nil when o is neither (Future_Check)."] [72 1 "// isExactFut is Future_CheckExact or Task_CheckExact."] [78 1 "// aioState is asyncio_state: what module_init imports."] [104 1 "// aioCallMethod is PyObject_CallMethod's kind: o.name(*args)."] [113 1 "// aioEqual is PyObject_RichCompareBool(a, b, Py_EQ)."] [125 1 "// aioRepr is %R."] [134 1 "// aioSetObject is PyErr_SetObject of an exception instance: chained to the exception being handled."] [145 1 "// isCoroutine is is_coroutine: a native coroutine, or a type asyncio.iscoroutine accepted before."] [168 1 "// getFutureLoop is get_future_loop (asyncio.futures._get_loop)."] [194 1 "// callSoon is call_soon: loop.call_soon(fn[, arg], context=ctx) (ctx nil: no context; arg nil: none)."] [223 3 "// an evil call_soon could alter them: taken out first"] [354 27 "// FutureObj_finalize's message, should nobody ask (queue 218's work)"] [386 1 "// futureGetResult is future_get_result: the result, or the stored exception (exc non-nil), or the error of a"] [387 1 "// cancelled or unfinished future."] [435 1 "// futureResult is _asyncio_Future_result_impl."] [450 1 "// futureRemoveDoneCallback is _asyncio_Future_remove_done_callback_impl."] [487 2 "// the comparison may change fut_callbacks (GH-97592)"] [509 1 "// futureFinalize is FutureObj_finalize."] [535 1 "// futureIter is futureiterobject: fut nil once closed or thrown into."] [540 1 "// send is FutureIter_am_send: yielded non-nil, or the result returned."] [568 1 "// throw is FutureIter_throw."] [622 1 "// taskStep is TaskStepMethWrapper: task.__step(arg) as a call_soon callback."] [627 1 "// The registry (register_task, unregister_task). A registered task is in aioRecent until a flush, then marked in its"] [628 1 "// finTrack, which keeps no reference: the task's death is found as any tracked object's, and \"Task was destroyed but"] [629 1 "// it is pending!\" is its workDel. Most tasks end before a flush: they pay no Go finalizer."] [668 1 "// flushAioRecent marks the strong list's tasks in their records (flushPendingGens's rule)."] [687 1 "// aioRegistered are the registered tasks (add_tasks_interp)."] [774 1 "// taskInit is _asyncio_Task___init___impl."] [816 3 "// gh-154695: loop may be None here, future_init() resolved it into task_loop"] [826 28 "// no registry to find it by: TaskObj_finalize's message all the same"] [857 1 "// taskFinalize is TaskObj_finalize."] [882 1 "// taskStepImpl is task_step_impl."] [934 3 "// the coroutine has resolved"] [936 4 "// cancelled right before it stopped"] [956 2 "// some other exception: Task.set_exception()"] [966 1 "// taskWaitOn is the common end of task_step_handle_result_impl's two future cases: the task's waiter, cancelled when"] [967 1 "// a cancellation is due."] [994 1 "// taskStepHandleResult is task_step_handle_result_impl."] [1037 3 "// a bare yield relinquishes control for one event loop iteration"] [1089 1 "// taskStep is task_step."] [1099 29 "// _PyErr_ChainExceptions1"] [1112 1 "// taskEagerStart is task_eager_start."] [1118 2 "// registered first: a task that completes eagerly unregisters itself in future_schedule_callbacks"] [1131 16 "// this seems to really help performance on pyperformance benchmarks"] [1136 1 "// taskWakeup is task_wakeup_lock_held."] [1200 1 "// aioRunningLoop is _asyncio_get_running_loop_impl."] [1269 2 "// a method of the state: the receiver checked as a method descriptor does"] [1412 2 "// the getters and setters: one on the state's type, a deletion refused as the clinic's setters do"] [1525 2 "// FutureIter"] [1533 39 "// Future.__iter__ does not care about the value sent"] [1541 2 "// TaskStepMethWrapper"] [1554 2 "// Task"] [1774 3 "// the eager tasks first, so that none that graduates is missed"] [1816 1 "// asyncioModuleInit is module_init: asyncio's parts, imported (the packages under way partly so, as in C)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[63 27] [64 23] [147 31] [184 33] [226 44] [237 48] [266 56] [283 24] [286 30] [309 32] [317 44] [328 25] [350 44] [359 24] [409 45] [429 44] [452 32] [488 12] [488 56] [530 43] [574 145] [592 30] [597 25] [599 33] [616 32] [662 21] [776 37] [805 32] [825 42] [876 68] [925 39] [938 51] [943 50] [957 49] [1027 42] [1031 81] [1038 43] [1062 22] [1063 42] [1067 50] [1074 83] [1091 35] [1096 37] [1097 31] [1098 30] [1106 35] [1120 31] [1124 44] [1127
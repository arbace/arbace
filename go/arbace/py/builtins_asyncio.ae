(in-ns 'go.arbace.py) ^{:go/comments [[3 1 "// The module _asyncio (queue 224; Modules/_asynciomodule.c of CPython 3.14.10): the C Future and Task, FutureIter,"] [4 1 "// TaskStepMethWrapper, the running loop and current task of each thread, the task registry and the call graph's"] [5 1 "// awaited-by sets. The functions follow the C file's, in its order, under the same names in Go's spelling. What C has"] [6 1 "// from its object model (doc/python/PYTHON-SURVEY.md, \"Design: 224\"): a Future or Task is an *Instance whose last slot"] [7 1 "// is a *futObj (not its value: unwrap would hand the state for the object), which never points back at it (Go does"] [8 1 "// not free a cycle through a finalized object); tp_finalize is the"] [9 1 "// built-in __del__ under finalize.go's workDel; the linked list of tasks, whose references are borrowed, is a short"] [10 1 "// strong list plus a mark in finalize.go's records, which hold no reference."] [19 1 "// fut_state"] [26 1 "// futCallback is a callback after the first: (callback, context), an item of fut_callbacks."] [29 1 "// futObj is FutureObj_HEAD and TaskObj's own fields."] [32 42 "// nil: fut_callbacks NULL"] [39 35 "// a Future or a Task, or (awaitedByIsSet) a *Set of them"] [41 33 "// fut_is_task: Task.__init__ ran"] [46 2 "// a Task's"] [47 25 "// an instance of Task (Task_Check), initialized or not"] [50 25 "// in the registry (task_node linked)"] [51 25 "// past the strong list: its finTrack's aioTask"] [52 25 "// its index in aioRecent while it is there"] [55 27 "// str, or the *Int of the deferred \"Task-N\""] [61 1 "// fo is o's Future or Task state, nil when o is neither (Future_Check)."] [72 1 "// isExactFut is Future_CheckExact or Task_CheckExact."] [78 1 "// aioState is asyncio_state: what module_init imports."] [79 1 "// aioState is _asyncio's module state, an interpreter's own (interpRegs, queue 230)."] [107 1 "// aioCallMethod is PyObject_CallMethod's kind: o.name(*args)."] [116 1 "// aioEqual is PyObject_RichCompareBool(a, b, Py_EQ)."] [128 1 "// aioRepr is %R."] [137 1 "// aioSetObject is PyErr_SetObject of an exception instance: chained to the exception being handled."] [148 1 "// isCoroutine is is_coroutine: a native coroutine, or a type asyncio.iscoroutine accepted before."] [171 1 "// getFutureLoop is get_future_loop (asyncio.futures._get_loop)."] [197 1 "// callSoon is call_soon: loop.call_soon(fn[, arg], context=ctx) (ctx nil: no context; arg nil: none)."] [226 3 "// an evil call_soon could alter them: taken out first"] [357 27 "// FutureObj_finalize's message, should nobody ask (queue 218's work)"] [389 1 "// futureGetResult is future_get_result: the result, or the stored exception (exc non-nil), or the error of a"] [390 1 "// cancelled or unfinished future."] [438 1 "// futureResult is _asyncio_Future_result_impl."] [453 1 "// futureRemoveDoneCallback is _asyncio_Future_remove_done_callback_impl."] [490 2 "// the comparison may change fut_callbacks (GH-97592)"] [512 1 "// futureFinalize is FutureObj_finalize."] [538 1 "// futureIter is futureiterobject: fut nil once closed or thrown into."] [543 1 "// send is FutureIter_am_send: yielded non-nil, or the result returned."] [571 1 "// throw is FutureIter_throw."] [625 1 "// taskStep is TaskStepMethWrapper: task.__step(arg) as a call_soon callback."] [630 1 "// The registry (register_task, unregister_task). A registered task is in aioRecent until a flush, then marked in its"] [631 1 "// finTrack, which keeps no reference: the task's death is found as any tracked object's, and \"Task was destroyed but"] [632 1 "// it is pending!\" is its workDel. Most tasks end before a flush: they pay no Go finalizer."] [671 1 "// flushAioRecent marks the strong list's tasks in their records (flushPendingGens's rule)."] [690 1 "// aioRegistered are the registered tasks (add_tasks_interp)."] [777 1 "// taskInit is _asyncio_Task___init___impl."] [819 3 "// gh-154695: loop may be None here, future_init() resolved it into task_loop"] [829 28 "// no registry to find it by: TaskObj_finalize's message all the same"] [860 1 "// taskFinalize is TaskObj_finalize."] [885 1 "// taskStepImpl is task_step_impl."] [937 3 "// the coroutine has resolved"] [939 4 "// cancelled right before it stopped"] [959 2 "// some other exception: Task.set_exception()"] [969 1 "// taskWaitOn is the common end of task_step_handle_result_impl's two future cases: the task's waiter, cancelled when"] [970 1 "// a cancellation is due."] [997 1 "// taskStepHandleResult is task_step_handle_result_impl."] [1040 3 "// a bare yield relinquishes control for one event loop iteration"] [1092 1 "// taskStep is task_step."] [1102 29 "// _PyErr_ChainExceptions1"] [1115 1 "// taskEagerStart is task_eager_start."] [1121 2 "// registered first: a task that completes eagerly unregisters itself in future_schedule_callbacks"] [1134 16 "// this seems to really help performance on pyperformance benchmarks"] [1139 1 "// taskWakeup is task_wakeup_lock_held."] [1203 1 "// aioRunningLoop is _asyncio_get_running_loop_impl."] [1272 2 "// a method of the state: the receiver checked as a method descriptor does"] [1415 2 "// the getters and setters: one on the state's type, a deletion refused as the clinic's setters do"] [1528 2 "// FutureIter"] [1536 39 "// Future.__iter__ does not care about the value sent"] [1544 2 "// TaskStepMethWrapper"] [1557 2 "// Task"] [1777 3 "// the eager tasks first, so that none that graduates is missed"] [1819 1 "// asyncioModuleInit is module_init: asyncio's parts, imported (the packages under way partly so, as in C)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[63 27] [64 23] [150 31] [187 33] [229 44] [240 48] [269 56] [286 24] [289 30] [312 32] [320 44] [331 25] [353 44] [362 24] [412 45] [432 44] [455 32] [491 12] [491 56] [533 43] [577 145] [595 30] [600 25] [602 33] [619 32] [665 21] [779 37] [808 32] [828 42] [879 68] [928 39] [941 51] [946 50] [960 49] [1030 42] [1034 81] [1041 43] [1065 22] [1066 42] 
endict_vectorcall: frozendict(fd) of an exact frozendict is fd"] [215 2 "// frozendict_repr: TYPE() empty, else TYPE({...}), the type the instance's own"] [247 2 "// dict_richcompare over any two dicts: == and != only"] [256 2 "// b | fd, b's own | not taking a frozendict: a dict's _PyDict_Or (a dict copy of b), else NotImplemented"] [302 2 "// frozendict.copy: an exact frozendict itself, a subclass's a new exact frozendict"] [312 2 "// __getnewargs__: (dict(self),), pickled through copyreg.__newobj__ at protocol 2 and above"] [354 1 "// asFrozenFor315 is a frozendict's items where 3.15 takes a frozendict as a dict (str.maketrans), copied."] [362 1 "// isFrozenDictValue is o a frozendict's value (a subclass's d.__getitem__(k) then sees the instance: its __missing__)"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[27 29] [30 25] [38 23] [41 29] [50 24] [55 28] [131 35] [134 51] [139 36] [144 39] [168 23] [187 88] [200 62] [208 45] [271 61] [281 40] [297 49] [304 52] [314 51] [320 47] [330 24] [346 33] [356 29] [363 65]]} (go/file "frozendict.go" :imports [



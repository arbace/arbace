(in-ns 'go.arbace.py) ^{:go/comments [[9 1 "// Lazy imports (PEP 810, Python 3.15; queue 239, doc/python/PY315-SURVEY.md P4b): CPython 3.15.2's"] [10 1 "// Objects/lazyimportobject.c, the lazy half of Python/import.c (_PyImport_LazyImportModuleLevelObject, sys.lazy_modules,"] [11 1 "// the pending submodules), ceval.c's _PyEval_LazyImportName and its reification at the loads of a global or a name,"] [12 1 "// moduleobject.c's getattr, sysmodule.c's API and initconfig.c's -X lazy_imports. A lazy_import object is made only by"] [13 1 "// a lazy import (the compiler's IMPORT_NAME flag 1, or flag 0 under the mode \"all\", __lazy_modules__ or"] [14 1 "// __lazy_import__), which only 3.15 reads; under 3.14 none exists, and every load pays one type test."] [16 1 "// LazyImportType is lazy_import (types.LazyImportType)."] [19 1 "// ImportCycleErrorType is ImportCycleError (3.15: a lazy import resolved while it resolves)."] [22 1 "// LazyImport is PyLazyImportObject. A root (what IMPORT_NAME leaves): builtins, from the absolute name (a *Str), attr"] [23 1 "// the original fromlist (nil, a *Str or a *Tuple). A projection (IMPORT_FROM on a placeholder): from the source"] [24 1 "// placeholder (a *LazyImport), attr the attribute's name (a *Str). code and lasti: where it was declared."] [31 16 "// the root was accessed, so its declared path requires import semantics"] [36 1 "// lazyState is an interpreter's lazy-import state (interp->imports): the mode, the filter, sys.lazy_modules and the"] [37 1 "// pending submodules (parent name -> {child: source placeholder or None})."] [40 27 "// nil: none"] [57 1 "// lazyResolving is each thread's set of placeholders being resolved (_PyThreadStateImpl.lazy_imports)."] [62 1 "// lazyImportsConfig is initconfig.c's config_init_lazy_imports: -1 (unset, the mode \"normal\") or 1 (\"all\"), from"] [63 1 "// PYTHON_LAZY_IMPORTS then -X lazy_imports; another value is the fatal error at start (lazyImportsCheck)."] [102 1 "// lazyNew is _PyLazyImport_New: frame's code and instruction the declaration's (nil frame: none)."] [114 1 "// moduleLevel is is_lazy_import_module_level: the running frame's globals are its locals."] [120 1 "// absName is _PyImport_GetAbsName."] [135 1 "// lazyImportName is IMPORT_NAME with the compiler's flag (_PyEval_LazyImportName): lazy when flagged, or by the mode"] [136 1 "// \"all\" at module level, or by the module's __lazy_modules__; else the eager import."] [143 3 "// check_lazy_import_compatibility: __lazy_modules__ (only at module level)"] [200 1 "// lazyImportModuleLevel is _PyImport_LazyImportModuleLevelObject: the placeholder of the import (or the module, when"] [201 1 "// the filter refuses), its name in sys.lazy_modules and on its parents' pending submodules."] [267 1 "// specInitializing is _PyModuleSpec_IsInitializing: spec._initializing true."] [279 1 "// lazyModulesAdd is lazy_modules_add: name into sys.lazy_modules unless imported and initialized; the module in"] [280 1 "// sys.modules returned when want."] [301 1 "// lazyPendingOf is ensure_lazy_pending_submodules: the parent's dict of pending children."] [314 1 "// registerLazyOnParent records each parent-child pair of a lazily imported dotted name, the child's source the"] [315 1 "// placeholder (None for a from-import's, or when the child is already in sys.modules)."] [352 1 "// registerFromLazyOnParent is register_from_lazy_on_parent: `from a import b` may name the submodule a.b."] [366 1 "// lazyClearSubmodule is _PyImport_ClearLazySubmodule: a pending child that has finished loading leaves its parent's"] [367 1 "// pending set (bound on the parent when bind), kept as None while its parent is still initializing."] [436 1 "// lazyLoaded is _imp._set_lazy_attributes, which 3.15's _bootstrap._find_and_load_unlocked calls after a load: the"] [437 1 "// module leaves sys.lazy_modules and its parent's pending children."] [449 1 "// lazyTryLoadSubmodule is _PyImport_TryLoadLazySubmodule: an attribute a module lacks that is a pending child of it,"] [450 1 "// imported (recheck: the module has pending children, so the caller looks at its dict again)."] [512 1 "// lazyFindAndLoadSubmodule is importlib's _find_and_load_lazy_submodule: the module, or None when it is not found"] [513 1 "// (3.15's _bootstrap; 3.14's has no such function, so the runtime's import with its not-found answered None)."] [530 1 "// lazyGetLoadedAttr is lazy_import_get_loaded_attr: a concrete attribute of an initialized module in sys.modules, nil"] [531 1 "// otherwise (no error: an Exception is dropped)."] [565 1 "// lazyImportFrom is IMPORT_FROM on a placeholder (_PyEval_LazyImportFrom): `from a import b` takes b off an already"] [566 1 "// imported a, else a projection."] [577 1 "// lazyPath is lazy_import_path: the dotted name of what resolving the placeholder returns."] [592 1 "// lazyName is lazy_import_name: the name its repr and messages show."] [606 1 "// lazyResolveResult is lazy_import_resolve_result: a placeholder an import hook or a lookup returned, resolved."] [617 1 "// lazyReplayFrom is lazy_import_replay_from: the attributes recorded from the root to lz, looked up in order on the"] [618 1 "// module the root's import returned."] [632 1 "// lazyAddCause is lazy_import_add_exception_cause: the declaration's location added to a resolution's error, as a note"] [633 1 "// when the error is chained already, else as an ImportError cause with a traceback entry at the declaration."] [662 1 "// lazyResolve is lazy_import_resolve_impl: the import a placeholder stands for, done; imported (when not nil) the"] [663 1 "// module the default importer returned for the root."] [739 3 "// a plain import binds the root package; its pending children are imported when their attributes are read"] [803 1 "// lazyLoadChild is _PyLazyImport_LoadChild: a pending child resolved as an aliased import of its full name, at the"] [804 1 "// declaration of its source."] [817 3 "// reaching a non-package must still reject an invalid dotted import"] [823 1 "// lazyReplaceChild is lazy_import_replace_child: loading pkg.child can put the module in pkg's dict where a"] [824 1 "// from-import's placeholder for pkg.child was; the binding gets the value instead."] [851 1 "// lazyReify is _PyLazyImport_Reify: the placeholder found as name in ns resolved, and the binding replaced when it"] [852 1 "// still holds the placeholder (an exact dict; a mapping by its protocol; a read-only mapping not at all)."] [892 1 "// reifyGlobal is _PyEval_LoadGlobalStackRef's end: a placeholder loaded as a global, reified in the globals (or the"] [893 1 "// builtins, where it was found)."] [910 1 "// reifyLocal is _PyEval_LoadName's end for a value found in the locals."] [923 1 "// builtinLazyImportFn is builtins.__lazy_import__."] [961 2 "// builtins.__lazy_import__(name, globals=None, locals=None, fromlist=(), level=0)"] [1010 1 "// lazySysFuncs are sys's lazy-import functions (sysmodule.c), and sys.lazy_modules."] [1070 1 "// types315Source derives the types of Modules/_typesmodule.c as Lib/types.py's fallback does (3.15.2's; CapsuleType"] [1071 1 "// stays absent, as in pyi's 3.14 types module); _types adds LazyImportType, the one a pure-Python fallback cannot"] [1072 1 "// make. 3.15's types.py, and 3.14's under the switch, take `from _types import *` (queue 239)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[71 41] [81 45] [95 37] [164 44] [219 29] [227 38] [243 32] [245 24] [255 32] [257 67] [261 53] [287 27] [307 23] [338 42] [341 45] [345 50] [354 32] [355 32] [360 46] [383 33] [411 49] [416 30] [417 32] [418 47] [419 37] [422 40] [443 47] [479 47] [480 33] [483 37] [502 34] [505 39] [515 25] [516 69] [522 28] [542 40] [545 35] [552 29] [568 31] [579 37] [584 32] [594 35] [599 32] [611 30] [646 25] [696 25] [697 56] [706 33] [735 32] [740 37] [742 16] [742 35] [778 28] [791 46] [794 27] [816 27] [827 37] [843 30] [844 28] [866 32] [870 70] [884 38] [897 50] [903 35] [951 44] [977 32] [1001 26] [100
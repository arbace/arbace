(in-ns 'go.arbace.py) ^{:go/comments [[9 1 "// Lazy imports (PEP 810, Python 3.15; queue 239, doc/python/PY315-SURVEY.md P4b): CPython 3.15.2's"] [10 1 "// Objects/lazyimportobject.c, the lazy half of Python/import.c (_PyImport_LazyImportModuleLevelObject, sys.lazy_modules,"] [11 1 "// the pending submodules), ceval.c's _PyEval_LazyImportName and its reification at the loads of a global or a name,"] [12 1 "// moduleobject.c's getattr, sysmodule.c's API and initconfig.c's -X lazy_imports. A lazy_import object is made only by"] [13 1 "// a lazy import (the compiler's IMPORT_NAME flag 1, or flag 0 under the mode \"all\", __lazy_modules__ or"] [14 1 "// __lazy_import__), which only 3.15 reads; under 3.14 none exists, and every load pays one type test."] [16 1 "// LazyImportType is lazy_import (types.LazyImportType)."] [19 1 "// ImportCycleErrorType is ImportCycleError (3.15: a lazy import resolved while it resolves)."] [22 1 "// LazyImport is PyLazyImportObject. A root (what IMPORT_NAME leaves): builtins, from the absolute name (a *Str), attr"] [23 1 "// the original fromlist (nil, a *Str or a *Tuple). A projection (IMPORT_FROM on a placeholder): from the source"] [24 1 "// placeholder (a *LazyImport), attr the attribute's name (a *Str). code and lasti: where it was declared."] [31 16 "// the root was accessed, so its declared path requires import semantics"] [36 1 "// lazyState is an interpreter's lazy-import state (interp->imports): the mode, the filter, sys.lazy_modules and the"] [37 1 "// pending submodules (parent name -> {child: source placeholder or None})."] [40 27 "// nil: none"] [57 1 "// lazyResolving is each thread's set of placeholders being resolved (_PyThreadStateImpl.lazy_imports)."] [62 1 "// lazyImportsConfig is initconfig.c's config_init_lazy_imports: -1 (unset, the mode \"normal\") or 1 (\"all\"), from"] [63 1 "// PYTHON_LAZY_IMPORTS then -X lazy_imports; another value is the fatal error at start (lazyImportsCheck)."] [102 1 "// lazyNew is _PyLazyImport_New: frame's code and instruction the declaration's (nil frame: none)."] [114 1 "// importlibInstalling: the import system's own modules are running (CPython installs importlib before any mode applies)."] [120 1 "// moduleLevel is is_lazy_import_module_level: the running frame's globals are its locals."] [126 1 "// absName is _PyImport_GetAbsName."] [141 1 "// lazyImportName is IMPORT_NAME with the compiler's flag (_PyEval_LazyImportName): lazy when flagged, or by the mode"] [142 1 "// \"all\" at module level, or by the module's __lazy_modules__; else the eager import."] [149 3 "// check_lazy_import_compatibility: __lazy_modules__ (only at module level)"] [206 1 "// lazyImportModuleLevel is _PyImport_LazyImportModuleLevelObject: the placeholder of the import (or the module, when"] [207 1 "// the filter refuses), its name in sys.lazy_modules and on its parents' pending submodules."] [273 1 "// specInitializing is _PyModuleSpec_IsInitializing: spec._initializing true."] [285 1 "// lazyModulesAdd is lazy_modules_add: name into sys.lazy_modules unless imported and initialized; the module in"] [286 1 "// sys.modules returned when want."] [307 1 "// lazyPendingOf is ensure_lazy_pending_submodules: the parent's dict of pending children."] [320 1 "// registerLazyOnParent records each parent-child pair of a lazily imported dotted name, the child's source the"] [321 1 "// placeholder (None for a from-import's, or when the child is already in sys.modules)."] [358 1 "// registerFromLazyOnParent is register_from_lazy_on_parent: `from a import b` may name the submodule a.b."] [372 1 "// lazyClearSubmodule is _PyImport_ClearLazySubmodule: a pending child that has finished loading leaves its parent's"] [373 1 "// pending set (bound on the parent when bind), kept as None while its parent is still initializing."] [442 1 "// lazyLoaded is _imp._set_lazy_attributes, which 3.15's _bootstrap._find_and_load_unlocked calls after a load: the"] [443 1 "// module leaves sys.lazy_modules and its parent's pending children."] [455 1 "// lazyTryLoadSubmodule is _PyImport_TryLoadLazySubmodule: an attribute a module lacks that is a pending child of it,"] [456 1 "// imported (recheck: the module has pending children, so the caller looks at its dict again)."] [518 1 "// lazyFindAndLoadSubmodule is importlib's _find_and_load_lazy_submodule: the module, or None when it is not found"] [519 1 "// (3.15's _bootstrap; 3.14's has no such function, so the runtime's import with its not-found answered None)."] [536 1 "// lazyGetLoadedAttr is lazy_import_get_loaded_attr: a concrete attribute of an initialized module in sys.modules, nil"] [537 1 "// otherwise (no error: an Exception is dropped)."] [571 1 "// lazyImportFrom is IMPORT_FROM on a placeholder (_PyEval_LazyImportFrom): `from a import b` takes b off an already"] [572 1 "// imported a, else a projection."] [583 1 "// lazyPath is lazy_import_path: the dotted name of what resolving the placeholder returns."] [598 1 "// lazyName is lazy_import_name: the name its repr and messages show."] [612 1 "// lazyResolveResult is lazy_import_resolve_result: a placeholder an import hook or a lookup returned, resolved."] [623 1 "// lazyReplayFrom is lazy_import_replay_from: the attributes recorded from the root to lz, looked up in order on the"] [624 1 "// module the root's import returned."] [638 1 "// lazyAddCause is lazy_import_add_exception_cause: the declaration's location added to a resolution's error, as a note"] [639 1 "// when the error is chained already, else as an ImportError cause with a traceback entry at the declaration."] [668 1 "// lazyResolve is lazy_import_resolve_impl: the import a placeholder stands for, done; imported (when not nil) the"] [669 1 "// module the default importer returned for the root."] [745 3 "// a plain import binds the root package; its pending children are imported when their attributes are read"] [809 1 "// lazyLoadChild is _PyLazyImport_LoadChild: a pending child resolved as an aliased import of its full name, at the"] [810 1 "// declaration of its source."] [823 3 "// reaching a non-package must still reject an invalid dotted import"] [829 1 "// lazyReplaceChild is lazy_import_replace_child: loading pkg.child can put the module in pkg's dict where a"] [830 1 "// from-import's placeholder for pkg.child was; the binding gets the value instead."] [857 1 "// lazyReify is _PyLazyImport_Reify: the placeholder found as name in ns resolved, and the binding replaced when it"] [858 1 "// still holds the placeholder (an exact dict; a mapping by its protocol; a read-only mapping not at all)."] [898 1 "// reifyGlobal is _PyEval_LoadGlobalStackRef's end: a placeholder loaded as a global, reified in the globals (or the"] [899 1 "// builtins, where it was found)."] [916 1 "// reifyLocal is _PyEval_LoadName's end for a value found in the locals."] [929 1 "// lazySuppress is above 0 while an attribute is looked up as hasattr does (CPython's suppress=1 of"] [930 1 "// _Py_module_getattro_impl, _PyObject_LookupAttr): a pending submodule of a lazy import is then imported by its name,"] [931 1 "// not through its declaration; a module's missing name gets a plain AttributeError (moduleNoAttr, queue 293)."] [934 1 "// getAttrSuppressed is GetAttr as hasattr's lookup (suppress)."] [941 1 "// builtinLazyImportFn is builtins.__lazy_import__."] [947 3 "// init_interp_main: the mode -X lazy_imports or PYTHON_LAZY_IMPORTS asks is set after the start's imports"] [984 2 "// builtins.__lazy_import__(name, globals=None, locals=None, fromlist=(), level=0)"] [1033 1 "// lazySysFuncs are sys's lazy-import functions (sysmodule.c), and sys.lazy_modules."] [1093 1 "// types315Source derives the types of Modules/_typesmodule.c as Lib/types.py's fallback does (3.15.2's; CapsuleType"] [1094 1 "// stays absent, as in pyi's 3.14 types module); _types adds LazyImportType, the one a pure-Python fallback cannot"] [1095 1 "// make. 3.15's types.py, and 3.14's under the switch, take `from _types import *` (queue 239)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[71 41] [81 45] [95 37] [170 44] [225 29] [233 38] [249 32] [251 24] [261 32] [263 67] [267 53] [293 27] [313 23] [344 42] [347 45] [351 50] [360 32] [361 32] [366 46] [389 33] [417 49] [422 30] [423 32] [424 47] [425 37] [428 40] [449 47] [485 47] [486 33] [489 37] [508 34] [511 39] [521 25] [522 69] [528 28] [548 40] [551 35] [558 29] [574 31] [585 37] [590 32] [600 35] [605 32] [617 30] [652 25] [702 25] [703 56] [712 33] [741 32] [746 37] [748 16] [748 35] [784 28] [797 46] [800 27] [822 27] [833 37] [849 30] [850 28] [872 32] [876 70] [890 38] [903 50] [909 35] [974 44] [1000 32] [1024 26] [1026 31] [1055 87] [1083 80]]} (go/file "lazyimport.go" :imports [



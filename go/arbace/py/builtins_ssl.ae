(in-ns 'go.arbace.py) ^{:go/comments [[18 1 "// The module _ssl (queue 209, PYS22 (a); CPython 3.14.10's Modules/_ssl.c and its clinic file) over Go's"] [19 1 "// crypto/tls: ssl.py runs unchanged on it. A context (_SSLContext) keeps OpenSSL's settings as _ssl.c reads and"] [20 1 "// writes them (options, verify mode and flags, host flags, the protocol bounds, the cipher list, ALPN, the"] [21 1 "// certificate chain and key, the trust store) and makes a tls.Config of them for each connection. An SSL object"] [22 1 "// (_SSLSocket, over a socket or a pair of MemoryBIOs) drives a tls.Conn in a goroutine of its own over an"] [23 1 "// in-memory transport (builtins_ssl_conn.go), so OpenSSL's non-blocking contract (SSL_ERROR_WANT_READ, a"] [24 1 "// handshake resumed by calling again) holds for both. Verification is _ssl's own over Go's x509 (the codes and"] [25 1 "// messages of OpenSSL's X509_verify_cert_error_string), certificates decoded as _decode_certificate does"] [26 1 "// (builtins_ssl_cert.go). What Go's TLS does not have is by design (doc/python/PYTHON-SURVEY.md, \"As built: 209\")."] [28 1 "// The constants as CPython 3.14.10 with OpenSSL 3.5 defines them."] [66 2 "// the py_ssl_error codes"] [77 1 "// _ssl.c's line numbers in its error messages (\" (_ssl.c:N)\"), from CPython 3.14.10's source."] [104 1 "// sslReady gives SSLCertVerificationError its two bases (SSLError, ValueError), as egReady does"] [105 1 "// ExceptionGroup's."] [117 1 "// sslError is fill_and_set_sslerror: an exception of type t, its args (code, message), the message"] [118 1 "// \"[LIB: REASON] errstr: verify (_ssl.c:LINE)\" with the parts it has, its reason and library attributes."] [149 1 "// sslPEMLib is OpenSSL's ERR_R_PEM_LIB as _setSSLError reports it."] [154 1 "// ---- the context ----"] [170 30 "// the TLS 1.2-and-below list set_ciphers selected"] [183 1 "// sslStoreCert is a certificate of the trust store."] [203 1 "// addStore puts a DER certificate in the trust store (once: X509_STORE's hash table)."] [210 11 "// OpenSSL keeps what Go's parser refuses; it cannot anchor Go's verification"] [257 29 "// PY_SSL_MIN_PROTOCOL"] [266 1 "// sslDefaultCiphers is PY_SSL_DEFAULT_CIPHER_STRING."] [269 1 "// tlsVersions is the range of TLS versions the context allows Go: its protocol, its bounds and its OP_NO_*."] [303 1 "// ---- passwords and keys ----"] [305 1 "// sslPassword is a password argument: str, bytes or bytearray (at most PEM_BUFSIZE, 1024 bytes), or a callable"] [306 1 "// called when an encrypted key needs it."] [347 1 "// sslParseKey is a PEM file's first private key, decrypted with the password when it is encrypted."] [356 37 "//nolint: the legacy encryption of OpenSSL's traditional keys"] [551 1 "// sslDefaultPaths are OpenSSL's defaults on Linux, as get_default_verify_paths reports them."] [556 1 "// setDefaultVerifyPaths is X509_STORE_set_default_paths: the default file loaded now, the directory looked up"] [557 1 "// at verification; $SSL_CERT_FILE and $SSL_CERT_DIR replace them."] [578 1 "// pool is the trust store as Go's verifier takes it: the store's certificates and those of the capath"] [579 1 "// directories (OpenSSL's by-hash lookup: every certificate file of the directory)."] [607 1 "// ---- ciphers ----"] [609 1 "// sslCipher is a cipher suite Go implements, under OpenSSL's name and attributes."] [613 19 "// SSL_CIPHER_get_version"] [615 19 "// OpenSSL's Kx= and Au= words"] [616 19 "// Enc="] [617 19 "// Mac="] [620 21 "// the cipher-string words that select it"] [629 1 "// sslCiphers are Go's TLS 1.0-1.2 suites in OpenSSL's default order."] [679 1 "// sslSelectCiphers evaluates an OpenSSL cipher string over sslCiphers (ssl_cipher_process_rulestr's operators:"] [680 1 "// ':' ',' ' ' separate, '+' joins words, '!' kills, '-' removes, a leading '+' moves to the end, \"@STRENGTH\","] [681 1 "// \"@SECLEVEL=N\"); false when no cipher is selected."] [745 1 "// sslCipherDict is cipher_to_dict."] [769 1 "// sslCipherTuple is cipher_to_tuple: (name, protocol, bits)."] [774 1 "// ---- the module ----"] [1098 20 "// Go's TLS has no finite-field DHE: the parameters are read and not used"] [1264 2 "// The OpenSSL API level the port follows (ssl.py and the tests branch on it): 3.5.0, the release CPython"] [1265 2 "// 3.14.10's references ran with; the text says what implements it."] [1305 20 "// Go's crypto/rand needs no seeding"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[245 53] [259 42] [315 22] [321 49] [323 31] [407 53] [416 56] [438 40] [477 58] [482 58] [487 26] [498 36] [502 39] [512 35] [535 35] [541 33] [560 23] [563 23] [566 32] [572 28] [598 48] [800 41] [834 24] [852 24] [888 106] [908 88] [913 88] [917 90] [1021 23] [1105 29] [1107 38] [1147 30] [1287 28] [1297 29] [1298 36] [1302 32] [1322 33]] :go/trails [[626 113] [647 168] [1233 103] [1248 57] [1259 64]]} (go/file "builtins_ssl.go" :imports [



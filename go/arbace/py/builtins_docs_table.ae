    ^{:go/apos {0 [2158 2] 1 [2158 81]} :go/pos {:colon [2158 26]}} ["type:_ctypes.Structure" "Structure base class"]
    ^{:go/apos {0 [2159 2] 1 [2159 81]} :go/pos {:colon [2159 22]}} ["type:_ctypes.Union" "Union base class"]

    ^{:go/apos {0 [1652 2] 1 [1652 65]} :go/pos {:colon [1652 32]}} ["meth:builtins.coroutine.send" "send(arg) -> send 'arg' into coroutine,\nreturn next iterated value or raise StopIteration."]
    ^{:go/apos {0 [1653 2] 1 [1653 65]} :go/pos {:colon [1653 33]}} ["meth:builtins.coroutine.throw" "throw(value)\nthrow(type[,value[,traceback]])\n\nRaise exception in coroutine, return next iterated value or raise\nStopIteration.\nthe (type, val, tb) signature is deprecated, \nand may be removed in a future version of Python."]
    ^{:go/apos {0 [1654 2] 1 [1654 65]} :go/pos {:colon [1654 41]}} ["meth:builtins.coroutine_wrapper.close" "close() -> raise GeneratorExit inside coroutine."]

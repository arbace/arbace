    ^{:go/apos {0 [1737 2] 1 [1737 65]} :go/pos {:colon [1737 31]}} ["meth:builtins.int.__round__" "Rounding an Integral returns itself.\n\nRounding with an ndigits argument also returns an integer."]
    ^{:go/apos {0 [1738 2] 1 [1738 65]} :go/pos {:colon [1738 32]}} ["meth:builtins.int.__sizeof__" "Returns size in memory, in bytes."]

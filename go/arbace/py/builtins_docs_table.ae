    ^{:go/apos {0 [1789 2] 1 [1789 65]} :go/pos {:colon [1789 40]}} ["meth:builtins.memoryview._from_flags" "Create a new memoryview object which references the given object."]
    ^{:go/apos {0 [1790 2] 1 [1790 65]} :go/pos {:colon [1790 33]}} ["meth:builtins.memoryview.cast" "Cast a memoryview to a new format or shape."]
    ^{:go/apos {0 [1791 2] 1 [1791 65]} :go/pos {:colon [1791 34]}} ["meth:builtins.memoryview.count" "Count the number of occurrences of a value."]
    ^{:go/apos {0 [1792 2] 1 [1792 65]} :go/pos {:colon [1792 32]}} ["meth:builtins.memoryview.hex" "Return the data in the buffer as a str of hexadecimal numbers.\n\n  sep\n    An optional single character or byte to separate hex bytes.\n  bytes_per_sep\n    How many bytes between separators.  Positive values count from\n    the right, negative values count from the left.\n\nExample:\n>>> value = memoryview(b'\\xb9\\x01\\xef')\n>>> value.hex()\n'b901ef'\n>>> value.hex(':')\n'b9:01:ef'\n>>> value.hex(':', 2)\n'b9:01ef'\n>>> value.hex(':', -2)\n'b901:ef'"]
    ^{:go/apos {0 [1793 2] 1 [1793 65]} :go/pos {:colon [1793 34]}} ["meth:builtins.memoryview.index" "Return the index of the first occurrence of a value.\n\nRaises ValueError if the value is not present."]
    ^{:go/apos {0 [1794 2] 1 [1794 65]} :go/pos {:colon [1794 36]}} ["meth:builtins.memoryview.release" "Release the underlying buffer exposed by the memoryview object."]
    ^{:go/apos {0 [1795 2] 1 [1795 65]} :go/pos {:colon [1795 36]}} ["meth:builtins.memoryview.tobytes" "Return the data in the buffer as a byte string.\n\nOrder can be {'C', 'F', 'A'}.  When order is 'C' or 'F', the data of\nthe original array is converted to C or Fortran order.  For\ncontiguous views, 'A' returns an exact copy of the physical memory.\nIn particular, in-memory Fortran order is preserved.  For\nnon-contiguous views, the data is converted to C first.  order=None\nis the same as order='C'."]
    ^{:go/apos {0 [1796 2] 1 [1796 65]} :go/pos {:colon [1796 35]}} ["meth:builtins.memoryview.tolist" "Return the data in the buffer as a list of elements."]
    ^{:go/apos {0 [1797 2] 1 [1797 65]} :go/pos {:colon [1797 39]}} ["meth:builtins.memoryview.toreadonly" "Return a readonly version of the memoryview."]

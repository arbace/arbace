    ^{:go/apos {0 [2235 2] 1 [2235 81]} :go/pos {:colon [2235 29]}} ["type:builtins.ImportError" "Import can't find module, or can't find name in module."]
    ^{:go/apos {0 [2236 2] 1 [2236 81]} :go/pos {:colon [2236 31]}} ["type:builtins.ImportWarning" "Base class for warnings about probable mistakes in module imports"]
    ^{:go/apos {0 [2237 2] 1 [2237 81]} :go/pos {:colon [2237 34]}} ["type:builtins.IndentationError" "Improper indentation."]
    ^{:go/apos {0 [2238 2] 1 [2238 81]} :go/pos {:colon [2238 28]}} ["type:builtins.IndexError" "Sequence index out of range."]
    ^{:go/apos {0 [2239 2] 1 [2239 81]} :go/pos {:colon [2239 37]}} ["type:builtins.InstructionSequence" "InstructionSequenceType()\n--\n\nCreate a new InstructionSequence object."]

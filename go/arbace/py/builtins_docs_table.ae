    ^{:go/apos {0 [1082 2] 1 [1082 65]} :go/pos {:colon [1082 37]}} ["meth:_ctypes._SimpleCData.__new__" "Create and return a new object.  See help(type) for accurate signature."]
    ^{:go/apos {0 [1083 2] 1 [1083 65]} :go/pos {:colon [1083 29]}} ["meth:_curses.window.addch" "addch([y, x,] ch, [attr=_curses.A_NORMAL])\nPaint the character.\n\n  y\n    Y-coordinate.\n  x\n    X-coordinate.\n  ch\n    Character to add.\n  attr\n    Attributes for the character.\n\nPaint character ch at (y, x) with attributes attr,\noverwriting any character previously painted at that location.\nBy default, the character position and attributes are the\ncurrent settings for the window object."]
    ^{:go/apos {0 [1084 2] 1 [1084 65]} :go/pos {:colon [1084 31]}} ["meth:_curses.window.addnstr" "addnstr([y, x,] str, n, [attr])\nPaint at most n characters of the string.\n\n  y\n    Y-coordinate.\n  x\n    X-coordinate.\n  str\n    String to add.\n  n\n    Maximal number of characters.\n  attr\n    Attributes for characters.\n\nPaint at most n characters of the string str at (y, x) with\nattributes attr, overwriting anything previously on the display.\nBy default, the character position and attributes are the\ncurrent settings for the window object."]
    ^{:go/apos {0 [1085 2] 1 [1085 65]} :go/pos {:colon [1085 30]}} ["meth:_curses.window.addstr" "addstr([y, x,] str, [attr])\nPaint the string.\n\n  y\n    Y-coordinate.\n  x\n    X-coordinate.\n  str\n    String to add.\n  attr\n    Attributes for characters.\n\nPaint the string str at (y, x) with attributes attr,\noverwriting anything previously on the display.\nBy default, the character position and attributes are the\ncurrent settings for the window object."]
    ^{:go/apos {0 [1086 2] 1 [1086 65]} :go/pos {:colon [1086 31]}} ["meth:_curses.window.attroff" "Remove attribute attr from the \"background\" set."]
    ^{:go/apos {0 [1087 2] 1 [1087 65]} :go/pos {:colon [1087 30]}} ["meth:_curses.window.attron" "Add attribute attr to the \"background\" set."]
    ^{:go/apos {0 [1088 2] 1 [1088 65]} :go/pos {:colon [1088 31]}} ["meth:_curses.window.attrset" "Set the \"background\" set of attributes."]
    ^{:go/apos {0 [1089 2] 1 [1089 65]} :go/pos {:colon [1089 28]}} ["meth:_curses.window.bkgd" "Set the background property of the window.\n\n  ch\n    Background character.\n  attr\n    Background attributes."]
    ^{:go/apos {0 [1090 2] 1 [1090 65]} :go/pos {:colon [1090 31]}} ["meth:_curses.window.bkgdset" "Set the window's background.\n\n  ch\n    Background character.\n  attr\n    Background attributes."]
    ^{:go/apos {0 [1091 2] 1 [1091 65]} :go/pos {:colon [1091 30]}} ["meth:_curses.window.border" "Draw a border around the edges of the window.\n\n  ls\n    Left side.\n  rs\n    Right side.\n  ts\n    Top side.\n  bs\n    Bottom side.\n  tl\n    Upper-left corner.\n  tr\n    Upper-right corner.\n  bl\n    Bottom-left corner.\n  br\n    Bottom-right corner.\n\nEach parameter specifies the character to use for a specific part of\nthe border.  The characters can be specified as integers or as\none-character strings.  A 0 value for any parameter will cause the\ndefault character to be used for that parameter."]
    ^{:go/apos {0 [1092 2] 1 [1092 65]} :go/pos {:colon [1092 27]}} ["meth:_curses.window.box" "box([verch=0, horch=0])\nDraw a border around the edges of the window.\n\n  verch\n    Left and right side.\n  horch\n    Top and bottom side.\n\nSimilar to border(), but both ls and rs are verch and both ts and bs\nare horch.  The default corner characters are always used by this\nfunction."]
    ^{:go/apos {0 [1093 2] 1 [1093 65]} :go/pos {:colon [1093 29]}} ["meth:_curses.window.chgat" "chgat([y, x,] [n=-1,] attr)\nSet the attributes of characters.\n\n  y\n    Y-coordinate.\n  x\n    X-coordinate.\n  n\n    Number of characters.\n  attr\n    Attributes for characters.\n\nSet the attributes of num characters at the current cursor position, or at\nposition (y, x) if supplied.  If no value of num is given or num = -1, the\nattribute will be set on all the characters to the end of the line.  This\nfunction does not move the cursor.  The changed line will be touched using\nthe touchline() method so that the contents will be redisplayed by the next\nwindow refresh."]
    ^{:go/apos {0 [1094 2] 1 [1094 65]} :go/pos {:colon [1094 29]}} ["meth:_curses.window.clear" "Clear the window and repaint it completely on the next refresh()."]
    ^{:go/apos {0 [1095 2] 1 [1095 65]} :go/pos {:colon [1095 31]}} ["meth:_curses.window.clearok" "Clear the window on the next refresh() if flag is true."]
    ^{:go/apos {0 [1096 2] 1 [1096 65]} :go/pos {:colon [1096 32]}} ["meth:_curses.window.clrtobot" "Erase from the cursor to the end of the window."]
    ^{:go/apos {0 [1097 2] 1 [1097 65]} :go/pos {:colon [1097 32]}} ["meth:_curses.window.clrtoeol" "Erase from the cursor to the end of the line."]
    ^{:go/apos {0 [1098 2] 1 [1098 65]} :go/pos {:colon [1098 33]}} ["meth:_curses.window.cursyncup" "Update the cursor position of all ancestor windows to match."]
    ^{:go/apos {0 [1099 2] 1 [1099 65]} :go/pos {:colon [1099 29]}} ["meth:_curses.window.delch" "delch([y, x])\nDelete the character under the cursor, or at (y, x) if specified.\n\n  y\n    Y-coordinate.\n  x\n    X-coordinate.\n\nAll characters to the right on the same line are shifted one\nposition left."]
    ^{:go/apos {0 [1100 2] 1 [1100 65]} :go/pos {:colon [1100 32]}} ["meth:_curses.window.deleteln" "Delete the line under the cursor; move following lines up by one."]
    ^{:go/apos {0 [1101 2] 1 [1101 65]} :go/pos {:colon [1101 30]}} ["meth:_curses.window.derwin" "derwin([nlines=0, ncols=0,] begin_y, begin_x)\nCreate a sub-window (window-relative coordinates).\n\n  nlines\n    Height.\n  ncols\n    Width.\n  begin_y\n    Top side y-coordinate.\n  begin_x\n    Left side x-coordinate.\n\nderwin() is the same as calling subwin(), except that begin_y and\nbegin_x are relative to the origin of the window, rather than\nrelative to the entire screen."]
    ^{:go/apos {0 [1102 2] 1 [1102 65]} :go/pos {:colon [1102 32]}} ["meth:_curses.window.echochar" "Add character ch with attribute attr, and refresh.\n\n  ch\n    Character to add.\n  attr\n    Attributes for the character."]
    ^{:go/apos {0 [1103 2] 1 [1103 65]} :go/pos {:colon [1103 31]}} ["meth:_curses.window.enclose" "Return True if the screen-relative coordinates are enclosed by the window.\n\n  y\n    Y-coordinate.\n  x\n    X-coordinate."]
    ^{:go/apos {0 [1104 2] 1 [1104 65]} :go/pos {:colon [1104 29]}} ["meth:_curses.window.erase" "Clear the window."]
    ^{:go/apos {0 [1105 2] 1 [1105 65]} :go/pos {:colon [1105 31]}} ["meth:_curses.window.get_wch" "get_wch([y, x])\nRead a key press and return it as a one-character str.\n\n  y\n    Y-coordinate.\n  x\n    X-coordinate.\n\nWait until a key is pressed, or raise curses.error if the read is\nnon-blocking or times out.\n\nIn keypad mode function keys and other special keys are returned as\none of the KEY_* constants, an integer.  Otherwise their characters\nare returned one at a time."]
    ^{:go/apos {0 [1106 2] 1 [1106 65]} :go/pos {:colon [1106 32]}} ["meth:_curses.window.getbegyx" "Return a tuple (y, x) of the upper-left corner coordinates."]
    ^{:go/apos {0 [1107 2] 1 [1107 65]} :go/pos {:colon [1107 31]}} ["meth:_curses.window.getbkgd" "Return the window's current background character/attribute pair."]
    ^{:go/apos {0 [1108 2] 1 [1108 65]} :go/pos {:colon [1108 29]}} ["meth:_curses.window.getch" "getch([y, x])\nRead a key press and return it as an integer.\n\n  y\n    Y-coordinate.\n  x\n    X-coordinate.\n\nWait until a key is pressed, or return -1 if the read is\nnon-blocking or times out.\n\nAn ordinary key is returned as the code of a single byte of its\nencoding in the current locale, so a character encoded with several\nbytes takes several calls.  Use get_wch() to read it as a single\ncharacter.\n\nIn keypad mode function keys and other special keys are returned as\none of the KEY_* constants, which cannot be mistaken for an ordinary\nkey.  Otherwise their bytes are returned one at a time."]
    ^{:go/apos {0 [1109 2] 1 [1109 65]} :go/pos {:colon [1109 30]}} ["meth:_curses.window.getkey" "getkey([y, x])\nRead a key press and return it as a str.\n\n  y\n    Y-coordinate.\n  x\n    X-coordinate.\n\nRead as getch() does, but return an ordinary key as a one-character\nstring, the byte decoded as Latin-1, and a special key as its name,\nsuch as 'KEY_UP'.  Raise curses.error instead of returning -1 if\nthere is no input."]
    ^{:go/apos {0 [1110 2] 1 [1110 65]} :go/pos {:colon [1110 32]}} ["meth:_curses.window.getmaxyx" "Return a tuple (y, x) of the window height and width."]
    ^{:go/apos {0 [1111 2] 1 [1111 65]} :go/pos {:colon [1111 32]}} ["meth:_curses.window.getparyx" "Return (y, x) relative to the parent window, or (-1, -1) if none."]
    ^{:go/apos {0 [1112 2] 1 [1112 65]} :go/pos {:colon [1112 30]}} ["meth:_curses.window.getstr" "getstr([[y, x,] n=2047])\nRead a line of input and return it as a bytes object.\n\n  y\n    Y-coordinate.\n  x\n    X-coordinate.\n  n\n    Maximal number of bytes."]
    ^{:go/apos {0 [1113 2] 1 [1113 65]} :go/pos {:colon [1113 29]}} ["meth:_curses.window.getyx" "Return a tuple (y, x) of the current cursor position."]
    ^{:go/apos {0 [1114 2] 1 [1114 65]} :go/pos {:colon [1114 29]}} ["meth:_curses.window.hline" "hline([y, x,] ch, n, [attr=_curses.A_NORMAL])\nDisplay a horizontal line.\n\n  y\n    Starting Y-coordinate.\n  x\n    Starting X-coordinate.\n  ch\n    Character to draw.\n  n\n    Line length.\n  attr\n    Attributes for the characters."]
    ^{:go/apos {0 [1115 2] 1 [1115 65]} :go/pos {:colon [1115 29]}} ["meth:_curses.window.idcok" "Enable or disable the hardware insert/delete character feature."]
    ^{:go/apos {0 [1116 2] 1 [1116 65]} :go/pos {:colon [1116 29]}} ["meth:_curses.window.idlok" "Enable or disable the hardware insert/delete line feature."]
    ^{:go/apos {0 [1117 2] 1 [1117 65]} :go/pos {:colon [1117 31]}} ["meth:_curses.window.immedok" "If flag is true, refresh the window on every change to it."]
    ^{:go/apos {0 [1118 2] 1 [1118 65]} :go/pos {:colon [1118 28]}} ["meth:_curses.window.inch" "inch([y, x])\nReturn the character at the given position in the window.\n\n  y\n    Y-coordinate.\n  x\n    X-coordinate.\n\nThe bottom 8 bits are the character proper, and upper bits are the\nattributes."]
    ^{:go/apos {0 [1119 2] 1 [1119 65]} :go/pos {:colon [1119 29]}} ["meth:_curses.window.insch" "insch([y, x,] ch, [attr=_curses.A_NORMAL])\nInsert a character before the current or specified position.\n\n  y\n    Y-coordinate.\n  x\n    X-coordinate.\n  ch\n    Character to insert.\n  attr\n    Attributes for the character.\n\nAll characters to the right of the cursor are shifted one position\nright, with the rightmost characters on the line being lost."]
    ^{:go/apos {0 [1120 2] 1 [1120 65]} :go/pos {:colon [1120 32]}} ["meth:_curses.window.insdelln" "Insert (nlines > 0) or delete (nlines < 0) lines above the cursor."]
    ^{:go/apos {0 [1121 2] 1 [1121 65]} :go/pos {:colon [1121 32]}} ["meth:_curses.window.insertln" "Insert a blank line under the cursor; move following lines down."]
    ^{:go/apos {0 [1122 2] 1 [1122 65]} :go/pos {:colon [1122 31]}} ["meth:_curses.window.insnstr" "insnstr([y, x,] str, n, [attr])\nInsert at most n characters of the string.\n\n  y\n    Y-coordinate.\n  x\n    X-coordinate.\n  str\n    String to insert.\n  n\n    Maximal number of characters.\n  attr\n    Attributes for characters.\n\nInsert a character string (as many characters as will fit on the\nline) before the character under the cursor, up to n characters.  If\nn is zero or negative, the entire string is inserted.  All\ncharacters to the right of the cursor are shifted right, with the\nrightmost characters on the line being lost.  The cursor position\ndoes not change (after moving to y, x, if specified)."]
    ^{:go/apos {0 [1123 2] 1 [1123 65]} :go/pos {:colon [1123 30]}} ["meth:_curses.window.insstr" "insstr([y, x,] str, [attr])\nInsert the string before the current or specified position.\n\n  y\n    Y-coordinate.\n  x\n    X-coordinate.\n  str\n    String to insert.\n  attr\n    Attributes for characters.\n\nInsert a character string (as many characters as will fit on the\nline) before the character under the cursor.  All characters to the\nright of the cursor are shifted right, with the rightmost characters\non the line being lost.  The cursor position does not change (after\nmoving to y, x, if specified)."]
    ^{:go/apos {0 [1124 2] 1 [1124 65]} :go/pos {:colon [1124 29]}} ["meth:_curses.window.instr" "instr([y, x,] n=2047)\nReturn the text of the window as a bytes object.\n\n  y\n    Y-coordinate.\n  x\n    X-coordinate.\n  n\n    Maximal number of bytes.\n\nRead from the current cursor position, or from y, x if specified, to\nthe end of the line, and return the text in the encoding of the\ncurrent locale, with attributes and color pairs stripped.  At most n\nbytes are read."]
    ^{:go/apos {0 [1125 2] 1 [1125 65]} :go/pos {:colon [1125 38]}} ["meth:_curses.window.is_linetouched" "Return True if the specified line was modified, otherwise return False.\n\n  line\n    Line number.\n\nRaise a curses.error exception if line is not valid for the given\nwindow."]
    ^{:go/apos {0 [1126 2] 1 [1126 65]} :go/pos {:colon [1126 37]}} ["meth:_curses.window.is_wintouched" "Return True if the window changed since the last refresh()."]
    ^{:go/apos {0 [1127 2] 1 [1127 65]} :go/pos {:colon [1127 30]}} ["meth:_curses.window.keypad" "Interpret escape sequences for special keys if flag is true."]
    ^{:go/apos {0 [1128 2] 1 [1128 65]} :go/pos {:colon [1128 31]}} ["meth:_curses.window.leaveok" "If flag is true, leave the cursor where the update leaves it."]
    ^{:go/apos {0 [1129 2] 1 [1129 65]} :go/pos {:colon [1129 28]}} ["meth:_curses.window.move" "Move the cursor to (new_y, new_x)."]
    ^{:go/apos {0 [1130 2] 1 [1130 65]} :go/pos {:colon [1130 32]}} ["meth:_curses.window.mvderwin" "Move the window inside its parent window."]
    ^{:go/apos {0 [1131 2] 1 [1131 65]} :go/pos {:colon [1131 29]}} ["meth:_curses.window.mvwin" "Move the window so its upper-left corner is at (new_y, new_x)."]
    ^{:go/apos {0 [1132 2] 1 [1132 65]} :go/pos {:colon [1132 31]}} ["meth:_curses.window.nodelay" "If flag is true, getch() becomes non-blocking."]
    ^{:go/apos {0 [1133 2] 1 [1133 65]} :go/pos {:colon [1133 33]}} ["meth:_curses.window.notimeout" "If flag is true, do not time out escape sequences."]
    ^{:go/apos {0 [1134 2] 1 [1134 65]} :go/pos {:colon [1134 35]}} ["meth:_curses.window.noutrefresh" "noutrefresh([pminrow, pmincol, sminrow, smincol, smaxrow, smaxcol])\nMark for refresh but wait.\n\nThis function updates the data structure representing the desired\nstate of the window, but does not force an update of the physical\nscreen.  To accomplish that, call doupdate()."]
    ^{:go/apos {0 [1135 2] 1 [1135 65]} :go/pos {:colon [1135 31]}} ["meth:_curses.window.overlay" "overlay(destwin, [sminrow, smincol, dminrow, dmincol, dmaxrow, dmaxcol])\nOverlay the window on top of destwin.\n\nThe windows need not be the same size, only the overlapping region\nis copied.  This copy is non-destructive, which means that the\ncurrent background character does not overwrite the old contents of\ndestwin.\n\nTo get fine-grained control over the copied region, the second form\nof overlay() can be used.  sminrow and smincol are the upper-left\ncoordinates of the source window, and the other variables mark\na rectangle in the destination window."]
    ^{:go/apos {0 [1136 2] 1 [1136 65]} :go/pos {:colon [1136 33]}} ["meth:_curses.window.overwrite" "overwrite(destwin, [sminrow, smincol, dminrow, dmincol, dmaxrow,\n          dmaxcol])\nOverwrite the window on top of destwin.\n\nThe windows need not be the same size, in which case only the\noverlapping region is copied.  This copy is destructive, which means\nthat the current background character overwrites the old contents of\ndestwin.\n\nTo get fine-grained control over the copied region, the second form\nof overwrite() can be used. sminrow and smincol are the upper-left\ncoordinates of the source window, the other variables mark\na rectangle in the destination window."]
    ^{:go/apos {0 [1137 2] 1 [1137 65]} :go/pos {:colon [1137 30]}} ["meth:_curses.window.putwin" "Write all data associated with the window into the provided file object.\n\nThis information can be later retrieved using the getwin() function."]
    ^{:go/apos {0 [1138 2] 1 [1138 65]} :go/pos {:colon [1138 32]}} ["meth:_curses.window.redrawln" "Mark the specified lines corrupted.\n\n  beg\n    Starting line number.\n  num\n    The number of lines.\n\nThey should be completely redrawn on the next refresh() call."]
    ^{:go/apos {0 [1139 2] 1 [1139 65]} :go/pos {:colon [1139 33]}} ["meth:_curses.window.redrawwin" "Mark the entire window for redraw on the next refresh()."]
    ^{:go/apos {0 [1140 2] 1 [1140 65]} :go/pos {:colon [1140 31]}} ["meth:_curses.window.refresh" "refresh([pminrow, pmincol, sminrow, smincol, smaxrow, smaxcol])\nUpdate the display immediately.\n\nSynchronize actual screen with previous drawing/deleting methods.\nThe 6 optional arguments can only be specified when the window is\na pad created with newpad().  The additional parameters are needed\nto indicate what part of the pad and screen are involved.  pminrow\nand pmincol specify the upper left-hand corner of the rectangle to\nbe displayed in the pad.  sminrow, smincol, smaxrow, and smaxcol\nspecify the edges of the rectangle to be displayed on the screen.\nThe lower right-hand corner of the rectangle to be displayed in the\npad is calculated from the screen coordinates, since the rectangles\nmust be the same size.  Both rectangles must be entirely contained\nwithin their respective structures.  Negative values of pminrow,\npmincol, sminrow, or smincol are treated as if they were zero."]
    ^{:go/apos {0 [1141 2] 1 [1141 65]} :go/pos {:colon [1141 30]}} ["meth:_curses.window.resize" "Resize the window to nlines rows and ncols columns."]
    ^{:go/apos {0 [1142 2] 1 [1142 65]} :go/pos {:colon [1142 30]}} ["meth:_curses.window.scroll" "scroll([lines=1])\nScroll the screen or scrolling region.\n\n  lines\n    Number of lines to scroll.\n\nScroll upward if the argument is positive and downward if it is\nnegative."]
    ^{:go/apos {0 [1143 2] 1 [1143 65]} :go/pos {:colon [1143 32]}} ["meth:_curses.window.scrollok" "Control whether the window scrolls when the cursor moves off it."]
    ^{:go/apos {0 [1144 2] 1 [1144 65]} :go/pos {:colon [1144 33]}} ["meth:_curses.window.setscrreg" "Define a software scrolling region.\n\n  top\n    First line number.\n  bottom\n    Last line number.\n\nAll scrolling actions will take place in this region."]
    ^{:go/apos {0 [1145 2] 1 [1145 65]} :go/pos {:colon [1145 32]}} ["meth:_curses.window.standend" "Turn off the standout attribute."]
    ^{:go/apos {0 [1146 2] 1 [1146 65]} :go/pos {:colon [1146 32]}} ["meth:_curses.window.standout" "Turn on the A_STANDOUT attribute."]
    ^{:go/apos {0 [1147 2] 1 [1147 65]} :go/pos {:colon [1147 30]}} ["meth:_curses.window.subpad" "subwin([nlines=0, ncols=0,] begin_y, begin_x)\nCreate a sub-window (screen-relative coordinates).\n\n  nlines\n    Height.\n  ncols\n    Width.\n  begin_y\n    Top side y-coordinate.\n  begin_x\n    Left side x-coordinate.\n\nBy default, the sub-window will extend from the specified position\nto the lower right corner of the window."]
    ^{:go/apos {0 [1148 2] 1 [1148 65]} :go/pos {:colon [1148 30]}} ["meth:_curses.window.subwin" "subwin([nlines=0, ncols=0,] begin_y, begin_x)\nCreate a sub-window (screen-relative coordinates).\n\n  nlines\n    Height.\n  ncols\n    Width.\n  begin_y\n    Top side y-coordinate.\n  begin_x\n    Left side x-coordinate.\n\nBy default, the sub-window will extend from the specified position\nto the lower right corner of the window."]
    ^{:go/apos {0 [1149 2] 1 [1149 65]} :go/pos {:colon [1149 32]}} ["meth:_curses.window.syncdown" "Touch each location changed in any ancestor of the window."]
    ^{:go/apos {0 [1150 2] 1 [1150 65]} :go/pos {:colon [1150 30]}} ["meth:_curses.window.syncok" "If flag is true, call syncup() on every change to the window."]
    ^{:go/apos {0 [1151 2] 1 [1151 65]} :go/pos {:colon [1151 30]}} ["meth:_curses.window.syncup" "Touch locations in ancestors that changed in this window."]
    ^{:go/apos {0 [1152 2] 1 [1152 65]} :go/pos {:colon [1152 31]}} ["meth:_curses.window.timeout" "Set blocking or non-blocking read behavior for the window."]
    ^{:go/apos {0 [1153 2] 1 [1153 65]} :go/pos {:colon [1153 33]}} ["meth:_curses.window.touchline" "touchline(start, count, [changed=True])\nPretend count lines have been changed, starting with line start.\n\nIf changed is supplied, it specifies whether the affected lines are\nmarked as having been changed (changed=True) or unchanged\n(changed=False)."]
    ^{:go/apos {0 [1154 2] 1 [1154 65]} :go/pos {:colon [1154 32]}} ["meth:_curses.window.touchwin" "Mark the whole window as changed."]
    ^{:go/apos {0 [1155 2] 1 [1155 65]} :go/pos {:colon [1155 34]}} ["meth:_curses.window.untouchwin" "Mark all lines in the window as unchanged since last refresh()."]
    ^{:go/apos {0 [1156 2] 1 [1156 65]} :go/pos {:colon [1156 29]}} ["meth:_curses.window.vline" "vline([y, x,] ch, n, [attr=_curses.A_NORMAL])\nDisplay a vertical line.\n\n  y\n    Starting Y-coordinate.\n  x\n    Starting X-coordinate.\n  ch\n    Character to draw.\n  n\n    Line length.\n  attr\n    Attributes for the character."]
    ^{:go/apos {0 [1157 2] 1 [1157 65]} :go/pos {:colon [1157 34]}} ["meth:_curses_panel.panel.above" "Return the panel above the current panel."]
    ^{:go/apos {0 [1158 2] 1 [1158 65]} :go/pos {:colon [1158 34]}} ["meth:_curses_panel.panel.below" "Return the panel below the current panel."]
    ^{:go/apos {0 [1159 2] 1 [1159 65]} :go/pos {:colon [1159 35]}} ["meth:_curses_panel.panel.bottom" "Push the panel to the bottom of the stack."]
    ^{:go/apos {0 [1160 2] 1 [1160 65]} :go/pos {:colon [1160 35]}} ["meth:_curses_panel.panel.hidden" "Return True if the panel is hidden (not visible), False otherwise."]
    ^{:go/apos {0 [1161 2] 1 [1161 65]} :go/pos {:colon [1161 33]}} ["meth:_curses_panel.panel.hide" "Hide the panel.\n\nThis does not delete the object, it just makes the window on screen\ninvisible."]
    ^{:go/apos {0 [1162 2] 1 [1162 65]} :go/pos {:colon [1162 33]}} ["meth:_curses_panel.panel.move" "Move the panel to the screen coordinates (y, x)."]
    ^{:go/apos {0 [1163 2] 1 [1163 65]} :go/pos {:colon [1163 36]}} ["meth:_curses_panel.panel.replace" "Change the window associated with the panel to the window win."]
    ^{:go/apos {0 [1164 2] 1 [1164 65]} :go/pos {:colon [1164 40]}} ["meth:_curses_panel.panel.set_userptr" "Set the panel's user pointer to obj."]
    ^{:go/apos {0 [1165 2] 1 [1165 65]} :go/pos {:colon [1165 33]}} ["meth:_curses_panel.panel.show" "Display the panel (which might have been hidden).\n\nThe panel is placed on top of the panel stack."]
    ^{:go/apos {0 [1166 2] 1 [1166 65]} :go/pos {:colon [1166 32]}} ["meth:_curses_panel.panel.top" "Push panel to the top of the stack."]
    ^{:go/apos {0 [1167 2] 1 [1167 65]} :go/pos {:colon [1167 36]}} ["meth:_curses_panel.panel.userptr" "Return the user pointer for the panel."]
    ^{:go/apos {0 [1168 2] 1 [1168 65]} :go/pos {:colon [1168 35]}} ["meth:_curses_panel.panel.window" "Return the window object associated with the panel."]
    ^{:go/apos {0 [1169 2] 1 [1169 65]} :go/pos {:colon [1169 27]}} ["meth:_hashlib.HASH.copy" "Return a copy of the hash object."]
    ^{:go/apos {0 [1170 2] 1 [1170 65]} :go/pos {:colon [1170 29]}} ["meth:_hashlib.HASH.digest" "Return the digest value as a bytes object."]
    ^{:go/apos {0 [1171 2] 1 [1171 65]} :go/pos {:colon [1171 32]}} ["meth:_hashlib.HASH.hexdigest" "Return the digest value as a string of hexadecimal digits."]
    ^{:go/apos {0 [1172 2] 1 [1172 65]} :go/pos {:colon [1172 29]}} ["meth:_hashlib.HASH.update" "Update this hash object's state with the provided string."]
    ^{:go/apos {0 [1173 2] 1 [1173 65]} :go/pos {:colon [1173 32]}} ["meth:_hashlib.HASHXOF.digest" "Return the digest value as a bytes object."]
    ^{:go/apos {0 [1174 2] 1 [1174 65]} :go/pos {:colon [1174 35]}} ["meth:_hashlib.HASHXOF.hexdigest" "Return the digest value as a string of hexadecimal digits."]
    ^{:go/apos {0 [1175 2] 1 [1175 65]} :go/pos {:colon [1175 27]}} ["meth:_hashlib.HMAC.copy" "Return a copy (\"clone\") of the HMAC object."]
    ^{:go/apos {0 [1176 2] 1 [1176 65]} :go/pos {:colon [1176 29]}} ["meth:_hashlib.HMAC.digest" "Return the digest of the bytes passed to the update() method so far."]
    ^{:go/apos {0 [1177 2] 1 [1177 65]} :go/pos {:colon [1177 32]}} ["meth:_hashlib.HMAC.hexdigest" "Return hexadecimal digest of the bytes passed to the update() method so far.\n\nThis may be used to exchange the value safely in email or other\nnon-binary environments."]
    ^{:go/apos {0 [1178 2] 1 [1178 65]} :go/pos {:colon [1178 29]}} ["meth:_hashlib.HMAC.update" "Update the HMAC object with msg."]
    ^{:go/apos {0 [1179 2] 1 [1179 65]} :go/pos {:colon [1179 24]}} ["meth:_hmac.HMAC.copy" "Return a copy (\"clone\") of the HMAC object."]
    ^{:go/apos {0 [1180 2] 1 [1180 65]} :go/pos {:colon [1180 26]}} ["meth:_hmac.HMAC.digest" "Return the digest of the bytes passed to the update() method so far.\n\nThis method may raise a MemoryError."]
    ^{:go/apos {0 [1181 2] 1 [1181 65]} :go/pos {:colon [1181 29]}} ["meth:_hmac.HMAC.hexdigest" "Return hexadecimal digest of the bytes passed to the update() method so far.\n\nThis may be used to exchange the value safely in email or other\nnon-binary environments.\n\nThis method may raise a MemoryError."]
    ^{:go/apos {0 [1182 2] 1 [1182 65]} :go/pos {:colon [1182 26]}} ["meth:_hmac.HMAC.update" "Update the HMAC object with the given message."]
    ^{:go/apos {0 [1183 2] 1 [1183 65]} :go/pos {:colon [1183 44]}} ["meth:_interpchannels.ChannelInfo.__new__" "Create and return a new object.  See help(type) for accurate signature."]
    ^{:go/apos {0 [1184 2] 1 [1184 65]} :go/pos {:colon [1184 48]}} ["meth:_interpchannels.ChannelInfo.__replace__" "Return a copy of the structure with new values for the specified fields."]
    ^{:go/apos {0 [1185 2] 1 [1185 65]} :go/pos {:colon [1185 28]}} ["meth:_io.BytesIO.__new__" "Create and return a new object.  See help(type) for accurate signature."]
    ^{:go/apos {0 [1186 2] 1 [1186 65]} :go/pos {:colon [1186 26]}} ["meth:_io.BytesIO.close" "Disable all I/O operations."]
    ^{:go/apos {0 [1187 2] 1 [1187 65]} :go/pos {:colon [1187 26]}} ["meth:_io.BytesIO.flush" "Does nothing."]
    ^{:go/apos {0 [1188 2] 1 [1188 65]} :go/pos {:colon [1188 30]}} ["meth:_io.BytesIO.getbuffer" "Get a read-write view over the contents of the BytesIO object."]
    ^{:go/apos {0 [1189 2] 1 [1189 65]} :go/pos {:colon [1189 29]}} ["meth:_io.BytesIO.getvalue" "Retrieve the entire contents of the BytesIO object."]
    ^{:go/apos {0 [1190 2] 1 [1190 65]} :go/pos {:colon [1190 27]}} ["meth:_io.BytesIO.isatty" "Always returns False.\n\nBytesIO objects are not connected to a TTY-like device."]
    ^{:go/apos {0 [1191 2] 1 [1191 65]} :go/pos {:colon [1191 25]}} ["meth:_io.BytesIO.read" "Read at most size bytes, returned as a bytes object.\n\nIf the size argument is negative, read until EOF is reached.\nReturn an empty bytes object at EOF."]
    ^{:go/apos {0 [1192 2] 1 [1192 65]} :go/pos {:colon [1192 26]}} ["meth:_io.BytesIO.read1" "Read at most size bytes, returned as a bytes object.\n\nIf the size argument is negative or omitted, read until EOF is\nreached.  Return an empty bytes object at EOF."]
    ^{:go/apos {0 [1193 2] 1 [1193 65]} :go/pos {:colon [1193 29]}} ["meth:_io.BytesIO.readable" "Returns True if the IO object can be read."]
    ^{:go/apos {0 [1194 2] 1 [1194 65]} :go/pos {:colon [1194 29]}} ["meth:_io.BytesIO.readinto" "Read bytes into buffer.\n\nReturns number of bytes read (0 for EOF), or None if the object\nis set not to block and has no data to read."]
    ^{:go/apos {0 [1195 2] 1 [1195 65]} :go/pos {:colon [1195 29]}} ["meth:_io.BytesIO.readline" "Next line from the file, as a bytes object.\n\nRetain newline.  A non-negative size argument limits the maximum\nnumber of bytes to return (an incomplete line may be returned then).\nReturn an empty bytes object at EOF."]
    ^{:go/apos {0 [1196 2] 1 [1196 65]} :go/pos {:colon [1196 30]}} ["meth:_io.BytesIO.readlines" "List of bytes objects, each a line from the file.\n\nCall readline() repeatedly and return a list of the lines so read.\nThe optional size argument, if given, is an approximate bound on the\ntotal number of bytes in the lines returned."]
    ^{:go/apos {0 [1197 2] 1 [1197 65]} :go/pos {:colon [1197 25]}} ["meth:_io.BytesIO.seek" "Change stream position.\n\nSeek to byte offset pos relative to position indicated by whence:\n     0  Start of stream (the default).  pos should be >= 0;\n     1  Current position - pos may be negative;\n     2  End of stream - pos usually negative.\nReturns the new absolute position."]
    ^{:go/apos {0 [1198 2] 1 [1198 65]} :go/pos {:colon [1198 29]}} ["meth:_io.BytesIO.seekable" "Returns True if the IO object can be seeked."]
    ^{:go/apos {0 [1199 2] 1 [1199 65]} :go/pos {:colon [1199 25]}} ["meth:_io.BytesIO.tell" "Current file position, an integer."]
    ^{:go/apos {0 [1200 2] 1 [1200 65]} :go/pos {:colon [1200 29]}} ["meth:_io.BytesIO.truncate" "Truncate the file to at most size bytes.\n\nSize defaults to the current file position, as returned by tell().\nThe current file position is unchanged.  Returns the new size."]
    ^{:go/apos {0 [1201 2] 1 [1201 65]} :go/pos {:colon [1201 29]}} ["meth:_io.BytesIO.writable" "Returns True if the IO object can be written."]
    ^{:go/apos {0 [1202 2] 1 [1202 65]} :go/pos {:colon [1202 26]}} ["meth:_io.BytesIO.write" "Write bytes to file.\n\nReturn the number of bytes written."]
    ^{:go/apos {0 [1203 2] 1 [1203 65]} :go/pos {:colon [1203 31]}} ["meth:_io.BytesIO.writelines" "Write lines to the file.\n\nNote that newlines are not added.  lines can be any iterable object\nproducing bytes-like objects.  This is equivalent to calling write()\nfor each element."]
    ^{:go/apos {0 [1204 2] 1 [1204 65]} :go/pos {:colon [1204 27]}} ["meth:_io.FileIO.__new__" "Create and return a new object.  See help(type) for accurate signature."]
    ^{:go/apos {0 [1205 2] 1 [1205 65]} :go/pos {:colon [1205 25]}} ["meth:_io.FileIO.close" "Close the file.\n\nA closed file cannot be used for further I/O operations.  close()\nmay be called more than once without error."]
    ^{:go/apos {0 [1206 2] 1 [1206 65]} :go/pos {:colon [1206 26]}} ["meth:_io.FileIO.fileno" "Return the underlying file descriptor (an integer)."]
    ^{:go/apos {0 [1207 2] 1 [1207 65]} :go/pos {:colon [1207 26]}} ["meth:_io.FileIO.isatty" "True if the file is connected to a TTY device."]
    ^{:go/apos {0 [1208 2] 1 [1208 65]} :go/pos {:colon [1208 24]}} ["meth:_io.FileIO.read" "Read at most size bytes, returned as bytes.\n\nIf size is less than 0, read all bytes in the file making multiple\nread calls.  See ``FileIO.readall``.\n\nAttempts to make only one system call, retrying only per PEP 475\n(EINTR).  This means less data may be returned than requested.\n\nIn non-blocking mode, returns None if no data is available.  Return\nan empty bytes object at EOF."]
    ^{:go/apos {0 [1209 2] 1 [1209 65]} :go/pos {:colon [1209 28]}} ["meth:_io.FileIO.readable" "True if file was opened in a read mode."]
    ^{:go/apos {0 [1210 2] 1 [1210 65]} :go/pos {:colon [1210 27]}} ["meth:_io.FileIO.readall" "Read all data from the file, returned as bytes.\n\nReads until either there is an error or read() returns size 0\n(indicates EOF).  If the file is already at EOF, returns an empty\nbytes object.\n\nIn non-blocking mode, returns as much data as could be read before\nEAGAIN.  If no data is available (EAGAIN is returned before bytes\nare read) returns None."]
    ^{:go/apos {0 [1211 2] 1 [1211 65]} :go/pos {:colon [1211 28]}} ["meth:_io.FileIO.readinto" "Same as RawIOBase.readinto()."]
    ^{:go/apos {0 [1212 2] 1 [1212 65]} :go/pos {:colon [1212 24]}} ["meth:_io.FileIO.seek" "Move to new file position and return the file position.\n\nArgument offset is a byte count.  Optional argument whence defaults\nto SEEK_SET or 0 (offset from start of file, offset should be >= 0);\nother values are SEEK_CUR or 1 (move relative to current position,\npositive or negative), and SEEK_END or 2 (move relative to end of\nfile, usually negative, although many platforms allow seeking beyond\nthe end of a file).\n\nNote that not all file objects are seekable."]
    ^{:go/apos {0 [1213 2] 1 [1213 65]} :go/pos {:colon [1213 28]}} ["meth:_io.FileIO.seekable" "True if file supports random-access."]
    ^{:go/apos {0 [1214 2] 1 [1214 65]} :go/pos {:colon [1214 24]}} ["meth:_io.FileIO.tell" "Current file position.\n\nCan raise OSError for non seekable files."]
    ^{:go/apos {0 [1215 2] 1 [1215 65]} :go/pos {:colon [1215 28]}} ["meth:_io.FileIO.truncate" "Truncate the file to at most size bytes and return the truncated size.\n\nSize defaults to the current file position, as returned by tell().\nThe current file position is changed to the value of size."]
    ^{:go/apos {0 [1216 2] 1 [1216 65]} :go/pos {:colon [1216 28]}} ["meth:_io.FileIO.writable" "True if file was opened in a write mode."]
    ^{:go/apos {0 [1217 2] 1 [1217 65]} :go/pos {:colon [1217 25]}} ["meth:_io.FileIO.write" "Write buffer b to file, return number of bytes written.\n\nOnly makes one system call, so not all of the data may be written.\nThe number of bytes actually written is returned.  In non-blocking\nmode, returns None if the write would block."]
    ^{:go/apos {0 [1218 2] 1 [1218 65]} :go/pos {:colon [1218 29]}} ["meth:_io.StringIO.__new__" "Create and return a new object.  See help(type) for accurate signature."]
    ^{:go/apos {0 [1219 2] 1 [1219 65]} :go/pos {:colon [1219 27]}} ["meth:_io.StringIO.close" "Close the IO object.\n\nAttempting any further operation after the object is closed\nwill raise a ValueError.\n\nThis method has no effect if the file is already closed."]
    ^{:go/apos {0 [1220 2] 1 [1220 65]} :go/pos {:colon [1220 30]}} ["meth:_io.StringIO.getvalue" "Retrieve the entire contents of the object."]
    ^{:go/apos {0 [1221 2] 1 [1221 65]} :go/pos {:colon [1221 26]}} ["meth:_io.StringIO.read" "Read at most size characters, returned as a string.\n\nIf the argument is negative or omitted, read until EOF\nis reached. Return an empty string at EOF."]
    ^{:go/apos {0 [1222 2] 1 [1222 65]} :go/pos {:colon [1222 30]}} ["meth:_io.StringIO.readable" "Returns True if the IO object can be read."]
    ^{:go/apos {0 [1223 2] 1 [1223 65]} :go/pos {:colon [1223 30]}} ["meth:_io.StringIO.readline" "Read until newline or EOF.\n\nReturns an empty string if EOF is hit immediately."]
    ^{:go/apos {0 [1224 2] 1 [1224 65]} :go/pos {:colon [1224 26]}} ["meth:_io.StringIO.seek" "Change stream position.\n\nSeek to character offset pos relative to position indicated by\nwhence:\n    0  Start of stream (the default).  pos should be >= 0;\n    1  Current position - pos must be 0;\n    2  End of stream - pos must be 0.\nReturns the new absolute position."]
    ^{:go/apos {0 [1225 2] 1 [1225 65]} :go/pos {:colon [1225 30]}} ["meth:_io.StringIO.seekable" "Returns True if the IO object can be seeked."]
    ^{:go/apos {0 [1226 2] 1 [1226 65]} :go/pos {:colon [1226 26]}} ["meth:_io.StringIO.tell" "Tell the current file position."]
    ^{:go/apos {0 [1227 2] 1 [1227 65]} :go/pos {:colon [1227 30]}} ["meth:_io.StringIO.truncate" "Truncate size to pos.\n\nThe pos argument defaults to the current file position, as\nreturned by tell().  The current file position is unchanged.\nReturns the new absolute position."]
    ^{:go/apos {0 [1228 2] 1 [1228 65]} :go/pos {:colon [1228 30]}} ["meth:_io.StringIO.writable" "Returns True if the IO object can be written."]
    ^{:go/apos {0 [1229 2] 1 [1229 65]} :go/pos {:colon [1229 27]}} ["meth:_io.StringIO.write" "Write string to file.\n\nReturns the number of characters written, which is always equal to\nthe length of the string."]
    ^{:go/apos {0 [1230 2] 1 [1230 65]} :go/pos {:colon [1230 38]}} ["meth:_io.TextIOWrapper.reconfigure" "Reconfigure the text stream with new parameters.\n\nThis also does an implicit stream flush."]
    ^{:go/apos {0 [1231 2] 1 [1231 65]} :go/pos {:colon [1231 31]}} ["meth:_io.TextIOWrapper.seek" "Set the stream position, and return the new stream position.\n\n  cookie\n    Zero or an opaque number returned by tell().\n  whence\n    The relative position to seek from.\n\nFour operations are supported, given by the following argument\ncombinations:\n\n- seek(0, SEEK_SET): Rewind to the start of the stream.\n- seek(cookie, SEEK_SET): Restore a previous position;\n  'cookie' must be a number returned by tell().\n- seek(0, SEEK_END): Fast-forward to the end of the stream.\n- seek(0, SEEK_CUR): Leave the current stream position unchanged.\n\nAny other argument combinations are invalid,\nand may raise exceptions."]
    ^{:go/apos {0 [1232 2] 1 [1232 65]} :go/pos {:colon [1232 31]}} ["meth:_io.TextIOWrapper.tell" "Return the stream position as an opaque number.\n\nThe return value of tell() can be given as input to seek(), to\nrestore a previous stream position."]
    ^{:go/apos {0 [1233 2] 1 [1233 65]} :go/pos {:colon [1233 35]}} ["meth:_io._BufferedIOBase.detach" "Disconnect this buffer from its underlying raw stream and return it.\n\nAfter the raw stream has been detached, the buffer is in an unusable\nstate."]
    ^{:go/apos {0 [1234 2] 1 [1234 65]} :go/pos {:colon [1234 33]}} ["meth:_io._BufferedIOBase.read" "Read and return up to n bytes.\n\nIf the size argument is omitted, None, or negative, read and\nreturn all data until EOF.\n\nIf the size argument is positive, and the underlying raw stream is\nnot 'interactive', multiple raw reads may be issued to satisfy\nthe byte count (unless EOF is reached first).\nHowever, for interactive raw streams (as well as sockets and pipes),\nat most one raw read will be issued, and a short result does not\nimply that EOF is imminent.\n\nReturn an empty bytes object on EOF.\n\nReturn None if the underlying raw stream was open in non-blocking\nmode and no data is available at the moment."]
    ^{:go/apos {0 [1235 2] 1 [1235 65]} :go/pos {:colon [1235 34]}} ["meth:_io._BufferedIOBase.read1" "Read and return up to size bytes, with at most one read() call to the underlying raw stream.\n\nReturn an empty bytes object on EOF.\nA short result does not imply that EOF is imminent."]
    ^{:go/apos {0 [1236 2] 1 [1236 65]} :go/pos {:colon [1236 34]}} ["meth:_io._BufferedIOBase.write" "Write buffer b to the IO stream.\n\nReturn the number of bytes written, which is always\nthe length of b in bytes.\n\nRaise BlockingIOError if the buffer is full and the\nunderlying raw stream cannot accept more data at the moment."]
    ^{:go/apos {0 [1237 2] 1 [1237 65]} :go/pos {:colon [1237 26]}} ["meth:_io._IOBase.close" "Flush and close the IO object.\n\nThis method has no effect if the file is already closed."]
    ^{:go/apos {0 [1238 2] 1 [1238 65]} :go/pos {:colon [1238 27]}} ["meth:_io._IOBase.fileno" "Return underlying file descriptor if one exists.\n\nRaise OSError if the IO object does not use a file descriptor."]
    ^{:go/apos {0 [1239 2] 1 [1239 65]} :go/pos {:colon [1239 26]}} ["meth:_io._IOBase.flush" "Flush write buffers, if applicable.\n\nThis is not implemented for read-only and non-blocking streams."]
    ^{:go/apos {0 [1240 2] 1 [1240 65]} :go/pos {:colon [1240 27]}} ["meth:_io._IOBase.isatty" "Return whether this is an 'interactive' stream.\n\nReturn False if it can't be determined."]
    ^{:go/apos {0 [1241 2] 1 [1241 65]} :go/pos {:colon [1241 29]}} ["meth:_io._IOBase.readable" "Return whether object was opened for reading.\n\nIf False, read() will raise OSError."]
    ^{:go/apos {0 [1242 2] 1 [1242 65]} :go/pos {:colon [1242 29]}} ["meth:_io._IOBase.readline" "Read and return a line from the stream.\n\nIf size is specified, at most size bytes will be read.\n\nThe line terminator is always b'\\n' for binary files; for text\nfiles, the newlines argument to open can be used to select the line\nterminator(s) recognized."]
    ^{:go/apos {0 [1243 2] 1 [1243 65]} :go/pos {:colon [1243 30]}} ["meth:_io._IOBase.readlines" "Return a list of lines from the stream.\n\nhint can be specified to control the number of lines read: no more\nlines will be read if the total size (in bytes/characters) of all\nlines so far exceeds hint."]
    ^{:go/apos {0 [1244 2] 1 [1244 65]} :go/pos {:colon [1244 25]}} ["meth:_io._IOBase.seek" "Change the stream position to the given byte offset.\n\n  offset\n    The stream position, relative to 'whence'.\n  whence\n    The relative position to seek from.\n\nThe offset is interpreted relative to the position indicated by\nwhence.  Values for whence are:\n\n* os.SEEK_SET or 0 -- start of stream (the default); offset should\n  be zero or positive\n* os.SEEK_CUR or 1 -- current stream position; offset may be\n  negative\n* os.SEEK_END or 2 -- end of stream; offset is usually negative\n\nReturn the new absolute position."]
    ^{:go/apos {0 [1245 2] 1 [1245 65]} :go/pos {:colon [1245 29]}} ["meth:_io._IOBase.seekable" "Return whether object supports random access.\n\nIf False, seek(), tell() and truncate() will raise OSError.\nThis method may need to do a test seek()."]
    ^{:go/apos {0 [1246 2] 1 [1246 65]} :go/pos {:colon [1246 25]}} ["meth:_io._IOBase.tell" "Return current stream position."]
    ^{:go/apos {0 [1247 2] 1 [1247 65]} :go/pos {:colon [1247 29]}} ["meth:_io._IOBase.truncate" "Truncate file to size bytes.\n\nFile pointer is left unchanged.  Size defaults to the current IO\nposition as reported by tell().  Return the new size."]
    ^{:go/apos {0 [1248 2] 1 [1248 65]} :go/pos {:colon [1248 29]}} ["meth:_io._IOBase.writable" "Return whether object was opened for writing.\n\nIf False, write() will raise OSError."]
    ^{:go/apos {0 [1249 2] 1 [1249 65]} :go/pos {:colon [1249 31]}} ["meth:_io._IOBase.writelines" "Write a list of lines to stream.\n\nLine separators are not added, so it is usual for each of the\nlines provided to have a line separator at the end."]
    ^{:go/apos {0 [1250 2] 1 [1250 65]} :go/pos {:colon [1250 31]}} ["meth:_io._RawIOBase.readall" "Read until EOF, using multiple read() call."]
    ^{:go/apos {0 [1251 2] 1 [1251 65]} :go/pos {:colon [1251 31]}} ["meth:_io._TextIOBase.detach" "Separate the underlying buffer from the TextIOBase and return it.\n\nAfter the underlying buffer has been detached, the TextIO is in\nan unusable state."]
    ^{:go/apos {0 [1252 2] 1 [1252 65]} :go/pos {:colon [1252 29]}} ["meth:_io._TextIOBase.read" "Read at most size characters from stream.\n\nRead from underlying buffer until we have size characters or we hit\nEOF.  If size is negative or omitted, read until EOF."]
    ^{:go/apos {0 [1253 2] 1 [1253 65]} :go/pos {:colon [1253 33]}} ["meth:_io._TextIOBase.readline" "Read until newline or EOF.\n\nReturn an empty string if EOF is hit immediately.\nIf size is specified, at most size characters will be read."]
    ^{:go/apos {0 [1254 2] 1 [1254 65]} :go/pos {:colon [1254 30]}} ["meth:_io._TextIOBase.write" "Write string s to stream.\n\nReturn the number of characters written\n(which is always equal to the length of the string)."]
    ^{:go/apos {0 [1255 2] 1 [1255 65]} :go/pos {:colon [1255 30]}} ["meth:_json.Encoder.__new__" "Create and return a new object.  See help(type) for accurate signature."]
    ^{:go/apos {0 [1256 2] 1 [1256 65]} :go/pos {:colon [1256 30]}} ["meth:_json.Scanner.__new__" "Create and return a new object.  See help(type) for accurate signature."]
    ^{:go/apos {0 [1257 2] 1 [1257 65]} :go/pos {:colon [1257 31]}} ["meth:_lsprof.Profiler.clear" "Clear all profiling information collected so far."]
    ^{:go/apos {0 [1258 2] 1 [1258 65]} :go/pos {:colon [1258 33]}} ["meth:_lsprof.Profiler.disable" "Stop collecting profiling information."]
    ^{:go/apos {0 [1259 2] 1 [1259 65]} :go/pos {:colon [1259 32]}} ["meth:_lsprof.Profiler.enable" "Start collecting profiling information.\n\n  subcalls\n    If True, also records for each function\n    statistics separated according to its current caller.\n  builtins\n    If True, records the time spent in\n    built-in functions separately from their caller."]
    ^{:go/apos {0 [1260 2] 1 [1260 65]} :go/pos {:colon [1260 34]}} ["meth:_lsprof.Profiler.getstats" "list of profiler_entry objects.\n\ngetstats() -> list of profiler_entry objects\n\nReturn all information collected by the profiler.\nEach profiler_entry is a tuple-like object with the\nfollowing attributes:\n\n    code          code object\n    callcount     how many times this was called\n    reccallcount  how many times called recursively\n    totaltime     total time in this entry\n    inlinetime    inline time in this entry (not in subcalls)\n    calls         details of the calls\n\nThe calls attribute is either None or a list of\nprofiler_subentry objects:\n\n    code          called code object\n    callcount     how many times this is called\n    reccallcount  how many times this is called recursively\n    totaltime     total time spent in this call\n    inlinetime    inline time (not in further subcalls)"]
    ^{:go/apos {0 [1261 2] 1 [1261 65]} :go/pos {:colon [1261 39]}} ["meth:_lsprof.profiler_entry.__new__" "Create and return a new object.  See help(type) for accurate signature."]
    ^{:go/apos {0 [1262 2] 1 [1262 65]} :go/pos {:colon [1262 43]}} ["meth:_lsprof.profiler_entry.__replace__" "Return a copy of the structure with new values for the specified fields."]
    ^{:go/apos {0 [1263 2] 1 [1263 65]} :go/pos {:colon [1263 42]}} ["meth:_lsprof.profiler_subentry.__new__" "Create and return a new object.  See help(type) for accurate signature."]
    ^{:go/apos {0 [1264 2] 1 [1264 65]} :go/pos {:colon [1264 46]}} ["meth:_lsprof.profiler_subentry.__replace__" "Return a copy of the structure with new values for the specified fields."]
    ^{:go/apos {0 [1265 2] 1 [1265 65]} :go/pos {:colon [1265 37]}} ["meth:_lzma.LZMACompressor.__new__" "Create and return a new object.  See help(type) for accurate signature."]
    ^{:go/apos {0 [1266 2] 1 [1266 65]} :go/pos {:colon [1266 38]}} ["meth:_lzma.LZMACompressor.compress" "Provide data to the compressor object.\n\nReturns a chunk of compressed data if possible, or b'' otherwise.\n\nWhen you have finished providing data to the compressor, call the\nflush() method to finish the compression process."]
    ^{:go/apos {0 [1267 2] 1 [1267 65]} :go/pos {:colon [1267 35]}} ["meth:_lzma.LZMACompressor.flush" "Finish the compression process.\n\nReturns the compressed data left in internal buffers.\n\nThe compressor object may not be used after this method is called."]
    ^{:go/apos {0 [1268 2] 1 [1268 65]} :go/pos {:colon [1268 39]}} ["meth:_lzma.LZMADecompressor.__new__" "Create and return a new object.  See help(type) for accurate signature."]
    ^{:go/apos {0 [1269 2] 1 [1269 65]} :go/pos {:colon [1269 42]}} ["meth:_lzma.LZMADecompressor.decompress" "Decompress *data*, returning uncompressed data as bytes.\n\nIf *max_length* is nonnegative, returns at most *max_length* bytes\nof decompressed data. If this limit is reached and further output\ncan be produced, *self.needs_input* will be set to ``False``.  In\nthis case, the next call to *decompress()* may provide *data* as b''\nto obtain more of the output.\n\nIf all of the input data was decompressed and returned (either\nbecause this was less than *max_length* bytes, or because\n*max_length* was negative), *self.needs_input* will be set to True.\n\nAttempting to decompress data after the end of stream is reached\nraises an EOFError.  Any data found after the end of the stream is\nignored and saved in the unused_data attribute."]
    ^{:go/apos {0 [1270 2] 1 [1270 65]} :go/pos {:colon [1270 22]}} ["meth:_md5.md5.copy" "Return a copy of the hash object."]
    ^{:go/apos {0 [1271 2] 1 [1271 65]} :go/pos {:colon [1271 24]}} ["meth:_md5.md5.digest" "Return the digest value as a bytes object."]
    ^{:go/apos {0 [1272 2] 1 [1272 65]} :go/pos {:colon [1272 27]}} ["meth:_md5.md5.hexdigest" "Return the digest value as a string of hexadecimal digits."]
    ^{:go/apos {0 [1273 2] 1 [1273 65]} :go/pos {:colon [1273 24]}} ["meth:_md5.md5.update" "Update this hash object's state with the provided string."]
    ^{:go/apos {0 [1274 2] 1 [1274 65]} :go/pos {:colon [1274 46]}} ["meth:_multibytecodec.MultibyteCodec.decode" "Decodes 'input'.\n\n'errors' may be given to set a different error handling scheme.\nDefault is 'strict' meaning that encoding errors raise\na UnicodeDecodeError.  Other possible values are 'ignore' and\n'replace' as well as any other name registered with\ncodecs.register_error that is able to handle UnicodeDecodeErrors.\""]
    ^{:go/apos {0 [1275 2] 1 [1275 65]} :go/pos {:colon [1275 46]}} ["meth:_multibytecodec.MultibyteCodec.encode" "Return an encoded string version of 'input'.\n\n'errors' may be given to set a different error handling scheme.\nDefault is 'strict' meaning that encoding errors raise\na UnicodeEncodeError.  Other possible values are 'ignore', 'replace'\nand 'xmlcharrefreplace' as well as any other name registered with\ncodecs.register_error that can handle UnicodeEncodeErrors."]
    ^{:go/apos {0 [1276 2] 1 [1276 65]} :go/pos {:colon [1276 60]}} ["meth:_multibytecodec.MultibyteIncrementalDecoder.__new__" "Create and return a new object.  See help(type) for accurate signature."]

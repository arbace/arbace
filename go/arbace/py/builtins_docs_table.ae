    ^{:go/apos {0 [1314 2] 1 [1314 65]} :go/pos {:colon [1314 32]}} ["meth:_random.Random.getstate" "getstate() -> tuple containing the current state."]
    ^{:go/apos {0 [1315 2] 1 [1315 65]} :go/pos {:colon [1315 30]}} ["meth:_random.Random.random" "random() -> x in the interval [0, 1)."]
    ^{:go/apos {0 [1316 2] 1 [1316 65]} :go/pos {:colon [1316 28]}} ["meth:_random.Random.seed" "seed([n]) -> None.\n\nDefaults to use urandom and falls back to a combination\nof the current time and the process identifier."]
    ^{:go/apos {0 [1317 2] 1 [1317 65]} :go/pos {:colon [1317 32]}} ["meth:_random.Random.setstate" "setstate(state) -> None.  Restores generator state."]

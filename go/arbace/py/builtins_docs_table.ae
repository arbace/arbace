    ^{:go/apos {0 [1561 2] 1 [1561 65]} :go/pos {:colon [1561 38]}} ["meth:builtins.bytearray.__sizeof__" "Returns the size of the bytearray object in memory, in bytes."]
    ^{:go/apos {0 [1562 2] 1 [1562 65]} :go/pos {:colon [1562 34]}} ["meth:builtins.bytearray.append" "Append a single item to the end of the bytearray.\n\n  item\n    The item to be appended."]
    ^{:go/apos {0 [1563 2] 1 [1563 65]} :go/pos {:colon [1563 34]}} ["meth:builtins.bytearray.center" "Return a centered string of length width.\n\nPadding is done using the specified fill character."]
    ^{:go/apos {0 [1564 2] 1 [1564 65]} :go/pos {:colon [1564 33]}} ["meth:builtins.bytearray.clear" "Remove all items from the bytearray."]
    ^{:go/apos {0 [1565 2] 1 [1565 65]} :go/pos {:colon [1565 32]}} ["meth:builtins.bytearray.copy" "Return a copy of B."]
    ^{:go/apos {0 [1566 2] 1 [1566 65]} :go/pos {:colon [1566 33]}} ["meth:builtins.bytearray.count" "Return the number of non-overlapping occurrences of subsection 'sub' in bytes B[start:end].\n\n  start\n    Optional start position. Default: start of the bytes.\n  end\n    Optional stop position. Default: end of the bytes."]
    ^{:go/apos {0 [1567 2] 1 [1567 65]} :go/pos {:colon [1567 34]}} ["meth:builtins.bytearray.decode" "Decode the bytearray using the codec registered for encoding.\n\n  encoding\n    The encoding with which to decode the bytearray.\n  errors\n    The error handling scheme to use for the handling of decoding\n    errors.  The default is 'strict' meaning that decoding errors\n    raise a UnicodeDecodeError.  Other possible values are 'ignore'\n    and 'replace' as well as any other name registered with\n    codecs.register_error that can handle UnicodeDecodeErrors."]
    ^{:go/apos {0 [1568 2] 1 [1568 65]} :go/pos {:colon [1568 36]}} ["meth:builtins.bytearray.endswith" "Return True if the bytearray ends with the specified suffix, False otherwise.\n\n  suffix\n    A bytes or a tuple of bytes to try.\n  start\n    Optional start position. Default: start of the bytearray.\n  end\n    Optional stop position. Default: end of the bytearray."]
    ^{:go/apos {0 [1569 2] 1 [1569 65]} :go/pos {:colon [1569 38]}} ["meth:builtins.bytearray.expandtabs" "Return a copy where all tab characters are expanded using spaces.\n\nIf tabsize is not given, a tab size of 8 characters is assumed."]
    ^{:go/apos {0 [1570 2] 1 [1570 65]} :go/pos {:colon [1570 34]}} ["meth:builtins.bytearray.extend" "Append all the items from the iterator or sequence to the end of the bytearray.\n\n  iterable_of_ints\n    The iterable of items to append."]
    ^{:go/apos {0 [1571 2] 1 [1571 65]} :go/pos {:colon [1571 32]}} ["meth:builtins.bytearray.find" "Return the lowest index in B where subsection 'sub' is found, such that 'sub' is contained within B[start:end].\n\n  start\n    Optional start position. Default: start of the bytes.\n  end\n    Optional stop position. Default: end of the bytes.\n\nReturn -1 on failure."]
    ^{:go/apos {0 [1572 2] 1 [1572 65]} :go/pos {:colon [1572 35]}} ["meth:builtins.bytearray.fromhex" "Create a bytearray object from a string of hexadecimal numbers.\n\nSpaces between two numbers are accepted.\nExample:\n    bytearray.fromhex('B9 01EF') -> bytearray(b'\\\\xb9\\\\x01\\\\xef')"]
    ^{:go/apos {0 [1573 2] 1 [1573 65]} :go/pos {:colon [1573 31]}} ["meth:builtins.bytearray.hex" "Create a string of hexadecimal numbers from a bytearray object.\n\n  sep\n    An optional single character or byte to separate hex bytes.\n  bytes_per_sep\n    How many bytes between separators.  Positive values count from\n    the right, negative values count from the left.\n\nExample:\n>>> value = bytearray([0xb9, 0x01, 0xef])\n>>> value.hex()\n'b901ef'\n>>> value.hex(':')\n'b9:01:ef'\n>>> value.hex(':', 2)\n'b9:01ef'\n>>> value.hex(':', -2)\n'b901:ef'"]
    ^{:go/apos {0 [1574 2] 1 [1574 65]} :go/pos {:colon [1574 33]}} ["meth:builtins.bytearray.index" "Return the lowest index in B where subsection 'sub' is found, such that 'sub' is contained within B[start:end].\n\n  start\n    Optional start position. Default: start of the bytes.\n  end\n    Optional stop position. Default: end of the bytes.\n\nRaise ValueError if the subsection is not found."]
    ^{:go/apos {0 [1575 2] 1 [1575 65]} :go/pos {:colon [1575 34]}} ["meth:builtins.bytearray.insert" "Insert a single item into the bytearray before the given index.\n\n  index\n    The index where the value is to be inserted.\n  item\n    The item to be inserted."]
    ^{:go/apos {0 [1576 2] 1 [1576 65]} :go/pos {:colon [1576 32]}} ["meth:builtins.bytearray.join" "Concatenate any number of bytes/bytearray objects.\n\nThe bytearray whose method is called is inserted in between each\npair.\n\nThe result is returned as a new bytearray object."]
    ^{:go/apos {0 [1577 2] 1 [1577 65]} :go/pos {:colon [1577 33]}} ["meth:builtins.bytearray.ljust" "Return a left-justified string of length width.\n\nPadding is done using the specified fill character."]
    ^{:go/apos {0 [1578 2] 1 [1578 65]} :go/pos {:colon [1578 34]}} ["meth:builtins.bytearray.lstrip" "Strip leading bytes contained in the argument.\n\nIf the argument is omitted or None, strip leading ASCII whitespace."]
    ^{:go/apos {0 [1579 2] 1 [1579 65]} :go/pos {:colon [1579 37]}} ["meth:builtins.bytearray.maketrans" "Return a translation table usable for the bytes or bytearray translate method.\n\nThe returned table will be one where each byte in frm is mapped to\nthe byte at the same position in to.\n\nThe bytes objects frm and to must be of the same length."]
    ^{:go/apos {0 [1580 2] 1 [1580 65]} :go/pos {:colon [1580 37]}} ["meth:builtins.bytearray.partition" "Partition the bytearray into three parts using the given separator.\n\nThis will search for the separator sep in the bytearray.  If the\nseparator is found, returns a 3-tuple containing the part before the\nseparator, the separator itself, and the part after it as new\nbytearray objects.\n\nIf the separator is not found, returns a 3-tuple containing the copy\nof the original bytearray object and two empty bytearray objects."]
    ^{:go/apos {0 [1581 2] 1 [1581 65]} :go/pos {:colon [1581 31]}} ["meth:builtins.bytearray.pop" "Remove and return a single item from B.\n\n  index\n    The index from where to remove the item.\n    -1 (the default value) means remove the last item.\n\nIf no index argument is given, will pop the last item."]
    ^{:go/apos {0 [1582 2] 1 [1582 65]} :go/pos {:colon [1582 34]}} ["meth:builtins.bytearray.remove" "Remove the first occurrence of a value in the bytearray.\n\n  value\n    The value to remove."]
    ^{:go/apos {0 [1583 2] 1 [1583 65]} :go/pos {:colon [1583 40]}} ["meth:builtins.bytearray.removeprefix" "Return a bytearray with the given prefix string removed if present.\n\nIf the bytearray starts with the prefix string, return\nbytearray[len(prefix):].  Otherwise, return a copy of the original\nbytearray."]
    ^{:go/apos {0 [1584 2] 1 [1584 65]} :go/pos {:colon [1584 40]}} ["meth:builtins.bytearray.removesuffix" "Return a bytearray with the given suffix string removed if present.\n\nIf the bytearray ends with the suffix string and that suffix is not\nempty, return bytearray[:-len(suffix)].  Otherwise, return a copy of\nthe original bytearray."]
    ^{:go/apos {0 [1585 2] 1 [1585 65]} :go/pos {:colon [1585 35]}} ["meth:builtins.bytearray.replace" "Return a copy with all occurrences of substring old replaced by new.\n\n  count\n    Maximum number of occurrences to replace.\n    -1 (the default value) means replace all occurrences.\n\nIf the optional argument count is given, only the first count occurrences are\nreplaced."]
    ^{:go/apos {0 [1586 2] 1 [1586 65]} :go/pos {:colon [1586 34]}} ["meth:builtins.bytearray.resize" "Resize the internal buffer of bytearray to len.\n\n  size\n    New size to resize to."]
    ^{:go/apos {0 [1587 2] 1 [1587 65]} :go/pos {:colon [1587 35]}} ["meth:builtins.bytearray.reverse" "Reverse the order of the values in B in place."]
    ^{:go/apos {0 [1588 2] 1 [1588 65]} :go/pos {:colon [1588 33]}} ["meth:builtins.bytearray.rfind" "Return the highest index in B where subsection 'sub' is found, such that 'sub' is contained within B[start:end].\n\n  start\n    Optional start position. Default: start of the bytes.\n  end\n    Optional stop position. Default: end of the bytes.\n\nReturn -1 on failure."]
    ^{:go/apos {0 [1589 2] 1 [1589 65]} :go/pos {:colon [1589 34]}} ["meth:builtins.bytearray.rindex" "Return the highest index in B where subsection 'sub' is found, such that 'sub' is contained within B[start:end].\n\n  start\n    Optional start position. Default: start of the bytes.\n  end\n    Optional stop position. Default: end of the bytes.\n\nRaise ValueError if the subsection is not found."]
    ^{:go/apos {0 [1590 2] 1 [1590 65]} :go/pos {:colon [1590 33]}} ["meth:builtins.bytearray.rjust" "Return a right-justified string of length width.\n\nPadding is done using the specified fill character."]
    ^{:go/apos {0 [1591 2] 1 [1591 65]} :go/pos {:colon [1591 38]}} ["meth:builtins.bytearray.rpartition" "Partition the bytearray into three parts using the given separator.\n\nThis will search for the separator sep in the bytearray, starting at\nthe end.  If the separator is found, returns a 3-tuple containing\nthe part before the separator, the separator itself, and the part\nafter it as new bytearray objects.\n\nIf the separator is not found, returns a 3-tuple containing two\nempty bytearray objects and the copy of the original bytearray\nobject."]
    ^{:go/apos {0 [1592 2] 1 [1592 65]} :go/pos {:colon [1592 34]}} ["meth:builtins.bytearray.rsplit" "Return a list of the sections in the bytearray, using sep as the delimiter.\n\n  sep\n    The delimiter according which to split the bytearray.\n    None (the default value) means split on ASCII whitespace\n    characters (space, tab, return, newline, formfeed, vertical tab).\n  maxsplit\n    Maximum number of splits to do.\n    -1 (the default value) means no limit.\n\nSplitting is done starting at the end of the bytearray and working\nto the front."]
    ^{:go/apos {0 [1593 2] 1 [1593 65]} :go/pos {:colon [1593 34]}} ["meth:builtins.bytearray.rstrip" "Strip trailing bytes contained in the argument.\n\nIf the argument is omitted or None, strip trailing ASCII whitespace."]
    ^{:go/apos {0 [1594 2] 1 [1594 65]} :go/pos {:colon [1594 33]}} ["meth:builtins.bytearray.split" "Return a list of the sections in the bytearray, using sep as the delimiter.\n\n  sep\n    The delimiter according which to split the bytearray.\n    None (the default value) means split on ASCII whitespace\n    characters (space, tab, return, newline, formfeed, vertical tab).\n  maxsplit\n    Maximum number of splits to do.\n    -1 (the default value) means no limit."]
    ^{:go/apos {0 [1595 2] 1 [1595 65]} :go/pos {:colon [1595 38]}} ["meth:builtins.bytearray.splitlines" "Return a list of the lines in the bytearray, breaking at line boundaries.\n\nLine breaks are not included in the resulting list unless keepends\nis given and true."]
    ^{:go/apos {0 [1596 2] 1 [1596 65]} :go/pos {:colon [1596 38]}} ["meth:builtins.bytearray.startswith" "Return True if the bytearray starts with the specified prefix, False otherwise.\n\n  prefix\n    A bytes or a tuple of bytes to try.\n  start\n    Optional start position. Default: start of the bytearray.\n  end\n    Optional stop position. Default: end of the bytearray."]
    ^{:go/apos {0 [1597 2] 1 [1597 65]} :go/pos {:colon [1597 33]}} ["meth:builtins.bytearray.strip" "Strip leading and trailing bytes contained in the argument.\n\nIf the argument is omitted or None, strip leading and trailing ASCII\nwhitespace."]
    ^{:go/apos {0 [1598 2] 1 [1598 65]} :go/pos {:colon [1598 37]}} ["meth:builtins.bytearray.translate" "Return a copy with each character mapped by the given translation table.\n\n  table\n    Translation table, which must be a bytes object of length 256.\n\nAll characters occurring in the optional argument delete are\nremoved.  The remaining characters are mapped through the given\ntranslation table."]
    ^{:go/apos {0 [1599 2] 1 [1599 65]} :go/pos {:colon [1599 33]}} ["meth:builtins.bytearray.zfill" "Pad a numeric string with zeros on the left, to fill a field of the given width.\n\nThe original string is never truncated."]
    ^{:go/apos {0 [1600 2] 1 [1600 65]} :go/pos {:colon [1600 52]}} ["meth:builtins.bytearray_iterator.__length_hint__" "Private method returning an estimate of len(list(it))."]
    ^{:go/apos {0 [1601 2] 1 [1601 65]} :go/pos {:colon [1601 47]}} ["meth:builtins.bytearray_iterator.__reduce__" "Return state information for pickling."]
    ^{:go/apos {0 [1602 2] 1 [1602 65]} :go/pos {:colon [1602 49]}} ["meth:builtins.bytearray_iterator.__setstate__" "Set state information for unpickling."]
    ^{:go/apos {0 [1603 2] 1 [1603 65]} :go/pos {:colon [1603 33]}} ["meth:builtins.bytes.__bytes__" "Convert this value to exact type bytes."]
    ^{:go/apos {0 [1604 2] 1 [1604 65]} :go/pos {:colon [1604 31]}} ["meth:builtins.bytes.__new__" "Create and return a new object.  See help(type) for accurate signature."]
    ^{:go/apos {0 [1605 2] 1 [1605 65]} :go/pos {:colon [1605 30]}} ["meth:builtins.bytes.center" "Return a centered string of length width.\n\nPadding is done using the specified fill character."]
    ^{:go/apos {0 [1606 2] 1 [1606 65]} :go/pos {:colon [1606 29]}} ["meth:builtins.bytes.count" "Return the number of non-overlapping occurrences of subsection 'sub' in bytes B[start:end].\n\n  start\n    Optional start position. Default: start of the bytes.\n  end\n    Optional stop position. Default: end of the bytes."]
    ^{:go/apos {0 [1607 2] 1 [1607 65]} :go/pos {:colon [1607 30]}} ["meth:builtins.bytes.decode" "Decode the bytes using the codec registered for encoding.\n\n  encoding\n    The encoding with which to decode the bytes.\n  errors\n    The error handling scheme to use for the handling of decoding\n    errors.  The default is 'strict' meaning that decoding errors\n    raise a UnicodeDecodeError.  Other possible values are 'ignore'\n    and 'replace' as well as any other name registered with\n    codecs.register_error that can handle UnicodeDecodeErrors."]
    ^{:go/apos {0 [1608 2] 1 [1608 65]} :go/pos {:colon [1608 32]}} ["meth:builtins.bytes.endswith" "Return True if the bytes ends with the specified suffix, False otherwise.\n\n  suffix\n    A bytes or a tuple of bytes to try.\n  start\n    Optional start position. Default: start of the bytes.\n  end\n    Optional stop position. Default: end of the bytes."]
    ^{:go/apos {0 [1609 2] 1 [1609 65]} :go/pos {:colon [1609 34]}} ["meth:builtins.bytes.expandtabs" "Return a copy where all tab characters are expanded using spaces.\n\nIf tabsize is not given, a tab size of 8 characters is assumed."]
    ^{:go/apos {0 [1610 2] 1 [1610 65]} :go/pos {:colon [1610 28]}} ["meth:builtins.bytes.find" "Return the lowest index in B where subsection 'sub' is found, such that 'sub' is contained within B[start,end].\n\n  start\n    Optional start position. Default: start of the bytes.\n  end\n    Optional stop position. Default: end of the bytes.\n\nReturn -1 on failure."]
    ^{:go/apos {0 [1611 2] 1 [1611 65]} :go/pos {:colon [1611 31]}} ["meth:builtins.bytes.fromhex" "Create a bytes object from a string of hexadecimal numbers.\n\nSpaces between two numbers are accepted.\nExample: bytes.fromhex('B9 01EF') -> b'\\\\xb9\\\\x01\\\\xef'."]
    ^{:go/apos {0 [1612 2] 1 [1612 65]} :go/pos {:colon [1612 27]}} ["meth:builtins.bytes.hex" "Create a string of hexadecimal numbers from a bytes object.\n\n  sep\n    An optional single character or byte to separate hex bytes.\n  bytes_per_sep\n    How many bytes between separators.  Positive values count from\n    the right, negative values count from the left.\n\nExample:\n>>> value = b'\\xb9\\x01\\xef'\n>>> value.hex()\n'b901ef'\n>>> value.hex(':')\n'b9:01:ef'\n>>> value.hex(':', 2)\n'b9:01ef'\n>>> value.hex(':', -2)\n'b901:ef'"]
    ^{:go/apos {0 [1613 2] 1 [1613 65]} :go/pos {:colon [1613 29]}} ["meth:builtins.bytes.index" "Return the lowest index in B where subsection 'sub' is found, such that 'sub' is contained within B[start,end].\n\n  start\n    Optional start position. Default: start of the bytes.\n  end\n    Optional stop position. Default: end of the bytes.\n\nRaise ValueError if the subsection is not found."]
    ^{:go/apos {0 [1614 2] 1 [1614 65]} :go/pos {:colon [1614 28]}} ["meth:builtins.bytes.join" "Concatenate any number of bytes objects.\n\nThe bytes whose method is called is inserted in between each pair.\n\nThe result is returned as a new bytes object.\n\nExample: b'.'.join([b'ab', b'pq', b'rs']) -> b'ab.pq.rs'."]
    ^{:go/apos {0 [1615 2] 1 [1615 65]} :go/pos {:colon [1615 29]}} ["meth:builtins.bytes.ljust" "Return a left-justified string of length width.\n\nPadding is done using the specified fill character."]
    ^{:go/apos {0 [1616 2] 1 [1616 65]} :go/pos {:colon [1616 30]}} ["meth:builtins.bytes.lstrip" "Strip leading bytes contained in the argument.\n\nIf the argument is omitted or None, strip leading  ASCII whitespace."]
    ^{:go/apos {0 [1617 2] 1 [1617 65]} :go/pos {:colon [1617 33]}} ["meth:builtins.bytes.maketrans" "Return a translation table usable for the bytes or bytearray translate method.\n\nThe returned table will be one where each byte in frm is mapped to\nthe byte at the same position in to.\n\nThe bytes objects frm and to must be of the same length."]
    ^{:go/apos {0 [1618 2] 1 [1618 65]} :go/pos {:colon [1618 33]}} ["meth:builtins.bytes.partition" "Partition the bytes into three parts using the given separator.\n\nThis will search for the separator sep in the bytes.  If the\nseparator is found, returns a 3-tuple containing the part before the\nseparator, the separator itself, and the part after it.\n\nIf the separator is not found, returns a 3-tuple containing the\noriginal bytes object and two empty bytes objects."]
    ^{:go/apos {0 [1619 2] 1 [1619 65]} :go/pos {:colon [1619 36]}} ["meth:builtins.bytes.removeprefix" "Return a bytes object with the given prefix string removed if present.\n\nIf the bytes starts with the prefix string, return\nbytes[len(prefix):].  Otherwise, return a copy of the original\nbytes."]
    ^{:go/apos {0 [1620 2] 1 [1620 65]} :go/pos {:colon [1620 36]}} ["meth:builtins.bytes.removesuffix" "Return a bytes object with the given suffix string removed if present.\n\nIf the bytes ends with the suffix string and that suffix is not\nempty, return bytes[:-len(prefix)].  Otherwise, return a copy of the\noriginal bytes."]
    ^{:go/apos {0 [1621 2] 1 [1621 65]} :go/pos {:colon [1621 31]}} ["meth:builtins.bytes.replace" "Return a copy with all occurrences of substring old replaced by new.\n\n  count\n    Maximum number of occurrences to replace.\n    -1 (the default value) means replace all occurrences.\n\nIf the optional argument count is given, only the first count occurrences are\nreplaced."]
    ^{:go/apos {0 [1622 2] 1 [1622 65]} :go/pos {:colon [1622 29]}} ["meth:builtins.bytes.rfind" "Return the highest index in B where subsection 'sub' is found, such that 'sub' is contained within B[start,end].\n\n  start\n    Optional start position. Default: start of the bytes.\n  end\n    Optional stop position. Default: end of the bytes.\n\nReturn -1 on failure."]
    ^{:go/apos {0 [1623 2] 1 [1623 65]} :go/pos {:colon [1623 30]}} ["meth:builtins.bytes.rindex" "Return the highest index in B where subsection 'sub' is found, such that 'sub' is contained within B[start,end].\n\n  start\n    Optional start position. Default: start of the bytes.\n  end\n    Optional stop position. Default: end of the bytes.\n\nRaise ValueError if the subsection is not found."]
    ^{:go/apos {0 [1624 2] 1 [1624 65]} :go/pos {:colon [1624 29]}} ["meth:builtins.bytes.rjust" "Return a right-justified string of length width.\n\nPadding is done using the specified fill character."]
    ^{:go/apos {0 [1625 2] 1 [1625 65]} :go/pos {:colon [1625 34]}} ["meth:builtins.bytes.rpartition" "Partition the bytes into three parts using the given separator.\n\nThis will search for the separator sep in the bytes, starting at the\nend.  If the separator is found, returns a 3-tuple containing the\npart before the separator, the separator itself, and the part after\nit.\n\nIf the separator is not found, returns a 3-tuple containing two\nempty bytes objects and the original bytes object."]
    ^{:go/apos {0 [1626 2] 1 [1626 65]} :go/pos {:colon [1626 30]}} ["meth:builtins.bytes.rsplit" "Return a list of the sections in the bytes, using sep as the delimiter.\n\n  sep\n    The delimiter according which to split the bytes.\n    None (the default value) means split on ASCII whitespace\n    characters (space, tab, return, newline, formfeed, vertical tab).\n  maxsplit\n    Maximum number of splits to do.\n    -1 (the default value) means no limit.\n\nSplitting is done starting at the end of the bytes and working to\nthe front."]
    ^{:go/apos {0 [1627 2] 1 [1627 65]} :go/pos {:colon [1627 30]}} ["meth:builtins.bytes.rstrip" "Strip trailing bytes contained in the argument.\n\nIf the argument is omitted or None, strip trailing ASCII whitespace."]
    ^{:go/apos {0 [1628 2] 1 [1628 65]} :go/pos {:colon [1628 29]}} ["meth:builtins.bytes.split" "Return a list of the sections in the bytes, using sep as the delimiter.\n\n  sep\n    The delimiter according which to split the bytes.\n    None (the default value) means split on ASCII whitespace\n    characters (space, tab, return, newline, formfeed, vertical tab).\n  maxsplit\n    Maximum number of splits to do.\n    -1 (the default value) means no limit."]
    ^{:go/apos {0 [1629 2] 1 [1629 65]} :go/pos {:colon [1629 34]}} ["meth:builtins.bytes.splitlines" "Return a list of the lines in the bytes, breaking at line boundaries.\n\nLine breaks are not included in the resulting list unless keepends\nis given and true."]
    ^{:go/apos {0 [1630 2] 1 [1630 65]} :go/pos {:colon [1630 34]}} ["meth:builtins.bytes.startswith" "Return True if the bytes starts with the specified prefix, False otherwise.\n\n  prefix\n    A bytes or a tuple of bytes to try.\n  start\n    Optional start position. Default: start of the bytes.\n  end\n    Optional stop position. Default: end of the bytes."]
    ^{:go/apos {0 [1631 2] 1 [1631 65]} :go/pos {:colon [1631 29]}} ["meth:builtins.bytes.strip" "Strip leading and trailing bytes contained in the argument.\n\nIf the argument is omitted or None, strip leading and trailing ASCII\nwhitespace."]
    ^{:go/apos {0 [1632 2] 1 [1632 65]} :go/pos {:colon [1632 33]}} ["meth:builtins.bytes.translate" "Return a copy with each character mapped by the given translation table.\n\n  table\n    Translation table, which must be a bytes object of length 256.\n\nAll characters occurring in the optional argument delete are\nremoved.  The remaining characters are mapped through the given\ntranslation table."]
    ^{:go/apos {0 [1633 2] 1 [1633 65]} :go/pos {:colon [1633 29]}} ["meth:builtins.bytes.zfill" "Pad a numeric string with zeros on the left, to fill a field of the given width.\n\nThe original string is never truncated."]

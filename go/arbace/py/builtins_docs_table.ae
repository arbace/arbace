    ^{:go/apos {0 [1283 2] 1 [1283 65]} :go/pos {:colon [1283 45]}} ["meth:_multiprocessing.SemLock._after_fork" "Rezero the net acquisition count after fork()."]
    ^{:go/apos {0 [1284 2] 1 [1284 65]} :go/pos {:colon [1284 40]}} ["meth:_multiprocessing.SemLock._count" "Num of `acquire()`s minus num of `release()`s for this process."]
    ^{:go/apos {0 [1285 2] 1 [1285 65]} :go/pos {:colon [1285 44]}} ["meth:_multiprocessing.SemLock._get_value" "Get the value of the semaphore."]
    ^{:go/apos {0 [1286 2] 1 [1286 65]} :go/pos {:colon [1286 42]}} ["meth:_multiprocessing.SemLock._is_mine" "Whether the lock is owned by this thread."]

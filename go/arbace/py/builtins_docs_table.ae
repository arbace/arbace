    ^{:go/apos {0 [290 2] 1 [290 65]} :go/pos {:colon [290 26]}} ["func:_operator.iconcat" "Same as a += b, for a and b sequences."]
    ^{:go/apos {0 [291 2] 1 [291 65]} :go/pos {:colon [291 28]}} ["func:_operator.ifloordiv" "Same as a //= b."]
    ^{:go/apos {0 [292 2] 1 [292 65]} :go/pos {:colon [292 26]}} ["func:_operator.ilshift" "Same as a <<= b."]
    ^{:go/apos {0 [293 2] 1 [293 65]} :go/pos {:colon [293 26]}} ["func:_operator.imatmul" "Same as a @= b."]
    ^{:go/apos {0 [294 2] 1 [294 65]} :go/pos {:colon [294 23]}} ["func:_operator.imod" "Same as a %= b."]
    ^{:go/apos {0 [295 2] 1 [295 65]} :go/pos {:colon [295 23]}} ["func:_operator.imul" "Same as a *= b."]
    ^{:go/apos {0 [296 2] 1 [296 65]} :go/pos {:colon [296 24]}} ["func:_operator.index" "Same as a.__index__()"]
    ^{:go/apos {0 [297 2] 1 [297 65]} :go/pos {:colon [297 26]}} ["func:_operator.indexOf" "Return the first index of b in a."]
    ^{:go/apos {0 [298 2] 1 [298 65]} :go/pos {:colon [298 22]}} ["func:_operator.inv" "Same as ~a."]
    ^{:go/apos {0 [299 2] 1 [299 65]} :go/pos {:colon [299 25]}} ["func:_operator.invert" "Same as ~a."]
    ^{:go/apos {0 [300 2] 1 [300 65]} :go/pos {:colon [300 22]}} ["func:_operator.ior" "Same as a |= b."]
    ^{:go/apos {0 [301 2] 1 [301 65]} :go/pos {:colon [301 23]}} ["func:_operator.ipow" "Same as a **= b."]
    ^{:go/apos {0 [302 2] 1 [302 65]} :go/pos {:colon [302 26]}} ["func:_operator.irshift" "Same as a >>= b."]
    ^{:go/apos {0 [303 2] 1 [303 65]} :go/pos {:colon [303 22]}} ["func:_operator.is_" "Same as a is b."]
    ^{:go/apos {0 [304 2] 1 [304 65]} :go/pos {:colon [304 26]}} ["func:_operator.is_none" "Same as a is None."]
    ^{:go/apos {0 [305 2] 1 [305 65]} :go/pos {:colon [305 25]}} ["func:_operator.is_not" "Same as a is not b."]
    ^{:go/apos {0 [306 2] 1 [306 65]} :go/pos {:colon [306 30]}} ["func:_operator.is_not_none" "Same as a is not None."]
    ^{:go/apos {0 [307 2] 1 [307 65]} :go/pos {:colon [307 23]}} ["func:_operator.isub" "Same as a -= b."]
    ^{:go/apos {0 [308 2] 1 [308 65]} :go/pos {:colon [308 27]}} ["func:_operator.itruediv" "Same as a /= b."]
    ^{:go/apos {0 [309 2] 1 [309 65]} :go/pos {:colon [309 23]}} ["func:_operator.ixor" "Same as a ^= b."]
    ^{:go/apos {0 [310 2] 1 [310 65]} :go/pos {:colon [310 21]}} ["func:_operator.le" "Same as a <= b."]
    ^{:go/apos {0 [311 2] 1 [311 65]} :go/pos {:colon [311 30]}} ["func:_operator.length_hint" "Return an estimate of the number of items in obj.\n\nThis is useful for presizing containers when building from an iterable.\n\nIf the object supports len(), the result will be exact.\nOtherwise, it may over- or under-estimate by an arbitrary amount.\nThe result will be an integer >= 0."]
    ^{:go/apos {0 [312 2] 1 [312 65]} :go/pos {:colon [312 25]}} ["func:_operator.lshift" "Same as a << b."]
    ^{:go/apos {0 [313 2] 1 [313 65]} :go/pos {:colon [313 21]}} ["func:_operator.lt" "Same as a < b."]
    ^{:go/apos {0 [314 2] 1 [314 65]} :go/pos {:colon [314 25]}} ["func:_operator.matmul" "Same as a @ b."]
    ^{:go/apos {0 [315 2] 1 [315 65]} :go/pos {:colon [315 22]}} ["func:_operator.mod" "Same as a % b."]
    ^{:go/apos {0 [316 2] 1 [316 65]} :go/pos {:colon [316 22]}} ["func:_operator.mul" "Same as a * b."]
    ^{:go/apos {0 [317 2] 1 [317 65]} :go/pos {:colon [317 21]}} ["func:_operator.ne" "Same as a != b."]
    ^{:go/apos {0 [318 2] 1 [318 65]} :go/pos {:colon [318 22]}} ["func:_operator.neg" "Same as -a."]
    ^{:go/apos {0 [319 2] 1 [319 65]} :go/pos {:colon [319 23]}} ["func:_operator.not_" "Same as not a."]
    ^{:go/apos {0 [320 2] 1 [320 65]} :go/pos {:colon [320 22]}} ["func:_operator.or_" "Same as a | b."]
    ^{:go/apos {0 [321 2] 1 [321 65]} :go/pos {:colon [321 22]}} ["func:_operator.pos" "Same as +a."]
    ^{:go/apos {0 [322 2] 1 [322 65]} :go/pos {:colon [322 22]}} ["func:_operator.pow" "Same as a ** b."]
    ^{:go/apos {0 [323 2] 1 [323 65]} :go/pos {:colon [323 25]}} ["func:_operator.rshift" "Same as a >> b."]
    ^{:go/apos {0 [324 2] 1 [324 65]} :go/pos {:colon [324 26]}} ["func:_operator.setitem" "Same as a[b] = c."]
    ^{:go/apos {0 [325 2] 1 [325 65]} :go/pos {:colon [325 22]}} ["func:_operator.sub" "Same as a - b."]
    ^{:go/apos {0 [326 2] 1 [326 65]} :go/pos {:colon [326 26]}} ["func:_operator.truediv" "Same as a / b."]
    ^{:go/apos {0 [327 2] 1 [327 65]} :go/pos {:colon [327 24]}} ["func:_operator.truth" "Return True if a is true, False otherwise."]
    ^{:go/apos {0 [328 2] 1 [328 65]} :go/pos {:colon [328 22]}} ["func:_operator.xor" "Same as a ^ b."]
    ^{:go/apos {0 [329 2] 1 [329 65]} :go/pos {:colon [329 21]}} ["func:_pickle.dump" "Write a pickled representation of obj to the open file object file.\n\nThis is equivalent to ``Pickler(file, protocol).dump(obj)``, but may\nbe more efficient.\n\nThe optional *protocol* argument tells the pickler to use the given\nprotocol; supported protocols are 0, 1, 2, 3, 4 and 5.  The default\nprotocol is 5. It was introduced in Python 3.8, and is incompatible\nwith previous versions.\n\nSpecifying a negative protocol version selects the highest protocol\nversion supported.  The higher the protocol used, the more recent the\nversion of Python needed to read the pickle produced.\n\nThe *file* argument must have a write() method that accepts a single\nbytes argument.  It can thus be a file object opened for binary\nwriting, an io.BytesIO instance, or any other custom object that meets\nthis interface.\n\nIf *fix_imports* is True and protocol is less than 3, pickle will try\nto map the new Python 3 names to the old module names used in Python\n2, so that the pickle data stream is readable with Python 2.\n\nIf *buffer_callback* is None (the default), buffer views are serialized\ninto *file* as part of the pickle stream.  It is an error if\n*buffer_callback* is not None and *protocol* is None or smaller than 5."]
    ^{:go/apos {0 [330 2] 1 [330 65]} :go/pos {:colon [330 22]}} ["func:_pickle.dumps" "Return the pickled representation of the object as a bytes object.\n\nThe optional *protocol* argument tells the pickler to use the given\nprotocol; supported protocols are 0, 1, 2, 3, 4 and 5.  The default\nprotocol is 5. It was introduced in Python 3.8, and is incompatible\nwith previous versions.\n\nSpecifying a negative protocol version selects the highest protocol\nversion supported.  The higher the protocol used, the more recent the\nversion of Python needed to read the pickle produced.\n\nIf *fix_imports* is True and *protocol* is less than 3, pickle will\ntry to map the new Python 3 names to the old module names used in\nPython 2, so that the pickle data stream is readable with Python 2.\n\nIf *buffer_callback* is None (the default), buffer views are serialized\ninto *file* as part of the pickle stream.  It is an error if\n*buffer_callback* is not None and *protocol* is None or smaller than 5."]
    ^{:go/apos {0 [331 2] 1 [331 65]} :go/pos {:colon [331 21]}} ["func:_pickle.load" "Read and return an object from the pickle data stored in a file.\n\nThis is equivalent to ``Unpickler(file).load()``, but may be more\nefficient.\n\nThe protocol version of the pickle is detected automatically, so no\nprotocol argument is needed.  Bytes past the pickled object's\nrepresentation are ignored.\n\nThe argument *file* must have two methods, a read() method that takes\nan integer argument, and a readline() method that requires no\narguments.  Both methods should return bytes.  Thus *file* can be a\nbinary file object opened for reading, an io.BytesIO object, or any\nother custom object that meets this interface.\n\nOptional keyword arguments are *fix_imports*, *encoding* and *errors*,\nwhich are used to control compatibility support for pickle stream\ngenerated by Python 2.  If *fix_imports* is True, pickle will try to\nmap the old Python 2 names to the new names used in Python 3.  The\n*encoding* and *errors* tell pickle how to decode 8-bit string\ninstances pickled by Python 2; these default to 'ASCII' and 'strict',\nrespectively.  The *encoding* can be 'bytes' to read these 8-bit\nstring instances as bytes objects."]
    ^{:go/apos {0 [332 2] 1 [332 65]} :go/pos {:colon [332 22]}} ["func:_pickle.loads" "Read and return an object from the given pickle data.\n\nThe protocol version of the pickle is detected automatically, so no\nprotocol argument is needed.  Bytes past the pickled object's\nrepresentation are ignored.\n\nOptional keyword arguments are *fix_imports*, *encoding* and *errors*,\nwhich are used to control compatibility support for pickle stream\ngenerated by Python 2.  If *fix_imports* is True, pickle will try to\nmap the old Python 2 names to the new names used in Python 3.  The\n*encoding* and *errors* tell pickle how to decode 8-bit string\ninstances pickled by Python 2; these default to 'ASCII' and 'strict',\nrespectively.  The *encoding* can be 'bytes' to read these 8-bit\nstring instances as bytes objects."]
    ^{:go/apos {0 [333 2] 1 [333 65]} :go/pos {:colon [333 29]}} ["func:_posixshmem.shm_open" "Open a shared memory object.  Returns a file descriptor (integer)."]
    ^{:go/apos {0 [334 2] 1 [334 65]} :go/pos {:colon [334 31]}} ["func:_posixshmem.shm_unlink" "Remove a shared memory object (similar to unlink()).\n\nRemove a shared memory object name, and, once all processes have\nunmapped the object, de-allocates and destroys the contents of the\nassociated memory region."]
    ^{:go/apos {0 [335 2] 1 [335 65]} :go/pos {:colon [335 35]}} ["func:_posixsubprocess.fork_exec" "Spawn a fresh new child process.\n\nFork a child process, close parent file descriptors as appropriate in\nthe child and duplicate the few that are needed before calling exec() in\nthe child process.\n\nIf close_fds is True, close file descriptors 3 and higher, except those\nlisted in the sorted tuple pass_fds.\n\nThe preexec_fn, if supplied, will be called immediately before closing\nfile descriptors and exec.\n\nWARNING: preexec_fn is NOT SAFE if your application uses threads.\n         It may trigger infrequent, difficult to debug deadlocks.\n\nIf an error occurs in the child process before the exec, it is\nserialized and written to the errpipe_write fd per subprocess.py.\n\nReturns: the child process's PID.\n\nRaises: Only on an error in the parent process."]
    ^{:go/apos {0 [336 2] 1 [336 65]} :go/pos {:colon [336 19]}} ["func:_sha1.sha1" "Return a new SHA1 hash object; optionally initialized with a string."]
    ^{:go/apos {0 [337 2] 1 [337 65]} :go/pos {:colon [337 21]}} ["func:_sha2.sha224" "Return a new SHA-224 hash object; optionally initialized with a string."]
    ^{:go/apos {0 [338 2] 1 [338 65]} :go/pos {:colon [338 21]}} ["func:_sha2.sha256" "Return a new SHA-256 hash object; optionally initialized with a string."]
    ^{:go/apos {0 [339 2] 1 [339 65]} :go/pos {:colon [339 21]}} ["func:_sha2.sha384" "Return a new SHA-384 hash object; optionally initialized with a string."]
    ^{:go/apos {0 [340 2] 1 [340 65]} :go/pos {:colon [340 21]}} ["func:_sha2.sha512" "Return a new SHA-512 hash object; optionally initialized with a string."]
    ^{:go/apos {0 [341 2] 1 [341 65]} :go/pos {:colon [341 22]}} ["func:_signal.alarm" "Arrange for SIGALRM to arrive after the given number of seconds."]
    ^{:go/apos {0 [342 2] 1 [342 65]} :go/pos {:colon [342 36]}} ["func:_signal.default_int_handler" "The default handler for SIGINT installed by Python.\n\nIt raises KeyboardInterrupt."]
    ^{:go/apos {0 [343 2] 1 [343 65]} :go/pos {:colon [343 26]}} ["func:_signal.getitimer" "Returns current value of given itimer."]
    ^{:go/apos {0 [344 2] 1 [344 65]} :go/pos {:colon [344 26]}} ["func:_signal.getsignal" "Return the current action for the given signal.\n\nThe return value can be:\n  SIG_IGN -- if the signal is being ignored\n  SIG_DFL -- if the default action for the signal is in effect\n  None    -- if an unknown handler is in effect\n  anything else -- the callable Python object used as a handler"]
    ^{:go/apos {0 [345 2] 1 [345 65]} :go/pos {:colon [345 22]}} ["func:_signal.pause" "Wait until a signal arrives."]
    ^{:go/apos {0 [346 2] 1 [346 65]} :go/pos {:colon [346 34]}} ["func:_signal.pidfd_send_signal" "Send a signal to a process referred to by a pid file descriptor."]
    ^{:go/apos {0 [347 2] 1 [347 65]} :go/pos {:colon [347 29]}} ["func:_signal.pthread_kill" "Send a signal to a thread."]
    ^{:go/apos {0 [348 2] 1 [348 65]} :go/pos {:colon [348 32]}} ["func:_signal.pthread_sigmask" "Fetch and/or change the signal mask of the calling thread."]
    ^{:go/apos {0 [349 2] 1 [349 65]} :go/pos {:colon [349 29]}} ["func:_signal.raise_signal" "Send a signal to the executing process."]
    ^{:go/apos {0 [350 2] 1 [350 65]} :go/pos {:colon [350 30]}} ["func:_signal.set_wakeup_fd" "Sets the fd to be written to (with the signal number) when a signal comes in.\n\nA library can use this to wakeup select or poll.\nThe previous fd or -1 is returned.\n\nThe fd must be non-blocking."]
    ^{:go/apos {0 [351 2] 1 [351 65]} :go/pos {:colon [351 26]}} ["func:_signal.setitimer" "Sets given itimer (one of ITIMER_REAL, ITIMER_VIRTUAL or ITIMER_PROF).\n\nThe timer will fire after value seconds and after that every interval\nseconds.  The itimer can be cleared by setting seconds to zero.\n\nReturns old values as a tuple: (delay, interval)."]
    ^{:go/apos {0 [352 2] 1 [352 65]} :go/pos {:colon [352 29]}} ["func:_signal.siginterrupt" "Change system call restart behaviour.\n\nIf flag is False, system calls will be restarted when interrupted by\nsignal sig, else system calls will be interrupted."]
    ^{:go/apos {0 [353 2] 1 [353 65]} :go/pos {:colon [353 23]}} ["func:_signal.signal" "Set the action for the given signal.\n\nThe action can be SIG_DFL, SIG_IGN, or a callable Python object.\nThe previous action is returned.  See getsignal() for possible return\nvalues.\n\n*** IMPORTANT NOTICE ***\nA signal handler function is called with two arguments: the first is\nthe signal number, the second is the interrupted stack frame."]
    ^{:go/apos {0 [354 2] 1 [354 65]} :go/pos {:colon [354 27]}} ["func:_signal.sigpending" "Examine pending signals.\n\nReturns a set of signal numbers that are pending for delivery to\nthe calling thread."]
    ^{:go/apos {0 [355 2] 1 [355 65]} :go/pos {:colon [355 29]}} ["func:_signal.sigtimedwait" "Like sigwaitinfo(), but with a timeout.\n\nThe timeout is specified in seconds, with floating-point numbers allowed."]
    ^{:go/apos {0 [356 2] 1 [356 65]} :go/pos {:colon [356 24]}} ["func:_signal.sigwait" "Wait for a signal.\n\nSuspend execution of the calling thread until the delivery of one of the\nsignals specified in the signal set sigset.  The function accepts the\nsignal and returns the signal number."]
    ^{:go/apos {0 [357 2] 1 [357 65]} :go/pos {:colon [357 28]}} ["func:_signal.sigwaitinfo" "Wait synchronously until one of the signals in *sigset* is delivered.\n\nReturns a struct_siginfo containing information about the signal."]
    ^{:go/apos {0 [358 2] 1 [358 65]} :go/pos {:colon [358 26]}} ["func:_signal.strsignal" "Return the system description of the given signal.\n\nReturns the description of signal *signalnum*, such as \"Interrupt\"\nfor :const:`SIGINT`. Returns :const:`None` if *signalnum* has no\ndescription. Raises :exc:`ValueError` if *signalnum* is invalid."]
    ^{:go/apos {0 [359 2] 1 [359 65]} :go/pos {:colon [359 30]}} ["func:_signal.valid_signals" "Return a set of valid signal numbers on this platform.\n\nThe signal numbers returned by this function can be safely passed to\nfunctions like `pthread_sigmask`."]
    ^{:go/apos {0 [360 2] 1 [360 65]} :go/pos {:colon [360 25]}} ["func:_socket.CMSG_LEN" "CMSG_LEN(length) -> control message length\n\nReturn the total length, without trailing padding, of an ancillary\ndata item with associated data of the given length.  This value can\noften be used as the buffer size for recvmsg() to receive a single\nitem of ancillary data, but RFC 3542 requires portable applications to\nuse CMSG_SPACE() and thus include space for padding, even when the\nitem will be the last in the buffer.  Raises OverflowError if length\nis outside the permissible range of values."]
    ^{:go/apos {0 [361 2] 1 [361 65]} :go/pos {:colon [361 27]}} ["func:_socket.CMSG_SPACE" "CMSG_SPACE(length) -> buffer size\n\nReturn the buffer size needed for recvmsg() to receive an ancillary\ndata item with associated data of the given length, along with any\ntrailing padding.  The buffer space needed to receive multiple items\nis the sum of the CMSG_SPACE() values for their associated data\nlengths.  Raises OverflowError if length is outside the permissible\nrange of values."]
    ^{:go/apos {0 [362 2] 1 [362 65]} :go/pos {:colon [362 22]}} ["func:_socket.close" "close(integer) -> None\n\nClose an integer socket file descriptor.  This is like os.close(), but for\nsockets; on some platforms os.close() won't work for socket file descriptors."]
    ^{:go/apos {0 [363 2] 1 [363 65]} :go/pos {:colon [363 20]}} ["func:_socket.dup" "dup(integer) -> integer\n\nDuplicate an integer socket file descriptor.  This is like os.dup(), but for\nsockets; on some platforms os.dup() won't work for socket file descriptors."]
    ^{:go/apos {0 [364 2] 1 [364 65]} :go/pos {:colon [364 28]}} ["func:_socket.getaddrinfo" "getaddrinfo(host, port [, family, type, proto, flags])\n    -> list of (family, type, proto, canonname, sockaddr)\n\nResolve host and port into addrinfo struct."]
    ^{:go/apos {0 [365 2] 1 [365 65]} :go/pos {:colon [365 34]}} ["func:_socket.getdefaulttimeout" "getdefaulttimeout() -> timeout\n\nReturns the default timeout in seconds (float) for new socket objects.\nA value of None indicates that new socket objects have no timeout.\nWhen the socket module is first imported, the default is None."]
    ^{:go/apos {0 [366 2] 1 [366 65]} :go/pos {:colon [366 30]}} ["func:_socket.gethostbyaddr" "gethostbyaddr(host) -> (name, aliaslist, addresslist)\n\nReturn the true host name, a list of aliases, and a list of IP addresses,\nfor a host.  The host argument is a string giving a host name or IP number."]
    ^{:go/apos {0 [367 2] 1 [367 65]} :go/pos {:colon [367 30]}} ["func:_socket.gethostbyname" "gethostbyname(host) -> address\n\nReturn the IP address (a string of the form '255.255.255.255') for a host."]
    ^{:go/apos {0 [368 2] 1 [368 65]} :go/pos {:colon [368 33]}} ["func:_socket.gethostbyname_ex" "gethostbyname_ex(host) -> (name, aliaslist, addresslist)\n\nReturn the true host name, a list of aliases, and a list of IP addresses,\nfor a host.  The host argument is a string giving a host name or IP number."]
    ^{:go/apos {0 [369 2] 1 [369 65]} :go/pos {:colon [369 28]}} ["func:_socket.gethostname" "gethostname() -> string\n\nReturn the current host name."]
    ^{:go/apos {0 [370 2] 1 [370 65]} :go/pos {:colon [370 28]}} ["func:_socket.getnameinfo" "getnameinfo(sockaddr, flags) --> (host, port)\n\nGet host and port for a sockaddr."]
    ^{:go/apos {0 [371 2] 1 [371 65]} :go/pos {:colon [371 31]}} ["func:_socket.getprotobyname" "getprotobyname(name) -> integer\n\nReturn the protocol number for the named protocol.  (Rarely used.)"]
    ^{:go/apos {0 [372 2] 1 [372 65]} :go/pos {:colon [372 30]}} ["func:_socket.getservbyname" "getservbyname(servicename[, protocolname]) -> integer\n\nReturn a port number from a service name and protocol name.\nThe optional protocol name, if given, should be 'tcp' or 'udp',\notherwise any protocol will match."]
    ^{:go/apos {0 [373 2] 1 [373 65]} :go/pos {:colon [373 30]}} ["func:_socket.getservbyport" "getservbyport(port[, protocolname]) -> string\n\nReturn the service name from a port number and protocol name.\nThe optional protocol name, if given, should be 'tcp' or 'udp',\notherwise any protocol will match."]
    ^{:go/apos {0 [374 2] 1 [374 65]} :go/pos {:colon [374 22]}} ["func:_socket.htonl" "Convert a 32-bit unsigned integer from host to network byte order."]
    ^{:go/apos {0 [375 2] 1 [375 65]} :go/pos {:colon [375 22]}} ["func:_socket.htons" "Convert a 16-bit unsigned integer from host to network byte order."]
    ^{:go/apos {0 [376 2] 1 [376 65]} :go/pos {:colon [376 31]}} ["func:_socket.if_indextoname" "Returns the interface name corresponding to the interface index if_index."]
    ^{:go/apos {0 [377 2] 1 [377 65]} :go/pos {:colon [377 29]}} ["func:_socket.if_nameindex" "if_nameindex()\n\nReturns a list of network interface information (index, name) tuples."]
    ^{:go/apos {0 [378 2] 1 [378 65]} :go/pos {:colon [378 31]}} ["func:_socket.if_nametoindex" "Returns the interface index corresponding to the interface name if_name."]
    ^{:go/apos {0 [379 2] 1 [379 65]} :go/pos {:colon [379 26]}} ["func:_socket.inet_aton" "Convert an IP address in string format (123.45.67.89) to the 32-bit packed binary format used in low-level network functions."]
    ^{:go/apos {0 [380 2] 1 [380 65]} :go/pos {:colon [380 26]}} ["func:_socket.inet_ntoa" "Convert an IP address from 32-bit packed binary format to string format."]
    ^{:go/apos {0 [381 2] 1 [381 65]} :go/pos {:colon [381 26]}} ["func:_socket.inet_ntop" "inet_ntop(af, packed_ip) -> string formatted IP address\n\nConvert a packed IP address of the given family to string format."]
    ^{:go/apos {0 [382 2] 1 [382 65]} :go/pos {:colon [382 26]}} ["func:_socket.inet_pton" "inet_pton(af, ip) -> packed IP address string\n\nConvert an IP address from string format to a packed string suitable\nfor use with low-level network functions."]
    ^{:go/apos {0 [383 2] 1 [383 65]} :go/pos {:colon [383 22]}} ["func:_socket.ntohl" "Convert a 32-bit unsigned integer from network to host byte order."]
    ^{:go/apos {0 [384 2] 1 [384 65]} :go/pos {:colon [384 22]}} ["func:_socket.ntohs" "Convert a 16-bit unsigned integer from network to host byte order."]
    ^{:go/apos {0 [385 2] 1 [385 65]} :go/pos {:colon [385 34]}} ["func:_socket.setdefaulttimeout" "setdefaulttimeout(timeout)\n\nSet the default timeout in seconds (float) for new socket objects.\nA value of None indicates that new socket objects have no timeout.\nWhen the socket module is first imported, the default is None."]
    ^{:go/apos {0 [386 2] 1 [386 65]} :go/pos {:colon [386 28]}} ["func:_socket.sethostname" "sethostname(name)\n\nSets the hostname to name."]
    ^{:go/apos {0 [387 2] 1 [387 65]} :go/pos {:colon [387 27]}} ["func:_socket.socketpair" "socketpair([family[, type [, proto]]]) -> (socket object, socket object)\n\nCreate a pair of socket objects from the sockets returned by the platform\nsocketpair() function.\nThe arguments are the same as for socket() except the default family is\nAF_UNIX if defined on the platform; otherwise, the default is AF_INET."]
    ^{:go/apos {0 [388 2] 1 [388 65]} :go/pos {:colon [388 23]}} ["func:_sqlite3.adapt" "Adapt given object to given protocol."]
    ^{:go/apos {0 [389 2] 1 [389 65]} :go/pos {:colon [389 36]}} ["func:_sqlite3.complete_statement" "Checks if a string contains a complete SQL statement."]
    ^{:go/apos {0 [390 2] 1 [390 65]} :go/pos {:colon [390 25]}} ["func:_sqlite3.connect" "Open a connection to the SQLite database file 'database'.\n\nYou can use \":memory:\" to open a database connection to a database that\nresides in RAM instead of on disk.\n\nNote: Passing more than 1 positional argument to _sqlite3.connect() is\ndeprecated. Parameters 'timeout', 'detect_types', 'isolation_level',\n'check_same_thread', 'factory', 'cached_statements' and 'uri' will\nbecome keyword-only parameters in Python 3.15.\n"]
    ^{:go/apos {0 [391 2] 1 [391 65]} :go/pos {:colon [391 44]}} ["func:_sqlite3.enable_callback_tracebacks" "Enable or disable callback functions throwing errors to stderr."]
    ^{:go/apos {0 [392 2] 1 [392 65]} :go/pos {:colon [392 34]}} ["func:_sqlite3.register_adapter" "Register a function to adapt Python objects to SQLite values."]
    ^{:go/apos {0 [393 2] 1 [393 65]} :go/pos {:colon [393 36]}} ["func:_sqlite3.register_converter" "Register a function to convert SQLite values to Python objects."]
    ^{:go/apos {0 [394 2] 1 [394 65]} :go/pos {:colon [394 22]}} ["func:_sre.template" "\n\n  template\n    A list containing interleaved literal strings (str or bytes) and group\n    indices (int), as returned by re._parser.parse_template():\n        [literal1, group1, ..., literalN, groupN]"]
    ^{:go/apos {0 [395 2] 1 [395 65]} :go/pos {:colon [395 22]}} ["func:_ssl.RAND_add" "Mix string into the OpenSSL PRNG state.\n\nentropy (a float) is a lower bound on the entropy contained in\nstring.  See RFC 4086."]
    ^{:go/apos {0 [396 2] 1 [396 65]} :go/pos {:colon [396 24]}} ["func:_ssl.RAND_bytes" "Generate n cryptographically strong pseudo-random bytes."]
    ^{:go/apos {0 [397 2] 1 [397 65]} :go/pos {:colon [397 25]}} ["func:_ssl.RAND_status" "Returns True if the OpenSSL PRNG has been seeded with enough data and False if not.\n\nIt is necessary to seed the PRNG with RAND_add() on some platforms\nbefore using the ssl() function."]
    ^{:go/apos {0 [398 2] 1 [398 65]} :go/pos {:colon [398 38]}} ["func:_ssl.get_default_verify_paths" "Return search paths and environment vars that are used by SSLContext's set_default_verify_paths() to load default CAs.\n\nThe values are 'cert_file_env', 'cert_file', 'cert_dir_env', 'cert_dir'."]
    ^{:go/apos {0 [399 2] 1 [399 65]} :go/pos {:colon [399 21]}} ["func:_ssl.nid2obj" "Lookup NID, short name, long name and OID of an ASN1_OBJECT by NID."]
    ^{:go/apos {0 [400 2] 1 [400 65]} :go/pos {:colon [400 21]}} ["func:_ssl.txt2obj" "Lookup NID, short name, long name and OID of an ASN1_OBJECT.\n\nBy default objects are looked up by OID. With name=True short and\nlong name are also matched."]
    ^{:go/apos {0 [401 2] 1 [401 65]} :go/pos {:colon [401 21]}} ["func:_stat.S_IFMT" "Return the portion of the file's mode that describes the file type."]
    ^{:go/apos {0 [402 2] 1 [402 65]} :go/pos {:colon [402 22]}} ["func:_stat.S_IMODE" "Return the portion of the file's mode that can be set by os.chmod()."]
    ^{:go/apos {0 [403 2] 1 [403 65]} :go/pos {:colon [403 22]}} ["func:_stat.S_ISBLK" "S_ISBLK(mode) -> bool\n\nReturn True if mode is from a block special device file."]
    ^{:go/apos {0 [404 2] 1 [404 65]} :go/pos {:colon [404 22]}} ["func:_stat.S_ISCHR" "S_ISCHR(mode) -> bool\n\nReturn True if mode is from a character special device file."]
    ^{:go/apos {0 [405 2] 1 [405 65]} :go/pos {:colon [405 22]}} ["func:_stat.S_ISDIR" "S_ISDIR(mode) -> bool\n\nReturn True if mode is from a directory."]
    ^{:go/apos {0 [406 2] 1 [406 65]} :go/pos {:colon [406 23]}} ["func:_stat.S_ISDOOR" "S_ISDOOR(mode) -> bool\n\nReturn True if mode is from a door."]
    ^{:go/apos {0 [407 2] 1 [407 65]} :go/pos {:colon [407 23]}} ["func:_stat.S_ISFIFO" "S_ISFIFO(mode) -> bool\n\nReturn True if mode is from a FIFO (named pipe)."]
    ^{:go/apos {0 [408 2] 1 [408 65]} :go/pos {:colon [408 22]}} ["func:_stat.S_ISLNK" "S_ISLNK(mode) -> bool\n\nReturn True if mode is from a symbolic link."]
    ^{:go/apos {0 [409 2] 1 [409 65]} :go/pos {:colon [409 23]}} ["func:_stat.S_ISPORT" "S_ISPORT(mode) -> bool\n\nReturn True if mode is from an event port."]
    ^{:go/apos {0 [410 2] 1 [410 65]} :go/pos {:colon [410 22]}} ["func:_stat.S_ISREG" "S_ISREG(mode) -> bool\n\nReturn True if mode is from a regular file."]
    ^{:go/apos {0 [411 2] 1 [411 65]} :go/pos {:colon [411 23]}} ["func:_stat.S_ISSOCK" "S_ISSOCK(mode) -> bool\n\nReturn True if mode is from a socket."]
    ^{:go/apos {0 [412 2] 1 [412 65]} :go/pos {:colon [412 22]}} ["func:_stat.S_ISWHT" "S_ISWHT(mode) -> bool\n\nReturn True if mode is from a whiteout."]
    ^{:go/apos {0 [413 2] 1 [413 65]} :go/pos {:colon [413 23]}} ["func:_stat.filemode" "Convert a file's mode to a string of the form '-rwxrwxrwx'"]
    ^{:go/apos {0 [414 2] 1 [414 65]} :go/pos {:colon [414 43]}} ["func:_string.formatter_field_name_split" "split the argument as a field name"]
    ^{:go/apos {0 [415 2] 1 [415 65]} :go/pos {:colon [415 33]}} ["func:_string.formatter_parser" "parse the argument as a format string"]
    ^{:go/apos {0 [416 2] 1 [416 65]} :go/pos {:colon [416 28]}} ["func:_struct._clearcache" "Clear the internal cache."]
    ^{:go/apos {0 [417 2] 1 [417 65]} :go/pos {:colon [417 25]}} ["func:_struct.calcsize" "Return size in bytes of the struct described by the format string."]
    ^{:go/apos {0 [418 2] 1 [418 65]} :go/pos {:colon [418 28]}} ["func:_struct.iter_unpack" "Return an iterator yielding tuples unpacked from the given bytes.\n\nThe bytes are unpacked according to the format string, like\na repeated invocation of unpack_from().\n\nRequires that the bytes length be a multiple of the format struct size."]
    ^{:go/apos {0 [419 2] 1 [419 65]} :go/pos {:colon [419 21]}} ["func:_struct.pack" "pack(format, v1, v2, ...) -> bytes\n\nReturn a bytes object containing the values v1, v2, ... packed according\nto the format string.  See help(struct) for more on format strings."]
    ^{:go/apos {0 [420 2] 1 [420 65]} :go/pos {:colon [420 26]}} ["func:_struct.pack_into" "pack_into(format, buffer, offset, v1, v2, ...)\n\nPack the values v1, v2, ... according to the format string and write\nthe packed bytes into the writable buffer buf starting at offset.  Note\nthat the offset is a required argument.  A negative offset counts from\nthe end of the buffer.  See help(struct) for more on format strings."]
    ^{:go/apos {0 [421 2] 1 [421 65]} :go/pos {:colon [421 23]}} ["func:_struct.unpack" "Return a tuple containing values unpacked according to the format string.\n\nThe buffer's size in bytes must be calcsize(format).\n\nSee help(struct) for more on format strings."]
    ^{:go/apos {0 [422 2] 1 [422 65]} :go/pos {:colon [422 28]}} ["func:_struct.unpack_from" "Return a tuple containing values unpacked according to the format string.\n\nThe buffer's size, minus offset, must be at least calcsize(format).\nA negative offset counts from the end of the buffer.\n\nSee help(struct) for more on format strings."]
    ^{:go/apos {0 [423 2] 1 [423 65]} :go/pos {:colon [423 43]}} ["func:_suggestions._generate_suggestions" "Returns the candidate in candidates that's closest to item"]
    ^{:go/apos {0 [424 2] 1 [424 65]} :go/pos {:colon [424 27]}} ["func:_symtable.symtable" "Return symbol and scope dictionaries used internally by compiler."]
    ^{:go/apos {0 [425 2] 1 [425 65]} :go/pos {:colon [425 31]}} ["func:_sysconfig.config_vars" "Returns a dictionary containing build variables intended to be exposed by sysconfig."]
    ^{:go/apos {0 [426 2] 1 [426 65]} :go/pos {:colon [426 23]}} ["func:_thread._count" "Return the number of currently running Python threads, excluding\nthe main thread. The returned number comprises all threads created\nthrough `start_new_thread()` as well as `threading.Thread`, and not\nyet finished.\n\nThis function is meant for internal and specialized purposes only.\nIn most applications `threading.enumerate()` should be used instead."]
    ^{:go/apos {0 [427 2] 1 [427 65]} :go/pos {:colon [427 28]}} ["func:_thread._excepthook" "Handle uncaught Thread.run() exception."]
    ^{:go/apos {0 [428 2] 1 [428 65]} :go/pos {:colon [428 39]}} ["func:_thread._get_main_thread_ident" "Internal only. Return a non-zero integer that uniquely identifies the main thread\nof the main interpreter."]
    ^{:go/apos {0 [429 2] 1 [429 65]} :go/pos {:colon [429 26]}} ["func:_thread._get_name" "Get the name of the current thread."]
    ^{:go/apos {0 [430 2] 1 [430 65]} :go/pos {:colon [430 37]}} ["func:_thread._is_main_interpreter" "Return True if the current interpreter is the main Python interpreter."]
    ^{:go/apos {0 [431 2] 1 [431 65]} :go/pos {:colon [431 36]}} ["func:_thread._make_thread_handle" "Internal only. Make a thread handle for threads not spawned\nby the _thread or threading module."]
    ^{:go/apos {0 [432 2] 1 [432 65]} :go/pos {:colon [432 26]}} ["func:_thread._shutdown" "Wait for all non-daemon threads (other than the calling thread) to stop."]
    ^{:go/apos {0 [433 2] 1 [433 65]} :go/pos {:colon [433 25]}} ["func:_thread.allocate" "An obsolete synonym of allocate_lock()."]
    ^{:go/apos {0 [434 2] 1 [434 65]} :go/pos {:colon [434 30]}} ["func:_thread.allocate_lock" "Create a new lock object. See help(type(threading.Lock())) for\ninformation about locks."]
    ^{:go/apos {0 [435 2] 1 [435 65]} :go/pos {:colon [435 39]}} ["func:_thread.daemon_threads_allowed" "Return True if daemon threads are allowed in the current interpreter,\nand False otherwise.\n"]
    ^{:go/apos {0 [436 2] 1 [436 65]} :go/pos {:colon [436 21]}} ["func:_thread.exit" "This is synonymous to ``raise SystemExit''.  It will cause the current\nthread to exit silently unless the exception is caught."]
    ^{:go/apos {0 [437 2] 1 [437 65]} :go/pos {:colon [437 28]}} ["func:_thread.exit_thread" "An obsolete synonym of exit()."]
    ^{:go/apos {0 [438 2] 1 [438 65]} :go/pos {:colon [438 26]}} ["func:_thread.get_ident" "Return a non-zero integer that uniquely identifies the current thread\namongst other threads that exist simultaneously.\nThis may be used to identify per-thread resources.\nEven though on some platforms threads identities may appear to be\nallocated consecutive numbers starting at 1, this behavior should not\nbe relied upon, and the number should be seen purely as a magic cookie.\nA thread's identity may be reused for another thread after it exits."]
    ^{:go/apos {0 [439 2] 1 [439 65]} :go/pos {:colon [439 30]}} ["func:_thread.get_native_id" "Return a non-negative integer identifying the thread as reported\nby the OS (kernel). This may be used to uniquely identify a\nparticular thread within a system."]
    ^{:go/apos {0 [440 2] 1 [440 65]} :go/pos {:colon [440 31]}} ["func:_thread.interrupt_main" "Simulate the arrival of the given signal in the main thread,\nwhere the corresponding signal handler will be executed.\nIf *signum* is omitted, SIGINT is assumed.\nA subthread can use this function to interrupt the main thread.\n\nNote: the default signal handler for SIGINT raises ``KeyboardInterrupt``."]
    ^{:go/apos {0 [441 2] 1 [441 65]} :go/pos {:colon [441 25]}} ["func:_thread.set_name" "Set the name of the current thread."]
    ^{:go/apos {0 [442 2] 1 [442 65]} :go/pos {:colon [442 27]}} ["func:_thread.stack_size" "Return the thread stack size used when creating new threads.  The\noptional size argument specifies the stack size (in bytes) to be used\nfor subsequently created threads, and must be 0 (use platform or\nconfigured default) or a positive integer value of at least 32,768 (32k).\nIf changing the thread stack size is unsupported, a ThreadError\nexception is raised.  If the specified size is invalid, a ValueError\nexception is raised, and the stack size is unmodified.  32k bytes\n currently the minimum supported stack size value to guarantee\nsufficient stack space for the interpreter itself.\n\nNote that some platforms may have particular restrictions on values for\nthe stack size, such as requiring a minimum stack size larger than 32 KiB or\nrequiring allocation in multiples of the system memory page size\n- platform documentation should be referred to for more information\n(4 KiB pages are common; using multiples of 4096 for the stack size is\nthe suggested approach in the absence of more specific information)."]
    ^{:go/apos {0 [443 2] 1 [443 65]} :go/pos {:colon [443 38]}} ["func:_thread.start_joinable_thread" "*For internal use only*: start a new thread.\n\nLike start_new_thread(), this starts a new thread calling the given function.\nUnlike start_new_thread(), this returns a handle object with methods to join\nor detach the given thread.\nThis function is not for third-party code, please use the\n`threading` module instead. During finalization the runtime will not wait for\nthe thread to exit if daemon is True. If handle is provided it must be a\nnewly created thread._ThreadHandle instance."]
    ^{:go/apos {0 [444 2] 1 [444 65]} :go/pos {:colon [444 26]}} ["func:_thread.start_new" "An obsolete synonym of start_new_thread()."]
    ^{:go/apos {0 [445 2] 1 [445 65]} :go/pos {:colon [445 33]}} ["func:_thread.start_new_thread" "Start a new thread and return its identifier.\n\nThe thread will call the function with positional arguments from the\ntuple args and keyword arguments taken from the optional dictionary\nkwargs.  The thread exits when the function returns; the return value\nis ignored.  The thread will also exit when the function raises an\nunhandled exception; a stack trace will be printed unless the exception\nis SystemExit."]
    ^{:go/apos {0 [446 2] 1 [446 65]} :go/pos {:colon [446 43]}} ["func:_tracemalloc._get_object_traceback" "Get the traceback where the Python object obj was allocated.\n\nReturn a tuple of (filename: str, lineno: int) tuples.\nReturn None if the tracemalloc module is disabled or did not\ntrace the allocation of the object."]
    ^{:go/apos {0 [447 2] 1 [447 65]} :go/pos {:colon [447 33]}} ["func:_tracemalloc._get_traces" "Get traces of all memory blocks allocated by Python.\n\nReturn a list of (size: int, traceback: tuple) tuples.\ntraceback is a tuple of (filename: str, lineno: int) tuples.\n\nReturn an empty list if the tracemalloc module is disabled."]
    ^{:go/apos {0 [448 2] 1 [448 65]} :go/pos {:colon [448 34]}} ["func:_tracemalloc.clear_traces" "Clear traces of memory blocks allocated by Python."]
    ^{:go/apos {0 [449 2] 1 [449 65]} :go/pos {:colon [449 41]}} ["func:_tracemalloc.get_traceback_limit" "Get the maximum number of frames stored in the traceback of a trace.\n\nBy default, a trace of an allocated memory block only stores\nthe most recent frame: the limit is 1."]
    ^{:go/apos {0 [450 2] 1 [450 65]} :go/pos {:colon [450 39]}} ["func:_tracemalloc.get_traced_memory" "Get the current size and peak size of memory blocks traced by tracemalloc.\n\nReturns a tuple: (current: int, peak: int)."]
    ^{:go/apos {0 [451 2] 1 [451 65]} :go/pos {:colon [451 44]}} ["func:_tracemalloc.get_tracemalloc_memory" "Get the memory usage in bytes of the tracemalloc module.\n\nThis memory is used internally to trace memory allocations."]
    ^{:go/apos {0 [452 2] 1 [452 65]} :go/pos {:colon [452 32]}} ["func:_tracemalloc.is_tracing" "Return True if the tracemalloc module is tracing Python memory allocations."]
    ^{:go/apos {0 [453 2] 1 [453 65]} :go/pos {:colon [453 32]}} ["func:_tracemalloc.reset_peak" "Set the peak size of memory blocks traced by tracemalloc to the current size.\n\nDo nothing if the tracemalloc module is not tracing memory allocations."]
    ^{:go/apos {0 [454 2] 1 [454 65]} :go/pos {:colon [454 27]}} ["func:_tracemalloc.start" "Start tracing Python memory allocations.\n\nAlso set the maximum number of frames stored in the traceback of a\ntrace to nframe."]
    ^{:go/apos {0 [455 2] 1 [455 65]} :go/pos {:colon [455 26]}} ["func:_tracemalloc.stop" "Stop tracing Python memory allocations.\n\nAlso clear traces of memory blocks allocated by Python."]
    ^{:go/apos {0 [456 2] 1 [456 65]} :go/pos {:colon [456 23]}} ["func:_warnings.warn" "Issue a warning, or maybe ignore it or raise an exception.\n\n  message\n    Text of the warning message.\n  category\n    The Warning category subclass. Defaults to UserWarning.\n  stacklevel\n    How far up the call stack to make this warning appear. A value of 2 for\n    example attributes the warning to the caller of the code calling warn().\n  source\n    If supplied, the destroyed object which emitted a ResourceWarning\n  skip_file_prefixes\n    An optional tuple of module filename prefixes indicating frames to skip\n    during stacklevel computations for stack frame attribution."]
    ^{:go/apos {0 [457 2] 1 [457 65]} :go/pos {:colon [457 32]}} ["func:_warnings.warn_explicit" "Issue a warning, or maybe ignore it or raise an exception."]
    ^{:go/apos {0 [458 2] 1 [458 65]} :go/pos {:colon [458 38]}} ["func:_weakref._remove_dead_weakref" "Atomically remove key from dict if it points to a dead weakref."]
    ^{:go/apos {0 [459 2] 1 [459 65]} :go/pos {:colon [459 33]}} ["func:_weakref.getweakrefcount" "Return the number of weak references to 'object'."]
    ^{:go/apos {0 [460 2] 1 [460 65]} :go/pos {:colon [460 29]}} ["func:_weakref.getweakrefs" "Return a list of all weak reference objects pointing to 'object'."]
    ^{:go/apos {0 [461 2] 1 [461 65]} :go/pos {:colon [461 23]}} ["func:_weakref.proxy" "Create a proxy object that weakly references 'object'.\n\n'callback', if given, is called with a reference to the\nproxy when 'object' is about to be finalized."]
    ^{:go/apos {0 [462 2] 1 [462 65]} :go/pos {:colon [462 35]}} ["func:array._array_reconstructor" "Internal. Used for pickling support."]
    ^{:go/apos {0 [463 2] 1 [463 65]} :go/pos {:colon [463 22]}} ["func:atexit._clear" "Clear the list of previously registered exit functions."]
    ^{:go/apos {0 [464 2] 1 [464 65]} :go/pos {:colon [464 27]}} ["func:atexit._ncallbacks" "Return the number of registered exit functions."]
    ^{:go/apos {0 [465 2] 1 [465 65]} :go/pos {:colon [465 30]}} ["func:atexit._run_exitfuncs" "Run all registered exit functions.\n\nIf a callback raises an exception, it is logged with sys.unraisablehook."]
    ^{:go/apos {0 [466 2] 1 [466 65]} :go/pos {:colon [466 24]}} ["func:atexit.register" "Register a function to be executed upon normal program termination\n\n    func - function to be called at exit\n    args - optional arguments to pass to func\n    kwargs - optional keyword arguments to pass to func\n\n    func is returned to facilitate usage as a decorator."]
    ^{:go/apos {0 [467 2] 1 [467 65]} :go/pos {:colon [467 26]}} ["func:atexit.unregister" "Unregister an exit function which was previously registered using\natexit.register\n\n    func - function to be unregistered"]
    ^{:go/apos {0 [468 2] 1 [468 65]} :go/pos {:colon [468 28]}} ["func:binascii.a2b_base64" "Decode a line of base64 data.\n\n  strict_mode\n    When set to True, bytes that are not part of the base64 standard are not allowed.\n    The same applies to excess data after padding (= / ==)."]
    ^{:go/apos {0 [469 2] 1 [469 65]} :go/pos {:colon [469 25]}} ["func:binascii.a2b_hex" "Binary data of hexadecimal representation.\n\nhexstr must contain an even number of hex digits (upper or lower case).\nThis function is also available as \"unhexlify()\"."]
    ^{:go/apos {0 [470 2] 1 [470 65]} :go/pos {:colon [470 24]}} ["func:binascii.a2b_qp" "Decode a string of qp-encoded data."]
    ^{:go/apos {0 [471 2] 1 [471 65]} :go/pos {:colon [471 24]}} ["func:binascii.a2b_uu" "Decode a line of uuencoded data."]
    ^{:go/apos {0 [472 2] 1 [472 65]} :go/pos {:colon [472 28]}} ["func:binascii.b2a_base64" "Base64-code line of data."]
    ^{:go/apos {0 [473 2] 1 [473 65]} :go/pos {:colon [473 25]}} ["func:binascii.b2a_hex" "Hexadecimal representation of binary data.\n\n  sep\n    An optional single character or byte to separate hex bytes.\n  bytes_per_sep\n    How many bytes between separators.  Positive values count from the\n    right, negative values count from the left.\n\nThe return value is a bytes object.  This function is also\navailable as \"hexlify()\".\n\nExample:\n>>> binascii.b2a_hex(b'\\xb9\\x01\\xef')\nb'b901ef'\n>>> binascii.hexlify(b'\\xb9\\x01\\xef', ':')\nb'b9:01:ef'\n>>> binascii.b2a_hex(b'\\xb9\\x01\\xef', b'_', 2)\nb'b9_01ef'"]
    ^{:go/apos {0 [474 2] 1 [474 65]} :go/pos {:colon [474 24]}} ["func:binascii.b2a_qp" "Encode a string using quoted-printable encoding.\n\nOn encoding, when istext is set, newlines are not encoded, and white\nspace at end of lines is.  When istext is not set, \\r and \\n (CR/LF)\nare both encoded.  When quotetabs is set, space and tabs are encoded."]
    ^{:go/apos {0 [475 2] 1 [475 65]} :go/pos {:colon [475 24]}} ["func:binascii.b2a_uu" "Uuencode line of data."]
    ^{:go/apos {0 [476 2] 1 [476 65]} :go/pos {:colon [476 23]}} ["func:binascii.crc32" "Compute CRC-32 incrementally."]
    ^{:go/apos {0 [477 2] 1 [477 65]} :go/pos {:colon [477 25]}} ["func:binascii.crc_hqx" "Compute CRC-CCITT incrementally."]
    ^{:go/apos {0 [478 2] 1 [478 65]} :go/pos {:colon [478 25]}} ["func:binascii.hexlify" "Hexadecimal representation of binary data.\n\n  sep\n    An optional single character or byte to separate hex bytes.\n  bytes_per_sep\n    How many bytes between separators.  Positive values count from the\n    right, negative values count from the left.\n\nThe return value is a bytes object.  This function is also\navailable as \"b2a_hex()\"."]
    ^{:go/apos {0 [479 2] 1 [479 65]} :go/pos {:colon [479 27]}} ["func:binascii.unhexlify" "Binary data of hexadecimal representation.\n\nhexstr must contain an even number of hex digits (upper or lower case)."]
    ^{:go/apos {0 [480 2] 1 [480 65]} :go/pos {:colon [480 33]}} ["func:builtins.__build_class__" "__build_class__(func, name, /, *bases, [metaclass], **kwds) -> class\n\nInternal helper function used by the class statement."]
    ^{:go/apos {0 [481 2] 1 [481 65]} :go/pos {:colon [481 28]}} ["func:builtins.__import__" "Import a module.\n\nBecause this function is meant for use by the Python\ninterpreter and not for general use, it is better to use\nimportlib.import_module() to programmatically import a module.\n\nThe globals argument is only used to determine the context;\nthey are not modified.  The locals argument is unused.  The fromlist\nshould be a list of names to emulate ``from name import ...``, or an\nempty list to emulate ``import name``.\nWhen importing a module from a package, note that __import__('A.B', ...)\nreturns package A when fromlist is empty, but its submodule B when\nfromlist is not empty.  The level argument is used to determine whether\nto perform absolute or relative imports: 0 is absolute, while a positive\nnumber is the number of parent directories to search relative to the\ncurrent module."]
    ^{:go/apos {0 [482 2] 1 [482 65]} :go/pos {:colon [482 21]}} ["func:builtins.abs" "Return the absolute value of the argument."]
    ^{:go/apos {0 [483 2] 1 [483 65]} :go/pos {:colon [483 23]}} ["func:builtins.aiter" "Return an AsyncIterator for an AsyncIterable object."]
    ^{:go/apos {0 [484 2] 1 [484 65]} :go/pos {:colon [484 21]}} ["func:builtins.all" "Return True if bool(x) is True for all values x in the iterable.\n\nIf the iterable is empty, return True."]
    ^{:go/apos {0 [485 2] 1 [485 65]} :go/pos {:colon [485 23]}} ["func:builtins.anext" "Return the next item from the async iterator.\n\nIf default is given and the async iterator is exhausted,\nit is returned instead of raising StopAsyncIteration."]
    ^{:go/apos {0 [486 2] 1 [486 65]} :go/pos {:colon [486 21]}} ["func:builtins.any" "Return True if bool(x) is True for any x in the iterable.\n\nIf the iterable is empty, return False."]
    ^{:go/apos {0 [487 2] 1 [487 65]} :go/pos {:colon [487 23]}} ["func:builtins.ascii" "Return an ASCII-only representation of an object.\n\nAs repr(), return a string containing a printable representation of an\nobject, but escape the non-ASCII characters in the string returned by\nrepr() using \\\\x, \\\\u or \\\\U escapes. This generates a string similar\nto that returned by repr() in Python 2."]
    ^{:go/apos {0 [488 2] 1 [488 65]} :go/pos {:colon [488 21]}} ["func:builtins.bin" "Return the binary representation of an integer.\n\n   >>> bin(2796202)\n   '0b1010101010101010101010'"]
    ^{:go/apos {0 [489 2] 1 [489 65]} :go/pos {:colon [489 28]}} ["func:builtins.breakpoint" "Call sys.breakpointhook(*args, **kws).  sys.breakpointhook() must accept\nwhatever arguments are passed.\n\nBy default, this drops you into the pdb debugger."]
    ^{:go/apos {0 [490 2] 1 [490 65]} :go/pos {:colon [490 26]}} ["func:builtins.callable" "Return whether the object is callable (i.e., some kind of function).\n\nNote that classes are callable, as are instances of classes with a\n__call__() method."]
    ^{:go/apos {0 [491 2] 1 [491 65]} :go/pos {:colon [491 21]}} ["func:builtins.chr" "Return a Unicode string of one character with ordinal i; 0 <= i <= 0x10ffff."]
    ^{:go/apos {0 [492 2] 1 [492 65]} :go/pos {:colon [492 25]}} ["func:builtins.compile" "Compile source into a code object that can be executed by exec() or eval().\n\nThe source code may represent a Python module, statement or\nexpression.\nThe filename will be used for run-time error messages.\nThe mode must be 'exec' to compile a module, 'single' to compile a\nsingle (interactive) statement, or 'eval' to compile an expression.\nThe flags argument, if present, controls which future statements\ninfluence the compilation of the code.\nThe dont_inherit argument, if true, stops the compilation inheriting\nthe effects of any future statements in effect in the code calling\ncompile; if absent or false these statements do influence the\ncompilation, in addition to any features explicitly specified."]
    ^{:go/apos {0 [493 2] 1 [493 65]} :go/pos {:colon [493 25]}} ["func:builtins.delattr" "Deletes the named attribute from the given object.\n\ndelattr(x, 'y') is equivalent to ``del x.y``"]
    ^{:go/apos {0 [494 2] 1 [494 65]} :go/pos {:colon [494 21]}} ["func:builtins.dir" "dir([object]) -> list of strings\n\nIf called without an argument, return the names in the current scope.\nElse, return an alphabetized list of names comprising (some of) the\nattributes of the given object, and of attributes reachable from it.\nIf the object supplies a method named __dir__, it will be used;\notherwise the default dir() logic is used and returns:\n  for a module object: the module's attributes.\n  for a class object:  its attributes, and recursively the attributes\n    of its bases.\n  for any other object: its attributes, its class's attributes, and\n    recursively the attributes of its class's base classes."]
    ^{:go/apos {0 [495 2] 1 [495 65]} :go/pos {:colon [495 24]}} ["func:builtins.divmod" "Return the tuple (x//y, x%y).  Invariant: div*y + mod == x."]
    ^{:go/apos {0 [496 2] 1 [496 65]} :go/pos {:colon [496 22]}} ["func:builtins.eval" "Evaluate the given source in the context of globals and locals.\n\nThe source may be a string representing a Python expression\nor a code object as returned by compile().\nThe globals must be a dictionary and locals can be any mapping,\ndefaulting to the current globals and locals.\nIf only globals is given, locals defaults to it."]
    ^{:go/apos {0 [497 2] 1 [497 65]} :go/pos {:colon [497 22]}} ["func:builtins.exec" "Execute the given source in the context of globals and locals.\n\nThe source may be a string representing one or more Python statements\nor a code object as returned by compile().\nThe globals must be a dictionary and locals can be any mapping,\ndefaulting to the current globals and locals.\nIf only globals is given, locals defaults to it.\nThe closure must be a tuple of cellvars, and can only be used\nwhen source is a code object requiring exactly that many cellvars."]
    ^{:go/apos {0 [498 2] 1 [498 65]} :go/pos {:colon [498 24]}} ["func:builtins.format" "Return type(value).__format__(value, format_spec)\n\nMany built-in types implement format_spec according to the\nFormat Specification Mini-language. See help('FORMATTING').\n\nIf type(value) does not supply a method named __format__\nand format_spec is empty, then str(value) is returned.\nSee also help('SPECIALMETHODS')."]
    ^{:go/apos {0 [499 2] 1 [499 65]} :go/pos {:colon [499 25]}} ["func:builtins.getattr" "getattr(object, name[, default]) -> value\n\nGet a named attribute from an object.\n\ngetattr(x, 'y') is equivalent to x.y.\nWhen a default argument is given, it is returned when the attribute\ndoesn't exist; without it, an exception is raised in that case."]
    ^{:go/apos {0 [500 2] 1 [500 65]} :go/pos {:colon [500 25]}} ["func:builtins.globals" "Return the dictionary containing the current scope's global variables.\n\nNOTE: Updates to this dictionary *will* affect name lookups in the\ncurrent global scope and vice-versa."]
    ^{:go/apos {0 [501 2] 1 [501 65]} :go/pos {:colon [501 25]}} ["func:builtins.hasattr" "Return whether the object has an attribute with the given name.\n\nThis is done by calling getattr(obj, name) and catching AttributeError."]
    ^{:go/apos {0 [502 2] 1 [502 65]} :go/pos {:colon [502 22]}} ["func:builtins.hash" "Return the integer hash value for the given object.\n\nTwo objects that compare equal must also have the same hash value, but\nthe reverse is not necessarily true.  Hash values may differ between\nPython processes.  Not all objects are hashable; calling hash() on an\nunhashable object raises TypeError."]
    ^{:go/apos {0 [503 2] 1 [503 65]} :go/pos {:colon [503 21]}} ["func:builtins.hex" "Return the hexadecimal representation of an integer.\n\n   >>> hex(12648430)\n   '0xc0ffee'"]
    ^{:go/apos {0 [504 2] 1 [504 65]} :go/pos {:colon [504 20]}} ["func:builtins.id" "Return the identity of an object.\n\nThis is guaranteed to be unique among simultaneously existing objects.\n(CPython uses the object's memory address.)"]
    ^{:go/apos {0 [505 2] 1 [505 65]} :go/pos {:colon [505 23]}} ["func:builtins.input" "Read a string from standard input.  The trailing newline is stripped.\n\nThe prompt string, if given, is printed to standard output without a\ntrailing newline before reading input.\n\nIf the user hits EOF (*nix: Ctrl-D, Windows: Ctrl-Z+Return), raise\nEOFError.\nOn *nix systems, readline is used if available."]
    ^{:go/apos {0 [506 2] 1 [506 65]} :go/pos {:colon [506 28]}} ["func:builtins.isinstance" "Return whether an object is an instance of a class or of a subclass thereof.\n\nA tuple, as in ``isinstance(x, (A, B, ...))``, may be given as the\ntarget to check against.  This is equivalent to ``isinstance(x, A) or\nisinstance(x, B) or ...`` etc."]
    ^{:go/apos {0 [507 2] 1 [507 65]} :go/pos {:colon [507 28]}} ["func:builtins.issubclass" "Return whether 'cls' is derived from another class or is the same class.\n\nA tuple, as in ``issubclass(x, (A, B, ...))``, may be given as the\ntarget to check against.  This is equivalent to ``issubclass(x, A) or\nissubclass(x, B) or ...``."]
    ^{:go/apos {0 [508 2] 1 [508 65]} :go/pos {:colon [508 22]}} ["func:builtins.iter" "iter(iterable) -> iterator\niter(callable, sentinel) -> iterator\n\nGet an iterator from an object.  In the first form, the argument must\nsupply its own iterator, or be a sequence.\nIn the second form, the callable is called until it returns the\nsentinel."]
    ^{:go/apos {0 [509 2] 1 [509 65]} :go/pos {:colon [509 21]}} ["func:builtins.len" "Return the number of items in a container."]
    ^{:go/apos {0 [510 2] 1 [510 65]} :go/pos {:colon [510 24]}} ["func:builtins.locals" "Return a dictionary containing the current scope's local variables.\n\nNOTE: Whether or not updates to this dictionary will affect name\nlookups in the local scope and vice-versa is *implementation\ndependent* and not covered by any backwards compatibility\nguarantees."]
    ^{:go/apos {0 [511 2] 1 [511 65]} :go/pos {:colon [511 21]}} ["func:builtins.max" "max(iterable, *[, default=obj, key=func]) -> value\nmax(arg1, arg2, *args, *[, key=func]) -> value\n\nWith a single iterable argument, return its biggest item. The\ndefault keyword-only argument specifies an object to return if\nthe provided iterable is empty.\nWith two or more positional arguments, return the largest argument."]
    ^{:go/apos {0 [512 2] 1 [512 65]} :go/pos {:colon [512 21]}} ["func:builtins.min" "min(iterable, *[, default=obj, key=func]) -> value\nmin(arg1, arg2, *args, *[, key=func]) -> value\n\nWith a single iterable argument, return its smallest item. The\ndefault keyword-only argument specifies an object to return if\nthe provided iterable is empty.\nWith two or more positional arguments, return the smallest argument."]
    ^{:go/apos {0 [513 2] 1 [513 65]} :go/pos {:colon [513 22]}} ["func:builtins.next" "next(iterator[, default])\n\nReturn the next item from the iterator.  If default is given and the\niterator is exhausted, it is returned instead of raising StopIteration."]
    ^{:go/apos {0 [514 2] 1 [514 65]} :go/pos {:colon [514 21]}} ["func:builtins.oct" "Return the octal representation of an integer.\n\n   >>> oct(342391)\n   '0o1234567'"]
    ^{:go/apos {0 [515 2] 1 [515 65]} :go/pos {:colon [515 21]}} ["func:builtins.ord" "Return the ordinal value of a character.\n\nIf the argument is a one-character string, return the Unicode code\npoint of that character.\n\nIf the argument is a bytes or bytearray object of length 1, return its\nsingle byte value."]
    ^{:go/apos {0 [516 2] 1 [516 65]} :go/pos {:colon [516 21]}} ["func:builtins.pow" "Equivalent to base**exp with 2 arguments or base**exp % mod with 3 arguments\n\nSome types, such as ints, are able to use a more efficient algorithm\nwhen invoked using the three argument form."]
    ^{:go/apos {0 [517 2] 1 [517 65]} :go/pos {:colon [517 23]}} ["func:builtins.print" "Prints the values to a stream, or to sys.stdout by default.\n\n  sep\n    string inserted between values, default a space.\n  end\n    string appended after the last value, default a newline.\n  file\n    a file-like object (stream); defaults to the current sys.stdout.\n  flush\n    whether to forcibly flush the stream."]
    ^{:go/apos {0 [518 2] 1 [518 65]} :go/pos {:colon [518 22]}} ["func:builtins.repr" "Return the canonical string representation of the object.\n\nFor many object types, including most builtins, eval(repr(obj)) == obj."]
    ^{:go/apos {0 [519 2] 1 [519 65]} :go/pos {:colon [519 23]}} ["func:builtins.round" "Round a number to a given precision in decimal digits.\n\nThe return value is an integer if ndigits is omitted or None.\nOtherwise the return value has the same type as the number.  ndigits\nmay be negative."]
    ^{:go/apos {0 [520 2] 1 [520 65]} :go/pos {:colon [520 25]}} ["func:builtins.setattr" "Sets the named attribute on the given object to the specified value.\n\nsetattr(x, 'y', v) is equivalent to ``x.y = v``"]
    ^{:go/apos {0 [521 2] 1 [521 65]} :go/pos {:colon [521 24]}} ["func:builtins.sorted" "Return a new list containing all items from the iterable in ascending order.\n\nA custom key function can be supplied to customize the sort order, and the\nreverse flag can be set to request the result in descending order."]
    ^{:go/apos {0 [522 2] 1 [522 65]} :go/pos {:colon [522 21]}} ["func:builtins.sum" "Return the sum of a 'start' value (default: 0) plus an iterable of numbers\n\nWhen the iterable is empty, return the start value.\nThis function is intended specifically for use with numeric values and\nmay reject non-numeric types."]
    ^{:go/apos {0 [523 2] 1 [523 65]} :go/pos {:colon [523 22]}} ["func:builtins.vars" "vars([object]) -> dictionary\n\nWithout arguments, equivalent to locals().\nWith an argument, equivalent to object.__dict__."]
    ^{:go/apos {0 [524 2] 1 [524 65]} :go/pos {:colon [524 19]}} ["func:cmath.acos" "Return the arc cosine of z."]
    ^{:go/apos {0 [525 2] 1 [525 65]} :go/pos {:colon [525 20]}} ["func:cmath.acosh" "Return the inverse hyperbolic cosine of z."]
    ^{:go/apos {0 [526 2] 1 [526 65]} :go/pos {:colon [526 19]}} ["func:cmath.asin" "Return the arc sine of z."]
    ^{:go/apos {0 [527 2] 1 [527 65]} :go/pos {:colon [527 20]}} ["func:cmath.asinh" "Return the inverse hyperbolic sine of z."]
    ^{:go/apos {0 [528 2] 1 [528 65]} :go/pos {:colon [528 19]}} ["func:cmath.atan" "Return the arc tangent of z."]
    ^{:go/apos {0 [529 2] 1 [529 65]} :go/pos {:colon [529 20]}} ["func:cmath.atanh" "Return the inverse hyperbolic tangent of z."]
    ^{:go/apos {0 [530 2] 1 [530 65]} :go/pos {:colon [530 18]}} ["func:cmath.cos" "Return the cosine of z."]
    ^{:go/apos {0 [531 2] 1 [531 65]} :go/pos {:colon [531 19]}} ["func:cmath.cosh" "Return the hyperbolic cosine of z."]
    ^{:go/apos {0 [532 2] 1 [532 65]} :go/pos {:colon [532 18]}} ["func:cmath.exp" "Return the exponential value e**z."]
    ^{:go/apos {0 [533 2] 1 [533 65]} :go/pos {:colon [533 22]}} ["func:cmath.isclose" "Determine whether two complex numbers are close in value.\n\n  rel_tol\n    maximum difference for being considered \"close\", relative to the\n    magnitude of the input values\n  abs_tol\n    maximum difference for being considered \"close\", regardless of the\n    magnitude of the input values\n\nReturn True if a is close in value to b, and False otherwise.\n\nFor the values to be considered close, the difference between them must\nbe smaller than at least one of the tolerances.\n\n-inf, inf and NaN behave similarly to the IEEE 754 Standard.  That is,\nNaN is not close to anything, even itself. inf and -inf are only close\nto themselves."]
    ^{:go/apos {0 [534 2] 1 [534 65]} :go/pos {:colon [534 23]}} ["func:cmath.isfinite" "Return True if both the real and imaginary parts of z are finite, else False."]
    ^{:go/apos {0 [535 2] 1 [535 65]} :go/pos {:colon [535 20]}} ["func:cmath.isinf" "Checks if the real or imaginary part of z is infinite."]
    ^{:go/apos {0 [536 2] 1 [536 65]} :go/pos {:colon [536 20]}} ["func:cmath.isnan" "Checks if the real or imaginary part of z not a number (NaN)."]
    ^{:go/apos {0 [537 2] 1 [537 65]} :go/pos {:colon [537 18]}} ["func:cmath.log" "log(z[, base]) -> the logarithm of z to the given base.\n\nIf the base is not specified, returns the natural logarithm (base e)\nof z."]
    ^{:go/apos {0 [538 2] 1 [538 65]} :go/pos {:colon [538 20]}} ["func:cmath.log10" "Return the base-10 logarithm of z."]
    ^{:go/apos {0 [539 2] 1 [539 65]} :go/pos {:colon [539 20]}} ["func:cmath.phase" "Return argument, also known as the phase angle, of a complex."]
    ^{:go/apos {0 [540 2] 1 [540 65]} :go/pos {:colon [540 20]}} ["func:cmath.polar" "Convert a complex from rectangular coordinates to polar coordinates.\n\nr is the distance from 0 and phi the phase angle."]
    ^{:go/apos {0 [541 2] 1 [541 65]} :go/pos {:colon [541 19]}} ["func:cmath.rect" "Convert from polar coordinates to rectangular coordinates."]
    ^{:go/apos {0 [542 2] 1 [542 65]} :go/pos {:colon [542 18]}} ["func:cmath.sin" "Return the sine of z."]
    ^{:go/apos {0 [543 2] 1 [543 65]} :go/pos {:colon [543 19]}} ["func:cmath.sinh" "Return the hyperbolic sine of z."]
    ^{:go/apos {0 [544 2] 1 [544 65]} :go/pos {:colon [544 19]}} ["func:cmath.sqrt" "Return the square root of z."]
    ^{:go/apos {0 [545 2] 1 [545 65]} :go/pos {:colon [545 18]}} ["func:cmath.tan" "Return the tangent of z."]
    ^{:go/apos {0 [546 2] 1 [546 65]} :go/pos {:colon [546 19]}} ["func:cmath.tanh" "Return the hyperbolic tangent of z."]
    ^{:go/apos {0 [547 2] 1 [547 65]} :go/pos {:colon [547 43]}} ["func:faulthandler._fatal_error_c_thread" "Call Py_FatalError() in a new C thread."]
    ^{:go/apos {0 [548 2] 1 [548 65]} :go/pos {:colon [548 32]}} ["func:faulthandler._read_null" "Read from NULL, raise a SIGSEGV or SIGBUS signal depending on the platform."]
    ^{:go/apos {0 [549 2] 1 [549 65]} :go/pos {:colon [549 30]}} ["func:faulthandler._sigabrt" "Raise a SIGABRT signal."]
    ^{:go/apos {0 [550 2] 1 [550 65]} :go/pos {:colon [550 29]}} ["func:faulthandler._sigfpe" "Raise a SIGFPE signal."]
    ^{:go/apos {0 [551 2] 1 [551 65]} :go/pos {:colon [551 30]}} ["func:faulthandler._sigsegv" "Raise a SIGSEGV signal."]
    ^{:go/apos {0 [552 2] 1 [552 65]} :go/pos {:colon [552 37]}} ["func:faulthandler._stack_overflow" "Recursive call to raise a stack overflow."]
    ^{:go/apos {0 [553 2] 1 [553 65]} :go/pos {:colon [553 49]}} ["func:faulthandler.cancel_dump_traceback_later" "Cancel the previous call to dump_traceback_later()."]
    ^{:go/apos {0 [554 2] 1 [554 65]} :go/pos {:colon [554 29]}} ["func:faulthandler.disable" "Disable the fault handler."]
    ^{:go/apos {0 [555 2] 1 [555 65]} :go/pos {:colon [555 34]}} ["func:faulthandler.dump_c_stack" "Dump the C stack of the current thread."]
    ^{:go/apos {0 [556 2] 1 [556 65]} :go/pos {:colon [556 36]}} ["func:faulthandler.dump_traceback" "Dump the traceback of the current thread, or of all threads if all_threads is True, into file."]
    ^{:go/apos {0 [557 2] 1 [557 65]} :go/pos {:colon [557 42]}} ["func:faulthandler.dump_traceback_later" "Dump the traceback of all threads in timeout seconds,\nor each timeout seconds if repeat is True. If exit is True, call _exit(1) which is not safe."]
    ^{:go/apos {0 [558 2] 1 [558 65]} :go/pos {:colon [558 28]}} ["func:faulthandler.enable" "Enable the fault handler."]
    ^{:go/apos {0 [559 2] 1 [559 65]} :go/pos {:colon [559 32]}} ["func:faulthandler.is_enabled" "Check if the handler is enabled."]
    ^{:go/apos {0 [560 2] 1 [560 65]} :go/pos {:colon [560 30]}} ["func:faulthandler.register" "Register a handler for the signal 'signum': dump the traceback of the current thread, or of all threads if all_threads is True, into file."]
    ^{:go/apos {0 [561 2] 1 [561 65]} :go/pos {:colon [561 32]}} ["func:faulthandler.unregister" "Unregister the handler of the signal 'signum' registered by register()."]
    ^{:go/apos {0 [562 2] 1 [562 65]} :go/pos {:colon [562 20]}} ["func:fcntl.fcntl" "Perform the operation cmd on file descriptor fd.\n\nThe values used for cmd are operating system dependent, and are\navailable as constants in the fcntl module, using the same names as used\nin the relevant C header files.  The argument arg is optional, and\ndefaults to 0; it may be an integer, a bytes-like object or a string.\nIf arg is given as a string, it will be encoded to binary using the\nUTF-8 encoding.\n\nIf the arg given is an integer or if none is specified, the result value\nis an integer corresponding to the return value of the fcntl() call in\nthe C code.\n\nIf arg is given as a bytes-like object, the return value of fcntl() is a\nbytes object of that length, containing the resulting value put in the\narg buffer by the operating system.  The length of the arg buffer is not\nallowed to exceed 1024 bytes."]
    ^{:go/apos {0 [563 2] 1 [563 65]} :go/pos {:colon [563 20]}} ["func:fcntl.flock" "Perform the lock operation on file descriptor fd.\n\nSee the Unix manual page for flock(2) for details (On some systems, this\nfunction is emulated using fcntl())."]
    ^{:go/apos {0 [564 2] 1 [564 65]} :go/pos {:colon [564 20]}} ["func:fcntl.ioctl" "Perform the operation request on file descriptor fd.\n\nThe values used for request are operating system dependent, and are\navailable as constants in the fcntl or termios library modules, using\nthe same names as used in the relevant C header files.\n\nThe argument arg is optional, and defaults to 0; it may be an integer, a\nbytes-like object or a string.  If arg is given as a string, it will be\nencoded to binary using the UTF-8 encoding.\n\nIf the arg given is an integer or if none is specified, the result value\nis an integer corresponding to the return value of the ioctl() call in\nthe C code.\n\nIf the argument is a mutable buffer (such as a bytearray) and the\nmutate_flag argument is true (default) then the buffer is (in effect)\npassed to the operating system and changes made by the OS will be\nreflected in the contents of the buffer after the call has returned.\nThe return value is the integer returned by the ioctl() system call.\n\nIf the argument is a mutable buffer and the mutable_flag argument is\nfalse, the behavior is as if an immutable buffer had been passed.\n\nIf the argument is an immutable buffer then a copy of the buffer is\npassed to the operating system and the return value is a bytes object of\nthe same length containing whatever the operating system put in the\nbuffer.  The length of the arg buffer in this case is not allowed to\nexceed 1024 bytes."]
    ^{:go/apos {0 [565 2] 1 [565 65]} :go/pos {:colon [565 20]}} ["func:fcntl.lockf" "A wrapper around the fcntl() locking calls.\n\nfd is the file descriptor of the file to lock or unlock, and operation\nis one of the following values:\n\n    LOCK_UN - unlock\n    LOCK_SH - acquire a shared lock\n    LOCK_EX - acquire an exclusive lock\n\nWhen operation is LOCK_SH or LOCK_EX, it can also be bitwise ORed with\nLOCK_NB to avoid blocking on lock acquisition.  If LOCK_NB is used and\nthe lock cannot be acquired, an OSError will be raised and the exception\nwill have an errno attribute set to EACCES or EAGAIN (depending on the\noperating system -- for portability, check for either value).\n\nlen is the number of bytes to lock, with the default meaning to lock to\nEOF.  start is the byte offset, relative to whence, to that the lock\nstarts.  whence is as with fileobj.seek(), specifically:\n\n    0 - relative to the start of the file (SEEK_SET)\n    1 - relative to the current buffer position (SEEK_CUR)\n    2 - relative to the end of the file (SEEK_END)"]
    ^{:go/apos {0 [566 2] 1 [566 65]} :go/pos {:colon [566 19]}} ["func:gc.collect" "Run the garbage collector.\n\nWith no arguments, run a full collection.  The optional argument\nmay be an integer specifying which generation to collect.  A ValueError\nis raised if the generation number is invalid.\n\nThe number of unreachable objects is returned."]
    ^{:go/apos {0 [567 2] 1 [567 65]} :go/pos {:colon [567 19]}} ["func:gc.disable" "Disable automatic garbage collection."]
    ^{:go/apos {0 [568 2] 1 [568 65]} :go/pos {:colon [568 18]}} ["func:gc.enable" "Enable automatic garbage collection."]
    ^{:go/apos {0 [569 2] 1 [569 65]} :go/pos {:colon [569 18]}} ["func:gc.freeze" "Freeze all current tracked objects and ignore them for future collections.\n\nThis can be used before a POSIX fork() call to make the gc copy-on-write\nfriendly.\nNote: collection before a POSIX fork() call may free pages for future\nallocation which can cause copy-on-write."]
    ^{:go/apos {0 [570 2] 1 [570 65]} :go/pos {:colon [570 21]}} ["func:gc.get_count" "Return a three-tuple of the current collection counts."]
    ^{:go/apos {0 [571 2] 1 [571 65]} :go/pos {:colon [571 21]}} ["func:gc.get_debug" "Get the garbage collection debugging flags."]
    ^{:go/apos {0 [572 2] 1 [572 65]} :go/pos {:colon [572 28]}} ["func:gc.get_freeze_count" "Return the number of objects in the permanent generation."]
    ^{:go/apos {0 [573 2] 1 [573 65]} :go/pos {:colon [573 23]}} ["func:gc.get_objects" "Return a list of objects tracked by the collector (excluding the list returned).\n\n  generation\n    Generation to extract the objects from.\n\nIf generation is not None, return only the objects tracked by the\ncollector that are in that generation."]
    ^{:go/apos {0 [574 2] 1 [574 65]} :go/pos {:colon [574 25]}} ["func:gc.get_referents" "Return the list of objects that are directly referred to by 'objs'."]
    ^{:go/apos {0 [575 2] 1 [575 65]} :go/pos {:colon [575 25]}} ["func:gc.get_referrers" "Return the list of objects that directly refer to any of 'objs'."]
    ^{:go/apos {0 [576 2] 1 [576 65]} :go/pos {:colon [576 21]}} ["func:gc.get_stats" "Return a list of dictionaries containing per-generation statistics."]
    ^{:go/apos {0 [577 2] 1 [577 65]} :go/pos {:colon [577 25]}} ["func:gc.get_threshold" "Return the current collection thresholds."]
    ^{:go/apos {0 [578 2] 1 [578 65]} :go/pos {:colon [578 24]}} ["func:gc.is_finalized" "Returns true if the object has been already finalized by the GC."]
    ^{:go/apos {0 [579 2] 1 [579 65]} :go/pos {:colon [579 22]}} ["func:gc.is_tracked" "Returns true if the object is tracked by the garbage collector.\n\nSimple atomic objects will return false."]
    ^{:go/apos {0 [580 2] 1 [580 65]} :go/pos {:colon [580 21]}} ["func:gc.isenabled" "Returns true if automatic garbage collection is enabled."]
    ^{:go/apos {0 [581 2] 1 [581 65]} :go/pos {:colon [581 21]}} ["func:gc.set_debug" "Set the garbage collection debugging flags.\n\n  flags\n    An integer that can have the following bits turned on:\n      DEBUG_STATS - Print statistics during collection.\n      DEBUG_COLLECTABLE - Print collectable objects found.\n      DEBUG_UNCOLLECTABLE - Print unreachable but uncollectable objects\n        found.\n      DEBUG_SAVEALL - Save objects to gc.garbage rather than freeing them.\n      DEBUG_LEAK - Debug leaking programs (everything but STATS).\n\nDebugging information is written to sys.stderr."]
    ^{:go/apos {0 [582 2] 1 [582 65]} :go/pos {:colon [582 25]}} ["func:gc.set_threshold" "set_threshold(threshold0, [threshold1, [threshold2]])\nSet the collection thresholds (the collection frequency).\n\nSetting 'threshold0' to zero disables collection."]
    ^{:go/apos {0 [583 2] 1 [583 65]} :go/pos {:colon [583 20]}} ["func:gc.unfreeze" "Unfreeze all objects in the permanent generation.\n\nPut all objects in the permanent generation back into oldest generation."]
    ^{:go/apos {0 [584 2] 1 [584 65]} :go/pos {:colon [584 21]}} ["func:grp.getgrall" "Return a list of all available group entries, in arbitrary order.\n\nAn entry whose name starts with '+' or '-' represents an instruction\nto use YP/NIS and may not be accessible via getgrnam or getgrgid."]
    ^{:go/apos {0 [585 2] 1 [585 65]} :go/pos {:colon [585 21]}} ["func:grp.getgrgid" "Return the group database entry for the given numeric group ID.\n\nIf id is not valid, raise KeyError."]
    ^{:go/apos {0 [586 2] 1 [586 65]} :go/pos {:colon [586 21]}} ["func:grp.getgrnam" "Return the group database entry for the given group name.\n\nIf name is not valid, raise KeyError."]
    ^{:go/apos {0 [587 2] 1 [587 65]} :go/pos {:colon [587 22]}} ["func:itertools.tee" "Returns a tuple of n independent iterators."]
    ^{:go/apos {0 [588 2] 1 [588 65]} :go/pos {:colon [588 21]}} ["func:marshal.dump" "Write the value on the open file.\n\n  value\n    Must be a supported type.\n  file\n    Must be a writeable binary file.\n  version\n    Indicates the data format that dump should use.\n  allow_code\n    Allow to write code objects.\n\nIf the value has (or contains an object that has) an unsupported type, a\nValueError exception is raised - but garbage data will also be written\nto the file. The object will not be properly read back by load()."]
    ^{:go/apos {0 [589 2] 1 [589 65]} :go/pos {:colon [589 22]}} ["func:marshal.dumps" "Return the bytes object that would be written to a file by dump(value, file).\n\n  value\n    Must be a supported type.\n  version\n    Indicates the data format that dumps should use.\n  allow_code\n    Allow to write code objects.\n\nRaise a ValueError exception if value has (or contains an object that\nhas) an unsupported type."]
    ^{:go/apos {0 [590 2] 1 [590 65]} :go/pos {:colon [590 21]}} ["func:marshal.load" "Read one value from the open file and return it.\n\n  file\n    Must be readable binary file.\n  allow_code\n    Allow to load code objects.\n\nIf no valid value is read (e.g. because the data has a different Python\nversion's incompatible marshal format), raise EOFError, ValueError or\nTypeError.\n\nNote: If an object containing an unsupported type was marshalled with\ndump(), load() will substitute None for the unmarshallable type."]
    ^{:go/apos {0 [591 2] 1 [591 65]} :go/pos {:colon [591 22]}} ["func:marshal.loads" "Convert the bytes-like object to a value.\n\n  allow_code\n    Allow to load code objects.\n\nIf no valid value is found, raise EOFError, ValueError or TypeError.\nExtra bytes in the input are ignored."]
    ^{:go/apos {0 [592 2] 1 [592 65]} :go/pos {:colon [592 18]}} ["func:math.acos" "Return the arc cosine (measured in radians) of x.\n\nThe result is between 0 and pi."]
    ^{:go/apos {0 [593 2] 1 [593 65]} :go/pos {:colon [593 19]}} ["func:math.acosh" "Return the inverse hyperbolic cosine of x."]
    ^{:go/apos {0 [594 2] 1 [594 65]} :go/pos {:colon [594 18]}} ["func:math.asin" "Return the arc sine (measured in radians) of x.\n\nThe result is between -pi/2 and pi/2."]
    ^{:go/apos {0 [595 2] 1 [595 65]} :go/pos {:colon [595 19]}} ["func:math.asinh" "Return the inverse hyperbolic sine of x."]
    ^{:go/apos {0 [596 2] 1 [596 65]} :go/pos {:colon [596 18]}} ["func:math.atan" "Return the arc tangent (measured in radians) of x.\n\nThe result is between -pi/2 and pi/2."]
    ^{:go/apos {0 [597 2] 1 [597 65]} :go/pos {:colon [597 19]}} ["func:math.atan2" "Return the arc tangent (measured in radians) of y/x.\n\nUnlike atan(y/x), the signs of both x and y are considered."]
    ^{:go/apos {0 [598 2] 1 [598 65]} :go/pos {:colon [598 19]}} ["func:math.atanh" "Return the inverse hyperbolic tangent of x."]
    ^{:go/apos {0 [599 2] 1 [599 65]} :go/pos {:colon [599 18]}} ["func:math.cbrt" "Return the cube root of x."]
    ^{:go/apos {0 [600 2] 1 [600 65]} :go/pos {:colon [600 18]}} ["func:math.ceil" "Return the ceiling of x as an Integral.\n\nThis is the smallest integer >= x."]
    ^{:go/apos {0 [601 2] 1 [601 65]} :go/pos {:colon [601 18]}} ["func:math.comb" "Number of ways to choose k items from n items without repetition and without order.\n\nEvaluates to n! / (k! * (n - k)!) when k <= n and evaluates\nto zero when k > n.\n\nAlso called the binomial coefficient because it is equivalent\nto the coefficient of k-th term in polynomial expansion of the\nexpression (1 + x)**n.\n\nRaises TypeError if either of the arguments are not integers.\nRaises ValueError if either of the arguments are negative."]
    ^{:go/apos {0 [602 2] 1 [602 65]} :go/pos {:colon [602 22]}} ["func:math.copysign" "Return a float with the magnitude (absolute value) of x but the sign of y.\n\nOn platforms that support signed zeros, copysign(1.0, -0.0)\nreturns -1.0.\n"]
    ^{:go/apos {0 [603 2] 1 [603 65]} :go/pos {:colon [603 17]}} ["func:math.cos" "Return the cosine of x (measured in radians)."]
    ^{:go/apos {0 [604 2] 1 [604 65]} :go/pos {:colon [604 18]}} ["func:math.cosh" "Return the hyperbolic cosine of x."]
    ^{:go/apos {0 [605 2] 1 [605 65]} :go/pos {:colon [605 21]}} ["func:math.degrees" "Convert angle x from radians to degrees."]
    ^{:go/apos {0 [606 2] 1 [606 65]} :go/pos {:colon [606 18]}} ["func:math.dist" "Return the Euclidean distance between two points p and q.\n\nThe points should be specified as sequences (or iterables) of\ncoordinates.  Both inputs must have the same dimension.\n\nRoughly equivalent to:\n    sqrt(sum((px - qx) ** 2.0 for px, qx in zip(p, q)))"]
    ^{:go/apos {0 [607 2] 1 [607 65]} :go/pos {:colon [607 17]}} ["func:math.erf" "Error function at x."]
    ^{:go/apos {0 [608 2] 1 [608 65]} :go/pos {:colon [608 18]}} ["func:math.erfc" "Complementary error function at x."]
    ^{:go/apos {0 [609 2] 1 [609 65]} :go/pos {:colon [609 17]}} ["func:math.exp" "Return e raised to the power of x."]
    ^{:go/apos {0 [610 2] 1 [610 65]} :go/pos {:colon [610 18]}} ["func:math.exp2" "Return 2 raised to the power of x."]
    ^{:go/apos {0 [611 2] 1 [611 65]} :go/pos {:colon [611 19]}} ["func:math.expm1" "Return exp(x)-1.\n\nThis function avoids the loss of precision involved in the direct evaluation of exp(x)-1 for small x."]
    ^{:go/apos {0 [612 2] 1 [612 65]} :go/pos {:colon [612 18]}} ["func:math.fabs" "Return the absolute value of the float x."]
    ^{:go/apos {0 [613 2] 1 [613 65]} :go/pos {:colon [613 23]}} ["func:math.factorial" "Find n!."]
    ^{:go/apos {0 [614 2] 1 [614 65]} :go/pos {:colon [614 19]}} ["func:math.floor" "Return the floor of x as an Integral.\n\nThis is the largest integer <= x."]
    ^{:go/apos {0 [615 2] 1 [615 65]} :go/pos {:colon [615 17]}} ["func:math.fma" "Fused multiply-add operation.\n\nCompute (x * y) + z with a single round."]
    ^{:go/apos {0 [616 2] 1 [616 65]} :go/pos {:colon [616 18]}} ["func:math.fmod" "Return fmod(x, y), according to platform C.\n\nx % y may differ."]
    ^{:go/apos {0 [617 2] 1 [617 65]} :go/pos {:colon [617 19]}} ["func:math.frexp" "Return the mantissa and exponent of x, as pair (m, e).\n\nIf x is a finite nonzero number, then m is a float with\n0.5 <= abs(m) < 1.0 and an integer e is such that\nx == m * 2**e exactly.  Else, return (x, 0)."]
    ^{:go/apos {0 [618 2] 1 [618 65]} :go/pos {:colon [618 18]}} ["func:math.fsum" "Return an accurate floating-point sum of values in the iterable seq.\n\nAssumes IEEE-754 floating-point arithmetic."]
    ^{:go/apos {0 [619 2] 1 [619 65]} :go/pos {:colon [619 19]}} ["func:math.gamma" "Gamma function at x."]
    ^{:go/apos {0 [620 2] 1 [620 65]} :go/pos {:colon [620 17]}} ["func:math.gcd" "Greatest Common Divisor."]
    ^{:go/apos {0 [621 2] 1 [621 65]} :go/pos {:colon [621 19]}} ["func:math.hypot" "Multidimensional Euclidean distance from the origin to a point.\n\nRoughly equivalent to:\n    sqrt(sum(x**2 for x in coordinates))\n\nFor a two dimensional point (x, y), gives the hypotenuse\nusing the Pythagorean theorem:  sqrt(x*x + y*y).\n\nFor example, the hypotenuse of a 3/4/5 right triangle is:\n\n    >>> hypot(3.0, 4.0)\n    5.0"]
    ^{:go/apos {0 [622 2] 1 [622 65]} :go/pos {:colon [622 21]}} ["func:math.isclose" "Determine whether two floating-point numbers are close in value.\n\n  rel_tol\n    maximum difference for being considered \"close\", relative to the\n    magnitude of the input values\n  abs_tol\n    maximum difference for being considered \"close\", regardless of the\n    magnitude of the input values\n\nReturn True if a is close in value to b, and False otherwise.\n\nFor the values to be considered close, the difference between them\nmust be smaller than at least one of the tolerances.\n\n-inf, inf and NaN behave similarly to the IEEE 754 Standard.  That\nis, NaN is not close to anything, even itself.  inf and -inf are\nonly close to themselves."]
    ^{:go/apos {0 [623 2] 1 [623 65]} :go/pos {:colon [623 22]}} ["func:math.isfinite" "Return True if x is neither an infinity nor a NaN, and False otherwise."]
    ^{:go/apos {0 [624 2] 1 [624 65]} :go/pos {:colon [624 19]}} ["func:math.isinf" "Return True if x is a positive or negative infinity, and False otherwise."]
    ^{:go/apos {0 [625 2] 1 [625 65]} :go/pos {:colon [625 19]}} ["func:math.isnan" "Return True if x is a NaN (not a number), and False otherwise."]
    ^{:go/apos {0 [626 2] 1 [626 65]} :go/pos {:colon [626 19]}} ["func:math.isqrt" "Return the integer part of the square root of the input."]
    ^{:go/apos {0 [627 2] 1 [627 65]} :go/pos {:colon [627 17]}} ["func:math.lcm" "Least Common Multiple."]
    ^{:go/apos {0 [628 2] 1 [628 65]} :go/pos {:colon [628 19]}} ["func:math.ldexp" "Return x * (2**i).\n\nThis is essentially the inverse of frexp()."]
    ^{:go/apos {0 [629 2] 1 [629 65]} :go/pos {:colon [629 20]}} ["func:math.lgamma" "Natural logarithm of absolute value of Gamma function at x."]
    ^{:go/apos {0 [630 2] 1 [630 65]} :go/pos {:colon [630 17]}} ["func:math.log" "log(x, [base=math.e])\nReturn the logarithm of x to the given base.\n\nIf the base is not specified, returns the natural logarithm (base e) of x."]
    ^{:go/apos {0 [631 2] 1 [631 65]} :go/pos {:colon [631 19]}} ["func:math.log10" "Return the base 10 logarithm of x."]
    ^{:go/apos {0 [632 2] 1 [632 65]} :go/pos {:colon [632 19]}} ["func:math.log1p" "Return the natural logarithm of 1+x (base e).\n\nThe result is computed in a way which is accurate for x near zero."]
    ^{:go/apos {0 [633 2] 1 [633 65]} :go/pos {:colon [633 18]}} ["func:math.log2" "Return the base 2 logarithm of x."]
    ^{:go/apos {0 [634 2] 1 [634 65]} :go/pos {:colon [634 18]}} ["func:math.modf" "Return the fractional and integer parts of x.\n\nBoth results carry the sign of x and are floats."]
    ^{:go/apos {0 [635 2] 1 [635 65]} :go/pos {:colon [635 23]}} ["func:math.nextafter" "Return the floating-point value the given number of steps after x towards y.\n\nIf steps is not specified or is None, it defaults to 1.\n\nRaises a TypeError, if x or y is not a double, or if steps is not\nan integer.  Raises ValueError if steps is negative."]
    ^{:go/apos {0 [636 2] 1 [636 65]} :go/pos {:colon [636 18]}} ["func:math.perm" "Number of ways to choose k items from n items without repetition and with order.\n\nEvaluates to n! / (n - k)! when k <= n and evaluates\nto zero when k > n.\n\nIf k is not specified or is None, then k defaults to n\nand the function returns n!.\n\nRaises TypeError if either of the arguments are not integers.\nRaises ValueError if either of the arguments are negative."]
    ^{:go/apos {0 [637 2] 1 [637 65]} :go/pos {:colon [637 17]}} ["func:math.pow" "Return x**y (x to the power of y)."]
    ^{:go/apos {0 [638 2] 1 [638 65]} :go/pos {:colon [638 18]}} ["func:math.prod" "Calculate the product of all the elements in the input iterable.\n\nThe default start value for the product is 1.\n\nWhen the iterable is empty, return the start value.  This function is\nintended specifically for use with numeric values and may reject\nnon-numeric types."]
    ^{:go/apos {0 [639 2] 1 [639 65]} :go/pos {:colon [639 21]}} ["func:math.radians" "Convert angle x from degrees to radians."]
    ^{:go/apos {0 [640 2] 1 [640 65]} :go/pos {:colon [640 23]}} ["func:math.remainder" "Difference between x and the closest integer multiple of y.\n\nReturn x - n*y where n*y is the closest integer multiple of y.\nIn the case where x is exactly halfway between two multiples of\ny, the nearest even value of n is used. The result is always exact."]
    ^{:go/apos {0 [641 2] 1 [641 65]} :go/pos {:colon [641 17]}} ["func:math.sin" "Return the sine of x (measured in radians)."]
    ^{:go/apos {0 [642 2] 1 [642 65]} :go/pos {:colon [642 18]}} ["func:math.sinh" "Return the hyperbolic sine of x."]
    ^{:go/apos {0 [643 2] 1 [643 65]} :go/pos {:colon [643 18]}} ["func:math.sqrt" "Return the square root of x."]
    ^{:go/apos {0 [644 2] 1 [644 65]} :go/pos {:colon [644 21]}} ["func:math.sumprod" "Return the sum of products of values from two iterables p and q.\n\nRoughly equivalent to:\n\n    sum(map(operator.mul, p, q, strict=True))\n\nFor float and mixed int/float inputs, the intermediate products\nand sums are computed with extended precision."]
    ^{:go/apos {0 [645 2] 1 [645 65]} :go/pos {:colon [645 17]}} ["func:math.tan" "Return the tangent of x (measured in radians)."]
    ^{:go/apos {0 [646 2] 1 [646 65]} :go/pos {:colon [646 18]}} ["func:math.tanh" "Return the hyperbolic tangent of x."]
    ^{:go/apos {0 [647 2] 1 [647 65]} :go/pos {:colon [647 19]}} ["func:math.trunc" "Truncates the Real x to the nearest Integral toward 0.\n\nUses the __trunc__ magic method."]
    ^{:go/apos {0 [648 2] 1 [648 65]} :go/pos {:colon [648 17]}} ["func:math.ulp" "Return the value of the least significant bit of the float x."]
    ^{:go/apos {0 [649 2] 1 [649 65]} :go/pos {:colon [649 24]}} ["func:posix.WCOREDUMP" "Return True if the process returning status was dumped to a core file."]
    ^{:go/apos {0 [650 2] 1 [650 65]} :go/pos {:colon [650 26]}} ["func:posix.WEXITSTATUS" "Return the process return code from status."]
    ^{:go/apos {0 [651 2] 1 [651 65]} :go/pos {:colon [651 27]}} ["func:posix.WIFCONTINUED" "Return True if a particular process was continued from a job control stop.\n\nReturn True if the process returning status was continued from a\njob control stop."]
    ^{:go/apos {0 [652 2] 1 [652 65]} :go/pos {:colon [652 24]}} ["func:posix.WIFEXITED" "Return True if the process returning status exited via the exit() system call."]
    ^{:go/apos {0 [653 2] 1 [653 65]} :go/pos {:colon [653 26]}} ["func:posix.WIFSIGNALED" "Return True if the process returning status was terminated by a signal."]
    ^{:go/apos {0 [654 2] 1 [654 65]} :go/pos {:colon [654 25]}} ["func:posix.WIFSTOPPED" "Return True if the process returning status was stopped."]
    ^{:go/apos {0 [655 2] 1 [655 65]} :go/pos {:colon [655 23]}} ["func:posix.WSTOPSIG" "Return the signal that stopped the process that provided the status value."]
    ^{:go/apos {0 [656 2] 1 [656 65]} :go/pos {:colon [656 23]}} ["func:posix.WTERMSIG" "Return the signal that terminated the process that provided the status value."]
    ^{:go/apos {0 [657 2] 1 [657 65]} :go/pos {:colon [657 30]}} ["func:posix._create_environ" "Create the environment dictionary."]
    ^{:go/apos {0 [658 2] 1 [658 65]} :go/pos {:colon [658 20]}} ["func:posix._exit" "Exit to the system with specified status, without normal exit processing."]
    ^{:go/apos {0 [659 2] 1 [659 65]} :go/pos {:colon [659 25]}} ["func:posix._inputhook" "Calls PyOS_CallInputHook droppong the GIL first"]
    ^{:go/apos {0 [660 2] 1 [660 65]} :go/pos {:colon [660 38]}} ["func:posix._is_inputhook_installed" "Checks if PyOS_CallInputHook is set"]
    ^{:go/apos {0 [661 2] 1 [661 65]} :go/pos {:colon [661 29]}} ["func:posix._path_normpath" "Normalize path, eliminating double slashes, etc."]
    ^{:go/apos {0 [662 2] 1 [662 65]} :go/pos {:colon [662 33]}} ["func:posix._path_splitroot_ex" "Split a pathname into drive, root and tail.\n\nThe tail contains anything after the root."]
    ^{:go/apos {0 [663 2] 1 [663 65]} :go/pos {:colon [663 20]}} ["func:posix.abort" "Abort the interpreter immediately.\n\nThis function 'dumps core' or otherwise fails in the hardest way\npossible on the hosting operating system.  This function never returns."]
    ^{:go/apos {0 [664 2] 1 [664 65]} :go/pos {:colon [664 21]}} ["func:posix.access" "Use the real uid/gid to test for access to a path.\n\n  path\n    Path to be tested; can be string, bytes, or a path-like object.\n  mode\n    Operating-system mode bitfield.  Can be F_OK to test existence,\n    or the inclusive-OR of R_OK, W_OK, and X_OK.\n  dir_fd\n    If not None, it should be a file descriptor open to a directory,\n    and path should be relative; path will then be relative to that\n    directory.\n  effective_ids\n    If True, access will use the effective uid/gid instead of\n    the real uid/gid.\n  follow_symlinks\n    If False, and the last element of the path is a symbolic link,\n    access will examine the symbolic link itself instead of the file\n    the link points to.\n\ndir_fd, effective_ids, and follow_symlinks may not be implemented\n  on your platform.  If they are unavailable, using them will raise a\n  NotImplementedError.\n\nNote that most operations will use the effective uid/gid, therefore this\n  routine can be used in a suid/sgid environment to test if the invoking user\n  has the specified access to the path."]
    ^{:go/apos {0 [665 2] 1 [665 65]} :go/pos {:colon [665 20]}} ["func:posix.chdir" "Change the current working directory to the specified path.\n\npath may always be specified as a string.  On some platforms, path may\nalso be specified as an open file descriptor.  If this functionality is\nunavailable, using it raises an exception."]
    ^{:go/apos {0 [666 2] 1 [666 65]} :go/pos {:colon [666 20]}} ["func:posix.chmod" "Change the access permissions of a file.\n\n  path\n    Path to be modified.  May always be specified as a str, bytes, or\n    a path-like object.  On some platforms, path may also be specified\n    as an open file descriptor.  If this functionality is unavailable,\n    using it raises an exception.\n  mode\n    Operating-system mode bitfield.\n    Be careful when using number literals for *mode*. The conventional\n    UNIX notation for numeric modes uses an octal base, which needs to\n    be indicated with a ``0o`` prefix in Python.\n  dir_fd\n    If not None, it should be a file descriptor open to a directory,\n    and path should be relative; path will then be relative to that\n    directory.\n  follow_symlinks\n    If False, and the last element of the path is a symbolic link,\n    chmod will modify the symbolic link itself instead of the file\n    the link points to.\n\nIt is an error to use dir_fd or follow_symlinks when specifying path as\n  an open file descriptor.\ndir_fd and follow_symlinks may not be implemented on your platform.\n  If they are unavailable, using them will raise a NotImplementedError."]
    ^{:go/apos {0 [667 2] 1 [667 65]} :go/pos {:colon [667 20]}} ["func:posix.chown" "Change the owner and group id of path to the numeric uid and gid.\n\n  path\n    Path to be examined; can be string, bytes, a path-like object, or\n    open-file-descriptor int.\n  dir_fd\n    If not None, it should be a file descriptor open to a directory,\n    and path should be relative; path will then be relative to that\n    directory.\n  follow_symlinks\n    If False, and the last element of the path is a symbolic link,\n    stat will examine the symbolic link itself instead of the file\n    the link points to.\n\npath may always be specified as a string.  On some platforms, path may\nalso be specified as an open file descriptor.  If this functionality is\nunavailable, using it raises an exception.\nIf dir_fd is not None, it should be a file descriptor open to\na directory, and path should be relative; path will then be relative to\nthat directory.\nIf follow_symlinks is False, and the last element of the path is\na symbolic link, chown will modify the symbolic link itself instead of\nthe file the link points to.\nIt is an error to use dir_fd or follow_symlinks when specifying path as\nan open file descriptor.\ndir_fd and follow_symlinks may not be implemented on your platform.  If\nthey are unavailable, using them will raise a NotImplementedError."]
    ^{:go/apos {0 [668 2] 1 [668 65]} :go/pos {:colon [668 21]}} ["func:posix.chroot" "Change root directory to path."]
    ^{:go/apos {0 [669 2] 1 [669 65]} :go/pos {:colon [669 20]}} ["func:posix.close" "Close a file descriptor."]
    ^{:go/apos {0 [670 2] 1 [670 65]} :go/pos {:colon [670 25]}} ["func:posix.closerange" "Closes all file descriptors in [fd_low, fd_high), ignoring errors."]
    ^{:go/apos {0 [671 2] 1 [671 65]} :go/pos {:colon [671 22]}} ["func:posix.confstr" "Return a string-valued system configuration variable."]
    ^{:go/apos {0 [672 2] 1 [672 65]} :go/pos {:colon [672 30]}} ["func:posix.copy_file_range" "Copy count bytes from one file descriptor to another.\n\n  src\n    Source file descriptor.\n  dst\n    Destination file descriptor.\n  count\n    Number of bytes to copy.\n  offset_src\n    Starting offset in src.\n  offset_dst\n    Starting offset in dst.\n\nIf offset_src is None, then src is read from the current position;\nrespectively for offset_dst."]
    ^{:go/apos {0 [673 2] 1 [673 65]} :go/pos {:colon [673 24]}} ["func:posix.cpu_count" "Return the number of logical CPUs in the system.\n\nReturn None if indeterminable."]
    ^{:go/apos {0 [674 2] 1 [674 65]} :go/pos {:colon [674 22]}} ["func:posix.ctermid" "Return the name of the controlling terminal for this process."]
    ^{:go/apos {0 [675 2] 1 [675 65]} :go/pos {:colon [675 30]}} ["func:posix.device_encoding" "Return a string describing the encoding of a terminal's file descriptor.\n\nThe file descriptor must be attached to a terminal.\nIf the device is not a terminal, return None."]
    ^{:go/apos {0 [676 2] 1 [676 65]} :go/pos {:colon [676 18]}} ["func:posix.dup" "Return a duplicate of a file descriptor."]
    ^{:go/apos {0 [677 2] 1 [677 65]} :go/pos {:colon [677 19]}} ["func:posix.dup2" "Duplicate file descriptor."]
    ^{:go/apos {0 [678 2] 1 [678 65]} :go/pos {:colon [678 22]}} ["func:posix.eventfd" "Creates and returns an event notification file descriptor."]
    ^{:go/apos {0 [679 2] 1 [679 65]} :go/pos {:colon [679 27]}} ["func:posix.eventfd_read" "Read eventfd value"]
    ^{:go/apos {0 [680 2] 1 [680 65]} :go/pos {:colon [680 28]}} ["func:posix.eventfd_write" "Write eventfd value."]
    ^{:go/apos {0 [681 2] 1 [681 65]} :go/pos {:colon [681 20]}} ["func:posix.execv" "Execute an executable path with arguments, replacing current process.\n\n  path\n    Path of executable file.\n  argv\n    Tuple or list of strings."]
    ^{:go/apos {0 [682 2] 1 [682 65]} :go/pos {:colon [682 21]}} ["func:posix.execve" "Execute an executable path with arguments, replacing current process.\n\n  path\n    Path of executable file.\n  argv\n    Tuple or list of strings.\n  env\n    Dictionary of strings mapping to strings."]
    ^{:go/apos {0 [683 2] 1 [683 65]} :go/pos {:colon [683 21]}} ["func:posix.fchdir" "Change to the directory of the given file descriptor.\n\nfd must be opened on a directory, not a file.\nEquivalent to os.chdir(fd)."]
    ^{:go/apos {0 [684 2] 1 [684 65]} :go/pos {:colon [684 21]}} ["func:posix.fchmod" "Change the access permissions of the file given by file descriptor fd.\n\n  fd\n    The file descriptor of the file to be modified.\n  mode\n    Operating-system mode bitfield.\n    Be careful when using number literals for *mode*.  The conventional\n    UNIX notation for numeric modes uses an octal base, which needs to\n    be indicated with a ``0o`` prefix in Python.\n\nEquivalent to os.chmod(fd, mode)."]
    ^{:go/apos {0 [685 2] 1 [685 65]} :go/pos {:colon [685 21]}} ["func:posix.fchown" "Change the owner and group id of the file specified by file descriptor.\n\nEquivalent to os.chown(fd, uid, gid)."]
    ^{:go/apos {0 [686 2] 1 [686 65]} :go/pos {:colon [686 24]}} ["func:posix.fdatasync" "Force write of fd to disk without forcing update of metadata."]
    ^{:go/apos {0 [687 2] 1 [687 65]} :go/pos {:colon [687 19]}} ["func:posix.fork" "Fork a child process.\n\nReturn 0 to child process and PID of child to parent process."]
    ^{:go/apos {0 [688 2] 1 [688 65]} :go/pos {:colon [688 22]}} ["func:posix.forkpty" "Fork a new process with a new pseudo-terminal as controlling tty.\n\nReturns a tuple of (pid, master_fd).\nLike fork(), return pid of 0 to the child process,\nand pid of child to the parent process.\nTo both, return fd of newly opened pseudo-terminal."]
    ^{:go/apos {0 [689 2] 1 [689 65]} :go/pos {:colon [689 24]}} ["func:posix.fpathconf" "Return the configuration limit name for the file descriptor fd.\n\nIf there is no limit, return -1."]
    ^{:go/apos {0 [690 2] 1 [690 65]} :go/pos {:colon [690 21]}} ["func:posix.fspath" "Return the file system path representation of the object.\n\nIf the object is str or bytes, then allow it to pass through as-is.  If\nthe object defines __fspath__(), then return the result of that method.\nAll other types raise a TypeError."]
    ^{:go/apos {0 [691 2] 1 [691 65]} :go/pos {:colon [691 20]}} ["func:posix.fstat" "Perform a stat system call on the given file descriptor.\n\nLike stat(), but for an open file descriptor.\nEquivalent to os.stat(fd)."]
    ^{:go/apos {0 [692 2] 1 [692 65]} :go/pos {:colon [692 23]}} ["func:posix.fstatvfs" "Perform an fstatvfs system call on the given fd.\n\nEquivalent to statvfs(fd)."]
    ^{:go/apos {0 [693 2] 1 [693 65]} :go/pos {:colon [693 20]}} ["func:posix.fsync" "Force write of fd to disk."]
    ^{:go/apos {0 [694 2] 1 [694 65]} :go/pos {:colon [694 24]}} ["func:posix.ftruncate" "Truncate a file, specified by file descriptor, to a specific length."]
    ^{:go/apos {0 [695 2] 1 [695 65]} :go/pos {:colon [695 27]}} ["func:posix.get_blocking" "Get the blocking mode of the file descriptor.\n\nReturn False if the O_NONBLOCK flag is set, True if the flag is cleared."]
    ^{:go/apos {0 [696 2] 1 [696 65]} :go/pos {:colon [696 30]}} ["func:posix.get_inheritable" "Get the close-on-exe flag of the specified file descriptor."]
    ^{:go/apos {0 [697 2] 1 [697 65]} :go/pos {:colon [697 32]}} ["func:posix.get_terminal_size" "Return the size of the terminal window as (columns, lines).\n\nThe optional argument fd (default standard output) specifies\nwhich file descriptor should be queried.\n\nIf the file descriptor is not connected to a terminal, an OSError\nis thrown.\n\nThis function will only be defined if an implementation is\navailable for this system.\n\nshutil.get_terminal_size is the high-level function which should\nnormally be used, os.get_terminal_size is the low-level implementation."]
    ^{:go/apos {0 [698 2] 1 [698 65]} :go/pos {:colon [698 21]}} ["func:posix.getcwd" "Return a unicode string representing the current working directory."]
    ^{:go/apos {0 [699 2] 1 [699 65]} :go/pos {:colon [699 22]}} ["func:posix.getcwdb" "Return a bytes string representing the current working directory."]
    ^{:go/apos {0 [700 2] 1 [700 65]} :go/pos {:colon [700 22]}} ["func:posix.getegid" "Return the current process's effective group id."]
    ^{:go/apos {0 [701 2] 1 [701 65]} :go/pos {:colon [701 22]}} ["func:posix.geteuid" "Return the current process's effective user id."]
    ^{:go/apos {0 [702 2] 1 [702 65]} :go/pos {:colon [702 21]}} ["func:posix.getgid" "Return the current process's group id."]
    ^{:go/apos {0 [703 2] 1 [703 65]} :go/pos {:colon [703 27]}} ["func:posix.getgrouplist" "Returns a list of groups to which a user belongs.\n\n  user\n    username to lookup\n  group\n    base group id of the user"]
    ^{:go/apos {0 [704 2] 1 [704 65]} :go/pos {:colon [704 24]}} ["func:posix.getgroups" "Return list of supplemental group IDs for the process."]
    ^{:go/apos {0 [705 2] 1 [705 65]} :go/pos {:colon [705 25]}} ["func:posix.getloadavg" "Return average recent system load information.\n\nReturn the number of processes in the system run queue averaged over\nthe last 1, 5, and 15 minutes as a tuple of three floats.\nRaises OSError if the load average was unobtainable."]
    ^{:go/apos {0 [706 2] 1 [706 65]} :go/pos {:colon [706 23]}} ["func:posix.getlogin" "Return the actual login name."]
    ^{:go/apos {0 [707 2] 1 [707 65]} :go/pos {:colon [707 22]}} ["func:posix.getpgid" "Call the system call getpgid(), and return the result."]
    ^{:go/apos {0 [708 2] 1 [708 65]} :go/pos {:colon [708 22]}} ["func:posix.getpgrp" "Return the current process group id."]
    ^{:go/apos {0 [709 2] 1 [709 65]} :go/pos {:colon [709 21]}} ["func:posix.getpid" "Return the current process id."]
    ^{:go/apos {0 [710 2] 1 [710 65]} :go/pos {:colon [710 22]}} ["func:posix.getppid" "Return the parent's process id.\n\nIf the parent process has already exited, Windows machines will still\nreturn its id; others systems will return the id of the 'init' proces\n(1)."]
    ^{:go/apos {0 [711 2] 1 [711 65]} :go/pos {:colon [711 26]}} ["func:posix.getpriority" "Return program scheduling priority."]
    ^{:go/apos {0 [712 2] 1 [712 65]} :go/pos {:colon [712 24]}} ["func:posix.getrandom" "Obtain a series of random bytes."]
    ^{:go/apos {0 [713 2] 1 [713 65]} :go/pos {:colon [713 24]}} ["func:posix.getresgid" "Return a tuple of the current process's real, effective, and saved group ids."]
    ^{:go/apos {0 [714 2] 1 [714 65]} :go/pos {:colon [714 24]}} ["func:posix.getresuid" "Return a tuple of the current process's real, effective, and saved user ids."]
    ^{:go/apos {0 [715 2] 1 [715 65]} :go/pos {:colon [715 21]}} ["func:posix.getsid" "Call the system call getsid(pid) and return the result."]
    ^{:go/apos {0 [716 2] 1 [716 65]} :go/pos {:colon [716 21]}} ["func:posix.getuid" "Return the current process's user id."]
    ^{:go/apos {0 [717 2] 1 [717 65]} :go/pos {:colon [717 23]}} ["func:posix.getxattr" "Return the value of extended attribute attribute on path.\n\npath may be either a string, a path-like object, or an open file\ndescriptor.\nIf follow_symlinks is False, and the last element of the path is\na symbolic link, getxattr will examine the symbolic link itself\ninstead of the file the link points to."]
    ^{:go/apos {0 [718 2] 1 [718 65]} :go/pos {:colon [718 22]}} ["func:posix.grantpt" "Grant access to the slave pseudo-terminal device.\n\n  fd\n    File descriptor of a master pseudo-terminal device.\n\nPerforms a grantpt() C function call."]
    ^{:go/apos {0 [719 2] 1 [719 65]} :go/pos {:colon [719 25]}} ["func:posix.initgroups" "Initialize the group access list.\n\nCall the system initgroups() to initialize the group access list with\nall of the groups of which the specified username is a member, plus the\nspecified group id."]
    ^{:go/apos {0 [720 2] 1 [720 65]} :go/pos {:colon [720 21]}} ["func:posix.isatty" "Return True if the fd is connected to a terminal.\n\nReturn True if the file descriptor is an open file descriptor\nconnected to the slave end of a terminal."]
    ^{:go/apos {0 [721 2] 1 [721 65]} :go/pos {:colon [721 19]}} ["func:posix.kill" "Kill a process with a signal."]
    ^{:go/apos {0 [722 2] 1 [722 65]} :go/pos {:colon [722 21]}} ["func:posix.killpg" "Kill a process group with a signal."]
    ^{:go/apos {0 [723 2] 1 [723 65]} :go/pos {:colon [723 21]}} ["func:posix.lchown" "Change the owner and group id of path to the numeric uid and gid.\n\nThis function will not follow symbolic links.\nEquivalent to os.chown(path, uid, gid, follow_symlinks=False)."]
    ^{:go/apos {0 [724 2] 1 [724 65]} :go/pos {:colon [724 19]}} ["func:posix.link" "Create a hard link to a file.\n\nIf either src_dir_fd or dst_dir_fd is not None, it should be a file\ndescriptor open to a directory, and the respective path string (src or\ndst) should be relative; the path will then be relative to that\ndirectory.\nIf follow_symlinks is False, and the last element of src is a symbolic\nlink, link will create a link to the symbolic link itself instead of the\nfile the link points to.\nsrc_dir_fd, dst_dir_fd, and follow_symlinks may not be implemented on\nyour platform.  If they are unavailable, using them will raise\na NotImplementedError."]
    ^{:go/apos {0 [725 2] 1 [725 65]} :go/pos {:colon [725 22]}} ["func:posix.listdir" "Return a list containing the names of the files in the directory.\n\npath can be specified as either str, bytes, or a path-like object.  If\npath is bytes, the filenames returned will also be bytes; in all other\ncircumstances the filenames returned will be str.\nIf path is None, uses the path='.'.\nOn some platforms, path may also be specified as an open file\ndescriptor; the file descriptor must refer to a directory.  If this\nfunctionality is unavailable, using it raises NotImplementedError.\n\nThe list is in arbitrary order.  It does not include the special\nentries '.' and '..' even if they are present in the directory."]
    ^{:go/apos {0 [726 2] 1 [726 65]} :go/pos {:colon [726 24]}} ["func:posix.listxattr" "Return a list of extended attributes on path.\n\npath may be either None, a string, a path-like object, or an open file\ndescriptor.  If path is None, listxattr will examine the current\ndirectory.\nIf follow_symlinks is False, and the last element of the path is\na symbolic link, listxattr will examine the symbolic link itself instead\nof the file the link points to."]
    ^{:go/apos {0 [727 2] 1 [727 65]} :go/pos {:colon [727 20]}} ["func:posix.lockf" "Apply, test or remove a POSIX lock on an open file descriptor.\n\n  fd\n    An open file descriptor.\n  command\n    One of F_LOCK, F_TLOCK, F_ULOCK or F_TEST.\n  length\n    The number of bytes to lock, starting at the current position."]
    ^{:go/apos {0 [728 2] 1 [728 65]} :go/pos {:colon [728 24]}} ["func:posix.login_tty" "Prepare the tty of which fd is a file descriptor for a new login session.\n\nMake the calling process a session leader; make the tty the\ncontrolling tty, the stdin, the stdout, and the stderr of the\ncalling process; close fd."]
    ^{:go/apos {0 [729 2] 1 [729 65]} :go/pos {:colon [729 20]}} ["func:posix.lseek" "Set the position of a file descriptor.  Return the new position.\n\n  fd\n    An open file descriptor, as returned by os.open().\n  position\n    Position, interpreted relative to 'whence'.\n  whence\n    The relative position to seek from. Valid values are:\n    - SEEK_SET: seek from the start of the file.\n    - SEEK_CUR: seek from the current file position.\n    - SEEK_END: seek from the end of the file.\n\nThe return value is the number of bytes relative to the beginning of\nthe file."]
    ^{:go/apos {0 [730 2] 1 [730 65]} :go/pos {:colon [730 20]}} ["func:posix.lstat" "Perform a stat system call on the given path, without following symbolic links.\n\nLike stat(), but do not follow symbolic links.\nEquivalent to stat(path, follow_symlinks=False)."]
    ^{:go/apos {0 [731 2] 1 [731 65]} :go/pos {:colon [731 20]}} ["func:posix.major" "Extracts a device major number from a raw device number."]
    ^{:go/apos {0 [732 2] 1 [732 65]} :go/pos {:colon [732 22]}} ["func:posix.makedev" "Composes a raw device number from the major and minor device numbers."]
    ^{:go/apos {0 [733 2] 1 [733 65]} :go/pos {:colon [733 20]}} ["func:posix.minor" "Extracts a device minor number from a raw device number."]
    ^{:go/apos {0 [734 2] 1 [734 65]} :go/pos {:colon [734 20]}} ["func:posix.mkdir" "Create a directory.\n\nIf dir_fd is not None, it should be a file descriptor open to\na directory, and path should be relative; path will then be relative to\nthat directory.\ndir_fd may not be implemented on your platform.  If it is unavailable,\nusing it will raise a NotImplementedError.\n\nThe mode argument is ignored on Windows.  Where it is used, the current\numask value is first masked out."]
    ^{:go/apos {0 [735 2] 1 [735 65]} :go/pos {:colon [735 21]}} ["func:posix.mkfifo" "Create a \"fifo\" (a POSIX named pipe).\n\nIf dir_fd is not None, it should be a file descriptor open to\na directory, and path should be relative; path will then be relative to\nthat directory.\ndir_fd may not be implemented on your platform.  If it is unavailable,\nusing it will raise a NotImplementedError."]
    ^{:go/apos {0 [736 2] 1 [736 65]} :go/pos {:colon [736 20]}} ["func:posix.mknod" "Create a node in the file system.\n\nCreate a node in the file system (file, device special file or named\npipe) at path.  mode specifies both the permissions to use and the\ntype of node to be created, being combined (bitwise OR) with one of\nS_IFREG, S_IFCHR, S_IFBLK, and S_IFIFO.  If S_IFCHR or S_IFBLK is set\non mode, device defines the newly created device special file (probably\nusing os.makedev()).  Otherwise device is ignored.\n\nIf dir_fd is not None, it should be a file descriptor open to\na directory, and path should be relative; path will then be relative\nto that directory.\ndir_fd may not be implemented on your platform.  If it is unavailable,\nusing it will raise a NotImplementedError."]
    ^{:go/apos {0 [737 2] 1 [737 65]} :go/pos {:colon [737 19]}} ["func:posix.nice" "Add increment to the priority of process and return the new priority."]
    ^{:go/apos {0 [738 2] 1 [738 65]} :go/pos {:colon [738 19]}} ["func:posix.open" "Open a file for low level IO.  Returns a file descriptor (integer).\n\nIf dir_fd is not None, it should be a file descriptor open to\na directory, and path should be relative; path will then be relative to\nthat directory.\ndir_fd may not be implemented on your platform.  If it is unavailable,\nusing it will raise a NotImplementedError."]
    ^{:go/apos {0 [739 2] 1 [739 65]} :go/pos {:colon [739 22]}} ["func:posix.openpty" "Open a pseudo-terminal.\n\nReturn a tuple of (master_fd, slave_fd) containing open file descriptors\nfor both the master and slave ends."]
    ^{:go/apos {0 [740 2] 1 [740 65]} :go/pos {:colon [740 23]}} ["func:posix.pathconf" "Return the configuration limit name for the file or directory path.\n\nIf there is no limit, return -1.\nOn some platforms, path may also be specified as an open file\ndescriptor.  If this functionality is unavailable, using it raises\nan exception."]
    ^{:go/apos {0 [741 2] 1 [741 65]} :go/pos {:colon [741 25]}} ["func:posix.pidfd_open" "Return a file descriptor referring to the process *pid*.\n\nThe descriptor can be used to perform process management without races\nand signals."]
    ^{:go/apos {0 [742 2] 1 [742 65]} :go/pos {:colon [742 19]}} ["func:posix.pipe" "Create a pipe.\n\nReturns a tuple of two file descriptors:\n  (read_fd, write_fd)"]
    ^{:go/apos {0 [743 2] 1 [743 65]} :go/pos {:colon [743 20]}} ["func:posix.pipe2" "Create a pipe with flags set atomically.\n\nReturns a tuple of two file descriptors:\n  (read_fd, write_fd)\n\nflags can be constructed by ORing together one or more of these values:\nO_NONBLOCK, O_CLOEXEC."]
    ^{:go/apos {0 [744 2] 1 [744 65]} :go/pos {:colon [744 28]}} ["func:posix.posix_fadvise" "Announce an intention to access data in a specific pattern.\n\nAnnounce an intention to access data in a specific pattern, thus\nallowing the kernel to make optimizations.\nThe advice applies to the region of the file specified by fd starting at\noffset and continuing for length bytes.\nadvice is one of POSIX_FADV_NORMAL, POSIX_FADV_SEQUENTIAL,\nPOSIX_FADV_RANDOM, POSIX_FADV_NOREUSE, POSIX_FADV_WILLNEED, or\nPOSIX_FADV_DONTNEED."]
    ^{:go/apos {0 [745 2] 1 [745 65]} :go/pos {:colon [745 30]}} ["func:posix.posix_fallocate" "Ensure a file has allocated at least a particular number of bytes on disk.\n\nEnsure that the file specified by fd encompasses a range of bytes\nstarting at offset bytes from the beginning and continuing for length\nbytes."]
    ^{:go/apos {0 [746 2] 1 [746 65]} :go/pos {:colon [746 27]}} ["func:posix.posix_openpt" "Open and return a file descriptor for a master pseudo-terminal device.\n\nPerforms a posix_openpt() C function call. The oflag argument is used to\nset file status flags and file access modes as specified in the manual\npage of posix_openpt() of your system."]
    ^{:go/apos {0 [747 2] 1 [747 65]} :go/pos {:colon [747 26]}} ["func:posix.posix_spawn" "Execute the program specified by path in a new process.\n\n  path\n    Path of executable file.\n  argv\n    Tuple or list of strings.\n  env\n    Dictionary of strings mapping to strings.\n  file_actions\n    A sequence of file action tuples.\n  setpgroup\n    The pgroup to use with the POSIX_SPAWN_SETPGROUP flag.\n  resetids\n    If the value is `true` the POSIX_SPAWN_RESETIDS will be activated.\n  setsid\n    If the value is `true` the POSIX_SPAWN_SETSID or POSIX_SPAWN_SETSID_NP\n    will be activated.\n  setsigmask\n    The sigmask to use with the POSIX_SPAWN_SETSIGMASK flag.\n  setsigdef\n    The sigmask to use with the POSIX_SPAWN_SETSIGDEF flag.\n  scheduler\n    A tuple with the scheduler policy (optional) and parameters."]
    ^{:go/apos {0 [748 2] 1 [748 65]} :go/pos {:colon [748 27]}} ["func:posix.posix_spawnp" "Execute the program specified by path in a new process.\n\n  path\n    Path of executable file.\n  argv\n    Tuple or list of strings.\n  env\n    Dictionary of strings mapping to strings.\n  file_actions\n    A sequence of file action tuples.\n  setpgroup\n    The pgroup to use with the POSIX_SPAWN_SETPGROUP flag.\n  resetids\n    If the value is `True` the POSIX_SPAWN_RESETIDS will be activated.\n  setsid\n    If the value is `True` the POSIX_SPAWN_SETSID or POSIX_SPAWN_SETSID_NP\n    will be activated.\n  setsigmask\n    The sigmask to use with the POSIX_SPAWN_SETSIGMASK flag.\n  setsigdef\n    The sigmask to use with the POSIX_SPAWN_SETSIGDEF flag.\n  scheduler\n    A tuple with the scheduler policy (optional) and parameters."]
    ^{:go/apos {0 [749 2] 1 [749 65]} :go/pos {:colon [749 20]}} ["func:posix.pread" "Read a number of bytes from a file descriptor starting at a particular offset.\n\nRead length bytes from file descriptor fd, starting at offset bytes from\nthe beginning of the file.  The file offset remains unchanged."]
    ^{:go/apos {0 [750 2] 1 [750 65]} :go/pos {:colon [750 21]}} ["func:posix.preadv" "Reads from a file descriptor into a number of mutable bytes-like objects.\n\nCombines the functionality of readv() and pread().  As readv(), it will\ntransfer data into each buffer until it is full and then move on to the\nnext buffer in the sequence to hold the rest of the data.  Its fourth\nargument, specifies the file offset at which the input operation is to\nbe performed.  It will return the total number of bytes read (which can\nbe less than the total capacity of all the objects).\n\nThe flags argument contains a bitwise OR of zero or more of the\nfollowing flags:\n\n- RWF_HIPRI\n- RWF_NOWAIT\n\nUsing non-zero flags requires Linux 4.6 or newer."]
    ^{:go/apos {0 [751 2] 1 [751 65]} :go/pos {:colon [751 22]}} ["func:posix.ptsname" "Return the name of the slave pseudo-terminal device.\n\n  fd\n    File descriptor of a master pseudo-terminal device.\n\nIf the ptsname_r() C function is available, it is called;\notherwise, performs a ptsname() C function call."]
    ^{:go/apos {0 [752 2] 1 [752 65]} :go/pos {:colon [752 21]}} ["func:posix.putenv" "Change or add an environment variable."]
    ^{:go/apos {0 [753 2] 1 [753 65]} :go/pos {:colon [753 21]}} ["func:posix.pwrite" "Write bytes to a file descriptor starting at a particular offset.\n\nWrite buffer to fd, starting at offset bytes from the beginning of\nthe file.  Returns the number of bytes written.  Does not change the\ncurrent file offset."]
    ^{:go/apos {0 [754 2] 1 [754 65]} :go/pos {:colon [754 22]}} ["func:posix.pwritev" "Writes the contents of bytes-like objects to a file descriptor at a given offset.\n\nCombines the functionality of writev() and pwrite(). All buffers must be\na sequence of bytes-like objects.  Buffers are processed in array order.\nEntire contents of first buffer is written before proceeding to second,\nand so on. The operating system may set a limit (sysconf() value\nSC_IOV_MAX) on the number of buffers that can be used.\nThis function writes the contents of each object to the file descriptor\nand returns the total number of bytes written.\n\nThe flags argument contains a bitwise OR of zero or more of the\nfollowing flags:\n\n- RWF_DSYNC\n- RWF_SYNC\n- RWF_APPEND\n\nUsing non-zero flags requires Linux 4.7 or newer."]
    ^{:go/apos {0 [755 2] 1 [755 65]} :go/pos {:colon [755 19]}} ["func:posix.read" "Read from a file descriptor.  Returns a bytes object."]
    ^{:go/apos {0 [756 2] 1 [756 65]} :go/pos {:colon [756 23]}} ["func:posix.readinto" "Read into a buffer object from a file descriptor.\n\nThe buffer should be mutable and bytes-like.  On success, returns the\nnumber of bytes read.  Less bytes may be read than the size of the\nbuffer.  The underlying system call will be retried when interrupted by\na signal, unless the signal handler raises an exception.  Other errors\nwill not be retried and an error will be raised.\n\nReturns 0 if *fd* is at end of file or if the provided *buffer* has\nlength 0 (which can be used to check for errors without reading data).\nNever returns negative."]
    ^{:go/apos {0 [757 2] 1 [757 65]} :go/pos {:colon [757 23]}} ["func:posix.readlink" "Return a string representing the path to which the symbolic link points.\n\nIf dir_fd is not None, it should be a file descriptor open to\na directory, and path should be relative; path will then be relative to\nthat directory.\n\ndir_fd may not be implemented on your platform.  If it is unavailable,\nusing it will raise a NotImplementedError."]
    ^{:go/apos {0 [758 2] 1 [758 65]} :go/pos {:colon [758 20]}} ["func:posix.readv" "Read from a file descriptor fd into an iterable of buffers.\n\nThe buffers should be mutable buffers accepting bytes.\nreadv will transfer data into each buffer until it is full\nand then move on to the next buffer in the sequence to hold\nthe rest of the data.\n\nreadv returns the total number of bytes read,\nwhich may be less than the total capacity of all the buffers."]
    ^{:go/apos {0 [759 2] 1 [759 65]} :go/pos {:colon [759 31]}} ["func:posix.register_at_fork" "Register callables to be called when forking a new process.\n\n  before\n    A callable to be called in the parent before the fork() syscall.\n  after_in_child\n    A callable to be called in the child after fork().\n  after_in_parent\n    A callable to be called in the parent after fork().\n\n'before' callbacks are called in reverse order.\n'after_in_child' and 'after_in_parent' callbacks are called in order."]
    ^{:go/apos {0 [760 2] 1 [760 65]} :go/pos {:colon [760 21]}} ["func:posix.remove" "Remove a file (same as unlink()).\n\nIf dir_fd is not None, it should be a file descriptor open to\na directory, and path should be relative; path will then be relative\nto that directory.\ndir_fd may not be implemented on your platform.\nIf it is unavailable, using it will raise a NotImplementedError."]
    ^{:go/apos {0 [761 2] 1 [761 65]} :go/pos {:colon [761 26]}} ["func:posix.removexattr" "Remove extended attribute attribute on path.\n\npath may be either a string, a path-like object, or an open file\ndescriptor.\nIf follow_symlinks is False, and the last element of the path is\na symbolic link, removexattr will modify the symbolic link itself\ninstead of the file the link points to."]
    ^{:go/apos {0 [762 2] 1 [762 65]} :go/pos {:colon [762 21]}} ["func:posix.rename" "Rename a file or directory.\n\nIf either src_dir_fd or dst_dir_fd is not None, it should be a file\ndescriptor open to a directory, and the respective path string (src or\ndst) should be relative; the path will then be relative to that\ndirectory.\nsrc_dir_fd and dst_dir_fd, may not be implemented on your platform.\nIf they are unavailable, using them will raise a NotImplementedError."]
    ^{:go/apos {0 [763 2] 1 [763 65]} :go/pos {:colon [763 22]}} ["func:posix.replace" "Rename a file or directory, overwriting the destination.\n\nIf either src_dir_fd or dst_dir_fd is not None, it should be a file\ndescriptor open to a directory, and the respective path string (src or\ndst) should be relative; the path will then be relative to that\ndirectory.\nsrc_dir_fd and dst_dir_fd, may not be implemented on your platform.\nIf they are unavailable, using them will raise a NotImplementedError."]
    ^{:go/apos {0 [764 2] 1 [764 65]} :go/pos {:colon [764 20]}} ["func:posix.rmdir" "Remove a directory.\n\nIf dir_fd is not None, it should be a file descriptor open to\na directory, and path should be relative; path will then be relative\nto that directory.\ndir_fd may not be implemented on your platform.\nIf it is unavailable, using it will raise a NotImplementedError."]
    ^{:go/apos {0 [765 2] 1 [765 65]} :go/pos {:colon [765 22]}} ["func:posix.scandir" "Return an iterator of DirEntry objects for given path.\n\npath can be specified as either str, bytes, or a path-like object.  If\npath is bytes, the names of yielded DirEntry objects will also be bytes;\nin all other circumstances they will be str.\n\nIf path is None, uses the path='.'."]
    ^{:go/apos {0 [766 2] 1 [766 65]} :go/pos {:colon [766 37]}} ["func:posix.sched_get_priority_max" "Get the maximum scheduling priority for policy."]
    ^{:go/apos {0 [767 2] 1 [767 65]} :go/pos {:colon [767 37]}} ["func:posix.sched_get_priority_min" "Get the minimum scheduling priority for policy."]
    ^{:go/apos {0 [768 2] 1 [768 65]} :go/pos {:colon [768 32]}} ["func:posix.sched_getaffinity" "Return the affinity of the process identified by pid (or the current process if zero).\n\nThe affinity is returned as a set of CPU identifiers."]
    ^{:go/apos {0 [769 2] 1 [769 65]} :go/pos {:colon [769 29]}} ["func:posix.sched_getparam" "Returns scheduling parameters for the process identified by pid.\n\nIf pid is 0, returns parameters for the calling process.\nReturn value is an instance of sched_param."]
    ^{:go/apos {0 [770 2] 1 [770 65]} :go/pos {:colon [770 33]}} ["func:posix.sched_getscheduler" "Get the scheduling policy for the process identified by pid.\n\nPassing 0 for pid returns the scheduling policy for the calling process."]
    ^{:go/apos {0 [771 2] 1 [771 65]} :go/pos {:colon [771 36]}} ["func:posix.sched_rr_get_interval" "Return the round-robin quantum for the process identified by pid, in seconds.\n\nValue returned is a float."]
    ^{:go/apos {0 [772 2] 1 [772 65]} :go/pos {:colon [772 32]}} ["func:posix.sched_setaffinity" "Set the CPU affinity of the process identified by pid to mask.\n\nmask should be an iterable of integers identifying CPUs."]
    ^{:go/apos {0 [773 2] 1 [773 65]} :go/pos {:colon [773 29]}} ["func:posix.sched_setparam" "Set scheduling parameters for the process identified by pid.\n\nIf pid is 0, sets parameters for the calling process.\nparam should be an instance of sched_param."]
    ^{:go/apos {0 [774 2] 1 [774 65]} :go/pos {:colon [774 33]}} ["func:posix.sched_setscheduler" "Set the scheduling policy for the process identified by pid.\n\nIf pid is 0, the calling process is changed.\nparam is an instance of sched_param."]
    ^{:go/apos {0 [775 2] 1 [775 65]} :go/pos {:colon [775 26]}} ["func:posix.sched_yield" "Voluntarily relinquish the CPU."]
    ^{:go/apos {0 [776 2] 1 [776 65]} :go/pos {:colon [776 23]}} ["func:posix.sendfile" "Copy count bytes from file descriptor in_fd to file descriptor out_fd."]
    ^{:go/apos {0 [777 2] 1 [777 65]} :go/pos {:colon [777 27]}} ["func:posix.set_blocking" "Set the blocking mode of the specified file descriptor.\n\nSet the O_NONBLOCK flag if blocking is False,\nclear the O_NONBLOCK flag otherwise."]
    ^{:go/apos {0 [778 2] 1 [778 65]} :go/pos {:colon [778 30]}} ["func:posix.set_inheritable" "Set the inheritable flag of the specified file descriptor."]
    ^{:go/apos {0 [779 2] 1 [779 65]} :go/pos {:colon [779 22]}} ["func:posix.setegid" "Set the current process's effective group id."]
    ^{:go/apos {0 [780 2] 1 [780 65]} :go/pos {:colon [780 22]}} ["func:posix.seteuid" "Set the current process's effective user id."]
    ^{:go/apos {0 [781 2] 1 [781 65]} :go/pos {:colon [781 21]}} ["func:posix.setgid" "Set the current process's group id."]
    ^{:go/apos {0 [782 2] 1 [782 65]} :go/pos {:colon [782 24]}} ["func:posix.setgroups" "Set the groups of the current process to list."]
    ^{:go/apos {0 [783 2] 1 [783 65]} :go/pos {:colon [783 20]}} ["func:posix.setns" "Move the calling thread into different namespaces.\n\n  fd\n    A file descriptor to a namespace.\n  nstype\n    Type of namespace."]
    ^{:go/apos {0 [784 2] 1 [784 65]} :go/pos {:colon [784 22]}} ["func:posix.setpgid" "Call the system call setpgid(pid, pgrp)."]
    ^{:go/apos {0 [785 2] 1 [785 65]} :go/pos {:colon [785 22]}} ["func:posix.setpgrp" "Make the current process the leader of its process group."]
    ^{:go/apos {0 [786 2] 1 [786 65]} :go/pos {:colon [786 26]}} ["func:posix.setpriority" "Set program scheduling priority."]
    ^{:go/apos {0 [787 2] 1 [787 65]} :go/pos {:colon [787 23]}} ["func:posix.setregid" "Set the current process's real and effective group ids."]
    ^{:go/apos {0 [788 2] 1 [788 65]} :go/pos {:colon [788 24]}} ["func:posix.setresgid" "Set the current process's real, effective, and saved group ids."]
    ^{:go/apos {0 [789 2] 1 [789 65]} :go/pos {:colon [789 24]}} ["func:posix.setresuid" "Set the current process's real, effective, and saved user ids."]
    ^{:go/apos {0 [790 2] 1 [790 65]} :go/pos {:colon [790 23]}} ["func:posix.setreuid" "Set the current process's real and effective user ids."]
    ^{:go/apos {0 [791 2] 1 [791 65]} :go/pos {:colon [791 21]}} ["func:posix.setsid" "Call the system call setsid()."]
    ^{:go/apos {0 [792 2] 1 [792 65]} :go/pos {:colon [792 21]}} ["func:posix.setuid" "Set the current process's user id."]
    ^{:go/apos {0 [793 2] 1 [793 65]} :go/pos {:colon [793 23]}} ["func:posix.setxattr" "Set extended attribute attribute on path to value.\n\npath may be either a string, a path-like object,  or an open file\ndescriptor.\nIf follow_symlinks is False, and the last element of the path is\na symbolic link, setxattr will modify the symbolic link itself instead\nof the file the link points to."]
    ^{:go/apos {0 [794 2] 1 [794 65]} :go/pos {:colon [794 21]}} ["func:posix.splice" "Transfer count bytes from one pipe to a descriptor or vice versa.\n\n  src\n    Source file descriptor.\n  dst\n    Destination file descriptor.\n  count\n    Number of bytes to copy.\n  offset_src\n    Starting offset in src.\n  offset_dst\n    Starting offset in dst.\n  flags\n    Flags to modify the semantics of the call.\n\nIf offset_src is None, then src is read from the current position;\nrespectively for offset_dst. The offset associated to the file\ndescriptor that refers to a pipe must be None."]
    ^{:go/apos {0 [795 2] 1 [795 65]} :go/pos {:colon [795 19]}} ["func:posix.stat" "Perform a stat system call on the given path.\n\n  path\n    Path to be examined; can be string, bytes, a path-like object or\n    open-file-descriptor int.\n  dir_fd\n    If not None, it should be a file descriptor open to a directory,\n    and path should be a relative string; path will then be relative to\n    that directory.\n  follow_symlinks\n    If False, and the last element of the path is a symbolic link,\n    stat will examine the symbolic link itself instead of the file\n    the link points to.\n\ndir_fd and follow_symlinks may not be implemented\n  on your platform.  If they are unavailable, using them will raise a\n  NotImplementedError.\n\nIt's an error to use dir_fd or follow_symlinks when specifying path as\n  an open file descriptor."]
    ^{:go/apos {0 [796 2] 1 [796 65]} :go/pos {:colon [796 22]}} ["func:posix.statvfs" "Perform a statvfs system call on the given path.\n\npath may always be specified as a string.\nOn some platforms, path may also be specified as an open file\ndescriptor.  If this functionality is unavailable, using it raises\nan exception."]
    ^{:go/apos {0 [797 2] 1 [797 65]} :go/pos {:colon [797 23]}} ["func:posix.strerror" "Translate an error code to a message string."]
    ^{:go/apos {0 [798 2] 1 [798 65]} :go/pos {:colon [798 22]}} ["func:posix.symlink" "Create a symbolic link pointing to src named dst.\n\ntarget_is_directory is required on Windows if the target is to be\ninterpreted as a directory.  (On Windows, symlink requires Windows 6.0\nor greater, and raises a NotImplementedError otherwise.)\ntarget_is_directory is ignored on non-Windows platforms.\n\nIf dir_fd is not None, it should be a file descriptor open to\na directory, and path should be relative; path will then be relative\nto that directory.\ndir_fd may not be implemented on your platform.  If it is unavailable,\nusing it will raise a NotImplementedError."]
    ^{:go/apos {0 [799 2] 1 [799 65]} :go/pos {:colon [799 19]}} ["func:posix.sync" "Force write of everything to disk."]
    ^{:go/apos {0 [800 2] 1 [800 65]} :go/pos {:colon [800 22]}} ["func:posix.sysconf" "Return an integer-valued system configuration variable."]
    ^{:go/apos {0 [801 2] 1 [801 65]} :go/pos {:colon [801 21]}} ["func:posix.system" "Execute the command in a subshell."]
    ^{:go/apos {0 [802 2] 1 [802 65]} :go/pos {:colon [802 24]}} ["func:posix.tcgetpgrp" "Return the process group associated with the terminal specified by fd."]
    ^{:go/apos {0 [803 2] 1 [803 65]} :go/pos {:colon [803 24]}} ["func:posix.tcsetpgrp" "Set the process group associated with the terminal specified by fd."]
    ^{:go/apos {0 [804 2] 1 [804 65]} :go/pos {:colon [804 29]}} ["func:posix.timerfd_create" "Create and return a timer file descriptor.\n\n  clockid\n    A valid clock ID constant as timer file descriptor.\n\n    time.CLOCK_REALTIME\n    time.CLOCK_MONOTONIC\n    time.CLOCK_BOOTTIME\n  flags\n    0 or a bit mask of os.TFD_NONBLOCK or os.TFD_CLOEXEC.\n\n    os.TFD_NONBLOCK\n        If *TFD_NONBLOCK* is set as a flag, read doesn't blocks.\n        If *TFD_NONBLOCK* is not set as a flag, read block until the timer fires.\n\n    os.TFD_CLOEXEC\n        If *TFD_CLOEXEC* is set as a flag, enable the close-on-exec flag"]
    ^{:go/apos {0 [805 2] 1 [805 65]} :go/pos {:colon [805 30]}} ["func:posix.timerfd_gettime" "Return a tuple of a timer file descriptor's (next expiration, interval) in float seconds.\n\n  fd\n    A timer file descriptor."]
    ^{:go/apos {0 [806 2] 1 [806 65]} :go/pos {:colon [806 33]}} ["func:posix.timerfd_gettime_ns" "Return a tuple of a timer file descriptor's (next expiration, interval) in nanoseconds.\n\n  fd\n    A timer file descriptor."]
    ^{:go/apos {0 [807 2] 1 [807 65]} :go/pos {:colon [807 30]}} ["func:posix.timerfd_settime" "Alter a timer file descriptor's internal timer in seconds.\n\n  fd\n    A timer file descriptor.\n  flags\n    0 or a bit mask of TFD_TIMER_ABSTIME or TFD_TIMER_CANCEL_ON_SET.\n  initial\n    The initial expiration time, in seconds.\n  interval\n    The timer's interval, in seconds."]
    ^{:go/apos {0 [808 2] 1 [808 65]} :go/pos {:colon [808 33]}} ["func:posix.timerfd_settime_ns" "Alter a timer file descriptor's internal timer in nanoseconds.\n\n  fd\n    A timer file descriptor.\n  flags\n    0 or a bit mask of TFD_TIMER_ABSTIME or TFD_TIMER_CANCEL_ON_SET.\n  initial\n    initial expiration timing in nanoseconds.\n  interval\n    interval for the timer in nanoseconds."]
    ^{:go/apos {0 [809 2] 1 [809 65]} :go/pos {:colon [809 20]}} ["func:posix.times" "Return a collection containing process timing information.\n\nThe object returned behaves like a named tuple with these fields:\n  (utime, stime, cutime, cstime, elapsed_time)\nAll fields are floating-point numbers."]
    ^{:go/apos {0 [810 2] 1 [810 65]} :go/pos {:colon [810 23]}} ["func:posix.truncate" "Truncate a file, specified by path, to a specific length.\n\nOn some platforms, path may also be specified as an open file\ndescriptor.  If this functionality is unavailable, using it raises\nan exception."]
    ^{:go/apos {0 [811 2] 1 [811 65]} :go/pos {:colon [811 22]}} ["func:posix.ttyname" "Return the name of the terminal device connected to 'fd'.\n\n  fd\n    Integer file descriptor handle."]
    ^{:go/apos {0 [812 2] 1 [812 65]} :go/pos {:colon [812 20]}} ["func:posix.umask" "Set the current numeric umask and return the previous umask."]
    ^{:go/apos {0 [813 2] 1 [813 65]} :go/pos {:colon [813 20]}} ["func:posix.uname" "Return an object identifying the current operating system.\n\nThe object behaves like a named tuple with the following fields:\n  (sysname, nodename, release, version, machine)"]
    ^{:go/apos {0 [814 2] 1 [814 65]} :go/pos {:colon [814 21]}} ["func:posix.unlink" "Remove a file (same as remove()).\n\nIf dir_fd is not None, it should be a file descriptor open to\na directory, and path should be relative; path will then be relative to\nthat directory.\ndir_fd may not be implemented on your platform.\nIf it is unavailable, using it will raise a NotImplementedError."]
    ^{:go/apos {0 [815 2] 1 [815 65]} :go/pos {:colon [815 23]}} ["func:posix.unlockpt" "Unlock a pseudo-terminal master/slave pair.\n\n  fd\n    File descriptor of a master pseudo-terminal device.\n\nPerforms an unlockpt() C function call."]
    ^{:go/apos {0 [816 2] 1 [816 65]} :go/pos {:colon [816 23]}} ["func:posix.unsetenv" "Delete an environment variable."]
    ^{:go/apos {0 [817 2] 1 [817 65]} :go/pos {:colon [817 22]}} ["func:posix.unshare" "Disassociate parts of a process (or thread) execution context.\n\n  flags\n    Namespaces to be unshared."]
    ^{:go/apos {0 [818 2] 1 [818 65]} :go/pos {:colon [818 22]}} ["func:posix.urandom" "Return a bytes object containing random bytes suitable for cryptographic use."]
    ^{:go/apos {0 [819 2] 1 [819 65]} :go/pos {:colon [819 20]}} ["func:posix.utime" "Set the access and modified time of path.\n\npath may always be specified as a string.  On some platforms, path may\nalso be specified as an open file descriptor.  If this functionality is\nunavailable, using it raises an exception.\n\nIf times is not None, it must be a tuple (atime, mtime);\natime and mtime should be expressed as float seconds since the epoch.\nIf ns is specified, it must be a tuple (atime_ns, mtime_ns);\natime_ns and mtime_ns should be expressed as integer nanoseconds\nsince the epoch.\nIf times is None and ns is unspecified, utime uses the current time.\nSpecifying tuples for both times and ns is an error.\n\nIf dir_fd is not None, it should be a file descriptor open to\na directory, and path should be relative; path will then be relative to\nthat directory.\nIf follow_symlinks is False, and the last element of the path is\na symbolic link, utime will modify the symbolic link itself instead of\nthe file the link points to.\nIt is an error to use dir_fd or follow_symlinks when specifying path as\nan open file descriptor.\ndir_fd and follow_symlinks may not be available on your platform.\nIf they are unavailable, using them will raise a NotImplementedError."]
    ^{:go/apos {0 [820 2] 1 [820 65]} :go/pos {:colon [820 19]}} ["func:posix.wait" "Wait for completion of a child process.\n\nReturns a tuple of information about the child process:\n    (pid, status)"]
    ^{:go/apos {0 [821 2] 1 [821 65]} :go/pos {:colon [821 20]}} ["func:posix.wait3" "Wait for completion of a child process.\n\nReturns a tuple of information about the child process:\n  (pid, status, rusage)"]
    ^{:go/apos {0 [822 2] 1 [822 65]} :go/pos {:colon [822 20]}} ["func:posix.wait4" "Wait for completion of a specific child process.\n\nReturns a tuple of information about the child process:\n  (pid, status, rusage)"]
    ^{:go/apos {0 [823 2] 1 [823 65]} :go/pos {:colon [823 21]}} ["func:posix.waitid" "Returns the result of waiting for a process or processes.\n\n  idtype\n    Must be one of be P_PID, P_PGID or P_ALL.\n  id\n    The id to wait on.\n  options\n    Constructed from the ORing of one or more of WEXITED, WSTOPPED\n    or WCONTINUED and additionally may be ORed with WNOHANG or WNOWAIT.\n\nReturns either waitid_result or None if WNOHANG is specified and there\nare no children in a waitable state."]
    ^{:go/apos {0 [824 2] 1 [824 65]} :go/pos {:colon [824 22]}} ["func:posix.waitpid" "Wait for completion of a given child process.\n\nReturns a tuple of information regarding the child process:\n    (pid, status)\n\nThe options argument is ignored on Windows."]
    ^{:go/apos {0 [825 2] 1 [825 65]} :go/pos {:colon [825 37]}} ["func:posix.waitstatus_to_exitcode" "Convert a wait status to an exit code.\n\nOn Unix:\n\n* If WIFEXITED(status) is true, return WEXITSTATUS(status).\n* If WIFSIGNALED(status) is true, return -WTERMSIG(status).\n* Otherwise, raise a ValueError.\n\nOn Windows, return status shifted right by 8 bits.\n\nOn Unix, if the process is being traced or if waitpid() was called with\nWUNTRACED option, the caller must first check if WIFSTOPPED(status) is\ntrue.  This function must not be called if WIFSTOPPED(status) is true."]
    ^{:go/apos {0 [826 2] 1 [826 65]} :go/pos {:colon [826 20]}} ["func:posix.write" "Write a bytes object to a file descriptor."]
    ^{:go/apos {0 [827 2] 1 [827 65]} :go/pos {:colon [827 21]}} ["func:posix.writev" "Iterate over buffers, and write the contents of each to a file descriptor.\n\nReturns the total number of bytes written.\nbuffers must be a sequence of bytes-like objects."]
    ^{:go/apos {0 [828 2] 1 [828 65]} :go/pos {:colon [828 21]}} ["func:pwd.getpwall" "Return a list of all available password database entries, in arbitrary order.\n\nSee help(pwd) for more on password database entries."]
    ^{:go/apos {0 [829 2] 1 [829 65]} :go/pos {:colon [829 21]}} ["func:pwd.getpwnam" "Return the password database entry for the given user name.\n\nSee `help(pwd)` for more on password database entries."]
    ^{:go/apos {0 [830 2] 1 [830 65]} :go/pos {:colon [830 21]}} ["func:pwd.getpwuid" "Return the password database entry for the given numeric user ID.\n\nSee `help(pwd)` for more on password database entries."]
    ^{:go/apos {0 [831 2] 1 [831 65]} :go/pos {:colon [831 28]}} ["func:pyexpat.ErrorString" "Returns string error for given number."]
    ^{:go/apos {0 [832 2] 1 [832 65]} :go/pos {:colon [832 29]}} ["func:pyexpat.ParserCreate" "Return a new XML parser object."]
    ^{:go/apos {0 [833 2] 1 [833 65]} :go/pos {:colon [833 29]}} ["func:readline.add_history" "Add an item to the history buffer."]
    ^{:go/apos {0 [834 2] 1 [834 65]} :go/pos {:colon [834 37]}} ["func:readline.append_history_file" "Append the last nelements items of the history list to file.\n\nThe default filename is ~/.history."]
    ^{:go/apos {0 [835 2] 1 [835 65]} :go/pos {:colon [835 31]}} ["func:readline.clear_history" "Clear the current readline history."]
    ^{:go/apos {0 [836 2] 1 [836 65]} :go/pos {:colon [836 28]}} ["func:readline.get_begidx" "Get the beginning index of the completion scope."]
    ^{:go/apos {0 [837 2] 1 [837 65]} :go/pos {:colon [837 31]}} ["func:readline.get_completer" "Get the current completer function."]
    ^{:go/apos {0 [838 2] 1 [838 65]} :go/pos {:colon [838 38]}} ["func:readline.get_completer_delims" "Get the word delimiters for completion."]
    ^{:go/apos {0 [839 2] 1 [839 65]} :go/pos {:colon [839 37]}} ["func:readline.get_completion_type" "Get the type of completion being attempted."]
    ^{:go/apos {0 [840 2] 1 [840 65]} :go/pos {:colon [840 44]}} ["func:readline.get_current_history_length" "Return the current (not the maximum) length of history."]
    ^{:go/apos {0 [841 2] 1 [841 65]} :go/pos {:colon [841 28]}} ["func:readline.get_endidx" "Get the ending index of the completion scope."]
    ^{:go/apos {0 [842 2] 1 [842 65]} :go/pos {:colon [842 34]}} ["func:readline.get_history_item" "Return the current contents of history item at one-based index."]
    ^{:go/apos {0 [843 2] 1 [843 65]} :go/pos {:colon [843 36]}} ["func:readline.get_history_length" "Return the maximum number of lines that will be written to the history file."]
    ^{:go/apos {0 [844 2] 1 [844 65]} :go/pos {:colon [844 33]}} ["func:readline.get_line_buffer" "Return the current contents of the line buffer."]
    ^{:go/apos {0 [845 2] 1 [845 65]} :go/pos {:colon [845 29]}} ["func:readline.insert_text" "Insert text into the line buffer at the cursor position."]
    ^{:go/apos {0 [846 2] 1 [846 65]} :go/pos {:colon [846 32]}} ["func:readline.parse_and_bind" "Execute the init line provided in the string argument."]
    ^{:go/apos {0 [847 2] 1 [847 65]} :go/pos {:colon [847 35]}} ["func:readline.read_history_file" "Load a readline history file.\n\nThe default filename is ~/.history."]
    ^{:go/apos {0 [848 2] 1 [848 65]} :go/pos {:colon [848 32]}} ["func:readline.read_init_file" "Execute a readline initialization file.\n\nThe default filename is the last filename used."]
    ^{:go/apos {0 [849 2] 1 [849 65]} :go/pos {:colon [849 27]}} ["func:readline.redisplay" "Change what's displayed on the screen to reflect contents of the line buffer."]
    ^{:go/apos {0 [850 2] 1 [850 65]} :go/pos {:colon [850 37]}} ["func:readline.remove_history_item" "Remove history item given by its zero-based position."]
    ^{:go/apos {0 [851 2] 1 [851 65]} :go/pos {:colon [851 38]}} ["func:readline.replace_history_item" "Replaces history item given by its position with contents of line.\n\npos is zero-based."]
    ^{:go/apos {0 [852 2] 1 [852 65]} :go/pos {:colon [852 34]}} ["func:readline.set_auto_history" "Enables or disables automatic history."]
    ^{:go/apos {0 [853 2] 1 [853 65]} :go/pos {:colon [853 31]}} ["func:readline.set_completer" "Set or remove the completer function.\n\nThe function is called as function(text, state),\nfor state in 0, 1, 2, ..., until it returns a non-string.\nIt should return the next possible completion starting with 'text'."]
    ^{:go/apos {0 [854 2] 1 [854 65]} :go/pos {:colon [854 38]}} ["func:readline.set_completer_delims" "Set the word delimiters for completion."]
    ^{:go/apos {0 [855 2] 1 [855 65]} :go/pos {:colon [855 53]}} ["func:readline.set_completion_display_matches_hook" "Set or remove the completion display function.\n\nThe function is called as\n  function(substitution, [matches], longest_match_length)\nonce each time matches need to be displayed."]
    ^{:go/apos {0 [856 2] 1 [856 65]} :go/pos {:colon [856 36]}} ["func:readline.set_history_length" "Set the maximal number of lines which will be written to the history file.\n\nA negative length is used to inhibit history truncation."]
    ^{:go/apos {0 [857 2] 1 [857 65]} :go/pos {:colon [857 36]}} ["func:readline.set_pre_input_hook" "Set or remove the function invoked by the rl_pre_input_hook callback.\n\nThe function is called with no arguments after the first prompt\nhas been printed and just before readline starts reading input\ncharacters."]
    ^{:go/apos {0 [858 2] 1 [858 65]} :go/pos {:colon [858 34]}} ["func:readline.set_startup_hook" "Set or remove the function invoked by the rl_startup_hook callback.\n\nThe function is called with no arguments just\nbefore readline prints the first prompt."]
    ^{:go/apos {0 [859 2] 1 [859 65]} :go/pos {:colon [859 36]}} ["func:readline.write_history_file" "Save a readline history file.\n\nThe default filename is ~/.history."]
    ^{:go/apos {0 [860 2] 1 [860 65]} :go/pos {:colon [860 20]}} ["func:select.poll" "Returns a polling object.\n\nThis object supports registering and unregistering file descriptors, and\nthen polling them for I/O events."]
    ^{:go/apos {0 [861 2] 1 [861 65]} :go/pos {:colon [861 22]}} ["func:select.select" "Wait until one or more file descriptors are ready for some kind of I/O.\n\nThe first three arguments are iterables of file descriptors to be waited\nfor:\nrlist -- wait until ready for reading\nwlist -- wait until ready for writing\nxlist -- wait for an \"exceptional condition\"\nIf only one kind of condition is required, pass [] for the other lists.\n\nA file descriptor is either a socket or file object, or a small integer\ngotten from a fileno() method call on one of those.\n\nThe optional 4th argument specifies a timeout in seconds; it may be\na floating-point number to specify fractions of seconds.  If it is absent\nor None, the call will never time out.\n\nThe return value is a tuple of three lists corresponding to the first\nthree arguments; each contains the subset of the corresponding file\ndescriptors that are ready.\n\n*** IMPORTANT NOTICE ***\nOn Windows, only sockets are supported; on Unix, all file\ndescriptors can be used."]
    ^{:go/apos {0 [862 2] 1 [862 65]} :go/pos {:colon [862 31]}} ["func:sys.__breakpointhook__" "This hook function is called by built-in breakpoint().\n"]
    ^{:go/apos {0 [863 2] 1 [863 65]} :go/pos {:colon [863 28]}} ["func:sys.__displayhook__" "Print an object to sys.stdout and also save it in builtins._"]
    ^{:go/apos {0 [864 2] 1 [864 65]} :go/pos {:colon [864 27]}} ["func:sys.__excepthook__" "Handle an exception by displaying it with a traceback on sys.stderr."]
    ^{:go/apos {0 [865 2] 1 [865 65]} :go/pos {:colon [865 31]}} ["func:sys.__unraisablehook__" "Handle an unraisable exception.\n\nThe unraisable argument has the following attributes:\n\n* exc_type: Exception type.\n* exc_value: Exception value, can be None.\n* exc_traceback: Exception traceback, can be None.\n* err_msg: Error message, can be None.\n* object: Object causing the exception, can be None."]
    ^{:go/apos {0 [866 2] 1 [866 65]} :go/pos {:colon [866 22]}} ["func:sys._baserepl" "Private function for getting the base REPL"]
    ^{:go/apos {0 [867 2] 1 [867 65]} :go/pos {:colon [867 35]}} ["func:sys._clear_internal_caches" "Clear all internal performance-related caches."]
    ^{:go/apos {0 [868 2] 1 [868 65]} :go/pos {:colon [868 30]}} ["func:sys._clear_type_cache" "Clear the internal type lookup cache."]
    ^{:go/apos {0 [869 2] 1 [869 65]} :go/pos {:colon [869 36]}} ["func:sys._clear_type_descriptors" "Private function for clearing certain descriptors from a type's dictionary.\n\nSee gh-135228 for context."]
    ^{:go/apos {0 [870 2] 1 [870 65]} :go/pos {:colon [870 32]}} ["func:sys._current_exceptions" "Return a dict mapping each thread's identifier to its current raised exception.\n\nThis function should be used for specialized purposes only."]
    ^{:go/apos {0 [871 2] 1 [871 65]} :go/pos {:colon [871 28]}} ["func:sys._current_frames" "Return a dict mapping each thread's thread id to its current stack frame.\n\nThis function should be used for specialized purposes only."]
    ^{:go/apos {0 [872 2] 1 [872 65]} :go/pos {:colon [872 30]}} ["func:sys._debugmallocstats" "Print summary info to stderr about the state of pymalloc's structures.\n\nIn Py_DEBUG mode, also perform some expensive internal consistency\nchecks."]
    ^{:go/apos {0 [873 2] 1 [873 65]} :go/pos {:colon [873 28]}} ["func:sys._dump_tracelets" "Dump the graph of tracelets in graphviz format"]
    ^{:go/apos {0 [874 2] 1 [874 65]} :go/pos {:colon [874 34]}} ["func:sys._get_cpu_count_config" "Private function for getting PyConfig.cpu_count"]
    ^{:go/apos {0 [875 2] 1 [875 65]} :go/pos {:colon [875 22]}} ["func:sys._getframe" "Return a frame object from the call stack.\n\nIf optional integer depth is given, return the frame object that many\ncalls below the top of the stack.  If that is deeper than the call\nstack, ValueError is raised.  The default for depth is zero, returning\nthe frame at the top of the call stack.\n\nThis function should be used for internal and specialized purposes\nonly."]
    ^{:go/apos {0 [876 2] 1 [876 65]} :go/pos {:colon [876 32]}} ["func:sys._getframemodulename" "Return the name of the module for a calling frame.\n\nThe default depth returns the module containing the call to this API.\nA more typical use in a library will pass a depth of 1 to get the user's\nmodule rather than the library module.\n\nIf no frame, module, or name can be found, returns None."]
    ^{:go/apos {0 [877 2] 1 [877 65]} :go/pos {:colon [877 28]}} ["func:sys._is_gil_enabled" "Return True if the GIL is currently enabled and False otherwise."]
    ^{:go/apos {0 [878 2] 1 [878 65]} :go/pos {:colon [878 25]}} ["func:sys._is_immortal" "Return True if the given object is \"immortal\" per PEP 683.\n\nThis function should be used for specialized purposes only."]
    ^{:go/apos {0 [879 2] 1 [879 65]} :go/pos {:colon [879 25]}} ["func:sys._is_interned" "Return True if the given string is \"interned\"."]
    ^{:go/apos {0 [880 2] 1 [880 65]} :go/pos {:colon [880 34]}} ["func:sys._setprofileallthreads" "Set the profiling function in all running threads belonging to the current interpreter.\n\nIt will be called on each function call and return.  See the profiler\nchapter in the library manual."]
    ^{:go/apos {0 [881 2] 1 [881 65]} :go/pos {:colon [881 32]}} ["func:sys._settraceallthreads" "Set the global debug tracing function in all running threads belonging to the current interpreter.\n\nIt will be called on each function call. See the debugger chapter\nin the library manual."]
    ^{:go/apos {0 [882 2] 1 [882 65]} :go/pos {:colon [882 38]}} ["func:sys.activate_stack_trampoline" "Activate stack profiler trampoline *backend*."]
    ^{:go/apos {0 [883 2] 1 [883 65]} :go/pos {:colon [883 25]}} ["func:sys.addaudithook" "Adds a new audit hook callback."]
    ^{:go/apos {0 [884 2] 1 [884 65]} :go/pos {:colon [884 18]}} ["func:sys.audit" "Passes the event to any audit hooks that are attached."]
    ^{:go/apos {0 [885 2] 1 [885 65]} :go/pos {:colon [885 27]}} ["func:sys.breakpointhook" "This hook function is called by built-in breakpoint().\n"]
    ^{:go/apos {0 [886 2] 1 [886 65]} :go/pos {:colon [886 25]}} ["func:sys.call_tracing" "Call func(*args), while tracing is enabled.\n\nThe tracing state is saved, and restored afterwards.  This is intended\nto be called from a debugger from a checkpoint, to recursively debug\nsome other code."]
    ^{:go/apos {0 [887 2] 1 [887 65]} :go/pos {:colon [887 40]}} ["func:sys.deactivate_stack_trampoline" "Deactivate the current stack profiler trampoline backend.\n\nIf no stack profiler is activated, this function has no effect."]
    ^{:go/apos {0 [888 2] 1 [888 65]} :go/pos {:colon [888 24]}} ["func:sys.displayhook" "Print an object to sys.stdout and also save it in builtins._"]
    ^{:go/apos {0 [889 2] 1 [889 65]} :go/pos {:colon [889 21]}} ["func:sys.exc_info" "Return current exception information: (type, value, traceback).\n\nReturn information about the most recent exception caught by an except\nclause in the current stack frame or in an older stack frame."]
    ^{:go/apos {0 [890 2] 1 [890 65]} :go/pos {:colon [890 23]}} ["func:sys.excepthook" "Handle an exception by displaying it with a traceback on sys.stderr."]
    ^{:go/apos {0 [891 2] 1 [891 65]} :go/pos {:colon [891 22]}} ["func:sys.exception" "Return the current exception.\n\nReturn the most recent exception caught by an except clause\nin the current stack frame or in an older stack frame, or None\nif no such exception exists."]
    ^{:go/apos {0 [892 2] 1 [892 65]} :go/pos {:colon [892 17]}} ["func:sys.exit" "Exit the interpreter by raising SystemExit(status).\n\nIf the status is omitted or None, it defaults to zero (i.e., success).\nIf the status is an integer, it will be used as the system exit status.\nIf it is another kind of object, it will be printed and the system\nexit status will be one (i.e., failure)."]
    ^{:go/apos {0 [893 2] 1 [893 65]} :go/pos {:colon [893 31]}} ["func:sys.get_asyncgen_hooks" "Return the installed asynchronous generators hooks.\n\nThis returns a namedtuple of the form (firstiter, finalizer)."]
    ^{:go/apos {0 [894 2] 1 [894 65]} :go/pos {:colon [894 48]}} ["func:sys.get_coroutine_origin_tracking_depth" "Check status of origin tracking for coroutine objects in this thread."]
    ^{:go/apos {0 [895 2] 1 [895 65]} :go/pos {:colon [895 35]}} ["func:sys.get_int_max_str_digits" "Return the maximum string digits limit for non-binary int<->str conversions."]
    ^{:go/apos {0 [896 2] 1 [896 65]} :go/pos {:colon [896 31]}} ["func:sys.getallocatedblocks" "Return the number of memory blocks currently allocated."]
    ^{:go/apos {0 [897 2] 1 [897 65]} :go/pos {:colon [897 31]}} ["func:sys.getdefaultencoding" "Return the current default encoding used by the Unicode implementation."]
    ^{:go/apos {0 [898 2] 1 [898 65]} :go/pos {:colon [898 27]}} ["func:sys.getdlopenflags" "Return the current value of the flags that are used for dlopen calls.\n\nThe flag constants are defined in the os module."]
    ^{:go/apos {0 [899 2] 1 [899 65]} :go/pos {:colon [899 38]}} ["func:sys.getfilesystemencodeerrors" "Return the error mode used Unicode to OS filename conversion."]
    ^{:go/apos {0 [900 2] 1 [900 65]} :go/pos {:colon [900 34]}} ["func:sys.getfilesystemencoding" "Return the encoding used to convert Unicode filenames to OS filenames."]
    ^{:go/apos {0 [901 2] 1 [901 65]} :go/pos {:colon [901 23]}} ["func:sys.getprofile" "Return the profiling function set with sys.setprofile.\n\nSee the profiler chapter in the library manual."]
    ^{:go/apos {0 [902 2] 1 [902 65]} :go/pos {:colon [902 30]}} ["func:sys.getrecursionlimit" "Return the current value of the recursion limit.\n\nThe recursion limit is the maximum depth of the Python interpreter\nstack.  This limit prevents infinite recursion from causing an overflow\nof the C stack and crashing Python."]
    ^{:go/apos {0 [903 2] 1 [903 65]} :go/pos {:colon [903 24]}} ["func:sys.getrefcount" "Return the reference count of object.\n\nThe count returned is generally one higher than you might expect,\nbecause it includes the (temporary) reference as an argument to\ngetrefcount()."]
    ^{:go/apos {0 [904 2] 1 [904 65]} :go/pos {:colon [904 22]}} ["func:sys.getsizeof" "getsizeof(object [, default]) -> int\n\nReturn the size of object in bytes."]
    ^{:go/apos {0 [905 2] 1 [905 65]} :go/pos {:colon [905 30]}} ["func:sys.getswitchinterval" "Return the current thread switch interval; see sys.setswitchinterval()."]
    ^{:go/apos {0 [906 2] 1 [906 65]} :go/pos {:colon [906 21]}} ["func:sys.gettrace" "Return the global debug tracing function set with sys.settrace.\n\nSee the debugger chapter in the library manual."]
    ^{:go/apos {0 [907 2] 1 [907 65]} :go/pos {:colon [907 35]}} ["func:sys.getunicodeinternedsize" "Return the number of elements of the unicode interned dictionary"]
    ^{:go/apos {0 [908 2] 1 [908 65]} :go/pos {:colon [908 19]}} ["func:sys.intern" "``Intern'' the given string.\n\nThis enters the string in the (global) table of interned strings whose\npurpose is to speed up dictionary lookups. Return the string itself or\nthe previously interned string object with the same value."]
    ^{:go/apos {0 [909 2] 1 [909 65]} :go/pos {:colon [909 26]}} ["func:sys.is_finalizing" "Return True if Python is exiting."]
    ^{:go/apos {0 [910 2] 1 [910 65]} :go/pos {:colon [910 36]}} ["func:sys.is_remote_debug_enabled" "Return True if remote debugging is enabled, False otherwise."]
    ^{:go/apos {0 [911 2] 1 [911 65]} :go/pos {:colon [911 39]}} ["func:sys.is_stack_trampoline_active" "Return *True* if a stack profiler trampoline is active."]
    ^{:go/apos {0 [912 2] 1 [912 65]} :go/pos {:colon [912 24]}} ["func:sys.remote_exec" "Executes a file containing Python code in a given remote Python process.\n\nThis function returns immediately, and the code will be executed by the\ntarget process's main thread at the next available opportunity,\nsimilarly to how signals are handled.  There is no interface to\ndetermine when the code has been executed.  The caller is responsible\nfor making sure that the file still exists whenever the remote process\ntries to read it and that it hasn't been overwritten.\n\nThe remote process must be running a CPython interpreter of the same\nmajor and minor version as the local process.  If either the local or\nremote interpreter is pre-release (alpha, beta, or release candidate)\nthen the local and remote interpreters must be the same exact version.\n\nArgs:\n     pid (int): The process ID of the target Python process.\n     script (str|bytes): The path to a file containing\n         the Python code to be executed."]
    ^{:go/apos {0 [913 2] 1 [913 65]} :go/pos {:colon [913 31]}} ["func:sys.set_asyncgen_hooks" "set_asyncgen_hooks([firstiter] [, finalizer])\n\nSet a finalizer for async generators objects."]
    ^{:go/apos {0 [914 2] 1 [914 65]} :go/pos {:colon [914 48]}} ["func:sys.set_coroutine_origin_tracking_depth" "Enable or disable origin tracking for coroutine objects in this thread.\n\nCoroutine objects will track 'depth' frames of traceback information\nabout where they came from, available in their cr_origin attribute.\n\nSet a depth of 0 to disable."]
    ^{:go/apos {0 [915 2] 1 [915 65]} :go/pos {:colon [915 35]}} ["func:sys.set_int_max_str_digits" "Set the maximum string digits limit for non-binary int<->str conversions."]
    ^{:go/apos {0 [916 2] 1 [916 65]} :go/pos {:colon [916 27]}} ["func:sys.setdlopenflags" "Set the flags used by the interpreter for dlopen calls.\n\nThis is used, for example, when the interpreter loads extension\nmodules. Among other things, this will enable a lazy resolving of\nsymbols when importing a module, if called as sys.setdlopenflags(0).\nTo share symbols across extension modules, call as\nsys.setdlopenflags(os.RTLD_GLOBAL).  Symbolic names for the flag\nmodules can be found in the os module (RTLD_xxx constants, e.g.\nos.RTLD_LAZY)."]
    ^{:go/apos {0 [917 2] 1 [917 65]} :go/pos {:colon [917 23]}} ["func:sys.setprofile" "Set the profiling function.\n\nIt will be called on each function call and return.  See the profiler\nchapter in the library manual."]
    ^{:go/apos {0 [918 2] 1 [918 65]} :go/pos {:colon [918 30]}} ["func:sys.setrecursionlimit" "Set the maximum depth of the Python interpreter stack to n.\n\nThis limit prevents infinite recursion from causing an overflow of the C\nstack and crashing Python.  The highest possible limit is platform-\ndependent."]
    ^{:go/apos {0 [919 2] 1 [919 65]} :go/pos {:colon [919 30]}} ["func:sys.setswitchinterval" "Set the ideal thread switching delay inside the Python interpreter.\n\nThe actual frequency of switching threads can be lower if the\ninterpreter executes long sequences of uninterruptible code\n(this is implementation-specific and workload-dependent).\n\nThe parameter must represent the desired switching delay in seconds\nA typical value is 0.005 (5 milliseconds)."]
    ^{:go/apos {0 [920 2] 1 [920 65]} :go/pos {:colon [920 21]}} ["func:sys.settrace" "Set the global debug tracing function.\n\nIt will be called on each function call.  See the debugger chapter\nin the library manual."]
    ^{:go/apos {0 [921 2] 1 [921 65]} :go/pos {:colon [921 27]}} ["func:sys.unraisablehook" "Handle an unraisable exception.\n\nThe unraisable argument has the following attributes:\n\n* exc_type: Exception type.\n* exc_value: Exception value, can be None.\n* exc_traceback: Exception traceback, can be None.\n* err_msg: Error message, can be None.\n* object: Object causing the exception, can be None."]
    ^{:go/apos {0 [922 2] 1 [922 65]} :go/pos {:colon [922 24]}} ["func:syslog.LOG_MASK" "Calculates the mask for the individual priority pri."]
    ^{:go/apos {0 [923 2] 1 [923 65]} :go/pos {:colon [923 24]}} ["func:syslog.LOG_UPTO" "Calculates the mask for all priorities up to and including pri."]
    ^{:go/apos {0 [924 2] 1 [924 65]} :go/pos {:colon [924 24]}} ["func:syslog.closelog" "Reset the syslog module values and call the system library closelog()."]
    ^{:go/apos {0 [925 2] 1 [925 65]} :go/pos {:colon [925 23]}} ["func:syslog.openlog" "Set logging options of subsequent syslog() calls."]
    ^{:go/apos {0 [926 2] 1 [926 65]} :go/pos {:colon [926 26]}} ["func:syslog.setlogmask" "Set the priority mask to maskpri and return the previous mask value."]
    ^{:go/apos {0 [927 2] 1 [927 65]} :go/pos {:colon [927 22]}} ["func:syslog.syslog" "syslog([priority=LOG_INFO,] message)\nSend the string message to the system logger."]
    ^{:go/apos {0 [928 2] 1 [928 65]} :go/pos {:colon [928 24]}} ["func:termios.tcdrain" "Wait until all output written to file descriptor fd has been transmitted."]
    ^{:go/apos {0 [929 2] 1 [929 65]} :go/pos {:colon [929 23]}} ["func:termios.tcflow" "Suspend or resume input or output on file descriptor fd.\n\nThe action argument can be termios.TCOOFF to suspend output,\ntermios.TCOON to restart output, termios.TCIOFF to suspend input,\nor termios.TCION to restart input."]
    ^{:go/apos {0 [930 2] 1 [930 65]} :go/pos {:colon [930 24]}} ["func:termios.tcflush" "Discard queued data on file descriptor fd.\n\nThe queue selector specifies which queue: termios.TCIFLUSH for the input\nqueue, termios.TCOFLUSH for the output queue, or termios.TCIOFLUSH for\nboth queues."]
    ^{:go/apos {0 [931 2] 1 [931 65]} :go/pos {:colon [931 26]}} ["func:termios.tcgetattr" "Get the tty attributes for file descriptor fd.\n\nReturns a list [iflag, oflag, cflag, lflag, ispeed, ospeed, cc]\nwhere cc is a list of the tty special characters (each a string of\nlength 1, except the items with indices VMIN and VTIME, which are\nintegers when these fields are defined).  The interpretation of the\nflags and the speeds as well as the indexing in the cc array must be\ndone using the symbolic constants defined in this module."]
    ^{:go/apos {0 [932 2] 1 [932 65]} :go/pos {:colon [932 29]}} ["func:termios.tcgetwinsize" "Get the tty winsize for file descriptor fd.\n\nReturns a tuple (ws_row, ws_col)."]
    ^{:go/apos {0 [933 2] 1 [933 65]} :go/pos {:colon [933 28]}} ["func:termios.tcsendbreak" "Send a break on file descriptor fd.\n\nA zero duration sends a break for 0.25-0.5 seconds; a nonzero duration\nhas a system dependent meaning."]
    ^{:go/apos {0 [934 2] 1 [934 65]} :go/pos {:colon [934 26]}} ["func:termios.tcsetattr" "Set the tty attributes for file descriptor fd.\n\nThe attributes to be set are taken from the attributes argument, which\nis a list like the one returned by tcgetattr(). The when argument\ndetermines when the attributes are changed: termios.TCSANOW to\nchange immediately, termios.TCSADRAIN to change after transmitting all\nqueued output, or termios.TCSAFLUSH to change after transmitting all\nqueued output and discarding all queued input."]
    ^{:go/apos {0 [935 2] 1 [935 65]} :go/pos {:colon [935 29]}} ["func:termios.tcsetwinsize" "Set the tty winsize for file descriptor fd.\n\nThe winsize to be set is taken from the winsize argument, which\nis a two-item tuple (ws_row, ws_col) like the one returned by\ntcgetwinsize()."]
    ^{:go/apos {0 [936 2] 1 [936 65]} :go/pos {:colon [936 21]}} ["func:time.asctime" "asctime([time_tuple]) -> string\n\nConvert a time tuple to a string, e.g. 'Sat Jun 06 16:26:11 1998'.\nWhen the time tuple is not present, current time as returned by localtime()\nis used."]
    ^{:go/apos {0 [937 2] 1 [937 65]} :go/pos {:colon [937 26]}} ["func:time.clock_getres" "clock_getres(clk_id) -> floating-point number\n\nReturn the resolution (precision) of the specified clock clk_id."]
    ^{:go/apos {0 [938 2] 1 [938 65]} :go/pos {:colon [938 27]}} ["func:time.clock_gettime" "Return the time of the specified clock clk_id as a float."]
    ^{:go/apos {0 [939 2] 1 [939 65]} :go/pos {:colon [939 30]}} ["func:time.clock_gettime_ns" "Return the time of the specified clock clk_id as nanoseconds (int)."]
    ^{:go/apos {0 [940 2] 1 [940 65]} :go/pos {:colon [940 27]}} ["func:time.clock_settime" "clock_settime(clk_id, time)\n\nSet the time of the specified clock clk_id."]
    ^{:go/apos {0 [941 2] 1 [941 65]} :go/pos {:colon [941 30]}} ["func:time.clock_settime_ns" "clock_settime_ns(clk_id, time)\n\nSet the time of the specified clock clk_id with nanoseconds."]
    ^{:go/apos {0 [942 2] 1 [942 65]} :go/pos {:colon [942 19]}} ["func:time.ctime" "ctime([seconds]) -> string\n\nConvert a time in seconds since the Epoch to a string in local time.\nThis is equivalent to asctime(localtime(seconds)). When 'seconds' is not\npassed in, convert the current time instead."]
    ^{:go/apos {0 [943 2] 1 [943 65]} :go/pos {:colon [943 28]}} ["func:time.get_clock_info" "get_clock_info(name: str) -> dict\n\nGet information of the specified clock."]
    ^{:go/apos {0 [944 2] 1 [944 65]} :go/pos {:colon [944 20]}} ["func:time.gmtime" "gmtime([seconds]) -> (tm_year, tm_mon, tm_mday, tm_hour, tm_min,\n                       tm_sec, tm_wday, tm_yday, tm_isdst)\n\nConvert seconds since the Epoch to a time tuple expressing UTC (a.k.a.\nGMT).  When 'seconds' is not passed in, convert the current time instead.\n\nIf the platform supports the tm_gmtoff and tm_zone, they are available as\nattributes only."]
    ^{:go/apos {0 [945 2] 1 [945 65]} :go/pos {:colon [945 23]}} ["func:time.localtime" "localtime([seconds]) -> (tm_year,tm_mon,tm_mday,tm_hour,tm_min,\n                          tm_sec,tm_wday,tm_yday,tm_isdst)\n\nConvert seconds since the Epoch to a time tuple expressing local time.\nWhen 'seconds' is not passed in, convert the current time instead."]
    ^{:go/apos {0 [946 2] 1 [946 65]} :go/pos {:colon [946 20]}} ["func:time.mktime" "mktime(time_tuple) -> floating-point number\n\nConvert a time tuple in local time to seconds since the Epoch.\nNote that mktime(gmtime(0)) will not generally return zero for most\ntime zones; instead the returned value will either be equal to that\nof the timezone or altzone attributes on the time module."]
    ^{:go/apos {0 [947 2] 1 [947 65]} :go/pos {:colon [947 23]}} ["func:time.monotonic" "monotonic() -> float\n\nMonotonic clock, cannot go backward."]
    ^{:go/apos {0 [948 2] 1 [948 65]} :go/pos {:colon [948 26]}} ["func:time.monotonic_ns" "monotonic_ns() -> int\n\nMonotonic clock, cannot go backward, as nanoseconds."]
    ^{:go/apos {0 [949 2] 1 [949 65]} :go/pos {:colon [949 26]}} ["func:time.perf_counter" "perf_counter() -> float\n\nPerformance counter for benchmarking."]
    ^{:go/apos {0 [950 2] 1 [950 65]} :go/pos {:colon [950 29]}} ["func:time.perf_counter_ns" "perf_counter_ns() -> int\n\nPerformance counter for benchmarking as nanoseconds."]
    ^{:go/apos {0 [951 2] 1 [951 65]} :go/pos {:colon [951 26]}} ["func:time.process_time" "process_time() -> float\n\nProcess time for profiling: sum of the kernel and user-space CPU time."]
    ^{:go/apos {0 [952 2] 1 [952 65]} :go/pos {:colon [952 29]}} ["func:time.process_time_ns" "process_time() -> int\n\nProcess time for profiling as nanoseconds:\nsum of the kernel and user-space CPU time."]
    ^{:go/apos {0 [953 2] 1 [953 65]} :go/pos {:colon [953 35]}} ["func:time.pthread_getcpuclockid" "pthread_getcpuclockid(thread_id) -> int\n\nReturn the clk_id of a thread's CPU time clock."]
    ^{:go/apos {0 [954 2] 1 [954 65]} :go/pos {:colon [954 19]}} ["func:time.sleep" "sleep(seconds)\n\nDelay execution for a given number of seconds.  The argument may be\na floating-point number for subsecond precision."]
    ^{:go/apos {0 [955 2] 1 [955 65]} :go/pos {:colon [955 22]}} ["func:time.strftime" "strftime(format[, time_tuple]) -> string\n\nConvert a time tuple to a string according to a format specification.\nSee the library reference manual for formatting codes. When the time tuple\nis not present, current time as returned by localtime() is used.\n\nCommonly used format codes:\n\n%Y  Year with century as a decimal number.\n%m  Month as a decimal number [01,12].\n%d  Day of the month as a decimal number [01,31].\n%H  Hour (24-hour clock) as a decimal number [00,23].\n%M  Minute as a decimal number [00,59].\n%S  Second as a decimal number [00,61].\n%z  Time zone offset from UTC.\n%a  Locale's abbreviated weekday name.\n%A  Locale's full weekday name.\n%b  Locale's abbreviated month name.\n%B  Locale's full month name.\n%c  Locale's appropriate date and time representation.\n%I  Hour (12-hour clock) as a decimal number [01,12].\n%p  Locale's equivalent of either AM or PM.\n\nOther codes may be available on your platform.  See documentation for\nthe C library strftime function.\n"]
    ^{:go/apos {0 [956 2] 1 [956 65]} :go/pos {:colon [956 22]}} ["func:time.strptime" "strptime(string[, format]) -> struct_time\n\nParse a string to a time tuple according to a format specification.\nSee the library reference manual for formatting codes (same as\nstrftime()).\n\nCommonly used format codes:\n\n%Y  Year with century as a decimal number.\n%m  Month as a decimal number [01,12].\n%d  Day of the month as a decimal number [01,31].\n%H  Hour (24-hour clock) as a decimal number [00,23].\n%M  Minute as a decimal number [00,59].\n%S  Second as a decimal number [00,61].\n%z  Time zone offset from UTC.\n%a  Locale's abbreviated weekday name.\n%A  Locale's full weekday name.\n%b  Locale's abbreviated month name.\n%B  Locale's full month name.\n%c  Locale's appropriate date and time representation.\n%I  Hour (12-hour clock) as a decimal number [01,12].\n%p  Locale's equivalent of either AM or PM.\n\nOther codes may be available on your platform.  See documentation for\nthe C library strftime function.\n"]
    ^{:go/apos {0 [957 2] 1 [957 65]} :go/pos {:colon [957 25]}} ["func:time.thread_time" "thread_time() -> float\n\nThread time for profiling: sum of the kernel and user-space CPU time."]
    ^{:go/apos {0 [958 2] 1 [958 65]} :go/pos {:colon [958 28]}} ["func:time.thread_time_ns" "thread_time() -> int\n\nThread time for profiling as nanoseconds:\nsum of the kernel and user-space CPU time."]
    ^{:go/apos {0 [959 2] 1 [959 65]} :go/pos {:colon [959 18]}} ["func:time.time" "time() -> floating-point number\n\nReturn the current time in seconds since the Epoch.\nFractions of a second may be present if the system clock provides them."]
    ^{:go/apos {0 [960 2] 1 [960 65]} :go/pos {:colon [960 21]}} ["func:time.time_ns" "time_ns() -> int\n\nReturn the current time in nanoseconds since the Epoch."]
    ^{:go/apos {0 [961 2] 1 [961 65]} :go/pos {:colon [961 19]}} ["func:time.tzset" "tzset()\n\nInitialize, or reinitialize, the local timezone to the value stored in\nos.environ['TZ']. The TZ environment variable should be specified in\nstandard Unix timezone format as documented in the tzset man page\n(eg. 'US/Eastern', 'Europe/Amsterdam'). Unknown timezones will silently\nfall back to UTC. If the TZ environment variable is not set, the local\ntimezone is set to the systems best guess of wallclock time.\nChanging the TZ environment variable without calling tzset *may* change\nthe local timezone used by methods such as localtime, but this behaviour\nshould not be relied on."]
    ^{:go/apos {0 [962 2] 1 [962 65]} :go/pos {:colon [962 34]}} ["func:unicodedata.bidirectional" "Returns the bidirectional class assigned to the character chr as string.\n\nIf no such value is defined, an empty string is returned."]
    ^{:go/apos {0 [963 2] 1 [963 65]} :go/pos {:colon [963 29]}} ["func:unicodedata.category" "Returns the general category assigned to the character chr as string."]
    ^{:go/apos {0 [964 2] 1 [964 65]} :go/pos {:colon [964 30]}} ["func:unicodedata.combining" "Returns the canonical combining class assigned to the character chr as integer.\n\nReturns 0 if no combining class is defined."]
    ^{:go/apos {0 [965 2] 1 [965 65]} :go/pos {:colon [965 28]}} ["func:unicodedata.decimal" "Converts a Unicode character into its equivalent decimal value.\n\nReturns the decimal value assigned to the character chr as integer.\nIf no such value is defined, default is returned, or, if not given,\nValueError is raised."]
    ^{:go/apos {0 [966 2] 1 [966 65]} :go/pos {:colon [966 34]}} ["func:unicodedata.decomposition" "Returns the character decomposition mapping assigned to the character chr as string.\n\nAn empty string is returned in case no such mapping is defined."]
    ^{:go/apos {0 [967 2] 1 [967 65]} :go/pos {:colon [967 26]}} ["func:unicodedata.digit" "Converts a Unicode character into its equivalent digit value.\n\nReturns the digit value assigned to the character chr as integer.\nIf no such value is defined, default is returned, or, if not given,\nValueError is raised."]
    ^{:go/apos {0 [968 2] 1 [968 65]} :go/pos {:colon [968 37]}} ["func:unicodedata.east_asian_width" "Returns the east asian width assigned to the character chr as string."]
    ^{:go/apos {0 [969 2] 1 [969 65]} :go/pos {:colon [969 34]}} ["func:unicodedata.is_normalized" "Return whether the Unicode string unistr is in the normal form 'form'.\n\nValid values for form are 'NFC', 'NFKC', 'NFD', and 'NFKD'."]
    ^{:go/apos {0 [970 2] 1 [970 65]} :go/pos {:colon [970 27]}} ["func:unicodedata.lookup" "Look up character by name.\n\nIf a character with the given name is found, return the\ncorresponding character.  If not found, KeyError is raised."]
    ^{:go/apos {0 [971 2] 1 [971 65]} :go/pos {:colon [971 29]}} ["func:unicodedata.mirrored" "Returns the mirrored property assigned to the character chr as integer.\n\nReturns 1 if the character has been identified as a \"mirrored\"\ncharacter in bidirectional text, 0 otherwise."]
    ^{:go/apos {0 [972 2] 1 [972 65]} :go/pos {:colon [972 25]}} ["func:unicodedata.name" "Returns the name assigned to the character chr as a string.\n\nIf no name is defined, default is returned, or, if not given,\nValueError is raised."]
    ^{:go/apos {0 [973 2] 1 [973 65]} :go/pos {:colon [973 30]}} ["func:unicodedata.normalize" "Return the normal form 'form' for the Unicode string unistr.\n\nValid values for form are 'NFC', 'NFKC', 'NFD', and 'NFKD'."]
    ^{:go/apos {0 [974 2] 1 [974 65]} :go/pos {:colon [974 28]}} ["func:unicodedata.numeric" "Converts a Unicode character into its equivalent numeric value.\n\nReturns the numeric value assigned to the character chr as float.\nIf no such value is defined, default is returned, or, if not given,\nValueError is raised."]
    ^{:go/apos {0 [975 2] 1 [975 65]} :go/pos {:colon [975 21]}} ["func:zlib.adler32" "Compute an Adler-32 checksum of data.\n\n  value\n    Starting value of the checksum.\n\nThe returned checksum is an integer."]
    ^{:go/apos {0 [976 2] 1 [976 65]} :go/pos {:colon [976 22]}} ["func:zlib.compress" "Returns a bytes object containing compressed data.\n\n  data\n    Binary data to be compressed.\n  level\n    Compression level, in 0-9 or -1.\n  wbits\n    The window buffer size and container format."]
    ^{:go/apos {0 [977 2] 1 [977 65]} :go/pos {:colon [977 25]}} ["func:zlib.compressobj" "Return a compressor object.\n\n  level\n    The compression level (an integer in the range 0-9 or -1; default is\n    currently equivalent to 6).  Higher compression levels are slower,\n    but produce smaller results.\n  method\n    The compression algorithm.  If given, this must be DEFLATED.\n  wbits\n    +9 to +15: The base-two logarithm of the window size.  Include a zlib\n        container.\n    -9 to -15: Generate a raw stream.\n    +25 to +31: Include a gzip container.\n  memLevel\n    Controls the amount of memory used for internal compression state.\n    Valid values range from 1 to 9.  Higher values result in higher memory\n    usage, faster compression, and smaller output.\n  strategy\n    Used to tune the compression algorithm.  Possible values are\n    Z_DEFAULT_STRATEGY, Z_FILTERED, and Z_HUFFMAN_ONLY.\n  zdict\n    The predefined compression dictionary - a sequence of bytes\n    containing subsequences that are likely to occur in the input data."]
    ^{:go/apos {0 [978 2] 1 [978 65]} :go/pos {:colon [978 19]}} ["func:zlib.crc32" "Compute a CRC-32 checksum of data.\n\n  value\n    Starting value of the checksum.\n\nThe returned checksum is an integer."]
    ^{:go/apos {0 [979 2] 1 [979 65]} :go/pos {:colon [979 24]}} ["func:zlib.decompress" "Returns a bytes object containing the uncompressed data.\n\n  data\n    Compressed data.\n  wbits\n    The window buffer size and container format.\n  bufsize\n    The initial output buffer size."]
    ^{:go/apos {0 [980 2] 1 [980 65]} :go/pos {:colon [980 27]}} ["func:zlib.decompressobj" "Return a decompressor object.\n\n  wbits\n    The window buffer size and container format.\n  zdict\n    The predefined compression dictionary.  This must be the same\n    dictionary as used by the compressor that produced the input data."]
    ^{:go/apos {0 [981 2] 1 [981 65]} :go/pos {:colon [981 31]}} ["meth:_abc._abc_data.__new__" "Create and return a new object.  See help(type) for accurate signature."]
    ^{:go/apos {0 [982 2] 1 [982 65]} :go/pos {:colon [982 42]}} ["meth:_asyncio.Future.__class_getitem__" "Futures are generic over the type of their results"]
    ^{:go/apos {0 [983 2] 1 [983 65]} :go/pos {:colon [983 32]}} ["meth:_asyncio.Future.__new__" "Create and return a new object.  See help(type) for accurate signature."]
    ^{:go/apos {0 [984 2] 1 [984 65]} :go/pos {:colon [984 46]}} ["meth:_asyncio.Future._make_cancelled_error" "Create the CancelledError to raise if the Future is cancelled.\n\nThis should only be called once when handling a cancellation since\nit erases the context exception value."]
    ^{:go/apos {0 [985 2] 1 [985 65]} :go/pos {:colon [985 42]}} ["meth:_asyncio.Future.add_done_callback" "Add a callback to be run when the future becomes done.\n\nThe callback is called with a single argument - the future object.\nIf the future is already done when this is called, the callback is\nscheduled with call_soon."]
    ^{:go/apos {0 [986 2] 1 [986 65]} :go/pos {:colon [986 31]}} ["meth:_asyncio.Future.cancel" "Cancel the future and schedule callbacks.\n\nIf the future is already done or cancelled, return False.\nOtherwise, change the future's state to cancelled, schedule the\ncallbacks and return True."]
    ^{:go/apos {0 [987 2] 1 [987 65]} :go/pos {:colon [987 34]}} ["meth:_asyncio.Future.cancelled" "Return True if the future was cancelled."]
    ^{:go/apos {0 [988 2] 1 [988 65]} :go/pos {:colon [988 29]}} ["meth:_asyncio.Future.done" "Return True if the future is done.\n\nDone means either that a result / exception are available, or that\nthe future was cancelled."]
    ^{:go/apos {0 [989 2] 1 [989 65]} :go/pos {:colon [989 34]}} ["meth:_asyncio.Future.exception" "Return the exception that was set on this future.\n\nThe exception (or None if no exception was set) is returned only if\nthe future is done.  If the future has been cancelled, raises\nCancelledError.  If the future isn't done yet, raises\nInvalidStateError."]
    ^{:go/apos {0 [990 2] 1 [990 65]} :go/pos {:colon [990 33]}} ["meth:_asyncio.Future.get_loop" "Return the event loop the Future is bound to."]
    ^{:go/apos {0 [991 2] 1 [991 65]} :go/pos {:colon [991 45]}} ["meth:_asyncio.Future.remove_done_callback" "Remove all instances of a callback from the \"call when done\" list.\n\nReturns the number of callbacks removed."]
    ^{:go/apos {0 [992 2] 1 [992 65]} :go/pos {:colon [992 31]}} ["meth:_asyncio.Future.result" "Return the result this future represents.\n\nIf the future has been cancelled, raises CancelledError.  If the\nfuture's result isn't yet available, raises InvalidStateError.  If\nthe future is done and has an exception set, this exception is\nraised."]
    ^{:go/apos {0 [993 2] 1 [993 65]} :go/pos {:colon [993 38]}} ["meth:_asyncio.Future.set_exception" "Mark the future done and set an exception.\n\nIf the future is already done when this method is called, raises\nInvalidStateError."]
    ^{:go/apos {0 [994 2] 1 [994 65]} :go/pos {:colon [994 35]}} ["meth:_asyncio.Future.set_result" "Mark the future done and set its result.\n\nIf the future is already done when this method is called, raises\nInvalidStateError."]
    ^{:go/apos {0 [995 2] 1 [995 65]} :go/pos {:colon [995 40]}} ["meth:_asyncio.Task.__class_getitem__" "Tasks are generic over the return type of their wrapped coroutines"]
    ^{:go/apos {0 [996 2] 1 [996 65]} :go/pos {:colon [996 30]}} ["meth:_asyncio.Task.__new__" "Create and return a new object.  See help(type) for accurate signature."]
    ^{:go/apos {0 [997 2] 1 [997 65]} :go/pos {:colon [997 44]}} ["meth:_asyncio.Task._make_cancelled_error" "Create the CancelledError to raise if the Task is cancelled.\n\nThis should only be called once when handling a cancellation since\nit erases the context exception value."]
    ^{:go/apos {0 [998 2] 1 [998 65]} :go/pos {:colon [998 40]}} ["meth:_asyncio.Task.add_done_callback" "Add a callback to be run when the future becomes done.\n\nThe callback is called with a single argument - the future object.\nIf the future is already done when this is called, the callback is\nscheduled with call_soon."]
    ^{:go/apos {0 [999 2] 1 [999 65]} :go/pos {:colon [999 29]}} ["meth:_asyncio.Task.cancel" "Request that this task cancel itself.\n\nThis arranges for a CancelledError to be thrown into the\nwrapped coroutine on the next cycle through the event loop.\nThe coroutine then has a chance to clean up or even deny\nthe request using try/except/finally.\n\nUnlike Future.cancel, this does not guarantee that the\ntask will be cancelled: the exception might be caught and\nacted upon, delaying cancellation of the task or preventing\ncancellation completely.  The task may also return a value or\nraise a different exception.\n\nImmediately after this method is called, Task.cancelled() will\nnot return True (unless the task was already cancelled).  A\ntask will be marked as cancelled when the wrapped coroutine\nterminates with a CancelledError exception (even if cancel()\nwas not called).\n\nThis also increases the task's count of cancellation requests."]
    ^{:go/apos {0 [1000 2] 1 [1000 65]} :go/pos {:colon [1000 32]}} ["meth:_asyncio.Task.cancelled" "Return True if the future was cancelled."]
    ^{:go/apos {0 [1001 2] 1 [1001 65]} :go/pos {:colon [1001 33]}} ["meth:_asyncio.Task.cancelling" "Return the count of the task's cancellation requests.\n\nThis count is incremented when .cancel() is called\nand may be decremented using .uncancel()."]
    ^{:go/apos {0 [1002 2] 1 [1002 65]} :go/pos {:colon [1002 27]}} ["meth:_asyncio.Task.done" "Return True if the future is done.\n\nDone means either that a result / exception are available, or that\nthe future was cancelled."]
    ^{:go/apos {0 [1003 2] 1 [1003 65]} :go/pos {:colon [1003 32]}} ["meth:_asyncio.Task.exception" "Return the exception that was set on this future.\n\nThe exception (or None if no exception was set) is returned only if\nthe future is done.  If the future has been cancelled, raises\nCancelledError.  If the future isn't done yet, raises\nInvalidStateError."]
    ^{:go/apos {0 [1004 2] 1 [1004 65]} :go/pos {:colon [1004 32]}} ["meth:_asyncio.Task.get_stack" "Return the list of stack frames for this task's coroutine.\n\nIf the coroutine is not done, this returns the stack where it is\nsuspended.  If the coroutine has completed successfully or was\ncancelled, this returns an empty list.  If the coroutine was\nterminated by an exception, this returns the list of traceback\nframes.\n\nThe frames are always ordered from oldest to newest.\n\nThe optional limit gives the maximum number of frames to\nreturn; by default all available frames are returned.  Its\nmeaning differs depending on whether a stack or a traceback is\nreturned: the newest frames of a stack are returned, but the\noldest frames of a traceback are returned.  (This matches the\nbehavior of the traceback module.)\n\nFor reasons beyond our control, only one stack frame is\nreturned for a suspended coroutine."]
    ^{:go/apos {0 [1005 2] 1 [1005 65]} :go/pos {:colon [1005 34]}} ["meth:_asyncio.Task.print_stack" "Print the stack or traceback for this task's coroutine.\n\nThis produces output similar to that of the traceback module,\nfor the frames retrieved by get_stack().  The limit argument\nis passed to get_stack().  The file argument is an I/O stream\nto which the output is written; by default output is written\nto sys.stderr."]
    ^{:go/apos {0 [1006 2] 1 [1006 65]} :go/pos {:colon [1006 43]}} ["meth:_asyncio.Task.remove_done_callback" "Remove all instances of a callback from the \"call when done\" list.\n\nReturns the number of callbacks removed."]
    ^{:go/apos {0 [1007 2] 1 [1007 65]} :go/pos {:colon [1007 29]}} ["meth:_asyncio.Task.result" "Return the result this future represents.\n\nIf the future has been cancelled, raises CancelledError.  If the\nfuture's result isn't yet available, raises InvalidStateError.  If\nthe future is done and has an exception set, this exception is\nraised."]
    ^{:go/apos {0 [1008 2] 1 [1008 65]} :go/pos {:colon [1008 31]}} ["meth:_asyncio.Task.uncancel" "Decrement the task's count of cancellation requests.\n\nThis should be used by tasks that catch CancelledError\nand wish to continue indefinitely until they are cancelled again.\n\nReturns the remaining number of cancellation requests."]
    ^{:go/apos {0 [1009 2] 1 [1009 65]} :go/pos {:colon [1009 32]}} ["meth:_blake2.blake2b.__new__" "Create and return a new object.  See help(type) for accurate signature."]
    ^{:go/apos {0 [1010 2] 1 [1010 65]} :go/pos {:colon [1010 29]}} ["meth:_blake2.blake2b.copy" "Return a copy of the hash object."]
    ^{:go/apos {0 [1011 2] 1 [1011 65]} :go/pos {:colon [1011 31]}} ["meth:_blake2.blake2b.digest" "Return the digest value as a bytes object."]
    ^{:go/apos {0 [1012 2] 1 [1012 65]} :go/pos {:colon [1012 34]}} ["meth:_blake2.blake2b.hexdigest" "Return the digest value as a string of hexadecimal digits."]
    ^{:go/apos {0 [1013 2] 1 [1013 65]} :go/pos {:colon [1013 31]}} ["meth:_blake2.blake2b.update" "Update this hash object's state with the provided bytes-like object."]
    ^{:go/apos {0 [1014 2] 1 [1014 65]} :go/pos {:colon [1014 32]}} ["meth:_blake2.blake2s.__new__" "Create and return a new object.  See help(type) for accurate signature."]
    ^{:go/apos {0 [1015 2] 1 [1015 65]} :go/pos {:colon [1015 29]}} ["meth:_blake2.blake2s.copy" "Return a copy of the hash object."]
    ^{:go/apos {0 [1016 2] 1 [1016 65]} :go/pos {:colon [1016 31]}} ["meth:_blake2.blake2s.digest" "Return the digest value as a bytes object."]
    ^{:go/apos {0 [1017 2] 1 [1017 65]} :go/pos {:colon [1017 34]}} ["meth:_blake2.blake2s.hexdigest" "Return the digest value as a string of hexadecimal digits."]
    ^{:go/apos {0 [1018 2] 1 [1018 65]} :go/pos {:colon [1018 31]}} ["meth:_blake2.blake2s.update" "Update this hash object's state with the provided bytes-like object."]
    ^{:go/apos {0 [1019 2] 1 [1019 65]} :go/pos {:colon [1019 35]}} ["meth:_bz2.BZ2Compressor.__new__" "Create and return a new object.  See help(type) for accurate signature."]
    ^{:go/apos {0 [1020 2] 1 [1020 65]} :go/pos {:colon [1020 36]}} ["meth:_bz2.BZ2Compressor.compress" "Provide data to the compressor object.\n\nReturns a chunk of compressed data if possible, or b'' otherwise.\n\nWhen you have finished providing data to the compressor, call the\nflush() method to finish the compression process."]
    ^{:go/apos {0 [1021 2] 1 [1021 65]} :go/pos {:colon [1021 33]}} ["meth:_bz2.BZ2Compressor.flush" "Finish the compression process.\n\nReturns the compressed data left in internal buffers.\n\nThe compressor object may not be used after this method is called."]
    ^{:go/apos {0 [1022 2] 1 [1022 65]} :go/pos {:colon [1022 37]}} ["meth:_bz2.BZ2Decompressor.__new__" "Create and return a new object.  See help(type) for accurate signature."]
    ^{:go/apos {0 [1023 2] 1 [1023 65]} :go/pos {:colon [1023 40]}} ["meth:_bz2.BZ2Decompressor.decompress" "Decompress *data*, returning uncompressed data as bytes.\n\nIf *max_length* is nonnegative, returns at most *max_length* bytes\nof decompressed data.  If this limit is reached and further output\ncan be produced, *self.needs_input* will be set to ``False``.  In\nthis case, the next call to *decompress()* may provide *data* as b''\nto obtain more of the output.\n\nIf all of the input data was decompressed and returned (either\nbecause this was less than *max_length* bytes, or because\n*max_length* was negative), *self.needs_input* will be set to True.\n\nAttempting to decompress data after the end of stream is reached\nraises an EOFError.  Any data found after the end of the stream is\nignored and saved in the unused_data attribute."]
    ^{:go/apos {0 [1024 2] 1 [1024 65]} :go/pos {:colon [1024 37]}} ["meth:_contextvars.Context.__new__" "Create and return a new object.  See help(type) for accurate signature."]
    ^{:go/apos {0 [1025 2] 1 [1025 65]} :go/pos {:colon [1025 34]}} ["meth:_contextvars.Context.copy" "Return a shallow copy of the context object."]
    ^{:go/apos {0 [1026 2] 1 [1026 65]} :go/pos {:colon [1026 33]}} ["meth:_contextvars.Context.get" "Return the value for `key` if `key` has the value in the context object.\n\nIf `key` does not exist, return `default`.  If `default` is not\ngiven, return None."]
    ^{:go/apos {0 [1027 2] 1 [1027 65]} :go/pos {:colon [1027 35]}} ["meth:_contextvars.Context.items" "Return all variables and their values in the context object.\n\nThe result is returned as a list of 2-tuples (variable, value)."]
    ^{:go/apos {0 [1028 2] 1 [1028 65]} :go/pos {:colon [1028 34]}} ["meth:_contextvars.Context.keys" "Return a list of all variables in the context object."]
    ^{:go/apos {0 [1029 2] 1 [1029 65]} :go/pos {:colon [1029 36]}} ["meth:_contextvars.Context.values" "Return a list of all variables' values in the context object."]
    ^{:go/apos {0 [1030 2] 1 [1030 65]} :go/pos {:colon [1030 50]}} ["meth:_contextvars.ContextVar.__class_getitem__" "ContextVars are generic over the type of their contained values"]
    ^{:go/apos {0 [1031 2] 1 [1031 65]} :go/pos {:colon [1031 40]}} ["meth:_contextvars.ContextVar.__new__" "Create and return a new object.  See help(type) for accurate signature."]
    ^{:go/apos {0 [1032 2] 1 [1032 65]} :go/pos {:colon [1032 36]}} ["meth:_contextvars.ContextVar.get" "Return a value for the context variable for the current context.\n\nIf there is no value for the variable in the current context, the\nmethod will:\n * return the value of the default argument of the method, if\n   provided; or\n * return the default value for the context variable, if it was\n   created with one; or\n * raise a LookupError."]
    ^{:go/apos {0 [1033 2] 1 [1033 65]} :go/pos {:colon [1033 38]}} ["meth:_contextvars.ContextVar.reset" "Reset the context variable.\n\nThe variable is reset to the value it had before the\n`ContextVar.set()` that created the token was used."]
    ^{:go/apos {0 [1034 2] 1 [1034 65]} :go/pos {:colon [1034 36]}} ["meth:_contextvars.ContextVar.set" "Call to set a new value for the context variable in the current context.\n\nThe required value argument is the new value for the context\nvariable.\n\nReturns a Token object that can be used to restore the variable to\nits previous value via the `ContextVar.reset()` method."]
    ^{:go/apos {0 [1035 2] 1 [1035 65]} :go/pos {:colon [1035 45]}} ["meth:_contextvars.Token.__class_getitem__" "Tokens are generic over the same type as the ContextVar which created them."]
    ^{:go/apos {0 [1036 2] 1 [1036 65]} :go/pos {:colon [1036 37]}} ["meth:_contextvars.Token.__enter__" "Enter into Token context manager."]
    ^{:go/apos {0 [1037 2] 1 [1037 65]} :go/pos {:colon [1037 36]}} ["meth:_contextvars.Token.__exit__" "Exit from Token context manager, restore the linked ContextVar."]
    ^{:go/apos {0 [1038 2] 1 [1038 65]} :go/pos {:colon [1038 35]}} ["meth:_contextvars.Token.__new__" "Create and return a new object.  See help(type) for accurate signature."]
    ^{:go/apos {0 [1039 2] 1 [1039 65]} :go/pos {:colon [1039 29]}} ["meth:_csv.Dialect.__new__" "Create and return a new object.  See help(type) for accurate signature."]

    ^{:go/apos {0 [265 2] 1 [265 65]} :go/pos {:colon [265 24]}} ["func:_opcode.has_arg" "Return True if the opcode uses its oparg, False otherwise."]
    ^{:go/apos {0 [266 2] 1 [266 65]} :go/pos {:colon [266 26]}} ["func:_opcode.has_const" "Return True if the opcode accesses a constant, False otherwise."]
    ^{:go/apos {0 [267 2] 1 [267 65]} :go/pos {:colon [267 24]}} ["func:_opcode.has_exc" "Return True if the opcode sets an exception handler, False otherwise."]
    ^{:go/apos {0 [268 2] 1 [268 65]} :go/pos {:colon [268 25]}} ["func:_opcode.has_free" "Return True if the opcode accesses a free variable, False otherwise.\n\nNote that 'free' in this context refers to names in the current scope\nthat are referenced by inner scopes or names in outer scopes that are\nreferenced from this scope. It does not include references to global\nor builtin scopes."]
    ^{:go/apos {0 [269 2] 1 [269 65]} :go/pos {:colon [269 25]}} ["func:_opcode.has_jump" "Return True if the opcode has a jump target, False otherwise."]

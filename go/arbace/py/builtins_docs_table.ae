    ^{:go/apos {0 [1291 2] 1 [1291 65]} :go/pos {:colon [1291 35]}} ["meth:_pickle.Pickler.__sizeof__" "Returns size in memory, in bytes."]
    ^{:go/apos {0 [1292 2] 1 [1292 65]} :go/pos {:colon [1292 35]}} ["meth:_pickle.Pickler.clear_memo" "Clears the pickler's \"memo\".\n\nThe memo is the data structure that remembers which objects the\npickler has already seen, so that shared or recursive objects are\npickled by reference and not by value.  This method is useful when\nre-using picklers."]
    ^{:go/apos {0 [1293 2] 1 [1293 65]} :go/pos {:colon [1293 29]}} ["meth:_pickle.Pickler.dump" "Write a pickled representation of the given object to the open file."]
    ^{:go/apos {0 [1294 2] 1 [1294 65]} :go/pos {:colon [1294 44]}} ["meth:_pickle.PicklerMemoProxy.__reduce__" "Implement pickle support."]
    ^{:go/apos {0 [1295 2] 1 [1295 65]} :go/pos {:colon [1295 39]}} ["meth:_pickle.PicklerMemoProxy.clear" "Remove all items from memo."]
    ^{:go/apos {0 [1296 2] 1 [1296 65]} :go/pos {:colon [1296 38]}} ["meth:_pickle.PicklerMemoProxy.copy" "Copy the memo to a new object."]
    ^{:go/apos {0 [1297 2] 1 [1297 65]} :go/pos {:colon [1297 34]}} ["meth:_pickle.Unpickler.__new__" "Create and return a new object.  See help(type) for accurate signature."]
    ^{:go/apos {0 [1298 2] 1 [1298 65]} :go/pos {:colon [1298 37]}} ["meth:_pickle.Unpickler.__sizeof__" "Returns size in memory, in bytes."]
    ^{:go/apos {0 [1299 2] 1 [1299 65]} :go/pos {:colon [1299 37]}} ["meth:_pickle.Unpickler.find_class" "Return an object from a specified module.\n\nIf necessary, the module will be imported. Subclasses may override\nthis method (e.g. to restrict unpickling of arbitrary classes and\nfunctions).\n\nThis method is called whenever a class or a function object is\nneeded.  Both arguments passed are str objects."]
    ^{:go/apos {0 [1300 2] 1 [1300 65]} :go/pos {:colon [1300 31]}} ["meth:_pickle.Unpickler.load" "Load a pickle.\n\nRead a pickled object representation from the open file object given\nin the constructor, and return the reconstituted object hierarchy\nspecified therein."]
    ^{:go/apos {0 [1301 2] 1 [1301 65]} :go/pos {:colon [1301 46]}} ["meth:_pickle.UnpicklerMemoProxy.__reduce__" "Implement pickling support."]
    ^{:go/apos {0 [1302 2] 1 [1302 65]} :go/pos {:colon [1302 41]}} ["meth:_pickle.UnpicklerMemoProxy.clear" "Remove all items from memo."]
    ^{:go/apos {0 [1303 2] 1 [1303 65]} :go/pos {:colon [1303 40]}} ["meth:_pickle.UnpicklerMemoProxy.copy" "Copy the memo to a new object."]
    ^{:go/apos {0 [1304 2] 1 [1304 65]} :go/pos {:colon [1304 45]}} ["meth:_queue.SimpleQueue.__class_getitem__" "SimpleQueues are generic over the type of their contents"]
    ^{:go/apos {0 [1305 2] 1 [1305 65]} :go/pos {:colon [1305 35]}} ["meth:_queue.SimpleQueue.__new__" "Create and return a new object.  See help(type) for accurate signature."]
    ^{:go/apos {0 [1306 2] 1 [1306 65]} :go/pos {:colon [1306 33]}} ["meth:_queue.SimpleQueue.empty" "Return True if the queue is empty, False otherwise (not reliable!)."]
    ^{:go/apos {0 [1307 2] 1 [1307 65]} :go/pos {:colon [1307 31]}} ["meth:_queue.SimpleQueue.get" "Remove and return an item from the queue.\n\nIf optional args 'block' is true and 'timeout' is None (the\ndefault), block if necessary until an item is available.  If\n'timeout' is a non-negative number, it blocks at most 'timeout'\nseconds and raises the Empty exception if no item was available\nwithin that time.\nOtherwise ('block' is false), return an item if one is immediately\navailable, else raise the Empty exception ('timeout' is ignored\nin that case)."]
    ^{:go/apos {0 [1308 2] 1 [1308 65]} :go/pos {:colon [1308 38]}} ["meth:_queue.SimpleQueue.get_nowait" "Remove and return an item from the queue without blocking.\n\nOnly get an item if one is immediately available. Otherwise\nraise the Empty exception."]
    ^{:go/apos {0 [1309 2] 1 [1309 65]} :go/pos {:colon [1309 31]}} ["meth:_queue.SimpleQueue.put" "Put the item on the queue.\n\nThe optional 'block' and 'timeout' arguments are ignored, as this\nmethod never blocks.  They are provided for compatibility with the\nQueue class."]
    ^{:go/apos {0 [1310 2] 1 [1310 65]} :go/pos {:colon [1310 38]}} ["meth:_queue.SimpleQueue.put_nowait" "Put an item into the queue without blocking.\n\nThis is exactly equivalent to `put(item)` and is only provided\nfor compatibility with the Queue class."]
    ^{:go/apos {0 [1311 2] 1 [1311 65]} :go/pos {:colon [1311 33]}} ["meth:_queue.SimpleQueue.qsize" "Return the approximate size of the queue (not reliable!)."]

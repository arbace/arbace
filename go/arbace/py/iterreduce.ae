angeiter_reduce)"] [349 28 "// PyLong_AsLong"] [389 2 "// setiter_reduce: a copy of the iterator drained into a list"] [410 2 "// __length_hint__ of the iterators (the *_len of each file)"] [489 2 "// list_reverseiterator"] [540 2 "// deque's iterators: (type, (deque, consumed)), made again by consuming that many (dequeiter_new)"] [544 26 "// size - counter, the counter 0 at the end"] [583 1 "// rangeReverse is range_reverse: range(start+(n-1)*step, start-step, -step), the int version when start, stop, step, -step,"] [584 1 "// start-step and the length are all C longs."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[31 24] [40 47] [41 24] [62 49] [102 15] [102 36] [103 25] [115 48] [124 50] [235 30] [269 32] [317 31] [346 50] [364 50] [383 49] [448 28] [455 29] [461 33] [482 30] [505 49] [534 34] [564 34] [569 14] [569 21]]} (go/file "iterreduce.go" :imports [



  [^{:val 4 :go/pos {:name-pos [28 2]}} workSock] ; an open socket's ResourceWarning and close (sock_finalize)
  [^{:val 8 :go/pos {:name-pos [29 2]}} workAgen] ; an async generator's awaitable never awaited (async_gen_asend_finalize)
  [^{:val 16 :go/pos {:name-pos [30 2]}} workFin]) ; a built-in type's tp_finalize, the record's fin (TrackFinalizer, queue 241)




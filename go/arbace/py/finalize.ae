;; Finalization (PYS9 (a); doc/python/PYTHON-SURVEY.md, "Design: 218"): pyi has no reference counts, so an object's
;; death is Go's collector's finding. A tracked object (one with weak references, or with a finalizer's work due: a
;; class's __del__, a generator's close, a socket's warning) has a Go finalizer and a record in tracked, keyed by its
;; address and never holding it. Go's finalizer goroutine only moves the dead object into finQueue and sets the eval
;; breaker's bit; the thread holding the GIL drains the queue (handleEvalBreaker, gc.collect). The order is reference
;; counting's (subtype_dealloc): the work first, the Go finalizer set again without it (PEP 442: once only); found
;; unreachable again, the weak references are cleared (in the Go finalizer, under finMu, so no weak reference yields
;; the object after it) and their callbacks called in CPython's list order. Go's heap does not move and an object with
;; a finalizer is kept until the finalizer ran, so a weak reference's hidden address is valid while it is not cleared.


^{:go/pos {:doc [26 1] :lparen [27 7] :rparen [33 1] :tok-pos [27 1]}} (go/const "the work a tracked object's death runs\n"
  [^{:val 1 :go/pos {:name-pos [28 2]}} workDel ^{:go/apos {1 [28 13]} :go/pos {:op-pos [28 15]}} (<< 1 ^{:go/pos {:name-pos [28 18]}} iota)] ; its class's __del__ (slot_tp_finalize)
  [^{:val 2 :go/pos {:name-pos [29 2]}} workGen] ; a generator's, coroutine's or async generator's finalization (_PyGen_Finalize)
  [^{:val 4 :go/pos {:name-pos [30 2]}} workSock] ; an open socket's ResourceWarning and close (sock_finalize)
  [^{:val 8 :go/pos {:name-pos [31 2]}} workAgen] ; an async generator's awaitable never awaited (async_gen_asend_finalize)
  [^{:val 16 :go/pos {:name-pos [32 2]}} workFin]) ; a built-in type's tp_finalize, the record's fin (TrackFinalizer, queue 241)



^{:go/pos {:doc [35 1] :tok-pos [36 1]}} (go/type ^{:go/pos {:name-pos [36 6]}} finTrack "finTrack is a tracked object's record.\n" ^{:go/pos {:lbrace [36 22] :rbrace [50 1] :struct [36 15]}} (struct
    ^{:tag ^{:go/pos {:dot [37 15] :name-pos [37 16] :x-pos [37 8]}} reflect/Type :go/pos {:name-pos [37 2]}} elem ; the object's pointer's element type, to rebuild it from its address
    ^{:tag ^{:go/pos {:lbrack [38 8]}} (slice ^{:go/pos {:star [38 10]}} (* ^{:go/pos {:name-pos [38 11]}} WeakRef)) :go/pos {:name-pos [38 2]}} refs ; its weak references in CPython's order: the basic ref, the basic proxy, then the newest first
    ^{:tag ^{:go/pos {:name-pos [39 8]}} int :go/pos {:name-pos [39 2]}} work ; the work due at its death
    ^{:tag ^{:go/pos {:name-pos [40 8]}} int64 :go/pos {:name-pos [40 2]}} ident ; its identity once hashed (identityHash; an instance keeps it in its own field)

    ^{:tag ^{:go/pos {:name-pos [42 10]}} bool :doc "aioTask: a registered asyncio task past the strong list (builtins_asyncio.go's registry, queue 224)\n" :go/pos {:name-pos [42 2]}} aioTask


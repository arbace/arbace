  [^{:val 2 :go/pos {:name-pos [27 2]}} workGen] ; a generator's, coroutine's or async generator's finalization (_PyGen_Finalize)
  [^{:val 4 :go/pos {:name-pos [28 2]}} workSock]) ; an open socket's ResourceWarning and close (sock_finalize)




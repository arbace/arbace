s \"an unknown constant\", test_configparser's '\\N{RS}')."] [529 1 "// emptyBytes is the empty bytes constant."] [532 1 "// internableConst is codeobject.c's should_intern_string (the default build): s matches [a-zA-Z0-9_]*."] [560 27 "// b'' is one object, as CPython's empty bytes singleton (queue 211)"] [563 21 "// UTF-16 units of a str with a lone surrogate, pairs combined here"] [601 1 "// joinedConst writes a {:joined [PART ...]} constant's text: a str PART as it is, {:named NAME} the code point of"] [602 1 "// \\N{NAME} (ucdLookupName), a nested {:joined ...} (the compiler's concatenation of such strs) in turn."] [621 5 "// a part with a lone surrogate, its WTF-8 written as it is: a surrogate pair split by the compiler stays two"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[95 24] [111 13] [111 31] [169 16] [169 30] [170 17] [299 36] [302 33] [304 30] [322 37] [324 44] [337 31] [342 36] [376 36] [378 27] [389 38] [414 31] [418 30] [422 33] [431 28] [464 29] [496 33] [503 37] [534 12] [534 24] [566 13] [566 29] [569 34] [580 32] [592 22] [610 32] [614 27] [615 33] [620 31]] :go/trails [[254 64] [259 85] [264 112]]} (go/file "load.go" :imports [



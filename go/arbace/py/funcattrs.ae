s the IR"] [510 15 "// a new code object (the copy took the original's)"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[69 46] [93 41] [169 27] [175 113] [194 26] [268 24] [273 24] [278 24] [283 24] [288 24] [312 25] [322 24] [329 23] [334 51] [366 27] [477 26] [498 27] [500 58]]} (go/file "funcattrs.go" :imports [])


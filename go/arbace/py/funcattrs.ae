eplaces them)"] [490 5 "// co_consts reads the view's order: each constant replaced where the IR holds it (queue 229)"] [511 6 "// the view's (bytecode_asm.go): the machine runs the IR"] [524 15 "// a new code object (the copy took the original's)"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[69 46] [93 41] [169 27] [175 113] [208 26] [282 24] [287 24] [292 24] [297 24] [302 24] [326 25] [336 24] [343 23] [348 51] [380 27] [491 26] [512 27] [514 58]]} (go/file "funcattrs.go" :imports [])


(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// Attribute lookup (PY5c; CPython's _PyType_Lookup, PyObject_GenericGetAttr and SetAttr,"] [6 1 "// type_getattro and type_setattro): data descriptors before the instance's __dict__, non-data"] [7 1 "// descriptors after; the built-in types' attributes (tp_getset, tp_members) as GetSets beside their"] [8 1 "// dictionaries, and their slots seen as methods (slot wrappers) as CPython's add_operators puts them"] [9 1 "// in the type's dictionary."] [11 1 "// GetSet is a built-in type's attribute (getset_descriptor): Get, and Set (nil: read-only; v nil:"] [12 1 "// delete)."] [26 1 "// AddGetSet declares a built-in type's attribute."] [37 1 "// AddMethod puts a built-in method in a built-in type's dictionary (bound to the instance by"] [38 1 "// attribute lookup: fn gets the instance first)."] [43 1 "// AddToDict puts v in a built-in type's dictionary once the runtime is ready (a dictionary's keys"] [44 1 "// are hashed by str's slot, which an init function may run before)."] [51 1 "// readyDataModel completes the built-in types' dictionaries, once."] [67 1 "// lookupAttr is _PyType_Lookup over t's MRO: each type's dictionary, its GetSets, and for a built-in"] [68 1 "// type its slots as slot wrappers; the value and the type it was found on."] [91 1 "// The type attribute cache (PY6-core, queue 200, after PY8's measurement: lookupAttr was 31-35% of a run;"] [92 1 "// CPython's method cache over tp_version_tag): each type keeps its lookups' answers by name, the absent ones"] [93 1 "// too, and drops them all when typeEpoch moves. typeEpoch moves on any change to a type's namespace (the dicts"] [94 1 "// marked ofType: an insertion, a replaced value, a deletion, a clear, popitem), on a getset added, and on an"] [95 1 "// MRO set (c3MRO's and readyTypes'), so an answer is never older than the namespaces it was read from."] [103 1 "// lookupAttrMRO is _PyType_Lookup's walk: t's MRO's dicts, then the getsets and slot wrappers of each."] [124 1 "// superLookup is lookupAttr over the part of start's MRO after typ (super's lookup)."] [153 1 "// descrGet is a found attribute's __get__ (obj nil: from the class); a built-in method found on a"] [154 1 "// built-in type is bound to obj (its value for a built-in subclass's instance)."] [160 61 "// object's methods take the instance itself (PY6d's REQUEST: __reduce_ex__'s class)"] [171 1 "// methodDescrs are the built-in types' methods that left their type's dict through the class (T.name: CPython's"] [172 1 "// method_descriptor), each with its type: put in a class's dict (socket.socket.getsockname = saved, test_socket's"] [173 1 "// test_injected_authentication_failure) such a method still binds to the instance, as a method descriptor does,"] [174 1 "// where a built-in function there (class A: f = len) does not."] [179 1 "// instanceDict is o's __dict__, nil when it has none."] [200 1 "// The attribute instructions' inline caches (202b; PEP 659's LOAD_ATTR and STORE_ATTR caches, after the type"] [201 1 "// version tag): load-attr and store-attr of an object whose type takes the generic path keep, per instruction, the"] [202 1 "// type they last saw and lookupAttr's answer for it, valid while typeEpoch has not moved (the epoch the type"] [203 1 "// attribute cache's own answers hold by, attr.go's lookupAttr), so a hit compares two words where lookupAttr hashes"] [204 1 "// the name into the type's cache."] [212 1 "// lookupAttrAt is lookupAttr(tp, name) through the cache of c's instruction pc."] [226 1 "// loadAttrAt is load-attr at c's instruction pc: GetAttr, its generic path's lookup through the instruction's cache."] [240 1 "// storeAttrAt is store-attr (v nil: delete-attr) at c's instruction pc: SetAttr, its generic path's lookup through"] [241 1 "// the instruction's cache."] [251 1 "// GenericGetAttr is object.__getattribute__."] [258 1 "// genericGetAttrFound is GenericGetAttr with lookupAttr's answer for o's type tp."] [276 1 "// GenericSetAttr is object.__setattr__ (v nil: object.__delattr__)."] [283 1 "// genericSetAttrFound is GenericSetAttr with lookupAttr's answer for o's type tp."] [311 1 "// typeGetAttr is type.__getattribute__: the metatype's data descriptors, then the type's MRO, then"] [312 1 "// the metatype's other attributes."] [324 29 "// a method descriptor leaving its type"] [339 1 "// typeSetAttr is type.__setattr__: a class's attribute, its slots updated for a special one."] [369 1 "// SetAttr is setattr(o, name, v); v nil is delattr."] [377 1 "// DelAttr is delattr(o, name)."] [380 1 "// GetAttrOptional is getattr(o, name) with nil, not an AttributeError, when there is no such attribute."] [383 1 "// LookupSpecial is a special method's lookup on o's type (_PyObject_LookupSpecial): bound to o, or nil."] [392 1 "// getAttrOptional is getattr(o, name, None) without the None: nil when there is no such attribute."] [404 1 "// callBound calls a method found on self's type bound to self (CPython's vectorcall of an unbound"] [405 1 "// method with self first, or __get__ then the call); owner is the type of self's MRO it was found on"] [406 1 "// (lookupAttr's), nil when not known."] [415 4 "// a built-in function in a class's dict is no method descriptor: called without the instance, as"] [416 4 "// descrGet's rule and lookup_maybe_method (class C: __call__ = len; typing.NewType's __call__ = _idfunc,"] [417 4 "// queue 207)"] [421 4 "// object's own methods take the instance itself (descrGet's rule, PY6d's R2), as for"] [422 4 "// object.__reduce_ex__ of a class deriving from a built-in type (PY6g's F2: random.Random's pickling)"] [475 2 "// a descriptor's own attributes (PY6a: inspect's getattr_static reads __name__ and __objclass__)"] [488 2 "// object's attributes"] [523 2 "// BaseException's attributes (exceptions.c's BaseException_getset and members)"] [582 1 "// unpackAll is the items of an iterable."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[81 31] [108 31] [112 28] [116 35]
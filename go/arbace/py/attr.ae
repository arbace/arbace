(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// Attribute lookup (PY5c; CPython's _PyType_Lookup, PyObject_GenericGetAttr and SetAttr,"] [6 1 "// type_getattro and type_setattro): data descriptors before the instance's __dict__, non-data"] [7 1 "// descriptors after; the built-in types' attributes (tp_getset, tp_members) as GetSets beside their"] [8 1 "// dictionaries, and their slots seen as methods (slot wrappers) as CPython's add_operators puts them"] [9 1 "// in the type's dictionary."] [11 1 "// GetSet is a built-in type's attribute (getset_descriptor): Get, and Set (nil: read-only; v nil:"] [12 1 "// delete)."] [18 2 "// member: a PyMemberDef's attribute, member_descriptor where CPython has one (types.MemberDescriptorType is"] [19 2 "// type(FunctionType.__globals__)); read-only ones say \"readonly attribute\""] [21 2 "// shared: 3.15's one __dict__ or __weakref__ descriptor of every class (object's; queue 237), its repr without"] [22 2 "// an owner"] [24 2 "// doc is the PyGetSetDef's doc (queue 304: subtype_getsets_full's \"dictionary for instance variables\" and \"list"] [25 2 "// of weak references to the object\"; the built-in types' getsets keep none), \"\" for None"] [40 1 "// getsetOrder: each type's getsets' names in their declaration order (its __dict__'s order, queue 313)"] [43 1 "// AddGetSet declares a built-in type's attribute."] [57 1 "// AddMember declares a built-in type's PyMemberDef attribute."] [63 1 "// AddMethod puts a built-in method in a built-in type's dictionary (bound to the instance by"] [64 1 "// attribute lookup: fn gets the instance first)."] [69 1 "// AddToDict puts v in a built-in type's dictionary once the runtime is ready (a dictionary's keys"] [70 1 "// are hashed by str's slot, which an init function may run before)."] [89 1 "// readyDataModel completes the built-in types' dictionaries, once."] [105 1 "// lookupAttr is _PyType_Lookup over t's MRO: each type's dictionary, its GetSets, and for a built-in"] [106 1 "// type its slots as slot wrappers; the value and the type it was found on."] [129 1 "// The type attribute cache (PY6-core, queue 200, after PY8's measurement: lookupAttr was 31-35% of a run;"] [130 1 "// CPython's method cache over tp_version_tag): each type keeps its lookups' answers by name, the absent ones"] [131 1 "// too, and drops them all when typeEpoch moves. typeEpoch moves on any change to a type's namespace (the dicts"] [132 1 "// marked ofType: an insertion, a replaced value, a deletion, a clear, popitem), on a getset added, and on an"] [133 1 "// MRO set (c3MRO's and readyTypes'), so an answer is never older than the namespaces it was read from."] [141 1 "// lookupAttrMRO is _PyType_Lookup's walk: t's MRO's dicts, then the getsets and slot wrappers of each."] [162 1 "// superLookup is lookupAttr over the part of start's MRO after typ (super's lookup)."] [191 1 "// descrGet is a found attribute's __get__ (obj nil: from the class); a built-in method found on a"] [192 1 "// built-in type is bound to obj (its value for a built-in subclass's instance)."] [198 3 "// object's methods take the instance itself (PY6d's REQUEST: __reduce_ex__'s class); objectDescr is"] [199 3 "// methodDescrs[b] == ObjectType without the map's lookup on every method's binding (queue 210)"] [211 1 "// methodDescrs are the built-in types' methods that left their type's dict through the class (T.name: CPython's"] [212 1 "// method_descriptor), each with its type: put in a class's dict (socket.socket.getsockname = saved, test_socket's"] [213 1 "// test_injected_authentication_failure) such a method still binds to the instance, as a method descriptor does,"] [214 1 "// where a built-in function there (class A: f = len) does not."] [219 1 "// instanceDict is o's __dict__, nil when it has none."] [224 15 "// OrderedDict's tp_dictoffset (py-mods-1122)"] [251 18 "// queue 304: a property subclass's instance"] [258 38 "// _io's objects (iobase's tp_dictoffset; queue 545)"] [267 1 "// InstanceDictHook is the __dict__ of an object of another package (arbace/pyctypes' C-born objects whose type has a"] [268 1 "// tp_dictoffset: the dict their memory holds; queue 268), nil when it has none."] [271 1 "// The attribute instructions' inline caches (202b; PEP 659's LOAD_ATTR and STORE_ATTR caches, after the type"] [272 1 "// version tag): load-attr and store-attr of an object whose type takes the generic path keep, per instruction, the"] [273 1 "// type they last saw and lookupAttr's answer for it, valid while typeEpoch has not moved (the epoch the type"] [274 1 "// attribute cache's own answers hold by, attr.go's lookupAttr), so a hit compares two words where lookupAttr hashes"] [275 1 "// the name into the type's cache."] [281 2 "// di: where the instance's dict held the name when it was last found there (queue 210; CPython's"] [282 2 "// LOAD_ATTR_INSTANCE_VALUE's index): an entry holding the name's very str (co_names are interned) is the name's"] [284 2 "// class: the entry answers the load of the attribute from the class tp itself (queue 305, CPython's LOAD_ATTR_CLASS):"] [285 2 "// tp's metatype is type, d was found on a class statement's class of tp's MRO, and type has no data descriptor of"] [286 2 "// the name, so type.__getattribute__ answers d bound by its __get__ (None, tp), or d"] [290 1 "// lookupAttrAt is lookupAttr(tp, name) through the cache of c's instruction pc."] [296 1 "// attrSite is an instruction's caches: the last types it saw, the latest first (queue 210: richards' four task"] [297 1 "// classes share their methods' instructions, and one entry missed at every change of type)."] [302 1 "// attrSites are every code's inline caches (queue 241), swept by gc.collect: an entry whose epoch is past holds a type"] [303 1 "// and the value found, which CPython's caches (a version tag) do not keep alive (WeakMethod's test_method_dead: the"] [304 1 "// method deleted from its class stays in the site that loaded it). attrSwept is the epoch of the last sweep."] [310 1 "// sweepAttrSites clears the stale entries of every inline cache, once per type epoch."] [330 1 "// attrICAt is c's instruction pc's cache entry holding lookupAttr(tp, name)."] [338 3 "// made at the instruction's first lookup (queue 305: a site, 192 bytes, for every instruction of a code that"] [339 3 "// ran one attribute instruction was a quarter of a program's heap, each Go collection's to mark)"] [359 34 "// tp's old entry, else the oldest, dropped"] [364 1 "// dictEntryAt is the position of the entry of d holding name itself, through the hint *di (kept up to date); -1"] [365 1 "// when d does not hold name (an equal str in its place is found, but not kept as the hint)."] [377 1 "// loadAttrAt is load-attr at c's instruction pc: GetAttr, its generic path's lookup through the instruction's cache."] [393 3 "// genericGetAttrFound's instance dict through the hint (queue 210)"] [415 1 "// typeAttrAt is load-attr of name from the class t (its metatype type) at c's instruction pc: typeGetAttr, its answer"] [416 1 "// kept in the instruction's cache entry for t when it is a class statement's attribute that type's own data"] [417 1 "// descriptors do not shadow (queue 305: deltablue's and pprint's class attributes, typeGetAttr 4-8% of their runs; the"] [418 1 "// entry is valid while typeEpoch holds, as every entry of the cache)."] [430 2 "// the entry may have moved while typeGetAttr ran Python code (a __get__): kept only when it still holds t's answer"] [439 1 "// storeAttrAt is store-attr (v nil: delete-attr) at c's instruction pc: SetAttr, its generic path's lookup through"] [440 1 "// the instruction's cache."] [449 3 "// genericSetAttrFound's dict.Set through the hint: a value replaced in place (queue 210)"] [452 5 "// store_instance_attr's MODIFIED, the value the same or not (queue 274)"] [462 21 "// the usual case: the name inserted last"] [465 20 "// the room of the class's next instances' dicts (newDictSized)"] [472 1 "// GenericGetAttr is object.__getattribute__."] [479 1 "// genericGetAttrFound is GenericGetAttr with lookupAttr's answer for o's type tp."] [497 1 "// GenericSetAttr is object.__setattr__ (v nil: object.__delattr__)."] [504 1 "// genericSetAttrFound is GenericSetAttr with lookupAttr's answer for o's type tp."] [532 1 "// typeGetAttr is type.__getattribute__: the metatype's data descriptors, then the type's MRO, then"] [533 1 "// the metatype's other attributes."] [543 3 "// _PyType_Lookup of t's MRO assigns the version tag a watched modification clears (queue 274); the"] [544 3 "// metatype's data descriptors (__name__, __dict__) answer before it"] [551 29 "// a method descriptor leaving its type"] [559 4 "// a built-in type's class and static methods know their type for __qualname__"] [582 1 "// typeSetAttr is type.__setattr__: a class's attribute, its slots updated for a special one."] [593 3 "// tp_name: a static type's module and name ('compression.zstd.ZstdCompressor'; builtins' bare), a frozen class's"] [594 3 "// name (queue 270b: PyType_Freeze)"] [613 26 "// a C type's slots are its own (queue 270b: its dict changes alone)"] [616 19 "// type_setattro's PyType_Modified: the type watchers (queue 274)"] [621 1 "// SetAttr is setattr(o, name, v); v nil is delattr."] [629 1 "// DelAttr is delattr(o, name)."] [632 1 "// GetAttrOptional is getattr(o, name) with nil, not an AttributeError, when there is no such attribute."] [635 1 "// LookupSpecial is a special method's lookup on o's type (_PyObject_LookupSpecial): bound to o, or nil."] [644 1 "// getAttrOptional is getattr(o, name, None) without the None: nil when there is no such attribute."] [656 1 "// callBound calls a method found on self's type bound to self (CPython's vectorcall of an unbound"] [657 1 "// method with self first, or __get__ then the call); owner is the type of self's MRO it was found on"] [658 1 "// (lookupAttr's), nil when not known."] [665 4 "// wrapperdescr_call's check (bpo-37619: a wrapper of the wrong class in a class's dict)"] [671 4 "// a built-in function in a class's dict is no method descriptor: called without the instance, as"] [672 4 "// descrGet's rule and lookup_maybe_method (class C: __call__ = len; typing.NewType's __call__ = _idfunc,"] [673 4 "// queue 207)"] [677 4 "// object's own methods take the instance itself (descrGet's rule, PY6d's R2), as for"] [678 4 "// object.__reduce_ex__ of a class deriving from a built-in type (PY6g's F2: random.Random's pickling)"] [734 2 "// a descriptor's own attributes (PY6a: inspect's getattr_static reads __name__ and __objclass__)"] [755 2 "// object's attributes"] [757 2 "// a built-in type with a dictionary shows it itself (BaseException's, function's, module's); a class's is"] [758 2 "// subtype_getsets_full's, in the dict of the class that adds it (addLayoutDescrs): object has none"] [766 2 "// BaseException's attributes (exceptions.c's BaseException_getset and members)"] [825 1 "// unpackAll is the items of an iterable."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[76 32] [80 32] [119 31] [146 31] [150 28] [154 35] [166 6] [166 20] [172 9] [172 23] [175 31] [179 28] [183 35] [194 26] [205 33] [322 24] [345 23] [367 18] [392 27] [400 41] [423 34] [432 50] [448 27] [450 21] [458 32] [461 34] [464 37] [485 28] [508 34] [547 33] [548 27] [562 34] [566 34] [571 34] [588 35] [609 38] [623 32] [685 33] [706 18] [742 26] [808 58]]} (go/file "attr.go" :imports [


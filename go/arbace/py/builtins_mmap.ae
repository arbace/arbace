

(in-ns 'go.arbace.py) ^{:go/comments [[1 1 "//go:build linux"] [11 1 "// The module mmap (PYS22 (a), queue 204; Modules/mmapmodule.c of CPython 3.14.10, its UNIX paths on Linux, ported"] [12 1 "// function for function with its messages, and the argument handling of Modules/clinic/mmapmodule.c.h), over Go's"] [13 1 "// syscall package (no cgo): the mapping (syscall.Mmap), reading, writing, slicing and assignment, find and rfind,"] [14 1 "// seek, move, flush (msync), madvise, resize, the context manager, the sequence of length-1 bytes. The C names are"] [15 1 "// kept (mmap prefixed). Deviations:"] [16 1 "//   - Go's syscall has no mremap: resize shrinks in place (the window shortened, the pages kept mapped) and grows by"] [17 1 "//     a new mapping (a private one's bytes copied, a shared one's from the file), where CPython's mremap may move."] [18 1 "//   - A mapping is never unmapped while the process runs: close() and a growing resize put an anonymous read-only"] [19 1 "//     zero mapping over the old pages (MAP_FIXED), so a slice of them that a caller still holds reads zeros instead"] [20 1 "//     of faulting. The file's pages are released, the address range stays reserved."] [21 1 "//   - The buffer protocol is pyi's (BytesLike: the mapped bytes themselves; WritableBytes for a writable view): pyi"] [22 1 "//     counts no exports, so close() and resize() never raise BufferError (\"exported pointers exist\"); a memoryview"] [23 1 "//     used after its mmap was closed sees no bytes."] [24 1 "//   - No sys.audit event (\"mmap.__new__\"); no dealloc (an unclosed mmap's fd stays open until exit)."] [28 1 "// access_mode"] [36 1 "// mmapObject is mmap_object (UNIX)."] [38 17 "// as syscall.Mmap returned it, or as a resize's new mapping"] [39 17 "// the window in use: mapping[:size]; nil when closed"] [41 14 "// relative to offset"] [53 1 "// BytesLike makes an mmap a bytes-like object (asBytes): the mapped bytes, none when closed."] [56 1 "// WritableBytes is the mapped bytes for a writable buffer (writableBuffer): not for ACCESS_READ."] [76 1 "// mmapRetire puts an anonymous read-only zero mapping over a mapping's pages (MAP_FIXED): never unmapped, so that a"] [77 1 "// slice of them still held reads zeros."] [88 1 "// mmapAsSsize is _As_Py_ssize_t: __index__, then PyLong_AsSsize_t."] [101 1 "// mmapIndexCheck is PyIndex_Check."] [109 1 "// mmapNumberAsSsize is PyNumber_AsSsize_t(o, exc): an overflow raised as exc."] [122 1 "// mmapCInt is getargs' \"i\": PyLong_AsLong then C int's range."] [148 1 "// close is mmap_mmap_close_impl."] [165 1 "// bytesFrom is _safe_PyBytes_FromStringAndSize: a copy."] [196 25 "/* advance past newline */"] [207 2 "/* silently 'adjust' out-of-range requests */"] [220 1 "// gfind is mmap_gfind_lock_held: _PyBytes_Find and _PyBytes_ReverseFind's index (offset start added), or -1."] [335 1 "// resize is mmap_mmap_resize_impl's UNIX path, its mremap(MREMAP_MAYMOVE) emulated (above)."] [346 2 "// Linux mremap() refuses to grow a shared anonymous mapping"] [355 20 "// mremap's EINVAL"] [411 10 "/* relative to start */"] [413 10 "/* relative to current position */"] [418 10 "/* relative to end */"] [440 2 "/* bounds check the values */"] [492 1 "// item is mmap_item (sq_item): a length-1 bytes."] [569 3 "/* Converting item or value above may have run arbitrary code (e.g. __index__) that resized or closed the\n\t\t * mmap, so bounds are only checked now, against the current size. */"] [588 3 "// PyObject_GetBuffer(value, PyBUF_SIMPLE): a class's __buffer__ (PEP 688), else a bytes-like object"] [602 3 "/* Acquiring the buffer above may have run arbitrary code (e.g. a __buffer__ method) that resized or closed\n\t\t * this mmap, so the slice bounds are only computed now, against the current size. */"] [629 1 "// mmapParseArgs is PyArg_ParseTupleAndKeywords(args, kwdict, \"in|iiiL$p\", keywords): an unnamed format, so"] [630 1 "// getargs' messages say \"function\"."] [662 1 "// mmapNew is new_mmap_object (UNIX)."] [719 3 "/* map prot to access type */"] [721 4 "/* ACCESS_DEFAULT */"] [750 3 "/* Assume the caller wants to map anonymous memory. */"] [753 3 "// _Py_dup: a non-inheritable duplicate"] [775 1 "// mmapIter is the sequence iterator over sq_item: length-1 bytes until IndexError."] [788 34 "// a subclass's repr names it (tp_name)"] [834 2 "// positional is clinic's positional-only parsing: _PyArg_CheckPositional's counts, no keywords."] [913 3 "// _Py_convert_optional_to_ssize_t"] [964 3 "// clinic's unsigned_char"] [1018 1 "// BufferValid is the exporter's check memoryview's accessors make (memoryview.go's unusable): CHECK_VALID's"] [1019 1 "// ValueError once the mmap is closed."]] :go/pos {:name [3 9] :package [3 1]} :go/semis [[62 29] [70 34] [103 22] [169 29] [181 29] [204 29] [223 29] [228 40] [232 37] [253 29] [292 29] [295 29] [307 29] [310 29] [313 29] [325 29] [329 39] [337 29] [340 31] [351 67] [381 29] [386 38] [397 88] [404 29] [434 29] [437 29] [444 29] [461 29] [467 42] [483 29] [486 66] [494 29] [504 29] [518 30] [523 28] [529 30] [539 25] [539 39] [548 29] [571 30] [583 28] [595 27] [599 42] [604 30] [618 26] [618 40] [654 12] [654 19] [681 33] [698 33] [796 27] [840 48] [906 36] [920 33] [942 30] [951 27] [982 41]]} (go/file "builtins_mmap.go" :build ["//go:build linux"] :imports [



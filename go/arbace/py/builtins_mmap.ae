(in-ns 'go.arbace.py) ^{:go/comments [[9 1 "// The module mmap (PYS22 (a), queue 204; Modules/mmapmodule.c of CPython 3.14.10, its UNIX paths on Linux, ported"] [10 1 "// function for function with its messages, and the argument handling of Modules/clinic/mmapmodule.c.h), over Go's"] [11 1 "// syscall package (no cgo): the mapping (syscall.Mmap), reading, writing, slicing and assignment, find and rfind,"] [12 1 "// seek, move, flush (msync), madvise, resize, the context manager, the sequence of length-1 bytes. The C names are"] [13 1 "// kept (mmap prefixed). Deviations:"] [14 1 "//   - Go's syscall has no mremap: resize shrinks in place (the window shortened, the pages kept mapped) and grows by"] [15 1 "//     a new mapping (a private one's bytes copied, a shared one's from the file), where CPython's mremap may move."] [16 1 "//   - A mapping is never unmapped while the process runs: close() and a growing resize put an anonymous read-only"] [17 1 "//     zero mapping over the old pages (MAP_FIXED), so a slice of them that a caller still holds reads zeros instead"] [18 1 "//     of faulting. The file's pages are released, the address range stays reserved."] [19 1 "//   - The buffer protocol is pyi's (BytesLike: the mapped bytes themselves; WritableBytes for a writable view): pyi"] [20 1 "//     counts no exports, so close() and resize() never raise BufferError (\"exported pointers exist\"); a memoryview"] [21 1 "//     used after its mmap was closed sees no bytes."] [22 1 "//   - No sys.audit event (\"mmap.__new__\"); no dealloc (an unclosed mmap's fd stays open until exit)."] [26 1 "// access_mode"] [34 1 "// mmapObject is mmap_object (UNIX)."] [36 17 "// as syscall.Mmap returned it, or as a resize's new mapping"] [37 17 "// the window in use: mapping[:size]; nil when closed"] [39 14 "// relative to offset"] [51 1 "// BytesLike makes an mmap a bytes-like object (asBytes): the mapped bytes, none when closed."] [54 1 "// WritableBytes is the mapped bytes for a writable buffer (writableBuffer): not for ACCESS_READ."] [74 1 "// mmapRetire puts an anonymous read-only zero mapping over a mapping's pages (MAP_FIXED): never unmapped, so that a"] [75 1 "// slice of them still held reads zeros."] [86 1 "// mmapAsSsize is _As_Py_ssize_t: __index__, then PyLong_AsSsize_t."] [99 1 "// mmapIndexCheck is PyIndex_Check."] [107 1 "// mmapNumberAsSsize is PyNumber_AsSsize_t(o, exc): an overflow raised as exc."] [120 1 "// mmapCInt is getargs' \"i\": PyLong_AsLong then C int's range."] [146 1 "// close is mmap_mmap_close_impl."] [163 1 "// bytesFrom is _safe_PyBytes_FromStringAndSize: a copy."] [194 25 "/* advance past newline */"] [205 2 "/* silently 'adjust' out-of-range requests */"] [218 1 "// gfind is mmap_gfind_lock_held: _PyBytes_Find and _PyBytes_ReverseFind's index (offset start added), or -1."] [333 1 "// resize is mmap_mmap_resize_impl's UNIX path, its mremap(MREMAP_MAYMOVE) emulated (above)."] [344 2 "// Linux mremap() refuses to grow a shared anonymous mapping"] [353 20 "// mremap's EINVAL"] [409 10 "/* relative to start */"] [411 10 "/* relative to current position */"] [416 10 "/* relative to end */"] [438 2 "/* bounds check the values */"] [490 1 "// item is mmap_item (sq_item): a length-1 bytes."] [567 3 "/* Converting item or value above may have run arbitrary code (e.g. __index__) that resized or closed the\n\t\t * mmap, so bounds are only checked now, against the current size. */"] [586 3 "// PyObject_GetBuffer(value, PyBUF_SIMPLE): a class's __buffer__ (PEP 688), else a bytes-like object"] [600 3 "/* Acquiring the buffer above may have run arbitrary code (e.g. a __buffer__ method) that resized or closed\n\t\t * this mmap, so the slice bounds are only computed now, against the current size. */"] [627 1 "// mmapParseArgs is PyArg_ParseTupleAndKeywords(args, kwdict, \"in|iiiL$p\", keywords): an unnamed format, so"] [628 1 "// getargs' messages say \"function\"."] [660 1 "// mmapNew is new_mmap_object (UNIX)."] [717 3 "/* map prot to access type */"] [719 4 "/* ACCESS_DEFAULT */"] [748 3 "/* Assume the caller wants to map anonymous memory. */"] [751 3 "// _Py_dup: a non-inheritable duplicate"] [773 1 "// mmapIter is the sequence iterator over sq_item: length-1 bytes until IndexError."] [786 34 "// a subclass's repr names it (tp_name)"] [832 2 "// positional is clinic's positional-only parsing: _PyArg_CheckPositional's counts, no keywords."] [911 3 "// _Py_convert_optional_to_ssize_t"] [962 3 "// clinic's unsigned_char"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[60 29] [68 34] [101 22] [167 29] [179 29] [202 29] [221 29] [226 40] [230 37] [251 29] [290 29] [293 29] [305 29] [308 29] [311 29] [323 29] [327 39] [335 29] [338 31] [349 67] [379 29] [384 38] [395 88] [402 29] [432 29] [435 29] [442 29] [459 29] [465 42] [481 29] [484 66] [492 29] [502 29] [516 30] [521 28] [527 30] [537 25] [537 39] [546 29] [569 30] [581 28] [593 27] [597 42] [602 30] [616 26] [616 40] [652 12] [652 19] [679 33] [696 33] [794 27] [838 48] [904 36] [918 33] [940 30] [949 27] [980 41]]} (go/file "builtins_mmap.go" :imports [



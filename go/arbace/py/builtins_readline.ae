th GNU readline's globals the module reads and sets."] [46 56 "// _history_length: write_history_file's truncation, -1 none"] [49 70 "// history-size, -1 unstifled"] [50 70 "// key sequence -> function or \"\\x00\"+macro"] [53 2 "// the line being edited (rl_line_buffer, rl_point) while input() reads one"] [60 21 "// _PyOS_ReadlineLock: one input() at a time on the terminal"] [88 3 "// rl_initialize: the init file (INPUTRC, else ~/.inputrc, else /etc/inputrc)"] [155 2 "// PyErr_SetFromErrno(PyExc_OSError): no filename"] [291 3 "// GNU's history_do_write without overwrite: the file opened for appending, not created"] [323 3 "// GNU's history_get: OFFSET from history_base"] [478 1 "// addHistory is GNU's add_history: the line appended, the oldest dropped past the stifled size (history_base on)."] [491 1 "// rlTruncateFile is GNU's history_truncate_file: the file's last n lines kept."] [507 1 "// readInitFile is rl_read_init_file: each line parsed as parse_and_bind's, $if blocks for mode=emacs, term= and"] [508 1 "// the application name python taken, others skipped; a missing file an error (its errno)."] [546 1 "// rlKeyNames are the key names of rl_parse_and_bind's unquoted keys."] [550 1 "// parseAndBind is rl_parse_and_bind for `set VAR VALUE`, `KEY: FUNCTION`, `KEY: \"MACRO\"` and `\"KEYSEQ\": ...`."] [662 1 "// rlUnescape is rl_translate_keyseq: \\C-x, \\M-x, \\e, \\t, \\n, \\r, \\\\, \\\", \\', \\a, \\b, \\d, \\f, \\v, octal \\NNN, \\xHH."] [734 1 "// readlineActive is the test of builtin_input's tty path with the readline module imported: sys.stdin and sys.stdout"] [735 1 "// the process's standard streams, both terminals."] [740 2 "// the standard streams as the runtime's textFiles, or (queue 551) as create_stdio's objects still in place:"] [741 2 "// sys.stdin and sys.stdout the interpreter's own __stdin__ and __stdout__ over descriptors 0 and 1"] [759 1 "// readlineInput is call_readline: the line read by the editor with its \"\\n\", \"\" at end of input."] [775 35 "// TCSADRAIN, as rl_prep_terminal's"] [797 1 "// write is the editor's output on the terminal, after what the program printed (a completer's or a hook's prints)"] [805 1 "// redisplay is rl_redisplay: the prompt and the line again on the cursor's row, the cursor at the point."] [816 1 "// insert is rl_insert_text at the point; shown (echo) while editing, else left to a redisplay."] [846 1 "// edit reads one line: the startup hook, the prompt, the pre-input hook, then the keys until accept-line or EOF."] [889 4 "// a prefix of a longer binding waits for its next byte"] [901 19 "// an unbound escape sequence: dropped"] [904 4 "// self-insert: a printable byte, or a whole UTF-8 sequence"] [1003 1 "// rlCallHook is on_hook: the hook called with no arguments, its exception cleared."] [1009 11 "// PyErr_Clear"] [1013 1 "// complete is rl_complete_internal: TAB's insertion of the matches' common prefix, or (list) their display; whether"] [1014 1 "// the line changed."] [1028 13 "// PyErr_Clear"] [1046 2 "// rl_completion_matches' common prefix, then postprocess_matches: sorted, duplicates removed"] [1100 1 "// display is display_matches: the hook (substitution, matches, longest) when set, else the matches in columns below"] [1101 1 "// the line, then the prompt and the line again."] [1113 12 "// PyErr_Clear"] [1162 1 "// rlFilenameMatches is rl_filename_completion_function's matches: the directory's entries starting with the name."]] :go/pos {:name [3 9] :package [3 1]} :go/semis [[91 29] [94 27] [111 31] [120 31] [144 29] [157 34] [158 37] [166 49] [192 54] [210 48] [219 53] [230 31] [236 56] [257 57] [268 57] [277 58] [324 29] [330 65] [348 57] [355 52] [364 58] [370 49] [376 49] [394 59] [452 26] [469 52] [525 21] [568 32] [613 46] [625 46] [630 33] [665 12] [665 24] [672 18] [742 33] [749 35] [790 26] [881 47] [1008 32] [1025 17] [1025 19] [1033 24] [1112 104] [1119 62] [1136 37] [1144 12] [1144 22] [1145 13] [1145 22]] :go/trails [[78 73]]} (go/file "builtins
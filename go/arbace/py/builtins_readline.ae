

(in-ns 'go.arbace.py) ^{:go/comments [[1 1 "//go:build linux"] [16 1 "// The module readline (queue 289; Modules/readline.c of CPython 3.14.10, PSF License Agreement) over a line editor of"] [17 1 "// pyi's own in the place of GNU readline 8's (doc/python/PYTHON-SURVEY.md, \"As built: 289\"): the module's functions"] [18 1 "// as readline.c defines them over GNU's history list (1-based history_get from history_base, 0-based remove and"] [19 1 "// replace, stifling by `set history-size`, history files of one line an entry, history_truncate_file's last lines),"] [20 1 "// the hooks (startup before the prompt, pre-input after it, the completer, the matches' display), the init file"] [21 1 "// (INPUTRC, else ~/.inputrc, else /etc/inputrc, read at import as setup_readline's rl_initialize reads it) and"] [22 1 "// parse_and_bind's lines: `set VAR VALUE`, `KEY: FUNCTION` and `KEY: \"MACRO\"` for the keys \"\\C-x\", \"\\t\", \"\\e...\","] [23 1 "// Control-x, TAB, RET, ESC, DEL and the functions below. Once imported, input() on a terminal (sys.stdin and sys.stdout"] [24 1 "// the process's, both ttys) reads its line by the editor (call_readline's PyOS_ReadlineFunctionPointer): the terminal"] [25 1 "// as GNU's rl_prep_terminal sets it (no ICANON, ECHO, ICRNL, INLCR, ISTRIP, INPCK; VMIN 1), the prompt on stdout, the"] [26 1 "// emacs keymap's common bindings, TAB bound to self-insert as setup_readline binds it until a binding to complete"] [27 1 "// (GNU's rl_complete: the word back to a delimiter of set_completer_delims, the completer's matches for state 0, 1,"] [28 1 "// ... until a non-string, an exception ending them as on_completion's PyErr_Clear; one match replaces the word, several"] [29 1 "// their common prefix, a second TAB that changed nothing lists them, by the display hook when set; no completer:"] [30 1 "// file names), the line added to the history unless set_auto_history(False) or equal to the last."] [40 1 "// readlineState is readline.c's readlinestate with GNU readline's globals the module reads and sets."] [46 56 "// _history_length: write_history_file's truncation, -1 none"] [49 70 "// history-size, -1 unstifled"] [50 70 "// key sequence -> function or \"\\x00\"+macro"] [53 2 "// the line being edited (rl_line_buffer, rl_point) while input() reads one"] [60 21 "// _PyOS_ReadlineLock: one input() at a time on the terminal"] [88 3 "// rl_initialize: the init file (INPUTRC, else ~/.inputrc, else /etc/inputrc)"] [155 2 "// openAudit is the history and init files' PySys_Audit(\"open\", \"OCi\" or \"sCi\", ...) (readline.c; py-small-1127:"] [156 2 "// test_audit's test_open): the filename given, else the documented default dflt, with the mode's letter and 0"] [163 2 "// PyErr_SetFromErrno(PyExc_OSError): no filename"] [311 3 "// GNU's history_do_write without overwrite: the file opened for appending, not created"] [343 3 "// GNU's history_get: OFFSET from history_base"] [498 1 "// addHistory is GNU's add_history: the line appended, the oldest dropped past the stifled size (history_base on)."] [511 1 "// rlTruncateFile is GNU's history_truncate_file: the file's last n lines kept."] [527 1 "// readInitFile is rl_read_init_file: each line parsed as parse_and_bind's, $if blocks for mode=emacs, term= and"] [528 1 "// the application name python taken, others skipped; a missing file an error (its errno)."] [566 1 "// rlKeyNames are the key names of rl_parse_and_bind's unquoted keys."] [570 1 "// parseAndBind is rl_parse_and_bind for `set VAR VALUE`, `KEY: FUNCTION`, `KEY: \"MACRO\"` and `\"KEYSEQ\": ...`."] [682 1 "// rlUnescape is rl_translate_keyseq: \\C-x, \\M-x, \\e, \\t, \\n, \\r, \\\\, \\\", \\', \\a, \\b, \\d, \\f, \\v, octal \\NNN, \\xHH."] [754 1 "// readlineActive is the test of builtin_input's tty path with the readline module imported: sys.stdin and sys.stdout"] [755 1 "// the process's standard streams, both terminals."] [760 2 "// the standard streams as the runtime's textFiles, or (queue 551) as create_stdio's objects still in place:"] [761 2 "// sys.stdin and sys.stdout the interpreter's own __stdin__ and __stdout__ over descriptors 0 and 1"] [779 1 "// readlineInput is call_readline: the line read by the editor with its \"\\n\", \"\" at end of input."] [795 35 "// TCSADRAIN, as rl_prep_terminal's"] [817 1 "// write is the editor's output on the terminal, after what the program printed (a completer's or a hook's prints)"] [825 1 "// redisplay is rl_redisplay: the prompt and the line again on the cursor's row, the cursor at the point."] [836 1 "// insert is rl_insert_text at the point; shown (echo) while editing, else left to a redisplay."] [866 1 "// edit reads one line: the startup hook, the prompt, the pre-input hook, then the keys until accept-line or EOF."] [909 4 "// a prefix of a longer binding waits for its next byte"] [921 19 "// an unbound escape sequence: dropped"] [924 4 "// self-insert: a printable byte, or a whole UTF-8 sequence"] [1023 1 "// rlCallHook is on_hook: the hook called with no arguments, its exception cleared."] [1029 11 "// PyErr_Clear"] [1033 1 "// complete is rl_complete_internal: TAB's insertion of the matches' common prefix, or (list) their display; whether"] [1034 1 "// the line changed."] [1048 13 "// PyErr_Clear"] [1066 2 "// rl_completion_matches' common prefix, then postprocess_matches: sorted, duplicates removed"] [1120 1 "// display is display_matches: the hook (substitution, matches, longest) when set, else the matches in columns below"] [1121 1 "// the line, then the prompt and the line again."] [1133 12 "// PyErr_Clear"] [1182 1 "// rlFilenameMatches is rl_filename_completion_function's matches: the directory's entries starting with the name."]] :go/pos {:name [3 9] :package [3 1]} :go/semis [[91 29] [94 27] [111 31] [120 31] [144 29] [165 34] [166 37] [174 49] [200 54] [218 48] [227 53] [238 60] [241 31] [247 56] [254 50] [271 57] [278 50] [285 57] [294 58] [308 50] [344 29] [350 65] [368 57] [375 52] [384 58] [390 49] [396 49] [
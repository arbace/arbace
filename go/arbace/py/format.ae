a precision)."] [539 1 "// objectFormat is object.__format__."] [551 1 "// Format is format(o, spec) (PyObject_Format)."] [583 1 "// Ascii is ascii(o): repr with the non-ASCII characters escaped."] [621 1 "// ---- t-strings ----"] [628 1 "// Template is string.templatelib.Template: its strings (one more than its interpolations)."] [636 1 "// Interpolation is string.templatelib.Interpolation."] [643 1 "// TemplateLib is string.templatelib's names (PY5e's import makes the module from them)."] [667 2 "// float's __format__ (PY5e, part 2b: PY5b's float came after PY5c's formatters)"] [760 2 "// Interpolation's class patterns (Objects/interpolationobject.c's __match_args__; PY6a)"] [803 5 "// _PyTemplate_Concat, Template's sq_concat"] [819 2 "// Objects/templateobject.c's template_new (queue 250): *args only, each a str or an Interpolation, adjacent strs"] [820 2 "// concatenated and an empty str between two interpolations and at either end"] [851 2 "// template_reduce: string.templatelib._template_unpickle with the strings and the interpolations"] [870 2 "// Objects/interpolationobject.c's interpolation_new (Argument Clinic's): value, expression='', conversion=None"] [871 2 "// (_conversion_converter: None or one of 's', 'a', 'r'), format_spec=''"] [902 2 "// interpolation_reduce: (type, (value, expression, conversion, format_spec))"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[192 20] [207 21] [207 29] [227 27] [227 34] [373 70] [383 40] [561 30] [652 23] [695 51] [828 27] [836 44] [853 39] [857 50] [879 27] [889 23] [895 27] [904 39]]} (go/file "format.go" :imports [



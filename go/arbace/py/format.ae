r part"] [416 2 "// 3.14's fraction grouping ('._f'): the separator after every 3 digits of the fraction from the point (queue 328)"] [440 1 "// formatG is the 'g' presentation (and repr's shortest form for precision -1, CPython's"] [441 1 "// float_repr_style 'short' with the exponent from 16 digits on)."] [469 3 "// the omitted type with a precision: 'g' with Py_DTSF_ADD_DOT_0, whose exponent starts a digit earlier"] [470 3 "// (format_float_short's precision-1; queue 328: test_issue5864's format(1234.56, '.4') '1.235e+03')"] [512 1 "// formatters are the built-in types' __format__."] [515 1 "// RegisterFormatter sets a built-in type's __format__ (a float's: PY5b's type, formatted here)."] [518 1 "// complexFormat is format_complex_internal: the two parts by the float rules, the imaginary one signed, parentheses"] [519 1 "// when no type is given and the real part shows (the part formatted as repr without a precision)."] [589 1 "// objectFormat is object.__format__."] [601 1 "// Format is format(o, spec) (PyObject_Format)."] [633 1 "// Ascii is ascii(o): repr with the non-ASCII characters escaped."] [671 1 "// ---- t-strings ----"] [678 1 "// Template is string.templatelib.Template: its strings (one more than its interpolations)."] [686 1 "// Interpolation is string.templatelib.Interpolation."] [693 1 "// TemplateLib is string.templatelib's names (PY5e's import makes the module from them)."] [717 2 "// float's __format__ (PY5e, part 2b: PY5b's float came after PY5c's formatters)"] [750 4 "// a str subclass's spec too (builtin_format's PyUnicode_Check; queue 328: test_builtin's test_format)"] [811 2 "// Interpolation's class patterns (Objects/interpolationobject.c's __match_args__; PY6a)"] [854 5 "// _PyTemplate_Concat, Template's sq_concat"] [870 2 "// Objects/templateobject.c's template_new (queue 250): *args only, each a str or an Interpolation, adjacent strs"] [871 2 "// concatenated and an empty str between two interpolations and at either end"] [902 2 "// template_reduce: string.templatelib._template_unpickle with the strings and the interpolations"] [921 2 "// Objects/interpolationobject.c's interpolation_new (Argument Clinic's): value, expression='', conversion=None"] [922 2 "// (_conversion_converter: None or one of 's', 'a', 'r'), format_spec=''"] [953 2 "// interpolation_reduce: (type, (value, expression, conversion, format_spec))"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[207 20] [222 21] [222 29] [242 27] [242 34] [403 70] [413 40] [424 13] [424 20] [611 30] [702 23] [745 51] [879 27] [887 44] [904 39] [908 50] [930 27] [940 23] [946 27] [955 39]]} (go/file "format.go" :imports [



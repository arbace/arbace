(in-ns 'go.arbace.py) ^{:go/comments [[11 1 "// Formatting (PY5c; CPython's Python/formatter_unicode.c, Objects/abstract.c's PyObject_Format and"] [12 1 "// the f- and t-strings' operations): format() and __format__, the standard format specifier's"] [13 1 "// mini-language for str, int and floats, the conversions !r !s !a, :format, :build-string, and the"] [14 1 "// t-strings' Template and Interpolation (string.templatelib's types, PEP 750)."] [16 1 "// FormatSpec is a parsed standard format specifier."] [19 17 "// 0 when not given"] [22 17 "// 0, '+', '-', ' '"] [23 17 "// -1 when not given"] [24 17 "// 0, ',', '_'"] [25 17 "// -1 when not given"] [27 17 "// 0 when not given"] [31 1 "// ParseFormatSpec is parse_internal_render_format_spec."] [135 2 "// 3.14's separator of the fraction's digits: the float types alone (queue 328: test_float's '.6_n')"] [146 1 "// pad lays out a body (its sign or prefix apart, for '=') in the spec's width."] [177 1 "// formatStr is str.__format__."] [192 3 "// format_string_internal (formatter_unicode.c): a space named as such (queue 250)"] [212 1 "// group inserts sep every 3 (or n) digits from the right, the zero padding included as CPython's."] [259 1 "// formatIntSpec is int.__format__."] [274 27 "// PyLong_AsDouble, correctly rounded (queue 286: an int past 64 bits too)"] [283 16 "// format_long_internal's (queue 286: test_long's test__format__)"] [286 2 "// the magnitude's digits (queue 286: an int past 64 bits as its big value, the decimal digits under"] [287 2 "// sys.set_int_max_str_digits' limit as str() has them: test_fractions' format tests)"] [330 69 "// a lone surrogate kept (PY6c)"] [345 1 "// formatFloat is float.__format__ for a Go float64 (the types e, f, g, %, their upper cases, and"] [346 1 "// none, which PY5b's float repr completes)."] [351 3 "// alternate form keeps the point"] [409 2 "// thousands separators in the integer part"] [414 2 "// 3.14's fraction grouping ('._f'): the separator after every 3 digits of the fraction from the point (queue 328)"] [438 1 "// formatG is the 'g' presentation (and repr's shortest form for precision -1, CPython's"] [439 1 "// float_repr_style 'short' with the exponent from 16 digits on)."] [467 3 "// the omitted type with a precision: 'g' with Py_DTSF_ADD_DOT_0, whose exponent starts a digit earlier"] [468 3 "// (format_float_short's precision-1; queue 328: test_issue5864's format(1234.56, '.4') '1.235e+03')"] [510 1 "// formatters are the built-in types' __format__."] [513 1 "// RegisterFormatter sets a built-in type's __format__ (a float's: PY5b's type, formatted here)."] [516 1 "// complexFormat is format_complex_internal: the two parts by the float rules, the imaginary one signed, parentheses"] [517 1 "// when no type is given and the real part shows (the part formatted as repr without a precision)."] [587 1 "// objectFormat is object.__format__."] [599 1 "// Format is format(o, spec) (PyObject_Format)."] [631 1 "// Ascii is ascii(o): repr with the non-ASCII characters escaped."] [669 1 "// ---- t-strings ----"] [676 1 "// Template is string.templatelib.Template: its strings (one more than its interpolations)."] [684 1 "// Interpolation is string.templatelib.Interpolation."] [691 1 "// TemplateLib is string.templatelib's names (PY5e's import makes the module from them)."] [715 2 "// float's __format__ (PY5e, part 2b: PY5b's float came after PY5c's formatters)"] [748 4 "// a str subclass's spec too (builtin_format's PyUnicode_Check; queue 328: test_builtin's test_format)"] [809 2 "// Interpolation's class patterns (Objects/interpolationobject.c's __match_args__; PY6a)"] [852 5 "// _PyTemplate_Concat, Template's sq_concat"] [868 2 "// Objects/templateobject.c's template_new (queue 250): *args only, each a str or an Interpolation, adjacent strs"] [869 2 "// concatenated and an empty str between two interpolations and at either end"] [900 2 "// template_reduce: string.templatelib._template_unpickle with the strings and the interpolations"] [919 2 "// Objects/interpolationobject.c's interpolation_new (Argument Clinic's): value, expression='', conversion=None"] [920 2 "// (_conversion_converter: None or one of 's', 'a', 'r'), format_spec=''"] [951 2 "// interpolation_reduce: (type, (value, expression, conversion, format_spec))"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[205 24] [220 21] [220 29] [240 27] [240 34] [401 70] [411 40] [422 13] [422 20] [609 30] [700 23] [743 51] [877 27] [885 44] [902 39] [906 50] [928 27] [938 23] [944 27] [953 39]]} (go/file "format.go" :imports [



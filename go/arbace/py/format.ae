f the fraction from the point (queue 328)"] [437 1 "// formatG is the 'g' presentation (and repr's shortest form for precision -1, CPython's"] [438 1 "// float_repr_style 'short' with the exponent from 16 digits on)."] [466 3 "// the omitted type with a precision: 'g' with Py_DTSF_ADD_DOT_0, whose exponent starts a digit earlier"] [467 3 "// (format_float_short's precision-1; queue 328: test_issue5864's format(1234.56, '.4') '1.235e+03')"] [509 1 "// formatters are the built-in types' __format__."] [512 1 "// RegisterFormatter sets a built-in type's __format__ (a float's: PY5b's type, formatted here)."] [515 1 "// complexFormat is format_complex_internal: the two parts by the float rules, the imaginary one signed, parentheses"] [516 1 "// when no type is given and the real part shows (the part formatted as repr without a precision)."] [586 1 "// objectFormat is object.__format__."] [598 1 "// Format is format(o, spec) (PyObject_Format)."] [630 1 "// Ascii is ascii(o): repr with the non-ASCII characters escaped."] [668 1 "// ---- t-strings ----"] [675 1 "// Template is string.templatelib.Template: its strings (one more than its interpolations)."] [683 1 "// Interpolation is string.templatelib.Interpolation."] [690 1 "// TemplateLib is string.templatelib's names (PY5e's import makes the module from them)."] [714 2 "// float's __format__ (PY5e, part 2b: PY5b's float came after PY5c's formatters)"] [747 4 "// a str subclass's spec too (builtin_format's PyUnicode_Check; queue 328: test_builtin's test_format)"] [808 2 "// Interpolation's class patterns (Objects/interpolationobject.c's __match_args__; PY6a)"] [851 5 "// _PyTemplate_Concat, Template's sq_concat"] [867 2 "// Objects/templateobject.c's template_new (queue 250): *args only, each a str or an Interpolation, adjacent strs"] [868 2 "// concatenated and an empty str between two interpolations and at either end"] [899 2 "// template_reduce: string.templatelib._template_unpickle with the strings and the interpolations"] [918 2 "// Objects/interpolationobject.c's interpolation_new (Argument Clinic's): value, expression='', conversion=None"] [919 2 "// (_conversion_converter: None or one of 's', 'a', 'r'), format_spec=''"] [950 2 "// interpolation_reduce: (type, (value, expression, conversion, format_spec))"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[204 20] [219 21] [219 29] [239 27] [239 34] [400 70] [410 40] [421 13] [421 20] [608 30] [699 23] [742 51] [876 27] [884 44] [901 39] [905 50] [927 27] [937 23] [943 27] [952 39]]} (go/file "format.go" :imports [



t, as 'f' does (format_float_internal)"] [416 2 "// thousands separators in the integer part"] [421 2 "// 3.14's fraction grouping ('._f'): the separator after every 3 digits of the fraction from the point (queue 328)"] [445 1 "// formatG is the 'g' presentation (and repr's shortest form for precision -1, CPython's"] [446 1 "// float_repr_style 'short' with the exponent from 16 digits on)."] [474 3 "// the omitted type with a precision: 'g' with Py_DTSF_ADD_DOT_0, whose exponent starts a digit earlier"] [475 3 "// (format_float_short's precision-1; queue 328: test_issue5864's format(1234.56, '.4') '1.235e+03')"] [517 1 "// formatters are the built-in types' __format__."] [520 1 "// RegisterFormatter sets a built-in type's __format__ (a float's: PY5b's type, formatted here)."] [523 1 "// complexFormat is format_complex_internal: the two parts by the float rules, the imaginary one signed, parentheses"] [524 1 "// when no type is given and the real part shows (the part formatted as repr without a precision)."] [594 1 "// objectFormat is object.__format__."] [606 1 "// Format is format(o, spec) (PyObject_Format)."] [638 1 "// Ascii is ascii(o): repr with the non-ASCII characters escaped."] [676 1 "// ---- t-strings ----"] [683 1 "// Template is string.templatelib.Template: its strings (one more than its interpolations)."] [691 1 "// Interpolation is string.templatelib.Interpolation."] [698 1 "// TemplateLib is string.templatelib's names (PY5e's import makes the module from them)."] [722 2 "// float's __format__ (PY5e, part 2b: PY5b's float came after PY5c's formatters)"] [755 4 "// a str subclass's spec too (builtin_format's PyUnicode_Check; queue 328: test_builtin's test_format)"] [816 2 "// Interpolation's class patterns (Objects/interpolationobject.c's __match_args__; PY6a)"] [859 5 "// _PyTemplate_Concat, Template's sq_concat"] [875 2 "// Objects/templateobject.c's template_new (queue 250): *args only, each a str or an Interpolation, adjacent strs"] [876 2 "// concatenated and an empty str between two interpolations and at either end"] [907 2 "// template_reduce: string.templatelib._template_unpickle with the strings and the interpolations"] [926 2 "// Objects/interpolationobject.c's interpolation_new (Argument Clinic's): value, expression='', conversion=None"] [927 2 "// (_conversion_converter: None or one of 's', 'a', 'r'), format_spec=''"] [958 2 "// interpolation_reduce: (type, (value, expression, conversion, format_spec))"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[208 24] [223 21] [223 29] [243 27] [243 34] [408 70] [418 40] [429 13] [429 20] [616 30] [707 23] [750 51] [884 27] [892 44] [909 39] [913 50] [935 27] [945 23] [951 27] [960 39]]} (go/file "format.go" :imports [



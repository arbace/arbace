t, as 'f' does (format_float_internal)"] [415 2 "// thousands separators in the integer part"] [420 2 "// 3.14's fraction grouping ('._f'): the separator after every 3 digits of the fraction from the point (queue 328)"] [444 1 "// formatG is the 'g' presentation (and repr's shortest form for precision -1, CPython's"] [445 1 "// float_repr_style 'short' with the exponent from 16 digits on)."] [473 3 "// the omitted type with a precision: 'g' with Py_DTSF_ADD_DOT_0, whose exponent starts a digit earlier"] [474 3 "// (format_float_short's precision-1; queue 328: test_issue5864's format(1234.56, '.4') '1.235e+03')"] [516 1 "// formatters are the built-in types' __format__."] [519 1 "// RegisterFormatter sets a built-in type's __format__ (a float's: PY5b's type, formatted here)."] [522 1 "// complexFormat is format_complex_internal: the two parts by the float rules, the imaginary one signed, parentheses"] [523 1 "// when no type is given and the real part shows (the part formatted as repr without a precision)."] [593 1 "// objectFormat is object.__format__."] [605 1 "// Format is format(o, spec) (PyObject_Format)."] [637 1 "// Ascii is ascii(o): repr with the non-ASCII characters escaped."] [675 1 "// ---- t-strings ----"] [682 1 "// Template is string.templatelib.Template: its strings (one more than its interpolations)."] [690 1 "// Interpolation is string.templatelib.Interpolation."] [697 1 "// TemplateLib is string.templatelib's names (PY5e's import makes the module from them)."] [721 2 "// float's __format__ (PY5e, part 2b: PY5b's float came after PY5c's formatters)"] [754 4 "// a str subclass's spec too (builtin_format's PyUnicode_Check; queue 328: test_builtin's test_format)"] [815 2 "// Interpolation's class patterns (Objects/interpolationobject.c's __match_args__; PY6a)"] [858 5 "// _PyTemplate_Concat, Template's sq_concat"] [874 2 "// Objects/templateobject.c's template_new (queue 250): *args only, each a str or an Interpolation, adjacent strs"] [875 2 "// concatenated and an empty str between two interpolations and at either end"] [906 2 "// template_reduce: string.templatelib._template_unpickle with the strings and the interpolations"] [925 2 "// Objects/interpolationobject.c's interpolation_new (Argument Clinic's): value, expression='', conversion=None"] [926 2 "// (_conversion_converter: None or one of 's', 'a', 'r'), format_spec=''"] [957 2 "// interpolation_reduce: (type, (value, expression, conversion, format_spec))"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[207 20] [222 21] [222 29] [242 27] [242 34] [407 70] [417 40] [428 13] [428 20] [615 30] [706 23] [749 51] [883 27] [891 44] [908 39] [912 50] [934 27] [944 23] [950 27] [959 39]]} (go/file "format.go" :imports [



a built-in type's __format__ (a float's: PY5b's type, formatted here)."] [481 1 "// complexFormat is format_complex_internal: the two parts by the float rules, the imaginary one signed, parentheses"] [482 1 "// when no type is given and the real part shows (the part formatted as repr without a precision)."] [552 1 "// objectFormat is object.__format__."] [564 1 "// Format is format(o, spec) (PyObject_Format)."] [596 1 "// Ascii is ascii(o): repr with the non-ASCII characters escaped."] [634 1 "// ---- t-strings ----"] [641 1 "// Template is string.templatelib.Template: its strings (one more than its interpolations)."] [649 1 "// Interpolation is string.templatelib.Interpolation."] [656 1 "// TemplateLib is string.templatelib's names (PY5e's import makes the module from them)."] [680 2 "// float's __format__ (PY5e, part 2b: PY5b's float came after PY5c's formatters)"] [773 2 "// Interpolation's class patterns (Objects/interpolationobject.c's __match_args__; PY6a)"] [816 5 "// _PyTemplate_Concat, Template's sq_concat"] [832 2 "// Objects/templateobject.c's template_new (queue 250): *args only, each a str or an Interpolation, adjacent strs"] [833 2 "// concatenated and an empty str between two interpolations and at either end"] [864 2 "// template_reduce: string.templatelib._template_unpickle with the strings and the interpolations"] [883 2 "// Objects/interpolationobject.c's interpolation_new (Argument Clinic's): value, expression='', conversion=None"] [884 2 "// (_conversion_converter: None or one of 's', 'a', 'r'), format_spec=''"] [915 2 "// interpolation_reduce: (type, (value, expression, conversion, format_spec))"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[193 20] [208 21] [208 29] [228 27] [228 34] [386 70] [396 40] [574 30] [665 23] [708 51] [841 27] [849 44] [866 39] [870 50] [892 27] [902 23] [908 27] [917 39]]} (go/file "format.go" :imports [



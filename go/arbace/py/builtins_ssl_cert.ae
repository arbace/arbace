(in-ns 'go.arbace.py) ^{:go/comments [[15 1 "// _ssl's certificates (queue 209; CPython 3.14.10's Modules/_ssl.c, _decode_certificate and its helpers, and"] [16 1 "// Modules/_ssl/cert.c): a certificate decoded from its DER as OpenSSL's X509 accessors give it to _ssl.c, by a"] [17 1 "// DER walker of its own (OpenSSL decodes certificates crypto/x509 refuses, test_ssl's nullbytecert.pem and"] [18 1 "// talos-2019-0758.pem among them), and the OIDs OpenSSL names (its objects table, the part _ssl's callers and"] [19 1 "// certificates name: txt2obj, nid2obj, an attribute's long name)."] [21 1 "// sslObj is an OpenSSL object: its NID, short name, long name and dotted OID."] [28 1 "// sslObjects is the part of OpenSSL 3.5's objects table _ssl needs (the values txt2obj gives on CPython 3.14.10"] [29 1 "// with OpenSSL 3.5.9)."] [104 1 "// sslObjTuple is asn1obj2py: (nid, sn, ln, oid)."] [109 1 "// ---- DER ----"] [111 1 "// derTLV is one DER element: its tag (class and constructed bits kept), its content and the whole encoding."] [118 1 "// derRead reads one element from b (definite lengths only, as DER), the rest after it."] [125 24 "// high tag numbers: kept as their first octet's class bits and the number"] [162 1 "// derList is a constructed element's children."] [176 1 "// derOID is an OBJECT IDENTIFIER's dotted text."] [206 1 "// sslObjText is OBJ_obj2txt(no_name=0): the long name of a known object, else its OID."] [214 1 "// derStringText is ASN1_STRING_to_UTF8 of a string type: BMPString and UniversalString decoded, the 8-bit"] [215 1 "// types (T61String and the like) as Latin-1, UTF8String as is."] [218 13 "// BMPString"] [224 13 "// UniversalString"] [230 13 "// UTF8String"] [232 37 "// T61String, VideotexString, GraphicString, VisibleString, GeneralString"] [239 27 "// PrintableString, IA5String, NumericString"] [242 1 "// sslNameTuple is _create_tuple_for_X509_NAME: a tuple of RDNs, each a tuple of (name, value) pairs."] [261 30 "// BIT STRING: the bytes as they are"] [274 1 "// sslCert is a certificate's parts as _ssl.c reads them."] [283 31 "// by OID: the extnValue's content"] [287 1 "// sslParseCert walks a certificate's DER: tbsCertificate's fields and its extensions."] [353 1 "// sslSerialText is i2a_ASN1_INTEGER: the content's octets in upper-case hex (\"00\" for none); a negative one"] [354 1 "// (two's complement) with \"-\" and its magnitude."] [380 1 "// sslTimeText is ASN1_TIME_print: \"Mon DD HH:MM:SS YYYY GMT\", the day space-padded (fractional seconds kept as"] [381 1 "// OpenSSL prints them)."] [386 13 "// UTCTime YYMMDDHHMMSSZ"] [397 13 "// GeneralizedTime YYYYMMDDHHMMSS[.f]Z"] [423 1 "// sslGeneralName is one GeneralName of _get_peer_alt_names as a (type, value) tuple."] [427 13 "// rfc822Name"] [429 13 "// dNSName"] [431 13 "// uniformResourceIdentifier"] [433 13 "// directoryName"] [443 13 "// registeredID"] [445 13 "// iPAddress"] [458 13 "// otherName: GENERAL_NAME_print's \"othername:<unsupported>\""] [460 13 "// x400Address"] [462 13 "// ediPartyName"] [468 1 "// sslURIs are the URIs of a sequence of GeneralNames."] [479 1 "// sslDecodeCert is _decode_certificate: subject, issuer, version, serialNumber, notBefore, notAfter and, when"] [480 1 "// present, subjectAltName, OCSP, caIssuers and crlDistributionPoints."] [525 54 "// authorityInfoAccess"] [549 46 "// crlDistributionPoints"] [559 25 "// distributionPoint; an empty one is skipped (CVE-2019-5010)"] [563 42 "// fullName"] [581 1 "// ---- PEM ----"] [583 1 "// sslPEMBlocks are the PEM blocks of data of the given type (\"\" any)."] [598 1 "// sslTestDecodeCert is _ssl._test_decode_cert(path)."] [625 1 "// ---- _ssl.Certificate (Modules/_ssl/cert.c) ----"] [637 1 "// sslDERToPEM is ssl.DER_cert_to_PEM_cert's layout as PEM_write_bio_X509 writes it (64 columns)."] [714 1 "// sslOneline is X509_NAME_print_ex's RFC 2253 form of a subject tuple (the repr's text): \"CN=..,O=..\", the"] [715 1 "// last RDN first."] [738 1 "// sslX509 is a parsed certificate for Go's verifier and the one decoded for Python, from the same DER."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[151 13] [151 20] [208 26] [226 13] [226 35] [343 35] [452 14] [452 22] [508 39] [525 47] [527 31] [549 39] [551 31] [600 45] [669 35] [719 27] [719 35]] :go/trails [[83 72]]} (go/file "builtins_ssl_cert.go" :imports [



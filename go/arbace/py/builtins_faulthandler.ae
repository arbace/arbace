

(in-ns 'go.arbace.py) ^{:go/comments [[1 1 "//go:build linux"] [17 1 "// The module faulthandler (queue 220; Modules/faulthandler.c and Python/traceback.c's dump functions of CPython 3.14.10,"] [18 1 "// PSF License Agreement): the Python traceback of every thread written to a descriptor, on a fatal signal (enable), after"] [19 1 "// a timeout (dump_traceback_later), on a user signal (register) or when asked (dump_traceback)."] [20 1 "//"] [21 1 "// The threads are pyi's (allThreads, builtins_thread.go): the main thread and each started one, newest first as"] [22 1 "// CPython's interpreter lists its thread states; a thread's frames its Frame chain, read without its lock (a pointer and"] [23 1 "// an instruction index read whole) as CPython reads another thread's frames from a signal handler. A fatal signal another"] [24 1 "// process sends arrives through os/signal on fatalCh; one pyi raises itself (_sigsegv, _sigabrt, os.kill of its own pid,"] [25 1 "// signal.raise_signal: ownSignalHook) runs the handler in the raising thread first, as the kernel runs a synchronous"] [26 1 "// signal's handler. Then the process dies by the signal, its action set to SIG_DFL by rt_sigaction (fhDie: Go's own"] [27 1 "// handler would print a Go traceback). A thread's ident stands for its pthread id; musl has no backtrace(), so the C"] [28 1 "// stack is \"<cannot get C stack on this system>\" as CPython's on Alpine; no \"Extension modules:\" line (pyi has none)."] [36 1 "// fhFatalSignals are faulthandler_handlers: the fatal signals and their names, in CPython's order."] [42 1 "// fhFatal is fatal_error: enable()'s state."] [46 20 "// kept alive while enabled"] [51 1 "// fhUser is user_signals: register()'s state per signal."] [61 24 "// the state read by the signal goroutines"] [67 24 "// faulthandler_dump_traceback's reentrant guard: one dump at a time"] [70 1 "// fhLater is dump_traceback_later's watchdog: cancel closed to stop it, done closed when it has stopped."] [87 1 "// fhWrite is _Py_write_noraise: all of s written to fd, EINTR retried, errors ignored."] [102 1 "// fhHex is _Py_DumpHexadecimal: width lowercase hexadecimal digits."] [111 1 "// fhASCII is _Py_DumpASCII: printable ASCII as is, the rest as \\xHH, \\uHHHH or \\UHHHHHHHH, past 500 characters \"...\"."] [133 1 "// fhFrame is dump_frame: `  File \"f\", line N in name`."] [149 1 "// fhTraceback is dump_traceback: t's frames, most recent first, at most MAX_FRAME_DEPTH."] [163 18 "// read first, as CPython reads frame->previous early"] [175 1 "// fhThreads is _Py_DumpTracebackThreads: each thread's header (cur's \"Current thread\") and frames, newest first."] [193 44 "// _Py_DumpTracebackThreads: gc.collecting (queue 241)"] [199 1 "// fhDumpTo is faulthandler_dump_traceback: all threads, or cur's alone with the \"Stack\" header."] [216 1 "// fhFatalError is faulthandler_fatal_error: the header, the traceback, the C stack; the caller dies by the signal."] [242 1 "// fhExtensionModules is _Py_DumpExtensionModules: the built-in modules in sys.modules (pyi's C modules: the runtime's)"] [243 1 "// not in sys.stdlib_module_names, after \"Extension modules: \", with their count; nothing when there are none."] [245 31 "// sys.modules read from a signal's goroutine: a concurrent change only loses the list"] [285 1 "// sigactionT is the kernel's struct sigaction (handler, flags, restorer, mask) as rt_sigaction takes it."] [290 1 "// fhDie ends the process by sig: its action SIG_DFL (rt_sigaction), sig unblocked in the emulated mask, raised; if"] [291 1 "// it does not kill (a stopping or ignored signal), the exit status 128+sig after a moment."] [294 27 "// stdout's buffer is lost, as CPython's block-buffered stdout is"] [304 1 "// ExtFatalError is Python/pylifecycle.c's fatal_error for the C API's Py_FatalError (arbace/pyctypes; queue 594):"] [305 1 "// \"Fatal Python error: PREFIX: MSG\", the runtime's state, the threads' tracebacks (the current one marked), the"] [306 1 "// extension modules extMods names (_Py_DumpExtensionModules: sys.modules' modules of a PyModuleDef, the standard"] [307 1 "// library's left out) with their count, then abort() with faulthandler finalized."] [330 1 "// fhTerminates are the signals whose default action ends the process (signal(7)), SIGKILL and SIGSTOP apart."] [339 1 "// fhOwnSignal is ownSignalHook: a signal pyi sends itself (os.kill of its own pid, signal.raise_signal), handled in the"] [340 1 "// sending thread before the call returns as the kernel runs the handler of a signal a thread raises: faulthandler's"] [341 1 "// fatal handler (then death by it), its user handler (then, chained, the Python handler or the default action), or the"] [342 1 "// default action that ends the process when the signal's Python disposition is SIG_DFL (Go's runtime would ignore"] [343 1 "// SIGUSR1 and print its own traceback for SIGABRT)."] [373 1 "// fhStart starts the goroutines of the fatal and user signals once."] [403 1 "// fhGetFileno is faulthandler_get_fileno: None or absent sys.stderr, an int a descriptor, else file.fileno() (the file"] [404 1 "// flushed); the file kept while it is used (nil for a descriptor)."] [449 28 "// a flush error ignored"] [453 1 "// fhIntArg is the 'i' format: PyLong_AsInt."] [461 1 "// fhBoolArg is the 'p' format: PyObject_IsTrue; absent the default."] [469 1 "// fhTimeoutHeader is format_timeout."] [494 1 "// fhTimeoutUs is _PyTime_FromSecondsObject then _PyTime_AsMicroseconds, both _PyTime_ROUND_TIMEOUT (up)."] [525 1 "// fhCancelLater is cancel_dump_traceback_later: the watchdog stopped and waited for."] [672 29 "// the watchdog has no Python thread: no \"Current thread\""] [724 53 "// sigaction refuses SIGKILL and SIGSTOP"] [754 45 "// the Python handler's notification, which Reset removed"] [778 78 "// the overflow's SIGSEGV on the alternate stack"] [780 3 "// Py_FatalError in a thread without a Python thread state: the message, the threads (none current), the C"] [781 3 "// stack, then abort() with faulthandler finalized (no second traceback)"] [805 1 "// faulthandlerAtStart is _PyFaulthandler_Init(enable): -X faulthandler or PYTHONFAULTHANDLER set and not empty"] [806 1 "// import faulthandler and call its enable()."]] :go/pos {:name [3 9] :package [3 1]} :go/semis [[139 19] [159 16] [159 18] [169 14] [251 51] [252 61] [263 58] [267 36] [293 25] [309 25] [367 35] [380 35] [408 72] [417 32] [418 31] [419 84] [441 22] [442 26] [455 25] [496 22] [505 28] [634 35] [639 33]]} (go/file "builtins_faulthandler.go" :build ["//go:build linux"] :imports [



(in-ns 'go.arbace.py) ^{:go/comments [[8 1 "// dict (Objects/dictobject.c): insertion-ordered, keys by hash and equality; its views and methods."] [18 2 "// reversed() of a dict and of its views (dict.__reversed__, 3.8; PY7: absent)"] [24 1 "// Dict is a dict: insertion-ordered (CPython's compact dict's iteration order). Deleted entries"] [25 1 "// leave holes (key nil) until the dict is compacted."] [26 1 "//"] [27 1 "// The index (202b; before it a Go map from a hash to a slice of its entries' positions, a slice allocated per"] [28 1 "// key): a Go map from a hash to the position of its first entry, made at the first insertion, and each entry the"] [29 1 "// position of the next entry of its hash (next, -1 at the end of the chain), so the keys of one hash are compared"] [30 1 "// in insertion order, as before. A chain may pass holes (deleted entries) until the dict is compacted."] [34 2 "// mask has bit h&63 set for the hash h of every key indexed since the index was last made (indexAdd; queue 210):"] [35 2 "// a key whose bit is clear is not in the dict, found so without the index's lookup (an instance's dict looked up"] [36 2 "// for a method's name, a module's for a builtin's)"] [39 15 "// changed by every insertion and deletion (iteration's check)"] [40 15 "// the compactions so far (an iterator's positions no longer the entries')"] [41 2 "// ofType: the dict is a type's namespace; any change to it moves typeEpoch (the type attribute cache's)"] [48 19 "// the next entry of the hash, -1 none"] [53 1 "// BaseDict is the dict value of a dict or of a dict subclass's instance that embeds Dict."] [56 1 "// NewDict is an empty dict."] [59 1 "// rebuildIndex indexes the entries anew."] [70 1 "// indexAdd puts entry i (of hash h, the last entry) at the end of its hash's chain."] [89 1 "// indexForget takes entry i (of hash h, the last entry) out of its hash's chain."] [126 1 "// AsDict is asDict, exported for the other files."] [129 1 "// Len is the number of items."] [156 1 "// matches is whether entry i's key (of the hash looked up) is key: the same object, the same str, else __eq__."] [176 3 "// directly, not through the slot: the types' dictionaries are filled by init functions that may"] [177 3 "// run before str's sets its slots"] [187 1 "// Get is d[key], nil when absent."] [200 1 "// Set is d[key] = v."] [225 1 "// insertNew appends key (of hash h, not in the dict) with value v."] [251 1 "// Delete removes key; false when absent."] [261 50 "// a hole; its chain link kept"] [270 1 "// Clear empties the dict."] [279 1 "// GetStr and SetStr are Get and Set with a str key (the namespaces')."] [287 1 "// nameStrs keeps the strs of the names GetStr and SetStr look up (attribute and special names), so each is made"] [288 1 "// and hashed once (at most nameStrsMax of them)."] [304 1 "// Items calls f on each item in order until it returns false."] [314 1 "// Keys is the keys in order."] [321 1 "// Copy is a shallow copy."] [335 1 "// Update is dict.update(o): a mapping's items (keys() and []), or an iterable of pairs."] [338 3 "// the other dict's entries by position, its change by a key's __eq__ an error (dict_merge's check of"] [339 3 "// dk_nentries; queue 203: test_merge_and_mutate)"] [369 3 "// PySequence_Fast(x, \"object is not iterable\"), its TypeError given the note (dict_merge_from_seq2; queue 203:"] [370 3 "// test_update_type_error)"] [405 16 "// a reverse iterator: i counts the entries left, from the last"] [406 16 "// the items still expected (di->len)"] [407 16 "// the dict's compactions when made"] [448 1 "// dictNew is dict(), dict(mapping or iterable, **kwargs)."] [579 4 "// the size checked, the iteration ended past the entries of a dict refilled since, and the keys changed"] [580 4 "// when it meets an item it did not expect (dictiter_iternextkey_lock_held, dictreviter_iter_lock_held;"] [581 4 "// queue 203: test_reversed_dict_after_clear_and_restore; before it any change of the keys was one)"] [586 4 "// compacted since (CPython's resize, at other moments): the positions lost, the keys changed"] [642 2 "// a view's mapping: a mappingproxy of its dict (dictview_mapping; queue 203: test_views_mapping)"] [674 1 "// dictViewCompare is dictview_richcompare: the sizes, then every item of one in the other by the other's"] [675 1 "// containment (an items view's: the key looked up, the values compared), no set made (queue 203: an unhashable"] [676 1 "// value compared, test_errors_in_view_containment_check)."] [758 1 "// dictMissing is d[k] on a dict subclass with __missing__: the method called with the key."] [774 1 "// newDictSubclass makes an instance of a dict subclass; PY5c sets it (by default the base value: PY5c wraps it)."] [811 3 "// the key hashed and looked up once (dict_setdefault_ref; queue 203: test_setdefault_atomic)"] [857 5 "// the slot leaves the index too: a later key of its hash looked up entries[i] past the end"] [858 5 "// (PY6e's REQUEST: test_os's mapping tests popitem then set)"] [859 5 "// the popped entry and the holes after it leave the index too: a later key appended at their"] [860 5 "// positions is found by its own chain only"] [897 2 "// dict.fromkeys, a class method (dict_fromkeys: cls() filled by its __setitem__; PY7: it was a plain built-in,"] [898 2 "// bound to an instance, d.fromkeys(keys) iterated d)"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[96 28] [120 25] [140 17] [140 47] [147 35] [162 22] [163 25] [175 24] [294 28] [306 12] [306 32] [317 55] [337 23] [341 13] [341 20] [344 50] [354 44] [373 27] [379 29] [433 23] [436 23] [456 29] [461 39] [470 49] [480 42] [515 25] [520 25] [553 49] [562 50] [678 27] [679 23] [707 28] [716 28] [722 28] [731 22] [742 27] [743 26] [764 33] [782 54] [792 40] [808 47] [832 40] [850 49] [854 30] [854 38] [885 47] [892 46] [903 24]]} (go/file "dict.go" :imports [



(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// dict (Objects/dictobject.c): insertion-ordered, keys by hash and equality; its views and methods."] [15 2 "// reversed() of a dict and of its views (dict.__reversed__, 3.8; PY7: absent)"] [21 1 "// Dict is a dict: insertion-ordered (CPython's compact dict's iteration order). Deleted entries"] [22 1 "// leave holes (key nil) until the dict is compacted."] [23 1 "//"] [24 1 "// The index (202b; before it a Go map from a hash to a slice of its entries' positions, a slice allocated per"] [25 1 "// key): a Go map from a hash to the position of its first entry, made at the first insertion, and each entry the"] [26 1 "// position of the next entry of its hash (next, -1 at the end of the chain), so the keys of one hash are compared"] [27 1 "// in insertion order, as before. A chain may pass holes (deleted entries) until the dict is compacted."] [32 14 "// changed by every insertion and deletion (iteration's check)"] [33 2 "// ofType: the dict is a type's namespace; any change to it moves typeEpoch (the type attribute cache's)"] [40 19 "// the next entry of the hash, -1 none"] [45 1 "// BaseDict is the dict value of a dict or of a dict subclass's instance that embeds Dict."] [48 1 "// NewDict is an empty dict."] [51 1 "// rebuildIndex indexes the entries anew."] [61 1 "// indexAdd puts entry i (of hash h, the last entry) at the end of its hash's chain."] [79 1 "// indexForget takes entry i (of hash h, the last entry) out of its hash's chain."] [116 1 "// AsDict is asDict, exported for the other files."] [119 1 "// Len is the number of items."] [143 1 "// matches is whether entry i's key (of the hash looked up) is key: the same object, the same str, else __eq__."] [163 3 "// directly, not through the slot: the types' dictionaries are filled by init functions that may"] [164 3 "// run before str's sets its slots"] [174 1 "// Get is d[key], nil when absent."] [187 1 "// Set is d[key] = v."] [229 1 "// Delete removes key; false when absent."] [239 50 "// a hole; its chain link kept"] [248 1 "// Clear empties the dict."] [257 1 "// GetStr and SetStr are Get and Set with a str key (the namespaces')."] [265 1 "// nameStrs keeps the strs of the names GetStr and SetStr look up (attribute and special names), so each is made"] [266 1 "// and hashed once (at most nameStrsMax of them)."] [282 1 "// Items calls f on each item in order until it returns false."] [292 1 "// Keys is the keys in order."] [299 1 "// Copy is a shallow copy."] [313 1 "// Update is dict.update(o): a mapping's items (keys() and []), or an iterable of pairs."] [365 15 "// a reverse iterator: i counts the entries left, from the last"] [406 1 "// dictNew is dict(), dict(mapping or iterable, **kwargs)."] [658 1 "// dictMissing is d[k] on a dict subclass with __missing__: the method called with the key."] [674 1 "// newDictSubclass makes an instance of a dict subclass; PY5c sets it (by default the base value: PY5c wraps it)."] [748 5 "// the slot leaves the index too: a later key of its hash looked up entries[i] past the end"] [749 5 "// (PY6e's REQUEST: test_os's mapping tests popitem then set)"] [750 5 "// the popped entry and the holes after it leave the index too: a later key appended at their"] [751 5 "// positions is found by its own chain only"] [788 2 "// dict.fromkeys, a class method (dict_fromkeys: cls() filled by its __setitem__; PY7: it was a plain built-in,"] [789 2 "// bound to an instance, d.fromkeys(keys) iterated d)"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[86 28] [110 25] [127 17] [127 47] [134 35] [149 22] [150 25] [162 24] [272 28] [284 12] [284 32] [295 55] [315 23] [318 50] [325 44] [391 23] [394 23] [414 29] [419 39] [428 49] [438 42] [473 25] [478 25] [511 49] [520 50] [615 29] [616 25] [631 22] [642 27] [643 26] [664 33] [682 54] [692 40] [708 47] [723 40] [741 49] [745 30] [745 38] [776 47] [783 46] [794 24]]} (go/file "dict.go" :imports [


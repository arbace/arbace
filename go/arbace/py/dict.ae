(in-ns 'go.arbace.py) ^{:go/comments [[8 1 "// dict (Objects/dictobject.c): insertion-ordered, keys by hash and equality; its views and methods."] [18 2 "// reversed() of a dict and of its views (dict.__reversed__, 3.8; PY7: absent)"] [24 1 "// Dict is a dict: insertion-ordered (CPython's compact dict's iteration order). Deleted entries"] [25 1 "// leave holes (key nil) until the dict is compacted."] [26 1 "//"] [27 1 "// The index (202b; before it a Go map from a hash to a slice of its entries' positions, a slice allocated per"] [28 1 "// key): a Go map from a hash to the position of its first entry, made at the first insertion, and each entry the"] [29 1 "// position of the next entry of its hash (next, -1 at the end of the chain), so the keys of one hash are compared"] [30 1 "// in insertion order, as before. A chain may pass holes (deleted entries) until the dict is compacted."] [35 15 "// changed by every insertion and deletion (iteration's check)"] [36 15 "// the compactions so far (an iterator's positions no longer the entries')"] [37 2 "// ofType: the dict is a type's namespace; any change to it moves typeEpoch (the type attribute cache's)"] [44 19 "// the next entry of the hash, -1 none"] [49 1 "// BaseDict is the dict value of a dict or of a dict subclass's instance that embeds Dict."] [52 1 "// NewDict is an empty dict."] [55 1 "// rebuildIndex indexes the entries anew."] [65 1 "// indexAdd puts entry i (of hash h, the last entry) at the end of its hash's chain."] [83 1 "// indexForget takes entry i (of hash h, the last entry) out of its hash's chain."] [120 1 "// AsDict is asDict, exported for the other files."] [123 1 "// Len is the number of items."] [147 1 "// matches is whether entry i's key (of the hash looked up) is key: the same object, the same str, else __eq__."] [167 3 "// directly, not through the slot: the types' dictionaries are filled by init functions that may"] [168 3 "// run before str's sets its slots"] [178 1 "// Get is d[key], nil when absent."] [191 1 "// Set is d[key] = v."] [216 1 "// insertNew appends key (of hash h, not in the dict) with value v."] [242 1 "// Delete removes key; false when absent."] [252 50 "// a hole; its chain link kept"] [261 1 "// Clear empties the dict."] [270 1 "// GetStr and SetStr are Get and Set with a str key (the namespaces')."] [278 1 "// nameStrs keeps the strs of the names GetStr and SetStr look up (attribute and special names), so each is made"] [279 1 "// and hashed once (at most nameStrsMax of them)."] [295 1 "// Items calls f on each item in order until it returns false."] [305 1 "// Keys is the keys in order."] [312 1 "// Copy is a shallow copy."] [326 1 "// Update is dict.update(o): a mapping's items (keys() and []), or an iterable of pairs."] [329 3 "// the other dict's entries by position, its change by a key's __eq__ an error (dict_merge's check of"] [330 3 "// dk_nentries; queue 203: test_merge_and_mutate)"] [360 3 "// PySequence_Fast(x, \"object is not iterable\"), its TypeError given the note (dict_merge_from_seq2; queue 203:"] [361 3 "// test_update_type_error)"] [396 16 "// a reverse iterator: i counts the entries left, from the last"] [397 16 "// the items still expected (di->len)"] [398 16 "// the dict's compactions when made"] [439 1 "// dictNew is dict(), dict(mapping or iterable, **kwargs)."] [570 4 "// the size checked, the iteration ended past the entries of a dict refilled since, and the keys changed"] [571 4 "// when it meets an item it did not expect (dictiter_iternextkey_lock_held, dictreviter_iter_lock_held;"] [572 4 "// queue 203: test_reversed_dict_after_clear_and_restore; before it any change of the keys was one)"] [577 4 "// compacted since (CPython's resize, at other moments): the positions lost, the keys changed"] [633 2 "// a view's mapping: a mappingproxy of its dict (dictview_mapping; queue 203: test_views_mapping)"] [665 1 "// dictViewCompare is dictview_richcompare: the sizes, then every item of one in the other by the other's"] [666 1 "// containment (an items view's: the key looked up, the values compared), no set made (queue 203: an unhashable"] [667 1 "// value compared, test_errors_in_view_containment_check)."] [749 1 "// dictMissing is d[k] on a dict subclass with __missing__: the method called with the key."] [765 1 "// newDictSubclass makes an instance of a dict subclass; PY5c sets it (by default the base value: PY5c wraps it)."] [802 3 "// the key hashed and looked up once (dict_setdefault_ref; queue 203: test_setdefault_atomic)"] [848 5 "// the slot leaves the index too: a later key of its hash looked up entries[i] past the end"] [849 5 "// (PY6e's REQUEST: test_os's mapping tests popitem then set)"] [850 5 "// the popped entry and the holes after it leave the index too: a later key appended at their"] [851 5 "// positions is found by its own chain only"] [888 2 "// dict.fromkeys, a class method (dict_fromkeys: cls() filled by its __setitem__; PY7: it was a plain built-in,"] [889 2 "// bound to an instance, d.fromkeys(keys) iterated d)"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[90 28] [114 25] [131 17] [131 47] [138 35] [153 22] [154 25] [166 24] [285 28] [297 12] [297 32] [308 55] [328 23] [332 13] [332 20] [335 50] [345 44] [364 27] [370 29] [424 23] [427 23] [447 29] [452 39] [461 49] [471 42] [506 25] [511 25] [544 49] [553 50] [669 27] [670 23] [698 28] [707 28] [713 28] [722 22] [733 27] [734 26] [755 33] [773 54] [783 40] [799 47] [823 40] [841 49] [845 30] [845 38] [876 47] [883 46] [894 24]]} (go/file "dict.go" :imports [



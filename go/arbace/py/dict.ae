(in-ns 'go.arbace.py) ^{:go/comments [[8 1 "// dict (Objects/dictobject.c): insertion-ordered, keys by hash and equality; its views and methods."] [18 2 "// reversed() of a dict and of its views (dict.__reversed__, 3.8; PY7: absent)"] [24 1 "// Dict is a dict: insertion-ordered (CPython's compact dict's iteration order). Deleted entries"] [25 1 "// leave holes (key nil) until the dict is compacted."] [26 1 "//"] [27 1 "// The index (202b; before it a Go map from a hash to a slice of its entries' positions, a slice allocated per"] [28 1 "// key): a Go map from a hash to the position of its first entry, made at the first insertion, and each entry the"] [29 1 "// position of the next entry of its hash (next, -1 at the end of the chain), so the keys of one hash are compared"] [30 1 "// in insertion order, as before. A chain may pass holes (deleted entries) until the dict is compacted."] [35 15 "// changed by every insertion and deletion (iteration's check)"] [36 15 "// the compactions so far (an iterator's positions no longer the entries')"] [37 2 "// ofType: the dict is a type's namespace; any change to it moves typeEpoch (the type attribute cache's)"] [44 19 "// the next entry of the hash, -1 none"] [49 1 "// BaseDict is the dict value of a dict or of a dict subclass's instance that embeds Dict."] [52 1 "// NewDict is an empty dict."] [55 1 "// rebuildIndex indexes the entries anew."] [65 1 "// indexAdd puts entry i (of hash h, the last entry) at the end of its hash's chain."] [83 1 "// indexForget takes entry i (of hash h, the last entry) out of its hash's chain."] [120 1 "// AsDict is asDict, exported for the other files."] [123 1 "// Len is the number of items."] [147 1 "// matches is whether entry i's key (of the hash looked up) is key: the same object, the same str, else __eq__."] [167 3 "// directly, not through the slot: the types' dictionaries are filled by init functions that may"] [168 3 "// run before str's sets its slots"] [178 1 "// Get is d[key], nil when absent."] [191 1 "// Set is d[key] = v."] [216 1 "// insertNew appends key (of hash h, not in the dict) with value v."] [242 1 "// Delete removes key; false when absent."] [252 50 "// a hole; its chain link kept"] [261 1 "// Clear empties the dict."] [270 1 "// GetStr and SetStr are Get and Set with a str key (the namespaces')."] [278 1 "// nameStr is the interned str of a name GetStr and SetStr look up (attribute and special names), a code's co_names"] [279 1 "// or an identifier-like str constant, so each is made and hashed once: sys.intern's table (internTable), as CPython"] [280 1 "// interns them all in one (queue 211; before it a table of its own, so `sys.intern(s) is name` could fail). At most"] [281 1 "// nameStrsMax names are added to it this way."] [298 1 "// Items calls f on each item in order until it returns false."] [308 1 "// Keys is the keys in order."] [315 1 "// Copy is a shallow copy."] [329 1 "// Update is dict.update(o): a mapping's items (keys() and []), or an iterable of pairs."] [332 3 "// the other dict's entries by position, its change by a key's __eq__ an error (dict_merge's check of"] [333 3 "// dk_nentries; queue 203: test_merge_and_mutate)"] [363 3 "// PySequence_Fast(x, \"object is not iterable\"), its TypeError given the note (dict_merge_from_seq2; queue 203:"] [364 3 "// test_update_type_error)"] [399 16 "// a reverse iterator: i counts the entries left, from the last"] [400 16 "// the items still expected (di->len)"] [401 16 "// the dict's compactions when made"] [442 1 "// dictNew is dict(), dict(mapping or iterable, **kwargs)."] [573 4 "// the size checked, the iteration ended past the entries of a dict refilled since, and the keys changed"] [574 4 "// when it meets an item it did not expect (dictiter_iternextkey_lock_held, dictreviter_iter_lock_held;"] [575 4 "// queue 203: test_reversed_dict_after_clear_and_restore; before it any change of the keys was one)"] [580 4 "// compacted since (CPython's resize, at other moments): the positions lost, the keys changed"] [636 2 "// a view's mapping: a mappingproxy of its dict (dictview_mapping; queue 203: test_views_mapping)"] [668 1 "// dictViewCompare is dictview_richcompare: the sizes, then every item of one in the other by the other's"] [669 1 "// containment (an items view's: the key looked up, the values compared), no set made (queue 203: an unhashable"] [670 1 "// value compared, test_errors_in_view_containment_check)."] [752 1 "// dictMissing is d[k] on a dict subclass with __missing__: the method called with the key."] [768 1 "// newDictSubclass makes an instance of a dict subclass; PY5c sets it (by default the base value: PY5c wraps it)."] [805 3 "// the key hashed and looked up once (dict_setdefault_ref; queue 203: test_setdefault_atomic)"] [851 5 "// the slot leaves the index too: a later key of its hash looked up entries[i] past the end"] [852 5 "// (PY6e's REQUEST: test_os's mapping tests popitem then set)"] [853 5 "// the popped entry and the holes after it leave the index too: a later key appended at their"] [854 5 "// positions is found by its own chain only"] [891 2 "// dict.fromkeys, a class method (dict_fromkeys: cls() filled by its __setitem__; PY7: it was a plain built-in,"] [892 2 "// bound to an instance, d.fromkeys(keys) iterated d)"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[90 28] [114 25] [131 17] [131 47] [138 35] [153 22] [154 25] [166 24] [287 31] [300 12] [300 32] [311 55] [331 23] [335 13] [335 20] [338 50] [348 44] [367 27] [373 29] [427 23] [430 23] [450 29] [455 39] [464 49] [474 42] [509 25] [514 25] [547 49] [556 50] [672 27] [673 23] [701 28] [710 28] [716 28] [725 22] [736 27] [737 26] [758 33] [776 54] [786 40] [802 47] [826 40] [844 49] [848 30] [848 38] [879 47] [886 46] [897 24]]} (go/file "dict.go" :imports [



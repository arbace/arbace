(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// dict (Objects/dictobject.c): insertion-ordered, keys by hash and equality; its views and methods."] [15 2 "// reversed() of a dict and of its views (dict.__reversed__, 3.8; PY7: absent)"] [21 1 "// Dict is a dict: insertion-ordered (CPython's compact dict's iteration order). Deleted entries"] [22 1 "// leave holes (key nil) until the dict is compacted."] [23 1 "//"] [24 1 "// The index (202b; before it a Go map from a hash to its entries' positions, a map and a slice allocated per dict"] [25 1 "// and per key): none while the dict has at most dictLinear entries, which a lookup scans in order; past them an"] [26 1 "// open-addressing table of the entries' positions (a power of two long, at most two thirds full, linear probing,"] [27 1 "// dictEmpty and dictDummy marks), each key in the first empty slot of its hash's probe sequence and never moved"] [28 1 "// but by a rebuild in the entries' order. Either way the keys of one hash are compared in insertion order, as"] [29 1 "// before."] [33 14 "// the index's slots not dictEmpty"] [35 14 "// changed by every insertion and deletion (iteration's check)"] [36 2 "// ofType: the dict is a type's namespace; any change to it moves typeEpoch (the type attribute cache's)"] [47 1 "// BaseDict is the dict value of a dict or of a dict subclass's instance that embeds Dict."] [50 1 "// NewDict is an empty dict."] [59 1 "// rebuildIndex indexes the entries anew (none while there are at most dictLinear of them)."] [91 1 "// indexAdd puts entry i (of hash h) in the index, or makes the index when the entries outgrow the linear scan."] [112 1 "// indexForget marks entry i's slot (of hash h) a dummy: the entry is gone and its position may be reused."] [139 1 "// AsDict is asDict, exported for the other files."] [142 1 "// Len is the number of items."] [161 13 "// a dummy, or a position popitem cut off"] [172 1 "// matches is whether entry i's key (of the hash looked up) is key: the same object, the same str, else __eq__."] [192 3 "// directly, not through the slot: the types' dictionaries are filled by init functions that may"] [193 3 "// run before str's sets its slots"] [203 1 "// Get is d[key], nil when absent."] [216 1 "// Set is d[key] = v."] [258 1 "// Delete removes key; false when absent."] [277 1 "// Clear empties the dict."] [286 1 "// GetStr and SetStr are Get and Set with a str key (the namespaces')."] [294 1 "// nameStrs keeps the strs of the names GetStr and SetStr look up (attribute and special names), so each is made"] [295 1 "// and hashed once (at most nameStrsMax of them)."] [311 1 "// Items calls f on each item in order until it returns false."] [321 1 "// Keys is the keys in order."] [328 1 "// Copy is a shallow copy."] [342 1 "// Update is dict.update(o): a mapping's items (keys() and []), or an iterable of pairs."] [394 15 "// a reverse iterator: i counts the entries left, from the last"] [435 1 "// dictNew is dict(), dict(mapping or iterable, **kwargs)."] [687 1 "// dictMissing is d[k] on a dict subclass with __missing__: the method called with the key."] [703 1 "// newDictSubclass makes an instance of a dict subclass; PY5c sets it (by default the base value: PY5c wraps it)."] [777 5 "// the slot leaves the index too: a later key of its hash looked up entries[i] past the end"] [778 5 "// (PY6e's REQUEST: test_os's mapping tests popitem then set)"] [779 5 "// the popped entry and the holes after it leave the index too: a later key appended at their"] [780 5 "// positions is found by its own slot only"] [817 2 "// dict.fromkeys, a class method (dict_fromkeys: cls() filled by its __setitem__; PY7: it was a plain built-in,"] [818 2 "// bound to an instance, d.fromkeys(keys) iterated d)"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[118 27] [118 52] [133 25] [148 13] [148 33] [149 25] [150 36] [158 27] [158 48] [163 24] [164 35] [178 22] [179 25] [191 24] [301 28] [313 12] [313 32] [324 55] [344 23] [347 50] [354 44] [420 23] [4
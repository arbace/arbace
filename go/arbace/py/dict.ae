(in-ns 'go.arbace.py) ^{:go/comments [[8 1 "// dict (Objects/dictobject.c): insertion-ordered, keys by hash and equality; its views and methods."] [18 2 "// reversed() of a dict and of its views (dict.__reversed__, 3.8; PY7: absent)"] [24 1 "// Dict is a dict: insertion-ordered (CPython's compact dict's iteration order). Deleted entries"] [25 1 "// leave holes (key nil) until the dict is compacted."] [26 1 "//"] [27 1 "// The index (202b; before it a Go map from a hash to a slice of its entries' positions, a slice allocated per"] [28 1 "// key): a Go map from a hash to the position of its first entry, made at the first insertion, and each entry the"] [29 1 "// position of the next entry of its hash (next, -1 at the end of the chain), so the keys of one hash are compared"] [30 1 "// in insertion order, as before. A chain may pass holes (deleted entries) until the dict is compacted."] [35 14 "// changed by every insertion and deletion (iteration's check)"] [36 2 "// ofType: the dict is a type's namespace; any change to it moves typeEpoch (the type attribute cache's)"] [43 19 "// the next entry of the hash, -1 none"] [48 1 "// BaseDict is the dict value of a dict or of a dict subclass's instance that embeds Dict."] [51 1 "// NewDict is an empty dict."] [54 1 "// rebuildIndex indexes the entries anew."] [64 1 "// indexAdd puts entry i (of hash h, the last entry) at the end of its hash's chain."] [82 1 "// indexForget takes entry i (of hash h, the last entry) out of its hash's chain."] [119 1 "// AsDict is asDict, exported for the other files."] [122 1 "// Len is the number of items."] [146 1 "// matches is whether entry i's key (of the hash looked up) is key: the same object, the same str, else __eq__."] [166 3 "// directly, not through the slot: the types' dictionaries are filled by init functions that may"] [167 3 "// run before str's sets its slots"] [177 1 "// Get is d[key], nil when absent."] [190 1 "// Set is d[key] = v."] [215 1 "// insertNew appends key (of hash h, not in the dict) with value v."] [240 1 "// Delete removes key; false when absent."] [250 50 "// a hole; its chain link kept"] [259 1 "// Clear empties the dict."] [268 1 "// GetStr and SetStr are Get and Set with a str key (the namespaces')."] [276 1 "// nameStrs keeps the strs of the names GetStr and SetStr look up (attribute and special names), so each is made"] [277 1 "// and hashed once (at most nameStrsMax of them)."] [293 1 "// Items calls f on each item in order until it returns false."] [303 1 "// Keys is the keys in order."] [310 1 "// Copy is a shallow copy."] [324 1 "// Update is dict.update(o): a mapping's items (keys() and []), or an iterable of pairs."] [327 3 "// the other dict's entries by position, its change by a key's __eq__ an error (dict_merge's check of"] [328 3 "// dk_nentries; queue 203: test_merge_and_mutate)"] [358 3 "// PySequence_Fast(x, \"object is not iterable\"), its TypeError given the note (dict_merge_from_seq2; queue 203:"] [359 3 "// test_update_type_error)"] [394 15 "// a reverse iterator: i counts the entries left, from the last"] [435 1 "// dictNew is dict(), dict(mapping or iterable, **kwargs)."] [566 4 "// a reverse iterator checks the size alone, and ends past the entries of a dict refilled since"] [567 4 "// (dictreviter_iternext; queue 203: test_reversed_dict_after_clear_and_restore)"] [622 2 "// a view's mapping: a mappingproxy of its dict (dictview_mapping; queue 203: test_views_mapping)"] [654 1 "// dictViewCompare is dictview_richcompare: the sizes, then every item of one in the other by the other's"] [655 1 "// containment (an items view's: the key looked up, the values compared), no set made (queue 203: an unhashable"] [656 1 "// value compared, test_errors_in_view_containment_check)."] [738 1 "// dictMissing is d[k] on a dict subclass with __missing__: the method called with the key."] [754 1 "// newDictSubclass makes an instance of a dict subclass; PY5c sets it (by default the base value: PY5c wraps it)."] [791 3 "// the key hashed and looked up once (dict_setdefault_ref; queue 203: test_setdefault_atomic)"] [837 5 "// the slot leaves the index too: a later key of its hash looked up entries[i] past the end"] [838 5 "// (PY6e's REQUEST: test_os's mapping tests popitem then set)"] [839 5 "// the popped entry and the holes after it leave the index too: a later key appended at their"] [840 5 "// positions is found by its own chain only"] [877 2 "// dict.fromkeys, a class method (dict_fromkeys: cls() filled by its __setitem__; PY7: it was a plain built-in,"] [878 2 "// bound to an instance, d.fromkeys(keys) iterated d)"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[89 28] [113 25] [130 17] [130 47] [137 35] [152 22] [153 25] [165 24] [283 28] [295 12] [295 32] [306 55] [326 23] [330 13] [330 20] [333 50] [343 44] [362 27] [368 29] [420 23] [423 23] [443 29] [448 39] [457 49] [467 42] [502 25] [507 25] [540 49] [549 50] [658 27] [659 23] [687 28] [696 28] [702 28] [711 22] [722 27] [723 26] [744 33] [762 54] [772 40] [788 47] [812 40] [830 49] [834 30] [834 38] [865 47] [872 46] [883 24]]} (go/file "dict.go" :imports [



(in-ns 'go.arbace.py) ^{:go/comments [[8 1 "// dict (Objects/dictobject.c): insertion-ordered, keys by hash and equality; its views and methods."] [18 2 "// reversed() of a dict and of its views (dict.__reversed__, 3.8; PY7: absent)"] [24 1 "// Dict is a dict: insertion-ordered (CPython's compact dict's iteration order). Deleted entries"] [25 1 "// leave holes (key nil) until the dict is compacted."] [26 1 "//"] [27 1 "// The index (202b; before it a Go map from a hash to a slice of its entries' positions, a slice allocated per"] [28 1 "// key): a Go map from a hash to the position of its first entry, made at the first insertion, and each entry the"] [29 1 "// position of the next entry of its hash (next, -1 at the end of the chain), so the keys of one hash are compared"] [30 1 "// in insertion order, as before. A chain may pass holes (deleted entries) until the dict is compacted."] [34 2 "// mask has bit h&63 set for the hash h of every key indexed since the index was last made (indexAdd; queue 210):"] [35 2 "// a key whose bit is clear is not in the dict, found so without the index's lookup (an instance's dict looked up"] [36 2 "// for a method's name, a module's for a builtin's)"] [39 15 "// changed by every insertion and deletion (iteration's check)"] [40 15 "// the compactions so far (an iterator's positions no longer the entries')"] [41 2 "// ofType: the dict is a type's namespace; any change to it moves typeEpoch (the type attribute cache's)"] [43 2 "// escaped: an instance's dict handed out as an object (__dict__, __getstate__, a thread-local's): gc.collect's"] [44 2 "// cycle detection no longer folds it into its instance (finalize.go, queue 222)"] [46 2 "// watched: the C API's dict watchers' bits (PyDict_Watch; watchers.go, queue 274), beside the flags (no larger dict)"] [48 2 "// self is the dict subclass's instance around this dict, when one was assigned as an object's __dict__ (dictOf)"] [55 19 "// the next entry of the hash, -1 none"] [60 1 "// BaseDict is the dict value of a dict or of a dict subclass's instance that embeds Dict."] [63 1 "// NewDict is an empty dict."] [66 12 "// _tracemalloc's allocation (queue 220)"] [72 1 "// rebuildIndex indexes the entries anew."] [83 1 "// indexAdd puts entry i (of hash h, the last entry) at the end of its hash's chain."] [102 1 "// indexForget takes entry i (of hash h, the last entry) out of its hash's chain."] [139 1 "// AsDict is asDict, exported for the other files."] [142 1 "// Len is the number of items."] [169 1 "// matches is whether entry i's key (of the hash looked up) is key: the same object, the same str, else __eq__."] [189 3 "// directly, not through the slot: the types' dictionaries are filled by init functions that may"] [190 3 "// run before str's sets its slots"] [200 1 "// Get is d[key], nil when absent."] [213 1 "// Set is d[key] = v."] [244 1 "// insertNew appends key (of hash h, not in the dict) with value v."] [270 1 "// Delete removes key; false when absent."] [283 50 "// a hole; its chain link kept"] [292 1 "// Clear empties the dict."] [304 1 "// GetStr and SetStr are Get and Set with a str key (the namespaces')."] [312 1 "// nameStr is the interned str of a name GetStr and SetStr look up (attribute and special names), a code's co_names"] [313 1 "// or an identifier-like str constant, so each is made and hashed once: sys.intern's table (internTable), as CPython"] [314 1 "// interns them all in one (queue 211; before it a table of its own, so `sys.intern(s) is name` could fail). At most"] [315 1 "// nameStrsMax names are added to it this way."] [332 1 "// Items calls f on each item in order until it returns false."] [342 1 "// Keys is the keys in order."] [349 1 "// Copy is a shallow copy."] [363 1 "// Update is dict.update(o): a mapping's items (keys() and []), or an iterable of pairs."] [366 3 "// the other dict's entries by position, its change by a key's __eq__ an error (dict_merge's check of"] [367 3 "// dk_nentries; queue 203: test_merge_and_mutate)"] [369 4 "// dict_merge's clone of a compact dict into an empty one: one CLONED event, not one per key (queue 274)"] [408 3 "// PySequence_Fast(x, \"object is not iterable\"), its TypeError given the note (dict_merge_from_seq2; queue 203:"] [409 3 "// test_update_type_error)"] [444 16 "// a reverse iterator: i counts the entries left, from the last"] [445 16 "// the items still expected (di->len)"] [446 16 "// the dict's compactions when made"] [487 1 "// dictNew is dict(), dict(mapping or iterable, **kwargs)."] [618 4 "// the size checked, the iteration ended past the entries of a dict refilled since, and the keys changed"] [619 4 "// when it meets an item it did not expect (dictiter_iternextkey_lock_held, dictreviter_iter_lock_held;"] [620 4 "// queue 203: test_reversed_dict_after_clear_and_restore; before it any change of the keys was one)"] [625 4 "// compacted since (CPython's resize, at other moments): the positions lost, the keys changed"] [657 3 "// __length_hint__ is dictiter_len (queue 304): the items left while the dict keeps its size, else 0"] [667 3 "// __reduce__ is dictiter_reduce: (iter, (list,)), the list the items a copy of the iterator would give,"] [668 3 "// the iterator itself not advanced (queue 211: test_dict's six *iterator_pickling tests)"] [711 2 "// a view's mapping: a mappingproxy of its dict (dictview_mapping; queue 203: test_views_mapping)"] [743 1 "// dictViewCompare is dictview_richcompare: the sizes, then every item of one in the other by the other's"] [744 1 "// containment (an items view's: the key looked up, the values compared), no set made (queue 203: an unhashable"] [745 1 "// value compared, test_errors_in_view_containment_check)."] [827 1 "// dictMissing is d[k] on a dict subclass with __missing__: the method called with the key."] [843 1 "// newDictSubclass makes an instance of a dict subclass; PY5c sets it (by default the base value: PY5c wraps it)."] [880 3 "// the key hashed and looked up once (dict_setdefault_ref; queue 203: test_setdefault_atomic)"] [932 5 "// the slot leaves the index too: a later key of its hash looked up entries[i] past the end"] [933 5 "// (PY6e's REQUEST: test_os's mapping tests popitem then set)"] [934 5 "// the popped entry and the holes after it leave the index too: a later key appended at their"] [935 5 "// positions is found by its own chain only"] [972 2 "// dict.fromkeys, a class method (dict_fromkeys: cls() filled by its __setitem__; PY7: it was a plain built-in,"] [973 2 "// bound to an instance, d.fromkeys(keys) iterated d)"] [995 3 "// 3.15's _PyDict_FromKeys: a constructor that returned a frozendict, its copy filled, then cls(copy) (queue 237)"] [1003 1 "// keysIterable315 is 3.15's method_output_as_list (Objects/abstract.c; queue 252, P6): a keys() result that is not"] [1004 1 "// iterable is \"%T.keys() must return an iterable, not %T\", the mapping's type by its fully qualified name. Under 3.14"] [1005 1 "// nothing (the iteration's own error, as before)."] [1023 1 "// typeFullyQualified is _PyType_GetFullyQualifiedName(type, '.') (%T): the qualified name, after the module unless"] [1024 1 "// it is builtins or __main__."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[109 28] [133 25] [153 17] [153 47] [160 35] [175 22] [176 25] [188 24] [321 31] [334 12] [334 32] [345 55] [365 23] [377 13] [377 20] [380 50] [390 44] [395 35] [412 27] [418 29] [472 23] [475 23] [495 29] [500 39] [509 49] [519 42] [554 25] [559 25] [592 49] [601 50] [659 54] [662 32] [670 49] [747 27] [748 23] [776 28] [785 28] [791 28] [800 22] [811 27] [812 26] [833 33] [851 54] [861 40] [877 47] [904 40] [922 49] [926 30] [926 38] [960 47] [967 46] [978 24] [996 30] [1010 24] [1013 26] [1014 28]]} (go/file "dict.go" :imports [



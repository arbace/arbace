(in-ns 'go.arbace.py) ^{:go/comments [[8 1 "// dict (Objects/dictobject.c): insertion-ordered, keys by hash and equality; its views and methods."] [18 2 "// reversed() of a dict and of its views (dict.__reversed__, 3.8; PY7: absent)"] [24 1 "// Dict is a dict: insertion-ordered (CPython's compact dict's iteration order). Deleted entries"] [25 1 "// leave holes (key nil) until the dict is compacted."] [26 1 "//"] [27 1 "// The index (202b; before it a Go map from a hash to a slice of its entries' positions, a slice allocated per"] [28 1 "// key): a Go map from a hash to the position of its first entry, made at the first insertion, and each entry the"] [29 1 "// position of the next entry of its hash (next, -1 at the end of the chain), so the keys of one hash are compared"] [30 1 "// in insertion order, as before. A chain may pass holes (deleted entries) until the dict is compacted."] [34 2 "// mask has bit h&63 set for the hash h of every key indexed since the index was last made (indexAdd; queue 210):"] [35 2 "// a key whose bit is clear is not in the dict, found so without the index's lookup (an instance's dict looked up"] [36 2 "// for a method's name, a module's for a builtin's)"] [39 15 "// changed by every insertion and deletion (iteration's check)"] [40 15 "// the compactions so far (an iterator's positions no longer the entries')"] [41 2 "// ofType: the dict is a type's namespace; any change to it moves typeEpoch (the type attribute cache's)"] [43 2 "// escaped: an instance's dict handed out as an object (__dict__, __getstate__, a thread-local's): gc.collect's"] [44 2 "// cycle detection no longer folds it into its instance (finalize.go, queue 222)"] [46 2 "// watched: the C API's dict watchers' bits (PyDict_Watch; watchers.go, queue 274), beside the flags (no larger dict)"] [48 2 "// self is the dict subclass's instance around this dict, when one was assigned as an object's __dict__ (dictOf)"] [55 19 "// the next entry of the hash, -1 none"] [60 1 "// BaseDict is the dict value of a dict or of a dict subclass's instance that embeds Dict."] [63 1 "// NewDict is an empty dict."] [66 12 "// _tracemalloc's allocation (queue 220)"] [72 1 "// newDictSized is a new dict with room for n entries."] [81 1 "// rebuildIndex indexes the entries anew."] [92 1 "// indexAdd puts entry i (of hash h, the last entry) at the end of its hash's chain."] [111 1 "// indexForget takes entry i (of hash h, the last entry) out of its hash's chain."] [148 1 "// AsDict is asDict, exported for the other files."] [151 1 "// Len is the number of items."] [178 1 "// matches is whether entry i's key (of the hash looked up) is key: the same object, the same str, else __eq__."] [198 3 "// directly, not through the slot: the types' dictionaries are filled by init functions that may"] [199 3 "// run before str's sets its slots"] [209 1 "// Get is d[key], nil when absent."] [222 1 "// Set is d[key] = v."] [253 1 "// insertNew appends key (of hash h, not in the dict) with value v."] [279 1 "// Delete removes key; false when absent."] [292 50 "// a hole; its chain link kept"] [301 1 "// Clear empties the dict."] [313 1 "// GetStr and SetStr are Get and Set with a str key (the namespaces')."] [321 1 "// nameStr is the interned str of a name GetStr and SetStr look up (attribute and special names), a code's co_names"] [322 1 "// or an identifier-like str constant, so each is made and hashed once: sys.intern's table (internTable), as CPython"] [323 1 "// interns them all in one (queue 211; before it a table of its own, so `sys.intern(s) is name` could fail). At most"] [324 1 "// nameStrsMax names are added to it this way."] [341 1 "// Items calls f on each item in order until it returns false."] [351 1 "// Keys is the keys in order."] [358 1 "// Copy is a shallow copy."] [372 1 "// Update is dict.update(o): a mapping's items (keys() and []), or an iterable of pairs."] [375 3 "// the other dict's entries by position, its change by a key's __eq__ an error (dict_merge's check of"] [376 3 "// dk_nentries; queue 203: test_merge_and_mutate)"] [378 4 "// dict_merge's clone of a compact dict into an empty one: one CLONED event, not one per key (queue 274)"] [417 3 "// PySequence_Fast(x, \"object is not iterable\"), its TypeError given the note (dict_merge_from_seq2; queue 203:"] [418 3 "// test_update_type_error)"] [453 16 "// a reverse iterator: i counts the entries left, from the last"] [454 16 "// the items still expected (di->len)"] [455 16 "// the dict's compactions when made"] [496 1 "// dictNew is dict(), dict(mapping or iterable, **kwargs)."] [627 4 "// the size checked, the iteration ended past the entries of a dict refilled since, and the keys changed"] [628 4 "// when it meets an item it did not expect (dictiter_iternextkey_lock_held, dictreviter_iter_lock_held;"] [629 4 "// queue 203: test_reversed_dict_after_clear_and_restore; before it any change of the keys was one)"] [634 4 "// compacted since (CPython's resize, at other moments): the positions lost, the keys changed"] [666 3 "// __length_hint__ is dictiter_len (queue 304): the items left while the dict keeps its size, else 0"] [676 3 "// __reduce__ is dictiter_reduce: (iter, (list,)), the list the items a copy of the iterator would give,"] [677 3 "// the iterator itself not advanced (queue 211: test_dict's six *iterator_pickling tests)"] [720 2 "// a view's mapping: a mappingproxy of its dict (dictview_mapping; queue 203: test_views_mapping)"] [752 1 "// dictViewCompare is dictview_richcompare: the sizes, then every item of one in the other by the other's"] [753 1 "// containment (an items view's: the key looked up, the values compared), no set made (queue 203: an unhashable"] [754 1 "// value compared, test_errors_in_view_containment_check)."] [836 1 "// dictMissing is d[k] on a dict subclass with __missing__: the method called with the key."] [852 1 "// newDictSubclass makes an instance of a dict subclass; PY5c sets it (by default the base value: PY5c wraps it)."] [889 3 "// the key hashed and looked up once (dict_setdefault_ref; queue 203: test_setdefault_atomic)"] [941 5 "// the slot leaves the index too: a later key of its hash looked up entries[i] past the end"] [942 5 "// (PY6e's REQUEST: test_os's mapping tests popitem then set)"] [943 5 "// the popped entry and the holes after it leave the index too: a later key appended at their"] [944 5 "// positions is found by its own chain only"] [981 2 "// dict.fromkeys, a class method (dict_fromkeys: cls() filled by its __setitem__; PY7: it was a plain built-in,"] [982 2 "// bound to an instance, d.fromkeys(keys) iterated d)"] [1004 3 "// 3.15's _PyDict_FromKeys: a constructor that returned a frozendict, its copy filled, then cls(copy) (queue 237)"] [1012 1 "// keysIterable315 is 3.15's method_output_as_list (Objects/abstract.c; queue 252, P6): a keys() result that is not"] [1013 1 "// iterable is \"%T.keys() must return an iterable, not %T\", the mapping's type by its fully qualified name. Under 3.14"] [1014 1 "// nothing (the iteration's own error, as before)."] [1032 1 "// typeFullyQualified is _PyType_GetFullyQualifiedName(type, '.') (%T): the qualified name, after the module unless"] [1033 1 "// it is builtins or __main__."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[118 28] [142 25] [162 17] [162 47] [169 35] [184 22] [185 25] [197 24] [330 31] [343 12] [343 32] [354 55] [374 23] [386 13] [386 20] [389 50] [399 44] [404 35] [421 27] [427 29] [481 23] [484 23] [504 29] [509 39] [518 49] [528 42] [563 25] [568 25] [601 49] [610 50] [668 54] [671 32] [679 49] [756 27] [757 23] [785 28] [794 28] [800 28] [809 22] [820 27] [821 26] [842 33] [860 54] [870 40] [886 47] [913 40] [931 49] [935 30] [935 38] [969 47] [976 46] [987 24] [1005 30] [1019 24] [1022 26] [1023 28]]} (go/file "dict.go" :imports [



(in-ns 'go.arbace.py) ^{:go/comments [[3 1 "// The CJK codecs' state machines but ISO 2022's (PY6c2): ports of CPython 3.14.10's Modules/cjkcodecs/_codecs_cn.c"] [4 1 "// (gb2312, gbk, gb18030, hz), _codecs_tw.c (big5, cp950), _codecs_kr.c (euc_kr, cp949, johab), _codecs_hk.c"] [5 1 "// (big5hkscs) and _codecs_jp.c (shift_jis, cp932, euc_jp, shift_jis_2004, euc_jis_2004, euc_jisx0213,"] [6 1 "// shift_jisx0213) with alg_jisx0201.h and emu_jisx0213_2000.h, the C's statements in the C's order. An encoder"] [7 1 "// appends to an output that never runs short, so REQUIRE_OUTBUF never answers MBERR_TOOSMALL (the C retries the"] [8 1 "// same call after growing its buffer: the same result); a decoder reads in[*ip:] (inleft is len(in)-*ip)."] [10 1 "// the tables, set when their module is made (cjkTables)"] [111 1 "// --- _codecs_cn.c ---"] [113 1 "// gbkDecodeChar is GBK_DECODE: the character of (dc1, dc2), ok false when none."] [129 1 "// gbkEncodeChar is GBK_ENCODE."] [301 33 "// 4 bytes seq"] [313 15 "// U+0080 - U+FFFF"] [325 24 "// U+10000 - U+10FFFF"] [408 15 "// set GB"] [410 5 "// line-continuation"] [412 15 "// set ASCII"] [422 19 "// ASCII mode"] [425 12 "// GB mode"] [440 1 "// --- _codecs_tw.c ---"] [532 1 "// --- _codecs_kr.c ---"] [562 4 "// KS X 1001 coded character"] [566 4 "// Mapping is found in CP949 extension, but we encode it in KS X 1001:1998 make-up sequence for EUC-KR"] [578 29 "// [A1, BE]"] [581 30 "// [A1, BE]"] [598 4 "// KS X 1001:1998 make-up sequence"] [657 53 "// MSB set: CP949"] [659 58 "// MSB unset: ks x 1001"] [790 4 "// johab hangul"] [800 4 "// we don't use U+1100 hangul jamo yet."] [832 4 "// KS X 1001 except hangul jamos and syllables"] [866 1 "// --- _codecs_hk.c ---"] [897 16 "// c == 0xea"] [980 12 "// all decoded code points are pairs, above."] [985 1 "// --- _codecs_jp.c ---"] [991 1 "// jisx0213Emu2000EncodeBMP is EMULATE_JISX0213_2000_ENCODE_BMP: invalid true (the macro's return), else code and"] [992 1 "// set true when it assigns."] [1003 1 "// jisx0213Emu2000DecodePlane1 is EMULATE_JISX0213_2000_DECODE_PLANE1's condition."] [1023 4 "// Windows compatibility"] [1038 26 "// MSB set: JIS X 0212"] [1041 4 "// JIS X 0208"] [1059 4 "// User-defined area"] [1084 29 "// half-width katakana"] [1091 4 "// Windows compatibility"] [1146 1 "// jisx0213PairEncode is the MULTIC branch of euc_jis_2004's and shift_jis_2004's encoders: the code, insize, and r"] [1147 1 "// non-zero for the encoder's return."] [1168 4 "// Don't consume null char as part of pair"] [1203 5 "// JIS X 0201 half-width katakana"] [1208 5 "// F/W REVERSE SOLIDUS (see NOTES)"] [1211 5 "// F/W TILDE (see NOTES)"] [1228 4 "// Codeset 2"] [1231 4 "// Codeset 1"] [1249 4 "// JIS X 0201 half-width katakana"] [1266 4 "// JIS X 0213 Plane 2 or JIS X 0212 (see NOTES)"] [1287 4 "// JIS X 0213 Plane 1"] [1330 4 "// JIS X 0201 half-width katakana"] [1334 27 "// FULL-WIDTH REVERSE SOLIDUS"] [1336 25 "// YEN SIGN"] [1340 27 "// OVERLINE"] [1348 4 "// JIS X 0212"] [1351 4 "// JIS X 0208"] [1368 4 "// JIS X 0201 half-width katakana"] [1384 4 "// JIS X 0212"] [1396 4 "// JIS X 0208"] [1398 5 "// FULL-WIDTH REVERSE SOLIDUS"] [1411 1 "// sjisOut is shift_jis's and cp932's JIS X 0208 row/cell to Shift_JIS bytes."] [1438 16 "// YEN SIGN"] [1440 16 "// OVERLINE"] [1457 19 "// FULL-WIDTH REVERSE SOLIDUS"] [1461 26 "// MSB set: JIS X 0212"] [1505 5 "// FULL-WIDTH REVERSE SOLIDUS"] [1519 9 "// JIS X 0201"] [1529 3 "// JISX0201_ENCODE"] [1562 6 "// abandon JIS X 0212 codes"] [1584 4 "// Plane 2"] [1593 4 "// Plane 1"] [1617 3 "// JISX0201_DECODE"] [1656 19 "// Plane 1"] [1673 13 "// Plane 2"] [1699 9 "// JIS X 0201"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[88 40] [121 57] [123 47] [138 39] [180 63] [266 14] [266 27] [335 51] [337 65] [347 60] [394 61] [395 61] [429 62] [474 51] [520 40] [522 43] [631 74] [678 65] [680 63] [719 40] [855 57] [882 41] [902 40] [939 53] [945 57] [989 60] [1035 39] [1037 48] [1100 56] [1123 57] [1187 57] [1191 47] [1200 46] [1219 56] [1269 54] [1271 54] [1275 49] [1294 49] [1296 54] [1298 54] [1302 53] [1327 38] [1385 68] [1400 74] [1454 39] [1510 58] [1547 58] [1551 48] [1560 47] [1572 57] [1661 50] [1663 55] [1665 55] [1667 54] [1684 55] [1686 55]]} (go/file "builtins_cjk_codecs.go" :imports [])

;; The CJK codecs' state machines but ISO 2022's (PY6c2): ports of CPython 3.14.10's Modules/cjkcodecs/_codecs_cn.c
;; (gb2312, gbk, gb18030, hz), _codecs_tw.c (big5, cp950), _codecs_kr.c (euc_kr, cp949, johab), _codecs_hk.c
;; (big5hkscs) and _codecs_jp.c (shift_jis, cp932, euc_jp, shift_jis_2004, euc_jis_2004, euc_jisx0213,
;; shift_jisx0213) with alg_jisx0201.h and emu_jisx0213_2000.h, the C's statements in the C's order. An encoder
;; appends to an output that never runs short, so REQUIRE_OUTBUF never answers MBERR_TOOSMALL (the C retries the
;; same call after growing its buffer: the same result); a decoder reads in[*ip:] (inleft is len(in)-*ip).



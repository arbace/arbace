(in-ns 'go.arbace.py) ^{:go/comments [[3 1 "// The type's sizes (queue 525; typeobject.c's type_members: __basicsize__, __itemsize__, __dictoffset__ and"] [4 1 "// __weakrefoffset__, members of type, so a class's instances do not list them in dir()): a C extension's type's from"] [5 1 "// its spec (ExtTypeSizes, arbace/pyctypes), a built-in type's CPython 3.14.10's on linux/amd64 (builtinTypeSizes,"] [6 1 "// python3's), a built-in type it does not name its base's, and a class's as type_new_descriptors makes them: the base's"] [7 1 "// basic size and a pointer per own slot, the base's item size, the base's dict and weakref offsets, else -1 for a"] [8 1 "// managed __dict__ and -32 for a managed __weakref__ (Py_TPFLAGS_MANAGED_DICT, MANAGED_WEAKREF) when it adds them."] [10 1 "// ExtTypeSizes is a C extension's type's tp_basicsize, tp_itemsize, tp_dictoffset and tp_weaklistoffset, found false"] [11 1 "// for another type."] [14 1 "// builtinTypeSizes are CPython 3.14.10's sizes of the built-in types of builtins and types, by module and qualified"] [15 1 "// name (basic, item, dict, weak)."] [138 1 "// typeSizes is t's (basic, item, dict, weak)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[141 39] [146 50]] :go/trails [[135 55]]} (go/file "typesizes.go" :imports [])

;; The type's sizes (queue 525; typeobject.c's type_members: __basicsize__, __itemsize__, __dictoffset__ and
;; __weakrefoffset__, members of type, so a class's instances do not list them in dir()): a C extension's type's from
;; its spec (ExtTypeSizes, arbace/pyctypes), a built-in type's CPython 3.14.10's on linux/amd64 (builtinTypeSizes,
;; python3's), a built-in type it does not name its base's, and a class's as type_new_descriptors makes them: the base's
;; basic size and a pointer per own slot, the base's item size, the base's dict and weakref offsets, else -1 for a
;; managed __dict__ and -32 for a managed __weakref__ (Py_TPFLAGS_MANAGED_DICT, MANAGED_WEAKREF) when it adds them.




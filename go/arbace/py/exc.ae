(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// The built-in exceptions (Objects/exceptions.c): CPython 3.14's hierarchy, BaseExceptionGroup,"] [6 1 "// ExceptionGroup, GeneratorExit and StopAsyncIteration aside (PY5d's: excgroup.go, gen.go, coro.go); their attributes: args, __cause__, __context__,"] [7 1 "// __suppress_context__, __traceback__, __notes__ and add_note, StopIteration's value, the OSError,"] [8 1 "// SyntaxError, ImportError, NameError, AttributeError and Unicode errors' fields (Dict)."] [77 1 "// Exception is an exception object (CPython's PyBaseExceptionObject): its type, arguments and"] [78 1 "// chaining. A class deriving from an exception type makes Exceptions of its type (PY5c); the"] [79 1 "// subclass-specific fields (StopIteration.value, OSError.errno, ...) are in Dict."] [88 2 "// Ext is a subtype's own data (an exception group's message and exceptions: PY5d's excgroup.go)"] [94 1 "// Traceback is a traceback entry (tb_frame, tb_lasti, tb_next): the outermost frame first, Next inward,"] [95 1 "// as CPython links them; the line is the code's :lines at PC."] [106 1 "// NewException is an exception of type t with args, its fields set from them as __init__ sets them."] [113 1 "// initExceptionFields sets the fields BaseException's subclasses derive from their arguments."] [171 1 "// osErrorSubtype is OSError_new's errno mapping (Linux's errno values): OSError(errno, ...) of the subclass errno"] [172 1 "// names, OSError itself for any other."] [180 21 "// EAGAIN (EWOULDBLOCK), EALREADY, EINPROGRESS"] [182 11 "// ECHILD"] [184 16 "// EPIPE, ESHUTDOWN"] [186 12 "// ECONNABORTED"] [188 12 "// ECONNREFUSED"] [190 12 "// ECONNRESET"] [192 11 "// EEXIST"] [194 10 "// ENOENT"] [196 11 "// EISDIR"] [198 11 "// ENOTDIR"] [200 10 "// EINTR"] [202 14 "// EPERM, EACCES"] [204 10 "// ESRCH"] [206 12 "// ETIMEDOUT"] [212 1 "// isExcField is whether name is one of t's member fields (initExceptionFields', SyntaxError's _metadata,"] [213 1 "// the Unicode errors')."] [234 1 "// Field is one of the exception's fields (StopIteration's value ...), nil when absent."] [242 1 "// exceptionText is str(exc): its single argument's str, or the arguments' tuple; KeyError's single"] [243 1 "// argument's repr; an OSError's \"[Errno N] text\"."] [246 44 "// PY6c, codecs_errors.go"] [290 1 "// syntaxErrorText is SyntaxError_str: str(msg), then \" (FILE, line N)\" with the filename's base name and an int"] [291 1 "// lineno, either alone when the other is missing."] [339 1 "// BaseException is the exception value itself (the subclass convention of §7.1)."] [372 61 "// PY6c, codecs_errors.go"] [381 58 "// PY6c, codecs_errors.go"] [418 55 "// PY6c, codecs_errors.go"] [428 60 "// PY6c, codecs_errors.go"] [463 4 "// a T_BOOL member: a bool only"] [470 4 "// a plain attribute (CPython keeps it in the instance dict): a list kept as Notes, anything else in the dict"] [495 5 "// the fields are members: deleting one resets it to None (test_object_attributes)"] [509 2 "// BaseException.__setstate__ (BaseException_setstate): each item of a dict state set as an attribute"] [571 1 "// importErrorKw is the keyword arguments of ImportError (name, path, name_from; ImportError_init; PY6a, by the"] [572 1 "// integration's owner: importlib raises ModuleNotFoundError(msg, name=name)), NameError (name) and AttributeError"] [573 1 "// (name, obj; NameError_init, AttributeError_init)."] [597 1 "// kwException is an exception type whose __init__ takes keyword arguments (importErrorKw's)."] [602 1 "// attributeErrorContext is _PyObject_SetAttributeErrorContext: an AttributeError from getattr(o, name) not yet"] [603 1 "// augmented gets its name and obj."] [620 1 "// nameError is the NameError of an undefined name, its name set (as ceval's format_exc_check_arg)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[161 30] [246 37] [266 31] [303 49] [305 39] [311 47] [327 28] [330 57] [333 25] [362 45] [372 46] [381 51] [418 48] [421 33] [428 53] [449 26] [480 29] [486 31] [500 38] [528 36] [539 29] [543 32] [553 36] [609 29] [612 28]]} (go/file "exc.go" :imports [

    ^{:go/apos {1 [3 8]} :go/pos {:tok-pos [3 1]}} [strings "strings"]])


(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// The built-in exceptions (Objects/exceptions.c): CPython 3.14's hierarchy, BaseExceptionGroup,"] [6 1 "// ExceptionGroup, GeneratorExit and StopAsyncIteration aside (PY5d's: excgroup.go, gen.go, coro.go); their attributes: args, __cause__, __context__,"] [7 1 "// __suppress_context__, __traceback__, __notes__ and add_note, StopIteration's value, the OSError,"] [8 1 "// SyntaxError, ImportError, NameError, AttributeError and Unicode errors' fields (Dict)."] [54 2 "// _IncompleteInputError (3.13): compile()'s incomplete input under PyCF_ALLOW_INCOMPLETE_INPUT, codeop's (PY7)"] [79 1 "// Exception is an exception object (CPython's PyBaseExceptionObject): its type, arguments and"] [80 1 "// chaining. A class deriving from an exception type makes Exceptions of its type (PY5c); the"] [81 1 "// subclass-specific fields (StopIteration.value, OSError.errno, ...) are in Dict."] [90 2 "// Ext is a subtype's own data (an exception group's message and exceptions: PY5d's excgroup.go)"] [96 1 "// Traceback is a traceback entry (tb_frame, tb_lasti, tb_next): the outermost frame first, Next inward,"] [97 1 "// as CPython links them; the line is the code's :lines at PC."] [108 1 "// NewException is an exception of type t with args, its fields set from them as __init__ sets them."] [115 1 "// initExceptionFields sets the fields BaseException's subclasses derive from their arguments."] [142 34 "// oserror_init: with a filename, args are the first two (PY6d's REQUEST)"] [170 1 "// syntaxErrorDetails is SyntaxError_init's second argument: with exactly two arguments, tuple(args[1]) gives"] [171 1 "// filename, lineno, offset, text and optionally end_lineno, end_offset, _metadata (\"OOOO|OOO\"), and an end_lineno"] [172 1 "// needs its end_offset."] [197 1 "// osErrorSubtype is OSError_new's errno mapping (Linux's errno values): OSError(errno, ...) of the subclass errno"] [198 1 "// names, OSError itself for any other."] [206 21 "// EAGAIN (EWOULDBLOCK), EALREADY, EINPROGRESS"] [208 11 "// ECHILD"] [210 16 "// EPIPE, ESHUTDOWN"] [212 12 "// ECONNABORTED"] [214 12 "// ECONNREFUSED"] [216 12 "// ECONNRESET"] [218 11 "// EEXIST"] [220 10 "// ENOENT"] [222 11 "// EISDIR"] [224 11 "// ENOTDIR"] [226 10 "// EINTR"] [228 14 "// EPERM, EACCES"] [230 10 "// ESRCH"] [232 12 "// ETIMEDOUT"] [238 1 "// isExcField is whether name is one of t's member fields (initExceptionFields', SyntaxError's _metadata,"] [239 1 "// the Unicode errors')."] [260 1 "// Field is one of the exception's fields (StopIteration's value ...), nil when absent."] [268 1 "// exceptionText is str(exc): its single argument's str, or the arguments' tuple; KeyError's single"] [269 1 "// argument's repr; an OSError's \"[Errno N] text\"."] [272 44 "// PY6c, codecs_errors.go"] [320 1 "// syntaxErrorText is SyntaxError_str: str(msg), then \" (FILE, line N)\" with the filename's base name and an int"] [321 1 "// lineno, either alone when the other is missing."] [369 1 "// BaseException is the exception value itself (the subclass convention of §7.1)."] [412 61 "// PY6c, codecs_errors.go"] [421 58 "// PY6c, codecs_errors.go"] [458 55 "// PY6c, codecs_errors.go"] [468 60 "// PY6c, codecs_errors.go"] [503 4 "// a T_BOOL member: a bool only"] [510 4 "// a plain attribute (CPython keeps it in the instance dict): a list kept as Notes, anything else in the dict"] [535 5 "// the fields are members: deleting one resets it to None (test_object_attributes)"] [549 2 "// BaseException.__setstate__ (BaseException_setstate): each item of a dict state set as an attribute"] [574 2 "// pickling (PY6d's REQUEST; exceptions.c's BaseException___reduce___impl, OSError_reduce, ImportError_reduce):"] [575 2 "// (type, args[, dict]), the dict without the type's member fields; an OSError's filename (and filename2) back"] [576 2 "// in its args; an ImportError's name, path and name_from in its state"] [676 1 "// importErrorKw is the keyword arguments of ImportError (name, path, name_from; ImportError_init; PY6a, by the"] [677 1 "// integration's owner: importlib raises ModuleNotFoundError(msg, name=name)), NameError (name) and AttributeError"] [678 1 "// (name, obj; NameError_init, AttributeError_init)."] [702 1 "// kwException is an exception type whose __init__ takes keyword arguments (importErrorKw's)."] [707 1 "// attributeErrorContext is _PyObject_SetAttributeErrorContext: an AttributeError from getattr(o, name) not yet"] [708 1 "// augmented gets its name and obj."] [725 1 "// nameError is the NameError of an undefined name, its name set (as ceval's format_exc_check_arg)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[142 19] [272 37] [292 31] [294 34] [333 49] [335 39] [341 47] [357 28] [360 57] [363 25] [392 35] [397 45] [408 35] [412 46] [421 51] [458 48] [461 33] [468 53] [489 26] [520 29] [526 31] [540 38] [568 36] [588 25] [592 27] [617 32] [619 35] [626 23] [644 29] [648 32] [658 36] [714 29] [717 28]]} (go/file "exc.go" :imports [

    ^{:go/apos {1 [3 8]} :go/pos {:tok-pos [3 1]}} [strings "strings"]])


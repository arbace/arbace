(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// The built-in exceptions (Objects/exceptions.c): CPython 3.14's hierarchy, BaseExceptionGroup,"] [6 1 "// ExceptionGroup, GeneratorExit and StopAsyncIteration aside (PY5d's: excgroup.go, gen.go, coro.go); their attributes: args, __cause__, __context__,"] [7 1 "// __suppress_context__, __traceback__, __notes__ and add_note, StopIteration's value, the OSError,"] [8 1 "// SyntaxError, ImportError, NameError, AttributeError and Unicode errors' fields (Dict)."] [77 1 "// Exception is an exception object (CPython's PyBaseExceptionObject): its type, arguments and"] [78 1 "// chaining. A class deriving from an exception type makes Exceptions of its type (PY5c); the"] [79 1 "// subclass-specific fields (StopIteration.value, OSError.errno, ...) are in Dict."] [88 2 "// Ext is a subtype's own data (an exception group's message and exceptions: PY5d's excgroup.go)"] [94 1 "// Traceback is a traceback entry (tb_frame, tb_lasti, tb_next): the outermost frame first, Next inward,"] [95 1 "// as CPython links them; the line is the code's :lines at PC."] [106 1 "// NewException is an exception of type t with args, its fields set from them as __init__ sets them."] [113 1 "// initExceptionFields sets the fields BaseException's subclasses derive from their arguments."] [140 34 "// oserror_init: with a filename, args are the first two (PY6d's REQUEST)"] [174 1 "// osErrorSubtype is OSError_new's errno mapping (Linux's errno values): OSError(errno, ...) of the subclass errno"] [175 1 "// names, OSError itself for any other."] [183 21 "// EAGAIN (EWOULDBLOCK), EALREADY, EINPROGRESS"] [185 11 "// ECHILD"] [187 16 "// EPIPE, ESHUTDOWN"] [189 12 "// ECONNABORTED"] [191 12 "// ECONNREFUSED"] [193 12 "// ECONNRESET"] [195 11 "// EEXIST"] [197 10 "// ENOENT"] [199 11 "// EISDIR"] [201 11 "// ENOTDIR"] [203 10 "// EINTR"] [205 14 "// EPERM, EACCES"] [207 10 "// ESRCH"] [209 12 "// ETIMEDOUT"] [215 1 "// isExcField is whether name is one of t's member fields (initExceptionFields', SyntaxError's _metadata,"] [216 1 "// the Unicode errors')."] [237 1 "// Field is one of the exception's fields (StopIteration's value ...), nil when absent."] [245 1 "// exceptionText is str(exc): its single argument's str, or the arguments' tuple; KeyError's single"] [246 1 "// argument's repr; an OSError's \"[Errno N] text\"."] [287 1 "// syntaxErrorText is SyntaxError_str: str(msg), then \" (FILE, line N)\" with the filename's base name and an int"] [288 1 "// lineno, either alone when the other is missing."] [336 1 "// BaseException is the exception value itself (the subclass convention of §7.1)."] [443 4 "// a T_BOOL member: a bool only"] [450 4 "// a plain attribute (CPython keeps it in the instance dict): a list kept as Notes, anything else in the dict"] [475 5 "// the fields are members: deleting one resets it to None (test_object_attributes)"] [489 2 "// BaseException.__setstate__ (BaseException_setstate): each item of a dict state set as an attribute"] [514 2 "// pickling (PY6d's REQUEST; exceptions.c's BaseException___reduce___impl, OSError_reduce, ImportError_reduce):"] [515 2 "// (type, args[, dict]), the dict without the type's member fields; an OSError's filename (and filename2) back"] [516 2 "// in its args; an ImportError's name, path and name_from in its state"] [616 1 "// importErrorKw is the keyword arguments of ImportError (name, path, name_from; ImportError_init; PY6a, by the"] [617 1 "// integration's owner: importlib raises ModuleNotFoundError(msg, name=name)), NameError (name) and AttributeError"] [618 1 "// (name, obj; NameError_init, AttributeError_init)."] [642 1 "// kwException is an exception type whose __init__ takes keyword arguments (importErrorKw's)."] [647 1 "// attributeErrorContext is _PyObject_SetAttributeErrorContext: an AttributeError from getattr(o, name) not yet"] [648 1 "// augmented gets its name and obj."] [665 1 "// nameError is the NameError of an undefined name, its name set (as ceval's format_exc_check_arg)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[140 19] [164 30] [263 31] [300 49] [302 39] [308 47] [324 28] [327 57] [330 25] [359 45] [404 33] [429 26] [460 29] [466 31] [480 38] [508 36] [528 25] [532 27] [557 32] [559 35] [566 23] [584 29] [588 32] [598 36] [654 29] [657 28]]} (go/file "exc.go" :imports [

    ^{:go/apos {1 [3 8]} :go/pos {:tok-pos [3 1]}} [strings "strings"]])


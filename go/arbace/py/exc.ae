(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// The built-in exceptions (Objects/exceptions.c): CPython 3.14's hierarchy, BaseExceptionGroup and"] [6 1 "// ExceptionGroup aside (PY5d's, excgroup.go); their attributes: args, __cause__, __context__,"] [7 1 "// __suppress_context__, __traceback__, __notes__ and add_note, StopIteration's value, the OSError,"] [8 1 "// SyntaxError, ImportError, NameError, AttributeError and Unicode errors' fields (Dict)."] [79 1 "// Exception is an exception object (CPython's PyBaseExceptionObject): its type, arguments and"] [80 1 "// chaining. A class deriving from an exception type makes Exceptions of its type (PY5c); the"] [81 1 "// subclass-specific fields (StopIteration.value, OSError.errno, ...) are in Dict."] [94 1 "// Traceback is a traceback entry (tb_frame, tb_lasti, tb_next): the outermost frame first, Next inward,"] [95 1 "// as CPython links them; the line is the code's :lines at PC."] [106 1 "// NewException is an exception of type t with args, its fields set from them as __init__ sets them."] [113 1 "// initExceptionFields sets the fields BaseException's subclasses derive from their arguments."] [178 1 "// Field is one of the exception's fields (StopIteration's value ...), nil when absent."] [186 1 "// exceptionText is str(exc): its single argument's str, or the arguments' tuple; KeyError's single"] [187 1 "// argument's repr; an OSError's \"[Errno N] text\"."] [235 1 "// BaseException is the exception value itself (the subclass convention of §7.1)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[161 30] [201 31] [226 28] [229 57] [291 33] [308 26] [325 31] [334 38] [348 29] [359 36]]} (go/file "exc.go" :imports [

    ^{:go/apos {1 [3 8]} :go/pos {:tok-pos [3 1]}} [strings "strings"]])

;; The built-in exceptions (Objects/exceptions.c): CPython 3.14's hierarchy, BaseExceptionGroup and
;; ExceptionGroup aside (PY5d's, excgroup.go); their attributes: args, __cause__, __context__,
;; __suppress_context__, __traceback__, __notes__ and add_note, StopIteration's value, the OSError,
;; SyntaxError, ImportError, NameError, AttributeError and Unicode errors' fields (Dict).


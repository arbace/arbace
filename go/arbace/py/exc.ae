(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// The built-in exceptions (Objects/exceptions.c): CPython 3.14's hierarchy, BaseExceptionGroup,"] [6 1 "// ExceptionGroup, GeneratorExit and StopAsyncIteration aside (PY5d's: excgroup.go, gen.go, coro.go); their attributes: args, __cause__, __context__,"] [7 1 "// __suppress_context__, __traceback__, __notes__ and add_note, StopIteration's value, the OSError,"] [8 1 "// SyntaxError, ImportError, NameError, AttributeError and Unicode errors' fields (Dict)."] [77 1 "// Exception is an exception object (CPython's PyBaseExceptionObject): its type, arguments and"] [78 1 "// chaining. A class deriving from an exception type makes Exceptions of its type (PY5c); the"] [79 1 "// subclass-specific fields (StopIteration.value, OSError.errno, ...) are in Dict."] [88 2 "// Ext is a subtype's own data (an exception group's message and exceptions: PY5d's excgroup.go)"] [94 1 "// Traceback is a traceback entry (tb_frame, tb_lasti, tb_next): the outermost frame first, Next inward,"] [95 1 "// as CPython links them; the line is the code's :lines at PC."] [106 1 "// NewException is an exception of type t with args, its fields set from them as __init__ sets them."] [113 1 "// initExceptionFields sets the fields BaseException's subclasses derive from their arguments."] [171 1 "// osErrorSubtype is OSError_new's errno mapping (Linux's errno values): OSError(errno, ...) of the subclass errno"] [172 1 "// names, OSError itself for any other."] [180 21 "// EAGAIN (EWOULDBLOCK), EALREADY, EINPROGRESS"] [182 11 "// ECHILD"] [184 16 "// EPIPE, ESHUTDOWN"] [186 12 "// ECONNABORTED"] [188 12 "// ECONNREFUSED"] [190 12 "// ECONNRESET"] [192 11 "// EEXIST"] [194 10 "// ENOENT"] [196 11 "// EISDIR"] [198 11 "// ENOTDIR"] [200 10 "// EINTR"] [202 14 "// EPERM, EACCES"] [204 10 "// ESRCH"] [206 12 "// ETIMEDOUT"] [212 1 "// isExcField is whether name is one of t's member fields (initExceptionFields', SyntaxError's _metadata,"] [213 1 "// the Unicode errors')."] [234 1 "// Field is one of the exception's fields (StopIteration's value ...), nil when absent."] [242 1 "// exceptionText is str(exc): its single argument's str, or the arguments' tuple; KeyError's single"] [243 1 "// argument's repr; an OSError's \"[Errno N] text\"."] [284 1 "// syntaxErrorText is SyntaxError_str: str(msg), then \" (FILE, line N)\" with the filename's base name and an int"] [285 1 "// lineno, either alone when the other is missing."] [333 1 "// BaseException is the exception value itself (the subclass convention of §7.1)."] [440 4 "// a T_BOOL member: a bool only"] [447 4 "// a plain attribute (CPython keeps it in the instance dict): a list kept as Notes, anything else in the dict"] [472 5 "// the fields are members: deleting one resets it to None (test_object_attributes)"] [486 2 "// BaseException.__setstate__ (BaseException_setstate): each item of a dict state set as an attribute"] [548 1 "// importErrorKw is the keyword arguments of ImportError (name, path, name_from; ImportError_init; PY6a, by the"] [549 1 "// integration's owner: importlib raises ModuleNotFoundError(msg, name=name)), NameError (name) and AttributeError"] [550 1 "// (name, obj; NameError_init, AttributeError_init)."] [574 1 "// kwException is an exception type whose __init__ takes keyword arguments (importErrorKw's)."] [579 1 "// attributeErrorContext is _PyObject_SetAttributeErrorContext: an AttributeError from getattr(o, name) not yet"] [580 1 "// augmented gets its name and obj."] [597 1 "// nameError is the NameError of an undefined name, its name set (as ceval's format_exc_check_arg)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[161 30] [260 31] [297 49] [299 39] [305 47] [321 28] [324 57] [327 25] [356 45] [401 33] [426 26] [457 29] [463 31] [477 38] [505 36] [516 29] [520 32] [530 36] [586 29] [589 28]]} (go/file "exc.go" :imports [

    ^{:go/apos {1 [3 8]} :go/pos {:tok-pos [3 1]}} [strings "strings"]])


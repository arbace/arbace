(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// The built-in exceptions (Objects/exceptions.c): CPython 3.14's hierarchy, BaseExceptionGroup,"] [6 1 "// ExceptionGroup, GeneratorExit and StopAsyncIteration aside (PY5d's: excgroup.go, gen.go, coro.go); their attributes: args, __cause__, __context__,"] [7 1 "// __suppress_context__, __traceback__, __notes__ and add_note, StopIteration's value, the OSError,"] [8 1 "// SyntaxError, ImportError, NameError, AttributeError and Unicode errors' fields (Dict)."] [54 2 "// _IncompleteInputError (3.13): compile()'s incomplete input under PyCF_ALLOW_INCOMPLETE_INPUT, codeop's (PY7)"] [79 1 "// Exception is an exception object (CPython's PyBaseExceptionObject): its type, arguments and"] [80 1 "// chaining. A class deriving from an exception type makes Exceptions of its type (PY5c); the"] [81 1 "// subclass-specific fields (StopIteration.value, OSError.errno, ...) are in Dict."] [90 2 "// Ext is a subtype's own data (an exception group's message and exceptions: PY5d's excgroup.go)"] [96 1 "// Traceback is a traceback entry (tb_frame, tb_lasti, tb_next): the outermost frame first, Next inward,"] [97 1 "// as CPython links them; the line is the code's :lines at PC."] [102 2 "// made is a traceback made by types.TracebackType(tb_next, tb_frame, tb_lasti, tb_lineno) (tb_new, queue 223):"] [103 2 "// its tb_lasti and tb_lineno (-1: the frame's line at tb_lasti) as given; else tb_lasti is 2 × PC and tb_lineno -1"] [108 1 "// Lasti is tb_lasti (bytes: 2 × the instruction)."] [116 1 "// Lineno is tb_lineno (tb_lineno_get): the given line, else the code's line at tb_lasti; 0 for none."] [134 1 "// NewException is an exception of type t with args, its fields set from them as __init__ sets them."] [141 1 "// initExceptionFields sets the fields BaseException's subclasses derive from their arguments."] [167 4 "// oserror_parse_args: an exact BlockingIOError's third argument, a number, is the characters written"] [168 4 "// (its characters_written; the args kept whole), no filename (py-mods-1122: test_io's nonblocking writes)"] [177 20 "// oserror_init: with a filename, args are the first two (PY6d's REQUEST)"] [205 1 "// syntaxErrorDetails is SyntaxError_init's second argument: with exactly two arguments, tuple(args[1]) gives"] [206 1 "// filename, lineno, offset, text and optionally end_lineno, end_offset, _metadata (\"OOOO|OOO\"), and an end_lineno"] [207 1 "// needs its end_offset."] [232 1 "// osErrorSubtype is OSError_new's errno mapping (Linux's errno values): OSError(errno, ...) of the subclass errno"] [233 1 "// names, OSError itself for any other."] [241 21 "// EAGAIN (EWOULDBLOCK), EALREADY, EINPROGRESS"] [243 11 "// ECHILD"] [245 16 "// EPIPE, ESHUTDOWN"] [247 12 "// ECONNABORTED"] [249 12 "// ECONNREFUSED"] [251 12 "// ECONNRESET"] [253 11 "// EEXIST"] [255 10 "// ENOENT"] [257 11 "// EISDIR"] [259 11 "// ENOTDIR"] [261 10 "// EINTR"] [263 14 "// EPERM, EACCES"] [265 10 "// ESRCH"] [267 12 "// ETIMEDOUT"] [273 1 "// isExcField is whether name is one of t's member fields (initExceptionFields', SyntaxError's _metadata,"] [274 1 "// the Unicode errors')."] [295 1 "// Field is one of the exception's fields (StopIteration's value ...), nil when absent."] [303 1 "// exceptionText is str(exc): its single argument's str, or the arguments' tuple; KeyError's single"] [304 1 "// argument's repr; an OSError's \"[Errno N] text\"."] [307 44 "// PY6c, codecs_errors.go"] [355 1 "// syntaxErrorText is SyntaxError_str: str(msg), then \" (FILE, line N)\" with the filename's base name and an int"] [356 1 "// lineno, either alone when the other is missing."] [404 1 "// BaseException is the exception value itself (the subclass convention of §7.1)."] [447 61 "// PY6c, codecs_errors.go"] [456 58 "// PY6c, codecs_errors.go"] [496 55 "// PY6c, codecs_errors.go"] [506 60 "// PY6c, codecs_errors.go"] [541 4 "// a T_BOOL member: a bool only"] [548 4 "// a plain attribute (CPython keeps it in the instance dict): a list kept as Notes, anything else in the dict"] [564 4 "// BaseException's __dict__ getset (queue 290: test_descr's test_set_dict replaced an exact Exception's,"] [565 4 "// which this switch's default stored as an attribute named __dict__)"] [577 5 "// the fields are members: deleting one resets it to None (test_object_attributes)"] [591 2 "// BaseException.__setstate__ (BaseException_setstate): each item of a dict state set as an attribute"] [616 2 "// pickling (PY6d's REQUEST; exceptions.c's BaseException___reduce___impl, OSError_reduce, ImportError_reduce):"] [617 2 "// (type, args[, dict]), the dict without the type's member fields; an OSError's filename (and filename2) back"] [618 2 "// in its args; an ImportError's name, path and name_from in its state"] [667 4 "// AttributeError_getstate (queue 223): the state a copy of the dict with name, when set, and args (obj"] [668 4 "// not: it is seldom picklable, GH-103352)"] [728 1 "// importErrorKw is the keyword arguments of ImportError (name, path, name_from; ImportError_init; PY6a, by the"] [729 1 "// integration's owner: importlib raises ModuleNotFoundError(msg, name=name)), NameError (name) and AttributeError"] [730 1 "// (name, obj; NameError_init, AttributeError_init)."] [765 1 "// importErrorKws records ImportError's name and path given as keywords (CPython's fields non-NULL: None given is shown)"] [768 1 "// importErrorRepr is 3.15's ImportError_repr (Objects/exceptions.c; queue 237): BaseException's repr, then name=%R and"] [769 1 "// path=%R when set (given as keywords, or not None)."] [798 1 "// kwException is an exception type whose __init__ takes keyword arguments (importErrorKw's)."] [803 1 "// attributeErrorContext is _PyObject_SetAttributeErrorContext: an AttributeError from getattr(o, name) not yet"] [804 1 "// augmented gets its name and obj."] [821 1 "// nameError is the NameError of an undefined name, its name set (as ceval's format_exc_check_arg)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[121 20] [170 30] [307 37] [327 31] [329 34] [368 49] [370 39] [376 47] [392 28] [395 57] [398 25] [427 35] [432 45] [443 35] [447 46] [456 51] [496 48] [499 33] [506 53] [527 26] [558 29] [568 31] [582 38] [610 36] [630 25] [634 27] [659 32] [661 35] [672 27] [678 23] [696 29] [700 32] [710 36] [750 21] [810 29] [813 28]]} (go/file "exc.go" :imports [


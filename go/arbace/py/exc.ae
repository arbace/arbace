(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// The built-in exceptions (Objects/exceptions.c): CPython 3.14's hierarchy, BaseExceptionGroup,"] [6 1 "// ExceptionGroup, GeneratorExit and StopAsyncIteration aside (PY5d's: excgroup.go, gen.go, coro.go); their attributes: args, __cause__, __context__,"] [7 1 "// __suppress_context__, __traceback__, __notes__ and add_note, StopIteration's value, the OSError,"] [8 1 "// SyntaxError, ImportError, NameError, AttributeError and Unicode errors' fields (Dict)."] [54 2 "// _IncompleteInputError (3.13): compile()'s incomplete input under PyCF_ALLOW_INCOMPLETE_INPUT, codeop's (PY7)"] [79 1 "// Exception is an exception object (CPython's PyBaseExceptionObject): its type, arguments and"] [80 1 "// chaining. A class deriving from an exception type makes Exceptions of its type (PY5c); the"] [81 1 "// subclass-specific fields (StopIteration.value, OSError.errno, ...) are in Dict."] [90 2 "// Ext is a subtype's own data (an exception group's message and exceptions: PY5d's excgroup.go)"] [96 1 "// Traceback is a traceback entry (tb_frame, tb_lasti, tb_next): the outermost frame first, Next inward,"] [97 1 "// as CPython links them; the line is the code's :lines at PC."] [102 2 "// made is a traceback made by types.TracebackType(tb_next, tb_frame, tb_lasti, tb_lineno) (tb_new, queue 223):"] [103 2 "// its tb_lasti and tb_lineno (-1: the frame's line at tb_lasti) as given; else tb_lasti is 2 × PC and tb_lineno -1"] [108 1 "// Lasti is tb_lasti (bytes: 2 × the instruction)."] [116 1 "// Lineno is tb_lineno (tb_lineno_get): the given line, else the code's line at tb_lasti; 0 for none."] [131 1 "// NewException is an exception of type t with args, its fields set from them as __init__ sets them."] [138 1 "// initExceptionFields sets the fields BaseException's subclasses derive from their arguments."] [165 34 "// oserror_init: with a filename, args are the first two (PY6d's REQUEST)"] [193 1 "// syntaxErrorDetails is SyntaxError_init's second argument: with exactly two arguments, tuple(args[1]) gives"] [194 1 "// filename, lineno, offset, text and optionally end_lineno, end_offset, _metadata (\"OOOO|OOO\"), and an end_lineno"] [195 1 "// needs its end_offset."] [220 1 "// osErrorSubtype is OSError_new's errno mapping (Linux's errno values): OSError(errno, ...) of the subclass errno"] [221 1 "// names, OSError itself for any other."] [229 21 "// EAGAIN (EWOULDBLOCK), EALREADY, EINPROGRESS"] [231 11 "// ECHILD"] [233 16 "// EPIPE, ESHUTDOWN"] [235 12 "// ECONNABORTED"] [237 12 "// ECONNREFUSED"] [239 12 "// ECONNRESET"] [241 11 "// EEXIST"] [243 10 "// ENOENT"] [245 11 "// EISDIR"] [247 11 "// ENOTDIR"] [249 10 "// EINTR"] [251 14 "// EPERM, EACCES"] [253 10 "// ESRCH"] [255 12 "// ETIMEDOUT"] [261 1 "// isExcField is whether name is one of t's member fields (initExceptionFields', SyntaxError's _metadata,"] [262 1 "// the Unicode errors')."] [283 1 "// Field is one of the exception's fields (StopIteration's value ...), nil when absent."] [291 1 "// exceptionText is str(exc): its single argument's str, or the arguments' tuple; KeyError's single"] [292 1 "// argument's repr; an OSError's \"[Errno N] text\"."] [295 44 "// PY6c, codecs_errors.go"] [343 1 "// syntaxErrorText is SyntaxError_str: str(msg), then \" (FILE, line N)\" with the filename's base name and an int"] [344 1 "// lineno, either alone when the other is missing."] [392 1 "// BaseException is the exception value itself (the subclass convention of §7.1)."] [435 61 "// PY6c, codecs_errors.go"] [444 58 "// PY6c, codecs_errors.go"] [481 55 "// PY6c, codecs_errors.go"] [491 60 "// PY6c, codecs_errors.go"] [526 4 "// a T_BOOL member: a bool only"] [533 4 "// a plain attribute (CPython keeps it in the instance dict): a list kept as Notes, anything else in the dict"] [558 5 "// the fields are members: deleting one resets it to None (test_object_attributes)"] [572 2 "// BaseException.__setstate__ (BaseException_setstate): each item of a dict state set as an attribute"] [597 2 "// pickling (PY6d's REQUEST; exceptions.c's BaseException___reduce___impl, OSError_reduce, ImportError_reduce):"] [598 2 "// (type, args[, dict]), the dict without the type's member fields; an OSError's filename (and filename2) back"] [599 2 "// in its args; an ImportError's name, path and name_from in its state"] [648 4 "// AttributeError_getstate (queue 223): the state a copy of the dict with name, when set, and args (obj"] [649 4 "// not: it is seldom picklable, GH-103352)"] [709 1 "// importErrorKw is the keyword arguments of ImportError (name, path, name_from; ImportError_init; PY6a, by the"] [710 1 "// integration's owner: importlib raises ModuleNotFoundError(msg, name=name)), NameError (name) and AttributeError"] [711 1 "// (name, obj; NameError_init, AttributeError_init)."] [735 1 "// kwException is an exception type whose __init__ takes keyword arguments (importErrorKw's)."] [740 1 "// attributeErrorContext is _PyObject_SetAttributeErrorContext: an AttributeError from getattr(o, name) not yet"] [741 1 "// augmented gets its name and obj."] [758 1 "// nameError is the NameError of an undefined name, its name set (as ceval's format_exc_check_arg)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[121 20] [165 19] [295 37] [315 31] [317 34] [356 49] [358 39] [364 47] [380 28] [383 57] [386 25] [415 35] [420 45] [431 35] [435 46] [444 51] [481 48] [484 33] [491 53] [512 26] [543 29] [549 31] [563 38] [591 36] [611 25] [615 27] [640 32] [642 35] [653 27] [659 23] [677 29] [681 32] [691 36] [747 29] [750 28]]} (go/file "exc.go" :imports [

    ^{:go/apos {1 [3 8]} :go/pos {:tok-pos [3 1]}} [strings "strings"]])


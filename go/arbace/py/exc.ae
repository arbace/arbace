(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// The built-in exceptions (Objects/exceptions.c): CPython 3.14's hierarchy, BaseExceptionGroup,"] [6 1 "// ExceptionGroup, GeneratorExit and StopAsyncIteration aside (PY5d's: excgroup.go, gen.go, coro.go); their attributes: args, __cause__, __context__,"] [7 1 "// __suppress_context__, __traceback__, __notes__ and add_note, StopIteration's value, the OSError,"] [8 1 "// SyntaxError, ImportError, NameError, AttributeError and Unicode errors' fields (Dict)."] [77 1 "// Exception is an exception object (CPython's PyBaseExceptionObject): its type, arguments and"] [78 1 "// chaining. A class deriving from an exception type makes Exceptions of its type (PY5c); the"] [79 1 "// subclass-specific fields (StopIteration.value, OSError.errno, ...) are in Dict."] [88 2 "// Ext is a subtype's own data (an exception group's message and exceptions: PY5d's excgroup.go)"] [94 1 "// Traceback is a traceback entry (tb_frame, tb_lasti, tb_next): the outermost frame first, Next inward,"] [95 1 "// as CPython links them; the line is the code's :lines at PC."] [106 1 "// NewException is an exception of type t with args, its fields set from them as __init__ sets them."] [113 1 "// initExceptionFields sets the fields BaseException's subclasses derive from their arguments."] [140 34 "// oserror_init: with a filename, args are the first two (PY6d's REQUEST)"] [168 1 "// syntaxErrorDetails is SyntaxError_init's second argument: with exactly two arguments, tuple(args[1]) gives"] [169 1 "// filename, lineno, offset, text and optionally end_lineno, end_offset, _metadata (\"OOOO|OOO\"), and an end_lineno"] [170 1 "// needs its end_offset."] [195 1 "// osErrorSubtype is OSError_new's errno mapping (Linux's errno values): OSError(errno, ...) of the subclass errno"] [196 1 "// names, OSError itself for any other."] [204 21 "// EAGAIN (EWOULDBLOCK), EALREADY, EINPROGRESS"] [206 11 "// ECHILD"] [208 16 "// EPIPE, ESHUTDOWN"] [210 12 "// ECONNABORTED"] [212 12 "// ECONNREFUSED"] [214 12 "// ECONNRESET"] [216 11 "// EEXIST"] [218 10 "// ENOENT"] [220 11 "// EISDIR"] [222 11 "// ENOTDIR"] [224 10 "// EINTR"] [226 14 "// EPERM, EACCES"] [228 10 "// ESRCH"] [230 12 "// ETIMEDOUT"] [236 1 "// isExcField is whether name is one of t's member fields (initExceptionFields', SyntaxError's _metadata,"] [237 1 "// the Unicode errors')."] [258 1 "// Field is one of the exception's fields (StopIteration's value ...), nil when absent."] [266 1 "// exceptionText is str(exc): its single argument's str, or the arguments' tuple; KeyError's single"] [267 1 "// argument's repr; an OSError's \"[Errno N] text\"."] [270 44 "// PY6c, codecs_errors.go"] [318 1 "// syntaxErrorText is SyntaxError_str: str(msg), then \" (FILE, line N)\" with the filename's base name and an int"] [319 1 "// lineno, either alone when the other is missing."] [367 1 "// BaseException is the exception value itself (the subclass convention of §7.1)."] [410 61 "// PY6c, codecs_errors.go"] [419 58 "// PY6c, codecs_errors.go"] [456 55 "// PY6c, codecs_errors.go"] [466 60 "// PY6c, codecs_errors.go"] [501 4 "// a T_BOOL member: a bool only"] [508 4 "// a plain attribute (CPython keeps it in the instance dict): a list kept as Notes, anything else in the dict"] [533 5 "// the fields are members: deleting one resets it to None (test_object_attributes)"] [547 2 "// BaseException.__setstate__ (BaseException_setstate): each item of a dict state set as an attribute"] [572 2 "// pickling (PY6d's REQUEST; exceptions.c's BaseException___reduce___impl, OSError_reduce, ImportError_reduce):"] [573 2 "// (type, args[, dict]), the dict without the type's member fields; an OSError's filename (and filename2) back"] [574 2 "// in its args; an ImportError's name, path and name_from in its state"] [674 1 "// importErrorKw is the keyword arguments of ImportError (name, path, name_from; ImportError_init; PY6a, by the"] [675 1 "// integration's owner: importlib raises ModuleNotFoundError(msg, name=name)), NameError (name) and AttributeError"] [676 1 "// (name, obj; NameError_init, AttributeError_init)."] [700 1 "// kwException is an exception type whose __init__ takes keyword arguments (importErrorKw's)."] [705 1 "// attributeErrorContext is _PyObject_SetAttributeErrorContext: an AttributeError from getattr(o, name) not yet"] [706 1 "// augmented gets its name and obj."] [723 1 "// nameError is the NameError of an undefined name, its name set (as ceval's format_exc_check_arg)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[140 19] [270 37] [290 31] [292 34] [331 49] [333 39] [339 47] [355 28] [358 57] [361 25] [390 35] [395 45] [406 35] [410 46] [419 51] [456 48] [459 33] [466 53] [487 26] [518 29] [524 31] [538 38] [566 36] [586 25] [590 27] [615 32] [617 35] [624 23] [642 29] [646 32] [656 36] [712 29] [715 28]]} (go/file "exc.go" :imports [

    ^{:go/apos {1 [3 8]} :go/pos {:tok-pos [3 1]}} [strings "strings"]])


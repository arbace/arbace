(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// The built-in exceptions (Objects/exceptions.c): CPython 3.14's hierarchy, BaseExceptionGroup,"] [6 1 "// ExceptionGroup, GeneratorExit and StopAsyncIteration aside (PY5d's: excgroup.go, gen.go, coro.go); their attributes: args, __cause__, __context__,"] [7 1 "// __suppress_context__, __traceback__, __notes__ and add_note, StopIteration's value, the OSError,"] [8 1 "// SyntaxError, ImportError, NameError, AttributeError and Unicode errors' fields (Dict)."] [77 1 "// Exception is an exception object (CPython's PyBaseExceptionObject): its type, arguments and"] [78 1 "// chaining. A class deriving from an exception type makes Exceptions of its type (PY5c); the"] [79 1 "// subclass-specific fields (StopIteration.value, OSError.errno, ...) are in Dict."] [88 2 "// Ext is a subtype's own data (an exception group's message and exceptions: PY5d's excgroup.go)"] [94 1 "// Traceback is a traceback entry (tb_frame, tb_lasti, tb_next): the outermost frame first, Next inward,"] [95 1 "// as CPython links them; the line is the code's :lines at PC."] [106 1 "// NewException is an exception of type t with args, its fields set from them as __init__ sets them."] [113 1 "// initExceptionFields sets the fields BaseException's subclasses derive from their arguments."] [178 1 "// Field is one of the exception's fields (StopIteration's value ...), nil when absent."] [186 1 "// exceptionText is str(exc): its single argument's str, or the arguments' tuple; KeyError's single"] [187 1 "// argument's repr; an OSError's \"[Errno N] text\"."] [228 1 "// syntaxErrorText is SyntaxError_str: str(msg), then \" (FILE, line N)\" with the filename's base name and an int"] [229 1 "// lineno, either alone when the other is missing."] [277 1 "// BaseException is the exception value itself (the subclass convention of §7.1)."] [381 4 "// a T_BOOL member: a bool only"] [440 1 "// importErrorKw is the keyword arguments of ImportError (name, path, name_from; ImportError_init; PY6a, by the"] [441 1 "// integration's owner: importlib raises ModuleNotFoundError(msg, name=name)), NameError (name) and AttributeError"] [442 1 "// (name, obj; NameError_init, AttributeError_init)."] [466 1 "// kwException is an exception type whose __init__ takes keyword arguments (importErrorKw's)."] [471 1 "// attributeErrorContext is _PyObject_SetAttributeErrorContext: an AttributeError from getattr(o, name) not yet"] [472 1 "// augmented gets its name and obj."] [489 1 "// nameError is the NameError of an undefined name, its name set (as ceval's format_exc_check_arg)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[161 30] [204 31] [241 49] [243 39] [249 47] [265 28] [268 57] [271 25] [297 45] [342 33] [367 26] [388 31] [397 38] [411 29] [422 36] [478 29] [481 28]]} (go/file "exc.go" :imports [

    ^{:go/apos {1 [3 8]} :go/pos {:tok-pos [3 1]}} [strings "strings"]])

;; The built-in exceptions (Objects/exceptions.c): CPython 3.14's hierarchy, BaseExceptionGroup,
;; ExceptionGroup, GeneratorExit and StopAsyncIteration aside (PY5d's: excgroup.go, gen.go, coro.go); their attributes: args, __cause__, __context__,
;; __suppress_context__, __traceback__, __notes__ and add_note, StopIteration's value, the OSError,
;; SyntaxError, ImportError, NameError, AttributeError and Unicode errors' fields (Dict).


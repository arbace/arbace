(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// The built-in exceptions (Objects/exceptions.c): CPython 3.14's hierarchy, BaseExceptionGroup,"] [6 1 "// ExceptionGroup, GeneratorExit and StopAsyncIteration aside (PY5d's: excgroup.go, gen.go, coro.go); their attributes: args, __cause__, __context__,"] [7 1 "// __suppress_context__, __traceback__, __notes__ and add_note, StopIteration's value, the OSError,"] [8 1 "// SyntaxError, ImportError, NameError, AttributeError and Unicode errors' fields (Dict)."] [77 1 "// Exception is an exception object (CPython's PyBaseExceptionObject): its type, arguments and"] [78 1 "// chaining. A class deriving from an exception type makes Exceptions of its type (PY5c); the"] [79 1 "// subclass-specific fields (StopIteration.value, OSError.errno, ...) are in Dict."] [88 2 "// Ext is a subtype's own data (an exception group's message and exceptions: PY5d's excgroup.go)"] [94 1 "// Traceback is a traceback entry (tb_frame, tb_lasti, tb_next): the outermost frame first, Next inward,"] [95 1 "// as CPython links them; the line is the code's :lines at PC."] [106 1 "// NewException is an exception of type t with args, its fields set from them as __init__ sets them."] [113 1 "// initExceptionFields sets the fields BaseException's subclasses derive from their arguments."] [165 1 "// syntaxErrorDetails is SyntaxError_init's second argument: with exactly two arguments, tuple(args[1]) gives"] [166 1 "// filename, lineno, offset, text and optionally end_lineno, end_offset, _metadata (\"OOOO|OOO\"), and an end_lineno"] [167 1 "// needs its end_offset."] [192 1 "// osErrorSubtype is OSError_new's errno mapping (Linux's errno values): OSError(errno, ...) of the subclass errno"] [193 1 "// names, OSError itself for any other."] [201 21 "// EAGAIN (EWOULDBLOCK), EALREADY, EINPROGRESS"] [203 11 "// ECHILD"] [205 16 "// EPIPE, ESHUTDOWN"] [207 12 "// ECONNABORTED"] [209 12 "// ECONNREFUSED"] [211 12 "// ECONNRESET"] [213 11 "// EEXIST"] [215 10 "// ENOENT"] [217 11 "// EISDIR"] [219 11 "// ENOTDIR"] [221 10 "// EINTR"] [223 14 "// EPERM, EACCES"] [225 10 "// ESRCH"] [227 12 "// ETIMEDOUT"] [233 1 "// isExcField is whether name is one of t's member fields (initExceptionFields', SyntaxError's _metadata,"] [234 1 "// the Unicode errors')."] [255 1 "// Field is one of the exception's fields (StopIteration's value ...), nil when absent."] [263 1 "// exceptionText is str(exc): its single argument's str, or the arguments' tuple; KeyError's single"] [264 1 "// argument's repr; an OSError's \"[Errno N] text\"."] [305 1 "// syntaxErrorText is SyntaxError_str: str(msg), then \" (FILE, line N)\" with the filename's base name and an int"] [306 1 "// lineno, either alone when the other is missing."] [354 1 "// BaseException is the exception value itself (the subclass convention of §7.1)."] [471 4 "// a T_BOOL member: a bool only"] [478 4 "// a plain attribute (CPython keeps it in the instance dict): a list kept as Notes, anything else in the dict"] [503 5 "// the fields are members: deleting one resets it to None (test_object_attributes)"] [517 2 "// BaseException.__setstate__ (BaseException_setstate): each item of a dict state set as an attribute"] [579 1 "// importErrorKw is the keyword arguments of ImportError (name, path, name_from; ImportError_init; PY6a, by the"] [580 1 "// integration's owner: importlib raises ModuleNotFoundError(msg, name=name)), NameError (name) and AttributeError"] [581 1 "// (name, obj; NameError_init, AttributeError_init)."] [605 1 "// kwException is an exception type whose __init__ takes keyword arguments (importErrorKw's)."] [610 1 "// attributeErrorContext is _PyObject_SetAttributeErrorContext: an AttributeError from getattr(o, name) not yet"] [611 1 "// augmented gets its name and obj."] [628 1 "// nameError is the NameError of an undefined name, its name set (as ceval's format_exc_check_arg)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[281 31] [318 49] [320 39] [326 47] [342 28] [345 57] [348 25] [377 35] [382 45] [393 35] [432 33] [457 26] [488 29] [494 31] [508 38] [536 36] [547 29] [551 32] [561 36] [617 29] [620 28]]} (go/file "exc.go" :imports [

    ^{:go/apos {1 [3 8]} :go/pos {:tok-pos [3 1]}} [strings "strings"]])


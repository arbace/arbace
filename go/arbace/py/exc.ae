(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// The built-in exceptions (Objects/exceptions.c): CPython 3.14's hierarchy, BaseExceptionGroup,"] [6 1 "// ExceptionGroup, GeneratorExit and StopAsyncIteration aside (PY5d's: excgroup.go, gen.go, coro.go); their attributes: args, __cause__, __context__,"] [7 1 "// __suppress_context__, __traceback__, __notes__ and add_note, StopIteration's value, the OSError,"] [8 1 "// SyntaxError, ImportError, NameError, AttributeError and Unicode errors' fields (Dict)."] [54 2 "// _IncompleteInputError (3.13): compile()'s incomplete input under PyCF_ALLOW_INCOMPLETE_INPUT, codeop's (PY7)"] [79 1 "// Exception is an exception object (CPython's PyBaseExceptionObject): its type, arguments and"] [80 1 "// chaining. A class deriving from an exception type makes Exceptions of its type (PY5c); the"] [81 1 "// subclass-specific fields (StopIteration.value, OSError.errno, ...) are in Dict."] [90 2 "// Ext is a subtype's own data (an exception group's message and exceptions: PY5d's excgroup.go)"] [96 1 "// Traceback is a traceback entry (tb_frame, tb_lasti, tb_next): the outermost frame first, Next inward,"] [97 1 "// as CPython links them; the line is the code's :lines at PC."] [102 2 "// made is a traceback made by types.TracebackType(tb_next, tb_frame, tb_lasti, tb_lineno) (tb_new, queue 223):"] [103 2 "// its tb_lasti and tb_lineno (-1: the frame's line at tb_lasti) as given; else tb_lasti is 2 × PC and tb_lineno -1"] [108 1 "// Lasti is tb_lasti (bytes: 2 × the instruction)."] [116 1 "// Lineno is tb_lineno (tb_lineno_get): the given line, else the code's line at tb_lasti; 0 for none."] [134 1 "// NewException is an exception of type t with args, its fields set from them as __init__ sets them."] [142 1 "// trackExcDel tracks e when its class defines __del__, as an instance of a class is (class.go's trackDel; queue 218):"] [143 1 "// an exception subclass's instance is an *Exception, made here, not by object's __new__, so its __del__ never ran"] [144 1 "// (py-small-1127: test_unittest's test_no_exception_leak, MyException's count of live instances)"] [154 1 "// initExceptionFields sets the fields BaseException's subclasses derive from their arguments."] [180 4 "// oserror_parse_args: an exact BlockingIOError's third argument, a number, is the characters written"] [181 4 "// (its characters_written; the args kept whole), no filename (py-mods-1122: test_io's nonblocking writes)"] [190 20 "// oserror_init: with a filename, args are the first two (PY6d's REQUEST)"] [218 1 "// syntaxErrorDetails is SyntaxError_init's second argument: with exactly two arguments, tuple(args[1]) gives"] [219 1 "// filename, lineno, offset, text and optionally end_lineno, end_offset, _metadata (\"OOOO|OOO\"), and an end_lineno"] [220 1 "// needs its end_offset."] [245 1 "// osErrorSubtype is OSError_new's errno mapping (Linux's errno values): OSError(errno, ...) of the subclass errno"] [246 1 "// names, OSError itself for any other."] [254 21 "// EAGAIN (EWOULDBLOCK), EALREADY, EINPROGRESS"] [256 11 "// ECHILD"] [258 16 "// EPIPE, ESHUTDOWN"] [260 12 "// ECONNABORTED"] [262 12 "// ECONNREFUSED"] [264 12 "// ECONNRESET"] [266 11 "// EEXIST"] [268 10 "// ENOENT"] [270 11 "// EISDIR"] [272 11 "// ENOTDIR"] [274 10 "// EINTR"] [276 14 "// EPERM, EACCES"] [278 10 "// ESRCH"] [280 12 "// ETIMEDOUT"] [286 1 "// isExcField is whether name is one of t's member fields (initExceptionFields', SyntaxError's _metadata,"] [287 1 "// the Unicode errors')."] [308 1 "// Field is one of the exception's fields (StopIteration's value ...), nil when absent."] [316 1 "// exceptionText is str(exc): its single argument's str, or the arguments' tuple; KeyError's single"] [317 1 "// argument's repr; an OSError's \"[Errno N] text\"."] [320 44 "// PY6c, codecs_errors.go"] [368 1 "// syntaxErrorText is SyntaxError_str: str(msg), then \" (FILE, line N)\" with the filename's base name and an int"] [369 1 "// lineno, either alone when the other is missing."] [417 1 "// BaseException is the exception value itself (the subclass convention of §7.1)."] [454 3 "// OSError_init: nothing unless oserror_use_init (its own __init__ and OSError's __new__), the arguments __new__'s"] [455 3 "// (py-core-1124: test_exception_hierarchy's test_new_overridden)"] [470 61 "// PY6c, codecs_errors.go"] [479 58 "// PY6c, codecs_errors.go"] [519 55 "// PY6c, codecs_errors.go"] [523 4 "// a field is a member of the built-in class (OSError's errno ...): a subclass's own class attribute of that name"] [524 4 "// is found first by the type's lookup (py-core-1124: test_asyncio's SelectorEventLoopSignalTests, a subclass's"] [525 4 "// errno)"] [526 4 "// (only a built-in field left None: fields and an instance's own attributes share the dict, so a value set on the"] [527 4 "// instance is the instance's)"] [539 60 "// PY6c, codecs_errors.go"] [574 4 "// a T_BOOL member: a bool only"] [581 4 "// a plain attribute (CPython keeps it in the instance dict): a list kept as Notes, anything else in the dict"] [597 4 "// BaseException's __dict__ getset (queue 290: test_descr's test_set_dict replaced an exact Exception's,"] [598 4 "// which this switch's default stored as an attribute named __dict__)"] [610 5 "// the fields are members: deleting one resets it to None (test_object_attributes)"] [624 2 "// BaseException.__setstate__ (BaseException_setstate): each item of a dict state set as an attribute"] [636 3 "// the items as PyDict_Next holds them (a key's __hash__ may clear the dict), a str subclass's key taken as its"] [637 3 "// str (PyObject_SetAttr; py-core-1124: test_baseexception's test_setstate_refcount_no_crash)"] [652 2 "// pickling (PY6d's REQUEST; exceptions.c's BaseException___reduce___impl, OSError_reduce, ImportError_reduce):"] [653 2 "// (type, args[, dict]), the dict without the type's member fields; an OSError's filename (and filename2) back"] [654 2 "// in its args; an ImportError's name, path and name_from in its state"] [703 4 "// AttributeError_getstate (queue 223): the state a copy of the dict with name, when set, and args (obj"] [704 4 "// not: it is seldom picklable, GH-103352)"] [764 1 "// importErrorKw is the keyword arguments of ImportError (name, path, name_from; ImportError_init; PY6a, by the"] [765 1 "// integration's owner: importlib raises ModuleNotFoundError(msg, name=name)), NameError (name) and AttributeError"] [766 1 "// (name, obj; NameError_init, AttributeError_init)."] [801 1 "// importErrorKws records ImportError's name and path given as keywords (CPython's fields non-NULL: None given is shown)"] [804 1 "// importErrorRepr is 3.15's ImportError_repr (Objects/exceptions.c; queue 237): BaseException's repr, then name=%R and"] [805 1 "// path=%R when set (given as keywords, or not None)."] [834 1 "// kwException is an exception type whose __init__ takes keyword arguments (importErrorKw's)."] [839 1 "// attributeErrorContext is _PyObject_SetAttributeErrorContext: an AttributeError from getattr(o, name) not yet"] [840 1 "// augmented gets its name and obj."] [857 1 "// nameError is the NameError of an undefined name, its name set (as ceval's format_exc_check_arg)."] [864 1 "// The exceptions' member descriptors (exceptions.c's PyMemberDef tables; py-core-1124: StopIteration.value is a member,"] [865 1 "// test_pydoc's test_member_descriptor): the type's attribute, an instance's field read and written through it (an"] [866 1 "// instance's own attribute access reads its fields first)"] [893 19 "// a T_OBJECT member deleted reads None"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[121 20] [149 26] [183 30] [320 37] [340 31] [342 34] [381 49] [383 39] [389 47] [405 28] [408 57] [411 25] [441 35] [446 45] [466 35] [470 46] [479 51] [519 48] [522 33] [529 50] [539 53] [560 26] [591 29] [601 31] [615 38] [646 42] [666 25] [670 27] [695 32] [697 35] [708 27] [714 23] [732 29] [736 32] [746 36] [786 21] [846 29] [849 28] [884 23]] :go/trails [[875 38]]} (go/file "exc.go" :imports [

    ^{:go/apos {1 [3 8]} :go/pos {:tok-pos [3 1]}} [strings "strings"]])


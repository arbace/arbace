(in-ns 'go.arbace.py) ^{:go/comments [[5 1 "// The built-in exceptions (Objects/exceptions.c): CPython 3.14's hierarchy, BaseExceptionGroup,"] [6 1 "// ExceptionGroup, GeneratorExit and StopAsyncIteration aside (PY5d's: excgroup.go, gen.go, coro.go); their attributes: args, __cause__, __context__,"] [7 1 "// __suppress_context__, __traceback__, __notes__ and add_note, StopIteration's value, the OSError,"] [8 1 "// SyntaxError, ImportError, NameError, AttributeError and Unicode errors' fields (Dict)."] [77 1 "// Exception is an exception object (CPython's PyBaseExceptionObject): its type, arguments and"] [78 1 "// chaining. A class deriving from an exception type makes Exceptions of its type (PY5c); the"] [79 1 "// subclass-specific fields (StopIteration.value, OSError.errno, ...) are in Dict."] [88 2 "// Ext is a subtype's own data (an exception group's message and exceptions: PY5d's excgroup.go)"] [94 1 "// Traceback is a traceback entry (tb_frame, tb_lasti, tb_next): the outermost frame first, Next inward,"] [95 1 "// as CPython links them; the line is the code's :lines at PC."] [106 1 "// NewException is an exception of type t with args, its fields set from them as __init__ sets them."] [113 1 "// initExceptionFields sets the fields BaseException's subclasses derive from their arguments."] [140 34 "// oserror_init: with a filename, args are the first two (PY6d's REQUEST)"] [168 1 "// syntaxErrorDetails is SyntaxError_init's second argument: with exactly two arguments, tuple(args[1]) gives"] [169 1 "// filename, lineno, offset, text and optionally end_lineno, end_offset, _metadata (\"OOOO|OOO\"), and an end_lineno"] [170 1 "// needs its end_offset."] [195 1 "// osErrorSubtype is OSError_new's errno mapping (Linux's errno values): OSError(errno, ...) of the subclass errno"] [196 1 "// names, OSError itself for any other."] [204 21 "// EAGAIN (EWOULDBLOCK), EALREADY, EINPROGRESS"] [206 11 "// ECHILD"] [208 16 "// EPIPE, ESHUTDOWN"] [210 12 "// ECONNABORTED"] [212 12 "// ECONNREFUSED"] [214 12 "// ECONNRESET"] [216 11 "// EEXIST"] [218 10 "// ENOENT"] [220 11 "// EISDIR"] [222 11 "// ENOTDIR"] [224 10 "// EINTR"] [226 14 "// EPERM, EACCES"] [228 10 "// ESRCH"] [230 12 "// ETIMEDOUT"] [236 1 "// isExcField is whether name is one of t's member fields (initExceptionFields', SyntaxError's _metadata,"] [237 1 "// the Unicode errors')."] [258 1 "// Field is one of the exception's fields (StopIteration's value ...), nil when absent."] [266 1 "// exceptionText is str(exc): its single argument's str, or the arguments' tuple; KeyError's single"] [267 1 "// argument's repr; an OSError's \"[Errno N] text\"."] [270 44 "// PY6c, codecs_errors.go"] [314 1 "// syntaxErrorText is SyntaxError_str: str(msg), then \" (FILE, line N)\" with the filename's base name and an int"] [315 1 "// lineno, either alone when the other is missing."] [363 1 "// BaseException is the exception value itself (the subclass convention of §7.1)."] [406 61 "// PY6c, codecs_errors.go"] [415 58 "// PY6c, codecs_errors.go"] [452 55 "// PY6c, codecs_errors.go"] [462 60 "// PY6c, codecs_errors.go"] [497 4 "// a T_BOOL member: a bool only"] [504 4 "// a plain attribute (CPython keeps it in the instance dict): a list kept as Notes, anything else in the dict"] [529 5 "// the fields are members: deleting one resets it to None (test_object_attributes)"] [543 2 "// BaseException.__setstate__ (BaseException_setstate): each item of a dict state set as an attribute"] [568 2 "// pickling (PY6d's REQUEST; exceptions.c's BaseException___reduce___impl, OSError_reduce, ImportError_reduce):"] [569 2 "// (type, args[, dict]), the dict without the type's member fields; an OSError's filename (and filename2) back"] [570 2 "// in its args; an ImportError's name, path and name_from in its state"] [670 1 "// importErrorKw is the keyword arguments of ImportError (name, path, name_from; ImportError_init; PY6a, by the"] [671 1 "// integration's owner: importlib raises ModuleNotFoundError(msg, name=name)), NameError (name) and AttributeError"] [672 1 "// (name, obj; NameError_init, AttributeError_init)."] [696 1 "// kwException is an exception type whose __init__ takes keyword arguments (importErrorKw's)."] [701 1 "// attributeErrorContext is _PyObject_SetAttributeErrorContext: an AttributeError from getattr(o, name) not yet"] [702 1 "// augmented gets its name and obj."] [719 1 "// nameError is the NameError of an undefined name, its name set (as ceval's format_exc_check_arg)."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[140 19] [270 37] [290 31] [327 49] [329 39] [335 47] [351 28] [354 57] [357 25] [386 35] [391 45] [402 35] [406 46] [415 51] [452 48] [455 33] [462 53] [483 26] [514 29] [520 31] [534 38] [562 36] [582 25] [586 27] [611 32] [613 35] [620 23] [638 29] [642 32] [652 36] [708 29] [711 28]]} (go/file "exc.go" :imports [

    ^{:go/apos {1 [3 8]} :go/pos {:tok-pos [3 1]}} [strings "strings"]])


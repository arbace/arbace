(in-ns 'go.arbace.py) ^{:go/comments [[3 1 "// Functions, built-in functions, cells, code objects and modules."] [13 1 "// Function is a Python function: a code object with its globals, defaults and closure"] [14 1 "// (CPython's PyFunctionObject)."] [21 20 "// positional defaults, or nil"] [22 20 "// keyword-only defaults, or nil"] [24 20 "// __annotate__, or nil"] [25 20 "// __type_params__, or nil"] [26 20 "// __dict__, made on first use"] [29 2 "// GlobalsMap is the globals when FunctionType(code, globals) was given a dict subclass's instance (queue 205f:"] [30 2 "// annotationlib's _StringifierDict), Globals its dict: the function's global loads go through its __getitem__"] [31 2 "// (CPython's LOAD_GLOBAL on non-exact globals, PyMapping_GetOptionalItem: its __missing__), nil for a dict"] [37 1 "// Builtin is a function implemented in Go (CPython's builtin_function_or_method)."] [41 14 "// the bound object of a method, or nil"] [42 2 "// objectDescr: object's method that left object's dict through the class (methodDescrs[b] is ObjectType)"] [48 1 "// Cell is a closure's cell; Value nil is empty (unbound)."] [53 1 "// CodeObject is a code object as a Python value (the IR's {:code ...} constants)."] [58 1 "// Module is a module: its name and namespace."] [62 2 "// Cls is a subclass of module this module is an instance of (six's _LazyModule, queue 205), nil for module itself"] [73 1 "// builtinFuncModules are the built-in modules' functions' modules (PY6d's REQUEST: a function's __module__,"] [74 1 "// CPython's m_module, which pickle saves it by)."] [91 37 "// one allocation (queue 210: append grew it a second time)"] [96 4 "// method_check_args (PY7: dict.update() was a Go panic, test_ordered_dict's"] [97 4 "// CPythonBuiltinDictTests.test_update)"] [104 2 "// meth_richcompare, meth_hash: a bound built-in by its object and function (getattr(C, '__init_subclass__') twice)"] [124 62 "// meth_repr"] [129 2 "// builtin_function_or_method's __module__ (PY6d's REQUEST): a module's function's module, a builtin's"] [130 2 "// \"builtins\", else None (pickle's whichmodule then finds the function in sys.modules)"] [146 2 "// methodobject.c's meth_reduce (PY6d's REQUEST: pickle saves a built-in function by name): a function's"] [147 2 "// qualified name, a bound method as getattr(self, name)"] [159 3 "// CPython's \"at 0x...\", the address an identity number (asyncio's Handle reprs and their tests: PY6h's"] [160 3 "// REQUEST, queue 200)"] [169 2 "// cell([contents]): Objects/cellobject.c's cell_new, cell_repr and cell_richcompare (queue 205f: annotationlib's"] [170 2 "// _build_closure makes the stringifiers' cells)"] [191 35 "// tp_richcompare without tp_hash: hash() refuses a cell"] [201 3 "// empty cells come before anything else (cell_compare_impl)"] [227 3 "// module_repr: importlib's _module_repr once importlib is the import system (PY6b's request)"] [233 4 "// importlib's _module_repr: a module with a location is \"from\" it"] [238 2 "// module(name, doc=None), CPython's module_init; a subclass's instance (queue 205: six's _MovedItems) made empty"] [239 2 "// as new_module makes it, its __init__ (module.__init__ through super()) filling it"] [277 15 "// module itself: New initialized it"] [281 2 "// module_getsets: __annotations__ and __annotate__ (PEP 649), data descriptors before the dict"] [286 38 "// a subclass's instance: its class's data descriptors first"] [310 4 "// a subclass's instance: the generic lookup (its class's descriptors around the dict), then the"] [311 4 "// dict's __getattr__ (module_getattro)"] [323 23 "// PY6a (enum's global_enum): module_getattro's data descriptors first"] [334 3 "// the type's methods (__dir__, __repr__ ...), then the module's __getattr__ (PEP 562)"] [343 2 "// module.__dir__ (module_dir, queue 223: traceback's suggestions call it): the dict's __dir__ function called,"] [344 2 "// else the dict's keys"] [364 1 "// functionNew is function(code, globals, name=None, argdefs=None, closure=None, kwdefaults=None), types.FunctionType"] [365 1 "// called: Objects/funcobject.c's func_new (its clinic's argument checks, then func_new_impl's in its order, and their"] [366 1 "// messages) over PyFunction_New (the code's name, qualname and docstring, the globals' __name__ as __module__, the"] [367 1 "// builtins from the globals' __builtins__). Queue 205f: annotationlib's FORWARDREF and STRING formats call an"] [368 1 "// __annotate__'s code with a _StringifierDict as its globals (typing.NamedTuple's annotated classes, pip's import)."] [434 2 "// _PyEval_BuiltinsFromGlobals: the globals' __builtins__ (a module its dict), else the running frame's"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[79 58] [80 39] [98 27] [124 34] [133 31] [136 36] [140 58] [153 34] [172 38] [175 41] [228 42] [232 47] [270 41] [276 26] [316 41] [331 39] [335 43] [338 40] [357 30] [382 12] [382 19] [391 31] [397 34] [403 34] [411 37] [424 29] [427 12] [427 19] [435 40] [436 26] [438 31] [443 26]]} (go/file "func.go" :imports [])


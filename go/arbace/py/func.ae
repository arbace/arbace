"// CPython's \"at 0x...\", the address an identity number (asyncio's Handle reprs and their tests: PY6h's"] [133 3 "// REQUEST, queue 200)"] [142 2 "// cell([contents]): Objects/cellobject.c's cell_new, cell_repr and cell_richcompare (queue 205f: annotationlib's"] [143 2 "// _build_closure makes the stringifiers' cells)"] [164 35 "// tp_richcompare without tp_hash: hash() refuses a cell"] [174 3 "// empty cells come before anything else (cell_compare_impl)"] [200 3 "// module_repr: importlib's _module_repr once importlib is the import system (PY6b's request)"] [206 4 "// importlib's _module_repr: a module with a location is \"from\" it"] [211 2 "// module(name, doc=None), CPython's module_init; a subclass's instance (queue 205: six's _MovedItems) made empty"] [212 2 "// as new_module makes it, its __init__ (module.__init__ through super()) filling it"] [250 15 "// module itself: New initialized it"] [254 2 "// module_getsets: __annotations__ and __annotate__ (PEP 649), data descriptors before the dict"] [259 38 "// a subclass's instance: its class's data descriptors first"] [283 4 "// a subclass's instance: the generic lookup (its class's descriptors around the dict), then the"] [284 4 "// dict's __getattr__ (module_getattro)"] [296 23 "// PY6a (enum's global_enum): module_getattro's data descriptors first"] [307 3 "// the type's methods (__dir__, __repr__ ...), then the module's __getattr__ (PEP 562)"] [318 1 "// functionNew is function(code, globals, name=None, argdefs=None, closure=None, kwdefaults=None), types.FunctionType"] [319 1 "// called: Objects/funcobject.c's func_new (its clinic's argument checks, then func_new_impl's in its order, and their"] [320 1 "// messages) over PyFunction_New (the code's name, qualname and docstring, the globals' __name__ as __module__, the"] [321 1 "// builtins from the globals' __builtins__). Queue 205f: annotationlib's FORWARDREF and STRING formats call an"] [322 1 "// __annotate__'s code with a _StringifierDict as its globals (typing.NamedTuple's annotated classes, pip's import)."] [388 2 "// _PyEval_BuiltinsFromGlobals: the globals' __builtins__ (a module its dict), else the running frame's"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[77 58] [78 39] [93 27] [106 31] [109 36] [113 58] [126 34] [145 38] [148 41] [201 42] [205 47] [243 41] [249 26] [289 41] [304 39] [308 43] [311 40] [336 12] [336 19] [345 31] [351 34] [357 34] [365 37] [378 29] [381 12] [381 19] [389 40] [390 26] [392 31] [397 26]]} (go/file "func.go" :imports [])




(in-ns 'go.arbace.py) ^{:go/comments [[1 1 "//go:build linux"] [11 1 "// The module termios (queue 220; Modules/termios.c and Modules/clinic/termios.c.h of CPython 3.14.10, PSF License"] [12 1 "// Agreement): tcgetattr, tcsetattr, tcsendbreak, tcdrain, tcflush, tcflow, tcgetwinsize and tcsetwinsize over Linux's"] [13 1 "// tty ioctls as musl's termios functions make them (src/termios/*.c: tcgetattr is TCGETS, tcsetattr TCSETS+when,"] [14 1 "// tcsendbreak TCSBRK 0, tcdrain TCSBRK 1, tcflush TCFLSH, tcflow TCXONC; cfgetospeed is c_cflag&CBAUD, cfsetospeed"] [15 1 "// sets it), the struct's bytes passed by their address (reflect's Pointer, as mmap's msync: no unsafe), and the"] [16 1 "// constants of musl's headers on Linux (amd64 and arm64 alike: asm-generic's termbits and ioctls), in termios.c's"] [17 1 "// order. os.openpty (posixmodule.c over musl's openpty) is here too: it is what tty and termios' tests open."] [18 1 "//"] [19 1 "// musl's struct termios: c_iflag, c_oflag, c_cflag, c_lflag (4 bytes each), c_line, c_cc[NCCS=32], the speeds; the"] [20 1 "// kernel's TCGETS fills the first 36 bytes (its c_cc has 19), so c_cc[19:] stay zero (CPython's memset for Alpine)."] [24 21 "// sizeof(struct termios) on musl"] [50 1 "// termiosIoctl is ioctl(fd, req, buf), buf's bytes at their address (nil: 0, the argument an int); the errno."] [60 1 "// termiosError is PyErr_SetFromErrno(termios.error): termios.error(errno, strerror)."] [77 1 "// termiosLong is PyLong_AsLong: __index__, an OverflowError past C's long."] [90 1 "// termiosFd is clinic's fildes converter (PyObject_AsFileDescriptor): an int as PyLong_AsInt converts it, else"] [91 1 "// the object's fileno()."] [106 1 "// termiosArgs checks a clinic signature of positional-only arguments (name, n of them) and converts the first, the"] [107 1 "// descriptor (fildes: PyObject_AsFileDescriptor), and the int arguments after it."] [169 75 "// cfgetospeed"] [170 75 "// musl 1.2.6's cfgetispeed"] [222 3 "// musl 1.2.6's cfsetispeed (the speed in CIBAUD, 0 the output speed's) and cfsetospeed (CBAUD): EINVAL for a"] [223 3 "// speed outside CBAUD"] [255 38 "// musl ignores the duration: TCSBRK 0, a break of 0.25-0.5 s"] [282 3 "// PySequence_Check and PySequence_Size: an item slot (not a dict's) and a length of 2"] [320 1 "// posixOpenpty is os.openpty() (posixmodule.c's os_openpty_impl over musl's openpty): /dev/ptmx opened, unlocked"] [321 1 "// (TIOCSPTLCK 0), its number (TIOCGPTN) and /dev/pts/N opened; both descriptors non-inheritable."] [347 1 "// termiosConsts are termios.c's constants as musl defines them on Linux (CPython 3.14.10's module there)."]] :go/pos {:name [3 9] :package [3 1]} :go/semis [[93 22] [127 26] [165 41] [193 41] [198 45] [202 13] [202 20] [210 28] [212 32] [234 55] [249 52] [265 45] [297 34] [302 45] [309 45] [331 43] [335 41]] :go/trails [[386 116]]} (go/file "builtins_termios.go" :build ["//go:build linux"] :imports [



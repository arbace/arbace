(go/method statA64 "statA64 is newfstatat and fstat with arm64's 128-byte struct stat (AR21, queue 292: gofmt's and vet's files): crt's x86-64\ncall (newfstatat 262, fstat 5) fills its 144-byte layout in one mapping (crt's slab) at the buffer, else 16 bytes before it, else\nbelow the stack pointer, those bytes kept and put back (one thread runs at a time), a buffer that is not writable EFAULT after\nthe call's own error; the fields then move to arm64's places at the\nbuffer (nlink 32 bits after mode, blksize 32 bits, the padding zero). Linux leaves the buffer as it was on an error, and so does this.\n" ^int64 [^{:tag (* CPU)} c ^string name ^{:tag (array 6 uint64)} args]
  (let [^int i 2
        ^int64 n 262]
    (when (== name "fstat")
      (set! (values i n) (values 1 5)))

    (let [buf (aget args i)
          ^uint64 lo 0
          ok false]
      (range [_ at (lit (slice uint64) buf (- buf 16) (bit-and-not (- (aget (.-X c) 31) 4096) 15))]
        (when [sl (.Slab (.-M (.-AS c)) at)] (and (!= sl nil) (not (.-RO sl)) (>= (.End sl) (+ at 144)))
          (set! (values lo ok) (values at true))
          (break)))

      (when (not ok)
        (return (- eFAULT)))

      (let [(values keep _) (.ReadBytes (.-AS c) lo 144)
            writable (.Probe (.-AS c) buf 128)]
        (aset args i lo)
        (let [r (.Syscall (.-Sys (.-K c)) n (aget args 0) (aget args 1) (aget args 2) (aget args 3) (aget args 4) (aget args 5))
              (values x _) (.ReadBytes (.-AS c) lo 144)]
          (.WriteBytes (.-AS c) lo keep)
          (when (< r 0)
            (return r))

          (when (not writable) ; Linux's copy after the call: its error first
            (return (- eFAULT)))

          (let [y (make (slice byte) 128)]
            (copy (subslice y 0 16) (subslice x 0 16)) ; st_dev, st_ino
            (copy (subslice y 16 20) (subslice x 24 28)) ; st_mode
            (copy (subslice y 20 24) (subslice x 16 20)) ; st_nlink
            (copy (subslice y 24 32) (subslice x 28 36)) ; st_uid, st_gid
            (copy (subslice y 32 40) (subslice x 40 48)) ; st_rdev
            (copy (subslice y 48 60) (subslice x 48 60)) ; st_size, st_blksize
            (copy (subslice y 64 120) (subslice x 64 120)) ; st_blocks, st_atim, st_mtim, st_ctim
            (.WriteBytes (.-AS c) buf y)
            r))))))



(go/const "The M2's identification a program reads at EL0 (AR19, queue 288; read on the VM's M2 under Linux 7.3): CTR_EL0 (64-byte\nlines, DIC and IDC clear), DCZID_EL0 (dc zva allowed, 64-byte blocks), CNTFRQ_EL0 (24 MHz).\n"
  [^{:tag uint64 :val 2487533572} CTR 0x9444c004]
  [^{:tag uint64 :val 4} DCZID 4]
  [^{:tag uint64 :val 64} dczBlock 64]
  [^{:tag uint64 :val 24000000} CNTFRQ 24000000])


(go/method Counter "Counter is CNTVCT_EL0 (and CNTVCTSS_EL0): the time since the CPU's origin (a thread's is its process's) plus 1000 s, as crt's\nCLOCK_MONOTONIC counts, at CNTFRQ_EL0's 24 MHz; it never goes back.\n" ^uint64 [^{:tag (* CPU)} c]
  (let [ns (conv uint64 (.Nanoseconds (+ (time/Since (.-t0 c)) (* 1000 time/Second))))]
    (+ (* (/ ns 1000) 24) (/ (* (% ns 1000) 24) 1000))))


(go/func IDReg "IDReg is the value of an ID register Linux emulates for EL0 (MRS of op0 3, op1 0, CRn 0, with CRm 0 or 2-7: MIDR_EL1,
MPIDR_EL1, REVIDR_EL1 and the 48 of the ID space, the unallocated ones 0) as a64i answers it (AR20, ARS85 (a)): this M2's values under
Linux 7.3 (queue 291's probe of all 51) with the fields of what a64i does not implement made 0: ID_AA64ISAR1_EL1's API and GPI
(FEAT_PAuth), BF16 and I8MM; ID_AA64PFR1_EL1's BT (FEAT_BTI). False for any other register (UNDEFINED).
" [^uint32 sys] :results [uint64 bool]
  (when (!= (>> sys 7) 0x180)
    (return 0 false))

  (let [crm (bit-and (>> sys 3) 15)
        op2 (bit-and sys 7)]
    (when (== crm 0)
      (switch op2
        (case [0]
          (return 0x610f0000 true)) ; MIDR_EL1: Apple's implementer, the architecture's 0xf (Linux hides the part)
        (case [5]
          (return 0x80000000 true)) ; MPIDR_EL1: RES1 bit 31 alone
        (case [6]
          (return 0 true))) ; REVIDR_EL1

      (return 0 false))

    (when (or (== crm 1) (> crm 7))
      (return 0 false))

    (switch (bit-or (<< crm 3) op2)
      (case [32] ; ID_AA64PFR0_EL1: EL0 and EL1 AArch64, FP and AdvSIMD with half precision, DIT
        (return 0x0001000000110011 true))
      (case [40] ; ID_AA64DFR0_EL1: DebugVer 6
        (return 6 true))
      (case [48] ; ID_AA64ISAR0_EL1: AES and PMULL, SHA1, SHA2 with SHA512, CRC32, LSE, RDM, SHA3, DotProd, FHM, FlagM2
        (return 0x0021100110212120 true))
      (case [49] ; ID_AA64ISAR1_EL1: DC CVAP and CVADP, JSCVT, FCMA, LRCPC2, FRINTTS, SB (the M2's API 4, GPI 1, BF16 1, I8MM 1 made 0)
        (return 0x0000001100211002 true))
      (case [56] ; ID_AA64MMFR0_EL1: the translation granules Linux shows
        (return 0x00000111ff000000 true))
      (case [58] ; ID_AA64MMFR2_EL1: AT (FEAT_LSE2)
        (return 0x0000000100000000 true)))

    (return 0 true)))


(go/func IDHidden "IDHidden are the fields of an ID register IDReg makes 0 where this M2 shows a feature a64i does not implement (the lockstep\ncompares the others; AR20).\n" ^uint64 [^uint32 sys]
  (switch sys
    (case [49201] ; ID_AA64ISAR1_EL1 (3, 0, 0, 6, 1): API, GPI, BF16, I8MM
      (return 0x00f0f000f0000f00))
    (case [49185] ; ID_AA64PFR1_EL1 (3, 0, 0, 4, 1): BT
      (return 0xf)))

  0)

          (return))

        ;; queue 309: F_GETFL's flags as arm64's
        (when (and (== (.-Name s) "fcntl") (== (conv int32 (aget args 1)) 3) (>= r 0))
          (set! r (conv int64 (emu/OpenFlagsToA64 (conv uint64 r)))))

        (aset (.-X c) 0 (conv uint64 r))))))




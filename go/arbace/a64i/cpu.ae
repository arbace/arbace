          (when (.threadExit c (conv int (bit-and (aget args 0) 255)))
            (return)))
        (case ["kill" "tkill" "tgkill"]
          (aset (.-X c) 0 (conv uint64 (.kill c (.-Name s) args)))
          (return))
        (case ["getpid"]
          (aset (.-X c) 0 (conv uint64 (.-Pid c)))
          (return))
        (case ["gettid"]

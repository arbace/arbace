^{:go/end 67} (go/func New "New is a CPU at entry with the stack pointer sp.\n" ^{:tag (* CPU)} [^{:tag (* emu/AS)} as ^{:tag (* emu/Kernel)} k ^uint64 entry ^uint64 sp]

(go/method svc "the system call (SVC #0), traced when strace is set\n" [^{:tag (* CPU)} c]
  (if (not strace)
    (do
      (.svcCall c)
      (set! (.-SysX0 c) (aget (.-X c) 0)))
    (let [n (aget (.-X c) 8)
          args (lit (array 6 uint64) (aget (.-X c) 0) (aget (.-X c) 1) (aget (.-X c) 2) (aget (.-X c) 3) (aget (.-X c) 4) (aget (.-X c) 5))
          (values s _) (emu/SyscallA64 (conv int n))]
      (.svcCall c)
      (set! (.-SysX0 c) (aget (.-X c) 0))
      (let [r (fmt/Sprintf "%#x" (aget (.-X c) 0))]
        (when (.-Done c)
          (set! r (fmt/Sprintf "(the end: status %d)" (.Status c))))
        (fmt/Fprintf os/Stderr "a64i: [%d] %s(%d) %#x %#x %#x %#x %#x %#x = %s at %#x\n" (.tid c) (.-Name s) n (aget args 0) (aget args 1) (aget args 2) (aget args 3) (aget args 4) (aget args 5) r (- (.-PC c) 4))))))


^{:go/end 353} (go/method svcCall "the system call (SVC #0): x8 the number, x0-x5 the arguments, x0 the result\n" [^{:tag (* CPU)} c]
  (let [n (aget (.-X c) 8)
      ^{:line 312} args (lit (array 6 uint64) (aget (.-X c) 0) (aget (.-X c) 1) (aget (.-X c) 2) (aget (.-X c) 3) (aget (.-X c) 4) (aget (.-X c) 5))]
    (set! (.-LastSys c) n)
    (set! (.-SysDone c) true)
    (when (!= (.-SysHook c) nil)
      (when [(values r ok) ((.-SysHook c) n args)] ok
        (aset (.-X c) 0 (conv uint64 r))
        (return)))


    ;; AR19: the poller's calls and descriptors (thread.go)
    (when [(values r ok) (.poll c n args)] ok
      (aset (.-X c) 0 (conv uint64 r))
      (return))

    (let [(values s ok) (emu/SyscallA64 (conv int n))]
      (when (not ok)
        (aset (.-X c) 0 enosys)
        (return))

      (switch (.-Name s)
        (case ["rt_sigaction"]
          ;; AR19: the dispositions, signals' masks and alternate stacks (thread.go); AR20: delivered (signal.go)
          (aset (.-X c) 0 (conv uint64 (.sigaction c (aget args 0) (aget args 1) (aget args 2) (aget args 3))))
          (return))
        (case ["rt_sigprocmask"]
          (aset (.-X c) 0 (conv uint64 (.sigprocmask c (aget args 0) (aget args 1) (aget args 2) (aget args 3))))
          (return))
        (case ["sigaltstack"]
          (aset (.-X c) 0 (conv uint64 (.sigaltstack c (aget args 0) (aget args 1))))
          (return))
        (case ["clone"]

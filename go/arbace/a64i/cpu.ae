(go/var ^{:tag bool :doc "strace, from A64I_STRACE (set, not empty), prints each system call to stderr: the thread, its name and arguments, x0 after\n(AR19, queue 288: the Go programs' runs followed)\n"} strace (!= (os/Getenv "A64I_STRACE") ""))



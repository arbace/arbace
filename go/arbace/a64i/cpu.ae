^{:go/end 121} (go/method inject [^{:tag (* CPU)} c ^{:tag (* Inst)} in]
  (when (!= (.Family in) injFamily)
    (return))

  (switch injFlag
    (case ["n"]
      (set! (.-N c) (not (.-N c))))
    (case ["z"]
      (set! (.-Z c) (not (.-Z c))))
    (case ["c"]
      (set! (.-C c) (not (.-C c))))
    (case ["v"]
      (set! (.-V c) (not (.-V c))))
    (case ["x"]
      (.injectX c in))
    (case ["f"]
      (set! (.-FPSR c) bit-xor 1))
    (case ["q"]
      (set! (.-FPSR c) bit-xor 0x8000000))
    (case ["r"]
      (set! (.-FPCR c) bit-xor 0x400000))
    (case ["a"]
      (when (and (== (.-Op in) OpMSR) (== (.-Sys in) SysFPCR))
        (set! (.-FPCR c) bit-or (bit-and (.reg c (.-Rd in) false) 7))))))





^{:go/end 159} (go/method Fetch "Fetch is the instruction at pc: from the forms (eval) or decoded from the bytes (AOT), with the reason when there is none.\n" [^{:tag (* CPU)} c ^uint64 pc] :results [(* Inst) int string]
  (when (!= (bit-and pc 3) 0)
    (return nil SIGBUS ":pc-alignment"))

  (when (!= (.-Forms c) nil)
    (when (== (bit-and (.Perm (.-AS c) pc) emu/PermX) 0)
      (return nil SIGSEGV ":fetch"))

    (let [(values in ok) (aget (.-Forms c) pc)]
      (when (not ok)
        (return nil SIGILL ":code-as-data no form at this address"))

      (when (== (.-Op in) OpInvalid)
        (return nil SIGILL (aget (.-FormErr c) pc)))

      (return in 0 "")))

  (let [^{:tag (array 4 byte)} b (zero (array 4 byte))]
    (when (< (.Fetch (.-AS c) pc (subslice b)) 4)
      (return nil SIGSEGV ":fetch"))

    (let [w (bit-or (conv uint32 (aget b 0)) (<< (conv uint32 (aget b 1)) 8) (<< (conv uint32 (aget b 2)) 16) (<< (conv uint32 (aget b 3)) 24))]
      (when [(values e ok) (aget (.-cache c) pc)] (and ok (== (.-w e) w))
        (when (!= (.-r e) "")
          (return nil SIGILL (.-r e)))

        (return (addr (.-in e)) 0 ""))

      (let [(values in r) (Decode w pc)]
        (aset (.-cache c) pc (lit cached w in r))
        (when (!= r "")
          (return nil SIGILL r))

        (let [e (aget (.-cache c) pc)]
          (return (addr (.-in e)) 0 ""))))))



^{:go/end 182} (go/method Step "Step executes one instruction; false when the process has ended. AR20: a synchronous fault with a handler is\ndelivered to it, and the signals pending and not blocked at the instruction's end (signal.go).\n" ^bool [^{:tag (* CPU)} c]
  (when (.-Done c)
    (return false))

  (let [pc (.-PC c)
        (values in sig r) (.Fetch c pc)]
    (when (== in nil)
      (set! (.-FaultAddr c) pc)
      (.raise c sig r)
      (.signalled c pc true)
      (return (not (.-Done c))))

    (set! (.-Last c) in)
    (inc! (.-Steps c))
    (when (!= (.-Cover c) nil)
      (inc! (aget (.-Cover c) (+ (.Name in) " " (.Family in)))))

    (.exec c in)
    (when (.-Done c)
      (.signalled c pc false))

    (when (and (!= injFamily "") (not (.-Done c)))
      (.inject c in))

    (when (and (!= (.-Pending c) 0) (not (.-Done c)))
      (.deliverPending c))

    (not (.-Done c))))




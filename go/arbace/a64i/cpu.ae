    ^{:line 48 :tag uint64 :doc "LastSys is the last system call's number (the lockstep's)\n"} LastSys

    ^{:line 50 :tag (* Inst) :doc "Last is the last instruction executed\n"} Last

    ^{:line 52 :tag bool :doc "stop after a system call (the lockstep's sys mode)\n"} StopAtSys
    ^{:line 53 :tag bool} SysDone))



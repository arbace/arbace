(in-ns 'go.arbace.a64i) (go/file "lockstep.go" :imports [])



(go/type LockstepOpts "LockstepOpts choose the mode: Step from the start; else the sys mode, switching to the step mode once StepFrom system\ncalls are done (StepFrom < 0: never). StepLimit bounds the step mode's instructions (0: none).\n" (struct
    ^{:line 6 :tag bool} Step
    ^{:line 7 :tag int} StepFrom
    ^{:line 8 :tag uint64} StepLimit))



(go/type LockstepResult "LockstepResult is a lockstep run's verdict.\n" (struct
    ^{:line 13 :tag bool} Equal
    ^{:line 14 :tag string} Diff
    ^{:line 15 :tag int} Syscalls
    ^{:line 16 :tag uint64} Steps
    ^{:line 17 :tag uint64} Stepped
    ^{:line 18 :tag int} Status
    ^{:line 19 :tag uint64} DiffPC
    ^{:line 20 :tag string} DiffInst
    ^{:line 21 :tag string} Family
    ^{:line 22 :tag string} Loader
    ^{:line 23 :tag int} Exclusive
    ^{:tag int :doc "the exclusive regions whose native store-exclusive failed (to the next system call, AR5's rule; ARS44)\n"} ExclusiveFailed
    ^{:tag int :doc "the signals delivered to handlers, by both (AR20)\n"} Signals
    ^{:tag bool :doc "the run stopped at the program's first thread (clone with CLONE_THREAD at ThreadPC), every system call and stop before it\nequal: the native's threads are not followed (queue 302)\n"} Thread
    ^{:tag uint64} ThreadPC))

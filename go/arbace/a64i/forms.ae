      (when (== (len rest) 2)
        (when (or (!= (.-Mode in) ModeOff) (!= (len (.-List a)) 2))
          (ferr "post-index"))

        (set! (values (.-Mode in) (.-Imm in)) (values ModePost (value (aget rest 1))))
        (return in))

      (when (>= (len (.-List a)) 3)
        (when [(values r ok) (asReg (aget (.-List a) 2))] ok
          (when (!= (.-Mode in) ModeOff)
            (ferr "register offset with writeback"))

          (set! (values (.-Mode in) (.-Rm in) (.-Ext in)) (values ModeReg (.-n r) ExtUXTX))
          (when (not (.-x r))
            (set! (.-Ext in) ExtUXTW))

          (when (== (len (.-List a)) 4)
            (let [(values k amt ok) (shiftOp (aget (.-List a) 3))]
              (when (not ok)
                (ferr "extend"))

              (if (== k "lsl")
                (set! (.-Ext in) ExtUXTX)
                (if [(values e ok) (aget extKinds k)] ok
                  (set! (.-Ext in) e)

                  (ferr "extend %s" k)))

              (set! (.-Amount in) (conv uint8 amt))))

          (return in))

        (set! (.-Imm in) (value (aget (.-List a) 2))))

      ^{:line 946} in)))

        (return (lit regOp 31 true true false) true))
      (case ["wsp"]
        (return (lit regOp 31 false true false) true))
      (case ["xzr"]
        (return (lit regOp 31 true false true) true))
      (case ["wzr"]
        (return (lit regOp 31 false false true) true))
      (case ["fp"]

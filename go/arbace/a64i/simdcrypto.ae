(in-ns 'go.arbace.a64i) (go/file "simdcrypto.go" :imports [
    [bits "math/bits"]
    [strconv "strconv"]
    [strings "strings"]])

;; AR17 (ARS77 (a), queue 283): the M2's cryptographic extension, OpVC, written as forms. The semantics are the Arm ARM's (DDI
;; 0487: AESE, AESD, AESMC, AESIMC with AESShiftRows, AESInvShiftRows, AESSubBytes, AESInvSubBytes, AESMixColumns,
;; AESInvMixColumns; SHA1C, SHA1P, SHA1M, SHA1H, SHA1SU0, SHA1SU1 with SHAchoose, SHAparity, SHAmajority; SHA256H, SHA256H2,
;; SHA256SU0, SHA256SU1 with SHA256hash, SHAhashSIGMA0, SHAhashSIGMA1; SHA512H, SHA512H2, SHA512SU0, SHA512SU1; EOR3, BCAX,
;; RAX1, XAR; PMULL's 1Q with PolynomialMult); the AES tables computed from FIPS 197's definition (5.1.1: the inverse in GF(2^8)
;; and the affine transformation), no table or code copied.

(go/var ^{:doc "vcNames is OpVC's instructions, Sys its index: 0-3 FEAT_AES (aese, aesd, aesmc, aesimc), 4-10 the three-register SHA\n(FEAT_SHA1's sha1c, sha1p, sha1m, sha1su0; FEAT_SHA256's sha256h, sha256h2, sha256su1: opcode + 4), 11-13 the two-register SHA\n(sha1h, sha1su1, sha256su0: opcode + 11), 14-17 the three-register SHA512 (FEAT_SHA512's sha512h, sha512h2, sha512su1; FEAT_SHA3's\nrax1: opcode + 14), 18 sha512su0, 19-21 FEAT_SHA3's eor3, bcax (Ra the fourth register) and xar (Imm the rotation), 22\nFEAT_PMULL's pmull 1q (Sf: pmull2, the upper doublewords).\n"} vcNames (lit (array ... string) "aese" "aesd" "aesmc" "aesimc" "sha1c" "sha1p" "sha1m" "sha1su0" "sha256h" "sha256h2" "sha256su1" "sha1h" "sha1su1" "sha256su0" "sha512h" "sha512h2" "sha512su1" "rax1" "sha512su0" "eor3" "bcax" "xar" "pmull"))

(go/var ^{:doc "vcOps is each instruction's operands as its forms write them (d, n, m, a): q and s a scalar register, else a vector's\narrangement.\n"} vcOps (lit (array ... string) "16b 16b" "16b 16b" "16b 16b" "16b 16b" "q s 4s" "q s 4s" "q s 4s" "4s 4s 4s" "q q 4s" "q q 4s" "4s 4s 4s" "s s" "4s 4s" "4s 4s" "q q 2d" "q q 2d" "2d 2d 2d" "2d 2d 2d" "2d 2d" "16b 16b 16b 16b" "16b 16b 16b 16b" "2d 2d 2d" "1q 1d 1d"))

(go/var ^{:doc "aesBox is AES's S-box (0) and its inverse (1), computed by aesTables.\n"} aesBox (aesTables))


(go/func decodeVC "decodeVC is the instructions' words (the cryptographic AES, three- and two-register SHA, three- and two-register SHA512,\nfour-register and XAR classes, and the three different class's pmull with size 11); false when the word is another instruction.\n" [^uint32 w] :results [Inst string bool]
  (let [(values rd rn rm) (values (conv uint8 (bf w 4 0)) (conv uint8 (bf w 9 5)) (conv uint8 (bf w 20 16)))]
    (switch
      (case [(== (bit-and w 0xff3e0c00) 0x4e280800)]
        ;; AES (size 00, opcode 001xx)
        (let [op (bf w 16 12)]
          (when (or (!= (bf w 23 22) 0) (< op 4) (> op 7))
            (return (lit Inst) undef true))

          (return (lit Inst :Op OpVC :Rd rd :Rn rn :Sys (- op 4)) "" true)))
      (case [(== (bit-and w 0xff208c00) 0x5e000000)]
        ;; three-register SHA (size 00, opcode 000-110)
        (let [op (bf w 14 12)]
          (when (or (!= (bf w 23 22) 0) (== op 7))
            (return (lit Inst) undef true))

          (return (lit Inst :Op OpVC :Rd rd :Rn rn :Rm rm :Sys (+ op 4)) "" true)))
      (case [(== (bit-and w 0xff3e0c00) 0x5e280800)]
        ;; two-register SHA (size 00, opcode 00000-00010)
        (let [op (bf w 16 12)]
          (when (or (!= (bf w 23 22) 0) (> op 2))
            (return (lit Inst) undef true))

          (return (lit Inst :Op OpVC :Rd rd :Rn rn :Sys (+ op 11)) "" true)))
      (case [(== (bit-and w 0xffe0f000) 0xce608000)]
        ;; three-register SHA512 (O 0: sha512h, sha512h2, sha512su1, rax1; O 1 is SM3's, not the M2's)
        (return (lit Inst :Op OpVC :Rd rd :Rn rn :Rm rm :Sys (+ (bf w 11 10) 14)) "" true))
      (case [(== (bit-and w 0xfffffc00) 0xcec08000)]
        ;; two-register SHA512's sha512su0 (opcode 01 is SM4E, not the M2's)
        (return (lit Inst :Op OpVC :Rd rd :Rn rn :Sys 18) "" true))
      (case [(== (bit-and w 0xffc08000) 0xce000000)]
        ;; four-register eor3 (Op0 00) and bcax (Op0 01)
        (return (lit Inst :Op OpVC :Rd rd :Rn rn :Rm rm :Ra (conv uint8 (bf w 14 10)) :Sys (+ (bf w 21 21) 19)) "" true))
      (case [(== (bit-and w 0xffe00000) 0xce800000)]
        (return (lit Inst :Op OpVC :Rd rd :Rn rn :Rm rm :Imm (conv int64 (bf w 15 10)) :Sys 21) "" true))
      (case [(== (bit-and w 0xbfe0fc00) 0x0ee0e000)]
        (return (lit Inst :Op OpVC :Sf (== (bf w 30 30) 1) :Rd rd :Rn rn :Rm rm :Sys 22) "" true)))

    (return (lit Inst) "" false)))


(go/func vcArrReg "vcArrReg is a vector operand (reg vN :ARR) as its number and arrangement, ARR any (1q too).\n" [^{:tag (* Sx)} o] :results [uint8 string bool]
  (when (or (!= (.head o) "reg") (!= (len (.-List o)) 3))
    (return 0 "" false))

  (let [n (.-Atom (aget (.-List o) 1))]
    (when (or (< (len n) 2) (!= (aget n 0) \v))
      (return 0 "" false))

    (let [(values k err) (strconv/Atoi (subslice n 1))]
      (when (or (!= err nil) (< k 0) (> k 31))
        (return 0 "" false))

      (return (conv uint8 k) (strings/TrimPrefix (.-Atom (aget (.-List o) 2)) ":") true))))


(go/func vcOperand "vcOperand is the operand o as the spec s names it (q, s: a scalar register; else a vector's arrangement): its register.\n" ^uint8 [^string m ^{:tag (* Sx)} o ^string s]
  (when (or (== s "q") (== s "s"))
    (let [(values r sz ok) (asVReg o)]
      (when (or (not ok) (!= (conv int sz) (strings/IndexByte "bhsdq" (aget s 0))))
        (ferr "%s's operand %s" m o))

      (return r)))

  (let [(values r a ok) (vcArrReg o)]
    (when (or (not ok) (!= a s))
      (ferr "%s's operand %s" m o))

    (return r)))


(go/func lowerVC "lowerVC is the instructions' forms: aese v0.16b, v1.16b; sha1c q0, s1, v2.4s; sha1h s0, s1; sha256h2 q0, q1, v2.4s;\nsha256su0 v0.4s, v1.4s; sha512h q0, q1, v2.2d; sha512su0 v0.2d, v1.2d; eor3 v0.16b, v1.16b, v2.16b, v3.16b; xar v0.2d, v1.2d,\nv2.2d, #10; pmull v0.1q, v1.1d, v2.1d; pmull2 v0.1q, v1.2d, v2.2d; false when the form is not one (pmull and pmull2 of another\narrangement are lowerVINT's).\n" [^string m ^{:tag (slice (* Sx))} ops] :results [Inst bool]
  (let [k (nameIndex (subslice vcNames) m)
      two (== m "pmull2")]
    (when two
      (set! k 22))

    (when (< k 0)
      (return (lit Inst) false))

    (let [spec (strings/Fields (aget vcOps k))]
      (when two
        (set! spec (lit (slice string) "1q" "2d" "2d")))

      (when (== k 22)
        (when (== (len ops) 0)
          (return (lit Inst) false))

        (when [(values _ a ok) (vcArrReg (aget ops 0))] (or (not ok) (!= a "1q"))
          (return (lit Inst) false)))

      (if (== k 21)
        (nargs ops 4)

        (nargs ops (len spec)))

      (let [in (lit Inst :Op OpVC :Sf two :Sys (conv uint32 k))]
        (set! (.-Rd in) (vcOperand m (aget ops 0) (aget spec 0)))
        (set! (.-Rn in) (vcOperand m (aget ops 1) (aget spec 1)))
        (when (> (len spec) 2)
          (set! (.-Rm in) (vcOperand m (aget ops 2) (aget spec 2))))

        (when (> (len spec) 3)
          (set! (.-Ra in) (vcOperand m (aget ops 3) (aget spec 3))))

        (when (== k 21)
          (let [r (value (aget ops 3))]
            (when (or (< r 0) (> r 63))
              (ferr "xar's rotation #%d" r))

            (set! (.-Imm in) r)))

        (return in true)))))


(go/func vcName "vcName is the coverage's name: v.aese.16b, v.sha1c.4s, v.sha1h.s, v.sha256h.4s, v.sha512h.2d, v.eor3.16b, v.xar.2d,\nv.pmull.1q, v.pmull2.1q.\n" ^string [^{:tag (* Inst)} in]
  (let [spec (strings/Fields (aget vcOps (.-Sys in)))
      s (aget spec 0)
      nm (aget vcNames (.-Sys in))]
    (when (== s "q")
      (set! s (aget spec (- (len spec) 1))))

    (when (.-Sf in)
      (set! nm + "2"))

    (return (+ "v." nm "." s))))


(go/func gmul "gmul is the product of a and b in GF(2^8), modulo x^8 + x^4 + x^3 + x + 1 (FIPS 197, 4.2).\n" ^byte [^byte a ^byte b]
  (let [^byte r (zero byte)]
    (for [i 0] (< i 8) (inc! i)
      (when (== (bit-and b 1) 1)
        (set! r bit-xor a))

      (let [hi (bit-and a 0x80)]
        (set! a (<< a 1))
        (when (!= hi 0)
          (set! a bit-xor 0x1b)))

      (set! b (>> b 1)))

    (return r)))


(go/func aesTables "aesTables is AES's S-box and its inverse (FIPS 197, 5.1.1): each byte's inverse in GF(2^8) (0 for 0), then the affine\ntransformation b ^ rotl(b, 1) ^ rotl(b, 2) ^ rotl(b, 3) ^ rotl(b, 4) ^ 0x63.\n" ^{:tag (array 2 (array 256 byte))} []
  (let [^{:tag (array 2 (array 256 byte))} t (zero (array 2 (array 256 byte)))]
    (for [x 0] (< x 256) (inc! x)
      (let [inv (conv byte 0)]
        (for [y 1] (< y 256) (inc! y)
          (when (== (gmul (conv byte x) (conv byte y)) 1)
            (set! inv (conv byte y))))

        (let [s (bit-xor inv (bits/RotateLeft8 inv 1) (bits/RotateLeft8 inv 2) (bits/RotateLeft8 inv 3) (bits/RotateLeft8 inv 4) 0x63)]
          (aset (aget t 0) x s)
          (aset (aget t 1) s (conv byte x)))))

    (return t)))


(go/func vcBytes "vcBytes is a vector's sixteen bytes, byte 0 the lowest.\n" ^{:tag (array 16 byte)} [^{:tag (array 2 uint64)} v]
  (let [^{:tag (array 16 byte)} b (zero (array 16 byte))]
    (for [i 0] (< i 16) (inc! i)
      (aset b i (conv byte (>> (aget v (/ i 8)) (* 8 (% i 8))))))

    (return b)))


(go/func vcVec "vcVec is the vector of sixteen bytes, byte 0 the lowest.\n" ^{:tag (array 2 uint64)} [^{:tag (array 16 byte)} b]
  (let [^{:tag (array 2 uint64)} v (zero (array 2 uint64))]
    (for [i 0] (< i 16) (inc! i)
      (aset v (/ i 8) (bit-or (aget v (/ i 8)) (<< (conv uint64 (aget b i)) (* 8 (% i 8))))))

    (return v)))


(go/func aesRound "aesRound is AESShiftRows then AESSubBytes of the state x (AESE's), or with inv AESInvShiftRows then AESInvSubBytes\n(AESD's): byte r + 4c of the result is the box's of byte r + 4((c + r) mod 4) of x (r + 4((c - r) mod 4) inverted).\n" ^{:tag (array 2 uint64)} [^{:tag (array 2 uint64)} x ^bool inv]
  (let [s (vcBytes x)
      ^{:tag (array 16 byte)} o (zero (array 16 byte))
      k 0]
    (when inv
      (set! k 1))

    (for [c 0] (< c 4) (inc! c)
      (for [r 0] (< r 4) (inc! r)
        (let [src (+ c r)]
          (when inv
            (set! src (- (+ c 4) r)))

          (aset o (+ r (* 4 c)) (aget (aget aesBox k) (aget s (+ r (* 4 (% src 4)))))))))

    (return (vcVec o))))


(go/func aesMix "aesMix is AESMixColumns of the state x, or with inv AESInvMixColumns: each column's bytes by the matrix of rows 2 3 1 1\n(14 11 13 9), rotated a byte a row.\n" ^{:tag (array 2 uint64)} [^{:tag (array 2 uint64)} x ^bool inv]
  (let [s (vcBytes x)
      ^{:tag (array 16 byte)} o (zero (array 16 byte))
      cf (lit (array 4 byte) 2 3 1 1)]
    (when inv
      (set! cf (lit (array 4 byte) 14 11 13 9)))

    (for [c 0] (< c 4) (inc! c)
      (for [i 0] (< i 4) (inc! i)
        (let [^byte v (zero byte)]
          (for [j 0] (< j 4) (inc! j)
            (set! v bit-xor (gmul (aget cf (% (- (+ j 4) i) 4)) (aget s (+ j (* 4 c))))))

          (aset o (+ i (* 4 c)) v))))

    (return (vcVec o))))


(go/func vcW "vcW is a vector's four words, word 0 the lowest.\n" ^{:tag (array 4 uint32)} [^{:tag (array 2 uint64)} v]
  (return (lit (array 4 uint32) (conv uint32 (aget v 0)) (conv uint32 (>> (aget v 0) 32)) (conv uint32 (aget v 1)) (conv uint32 (>> (aget v 1) 32)))))


(go/func vcFromW "vcFromW is the vector of four words, word 0 the lowest.\n" ^{:tag (array 2 uint64)} [^{:tag (array 4 uint32)} w]
  (return (lit (array 2 uint64) (bit-or (conv uint64 (aget w 0)) (<< (conv uint64 (aget w 1)) 32)) (bit-or (conv uint64 (aget w 2)) (<< (conv uint64 (aget w 3)) 32)))))


(go/func sha1Hash "sha1Hash is SHA1C (k 4: SHAchoose), SHA1P (5: SHAparity) or SHA1M (6: SHAmajority): four rounds of the state x (a b c d\nfrom word 0) and y (e) with the words w, the result's x.\n" ^{:tag (array 4 uint32)} [^{:tag (array 4 uint32)} x ^uint32 y ^{:tag (array 4 uint32)} w ^uint32 k]
  (for [e 0] (< e 4) (inc! e)
    (let [t (bit-xor (bit-and (bit-xor (aget x 2) (aget x 3)) (aget x 1)) (aget x 3))]
      (switch k
        (case [5]
          (set! t (bit-xor (aget x 1) (aget x 2) (aget x 3))))
        (case [6]
          (set! t (bit-or (bit-and (aget x 1) (aget x 2)) (bit-and (bit-or (aget x 1) (aget x 2)) (aget x 3))))))

      (set! y (+ y (bits/RotateLeft32 (aget x 0) 5) t (aget w e)))
      (aset x 1 (bits/RotateLeft32 (aget x 1) 30))
      (set! (values y x) (values (aget x 3) (lit (array 4 uint32) y (aget x 0) (aget x 1) (aget x 2))))))

  (return x))


(go/func sha256Hash "sha256Hash is SHA256hash: four rounds of the state x (a b c d) and y (e f g h) with the words w; x when part1 (SHA256H),\nelse y (SHA256H2).\n" ^{:tag (array 4 uint32)} [^{:tag (array 4 uint32)} x ^{:tag (array 4 uint32)} y ^{:tag (array 4 uint32)} w ^bool part1]
  (for [e 0] (< e 4) (inc! e)
    (let [chs (bit-xor (bit-and (bit-xor (aget y 1) (aget y 2)) (aget y 0)) (aget y 2))
        maj (bit-or (bit-and (aget x 0) (aget x 1)) (bit-and (bit-or (aget x 0) (aget x 1)) (aget x 2)))
        s1 (bit-xor (bits/RotateLeft32 (aget y 0) -6) (bits/RotateLeft32 (aget y 0) -11) (bits/RotateLeft32 (aget y 0) -25))
        s0 (bit-xor (bits/RotateLeft32 (aget x 0) -2) (bits/RotateLeft32 (aget x 0) -13) (bits/RotateLeft32 (aget x 0) -22))
        t (+ (aget y 3) s1 chs (aget w e))]
      (aset x 3 (+ t (aget x 3)))
      (aset y 3 (+ t s0 maj))
      (set! (values x y) (values (lit (array 4 uint32) (aget y 3) (aget x 0) (aget x 1) (aget x 2)) (lit (array 4 uint32) (aget x 3) (aget y 0) (aget y 1) (aget y 2))))))

  (when part1
    (return x))

  (return y))


(go/func sha512S1 "sha512S1 is SHA-512's Sigma1 (SHA512H's).\n" ^uint64 [^uint64 x]
  (return (bit-xor (bits/RotateLeft64 x -14) (bits/RotateLeft64 x -18) (bits/RotateLeft64 x -41))))


(go/func sha512S0 "sha512S0 is SHA-512's Sigma0 (SHA512H2's).\n" ^uint64 [^uint64 x]
  (return (bit-xor (bits/RotateLeft64 x -28) (bits/RotateLeft64 x -34) (bits/RotateLeft64 x -39))))


(go/func sha256s1 "sha256s1 is SHA-256's message schedule's sigma1 (SHA256SU1's).\n" ^uint32 [^uint32 v]
  (return (bit-xor (bits/RotateLeft32 v -17) (bits/RotateLeft32 v -19) (>> v 10))))


(go/func sha512s0 "sha512s0 is SHA-512's message schedule's sigma0 (SHA512SU0's).\n" ^uint64 [^uint64 v]
  (return (bit-xor (bits/RotateLeft64 v -1) (bits/RotateLeft64 v -8) (>> v 7))))


(go/func sha512s1 "sha512s1 is SHA-512's message schedule's sigma1 (SHA512SU1's).\n" ^uint64 [^uint64 v]
  (return (bit-xor (bits/RotateLeft64 v -19) (bits/RotateLeft64 v -61) (>> v 6))))


(go/func clmul64 "clmul64 is the carry-less product of x and y, 128 bits (PolynomialMult at 64 bits).\n" ^{:tag (array 2 uint64)} [^uint64 x ^uint64 y]
  (let [^{:tag (array 2 uint64)} r (zero (array 2 uint64))]
    (for [i (conv uint 0)] (< i 64) (inc! i)
      (when (== (bit-and (>> y i) 1) 1)
        (aset r 0 (bit-xor (aget r 0) (<< x i)))
        (when (> i 0)
          (aset r 1 (bit-xor (aget r 1) (>> x (- 64 i)))))))

    (return r)))


(go/method execVC "execVC executes OpVC (the operands read before the destination is written; a scalar destination's upper bits cleared).\n" [^{:tag (* CPU)} c ^{:tag (* Inst)} in]
  (let [(values d n m a) (values (aget (.-Q c) (.-Rd in)) (aget (.-Q c) (.-Rn in)) (aget (.-Q c) (.-Rm in)) (aget (.-Q c) (.-Ra in)))
      ^{:tag (array 2 uint64)} r (zero (array 2 uint64))]
    (switch (.-Sys in)
      (case [0 1]
        (set! r (aesRound (lit (array 2 uint64) (bit-xor (aget d 0) (aget n 0)) (bit-xor (aget d 1) (aget n 1))) (== (.-Sys in) 1))))
      (case [2 3]
        (set! r (aesMix n (== (.-Sys in) 3))))
      (case [4 5 6]
        (set! r (vcFromW (sha1Hash (vcW d) (conv uint32 (aget n 0)) (vcW m) (.-Sys in)))))
      (case [7]
        ;; sha1su0: op2<63:0>:op1<127:64> ^ op1 ^ op3
        (set! r (lit (array 2 uint64) (bit-xor (aget d 1) (aget d 0) (aget m 0)) (bit-xor (aget n 0) (aget d 1) (aget m 1)))))
      (case [8]
        (set! r (vcFromW (sha256Hash (vcW d) (vcW n) (vcW m) true))))
      (case [9]
        (set! r (vcFromW (sha256Hash (vcW n) (vcW d) (vcW m) false))))
      (case [10]
        ;; sha256su1: T0 = op3<31:0>:op2<127:32>, T1 = op3<127:64>, the upper two words from the lower two's results
        (let [(values x y z) (values (vcW d) (vcW n) (vcW m))
            t0 (lit (array 4 uint32) (aget y 1) (aget y 2) (aget y 3) (aget z 0))
            ^{:tag (array 4 uint32)} o (zero (array 4 uint32))]
          (aset o 0 (+ (sha256s1 (aget z 2)) (aget x 0) (aget t0 0)))
          (aset o 1 (+ (sha256s1 (aget z 3)) (aget x 1) (aget t0 1)))
          (aset o 2 (+ (sha256s1 (aget o 0)) (aget x 2) (aget t0 2)))
          (aset o 3 (+ (sha256s1 (aget o 1)) (aget x 3) (aget t0 3)))
          (set! r (vcFromW o))))
      (case [11]
        (set! r (lit (array 2 uint64) (conv uint64 (bits/RotateLeft32 (conv uint32 (aget n 0)) 30)) 0)))
      (case [12]
        ;; sha1su1: T = X ^ (Y >> 32)
        (let [(values x y) (values (vcW d) (vcW n))
            t (lit (array 4 uint32) (bit-xor (aget x 0) (aget y 1)) (bit-xor (aget x 1) (aget y 2)) (bit-xor (aget x 2) (aget y 3)) (aget x 3))]
          (set! r (vcFromW (lit (array 4 uint32) (bits/RotateLeft32 (aget t 0) 1) (bits/RotateLeft32 (aget t 1) 1) (bits/RotateLeft32 (aget t 2) 1) (bit-xor (bits/RotateLeft32 (aget t 3) 1) (bits/RotateLeft32 (aget t 0) 2)))))))
      (case [13]
        ;; sha256su0: T = op2<31:0>:op1<127:32>
        (let [(values x y) (values (vcW d) (vcW n))
            t (lit (array 4 uint32) (aget x 1) (aget x 2) (aget x 3) (aget y 0))
            ^{:tag (array 4 uint32)} o (zero (array 4 uint32))]
          (for [e 0] (< e 4) (inc! e)
            (let [v (aget t e)]
              (aset o e (+ (bit-xor (bits/RotateLeft32 v -7) (bits/RotateLeft32 v -18) (>> v 3)) (aget x e)))))

          (set! r (vcFromW o))))
      (case [14]
        ;; sha512h: X = V[n], Y = V[m], W = V[d]
        (let [hi (+ (bit-xor (bit-and (aget m 1) (aget n 0)) (bit-and (bit-not (aget m 1)) (aget n 1))) (sha512S1 (aget m 1)) (aget d 1))
            t (+ hi (aget m 0))
            lo (+ (bit-xor (bit-and t (aget m 1)) (bit-and (bit-not t) (aget n 0))) (sha512S1 t) (aget d 0))]
          (set! r (lit (array 2 uint64) lo hi))))
      (case [15]
        ;; sha512h2: X = V[n], Y = V[m], W = V[d]
        (let [hi (+ (bit-xor (bit-and (aget n 0) (aget m 1)) (bit-and (aget n 0) (aget m 0)) (bit-and (aget m 1) (aget m 0))) (sha512S0 (aget m 0)) (aget d 1))
            lo (+ (bit-xor (bit-and hi (aget m 0)) (bit-and hi (aget m 1)) (bit-and (aget m 1) (aget m 0))) (sha512S0 hi) (aget d 0))]
          (set! r (lit (array 2 uint64) lo hi))))
      (case [16]
        ;; sha512su1: X = V[n], Y = V[m], W = V[d]
        (set! r (lit (array 2 uint64) (+ (aget d 0) (sha512s1 (aget n 0)) (aget m 0)) (+ (aget d 1) (sha512s1 (aget n 1)) (aget m 1)))))
      (case [17]
        (set! r (lit (array 2 uint64) (bit-xor (aget n 0) (bits/RotateLeft64 (aget m 0) 1)) (bit-xor (aget n 1) (bits/RotateLeft64 (aget m 1) 1)))))
      (case [18]
        ;; sha512su0: W = V[d], op1 = V[n]
        (set! r (lit (array 2 uint64) (+ (aget d 0) (sha512s0 (aget d 1))) (+ (aget d 1) (sha512s0 (aget n 0))))))
      (case [19]
        (set! r (lit (array 2 uint64) (bit-xor (aget n 0) (aget m 0) (aget a 0)) (bit-xor (aget n 1) (aget m 1) (aget a 1)))))
      (case [20]
        (set! r (lit (array 2 uint64) (bit-xor (aget n 0) (bit-and-not (aget m 0) (aget a 0))) (bit-xor (aget n 1) (bit-and-not (aget m 1) (aget a 1))))))
      (case [21]
        (let [k (conv int (.-Imm in))]
          (set! r (lit (array 2 uint64) (bits/RotateLeft64 (bit-xor (aget n 0) (aget m 0)) (- k)) (bits/RotateLeft64 (bit-xor (aget n 1) (aget m 1)) (- k))))))
      (default
        (let [h 0]
          (when (.-Sf in)
            (set! h 1))

          (set! r (clmul64 (aget n h) (aget m h))))))

    (aset (.-Q c) (.-Rd in) r)))

(in-ns 'go.arbace.a64i) (go/file "claim.go" :imports [

    ^{:line 3} [sort "sort"]])






^{:go/end 34} (go/func Claimed "Claimed is the instructions a64i claims, as the coverage names them (Inst.Name and Inst.Family, \"NAME FAMILY\" each once,\nsorted; doc/asm/ARM64-SURVEY.md, \"As built: AR6\", ARS42 (b)): every word the decoder takes, its bits 10-31 enumerated\nwhole and its two low register fields (Rt or Rd, Rn) at three settings, so that a variant a register choice refuses\n(writeback onto the base, an exclusive's status register) is still met; the system class (bits 31-22 1101010100) with\nevery low field, where op2 and Rt pick the hints and barriers; the FP compares with their opcode2 (AR6). A name depends on no\nregister field.\n" ^{:tag (slice string)} []
  (let [seen (lit (map string bool))]
    (range [_ low (lit (slice uint32) (bit-or (<< 2 5) 1) (bit-or (<< 31 5) 31) 0)]
      (for [hi (conv uint32 0)] (< hi (<< 1 22)) (inc! hi)
        (let [(values in r) (Decode (bit-or (<< hi 10) low) 0)]
          (when (or (!= r "") (== (.-Op in) OpInvalid))
            (continue))

          (aset seen (+ (.Name in) " " (.Family in)) true))))


    (for [hi (conv uint32 0)] (< hi (<< 1 12)) (inc! hi)
      (for [low (conv uint32 0)] (< low (<< 1 10)) (inc! low)
        (when [(values in r) (Decode (bit-or (<< 0x354 22) (<< hi 10) low) 0)] (and (== r "") (!= (.-Op in) OpInvalid))
          (aset seen (+ (.Name in) " " (.Family in)) true))))

    ;; the FP compares (bits 31-24 0x1e), whose opcode2 is the low field: fcmp #0, fcmpe, fcmpe #0
    (for [hi (conv uint32 0)] (< hi (<< 1 14)) (inc! hi)
      (range [_ low (lit (slice uint32) 8 16 24)]
        (when [(values in r) (Decode (bit-or (<< 0x1e 24) (<< hi 10) low) 0)] (and (== r "") (!= (.-Op in) OpInvalid))
          (aset seen (+ (.Name in) " " (.Family in)) true))))



    (let [out (make (slice string) 0 (len seen))]
      (range [k seen]
        (set! out (append out k)))

      (sort/Strings out)
      ^{:line 33} out)))

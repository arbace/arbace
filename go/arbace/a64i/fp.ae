(in-ns 'go.arbace.a64i) (go/file "fp.go" :imports [


    ^{:line 4} [fmt "fmt"]
    ^{:line 5} [math "math"]
    ^{:line 6} [big "math/big"]
    ^{:line 7} [strconv "strconv"]
    ^{:line 8} [strings "strings"]])


;; The scalar floating point (doc/asm/ARM64-SURVEY.md, "As built: AR6"): the Arm ARM's FP data-processing classes (FP
;; data-processing with 1, 2 and 3 sources, compare, conditional compare and select, immediate, the conversions between FP
;; and integer and between precisions) at single and double precision, decoded, lowered from their forms and executed as the
;; pseudocode defines them (FPAdd, FPMul, FPMulAdd, FPDiv, FPSqrt, FPMax, FPMaxNum, FPCompare, FPRoundInt, FPToFixed,
;; FixedToFP, FPConvert; FPProcessNaNs, FPRound with FPCR's rounding mode, the exceptions accumulated in FPSR: IOC, DZC, OFC,
;; UFC with tininess before rounding, IXC). The exact values are math/big's; FPCR.DN's default NaN taken, FPCR.FZ (review 1111) refused
;; (:unimplemented; half precision is simdhalf's since AR15, queue 280); FEAT_AFP's FIZ, AH and NEP RES0, as on this VM's M2 (ARS71 (a), queue 276). Written from DDI 0487's pseudocode by Arbace; no code copied.


(go/const "The FP operations (after the integer core's).\n"
  ^{:line 21} [^{:tag Op :val 82} OpFMOV (+ opCount 1 iota)] ; fmov Vd, Vn
  ^{:line 22} [^{:val 83} OpFMOVI] ; fmov Vd, #imm (Imm: the value's bits)
  ^{:line 23} [^{:val 84} OpFMOVG] ; fmov between a general register and Vd (Ext 0: to FP, 1: to general)
  ^{:line 24} [^{:val 85} OpFP1] ; one source (Sys: 1 fabs, 2 fneg, 3 fsqrt, 8-15 frint*)
  ^{:line 25} [^{:val 86} OpFP2] ; two sources (Sys: 0 fmul, 1 fdiv, 2 fadd, 3 fsub, 4 fmax, 5 fmin, 6 fmaxnm, 7 fminnm, 8 fnmul)
  ^{:line 26} [^{:val 87} OpFP3] ; fmadd, fmsub, fnmadd, fnmsub (Sys: o1<<1 | o0)
  ^{:line 27} [^{:val 88} OpFCMP] ; fcmp, fcmpe (S), with zero (N)
  ^{:line 28} [^{:val 89} OpFCCMP] ; fccmp, fccmpe (S): Cond, Imm the NZCV otherwise
  ^{:line 29} [^{:val 90} OpFCSEL] ; fcsel: Cond
  ^{:line 30} [^{:val 91} OpFCVT] ; fcvt: Size the source's type, Amount the destination's
  ^{:line 31} [^{:val 92} OpCVTF] ; scvtf, ucvtf (Signed): from a general register of Sf's width
  ^{:line 32} [^{:val 93} OpFCVTI] ; fcvt[nzpma][su] (Signed; Sys the rounding: 0 N, 1 P, 2 M, 3 Z, 4 A): to a general register
  ^{:line 33} [^{:val 94} opFPEnd])


(go/var fpOpNames (lit (array ... string) "fmov" "fmovi" "fmovg" "fp1" "fp2" "fp3" "fcmp" "fccmp" "fcsel" "fcvt" "cvtf" "fcvti"))

^{:go/end 38} (go/func isFPOp ^bool [^Op o] (and (> o opCount) (< o opSIMDEnd)))

^{:go/end 45} (go/func fpOpName ^string [^Op o]
  (when (isSIMDOp o)
    (return (simdOpName o)))
  (when (isFPOp o)
    (return (aget fpOpNames (- o opCount 1))))

  (fmt/Sprintf "op%d" o))


(go/var fp1Names (lit (map int64 string) [1 "fabs"] [2 "fneg"] [3 "fsqrt"] [8 "frintn"] [9 "frintp"] [10 "frintm"] [11 "frintz"] [12 "frinta"] [14 "frintx"] [15 "frinti"]))
(go/var fp2Names (lit (array ... string) "fmul" "fdiv" "fadd" "fsub" "fmax" "fmin" "fmaxnm" "fminnm" "fnmul"))
(go/var fp3Names (lit (array ... string) "fmadd" "fmsub" "fnmadd" "fnmsub"))
(go/var rnds "npmza")

^{:go/end 54} (go/func fpType ^string [^uint8 sz]
  (aget (lit (map uint8 string) [1 "h"] [2 "s"] [3 "d"]) sz))



^{:go/end 115} (go/func fpName "fpName is an FP instruction's name for the coverage: the operation as the Arm ARM names it and its types.\n" ^string [^{:tag (* Inst)} in]
  (when [(values s ok) (fpNameJS in)] ok
    (return s))

  (when [(values s ok) (fpNameX in)] ok
    (return s))

  (when (isSIMDOp (.-Op in))
    (return (simdName in)))

  (let [t (fpType (.-Size in))
      ^{:line 62} w "w"]
    (when (.-Sf in)
      (set! w "x"))

    (switch (.-Op in)
      (case [OpFMOV]
        (return (+ "fmov." t)))
      (case [OpFMOVI]
        (return (+ "fmov.imm." t)))
      (case [OpFMOVG]
        (when (== (.-Ext in) 0)
          (return (+ "fmov." t "." w)))

        (return (+ "fmov." w "." t)))
      (case [OpFP1]
        (return (+ (aget fp1Names (conv int64 (.-Sys in))) "." t)))
      (case [OpFP2]
        (return (+ (aget fp2Names (.-Sys in)) "." t)))
      (case [OpFP3]
        (return (+ (aget fp3Names (.-Sys in)) "." t)))
      (case [OpFCMP OpFCCMP]
        (let [s (aget (lit (map Op string) [OpFCMP "fcmp"] [OpFCCMP "fccmp"]) (.-Op in))]
          (when (.-S in)
            (set! s + "e"))

          (when (.-N in)
            (set! s + ".zero"))

          (return (+ s "." t))))
      (case [OpFCSEL]
        (return (+ "fcsel." t)))
      (case [OpFCVT]
        (return (+ "fcvt." (fpType (.-Amount in)) "." t)))
      (case [OpCVTF]
        (let [s "ucvtf."]
          (when (.-Signed in)
            (set! s "scvtf."))

          (when (!= (.-Imm in) 0)
            (set! s + "fix."))

          (return (+ s t "." w))))
      (case [OpFCVTI]
        (let [s "u"]
          (when (.-Signed in)
            (set! s "s"))

          (when (!= (.-Imm in) 0)
            (set! s + ".fix"))

          (return (+ "fcvt" (conv string (aget rnds (.-Sys in))) s "." w "." t)))))

    (.String (.-Op in))))


;; ---------------------------------------------------------------------------------------------------------------------
;; decoding


^{:go/end 220} (go/func decodeFP "decodeFP is the scalar FP data-processing classes; the rest of the SIMD&FP space is :unimplemented simd.\n" [^uint32 w] :results [Inst string]
  ;; AR16: the M2's ARMv8.2-8.4 features (simdx.go)
  (when [(values in r ok) (decodeVX w)] ok
    (return in r))

  (when [(values in r ok) (decodeHalf w)] ok
    (return in r))

  ;; AR14: fcvt to and from half precision, fmov of the upper doubleword, and the rest of ARMv8.0's Advanced SIMD (simdest.go)
  (when [(values in r ok) (decodeVEST w)] ok
    (return in r))

  (when (and (== (bit-and w 0x5f000000) 0x1f000000) (== (>> w 31) 0) (== (bf w 29 29) 0))
    ;; FP data-processing (3 source)
    (let [ft (bf w 23 22)]
      (when (> ft 1)
        (return (lit Inst) ":unimplemented fp-half"))

      (return (lit Inst :Op OpFP3 :Size (+ (conv uint8 ft) 2) :Rd (conv uint8 (bf w 4 0)) :Rn (conv uint8 (bf w 9 5)) :Rm (conv uint8 (bf w 20 16)) :Ra (conv uint8 (bf w 14 10)) :Sys (bit-or (<< (bf w 21 21) 1) (bf w 15 15))) "")))

  (when (== (bit-and w 0x5f200000) 0x1e000000)
    ;; the conversions between FP and fixed-point (AR11, ARS61 (b)): simdfp.go's decodeFPFixed
    (return (decodeFPFixed w)))

  (when (or (!= (bit-and w 0x5f200000) 0x1e200000) (!= (bf w 29 29) 0))
    ;; the Advanced SIMD space (AR8): simd.go's decoder
    (return (decodeSIMD w)))

  (let [ft (bf w 23 22)
      (values rd rn rm) (values (conv uint8 (bf w 4 0)) (conv uint8 (bf w 9 5)) (conv uint8 (bf w 20 16)))
      ^{:line 126} sf (== (bf w 31 31) 1)]
    (when (== (bf w 15 10) 0)
      ;; conversion between FP and integer
      (let [(values rmode opc) (values (bf w 20 19) (bf w 18 16))]
        (switch
          (case [(or (== opc 6) (== opc 7))]
            ;; FMOV (general): opcode 110 to a general register, 111 to an FP one
            (switch
              (case [(== ft 3)]
                (return (lit Inst) ":unimplemented fp-half"))
              (case [(and (== ft 2) (== rmode 1) sf)]
                (return (lit Inst) ":unimplemented fmov-top"))
              (case [(or (!= rmode 0) (== ft 2) (== (== ft 0) sf))]
                (return (lit Inst) undef)))

            (let [ext (conv uint8 0)]
              (when (== opc 6)
                (set! ext 1))

              (return (lit Inst :Op OpFMOVG :Sf sf :Size (+ (conv uint8 ft) 2) :Rd rd :Rn rn :Ext ext) "")))
          (case [(> ft 1)]
            (return (lit Inst) ":unimplemented fp-half"))
          (case [(or (== opc 2) (== opc 3))]
            (when (!= rmode 0)
              (return (lit Inst) undef))

            (return (lit Inst :Op OpCVTF :Sf sf :Size (+ (conv uint8 ft) 2) :Rd rd :Rn rn :Signed (== opc 2)) ""))
          (case [(<= opc 1)]
            (return (lit Inst :Op OpFCVTI :Sf sf :Size (+ (conv uint8 ft) 2) :Rd rd :Rn rn :Signed (== opc 0) :Sys rmode) ""))
          (case [(or (== opc 4) (== opc 5))]
            (when (!= rmode 0)
              (return (lit Inst) undef))

            (return (lit Inst :Op OpFCVTI :Sf sf :Size (+ (conv uint8 ft) 2) :Rd rd :Rn rn :Signed (== opc 4) :Sys 4) "")))

        (return (lit Inst) undef)))

    (when sf
      (return (lit Inst) undef))

    (when (> ft 1)
      (when (== ft 3)
        (return (lit Inst) ":unimplemented fp-half"))

      (return (lit Inst) undef))

    (let [size (+ (conv uint8 ft) 2)]
      (switch
        (case [(== (bf w 14 10) 16)]
          ;; one source
          (let [opc (bf w 20 15)]
            (switch
              (case [(== opc 0)]
                (return (lit Inst :Op OpFMOV :Size size :Rd rd :Rn rn) ""))
              (case [(<= opc 3)]
                (return (lit Inst :Op OpFP1 :Size size :Rd rd :Rn rn :Sys opc) ""))
              (case [(or (== opc 4) (== opc 5))]
                (when (== (+ (conv uint8 (- opc 4)) 2) size)
                  (return (lit Inst) undef))

                (return (lit Inst :Op OpFCVT :Size size :Amount (+ (conv uint8 (- opc 4)) 2) :Rd rd :Rn rn) ""))
              (case [(== opc 7)]
                (return (lit Inst) ":unimplemented fp-half"))
              (case [(and (>= opc 8) (<= opc 15) (!= opc 13))]
                (return (lit Inst :Op OpFP1 :Size size :Rd rd :Rn rn :Sys opc) "")))

            (return (lit Inst) ":unimplemented fp1")))
        (case [(== (bf w 13 10) 8)]
          (when (or (!= (bf w 15 14) 0) (!= (bf w 2 0) 0))
            (return (lit Inst) undef))

          (let [o (bf w 4 3)
              ^{:line 198} in (lit Inst :Op OpFCMP :Size size :Rn rn :Rm rm :S (!= (bit-and o 2) 0) :N (!= (bit-and o 1) 0))]
            (when (.-N in)
              (set! (.-Rm in) 0))

            (return in "")))
        (case [(== (bf w 12 10) 4)]
          (when (!= (bf w 9 5) 0)
            (return (lit Inst) undef))

          (return (lit Inst :Op OpFMOVI :Size size :Rd rd :Imm (conv int64 (vfpExpandImm (bf w 20 13) size))) ""))
        (case [(== (bf w 11 10) 1)]
          (return (lit Inst :Op OpFCCMP :Size size :Rn rn :Rm rm :S (== (bf w 4 4) 1) :Cond (conv uint8 (bf w 15 12)) :Imm (conv int64 (bf w 3 0))) ""))
        (case [(== (bf w 11 10) 2)]
          (let [opc (bf w 15 12)]
            (when (> opc 8)
              (return (lit Inst) ":unimplemented fp2"))

            (return (lit Inst :Op OpFP2 :Size size :Rd rd :Rn rn :Rm rm :Sys opc) "")))
        (case [(== (bf w 11 10) 3)]
          (return (lit Inst :Op OpFCSEL :Size size :Rd rd :Rn rn :Rm rm :Cond (conv uint8 (bf w 15 12))) "")))

      (return (lit Inst) ":unimplemented fp"))))



^{:go/end 231} (go/func vfpExpandImm "vfpExpandImm is VFPExpandImm: the 8-bit immediate as the bits of a value of the type.\n" ^uint64 [^uint32 imm8 ^uint8 size]
  (let [(values s b6 frac) (values (conv uint64 (>> imm8 7)) (conv uint64 (bit-and (>> imm8 6) 1)) (conv uint64 (bit-and imm8 63)))]
    (when (== size 2)
      (let [e (bit-or (<< (- 1 b6) 7) (<< (* b6 31) 2) (conv uint64 (bit-and (>> imm8 4) 3)))]
        (return (bit-or (<< s 31) (<< e 23) (<< (bit-and frac 15) 19)))))

    (let [e (bit-or (<< (- 1 b6) 10) (<< (* b6 255) 2) (conv uint64 (bit-and (>> imm8 4) 3)))]
      (bit-or (<< s 63) (<< e 52) (<< (bit-and frac 15) 48)))))


;; ---------------------------------------------------------------------------------------------------------------------
;; the forms

^{:go/end 242} (go/func fpReg [^{:tag (* Sx)} o] :results [uint8 uint8 bool]
  (let [(values r sz ok) (asVReg o)]
    (when (or (not ok) (< sz 1) (> sz 3))
      (return 0 0 false))

    (return r sz true)))


^{:go/end 253} (go/func mustFPReg [^{:tag (* Sx)} o] :results [uint8 uint8]
  (let [(values r sz ok) (fpReg o)]
    (when (not ok)
      (ferr "not an FP register: %s" o))

    (when (== sz 1)
      (ferr "half precision: %s" o))

    (return r sz)))



^{:go/breaks [7] :go/end 279} (go/func fpConst "fpConst is an FP immediate's value: (imm X), (float \"TEXT\"), (- X), a number.\n" ^float64 [^{:tag (* Sx)} o]
  (when (not (.-IsList o))
    (when (strings/HasPrefix (.-Atom o) "\"")
      (let [(values v err) (strconv/ParseFloat (strings/Trim (.-Atom o) "\"") 64)]
        (when (!= err nil)
          (ferr "not a float: %s" o))

        (return v)))

    (return (conv float64 (value o))))

  (switch (.head o)
    (case ["imm"]
      (return (fpConst (aget (.-List o) 1))))
    (case ["float"]
      (return (fpConst (aget (.-List o) 1))))
    (case ["-"]
      (when (== (len (.-List o)) 2)
        (return (- (fpConst (aget (.-List o) 1)))))))


  (ferr "not an FP constant: %s" o)
  0)


^{:go/end 286} (go/func fpBits ^uint64 [^float64 v ^uint8 size]
  (when (== size 2)
    (return (conv uint64 (math/Float32bits (conv float32 v)))))

  (math/Float64bits v))



^{:go/end 386} (go/func lowerFP "lowerFP is the scalar FP instructions' forms.\n" [^string m ^{:tag (slice (* Sx))} ops] :results [Inst bool]
  (switch m
    (case ["fmov"]
      (nargs ops 2)
      (when [(values d sz ok) (fpReg (aget ops 0))] ok
        (when [(values n nsz ok) (fpReg (aget ops 1))] ok
          (when (!= nsz sz)
            (ferr "fmov types"))

          (return (lit Inst :Op OpFMOV :Size sz :Rd d :Rn n) true))

        (when [(values g ok) (asReg (aget ops 1))] ok
          (return (lit Inst :Op OpFMOVG :Sf (.-x g) :Size sz :Rd d :Rn (.-n g) :Ext 0) true))

        (return (lit Inst :Op OpFMOVI :Size sz :Rd d :Imm (conv int64 (fpBits (fpConst (aget ops 1)) sz))) true))

      (let [g (mustReg (aget ops 0))
          (values n sz) (mustFPReg (aget ops 1))]
        (return (lit Inst :Op OpFMOVG :Sf (.-x g) :Size sz :Rd (.-n g) :Rn n :Ext 1) true)))
    (case ["fabs" "fneg" "fsqrt" "frintn" "frintp" "frintm" "frintz" "frinta" "frintx" "frinti"]
      (nargs ops 2)
      (let [(values d sz) (mustFPReg (aget ops 0))
          (values n _) (mustFPReg (aget ops 1))]
        (range [k v fp1Names]
          (when (== v m)
            (return (lit Inst :Op OpFP1 :Size sz :Rd d :Rn n :Sys (conv uint32 k)) true)))))


    (case ["fmul" "fdiv" "fadd" "fsub" "fmax" "fmin" "fmaxnm" "fminnm" "fnmul"]
      (nargs ops 3)
      (let [(values d sz) (mustFPReg (aget ops 0))
          (values n _) (mustFPReg (aget ops 1))
          (values r _) (mustFPReg (aget ops 2))]
        (range [k v fp2Names]
          (when (== v m)
            (return (lit Inst :Op OpFP2 :Size sz :Rd d :Rn n :Rm r :Sys (conv uint32 k)) true)))))


    (case ["fmadd" "fmsub" "fnmadd" "fnmsub"]
      (nargs ops 4)
      (let [(values d sz) (mustFPReg (aget ops 0))
          (values n _) (mustFPReg (aget ops 1))
          (values r _) (mustFPReg (aget ops 2))
          (values a _) (mustFPReg (aget ops 3))]
        (range [k v fp3Names]
          (when (== v m)
            (return (lit Inst :Op OpFP3 :Size sz :Rd d :Rn n :Rm r :Ra a :Sys (conv uint32 k)) true)))))


    (case ["fcmp" "fcmpe"]
      (nargs ops 2)
      (let [(values n sz) (mustFPReg (aget ops 0))
          ^{:line 343} in (lit Inst :Op OpFCMP :Size sz :Rn n :S (== m "fcmpe"))]
        (if [(values r _ ok) (fpReg (aget ops 1))] ok
          (set! (.-Rm in) r)
          (do
            (when (!= (fpConst (aget ops 1)) 0)
              (ferr "fcmp with a constant other than 0"))

            (set! (.-N in) true)))

        (return in true)))
    (case ["fccmp" "fccmpe"]
      (nargs ops 4)
      (let [(values n sz) (mustFPReg (aget ops 0))
          (values r _) (mustFPReg (aget ops 1))]
        (return (lit Inst :Op OpFCCMP :Size sz :Rn n :Rm r :S (== m "fccmpe") :Imm (value (aget ops 2)) :Cond (condOf (aget ops 3))) true)))
    (case ["fcsel"]
      (nargs ops 4)
      (let [(values d sz) (mustFPReg (aget ops 0))
          (values n _) (mustFPReg (aget ops 1))
          (values r _) (mustFPReg (aget ops 2))]
        (return (lit Inst :Op OpFCSEL :Size sz :Rd d :Rn n :Rm r :Cond (condOf (aget ops 3))) true)))
    (case ["fcvt"]
      (nargs ops 2)
      (let [(values d dsz) (mustFPReg (aget ops 0))
          (values n nsz) (mustFPReg (aget ops 1))]
        (return (lit Inst :Op OpFCVT :Size nsz :Amount dsz :Rd d :Rn n) true)))
    (case ["scvtf" "ucvtf"]
      (nargs ops 2 3)
      (let [(values d sz) (mustFPReg (aget ops 0))
          ^{:line 372} g (mustReg (aget ops 1))]
        (return (lit Inst :Op OpCVTF :Sf (.-x g) :Size sz :Rd d :Rn (.-n g) :Signed (== m "scvtf") :Imm (fixedBits m ops (.-x g))) true))))

  (when (and (== (len m) 6) (strings/HasPrefix m "fcvt") (strings/ContainsRune "npmza" (conv rune (aget m 4))) ^:go/paren (or (== (aget m 5) \s) (== (aget m 5) \u)))
    (nargs ops 2 3)
    (let [g (mustReg (aget ops 0))
        (values n sz) (mustFPReg (aget ops 1))
        ^{:line 379} k (strings/IndexByte rnds (aget m 4))]
      (when (and (== (len ops) 3) (!= (aget m 4) \z))
        (ferr "%s with fraction bits" m))

      (return (lit Inst :Op OpFCVTI :Sf (.-x g) :Size sz :Rd (.-n g) :Rn n :Signed (== (aget m 5) \s) :Sys (conv uint32 k) :Imm (fixedBits m ops (.-x g))) true)))

  (return (lit Inst) false))


;; ---------------------------------------------------------------------------------------------------------------------
;; the values


(go/const "FPSR's cumulative exception bits.\n"
  ^{:line 388} [^{:val 1} fpIOC (<< 1 0)]
  ^{:line 389} [^{:val 2} fpDZC (<< 1 1)]
  ^{:line 390} [^{:val 4} fpOFC (<< 1 2)]
  ^{:line 391} [^{:val 8} fpUFC (<< 1 3)]
  ^{:line 392} [^{:val 16} fpIXC (<< 1 4)])


(go/type fpt (struct
    ^{:line 396 :tag uint} bits ^uint ebits ^uint fbits
    ^{:line 397 :tag int} emin))


^{:go/end 405} (go/func fmtOf ^fpt [^uint8 size]
  (when (== size 2)
    (return (lit fpt 32 8 23 -126)))

  (lit fpt 64 11 52 -1022))


^{:go/end 407} (go/method sign ^bool [^fpt t ^uint64 b] (== (bit-and (>> b (- (.-bits t) 1)) 1) 1))
^{:go/end 408} (go/method exp ^uint64 [^fpt t ^uint64 b] (bit-and (>> b (.-fbits t)) (- ^uint64 (<< 1 (.-ebits t)) 1)))
^{:go/end 411} (go/method frac ^uint64 [^fpt t ^uint64 b]
  (bit-and b (- ^uint64 (<< 1 (.-fbits t)) 1)))

^{:go/end 412} (go/method isNaN ^bool [^fpt t ^uint64 b] (and (== (.exp t b) (- ^uint64 (<< 1 (.-ebits t)) 1)) (!= (.frac t b) 0)))
^{:go/end 413} (go/method isSNaN ^bool [^fpt t ^uint64 b] (and (.isNaN t b) (== (bit-and (>> b (- (.-fbits t) 1)) 1) 0)))
^{:go/end 414} (go/method isInf ^bool [^fpt t ^uint64 b] (and (== (.exp t b) (- ^uint64 (<< 1 (.-ebits t)) 1)) (== (.frac t b) 0)))
^{:go/end 415} (go/method isZero ^bool [^fpt t ^uint64 b] (and (== (.exp t b) 0) (== (.frac t b) 0)))
^{:go/end 418} (go/method quiet ^uint64 [^fpt t ^uint64 b]
  (bit-or b ^uint64 (<< 1 (- (.-fbits t) 1))))

^{:go/end 421} (go/method defaultNaN ^uint64 [^fpt t]
  (bit-or (<< (- ^uint64 (<< 1 (.-ebits t)) 1) (.-fbits t)) ^uint64 (<< 1 (- (.-fbits t) 1))))

^{:go/end 428} (go/method inf ^uint64 [^fpt t ^bool neg]
  (let [b (<< (conv uint64 (- ^uint64 (<< 1 (.-ebits t)) 1)) (.-fbits t))]
    (when neg
      (set! b bit-or ^uint64 (<< 1 (- (.-bits t) 1))))

    ^{:line 427} b))

^{:go/breaks [[4 433]] :go/end 434} (go/method zero ^uint64 [^fpt t ^bool neg]
  (when neg
    (return ^uint64 (<< 1 (- (.-bits t) 1))))

  0)

^{:go/end 437} (go/method max ^uint64 [^fpt t ^bool neg]
  (- (.inf t neg) 1))

^{:go/end 438} (go/method neg ^uint64 [^fpt t ^uint64 b] (bit-xor b ^uint64 (<< 1 (- (.-bits t) 1))))


^{:go/end 480} (go/method exact "exact is a finite value as a big.Float (exactly).\n" ^{:tag (* big/Float)} [^fpt t ^uint64 b]
  (when (== (.-bits t) 16)
    (return (.SetFloat64 (.SetPrec (new big/Float) 0) (halfValue b))))

  (let [^float64 f (zero float64)]
    (if (== (.-bits t) 32)
      (set! f (conv float64 (math/Float32frombits (conv uint32 b))))

      (set! f (math/Float64frombits b)))

    (.SetFloat64 (.SetPrec (new big/Float) 0) f)))


;; the exact values' precision: an FMA's addend at the largest exponent and its product at the smallest (2^1024 to 2^-2148) are
;; exact at 3,200 bits; 2,400 lost FMADD's and FMLA's inexact low part (review 1111 (4))
(go/const ^{:val 3328} prec 3328)

^{:go/end 453} (go/func hp ^{:tag (* big/Float)} [] (.SetPrec (new big/Float) prec))




(in-ns 'go.arbace.a64i) (go/file "decode.go" :imports [

    ^{:line 3} [bits "math/bits"]])

^{:go/end 5} (go/func bf ^uint32 [^uint32 w ^uint hi ^uint lo] (bit-and (>> w lo) (- ^uint32 (<< 1 (+ (- hi lo) 1)) 1)))

^{:go/end 7} (go/func sext ^int64 [^uint64 v ^uint n] (>> (conv int64 (<< v (- 64 n))) (- 64 n)))



^{:go/end 43} (go/func DecodeBitMasks "DecodeBitMasks is the Arm ARM's DecodeBitMasks for a logical immediate (immediate true): the mask, false when the\nencoding is reserved.\n" [^uint32 n ^uint32 imms ^uint32 immr ^bool sf] :results [uint64 bool]
  (let [x (bit-or (<< n 6) (bit-and (bit-not imms) 0x3f))]
    (when (== x 0)
      (return 0 false))

    (let [l (conv uint (- 31 (bits/LeadingZeros32 x)))]
      (when (or (< l 1) ^:go/paren (and (not sf) (> l 5)))
        (return 0 false))

      (let [size (<< (conv uint 1) l)
          ^{:line 21} levels (conv uint32 (- size 1))
          (values s r) (values (bit-and imms levels) (bit-and immr levels))]
        (when (== s levels)
          (return 0 false))

        (let [welem (- (<< (conv uint64 1) (+ s 1)) 1)
            ^{:line 27} emask (- (<< (conv uint64 1) size) 1)]
          (when (== size 64)
            (set! emask (bit-not (conv uint64 0))))

          (let [elem (bit-and (bit-or (>> welem r) (<< welem (% (- (conv uint32 size) r) (conv uint32 size)))) emask)]
            (when (== r 0)
              (set! elem welem))

            (let [out (conv uint64 0)]
              (for [i (conv uint 0)] (< i 64) (set! i + size)
                (set! out bit-or (<< elem i)))

              (when (not sf)
                (set! out bit-and 0xffffffff))

              (return out true))))))))




^{:go/end 63} (go/func Decode "Decode is the instruction word w at pc: its Inst, or OpInvalid with the reason (\":undefined\" for an unallocated\nencoding, \":unimplemented NAME\" for one a64i does not run: SIMD and floating point, SVE, pointer authentication, ...).\n" [^uint32 w ^uint64 pc] :results [Inst string]
  (switch
    (case [(== (bf w 28 26) 4)]
      (return (decodeDPImm w pc)))
    (case [(== (bf w 28 26) 5)]
      (return (decodeBranch w pc)))
    (case [(and (== (bf w 27 27) 1) (== (bf w 25 25) 0))]
      (return (decodeLdSt w pc)))
    (case [(== (bf w 27 25) 5)]
      (return (decodeDPReg w)))
    (case [(== (bf w 27 25) 7)]
      (return (decodeFP w)))
    (case [(== (>> w 16) 0)]
      (return (lit Inst :Op OpUDF :Imm (conv int64 (bit-and w 0xffff))) "")))

  (return (lit Inst) ":undefined"))


(go/var undef ":undefined")

^{:go/end 132} (go/func decodeDPImm [^uint32 w ^uint64 pc] :results [Inst string]
  (let [sf (== (bf w 31 31) 1)
      (values rd rn) (values (conv uint8 (bf w 4 0)) (conv uint8 (bf w 9 5)))]
    (switch (bf w 25 23)
      (case [0 1]
        (let [imm (sext (conv uint64 (bit-or (<< (bf w 23 5) 2) (bf w 30 29))) 21)]
          (when (== (bf w 31 31) 0)
            (return (lit Inst :Op OpADR :Sf true :Rd rd :Target (+ pc (conv uint64 imm))) ""))

          (return (lit Inst :Op OpADRP :Sf true :Rd rd :Target (+ (bit-and-not pc 0xfff) (conv uint64 (<< imm 12)))) "")))
      (case [2]
        (let [imm (<< (conv int64 (bf w 21 10)) (* 12 (bf w 22 22)))
            ^{:line 79} op OpADDI]
          (when (== (bf w 30 30) 1)
            (set! op OpSUBI))

          (return (lit Inst :Op op :Sf sf :S (== (bf w 29 29) 1) :Rd rd :Rn rn :Imm imm) "")))
      (case [3]
        (return (lit Inst) ":unimplemented addg"))
      (case [4]
        (let [(values m ok) (DecodeBitMasks (bf w 22 22) (bf w 15 10) (bf w 21 16) sf)]
          (when (not ok)
            (return (lit Inst) undef))

          (let [in (lit Inst :Sf sf :Rd rd :Rn rn :Imm (conv int64 m))]
            (switch (bf w 30 29)
              (case [0]
                (set! (.-Op in) OpANDI))
              (case [1]
                (set! (.-Op in) OpORRI))
              (case [2]
                (set! (.-Op in) OpEORI))
              (case [3]
                (set! (values (.-Op in) (.-S in)) (values OpANDI true))))

            (return in ""))))
      (case [5]
        (let [hw (bf w 22 21)]
          (when (and (not sf) (>= hw 2))
            (return (lit Inst) undef))

          (let [in (lit Inst :Sf sf :Rd rd :Imm (conv int64 (bf w 20 5)) :Amount (conv uint8 (* hw 16)))]
            (switch (bf w 30 29)
              (case [0]
                (set! (.-Op in) OpMOVN))
              (case [2]
                (set! (.-Op in) OpMOVZ))
              (case [3]
                (set! (.-Op in) OpMOVK))
              (default
                (return (lit Inst) undef)))

            (return in ""))))
      (case [6]
        (when (or (!= (bf w 22 22) (bf w 31 31)) (== (bf w 30 29) 3) ^:go/paren (and (not sf) ^:go/paren (or (>= (bf w 21 16) 32) (>= (bf w 15 10) 32))))
          (return (lit Inst) undef))

        (return (lit Inst :Op (aget (lit (slice Op) OpSBFM OpBFM OpUBFM) (bf w 30 29)) :Sf sf :Rd rd :Rn rn :Imm (conv int64 (bf w 21 16)) :Imm2 (conv int64 (bf w 15 10))) ""))
      (case [7]
        (when (or (!= (bf w 30 29) 0) (!= (bf w 22 22) (bf w 31 31)) (!= (bf w 21 21) 0) ^:go/paren (and (not sf) (== (bf w 15 15) 1)))
          (return (lit Inst) undef))

        (return (lit Inst :Op OpEXTR :Sf sf :Rd rd :Rn rn :Rm (conv uint8 (bf w 20 16)) :Imm (conv int64 (bf w 15 10))) "")))

    (return (lit Inst) undef)))


^{:go/end 188} (go/func decodeBranch [^uint32 w ^uint64 pc] :results [Inst string]
  (let [rt (conv uint8 (bf w 4 0))]
    (switch
      (case [(== (bf w 31 24) 0x54)]
        (when (!= (bf w 4 4) 0)
          (return (lit Inst) ":unimplemented bc.cond"))

        (return (lit Inst :Op OpBCOND :Cond (conv uint8 (bf w 3 0)) :Target (+ pc (conv uint64 (sext (<< (conv uint64 (bf w 23 5)) 2) 21)))) ""))
      (case [(== (bf w 31 24) 0xd4)]
        (let [(values opc ll imm) (values (bf w 23 21) (bf w 1 0) (conv int64 (bf w 20 5)))]
          (switch
            (case [(and (== opc 0) (== ll 1) (== (bf w 4 2) 0))]
              (return (lit Inst :Op OpSVC :Imm imm) ""))
            (case [(and (== opc 1) (== ll 0) (== (bf w 4 2) 0))]
              (return (lit Inst :Op OpBRK :Imm imm) "")))

          (return (lit Inst) ":unimplemented exception")))
      (case [(== (bf w 31 22) 0x354)]
        (return (decodeSystem w)))
      (case [(== (bf w 31 25) 0x6b)]
        (let [(values opc op2 op3 op4 rn) (values (bf w 24 21) (bf w 20 16) (bf w 15 10) (bf w 4 0) (conv uint8 (bf w 9 5)))]
          (when (or (!= op2 31) (!= op3 0) (!= op4 0))
            (return (lit Inst) ":unimplemented branch-register"))

          (switch opc
            (case [0]
              (return (lit Inst :Op OpBR :Rn rn) ""))
            (case [1]
              (return (lit Inst :Op OpBLR :Rn rn) ""))
            (case [2]
              (return (lit Inst :Op OpRET :Rn rn) "")))

          (return (lit Inst) ":unimplemented branch-register")))
      (case [(== (bf w 30 26) 5)]
        (let [op OpB]
          (when (== (bf w 31 31) 1)
            (set! op OpBL))

          (return (lit Inst :Op op :Target (+ pc (conv uint64 (sext (<< (conv uint64 (bf w 25 0)) 2) 28)))) "")))
      (case [(== (bf w 30 25) 0x1a)]
        (let [op OpCBZ]
          (when (== (bf w 24 24) 1)
            (set! op OpCBNZ))

          (return (lit Inst :Op op :Sf (== (bf w 31 31) 1) :Rd rt :Target (+ pc (conv uint64 (sext (<< (conv uint64 (bf w 23 5)) 2) 21)))) "")))
      (case [(== (bf w 30 25) 0x1b)]
        (let [op OpTBZ]
          (when (== (bf w 24 24) 1)
            (set! op OpTBNZ))

          (let [b (bit-or (<< (bf w 31 31) 5) (bf w 23 19))]
            (return (lit Inst :Op op :Sf (>= b 32) :Rd rt :Imm (conv int64 b) :Target (+ pc (conv uint64 (sext (<< (conv uint64 (bf w 18 5)) 2) 16)))) "")))))

    (return (lit Inst) undef)))


^{:go/end 211} (go/func decodeSystem [^uint32 w] :results [Inst string]
  (let [(values l op0 op1 crn crm op2 rt) (values (bf w 21 21) (bf w 20 19) (bf w 18 16) (bf w 15 12) (bf w 11 8) (bf w 7 5) (conv uint8 (bf w 4 0)))]
    (switch
      (case [(and (== l 0) (== op0 0) (== op1 3) (== crn 2) (== rt 31))]
        (return (lit Inst :Op OpHINT :Sys (bit-or (<< crm 3) op2)) ""))
      (case [(and (== l 0) (== op0 0) (== op1 3) (== crn 3) (== rt 31))]
        (switch op2
          (case [2]
            (return (lit Inst :Op OpCLREX :Sys crm) ""))
          (case [4 5 6]
            (return (lit Inst :Op OpBARRIER :Sys (bit-or (<< op2 4) crm)) "")))

        (return (lit Inst) ":unimplemented barrier"))
      (case [(>= op0 2)]
        (let [op OpMSR]
          (when (== l 1)
            (set! op OpMRS))

          (return (lit Inst :Op op :Rd rt :Sys (bit-or (<< op0 14) (<< op1 11) (<< crn 7) (<< crm 3) op2)) ""))))

    (return (lit Inst) ":unimplemented system")))


^{:go/end 373} (go/func decodeLdSt [^uint32 w ^uint64 pc] :results [Inst string]
  (let [size (conv uint8 (bf w 31 30))
      (values rt rn) (values (conv uint8 (bf w 4 0)) (conv uint8 (bf w 9 5)))
      ^{:line 216} v (== (bf w 26 26) 1)]
    (switch
      (case [(== (bf w 29 24) 0x08)]
        (let [(values o2 l o1 rs o0 rt2) (values (bf w 23 23) (bf w 22 22) (bf w 21 21) (conv uint8 (bf w 20 16)) (bf w 15 15) (conv uint8 (bf w 14 10)))]
          (switch
            (case [(and (== o2 0) (== o1 0))]
              (when (== l 1)
                (return (lit Inst :Op OpLDXR :Size size :Rd rt :Rn rn :Acq (== o0 1)) ""))

              (return (lit Inst :Op OpSTXR :Size size :Rm rs :Rd rt :Rn rn :Rel (== o0 1)) ""))
            (case [(and (== o2 0) (== o1 1) (>= size 2))]
              (when (== l 1)
                (return (lit Inst :Op OpLDXR :Size size :Rd rt :Ra rt2 :Rn rn :Pair true :Acq (== o0 1)) ""))

              (return (lit Inst :Op OpSTXR :Size size :Rm rs :Rd rt :Ra rt2 :Rn rn :Pair true :Rel (== o0 1)) ""))
            (case [(and (== o2 0) (== o1 1) (== rt2 31))]
              (return (lit Inst :Op OpCASP :Size (+ size 2) :Rm rs :Rd rt :Rn rn :Acq (== l 1) :Rel (== o0 1)) ""))
            (case [(and (== o2 1) (== o1 0) (== o0 1))]
              (when (== l 1)
                (return (lit Inst :Op OpLDAR :Size size :Rd rt :Rn rn :Acq true) ""))

              (return (lit Inst :Op OpSTLR :Size size :Rd rt :Rn rn :Rel true) ""))
            (case [(and (== o2 1) (== o1 1) (== rt2 31))]
              (return (lit Inst :Op OpCAS :Size size :Rm rs :Rd rt :Rn rn :Acq (== l 1) :Rel (== o0 1)) "")))

          (return (lit Inst) ":unimplemented ldst-ordered")))
      (case [(and (== (bf w 29 27) 3) (== (bf w 25 24) 0))]
        (let [t (+ pc (conv uint64 (sext (<< (conv uint64 (bf w 23 5)) 2) 21)))]
          (when v
            (when (== (bf w 31 30) 3)
              (return (lit Inst) undef))

            (return (lit Inst :Op OpLDRLIT :Vreg true :Size (+ (conv uint8 (bf w 31 30)) 2) :Rd rt :Target t) ""))

          (switch (bf w 31 30)
            (case [0]
              (return (lit Inst :Op OpLDRLIT :Size 2 :Rd rt :Target t) ""))
            (case [1]
              (return (lit Inst :Op OpLDRLIT :Size 3 :Sf true :Rd rt :Target t) ""))
            (case [2]

            (when (== (bit-and opc 1) 1)
              (set! (.-Op in) OpLDR))

            (set! size (.-Size in)))

          (when (and (== (bf w 25 24) 0) (== (bf w 21 21) 1) (== (bf w 11 10) 0))
            (let [(values a r rs o3 op) (values (== (bf w 23 23) 1) (== (bf w 22 22) 1) (conv uint8 (bf w 20 16)) (bf w 15 15) (bf w 14 12))]
              (switch
                (case [(== o3 0)]

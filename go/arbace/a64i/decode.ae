        (return (lit Inst :Op (aget (lit (slice Op) OpCSEL OpCSINC OpCSINV OpCSNEG) (bit-or (<< (bf w 30 30) 1) (bf w 10 10))) :Sf sf :Rd rd :Rn rn :Rm rm :Cond (conv uint8 (bf w 15 12))) ""))
      (case [(== op2 6)]
        (when (!= (bf w 29 29) 0)
          (return (lit Inst) undef))

        (let [opc (bf w 15 10)]
          (when (== (bf w 30 30) 1)
            (when (!= rm 0)
              (return (lit Inst) ":unimplemented dp1"))

            (let [in (lit Inst :Sf sf :Rd rd :Rn rn)]

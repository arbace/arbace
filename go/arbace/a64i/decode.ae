            (return (lit Inst :Op op :Sf sf :S (== (bf w 29 29) 1) :Rd rd :Rn rn :Rm rm :Ext (conv uint8 (bf w 15 13)) :Amount (conv uint8 (bf w 12 10))) "")))))



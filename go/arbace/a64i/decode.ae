          (set! (.-Sf in) (and (not v) ^:go/paren (or (== size 3) (.-Wide in))))
          (switch
            (case [(== (bf w 25 24) 1)]
              (set! (values (.-Mode in) (.-Imm in)) (values ModeOff (<< (conv int64 (bf w 21 10)) size))))
            (case [(== (bf w 21 21) 0)]
              (set! (.-Imm in) (sext (conv uint64 (bf w 20 12)) 9))
              (switch (bf w 11 10)
                (case [0 2]
                  (set! (.-Mode in) ModeOff))
                (case [1]
                  (set! (.-Mode in) ModePost))
                (case [3]
                  (set! (.-Mode in) ModePre)))

              (when (and (== (.-Op in) OpPRFM) (!= (.-Mode in) ModeOff))

^{:go/end 530} (go/func decodeDPReg [^uint32 w] :results [Inst string]
  (let [sf (== (bf w 31 31) 1)
      (values rd rn rm) (values (conv uint8 (bf w 4 0)) (conv uint8 (bf w 9 5)) (conv uint8 (bf w 20 16)))
      ^{:line 378} op1 (bf w 28 28)
      ^{:line 379} op2 (bf w 24 21)]
    (when (== op1 0)
      (switch
        (case [(== (bit-and op2 8) 0)]
          (when (and (not sf) (== (bf w 15 15) 1))
            (return (lit Inst) undef))

          (let [in (lit Inst :Sf sf :Rd rd :Rn rn :Rm rm :Shift (conv uint8 (bf w 23 22)) :Amount (conv uint8 (bf w 15 10)) :N (== (bf w 21 21) 1))]
            (switch (bf w 30 29)
              (case [0]
                (set! (.-Op in) OpAND))
              (case [1]
                (set! (.-Op in) OpORR))
              (case [2]
                (set! (.-Op in) OpEOR))
              (case [3]
                (set! (values (.-Op in) (.-S in)) (values OpAND true))))

            (return in "")))
        (case [(== (bit-and op2 1) 0)]
          (when (or (== (bf w 23 22) 3) ^:go/paren (and (not sf) (== (bf w 15 15) 1)))
            (return (lit Inst) undef))

          (let [op OpADDR]
            (when (== (bf w 30 30) 1)
              (set! op OpSUBR))

            (return (lit Inst :Op op :Sf sf :S (== (bf w 29 29) 1) :Rd rd :Rn rn :Rm rm :Shift (conv uint8 (bf w 23 22)) :Amount (conv uint8 (bf w 15 10))) "")))
        (default

          (return (lit Inst :Op OpPRFM :Rd rt :Target t :Size 3) "")))
      (case [(== (bf w 29 27) 5)]
        (let [(values opc mode l) (values (bf w 31 30) (bf w 25 23) (bf w 22 22))
            ^{:line 261} in (lit Inst :Rd rt :Ra (conv uint8 (bf w 14 10)) :Rn rn)]
          (switch
            (case [(and v (< opc 3))]
              (set! (values (.-Size in) (.-Vreg in)) (values (+ (conv uint8 opc) 2) true)))
            (case [(== opc 0)]
              (set! (.-Size in) 2))
            (case [(== opc 2)]
              (set! (values (.-Size in) (.-Sf in)) (values 3 true)))
            (case [(and (== opc 1) (== l 1))]
              (set! (values (.-Size in) (.-Sf in) (.-Signed in) (.-Wide in)) (values 2 true true true)))

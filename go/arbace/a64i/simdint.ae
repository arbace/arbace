    (when (and (not (.-Sf in)) (not (.-S in)) (!= k 14) (!= (vintClass k) "diff") (!= (vintClass k) "shrn"))
      (aset r 1 0))

    (when sat
      (set! (.-FPSR c) bit-or fpQC))

    (aset (.-Q c) (.-Rd in) r)))

                    (setLane (addr r) i w (bit-and v (emask w))))))))

          (case [(== k 14)]
            (let [hi 0]
              (when (.-Sf in)
                (set! hi (/ 64 (conv int e))))

              (for [i 0] (< i (/ 64 (conv int e))) (inc! i)
                (setLane (addr r) i (* 2 e) (<< (lane a (+ i hi) e) e)))))

          (default
            (for [i 0] (< i n) (inc! i)
              (let [x (lane a i e)
                  ^{:line 358 :tag (* big/Int)} v (zero (* big/Int))
                  ^{:line 359} unsigned false]
                (switch nm
                  (case ["suqadd"]
                    (set! v (laneInt x e false))
                    (.Add v v (laneInt (lane d i e) e true)))
                  (case ["usqadd"]
                    (set! v (laneInt x e true))
                    (.Add v v (laneInt (lane d i e) e false))
                    (set! unsigned true))
                  (case ["sqabs"]
                    (set! v (laneInt x e true))
                    (.Abs v v))

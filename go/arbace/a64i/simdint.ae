(go/var ^{:doc "AR13 (ARS66 (c)): NEON's remaining integer lanes, OpVINT. Sys is vintNames' index, its class by range: 0-2 three same\n(srshl, urshl: Size the element's, S the scalar d; pmul: bytes), 3-5 three different (raddhn, rsubhn: Size the narrow\ndestination's; pmull: Size the sources', bytes only), 6-14 two-register miscellaneous (saddlp, uaddlp, sadalp, uadalp: Size\nthe sources'; suqadd, usqadd, sqabs, sqneg: Size the element's, S the scalar form, FPSR.QC set when a lane saturates; shll:\nSize the sources'), 15 the shift by immediate rshrn (Size the narrow destination's, Imm the right shift), 16 the scalar\npairwise addp (d from 2d). Sf is Q (the 2 forms of the long and narrow ones). pmull's 1q from 1d (FEAT_PMULL) is not claimed\n(a64i claims no feature beyond ARMv8.0's Advanced SIMD): it stays :unimplemented simd.\n"} vintNames (lit (array ... string) "srshl" "urshl" "pmul" "raddhn" "rsubhn" "pmull" "saddlp" "uaddlp" "sadalp" "uadalp" "suqadd" "usqadd" "sqabs" "sqneg" "shll" "rshrn" "addp"))


^{:go/breaks [[5 29]] :go/end 30} (go/func vintClass "vintClass is a vintNames index's class: \"same\", \"diff\", \"misc\", \"shrn\", \"pair\".\n" ^string [^uint32 k]
  (switch
    (case [(<= k 2)]
      (return "same"))
    (case [(<= k 5)]
      (return "diff"))
    (case [(<= k 14)]
      (return "misc"))
    (case [(== k 15)]
      (return "shrn")))

  "pair")



^{:go/end 35} (go/func vintTwo "vintTwo is whether the instruction has a 2 form (the long and narrow ones: raddhn, rsubhn, pmull, shll, rshrn).\n" ^bool [^uint32 k]
  (or ^:go/paren (and (>= k 3) (<= k 5)) (== k 14) (== k 15)))





^{:go/end 138} (go/func decodeVINT "decodeVINT is the instructions' words: three same (opcodes 01010, U 1 10011), three different (U 1 0100, U 1 0110, U 0 1110),\ntwo-register miscellaneous (00010, 00110, 00011, 00111, U 1 10011), shift by immediate (U 0 10001), scalar pairwise (U 0\n11011), vector and scalar; false when the word is another instruction (or unallocated: the caller refuses it).\n" [^uint32 w] :results [Inst string bool]
  (when (!= (bf w 31 31) 0)
    (return (lit Inst) "" false))

  (let [(values q u size) (values (== (bf w 30 30) 1) (bf w 29 29) (bf w 23 22))
      ^{:line 45} scalar (== (bf w 28 28) 1)]
    (when (and scalar (not q))
      (return (lit Inst) "" false))

    (let [(values rd rn rm) (values (conv uint8 (bf w 4 0)) (conv uint8 (bf w 9 5)) (conv uint8 (bf w 20 16)))]
      (switch
        (case [(and (== (bf w 27 24) 14) (== (bf w 21 21) 1) (== (bf w 10 10) 1))]
          (switch [opc (bf w 15 11)]
            (case [(== opc 10)]
              (when scalar
                (when (!= size 3)
                  (return (lit Inst) "" false))

                (return (lit Inst :Op OpVINT :S true :Size 3 :Rd rd :Rn rn :Rm rm :Sys u) "" true))

              (when (and (== size 3) (not q))
                (return (lit Inst) undef true))

              (return (lit Inst :Op OpVINT :Sf q :Size (conv uint8 size) :Rd rd :Rn rn :Rm rm :Sys u) "" true))
            (case [(and (== opc 19) (== u 1) (not scalar))]
              (when (!= size 0)
                (return (lit Inst) undef true))

              (return (lit Inst :Op OpVINT :Sf q :Rd rd :Rn rn :Rm rm :Sys 2) "" true))))

        (case [(and (not scalar) (== (bf w 27 24) 14) (== (bf w 21 21) 1) (== (bf w 11 10) 0))]
          (let [k (conv uint32 0)]
            (switch [opc (bf w 15 12)]
              (case [(and (== opc 4) (== u 1))]
                (set! k 3))
              (case [(and (== opc 6) (== u 1))]
                (set! k 4))
              (case [(and (== opc 14) (== u 0))]
                (set! k 5))
              (default
                (return (lit Inst) "" false)))

            (cond (== k 5)
              (switch size
                (case [0])
                (case [3]
                  (return (lit Inst) unimpSIMD true))
                (default
                  (return (lit Inst) undef true)))

              (== size 3)
              (return (lit Inst) undef true))

            (return (lit Inst :Op OpVINT :Sf q :Size (conv uint8 size) :Rd rd :Rn rn :Rm rm :Sys k) "" true)))
        (case [(and (== (bf w 27 24) 14) (== (bf w 21 17) 16) (== (bf w 11 10) 2))]
          (let [k (conv uint32 0)]
            (switch [opc (bf w 16 12)]
              (case [(== opc 2)]
                (set! k (+ 6 u)))
              (case [(== opc 6)]
                (set! k (+ 8 u)))
              (case [(== opc 3)]
                (set! k (+ 10 u)))
              (case [(== opc 7)]
                (set! k (+ 12 u)))
              (case [(and (== opc 19) (== u 1))]
                (set! k 14))
              (default
                (return (lit Inst) "" false)))

            (when scalar
              (when (or (< k 10) (> k 13))
                (return (lit Inst) "" false))

              (return (lit Inst :Op OpVINT :S true :Size (conv uint8 size) :Rd rd :Rn rn :Sys k) "" true))

            (when (or ^:go/paren (and (>= k 10) (<= k 13) (== size 3) (not q)) ^:go/paren (and ^:go/paren (or (< k 10) (== k 14)) (== size 3)))
              (return (lit Inst) undef true))

            (return (lit Inst :Op OpVINT :Sf q :Size (conv uint8 size) :Rd rd :Rn rn :Sys k) "" true)))
        (case [(and (not scalar) (== u 0) (== (bf w 27 23) 30) (!= (bf w 22 19) 0) (== (bf w 15 11) 17) (== (bf w 10 10) 1))]
          (let [(values immh immb) (values (bf w 22 19) (bf w 18 16))]
            (when (>= immh 8)
              (return (lit Inst) undef true))

            (let [hb (conv uint32 0)]
              (while (!= (>> immh (+ hb 1)) 0)
                (inc! hb))

              (let [e (<< (conv int64 8) hb)]
                (return (lit Inst :Op OpVINT :Sf q :Size (conv uint8 hb) :Rd rd :Rn rn :Imm (- (* 2 e) (conv int64 (bit-or (<< immh 3) immb))) :Sys 15) "" true)))))
        (case [(and scalar (== u 0) (== (bf w 27 24) 14) (== (bf w 21 17) 24) (== (bf w 16 12) 27) (== (bf w 11 10) 2))]
          (when (!= size 3)
            (return (lit Inst) undef true))

          (return (lit Inst :Op OpVINT :S true :Size 3 :Rd rd :Rn rn :Sys 16) "" true)))

      (return (lit Inst) "" false))))





^{:go/end 247} (go/func lowerVINT "lowerVINT is their forms: srshl v0.4s, v1.4s, v2.4s; urshl d0, d1, d2; pmul v0.16b, v1.16b, v2.16b; raddhn2 v0.16b, v1.8h,\nv2.8h; pmull v0.8h, v1.8b, v2.8b; saddlp v0.4h, v1.8b; uadalp v0.2d, v1.4s; sqabs v0.8h, v1.8h; suqadd b0, b1; shll2 v0.4s,\nv1.8h, #16; rshrn v0.8b, v1.8h, #3; addp d0, v1.2d. false for another mnemonic.\n" [^string m ^{:tag (slice (* Sx))} ops] :results [Inst bool]
  (let [base (strings/TrimSuffix m "2")
      ^{:line 145} two (!= base m)
      ^{:line 146} k -1]
    (range [i n vintNames]
      (when (and (== n base) ^:go/paren (or (not two) (vintTwo (conv uint32 i))))
        (set! k i)))


    (when (or (< k 0) (< (len ops) 2) (> (len ops) 3))
      (return (lit Inst) false))

    (let [(values d dok) (asVec (aget ops 0))
        (values n nok) (asVec (aget ops 1))]
      (when (or (not dok) (not nok) (== (.-kind d) \e) (== (.-kind n) \e))
        (return (lit Inst) false))

      (let [kk (conv uint32 k)]
        (switch (vintClass kk)
          (case ["same"]
            (when (!= (len ops) 3)
              (return (lit Inst) false))

            (let [(values x xok) (asVec (aget ops 2))]
              (when (or (not xok) (!= (.-kind d) (.-kind n)) (!= (.-kind n) (.-kind x)) (!= (.-size d) (.-size n)) (!= (.-size n) (.-size x)) (!= (.-q d) (.-q n)) (!= (.-q n) (.-q x)))
                (return (lit Inst) false))

              (when (== (.-kind d) \s)
                (when (or (== kk 2) (!= (.-size d) 3))
                  (ferr "%s of %s" m (conv string (aget esz (.-size d)))))

                (return (lit Inst :Op OpVINT :S true :Size 3 :Rd (.-n d) :Rn (.-n n) :Rm (.-n x) :Sys kk) true))

              (when (or ^:go/paren (and (== kk 2) (!= (.-size d) 0)) ^:go/paren (and (== (.-size d) 3) (not (.-q d))))
                (ferr "%s of %s" m (arr (.-size d) (.-q d))))

              (return (lit Inst :Op OpVINT :Sf (.-q d) :Size (.-size d) :Rd (.-n d) :Rn (.-n n) :Rm (.-n x) :Sys kk) true)))
          (case ["diff"]
            (when (!= (len ops) 3)
              (return (lit Inst) false))

            (let [(values x xok) (asVec (aget ops 2))]
              (when (or (not xok) (!= (.-kind d) \v) (!= (.-kind n) \v) (!= (.-kind x) \v) (!= (.-size n) (.-size x)) (!= (.-q n) (.-q x)))
                (return (lit Inst) false))

              (when (== kk 5)
                (when (or (!= (.-size d) 1) (not (.-q d)) (!= (.-size n) 0) (!= (.-q n) two))
                  (ferr "%s of %s from %s" m (arr (.-size d) (.-q d)) (arr (.-size n) (.-q n))))

                (return (lit Inst :Op OpVINT :Sf two :Size 0 :Rd (.-n d) :Rn (.-n n) :Rm (.-n x) :Sys kk) true))

              (when (or (> (.-size d) 2) (!= (.-size n) (+ (.-size d) 1)) (not (.-q n)) (!= (.-q d) two))
                (ferr "%s of %s from %s" m (arr (.-size d) (.-q d)) (arr (.-size n) (.-q n))))

              (return (lit Inst :Op OpVINT :Sf two :Size (.-size d) :Rd (.-n d) :Rn (.-n n) :Rm (.-n x) :Sys kk) true)))
          (case ["misc"]
            (when (== kk 14)
              (when (or (!= (len ops) 3) (!= (.-kind d) \v) (!= (.-kind n) \v))
                (return (lit Inst) false))

              (when (or (> (.-size n) 2) (!= (.-size d) (+ (.-size n) 1)) (not (.-q d)) (!= (.-q n) two) (!= (value (aget ops 2)) (<< (conv int64 8) (.-size n))))
                (ferr "%s of %s from %s" m (arr (.-size d) (.-q d)) (arr (.-size n) (.-q n))))

              (return (lit Inst :Op OpVINT :Sf two :Size (.-size n) :Rd (.-n d) :Rn (.-n n) :Sys kk) true))

            (when (or (!= (len ops) 2) (!= (.-kind d) (.-kind n)))
              (return (lit Inst) false))

            (when (< kk 10)
              (when (or (!= (.-kind d) \v) (> (.-size n) 2) (!= (.-size d) (+ (.-size n) 1)) (!= (.-q d) (.-q n)))
                (ferr "%s of %s from %s" m (arr (.-size d) (.-q d)) (arr (.-size n) (.-q n))))

              (return (lit Inst :Op OpVINT :Sf (.-q n) :Size (.-size n) :Rd (.-n d) :Rn (.-n n) :Sys kk) true))

            (when (or (!= (.-size d) (.-size n)) (!= (.-q d) (.-q n)))
              (ferr "%s: the registers" m))

            (when (== (.-kind d) \s)
              (return (lit Inst :Op OpVINT :S true :Size (.-size d) :Rd (.-n d) :Rn (.-n n) :Sys kk) true))

            (when (and (== (.-size d) 3) (not (.-q d)))
              (ferr "%s of 1d" m))

            (return (lit Inst :Op OpVINT :Sf (.-q d) :Size (.-size d) :Rd (.-n d) :Rn (.-n n) :Sys kk) true))
          (case ["shrn"]
            (when (or (!= (len ops) 3) (!= (.-kind d) \v) (!= (.-kind n) \v))
              (return (lit Inst) false))

            (when (or (> (.-size d) 2) (!= (.-size n) (+ (.-size d) 1)) (not (.-q n)) (!= (.-q d) two))
              (ferr "%s of %s from %s" m (arr (.-size d) (.-q d)) (arr (.-size n) (.-q n))))

            (let [sh (value (aget ops 2))]
              (when (or (< sh 1) (> sh (<< (conv int64 8) (.-size d))))
                (ferr "%s's shift %d" m sh))

              (return (lit Inst :Op OpVINT :Sf two :Size (.-size d) :Rd (.-n d) :Rn (.-n n) :Imm sh :Sys kk) true))))

        (when (or (!= (len ops) 2) (!= (.-kind d) \s) (!= (.-kind n) \v))
          (return (lit Inst) false))

        (when (or (!= (.-size d) 3) (!= (.-size n) 3) (not (.-q n)))
          (ferr "%s of %s from %s" m (conv string (aget esz (.-size d))) (arr (.-size n) (.-q n))))

        (return (lit Inst :Op OpVINT :S true :Size 3 :Rd (.-n d) :Rn (.-n n) :Sys kk) true)))))





^{:go/end 265} (go/func vintName "vintName is the coverage's name: v.srshl.4s, v.srshl.d (scalar), v.pmul.16b; v.raddhn.8b, v.raddhn2.8b (the narrow\ndestination's), v.pmull.8b, v.pmull2.8b (the sources'); v.saddlp.16b (the sources'), v.sqabs.8h, v.sqabs.b (scalar);\nv.shll.8b, v.shll2.8b (the sources'); v.rshrn.8b, v.rshrn2.8b (the destination's); v.addp.d.\n" ^string [^{:tag (* Inst)} in]
  (let [nm (aget vintNames (.-Sys in))]
    (when (.-S in)
      (return (+ "v." nm "." (conv string (aget esz (.-Size in))))))

    (when (vintTwo (.-Sys in))
      (let [two ""]
        (when (.-Sf in)
          (set! two "2"))

        (return (+ "v." nm two "." (arr (.-Size in) false)))))

    (+ "v." nm "." (arr (.-Size in) (.-Sf in)))))



^{:go/end 276} (go/func clmul "clmul is the carry-less (polynomial) product of e-bit x and y, 2e bits.\n" ^uint64 [^uint64 x ^uint64 y ^uint e]
  (let [^uint64 r (zero uint64)]
    (for [i (conv uint 0)] (< i e) (inc! i)
      (when (== (bit-and (>> y i) 1) 1)
        (set! r bit-xor (<< x i))))


    ^{:line 275} r))




^{:go/end 399} (go/method execVINT "execVINT executes them lane by lane, FPSR.QC set when a saturating lane saturates; a vector result's upper half cleared\nwhen Q is (the narrowing 2 forms keep the lower half), a scalar's whole register but the lane.\n" [^{:tag (* CPU)} c ^{:tag (* Inst)} in]
  (let [k (.-Sys in)
      ^{:line 282} nm (aget vintNames k)
      ^{:line 283} e (<< (conv uint 8) (.-Size in))
      (values a b d) (values (aget (.-Q c) (.-Rn in)) (aget (.-Q c) (.-Rm in)) (aget (.-Q c) (.-Rd in)))
      ^{:line 285} sat false
      ^{:line 286 :tag (array 2 uint64)} r (zero (array 2 uint64))
      ^{:line 287} n (/ 64 (conv int e))]
    (when (.-Sf in)
      (set! n (/ 128 (conv int e))))

    (when (.-S in)
      (set! n 1))

    (switch (vintClass k)
      (case ["same"]
        (for [i 0] (< i n) (inc! i)
          (let [x (lane a i e)]
            (when (== k 2)
              (setLane (addr r) i e (bit-and (clmul x (lane b i e) e) (emask e)))
              (continue))

            (let [v (qshift (laneInt x e (== k 0)) (conv int64 (conv int8 (lane b i e))) true)
                ^{:line 303} m (.Lsh (new big/Int) bigOne e)]
              (setLane (addr r) i e (.Uint64 (.And v v (.Sub m m bigOne))))))))

      (case ["diff"]
        (let [w (* 2 e)
            ^{:line 308} hi 0]
          (when (== k 5)
            (let [cnt (/ 64 (conv int e))]
              (when (.-Sf in)
                (set! hi cnt))

              (for [i 0] (< i cnt) (inc! i)
                (setLane (addr r) i w (clmul (lane a (+ i hi) e) (lane b (+ i hi) e) e)))

              (break)))

          (for [i 0] (< i (/ 64 (conv int e))) (inc! i)
            (let [(values x y) (values (lane a i w) (lane b i w))
                ^{:line 321} s (+ x y)]
              (when (== k 4)
                (set! s (- x y)))

              (set! s + (<< (conv uint64 1) (- e 1)))
              (setLane (addr r) i e (bit-and (>> s e) (emask e)))))

          (when (.-Sf in)
            (set! r (lit (array 2 uint64) (aget d 0) (aget r 0))))))

      (case ["misc"]
        (switch
          (case [(< k 10)]
            (let [w (* 2 e)]
              (for [i 0] (< i (/ n 2)) (inc! i)
                (let [p (laneInt (lane a (* 2 i) e) e (== (% k 2) 0))]
                  (.Add p p (laneInt (lane a (+ (* 2 i) 1) e) e (== (% k 2) 0)))
                  (let [v (.Uint64 p)]
                    (when (< (.Sign p) 0)
                      (set! v (conv uint64 (.Int64 p))))


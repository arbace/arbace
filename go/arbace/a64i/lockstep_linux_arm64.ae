                      (values theirs err) (.Read t a n)]
                    (when (or (!= err nil) (not (bytes/Equal mine theirs)))
                      (return (.stepFail l pc "the exclusive region to %#x: stored at %#x: %x, native %x" target a mine theirs)))))

                (continue)))))

        (when (and (!= in nil) (== (.-Op in) OpSVC))
          ;; the system call stepped over in the native, its result fed to a64i
          (let [args (lit (array 6 uint64) (aget (.-X c) 0) (aget (.-X c) 1) (aget (.-X c) 2) (aget (.-X c) 3) (aget (.-X c) 4) (aget (.-X c) 5))]
            (when [d (.compareWrite l (aget (.-X c) 8) args)] (!= d "")
              (return (.fail l "at %#x: %s" (.-PC c) d)))

            (let [(values st err) (.StepOnce t 0 true)]
              (when (!= err nil)
                (return nil err))

              (when (== st emu/StopExit)
                (set! (.-SysHook c) nil)
                (.Step c)
                (return (.finish l)))

              (set! (.-SysHook c) (.sysHook l (aget (.-Regs (.-Regs t)) 0) args))
              (.Step c)
              (set! (.-SysHook c) nil)
              (set! (.-SigMask c) bit-and-not (sigBit SIGTRAP))
              (inc! (.-Syscalls (.-res l)))
              (set! (.-afterSys l) true)
              ;; AR20: a signal delivered at the call's return: the native's delivery stop (after the step's own stop at the return,
              ;; a SIGTRAP stop of the step itself, the native stepped on to it), stepped with the signal into its handler; an ignored one, the native resumed with it
              (when (and strace (> (len (.-Delivered c)) 0))
                (fmt/Fprintf os/Stderr "a64i lockstep: after the call: stop %d signal %d at %#x, delivered %v\n" st (.-Sig t) (.-Pc (.-Regs t)) (.-Delivered c)))

              (for [k 0] (and (< k 3) (.expecting l) (== (.-Pc (.-Regs t)) (.expectPC l)) ^:go/paren (or (== st emu/StopStep) (and (== st emu/StopSignal) (== (.-Sig t) SIGTRAP) (not (.expects l SIGTRAP))))) (inc! k)
                (when [(set! (values st err) (.StepOnce t 0 false))] (!= err nil)
                  (return nil err))

                (when strace
                  (fmt/Fprintf os/Stderr "a64i lockstep: after the call, stepped again: stop %d signal %d at %#x\n" st (.-Sig t) (.-Pc (.-Regs t)))))

              (when (and (== st emu/StopSignal) (not (.-Done c)) (.ignored l (.-Sig t)))
                ;; an ignored signal's stop: the sys mode to the next system call (the native resumed without it)
                (set! (values (.-stepping l) (.-resume l)) (values false true))
                (continue))

              (while (== st emu/StopSignal)
                (let [(values d ok) (.delivered l (.-Sig t) (.-Pc (.-Regs t)))]
                  (when (not ok)
                    (break))

                  (when [(set! (values st err) (.StepOnce t (.-Sig d) false))] (!= err nil)
                    (return nil err))

                  (.worldESR l d)
                  (.worldSS l d)
                  (set! (.-afterSys l) false)))

              (when (and (.-Done c) (!= st emu/StopSignal))
                (return (.finish l)))

              (when (.-Done c)
                ;; a fatal signal: past the step's own SIGTRAP stop to its delivery stop
                (for [k 0] (and (< k 3) (== st emu/StopSignal) (== (.-Sig t) SIGTRAP) (!= (.-Signal c) SIGTRAP)) (inc! k)
                  (when [(set! (values st err) (.StepOnce t 0 false))] (!= err nil)
                    (return nil err)))

                (when (== st emu/StopSignal)
                  (.Resume t (.-Sig t)))

                (return (.finish l)))

              (when [d (.compareRegs l false)] (!= d "")
                (return (.fail l "after the system call at %#x: %s" (- (.-PC c) 4) d)))

              (when [d (.compareMemory l)] (!= d "")
                (return (.fail l "after the system call at %#x: %s" (- (.-PC c) 4) d)))

              (when (and (> (.-StepFrom (.-opts l)) 0) (>= (.-Syscalls (.-res l)) (+ (.-StepFrom (.-opts l)) 1)) (not (.-Step (.-opts l))))
                ;; bisecting: the difference was before this call
                (return (.fail l "bisect: no difference before the system call that differed")))

              (continue))))

        (let [pc (.-PC c)]
          (set! (values (.-Log (.-AS c)) (.-Stores (.-AS c))) (values true (subslice (.-Stores (.-AS c)) _ 0)))
          (.Step c)
          (set! (.-Log (.-AS c)) false)
          ;; AR20: each step's trap is a forced SIGTRAP, which unblocks SIGTRAP in the native (Linux's force_sig_info): so in a64i
          (set! (.-SigMask c) bit-and-not (sigBit SIGTRAP))
          (let [(values st err) (.StepOnce t 0 (and (!= in nil) (== (.-Op in) OpBRK)))]
            (when (!= err nil)
              (return nil err))

            ;; single-stepping's artifact: the first step after a stepped system call's return stops before its instruction
            ;; (the step's pending state), once; the native stepped again
            (when (and (== st emu/StopStep) (.-afterSys l) (== (.-Pc (.-Regs t)) pc))
              (set! (values st err) (.StepOnce t 0 (and (!= in nil) (== (.-Op in) OpBRK))))
              (when (!= err nil)
                (return nil err)))


            ;; a brk's SIGTRAP (si_code TRAP_BRKPT) is reported as the step's own trap with the pc unmoved: the native's signal
            (when (and (!= in nil) (== (.-Op in) OpBRK) (== st emu/StopStep) (== (.-Pc (.-Regs t)) pc))
              (set! (values st (.-Sig t)) (values emu/StopSignal SIGTRAP)))

            ;; AR20: a fault a64i delivered to its handler: the native's delivery stop at the instruction, stepped with the signal into
            ;; the handler (each further delivery at once, the last delivered's handler first)
            (when (and (== st emu/StopSignal) (not (.-Done c)) (.ignored l (.-Sig t)))
              (set! (values (.-stepping l) (.-resume l)) (values false true))
              (continue))

            (while (== st emu/StopSignal)
              (let [(values d ok) (.delivered l (.-Sig t) (.-Pc (.-Regs t)))]
                (when (not ok)
                  (break))

                (when [(set! (values st err) (.StepOnce t (.-Sig d) false))] (!= err nil)
                  (return nil err))

                (.worldESR l d)
                (.worldSS l d)))

            (set! (.-afterSys l) false)
            (inc! (.-Stepped (.-res l)))
            (when (or (== st emu/StopExit) (== st emu/StopSignal))
              (when (not (.-Done c))
                (return (.stepFail l pc "the native stopped (signal %d), a64i did not" (.-Sig t))))

              (when (== st emu/StopSignal)
                (when (!= (.-Sig t) (.-Signal c))
                  (return (.stepFail l pc "signal %d, native %d" (.-Signal c) (.-Sig t))))

                ;; AR19 (285's low): the fatal signal's pc compared, as the sys mode compares it
                (when (!= (.-Pc (.-Regs t)) (.-PC c))
                  (return (.stepFail l pc "signal %d at %#x, native at %#x" (.-Sig t) (.-PC c) (.-Pc (.-Regs t)))))

                (.Resume t (.-Sig t)))

              (return (.finish l)))

            (when (.-Done c)
              (return (.stepFail l pc "a64i stopped (%s), the native did not" (.-Reason c))))

            (when (!= (.-Pc (.-Regs t)) (.-PC c))
              (return (.stepFail l pc "pc %#x, native %#x" (.-PC c) (.-Pc (.-Regs t)))))

            ;; AR19: the counter is the world's: an mrs of cntvct_el0 or cntvctss_el0 takes the native's value; so does an mrs of
            ;; ssbs, a single-stepping artifact: this M2's Linux (its Spectre-v4 mitigation off) sets PSTATE.SSBS at each context
            ;; switch, and a stepped native switches at every step, where a run without one keeps the value written (as a64i does)
            (when [last (.-Last c)] (and (!= last nil) (== (.-Op last) OpMRS) ^:go/paren (or (== (.-Sys last) SysCNTVCT) (== (.-Sys last) SysCNTVCTSS) (== (.-Sys last) SysSSBS)) (< (.-Rd last) 31))
              (aset (.-X c) (.-Rd last) (aget (.-Regs (.-Regs t)) (.-Rd last)))
              (when (== (.-Sys last) SysSSBS)
                (set! (.-SSBS c) (!= (bit-and (aget (.-X c) (.-Rd last)) (<< 1 12)) 0))))

            ;; AR20 (ARS85 (a)): an ID register's fields a64i shows are compared; the fields it makes 0 (features it lacks) are the
            ;; CPU's, taken from the native
            (when [last (.-Last c)] (and (!= last nil) (== (.-Op last) OpMRS) (< (.-Rd last) 31) (!= (IDHidden (.-Sys last)) 0))
              (let [nat (aget (.-Regs (.-Regs t)) (.-Rd last))]
                (when (== (bit-and-not nat (IDHidden (.-Sys last))) (aget (.-X c) (.-Rd last)))
                  (aset (.-X c) (.-Rd last) nat))))

            (when [d (.compareRegs l false)] (!= d "")
              (return (.stepFail l pc "%s" d)))

            (for [i 0] (< (+ i 1) (len (.-Stores (.-AS c)))) (set! i + 2)
              (let [(values a n) (values (aget (.-Stores (.-AS c)) i) (conv int (aget (.-Stores (.-AS c)) (+ i 1))))
                  (values mine _) (.ReadBytes (.-AS c) a n)
                  (values theirs err) (.Read t a n)]
                (when (or (!= err nil) (not (bytes/Equal mine theirs)))
                  (return (.stepFail l pc "stored at %#x: %x, native %x" a mine theirs)))))


            (when [last (.-Last c)] (and (!= last nil) ^:go/paren (or (== (.-Op last) OpMSR) (== (.-Op last) OpMRS)))
              (when [(values v err) (.tpidr l)] (and (== err nil) (!= v (.-TPIDR c)))
                (return (.stepFail l pc "tpidr_el0 %#x, native %#x" (.-TPIDR c) v))))))))))





(go/method delivered "delivered takes a64i's first delivery not yet matched when it is the native's stop: signal sig at pc (AR20); the ESR\nrecord's fault status taken from the native's frame once it is written (worldESR).\n" [^{:tag (* lockstep)} l ^int sig ^uint64 pc] :results [Delivery bool]
  (let [c (.-c l)]
    (when (or (== (len (.-Delivered c)) 0) (!= (.-Sig (aget (.-Delivered c) 0)) sig) (!= (.-PC (aget (.-Delivered c) 0)) pc))
      (return (lit Delivery) false))

    (let [d (aget (.-Delivered c) 0)]
      (set! (.-Delivered c) (subslice (.-Delivered c) 1))
      (inc! (.-Signals (.-res l)))
      (return d true))))


(go/method worldESR "worldESR copies the native's ESR fault status (bits 5-0) into a64i's frame when both are a data or instruction abort's\ntranslation or permission fault (AR20).\n" [^{:tag (* lockstep)} l ^Delivery d]
  (when (== (.-EsrAt d) 0)
    (return))

  (let [(values b err) (.Read (.-t l) (.-EsrAt d) 8)
        (values mine ok) (.Read (.-AS (.-c l)) (.-EsrAt d) 8)]
    (when (or (!= err nil) (not ok))
      (return))

    (let [theirs (.Uint64 binary/LittleEndian b)
          fault (fn [^uint64 e] :results [bool]
                  (let [(values ec fsc) (values (>> e 26) (bit-and e 0x3f))]
                    (return (and ^:go/paren (or (== ec 0x24) (== ec 0x20)) (>= fsc 4) (<= fsc 15)))))]
      (when (and (!= theirs mine) (fault theirs) (fault mine) (== (bit-and-not theirs 0x3f) (bit-and-not mine 0x3f)))
        (.Write (.-AS (.-c l)) (.-EsrAt d) 8 theirs)))))


(go/method worldSS "worldSS: in the step mode the native's frame holds PSTATE.SS (bit 21, the single step's state) in its saved pstate, a\nstepping artifact copied into a64i's frame (AR20).\n" [^{:tag (* lockstep)} l ^Delivery d]
  (let [a (+ (.-Frame d) mcOff 272)
        (values b err) (.Read (.-t l) a 8)
        (values mine ok) (.Read (.-AS (.-c l)) a 8)]
    (when (and (== err nil) ok (!= (bit-and (.Uint64 binary/LittleEndian b) (<< 1 21)) 0))
      (.Write (.-AS (.-c l)) a 8 (bit-or mine (<< 1 21))))))


(go/method ignored "ignored reports a signal a64i dropped as ignored (SIG_IGN, or ignored by default) while the traced native reports it (a\nptraced thread's signals are all reported; AR20), taken from a64i's list.\n" ^bool [^{:tag (* lockstep)} l ^int sig]
  (let [c (.-c l)]
    (when (or (== (len (.-Ignored c)) 0) (!= (aget (.-Ignored c) 0) sig))
      (return false))

    (set! (.-Ignored c) (subslice (.-Ignored c) 1))
    true))


(go/method expecting "expecting reports signals a64i delivered or ignored that the native has not reported yet (AR20).\n" ^bool [^{:tag (* lockstep)} l]
  (or (> (len (.-Delivered (.-c l))) 0) (> (len (.-Ignored (.-c l))) 0)))


(go/method expects ^bool [^{:tag (* lockstep)} l ^int sig]
  (let [c (.-c l)]
    (or ^:go/paren (and (> (len (.-Delivered c)) 0) (== (.-Sig (aget (.-Delivered c) 0)) sig)) ^:go/paren (and (> (len (.-Ignored c)) 0) (== (aget (.-Ignored c) 0) sig)))))


(go/method expectPC "expectPC is the pc where the native reports the signal expected: the first delivery's, else a64i's.\n" ^uint64 [^{:tag (* lockstep)} l]
  (let [c (.-c l)]
    (when (> (len (.-Delivered c)) 0)
      (return (.-PC (aget (.-Delivered c) 0))))

    (.-PC c)))


^{:go/end 481} (go/method stepFail [^{:tag (* lockstep)} l ^uint64 pc ^string f & ^{:tag (slice any)} a] :results [(* LockstepResult) error]
  (set! (.-DiffPC (.-res l)) pc)
  (when [(values in _ _) (.Fetch (.-c l) pc)] (!= in nil)
    (set! (.-DiffInst (.-res l)) (.Key in)))

  (.fail l "at %#x: %s" pc (fmt/Sprintf f (spread a))))




^{:go/end 567} (go/method atStop "atStop: the native at a stop of the sys mode (a system call's entry, a signal, its end), a64i stopped before its SVC\n(or ended): compared, the call made by both. done when the run is over.\n" [^{:tag (* lockstep)} l ^int st] :results [(* LockstepResult) bool error]
  (let [(values c t) (values (.-c l) (.-t l))]
    (switch st
      (case [emu/StopExit]
        (when (not (.-Done c))
          (let [(values r err) (.fail l "the native ended (status %d), a64i did not (pc %#x)" (.-Status t) (.-PC c))]
            (return r true err)))

        (let [(values r err) (.finish l)]
          (return r true err)))
      (case [emu/StopSignal]
        ;; AR20: a signal a64i ignored: the native resumed with it
        (when (and (not (.-Done c)) (.ignored l (.-Sig t)))
          (let [(values st2 err) (.Resume t (.-Sig t))]
            (when (!= err nil)
              (return nil true err))

            (return (.atStop l st2))))

        ;; AR20: a signal a64i delivered to its handler: the native resumed with it, to its next stop
        (when [(values d ok) (.delivered l (.-Sig t) (.-Pc (.-Regs t)))] ok
          (let [(values st2 err) (.Resume t (.-Sig t))]
            (when (!= err nil)
              (return nil true err))

            (.worldESR l d)
            (return (.atStop l st2))))

        (when (or (not (.-Done c)) (!= (.-Signal c) (.-Sig t)))
          (let [(values r err) (.fail l "the native's signal %d at %#x, a64i's %d (%s) at %#x" (.-Sig t) (.-Pc (.-Regs t)) (.-Signal c) (.-Reason c) (.-PC c))]
            (return r true err)))

        (when (!= (.-Pc (.-Regs t)) (.-PC c))
          (let [(values r err) (.fail l "signal %d at %#x, native at %#x" (.-Sig t) (.-PC c) (.-Pc (.-Regs t)))]
            (return r true err)))

        (.Resume t (.-Sig t))
        (let [(values r err) (.finish l)]
          (return r true err))))

    ;; a system call's entry
    (when (.-Done c)
      (let [(values r err) (.fail l "a64i ended (%s, status %d), the native makes system call %d at %#x" (.-Reason c) (.Status c) (aget (.-Regs (.-Regs t)) 8) (- (.-Pc (.-Regs t)) 4))]
        (return r true err)))

    (when (!= (- (.-Pc (.-Regs t)) 4) (.-PC c))
      (let [(values r err) (.fail l "system call at %#x, a64i at %#x" (- (.-Pc (.-Regs t)) 4) (.-PC c))]
        (return r true err)))

    (when [d (.compareRegs l true)] (!= d "")
      (let [(values r err) (.fail l "at system call %d (%#x): %s" (.-Syscalls (.-res l)) (.-PC c) d)]
        (return r true err)))

    (let [args (lit (array 6 uint64) (aget (.-X c) 0) (aget (.-X c) 1) (aget (.-X c) 2) (aget (.-X c) 3) (aget (.-X c) 4) (aget (.-X c) 5))]
      (when [d (.compareWrite l (aget (.-X c) 8) args)] (!= d "")
        (let [(values r err) (.fail l "at system call %d (%#x): %s" (.-Syscalls (.-res l)) (.-PC c) d)]
          (return r true err)))

      (when [d (.compareMemory l)] (!= d "")
        (let [(values r err) (.fail l "at system call %d (%#x): %s" (.-Syscalls (.-res l)) (.-PC c) d)]
          (return r true err)))

      (let [(values ^:assign st err) (.Resume t 0)]
        (when (!= err nil)
          (return nil true err))

        (when (== st emu/StopExit)
          (.Step c)
          (let [(values r err) (.finish l)]
            (return r true err)))

        (when (!= st emu/StopSyscall)
          (return nil true (errors/New "lockstep: the native did not stop at the system call's exit")))

        (set! (.-SysHook c) (.sysHook l (aget (.-Regs (.-Regs t)) 0) args))
        (.Step c)
        (set! (.-SysHook c) nil)
        (inc! (.-Syscalls (.-res l)))
        (when (.-Done c)
          ;; a64i ended with this call (exit): the native ends on resuming (AR20: a fatal signal's delivery stop first)
          (let [(values st err) (.Resume t 0)]
            (when (!= err nil)
              (return nil true err))

            (when (and (== st emu/StopSignal) (== (.-Sig t) (.-Signal c)))
              (set! (values st err) (.Resume t (.-Sig t)))
              (when (!= err nil)
                (return nil true err)))

            (when (!= st emu/StopExit)
              (let [(values r err) (.fail l "a64i ended at system call %d, the native did not" (.-Syscalls (.-res l)))]
                (return r true err)))

            (let [(values r ^:assign err) (.finish l)]
              (return r true err))))

        (when (and (!= (aget (.-X c) 8) sysRtSigreturn) (!= (.-SysX0 c) (aget (.-Regs (.-Regs t)) 0)))
          ;; AR20: the call's result before a signal delivered at its end (rt_sigreturn's x0 is the frame's, compared at the next stop)
          (let [(values r err) (.fail l "system call %d returns %#x, native %#x" (.-Syscalls (.-res l)) (.-SysX0 c) (aget (.-Regs (.-Regs t)) 0))]
            (return r true err)))

        (when (or ^:go/paren (and (> (.-StepFrom (.-opts l)) 0) (== (.-Syscalls (.-res l)) (.-StepFrom (.-opts l)))) (.-resume l))
          ;; to the step mode: the registers after the call compared first (x7 aside: the exit stop's), a difference the call's own
          (when [d (.compareRegs l true)] (!= d "")
            (let [(values r err) (.stepFail l (- (.-PC c) 4) "after the system call: %s" d)]
              (return r true err)))

          (set! (values (.-stepping l) (.-resume l)) (values true false)))

        (return nil false nil)))))


^{:go/end 581} (go/method finish [^{:tag (* lockstep)} l] :results [(* LockstepResult) error]
  (let [(values c t) (values (.-c l) (.-t l))]
    (set! (.-Steps (.-res l)) (.-Steps c))
    (set! (.-Status (.-res l)) (.-Status t))
    (when (and (not (.-Exited t)) (not (.-Signaled t)))
      (return (.fail l "the native has not ended")))

    (when (!= (.Status c) (.-Status t))
      (return (.fail l "status %d, native %d" (.Status c) (.-Status t))))

    (set! (.-Equal (.-res l)) true)
    (return (.-res l) nil)))

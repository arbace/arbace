    (return v 0 ok)))



^{:go/end 607} (go/method ldWrite "the register a load writes: a general register (sign-extended as the load says), or a SIMD&FP register (the rest zeroed)\n" [^{:tag (* CPU)} c ^{:tag (* Inst)} in ^uint8 r ^uint64 lo ^uint64 hi]
  (when (.-Vreg in)
    (aset (.-Q c) r (lit (array 2 uint64) lo hi))
    (return))

  (.set c r (.loadValue c in lo) true false))


^{:go/end 614} (go/method stValue [^{:tag (* CPU)} c ^{:tag (* Inst)} in ^uint8 r] :results [uint64 uint64]
  (when (.-Vreg in)
    (return (aget (aget (.-Q c) r) 0) (aget (aget (.-Q c) r) 1)))

  (return (.reg c r false) 0))


^{:go/end 671} (go/method ldst [^{:tag (* CPU)} c ^{:tag (* Inst)} in]
  (let [n (<< (conv uint64 1) (.-Size in))
      (values ^uint64 addr ^uint64 wb) (zero uint64)]
    (if (== (.-Op in) OpLDRLIT)
      (set! addr (.-Target in))

      (let [^bool ok (zero bool)]
        (when [(set! (values addr wb ok) (.address c in))] (not ok)
          (return))))


    (let [pair (or (== (.-Op in) OpLDP) (== (.-Op in) OpSTP))]
      (switch (.-Op in)
        (case [OpLDR OpLDRLIT OpLDP]
          (let [(values lo hi ok) (.elemLoad c addr (.-Size in))]
            (when (not ok)
              (return))

            (let [(values ^uint64 lo2 ^uint64 hi2) (zero uint64)]
              (when pair
                (when [(set! (values lo2 hi2 ok) (.elemLoad c (+ addr n) (.-Size in)))] (not ok)
                  (return)))


              (.ldWrite c in (.-Rd in) lo hi)
              (when pair
                (.ldWrite c in (.-Ra in) lo2 hi2)))))

        (default
          (let [total n]
            (when pair
              (set! total * 2))

            (when (not (.Probe (.-AS c) addr (conv int total)))
              (.segv c (.-FaultAddr (.-AS c)))
              (return))

            (let [regs (lit (slice uint8) (.-Rd in))]
              (when pair
                (set! regs (append regs (.-Ra in))))

              (range [i r regs]
                (let [(values lo hi) (.stValue c in r)
                    ^{:line 659} a (+ addr (* (conv uint64 i) n))]
                  (if (== (.-Size in) 4) (do
                      (.store c a 3 lo)
                      (.store c (+ a 8) 3 hi))

                    (.store c a (.-Size in) lo))))))))



      (when (or (== (.-Mode in) ModePre) (== (.-Mode in) ModePost))
        (aset (.-X c) (.-Rn in) wb)))))

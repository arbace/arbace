;; the decoder: the Advanced SIMD space (bits 28-25 x111, not the scalar FP classes)

(go/var unimpSIMD ":unimplemented simd")


^{:go/breaks [[5 210]] :go/end 211} (go/func v3Of "v3Of is three same's instruction by U, opcode and size: its v3Names index, or -1.\n" ^int [^uint32 u ^uint32 opc ^uint32 size]
  (switch opc
    (case [0]
      (return (+ 20 (conv int u)))) ; shadd, uhadd
    (case [1]
      (return (+ 26 (conv int u)))) ; sqadd, uqadd
    (case [2]
      (return (+ 22 (conv int u)))) ; srhadd, urhadd
    (case [3]
      (return (aget (lit (slice int) 2 3 4 5 6 7 8 9) (bit-or (<< u 2) size))))
    (case [4]
      (return (+ 24 (conv int u)))) ; shsub, uhsub
    (case [5]
      (return (+ 28 (conv int u)))) ; sqsub, uqsub
    (case [6]
      (return (+ 11 (conv int u)))) ; cmgt, cmhi
    (case [7]
      (return (+ 13 (conv int u)))) ; cmge, cmhs
    (case [8]
      (return (+ 42 (conv int u)))) ; sshl, ushl
    (case [12]
      (return (+ 16 (conv int u)))) ; smax, umax
    (case [13]
      (return (+ 18 (conv int u)))) ; smin, umin
    (case [14]
      (return (+ 30 (conv int u)))) ; sabd, uabd
    (case [15]
      (return (+ 32 (conv int u)))) ; saba, uaba
    (case [16]
      (return (conv int u))) ; add, sub
    (case [17]
      (return (aget (lit (slice int) 15 10) u))) ; cmtst, cmeq
    (case [18]
      (return (+ 35 (conv int u)))) ; mla, mls
    (case [19]
      (when (== u 0)
        (return 34))) ; mul

    (case [20]
      (return (+ 38 (conv int u)))) ; smaxp, umaxp
    (case [21]
      (return (+ 40 (conv int u)))) ; sminp, uminp
    (case [23]
      (when (== u 0)
        (return 37)))) ; addp


  -1)




^{:go/breaks [[5 222]] :go/end 223} (go/func v3Kind "v3Sizes is which sizes (and Q for size 3) three same's instruction takes: \"any\" (size 3 with Q), \"no3\" (8-32 bits),\n\"d\" (64 bits only, in the scalar form), \"logic\" (the size field is the operation).\n" ^string [^int k]
  (switch
    (case [(and (>= k 2) (<= k 9))]
      (return "logic"))
    (case [(or (== k 0) (== k 1) ^:go/paren (and (>= k 10) (<= k 15)) (== k 42) (== k 43) ^:go/paren (and (>= k 26) (<= k 29)) (== k 37))]
      (return "any")))

  "no3")




^{:go/breaks [[5 234]] :go/end 235} (go/func v3Scalar "v3Scalar is whether three same's instruction has a scalar form at size (bit 28 set): add, sub, the compares, the shifts\nat 64 bits; the saturating additions at any size.\n" ^bool [^int k ^uint32 size]
  (switch
    (case [(and (>= k 26) (<= k 29))]
      (return true))
    (case [(or (== k 0) (== k 1) ^:go/paren (and (>= k 10) (<= k 15)) (== k 42) (== k 43))]
      (return (== size 3))))

  false)



^{:go/breaks [[5 265]] :go/end 266} (go/func v2Of "v2Of is two-register miscellaneous's instruction by U, opcode and size: its v2Names index, or -1.\n" ^int [^uint32 u ^uint32 opc ^uint32 size]
  (switch
    (case [(and (== opc 0) (== u 0))]
      (return 0)) ; rev64
    (case [(and (== opc 1) (== u 0))]
      (return 1)) ; rev16
    (case [(and (== opc 0) (== u 1))]
      (return 2)) ; rev32
    (case [(== opc 4)]
      (return (+ 3 (conv int u)))) ; cls, clz
    (case [(and (== opc 5) (== u 0) (== size 0))]
      (return 5)) ; cnt
    (case [(and (== opc 5) (== u 1) (== size 0))]
      (return 6)) ; not
    (case [(and (== opc 5) (== u 1) (== size 1))]
      (return 7)) ; rbit
    (case [(== opc 8)]
      (return (+ 8 (conv int u)))) ; cmgt, cmge #0
    (case [(== opc 9)]
      (return (+ 10 (conv int u)))) ; cmeq, cmle #0
    (case [(and (== opc 10) (== u 0))]
      (return 12)) ; cmlt #0
    (case [(== opc 11)]
      (return (+ 13 (conv int u)))) ; abs, neg
    (case [(and (== opc 18) (== u 0))]
      (return 15))) ; xtn

  -1)



^{:go/end 297} (go/func expandImm "expandImm is AdvSIMDExpandImm: the 64-bit pattern of op, cmode and imm8; false for cmode 1111 (FMOV's).\n" [^uint32 op ^uint32 cmode ^uint32 imm8] :results [uint64 bool]
  (let [i (conv uint64 imm8)
      ^{:line 271} rep32 ^{:go/end 271} (fn ^uint64 [^uint64 v] (bit-or (<< v 32) v))
      ^{:line 272} rep16 ^{:go/end 272} (fn ^uint64 [^uint64 v] (bit-or (<< v 48) (<< v 32) (<< v 16) v))]
    (switch (>> cmode 1)
      (case [0 1 2 3]
        (return (rep32 (<< i (* 8 (>> cmode 1)))) true))
      (case [4 5]
        (return (rep16 (<< i (* 8 (bit-and (>> cmode 1) 1)))) true))
      (case [6]
        (when (== (bit-and cmode 1) 0)
          (return (rep32 (bit-or (<< i 8) 255)) true))

        (return (rep32 (bit-or (<< i 16) 65535)) true)))

    (when (== cmode 14)
      (when (== op 0)
        (return (* i 0x0101010101010101) true))

      (let [^uint64 v (zero uint64)]
        (for [k (conv uint 0)] (< k 8) (inc! k)
          (when (== (bit-and (>> i k) 1) 1)
            (set! v bit-or ^uint64 (<< 255 (* 8 k)))))


        (return v true)))

    (return 0 false)))



^{:go/end 554} (go/func decodeSIMD "decodeSIMD is the Advanced SIMD space a64i runs: the integer classes, vector and scalar.\n" [^uint32 w] :results [Inst string]
  (when [(values in r ok) (decodeVSAT w)] ok
    (return in r))
  (when [(values in r ok) (decodeSIMDFP w)] ok
    (return in r))
  (let [q (== (bf w 30 30) 1)
      ^{:line 302} u (bf w 29 29)
      ^{:line 303} size (bf w 23 22)
      (values rd rn rm) (values (conv uint8 (bf w 4 0)) (conv uint8 (bf w 9 5)) (conv uint8 (bf w 20 16)))]
    (when (!= (bf w 31 31) 0)
      (return (lit Inst) unimpSIMD))

    (let [scalar (== (bf w 28 28) 1)]
      (when (and scalar (not q))
        (return (lit Inst) unimpSIMD))

      (switch
        ;; three same: 0 Q U 01110 size 1 Rm opcode 1 Rn Rd (scalar: 01 U 11110 size 1 Rm opcode 1 Rn Rd)
        (case [(and (== (bf w 27 24) 14) (== (bf w 21 21) 1) (== (bf w 10 10) 1))]
          (let [k (v3Of u (bf w 15 11) size)]
            (when (< k 0)
              (return (lit Inst) unimpSIMD))

            (when scalar
              (when (not (v3Scalar k size))
                (return (lit Inst) unimpSIMD))

              (return (lit Inst :Op OpV3 :S true :Size (conv uint8 size) :Rd rd :Rn rn :Rm rm :Sys (conv uint32 k)) ""))

            (switch (v3Kind k)
              (case ["logic"]

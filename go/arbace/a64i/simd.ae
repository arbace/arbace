                (case [3 4 15]
                  (set! ok (< size 3)))
                (case [8 9 10 11 12 13 14]
                  (set! ok (or (< size 3) q))))

              (when (not ok)
                (return (lit Inst) undef))

              (return (lit Inst :Op OpV2 :Sf q :Size (conv uint8 size) :Rd rd :Rn rn :Sys (conv uint32 k)) ""))))
        ;; across lanes: 0 Q U 01110 size 11000 opcode 10 Rn Rd
        (case [(and (not scalar) (== (bf w 27 24) 14) (== (bf w 21 17) 24) (== (bf w 11 10) 2))]
          (let [k -1]
            (switch [opc (bf w 16 12)]
              (case [(and (== opc 27) (== u 0))]
                (set! k 0))
              (case [(== opc 10)]
                (set! k (+ 1 (conv int u))))
              (case [(== opc 26)]
                (set! k (+ 3 (conv int u))))
              (case [(== opc 3)]
                (set! k (+ 5 (conv int u)))))

            (when (< k 0)
              (return (lit Inst) unimpSIMD))

            (when (or (== size 3) ^:go/paren (and (== size 2) (not q)))

              (case ["any"]
                (when (and (== size 3) (not q))
                  (return (lit Inst) undef)))

              (default
                (when (== size 3)
                  (return (lit Inst) undef))))


            (return (lit Inst :Op OpV3 :Sf q :Size (conv uint8 size) :Rd rd :Rn rn :Rm rm :Sys (conv uint32 k)) "")))
        ;; two-register miscellaneous: 0 Q U 01110 size 10000 opcode 10 Rn Rd
        (case [(and (== (bf w 27 24) 14) (== (bf w 21 17) 16) (== (bf w 11 10) 2))]
          (let [k (v2Of u (bf w 16 12) size)]
            (when (< k 0)
              (return (lit Inst) unimpSIMD))

            (when scalar
              (when (and ^:go/paren (and (>= k 8) (<= k 14)) (== size 3))
                (return (lit Inst :Op OpV2 :S true :Size 3 :Rd rd :Rn rn :Sys (conv uint32 k)) ""))


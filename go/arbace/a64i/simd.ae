            (return (lit Inst :Op OpVACR :Sf q :Size (conv uint8 size) :Rd rd :Rn rn :Sys (conv uint32 k)) "")))
        ;; copy: 0 Q op 01110000 imm5 0 imm4 1 Rn Rd (scalar dup: 01 0 11110000 imm5 0 0000 1 Rn Rd)
        (case [(and (== (bf w 27 21) 112) (== (bf w 15 15) 0) (== (bf w 10 10) 1))]
          (let [(values imm5 imm4) (values (bf w 20 16) (bf w 14 11))]
            (when (== (bit-and imm5 15) 0)
              (return (lit Inst) undef))

            (let [sz (conv uint8 (bits/TrailingZeros32 imm5))
                ^{:line 394} idx (conv int64 (>> imm5 (+ sz 1)))]
              (when scalar

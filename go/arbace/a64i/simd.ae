;; Advanced SIMD's integer lanes (doc/asm/ARM64-SURVEY.md, "As built: AR8"; ARS48 (a)): the vector classes on integer elements
;; (three registers of the same type, two-register miscellaneous, across lanes, copy: DUP, INS, UMOV, SMOV; shift by
;; immediate, modified immediate: MOVI, MVNI, ORR, BIC; permute: UZP, TRN, ZIP; EXT; TBL, TBX; three registers of different
;; types: the long, wide and narrow forms) and their scalar forms on a D register (and DUP's scalar `mov b0, v1.b[1]`),
;; decoded, lowered from their forms and executed lane by lane as the Arm ARM's pseudocode defines them (DDI 0487: the
;; shared/functions/vector and the instructions' Operation; the saturating ones setting FPSR.QC). The FP lanes, the
;; polynomial multiplies are :unimplemented (the by-element multiplies simdfp.go's since AR10; the saturating doubling multiplies, shifts
;; and narrows simdsat.go's since AR12); the loads and stores
;; of structures are simdmem.go's, the FP lanes' vector classes simdfp.go's (AR9).
;; Written from the pseudocode by Arbace; no code copied.



(go/const "The Advanced SIMD operations (after the FP ones); Sf is Q (128 bits), S the scalar form, Size the element's log2 bytes,\nSys the instruction (an index into its class's names).\n"
  ^{:line 22} [^{:tag Op :val 95} OpV3 (+ opFPEnd 1 iota)] ; three same: Rd = Rn op Rm (Sys: v3Names)
  ^{:line 23} [^{:val 96} OpV2] ; two-register miscellaneous (Sys: v2Names)
  ^{:line 24} [^{:val 97} OpVACR] ; across lanes: a scalar Rd (Sys: vacrNames)
  ^{:line 25} [^{:val 98} OpVDUP] ; dup (element): Imm the index; S the scalar form (mov b0, v1.b[1])
  ^{:line 26} [^{:val 99} OpVDUPG] ; dup (general): Rn a general register
  ^{:line 27} [^{:val 100} OpVMOVG] ; umov, smov (Signed): Rd a general register of Sf's width, Imm the index
  ^{:line 28} [^{:val 101} OpVINSG] ; ins (general): Imm the index
  ^{:line 29} [^{:val 102} OpVINSE] ; ins (element): Imm the destination's index, Imm2 the source's
  ^{:line 30} [^{:val 103} OpVSHI] ; shift by immediate (Sys: vshiNames): Imm the shift
  ^{:line 31} [^{:val 104} OpVIMM] ; modified immediate (Sys: 0 movi, 1 mvni, 2 orr, 3 bic): Imm the 64-bit pattern
  ^{:line 32} [^{:val 105} OpVPERM] ; uzp1, trn1, zip1, uzp2, trn2, zip2 (Sys 1-3, 5-7, as the encoding's opcode)
  ^{:line 33} [^{:val 106} OpVEXT] ; ext: Imm the byte index
  ^{:line 34} [^{:val 107} OpVTBL] ; tbl, tbx (N): Imm the table's registers (1-4)
  ^{:line 35} [^{:val 108} OpV3D] ; three different (Sys: v3dNames): Size the narrow element's
  [^{:val 109} OpVLDM] ; the loads and stores of structures (simdmem.go: multiple, single, replicated; AR9)
  [^{:val 110} OpVLDS]
  [^{:val 111} OpVLDR]
  [^{:val 112} OpVF3] ; three same (FP), vector (simdfp.go; AR9; Sys: vf3Names)
  [^{:val 113} OpVF2] ; two-register miscellaneous (FP), vector (Sys: vf2Names); OpVF3 and OpVF2 with S their scalar forms (AR10)
  [^{:val 114} OpVEL] ; vector x indexed element, vector and scalar (simdfp.go; AR10; Sys: velNames, Imm the element's index)
  [^{:val 115} OpVFCVT] ; fcvtn, fcvtl, fcvtxn (simdfp.go; AR11; Sys: vfcvtNames, Size the wider type's, Sf the 2 form)
  [^{:val 116} OpVFIX] ; the fixed-point scvtf, ucvtf, fcvtzs, fcvtzu, vector and scalar (AR11; Sys: vfixNames, Imm the fraction bits)
  [^{:val 117} OpVSAT] ; the saturating doubling multiplies, shifts and narrows (AR12; Sys: vsatNames, its class by range; simdsat.go)
  ^{:line 36} [^{:val 118} opSIMDEnd])


(go/var simdOpNames (lit (array ... string) "v3" "v2" "vacr" "vdup" "vdupg" "vmovg" "vinsg" "vinse" "vshi" "vimm" "vperm" "vext" "vtbl" "v3d" "vldm" "vlds" "vldr" "vf3" "vf2" "vel" "vfcvt" "vfix" "vsat"))

^{:go/end 43} (go/func isSIMDOp ^bool [^Op o]
  (and (> o opFPEnd) (< o opSIMDEnd)))


^{:go/end 47} (go/func simdOpName ^string [^Op o]
  (aget simdOpNames (- o opFPEnd 1)))



^{:go/breaks [[5 54]] :go/end 55} (go/func fpFamily "fpFamily is an FP or SIMD operation's family.\n" ^string [^Op o]
  (when (isSIMDOp o)
    (return "simd"))

  "fp")


(go/var v3Names ^{:go/breaks [16 30 45]} (lit (array ... string) "add" "sub" "and" "bic" "orr" "orn" "eor" "bsl" "bit" "bif" "cmeq" "cmgt" "cmhi" "cmge"
    "cmhs" "cmtst" "smax" "umax" "smin" "umin" "shadd" "uhadd" "srhadd" "urhadd" "shsub" "uhsub" "sqadd" "uqadd"
    "sqsub" "uqsub" "sabd" "uabd" "saba" "uaba" "mul" "mla" "mls" "addp" "smaxp" "umaxp" "sminp" "uminp" "sshl"
    "ushl"))

(go/var v2Names ^{:go/breaks [15]} (lit (array ... string) "rev64" "rev16" "rev32" "cls" "clz" "cnt" "not" "rbit" "cmgt" "cmge" "cmeq" "cmle" "cmlt"
    "abs" "neg" "xtn"))

(go/var vacrNames (lit (array ... string) "addv" "smaxv" "umaxv" "sminv" "uminv" "saddlv" "uaddlv"))

(go/var vshiNames ^{:go/breaks [14]} (lit (array ... string) "sshr" "ushr" "ssra" "usra" "srshr" "urshr" "srsra" "ursra" "sri" "shl" "sli" "shrn"
    "sshll" "ushll"))

(go/var vimmNames (lit (array ... string) "movi" "mvni" "orr" "bic"))

(go/var vpermNames (lit (array ... string) "" "uzp1" "trn1" "zip1" "" "uzp2" "trn2" "zip2"))

(go/var v3dNames ^{:go/breaks [13]} (lit (array ... string) "saddl" "uaddl" "saddw" "uaddw" "ssubl" "usubl" "ssubw" "usubw" "addhn" "subhn" "sabal"
    "uabal" "sabdl" "uabdl" "smlal" "umlal" "smlsl" "umlsl" "smull" "umull"))

^{:go/breaks [[4 83]] :go/end 84} (go/func nameIndex ^int [^{:tag (slice string)} names ^string m]
  (range [i n names]
    (when (and (== n m) (!= n ""))
      (return i)))


  -1)


(go/var esz "bhsd")


^{:go/end 95} (go/func arr "arr is a vector's arrangement as an assembler writes it: 8b, 16b, 4h, 8h, 2s, 4s, 1d, 2d.\n" ^string [^uint8 size ^bool q]
  (let [n ^int (>> 8 size)]
    (when q
      (set! n * 2))

    (+ (strconv/Itoa n) (conv string (aget esz size)))))



^{:go/end 155} (go/func simdName "simdName is an Advanced SIMD instruction's name for the coverage: its mnemonic and its arrangement (or element).\n" ^string [^{:tag (* Inst)} in]
  (let [a (arr (.-Size in) (.-Sf in))]
    (when (.-S in)
      (set! a (conv string (aget esz (.-Size in)))))

    (let [two ""]
      (when (.-Sf in)
        (set! two "2"))

      (switch (.-Op in)
        (case [OpV3]
          (return (+ "v." (aget v3Names (.-Sys in)) "." a)))
        (case [OpV2]
          (when (== (.-Sys in) 15)
            (return (+ "v.xtn" two "." (arr (.-Size in) false))))

          (return (+ "v." (aget v2Names (.-Sys in)) "." a)))
        (case [OpVACR]
          (return (+ "v." (aget vacrNames (.-Sys in)) "." a)))
        (case [OpVDUP]
          (return (+ "v.dup." a)))
        (case [OpVDUPG]
          (return (+ "v.dup.g." a)))
        (case [OpVMOVG]
          (let [(values s w) (values "umov" "w")]
            (when (.-Signed in)
              (set! s "smov"))

            (when (.-Sf in)
              (set! w "x"))

            (return (+ "v." s "." w "." (conv string (aget esz (.-Size in)))))))
        (case [OpVINSG]
          (return (+ "v.ins.g." (conv string (aget esz (.-Size in))))))
        (case [OpVINSE]
          (return (+ "v.ins." (conv string (aget esz (.-Size in))))))
        (case [OpVSHI]
          (when (>= (.-Sys in) 11)
            (return (+ "v." (aget vshiNames (.-Sys in)) two "." (arr (.-Size in) false))))

          (return (+ "v." (aget vshiNames (.-Sys in)) "." a)))
        (case [OpVIMM]
          (return (+ "v." (aget vimmNames (.-Sys in)) "." (aget (lit (map bool string) [false "64"] [true "128"]) (.-Sf in)))))
        (case [OpVPERM]
          (return (+ "v." (aget vpermNames (.-Sys in)) "." a)))
        (case [OpVEXT]
          (return (+ "v.ext." a)))
        (case [OpVTBL]
          (let [s "tbl"]
            (when (.-N in)
              (set! s "tbx"))

            (return (+ "v." s (strconv/Itoa (conv int (.-Imm in))) "." a))))
        (case [OpV3D]
          (return (+ "v." (aget v3dNames (.-Sys in)) two "." (arr (.-Size in) false))))
        (case [OpVLDM OpVLDS OpVLDR]
          (return (vmemName in)))
        (case [OpVF3 OpVF2 OpVEL OpVFCVT OpVFIX]
          (return (vfName in)))
        (case [OpVSAT]
          (return (vsatName in))))

      (.String (.-Op in)))))



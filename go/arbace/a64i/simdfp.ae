^{:go/end 798} (go/func lowerVFCVT "lowerVFCVT is their forms: fcvtn v0.2s, v1.2d; fcvtl2 v0.4s, v1.8h; fcvtxn s0, d1; scvtf v0.4s, v1.4s, #3; fcvtzu d0, d1, #64.\n" [^string m ^{:tag (slice (* Sx))} ops] :results [Inst bool]

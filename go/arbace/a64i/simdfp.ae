            (set! v (.fpToFixed c t x (conv int (.-Imm in)) 3 e (== (.-Sys in) 2))))

          (setLane (addr r) i e v)))

      (aset (.-Q c) (.-Rd in) r))))


(go/var _ big/NewFloat)

(go/var ^{:doc "AR12 (ARS63 (a)): NEON's saturating doubling multiplies and saturating shifts and narrows, OpVSAT, FPSR.QC set when a lane\nsaturates (the Arm ARM's SignedSatQ, UnsignedSatQ, SatQ on the exact integer). Sys is vsatNames' index, its class by range:\n0-5 three same (Size the element's), 6-8 three different (Size the narrow sources'), 9-13 by element (Size the sources', Imm\nthe element's index, Rm the whole register number), 14-16 the left shifts by immediate (Imm the shift), 17-22 the narrowing\nshifts (Size the narrow destination's, Imm the right shift), 23-25 the saturating extracts (Size the narrow destination's).\nSf is Q (the 2 forms of the long and narrow ones), S the scalar form. FEAT_RDM's sqrdmlah and sqrdmlsh are not claimed (a64i\nclaims no feature beyond ARMv8.0's Advanced SIMD): they stay :unimplemented simd.\n"} vsatNames (lit (array ... string) "sqdmulh" "sqrdmulh" "sqshl" "uqshl" "sqrshl" "uqrshl" "sqdmlal" "sqdmlsl" "sqdmull" "sqdmlal" "sqdmlsl" "sqdmull" "sqdmulh" "sqrdmulh" "sqshl" "uqshl" "sqshlu" "sqshrn" "sqrshrn" "uqshrn" "uqrshrn" "sqshrun" "sqrshrun" "sqxtn" "uqxtn" "sqxtun"))


^{:go/breaks [[5 31]] :go/end 32} (go/func vsatClass "vsatClass is a vsatNames index's class: \"same\", \"diff\", \"elem\", \"shl\", \"shrn\", \"xtn\".\n" ^string [^uint32 k]

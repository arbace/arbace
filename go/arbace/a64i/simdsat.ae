                  (when (== nm "sqrdmulh")
                    (.Add p p (.Lsh (new big/Int) bigOne (- e 1))))

                  (put i e (.Rsh p p e) false)))
              (case ["sqshlu"]
                (put i e (qshift (laneInt x e true) (.-Imm in) false) true))
              (default
                (let [sh (.-Imm in)]
                  (when (== cl "same")
                    (set! sh (conv int64 (conv int8 (lane b i e)))))

                  (let [signed (== (aget nm 0) \s)]
                    (put i e (qshift (laneInt x e signed) sh (strings/Contains nm "rshl")) (not signed))))))))


        (when (not (.-Sf in))
          (aset r 1 0)))

      (case ["diff" "elem"]
        (let [long (vsatLong k)
            ^{:line 421} hi 0]
          (when (and long (.-Sf in))

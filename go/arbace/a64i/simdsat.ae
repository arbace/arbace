                      (continue))

                    (let [(values pv s1) (satQ p w false)]
                      (set! sat (or sat s1))
                      (when (== nm "sqdmull")
                        (setLane (addr r) i w pv)
                        (continue))

                      (let [acc (laneInt (lane d i w) w true)]
                        (if (== nm "sqdmlsl")
                          (.Sub acc acc (laneInt pv w true))

                          (.Add acc acc (laneInt pv w true)))

                        (put i w acc false))))))

              (when (and (not long) (not (.-Sf in)))
                (aset r 1 0))))))

      (case ["shrn" "xtn"]

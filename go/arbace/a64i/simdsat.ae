^{:go/end 326} (go/func vsatName "vsatName is the coverage's name: v.sqdmulh.8h, v.sqshl.d (scalar); v.sqdmull.4h, v.sqdmull2.8h, v.sqdmull.h (the sources');\nv.sqdmulh.e.8h, v.sqdmlal2.e.8h, v.sqdmulh.e.s; v.sqshl.imm.16b, v.uqshl.imm.b; v.sqshrn.8b, v.sqshrn2.16b, v.sqshrn.b (the\ndestination's); v.sqxtn.8b, v.sqxtn2.16b, v.sqxtn.h.\n" ^string [^{:tag (* Inst)} in]
  (let [nm (aget vsatNames (.-Sys in))
      ^{:line 311} a (arr (.-Size in) (.-Sf in))]
    (when (.-S in)
      (set! a (conv string (aget esz (.-Size in)))))

    (let [two ""]
      (when (and (.-Sf in) ^:go/paren (or (vsatLong (.-Sys in)) (>= (.-Sys in) 17)))
        (set! two "2"))

      (switch (vsatClass (.-Sys in))
        (case ["elem"]
          (return (+ "v." nm two ".e." a)))
        (case ["shl"]
          (return (+ "v." nm ".imm." a))))

      (+ "v." nm two "." a))))


(go/var bigOne (big/NewInt 1))


^{:go/end 349} (go/func satQ "satQ is SatQ: the integer x saturated to e bits, signed or unsigned, and whether it was.\n" [^{:tag (* big/Int)} x ^uint e ^bool unsigned] :results [uint64 bool]
  (let [(values lo hi) (values (new big/Int) (new big/Int))]
    (if unsigned
      (.Sub (.Lsh hi bigOne e) hi bigOne)
      (do
        (.Sub (.Lsh hi bigOne (- e 1)) hi bigOne)
        (.Neg (.Lsh lo bigOne (- e 1)) lo)))

    (let [sat false
        ^{:line 340} r x]
      (cond (< (.Cmp x lo) 0)
        (set! (values r sat) (values lo true))
        (> (.Cmp x hi) 0)
        (set! (values r sat) (values hi true)))

      (let [m (.Lsh (new big/Int) bigOne e)]
        (.Sub m m bigOne)
        (return (.Uint64 (.And (new big/Int) r m)) sat)))))



^{:go/end 357} (go/func laneInt "laneInt is a lane's integer, signed or unsigned.\n" ^{:tag (* big/Int)} [^uint64 x ^uint e ^bool signed]
  (when signed
    (return (big/NewInt (sx x e))))

  (.SetUint64 (new big/Int) x))



^{:go/end 369} (go/func qshift "qshift is the saturating shift's integer before saturation: x shifted left by sh (right when negative, rounded when round).\n" ^{:tag (* big/Int)} [^{:tag (* big/Int)} x ^int64 sh ^bool round]
  (let [r (.Set (new big/Int) x)]
    (when (>= sh 0)
      (return (.Lsh r r (conv uint sh))))

    (when round
      (.Add r r (.Lsh (new big/Int) bigOne (conv uint (- (- sh) 1)))))

    (.Rsh r r (conv uint (- sh)))))




^{:go/end 489} (go/method execVSAT "execVSAT executes them lane by lane on the exact integers, FPSR.QC set when a lane saturates; a vector result's upper half\ncleared when Q is (the narrowing 2 forms keep the lower half), a scalar's whole register but the lane.\n" [^{:tag (* CPU)} c ^{:tag (* Inst)} in]
  (let [k (.-Sys in)
      ^{:line 375} nm (aget vsatNames k)
      ^{:line 376} cl (vsatClass k)
      ^{:line 377} e (<< (conv uint 8) (.-Size in))
      (values a b d) (values (aget (.-Q c) (.-Rn in)) (aget (.-Q c) (.-Rm in)) (aget (.-Q c) (.-Rd in)))
      ^{:line 379} sat false
      ^{:line 380 :tag (array 2 uint64)} r (zero (array 2 uint64))
      ^{:line 381} put ^{:go/end 385} (fn [^int i ^uint w ^{:tag (* big/Int)} v ^bool unsigned]

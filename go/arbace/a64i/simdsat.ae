      (return "same"))
    (case [(<= k 8)]
      (return "diff"))
    (case [(<= k 13)]
      (return "elem"))
    (case [(<= k 16)]
      (return "shl"))
    (case [(<= k 22)]
      (return "shrn")))

  "xtn")



^{:go/end 37} (go/func vsatLong "vsatLong is whether the instruction's destination elements are twice its sources' (sqdmlal, sqdmlsl, sqdmull).\n" ^bool [^uint32 k]
  (and (>= k 6) (<= k 11)))






                ^{:line 475} v (laneInt x (* 2 e) signed)]
              (when (== cl "shrn")
                (set! v (qshift v (- (.-Imm in)) (strings/Contains nm "rshr"))))

              (put i e v (or (not signed) (strings/Contains nm "un")))))

          (when (.-Sf in)
            (set! r (lit (array 2 uint64) (aget d 0) (aget r 0)))))))


    (when sat

^{:go/end 304} (go/func lowerVSAT "lowerVSAT is their forms: sqdmulh v0.8h, v1.8h, v2.8h; sqdmulh s0, s1, v2.s[1]; sqdmull2 v0.4s, v1.8h, v2.8h; sqdmlal d0,\ns1, s2; sqshl v0.16b, v1.16b, #3; uqrshl d0, d1, d2; sqshrun2 v0.16b, v1.8h, #5; sqxtn h0, s1. false for another mnemonic.\n" [^string m ^{:tag (slice (* Sx))} ops] :results [Inst bool]

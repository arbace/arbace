            (return (lit Inst :Op OpVSAT :Sf vq :S scalar :Size (conv uint8 size) :Rd rd :Rn rn :Rm rm :Sys (conv uint32 k)) "" true)))
        (case [(and (== (bf w 27 24) 15) (== (bf w 10 10) 0))]

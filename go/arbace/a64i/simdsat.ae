        (case [(and (== (bf w 27 24) 14) (== (bf w 21 21) 1) (== (bf w 11 10) 0))]
          (let [k -1]
            (switch (bf w 15 12)
              (case [9]
                (set! k 6))
              (case [11]
                (set! k 7))

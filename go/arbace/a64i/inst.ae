(go/const ^{:tag Op :val 127 :doc "OpSYS is SYS's DC and IC (AR19, queue 288): Rd the address's register, Sys CRm (dc zva 4, ic ivau 5, dc cvac 10, cvau 11,\ncvap 12, cvadp 13, civac 14); past the FP and SIMD operations, so that theirs keep their values.\n"} OpSYS (+ opSIMDEnd 1))

(go/var ^{:doc "sysOpNames are SYS's operations by CRm (AR19).\n"} sysOpNames (lit (map uint32 string) [4 "dc.zva"] [5 "ic.ivau"] [10 "dc.cvac"] [11 "dc.cvau"] [12 "dc.cvap"] [13 "dc.cvadp"] [14 "dc.civac"]))


(go/var opNames ^{:go/breaks [14 30 45 59 74]} (lit (array ... string) "invalid" "addi" "subi" "addr" "subr" "addx" "subx" "adc" "sbc" "andi" "orri" "eori"
    "and" "orr" "eor" "movz" "movn" "movk" "sbfm" "bfm" "ubfm" "extr" "adr" "adrp" "b" "bl" "bcond" "cbz"
    "cbnz" "tbz" "tbnz" "br" "blr" "ret" "csel" "csinc" "csinv" "csneg" "ccmp" "rbit" "rev16" "rev32" "rev"
    "clz" "cls" "udiv" "sdiv" "lslv" "lsrv" "asrv" "rorv" "madd" "msub" "smaddl" "smsubl" "umaddl" "umsubl"
    "smulh" "umulh" "ldr" "str" "ldrlit" "prfm" "ldp" "stp" "ldxr" "stxr" "ldar" "stlr" "ldop" "swp" "cas"
    "casp" "svc" "hint" "barrier" "clrex" "mrs" "msr" "brk" "udf" "crc32" "flagm" "ldapur" "stlur"))

^{:go/end 111} (go/method String ^string [^Op o]
  (when (< (conv int o) (len opNames))
    (return (aget opNames o)))

  (when (== o OpSYS)
    (return "sys"))

  (fpOpName o))




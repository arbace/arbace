  ^{:line 154} [^{:val 55824} SysNZCV (bit-or (<< 3 14) (<< 3 11) (<< 4 7) (<< 2 3) 0)]
  ^{:line 155} [^{:val 55840} SysFPCR (bit-or (<< 3 14) (<< 3 11) (<< 4 7) (<< 4 3) 0)]
  ^{:line 156} [^{:val 55841} SysFPSR (bit-or (<< 3 14) (<< 3 11) (<< 4 7) (<< 4 3) 1)]

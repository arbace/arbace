  ^{:line 158} [^{:val 56963} SysTPIDRRO (bit-or (<< 3 14) (<< 3 11) (<< 13 7) (<< 0 3) 3)]
  ^{:line 159} [^{:val 57090} SysCNTVCT (bit-or (<< 3 14) (<< 3 11) (<< 14 7) (<< 0 3) 2)]

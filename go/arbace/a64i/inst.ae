  [^{:val 82} OpFLAGM] ; FEAT_FlagM, FEAT_FlagM2 (AR18): Sys flagmNames' index; rmif's Imm the rotation and Imm2 the mask
  [^{:val 83} OpLDAPUR] ; FEAT_LRCPC2 (AR18): load-acquire RCpc, unscaled offset (Imm): Size, Signed, Wide
  [^{:val 84} OpSTLUR] ; store-release, unscaled offset (Imm)

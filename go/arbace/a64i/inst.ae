  [^{:val 55829} SysDIT (bit-or (<< 3 14) (<< 3 11) (<< 4 7) (<< 2 3) 5)] ; AR19: PSTATE.DIT (bit 24)
  [^{:val 55830} SysSSBS (bit-or (<< 3 14) (<< 3 11) (<< 4 7) (<< 2 3) 6)] ; AR19: PSTATE.SSBS (bit 12)

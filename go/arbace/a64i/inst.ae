  ^{:line 165} [^{:val 0} sysUnmodeled 0])



(go/type Inst "Inst is one instruction as a64i executes it. Registers are numbers 0-31 (31: ZR or SP by the operation's operand).\n" (struct
    ^{:line 170 :tag Op} Op
    ^{:line 171 :tag bool} Sf ; 64-bit operation
    ^{:line 172 :tag bool} S ; sets the flags
    ^{:line 173 :tag bool} N ; the operand inverted (BIC, ORN, EON), CCMN
    ^{:line 174 :tag uint8} Rd
    ^{:line 175 :tag uint8} Rn
    ^{:line 176 :tag uint8} Rm ; 255: an immediate (CCMP)
    ^{:line 177 :tag uint8} Ra
    ^{:line 178 :tag int64} Imm
    ^{:line 179 :tag int64} Imm2
    ^{:line 180 :tag uint8} Shift
    ^{:line 181 :tag uint8} Amount
    ^{:line 182 :tag uint8} Ext
    ^{:line 183 :tag uint8} Cond
    ^{:line 184 :tag uint8} Size ; a load's or store's log2 bytes
    ^{:line 185 :tag bool} Signed ; a sign-extending load
    ^{:line 186 :tag bool} Wide ; a sign-extending load to 64 bits
    ^{:line 187 :tag uint8} Mode
    ^{:line 188 :tag bool} Pair ; an exclusive pair
    ^{:line 189 :tag bool} Vreg ; a SIMD&FP register's load or store (Size 0-4: b, h, s, d, q)
    ^{:line 190 :tag bool} Acq
    ^{:line 191 :tag bool} Rel
    ^{:line 192 :tag uint64} Target ; a branch's, ADR's, ADRP's or a literal's address
    ^{:line 193 :tag uint32} Sys))



^{:go/end 201} (go/method Key "Key is the instruction's fields in one line: the decoder's and the forms' Insts of an address compare by it.\n" ^string [^{:tag (* Inst)} in]
  (fmt/Sprintf "%v v=%v sf=%v s=%v n=%v d=%d n=%d m=%d a=%d imm=%d imm2=%d sh=%d amt=%d ext=%d c=%d sz=%d sg=%v w=%v mode=%d p=%v acq=%v rel=%v t=%#x sys=%#x"
    (.-Op in) (.-Vreg in) (.-Sf in) (.-S in) (.-N in) (.-Rd in) (.-Rn in) (.-Rm in) (.-Ra in) (.-Imm in) (.-Imm2 in) (.-Shift in) (.-Amount in) (.-Ext in) (.-Cond in) (.-Size in)
    (.-Signed in) (.-Wide in) (.-Mode in) (.-Pair in) (.-Acq in) (.-Rel in) (.-Target in) (.-Sys in)))




^{:go/breaks [[5 234]] :go/end 235} (go/method Family "Family is the instruction's family (the coverage's, the injected faults' and the reports'): alu, logic, move, bitfield,\nbranch, cond, dp1, dp2, mul, ldst, pair, excl, lse, sys, fp (AR6).\n" ^string [^{:tag (* Inst)} in]
  (when (isFPOp (.-Op in))
    (return (fpFamily (.-Op in))))

  (switch (.-Op in)
    (case [OpADDI OpSUBI OpADDR OpSUBR OpADDX OpSUBX OpADC OpSBC]
      (return "alu"))
    (case [OpANDI OpORRI OpEORI OpAND OpORR OpEOR]
      (return "logic"))
    (case [OpMOVZ OpMOVN OpMOVK OpADR OpADRP]
      (return "move"))
    (case [OpSBFM OpBFM OpUBFM OpEXTR]
      (return "bitfield"))
    (case [OpB OpBL OpBCOND OpCBZ OpCBNZ OpTBZ OpTBNZ OpBR OpBLR OpRET]
      (return "branch"))
    (case [OpCSEL OpCSINC OpCSINV OpCSNEG OpCCMP OpFLAGM]
      (return "cond"))
    (case [OpRBIT OpREV16 OpREV32 OpREV OpCLZ OpCLS]
      (return "dp1"))
    (case [OpUDIV OpSDIV OpLSLV OpLSRV OpASRV OpRORV OpCRC32]
      (return "dp2"))
    (case [OpMADD OpMSUB OpSMADDL OpSMSUBL OpUMADDL OpUMSUBL OpSMULH OpUMULH]
      (return "mul"))
    (case [OpLDR OpSTR OpLDRLIT OpPRFM]
      (return "ldst"))
    (case [OpLDP OpSTP]
      (return "pair"))
    (case [OpLDXR OpSTXR OpLDAR OpSTLR OpLDAPUR OpSTLUR]
      (return "excl"))
    (case [OpLDOP OpSWP OpCAS OpCASP]
      (return "lse")))

  "sys")



(go/var ^{:doc "Families are the families' names, in order.\n"} Families (lit (slice string) "alu" "logic" "move" "bitfield" "branch" "cond" "dp1" "dp2" "mul" "ldst" "pair" "excl" "lse" "sys" "fp" "simd"))


^{:go/end 282} (go/method Name "Name is the instruction's name for the coverage: its operation and the variant the decoder tells apart.\n" ^string [^{:tag (* Inst)} in]
  (when (isFPOp (.-Op in))
    (return (fpName in)))

  ;; AR18: crc32 and crc32c by the source's width; the flag manipulation by its instruction
  (switch (.-Op in)
    (case [OpCRC32]
      (let [s "crc32"]
        (when (== (.-Sys in) 1)
          (set! s "crc32c"))

        (return (fmt/Sprintf "%s.%d" s ^int (<< 8 (.-Size in))))))
    (case [OpFLAGM]
      (return (aget (lit (slice string) "cfinv" "xaflag" "axflag" "rmif" "setf8" "setf16") (.-Sys in))))
    (case [OpSYS]
      ;; AR19: dc and ic by their operation
      (return (aget sysOpNames (.-Sys in))))
    (case [OpMSR]
      ;; AR19: MSR (immediate) of PSTATE.DIT and PSTATE.SSBS
      (when (== (.-Rm in) 255)
        (return "msr.imm"))))

  (let [s (.String (.-Op in))]
    (if (.-Sf in)
      (set! s + ".x")

      (set! s + ".w"))

    (when (.-S in)
      (set! s + ".s"))

    (when (.-N in)
      (set! s + ".n"))

    (switch (.-Op in)
      (case [OpLDR OpSTR OpLDRLIT OpLDP OpSTP OpLDXR OpSTXR OpLDAR OpSTLR OpLDAPUR OpSTLUR OpLDOP OpSWP OpCAS OpCASP]
        (when (.-Vreg in)
          (set! s + ".v"))

        (set! s + (fmt/Sprintf ".%d" ^int (<< 8 (.-Size in))))
        (when (.-Signed in)
          (set! s + ".sg"))

        (when (== (.-Op in) OpLDOP)
          (set! s + (fmt/Sprintf ".op%d" (.-Sys in))))

        (when (!= (.-Op in) OpLDRLIT)
          (set! s + (aget (lit (slice string) ".off" ".pre" ".post" ".reg") (.-Mode in))))

        (when (.-Acq in)
          (set! s + ".a"))

        (when (.-Rel in)
          (set! s + ".l"))

        (when (.-Pair in)
          (set! s + ".p")))

      (case [OpADDR OpSUBR OpAND OpORR OpEOR]
        (set! s + (aget (lit (slice string) ".lsl" ".lsr" ".asr" ".ror") (bit-and (.-Shift in) 3)))))

    ^{:line 281} s))


^{:go/end 284} (go/method String ^string [^{:tag (* Inst)} in] (.Key in))

(in-ns 'go.arbace.pyzstd) ^{:go/comments [[3 1 "// Modules/_zstd/: Copyright (c) the Python Software Foundation, under the PSF License Agreement for Python 3.14"] [4 1 "// (LICENSE.md). The port to Go: Copyright (c) the Arbace authors, under the same license."] [6 1 "// The module _zstd (queue 208z; doc/python/PYTHON-SURVEY.md, \"As built: 208z\"): CPython 3.14.10's Modules/_zstd/"] [7 1 "// (_zstdmodule.c, compressor.c, decompressor.c, zstddict.c, buffer.h, with Modules/_zstd/clinic/'s argument parsing)"] [8 1 "// ported statement for statement over zstd 1.5.7 itself, the C library built by ci's builder (arbace/clib/zstd's node"] [9 1 "// program) and called through arbace/clib, as _bz2 and _lzma are (arbace/pybz2, arbace/pylzma: their notes on memory,"] [10 1 "// the output blocks, the GIL and the finalizers hold here too). ZstdCompressor, ZstdDecompressor, ZstdDict (its"] [11 1 "// digested ZSTD_CDicts by level and its ZSTD_DDict), train_dict, finalize_dict, get_param_bounds, get_frame_size,"] [12 1 "// get_frame_info, set_parameter_types, ZstdError and the constants. compression/zstd (ZstdFile, open, compress,"] [13 1 "// decompress, the parameters' enums) is the tarball's Python over it."] [14 1 "//"] [15 1 "// The library is built without ZSTD_MULTITHREAD (tools/pyi/clib/zstd/lib.conf): nb_workers' bounds are (0, 0), so a"] [16 1 "// compressor never runs in its multithreaded mode, as on a CPython linked with a libzstd built without threads (the"] [17 1 "// mt paths are ported all the same). The GIL is held around every call into the library (CPython releases it around"] [18 1 "// the long ones): the objects' PyMutex locks are then the GIL itself. ZSTD_inBuffer and ZSTD_outBuffer are C structs"] [19 1 "// in the library's memory, their layout read from tools/pyi/clib/zstd/pyzstd.c's pyzstd_layout; the calls that take or"] [20 1 "// give a struct by value go through its pyzstd_bounds and pyzstd_finalize."] [33 1 "// zstd.h's and zdict.h's constants."] [82 1 "/* _zstdmodule.h */"] [106 1 "// _zstd_state: the module's state (one module per process here: the types are the package's)."] [113 2 "/* enum types set by set_parameter_types. */"] [120 1 "// The layout the C side gives (pyzstd_layout), read once."] [132 1 "// zstdLib is the library's program, opened on the module's first use (its import)."] [154 1 "// ZSTD_bounds, by value: pyzstd_bounds' three fields."] [170 1 "// A ZSTD_inBuffer or ZSTD_outBuffer in C memory (one of each per call, freed by its end)."] [195 1 "// cbytes is a copy of data in C memory (0 for no bytes)."] [211 1 "/* pycore_blocks_output_buffer.h, as arbace/pybz2's: the blocks are C memory, each one's bytes appended to data as\n   the next block is made (the list of bytes objects CPython keeps), so Finish copies once. */"] [223 17 "// the list's length"] [250 1 "/* buffer.h: Blocks output buffer wrapper code */"] [252 1 "/*\nInitialize the buffer, and grow the buffer.\n\n\tReturn 0 on success\n\tReturn -1 on failure\n*/"] [276 1 "/*\nInitialize the buffer, with an initial size.\n\n\tinit_size: the initial size.\n\tReturn 0 on success\n\tReturn -1 on failure\n*/"] [286 2 "/* Get block size */"] [297 2 "// Set max_length, InitWithSize doesn't do this"] [305 1 "/*\nGrow the buffer.\n\n\tReturn 0 on success\n\tReturn -1 on failure\n*/"] [312 2 "// _BlocksOutputBuffer_Grow(buffer, &ob->dst, 0)"] [320 3 "// if (rest == 0), should not grow the buffer."] [340 1 "/*\nFinish the buffer.\n\n\tReturn a bytes object on success\n\tReturn NULL on failure\n*/"] [351 1 "/* Clean up the buffer */"] [359 1 "/*\nWhether the output data has reached max_length.\n\n\tThe avail_out must be 0, please check it before calling.\n*/"] [368 1 "/* Argument conversions (clinic's and the C API's). */"] [370 1 "// PyLong_AsInt: an int or an object with __index__, in a C int."] [376 1 "// PyNumber_Index then PyLong_AsSsize_t (clinic's Py_ssize_t)."] [389 1 "// isTrue is PyObject_IsTrue (clinic's bool)."] [392 1 "// typeName is a type's name as tp_name gives it in _PyArg_BadArgument's message."] [400 1 "// badArgument is _PyArg_BadArgument."] [405 1 "// fullyQualifiedName is PyErr_Format's %T: the type's module and qualified name, the module left out for builtins"] [406 1 "// and __main__."] [415 1 "// isInt is PyLong_Check."] [418 1 "// isBytes is PyBytes_Check."] [421 1 "// PyLong_AsSize_t: an int (no __index__), in a C size_t; the error's type tells overflow."] [437 1 "// PyLong_AsUnsignedLongLong: an int (no __index__), in a C unsigned long long."] [460 1 "/* _zstdmodule.c */"] [463 2 "/* Check ZstdDict */"] [468 2 "/* Check (ZstdDict, type) */"] [483 2 "/* Wrong type */"] [487 1 "/* Format error message and set ZstdError. */"] [566 2 "/* Find parameter's name */"] [575 2 "/* Unknown parameter */"] [580 2 "/* Get parameter bounds */"] [586 2 "/* Error message */"] [597 2 "/* Prepare chunk_sizes */"] [625 1 "// csizes is chunk_sizes in C memory (an array of size_t; 0 for none)."] [641 2 "/* Check arguments */"] [646 2 "/* Check that the samples are valid and get their sizes */"] [652 2 "/* Allocate dict buffer */"] [659 2 "/* Train the dictionary */"] [667 2 "/* Check Zstandard dict error */"] [672 2 "/* Resize dict_buffer */"] [678 2 "/* Check arguments */"] [683 2 "/* Check that the samples are valid and get their sizes */"] [689 2 "/* Allocate dict buffer */"] [696 2 "/* Parameters: compressionLevel; notificationLevel 0 (no log to stderr); dictID 0 (auto mode: a 32-bit\n\t   random value): pyzstd_finalize sets them. */"] [699 2 "/* Finalize the dictionary */"] [710 2 "/* Check Zstandard dict error */"] [715 2 "/* Resize dict_buffer */"] [754 2 "/* ZSTD_getFrameContentSize */"] [757 2 "/* #define ZSTD_CONTENTSIZE_UNKNOWN (0ULL - 1)\n\t   #define ZSTD_CONTENTSIZE_ERROR   (0ULL - 2) */"] [766 2 "/* ZSTD_getDictID_fromFrame */"] [769 2 "/* Build tuple */"] [782 1 "/* zstddict.c */"] [785 2 "/* Reusable compress/decompress dictionary, they are created once and can be shared by multiple threads\n\t   concurrently, since its usage is read-only. c_dicts is int(compressionLevel) -> ZSTD_CDict* (CPython's dict\n\t   of capsules). */"] [791 2 "/* Dictionary content: C memory. */"] [795 2 "/* Dictionary id */"] [802 2 "/* All dictionaries must be at least 8 bytes */"] [816 2 "/* Get dict_id, 0 means \"raw content\" dictionary. */"] [819 2 "/* Check validity for ordinary dictionary */"] [829 1 "// ZstdDict_dealloc runs on the collector's goroutine: the frees are queued for the library's next call (clib's"] [830 1 "// Defer). A compressor or decompressor holding the dictionary is finalized first (it refers to the dictionary)."] [834 3 "/* Free ZSTD_DDict instance */"] [841 3 "/* Release dict_buffer after freeing ZSTD_CDict/ZSTD_DDict instances */"] [866 1 "/* compressor.c */"] [869 2 "/* Compression context */"] [872 2 "/* ZstdDict object in use */"] [875 2 "/* Last mode, initialized to ZSTD_e_end */"] [878 2 "/* (nbWorker >= 1) ? 1 : 0 */"] [881 2 "/* Nonzero if worker threads may still be compressing submitted data: set by any call that did not complete a\n\t   frame, including a failed one */"] [885 2 "/* Compression level */"] [892 2 "// None means the user indicates the size is unknown."] [896 2 "/* ZSTD_CONTENTSIZE_UNKNOWN is 0ULL - 1\n\t   ZSTD_CONTENTSIZE_ERROR   is 0ULL - 2\n\t   Users should only pass values < ZSTD_CONTENTSIZE_ERROR */"] [900 2 "/* Here we check for (unsigned long long)-1 as a sign of an error in PyLong_AsUnsignedLongLong */"] [918 2 "/* Set integer compression level */"] [926 2 "/* Save for generating ZSTD_CDICT */"] [929 2 "/* Set compressionLevel to compression context */"] [932 2 "/* Check error */"] [948 3 "/* Check key type */"] [969 4 "/* From the zstd library docs:\n\t\t\t   1. When nbWorkers >= 1, triggers asynchronous mode when used with ZSTD_compressStream2().\n\t\t\t   2, Default value is `0`, aka \"single-threaded mode\" : no worker is spawned, compression is\n\t\t\t      performed inside caller's thread, all invocations are blocking. */"] [978 3 "/* Set parameter to compression context */"] [981 3 "/* Check error */"] [992 2 "/* Get the ZSTD_CDict from self->c_dicts */"] [995 3 "/* Create ZSTD_CDict instance */"] [1002 3 "/* Add it to self->c_dicts */"] [1005 2 "/* else: ZSTD_CDict instance already exists */"] [1013 3 "/* Get ZSTD_CDict */"] [1018 3 "/* Reference a prepared dictionary. It overrides some compression context's parameters. */"] [1021 3 "/* Load a dictionary. It doesn't override compression context's parameters. */"] [1024 3 "/* Load a prefix */"] [1030 2 "/* Check error */"] [1038 2 "/* When compressing, use undigested dictionary by default. */"] [1051 2 "/* Compression context */"] [1062 2 "/* Last mode */"] [1069 2 "/* Set compression level */"] [1087 2 "/* Set options dictionary */"] [1094 2 "/* Load Zstandard dictionary to compression context */"] [1110 2 "/* Free compression context */"] [1112 3 "/* ZSTD_freeCCtx() (as of libzstd 1.5.7) frees the context's own copy of a dictionary loaded with\n\t\t   ZSTD_CCtx_loadDictionary() before it stops the worker threads, which may still be reading it. Starting\n\t\t   a new frame makes libzstd wait for the jobs of the previous one, and with no input it starts none. */"] [1126 2 "/* the dict is released after the compression context: the Go object refers to it until now */"] [1144 2 "/* Prepare input & output buffers */"] [1155 2 "/* Calculate output buffer's size */"] [1166 2 "/* Zstandard stream compress */"] [1170 3 "/* Check error */"] [1176 3 "/* Finished */"] [1181 3 "/* Output buffer should be exhausted, grow the buffer. */"] [1190 2 "/* Return a bytes object */"] [1212 2 "/* Prepare input & output buffers */"] [1220 2 "/* Zstandard stream compress */"] [1230 3 "/* Check error */"] [1236 3 "/* Like compress_lock_held(), output as much as possible. */"] [1243 4 "/* Finished */"] [1248 2 "/* Return a bytes object */"] [1253 2 "/* Check mode value */"] [1259 2 "/* Compress */"] [1273 3 "/* Resetting cctx's session never fail */"] [1281 2 "/* Check mode value */"] [1294 3 "/* Resetting cctx's session never fail */"] [1302 2 "/* Check the current mode */"] [1307 2 "/* Set pledged content size */"] [1316 1 "/* decompressor.c */"] [1319 2 "/* Decompression context */"] [1322 2 "/* ZstdDict object in use */"] [1325 2 "/* Unconsumed input data: C memory */"] [1330 2 "/* Unused data */"] [1333 2 "/* 0 if decompressor has (or may has) unconsumed input data, 0 or 1. */"] [1336 2 "/* For ZstdDecompressor, 0 or 1. 1 means the end of the first frame has been reached. */"] [1344 3 "/* Create ZSTD_DDict instance from dictionary content */"] [1363 3 "/* Check key type */"] [1377 3 "/* Set parameter to compression context */"] [1380 3 "/* Check error */"] [1394 3 "/* Get ZSTD_DDict */"] [1399 3 "/* Reference a prepared dictionary */"] [1402 3 "/* Load a dictionary */"] [1405 3 "/* Load a prefix */"] [1411 2 "/* Check error */"] [1418 1 "/* Load dictionary or prefix to decompression context */"] [1420 2 "/* When decompressing, use digested dictionary by default. */"] [1429 1 "/*\nDecompress implementation in pseudo code:\n\n\tinitialize_output_buffer\n\twhile True:\n\t    decompress_data\n\t    set_object_flag   # .eof\n\n\t    if output_buffer_exhausted:\n\t        if output_buffer_reached_max_length:\n\t            finish\n\t        grow_output_buffer\n\t    elif input_buffer_exhausted:\n\t        finish\n\nZSTD_decompressStream()'s size_t return value:\n\n  - 0 when a frame is completely decoded and fully flushed, zstd's internal buffer has no data.\n\n  - An error code, which can be tested using ZSTD_isError().\n\n  - Or any other value > 0, which means there is still some decoding or flushing to do to complete current frame.\n\n    Note, decompressing \"an empty input\" in any case will make it > 0.\n*/"] [1462 2 "/* Initialize the output buffer */"] [1469 3 "/* Decompress */"] [1472 3 "/* Check error */"] [1478 3 "/* Set .eof flag */"] [1480 4 "/* Stop when a frame is decompressed */"] [1485 3 "/* Need to check out before in. Maybe zstd's internal buffer still has a few bytes that can be output,\n\t\t   grow the buffer and continue. */"] [1488 4 "/* Output buffer exhausted */"] [1490 4 "/* Output buffer reached max_length */"] [1495 4 "/* Grow output buffer */"] [1501 4 "/* Finished */"] [1506 2 "/* Return a bytes object */"] [1511 2 "/* Reset variables */"] [1517 2 "/* Reset variables in one operation */"] [1521 2 "/* Resetting session is guaranteed to never fail */"] [1526 2 "/* Check .eof flag */"] [1535 23 "// the caller's buffer in C memory"] [1544 3 "/* Reset decompressor's states/session */"] [1549 2 "/* Prepare input buffer w/wo unconsumed data */"] [1551 3 "/* No unconsumed data */"] [1560 3 "/* Has unconsumed data, fast path for b'' */"] [1565 3 "/* Has unconsumed data */"] [1568 3 "/* Unconsumed data size in input_buffer */"] [1571 3 "/* Number of bytes we can append to input buffer */"] [1574 3 "/* Number of bytes we can append if we move existing contents to beginning of buffer */"] [1580 4 "/* Allocate with new size */"] [1586 4 "/* Copy unconsumed data to the beginning of new buffer */"] [1589 4 "/* Switch to new buffer */"] [1594 4 "/* Set begin & end position */"] [1598 4 "/* Move unconsumed data to the beginning. Overlap is possible, so use memmove(). */"] [1601 4 "/* Set begin & end position */"] [1606 3 "/* Copy data to input buffer */"] [1613 2 "/* Decompress */"] [1619 2 "/* Unconsumed input data */"] [1628 4 "/* Clear input_buffer */"] [1638 4 "/* Discard buffer if it's too small (resizing it may needlessly copy the current contents) */"] [1645 4 "/* Allocate if necessary */"] [1654 4 "/* Copy unconsumed data */"] [1659 4 "/* Use input buffer */"] [1671 2 "/* needs_input flag */"] [1674 2 "/* Decompression context */"] [1681 2 "/* Load Zstandard dictionary to decompression context */"] [1690 2 "/* Set options dictionary */"] [1701 4 "/* Free decompression context */"] [1703 4 "/* Free unconsumed input data buffer */"] [1728 1 "/* Module initialization. */"] [1734 3 "// a C type's instance with state and no __getstate__ (object_getstate): \"cannot pickle 'TP_NAME' object\""] [1735 3 "// (protocols 0 and 1: copyreg's _reduce_ex, with the type's __name__)"] [1755 2 "/* ZstdDict */"] [1757 3 "// clinic: ZstdDict(dict_content, /, *, is_raw=False)"] [1758 3 "// _PyArg_UnpackKeywords: the positional count first, then the keywords"] [1798 2 "/* ZstdCompressor */"] [1862 2 "/* Add ZSTD_EndDirective enum members to ZstdCompressor */"] [1867 2 "/* ZstdDecompressor */"] [1910 1 "// zstdMakeModule is PyInit__zstd with _zstd_exec."] [2034 2 "/* Add constants */"] [2043 3 "/* Add zstd compression parameters. All should also be in cp_list. */"] [2055 3 "/* Add zstd decompression parameters. All should also be in dp_list. */"] [2057 3 "/* Add ZSTD_strategy enum members */"] [2073 1 "// retLen is Py_SIZE of a bytes result."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[464 31] [469 27] [604 12] [604 31] [955 36] [958 40] [963 45] [1082 45] [1089 50] [1096 47] [1161 83] [1183 46] [1215 55] [1238 46] [1370 36] [1373 40] [1463 63] [1496 46] [1683 47] [1692 50] [1739 34] [1740 26] [1776 39] [1827 37] [1840 37] [1893 39]] :go/trails [[548 36] [552 41] [2060 67]]} (go/file "pyzstd.go" :imports [

    ;; Modules/_zstd/: Copyright (c) the Python Software Foundation, under the PSF License Agreement for Python 3.14
    ;; (LICENSE.md). The port to Go: Copyright (c) the Arbace authors, under the same license.

    ;; The module _zstd (queue 208z; doc/python/PYTHON-SURVEY.md, "As built: 208z"): CPython 3.14.10's Modules/_zstd/
    ;; (_zstdmodule.c, compressor.c, decompressor.c, zstddict.c, buffer.h, with Modules/_zstd/clinic/'s argument parsing)
    ;; ported statement for statement over zstd 1.5.7 itself, the C library built by ci's builder (arbace/clib/zstd's node
    ;; program) and called through arbace/clib, as _bz2 and _lzma are (arbace/pybz2, arbace/pylzma: their notes on memory,
    ;; the output blocks, the GIL and the finalizers hold here too). ZstdCompressor, ZstdDecompressor, ZstdDict (its
    ;; digested ZSTD_CDicts by level and its ZSTD_DDict), train_dict, finalize_dict, get_param_bounds, get_frame_size,
    ;; get_frame_info, set_parameter_types, ZstdError and the constants. compression/zstd (ZstdFile, open, compress,
    ;; decompress, the parameters' enums) is the tarball's Python over it.
    ;;
    ;; The library is built without ZSTD_MULTITHREAD (tools/pyi/clib/zstd/lib.conf): nb_workers' bounds are (0, 0), so a
    ;; compressor never runs in its multithreaded mode, as on a CPython linked with a libzstd built without threads (the
    ;; mt paths are ported all the same). The GIL is held around every call into the library (CPython releases it around
    ;; the long ones): the objects' PyMutex locks are then the GIL itself. ZSTD_inBuffer and ZSTD_outBuffer are C structs
    ;; in the library's memory, their layout read from tools/pyi/clib/zstd/pyzstd.c's pyzstd_layout; the calls that take or
    ;; give a struct by value go through its pyzstd_bounds and pyzstd_finalize.



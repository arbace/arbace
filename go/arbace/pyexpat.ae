(ns go.arbace.pyexpat
  (:require [arbace.go :as go]))

(go/package pyexpat
  :path "arbace/pyexpat"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["pyexpat.go"]
  :init-order [EXPAT_GetCurrentLineNumber EXPAT_GetCurrentColumnNumber EXPAT_GetCurrentByteIndex ExpatMemoryHandler pyexpatXmlparserType pyexpatErrIndicator my_DefaultHandlerExpand template_buffer error_info_of]
  :positions :full)

(load "pyexpat/pyexpat")

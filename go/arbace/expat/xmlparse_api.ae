n  files  (the\n   \"Software\"),  to  deal in  the  Software  without restriction,  including\n   without  limitation the  rights  to use,  copy,  modify, merge,  publish,\n   distribute, sublicense, and/or sell copies of the Software, and to permit\n   persons  to whom  the Software  is  furnished to  do so,  subject to  the\n   following conditions:\n\n   The above copyright  notice and this permission notice  shall be included\n   in all copies or substantial portions of the Software.\n\n   THE  SOFTWARE  IS  PROVIDED  \"AS  IS\",  WITHOUT  WARRANTY  OF  ANY  KIND,\n   EXPRESS  OR IMPLIED,  INCLUDING  BUT  NOT LIMITED  TO  THE WARRANTIES  OF\n   MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN\n   NO EVENT SHALL THE AUTHORS OR  COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM,\n   DAMAGES OR  OTHER LIABILITY, WHETHER  IN AN  ACTION OF CONTRACT,  TORT OR\n   OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE\n   USE OR OTHER DEALINGS IN THE SOFTWARE.\n\n   SPDX-License-Identifier: MIT\n\n   The port to Go (queue 202e): Copyright (c) the Arbace authors, under the same MIT license.\n*/"] [96 1 "// ---- xmlparse.c lines 844-3394: from expat_heap_stat through"] [97 1 "// XML_GetPropertyUInt64 ----"] [99 1 "// ---- MALLOC, REALLOC, FREE (the macros of XML_GE == 1, C lines 834-842)."] [100 1 "// __LINE__ is lost (0), as the foundation decided. ----"] [110 1 "// api_fmt_8_2f is C's printf(\"%8.2f\", x) for glibc's spellings of the"] [111 1 "// non-finite values (inf, -inf, nan, -nan), which Go's fmt spells otherwise."] [127 1 "// api_anyEq is C's comparison of two void * (userData, handlerArg): Go's =="] [128 1 "// on the interfaces, false where Go cannot compare the dynamic type."] [139 2 "// NOTE: This can be +infinity or -nan"] [155 2 "// Detect integer overflow"] [163 4 "// NOTE: This can be +infinity when dividing by zero but not -nan"] [178 1 "// expat_malloc: true for C's non-NULL result; the caller then allocates the Go object."] [180 2 "// Detect integer overflow"] [191 16 "// i.e. signal integer overflow as out-of-memory"] [196 16 "// i.e. signal violation as out-of-memory"] [199 2 "// Actually allocate: the caller does (Go's allocator; m_mem.malloc_fcn"] [200 2 "// is never called), and the in-block recorded size is the size the"] [201 2 "// caller passes to FREE/REALLOC later."] [203 2 "// Update accounting"] [206 2 "// Report as needed"] [219 1 "// expat_free: size is the block's (C reads it from the block's header), NULL_BLOCK for NULL."] [230 2 "// Extract size (to the eyes of malloc_fcn/realloc_fcn): the caller's."] [233 2 "// Update accounting"] [237 2 "// Report as needed"] [244 2 "// NOTE: This may be freeing rootParser, so freeing has to come last"] [245 2 "// (Go: the garbage collector frees the block; free_fcn is never called.)"] [248 1 "// expat_realloc: oldSize is the block's (NULL_BLOCK for NULL: then it is expat_malloc); size 0 frees and returns false."] [264 2 "// Extract original size (to the eyes of the caller): the caller's."] [267 2 "// Classify upcoming change"] [276 2 "// Ask for permission from accounting"] [279 17 "// i.e. signal violation as out-of-memory"] [283 2 "// Detect and prevent integer overflow"] [288 2 "// Actually allocate: the caller does (realloc_fcn is never called)."] [290 2 "// Update accounting"] [294 11 "// i.e. decrease"] [299 2 "// Report as needed"] [313 2 "// Update in-block recorded size: the caller keeps size beside the block."] [327 1 "// \"xml=http://www.w3.org/XML/1998/namespace\""] [338 1 "// HAVE_ARC4RANDOM_BUF and HAVE_ARC4RANDOM are not defined (expat_config.h),"] [339 1 "// and this is not _WIN32: gettimeofday's microseconds."] [343 2 "/* Microseconds time is <20 bits entropy */"] [358 1 "// XML_POOR_ENTROPY and no HAVE_* provider (expat_config.h): only the"] [359 1 "// self-made fallback is compiled."] [363 2 "/* .. and self-made low quality for backup: */"] [367 2 "/* Process ID is 0 bits entropy if attacker has local access */"] [370 2 "/* Factors are 2^31-1 and 2^61-1 (Mersenne primes M31 and M61) */"] [402 1 "// callUnknownEncodingConvert is a CONVERTER: data is the parser."] [415 3 "// Heuristic: don't try to parse a partial token again until the amount of"] [416 3 "// available data has increased significantly."] [418 3 "// ...but *do* try anyway if we're close to causing a reallocation."] [422 3 "// m_lastBufferRequestSize is never assigned a value < 0, so the cast is ok"] [427 20 "// callers may expect this to be set"] [431 2 "// Run in a loop to eliminate dangerous recursion depths"] [435 3 "// Use endPtr as the new start in each iteration, since it will"] [436 3 "// be set to the next start point by m_processor."] [439 3 "// Make parsing status (and in particular XML_SUSPENDED) take"] [440 3 "// precedence over re-enter flag when they disagree"] [456 3 "// if we consumed nothing, remember what we had on this parse attempt."] [466 1 "/* only valid for root parser */"] [468 2 "/* hash functions must be initialized before setContext() is called */"] [474 3 "/* implicit context only set for root parser, since child\n\t\t   parsers (i.e. external entity parsers) will inherit it\n\t\t*/"] [498 2 "// C mallocs sizeof(size_t) + EXPAT_MALLOC_PADDING + sizeof(struct"] [499 2 "// XML_ParserStruct) bytes (memsuite's malloc_fcn, else malloc) and records"] [500 2 "// the size in front: Go allocates the struct (FREE(parser, parser) is"] [501 2 "// FREE(parser, sizeof_XML_ParserStruct))."] [515 4 "// C stores malloc, realloc and free: nil (never called)."] [527 2 "// Initialize .m_alloc_tracker"] [534 3 "// NOTE: This initialization needs to come this early because these fields"] [535 3 "//       are read by allocation tracking code"] [542 2 "// Record XML_ParserStruct allocation we did a few lines up before"] [548 2 "// Report on allocation"] [616 4 "// We need to stop the upcoming call to XML_ParserFree from happily"] [617 4 "// destroying parser->m_dtd because the DTD is shared with the parent"] [618 4 "// parser and the only guard that keeps XML_ParserFree from destroying"] [619 4 "// parser->m_dtd is parser->m_isParamEntity but it will be set to"] [620 4 "// XML_TRUE only later in XML_ExternalEntityParserCreate (or not at all)."] [638 1 "// api_attsBlock is the size of the block C's parser->m_atts points to"] [639 1 "// (m_atts holds the entries C allocated), NULL_BLOCK for NULL."] [712 2 "// Reentry can only be triggered inside m_processor calls"] [731 1 "/* moves list of bindings to m_freeBindingList */"] [741 1 "/* Moves a list of entities onto the start of another list. */"] [761 2 "// The application-defined release callback may access the parser, so it"] [762 2 "// must run before any parser state is freed."] [766 2 "/* move m_tagStack to m_freeTagList */"] [776 2 "/* move m_openInternalEntities to m_freeEntities */"] [778 2 "/* move m_openAttributeEntities to m_freeEntities (i.e. same task but for\n\t * attributes) */"] [781 2 "/* move m_openValueEntities to m_freeEntities (i.e. same task but for value\n\t * entities) */"] [814 2 "/* Block after XML_Parse()/XML_ParseBuffer() has been called.\n\t   XXX There's no way for the caller to determine which of the\n\t   XXX possible error cases caused the XML_STATUS_ERROR return.\n\t*/"] [822 2 "/* Get rid of any previous encoding name */"] [826 3 "/* No new encoding name */"] [829 3 "/* Copy the new encoding name into allocated memory */"] [872 2 "/* Note that the new parser shares the same hash secret as the old\n\t   parser, so that dtdCopy and copyEntityTable can lookup values\n\t   from hash tables associated with either parser without us having\n\t   to worry which hash secrets each table has.\n\t*/"] [881 2 "/* Validate the oldParser parameter before we pull everything out of it */"] [886 2 "/* Stash the original parser contents on the stack */"] [918 2 "/* Note that the new parser shares the same hash secret as the old\n\t   parser, so that dtdCopy and copyEntityTable can lookup values\n\t   from hash tables associated with either parser without us having\n\t   to worry which hash secrets each table has.\n\t*/"] [989 3 "/* The DTD instance referenced by parser->m_dtd is shared between the\n\t\t   document's root parser and external PE parsers, therefore one does not\n\t\t   need to call setContext. In addition, one also *must* not call\n\t\t   setContext, because this would overwrite existing prefix->binding\n\t\t   pointers in parser->m_dtd with ones that get destroyed with the external\n\t\t   PE parser. This would leave those prefixes with dangling pointers.\n\t\t*/"] [1020 2 "// The application-defined release callback may access the parser, so it"] [1021 2 "// must run before any parser state is freed."] [1025 2 "/* free m_tagStack and m_freeTagList */"] [1042 2 "/* free m_openInternalEntities */"] [1049 2 "/* free m_openAttributeEntities */"] [1056 2 "/* free m_openValueEntities */"] [1063 2 "/* free m_freeEntities */"] [1076 2 "/* external parameter entity parsers share the DTD structure\n\t   parser->m_dtd with the root parser, so we must not destroy it\n\t*/"] [1088 2 "// NOTE: We are avoiding FREE(..) here because parser->m_buffer"] [1089 2 "//       is not being allocated with MALLOC(..) but with plain"] [1090 2 "//       .malloc_fcn(..)."] [1091 2 "// (Go: parser->m_mem.free_fcn(parser->m_buffer) is the garbage collector's.)"] [1108 2 "/* block after XML_Parse()/XML_ParseBuffer() has been called */"] [1120 2 "/* block after XML_Parse()/XML_ParseBuffer() has been called */"] [1318 1 "// arg is C's void *, stored as (XML_Parser)arg: a non-parser arg is stored as"] [1319 1 "// nil (Go cannot cast it); a nil XML_Parser in arg is C's NULL."] [1374 2 "/* block after XML_Parse()/XML_ParseBuffer() has been called */"] [1382 1 "// The body of XML_SetHashSalt, so that Expat's own tests can reach it"] [1383 1 "// without tripping the deprecation of the public function."] [1392 2 "/* block after XML_Parse()/XML_ParseBuffer() has been called */"] [1400 22 "// to remain backwards compatible"] [1413 1 "// DEPRECATED since Expat 2.8.0."] [1418 1 "// entropy: C's const uint8_t entropy[16]; nil is NULL."] [1431 2 "/* block after XML_Parse()/XML_ParseBuffer() has been called */"] [1472 2 "// XML_CONTEXT_BYTES is 1024: C's `#if XML_CONTEXT_BYTES == 0` branch is not compiled."] [1478 23 "// make sure s==NULL && len!=0 was rejected above"] [1505 3 "/* Has someone called XML_GetBuffer successfully before? */"] [1525 2 "// Detect and avoid integer overflow"] [1557 12 "/* should not happen */"] [1567 1 "/* Modifies `parser`’s buffer to be backed by `newBuf`. */"] [1573 3 "// NOTE: We are avoiding FREE(..) here because parser->m_buffer"] [1574 3 "//       is not being allocated with MALLOC(..) but with plain"] [1575 3 "//       .malloc_fcn(..)."] [1576 3 "// (Go: parser->m_mem.free_fcn(parser->m_buffer) is the garbage collector's.)"] [1581 3 "/* This must be a brand new buffer with no data in it yet */"] [1606 2 "// whether or not the request succeeds, `len` seems to be the app's preferred"] [1607 2 "// buffer fill size; remember it."] [1611 3 "/* Do not invoke signed arithmetic overflow: */"] [1624 3 "/* Detect and prevent integer overflow */"] [1634 5 "/* The buffer pointers cannot be NULL here; we have at least some bytes\n\t\t\t\t * in the buffer */"] [1647 5 "/* Do not invoke signed arithmetic overflow: */"] [1657 4 "// NOTE: We are avoiding MALLOC(..) here to leave limiting"] [1658 4 "//       the input size to the application using Expat."] [1659 4 "// (Go: C's parser->m_mem.malloc_fcn(bufferSize), which cannot fail here.)"] [1775 1 "// DEPRECATED since Expat 2.9.0."] [1777 2 "// NOTE: XML_Index is known to wrap around for >2 GiB content"] [1778 2 "//       on 32bit machines and 64bit Windows, unless (non-default and"] [1779 2 "//       uncommon) XML_LARGE_SIZE is defined."] [1780 2 "//       That's a bug and it only lives on because we cannot break"] [1781 2 "//       ABI compatibility of public API."] [1795 1 "// DEPRECATED since Expat 2.9.0."] [1797 2 "// NOTE: int is known to wrap around for >2 GiB content."] [1798 2 "//       That's a bug and it only lives on because we cannot break"] [1799 2 "//       ABI compatibility of public API."] [1819 1 "// DEPRECATED since Expat 2.9.0."] [1834 2 "// NOTE: int is known to wrap around for >2 GiB content."] [1835 2 "//       That's a bug and it only lives on because we cannot break"] [1836 2 "//       ABI compatibility of public API."] [1860 1 "// DEPRECATED since Expat 2.9.0."] [1862 2 "// NOTE: XML_Size is known to wrap around for >4 GiB content"] [1863 2 "//       on 32bit machines and 64bit Windows, unless (non-default and"] [1864 2 "//       uncommon) XML_LARGE_SIZE is defined."] [1865 2 "//       That's a bug and it only lives on because we cannot break"] [1866 2 "//       ABI compatibility of public API."] [1882 1 "// DEPRECATED since Expat 2.9.0."] [1884 2 "// NOTE: XML_Size is known to wrap around for >4 GiB content"] [1885 2 "//       on 32bit machines and 64bit Windows, unless (non-default and"] [1886 2 "//       uncommon) XML_LARGE_SIZE is defined."] [1887 2 "//       That's a bug and it only lives on because we cannot break"] [1888 2 "//       ABI compatibility of public API."] [1897 2 "// NOTE: We are avoiding FREE(..) here because the content model"] [1898 2 "//       has been created using plain .malloc_fcn(..) rather than MALLOC(..)."] [1899 2 "// (Go: parser->m_mem.free_fcn(model) is the garbage collector's.)"] [1908 2 "// NOTE: We are avoiding MALLOC(..) here to not include"] [1909 2 "//       user allocations with allocation tracking and limiting."] [1910 2 "// (Go: C's parser->m_mem.malloc_fcn(size).)"] [1919 2 "// NOTE: We are avoiding REALLOC(..) here to not include"] [1920 2 "//       user allocations with allocation tracking and limiting."] [1921 2 "// (Go: C's parser->m_mem.realloc_fcn(ptr, size), realloc's semantics:"] [1922 2 "// NULL is malloc, size 0 frees and gives NULL, else the contents are kept"] [19
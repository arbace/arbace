(in-ns 'go.arbace.expat) ^{:go/comments [[1 1 "/* e3ca845466942140c9af531ac57808c4650116df5d6dbeda3b6546d2548a586e (2.9.0+)\n                            __  __            _\n                         ___\\ \\/ /_ __   __ _| |_\n                        / _ \\\\  /| '_ \\ / _` | __|\n                       |  __//  \\| |_) | (_| | |_\n                        \\___/_/\\_\\ .__/ \\__,_|\\__|\n                                 |_| XML parser\n\n   Copyright (c) 1997-2000 Thai Open Source Software Center Ltd\n   Copyright (c) 2000      Clark Cooper <coopercc@users.sourceforge.net>\n   Copyright (c) 2000-2006 Fred L. Drake, Jr. <fdrake@users.sourceforge.net>\n   Copyright (c) 2001-2002 Greg Stein <gstein@users.sourceforge.net>\n   Copyright (c) 2002-2016 Karl Waclawek <karl@waclawek.net>\n   Copyright (c) 2005-2009 Steven Solie <steven@solie.ca>\n   Copyright (c) 2016      Eric Rahm <erahm@mozilla.com>\n   Copyright (c) 2016-2026 Sebastian Pipping <sebastian@pipping.org>\n   Copyright (c) 2016      Gaurav <g.gupta@samsung.com>\n   Copyright (c) 2016      Thomas Beutlich <tc@tbeu.de>\n   Copyright (c) 2016      Gustavo Grieco <gustavo.grieco@imag.fr>\n   Copyright (c) 2016      Pascal Cuoq <cuoq@trust-in-soft.com>\n   Copyright (c) 2016      Ed Schouten <ed@nuxi.nl>\n   Copyright (c) 2017-2022 Rhodri James <rhodri@wildebeest.org.uk>\n   Copyright (c) 2017      Václav Slavík <vaclav@slavik.io>\n   Copyright (c) 2017      Viktor Szakats <commit@vsz.me>\n   Copyright (c) 2017      Chanho Park <chanho61.park@samsung.com>\n   Copyright (c) 2017      Rolf Eike Beer <eike@sf-mail.de>\n   Copyright (c) 2017      Hans Wennborg <hans@chromium.org>\n   Copyright (c) 2018      Anton Maklakov <antmak.pub@gmail.com>\n   Copyright (c) 2018      Benjamin Peterson <benjamin@python.org>\n   Copyright (c) 2018      Marco Maggi <marco.maggi-ipsu@poste.it>\n   Copyright (c) 2018      Mariusz Zaborski <oshogbo@vexillium.org>\n   Copyright (c) 2019      David Loffredo <loffredo@steptools.com>\n   Copyright (c) 2019-2020 Ben Wagner <bungeman@chromium.org>\n   Copyright (c) 2019      Vadim Zeitlin <vadim@zeitlins.org>\n   Copyright (c) 2021      Donghee Na <donghee.na@python.org>\n   Copyright (c) 2022      Samanta Navarro <ferivoz@riseup.net>\n   Copyright (c) 2022      Jeffrey Walton <noloader@gmail.com>\n   Copyright (c) 2022      Jann Horn <jannh@google.com>\n   Copyright (c) 2022      Sean McBride <sean@rogue-research.com>\n   Copyright (c) 2023      Owain Davies <owaind@bath.edu>\n   Copyright (c) 2023-2024 Sony Corporation / Snild Dolkow <snild@sony.com>\n   Copyright (c) 2024-2025 Berkay Eren Ürün <berkay.ueruen@siemens.com>\n   Copyright (c) 2024      Hanno Böck <hanno@gentoo.org>\n   Copyright (c) 2025-2026 Matthew Fernandez <matthew.fernandez@gmail.com>\n   Copyright (c) 2025      Atrem Borovik <polzovatellllk@gmail.com>\n   Copyright (c) 2025      Alfonso Gregory <gfunni234@gmail.com>\n   Copyright (c) 2026      Rosen Penev <rosenp@gmail.com>\n   Copyright (c) 2026      Francesco Bertolaccini\n   Copyright (c) 2026      Christian Ng <christianrng@berkeley.edu>\n   Copyright (c) 2026      Nick Begg <nick@stunttruck.net>\n   Copyright (c) 2026      Kartik Kenchi <netliomax25@gmail.com>\n   Copyright (c) 2026      Haris Hussain <hextheshadow0x@gmail.com>\n   Copyright (c) 2026      Evgeny Kotkov <kotkov@apache.org>\n   Copyright (c) 2026      Darren Carreras <carrerasdarren@gmail.com>\n   Copyright (c) 2026      Alberto Maschietto <albertomaschietto9@gmail.com>\n   Copyright (c) 2026      Zeyou Liu <zeyouliu@tencent.com>\n   Copyright (c) 2026      Stan Ulbrych <stan@python.org>\n   Copyright (c) 2026      Braian Plaku <braianplaku@gmail.com>\n   Copyright (c) 2026      Filippo Tedeschi <filippotedeschi98@gmail.com>\n   Copyright (c) 2026      Junki Lee <junkilee80@gmail.com>\n   Licensed under the MIT license:\n\n   Permission is  hereby granted,  free of charge,  to any  person obtaining\n   a  copy  of  this  software   and  associated  documentation  files  (the\n   \"Software\"),  to  deal in  the  Software  without restriction,  including\n   without  limitation the  rights  to use,  copy,  modify, merge,  publish,\n   distribute, sublicense, and/or sell copies of the Software, and to permit\n   persons  to whom  the Software  is  furnished to  do so,  subject to  the\n   following conditions:\n\n   The above copyright  notice and this permission notice  shall be included\n   in all copies or substantial portions of the Software.\n\n   THE  SOFTWARE  IS  PROVIDED  \"AS  IS\",  WITHOUT  WARRANTY  OF  ANY  KIND,\n   EXPRESS  OR IMPLIED,  INCLUDING  BUT  NOT LIMITED  TO  THE WARRANTIES  OF\n   MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN\n   NO EVENT SHALL THE AUTHORS OR  COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM,\n   DAMAGES OR  OTHER LIABILITY, WHETHER  IN AN  ACTION OF CONTRACT,  TORT OR\n   OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE\n   USE OR OTHER DEALINGS IN THE SOFTWARE.\n\n   SPDX-License-Identifier: MIT\n\n   The port to Go (queue 202e): Copyright (c) the Arbace authors, under the same MIT license.\n*/"] [94 1 "// ---- xmlparse.c lines 6838-end: storeAttributeValue to getDebugLevel"] [95 1 "// (storeSelfEntityValue is XML_GE == 0's: not compiled). ----"] [97 1 "// dtd_namedBlock is the size of a hash table entry for FREE: NULL_BLOCK for"] [98 1 "// NULL, else the size lookup gave it."] [106 1 "// dtd_blockBytes is a pool BLOCK's C size, offsetof(BLOCK, s) + size *"] [107 1 "// sizeof(XML_Char) (poolBytesToAllocateFor's result for its size)."] [112 1 "// dtd_defaultAttsBlock is the size of an ELEMENT_TYPE's defaultAtts array"] [113 1 "// (allocDefaultAtts entries), NULL_BLOCK for NULL."] [135 4 "/* Set a safe default value in case 'next' does not get set */"] [144 5 "// Check if entity is complete, if not, mark down how much of it is"] [145 5 "// processed. A XML_SUSPENDED check here is not required as"] [146 5 "// appendAttributeValue will never suspend the parser."] [153 5 "// Entity is complete. We cannot close it here since we need to first"] [154 5 "// process its possible inner entities (which are added to the"] [155 5 "// m_openAttributeEntities during appendAttributeValue)"] [158 6 "// End of entity processing, \"if\" block skips the rest"] [160 4 "// Remove fully processed openEntity from open entity list."] [162 4 "// openEntity is m_openAttributeEntities' head, since we set it at the"] [163 4 "// start of this function and because we skipped appendAttributeValue call"] [164 4 "// with hasMore set to false. This means we can directly remove the head"] [165 4 "// of m_openAttributeEntities"] [170 4 "/* put openEntity back in list of free instances */"] [175 3 "// Break if an error occurred or there is nothing left to process"] [194 22 "/* save one level of indirection */"] [197 15 "/* XmlAttributeValueTok doesn't always set the last arg */"] [229 34 "/* space */"] [234 5 "/* The XmlEncode() functions can never return 0 here.  That\n\t\t\t\t * error return happens if the code point passed in is either\n\t\t\t\t * negative or greater than or equal to 0x110000.  The\n\t\t\t\t * XmlCharRefNumber() functions will all return a number\n\t\t\t\t * strictly less than 0x110000 or a negative value if an error\n\t\t\t\t * occurred.  The negative value is intercepted above, so\n\t\t\t\t * XmlEncode() is never passed a value it might return an\n\t\t\t\t * error for.\n\t\t\t\t */"] [270 6 "/* NOTE: We are replacing 4-6 characters original input for 1 character\n\t\t\t\t\t *       so there is no amplification and hence recording without\n\t\t\t\t\t *       protection. */"] [273 6 "// (char *)&ch: a one-character block holding ch."] [291 5 "/* First, determine if a check for an existing declaration is needed;\n\t\t\t\t   if yes, check that the entity exists, and that it is internal.\n\t\t\t\t*/"] [294 28 "/* are we called from prolog? */"] [302 14 "/* if (pool == &parser->m_tempPool): we are called from content */"] [312 6 "/* Cannot report skipped entity here - see comments on\n\t\t\t\t\t   parser->m_skippedEntityHandler.\n\t\t\t\t\tif (parser->m_skippedEntityHandler) {\n\t\t\t\t\t  beforeHandler(parser);\n\t\t\t\t\t  parser->m_skippedEntityHandler(parser->m_handlerArg, name, 0);\n\t\t\t\t\t  afterHandler(parser);\n\t\t\t\t\t}\n\t\t\t\t\t*/"] [320 6 "/* Cannot call the default handler because this would be\n\t\t\t\t\t   out of sync with the call to the startElementHandler.\n\t\t\t\t\tif ((pool == &parser->m_tempPool) && parser->m_defaultHandler)\n\t\t\t\t\t  reportDefault(parser, enc, ptr, next);\n\t\t\t\t\t*/"] [329 7 "/* It does not appear that this line can be executed.\n\t\t\t\t\t\t *\n\t\t\t\t\t\t * The \"if (entity->open)\" check catches recursive entity\n\t\t\t\t\t\t * definitions.  In order to be called with an open\n\t\t\t\t\t\t * entity, it must have gone through this code before and\n\t\t\t\t\t\t * been through the recursive call to\n\t\t\t\t\t\t * appendAttributeValue() some lines below.  That call\n\t\t\t\t\t\t * sets the local encoding (\"enc\") to the parser's\n\t\t\t\t\t\t * internal encoding (internal_utf8 or internal_utf16),\n\t\t\t\t\t\t * which can never be the same as the principle encoding.\n\t\t\t\t\t\t * It doesn't appear there is another code path that gets\n\t\t\t\t\t\t * here with entity->open being TRUE.\n\t\t\t\t\t\t *\n\t\t\t\t\t\t * Since it is not certain that this logic is watertight,\n\t\t\t\t\t\t * we keep the line and merely exclude it from coverage\n\t\t\t\t\t\t * tests.\n\t\t\t\t\t\t */"] [346 31 "/* LCOV_EXCL_LINE */"] [371 4 "/* The only token returned by XmlAttributeValueTok() that does\n\t\t\t * not have an explicit case here is XML_TOK_PARTIAL_CHAR.\n\t\t\t * Getting that would require an entity name to contain an\n\t\t\t * incomplete XML character (e.g. \\xE2\\x82); however previous\n\t\t\t * tokenisers will have already recognised and rejected such\n\t\t\t * names before XmlAttributeValueTok() gets a look-in.  This\n\t\t\t * default case should be retained as a safety net, but the code\n\t\t\t * excluded from coverage tests.\n\t\t\t *\n\t\t\t * LCOV_EXCL_START\n\t\t\t */"] [386 4 "/* LCOV_EXCL_STOP */"] [390 2 "/* not reached */"] [394 22 "/* save one level of indirection */"] [399 2 "/* never return Null for the value argument in EntityDeclHandler,\n\t   since this would indicate an external entity; therefore we\n\t   have to make sure that entityValuePool.start is not null */"] [410 2 "/* Nothing to tokenize. */"] [417 24 "/* XmlEntityValueTok doesn't always set the last arg */"] [442 6 "/* not a well-formedness error - see XML 1.0: WFC Entity Declared */"] [443 6 "/* cannot report skipped entity here - see comments on\n\t\t\t\t\t   parser->m_skippedEntityHandler\n\t\t\t\t\tif (parser->m_skippedEntityHandler) {\n\t\t\t\t\t  beforeHandler(parser);\n\t\t\t\t\t  parser->m_skippedEntityHandler(parser->m_handlerArg, name, 0);\n\t\t\t\t\t  afterHandler(parser);\n\t\t\t\t\t}\n\t\t\t\t\t*/"] [491 4 "/* In the internal subset, PE references are not legal\n\t\t\t   within markup declarations, e.g entity values in this case. */"] [524 5 "/* The XmlEncode() functions can never return 0 here.  That\n\t\t\t\t * error return happens if the code point passed in is either\n\t\t\t\t * negative or greater than or equal to 0x110000.  The\n\t\t\t\t * XmlCharRefNumber() functions will all return a number\n\t\t\t\t * strictly less than 0x110000 or a negative value if an error\n\t\t\t\t * occurred.  The negative value is intercepted above, so\n\t\t\t\t * XmlEncode() is never passed a value it might return an\n\t\t\t\t * error for.\n\t\t\t\t */"] [551 4 "/* This default case should be unnecessary -- all the tokens\n\t\t\t * that XmlEntityValueTok() can return have their own explicit\n\t\t\t * cases -- but should be retained for safety.  We do however\n\t\t\t * exclude it from the coverage statistics.\n\t\t\t *\n\t\t\t * LCOV_EXCL_START\n\t\t\t */"] [563 4 "/* LCOV_EXCL_STOP */"] [569 2 "// If 'nextPtr' is given, it should be updated during the processing"] [591 4 "/* Set a safe default value in case 'next' does not get set */"] [600 5 "// Check if entity is complete, if not, mark down how much of it is"] [601 5 "// processed. A XML_SUSPENDED check here is not required as"] [602 5 "// appendAttributeValue will never suspend the parser."] [608 5 "// Entity is complete. We cannot close it here since we need to first"] [609 5 "// process its possible inner entities (which are added to the"] [610 5 "// m_openValueEntities during storeEntityValue)"] [613 6 "// End of entity processing, \"if\" block skips the rest"] [615 4 "// Remove fully processed openEntity from open entity list."] [617 4 "// openEntity is m_openValueEntities' head, since we set it at the"] [618 4 "// start of this function and because we skipped storeEntityValue call"] [619 4 "// with hasMore set to false. This means we can directly remove the head"] [620 4 "// of m_openValueEntities"] [625 4 "/* put openEntity back in list of free instances */"] [630 3 "// Break if an error occurred or there is nothing left to process"] [732 4 "/* To get here, two things must be true; the parser must be\n\t\t\t * using a character encoding that is not the same as the\n\t\t\t * encoding passed in, and the encoding passed in must need\n\t\t\t * conversion to the internal format (UTF-8 unless XML_UNICODE\n\t\t\t * is defined).  The only occasions on which the encoding passed\n\t\t\t * in is not the same as the parser's encoding are when it is\n\t\t\t * the internal encoding (e.g. a previously defined parameter\n\t\t\t * entity, already converted to internal format).  This by\n\t\t\t * definition doesn't need conversion, so the whole branch never\n\t\t\t * gets executed.\n\t\t\t *\n\t\t\t * For safety's sake we don't delete these lines and merely\n\t\t\t * exclude them from coverage statistics.\n\t\t\t *\n\t\t\t * LCOV_EXCL_START\n\t\t\t */"] [750 4 "/* LCOV_EXCL_STOP */"] [778 3 "/* The handling of default attributes gets messed up if we have\n\t\t   a default which duplicates a non-default. */"] [789 3 "/* Detect and prevent integer overflow */"] [799 3 "/* Detect and prevent integer overflow. */"] [829 2 "// NOTE: The XML 1.0r4 spec says:"] [830 2 "// \"When more than one definition is provided for the same attribute of a"] [831 2 "// given element type, the first declaration is binding and later"] [832 2 "// declarations are ignored.\""] [843 22 "/* save one level of indirection */"] [875 22 "/* save one level of indirection */"] [885 2 "/* skip quotation mark - its storage will be reused (like in name[-1]) */"] [911 5 "/* Detect and prevent signed integer overflow */"] [915 5 "/* attributes without prefix are *not* in the default namespace */"] [944 22 "/* save one level of indirection */"] [958 4 "/* Because of memory caching, I don't believe this line can be\n\t\t\t * executed.\n\t\t\t *\n\t\t\t * This is part of a loop copying the default prefix binding\n\t\t\t * URI into the parser's temporary string pool.  Previously,\n\t\t\t * that URI was copied into the same string pool, with a\n\t\t\t * terminating NUL character, as part of setContext().  When\n\t\t\t * the pool was cleared, that leaves a block definitely big\n\t\t\t * enough to hold the URI on the free block list of the pool.\n\t\t\t * The URI copy in getContext() therefore cannot run out of\n\t\t\t * memory.\n\t\t\t *\n\t\t\t * If the pool is used between the setContext() and\n\t\t\t * getContext() calls, the worst it can do is leave a bigger\n\t\t\t * block on the front of the free list.  Given that this is\n\t\t\t * all somewhat inobvious and program logic can be changed, we\n\t\t\t * don't delete the line but we do exclude it from the test\n\t\t\t * coverage statistics.\n\t\t\t */"] [977 17 "/* LCOV_EXCL_LINE */"] [989 4 "/* This test appears to be (justifiable) paranoia.  There does\n\t\t\t * not seem to be a way of injecting a prefix without a binding\n\t\t\t * that doesn't get errored long before this function is called.\n\t\t\t * The test should remain for safety's sake, so we instead\n\t\t\t * exclude the following line from the coverage statistics.\n\t\t\t */"] [995 13 "/* LCOV_EXCL_LINE */"] [1046 22 "/* save one level of indirection */"] [1239 1 "/*\nDo a deep copy of the DTD. Return 0 for out of memory, non-zero otherwise.\n\n\tThe new DTD has already been initialized.\n*/"] [1247 2 "/* Copy the prefix table. */"] [1267 2 "/* Copy the attribute id table. */"] [1277 3 "/* Remember to allocate the scratch byte before the name. */"] [1303 2 "/* Copy the element type table. */"] [1329 4 "/* Detect and prevent integer overflow. */"] [1369 4 "// NOTE: The XML 1.0r4 spec says:"] [1370 4 "// \"When more than one definition is provided for the same attribute of a"] [1371 4 "// given element type, the first declaration is binding and later"] [1372 4 "// declarations are ignored.\""] [1380 2 "/* Copy the entity tables. */"] [1396 2 "/* Don't want deep copying for scaffolding */"] [1406 3 "/* End dtdCopy */"] [1479 1 "// Compares two strings `s1` and `s2` whereas:"] [1480 1 "// - `s2` is zero-terminated but"] [1481 1 "// - `s1` is made up of exactly (not just up to) `s1len` non-zero characters."] [1510 1 "// Function `lookupWithLength` can be used to either…"] [1511 1 "//"] [1512 1 "// a) check whether an element with key `name` exists in the given hash table"] [1513 1 "//"] [1514 1 "//\t(read-only mode where `createSize == 0`) or"] [1515 1 "//"] [1516 1 "// b) check whether an element with key `name` exists in the given hash table"] [1517 1 "//"] [1518 1 "//\t*and* insert it if missing (i.e. read-write mode where `createSize != 0`."] [1519 1 "//"] [1520 1 "// When inserting, a block of `createSize` number of bytes will be allocated"] [1521 1 "// and set to zero, and the resulting block of memory will be considered"] [1522 1 "// to start with a `NAMED` structure, and `->name = name;` is performed."] [1523 1 "// The fact that all other bytes in the structure are initially zero can"] [1524 1 "// be used to tell cases \"existed and found\" and \"newly inserted\" apart"] [1525 1 "// with the structure returned."] [1526 1 "//"] [1527 1 "// NOTE: Read-only lookup does not need zero-terminated keys but"] [1528 1 "//"] [1529 1 "//\tread-write mode does, because keys can be re-hashed later and the"] [1530 1 "//\thash table does not store key length information."] [1531 1 "//"] [1532 1 "// (Go: NULL is a nil NAMED; the new object is newNamed(table, createSize),"] [1533 1 "// see xmlparse_types.go.)"] [1542 3 "/* table->size is a power of 2 */"] [1549 39 "// memset(table->v, 0, tsize)"] [1573 3 "/* check for overflow (table is half full) */"] [1577 4 "/* Detect and prevent invalid shift */"] [1578 50 "/* bits per byte */"] [1585 4 "/* Detect and prevent integer overflow */"] [1594 35 "// memset(newV, 0, tsize)"] [1636 43 "// memset(table->v[i], 0, createSize)"] [1637 43 "// NOTE: This requires and assumes zero termination!"] [1642 1 "// Function `lookup` can be used to either…"] [1643 1 "//"] [1644 1 "// a) check whether an element with key `name` exists in the given hash table"] [1645 1 "//"] [1646 1 "//\t(read-only mode where `createSize == 0`) or"] [1647 1 "//"] [1648 1 "// b) check whether an element with key `name` exists in the given hash table"] [1649 1 "//"] [1650 1 "//\t*and* insert it if missing (i.e. read-write mode where `createSize != 0`."] [1651 1 "//"] [1652 1 "// When inserting, a block of `createSize` number of bytes will be allocated"] [1653 1 "// and set to zero, and the resulting block of memory will be considered"] [1654 1 "// to start with a `NAMED` structure, and `->name = name;` is performed."] [1655 1 "// The fact that all other bytes in the structure are initially zero can"] [1656 1 "// be used to tell cases \"existed and found\" and \"newly inserted\" apart"] [1657 1 "// with the structure returned."] [1679 1 "// hashTableInit assigns C's five fields only (not forDefaultAttForName)."] [1770 42 "/*null terminator*/"] [1778 1 "//
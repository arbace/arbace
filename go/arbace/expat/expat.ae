^{:go/pos {:doc [788 1] :lparen [853 7] :rparen [895 1] :tok-pos [853 1]}} (go/const "---- The C sizes on LP64 ----\n\nThe allocation tracker (expat_malloc, expat_realloc, expat_free) accounts\nC's sizes; the constants below were measured with gcc on an LP64 host\n(aarch64; amd64's layout of these types is the same) by this program,\n/root/arbace-mac/.tmp/q202e/foundation/sizes_parse.c, compiled with\n`gcc -w -I inc -I $EXPAT -o sizes_parse sizes_parse.c $EXPAT/xmltok.c\n$EXPAT/xmlrole.c $EXPAT/xcs.c` (inc/pyconfig.h empty: little endian, so\nexpat_config.h gives XML_NS, XML_DTD, XML_GE 1, XML_CONTEXT_BYTES 1024):\n\n\t#define main expat_unused_main\n\t#include \"xmlparse.c\"\n\t#undef main\n\t#include <stdio.h>\n\t#define P(name, expr) printf(\"\\tsizeof_%s uint64 = %zu\\n\", name, (size_t)(expr))\n\tint main(void) {\n\t  P(\"TAG\", sizeof(TAG));\n\t  P(\"TAG_NAME\", sizeof(TAG_NAME));\n\t  P(\"BINDING\", sizeof(BINDING));\n\t  P(\"PREFIX\", sizeof(PREFIX));\n\t  P(\"ELEMENT_TYPE\", sizeof(ELEMENT_TYPE));\n\t  P(\"ATTRIBUTE_ID\", sizeof(ATTRIBUTE_ID));\n\t  P(\"DEFAULT_ATTRIBUTE\", sizeof(DEFAULT_ATTRIBUTE));\n\t  P(\"NAME_AND_DEFAULT_ATTRIBUTE\", sizeof(NAME_AND_DEFAULT_ATTRIBUTE));\n\t  P(\"ENTITY\", sizeof(ENTITY));\n\t  P(\"OPEN_INTERNAL_ENTITY\", sizeof(OPEN_INTERNAL_ENTITY));\n\t  P(\"CONTENT_SCAFFOLD\", sizeof(CONTENT_SCAFFOLD));\n\t  P(\"XML_Content\", sizeof(XML_Content));\n\t  P(\"DTD\", sizeof(DTD));\n\t  P(\"BLOCK\", sizeof(BLOCK));\n\t  P(\"offsetof_BLOCK_s\", offsetof(BLOCK, s));\n\t  P(\"STRING_POOL\", sizeof(STRING_POOL));\n\t  P(\"NAMED\", sizeof(NAMED));\n\t  P(\"NAMED_ptr\", sizeof(NAMED *));\n\t  P(\"HASH_TABLE\", sizeof(HASH_TABLE));\n\t  P(\"ATTRIBUTE\", sizeof(ATTRIBUTE));\n\t  P(\"NS_ATT\", sizeof(NS_ATT));\n\t  P(\"POSITION\", sizeof(POSITION));\n\t  P(\"ENCODING\", sizeof(ENCODING));\n\t  P(\"INIT_ENCODING\", sizeof(INIT_ENCODING));\n\t  P(\"PROLOG_STATE\", sizeof(PROLOG_STATE));\n\t  P(\"ACCOUNTING\", sizeof(ACCOUNTING));\n\t  P(\"MALLOC_TRACKER\", sizeof(MALLOC_TRACKER));\n\t  P(\"ENTITY_STATS\", sizeof(ENTITY_STATS));\n\t  P(\"XML_ParserStruct\", sizeof(struct XML_ParserStruct));\n\t  P(\"XML_Encoding\", sizeof(XML_Encoding));\n\t  P(\"XML_Feature\", sizeof(XML_Feature));\n\t  P(\"XML_Memory_Handling_Suite\", sizeof(XML_Memory_Handling_Suite));\n\t  P(\"XmlSizeOfUnknownEncoding\", XmlSizeOfUnknownEncoding());\n\t  P(\"int\", sizeof(int));\n\t  P(\"unsigned_long\", sizeof(unsigned long));\n\t  P(\"size_t\", sizeof(size_t));\n\t  P(\"XML_Char\", sizeof(XML_Char));\n\t  P(\"XML_LChar\", sizeof(XML_LChar));\n\t  P(\"XML_Char_ptr\", sizeof(XML_Char *));\n\t  P(\"EXPAT_MALLOC_ALIGNMENT\", EXPAT_MALLOC_ALIGNMENT);\n\t  P(\"EXPAT_MALLOC_PADDING\", EXPAT_MALLOC_PADDING);\n\t  return 0;\n\t}\n\nand sizes_tok.c (`#include \"xmltok.c\"`, printing sizeof(struct\nnormal_encoding) and sizeof(struct unknown_encoding)). Note that\nATTRIBUTE_ID, DEFAULT_ATTRIBUTE and NAME_AND_DEFAULT_ATTRIBUTE have the\nsame size: lookup cannot tell its types apart by createSize alone (see\nnewNamed in xmlparse_types.go).\n"

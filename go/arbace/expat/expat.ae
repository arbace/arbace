;; Package expat is a statement-for-statement port of expat 2.9.0+ (the copy
;; vendored by CPython 3.14.10, Modules/expat/) to Go: see CONVENTIONS.md
;; (queue 202e). This file holds expat.h's, expat_external.h's, internal.h's
;; and xcs.h's declarations, the pointer model (Ptr, Ptr16), the C library
;; helpers every part shares, and the C sizes (sizeof_*) the allocation
;; tracker accounts with.
(in-ns 'go.arbace.expat) ^{:go/comments [[1 1 "/*\n                            __  __            _\n                         ___\\ \\/ /_ __   __ _| |_\n                        / _ \\\\  /| '_ \\ / _` | __|\n                       |  __//  \\| |_) | (_| | |_\n                        \\___/_/\\_\\ .__/ \\__,_|\\__|\n                                 |_| XML parser\n\n   Copyright (c) 1997-2000 Thai Open Source Software Center Ltd\n   Copyright (c) 2000      Clark Cooper <coopercc@users.sourceforge.net>\n   Copyright (c) 2000-2005 Fred L. Drake, Jr. <fdrake@users.sourceforge.net>\n   Copyright (c) 2001-2002 Greg Stein <gstein@users.sourceforge.net>\n   Copyright (c) 2002-2016 Karl Waclawek <karl@waclawek.net>\n   Copyright (c) 2016-2026 Sebastian Pipping <sebastian@pipping.org>\n   Copyright (c) 2016      Cristian Rodríguez <crrodriguez@opensuse.org>\n   Copyright (c) 2016      Thomas Beutlich <tc@tbeu.de>\n   Copyright (c) 2017      Rhodri James <rhodri@wildebeest.org.uk>\n   Copyright (c) 2022      Thijs Schreijer <thijs@thijsschreijer.nl>\n   Copyright (c) 2023      Hanno Böck <hanno@gentoo.org>\n   Copyright (c) 2023      Sony Corporation / Snild Dolkow <snild@sony.com>\n   Copyright (c) 2024      Taichi Haradaguchi <20001722@ymail.ne.jp>\n   Copyright (c) 2025      Matthew Fernandez <matthew.fernandez@gmail.com>\n   Copyright (c) 2026      Braian Plaku <braianplaku@gmail.com>\n   Licensed under the MIT license:\n\n   Permission is  hereby granted,  free of charge,  to any  person obtaining\n   a  copy  of  this  software   and  associated  documentation  files  (the\n   \"Software\"),  to  deal in  the  Software  without restriction,  including\n   without  limitation the  rights  to use,  copy,  modify, merge,  publish,\n   distribute, sublicense, and/or sell copies of the Software, and to permit\n   persons  to whom  the Software  is  furnished to  do so,  subject to  the\n   following conditions:\n\n   The above copyright  notice and this permission notice  shall be included\n   in all copies or substantial portions of the Software.\n\n   THE  SOFTWARE  IS  PROVIDED  \"AS  IS\",  WITHOUT  WARRANTY  OF  ANY  KIND,\n   EXPRESS  OR IMPLIED,  INCLUDING  BUT  NOT LIMITED  TO  THE WARRANTIES  OF\n   MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN\n   NO EVENT SHALL THE AUTHORS OR  COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM,\n   DAMAGES OR  OTHER LIABILITY, WHETHER  IN AN  ACTION OF CONTRACT,  TORT OR\n   OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE\n   USE OR OTHER DEALINGS IN THE SOFTWARE.\n\n   SPDX-License-Identifier: MIT\n*/"] [48 1 "/*\n                            __  __            _\n                         ___\\ \\/ /_ __   __ _| |_\n                        / _ \\\\  /| '_ \\ / _` | __|\n                       |  __//  \\| |_) | (_| | |_\n                        \\___/_/\\_\\ .__/ \\__,_|\\__|\n                                 |_| XML parser\n\n   Copyright (c) 1997-2000 Thai Open Source Software Center Ltd\n   Copyright (c) 2000      Clark Cooper <coopercc@users.sourceforge.net>\n   Copyright (c) 2000-2004 Fred L. Drake, Jr. <fdrake@users.sourceforge.net>\n   Copyright (c) 2001-2002 Greg Stein <gstein@users.sourceforge.net>\n   Copyright (c) 2002-2006 Karl Waclawek <karl@waclawek.net>\n   Copyright (c) 2016      Cristian Rodríguez <crrodriguez@opensuse.org>\n   Copyright (c) 2016-2025 Sebastian Pipping <sebastian@pipping.org>\n   Copyright (c) 2017      Rhodri James <rhodri@wildebeest.org.uk>\n   Copyright (c) 2018      Yury Gribov <tetra2005@gmail.com>\n   Copyright (c) 2026      Matthew Fernandez <matthew.fernandez@gmail.com>\n   Copyright (c) 2026      Braian Plaku <braianplaku@gmail.com>\n   Licensed under the MIT license:\n\n   Permission is  hereby granted,  free of charge,  to any  person obtaining\n   a  copy  of  this  software   and  associated  documentation  files  (the\n   \"Software\"),  to  deal in  the  Software  without restriction,  including\n   without  limitation the  rights  to use,  copy,  modify, merge,  publish,\n   distribute, sublicense, and/or sell copies of the Software, and to permit\n   persons  to whom  the Software  is  furnished to  do so,  subject to  the\n   following conditions:\n\n   The above copyright  notice and this permission notice  shall be included\n   in all copies or substantial portions of the Software.\n\n   THE  SOFTWARE  IS  PROVIDED  \"AS  IS\",  WITHOUT  WARRANTY  OF  ANY  KIND,\n   EXPRESS  OR IMPLIED,  INCLUDING  BUT  NOT LIMITED  TO  THE WARRANTIES  OF\n   MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN\n   NO EVENT SHALL THE AUTHORS OR  COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM,\n   DAMAGES OR  OTHER LIABILITY, WHETHER  IN AN  ACTION OF CONTRACT,  TORT OR\n   OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE\n   USE OR OTHER DEALINGS IN THE SOFTWARE.\n\n   SPDX-License-Identifier: MIT\n*/"] [91 1 "/* internal.h\n\n   Internal definitions used by Expat.  This is not needed to compile\n   client code.\n\n   The following calling convention macros are defined for frequently\n   called functions:\n\n   inline      - Used for selected internal functions for which inlining\n                 may improve performance on some platforms.\n\n   Note: Use of these macros is based on judgement, not hard rules,\n         and therefore subject to change.\n                            __  __            _\n                         ___\\ \\/ /_ __   __ _| |_\n                        / _ \\\\  /| '_ \\ / _` | __|\n                       |  __//  \\| |_) | (_| | |_\n                        \\___/_/\\_\\ .__/ \\__,_|\\__|\n                                 |_| XML parser\n\n   Copyright (c) 2002-2003 Fred L. Drake, Jr. <fdrake@users.sourceforge.net>\n   Copyright (c) 2002-2006 Karl Waclawek <karl@waclawek.net>\n   Copyright (c) 2003      Greg Stein <gstein@users.sourceforge.net>\n   Copyright (c) 2016-2026 Sebastian Pipping <sebastian@pipping.org>\n   Copyright (c) 2018      Yury Gribov <tetra2005@gmail.com>\n   Copyright (c) 2019      David Loffredo <loffredo@steptools.com>\n   Copyright (c) 2023-2024 Sony Corporation / Snild Dolkow <snild@sony.com>\n   Copyright (c) 2024      Taichi Haradaguchi <20001722@ymail.ne.jp>\n   Copyright (c) 2026      Matthew Wozniczka <mattheww@simba.com>\n   Copyright (c) 2026      Braian Plaku <braianplaku@gmail.com>\n   Copyright (c) 2026      Florian Schmaus <florian.schmaus@codasip.com>\n   Licensed under the MIT license:\n\n   Permission is  hereby granted,  free of charge,  to any  person obtaining\n   a  copy  of  this  software   and  associated  documentation  files  (the\n   \"Software\"),  to  deal in  the  Software  without restriction,  including\n   without  limitation the  rights  to use,  copy,  modify, merge,  publish,\n   distribute, sublicense, and/or sell copies of the Software, and to permit\n   persons  to whom  the Software  is  furnished to  do so,  subject to  the\n   following conditions:\n\n   The above copyright  notice and this permission notice  shall be included\n   in all copies or substantial portions of the Software.\n\n   THE  SOFTWARE  IS  PROVIDED  \"AS  IS\",  WITHOUT  WARRANTY  OF  ANY  KIND,\n   EXPRESS  OR IMPLIED,  INCLUDING  BUT  NOT LIMITED  TO  THE WARRANTIES  OF\n   MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN\n   NO EVENT SHALL THE AUTHORS OR  COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM,\n   DAMAGES OR  OTHER LIABILITY, WHETHER  IN AN  ACTION OF CONTRACT,  TORT OR\n   OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE\n   USE OR OTHER DEALINGS IN THE SOFTWARE.\n\n   SPDX-License-Identifier: MIT\n*/"] [146 1 "/*\n                            __  __            _\n                         ___\\ \\/ /_ __   __ _| |_\n                        / _ \\\\  /| '_ \\ / _` | __|\n                       |  __//  \\| |_) | (_| | |_\n                        \\___/_/\\_\\ .__/ \\__,_|\\__|\n                                 |_| XML parser\n\n   Copyright (c) 2026 Sebastian Pipping <sebastian@pipping.org>\n   Licensed under the MIT license:\n\n   Permission is  hereby granted,  free of charge,  to any  person obtaining\n   a  copy  of  this  software   and  associated  documentation  files  (the\n   \"Software\"),  to  deal in  the  Software  without restriction,  including\n   without  limitation the  rights  to use,  copy,  modify, merge,  publish,\n   distribute, sublicense, and/or sell copies of the Software, and to permit\n   persons  to whom  the Software  is  furnished to  do so,  subject to  the\n   following conditions:\n\n   The above copyright  notice and this permission notice  shall be included\n   in all copies or substantial portions of the Software.\n\n   THE  SOFTWARE  IS  PROVIDED  \"AS  IS\",  WITHOUT  WARRANTY  OF  ANY  KIND,\n   EXPRESS  OR IMPLIED,  INCLUDING  BUT  NOT LIMITED  TO  THE WARRANTIES  OF\n   MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN\n   NO EVENT SHALL THE AUTHORS OR  COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM,\n   DAMAGES OR  OTHER LIABILITY, WHETHER  IN AN  ACTION OF CONTRACT,  TORT OR\n   OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE\n   USE OR OTHER DEALINGS IN THE SOFTWARE.\n\n   SPDX-License-Identifier: MIT\n\n   The port to Go (queue 202e): Copyright (c) the Arbace authors, under the same MIT license.\n*/"] [181 1 "// Package expat is a statement-for-statement port of expat 2.9.0+ (the copy"] [182 1 "// vendored by CPython 3.14.10, Modules/expat/) to Go: see CONVENTIONS.md"] [183 1 "// (queue 202e). This file holds expat.h's, expat_external.h's, internal.h's"] [184 1 "// and xcs.h's declarations, the pointer model (Ptr, Ptr16), the C library"] [185 1 "// helpers every part shares, and the C sizes (sizeof_*) the allocation"] [186 1 "// tracker accounts with."] [194 1 "// ---- expat_external.h ----"] [196 1 "// XML_Char is char: Information is UTF-8 encoded (XML_UNICODE is not defined)."] [199 1 "// XML_LChar is char."] [202 1 "// XML_Index is long (XML_LARGE_SIZE is not defined)."] [205 1 "// XML_Size is unsigned long."] [208 1 "// ---- expat.h ----"] [210 1 "// XML_Parser is struct XML_ParserStruct *."] [213 1 "// XML_Bool is unsigned char."] [221 1 "/*\nThe XML_Status enum gives the possible return values for several\n\n\tAPI functions.  The preprocessor #defines are included so this\n\tstanza can be added to code that still needs to support older\n\tversions of Expat 1.95.x:\n\n\t#ifndef XML_STATUS_OK\n\t#define XML_STATUS_OK    1\n\t#define XML_STATUS_ERROR 0\n\t#endif\n\n\tOtherwise, the #define hackery is quite ugly and would have been\n\tdropped.\n*/"] [274 2 "/* Added in 1.95.7. */"] [276 2 "/* Added in 1.95.8. */"] [287 2 "/* Added in 2.0. */"] [291 2 "/* Added in 2.2.1. */"] [293 2 "/* Added in 2.3.0. */"] [295 2 "/* Added in 2.4.0. */"] [297 2 "/* Added in 2.6.4. */"] [301 1 "/* Added in 2.9.0. */"] [305 52 "// i.e. success"] [306 52 "// i.e. the property is not known at all"] [307 52 "// i.e. the property is known but expects a different type"] [308 52 "// i.e. the value is invalid (setter) or a NULL-pointer (getter)"] [309 52 "// i.e. the parser argument is NULL"] [310 52 "// i.e. the parser is not a root parser"] [333 1 "/* If type == XML_CTYPE_EMPTY or XML_CTYPE_ANY, then quant will be\n   XML_CQUANT_NONE, and the other fields will be zero or NULL.\n   If type == XML_CTYPE_MIXED, then quant will be NONE or REP and\n   numchildren will contain number of elements that may be mixed in\n   and children point to an array of XML_Content cells that will be\n   all of XML_CTYPE_NAME type with no quantification.\n\n   If type == XML_CTYPE_NAME, then the name points to the name, and\n   the numchildren field will be zero and children will be NULL. The\n   quant fields indicates any quantifiers placed on the name.\n\n   CHOICE and SEQ will have name NULL, the number of children in\n   numchildren and children will point, recursively, to an array\n   of XML_Content cells.\n\n   The EMPTY, ANY, and MIXED types will only occur at top level.\n*/"] [351 1 "// XML_Content is struct XML_cp. children (C's XML_Content *, into the one"] [352 1 "// array build_model allocates) is a slice of that array starting at the first"] [353 1 "// child (nil for NULL); the model handed to the handler is &array[0]."] [362 1 "// The accessors below are Go's only: the binding lives in another package"] [363 1 "// and C's field names are not exported."] [369 1 "// Child returns &children[i]."] [372 1 "/*\nThis is called for an element declaration. See above for\n\n\tdescription of the model argument. It's the user code's responsibility\n\tto free model when finished with it. See XML_FreeContentModel.\n\tThere is no need to free the model from the handler, it can be kept\n\taround and freed at a later stage.\n*/"] [382 1 "/*\nThe Attlist declaration handler is called for *each* attribute. So\n\n\ta single Attlist declaration with multiple attributes declared will\n\tgenerate multiple calls to this handler. The \"default\" parameter\n\tmay be NULL in the case of the \"#IMPLIED\" or \"#REQUIRED\"\n\tkeyword. The \"isrequired\" parameter will be true and the default\n\tvalue will be NULL in the case of \"#REQUIRED\". If \"isrequired\" is\n\ttrue and default is non-NULL, then this is a \"#FIXED\" default.\n*/"] [394 1 "/*\nThe XML declaration handler is called for *both* XML declarations\n\n\tand text declarations. The way to distinguish is that the version\n\tparameter will be NULL for text declarations. The encoding\n\tparameter may be NULL for XML declarations. The standalone\n\tparameter will be -1, 0, or 1 indicating respectively that there\n\twas no standalone parameter in the declaration, that it was given\n\tas no, or that it was given as yes.\n*/"] [406 1 "// XML_Memory_Handling_Suite keeps C's fields; Go's allocator does the work,"] [407 1 "// so they are never called (parserCreate leaves them nil where C stores"] [408 1 "// malloc, realloc and free)."] [415 1 "/*\natts is array of name/value pairs, terminated by 0;\n\n\tnames and values are 0 terminated.\n*/"] [424 1 "/* s is not 0 terminated. */"] [427 1 "/* target and data are 0 terminated */"] [430 1 "/* data is 0 terminated */"] [436 1 "/*\nThis is called for any characters in the XML document for which\n\n\tthere is no applicable handler.  This includes both characters that\n\tare part of markup which is of a kind that is not reported\n\t(comments, markup declarations), or characters that are part of a\n\tconstruct which could be reported but for which no handler has been\n\tsupplied. The characters are passed exactly as they were in the XML\n\tdocument except that they will be encoded in UTF-8 or UTF-16.\n\tLine boundaries are not normalized. Note that a byte order mark\n\tcharacter is not passed to the default handler. There are no\n\tguarantees about how characters are divided between calls to the\n\tdefault handler: for example, a comment might be split between\n\tmultiple calls.\n*/"] [453 1 "/*\nThis is called for the start of the DOCTYPE declaration, before\n\n\tany DTD or internal subset is parsed.\n*/"] [460 1 "/*\nThis is called for the end of the DOCTYPE declaration when the\n\n\tclosing > is encountered, but after processing any external\n\tsubset.\n*/"] [468 1 "/*\nThis is called for entity declarations. The is_parameter_entity\n\n\targument will be non-zero if the entity is a parameter entity, zero\n\totherwise.\n\n\tFor internal entities (<!ENTITY foo \"bar\">), value will\n\tbe non-NULL and systemId, publicID, and notationName will be NULL.\n\tThe value string is NOT null-terminated; the length is provided in\n\tthe value_length argument. Since it is legal to have zero-length\n\tvalues, do not use this argument to test for internal entities.\n\n\tFor external entities, value will be NULL and systemId will be\n\tnon-NULL. The publicId argument will be NULL unless a public\n\tidentifier was provided. The notationName argument will have a\n\tnon-NULL value only for unparsed entity declarations.\n\n\tNote that is_parameter_entity can't be changed to XML_Bool, since\n\tthat would break binary compatibility.\n*/"] [490 1 "/*\nOBSOLETE -- OBSOLETE -- OBSOLETE\n\n\tThis handler has been superseded by the EntityDeclHandler above.\n\tIt is provided here for backward compatibility.\n\n\tThis is called for a declaration of an unparsed (NDATA) entity.\n\tThe base argument is whatever was set by XML_SetBase. The\n\tentityName, systemId and notationName arguments will never be\n\tNULL. The other arguments may be.\n*/"] [503 1 "/*\nThis is called for a declaration of notation.  The base argument is\n\n\twhatever was set by XML_SetBase. The notationName will never be\n\tNULL.  The other arguments can be.\n*/"] [511 1 "/*\nWhen namespace processing is enabled, these are called once for\n\n\teach namespace declaration. The call to the start and end element\n\thandlers occur between the calls to the start and end namespace\n\tdeclaration handlers. For an xmlns attribute, prefix will be\n\tNULL.  For an xmlns=\"\" attribute, uri will be NULL.\n*/"] [523 1 "/*\nThis is called if the document is not standalone, that is, it has an\n\n\texternal subset or a reference to a parameter entity, but does not\n\thave standalone=\"yes\". If this handler returns XML_STATUS_ERROR,\n\tthen processing will not continue, and the parser will return a\n\tXML_ERROR_NOT_STANDALONE error.\n\tIf parameter entity parsing is enabled, then in addition to the\n\tconditions above this handler will only be called if the referenced\n\tentity was actually read.\n*/"] [536 1 "/*\nThis is called for a reference to an external parsed general\n\n\tentity.  The referenced entity is not automatically parsed.  The\n\tapplication can parse it immediately or later using\n\tXML_ExternalEntityParserCreate.\n\n\t(See expat.h for the whole comment.)\n\n\tNote that unlike other handlers the first argument is the parser,\n\tnot userData.\n*/"] [550 1 "/*\nThis is called in two situations:\n 1. An entity reference is encountered for which no declaration\n    has been read *and* this is not an error.\n 2. An internal entity reference is read, but not expanded, because\n    XML_SetDefaultHandler has been called.\n    Note: skipped parameter entities in declarations and skipped general\n    entities in attribute values cannot be reported, because\n    the event would be out of sync with the reporting of the\n    declarations or attribute values\n*/"] [563 1 "/*\nThis structure is filled in by the XML_UnknownEncodingHandler to\n\n\tprovide information to the parser about encodings that are unknown\n\tto the parser.\n\n\tThe map[b] member gives information about byte sequences whose\n\tfirst byte is b.\n\n\tIf map[b] is c where c is >= 0, then b by itself encodes the\n\tUnicode scalar value c.\n\n\tIf map[b] is -1, then the byte sequence is malformed.\n\n\tIf map[b] is -n, where n >= 2, then b is the first byte of an\n\tn-byte sequence that encodes a single Unicode scalar value.\n\n\tThe data member will be passed as the first argument to the convert\n\tfunction.\n\n\tThe convert function is used to convert multibyte sequences; s will\n\tpoint to a n-byte sequence where map[(unsigned char)*s] == -n.  The\n\tconvert function must return the Unicode scalar value represented\n\tby this byte sequence or -1 if the byte sequence is malformed.\n\n\tThe convert function may be NULL if the encoding is a single-byte\n\tencoding, that is if map[b] >= -1 for all bytes b.\n\n\tWhen the parser is finished with the encoding, then if release is\n\tnot NULL, it will call release passing it the data member; once\n\trelease has been called, the convert function will not be called\n\tagain.\n\n\t(See expat.h for the restrictions.)\n*/"] [605 1 "// Go's accessors for the binding (C's field names are not exported)."] [611 1 "/*\nThis is called for an encoding that is unknown to the parser.\n\n\t(See expat.h for the whole comment.)\n*/"] [618 1 "/* Returns the last value set by XML_SetUserData or NULL. */"] [646 1 "/* For backwards compatibility with previous versions. */"] [667 1 "/* Added in Expat 1.95.5. */"] [676 2 "/* Added in Expat 1.95.5, removed in Expat 2.9.0. */"] [680 2 "/* Added in Expat 2.0.0. */"] [682 2 "/* Added in Expat 2.0.1. */"] [684 2 "/* Added in Expat 2.1.0, removed in Expat 2.9.0. */"] [686 2 "/* Added in Expat 2.4.0. */"] [689 2 "/* Added in Expat 2.6.0. */"] [691 2 "/* Added in Expat 2.7.2. */"] [694 2 "/* Additional features must be added to the end of this enum. */"] [707 1 "/* Added in Expat 2.9.0. */"] [711 72 "// of type `uint64_t`"] [712 72 "// of type `double`"] [713 72 "// of type `uint64_t`"] [714 72 "// of type `double`"] [715 72 "// of type `XML_Bool`"] [718 1 "/*\nExpat follows the semantic versioning convention.\n\n\tSee https://semver.org\n*/"] [729 1 "// ---- internal.h ----"] [731 1 "// EXPAT_FMT_*: the printf formats, as Go's fmt verbs (midpart is the width)."] [737 1 "/*\nNOTE BEGIN If you ever patch these defaults to greater values\n\n\tfor non-attack XML payload in your environment,\n\tplease file a bug report with libexpat.  Thank you!\n*/"] [744 85 "// 8 MiB, 2^23"] [747 67 "// 64 MiB, 2^26"] [749 1 "// NOTE: If function expat_alloc was user facing, EXPAT_MALLOC_ALIGNMENT would"] [750 1 "//"] [751 1 "//\thave to take sizeof(long double) into account"] [752 1 "//"] [753 1 "// union expat_align { long long l; void *p; }: 8 bytes on LP64."] [755 76 "// 0 on LP64"] [757 1 "/* NOTE END */"] [759 1 "// The declarations of internal.h are functions of xmltok.c"] [760 1 "// (_INTERNAL_trim_to_complete_utf8_characters) and xmlparse.c"] [761 1 "// (testingAccountingGetCountBytesDirect, testingAccountingGetCountBytesIndirect,"] [762 1 "// unsignedCharToPrintable, g_reparseDeferralEnabledDefault): see their parts."] [764 1 "// ---- xcs.h: xcslen, xcscmp, xcsncmp are in xcs.go ----"] [766 1 "// ---- C's limits (limits.h, stdint.h), untyped as C's are used ----"] [769 30 "// size_t on LP64"] [774 18 "// errno.h's on Linux"] [777 1 "// errno is C's errno, as far as the port needs it (strtoul)."] [780 1 "// assert is C's assert(3) of a debug build: a failed assertion is a bug of"] [781 1 "// the port (CPython's release build compiles them out; they hold in C)."] [788 1 "// ---- The C sizes on LP64 ----"] [789 1 "//"] [790 1 "// The allocation tracker (expat_malloc, expat_realloc, expat_free) accounts"] [791 1 "// C's sizes; the constants below were measured with gcc on an LP64 host"] [792 1 "// (aarch64; amd64's layout of these types is the same) by this program,"] [793 1 "// /root/arbace-mac/.tmp/q202e/foundation/sizes_parse.c, compiled with"] [794 1 "// `gcc -w -I inc -I $EXPAT -o sizes_parse sizes_parse.c $EXPAT/xmltok.c"] [795 1 "// $EXPAT/xmlrole.c $EXPAT/xcs.c` (inc/pyconfig.h empty: little endian, so"] [796 1 "// expat_config.h gives XML_NS, XML_DTD, XML_GE 1, XML_CONTEXT_BYTES 1024):"] [797 1 "//"] [798 1 "//\t#define main expat_unused_main"] [799 1 "//\t#include \"xmlparse.c\""] [800 1 "//\t#undef main"] [801 1 "//\t#include <stdio.h>"] [802 1 "//\t#define P(name, expr) printf(\"\\tsizeof_%s uint64 = %zu\\n\", name, (size_t)(expr))"] [803 1 "//\tint main(void) {"] [804 1 "//\t  P(\"TAG\", sizeof(TAG));"] [805 1 "//\t  P(\"TAG_NAME\", sizeof(TAG_NAME));"] [806 1 "//\t  P(\"BINDING\", sizeof(BINDING));"] [807 1 "//\t  P(\"PREFIX\", sizeof(PREFIX));"] [808 1 "//\t  P(\"ELEMENT_TYPE\", sizeof(ELEMENT_TYPE));"] [809 1 "//\t  P(\"ATTRIBUTE_ID\", sizeof(ATTRIBUTE_ID));"] [810 1 "//\t  P(\"DEFAULT_ATTRIBUTE\", sizeof(DEFAULT_ATTRIBUTE));"] [811 1 "//\t  P(\"NAME_AND_DEFAULT_ATTRIBUTE\", sizeof(NAME_AND_DEFAULT_ATTRIBUTE));"] [812 1 "//\t  P(\"ENTITY\", sizeof(ENTITY));"] [813 1 "//\t  P(\"OPEN_INTERNAL_ENTITY\", sizeof(OPEN_INTERNAL_ENTITY));"] [814 1 "//\t  P(\"CONTENT_SCAFFOLD\", sizeof(CONTENT_SCAFFOLD));"] [815 1 "//\t  P(\"XML_Content\", sizeof(XML_Content));"] [816 1 "//\t  P(\"DTD\", sizeof(DTD));"] [817 1 "//\t  P(\"BLOCK\", sizeof(BLOCK));"] [818 1 "//\t  P(\"offsetof_BLOCK_s\", offsetof(BLOCK, s));"] [819 1 "//\t  P(\"STRING_POOL\", sizeof(STRING_POOL));"] [820 1 "//\t  P(\"NAMED\", sizeof(NAMED));"] [821 1 "//\t  P(\"NAMED_ptr\", sizeof(NAMED *));"] [822 1 "//\t  P(\"HASH_TABLE\", sizeof(HASH_TABLE));"] [823 1 "//\t  P(\"ATTRIBUTE\", sizeof(ATTRIBUTE));"] [824 1 "//\t  P(\"NS_ATT\", sizeof(NS_ATT));"] [825 1 "//\t  P(\"POSITION\", sizeof(POSITION));"] [826 1 "//\t  P(\"ENCODING\", sizeof(ENCODING));"] [827 1 "//\t  P(\"INIT_ENCODING\", sizeof(INIT_ENCODING));"] [828 1 "//\t  P(\"PROLOG_STATE\", sizeof(PROLOG_STATE));"] [829 1 "//\t  P(\"ACCOUNTING\", sizeof(ACCOUNTING));"] [830 1 "//\t  P(\"MALLOC_TRACKER\", sizeof(MALLOC_TRACKER));"] [831 1 "//\t  P(\"ENTITY_STATS\", sizeof(ENTITY_STATS));"] [832 1 "//\t  P(\"XML_ParserStruct\", sizeof(struct XML_ParserStruct));"] [833 1 "//\t  P(\"XML_Encoding\", sizeof(XML_Encoding));"] [834 1 "//\t  P(\"XML_Feature\", sizeof(XML_Feature));"] [835 1 "//\t  P(\"XML_Memory_Handling_Suite\", sizeof(XML_Memory_Handling_Suite));"] [836 1 "//\t  P(\"XmlSizeOfUnknownEncoding\", XmlSizeOfUnknownEncoding());"] [837 1 "//\t  P(\"int\", sizeof(int));"] [838 1 "//\t  P(\"unsigned_long\", sizeof(unsigned long));"] [839 1 "//\t  P(\"size_t\", sizeof(size_t));"] [840 1 "//\t  P(\"XML_Char\", sizeof(XML_Char));"] [841 1 "//\t  P(\"XML_LChar\", sizeof(XML_LChar));"] [842 1 "//\t  P(\"XML_Char_ptr\", sizeof(XML_Char *));"] [843 1 "//\t  P(\"EXPAT_MALLOC_ALIGNMENT\", EXPAT_MALLOC_ALIGNMENT);"] [844 1 "//\t  P(\"EXPAT_MALLOC_PADDING\", EXPAT_MALLOC_PADDING);"] [845 1 "//\t  return 0;"] [846 1 "//\t}"] [847 1 "//"] [848 1 "// and sizes_tok.c (`#include \"xmltok.c\"`, printing sizeof(struct"] [849 1 "// normal_encoding) and sizeof(struct unknown_encoding)). Note that"] [850 1 "// ATTRIBUTE_ID, DEFAULT_ATTRIBUTE and NAME_AND_DEFAULT_ATTRIBUTE have the"] [851 1 "// same size: lookup cannot tell its types apart by createSize alone (see"] [852 1 "// newNamed in xmlparse_types.go)."] [887 50 "// XmlSizeOfUnknownEncoding()"] [897 1 "// ---- The pointer model ----"] [899 1 "// Ptr is every char *, const char *, XML_Char *, const XML_Char *,"] [900 1 "// XML_LChar * (and unsigned char * over the same bytes): B is the whole"] [901 1 "// allocation, never resliced (B[0] is its first byte), I the offset in B."] [902 1 "// NULL is Ptr{} (B nil). A block MALLOC'd for a Ptr is make([]byte, size),"] [903 1 "// so its size is len(p.B)."] [909 1 "// IsNull is p == NULL."] [912 1 "// At is p[k]."] [915 1 "// Set is p[k] = v."] [918 1 "// Add is p + n (p - n is p.Add(-n))."] [921 1 "// Sub is p - q (both into the same allocation, as C requires)."] [924 1 "// Lt, Le, Gt, Ge are p < q, p <= q, p > q, p >= q (the same allocation)."] [930 1 "// Eq is p == q: both NULL, or the same allocation and offset."] [944 1 "// String is the C string at p, up to its NUL (or the allocation's end)."] [953 1 "// Bytes is the n bytes from p, a view of the allocation (not a copy)."] [956 1 "// CStr is a string literal handed out by expat: a NUL-terminated copy."] [963 1 "// Ptr16 is unsigned short * (utf16Convert's output), as Ptr."] [993 1 "// ---- The C library, as the parts use it (one copy, shared) ----"] [995 1 "// memcpy copies n bytes from src to dst."] [1003 1 "// memmove copies n bytes from src to dst, the two may overlap."] [1011 1 "// memset sets n bytes at dst to (unsigned char)c."] [1018 1 "// memcmp compares n bytes as unsigned char."] [1029 1 "// strlen is the length of the C string at s."] [1038 1 "// strcmp compares as unsigned char (musl's result)."] [1047 1 "// strncmp compares at most n characters as unsigned char (musl's result)."] [1061 1 "// getenv is NULL when the variable is unset."] [1070 1 "// strtoul is C's for the bases 2 to 36 (leading white space, an optional"] [1071 1 "// sign, base 16's optional 0x); overflow gives ULONG_MAX and errno ERANGE."] [1132 1 "// isnan is math.h's for a float."]] :go/pos {:name [187 9] :package [187 1]} :go/semis [[1013 12] [1013 24] [1020 12] [1020 24]]} (go/file "expat.go" :doc "Package expat is a statement-for-statement port of expat 2.9.0+ (the copy\nvendored by CPython 3.14.10, Modules/expat/) to Go: see CONVENTIONS.md\n(queue 202e). This file holds expat.h's, expat_external.h's, internal.h's\nand xcs.h's declarations, the pointer model (Ptr, Ptr16), the C library\nhelpers every part shares, and the C sizes (sizeof_*) the allocation\ntracker accounts with.\n" :imports [


    ^{:go/apos {1 [190 2]} :go/pos {:lparen [189 8] :rparen [192 1] :tok-pos [189 1]}} [math "math"]
    ^{:go/apos {1 [191 2]}} [os "os"]])



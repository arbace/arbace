(in-ns 'go.arbace.expat) ^{:go/comments [[1 1 "/*\n                            __  __            _\n                         ___\\ \\/ /_ __   __ _| |_\n                        / _ \\\\  /| '_ \\ / _` | __|\n                       |  __//  \\| |_) | (_| | |_\n                        \\___/_/\\_\\ .__/ \\__,_|\\__|\n                                 |_| XML parser\n\n   Copyright (c) 1997-2000 Thai Open Source Software Center Ltd\n   Copyright (c) 2000      Clark Cooper <coopercc@users.sourceforge.net>\n   Copyright (c) 2002      Fred L. Drake, Jr. <fdrake@users.sourceforge.net>\n   Copyright (c) 2002-2005 Karl Waclawek <karl@waclawek.net>\n   Copyright (c) 2016-2026 Sebastian Pipping <sebastian@pipping.org>\n   Copyright (c) 2017      Rhodri James <rhodri@wildebeest.org.uk>\n   Licensed under the MIT license:\n\n   Permission is  hereby granted,  free of charge,  to any  person obtaining\n   a  copy  of  this  software   and  associated  documentation  files  (the\n   \"Software\"),  to  deal in  the  Software  without restriction,  including\n   without  limitation the  rights  to use,  copy,  modify, merge,  publish,\n   distribute, sublicense, and/or sell copies of the Software, and to permit\n   persons  to whom  the Software  is  furnished to  do so,  subject to  the\n   following conditions:\n\n   The above copyright  notice and this permission notice  shall be included\n   in all copies or substantial portions of the Software.\n\n   THE  SOFTWARE  IS  PROVIDED  \"AS  IS\",  WITHOUT  WARRANTY  OF  ANY  KIND,\n   EXPRESS  OR IMPLIED,  INCLUDING  BUT  NOT LIMITED  TO  THE WARRANTIES  OF\n   MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN\n   NO EVENT SHALL THE AUTHORS OR  COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM,\n   DAMAGES OR  OTHER LIABILITY, WHETHER  IN AN  ACTION OF CONTRACT,  TORT OR\n   OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE\n   USE OR OTHER DEALINGS IN THE SOFTWARE.\n\n   SPDX-License-Identifier: MIT\n*/"] [39 1 "/*\n                            __  __            _\n                         ___\\ \\/ /_ __   __ _| |_\n                        / _ \\\\  /| '_ \\ / _` | __|\n                       |  __//  \\| |_) | (_| | |_\n                        \\___/_/\\_\\ .__/ \\__,_|\\__|\n                                 |_| XML parser\n\n   Copyright (c) 1997-2000 Thai Open Source Software Center Ltd\n   Copyright (c) 2000      Clark Cooper <coopercc@users.sourceforge.net>\n   Copyright (c) 2001-2003 Fred L. Drake, Jr. <fdrake@users.sourceforge.net>\n   Copyright (c) 2002      Greg Stein <gstein@users.sourceforge.net>\n   Copyright (c) 2002-2016 Karl Waclawek <karl@waclawek.net>\n   Copyright (c) 2005-2009 Steven Solie <steven@solie.ca>\n   Copyright (c) 2016-2026 Sebastian Pipping <sebastian@pipping.org>\n   Copyright (c) 2016      Pascal Cuoq <cuoq@trust-in-soft.com>\n   Copyright (c) 2016      Don Lewis <truckman@apache.org>\n   Copyright (c) 2017      Rhodri James <rhodri@wildebeest.org.uk>\n   Copyright (c) 2017      Alexander Bluhm <alexander.bluhm@gmx.net>\n   Copyright (c) 2017      Benbuck Nason <bnason@netflix.com>\n   Copyright (c) 2017      José Gutiérrez de la Concha <jose@zeroc.com>\n   Copyright (c) 2019      David Loffredo <loffredo@steptools.com>\n   Copyright (c) 2021      Donghee Na <donghee.na@python.org>\n   Copyright (c) 2022      Martin Ettl <ettl.martin78@googlemail.com>\n   Copyright (c) 2022      Sean McBride <sean@rogue-research.com>\n   Copyright (c) 2023      Hanno Böck <hanno@gentoo.org>\n   Copyright (c) 2025      Alfonso Gregory <gfunni234@gmail.com>\n   Copyright (c) 2026      Nick Begg <nick@stunttruck.net>\n   Copyright (c) 2026      Kartik Kenchi <netliomax25@gmail.com>\n   Copyright (c) 2026      Afonso Januário <afonso-januario@hotmail.com>\n   Licensed under the MIT license:\n\n   Permission is  hereby granted,  free of charge,  to any  person obtaining\n   a  copy  of  this  software   and  associated  documentation  files  (the\n   \"Software\"),  to  deal in  the  Software  without restriction,  including\n   without  limitation the  rights  to use,  copy,  modify, merge,  publish,\n   distribute, sublicense, and/or sell copies of the Software, and to permit\n   persons  to whom  the Software  is  furnished to  do so,  subject to  the\n   following conditions:\n\n   The above copyright  notice and this permission notice  shall be included\n   in all copies or substantial portions of the Software.\n\n   THE  SOFTWARE  IS  PROVIDED  \"AS  IS\",  WITHOUT  WARRANTY  OF  ANY  KIND,\n   EXPRESS  OR IMPLIED,  INCLUDING  BUT  NOT LIMITED  TO  THE WARRANTIES  OF\n   MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN\n   NO EVENT SHALL THE AUTHORS OR  COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM,\n   DAMAGES OR  OTHER LIABILITY, WHETHER  IN AN  ACTION OF CONTRACT,  TORT OR\n   OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE\n   USE OR OTHER DEALINGS IN THE SOFTWARE.\n\n   SPDX-License-Identifier: MIT\n\n   The port to Go (queue 202e): Copyright (c) the Arbace authors, under the same MIT license.\n*/"] [97 1 "// ---- xmltok.h ----"] [99 1 "/* The following token may be returned by XmlContentTok */"] [100 34 "/* ] or ]] at the end of the scan; might be\n   start of illegal ]]> sequence */"] [103 1 "/*\nThe following tokens may be returned by both XmlPrologTok and\n\n\tXmlContentTok.\n*/"] [109 28 "/* The string to be scanned is empty */"] [110 28 "/* A CR at the end of the scan; might be part of CRLF sequence */"] [111 28 "/* only part of a multibyte sequence */"] [112 28 "/* only part of a token */"] [116 1 "/*\nThe following tokens are returned by XmlContentTok; some are also\n\n\treturned by XmlAttributeValueTok, XmlEntityTok, XmlCdataSectionTok.\n*/"] [124 38 "/* empty element tag <e/> */"] [131 39 "/* numeric character reference */"] [134 1 "/*\nThe following tokens may be returned by both XmlPrologTok and\n\n\tXmlContentTok.\n*/"] [140 24 "/* processing instruction */"] [141 24 "/* XML decl or text decl */"] [143 24 "/* Byte order mark */"] [146 1 "/* The following tokens are returned only by XmlPrologTok */"] [149 32 "/* <!foo */"] [150 32 "/* > */"] [153 32 "/* #name */"] [154 32 "/* | */"] [165 1 "/* The following occur only in element type declarations */"] [167 36 "/* name? */"] [168 36 "/* name* */"] [169 36 "/* name+ */"] [170 36 "/* <![ */"] [171 36 "/* ]]> */"] [172 36 "/* )? */"] [173 36 "/* )* */"] [174 36 "/* )+ */"] [178 1 "/* The following token is returned only by XmlAttributeValueTok */"] [181 1 "/* The following token is returned only by XmlCdataSectionTok */"] [184 1 "/*\nWith namespace processing this is returned by XmlPrologTok for a\n\n\tname with a colon.\n*/"] [191 32 "/* XML_DTD */"] [193 24 "/* XML_DTD */"] [199 31 "/* XML_DTD */"] [208 1 "/* The size of the buffer passed to XmlUtf8Encode must be at least this. */"] [211 1 "/* The size of the buffer passed to XmlUtf16Encode must be at least this. */"] [215 2 "/* first line and first column are 0 not 1 */"] [234 54 "/* and therefore potentially input remaining\n\t   as well */"] [238 1 "// ENCODING is struct encoding, its fields in C's order, and one field of"] [239 1 "// Go's own, self: the struct that embeds this ENCODING, which C's casts"] [240 1 "// follow (a *normal_encoding for the static encodings, the"] [241 1 "// *unknown_encoding for an unknown encoding, the *INIT_ENCODING for an"] [242 1 "// INIT_ENCODING's initEnc)."] [260 11 "// Go's: the enclosing struct (see above)"] [263 1 "/* Scan the string starting at ptr until the end of the next complete\n   token, but do not scan past eptr.  Return an integer giving the\n   type of token.\n\n   Return XML_TOK_NONE when ptr == eptr; nextTokPtr will not be set.\n\n   Return XML_TOK_PARTIAL when the string does not contain a complete\n   token; nextTokPtr will not be set.\n\n   Return XML_TOK_INVALID when the string does not start a valid\n   token; nextTokPtr will be set to point to the character which made\n   the token invalid.\n\n   Otherwise the string starts with a valid token; nextTokPtr will be\n   set to point to the character following the end of that token.\n\n   Each data character counts as a single token, but adjacent data\n   characters may be returned together.  Similarly for characters in\n   the prolog outside literals, comments and processing instructions.\n*/"] [304 1 "/*\nThis is used for performing a 2nd-level tokenization on the content\n\n\tof a literal that has already been returned by XmlTok.\n*/"] [355 1 "// INIT_ENCODING: XmlInitEncoding sets initEnc.self to the INIT_ENCODING, so"] [356 1 "// initScan's cast `(const INIT_ENCODING *)enc` is enc.self.(*INIT_ENCODING)."] [364 1 "// XmlParseXmlDecl, XmlInitEncoding, XmlGetUtf8InternalEncoding,"] [365 1 "// XmlGetUtf16InternalEncoding, XmlUtf8Encode, XmlUtf16Encode,"] [366 1 "// XmlSizeOfUnknownEncoding, XmlInitUnknownEncoding and their NS variants"] [367 1 "// are xmltok.c's and xmltok_ns.c's."] [369 1 "// ---- xmltok.c's structs (declared here so their shape is fixed) ----"] [371 1 "// normal_encoding is struct normal_encoding. kind is Go's own: which of"] [372 1 "// xmltok_impl.c's three instantiations (normal_, little2_, big2_) the"] [373 1 "// encoding's vtable stands for, since the one Go copy of xmltok_impl.c"] [374 1 "// dispatches its macros (MINBPC, BYTE_TYPE, ...) on it."] [388 12 "// Go's: IMPL_NORMAL, IMPL_LITTLE2 or IMPL_BIG2"] [391 1 "// The instantiations of xmltok_impl.c (normal_encoding.kind)."] [393 24 "// PREFIX(ident) normal_##ident, MINBPC 1"] [394 24 "// PREFIX(ident) little2_##ident, MINBPC 2"] [395 24 "// PREFIX(ident) big2_##ident, MINBPC 2"] [398 1 "// unknown_encoding is struct unknown_encoding: XmlInitUnknownEncoding's mem"] [399 1 "// (xmlparse.c's m_unknownEncodingMem), sizeof_unknown_encoding bytes in C."] [400 1 "// utf8[b] is the char[4] array a Ptr{B: uenc.utf8[b][:]} walks."] [409 1 "// ---- xmltok.c ----"] [411 1 "// IGNORE_SECTION_TOK_VTABLE, VTABLE1 and VTABLE are the initialisers of an"] [412 1 "// ENCODING's first fields; tok_VTABLE1 sets them (one copy of xmltok_impl.c,"] [413 1 "// so PREFIX(x) is x for the three instantiations)."] [416 19 "/* IGNORE_SECTION_TOK_VTABLE */"] [432 1 "/* A 2 byte UTF-8 representation splits the characters 11 bits between\n   the bottom 5 and 6 bits of the bytes.  We need 8 bits to index into\n   pages, 3 bits to add to that index and 5 bits to generate the mask.\n*/"] [443 1 "/* A 3 byte UTF-8 representation splits the characters 16 bits between\n   the bottom 4, 6 and 6 bits of the bytes.  We need 8 bits to index\n   into pages, 3 bits to add to that index and 5 bits to generate the\n   mask.\n*/"] [455 1 "/* Detection of invalid UTF-8 sequences is based on Table 3.1B\n   of Unicode 3.2: https://www.unicode.org/unicode/reports/tr28/\n   with the additional restriction of not allowing the Unicode\n   code points 0xFFFF and 0xFFFE (sequences EF,BF,BF and EF,BF,BE).\n   Implementation details:\n     (A & 0x80) == 0     means A < 0x80\n   and\n     (A & 0xC0) == 0xC0  means A > 0xBF\n*/"] [496 1 "// tok_cond is C's c ? a : b over two already evaluated (side-effect free)"] [497 1 "// conditions."] [505 1 "// tok_bool is C's int value of a condition."] [529 1 "// #define utf8_isName4 isNever"] [542 1 "// #define utf8_isNmstrt4 isNever"] [560 1 "// AS_NORMAL_ENCODING is the cast ((const struct normal_encoding *)(enc)):"] [561 1 "// the normal_encoding that enc is the first field of."] [572 1 "// STANDARD_VTABLE(E) is nothing; NORMAL_VTABLE(E) and NULL_VTABLE (="] [573 1 "// UTF16_NULL_VTABLE(E)) are the nine functions after type: tok_NORMAL_VTABLE"] [574 1 "// sets utf8_'s (the only E NORMAL_VTABLE is used with), NULL_VTABLE leaves"] [575 1 "// them nil."] [588 1 "// xmltok_impl.h is xmltok_impl_h.go; ascii.h is in xmltok_tables.go."] [590 1 "// The instantiation's macros (MINBPC, BYTE_TYPE, BYTE_TO_ASCII, IS_NAME_CHAR,"] [591 1 "// IS_NMSTRT_CHAR, IS_INVALID_CHAR, IS_NAME_CHAR_MINBPC,"] [592 1 "// IS_NMSTRT_CHAR_MINBPC, CHAR_MATCHES) for PREFIX normal_, little2_ and big2_"] [593 1 "// are in xmltok_impl.go, dispatching on normal_encoding.kind. SB_BYTE_TYPE is"] [594 1 "// the normal_ instantiation's BYTE_TYPE:"] [599 9 "/* UTF8_cvalN is value of masked first byte of N byte sequence */"] [611 30 "/* 4-byte character, lead by 0b11110xxx byte */"] [618 37 "/* 3-byte character, lead by 0b1110xxxx byte */"] [625 37 "/* 2-byte character, lead by 0b110xxxxx byte */"] [632 37 "/* 1-byte character, matching 0b0xxxxxxx */"] [643 2 "/* Avoid copying partial characters (due to limited space). */"] [652 2 "/* Avoid copying partial characters (from incomplete input). */"] [668 24 "/* needs to go first */"] [720 4 "/* char to unsigned short: sign-extended, as C's */"] [735 1 "// The static encodings. Their initialisers refer to functions that refer to"] [736 1 "// them (checkCharRefNumber reads latin1_encoding), and each holds self, so"] [737 1 "// tok_init (called from init) fills them as C's initialisers do."] [815 2 "/* 0xD800-0xDBFF first 16-bit code unit or high surrogate (W1) */"] [818 2 "/* 0xDC00-0xDFFF second 16-bit code unit or low surrogate (W2) */"] [823 14 "/* noncharacter-FFFF */"] [824 10 "/* noncharacter-FFFE */"] [831 1 "// GET_LO and GET_HI, defined once for little2_ (E == IMPL_LITTLE2) and once"] [832 1 "// for big2_ (E == IMPL_BIG2)."] [847 1 "// DEFINE_UTF16_TO_UTF8(E): one body, E##toUtf8 for E little2_ and big2_"] [848 1 "// below (GET_LO and GET_HI take E)."] [852 54 "/* shrink to even */"] [884 4 "/* 16 bits divided 4, 6, 6 amongst 3 bytes */"] [921 1 "// DEFINE_UTF16_TO_UTF16(E), as DEFINE_UTF16_TO_UTF8."] [925 57 "/* shrink to even */"] [926 2 "/* Avoid copying the first half (2 bytes) of surrogate pairs (4 bytes) */"] [928 3 "/* are the last two bytes a high surrogate (0xD800-0xDBFF)? */"] [944 1 "// DEFINE_UTF16_TO_UTF8(little2_)"] [949 1 "// DEFINE_UTF16_TO_UTF16(little2_)"] [954 1 "// DEFINE_UTF16_TO_UTF8(big2_)"] [959 1 "// DEFINE_UTF16_TO_UTF16(big2_)"] [990 1 "/* A 4-byte UTF-16 character is a surrogate pair; byteType only reports BT_LEAD4\n   for a high surrogate, so the pair is invalid unless the second unit is a low\n   surrogate (U+DC00..U+DFFF, i.e. high byte 0xDC..0xDF). */"] [1001 47 "/* BYTEORDER != 4321 */"] [1031 1 "/* A 4-byte UTF-16 character is a surrogate pair; byteType only reports BT_LEAD4\n   for a high surrogate, so the pair is invalid unless the second unit is a low\n   surrogate (U+DC00..U+DFFF, i.e. high byte 0xDC..0xDF). */"] [1042 2 "/* BYTEORDER 1234: internal_big2_encoding(_ns) are not compiled */"] [1045 1 "// tok_encoding is one static encoding's initialiser:"] [1046 1 "// {{VTABLE1, toUtf8, toUtf16, minBytesPerChar, isUtf8, isUtf16}, type, ...}"] [1047 1 "// (VTABLE is VTABLE1 with PREFIX(toUtf8), PREFIX(toUtf16)), self set to e;"] [1048 1 "// the nine functions are NULL_VTABLE unless normal_vtable."] [1071 1 "// tok_init: the static encodings' initialisers, in C's order."] [1081 2 "/* BYTEORDER == 1234: little2's isUtf16 1, big2's 0 */"] [1100 4 "/* The following line will never get executed.  streqci() is\n\t\t\t * only called from two places, both of which guarantee to put\n\t\t\t * upper-case strings into s2.\n\t\t\t */"] [1104 28 "/* LCOV_EXCL_LINE */"] [1118 52 "/* normal_updatePosition */"] [1125 16 "/* p == buf */"] [1140 1 "/* Return 1 if there's just optional white space or there's an S\n   followed by name=val.\n*/"] [1238 1 "/* Checks a version pseudo-attribute value against the VersionNum production.\n   XML 1.0 Fourth Edition only allows the literal \"1.0\", but the Fifth\n   Edition relaxed this to \"1.\" followed by one or more digits, since Expat\n   only implements 1.0 itself but plans to track the Fifth Edition's laxer\n   grammar here so that \"1.1\" and similar aren't rejected only to have that\n   rejection reverted later. Returns true for a value matching \"1.[0-9]+\".\n   val/valEnd bound the value itself; valEnd is the upper bound used when\n   decoding the individual characters between them. */"] [1288 3 "/* The version number must not be empty; VersionNum requires at least\n\t\t   one character.  The encoding and standalone pseudo-attributes below\n\t\t   already reject an empty value, so keep version consistent. */"] [1295 3 "/* Expat implements XML 1.0 only, so any version outside the \"1.0\"/\"1.x\"\n\t\t   family is rejected. Following the Fifth Edition's VersionNum\n\t\t   production (rather than the Fourth Edition's exact \"1.0\") avoids\n\t\t   rejecting \"1.1\" now only to have to revert that once Expat tracks\n\t\t   the newer edition. */"] [1310 5 "/* a TextDecl must have an EncodingDecl */"] [1382 3 "/* minN is minimum legal resulting value for N byte sequence */"] [1389 12 "/* LCOV_EXCL_LINE: this case is always eliminated beforehand */"] [1413 11 "/* LCOV_EXCL_LINE: this case too is eliminated before calling */"] [1433 1 "// struct unknown_encoding is declared above, with normal_encoding."] [1435 1 "// AS_UNKNOWN_ENCODING is the cast ((const struct unknown_encoding *)(enc))."] [1525 2 "/* memcpy(mem, &latin1_encoding, sizeof(struct normal_encoding)), then\n\t   self is the unknown_encoding (Go's) */"] [1539 4 "/* This shouldn't really get used. */"] [1547 4 "/* Multi-byte sequences need a converter function */"] [1569 4 "/* This shouldn't really get used. */"] [1606 1 "/* If this enumeration is changed, getEncodingIndex and encodings\nmust also be changed. */"] [1617 2 "/* must match encodingNames up to here */"] [1628 1 "// getEncodingIndex's static encodingNames."] [1647 1 "/* For binary compatibility, we store the index of the encoding\n   specified at initialization in the isUtf16 member.\n*/"] [1655 1 "/* This is what detects the encoding.  encodingTable maps from\n   encoding indices to encodings; INIT_ENC_INDEX(enc) is the index of\n   the external (protocol) specified encoding; state is\n   XML_CONTENT_STATE if we're parsing an external text entity, and\n   XML_PROLOG_STATE otherwise.\n*/"] [1670 3 "/* only a single byte available for auto-detection */"] [1671 3 "/* (XML_DTD: no check of state here) */"] [1672 3 "/* so we're parsing an external text entity... */"] [1673 3 "/* if UTF-16 was externally specified, then we need at least 2 bytes */"] [1679 26 "/* possibly first byte of UTF-8 BOM */"] [1696 3 "/* 00 3C is handled in the default case */"] [1713 4 "/* Maybe a UTF-8 BOM (EF BB BF) */"] [1714 4 "/* If there's an explicitly specified (external) encoding\n\t\t\t   of ISO-8859-1 or some flavour of UTF-16\n\t\t\t   and this is an external text entity,\n\t\t\t   don't look for the BOM,\n\t\t\t   because it might be a legal data.\n\t\t\t*/"] [1737 5 "/* 0 isn't a legal data character. Furthermore a document\n\t\t\t\t   entity can only start with ASCII characters.  So the only\n\t\t\t\t   way this can fail to be big-endian UTF-16 if it it's an\n\t\t\t\t   external parsed general entity that's labelled as\n\t\t\t\t   UTF-16LE.\n\t\t\t\t*/"] [1749 5 "/* We could recover here in the case:\n\t\t\t\t    - parsing an external entity\n\t\t\t\t    - second byte is 0\n\t\t\t\t    - no externally specified encoding\n\t\t\t\t    - no encoding declaration\n\t\t\t\t   by assuming UTF-16LE.  But we don't, because this would mean when\n\t\t\t\t   presented just with a single byte, we couldn't reliably determine\n\t\t\t\t   whether we needed further bytes.\n\t\t\t\t*/"] [1770 1 "// xmltok_ns.c, included twice (NS(x) x, ns(x) x and NS(x) x##NS, ns(x)"] [1771 1 "// x##_ns), is xmltok_ns.go."]] :go/pos {:name [95 9] :package [95 1]} :go/semis [[609 6] [609 26] [853 6] [853 26] [933 6] [933 46] [1210 6] [1210 8] [1256 6] [1256 25] [1529 11] [1529 20] [1535 11] [1535 20] [1639 11] [1639 42]] :go/trails [[1630 75]]} (go/file "xmltok.go" :imports [])

;; ---- xmltok.h ----



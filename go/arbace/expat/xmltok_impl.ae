S(enc, ptr, end, nextTokPtr) */"] [1392 2 "/* CHECK_NMSTRT_CASES(enc, ptr, end, nextTokPtr) */"] [1419 3 "/* CHECK_NAME_CASES(enc, ptr, end, nextTokPtr) */"] [1455 3 "/* INVALID_CASES(ptr, nextTokPtr) */"] [1534 4 "/* indicate that this might be part of a CR/LF pair */"] [1548 5 "/* don't split CR/LF pair */"] [1616 2 "/* LEAD_CASE(2) LEAD_CASE(3) LEAD_CASE(4) */"] [1642 13 "/* XML_NS */"] [1663 3 "/* CHECK_NAME_CASES(enc, ptr, end, nextTokPtr) */"] [1687 18 "/* XML_NS */"] [1696 5 "/* CHECK_NAME_CASES(enc, ptr, end, nextTokPtr) */"] [1757 3 "/* This line cannot be executed.  The incoming data has already\n\t\t * been tokenized once, so incomplete characters like this have\n\t\t * already been eliminated from the input.  Retaining the paranoia\n\t\t * check is still valuable, however.\n\t\t */"] [1762 26 "/* LCOV_EXCL_LINE */"] [1767 3 "/* LEAD_CASE(2) LEAD_CASE(3) LEAD_CASE(4) */"] [1769 35 "/* NOTE: The encoding has already been validated. */"] [1777 4 "/* this is for inside entity references */"] [1821 3 "/* This line cannot be executed.  The incoming data has already\n\t\t * been tokenized once, so incomplete characters like this have\n\t\t * already been eliminated from the input.  Retaining the paranoia\n\t\t * check is still valuable, however.\n\t\t */"] [1826 26 "/* LCOV_EXCL_LINE */"] [1831 3 "/* LEAD_CASE(2) LEAD_CASE(3) LEAD_CASE(4) */"] [1833 35 "/* NOTE: The encoding has already been validated. */"] [1879 1 "/* XML_DTD */"] [1892 3 "/* INVALID_CASES(ptr, nextTokPtr) */"] [1957 14 "/* XML_NS */"] [1970 15 "/* $ */"] [1971 11 "/* @ */"] [1981 1 "/* This must only be called for a well-formed start-tag or empty\n   element tag.  Returns the number of attributes.  Pointers to the\n   first attsMax attributes are stored in atts.\n*/"] [1994 21 "/* defined when state == inValue;\n\t   initialization just to shut up compilers */"] [1999 3 "/* LEAD_CASE(2) LEAD_CASE(3) LEAD_CASE(4) */"] [2000 38 "/* NOTE: The encoding has already been validated. */"] [2001 4 "/* START_NAME */"] [2011 4 "/* START_NAME */"] [2062 4 "/* This case ensures that the first attribute name is counted\n\t\t\t   Apart from that we could just change state on the quote. */"] [2076 2 "/* not reached */"] [2081 2 "/* skip &# */"] [2168 4 "/* This line cannot be executed.  The incoming data has already\n\t\t\t * been tokenized once, so incomplete characters like this have\n\t\t\t * already been eliminated from the input.  Retaining the\n\t\t\t * paranoia check is still valuable, however.\n\t\t\t */"] [2173 13 "/* LCOV_EXCL_LINE */"] [2186 3 "/* LEAD_CASE(2) LEAD_CASE(3) LEAD_CASE(4) */"] [2188 35 "/* NOTE: The encoding has already been validated. */"] [2190 14 "/* XML_NS */"] [2213 3 "/* LEAD_CASE(2) LEAD_CASE(3) LEAD_CASE(4) */"] [2215 35 "/* NOTE: The encoding has already been validated. */"]] :go/pos {:name [48 9] :package [48 1]} :go/semis [[254 68] [258 68] [262 68] [392 66] [396 66] [400 66] [419 65] [423 65] [427 65] [440 69] [444 69] [448 69] [500 11] [500 18] [558 66] [562 66] [566 66] [576 34] [613 66] [617 66] [621 66] [640 65] [644 65] [648 65] [652 28] [652 53] [689 27] [689 52] [717 27] [717 52] [749 66] [753 66] [757 66] [778 65] [782 65] [786 65] [816 65] [820 65] [824 65] [848 68] [852 68] [856 68] [917 70] [921 70] [925 70] [979 70] [983 70] [987 70] [1048 66] [1052 66] [1056 66] [1094 65] [1098 65] [1102 65] [1126 68] [1130 68] [1134 68] [1156 70] [1160 70] [1164 70] [1264 66] [1268 66] [1272 66] [1282 34] [1335 66] [1339 66] [1343 66] [1365 65] [1369 65] [1373 65] [1402 66] [1406 66] [1410 66] [1429 65] [1433 65] [1437 65] [1457 67] [1461 67] [1465 67] [1508 33] [1673 65] [1677 65] [1681 65] [1706 67] [1710 67] [1714 67] [1766 34] [1830 34] [1894 67] [1898 67] [1902 67] [1952 6] [1952 31] [1997 26] [1997 28] [1998 34] [2084 27] [2084 64] [2103 7] [2103 44] [2166 6] [2166 23] [2185 34] [2212 34]]} (go/file "xmltok_impl.go" :imports [])


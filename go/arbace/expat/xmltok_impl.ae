D2: INVALID_LEAD_CASE(2) case BT_LEAD3: ... case BT_LEAD4: ..."] [191 1 "//\tcase BT_NONXML, BT_MALFORM, BT_TRAIL: *nextTokPtr = ptr; return XML_TOK_INVALID"] [193 1 "// CHECK_NAME_CASE(n, enc, ptr, end, nextTokPtr): case BT_LEAD##n."] [206 1 "// CHECK_NAME_CASES(enc, ptr, end, nextTokPtr) is"] [207 1 "//"] [208 1 "//\tcase BT_NONASCII: if !IS_NAME_CHAR_MINBPC {invalid}; fallthrough"] [209 1 "//\tcase BT_NMSTRT, BT_HEX, BT_DIGIT, BT_NAME, BT_MINUS: ptr += MINBPC(enc)"] [210 1 "//\tcase BT_LEAD2, BT_LEAD3, BT_LEAD4: CHECK_NAME_CASE(n)"] [212 1 "// CHECK_NMSTRT_CASE(n, enc, ptr, end, nextTokPtr): case BT_LEAD##n."] [225 1 "// CHECK_NMSTRT_CASES(enc, ptr, end, nextTokPtr) is"] [226 1 "//"] [227 1 "//\tcase BT_NONASCII: if !IS_NMSTRT_CHAR_MINBPC {invalid}; fallthrough"] [228 1 "//\tcase BT_NMSTRT, BT_HEX: ptr += MINBPC(enc)"] [229 1 "//\tcase BT_LEAD2, BT_LEAD3, BT_LEAD4: CHECK_NMSTRT_CASE(n)"] [237 1 "// REQUIRE_CHARS(enc, ptr, end, count) and REQUIRE_CHAR(enc, ptr, end) return"] [238 1 "// from the function: written in place as"] [239 1 "// `if !HAS_CHARS(enc, ptr, end, count) { return XML_TOK_PARTIAL }`."] [241 1 "/* ptr points to character following \"<!-\" */"] [252 4 "/* INVALID_CASES(ptr, nextTokPtr) */"] [293 1 "/* ptr points to character following \"<!\" */"] [317 4 "/* don't allow <!ENTITY% foo \"whatever\"> */"] [373 1 "/* ptr points to character following \"<?\" */"] [382 2 "/* CHECK_NMSTRT_CASES(enc, ptr, end, nextTokPtr) */"] [409 3 "/* CHECK_NAME_CASES(enc, ptr, end, nextTokPtr) */"] [438 5 "/* INVALID_CASES(ptr, nextTokPtr) */"] [490 1 "// scanCdataSection's static CDATA_LSQB."] [496 2 "/* CDATA[ */"] [556 2 "/* INVALID_CASES(ptr, nextTokPtr) */"] [577 3 "/* LEAD_CASE(2) LEAD_CASE(3) LEAD_CASE(4) */"] [596 1 "/* ptr points to character following \"</\" */"] [603 2 "/* CHECK_NMSTRT_CASES(enc, ptr, end, nextTokPtr) */"] [630 3 "/* CHECK_NAME_CASES(enc, ptr, end, nextTokPtr) */"] [664 18 "/* XML_NS */"] [665 4 "/* no need to check qname syntax here,\n\t\t\t
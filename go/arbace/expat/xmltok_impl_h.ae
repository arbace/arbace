(in-ns 'go.arbace.expat) ^{:go/comments [[1 1 "/*\n                            __  __            _\n                         ___\\ \\/ /_ __   __ _| |_\n                        / _ \\\\  /| '_ \\ / _` | __|\n                       |  __//  \\| |_) | (_| | |_\n                        \\___/_/\\_\\ .__/ \\__,_|\\__|\n                                 |_| XML parser\n\n   Copyright (c) 1997-2000 Thai Open Source Software Center Ltd\n   Copyright (c) 2000      Clark Cooper <coopercc@users.sourceforge.net>\n   Copyright (c) 2017-2019 Sebastian Pipping <sebastian@pipping.org>\n   Licensed under the MIT license:\n\n   Permission is  hereby granted,  free of charge,  to any  person obtaining\n   a  copy  of  this  software   and  associated  documentation  files  (the\n   \"Software\"),  to  deal in  the  Software  without restriction,  including\n   without  limitation the  rights  to use,  copy,  modify, merge,  publish,\n   distribute, sublicense, and/or sell copies of the Software, and to permit\n   persons  to whom  the Software  is  furnished to  do so,  subject to  the\n   following conditions:\n\n   The above copyright  notice and this permission notice  shall be included\n   in all copies or substantial portions of the Software.\n\n   THE  SOFTWARE  IS  PROVIDED  \"AS  IS\",  WITHOUT  WARRANTY  OF  ANY  KIND,\n   EXPRESS  OR IMPLIED,  INCLUDING  BUT  NOT LIMITED  TO  THE WARRANTIES  OF\n   MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN\n   NO EVENT SHALL THE AUTHORS OR  COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM,\n   DAMAGES OR  OTHER LIABILITY, WHETHER  IN AN  ACTION OF CONTRACT,  TORT OR\n   OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE\n   USE OR OTHER DEALINGS IN THE SOFTWARE.\n\n   SPDX-License-Identifier: MIT\n\n   The port to Go (queue 202e): Copyright (c) the Arbace authors, under the same MIT license.\n*/"] [40 1 "// ---- xmltok_impl.h ----"] [42 1 "// The byte types (an anonymous enum in C: untyped constants here, as they are"] [43 1 "// stored in uint8 tables and compared with int results)."] [45 21 "/* e.g. noncharacter-FFFF */"] [46 21 "/* illegal, with regard to encoding */"] [47 21 "/* less than = \"<\" */"] [48 21 "/* ampersand = \"&\" */"] [49 21 "/* right square bracket = \"[\" */"] [50 21 "/* lead byte of a 2-byte UTF-8 character */"] [51 21 "/* lead byte of a 3-byte UTF-8 character */"] [52 21 "/* lead byte of a 4-byte UTF-8 character */"] [53 21 "/* trailing unit, e.g. second 16-bit unit of a 4-byte char. */"] [54 21 "/* carriage return = \"\\r\" */"] [55 21 "/* line feed = \"\\n\" */"] [56 21 "/* greater than = \">\" */"] [57 21 "/* quotation character = \"\\\"\" */"] [58 21 "/* apostrophe = \"'\" */"] [59 21 "/* equal sign = \"=\" */"] [60 21 "/* question mark = \"?\" */"] [61 21 "/* exclamation mark = \"!\" */"] [62 21 "/* solidus, slash = \"/\" */"] [63 21 "/* semicolon = \";\" */"] [64 21 "/* number sign = \"#\" */"] [65 21 "/* left square bracket = \"[\" */"] [66 21 "/* white space, e.g. \"\\t\", \" \"[, \"\\r\"] */"] [67 21 "/* non-hex name start letter = \"G\"..\"Z\" + \"g\"..\"z\" + \"_\" */"] [68 21 "/* colon = \":\" */"] [69 21 "/* hex letter = \"A\"..\"F\" + \"a\"..\"f\" */"] [70 21 "/* digit = \"0\"..\"9\" */"] [71 21 "/* dot and middle dot = \".\" + chr(0xb7) */"] [72 21 "/* minus = \"-\" */"] [73 21 "/* known not to be a name or name start character */"] [74 21 "/* might be a name or name start character */"] [75 21 "/* percent sign = \"%\" */"] [76 21 "/* left parenthesis = \"(\" */"] [77 21 "/* right parenthesis = \"(\" */"] [78 21 "/* asterisk = \"*\" */"] [79 21 "/* plus sign = \"+\" */"] [80 21 "/* comma = \",\" */"] [81 21 "/* vertical bar = \"|\" */"]] :go/pos {:name [38 9] :package [38 1]} :go/semis []} (go/file "xmltok_impl_h.go" :imports [])

;; ---- xmltok_impl.h ----



^{:go/pos {:doc [42 1] :lparen [44 7] :rparen [82 1] :tok-pos [44 1]}} (go/const "The byte types (an anonymous enum in C: untyped constants here, as they are\nstored in uint8 tables and compared with int results).\n"
  [^{:val 0 :go/pos {:name-pos [45 2]}} BT_NONXML ^{:go/pos {:name-pos [45 16]}} iota] ; /* e.g. noncharacter-FFFF */
  [^{:val 1 :go/pos {:name-pos [46 2]}} BT_MALFORM] ; /* illegal, with regard to encoding */
  [^{:val 2 :go/pos {:name-pos [47 2]}} BT_LT] ; /* less than = "<" */
  [^{:val 3 :go/pos {:name-pos [48 2]}} BT_AMP] ; /* ampersand = "&" */
  [^{:val 4 :go/pos {:name-pos [49 2]}} BT_RSQB] ; /* right square bracket = "[" */
  [^{:val 5 :go/pos {:name-pos [50 2]}} BT_LEAD2] ; /* lead byte of a 2-byte UTF-8 character */
  [^{:val 6 :go/pos {:name-pos [51 2]}} BT_LEAD3] ; /* lead byte of a 3-byte UTF-8 character */
  [^{:val 7 :go/pos {:name-pos [52 2]}} BT_LEAD4] ; /* lead byte of a 4-byte UTF-8 character */
  [^{:val 8 :go/pos {:name-pos [53 2]}} BT_TRAIL] ; /* trailing unit, e.g. second 16-bit unit of a 4-byte char. */
  [^{:val 9 :go/pos {:name-pos [54 2]}} BT_CR] ; /* carriage return = "\r" */
  [^{:val 10 :go/pos {:name-pos [55 2]}} BT_LF] ; /* line feed = "\n" */
  [^{:val 11 :go/pos {:name-pos [56 2]}} BT_GT] ; /* greater than = ">" */
  [^{:val 12 :go/pos {:name-pos [57 2]}} BT_QUOT] ; /* quotation character = "\"" */
  [^{:val 13 :go/pos {:name-pos [58 2]}} BT_APOS] ; /* apostrophe = "'" */
  [^{:val 14 :go/pos {:name-pos [59 2]}} BT_EQUALS] ; /* equal sign = "=" */
  [^{:val 15 :go/pos {:name-pos [60 2]}} BT_QUEST] ; /* question mark = "?" */
  [^{:val 16 :go/pos {:name-pos [61 2]}} BT_EXCL] ; /* exclamation mark = "!" */
  [^{:val 17 :go/pos {:name-pos [62 2]}} BT_SOL] ; /* solidus, slash = "/" */
  [^{:val 18 :go/pos {:name-pos [63 2]}} BT_SEMI] ; /* semicolon = ";" */
  [^{:val 19 :go/pos {:name-pos [64 2]}} BT_NUM] ; /* number sign = "#" */
  [^{:val 20 :go/pos {:name-pos [65 2]}} BT_LSQB] ; /* left square bracket = "[" */
  [^{:val 21 :go/pos {:name-pos [66 2]}} BT_S] ; /* white space, e.g. "\t", " "[, "\r"] */
  [^{:val 22 :go/pos {:name-pos [67 2]}} BT_NMSTRT] ; /* non-hex name start letter = "G".."Z" + "g".."z" + "_" */
  [^{:val 23 :go/pos {:name-pos [68 2]}} BT_COLON] ; /* colon = ":" */
  [^{:val 24 :go/pos {:name-pos [69 2]}} BT_HEX] ; /* hex letter = "A".."F" + "a".."f" */
  [^{:val 25 :go/pos {:name-pos [70 2]}} BT_DIGIT] ; /* digit = "0".."9" */
  [^{:val 26 :go/pos {:name-pos [71 2]}} BT_NAME] ; /* dot and middle dot = "." + chr(0xb7) */
  [^{:val 27 :go/pos {:name-pos [72 2]}} BT_MINUS] ; /* minus = "-" */
  [^{:val 28 :go/pos {:name-pos [73 2]}} BT_OTHER] ; /* known not to be a name or name start character */
  [^{:val 29 :go/pos {:name-pos [74 2]}} BT_NONASCII] ; /* might be a name or name start character */
  [^{:val 30 :go/pos {:name-pos [75 2]}} BT_PERCNT] ; /* percent sign = "%" */
  [^{:val 31 :go/pos {:name-pos [76 2]}} BT_LPAR] ; /* left parenthesis = "(" */
  [^{:val 32 :go/pos {:name-pos [77 2]}} BT_RPAR] ; /* right parenthesis = "(" */
  [^{:val 33 :go/pos {:name-pos [78 2]}} BT_AST] ; /* asterisk = "*" */
  [^{:val 34 :go/pos {:name-pos [79 2]}} BT_PLUS] ; /* plus sign = "+" */
  [^{:val 35 :go/pos {:name-pos [80 2]}} BT_COMMA] ; /* comma = "," */
  [^{:val 36 :go/pos {:name-pos [81 2]}} BT_VERBAR]) ; /* vertical bar = "|" */

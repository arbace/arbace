;; ---- MALLOC, REALLOC, FREE (XML_GE == 1: the allocation tracker) ----
;;
;; The Go object is allocated by the caller; these account C's sizes and
;; refuse as C's do (false is C's NULL):
;;
;;	MALLOC(parser, size) bool             then x := new(T) / make([]T, n) / Ptr{B: make([]byte, size)}
;;	REALLOC(parser, oldSize, size) bool   then grow the slice into a new one (copy)
;;	FREE(parser, size)                    the size the block was given
;;
;; A NULL block is the size NULL_BLOCK (blockSize, ptrBlock make it): FREE of
;; NULL_BLOCK does nothing (expat_free's `if (ptr == NULL) return;`), REALLOC
;; of NULL_BLOCK is MALLOC (expat_realloc's first test), and REALLOC to size 0
;; frees and returns false. C's __LINE__ of the macros is lost (0): it shows
;; only in EXPAT_MALLOC_DEBUG's report.
;;
;; The bodies are xmlparse_api.go's (stubs_api.go until then).



^{:go/pos {:doc [735 1] :tok-pos [737 1]}} (go/const ^{:tag ^{:go/pos {:name-pos [737 18]}} uint64 :val 18446744073709551615N :doc "NULL_BLOCK is the size of a NULL pointer: no C block can have it, since\nexpat_malloc refuses SIZE_MAX - size < sizeof(size_t) + EXPAT_MALLOC_PADDING.\n" :go/pos {:name-pos [737 7]}} NULL_BLOCK ^{:go/pos {:name-pos [737 27]}} SIZE_MAX)


^{:go/pos {:doc [739 1] :func [740 1] :lbrace [740 49] :rbrace [745 1] :return [744 2]}} (go/func ^{:go/pos {:name-pos [740 6]}} blockSize "blockSize is size, or NULL_BLOCK when the pointer is NULL.\n" ^{:tag ^{:go/pos {:name-pos [740 42]}} uint64 :go/pos {:closing [740 40] :opening [740 15]}} [^{:tag ^{:go/pos {:name-pos [740 23]}} bool :go/pos {:name-pos [740 16]}} isNull ^{:tag ^{:go/pos {:name-pos [740 34]}} uint64 :go/pos {:name-pos [740 29]}} size]
  ^{:go/pos {:if [741 2] :lbrace [741 12] :rbrace [743 2]}} (when ^{:go/pos {:name-pos [741 5]}} isNull
    ^{:go/pos {:return [742 3]}} (return ^{:go/pos {:name-pos [742 10]}} NULL_BLOCK))


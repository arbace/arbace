(go/var jsDays (lit (slice string) "Thu" "Fri" "Sat" "Sun" "Mon" "Tue" "Wed"))
(go/var jsMonths (lit (slice string) "Jan" "Feb" "Mar" "Apr" "May" "Jun" "Jul" "Aug" "Sep" "Oct" "Nov" "Dec"))


^{:go/end 1222} (go/func jsCivil "jsCivil is a time value's UTC date and time (days from civil, Howard Hinnant's algorithm).\n" [^float64 t] :results [^int y ^int mo ^int d ^int h ^int mi ^int s ^int ms ^int wd]
  (let [tm (conv int64 (math/Floor t))
      ^{:line 1201} day (floorDiv tm 86400000)
      ^{:line 1202} rem (- tm (* day 86400000))]
    (set! (values h mi s ms) (values (conv int (/ rem 3600000)) (conv int (% (/ rem 60000) 60)) (conv int (% (/ rem 1000) 60)) (conv int (% rem 1000))))
    (set! wd (conv int (% (+ (% day 7) 7) 7)))
    (let [z (+ day 719468)
        ^{:line 1206} era (floorDiv z 146097)
        ^{:line 1207} doe (- z (* era 146097))
        ^{:line 1208} yoe (/ (- (+ (- doe (/ doe 1460)) (/ doe 36524)) (/ doe 146096)) 365)
        ^{:line 1209} yy (+ yoe (* era 400))
        ^{:line 1210} doy (- doe (- (+ (* 365 yoe) (/ yoe 4)) (/ yoe 100)))
        ^{:line 1211} mp (/ (+ (* 5 doy) 2) 153)]
      (set! d (conv int (+ (- doy (/ (+ (* 153 mp) 2) 5)) 1)))
      (if (< mp 10)
        (set! mo (conv int (+ mp 3)))

        (set! mo (conv int (- mp 9))))

      (when (<= mo 2)
        (inc! yy))

      (return (conv int yy) mo d h mi s ms wd))))


^{:go/end 1230} (go/func floorDiv ^int64 [^int64 a ^int64 b]

      (set! s (+ "0" s)))

    ^{:line 1237} s))


^{:go/end 1244} (go/func jsDateString ^string [^float64 t]
  (let [(values y mo d h mi s _ wd) (jsCivil t)]
    (+ (aget jsDays wd) " " (aget jsMonths (- mo 1)) " " (pad d 2) " " (pad y 4) " " (pad h 2) ":" (pad mi 2) ":"
      (pad s 2) " GMT+0000 (Coordinated Universal Time)")))


^{:go/end 1249} (go/func jsISODate ^string [^float64 t]
  (let [(values y mo d h mi s ms _) (jsCivil t)]
    (+ (pad y 4) "-" (pad mo 2) "-" (pad d 2) "T" (pad h 2) ":" (pad mi 2) ":" (pad s 2) "." (pad ms 3) "Z")))

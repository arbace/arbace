            (set! (.-Inits e) (append (.-Inits e) (.constExpr d (lit (slice ValType) (.-Type e)))))

            (set! (.-Inits e) (append (.-Inits e) (refFuncCode (.u32 r))))))


        ^{:line 564} e))))



^{:go/end 570} (go/func refFuncCode "refFuncCode is the constant expression (ref.func X).\n" ^{:tag (* Code)} [^uint32 x]
  (addr (lit Code :Ins (lit (slice Ins) (lit _ :Op OpRefFunc :A x) (lit _ :Op OpReturn :A 1)) :NResults 1 :MaxHeight 1)))

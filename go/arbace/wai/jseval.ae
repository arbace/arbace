;; var/let/const, if/else, while, for(;;), return, throw, try/catch/finally, the operators of assignment (= += -= *= /=), ?:, || &&,
;; ?? , == != === !==, < > <= >=, + - * / %, unary ! - + typeof void, prefix and postfix ++ --, calls, member access, new, delete,

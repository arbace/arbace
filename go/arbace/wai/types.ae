^{:go/end 71} (go/method String ^string [^ValType t]
  (switch (.-K t)
    (case [tI32]
      (return "i32"))
    (case [tI64]
      (return "i64"))
    (case [tF32]
      (return "f32"))
    (case [tF64]
      (return "f64"))
    (case [tV128]
      (return "v128"))
    (case [tI8]
      (return "i8"))
    (case [tI16]
      (return "i16")))

  (let [n ""]
    (when (.-Null t)
      (set! n "null "))

    (+ "(ref " n (heapName (.-H t)) ")")))


^{:go/end 101} (go/func heapName ^string [^int32 h]
  (switch h
    (case [hNoExn]
      (return "noexn"))
    (case [hNoFunc]
      (return "nofunc"))
    (case [hNoExtern]
      (return "noextern"))
    (case [hNone]
      (return "none"))
    (case [hFunc]
      (return "func"))
    (case [hExtern]
      (return "extern"))
    (case [hAny]
      (return "any"))
    (case [hEq]
      (return "eq"))
    (case [hI31]
      (return "i31"))
    (case [hStruct]
      (return "struct"))
    (case [hArray]
      (return "array"))
    (case [hExn]
      (return "exn")))

  (fmt/Sprintf "$%d" h))




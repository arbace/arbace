^{:go/end 160} (go/func keyVT [^{:tag (* strings/Builder)} b ^ValType t ^int base ^int n ^{:tag (slice int)} canon]
  (fmt/Fprintf b "%02x" (.-K t))
  (defer (.WriteByte b \,))
  (when (!= (.-K t) tRef)
    (return))

  (when (.-Null t)
    (.WriteByte b \n))

  (.WriteByte b \:)
  (let [h (conv int (.-H t))]
    (cond (< h 0)
      (fmt/Fprintf b "a%d" (- h))
      (and (>= h base) (< h (+ base n)))
      (fmt/Fprintf b "r%d" (- h base)) :else

      (fmt/Fprintf b "c%d" (aget canon h)))))





    (case [hNoFunc]
      (return (or (== b hFunc) ^:go/paren (and (>= b 0) (== (.-Kind (aget ctypes b)) cFunc)))))
    (case [hNoExtern]
      (return (== b hExtern)))
    (case [hNoExn]
      (return (== b hExn)))
    (case [hEq hI31 hStruct hArray]

^{:go/breaks [[8 304]] :go/end 305} (go/func heapSub "heapSub is the heap types' subtyping (the spec's match.ml, over canonical ids).\n" ^bool [^int32 a ^int32 b]
  (when (== a b)
    (return true))

  (when (and (>= a 0) (>= b 0))
    (return (subCanon (conv int a) (conv int b))))

  (when (>= a 0)
    (let [k (.-Kind (aget ctypes a))]
      (switch b
        (case [hAny]

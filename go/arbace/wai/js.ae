    ^{:line 36 :tag any} Prim ; a Number's, Boolean's or String's wrapped value, a Date's time value (ms)
    ^{:line 37 :tag (func [^any this ^{:tag (slice any)} args] [any])} Fn
    ^{:line 38 :tag (func [^{:tag (slice any)} args] [any])} Ctor
    ^{:line 39 :tag bool} Frozen

    ^{:line 41 :tag (func [^string key] [any bool]) :doc "Getter is an exotic object's property read (the Go object's _values, a recording fake's methods): ok false for none\n"} Getter

    ^{:line 43 :tag (func [^string key ^any v] [bool]) :doc "Setter is an exotic object's property write: true when it took it\n"} Setter
    ^{:line 44 :tag string} Name
    ^{:line 45 :tag int} ID)) ; a recording fake's number




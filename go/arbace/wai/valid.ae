    ^{:line 44 :tag (slice TableType)} tables
    ^{:line 45 :tag (slice Limits)} mems
    ^{:line 46 :tag (slice GlobalType)} globals
    ^{:line 47 :tag (slice int)} tags
    ^{:line 48 :tag (slice ValType)} elems
    ^{:line 49 :tag int} ndata

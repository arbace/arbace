    ^{:line 39 :tag (* reader)} r
    ^{:line 40 :tag (* dec)} d
    ^{:line 41 :tag int} ntypes
    ^{:line 42 :tag (slice int)} funcs
    ^{:line 43 :tag int} nimpf

          (switch e
            (case [syscall/EACCES]
              (return eAcces))
            (case [syscall/EBADF]
              (return eBadf))
            (case [syscall/EEXIST]
              (return eExist))
            (case [syscall/EINVAL]
              (return eInval))
            (case [syscall/EISDIR]
              (return eIsdir))
            (case [syscall/ELOOP]
              (return eLoop))
            (case [syscall/ENAMETOOLONG]
              (return eNametoolong))
            (case [syscall/ENOENT]
              (return eNoent))
            (case [syscall/ENOTDIR]
              (return eNotdir))
            (case [syscall/ENOTEMPTY]
              (return eNotempty))
            (case [syscall/EPERM]

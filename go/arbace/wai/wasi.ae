^{:go/end 187} (go/func wasiErr "wasiErr is the snapshot's errno of a host error.\n" ^uint32 [^error err]
  (when (== err nil)
    (return eSuccess))

  (let [^{:tag (* fs/PathError)} pe (zero (* fs/PathError))]
    (when (errors/As err (addr pe))
      (set! err (.-Err pe)))

    (let [^{:tag (* os/LinkError)} le (zero (* os/LinkError))]

^{:go/end 64} (go/method recoverTo "recoverTo turns the engine's panics into errors at its boundary: a trap, an exhaustion, an uncaught exception, else a crash\n(a fault of wai's own, with its stack's first lines).\n" [^{:tag (* Machine)} m ^{:tag (* error)} err]
  (let [x (recover)]

(in-ns 'go.arbace.wai) (go/file "spectest.go" :imports [


    ^{:line 4} [fmt "fmt"]
    ^{:line 5} [math "math"]])




^{:go/end 43} (go/func Spectest "Spectest is the testsuite's host module (the spec's interpreter/host/spectest.ml): print and its typed kin writing to the\nstore's output, the four constant globals (666, 666.6), a table and a table64 of 10 to 20 funcrefs, a memory of 1 to 2 pages.\n" ^{:tag (* Instance)} [^{:tag (* Machine)} m]
  (let [inst (addr (lit Instance :Exports (lit (map string Extern))))
      ^{:line 12} fn ^{:go/end 22} (fn [^string name & ^{:tag (slice ValType)} params]
        (let [f (.addFunc (.-St m) (addr (lit Func :Type (funcTypeID params nil) :Host ^{:go/end 20} (fn ^{:tag (slice V)} [^{:tag (* Machine)} m ^{:tag (slice V)} args]
                    ^{:go/breaks [4]} (let [s name]
                      (range [i a args]
                        (set! s + (+ " " (showValue a (aget params i)))))

                      (set! (.-Out (.-St m)) (append (.-Out (.-St m)) s))
                      nil)))))]

          (aset (.-Exports inst) name (lit Extern :Kind xFunc :Func f))))

      (values i32 i64 f32 f64) (values (lit ValType :K tI32) (lit ValType :K tI64) (lit ValType :K tF32) (lit ValType :K tF64))]
    (go/call fn "print")
    (go/call fn "print_i32" i32)
    (go/call fn "print_i64" i64)
    (go/call fn "print_f32" f32)
    (go/call fn "print_f64" f64)
    (go/call fn "print_i32_f32" i32 f32)
    (go/call fn "print_f64_f64" f64 f64)
    (let [glob ^{:go/end 33} (fn [^string name ^ValType t ^V v]
          (aset (.-Exports inst) name (lit Extern :Kind xGlobal :Global (addr (lit Global :T (lit GlobalType :T t) :Val v)))))]

      (glob "global_i32" i32 (lit V :L 666))
      (glob "global_i64" i64 (lit V :L 666))
      (glob "global_f32" f32 (lit V :L (conv uint64 (math/Float32bits 666.6))))
      (glob "global_f64" f64 (lit V :L (math/Float64bits 666.6)))
      (let [fref (lit ValType :K tRef :Null true :H hFunc)]
        (aset (.-Exports inst) "table" (lit Extern :Kind xTable :Table (addr (lit Table :T (lit TableType :L (lit Limits :Min 10 :Max 20 :HasMax true) :Elem fref) :Elems (make (slice V) 10)))))
        (aset (.-Exports inst) "table64" (lit Extern :Kind xTable :Table (addr (lit Table :T (lit TableType :L (lit Limits :Addr64 true :Min 10 :Max 20 :HasMax true) :Elem fref) :Elems (make (slice V) 10)))))
        (aset (.-Exports inst) "memory" (lit Extern :Kind xMemory :Mem (addr (lit Memory :T (lit Limits :Min 1 :Max 2 :HasMax true) :Data (make (slice byte) 65536)))))
        ^{:line 42} inst))))


^{:go/end 57} (go/func showValue ^string [^V v ^ValType t]
  (switch (.-K t)
    (case [tI32]
      (return (fmt/Sprintf "%d" (conv int32 (.-L v)))))
    (case [tI64]
      (return (fmt/Sprintf "%d" (conv int64 (.-L v)))))
    (case [tF32]
      (return (fmt/Sprintf "%g" (math/Float32frombits (conv uint32 (.-L v))))))
    (case [tF64]
      (return (fmt/Sprintf "%g" (math/Float64frombits (.-L v))))))

  (fmt/Sprintf "%x:%x" (.-H v) (.-L v)))



^{:go/end 60} (go/func FuncParams "FuncParams and FuncResults are a function's parameter and result types.\n" ^{:tag (slice ValType)} [^{:tag (* Func)} f] (.-Params (aget ctypes (.-Type f))))
^{:go/end 61} (go/func FuncResults ^{:tag (slice ValType)} [^{:tag (* Func)} f] (.-Results (aget ctypes (.-Type f))))


^{:go/end 69} (go/method Kind "Kind is a value type's kind's name: i32, i64, f32, f64, v128 or ref.\n" ^string [^ValType t]
  (when (== (.-K t) tRef)
    (return "ref"))

  (.String t))




^{:go/breaks [[7 94]] :go/end 95} (go/func RefKind "RefKind names a reference value's kind for the scripts' patterns: null, func, host, i31, struct, array, exn, extern (a host's\nextern or an internal reference made external).\n" ^string [^V v]
  (when (== (.-H v) 0)
    (return "null"))

  (when (!= (bit-and (.-H v) rExt) 0)
    (return "extern"))

  (switch (.-H v)
    (case [rFunc]
      (return "func"))
    (case [rHost]
      (return "host"))
    (case [rI31]
      (return "i31"))
    (case [rStruct]
      (return "struct"))
    (case [rArray]
      (return "array"))
    (case [rExn]
      (return "exn")))

  "?")



^{:go/end 98} (go/func HostRef "HostRef is the scripts' (ref.host N), ExternRef their (ref.extern N).\n" ^V [^uint64 n] (lit V :L n :H rHost))
^{:go/end 99} (go/func ExternRef ^V [^uint64 n] (lit V :L n :H (bit-or rHost rExt)))


^{:go/end 113} (go/func OpRows "OpRows is the instruction table as repr/wasm's rows, PREFIX CODE NAME KIND a line (bin/wai ops check).\n" ^{:tag (slice string)} []
  (let [^{:tag (slice string)} out (zero (slice string))]
    (for [op 1] (< op opTableEnd) (inc! op)
      (let [in (aget opInfos op)
          ^{:line 106} p "nil"]
        (when (!= (.-prefix in) 0)
          (set! p (fmt/Sprintf "0x%02x" (.-prefix in))))

        (set! out (append out (fmt/Sprintf "%s 0x%02x %s :%s" p (.-code in) (.-name in) (aget kindNames (.-kind in)))))))

    ^{:line 112} out))

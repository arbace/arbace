(go/var ^bool aotDisabled)


^{:go/end 44} (go/func AOTDisable "AOTDisable leaves every module to the interpreter while the registry stays (the AOT level's negative control).\n" [] (set! aotDisabled true))

^{:go/end 51} (go/func aotNatives ^{:tag (map int NativeFn)} [^{:tag (* Module)} mod]
  (when (or (== (len aotRegistry) 0) aotDisabled)

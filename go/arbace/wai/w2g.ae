    ^{:line 15} [fmt "fmt"]
    ^{:line 16} [strconv "strconv"]
    ^{:line 17} [strings "strings"]])



(go/type NativeFn "NativeFn is a function translated by w2g: the frame's base fp as the interpreter's exec has it.\n" (func [^{:tag (* Machine)} m ^{:tag (* Func)} f ^int fp] [(* Exn)]))

(go/var aotRegistry (lit (map (array 32 byte) (map int NativeFn))))




                    (.WriteString b (call (fmt/Sprintf "\t\tg = inst.Funcs[%s]\n" (idx k (.-A in))))))
                  (case [OpCallIndirect]
                    (.WriteString b (call (fmt/Sprintf w2gIndirect (idx k (.-A in)) k))))
                  (case [OpCallRef]
                    (.WriteString b (call w2gRef)))
                  (case [OpThrow]
                    (fmt/Fprintf b ^{:go/breaks [2]} (+ "\t{\n\t\ttag := inst.Tags[%s]\n\t\tn := len((*X_ctypes)[tag.Type].Params)\n\t\tvals := make([]V, n)\n"
                        "\t\tcopy(vals, st[sp-n:sp])\n%s\t}\n") (idx k (.-A in)) (raise "&Exn{Tag: tag, Vals: vals}" k "\t\t")))
                  (case [OpThrowRef]
                    (.WriteString b (+ "\tsp--\n\tif st[sp].H == 0 {\n\t\tX_trap(\"null exception reference\")\n\t}\n" (raise "m.St.Objs[st[sp].L].(*Exn)" k "\t"))))
                  (default
                    (let [(values body ok) (aget w2gCases (.-Op in))]
                      (when (not ok)
                        (set! body w2gDefault))

                      (.WriteString b (+ "\t{\n" (w2gFields body c k shared) "\t}\n")))))))


            (when seg
              (fmt/Fprintf b "\treturn %d, nil\n" hi))

            (when thrown
              ;; the handlers: the clause's target with its values pushed (Machine.catch), else the exception to the caller
              (.WriteString b ^{:go/breaks [4]} (+ "Lthrow:\n\t{\n\t\tnpc, nsp, ok := m.X_catch(code, inst, fp, at, exn)\n\t\tif !ok {\n\t\t\t" (retE "exn") "\n\t\t}\n"
                  "\t\tst = m.X_stack()\n\t\tsp = nsp\n\t\tswitch npc {\n"))
              (let [seen (lit (map int bool))]
                (range [_ h (.-Handlers c)]
                  (range [_ cl (.-Catches h)]
                    (when (or (== (.-Kind cl) catchDelegate) (aget seen (conv int (.-PC cl))))
                      (continue))

                    (aset seen (conv int (.-PC cl)) true)
                    (fmt/Fprintf b "\t\tcase %d:\n%s" (.-PC cl) (jump (conv int (.-PC cl)) "\t\t\t"))))


                (.WriteString b "\t\t}\n\t\tpanic(\"w2g: no handler's target\")\n\t}\n")))

            (.WriteString b "}\n\n")))))))



(go/const ^{:val "\t\tsp--\n\t\ti := st[sp].L\n\t\ttb := inst.Tables[%s]\n\t\tif i >= uint64(len(tb.Elems)) {\n\t\t\tX_trap(\"undefined element \" + strconv.FormatUint(i, 10))\n\t\t}\n\t\tr := tb.Elems[i]\n\t\tif r.H == 0 {\n\t\t\tX_trap(\"uninitialized element \" + strconv.FormatUint(i, 10))\n\t\t}\n\t\tg = m.St.Funcs[r.L]\n\t\tif !X_subCanon(g.Type, int(code.Ins[%d].B)) {\n\t\t\tX_trap(\"indirect call type mismatch\")\n\t\t}\n" :doc "the callee of call_indirect (table, instruction) and call_ref, into g\n"} w2gIndirect ^{:go/breaks [2 3 4]} (+ "\t\tsp--\n\t\ti := st[sp].L\n\t\ttb := inst.Tables[%s]\n"
    "\t\tif i >= uint64(len(tb.Elems)) {\n\t\t\tX_trap(\"undefined element \" + strconv.FormatUint(i, 10))\n\t\t}\n"
    "\t\tr := tb.Elems[i]\n\t\tif r.H == 0 {\n\t\t\tX_trap(\"uninitialized element \" + strconv.FormatUint(i, 10))\n\t\t}\n"
    "\t\tg = m.St.Funcs[r.L]\n\t\tif !X_subCanon(g.Type, int(code.Ins[%d].B)) {\n\t\t\tX_trap(\"indirect call type mismatch\")\n\t\t}\n"))

(go/const ^{:val "\t\tsp--\n\t\tif st[sp].H == 0 {\n\t\t\tX_trap(\"null function reference\")\n\t\t}\n\t\tg = m.St.Funcs[st[sp].L]\n"} w2gRef "\t\tsp--\n\t\tif st[sp].H == 0 {\n\t\t\tX_trap(\"null function reference\")\n\t\t}\n\t\tg = m.St.Funcs[st[sp].L]\n")

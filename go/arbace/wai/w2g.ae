    ^{:line 15} [binary "encoding/binary"]
    ^{:line 16} [hex "encoding/hex"]
    ^{:line 17} [fmt "fmt"]
    ^{:line 18} [sort "sort"]
    ^{:line 19} [strconv "strconv"]

          (case [OpBrTable]
            (let [tb (aget (.-Tables c) (.-B in))
                ;; the entries grouped by target (the last is the default, as are indices beyond)
                ^{:line 217} last (aget tb (- (len tb) 1))
                ^{:line 218} groups (lit (map target (slice int)))
                ^{:line 219 :tag (slice target)} order (zero (slice target))]
              (range [i t (subslice tb _ (- (len tb) 1))]
                (when (== t last)
                  (continue))

                (when [(values _ ok) (aget groups t)] (not ok)
                  (set! order (append order t)))

                (aset groups t (append (aget groups t) i)))

              (.WriteString b "\tsp--\n\tswitch uint32(st[sp].L) {\n")
              (range [_ t order]
                (let [ks (make (slice string) (len (aget groups t)))]
                  (range [i x (aget groups t)]

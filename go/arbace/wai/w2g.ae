  (aget aotRegistry (.-Hash mod)))




^{:go/end 61} (go/func AOTInterpreted "AOTInterpreted is the number of the module's defined functions an AOT program runs on the interpreter (w2g left them), and\nwhether the module was translated at all.\n" [^{:tag (* Module)} mod] :results [^int n ^bool translated]

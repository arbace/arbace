                  (.WriteString b (+ "\tcase " (strings/Join ks ", ") ":\n" (brTo (.-A in) (.-Height t) (conv int (.-PC t)) "\t\t")))))

              (.WriteString b (+ "\tdefault:\n" (brTo (.-A in) (.-Height last) (conv int (.-PC last)) "\t\t") "\t}\n"))))
          (case [OpBrOnNull]
            (.WriteString b (+ "\tif st[sp-1].H == 0 {\n\t\tsp--\n" (brTo (.-A in) (.-B in) (conv int (.-C in)) "\t\t") "\t}\n")))
          (case [OpBrOnNonNull]
            (.WriteString b (+ "\tif st[sp-1].H != 0 {\n" (brTo (.-A in) (.-B in) (conv int (.-C in)) "\t\t") "\t}\n")))
          (case [OpBrOnCast OpBrOnCastFail]

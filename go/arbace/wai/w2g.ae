              (return (fmt/Sprintf "%scopy(st[fp:fp+%d], st[sp-%d:sp])\n%sreturn nil\n" ind n n ind))))

          (fmt/Sprintf "%sgoto L%d\n" ind t))

        ^{:line 187} brTo ^{:go/end 189} (fn ^string [^uint32 a ^uint32 h ^int t ^string ind]
          (+ (fmt/Sprintf "%ssp = X_br(st, sp, fp, %d, %d)\n" ind a h) (jump t ind)))

        ^{:line 190} call ^{:go/end 195} (fn ^string [^string get]
          ^{:go/breaks [4 5 6]} (+ "\t{\n" get "\t\tt := (*X_ctypes)[g.Type]\n\t\tnp := len(t.Params)\n\t\tbase := sp - np\n"
            "\t\tif g.Host != nil {\n\t\t\targs := make([]V, np)\n\t\t\tcopy(args, st[base:base+np])\n\t\t\tres := g.Host(m, args)\n"
            "\t\t\tst = m.X_stack()\n\t\t\tcopy(st[base:], res)\n\t\t\tsp = base + len(res)\n\t\t} else {\n\t\t\te := m.X_run(g, base)\n\t\t\tst = m.X_stack()\n"
            "\t\t\tif e != nil {\n\t\t\t\treturn e\n\t\t\t}\n\t\t\tsp = base + len(t.Results)\n\t\t}\n\t}\n"))]

      (range [k in (.-Ins c)]
        (when (aget targets k)
          (fmt/Fprintf b "L%d:\n" k))

        (when (!= (.-Op in) OpReturn)
          (fmt/Fprintf b "\tsp = fp + %d\n" (aget (.-H c) k)))

        (switch (.-Op in)
          (case [OpBr]
            (.WriteString b (brTo (.-A in) (.-B in) (conv int (.-C in)) "\t")))
          (case [OpBrIf]

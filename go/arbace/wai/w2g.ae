    (when (== m nil)
      (set! m (lit (map int NativeFn)))
      (aset aotRegistry h m))

    (range [i f fns]
      (aset m i f))))





(go/var ^{:doc "aotShapes holds the functions translated by shape (WAS40 (c), WAS50 (a)): a function of any module whose ShapeKey is one of\nthem runs as Go, its immediates read from its own code.\n"} aotShapes (lit (map (array 16 byte) NativeFn)))



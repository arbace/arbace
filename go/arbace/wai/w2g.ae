          (case [OpIf]
            (.WriteString b (+ "\tsp--\n\tif uint32(st[sp].L) == 0 {\n" (jump (conv int (.-C in)) "\t\t") "\t}\n")))
          (case [OpJump]
            (.WriteString b (jump (conv int (.-C in)) "\t")))
          (case [OpReturn]

(ns go.arbace.pyctypes
  (:require [arbace.go :as go]))

(go/package pyctypes
  :path "arbace/pyctypes"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["callproc.go" "capi.go" "capi_getargs.go" "capi_heaptype.go" "capi_limited.go" "capi_mirror.go" "capi_more.go" "capi_objects.go" "capi_parts.go" "capi_port.go" "capi_types.go" "capi_unicode.go" "cfield.go" "ctypes.go" "ffi.go" "module.go" "world.go"]
  :test-files ["ffi_test.go"]
  :init-order [worldLibs ["capi.go" 648 5] bufViews moduleDefs keptStrings slotOffsets heapSubs genericSlots held mirrors syncEpoch rawTypes moduleStates binSlots cTypes builtinSizes cifCache nativeAddrs uwriters formattable bytesCopies stgs rawMemoryType pyCSimpleType pyCStructType unionType pyCArrayType pyCPointerType pyCFuncPtrType cDataType simpleType structType unionBaseType arrayType pointerType funcPtrType cFieldType cArgType arrayCache TVoid TUInt8 TSInt8 TUInt16 TSInt16 TUInt32 TSInt32 TUInt64 TSInt64 TFloat TDouble TLongDouble TPointer ErrBadTypedef ErrBadArgType getsetType handles handleOf keepType varProxies bhilfd ffiCases]
  :positions :full)

(load "pyctypes/callproc")
(load "pyctypes/capi")
(load "pyctypes/capi_getargs")
(load "pyctypes/capi_heaptype")
(load "pyctypes/capi_limited")
(load "pyctypes/capi_mirror")
(load "pyctypes/capi_more")
(load "pyctypes/capi_objects")
(load "pyctypes/capi_parts")
(load "pyctypes/capi_port")
(load "pyctypes/capi_types")
(load "pyctypes/capi_unicode")
(load "pyctypes/cfield")
(load "pyctypes/ctypes")
(load "pyctypes/ffi")
(load "pyctypes/module")
(load "pyctypes/world")
(load "pyctypes/ffi_test")

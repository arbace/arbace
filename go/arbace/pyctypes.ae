(ns go.arbace.pyctypes
  (:require [arbace.go :as go]))

(go/package pyctypes
  :path "arbace/pyctypes"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["callproc.go" "capi.go" "capi_limited.go" "capi_objects.go" "cfield.go" "ctypes.go" "ffi.go" "module.go" "world.go"]
  :test-files ["ffi_test.go"]
  :init-order [worldLibs ["capi.go" 611 5] keptStrings formattable bytesCopies stgs rawMemoryType pyCSimpleType pyCStructType unionType pyCArrayType pyCPointerType pyCFuncPtrType cDataType simpleType structType unionBaseType arrayType pointerType funcPtrType cFieldType cArgType arrayCache TVoid TUInt8 TSInt8 TUInt16 TSInt16 TUInt32 TSInt32 TUInt64 TSInt64 TFloat TDouble TLongDouble TPointer ErrBadTypedef ErrBadArgType getsetType handles handleOf keepType varProxies bhilfd ffiCases]
  :positions :full)

(load "pyctypes/callproc")
(load "pyctypes/capi")
(load "pyctypes/capi_limited")
(load "pyctypes/capi_objects")
(load "pyctypes/cfield")
(load "pyctypes/ctypes")
(load "pyctypes/ffi")
(load "pyctypes/module")
(load "pyctypes/world")
(load "pyctypes/ffi_test")

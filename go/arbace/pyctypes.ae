(ns go.arbace.pyctypes
  (:require [arbace.go :as go]))

(go/package pyctypes
  :path "arbace/pyctypes"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["callproc.go" "cfield.go" "ctypes.go" "ffi.go" "module.go" "world.go"]
  :test-files ["ffi_test.go"]
  :init-order [worldLibs formattable stgs pyCSimpleType pyCStructType unionType pyCArrayType pyCPointerType pyCFuncPtrType cDataType simpleType structType unionBaseType arrayType pointerType funcPtrType cFieldType cArgType arrayCache TVoid TUInt8 TSInt8 TUInt16 TSInt16 TUInt32 TSInt32 TUInt64 TSInt64 TFloat TDouble TLongDouble TPointer ErrBadTypedef ErrBadArgType getsetType handles handleOf keepType bhilfd ffiCases]
  :positions :full)

(load "pyctypes/callproc")
(load "pyctypes/cfield")
(load "pyctypes/ctypes")
(load "pyctypes/ffi")
(load "pyctypes/module")
(load "pyctypes/world")
(load "pyctypes/ffi_test")

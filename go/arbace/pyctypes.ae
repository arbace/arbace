(ns go.arbace.pyctypes
  (:require [arbace.go :as go]))

(go/package pyctypes
  :path "arbace/pyctypes"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["callproc.go" "capi.go" "capi_accel.go" "capi_clinic.go" "capi_config.go" "capi_dynamic.go" "capi_fatal.go" "capi_file.go" "capi_getargs.go" "capi_heaptype.go" "capi_json.go" "capi_limited.go" "capi_mirror.go" "capi_monitoring.go" "capi_more.go" "capi_objects.go" "capi_parts.go" "capi_pickle.go" "capi_port.go" "capi_q598.go" "capi_rest.go" "capi_stable.go" "capi_tail.go" "capi_types.go" "capi_unicode.go" "capi_watchers.go" "cfield.go" "ctypes.go" "ffi.go" "module.go" "world.go"]
  :test-files ["ffi_test.go"]
  :init-order [ctypesErrnos worldLibs loadedNames ["capi.go" 924 5] rtIdentifiers tzNames longWriters contextMissing ["capi_accel.go" 925 5] argParsers configSpecs configPublic configFlagOf dynExecuted singleCache ["capi_dynamic.go" 346 5] released debugBlocks debugDomainIDs stdPrinterType bufViews moduleDefs jsonIdentifiers keptStrings cBuiltinDocs slotOffsets heapSubs genericSlots held mirrors syncEpoch usedLists rawTypes moduleStates voidPinned pickleIdentifiers cMethodDefs synthDefs liveSubs cThreads cLocks cEntryDepth stableFuncNames stableDataNames stableTypes stableObjs moduleDefType interpDicts atExits codeExtras modulesByIndex binSlots cTypes builtinSizes cifCache nativeAddrs uwriters dictWatchers typeWatchers funcWatchers codeWatchers contextWatchers dictEventNames funcEventNames formattable bytesCopies stgs rawMemoryType pyCSimpleType pyCStructType unionType pyCArrayType pyCPointerType pyCFuncPtrType cDataType simpleType structType unionBaseType arrayType pointerType funcPtrType cFieldType cArgType arrayCache TVoid TUInt8 TSInt8 TUInt16 TSInt16 TUInt32 TSInt32 TUInt64 TSInt64 TFloat TDouble TLongDouble TPointer ErrBadTypedef ErrBadArgType X87 getsetType handles handleOf pyData keepType varProxies bhilfd ffiCases]
  :positions :full)


(ns go.arbace.oi
  (:require [arbace.go :as go]))

(go/package oi
  :path "arbace/oi"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["apply.go" "compare.go" "compile.go" "exn.go" "ext.go" "ext_array.go" "ext_bigarray.go" "ext_bigstring.go" "ext_capi.go" "ext_digest.go" "ext_domain.go" "ext_final.go" "ext_io.go" "ext_lex.go" "ext_marshal_chan.go" "ext_num.go" "ext_runtime_events.go" "ext_signal.go" "ext_str.go" "ext_str_re.go" "ext_sys.go" "ext_sys_linux.go" "ext_sys_other.go" "ext_thread.go" "ext_unix.go" "ext_unix_fd.go" "ext_unix_linux.go" "ext_unix_other.go" "ext_unix_sock.go" "hash.go" "marshal.go" "prim.go" "program.go" "run.go" "sexp.go" "thread.go" "toplevel.go" "value.go"]
  :test-files ["data_test.go" "ext_num_test.go" "ext_str_test.go" "ext_test.go" "lexdata_old_test.go" "lexdata_test.go" "parsedata_test.go"]
  :init-order [tailMark exitMark ["compile.go" 950] Predefs ExnOutOfMemory ExnSysError ExnFailure ExnInvalidArgument ExnEndOfFile ExnDivisionByZero ExnNotFound ExnMatchFailure ExnStackOverflow ExnSysBlockedIO ExnAssertFailure ExnUndefinedRecursiveModule Externals baEltSize blake2IV blake2Sigma stackWordsMode DepthLimit finObjs dummyBuff sigWaiters reWordLetters openFlags posixSignals gcControl gcTweaks ephNone sysThreads unixErrors sockDomains sockTypes sockBoolOpts sockIntOpts codeTable codeIndex BackendType named gilCond runningDomains runstackFn resumeFn raiseFn reperformFn topPrefix smallInts]
  :positions :lines)


(ns go.arbace.oi
  (:require [arbace.go :as go]))

(go/package oi
  :path "arbace/oi"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["apply.go" "compare.go" "compile.go" "exn.go" "ext.go" "ext_array.go" "ext_bigstring.go" "ext_digest.go" "ext_domain.go" "ext_io.go" "ext_lex.go" "ext_marshal_chan.go" "ext_num.go" "ext_str.go" "ext_sys.go" "ext_thread.go" "ext_unix.go" "ext_unix_fd.go" "hash.go" "marshal.go" "prim.go" "program.go" "run.go" "sexp.go" "thread.go" "toplevel.go" "value.go"]
  :test-files ["data_test.go" "ext_num_test.go" "ext_str_test.go" "ext_test.go" "lexdata_old_test.go" "lexdata_test.go" "parsedata_test.go"]
  :init-order [tailMark exitMark DepthLimit ["compile.go" 815 5] Predefs ExnOutOfMemory ExnSysError ExnFailure ExnInvalidArgument ExnEndOfFile ExnDivisionByZero ExnNotFound ExnMatchFailure ExnStackOverflow ExnSysBlockedIO ExnAssertFailure ExnUndefinedRecursiveModule Externals blake2IV blake2Sigma dummyBuff openFlags posixSignals gcControl gcTweaks ephNone BackendType named gilCond runstackFn resumeFn raiseFn reperformFn topPrefix smallInts floatFormats intFormats int32Formats int64Formats parse_int parse_int32 parse_int64 parse_nat parse_float lexTablesHexOld lexTraceOld lexTablesHex lexInputHex lexTrace parseTablesHex parseSizes parseResults]
  :positions :lines)

(load "oi/apply")
(load "oi/compare")
(load "oi/compile")
(load "oi/exn")
(load "oi/ext")
(load "oi/ext_array")
(load "oi/ext_bigstring")
(load "oi/ext_digest")
(load "oi/ext_domain")
(load "oi/ext_io")
(load "oi/ext_lex")
(load "oi/ext_marshal_chan")
(load "oi/ext_num")
(load "oi/ext_str")
(load "oi/ext_sys")
(load "oi/ext_thread")
(load "oi/ext_unix")
(load "oi/ext_unix_fd")
(load "oi/hash")
(load "oi/marshal")
(load "oi/prim")
(load "oi/program")
(load "oi/run")
(load "oi/sexp")
(load "oi/thread")
(load "oi/toplevel")
(load "oi/value")
(load "oi/data_test")
(load "oi/ext_num_test")
(load "oi/ext_str_test")
(load "oi/ext_test")
(load "oi/lexdata_old_test")
(load "oi/lexdata_test")
(load "oi/parsedata_test")

(ns go.arbace.wai
  (:require [arbace.go :as go]))

(go/package wai
  :path "arbace/wai"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["compile.go" "decode.go" "exec.go" "machine.go" "optab.go" "simd.go" "spectest.go" "store.go" "types.go"]
  :init-order [prefixed binaryNames errEOF kindNames opInfos simdFns shapes cgroups]
  :positions :lines)

(load "wai/compile")
(load "wai/decode")
(load "wai/exec")
(load "wai/machine")
(load "wai/optab")
(load "wai/simd")
(load "wai/spectest")
(load "wai/store")
(load "wai/types")

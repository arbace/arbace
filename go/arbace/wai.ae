(ns go.arbace.wai
  (:require [arbace.go :as go]))

(go/package wai
  :path "arbace/wai"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["compile.go" "decode.go" "exec.go" "machine.go" "optab.go" "simd.go" "spectest.go" "store.go" "types.go" "valid.go" "w2g.go" "w2gcases.go" "w2gexports.go" "wasi.go"]
  :init-order [prefixed binaryNames errEOF kindNames opInfos simdFns shapes cgroups constOps i32T i64T f32T f64T v128T laneOf laneN numCmp numUn numBin vecTern vecUnPf aotRegistry w2gCases X_ctypes X_simdFns]
  :positions :lines)

(load "wai/compile")
(load "wai/decode")
(load "wai/exec")
(load "wai/machine")
(load "wai/optab")
(load "wai/simd")
(load "wai/spectest")
(load "wai/store")
(load "wai/types")
(load "wai/valid")
(load "wai/w2g")
(load "wai/w2gcases")
(load "wai/w2gexports")
(load "wai/wasi")

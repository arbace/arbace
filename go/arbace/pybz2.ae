(ns go.arbace.pybz2
  (:require [arbace.go :as go]))

(go/package pybz2
  :path "arbace/pybz2"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["pybz2.go"]
  :init-order [bzsOffsets bz2CompressorType bz2DecompressorType BUFFER_BLOCK_SIZE]
  :positions :full)

(load "pybz2/pybz2")

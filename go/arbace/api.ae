;; The package arbace's API (GOI-SPEC.md §7.3): Arbace's values are Go values of type any (Java
;; objects, J2G-SPEC §5.1), held, stored and passed unchanged.
(in-ns 'go.arbace)

(go/file "api.go"
  :doc "Package arbace is Go forms' API to Arbace (doc/go/GOI-SPEC.md §7.3): calling Arbace fns and
vars, Java objects' methods, Arbace's strings, keywords, symbols, numbers, truth and sequences.
Arbace's values are Go values of type any.\n"
  :imports [])

(go/type Bridge
  "Bridge is what the package asks of Arbace; goi implements it (Hooks).\n"
  (interface
    (Call ^any [^any f ^{:tag (slice any)} args])
    (Invoke ^any [^any obj ^string name ^{:tag (slice any)} args])
    (Str ^any [^string s])
    (GoStr ^string [^any x])
    (Kw ^any [^string name])
    (Sym ^any [^string name])
    (Var ^any [^string name])
    (Deref ^any [^any x])
    (Fn ^any [^{:tag (func [& (slice any)] [any])} f])
    (Long ^int64 [^any x])
    (Float64 ^float64 [^any x])
    (Bool ^bool [^any x])
    (Seq ^{:tag (func [(func [any] [bool])])} [^any coll])))

(go/var ^{:tag Bridge :doc "Hooks is Arbace's side of the package, set by goi when Arbace starts.\n"} Hooks)

(go/func Call
  "Call invokes f (an IFn, a Var, or a Symbol or string naming a var) with args, each converted to
Arbace by its dynamic Go type (§5.6); the result is Arbace's value, unconverted.\n"
  ^any [^any f & ^{:tag (slice any)} args]
  (.Call Hooks f args))

(go/func Invoke
  "Invoke calls method name of the Java object obj by Arbace's reflection (Reflector), args
converted as Call's.\n"
  ^any [^any obj ^string name & ^{:tag (slice any)} args]
  (.Invoke Hooks obj name args))

(go/func Str "Str is a Go string as an Arbace String.\n" ^any [^string s] (.Str Hooks s))

(go/func GoStr "GoStr is an Arbace String, or any object's toString, as a Go string (\"\" for nil).\n"
  ^string [^any x]
  (.GoStr Hooks x))

(go/func Kw "Kw is the keyword ns/name or name.\n" ^any [^string name] (.Kw Hooks name))

(go/func Sym "Sym is the symbol ns/name or name.\n" ^any [^string name] (.Sym Hooks name))

(go/func Var "Var is the var ns/name, resolved (requiring ns when needed), or panics.\n"
  ^any [^string name]
  (.Var Hooks name))

(go/func Deref "Deref is @x: a Var's value, an atom's, a delay's ...\n" ^any [^any x] (.Deref Hooks x))

(go/func Fn "Fn is an Arbace fn calling f, its arguments converted to Go as for a parameter of type any.\n"
  ^any [^{:tag (func [& (slice any)] [any])} f]
  (.Fn Hooks f))

(go/func Long "Long is Arbace's number x (or a Go integer) as an int64; a ClassCastException otherwise.\n"
  ^int64 [^any x]
  (.Long Hooks x))

(go/func Float64 "Float64 is Arbace's number x (or a Go float) as a float64; a ClassCastException otherwise.\n"
  ^float64 [^any x]
  (.Float64 Hooks x))

(go/func Bool "Bool is Arbace's truth of x: false for nil and false, true otherwise.\n" ^bool [^any x]
  (.Bool Hooks x))

(go/func Seq "Seq iterates an Arbace collection (its seq), its elements Arbace's values.\n"
  ^{:tag (func [(func [any] [bool])])} [^any coll]
  (.Seq Hooks coll))

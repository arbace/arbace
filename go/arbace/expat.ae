(ns go.arbace.expat
  (:require [arbace.go :as go]))

(go/package expat
  :path "arbace/expat"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["expat.go" "siphash.go" "xcs.go" "xmlparse_api.go" "xmlparse_doc.go" "xmlparse_dtd.go" "xmlparse_types.go" "xmlrole.go" "xmltok.go" "xmltok_impl.go" "xmltok_impl_h.go" "xmltok_ns.go" "xmltok_tables.go"]
  :test-files ["xmltok_part_test.go"]
  :init-order [sip24_valid_vectors implicitContext XML_GetFeatureList_features addBinding_xmlNamespace addBinding_xmlLen addBinding_xmlnsNamespace addBinding_xmlnsLen doProlog_externalSubsetName doProlog_atypeCDATA doProlog_atypeID doProlog_atypeIDREF doProlog_atypeIDREFS doProlog_atypeENTITY doProlog_atypeENTITIES doProlog_atypeNMTOKEN doProlog_atypeNMTOKENS doProlog_notationPrefix doProlog_enumValueSep doProlog_enumValueStart KW_ANY KW_ATTLIST KW_CDATA KW_DOCTYPE KW_ELEMENT KW_EMPTY KW_ENTITIES KW_ENTITY KW_FIXED KW_ID KW_IDREF KW_IDREFS KW_IGNORE KW_IMPLIED KW_INCLUDE KW_NDATA KW_NMTOKEN KW_NMTOKENS KW_NOTATION KW_PCDATA KW_PUBLIC KW_REQUIRED KW_SYSTEM attlist2_types utf8_isName4 utf8_isNmstrt4 KW_version KW_encoding KW_standalone KW_yes KW_no KW_1_dot KW_ISO_8859_1 KW_US_ASCII KW_UTF_8 KW_UTF_16 KW_UTF_16BE KW_UTF_16LE getEncodingIndex_encodingNames scanCdataSection_CDATA_LSQB encodings encodingsNS asciitab_ns asciitab iasciitab_ns iasciitab latin1tab utf8tab utf8_type_ns utf8_type internal_utf8_type_ns internal_utf8_type latin1_type_ns latin1_type internal_latin1_type_ns internal_latin1_type ascii_type_ns ascii_type namingBitmap nmstrtPages namePages]
  :positions :full)

(load "expat/expat")
(load "expat/siphash")
(load "expat/xcs")
(load "expat/xmlparse_api")
(load "expat/xmlparse_doc")
(load "expat/xmlparse_dtd")
(load "expat/xmlparse_types")
(load "expat/xmlrole")
(load "expat/xmltok")
(load "expat/xmltok_impl")
(load "expat/xmltok_impl_h")
(load "expat/xmltok_ns")
(load "expat/xmltok_tables")
(load "expat/xmltok_part_test")

;; ci's natives, the package arbace/cinterp (doc/C23-SURVEY.md, "As built: C5 (write-ahead)"): the Go side of
;; arbace.lang.CInterp, whose natives j2g translates into calls of cinterp's CInterp_<name>_native (as
;; arbace.lang.GoInterp's are goi's, doc/go/GOI-SPEC.md §4.11, S32). It imports arbace/ci, arbace/crt and jrt;
;; ci and crt import std only, so the light path (tools/cirun) builds them without jrt. Write-ahead: built
;; and checked in the heavy window (j2g's rule for CInterp and the copy of the three packages into the program).
(ns go.arbace.cinterp
  (:require [arbace.go :as go]))

(go/package cinterp
  :path "arbace/cinterp"
  :files ["natives.go"])

(load "cinterp/natives")

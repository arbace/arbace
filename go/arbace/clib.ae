(ns go.arbace.clib
  (:require [arbace.go :as go]))

(go/package clib
  :path "arbace/clib"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["clib.go"]
  :test-files ["clib_test.go"]
  :init-order [compiled libs]
  :positions :full)

(load "clib/clib")
(load "clib/clib_test")

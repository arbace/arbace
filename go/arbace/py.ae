(ns go.arbace.py
  (:require [arbace.go :as go]))

(go/package py
  :path "arbace/py"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["abstract.go" "builtins.go" "code.go" "containers.go" "core.go" "eval.go" "exc.go" "frame.go" "func.go" "int.go" "interp.go" "load.go" "object.go" "ops.go" "registry.go" "str.go" "type.go"]
  :test-files ["py_test.go"]
  :init-order [identities binOpNames unOpNames compareSwapped compareNames intrinsicNames None NotImplemented Ellipsis True False unbound newGeneratorHook kindNames flagNames binOpSymbols unOpSymbols compareSymbols opNames opOwners seqIterType TupleType ListType DictType ObjectType TypeType NoneTypeType NotImplementedType EllipsisType BaseExceptionType ExceptionType TypeErrorType ValueErrorType NameErrorType UnboundLocalErrorType AttributeErrorType ArithmeticErrorType ZeroDivisionErrorType OverflowErrorType LookupErrorType KeyErrorType IndexErrorType RuntimeErrorType NotImplementedErrorType RecursionErrorType SystemErrorType AssertionErrorType StopIterationType SystemExitType FunctionType BuiltinType CellType CodeType ModuleType IntType BoolType loadConstHook registryNames hiddenTypes readied StrType]
  :positions :full)

(load "py/abstract")
(load "py/builtins")
(load "py/code")
(load "py/containers")
(load "py/core")
(load "py/eval")
(load "py/exc")
(load "py/frame")
(load "py/func")
(load "py/int")
(load "py/interp")
(load "py/load")
(load "py/object")
(load "py/ops")
(load "py/registry")
(load "py/str")
(load "py/type")
(load "py/py_test")

(ns go.arbace.py
  (:require [arbace.go :as go]))

(go/package py
  :path "arbace/py"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["abstract.go" "annotate.go" "attr.go" "builtins.go" "builtins_args.go" "builtins_exc.go" "builtins_exec.go" "builtins_iter.go" "builtins_string.go" "class.go" "code.go" "containers.go" "core.go" "coro.go" "descr.go" "eval.go" "exc.go" "excgroup.go" "format.go" "frame.go" "func.go" "gen.go" "import.go" "int.go" "interp.go" "load.go" "match.go" "object.go" "ops.go" "registry.go" "repl.go" "str.go" "sys.go" "type.go" "typing.go" "with.go"]
  :test-files ["py_test.go"]
  :init-order [identities binOpNames unOpNames compareSwapped compareNames funcAnnotations getsets classInfos subclasses binDunders unDunders cmpDunders intrinsicNames None NotImplemented Ellipsis True False egData formatters unbound newGeneratorHook genKindNames builtinModuleNames builtinModules kindNames flagNames binOpSymbols unOpSymbols compareSymbols matchSelfTypes matchSequenceTypes matchMappingTypes opNames opOwners seqIterType GetSetType EnumerateType ZipType MapType FilterType ReversedType callableIterType TupleType ListType DictType ObjectType TypeType NoneTypeType NotImplementedType EllipsisType CoroutineType coroWrapperType AsyncGeneratorType asyncGenASendType asyncGenAThrowType MethodType ClassMethodType StaticMethodType PropertyType MemberType SuperType SlotWrapperType MappingProxyType BaseExceptionType ExceptionType ImportErrorType ModuleNotFoundErrorType SyntaxErrorType EOFErrorType StopAsyncIterationType TypeErrorType ValueErrorType NameErrorType UnboundLocalErrorType AttributeErrorType ArithmeticErrorType ZeroDivisionErrorType OverflowErrorType LookupErrorType KeyErrorType IndexErrorType RuntimeErrorType NotImplementedErrorType RecursionErrorType SystemErrorType AssertionErrorType StopIterationType SystemExitType BaseExceptionGroupType ExceptionGroupType TemplateType InterpolationType FunctionType BuiltinType CellType CodeType ModuleType GeneratorType GeneratorExitType errIncomplete IntType BoolType loadConstHook registryNames hiddenTypes readied StrType configArgv sysVersion textFileType TypeVarType TypeVarTupleType ParamSpecType TypeAliasType GenericAliasType NoDefaultType UnpackAliasType GenericType NoDefault classGetItemBuiltins]
  :positions :full)

(load "py/abstract")
(load "py/annotate")
(load "py/attr")
(load "py/builtins")
(load "py/builtins_args")
(load "py/builtins_exc")
(load "py/builtins_exec")
(load "py/builtins_iter")
(load "py/builtins_string")
(load "py/class")
(load "py/code")
(load "py/containers")
(load "py/core")
(load "py/coro")
(load "py/descr")
(load "py/eval")
(load "py/exc")
(load "py/excgroup")
(load "py/format")
(load "py/frame")
(load "py/func")
(load "py/gen")
(load "py/import")
(load "py/int")
(load "py/interp")
(load "py/load")
(load "py/match")
(load "py/object")
(load "py/ops")
(load "py/registry")
(load "py/repl")
(load "py/str")
(load "py/sys")
(load "py/type")
(load "py/typing")
(load "py/with")
(load "py/py_test")

(ns go.arbace.py
  (:require [arbace.go :as go]))

(go/package py
  :path "arbace/py"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["abstract.go" "builtins.go" "bytes.go" "code.go" "complex.go" "containers.go" "core.go" "ddpow.go" "dict.go" "eval.go" "exc.go" "float.go" "frame.go" "func.go" "hash.go" "int.go" "interp.go" "list.go" "load.go" "numbers.go" "object.go" "ops.go" "percent.go" "range.go" "registry.go" "set.go" "slice.go" "str.go" "strmethods.go" "type.go"]
  :test-files ["hash_test.go" "py_test.go"]
  :init-order [identities binOpNames unOpNames compareSwapped compareNames intrinsicNames emptyTuple None NotImplemented Ellipsis True False ddLn2 unbound MaxStrDigits sourceCache kindNames flagNames binOpSymbols unOpSymbols compareSymbols opNames opOwners ["percent.go" 447 5] seqIterType BytesType bytesIterType ComplexType TupleType ListType tupleIterType listIterType ObjectType TypeType NoneTypeType NotImplementedType EllipsisType DictType dictKeysType dictValuesType dictItemsType dictKeyIterType dictValueIterType dictItemIterType BaseExceptionType ExceptionType ArithmeticErrorType FloatingPointErrorType OverflowErrorType ZeroDivisionErrorType AssertionErrorType AttributeErrorType BufferErrorType EOFErrorType ImportErrorType ModuleNotFoundErrorType LookupErrorType IndexErrorType KeyErrorType MemoryErrorType NameErrorType UnboundLocalErrorType OSErrorType BlockingIOErrorType ChildProcessErrorType ConnectionErrorType BrokenPipeErrorType ConnectionAbortedErrorType ConnectionRefusedErrorType ConnectionResetErrorType FileExistsErrorType FileNotFoundErrorType InterruptedErrorType IsADirectoryErrorType NotADirectoryErrorType PermissionErrorType ProcessLookupErrorType TimeoutErrorType ReferenceErrorType RuntimeErrorType NotImplementedErrorType PythonFinalizationErrorType RecursionErrorType StopIterationType SyntaxErrorType IndentationErrorType TabErrorType SystemErrorType TypeErrorType ValueErrorType UnicodeErrorType UnicodeDecodeErrorType UnicodeEncodeErrorType UnicodeTranslateErrorType WarningType BytesWarningType DeprecationWarningType EncodingWarningType FutureWarningType ImportWarningType PendingDeprecationWarningType ResourceWarningType RuntimeWarningType SyntaxWarningType UnicodeWarningType UserWarningType KeyboardInterruptType SystemExitType newBytesSubclass newComplexSubclass newTupleSubclass newListSubclass dictMissing newDictSubclass TracebackType FloatType newFloatSubclass FunctionType BuiltinType CellType CodeType ModuleType IntType BoolType newIntSubclass RangeType rangeIterType registryNames finished hiddenTypes readied SetType FrozenSetType setDummy setIterType newSetSubclass SliceType StrType strIterType newStrSubclass]
  :positions :full)


;; TLS low level connection and record layer

(in-ns 'go.arbace.pytls) ^{:go/comments [[1 1 "// Copyright 2010 The Go Authors. All rights reserved."] [2 1 "// Use of this source code is governed by a BSD-style"] [3 1 "// license that can be found in the LICENSE file."] [5 1 "// TLS low level connection and record layer"] [25 1 "// A Conn represents a secured connection."] [26 1 "// It implements the net.Conn interface."] [28 2 "// constant"] [31 42 "// (*Conn).clientHandshake or serverHandshake"] [32 42 "// nil for non-QUIC connections"] [34 2 "// isHandshakeComplete is true if the connection is currently transferring"] [35 2 "// application data (i.e. is not currently processing a handshake)."] [36 2 "// isHandshakeComplete is true implies handshakeErr == nil."] [38 2 "// constant after handshake; protected by handshakeMutex"] [40 25 "// error resulting from handshake"] [41 25 "// TLS version"] [42 25 "// version has been negotiated"] [43 25 "// configuration passed to constructor"] [44 2 "// handshakes counts the number of handshakes performed on the"] [45 2 "// connection so far. If renegotiation is disabled then this is either"] [46 2 "// zero or one."] [49 24 "// whether this connection was a session resumption"] [50 24 "// whether a HelloRetryRequest was sent/received"] [54 28 "// stapled OCSP response"] [55 28 "// signed certificate timestamps from server"] [58 2 "// verifiedChains contains the certificate chains that we built, as"] [59 2 "// opposed to the ones presented by the server."] [61 2 "// serverName contains the server name indicated by the client, if any."] [63 2 "// secureRenegotiation is true if the server echoed the secure"] [64 2 "// renegotiation extension. (This is meaningless as a server because"] [65 2 "// renegotiation is not supported in that case.)"] [67 2 "// ekm is a closure for exporting keying material."] [69 2 "// resumptionSecret is the resumption_master_secret for handling"] [70 2 "// or sending NewSessionTicket messages."] [74 2 "// ticketKeys is the set of active session ticket keys for this"] [75 2 "// connection. The first one is used to encrypt new tickets and"] [76 2 "// all are tried to decrypt tickets."] [79 2 "// clientFinishedIsFirst is true if the client sent the first Finished"] [80 2 "// message during the most recent handshake. This is recorded because"] [81 2 "// the first transmitted Finished message is the tls-unique"] [82 2 "// channel-binding value."] [85 2 "// closeNotifyErr is any error from sending the alertCloseNotify record."] [87 2 "// closeNotifySent is true if the Conn attempted to send an"] [88 2 "// alertCloseNotify record."] [91 2 "// clientFinished and serverFinished contain the Finished message sent"] [92 2 "// by the client or server in the most recent handshake. This is"] [93 2 "// retained to support the renegotiation extension and tls-unique"] [94 2 "// channel-binding."] [98 2 "// clientProtocol is the negotiated ALPN protocol."] [101 2 "// input/output"] [103 25 "// raw input, starting with a record header"] [104 25 "// application data waiting to be read, from rawInput.Next"] [105 25 "// handshake data waiting to be read"] [106 25 "// whether records are buffered in sendBuf"] [107 25 "// a buffer of records waiting to be sent"] [109 2 "// bytesSent counts the bytes of application data sent."] [110 2 "// packetsSent counts packets."] [114 2 "// retryCount counts the number of consecutive non-advancing records"] [115 2 "// received by Conn.readRecord. That is, records that neither advance the"] [116 2 "// handshake, nor deliver application data. Protected by in.Mutex."] [119 2 "// activeCall indicates whether Close has been call in the low bit."] [120 2 "// the rest of the bits are the number of goroutines in Conn.Write."] [123 2 "// pha is the post-handshake authentication state (arbace), set when the"] [124 2 "// client offered it in a TLS 1.3 handshake."] [130 1 "// Access to net.Conn methods."] [131 1 "// Cannot just embed net.Conn because that would"] [132 1 "// export the struct field too."] [134 1 "// LocalAddr returns the local network address."] [139 1 "// RemoteAddr returns the remote network address."] [144 1 "// SetDeadline sets the read and write deadlines associated with the connection."] [145 1 "// A zero value for t means [Conn.Read] and [Conn.Write] will not time out."] [146 1 "// After a Write has timed out, the TLS state is corrupt and all future writes will return the same error."] [151 1 "// SetReadDeadline sets the read deadline on the underlying connection."] [152 1 "// A zero value for t means [Conn.Read] will not time out."] [157 1 "// SetWriteDeadline sets the write deadline on the underlying connection."] [158 1 "// A zero value for t means [Conn.Write] will not time out."] [159 1 "// After a [Conn.Write] has timed out, the TLS state is corrupt and all future writes will return the same error."] [164 1 "// NetConn returns the underlying connection that is wrapped by c."] [165 1 "// Note that writing to or reading from this connection directly will corrupt the"] [166 1 "// TLS session."] [171 1 "// A halfConn represents one direction of the record layer"] [172 1 "// connection, either sending or receiving."] [176 17 "// first permanent error"] [177 17 "// protocol version"] [178 17 "// cipher algorithm"] [180 18 "// 64-bit sequence number"] [182 22 "// to avoid allocs; interface method args escape"] [184 23 "// next encryption state"] [185 23 "// next MAC algorithm"] [187 36 "// current QUIC encryption level"] [188 36 "// current TLS 1.3 traffic secret"] [209 1 "// prepareCipherSpec sets the encryption and MAC states"] [210 1 "// that a subsequent changeCipherSpec will use."] [217 1 "// changeCipherSpec changes the encryption and MAC states"] [218 1 "// to the ones previously passed to prepareCipherSpec."] [231 1 "// setTrafficSecret sets the traffic secret for the given encryption level. setTrafficSecret"] [232 1 "// should not be called directly, but rather through the Conn setWriteTrafficSecret and"] [233 1 "// setReadTrafficSecret wrapper methods."] [242 1 "// incSeq increments the sequence number."] [251 2 "// Not allowed to let sequence number wrap."] [252 2 "// Instead, must renegotiate before it does."] [253 2 "// Not likely enough to bother."] [257 1 "// explicitNonceLen returns the number of bytes of explicit nonce or IV included"] [258 1 "// in each record. Explicit nonces are present only in CBC modes after TLS 1.0"] [259 1 "// and in certain AEAD modes in TLS 1.2."] [271 3 "// TLS 1.1 introduced a per-record explicit IV to fix the BEAST attack."] [281 1 "// extractPadding returns, in constant time, the length of the padding to remove"] [282 1 "// from the end of payload. It also returns a byte which is equal to 255 if the"] [283 1 "// padding was valid and 0 otherwise. See RFC 2246, Section 6.2.3.2."] [291 2 "// if len(payload) >= (paddingLen - 1) then the MSB of t is zero"] [294 2 "// The maximum possible padding length plus the actual length field"] [296 2 "// The length of the padded data is public, so we can use an if here"] [303 3 "// if i <= paddingLen then the MSB of t is zero"] [309 2 "// We AND together the bits of good and replicate the result across"] [310 2 "// all the bits."] [316 2 "// Zero the padding length on error. This ensures any unchecked bytes"] [317 2 "// are included in the MAC. Otherwise, an attacker that could"] [318 2 "// distinguish MAC failures from padding failures could mount an attack"] [319 2 "// similar to POODLE in SSL 3.0: given a good ciphertext that uses a"] [320 2 "// full block's worth of padding, replace the final block with another"] [321 2 "// block. If the MAC check passed but the padding check failed, the"] [322 2 "// last byte of that block decrypted to the block size."] [323 2 "//"] [324 2 "// See also macAndPaddingGood logic below."] [335 1 "// cbcMode is an interface for block ciphers using cipher block chaining."] [341 1 "// decrypt authenticates and decrypts the record if protection is active at"] [342 1 "// this stage. The returned plaintext might overlap with the input."] [348 2 "// In TLS 1.3, change_cipher_spec messages are to be ignored without being"] [349 2 "// decrypted. See RFC 8446, Appendix D.4."] [401 4 "// In a limited attempt to protect against CBC padding oracles like"] [402 4 "// Lucky13, the data past paddingLen (which is secret) is passed to"] [403 4 "// the MAC function as extra data, to be fed into the HMAC after"] [404 4 "// computing the digest. This makes the MAC roughly constant time as"] [405 4 "// long as the digest computation is constant time and does not"] [406 4 "// affect the subsequent write, modulo cache effects."] [419 4 "// Remove padding and find the ContentType scanning from the end."] [442 59 "// if n < 0 { n = 0 }"] [448 3 "// This is equivalent to checking the MACs and paddingGood"] [449 3 "// separately, but in constant-time to prevent distinguishing"] [450 3 "// padding failures from MAC failures. Depending on what value"] [451 3 "// of paddingLen was returned on bad padding, distinguishing"] [452 3 "// bad MAC from bad padding can lead to an attack."] [453 3 "//"] [454 3 "// See also the logic at the end of extractPadding."] [467 1 "// sliceForAppend extends the input slice by n bytes. head is the full extended"] [468 1 "// slice, while tail is the appended part. If the original slice has sufficient"] [469 1 "// capacity no allocation is performed."] [481 1 "// encrypt encrypts payload, adding the appropriate nonce and/or MAC, and"] [482 1 "// appends it to record, which must already contain the record header."] [492 4 "// The AES-GCM construction in TLS has an explicit nonce so that the"] [493 4 "// nonce can be random. However, the nonce is only 8 bytes which is"] [494 4 "// too small for a secure, random nonce. Therefore we use the"] [495 4 "// sequence number as the nonce. The 3DES-CBC construction also has"] [496 4 "// an 8 bytes nonce but its nonces must be unpredictable (see RFC"] [497 4 "// 5246, Appendix F.3), forcing us to use randomness. That's not"] [498 4 "// 3DES' biggest problem anyway because the birthday bound on block"] [499 4 "// collision is reached first due to its similarly small block size"] [500 4 "// (see the Sweet32 attack)."] [525 4 "// Encrypt the actual ContentType and replace the plaintext one."] [559 2 "// Update length to include nonce, MAC and any block padding needed."] [568 1 "// RecordHeaderError is returned when a TLS record header is invalid."] [570 2 "// Msg contains a human readable string that describes the error."] [572 2 "// RecordHeader contains the five bytes of TLS record header that"] [573 2 "// triggered the error."] [575 2 "// Conn provides the underlying net.Conn in the case that a client"] [576 2 "// sent an initial handshake that didn't look like TLS."] [577 2 "// It is nil if there's already been a handshake or a TLS alert has"] [578 2 "// been written to the connection."] [599 1 "// readRecordOrCCS reads one or more TLS records from the connection and"] [600 1 "// updates the record layer state. Some invariants:"] [601 1 "//   - c.in must be locked"] [602 1 "//   - c.input must be empty"] [603 1 "//"] [604 1 "// During the handshake one and only one of the following will happen:"] [605 1 "//   - c.hand grows"] [606 1 "//   - c.in.changeCipherSpec is called"] [607 1 "//   - an error is returned"] [608 1 "//"] [609 1 "// After the handshake one and only one of the following will happen:"] [610 1 "//   - c.hand grows"] [611 1 "//   - c.input is set"] [612 1 "//   - an error is returned"] [619 2 "// This function modifies c.rawInput, which owns the c.input memory."] [629 2 "// Read header, payload."] [631 3 "// RFC 8446, Section 6.1 suggests that EOF without an alertCloseNotify"] [632 3 "// is an error, but popular web sites seem to do this, so we accept it"] [633 3 "// if and only if at the record boundary."] [645 2 "// No valid TLS record has a type of 0x80, however SSLv2 handshakes"] [646 2 "// start with a uint16 length where the MSB is set and the first record"] [647 2 "// is always < 256 bytes long. Therefore typ == 0x80 strongly suggests"] [648 2 "// an SSLv2 client."] [657 3 "// All TLS 1.3 records are expected to have 0x0303 (1.2) after"] [658 3 "// the initial hello (RFC 8446 Section 5.1)."] [668 3 "// First message, be extra suspicious: this might not be a TLS"] [669 3 "// client. Bail out before reading a full 'body', if possible."] [670 3 "// The current max version is 3.3 so if the version is >= 16.0,"] [671 3 "// it's probably not real."] [688 2 "// Process message."] [698 2 "// Application Data messages are always protected."] [704 3 "// This is a state-advancing message: reset the retry count."] [708 2 "// Handshake messages MUST NOT be interleaved with other record types in TLS 1.3."] [728 4 "// TLS 1.3 removed warning-level alerts except for alertUserCanceled"] [729 4 "// (RFC 8446, § 6.1). Since at least one major implementation"] [730 4 "// (https://bugs.openjdk.org/browse/JDK-8323517) misuses this alert,"] [731 4 "// many TLS stacks now ignore it outright when seen in a TLS 1.3"] [732 4 "// handshake (e.g. BoringSSL, NSS, Rustls)."] [734 5 "// Like TLS 1.2 alertLevelWarning alerts, we drop the record and retry."] [741 4 "// Drop the record on the floor and retry."] [753 3 "// Handshake messages are not allowed to fragment across the CCS."] [757 3 "// In TLS 1.3, change_cipher_spec records are ignored until the"] [758 3 "// Finished. See RFC 8446, Appendix D.4. Note that according to Section"] [759 3 "// 5, a server can send a ChangeCipherSpec before its ServerHello, when"] [760 3 "// c.vers is still unset. That's not useful though and suspicious if the"] [761 3 "// server then selects a lower protocol version, so don't allow that."] [776 3 "// Some OpenSSL servers send empty records in order to randomize the"] [777 3 "// CBC IV. Ignore a limited number of empty records."] [781 3 "// Note that data is owned by c.rawInput, following the Next call above,"] [782 3 "// to avoid copying the plaintext. This is safe because c.rawInput is"] [783 3 "// not read from or written to until c.input is drained."] [796 1 "// retryReadRecord recurs into readRecordOrCCS to drop a non-advancing record, like"] [797 1 "// a warning alert, empty application_data, or a change_cipher_spec in TLS 1.3."] [807 1 "// readFromUntil reads from r into c.rawInput until c.rawInput contains"] [808 1 "// at least n bytes or else returns an error."] [814 2 "// There might be extra input waiting on the wire. Make a best effort"] [815 2 "// attempt to fetch it so that it can be used in (*Conn).Read to"] [816 2 "// \"predict\" closeNotify alerts."] [817 2 "// TODO(dmo): we use bytes.MinRead here because we used the buffer"] [818 2 "// ReadFrom mechanism to avoid allocations, but we've hoisted this"] [819 2 "// loop for performance. We really should use our own heuristic here"] [820 2 "// for how much to read ahead."] [825 3 "// This write is just to update the internal state of the"] [826 3 "// rawInput bytes.Buffer. It cannot fail."] [844 1 "// sendAlertLocked sends a TLS alert message."] [860 3 "// closeNotify is a special case in that it isn't an error."] [867 1 "// sendAlert sends a TLS alert message."] [875 2 "// tcpMSSEstimate is a conservative estimate of the TCP maximum segment"] [876 2 "// size (MSS). A constant is used, rather than querying the kernel for"] [877 2 "// the actual MSS, to avoid complexity. The value here is the IPv6"] [878 2 "// minimum MTU (1280 bytes) minus the overhead of an IPv6 header (40"] [879 2 "// bytes) and a TCP header with timestamps (32 bytes)."] [882 2 "// recordSizeBoostThreshold is the number of bytes of application data"] [883 2 "// sent after which the TLS record size will be increased to the"] [884 2 "// maximum."] [888 1 "// maxPayloadSizeForWrite returns the maximum TLS payload size to use for the"] [889 1 "// next application data record. There is the following trade-off:"] [890 1 "//"] [891 1 "//   - For latency-sensitive applications, such as web browsing, each TLS"] [892 1 "//     record should fit in one TCP segment."] [893 1 "//   - For throughput-sensitive applications, such as large file transfers,"] [894 1 "//     larger TLS records better amortize framing and encryption overheads."] [895 1 "//"] [896 1 "// A simple heuristic that works well in practice is to use small records for"] [897 1 "// the first 1MB of data, then use larger records for subsequent data, and"] [898 1 "// reset back to smaller records after the connection becomes idle. See \"High"] [899 1 "// Performance Web Networking\", Chapter 4, or:"] [900 1 "// https://www.igvita.com/2013/10/24/optimizing-tls-record-size-and-buffering-latency/"] [901 1 "//"] [902 1 "// In the interests of simplicity and determinism, this code does not attempt"] [903 1 "// to reset the record size once the connection is idle, however."] [913 2 "// Subtract TLS overheads to get the maximum payload size."] [923 4 "// The payload must fit in a multiple of blockSize, with"] [924 4 "// room for at least one padding byte."] [926 4 "// The MAC is appended before padding so affects the"] [927 4 "// payload size directly."] [934 18 "// encrypted ContentType"] [937 2 "// Allow packet growth in arithmetic progression up to max."] [941 23 "// avoid overflow in multiply below"] [974 1 "// outBufPool pools the record-sized scratch buffers used by writeRecordLocked."] [981 1 "// writeRecordLocked writes a TLS record with the given type and payload to the"] [982 1 "// connection and updates the record layer state."] [1000 3 "// You might be tempted to simplify this by just passing &outBuf to Put,"] [1001 3 "// but that would make the local copy of the outBuf slice header escape"] [1002 3 "// to the heap, causing an allocation. Instead, we keep around the"] [1003 3 "// pointer to the slice header returned by Get, which is already on the"] [1004 3 "// heap, and overwrite and return that."] [1020 4 "// Some TLS servers fail if the record version is"] [1021 4 "// greater than TLS 1.0 for the initial ClientHello."] [1024 4 "// TLS 1.3 froze the record layer version to 1.2."] [1025 4 "// See RFC 8446, Section 5.1."] [1054 1 "// writeHandshakeRecord writes a handshake message to the connection and updates"] [1055 1 "// the record layer state. If transcript is non-nil the marshaled message is"] [1056 1 "// written to it."] [1072 1 "// writeChangeCipherRecord writes a ChangeCipherSpec message to the connection and"] [1073 1 "// updates the record layer state."] [1081 1 "// readHandshakeBytes reads handshake data until c.hand contains at least n bytes."] [1094 1 "// readHandshake reads the next handshake message from"] [1095 1 "// the record layer. If transcript is non-nil, the message"] [1096 1 "// is written to the passed transcriptHash."] [1104 2 "// hasVers indicates we're past the first message, forcing someone trying to"] [1105 2 "// make us just allocate a large buffer to at least do the initial part of"] [1106 2 "// the handshake first."] [1108 3 "// Since certificate messages are likely to be the only messages that"] [1109 3 "// can be larger than maxHandshake, we use a special limit for just"] [1110 3 "// those messages."] [1179 2 "// The handshake message unmarshalers"] [1180 2 "// expect to be able to keep references to data,"] [1181 2 "// so pass in a fresh copy that won't be overwritten."] [1199 1 "// Write writes data to the connection."] [1200 1 "//"] [1201 1 "// As Write calls [Conn.Handshake], in order to prevent indefinite blocking a deadline"] [1202 1 "// must be set for both [Conn.Read] and Write before Write is called when the handshake"] [1203 1 "// has not yet completed. See [Conn.SetDeadline], [Conn.SetReadDeadline], and"] [1204 1 "// [Conn.SetWriteDeadline]."] [1206 2 "// interlock with Close below"] [1237 2 "// TLS 1.0 is susceptible to a chosen-plaintext"] [1238 2 "// attack when using block mode ciphers due to predictable IVs."] [1239 2 "// This can be prevented by splitting each Application Data"] [1240 2 "// record into two records, effectively randomizing the IV."] [1241 2 "//"] [1242 2 "// https://www.openssl.org/~bodo/tls-cbc.txt"] [1243 2 "// https://bugzilla.mozilla.org/show_bug.cgi?id=665814"] [1244 2 "// https://www.imperialviolet.org/2012/01/15/beastfollowup.html"] [1261 1 "// handleRenegotiation processes a HelloRequest handshake message."] [1290 3 "// Ok."] [1306 1 "// handlePostHandshakeMessage processes a handshake message arrived after the"] [1307 1 "// handshake is complete. Up to TLS 1.2, it indicates the start of a renegotiation."] [1313 30 "// arbace: kept for post-handshake authentication"] [1329 36 "// arbace"] [1333 29 "// arbace"] [1338 2 "// The QUIC layer is supposed to treat an unexpected post-handshake CertificateRequest"] [1339 2 "// as a QUIC-level PROTOCOL_VIOLATION error (RFC 9001, Section 4.4). Returning an"] [1340 2 "// unexpected_message alert here doesn't provide it with enough information to distinguish"] [1341 2 "// this condition from other unexpected messages. This is probably fine."] [1368 4 "// Surface the error at the next write."] [1385 1 "// Read reads data from the connection."] [1386 1 "//"] [1387 1 "// As Read calls [Conn.Handshake], in order to prevent indefinite blocking a deadline"] [1388 1 "// must be set for both Read and [Conn.Write] before Read is called when the handshake"] [1389 1 "// has not yet completed. See [Conn.SetDeadline], [Conn.SetReadDeadline], and"] [1390 1 "// [Conn.SetWriteDeadline]."] [1396 3 "// Put this after Handshake, in case people were calling"] [1397 3 "// Read(nil) for the side effect of the Handshake."] [1417 2 "// If a close-notify alert is waiting, read it so that we can return (n,"] [1418 2 "// EOF) instead of (n, nil), to signal to the HTTP response reading"] [1419 2 "// goroutine that the connection is now closed. This eliminates a race"] [1420 2 "// where the HTTP response reading goroutine would otherwise not observe"] [1421 2 "// the EOF until its next read, by which time a client goroutine might"] [1422 2 "// have already tried to reuse the HTTP connection for a new request."] [1423 2 "// See https://golang.org/cl/76400046 and https://golang.org/issue/3514"] [1427 18 "// will be io.EOF on closeNotify"] [1434 1 "// Close closes the connection."] [1436 2 "// Interlock with Conn.Write above."] [1448 3 "// io.Writer and io.Closer should not be used concurrently."] [1449 3 "// If Close is called while a Write is currently in-flight,"] [1450 3 "// interpret that as a sign that this Close is really just"] [1451 3 "// being used to break the Write and/or clean up resources and"] [1452 3 "// avoid sending the alertCloseNotify, which may block"] [1453 3 "// waiting on handshakeMutex or the c.out mutex."] [1472 1 "// CloseWrite shuts down the writing side of the connection. It should only be"] [1473 1 "// called once the handshake has completed and does not call CloseWrite on the"] [1474 1 "// underlying connection. Most callers should just use [Conn.Close]."] [1488 3 "// Set a Write Deadline to prevent possibly blocking forever."] [1492 3 "// Any subsequent writes will fail."] [1498 1 "// Handshake runs the client or server handshake"] [1499 1 "// protocol if it has not yet been run."] [1500 1 "//"] [1501 1 "// Most uses of this package need not call Handshake explicitly: the"] [1502 1 "// first [Conn.Read] or [Conn.Write] will call it automatically."] [1503 1 "//"] [1504 1 "// For control over canceling or setting a timeout on a handshake, use"] [1505 1 "// [Conn.HandshakeContext] or the [Dialer]'s DialContext method instead."] [1506 1 "//"] [1507 1 "// In order to avoid denial of service attacks, the maximum RSA key size allowed"] [1508 1 "// in certificates sent by either the TLS server or client is limited to 8192"] [1509 1 "// bits. This limit can be overridden by setting tlsmaxrsasize in the GODEBUG"] [1510 1 "// environment variable (e.g. GODEBUG=tlsmaxrsasize=4096)."] [1515 1 "// HandshakeContext runs the client or server handshake"] [1516 1 "// protocol if it has not yet been run."] [1517 1 "//"] [1518 1 "// The provided Context must be non-nil. If the context is canceled before"] [1519 1 "// the handshake is complete, the handshake is interrupted and an error is returned."] [1520 1 "// Once the handshake has completed, cancellation of the context will not affect the"] [1521 1 "// connection."] [1522 1 "//"] [1523 1 "// Most uses of this package need not call HandshakeContext explicitly: the"] [1524 1 "// first [Conn.Read] or [Conn.Write] will call it automatically."] [1526 2 "// Delegate to unexported method for named return"] [1527 2 "// without confusing documented signature."] [1532 2 "// Fast sync/atomic-based exit if there is no handshake in flight and the"] [1533 2 "// last one succeeded without an error. Avoids the expensive context setup"] [1534 2 "// and mutex for most Read and Write calls."] [1540 2 "// Note: defer this before calling context.AfterFunc"] [1541 2 "// so that we can tell the difference between the input being canceled and"] [1542 2 "// this cancellation. In the former case, we need to close the connection."] [1549 3 "// Close the connection if ctx is canceled before the function returns."] [1555 5 "// Return context error to user."] [1578 3 "// If an error occurred during the handshake try to flush the"] [1579 3 "// alert that might be left in the buffer."] [1593 4 "// Provide the 1-RTT read secret now that the handshake is complete."] [1594 4 "// The QUIC layer MUST NOT decrypt 1-RTT packets prior to completing"] [1595 4 "// the handshake (RFC 9001, Section 5.7)."] [1606 4 "// Return an error which wraps both the handshake error and"] [1607 4 "// any alert error we may have sent, or alertInternalError"] [1608 4 "// if we didn't send an alert."] [1609 4 "// Truncate the text of the alert to 0 characters."] [1619 1 "// ConnectionState returns basic TLS details about the connection."] [1620 1 "//"] [1621 1 "// The returned [ConnectionState] is only meaningful after the handshake has"] [1622 1 "// completed, as reported by [ConnectionState.HandshakeComplete]; before then"] [1623 1 "// its fields are not populated. The handshake is run automatically by the"] [1624 1 "// first [Conn.Read] or [Conn.Write], or it can be triggered explicitly with"] [1625 1 "// [Conn.Handshake]."] [1667 1 "// OCSPResponse returns the stapled OCSP response from the TLS server, if"] [1668 1 "// any. (Only valid for client connections.)"] [1676 1 "// VerifyHostname checks that the peer certificate chain is valid for"] [1677 1 "// connecting to host. If so, it returns nil; if not, it returns an error"] [1678 1 "// describing the problem."] [1694 1 "// setReadTrafficSecret sets the read traffic secret for the given encryption level. If"] [1695 1 "// being called at the same time as setWriteTrafficSecret, the caller must ensure the call"] [1696 1 "// to setWriteTrafficSecret happens first so any alerts are sent at the write level."] [1698 2 "// Ensure that there are no buffered handshake messages before changing the"] [1699 2 "// read keys, since that can cause messages to be parsed that were encrypted"] [1700 2 "// using old keys which are no longer appropriate."] [1713 1 "// setWriteTrafficSecret sets the write traffic secret for the given encryption level. If"] [1714 1 "// being called at the same time as setReadTrafficSecret, the caller must ensure the call"] [1715 1 "// to setWriteTrafficSecret happens first so any alerts are sent at the write level."]] :go/pos {:name [7 9] :package [7 1]} :go/semis [[201 29] [244 12] [244 20] [301 12] [301 25] [420 31] [420 39] [471 25] [489 46] [491 37] [503 49] [548 24] [548 38] [630 52] [637 30] [681 54] [682 30] [768 36] [990 26] [1012 49] [1038 31] [1046 37] [1087 27] [1098 35] [1119 39] [1218 25] [1225 21] [1248 46] [1300 61] [1378 113] [1392 25] [1405 27] [1409 44] [1426 27] [1459 28] [1464 26] [1564 26] [1596 100]] :go/trails [[978 3] [1152 50] [1165 49]]} (go/file "conn.go" :imports [



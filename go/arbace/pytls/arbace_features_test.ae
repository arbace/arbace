(in-ns 'go.arbace.pytls) ^{:go/comments [[1 1 "// Copyright 2026 The Arbace Authors. Tests of the additions to the vendored"] [2 1 "// copy of crypto/tls (see VENDORED.md); BSD-style license as the Go sources."] [25 1 "// --- certificates and connections"] [31 28 "// a CA that signed nothing here"] [32 28 "// a client certificate of another CA"] [102 1 "// arbaceConnect makes a TCP loopback connection and runs both handshakes."] [138 3 "// Let the server see the client's alert, if any."] [153 1 "// arbaceExchange writes msg from a and reads it on b."] [183 1 "// --- 1. key log"] [227 2 "// The exporter secret is the one ExportKeyingMaterial uses: RFC 8446,"] [228 2 "// Section 7.5, recomputed from the logged secret."] [246 1 "// --- 2. post-handshake authentication"] [256 45 "// deferred: not applied in TLS 1.3"] [278 42 "// the client answers in Read"] [279 42 "// the server processes it in Read"] [331 2 "// Certificates would be filtered by the CertificateRequest's CA names."] [365 2 "// A CertificateRequest sent anyway is an unexpected message."] [387 2 "// TLS 1.2 requests the certificate in the handshake, as ClientAuth says."] [397 1 "// --- 3. external PSKs, TLS 1.3"] [461 65 "// decrypt_error"] [466 2 "// No certificate to fall back on: the handshake fails."] [472 2 "// With a certificate, a full handshake."] [484 1 "// --- 3. PSK suites, TLS 1.2"] [568 2 "// PSK suites are not offered unless listed in CipherSuites."] [576 2 "// Nor accepted by a server without the callback."] [592 1 "// --- 4. alerts from the verification callbacks"] [598 4 "// The client's VerifyPeerCertificate."] [608 4 "// The client's VerifyConnection, a plain error: bad_certificate."] [616 4 "// The server's VerifyConnection."] [623 23 "// TLS 1.3: the client learns it on its first read"] [628 4 "// The server's VerifyPeerCertificate on a client certificate."] [639 23 "// TLS 1.3: the client learns it on its first read"] [656 1 "// The deferred request: PostHandshakeClientAuth replaces ClientAuth in a TLS"] [657 1 "// 1.3 handshake whose client offered PHA, and only then."] [661 2 "// RequireAnyClientCert deferred: no certificate in the handshake, then a"] [662 2 "// missing one is a certificate_required alert."] [678 2 "// RequireAnyClientCert deferred, a certificate of an unknown CA: accepted"] [679 2 "// (no verification), though ClientAuth would verify it."] [698 2 "// The client did not offer PHA: ClientAuth applies in the handshake."] [709 2 "// PostHandshakeClientAuth NoClientCert: the handshake requests the"] [710 2 "// certificate (ClientAuth), and a post-handshake request still works,"] [711 2 "// under ClientAuth."]] :go/pos {:name [4 9] :package [4 1]} :go/semis [[130 35] [162 34] [165 18] [197 39] [268 53] [272 43] [275 43] [300 42] [305 53] [317 42] [337 42] [352 54] [359 42] [362 42] [370 53] [388 53] [391 42] [447 51] [668 42] [686 53] [689 42] [694 32] [705 32] [717 53] [720 42] [725 32]] :go/trails [[52 30] [78 42] [368 89] [415 4] [424 4] [491 30] [504 4] [516 4]]} (go/file "arbace_features_test.go" :imports [



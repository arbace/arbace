on 4.2.9"] [644 4 "// RFC 8446, Section 4.2.11"] [646 18 "// pre_shared_key must be the last extension"] [678 4 "// arbace: RFC 8446, Section 4.2.6"] [681 4 "// Ignore unknown extensions."] [727 58 "// arbace"] [753 2 "// HelloRetryRequest extensions"] [762 21 "// empty extension_data"] [766 21 "// empty extension_data"] [778 21 "// empty extension_data"] [887 19 "// message type and uint24 length field"] [896 3 "// ServerHello is optionally followed by extension data"] [965 4 "// This extension has different formats in SH and HRR, accept either"] [966 4 "// and let the handshake logic decide. See RFC 8446, Section 4.2.8."] [983 4 "// RFC 4492, Section 5.1.2"] [988 39 "// encrypted_client_hello"] [999 4 "// Ignore unknown extensions."] [1038 42 "// marshal zero-length parameters when present"] [1039 5 "// draft-ietf-quic-tls-32, Section 8.2"] [1046 5 "// RFC 8446, Section 4.2.10"] [1048 20 "// empty extension_data"] [1058 20 "// empty extension_data"] [1071 19 "// message type and uint24 length field"] [1108 4 "// RFC 8446, Section 4.2.10"] [1121 4 "// Ignore unknown extensions."] [1167 19 "// message type and uint24 length field"] [1221 19 "// message type and uint24 length field"] [1245 4 "// Ignore unknown extensions."] [1258 42 "// arbace: non-empty only after the handshake"] [1270 3 "// certificate_request_context (SHALL be zero length unless used for"] [1271 3 "// post-handshake authentication)"] [1272 58 "// arbace"] [1279 20 "// empty extension_data"] [1282 5 "// RFC 8446, Section 4.4.2.1 makes no mention of"] [1283 5 "// signed_certificate_timestamp in CertificateRequest, but"] [1284 5 "// \"Extensions in the Certificate message from the client MUST"] [1285 5 "// correspond to extensions in the CertificateRequest message"] [1286 5 "// from the server.\" and it appears in the table in Section 4.2."] [1288 20 "// empty extension_data"] [1333 19 "// message type and uint24 length field"] [1334 65 "// arbace"] [1340 37 "// arbace"] [1395 4 "// Ignore unknown extensions."] [1478 24 "// arbace: certificate_request_context"] [1488 58 "// certificate_request_context"] [1489 33 "// arbace"] [1513 6 "// This library only supports OCSP and SCT for leaf certificates."] [1546 19 "// message type and uint24 length field"] [1547 54 "// arbace"] [1553 26 "// arbace"] [1583 5 "// This library only supports OCSP and SCT for leaf certificates."] [1610 5 "// Ignore unknown extensions."] [1667 19 "// message type and uint24 length field"] [1738 2 "// hasSignatureAlgorithm indicates whether this message includes a list of"] [1739 2 "// supported signature algorithms. This change was introduced with TLS 1.2."] [1748 2 "// See RFC 4346, Section 7.4.4."] [1872 29 "// format change introduced in TLS 1.2"] [1895 18 "// message type and uint24 length field"] [1911 2 "// See RFC 5077, Section 3.3."] [1961 1 "// transcriptMsg is a helper used to hash messages which are not hashed when"] [1962 1 "// they are read from, or written to, the wire. This is typically the case for"] [1963 1 "// messages which are either not sent, or need to be hashed out of order from"] [1964 1 "// when they are read/written."] [1965 1 "//"] [1966 1 "// For most messages, the message is marshalled using their marshal method,"] [1967 1 "// since their wire representation is idempotent. For clientHelloMsg and"] [1968 1 "// serverHelloMsg, we store the original wire representation of the message and"] [1969 1 "// use that for hashing, since unmarshal/marshal are not idempotent due to"] [1970 1 "// extension ordering and other malleable fields, which may cause differences"] [1971 1 "// between what was received and what we marshal."]] :go/pos {:name [5 9] :package [5 1]} :go/semis [[1468 12] [1468 26] [1973 63] [1974 41]] :go/trails [[727 56]]} (go/file "handshake_messages.go" :imports [



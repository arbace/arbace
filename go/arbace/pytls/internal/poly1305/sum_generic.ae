(in-ns 'go.arbace.pytls.internal.poly1305) ^{:go/comments [[1 1 "// Copyright 2018 The Go Authors. All rights reserved."] [2 1 "// Use of this source code is governed by a BSD-style"] [3 1 "// license that can be found in the LICENSE file."] [5 1 "// This file provides the generic implementation of Sum and MAC. Other files"] [6 1 "// might provide optimized assembly implementations of some of this code."] [15 1 "// Poly1305 [RFC 7539] is a relatively simple algorithm: the authentication tag"] [16 1 "// for a 64 bytes message is approximately"] [17 1 "//"] [18 1 "//     s + m[0:16] * r⁴ + m[16:32] * r³ + m[32:48] * r² + m[48:64] * r  mod  2¹³⁰ - 5"] [19 1 "//"] [20 1 "// for some secret r and s. It can be computed sequentially like"] [21 1 "//"] [22 1 "//     for len(msg) > 0:"] [23 1 "//         h += read(msg, 16)"] [24 1 "//         h *= r"] [25 1 "//         h %= 2¹³⁰ - 5"] [26 1 "//     return h + s"] [27 1 "//"] [28 1 "// All the complexity is about doing performant constant-time math on numbers"] [29 1 "// larger than any available numeric type."] [43 1 "// macState holds numbers in saturated 64-bit little-endian limbs. That is,"] [44 1 "// the value of [x0, x1, x2] is x[0] + x[1] * 2⁶⁴ + x[2] * 2¹²⁸."] [46 2 "// h is the main accumulator. It is to be interpreted modulo 2¹³⁰ - 5, but"] [47 2 "// can grow larger during and after rounds. It must, however, remain below"] [48 2 "// 2 * (2¹³⁰ - 5)."] [50 2 "// r and s are the private key components."] [62 1 "// Write splits the incoming message into TagSize chunks, and passes them to"] [63 1 "// update. It buffers incomplete chunks."] [86 1 "// Sum flushes the last incomplete chunk from the buffer, if any, and generates"] [87 1 "// the MAC output. It does not modify its state, in order to allow for multiple"] [88 1 "// calls to Sum, even if no Write is allowed after Sum."] [97 1 "// [rMask0, rMask1] is the specified Poly1305 clamping mask in little-endian. It"] [98 1 "// clears some bits of the secret coefficient to make it possible to implement"] [99 1 "// multiplication more efficiently."] [105 1 "// initialize loads the 256-bit key into the two 128-bit secret values r and s."] [113 1 "// uint128 holds a 128-bit number as two 64-bit limbs, for use with the"] [114 1 "// bits.Mul64 and bits.Add64 intrinsics."] [139 1 "// updateGeneric absorbs msg into the state.h accumulator. For each chunk m of"] [140 1 "// 128 bits of message, it computes"] [141 1 "//"] [142 1 "//\th₊ = (h + m) * r  mod  2¹³⁰ - 5"] [143 1 "//"] [144 1 "// If the msg length is not a multiple of TagSize, it assumes the last"] [145 1 "// incomplete chunk is the final one."] [153 3 "// For the first step, h + m, we use a chain of bits.Add64 intrinsics."] [154 3 "// The resulting value of h might exceed 2¹³⁰ - 5, but will be partially"] [155 3 "// reduced at the end of the multiplication below."] [156 3 "//"] [157 3 "// The spec requires us to set a bit just above the message size, not to"] [158 3 "// hide leading zeroes. For full chunks, that's 1 << 128, so we can just"] [159 3 "// add 1 to the most significant (2¹²⁸) limb, h2."] [178 3 "// Multiplication of big number limbs is similar to elementary school"] [179 3 "// columnar multiplication. Instead of digits, there are 64-bit limbs."] [180 3 "//"] [181 3 "// We are multiplying a 3 limbs number, h, by a 2 limbs number, r."] [182 3 "//"] [183 3 "//                        h2    h1    h0  x"] [184 3 "//                              r1    r0  ="] [185 3 "//                       ----------------"] [186 3 "//                      h2r0  h1r0  h0r0     <-- individual 128-bit products"] [187 3 "//            +   h2r1  h1r1  h0r1"] [188 3 "//               ------------------------"] [189 3 "//                 m3    m2    m1    m0      <-- result in 128-bit overlapping limbs"] [190 3 "//               ------------------------"] [191 3 "//         m3.hi m2.hi m1.hi m0.hi           <-- carry propagation"] [192 3 "//     +         m3.lo m2.lo m1.lo m0.lo"] [193 3 "//        -------------------------------"] [194 3 "//           t4    t3    t2    t1    t0      <-- final result in 64-bit limbs"] [195 3 "//"] [196 3 "// The main difference from pen-and-paper multiplication is that we do"] [197 3 "// carry propagation in a separate step, as if we wrote two digit sums"] [198 3 "// at first (the 128-bit limbs), and then carried the tens all at once."] [207 3 "// Since h2 is known to be at most 7 (5 + 1 + 1), and r0 and r1 have their"] [208 3 "// top 4 bits cleared by rMask{0,1}, we know that their product is not going"] [209 3 "// to overflow 64 bits, so we can ignore the high part of the products."] [210 3 "//"] [211 3 "// This also means that the product doesn't have a fifth limb (t4)."] [220 28 "// These two additions don't overflow thanks again"] [221 28 "// to the 4 masked bits at the top of r0 and r1."] [229 3 "// Now we have the result as 4 64-bit limbs, and we need to reduce it"] [230 3 "// modulo 2¹³⁰ - 5. The special shape of this Crandall prime lets us do"] [231 3 "// a cheap partial reduction according to the reduction identity"] [232 3 "//"] [233 3 "//     c * 2¹³⁰ + n  =  c * 5 + n  mod  2¹³⁰ - 5"] [234 3 "//"] [235 3 "// because 2¹³⁰ = 5 mod 2¹³⁰ - 5. Partial reduction since the result is"] [236 3 "// likely to be larger than 2¹³⁰ - 5, but still small enough to fit the"] [237 3 "// assumptions we make about h in the rest of the code."] [238 3 "//"] [239 3 "// See also https://speakerdeck.com/gtank/engineering-prime-numbers?slide=23"] [241 3 "// We split the final result at the 2¹³⁰ mark into h and cc, the carry."] [242 3 "// Note that the carry bits are effectively shifted left by 2, in other"] [243 3 "// words, cc = c * 4 for the c in the reduction identity."] [247 3 "// To add c * 5 to h, we first add cc = c * 4, and then add (cc >> 2) = c."] [259 3 "// h2 is at most 3 + 1 + 1 = 5, making the whole of h at most"] [260 3 "//"] [261 3 "//     5 * 2¹²⁸ + (2¹²⁸ - 1) = 6 * 2¹²⁸ - 1"] [272 1 "// select64 returns x if v == 1 and y if v == 0, in constant time."] [275 1 "// [p0, p1, p2] is 2¹³⁰ - 5 in little endian order."] [282 1 "// finalize completes the modular reduction of h and computes"] [283 1 "//"] [284 1 "//\tout = h + s  mod  2¹²⁸"] [288 2 "// After the partial reduction in updateGeneric, h might be more than"] [289 2 "// 2¹³⁰ - 5, but will be less than 2 * (2¹³⁰ - 5). To complete the reduction"] [290 2 "// in constant time, we compute t = h - (2¹³⁰ - 5), and select h as the"] [291 2 "// result if the subtraction underflows, and t otherwise."] [297 2 "// h = h if h < p else h - p"] [301 2 "// Finally, we compute the last Poly1305 step"] [302 2 "//"] [303 2 "//     tag = h + s  mod  2¹²⁸"] [304 2 "//"] [305 2 "// by just doing a wide addition with the 128 low bits of h and discarding"] [306 2 "// the overflow."]] :go/pos {:name [8 9] :package [8 1]} :go/semis [[76 37]]} (go/file "sum_generic.go" :imports [



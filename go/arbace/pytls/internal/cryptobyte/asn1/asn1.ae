;; Package asn1 contains supporting types for parsing and building ASN.1
;; messages with the cryptobyte package.
(in-ns 'go.arbace.pytls.internal.cryptobyte.asn1) ^{:go/comments [[1 1 "// Copyright 2017 The Go Authors. All rights reserved."] [2 1 "// Use of this source code is governed by a BSD-style"] [3 1 "// license that can be found in the LICENSE file."] [5 1 "// Package asn1 contains supporting types for parsing and building ASN.1"] [6 1 "// messages with the cryptobyte package."] [9 1 "// Tag represents an ASN.1 identifier octet, consisting of a tag number"] [10 1 "// (indicating a type) and class (such as context-specific or constructed)."] [11 1 "//"] [12 1 "// Methods in the cryptobyte package only support the low-tag-number form, i.e."] [13 1 "// a single identifier octet with bits 7-8 encoding the class and bits 1-6"] [14 1 "// encoding the tag number."] [22 1 "// Constructed returns t with the constructed class bit set."] [25 1 "// ContextSpecific returns t with the context-specific class bit set."] [28 1 "// The following is a list of standard tag and class combinations."]] :go/pos {:name [7 9] :package [7 1]} :go/semis []} (go/file "asn1.go" :doc "Package asn1 contains supporting types for parsing and building ASN.1\nmessages with the cryptobyte package.\n" :imports [])







^{:go/pos {:doc [9 1] :tok-pos [15 1]}} (go/type ^{:go/pos {:name-pos [15 6]}} Tag "Tag represents an ASN.1 identifier octet, consisting of a tag number\n(indicating a type) and class (such as context-specific or constructed).\n\nMethods in the cryptobyte package only support the low-tag-number form, i.e.\na single identifier octet with bits 7-8 encoding the class and bits 1-6\nencoding the tag number.\n" ^{:go/pos {:name-pos [15 10]}} uint8)

^{:go/pos {:lparen [17 7] :rparen [20 1] :tok-pos [17 1]}} (go/const
  ^{:go/apos {1 [18 25]} :go/atext {1 "0x20"}} [^{:val 32 :go/pos {:name-pos [18 2]}} classConstructed 0x20]
  ^{:go/apos {1 [19 25]} :go/atext {1 "0x80"}} [^{:val 128 :go/pos {:name-pos [19 2]}} classContextSpecific 0x80])



^{:go/pos {:doc [22 1] :func [23 1] :lbrace [23 32] :rbrace [23 62] :return [23 34]}} (go/method ^{:go/pos {:name-pos [23 14]}} Constructed "Constructed returns t with the constructed class bit set.\n" ^{:tag ^{:go/pos {:name-pos [23 28]}} Tag :go/pos {:closing [23 26] :opening [23 25] :recv-closing [23 12] :recv-opening [23 6]}} [^{:tag ^{:go/pos {:name-pos [23 9]}} Tag :go/pos {:name-pos [23 7]}} t] ^{:go/pos {:op-pos [23 43]}} (bit-or ^{:go/pos {:name-pos [23 41]}} t ^{:go/pos {:name-pos [23 45]}} classConstructed))


^{:go/pos {:doc [25 1] :func [26 1] :lbrace [26 36] :rbrace [26 70] :return [26 38]}} (go/method ^{:go/pos {:name-pos [26 14]}} ContextSpecific "ContextSpecific returns t with the context-specific class bit set.\n" ^{:tag ^{:go/pos {:name-pos [26 32]}} Tag :go/pos {:closing [26 30] :opening [26 29] :recv-closing [26 12] :recv-opening [26 6]}} [^{:tag ^{:go/pos {:name-pos [26 9]}} Tag :go/pos {:name-pos [26 7]}} t] ^{:go/pos {:op-pos [26 47]}} (bit-or ^{:go/pos {:name-pos [26 45]}} t ^{:go/pos {:name-pos [26 49]}} classContextSpecific))


^{:go/pos {:doc [28 1] :lparen [29 7] :rparen [46 1] :tok-pos [29 1]}} (go/const "The following is a list of standard tag and class combinations.\n"
  [^{:val 1 :go/pos {:name-pos [30 2]}} BOOLEAN ^{:go/apos {2 [30 26]} :go/pos {:lparen [30 25] :rparen [30 27]}} (conv ^{:go/pos {:name-pos [30 22]}} Tag 1)]
  [^{:val 2 :go/pos {:name-pos [31 2]}} INTEGER ^{:go/apos {2 [31 26]} :go/pos {:lparen [31 25] :rparen [31 27]}} (conv ^{:go/pos {:name-pos [31 22]}} Tag 2)]
  [^{:val 3 :go/pos {:name-pos [32 2]}} BIT_STRING ^{:go/apos {2 [32 26]} :go/pos {:lparen [32 25] :rparen [32 27]}} (conv ^{:go/pos {:name-pos [32 22]}} Tag 3)]
  [^{:val 4 :go/pos {:name-pos [33 2]}} OCTET_STRING ^{:go/apos {2 [33 26]} :go/pos {:lparen [33 25] :rparen [33 27]}} (conv ^{:go/pos {:name-pos [33 22]}} Tag 4)]
  [^{:val 5 :go/pos {:name-pos [34 2]}} NULL ^{:go/apos {2 [34 26]} :go/pos {:lparen [34 25] :rparen [34 27]}} (conv ^{:go/pos {:name-pos [34 22]}} Tag 5)]
  [^{:val 6 :go/pos {:name-pos [35 2]}} OBJECT_IDENTIFIER ^{:go/apos {2 [35 26]} :go/pos {:lparen [35 25] :rparen [35 27]}} (conv ^{:go/pos {:name-pos [35 22]}} Tag 6)]
  [^{:val 10 :go/pos {:name-pos [36 2]}} ENUM ^{:go/apos {2 [36 26]} :go/pos {:lparen [36 25] :rparen [36 28]}} (conv ^{:go/pos {:name-pos [36 22]}} Tag 10)]
  [^{:val 12 :go/pos {:name-pos [37 2]}} UTF8String ^{:go/apos {2 [37 26]} :go/pos {:lparen [37 25] :rparen [37 28]}} (conv ^{:go/pos {:name-pos [37 22]}} Tag 12)]
  [^{:val 48 :go/pos {:name-pos [38 2]}} SEQUENCE ^{:go/pos {:lparen [38 25] :rparen [38 47]}} (conv ^{:go/pos {:name-pos [38 22]}} Tag ^{:go/apos {1 [38 26]} :go/pos {:op-pos [38 29]}} (bit-or 16 ^{:go/pos {:name-pos [38 31]}} classConstructed))]
  [^{:val 49 :go/pos {:name-pos [39 2]}} SET ^{:go/pos {:lparen [39 25] :rparen [39 47]}} (conv ^{:go/pos {:name-pos [39 22]}} Tag ^{:go/apos {1 [39 26]} :go/pos {:op-pos [39 29]}} (bit-or 17 ^{:go/pos {:name-pos [39 31]}} classConstructed))]
  [^{:val 19 :go/pos {:name-pos [40 2]}} PrintableString ^{:go/apos {2 [40 26]} :go/pos {:lparen [40 25] :rparen [40 28]}} (conv ^{:go/pos {:name-pos [40 22]}} Tag 19)]
  [^{:val 20 :go/pos {:name-pos [41 2]}} T61String ^{:go/apos {2 [41 26]} :go/pos {:lparen [41 25] :rparen [41 28]}} (conv ^{:go/pos {:name-pos [41 22]}} Tag 20)]
  [^{:val 22 :go/pos {:name-pos [42 2]}} IA5String ^{:go/apos {2 [42 26]} :go/pos {:lparen [42 25] :rparen [42 28]}} (conv ^{:go/pos {:name-pos [42 22]}} Tag 22)]
  [^{:val 23 :go/pos {:name-pos [43 2]}} UTCTime ^{:go/apos {2 [43 26]} :go/pos {:lparen [43 25] :rparen [43 28]}} (conv ^{:go/pos {:name-pos [43 22]}} Tag 23)]
  [^{:val 24 :go/pos {:name-pos [44 2]}} GeneralizedTime ^{:go/apos {2 [44 26]} :go/pos {:lparen [44 25] :rparen [44 28]}} (conv ^{:go/pos {:name-pos [44 22]}} Tag 24)]
  [^{:val 27 :go/pos {:name-pos [45 2]}} GeneralString ^{:go/apos {2 [45 26]} :go/pos {:lparen [45 25] :rparen [45 28]}} (conv ^{:go/pos {:name-pos [45 22]}} Tag 27)])

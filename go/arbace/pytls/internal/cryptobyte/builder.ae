    ^{:tag ^{:go/pos {:name-pos [30 17]}} bool :go/pos {:name-pos [30 2]}} pendingIsASN1
    ^{:tag ^{:go/pos {:star [31 17]}} (* ^{:go/pos {:name-pos [31 18]}} bool) :go/pos {:name-pos [31 2]}} inContinuation))






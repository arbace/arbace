(in-ns 'go.arbace.pytls.internal.cryptobyte) ^{:go/comments [[1 1 "// Copyright 2017 The Go Authors. All rights reserved."] [2 1 "// Use of this source code is governed by a BSD-style"] [3 1 "// license that can be found in the LICENSE file."] [12 1 "// A Builder builds byte strings from fixed-length and length-prefixed values."] [13 1 "// Builders either allocate space as needed, or are ‘fixed’, which means that"] [14 1 "// they write into a given buffer and produce an error if it's exhausted."] [15 1 "//"] [16 1 "// The zero value is a usable Builder that allocates space as needed."] [17 1 "//"] [18 1 "// Simple values are marshaled and appended to a Builder using methods on the"] [19 1 "// Builder. Length-prefixed values are marshaled by providing a"] [20 1 "// BuilderContinuation, which is a function that writes the inner contents of"] [21 1 "// the value to a given Builder. See the documentation for BuilderContinuation"] [22 1 "// for details."] [34 1 "// NewBuilder creates a Builder that appends its output to the given buffer."] [35 1 "// Like append(), the slice will be reallocated if its capacity is exceeded."] [36 1 "// Use Bytes to get the final buffer."] [43 1 "// NewFixedBuilder creates a Builder that appends its output into the given"] [44 1 "// buffer. This builder does not reallocate the output buffer. Writes that"] [45 1 "// would exceed the buffer's capacity are treated as an error."] [53 1 "// SetError sets the value to be returned as the error from Bytes. Writes"] [54 1 "// performed after calling SetError are ignored."] [59 1 "// Bytes returns the bytes written by the builder or an error if one has"] [60 1 "// occurred during building."] [68 1 "// BytesOrPanic returns the bytes written by the builder or panics if an error"] [69 1 "// has occurred during building."] [77 1 "// AddUint8 appends an 8-bit value to the byte string."] [82 1 "// AddUint16 appends a big-endian, 16-bit value to the byte string."] [87 1 "// AddUint24 appends a big-endian, 24-bit value to the byte string. The highest"] [88 1 "// byte of the 32-bit input value is silently truncated."] [93 1 "// AddUint32 appends a big-endian, 32-bit value to the byte string."] [98 1 "// AddUint48 appends a big-endian, 48-bit value to the byte string."] [103 1 "// AddUint64 appends a big-endian, 64-bit value to the byte string."] [108 1 "// AddBytes appends a sequence of bytes to the byte string."] [113 1 "// BuilderContinuation is a continuation-passing interface for building"] [114 1 "// length-prefixed byte sequences. Builder methods for length-prefixed"] [115 1 "// sequences (AddUint8LengthPrefixed etc) will invoke the BuilderContinuation"] [116 1 "// supplied to them. The child builder passed to the continuation can be used"] [117 1 "// to build the content of the length-prefixed sequence. For example:"] [118 1 "//"] [119 1 "//\tparent := cryptobyte.NewBuilder()"] [120 1 "//\tparent.AddUint8LengthPrefixed(func (child *Builder) {"] [121 1 "//\t  child.AddUint8(42)"] [122 1 "//\t  child.AddUint8LengthPrefixed(func (grandchild *Builder) {"] [123 1 "//\t    grandchild.AddUint8(5)"] [124 1 "//\t  })"] [125 1 "//\t})"] [126 1 "//"] [127 1 "// It is an error to write more bytes to the child than allowed by the reserved"] [128 1 "// length prefix. After the continuation returns, the child must be considered"] [129 1 "// invalid, i.e. users must not store any copies or references of the child"] [130 1 "// that outlive the continuation."] [131 1 "//"] [132 1 "// If the continuation panics with a value of type BuildError then the inner"] [133 1 "// error will be returned as the error from Bytes. If the child panics"] [134 1 "// otherwise then Bytes will repanic with the same value."] [137 1 "// BuildError wraps an error. If a BuilderContinuation panics with this value,"] [138 1 "// the panic will be recovered and the inner error will be returned from"] [139 1 "// Builder.Bytes."] [144 1 "// AddUint8LengthPrefixed adds a 8-bit length-prefixed byte sequence."] [149 1 "// AddUint16LengthPrefixed adds a big-endian, 16-bit length-prefixed byte sequence."] [154 1 "// AddUint24LengthPrefixed adds a big-endian, 24-bit length-prefixed byte sequence."] [159 1 "// AddUint32LengthPrefixed adds a big-endian, 32-bit length-prefixed byte sequence."] [188 2 "// Subsequent writes can be ignored if the builder has encountered an error."] [232 39 "// result unexpectedly shrunk"] [236 3 "// For ASN.1, we reserved a single byte for the length. If that turned out"] [237 3 "// to be incorrect, we have to move the contents along in order to make"] [238 3 "// space."] [264 3 "// Insert the initial length byte, make space for successive length bytes,"] [265 3 "// and adjust the offset."] [311 1 "// Unwrite rolls back non-negative n bytes written directly to the Builder."] [312 1 "// An attempt by a child builder passed to a continuation to unwrite bytes"] [313 1 "// from its parent will panic."] [334 1 "// A MarshalingValue marshals itself into a Builder."] [336 2 "// Marshal is called by Builder.AddValue. It receives a pointer to a builder"] [337 2 "// to marshal itself into. It may return an error that occurred during"] [338 2 "// marshaling, such as unset or invalid values."] [342 1 "// AddValue calls Marshal on v, passing a pointer to the builder to append to."] [343 1 "// If Marshal returns an error, it is set on the Builder so that subsequent"] [344 1 "// appends don't have an effect."]] :go/pos {:name [5 9] :package [5 1]} :go/semis [[176 39] [278 34] [278 42]] :go/trails [[39 17] [49 18] [206 35]]} (go/file "builder.go" :imports [



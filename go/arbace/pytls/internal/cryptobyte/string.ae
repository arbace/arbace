;; Package cryptobyte contains types that help with parsing and constructing
;; length-prefixed, binary messages, including ASN.1 DER. (The asn1 subpackage
;; contains useful ASN.1 constants.)
;;
;; The String type is for parsing. It wraps a []byte slice and provides helper
;; functions for consuming structures, value by value.
;;
;; The Builder type is for constructing messages. It providers helper functions
;; for appending values and also for appending length-prefixed submessages –
;; without having to worry about calculating the length prefix ahead of time.
;;
;; See the documentation and examples for the Builder and String types to get
;; started.
(in-ns 'go.arbace.pytls.internal.cryptobyte) ^{:go/comments [[1 1 "// Copyright 2017 The Go Authors. All rights reserved."] [2 1 "// Use of this source code is governed by a BSD-style"] [3 1 "// license that can be found in the LICENSE file."] [5 1 "// Package cryptobyte contains types that help with parsing and constructing"] [6 1 "// length-prefixed, binary messages, including ASN.1 DER. (The asn1 subpackage"] [7 1 "// contains useful ASN.1 constants.)"] [8 1 "//"] [9 1 "// The String type is for parsing. It wraps a []byte slice and provides helper"] [10 1 "// functions for consuming structures, value by value."] [11 1 "//"] [12 1 "// The Builder type is for constructing messages. It providers helper functions"] [13 1 "// for appending values and also for appending length-prefixed submessages –"] [14 1 "// without having to worry about calculating the length prefix ahead of time."] [15 1 "//"] [16 1 "// See the documentation and examples for the Builder and String types to get"] [17 1 "// started."] [20 1 "// String represents a string of bytes. It provides methods for parsing"] [21 1 "// fixed-length and length-prefixed values from it."] [24 1 "// read advances a String by n bytes and returns them. If less than n bytes"] [25 1 "// remain, it returns nil."] [35 1 "// Skip advances the String by n byte and reports whether it was successful."] [40 1 "// ReadUint8 decodes an 8-bit value into out and advances over it."] [41 1 "// It reports whether the read was successful."] [51 1 "// ReadUint16 decodes a big-endian, 16-bit value into out and advances over it."] [52 1 "// It reports whether the read was successful."] [62 1 "// ReadUint24 decodes a big-endian, 24-bit value into out and advances over it."] [63 1 "// It reports whether the read was successful."] [73 1 "// ReadUint32 decodes a big-endian, 32-bit value into out and advances over it."] [74 1 "// It reports whether the read was successful."] [84 1 "// ReadUint48 decodes a big-endian, 48-bit value into out and advances over it."] [85 1 "// It reports whether the read was successful."] [95 1 "// ReadUint64 decodes a big-endian, 64-bit value into out and advances over it."] [96 1 "// It reports whether the read was successful."] [138 1 "// ReadUint8LengthPrefixed reads the content of an 8-bit length-prefixed value"] [139 1 "// into out and advances over it. It reports whether the read was successful."] [144 1 "// ReadUint16LengthPrefixed reads the content of a big-endian, 16-bit"] [145 1 "// length-prefixed value into out and advances over it. It reports whether the"] [146 1 "// read was successful."] [151 1 "// ReadUint24LengthPrefixed reads the content of a big-endian, 24-bit"] [152 1 "// length-prefixed value into out and advances over it. It reports whether"] [153 1 "// the read was successful."] [158 1 "// ReadBytes reads n bytes into out and advances over them. It reports"] [159 1 "// whether the read was successful."] [169 1 "// CopyBytes copies len(out) bytes into out and advances over them. It reports"] [170 1 "// whether the copy operation was successful"] [180 1 "// Empty reports whether the string does not contain any bytes."]] :go/pos {:name [18 9] :package [18 1]} :go/semis [[112 12] [112 24]]} (go/file "string.go" :doc "Package cryptobyte contains types that help with parsing and constructing\nlength-prefixed, binary messages, including ASN.1 DER. (The asn1 subpackage\ncontains useful ASN.1 constants.)\n\nThe String type is for parsing. It wraps a []byte slice and provides helper\nfunctions for consuming structures, value by value.\n\nThe Builder type is for constructing messages. It providers helper functions\nfor appending values and also for appending length-prefixed submessages –\nwithout having to worry about calculating the length prefix ahead of time.\n\nSee the documentation and examples for the Builder and String types to get\nstarted.\n" :imports [])




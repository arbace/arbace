(in-ns 'go.arbace.pytls.internal.cryptobyte) ^{:go/comments [[1 1 "// Copyright 2017 The Go Authors. All rights reserved."] [2 1 "// Use of this source code is governed by a BSD-style"] [3 1 "// license that can be found in the LICENSE file."] [17 1 "// This file contains ASN.1-related methods for String and Builder."] [19 1 "// Builder"] [21 1 "// AddASN1Int64 appends a DER-encoded ASN.1 INTEGER."] [26 1 "// AddASN1Int64WithTag appends a DER-encoded ASN.1 INTEGER with the"] [27 1 "// given tag."] [32 1 "// AddASN1Enum appends a DER-encoded ASN.1 ENUMERATION."] [51 1 "// AddASN1Uint64 appends a DER-encoded ASN.1 INTEGER."] [66 1 "// AddASN1BigInt appends a DER-encoded ASN.1 INTEGER."] [74 4 "// A negative number has to be converted to two's-complement form. So we"] [75 4 "// invert and subtract 1. If the most-significant-bit isn't set then"] [76 4 "// we'll need to pad the beginning with 0xff in order to keep the number"] [77 4 "// negative."] [100 1 "// AddASN1OctetString appends a DER-encoded ASN.1 OCTET STRING."] [109 1 "// AddASN1GeneralizedTime appends a DER-encoded ASN.1 GENERALIZEDTIME."] [120 1 "// AddASN1UTCTime appends a DER-encoded ASN.1 UTCTime."] [123 3 "// As utilized by the X.509 profile, UTCTime can only"] [124 3 "// represent the years 1950 through 2049."] [133 1 "// AddASN1BitString appends a DER-encoded ASN.1 BIT STRING. This does not"] [134 1 "// support BIT STRINGs that are not a whole number of bytes."] [209 1 "// MarshalASN1 calls encoding_asn1.Marshal on its input and appends the result if"] [210 1 "// successful or records an error if one occurred."] [212 2 "// NOTE(martinkr): This is somewhat of a hack to allow propagation of"] [213 2 "// encoding_asn1.Marshal errors into Builder.err. N.B. if you call MarshalASN1 with a"] [214 2 "// value embedded into a struct, its tag information is lost."] [226 1 "// AddASN1 appends an ASN.1 object. The object is prefixed with the given tag."] [227 1 "// Tags greater than 30 are not supported and result in an error (i.e."] [228 1 "// low-tag-number form only). The child builder passed to the"] [229 1 "// BuilderContinuation can be used to build the content of the ASN.1 object."] [234 2 "// Identifiers with the low five bits set indicate high-tag-number format"] [235 2 "// (two or more octets), which we don't support."] [244 1 "// String"] [246 1 "// ReadASN1Boolean decodes an ASN.1 BOOLEAN and converts it to a boolean"] [247 1 "// representation into out and advances. It reports whether the read"] [248 1 "// was successful."] [267 1 "// ReadASN1Integer decodes an ASN.1 INTEGER into out and advances. If out does"] [268 1 "// not point to an integer, to a big.Int, or to a []byte it panics. Only"] [269 1 "// positive and zero values can be decoded into []byte, and they are returned as"] [270 1 "// big-endian binary values that share memory with s. Positive values will have"] [271 1 "// no leading zeroes, and zero will be returned as a single zero byte."] [272 1 "// ReadASN1Integer reports whether the read was successful."] [300 3 "// An INTEGER is encoded with at least one octet."] [307 3 "// Value is not minimally encoded."] [321 3 "// Negative number."] [367 2 "// Shift up and down in order to sign extend the result."] [384 3 "// Too large for uint64."] [388 3 "// Negative number."] [398 1 "// ReadASN1Int64WithTag decodes an ASN.1 INTEGER with the given tag into out"] [399 1 "// and advances. It reports whether the read was successful and resulted in a"] [400 1 "// value that can be represented in an int64."] [406 1 "// ReadASN1Enum decodes an ASN.1 ENUMERATION into out and advances. It reports"] [407 1 "// whether the read was successful."] [427 3 "// Avoid overflowing int on a 32-bit platform."] [428 3 "// We don't want different behavior based on the architecture."] [435 3 "// ITU-T X.690, section 8.19.2:"] [436 3 "// The subidentifier shall be encoded in the fewest possible octets,"] [437 3 "// that is, the leading octet of the subidentifier shall not have the value 0x80."] [448 15 "// truncated"] [451 1 "// ReadASN1ObjectIdentifier decodes an ASN.1 OBJECT IDENTIFIER into out and"] [452 1 "// advances. It reports whether the read was successful."] [459 2 "// In the worst case, we get two elements from the first byte (which is"] [460 2 "// encoded differently) and then every varint is a single byte long."] [463 2 "// The first varint is 40*value1 + value2:"] [464 2 "// According to this packing, value1 can take the values 0, 1 and 2 only."] [465 2 "// When value1 = 0 or value1 = 1, then value2 is <= 39. When value1 = 2,"] [466 2 "// then there are no restrictions on value2."] [490 1 "// ReadASN1GeneralizedTime decodes an ASN.1 GENERALIZEDTIME into out and"] [491 1 "// advances. It reports whether the read was successful."] [511 1 "// ReadASN1UTCTime decodes an ASN.1 UTCTime into out and advances."] [512 1 "// It reports whether the read was successful."] [524 3 "// Fallback to minute precision if we can't parse second"] [525 3 "// precision. If we are following X.509 or X.690 we shouldn't"] [526 3 "// support this, but we do."] [539 3 "// UTCTime interprets the low order digits 50-99 as 1950-99."] [540 3 "// This only applies to its use in the X.509 profile."] [541 3 "// See https://tools.ietf.org/html/rfc5280#section-4.1.2.5.1"] [548 1 "// ReadASN1BitString decodes an ASN.1 BIT STRING into out and advances."] [549 1 "// It reports whether the read was successful."] [570 1 "// ReadASN1BitStringAsBytes decodes an ASN.1 BIT STRING into out and advances. It is"] [571 1 "// an error if the BIT STRING is not a whole number of bytes. It reports"] [572 1 "// whether the read was successful."] [587 1 "// ReadASN1Bytes reads the contents of a DER-encoded ASN.1 element (not including"] [588 1 "// tag and length bytes) into out, and advances. The element must match the"] [589 1 "// given tag. It reports whether the read was successful."] [594 1 "// ReadASN1 reads the contents of a DER-encoded ASN.1 element (not including"] [595 1 "// tag and length bytes) into out, and advances. The element must match the"] [596 1 "// given tag. It reports whether the read was successful."] [597 1 "//"] [598 1 "// Tags greater than 30 are not supported (i.e. low-tag-number format only)."] [607 1 "// ReadASN1Element reads the contents of a DER-encoded ASN.1 element (including"] [608 1 "// tag and length bytes) into out, and advances. The element must match the"] [609 1 "// given tag. It reports whether the read was successful."] [610 1 "//"] [611 1 "// Tags greater than 30 are not supported (i.e. low-tag-number format only)."] [620 1 "// ReadAnyASN1 reads the contents of a DER-encoded ASN.1 element (not including"] [621 1 "// tag and length bytes) into out, sets outTag to its tag, and advances."] [622 1 "// It reports whether the read was successful."] [623 1 "//"] [624 1 "// Tags greater than 30 are not supported (i.e. low-tag-number format only)."] [626 38 "/* skip header */"] [629 1 "// ReadAnyASN1Element reads the contents of a DER-encoded ASN.1 element"] [630 1 "// (including tag and length bytes) into out, sets outTag to is tag, and"] [631 1 "// advances. It reports whether the read was successful."] [632 1 "//"] [633 1 "// Tags greater than 30 are not supported (i.e. low-tag-number format only)."] [635 39 "/* include header */"] [638 1 "// PeekASN1Tag reports whether the next ASN.1 value on the string starts with"] [639 1 "// the given tag."] [647 1 "// SkipASN1 reads and discards an ASN.1 element with the given tag. It"] [648 1 "// reports whether the operation was successful."] [654 1 "// ReadOptionalASN1 attempts to read the contents of a DER-encoded ASN.1"] [655 1 "// element (not including tag and length bytes) tagged with the given tag into"] [656 1 "// out. It stores whether an element with the tag was found in outPresent,"] [657 1 "// unless outPresent is nil. It reports whether the read was successful."] [669 1 "// SkipOptionalASN1 advances s over an ASN.1 element with the given tag, or"] [670 1 "// else leaves s unchanged. It reports whether the operation was successful."] [679 1 "// ReadOptionalASN1Integer attempts to read an optional ASN.1 INTEGER explicitly"] [680 1 "// tagged with tag into out and advances. If no element with a matching tag is"] [681 1 "// present, it writes defaultValue into out instead. Otherwise, it behaves like"] [682 1 "// ReadASN1Integer."] [711 1 "// ReadOptionalASN1OctetString attempts to read an optional ASN.1 OCTET STRING"] [712 1 "// explicitly tagged with tag into out and advances. If no element with a"] [713 1 "// matching tag is present, it sets \"out\" to nil instead. It reports"] [714 1 "// whether the read was successful."] [736 1 "// ReadOptionalASN1Boolean attempts to read an optional ASN.1 BOOLEAN"] [737 1 "// explicitly tagged with tag into out and advances. If no element with a"] [738 1 "// matching tag is present, it sets \"out\" to defaultValue instead. It reports"] [739 1 "// whether the read was successful."] [762 3 "// ITU-T X.690 section 8.1.2"] [763 3 "//"] [764 3 "// An identifier octet with a tag part of 0x1f indicates a high-tag-number"] [765 3 "// form identifier with two or more octets. We only support tags less than"] [766 3 "// 31 (i.e. low-tag-number form, single octet identifier)."] [774 2 "// ITU-T X.690 section 8.1.3"] [775 2 "//"] [776 2 "// Bit 8 of the first length byte indicates whether the length is short- or"] [777 2 "// long-form."] [778 31 "// length includes headerLen"] [780 3 "// Short-form length (section 8.1.3.4), encoded in bits 1-7."] [784 3 "// Long-form length (section 8.1.3.5). Bits 1-7 encode the number of octets"] [785 3 "// used to encode the length."] [798 3 "// ITU-T X.690 section 10.1 (DER length forms) requires encoding the length"] [799 3 "// with the minimum number of octets."] [801 4 "// Length should have used short-form encoding."] [805 4 "// Leading octet is 0. Length should have been at least one byte shorter."] [811 4 "// Overflow."]] :go/pos {:name [5 9] :package [
;; Package chacha20 implements the ChaCha20 and XChaCha20 encryption algorithms
;; as specified in RFC 8439 and draft-irtf-cfrg-xchacha-01.
(in-ns 'go.arbace.pytls.internal.chacha20) ^{:go/comments [[1 1 "// Copyright 2016 The Go Authors. All rights reserved."] [2 1 "// Use of this source code is governed by a BSD-style"] [3 1 "// license that can be found in the LICENSE file."] [5 1 "// Package chacha20 implements the ChaCha20 and XChaCha20 encryption algorithms"] [6 1 "// as specified in RFC 8439 and draft-irtf-cfrg-xchacha-01."] [19 2 "// KeySize is the size of the key used by this cipher, in bytes."] [22 2 "// NonceSize is the size of the nonce used with the standard variant of this"] [23 2 "// cipher, in bytes."] [24 2 "//"] [25 2 "// Note that this is too short to be safely generated at random if the same"] [26 2 "// key is reused more than 2³² times."] [29 2 "// NonceSizeX is the size of the nonce used with the XChaCha20 variant of"] [30 2 "// this cipher, in bytes."] [34 1 "// Cipher is a stateful instance of ChaCha20 or XChaCha20 using a particular key"] [35 1 "// and nonce. A *Cipher implements the cipher.Stream interface."] [37 2 "// The ChaCha20 state is 16 words: 4 constant, 8 of key, 1 of counter"] [38 2 "// (incremented after each block), and 3 of nonce."] [43 2 "// The last len bytes of buf are leftover key stream bytes from the previous"] [44 2 "// XORKeyStream invocation. The size of buf depends on how many blocks are"] [45 2 "// computed at a time by xorKeyStreamBlocks."] [49 2 "// overflow is set when the counter overflowed, no more blocks can be"] [50 2 "// generated, and the next XORKeyStream call should panic."] [53 2 "// The counter-independent results of the first round are cached after they"] [54 2 "// are computed the first time."] [63 1 "// NewUnauthenticatedCipher creates a new ChaCha20 stream cipher with the given"] [64 1 "// 32 bytes key and a 12 or 24 bytes nonce. If a nonce of 24 bytes is provided,"] [65 1 "// the XChaCha20 construction will be used. It returns an error if key or nonce"] [66 1 "// have any other length."] [67 1 "//"] [68 1 "// Note that ChaCha20, like all stream ciphers, is not authenticated and allows"] [69 1 "// attackers to silently tamper with the plaintext. For this reason, it is more"] [70 1 "// appropriate as a building block than as a standalone encryption mechanism."] [71 1 "// Instead, consider using package golang.org/x/crypto/chacha20poly1305."] [73 2 "// This function is split into a wrapper so that the Cipher allocation will"] [74 2 "// be inlined, and depending on how the caller uses the return value, won't"] [75 2 "// escape to the heap."] [85 3 "// XChaCha20 uses the ChaCha20 core to mix 16 bytes of the nonce into a"] [86 3 "// derived key, allowing it to operate on a nonce of 24 bytes. See"] [87 3 "// draft-irtf-cfrg-xchacha-01, Section 2.3."] [96 48 "// bounds check elimination hint"] [115 1 "// The constant first 4 words of the ChaCha20 state."] [117 25 "// expa"] [118 25 "// nd 3"] [119 25 "// 2-by"] [120 25 "// te k"] [125 1 "// quarterRound is the core of ChaCha20. It shuffles the bits of 4 state words."] [126 1 "// It's executed 4 times for each of the 20 ChaCha20 rounds, operating on all 16"] [127 1 "// words each round, in columnar or diagonal groups of 4 at a time."] [144 1 "// SetCounter sets the Cipher counter. The next invocation of XORKeyStream will"] [145 1 "// behave as if (64 * counter) bytes had been encrypted so far."] [146 1 "//"] [147 1 "// To prevent accidental counter reuse, SetCounter panics if counter is less"] [148 1 "// than the current value."] [149 1 "//"] [150 1 "// Note that the execution time of XORKeyStream is not independent of the"] [151 1 "// counter value."] [153 2 "// Internally, s may buffer multiple blocks, which complicates this"] [154 2 "// implementation slightly. When checking whether the counter has rolled"] [155 2 "// back, we must use both s.counter and s.len to determine how many blocks"] [156 2 "// we have already output."] [162 2 "// In the general case, we set the new counter value and reset s.len to 0,"] [163 2 "// causing the next call to XORKeyStream to refill the buffer. However, if"] [164 2 "// we're advancing within the existing buffer, we can save work by simply"] [165 2 "// setting s.len."] [174 1 "// XORKeyStream XORs each byte in the given slice with a byte from the"] [175 1 "// cipher's key stream. Dst and src must overlap entirely or not at all."] [176 1 "//"] [177 1 "// If len(dst) < len(src), XORKeyStream will panic. It is acceptable"] [178 1 "// to pass a dst bigger than src, and in that case, XORKeyStream will"] [179 1 "// only update dst[:len(src)] and will not touch the rest of dst."] [180 1 "//"] [181 1 "// Multiple calls to XORKeyStream behave as if the concatenation of"] [182 1 "// the src buffers was passed in a single run. That is, Cipher"] [183 1 "// maintains state and does not reset at each XORKeyStream call."] [196 2 "// First, drain any remaining key stream from a previous XORKeyStream."] [202 29 "// bounds check elimination hint"] [213 2 "// If we'd need to let the counter overflow and keep generating output,"] [214 2 "// panic immediately. If instead we'd only reach the last block, remember"] [215 2 "// not to generate any more output after the buffer is drained."] [223 2 "// xorKeyStreamBlocks implementations expect input lengths that are a"] [224 2 "// multiple of bufSize. Platform-specific ones process multiple blocks at a"] [225 2 "// time, so have bufSizes that are a multiple of blockSize."] [233 2 "// If using a multi-block xorKeyStreamBlocks would overflow, use the generic"] [234 2 "// one that does one block at a time."] [246 2 "// If we have a partial (multi-)block, pad it for xorKeyStreamBlocks, and"] [247 2 "// keep the leftover keystream for the next XORKeyStream invocation."] [261 2 "// To generate each block of key stream, the initial cipher state"] [262 2 "// (represented below) is passed through 20 rounds of shuffling,"] [263 2 "// alternatively applying quarterRounds by columns (like 1, 5, 9, 13)"] [264 2 "// or by diagonals (like 1, 6, 11, 12)."] [265 2 "//"] [266 2 "//      0:cccccccc   1:cccccccc   2:cccccccc   3:cccccccc"] [267 2 "//      4:kkkkkkkk   5:kkkkkkkk   6:kkkkkkkk   7:kkkkkkkk"] [268 2 "//      8:kkkkkkkk   9:kkkkkkkk  10:kkkkkkkk  11:kkkkkkkk"] [269 2 "//     12:bbbbbbbb  13:nnnnnnnn  14:nnnnnnnn  15:nnnnnnnn"] [270 2 "//"] [271 2 "//            c=constant k=key b=blockcount n=nonce"] [279 2 "// Three quarters of the first round don't depend on the counter, so we can"] [280 2 "// calculate them here, and reuse them for multiple blocks in the loop, and"] [281 2 "// for future XORKeyStream invocations."] [289 2 "// A condition of len(src) > 0 would be sufficient, but this also"] [290 2 "// acts as a bounds check elimination hint."] [292 3 "// The remainder of the first column round."] [295 3 "// The second diagonal round."] [301 3 "// The remaining 18 rounds."] [303 4 "// Column round."] [309 4 "// Diagonal round."] [316 3 "// Add back the initial state to generate the key stream, then"] [317 3 "// XOR the key stream with the source and write out the result."] [341 1 "// HChaCha20 uses the ChaCha20 core to generate a derived key from a 32 bytes"] [342 1 "// key and a 16 bytes nonce. It returns an error if key or nonce have any other"] [343 1 "// length. It is used as part of the XChaCha20 construction."] [345 2 "// This function is split into a wrapper so that the slice allocation will"] [346 2 "// be inlined, and depending on how the caller uses the return value, won't"] [347 2 "// escape to the heap."] [375 3 "// Diagonal round."] [381 3 "// Column round."] [388 14 "// bounds check elimination hint"]] :go/pos {:name [7 9] :package [7 1]} :go/semis [[302 13] [302 20] [374 12] [374 20]] :go/trails [[105 41] [110 42]]} (go/file "chacha_generic.go" :doc "Package chacha20 implements the ChaCha20 and XChaCha20 encryption algorithms\nas specified in RFC 8439 and draft-irtf-cfrg-xchacha-01.\n" :imports [



;; Package fips140tls controls whether crypto/tls requires FIPS-approved settings.
(in-ns 'go.arbace.pytls.internal.fips140tls) ^{:go/comments [[1 1 "// Copyright 2024 The Go Authors. All rights reserved."] [2 1 "// Use of this source code is governed by a BSD-style"] [3 1 "// license that can be found in the LICENSE file."] [5 1 "// Package fips140tls controls whether crypto/tls requires FIPS-approved settings."] [14 1 "// arbace: no init forcing FIPS mode from crypto/fips140.Enabled(): this copy's"] [15 1 "// AES-GCM and key schedules are not the FIPS module's, so Required stays false."] [17 1 "// Force forces crypto/tls to restrict TLS configurations to FIPS-approved settings."] [18 1 "// By design, this call is impossible to undo (except in tests)."] [23 1 "// Required reports whether FIPS-approved settings are required."] [24 1 "//"] [25 1 "// Required is true if FIPS 140-3 mode is enabled with GODEBUG=fips140=on, or if"] [26 1 "// the crypto/tls/fipsonly package is imported by a Go+BoringCrypto build."]] :go/pos {:name [6 9] :package [6 1]} :go/semis []} (go/file "fipstls.go" :doc "Package fips140tls controls whether crypto/tls requires FIPS-approved settings.\n" :imports [


    ^{:go/apos {1 [9 2]} :go/pos {:lparen [8 8] :rparen [10 1] :tok-pos [8 1]}} [atomic "sync/atomic"]])


^{:go/pos {:tok-pos [12 1]}} (go/var ^{:tag ^{:go/pos {:dot [12 20] :name-pos [12 21] :x-pos [12 14]}} atomic/Bool :go/pos {:name-pos [12 5]}} required)

;; arbace: no init forcing FIPS mode from crypto/fips140.Enabled(): this copy's
;; AES-GCM and key schedules are not the FIPS module's, so Required stays false.



^{:go/pos {:doc [17 1] :func [19 1] :lbrace [19 14] :rbrace [21 1]}} (go/func ^{:go/pos {:name-pos [19 6]}} Force "Force forces crypto/tls to restrict TLS configurations to FIPS-approved settings.\nBy design, this call is impossible to undo (except in tests).\n" ^{:go/pos {:closing [19 12] :opening [19 11]}} []
  ^{:go/apos {2 [20 17]} :go/pos {:dot [20 10] :lparen [20 16] :name-pos [20 11] :rparen [20 21]}} (.Store ^{:go/pos {:name-pos [20 2]}} required true))






^{:go/pos {:doc [23 1] :func [27 1] :lbrace [27 22] :rbrace [29 1] :return [28 2]}} (go/func ^{:go/pos {:name-pos [27 6]}} Required "Required reports whether FIPS-approved settings are required.\n\nRequired is true if FIPS 140-3 mode is enabled with GODEBUG=fips140=on, or if\nthe crypto/tls/fipsonly package is imported by a Go+BoringCrypto build.\n" ^{:tag ^{:go/pos {:name-pos [27 17]}} bool :go/pos {:closing [27 15] :opening [27 14]}} []
  ^{:go/pos {:dot [28 17] :lparen [28 22] :name-pos [28 18] :rparen [28 23]}} (.Load ^{:go/pos {:name-pos [28 9]}} required))



(in-ns 'go.arbace.pytls) ^{:go/comments [[1 1 "// Copyright 2018 The Go Authors. All rights reserved."] [2 1 "// Use of this source code is governed by a BSD-style"] [3 1 "// license that can be found in the LICENSE file."] [28 1 "// maxClientPSKIdentities is the number of client PSK identities the server will"] [29 1 "// attempt to validate. It will ignore the rest not to let cheap ClientHello"] [30 1 "// messages cause too much work in session ticket decryption attempts."] [38 2 "// inner indicates that the initial client_hello we received contained an"] [39 2 "// encrypted_client_hello extension that indicated it was an \"inner\" hello."] [40 2 "// We don't do any additional processing of the hello in this case, so all"] [41 2 "// fields above are unset."] [60 25 "// client_application_traffic_secret_0"] [69 2 "// For an overview of the TLS 1.3 handshake, see RFC 8446, Section 2."] [89 2 "// Note that at this point we could start sending application data without"] [90 2 "// waiting for the client's second flight, but the application might not"] [91 2 "// expect the lack of replay protection of the ClientHello parameters."] [101 57 "// arbace"] [117 2 "// TLS 1.3 froze the ServerHello.legacy_version field, and uses"] [118 2 "// supported_versions instead. See RFC 8446, sections 4.1.3 and 4.2.1."] [127 2 "// Abort if the client is doing a fallback and landing lower than what we"] [128 2 "// support. See RFC 7507, which however does not specify the interaction"] [129 2 "// with supported_versions. The only difference is that with"] [130 2 "// supported_versions a client has a chance to attempt a [TLS 1.2, TLS 1.4]"] [131 2 "// handshake in case TLS 1.3 is broken but 1.2 is not. Alas, in that case,"] [132 2 "// it will have to drop the TLS_FALLBACK_SCSV protection if it falls back to"] [133 2 "// TLS 1.2, because a TLS 1.3 server would abort here. The situation before"] [134 2 "// supported_versions was not better because there was just no way to do a"] [135 2 "// TLS 1.4 handshake without risking the server selecting TLS 1.3."] [138 4 "// Use c.vers instead of max(supported_versions) because an attacker"] [139 4 "// could defeat this by adding an arbitrary high version otherwise."] [171 3 "// See RFC 8446, Section 4.2.10 for the complicated behavior required"] [172 3 "// here. The scenario is that a different server at our address offered"] [173 3 "// to accept early data in the past, which we can't handle. For now, all"] [174 3 "// 0-RTT enabled session tickets need to expire before a Go server can"] [175 3 "// replace a server or join a pool. That's the same requirement that"] [176 3 "// applies to mixing or replacing with any TLS 1.2 server."] [206 2 "// First, if a post-quantum key exchange is available, use one. See"] [207 2 "// draft-ietf-tls-key-share-prediction-01, Section 4 for why this must be"] [208 2 "// first."] [209 2 "//"] [210 2 "// Second, if the client sent a key share for a group we support, use that,"] [211 2 "// to avoid a HelloRetryRequest round-trip."] [212 2 "//"] [213 2 "// Finally, pick in our fixed preference order."] [273 3 "// RFC 9001 Section 4.2: Clients MUST NOT offer TLS versions older than 1.3."] [280 3 "// RFC 9001 Section 8.2."] [300 65 "// arbace"] [368 3 "// PSK connections don't re-establish client certificates, but carry"] [369 3 "// them over in the session ticket. Ensure the presence of client certs"] [370 3 "// in the ticket is consistent with the configured requirements."] [400 3 "// Clone the transcript in case a HelloRetryRequest was recorded."] [448 1 "// cloneHash uses [hash.Cloner] to clone in. If [hash.Cloner]"] [449 1 "// is not implemented or not supported, then it falls back to the"] [450 1 "// [encoding.BinaryMarshaler] and [encoding.BinaryUnmarshaler]"] [451 1 "// interfaces implemented by standard library hashes to clone the state of in"] [452 1 "// to a new instance of h. It returns nil if the operation fails."] [459 2 "// Recreate the interface to avoid importing encoding."] [486 2 "// Only one of PSK and certificates are used at a time."] [491 2 "// signature_algorithms is required in TLS 1.3. See RFC 8446, Section 4.2.3."] [510 3 "// getCertificate returned a certificate that is unsupported or"] [511 3 "// incompatible with the client's signature algorithms."] [520 1 "// sendDummyChangeCipherSpec sends a ChangeCipherSpec record for compatibility"] [521 1 "// with middleboxes that didn't implement TLS correctly. See RFC 8446, Appendix D.4."] [537 2 "// Make sure the client didn't send extra handshake messages alongside"] [538 2 "// their initial client_hello. If they sent two client_hello messages,"] [539 2 "// we will consume the second before they respond to the server_hello."] [545 2 "// The first ClientHello gets double-hashed into the transcript upon a"] [546 2 "// HelloRetryRequest. See RFC 8446, Section 4.4.1."] [566 3 "// Compute the acceptance message."] [590 2 "// clientHelloMsg is not included in the transcript."] [667 1 "// illegalClientHelloChange reports whether the two ClientHello messages are"] [668 1 "// different, with the exception of the changes allowed before and after a"] [669 1 "// HelloRetryRequest. See RFC 8446, Section 4.1.2."] [735 3 "// compute the acceptance message"] [805 2 "// If client sent ECH extension, but we didn't accept it,"] [806 2 "// send retry configs, if available."] [832 3 "// arbace: deferred to Conn.RequestClientCertificate"] [839 2 "// Only one of PSK and certificates are used at a time."] [845 3 "// Request a client certificate"] [888 47 "// key too small for RSA-PSS"] [915 2 "// Derive secrets that take context through the server Finished."] [938 109 "// arbace"] [944 2 "// If we did not request client certificates, at this point we can"] [945 2 "// precompute the client finished and roll the transcript forward to send"] [946 2 "// session tickets in our first flight."] [961 2 "// QUIC tickets are sent by QUICConn.SendSessionTicket, not automatically."] [966 2 "// Don't send tickets the client wouldn't use. See RFC 8446, Section 4.2.9."] [994 2 "// ticket_nonce, which must be unique per connection, is always left at"] [995 2 "// zero because we only ever send one ticket per connection."] [1024 2 "// ticket_age_add is a random 32-bit value. See RFC 8446, section 4.6.1"] [1025 2 "// The value is not stored anywhere; we never need to check the ticket age"] [1026 2 "// because 0-RTT is not supported."] [1034 3 "// RFC 9001, Section 4.6.1"] [1049 3 "// Make sure the connection is still being verified whether or not"] [1050 3 "// the server requested a client certificate."] [1053 37 "// arbace"] [1060 2 "// If we requested a client certificate, then the client must send a"] [1061 2 "// certificate message. If it's empty, no CertificateVerify is sent."] [1073 40 "// arbace: as before, a decode error"] [1084 36 "// arbace"] [1090 3 "// certificateVerifyMsg is included in the transcript, but not until"] [1091 3 "// after we verify the handshake signature, since the state before"] [1092 3 "// this message was sent is used."] [1104 3 "// See RFC 8446, Section 4.4.3."] [1105 3 "// We don't use certReq.supportedSignatureAlgorithms because it would"] [1106 3 "// require keeping the certificateRequestMsgTLS13 around in the hs."] [1132 2 "// If we waited until the client certificates to send session tickets, we"] [1133 2 "// are ready to do it now."] [1144 2 "// finishedMsg is not included in the transcript."]] :go/pos {:name [5 9] :package [5 1]} :go/semis [[70 35] [73 35] [76 32] [80 37] [83 38] [86 35] [92 24] [95 38] [98 35] [102 66] [155 60] [300 42] [393 47] [424 55] [428 92] [454 35] [455 32] [477 46] [547 56] [569 61] [582 74] [586 42] [732 51] [746 56] [750 65] [754 42] [767 95] [773 89] [823 76] [855 65] [866 64] [887 43] [897 70] [911 65] [938 94] [948 36] [977 53] [1028 43] [1038 45] [1052 66] [1078 57] [1083 65] [1121 42] [1127 53] [1134 35] [1161 101]] :go/trails [[385 63] [562 35] [908 72] [975 32]]} (go/file "handshake_server_tls13.go" :impor
(in-ns 'go.arbace.pytls) ^{:go/comments [[1 1 "// Copyright 2024 The Go Authors. All rights reserved."] [2 1 "// Use of this source code is governed by a BSD-style"] [3 1 "// license that can be found in the LICENSE file."] [122 1 "// parseECHConfigList parses a RFC 9849 ECHConfigList, returning a"] [123 1 "// slice of parsed ECHConfigs, in the same order they were parsed, or an error"] [124 1 "// if the list is malformed."] [159 4 "// If high order bit is set to 1 the extension is mandatory."] [160 4 "// Since we don't support any extensions, if we see a mandatory"] [161 4 "// bit, we skip the config."] [175 4 "// This is an error in the config, but killing the connection feels"] [176 4 "// excessive."] [180 4 "// All of the supported AEADs and KDFs are fine, rather than"] [181 4 "// imposing some sort of preference here, we just pick the first"] [182 4 "// valid suite."] [187 4 "// 0xFFFF is an export-only AEAD that cannot seal/open, making"] [188 4 "// it an invalid choice for encrypting ClientHelloInner."] [207 12 "// strip four byte prefix"] [243 24 "// header, version, random"] [244 35 "// session ID"] [245 36 "// cipher suites"] [246 34 "// compression methods"] [268 2 "// Reconstructing the inner client hello from its encoded form is somewhat"] [269 2 "// complicated. It is missing its header (message type and length), session"] [270 2 "// ID, and the extensions may be compressed. Since we need to put the"] [271 2 "// extensions back in the same order as they were in the raw outer hello,"] [272 2 "// and since we don't store the raw extensions, or the order we parsed them"] [273 2 "// in, we need to reparse the raw extensions from the outer hello in order"] [274 2 "// to properly insert them into the inner hello. This _should_ result in raw"] [275 2 "// bytes which match the hello as it was generated by the client."] [288 2 "// The specification says we must verify that the trailing padding is all"] [289 2 "// zeros. This is kind of weird for TLS messages, where we generally just"] [290 2 "// throw away any trailing garbage."] [379 3 "// Skip GREASE values (values of the form 0x?A0A)."] [380 3 "// GREASE (Generate Random Extensions And Sustain Extensibility) is a mechanism used by"] [381 3 "// browsers like Chrome to ensure TLS implementations correctly ignore unknown values."] [382 3 "// GREASE values follow a specific pattern: 0x?A0A, where ? can be any hex digit."] [383 3 "// These values should be ignored when processing supported TLS versions."] [388 3 "// Ensure at least TLS 1.3 is offered."] [392 4 "// Reject if any non-GREASE value is below TLS 1.3, as ECH requires TLS 1.3+."] [411 16 "// outer"] [429 2 "// NOTE: the tag lengths for all of the supported AEADs are the same (16"] [430 2 "// bytes), so we have hardcoded it here. If we add support for another AEAD"] [431 2 "// with a different tag length, we will need to change this."] [432 41 "// AEAD tag length"] [441 40 "// strip the four byte prefix"] [453 1 "// validDNSName is a rather rudimentary check for the validity of a DNS name."] [454 1 "// This is used to check if the public_name in a ECHConfig is valid when we are"] [455 1 "// picking a config. This can be somewhat lax because even if we pick a"] [456 1 "// valid-looking name, the DNS layer will later reject it anyway."] [482 1 "// ECHRejectionError is the error type returned when ECH is rejected by a remote"] [483 1 "// server. If the server offered a ECHConfigList to use for retries, the"] [484 1 "// RetryConfigList field will contain this list."] [485 1 "//"] [486 1 "// The client may treat an ECHRejectionError with an empty set of RetryConfigs"] [487 1 "// as a secure signal from the server."] [548 2 "// NOTE: clone encap and payload so that mutating them does not mutate the"] [549 2 "// raw extension bytes."] [605 4 "// attempt next trial decryption"] [611 4 "// attempt next trial decryption"] [615 3 "// NOTE: we do not enforce that the sent server_name matches the ECH"] [616 3 "// configs PublicName, since this is not particularly important, and"] [617 3 "// the client already had to know what it was in order to properly"] [618 3 "// encrypt the payload. This is only a MAY in the spec, so we're not"] [619 3 "// doing anything revolutionary."]] :go/pos {:name [5 9] :package [5 1]} :go/semis [[340 11] [340 35]] :go/trails [[632 31]]} (go/file "ech.go" :imports [



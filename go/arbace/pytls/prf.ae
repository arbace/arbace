 called when there is no more need to"] [235 1 "// buffer the entirety of the handshake messages."] [240 1 "// noEKMBecauseRenegotiation is used as a value of"] [241 1 "// ConnectionState.ekm when renegotiation is enabled and thus"] [242 1 "// we wish to fail all key-material export requests."] [247 1 "// noEKMBecauseNoEMS is used as a value of ConnectionState.ekm when Extended"] [248 1 "// Master Secret is not negotiated and thus we wish to fail all key-material"] [249 1 "// export requests."] [254 1 "// ekmFromMasterSecret generates exported keying material as defined in RFC 5705."] [259 4 "// These values are reserved and may not be used."]] :go/pos {:name [5 9] :package [5 1]} :go/semis []} (go/file "prf.go" :imports [



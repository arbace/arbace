    ^{:go/pos {:name-pos [306 2]}} TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA ^{:go/pos {:name-pos [306 40]}} TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA


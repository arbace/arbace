(in-ns 'go.arbace.pytls) ^{:go/comments [[1 1 "// Copyright 2010 The Go Authors. All rights reserved."] [2 1 "// Use of this source code is governed by a BSD-style"] [3 1 "// license that can be found in the LICENSE file."] [18 20 "// for crypto.SHA384"] [22 13 "// for linkname"] [27 1 "// CipherSuite is a TLS cipher suite. Note that most functions in this package"] [28 1 "// accept and expose cipher suite IDs instead of this type."] [33 2 "// Supported versions is the list of TLS protocol versions that can"] [34 2 "// negotiate this cipher suite."] [37 2 "// Insecure is true if the cipher suite has known security issues"] [38 2 "// due to its primitives, design, or implementation."] [48 1 "// CipherSuites returns a list of cipher suites currently implemented by this"] [49 1 "// package, excluding those with security issues, which are returned by"] [50 1 "// [InsecureCipherSuites]."] [51 1 "//"] [52 1 "// The list is sorted by ID. Note that the default cipher suites selected by"] [53 1 "// this package might depend on logic that can't be captured by a static list,"] [54 1 "// and might not match those returned by this function."] [74 1 "// InsecureCipherSuites returns a list of cipher suites currently implemented by"] [75 1 "// this package and which have security issues."] [76 1 "//"] [77 1 "// Most applications should not use the cipher suites in this list, and should"] [78 1 "// only use those returned by [CipherSuites]."] [80 2 "// This list includes legacy RSA kex, RC4, CBC_SHA256, and 3DES cipher"] [81 2 "// suites. See cipherSuitesPreferenceOrder for details."] [88 3 "// arbace: the PSK suites, listed here as every suite that is disabled"] [89 3 "// by default (they are not insecure as such)."] [94 99 "// arbace"] [95 99 "// arbace"] [101 111 "// arbace"] [105 1 "// CipherSuiteName returns the standard name for the passed cipher suite ID"] [106 1 "// (e.g. \"TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256\"), or a fallback representation"] [107 1 "// of the ID value if the cipher suite is not implemented by this package."] [123 2 "// suiteECDHE indicates that the cipher suite involves elliptic curve"] [124 2 "// Diffie-Hellman. This means that it should only be selected when the"] [125 2 "// client indicates that it supports ECC with a curve and point format"] [126 2 "// that we're happy with."] [128 2 "// suiteECSign indicates that the cipher suite involves an ECDSA or"] [129 2 "// EdDSA signature and therefore may only be selected when the server's"] [130 2 "// certificate is ECDSA or EdDSA. If this is not set then the cipher suite"] [131 2 "// is RSA based."] [133 2 "// suiteTLS12 indicates that the cipher suite should only be advertised"] [134 2 "// and accepted when using TLS 1.2."] [136 2 "// suiteSHA384 indicates that the cipher suite uses SHA384 as the"] [137 2 "// handshake hash."] [139 2 "// suitePSK indicates a plain PSK key exchange (arbace: RFC 4279), used"] [140 2 "// only with Config.PSKClientCallback or Config.PSKServerCallback."] [144 1 "// A cipherSuite is a TLS 1.0–1.2 cipher suite, and defines the key exchange"] [145 1 "// mechanism, as well as the cipher+MAC pair or the AEAD."] [148 2 "// the lengths, in bytes, of the key material needed for each component."] [153 2 "// flags is a bitmask of the suite* values, above."] [160 36 "// TODO: replace with a map, since the order doesn't matter."] [183 2 "// arbace: PSK suites (RFC 4279, 5487, 7905)."] [191 1 "// selectCipherSuite returns the first TLS 1.0–1.2 cipher suite from ids which"] [192 1 "// is also in supportedIDs and passes the ok filter."] [209 1 "// A cipherSuiteTLS13 defines only the pair of the AEAD algorithm and hash"] [210 1 "// algorithm to be used with HKDF. See RFC 8446, Appendix B.4."] [218 1 "// cipherSuitesTLS13 should be an internal detail,"] [219 1 "// but widely used packages access it using linkname."] [220 1 "// Notable members of the hall of shame include:"] [221 1 "//   - github.com/quic-go/quic-go"] [222 1 "//   - github.com/sagernet/quic-go"] [223 1 "//"] [224 1 "// Do not remove or change the type signature."] [225 1 "// See go.dev/issue/67401."] [226 1 "//"] [227 1 "//go:linkname cipherSuitesTLS13"] [228 46 "// TODO: replace with a map."] [234 1 "// cipherSuitesPreferenceOrder is the order in which we'll select (on the"] [235 1 "// server) or advertise (on the client) TLS 1.0–1.2 cipher suites."] [236 1 "//"] [237 1 "// Cipher suites are filtered but not reordered based on the application and"] [238 1 "// peer's preferences, meaning we'll never select a suite lower in this list if"] [239 1 "// any higher one is available. This makes it more defensible to keep weaker"] [240 1 "// cipher suites enabled, especially on the server side where we get the last"] [241 1 "// word, since there are no known downgrade attacks on cipher suites selection."] [242 1 "//"] [243 1 "// The list is sorted by applying the following priority rules, stopping at the"] [244 1 "// first (most important) applicable one:"] [245 1 "//"] [246 1 "//   - Anything else comes before RC4"] [247 1 "//"] [248 1 "//     RC4 has practically exploitable biases. See https://www.rc4nomore.com."] [249 1 "//"] [250 1 "//   - Anything else comes before CBC_SHA256"] [251 1 "//"] [252 1 "//     SHA-256 variants of the CBC ciphersuites don't implement any Lucky13"] [253 1 "//     countermeasures. See https://www.isg.rhul.ac.uk/tls/Lucky13.html and"] [254 1 "//     https://www.imperialviolet.org/2013/02/04/luckythirteen.html."] [255 1 "//"] [256 1 "//   - Anything else comes before 3DES"] [257 1 "//"] [258 1 "//     3DES has 64-bit blocks, which makes it fundamentally susceptible to"] [259 1 "//     birthday attacks. See https://sweet32.info."] [260 1 "//"] [261 1 "//   - ECDHE comes before anything else"] [262 1 "//"] [263 1 "//     Once we got the broken stuff out of the way, the most important"] [264 1 "//     property a cipher suite can have is forward secrecy. We don't"] [265 1 "//     implement FFDHE, so that means ECDHE."] [266 1 "//"] [267 1 "//   - AEADs come before CBC ciphers"] [268 1 "//"] [269 1 "//     Even with Lucky13 countermeasures, MAC-then-Encrypt CBC cipher suites"] [270 1 "//     are fundamentally fragile, and suffered from an endless sequence of"] [271 1 "//     padding oracle attacks. See https://eprint.iacr.org/2015/1129,"] [272 1 "//     https://www.imperialviolet.org/2014/12/08/poodleagain.html, and"] [273 1 "//     https://blog.cloudflare.com/yet-another-padding-oracle-in-openssl-cbc-ciphersuites/."] [274 1 "//"] [275 1 "//   - AES comes before ChaCha20"] [276 1 "//"] [277 1 "//     When AES hardware is available, AES-128-GCM and AES-256-GCM are faster"] [278 1 "//     than ChaCha20Poly1305."] [279 1 "//"] [280 1 "//     When AES hardware is not available, AES-128-GCM is one or more of: much"] [281 1 "//     slower, way more complex, and less safe (because not constant time)"] [282 1 "//     than ChaCha20Poly1305."] [283 1 "//"] [284 1 "//     We use this list if we think both peers have AES hardware, and"] [285 1 "//     cipherSuitesPreferenceOrderNoAES otherwise."] [286 1 "//"] [287 1 "//   - AES-128 comes before AES-256"] [288 1 "//"] [289 1 "//     The only potential advantages of AES-256 are better multi-target"] [290 1 "//     margins, and hypothetical post-quantum properties. Neither apply to"] [291 1 "//     TLS, and AES-256 is slower due to its four extra rounds (which don't"] [292 1 "//     contribute to the advantages above)."] [293 1 "//"] [294 1 "//   - ECDSA comes before RSA"] [295 1 "//"] [296 1 "//     The relative order of ECDSA and RSA cipher suites doesn't matter,"] [297 1 "//     as they depend on the certificate. Pick one to get a stable order."] [299 2 "// AEADs w/ ECDHE"] [304 2 "// CBC w/ ECDHE"] [308 2 "// AEADs w/o ECDHE"] [312 2 "// CBC w/o ECDHE"] [316 2 "// 3DES"] [320 2 "// CBC_SHA256"] [324 2 "// RC4"] [328 2 "// arbace: PSK suites, disabled unless listed in Config.CipherSuites."] [335 2 "// ChaCha20Poly1305"] [338 2 "// AES-GCM w/ ECDHE"] [342 2 "// The rest of cipherSuitesPreferenceOrder."] [356 2 "// arbace: PSK suites, disabled unless listed in Config.CipherSuites."] [362 1 "// disabledCipherSuites are not used unless explicitly listed in Config.CipherSuites."] [364 2 "// CBC_SHA256"] [369 2 "// RC4"] [374 2 "// RSA key exchange"] [381 2 "// 3DES"] [384 2 "// arbace: PSK"] [393 2 "// Keep in sync with crypto/internal/fips140/aes/gcm.supportsAESGCM."] [403 2 "// TLS 1.2"] [408 2 "// TLS 1.3"] [413 1 "// isAESGCMPreferred returns whether we have hardware support for AES-GCM, and the"] [414 1 "// first known cipher in the peer's preference list is an AES-GCM cipher,"] [415 1 "// implying the peer also has hardware support for it."] [452 1 "// macSHA1 returns a SHA-1 based constant time MAC."] [455 2 "// The BoringCrypto SHA1 does not have a constant-time"] [456 2 "// checksum function, so don't try to use it."] [463 1 "// macSHA256 returns a SHA-256 based MAC. This is only supported in TLS 1.2 and"] [464 1 "// is currently only used in disabled-by-default cipher suites."] [472 2 "// explicitNonceLen returns the number of bytes of explicit nonce"] [473 2 "// included in each record. This is eight for older AEADs and"] [474 2 "// zero for modern ones."] [483 1 "// prefixNonceAEAD wraps an AEAD and prefixes a fixed portion of the nonce to"] [484 1 "// each call."] [486 2 "// nonce contains the fixed part of the nonce in the first four bytes."] [505 1 "// xorNonceAEAD wraps an AEAD by XORing in a fixed pattern to the nonce"] [506 1 "// before each call."] [512 60 "// 64-bit sequence number"] [553 34 "// arbace: was gcm.NewGCMForTLS12"] [564 1 "// aeadAESGCMTLS13 should be an internal detail,"] [565 1 "// but widely used packages access it using linkname."] [566 1 "// Notable members of the hall of shame include:"] [567 1 "//   - github.com/xtls/xray-core"] [568 1 "//   - github.com/v2fly/v2ray-core"] [569 1 "//"] [570 1 "// Do not remove or change the type signature."] [571 1 "// See go.dev/issue/67401."] [572 1 "//"] [573 1 "//go:linkname aeadAESGCMTLS13"] [587 34 "// arbace: was gcm.NewGCMForTLS13"] [617 1 "// cthWrapper wraps any hash.Hash that implements ConstantTimeSum, and replaces"] [618 1 "// with that all calls to Sum. It's used to obtain a ConstantTimeSum-based HMAC."] [636 1 "// tls10MAC implements the TLS 1.0 MAC function. RFC 2246, Section 6.2.3."] [667 1 "// mutualCipherSuite returns a cipherSuite given a list of supported"] [668 1 "// ciphersuites and the id requested by the peer."] [705 1 "// A list of cipher suite IDs that are, or have been, implemented by this"] [706 1 "// package."] [707 1 "//"] [708 1 "// See https://www.iana.org/assignments/tls-parameters/tls-parameters.xml"] [710 2 "// TLS 1.0 - 1.2 cipher suites."] [734 2 "// TLS 1.3 cipher suites."] [739 2 "// TLS_FALLBACK_SCSV isn't a standard cipher suite but an indicator"] [740 2 "// that the client is doing version fallback. See RFC 7507."] [743 2 "// Legacy names for the corresponding cipher suites with the correct _SHA256"] [744 2 "// suffix, retained for backward compatibility."]] :go/pos {:name [5 9] :package [5 1]} :go/semis [[421 31] [424 36]] :go/trails [[70 126] [101 109] [188 86] [231 62] [331 60] [359 60] [389 45] [410 30] [656 19] [663 19]]} (go/file "cipher_suites.go" :imports [



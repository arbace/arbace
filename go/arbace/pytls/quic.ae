(in-ns 'go.arbace.pytls) ^{:go/comments [[1 1 "// Copyright 2023 The Go Authors. All rights reserved."] [2 1 "// Use of this source code is governed by a BSD-style"] [3 1 "// license that can be found in the LICENSE file."] [14 1 "// QUICEncryptionLevel represents a QUIC encryption level used to transmit"] [15 1 "// handshake messages."] [40 1 "// A QUICConn represents a connection which uses a QUIC implementation as the underlying"] [41 1 "// transport as described in RFC 9001."] [42 1 "//"] [43 1 "// Methods of QUICConn are not safe for concurrent use."] [50 1 "// A QUICConfig configures a [QUICConn]."] [54 2 "// EnableSessionEvents may be set to true to enable the"] [55 2 "// [QUICStoreSession] and [QUICResumeSession] events for client connections."] [56 2 "// When this event is enabled, sessions are not automatically"] [57 2 "// stored in the client session cache."] [58 2 "// The application should use [QUICConn.StoreSession] to store sessions."] [61 2 "// ClientHelloInfoConn is the net.Conn to use for the ClientHelloInfo.Conn field."] [65 1 "// A QUICEventKind is a type of operation on a QUIC connection."] [69 2 "// QUICNoEvent indicates that there are no events available."] [72 2 "// QUICSetReadSecret and QUICSetWriteSecret provide the read and write"] [73 2 "// secrets for a given encryption level."] [74 2 "// QUICEvent.Level, QUICEvent.Data, and QUICEvent.Suite are set."] [75 2 "//"] [76 2 "// Secrets for the Initial encryption level are derived from the initial"] [77 2 "// destination connection ID, and are not provided by the QUICConn."] [81 2 "// QUICWriteData provides data to send to the peer in CRYPTO frames."] [82 2 "// QUICEvent.Data is set."] [85 2 "// QUICTransportParameters provides the peer's QUIC transport parameters."] [86 2 "// QUICEvent.Data is set."] [89 2 "// QUICTransportParametersRequired indicates that the caller must provide"] [90 2 "// QUIC transport parameters to send to the peer. The caller should set"] [91 2 "// the transport parameters with QUICConn.SetTransportParameters and call"] [92 2 "// QUICConn.NextEvent again."] [93 2 "//"] [94 2 "// If transport parameters are set before calling QUICConn.Start, the"] [95 2 "// connection will never generate a QUICTransportParametersRequired event."] [98 2 "// QUICRejectedEarlyData indicates that the server rejected 0-RTT data even"] [99 2 "// if we offered it. It's returned before QUICEncryptionLevelApplication"] [100 2 "// keys are returned."] [101 2 "// This event only occurs on client connections."] [104 2 "// QUICHandshakeDone indicates that the TLS handshake has completed."] [107 2 "// QUICResumeSession indicates that a client is attempting to resume a previous session."] [108 2 "// [QUICEvent.SessionState] is set."] [109 2 "//"] [110 2 "// For client connections, this event occurs when the session ticket is selected."] [111 2 "// For server connections, this event occurs when receiving the client's session ticket."] [112 2 "//"] [113 2 "// The application may set [QUICEvent.SessionState.EarlyData] to false before the"] [114 2 "// next call to [QUICConn.NextEvent] to decline 0-RTT even if the session supports it."] [117 2 "// QUICStoreSession indicates that the server has provided state permitting"] [118 2 "// the client to resume the session."] [119 2 "// [QUICEvent.SessionState] is set."] [120 2 "// The application should use [QUICConn.StoreSession] session to store the [SessionState]."] [121 2 "// The application may modify the [SessionState] before storing it."] [122 2 "// This event only occurs on client connections."] [125 2 "// QUICErrorEvent indicates that a fatal error has occurred."] [126 2 "// The handshake cannot proceed and the connection must be closed."] [127 2 "// QUICEvent.Err is set."] [131 1 "// A QUICEvent is an event occurring on a QUIC connection."] [132 1 "//"] [133 1 "// The type of event is specified by the Kind field."] [134 1 "// The contents of the other fields are kind-specific."] [138 2 "// Set for QUICSetReadSecret, QUICSetWriteSecret, and QUICWriteData."] [141 2 "// Set for QUICTransportParameters, QUICSetReadSecret, QUICSetWriteSecret, and QUICWriteData."] [142 2 "// The contents are owned by crypto/tls, and are valid until the next NextEvent call."] [145 2 "// Set for QUICSetReadSecret and QUICSetWriteSecret."] [148 2 "// Set for QUICResumeSession and QUICStoreSession."] [151 2 "// Set for QUICErrorEvent."] [152 2 "// The error will wrap AlertError."] [160 2 "// eventArr is a statically allocated event array, large enough to handle"] [161 2 "// the usual maximum number of events resulting from a single call: transport"] [162 2 "// parameters, Initial data, Early read secret, Handshake write and read"] [163 2 "// secrets, Handshake data, Application write secret, Application data."] [167 27 "// handshake data is available to be read"] [168 27 "// handshake is waiting for data, closed when done"] [169 27 "// handshake context"] [175 2 "// readbuf is shared between HandleData and the handshake goroutine."] [176 2 "// HandshakeCryptoData passes ownership to the handshake goroutine by"] [177 2 "// reading from signalc, and reclaims ownership by reading from blockedc."] [180 25 "// to send to the peer"] [186 1 "// QUICClient returns a new TLS client side connection using QUICTransport as the"] [187 1 "// underlying transport. The config cannot be nil."] [192 1 "// QUICServer returns a new TLS server side connection using QUICTransport as the"] [193 1 "// underlying transport. The config cannot be nil."] [211 1 "// Start starts the client or server handshake protocol."] [212 1 "// It may produce connection events, which may be read with [QUICConn.NextEvent]."] [213 1 "//"] [214 1 "// Start must be called at most once."] [227 1 "// NextEvent returns the next event occurring on the connection."] [228 1 "// It returns an event with a Kind of [QUICNoEvent] when no events are available."] [232 3 "// Write over some of the previous event's data,"] [233 3 "// to catch callers erroneously retaining it."] [256 40 "// zero out references to data"] [261 1 "// Close closes the connection and stops any in-progress handshake."] [264 14 "// never started"] [269 3 "// Wait for the handshake goroutine to return."] [274 1 "// HandleData handles handshake bytes received from the peer."] [275 1 "// It may produce connection events, which may be read with [QUICConn.NextEvent]."] [285 3 "// The handshake goroutine is waiting for more data."] [288 2 "// The handshake goroutine has exited."] [314 2 "// EarlyData specifies whether the ticket may be used for 0-RTT."] [319 1 "// SendSessionTicket sends a session ticket to the client."] [320 1 "// It produces connection events, which may be read with [QUICConn.NextEvent]."] [321 1 "// Currently, it can only be called once."] [340 1 "// StoreSession stores a session previously received in a QUICStoreSession event"] [341 1 "// in the ClientSessionCache."] [342 1 "// The application may process additional events or modify the SessionState"] [343 1 "// before storing the session."] [358 1 "// ConnectionState returns basic TLS details about the connection."] [363 1 "// SetTransportParameters sets the transport parameters to send to the peer."] [364 1 "//"] [365 1 "// Server connections may delay setting the transport parameters until after"] [366 1 "// receiving the client's transport parameters. See [QUICTransportParametersRequired]."] [378 1 "// quicError ensures err is an AlertError."] [379 1 "// If err is not already, quicError wraps it with alertInternalError."] [391 2 "// Return an error wrapping the original error and an AlertError."] [392 2 "// Truncate the text of the alert to 0 characters."] [406 2 "// Ensure that there are no buffered handshake messages before changing the"] [407 2 "// read keys, since that can cause messages to be parsed that were encrypted"] [408 2 "// using old keys which are no longer appropriate."] [409 2 "// TODO(roland): we should merge this check with the similar one in setReadTrafficSecret."] [501 1 "// quicWaitForSignal notifies the QUICConn that handshake progress is blocked,"] [502 1 "// and waits for a signal that the handshake should proceed."] [503 1 "//"] [504 1 "// The handshake may become blocked waiting for handshake bytes"] [505 1 "// or for the user to provide transport parameters."] [507 2 "// Drop the handshake mutex while blocked to allow the user"] [508 2 "// to call ConnectionState before the handshake completes."] [511 2 "// Send on blockedc to notify the QUICConn that the handshake is blocked."] [512 2 "// Exported methods of QUICConn wait for the handshake to become blocked"] [513 2 "// before returning to the user."] [515 2 "// The QUICConn reads from signalc to notify us that the handshake may"] [516 2 "// be able to proceed. (The QUICConn reads, because we close signalc to"] [517 2 "// indicate that the handshake has completed.)"] [520 3 "// The connection has been canceled."]] :go/pos {:name [5 9] :package [5 1]} :go/semis [[221 36] [231 29] [241 31] [303 48] [384 44] [398 34] [454 34] [482 34]] :go/trails [[203 50] [207 13] [418 16] [428 16] [440 16] [450 24] [464 24] [471 15] [478 41] [491 26] [497 30]]} (go/file "quic.go" :imports [



    ^{:tag ^{:go/pos {:name-pos [852 20]}} bool :doc "PostHandshakeAuth, on a client, offers TLS 1.3 post-handshake client\nauthentication (RFC 8446, Section 4.6.2): the post_handshake_auth\nextension is sent, and a CertificateRequest received after the\nhandshake is answered with a certificate chosen as for one received\nduring it (GetClientCertificate or Certificates).\n\nServers do not use it: a server accepts post-handshake authentication\nwhenever a TLS 1.3 client offers it (see PostHandshakeClientAuth and\n[Conn.RequestClientCertificate]).\n" :go/pos {:name-pos [852 2]}} PostHandshakeAuth









    ^{:tag ^{:go/pos {:name-pos [862 26]}} ClientAuthType :doc "PostHandshakeClientAuth, on a server, defers client authentication to\nafter the handshake, as OpenSSL's SSL_VERIFY_POST_HANDSHAKE. When it is\nnot NoClientCert and a TLS 1.3 client offered post-handshake\nauthentication, the handshake sends no CertificateRequest, whatever\nClientAuth says, and [Conn.RequestClientCertificate] applies this\npolicy. In TLS 1.2, or when the client did not offer it, the handshake\napplies ClientAuth as usual. When it is NoClientCert,\nRequestClientCertificate applies ClientAuth.\n" :go/pos {:name-pos [862 2]}} PostHandshakeClientAuth









    ^{:tag ^{:go/pos {:func [872 20]}} (func ^{:go/pos {:closing [872 36] :opening [872 24]}} [^{:tag ^{:go/pos {:lbrack [872 30]}} (slice ^{:go/pos {:name-pos [872 32]}} byte) :go/pos {:name-pos [872 25]}} hint] ^{:go/pos {:closing [872 70] :opening [872 38]}} [^{:tag ^{:go/pos {:lbrack [872 53]}} (slice ^{:go/pos {:name-pos [872 55]}} byte) :go/pos {:name-pos [872 39]}} identity ^{:tag ^{:go/pos {:lbrack [872 53]}} (slice ^{:go/pos {:name-pos [872 55]}} byte) :go/pos {:name-pos [872 49]}} key ^{:tag ^{:go/pos {:name-pos [872 65]}} error :go/pos {:name-pos [872 61]}} err]) :doc "PSKClientCallback, on a client, supplies an external pre-shared key\nas OpenSSL's psk_client_callback. It is called with the server's\nidentity hint, nil when there is none (always nil for TLS 1.3, where it\nis called while the ClientHello is built), and returns the identity and\nthe key. An empty key offers no PSK. In TLS 1.3 the PSK is offered with\npsk_dhe_ke and SHA-256 (as for TLS_AES_128_GCM_SHA256); in TLS 1.2 it is\nused by the PSK cipher suites (RFC 4279), which must be listed in\nCipherSuites.\n" :go/pos {:name-pos [872 2]}} PSKClientCallback






    ^{:tag ^{:go/pos {:func [879 20]}} (func ^{:go/pos {:closing [879 40] :opening [879 24]}} [^{:tag ^{:go/pos {:lbrack [879 34]}} (slice ^{:go/pos {:name-pos [879 36]}} byte) :go/pos {:name-pos [879 25]}} identity] ^{:go/pos {:closing [879 64] :opening [879 42]}} [^{:tag ^{:go/pos {:lbrack [879 47]}} (slice ^{:go/pos {:name-pos [879 49]}} byte) :go/pos {:name-pos [879 43]}} key ^{:tag ^{:go/pos {:name-pos [879 59]}} error :go/pos {:name-pos [879 55]}} err]) :doc "PSKServerCallback, on a server, maps a client's PSK identity to its key,\nas OpenSSL's psk_server_callback. A nil key rejects the identity. A\nserver with PSKServerCallback set needs no certificate for the TLS 1.2\nPSK cipher suites (which must be listed in CipherSuites) nor for TLS 1.3\nexternal PSK handshakes.\n" :go/pos {:name-pos [879 2]}} PSKServerCallback




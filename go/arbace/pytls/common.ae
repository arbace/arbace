    ^{:tag ^{:go/pos {:lbrack [603 15]}} (slice ^{:go/pos {:name-pos [603 17]}} Certificate) :doc "Certificates contains one or more certificate chains to present to the\nother side of the connection. The first certificate compatible with the\npeer's requirements is selected automatically.\n\nServer configurations must set one of Certificates, GetCertificate or\nGetConfigForClient. Clients doing client-authentication may set either\nCertificates or GetClientCertificate.\n\nNote: if there are multiple Certificates, and they don't have the\noptional field Leaf set, certificate selection will incur a significant\nper-handshake performance cost.\n" :go/pos {:name-pos [603 2]}} Certificates








    ^{:tag ^{:go/pos {:map [612 20]}} (map ^{:go/pos {:name-pos [612 24]}} string ^{:go/pos {:star [612 31]}} (* ^{:go/pos {:name-pos [612 32]}} Certificate)) :doc "NameToCertificate maps from a certificate name to an element of\nCertificates. Note that a certificate name can be of the form\n'*.example.com' and so doesn't have to be a domain name as such.\n\nDeprecated: NameToCertificate only allows associating a single\ncertificate with a given name. Leave this field nil to let the library\nselect the first compatible chain from Certificates.\n" :go/pos {:name-pos [612 2]}} NameToCertificate










    ^{:tag ^{:go/pos {:func [623 17]}} (func ^{:go/pos {:closing [623 38] :opening [623 21]}} [^{:go/pos {:star [623 22]}} (* ^{:go/pos {:name-pos [623 23]}} ClientHelloInfo)] ^{:go/pos {:closing [623 60] :opening [623 40]}} [^{:go/pos {:star [623 41]}} (* ^{:go/pos {:name-pos [623 42]}} Certificate) ^{:go/pos {:name-pos [623 55]}} error]) :doc "GetCertificate returns a Certificate based on the given\nClientHelloInfo. It will only be called if the client supplies SNI\ninformation or if Certificates is empty.\n\nIf GetCertificate is nil or returns nil, then the certificate is\nretrieved from NameToCertificate. If NameToCertificate is nil, the\nbest element of Certificates will be used.\n\nOnce a Certificate is returned it should not be modified.\n" :go/pos {:name-pos [623 2]}} GetCertificate
















    ^{:tag ^{:go/pos {:func [640 23]}} (func ^{:go/pos {:closing [640 51] :opening [640 27]}} [^{:go/pos {:star [640 28]}} (* ^{:go/pos {:name-pos [640 29]}} CertificateRequestInfo)] ^{:go/pos {:closing [640 73] :opening [640 53]}} [^{:go/pos {:star [640 54]}} (* ^{:go/pos {:name-pos [640 55]}} Certificate) ^{:go/pos {:name-pos [640 68]}} error]) :doc "GetClientCertificate, if not nil, is called when a server requests a\ncertificate from a client. If set, the contents of Certificates will\nbe ignored.\n\nIf GetClientCertificate returns an error, the handshake will be\naborted and that error will be returned. Otherwise\nGetClientCertificate must return a non-nil Certificate. If\nCertificate.Certificate is empty then no certificate will be sent to\nthe server. If this is unacceptable to the server then it may abort\nthe handshake.\n\nGetClientCertificate may be called multiple times for the same\nconnection if renegotiation occurs or if TLS 1.3 is in use.\n\nOnce a Certificate is returned it should not be modified.\n" :go/pos {:name-pos [640 2]}} GetClientCertificate

















    ^{:tag ^{:go/pos {:func [658 21]}} (func ^{:go/pos {:closing [658 42] :opening [658 25]}} [^{:go/pos {:star [658 26]}} (* ^{:go/pos {:name-pos [658 27]}} ClientHelloInfo)] ^{:go/pos {:closing [658 59] :opening [658 44]}} [^{:go/pos {:star [658 45]}} (* ^{:go/pos {:name-pos [658 46]}} Config) ^{:go/pos {:name-pos [658 54]}} error]) :doc "GetConfigForClient, if not nil, is called after a ClientHello is\nreceived from a client. It may return a non-nil Config in order to\nchange the Config that will be used to handle this connection. If\nthe returned Config is nil, the original Config will be used. The\nConfig returned by this callback may not be subsequently modified.\n\nIf GetConfigForClient is nil, the Config passed to Server() will be\nused for all connections.\n\nIf SessionTicketKey is explicitly set on the returned Config, or if\nSetSessionTicketKeys is called on the returned Config, those keys will\nbe used. Otherwise, the original Config keys will be used (and possibly\nrotated if they are automatically managed). WARNING: this allows session\nresumption of connections originally established with the parent (or a\nsibling) Config, which may bypass the [Config.VerifyPeerCertificate]\nvalue of the returned Config.\n" :go/pos {:name-pos [658 2]}} GetConfigForClient






















    ^{:tag ^{:go/pos {:func [681 24]}} (func ^{:go/pos {:closing [681 84] :opening [681 28]}} [^{:tag ^{:go/pos {:lbrack [681 38]}} (slice ^{:go/pos {:lbrack [681 40]}} (slice ^{:go/pos {:name-pos [681 42]}} byte)) :go/pos {:name-pos [681 29]}} rawCerts ^{:tag ^{:go/pos {:lbrack [681 63]}} (slice ^{:go/pos {:lbrack [681 65]}} (slice ^{:go/pos {:star [681 67]}} (* ^{:go/pos {:dot [681 72] :name-pos [681 73] :x-pos [681 68]}} x509/Certificate))) :go/pos {:name-pos [681 48]}} verifiedChains] [^{:go/pos {:name-pos [681 86]}} error]) :doc "VerifyPeerCertificate, if not nil, is called after normal\ncertificate verification by either a TLS client or server. It\nreceives the raw ASN.1 certificates provided by the peer and also\nany verified chains that normal processing found. If it returns a\nnon-nil error, the handshake is aborted and that error results.\n\nIf normal verification fails then the handshake will abort before\nconsidering this callback. If normal verification is disabled (on the\nclient when InsecureSkipVerify is set, or on a server when ClientAuth is\nRequestClientCert or RequireAnyClientCert), then this callback will be\nconsidered but the verifiedChains argument will always be nil. When\nClientAuth is NoClientCert, this callback is not called on the server.\nrawCerts may be empty on the server if ClientAuth is RequestClientCert or\nVerifyClientCertIfGiven.\n\nThis callback is not invoked on resumed connections. WARNING: this\nincludes connections resumed across Configs returned by [Config.Clone] or\n[Config.GetConfigForClient] and their parents. If that is not intended,\nuse [Config.VerifyConnection] instead, or set [Config.SessionTicketsDisabled].\n\nverifiedChains and its contents should not be modified.\n" :go/pos {:name-pos [681 2]}} VerifyPeerCertificate










    ^{:tag ^{:go/pos {:func [692 19]}} (func ^{:go/pos {:closing [692 39] :opening [692 23]}} [^{:go/pos {:name-pos [692 24]}} ConnectionState] [^{:go/pos {:name-pos [692 41]}} error]) :doc "VerifyConnection, if not nil, is called after normal certificate\nverification and after VerifyPeerCertificate by either a TLS client\nor server. If it returns a non-nil error, the handshake is aborted\nand that error results.\n\nIf normal verification fails then the handshake will abort before\nconsidering this callback. This callback will run for all connections,\nincluding resumptions, regardless of InsecureSkipVerify or ClientAuth\nsettings.\n" :go/pos {:name-pos [692 2]}} VerifyConnection





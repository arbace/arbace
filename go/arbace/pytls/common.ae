(in-ns 'go.arbace.pytls) ^{:go/comments [[1 1 "// Copyright 2009 The Go Authors. All rights reserved."] [2 1 "// Use of this source code is governed by a BSD-style"] [3 1 "// license that can be found in the LICENSE file."] [32 13 "// for linkname"] [41 2 "// Deprecated: SSLv3 is cryptographically broken, and is no longer"] [42 2 "// supported by this package. See golang.org/issue/32716."] [46 1 "// VersionName returns the name for the provided TLS version number"] [47 1 "// (e.g. \"TLS 1.3\"), or a fallback representation of the value if the"] [48 1 "// version is not implemented by this package."] [67 44 "// maximum plaintext payload length"] [68 44 "// maximum ciphertext payload length"] [69 44 "// maximum ciphertext length in TLS 1.3"] [70 44 "// record header length"] [71 44 "// maximum handshake we support (protocol max is 16 MB)"] [72 44 "// maximum certificate message size (256 KiB)"] [73 44 "// maximum number of consecutive non-advancing records"] [76 1 "// TLS record types."] [86 1 "// TLS handshake message types."] [103 38 "// synthetic message"] [106 1 "// TLS compression types."] [111 1 "// TLS extension numbers"] [115 47 "// supported_groups in TLS 1.3, see RFC 8446, Section 4.2.7"] [136 1 "// TLS signaling cipher suite values"] [141 1 "// CurveID is the type of a TLS identifier for a key exchange mechanism. See"] [142 1 "// https://www.iana.org/assignments/tls-parameters/tls-parameters.xml#tls-parameters-8."] [143 1 "//"] [144 1 "// In TLS 1.2, this registry used to support only elliptic curves. In TLS 1.3,"] [145 1 "// it was extended to other groups and renamed NamedGroup. See RFC 8446, Section"] [146 1 "// 4.2.7. It was then also extended to other mechanisms, such as hybrid"] [147 1 "// post-quantum KEMs."] [179 1 "// TLS 1.3 Key Share. See RFC 8446, Section 4.2.8."] [185 1 "// TLS 1.3 PSK Key Exchange Modes. See RFC 8446, Section 4.2.9."] [191 1 "// TLS 1.3 PSK Identity. Can be a Session Ticket, or a reference to a saved"] [192 1 "// session. See RFC 8446, Section 4.2.11."] [198 1 "// TLS Elliptic Curve Point Formats"] [199 1 "// https://www.iana.org/assignments/tls-parameters/tls-parameters.xml#tls-parameters-9"] [204 1 "// TLS CertificateStatusType (RFC 3546)"] [209 1 "// Certificate types (for certificateRequestMsg)"] [212 25 "// ECDSA or EdDSA keys, see RFC 8422, Section 3."] [215 1 "// Signature algorithms (for internal signaling use). Starting at 225 to avoid overlap with"] [216 1 "// TLS 1.2 codepoints (RFC 5246, Appendix A.4.1), with which these have nothing to do."] [225 1 "// directSigning is a standard Hash value that signals that no pre-hashing"] [226 1 "// should be performed, and that the input should be signed directly. It is the"] [227 1 "// hash function associated with the Ed25519 and ML-DSA signature schemes."] [230 1 "// helloRetryRequestRandom is set as the Random value of a ServerHello"] [231 1 "// to signal that the message is actually a HelloRetryRequest."] [232 39 "// See RFC 8446, Section 4.1.3."] [240 2 "// downgradeCanaryTLS12 or downgradeCanaryTLS11 is embedded in the server"] [241 2 "// random as a downgrade protection if the server would be capable of"] [242 2 "// negotiating a higher version. See RFC 8446, Section 4.1.3."] [247 1 "// testingOnlyForceDowngradeCanary is set in tests to force the server side to"] [248 1 "// include downgrade canaries even if it's using its highers supported version."] [251 1 "// ConnectionState records basic TLS details about the connection."] [253 2 "// Version is the TLS version used by the connection (e.g. VersionTLS12)."] [256 2 "// HandshakeComplete is true if the handshake has concluded."] [259 2 "// DidResume is true if this connection was successfully resumed from a"] [260 2 "// previous session with a session ticket or similar mechanism."] [263 2 "// CipherSuite is the cipher suite negotiated for the connection (e.g."] [264 2 "// TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, TLS_AES_128_GCM_SHA256)."] [267 2 "// CurveID is the key exchange mechanism used for the connection. The name"] [268 2 "// refers to elliptic curves for legacy reasons, see [CurveID]. If a legacy"] [269 2 "// RSA key exchange is used, this value is zero."] [272 2 "// NegotiatedProtocol is the application protocol negotiated with ALPN."] [275 2 "// NegotiatedProtocolIsMutual used to indicate a mutual NPN negotiation."] [276 2 "//"] [277 2 "// Deprecated: this value is always true."] [280 2 "// ServerName is the value of the Server Name Indication extension sent by"] [281 2 "// the client. It's available both on the server and on the client side."] [284 2 "// PeerCertificates are the parsed certificates sent by the peer, in the"] [285 2 "// order in which they were sent. The first element is the leaf certificate"] [286 2 "// that the connection is verified against."] [287 2 "//"] [288 2 "// On the client side, it can't be empty. On the server side, it can be"] [289 2 "// empty if Config.ClientAuth is not RequireAnyClientCert or"] [290 2 "// RequireAndVerifyClientCert."] [291 2 "//"] [292 2 "// PeerCertificates and its contents should not be modified."] [295 2 "// VerifiedChains is a list of one or more chains where the first element is"] [296 2 "// PeerCertificates[0] and the last element is from Config.RootCAs (on the"] [297 2 "// client side) or Config.ClientCAs (on the server side)."] [298 2 "//"] [299 2 "// On the client side, it's set if Config.InsecureSkipVerify is false. On"] [300 2 "// the server side, it's set if Config.ClientAuth is VerifyClientCertIfGiven"] [301 2 "// (and the peer provided a certificate) or RequireAndVerifyClientCert."] [302 2 "//"] [303 2 "// VerifiedChains and its contents should not be modified."] [306 2 "// SignedCertificateTimestamps is a list of SCTs provided by the peer"] [307 2 "// through the TLS handshake for the leaf certificate, if any."] [310 2 "// OCSPResponse is a stapled Online Certificate Status Protocol (OCSP)"] [311 2 "// response provided by the peer for the leaf certificate, if any."] [314 2 "// TLSUnique contains the \"tls-unique\" channel binding value (see RFC 5929,"] [315 2 "// Section 3). This value will be nil for TLS 1.3 connections and for"] [316 2 "// resumed connections that don't support Extended Master Secret (RFC 7627)."] [319 2 "// ECHAccepted indicates if Encrypted Client Hello was offered by the client"] [320 2 "// and accepted by the server. Currently, ECH is supported only on the"] [321 2 "// client side."] [324 2 "// HelloRetryRequest indicates whether we sent a HelloRetryRequest if we"] [325 2 "// are a server, or if we received a HelloRetryRequest if we are a client."] [328 2 "// LocalCertificate is the certificate chain presented to the peer, if any,"] [329 2 "// during the handshake. This field is only populated for connections which"] [330 2 "// are not resumed (DidResume is false)."] [333 2 "// ekm is a closure exposed via ExportKeyingMaterial."] [336 2 "// testingOnlyPeerSignatureAlgorithm is the signature algorithm used by the"] [337 2 "// peer to sign the handshake. It is not set for resumed connections."] [341 1 "// ExportKeyingMaterial returns length bytes of exported key material in a new"] [342 1 "// slice as defined in RFC 5705. If context is nil, it is not used as part of"] [343 1 "// the seed. If the connection was set to allow renegotiation via"] [344 1 "// Config.Renegotiation, or if the connections supports neither TLS 1.3 nor"] [345 1 "// Extended Master Secret, this function will return an error."] [350 1 "// ClientAuthType declares the policy the server will follow for"] [351 1 "// TLS Client Authentication."] [355 2 "// NoClientCert indicates that no client certificate should be requested"] [356 2 "// during the handshake, and if any certificates are sent they will not"] [357 2 "// be verified."] [359 2 "// RequestClientCert indicates that a client certificate should be requested"] [360 2 "// during the handshake, but does not require that the client send any"] [361 2 "// certificates."] [363 2 "// RequireAnyClientCert indicates that a client certificate should be requested"] [364 2 "// during the handshake, and that at least one certificate is required to be"] [365 2 "// sent by the client, but that certificate is not required to be valid."] [367 2 "// VerifyClientCertIfGiven indicates that a client certificate should be requested"] [368 2 "// during the handshake, but does not require that the client sends a"] [369 2 "// certificate. If the client does send a certificate it is required to be"] [370 2 "// valid."] [372 2 "// RequireAndVerifyClientCert indicates that a client certificate should be requested"] [373 2 "// during the handshake, and that at least one valid certificate is required"] [374 2 "// to be sent by the client."] [378 1 "// requiresClientCert reports whether the ClientAuthType requires a client"] [379 1 "// certificate to be provided."] [389 1 "// ClientSessionCache is a cache of ClientSessionState objects that can be used"] [390 1 "// by a client to resume a TLS session with a given server. ClientSessionCache"] [391 1 "// implementations should expect to be called concurrently from different"] [392 1 "// goroutines. Up to TLS 1.2, only ticket-based resumption is supported, not"] [393 1 "// SessionID-based resumption. In TLS 1.3 they were merged into PSK modes, which"] [394 1 "// are supported via this interface."] [396 2 "// Get searches for a ClientSessionState associated with the given key."] [397 2 "// On return, ok is true if one was found."] [400 2 "// Put adds the ClientSessionState to the cache with the given key. It might"] [401 2 "// get called multiple times in a connection if a TLS 1.3 server provides"] [402 2 "// more than one session ticket. If called with a nil *ClientSessionState,"] [403 2 "// it should remove the cache entry."] [407 1 "//go:generate stringer -linecomment -type=SignatureScheme,CurveID,ClientAuthType -output=common_string.go"] [409 1 "// SignatureScheme identifies a signature algorithm supported by TLS. See"] [410 1 "// RFC 8446, Section 4.2.3."] [414 2 "// RSASSA-PKCS1-v1_5 algorithms."] [419 2 "// RSASSA-PSS algorithms with public key OID rsaEncryption."] [424 2 "// ECDSA algorithms. Only constrained to a specific curve in TLS 1.3."] [429 2 "// EdDSA algorithms."] [432 2 "// ML-DSA algorithms."] [437 2 "// Legacy signature and hash algorithms for TLS 1.2."] [442 1 "// ClientHelloInfo contains information from a ClientHello message in order to"] [443 1 "// guide application logic in the GetCertificate and GetConfigForClient callbacks."] [445 2 "// CipherSuites lists the CipherSuites supported by the client (e.g."] [446 2 "// TLS_AES_128_GCM_SHA256, TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256)."] [449 2 "// ServerName indicates the name of the server requested by the client"] [450 2 "// in order to support virtual hosting. ServerName is only set if the"] [451 2 "// client is using SNI (see RFC 4366, Section 3.1)."] [454 2 "// SupportedCurves lists the key exchange mechanisms supported by the"] [455 2 "// client. It was renamed to \"supported groups\" in TLS 1.3, see RFC 8446,"] [456 2 "// Section 4.2.7 and [CurveID]."] [457 2 "//"] [458 2 "// SupportedCurves may be nil in TLS 1.2 and lower if the Supported Elliptic"] [459 2 "// Curves Extension is not being used (see RFC 4492, Section 5.1.1)."] [462 2 "// SupportedPoints lists the point formats supported by the client."] [463 2 "// SupportedPoints is set only if the Supported Point Formats Extension"] [464 2 "// is being used (see RFC 4492, Section 5.1.2)."] [467 2 "// SignatureSchemes lists the signature and hash schemes that the client"] [468 2 "// is willing to verify. SignatureSchemes is set only if the Signature"] [469 2 "// Algorithms Extension is being used (see RFC 5246, Section 7.4.1.4.1)."] [472 2 "// SupportedProtos lists the application protocols supported by the client."] [473 2 "// SupportedProtos is set only if the Application-Layer Protocol"] [474 2 "// Negotiation Extension is being used (see RFC 7301, Section 3.1)."] [475 2 "//"] [476 2 "// Servers can select a protocol by setting Config.NextProtos in a"] [477 2 "// GetConfigForClient return value."] [480 2 "// SupportedVersions lists the TLS versions supported by the client."] [481 2 "// For TLS versions less than 1.3, this is extrapolated from the max"] [482 2 "// version advertised by the client, so values other than the greatest"] [483 2 "// might be rejected if used."] [486 2 "// Extensions lists the IDs of the extensions presented by the client"] [487 2 "// in the ClientHello."] [490 2 "// Conn is the underlying net.Conn for the connection. Do not read"] [491 2 "// from, or write to, this connection; that will cause the TLS"] [492 2 "// connection to fail."] [495 2 "// HelloRetryRequest indicates whether the ClientHello was sent in response"] [496 2 "// to a HelloRetryRequest message."] [499 2 "// config is embedded by the GetCertificate or GetConfigForClient caller,"] [500 2 "// for use with SupportsCertificate."] [503 2 "// isQUIC indicates whether the connection is a QUIC connection."] [506 2 "// ctx is the context of the handshake that is in progress."] [510 1 "// Context returns the context of the handshake that is in progress."] [511 1 "// This context is a child of the context passed to HandshakeContext,"] [512 1 "// if any, and is canceled when the handshake concludes."] [517 1 "// CertificateRequestInfo contains information from a server's"] [518 1 "// CertificateRequest message, which is used to demand a certificate and proof"] [519 1 "// of control from a client."] [521 2 "// AcceptableCAs contains zero or more, DER-encoded, X.501"] [522 2 "// Distinguished Names. These are the names of root or intermediate CAs"] [523 2 "// that the server wishes the returned certificate to be signed by. An"] [524 2 "// empty slice indicates that the server has no preference."] [527 2 "// SignatureSchemes lists the signature schemes that the server is"] [528 2 "// willing to verify."] [531 2 "// Version is the TLS version that was negotiated for this connection."] [534 2 "// ctx is the context of the handshake that is in progress."] [538 1 "// Context returns the context of the handshake that is in progress."] [539 1 "// This context is a child of the context passed to HandshakeContext,"] [540 1 "// if any, and is canceled when the handshake concludes."] [545 1 "// RenegotiationSupport enumerates the different levels of support for TLS"] [546 1 "// renegotiation. TLS renegotiation is the act of performing subsequent"] [547 1 "// handshakes on a connection after the first. This significantly complicates"] [548 1 "// the state machine and has been the source of numerous, subtle security"] [549 1 "// issues. Initiating a renegotiation is not supported, but support for"] [550 1 "// accepting renegotiation requests may be enabled."] [551 1 "//"] [552 1 "// Even when enabled, the server may not change its identity between handshakes"] [553 1 "// (i.e. the leaf certificate must be the same). Additionally, concurrent"] [554 1 "// handshake and application data flow is not permitted so renegotiation can"] [555 1 "// only be used with protocols that synchronise with the renegotiation, such as"] [556 1 "// HTTPS."] [557 1 "//"] [558 1 "// Renegotiation is not defined in TLS 1.3."] [562 2 "// RenegotiateNever disables renegotiation."] [565 2 "// RenegotiateOnceAsClient allows a remote server to request"] [566 2 "// renegotiation once per connection."] [569 2 "// RenegotiateFreelyAsClient allows a remote server to repeatedly"] [570 2 "// request renegotiation."] [574 1 "// A Config structure is used to configure a TLS client or server."] [575 1 "// After one has been passed to a TLS function it must not be"] [576 1 "// modified. A Config may be reused; the tls package will also not"] [577 1 "// modify it."] [579 2 "// Rand provides the source of entropy for the connection."] [580 2 "// If Rand is nil, TLS uses the cryptographic random reader in package"] [581 2 "// crypto/rand. The Reader must be safe for use by multiple goroutines."] [582 2 "//"] [583 2 "// Deprecated: this should be left nil in production. Not all TLS"] [584 2 "// configurations are guaranteed to use Rand. Test code can use"] [585 2 "// [testing/cryptotest.SetGlobalRandom] instead."] [588 2 "// Time returns the current time as the number of seconds since the epoch."] [589 2 "// If Time is nil, TLS uses time.Now."] [592 2 "// Certificates contains one or more certificate chains to present to the"] [593 2 "// other side of the connection. The first certificate compatible with the"] [594 2 "// peer's requirements is selected automatically."] [595 2 "//"] [596 2 "// Server configurations must set one of Certificates, GetCertificate or"] [597 2 "// GetConfigForClient. Clients doing client-authentication may set either"] [598 2 "// Certificates or GetClientCertificate."] [599 2 "//"] [600 2 "// Note: if there are multiple Certificates, and they don't have the"] [601 2 "// optional field Leaf set, certificate selection will incur a significant"] [602 2 "// per-handshake performance cost."] [605 2 "// NameToCertificate maps from a certificate name to an element of"] [606 2 "// Certificates. Note that a certificate name can be of the form"] [607 2 "// '*.example.com' and so doesn't have to be a domain name as such."] [608 2 "//"] [609 2 "// Deprecated: NameToCertificate only allows associating a single"] [610 2 "// certificate with a given name. Leave this field nil to let the library"] [611 2 "// select the first compatible chain from Certificates."] [614 2 "// GetCertificate returns a Certificate based on the given"] [615 2 "// ClientHelloInfo. It will only be called if the client supplies SNI"] [616 2 "// information or if Certificates is empty."] [617 2 "//"] [618 2 "// If GetCertificate is nil or returns nil, then the certificate is"] [619 2 "// retrieved from NameToCertificate. If NameToCertificate is nil, the"] [620 2 "// best element of Certificates will be used."] [621 2 "//"] [622 2 "// Once a Certificate is returned it should not be modified."] [625 2 "// GetClientCertificate, if not nil, is called when a server requests a"] [626 2 "// certificate from a client. If set, the contents of Certificates will"] [627 2 "// be ignored."] [628 2 "//"] [629 2 "// If GetClientCertificate returns an error, the handshake will be"] [630 2 "// aborted and that error will be returned. Otherwise"] [631 2 "// GetClientCertificate must return a non-nil Certificate. If"] [632 2 "// Certificate.Certificate is empty then no certificate will be sent to"] [633 2 "// the server. If this is unacceptable to the server then it may abort"] [634 2 "// the handshake."] [635 2 "//"] [636 2 "// GetClientCertificate may be called multiple times for the same"] [637 2 "// connection if renegotiation occurs or if TLS 1.3 is in use."] [638 2 "//"] [639 2 "// Once a Certificate is returned it should not be modified."] [642 2 "// GetConfigForClient, if not nil, is called after a ClientHello is"] [643 2 "// received from a client. It may return a non-nil Config in order to"] [644 2 "// change the Config that will be used to handle this connection. If"] [645 2 "// the returned Config is nil, the original Config will be used. The"] [646 2 "// Config returned by this callback may not be subsequently modified."] [647 2 "//"] [648 2 "// If GetConfigForClient is nil, the Config passed to Server() will be"] [649 2 "// used for all connections."] [650 2 "//"] [651 2 "// If SessionTicketKey is explicitly set on the returned Config, or if"] [652 2 "// SetSessionTicketKeys is called on the returned Config, those keys will"] [653 2 "// be used. Otherwise, the original Config keys will be used (and possibly"] [654 2 "// rotated if they are automatically managed). WARNING: this allows session"] [655 2 "// resumption of connections originally established with the parent (or a"] [656 2 "// sibling) Config, which may bypass the [Config.VerifyPeerCertificate]"] [657 2 "// value of the returned Config."] [660 2 "// VerifyPeerCertificate, if not nil, is called after normal"] [661 2 "// certificate verification by either a TLS client or server. It"] [662 2 "// receives the raw ASN.1 certificates provided by the peer and also"] [663 2 "// any verified chains that normal processing found. If it returns a"] [664 2 "// non-nil error, the handshake is aborted and that error results."] [665 2 "//"] [666 2 "// If normal verification fails then the handshake will abort before"] [667 2 "// considering this callback. If normal verification is disabled (on the"] [668 2 "// client when InsecureSkipVerify is set, or on a server when ClientAuth is"] [669 2 "// RequestClientCert or RequireAnyClientCert), then this callback will be"] [670 2 "// considered but the verifiedChains argument will always be nil. When"] [671 2 "// ClientAuth is NoClientCert, this callback is not called on the server."] [672 2 "// rawCerts may be empty on the server if ClientAuth is RequestClientCert or"] [673 2 "// VerifyClientCertIfGiven."] [674 2 "//"] [675 2 "// This callback is not invoked on resumed connections. WARNING: this"] [676 2 "// includes connections resumed across Configs returned by [Config.Clone] or"] [677 2 "// [Config.GetConfigForClient] and their parents. If that is not intended,"] [678 2 "// use [Config.VerifyConnection] instead, or set [Config.SessionTicketsDisabled]."] [679 2 "//"] [680 2 "// verifiedChains and its contents should not be modified."] [683 2 "// VerifyConnection, if not nil, is called after normal certificate"] [684 2 "// verification and after VerifyPeerCertificate by either a TLS client"] [685 2 "// or server. If it returns a non-nil error, the handshake is aborted"] [686 2 "// and that error results."] [687 2 "//"] [688 2 "// If normal verification fails then the handshake will abort before"] [689 2 "// considering this callback. This callback will run for all connections,"] [690 2 "// including resumptions, regardless of InsecureSkipVerify or ClientAuth"] [691 2 "// settings."] [694 2 "// RootCAs defines the set of root certificate authorities"] [695 2 "// that clients use when verifying server certificates."] [696 2 "// If RootCAs is nil, TLS uses the host's root CA set."] [699 2 "// NextProtos is a list of supported application level protocols, in"] [700 2 "// order of preference. If both peers support ALPN, the selected"] [701 2 "// protocol will be one from this list, and the connection will fail"] [702 2 "// if there is no mutually supported protocol. If NextProtos is empty"] [703 2 "// or the peer doesn't support ALPN, the connection will succeed and"] [704 2 "// ConnectionState.NegotiatedProtocol will be empty."] [707 2 "// ServerName is used to verify the hostname on the returned"] [708 2 "// certificates unless InsecureSkipVerify is given. It is also included"] [709 2 "// in the client's handshake to support virtual hosting unless it is"] [710 2 "// an IP address."] [713 2 "// ClientAuth determines the server's policy for"] [714 2 "// TLS Client Authentication. The default is NoClientCert."] [717 2 "// ClientCAs defines the set of root certificate authorities"] [718 2 "// that servers use if required to verify a client certificate"] [719 2 "// by the policy in ClientAuth."] [722 2 "// InsecureSkipVerify controls whether a client verifies the server's"] [723 2 "// certificate chain and host name. If InsecureSkipVerify is true, crypto/tls"] [724 2 "// accepts any certificate presented by the server and any host name in that"] [725 2 "// certificate. In this mode, TLS is susceptible to machine-in-the-middle"] [726 2 "// attacks unless custom verification is used. This should be used only for"] [727 2 "// testing or in combination with VerifyConnection or VerifyPeerCertificate."] [730 2 "// CipherSuites is a list of enabled TLS 1.0–1.2 cipher suites. The order of"] [731 2 "// the list is ignored. Note that TLS 1.3 ciphersuites are not configurable."] [732 2 "//"] [733 2 "// If CipherSuites is nil, a safe default list is used. The default cipher"] [734 2 "// suites might change over time."] [737 2 "// PreferServerCipherSuites is a legacy field and has no effect."] [738 2 "//"] [739 2 "// It used to control whether the server would follow the client's or the"] [740 2 "// server's preference. Servers now select the best mutually supported"] [741 2 "// cipher suite based on logic that takes into account inferred client"] [742 2 "// hardware, server hardware, and security."] [743 2 "//"] [744 2 "// Deprecated: PreferServerCipherSuites is ignored."] [747 2 "// SessionTicketsDisabled may be set to true to disable session ticket and"] [748 2 "// PSK (resumption) support. Note that on clients, session ticket support is"] [749 2 "// also disabled if ClientSessionCache is nil."] [752 2 "// SessionTicketKey is used by TLS servers to provide session resumption."] [753 2 "// See RFC 5077 and the PSK mode of RFC 8446. If zero, it will be filled"] [754 2 "// with random data before the first server handshake."] [755 2 "//"] [756 2 "// Deprecated: if this field is left at zero, session ticket keys will be"] [757 2 "// automatically rotated every day and dropped after seven days. For"] [758 2 "// customizing the rotation schedule or synchronizing servers that are"] [759 2 "// terminating connections for the same host, use SetSessionTicketKeys."] [762 2 "// ClientSessionCache is a cache of ClientSessionState entries for TLS"] [763 2 "// session resumption. It is only used by clients."] [766 2 "// UnwrapSession is called on the server to turn a ticket/identity"] [767 2 "// previously produced by [WrapSession] into a usable session."] [768 2 "//"] [769 2 "// UnwrapSession will usually either decrypt a session state in the ticket"] [770 2 "// (for example with [Config.EncryptTicket]), or use the ticket as a handle"] [771 2 "// to recover a previously stored state. It must use [ParseSessionState] to"] [772 2 "// deserialize the session state."] [773 2 "//"] [774 2 "// If UnwrapSession returns an error, the connection is terminated. If it"] [775 2 "// returns (nil, nil), the session is ignored. crypto/tls may still choose"] [776 2 "// not to resume the returned session."] [779 2 "// WrapSession is called on the server to produce a session ticket/identity."] [780 2 "//"] [781 2 "// WrapSession must serialize the session state with [SessionState.Bytes]."] [782 2 "// It may then encrypt the serialized state (for example with"] [783 2 "// [Config.DecryptTicket]) and use it as the ticket, or store the state and"] [784 2 "// return a handle for it."] [785 2 "//"] [786 2 "// If WrapSession returns an error, the connection is terminated."] [787 2 "//"] [788 2 "// Warning: the return value will be exposed on the wire and to clients in"] [789 2 "// plaintext. The application is in charge of encrypting and authenticating"] [790 2 "// it (and rotating keys) or returning high-entropy identifiers. Failing to"] [791 2 "// do so correctly can compromise current, previous, and future connections"] [792 2 "// depending on the protocol version."] [795 2 "// MinVersion contains the minimum TLS version that is acceptable."] [796 2 "//"] [797 2 "// By default, TLS 1.2 is currently used as the minimum. TLS 1.0 is the"] [798 2 "// minimum supported by this package."] [801 2 "// MaxVersion contains the maximum TLS version that is acceptable."] [802 2 "//"] [803 2 "// By default, the maximum version supported by this package is used,"] [804 2 "// which is currently TLS 1.3."] [807 2 "// CurvePreferences contains a set of supported key exchange mechanisms."] [808 2 "// The name refers to elliptic curves for legacy reasons, see [CurveID]."] [809 2 "// The order of the list is ignored, and key exchange mechanisms are chosen"] [810 2 "// from this list using an internal preference order. If empty, the default"] [811 2 "// will be used."] [812 2 "//"] [813 2 "// From Go 1.24, the default includes the [X25519MLKEM768] hybrid"] [814 2 "// post-quantum key exchange. To disable it, set CurvePreferences explicitly"] [815 2 "// or use the GODEBUG=tlsmlkem=0 environment variable."] [816 2 "//"] [817 2 "// From Go 1.26, the default includes the [SecP256r1MLKEM768] and"] [818 2 "// [SecP384r1MLKEM1024] hybrid post-quantum key exchanges, too. To disable"] [819 2 "// them, set CurvePreferences explicitly or use either the"] [820 2 "// GODEBUG=tlsmlkem=0 or the GODEBUG=tlssecpmlkem=0 environment variable."] [823 2 "// DynamicRecordSizingDisabled disables adaptive sizing of TLS records."] [824 2 "// When true, the largest possible TLS record size is always used. When"] [825 2 "// false, the size of TLS records may be adjusted in an attempt to"] [826 2 "// improve latency."] [829 2 "// Renegotiation controls what types of renegotiation are supported."] [830 2 "// The default, none, is correct for the vast majority of applications."] [833 2 "// KeyLogWriter optionally specifies a destination for TLS master secrets"] [834 2 "// in NSS key log format that can be used to allow external programs"] [835 2 "// such as Wireshark to decrypt TLS connections."] [836 2 "// See https://datatracker.ietf.org/doc/draft-ietf-tls-keylogfile/."] [837 2 "// Use of KeyLogWriter compromises security and should only be"] [838 2 "// used for debugging."] [841 2 "// arbace: the fields below are this copy's additions (see VENDORED.md)."] [843 2 "// PostHandshakeAuth, on a client, offers TLS 1.3 post-handshake client"] [844 2 "// authentication (RFC 8446, Section 4.6.2): the post_handshake_auth"] [845 2 "// extension is sent, and a CertificateRequest received after the"] [846 2 "// handshake is answered with a certificate chosen as for one received"] [847 2 "// during it (GetClientCertificate or Certificates)."] [848 2 "//"] [849 2 "// Servers do not use it: a server accepts post-handshake authentication"] [850 2 "// whenever a TLS 1.3 client offers it (see PostHandshakeClientAuth and"] [851 2 "// [Conn.RequestClientCertificate])."] [854 2 "// PostHandshakeClientAuth, on a server, defers client authentication to"] [855 2 "// after the handshake, as OpenSSL's SSL_VERIFY_POST_HANDSHAKE. When it is"] [856 2 "// not NoClientCert and a TLS 1.3 client offered post-handshake"] [857 2 "// authentication, the handshake sends no CertificateRequest, whatever"] [858 2 "// ClientAuth says, and [Conn.RequestClientCertificate] applies this"] [859 2 "// policy. In TLS 1.2, or when the client did not offer it, the handshake"] [860 2 "// applies ClientAuth as usual. When it is NoClientCert,"] [861 2 "// RequestClientCertificate applies ClientAuth."] [864 2 "// PSKClientCallback, on a client, supplies an external pre-shared key"] [865 2 "// as OpenSSL's psk_client_callback. It is called with the server's"] [866 2 "// identity hint, nil when there is none (always nil for TLS 1.3, where it"] [867 2 "// is called while the ClientHello is built), and returns the identity and"] [868 2 "// the key. An empty key offers no PSK. In TLS 1.3 the PSK is offered with"] [869 2 "// psk_dhe_ke and SHA-256 (as for TLS_AES_128_GCM_SHA256); in TLS 1.2 it is"] [870 2 "// used by the PSK cipher suites (RFC 4279), which must be listed in"] [871 2 "// CipherSuites."] [874 2 "// PSKServerCallback, on a server, maps a client's PSK identity to its key,"] [875 2 "// as OpenSSL's psk_server_callback. A nil key rejects the identity. A"] [876 2 "// server with PSKServerCallback set needs no certificate for the TLS 1.2"] [877 2 "// PSK cipher suites (which must be listed in CipherSuites) nor for TLS 1.3"] [878 2 "// external PSK handshakes."] [881 2 "// PSKIdentityHint is the identity hint a TLS 1.2 PSK server sends in its"] [882 2 "// ServerKeyExchange message; none is sent when it is empty."] [885 2 "// EncryptedClientHelloConfigList is a serialized ECHConfigList. If"] [886 2 "// provided, clients will attempt to connect to servers using Encrypted"] [887 2 "// Client Hello (ECH) using one of the provided ECHConfigs."] [888 2 "//"] [889 2 "// Servers do not use this field. In order to configure ECH for servers, see"] [890 2 "// the EncryptedClientHelloKeys field."] [891 2 "//"] [892 2 "// If the list contains no valid ECH configs, the handshake will fail"] [893 2 "// and return an error."] [894 2 "//"] [895 2 "// If EncryptedClientHelloConfigList is set, MinVersion, if set, must"] [896 2 "// be VersionTLS13."] [897 2 "//"] [898 2 "// When EncryptedClientHelloConfigList is set, the handshake will only"] [899 2 "// succeed if ECH is successfully negotiated. If the server rejects ECH,"] [900 2 "// an ECHRejectionError error will be returned, which may contain a new"] [901 2 "// ECHConfigList that the server suggests using."] [902 2 "//"] [903 2 "// How this field is parsed may change in future Go versions, if the"] [904 2 "// encoding described in the final Encrypted Client Hello RFC changes."] [907 2 "// EncryptedClientHelloRejectionVerify, if not nil, is called when ECH is"] [908 2 "// rejected by the remote server, in order to verify the ECH provider"] [909 2 "// certificate in the outer ClientHello. If it returns a non-nil error, the"] [910 2 "// handshake is aborted and that error results."] [911 2 "//"] [912 2 "// On the server side this field is not used."] [913 2 "//"] [914 2 "// Unlike VerifyPeerCertificate and VerifyConnection, normal certificate"] [915 2 "// verification will not be performed before calling"] [916 2 "// EncryptedClientHelloRejectionVerify."] [917 2 "//"] [918 2 "// If EncryptedClientHelloRejectionVerify is nil and ECH is rejected, the"] [919 2 "// roots in RootCAs will be used to verify the ECH providers public"] [920 2 "// certificate. VerifyPeerCertificate and VerifyConnection are not called"] [921 2 "// when ECH is rejected, even if set, and InsecureSkipVerify is ignored."] [924 2 "// GetEncryptedClientHelloKeys, if not nil, is called when by a server when"] [925 2 "// a client attempts ECH."] [926 2 "//"] [927 2 "// If GetEncryptedClientHelloKeys is not nil, [EncryptedClientHelloKeys] is"] [928 2 "// ignored."] [929 2 "//"] [930 2 "// If GetEncryptedClientHelloKeys returns an error, the handshake will be"] [931 2 "// aborted and the error will be returned. Otherwise,"] [932 2 "// GetEncryptedClientHelloKeys must return a non-nil slice of"] [933 2 "// [EncryptedClientHelloKey] that represents the acceptable ECH keys."] [934 2 "//"] [935 2 "// For further details, see [EncryptedClientHelloKeys]."] [938 2 "// EncryptedClientHelloKeys are the ECH keys to use when a client"] [939 2 "// attempts ECH."] [940 2 "//"] [941 2 "// If EncryptedClientHelloKeys is set, MinVersion, if set, must be"] [942 2 "// VersionTLS13."] [943 2 "//"] [944 2 "// If a client attempts ECH, but it is rejected by the server, the server"] [945 2 "// will send a list of configs to retry based on the set of"] [946 2 "// EncryptedClientHelloKeys which have the SendAsRetry field set."] [947 2 "//"] [948 2 "// If GetEncryptedClientHelloKeys is non-nil, EncryptedClientHelloKeys is"] [949 2 "// ignored."] [950 2 "//"] [951 2 "// On the client side, this field is ignored. In order to configure ECH for"] [952 2 "// clients, see the EncryptedClientHelloConfigList field."] [955 2 "// mutex protects sessionTicketKeys and autoSessionTicketKeys."] [957 2 "// sessionTicketKeys contains zero or more ticket keys. If set, it means"] [958 2 "// the keys were set with SessionTicketKey or SetSessionTicketKeys. The"] [959 2 "// first key is used for new tickets and any subsequent keys can be used to"] [960 2 "// decrypt old tickets. The slice contents are not protected by the mutex"] [961 2 "// and are immutable."] [963 2 "// autoSessionTicketKeys is like sessionTicketKeys but is owned by the"] [964 2 "// auto-rotation logic. See Config.ticketKeys."] [968 1 "// EncryptedClientHelloKey holds a private key that is associated"] [969 1 "// with a specific ECH config known to a client."] [971 2 "// Config should be a marshalled ECHConfig associated with PrivateKey. This"] [972 2 "// must match the config provided to clients byte-for-byte. The config must"] [973 2 "// use as KEM one of"] [974 2 "//"] [975 2 "//   - DHKEM(P-256, HKDF-SHA256) (0x0010)"] [976 2 "//   - DHKEM(P-384, HKDF-SHA384) (0x0011)"] [977 2 "//   - DHKEM(P-521, HKDF-SHA512) (0x0012)"] [978 2 "//   - DHKEM(X25519, HKDF-SHA256) (0x0020)"] [979 2 "//   - ML-KEM-768 (0x0041)"] [980 2 "//   - ML-KEM-1024 (0x0042)"] [981 2 "//   - MLKEM768-P256 (0x0050)"] [982 2 "//   - MLKEM1024-P384 (0x0051)"] [983 2 "//   - MLKEM768-X25519 (0x647a)"] [984 2 "//"] [985 2 "// and as KDF one of"] [986 2 "//"] [987 2 "//   - HKDF-SHA256 (0x0001)"] [988 2 "//   - HKDF-SHA384 (0x0002)"] [989 2 "//   - HKDF-SHA512 (0x0003)"] [990 2 "//"] [991 2 "// and as AEAD one of"] [992 2 "//"] [993 2 "//   - AES-128-GCM (0x0001)"] [994 2 "//   - AES-256-GCM (0x0002)"] [995 2 "//   - ChaCha20Poly1305 (0x0003)"] [996 2 "//"] [998 2 "// PrivateKey should be a marshalled private key, in the format expected by"] [999 2 "// HPKE's DeserializePrivateKey (see RFC 9180), for the KEM used in Config."] [1001 2 "// SendAsRetry indicates if Config should be sent as part of the list of"] [1002 2 "// retry configs when ECH is requested by the client but rejected by the"] [1003 2 "// server."] [1008 2 "// ticketKeyLifetime is how long a ticket key remains valid and can be used to"] [1009 2 "// resume a client connection."] [1010 41 "// 7 days"] [1012 2 "// ticketKeyRotation is how often the server should rotate the session ticket key"] [1013 2 "// that is used for new tickets."] [1017 1 "// ticketKey is the internal representation of a session ticket key."] [1021 2 "// created is the time at which this ticket key was created. See Config.ticketKeys."] [1025 1 "// ticketKeyFromBytes converts from the external representation of a session"] [1026 1 "// ticket key to a ticketKey. Externally, session ticket keys are 32 random"] [1027 1 "// bytes and this function expands that into sufficient name and key material."] [1030 2 "// The first 16 bytes of the hash used to be exposed on the wire as a ticket"] [1031 2 "// prefix. They MUST NOT be used as a secret. In the future, it would make"] [1032 2 "// sense to use a proper KDF here, like HKDF with a fixed salt."] [1040 1 "// maxSessionTicketLifetime is the maximum allowed lifetime of a TLS 1.3 session"] [1041 1 "// ticket, and the lifetime we set for all tickets we send."] [1044 1 "// Clone returns a shallow clone of c or nil if c is nil. It is safe to clone a"] [1045 1 "// [Config] that is being used concurrently by a TLS client or server."] [1046 1 "//"] [1047 1 "// The returned Config can share session ticket keys with the original Config,"] [1048 1 "// which means connections could be resumed across the two Configs. WARNING:"] [1049 1 "// [Config.VerifyPeerCertificate] does not get called on resumed connections,"] [1050 1 "// including connections that were originally established on the parent Config."] [1051 1 "// If that is not intended, use [Config.VerifyConnection] instead, or set"] [1052 1 "// [Config.SessionTicketsDisabled]."] [1102 1 "// deprecatedSessionTicketKey is set as the prefix of SessionTicketKey if it was"] [1103 1 "// randomized for backwards compatibility but is not in use."] [1106 1 "// initLegacySessionTicketKeyRLocked ensures the legacy SessionTicketKey field is"] [1107 1 "// randomized if empty, and that sessionTicketKeys is populated from it otherwise."] [1109 2 "// Don't write if SessionTicketKey is already defined as our deprecated string,"] [1110 2 "// or if it is defined by the user but sessionTicketKeys is already set."] [1116 2 "// We need to write some data, so get an exclusive lock and re-check any conditions."] [1125 3 "// Write the deprecated prefix at the beginning so we know we created"] [1126 3 "// it. This key with the DEPRECATED prefix isn't used as an actual"] [1127 3 "// session ticket key, and is only randomized in case the application"] [1128 3 "// reuses it for some reason."] [1135 1 "// ticketKeys returns the ticketKeys for this connection."] [1136 1 "// If configForClient has explicitly set keys, those will"] [1137 1 "// be returned. Otherwise, the keys on c will be used and"] [1138 1 "// may be rotated if auto-managed."] [1139 1 "// During rotation, any expired session ticket keys are deleted from"] [1140 1 "// c.sessionTicketKeys. If the session ticket key that is currently"] [1141 1 "// encrypting tickets (ie. the first ticketKey in c.sessionTicketKeys)"] [1142 1 "// is not fresh, then a new session ticket key will be"] [1143 1 "// created and prepended to c.sessionTicketKeys."] [1145 2 "// If the ConfigForClient callback returned a Config with explicitly set"] [1146 2 "// keys, use those, otherwise just use the original Config."] [1171 2 "// Fast path for the common case where the key is fresh enough."] [1176 2 "// autoSessionTicketKeys are managed by auto-rotation."] [1181 2 "// Re-check the condition in case it changed since obtaining the new lock."] [1190 4 "// While rotating the current key, also remove any expired ones."] [1200 1 "// SetSessionTicketKeys updates the session ticket keys for a server."] [1201 1 "//"] [1202 1 "// The first key will be used when creating new tickets, while all keys can be"] [1203 1 "// used for decrypting tickets. It is safe to call this function while the"] [1204 1 "// server is running in order to rotate the session ticket keys. The function"] [1205 1 "// will panic if keys is empty."] [1206 1 "//"] [1207 1 "// Calling this function will turn off automatic session ticket key rotation."] [1208 1 "//"] [1209 1 "// If multiple servers are terminating connections for the same host they should"] [1210 1 "// all have the same session ticket keys. If the session ticket keys leaks,"] [1211 1 "// previously recorded and future TLS connections using those keys might be"] [1212 1 "// compromised."] [1262 1 "// supportedCipherSuites returns the supported TLS 1.0–1.2 cipher suites in an"] [1263 1 "// undefined order. For preference ordering, use [Config.cipherSuites]."] [1275 1 "// roleClient and roleServer are meant to call supportedVersions and parents"] [1276 1 "// with more readability at the callsite."] [1280 1 "// supportedVersions returns the list of supported TLS versions, sorted from"] [1281 1 "// highest to lowest (and hence also in preference order)."] [1316 1 "// supportedVersionsFromMax returns a list of supported versions derived from a"] [1317 1 "// legacy maximum version value. Note that only versions supported by this"] [1318 1 "// library are returned. Any newer peer will use supportedVersions anyway."] [1341 3 "// Ignore unimplemented entries in c.CurvePreferences."] [1359 1 "// mutualVersion returns the protocol version to use given the advertised"] [1360 1 "// versions of the peer. The highest supported version is preferred."] [1371 1 "// errNoCertificates should be an internal detail,"] [1372 1 "// but widely used packages access it using linkname."] [1373 1 "// Notable members of the hall of shame include:"] [1374 1 "//   - github.com/xtls/xray-core"] [1375 1 "//"] [1376 1 "// Do not remove or change the type signature."] [1377 1 "// See go.dev/issue/67401."] [1378 1 "//"] [1379 1 "//go:linkname errNoCertificates"] [1382 1 "// getCertificate returns the best certificate for the given ClientHelloInfo,"] [1383 1 "// defaulting to the first element of c.Certificates."] [1398 3 "// There's only one choice, so no point doing any work."] [1423 2 "// If nothing matches, return the first certificate."] [1427 1 "// SupportsCertificate returns nil if the provided certificate is supported by"] [1428 1 "// the client that sent the ClientHello. Otherwise, it returns an error"] [1429 1 "// describing the reason for the incompatibility."] [1430 1 "//"] [1431 1 "// If this [ClientHelloInfo] was passed to a GetConfigForClient or GetCertificate"] [1432 1 "// callback, this method will take into account the associated [Config]. Note that"] [1433 1 "// if GetConfigForClient returns a different [Config], the change can't be"] [1434 1 "// accounted for by this method."] [1435 1 "//"] [1436 1 "// This function will call x509.ParseCertificate unless c.Leaf is set, which can"] [1437 1 "// incur a significant performance cost."] [1439 2 "// Note we don't currently support certificate_authorities nor"] [1440 2 "// signature_algorithms_cert, and don't check the algorithms of the"] [1441 2 "// signatures on the chain (which anyway are a SHOULD, see RFC 8446,"] [1442 2 "// Section 4.4.2.2)."] [1453 2 "// If the client specified the name they are trying to connect to, the"] [1454 2 "// certificate needs to be valid for it."] [1465 2 "// supportsRSAFallback returns nil if the certificate and connection support"] [1466 2 "// the static RSA key exchange, and unsupported otherwise. The logic for"] [1467 2 "// supporting static RSA is completely disjoint from the logic for"] [1468 2 "// supporting signed key exchanges, so we just check it as a fallback."] [1470 3 "// TLS 1.3 dropped support for the static RSA key exchange."] [1474 3 "// The static RSA key exchange works by decrypting a challenge with the"] [1475 3 "// RSA private key, not by signing, so check the PrivateKey implements"] [1476 3 "// crypto.Decrypter, like *rsa.PrivateKey does."] [1484 3 "// Finally, there needs to be a mutual cipher suite that uses the static"] [1485 3 "// RSA key exchange instead of ECDHE."] [1501 2 "// If the client sent the signature_algorithms extension, ensure it supports"] [1502 2 "// schemes we can use with this certificate and TLS version."] [1509 2 "// In TLS 1.3 we are done because supported_groups is only relevant to the"] [1510 2 "// ECDHE computation, point format negotiation is removed, cipher suites are"] [1511 2 "// only relevant to the AEAD choice, and static RSA does not exist."] [1516 2 "// The only signed key exchange we support is ECDHE."] [1557 4 "// ML-DSA requires TLS 1.3, which we already excluded above."] [1567 2 "// Make sure that there is a mutually supported cipher suite that works with"] [1568 2 "// this certificate. Cipher suite selection will then apply the logic in"] [1569 2 "// reverse to pick it. See also serverHandshakeState.cipherSuiteOk."] [1595 1 "// SupportsCertificate returns nil if the provided certificate is supported by"] [1596 1 "// the server that sent the CertificateRequest. Otherwise, it returns an error"] [1597 1 "// describing the reason for the incompatibility."] [1609 3 "// Parse the certificate if this isn't the leaf node, or if"] [1610 3 "// chain.Leaf was nil."] [1627 1 "// BuildNameToCertificate parses c.Certificates and builds c.NameToCertificate"] [1628 1 "// from the CommonName and SubjectAlternateName fields of each of the leaf"] [1629 1 "// certificates."] [1630 1 "//"] [1631 1 "// Deprecated: NameToCertificate only allows associating a single certificate"] [1632 1 "// with a given name. Leave that field nil to let the library select the first"] [1633 1 "// compatible chain from Certificates."] [1642 3 "// If SANs are *not* present, some clients will consider the certificate"] [1643 3 "// valid for the name in the Common Name."] [1659 49 "// arbace: as OpenSSL"] [1679 1 "// writerMutex protects all KeyLogWriters globally. It is rarely enabled,"] [1680 1 "// and is only for debugging, so a global mutex saves space."] [1683 1 "// A Certificate is a chain of one or more certificates, leaf first."] [1686 2 "// PrivateKey contains the private key corresponding to the public key in"] [1687 2 "// Leaf. This must implement [crypto.Signer] with an RSA, ECDSA, Ed25519"] [1688 2 "// (TLS 1.2+), or ML-DSA (TLS 1.3) PublicKey."] [1689 2 "//"] [1690 2 "// For a server up to TLS 1.2, it can also implement crypto.Decrypter with"] [1691 2 "// an RSA PublicKey."] [1692 2 "//"] [1693 2 "// If it implements [crypto.MessageSigner], SignMessage will be used instead"] [1694 2 "// of Sign for TLS 1.2 and later."] [1696 2 "// SupportedSignatureAlgorithms is an optional list restricting what"] [1697 2 "// signature algorithms the PrivateKey can be used for."] [1699 2 "// OCSPStaple contains an optional OCSP response which will be served"] [1700 2 "// to clients that request it."] [1702 2 "// SignedCertificateTimestamps contains an optional list of Signed"] [1703 2 "// Certificate Timestamps which will be served to clients that request it."] [1705 2 "// Leaf is the parsed form of the leaf certificate, which may be initialized"] [1706 2 "// using x509.ParseCertificate to reduce per-handshake processing. If nil,"] [1707 2 "// the leaf certificate will be parsed as needed."] [1711 1 "// leaf returns the parsed leaf certificate, either from c.Leaf or by parsing"] [1712 1 "// the corresponding c.Certificate[0]."] [1728 2 "// originalBytes should return the original bytes that were passed to"] [1729 2 "// unmarshal to create the message. If the message was not produced by"] [1730 2 "// unmarshal, it should return nil."] [1734 1 "// lruSessionCache is a ClientSessionCache implementation that uses an LRU"] [1735 1 "// caching strategy."] [1749 1 "// NewLRUClientSessionCache returns a [ClientSessionCache] with the given"] [1750 1 "// capacity that uses an LRU strategy. If capacity is < 1, a default capacity"] [1751 1 "// is used instead."] [1765 1 "// Put adds the provided (sessionKey, cs) pair to the cache. If cs is nil, the entry"] [1766 1 "// corresponding to sessionKey is removed from the cache instead."] [1798 1 "// Get returns the [ClientSessionState] value associated with a given key. It"] [1799 1 "// returns (nil, false) if no value is found."] [1823 1 "// supportedSignatureAlgorithms returns the supported signature algorithms for"] [1824 1 "// the given range of TLS versions, to advertise in ClientHello and"] [1825 1 "// CertificateRequest messages. An algorithm is included if it is enabled at any"] [1826 1 "// version in the range."] [1851 3 "// ML-DSA is not available in FIPS 140-3 module v1.0.0."] [1855 3 "// ML-DSA codepoints are only defined for TLS 1.3."] [1861 2 "// For the _cert extension we include all algorithms, including SHA-1 and"] [1862 2 "// PKCS#1 v1.5, because it's more likely that something on our side will be"] [1863 2 "// willing to accept a *-with-SHA1 certificate (e.g. with a custom"] [1864 2 "// VerifyConnection or by a direct match with the CertPool), than that the"] [1865 2 "// peer would have a better certificate but is just choosing not to send it."] [1866 2 "// crypto/x509 will refuse to verify important SHA-1 signatures anyway."] [1871 2 "// TLS 1.3 removed support for PKCS#1 v1.5 and SHA-1 signatures,"] [1872 2 "// and Go 1.25 removed support for SHA-1 signatures in TLS 1.2."] [1888 1 "// supportedSignatureAlgorithmsCert returns the supported algorithms for"] [1889 1 "// signatures in certificates."] [1906 1 "// CertificateVerificationError is returned when certificate verification fails during the handshake."] [1908 2 "// UnverifiedCertificates and its contents should not be modified."] [1921 1 "// fipsAllowedChains returns chains that are allowed to be used in a TLS connection"] [1922 1 "// based on the current fips140tls enforcement setting."] [1923 1 "//"] [1924 1 "// If fips140tls is not required, the chains are returned as-is with no processing."] [1925 1 "// Otherwise, the returned chains are filtered to only those allowed by FIPS 140-3."] [1926 1 "// If this results in no chains it returns an error."] [1960 1 "// anyValidVerifiedChain reports if at least one of the chains in verifiedChains"] [1961 1 "// is valid, as indicated by none of the certificates being expired and the root"] [1962 1 "// being in opts.Roots (or in the system root pool if opts.Roots is nil). If"] [1963 1 "// verifiedChains is empty, it returns false."] [1974 3 "// Since we already validated the chain, we only care that it is rooted"] [1975 3 "// in a CA in opts.Roots. On platforms where we control chain validation"] [1976 3 "// (e.g. not Windows or macOS) this is a simple lookup in the CertPool"] [1977 3 "// internal hash map, which we can simulate by running Verify on the"] [1978 3 "// root. On other platforms, we have to do full verification again,"] [1979 3 "// because EKU handling might differ. We will want to replace this with"] [1980 3 "// CertPool.Contains if/once that is available. See go.dev/issue/77376."]] :go/pos {:name [5 9] :package [5 1]} :go/semis [[1122 60] [1184 48] [1404 43] [1411 52] [1418 51] [1460 52] [1477 49] [1478 46] [1504 68] [1526 45] [1599 74] [1613 50] [1771 32] [1804 32] [1833 19] [1833 33] [1893 19] [1893 33] [1987 34] [1992 34]] :go/trails [[236 48] [1098 63] [1272 14] [1761 21]]} (go/file "common.go" :imports [



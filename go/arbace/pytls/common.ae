^{:go/pos {:doc [545 1] :tok-pos [559 1]}} (go/type ^{:go/pos {:name-pos [559 6]}} RenegotiationSupport "RenegotiationSupport enumerates the different levels of support for TLS\nrenegotiation. TLS renegotiation is the act of performing subsequent\nhandshakes on a connection after the first. This significantly complicates\nthe state machine and has been the source of numerous, subtle security\nissues. Initiating a renegotiation is not supported, but support for\naccepting renegotiation requests may be enabled.\n\nEven when enabled, the server may not change its identity between handshakes\n(i.e. the leaf certificate must be the same). Additionally, concurrent\nhandshake and application data flow is not permitted so renegotiation can\nonly be used with protocols that synchronise with the renegotiation, such as\nHTTPS.\n\nRenegotiation is not defined in TLS 1.3.\n" ^{:go/pos {:name-pos [559 27]}} int)

^{:go/pos {:lparen [561 7] :rparen [572 1] :tok-pos [561 1]}} (go/const

  [^{:tag ^{:go/pos {:name-pos [563 19]}} RenegotiationSupport :val 0 :doc "RenegotiateNever disables renegotiation.\n" :go/pos {:name-pos [563 2]}} RenegotiateNever ^{:go/pos {:name-pos [563 42]}} iota]



  [^{:val 1 :doc "RenegotiateOnceAsClient allows a remote server to request\nrenegotiation once per connection.\n" :go/pos {:name-pos [567 2]}} RenegotiateOnceAsClient]



  [^{:val 2 :doc "RenegotiateFreelyAsClient allows a remote server to repeatedly\nrequest renegotiation.\n" :go/pos {:name-pos [571 2]}} RenegotiateFreelyAsClient])







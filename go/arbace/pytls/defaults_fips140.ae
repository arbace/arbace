      ^{:go/pos {:name-pos [38 3]}} SecP384r1MLKEM1024
      ^{:go/pos {:name-pos [39 3]}} MLKEM1024
      ^{:go/pos {:name-pos [40 3]}} CurveP256
      ^{:go/pos {:name-pos [41 3]}} CurveP384

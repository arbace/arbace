  [^{:go/pos {:name-pos [44 2]}} allowedSignatureAlgorithmsFIPS ^{:go/pos {:lbrace [44 52] :rbrace [58 2]}} (lit ^{:go/pos {:lbrack [44 35]}} (slice ^{:go/pos {:name-pos [44 37]}} SignatureScheme)
      ^{:go/pos {:name-pos [45 3]}} PSSWithSHA256
      ^{:go/pos {:name-pos [46 3]}} ECDSAWithP256AndSHA256
      ^{:go/pos {:name-pos [47 3]}} Ed25519
      ^{:go/pos {:name-pos [48 3]}} MLDSA44
      ^{:go/pos {:name-pos [49 3]}} MLDSA65
      ^{:go/pos {:name-pos [50 3]}} MLDSA87
      ^{:go/pos {:name-pos [51 3]}} PSSWithSHA384
      ^{:go/pos {:name-pos [52 3]}} PSSWithSHA512
      ^{:go/pos {:name-pos [53 3]}} PKCS1WithSHA256
      ^{:go/pos {:name-pos [54 3]}} PKCS1WithSHA384
      ^{:go/pos {:name-pos [55 3]}} PKCS1WithSHA512
      ^{:go/pos {:name-pos [56 3]}} ECDSAWithP384AndSHA384
      ^{:go/pos {:name-pos [57 3]}} ECDSAWithP521AndSHA512)]

  [^{:go/pos {:name-pos [59 2]}} allowedCipherSuitesFIPS ^{:go/pos {:lbrace [59 36] :rbrace [66 2]}} (lit ^{:go/pos {:lbrack [59 28]}} (slice ^{:go/pos {:name-pos [59 30]}} uint16)
      ^{:go/pos {:name-pos [60 3]}} TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
      ^{:go/pos {:name-pos [61 3]}} TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
      ^{:go/pos {:name-pos [62 3]}} TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
      ^{:go/pos {:name-pos [63 3]}} TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
      ^{:go/pos {:name-pos [64 3]}} TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256
      ^{:go/pos {:name-pos [65 3]}} TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256)]

  [^{:go/pos {:name-pos [67 2]}} allowedCipherSuitesTLS13FIPS ^{:go/pos {:lbrace [67 41] :rbrace [70 2]}} (lit ^{:go/pos {:lbrack [67 33]}} (slice ^{:go/pos {:name-pos [67 35]}} uint16)
      ^{:go/pos {:name-pos [68 3]}} TLS_AES_128_GCM_SHA256
      ^{:go/pos {:name-pos [69 3]}} TLS_AES_256_GCM_SHA384)])



^{:go/pos {:func [73 1] :lbrace [73 57] :rbrace [87 1]}} (go/func ^{:go/pos {:name-pos [73 6]}} isCertificateAllowedFIPS ^{:tag ^{:go/pos {:name-pos [73 52]}} bool :go/pos {:closing [73 50] :opening [73 30]}} [^{:tag ^{:go/pos {:star [73 33]}} (* ^{:go/pos {:dot [73 38] :name-pos [73 39] :x-pos [73 34]}} x509/Certificate) :go/pos {:name-pos [73 31]}} c]

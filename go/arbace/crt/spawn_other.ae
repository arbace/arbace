;; crt: a signal's end of the runner's process (spawn.ae) where syscall has no setrlimit(2) or rt_sigaction(2) (TamaGo's box;
;; spawn_linux.ae elsewhere): the signal sent as it is, then the shell's 128 + sig.
(in-ns 'go.arbace.crt) (go/file "spawn_other.go" :build ["//go:build !linux"] :imports [
    [os "os"]
    [syscall "syscall"]
    [time "time"]])

(go/func DieBy "DieBy ends the runner's process by the signal sig where it can (no core dump limit or signal action to set here),\nelse with the shell's 128 + sig.\n" [^int sig]
  (syscall/Kill (os/Getpid) (conv syscall/Signal sig))
  (time/Sleep time/Second)
  (os/Exit (+ 128 sig)))

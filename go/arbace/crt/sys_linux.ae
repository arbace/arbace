;; ci's system calls that TamaGo's syscall spells otherwise (queue 214, a REQUEST for C's owner: crt listed in goi's table, checked
;; in its tamago configurations too; sys_other.ae there): Linux's.
(in-ns 'go.arbace.crt) (go/file "sys_linux.go" :build ["//go:build linux"] :imports [
    [os "os"]
    [syscall "syscall"]])

(go/func sysAccess ^error [^string p ^uint32 mode]
  (syscall/Access p mode))

(go/func statSec "statSec is st's access (0), modification (1) or change (2) time's seconds.\n" ^int64 [^{:tag (* syscall/Stat_t)} st ^int i]
  (switch i
    (case [0] (return (.-Sec (.-Atim st))))
    (case [1] (return (.-Sec (.-Mtim st)))))
  (.-Sec (.-Ctim st)))

(go/func statNsec "statNsec is statSec's nanoseconds.\n" ^int64 [^{:tag (* syscall/Stat_t)} st ^int i]
  (switch i
    (case [0] (return (.-Nsec (.-Atim st))))
    (case [1] (return (.-Nsec (.-Mtim st)))))
  (.-Nsec (.-Ctim st)))

(go/func pwriteInPlace "pwriteInPlace writes b to f at off whatever its description's O_APPEND (Sys.WriteBack, queue 310): Go's WriteAt refuses
an append-mode file and Linux's pwrite on an O_APPEND descriptor appends, so the host description's O_APPEND is cleared around the
pwrite and put back (the program's threads run one at a time).
" [^{:tag (* os/File)} f ^{:tag (slice byte)} b ^int64 off] :results [int error]
  (let [(values rc err) (.SyscallConn f)]
    (when (!= err nil)
      (return 0 err))

    (let [^int n 0
          ^error werr nil
          cerr (.Control rc (fn [^uintptr fd]
                  (let [(values fl _ e) (syscall/Syscall syscall/SYS_FCNTL fd syscall/F_GETFL 0)]
                    (when (!= e 0)
                      (set! werr e)
                      (return))

                    (when (!= (bit-and fl syscall/O_APPEND) 0)
                      (syscall/Syscall syscall/SYS_FCNTL fd syscall/F_SETFL (bit-and-not fl syscall/O_APPEND))
                      (defer (syscall/Syscall syscall/SYS_FCNTL fd syscall/F_SETFL fl)))

                    (set! (values n werr) (syscall/Pwrite (conv int fd) b off)))))]
      (when (!= cerr nil)
        (return 0 cerr))

      (when (< n 0)
        (set! n 0))

      (return n werr))))

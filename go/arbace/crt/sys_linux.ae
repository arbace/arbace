;; ci's system calls that TamaGo's syscall spells otherwise (queue 214, a REQUEST for C's owner: crt listed in goi's table, checked
;; in its tamago configurations too; sys_other.ae there): Linux's.
(in-ns 'go.arbace.crt) (go/file "sys_linux.go" :build ["//go:build linux"] :imports [
    [syscall "syscall"]])

(go/func sysAccess ^error [^string p ^uint32 mode]
  (syscall/Access p mode))

(go/func statSec "statSec is st's access (0), modification (1) or change (2) time's seconds.\n" ^int64 [^{:tag (* syscall/Stat_t)} st ^int i]
  (switch i
    (case [0] (return (.-Sec (.-Atim st))))
    (case [1] (return (.-Sec (.-Mtim st)))))
  (.-Sec (.-Ctim st)))

(go/func statNsec "statNsec is statSec's nanoseconds.\n" ^int64 [^{:tag (* syscall/Stat_t)} st ^int i]
  (switch i
    (case [0] (return (.-Nsec (.-Atim st))))
    (case [1] (return (.-Nsec (.-Mtim st)))))
  (.-Nsec (.-Ctim st)))

;; ci's system calls that TamaGo's syscall spells otherwise (queue 214, a REQUEST for C's owner: crt listed in goi's table, checked
;; in its tamago configurations too; sys_other.ae there): Linux's.
(in-ns 'go.arbace.crt) (go/file "sys_linux.go" :build ["//go:build linux"] :imports [
    [syscall "syscall"]])

(go/func sysAccess ^error [^string p ^uint32 mode]
  (syscall/Access p mode))

(go/func statSec "statSec is st's access (0), modification (1) or change (2) time's seconds.\n" ^int64 [^{:tag (* syscall/Stat_t)} st ^int i]
  (switch i
    (case [0] (return (.-Sec (.-Atim st))))
    (case [1] (return (.-Sec (.-Mtim st)))))
  (.-Sec (.-Ctim st)))

(go/func statNsec "statNsec is statSec's nanoseconds.\n" ^int64 [^{:tag (* syscall/Stat_t)} st ^int i]
  (switch i
    (case [0] (return (.-Nsec (.-Atim st))))
    (case [1] (return (.-Nsec (.-Mtim st)))))
  (.-Nsec (.-Ctim st)))


(go/func hostAlloc "hostAlloc is size zero bytes of the host's demand-zero memory (Reserve, queue 311): an anonymous private MAP_NORESERVE\nmapping, whose pages the host allocates at their first touch; nil when the host refuses it.\n" ^{:tag (slice byte)} [^uint64 size]
  (let [(values b err) (syscall/Mmap -1 0 (conv int size) (bit-or syscall/PROT_READ syscall/PROT_WRITE) (bit-or syscall/MAP_PRIVATE syscall/MAP_ANON syscall/MAP_NORESERVE))]
    (when (!= err nil)
      (return nil))

    b))


(go/func hostFree "hostFree returns hostAlloc's mapping b to the host.\n" [^{:tag (slice byte)} b]
  (syscall/Munmap b))


(go/func hostZero "hostZero frees the host's whole pages of b[lo:hi] (hostAlloc's mapping), which then read as zeros (MADV_DONTNEED): the\nrange [l, h) it freed (l == h: none).\n" [^{:tag (slice byte)} b ^uint64 lo ^uint64 hi] :results [^uint64 l ^uint64 h]
  (let [ps (conv uint64 (syscall/Getpagesize))
        fl (bit-and-not (- (+ lo ps) 1) (- ps 1))
        fh (bit-and-not hi (- ps 1))]
    (when (or (>= fl fh) (!= (syscall/Madvise (subslice b fl fh) syscall/MADV_DONTNEED) nil))
      (return 0 0))

    (return fl fh)))

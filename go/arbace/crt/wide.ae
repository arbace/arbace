^{:go/end 358} (go/func WParse "WParse parses a decimal or 0x hex integer with an optional leading '-', wrapped to t.\n" [^WType t ^string s] :results [Wide bool]
  (let [neg false]
    (cond (strings/HasPrefix s "-")
      (set! (values neg s) (values true (subslice s 1)))
      (strings/HasPrefix s "+")
      (set! s (subslice s 1)))

    (let [base 10]
      (when (or (strings/HasPrefix s "0x") (strings/HasPrefix s "0X"))
        (set! (values base s) (values 16 (subslice s 2))))

      (when (or (== s "") (strings/ContainsAny s "+-_ "))
        (return nil false))

      (let [(values b ok) (.SetString (new big/Int) s base)]
        (when (not ok)
          (return nil false))

        (when neg
          (.Neg b b))

        (return (.fromBig t b) true)))))




        (values bn bc bm be) (qun b)]
    (when sub
      (set! bn (not bn)))
    (when (or (== ac 2) (== bc 2))
      (return (qnan)))
    (when (== ac 1)
      (when (and (== bc 1) (!= an bn))
        (return (qnan)))
      (return (qinf an)))
    (when (== bc 1)
      (return (qinf bn)))
    (let [e ae]
      (when (< be e)
        (set! e be))
      (let [x (.Lsh (new big/Int) am (conv uint (- ae e)))
            y (.Lsh (new big/Int) bm (conv uint (- be e)))]

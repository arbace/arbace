          (.Neg x x))
        (when bn
          (.Neg y y))
        (.Add x x y)
        (when (== (.Sign x) 0)
          ;; an exact zero: -0 only from two negative zeros, or downward
          (return (qpk (or (and an bn (== (.Sign am) 0) (== (.Sign bm) 0)) (and (== RoundMode 1) (or (!= an bn) (!= (.Sign am) 0)))) x 0)))
        (let [neg (< (.Sign x) 0)]
          (return (qpk neg (.Abs x x) e)))))))

(go/func qMul "qMul is a*b in binary128.\n" ^Wide [^Wide a ^Wide b]
  (let [(values an ac am ae) (qun a)
        (values bn bc bm be) (qun b)
        neg (!= an bn)]
    (when (or (== ac 2) (== bc 2))
      (return (qnan)))
    (when (or (== ac 1) (== bc 1))
      (when (or (and (== ac 0) (== (.Sign am) 0)) (and (== bc 0) (== (.Sign bm) 0)))
        (return (qnan)))
      (return (qinf neg)))
    (qpk neg (.Mul (new big/Int) am bm) (+ ae be))))

(go/func qDiv "qDiv is a/b in binary128 (no trap: an infinity or a NaN).\n" ^Wide [^Wide a ^Wide b]
  (let [(values an ac am ae) (qun a)
        (values bn bc bm be) (qun b)
        neg (!= an bn)]
    (when (or (== ac 2) (== bc 2))
      (return (qnan)))
    (when (== ac 1)
      (when (== bc 1)
        (return (qnan)))
      (return (qinf neg)))
    (when (== bc 1)
      (return (qpk neg (new big/Int) 0)))
    (when (== (.Sign bm) 0)
      (when (== (.Sign am) 0)
        (return (qnan)))
      (return (qinf neg)))
    (when (== (.Sign am) 0)
      (return (qpk neg am 0)))
    (let [k (- (+ 116 (.BitLen bm)) (.BitLen am))]
      (when (< k 0)
        (set! k 0))
      (let [(values qq rr) (.QuoRem (new big/Int) (.Lsh (new big/Int) am (conv uint k)) bm (new big/Int))]
        (.Lsh qq qq 1)
        (when (!= (.Sign rr) 0)
          (.SetBit qq qq 0 1))
        (qpk neg qq (- (- (- ae be) k) 1))))))

(go/func qCmp "qCmp compares binary128 values: -1, 0 or 1, 2 when unordered (a NaN).\n" ^int [^Wide a ^Wide b]
  (let [(values an ac _ _) (qun a)
        (values bn bc _ _) (qun b)]
    (when (or (== ac 2) (== bc 2))
      (return 2))
    (let [mask (.SetUint64 (new big/Int) 0x7fffffffffffffff)
          x (qbig a)
          y (qbig b)]
      (.Lsh mask mask 64)
      (.Or mask mask (.SetUint64 (new big/Int) (bit-not (conv uint64 0))))
      (.And x x mask)
      (.And y y mask)
      (when (and (== (.Sign x) 0) (== (.Sign y) 0))
        (return 0))
      (when an
        (.Neg x x))
      (when bn
        (.Neg y y))
      (.Cmp x y))))

(go/method CmpOp "CmpOp is the comparison op (eq ne lt le gt ge) of a and b as t: false for every op but ne when a binary128 is\na NaN.\n" ^bool [^WType t ^string op ^Wide a ^Wide b]
  (let [c (.Cmp t a b)]
    (when (== c 2)
      (return (== op "ne")))
    (switch op
      (case ["eq"]
        (return (== c 0)))
      (case ["ne"]
        (return (!= c 0)))
      (case ["lt"]
        (return (< c 0)))
      (case ["le"]
        (return (<= c 0)))
      (case ["gt"]
        (return (> c 0))))
    (>= c 0)))

(go/func qtrunc "qtrunc is a binary128 truncated toward zero to an integer (a NaN or an infinity 0).\n" ^{:tag (* big/Int)} [^Wide w]
  (let [(values neg cls m e) (qun w)]
    (when (!= cls 0)
      (return (new big/Int)))
    (if (>= e 0)
      (.Lsh m m (conv uint e))
      (.Rsh m m (conv uint (- e))))
    (when neg
      (.Neg m m))
    m))

(go/func qOfBig "qOfBig is the integer b rounded to binary128.\n" ^Wide [^{:tag (* big/Int)} b]
  (let [neg (< (.Sign b) 0)]
    (qpk neg (.Abs (new big/Int) b) 0)))

(go/func fbits "fbits is the binary128 w rounded to the format of p bits, bias emax and ebits exponent bits: its bits (a NaN quiet,\nits payload's top bits kept).\n" ^uint64 [^Wide w ^int p ^int emax ^int ebits]
  (let [(values neg cls m e) (qun w)]
    (when (== cls 2)
      (let [r (bit-or (<< (conv uint64 (+ (* 2 emax) 1)) (conv uint (- p 1))) (<< (conv uint64 1) (conv uint (- p 2))))
            pl (.Uint64 (.Rsh (new big/Int) m (conv uint (- 113 p))))]
        (set! r bit-or pl)
        (when neg
          (set! r bit-or (<< (conv uint64 1) (conv uint (+ ebits p -1)))))
        (return r)))
    (when (== cls 1)
      (let [r (<< (conv uint64 (+ (* 2 emax) 1)) (conv uint (- p 1)))]
        (when neg
          (set! r bit-or (<< (conv uint64 1) (conv uint (+ ebits p -1)))))
        (return r)))
    (.Uint64 (fpack neg m e p emax ebits))))

(go/func qOfBits "qOfBits is the value of the bits b of the format of p bits, bias emax, ebits exponent bits, as binary128 (exact).\n" ^Wide [^uint64 b ^int p ^int emax ^int ebits]
  (let [(values neg cls m e) (funpack (.SetUint64 (new big/Int) b) p emax ebits)]
    (when (== cls 2)
      (let [r (qnan)]
        (set! (aget r 1) bit-or (<< (.Uint64 m) (conv uint (- 49 (- p 1)))))
        (when neg
          (set! (aget r 1) bit-or 0x8000000000000000))
        (return r)))
    (when (== cls 1)
      (return (qinf neg)))
    (qpk neg m e)))

(go/method Float32 "Float32 converts w to float32, rounded once (to nearest even, or by RoundMode for a binary128).\n" ^float32 [^WType t ^Wide w]
  (when (.-Float t)
    (return (math/Float32frombits (conv uint32 (fbits w 24 127 8)))))
  (let [(values f _) (.Float32 (.SetInt (new big/Float) (.toBig t w)))]
    f))

(go/method Float16 "Float16 converts w to IEEE binary16's bits, rounded once.\n" ^uint16 [^WType t ^Wide w]
  (when (.-Float t)
    (return (conv uint16 (fbits w 11 15 5))))
  (let [b (.toBig t w)
        neg (< (.Sign b) 0)]
    (conv uint16 (.Uint64 (fpack neg (.Abs b b) 0 11 15 5)))))

;; ci's system calls where TamaGo's syscall has no Linux (queue 214, a REQUEST for C's owner; sys_linux.ae elsewhere): no
;; access(2) (ENOSYS), Stat_t's flat times.
(in-ns 'go.arbace.crt) (go/file "sys_other.go" :build ["//go:build !linux"] :imports [
    [os "os"]
    [syscall "syscall"]
    [time "time"]])

(go/func sysAccess ^error [^string p ^uint32 mode]
  syscall/ENOSYS)

(go/func statSec "statSec is st's access (0), modification (1) or change (2) time's seconds.\n" ^int64 [^{:tag (* syscall/Stat_t)} st ^int i]
  (switch i
    (case [0] (return (.-Atime st)))
    (case [1] (return (.-Mtime st))))
  (.-Ctime st))

(go/func statNsec "statNsec is statSec's nanoseconds.\n" ^int64 [^{:tag (* syscall/Stat_t)} st ^int i]
  (switch i
    (case [0] (return (.-AtimeNsec st)))
    (case [1] (return (.-MtimeNsec st))))
  (.-CtimeNsec st))

(go/func pwriteInPlace "pwriteInPlace writes b to f at off (Sys.WriteBack, queue 310): Go's WriteAt.\n" [^{:tag (* os/File)} f ^{:tag (slice byte)} b ^int64 off] :results [int error]
  (.WriteAt f b off))

(go/func hostAlloc "hostAlloc is size zero bytes (Reserve, queue 311): Go's memory, where the host has no demand-zero mapping of its own.\n" ^{:tag (slice byte)} [^uint64 size]
  (make (slice byte) size))


(go/func hostFree "hostFree: Go's collector frees hostAlloc's memory.\n" [^{:tag (slice byte)} b])


(go/func hostZero "hostZero frees nothing here: [0, 0).\n" [^{:tag (slice byte)} b ^uint64 lo ^uint64 hi] :results [^uint64 l ^uint64 h]
  (return 0 0))


(go/func sysUtimens "sysUtimens is utimensat's change of the path p's times (queue 314) where TamaGo's syscall has no utimensat: UtimesNano\n(a link followed: nofollow unseen), t's UTIME_NOW the clock's, its UTIME_OMIT the file's own time, no times now.\n" ^error [^string p ^{:tag (array 4 int64)} t ^bool have ^bool nofollow]
  (let [^{:tag syscall/Stat_t} st (zero syscall/Stat_t)
      now (time/Now)
      tv (make (slice syscall/Timespec) 2)]
    (when [err (syscall/Stat p (addr st))] (!= err nil)
      (return err))

    (for [i 0] (< i 2) (inc! i)
      (let [sec (.Unix now)
          nsec (conv int64 (.Nanosecond now))]
        (when have
          (switch (aget t (+ (* 2 i) 1))
            (case [utimeNow])
            (case [utimeOmit]
              (set! (values sec nsec) (values (statSec (addr st) i) (statNsec (addr st) i))))
            (default
              (set! (values sec nsec) (values (aget t (* 2 i)) (aget t (+ (* 2 i) 1)))))))

        (aset tv i (lit syscall/Timespec :Sec sec :Nsec nsec))))

    (syscall/UtimesNano p tv)))


(go/func hostMapFile "hostMapFile: no host mapping of a file where TamaGo's syscall has none (ENOSYS: mmapFile copies the file's bytes in).
" [^{:tag (* os/File)} f ^int64 off ^uint64 size ^bool write ^bool shared] :results [(slice byte) error]
  (return nil syscall/ENOSYS))


(go/func hostGetLk "hostGetLk: no other process's locks where TamaGo's syscall has none: F_UNLCK.\n" ^error [^{:tag (* os/File)} f ^{:tag (* (array 5 int64))} lk]
  (aset lk 0 2)
  nil)

;; ci's system calls where TamaGo's syscall has no Linux (queue 214, a REQUEST for C's owner; sys_linux.ae elsewhere): no
;; access(2) (ENOSYS), Stat_t's flat times.
(in-ns 'go.arbace.crt) (go/file "sys_other.go" :build ["//go:build !linux"] :imports [
    [os "os"]
    [syscall "syscall"]])

(go/func sysAccess ^error [^string p ^uint32 mode]
  syscall/ENOSYS)

(go/func statSec "statSec is st's access (0), modification (1) or change (2) time's seconds.\n" ^int64 [^{:tag (* syscall/Stat_t)} st ^int i]
  (switch i
    (case [0] (return (.-Atime st)))
    (case [1] (return (.-Mtime st))))
  (.-Ctime st))

(go/func statNsec "statNsec is statSec's nanoseconds.\n" ^int64 [^{:tag (* syscall/Stat_t)} st ^int i]
  (switch i
    (case [0] (return (.-AtimeNsec st)))
    (case [1] (return (.-MtimeNsec st))))
  (.-CtimeNsec st))

(go/func pwriteInPlace "pwriteInPlace writes b to f at off (Sys.WriteBack, queue 310): Go's WriteAt.\n" [^{:tag (* os/File)} f ^{:tag (slice byte)} b ^int64 off] :results [int error]
  (.WriteAt f b off))

(go/func hostAlloc "hostAlloc is size zero bytes (Reserve, queue 311): Go's memory, where the host has no demand-zero mapping of its own.\n" ^{:tag (slice byte)} [^uint64 size]
  (make (slice byte) size))


(go/func hostFree "hostFree: Go's collector frees hostAlloc's memory.\n" [^{:tag (slice byte)} b])


(go/func hostZero "hostZero frees nothing here: [0, 0).\n" [^{:tag (slice byte)} b ^uint64 lo ^uint64 hi] :results [^uint64 l ^uint64 h]
  (return 0 0))

;; ci's system calls where TamaGo's syscall has no Linux (queue 214, a REQUEST for C's owner; sys_linux.ae elsewhere): no
;; access(2) (ENOSYS), Stat_t's flat times.
(in-ns 'go.arbace.crt) (go/file "sys_other.go" :build ["//go:build !linux"] :imports [
    [syscall "syscall"]])

(go/func sysAccess ^error [^string p ^uint32 mode]
  syscall/ENOSYS)

(go/func statSec "statSec is st's access (0), modification (1) or change (2) time's seconds.\n" ^int64 [^{:tag (* syscall/Stat_t)} st ^int i]
  (switch i
    (case [0] (return (.-Atime st)))
    (case [1] (return (.-Mtime st))))
  (.-Ctime st))

(go/func statNsec "statNsec is statSec's nanoseconds.\n" ^int64 [^{:tag (* syscall/Stat_t)} st ^int i]
  (switch i
    (case [0] (return (.-AtimeNsec st)))
    (case [1] (return (.-MtimeNsec st))))
  (.-CtimeNsec st))

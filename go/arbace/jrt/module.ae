;; jrt: java.lang.Module, minimal (doc/FULL-SUPPORT-SURVEY.md, RPS55; doc/go/JRT-NOTES.md,
;; "Modules"): the closed world has no module system, only the two modules a class is in as
;; Class.getModule answers: java.base, of the bootstrap loader, for the JDK's and jrt's classes
;; and the primitive types (the classes classPlace names so: every JDK class of the shipped world
;; is java.base's, jdk/sources.txt), and the application loader's unnamed module for the rest
;; (Arbace's, the compiled namespaces', the run time's). Module's members beyond getName,
;; isNamed, getClassLoader and toString are not here (getDescriptor's ModuleDescriptor, getLayer's
;; ModuleLayer and getPackages' Set are outside jrt; j2g makes their uses stubs that throw).
(in-ns 'go.arbace.jrt)

(go/file "module.go"
  :imports [[strconv "strconv"]])

(go/type Module
  "Module is java.lang.Module (final): a name (nil for the unnamed module) and the loader.\n"
  (struct Object ^{:tag (* String)} name ^ClassLoader_I loader))

(go/var Module_class
  (Define (addr (lit ClassInfo :Name "java.lang.Module" :Kind KindClass
                     :Modifiers (bit-or AccPublic AccFinal) :Super Object_class
                     :Go "arbace/jrt.Module"))))

(go/var
  [^{:tag (* Module)} javaBaseModule (addr (lit Module :name (Intern "java.base")))]
  [^{:tag (* Module)} unnamedModule (addr (lit Module :loader appLoader))])

(go/method GetModule__Module
  "GetModule__Module is Class.getModule: java.base for the JDK's and jrt's classes and the
primitive types, the application loader's unnamed module otherwise; an array is in its
element type's module.\n"
  ^{:tag (* Module)} [^{:tag (* Class)} c]
  (when (== (classPlace c) "module java.base of loader 'bootstrap'")
    (return javaBaseModule))
  unnamedModule)

(go/method GetName__String
  "GetName__String is Module.getName: the module's name, null for the unnamed module.\n"
  ^{:tag (* String)} [^{:tag (* Module)} m]
  (.-name m))

(go/method IsNamed__Z ^bool [^{:tag (* Module)} m] (!= (.-name m) nil))

(go/method GetClassLoader__ClassLoader
  "GetClassLoader__ClassLoader is Module.getClassLoader: null (the bootstrap loader) for
java.base, the application loader for the unnamed module.\n"
  ^ClassLoader_I [^{:tag (* Module)} m]
  (.-loader m))

(go/method ToString__String
  "ToString__String is Module.toString: \"module NAME\", or \"unnamed module @\" and the
identity hash in hexadecimal.\n"
  ^{:tag (* String)} [^{:tag (* Module)} m]
  (when (!= (.-name m) nil)
    (return (Concat (Str "module ") (.-name m))))
  (Str (+ "unnamed module @" (strconv/FormatUint (conv uint64 (conv uint32 (.HashCode__I m))) 16))))

(go/method Ref ^any [^{:tag (* Module)} t] (when (== t nil) (return nil)) t)
(go/method GetClass__Class ^{:tag (* Class)} [^{:tag (* Module)} t] Module_class)
(go/method Clone__O ^any [^{:tag (* Module)} t] (panic (CloneNotSupported t)))

(go/func Module_InstanceOf ^bool [^any x] (let [(values _ ok) (assert (* Module) x)] ok))
(go/func Module_Cast ^{:tag (* Module)} [^any x]
  (when (== x nil) (return nil))
  (let [(values v ok) (assert (* Module) x)]
    (when (not ok) (panic (ClassCast x Module_class)))
    v))

(go/func init []
  (set! (.-IsInstance (.Info Module_class)) Module_InstanceOf))

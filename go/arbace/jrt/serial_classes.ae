;; src/java.base/share/classes/java/lang/{Throwable,StringBuilder,StringBuffer}.java and
;; java/util/Date.java (their serialization hooks and serial forms), whose notice follows
;; (LICENSE.md, "OpenJDK (jdk26u)"):

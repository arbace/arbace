;; jrt's tests of annotations at run time (annotation.ae; F14's first slice): an annotation type
;; and an annotated class written as j2g writes them (ClassInfo.Annots, AnnNew), their annotations'
;; values, toString and hashCode against the JDK's (jdk26u's java, the program in the comment).
(in-ns 'go.arbace.jrt)

(go/file "annotation_test.go"
  :imports [[strings "strings"] [testing "testing"]])

;; package test;
;; @Retention(RUNTIME) @interface Ann { int value(); String name() default "x"; String[] tags() default {}; }
;; @Retention(RUNTIME) @interface All { boolean z(); byte b(); char c(); short s(); long j(); float f();
;;   double d(); Class<?> k(); Class<?>[] ks(); int[] is(); char[] cs(); double[] ds(); float[] fs();
;;   long[] js(); byte[] bs(); }
;; @Ann(value=5, tags={"a","bé"}) public class Host {
;;   @Ann(7) public void run() {}
;;   @All(z=true, b=(byte)-1, c='\n', s=3, j=-4L, f=1.5f, d=Double.NaN, k=int[].class,
;;        ks={String.class, void.class}, is={1,2}, cs={'q','\''}, ds={0.1,-0.0},
;;        fs={Float.POSITIVE_INFINITY}, js={9L}, bs={16}) public int f; }
;; The JDK prints (Host.main):
;;   @test.Ann(name="x", tags={"a", "bé"}, value=5)   -2079738441
;;   @test.Ann(name="x", tags={}, value=7)                 -2079733253
;;   @test.All(z=true, b=(byte)0xff, ..., bs={(byte)0x10}) 234336693 (with the classes' identity hashes)

(go/type testAnn (interface Annotation (Is_testAnn [])
                   (Value__I ^int32 [])
                   (Name__String ^{:tag (* String)} [])
                   (Tags__String1 ^{:tag (* RefArray)} [])))

;; the Go type j2g gives an annotation type (arbace.j2g.decls/annotation-impl-forms)
(go/type testAnn_ann (struct AnnotationObj))
(go/method Is_testAnn [^{:tag (* testAnn_ann)} t])
(go/method Value__I ^int32 [^{:tag (* testAnn_ann)} t] (assert int32 (.Member (addr (.-AnnotationObj t)) "value")))
(go/method Name__String ^{:tag (* String)} [^{:tag (* testAnn_ann)} t] ((inst As (* String)) (.Member (addr (.-AnnotationObj t)) "name")))
(go/method Tags__String1 ^{:tag (* RefArray)} [^{:tag (* testAnn_ann)} t] (assert (* RefArray) (.Element (addr (.-AnnotationObj t)) "tags")))
(go/method Ref ^any [^{:tag (* testAnn_ann)} t] (when (== t nil) (return nil)) t)

(go/var testAnn_class
  (Define (addr (lit ClassInfo :Name "test.Ann" :Kind KindAnnotation
                     :Modifiers (bit-or AccInterface AccAbstract AccAnnotation)
                     :Interfaces (lit (slice (* Class)) Annotation_class) :Go "arbace/jrt.testAnn"
                     :Annots "D name \"x\"\nD tags [Ljava.lang.String; 0"))))
(go/var testAll_class
  (Define (addr (lit ClassInfo :Name "test.All" :Kind KindAnnotation
                     :Modifiers (bit-or AccInterface AccAbstract AccAnnotation)
                     :Interfaces (lit (slice (* Class)) Annotation_class) :Go "arbace/jrt.testAll"))))
(go/var testHostData
  (+ "T @Ltest.Ann; 2 value I5 tags [Ljava.lang.String; 2 \"a\" \"b\\u00e9\"\n"
     "M run ()V @Ltest.Ann; 1 value I7\n"
     "F f @Ltest.All; 15 z Z1 b B-1 c C10 s S3 j J-4 f F1069547520 d D9221120237041090560 k c[I"
     " ks [Ljava.lang.Class; 2 cLjava.lang.String; cV is [I 2 I1 I2 cs [C 2 C113 C39"
     " ds [D 2 D4591870180066957722 D-9223372036854775808 fs [F 1 F2139095040 js [J 1 J9 bs [B 1 B16\n"
     "P run ()V 0 @Lnot.InTheWorld; 0\n"))
(go/var testHost_class
  (Define (addr (lit ClassInfo :Name "test.Host" :Kind KindClass :Modifiers AccPublic :Super Object_class
                     :Go "arbace/jrt.testHost" :Annots testHostData))))
(go/var testHost2_class
  (Define (addr (lit ClassInfo :Name "test.Host2" :Kind KindClass :Modifiers AccPublic :Super testHost_class
                     :Go "arbace/jrt.testHost2"
                     :Annots "T @Ltest.Ann; 2 value I5 tags [Ljava.lang.String; 2 \"a\" \"b\\u00e9\"\nT @Lnot.InTheWorld; 0"))))

(go/func init []
  (let [abs (bit-or AccPublic AccAbstract)
        ai (.Info testAnn_class)]
    (set! (.-Methods ai)
          (lit (slice MethodInfo)
               (lit MethodInfo :Name "value" :Return Prim_int :Modifiers abs)
               (lit MethodInfo :Name "name" :Return String_class :Modifiers abs)
               (lit MethodInfo :Name "tags" :Return (.ArrayClass String_class) :Modifiers abs)))
    (set! (.-IsInstance ai) (fn ^bool [^any x] (let [(values _ ok) (assert testAnn x)] ok)))
    (set! (.-AnnNew ai) (fn ^any [] (addr (lit testAnn_ann))))
    (let [li (.Info testAll_class)]
      (range [_ n (lit (slice string) "z" "b" "c" "s" "j" "f" "d" "k" "ks" "is" "cs" "ds" "fs" "js" "bs")]
        (set! (.-Methods li) (append (.-Methods li) (lit MethodInfo :Name n :Return Object_class :Modifiers abs))))
      (set! (.-IsInstance li) (fn ^bool [^any x] (== (AnnotationTypeOf x) testAll_class))))))

(go/func TestAnnotationValues [^{:tag (* testing/T)} t]
  (let [a (.GetAnnotation_Class__Annotation testHost_class testAnn_class)]
    (when (== a nil) (.Fatal t "no @Ann on test.Host"))
    (let [(values x ok) (assert testAnn a)]
      (when (not ok) (.Fatal t "@Ann is not a testAnn (AnnNew)"))
      (when (!= (.Value__I x) 5) (.Errorf t "value %d" (.Value__I x)))
      (when (!= (.String (.Name__String x)) "x") (.Errorf t "name (default) %q" (.String (.Name__String x))))
      (let [tags (.Tags__String1 x)]
        (when (or (!= (len (.-A tags)) 2) (!= (.String (assert (* String) (aget (.-A tags) 1))) "bé"))
          (.Errorf t "tags %v" (.-A tags)))
        ;; a member's array is cloned on each access
        (when (== (.Tags__String1 x) tags) (.Error t "tags not cloned")))
      (when (!= (.AnnotationType__Class x) testAnn_class) (.Error t "annotationType")))
    (let [s (.String (.ToString__String a))]
      (when (!= s "@test.Ann(name=\"x\", tags={\"a\", \"b\\u00e9\"}, value=5)") (.Errorf t "toString %s" s)))
    (when (!= (.HashCode__I a) -2079738441) (.Errorf t "hashCode %d" (.HashCode__I a)))
    (when (!= (.GetAnnotation_Class__Annotation testHost_class testAll_class) nil) (.Error t "@All on test.Host"))
    (when (not (.IsAnnotationPresent_Class__Z testHost_class testAnn_class)) (.Error t "isAnnotationPresent"))
    (when (!= (len (.-A (.GetDeclaredAnnotations__Annotation1 testHost_class))) 1) (.Error t "getDeclaredAnnotations"))
    ;; a method's, equality and hash
    (let [m (newMethod testHost_class (addr (lit MethodInfo :Name "run" :Return Prim_void :Modifiers AccPublic)))
          b (.GetAnnotation_Class__Annotation m testAnn_class)]
      (when (== b nil) (.Fatal t "no @Ann on run()"))
      (let [s (.String (.ToString__String b))]
        (when (!= s "@test.Ann(name=\"x\", tags={}, value=7)") (.Errorf t "run's toString %s" s)))
      (when (!= (.HashCode__I b) -2079733253) (.Errorf t "run's hashCode %d" (.HashCode__I b)))
      (when (.Equals_O__Z a b) (.Error t "@Ann(5) equals @Ann(7)"))
      ;; the parameter's annotation names a class outside the world: skipped
      (let [pa (.GetParameterAnnotations__Annotation2 m)]
        (when (!= (len (.-A pa)) 0) (.Errorf t "run() has no parameters: %d" (len (.-A pa))))))
    ;; the same annotation decoded for another class: equal, the same hash; an inherited-less type
    (let [c (.GetDeclaredAnnotation_Class__Annotation testHost2_class testAnn_class)]
      (when (or (== c nil) (not (.Equals_O__Z a c)) (not (.Equals_O__Z c a)) (!= (.HashCode__I c) (.HashCode__I a)))
        (.Error t "test.Host2's @Ann differs"))
      (when (== c a) (.Error t "two classes share one object"))
      (when (!= (len (.-A (.GetAnnotations__Annotation1 testHost2_class))) 1)
        (.Error t "test.Host2: @Ann is not @Inherited, the second annotation's type is outside the world")))
    ;; the object's class: made by jrt, its member table the elements
    (let [k (GetClass a)]
      (when (!= (.GoName k) "test.$Proxy1") (.Errorf t "class %s" (.GoName k)))
      (when (not (.IsInstance_O__Z k a)) (.Error t "isInstance"))
      (let [vm (.GetMethod_String_Class1__Method k (Str "value") nil)
            v (.Invoke_O_O1__O vm a nil)]
        (when (!= (.-F_value (assert (* Integer) v)) 5) (.Errorf t "value() by reflection %v" v))))))

(go/func TestAnnotationAllKinds [^{:tag (* testing/T)} t]
  (let [f (newField testHost_class (addr (lit FieldInfo :Name "f" :Type Prim_int :Modifiers AccPublic)))
        a (.GetAnnotation_Class__Annotation f testAll_class)]
    (when (== a nil) (.Fatal t "no @All on f"))
    (let [s (.String (.ToString__String a))
          want (+ "@test.All(z=true, b=(byte)0xff, c='\\n', s=3, j=-4L, f=1.5f, d=0.0/0.0, k=int[].class,"
                  " ks={java.lang.String.class, void.class}, is={1, 2}, cs={'q', '\\''}, ds={0.1, -0.0},"
                  " fs={1.0f/0.0f}, js={9L}, bs={(byte)0x10})")]
      (when (!= s want) (.Errorf t "toString\n got %s\nwant %s" s want)))
    ;; Class's hashCode is the identity hash: the JDK's 234336693 less k's and ks's terms is
    ;; -583068529, its hash of @All without k and ks
    (let [b (.annBase (assert annotationBased a))
          ks (.Element b "ks")
          less (- (.HashCode__I a)
                  (bit-xor (* 127 (.HashCode__I (Intern "k"))) (.HashCode__I (assert Object_I (.Element b "k"))))
                  (bit-xor (* 127 (.HashCode__I (Intern "ks"))) (memberValueHashCode ks)))]
      (when (!= less -583068529) (.Errorf t "hashCode less the classes' terms %d" less)))
    (when (!= (.String (.ToString__String (AnnotationTypeOf a))) "interface test.All")
      (.Error t "AnnotationTypeOf"))))

(go/func TestAnnotationHashMapOrder [^{:tag (* testing/T)} t]
  ;; new HashMap<>(0) of these keys put in order, then iterated: the JDK 26 run's orders
  (let [got (hashMapOrder (lit (slice string) "name" "tags"))]
    (when (or (!= (aget got 0) "name") (!= (aget got 1) "tags")) (.Errorf t "%v" got)))
  (let [got (hashMapOrder (lit (slice string) "since" "forRemoval"))]
    (when (or (!= (aget got 0) "forRemoval") (!= (aget got 1) "since")) (.Errorf t "%v" got)))
  (let [got (hashMapOrder (lit (slice string) "value" "since" "forRemoval"))]
    (when (or (!= (aget got 0) "value") (!= (aget got 1) "forRemoval") (!= (aget got 2) "since")) (.Errorf t "%v" got)))
  (let [got (hashMapOrder (lit (slice string) "a" "b" "c" "d" "e" "f" "g"))]
    (when (!= (aget got 6) "g") (.Errorf t "%v" got))))

;; Field's primitive accessors (reflect.ae; jdk26u's FieldAccessorImpl): widening on get and set,
;; the JDK's messages otherwise
(go/func TestFieldPrimitives [^{:tag (* testing/T)} t]
  (let [cell (conv int32 7)
        f (newField testHost_class (addr (lit FieldInfo :Name "n" :Type Prim_int :Modifiers (bit-or AccPublic AccStatic)
                                              :Get (fn ^any [^any o] (return cell))
                                              :Set (fn [^any o ^any v] (set! cell (assert int32 v))))))]
    (when (!= (.GetInt_O__I f nil) 7) (.Error t "getInt"))
    (when (!= (.GetLong_O__J f nil) 7) (.Error t "getLong (widened)"))
    (when (!= (.GetDouble_O__D f nil) 7.0) (.Error t "getDouble (widened)"))
    (.SetByte_O_B__V f nil (conv int8 -3))
    (when (!= cell -3) (.Errorf t "setByte widened to int: %d" cell))
    (let [^Throwable_I exc nil]
      ((fn [] (defer (Catch (addr exc))) (.GetShort_O__S f nil)))
      (when (or (== exc nil)
                (!= (.String (.GetMessage__String exc))
                    "Attempt to get int field \"test.Host.n\" with illegal data type conversion to short"))
        (.Errorf t "getShort: %v" exc)))
    (let [^Throwable_I exc nil]
      ((fn [] (defer (Catch (addr exc))) (.SetLong_O_J__V f nil (conv int64 5))))
      (when (or (== exc nil)
                (!= (.String (.GetMessage__String exc)) "Can not set static int field test.Host.n to (long)5"))
        (.Errorf t "setLong: %v" exc)))))

;; JCS210 (a), JCS213 (b) (doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: JCS210", "As built: JCS213"): an annotation's
;; class is a proxy class and its handler jdk26u's AnnotationInvocationHandler (EqualityTest's equalities: the
;; annotation not equal to its handler, each equal to itself, both ways); a missing member's exception the world's
;; IncompleteAnnotationException (here a stand-in of it named by incompleteAnnotationName), else
;; UnsupportedOperationException naming it.
(go/var testIncomplete_class
  (Define (addr (lit ClassInfo :Name "test.IncompleteAnnotationException" :Kind KindClass :Modifiers AccPublic
                     :Super Object_class :Go "arbace/jrt.testIncomplete"))))

(go/func TestAnnotationProxy [^{:tag (* testing/T)} t]
  (let [a (.GetAnnotation_Class__Annotation testHost_class testAnn_class)
        h (Proxy_GetInvocationHandler_O__InvocationHandler a)
        call (fn ^any [^string name ^{:tag (slice (* Class))} ps ^{:tag (* RefArray)} args]
               (let [m (newMethod testAnn_class (addr (lit MethodInfo :Name name :Params ps :Return Object_class :Modifiers AccPublic)))]
                 (return (.Invoke_O_Method_O1__O h a m args))))]
    (when (not (Proxy_IsProxyClass_Class__Z (GetClass a)))
      (.Error t "an annotation's class is not a proxy class"))
    (when (Proxy_IsProxyClass_Class__Z testHost_class)
      (.Error t "a class is a proxy class"))
    (when (or (== h nil) (!= (Proxy_GetInvocationHandler_O__InvocationHandler a) h))
      (.Error t "the handler: none, or not one per annotation"))
    (when (!= (.String (.GetName__String (GetClass h))) "sun.reflect.annotation.AnnotationInvocationHandler")
      (.Errorf t "the handler's class %s" (.String (.GetName__String (GetClass h)))))
    (when (or (Equals a h) (Equals h a) (not (Equals a a)) (not (Equals h h)))
      (.Error t "EqualityTest's equalities"))
    (when (or (!= (.-F_value (assert (* Integer) (call "value" nil nil))) 5)
              (!= (.String (assert (* String) (call "toString" nil nil))) (.String (.ToString__String a)))
              (!= (assert int32 (call "hashCode" nil nil)) (.HashCode__I a))
              (!= (call "annotationType" nil nil) testAnn_class)
              (!= (call "equals" (lit (slice (* Class)) Object_class) (RefArrayOf Object_class a)) true)
              (!= (call "equals" (lit (slice (* Class)) Object_class) (RefArrayOf Object_class h)) false))
      (.Error t "the handler's invoke"))
    (let [tags (call "tags" nil nil)]
      (when (== tags (call "tags" nil nil))
        (.Error t "invoke: a member's array not cloned")))
    (let [r (res (fn ^string [] (call "missing" nil nil) (return "")))]
      (when (!= r "!java.lang.UnsupportedOperationException: IncompleteAnnotationException: test.Ann missing element missing")
        (.Errorf t "missing member, no class: %s" r)))
    (let [old incompleteAnnotationName]
      (set! incompleteAnnotationName "test.IncompleteAnnotationException")
      (set! (.-Ctors (.Info testIncomplete_class))
            (lit (slice CtorInfo)
                 (lit CtorInfo :Params (lit (slice (* Class)) Class_class String_class) :Modifiers AccPublic
                      :New (fn ^any [^{:tag (slice any)} args]
                             (return (RuntimeException_New_String
                                       (Str (+ (.String (.GetName__String (assert (* Class) (aget args 0))))
                                               " missing element " (.String (assert (* String) (aget args 1)))))))))))
      (let [r (res (fn ^string [] (call "missing" nil nil) (return "")))]
        (set! incompleteAnnotationName old)
        (when (!= r "!java.lang.RuntimeException: test.Ann missing element missing")
          (.Errorf t "missing member, the world's class: %s" r))))
    (let [r (res (fn ^string [] (call "value" (lit (slice (* Class)) Prim_int) (RefArrayOf Object_class nil)) (return "")))]
      (when (not (strings/Contains r "Too many parameters for an annotation method"))
        (.Errorf t "a member with a parameter: %s" r)))))

;; n-jrt-aih (round 52; doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: n-jrt-aih"): jdk26u's
;; AnnotationInvocationHandler(Class, Map), AnnotationParser.annotationForMap's, over a map of the world read by
;; name (here a stand-in map answering serialCall's test hook, serialTestStream): its members in the map's order,
;; invoke, equalsImpl (with the declaration annotation of the same values), hashCodeImpl and toStringImpl the
;; JDK's (test.Host's @Ann above), a type that is not an annotation type AnnotationFormatError (in jrt alone the
;; InternalError naming it).
(go/type testMap
  "testMap is a stand-in java.util.Map, its entry set, its iterator and an entry, by kind: what the handler's
constructor calls through serialCall.\n"
  (struct ^string kind ^{:tag (slice string)} keys ^{:tag (slice any)} vals ^int pos))

(go/method serialStreamCall ^any [^{:tag (* testMap)} m ^string name ^{:tag (slice any)} args]
  (switch name
    (case ["entrySet"] (return (addr (lit testMap :kind "set" :keys (.-keys m) :vals (.-vals m)))))
    (case ["iterator"] (return (addr (lit testMap :kind "iterator" :keys (.-keys m) :vals (.-vals m)))))
    (case ["hasNext"] (return (< (.-pos m) (len (.-keys m)))))
    (case ["next"]
      (let [i (.-pos m)]
        (set! (.-pos m) (+ i 1))
        (return (addr (lit testMap :kind "entry" :keys (lit (slice string) (aget (.-keys m) i))
                           :vals (lit (slice any) (aget (.-vals m) i)))))))
    (case ["getKey"] (return (Str (aget (.-keys m) 0))))
    (case ["getValue"] (return (aget (.-vals m) 0))))
  (panic (+ "testMap: " (.-kind m) " has no " name)))

(go/func TestAnnotationHandlerNew [^{:tag (* testing/T)} t]
  (let [tags (RefArrayOf String_class (Str "a") (Str "bé"))
        m (addr (lit testMap :kind "map" :keys (lit (slice string) "name" "tags" "value")
                     :vals (lit (slice any) (Str "x") tags (Integer_ValueOf_I__Integer 5))))
        h (annotationHandler_New_Class_Map testAnn_class m)
        decl (.GetAnnotation_Class__Annotation testHost_class testAnn_class)
        call (fn ^any [^string name ^{:tag (slice (* Class))} ps ^{:tag (* RefArray)} args]
               (let [mm (newMethod testAnn_class (addr (lit MethodInfo :Name name :Params ps :Return Object_class :Modifiers AccPublic)))]
                 (return (.Invoke_O_Method_O1__O h nil mm args))))]
    (when (!= (.String (assert (* String) (call "toString" nil nil))) "@test.Ann(name=\"x\", tags={\"a\", \"bé\"}, value=5)")
      (.Errorf t "toString: %s" (.String (assert (* String) (call "toString" nil nil)))))
    (when (!= (assert int32 (call "hashCode" nil nil)) -2079738441)
      (.Errorf t "hashCode: %d" (assert int32 (call "hashCode" nil nil))))
    (when (or (!= (.-F_value (assert (* Integer) (call "value" nil nil))) 5)
              (!= (call "annotationType" nil nil) testAnn_class))
      (.Error t "the members"))
    (when (== (call "tags" nil nil) tags)
      (.Error t "a member's array not cloned"))
    (when (or (!= (call "equals" (lit (slice (* Class)) Object_class) (RefArrayOf Object_class decl)) true)
              (not (.Equals_O__Z (.-a h) decl))
              (!= (call "equals" (lit (slice (* Class)) Object_class) (RefArrayOf Object_class (Str "x"))) false))
      (.Error t "equalsImpl with the declaration annotation"))
    (let [r (res (fn ^string [] (annotationHandler_New_Class_Map testHost_class m) (return "")))]
      (when (!= r "!java.lang.InternalError: AnnotationFormatError: Attempt to create proxy for a non-annotation type: test.Host")
        (.Errorf t "not an annotation type: %s" r)))))

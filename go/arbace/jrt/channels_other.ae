;; jrt: the natives of jdk.internal.jrt.HostChannels (channels_linux.ae; F10 of doc/classes/JAVA-DEFERRED-TRIAGE.md,
;; "As built: F10a") on systems without Linux's descriptors (TamaGo's, the box): every native fails with
;; HostChannels.ENOHOST ("Channels not available"), the box's host unchanged.
(in-ns 'go.arbace.jrt)

(go/file "channels_other.go"
  :build ["//go:build !linux"])

(go/func noChannels "noChannels is IOStatus.THROWN with HostChannels.ENOHOST in err[0].\n"
  ^int32 [^{:tag (* IntArray)} errs]
  (when (and (!= errs nil) (> (len (.-A errs)) 0))
    (aset (.-A errs) 0 -1))
  -5)

(go/func HostChannels_Strerror0_I__String_native "HostChannels_Strerror0_I__String_native: no channels.\n"
  ^{:tag (* String)} [^int32 errno]
  (Str "Channels not available"))

(go/func HostChannels_Ipv6Available0__Z_native "HostChannels_Ipv6Available0__Z_native: no channels.\n"
  ^bool []
  false)

(go/func HostChannels_Socket0_Z_Z_Z_I1__I_native "HostChannels_Socket0_Z_Z_Z_I1__I_native: no channels.\n"
  ^int32 [^bool ipv6 ^bool stream ^bool reuse ^{:tag (* IntArray)} errs]
  (noChannels errs))

(go/func HostChannels_Bind0_I_B1_I_I_I1__I_native "HostChannels_Bind0_I_B1_I_I_I1__I_native: no channels.\n"
  ^int32 [^int32 fd ^{:tag (* ByteArray)} addr ^int32 scope ^int32 port ^{:tag (* IntArray)} errs]
  (noChannels errs))

(go/func HostChannels_Listen0_I_I_I1__I_native "HostChannels_Listen0_I_I_I1__I_native: no channels.\n"
  ^int32 [^int32 fd ^int32 backlog ^{:tag (* IntArray)} errs]

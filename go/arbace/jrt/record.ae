;; jrt: java.lang.reflect.RecordComponent and Class.getRecordComponents (serialization's slice 5, JCS383 (a), P2 by
;; day; doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: P2 (by day)"). jdk26u's RecordComponent
;; (https://github.com/openjdk/jdk26u at baf63fb, src/java.base/share/classes/java/lang/reflect/RecordComponent.java)
;; transcribed into Go over what the closed world records of a record class: its Record attribute as data lines beside
;; the annotations (ClassInfo.Annots; arbace.classes.annot/attribute-lines writes them for j2g and the interpreter's
;; host),
;;   R NAME DESC [SIG]        one component, in the record's order: its name, its descriptor (binary names) and its
;;                            Signature when it has one (JVMS 4.7.30)
;;   A NAME ANN               a component's RUNTIME-visible annotation (those whose @Target admits RECORD_COMPONENT,
;;                            as javac propagates them; the class's own members' data, as the F and M records)
;; What HotSpot's JVM_GetRecordComponents gives Class.getRecordComponents0 these answer: the components in order, each
;; with its accessor (the record's public method of the component's name and no parameters), its type, its Signature
;; and its annotations. Not here: getAnnotatedType (type annotations: jrt's Field has none either). Copyright (c)
;; Oracle and/or its affiliates, under the GNU General Public License version 2 with the Classpath Exception
;; (LICENSE.md).
(in-ns 'go.arbace.jrt)

(go/file "record.go")

(go/type recordComp "recordComp: one R record.\n"
  (struct ^string name ^string desc ^string sig))

(go/type RecordComponent
  "RecordComponent is java.lang.reflect.RecordComponent (final: *RecordComponent).\n"
  (struct Object
          ^{:tag (* Class)} clazz
          ^{:tag recordComp} comp))

(go/var RecordComponent_class
  (Define (addr (lit ClassInfo :Name "java.lang.reflect.RecordComponent" :Kind KindClass
                     :Modifiers (bit-or AccPublic AccFinal) :Super Object_class
                     :Interfaces (lit (slice (* Class)) AnnotatedElement_class)
                     :Go "arbace/jrt.RecordComponent"))))

(go/func recordComps
  "recordComps: record class c's R records, decoded from its data once (classAttrs).\n"
  ^{:tag (slice recordComp)} [^{:tag (* Class)} c]
  (.-comps (attrsOf c)))

(go/method GetRecordComponents__RecordComponent1
  "GetRecordComponents__RecordComponent1 is Class.getRecordComponents: null unless c is a record class; else
its components in the record's order (a new array, new objects, as jdk26u's). A record whose data records no
component (a class of the world translated before the R records, or one of the JDK whose data the build
left out) answers its instance fields in declaration order, as jdk26u's ObjectStreamClass variant took them
(JLS 8.10.3: a record class's instance fields are its components).\n"
  ^{:tag (* RefArray)} [^{:tag (* Class)} c]
  (when (not (.IsRecord__Z c)) (return nil))
  (let [cs (recordComps c)]
    (when (== (len cs) 0)
      (EnsureMembers (.-info c))
      (range [_ f (.-Fields (.-info c))]
        (when (== (bit-and (.-Modifiers f) AccStatic) 0)
          (set! cs (append cs (lit recordComp :name (.-Name f) :desc (binaryDescriptor (.-Type f))))))))
    (let [a (NewRefArray RecordComponent_class (conv int32 (len cs)))]
      (range [i rc cs]
        (aset (.-A a) i (addr (lit RecordComponent :clazz c :comp rc))))
      a)))

(go/method GetName__String "GetName__String is RecordComponent.getName: the name, interned (the VM's Symbol).\n"
  ^{:tag (* String)} [^{:tag (* RecordComponent)} r]
  (Intern (.-name (.-comp r))))

(go/method GetDeclaringRecord__Class "GetDeclaringRecord__Class is RecordComponent.getDeclaringRecord.\n"
  ^{:tag (* Class)} [^{:tag (* RecordComponent)} r]
  (.-clazz r))

(go/method accessorInfo
  "accessorInfo: the entry of the component's accessor in the record's table (public, no parameters), nil if
the table lists none.\n"
  ^{:tag (* MethodInfo)} [^{:tag (* RecordComponent)} r]
  (.declaredMethodInfo (.-clazz r) (.-name (.-comp r)) nil true))

(go/method GetAccessor__Method
  "GetAccessor__Method is RecordComponent.getAccessor: the record's public accessor method of the component (a
new Method).\n"
  ^{:tag (* Method)} [^{:tag (* RecordComponent)} r]
  (let [m (.accessorInfo r)]
    (when (== m nil) (return nil))
    (newMethod (.-clazz r) m)))

(go/method GetType__Class
  "GetType__Class is RecordComponent.getType: the class of the component's descriptor; the accessor's return
type when the descriptor names a class outside the world.\n"
  ^{:tag (* Class)} [^{:tag (* RecordComponent)} r]
  (let [t (descClassOrNil (.-desc (.-comp r)))]
    (when (!= t nil) (return t))
    (let [m (.accessorInfo r)]
      (when (!= m nil) (return (.-Return m))))
    Object_class))

(go/method GetGenericSignature__String
  "GetGenericSignature__String is RecordComponent.getGenericSignature: the component's Signature, interned
(the VM's Symbol), or null.\n"
  ^{:tag (* String)} [^{:tag (* RecordComponent)} r]
  (when (== (.-sig (.-comp r)) "") (return nil))
  (Intern (.-sig (.-comp r))))

(go/method GetGenericType__Type
  "GetGenericType__Type is RecordComponent.getGenericType: without a Signature the type; else the Signature's
type in the record's scope (jdk26u's FieldRepository over it, through the component's field, which has the
same Signature, or the accessor's return type).\n"
  ^Type [^{:tag (* RecordComponent)} r]
  (when (== (.-sig (.-comp r)) "") (return (.GetType__Class r)))
  (let [c (.-clazz r)]
    (EnsureMembers (.-info c))
    (range [i _ (.-Fields (.-info c))]
      (let [f (addr (aget (.-Fields (.-info c)) i))]
        (when (and (== (.-Name f) (.-name (.-comp r))) (== (bit-and (.-Modifiers f) AccStatic) 0))
          (let [fr (ReflectSupport_FieldRepository_Field_String__O (newField c f) (Str (.-sig (.-comp r))))]
            (when (!= fr nil)
              (return (assert Type (ReflectSupport_GenericType_O__O fr))))))))
    (let [m (.GetAccessor__Method r)]
      (when (!= m nil) (return (.GetGenericReturnType__Type m))))
    (.GetType__Class r)))

(go/method ToString__String
  "ToString__String is RecordComponent.toString: the type's name, a space, the component's name.\n"
  ^{:tag (* String)} [^{:tag (* RecordComponent)} r]
  (Str (+ (typeName (.GetType__Class r)) " " (.-name (.-comp r)))))

;; AnnotatedElement: the A records

(go/method declaredAnnotationList ^{:tag (slice any)} [^{:tag (* RecordComponent)} r]
  (aget (.-members (annotations (.-clazz r))) (+ "A " (.-name (.-comp r)))))

(go/method Is_AnnotatedElement [^{:tag (* RecordComponent)} r])
(go/method GetAnnotation_Class__Annotation ^Annotation [^{:tag (* RecordComponent)} r ^{:tag (* Class)} a]
  (findAnnotation (.declaredAnnotationList r) (NN a)))
(go/method GetDeclaredAnnotation_Class__Annotation ^Annotation [^{:tag (* RecordComponent)} r ^{:tag (* Class)} a]
  (.GetAnnotation_Class__Annotation r a))
(go/method IsAnnotationPresent_Class__Z ^bool [^{:tag (* RecordComponent)} r ^{:tag (* Class)} a]
  (!= (.GetAnnotation_Class__Annotation r a) nil))
(go/method GetDeclaredAnnotations__Annotation1 ^{:tag (* RefArray)} [^{:tag (* RecordComponent)} r]
  (annotationArray Annotation_class (.declaredAnnotationList r)))
(go/method GetAnnotations__Annotation1 ^{:tag (* RefArray)} [^{:tag (* RecordComponent)} r]
  (.GetDeclaredAnnotations__Annotation1 r))
(go/method GetAnnotationsByType_Class__Annotation1 ^{:tag (* RefArray)} [^{:tag (* RecordComponent)} r ^{:tag (* Class)} a]
  (annotationArray (NN a) (directlyAndIndirectlyPresent (.declaredAnnotationList r) a)))
(go/method GetDeclaredAnnotationsByType_Class__Annotation1 ^{:tag (* RefArray)} [^{:tag (* RecordComponent)} r ^{:tag (* Class)} a]
  (.GetAnnotationsByType_Class__Annotation1 r a))

(go/method Ref ^any [^{:tag (* RecordComponent)} t] (when (== t nil) (return nil)) t)
(go/method GetClass__Class ^{:tag (* Class)} [^{:tag (* RecordComponent)} t] RecordComponent_class)
(go/method Clone__O ^any [^{:tag (* RecordComponent)} t] (panic (CloneNotSupported t)))

(go/func RecordComponent_InstanceOf ^bool [^any x] (let [(values _ ok) (assert (* RecordComponent) x)] ok))
(go/func RecordComponent_Cast ^{:tag (* RecordComponent)} [^any x]
  (when (== x nil) (return nil))
  (let [(values v ok) (assert (* RecordComponent) x)]
    (when (not ok) (panic (ClassCast x RecordComponent_class)))
    v))

(go/func init []
  (set! (.-IsInstance (.Info RecordComponent_class)) RecordComponent_InstanceOf))

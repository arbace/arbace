;; jrt: the system call numbers Go's syscall package does not name, for nio_fs_linux.ae (F9) on linux/arm64:
;; statx(2) and copy_file_range(2), the kernel's (arch/.../syscall tables). Copyright (c) the Arbace authors;
;; Eclipse Public License 1.0.
(in-ns 'go.arbace.jrt)

(go/file "nio_fs_linux_arm64.go"
  :build ["//go:build linux && arm64"])

(go/const
  [^{:tag uintptr :val 291} sysStatx 291]
  [^{:tag uintptr :val 285} sysCopyFileRange 285])

;; jrt: java.lang.System and java.lang.Runtime over the host (J2G-SPEC §9.4; doc/go/
;; JRT-NOTES.md, phase 2a): the clocks, system properties, the environment, exit, the
;; standard error behind printStackTrace. System.arraycopy and identityHashCode are in
;; array.go; System.in, out and err (PrintStream, InputStream) come with those classes, over
;; the host streams Stdin, Stdout, Stderr (host.go).
(in-ns 'go.arbace.jrt)

(go/file "system.go"
  :imports [[runtime "runtime"] [debug "runtime/debug"] [sort "sort"] [strconv "strconv"]
            [strings "strings"] [sync "sync"]])

(go/var ^{:doc "System_class is java.lang.System's Class object: reflection reaches its static members
through the member table (reflect_tables.go; the REPL's System/getProperty), System.in, out
and err through j2g's support, which defines them.\n"}
  System_class
  (Define (addr (lit ClassInfo :Name "java.lang.System" :Kind KindClass
                     :Modifiers (bit-or AccPublic AccFinal) :Super Object_class :Go "arbace/jrt.System"))))

;; ---------------------------------------------------------------------------------------
;; The clocks and the environment

(go/func System_NanoTime__J "System_NanoTime__J is System.nanoTime: the host's monotonic clock.\n"
  ^int64 []
  (.Nanotime (CurrentHost)))

(go/func System_CurrentTimeMillis__J "System_CurrentTimeMillis__J is System.currentTimeMillis.\n"
  ^int64 []
  (.UnixMilli (.Now (CurrentHost))))

(go/func System_Getenv_String__String
  "System_Getenv_String__String is System.getenv(String): null when the variable is not set.\n"
  ^{:tag (* String)} [^{:tag (* String)} name]
  (let [(values v ok) (.Getenv (CurrentHost) (.String (NN name)))]
    (when (not ok)
      (return nil))
    (Str v)))

(go/func System_Exit_I__V
  "System_Exit_I__V is System.exit (and Runtime.exit): the host ends the process; the
shutdown hooks registered with jrt run first.\n"
  [^int32 status]
  (runShutdownHooks)
  (.Exit (CurrentHost) (conv int status)))

(go/func System_Gc__V "System_Gc__V is System.gc: runtime.GC.\n" []
  (runtime/GC))

(go/func System_LineSeparator__String "System_LineSeparator__String is System.lineSeparator: \\n.\n"
  ^{:tag (* String)} []
  lineSeparator)

(go/var lineSeparator (Intern "\n"))

;; ---------------------------------------------------------------------------------------
;; System properties: initialized from the host on first use, as the JVM's (the values a
;; Java program on Linux reads, where they mean something here)

(go/var ^{:tag sync/Mutex} propMu)
(go/var ^{:tag (map string (* String))} props)

(go/func osArch ^string []
  (switch runtime/GOARCH
    (case ["arm64"] (return "aarch64"))
    (default (return runtime/GOARCH))))

(go/func initProps "initProps fills the properties (propMu held).\n" []
  (when (!= props nil)
    (return))
  (set! props (make (map string (* String))))
  (let [h (CurrentHost)
        set (fn [^string k ^string v] (aset props k (Str v)))
        env (fn ^string [^string k ^string dflt]
              (let [(values v ok) (.Getenv h k)]
                (when (and ok (!= v ""))
                  (return v))
                dflt))]
    ;; JCS192 (a): the JDK build's version (the platform's: jdk26u's build at the pin, its release file's
    ;; JAVA_VERSION and JAVA_RUNTIME_VERSION), as VersionProps sets them from it
    (set "java.version" jdkVersionShort)
    (set "java.version.date" jdkVersionDate)
    (set "java.specification.version" "26")
    (set "java.vm.specification.version" "26")
    (set "java.class.version" "70.0")
    (set "java.vendor" "Arbace")
    (set "java.vm.name" "jrt")
    (set "java.vm.vendor" "Arbace")
    (set "java.runtime.name" "Arbace on Go")
    ;; F16 (doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: F16 (write-ahead)"): the version and
    ;; specification properties every JDK sets (System.getProperties' list): the runtime's and the
    ;; VM's versions are the feature release, as java.version is; the specifications' names and
    ;; vendor are the Java SE specifications', the JDK's values
    (set "java.runtime.version" jdkVersionString)
    (set "java.vm.version" jdkVersionString)
    (set "java.specification.name" "Java Platform API Specification")
    (set "java.specification.vendor" "Oracle Corporation")
    (set "java.vm.specification.name" "Java Virtual Machine Specification")
    (set "java.vm.specification.vendor" "Oracle Corporation")
    (set "java.home" "")
    (set "java.class.path" "")
    (set "java.library.path" "")
    (set "os.name" (+ (strings/ToUpper (subslice runtime/GOOS 0 1)) (subslice runtime/GOOS 1)))
    (set "os.arch" (osArch))
    (set "os.version" "")
    (set "file.separator" "/")
    (set "path.separator" ":")
    (set "line.separator" "\n")
    (set "file.encoding" "UTF-8")
    (set "native.encoding" "UTF-8")
    (set "sun.jnu.encoding" "UTF-8")
    (set "stdout.encoding" "UTF-8")
    (set "stderr.encoding" "UTF-8")
    (set "stdin.encoding" "UTF-8")
    ;; the default locale (jdk26u's Locale reads it through StaticProperty: JRT-NOTES.md, "Text
    ;; and locales"): en_US, as a JVM started in an English, US environment (C.UTF-8 too);
    ;; JAVA_TOOL_OPTIONS' -Duser.language=... -Duser.country=... set another, as on the JVM
    (set "user.language" "en")
    (set "user.country" "US")
    (set "java.io.tmpdir" (env "TMPDIR" "/tmp"))
    (set "user.home" (env "HOME" "?"))
    (set "user.name" (env "USER" "?"))
    (let [(values wd err) (.Getwd h)]
      (if (== err nil)
        (set "user.dir" wd)
        (set "user.dir" "/")))
    (set "go.version" (runtime/Version))
    ;; JAVA_TOOL_OPTIONS' -D options, as the JVM takes them (tooloptions.ae)
    (toolOptionProps h set)))

(go/func checkKey ^string [^{:tag (* String)} key]
  (when (== key nil)
    (panic (NullPointerException_New_String (Str "key can't be null"))))
  (when (== (.Length__I key) 0)
    (panic (IllegalArgumentException_New_String (Str "key can't be empty"))))
  (.String key))

(go/func System_GetProperty_String__String "System_GetProperty_String__String is System.getProperty(String).\n"
  ^{:tag (* String)} [^{:tag (* String)} key]
  (let [k (checkKey key)]
    (.Lock propMu)
    (initProps)
    (let [v (aget props k)]
      (.Unlock propMu)
      v)))

(go/func System_GetProperty_String_String__String
  "System_GetProperty_String_String__String is System.getProperty(String, String).\n"
  ^{:tag (* String)} [^{:tag (* String)} key ^{:tag (* String)} def]
  (let [v (System_GetProperty_String__String key)]
    (when (== v nil)
      (return def))
    v))

(go/func System_SetProperty_String_String__String
  "System_SetProperty_String_String__String is System.setProperty: the previous value.\n"
  ^{:tag (* String)} [^{:tag (* String)} key ^{:tag (* String)} value]
  (let [k (checkKey key)]
    (when (== value nil)
      (panic (NPE)))
    (.Lock propMu)
    (initProps)
    (let [old (aget props k)]
      (aset props k value)
      (.Unlock propMu)
      old)))

(go/func System_ClearProperty_String__String
  "System_ClearProperty_String__String is System.clearProperty: the previous value.\n"
  ^{:tag (* String)} [^{:tag (* String)} key]
  (let [k (checkKey key)]
    (.Lock propMu)
    (initProps)
    (let [old (aget props k)]
      (delete props k)
      (.Unlock propMu)
      old)))

(go/func PropertyNames
  "PropertyNames lists the system properties' names, sorted (System.getProperties waits for
the translated Properties).\n"
  ^{:tag (slice string)} []
  (.Lock propMu)
  (initProps)
  (let [ks (make (slice string) 0 (len props))]
    (range [k props]
      (set! ks (append ks k)))
    (.Unlock propMu)
    (sort/Strings ks)
    ks))

;; ---------------------------------------------------------------------------------------
;; Runtime (leaf; Runtime.getRuntime's one instance)

(go/type Runtime (struct Object))

(go/var Runtime_class
  (Define (addr (lit ClassInfo :Name "java.lang.Runtime" :Kind KindClass :Modifiers AccPublic
                     :Super Object_class :Go "arbace/jrt.Runtime"))))

(go/var theRuntime (addr (lit Runtime)))

(go/func Runtime_GetRuntime__Runtime "Runtime_GetRuntime__Runtime is Runtime.getRuntime().\n"
  ^{:tag (* Runtime)} []
  theRuntime)

(go/method AvailableProcessors__I "AvailableProcessors__I is the host's processor count.\n"
  ^int32 [^{:tag (* Runtime)} r]
  (conv int32 (.NumCPU (CurrentHost))))

(go/method FreeMemory__J "FreeMemory__J: the heap's free bytes (HeapIdle).\n" ^int64 [^{:tag (* Runtime)} r]
  (let [^runtime/MemStats m (zero runtime/MemStats)]
    (runtime/ReadMemStats (addr m))
    (conv int64 (- (.-HeapSys m) (.-HeapInuse m)))))

(go/method TotalMemory__J "TotalMemory__J: the heap's bytes obtained from the system.\n" ^int64 [^{:tag (* Runtime)} r]
  (let [^runtime/MemStats m (zero runtime/MemStats)]
    (runtime/ReadMemStats (addr m))
    (conv int64 (.-HeapSys m))))

(go/method MaxMemory__J "MaxMemory__J: the memory limit (GOMEMLIMIT), Long.MAX_VALUE without one.\n"
  ^int64 [^{:tag (* Runtime)} r]
  (debug/SetMemoryLimit -1))

(go/method Gc__V [^{:tag (* Runtime)} r] (runtime/GC))
(go/method Exit_I__V [^{:tag (* Runtime)} r ^int32 status] (System_Exit_I__V status))
(go/method Halt_I__V "Halt_I__V is Runtime.halt: exit without the shutdown hooks.\n"
  [^{:tag (* Runtime)} r ^int32 status]
  (.Exit (CurrentHost) (conv int status)))

(go/method AddShutdownHook_Thread__V
  "AddShutdownHook_Thread__V is Runtime.addShutdownHook: the hook runs at System.exit, or when
RunMain's main and the non-daemon threads have ended.\n"
  [^{:tag (* Runtime)} r ^Thread_I hook]
  (let [t (.Self_Thread (nnIface hook))]
    (when (!= (.Load (.-state t)) threadNew)
      (panic (IllegalArgumentException_New_String (Str "Hook already running"))))
    (.Lock hookMu)
    (defer (.Unlock hookMu))
    (range [_ h hooks]
      (when (== h t)
        (panic (IllegalArgumentException_New_String (Str "Hook previously registered")))))
    (set! hooks (append hooks t))))

(go/method Ref ^any [^{:tag (* Runtime)} t] (when (== t nil) (return nil)) t)
(go/method GetClass__Class ^{:tag (* Class)} [^{:tag (* Runtime)} t] Runtime_class)
(go/method Clone__O ^any [^{:tag (* Runtime)} t] (panic (CloneNotSupported t)))
(go/method ToString__String ^{:tag (* String)} [^{:tag (* Runtime)} t] (Object_toString t))

(go/func Runtime_InstanceOf ^bool [^any x] (let [(values _ ok) (assert (* Runtime) x)] ok))

;; ---------------------------------------------------------------------------------------
;; Runtime.Version (leaf): Runtime.version(), the running Java's version, which javax.lang.model's
;; SourceVersion reads (javac's latest supported release; doc/classes/JAVA-FRONTEND-SURVEY.md,
;; "As built: JN2"). Since JCS192 (a) (the user, 2026-11-08; doc/classes/JAVA-DEFERRED-TRIAGE.md, "As
;; built: JCS192") the JDK build's (the platform's jdk26u build: Version.parse of its
;; JAVA_RUNTIME_VERSION, 26.0.2.1-internal-adhoc.root.jdk26u: the numbers 26.0.2.1, pre-release
;; "internal", no build, optional "adhoc.root.jdk26u"), the java.version properties made from it as
;; VersionProps makes them, and a java.base frame's module version its short form (java.base's
;; descriptor's, 26.0.2.1-internal: throwable.ae's frameElement). jdk26u's toString, equals, compareTo
;; and hashCode over the parts; a version made by jrt without them (n 0) is its numbers with the trailing
;; zeros left out, as before. Not here: parse, version(), pre, build, optional (their types are
;; translated classes).

(go/const
  [^{:tag string :doc "the JDK build's version string (VERSION_STRING; java.runtime.version)\n"} jdkVersionString
   "26.0.2.1-internal-adhoc.root.jdk26u"]
  [^{:tag string :doc "its short form (VERSION_SHORT; java.version, java.base's module version)\n"} jdkVersionShort
   "26.0.2.1-internal"]
  [^{:tag string :doc "its date (java.version.date)\n"} jdkVersionDate "2026-08-18"])

(go/type Runtime_Version
  (struct Object ^int32 feature ^int32 interim ^int32 update ^int32 patch
          ^{:tag int :doc "the numbers' count as parsed (0: the numbers without trailing zeros)\n"} n
          ^string pre ^bool hasPre ^string opt ^bool hasOpt))

(go/var Runtime_Version_class
  (Define (addr (lit ClassInfo :Name "java.lang.Runtime$Version" :Kind KindClass
                     :Modifiers (bit-or AccPublic AccStatic AccFinal) :Super Object_class
                     :Interfaces (lit (slice (* Class)) Comparable_class)
                     :Go "arbace/jrt.Runtime_Version"))))

(go/var theVersion (addr (lit Runtime_Version :feature 26 :update 2 :patch 1 :n 4
                              :pre "internal" :hasPre true :opt "adhoc.root.jdk26u" :hasOpt true)))

(go/func Runtime_Version__Runtime_Version
  "Runtime_Version__Runtime_Version is Runtime.version(): the JDK build's version (JCS192).\n"
  ^{:tag (* Runtime_Version)} []
  theVersion)

(go/method Feature__I ^int32 [^{:tag (* Runtime_Version)} v] (.-feature v))
(go/method Interim__I ^int32 [^{:tag (* Runtime_Version)} v] (.-interim v))
(go/method Update__I ^int32 [^{:tag (* Runtime_Version)} v] (.-update v))
(go/method Patch__I ^int32 [^{:tag (* Runtime_Version)} v] (.-patch v))

(go/func versionDigits "versionDigits tells whether s matches \\d+ (Version.comparePre).\n" ^bool [^string s]
  (when (== s "")
    (return false))
  (range [_ c s]
    (when (or (< c \0) (> c \9))
      (return false)))
  true)

(go/func versionNumCompare
  "versionNumCompare compares two digit strings as BigIntegers.\n"
  ^int32 [^string a ^string b]
  (set! a (strings/TrimLeft a "0"))
  (set! b (strings/TrimLeft b "0"))
  (cond
    (< (len a) (len b)) (return -1)
    (> (len a) (len b)) (return 1)
    (< a b) (return -1)
    (> a b) (return 1))
  0)

(go/method CompareTo_Runtime_Version__I
  "CompareTo_Runtime_Version__I is Version.compareTo: the numbers (each, then their count), the pre-release
(none above one; digits as numbers, below letters; else String.compareTo), the build, the optional part.\n"
  ^int32 [^{:tag (* Runtime_Version)} v ^{:tag (* Runtime_Version)} o]
  (when (== o nil) (panic (NPE)))
  (let [a (.numbers v)
        b (.numbers o)
        m (min (len a) (len b))]
    (for [i 0] (< i m) (inc! i)
      (when (!= (aget a i) (aget b i))
        (return (- (aget a i) (aget b i)))))
    (when (!= (len a) (len b))
      (return (conv int32 (- (len a) (len b))))))
  (cond
    (and (not (.-hasPre v)) (.-hasPre o)) (return 1)
    (and (.-hasPre v) (not (.-hasPre o))) (return -1)
    (.-hasPre v)
    (let [x (.-pre v) y (.-pre o)]
      (cond
        (versionDigits x) (if (versionDigits y) (when (!= (versionNumCompare x y) 0) (return (versionNumCompare x y))) (return -1))
        (versionDigits y) (return 1)
        :else (let [c (.CompareTo_String__I (Str x) (Str y))] (when (!= c 0) (return c))))))
  (cond
    (and (not (.-hasOpt v)) (.-hasOpt o)) (return -1)
    (and (.-hasOpt v) (not (.-hasOpt o))) (return 1)
    (.-hasOpt v) (return (.CompareTo_String__I (Str (.-opt v)) (Str (.-opt o)))))
  0)

(go/method CompareTo_O__I ^int32 [^{:tag (* Runtime_Version)} v ^any o]
  (.CompareTo_Runtime_Version__I v (Runtime_Version_Cast o)))

(go/method Equals_O__Z "Equals_O__Z is Version.equals: the numbers as a list, the pre-release, the build and the
optional part equal.\n"
  ^bool [^{:tag (* Runtime_Version)} v ^any o]
  (let [(values w ok) (assert (* Runtime_Version) o)]
    (when (or (not ok) (== w nil))
      (return false))
    (let [a (.numbers v) b (.numbers w)]
      (when (!= (len a) (len b))
        (return false))
      (range [i _ a]
        (when (!= (aget a i) (aget b i))
          (return false))))
    (and (== (.-hasPre v) (.-hasPre w)) (== (.-pre v) (.-pre w))
         (== (.-hasOpt v) (.-hasOpt w)) (== (.-opt v) (.-opt w)))))

(go/method HashCode__I
  "HashCode__I is Version.hashCode: h = 1, then h = 17 * h + each part's hash: the numbers' list, the pre-release,
the build and the optional part (an Optional's: its value's hash, 0 when empty).\n"
  ^int32 [^{:tag (* Runtime_Version)} v]
  (let [lh (conv int32 1)
        h (conv int32 1)
        ph (conv int32 0)
        oh (conv int32 0)]
    (range [_ x (.numbers v)]
      (set! lh (+ (* 31 lh) x)))
    (when (.-hasPre v)
      (set! ph (.HashCode__I (Str (.-pre v)))))
    (when (.-hasOpt v)
      (set! oh (.HashCode__I (Str (.-opt v)))))
    (set! h (+ (* 17 h) lh))
    (set! h (+ (* 17 h) ph))
    (set! h (* 17 h))
    (set! h (+ (* 17 h) oh))
    h))

(go/method numbers "numbers: the version's numbers as parsed (n of them), or without trailing zeros (the feature kept).\n"
  ^{:tag (slice int32)} [^{:tag (* Runtime_Version)} v]
  (let [ns (lit (slice int32) (.-feature v) (.-interim v) (.-update v) (.-patch v))
        n (len ns)]
    (when (> (.-n v) 0)
      (return (subslice ns _ (.-n v))))
    (while (and (> n 1) (== (aget ns (- n 1)) 0))
      (dec! n))
    (subslice ns _ n)))

(go/method ToString__String "ToString__String is Version.toString: the numbers joined by dots, -PRE, then the optional
part after - (after +- without a pre-release; no build here).\n"
  ^{:tag (* String)} [^{:tag (* Runtime_Version)} v]
  (let [^{:tag (slice string)} ps nil]
    (range [_ x (.numbers v)]
      (set! ps (append ps (strconv/Itoa (conv int x)))))
    (let [s (strings/Join ps ".")]
      (when (.-hasPre v)
        (set! s (+ s "-" (.-pre v))))
      (when (.-hasOpt v)
        (if (.-hasPre v)
          (set! s (+ s "-" (.-opt v)))
          (set! s (+ s "+-" (.-opt v)))))
      (Str s))))

(go/method Ref ^any [^{:tag (* Runtime_Version)} t] (when (== t nil) (return nil)) t)
(go/method GetClass__Class ^{:tag (* Class)} [^{:tag (* Runtime_Version)} t] Runtime_Version_class)
(go/method Clone__O ^any [^{:tag (* Runtime_Version)} t] (panic (CloneNotSupported t)))
(go/method Is_Comparable [^{:tag (* Runtime_Version)} t])

(go/func Runtime_Version_InstanceOf ^bool [^any x] (let [(values _ ok) (assert (* Runtime_Version) x)] ok))
(go/func Runtime_Version_Cast ^{:tag (* Runtime_Version)} [^any x]
  (when (== x nil) (return nil))
  (let [(values v ok) (assert (* Runtime_Version) x)]
    (when (not ok) (panic (ClassCast x Runtime_Version_class)))
    v))

(go/var ^{:tag sync/Mutex} hookMu)
(go/var ^{:tag (slice (* Thread))} hooks)

(go/func runShutdownHooks "runShutdownHooks starts every hook and joins them (once).\n" []
  (.Lock hookMu)
  (let [hs hooks]
    (set! hooks nil)
    (.Unlock hookMu)
    (range [_ h hs]
      (.Start__V (.-self h)))
    (range [_ h hs]
      (runCatching (fn [] (.join h -1))))))

;; ---------------------------------------------------------------------------------------
;; The standard error of printStackTrace and uncaught exceptions: the host's (Stderr), until
;; PrintStream exists and System.err can be set

(go/func init []
  (set! (.-IsInstance (.Info Runtime_class)) Runtime_InstanceOf)
  (set! (.-IsInstance (.Info Runtime_Version_class)) Runtime_Version_InstanceOf)
  (set! StderrPrint (fn [^string s] (.WriteString Stderr s))))

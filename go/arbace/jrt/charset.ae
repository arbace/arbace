;; jrt: String's Charset overloads and its charset-name overloads (F8, "As built: F8" of
;; doc/classes/JAVA-DEFERRED-TRIAGE.md; doc/go/JRT-NOTES.md, "Phase 2b"). java.nio.charset and sun.nio.cs
;; are jdk26u's, translated by j2g (jrt's stand-in for jrt's own build: standin_charset.ae), so these
;; overloads are written against what both give: Charset_I, the instances of sun.nio.cs.UTF_8,
;; ISO_8859_1 and US_ASCII, and jdk.internal.jrt.CharsetStrings (overlay/jdk), the translated class in a
;; program. The JDK's fast paths, by identity with those instances, are phase 1's coding (codec.ae:
;; DecodeUTF8, EncodeUTF8, decodeKind, encodeKind); any other charset, the UTF-16 family included, goes
;; through CharsetStrings' decoder and encoder. The name overloads take the six names of codec.ae's table
;; the same way and look any other name up in CharsetStrings (UnsupportedEncodingException).
(in-ns 'go.arbace.jrt)

(go/file "charset.go")

(go/func String_New_B1_Charset
  "String_New_B1_Charset is new String(byte[], Charset): malformed input replaced as the
charset's decoder replaces it.\n"
  ^{:tag (* String)} [^{:tag (* ByteArray)} b ^Charset_I cs]
  (when (== cs nil)
    (panic (NPE)))
  (String_New_B1_I_I_Charset b 0 (conv int32 (len (.-A (NN b)))) cs))

(go/func String_New_B1_I_I_Charset
  "String_New_B1_I_I_Charset is new String(byte[], int offset, int length, Charset).\n"
  ^{:tag (* String)} [^{:tag (* ByteArray)} b ^int32 offset ^int32 length ^Charset_I cs]
  (when (== cs nil)
    (panic (NPE)))
  (checkFromSize offset length (len (.-A (NN b))))
  (let [p (subslice (.-A b) offset (+ offset length))]
    (cond (== cs UTF_8_INSTANCE) (return (newString (decodeKind p csUTF8)))
          (== cs ISO_8859_1_INSTANCE) (return (newString (decodeKind p csLatin1)))
          (== cs US_ASCII_INSTANCE) (return (newString (decodeKind p csASCII)))))
  (CharsetStrings_Decode_B1_I_I_Charset__String b offset length cs))

(go/func encodedBytes "encodedBytes is v coded by a charset of jrt's table, as byte[].\n"
  ^{:tag (* ByteArray)} [^{:tag (slice uint16)} v ^int kind]
  (let [(values dst _) (encodeKind v kind)]
    (ByteArrayOf (spread dst))))

(go/method GetBytes_Charset__B1
  "GetBytes_Charset__B1 is String.getBytes(Charset): unmappable characters as '?'.\n"
  ^{:tag (* ByteArray)} [^{:tag (* String)} t ^Charset_I cs]
  (when (== cs nil)
    (panic (NPE)))
  (cond (== cs UTF_8_INSTANCE) (return (encodedBytes (.-value t) csUTF8))
        (== cs ISO_8859_1_INSTANCE) (return (encodedBytes (.-value t) csLatin1))
        (== cs US_ASCII_INSTANCE) (return (encodedBytes (.-value t) csASCII)))
  (CharsetStrings_Encode_String_Charset__B1 t cs))

(go/func String_New_B1_I_I_String
  "String_New_B1_I_I_String is new String(byte[], offset, length, String charsetName): jrt's six names
coded here, any other through its charset.\n"
  ^{:tag (* String)} [^{:tag (* ByteArray)} b ^int32 offset ^int32 length ^{:tag (* String)} charset]
  (NN charset)
  (checkFromSize offset length (len (.-A (NN b))))
  (let [kind (charsetOf charset)]
    (when (!= kind csUnknown)
      (return (newString (decodeKind (subslice (.-A b) offset (+ offset length)) kind)))))
  (String_New_B1_I_I_Charset b offset length (CharsetStrings_Lookup_String__Charset charset)))

(go/func String_New_B1_String ^{:tag (* String)} [^{:tag (* ByteArray)} b ^{:tag (* String)} charset]
  (NN charset)
  (String_New_B1_I_I_String b 0 (conv int32 (len (.-A (NN b)))) charset))

(go/method GetBytes_String__B1 ^{:tag (* ByteArray)} [^{:tag (* String)} t ^{:tag (* String)} charset]
  (let [kind (charsetOf (NN charset))]
    (when (!= kind csUnknown)
      (return (encodedBytes (.-value t) kind))))
  (.GetBytes_Charset__B1 t (CharsetStrings_Lookup_String__Charset charset)))

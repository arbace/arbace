(in-ns 'go.arbace.jrt)

;; jrt: String's Locale overloads (doc/go/JRT-NOTES.md, "Phase 2b" and "Text and locales"). The
;; Locale is jdk26u's, translated by j2g (jrt's own build has a stand-in, standin_locale.ae);
;; java.text's DecimalFormatSymbols is jdk26u's too. The case mapping is the root locale's, with
;; the Turkish and Azerbaijani dotted and dotless i (ConditionalSpecialCasing's tr and az
;; entries) and, since n-java-defer (round 54), the Lithuanian ones (its lt entries).

(go/file "locale.go")

;; ---------------------------------------------------------------------------------------
;; String's Locale overloads: the root locale's case mapping, and Turkish and Azerbaijani's i
;; (JDK: StringUTF16.toLowerCase/toUpperCase with ConditionalSpecialCasing for tr and az): a
;; capital I lowers to dotless ı unless a combining dot above (U+0307) follows it, which then
;; goes; İ lowers to i; i uppers to İ. The dot is looked for right after the I (the JDK skips
;; combining marks of other classes between them).

(go/func turkic ^bool [^{:tag (* Locale)} l]
  (let [lang (.String (.GetLanguage__String l))]
    (or (== lang "tr") (== lang "az"))))

(go/method ToLowerCase_Locale__String ^{:tag (* String)} [^{:tag (* String)} t ^{:tag (* Locale)} l]
  (NN l)
  (when (lithuanian l)
    (return (.ToLowerCase__String (newString (ltLower (.-value t))))))
  (when (not (turkic l))
    (return (.ToLowerCase__String t)))
  (let [v (.-value t)
        out (make (slice uint16) 0 (len v))]
    (range [i c v]
      (cond
        (== c 0x0130) (set! out (append out 0x0069))
        (== c 0x0049) (if (and (< (+ i 1) (len v)) (== (aget v (+ i 1)) 0x0307))
                        (set! out (append out 0x0069))
                        (set! out (append out 0x0131)))
        (not (and (== c 0x0307) (> i 0) (== (aget v (- i 1)) 0x0049))) (set! out (append out c))))
    (.ToLowerCase__String (newString out))))

(go/method ToUpperCase_Locale__String ^{:tag (* String)} [^{:tag (* String)} t ^{:tag (* Locale)} l]
  (NN l)
  (when (lithuanian l)
    (return (.ToUpperCase__String (newString (ltUpper (.-value t))))))
  (when (not (turkic l))
    (return (.ToUpperCase__String t)))
  (let [v (.-value t)
        out (make (slice uint16) (len v))]
    (range [i c v]
      (if (== c 0x0069)
        (aset out i 0x0130)
        (aset out i c)))
    (.ToUpperCase__String (newString out))))

;; ---------------------------------------------------------------------------------------
;; Lithuanian (jdk26u's java/lang/ConditionalSpecialCasing.java, its lt entries, at baf63fbe4): lowering, I, J and
;; I with ogonek take a combining dot above when a mark of combining class 230 (ABOVE) follows them in their
;; combining sequence (More_Above), and I with grave, acute or tilde lower to i, the dot and their accent; uppering,
;; a combining dot above after a soft-dotted letter goes (After_Soft_Dotted). The rest is the root locale's
;; (the caller lowers or uppers the result).

(go/func lithuanian ^bool [^{:tag (* Locale)} l]
  (== (.String (.GetLanguage__String l)) "lt"))

(go/var ^{:tag (slice int32)
          :doc "cccRanges: the code points of a nonzero canonical combining class, as triples lo hi k (k 230 for ABOVE, else 1),\nin order, from jdk26u's src/java.base/share/data/unicodedata/UnicodeData.txt (baf63fbe4).\n"}
  cccRanges
  (lit (slice int32)
  0x300 0x314 230  0x315 0x33C 1  0x33D 0x344 230  0x345 0x345 1  0x346 0x346 230  0x347 0x349 1  0x34A 0x34C 230
  0x34D 0x34E 1  0x350 0x352 230  0x353 0x356 1  0x357 0x357 230  0x358 0x35A 1  0x35B 0x35B 230  0x35C 0x362 1
  0x363 0x36F 230  0x483 0x487 230  0x591 0x591 1  0x592 0x595 230  0x596 0x596 1  0x597 0x599 230  0x59A 0x59B 1
  0x59C 0x5A1 230  0x5A2 0x5A7 1  0x5A8 0x5A9 230  0x5AA 0x5AA 1  0x5AB 0x5AC 230  0x5AD 0x5AE 1  0x5AF 0x5AF 230
  0x5B0 0x5BD 1  0x5BF 0x5BF 1  0x5C1 0x5C2 1  0x5C4 0x5C4 230  0x5C5 0x5C5 1  0x5C7 0x5C7 1  0x610 0x617 230
  0x618 0x61A 1  0x64B 0x652 1  0x653 0x654 230  0x655 0x656 1  0x657 0x65B 230  0x65C 0x65C 1  0x65D 0x65E 230
  0x65F 0x65F 1  0x670 0x670 1  0x6D6 0x6DC 230  0x6DF 0x6E2 230  0x6E3 0x6E3 1  0x6E4 0x6E4 230  0x6E7 0x6E8 230
  0x6EA 0x6EA 1  0x6EB 0x6EC 230  0x6ED 0x6ED 1  0x711 0x711 1  0x730 0x730 230  0x731 0x731 1  0x732 0x733 230
  0x734 0x734 1  0x735 0x736 230  0x737 0x739 1  0x73A 0x73A 230  0x73B 0x73C 1  0x73D 0x73D 230  0x73E 0x73E 1
  0x73F 0x741 230  0x742 0x742 1  0x743 0x743 230  0x744 0x744 1  0x745 0x745 230  0x746 0x746 1  0x747 0x747 230
  0x748 0x748 1  0x749 0x74A 230  0x7EB 0x7F1 230  0x7F2 0x7F2 1  0x7F3 0x7F3 230  0x7FD 0x7FD 1  0x816 0x819 230

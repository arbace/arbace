  0x1ABD 0x1ABD 1  0x1ABF 0x1AC0 1  0x1AC1 0x1AC2 230  0x1AC3 0x1AC4 1  0x1AC5 0x1AC9 230  0x1ACA 0x1ACA 1
  0x1ACB 0x1ADC 230  0x1ADD 0x1ADD 1  0x1AE0 0x1AE5 230  0x1AE6 0x1AE6 1  0x1AE7 0x1AEA 230  0x1AEB 0x1AEB 1
  0x1B34 0x1B34 1  0x1B44 0x1B44 1  0x1B6B 0x1B6B 230  0x1B6C 0x1B6C 1  0x1B6D 0x1B73 230  0x1BAA 0x1BAB 1
  0x1BE6 0x1BE6 1  0x1BF2 0x1BF3 1  0x1C37 0x1C37 1  0x1CD0 0x1CD2 230  0x1CD4 0x1CD9 1  0x1CDA 0x1CDB 230
  0x1CDC 0x1CDF 1  0x1CE0 0x1CE0 230  0x1CE2 0x1CE8 1  0x1CED 0x1CED 1  0x1CF4 0x1CF4 230  0x1CF8 0x1CF9 230
  0x1DC0 0x1DC1 230  0x1DC2 0x1DC2 1  0x1DC3 0x1DC9 230  0x1DCA 0x1DCA 1  0x1DCB 0x1DCC 230  0x1DCD 0x1DD0 1

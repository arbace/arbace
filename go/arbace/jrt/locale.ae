  0x10A39 0x10A3A 1  0x10A3F 0x10A3F 1  0x10AE5 0x10AE5 230  0x10AE6 0x10AE6 1  0x10D24 0x10D27 230
  0x10D69 0x10D6D 230  0x10EAB 0x10EAC 230  0x10EFA 0x10EFB 1  0x10EFD 0x10EFF 1  0x10F46 0x10F47 1
  0x10F48 0x10F4A 230  0x10F4B 0x10F4B 1  0x10F4C 0x10F4C 230  0x10F4D 0x10F50 1  0x10F82 0x10F82 230
  0x10F83 0x10F83 1  0x10F84 0x10F84 230  0x10F85 0x10F85 1  0x11046 0x11046 1  0x11070 0x11070 1  0x1107F 0x1107F 1
  0x110B9 0x110BA 1  0x11100 0x11102 230  0x11133 0x11134 1  0x11173 0x11173 1  0x111C0 0x111C0 1  0x111CA 0x111CA 1
  0x11235 0x11236 1  0x112E9 0x112EA 1  0x1133B 0x1133C 1  0x1134D 0x1134D 1  0x11366 0x1136C 230
  0x11370 0x11374 230  0x113CE 0x113D0 1  0x11442 0x11442 1  0x11446 0x11446 1  0x1145E 0x1145E 230

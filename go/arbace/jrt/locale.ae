  0x1E4EF 0x1E4EF 230  0x1E5EE 0x1E5EE 230  0x1E5EF 0x1E5EF 1  0x1E6E3 0x1E6E3 230  0x1E6E6 0x1E6E6 230
  0x1E6EE 0x1E6EF 230  0x1E6F5 0x1E6F5 230  0x1E8D0 0x1E8D6 1  0x1E944 0x1E949 230  0x1E94A 0x1E94A 1))

(go/func cccKind "cccKind: 0 for combining class 0, 230 for ABOVE, else 1 (Normalizer.getCombiningClass's buckets).\n"
  ^int32 [^rune c]
  (let [lo 0
        hi (/ (len cccRanges) 3)]
    (while (< lo hi)
      (let [m (/ (+ lo hi) 2)]
        (cond
          (< c (aget cccRanges (* m 3))) (set! hi m)
          (> c (aget cccRanges (+ (* m 3) 1))) (set! lo (+ m 1))
          :else (return (aget cccRanges (+ (* m 3) 2))))))
    0))

(go/func cpAt16 ^rune [^{:tag (slice uint16)} v ^int i]
  (let [c (aget v i)]
    (when (and (isHighSurrogate c) (< (+ i 1) (len v)) (isLowSurrogate (aget v (+ i 1))))
      (return (toCodePoint c (aget v (+ i 1)))))
    (conv rune c)))

(go/func cpBefore16 ^rune [^{:tag (slice uint16)} v ^int i]
  (let [c (aget v (- i 1))]
    (when (and (isLowSurrogate c) (>= (- i 2) 0) (isHighSurrogate (aget v (- i 2))))
      (return (toCodePoint (aget v (- i 2)) c)))
    (conv rune c)))

(go/func cpLen ^int [^rune c]
  (when (> c 0xFFFF)
    (return 2))
  1)

(go/func ltMoreAbove "ltMoreAbove: More_Above at v's char i (ConditionalSpecialCasing.isMoreAbove).\n"
  ^bool [^{:tag (slice uint16)} v ^int i]
  (for [j (+ i 1)] (< j (len v)) _
    (let [c (cpAt16 v j)
          k (cccKind c)]
      (cond
        (== k 230) (return true)
        (== k 0) (return false))
      (set! j (+ j (cpLen c)))))
  false)

(go/func ltSoftDotted ^bool [^rune c]
  (or (== c 0x0069) (== c 0x006A) (== c 0x012F) (== c 0x0268) (== c 0x0456) (== c 0x0458)
      (== c 0x1D62) (== c 0x1E2D) (== c 0x1ECB) (== c 0x2071)))

(go/func ltAfterSoftDotted "ltAfterSoftDotted: After_Soft_Dotted at v's char i (ConditionalSpecialCasing.isAfterSoftDotted).\n"
  ^bool [^{:tag (slice uint16)} v ^int i]
  (for [j i] (> j 0) _
    (let [c (cpBefore16 v j)]
      (when (ltSoftDotted c)
        (return true))
      (let [k (cccKind c)]
        (when (or (== k 0) (== k 230))
          (return false)))
      (set! j (- j (cpLen c)))))
  false)

(go/func ltLower "ltLower: v with ConditionalSpecialCasing's lt lowercase entries applied, before the root's lowering.\n"
  ^{:tag (slice uint16)} [^{:tag (slice uint16)} v]
  (let [out (make (slice uint16) 0 (+ (len v) 4))]
    (range [i c v]
      (cond
        (and (== c 0x0049) (ltMoreAbove v i)) (set! out (append out 0x0069 0x0307))
        (and (== c 0x004A) (ltMoreAbove v i)) (set! out (append out 0x006A 0x0307))
        (and (== c 0x012E) (ltMoreAbove v i)) (set! out (append out 0x012F 0x0307))
        (== c 0x00CC) (set! out (append out 0x0069 0x0307 0x0300))
        (== c 0x00CD) (set! out (append out 0x0069 0x0307 0x0301))
        (== c 0x0128) (set! out (append out 0x0069 0x0307 0x0303))
        :else (set! out (append out c))))
    out))

(go/func ltUpper "ltUpper: v without the combining dots above that follow a soft-dotted letter (lt's uppercase entry), before\nthe root's uppering; as StringUTF16.toUpperCase, only from the first char that changes case (or a surrogate): the chars\nbefore it are copied as they are.\n"
  ^{:tag (slice uint16)} [^{:tag (slice uint16)} v]
  (let [out (make (slice uint16) 0 (len v))
        first (len v)]
    (range [i c v]
      (when (and (== first (len v))
                 (or (isSurrogate c) (not (== (conv rune c) (charToUpperEx (conv rune c))))))
        (set! first i)))
    (range [i c v]
      (when (not (and (>= i first) (== c 0x0307) (ltAfterSoftDotted v i)))
        (set! out (append out c))))
    out))

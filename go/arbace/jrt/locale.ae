  0xB4D 0xB4D 1  0xBCD 0xBCD 1  0xC3C 0xC3C 1  0xC4D 0xC4D 1  0xC55 0xC56 1  0xCBC 0xCBC 1  0xCCD 0xCCD 1
  0xD3B 0xD3C 1  0xD4D 0xD4D 1  0xDCA 0xDCA 1  0xE38 0xE3A 1  0xE48 0xE4B 1  0xEB8 0xEBA 1  0xEC8 0xECB 1
  0xF18 0xF19 1  0xF35 0xF35 1  0xF37 0xF37 1  0xF39 0xF39 1  0xF71 0xF72 1  0xF74 0xF74 1  0xF7A 0xF7D 1
  0xF80 0xF80 1  0xF82 0xF83 230  0xF84 0xF84 1  0xF86 0xF87 230  0xFC6 0xFC6 1  0x1037 0x1037 1  0x1039 0x103A 1
  0x108D 0x108D 1  0x135D 0x135F 230  0x1714 0x1715 1  0x1734 0x1734 1  0x17D2 0x17D2 1  0x17DD 0x17DD 230
  0x18A9 0x18A9 1  0x1939 0x1939 1  0x193A 0x193A 230  0x193B 0x193B 1  0x1A17 0x1A17 230  0x1A18 0x1A18 1

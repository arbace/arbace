;; jrt's stand-ins for java.util.concurrent.Delayed, ScheduledFuture and ScheduledExecutorService (doc/go/JRT-NOTES.md,
;; "Stand-ins"; java-rows-1124): the interfaces as jrt's own build sees them, which its ForkJoinPool (a
;; ScheduledExecutorService since jdk26u: schedule, scheduleAtFixedRate, scheduleWithFixedDelay) and its scheduled tasks
;; (fjschedule.ae) implement. In the program the three are translated from jdk26u and replace this file's definitions.
(in-ns 'go.arbace.jrt)

(go/file "standin_scheduled.go")

(go/type Delayed "Delayed is java.util.concurrent.Delayed.\n"
  (interface Object_I Comparable
    (Is_Delayed [])
    (GetDelay_TimeUnit__J ^int64 [^{:tag (* TimeUnit)} unit])))

(go/type ScheduledFuture "ScheduledFuture is java.util.concurrent.ScheduledFuture.\n"
  (interface Object_I Delayed Future Comparable
    (Is_ScheduledFuture [])))

(go/type ScheduledExecutorService "ScheduledExecutorService is java.util.concurrent.ScheduledExecutorService.\n"
  (interface ExecutorService
    (Is_ScheduledExecutorService [])
    (Schedule_Runnable_J_TimeUnit__ScheduledFuture ^ScheduledFuture [^Runnable r ^int64 delay ^{:tag (* TimeUnit)} unit])
    (Schedule_Callable_J_TimeUnit__ScheduledFuture ^ScheduledFuture [^Callable c ^int64 delay ^{:tag (* TimeUnit)} unit])
    (ScheduleAtFixedRate_Runnable_J_J_TimeUnit__ScheduledFuture
      ^ScheduledFuture [^Runnable r ^int64 initialDelay ^int64 period ^{:tag (* TimeUnit)} unit])
    (ScheduleWithFixedDelay_Runnable_J_J_TimeUnit__ScheduledFuture
      ^ScheduledFuture [^Runnable r ^int64 initialDelay ^int64 delay ^{:tag (* TimeUnit)} unit])))

(go/var
  [Delayed_class
   (Define (addr (lit ClassInfo :Name "java.util.concurrent.Delayed" :Kind KindInterface
                      :Modifiers (bit-or AccPublic AccInterface AccAbstract)
                      :Interfaces (lit (slice (* Class)) Comparable_class) :Go "arbace/jrt.Delayed")))]
  [ScheduledFuture_class
   (Define (addr (lit ClassInfo :Name "java.util.concurrent.ScheduledFuture" :Kind KindInterface
                      :Modifiers (bit-or AccPublic AccInterface AccAbstract)
                      :Interfaces (lit (slice (* Class)) Delayed_class Future_class) :Go "arbace/jrt.ScheduledFuture")))]
  [ScheduledExecutorService_class
   (Define (addr (lit ClassInfo :Name "java.util.concurrent.ScheduledExecutorService" :Kind KindInterface
                      :Modifiers (bit-or AccPublic AccInterface AccAbstract)
                      :Interfaces (lit (slice (* Class)) ExecutorService_class) :Go "arbace/jrt.ScheduledExecutorService")))])

(go/func Delayed_InstanceOf ^bool [^any x] (let [(values _ ok) (assert Delayed x)] ok))
(go/func ScheduledFuture_InstanceOf ^bool [^any x] (let [(values _ ok) (assert ScheduledFuture x)] ok))
(go/func ScheduledExecutorService_InstanceOf ^bool [^any x] (let [(values _ ok) (assert ScheduledExecutorService x)] ok))

(go/func init []
  (set! (.-IsInstance (.Info Delayed_class)) Delayed_InstanceOf)
  (set! (.-IsInstance (.Info ScheduledFuture_class)) ScheduledFuture_InstanceOf)
  (set! (.-IsInstance (.Info ScheduledExecutorService_class)) ScheduledExecutorService_InstanceOf))

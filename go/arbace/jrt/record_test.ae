;; jrt's tests of RecordComponent (record.ae; JCS383 (a), serialization's slice 5): a record class as
;; arbace.classes.annot writes its data, against what the JDK answers for the same program:
;;   package test;
;;   public record Point<T>(int x, @Ann(value = 3) String name, T val) {}
;;   getRecordComponents(): [int x, java.lang.String name, java.lang.Object val]; getName() interned; getType()
;;   int, String, Object; getGenericSignature() null, null, "TT;"; getAccessor() "public int test.Point.x()";
;;   name's getAnnotation(Ann.class).value() 3; a class that is not a record: null
;; Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'go.arbace.jrt)

(go/file "record_test.go"
  :imports [[testing "testing"]])

(go/var testPoint_class
  (Define (addr (lit ClassInfo :Name "test.Point" :Kind KindRecord :Modifiers (bit-or AccPublic AccFinal)
                     :Super Object_class :Go "arbace/jrt.testPoint"
                     :Annots (+ "S <T:Ljava/lang/Object;>Ljava/lang/Record;\n"
                                "R x I\n"
                                "R name Ljava.lang.String;\n"
                                "R val Ljava.lang.Object; TT;\n"
                                "A name @Ltest.Ann; 1 value I3")))))
(go/var testFieldsRecord_class
  (Define (addr (lit ClassInfo :Name "test.Old" :Kind KindRecord :Modifiers (bit-or AccPublic AccFinal)
                     :Super Object_class :Go "arbace/jrt.testOld"))))

(go/func init []
  (set! (.-Methods (.Info testPoint_class))
        (lit (slice MethodInfo)
             (lit MethodInfo :Name "name" :Params nil :Return String_class :Modifiers AccPublic)
             (lit MethodInfo :Name "val" :Params nil :Return Object_class :Modifiers AccPublic)
             (lit MethodInfo :Name "x" :Params nil :Return Prim_int :Modifiers AccPublic)))
  (set! (.-Fields (.Info testFieldsRecord_class))
        (lit (slice FieldInfo)
             (lit FieldInfo :Name "count" :Type Prim_int :Modifiers (bit-or AccPrivate AccStatic))
             (lit FieldInfo :Name "b" :Type Prim_long :Modifiers (bit-or AccPrivate AccFinal))
             (lit FieldInfo :Name "a" :Type String_class :Modifiers (bit-or AccPrivate AccFinal)))))

(go/func TestRecordComponents [^{:tag (* testing/T)} t]
  (when (!= (.GetRecordComponents__RecordComponent1 testOuter_class) nil)
    (.Error t "a class that is not a record has components"))
  (let [a (.GetRecordComponents__RecordComponent1 testPoint_class)]
    (when (!= (len (.-A a)) 3)
      (.Fatalf t "components: %d" (len (.-A a))))
    (when (!= (.GetClass__Class a) (.ArrayClass RecordComponent_class))
      (.Error t "the array's class"))
    (let [x (assert (* RecordComponent) (aget (.-A a) 0))
          n (assert (* RecordComponent) (aget (.-A a) 1))
          v (assert (* RecordComponent) (aget (.-A a) 2))]
      (when (or (!= (.String (.GetName__String x)) "x") (!= (.GetName__String x) (Intern "x")))
        (.Error t "x's name, interned"))
      (when (or (!= (.GetType__Class x) Prim_int) (!= (.GetType__Class n) String_class) (!= (.GetType__Class v) Object_class))
        (.Error t "the types"))
      (when (or (!= (.GetGenericSignature__String x) nil) (!= (.GetGenericSignature__String v) (Intern "TT;")))
        (.Error t "the signatures"))
      (when (!= (.String (.ToString__String n)) "java.lang.String name")
        (.Errorf t "toString %s" (.String (.ToString__String n))))
      (when (!= (.GetDeclaringRecord__Class v) testPoint_class)
        (.Error t "getDeclaringRecord"))
      (let [m (.GetAccessor__Method x)]
        (when (or (== m nil) (!= (.String (.GetName__String m)) "x") (!= (.GetReturnType__Class m) Prim_int))
          (.Error t "x's accessor")))
      (let [an (.GetAnnotation_Class__Annotation n testAnn_class)]
        (when (or (== an nil) (!= (.Value__I (assert testAnn an)) 3))
          (.Error t "name's annotation")))
      (when (or (!= (len (.-A (.GetAnnotations__Annotation1 x))) 0) (!= (len (.-A (.GetDeclaredAnnotations__Annotation1 n))) 1))
        (.Error t "the annotations' counts"))
      (when (.IsAnnotationPresent_Class__Z x testAnn_class)
        (.Error t "x has no annotation"))))
  ;; a record whose data records no component: its instance fields in declaration order
  (let [a (.GetRecordComponents__RecordComponent1 testFieldsRecord_class)]
    (when (or (!= (len (.-A a)) 2)
              (!= (.String (.ToString__String (assert (* RecordComponent) (aget (.-A a) 0)))) "long b")
              (!= (.String (.ToString__String (assert (* RecordComponent) (aget (.-A a) 1)))) "java.lang.String a"))
      (.Error t "the fields' components"))))

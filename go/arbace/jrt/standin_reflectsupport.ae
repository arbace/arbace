;; jrt's stand-ins for F25's translated classes (doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built:
;; F25 (write-ahead)"; doc/go/JRT-NOTES.md, "Stand-ins"): java.lang.reflect.TypeVariable and
;; GenericDeclaration, which jrt's Class, Method and Constructor name (getTypeParameters' array,
;; Class's interfaces), and jdk.internal.jrt.ReflectSupport, the Java half of generic reflection
;; (overlay/jdk/java.base/jdk/internal/jrt/ReflectSupport.java), whose static methods classdata.ae
;; calls. In the shapes J2G-SPEC gives translated classes, so that j2g's translations replace them
;; (arbace.j2g.main/filter-standins, standin-roots: ReflectSupport's methods below are the program's
;; roots); in jrt's own build they answer as for a declaration without a Signature (no repository:
;; nil), which classdata.ae never asks, as it calls them only for a recorded Signature.
;; Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'go.arbace.jrt)

(go/file "standin_reflectsupport.go")

;; ---- java.lang.reflect.GenericDeclaration

(go/type GenericDeclaration
  (interface AnnotatedElement (Is_GenericDeclaration [])
    (GetTypeParameters__TypeVariable1 ^{:tag (* RefArray)} [])))
(go/var GenericDeclaration_class
  (Define (addr (lit ClassInfo :Name "java.lang.reflect.GenericDeclaration" :Kind KindInterface
                     :Modifiers (bit-or AccPublic AccInterface AccAbstract)
                     :Interfaces (lit (slice (* Class)) AnnotatedElement_class)
                     :Go "arbace/jrt.GenericDeclaration"))))
(go/func GenericDeclaration_InstanceOf ^bool [^any x] (let [(values _ ok) (assert GenericDeclaration x)] ok))

;; ---- java.lang.reflect.TypeVariable

(go/type TypeVariable
  (interface Type AnnotatedElement (Is_TypeVariable [])
    (GetName__String ^{:tag (* String)} [])))
(go/var TypeVariable_class
  (Define (addr (lit ClassInfo :Name "java.lang.reflect.TypeVariable" :Kind KindInterface
                     :Modifiers (bit-or AccPublic AccInterface AccAbstract)
                     :Interfaces (lit (slice (* Class)) Type_class AnnotatedElement_class)
                     :Go "arbace/jrt.TypeVariable"))))
(go/func TypeVariable_InstanceOf ^bool [^any x] (let [(values _ ok) (assert TypeVariable x)] ok))

;; ---- jdk.internal.jrt.ReflectSupport

(go/var ReflectSupport_class
  (Define (addr (lit ClassInfo :Name "jdk.internal.jrt.ReflectSupport" :Kind KindClass
                     :Modifiers (bit-or AccPublic AccFinal) :Super Object_class
                     :Go "arbace/jrt.ReflectSupport"))))

(go/func ReflectSupport_ClassRepository_Class_String__O ^any [^{:tag (* Class)} c ^{:tag (* String)} sig] nil)
(go/func ReflectSupport_MethodRepository_Method_String__O ^any [^{:tag (* Method)} m ^{:tag (* String)} sig] nil)
(go/func ReflectSupport_ConstructorRepository_Constructor_String__O ^any [^{:tag (* Constructor)} k ^{:tag (* String)} sig] nil)
(go/func ReflectSupport_FieldRepository_Field_String__O ^any [^{:tag (* Field)} f ^{:tag (* String)} sig] nil)
(go/func ReflectSupport_TypeParameters_O__O ^any [^any repo] nil)
(go/func ReflectSupport_GenericSuperclass_Class_O__O ^any [^{:tag (* Class)} c ^any repo] nil)
(go/func ReflectSupport_GenericInterfaces_O__O ^any [^any repo] nil)
(go/func ReflectSupport_GenericReturnType_O__O ^any [^any repo] nil)
(go/func ReflectSupport_GenericParameterTypes_O__O ^any [^any repo] nil)
(go/func ReflectSupport_GenericExceptionTypes_O__O ^any [^any repo] nil)
(go/func ReflectSupport_GenericType_O__O ^any [^any repo] nil)
(go/func ReflectSupport_ClassToGenericString_Class__String "a stand-in: toString.\n"
  ^{:tag (* String)} [^{:tag (* Class)} c] (.ToString__String c))
(go/func ReflectSupport_MethodToGenericString_Method__String "a stand-in: toString.\n"
  ^{:tag (* String)} [^{:tag (* Method)} m] (.ToString__String m))
(go/func ReflectSupport_ConstructorToGenericString_Constructor__String "a stand-in: toString.\n"
  ^{:tag (* String)} [^{:tag (* Constructor)} k] (.ToString__String k))
(go/func ReflectSupport_FieldToGenericString_Field__String "a stand-in: toString.\n"
  ^{:tag (* String)} [^{:tag (* Field)} f] (.ToString__String f))

;; ClassInfo.IsInstance, set at init (§5.11)
(go/func init []
  (set! (.-IsInstance (.Info GenericDeclaration_class)) GenericDeclaration_InstanceOf)
  (set! (.-IsInstance (.Info TypeVariable_class)) TypeVariable_InstanceOf))

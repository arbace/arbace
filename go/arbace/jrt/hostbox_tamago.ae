;; jrt: the box's host (doc/go/BOX-NOTES.md, S1; BOX-SURVEY.md §4): the program built with
;; GOOS=tamago as a guest of the monitor (arbace/box/vmm), its host the monitor's calls through
;; the board (arbace/box/board, abi). The console is WaitRead, Write and Message; entropy Random;
;; the end Exit. Files are TamaGo's in-memory file system through Go's os (OSHost's file calls,
;; D11), the wall clock the board's (offset by the host's at the entry, D10), the command line
;; and the environment what the monitor wrote at the entry. No optional interface: no HostFS,
;; HostLinks, NetHost, HostProc or HostExecutable, so those features fail as on a host without
;; them. Its store (StoreHost, S3) is the monitor's: the calls BlobPut ... RefSet.
(in-ns 'go.arbace.jrt)

(go/file "hostbox_tamago.go"
  :build ["//go:build tamago"]
  :imports [[errors "errors"] [io "io"] [fs "io/fs"] [os "os"] [runtime "runtime"] [debug "runtime/debug"]
            [strconv "strconv"] [strings "strings"] [sync "sync"] [syscall "syscall"] [time "time"]
            [goos "runtime/goos"] [abi "arbace/box/abi"] [board "arbace/box/board"]])

(go/const ^{:tag uint :val 1073741824
            :doc "boxMemoryHeadroom is what the box's default memory limit leaves of the guest's RAM (goos.RamSize):
the image, its bss and the first stack are in the RAM too, and the limit is the collector's
goal, which a large allocation may pass for a while (doc/go/BOX-NOTES.md, S2).
"}
  boxMemoryHeadroom (<< 1 30))

(go/const ^{:tag bool :val true
            :doc "boxYield: the evaluator yields every yieldEvery calls and recurs (Compiler$CodeRun.tick): TamaGo's\nruntime has no preemption.\n"}
  boxYield true)

(go/func init
  "init makes the command line and the environment the monitor wrote at the entry the program's
(os.Args, os.Getenv: TamaGo's runtime gives it neither), before jrt's other inits (tuning.go's
reads the environment), and applies GOGC and GOMEMLIMIT, which TamaGo's runtime read before
they were set; seeds the in-memory file system from the snapshot ARBACE_BOX_FS names (seedFS); and makes a nil dereference the run-time panic it is on Linux (board.NilPanics:
jrt's implicit NullPointerException, A2G-SPEC §7.9.5). Without GOMEMLIMIT the memory limit is the
guest's RAM less boxMemoryHeadroom: the RAM is fixed and the host has no swap for it, and with
GOGC's goal alone (DefaultGOGC: three times the live heap) a guest holding a third of its RAM
would run out of memory (doc/go/BOX-NOTES.md, S2).\n"
  []
  (board/NilPanics)
  (set! os/Args (board/Args))
  (range [_ kv (board/Env)]
    (let [(values k v ok) (strings/Cut kv "=")]
      (when ok
        (syscall/Setenv k v))))
  (let [g (os/Getenv "GOGC")]
    (if (== g "off")
      (debug/SetGCPercent -1)
      (let [(values n err) (strconv/Atoi g)]
        (when (== err nil)
          (debug/SetGCPercent n)))))
  (let [(values n ok) (parseByteCount (os/Getenv "GOMEMLIMIT"))]
    (cond
      ok (debug/SetMemoryLimit n)
      (> goos/RamSize boxMemoryHeadroom)
        (debug/SetMemoryLimit (conv int64 (- goos/RamSize boxMemoryHeadroom))))
    (seedFS)))

(go/func ProgramHost
  "ProgramHost is the program's host (the main package's): the box's, with the program's embedded
resources.\n"
  ^Host [^{:tag fs/FS} resources]
  (lit boxHost :files (lit OSHost :Resources resources) :in (addr (lit boxConsole))))

(go/type boxHost
  "boxHost is the box's Host: the monitor's calls, and files in TamaGo's in-memory file system
through OSHost's.\n"
  (struct ^OSHost files ^{:tag (* boxConsole)} in))

(go/method Stdin ^{:tag io/Reader} [^boxHost h] (.-in h))
(go/method Stdout ^{:tag io/Writer} [^boxHost h] (lit boxOut))
(go/method Stderr ^{:tag io/Writer} [^boxHost h] (lit boxOut :err true))
(go/method Open [^boxHost h ^string name ^int flag ^uint32 perm] :results [HostFile error]
  (.Open (.-files h) name flag perm))
(go/method Stat [^boxHost h ^string name] :results [HostFileInfo error] (.Stat (.-files h) name))
(go/method ReadDir [^boxHost h ^string name] :results [(slice string) error] (.ReadDir (.-files h) name))
(go/method Remove ^error [^boxHost h ^string name] (.Remove (.-files h) name))
(go/method Mkdir ^error [^boxHost h ^string name ^uint32 perm] (.Mkdir (.-files h) name perm))
(go/method Rename ^error [^boxHost h ^string from ^string to] (.Rename (.-files h) from to))
(go/method Getwd [^boxHost h] :results [string error] (.Getwd (.-files h)))
(go/method Now
  "Now is the board's clock, the host's wall clock at the entry onward (D10).\n"
  ^{:tag time/Time} [^boxHost h] (time/Now))
(go/method Nanotime ^int64 [^boxHost h] (.Nanotime (.-files h)))
(go/method Getenv [^boxHost h ^string name] :results [string bool] (os/LookupEnv name))
(go/method Environ ^{:tag (slice string)} [^boxHost h] (os/Environ))
(go/method Args ^{:tag (slice string)} [^boxHost h] os/Args)
(go/method NumCPU "NumCPU is the guest's vCPUs (the board's GOMAXPROCS).\n" ^int [^boxHost h]
  (runtime/GOMAXPROCS 0))
(go/method RandomBytes "RandomBytes is the host's entropy (abi.Random).\n" [^boxHost h ^{:tag (slice byte)} b]
  (when (> (len b) 0)
    (board/Call abi/Random (board/Addr b) (conv int64 (len b)) 0 0 0)))
(go/method Resource [^boxHost h ^string name] :results [(slice byte) bool] (.Resource (.-files h) name))
(go/method Exit "Exit ends the guest (abi.Exit, the console flushed).\n" [^boxHost h ^int code]
  (StopProfile)
  (board/Exit (conv int32 code)))

(go/type boxOut
  "boxOut is the guest's standard output (abi.Write) or error (abi.Message to the error stream).\n"
  (struct ^bool err))

(go/method Write [^boxOut o ^{:tag (slice byte)} p] :results [int error]
  (when (== (len p) 0)
    (return 0 nil))
  (when (.-err o)
    (board/Call abi/Message (board/Addr p) (conv int64 (len p)) 1 0 0)
    (return (len p) nil))
  (let [n (.-Ret (board/Call abi/Write (board/Addr p) (conv int64 (len p)) 0 0 0))]
    (when (< n 0)
      (return 0 io/ErrClosedPipe))
    (return (conv int n) nil)))

(go/const ^{:tag time/Duration :val 1000000
            :doc "consoleFirstWait is the console's first wait between two polls of the monitor.\n"}
  consoleFirstWait time/Millisecond)

(go/const ^{:tag time/Duration :val 10000000
            :doc "consoleMaxWait is the console's longest wait between two polls: the latency of a line typed.\n"}
  consoleMaxWait (* 10 time/Millisecond))

(go/type boxConsole
  "boxConsole is the guest's standard input: abi.WaitRead into a buffer of the guest's. The read
does not stop the guest (BOX-SURVEY R3): the monitor is asked without a wait, and while there is
no input the reading goroutine sleeps, from consoleFirstWait to consoleMaxWait, so that other
goroutines run, the collector stops the world and other vCPUs' output goes; an idle guest parks
in the monitor meanwhile (the board's Idle).\n"
  (struct ^{:tag (array 4096 byte)} buf ^int n ^int at ^bool eof))

(go/method Read [^{:tag (* boxConsole)} c ^{:tag (slice byte)} p] :results [int error]
  (when (== (.-at c) (.-n c))
    (when (.-eof c)
      (return 0 io/EOF))
    (let [wait consoleFirstWait]
      (while true
        (let [b (board/Call abi/WaitRead 0 (board/Addr (subslice (.-buf c))) (conv int64 (len (.-buf c))) 0 0)]
          (when (!= (.-Ret b) 0)
            (let [m (conv int (aget (.-A b) 0))]
              (when (== m 0)
                (set! (.-eof c) true)
                (return 0 io/EOF))
              (when (> m 0)
                (set! (.-n c) m)
                (set! (.-at c) 0)
                (break)))))
        (time/Sleep wait)
        (set! wait (min (* wait 2) consoleMaxWait)))))
  (let [k (copy p (subslice (.-buf c) (.-at c) (.-n c)))]
    (set! (.-at c) + k)
    (return k nil)))

;; ---------------------------------------------------------------------------------------
;; The store (doc/go/BOX-NOTES.md, S3): the monitor's (arbace/box/vmm's Store, in the directory
;; the launcher was given), by its calls

(go/var ^{:tag sync/Once} boxStoreOnce)
(go/var ^bool boxHasStore)

(go/method Store
  "Store is the monitor's store, or nil when it has none (its calls answer abi.StoreNone; asked
once).\n"
  ^Store [^boxHost h]
  (.Do boxStoreOnce
    (fn []
      (let [args (boxStoreArgs)]
        (set! boxHasStore (!= (.-Ret (board/Call abi/BlobSize (board/Addr (subslice args 0 32)) 0 0 0 0)) abi/StoreNone)))))
  (when (not boxHasStore)
    (return nil))
  (lit boxStore))

(go/var ^{:tag int
          :doc "boxStoreArgBytes is the size of a store call's argument buffer: two hashes and a name. A
variable, so that make allocates the buffer on the heap: the monitor reads it by address, and a
goroutine's stack moves.\n"}
  boxStoreArgBytes 128)

(go/func boxStoreArgs
  "boxStoreArgs is a new argument buffer: the hash at 0, the old hash at 32, the name at 64.\n"
  ^{:tag (slice byte)} []
  (make (slice byte) boxStoreArgBytes))

(go/type boxStore
  "boxStore is the monitor's store through the board's calls (abi.BlobPut ... RefSet). The data a
guest puts or gets is its caller's, read or written by the monitor in place.\n"
  (struct))

(go/method Put [^boxStore s ^{:tag (slice byte)} data] :results [(array 32 byte) error]
  (let [args (boxStoreArgs)
        ^{:tag (array 32 byte)} h (zero (array 32 byte))
        r (.-Ret (board/Call abi/BlobPut (board/Addr data) (conv int64 (len data)) (board/Addr (subslice args 0 32)) 0 0))]
    (switch r
      (case [0]
        (copy (subslice h) (subslice args 0 32))
        (return h nil))
      (case [abi/StoreTooLarge] (return h ErrStoreTooLarge)))
    (return h (boxStoreError r))))

(go/method Size [^boxStore s ^{:tag (array 32 byte)} h] :results [int64 bool]
  (let [args (boxStoreArgs)]
    (copy args (subslice h))
    (let [n (.-Ret (board/Call abi/BlobSize (board/Addr (subslice args 0 32)) 0 0 0 0))]
      (return n (>= n 0)))))

(go/method Get [^boxStore s ^{:tag (array 32 byte)} h ^int64 off ^{:tag (slice byte)} p] :results [int bool]
  (let [args (boxStoreArgs)]
    (copy args (subslice h))
    (let [n (.-Ret (board/Call abi/BlobGet (board/Addr (subslice args 0 32)) (board/Addr p) (conv int64 (len p)) off 0))]
      (return (conv int n) (>= n 0)))))

(go/method Ref [^boxStore s ^string name] :results [(array 32 byte) bool]
  (let [^{:tag (array 32 byte)} h (zero (array 32 byte))]
    (when (not (StoreName name))
      (return h false))
    (let [args (boxStoreArgs)
          k (copy (subslice args 64) name)
          r (.-Ret (board/Call abi/RefGet (board/Addr (subslice args 64)) (conv int64 k) (board/Addr (subslice args 0 32)) 0 0))]
      (when (!= r 0)
        (return h false))
      (copy (subslice h) (subslice args 0 32))
      (return h true))))

(go/method SetRef ^error [^boxStore s ^string name ^{:tag (array 32 byte)} h ^{:tag (* (array 32 byte))} old]
  (when (not (StoreName name))
    (return ErrStoreName))
  (let [args (boxStoreArgs)
        ^int64 o 0]
    (copy args (subslice h))
    (when (!= old nil)
      (copy (subslice args 32 64) (subslice @old))
      (set! o (board/Addr (subslice args 32 64))))
    (let [k (copy (subslice args 64) name)
          r (.-Ret (board/Call abi/RefSet (board/Addr (subslice args 64)) (conv int64 k) (board/Addr (subslice args 0 32)) o 0))]
      (when (== r 0)
        (return nil))
      (boxStoreError r))))

(go/func boxStoreError
  "boxStoreError is the error of a store call's negative answer r.\n"
  ^error [^int64 r]
  (switch r
    (case [abi/StoreConflict] (return ErrStoreConflict))
    (case [abi/StoreTooLarge] (return ErrStoreTooLarge))
    (case [abi/StoreBadName] (return ErrStoreName))
    (case [abi/StoreNone] (return (errors/New "no store"))))
  (errors/New (+ "the store refused (" (strconv/FormatInt r 10) ")")))

(go/func seedFS
  "seedFS restores the snapshot ref ARBACE_BOX_FS names (a tar, arbace.box/save-fs!) into the
in-memory file system at the guest's start (RestoreTar into /); when it cannot, the guest ends
with status 1 and the reason on its error stream.\n"
  []
  (let [ref (os/Getenv "ARBACE_BOX_FS")]
    (when (== ref "")
      (return))
    (when [err (seedFrom ref)] (!= err nil)
      (.Write (lit boxOut :err true) (conv (slice byte) (+ "arbace: ARBACE_BOX_FS=" ref ": " (.Error err) "\n")))
      (board/Exit 1))))

(go/func seedFrom "seedFrom restores the snapshot ref names into /.\n" ^error [^string ref]
  (let [st (CurrentStore)]
    (when (== st nil)
      (return (errors/New "no store (ARBACE_BOX_STORE, or the launcher's --store)")))
    (when (not (StoreName ref))
      (return (errors/New "not a name the store takes")))
    (let [(values h ok) (.Ref st ref)]
      (when (not ok)
        (return (errors/New "no such ref")))
      (let [(values b ^:assign ok) (ReadBlob st h)]
        (when (not ok)
          (return (errors/New "its blob cannot be read")))
        (RestoreTar b "/")))))

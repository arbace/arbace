;; jrt's tests: java.rmi's native (rmi.ae).
(in-ns 'go.arbace.jrt)

(go/file "rmi_test.go"
  :imports [[runtime "runtime"] [testing "testing"] [time "time"]])

(go/func TestGCMaxObjectInspectionAge
  "sun.rmi.transport.GC.maxObjectInspectionAge is the age of the last collection: small right after one, and growing
with the time since.\n"
  [^{:tag (* testing/T)} t]
  (runtime/GC)
  (let [a0 (GC_MaxObjectInspectionAge__J_native)]
    (when (or (< a0 0) (> a0 1000))
      (.Fatalf t "age right after a collection: %d ms" a0))
    (time/Sleep (* 30 time/Millisecond))
    (let [a1 (GC_MaxObjectInspectionAge__J_native)]
      (when (< a1 (+ a0 25))
        (.Fatalf t "age did not grow with the time since the collection: %d then %d ms" a0 a1)))))

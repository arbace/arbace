;; jrt's tests: weak references with a forced GC, System, Runtime and the host
;; (doc/go/JRT-NOTES.md, phase 2a).
(in-ns 'go.arbace.jrt)

(go/file "system_test.go"
  :imports [[fmt "fmt"] [runtime "runtime"] [strconv "strconv"] [strings "strings"] [testing "testing"] [time "time"]])

(go/func gcUntil "gcUntil collects until ok or 50 tries; whether ok.\n" ^bool [^{:tag (func [] [bool])} ok]
  (for [i 0] (< i 50) (inc! i)
    (runtime/GC)
    (when (ok)
      (return true))
    (time/Sleep time/Millisecond))
  false)

(go/func TestWeakReferences
  "A weak referent that becomes unreachable is cleared and its reference enqueued (Keyword's
table); a reachable one stays; a soft one stays until clear.\n"
  [^{:tag (* testing/T)} t]
  (let [q (ReferenceQueue_New)
        kept (Str "kept")
        wk (WeakReference_New_O_ReferenceQueue kept q)
        wd (WeakReference_New_O_ReferenceQueue (Str "dropped") q)
        wn (WeakReference_New_O (StringBuilder_New))
        sr (SoftReference_New_O (Str "soft"))]
    (when (or (!= (.Get__O wk) kept) (not (.RefersTo_O__Z wk kept)))
      (.Error t "get of a live referent"))
    (when (not (gcUntil (fn ^bool [] (and (== (.Get__O wd) nil) (== (.Get__O wn) nil)))))
      (.Error t "unreachable referents not cleared after GC"))
    (when (not (gcUntil (fn ^bool [] (.IsEnqueued__Z wd))))
      (.Error t "not enqueued"))
    (let [r (.Poll__Reference q)]
      (when (!= r (conv Reference_I wd))
        (.Errorf t "poll: %v" r)))
    (when (!= (.Poll__Reference q) nil)
      (.Error t "a live referent was enqueued"))
    (when (or (!= (.Get__O wk) kept) (== (.Get__O sr) nil))
      (.Error t "live or soft referent cleared"))
    (runtime/KeepAlive kept)
    ;; the Java type of the referent survives the round trip through the weak pointer
    (let [sb (StringBuilder_New_String (Str "abc"))
          w (WeakReference_New_O sb)
          (values back ok) (assert (* StringBuilder) (.Get__O w))]
      (when (or (not ok) (!= back sb))
        (.Error t "the referent's type"))
      (runtime/KeepAlive sb))
    ;; clear and enqueue by hand; remove with a timeout
    (.Clear__V sr)
    (when (!= (.Get__O sr) nil)
      (.Error t "clear"))
    (let [q2 (ReferenceQueue_New)
          w (WeakReference_New_O_ReferenceQueue kept q2)
          t0 (time/Now)]
      (when (or (!= (.Remove_J__Reference q2 10) nil) (< (time/Since t0) (* 10 time/Millisecond)))
        (.Error t "remove(10) on an empty queue"))
      (when (or (not (.Enqueue__Z w)) (.Enqueue__Z w) (!= (.Get__O w) nil) (!= (.Remove__Reference q2) (conv Reference_I w)))
        (.Error t "enqueue"))
      (runtime/KeepAlive kept))))

(go/func TestSystem [^{:tag (* testing/T)} t]
  (when (or (!= (.String (System_LineSeparator__String)) "\n")
            (!= (.String (System_GetProperty_String__String (Str "line.separator"))) "\n")
            (!= (.String (System_GetProperty_String__String (Str "file.separator"))) "/")
            (!= (.String (System_GetProperty_String__String (Str "os.name"))) "Linux"))
    (.Error t "properties"))
  (let [arch (.String (System_GetProperty_String__String (Str "os.arch")))]
    (when (and (!= arch "amd64") (!= arch "aarch64"))
      (.Errorf t "os.arch %s" arch)))
  (when (!= (System_GetProperty_String__String (Str "no.such.property")) nil)
    (.Error t "a missing property"))
  (when (!= (.String (System_GetProperty_String_String__String (Str "no.such.property") (Str "dflt"))) "dflt")
    (.Error t "the default"))
  (when (or (!= (System_SetProperty_String_String__String (Str "jrt.test") (Str "1")) nil)
            (!= (.String (System_SetProperty_String_String__String (Str "jrt.test") (Str "2"))) "1")
            (!= (.String (System_ClearProperty_String__String (Str "jrt.test"))) "2")
            (!= (System_GetProperty_String__String (Str "jrt.test")) nil))
    (.Error t "setProperty, clearProperty"))
  (when (or (!= (res (fn ^string [] (System_GetProperty_String__String nil) "x")) "!java.lang.NullPointerException: key can't be null")
            (!= (res (fn ^string [] (System_GetProperty_String__String (Str "")) "x")) "!java.lang.IllegalArgumentException: key can't be empty"))
    (.Error t "the key checks"))
  (let [a (System_NanoTime__J)
        ms (System_CurrentTimeMillis__J)]
    (time/Sleep time/Millisecond)
    (when (< (- (System_NanoTime__J) a) 1000000)
      (.Error t "nanoTime"))
    (let [d (- ms (.UnixMilli (time/Now)))]
      (when (or (> d 1000) (< d -1000))
        (.Errorf t "currentTimeMillis off by %d ms" d))))
  (when (or (== (System_Getenv_String__String (Str "PATH")) nil) (!= (System_Getenv_String__String (Str "JRT_NO_SUCH_VARIABLE")) nil))
    (.Error t "getenv"))
  (when (< (.AvailableProcessors__I (Runtime_GetRuntime__Runtime)) 1)
    (.Error t "availableProcessors"))
  (let [names (strings/Join (PropertyNames) " ")]
    (when (not (strings/Contains names "user.dir"))
      (.Errorf t "property names: %s" names)))
  ;; exit goes to the host after the shutdown hooks
  (let [^bool hookRan false
        (values _ code) (withCapturedHost
                          (fn []
                            (.AddShutdownHook_Thread__V (Runtime_GetRuntime__Runtime)
                                                        (Thread_New_Runnable (RunnableOf (fn [] (set! hookRan true)))))
                            (System_Exit_I__V 3)))]
    (when (or (!= code 3) (not hookRan))
      (.Errorf t "exit: code %d, hook ran %v" code hookRan)))
  ;; the host's standard streams
  (let [(values out _) (withCapturedHost (fn [] (.WriteString Stderr "to stderr")))]
    (when (!= out "to stderr")
      (.Errorf t "Stderr: %q" out))))

(go/func TestRuntimeVersion "TestRuntimeVersion: Runtime.version() is the JDK build's, as the JDK's (JCS192:
SerialRecordLocks.java's recorded line: 26.0.2.1-internal-adhoc.root.jdk26u, feature 26, interim 0, update 2,
patch 1, hash -526613477), and jdk26u's Version rules over versions made without parts.\n"
  [^{:tag (* testing/T)} t]
  (let [v (Runtime_Version__Runtime_Version)
        p (addr (lit Runtime_Version :feature 26))
        w (addr (lit Runtime_Version :feature 26 :update 1))
        rel (addr (lit Runtime_Version :feature 26 :update 2 :patch 1 :n 4))]
    (when (or (!= (.Feature__I v) 26) (!= (.Interim__I v) 0) (!= (.Update__I v) 2) (!= (.Patch__I v) 1))
      (.Error t "the version's numbers"))
    (when (!= (.String (.ToString__String v)) "26.0.2.1-internal-adhoc.root.jdk26u")
      (.Errorf t "toString %s" (.String (.ToString__String v))))
    (when (or (!= (.String (.ToString__String p)) "26") (!= (.String (.ToString__String w)) "26.0.1")
              (!= (.String (.ToString__String (addr (lit Runtime_Version :feature 26 :opt "x" :hasOpt true)))) "26+-x"))
      (.Error t "toString of the parts"))
    (when (!= (.HashCode__I v) -526613477)
      (.Errorf t "hashCode %d" (.HashCode__I v)))
    ;; the JDK's for 26: ((17 + (31 + 26)) * 17 * 17 * 17), the list's hash, then three empty Optionals'
    (when (!= (.HashCode__I p) 363562)
      (.Errorf t "hashCode %d" (.HashCode__I p)))
    ;; the numbers' counts differ by 2 (jdk26u's size - oSize); a pre-release is below its release
    (when (or (!= (.CompareTo_Runtime_Version__I p w) -2) (!= (.CompareTo_O__I w p) 2)
              (>= (.CompareTo_Runtime_Version__I v rel) 0) (<= (.CompareTo_Runtime_Version__I v w) 0)
              (!= (.CompareTo_Runtime_Version__I v v) 0) (not (.Equals_O__Z p (addr (lit Runtime_Version :feature 26))))
              (.Equals_O__Z v rel) (.Equals_O__Z p w) (.Equals_O__Z p nil))
      (.Error t "compareTo, equals"))
    (when (or (!= (.String (.GetName__String (.GetClass__Class v))) "java.lang.Runtime$Version")
              (not (Runtime_Version_InstanceOf v)) (Runtime_Version_InstanceOf (Runtime_GetRuntime__Runtime)))
      (.Error t "the class"))
    (when (or (!= (.String (System_GetProperty_String__String (Str "java.version"))) "26.0.2.1-internal")
              (!= (.String (System_GetProperty_String__String (Str "java.runtime.version"))) "26.0.2.1-internal-adhoc.root.jdk26u")
              (!= (.String (.-moduleVersion (frameElement "java.lang.Thread" "run" "Thread.java" 1))) "26.0.2.1-internal"))
      (.Error t "the properties or a frame's module version"))))

(go/func versionPart "versionPart is an Optional part as the probe prints it: its text, or - when empty.\n"
  ^string [^bool has ^string s]
  (when has
    (return s))
  "-")

(go/func TestRuntimeVersionParse "TestRuntimeVersionParse: Version.parse as jdk26u's (JCS304 (b), JCS293): each string's toString,
numbers, parts and hashCode, or its exception's message, as the JDK's (the platform's jdk26u build's java, recorded
2026-11-09 by a probe program, doc/classes/JAVA-DEFERRED-TRIAGE.md, \"As built: JCS304 (b), JCS293\"), and compareTo,
equals with builds.\n"
  [^{:tag (* testing/T)} t]
  (let [ok (lit (slice (slice string))
                (lit (slice string) "26" "26" "26 0 0 0 1 - - - 363562")
                (lit (slice string) "9" "9" "9 0 0 0 1 - - - 280041")
                (lit (slice string) "26.0.2.1-internal-adhoc.root.jdk26u" "26.0.2.1-internal-adhoc.root.jdk26u" "26 0 2 1 4 internal - adhoc.root.jdk26u -526613477")
                (lit (slice string) "9.0.1+11" "9.0.1+11" "9 0 1 0 3 - 11 - 188944341")
                (lit (slice string) "9-ea+20-foo" "9-ea+20-foo" "9 0 0 0 1 ea 20 foo 1314847")
                (lit (slice string) "9+-x" "9+-x" "9 0 0 0 1 - - x 280161")
                (lit (slice string) "9-ea" "9-ea" "9 0 0 0 1 ea - - 1212933")
                (lit (slice string) "1.2.3.4.5.6" "1.2.3.4.5.6" "1 2 3 4 6 - - - 778309797")
                (lit (slice string) "9+11-opt.1" "9+11-opt.1" "9 0 0 0 1 - 11 opt.1 106240602")
                (lit (slice string) "9.0.0.1" "9.0.0.1" "9 0 0 1 4 - - - 1559648458")
                (lit (slice string) "26.1-a" "26.1-a" "26 1 0 0 2 a - - 8797738"))
        bad (lit (slice (slice string))
                 (lit (slice string) "0" "Invalid version string: '0'")
                 (lit (slice string) "" "For input string: \"\"")
                 (lit (slice string) "09" "Invalid version string: '09'")
                 (lit (slice string) "9.0" "Invalid version string: '9.0'")
                 (lit (slice string) "9+" "'+' found with neither build or optional components: '9+'")
                 (lit (slice string) "9-ea+" "'+' found with neither build or optional components: '9-ea+'")
                 (lit (slice string) "9-x+-y" "'+' found with pre-release and optional components:'9-x+-y'")
                 (lit (slice string) "9-" "Invalid version string: '9-'")
                 (lit (slice string) "99999999999" "For input string: \"99999999999\"")
                 (lit (slice string) "9.99999999999" "For input string: \"99999999999\"")
                 (lit (slice string) "9+99999999999" "For input string: \"99999999999\"")
                 (lit (slice string) "x" "Invalid version string: 'x'"))]
    (range [_ c ok]
      (let [v (Runtime_Version_Parse_String__Runtime_Version (Str (aget c 0)))
            b "-"]
        (when (.-hasBuild v)
          (set! b (strconv/Itoa (conv int (.-build v)))))
        (let [got (fmt/Sprintf "%d %d %d %d %d %s %s %s %d" (.Feature__I v) (.Interim__I v) (.Update__I v) (.Patch__I v)
                               (len (.numbers v)) (versionPart (.-hasPre v) (.-pre v)) b (versionPart (.-hasOpt v) (.-opt v)) (.HashCode__I v))]
          (when (or (!= (.String (.ToString__String v)) (aget c 1)) (!= got (aget c 2)))
            (.Errorf t "parse %q: %s %s, the JDK's %s %s" (aget c 0) (.String (.ToString__String v)) got (aget c 1) (aget c 2))))))
    (range [_ c bad]
      (let [s (aget c 0)
            m (thrown (fn [] (Runtime_Version_Parse_String__Runtime_Version (Str s))))]
        (when (!= m (aget c 1))
          (.Errorf t "parse %q: %q, the JDK's %q" s m (aget c 1)))))
    ;; the exceptions' classes: NumberFormatException for the numbers, IllegalArgumentException else
    (let [nfe false iae false]
      ((fn []
         (defer ((fn [] (let [r (recover)] (set! nfe (NumberFormatException_InstanceOf r))))))
         (Runtime_Version_Parse_String__Runtime_Version (Str "99999999999"))))
      ((fn []
         (defer ((fn [] (let [r (recover)] (set! iae (IllegalArgumentException_InstanceOf r))))))
         (Runtime_Version_Parse_String__Runtime_Version (Str "9+"))))
      (when (or (not nfe) (not iae))
        (.Error t "the exceptions' classes")))
    ;; the JDK's line: -1 1 1 -1 true false
    (let [x (Runtime_Version_Parse_String__Runtime_Version (Str "9+11"))
          y (Runtime_Version_Parse_String__Runtime_Version (Str "9+12"))
          z (Runtime_Version_Parse_String__Runtime_Version (Str "9"))]
      (when (or (!= (.CompareTo_Runtime_Version__I x y) -1) (!= (.CompareTo_Runtime_Version__I y x) 1)
                (!= (.CompareTo_Runtime_Version__I x z) 1) (!= (.CompareTo_Runtime_Version__I z x) -1)
                (not (.Equals_O__Z x (Runtime_Version_Parse_String__Runtime_Version (Str "9+11")))) (.Equals_O__Z x y))
        (.Error t "compareTo, equals with builds"))
      (when (or (!= (.Major__I x) 9) (!= (.Minor__I x) 0) (!= (.Security__I x) 0))
        (.Error t "major, minor, security"))
      ;; the optional part ignored (jdk26u: 9+11-a and 9+11-b compare 0 and are equal ignoring it, not otherwise)
      (let [a (Runtime_Version_Parse_String__Runtime_Version (Str "9+11-a"))
            b (Runtime_Version_Parse_String__Runtime_Version (Str "9+11-b"))]
        (when (or (!= (.CompareToIgnoreOptional_Runtime_Version__I a b) 0) (not (.EqualsIgnoreOptional_O__Z a b))
                  (>= (.CompareTo_Runtime_Version__I a b) 0) (.Equals_O__Z a b) (.EqualsIgnoreOptional_O__Z a y)
                  (!= (.CompareToIgnoreOptional_Runtime_Version__I a y) -1))
          (.Error t "compareToIgnoreOptional, equalsIgnoreOptional"))))))

(go/func TestPhantomReferences
  "PhantomReference (F17): get is null, refersTo is the referent; an unreachable referent's reference is
enqueued by the thread \"Reference Handler\" (system group); enqueue and clear by hand; a null referent's
reference enqueues by hand; System.runFinalization keeps the interrupt status.\n"
  [^{:tag (* testing/T)} t]
  (let [q (ReferenceQueue_New)
        kept (StringBuilder_New_String (Str "kept"))
        pk (PhantomReference_New_O_ReferenceQueue kept q)
        pd (PhantomReference_New_O_ReferenceQueue (StringBuilder_New_String (Str "dropped")) q)]
    (when (!= (.Get__O pk) nil)
      (.Error t "a phantom reference's get is not null"))
    (when (or (not (.RefersTo_O__Z pk kept)) (.RefersTo_O__Z pk nil) (.RefersTo_O__Z pk (Str "other")))
      (.Error t "refersTo of a live phantom referent"))
    (let [^Reference_I got nil]
      (for [i 0] (and (< i 100) (== got nil)) (inc! i)
        (System_Gc__V)
        (set! got (.Remove_J__Reference q 20)))
      (when (!= got (conv Reference_I pd))
        (.Errorf t "the collected referent's reference not enqueued: %v" got)))
    (when (not (.RefersTo_O__Z pd nil))
      (.Error t "an enqueued phantom reference still refers"))
    (when (!= (.Poll__Reference q) nil)
      (.Error t "a live phantom referent was enqueued"))
    (runtime/KeepAlive kept)
    ;; the handler is a live daemon thread of the system group
    (let [found false]
      (range [_ th (allPlatformThreads)]
        (when (== (.String (.Load (.-name th))) "Reference Handler")
          (set! found (and (.Load (.-daemon th)) (== (.-group th) systemThreadGroup)))))
      (when (not found)
        (.Error t "no thread \"Reference Handler\" in the system group")))
    ;; by hand, and a null referent (EnqueueNullRef)
    (let [q2 (ReferenceQueue_New)
          p (PhantomReference_New_O_ReferenceQueue kept q2)
          pn (PhantomReference_New_O_ReferenceQueue nil q2)]
      (when (or (not (.Enqueue__Z p)) (.Enqueue__Z p) (not (.RefersTo_O__Z p nil)))
        (.Error t "enqueue by hand"))
      (when (not (.Enqueue__Z pn))
        (.Error t "enqueue of a null referent's phantom reference"))
      (when (or (!= (.Poll__Reference q2) (conv Reference_I p)) (!= (.Poll__Reference q2) (conv Reference_I pn)))
        (.Error t "the queue's order"))
      (let [pc (PhantomReference_New_O_ReferenceQueue kept nil)]
        (.Clear__V pc)
        (when (not (.RefersTo_O__Z pc nil))
          (.Error t "clear")))
      (runtime/KeepAlive kept))
    (let [me (CurrentThread)]
      (.Interrupt__V me)
      (System_RunFinalization__V)
      (when (not (Thread_Interrupted__Z))
        (.Error t "runFinalization cleared the interrupt status")))
    (when (not (PhantomReference_InstanceOf pk))
      (.Error t "instanceof PhantomReference"))))

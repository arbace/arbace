    (range [i (conv int n)]
      (aset p i (lit pollFD :fd (aget (.-A fds) i) :events (conv int16 (aget (.-A events) i)))))
    (let [(values r e) (ppoll p (conv int timeout))]
      (when (== e syscall/EINTR)
        (return iosInterrupted))
      (when (!= e 0)
        (return (chThrown errs e)))
      (range [i (conv int n)]
        (aset (.-A revents) i (conv int32 (.-revents (aget p i)))))
      (conv int32 r))))

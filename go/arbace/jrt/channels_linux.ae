          (set! to -1))
        (let [(values n e) (ppoll p to)]
          (when (== e syscall/EINTR)
            (return 0))
          (when (!= e 0)
            (return (chThrown errs e)))
          (when (== n 0)
            (return 0))
          (return (conv int32 (.-revents (aget p 0)))))))
    (when (preclosed c)
      (return (conv int32 pollHup)))
    (do
      (let [(values r e) (pollNow (conv int fd) ev)]
        (when (!= e 0)
          (when (== e syscall/EINTR)
            (return 0))
          (return (chThrown errs e)))
        (when (or (!= r 0) (== timeout 0))
          (return (conv int32 r)))))

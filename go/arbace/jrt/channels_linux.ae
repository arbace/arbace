      (let [(values n e) (syscall/Read (conv int fd) buf)]
        (when (and (!= e nil) (!= e syscall/EAGAIN))
          (return (chThrown errs e)))
        (when (> n 0)
          (set! tn (+ tn n)))
        (when (== n 16)
          (continue))
        (if (> tn 0)
          (return 1)
          (return 0))))))

(go/func HostChannels_DrainOne0_I_I1__I_native
  "HostChannels_DrainOne0_I_I1__I_native is IOUtil.drain1: at most one byte read at once and discarded: 1, 0
(none), INTERRUPTED or THROWN.\n"
  ^int32 [^int32 fd ^{:tag (* IntArray)} errs]

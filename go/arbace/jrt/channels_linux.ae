    (when (== e syscall/EINTR)
      (return iosInterrupted))
    (when (!= e nil)
      (return (chThrown errs e)))
    (conv int32 n)))

(go/func HostChannels_FdLimit0__I_native
  "HostChannels_FdLimit0__I_native is IOUtil.fdLimit: RLIMIT_NOFILE's hard limit (Integer.MAX_VALUE when
unlimited or larger).\n"
  ^int32 []
  (let [rl (lit syscall/Rlimit)]
    (when (!= (syscall/Getrlimit syscall/RLIMIT_NOFILE (addr rl)) nil)
      (return -1))
    (when (> (.-Max rl) 2147483647)
      (return 2147483647))
    (conv int32 (.-Max rl))))

(go/func HostChannels_Poll1_I1_I1_I1_I_I_I1__I_native
  "HostChannels_Poll1_I1_I1_I1_I_I_I1__I_native is PollSelectorImpl.poll: poll(2) of the first n descriptors of
fds with their events, their revents into revents, within timeout ms (negative: no limit): the count,
INTERRUPTED or THROWN.\n"
  ^int32 [^{:tag (* IntArray)} fds ^{:tag (* IntArray)} events ^{:tag (* IntArray)} revents ^int32 n
          ^int32 timeout ^{:tag (* IntArray)} errs]

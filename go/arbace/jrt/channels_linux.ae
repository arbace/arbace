;; jrt: the host's descriptors under java.nio's selectable channels (doc/go/JRT-NOTES.md, "Channels"; F10 of
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: F10a"): the natives of jdk.internal.jrt.HostChannels
;; (overlay/jdk/java.base/jdk/internal/jrt/HostChannels.java), which jrt's overlays of sun.nio.ch's Net,
;; IOUtil, SocketDispatcher, UnixDispatcher and PollSelectorImpl call on a descriptor's number. Ports of
;; jdk26u's src/java.base/unix/native/libnio/ch/{Net,IOUtil,SocketDispatcher,UnixDispatcher,
;; PollSelectorImpl}.c and libnet's NET_SetSockOpt, NET_GetSockOpt and NET_Bind (baf63fb): the same system
;; calls, options and results (sun.nio.ch.IOStatus's), an error's number in err[0] where they throw.
;;
;; Two departures, below the natives' interface: every descriptor is non-blocking in the kernel and
;; registered with Go's poller (an os.File); one configured blocking (configureBlocking0) waits there for the
;; readiness the kernel would have waited for, as a blocking descriptor's read, write, connect and accept do,
;; so that preClose0 (UnixDispatcher.c's dup2 of a closed socket over the descriptor, and the signal that
;; releases a thread blocked in it) can wake that thread: it marks the descriptor, which from then on reads
;; its end, fails a write with EPIPE and answers a poll with POLLHUP, and moves its deadlines to the past.
;; Linux's: channels_other.ae answers every native "not available" on other systems (TamaGo's, the box).
(in-ns 'go.arbace.jrt)

(go/file "channels_linux.go"
  :build ["//go:build linux"]
  :imports [[encoding/binary "encoding/binary"] [errors "errors"] [net "net"] [os "os"] [sync "sync"]
            [syscall "syscall"] [time "time"] [unsafe "unsafe"]])

;; sun.nio.ch.IOStatus's values
(go/const
  [^{:tag int32 :val -1} iosEOF -1]
  [^{:tag int32 :val -2} iosUnavailable -2]
  [^{:tag int32 :val -3} iosInterrupted -3]
  [^{:tag int32 :val -5} iosThrown -5])

;; poll.h's events; SO_DOMAIN (39), IPV6_FLOWINFO_SEND (33), IP_MULTICAST_ALL (49), IPV6_MULTICAST_ALL (29),
;; FIONREAD (0x541B, TIOCINQ): Linux's, the same on amd64 and arm64
(go/const
  [^{:tag int16 :val 1} pollIn 0x0001]
  [^{:tag int16 :val 4} pollOut 0x0004]
  [^{:tag int16 :val 16} pollHup 0x0010]
  [^{:val 39} chSoDomain 39]
  [^{:val 33} ipv6FlowinfoSend 33]
  [^{:val 49} ipMulticastAll 49]
  [^{:val 29} ipv6MulticastAll 29])

(go/type chanFD
  "chanFD is a descriptor of HostChannels': its file on Go's poller, whether the channel configured it
blocking, whether preClose0 marked it.\n"
  (struct ^{:tag (* os/File)} f ^{:tag syscall/RawConn} rc ^bool blocking ^bool preclosed))

(go/var ^{:tag sync/Mutex} chanMu)
(go/var ^{:tag (map int32 (* chanFD))} chanFDs (make (map int32 (* chanFD))))

(go/func chanAdd "chanAdd enters descriptor fd (made non-blocking) into the table, blocking as given.\n"
  ^error [^int fd ^bool blocking]
  (when [err (syscall/SetNonblock fd true)] (!= err nil)
    (return err))
  (let [f (os/NewFile (conv uintptr fd) "")
        (values rc err) (.SyscallConn f)]
    (when (!= err nil)
      (return err))
    (.Lock chanMu)
    (aset chanFDs (conv int32 fd) (addr (lit chanFD :f f :rc rc :blocking blocking)))
    (.Unlock chanMu)
    nil))

(go/func chanGet "chanGet is descriptor fd's entry, or nil.\n" ^{:tag (* chanFD)} [^int32 fd]
  (.Lock chanMu)
  (defer (.Unlock chanMu))
  (aget chanFDs fd))

(go/func chanState "chanState is whether c is configured blocking and whether it was pre-closed.\n"
  [^{:tag (* chanFD)} c] :results [bool bool]
  (.Lock chanMu)
  (defer (.Unlock chanMu))
  (return (.-blocking c) (.-preclosed c)))

(go/func preclosed "preclosed is whether preClose0 marked c.\n" ^bool [^{:tag (* chanFD)} c]
  (let [(values _ pre) (chanState c)]
    pre))

(go/func chErrno "chErrno is err's error number (EIO when it has none).\n" ^int32 [^error err]
  (do
    (let [^syscall/Errno e 0]
      (when (errors/As err (addr e))
        (return (conv int32 e)))))
  (when (errors/Is err os/ErrDeadlineExceeded)
    (return (conv int32 syscall/ETIMEDOUT)))
  (conv int32 syscall/EIO))

(go/func chThrown "chThrown puts err's number into err[0]: IOStatus.THROWN.\n"
  ^int32 [^{:tag (* IntArray)} errs ^error err]
  (when (and (!= errs nil) (> (len (.-A errs)) 0))
    (aset (.-A errs) 0 (chErrno err)))
  iosThrown)

(go/func chBadFD "chBadFD is thrown with EBADF (a descriptor not in the table).\n"
  ^int32 [^{:tag (* IntArray)} errs]
  (chThrown errs syscall/EBADF))

(go/func waitFD
  "waitFD runs op on c's descriptor until it is done, waiting in Go's poller (for writing when write) between
tries, until deadline dl (zero: none); a pre-closed descriptor ends the wait. op answers whether it is done.\n"
  ^error [^{:tag (* chanFD)} c ^bool write ^{:tag time/Time} dl ^{:tag (func [int] [bool])} op]
  (if write
    (.SetWriteDeadline (.-f c) dl)
    (.SetReadDeadline (.-f c) dl))
  (let [attempt (fn ^bool [^uintptr fd]
                  (when (preclosed c)
                    (return true))
                  (op (conv int fd)))]
    (when write
      (return (.Write (.-rc c) attempt)))
    (.Read (.-rc c) attempt)))

(go/func pollNow "pollNow is the events of descriptor fd among events now (poll(2) with no wait).\n"
  [^int fd ^int16 events] :results [int16 syscall/Errno]
  (let [p (lit (slice pollFD) (lit pollFD :fd (conv int32 fd) :events events))
        (values n e) (ppoll p 0)]
    (when (or (!= e 0) (== n 0))
      (return 0 e))
    (return (.-revents (aget p 0)) 0)))

(go/type pollFD "pollFD is poll.h's struct pollfd.\n" (struct ^int32 fd ^int16 events ^int16 revents))

(go/func ppoll "ppoll is poll(2) of fds within timeout ms (negative: no limit): the count and the error.\n"
  [^{:tag (slice pollFD)} fds ^int timeout] :results [int syscall/Errno]
  (let [^{:tag (* syscall/Timespec)} tsp nil]
    (when (>= timeout 0)
      (let [ts (syscall/NsecToTimespec (* (conv int64 timeout) 1000000))]
        (set! tsp (addr ts))))
    (let [^{:tag (* pollFD)} p nil]
      (when (> (len fds) 0)
        (set! p (addr (aget fds 0))))
      (let [(values r _ e) (syscall/Syscall6 syscall/SYS_PPOLL (conv uintptr (conv unsafe/Pointer p))
                                             (conv uintptr (len fds)) (conv uintptr (conv unsafe/Pointer tsp)) 0 0 0)]
        (return (conv int r) e)))))

(go/func chDeadline "chDeadline is the deadline of a timeout of ms milliseconds (zero time for none: ms < 0).\n"
  ^{:tag time/Time} [^int64 ms]
  (when (< ms 0)
    (return (lit time/Time)))
  (.Add (time/Now) (* (conv time/Duration ms) time/Millisecond)))

;; ---------------------------------------------------------------------------------------
;; addresses (Net.c's NET_InetAddressToSockaddr and NET_SockaddrToInetAddress)

(go/func chanSockaddr
  "chanSockaddr is address addr (4 or 16 bytes), scope and port as a socket address for socket fd's family (an
IPv4 address v4-mapped on an AF_INET6 socket).\n"
  [^int fd ^{:tag (* ByteArray)} addr ^int32 scope ^int32 port] :results [syscall/Sockaddr error]
  (let [(values dom err) (syscall/GetsockoptInt fd syscall/SOL_SOCKET chSoDomain)]
    (when (!= err nil)
      (return nil err))
    (let [ip (make net/IP (len (.-A addr)))]
      (range [i x (.-A addr)]
        (aset ip i (conv byte x)))
      (if (== dom syscall/AF_INET)
        (let [v4 (.To4 ip)]
          (when (or (== v4 nil) (== (len ip) 16))
            (return nil syscall/EAFNOSUPPORT))
          (let [s (addr (lit syscall/SockaddrInet4 :Port (conv int port)))]
            (copy (subslice (.-Addr s) 0 4) v4)
            (return s nil)))
        (let [s (addr (lit syscall/SockaddrInet6 :Port (conv int port) :ZoneId (conv uint32 scope)))]
          (copy (subslice (.-Addr s) 0 16) (.To16 ip))
          (return s nil))))))

(go/func sockaddrParts
  "sockaddrParts is socket address sa's address (as Java's bytes: a v4-mapped address its 4), port and scope.\n"
  [^syscall/Sockaddr sa] :results [(* ByteArray) int32 int32]
  (do
   (let [(values s4 ok4) (assert (* syscall/SockaddrInet4) sa)
        (values s6 ok6) (assert (* syscall/SockaddrInet6) sa)]
    (cond ok4 (return (ipBytes (subslice (.-Addr s4) 0 4)) (conv int32 (.-Port s4)) 0)
          ok6 (let [ip (make net/IP 16)]
                (copy ip (subslice (.-Addr s6) 0 16))
                (if (!= (.To4 ip) nil)
                  (return (ipBytes ip) (conv int32 (.-Port s6)) 0)
                  (return (ipBytes ip) (conv int32 (.-Port s6)) (conv int32 (.-ZoneId s6))))))))
  (return (NewByteArray 4) 0 0))

;; ---------------------------------------------------------------------------------------
;; the natives

(go/func HostChannels_Strerror0_I__String_native
  "HostChannels_Strerror0_I__String_native is strerror(errno) (net.ae's texts, the C library's).\n"
  ^{:tag (* String)} [^int32 errno]
  (let [e (conv syscall/Errno errno)
        (values text ok) (aget errnoText e)]
    (when ok
      (return (Str text)))
    (Str (capitalized (.Error e)))))

(go/var ^{:tag sync/Once} ipv6Once)
(go/var ^bool ipv6Has)

(go/func HostChannels_Ipv6Available0__Z_native
  "HostChannels_Ipv6Available0__Z_native is libnet's IPv6_supported(): an AF_INET6 socket can be made and the
kernel lists IPv6 interfaces (/proc/net/if_inet6).\n"
  ^bool []
  (.Do ipv6Once (fn []
                  (let [(values fd err) (syscall/Socket syscall/AF_INET6 syscall/SOCK_STREAM 0)]
                    (when (== err nil)
                      (syscall/Close fd)
                      (let [(values _ serr) (os/Stat "/proc/net/if_inet6")]
                        (set! ipv6Has (== serr nil)))))))
  ipv6Has)

(go/func HostChannels_Socket0_Z_Z_Z_I1__I_native
  "HostChannels_Socket0_Z_Z_Z_I1__I_native is Net.socket0: a socket of AF_INET6 (ipv6) or AF_INET, stream or
datagram, IPV6_V6ONLY off on an AF_INET6 one, SO_REUSEADDR when reuse, Linux's datagram options; blocking.\n"
  ^int32 [^bool ipv6 ^bool stream ^bool reuse ^{:tag (* IntArray)} errs]
  (let [typ syscall/SOCK_STREAM
        domain syscall/AF_INET]
    (when (not stream)
      (set! typ syscall/SOCK_DGRAM))
    (when ipv6
      (set! domain syscall/AF_INET6))
    (let [(values fd err) (syscall/Socket domain (bit-or typ syscall/SOCK_CLOEXEC) 0)]
      (when (!= err nil)
        (return (chThrown errs err)))
      (let [fail (fn ^int32 [^error e]
                   (syscall/Close fd)
                   (chThrown errs e))]
        (when (== domain syscall/AF_INET6)
          (when [e (syscall/SetsockoptInt fd syscall/IPPROTO_IPV6 syscall/IPV6_V6ONLY 0)] (!= e nil)
            (return (fail e))))
        (when reuse
          (when [e (syscall/SetsockoptInt fd syscall/SOL_SOCKET syscall/SO_REUSEADDR 1)] (!= e nil)
            (return (fail e))))
        (when (== typ syscall/SOCK_DGRAM)
          (do
           (let [level syscall/IPPROTO_IP]
            (when (== domain syscall/AF_INET6)
              (set! level syscall/IPPROTO_IPV6))
            (when [e (syscall/SetsockoptInt fd level ipMulticastAll 0)] (!= e nil)
              (when (!= e syscall/ENOPROTOOPT)
                (return (fail e))))))
          (when (== domain syscall/AF_INET6)
            (when [e (syscall/SetsockoptInt fd syscall/IPPROTO_IPV6 syscall/IPV6_MULTICAST_HOPS 1)] (!= e nil)
              (return (fail e)))
            (when [e (syscall/SetsockoptInt fd syscall/IPPROTO_IPV6 ipv6MulticastAll 0)] (!= e nil)
              (when (!= e syscall/ENOPROTOOPT)
                (return (fail e))))))
        (when [e (chanAdd fd true)] (!= e nil)
          (return (fail e)))
        (conv int32 fd)))))

(go/func HostChannels_Bind0_I_B1_I_I_I1__I_native
  "HostChannels_Bind0_I_B1_I_I_I1__I_native is Net.bind0 (NET_Bind: no 127.x.y.255 on Linux): 0 or THROWN.\n"
  ^int32 [^int32 fd ^{:tag (* ByteArray)} addr ^int32 scope ^int32 port ^{:tag (* IntArray)} errs]
  (let [(values sa err) (chanSockaddr (conv int fd) addr scope port)]
    (when (!= err nil)
      (return (chThrown errs err)))
    (do
      (let [(values s4 ok4) (assert (* syscall/SockaddrInet4) sa)]
        (when (and ok4 (== (bit-and (aget (.-Addr s4) 0) 0x7f) 0x7f) (== (aget (.-Addr s4) 3) 255))
          (return (chThrown errs syscall/EADDRNOTAVAIL)))))
    (when [e (syscall/Bind (conv int fd) sa)] (!= e nil)
      (return (chThrown errs e)))
    0))

(go/func HostChannels_Listen0_I_I_I1__I_native
  "HostChannels_Listen0_I_I_I1__I_native is Net.listen: 0 or THROWN.\n"
  ^int32 [^int32 fd ^int32 backlog ^{:tag (* IntArray)} errs]
  (when [e (syscall/Listen (conv int fd) (conv int backlog))] (!= e nil)
    (return (chThrown errs e)))
  0)

(go/func connectDone
  "connectDone is a connecting socket's outcome once poll says it is writable: getsockopt's SO_ERROR (Net.c's
pollConnect).\n"
  ^error [^int fd]
  (let [(values soerr err) (syscall/GetsockoptInt fd syscall/SOL_SOCKET syscall/SO_ERROR)]
    (when (!= err nil)
      (return err))
    (when (!= soerr 0)
      (return (conv syscall/Errno soerr)))
    nil))

(go/func HostChannels_Connect0_I_B1_I_I_I1__I_native
  "HostChannels_Connect0_I_B1_I_I_I1__I_native is Net.connect0: 1 connected, UNAVAILABLE in progress (a
non-blocking socket), INTERRUPTED or THROWN; a blocking socket waits for the outcome, as the kernel's connect.\n"
  ^int32 [^int32 fd ^{:tag (* ByteArray)} addr ^int32 scope ^int32 port ^{:tag (* IntArray)} errs]
  (let [(values sa err) (chanSockaddr (conv int fd) addr scope port)]
    (when (!= err nil)
      (return (chThrown errs err)))
    (let [e (syscall/Connect (conv int fd) sa)]
      (when (== e nil)
        (return 1))
      (when (== e syscall/EINTR)
        (return iosInterrupted))
      (when (!= e syscall/EINPROGRESS)
        (return (chThrown errs e)))
      (let [c (chanGet fd)]
        (when (== c nil)
          (return iosUnavailable))
        (let [(values blocking _) (chanState c)]
          (when (not blocking)
            (return iosUnavailable))
          (let [^error out nil
                werr (waitFD c true (lit time/Time)
                             (fn ^bool [^int d]
                               (let [(values r _) (pollNow d pollOut)]
                                 (when (== r 0)
                                   (return false))
                                 (set! out (connectDone d))
                                 true)))]
            (when (preclosed c)
              (return (chThrown errs syscall/EBADF)))
            (when (!= werr nil)
              (return (chThrown errs werr)))
            (when (!= out nil)
              (return (chThrown errs out)))
            1))))))

(go/func HostChannels_Accept0_I_I1_B2_I1_I1__I_native
  "HostChannels_Accept0_I_I1_B2_I1_I1__I_native is Net.accept (ECONNABORTED retried): 1 with the new descriptor
(blocking) in newfd[0], the peer's address in addr[0], its port and scope in port; UNAVAILABLE (a non-blocking
socket with none pending), INTERRUPTED or THROWN; a blocking socket waits for a connection.\n"
  ^int32 [^int32 fd ^{:tag (* IntArray)} newfd ^{:tag (* RefArray)} addr ^{:tag (* IntArray)} port
          ^{:tag (* IntArray)} errs]
  (let [c (chanGet fd)]
    (when (== c nil)
      (return (chBadFD errs)))
    (let [^int nfd -1
          ^syscall/Sockaddr sa nil
          ^error aerr nil
          ^int32 status 0
          (values blocking _) (chanState c)
          werr (waitFD c false (lit time/Time)
                       (fn ^bool [^int d]
                         (while true
                           (let [(values n s e) (syscall/Accept4 d (bit-or syscall/SOCK_NONBLOCK syscall/SOCK_CLOEXEC))]
                             (when (== e syscall/ECONNABORTED)
                               (continue))
                             (when (== e syscall/EAGAIN)
                               (when blocking
                                 (return false))
                               (set! status iosUnavailable)
                               (return true))
                             (when (== e syscall/EINTR)
                               (set! status iosInterrupted)
                               (return true))
                             (set! nfd n)
                             (set! sa s)
                             (set! aerr e)
                             (return true)))))]
      (when (and (preclosed c) (< nfd 0))
        (return (chThrown errs syscall/EBADF)))
      (when (!= werr nil)
        (return (chThrown errs werr)))
      (when (!= status 0)
        (return status))
      (when (!= aerr nil)
        (return (chThrown errs aerr)))
      (when [e (chanAdd nfd true)] (!= e nil)
        (syscall/Close nfd)
        (return (chThrown errs e)))
      (do
        (let [(values b p s) (sockaddrParts sa)]
          (aset (.-A newfd) 0 (conv int32 nfd))
          (aset (.-A addr) 0 b)
          (aset (.-A port) 0 p)
          (aset (.-A port) 1 s)))
      1)))

(go/func HostChannels_Shutdown0_I_I_I1__I_native
  "HostChannels_Shutdown0_I_I_I1__I_native is Net.shutdown (0 read, 1 write, else both; ENOTCONN ignored).\n"
  ^int32 [^int32 fd ^int32 how ^{:tag (* IntArray)} errs]
  (let [h syscall/SHUT_RDWR]
    (cond (== how 0) (set! h syscall/SHUT_RD)
          (== how 1) (set! h syscall/SHUT_WR))
    (when [e (syscall/Shutdown (conv int fd) h)] (!= e nil)
      (when (!= e syscall/ENOTCONN)
        (return (chThrown errs e))))
    0))

(go/func HostChannels_Address0_I_Z_B2_I1_I1__I_native
  "HostChannels_Address0_I_Z_B2_I1_I1__I_native is Net's localInetAddress and localPort (getsockname), or
remoteInetAddress and remotePort (getpeername): 0 with the address in addr[0], its port and scope in port, or
THROWN.\n"
  ^int32 [^int32 fd ^bool local ^{:tag (* RefArray)} addr ^{:tag (* IntArray)} port ^{:tag (* IntArray)} errs]
  (let [^syscall/Sockaddr sa nil
        ^error err nil]
    (if local
      (set! (values sa err) (syscall/Getsockname (conv int fd)))
      (set! (values sa err) (syscall/Getpeername (conv int fd))))
    (when (!= err nil)
      (return (chThrown errs err)))
    (do
      (let [(values b p s) (sockaddrParts sa)]
        (aset (.-A addr) 0 b)
        (aset (.-A port) 0 p)
        (aset (.-A port) 1 s)))
    0))

(go/func sockoptRaw "sockoptRaw is getsockopt(2) (get) or setsockopt(2) of buf: the length got and the error.\n"
  [^int fd ^int level ^int opt ^{:tag (slice byte)} buf ^bool get] :results [int error]
  (let [n (conv uint32 (len buf))]
    (if get
      (let [(values _ _ e) (syscall/Syscall6 syscall/SYS_GETSOCKOPT (conv uintptr fd) (conv uintptr level)
                                             (conv uintptr opt) (conv uintptr (conv unsafe/Pointer (unsafe/SliceData buf)))
                                             (conv uintptr (conv unsafe/Pointer (addr n))) 0)]
        (when (!= e 0)
          (return 0 e))
        (return (conv int n) nil))
      (let [(values _ _ e) (syscall/Syscall6 syscall/SYS_SETSOCKOPT (conv uintptr fd) (conv uintptr level)
                                             (conv uintptr opt) (conv uintptr (conv unsafe/Pointer (unsafe/SliceData buf)))
                                             (conv uintptr n) 0)]
        (when (!= e 0)
          (return 0 e))
        (return (conv int n) nil)))))

(go/func HostChannels_GetIntOption0_I_Z_I_I_I1_I1__I_native
  "HostChannels_GetIntOption0_I_Z_I_I_I1_I1__I_native is Net.getIntOption0: IP_MULTICAST_TTL and _LOOP a byte,
SO_LINGER its seconds or -1, else an int; with conversion (NET_GetSockOpt) SO_SNDBUF and SO_RCVBUF halved, as
Linux doubles them: 0 with the value in value[0], or THROWN.\n"
  ^int32 [^int32 fd ^bool conversion ^int32 level ^int32 opt ^{:tag (* IntArray)} value ^{:tag (* IntArray)} errs]
  (let [f (conv int fd)
        l (conv int level)
        o (conv int opt)]
    (when (and (== l syscall/IPPROTO_IP) (or (== o syscall/IP_MULTICAST_TTL) (== o syscall/IP_MULTICAST_LOOP)))
      (let [b (make (slice byte) 1)
            (values _ err) (sockoptRaw f l o b true)]
        (when (!= err nil)
          (return (chThrown errs err)))
        (aset (.-A value) 0 (conv int32 (aget b 0)))
        (return 0)))
    (when (and (== l syscall/SOL_SOCKET) (== o syscall/SO_LINGER))
      (let [b (make (slice byte) 8)
            (values _ err) (sockoptRaw f l o b true)]
        (when (!= err nil)
          (return (chThrown errs err)))
        (if (!= (.Uint32 binary/NativeEndian (subslice b 0 4)) 0)
          (aset (.-A value) 0 (conv int32 (.Uint32 binary/NativeEndian (subslice b 4 8))))
          (aset (.-A value) 0 -1))
        (return 0)))
    (let [(values v err) (syscall/GetsockoptInt f l o)]
      (when (!= err nil)
        (return (chThrown errs err)))
      (when (and conversion (== l syscall/SOL_SOCKET) (or (== o syscall/SO_SNDBUF) (== o syscall/SO_RCVBUF)))
        (set! v (/ v 2)))
      (aset (.-A value) 0 (conv int32 v))
      0)))

(go/func HostChannels_SetIntOption0_I_Z_I_I_I_Z_I1__I_native
  "HostChannels_SetIntOption0_I_Z_I_I_I_Z_I1__I_native is Net.setIntOption0: IP_MULTICAST_TTL and _LOOP a byte,
SO_LINGER a struct linger (on when arg >= 0), else an int; with conversion (NET_SetSockOpt) IP_TOS also as
IPV6_TCLASS (with IPV6_FLOWINFO_SEND) when the host has IPv6, SO_RCVBUF at least 1024: 0 or THROWN.\n"
  ^int32 [^int32 fd ^bool conversion ^int32 level ^int32 opt ^int32 arg ^bool isIPv6 ^{:tag (* IntArray)} errs]
  (let [f (conv int fd)
        l (conv int level)
        o (conv int opt)
        a arg]
    (when (and (== l syscall/IPPROTO_IP) (or (== o syscall/IP_MULTICAST_TTL) (== o syscall/IP_MULTICAST_LOOP)))
      (let [(values _ err) (sockoptRaw f l o (lit (slice byte) (conv byte a)) false)]
        (when (!= err nil)
          (return (chThrown errs err)))
        (return 0)))
    (when (and (== l syscall/SOL_SOCKET) (== o syscall/SO_LINGER))
      (let [b (make (slice byte) 8)]
        (when (>= a 0)
          (.PutUint32 binary/NativeEndian (subslice b 0 4) 1)
          (.PutUint32 binary/NativeEndian (subslice b 4 8) (conv uint32 a)))
        (let [(values _ err) (sockoptRaw f l o b false)]
          (when (!= err nil)
            (return (chThrown errs err)))
          (return 0))))
    (when conversion
      (when (and (== l syscall/IPPROTO_IP) (== o syscall/IP_TOS) (HostChannels_Ipv6Available0__Z_native))
        (when [e (syscall/SetsockoptInt f syscall/IPPROTO_IPV6 ipv6FlowinfoSend 1)] (!= e nil)
          (return (chThrown errs e)))
        (when [e (syscall/SetsockoptInt f syscall/IPPROTO_IPV6 syscall/IPV6_TCLASS (conv int a))] (!= e nil)
          (return (chThrown errs e))))
      (when (and (== l syscall/SOL_SOCKET) (== o syscall/SO_RCVBUF) (< a 1024))
        (set! a 1024)))
    (when [e (syscall/SetsockoptInt f l o (conv int a))] (!= e nil)
      (return (chThrown errs e)))
    0))

(go/func HostChannels_Poll0_I_I_J_I1__I_native
  "HostChannels_Poll0_I_I_J_I1__I_native is Net.poll: descriptor fd's events among events within timeout ms
(0: now, -1: no limit), 0 when none, POLLHUP when it was pre-closed, or THROWN; the wait is Go's poller's
(preClose0 ends it).\n"
  ^int32 [^int32 fd ^int32 events ^int64 timeout ^{:tag (* IntArray)} errs]

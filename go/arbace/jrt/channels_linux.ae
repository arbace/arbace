        ev (conv int16 events)]
    (when (== c nil)
      ;; not a channel's descriptor: poll(2) itself (POLLNVAL for a closed one)
      (let [p (lit (slice pollFD) (lit pollFD :fd fd :events ev))
            to (conv int timeout)]

        (return (conv int32 pollHup)))
      (when (and (!= werr nil) (not (errors/Is werr os/ErrDeadlineExceeded)))
        (return (chThrown errs werr)))
      (conv int32 got))))

(go/func HostChannels_PollConnect0_I_J_I1__I_native
  "HostChannels_PollConnect0_I_J_I1__I_native is Net.pollConnect: 1 connected, 0 not yet (or a timeout), or
THROWN with the connection's error (SO_ERROR; ENOTCONN on POLLHUP), a failed poll's as its negative.\n"
  ^int32 [^int32 fd ^int64 timeout ^{:tag (* IntArray)} errs]
  (let [n (HostChannels_Poll0_I_I_J_I1__I_native fd (conv int32 pollOut) timeout errs)]
    (when (== n iosThrown)
      (aset (.-A errs) 0 (- (aget (.-A errs) 0)))
      (return iosThrown))
    (when (== n 0)
      (return 0))
    (when [e (connectDone (conv int fd))] (!= e nil)
      (return (chThrown errs e)))
    (when (!= (bit-and (conv int16 n) pollHup) 0)
      (return (chThrown errs syscall/ENOTCONN)))
    1))

(go/func HostChannels_Available0_I_I1__I_native
  "HostChannels_Available0_I_I1__I_native is Net.available (FIONREAD): the count or THROWN.\n"
  ^int32 [^int32 fd ^{:tag (* IntArray)} errs]
  (let [^int32 count 0
        (values _ _ e) (syscall/Syscall syscall/SYS_IOCTL (conv uintptr fd) (conv uintptr syscall/TIOCINQ)
                                       (conv uintptr (conv unsafe/Pointer (addr count))))]
    (when (!= e 0)
      (return (chThrown errs e)))
    count))

(go/func convertReturn
  "convertReturn is IOUtil.c's convertReturnVal of a read or write's count n and error e: n, EOF for a read's 0,
UNAVAILABLE, INTERRUPTED or THROWN.\n"
  ^int32 [^int n ^error e ^bool reading ^{:tag (* IntArray)} errs]
  (when (== e nil)
    (when (and (== n 0) reading)
      (return iosEOF))
    (return (conv int32 n)))
  (when (== e syscall/EAGAIN)
    (return iosUnavailable))
  (when (== e syscall/EINTR)
    (return iosInterrupted))
  (chThrown errs e))

(go/func HostChannels_SendOOB0_I_B_I1__I_native
  "HostChannels_SendOOB0_I_B_I1__I_native is Net.sendOOB: one byte of urgent data (MSG_OOB).\n"
  ^int32 [^int32 fd ^int8 b ^{:tag (* IntArray)} errs]
  (let [e (syscall/Sendto (conv int fd) (lit (slice byte) (conv byte b)) syscall/MSG_OOB nil)]
    (when (== e nil)
      (return (convertReturn 1 nil false errs)))
    (convertReturn -1 e false errs)))

(go/func HostChannels_Read0_I_B1_I_I_Z_I1__I_native
  "HostChannels_Read0_I_B1_I_I_Z_I1__I_native is SocketDispatcher.read0: up to len bytes of fd into b at off (a
blocking descriptor waits for some), as convertReturnVal; a pre-closed descriptor reads its end.\n"
  ^int32 [^int32 fd ^{:tag (* ByteArray)} b ^int32 off ^int32 n ^bool socket ^{:tag (* IntArray)} errs]
  (let [c (chanGet fd)]
    (when (== c nil)
      (return (chBadFD errs)))
    (let [p (byteView b off n)
          ^int k -1
          ^error rerr nil
          (values blocking _) (chanState c)
          werr (waitFD c false (lit time/Time)
                       (fn ^bool [^int d]
                         (while true
                           (let [(values m e) (syscall/Read d p)]
                             (when (== e syscall/EINTR)
                               (continue))
                             (when (and (== e syscall/EAGAIN) blocking)
                               (return false))
                             (set! k m)
                             (set! rerr e)
                             (return true)))))]
      (when (preclosed c)
        (return iosEOF))
      (when (!= werr nil)
        (return (chThrown errs werr)))
      (convertReturn k rerr true errs))))

(go/func HostChannels_Write0_I_B1_I_I_I1__I_native
  "HostChannels_Write0_I_B1_I_I_I1__I_native is SocketDispatcher.write0: len bytes of b from off to fd, every
byte when fd is blocking (as the kernel's write to a blocking socket), as convertReturnVal; a pre-closed
descriptor fails with EPIPE.\n"
  ^int32 [^int32 fd ^{:tag (* ByteArray)} b ^int32 off ^int32 n ^{:tag (* IntArray)} errs]
  (let [c (chanGet fd)]
    (when (== c nil)
      (return (chBadFD errs)))
    (let [p (byteView b off n)
          ^int done 0
          ^error werr2 nil
          (values blocking _) (chanState c)
          werr (waitFD c true (lit time/Time)
                       (fn ^bool [^int d]
                         (while true
                           (when (>= done (len p))
                             (return true))
                           (let [(values m e) (syscall/Write d (subslice p done))]
                             (when (== e syscall/EINTR)
                               (continue))
                             (when (== e syscall/EAGAIN)
                               (when (and blocking (< done (len p)))
                                 (return false))
                               (when (== done 0)
                                 (set! werr2 e))
                               (return true))
                             (when (!= e nil)
                               (when (== done 0)
                                 (set! werr2 e))
                               (return true))
                             (set! done (+ done m))
                             (when (not blocking)
                               (return true))
                             (continue)))))]
      (when (and (preclosed c) (== done 0))
        (return (chThrown errs syscall/EPIPE)))
      (when (and (!= werr nil) (== done 0))
        (return (chThrown errs werr)))
      (convertReturn done werr2 false errs))))

(go/func HostChannels_Close0_I_I1__I_native
  "HostChannels_Close0_I_I1__I_native is UnixDispatcher.close0 (and FileDispatcherImpl.closeIntFD): the
descriptor closed (EINTR ignored, as closeFileDescriptor): 0 or THROWN.\n"
  ^int32 [^int32 fd ^{:tag (* IntArray)} errs]
  (.Lock chanMu)
  (let [c (aget chanFDs fd)]
    (delete chanFDs fd)
    (.Unlock chanMu)
    (if (!= c nil)
      (when [e (.Close (.-f c))] (!= e nil)
        (when (not (errors/Is e syscall/EINTR))
          (return (chThrown errs e))))
      (when [e (syscall/Close (conv int fd))] (!= e nil)
        (when (!= e syscall/EINTR)
          (return (chThrown errs e)))))
    0))

(go/func HostChannels_PreClose0_I__V_native
  "HostChannels_PreClose0_I__V_native is UnixDispatcher.preClose0 with the signal it is sent with: descriptor fd
marked closed for its users, a thread waiting in it woken.\n"
  [^int32 fd]
  (let [c (chanGet fd)]
    (when (== c nil)
      (return))
    (.Lock chanMu)
    (set! (.-preclosed c) true)
    (.Unlock chanMu)
    (.SetDeadline (.-f c) (time/Unix 1 0))))

(go/func HostChannels_ConfigureBlocking0_I_Z_I1__I_native
  "HostChannels_ConfigureBlocking0_I_Z_I1__I_native is IOUtil.configureBlocking: the descriptor's mode as the
channel sees it (the kernel's stays non-blocking): 0 or THROWN.\n"
  ^int32 [^int32 fd ^bool blocking ^{:tag (* IntArray)} errs]
  (let [c (chanGet fd)]
    (when (== c nil)
      (return (chBadFD errs)))
    (.Lock chanMu)
    (set! (.-blocking c) blocking)
    (.Unlock chanMu)
    0))

(go/func HostChannels_MakePipe0_Z_I1_I1__I_native
  "HostChannels_MakePipe0_Z_I1_I1__I_native is IOUtil.makePipe: a pipe's read and write ends into fds, blocking
as given: 0 or THROWN.\n"
  ^int32 [^bool blocking ^{:tag (* IntArray)} fds ^{:tag (* IntArray)} errs]
  (let [p (make (slice int) 2)]
    (when [e (syscall/Pipe2 p syscall/O_CLOEXEC)] (!= e nil)
      (return (chThrown errs e)))
    (when [e (chanAdd (aget p 0) blocking)] (!= e nil)
      (syscall/Close (aget p 0))
      (syscall/Close (aget p 1))
      (return (chThrown errs e)))
    (when [e (chanAdd (aget p 1) blocking)] (!= e nil)
      (HostChannels_Close0_I_I1__I_native (conv int32 (aget p 0)) nil)
      (syscall/Close (aget p 1))
      (return (chThrown errs e)))
    (aset (.-A fds) 0 (conv int32 (aget p 0)))
    (aset (.-A fds) 1 (conv int32 (aget p 1)))
    0))

(go/func HostChannels_WriteOne0_I_B_I1__I_native
  "HostChannels_WriteOne0_I_B_I1__I_native is IOUtil.write1: one byte written at once, as convertReturnVal.\n"
  ^int32 [^int32 fd ^int8 b ^{:tag (* IntArray)} errs]
  (let [(values n e) (syscall/Write (conv int fd) (lit (slice byte) (conv byte b)))]
    (convertReturn n e false errs)))

(go/func HostChannels_Drain0_I_I1__I_native
  "HostChannels_Drain0_I_I1__I_native is IOUtil.drain: every byte read at once and discarded: 1 when there was
one, else 0, or THROWN.\n"
  ^int32 [^int32 fd ^{:tag (* IntArray)} errs]
  (let [buf (make (slice byte) 16)
        tn 0]

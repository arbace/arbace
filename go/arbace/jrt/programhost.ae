;; jrt: the program's host on an operating system (B1a's executable): OSHost, over Go's os. The
;; box's (GOOS=tamago, B1b) is hostbox_tamago.ae's.
(in-ns 'go.arbace.jrt)

(go/file "programhost.go"
  :build ["//go:build !tamago"]
  :imports [[fs "io/fs"]])

(go/const ^{:tag bool :val false
            :doc "boxYield: the evaluator does not yield (Compiler$CodeRun.tick): Go's runtime preempts.\n"}
  boxYield false)

(go/func ProgramHost
  "ProgramHost is the program's host (the main package's): OSHost, with the program's embedded
resources.\n"
  ^Host [^{:tag fs/FS} resources]
  (lit OSHost :Resources resources))

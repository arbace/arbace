;; jrt's tests: the serial forms of jrt's locks, Semaphore and ForkJoinTask's adapters (serial_locks.ae; JCS191 (a),
;; doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: JCS191") against the bytes jdk26u's ObjectOutputStream writes for
;; the same objects (jdkLockStreams, recorded by hand once by test/jrt/serialization/SerialRecordLocks.java on jdk26u's
;; JDK), through serial_test.ae's stream (serOut, serIn). The synchronizers' twins (lockAOS_class, lockAQS_class,
;; lockAQLS_class) are registered here when no class of their names is (jrt's package alone; in the world the
;; translated ones are, and the object stream matches the twins by name). Each case: the object made by jrt written to
;; the JDK's bytes; the JDK's bytes read into a jrt object that shows the same (a held lock is read unlocked, as on the
;; JDK: written again it is the unheld case's bytes), and written again to the same bytes.
(in-ns 'go.arbace.jrt)

(go/file "serial_locks_test.go"
  :imports [[fmt "fmt"] [sort "sort"] [strings "strings"] [testing "testing"]])

(go/var ^{:doc "jdkLockStreams: each case's bytes as jdk26u's ObjectOutputStream writes them (SerialRecordLocks.java)\n"
          :tag (map string string)} jdkLockStreams
  (lit (map string string)
    ["reentrantlock" ""]
    ["reentrantlock-fair" ""]
    ["reentrantlock-held" ""]
    ["rwlock" ""]
    ["rwlock-fair" ""]
    ["rwlock-held" ""]
    ["rwlock-readlock" ""]
    ["semaphore" ""]
    ["semaphore-fair" ""]
    ["fjt-runnable" ""]
    ["fjt-callable-done" ""]
    ["fjt-action-cancelled" ""]
    ["fjt-action-thrown" ""]
    ["fjt-action-tagged" ""]
))

(go/var ^{:doc "the held cases: read back unlocked, written again as the unheld case\n" :tag (map string string)}
  lockHeldAs
  (lit (map string string) ["reentrantlock-held" "reentrantlock"] ["rwlock-held" "rwlock"]))

(go/func init
  "init registers the synchronizers' twins under their names when the package has no class of them (jrt alone,
the test's world): the test stream resolves a stream's class descriptors by Class.forName.\n"
  []
  (.Lock registryMu)
  (range [_ c (lit (slice (* Class)) lockAOS_class lockAQS_class lockAQLS_class)]
    (when (== (aget registry (.-Name (.-info c))) nil)
      (aset registry (.-Name (.-info c)) c)))
  (.Unlock registryMu))

(go/func lockCases "lockCases are the cases' objects as jrt makes them, SerialRecordLocks.java's, and what undoes
their holds once written.\n"
  [] :results [^{:tag (map string any)} cs ^{:tag (slice (func []))} undo]
  (let [held (ReentrantLock_New)
        rw (ReentrantReadWriteLock_New)
        done (addr (lit ForkJoinTask_AdaptedCallable))
        cancelled (addr (lit ForkJoinTask_AdaptedRunnableAction))
        thrown (addr (lit ForkJoinTask_AdaptedRunnableAction))
        tagged (addr (lit ForkJoinTask_AdaptedRunnableAction))
        x (Throwable_New_String (Str "x"))]
    (.Lock__V held)
    (.Lock__V held)
    (.Lock__V (.-wl rw))
    (.Lock__V (.-rl rw))
    (.Complete_O__V done (Str "v"))
    (.Cancel_Z__Z cancelled false)
    (.SetStackTrace_StackTraceElement1__V x (NewRefArray StackTraceElement_class 0))
    (.TrySetThrown_Throwable__Z thrown x)
    (.SetForkJoinTaskTag_S__S tagged 7)
    (return
      (lit (map string any)
        ["reentrantlock" (ReentrantLock_New)]
        ["reentrantlock-fair" (ReentrantLock_New_Z true)]
        ["reentrantlock-held" held]
        ["rwlock" (ReentrantReadWriteLock_New)]
        ["rwlock-fair" (ReentrantReadWriteLock_New_Z true)]
        ["rwlock-held" rw]
        ["rwlock-readlock" (.-rl (ReentrantReadWriteLock_New))]
        ["semaphore" (Semaphore_New_I 3)]
        ["semaphore-fair" (Semaphore_New_I_Z -2 true)]
        ["fjt-runnable" (addr (lit ForkJoinTask_AdaptedRunnable :result (Str "r")))]
        ["fjt-callable-done" done]
        ["fjt-action-cancelled" cancelled]
        ["fjt-action-thrown" thrown]
        ["fjt-action-tagged" tagged])
      (lit (slice (func []))
        (fn [] (.Unlock__V held) (.Unlock__V held))
        (fn [] (.Unlock__V (.-rl rw)) (.Unlock__V (.-wl rw)))))))

(go/func fjtText ^string [^{:tag (* ForkJoinTask)} t ^any result]
  (let [e "null"]
    (when (!= (.-exc t) nil)
      (set! e (.String (StrOfObj (.-exc t)))))
    (return (fmt/Sprintf "status=%08x exc=%s result=%s" (conv uint32 (.serialStatus t)) e (.String (StrOfObj result))))))

(go/func lockText "lockText is what a case's object shows, to compare the object read with the one made.\n"
  ^string [^any x]
  (type-switch [v x]
    (case [(* ReentrantLock)]
      (return (fmt/Sprintf "lock fair=%v locked=%v" (.IsFair__Z v) (.IsLocked__Z v))))
    (case [(* ReentrantReadWriteLock)]
      (return (fmt/Sprintf "rwlock fair=%v written=%v reads=%d views=%v" (.-fair v) (.IsWriteLocked__Z v)
                           (.GetReadLockCount__I v) (and (== (.-rw (.-rl v)) v) (== (.-rw (.-wl v)) v)))))
    (case [(* ReentrantReadWriteLock_ReadLock)]
      (return (fmt/Sprintf "readlock of %s" (lockText (.-rw v)))))
    (case [(* Semaphore)]
      (return (fmt/Sprintf "semaphore permits=%d fair=%v" (.AvailablePermits__I v) (.IsFair__Z v))))
    (case [(* ForkJoinTask_AdaptedRunnable)] (return (+ "runnable " (fjtText (addr (.-ForkJoinTask v)) (.-result v)))))
    (case [(* ForkJoinTask_AdaptedCallable)] (return (+ "callable " (fjtText (addr (.-ForkJoinTask v)) (.-result v)))))
    (case [(* ForkJoinTask_AdaptedRunnableAction)] (return (+ "action " (fjtText (addr (.-ForkJoinTask v)) nil)))))
  (return (.String (StrOfObj x))))

(go/func TestSerialLocks
  "TestSerialLocks: each case written as the JDK writes it, the JDK's bytes read back to an object showing what
the made one shows (a held lock unlocked), and written again to the same bytes (a held one to the unheld case's).\n"
  [^{:tag (* testing/T)} t]
  (let [(values cases undo) (lockCases)
        names (make (slice string) 0)
        written (make (map string string))]
    (range [n _ jdkLockStreams] (set! names (append names n)))
    (sort/Strings names)
    (range [_ n names]
      (let [x (aget cases n)]
        (when (== x nil)
          (.Errorf t "%s: no case" n)
          (continue))
        (aset written n (res (fn ^string [] (return (serWrite x)))))))
    (range [_ u undo] (u))
    (range [_ n names]
      (let [want (aget jdkLockStreams n)
            x (aget cases n)
            again want
            (values base held) (aget lockHeldAs n)]
        (when (== x nil)
          (continue))
        (when (!= (aget written n) want)
          (.Errorf t "%s: written\n got %s\nwant %s" n (aget written n) want))
        (when held
          (set! again (aget jdkLockStreams base)))
        (let [^any back nil
              rd (res (fn ^string [] (set! back (serRead want)) (return "")))]
          (when (!= rd "")
            (.Errorf t "%s: read: %s" n rd)
            (continue))
          (when (!= (lockText back) (lockText x))
            (.Errorf t "%s: read\n got %s\nwant %s" n (lockText back) (lockText x)))
          (let [w (res (fn ^string [] (return (serWrite back))))]
            (when (!= w again)
              (.Errorf t "%s: written again\n got %s\nwant %s" n w again))))))))

(go/func TestSerialLocksRead
  "TestSerialLocksRead: what reading gives: a lock read usable (taken and released), a semaphore's permits
acquired, a read lock read alone a view of a lock of its own, the thrown task's exception its getException.\n"
  [^{:tag (* testing/T)} t]
  (let [l (assert (* ReentrantLock) (serRead (aget jdkLockStreams "reentrantlock-held")))]
    (when (not (.TryLock__Z l))
      (.Error t "reentrantlock-held: read locked"))
    (.Unlock__V l))
  (let [rw (assert (* ReentrantReadWriteLock) (serRead (aget jdkLockStreams "rwlock-fair")))]
    (.Lock__V (.-wl rw))
    (when (not (.IsWriteLockedByCurrentThread__Z rw))
      (.Error t "rwlock-fair: the write lock read not the lock's"))
    (.Unlock__V (.-wl rw)))
  (let [r (assert (* ReentrantReadWriteLock_ReadLock) (serRead (aget jdkLockStreams "rwlock-readlock")))]
    (.Lock__V r)
    (when (!= (.GetReadLockCount__I (.-rw r)) 1)
      (.Error t "rwlock-readlock: its lock not held"))
    (.Unlock__V r))
  (let [s (assert (* Semaphore) (serRead (aget jdkLockStreams "semaphore")))]
    (when (not (.TryAcquire_I__Z s 3))
      (.Error t "semaphore: 3 permits not read")))
  (let [f (assert (* ForkJoinTask_AdaptedRunnableAction) (serRead (aget jdkLockStreams "fjt-action-thrown")))
        e (.GetException__Throwable f)]
    (when (or (== e nil) (!= (.String (.GetMessage__String e)) "x") (not (.IsCompletedAbnormally__Z f)))
      (.Error t "fjt-action-thrown: the exception not read")))
  (let [f (assert (* ForkJoinTask_AdaptedRunnableAction) (serRead (aget jdkLockStreams "fjt-action-cancelled")))]
    (when (not (.IsCancelled__Z f))
      (.Error t "fjt-action-cancelled: not cancelled"))))

(go/func TestSerialLocksControl
  "TestSerialLocksControl, the negative controls: a fair lock's bytes are not the non-fair one's, a semaphore of
other permits not the case's, and a stream whose NonfairSync's serialVersionUID is not the class's is refused.\n"
  [^{:tag (* testing/T)} t]
  (when (== (serWrite (ReentrantLock_New_Z true)) (aget jdkLockStreams "reentrantlock"))
    (.Error t "control: a fair lock's bytes equal the non-fair one's"))
  (when (== (serWrite (Semaphore_New_I 4)) (aget jdkLockStreams "semaphore"))
    (.Error t "control: another semaphore's bytes equal"))
  ;; ReentrantLock$NonfairSync's serialVersionUID 7316153563782823691 (0x658832...) changed in its last byte
  (let [h (aget jdkLockStreams "reentrantlock")
        i (strings/Index h "4e6f6e6661697253796e63")
        bad (+ (subslice h 0 (+ i 22 15)) "0" (subslice h (+ i 22 16)))
        r (res (fn ^string [] (serRead bad) (return "read")))]
    (when (not (strings/Contains r "local class incompatible: java.util.concurrent.locks.ReentrantLock$NonfairSync"))
      (.Error t (+ "control: a wrong serialVersionUID read: " r)))))

;; jrt: the natives of sun.security.krb5's Config and Credentials (java-design-1123's Kerberos round): both are
;; platform hooks jdk26u implements only on Windows and macOS (Config.getWindowsDirectory reads the Windows directory,
;; Credentials.acquireDefaultNativeCreds asks the OS's native credential cache); on Linux the JDK has no native for them
;; and its Java never reaches them, or reaches them only to fall back. Here they answer as an OS without that facility:
;; null, which the Java callers already handle (Config falls back to /etc/krb5.conf; Credentials to the file cache).
(in-ns 'go.arbace.jrt)

(go/file "krb5_natives.go")

(go/func Config_GetWindowsDirectory_Z__String_native
  "Config_GetWindowsDirectory_Z__String_native is sun.security.krb5.Config.getWindowsDirectory: null, there being no
Windows directory on this platform.\n"
  ^{:tag (* String)} [^bool _]
  nil)

(go/func Credentials_AcquireDefaultNativeCreds_I1__Credentials_native
  "Credentials_AcquireDefaultNativeCreds_I1__Credentials_native is sun.security.krb5.Credentials.acquireDefaultNativeCreds:
null, there being no native credential cache to ask on this platform.\n"
  ^{:tag (* Credentials)} [^{:tag (* IntArray)} _]
  nil)

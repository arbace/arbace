;; jrt's tests: jrt's serial test stream (serial_test.ae's serOut, serIn) over j2g's member tables of translated JDK
;; classes (JCS193 (b), the user's decision of 2026-11-08; doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: JCS193"), in a
;; program root of j2g's (bin/jrt test --prog DIR, DIR bin/j2g --tests --out OUT's OUT/prog): each case's object made by
;; reflection over the translated classes (serial_classes.ae's serialCall, serialNewObject), written to the bytes jdk26u's
;; ObjectOutputStream writes for it (jdkProgStreams, recorded by hand once by test/jrt/serialization/SerialRecordProg.java),
;; the JDK's bytes read back into an object showing the same, written again to the same bytes: a check of j2g's serial
;; tables (serialVersionUID, the serial fields, ClassInfo.SerialNew) without the translated streams. Classes without
;; serialization hooks only (a translated hook calls the translated stream's own methods: streams_check.ae's, the
;; night's). In jrt's package alone (no translated classes) the test is skipped.
(in-ns 'go.arbace.jrt)

(go/file "serial_prog_test.go"
  :imports [[sort "sort"] [testing "testing"]])

(go/var ^{:doc "jdkProgStreams: each case's bytes as jdk26u's ObjectOutputStream writes them (SerialRecordProg.java)\n"
          :tag (map string string)} jdkProgStreams
  (lit (map string string)
    ["integer" "aced0005737200116a6176612e6c616e672e496e746567657212e2a0a4f781873802000149000576616c7565787200106a6176612e6c616e672e4e756d62657286ac951d0b94e08b02000078700000002a"]
    ["long" "aced00057372000e6a6176612e6c616e672e4c6f6e673b8be490cc8f23df0200014a000576616c7565787200106a6176612e6c616e672e4e756d62657286ac951d0b94e08b0200007870fffffffffffffffb"]
    ["boolean" "aced0005737200116a6176612e6c616e672e426f6f6c65616ecd207280d59cfaee0200015a000576616c7565787001"]
    ["character" "aced0005737200136a6176612e6c616e672e436861726163746572348b47d96b1a267802000143000576616c756578700078"]
    ["double" "aced0005737200106a6176612e6c616e672e446f75626c6580b3c24a296bfb0402000144000576616c7565787200106a6176612e6c616e672e4e756d62657286ac951d0b94e08b02000078703ff8000000000000"]
    ["uuid" "aced00057372000e6a6176612e7574696c2e55554944bc9903f7986d852f0200024a000c6c65617374536967426974734a000b6d6f7374536967426974737870fedcba98765432100123456789abcdef"]
    ["entry" ""]
    ["immutable-entry" "aced00057372002a6a6176612e7574696c2e41627374726163744d61702453696d706c65496d6d757461626c65456e7472796310708932e65f810200024c00036b65797400124c6a6176612f6c616e672f4f626a6563743b4c000576616c756571007e000178707400016b74000176"]
    ["singleton-list" "aced0005737200236a6176612e7574696c2e436f6c6c656374696f6e732453696e676c65746f6e4c6973742aef29103ca79b970200014c0007656c656d656e747400124c6a6176612f6c616e672f4f626a6563743b787074000178"]
    ["as-list" "aced00057372001a6a6176612e7574696c2e4172726179732441727261794c697374d9a43cbecd8806d20200015b0001617400135b4c6a6176612f6c616e672f4f626a6563743b7870757200135b4c6a6176612e6c616e672e537472696e673badd256e7e91d7b470200007870000000027400016174000162"]
))

(go/func progCases
  "progCases are the cases' objects as jdk26u makes them (SerialRecordProg.java's), made by reflection over the
translated classes; nil when the program has not their classes.\n"
  ^{:tag (map string any)} []
  (when (or (== (ForName "java.lang.Integer") nil) (== (ForName "java.util.UUID") nil)
            (== (ForName "java.util.AbstractMap$SimpleEntry") nil) (== (ForName "java.util.Arrays") nil))
    (return nil))
  (let [one (serialCall nil "java.lang.Integer" "valueOf" (lit (slice (* Class)) Prim_int) (lit (slice any) (conv int32 1)))
        oo (lit (slice (* Class)) Object_class Object_class)]
    (return
      (lit (map string any)
        ["integer" (serialCall nil "java.lang.Integer" "valueOf" (lit (slice (* Class)) Prim_int) (lit (slice any) (conv int32 42)))]
        ["long" (serialCall nil "java.lang.Long" "valueOf" (lit (slice (* Class)) Prim_long) (lit (slice any) (conv int64 -5)))]
        ["boolean" (serialCall nil "java.lang.Boolean" "valueOf" (lit (slice (* Class)) Prim_boolean) (lit (slice any) true))]
        ["character" (serialCall nil "java.lang.Character" "valueOf" (lit (slice (* Class)) Prim_char) (lit (slice any) (conv uint16 120)))]
        ["double" (serialCall nil "java.lang.Double" "valueOf" (lit (slice (* Class)) Prim_double) (lit (slice any) (conv float64 1.5)))]
        ["uuid" (serialNewObject "java.util.UUID" (lit (slice (* Class)) Prim_long Prim_long)
                                 (lit (slice any) (conv int64 81985529216486895) (conv int64 -81985529216486896)))]
        ["entry" (serialNewObject "java.util.AbstractMap$SimpleEntry" oo (lit (slice any) (Str "k") one))]
        ["immutable-entry" (serialNewObject "java.util.AbstractMap$SimpleImmutableEntry" oo (lit (slice any) (Str "k") (Str "v")))]
        ["singleton-list" (serialCall nil "java.util.Collections" "singletonList" (lit (slice (* Class)) Object_class)
                                      (lit (slice any) (Str "x")))]
        ["as-list" (serialCall nil "java.util.Arrays" "asList" (lit (slice (* Class)) (.ArrayClass Object_class))
                               (lit (slice any) (RefArrayOf String_class (Str "a") (Str "b"))))]))))

(go/func TestSerialProg
  "TestSerialProg: in a program root of j2g's, each translated class's object written as the JDK writes it, the
JDK's bytes read back to an object of the same class and text, and written again to the same bytes.\n"
  [^{:tag (* testing/T)} t]
  (when (not serProg)
    (.Skip t "jrt's package alone: no translated classes (bin/jrt test --prog)"))
  (let [cases (progCases)
        names (make (slice string) 0)]
    (when (== cases nil)
      (.Skip t "the program has not the cases' classes"))
    (range [n _ jdkProgStreams] (set! names (append names n)))
    (sort/Strings names)
    (range [_ n names]
      (let [want (aget jdkProgStreams n)
            x (aget cases n)]
        (let [got (res (fn ^string [] (return (serWrite x))))]
          (when (!= got want)
            (.Errorf t "%s: written\n got %s\nwant %s" n got want)))
        (let [^any back nil
              rd (res (fn ^string [] (set! back (serRead want)) (return "")))]
          (when (!= rd "")
            (.Errorf t "%s: read: %s" n rd)
            (continue))
          (when (or (!= (GetClass back) (GetClass x)) (!= (.String (StrOfObj back)) (.String (StrOfObj x))))
            (.Errorf t "%s: read\n got %s %s\nwant %s %s" n (.GoName (GetClass back)) (.String (StrOfObj back))
                     (.GoName (GetClass x)) (.String (StrOfObj x))))
          (let [again (res (fn ^string [] (return (serWrite back))))]
            (when (!= again want)
              (.Errorf t "%s: written again\n got %s\nwant %s" n again want))))))
    ;; the negative control: a case's object judged against another case's bytes fails
    (when (== (res (fn ^string [] (return (serWrite (aget cases "long"))))) (aget jdkProgStreams "integer"))
      (.Error t "control: a Long written as the Integer's bytes"))))

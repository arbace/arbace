;; jrt: the operating system's facts of OperatingSystemMXBean in the box (doc/classes/JAVA-DEFERRED-TRIAGE.md, F13
;; slice 5): the guest has no operating system to ask; every fact is unknown (-1), as the JDK answers one it
;; cannot read.
(in-ns 'go.arbace.jrt)

(go/file "management_tamago.go"
  :build ["//go:build tamago"])

(go/func HostManagement_Os0_I__J_native ^int64 [^int32 k] -1)
(go/func HostManagement_CpuLoad0_I__D_native ^float64 [^int32 cpu] -1)
(go/func HostManagement_ProcessCpuLoad0__D_native ^float64 [] -1)
(go/func HostManagement_LoadAverage0__D_native ^float64 [] -1)

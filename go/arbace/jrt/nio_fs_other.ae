;; jrt: the natives of java.nio.file's default provider (nio_fs_linux.ae; doc/classes/JAVA-DEFERRED-TRIAGE.md, F9,
;; "As built: F9 (write-ahead)") on systems without Linux's (TamaGo's, the box): each throws an IOException, "the
;; default file system not available" (the box's java.io.File, over its store, unchanged; JCS180).
;; Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'go.arbace.jrt)

(go/file "nio_fs_other.go"
  :build ["//go:build !linux"])

(go/func noNioFs "noNioFs throws: no default file system here.\n" []
  (panic (IOException_New_String (Str "java.nio.file's default file system not available"))))

(go/func UnixNativeDispatcher_JrtExceptions_O__V_native "UnixNativeDispatcher_JrtExceptions_O__V_native: not available.\n"
  [^any f])


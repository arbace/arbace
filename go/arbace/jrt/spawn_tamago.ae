;; jrt: tool guests in the box (doc/go/BOX-NOTES.md, S7): the box's host as a SpawnHost, by the
;; monitor's calls Spawn and SpawnPoll (arbace/box/abi), which the launcher answers under its
;; policy (ARBACE_BOX_SPAWN) and budget.
(in-ns 'go.arbace.jrt)

(go/file "spawn_tamago.go"
  :build ["//go:build tamago"]
  :imports [[abi "arbace/box/abi"] [board "arbace/box/board"]])

(go/method Spawn
  "Spawn is the monitor's Spawn: the request's hash in a heap buffer (the monitor reads it by
address).\n"
  [^boxHost h ^{:tag (array 32 byte)} req] :results [int64 error]
  (let [args (boxStoreArgs)]
    (copy args (subslice req))
    (let [r (.-Ret (board/Call abi/Spawn (board/Addr (subslice args 0 32)) 0 0 0 0))]
      (when (< r 0)
        (return 0 ErrSpawnRefused))
      (return r nil))))

(go/method SpawnPoll
  "SpawnPoll is the monitor's SpawnPoll.\n"
  [^boxHost h ^int64 id] :results [(array 32 byte) bool error]
  (let [args (boxStoreArgs)
        ^{:tag (array 32 byte)} res (zero (array 32 byte))
        r (.-Ret (board/Call abi/SpawnPoll id (board/Addr (subslice args 0 32)) 0 0 0))]
    (switch r
      (case [0]
        (copy (subslice res) (subslice args 0 32))
        (return res true nil))
      (case [abi/SpawnRunning]
        (return res false nil)))
    (return res false ErrSpawnRefused)))

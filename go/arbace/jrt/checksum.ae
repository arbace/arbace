;; jrt: the natives of java.util.zip's checksums beyond CRC32's (timezone.ae): Adler32's update
;; and updateBytes, as zlib's adler32 computes them, and CRC32C's bulk update over Go's
;; hash/crc32 with the Castagnoli polynomial (doc/classes/JAVA-CONFORMANCE-SURVEY.md, "As built:
;; JC6b"; the variants overlay/jdk/variants/Adler32.ae, CRC32C.ae).
(in-ns 'go.arbace.jrt)

(go/file "checksum.go"
  :imports [[crc32 "hash/crc32"]])

(go/func adlerUpdate
  "adlerUpdate is zlib's adler32: the Adler-32 of p after adler.\n"
  ^uint32 [^uint32 adler ^{:tag (slice byte)} p]
  (let [a (bit-and adler 0xffff)
        b (bit-and (>> adler 16) 0xffff)]
    (while (> (len p) 0)
      (let [n (len p)]
        (when (> n 5552)
          (set! n 5552))
        (for [i 0] (< i n) (inc! i)
          (set! a + (conv uint32 (aget p i)))
          (set! b + a))
        (set! a (% a 65521))
        (set! b (% b 65521))
        (set! p (subslice p n))))
    (bit-or (<< b 16) a)))

(go/func Adler32_Update_I_I__I_native
  "Adler32_Update_I_I__I_native is Adler32's native update(int adler, int b): the Adler-32 of
the byte b after adler.\n"
  ^int32 [^int32 adler ^int32 b]
  (conv int32 (adlerUpdate (conv uint32 adler) (lit (slice byte) (conv byte b)))))

(go/func Adler32_UpdateBytes_I_B1_I_I__I_native
  "Adler32_UpdateBytes_I_B1_I_I__I_native is Adler32's native updateBytes: the Adler-32 of
b[off, off+len) after adler (the caller checked the bounds).\n"
  ^int32 [^int32 adler ^{:tag (* ByteArray)} b ^int32 off ^int32 n]
  (let [p (make (slice byte) n)]
    (for [i (conv int32 0)] (< i n) (inc! i)
      (aset p i (conv byte (aget (.-A b) (+ off i)))))
    (conv int32 (adlerUpdate (conv uint32 adler) p))))

(go/var ^{:tag (* crc32/Table)} castagnoliTable (crc32/MakeTable crc32/Castagnoli))

(go/func CRC32C_HostUpdateBytes_I_B1_I_I__I_native
  "CRC32C_HostUpdateBytes_I_B1_I_I__I_native is CRC32C's updateBytes(crc, b, off, end): the
CRC-32C register after b[off, end), the register crc being the complement of the checksum (as
CRC32C keeps it).\n"
  ^int32 [^int32 crc ^{:tag (* ByteArray)} b ^int32 off ^int32 end]
  (let [p (make (slice byte) (- end off))]
    (for [i off] (< i end) (inc! i)
      (aset p (- i off) (conv byte (aget (.-A b) i))))
    (conv int32 (bit-not (crc32/Update (bit-not (conv uint32 crc)) castagnoliTable p)))))

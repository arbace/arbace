;; jrt: Java serialization's natives (JCS167 (a), the user's decision of 2026-11-07; doc/classes/
;; JAVA-DEFERRED-TRIAGE.md, "As built: JCS167 (write-ahead)"; CDR10's staging, doc/go/JRT-NOTES.md,
;; "Serialization"), beside jdk26u's java.io streams (ObjectStreamClass and ObjectInputStream as jrt's
;; variants, overlay/jdk/java.base/java/io):
;;   SerialAlloc.canAllocate0, allocate0 (jdk.internal.jrt.SerialAlloc): ClassInfo.SerialNew, the
;;     object made as jdk.internal.reflect.ReflectionFactory.newConstructorForSerialization's
;;     constructor makes it. j2g writes it for each instantiated concrete Serializable class C of the
;;     world whose first non-serializable superclass S the factory's rule allows (arbace.j2g.model/
;;     serial-super: superHasAccessibleConstructor up the chain, S's no-argument constructor accessible
;;     to C): C's zero struct, S's constructor body run on it (Ctor of S's embedded struct, this the
;;     object), C's own constructors and its serializable superclasses' not run. The Java forms' host
;;     sets it for an interpreted class (Compiler$CFGo.setSerialNew: Compiler$CF$Rt.serialPlan's rule
;;     over the interpreter's classes, then the nearest class of the world's part, j2g's cfSerialFor);
;;   SerialAlloc.hasDefaultSUID0, defaultSUID0: ClassInfo.SerialUID (JCS168), the default serialVersionUID
;;     computed ahead of time from the class's declaration as javac compiles it (arbace.classes.suid),
;;     which the variant's computeDefaultSUID returns before computing it by reflection;
;;   ObjectStreamClass.initNative: nothing (the JVM's caches field IDs);
;;   ObjectStreamClass.hasStaticInitializer: the class's Init (C_Init: j2g writes it for a class with a
;;     static initializer or static field initializers, the <clinit> the default serialVersionUID asks;
;;     an interpreted class's, the Java forms' host's for a class with static fields);
;;   Proxy.isProxyClass, Proxy.getProxyClass: the classes java.lang.reflect.Proxy makes over j2g's Dyn
;;     (JCS170 (a), reflect.ae's ProxyClassFor; a stream's proxy class descriptor resolved by
;;     ObjectInputStream.resolveProxyClass through getProxyClass);
;;   VM.latestUserDefinedLoader (ObjectInputStream.resolveClass's loader): the application class
;;     loader, the loader of every class of the closed world and of the REPL's (ClassLoader's).
(in-ns 'go.arbace.jrt)

(go/file "serial.go")

(go/func SerialAlloc_CanAllocate0_Class__Z_native
  "SerialAlloc_CanAllocate0_Class__Z_native tells whether c's objects can be made for deserialization:
its class info has a SerialNew.\n"
  ^bool [^{:tag (* Class)} c]
  (and (!= c nil) (!= (.-SerialNew (.Info c)) nil)))

(go/func SerialAlloc_Allocate0_Class__O_native
  "SerialAlloc_Allocate0_Class__O_native is a new object of c made by its SerialNew.\n"
  ^any [^{:tag (* Class)} c]
  ((.-SerialNew (.Info c))))

(go/func SerialAlloc_HasDefaultSUID0_Class__Z_native
  "SerialAlloc_HasDefaultSUID0_Class__Z_native tells whether c's default serialVersionUID was computed
ahead of time (ClassInfo.HasSerialUID).\n"
  ^bool [^{:tag (* Class)} c]
  (and (!= c nil) (.-HasSerialUID (.Info c))))

(go/func SerialAlloc_DefaultSUID0_Class__J_native
  "SerialAlloc_DefaultSUID0_Class__J_native is c's default serialVersionUID computed ahead of time.\n"
  ^int64 [^{:tag (* Class)} c]
  (.-SerialUID (.Info c)))

(go/func ObjectStreamClass_InitNative__V_native "ObjectStreamClass_InitNative__V_native does nothing.\n" [])

(go/func ObjectStreamClass_HasStaticInitializer_Class__Z_native
  "ObjectStreamClass_HasStaticInitializer_Class__Z_native tells whether c has a static initializer:
its class info's Init.\n"
  ^bool [^{:tag (* Class)} c]
  (!= (.-Init (.Info c)) nil))

(go/func Proxy_IsProxyClass_Class__Z
  "Proxy_IsProxyClass_Class__Z is Proxy.isProxyClass: whether c was made by java.lang.reflect.Proxy
(JCS170, reflect.ae's ProxyClassFor).\n"
  ^bool [^{:tag (* Class)} c]
  (when (== c nil) (panic (NPE)))
  (IsProxyClass c))

(go/func Proxy_GetProxyClass_ClassLoader_Class1__Class
  "Proxy_GetProxyClass_ClassLoader_Class1__Class is Proxy.getProxyClass (ObjectInputStream's
resolveProxyClass): the proxy class of the interfaces, one per list of interfaces (JCS170,
reflect.ae's ProxyClassFor; UnsupportedOperationException in a world without the evaluator).\n"
  ^{:tag (* Class)} [^ClassLoader_I loader ^{:tag (* RefArray)} interfaces]
  (let [f (proxyNeeded)]
    (when (== interfaces nil) (panic (NPE)))
    (f interfaces)))

(go/func VM_LatestUserDefinedLoader__ClassLoader
  "VM_LatestUserDefinedLoader__ClassLoader is VM.latestUserDefinedLoader: the application class
loader (the loader of every class of the closed world and of the classes the REPL makes).\n"
  ^ClassLoader_I []
  (ClassLoader_GetSystemClassLoader__ClassLoader))

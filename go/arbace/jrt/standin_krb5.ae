;; jrt's stand-in for sun.security.krb5.Credentials (doc/go/JRT-NOTES.md, "Stand-ins"): the type jrt's own build needs
;; to name Credentials.acquireDefaultNativeCreds' native (krb5_natives.ae). In the program Credentials is translated
;; from jdk26u by j2g, and this file is deleted then (train-1, 2026-11-23).
(in-ns 'go.arbace.jrt)

(go/file "standin_krb5.go")

(go/type Credentials "Credentials is sun.security.krb5.Credentials (no member jrt uses).\n" (struct Object))

(go/var Credentials_class
  (Define (addr (lit ClassInfo :Name "sun.security.krb5.Credentials" :Kind KindClass
                     :Modifiers AccPublic :Super Object_class :Go "arbace/jrt.Credentials"))))

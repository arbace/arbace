;; jrt: java.lang.ClassLoader, minimal (JRT-SOURCES.md, "rework"; J2G-SPEC §10.3, §12): there is
;; no class loading, only the registry of the closed world. The application and platform
;; loaders exist as objects so that Class.getClassLoader, ClassLoader.getSystemClassLoader
;; (ForkJoinWorkerThread) and Arbace's RT.baseLoader have values; loadClass looks names up in
;; the registry. (jdk.internal.foreign.Utils.checkNonNegativeArgument, List.of's check, was here until
;; java-design-1122: Utils is translated since, a derived overlay, with the foreign memory API.) Since
;; CDR11 (doc/CLOJURE-DESIGN-REVIEW.md, the user, 2026-11-06) a superclass the Java forms and gen-class
;; may extend (arbace.j2g.model/class-supers): its methods are promoted to a DynSub_ClassLoader.
(in-ns 'go.arbace.jrt)

(go/file "classloader.go"
  :imports [[sort "sort"] [strings "strings"] [sync "sync"]])

(go/type ClassLoader_I
  "ClassLoader_I is java.lang.ClassLoader's class interface.\n"
  (interface Object_I
    (Self_ClassLoader ^{:tag (* ClassLoader)} [])
    (LoadClass_String__Class ^{:tag (* Class)} [^{:tag (* String)} name])
    (LoadClass_String_Z__Class ^{:tag (* Class)} [^{:tag (* String)} name ^bool resolve])
    (FindClass_String__Class ^{:tag (* Class)} [^{:tag (* String)} name])
    (GetParent__ClassLoader ^ClassLoader_I [])
    (GetName__String ^{:tag (* String)} [])
    (GetDefinedPackage_String__Package ^{:tag (* Package)} [^{:tag (* String)} name])
    (GetDefinedPackages__Package1 ^{:tag (* RefArray)} [])
    ;; java-bytecode-1122's other members (defineclass.ae)
    (GetPackage_String__Package ^{:tag (* Package)} [^{:tag (* String)} name])
    (GetPackages__Package1 ^{:tag (* RefArray)} [])
    (IsRegisteredAsParallelCapable__Z ^bool [])
    (SetClassAssertionStatus_String_Z__V [^{:tag (* String)} className ^bool enabled])
    (SetPackageAssertionStatus_String_Z__V [^{:tag (* String)} packageName ^bool enabled])
    (SetDefaultAssertionStatus_Z__V [^bool enabled])
    (ClearAssertionStatus__V [])))

(go/type ClassLoader
  "ClassLoader is java.lang.ClassLoader (abstract): a parent, a name, whether it is parallel capable (its class
registered when it was made: jdk26u's parallelLockMap), and the loader object it is the part of (self: its subclass's,
whose overrides loadClass calls; java-bytecode-1122, defineclass.ae).\n"
  (struct Object ^ClassLoader_I parent ^{:tag (* String)} name ^bool parallel ^ClassLoader_I self
          ^{:tag (map string (* Class)) :doc "the classes it defined from bytes, by binary name (under loaderMu; java-design-1123)\n"} classes
          ^{:tag (map string (* Package)) :doc "the packages its definePackage defined, by name (under packagesMu; definedPackages before java-design-1123)\n"} packages))

(go/var ClassLoader_class
  (Define (addr (lit ClassInfo :Name "java.lang.ClassLoader" :Kind KindClass
                     :Modifiers (bit-or AccPublic AccAbstract) :Super Object_class
                     :Go "arbace/jrt.ClassLoader"))))

(go/method Ctor "Ctor is ClassLoader(): the system class loader as parent.\n"
  [^{:tag (* ClassLoader)} t ^ClassLoader_I this]
  (set! (.-self t) this)
  (set! (.-parent t) appLoader)
  (set! (.-parallel t) (parallelRegistered (.GetClass__Class this))))
(go/method Ctor_ClassLoader "Ctor_ClassLoader is ClassLoader(ClassLoader parent).\n"
  [^{:tag (* ClassLoader)} t ^ClassLoader_I this ^ClassLoader_I parent]
  (set! (.-self t) this)
  (set! (.-parent t) parent)
  (set! (.-parallel t) (parallelRegistered (.GetClass__Class this))))

;; parallel capable loaders (jdk26u's ClassLoader.ParallelLoaders, registerAsParallelCapable,
;; isRegisteredAsParallelCapable; java-design-1122): the registered loader classes, ClassLoader itself and the built-in
;; loaders' from the start; a class is registered when its superclass is

(go/var
  [^{:tag sync/Mutex} parallelMu]
  [^{:tag (map (* Class) bool) :doc "parallelLoaders: the loader classes registered as parallel capable.\n"}
   parallelLoaders (make (map (* Class) bool))])

(go/func parallelRegistered ^bool [^{:tag (* Class)} c]
  (.Lock parallelMu)
  (defer (.Unlock parallelMu))
  (aget parallelLoaders c))

(go/func ClassLoader_RegisterAsParallelCapable__Z
  "ClassLoader_RegisterAsParallelCapable__Z is ClassLoader.registerAsParallelCapable (protected static, caller
sensitive): the caller's class (callerOutside: the nearest frame below ClassLoader's, not a reflection or hidden one)
registered when its superclass is (ParallelLoaders.register); whether it is registered; IllegalStateException for a
caller that is not a ClassLoader subclass (jdk26u's IllegalCallerException, a class of the world jrt cannot name, is a
subclass of it; java-bytecode-1122's check, the two copies made one in train-1).\n"
  ^bool []
  (let [caller (callerOutside "java.lang.ClassLoader")]
    (when (or (== caller nil) (not (.IsAssignableFrom_Class__Z ClassLoader_class caller)))
      (panic (IllegalStateException_New_String (Str (+ (classDisplay caller) " not a subclass of ClassLoader")))))
    (.Lock parallelMu)
    (defer (.Unlock parallelMu))
    (when (aget parallelLoaders caller)
      (return true))
    (let [sup (.GetSuperclass__Class caller)]
      (when (and (!= sup nil) (aget parallelLoaders sup))
        (aset parallelLoaders caller true)
        (return true)))
    false))

(go/method IsRegisteredAsParallelCapable__Z
  "IsRegisteredAsParallelCapable__Z is ClassLoader.isRegisteredAsParallelCapable: whether its class was registered
when the loader was made.\n"
  ^bool [^{:tag (* ClassLoader)} t]
  (.-parallel t))

(go/method Self_ClassLoader ^{:tag (* ClassLoader)} [^{:tag (* ClassLoader)} t] t)
(go/method GetParent__ClassLoader ^ClassLoader_I [^{:tag (* ClassLoader)} t] (.-parent t))
(go/method GetName__String ^{:tag (* String)} [^{:tag (* ClassLoader)} t] (.-name t))

(go/method LoadClass_String__Class
  "LoadClass_String__Class is ClassLoader.loadClass(name): loadClass(name, false) on the loader object (a subclass's
override; java-bytecode-1122).\n"
  ^{:tag (* Class)} [^{:tag (* ClassLoader)} t ^{:tag (* String)} name]
  (.LoadClass_String_Z__Class (.loader t) name false))

(go/method LoadClass_String_Z__Class
  "LoadClass_String_Z__Class is ClassLoader.loadClass(name, resolve) (protected): the built-in loaders' the registry's
class, not initialized, ClassNotFoundException otherwise; another loader's by jdk26u's delegation (defineclass.ae's
loadClassDelegating: its loaded classes, its parent's, its findClass).\n"
  ^{:tag (* Class)} [^{:tag (* ClassLoader)} t ^{:tag (* String)} name ^bool resolve]
  (when (or (== t (addr (.-ClassLoader appLoader))) (== t (addr (.-ClassLoader platformLoader))))
    (when (== name nil) (panic (NPE)))
    (let [c (registryClass (.String name))]
      (when (or (== c nil) (.IsPrimitive__Z c))
        (panic (ClassNotFoundException_New_String name)))
      (return c)))
  (.loadClassDelegating t name))

(go/method FindSystemClass_String__Class
  "FindSystemClass_String__Class is ClassLoader.findSystemClass (protected final): the system class
loader's class of that name, the registry's; ClassNotFoundException otherwise (CDR11: gen-class's
:exposes-methods of it, doc/CLOJURE-DESIGN-REVIEW.md).\n"
  ^{:tag (* Class)} [^{:tag (* ClassLoader)} t ^{:tag (* String)} name]
  (.LoadClass_String_Z__Class (addr (.-ClassLoader appLoader)) name false))

(go/func ClassLoader_InstanceOf ^bool [^any x] (let [(values _ ok) (assert ClassLoader_I x)] ok))
(go/func ClassLoader_Cast ^ClassLoader_I [^any x]
  (when (== x nil) (return nil))
  (let [(values v ok) (assert ClassLoader_I x)]
    (when (not ok) (panic (ClassCast x ClassLoader_class)))
    v))

;; the two built-in loaders (jdk.internal.loader.ClassLoaders' classes)

(go/type builtinLoader (struct ClassLoader ^{:tag (* Class)} cls))
(go/method Ref ^any [^{:tag (* builtinLoader)} t] (when (== t nil) (return nil)) t)
(go/method GetClass__Class ^{:tag (* Class)} [^{:tag (* builtinLoader)} t] (.-cls t))
(go/method ToString__String ^{:tag (* String)} [^{:tag (* builtinLoader)} t] (Object_toString t))
(go/method Clone__O ^any [^{:tag (* builtinLoader)} t] (panic (CloneNotSupported t)))

(go/var
  [builtinLoader_class
   (Define (addr (lit ClassInfo :Name "jdk.internal.loader.BuiltinClassLoader" :Kind KindClass
                      :Modifiers AccPublic :Super ClassLoader_class :Go "arbace/jrt.builtinLoader")))]
  [platformLoader_class
   (Define (addr (lit ClassInfo :Name "jdk.internal.loader.ClassLoaders$PlatformClassLoader" :Kind KindClass
                      :Modifiers (bit-or AccPrivate AccStatic) :Super builtinLoader_class)))]
  [appLoader_class
   (Define (addr (lit ClassInfo :Name "jdk.internal.loader.ClassLoaders$AppClassLoader" :Kind KindClass
                      :Modifiers (bit-or AccPrivate AccStatic) :Super builtinLoader_class)))])

(go/var
  [^{:tag (* builtinLoader)} platformLoader
   (addr (lit builtinLoader :ClassLoader (lit ClassLoader :name (Intern "platform") :parallel true) :cls platformLoader_class))]
  [^{:tag (* builtinLoader)} appLoader
   (addr (lit builtinLoader :ClassLoader (lit ClassLoader :parent platformLoader :name (Intern "app") :parallel true)
              :cls appLoader_class))])

(go/func ClassLoader_GetSystemClassLoader__ClassLoader
  "ClassLoader_GetSystemClassLoader__ClassLoader is ClassLoader.getSystemClassLoader: the
application loader.\n"
  ^ClassLoader_I []
  appLoader)

(go/func ClassLoader_GetPlatformClassLoader__ClassLoader ^ClassLoader_I []
  platformLoader)

;; ---------------------------------------------------------------------------------------
;; java.lang.Package (round 54; jdk26u's java/lang/Package.java and ClassLoader's definePackage,
;; getDefinedPackage, getDefinedPackages and getPackage): a name, the specification's and the
;; implementation's title, version and vendor, the seal base. The closed world has no class loading,
;; so a class's package is made on demand (Class.getPackage, Package.getPackage, of the loader the
;; class reports: bootstrap or the application's) and a loader's own definePackage calls are kept
;; by loader; its annotations are its package-info class's (queue 563). Its superclass NamedPackage
;; (package-private) is not here: Package's is Object.

(go/type Package
  "Package is java.lang.Package.\n"
  (struct Object
          ^{:tag (* String)} name
          ^{:tag (* String)} specTitle ^{:tag (* String)} specVersion ^{:tag (* String)} specVendor
          ^{:tag (* String)} implTitle ^{:tag (* String)} implVersion ^{:tag (* String)} implVendor
          ^any sealBase))

(go/var Package_class
  (Define (addr (lit ClassInfo :Name "java.lang.Package" :Kind KindClass
                     :Modifiers AccPublic :Super Object_class
                     :Interfaces (lit (slice (* Class)) AnnotatedElement_class)
                     :Go "arbace/jrt.Package"))))

(go/var
  [^{:tag sync/Mutex} packagesMu]
  [^{:tag (map string (* Package)) :doc "classPackages: the packages made for the registry's classes, by name.\n"}
   classPackages (make (map string (* Package)))])

(go/func loaderKey ^{:tag (* ClassLoader)} [^ClassLoader_I l]
  (when (== l nil) (return nil))
  (.Self_ClassLoader l))

(go/func registeredPackage
  "registeredPackage is whether a class of package pkg (\"\" the unnamed package) is in the registry.\n"
  ^bool [^string pkg]
  (.RLock registryMu)
  (defer (.RUnlock registryMu))
  (range [n _ registry]
    (let [i (strings/LastIndexByte n \.)]
      (cond
        (and (< i 0) (== pkg "")) (return true)
        (and (>= i 0) (== (subslice n _ i) pkg) (not (strings/HasPrefix n "["))) (return true))))
  false)

(go/func classPackage
  "classPackage is the package of the registry's classes named pkg: a loader's own when it defined one, else
one made once.\n"
  ^{:tag (* Package)} [^ClassLoader_I l ^string pkg]
  (.Lock packagesMu)
  (defer (.Unlock packagesMu))
  (let [k (loaderKey l)]
    (when (!= k nil)
      (let [p (aget (.-packages k) pkg)]
        (when (!= p nil) (return p)))))
  (let [p (aget classPackages pkg)]
    (when (== p nil)
      (set! p (addr (lit Package :name (Intern pkg))))
      (aset classPackages pkg p))
    p))

(go/method GetPackage__Package
  "GetPackage__Package is Class.getPackage: null for an array or a primitive type, else the package of the
class's package name.\n"
  ^{:tag (* Package)} [^{:tag (* Class)} c]
  (when (or (.IsArray__Z c) (.IsPrimitive__Z c))
    (return nil))
  (classPackage (.GetClassLoader__ClassLoader c) (.String (.GetPackageName__String c))))

(go/func Package_GetPackage_String__Package
  "Package_GetPackage_String__Package is Package.getPackage (deprecated): the application loader's package
of that name (a definePackage's, else one of the registry's classes), else null.\n"
  ^{:tag (* Package)} [^{:tag (* String)} name]
  (let [n (.String (NN name))]
    (.Lock packagesMu)
    (let [p (aget (.-packages (loaderKey appLoader)) n)]
      (.Unlock packagesMu)
      (when (!= p nil) (return p)))
    (when (not (registeredPackage n))
      (return nil))
    (classPackage appLoader n)))

(go/func Package_GetPackages__Package1
  "Package_GetPackages__Package1 is Package.getPackages: the packages of the registry's classes and those the
application loader defined, by name.\n"
  ^{:tag (* RefArray)} []
  (let [names (make (map string bool))]
    (.RLock registryMu)
    (range [n _ registry]
      (when (not (strings/HasPrefix n "["))
        (let [i (strings/LastIndexByte n \.)]
          (if (< i 0) (aset names "" true) (aset names (subslice n _ i) true)))))
    (.RUnlock registryMu)
    (.Lock packagesMu)
    (range [n _ (.-packages (loaderKey appLoader))]
      (aset names n true))
    (.Unlock packagesMu)
    (let [ks (make (slice string) 0 (len names))]
      (range [n _ names] (set! ks (append ks n)))
      (sort/Strings ks)
      (let [a (NewRefArray Package_class (conv int32 (len ks)))]
        (range [i n ks] (aset (.-A a) i (classPackage appLoader n)))
        a))))

(go/method DefinePackage_String_String_String_String_String_String_String_URL__Package
  "DefinePackage_String_String_String_String_String_String_String_URL__Package is ClassLoader.definePackage
(protected): a new package of this loader; IllegalArgumentException when it defined one of that name already.
The seal base, a java.net.URL (translated), is held as a value.\n"
  ^{:tag (* Package)} [^{:tag (* ClassLoader)} t ^{:tag (* String)} name
                       ^{:tag (* String)} specTitle ^{:tag (* String)} specVersion ^{:tag (* String)} specVendor
                       ^{:tag (* String)} implTitle ^{:tag (* String)} implVersion ^{:tag (* String)} implVendor
                       ^any sealBase]
  (let [n (.String (NN name))
        p (addr (lit Package :name name :specTitle specTitle :specVersion specVersion :specVendor specVendor
                     :implTitle implTitle :implVersion implVersion :implVendor implVendor :sealBase sealBase))]
    (.Lock packagesMu)
    (defer (.Unlock packagesMu))
    (let [m (.-packages t)]
      (when (== m nil)
        (set! m (make (map string (* Package))))
        (set! (.-packages t) m))
      (when (!= (aget m n) nil)
        (panic (IllegalArgumentException_New_String name)))
      (aset m n p))
    p))

(go/method GetDefinedPackage_String__Package
  "GetDefinedPackage_String__Package is ClassLoader.getDefinedPackage: the package this loader defined by
that name, else null; NullPointerException(\"name cannot be null\").\n"
  ^{:tag (* Package)} [^{:tag (* ClassLoader)} t ^{:tag (* String)} name]
  (when (== name nil)
    (panic (NullPointerException_New_String (Str "name cannot be null"))))
  (.Lock packagesMu)
  (defer (.Unlock packagesMu))
  (aget (.-packages t) (.String name)))

(go/method GetDefinedPackages__Package1
  "GetDefinedPackages__Package1 is ClassLoader.getDefinedPackages: the packages this loader defined, by name.\n"
  ^{:tag (* RefArray)} [^{:tag (* ClassLoader)} t]
  (.Lock packagesMu)
  (defer (.Unlock packagesMu))
  (let [m (.-packages t)
        ks (make (slice string) 0 (len m))]
    (range [n _ m] (set! ks (append ks n)))
    (sort/Strings ks)
    (let [a (NewRefArray Package_class (conv int32 (len ks)))]
      (range [i n ks] (aset (.-A a) i (aget m n)))
      a)))

(go/method GetPackage_String__Package
  "GetPackage_String__Package is ClassLoader.getPackage (protected, deprecated; jdk26u's, java-design-1122): the
package this loader defined by that name, else its parent's getPackage, else (no parent) the boot loader's: one of
the registry's classes'; null when none.\n"
  ^{:tag (* Package)} [^{:tag (* ClassLoader)} t ^{:tag (* String)} name]
  (let [p (.GetDefinedPackage_String__Package t name)]
    (when (!= p nil) (return p))
    (when (!= (.-parent t) nil)
      (return (.GetPackage_String__Package (.Self_ClassLoader (.-parent t)) name)))
    (when (registeredPackage (.String name))
      (return (classPackage nil (.String name))))
    nil))

;; the assertion status a loader gives its classes (jdk26u's ClassLoader: setDefaultAssertionStatus,
;; setPackageAssertionStatus, setClassAssertionStatus, clearAssertionStatus and desiredAssertionStatus(String);
;; java-design-1122): kept by loader, read by Class.desiredAssertionStatus (class.ae)

(go/type assertionStatus
  "assertionStatus is a loader's assertion settings: the default, by package (\"\" the unnamed one) and by class.\n"
  (struct ^bool dflt ^{:tag (map string bool)} packages ^{:tag (map string bool)} classes))

(go/var
  [^{:tag sync/Mutex} assertionMu]
  [^{:tag (map (* ClassLoader) (* assertionStatus)) :doc "assertions: the loaders' settings, made by their first set call.\n"}
   assertions (make (map (* ClassLoader) (* assertionStatus)))])

(go/func loaderAssertions
  "loaderAssertions is loader t's settings, made when absent (jdk26u's initializeJavaAssertionMaps: no -ea, empty).\n"
  ^{:tag (* assertionStatus)} [^{:tag (* ClassLoader)} t]
  (let [a (aget assertions t)]
    (when (== a nil)
      (set! a (addr (lit assertionStatus :packages (make (map string bool)) :classes (make (map string bool)))))
      (aset assertions t a))
    a))

(go/method SetDefaultAssertionStatus_Z__V
  "SetDefaultAssertionStatus_Z__V is ClassLoader.setDefaultAssertionStatus.\n"
  [^{:tag (* ClassLoader)} t ^bool enabled]
  (.Lock assertionMu)
  (defer (.Unlock assertionMu))
  (set! (.-dflt (loaderAssertions t)) enabled))

(go/method SetPackageAssertionStatus_String_Z__V
  "SetPackageAssertionStatus_String_Z__V is ClassLoader.setPackageAssertionStatus: a null name the unnamed package.\n"
  [^{:tag (* ClassLoader)} t ^{:tag (* String)} name ^bool enabled]
  (.Lock assertionMu)
  (defer (.Unlock assertionMu))
  (let [k ""]
    (when (!= name nil)
      (set! k (.String name)))
    (aset (.-packages (loaderAssertions t)) k enabled)))

(go/method SetClassAssertionStatus_String_Z__V
  "SetClassAssertionStatus_String_Z__V is ClassLoader.setClassAssertionStatus (a top-level class's binary name).\n"
  [^{:tag (* ClassLoader)} t ^{:tag (* String)} name ^bool enabled]
  (.Lock assertionMu)
  (defer (.Unlock assertionMu))
  (aset (.-classes (loaderAssertions t)) (.String (NN name)) enabled))

(go/method ClearAssertionStatus__V
  "ClearAssertionStatus__V is ClassLoader.clearAssertionStatus: the default false, no package or class settings.\n"
  [^{:tag (* ClassLoader)} t]
  (.Lock assertionMu)
  (defer (.Unlock assertionMu))
  (aset assertions t (addr (lit assertionStatus :packages (make (map string bool)) :classes (make (map string bool))))))

(go/func loaderDesiredAssertionStatus
  "loaderDesiredAssertionStatus is jdk26u's ClassLoader.desiredAssertionStatus(className) for loader l: the class's
setting (a nested class's that of its top-level class), else the innermost package's, else the default; ok false when
the loader has no settings (the VM's answer then: false, no -ea).\n"
  [^{:tag (* ClassLoader)} l ^string name] :results [^bool st ^bool ok]
  (.Lock assertionMu)
  (defer (.Unlock assertionMu))
  (let [a (aget assertions l)]
    (when (== a nil)
      (return false false))
    (let [n name]
      (let [i (strings/IndexByte n \$)]
        (when (>= i 0) (set! n (subslice n _ i))))
      (let [(values v found) (aget (.-classes a) n)]
        (when found (return v true)))
      (let [i (strings/LastIndexByte n \.)]
        (when (< i 0)
          (let [(values v found) (aget (.-packages a) "")]
            (when found (return v true))))
        (while (> i 0)
          (set! n (subslice n _ i))
          (let [(values v found) (aget (.-packages a) n)]
            (when found (return v true)))
          (set! i (strings/LastIndexByte n \.))))
      (return (.-dflt a) true))))

(go/method GetName__String ^{:tag (* String)} [^{:tag (* Package)} p] (.-name p))
(go/method GetSpecificationTitle__String ^{:tag (* String)} [^{:tag (* Package)} p] (.-specTitle p))
(go/method GetSpecificationVersion__String ^{:tag (* String)} [^{:tag (* Package)} p] (.-specVersion p))
(go/method GetSpecificationVendor__String ^{:tag (* String)} [^{:tag (* Package)} p] (.-specVendor p))
(go/method GetImplementationTitle__String ^{:tag (* String)} [^{:tag (* Package)} p] (.-implTitle p))
(go/method GetImplementationVersion__String ^{:tag (* String)} [^{:tag (* Package)} p] (.-implVersion p))
(go/method GetImplementationVendor__String ^{:tag (* String)} [^{:tag (* Package)} p] (.-implVendor p))
(go/method IsSealed__Z "IsSealed__Z is isSealed: whether a seal base was given.\n"
  ^bool [^{:tag (* Package)} p] (!= (.-sealBase p) nil))
(go/method HashCode__I "HashCode__I is Package.hashCode: the name's.\n"
  ^int32 [^{:tag (* Package)} p] (.HashCode__I (.-name p)))
(go/method ToString__String
  "ToString__String is Package.toString: \"package NAME\", then \", TITLE\" and \", version V\" of the
specification when not empty.\n"
  ^{:tag (* String)} [^{:tag (* Package)} p]
  (let [s (+ "package " (.String (.-name p)))]
    (when (and (!= (.-specTitle p) nil) (!= (.String (.-specTitle p)) ""))
      (set! s (+ s ", " (.String (.-specTitle p)))))
    (when (and (!= (.-specVersion p) nil) (!= (.String (.-specVersion p)) ""))
      (set! s (+ s ", version " (.String (.-specVersion p)))))
    (Str s)))

;; AnnotatedElement (queue 563): jdk26u's Package.getPackageInfo, the package's package-info class (an interface the
;; interpreter defines from a package-info.java's defpackage, its annotations the package's), else none: each method
;; that class's (jdk26u's PackageInfoProxy, a class without annotations, when there is none)
(go/method packageInfo
  "packageInfo is Package.getPackageInfo: the class NAME.package-info of the registry, else nil.\n"
  ^{:tag (* Class)} [^{:tag (* Package)} p]
  (let [n (.String (.-name p))]
    (when (== n "") (return (ForName "package-info")))
    (ForName (+ n ".package-info"))))
(go/method Is_AnnotatedElement [^{:tag (* Package)} p])
(go/method GetAnnotation_Class__Annotation ^Annotation [^{:tag (* Package)} p ^{:tag (* Class)} a]
  (NN a)
  (let [c (.packageInfo p)]
    (when (== c nil) (return nil))
    (.GetAnnotation_Class__Annotation c a)))
(go/method IsAnnotationPresent_Class__Z ^bool [^{:tag (* Package)} p ^{:tag (* Class)} a]
  (AnnotatedElement_IsAnnotationPresent_Class__Z p a))
(go/method GetAnnotations__Annotation1 ^{:tag (* RefArray)} [^{:tag (* Package)} p]
  (let [c (.packageInfo p)]
    (when (== c nil) (return (annotationArray Annotation_class nil)))
    (.GetAnnotations__Annotation1 c)))
(go/method GetDeclaredAnnotations__Annotation1 ^{:tag (* RefArray)} [^{:tag (* Package)} p]
  (let [c (.packageInfo p)]
    (when (== c nil) (return (annotationArray Annotation_class nil)))
    (.GetDeclaredAnnotations__Annotation1 c)))
(go/method GetAnnotationsByType_Class__Annotation1 ^{:tag (* RefArray)} [^{:tag (* Package)} p ^{:tag (* Class)} a]
  (let [c (.packageInfo p)]
    (when (== c nil) (return (AnnotatedElement_GetAnnotationsByType_Class__Annotation1 p a)))
    (.GetAnnotationsByType_Class__Annotation1 c a)))
(go/method GetDeclaredAnnotation_Class__Annotation ^Annotation [^{:tag (* Package)} p ^{:tag (* Class)} a]
  (let [c (.packageInfo p)]
    (when (== c nil) (return (AnnotatedElement_GetDeclaredAnnotation_Class__Annotation p a)))
    (.GetDeclaredAnnotation_Class__Annotation c a)))
(go/method GetDeclaredAnnotationsByType_Class__Annotation1 ^{:tag (* RefArray)} [^{:tag (* Package)} p ^{:tag (* Class)} a]
  (let [c (.packageInfo p)]
    (when (== c nil) (return (AnnotatedElement_GetDeclaredAnnotationsByType_Class__Annotation1 p a)))
    (.GetDeclaredAnnotationsByType_Class__Annotation1 c a)))

(go/method Ref ^any [^{:tag (* Package)} t] (when (== t nil) (return nil)) t)
(go/method GetClass__Class ^{:tag (* Class)} [^{:tag (* Package)} t] Package_class)
(go/method Clone__O ^any [^{:tag (* Package)} t] (panic (CloneNotSupported t)))

(go/func Package_InstanceOf ^bool [^any x] (let [(values _ ok) (assert (* Package) x)] ok))
(go/func Package_Cast ^{:tag (* Package)} [^any x]
  (when (== x nil) (return nil))
  (let [(values v ok) (assert (* Package) x)]
    (when (not ok) (panic (ClassCast x Package_class)))
    v))

(go/func init []
  (set! (.-IsInstance (.Info Package_class)) Package_InstanceOf)
  (aset parallelLoaders ClassLoader_class true)
  (aset parallelLoaders builtinLoader_class true)

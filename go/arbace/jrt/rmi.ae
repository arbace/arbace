;; jrt: the one native of java.rmi (F27, doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: F27 (write-ahead)"):
;; sun.rmi.transport.GC.maxObjectInspectionAge, jdk26u's librmi GC.c, which answers JVM_MaxObjectInspectionAge,
;; HotSpot's milliseconds since the last full collection (Universe::heap()->millis_since_last_whole_heap_examined).
;; Go's collector is concurrent and whole-heap: the milliseconds since its last cycle ended (runtime/debug's
;; LastGC), or since the runtime's start when none has run. sun.rmi.transport.GC's daemon (the distributed
;; garbage collector's latency guarantee) collects when the age passes the latency it was asked for.
;; Copyright (c) the Arbace authors; Eclipse Public License 1.0.
(in-ns 'go.arbace.jrt)

(go/file "rmi.go"
  :imports [[debug "runtime/debug"] [time "time"]])

(go/func GC_MaxObjectInspectionAge__J_native
  "GC_MaxObjectInspectionAge__J_native is sun.rmi.transport.GC.maxObjectInspectionAge: the milliseconds since
the collector's last cycle (since the runtime's start before the first).\n"
  ^int64 []
  (let [^debug/GCStats s (lit debug/GCStats)]
    (debug/ReadGCStats (addr s))
    (when (.IsZero (.-LastGC s))
      (return (.Milliseconds (time/Since vmStart))))
    (.Milliseconds (time/Since (.-LastGC s)))))

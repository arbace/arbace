;; ci: functions of machine code (queue 522c; the user's decision of 2026-11-22, journal ead97197e): a file-scope asm's label,
;; assembled by arbace.c.build with repr/asm's reader and arbace.asm's amd64 object assembler, is an (mcode ID NAME HEX OFF RET
;; PARAMS) command: the text's bytes, the label's offset in them, the result's type (ci's: i8 ... u64, p, f32, f64, v) and the
;; parameters' kinds (i an integer or pointer, d a double, f a float). A call runs it on x86-64's machine through MachineCall,
;; which go/arbace/cix86 sets (x86i over ci's own memory: tools/cirun and the compiled programs import it, the embedded ci does
;; not link x86i); without it the call is a fault naming the runner.
(in-ns 'go.arbace.ci) (go/file "mcode.go" :doc "ci: functions of machine code (queue 522c): a file-scope asm's label assembled by arbace.c.build, run on x86-64's\nmachine through MachineCall (go/arbace/cix86).\n" :imports [
    [hex "encoding/hex"]

    [crt "arbace/crt"]])

(go/type MCode "MCode is a function whose body is x86-64 machine code: its name, its text's bytes, the label's offset in them, its\nresult's type (ci's type names, f32, f64, v) and its parameters' kinds (i, d, f).\n" (struct
    ^{:tag string} Name
    ^{:tag (slice byte)} Text
    ^{:tag uint64} Off
    ^{:tag string} Ret
    ^{:tag string} Params))

(go/var ^{:tag (func [(* Thread) (* MCode) (slice Arg)] [Arg]) :doc "MachineCall runs a function of machine code on x86-64's machine (go/arbace/cix86 sets it); nil: this runner has none.\n"} MachineCall)

(go/method mcode "mcode makes an (mcode ID NAME HEX OFF RET PARAMS) command's function.\n" [^{:tag (* Loader)} l ^{:tag (slice any)} c]
  (let [f (.Fn (.-P l) (conv int (toI (aget c 1))) (toS (aget c 2)))
        (values b err) (hex/DecodeString (toS (aget c 3)))]
    (when (!= err nil)
      (panic err))
    (let [mc (addr (lit MCode :Name (toS (aget c 2)) :Text b :Off (conv uint64 (toI (aget c 4))) :Ret (toS (aget c 5)) :Params (toS (aget c 6))))]
      (set! (.-Code f) nil)
      (set! (.-Native f) (fn ^Arg [^{:tag (* Thread)} t ^{:tag (slice Arg)} args]
                           (when (== MachineCall nil)
                             (panic (addr (lit crt/Fault :Sig crt/SIGILL :Msg (+ "machine code of " (.-Name mc) ": this runner has no x86-64 machine (x86i: tools/cirun and the compiled programs link it)")))))
                           (return (MachineCall t mc args))))
      (aset (.-Defined l) (.-ID f) true))))

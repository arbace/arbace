      (aset n "__builtin_stdc_leading_ones" (stdc (fn ^Arg [^int nb ^crt/WType ty ^crt/Wide x ^crt/Wide nx ^{:tag (slice Arg)} a] (cnt (- nb (blen nx))))))
      (aset n "__builtin_stdc_trailing_zeros" (stdc (fn ^Arg [^int nb ^crt/WType ty ^crt/Wide x ^crt/Wide nx ^{:tag (slice Arg)} a] (cnt (tzn nb x)))))
      (aset n "__builtin_stdc_trailing_ones" (stdc (fn ^Arg [^int nb ^crt/WType ty ^crt/Wide x ^crt/Wide nx ^{:tag (slice Arg)} a] (cnt (tzn nb nx)))))
      (aset n "__builtin_stdc_first_leading_zero" (stdc (fn ^Arg [^int nb ^crt/WType ty ^crt/Wide x ^crt/Wide nx ^{:tag (slice Arg)} a]

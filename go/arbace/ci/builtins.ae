      (aset n "__builtin_stdc_first_trailing_zero" (stdc (fn ^Arg [^int nb ^crt/WType ty ^crt/Wide x ^crt/Wide nx ^{:tag (slice Arg)} a] (cnt (+ (tz nx) 1)))))
      (aset n "__builtin_stdc_first_trailing_one" (stdc (fn ^Arg [^int nb ^crt/WType ty ^crt/Wide x ^crt/Wide nx ^{:tag (slice Arg)} a] (cnt (+ (tz x) 1)))))
      (aset n "__builtin_stdc_count_zeros" (stdc (fn ^Arg [^int nb ^crt/WType ty ^crt/Wide x ^crt/Wide nx ^{:tag (slice Arg)} a] (cnt (- nb (ones x))))))
      (aset n "__builtin_stdc_count_ones" (stdc (fn ^Arg [^int nb ^crt/WType ty ^crt/Wide x ^crt/Wide nx ^{:tag (slice Arg)} a] (cnt (ones x)))))

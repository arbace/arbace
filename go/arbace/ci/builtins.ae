;; gcc's type-generic bit builtins (__builtin_popcountg, parityg, clzg, ctzg, ffsg, clrsbg; gcc 14) and C23's
;; <stdbit.h> builtins (__builtin_stdc_*, gcc 14; the rotates gcc 15), queue 126: the builder (arbace.c.build's
;; bitg-call) passes the operand (an integer, or a wide value) and its width N; clzg and ctzg also the value for 0
;; and whether one was given, the rotates their count. The operand is taken as its N bits, unsigned (a signed
;; operand's two's complement bits); a result of the operand's type is wide when N > 64, as the builder's kinds are.
(go/func init []
  (let [n Natives
      wt (fn ^crt/WType [^{:tag (slice Arg)} a] (lit crt/WType :N (conv int (.-I (aget a 1))) :Signed false))
      opnd (fn ^crt/Wide [^{:tag (slice Arg)} a]
        (when (== (.-K (aget a 0)) \w)
          (return (.Norm (wt a) (.-W (aget a 0)))))

        (crt/WFromInt64 (wt a) (.-I (aget a 0))))

      ones (fn ^int [^crt/Wide w]
        (let [c 0]
          (range [_ l w]
            (set! c (+ c (bits/OnesCount64 l))))

          c))

      blen (fn ^int [^crt/Wide w]
        (for [i (- (len w) 1)] (>= i 0) (dec! i)
          (when (!= (aget w i) 0)
            (return (+ (* 64 i) (bits/Len64 (aget w i))))))

        0)

      tz (fn ^int [^crt/Wide w]
        (range [i l w]
          (when (!= l 0)
            (return (+ (* 64 i) (bits/TrailingZeros64 l)))))

        -1)

      res (fn ^Arg [^crt/WType t ^crt/Wide w]
        (when (> (.-N t) 64)
          (return (lit Arg :K \w :W w)))

        (ai (conv int64 (aget w 0))))

      cnt (fn ^Arg [^int v] (ai (conv int64 v)))
      nbits (fn ^int [^{:tag (slice Arg)} a] (conv int (.-I (aget a 1))))]

    (aset n "__builtin_popcountg" (fn ^Arg [^{:tag (* Thread)} t ^{:tag (slice Arg)} a] (cnt (ones (opnd a)))))
    (aset n "__builtin_parityg" (fn ^Arg [^{:tag (* Thread)} t ^{:tag (slice Arg)} a] (cnt (bit-and (ones (opnd a)) 1))))
    (aset n "__builtin_clzg" (fn ^Arg [^{:tag (* Thread)} t ^{:tag (slice Arg)} a]
        (let [k (blen (opnd a))]
          (when (and (== k 0) (!= (.-I (aget a 3)) 0))
            (return (aget a 2)))

          (cnt (- (nbits a) k)))))

    (aset n "__builtin_ctzg" (fn ^Arg [^{:tag (* Thread)} t ^{:tag (slice Arg)} a]
        (let [k (tz (opnd a))]
          (when (>= k 0)
            (return (cnt k)))

          (when (!= (.-I (aget a 3)) 0)
            (return (aget a 2)))

          (cnt (nbits a)))))

    (aset n "__builtin_ffsg" (fn ^Arg [^{:tag (* Thread)} t ^{:tag (slice Arg)} a] (cnt (+ (tz (opnd a)) 1))))
    (aset n "__builtin_clrsbg" (fn ^Arg [^{:tag (* Thread)} t ^{:tag (slice Arg)} a]
        (let [w (opnd a)
            nb (nbits a)
            top (- nb 1)]
          (when (!= (bit-and (>> (aget w (/ top 64)) (conv uint (% top 64))) 1) 0)
            (set! w (.Not (wt a) w)))

          (cnt (- nb (blen w) 1)))))

    ;; C23 7.18 (N3220): each as gcc's c-parser expands it (clzg, ctzg, popcountg of x or ~x, shifts)
    (let [stdc (fn ^{:tag (func [(* Thread) (slice Arg)] [Arg])} [^{:tag (func [^int nb ^crt/WType t ^crt/Wide x ^crt/Wide nx ^{:tag (slice Arg)} a] [Arg])} f]
          (fn ^Arg [^{:tag (* Thread)} t ^{:tag (slice Arg)} a]
            (let [x (opnd a)]

          (cnt 0))))

      (aset n "__builtin_stdc_bit_width" (stdc (fn ^Arg [^int nb ^crt/WType ty ^crt/Wide x ^crt/Wide nx ^{:tag (slice Arg)} a] (cnt (blen x)))))
      (aset n "__builtin_stdc_bit_floor" (stdc (fn ^Arg [^int nb ^crt/WType ty ^crt/Wide x ^crt/Wide nx ^{:tag (slice Arg)} a]
          (let [k (blen x)]
            (when (== k 0)
              (return (res ty x)))

            (res ty (.Shl ty (crt/WFromUint64 ty 1) (conv uint64 (- k 1))))))))

      ;; 0 and 1 give 1; a value above 2^(N-1) gives 0 (Shl's count of N)
      (aset n "__builtin_stdc_bit_ceil" (stdc (fn ^Arg [^int nb ^crt/WType ty ^crt/Wide x ^crt/Wide nx ^{:tag (slice Arg)} a]
          (let [one (crt/WFromUint64 ty 1)]
            (when (== (blen x) 0)
              (return (res ty one)))

            (res ty (.Shl ty one (conv uint64 (blen (.Sub ty x one)))))))))

      ;; the count modulo N; a count of 0 gives x (Shr's count of N gives 0)
      (let [rot (fn ^{:tag (func [(* Thread) (slice Arg)] [Arg])} [^bool left]
          (stdc (fn ^Arg [^int nb ^crt/WType ty ^crt/Wide x ^crt/Wide nx ^{:tag (slice Arg)} a]
              (let [c (% (conv uint64 (.-I (aget a 2))) (conv uint64 nb))]
                (when (not left)
                  (set! c (% (- (conv uint64 nb) c) (conv uint64 nb))))

                (res ty (.Or ty (.Shl ty x c) (.Shr ty x (- (conv uint64 nb) c))))))))]

        (aset n "__builtin_stdc_rotate_left" (rot true))
        (aset n "__builtin_stdc_rotate_right" (rot false))))))



;; queue 126: the float and long double spellings of the classification builtins (pr39228.c): their operand is
;; passed as a double (default promotion; long double is double, CS35), so they are their generic forms'
(go/func init []
  (let [n Natives]
    (aset n "__builtin_isinff" (aget n "__builtin_isinf"))
    (aset n "__builtin_isinfl" (aget n "__builtin_isinf"))
    (aset n "__builtin_isnanf" (aget n "__builtin_isnan"))
    (aset n "__builtin_isnanl" (aget n "__builtin_isnan"))
    (aset n "__builtin_finite" (aget n "__builtin_isfinite"))
    (aset n "__builtin_finitef" (aget n "__builtin_isfinite"))
    (aset n "__builtin_finitel" (aget n "__builtin_isfinite"))))



;; queue 126: __atomic_is_lock_free (size, p) when the checker did not fold it to 1: libatomic's answer
;; (libatomic/glfree.c) for a target whose 1-, 2-, 4- and 8-byte accesses are lock-free and 16-byte ones are not
;; (x86-64 without cmpxchg16b, aarch64 without LSE2): 0 bytes are; up to 8 are when they lie within one aligned
;; word of 1, 2, 4 or 8 bytes (a null p is aligned); more are not.
(go/func init []
  (aset Natives "__atomic_is_lock_free" (fn ^Arg [^{:tag (* Thread)} t ^{:tag (slice Arg)} a]
      (let [sz (conv uint64 (.-I (aget a 0)))
          p (conv uint64 (.-I (aget a 1)))]
        (when (== sz 0)
          (return (ai 1)))

        (range [_ w (lit (slice uint64) 1 2 4 8)]
          (when (and (<= sz w) (<= (+ (% p w) sz) w))
            (return (ai 1))))

        (ai 0)))))

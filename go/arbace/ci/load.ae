          (range [_ s (toL (aget c 1))]
            (set! ss (append ss (.S l s))))

          (return (NewSeq ss))))
      (case ["when"]
        (let [^Stmt b (zero Stmt)]
          (when (and (> (len c) 3) (not (isNil (aget c 3))))
            (set! b (.S l (aget c 3))))

          (return (NewIf (.I l (aget c 1)) (.S l (aget c 2)) b))))
      (case ["loop"]
        (let [^I cond (zero I)]
          (when (not (isNil (aget c 1)))
            (set! cond (.I l (aget c 1))))

          (let [^E step (zero E)]
            (when (not (isNil (aget c 2)))
              (set! step (.E l (aget c 2))))

            (return (NewLoop cond step (.S l (aget c 3)) (!= (toI (aget c 4)) 0))))))
      (case ["lab"]
        (return (addr (lit Label :Code (conv Ctl (toI (aget c 1)))))))
      (case ["jmp"]
        (return (addr (lit Jump :C (conv Ctl (toI (aget c 1)))))))
      (case ["igoto"]
        (return (addr (lit IGoto :E (.I l (aget c 1))))))
      (case ["ret"]
        (when (== (len c) 1)
          (return (addr (lit Return))))

        (return (addr (lit Return :Set (.retE l (aget c 1))))))
      (case ["sw"]
        (let [^{:tag (slice Case)} cases (zero (slice Case))]
          (range [_ k (toL (aget c 3))]
            (let [q (toL k)]
              (set! cases (append cases (lit Case :Lo (toI (aget q 0)) :Hi (toI (aget q 1)) :Code (conv Ctl (toI (aget q 2))))))))

          (return (NewSwitch (.I l (aget c 1)) (!= (toI (aget c 2)) 0) cases (conv Ctl (toI (aget c 4))) (.S l (aget c 5))))))
      (case ["sj"]
        (return (addr (lit SjStmt :Code (conv Ctl (toI (aget c 1))) :S (.S l (aget c 2))))))
      (case ["sjbody"]
        (return (addr (lit SjBody :S (.S l (aget c 1)))))))

    (panic (+ "ci: no statement " (toS (aget c 0))))))


^{:go/end 556} (go/method retE ^E [^{:tag (* Loader)} l ^any x]
  (let [c (toL x)]
    (switch (toS (aget c 0))
      (case ["reti"]
        (return (RetI (.I l (aget c 1)))))
      (case ["retf"]
        (return (RetF (.F l (aget c 1)))))
      (case ["retw"]
        (return (RetW (.W l (aget c 1)))))
      (case ["retm"]
        (return (RetM (.I l (aget c 1)) (conv int (toI (aget c 2))) (conv uint64 (toI (aget c 3)))))))

    (panic (+ "ci: no return " (toS (aget c 0))))))


(go/var iBuiltins (lit (map string (func [^{:tag (* Loader)} l ^{:tag (slice any)} c] [I]))))
(go/var fBuiltins (lit (map string (func [^{:tag (* Loader)} l ^{:tag (slice any)} c] [F]))))

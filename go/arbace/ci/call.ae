  ^{:go/end 87} (fn [^{:tag (* Frame)} fr] (.Store64 (.-M (.-T fr)) (conv uint64 (ap fr)) (.-VA fr))))



^{:go/end 102} (go/func Alloca "Alloca allocates n bytes on the C stack (16-aligned), freed when the function returns.\n" ^I [^I n]
  ^{:go/end 101} (fn ^int64 [^{:tag (* Frame)} fr]
    (let [t (.-T fr)
        ^{:line 94} sz (bit-and-not (+ (conv uint64 (n fr)) 15) 15)

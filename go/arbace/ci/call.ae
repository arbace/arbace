(go/func VlaMark "VlaMark is a block's entry when the block declares VLAs (CS106): the slot m holds the stack\npointer at the block's entry, l the end of the block's latest VLA; a block entered again while\nnothing but its VLAs was allocated since (a loop's next iteration, a goto back before the block)\nfrees them, its VLAs' lifetime over.\n" ^I [^int m ^int l]
  (fn ^int64 [^{:tag (* Frame)} fr]
    (VlaMarkAt (.-T fr) (addr (aget (.-I fr) m)) (aget (.-I fr) l))
    0))


(go/func VlaMarkAt "VlaMarkAt is VlaMark's work on the slots' places.\n" [^{:tag (* Thread)} t ^{:tag (* int64)} m ^int64 l]
  (if (and (!= @m 0) (== (conv int64 (.-SP t)) l))
    (set! (.-SP t) (conv uint64 @m))

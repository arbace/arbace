    ^{:line 13 :tag byte} K
    ^{:line 14 :tag I} I
    ^{:line 15 :tag F} F
    ^{:line 16 :tag W} W
    ^{:line 17 :tag uint64} Size))


^{:go/end 36} (go/func evalArgs ^{:tag (slice Arg)} [^{:tag (* Frame)} fr ^{:tag (slice ArgNode)} as]
  (let [out (make (slice Arg) (len as))]
    (for [i (- (len as) 1)] (>= i 0) (dec! i)
      (let [a (addr (aget as i))]
        (switch (.-K a)
          (case [\i]
            (aset out i (lit Arg :K \i :I ((.-I a) fr))))
          (case [\f]
            (aset out i (lit Arg :K \f :F ((.-F a) fr))))
          (case [\w]
            (aset out i (lit Arg :K \w :W ((.-W a) fr))))
          (case [\m]
            (aset out i (lit Arg :K \m :Addr (conv uint64 ((.-I a) fr)) :Size (.-Size a)))))))


    ^{:line 35} out))




(go/func VlaAlloc "VlaAlloc is a VLA's storage, n bytes on the C stack (CS106): md and ed hold its previous\nallocation's start and end, l the block's latest VLA's end; a declaration reached again while\nnothing was allocated since its allocation (a goto back before it in its block) frees it first.\n" ^I [^int md ^int ed ^int l ^I n]
  (fn ^int64 [^{:tag (* Frame)} fr]
    (let [v (n fr)]
      (VlaAllocAt (.-T fr) (addr (aget (.-I fr) md)) (addr (aget (.-I fr) ed)) (addr (aget (.-I fr) l)) v))))


(go/func VlaAllocAt "VlaAllocAt is VlaAlloc's work on the slots' places.\n" ^int64 [^{:tag (* Thread)} t ^{:tag (* int64)} md ^{:tag (* int64)} ed ^{:tag (* int64)} l ^int64 n]
  (when (and (!= @md 0) (== (conv int64 (.-SP t)) @ed))
    (set! (.-SP t) (conv uint64 @md)))
  (set! @md (conv int64 (.-SP t)))
  (let [sz (bit-and-not (+ (conv uint64 n) 15) 15)
        nsp (- (.-SP t) sz)]
    (when (< nsp (- crt/StackTop crt/StackSize))
      (panic (addr (lit crt/Fault :Sig crt/SIGSEGV :Msg "stack overflow (alloca)"))))
    (set! (.-SP t) nsp)
    (set! @ed (conv int64 nsp))
    (set! @l (conv int64 nsp))
    (conv int64 nsp)))


(go/func VlaRestore "VlaRestore is a VLA block's exit (its end, a break or continue leaving it): the stack pointer\nits entry recorded in the slot m back (CS106).\n" ^I [^int m]
  (fn ^int64 [^{:tag (* Frame)} fr]

^{:go/end 68} (go/func CallF ^F [^{:tag (* CallSpec)} c] ^{:go/end 68} (fn ^float64 [^{:tag (* Frame)} fr] (.-F (.call c fr))))
^{:go/end 69} (go/func CallW ^W [^{:tag (* CallSpec)} c] ^{:go/end 69} (fn ^crt/Wide [^{:tag (* Frame)} fr] (.-W (.call c fr))))
^{:go/end 70} (go/func CallE ^E [^{:tag (* CallSpec)} c] ^{:go/end 70} (fn [^{:tag (* Frame)} fr] (.call c fr)))




^{:go/end 83} (go/func VaArg "VaArg reads the next variadic argument through the va_list at the address ap (a void * holding\nthe next slot's address, SPEC §7.9's __builtin_va_list) and advances it by size rounded to 8:\nthe slot's address.\n" ^I [^I ap ^uint64 size]

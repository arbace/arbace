    ^{:line 50 :tag int64} SOff))


^{:go/end 65} (go/method call ^Arg [^{:tag (* CallSpec)} c ^{:tag (* Frame)} fr]
  (let [^{:tag (* Func)} f (zero (* Func))]
    (if (!= (.-Fn (.-Callee c)) nil)
      (set! f (.-Fn (.-Callee c)))

      (set! f (.FuncAt (.-P (.-T fr)) (conv uint64 ((.-Ptr (.-Callee c)) fr)))))

    (let [args (evalArgs fr (.-Args c))]
      (when (.-SRet c)
        (set! args (append (lit (slice Arg) (lit _ :K \i :I (conv int64 (+ (.-Base fr) (conv uint64 (.-SOff c)))))) (spread args))))

      (.Call (.-P (.-T fr)) (.-T fr) f args))))



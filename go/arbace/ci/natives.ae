                  (inc! jt)))
              (if (== (bit-or t 32) 102)
                (set! p (min p (max 0 (- (* 9 (- z r 1)) jt))))
                (set! p (min p (max 0 (- (+ (* 9 (- z r 1)) e) jt))))))))
        (let [l (+ 1 p)
              ^{:tag (slice byte)} estr (zero (slice byte))]
          (when (or (!= p 0) (!= (bit-and fl 8) 0))
            (inc! l))
          (if (== (bit-or t 32) 102)
            (when (> e 0)
              (set! l (+ l e)))
            (let [ae e
                  sign (conv byte 43)]
              (when (< e 0)
                (set! ae (- e))
                (set! sign 45))
              (let [es (fpU (conv uint64 ae))]
                (while (< (len es) 2)
                  (set! es (append (lit (slice byte) 48) (spread es))))
                (set! estr (append (lit (slice byte) (conv byte t) sign) (spread es)))
                (set! l (+ l (len estr))))))
          (set! out (fpPad out 32 w (+ pl l) fl))
          (set! out (append out (spread (subslice prefix pi (+ pi pl)))))
          (set! out (fpPad out 48 w (+ pl l) (bit-xor fl 65536)))
          (if (== (bit-or t 32) 102)
            (let [d a]
              (when (> a r)
                (set! d r))
              (let [a0 d]
                (while (<= d r)
                  (let [s (fpU (conv uint64 (aget big d)))]
                    (cond
                      (!= d a0) (set! s (fp9 (aget big d)))
                      (== (len s) 0) (set! s (lit (slice byte) 48)))
                    (set! out (append out (spread s))))
                  (inc! d)))
              (when (or (!= p 0) (!= (bit-and fl 8) 0))
                (set! out (append out 46)))
              (while (and (< d z) (> p 0))
                (set! out (append out (spread (subslice (fp9 (aget big d)) 0 (min 9 p)))))
                (inc! d)
                (set! p (- p 9)))
              (set! out (fpPad out 48 (+ p 9) 9 0)))
            (let [d a]
              (when (<= z a)
                (set! z (+ a 1)))
              (while (and (< d z) (>= p 0))
                (let [s (fpU (conv uint64 (aget big d)))]
                  (when (== (len s) 0)
                    (set! s (lit (slice byte) 48)))
                  (if (!= d a)
                    (set! s (fp9 (aget big d)))
                    (do (set! out (append out (aget s 0)))
                        (set! s (subslice s 1))
                        (when (or (> p 0) (!= (bit-and fl 8) 0))
                          (set! out (append out 46)))))
                  (set! out (append out (spread (subslice s 0 (min (len s) p)))))
                  (set! p (- p (len s))))
                (inc! d))
              (set! out (fpPad out 48 (+ p 18) 18 0))
              (set! out (append out (spread estr)))))
          (set! out (fpPad out 32 w (+ pl l) (bit-xor fl 8192)))
          (return out inexact))))))

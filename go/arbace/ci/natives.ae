    (return 0 false))
  (let [m (aget w 0)
        se (bit-and (aget w 1) 0xffff)
        ex (conv int (bit-and se 0x7fff))
        y 0.0]
    (cond
      (== ex 0x7fff) (if (== (<< m 1) 0) (set! y (math/Inf 1)) (set! y (math/NaN)))
      (== ex 0) (when (!= m 0)
                  (return 0 false))
      :else (let [e (- ex 16383)
                  drop 11]
              (when (or (== (bit-and m 0x8000000000000000) 0) (> e 1023) (< e -1074))
                (return 0 false))
              (when (< e -1022)
                (set! drop (+ 11 (- -1022 e))))
              (when (!= (bit-and m (- (<< (conv uint64 1) (conv uint drop)) 1)) 0)
                (return 0 false))
              (set! y (math/Ldexp (conv float64 (>> m 11)) (- e 52)))))
    (when (!= (bit-and se 0x8000) 0)
      (set! y (math/Copysign y -1)))
    (return y true)))

(go/func fpPad "fpPad is fmt_fp's pad: w-l bytes c appended, none when fl has LEFT_ADJ or ZERO_PAD or l >= w.\n" ^{:tag (slice byte)} [^{:tag (slice byte)} b ^byte c ^int w ^int l ^int fl]

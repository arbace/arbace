;; ci: threads (doc/c/SPEC.md §6.5; crt's sched.go): musl's __clone, the assembly that starts a thread, as a native that
;; starts a goroutine with its own Thread (its C stack the one musl mapped), and each thread's thread-local objects at addresses
;; of its own (the builder marks them, static ... 2): the main thread's at their static addresses, another thread's in a
;; block of its own made from the objects as they were after the static initializers (a (g IDX) node of one is the running
;; thread's). std's mpmc channels name a thread by a thread-local's address: one address for all would make a sender skip
;; the receiver's wake (RE6's first design swapped the bytes at one address: macros/stringify.rs's deadlock).
(in-ns 'go.arbace.ci) (go/file "thread.go" :doc "ci: threads (doc/c/SPEC.md §6.5; crt's sched.go): musl's __clone as a native starting a goroutine with its own\nThread, and each thread's thread-local objects at addresses of its own (a block made from the objects after the\nstatic initializers).\n" :imports [
    [fmt "fmt"]

    [crt "arbace/crt"]])

(go/const "PreemptCalls is the calls a thread makes before it lets the other runnable threads run (a spin loop that\nwaits for another thread without a system call still ends).\n"
  [^{:tag int :val 20000} PreemptCalls 20000])

(go/func preempt "preempt counts a call of t and lets the others run when its budget is spent.\n" [^{:tag (* Thread)} t]
  (dec! (.-budget t))
  (when (<= (.-budget t) 0)
    (set! (.-budget t) PreemptCalls)
    (.Yield (.-Sys (.-P t)))))

(go/method tlsSnapshot "tlsSnapshot records the thread-local objects' bytes after the static initializers as a thread's block
(Run): each object at its offset.\n" [^{:tag (* Prog)} p]
  (set! (.-tlsInit p) nil)
  (when (== (.-tlsSize p) 0)
    (return))
  (set! (.-tlsInit p) (make (slice byte) (.-tlsSize p)))
  (for [i 0] (< i (len (.-tls p))) (set! i + 3)
    (let [off (aget (.-tls p) (+ i 2))
          n (aget (.-tls p) (+ i 1))]
      (copy (subslice (.-tlsInit p) off (+ off n)) (.R (.-M p) (aget (.-tls p) i) n)))))

(go/method tlsBlock "tlsBlock is a new thread's block of thread-local objects, its bytes the recorded image (0: none).\n" ^uint64 [^{:tag (* Prog)} p]
  (when (== (.-tlsSize p) 0)
    (return 0))
  (let [m (.-M p)
        b (.Mmap m 0 (.-tlsSize p))]
    (copy (.W m b (.-tlsSize p)) (.-tlsInit p))
    (return b)))

(go/func clone "clone is musl's __clone(fn, stack, flags, arg, ptid, tls, ctid) for a thread (CLONE_VM | CLONE_THREAD): a new\nThread on the stack given, runnable after the running ones, fn(arg) its body; a new process (fork, posix_spawn's\nvfork) is refused, ci runs one.\n" ^Arg [^{:tag (* Thread)} t ^{:tag (slice Arg)} a]
  (let [p (.-P t)
        s (.-Sys p)
        m (.-M p)
        fnp (conv uint64 (.-I (aget a 0)))
        stack (conv uint64 (.-I (aget a 1)))
        flags (conv uint64 (.-I (aget a 2)))
        arg (.-I (aget a 3))
        ptid (conv uint64 (argI a 4))
        tls (conv uint64 (argI a 5))
        ctid (conv uint64 (argI a 6))]
    (when (and (!= (bit-and flags crt/CloneVM) 0) (!= (bit-and flags 0x4000) 0) (== (bit-and flags crt/CloneThread) 0))
      ;; CLONE_VFORK: posix_spawn's child (crt's spawn.go), run here until its exec or exit
      (return (ai (conv int64 (vforkChild t fnp stack arg)))))
    (when (or (== (bit-and flags crt/CloneVM) 0) (== (bit-and flags crt/CloneThread) 0))
      (panic (addr (lit crt/Fault :Sig crt/SIGSEGV :Msg (fmt/Sprintf "clone(%#x) of a process: ci runs one process" flags)))))
    (.Threads s)
    (let [task (.NewTask s)
          ^uint64 lo 0]
      (set! (.-FS task) (.-FS s))
      (when (!= (bit-and flags crt/CloneSettls) 0)
        (set! (.-FS task) tls))
      (when (!= (bit-and flags crt/CloneParentSettid) 0)
        (.Store32 m ptid (conv uint32 (.-Tid task))))
      (when (!= (bit-and flags crt/CloneChildSettid) 0)
        (.Store32 m ctid (conv uint32 (.-Tid task))))
      (when (!= (bit-and flags crt/CloneChildCleartid) 0)
        (set! (.-ClearTid task) ctid))
      (when [sl (.Slab m (- stack 1))] (!= sl nil)
        (set! lo (.-Base sl)))
      (let [nt (addr (lit Thread :P p :M m :SP (bit-and-not stack 15) :Lo lo :Task task :budget PreemptCalls :TLS (.tlsBlock p)))]
        (go (.runThread p nt fnp arg))
        (.Ready s task)
        (return (ai (conv int64 (.-Tid task))))))))

(go/method runThread "runThread is a thread's goroutine: its turn awaited, fn(arg) run, then the thread's exit; an exit_group or a\nfault in it ends the program (the main thread raises it).\n" [^{:tag (* Prog)} p ^{:tag (* Thread)} nt ^uint64 fnp ^int64 arg]
  (let [s (.-Sys p)]
    (defer ((fn []
          (when [r (recover)] (!= r nil)
            (type-switch [x r]
              (case [(* crt/ThreadExit)]
                (.ExitTask s 0))
              (case [(* crt/Fault)]
                (.EndProgram s (addr (lit crt/Fault :Sig (.-Sig x) :Addr (.-Addr x) :Msg (fmt/Sprintf "%s (thread %d: %s)" (.-Msg x) (.-Tid (.-Task nt)) (traceOf nt))))))
              (default
                (.EndProgram s r)))))))
    (.Start s (.-Task nt))
    (let [r (.CallAddr p nt fnp (lit (slice Arg) (lit Arg :K \i :I arg)))]
      (.ExitTask s (conv int (.-I r))))))

(go/func argI "argI is the i-th argument's integer, 0 past the arguments given.\n" ^int64 [^{:tag (slice Arg)} a ^int i]
  (when (>= i (len a))
    (return 0))
  (return (.-I (aget a i))))

(go/func traceOf "traceOf is t's interpreted frames, innermost first.\n" ^string [^{:tag (* Thread)} t]
  (let [s ""
        n 0]
    (for [fr (.-Top t)] (and (!= fr nil) (< n 12)) (set! fr (.-Caller fr))
      (when (!= s "")
        (set! s + " < "))
      (set! s + (.-Name (.-Fn fr)))
      (inc! n))
    (return s)))

(go/func vforkChild "vforkChild runs a vfork child's fn(arg) on its stack, on the calling goroutine, with the parent's state
saved (crt's ForkBegin): its execve's host process's pid, or a pid that waits as its exit's status.\n" ^int [^{:tag (* Thread)} t ^uint64 fnp ^uint64 stack ^int64 arg]
  (let [p (.-P t)
        s (.-Sys p)
        st (.ForkBegin s)
        ^{:tag (* Thread)} ct (addr (lit Thread :P p :M (.-M p) :SP (bit-and-not stack 15) :Lo 0 :Task (.-Task t) :budget PreemptCalls :TLS (.-TLS t)))
        pid 0]
    (when [sl (.Slab (.-M p) (- stack 1))] (!= sl nil)
      (set! (.-Lo ct) (.-Base sl)))
    ((fn []
       (defer ((fn []
                 (when [r (recover)] (!= r nil)
                   (type-switch [x r]
                     (case [(* crt/SpawnExec)] (set! pid (.-Pid x)))
                     (case [(* crt/SpawnExit)] (set! pid (.ChildExited s (.-Code x))))
                     (default (.ForkEnd s st) (panic r)))))))
       (let [r (.CallAddr p ct fnp (lit (slice Arg) (lit Arg :K \i :I arg)))]
         (set! pid (.ChildExited s (conv int (.-I r)))))))
    (.ForkEnd s st)
    (return pid)))

(go/func unmapself "unmapself is musl's __unmapself(base, size): a detached thread's stack unmapped, then its exit.\n" ^Arg [^{:tag (* Thread)} t ^{:tag (slice Arg)} a]
  (.Unmap (.-M (.-P t)) (conv uint64 (.-I (aget a 0))) (conv uint64 (.-I (aget a 1))))
  (panic (addr (lit crt/ThreadExit))))

(go/func init []
  (aset Natives "__clone" clone)
  (aset Natives "__unmapself" unmapself))

;; goi's list of compiled packages (doc/go/GOI-SPEC.md §6.6): what arbace.go.table (bin/goi
;; table) puts in the table arbace/gotable and its digest, for every configuration of the
;; program (linux and tamago, amd64 and arm64). Read with the Clojure reader.
;;
;; :packages   the listed packages: GR1's 41, the std packages the program imports directly
;;             less unsafe, embed, syscall, runtime/pprof, runtime/goos, iter and weak (§6.6);
;;             GR3's three the check asked for (io/ioutil, log, math/rand: GS5, the size in
;;             GOI-SPEC.md, "As built: GR3"); GR5's package arbace, Go forms' API to Arbace
;;             (§7.3: its forms are go/'s, go/arbace.ae).
;;             The list grows by a commit here with the size it costs recorded (bin/goi table
;;             --size: the executable with and without the table)
;; :resolve    packages read for the declaration layer only (their types appear in the listed
;;             packages' signatures or embeddings), not listed
;; :exclude    members left out, with the reason
;; :min-sharing the typed invokers' threshold (GS4)
;; :overrides  members whose table entry is goi's function of the same signature (§6.7)
{:packages ["arbace" "archive/tar" "bufio" "bytes" "compress/flate" "compress/gzip" "compress/zlib" "context"
            "crypto" "crypto/aes" "crypto/cipher" "crypto/des" "crypto/dsa" "crypto/ecdh" "crypto/ecdsa"
            "crypto/ed25519" "crypto/elliptic" "crypto/fips140" "crypto/hkdf" "crypto/hmac" "crypto/hpke"
            "crypto/md5" "crypto/mldsa" "crypto/mlkem" "crypto/mlkem/mlkemtest" "crypto/pbkdf2" "crypto/rand"
            "crypto/rc4" "crypto/rsa" "crypto/sha1" "crypto/sha256" "crypto/sha3" "crypto/sha512"
            "crypto/subtle" "crypto/tls" "crypto/x509" "crypto/x509/pkix" "encoding" "encoding/asn1"
            "encoding/base64" "encoding/binary" "encoding/csv" "encoding/gob" "encoding/hex" "encoding/json" "encoding/json/jsontext" "encoding/json/v2"
            "encoding/pem" "encoding/xml" "errors" "fmt" "hash" "hash/crc32" "hash/maphash" "io" "io/fs"
            "io/ioutil" "log" "math" "math/big" "math/bits" "math/rand" "math/rand/v2" "net" "net/netip"
            "net/url" "os" "os/exec" "os/signal" "path" "path/filepath" "reflect" "regexp" "runtime"
            "runtime/debug" "runtime/metrics" "runtime/pprof" "runtime/trace" "sort" "strconv" "strings"
            "sync" "sync/atomic" "syscall" "time" "time/tzdata" "unicode" "unicode/utf16" "unicode/utf8"]
 :resolve []
 ;; GR8a (doc/go/GR8-SURVEY.md, GOI-SPEC.md "As built: GR8a"): the listed set grows by the
 ;; survey's packages, each decided by the user's goal of 2026-10-19 as recommended: the 34 that
 ;; must be compiled (GC56 (a): bound to the runtime, syscall, os/signal, runtime/pprof,
 ;; runtime/trace, runtime/metrics, hash/maphash, time/tzdata; named by the table's API, hash,
 ;; math/big (GC57 (a)), net/url, compress/flate, crypto, crypto/cipher, crypto/ecdh,
 ;; crypto/ecdsa, crypto/rsa, crypto/hpke, crypto/x509/pkix, encoding/asn1, encoding/pem; the
 ;; crypto module), the reflect-driven encoders (GC62 (a): encoding/json, encoding/xml,
 ;; encoding/gob) and the speed set (GC64 (a): regexp, bufio, compress/gzip, encoding/base64,
 ;; encoding/csv); the sizes in GOI-SPEC.md. encoding/json/jsontext and encoding/json/v2 with
 ;; encoding/json (GC62): go1.27's encoding/json is built on them (GOEXPERIMENT jsonv2), its API
 ;; names their types (json.RawMessage is jsontext.Value).
 ;;
 ;; The interpretable packages (GOI-SPEC.md §9.3, GR6; GR8a, GC55 (a)): computed by the
 ;; generator per configuration (arbace.go.table/classify), every package of the
 ;; configuration's std but the listed ones, :out's and cmd's, whose body-less declarations
 ;; are :replace'd, :drop'ped or go:linkname pulls of an interpretable package's declaration
 ;; (GC59 (a)) and whose imports are listed or interpretable; the user packages among them and
 ;; what they import, their forms whole in the digest (lines kept), interpreted by goi as
 ;; packages of their std paths (S1's exception).
 ;;
 ;; :out  the user packages out of scope, refused at the import with their reason (unsafe is
 ;;       the checker's own, importable)
 :out {"embed" "go:embed is out of scope (GS14)"
       "plugin" "plugins are the runtime's dynamic loading, out of scope"
       "runtime/coverage" "coverage is the runtime's and the compiler's, out of scope"
       "runtime/goos" "TamaGo's board hooks are the runtime's (GR1), out of scope"
       "runtime/race" "the race detector is the runtime's and the compiler's, out of scope"
       "structs" "its layout markers are the compiler's, out of scope"
       "testing/cryptotest" "the crypto module's own tests, out of scope (S45)"
       "testing/synctest" "its bubbles are the runtime's, out of scope"
       "unique" "it is generic over the runtime's handles: neither compiled nor interpreted, out of scope"
       "weak" "it is generic over the runtime's weak pointers: neither compiled nor interpreted, out of scope"}
 ;; :replace    declarations of the interpretable packages replaced in the digest, in Go forms
 ;;             (GC29, GC58 (a)); a map's :imports are added to the declarations' files.
 ;;             maps.Clone clones through the runtime's maps.clone (go:linkname): a copy by range.
 ;;             internal/godebug's runtime hooks (GC58 (a)): GODEBUG read from the environment
 ;;             once, no metrics, the runtime's write to standard error by print.
 ;;             internal/cpu's assembly (amd64's cpuid, xgetbv, getGOAMD64level; arm64's
 ;;             getisar0, getisar1, getpfr0, getMIDR): no CPU feature (the generic code paths).
 ;;             internal/abi's FuncPC*: a panic (debug/gosym, which needs the package, never
 ;;             calls them). reflect.TypeFor (GC62 (a), the survey's F3; GC32 (b)): go1.21's
 ;;             body, without internal/abi's TypeFor; for an interpreted interface goi's
 ;;             builder calls goiNilType (added to reflect's digest), nil: the interface's
 ;;             reflect type would be any (§5.2), Implements true for every type, where nil
 ;;             makes Implements panic where it is asked
 :replace {"maps" [(go/func Clone :type-params [^{:tag (tilde (map K V))} M ^comparable K V] ^M [^M m]
                     (when (== m nil) (return nil))
                     (let [r (make M (len m))]
                       (range [k v m] (aset r k v))
                       r))]
           "internal/godebug" {:imports [[os "os"]]
                               :forms [(go/func setUpdate [^{:tag (func [string string])} update]
                                         (update "" (os/Getenv "GODEBUG")))
                                       (go/func registerMetric [^string name ^{:tag (func [] [uint64])} read])
                                       (go/func setNewIncNonDefault [^{:tag (func [string] [(func [])])} newIncNonDefault])
                                       (go/func write ^int32 [^uintptr fd ^unsafe/Pointer p ^int32 n]
                                         (print (unsafe/String (conv (* byte) p) (conv int n)))
                                         n)]}
           "internal/cpu" [(go/func cpuid [^uint32 eaxArg ^uint32 ecxArg] :results [^uint32 eax ^uint32 ebx ^uint32 ecx ^uint32 edx]
                             (return))
                           (go/func xgetbv [] :results [^uint32 eax ^uint32 edx]
                             (return))
                           (go/func getGOAMD64level ^int32 []
                             1)
                           (go/func getisar0 ^uint64 [] 0)
                           (go/func getisar1 ^uint64 [] 0)
                           (go/func getpfr0 ^uint64 [] 0)
                           (go/func getMIDR ^uint64 [] 0)]
           "internal/abi" [(go/func FuncPCABI0 ^uintptr [^any f]
                             (panic "goi: internal/abi.FuncPCABI0 is the compiler's"))
                           (go/func FuncPCABIInternal ^uintptr [^any f]
                             (panic "goi: internal/abi.FuncPCABIInternal is the compiler's"))]
           "reflect" [(go/func TypeFor :type-params [T] ^Type []
                        (let [^T v (zero T)]
                          (when [t (TypeOf v)] (!= t nil)
                            (return t)))
                        (.Elem (TypeOf (conv (* T) nil))))
                      (go/func goiNilType :type-params [T] ^Type []
                        nil)]}
 ;; :drop       body-less "bad linkname" aliases, never called, left out of the interpretable
 ;;             packages' digests (GC59 (a)); internal/race's two functions of internal/abi's
 ;;             types (empty but in race builds), so that iter, slices and maps do not import
 ;;             internal/abi
 ;; :api-interpreted  the interpretable packages whose types a listed package's digest names
 ;;             (the others' stay invalid there: GR8a): iter's generic types (strings.SplitSeq's
 ;;             iter.Seq[string], GC63 (a)); jsonopts.Options, the options of encoding/json,
 ;;             jsontext and json/v2 (an interface; the values crossing are compiled options)
 :api-interpreted ["iter" "encoding/json/internal/jsonopts"]
 ;; :bodyless   body-less declarations of an interpretable package kept as they are: a call is
 ;;             unsupported (iter.Pull's coroutines are the runtime's, GR6)
 :bodyless {"iter" ["newcoro" "coroswitch"]}
 :drop {"go/types" ["badlinkname_Checker_infer"]
        "net/http" ["badRoundTrip" "badServeHTTP"]
        "internal/race" ["ReadObjectPC" "WriteObjectPC"]}
 ;; reflect's lookups of methods known at run time only: a reachable Method, MethodByName
 ;; or Methods (go1.27's iterator) makes the linker keep every exported method of every
 ;; reachable type (S39; X3: +1.1 MB on 35 small packages; on the program, measured at GR1,
 ;; +19.9 MB with Value.Methods and Type.Methods listed). Since GR8b, Method and MethodByName
 ;; are goi's (:overrides); the iterators stay out
 ;; arbace's Hooks and its type Bridge: goi's side of the package, set when Arbace starts (§7.3)
 ;; :exclude-in members left out in one GOOS or GOOS/GOARCH: declared, but not implemented there
 ;;             (TamaGo's syscall has no assembly for them; its arm64 runtime no CallOnG0): listed,
 ;;             they made the box's guest fail to link (GR8a's syscall; GR1's runtime on arm64)
 :exclude-in {"tamago" {"syscall" ["RawSyscall" "RawSyscall6" "Syscall6"]}
              "tamago/arm64" {"runtime" ["CallOnG0"]}}
 :exclude {"arbace" ["Hooks" "Bridge"]
           "reflect" ["Value.Methods" "Type.Methods"]}
 ;; GS4 (b): a typed invoker only for the signatures at least this many members share; the
 ;; others are called by reflect.Value.Call. Measured at GR1 on linux/amd64 (bin/goi table
 ;; --size): an invoker per signature, 763, cost 1,630,208 bytes, above GS4's 1 MB; shared by 2
 ;; or more, 231 invokers, 856,064 bytes (860,160 with the four configurations: 233); by 3, 121, 667,648 bytes; by 5, 54, 512,000 bytes
 :min-sharing 2
 ;; os.Exit at the REPL throws arbace.lang.GoExit (§2.7, S12); reflect's method members are goi's
 ;; (GR8b, GC60 (a): an interpreted type's methods from its descriptor, a compiled type's from
 ;; the table's method expressions; Type.Method and MethodByName are never reflect's, whose
 ;; reachable call would make the linker keep every exported method, +17.7 MB)
 :overrides {"os" {"Exit" "Exit"}
             "reflect" {"Value.Method" "ValueMethod" "Value.MethodByName" "ValueMethodByName" "Value.NumMethod" "ValueNumMethod"
                        "Type.Method" "TypeMethod" "Type.MethodByName" "TypeMethodByName" "Type.NumMethod" "TypeNumMethod"}}
 ;; :stubs  the methods' stubs (GOI-SPEC.md, "As built: GR9a-c"; GC66 (a), GC67 (a)): the code
 ;;         behind the methods of interpreted types' runtime types, one Go function per method
 ;;         signature and slot. The families: every listed interface's methods' signatures and
 ;;         :common's (the table's data: [:func params results variadic], [:named "" "error"]
 ;;         the universe's): String/Error/GoString, Unwrap/Close/Err, errors.Is, errors.As,
 ;;         Unwrap() []error, MarshalJSON/MarshalText, UnmarshalJSON/UnmarshalText, Timeout and
 ;;         Temporary, sort's Len, Less and Swap, fmt.Formatter's Format, each with the names
 ;;         compiled code calls it by (a listed interface's method's its own): a method of
 ;;         another name, which no compiled code can call through an interface, takes no slot
 ;;         (GC126: interpreted std's types would exhaust the families otherwise). :slots the
 ;;         slots of a family, :slots-of a family's own count (GC67: 256 for func() string and
 ;;         func() error, 16 for every other; 64 for Read and Write's, GR8a's interpreted std);
 ;;         a method whose family has no slot left gets a stub that panics, and goi warns once
 ;;         at the REPL. A stub costs about 225 bytes of the executable
 :stubs {:slots 16
         :slots-of {[:func [] [:string] false] 256
                    [:func [] [[:named "" "error"]] false] 256
                    [:func [[:slice :uint8]] [:int [:named "" "error"]] false] 64}
         :common [[["Error" "GoString" "String"] [:func [] [:string] false]]
                  [["Close" "Err" "Unwrap"] [:func [] [[:named "" "error"]] false]]
                  [["Is"] [:func [[:named "" "error"]] [:bool] false]]
                  [["As"] [:func [[:interface [] []]] [:bool] false]]
                  [["Unwrap"] [:func [] [[:slice [:named "" "error"]]] false]]
                  [["MarshalBinary" "MarshalJSON" "MarshalText"] [:func [] [[:slice :uint8] [:named "" "error"]] false]]
                  [["UnmarshalBinary" "UnmarshalJSON" "UnmarshalText"] [:func [[:slice :uint8]] [[:named "" "error"]] false]]
                  [["Temporary" "Timeout"] [:func [] [:bool] false]]
                  [["Len"] [:func [] [:int] false]]
                  [["Less"] [:func [:int :int] [:bool] false]]
                  [["Swap"] [:func [:int :int] [] false]]
                  [["Format"] [:func [[:named "fmt" "State"] :int32] [] false]]]}}

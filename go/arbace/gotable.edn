;; goi's list of compiled packages (doc/go/GOI-SPEC.md §6.6): what arbace.go.table (bin/goi
;; table) puts in the table arbace/gotable and its digest, for every configuration of the
;; program (linux and tamago, amd64 and arm64). Read with the Clojure reader.
;;
;; :packages   the listed packages: GR1's 41, the std packages the program imports directly
;;             less unsafe, embed, syscall, runtime/pprof, runtime/goos, iter and weak (§6.6);
;;             GR3's three the check asked for (io/ioutil, log, math/rand: GS5, the size in
;;             GOI-SPEC.md, "As built: GR3"); GR5's package arbace, Go forms' API to Arbace
;;             (§7.3: its forms are go/'s, go/arbace.ae).
;;             The list grows by a commit here with the size it costs recorded (bin/goi table
;;             --size: the executable with and without the table)
;; :resolve    packages read for the declaration layer only (their types appear in the listed
;;             packages' signatures or embeddings), not listed
;; :exclude    members left out, with the reason
;; :min-sharing the typed invokers' threshold (GS4)
;; :overrides  members whose table entry is goi's function of the same signature (§6.7)
{:packages ["arbace" "archive/tar" "bytes" "compress/zlib" "context" "crypto/md5" "crypto/rand"
            "crypto/sha1" "crypto/sha256" "crypto/sha3" "crypto/sha512" "crypto/tls"
            "crypto/x509" "encoding" "encoding/binary" "encoding/hex" "errors" "fmt"
            "hash/crc32" "io" "io/fs" "io/ioutil" "log" "math" "math/bits" "math/rand" "math/rand/v2" "net" "net/netip" "os"
            "os/exec" "path" "path/filepath" "reflect" "runtime" "runtime/debug" "sort"
            "strconv" "strings" "sync" "sync/atomic" "time" "unicode" "unicode/utf16"
            "unicode/utf8"]
 :resolve []
 ;; :interpret  the interpretable packages (GOI-SPEC.md §9.3, GR6): generic packages without
 ;;             assembly, their forms in the digest whole, interpreted by goi as packages of
 ;;             their std paths (S1's exception): cmp, iter (but iter.Pull: its coroutines are
 ;;             the runtime's, through go:linkname), maps, slices, and internal/race, which iter
 ;;             imports (its functions empty but in race builds). Not in the table
 :interpret ["cmp" "internal/race" "iter" "maps" "slices"]
 ;; :replace    declarations of the interpretable packages replaced in the digest: maps.Clone
 ;;             clones through the runtime's maps.clone (go:linkname), written here as Go code
 :replace {"maps" [(go/func Clone :type-params [^{:tag (tilde (map K V))} M ^comparable K V] ^M [^M m]
                     (when (== m nil) (return nil))
                     (let [r (make M (len m))]
                       (range [k v m] (aset r k v))
                       r))]}
 ;; reflect's lookups of methods known at run time only: a reachable Method, MethodByName
 ;; or Methods (go1.27's iterator) makes the linker keep every exported method of every
 ;; reachable type (S39; X3: +1.1 MB on 35 small packages; on the program, measured at GR1,
 ;; +19.9 MB with Value.Methods and Type.Methods listed)
 ;; arbace's Hooks and its type Bridge: goi's side of the package, set when Arbace starts (§7.3)
 :exclude {"arbace" ["Hooks" "Bridge"]
           "reflect" ["Value.Method" "Value.MethodByName" "Value.Methods" "Type.Method" "Type.MethodByName" "Type.Methods"]}
 ;; GS4 (b): a typed invoker only for the signatures at least this many members share; the
 ;; others are called by reflect.Value.Call. Measured at GR1 on linux/amd64 (bin/goi table
 ;; --size): an invoker per signature, 763, cost 1,630,208 bytes, above GS4's 1 MB; shared by 2
 ;; or more, 231 invokers, 856,064 bytes (860,160 with the four configurations: 233); by 3, 121, 667,648 bytes; by 5, 54, 512,000 bytes
 :min-sharing 2
 ;; os.Exit at the REPL throws arbace.lang.GoExit (§2.7, S12)
 :overrides {"os" {"Exit" "Exit"}}}

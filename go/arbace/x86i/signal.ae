  ^{:line 29} [^{:val 2147483648} saResetHand 0x80000000]
  ^{:line 30} [^{:val 1} ssOnStack 1]
  ^{:line 31} [^{:val 2} ssDisable 2]
  ^{:line 32} [^{:val 2048} minSigStk 2048]
  ^{:line 33} [^{:val 9} sigKill 9]
  ^{:line 34} [^{:val 19} sigStop 19]

  ^{:line 36} [^{:val 440} frameSize 440]


  ^{:line 39} [^{:val 580 :doc "XSaveModel is the fpstate's size in x86i's model's frames (the FXSAVE area, the XSAVE header and the end's magic word):\na native run's frames are the host's size, which the lockstep gives x86i at the first delivery\n"} XSaveModel (+ 512 64 4)])




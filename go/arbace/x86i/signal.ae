(go/type trapState "trapState is the thread's last trap: its number, its error code, the last page fault's address (CR2).\n" (struct ^uint64 trapno ^uint64 err ^uint64 cr2))



^{:go/end 61} (go/method setInfo "setInfo sets the siginfo of a trap's signal and the thread's trap state: the trap's number and error code, and CR2 for a\npage fault only; the thread keeps them, so a later signal's frame (a kill's, another trap's CR2) shows them as Linux does.\n" [^{:tag (* CPU)} c ^int32 code ^uint64 addr ^uint64 trapno ^uint64 err ^uint64 cr2]
  (set! (.-info c) (lit sigInfo :code code :addr addr :fault (!= trapno 3)))
  (set! (values (.-trapno (.-trap c)) (.-err (.-trap c))) (values trapno err))
  (when (== trapno 14)
    (set! (.-cr2 (.-trap c)) cr2)))




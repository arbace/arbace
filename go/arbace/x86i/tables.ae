  ^{:line 88} [^{:tag (slice (slice uint16))} decisions]
  ^{:line 89} [^{:tag (slice insn)} insns] ; by ID; insns[0] is none
  ^{:line 90} [^{:tag (map string uint16)} insnByName])


^{:go/end 99} (go/func hexv ^uint64 [^string s]
  (let [(values v err) (strconv/ParseUint s 16 64)]
    (when (!= err nil)
      (panic (+ "x86i: bad decode table: " s)))

    ^{:line 98} v))


^{:go/end 132} (go/func init []
  (set! nctx (len (strings/Fields decCtxNames)))
  (for [i 0] (< i 32) (inc! i)
    (aset ctxOfMask i (conv int (hexv (subslice decCtx (* 2 i) (+ (* 2 i) 2))))))

  (set! decIdx (make (slice uint16) (/ (len decIndex) 4)))
  (range [i decIdx]
    (aset decIdx i (conv uint16 (hexv (subslice decIndex (* 4 i) (+ (* 4 i) 4))))))

  (range [_ l (strings/Split decDecisions "\n")]
    (let [d (make (slice uint16) (/ (len l) 4))]
      (range [i d]
        (aset d i (conv uint16 (hexv (subslice l (* 4 i) (+ (* 4 i) 4))))))

      (set! decisions (append decisions d))))

  (set! insns (lit (slice insn) (lit _)))
  (set! insnByName (lit (map string uint16)))
  (range [_ l (strings/Split decInsns "\n")]
    (let [f (strings/Split l " ")
        ^{:line 121} in (lit insn :name (aget f 0) :mnem (aget f 1))]
      (if (== (aget f 2) "!")
        (set! (.-bad in) true)

        (for [k 0] (<= (+ k 6) (len (aget f 2))) (set! k + 6)
          (set! (.-specs in) (append (.-specs in) (lit spec (conv uint8 (hexv (subslice (aget f 2) k (+ k 2)))) (conv uint8 (hexv (subslice (aget f 2) (+ k 2) (+ k 4)))) (conv uint8 (hexv (subslice (aget f 2) (+ k 4) (+ k 6)))))))))


      (aset insnByName (.-name in) (conv uint16 (len insns)))
      (set! insns (append insns in)))))




^{:go/end 135} (go/func InsnName "InsnName is the name of the instruction ID.\n" ^string [^uint16 id] (.-name (aget insns id)))

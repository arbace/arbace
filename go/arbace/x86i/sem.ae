;; The families (AXS54 (a)): each mnemonic's meaning written once from the Intel SDM (vol. 2) and the AMD APM (vol. 3) as
;; references, for every size and operand kind the decoder gives; bind chooses an instruction's family by its Intel
;; mnemonic (the table's printer string, dgen's).


(go/const "Families, for the coverage counts.\n"
  ^{:line 16} [^{:val 0} famNone iota]
  ^{:line 17} [^{:val 1} famALU]
  ^{:line 18} [^{:val 2} famUnary]
  ^{:line 19} [^{:val 3} famMov]
  ^{:line 20} [^{:val 4} famStack]
  ^{:line 21} [^{:val 5} famBranch]
  ^{:line 22} [^{:val 6} famMulDiv]
  ^{:line 23} [^{:val 7} famShift]
  ^{:line 24} [^{:val 8} famString]
  ^{:line 25} [^{:val 9} famConv]
  ^{:line 26} [^{:val 10} famAtomic]
  ^{:line 27} [^{:val 11} famMisc]
  ^{:line 28} [^{:val 12} famBit]
  ^{:line 29} [^{:val 13} famBMI]
  ^{:line 30} [^{:val 14} famSSE]
  ^{:line 31} [^{:val 15} famSSEInt]
  ^{:line 32} [^{:val 16} famSSEFP]
  ^{:line 33} [^{:val 17} famSSECvt])



(go/var ^{:doc "FamilyNames are the families' names, by number.\n"} FamilyNames ^{:go/breaks [18]} (lit (slice string) "unimplemented" "alu" "unary" "mov" "stack" "branch" "muldiv" "shift" "string" "conv" "atomic" "misc" "bit" "bmi" "sse" "sseint"
    "ssefp" "ssecvt"))

(go/type ^:alias execFn (func [^{:tag (* CPU)} c ^{:tag (* Inst)} in] [int]))

(go/var families (lit (map string (struct
        ^{:line 43 :tag uint8} fam
        ^{:line 44 :tag execFn} fn))))


^{:go/end 54} (go/func def [^uint8 fam ^execFn fn & ^{:tag (slice string)} mnems]

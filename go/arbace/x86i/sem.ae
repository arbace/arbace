            (return stopSignal))

          (.set (.-F c) fInc w a 1 (+ a 1))
          (set! (.-cin (.-F c)) cin))
        (case ["dec"]
          (when (not (.store c in (addr d) w (- a 1)))
            (return stopSignal))


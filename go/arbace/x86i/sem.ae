^{:go/end 262} (go/func unary ^int [^{:tag (* CPU)} c ^{:tag (* Inst)} in]
  (let [d (aget (.-Ops in) 0)
      ^{:line 229} w (.-Size d)
      (values a ok) (.load c in (addr d) w)]
    (when (not ok)
      (return stopSignal))

    (let [^uint64 cin (zero uint64)]
      (when (.cf (.-F c))
        (set! cin 1))

      (switch (.-Mnem in)
        (case ["inc"]
          (when (not (.store c in (addr d) w (+ a 1)))
            (return stopSignal))

          (.set (.-F c) fInc w a 1 (+ a 1))
          (set! (.-cin (.-F c)) cin))
        (case ["dec"]
          (when (not (.store c in (addr d) w (- a 1)))
            (return stopSignal))

          (.set (.-F c) fDec w a 1 (- a 1))
          (set! (.-cin (.-F c)) cin))
        (case ["neg"]
          (when (not (.store c in (addr d) w (- a)))
            (return stopSignal))

          (.set (.-F c) fSub w 0 a (- a)))
        (case ["not"]
          (when (not (.store c in (addr d) w (bit-not a)))
            (return stopSignal))))


      (.done c))))



        ^{:line 52} fam fn))))



^{:go/end 58} (go/func unimplemented ^int [^{:tag (* CPU)} c ^{:tag (* Inst)} in]
  (.raise c SIGILL (.-RIP c) (fmt/Sprintf ":unimplemented %s at %#x" (.-Name in) (.-RIP c))))





^{:go/end 81} (go/func bind "bind gives the instruction its family's routine: an instruction with an XMM operand SSE's by its mnemonic (movsd and\ncmpsd are also the string instructions'), the others the integer families'; an operand of a register file x86i does not\nmodel (MMX, x87, YMM, mask, segment, debug, control) none.\n" [^{:tag (* Inst)} in]
  (set! (values (.-exec in) (.-fam in)) (values unimplemented famNone))
  (let [xmm false]
    (range [_ o (.-Ops in)]
      (switch (.-K o)
        (case [OOther OSeg]
          (return))
        (case [OXMM]
          (set! xmm true))))


    (let [tab families]
      (when xmm
        (set! tab sseFamilies))

      (when [(values f ok) (aget tab (.-Mnem in))] ok
        (set! (values (.-exec in) (.-fam in)) (values (.-fn f) (.-fam f)))))))




^{:go/end 92} (go/func Claimed "Claimed are the decode tables' instructions a family claims (bind's rule over their operands' kinds): NAME, FAMILY.\n" ^{:tag (slice (array 2 string))} []
  (let [^{:tag (slice (array 2 string))} out (zero (slice (array 2 string)))]
    (for [id 1] (< id (len insns)) (inc! id)
      (when [f (FamilyOf (conv uint16 id))] (!= f "")
        (set! out (append out (lit (array 2 string) (.-name (aget insns id)) f)))))


    ^{:line 91} out))



^{:go/breaks [[5 119]] :go/end 120} (go/func FamilyOf "FamilyOf is the family that claims the instruction ID (\"\" none).\n" ^string [^uint16 id]
  (do
    (let [ins (addr (aget insns id))]
      (when (.-bad ins)
        (return ""))

      (let [in (addr (lit Inst :Name (.-name ins) :Mnem (.-mnem ins)))]
        (range [_ s (.-specs ins)]
          (switch (.-typ s)
            (case [tyXMM]
              (set! (.-Ops in) (append (.-Ops in) (lit Opnd :K OXMM))))
            (case [tyMM64 tyYMM tyZMM tyST tyVK tyVKPair tyTMM tyBNDR tySegReg tyDebugReg tyControlReg tyMVSIBX tyMVSIBY
                ^{:line 107} tyMVSIBZ]
              (set! (.-Ops in) (append (.-Ops in) (lit Opnd :K OOther)))))

          (when (== (.-enc s) encFP)
            (set! (.-Ops in) (append (.-Ops in) (lit Opnd :K OOther)))))


        (bind in)
        (when (!= (.-fam in) famNone)
          (return (aget FamilyNames (.-fam in)))))))


  "")




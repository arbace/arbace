;; ---------------------------------------------------------------------------------------------------------------------
;; alu: add or adc sbb and sub xor cmp test

^{:go/end 170} (go/func alu ^int [^{:tag (* CPU)} c ^{:tag (* Inst)} in]
  (let [(values ^Opnd d ^Opnd s) (zero Opnd)]
    (if (== (len (.-Ops in)) 1) (do ; the accumulator forms: AL/AX/EAX/RAX, imm
        (set! s (aget (.-Ops in) 0))
        (set! d (acc (.-Size s))))

      (set! (values d s) (values (aget (.-Ops in) 0) (aget (.-Ops in) (- (len (.-Ops in)) 1)))))

    (let [w (.-Size d)
        (values a ok) (.load c in (addr d) w)]
      (when (not ok)
        (return stopSignal))

      (let [(values b ^:assign ok) (.load c in (addr s) w)]
        (when (not ok)
          (return stopSignal))

        (set! b bit-and (mask w))
        (let [^uint64 r (zero uint64)
            ^{:line 135 :tag uint8} op (zero uint8)
            ^{:line 136 :tag uint64} cin (zero uint64)
            ^{:line 137} write true]
          (switch (.-Mnem in)
            (case ["add"]
              (set! (values r op) (values (+ a b) fAdd)))
            (case ["adc"]
              (when (.cf (.-F c))
                (set! cin 1))

              (set! (values r op) (values (+ a b cin) fAdc)))
            (case ["sub"]
              (set! (values r op) (values (- a b) fSub)))
            (case ["sbb"]
              (when (.cf (.-F c))
                (set! cin 1))

              (set! (values r op) (values (- a b cin) fSbb)))
            (case ["cmp"]
              (set! (values r op write) (values (- a b) fSub false)))
            (case ["and"]
              (set! (values r op) (values (bit-and a b) fLogic)))
            (case ["test"]
              (set! (values r op write) (values (bit-and a b) fLogic false)))
            (case ["or"]
              (set! (values r op) (values (bit-or a b) fLogic)))
            (case ["xor"]
              (set! (values r op) (values (bit-xor a b) fLogic))))

          (when (and write (not (.store c in (addr d) w r)))
            (return stopSignal))

          (.set (.-F c) op w a b r)
          (set! (.-cin (.-F c)) cin)
          (.done c))))))


;; unary: inc dec neg not

^{:go/end 209} (go/func unary ^int [^{:tag (* CPU)} c ^{:tag (* Inst)} in]
  (let [d (aget (.-Ops in) 0)
      ^{:line 176} w (.-Size d)
      (values a ok) (.load c in (addr d) w)]
    (when (not ok)
      (return stopSignal))

    (let [^uint64 cin (zero uint64)]
      (when (.cf (.-F c))

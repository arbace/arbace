          ^{:line 43 :tag uint8} fam
          ^{:line 44 :tag execFn} fn)
        ^{:line 45} fam fn))))



^{:go/end 51} (go/func unimplemented ^int [^{:tag (* CPU)} c ^{:tag (* Inst)} in]
  (.raise c SIGILL (.-RIP c) (fmt/Sprintf ":unimplemented %s at %#x" (.-Name in) (.-RIP c))))



^{:go/end 67} (go/func bind "bind gives the instruction its family's routine.\n" [^{:tag (* Inst)} in]
  (let [(values f ok) (aget families (.-Mnem in))]
    (when (not ok)
      (set! (values (.-exec in) (.-fam in)) (values unimplemented famNone))
      (return))

    (range [_ o (.-Ops in)]
      (when (or (== (.-K o) OXMM) (== (.-K o) OOther) (== (.-K o) OSeg))
        (set! (values (.-exec in) (.-fam in)) (values unimplemented famNone))
        (return)))


    (set! (values (.-exec in) (.-fam in)) (values (.-fn f) (.-fam f)))))




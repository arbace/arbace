^{:go/end 299} (go/func enter "enter imm16, imm8: RBP pushed, the nesting level's frame pointers copied (level mod 32), RBP the new frame, RSP lowered by\nthe size.\n" ^int [^{:tag (* CPU)} c ^{:tag (* Inst)} in]
  (let [size (bit-and (conv uint64 (.-Imm (aget (.-Ops in) 0))) 0xffff)
      ^{:line 271} level (bit-and (conv uint64 (.-Imm (aget (.-Ops in) 1))) 31)
      ^{:line 272} sp0 (aget (.-R c) 4)]
    (when (not (.push c (aget (.-R c) 5) 8))
      (return stopSignal))

    (let [ft (aget (.-R c) 4)]
      (when (> level 0)
        (let [bp (aget (.-R c) 5)]
          (for [i (conv uint64 1)] (< i level) (inc! i)
            (set! bp - 8)
            (let [(values v ok) (.Read (.-AS c) bp 8)]
              (when (not ok)
                (aset (.-R c) 4 sp0)
                (return (.fault c (.-FaultAddr (.-AS c)))))

              (when (not (.push c v 8))
                (aset (.-R c) 4 sp0)
                (return stopSignal))))


          (when (not (.push c ft 8))
            (aset (.-R c) 4 sp0)
            (return stopSignal))))


      (aset (.-R c) 5 ft)
      (set! (aget (.-R c) 4) - size)
      (.done c))))



^{:go/end 313} (go/func xlat "xlatb: AL from [RBX + AL].\n" ^int [^{:tag (* CPU)} c ^{:tag (* Inst)} in]
  (let [a (+ (aget (.-R c) 3) (bit-and (aget (.-R c) 0) 0xff))]
    (when (.-AdSize32 in)
      (set! a bit-and 0xffffffff))

    (let [(values v ok) (.Read (.-AS c) a 1)]
      (when (not ok)
        (return (.fault c (.-FaultAddr (.-AS c)))))

      (.setReg c 0 1 v)
      (.done c))))


^{:go/end 323} (go/func byteSwap ^uint64 [^uint64 v ^uint8 w]
  (switch w
    (case [2]
      (return (conv uint64 (bits/ReverseBytes16 (conv uint16 v)))))
    (case [4]
      (return (conv uint64 (bits/ReverseBytes32 (conv uint32 v))))))

  (bits/ReverseBytes64 v))



^{:go/end 337} (go/func movbe "movbe: a load or a store with its bytes reversed.\n" ^int [^{:tag (* CPU)} c ^{:tag (* Inst)} in]
  (let [(values d s) (values (aget (.-Ops in) 0) (aget (.-Ops in) 1))

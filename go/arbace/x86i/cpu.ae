    ^{:line 46 :tag uint64} next ; the address after the instruction executing


    ^{:line 49 :tag int :doc "the end: the exit status, or the signal and its reason\n"} ExitCode
    ^{:line 50 :tag int} Signal
    ^{:line 51 :tag string} Reason
    ^{:line 52 :tag uint64} SigAddr))



^{:go/end 63} (go/func New "New is a machine for the process in as with kernel k, at entry with the stack pointer sp.\n" ^{:tag (* CPU)} [^{:tag (* emu/AS)} as ^{:tag (* emu/Kernel)} k ^uint64 entry ^uint64 sp]
  (let [c (addr (lit CPU :AS as :K k :RIP entry :cache (lit (map uint64 (* Inst))) :byPage (lit (map uint64 (slice uint64)))))]
    (aset (.-R c) 4 sp)
    (set! (.-raw (.-F c)) 0x202)
    (set! (.-op (.-F c)) fRaw)
    (set! (.-OnCode as) (.-invalidate c))
    ^{:line 62} c))


^{:go/end 71} (go/method invalidate [^{:tag (* CPU)} c ^uint64 page]
  (range [_ a (aget (.-byPage c) page)]
    (delete (.-cache c) a))

  (delete (.-byPage c) page)
  (.ClearCode (.-AS c) page))



^{:go/end 77} (go/method raise "raise ends the run with signal sig.\n" ^int [^{:tag (* CPU)} c ^int sig ^uint64 addr ^string reason]
  (set! (values (.-Signal c) (.-SigAddr c) (.-Reason c)) (values sig addr reason))
  ^{:line 76} stopSignal)


^{:go/end 105} (go/method decodeAt [^{:tag (* CPU)} c ^uint64 rip] :results [(* Inst) int]
  (let [n (.Fetch (.-AS c) rip (subslice (.-fetch c)))]
    (when (== n 0)
      (return nil (.raise c SIGSEGV rip (fmt/Sprintf "fetch from %#x" rip))))

    (let [(values in r) (Decode (subslice (.-fetch c) _ n) false)]
      (switch r
        (case [DecOK]
          (when (> (conv int (.-Len in)) n)
            (return nil (.raise c SIGSEGV (.-FaultAddr (.-AS c)) "fetch"))))

        (case [DecUnsupported]
          (return nil (.raise c SIGILL rip (fmt/Sprintf ":unimplemented encoding % x at %#x" (subslice (.-fetch c) _ (min n 4)) rip))))
        (default
          (when (and (< n 15) (== (.Perm (.-AS c) (+ rip (conv uint64 n))) 0))
            (return nil (.raise c SIGSEGV (+ rip (conv uint64 n)) "fetch")))

          (return nil (.raise c SIGILL rip (fmt/Sprintf "invalid instruction % x at %#x" (subslice (.-fetch c) _ (min n 4)) rip)))))

      (bind in)
      (aset (.-cache c) rip in)
      (for [p (bit-and-not rip 4095)] (<= p (bit-and-not (- (+ rip (conv uint64 (.-Len in))) 1) 4095)) (set! p + 4096)
        (aset (.-byPage c) p (append (aget (.-byPage c) p) rip))
        (.MarkCode (.-AS c) p))

      (return in stepOK))))



^{:go/end 125} (go/method Step "Step executes one instruction.\n" ^int [^{:tag (* CPU)} c]
  (let [in (aget (.-cache c) (.-RIP c))]
    (when (== in nil)
      (let [^int r (zero int)]
        (when [(set! (values in r) (.decodeAt c (.-RIP c)))] (== in nil)
          (return r))))


    (set! (.-next c) (+ (.-RIP c) (conv uint64 (.-Len in))))
    (let [r ((.-exec in) c in)]
      (when (== r stepOK)
        (inc! (.-Steps c))
        (when (and (!= injFam 0) (== (.-fam in) injFam))
          (.Put (.-F c) (bit-xor (.Get (.-F c)) injBit) injBit)))


      ^{:line 124} r)))



^{:go/end 134} (go/method Run "Run executes until the process ends: stopExit (ExitCode) or stopSignal (Signal, Reason).\n" ^int [^{:tag (* CPU)} c]
  (while true
    (when [r (.Step c)] (!= r stepOK)
      (return r))))





^{:go/end 142} (go/method Status "Status is the process's status as a shell sees it: the exit code, or 128 + the signal.\n" ^int [^{:tag (* CPU)} c]
  (when (!= (.-Signal c) 0)
    (return (+ 128 (.-Signal c))))

  (.-ExitCode c))



    ^{:line 35 :tag uint64} FS
    ^{:line 36 :tag uint64} GS
    ^{:line 37 :tag (array 16 (array 2 uint64))} X ; XMM (not yet executed: AX5.5)

    ^{:line 39 :tag (* emu/AS)} AS
    ^{:line 40 :tag (* emu/Kernel)} K
    ^{:line 41 :tag uint64} Steps
    ^{:line 42 :tag (map uint64 (* Inst))} cache
    ^{:line 43 :tag (map uint64 (slice uint64))} byPage

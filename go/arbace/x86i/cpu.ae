^{:go/end 157} (go/func mask ^uint64 [^uint8 size]
  (switch size
    (case [1]
      (return 0xff))
    (case [2]
      (return 0xffff))
    (case [4]
      (return 0xffffffff)))

  (bit-not (conv uint64 0)))


^{:go/end 159} (go/func signBit ^uint64 [^uint8 size] ^uint64 (<< 1 (- (* 8 (conv uint size)) 1)))


        (return v ok))))

  (panic (+ "x86i: load of operand kind " (fmt/Sprint (.-K o)))))



^{:go/end 257} (go/method store "store writes the operand; ok false: a fault (raised).\n" ^bool [^{:tag (* CPU)} c ^{:tag (* Inst)} in ^{:tag (* Opnd)} o ^uint8 size ^uint64 v]

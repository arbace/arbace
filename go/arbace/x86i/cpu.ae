^{:go/end 179} (go/method reg "reg reads register r of the size (r 16-19: AH, CH, DH, BH).\n" ^uint64 [^{:tag (* CPU)} c ^uint8 r ^uint8 size]
  (when (>= r 16)
    (return (bit-and (>> (aget (.-R c) (- r 16)) 8) 0xff)))

  (bit-and (aget (.-R c) r) (mask size)))



^{:go/end 194} (go/method setReg "setReg writes register r: a 32-bit write zeroes the upper half, 8- and 16-bit writes keep the rest.\n" [^{:tag (* CPU)} c ^uint8 r ^uint8 size ^uint64 v]
  (switch
    (case [(>= r 16)]
      (aset (.-R c) (- r 16) (bit-or (bit-and-not (aget (.-R c) (- r 16)) 0xff00) (<< (bit-and v 0xff) 8))))
    (case [(== size 8)]
      (aset (.-R c) r v))
    (case [(== size 4)]
      (aset (.-R c) r (bit-and v 0xffffffff)))
    (default
      (let [m (mask size)]
        (aset (.-R c) r (bit-or (bit-and-not (aget (.-R c) r) m) (bit-and v m)))))))




^{:go/end 218} (go/method ea "ea is the memory operand's address.\n" ^uint64 [^{:tag (* CPU)} c ^{:tag (* Inst)} in ^{:tag (* Opnd)} o]
  (let [^uint64 a (zero uint64)]
    (cond (== (.-Base o) RIP)
      (set! a (.-next c))
      (>= (.-Base o) 0)
      (set! a (aget (.-R c) (.-Base o))))

    (when (>= (.-Index o) 0)
      (set! a + (* (aget (.-R c) (.-Index o)) (conv uint64 (.-Scale o)))))

    (set! a + (conv uint64 (.-Disp o)))
    (when (.-AdSize32 in)
      (set! a bit-and 0xffffffff))

    (switch (.-Seg o)
      (case [5]
        (set! a + (.-FS c)))
      (case [6]
        (set! a + (.-GS c))))

    ^{:line 217} a))




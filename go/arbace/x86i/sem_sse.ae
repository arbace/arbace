^{:go/end 309} (go/func xmovhl "movlps movlpd movhps movhpd (a quadword of memory into the low or high half, or out of it), movlhps (the source's low half\ninto the high), movhlps (the source's high half into the low).\n" ^int [^{:tag (* CPU)} c ^{:tag (* Inst)} in]

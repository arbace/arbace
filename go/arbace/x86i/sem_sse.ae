      (return stopSignal))

    (.done c)))



^{:go/end 260} (go/func xmovs "movss, movsd (SSE2's): between registers the low lane replaced; from memory zero-extended; to memory the low lane.\n" ^int [^{:tag (* CPU)} c ^{:tag (* Inst)} in]

          (let [n (/ 8 w)
              ^{:line 362} base 0]
            (when high
              (set! base n))

            (for [i 0] (< i n) (inc! i)
              (.set R w (* 2 i) (.get A w (+ base i)))
              (.set R w (+ (* 2 i) 1) (.get B w (+ base i))))))]



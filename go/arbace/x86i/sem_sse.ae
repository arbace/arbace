^{:go/end 346} (go/func xlogic "the logic: and andn or xor, bitwise over the 128 bits (andn: the destination complemented first).\n" ^int [^{:tag (* CPU)} c ^{:tag (* Inst)} in]
  (let [d (addr (aget (.-Ops in) 0))
      (values b ok) (.xload c in (addr (aget (.-Ops in) 1)))]
    (when (not ok)
      (return stopSignal))

    (let [a (aget (.-X c) (.-Reg d))
        ^{:line 331 :tag vec} r (zero vec)]

            (.set R 4 1 (.get A 4 (conv int (bit-and (>> m 2) 3))))
            (.set R 4 2 (.get B 4 (conv int (bit-and (>> m 4) 3))))
            (.set R 4 3 (.get B 4 (conv int (bit-and (>> m 6) 3))))))
        (case ["shufpd"]

(go/var ^{:doc "unaligned are the instructions whose 16-byte memory operand may be misaligned; every other legacy SSE instruction's\nraises #GP (SIGSEGV, si_code SI_KERNEL, address 0) on one.\n"} unaligned (lit (map string bool) ["movups" true] ["movupd" true] ["movdqu" true]))

^{:go/end 88} (go/method misaligned ^int [^{:tag (* CPU)} c ^{:tag (* Inst)} in ^uint64 a]
  (.raise c SIGSEGV 0 (fmt/Sprintf "%s: a misaligned 16-byte operand at %#x (#GP)" (.-Name in) a)))




^{:go/end 127} (go/method xload "xload reads operand o as a vector: an XMM register whole, memory of the operand's size zero-extended (16 bytes aligned\nunless the instruction is an unaligned one), a general register of its size.\n" [^{:tag (* CPU)} c ^{:tag (* Inst)} in ^{:tag (* Opnd)} o] :results [vec bool]
  (switch (.-K o)
    (case [OXMM]
      (return (aget (.-X c) (.-Reg o)) true))
    (case [OReg]
      (return (lit vec (.reg c (.-Reg o) (.-Size o)) 0) true))
    (case [OMem]
      (let [a (.ea c in o)]
        (switch (.-Size o)
          (case [16]
            (when (and (!= (bit-and a 15) 0) (not (aget unaligned (.-Mnem in))))
              (.misaligned c in a)
              (return (lit vec) false))

            (let [(values lo ok) (.Read (.-AS c) a 8)]
              (when (not ok)
                (.fault c (.-FaultAddr (.-AS c)))
                (return (lit vec) false))

              (let [(values hi ^:assign ok) (.Read (.-AS c) (+ a 8) 8)]
                (when (not ok)
                  (.fault c (.-FaultAddr (.-AS c)))
                  (return (lit vec) false))

                (return (lit vec lo hi) true))))
          (case [1 2 4 8]
            (let [(values v ok) (.Read (.-AS c) a (conv int (.-Size o)))]
              (when (not ok)
                (.fault c (.-FaultAddr (.-AS c)))
                (return (lit vec) false))

              (return (lit vec v 0) true)))))))


  (panic (fmt/Sprintf "x86i: xload of operand kind %d size %d (%s)" (.-K o) (.-Size o) (.-Name in))))




^{:go/end 159} (go/method xstore "xstore writes operand o from v: an XMM register whole, memory the operand's size (16 bytes aligned unless unaligned), a\ngeneral register of its size.\n" ^bool [^{:tag (* CPU)} c ^{:tag (* Inst)} in ^{:tag (* Opnd)} o ^vec v]
  (switch (.-K o)
    (case [OXMM]
      (aset (.-X c) (.-Reg o) v)
      (return true))
    (case [OReg]
      (.setReg c (.-Reg o) (.-Size o) (aget v 0))
      (return true))
    (case [OMem]
      (let [a (.ea c in o)
          ^{:line 141} n (conv int (.-Size o))]
        (when (and (== n 16) (!= (bit-and a 15) 0) (not (aget unaligned (.-Mnem in))))
          (.misaligned c in a)
          (return false))

        (when (not (.Probe (.-AS c) a n))
          (.fault c (.-FaultAddr (.-AS c)))
          (return false))

        (if (== n 16) (do
            (.Write (.-AS c) a 8 (aget v 0))
            (.Write (.-AS c) (+ a 8) 8 (aget v 1)))

          (.Write (.-AS c) a n (aget v 0)))

        (return true))))

  (panic (fmt/Sprintf "x86i: xstore to operand kind %d (%s)" (.-K o) (.-Name in))))



(go/type lanes "lanes: the vector as bytes, a lane of w bytes read and written little-endian\n" (array 16 byte))

^{:go/end 170} (go/func toLanes [^vec v] :results [^lanes b]
  (for [i 0] (< i 8) (inc! i)
    (aset b i (conv byte (>> (aget v 0) (* 8 i))))
    (aset b (+ 8 i) (conv byte (>> (aget v 1) (* 8 i)))))

  (return))


^{:go/end 178} (go/method vec [^{:tag (* lanes)} b] :results [^vec v]
  (for [i 0] (< i 8) (inc! i)
    (set! (aget v 0) bit-or (<< (conv uint64 (aget b i)) (* 8 i)))
    (set! (aget v 1) bit-or (<< (conv uint64 (aget b (+ 8 i))) (* 8 i))))

  (return))


^{:go/end 186} (go/method get ^uint64 [^{:tag (* lanes)} b ^int w ^int i]

^{:go/end 445} (go/func xextr "pextrw: a word of the XMM register (the immediate's low three bits) into a general register, zero-extended; pinsrw: the\nsource's low word into that word of the XMM register.\n" ^int [^{:tag (* CPU)} c ^{:tag (* Inst)} in]

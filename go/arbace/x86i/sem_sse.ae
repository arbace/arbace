^{:go/end 416} (go/func xshuf "shuffles and unpacks.\n" ^int [^{:tag (* CPU)} c ^{:tag (* Inst)} in]
  (let [d (addr (aget (.-Ops in) 0))
      (values s ok) (.xload c in (addr (aget (.-Ops in) 1)))]
    (when (not ok)
      (return stopSignal))

    (let [a (aget (.-X c) (.-Reg d))
        (values A B) (values (toLanes a) (toLanes s))
        ^{:line 359 :tag lanes} R (zero lanes)

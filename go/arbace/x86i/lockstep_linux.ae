                    (set! (.-k l) (emu/NewKernel (.-as l) img ks))
                    (set! (.-c l) (New (.-as l) (.-k l) (.-Rip (.-Regs t)) sp))
                    (set! (.-R (.-c l)) (nativeGPR (addr (.-Regs t))))
                    (set! (.-FS (.-c l)) (.-Fs_base (.-Regs t)))
                    (set! (.-Manual (.-c l)) true)
                    (set! (.-Pid (.-c l)) (bit-or (conv uint64 (.-Pid t)) (<< (conv uint64 (os/Getuid)) 32)))

                    (when (and (.-Step opts) (<= (.-StepFrom opts) 0))
                      (return (.stepLoop l)))

                    (.sysLoop l)))))))))))


^{:go/end 185} (go/method fail [^{:tag (* lockstep)} l ^string f & ^{:tag (slice any)} a] :results [(* LockstepResult) error]

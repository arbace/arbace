^{:go/end 174} (go/func Lockstep "Lockstep runs path in the sys mode (opts.StepFrom < 0), the step mode, or the sys mode then the step mode.\n" [^string path ^{:tag (slice string)} argv ^{:tag (slice string)} env ^LockstepOpts opts] :results [(* LockstepResult) error]
  (when (== (.-MemEvery opts) 0)
    (set! (.-MemEvery opts) 4096))

  (let [tmp (os/TempDir)
      (values in err) (os/CreateTemp tmp "x86i-stdin")]
    (when (!= err nil)
      (return nil err))

    (defer (os/Remove (.Name in)))
    (let [l (addr (lit lockstep :res (addr (lit LockstepResult)) :opts opts))]
      (set! (values (.-nout l) _) (os/CreateTemp tmp "x86i-out"))
      (set! (values (.-nerr l) _) (os/CreateTemp tmp "x86i-err"))
      (defer (os/Remove (.Name (.-nout l))))
      (defer (os/Remove (.Name (.-nerr l))))
      (let [(values t ^:assign err) (emu/StartTracee path argv env (lit (slice uintptr) (.Fd in) (.Fd (.-nout l)) (.Fd (.-nerr l))))]
        (when (!= err nil)
          (return nil err))

        (set! (.-t l) t)
        (defer (.Kill t))

        ;; the native's initial stack
        (let [(values lo hi ^:assign err) (.StackRange t)]
          (when (!= err nil)
            (return nil err))

          (let [(values stack ^:assign err) (.Read t lo (conv int (- hi lo)))]
            (when (!= err nil)

              (when (== (.-Loader (.-res l)) "")
                (set! (.-Loader (.-res l)) (vdsoJudge t)))

              ;; the vdso hidden
              (let [at ^{:go/end 139} (fn ^uint64 [^uint64 a] (.Uint64 binary/LittleEndian (subslice stack (- a lo))))
                  ^{:line 140} p (+ sp 8 (* 8 (at sp)) 8)]
                (while (!= (at p) 0)
                  (set! p + 8))

                (for [(set! p + 8)] (!= (at p) 0) (set! p + 16)
                  (when (== (at p) 33) ; AT_SYSINFO_EHDR -> AT_IGNORE
                    (.PutUint64 binary/LittleEndian (subslice stack (- p lo)) 1)
                    (when [err (.Write t p (subslice stack (- p lo) (+ (- p lo) 8)))] (!= err nil)
                      (return nil err))))




                ;; x86i from the same state
                (set! (.-as l) (emu/NewAS))
                (let [(values img ^:assign err) (emu/LoadELF (.-as l) path)]
                  (when (!= err nil)
                    (return nil err))

                  (.Map (.-as l) (- hi emu/StackSize) emu/StackSize (bit-or emu/PermR emu/PermW) "stack")

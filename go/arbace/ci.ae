(ns go.arbace.ci
  (:require [arbace.go :as go]))

(go/package ci
  :path "arbace/ci"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["builtins.go" "call.go" "expr.go" "load.go" "natives.go" "prog.go" "stmt.go"]
  :init-order [iBuiltins fBuiltins Strace Natives CallTrace]
  :positions :lines)

(load "ci/builtins")
(load "ci/call")
(load "ci/expr")
(load "ci/load")
(load "ci/natives")
(load "ci/prog")
(load "ci/stmt")

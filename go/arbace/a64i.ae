(ns go.arbace.a64i
  (:require [arbace.go :as go]))

(go/package a64i
  :path "arbace/a64i"
  :config {:goos "linux" :goarch "arm64" :goarm64 "v8.0" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["claim.go" "cpu.go" "decode.go" "exec.go" "forms.go" "inst.go" "lockstep.go" "lockstep_linux_arm64.go" "lockstep_other.go"]
  :init-order [undef shiftKinds extKinds conds barrierOpts sysRegs lseOps opNames Families world]
  :positions :lines)

(load "a64i/claim")
(load "a64i/cpu")
(load "a64i/decode")
(load "a64i/exec")
(load "a64i/forms")
(load "a64i/inst")
(load "a64i/lockstep")
(load "a64i/lockstep_linux_arm64")
(load "a64i/lockstep_other")

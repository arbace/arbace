(ns go.arbace.a64i
  (:require [arbace.go :as go]))

(go/package a64i
  :path "arbace/a64i"
  :config {:goos "linux" :goarch "arm64" :goarm64 "v8.0" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["claim.go" "cpu.go" "decode.go" "exec.go" "forms.go" "fp.go" "inst.go" "lockstep.go" "lockstep_linux_arm64.go" "lockstep_other.go" "simd.go" "simdcrypto.go" "simdest.go" "simdfp.go" "simdhalf.go" "simdint.go" "simdmem.go" "simdsat.go" "simdx.go"]
  :init-order [undef shiftKinds extKinds conds barrierOpts sysRegs lseOps fpOpNames fp1Names fp2Names fp3Names rnds opNames Families world simdOpNames v3Names v2Names vacrNames vshiNames vimmNames vpermNames v3dNames esz unimpSIMD simdScalar ["simd.go" 1498 5] vcNames vcOps aesBox vestNames vf3Names vf2Names velNames vfcvtNames vfixNames halfFmt ["simdfp.go" 900 5] halfMnemonics vintNames vsatNames bigOne vxNames]
  :positions :lines)

(load "a64i/claim")
(load "a64i/cpu")
(load "a64i/decode")
(load "a64i/exec")
(load "a64i/forms")
(load "a64i/fp")
(load "a64i/inst")
(load "a64i/lockstep")
(load "a64i/lockstep_linux_arm64")
(load "a64i/lockstep_other")
(load "a64i/simd")
(load "a64i/simdcrypto")
(load "a64i/simdest")
(load "a64i/simdfp")
(load "a64i/simdhalf")
(load "a64i/simdint")
(load "a64i/simdmem")
(load "a64i/simdsat")
(load "a64i/simdx")

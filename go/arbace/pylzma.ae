(ns go.arbace.pylzma
  (:require [arbace.go :as go]))

(go/package pylzma
  :path "arbace/pylzma"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["pylzma.go"]
  :init-order [lzmaCompressorType lzmaDecompressorType BUFFER_BLOCK_SIZE lzmaOptFields]
  :positions :full)

(load "pylzma/pylzma")

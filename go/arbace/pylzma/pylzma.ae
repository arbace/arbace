(in-ns 'go.arbace.pylzma) ^{:go/comments [[3 1 "// _lzmamodule.c: Copyright (c) the Python Software Foundation, under the PSF License Agreement for Python 3.14"] [4 1 "// (LICENSE.md). The port to Go: Copyright (c) the Arbace authors, under the same license."] [6 1 "// The module _lzma (queue 208; doc/python/PYTHON-SURVEY.md, \"As built: 208\", \"After the decisions\"): CPython"] [7 1 "// 3.14.10's Modules/_lzmamodule.c (with Modules/clinic/_lzmamodule.c.h's argument parsing) ported statement for"] [8 1 "// statement over liblzma 5.2.5 itself, the C library built by ci's builder (arbace/clib/xz's node program) and called"] [9 1 "// through arbace/clib, as _bz2 is (arbace/pybz2: its notes on memory, the output blocks, the GIL and the finalizers"] [10 1 "// hold here too). LZMACompressor (formats XZ, ALONE, RAW; a preset or a filter chain), LZMADecompressor (AUTO, XZ,"] [11 1 "// ALONE, RAW; memlimit; check, eof, needs_input, unused_data), is_check_supported, _encode_filter_properties,"] [12 1 "// _decode_filter_properties, LZMAError and the constants. lzma.py (LZMAFile, lzma.open, compress, decompress) is"] [13 1 "// the tarball's Python over it."] [14 1 "//"] [15 1 "// The filter specifiers (Python dicts) become liblzma's lzma_filter chains and option structures in C memory through"] [16 1 "// tools/pyi/clib/xz/pylzma.c's helpers (pylzma_chain, pylzma_lzma_new, pylzma_lzma_set, ...), which keep their layout"] [17 1 "// liblzma's; parse_filter_spec_*'s PyArg_ParseTupleAndKeywords over the dict is specArgs: a key not among the"] [18 1 "// filter's option names, or a value its converter refuses, is the \"Invalid filter specifier\" ValueError CPython"] [19 1 "// raises in place of the parser's error."] [32 1 "/* Container formats: */"] [40 1 "// lzma.h's constants."] [95 1 "// The layout the C side gives (pylzma_layout), read once."] [112 1 "// lzmaLib is the library's program, opened on the module's first use."] [128 17 "// lzma_stream *, C memory"] [135 27 "// lzma_stream *, C memory"] [140 27 "// uint8_t *, C memory"] [146 1 "// The stream's fields."] [156 1 "// newStream is LZMA_STREAM_INIT: zeroed (allocator NULL: liblzma's default, musl's malloc)."] [165 1 "// Blocks output buffer wrappers (pycore_blocks_output_buffer.h), as arbace/pybz2's."] [265 1 "/* Helper functions. */"] [292 1 "// unsignedConv is _PyLong_UInt32_Converter, _PyLong_UInt64_Converter and lzma's INT_TYPE_CONVERTER_FUNC"] [293 1 "// (PyLong_AsNativeBytes with ALLOW_INDEX, REJECT_NEGATIVE, UNSIGNED_BUFFER): bits wide, ctype in the message."] [314 1 "// cIntArg is PyLong_AsInt (\"i\" of PyArg_ParseTupleAndKeywords)."] [320 1 "// mappingCheck is PyMapping_Check: a type with __getitem__."] [326 1 "// mappingGetOptionalItemString is PyMapping_GetOptionalItemString: (nil, nil) for a missing key."] [338 1 "// specArgs is parse_filter_spec_*'s PyArg_ParseTupleAndKeywords(empty_tuple, spec, ...): spec a dict whose keys"] [339 1 "// are among optnames; the values by name (nil: absent). ok false: the parser's failure (the caller raises its"] [340 1 "// ValueError in place of it)."] [371 1 "/* Filter specifier parsing.\n\n   This code handles converting filter specifiers (Python dicts) into the C lzma_filter structs expected by\n   liblzma. */"] [382 2 "/* First, fill in default values for all the options using a preset. Then, override the defaults with any\n\t   values given by the caller. */"] [469 1 "// lzma_filter_converter sets filters[i] (a chain of pylzma_chain's) from spec."] [504 1 "// parse_filter_chain_spec gives a chain (pylzma_chain_free frees it)."] [506 2 "// PySequence_Length: a dict is not a sequence (it has no sq_length)"] [531 1 "/* Filter specifier construction.\n\n   This code handles converting C lzma_filter structs into Python-level filter specifiers (represented as dicts). */"] [546 2 "/* For LZMA1 filters, lzma_properties_{encode,decode}() only look at the lc, lp, pb, and dict_size fields.\n\t   For LZMA2 filters, only the dict_size field is used. */"] [568 1 "// cbytes is a copy of data in C memory (0 for no bytes)."] [580 1 "/* LZMACompressor class. */"] [594 20 "/* That wasn't a real error */"] [754 1 "/* LZMADecompressor class. */"] [756 1 "/*\nDecompress data of length d->lzs.avail_in in d->lzs.next_in. The output buffer is allocated dynamically and\n\n\treturned. At most max_length bytes are returned, so some of the input may not be consumed. d->lzs.next_in and\n\td->lzs.avail_in are updated to reflect the consumed input.\n*/"] [772 20 "/* That wasn't a real error */"] [785 4 "/* Need to check lzs->avail_out before lzs->avail_in. Maybe lzs's internal state still have a few bytes\n\t\t\t   can be output, grow the output buffer and continue if max_lengh < 0. */"] [805 23 "// the caller's buffer in C memory (freed at the end)"] [807 2 "/* Prepend unconsumed input if necessary */"] [809 3 "/* Number of bytes we can append to input buffer */"] [812 3 "/* Number of bytes we can append if we move existing contents to beginning of buffer (overwriting\n\t\t   consumed input) */"] [820 4 "/* Assign to temporary variable first, so we don't lose address of allocated buffer if realloc\n\t\t\t   fails */"] [830 60 "// memmove"] [858 3 "// the caller's buffer is freed below: next_in must not name it (the stream ended; nothing reads it)"] [865 4 "/* (avail_in==0 && avail_out==0) Maybe lzs's internal state still have a few bytes can be output, try\n\t\t\t   to output them next time. */"] [869 4 "/* Input buffer exhausted, output buffer has space. */"] [875 3 "/* If we did not use the input buffer, we now have to copy the tail from the caller's buffer into the\n\t\t   input buffer */"] [879 4 "/* Discard buffer if it's too small (resizing it may needlessly copy the current contents) */"] [885 4 "/* Allocate if necessary */"] [895 4 "/* Copy tail */"] [896 60 "// memcpy"] [974 1 "/* Module-level functions. */"] [1022 54 "// LZMA_VLI_UNKNOWN: nothing to free"] [1027 2 "/* We use vanilla free() here instead of PyMem_Free() - filter.options was allocated by\n\t   lzma_properties_decode() using the default allocator. */"] [1033 1 "/* Module initialization. */"] [1039 3 "// a C type's instance with state and no __getstate__ (object_getstate): \"cannot pickle 'TP_NAME' object\""] [1127 1 "// lzmaMakeModule is PyInit__lzma with lzma_exec."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[330 28] [389 42] [436 42] [455 58] [507 40] [522 12] [522 29] [523 56] [596 36] [695 33] [700 32] [717 42] [774 36] [928 61] [988 50] [996 102] [1005 102] [1021 35] [1084 34]]} (go/file "pylzma.go" :imports [


(ns go.arbace.pysqlite3
  (:require [arbace.go :as go]))

(go/package pysqlite3
  :path "arbace/pysqlite3"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["blob.go" "callbacks.go" "connection.go" "constants.go" "cursor.go" "module.go" "row.go" "statement.go" "util.go"]
  :init-order [strerrors error_codes integer_constants BlobType ConnectionType CursorType PrepareProtocolType RowType StatementType handles]
  :positions :full)

(load "pysqlite3/blob")
(load "pysqlite3/callbacks")
(load "pysqlite3/connection")
(load "pysqlite3/constants")
(load "pysqlite3/cursor")
(load "pysqlite3/module")
(load "pysqlite3/row")
(load "pysqlite3/statement")
(load "pysqlite3/util")

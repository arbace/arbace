;; cinterp: arbace.lang.CInterp's natives.
(in-ns 'go.arbace.cinterp)

(go/file "natives.go"
  :doc "Package cinterp holds the natives of arbace.lang.CInterp, ci's back end reached from Arbace: a C
program's node program (arbace.c.build's, as text) loaded into a fresh address space and run in the
program mode.\n"
  :imports [[bufio "bufio"] [fmt "fmt"] [os "os"] [ci "arbace/ci"] [crt "arbace/crt"] [jrt "arbace/jrt"]])

(go/func CInterp_RunNodes_String_String1__I_native
  "CInterp_RunNodes_String_String1__I_native runs the node program text with the command line argv
(argv[0] the program's name) on the process's standard streams: the program's exit status (128 + a
signal's number), a fault reported on the standard error as tools/cirun reports it (\"cirun: fault: ...\", its own failures
\"cirun: internal: ...\" with status 70), which bin/ci check's judge reads.\n"
  ^int32 [^{:tag (* jrt/String)} text ^{:tag (* jrt/RefArray)} argv]
  (let [(values tops err) (ci/Parse (.String text))]
    (when (!= err nil)
      (fmt/Fprintln os/Stderr "cirun: internal:" err)
      (return 70))
    (let [out (bufio/NewWriterSize os/Stdout 65536)
          m (crt/NewMem)
          sys (crt/NewSys m os/Stdin out os/Stderr)
          p (ci/NewProg sys)
          l (ci/NewLoader p)]
      (range [_ t tops]
        (.Top l t))
      (when (== (.-Entry l) nil)
        (.Flush out)
        (fmt/Fprintln os/Stderr "cirun: internal: no entry")
        (return 70))
      (let [args (make (slice string) 0 (len (.-A argv)))]
        (range [_ a (.-A argv)]
          (set! args (append args (.String (assert (* jrt/String) a)))))
        (let [(values status fault) (.RunMain p (.-Start l) (.-Entry l) args)]
          (.Flush out)
          (when (!= fault nil)
            (fmt/Fprintln os/Stderr "cirun: fault:" fault))
          (conv int32 status))))))

(in-ns 'go.arbace.hs) ^{:go/comments [[10 1 "// The compiled code: each closure's body a tree of nodes over the slots of its frame (its free"] [11 1 "// variables first, then its arguments, then every local binder of the body, join points' arguments"] [12 1 "// among them). A node's eval returns the next node to run in a frame (a tail position), or nil when it"] [13 1 "// has put its value in the machine's return registers."] [18 1 "// Atom is an argument: a slot, a global or a literal."] [20 13 "// aSlot, aGlobal, aLit"] [54 1 "// scope is a closure's compile-time frame."] [61 2 "// tail: the expression compiled is in its function's tail position, outside every case's scrutinee: no frame of"] [62 2 "// the activation is on the stack there, so a call may reuse the activation's frame (App.tail)"] [84 1 "// bind gives name a fresh slot; the returned func restores the outer binding."] [110 1 "// isVoid reports a binder's representations of none (:v)."] [125 1 "// atom compiles an argument."] [165 3 "// two's complement truncation"] [173 1 "// literal is a literal's value (STG-SPEC §5)."] [243 1 "// staticCon is the one value of a constructor whose fields are all literals (as GHC's static closures: immutable,"] [244 1 "// so one value serves every evaluation), or nil. Not in an image's compilation: its literals may be placeholders."] [266 1 "// rubbish is a LitRubbish of a lifted or unlifted type: never entered."] [269 1 "// literal keys of case alternatives: integers by their 64 bits, floats as themselves."] [278 1 "// compileLambda compiles (closure UPD [FREE...] [BINDER...] EXPR) in a frame of its own."] [302 1 "// freeAtoms are a closure's free variables as atoms of the enclosing frame."] [312 1 "// expr compiles an expression. minDouble#'s and maxDouble#'s (and Float#'s) literal operand goes second:"] [313 1 "// GHC's code generator emits minsd reg, [lit], and the operands' order decides a NaN's and a zero's result."] [348 4 "// GHC's code generator puts a literal operand second (minsd reg, [lit]): the order decides"] [349 4 "// a NaN's and a zero's result"] [386 3 "// a literal"] [393 1 "// isTuple reports an unboxed tuple's constructor (returned as several values, STG-SPEC §3)."] [472 1 "// let compiles (let BIND EXPR): closures and constructors allocated in the frame's slots."] [534 1 "// letne compiles join points: their arguments are slots of this frame, a jump assigns them."] [573 2 "// the join points' bodies see each other (rec) and themselves"] [595 2 "// (ffi TARGET CONV SAFETY [ATOM...] REPS)"] [618 1 "// cSymbol is the C function a static target calls: a capi wrapper's name decoded"] [619 1 "// (ghczuwrapperZC23ZC...ZCread is read)."] [629 1 "// zdecode decodes GHC's z-encoding of a name."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[129 25] [320 26] [356 28] [357 43] [370 25] [449 23] [449 31] [528 22] [528 30] [583 24] [583 32] [588 22] [588 30] [622 39] [632 12] [632 24]]} (go/file "compile.go" :imports [



(in-ns 'go.arbace.hs) ^{:go/comments [[10 1 "// The compiled code: each closure's body a tree of nodes over the slots of its frame (its free"] [11 1 "// variables first, then its arguments, then every local binder of the body, join points' arguments"] [12 1 "// among them). A node's eval returns the next node to run in a frame (a tail position), or nil when it"] [13 1 "// has put its value in the machine's return registers."] [18 1 "// Atom is an argument: a slot, a global or a literal."] [20 13 "// aSlot, aGlobal, aLit"] [54 1 "// scope is a closure's compile-time frame."] [61 2 "// tail: the expression compiled is in its function's tail position, outside every case's scrutinee: no frame of"] [62 2 "// the activation is on the stack there, so a call may reuse the activation's frame (App.tail)"] [64 2 "// atail: the expression is in its activation's tail position (outside every scrutinee), in a function or a thunk:"] [65 2 "// a call or an entry there clears the activation's local slots, dead from then on, so a frame the stack still holds"] [66 2 "// (a thunk evaluated in its own array, an arena's frame) keeps nothing alive (App.clr, Enter.clr); nfree its"] [67 2 "// closure's free variables, which stay (a thunk reverted needs them)"] [90 1 "// bind gives name a fresh slot; the returned func restores the outer binding."] [116 1 "// isVoid reports a binder's representations of none (:v)."] [131 1 "// atom compiles an argument."] [171 3 "// two's complement truncation"] [179 1 "// literal is a literal's value (STG-SPEC §5)."] [249 1 "// staticCon is the one value of a constructor whose fields are all literals (as GHC's static closures: immutable,"] [250 1 "// so one value serves every evaluation), or nil. Not in an image's compilation: its literals may be placeholders."] [272 1 "// rubbish is a LitRubbish of a lifted or unlifted type: never entered."] [275 1 "// literal keys of case alternatives: integers by their 64 bits, floats as themselves."] [284 1 "// compileLambda compiles (closure UPD [FREE...] [BINDER...] EXPR) in a frame of its own."] [309 1 "// freeAtoms are a closure's free variables as atoms of the enclosing frame."] [319 1 "// expr compiles an expression. minDouble#'s and maxDouble#'s (and Float#'s) literal operand goes second:"] [320 1 "// GHC's code generator emits minsd reg, [lit], and the operands' order decides a NaN's and a zero's result."] [359 4 "// GHC's code generator puts a literal operand second (minsd reg, [lit]): the order decides"] [360 4 "// a NaN's and a zero's result"] [397 3 "// a literal"] [404 1 "// isTuple reports an unboxed tuple's constructor (returned as several values, STG-SPEC §3)."] [483 1 "// let compiles (let BIND EXPR): closures and constructors allocated in the frame's slots."] [545 1 "// letne compiles join points: their arguments are slots of this frame, a jump assigns them."] [584 2 "// the join points' bodies see each other (rec) and themselves"] [606 2 "// (ffi TARGET CONV SAFETY [ATOM...] REPS)"] [630 1 "// cSymbol is the C function a static target calls: a capi wrapper's name decoded"] [631 1 "// (ghczuwrapperZC23ZC...ZCread is read)."] [641 1 "// zdecode decodes GHC's z-encoding of a name."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[135 25] [327 26] [367 28] [368 43] [381 25] [460 23] [460 31] [539 22] [539 30] [594 24] [594 32] [599 22] [599 30] [634 39] [644 12] [644 24]]} (go/file "compile.go" :imports [



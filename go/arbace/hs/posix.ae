(in-ns 'go.arbace.hs) ^{:go/comments [[16 1 "// The POSIX layer of the libraries' C (HE5, HES11 (a)): unix's, directory's, process's, time's and base's calls that"] [17 1 "// crt's kernel does not emulate (it has no chmod, links, utimes, directory streams, users, processes), over Go's os"] [18 1 "// and syscall packages on the host's files, paths resolved against the program's working directory. Files crt opened"] [19 1 "// are its fds (numbers below hfdBase); the pipes of a spawned process are this file's (hfdBase and above), read,"] [20 1 "// written and closed here, the calls on fds going to the one that owns the number."] [36 14 "// the dirent returned to C"] [59 24 "// stg_sig_install's handlers: STG_SIG_DFL -1, IGN -2, HAN -4, RST -5"] [60 24 "// signals raised, their Haskell handlers not started yet"] [72 1 "// hpath is a path as the host resolves it: relative ones against the program's working directory."] [97 1 "// fail is -1 with errno set from err; ok is 0 for a nil err and fail else."] [123 1 "// strings in guest memory"] [152 2 "// fds this file owns: the others are crt's"] [170 3 "// another thread to run: do not block the machine on an empty pipe (the caller retries on EAGAIN)"] [212 54 "// a pipe"] [220 2 "// paths"] [391 2 "// directory streams"] [452 2 "// the environment"] [473 2 "// identity"] [541 2 "// time"] [608 2 "// signals, terminals, loading, the RTS's leftovers"] [702 2 "// processes: waitpid, the process package's spawn and wait"] [749 2 "// the wait macros"] [807 1 "// hpathAddr is a guest string's address made absolute against the working directory (a copy in the static strings)."] [815 1 "// tmpName replaces the six X's before the last suffix bytes of a mkstemp template."] [866 1 "// the passwd and group databases: /etc/passwd and /etc/group read as musl's getpwnam_r does"] [984 1 "// spawn is process's runInteractiveProcess (cbits/posix/runProcess.c): the child through os/exec, the standard"] [985 1 "// handles -1 a new pipe (the parent's end an fd of this file's), -2 closed, an fd 0, 1 or 2 the program's own."] [1025 4 "// closed: the child gets /dev/null as exec'd with a closed fd would fail its first use"] [1078 2 "// pipe: os.Pipe's two ends as this file's fds (a read that would block lets the other threads run: the reader's"] [1079 2 "// retry on EAGAIN, as with GHC's non-blocking fds)"] [1098 1 "// Signals (rts/posix/Signals.c, in the non-threaded RTS): stg_sig_install registers what a signal does (the Haskell"] [1099 1 "// handler of GHC.Internal.Conc.Signal for STG_SIG_HAN), a signal the program raises for itself (raise, kill of its own"] [1100 1 "// pid) with a Haskell handler is queued, and the scheduler starts a thread running runHandlersPtr for each (startSignalHandlers);"] [1101 1 "// a default or an ignored signal is crt's."] [1135 1 "// startSignals starts a thread for each signal raised: runHandlersPtr info sig."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[132 6] [132 14] [157 24] [355 17] [355 30] [357 48] [370 17] [370 30] [434 33] [440 33] [446 33] [455 50] [468 66] [516 31] [545 20] [562 51] [588 20] [599 20] [602 20] [612 85] [613 87] [628 84] [644 57] [656 110] [667 70] [670 78] [674 77] [675 84] [717 21] [827 18] [827 27] [854 13] [854 25] [857 46] [968 44] [978 44] [1012 12] [1012 19] [1029 32] [1040 23] [1121 29] [1166 50]] :go/trails [[757 65]]} (go/file "posix.go" :imports [



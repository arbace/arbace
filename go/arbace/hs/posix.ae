(in-ns 'go.arbace.hs) ^{:go/comments [[16 1 "// The POSIX layer of the libraries' C (HE5, HES11 (a)): unix's, directory's, process's, time's and base's calls that"] [17 1 "// crt's kernel does not emulate (it has no chmod, links, utimes, directory streams, users, processes), over Go's os"] [18 1 "// and syscall packages on the host's files, paths resolved against the program's working directory. Files crt opened"] [19 1 "// are its fds (numbers below hfdBase); the pipes of a spawned process are this file's (hfdBase and above), read,"] [20 1 "// written and closed here, the calls on fds going to the one that owns the number."] [30 14 "// a pipe's write end (fcntl's F_GETFL says O_WRONLY: fdToHandle's mode)"] [37 14 "// the dirent returned to C"] [60 24 "// stg_sig_install's handlers: STG_SIG_DFL -1, IGN -2, HAN -4, RST -5"] [61 24 "// signals raised, their Haskell handlers not started yet"] [73 1 "// hpath is a path as the host resolves it: relative ones against the program's working directory."] [98 1 "// fail is -1 with errno set from err; ok is 0 for a nil err and fail else."] [124 1 "// strings in guest memory"] [153 2 "// fds this file owns: the others are crt's"] [171 3 "// another thread to run: do not block the machine on an empty pipe (the caller retries on EAGAIN)"] [204 31 "// F_GETFL"] [218 54 "// a pipe"] [228 2 "// paths"] [399 2 "// directory streams"] [460 2 "// the environment"] [481 2 "// identity"] [549 2 "// time"] [616 2 "// signals, terminals, loading, the RTS's leftovers"] [710 2 "// processes: waitpid, the process package's spawn and wait"] [757 2 "// the wait macros"] [815 1 "// hpathAddr is a guest string's address made absolute against the working directory (a copy in the static strings)."] [823 1 "// tmpName replaces the six X's before the last suffix bytes of a mkstemp template."] [874 1 "// the passwd and group databases: /etc/passwd and /etc/group read as musl's getpwnam_r does"] [992 1 "// spawn is process's runInteractiveProcess (cbits/posix/runProcess.c): the child through os/exec, the standard"] [993 1 "// handles -1 a new pipe (the parent's end an fd of this file's), -2 closed, an fd 0, 1 or 2 the program's own."] [1033 4 "// closed: the child gets /dev/null as exec'd with a closed fd would fail its first use"] [1086 2 "// pipe: os.Pipe's two ends as this file's fds (a read that would block lets the other threads run: the reader's"] [1087 2 "// retry on EAGAIN, as with GHC's non-blocking fds)"] [1106 1 "// Signals (rts/posix/Signals.c, in the non-threaded RTS): stg_sig_install registers what a signal does (the Haskell"] [1107 1 "// handler of GHC.Internal.Conc.Signal for STG_SIG_HAN), a signal the program raises for itself (raise, kill of its own"] [1108 1 "// pid) with a Haskell handler is queued, and the scheduler starts a thread running runHandlersPtr for each (startSignalHandlers);"] [1109 1 "// a default or an ignored signal is crt's."] [1143 1 "// startSignals starts a thread for each signal raised: runHandlersPtr info sig."] [1187 1 "// The RTS's functions the libraries name that a program without the event manager, the interpreter's debugger,"] [1188 1 "// backtraces from DWARF or static pointers does not reach: the answers of an RTS built without them (a class otherwise,"] [1189 1 "// survey \"As built: HE5 (write-ahead)\")."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[133 6] [133 14] [158 24] [363 17] [363 30] [365 48] [378 17] [378 30] [442 33] [448 33] [454 33] [463 50] [476 66] [524 31] [553 20] [570 51] [596 20] [607 20] [610 20] [620 85] [621 87] [636 84] [652 57] [664 110] [675 70] [678 78] [682 77] [683 84] [725 21] [835 18] [835 27] [862 13] [862 25] [865 46] [976 44] [986 44] [1020 12] [1020 19] [1037 32] [1048 23] [1129 29] [1174 50]] :go/trails [[765 65]]} (go/file "posix.go" :imports [



(in-ns 'go.arbace.hs) ^{:go/comments [[10 1 "// Loader loads the STG forms of modules as the program first needs a name of theirs (the libraries"] [11 1 "// lazily by module, HES14's image later)."] [14 28 "// unit id → directory of its MODULE.stg.ae"] [21 2 "// the images' directory (image.go), \"\" for none; Images the modules loaded from their images"] [24 2 "// the static pointer table (HES88): each StaticPtr a module's top level binds, by its key's two words"] [26 2 "// the program's CAFs (cafgc.go)"] [30 1 "// Module is a loaded module."] [37 2 "// a module loaded from its image: its bytes, where its code starts, its closures' spans, its strings"] [42 15 "// compiled for an image: string literals and labels as placeholders"] [53 1 "// newLoader indexes the units: each directory of libs (a dump's stg/, its packages as subdirectories,"] [54 1 "// or a package's directory) named by the :unit of its first module's header; prog is unit main's."] [88 2 "// GHC.Internal.Prim's names: the void token and its kin"] [96 1 "// unitOf is the :unit of the first module of directory d."] [133 4 "// an unboxed tuple's worker as a value: only the empty one, a void value"] [151 1 "// globalValue is a global's value, its module loaded."] [160 1 "// force loads a global's module."] [192 1 "// loadDC fills a data constructor's record (its module loaded)."] [217 1 "// load loads the module \"UNIT:MODULE\"."] [273 1 "// loadForms loads a module's forms in three phases: the binders (every top-level name of the module), the"] [274 1 "// objects (closures compiled when first entered, constructors, strings), then the constructors' fields (other"] [275 1 "// modules loaded as their names need, so two modules' constructors may refer to each other)."] [278 2 "// phase 0: the binders"] [314 2 "// phase 1: the objects"] [352 2 "// phase 2: the constructors' fields (other modules loaded as their names need)"] [364 1 "// sptStaticPtr is the constructor of a static form's value; GHC's code generator enters each top-level binding of it"] [365 1 "// in the static pointer table by its key (the module's initializer's hs_spt_insert, GHC.Iface.Tidy.StaticPtrTable)."] [368 1 "// sptEntry enters c in the static pointer table when it is a top-level StaticPtr with its key's two words."] [384 1 "// sptThunk enters a top-level thunk whose value is a StaticPtr of literal key words (a static form whose info"] [385 1 "// CorePrep let-bound: (closure :u [] [] (let ... (con StaticPtr [(word64 W1) (word64 W2) ...])))) in the table."] [423 1 "// sptLoad loads every module of the program (unit main), so the table holds all of its static pointers, as GHC's"] [424 1 "// initializers enter them before main."] [441 1 "// sptLookup is the table's entry for the key at addr (hs_spt_lookup's StgWord64[2]), nil for none."] [447 1 "// compileTop compiles a top-level closure's body when it is first entered."] [476 3 "// (dc DATACON TAG [FIELD-REPS...] [MARK...] WORKER?)"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[81 26] [142 24] [197 27] [209 27] [219 26] [234 39] [235 30] [236 31] [400 28] [408 13] [408 20] [435 19] [450 26] [490 23]]} (go/file "load.go" :imports [



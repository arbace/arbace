(in-ns 'go.arbace.hs) ^{:go/comments [[10 1 "// Loader loads the STG forms of modules as the program first needs a name of theirs (the libraries"] [11 1 "// lazily by module, HES14's image later)."] [14 28 "// unit id → directory of its MODULE.stg.ae"] [21 2 "// the images' directory (image.go), \"\" for none; Images the modules loaded from their images"] [24 2 "// the static pointer table (HES88): each StaticPtr a module's top level binds, by its key's two words"] [28 1 "// Module is a loaded module."] [35 2 "// a module loaded from its image: its bytes, where its code starts, its closures' spans, its strings"] [40 15 "// compiled for an image: string literals and labels as placeholders"] [51 1 "// newLoader indexes the units: each directory of libs (a dump's stg/, its packages as subdirectories,"] [52 1 "// or a package's directory) named by the :unit of its first module's header; prog is unit main's."] [86 2 "// GHC.Internal.Prim's names: the void token and its kin"] [94 1 "// unitOf is the :unit of the first module of directory d."] [131 4 "// an unboxed tuple's worker as a value: only the empty one, a void value"] [149 1 "// globalValue is a global's value, its module loaded."] [158 1 "// force loads a global's module."] [190 1 "// loadDC fills a data constructor's record (its module loaded)."] [215 1 "// load loads the module \"UNIT:MODULE\"."] [271 1 "// loadForms loads a module's forms in three phases: the binders (every top-level name of the module), the"] [272 1 "// objects (closures compiled when first entered, constructors, strings), then the constructors' fields (other"] [273 1 "// modules loaded as their names need, so two modules' constructors may refer to each other)."] [276 2 "// phase 0: the binders"] [312 2 "// phase 1: the objects"] [348 2 "// phase 2: the constructors' fields (other modules loaded as their names need)"] [360 1 "// sptStaticPtr is the constructor of a static form's value; GHC's code generator enters each top-level binding of it"] [361 1 "// in the static pointer table by its key (the module's initializer's hs_spt_insert, GHC.Iface.Tidy.StaticPtrTable)."] [364 1 "// sptEntry enters c in the static pointer table when it is a top-level StaticPtr with its key's two words."] [380 1 "// sptThunk enters a top-level thunk whose value is a StaticPtr of literal key words (a static form whose info"] [381 1 "// CorePrep let-bound: (closure :u [] [] (let ... (con StaticPtr [(word64 W1) (word64 W2) ...])))) in the table."] [419 1 "// sptLoad loads every module of the program (unit main), so the table holds all of its static pointers, as GHC's"] [420 1 "// initializers enter them before main."] [437 1 "// sptLookup is the table's entry for the key at addr (hs_spt_lookup's StgWord64[2]), nil for none."] [443 1 "// compileTop compiles a top-level closure's body when it is first entered."] [470 3 "// (dc DATACON TAG [FIELD-REPS...] [MARK...] WORKER?)"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[79 26] [140 24] [195 27] [207 27] [217 26] [232 39] [233 30] [234 31] [396 28] [404 13] [404 20] [431 19] [446 26] [484 23]]} (go/file "load.go" :imports [



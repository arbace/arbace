^{:go/end 190} (go/method loadDC "loadDC fills a data constructor's record (its module loaded).\n" [^{:tag (* Loader)} ld ^{:tag (* DataCon)} d]
  (when (.-ok d)
    (return))

  (when [mk (moduleOf (.-Name d))] (!= mk "")
    (.load ld mk))

  (when (not (.-ok d))
    (lfail "no data constructor %s" (.-Name d))))



^{:go/end 202} (go/method loadTC [^{:tag (* Loader)} ld ^{:tag (* TyCon)} t]
  (when (.-ok t)
    (return))

  (when [mk (moduleOf (.-Name t))] (!= mk "")
    (.load ld mk))

  (when (not (.-ok t))
    (lfail "no type constructor %s" (.-Name t))))




^{:go/end 237} (go/method load "load loads the module \"UNIT:MODULE\".\n" [^{:tag (* Loader)} ld ^string key]
  (when [(values _ ok) (aget (.-mods ld) key)] ok
    (return))

  (let [i (strings/IndexByte key \:)
      (values unit mod) (values (subslice key _ i) (subslice key (+ i 1)))]
    (when (and (== unit "main") (== mod ":Main"))
      (.load ld "main:Main")
      (aset (.-mods ld) key (aget (.-mods ld) "main:Main"))
      (return))

    (let [(values dir ok) (aget (.-units ld) unit)]
      (when (not ok)
        (lfail "no STG for the unit %s (module %s)" unit mod))

      (let [file (filepath/Join dir (+ mod ".stg.ae"))
          (values src err) (os/ReadFile file)]
        (when (!= err nil)
          (lfail "no STG for the module %s: %v" key err))

        (let [(values forms ^:assign err) (readAll src)]
          (when (!= err nil)
            (lfail "%s: %v" file err))

          (inc! (.-Loaded ld))
          (set! (.-Bytes ld) + (conv int64 (len src)))
          (let [md (addr (lit Module :ld ld :Key key :File file :local (lit (map string (* Global))) :forms (lit (map (* Lambda) List))))]
            (aset (.-mods ld) key md)
            (when (.-Trace (.-m ld))
              (fmt/Fprintf os/Stderr "hsi: load %s (%d bytes)\n" key (len src)))

            (.loadForms md forms)))))))


(go/type pendCon (struct
    ^{:line 240 :tag (* Con)} c
    ^{:line 241 :tag Vec} args))





^{:go/end 329} (go/method loadForms "loadForms loads a module's forms in three phases: the binders (every top-level name of the module), the\nobjects (closures compiled when first entered, constructors, strings), then the constructors' fields (other\nmodules loaded as their names need, so two modules' constructors may refer to each other).\n" [^{:tag (* Module)} md ^{:tag (slice any)} forms]
  (let [ld (.-ld md)]
    ;; phase 0: the binders
    (let-type [bindF (struct
          ^{:line 251 :tag (* Global)} g
          ^{:line 252 :tag List} rhs)]

      (let [^{:tag (slice bindF)} binds (zero (slice bindF))
          ^{:line 255 :tag (slice List)} strs (zero (slice List))
          ^{:line 256} reg ^{:go/end 264} (fn ^{:tag (* Global)} [^any b]
            (let [(values n _) (binderName b)]
              (when (>= (splitName n) 0)
                (return (.global ld n)))

              (let [g (addr (lit Global :Name n))]
                (aset (.-local md) n g)
                ^{:line 263} g)))]

        (range [_ f forms]
          (let [(values h l) (head f)]
            (switch h
              (case ["stg/module"])
              (case ["stg/data"]
                (.loadData md l))
              (case ["string"]
                (reg (aget l 1))
                (set! strs (append strs l)))
              (case ["bind"]
                (set! binds (append binds (lit bindF (reg (aget l 1)) l))))
              (case ["rec"]
                (range [_ x (subslice l 1)]
                  (let [(values _ xl) (head x)]
                    (set! binds (append binds (lit bindF (reg (aget xl 1)) xl))))))

              (default
                (lfail "%s: unknown top-level form %s" (.-Key md) h)))))


        ;; phase 1: the objects
        (range [_ l strs]
          (let [(values n _) (binderName (aget l 1))
              (values s _) (assert string (aget l 2))
              ^{:line 289} g (.global md n)]
            (set! (.-V g) (.staticString (.-m ld) (latin1 s)))
            (set! (.-ok g) true)))

        (let [^{:tag (slice pendCon)} cons (zero (slice pendCon))]
          (range [_ b binds]
            (let [(values rh rl) (head (aget (.-rhs b) 2))]
              (switch rh
                (case ["closure"]
                  (let [(values upd _) (assert Kw (aget rl 1))
                      (values args _) (assert Vec (aget rl 3))
                      ^{:line 300} l (addr (lit Lambda :Name (.-Name (.-g b)) :Upd (aget (conv string upd) 0) :NArgs (len args) :mod md))]
                    (aset (.-forms md) l rl)
                    (if (> (len args) 0)
                      (set! (.-V (.-g b)) (addr (lit Fun :L l)))

                      (set! (.-V (.-g b)) (addr (lit Thunk :L l))))))

                (case ["rcon"]
                  (let [(values dcn _) (assert string (aget rl 1))
                      (values args _) (assert Vec (aget rl 2))
                      ^{:line 310} c (addr (lit Con :DC (.dataCon ld dcn)))]
                    (set! (.-V (.-g b)) c)
                    (when (> (len args) 0)
                      (set! cons (append cons (lit pendCon c args))))))

                (default
                  (lfail "%s: bad right-hand side %s" (.-Key md) rh)))

              (set! (.-ok (.-g b)) true)))

          ;; phase 2: the constructors' fields (other modules loaded as their names need)
          (let [s (addr (lit scope :mod md :vars (lit (map string vinfo))))]
            (range [_ p cons]
              (set! (.-F (.-c p)) (make (slice Value) (len (.-args p))))
              (range [i a (.-args p)]
                (let [at (.atom s a)]
                  (aset (.-F (.-c p)) i (.get at (.-m ld) nil)))))))))))





^{:go/end 341} (go/method compileTop "compileTop compiles a top-level closure's body when it is first entered.\n" [^{:tag (* Loader)} ld ^{:tag (* Lambda)} l]
  (let [md (.-mod l)
      ^{:line 334} f (aget (.-forms md) l)]
    (when (== f nil)
      (lfail "no code for %s" (.-Name l)))

    (let [c (.compileLambda md (.-Name l) f 0)]
      (delete (.-forms md) l)
      (set! (values (.-NSlots l) (.-NFree l) (.-Body l)) (values (.-NSlots c) (.-NFree c) (.-Body c))))))


^{:go/end 374} (go/method loadData [^{:tag (* Module)} md ^List l]
  (let [ld (.-ld md)
      (values tn _) (assert string (aget l 1))
      ^{:line 346} tc (.tyCon ld tn)
      (values dcs _) (assert Vec (aget l 2))]
    (set! (.-Cons tc) nil)
    (range [_ x dcs]
      (let [(values _ dl) (head x)
          ;; (dc DATACON TAG [FIELD-REPS...] [MARK...] WORKER?)
          (values n _) (assert string (aget dl 1))
          ^{:line 353} d (.dataCon ld n)]
        (set! (.-Tag d) (conv int (asInt (aget dl 2))))
        (let [(values reps _) (assert Vec (aget dl 3))
            (values marks _) (assert Vec (aget dl 4))]
          (set! (.-Arity d) 0)
          (range [_ r reps]
            (when (not (isVoid r))
              (inc! (.-Arity d))))


          (set! (.-Strict d) (make (slice bool) (len marks)))
          (range [i mk marks]
            (when [(values k ok) (assert Kw mk)] (and ok (== k "strict"))
              (aset (.-Strict d) i true)))


          (set! (.-TyCon d) tc)
          (set! (.-ok d) true)
          (set! (.-Cons tc) (append (.-Cons tc) d)))))

    (set! (.-ok tc) true)))

(go/type loadError (struct ^string msg))

^{:go/end 34} (go/method Error ^string [^{:tag (* loadError)} e] (.-msg e))

^{:go/end 38} (go/func lfail [^string f & ^{:tag (slice any)} a]
  (panic (addr (lit loadError (fmt/Sprintf f (spread a))))))




^{:go/end 81} (go/func newLoader "newLoader indexes the units: each directory of libs (a dump's stg/, its packages as subdirectories,\nor a package's directory) named by the :unit of its first module's header; prog is unit main's.\n" [^{:tag (* Machine)} m ^{:tag (slice string)} libs ^string prog] :results [(* Loader) error]
  (let [ld (addr ^{:go/breaks [10]} (lit Loader :m m :units (lit (map string string)) :mods (lit (map string (* Module))) :globals (lit (map string (* Global)))
          :dcs (lit (map string (* DataCon))) :tycons (lit (map string (* TyCon)))))
      ^{:line 45 :tag (slice string)} dirs (zero (slice string))]
    (range [_ l libs]
      (let [(values es err) (os/ReadDir l)]
        (when (!= err nil)
          (return nil err))

        (let [has false]
          (range [_ e es]
            (cond (.IsDir e)
              (set! dirs (append dirs (filepath/Join l (.Name e))))
              (strings/HasSuffix (.Name e) ".stg.ae")
              (set! has true)))


          (when has
            (set! dirs (append dirs l))))))


    (range [_ d dirs]
      (let [(values u err) (unitOf d)]
        (when (or (!= err nil) (== u ""))
          (continue))

        (when [(values _ ok) (aget (.-units ld) u)] (not ok)
          (aset (.-units ld) u d))))


    (when (!= prog "")
      (aset (.-units ld) "main" prog))

    ;; GHC.Internal.Prim's names: the void token and its kin
    (range [_ n (lit (slice string) "void#" "realWorld#" "coercionToken#" "proxy#")]
      (aset (.-globals ld) (+ "ghc-internal:GHC.Internal.Prim/" n) (addr (lit Global :Name n :ok true))))

    (aset (.-globals ld) "ghc-internal:GHC.Internal.Prim/nullAddr#" (addr (lit Global :Name "nullAddr#" :ok true :V (conv uint64 0))))
    (return ld nil)))



^{:go/end 113} (go/func unitOf "unitOf is the :unit of the first module of directory d.\n" [^string d] :results [string error]
  (let [(values es err) (os/ReadDir d)]
    (when (!= err nil)
      (return "" err))

    (range [_ e es]
      (when (not (strings/HasSuffix (.Name e) ".stg.ae"))
        (continue))

      (let [(values f err) (os/Open (filepath/Join d (.Name e)))]
        (when (!= err nil)
          (return "" err))

        (let [buf (make (slice byte) 4096)
            (values n _) (.Read f buf)]
          (.Close f)
          (let [s (conv string (subslice buf _ n))
              ^{:line 101} i (strings/Index s ":unit \"")]
            (when (< i 0)
              (return "" nil))

            (set! s (subslice s (+ i 7)))
            (let [j (strings/IndexByte s \")]
              (when (< j 0)
                (return "" nil))

              (return (subslice s _ j) nil))))))

    (return "" nil)))


^{:go/end 126} (go/method global ^{:tag (* Global)} [^{:tag (* Loader)} ld ^string name]
  (let [g (aget (.-globals ld) name)]
    (when (== g nil)
      (set! g (addr (lit Global :Name name :mod (moduleOf name))))
      (when (isTuple name)
        ;; an unboxed tuple's worker as a value: only the empty one, a void value
        (set! (.-ok g) true))

      (aset (.-globals ld) name g))

    ^{:line 125} g))


^{:go/end 136} (go/method global ^{:tag (* Global)} [^{:tag (* Module)} md ^string name]
  (when [g (aget (.-local md) name)] (!= g nil)
    (return g))

  (when (< (splitName name) 0)
    (lfail "%s: unbound name %s" (.-Key md) name))

  (.global (.-ld md) name))



^{:go/end 145} (go/method globalValue "globalValue is a global's value, its module loaded.\n" ^Value [^{:tag (* Loader)} ld ^string name]
  (let [g (.global ld name)]
    (when (not (.-ok g))
      (.force ld g))

    (.-V g)))



^{:go/end 159} (go/method force "force loads a global's module.\n" [^{:tag (* Loader)} ld ^{:tag (* Global)} g]
  (when (.-ok g)
    (return))

  (when (== (.-mod g) "")
    (lfail "unbound global %s" (.-Name g)))

  (.load ld (.-mod g))
  (when (not (.-ok g))
    (lfail "no binding of %s in its module" (.-Name g))))



^{:go/end 168} (go/method dataCon ^{:tag (* DataCon)} [^{:tag (* Loader)} ld ^string name]
  (let [d (aget (.-dcs ld) name)]
    (when (== d nil)
      (set! d (addr (lit DataCon :Name name)))
      (aset (.-dcs ld) name d))

    ^{:line 167} d))


^{:go/end 177} (go/method tyCon ^{:tag (* TyCon)} [^{:tag (* Loader)} ld ^string name]
  (let [t (aget (.-tycons ld) name)]
    (when (== t nil)
      (set! t (addr (lit TyCon :Name name)))
      (aset (.-tycons ld) name t))


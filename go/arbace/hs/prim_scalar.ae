^{:go/end 49} (go/func toI "The scalar representations' Go types (value.go).\n" ^int64 [^Value v]
  (type-switch [x v]
    (case [int64]
      (return x))
    (case [uint64]
      (return (conv int64 x)))
    (case [nil]
      (return 0))
    (case [float64]
      (return (conv int64 (math/Float64bits x))))
    (case [float32]
      (return (conv int64 (math/Float32bits x)))))

  (panic (addr (lit hsFatal (+ "not an integer: " (showShallow v))))))



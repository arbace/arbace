(in-ns 'go.arbace.hs) ^{:go/comments [[9 1 "// Primop is a primop's implementation: f1 one result; fm several (or none: a State# alone); fx one"] [10 1 "// result with the machine; ctl a machine transition (it may push frames, call, block, raise)."] [17 2 "// f2: f1 of two arguments taken as they are (PrimE's fast path: no argument buffer), the same result"] [23 1 "// primcalls are the Cmm functions GHC's libraries call by foreign import prim."] [28 1 "// p2 is p1 of a binary primop with its two-argument form (Primop.f2)."] [42 1 "// The scalar representations' Go types (value.go)."] [110 1 "// sext and zext narrow to a width (8, 16, 32, 64)."] [126 1 "// The scalar primops: Int#, Word#, the narrowings, the sized IntN# and WordN#, Char#, Addr#'s arithmetic,"] [127 1 "// Double#, Float#. Char# compares as a word (GHC's code generator emits an unsigned comparison: chr# of a"] [128 1 "// negative Int# is above every character); minDouble# and maxDouble# are amd64's minsd and maxsd as GHC"] [129 1 "// emits them, the first operand when it is less (greater), else the second, so a NaN or two zeros give the"] [130 1 "// second (and compile.go puts a literal operand second, as GHC's code generator does)."] [132 2 "// Int#"] [207 3 "// the signed high word"] [237 2 "// Word#"] [330 2 "// narrowings"] [338 2 "// the sized integers: IntN# and WordN#"] [429 2 "// Char#: compared as words (GHC's code generator: an unsigned comparison, so chr# of a negative"] [430 2 "// Int# is above every character)"] [438 2 "// Addr# comparisons and arithmetic"] [450 2 "// Double#"] [479 2 "// amd64's minsd and maxsd as GHC's code generator emits them: the first operand when it is less"] [480 2 "// (greater), else the second (a NaN or two zeros give the second)"] [535 2 "// Float#"] [616 1 "// f2i is a float's truncation to Int# as amd64's cvttsd2si: out of range and NaN give minBound."] [624 1 "// decodeDouble is GHC's decodeDouble_Int64#: the mantissa and exponent with x = m * 2^e, m's 53 bits"] [625 1 "// normalised (integer_cbits' __decodeDouble_Int64)."] [635 3 "// denormal: normalise"] [652 1 "// decodeDouble2Int is decodeDouble_2Int#: sign, high and low 32 bits of the mantissa, exponent."] [666 1 "// decodeFloat is decodeFloat_Int#."] [735 1 "// hsBitrev16 is the RTS's hs_bitrev16 as gcc compiled it (rts/bitrev.o of GHC 9.14.1, its 16-bit"] [736 1 "// operations leaving bits 16-31 of the register: GHC does not narrow the C call's result, so a word"] [737 1 "// with bits above 16 gives them back reversed in part)"] [764 1 "// fmaf is x*y + z rounded once to float32, musl 1.2.6's src/math/fmaf.c (review 189, F7): the exact product in"] [765 1 "// double plus z rounded to double, then, when that is a float halfway case it did not hit exactly, nudged one"] [766 1 "// ulp toward the error so the rounding to float32 is the single rounding of the exact result (round to nearest:"] [767 1 "// hsi's only rounding mode). Every product converted, so Go never fuses it."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[135 25] [136 26] [145 25] [146 26] [240 26] [241 27] [250 26] [251 27] [453 27] [454 28] [463 27] [464 28] [538 27] [539 28] [548 27] [549 28] [694 20] [694 31] [706 20] [706 31]]} (go/file "prim_scalar.go" :imports [



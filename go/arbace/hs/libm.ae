    (return (lmU64 (f (lmF64 a))) true))

  (when [(values f ok) (aget libmF name)] ok
    (return (conv uint64 (lmU32 (f (lmF32 (conv uint32 a))))) true))

  (switch name
    (case ["pow"]
      (return (lmU64 (muslPow (lmF64 a) (lmF64 b))) true))
    (case ["atan2"]
      (return (lmU64 (muslAtan2 (lmF64 a) (lmF64 b))) true))
    (case ["powf"]
      (return (conv uint64 (lmU32 (muslPowf (lmF32 (conv uint32 a)) (lmF32 (conv uint32 b))))) true))
    (case ["atan2f"]
      (return (conv uint64 (lmU32 (muslAtan2f (lmF32 (conv uint32 a)) (lmF32 (conv uint32 b))))) true)))

  (return 0 false))

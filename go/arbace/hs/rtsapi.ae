(in-ns 'go.arbace.hs) ^{:go/comments [[9 1 "// The RTS's C API for Haskell called from C (HES60 (a), doc/haskell/HASKELL-EVAL-SURVEY.md \"As built: HE6's second"] [10 1 "// half\"): the foreign stubs GHC writes for a module's foreign exports and \"wrapper\" imports (bin/hsi stubs-build's"] [11 1 "// stubprobe --stubs, compiled by ci with the program's own C) call rts_lock, rts_mk*, rts_apply, rts_inCall, rts_get*"] [12 1 "// and read ghc_hs_iface's closures and stable_ptr_table; here those are hsi's. A HaskellObj is a word standing for a"] [13 1 "// machine value (hobj: an address of a region no mapping has), a closure label X_closure the stub names (a foreign"] [14 1 "// export's helper, $fstable...) a word for the global it names, and rts_inCall runs the IO action on a thread of its own"] [15 1 "// to its end, the caller's thread suspended in its foreign call (a safe call's semantics, as the non-threaded RTS's)."] [16 1 "// createAdjustor makes a function of ci's text that calls the wrapper's stub with the stable pointer first."] [18 1 "// hobjBase is the region of the HaskellObj words."] [21 1 "// globalRef is a closure label's global, looked up at its first use."] [24 1 "// hobj is the HaskellObj word of v."] [34 1 "// hval is the value of the HaskellObj word a."] [47 1 "// closureGlobal is the global a closure label of a stub names: a foreign export's helper $fstableZC0ZCUNITZCMODZCname"] [48 1 "// (its unit and module in its z-encoded name), else nil."] [55 2 "// \":0:main:Foo:foo\": the counter, the unit, the module, the name"] [62 1 "// hsIface are ghc_hs_iface's closures hsi gives (DerivedConstants.h's OFFSET_HsIface_*), their globals."] [73 1 "// cRTSLabel is the address the C program's undefined object sym gets from the RTS: a closure label's word, ghc_hs_iface's"] [74 1 "// cell (a pointer to its structure), stable_ptr_table's cell; ok false for another."] [89 3 "// spEntry {StgPtr addr} by stable pointer: deRefStablePtr, an inline function of Rts.h, reads it"] [102 1 "// sptStore writes stable pointer i's entry of stable_ptr_table, when the C reads one."] [104 2 "// GHC's stable pointer i is entry i - 1 (StablePtr.h's deRefStablePtr: NULL is no entry)"] [110 1 "// applyE is rts_apply's thunk's code: its first free variable applied to its second."] [119 1 "// inForeign is what a thread is blocked on while a callback it made runs (nested): no exception is delivered to it."] [122 1 "// forceE evaluates a value to its weak head normal form (rts_get*'s argument, rts_eval's result)."] [127 1 "// nested runs e on a thread of its own to its end while the current thread waits in its foreign call; its result."] [131 3 "// the caller is in a foreign call: an exception thrown to it waits for the call's end (accepts), as GHC's"] [155 1 "// namedValue is a global's value, or a nullary constructor's (True, False, (): a name whose occurrence is a constructor's)."] [171 1 "// box is the constructor name's value of one field v."] [182 1 "// unbox is the field of a boxed value (evaluated first)."] [189 3 "// a Bool's constructor: True is the second"] [248 2 "// rts_inCall(Capability **cap, HaskellObj p, HaskellObj *ret) and rts_evalIO: p, an IO action, run to its end"] [251 4 "// rts/RtsAPI.c's rts_lock: a C finalizer may not call back (Foreign.Concurrent's finalizers may)"] [299 2 "// hs_try_putmvar(int capability, HsStablePtr sp): () put into the MVar sp names when it is empty, sp freed (a no-op)"] [318 2 "// createAdjustor(StgStablePtr hptr, StgFunPtr wptr, char *typeString): a function of ci's text calling the wrapper's"] [319 2 "// stub wptr with hptr before its own arguments"] [335 5 "// the stub's original_return_addr parameter (GHC's x86-64 adjustor passes the caller's return address there)"] [341 3 "// a slot of hsi's range taken, so funAddr's next address is past it"]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[40 28] [76 28] [134 41] [149 24] [185 22] [188 22] [260 22] [270 22] [306 23]] :go/trails [[70 55]]} (go/fi
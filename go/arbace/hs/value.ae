^{:go/end 139} (go/func whnf "whnf follows evaluated thunks' indirections.\n" ^Value [^Value v]
  (while true
    (let [(values t ok) (assert (* Thunk) v)]
      (when (or (not ok) (!= (.-L t) nil))
        (return v))

      (set! v (.-Ind t)))))




^{:go/end 156} (go/func show "show is a value for messages.\n" ^string [^Value v]
  (type-switch [x v]
    (case [(* Con)]
      (when (== (len (.-F x)) 0)
        (return (occ (.-Name (.-DC x)))))

      (let [s (+ "(" (occ (.-Name (.-DC x))))]
        (range [_ f (.-F x)]
          (set! s + (+ " " (showShallow f))))

        (return (+ s ")"))))
    (default
      (return (showShallow v)))))



^{:go/end 175} (go/func showShallow ^string [^Value v]
  (type-switch [x v]
    (case [nil]
      (return "void"))
    (case [(* Con)]
      (return (+ (occ (.-Name (.-DC x))) "{..}")))
    (case [(* Fun)]
      (return (+ "<fun " (.-Name (.-L x)) ">")))
    (case [(* PAP)]
      (return (+ "<pap " (.-Name (.-L (.-F x))) ">")))
    (case [(* Thunk)]
      (when (== (.-L x) nil)
        (return (showShallow (.-Ind x))))

      (return (+ "<thunk " (.-Name (.-L x)) " " (conv string (.-Upd (.-L x))) ">"))))

  (fmt/Sprintf "%T(%v)" v v))



^{:go/end 183} (go/func occ "occ is a name's occurrence name.\n" ^string [^string name]
  (when [i (splitName name)] (>= i 0)
    (return (subslice name (+ i 1))))

  ^{:line 182} name)



^{:go/end 203} (go/func splitName "splitName is the index of the '/' that ends an external name's module, or -1 for an internal name.\n" ^int [^string name]
  ^{:go/breaks [[5 202]]} (let [c -1]
    (for [i 0] (< i (len name)) (inc! i)
      (when (== (aget name i) \:)
        (set! c i)
        (break)))


    (when (< c 0)
      (return -1))

    (for [i (+ c 1)] (< i (len name)) (inc! i)
      (when (== (aget name i) \/)
        (return i)))


    -1))



^{:go/breaks [[5 210]] :go/end 211} (go/func moduleOf "moduleOf is an external name's \"UNIT:MODULE\".\n" ^string [^string name]
  (when [i (splitName name)] (>= i 0)
    (return (subslice name _ i)))

  "")

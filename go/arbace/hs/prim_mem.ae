(in-ns 'go.arbace.hs) ^{:go/comments [[9 1 "// The memory primops: byte arrays, Addr#, arrays, MutVar#."] [53 1 "// pin moves an unpinned byte array into crt's space (byteArrayContents# of an unpinned array: GHC's"] [54 1 "// address would be valid until the next GC; hsi's stays valid)."] [69 3 "// byte arrays, indexed by elements"] [83 3 "// byte arrays, indexed by bytes"] [99 3 "// Addr#"] [125 2 "// the Addr# loads must not run as pure primops outside the machine (they read crt's memory, which"] [126 2 "// is the machine's): px already takes the machine."] [218 2 "// atomics on byte arrays (one thread runs at a time: plain operations)"] [263 2 "// atomics on Addr#"] [333 2 "// arrays (boxed; Small the same)"] [386 2 "// MutVar#"] [407 2 "// atomicModifyMutVar2# mv f: the new contents fst (f old), lazily; the result (old, f old)"] [424 1 "// apLam(n) is the code of a thunk applying its first free variable to the n others."] [442 1 "// selLam(i) is the code of a selector thunk: field i of its free variable's constructor."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[40 28] [47 24] [149 16] [149 23] [192 20] [202 13] [202 22] [208 20] [428 19] [446 20]] :go/trails [[36 114]]} (go/file "prim_mem.go" :imports [



        (when (>= i (len f))
          (break))

        (switch (aget f i)
          (case [\s]
            (when (< k (len args))
              (.WriteString b (.cstring m (toW (aget args k)))))

            (inc! k))
          (case [\d \i]
            (when (< k (len args))
              (fmt/Fprintf (addr b) "%d" (toI (aget args k))))

            (inc! k))
          (case [\u]
            (when (< k (len args))
              (fmt/Fprintf (addr b) "%d" (toW (aget args k))))

            (inc! k))
          (case [\%]

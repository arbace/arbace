 free slice."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[48 24] [58 48] [70 26] [343 37] [350 48] [356 27] [370 30] [470 21] [495 31] [504 25] [557 20] [558 23] [585 22]]} (go/file "nodes.go" :imports [



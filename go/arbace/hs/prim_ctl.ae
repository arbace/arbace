        (pc "putMVar#" ^{:go/end 151} (fn [^{:tag (* Machine)} m ^{:tag (slice Value)} a] :results [Expr (slice Value)] (.putMVar m (assert (* MVar) (aget a 0)) (aget a 1) true)))

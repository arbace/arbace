^{:go/breaks [[4 281]] :go/end 282} (go/func comparable ^bool [^Value v]
  (type-switch v
    (case [(* Con) (* Fun) (* PAP) (* Thunk) (* MutVar) (* ByteArray) (* Array) (* MVar) (* TVar) (* Thread) (* Weak)]
      (return true)))

  false)


^{:go/breaks [[4 288]] :go/end 289} (go/func ptrEq ^bool [^Value a ^Value b]
  (when (and (comparable a) (comparable b))
    (return (== a b)))

  false)




^{:go/end 306} (go/method takeMVar "takeMVar takes (or reads) an MVar's value, blocking while it is empty; a woken taker gets the\nputter's value directly (GHC's single wake-up, FIFO).\n" [^{:tag (* Machine)} m ^{:tag (* MVar)} mv ^bool read ^bool block] :results [Expr (slice Value)]
  (when (.-Full mv)
    (let [v (.-V mv)]
      (when (not read)
        (.mvarTaken m mv))

      (.ret1 m v)
      (return nil nil)))

  (let [t (.-cur m)]
    (set! (.-Queue mv) (append (.-Queue mv) t))
    (set! (.-mvRead t) read)
    (.block m mv true)))




^{:go/end 325} (go/method mvarTaken "mvarTaken empties an MVar, a blocked putter's value put in.\n" [^{:tag (* Machine)} m ^{:tag (* MVar)} mv]
  (set! (.-Full mv) false)
  (set! (.-V mv) nil)
  (while (> (len (.-Queue mv)) 0)
    (let [w (aget (.-Queue mv) 0)]
      (when (not (.-mvPut w))
        (break))

      (set! (.-Queue mv) (subslice (.-Queue mv) 1))
      (set! (values (.-V mv) (.-Full mv)) (values (.-mvVal w) true))
      (set! (values (.-mvPut w) (.-mvVal w)) (values false nil))
      (set! (values (.-r w) (.-rs w)) (values nil (lit (slice Value))))
      (.wake m w)
      (return))))




^{:go/end 353} (go/method putMVar "putMVar puts a value, blocking while the MVar is full; readers and the first taker woken.\n" [^{:tag (* Machine)} m ^{:tag (* MVar)} mv ^Value v ^bool block] :results [Expr (slice Value)]
  (when (.-Full mv)
    (let [t (.-cur m)]
      (set! (values (.-mvPut t) (.-mvVal t)) (values true v))
      (set! (.-Queue mv) (append (.-Queue mv) t))
      (return (.block m mv true))))

  (while (> (len (.-Queue mv)) 0)
    (let [w (aget (.-Queue mv) 0)]
      (when (.-mvPut w)
        (break))

      (set! (.-Queue mv) (subslice (.-Queue mv) 1))
      (set! (values (.-r w) (.-rs w)) (values v nil))
      (let [read (.-mvRead w)]
        (set! (.-mvRead w) false)
        (.wake m w)
        (when (not read)
          (.retN m nil)
          (return nil nil)))))


  (set! (values (.-V mv) (.-Full mv)) (values v true))
  (.retN m nil)
  (return nil nil))


^{:go/end 364} (go/method tagOf ^int64 [^{:tag (* Machine)} m ^Value v]
  (let [(values c ok) (assert (* Con) v)]
    (when (not ok)
      (.fatal m (+ "dataToTag# of " (showShallow v))))

    (when (not (.-ok (.-DC c)))
      (.loadDC (.-ld m) (.-DC c)))

    (conv int64 (- (.-Tag (.-DC c)) 1))))


(go/var dttCase (addr (lit CaseE :scrut (addr (lit Lit)) :bslot 0 :kind kPoly :def (addr (lit alt :body (addr (lit dttBody)))))))

(go/type dttBody (struct))

^{:go/end 373} (go/method eval [^{:tag (* dttBody)} e ^{:tag (* Machine)} m ^{:tag (slice Value)} env] :results [Expr (slice Value)]
  (.ret1 m (.tagOf m (aget env 0)))
  (return nil nil))

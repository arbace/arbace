+// --- 3. PSK suites, TLS 1.2
+
+var arbacePSKSuites = []uint16{
+	TLS_PSK_WITH_AES_128_GCM_SHA256,
+	TLS_PSK_WITH_AES_256_GCM_SHA384,
+	TLS_PSK_WITH_CHACHA20_POLY1305_SHA256,
+	TLS_PSK_WITH_AES_128_CBC_SHA,
+	TLS_PSK_WITH_AES_256_CBC_SHA,
+}
+
+func arbacePSK12Configs(suite uint16, hint string, clientKey []byte) (*Config, *Config, *[][]byte, *[]string) {
+	var hints [][]byte
+	var ids []string
+	cc := &Config{
+		InsecureSkipVerify: true,
+		MaxVersion:         VersionTLS12,
+		CipherSuites:       []uint16{suite},
+		PSKClientCallback: func(h []byte) ([]byte, []byte, error) {
+			hints = append(hints, h)
+			return []byte("client-id"), clientKey, nil
+		},
+	}
+	sc := &Config{
+		MaxVersion:      VersionTLS12,
+		CipherSuites:    arbacePSKSuites,
+		PSKIdentityHint: []byte(hint),
+		PSKServerCallback: func(identity []byte) ([]byte, error) {
+			ids = append(ids, string(identity))
+			if string(identity) == "client-id" {
+				return arbacePSKKey, nil
+			}
+			return nil, nil
+		},
+	}
+	return cc, sc, &hints, &ids
+}
+
+func TestArbacePSK12(t *testing.T) {
+	for _, suite := range arbacePSKSuites {
+		for _, hint := range []string{"", "server-hint"} {
+			t.Run(fmt.Sprintf("%s/hint=%q", CipherSuiteName(suite), hint), func(t *testing.T) {
+				cc, sc, hints, ids := arbacePSK12Configs(suite, hint, arbacePSKKey)
+				cli, srv, cliErr, srvErr := arbaceConnect(t, cc, sc)
+				if cliErr != nil || srvErr != nil {
+					t.Fatalf("handshake: client %v, server %v", cliErr, srvErr)
+				}
+				arbaceExchange(t, cli, srv, "psk12")
+				arbaceExchange(t, srv, cli, "psk12 back")
+				st := cli.ConnectionState()
+				if st.Version != VersionTLS12 || st.CipherSuite != suite || len(st.PeerCertificates) != 0 {
+					t.Errorf("version %x, suite %x, %d peer certificates", st.Version, st.CipherSuite, len(st.PeerCertificates))
+				}
+				if len(*hints) != 1 || string((*hints)[0]) != hint || (hint == "") != ((*hints)[0] == nil) {
+					t.Errorf("client callback hints %q, want %q", *hints, hint)
+				}
+				if len(*ids) != 1 || (*ids)[0] != "client-id" {
+					t.Errorf("server callback identities %q", *ids)
+				}
+			})
+		}
+	}
+}
+
+func TestArbacePSK12WrongKey(t *testing.T) {

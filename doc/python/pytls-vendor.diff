+// --- 3. external PSKs, TLS 1.3
+
+var (
+	arbacePSKKey   = bytes.Repeat([]byte{0x42}, 32)
+	arbacePSKOther = bytes.Repeat([]byte{0x24}, 32)
+)
+
+func arbacePSK13Configs(clientKey []byte, serverKnows string, withCert bool) (*Config, *Config, *[][]byte) {
+	var hints [][]byte
+	var mu sync.Mutex
+	cc := &Config{
+		InsecureSkipVerify: true,
+		MinVersion:         VersionTLS13,
+		PSKClientCallback: func(hint []byte) ([]byte, []byte, error) {
+			mu.Lock()
+			hints = append(hints, hint)
+			mu.Unlock()
+			return []byte("client-id"), clientKey, nil
+		},
+	}
+	sc := &Config{
+		MinVersion: VersionTLS13,
+		PSKServerCallback: func(identity []byte) ([]byte, error) {
+			if string(identity) == serverKnows {
+				return arbacePSKKey, nil
+			}
+			return nil, nil
+		},
+	}
+	if withCert {
+		sc.Certificates = []Certificate{arbaceGetPKIVal().server}
+	}
+	return cc, sc, &hints
+}
+
+func arbaceGetPKIVal() *arbacePKI { return arbacePKIVal }
+
+func TestArbacePSK13(t *testing.T) {
+	arbaceGetPKI(t)
+	cc, sc, hints := arbacePSK13Configs(arbacePSKKey, "client-id", false)
+	cli, srv, cliErr, srvErr := arbaceConnect(t, cc, sc)
+	if cliErr != nil || srvErr != nil {
+		t.Fatalf("handshake: client %v, server %v", cliErr, srvErr)
+	}
+	arbaceExchange(t, cli, srv, "psk")
+	arbaceExchange(t, srv, cli, "psk back")
+	for name, st := range map[string]ConnectionState{"client": cli.ConnectionState(), "server": srv.ConnectionState()} {
+		if st.Version != VersionTLS13 || !st.DidResume || len(st.PeerCertificates) != 0 {
+			t.Errorf("%s: version %x, DidResume %v, %d peer certificates", name, st.Version, st.DidResume, len(st.PeerCertificates))
+		}
+		if suite := cipherSuiteTLS13ByID(st.CipherSuite); suite == nil || suite.hash.Size() != 32 {
+			t.Errorf("%s: cipher suite %x", name, st.CipherSuite)
+		}
+	}
+	if len(*hints) != 1 || (*hints)[0] != nil {
+		t.Errorf("client callback hints %q, want one nil", *hints)
+	}
+}
+
+func TestArbacePSK13BadKey(t *testing.T) {
+	arbaceGetPKI(t)
+	cc, sc, _ := arbacePSK13Configs(arbacePSKOther, "client-id", false)
+	_, _, cliErr, srvErr := arbaceConnect(t, cc, sc)
+	arbaceWantErr(t, "server", srvErr, "invalid PSK binder")
+	arbaceWantErr(t, "client", cliErr, "error decrypting message") // decrypt_error
+}
+
+func TestArbacePSK13UnknownIdentity(t *testing.T) {
+	arbaceGetPKI(t)
+	// No certificate to fall back on: the handshake fails.
+	cc, sc, _ := arbacePSK13Configs(arbacePSKKey, "someone-else", false)
+	_, _, cliErr, srvErr := arbaceConnect(t, cc, sc)
+	if cliErr == nil || srvErr == nil {
+		t.Fatalf("handshake: client %v, server %v", cliErr, srvErr)
+	}
+	// With a certificate, a full handshake.
+	cc, sc, _ = arbacePSK13Configs(arbacePSKKey, "someone-else", true)
+	cli, srv, cliErr, srvErr := arbaceConnect(t, cc, sc)
+	if cliErr != nil || srvErr != nil {
+		t.Fatalf("handshake: client %v, server %v", cliErr, srvErr)
+	}
+	arbaceExchange(t, cli, srv, "certificate")
+	if cli.ConnectionState().DidResume || len(cli.ConnectionState().PeerCertificates) != 1 {
+		t.Errorf("not a certificate handshake")
+	}
+}

+// Copyright 2026 The Arbace Authors. Stub replacing a Go-internal package for the
+// vendored copy of crypto/tls (see VENDORED.md).
+
+// Package godebug replaces internal/godebug: every setting has its Go 1.27
+// default, which for crypto/tls's settings (tlsmlkem, tlssecpmlkem, tlssha1,
+// fips140ems, tlsmaxrsasize) is the empty value.
+package godebug
+
+// A Setting is a single setting in the $GODEBUG environment variable.
+type Setting struct{ name string }
+
+// New returns a new Setting for the named $GODEBUG setting.
+func New(name string) *Setting { return &Setting{name: name} }
+
+// Name returns the name of the setting.
+func (s *Setting) Name() string { return s.name }
+
+// Value returns the setting's value: always the default, "".
+func (s *Setting) Value() string { return "" }
+
+// IncNonDefault does nothing: there are no runtime metrics here.
+func (s *Setting) IncNonDefault() {}

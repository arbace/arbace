+// --- 1. key log
+
+func TestArbaceKeyLogTLS13(t *testing.T) {
+	p := arbaceGetPKI(t)
+	var cliLog, srvLog bytes.Buffer
+	cc := arbaceClientConfig(p)
+	cc.KeyLogWriter = &cliLog
+	sc := arbaceServerConfig(p)
+	sc.KeyLogWriter = &srvLog
+	cli, srv, cliErr, srvErr := arbaceConnect(t, cc, sc)
+	if cliErr != nil || srvErr != nil {
+		t.Fatalf("handshake: client %v, server %v", cliErr, srvErr)
+	}
+	arbaceExchange(t, cli, srv, "ping")
+	if v := cli.ConnectionState().Version; v != VersionTLS13 {
+		t.Fatalf("version %x", v)
+	}
+	parse := func(name string, log *bytes.Buffer) map[string]string {
+		lines := strings.Split(strings.TrimSpace(log.String()), "\n")
+		if len(lines) != 5 {
+			t.Fatalf("%s key log: %d lines, want 5:\n%s", name, len(lines), log)
+		}
+		m := map[string]string{}
+		for _, l := range lines {
+			f := strings.Fields(l)
+			if len(f) != 3 {
+				t.Fatalf("%s key log line %q", name, l)
+			}
+			m[f[0]] = f[1] + " " + f[2]
+		}
+		for _, label := range []string{"CLIENT_HANDSHAKE_TRAFFIC_SECRET", "SERVER_HANDSHAKE_TRAFFIC_SECRET",
+			"CLIENT_TRAFFIC_SECRET_0", "SERVER_TRAFFIC_SECRET_0", "EXPORTER_SECRET"} {
+			if m[label] == "" {
+				t.Fatalf("%s key log lacks %s:\n%s", name, label, log)
+			}
+		}
+		return m
+	}
+	cm, sm := parse("client", &cliLog), parse("server", &srvLog)
+	for k, v := range cm {
+		if sm[k] != v {
+			t.Errorf("%s: client %s, server %s", k, v, sm[k])
+		}
+	}
+	// The exporter secret is the one ExportKeyingMaterial uses: RFC 8446,
+	// Section 7.5, recomputed from the logged secret.
+	var secret []byte
+	fmt.Sscanf(strings.Fields(cm["EXPORTER_SECRET"])[1], "%x", &secret)
+	suite := cipherSuiteTLS13ByID(cli.ConnectionState().CipherSuite)
+	derived := tls13.ExpandLabel(suite.hash.New, secret, "EXPERIMENTAL arbace", suite.hash.New().Sum(nil), suite.hash.Size())
+	h := suite.hash.New()
+	h.Write([]byte("ctx"))
+	want := tls13.ExpandLabel(suite.hash.New, derived, "exporter", h.Sum(nil), 16)
+	cst := cli.ConnectionState()
+	got, err := cst.ExportKeyingMaterial("EXPERIMENTAL arbace", []byte("ctx"), 16)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(got, want) {
+		t.Errorf("exporter from the logged secret %x, ExportKeyingMaterial %x", want, got)
+	}
+}

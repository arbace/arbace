+}
+
+// --- 4. alerts from the verification callbacks
+
+func TestArbaceCallbackAlerts(t *testing.T) {
+	p := arbaceGetPKI(t)
+	for _, vers := range []uint16{VersionTLS12, VersionTLS13} {
+		t.Run(VersionName(vers), func(t *testing.T) {
+			// The client's VerifyPeerCertificate.
+			cc, sc := arbaceClientConfig(p), arbaceServerConfig(p)
+			cc.MaxVersion = vers
+			cc.VerifyPeerCertificate = func([][]byte, [][]*x509.Certificate) error {
+				return fmt.Errorf("arbace: no: %w", AlertError(alertUnknownCA))
+			}
+			_, _, cliErr, srvErr := arbaceConnect(t, cc, sc)
+			arbaceWantErr(t, "client", cliErr, "arbace: no")
+			arbaceWantErr(t, "server", srvErr, "unknown certificate authority")
+
+			// The client's VerifyConnection, a plain error: bad_certificate.
+			cc = arbaceClientConfig(p)
+			cc.MaxVersion = vers
+			cc.VerifyConnection = func(ConnectionState) error { return errors.New("arbace: no") }
+			_, _, cliErr, srvErr = arbaceConnect(t, cc, sc)
+			arbaceWantErr(t, "client", cliErr, "arbace: no")
+			arbaceWantErr(t, "server", srvErr, "bad certificate")
+
+			// The server's VerifyConnection.
+			cc = arbaceClientConfig(p)
+			cc.MaxVersion = vers
+			sc = arbaceServerConfig(p)
+			sc.VerifyConnection = func(ConnectionState) error { return AlertError(alertAccessDenied) }
+			cli, _, cliErr, srvErr := arbaceConnect(t, cc, sc)
+			arbaceWantErr(t, "server", srvErr, "access denied")
+			if cliErr == nil { // TLS 1.3: the client learns it on its first read
+				_, cliErr = cli.Read(make([]byte, 1))
+			}
+			arbaceWantErr(t, "client", cliErr, "access denied")
+
+			// The server's VerifyPeerCertificate on a client certificate.
+			cc = arbaceClientConfig(p)
+			cc.MaxVersion = vers
+			cc.Certificates = []Certificate{p.client}
+			sc = arbaceServerConfig(p)
+			sc.ClientAuth = RequireAnyClientCert
+			sc.VerifyPeerCertificate = func([][]byte, [][]*x509.Certificate) error {
+				return AlertError(alertCertificateRevoked)
+			}
+			cli, _, cliErr, srvErr = arbaceConnect(t, cc, sc)
+			arbaceWantErr(t, "server", srvErr, "revoked certificate")
+			if cliErr == nil { // TLS 1.3: the client learns it on its first read
+				_, cliErr = cli.Read(make([]byte, 1))
+			}
+			arbaceWantErr(t, "client", cliErr, "revoked certificate")
+		})
+	}
+}
+
+func TestArbaceUnknownIssuerAlert(t *testing.T) {
+	p := arbaceGetPKI(t)
+	cc, sc := arbaceClientConfig(p), arbaceServerConfig(p)
+	cc.RootCAs = p.otherRoots
+	_, _, cliErr, srvErr := arbaceConnect(t, cc, sc)
+	arbaceWantErr(t, "client", cliErr, "certificate signed by unknown authority")
+	arbaceWantErr(t, "server", srvErr, "unknown certificate authority")
+}
+
+// The deferred request: PostHandshakeClientAuth replaces ClientAuth in a TLS
+// 1.3 handshake whose client offered PHA, and only then.
+func TestArbacePHADeferred(t *testing.T) {
+	p := arbaceGetPKI(t)
+
+	// RequireAnyClientCert deferred: no certificate in the handshake, then a
+	// missing one is a certificate_required alert.
+	cc, sc := arbacePHAConfigs(p, RequireAnyClientCert, nil)
+	cli, srv, cliErr, srvErr := arbaceConnect(t, cc, sc)
+	if cliErr != nil || srvErr != nil {
+		t.Fatalf("handshake: client %v, server %v", cliErr, srvErr)
+	}
+	if err := srv.RequestClientCertificate(); err != nil {
+		t.Fatal(err)
+	}
+	arbaceExchange(t, srv, cli, "OK")
+	go cli.Write([]byte("X"))
+	_, err := srv.Read(make([]byte, 1))
+	arbaceWantErr(t, "server read", err, "didn't provide a certificate")
+	_, err = cli.Read(make([]byte, 1))
+	arbaceWantErr(t, "client read", err, "certificate required")
+
+	// RequireAnyClientCert deferred, a certificate of an unknown CA: accepted
+	// (no verification), though ClientAuth would verify it.
+	cc, sc = arbacePHAConfigs(p, RequireAnyClientCert, nil)
+	cc.GetClientCertificate = func(*CertificateRequestInfo) (*Certificate, error) { return &p.stranger, nil }
+	cli, srv, cliErr, srvErr = arbaceConnect(t, cc, sc)
+	if cliErr != nil || srvErr != nil {
+		t.Fatalf("handshake: client %v, server %v", cliErr, srvErr)
+	}
+	if n := len(srv.ConnectionState().PeerCertificates); n != 0 {
+		t.Fatalf("certificate requested in the handshake (%d)", n)
+	}
+	if err := srv.RequestClientCertificate(); err != nil {
+		t.Fatal(err)
+	}
+	arbaceExchange(t, srv, cli, "OK")
+	arbaceExchange(t, cli, srv, "HASCERT")
+	if st := srv.ConnectionState(); len(st.PeerCertificates) != 1 || len(st.VerifiedChains) != 0 {
+		t.Fatalf("%d peer certificates, %d chains", len(st.PeerCertificates), len(st.VerifiedChains))
+	}
+
+	// The client did not offer PHA: ClientAuth applies in the handshake.
+	cc, sc = arbacePHAConfigs(p, RequireAnyClientCert, &p.client)
+	cc.PostHandshakeAuth = false
+	_, srv, cliErr, srvErr = arbaceConnect(t, cc, sc)
+	if cliErr != nil || srvErr != nil {
+		t.Fatalf("handshake: client %v, server %v", cliErr, srvErr)
+	}
+	if st := srv.ConnectionState(); len(st.PeerCertificates) != 1 || len(st.VerifiedChains) == 0 {
+		t.Fatalf("no verified certificate in the handshake")
+	}
+
+	// PostHandshakeClientAuth NoClientCert: the handshake requests the
+	// certificate (ClientAuth), and a post-handshake request still works,
+	// under ClientAuth.
+	cc, sc = arbacePHAConfigs(p, NoClientCert, &p.client)
+	cli, srv, cliErr, srvErr = arbaceConnect(t, cc, sc)
+	if cliErr != nil || srvErr != nil {
+		t.Fatalf("handshake: client %v, server %v", cliErr, srvErr)
+	}
+	if n := len(srv.ConnectionState().PeerCertificates); n != 1 {
+		t.Fatalf("%d peer certificates after the handshake", n)
+	}
+	if err := srv.RequestClientCertificate(); err != nil {
+		t.Fatal(err)
+	}
+	arbaceExchange(t, srv, cli, "OK")
+	arbaceExchange(t, cli, srv, "AGAIN")
+	if st := srv.ConnectionState(); len(st.PeerCertificates) != 1 || len(st.VerifiedChains) == 0 {
+		t.Fatalf("no verified certificate after the request")
+	}
+}

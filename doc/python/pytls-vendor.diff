+// --- 2. post-handshake authentication
+
+func arbacePHAConfigs(p *arbacePKI, auth ClientAuthType, clientCert *Certificate) (*Config, *Config) {
+	cc := arbaceClientConfig(p)
+	cc.PostHandshakeAuth = true
+	if clientCert != nil {
+		cc.Certificates = []Certificate{*clientCert}
+	}
+	sc := arbaceServerConfig(p)
+	sc.PostHandshakeClientAuth = auth
+	sc.ClientAuth = RequireAndVerifyClientCert // deferred: not applied in TLS 1.3
+	sc.ClientCAs = p.roots
+	return cc, sc
+}
+
+func TestArbacePHARequired(t *testing.T) {
+	p := arbaceGetPKI(t)
+	cc, sc := arbacePHAConfigs(p, RequireAndVerifyClientCert, &p.client)
+	cli, srv, cliErr, srvErr := arbaceConnect(t, cc, sc)
+	if cliErr != nil || srvErr != nil {
+		t.Fatalf("handshake: client %v, server %v", cliErr, srvErr)
+	}
+	if n := len(srv.ConnectionState().PeerCertificates); n != 0 {
+		t.Fatalf("a certificate was requested during the handshake (%d)", n)
+	}
+	for round := range 2 {
+		if err := srv.RequestClientCertificate(); err != nil {
+			t.Fatal(err)
+		}
+		if err := srv.RequestClientCertificate(); err != ErrPostHandshakeAuthPending {
+			t.Fatalf("second request: %v", err)
+		}
+		arbaceExchange(t, srv, cli, "OK")      // the client answers in Read
+		arbaceExchange(t, cli, srv, "HASCERT") // the server processes it in Read
+		st := srv.ConnectionState()
+		if len(st.PeerCertificates) != 1 || st.PeerCertificates[0].Subject.CommonName != "client.test" {
+			t.Fatalf("round %d: peer certificates %v", round, st.PeerCertificates)
+		}
+		if len(st.VerifiedChains) == 0 {
+			t.Fatalf("round %d: no verified chains", round)
+		}
+	}
+	if len(cli.ConnectionState().PeerCertificates) == 0 {
+		t.Fatal("client lost the server's certificates")
+	}
+}
+
+func TestArbacePHAOptionalNoCert(t *testing.T) {
+	p := arbaceGetPKI(t)
+	cc, sc := arbacePHAConfigs(p, VerifyClientCertIfGiven, nil)
+	cli, srv, cliErr, srvErr := arbaceConnect(t, cc, sc)
+	if cliErr != nil || srvErr != nil {
+		t.Fatalf("handshake: client %v, server %v", cliErr, srvErr)
+	}
+	if err := srv.RequestClientCertificate(); err != nil {
+		t.Fatal(err)
+	}
+	arbaceExchange(t, srv, cli, "OK")
+	arbaceExchange(t, cli, srv, "NOCERT")
+	if n := len(srv.ConnectionState().PeerCertificates); n != 0 {
+		t.Fatalf("%d peer certificates", n)
+	}
+}
+
+func TestArbacePHARequiredNoCert(t *testing.T) {
+	p := arbaceGetPKI(t)
+	cc, sc := arbacePHAConfigs(p, RequireAndVerifyClientCert, nil)
+	cli, srv, cliErr, srvErr := arbaceConnect(t, cc, sc)
+	if cliErr != nil || srvErr != nil {
+		t.Fatalf("handshake: client %v, server %v", cliErr, srvErr)
+	}
+	if err := srv.RequestClientCertificate(); err != nil {
+		t.Fatal(err)
+	}
+	arbaceExchange(t, srv, cli, "OK")
+	go cli.Write([]byte("HASCERT"))
+	_, err := srv.Read(make([]byte, 16))
+	arbaceWantErr(t, "server read", err, "didn't provide a certificate")
+	_, err = cli.Read(make([]byte, 16))
+	arbaceWantErr(t, "client read", err, "certificate required")
+}
+
+func TestArbacePHAUnknownCA(t *testing.T) {
+	p := arbaceGetPKI(t)
+	cc, sc := arbacePHAConfigs(p, RequireAndVerifyClientCert, nil)
+	// Certificates would be filtered by the CertificateRequest's CA names.
+	cc.GetClientCertificate = func(*CertificateRequestInfo) (*Certificate, error) { return &p.stranger, nil }
+	cli, srv, cliErr, srvErr := arbaceConnect(t, cc, sc)
+	if cliErr != nil || srvErr != nil {
+		t.Fatalf("handshake: client %v, server %v", cliErr, srvErr)
+	}
+	if err := srv.RequestClientCertificate(); err != nil {
+		t.Fatal(err)
+	}
+	arbaceExchange(t, srv, cli, "OK")
+	go cli.Write([]byte("HASCERT"))
+	_, err := srv.Read(make([]byte, 16))
+	arbaceWantErr(t, "server read", err, "certificate signed by unknown authority")
+	_, err = cli.Read(make([]byte, 16))
+	arbaceWantErr(t, "client read", err, "unknown certificate authority")
+}
+
+func TestArbacePHANotOffered(t *testing.T) {
+	p := arbaceGetPKI(t)
+	cc, sc := arbacePHAConfigs(p, RequireAndVerifyClientCert, &p.client)
+	cc.PostHandshakeAuth = false
+	if err := Server(nil, sc).RequestClientCertificate(); err != ErrPostHandshakeAuthHandshake {
+		t.Fatalf("before the handshake: %v", err)
+	}
+	cli, srv, cliErr, srvErr := arbaceConnect(t, cc, sc)
+	if cliErr != nil || srvErr != nil {
+		t.Fatalf("handshake: client %v, server %v", cliErr, srvErr)
+	}
+	if err := srv.RequestClientCertificate(); err != ErrPostHandshakeAuthNotOffered {
+		t.Fatalf("got %v", err)
+	}
+	if err := cli.RequestClientCertificate(); err != ErrPostHandshakeAuthClient {
+		t.Fatalf("on the client: %v", err)
+	}
+	// A CertificateRequest sent anyway is an unexpected message.
+	certReq := &certificateRequestMsgTLS13{
+		certificateRequestContext:    []byte{1, 2, 3},
+		supportedSignatureAlgorithms: supportedSignatureAlgorithms(VersionTLS13, VersionTLS13),
+	}
+	if _, err := srv.writeHandshakeRecord(certReq, nil); err != nil {
+		t.Fatal(err)
+	}
+	_, err := cli.Read(make([]byte, 16))
+	arbaceWantErr(t, "client read", err, "unexpected handshake message")
+	_, err = srv.Read(make([]byte, 16))
+	arbaceWantErr(t, "server read", err, "unexpected message")
+}
+
+func TestArbacePHATLS12(t *testing.T) {
+	p := arbaceGetPKI(t)
+	cc, sc := arbacePHAConfigs(p, RequireAndVerifyClientCert, &p.client)
+	cc.MaxVersion = VersionTLS12
+	cli, srv, cliErr, srvErr := arbaceConnect(t, cc, sc)
+	if cliErr != nil || srvErr != nil {
+		t.Fatalf("handshake: client %v, server %v", cliErr, srvErr)
+	}
+	// TLS 1.2 requests the certificate in the handshake, as ClientAuth says.
+	if n := len(srv.ConnectionState().PeerCertificates); n != 1 {
+		t.Fatalf("%d peer certificates in TLS 1.2", n)
+	}
+	if err := srv.RequestClientCertificate(); err != ErrPostHandshakeAuthNotTLS13 {
+		t.Fatalf("got %v", err)
+	}
+	arbaceExchange(t, cli, srv, "still fine")
+}

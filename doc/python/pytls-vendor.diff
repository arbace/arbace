+// arbaceConnect makes a TCP loopback connection and runs both handshakes.
+func arbaceConnect(t *testing.T, clientConfig, serverConfig *Config) (cli, srv *Conn, cliErr, srvErr error) {
+	t.Helper()
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	type accepted struct {
+		c   net.Conn
+		err error
+	}
+	ch := make(chan accepted, 1)
+	go func() {
+		c, err := ln.Accept()
+		ch <- accepted{c, err}
+	}()
+	rawCli, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	a := <-ch
+	if a.err != nil {
+		t.Fatal(a.err)
+	}
+	deadline := time.Now().Add(20 * time.Second)
+	rawCli.SetDeadline(deadline)
+	a.c.SetDeadline(deadline)
+	t.Cleanup(func() { rawCli.Close(); a.c.Close() })
+
+	cli = Client(rawCli, clientConfig)
+	srv = Server(a.c, serverConfig)
+	done := make(chan error, 1)
+	go func() { done <- srv.Handshake() }()
+	cliErr = cli.Handshake()
+	if cliErr != nil {
+		// Let the server see the client's alert, if any.
+		rawCli.Close()
+	}
+	srvErr = <-done
+	return
+}
+
+func arbaceServerConfig(p *arbacePKI) *Config {
+	return &Config{Certificates: []Certificate{p.server}, MinVersion: VersionTLS12}
+}
+
+func arbaceClientConfig(p *arbacePKI) *Config {
+	return &Config{RootCAs: p.roots, ServerName: "example.test", MinVersion: VersionTLS12}
+}
+
+// arbaceExchange writes msg from a and reads it on b.
+func arbaceExchange(t *testing.T, a, b *Conn, msg string) {
+	t.Helper()
+	errc := make(chan error, 1)
+	go func() {
+		_, err := a.Write([]byte(msg))
+		errc <- err
+	}()
+	buf := make([]byte, len(msg))
+	if _, err := io.ReadFull(b, buf); err != nil {
+		t.Fatalf("read %q: %v", msg, err)
+	}
+	if err := <-errc; err != nil {
+		t.Fatalf("write %q: %v", msg, err)
+	}
+	if string(buf) != msg {
+		t.Fatalf("read %q, want %q", buf, msg)
+	}
+}
+
+func arbaceWantErr(t *testing.T, what string, err error, substr string) {
+	t.Helper()
+	if err == nil {
+		t.Fatalf("%s: no error, want one containing %q", what, substr)
+	}
+	if !strings.Contains(err.Error(), substr) {
+		t.Fatalf("%s: error %q, want one containing %q", what, err, substr)
+	}
+}

+// Copyright 2026 The Arbace Authors. Additions to the vendored copy of
+// crypto/tls (see VENDORED.md); BSD-style license as the Go sources.
+
+package tls
+
+import (
+	"arbace/pytls/internal/tls13"
+	"crypto/x509"
+	"errors"
+	"hash"
+)
+
+// writeKeyLogExporterSecret writes the EXPORTER_SECRET line of a TLS 1.3
+// connection to the key log, as OpenSSL does: the exporter_master_secret
+// derived from the transcript through the server Finished.
+func (c *Conn) writeKeyLogExporterSecret(clientRandom []byte, ms *tls13.MasterSecret, transcript hash.Hash) error {
+	if c.config.KeyLogWriter == nil {
+		return nil
+	}
+	secret := tls13.TestingOnlyExporterSecret(ms.ExporterMasterSecret(transcript))
+	return c.config.writeKeyLog(keyLogLabelExporterSecret, clientRandom, secret)
+}
+
+// callbackAlert is the alert sent when VerifyPeerCertificate or
+// VerifyConnection fails: the AlertError the error is or wraps, else
+// bad_certificate.
+func callbackAlert(err error) alert {
+	if a, ok := errors.AsType[AlertError](err); ok {
+		return alert(a)
+	}
+	return alertBadCertificate
+}
+
+// verifyErrorAlert is the alert sent when the peer's chain does not verify,
+// as the server side already chose it for client certificates (and as
+// OpenSSL does): unknown_ca for an unknown issuer, certificate_expired for an
+// expired certificate, else bad_certificate.
+func verifyErrorAlert(err error) alert {
+	if _, ok := errors.AsType[x509.UnknownAuthorityError](err); ok {
+		return alertUnknownCA
+	}
+	if e, ok := errors.AsType[x509.CertificateInvalidError](err); ok && e.Reason == x509.Expired {
+		return alertCertificateExpired
+	}
+	return alertBadCertificate
+}
diff -ruN upstream/pytls/arbace_pha.go vendored/pytls/arbace_pha.go
--- upstream/pytls/arbace_pha.go
+++ vendored/pytls/arbace_pha.go
@@ -0,0 +1,346 @@
+// Copyright 2026 The Arbace Authors. Additions to the vendored copy of
+// crypto/tls (see VENDORED.md); BSD-style license as the Go sources.
+
+package tls
+
+import (
+	"bytes"
+	"context"
+	"crypto"
+	"crypto/hmac"
+	"crypto/rsa"
+	"errors"
+	"hash"
+	"io"
+	"sync"
+)
+
+// TLS 1.3 post-handshake client authentication, RFC 8446, sections 4.2.6,
+// 4.3.2 and 4.6.2.
+
+const extensionPostHandshakeAuth uint16 = 49
+
+// Errors of [Conn.RequestClientCertificate].
+var (
+	// ErrPostHandshakeAuthNotTLS13: the connection is not TLS 1.3
+	// (OpenSSL's WRONG_SSL_VERSION).
+	ErrPostHandshakeAuthNotTLS13 = errors.New("tls: post-handshake authentication requires TLS 1.3")
+	// ErrPostHandshakeAuthNotOffered: the client did not send the
+	// post_handshake_auth extension (OpenSSL's EXTENSION_NOT_RECEIVED).
+	ErrPostHandshakeAuthNotOffered = errors.New("tls: the client did not offer post-handshake authentication")
+	// ErrPostHandshakeAuthPending: a request has not been answered yet
+	// (OpenSSL's REQUEST_PENDING).
+	ErrPostHandshakeAuthPending = errors.New("tls: a post-handshake certificate request is pending")
+	// ErrPostHandshakeAuthHandshake: the handshake has not completed
+	// (OpenSSL's STILL_IN_INIT).
+	ErrPostHandshakeAuthHandshake = errors.New("tls: the handshake has not completed")
+	// ErrPostHandshakeAuthClient: the connection is a client's.
+	ErrPostHandshakeAuthClient = errors.New("tls: post-handshake authentication is requested by servers")
+)
+
+// postHandshakeAuthState is kept on a TLS 1.3 Conn whose client offered
+// post-handshake authentication.
+type postHandshakeAuthState struct {
+	suite *cipherSuiteTLS13
+	// transcript is the handshake's, through the client Finished. Each
+	// exchange starts from a clone of it.
+	transcript hash.Hash
+
+	mu      sync.Mutex
+	pending *pendingCertificateRequest // server: sent, not answered yet
+}
+
+type pendingCertificateRequest struct {
+	context    []byte
+	transcript hash.Hash // through the CertificateRequest
+}
+
+func (c *Conn) savePostHandshakeAuthState(suite *cipherSuiteTLS13, transcript hash.Hash) error {
+	t := cloneHash(transcript, suite.hash)
+	if t == nil {
+		c.sendAlert(alertInternalError)
+		return errors.New("tls: internal error: failed to clone hash")
+	}
+	c.pha = &postHandshakeAuthState{suite: suite, transcript: t}
+	return nil
+}
+
+func (p *postHandshakeAuthState) pendingRequest() bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return p.pending != nil
+}
+
+func (p *postHandshakeAuthState) takePending() *pendingCertificateRequest {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	pend := p.pending
+	p.pending = nil
+	return pend
+}
+
+// rawHandshakeMessage keeps the bytes of the last handshake message read, as
+// a transcriptHash.
+type rawHandshakeMessage []byte
+
+func (r *rawHandshakeMessage) Write(b []byte) (int, error) {
+	*r = append((*r)[:0], b...)
+	return len(b), nil
+}
+
+// RequestClientCertificate sends a TLS 1.3 post-handshake CertificateRequest
+// (RFC 8446, Section 4.6.2), as OpenSSL's SSL_verify_client_post_handshake.
+// The client's answer (Certificate, CertificateVerify, Finished) is read and
+// processed by a later [Conn.Read], which applies Config.PostHandshakeClientAuth
+// (Config.ClientAuth when it is NoClientCert) to it as the handshake would (a missing certificate when one is required is a
+// certificate_required alert; verification through ClientCAs,
+// VerifyPeerCertificate and VerifyConnection), updates
+// ConnectionState().PeerCertificates and VerifiedChains, and returns any
+// failure as its error.
+//
+// It fails, sending nothing, on a client, before the handshake, on a
+// connection that is not TLS 1.3, when the client did not offer
+// post-handshake authentication, and while an earlier request is pending. It
+// works whether or not a certificate was received in the handshake.
+func (c *Conn) RequestClientCertificate() error {
+	if c.isClient {
+		return ErrPostHandshakeAuthClient
+	}
+	if !c.isHandshakeComplete.Load() {
+		return ErrPostHandshakeAuthHandshake
+	}
+	if c.vers != VersionTLS13 {
+		return ErrPostHandshakeAuthNotTLS13
+	}
+	p := c.pha
+	if p == nil {
+		return ErrPostHandshakeAuthNotOffered
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.pending != nil {
+		return ErrPostHandshakeAuthPending
+	}
+
+	context := make([]byte, 32)
+	if _, err := io.ReadFull(c.config.rand(), context); err != nil {
+		return err
+	}
+	certReq := &certificateRequestMsgTLS13{
+		certificateRequestContext:        context,
+		supportedSignatureAlgorithms:     supportedSignatureAlgorithms(c.vers, c.vers),
+		supportedSignatureAlgorithmsCert: supportedSignatureAlgorithmsCert(c.vers, c.vers),
+	}
+	if c.config.ClientCAs != nil {
+		certReq.certificateAuthorities = c.config.ClientCAs.Subjects()
+	}
+	transcript := cloneHash(p.transcript, p.suite.hash)
+	if transcript == nil {
+		return errors.New("tls: internal error: failed to clone hash")
+	}
+	if _, err := c.writeHandshakeRecord(certReq, transcript); err != nil {
+		return err
+	}
+	p.pending = &pendingCertificateRequest{context: context, transcript: transcript}
+	return nil
+}
+
+// handlePostHandshakeClientCertificate processes, on a server, the client's
+// answer to RequestClientCertificate, starting with its Certificate message,
+// whose bytes are raw. c.in is locked.
+func (c *Conn) handlePostHandshakeClientCertificate(certMsg *certificateMsgTLS13, raw []byte) error {
+	pend := c.pha.takePending()
+	if pend == nil {
+		c.sendAlert(alertUnexpectedMessage)
+		return c.in.setErrorLocked(errors.New("tls: unexpected post-handshake Certificate"))
+	}
+	c.handshakeMutex.Lock()
+	defer c.handshakeMutex.Unlock()
+	if err := c.processPostHandshakeClientAuth(pend, certMsg, raw); err != nil {
+		return c.in.setErrorLocked(err)
+	}
+	return nil
+}
+
+func (c *Conn) processPostHandshakeClientAuth(pend *pendingCertificateRequest, certMsg *certificateMsgTLS13, raw []byte) error {
+	suite := c.pha.suite
+	if !bytes.Equal(certMsg.requestContext, pend.context) {
+		c.sendAlert(alertIllegalParameter)
+		return errors.New("tls: client answered with a wrong certificate_request_context")
+	}
+	pend.transcript.Write(raw)
+
+	// As serverHandshakeStateTLS13.readClientCertificate.
+	clientAuth := c.config.PostHandshakeClientAuth
+	if clientAuth == NoClientCert {
+		clientAuth = c.config.ClientAuth
+	}
+	if err := c.processCertsFromClientAuth(certMsg.certificate, clientAuth); err != nil {
+		return err
+	}
+	if c.config.VerifyConnection != nil {
+		if err := c.config.VerifyConnection(c.connectionStateLocked()); err != nil {
+			c.sendAlert(callbackAlert(err))
+			return err
+		}
+	}
+
+	if len(certMsg.certificate.Certificate) != 0 {
+		msg, err := c.readHandshake(nil)
+		if err != nil {
+			return err
+		}
+		certVerify, ok := msg.(*certificateVerifyMsg)
+		if !ok {
+			c.sendAlert(alertUnexpectedMessage)
+			return unexpectedMessageError(certVerify, msg)
+		}
+		if !isSupportedSignatureAlgorithm(certVerify.signatureAlgorithm, supportedSignatureAlgorithms(c.vers, c.vers)) ||
+			!isSupportedSignatureAlgorithm(certVerify.signatureAlgorithm, signatureSchemesForPublicKey(c.vers, c.peerCertificates[0].PublicKey)) {
+			c.sendAlert(alertIllegalParameter)
+			return errors.New("tls: client certificate used with invalid signature algorithm")
+		}
+		sigType, sigHash, err := typeAndHashFromSignatureScheme(certVerify.signatureAlgorithm)
+		if err != nil {
+			return c.sendAlert(alertInternalError)
+		}
+		if sigType == signaturePKCS1v15 || sigHash == crypto.SHA1 {
+			return c.sendAlert(alertInternalError)
+		}
+		signed := signedMessage(clientSignatureContext, pend.transcript)
+		if err := verifyHandshakeSignature(sigType, c.peerCertificates[0].PublicKey,
+			sigHash, signed, certVerify.signature); err != nil {
+			c.sendAlert(alertDecryptError)
+			return errors.New("tls: invalid signature by the client certificate: " + err.Error())
+		}
+		c.peerSigAlg = certVerify.signatureAlgorithm
+		if err := transcriptMsg(certVerify, pend.transcript); err != nil {
+			return err
+		}
+	}
+
+	msg, err := c.readHandshake(nil)
+	if err != nil {
+		return err
+	}
+	finished, ok := msg.(*finishedMsg)
+	if !ok {
+		c.sendAlert(alertUnexpectedMessage)
+		return unexpectedMessageError(finished, msg)
+	}
+	// The Finished of a post-handshake exchange is keyed from the current
+	// client_application_traffic_secret (RFC 8446, Section 4.4).
+	expected := suite.finishedHash(c.in.trafficSecret, pend.transcript)
+	if !hmac.Equal(expected, finished.verifyData) {
+		c.sendAlert(alertDecryptError)
+		return errors.New("tls: invalid client finished hash in post-handshake authentication")
+	}
+	return nil
+}
+
+// handlePostHandshakeCertificateRequest answers, on a client that offered
+// post-handshake authentication, a CertificateRequest received after the
+// handshake, whose bytes are raw. c.in is locked.
+func (c *Conn) handlePostHandshakeCertificateRequest(certReq *certificateRequestMsgTLS13, raw []byte) error {
+	if err := c.answerPostHandshakeCertificateRequest(certReq, raw); err != nil {
+		return c.in.setErrorLocked(err)
+	}
+	return nil
+}
+
+func (c *Conn) answerPostHandshakeCertificateRequest(certReq *certificateRequestMsgTLS13, raw []byte) error {
+	p := c.pha
+	transcript := cloneHash(p.transcript, p.suite.hash)
+	if transcript == nil {
+		c.sendAlert(alertInternalError)
+		return errors.New("tls: internal error: failed to clone hash")
+	}
+	transcript.Write(raw)
+
+	cert, err := c.getClientCertificate(&CertificateRequestInfo{
+		AcceptableCAs:    certReq.certificateAuthorities,
+		SignatureSchemes: certReq.supportedSignatureAlgorithms,
+		Version:          c.vers,
+		ctx:              context.Background(),
+	})
+	if err != nil {
+		c.sendAlert(alertInternalError)
+		return err
+	}
+
+	// The messages are built first, then written under c.out's lock.
+	var msgs [][]byte
+	add := func(m handshakeMessage) error {
+		data, err := m.marshal()
+		if err != nil {
+			return err
+		}
+		transcript.Write(data)
+		msgs = append(msgs, data)
+		return nil
+	}
+
+	certMsg := &certificateMsgTLS13{
+		requestContext: certReq.certificateRequestContext,
+		certificate:    *cert,
+		scts:           certReq.scts && len(cert.SignedCertificateTimestamps) > 0,
+		ocspStapling:   certReq.ocspStapling && len(cert.OCSPStaple) > 0,
+	}
+	if err := add(certMsg); err != nil {
+		return err
+	}
+
+	if len(cert.Certificate) != 0 {
+		// As clientHandshakeStateTLS13.sendClientCertificate.
+		certVerifyMsg := &certificateVerifyMsg{hasSignatureAlgorithm: true}
+		certVerifyMsg.signatureAlgorithm, err = selectSignatureScheme(c.vers, cert, certReq.supportedSignatureAlgorithms)
+		if err != nil {
+			c.sendAlert(alertHandshakeFailure)
+			return err
+		}
+		sigType, sigHash, err := typeAndHashFromSignatureScheme(certVerifyMsg.signatureAlgorithm)
+		if err != nil {
+			return c.sendAlert(alertInternalError)
+		}
+		signed := signedMessage(clientSignatureContext, transcript)
+		signOpts := crypto.SignerOpts(sigHash)
+		if sigType == signatureRSAPSS {
+			signOpts = &rsa.PSSOptions{SaltLength: rsa.PSSSaltLengthEqualsHash, Hash: sigHash}
+		}
+		sig, err := crypto.SignMessage(cert.PrivateKey.(crypto.Signer), c.config.rand(), signed, signOpts)
+		if err != nil {
+			c.sendAlert(alertInternalError)
+			return errors.New("tls: failed to sign handshake: " + err.Error())
+		}
+		certVerifyMsg.signature = sig
+		if err := add(certVerifyMsg); err != nil {
+			return err
+		}
+	}
+
+	if err := c.writePostHandshakeAuthFlight(transcript, add, &msgs); err != nil {
+		return err
+	}
+
+	if len(cert.Certificate) != 0 {
+		c.handshakeMutex.Lock()
+		c.localCertificate = cert.Certificate
+		c.handshakeMutex.Unlock()
+	}
+	return nil
+}
+
+func (c *Conn) writePostHandshakeAuthFlight(transcript hash.Hash, add func(handshakeMessage) error, msgs *[][]byte) error {
+	c.out.Lock()
+	defer c.out.Unlock()
+	finished := &finishedMsg{verifyData: c.pha.suite.finishedHash(c.out.trafficSecret, transcript)}
+	if err := add(finished); err != nil {
+		return err
+	}
+	for _, data := range *msgs {
+		if _, err := c.writeRecordLocked(recordTypeHandshake, data); err != nil {
+			return err
+		}
+	}
+	return nil
+}
diff -ruN upstream/pytls/arbace_psk.go vendored/pytls/arbace_psk.go
--- upstream/pytls/arbace_psk.go
+++ vendored/pytls/arbace_psk.go
@@ -0,0 +1,390 @@
+// Copyright 2026 The Arbace Authors. Additions to the vendored copy of
+// crypto/tls (see VENDORED.md); BSD-style license as the Go sources.
+
+package tls
+
+import (
+	"arbace/pytls/internal/cryptobyte"
+	"arbace/pytls/internal/tls13"
+	"crypto"
+	"crypto/hmac"
+	"crypto/x509"
+	"errors"
+	"fmt"
+	"slices"
+)
+
+// Pre-shared keys: TLS 1.3 external PSKs (RFC 8446, Section 4.2.11) and the
+// TLS 1.2 plain PSK key exchange (RFC 4279, with the suites of RFC 5487 and
+// RFC 7905).
+
+// PSK cipher suites (arbace). They are used only when listed in
+// Config.CipherSuites, by a client with Config.PSKClientCallback and a server
+// with Config.PSKServerCallback.
+const (
+	TLS_PSK_WITH_AES_128_CBC_SHA          uint16 = 0x008c
+	TLS_PSK_WITH_AES_256_CBC_SHA          uint16 = 0x008d
+	TLS_PSK_WITH_AES_128_GCM_SHA256       uint16 = 0x00a8
+	TLS_PSK_WITH_AES_256_GCM_SHA384       uint16 = 0x00a9
+	TLS_PSK_WITH_CHACHA20_POLY1305_SHA256 uint16 = 0xccab
+)
+
+// externalPSKSuite is the cipher suite whose hash a TLS 1.3 external PSK is
+// used with, as OpenSSL does for its psk_client_callback.
+const externalPSKSuite = TLS_AES_128_GCM_SHA256
+
+// loadExternalPSK offers the PSK of Config.PSKClientCallback in a TLS 1.3
+// ClientHello. The returned session stands for it in the handshake state.
+func (c *Conn) loadExternalPSK(hello *clientHelloMsg) (
+	session *SessionState, earlySecret *tls13.EarlySecret, binderKey []byte, err error) {
+	if c.config.PSKClientCallback == nil || c.handshakes != 0 || c.quic != nil ||
+		hello.supportedVersions[0] != VersionTLS13 {
+		return nil, nil, nil, nil
+	}
+	suite := cipherSuiteTLS13ByID(externalPSKSuite)
+	if !slices.ContainsFunc(hello.cipherSuites, func(id uint16) bool {
+		s := cipherSuiteTLS13ByID(id)
+		return s != nil && s.hash == suite.hash
+	}) {
+		return nil, nil, nil, nil
+	}
+	identity, key, err := c.config.PSKClientCallback(nil)
+	if err != nil {
+		return nil, nil, nil, err
+	}
+	if len(identity) == 0 || len(key) == 0 {
+		return nil, nil, nil, nil
+	}
+	if len(identity) > 0xffff {
+		return nil, nil, nil, errors.New("tls: PSK identity too long")
+	}
+
+	session = &SessionState{
+		version:     VersionTLS13,
+		isClient:    true,
+		cipherSuite: externalPSKSuite,
+		createdAt:   uint64(c.config.time().Unix()),
+		secret:      key,
+		externalPSK: true,
+	}
+	hello.pskModes = []uint8{pskModeDHE}
+	hello.pskIdentities = []pskIdentity{{label: identity}} // obfuscated_ticket_age 0
+	hello.pskBinders = [][]byte{make([]byte, suite.hash.Size())}
+
+	earlySecret = tls13.NewEarlySecret(suite.hash.New, key)
+	binderKey = earlySecret.ExternalBinderKey()
+	if err := computeAndUpdatePSK(hello, binderKey, suite.hash.New(), suite.finishedHash); err != nil {
+		return nil, nil, nil, err
+	}
+	return session, earlySecret, binderKey, nil
+}
+
+// checkForExternalPSK accepts a client's external PSK found by
+// Config.PSKServerCallback. done reports whether one was accepted.
+func (hs *serverHandshakeStateTLS13) checkForExternalPSK() (done bool, err error) {
+	c := hs.c
+	if c.config.PSKServerCallback == nil || c.quic != nil || len(hs.clientHello.pskIdentities) == 0 {
+		return false, nil
+	}
+	if !slices.Contains(hs.clientHello.pskModes, pskModeDHE) {
+		return false, nil
+	}
+	if len(hs.clientHello.pskIdentities) != len(hs.clientHello.pskBinders) {
+		c.sendAlert(alertIllegalParameter)
+		return false, errors.New("tls: invalid or missing PSK binders")
+	}
+	if hs.suite.hash != crypto.SHA256 {
+		// External PSKs are used with SHA-256 (see externalPSKSuite).
+		return false, nil
+	}
+
+	for i, identity := range hs.clientHello.pskIdentities {
+		if i >= maxClientPSKIdentities {
+			break
+		}
+		key, err := c.config.PSKServerCallback(identity.label)
+		if err != nil {
+			c.sendAlert(alertInternalError)
+			return false, err
+		}
+		if len(key) == 0 {
+			continue
+		}
+
+		earlySecret := tls13.NewEarlySecret(hs.suite.hash.New, key)
+		binderKey := earlySecret.ExternalBinderKey()
+		transcript := cloneHash(hs.transcript, hs.suite.hash)
+		if transcript == nil {
+			c.sendAlert(alertInternalError)
+			return false, errors.New("tls: internal error: failed to clone hash")
+		}
+		clientHelloBytes, err := hs.clientHello.marshalWithoutBinders()
+		if err != nil {
+			c.sendAlert(alertInternalError)
+			return false, err
+		}
+		transcript.Write(clientHelloBytes)
+		pskBinder := hs.suite.finishedHash(binderKey, transcript)
+		if !hmac.Equal(hs.clientHello.pskBinders[i], pskBinder) {
+			c.sendAlert(alertDecryptError)
+			return false, errors.New("tls: invalid PSK binder")
+		}
+
+		hs.earlySecret = earlySecret
+		c.didResume = true
+		hs.hello.selectedIdentityPresent = true
+		hs.hello.selectedIdentity = uint16(i)
+		hs.usingPSK = true
+		return true, nil
+	}
+	return false, nil
+}
+
+// pskPreMasterSecret is RFC 4279's premaster secret of the plain PSK key
+// exchange: uint16(N) || N zero bytes || uint16(N) || psk.
+func pskPreMasterSecret(psk []byte) []byte {
+	n := len(psk)
+	pms := make([]byte, 2+n+2+n)
+	pms[0], pms[1] = byte(n>>8), byte(n)
+	pms[2+n], pms[3+n] = byte(n>>8), byte(n)
+	copy(pms[4+n:], psk)
+	return pms
+}
+
+// pskKeyAgreement is the TLS 1.2 plain PSK key exchange, RFC 4279, Section 2.
+type pskKeyAgreement struct {
+	hint []byte // the server's identity hint, nil when it sent none
+}
+
+func pskKA(version uint16) keyAgreement {
+	return &pskKeyAgreement{}
+}
+
+func (ka *pskKeyAgreement) generateServerKeyExchange(config *Config, cert *Certificate, clientHello *clientHelloMsg, hello *serverHelloMsg) (*serverKeyExchangeMsg, error) {
+	hint := config.PSKIdentityHint
+	if len(hint) == 0 {
+		return nil, nil
+	}
+	if len(hint) > 0xffff {
+		return nil, errors.New("tls: PSK identity hint too long")
+	}
+	key := make([]byte, 2+len(hint))
+	key[0], key[1] = byte(len(hint)>>8), byte(len(hint))
+	copy(key[2:], hint)
+	return &serverKeyExchangeMsg{key: key}, nil
+}
+
+func (ka *pskKeyAgreement) processClientKeyExchange(config *Config, cert *Certificate, ckx *clientKeyExchangeMsg, version uint16) ([]byte, error) {
+	s := cryptobyte.String(ckx.ciphertext)
+	var identity []byte
+	if !readUint16LengthPrefixed(&s, &identity) || !s.Empty() {
+		return nil, errClientKeyExchange
+	}
+	if config.PSKServerCallback == nil {
+		return nil, alertInternalError
+	}
+	key, err := config.PSKServerCallback(identity)
+	if err != nil {
+		return nil, err
+	}
+	if len(key) == 0 {
+		return nil, fmt.Errorf("tls: unknown PSK identity %q: %w", identity, alertUnknownPSKIdentity)
+	}
+	return pskPreMasterSecret(key), nil
+}
+
+func (ka *pskKeyAgreement) processServerKeyExchange(config *Config, clientHello *clientHelloMsg, serverHello *serverHelloMsg, cert *x509.Certificate, skx *serverKeyExchangeMsg) error {
+	s := cryptobyte.String(skx.key)
+	var hint []byte
+	if !readUint16LengthPrefixed(&s, &hint) || !s.Empty() {
+		return errServerKeyExchange
+	}
+	if len(hint) > 0 {
+		ka.hint = hint
+	}
+	return nil
+}
+
+func (ka *pskKeyAgreement) generateClientKeyExchange(config *Config, clientHello *clientHelloMsg, cert *x509.Certificate) ([]byte, *clientKeyExchangeMsg, error) {
+	if config.PSKClientCallback == nil {
+		return nil, nil, alertInternalError
+	}
+	identity, key, err := config.PSKClientCallback(ka.hint)
+	if err != nil {
+		return nil, nil, err
+	}
+	if len(key) == 0 {
+		return nil, nil, fmt.Errorf("tls: no PSK for the server: %w", alertHandshakeFailure)
+	}
+	if len(identity) > 0xffff {
+		return nil, nil, errors.New("tls: PSK identity too long")
+	}
+	ckx := &clientKeyExchangeMsg{ciphertext: make([]byte, 2+len(identity))}
+	ckx.ciphertext[0], ckx.ciphertext[1] = byte(len(identity)>>8), byte(len(identity))
+	copy(ckx.ciphertext[2:], identity)
+	return pskPreMasterSecret(key), ckx, nil
+}
+
+// errorAlert is the alert err is or wraps, else def.
+func errorAlert(err error, def alert) alert {
+	if a, ok := errors.AsType[alert](err); ok {
+		return a
+	}
+	return def
+}
+
+// fullHandshake is doFullHandshake, or its PSK variant for a PSK suite.
+func (hs *clientHandshakeState) fullHandshake() error {
+	if hs.suite.flags&suitePSK != 0 {
+		return hs.doFullHandshakePSK()
+	}
+	return hs.doFullHandshake()
+}
+
+// doFullHandshakePSK is doFullHandshake for the PSK suites: no Certificate,
+// an optional ServerKeyExchange with the identity hint, no client
+// certificate, a ClientKeyExchange with the identity (RFC 4279, Section 2).
+func (hs *clientHandshakeState) doFullHandshakePSK() error {
+	c := hs.c
+	ka := hs.suite.ka(c.vers)
+
+	msg, err := c.readHandshake(&hs.finishedHash)
+	if err != nil {
+		return err
+	}
+	if skx, ok := msg.(*serverKeyExchangeMsg); ok {
+		if err := ka.processServerKeyExchange(c.config, hs.hello, hs.serverHello, nil, skx); err != nil {
+			c.sendAlert(alertDecodeError)
+			return err
+		}
+		msg, err = c.readHandshake(&hs.finishedHash)
+		if err != nil {
+			return err
+		}
+	}
+	shd, ok := msg.(*serverHelloDoneMsg)
+	if !ok {
+		c.sendAlert(alertUnexpectedMessage)
+		return unexpectedMessageError(shd, msg)
+	}
+
+	if c.config.VerifyConnection != nil {
+		if err := c.config.VerifyConnection(c.connectionStateLocked()); err != nil {
+			c.sendAlert(callbackAlert(err))
+			return err
+		}
+	}
+
+	preMasterSecret, ckx, err := ka.generateClientKeyExchange(c.config, hs.hello, nil)
+	if err != nil {
+		c.sendAlert(errorAlert(err, alertInternalError))
+		return err
+	}
+	if _, err := hs.c.writeHandshakeRecord(ckx, &hs.finishedHash); err != nil {
+		return err
+	}
+
+	if hs.serverHello.extendedMasterSecret {
+		c.extMasterSecret = true
+		hs.masterSecret = extMasterFromPreMasterSecret(c.vers, hs.suite, preMasterSecret,
+			hs.finishedHash.Sum())
+	} else {
+		hs.masterSecret = masterFromPreMasterSecret(c.vers, hs.suite, preMasterSecret,
+			hs.hello.random, hs.serverHello.random)
+	}
+	if err := c.config.writeKeyLog(keyLogLabelTLS12, hs.hello.random, hs.masterSecret); err != nil {
+		c.sendAlert(alertInternalError)
+		return errors.New("tls: failed to write to key log: " + err.Error())
+	}
+
+	hs.finishedHash.discardHandshakeBuffer()
+	return nil
+}
+
+// fullHandshake is doFullHandshake, or its PSK variant for a PSK suite.
+func (hs *serverHandshakeState) fullHandshake() error {
+	if hs.suite.flags&suitePSK != 0 {
+		return hs.doFullHandshakePSK()
+	}
+	return hs.doFullHandshake()
+}
+
+// doFullHandshakePSK is doFullHandshake for the PSK suites (RFC 4279,
+// Section 2): no Certificate nor CertificateRequest, a ServerKeyExchange only
+// when the server has an identity hint.
+func (hs *serverHandshakeState) doFullHandshakePSK() error {
+	c := hs.c
+
+	if hs.clientHello.serverName != "" {
+		hs.hello.serverNameAck = true
+	}
+	hs.hello.ticketSupported = hs.clientHello.ticketSupported && !c.config.SessionTicketsDisabled
+	hs.hello.cipherSuite = hs.suite.id
+
+	hs.finishedHash = newFinishedHash(hs.c.vers, hs.suite)
+	hs.finishedHash.discardHandshakeBuffer()
+	if err := transcriptMsg(hs.clientHello, &hs.finishedHash); err != nil {
+		return err
+	}
+	if _, err := hs.c.writeHandshakeRecord(hs.hello, &hs.finishedHash); err != nil {
+		return err
+	}
+
+	ka := hs.suite.ka(c.vers)
+	skx, err := ka.generateServerKeyExchange(c.config, hs.cert, hs.clientHello, hs.hello)
+	if err != nil {
+		c.sendAlert(alertInternalError)
+		return err
+	}
+	if skx != nil {
+		if _, err := hs.c.writeHandshakeRecord(skx, &hs.finishedHash); err != nil {
+			return err
+		}
+	}
+	if _, err := hs.c.writeHandshakeRecord(new(serverHelloDoneMsg), &hs.finishedHash); err != nil {
+		return err
+	}
+	if _, err := c.flush(); err != nil {
+		return err
+	}
+
+	msg, err := c.readHandshake(&hs.finishedHash)
+	if err != nil {
+		return err
+	}
+	ckx, ok := msg.(*clientKeyExchangeMsg)
+	if !ok {
+		c.sendAlert(alertUnexpectedMessage)
+		return unexpectedMessageError(ckx, msg)
+	}
+	preMasterSecret, err := ka.processClientKeyExchange(c.config, hs.cert, ckx, c.vers)
+	if err != nil {
+		if err == errClientKeyExchange {
+			c.sendAlert(alertDecodeError)
+		} else {
+			c.sendAlert(errorAlert(err, alertInternalError))
+		}
+		return err
+	}
+
+	if c.config.VerifyConnection != nil {
+		if err := c.config.VerifyConnection(c.connectionStateLocked()); err != nil {
+			c.sendAlert(callbackAlert(err))
+			return err
+		}
+	}
+
+	if hs.hello.extendedMasterSecret {
+		c.extMasterSecret = true
+		hs.masterSecret = extMasterFromPreMasterSecret(c.vers, hs.suite, preMasterSecret,
+			hs.finishedHash.Sum())
+	} else {
+		hs.masterSecret = masterFromPreMasterSecret(c.vers, hs.suite, preMasterSecret,
+			hs.clientHello.random, hs.hello.random)
+	}
+	if err := c.config.writeKeyLog(keyLogLabelTLS12, hs.clientHello.random, hs.masterSecret); err != nil {
+		c.sendAlert(alertInternalError)
+		return err
+	}
+	return nil
+}

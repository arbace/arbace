;; test/nethttp: the net/http corpus (doc/go/NET-HTTP-SURVEY.md, 4.4 and "As built: NH1"). One package main
;; per directory (NAME/main.go) in the module nethttp (go.mod), offline over loopback, a deterministic
;; transcript on standard output (NAME/want.out, gc's run), standard error empty, status 0. Read with the
;; Clojure reader. bin/goi check --corpus nethttp runs it: the gc level and goi's.
;; :group  client, redirects, timeouts, cookies, server, mux, streaming, multipart, httputil, httptrace, http2,
;;         shutdown, concurrency
[
 {:name "client_errors" :group :client :what "url.Error, net.OpError, errors.As and Is, refused connections, bad URLs and schemes"}
 {:name "client_get" :group :client :what "Get and Head, status, headers, body, query"}
 {:name "client_gzip" :group :client :what "transparent gzip and DisableCompression"}
 {:name "client_headers" :group :client :what "request headers: Set, Add, canonical keys, multi-valued response headers"}
 {:name "client_post" :group :client :what "Post, a PUT and a DELETE through NewRequest"}
 {:name "client_postform" :group :client :what "PostForm and the server ParseForm"}
 {:name "client_streaming_body" :group :client :what "a request body streamed through io.Pipe (chunked) against a known length"}
 {:name "client_transport" :group :client :what "Transport keep-alive, DisableKeepAlives, connection counts"}
 {:name "concurrency_many" :group :concurrency :what "200 concurrent requests, 40 at a time, the results checked"}
 {:name "context_disconnect" :group :timeouts :what "the handler learns of a client disconnect through r.Context()"}
 {:name "cookiejar_flow" :group :cookies :what "a cookiejar across requests: path scoping, SetCookies, deletion"}
 {:name "cookiejar_scope" :group :cookies :what "cookiejar domain, host-only, secure, path and expiry rules, no server"}
 {:name "cookies_basic" :group :cookies :what "SetCookie, Cookies, AddCookie, ParseSetCookie, Cookie.String"}
 {:name "dumprequest" :group :httputil :what "DumpRequestOut, DumpRequest, DumpResponse"}
 {:name "fileserver_mapfs" :group :mux :what "FileServerFS over fstest.MapFS: index, listing, redirects, content types"}
 {:name "flusher_assertions" :group :streaming :what "which interfaces a ResponseWriter satisfies: Flusher, Hijacker, ReaderFrom, Pusher, CloseNotifier"}
 {:name "h2_basic" :group :http2 :what "HTTP/2 over TLS with httptest certificate: ALPN, Proto, TLS state, the HTTP/1.1 fallback"}
 {:name "h2_concurrent" :group :http2 :what "60 concurrent streams on one client"}
 {:name "h2_trailers_bodies" :group :http2 :what "HTTP/2 request and response bodies, trailers, Pusher"}
 {:name "h2c_protocols" :group :http2 :what "h2c through Server.Protocols and Transport.Protocols"}
 {:name "hijack" :group :streaming :what "Hijacker: a protocol upgrade and an echo conversation"}
 {:name "httptest_recorder" :group :server :what "httptest.NewRecorder and NewRequest driving a handler directly, no network"}
 {:name "httptrace_events" :group :httptrace :what "ClientTrace events across a new and a reused connection"}
 {:name "listen_dial" :group :server :what "net.Listen and net.Dial, an echo server (the base of everything else)"}
 {:name "maxbytes" :group :server :what "MaxBytesReader and MaxBytesError"}
 {:name "middleware_chain" :group :server :what "middleware chains: ordering, auth, a status-recording ResponseWriter wrapper"}
 {:name "middleware_recover" :group :server :what "a recovering middleware: panics, runtime errors, ErrAbortHandler"}
 {:name "mime_textproto" :group :multipart :what "mime, quotedprintable, textproto and multipart on their own, no network"}
 {:name "multipart_streaming" :group :multipart :what "a streamed multipart body, MultipartReader and NextPart"}
 {:name "multipart_upload" :group :multipart :what "multipart upload: ParseMultipartForm, FormFile, several files"}
 {:name "mux_methods405" :group :mux :what "405 with Allow, HEAD from GET"}
 {:name "mux_patterns" :group :mux :what "ServeMux 1.22 patterns: methods, wildcards, PathValue, {rest...}, {$}, specificity"}
 {:name "mux_precedence" :group :mux :what "ServeMux precedence, subtree redirects, host patterns, conflicts, path cleaning"}
 {:name "mux_stripprefix" :group :mux :what "StripPrefix, nested muxes, NotFoundHandler, RedirectHandler"}
 {:name "redirect_follow" :group :redirects :what "a chain of 301, 302 and 303 with CheckRedirect and Response.Location"}
 {:name "redirect_policy" :group :redirects :what "redirect loops, ErrUseLastResponse, a CheckRedirect error"}
 {:name "request_parsing" :group :server :what "ReadRequest, URL and form parsing, Request.Clone and Write, Response.Write"}
 {:name "responsecontroller" :group :streaming :what "ResponseController: Flush and deadlines, against the recorder"}
 {:name "reverseproxy_errors" :group :httputil :what "ReverseProxy ErrorHandler, the default 502, a truncated upstream body"}
 {:name "reverseproxy_rewrite" :group :httputil :what "ReverseProxy with Rewrite, SetURL, SetXForwarded and ModifyResponse"}
 {:name "servecontent" :group :mux :what "ServeContent: If-Modified-Since, If-None-Match, If-Match, Range, If-Range"}
 {:name "server_closures" :group :server :what "handlers as closures over state"}
 {:name "server_connstate" :group :server :what "Server.ConnState transitions"}
 {:name "server_error_helpers" :group :server :what "http.Error, NotFound, Redirect, WriteHeader, content sniffing, 103 Early Hints"}
 {:name "server_handler_types" :group :server :what "Handler types: values, pointers, wrappers, an int type"}
 {:name "server_listen_serve" :group :server :what "Listen and Serve of an http.Server with a stateful Handler, a key-value API"}
 {:name "server_method_values" :group :server :what "method values and method expressions as HandlerFunc"}
 {:name "server_panic" :group :server :what "a panicking handler, ErrorLog, the server survives"}
 {:name "server_timeouts" :group :timeouts :what "ReadHeaderTimeout and IdleTimeout on a raw connection"}
 {:name "shutdown_deadline" :group :shutdown :what "Shutdown with an expired context, RegisterOnShutdown, Close"}
 {:name "shutdown_graceful" :group :shutdown :what "Shutdown waits for an in-flight request and refuses new ones"}
 {:name "stream_chunked" :group :streaming :what "chunked responses flushed one by one, read incrementally"}
 {:name "stream_largebody" :group :streaming :what "a 300 KB body both ways, hashed"}
 {:name "stream_sse" :group :streaming :what "server-sent events with a ResponseController"}
 {:name "stream_trailers" :group :streaming :what "announced and unannounced trailers (TrailerPrefix)"}
 {:name "timeout_client" :group :timeouts :what "Client.Timeout, url.Error.Timeout, os.IsTimeout"}
 {:name "timeout_context" :group :timeouts :what "context deadline and cancellation, the handler sees the cancel"}
 {:name "timeouthandler" :group :timeouts :what "http.TimeoutHandler"}
 {:name "transport_dialcontext" :group :client :what "Transport.DialContext as a closure over net.Pipe, an in-process server"}
 {:name "transport_roundtripper" :group :client :what "a RoundTripper chain and stub transports, no network"}
]

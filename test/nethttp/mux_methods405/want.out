GET    /thing    200 allow="" "got"
POST   /thing    200 allow="" "posted"
PUT    /thing    405 allow="GET, HEAD, POST" "Method Not Allowed"
PATCH  /thing    405 allow="GET, HEAD, POST" "Method Not Allowed"
DELETE /thing/9  200 allow="" "deleted 9"
GET    /thing/9  405 allow="DELETE" "Method Not Allowed"
GET    /nothing  404 allow="" "404 page not found"

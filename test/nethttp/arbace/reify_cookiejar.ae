;; NH3 (doc/go/NET-HTTP-SURVEY.md, "As built: NH2 (write-ahead)"): an Arbace reify of http.CookieJar (a
;; listed interface once NH2 lists net/http) as the Client's Jar: compiled net/http calls SetCookies with
;; the response's cookies and Cookies before each request; the reify keeps the Go slice it was given, per
;; host, in an atom. Expected output: reify_cookiejar.out, written by hand.
(ns go.nh.reifyjar (:require [arbace.go :as go]))
(go/import [http "net/http"] [httptest "net/http/httptest"] [io "io"] [fmt "fmt"])
(go/func Server ^{:tag (* httptest/Server)} []
  (let [m (http/NewServeMux)]
    (.HandleFunc m "/login" (fn [^{:tag http/ResponseWriter} w ^{:tag (* http/Request)} r]
                              (http/SetCookie w (addr (lit http/Cookie :Name "session" :Value "s42")))
                              (fmt/Fprint w "logged in")))
    (.HandleFunc m "/me" (fn [^{:tag http/ResponseWriter} w ^{:tag (* http/Request)} r]
                           (let [(values c err) (.Cookie r "session")]
                             (if (!= err nil) (fmt/Fprint w "anonymous") (fmt/Fprint w "user " (.-Value c))))))
    (return (httptest/NewServer m))))
(go/func Get ^string [^{:tag http/CookieJar} jar ^string url]
  (let [c (addr (lit http/Client :Jar jar))
        (values resp err) (.Get c url)]
    (when (!= err nil) (return (+ "error: " (.Error err))))
    (let [(values b _) (io/ReadAll (.-Body resp))]
      (.Close (.-Body resp))
      (return (fmt/Sprintf "%d %q" (.-StatusCode resp) (conv string b))))))
(def store (atom {}))
(def calls (atom []))
(def jar (reify go.net.http/CookieJar
           (SetCookies [_ u cookies]
             (swap! calls conj (str "set " (.-Path u)))
             (swap! store assoc (.-Host u) cookies))
           (Cookies [_ u]
             (swap! calls conj (str "get " (.-Path u)))
             (get @store (.-Host u)))))
(def srv (Server))
(println (Get jar (str (.-URL srv) "/me")))
(println (Get jar (str (.-URL srv) "/login")))
(println (Get jar (str (.-URL srv) "/me")))
(.Close srv)
(prn @calls)

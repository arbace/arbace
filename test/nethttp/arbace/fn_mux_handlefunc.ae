;; NH3 (doc/go/NET-HTTP-SURVEY.md, "As built: NH2 (write-ahead)"): Arbace fns registered on a ServeMux by
;; HandleFunc, whose parameter is the unnamed func(ResponseWriter, *Request): each fn adapted to a Go func
;; (adaptArbaceFn), called by the mux on the server's goroutines, with 1.22 patterns, PathValue and 405.
;; Expected output: fn_mux_handlefunc.out, written by hand.
(ns go.nh.fnmux (:require [arbace.go :as go] [go.io]))
(go/import [http "net/http"] [httptest "net/http/httptest"] [io "io"] [fmt "fmt"] [strings "strings"])
(go/func Mux ^{:tag (* http/ServeMux)} [] (return (http/NewServeMux)))
(go/func Route [^{:tag (* http/ServeMux)} m ^string pattern ^{:tag (func [http/ResponseWriter (* http/Request)])} f]
  (.HandleFunc m pattern f))
(go/func Fetch ^string [^{:tag (* http/ServeMux)} m ^string method ^string path]
  (let [srv (httptest/NewServer m)
        (values req _) (http/NewRequest method (+ (.-URL srv) path) nil)
        (values resp err) (.Do http/DefaultClient req)]
    (defer (.Close srv))
    (if (!= err nil) (return (+ "error: " (.Error err))))
    (let [(values b _) (io/ReadAll (.-Body resp))]
      (.Close (.-Body resp))
      (return (fmt/Sprintf "%d %q" (.-StatusCode resp) (strings/TrimSpace (conv string b)))))))
(def m (Mux))
(Route m "GET /items/{id}" (fn [w r] (go.io/WriteString w (str "item " (.PathValue r "id")))))
(Route m "POST /items/" (fn [w r] (.WriteHeader w 201) (go.io/WriteString w "created")))
(Route m "/files/{rest...}" (fn [w r] (go.io/WriteString w (str "file " (.PathValue r "rest")))))
(println (Fetch m "GET" "/items/42"))
(println (Fetch m "POST" "/items/"))
(println (Fetch m "DELETE" "/items/42"))
(println (Fetch m "GET" "/files/a/b/c.txt"))
(println (Fetch m "GET" "/nothing"))

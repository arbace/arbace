;; NH12 (a): an Arbace object as an http.RoundTripper through reify. Like handler_reify.ae: net/http is not a
;; listed package until NH2 (a), and reify takes listed interfaces only (class :reify-unlisted).
(ns go.nh.roundtripper-reify (:require [arbace.go :as go] [go.errors]))
(go/import [http "net/http"] [io "io"] [fmt "fmt"] [strings "strings"])
(go/func Respond ^{:tag (* http/Response)} [^int code ^string body ^{:tag (* http/Request)} req]
  (return (addr (lit http/Response :StatusCode code :Status (fmt/Sprintf "%d %s" code (http/StatusText code))
                     :Proto "HTTP/1.1" :ProtoMajor 1 :ProtoMinor 1 :Header (make http/Header)
                     :Body (io/NopCloser (strings/NewReader body)) :ContentLength (conv int64 (len body))
                     :Request req))))
(go/func Client ^{:tag (* http/Client)} [^{:tag http/RoundTripper} rt] (return (addr (lit http/Client :Transport rt))))
(go/func Get ^string [^{:tag (* http/Client)} c ^string url]
  (let [(values resp err) (.Get c url)]
    (if (!= err nil) (return (+ "error: " (.Error err))))
    (let [(values b _) (io/ReadAll (.-Body resp))]
      (.Close (.-Body resp))
      (return (fmt/Sprintf "%s %q" (.-Status resp) (conv string b))))))
(def calls (atom 0))
(def c (Client (reify go.net.http/RoundTripper
                 (RoundTrip [_ r]
                   (if (= 1 (swap! calls inc))
                     [(Respond 202 (str "reified " (.-Path (.-URL r))) r) nil]
                     [nil (go.errors/New "second call refused")])))))
(println (Get c "http://rt.invalid/one"))
(println (Get c "http://rt.invalid/two"))

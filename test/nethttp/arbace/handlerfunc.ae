;; NH12 (a): an Arbace fn as an http.Handler through http.HandlerFunc. The fn is plain Arbace: it takes the
;; ResponseWriter and the *Request as Go values, calls their methods and compiled io's WriteString.
;; Expected output: handlerfunc.out, written by hand (gc cannot run this program).
(ns go.nh.handlerfunc (:require [arbace.go :as go] [go.io]))
(go/import [http "net/http"] [httptest "net/http/httptest"] [io "io"] [fmt "fmt"])
(go/func Fetch ^string [^{:tag http/Handler} h ^string path]
  (let [srv (httptest/NewServer h)
        (values resp err) (http/Get (+ (.-URL srv) path))]
    (if (!= err nil) (do (.Close srv) (return (+ "error: " (.Error err)))))
    (let [(values b _) (io/ReadAll (.-Body resp))]
      (.Close (.-Body resp))
      (.Close srv)
      (return (fmt/Sprintf "%d [%s] %q" (.-StatusCode resp) (.Get (.-Header resp) "X-Who") (conv string b))))))
;; the parameter's type is the named func type: an Arbace fn passed to it is an http.HandlerFunc
(go/func Serve ^{:tag http/Handler} [^{:tag http/HandlerFunc} f] f)
(println (Fetch (Serve (fn [w r]
                         (.Set (.Header w) "X-Who" "fn")
                         (go.io/WriteString w (str (.-Method r) " " (.-Path (.-URL r)) " q=" (.Get (.Query (.-URL r)) "q")))))
                "/a?q=7"))
(println (Fetch (Serve (fn [w r] (.WriteHeader w 404) (go.io/WriteString w "nope"))) "/missing"))
(let [n (atom 0)
      h (Serve (fn [w r] (go.io/WriteString w (str "call " (swap! n inc)))))]
  (println (Fetch h "/") (Fetch h "/")))

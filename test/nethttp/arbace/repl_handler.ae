;; NH12 (a): a handler defined at the REPL in a go.* namespace: a Go struct type with a ServeHTTP method
;; (interpreted, a Handler of net/http's server), then its method redefined (a new body, the signature
;; kept: the generation of the type stays, the cell keeps) and seen by the next request.
(ns go.nh.replhandler (:require [arbace.go :as go]))
(go/import [http "net/http"] [httptest "net/http/httptest"] [io "io"] [fmt "fmt"])
(go/type Hello (struct ^string greeting))
(go/method ServeHTTP [^{:tag (* Hello)} h ^{:tag http/ResponseWriter} w ^{:tag (* http/Request)} r]
  (fmt/Fprintf w "%s, %s" (.-greeting h) (.-Path (.-URL r))))
(go/func NewHello ^{:tag http/Handler} [^string g] (return (addr (lit Hello g))))
(go/func Fetch ^string [^{:tag http/Handler} h ^string path]
  (let [srv (httptest/NewServer h)
        (values resp err) (http/Get (+ (.-URL srv) path))]
    (if (!= err nil) (do (.Close srv) (return (+ "error: " (.Error err)))))
    (let [(values b _) (io/ReadAll (.-Body resp))]
      (.Close (.-Body resp))
      (.Close srv)
      (return (fmt/Sprintf "%d %q" (.-StatusCode resp) (conv string b))))))
(go/func Describe ^string [^{:tag http/Handler} h] (return (fmt/Sprintf "%T" h)))
(println (Fetch (NewHello "hello") "/a"))
(println (Describe (NewHello "x")))
(go/method ServeHTTP [^{:tag (* Hello)} h ^{:tag http/ResponseWriter} w ^{:tag (* http/Request)} r]
  (fmt/Fprintf w "%s again, %s" (.-greeting h) (.-Path (.-URL r))))
(println (Fetch (NewHello "hello") "/b"))

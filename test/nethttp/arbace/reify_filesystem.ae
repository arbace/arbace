;; NH3 (doc/go/NET-HTTP-SURVEY.md, "As built: NH2 (write-ahead)"): an Arbace reify of http.FileSystem (a
;; listed interface once NH2 lists net/http) served by compiled http.FileServer: Open answers a file of a
;; Go helper's (an http.File over a string) or fs.ErrNotExist; the names asked are kept in an atom.
;; Expected output: reify_filesystem.out, written by hand.
(ns go.nh.reifyfs (:require [arbace.go :as go]))
(go/import [http "net/http"] [httptest "net/http/httptest"] [io "io"] [fmt "fmt"] [fs "io/fs"]
           [fstest "testing/fstest"] [time "time"])
(go/func FileOf [^string name ^string body] :results [^{:tag http/File} f ^error err]
  (let [m (lit fstest/MapFS [name (addr (lit fstest/MapFile :Data (conv (slice byte) body) :ModTime (time/Unix 0 0)))])]
    (return (.Open (http/FS m) (+ "/" name)))))
(go/func NotExist ^error [] (return fs/ErrNotExist))
(go/func Fetch ^string [^{:tag http/FileSystem} hfs ^string path]
  (let [srv (httptest/NewServer (http/FileServer hfs))
        (values resp err) (http/Get (+ (.-URL srv) path))]
    (defer (.Close srv))
    (when (!= err nil) (return (+ "error: " (.Error err))))
    (let [(values b _) (io/ReadAll (.-Body resp))]
      (.Close (.-Body resp))
      (return (fmt/Sprintf "%d %q %s" (.-StatusCode resp) (conv string b) (.Get (.-Header resp) "Content-Type"))))))
(def asked (atom []))
(def files {"/hello.txt" "hello from a reify\n"})
(def hfs (reify go.net.http/FileSystem
           (Open [_ name]
             (swap! asked conj name)
             (if-let [body (get files name)]
               (FileOf (subs name 1) body)
               [nil (NotExist)]))))
(println (Fetch hfs "/hello.txt"))
(println (Fetch hfs "/missing.txt"))
(prn @asked)

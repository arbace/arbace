;; test/nethttp/arbace: NH12 (a)'s set (doc/go/NET-HTTP-SURVEY.md, "As built: NH12 (a), NH18 (c)"): programs gc cannot
;; run, Arbace scripts (NAME.ae) of the executable, loopback only, judged against the output written by hand
;; (NAME.out), standard output byte for byte and status 0. bin/goi check --corpus nethttp --arbace runs them.
;; Read with the Clojure reader.
[
 {:name "fn_concurrent" :group :handler :what "an Arbace fn as http.HandlerFunc under 200 concurrent and 300 sequential requests (NH3)"}
 {:name "fn_mux_handlefunc" :group :handler :what "Arbace fns on a ServeMux by HandleFunc: patterns, PathValue, 405 (NH3)"}
 {:name "handler_reify" :group :handler :what "an Arbace reify of http.Handler served by httptest"}
 {:name "handlerfunc" :group :handler :what "an Arbace fn as http.HandlerFunc: headers, status, query, a closure's state"}
 {:name "handlerfunc_conv" :group :handler :what "an Arbace fn converted to http.HandlerFunc in Go code (conv)"}
 {:name "reify_cookiejar" :group :client :what "an Arbace reify of http.CookieJar as the Client's Jar (NH3)"}
 {:name "reify_filesystem" :group :handler :what "an Arbace reify of http.FileSystem served by FileServer (NH3)"}
 {:name "refused_import" :group :errors :what "net/http/internal/... refused at import, vendor paths, a missing package, httptest accepted"}
 {:name "repl_handler" :group :repl :what "a handler type defined at the REPL, its method redefined between two requests"}
 {:name "repl_server_kept" :group :repl :what "a server started by one Go function and asked by others, the handler redefined between"}
 {:name "roundtripper" :group :roundtripper :what "an Arbace fn as the Client's RoundTripper: responses, a refused request, the requests seen"}
 {:name "roundtripper_reify" :group :roundtripper :what "an Arbace reify of http.RoundTripper"}
]

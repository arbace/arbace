;; NH12 (a): a server started by one Go function and asked by another (the REPL's usual shape: start it,
;; keep it in a var, ask it later, redefine the handler, ask again, close it). goi's server goroutine
;; panics "goi: retyping a *http.connReader (8 bytes) as a io.Reader (16)" on the first request when the
;; server was returned from a Go function and not started and asked in one (NH20; class :server-kept).
(ns go.nh.serverkept (:require [arbace.go :as go]))
(go/import [http "net/http"] [httptest "net/http/httptest"] [io "io"] [fmt "fmt"])
(go/type Hello (struct ^string greeting))
(go/method ServeHTTP [^{:tag (* Hello)} h ^{:tag http/ResponseWriter} w ^{:tag (* http/Request)} r]
  (fmt/Fprintf w "%s, %s" (.-greeting h) (.-Path (.-URL r))))
(go/func Start ^{:tag (* httptest/Server)} [^string g] (return (httptest/NewServer (addr (lit Hello g)))))
(go/func Get ^string [^string url]
  (let [(values resp err) (http/Get url)]
    (if (!= err nil) (return (+ "error: " (.Error err))))
    (let [(values b _) (io/ReadAll (.-Body resp))]
      (.Close (.-Body resp))
      (return (fmt/Sprintf "%d %q" (.-StatusCode resp) (conv string b))))))
(def srv (Start "hello"))
(def url (.-URL srv))
(println (Get (str url "/a")))
(go/method ServeHTTP [^{:tag (* Hello)} h ^{:tag http/ResponseWriter} w ^{:tag (* http/Request)} r]
  (fmt/Fprintf w "%s again, %s" (.-greeting h) (.-Path (.-URL r))))
(println (Get (str url "/b")))
(.Close srv)

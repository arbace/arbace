;; NH12 (a): an Arbace object as an http.Handler through reify. net/http is not a listed package
;; (NH2), and reify takes the interfaces of listed packages only: "reify: http.Handler is not an
;; interface of a listed package" until NH2 (a) lists it (class :reify-unlisted).
(ns go.nh.handler-reify (:require [arbace.go :as go] [go.io]))
(go/import [http "net/http"] [httptest "net/http/httptest"] [io "io"] [fmt "fmt"])
(go/func Fetch ^string [^{:tag http/Handler} h ^string path]
  (let [srv (httptest/NewServer h)
        (values resp err) (http/Get (+ (.-URL srv) path))]
    (if (!= err nil) (do (.Close srv) (return (+ "error: " (.Error err)))))
    (let [(values b _) (io/ReadAll (.-Body resp))]
      (.Close (.-Body resp))
      (.Close srv)
      (return (fmt/Sprintf "%d %q" (.-StatusCode resp) (conv string b))))))
(def hits (atom 0))
(def h (reify go.net.http/Handler
         (ServeHTTP [_ w r] (go.io/WriteString w (str "reified " (swap! hits inc) " " (.-Path (.-URL r)))))))
(println (Fetch h "/x"))
(println (Fetch h "/y"))
(println @hits)

;; NH12 (a): the refused import of survey 4.4: net/http's internal packages are importable by std only (Go's
;; rule), a package of net/http's vendored copy of x/net by its vendor path only, and a package that does not
;; exist at all is an unknown one. The REPL's import! then eval! fail with the reason.
(ns go.nh.refused (:require [arbace.go.repl :as repl]))
(def n (atom 0))
(defn try-import [p]
  (let [ns (symbol (str "go.nh.refused" (swap! n inc)))]
    (repl/import! ns [['x p]])
    (try (repl/eval! [true] {:ns ns}) (str p ": imported")
         (catch Throwable e (str p ": " (re-find #"could not import [^\n]*" (ex-message e)))))))
(doseq [p ["net/http/internal/http2" "net/http/internal/ascii" "net/http/internal" "net/http2"
           "vendor/golang.org/x/net/http/httpguts" "net/http/httptest"]]
  (println (try-import p)))

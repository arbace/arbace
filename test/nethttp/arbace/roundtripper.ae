;; NH12 (a): an Arbace fn as an http.RoundTripper: the client's transport, with no server and no
;; network. The fn takes the *Request and answers [response error] (a Go function of two results
;; is a vector); responses are made by a Go helper (a plain Arbace fn cannot name http.Response).
;; Expected output: roundtripper.out, written by hand.
(ns go.nh.roundtripper (:require [arbace.go :as go] [go.errors]))
(go/import [http "net/http"] [io "io"] [fmt "fmt"] [strings "strings"])
(go/type RTF (func [(* http/Request)] [(* http/Response) error]))
(go/method RoundTrip [^RTF f ^{:tag (* http/Request)} r] :results [^{:tag (* http/Response)} resp ^error err]
  (let [(values a b) (f r)] (return a b)))
(go/func Respond ^{:tag (* http/Response)} [^int code ^string body ^{:tag (* http/Request)} req]
  (return (addr (lit http/Response :StatusCode code :Status (fmt/Sprintf "%d %s" code (http/StatusText code))
                     :Proto "HTTP/1.1" :ProtoMajor 1 :ProtoMinor 1 :Header (make http/Header)
                     :Body (io/NopCloser (strings/NewReader body)) :ContentLength (conv int64 (len body))
                     :Request req))))
(go/func Client ^{:tag (* http/Client)} [^RTF rt] (return (addr (lit http/Client :Transport rt))))
(go/func Get ^string [^{:tag (* http/Client)} c ^string url]
  (let [(values resp err) (.Get c url)]
    (if (!= err nil) (return (+ "error: " (.Error err))))
    (let [(values b _) (io/ReadAll (.-Body resp))]
      (.Close (.-Body resp))
      (return (fmt/Sprintf "%s %q" (.-Status resp) (conv string b))))))
(def seen (atom []))
(def c (Client (fn [r]
                 (swap! seen conj (str (.-Method r) " " (.-Host (.-URL r)) (.-Path (.-URL r)) " " (.Get (.-Header r) "X-Test")))
                 (case (.-Path (.-URL r))
                   "/hello" [(Respond 200 "hello from an fn" r) nil]
                   "/gone"  [(Respond 410 "gone" r) nil]
                   [nil (go.errors/New "boom")]))))
(println (Get c "http://rt.invalid/hello?x=1"))
(println (Get c "http://rt.invalid/gone"))
(println (Get c "http://rt.invalid/fail"))
(prn @seen)

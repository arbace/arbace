;; NH12 (a): the same through a conversion in Go code: a parameter of the unnamed type
;; func(http.ResponseWriter, *http.Request) given an Arbace fn, converted by (conv http/HandlerFunc f).
;; Go's conversion gives an http.HandlerFunc, a Handler; goi gives the Arbace fn back unnamed
;; (%T func(...)), so the server panics "the type func(...) has no method ServeHTTP" (NH19).
(ns go.nh.handlerfunc-conv (:require [arbace.go :as go] [go.io]))
(go/import [http "net/http"] [httptest "net/http/httptest"] [io "io"] [fmt "fmt"])
(go/func Fetch ^string [^{:tag http/Handler} h ^string path]
  (let [srv (httptest/NewServer h)
        (values resp err) (http/Get (+ (.-URL srv) path))]
    (if (!= err nil) (do (.Close srv) (return (+ "error: " (.Error err)))))
    (let [(values b _) (io/ReadAll (.-Body resp))]
      (.Close (.-Body resp))
      (.Close srv)
      (return (fmt/Sprintf "%d %q" (.-StatusCode resp) (conv string b))))))
(go/func FromFn ^{:tag http/Handler} [^{:tag (func [http/ResponseWriter (* http/Request)])} f]
  (let [^{:tag http/Handler} h (conv http/HandlerFunc f)] h))
(go/func TypeOf ^string [^{:tag (func [http/ResponseWriter (* http/Request)])} f]
  (let [^any h (conv http/HandlerFunc f)] (fmt/Sprintf "%T" h)))
(def f (fn [w r] (go.io/WriteString w "converted")))
(println (TypeOf f))
(println (Fetch (FromFn f) "/"))

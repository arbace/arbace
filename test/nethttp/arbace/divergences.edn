;; The non-passes of test/nethttp/arbace (doc/go/NET-HTTP-SURVEY.md, "As built: NH12 (a), NH18 (c)"): classes in
;; test/goi/divergences.edn's format (a program's class is the first whose :match finds "RESULT REASON" and whose
;; :programs, when given, name it; bin/goi divergences --nethttp-arbace checks the reference
;; test/nethttp/arbace/check-linux-amd64.edn against them). Read with the Clojure reader.
[
 {:id :reify-unlisted
  :title "reify of an interface of an unlisted package (net/http)"
  :kind :deferred
  :why "reify takes the interfaces of listed packages (G13); net/http is interpreted from its embedded forms and not in the table, so (reify go.net.http/Handler ...), RoundTripper, CookieJar and FileSystem are refused: reify: http.Handler is not an interface of a listed package. Listing net/http (NH2 (a)) makes them reifiable"
  :decided "NH12 (a); NH2 (a)"
  :programs ["handler_reify" "reify_cookiejar" "reify_filesystem" "roundtripper_reify"]
  :match [#"reify: http\.\w+ is not an interface of a listed package"]}
 {:id :server-kept
  :title "a server returned from a Go function panics in its first request"
  :kind :open
  :why "an httptest.Server started by one Go function and returned (not started and asked in the same one) panics serving its first request: goi: retyping a *http.connReader (8 bytes) as a io.Reader (16), with any handler; NH20"
  :decided "NH12 (a)"
  :programs ["repl_server_kept"]
  :match [#"retyping a \*http\.connReader"]}
]

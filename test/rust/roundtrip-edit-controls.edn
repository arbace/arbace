;; repr/rust's round trips' negative controls (doc/GATE-SURVEY.md, GTS81 (a); doc/rust/SPEC.md §11.3): each control a subject
;; file of the checkout and a candidate made from it (an edit, or another file in its place), judged by the family's own judge,
;; as the round trip judges a printed file against its original: the tree level's (arbace.repr.rust/compare-file over the
;; native reader's .tree and .lines, arbace.repr.rust.native tree) or the text level's (compare-text-file, byte for byte). Every
;; control must fail its judge; one that passes fails bin/repr-rust roundtrip (and bin/repr-rust controls). Each subject is also
;; judged against itself unedited, which must pass. No control is a row of a record. Read with the Clojure reader.
;;   :family   :tree (trees and lines), :text (byte for byte)
;;   :edit     [:replace FROM TO] (the first occurrence), [:insert-line N TEXT] (before line N, 1-based), [:file OTHER] (another
;;             file in the candidate's place)
[{:id "_control/tree/operator" :family :tree :subject "test/rust/sample/shapes.rs" :edition 2024
  :edit [:replace "copied().sum::<f64>() + twice!(1.0)" "copied().sum::<f64>() - twice!(1.0)"]
  :why "a binary operator changed: Binary(Add) against Binary(Sub), the trees differ"}
 {:id "_control/tree/other-file" :family :tree :subject "test/rust/sample/shapes.rs" :edition 2024
  :edit [:file "test/rust/sample/space.rs"]
  :why "another sample in the printed file's place (a case's run against another case's reference): the trees differ"}
 {:id "_control/lines/moved" :family :tree :subject "test/rust/sample/shapes.rs" :edition 2024
  :edit [:insert-line 4 ""]
  :why "a blank line inserted before the first use: the trees equal, the lines of every span after it differ"}
 {:id "_control/tree/literal" :family :tree :subject "test/rust/sample/constructs.rs" :edition 2024
  :edit [:replace "enum E { A = 1," "enum E { A = 2,"]
  :why "a discriminant's literal 1 made 2: the trees differ"}
 {:id "_control/text/space" :family :text :subject "test/rust/sample/shapes.rs" :edition 2024
  :edit [:replace "use std::collections::HashMap;" "use std::collections::HashMap; "]
  :why "a trailing space: the trees and lines equal, the text differs by one byte"}
 {:id "_control/text/comment" :family :text :subject "test/rust/sample/shapes.rs" :edition 2024
  :edit [:replace "/// A shape." "/// A form."]
  :why "a doc comment's words: the text differs"}
 {:id "_control/text/other-file" :family :text :subject "test/rust/sample/attrs.rs" :edition 2024
  :edit [:file "test/rust/sample/space.rs"]
  :why "another sample in the printed file's place: the text differs"}]

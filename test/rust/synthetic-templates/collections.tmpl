use std::collections::{BTreeMap, BTreeSet, BinaryHeap, HashMap, HashSet, VecDeque};
use std::cmp::Reverse;
use std::hint::black_box as bb;
fn main() {
    let mut hm: HashMap<String, Vec<u32>> = HashMap::new();
    for i in 0..bb(20u32) { hm.entry(format!("k{}", i % 4)).or_default().push(i); }
    let mut keys: Vec<_> = hm.keys().cloned().collect(); keys.sort();
    println!("{:?} {}", keys, hm.len());
    let mut items: Vec<_> = hm.iter().map(|(k, v)| (k.clone(), v.iter().sum::<u32>())).collect(); items.sort();
    println!("{:?}", items);
    println!("{:?} {:?}", hm.get("k1").map(|v| v.len()), hm.remove("k9"));
    println!("{} {}", hm.contains_key("k0"), hm.values().map(Vec::len).sum::<usize>());
    let big: HashMap<u64, u64> = (0..bb(1000u64)).map(|i| (i * 7919 % 1009, i)).collect();
    println!("{} {:?} {:?}", big.len(), big.get(&0), big.get(&1008).is_some());
    let mut sorted: Vec<_> = big.iter().filter(|(k, _)| **k < 5).collect(); sorted.sort();
    println!("{:?}", sorted);
    let hs: HashSet<i32> = [1, 2, 3, 4].into_iter().collect();
    let hs2: HashSet<i32> = [3, 4, 5].into_iter().collect();
    let mut inter: Vec<_> = hs.intersection(&hs2).collect(); inter.sort();
    let mut un: Vec<_> = hs.union(&hs2).copied().collect(); un.sort();
    println!("{:?} {:?} {}", inter, un, hs.is_subset(&hs2));
    let mut bm = BTreeMap::new();
    for w in "the quick brown fox jumps over the lazy dog the end".split(' ') { *bm.entry(w).or_insert(0) += 1; }
    println!("{:?}", bm);
    println!("{:?} {:?}", bm.first_key_value(), bm.range("f".."p").map(|(k, _)| *k).collect::<Vec<_>>());
    println!("{:?}", bm.iter().rev().take(2).collect::<Vec<_>>());
    let bs: BTreeSet<_> = [5, 1, 9, 3, 7].into_iter().collect();
    println!("{:?} {:?} {:?}", bs, bs.range(3..8).collect::<Vec<_>>(), bs.iter().next_back());
    let mut dq: VecDeque<i32> = (1..=5).collect();
    dq.rotate_left(2); dq.push_front(0); dq.push_back(99);
    println!("{:?}", dq);
    println!("{:?}", dq.pop_front());
    println!("{:?}", dq.iter().rev().take(2).collect::<Vec<_>>());
    let mut heap = BinaryHeap::new();
    for x in [5, 1, 8, 3, 9, 2] { heap.push(x); }
    println!("{:?} {}", heap.peek(), heap.len());
    let mut out = vec![]; while let Some(x) = heap.pop() { out.push(x); }
    println!("{:?}", out);
    let mut mh = BinaryHeap::new();
    for (p, n) in [(3, "c"), (1, "a"), (2, "b")] { mh.push(Reverse((p, n))); }
    println!("{:?}", mh.into_sorted_vec().iter().map(|Reverse((p, _))| *p).collect::<Vec<_>>());
    let mut v = vec![3, 1, 4, 1, 5, 9, 2, 6, 5, 3];
    v.sort_unstable(); v.dedup();
    println!("{:?} {:?} {:?}", v, v.binary_search(&5), v.binary_search(&7));
    v.retain(|x| x % 2 == 1); v.insert(1, 100); v.swap(0, 2); v.extend_from_slice(&[7, 7]);
    println!("{:?} {:?} {:?}", v, v.split_first(), v.iter().rev().skip(1).next());
    let mut words = vec!["banana", "Apple", "cherry"];
    words.sort_by_key(|w| w.to_lowercase());
    println!("{:?} {:?}", words, words.concat().len());
    let mut m2: HashMap<char, usize> = HashMap::new();
    for c in "mississippi".chars() { *m2.entry(c).or_insert(0) += 1; }
    let mut e: Vec<_> = m2.into_iter().collect(); e.sort_by(|a, b| b.1.cmp(&a.1).then(a.0.cmp(&b.0)));
    println!("{:?}", e);
    let drained: Vec<i32> = { let mut x = vec![1, 2, 3, 4, 5]; x.drain(1..3).collect() };
    println!("{:?} {:?}", drained, vec![1, 2, 3].split_off(1));
}

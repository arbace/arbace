use std::hint::black_box as bb;
macro_rules! row { ($v:expr; $($t:ty),*) => { $( print!("{} ", ($v) as $t); )* println!(); } }
fn main() {
    row!(bb(-1i64); i8, i16, i32, i64, i128, isize, u8, u16, u32, u64, u128, usize);
    row!(bb(255u8); i8, i16, i32, i64, i128, u8, u16, u32, u64, u128, f32, f64);
    row!(bb(65535u16); i8, i16, u8, i32, f32);
    println!("{}", bb(65535u16) as u32 as u8 as char);
    row!(bb(0x1_0000_0001u64); i8, i16, i32, u8, u16, u32, f32, f64);
    row!(bb(i128::MIN); i8, i64, u64, u128, f32, f64);
    row!(bb(u128::MAX); i8, i64, i128, u64, f32, f64);
    row!(bb(-129i32); i8, u8, i16, u16, u64, f32);
    row!(bb(3.99f64); i8, u8, i32, u32, i64, u64, i128, u128, f32);
    row!(bb(-3.99f64); i8, u8, i32, u32, i64, u64, i128, u128, f32);
    row!(bb(1e19f64); i64, u64, i128, u128, f32);
    row!(bb(f64::NAN); i8, u8, i32, u64, i128, f32);
    row!(bb(f64::INFINITY); i8, u8, i32, u64, u128, f32);
    row!(bb(-1e300f64); i32, u32, i64, i128, f32);
    row!(bb(16777217i32); f32, f64);
    row!(bb(u64::MAX); f32, f64, i64);
    row!(bb(1.5f32); f64, i32, u8, u64);
    row!(bb(1e40f64); f32, i64);
    row!(bb(true); i32, u8, i128);
    row!(bb('é'); u8, u32, i16);
    println!("{}", bb(97u8) as char as u32);
    println!("{:?} {:?} {:?}", char::from_u32(bb(0xD800)), char::from(bb(65u8)), u8::try_from(bb(300i32)).is_err());
    println!("{:?} {:?}", i8::try_from(bb(-128i64)), u32::try_from(bb(-1i8)).is_err());
    let p = bb(0x1234u16) as *const u8 as usize;
    println!("{}", p);
    println!("{} {}", bb(-1i32) as u32 as u64, bb(-1i32) as i64 as u64);
    println!("{} {}", bb(200u8) as i8 as i32, bb(-56i8) as u8 as u32);
    println!("{:?}", bb([1.5f32, -0.0]).map(|x| x.to_bits()));
}

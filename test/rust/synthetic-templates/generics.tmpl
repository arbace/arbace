use std::collections::HashMap;
use std::fmt::Debug;
use std::hint::black_box as bb;
use std::marker::PhantomData;
#[derive(Debug, Clone, PartialEq, Eq, Hash, PartialOrd, Ord)]
struct Id<T>(u32, PhantomData<T>);
#[derive(Debug, Default)]
struct Stack<T> { items: Vec<T> }
impl<T: Clone + Debug> Stack<T> {
    fn push(&mut self, t: T) -> &mut Self { self.items.push(t); self }
    fn peek(&self) -> Option<&T> { self.items.last() }
    fn pop(&mut self) -> Option<T> { self.items.pop() }
}
struct Matrix<const R: usize, const C: usize>([[i32; C]; R]);
impl<const R: usize, const C: usize> Matrix<R, C> { fn transpose(&self) -> Matrix<C, R> { let mut o = [[0; R]; C]; for i in 0..R { for j in 0..C { o[j][i] = self.0[i][j]; } } Matrix(o) } }
trait Zero { const ZERO: Self; fn is_zero(&self) -> bool; }
impl Zero for i32 { const ZERO: i32 = 0; fn is_zero(&self) -> bool { *self == 0 } }
impl Zero for f64 { const ZERO: f64 = 0.0; fn is_zero(&self) -> bool { *self == 0.0 } }
fn count_zero<T: Zero>(xs: &[T]) -> usize { xs.iter().filter(|x| x.is_zero()).count() }
fn longest<'a>(a: &'a str, b: &'a str) -> &'a str { if a.len() >= b.len() { a } else { b } }
struct Parser<'a> { src: &'a str, pos: usize }
impl<'a> Parser<'a> { fn word(&mut self) -> Option<&'a str> { let rest = &self.src[self.pos..]; let rest_t = rest.trim_start(); if rest_t.is_empty() { return None; } let start = self.pos + (rest.len() - rest_t.len()); let end = rest_t.find(' ').map(|i| start + i).unwrap_or(self.src.len()); self.pos = end; Some(&self.src[start..end]) } }
fn group_by_len<'a, I: IntoIterator<Item = &'a str>>(it: I) -> Vec<(usize, Vec<&'a str>)> { let mut m: HashMap<usize, Vec<&str>> = HashMap::new(); for s in it { m.entry(s.len()).or_default().push(s); } let mut v: Vec<_> = m.into_iter().collect(); v.sort(); v }
fn apply_n<T, F: Fn(T) -> T>(mut x: T, n: usize, f: F) -> T { for _ in 0..n { x = f(x); } x }
fn pair_up<A: Clone, B>(a: &A, bs: Vec<B>) -> Vec<(A, B)> { bs.into_iter().map(|b| (a.clone(), b)).collect() }
fn main() {
    let mut s: Stack<String> = Stack::default();
    s.push("a".into()).push("b".into()).push(bb("c").into());
    println!("{:?}", s.peek());
    println!("{:?}", s.pop());
    println!("{:?}", s);
    let id: Id<u8> = Id(bb(5), PhantomData);
    println!("{:?} {}", id, id == Id(5, PhantomData));
    let m = Matrix([[1, 2, 3], [4, 5, 6]]);
    println!("{:?}", m.transpose().0);
    println!("{} {}", count_zero(&[0, 1, 0, 2]), count_zero(&[0.0, 1.5]));
    println!("{} {}", <i32 as Zero>::ZERO, f64::ZERO);
    println!("{}", longest("abc", bb("de")));
    let mut p = Parser { src: "  the quick  brown fox", pos: 0 };
    let mut ws = vec![]; while let Some(w) = p.word() { ws.push(w); }
    println!("{:?}", ws);
    println!("{:?}", group_by_len(ws.iter().copied()));
    println!("{} {}", apply_n(1u64, bb(10), |x| x * 3), apply_n(String::from("x"), 3, |s| s.clone() + &s));
    println!("{:?}", pair_up(&"k", vec![1, 2]));
    println!("{}", std::mem::size_of::<Id<u64>>() + std::mem::size_of::<Option<Box<u8>>>() + std::mem::align_of::<u128>());
    println!("{:?} {:?}", std::mem::replace(&mut s.items, vec![]), std::mem::take(&mut s));
    let (a, b) = { let (mut a, mut b) = (bb(1), 2); std::mem::swap(&mut a, &mut b); (a, b) };
    println!("{} {}", a, b);
}

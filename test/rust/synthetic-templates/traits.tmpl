use std::collections::BTreeMap;
use std::fmt::{self, Display};
use std::hint::black_box as bb;
use std::ops::{Add, Index, Mul, Neg};
trait Animal { fn name(&self) -> String; fn legs(&self) -> u32 { 4 } fn describe(&self) -> String { format!("{} has {} legs", self.name(), self.legs()) } }
struct Dog; struct Bird(u8);
impl Animal for Dog { fn name(&self) -> String { "dog".into() } }
impl Animal for Bird { fn name(&self) -> String { format!("bird{}", self.0) } fn legs(&self) -> u32 { 2 } }
trait Named: Display { fn shout(&self) -> String { self.to_string().to_uppercase() } }
impl Named for Dog {}
impl Display for Dog { fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result { write!(f, "good dog") } }
#[derive(Debug, Clone, Copy, PartialEq, Default)]
struct V2 { x: i32, y: i32 }
impl Add for V2 { type Output = V2; fn add(self, o: V2) -> V2 { V2 { x: self.x + o.x, y: self.y + o.y } } }
impl Mul<i32> for V2 { type Output = V2; fn mul(self, k: i32) -> V2 { V2 { x: self.x * k, y: self.y * k } } }
impl Neg for V2 { type Output = V2; fn neg(self) -> V2 { V2 { x: -self.x, y: -self.y } } }
struct Grid(Vec<i32>, usize);
impl Index<(usize, usize)> for Grid { type Output = i32; fn index(&self, (r, c): (usize, usize)) -> &i32 { &self.0[r * self.1 + c] } }
trait Container { type Item; fn items(&self) -> Vec<Self::Item>; fn first(&self) -> Option<Self::Item> { self.items().into_iter().next() } }
impl Container for Grid { type Item = i32; fn items(&self) -> Vec<i32> { self.0.clone() } }
fn total<C: Container<Item = i32>>(c: &C) -> i32 { c.items().iter().sum() }
fn largest<T: PartialOrd + Copy>(xs: &[T]) -> T { let mut m = xs[0]; for &x in xs { if x > m { m = x; } } m }
fn show_all(xs: &[&dyn Animal]) -> Vec<String> { xs.iter().map(|a| a.describe()).collect() }
trait Visitor { fn visit(&mut self, n: u32); }
struct Sum(u32); struct Log(Vec<String>);
impl Visitor for Sum { fn visit(&mut self, n: u32) { self.0 += n; } }
impl Visitor for Log { fn visit(&mut self, n: u32) { self.0.push(format!("v{}", n)); } }
fn walk(v: &mut dyn Visitor) { for i in 1..=bb(4) { v.visit(i); } }
impl<T: Animal + ?Sized> Animal for Box<T> { fn name(&self) -> String { format!("boxed {}", (**self).name()) } }
fn main() {
    let zoo: Vec<Box<dyn Animal>> = vec![Box::new(Dog), Box::new(Bird(bb(3)))];
    for a in &zoo { println!("{}", a.describe()); }
    println!("{:?}", show_all(&[&Dog, &Bird(1)]));
    println!("{} {}", Dog.shout(), zoo[1].name());
    let b: Box<dyn Animal> = Box::new(Dog);
    println!("{}", Animal::name(&b));
    let v = V2 { x: 1, y: 2 } + V2 { x: bb(10), y: 20 } * 2;
    println!("{:?} {:?} {}", v, -v, v == V2::default());
    let g = Grid((0..12).collect(), 4);
    println!("{} {} {:?} {}", g[(1, 2)], g[(2, 3)], g.first(), total(&g));
    println!("{} {} {}", largest(&[3, 9, 2]), largest(&[1.5, 0.2]), largest(&['a', 'z', 'q']));
    let (mut s, mut l) = (Sum(0), Log(vec![]));
    walk(&mut s); walk(&mut l);
    println!("{} {:?}", s.0, l.0);
    let mut m: BTreeMap<String, Box<dyn Fn(i32) -> i32>> = BTreeMap::new();
    m.insert("double".into(), Box::new(|x| x * 2));
    let k = bb(7);
    m.insert("addk".into(), Box::new(move |x| x + k));
    for (name, f) in &m { println!("{} {}", name, f(5)); }
    let anys: Vec<Box<dyn std::any::Any>> = vec![Box::new(5i32), Box::new("str"), Box::new(String::from("owned"))];
    for a in &anys {
        if let Some(i) = a.downcast_ref::<i32>() { println!("i32 {}", i); }
        else if let Some(s) = a.downcast_ref::<&str>() { println!("str {}", s); }
        else { println!("other"); }
    }
}

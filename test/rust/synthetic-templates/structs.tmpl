use std::hint::black_box as bb;
#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Default)]
struct Version { major: u8, minor: u8, patch: u8 }
#[derive(Debug, Clone, PartialEq)]
enum Token { Num(f64), Op(char), LParen, RParen }
#[repr(u8)] #[derive(Debug, Clone, Copy)] enum Color { Red = 1, Green = 5, Blue }
#[repr(C)] struct Packed { a: u8, b: u32, c: u16 }
union U { i: u32, f: f32 }
const LIMIT: usize = 4;
static GREETING: &str = "hi";
static TABLE: [u8; 4] = [1, 2, 4, 8];
fn tokenize(s: &str) -> Vec<Token> {
    let cs: Vec<char> = s.chars().collect(); let mut i = 0; let mut out = vec![];
    while i < cs.len() { let c = cs[i]; match c { ' ' => { i += 1; } '0'..='9' | '.' => { let st = i; while i < cs.len() && (cs[i].is_ascii_digit() || cs[i] == '.') { i += 1; } out.push(Token::Num(cs[st..i].iter().collect::<String>().parse().unwrap())); } '(' => { out.push(Token::LParen); i += 1; } ')' => { out.push(Token::RParen); i += 1; } _ => { out.push(Token::Op(c)); i += 1; } } }
    out
}
fn eval(t: &[Token], pos: &mut usize) -> f64 {
    let mut v = term(t, pos);
    while *pos < t.len() { match t[*pos] { Token::Op('+') => { *pos += 1; v += term(t, pos); } Token::Op('-') => { *pos += 1; v -= term(t, pos); } _ => break } }
    v
}
fn term(t: &[Token], pos: &mut usize) -> f64 {
    let mut v = atom(t, pos);
    while *pos < t.len() { match t[*pos] { Token::Op('*') => { *pos += 1; v *= atom(t, pos); } Token::Op('/') => { *pos += 1; v /= atom(t, pos); } _ => break } }
    v
}
fn atom(t: &[Token], pos: &mut usize) -> f64 { match &t[*pos] { Token::Num(n) => { *pos += 1; *n } Token::LParen => { *pos += 1; let v = eval(t, pos); *pos += 1; v } Token::Op('-') => { *pos += 1; -atom(t, pos) } o => panic!("unexpected {:?}", o) } }
fn main() {
    let mut vs = vec![Version { major: 1, minor: 2, patch: 3 }, Version { major: 1, minor: bb(0), patch: 9 }, Version::default()];
    vs.sort();
    println!("{:?} {}", vs, vs[0] < vs[1]);
    let v2 = Version { patch: 7, ..vs[2] };
    println!("{:?} {:?}", v2, v2.max(vs[1]));
    for e in ["1 + 2 * 3", "(1 + 2) * 3", "10 / 4 - 1", "-(2 + 3) * 2.5"] { println!("{} = {}", e, eval(&tokenize(bb(e)), &mut 0)); }
    println!("{:?} {} {}", Color::Blue, Color::Green as u8, Color::Blue as i32 + 1);
    println!("{} {}", std::mem::size_of::<Packed>(), std::mem::align_of::<Packed>());
    let u = U { f: bb(1.0) };
    println!("{:#x}", unsafe { u.i });
    println!("{} {} {:?} {}", LIMIT, GREETING, TABLE, TABLE.iter().map(|&x| x as usize).sum::<usize>() * LIMIT);
    let t = bb((1, "a", 2.5)); let (x, y, z) = t;
    println!("{} {} {} {:?}", x, y, z, t);
    let arr = [[1u8; 3]; 2]; println!("{:?} {}", arr, arr.len() * arr[0].len());
    let mut label = 'outer: loop { let mut n = 0; loop { n += 1; if n == bb(5) { break 'outer n * 2; } } };
    label += 1; println!("{}", label);
    let shadow = 5; let shadow = shadow * 2; { let shadow = "inner"; println!("{}", shadow); } println!("{}", shadow);
    let tuple_struct_ptr = Box::new(Version::default()); let raw = Box::into_raw(tuple_struct_ptr);
    unsafe { (*raw).major = 9; println!("{:?}", *raw); drop(Box::from_raw(raw)); }
}

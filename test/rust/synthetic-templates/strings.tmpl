use std::hint::black_box as bb;
fn main() {
    let s = String::from(bb("Hello, Wörld! héllo ünïcode ß 日本語"));
    println!("{} {} {}", s.len(), s.chars().count(), s.to_uppercase());
    println!("{} {}", s.to_lowercase(), s.is_char_boundary(bb(9)));
    println!("{:?}", s.char_indices().filter(|(_, c)| !c.is_ascii()).take(4).collect::<Vec<_>>());
    println!("{:?} {:?} {:?}", s.find("Wör"), s.rfind('h'), s.find(char::is_whitespace));
    println!("{:?}", s.split(' ').map(|w| w.len()).collect::<Vec<_>>());
    println!("{:?}", s.split_whitespace().rev().collect::<Vec<_>>());
    println!("{}", s.replace("llo", "LLO").replacen('l', "_", 2));
    println!("{:?} {:?}", "  pad ".trim(), "xxabcxx".trim_matches('x'));
    println!("{:?} {:?}", "k=v=w".split_once('='), "k=v=w".rsplit_once('='));
    println!("{} {}", "abc" < "abd", "Zebra".cmp("apple") as i32);
    println!("{:?}", "a1b22c333".chars().filter(char::is_ascii_digit).collect::<String>());
    println!("{:?}", "line1\nline2\r\nline3".lines().collect::<Vec<_>>());
    println!("{:?} {:?}", "ß".to_uppercase(), "İ".to_lowercase().len());
    println!("{} {}", 'ä'.is_alphabetic(), '٣'.is_numeric());
    println!("{:?} {:?}", 'a'.to_digit(16), std::char::from_digit(bb(11), 16));
    println!("{:?}", char::from_u32(bb(0x1F600)).map(|c| (c, c.len_utf8(), c.len_utf16())));
    let mut owned = String::with_capacity(4);
    for (i, w) in ["x", "yy", "zzz"].iter().enumerate() { if i > 0 { owned.push_str(", "); } owned += w; }
    owned.insert(0, '[');
    owned.push(']');
    println!("{} {}", owned, owned.capacity() >= owned.len());
    println!("{:?} {:?}", owned.pop(), owned.remove(0));
    owned.truncate(bb(4));
    println!("{:?}", owned);
    let bytes = "héllo".as_bytes();
    println!("{:?} {:?}", bytes, std::str::from_utf8(&bytes[..2]).is_err());
    println!("{:?}", String::from_utf8_lossy(&[72, 105, 0xff, 33]));
    println!("{:?}", String::from_utf8(vec![0xe6, 0x97, 0xa5]));
    println!("{:?}", "tic-tac-toe".splitn(2, '-').collect::<Vec<_>>());
    println!("{:?}", "AbC".chars().map(|c| if c.is_uppercase() { c.to_ascii_lowercase() } else { c.to_ascii_uppercase() }).collect::<String>());
    println!("{:?} {:?}", "abc".repeat(bb(3)), "x".parse::<char>());
    println!("{}", "a-b_c d".split(|c: char| !c.is_alphanumeric()).collect::<Vec<_>>().concat());
    println!("{:?} {:?}", "prefix.rs".strip_suffix(".rs"), "prefix.rs".strip_prefix("x"));
    println!("{} {}", "abc".eq_ignore_ascii_case("ABC"), "b".starts_with(|c: char| c > 'a'));
    let mut chars: Vec<char> = "sorting".chars().collect();
    chars.sort(); chars.dedup();
    println!("{}", chars.iter().collect::<String>());
    println!("{:?}", "a\tb\"c\\d\u{7f}é\u{200b}".escape_debug().to_string());
    println!("{}", "x".escape_unicode());
    println!("{:?}", format!("{:?}", "q\"uote\n"));
}

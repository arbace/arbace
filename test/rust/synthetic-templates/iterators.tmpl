use std::collections::{BTreeMap, HashMap};
use std::hint::black_box as bb;
struct Fib(u64, u64);
impl Iterator for Fib { type Item = u64; fn next(&mut self) -> Option<u64> { let r = self.0; self.0 = self.1; self.1 += r; Some(r) } }
fn main() {
    let v: Vec<i32> = (1..=bb(10)).collect();
    println!("{:?}", v.iter().map(|x| x * x).filter(|x| x % 2 == 1).collect::<Vec<_>>());
    println!("{} {} {:?} {:?}", v.iter().sum::<i32>(), v.iter().product::<i32>(), v.iter().max(), v.iter().min_by_key(|x| (**x - 5).abs()));
    println!("{:?}", v.iter().zip(v.iter().skip(1)).map(|(a, b)| a * b).take(4).collect::<Vec<_>>());
    println!("{:?}", v.chunks(3).map(|c| c.iter().sum::<i32>()).collect::<Vec<_>>());
    println!("{:?}", v.windows(4).map(|w| w[0] + w[3]).collect::<Vec<_>>());
    println!("{:?}", v.iter().rev().step_by(3).collect::<Vec<_>>());
    println!("{:?}", v.iter().scan(0, |acc, x| { *acc += x; Some(*acc) }).take_while(|s| *s < 30).collect::<Vec<_>>());
    println!("{:?}", (1..4).flat_map(|i| (0..i).map(move |j| (i, j))).collect::<Vec<_>>());
    println!("{:?}", v.iter().position(|&x| x == 7).zip(v.iter().rposition(|&x| x < 3)));
    println!("{} {}", v.iter().any(|&x| x > 9), v.iter().all(|&x| x > 1));
    let (ev, od): (Vec<i32>, Vec<i32>) = v.iter().partition(|&&x| x % 2 == 0);
    println!("{:?} {:?}", ev, od);
    println!("{:?}", Fib(0, 1).skip(5).take(8).collect::<Vec<_>>());
    println!("{:?}", Fib(0, 1).take_while(|&x| x < 100).filter(|x| x % 2 == 0).last());
    let words = ["apple", "bob", "cat", "apple", "bob", "apple"];
    let mut counts: HashMap<&str, usize> = HashMap::new();
    for w in words { *counts.entry(w).or_insert(0) += 1; }
    let sorted: BTreeMap<_, _> = counts.into_iter().collect();
    println!("{:?}", sorted);
    let s: String = words.iter().map(|w| w.chars().next().unwrap()).collect();
    println!("{} {}", s, words.join("-"));
    let mut pk = [1, 1, 2, 3, 3, 3].iter().peekable();
    let mut runs = vec![];
    while let Some(&x) = pk.next() { let mut n = 1; while pk.peek() == Some(&&x) { pk.next(); n += 1; } runs.push((x, n)); }
    println!("{:?}", runs);
    println!("{:?}", v.iter().copied().reduce(|a, b| a * 2 + b));
    println!("{:?}", v.iter().enumerate().filter(|(i, _)| i % 4 == 0).map(|(_, x)| x).collect::<Vec<_>>());
    println!("{:?}", "a,b;c".split(|c| c == ',' || c == ';').collect::<Vec<_>>());
    let nested = vec![vec![1, 2], vec![], vec![3]];
    println!("{:?} {}", nested.iter().flatten().collect::<Vec<_>>(), nested.iter().map(Vec::len).sum::<usize>());
    println!("{:?}", (0..5).map(|x| x as f64 / 2.0).fold(f64::MIN, f64::max));
    let r: Result<Vec<i32>, _> = ["1", "2", "x"].iter().map(|s| s.parse::<i32>()).collect();
    let o: Option<Vec<i32>> = [Some(1), Some(2)].into_iter().collect();
    println!("{} {:?}", r.is_err(), o);
    let mut it = v.iter().cycle().skip(8);
    println!("{:?} {:?} {:?}", it.next(), it.next(), it.next());
    println!("{:?}", v.iter().max_by(|a, b| (*a % 4).cmp(&(*b % 4))));
    println!("{:?} {:?}", (1..=3).rev().chain(7..9).collect::<Vec<_>>(), (0..20).step_by(7).len());
    println!("{:?}", v.iter().unzip_check());
}
trait UnzipCheck { fn unzip_check(self) -> (Vec<i32>, Vec<bool>); }
impl<'a, I: Iterator<Item = &'a i32>> UnzipCheck for I { fn unzip_check(self) -> (Vec<i32>, Vec<bool>) { self.take(3).map(|&x| (x, x > 1)).unzip() } }

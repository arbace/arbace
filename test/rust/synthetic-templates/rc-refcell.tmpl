use std::cell::{Cell, RefCell};
use std::collections::HashMap;
use std::hint::black_box as bb;
use std::rc::{Rc, Weak};
#[derive(Debug)]
struct Node { val: i32, children: RefCell<Vec<Rc<Node>>>, parent: RefCell<Weak<Node>> }
enum List { Cons(i32, Box<List>), Nil }
use List::{Cons, Nil};
impl List { fn sum(&self) -> i32 { match self { Cons(v, rest) => v + rest.sum(), Nil => 0 } } }
struct Counter { hits: Cell<u32>, log: RefCell<Vec<String>> }
impl Counter { fn hit(&self, s: &str) { self.hits.set(self.hits.get() + 1); self.log.borrow_mut().push(s.to_string()); } }
fn main() {
    let leaf = Rc::new(Node { val: bb(3), children: RefCell::new(vec![]), parent: RefCell::new(Weak::new()) });
    println!("parent {:?} strong {} weak {}", leaf.parent.borrow().upgrade().map(|p| p.val), Rc::strong_count(&leaf), Rc::weak_count(&leaf));
    {
        let branch = Rc::new(Node { val: 5, children: RefCell::new(vec![Rc::clone(&leaf)]), parent: RefCell::new(Weak::new()) });
        *leaf.parent.borrow_mut() = Rc::downgrade(&branch);
        println!("parent {:?} strong {} weak {}", leaf.parent.borrow().upgrade().map(|p| p.val), Rc::strong_count(&branch), Rc::weak_count(&branch));
        println!("{}", branch.children.borrow().iter().map(|c| c.val).sum::<i32>());
    }
    println!("parent {:?} strong {}", leaf.parent.borrow().upgrade().map(|p| p.val), Rc::strong_count(&leaf));
    let l = Cons(1, Box::new(Cons(bb(2), Box::new(Cons(3, Box::new(Nil))))));
    println!("{}", l.sum());
    let c = Counter { hits: Cell::new(0), log: RefCell::new(vec![]) };
    c.hit("a"); c.hit("b");
    println!("{} {:?}", c.hits.get(), c.log.borrow());
    let shared = Rc::new(RefCell::new(HashMap::new()));
    let s2 = Rc::clone(&shared);
    let add = move |k: &str, v: i32| { s2.borrow_mut().insert(k.to_string(), v); };
    add("x", 1); add("y", bb(2));
    let mut ks: Vec<_> = shared.borrow().iter().map(|(k, v)| format!("{}{}", k, v)).collect(); ks.sort();
    println!("{:?} {}", ks, Rc::strong_count(&shared));
    let r = RefCell::new(5);
    { let a = r.borrow(); let b = r.borrow(); println!("{} {:?}", *a + *b, r.try_borrow_mut().is_err()); }
    *r.borrow_mut() += 1;
    println!("{:?}", r);
    let mut rc = Rc::new(10);
    *Rc::make_mut(&mut rc) += 1;
    let rc2 = Rc::clone(&rc);
    *Rc::make_mut(&mut rc) += 1;
    println!("{} {}", rc, rc2);
    println!("{:?}", Rc::try_unwrap(rc2));
    println!("{}", Rc::ptr_eq(&leaf, &leaf.clone()));
}

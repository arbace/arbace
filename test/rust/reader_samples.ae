;; repr/rust's spec (doc/rust/SPEC.md, Appendix A): how Arbace's reader reads Rust's
;; lexemes and the spec's respellings. Usage: arbace test/rust/reader_samples.ae SAMPLES
;; SAMPLES holds one sample per line; lines starting with ";;" are headings, blank lines are
;; skipped. Each sample is read as the text of a vector, "[" TEXT "]", so a sample that reads as
;; more than one form, or stops early, shows. Prints, per sample: the text, then "=>" and the
;; forms read (pr-str and class), or "!!" and the reader's error.

(require (quote [arbace.string :as s]))

(defn kind [x]
  (cond
    (symbol? x) (if (namespace x) (str "sym ns=" (namespace x) " name=" (name x)) "sym")
    (keyword? x) (str "kw name=" (pr-str (name x)) (when (namespace x) (str " ns=" (namespace x))))
    (char? x) (str "char " (int x))
    (string? x) (str "str len=" (count x) " cps=" (pr-str (mapv int x)))
    (integer? x) (str "int " (class x))
    (ratio? x) "ratio"
    (decimal? x) "bigdec"
    (float? x) "double"
    (seq? x) "list"
    (vector? x) "vector"
    (nil? x) "nil"
    (true? x) "true"
    (false? x) "false"
    :else (str (class x))))

(defn shown
  "pr-str with controls, DEL and lone surrogates as \\uXXXX, so the output stays text."
  [x]
  (s/replace (pr-str x) #"[\x00-\x1f\x7f\x{D800}-\x{DFFF}]"
             (fn [m] (format "\\u%04x" (int (first m))))))

(defn one [text]
  (try
    (let [v (read-string (str "[" text "]"))]
      (str text "  =>  " (count v) ": "
           (s/join " | " (map (fn [x] (str (shown x) " {" (kind x) "}")) v))))
    (catch Throwable e
      (str text "  !!  " (.getMessage e)))))

(doseq [line (s/split-lines (slurp (first *command-line-args*)))]
  (cond
    (s/blank? line) nil
    (.startsWith line ";;") (println line)
    :else (println (one line))))

;; std's build for rsi (doc/rust/EVAL.md §3; RES3 (a), RES17 (b)): the sysroot every lowered program and the judge are compiled against
;; from RE3 on, built from the pinned rust-src (tools/rsdump/apks.sha256) as rust's bootstrap builds it: Cargo on library/'s own
;; workspace (its package sysroot), with the profile below, its LLVM IR kept (-C save-temps: each codegen unit's bitcode, made IR text
;; by clang -S -emit-llvm, survey P5) and pinned by digest (test/rust/runtime/ir.sha256, bin/rsi std-build --update), as CX7 pins
;; libstdc++'s (test/cpp/runtime/ir.sha256). Cargo hashes the workspace's members by their path in it, so the digests hold wherever the
;; build runs (two places gave the same, RE3). bin/rsi std-build checks the oracle and the assembler against :rustc and :clang first.
;; Read with the Clojure reader.
{:rustc "rustc 1.99.1 (58cf8f9c3 2026-10-13) (Alpine Linux Rust 1.99.1-r0)"
 :clang "Alpine clang version 23.1.4"
 :target "x86_64-alpine-linux-musl"
 ;; Cargo's release profile, overridden (CARGO_PROFILE_RELEASE_*): -O0, no debug assertions and no overflow checks in std (as the
 ;; host's release std: its panics' texts are the judge's), unwinding panics, Cargo's default codegen units, paths trimmed
 :profile {"OPT_LEVEL" "0" "DEBUG_ASSERTIONS" "false" "OVERFLOW_CHECKS" "false" "PANIC" "unwind" "DEBUG" "0" "TRIM_PATHS" "all"}
 ;; library/Cargo.toml's own per-package release settings, overridden (--config): compiler_builtins at Cargo's default codegen units
 ;; (not its 10,000), the backtrace crates at -O0 (not "s"): the whole std at the profile above
 :package-profile {"compiler_builtins" {"codegen-units" 16}
                   "addr2line" {"opt-level" 0} "gimli" {"opt-level" 0} "miniz_oxide" {"opt-level" 0} "rustc-demangle" {"opt-level" 0}}
 ;; the target crates' flags (RUSTFLAGS): the units' bitcode kept (the rlibs carry bitcode for -C lto programs); every std crate
 ;; unstable unless marked, as bootstrap compiles them
 :rustflags ["-Csave-temps" "-Cembed-bitcode=yes" "-Zforce-unstable-if-unmarked"]
 ;; the workspace's package and its features (bootstrap's default for this target: unwinding panics, backtraces)
 :package "sysroot"
 :features "panic-unwind backtrace"}

;; rsi's negative controls (doc/GATE-SURVEY.md, GTS81 (a); doc/rust/EVAL.md §9): bin/rsi check's and check --aot's judge
;; (arbace.rust.check/run-judge) judges the subject's node program's run against the reference's rustc run
;; (test/rust/ref-rustc-1.99.1.edn), which must not pass; one whose subject is not in the run, not built or not run is left. No
;; file or run of its own: two of rsi's samples, both passing, with other outputs. No control is a row of the record. Read with
;; the Clojure reader.
[{:id "_control/run/std-vs-panics" :level :run :subject "test/rust/eval/std.rs" :reference "test/rust/eval/panics.rs"
  :why "std.rs's run on ci (formatting, collections) against panics.rs's rustc run (catch_unwind's payloads): stdout and stderr differ"}
 {:id "_control/run/synthetic-ints" :level :run :subject "test/rust/synthetic/int-ops-i32.rs" :reference "test/rust/synthetic/int-ops-i64.rs"
  :why "the i32 program's run against the i64 program's rustc run: the same statements at another width, stdout differs"}
 {:id "_control/run/synthetic-panic" :level :run :subject "test/rust/synthetic/panic-index.rs" :reference "test/rust/synthetic/panic-unwrap-none.rs"
  :why "two programs that print start and panic with status 101: stderr differs (the message and the position)"}
 {:id "_control/run/synthetic-status" :level :run :subject "test/rust/synthetic/trap.rs" :reference "test/rust/synthetic/abort.rs"
  :why "the trap (status 132) against the abort's rustc run (134): the status differs"}]

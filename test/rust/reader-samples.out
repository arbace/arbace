;; 1. Rust's lexemes as rust-lisp spells them (the survey's E1, the ones the spec respells)
std::io::Write  !!  Invalid token: std::io::Write
::core::mem  !!  Invalid token: ::core::mem
Self::Item  !!  Invalid token: Self::Item
(: T Ord)  !!  Invalid token: :
(:: size_of T)  !!  Invalid token: ::
#[derive Debug Clone]  !!  Reader tag must be a symbol
#tt(a, b)  !!  No reader function for tag tt
{:x :y 2}  !!  Map literal must contain an even number of forms
{pub :x f64}  !!  Map literal must contain an even number of forms
'a'  =>  1: (quote a') {list}
'\n'  !!  Unsupported character: \n'
b'a'  =>  1: b'a' {sym}
r#"x"#  !!  Unmatched delimiter: ]
r"a\n"  =>  2: r {sym} | "a\n" {str len=2 cps=[97 10]}
b"bytes"  =>  2: b {sym} | "bytes" {str len=5 cps=[98 121 116 101 115]}
c"x"  =>  2: c {sym} | "x" {str len=1 cps=[120]}
"\x41"  !!  Unsupported escape character: \x
"\u{1F600}"  !!  Invalid unicode escape: \u{
"\01"  =>  1: "\u0001" {str len=1 cps=[1]}
1u8  !!  Invalid number: 1u8
0x_ff  !!  Invalid number: 0x_ff
0o17  !!  Invalid number: 0o17
0b1010  !!  Invalid number: 0b1010
1_000_000  !!  Invalid number: 1_000_000
1e3  =>  1: 1000.0 {double}
1.  =>  1: 1.0 {double}
2.5f32  !!  Invalid number: 2.5f32
(^ a b)  =>  1: (b) {list}
(^= a b)  =>  1: (a b) {list}
(@ x p)  =>  1: ((arbace.core/deref x) p) {list}
x@y  =>  2: x {sym} | (arbace.core/deref y) {list}
/=  !!  Invalid token: /=
(/= a b)  !!  Invalid token: /=
;; 2. Names
foo  =>  1: foo {sym}
_foo  =>  1: _foo {sym}
_  =>  1: _ {sym}
Self  =>  1: Self {sym}
self  =>  1: self {sym}
super  =>  1: super {sym}
crate  =>  1: crate {sym}
r#type  =>  1: r#type {sym}
r#match  =>  1: r#match {sym}
r#nil  =>  1: r#nil {sym}
é  =>  1: é {sym}
naïve  =>  1: naïve {sym}
δx  =>  1: δx {sym}
x1  =>  1: x1 {sym}
nil  =>  1: nil {nil}
true  =>  1: true {true}
false  =>  1: false {false}
quote  =>  1: quote {sym}
(quote a)  =>  1: (quote a) {list}
;; 3. Paths (the spec's spelling)
std/io  =>  1: std/io {sym ns=std name=io}
std.io/Write  =>  1: std.io/Write {sym ns=std.io name=Write}
a.b.c.D/e  =>  1: a.b.c.D/e {sym ns=a.b.c.D name=e}
Self/Item  =>  1: Self/Item {sym ns=Self name=Item}
u8/MAX  =>  1: u8/MAX {sym ns=u8 name=MAX}
Default/default  =>  1: Default/default {sym ns=Default name=default}
crate/m  =>  1: crate/m {sym ns=crate name=m}
crate.a/b  =>  1: crate.a/b {sym ns=crate.a name=b}
super/x  =>  1: super/x {sym ns=super name=x}
super.super/x  =>  1: super.super/x {sym ns=super.super name=x}
self/x  =>  1: self/x {sym ns=self name=x}
e/*  =>  1: e/* {sym ns=e name=*}
std.io/*  =>  1: std.io/* {sym ns=std.io name=*}
std.r#type/x  =>  1: std.r#type/x {sym ns=std.r#type name=x}
r#type.x/y  =>  1: r#type.x/y {sym ns=r#type.x name=y}
x/r#type  =>  1: x/r#type {sym ns=x name=r#type}
foo/nil  =>  1: foo/nil {sym ns=foo name=nil}
foo/true  =>  1: foo/true {sym ns=foo name=true}
std/println!  =>  1: std/println! {sym ns=std name=println!}
core.ptr/addr_of!  =>  1: core.ptr/addr_of! {sym ns=core.ptr name=addr_of!}
println!  =>  1: println! {sym}
vec!  =>  1: vec! {sym}
(:global core.mem/swap)  =>  1: (:global core.mem/swap) {list}
(:global core)  =>  1: (:global core) {list}
(:global std/io)  =>  1: (:global std/io) {list}
(:path (Vec u8) with_capacity)  =>  1: (:path (Vec u8) with_capacity) {list}
(:path ((:global std.vec/Vec) u8) new)  =>  1: (:path ((:global std.vec/Vec) u8) new) {list}
(:lifetime "nil")  =>  1: (:lifetime "nil") {list}
(:name "nil")  =>  1: (:name "nil") {list}
(:qself T Tr Assoc)  =>  1: (:qself T Tr Assoc) {list}
(:qself T f)  =>  1: (:qself T f) {list}
((:path quote) a)  =>  1: ((:path quote) a) {list}
;; 4. Field chains and methods
self.x.0  =>  1: self.x.0 {sym}
a.0.1  =>  1: a.0.1 {sym}
self.r#type  =>  1: self.r#type {sym}
x.y.z  =>  1: x.y.z {sym}
(. (f) a b)  =>  1: (. (f) a b) {list}
(. a/b c)  =>  1: (. a/b c) {list}
.push  =>  1: .push {sym}
.await  =>  1: .await {sym}
.match  =>  1: .match {sym}
.use  =>  1: .use {sym}
.r#type  =>  1: .r#type {sym}
((:turbofish .collect (Vec _)) it)  =>  1: ((:turbofish .collect (Vec _)) it) {list}
;; 5. Operators
+  =>  1: + {sym}
-  =>  1: - {sym}
*  =>  1: * {sym}
/  =>  1: / {sym}
%  =>  1: % {sym}
&  =>  1: & {sym}
|  =>  1: | {sym}
!  =>  1: ! {sym}
&&  =>  1: && {sym}
||  =>  1: || {sym}
<<  =>  1: << {sym}
>>  =>  1: >> {sym}
==  =>  1: == {sym}
!=  =>  1: != {sym}
<  =>  1: < {sym}
<=  =>  1: <= {sym}
>  =>  1: > {sym}
>=  =>  1: >= {sym}
=  =>  1: = {sym}
+=  =>  1: += {sym}
-=  =>  1: -= {sym}
*=  =>  1: *= {sym}
/=  !!  Invalid token: /=
%=  =>  1: %= {sym}
&=  =>  1: &= {sym}
|=  =>  1: |= {sym}
<<=  =>  1: <<= {sym}
>>=  =>  1: >>= {sym}
^  !!  Unmatched delimiter: ]
^=  !!  Unmatched delimiter: ]
bit-xor  =>  1: bit-xor {sym}
bit-xor=  =>  1: bit-xor= {sym}
div=  =>  1: div= {sym}
:/=  !!  Invalid token: :/=
..  =>  1: .. {sym}
..=  =>  1: ..= {sym}
...  =>  1: ... {sym}
->  =>  1: -> {sym}
=>  =>  1: => {sym}
?  =>  1: ? {sym}
&mut  =>  1: &mut {sym}
&raw  =>  1: &raw {sym}
&pin  =>  1: &pin {sym}
*const  =>  1: *const {sym}
*mut  =>  1: *mut {sym}
&self  =>  1: &self {sym}
&mut  =>  1: &mut {sym}
(& x)  =>  1: (& x) {list}
(&mut x)  =>  1: (&mut x) {list}
(&raw const x)  =>  1: (&raw const x) {list}
(* x)  =>  1: (* x) {list}
(! x)  =>  1: (! x) {list}
(- x)  =>  1: (- x) {list}
(as e T)  =>  1: (as e T) {list}
(? e)  =>  1: (? e) {list}
(| a b)  =>  1: (| a b) {list}
(:at x (..= 1 5))  =>  1: (:at x (..= 1 5)) {list}
(:at (ref x) ..)  =>  1: (:at (ref x) ..) {list}
;; 6. Lifetimes and labels
'a  =>  1: (quote a) {list}
'static  =>  1: (quote static) {list}
'_  =>  1: (quote _) {list}
'outer  =>  1: (quote outer) {list}
'r#mod  =>  1: (quote r#mod) {list}
(& 'a T)  =>  1: (& (quote a) T) {list}
(&mut 'a self)  =>  1: (&mut (quote a) self) {list}
(break 'outer v)  =>  1: (break (quote outer) v) {list}
['a 'b]  =>  1: [(quote a) (quote b)] {vector}
;; 7. Literals
0  =>  1: 0 {int class java.lang.Long}
42  =>  1: 42 {int class java.lang.Long}
-5  =>  1: -5 {int class java.lang.Long}
007  =>  1: 7 {int class java.lang.Long}
08  !!  Invalid number: 08
1_000  !!  Invalid number: 1_000
0x_ff  !!  Invalid number: 0x_ff
0xFF  =>  1: 255 {int class java.lang.Long}
1.0  =>  1: 1.0 {double}
1.5  =>  1: 1.5 {double}
0.1  =>  1: 0.1 {double}
-1.5  =>  1: -1.5 {double}
1e3  =>  1: 1000.0 {double}
1.0E10  =>  1: 1.0E10 {double}
100000000.0  =>  1: 1.0E8 {double}
3.141592653589793  =>  1: 3.141592653589793 {double}
3.14159265358979323846264338327950288  =>  1: 3.141592653589793 {double}
340282366920938463463374607431768211455  =>  1: 340282366920938463463374607431768211455N {int class arbace.lang.BigInt}
9223372036854775808  =>  1: 9223372036854775808N {int class arbace.lang.BigInt}
-9223372036854775808  =>  1: -9223372036854775808 {int class java.lang.Long}
true  =>  1: true {true}
false  =>  1: false {false}
(:lit 1 u8)  =>  1: (:lit 1 u8) {list}
(:lit 0 usize)  =>  1: (:lit 0 usize) {list}
(:lit "0x_ff" u8)  =>  1: (:lit "0x_ff" u8) {list}
(:lit 2.5 f32)  =>  1: (:lit 2.5 f32) {list}
(:lit "1e3")  =>  1: (:lit "1e3") {list}
(:lit "1.")  =>  1: (:lit "1.") {list}
(:lit "\"a\\x41\"")  =>  1: (:lit "\"a\\x41\"") {list}
(:lit "'\\x7f'")  =>  1: (:lit "'\\x7f'") {list}
\a  =>  1: \a {char 97}
\A  =>  1: \A {char 65}
\0  =>  1: \0 {char 48}
\newline  =>  1: \newline {char 10}
\return  =>  1: \return {char 13}
\tab  =>  1: \tab {char 9}
\space  =>  1: \space {char 32}
\'  =>  1: \' {char 39}
\\  =>  1: \\ {char 92}
\"  =>  1: \" {char 34}
\(  =>  1: \( {char 40}
\;  =>  1: \; {char 59}
\u0000  =>  1: \\u0000 {char 0}
\u007f  =>  1: \\u007f {char 127}
\u00e9  =>  1: \é {char 233}
\é  =>  1: \é {char 233}
\あ  =>  1: \あ {char 12354}
(:char 128512)  =>  1: (:char 128512) {list}
\😀  !!  Unsupported character: \😀
"plain"  =>  1: "plain" {str len=5 cps=[112 108 97 105 110]}
"a\nb"  =>  1: "a\nb" {str len=3 cps=[97 10 98]}
"tab\there"  =>  1: "tab\there" {str len=8 cps=[116 97 98 9 104 101 114 101]}
"q\"uote"  =>  1: "q\"uote" {str len=6 cps=[113 34 117 111 116 101]}
"back\\slash"  =>  1: "back\\slash" {str len=10 cps=[98 97 99 107 92 115 108 97 115 104]}
"\u0000"  =>  1: "\u0000" {str len=1 cps=[0]}
"\u001b[0m"  =>  1: "\u001b[0m" {str len=4 cps=[27 91 48 109]}
"😀"  =>  1: "😀" {str len=2 cps=[55357 56832]}
"é and あ"  =>  1: "é and あ" {str len=7 cps=[233 32 97 110 100 32 12354]}
(:raw "a\\nb" 0)  =>  1: (:raw "a\\nb" 0) {list}
(:raw "q\"" 1)  =>  1: (:raw "q\"" 1) {list}
(:bytes "abc")  =>  1: (:bytes "abc") {list}
(:bytes "\u00ff\u0000")  =>  1: (:bytes "ÿ\u0000") {list}
(:raw-bytes "x\\y" 0)  =>  1: (:raw-bytes "x\\y" 0) {list}
(:cstr "x")  =>  1: (:cstr "x") {list}
(:raw-cstr "x" 0)  =>  1: (:raw-cstr "x" 0) {list}
(:byte \a)  =>  1: (:byte \a) {list}
(:byte \u00ff)  =>  1: (:byte \ÿ) {list}
;; 8. The spec's forms
(:has T Ord)  =>  1: (:has T Ord) {list}
(:has x u8)  =>  1: (:has x u8) {list}
(:has 'a 'b)  =>  1: (:has (quote a) (quote b)) {list}
(:turbofish size_of T)  =>  1: (:turbofish size_of T) {list}
(:attr derive Debug Clone)  =>  1: (:attr derive Debug Clone) {list}
(:attr cfg (all unix (= feature "x")))  =>  1: (:attr cfg (all unix (= feature "x"))) {list}
(:attr doc = "x")  =>  1: (:attr doc = "x") {list}
(:attr unsafe no_mangle)  =>  1: (:attr unsafe no_mangle) {list}
(:attr rustc_const_unstable (= feature "x") (= issue "none"))  =>  1: (:attr rustc_const_unstable (= feature "x") (= issue "none")) {list}
(:attr path (:tt "= \"x.rs\""))  =>  1: (:attr path (:tt "= \"x.rs\"")) {list}
(:attr! allow unused)  =>  1: (:attr! allow unused) {list}
(:doc " text")  =>  1: (:doc " text") {list}
(:doc! " text")  =>  1: (:doc! " text") {list}
(:doc-block " text ")  =>  1: (:doc-block " text ") {list}
(:doc-block! " text ")  =>  1: (:doc-block! " text ") {list}
(:tt "($x:expr) => { $x + 1 };")  =>  1: (:tt "($x:expr) => { $x + 1 };") {list}
(:tt "{ ($e:expr) => { $e * 2 }; }")  =>  1: (:tt "{ ($e:expr) => { $e * 2 }; }") {list}
(:braces :x 1 :y)  =>  1: (:braces :x 1 :y) {list}
(:braces :0 a :1 b)  =>  1: (:braces :0 a :1 b) {list}
(:braces :r#type 1)  =>  1: (:braces :r#type 1) {list}
(:braces pub :x f64 (:attr serde skip) :y f64)  =>  1: (:braces pub :x f64 (:attr serde skip) :y f64) {list}
(:braces)  =>  1: (:braces) {list}
(Point (:braces :x 1.0 :y 2.0 .. base))  =>  1: (Point (:braces :x 1.0 :y 2.0 .. base)) {list}
(:tuple a b)  =>  1: (:tuple a b) {list}
(:tuple a)  =>  1: (:tuple a) {list}
()  =>  1: () {list}
(:index a i)  =>  1: (:index a i) {list}
(:repeat 0 n)  =>  1: (:repeat 0 n) {list}
(:semi e)  =>  1: (:semi e) {list}
(:semi)  =>  1: (:semi) {list}
(:paren e)  =>  1: (:paren e) {list}
(=> p a)  =>  1: (=> p a) {list}
(match e (=> (Some x) x) (=> None 0))  =>  1: (match e (=> (Some x) x) (=> None 0)) {list}
(if c a (else if d b) (else e))  =>  1: (if c a (else if d b) (else e)) {list}
(fn [x y] (+ x y))  =>  1: (fn [x y] (+ x y)) {list}
(move fn [] (run))  =>  1: (move fn [] (run)) {list}
(let mut x 5)  =>  1: (let mut x 5) {list}
(let (:has p T) e)  =>  1: (let (:has p T) e) {list}
(.. a :_)  =>  1: (.. a :_) {list}
(:rust "reuse a::b;")  =>  1: (:rust "reuse a::b;") {list}
;; 9. Top-level forms
(ns rs.core.option (:require [arbace.rust :as rs]))  =>  1: (ns rs.core.option (:require [arbace.rust :as rs])) {list}
(rs/file :path "core/src/option.rs" :crate core :edition 2024 :positions :lines :config {:rustc "1.99.1"})  =>  1: (rs/file :path "core/src/option.rs" :crate core :edition 2024 :positions :lines :config {:rustc "1.99.1"}) {list}
(rs/attr! no_std)  =>  1: (rs/attr! no_std) {list}
(rs/doc! " The crate.")  =>  1: (rs/doc! " The crate.") {list}
(rs/attr derive Debug)  =>  1: (rs/attr derive Debug) {list}
(rs/doc " Counts.")  =>  1: (rs/doc " Counts.") {list}
(rs/pub fn f [] {})  =>  1: (rs/pub fn f [] {}) {list}
(rs/pub (crate) struct S)  =>  1: (rs/pub (crate) struct S) {list}
(rs/pub (in a/b) const N usize 5)  =>  1: (rs/pub (in a/b) const N usize 5) {list}
(rs/fn (largest T) [xs (& [T])] -> (Option (& T)) (where (:has T Ord)) (.max (.iter xs)))  =>  1: (rs/fn (largest T) [xs (& [T])] -> (Option (& T)) (where (:has T Ord)) (.max (.iter xs))) {list}
(rs/impl (:generics 'a) (Counter 'a) (pub fn add [(&mut self) text (& 'a str)] (+= self.total 1)))  =>  1: (rs/impl (:generics (quote a)) (Counter (quote a)) (pub fn add [(&mut self) text (& (quote a) str)] (+= self.total 1))) {list}
(rs/use std.collections/HashMap)  =>  1: (rs/use std.collections/HashMap) {list}
(rs/use (std/io self Read))  =>  1: (rs/use (std/io self Read)) {list}
(rs/mod m)  =>  1: (rs/mod m) {list}
(rs/extern crate alloc)  =>  1: (rs/extern crate alloc) {list}
(rs/unsafe extern "C" (fn abort []))  =>  1: (rs/unsafe extern "C" (fn abort [])) {list}
(rs/macro_rules! twice (:tt "{ ($e:expr) => { $e * 2 }; }"))  =>  1: (rs/macro_rules! twice (:tt "{ ($e:expr) => { $e * 2 }; }")) {list}
(rs/macro-call thread_local! (:tt "{ static X: u8 = 0; }"))  =>  1: (rs/macro-call thread_local! (:tt "{ static X: u8 = 0; }")) {list}
(rs/rust "reuse a::b;")  =>  1: (rs/rust "reuse a::b;") {list}
^{:line 5} x  =>  1: x {sym}
^{:rs/pos {:span [1 1 1 5]}} (f)  =>  1: (f) {list}

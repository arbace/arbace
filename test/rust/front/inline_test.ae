(ns rust.front.inline-test
  "C6-4 (doc/rust/FRONTEND-SURVEY.md, \"C6-4's next slice: LLVM's AlwaysInliner over our forms\"): arbace.rust.back.inline's pure
  cases, each against the IR LLVM's -O0 pipeline writes for it (the host's `opt -passes='default<O0>'`, LLVM 23.1.5, run by hand
  over the same functions as text, its output read into these forms; c7 and c8 checked so on 2026-11-22):
  a callee of one block spliced into the calling block, its static alloca at the caller's entry; a callee of several blocks
  whose one return is spliced into the exit block; two returns joined by a phi; a branch on a constant argument pruned and the
  blocks merged; an invoke's call site (the callee's calls made invokes, its resume a branch to the landing pad's body); the
  inlined function dropped. Compared after RF3's normalizer (names by first occurrence). `bin/rust-front
  inline-test`."
  (:require [arbace.rust.back.inline :as inl]
            [arbace.rust.back.check :as chk]))

(defn- norm [f] (chk/normalize f {}))

(def ^:private callee1
  '(llvm/define g/f1 i64 [[i64 %a]] :body [(block %start (= %x (alloca i64 :align 8)) (store [i64 %a] [ptr %x] :align 8)
                                                  (= %y (load i64 [ptr %x] :align 8)) (= %z (sub :nuw i64 -9223372036854775808 %y)) (ret i64 %z))]))
(def ^:private caller1
  '(llvm/define g/c1 i1 [[i64 %p] [i64 %q]] :body [(block %start (= %r (call i64 g/f1 [[i64 %q]])) (= %s (icmp :ule i64 %p %r)) (ret i1 %s))]))
(def ^:private want1
  '(llvm/define g/c1 i1 [[i64 %p] [i64 %q]] :body [(block %start (= %x (alloca i64 :align 8)) (store [i64 %q] [ptr %x] :align 8)
                                                         (= %y (load i64 [ptr %x] :align 8)) (= %z (sub :nuw i64 -9223372036854775808 %y))
                                                         (= %s (icmp :ule i64 %p %z)) (ret i1 %s))]))

;; several blocks, one return; the call's block split, the return's code at the exit block's head
(def ^:private callee2
  '(llvm/define g/f2 i64 [[i64 %a] [i1 %c]] :body [(block %start (br i1 %c %bb1 %bb2))
                                                   (block %bb1 (= %u (call i64 g/h [[i64 %a]])) (br %bb3))
                                                   (block %bb2 (call void g/k []) (br %bb3))
                                                   (block %bb3 (= %m (phi i64 [%u %bb1] [0 %bb2])) (ret i64 %m))]))
(def ^:private caller2
  '(llvm/define g/c2 i64 [[i64 %p] [i1 %b]] :body [(block %start (call void g/before []) (= %r (call i64 g/f2 [[i64 %p] [i1 %b]])) (= %s (add i64 %r 1)) (ret i64 %s))]))
(def ^:private want2
  '(llvm/define g/c2 i64 [[i64 %p] [i1 %b]] :body [(block %start (call void g/before []) (br i1 %b %bb1 %bb2))
                                                   (block %bb1 (= %u (call i64 g/h [[i64 %p]])) (br %exit))
                                                   (block %bb2 (call void g/k []) (br %exit))
                                                   (block %exit (= %m (phi i64 [%u %bb1] [0 %bb2])) (= %s (add i64 %m 1)) (ret i64 %s))]))

;; a constant argument: the branch pruned, the blocks merged into one, spliced into the call's block
(def ^:private caller3
  '(llvm/define g/c3 i64 [[i64 %p]] :body [(block %start (= %r (call i64 g/f2 [[i64 %p] [i1 true]])) (ret i64 %r))]))
(def ^:private want3
  '(llvm/define g/c3 i64 [[i64 %p]] :body [(block %start (= %u (call i64 g/h [[i64 %p]])) (ret i64 %u))]))

;; two returns: a phi in the exit block
(def ^:private callee4
  '(llvm/define g/f4 i64 [[i1 %c]] :body [(block %start (br i1 %c %bb1 %bb2)) (block %bb1 (ret i64 1)) (block %bb2 (ret i64 2))]))
(def ^:private caller4
  '(llvm/define g/c4 i64 [[i1 %b]] :body [(block %start (= %r (call i64 g/f4 [[i1 %b]])) (ret i64 %r))]))
(def ^:private want4
  '(llvm/define g/c4 i64 [[i1 %b]] :body [(block %start (br i1 %b %bb1 %bb2)) (block %bb1 (br %exit)) (block %bb2 (br %exit))
                                         (block %exit (= %m (phi i64 [1 %bb1] [2 %bb2])) (ret i64 %m))]))

;; an invoke's call site: the callee's calls made invokes to the caller's landing pad, each block split after one
(def ^:private callee5
  '(llvm/define g/f5 i64 [[i64 %a]] :personality [ptr g/rust_eh_personality]
     :body [(block %start (= %x (call i64 g/h [[i64 %a]])) (= %y (call i64 g/h [[i64 %x]])) (ret i64 %y))]))
(def ^:private caller5
  '(llvm/define g/c5 i64 [[i64 %p]] :personality [ptr g/rust_eh_personality]
     :body [(block %start (= %r (invoke i64 g/f5 [[i64 %p]] :to %bb1 :unwind %lp)))
            (block %bb1 (ret i64 %r))
            (block %lp (= %e (landingpad (struct ptr i32) :cleanup)) (call void g/drop [[ptr null]]) (resume (struct ptr i32) %e))]))
(def ^:private want5
  '(llvm/define g/c5 i64 [[i64 %p]] :personality [ptr g/rust_eh_personality]
     :body [(block %start (= %x (invoke i64 g/h [[i64 %p]] :to %n1 :unwind %lp)))
            (block %n1 (= %y (invoke i64 g/h [[i64 %x]] :to %exit :unwind %lp)))
            (block %exit (br %bb1))
            (block %bb1 (ret i64 %y))
            (block %lp (= %e (landingpad (struct ptr i32) :cleanup)) (call void g/drop [[ptr null]]) (resume (struct ptr i32) %e))]))

;; the callee's own landing pad: its resume a branch to the caller's landing pad's body, the exception value a phi there
(def ^:private callee6
  '(llvm/define g/f6 i64 [[i64 %a]] :personality [ptr g/rust_eh_personality]
     :body [(block %start (= %x (invoke i64 g/h [[i64 %a]] :to %ok :unwind %cl)))
            (block %ok (ret i64 %x))
            (block %cl (= %l (landingpad (struct ptr i32) :cleanup)) (call void g/drop [[ptr null]]) (resume (struct ptr i32) %l))]))
(def ^:private caller6
  '(llvm/define g/c6 i64 [[i64 %p]] :personality [ptr g/rust_eh_personality]
     :body [(block %start (= %r (invoke i64 g/f6 [[i64 %p]] :to %bb1 :unwind %lp)))
            (block %bb1 (ret i64 %r))
            (block %lp (= %e (landingpad (struct ptr i32) :cleanup)) (call void g/drop [[ptr null]]) (resume (struct ptr i32) %e))]))
(def ^:private want6
  '(llvm/define g/c6 i64 [[i64 %p]] :personality [ptr g/rust_eh_personality]
     :body [(block %start (= %x (invoke i64 g/h [[i64 %p]] :to %exit :unwind %cl)))
            (block %cl (= %l (landingpad (struct ptr i32) :cleanup)) (invoke void g/drop [[ptr null]] :to %n1 :unwind %lp))
            (block %n1 (br %lpbody))
            (block %exit (br %bb1))
            (block %bb1 (ret i64 %x))
            (block %lp (= %e (landingpad (struct ptr i32) :cleanup)) (br %lpbody))
            (block %lpbody (= %eh (phi (struct ptr i32) [%e %lp] [%l %n1])) (call void g/drop [[ptr null]]) (resume (struct ptr i32) %eh))]))

;; C6-4: InstSimplify's aggregate rules over the clone: the callee rebuilds its pair argument (insertvalue poison, %a, 0; insertvalue
;; .., %b, 1), the caller passes its call result's halves (extractvalue %t, 0 and 1): the rebuilt pair is %t, the caller's later
;; extractvalues take %t (std's IR's slice_buffer_to_str around MaybeUninit::slice_assume_init_ref)
(def ^:private callee7
  '(llvm/define g/f7 (struct ptr i64) [[ptr %a] [i64 %b]]
     :body [(block %start (= %p (insertvalue [(struct ptr i64) poison] [ptr %a] 0)) (= %q (insertvalue [(struct ptr i64) %p] [i64 %b] 1))
                   (ret (struct ptr i64) %q))]))
(def ^:private caller7
  '(llvm/define g/c7 i64 [] :body [(block %start (= %t (call (struct ptr i64) g/mk [])) (= %u (extractvalue [(struct ptr i64) %t] 0))
                                          (= %v (extractvalue [(struct ptr i64) %t] 1)) (= %w (call (struct ptr i64) g/f7 [[ptr %u] [i64 %v]]))
                                          (= %x (extractvalue [(struct ptr i64) %w] 1)) (ret i64 %x))]))
(def ^:private want7
  '(llvm/define g/c7 i64 [] :body [(block %start (= %t (call (struct ptr i64) g/mk [])) (= %u (extractvalue [(struct ptr i64) %t] 0))
                                          (= %v (extractvalue [(struct ptr i64) %t] 1)) (= %x (extractvalue [(struct ptr i64) %t] 1)) (ret i64 %x))]))
;; a pair rebuilt from two aggregates' halves: only its first insertvalue is the first aggregate (opt's: `%q.i = insertvalue {ptr,
;; i64} %t, i64 %v, 1`)
(def ^:private caller8
  '(llvm/define g/c8 i64 [] :body [(block %start (= %t (call (struct ptr i64) g/mk [])) (= %s (call (struct ptr i64) g/mk []))
                                          (= %u (extractvalue [(struct ptr i64) %t] 0)) (= %v (extractvalue [(struct ptr i64) %s] 1))
                                          (= %w (call (struct ptr i64) g/f7 [[ptr %u] [i64 %v]])) (= %x (extractvalue [(struct ptr i64) %w] 1)) (ret i64 %x))]))

(def ^:private want8
  '(llvm/define g/c8 i64 [] :body [(block %start (= %t (call (struct ptr i64) g/mk [])) (= %s (call (struct ptr i64) g/mk []))
                                          (= %u (extractvalue [(struct ptr i64) %t] 0)) (= %v (extractvalue [(struct ptr i64) %s] 1))
                                          (= %q (insertvalue [(struct ptr i64) %t] [i64 %v] 1)) (= %x (extractvalue [(struct ptr i64) %q] 1)) (ret i64 %x))]))

;; C6-4 (rust-c6c): simplifyGEPInst's `getelementptr P, 0 -> P` over the clone: an inlined `ptr.add(start)` at start 0 is the
;; pointer (opt -passes='default<O0>', LLVM 23.1.5: c9's GEP gone, the caller's own zero GEP in c10 kept, as here)
(def ^:private callee9
  '(llvm/define g/f9 ptr [[ptr %p] [i64 %n]] :body [(block %start (= %q (getelementptr :inbounds :nuw i8 [ptr %p] [i64 %n])) (ret ptr %q))]))
(def ^:private caller9
  '(llvm/define g/c9 (struct ptr i64) [[ptr %a] [i64 %l]]
     :body [(block %start (= %x (call ptr g/f9 [[ptr %a] [i64 0]])) (= %s (insertvalue [(struct ptr i64) poison] [ptr %x] 0))
                   (= %t (insertvalue [(struct ptr i64) %s] [i64 %l] 1)) (ret (struct ptr i64) %t))]))
(def ^:private want9
  '(llvm/define g/c9 (struct ptr i64) [[ptr %a] [i64 %l]]
     :body [(block %start (= %s (insertvalue [(struct ptr i64) poison] [ptr %a] 0)) (= %t (insertvalue [(struct ptr i64) %s] [i64 %l] 1))
                   (ret (struct ptr i64) %t))]))
(def ^:private caller10
  '(llvm/define g/c10 void [[ptr %a]] :body [(block %start (= %x (getelementptr :inbounds :nuw i8 [ptr %a] [i64 0])) (call void g/use [[ptr %x]]) (ret void))]))

;; rust-c6c: the call sites in their callee's use-list order, newest first (AlwaysInlinerPass: F.users(); a clone's calls newer
;; than the caller's own): opt -passes='default<O0>' (LLVM 23.1.5) over the same module (the callee's use list newest first, as
;; rustc's codegen creates it) puts c11's allocas u's first (two calls of f: v's site taken first), c12's v's first (g inlined at
;; both sites first, then f at the newest clone, u's, first)
(def ^:private callee11
  '(llvm/define g/f11 void [[i64 %x]] :body [(block %start (= %p (alloca (array 16 i8) :align 8)) (call void g/use [[ptr %p] [i64 %x]]) (ret void))]))
(def ^:private caller11
  '(llvm/define g/c11 void [[i64 %u] [i64 %v]] :body [(block %start (call void g/f11 [[i64 %u]]) (call void g/f11 [[i64 %v]]) (ret void))]))
(def ^:private want11
  '(llvm/define g/c11 void [[i64 %u] [i64 %v]]
     :body [(block %start (= %pu (alloca (array 16 i8) :align 8)) (= %pv (alloca (array 16 i8) :align 8))
                   (call void g/use [[ptr %pu] [i64 %u]]) (call void g/use [[ptr %pv] [i64 %v]]) (ret void))]))
(def ^:private callee12 '(llvm/define g/g12 void [[i64 %x]] :body [(block %start (call void g/f12 [[i64 %x]]) (ret void))]))
(def ^:private leaf12
  '(llvm/define g/f12 void [[i64 %x]] :body [(block %start (= %p (alloca (array 16 i8) :align 8)) (call void g/use [[ptr %p] [i64 %x]]) (ret void))]))
(def ^:private caller12
  '(llvm/define g/c12 void [[i64 %u] [i64 %v]] :body [(block %start (call void g/g12 [[i64 %u]]) (call void g/g12 [[i64 %v]]) (ret void))]))
(def ^:private want12
  '(llvm/define g/c12 void [[i64 %u] [i64 %v]]
     :body [(block %start (= %pv (alloca (array 16 i8) :align 8)) (= %pu (alloca (array 16 i8) :align 8))
                   (call void g/use [[ptr %pu] [i64 %u]]) (call void g/use [[ptr %pv] [i64 %v]]) (ret void))]))

;; rust-c6c: ConstantFoldCastInstruction over the clone: an inlined `inttoptr` of a constant 0 is `ptr null`, of 8 the constant
;; expression (opt -passes='default<O0>', LLVM 23.1.5: `call void @use(ptr null)`, `ptr inttoptr (i64 8 to ptr)`)
(def ^:private callee13 '(llvm/define g/w13 ptr [[i64 %a]] :body [(block %start (= %p (inttoptr i64 %a ptr)) (ret ptr %p))]))
(def ^:private caller13
  '(llvm/define g/c13 void [] :body [(block %start (= %x (call ptr g/w13 [[i64 0]])) (call void g/use [[ptr %x]])
                                           (= %y (call ptr g/w13 [[i64 8]])) (call void g/use [[ptr %y]]) (ret void))]))
(def ^:private want13
  '(llvm/define g/c13 void [] :body [(block %start (call void g/use [[ptr null]]) (call void g/use [[ptr (inttoptr i64 8 ptr)]]) (ret void))]))

(defn- case! [nm got want]
  (let [ok (= (norm got) (norm want))]
    (println (str "inline-test: " nm ": " (if ok "equal" (str "DIFFERS: " (chk/diff-text (norm got) (norm want))))))
    ok))

(defn -main [& _]
  (let [m (binding [inl/*nounwind?* (fn [s] (= s 'g/never))]
            (inl/inline-module [callee1 caller1 callee2 caller2 caller3 callee4 caller4 callee5 caller5 callee6 caller6 callee7 caller7 caller8 callee9 caller9 caller10]
                               #{'g/f1 'g/f2 'g/f4 'g/f5 'g/f6 'g/f7 'g/f9}))
        by (into {} (map (juxt second identity) m))
        oks [(case! "one block, its alloca at the entry" (by 'g/c1) want1)
             (case! "several blocks, one return" (by 'g/c2) want2)
             (case! "a constant argument's branch pruned" (by 'g/c3) want3)
             (case! "two returns joined" (by 'g/c4) want4)
             (case! "an invoke's call site, the callee's calls made invokes" (by 'g/c5) want5)
             (case! "an invoke's call site, the callee's resume to the landing pad's body" (by 'g/c6) want6)
             (case! "the inlined functions dropped" (vec (sort (map str (keys by)))) ["g/c1" "g/c10" "g/c2" "g/c3" "g/c4" "g/c5" "g/c6" "g/c7" "g/c8" "g/c9"])
             (case! "C6-4: a pair rebuilt from the caller's halves is the caller's pair (InstSimplify)" (by 'g/c7) want7)
             (case! "C6-4: a pair rebuilt from two aggregates' halves, its second insertvalue kept" (by 'g/c8) want8)
             (case! "C6-4: an inlined pointer offset by zero is the pointer (simplifyGEPInst)" (by 'g/c9) want9)
             ;; its control: the caller's own zero GEP is no clone's, kept
             (case! "C6-4 control: the caller's own zero GEP kept" (by 'g/c10) caller10)
             ;; the aggregate rule's control: c8's result against c7's IR differs
             (not (= (norm (by 'g/c8)) (norm want7)))
             (let [m2 (inl/inline-module [callee11 caller11] #{'g/f11})
                   m3 (inl/inline-module [caller12 callee12 leaf12] #{'g/g12 'g/f12})
                   by2 (into {} (map (juxt second identity) (concat m2 m3)))]
               (and (case! "rust-c6c: two call sites, the newest taken first" (by2 'g/c11) want11)
                    (case! "rust-c6c: a clone's calls newer than the caller's own" (by2 'g/c12) want12)
                    ;; its control: the one-level module's order against the two-level IR differs
                    (not (= (norm (by2 'g/c11)) (norm (apply list 'llvm/define 'g/c11 (drop 2 want12)))))))
             (case! "rust-c6c: an inlined inttoptr of a constant folded (null, a constant expression)"
                    (some #(when (= 'g/c13 (second %)) %) (inl/inline-module [callee13 caller13] #{'g/w13})) want13)
             ;; the negative control: a case's result against another case's IR differs
             (not (= (norm (by 'g/c2)) (norm want4)))]]
    (println (str "inline-test: " (count (filter true? oks)) " of " (count oks) (if (every? true? oks) " passed" " FAILED")))
    (System/exit (if (every? true? oks) 0 1))))

             (binding [br/*drop-glue-at-run?* no-run] (br/pack-compare o (dropb '(place 1) nil))) [:equal])
      (check "negative: the run writes a plain local's glue (rust-c6-1120's RF_DROP_GLUE=1)"
             (binding [br/*drop-glue-at-run?* (fn [p] (= 2 (count p)))] (br/pack-compare o r)) [:equal])
      (check "negative: ours carries the glue" (binding [br/*drop-glue-at-run?* no-run] (br/pack-compare (dropb '(place 1) glue) r)) [:equal])
      (check "drop glue: a projected place's drop stays refused under the run's plain-local glue"
             (nth (binding [br/*drop-glue-at-run?* (fn [p] (= 2 (count p)))]
                    (br/pack-compare (dropb '(place 1 (deref)) nil) (dropb '(place 1 (deref)) glue))) 2 nil)
             :drop)
      (check "negative: a body that differs otherwise keeps its own reason"
             (binding [br/*drop-glue-at-run?* no-run] (br/pack-compare (assoc-in o [:locals 1 :ty] unit) r)) :differs))
    ;; queue 498: SimplifyConstCondition's arms at the instance (prune-const-arms): slice::iter's `if T::IS_ZST` takes one arm, the
    ;; dead arm's call (zst_shrink!'s unchecked_sub) neither closed nor emitted
    (let [bt '(ty "bool" (bool))
          k (fn [v] (list 'const (str "const " v) bt (list 'scalar (if v 1 0) 1)))
          f (list 'const "dead" '(ty "fn() {dead}" (fndef "dead" [])) '(zst))
          b (fn [op] {:args 0 :locals [{:ty '(ty "()" (tuple))} {:ty bt}] :debug []
                      :blocks [{:cleanup false :stmts [(list 'assign '(place 1) (list 'use (k true)))] :term (list 'switch op [[0 2]] 1)}
                               {:cleanup false :stmts [] :term '(return)}
                               {:cleanup false :stmts [] :term (list 'call f [] '(place 0) 3 '(continue))}
                               {:cleanup false :stmts [] :term '(return)}]})
          pr (br/prune-const-arms (b '(move (place 1))))]
      (check "SimplifyConstCondition at the instance: a one-use constant local's switch a goto, the dead arm unreachable"
             (mapv :term (:blocks pr)) ['(goto 1) '(return) '(unreachable) '(unreachable)])
      (check "the switch on the constant itself" (mapv :term (:blocks (br/prune-const-arms (b (k false))))) ['(goto 2) '(unreachable) (:term (nth (:blocks (b nil)) 2)) '(return)])
      (check "the pruned body still equal to the record's after -O0's passes"
             (first (br/pack-compare pr {:args 0 :locals [{:ty '(ty "()" (tuple))}] :debug [] :blocks [{:cleanup false :stmts [] :term '(return)}]}))
             :equal-o0)
      (check "negative: a switch on a local not constant unchanged" (let [x (assoc-in (b '(move (place 1))) [:blocks 0 :stmts] [])] (= x (br/prune-const-arms x))) true)
      (check "negative: a local read twice is no one-use constant"
             (let [x (update-in (b '(move (place 1))) [:blocks 1 :stmts] conj '(assign (place 0) (use (copy (place 1)))))] (= x (br/prune-const-arms x))) true))
    ;; queue 503 (498-2 (a)): the run-time fallback per body. X (no record's twin) fails at run time: X left out, Y (no twin)
    ;; naming X left out in turn, A (a twin) naming Y the record's; E (a twin) fails and is the record's alone, F naming E stays
    ;; native, as do B and D (unrelated), G naming X by a function pointer's symbol left out
    (let [body (fn [& syms] {:blocks (vec (for [s syms] {:stmts [] :term (list 'call '(const "f") [] '(place 0) 1 '(continue) (list 'callee {:kind "item" :symbol s}))}))})
          es [{:symbol "a" :name "A" :twin? true :body (body "y")}
              {:symbol "b" :name "B" :twin? true :body (body "core-ext")}
              {:symbol "x" :name "X" :twin? false :body nil :error "no callee for p::precondition_check"}
              {:symbol "y" :name "Y" :twin? false :body (body "x" "b")}
              {:symbol "d" :name "D" :twin? false :body (body "b")}
              {:symbol "e" :name "E" :twin? true :body nil :error "boom"}
              {:symbol "f" :name "F" :twin? false :body (body "e")}
              {:symbol "g" :name "G" :twin? true :body {:blocks [{:stmts ['(assign (place 1) (use (const "x" (ty "fn()") (zst) :fn-symbol "x")))] :term '(return)}]}}]
          r (br/native-fallback es)]
      (check "one failing body without a twin leaves the rest native: B, D, F kept" (mapv :name (:kept r)) ["B" "D" "F"])
      (check "the lines: X and Y left out, A and G the record's (naming them), E the record's"
             (sort (:lines r))
             (sort ["native-dropped X (a native body failed at run time: no callee for p::precondition_check)"
                    "record-kept E (a native body failed at run time: boom)"
                    "native-dropped Y (names x, a native body left out (the record has no body of it))"
                    "record-kept G (names x, a native body left out (the record has no body of it))"
                    "record-kept A (names y, a native body left out (the record has no body of it))"]))
      (check "negative: X with a record's twin drops nobody but X and E" (mapv :name (:kept (br/native-fallback (assoc-in es [2 :twin?] true)))) ["A" "B" "Y" "D" "F" "G"])
      (check "negative: nothing failing keeps every body" (count (:kept (br/native-fallback (remove #(nil? (:body %)) es)))) 6))
    ;; queue 503: a library closure as rustc prints another crate's closure (finish_grow's, an impl's method: print_def_path at
    ;; the impl's arguments, A = Global a default left out; the struct's path def_path_str in value form), in a small interface
    (let [si {:fns {"alloc::raw_vec::{impl#7}::finish_grow" {:generics [] :parent-count 1 :has-self false}
                    "x::f" {:generics '[(type "M")] :parent-count 0 :has-self false}}
              :impls {"alloc::raw_vec::{impl#7}" {:trait nil :self '(adt "alloc::raw_vec::RawVecInner" [(param 0 "A")]) :generics '[(type "A")] :parent-count 0}}
              :adts {"alloc::raw_vec::RawVecInner" {:generics '[(type "A" (adt "alloc::alloc::Global" []))]}}}
          sd {:generics {"alloc::raw_vec::RawVecInner" '[(type "A" (adt "alloc::alloc::Global" []))]}
              :kinds {"alloc::raw_vec::RawVecInner" "Struct" "alloc::raw_vec" "Mod" "alloc::alloc::Global" "Struct" "x" "Mod" "x::f" "Fn"}}
          cl (fn [p args] [:closure p [:fnsig [] [:tuple []]] args [:upvars] :fn-once])
          g [[:adt "alloc::alloc::Global" []]]]
      (binding [c/*si* si c/*std* sd]
        (check "a library closure inside an impl's method: rustc's text and struct path"
               (c/lib-closure-print (cl "alloc::raw_vec::{impl#7}::finish_grow::{closure#0}" g))
               ["alloc::raw_vec::RawVecInner::finish_grow" "alloc::raw_vec::RawVecInner::<A>::finish_grow" "{closure#0}"])
        (check "its type's text, the record's" (binding [c/*in-value* false] (c/print-ty (cl "alloc::raw_vec::{impl#7}::finish_grow::{closure#0}" g)))
               "{closure@alloc::raw_vec::RawVecInner::finish_grow::{closure#0}}")
        (check "a free function's closure keeps its parent's arguments (begin_panic<u64>'s)"
               (binding [c/*in-value* false] (c/print-ty (cl "x::f::{closure#0}" [[:uint "u64"]]))) "{closure@x::f<u64>::{closure#0}}")
        (check "negative: the parent's path with its arguments appended (464's text) is not rustc's"
               (let [[pp seg] (c/lib-closure-path (cl "alloc::raw_vec::{impl#7}::finish_grow::{closure#0}" g))] (= (str pp "<std::alloc::Global>::" seg) "alloc::raw_vec::RawVecInner::finish_grow::{closure#0}"))
               false)))
    ;; queue 503: a library closure's aggregate as the instance writes it (closure-aggregates): the built `(closure TEXT []
    ;; NAMES SPAN)` the struct of its local's type
    (let [st '(closure "a::f::{closure#0}" [(ty "i32" (int "i32"))])
          b (fn [lty] {:locals [{:ty '(ty "()" (tuple))} {:ty lty}]
                       :blocks [{:stmts ['(assign (place 1) (aggregate (closure "{closure@a.rs:1:2: 1:5}" [] ["n"] "a.rs:1:2: 1:5") [(move (place 2))]))] :term '(return)}]})]
      (check "a library closure's aggregate takes its local's struct"
             (first (:stmts (first (:blocks (br/closure-aggregates (b (list 'ty "{closure@a::f::{closure#0}}" st)))))))
             (list 'assign '(place 1) (list 'aggregate (list 'closure (second st) (nth st 2) nil "a.rs:1:2: 1:5") '[(move (place 2))])))
      (check "negative: a program's closure (typeck's text in the local's struct) stays"
             (let [x (b '(ty "{closure@a.rs:1:2: 1:5}" (closure "{closure@a.rs:1:2: 1:5}" [] ["n"] "a.rs:1:2: 1:5")))] (= x (br/closure-aggregates x))) true))
    ;; queue 503: alloc's own Box (a local def id while alloc's bodies are built for its export) is Box: its deref builtin
    (check "std's Box is Box" (c/box-adt? "alloc::boxed::Box") true)
    (check "negative: another ADT is not" (c/box-adt? "alloc::vec::Vec") false)
    (check "negative: a local def id outside a crate's definitions is not" (c/box-adt? 4) false)
    ;; queue 503: a crate-private trait impl the run's interface takes, indexed under its trait for selection
    (let [si (c/add-iface-impl {} "a::f::{impl#1}" {:trait '(trait "a::f::ConvertVec" [(param 0 "T")]) :self '(param 0 "T") :generics '[(type "T")]})]
      (check "a body's trait impl indexed under its trait (a blanket impl)" [(get (:trait-impls si) "a::f::ConvertVec") (get-in si [:trait-impls-by "a::f::ConvertVec" :blanket])]
             [["a::f::{impl#1}"] ["a::f::{impl#1}"]])
      (check "negative: an inherent impl is no trait's candidate"
             (let [s (c/add-iface-impl {} "a::{impl#0}" {:trait nil :self '(adt "a::S" [])})] [(:trait-impls s) (get-in s [:inherent "a::S"])])
             [nil ["a::{impl#0}"]]))
    ;; queue 503: specialization between impls of the same header by their where clauses (slice::cmp's SlicePartialEq: the
    ;; BytewiseEq<B> impl's clause entails the PartialEq<B> one's through BytewiseEq's supertrait, not the other way)
    (let [si {:impls {"c::{impl#4}" {:predicates '[(trait "core::marker::Sized" [(param 0 "A")]) (trait "core::cmp::PartialEq" [(param 0 "A") (param 1 "B")])]}
                      "c::{impl#5}" {:predicates '[(trait "core::marker::Sized" [(param 0 "A")]) (trait "c::BytewiseEq" [(param 0 "A") (param 1 "B")])]}
                      "c::{impl#6}" {:predicates '[(trait "c::Other" [(param 0 "A") (param 1 "B")])]}}
              :traits {"c::BytewiseEq" {:predicates '[(trait "core::marker::Sized" [(param 0 "Self")]) (trait "core::cmp::PartialEq" [(param 0 "Self") (param 1 "Rhs")])]}}}
          ent? (fn [a b] (binding [c/*si* si] (#'tc/clauses-entail? a b)))]
      (check "the BytewiseEq impl's clauses entail the PartialEq impl's (its supertrait)" (ent? "c::{impl#5}" "c::{impl#4}") true)
      (check "negative: the PartialEq impl's do not entail the BytewiseEq impl's" (ent? "c::{impl#4}" "c::{impl#5}") false)
      (check "negative: an unrelated trait's clause entails neither" [(ent? "c::{impl#6}" "c::{impl#4}") (ent? "c::{impl#4}" "c::{impl#6}")] [false false]))
    ;; the negative cases: what -O0's passes do not explain
    (check "negative: another operand" (br/pack-compare (assoc-in ours [:blocks 0 :term] (list 'call callee '[(const "const 1_i8" (ty "i8" (int "i8")) (scalar 1 1))] '(place 0) 1 '(unreachable))) rec) :differs)
    (check "negative: a local's type" (br/pack-compare (assoc-in ours [:locals 1 :ty] u8) rec) :differs)
    (check "negative: a block's cleanup flag" (br/pack-compare (assoc-in ours [:blocks 1 :cleanup] true) rec) :differs)
    (check "negative: a borrowed temporary is not propagated"
           (br/pack-compare (update-in ours [:blocks 0 :stmts] conj '(assign (place 0) (ref :shared (place 2)))) rec) :differs)
    (check "negative: the unwind action" (br/pack-compare (assoc-in ours [:blocks 0 :term] (list 'call callee '[(move (place 2))] '(place 0) 1 '(continue))) rec) :differs)
    ;; C1's first drop glue bug: drop_glue::<dyn Any + Send> called itself (its shim's `drop((*_1))` given its own glue)
    (let [norm-r (nth (chk/normalize (list 'llvm/define 'g/glue 'void '[[ptr %0] [ptr %1]] :body rustc-dyn-drop) {}) 4)
          dyn-forms (body-forms (glue-body ptr-dyn "glue"))]
      (check "C1: a trait object's drop is virtual (the vtable's drop_in_place, when not null), as std's IR"
             (if (= norm-r dyn-forms) :equal [:differs dyn-forms]) :equal)
      (check "C1 control: a sized pointee's drop calls its glue, not the vtable"
             (let [sized (body-forms (glue-body (list 'ty "*mut std::string::String" (list 'ptr '(ty "std::string::String" (adt "std::string::String" [])) true)) "glue_string"))]
               (if (= sized dyn-forms) [:equal] [:differs sized]))
             :differs))
    ;; C1's second and third bugs: the run's interface takes the crates' native facts where it has none (RF_EXTRA_IFACE): a
    ;; crate-private callee's signature (core::char::convert::from_u32_unchecked: else `{no sig ..}` and the upstream symbol), a
    ;; dependency's ADT (hashbrown's: needs_drop by its fields), a private type's trait impl (indexed under its trait)
    (let [f (str (or (System/getenv "TMPDIR") ".tmp") "/c1-extra-iface.edn")
          sig '{:generics [] :parent-count 0 :has-self false :predicates [] :inputs [(prim "u32")] :output (prim "char") :variadic false :safety "Unsafe" :abi "\"Rust\"" :const true :promotable false :nounwind false}
          raw '{:kind "Struct" :generics [(type "T")] :variants [{:fields [["ptr" (ptr false (param 0 "T"))] ["end" (ptr false (param 0 "T"))]]}]}
          fnmut '{:generics [] :parent-count 0 :predicates [] :self (adt "core::str::IsWhitespace" []) :trait (trait "core::ops::function::FnMut" [(adt "core::str::IsWhitespace" []) (tuple [(prim "char")])]) :items []}
          _ (spit f (pr-str {:fns {"core::char::convert::from_u32_unchecked" sig "core::mem::drop" (assoc sig :output '(prim "u8"))}
                             :adts {"hashbrown::raw::RawIterRange" raw} :impls {"core::str::{impl#9}" fnmut}}))
          si {:fns {"core::mem::drop" sig} :adts {} :impls {} :traits {} :inherent {} :trait-impls {}}
          [si2 _] (binding [br/*extra-iface* f] (br/with-extra-iface si {:kinds {} :generics {}}))]
      (check "C1: a crate-private callee's signature and a dependency's ADT from the crates' native facts"
             (if (and (= sig (get-in si2 [:fns "core::char::convert::from_u32_unchecked"])) (= raw (get-in si2 [:adts "hashbrown::raw::RawIterRange"]))) :equal [:differs (keys (:fns si2))]) :equal)
      (check "C1: a private type's trait impl indexed under its trait"
             (if (some #(= "core::str::{impl#9}" (if (map? %) (:path %) %)) (get-in si2 [:trait-impls "core::ops::function::FnMut"])) :equal [:differs (get-in si2 [:trait-impls])]) :equal)
      (check "C1 control: the interface's own fact is kept (an extra fact never replaces one)"
             (if (= (get-in si2 [:fns "core::mem::drop" :output]) '(prim "u8")) [:equal] [:differs (get-in si2 [:fns "core::mem::drop" :output])]) :differs))
    ;; C6-4: LLVM 23's float text (AsmWriter's writeAPFloatInternal over APFloat::toString's truncating precision 6): std's IR
    ;; writes `float 1e-4` as f0x38D1B717 (its six digits 9.99999e-05 read back as another float), 1.0 as 1.000000e+00
    (let [fp #'cg/fp-form]
      (check "C6-4: float 1e-4 in hex, float 1.0 and double 0.5 in decimal, as std's IR"
             [(fp 32 (Float/floatToRawIntBits (float 1e-4))) (fp 32 (Float/floatToRawIntBits (float 1.0))) (fp 64 (Double/doubleToRawLongBits 0.5))]
             '[(fp "f0x38D1B717") (fp "1.000000e+00") (fp "5.000000e-01")])
      (check "C6-4 control: double 0.1 reads back from its six digits (decimal, not hex)" (fp 64 (Double/doubleToRawLongBits 0.1)) '(fp "1.000000e-01")))
    ;; C6-4: rvalue.rs' try_codegen_const_aggregate_as_immediate: `(9_u8, 1000000000_u32)` into memory one i64 store (grisu's
    ;; max_pow10_no_more_than in std's IR); the control, a field not constant, two stores
    (let [u8t '(ty "u8" (uint "u8")) u32t '(ty "u32" (uint "u32"))
          tup (list 'ty "(u8, u32)" (list 'tuple u8t u32t)) rtup (list 'ty "&(u8, u32)" (list 'ref tup false))
          lt (merge glue-lt
                    {"u8" '{:size 1 :align 1 :abi (scalar (int 8 false [0N 255N])) :fields [] :variants (single 0) :uninhabited false}
                     "u32" '{:size 4 :align 4 :abi (scalar (int 32 false [0N 4294967295N])) :fields [] :variants (single 0) :uninhabited false}
                     "(u8, u32)" '{:size 8 :align 4 :abi (pair (int 8 false [0N 255N]) (int 32 false [0N 4294967295N]) 4) :fields [0 4] :variants (single 0) :uninhabited false}
                     "&(u8, u32)" '{:size 8 :align 8 :abi (scalar (ptr [1N 18446744073709551615N])) :fields [] :variants (single 0) :uninhabited false}})
          body (fn [second-op] {:form :body :symbol "agg" :args 1 :ret unit
                                :locals [{:mut true :ty unit} {:mut false :ty u32t} {:mut true :ty tup} {:mut false :ty rtup}] :debug []
                                :blocks [{:cleanup false :stmts [(list 'assign '(place 2) (list 'aggregate '(tuple) [(list 'const "const 9_u8" u8t '(scalar 9 1)) second-op]))
                                                                 '(assign (place 3) (ref :shared (place 2)))]
                                          :term '(return)}]})
          stores (fn [b] (let [forms (cg/codegen-fn b lt (cg/new-globals {}))]
                           (vec (for [x (tree-seq coll? seq forms) :when (and (seq? x) (= 'store (first x)))] (second x)))))]
      (check "C6-4: a constant aggregate into memory, one integer store" (stores (body (list 'const "const 1000000000_u32" u32t '(scalar 1000000000 4))))
             '[[i64 4294967296000000009]])
      (check "C6-4 control: a field not constant, a store a field" (count (stores (body '(copy (place 1))))) 2))
    ;; C6-4: the IRBuilder's ConstantFolder over a returned pair: a constant first half folds into a constant struct (std's
    ;; current_os_id: `insertvalue {i64, i64} {i64 1, i64 poison}, i64 %2, 1`); the control, no constant, two instructions
    (let [i64t '(ty "i64" (int "i64")) pr (list 'ty "(i64, i64)" (list 'tuple i64t i64t))
          lt (merge glue-lt {"i64" '{:size 8 :align 8 :abi (scalar (int 64 true [0N 18446744073709551615N])) :fields [] :variants (single 0) :uninhabited false}
                             "(i64, i64)" '{:size 16 :align 8 :abi (pair (int 64 true [0N 18446744073709551615N]) (int 64 true [0N 18446744073709551615N]) 8) :fields [0 8] :variants (single 0) :uninhabited false}})
          body (fn [first-op] {:form :body :symbol "pr" :args 1 :ret pr :locals [{:mut true :ty pr} {:mut false :ty i64t}] :debug []
                               :blocks [{:cleanup false :stmts [(list 'assign '(place 0) (list 'aggregate '(tuple) [first-op '(copy (place 1))]))] :term '(return)}]})
          ivs (fn [b] (vec (for [x (tree-seq coll? seq (cg/codegen-fn b lt (cg/new-globals {}))) :when (and (seq? x) (= 'insertvalue (first x)))] (second x))))]
      (check "C6-4: a returned pair's constant half folded into a constant struct" (ivs (body (list 'const "const 1_i64" i64t '(scalar 1 8))))
             '[[(struct i64 i64) (struct [i64 1] [i64 poison])]])
      (check "C6-4 control: a pair of values, two insertvalues" (count (ivs (body '(copy (place 1))))) 2))
    ;; queue 512 (503-1): core-check's names take its crate-private traits' generics (BytewiseEq<Rhs = Self>), where std's have none
    (let [bw '[(type "Self") (type "Rhs" (param 0 "Self"))]
          std2 (cc/with-native-std {:mods {} :generics {"core::cmp::PartialEq" '[(type "Self")]}}
                                   {:traits {"core::cmp::bytewise::BytewiseEq" {:generics bw} "core::cmp::PartialEq" {:generics bw}}})]
      (check "512: a crate-private trait's generics in core-check's names"
             (if (= bw (get-in std2 [:generics "core::cmp::bytewise::BytewiseEq"])) [:equal] [:differs (:generics std2)]) [:equal])
      (check "512 control: std's own generics are kept (a native trait's never replaces them)"
             (if (= bw (get-in std2 [:generics "core::cmp::PartialEq"])) [:equal] [:differs (get-in std2 [:generics "core::cmp::PartialEq"])]) :differs))
    ;; queue 512: a promoted constant of an instance-judged body named by the instance's def path at its arguments, as rustc's
    ;; optimized MIR of the instance prints it (slice::cmp's `<impl at ..>::compare::promoted[0]` against
    ;; `<u8 as core::slice::cmp::SliceOrd>::compare::promoted[0]`)
    (let [pt (fn [d v] (binding [br/*instance-def* d] (#'br/promoted-text v [])))
          v '(unevaluated "hint::<impl at x.rs:1:1: 1:9>::f" [] 0)]
      (check "512: a promoted constant at the instance: the instance's path"
             (let [t (pt "core::hint::black_box" v)] (if (= t "const core::hint::black_box::promoted[0]") [:equal] [:differs t])) [:equal])
      (check "512 control: an inline const (no promoted index) is not renamed"
             (let [t (pt "core::hint::black_box" '(unevaluated "mem::needs_drop::<T>::{constant#0}" [] nil))] (if t [:equal] [:differs t])) :differs)
      (check "512 control: a closure's body keeps its text (its MIR name is its owner's)"
             (let [t (pt "core::hint::black_box::{closure#0}" v)] (if t [:equal] [:differs t])) :differs))
    ;; C6-4 after 512-1: a call whose cleanup is a no-op landing pad (a bare resume, kept by the runtime pipeline since 512-1) is
    ;; codegen'd as rustc's MIR after RemoveNoopLandingPads gives it: no personality, no block for the pad, the return merged
    ;; (vectors' VacantEntry::insert after std's export was made again); the control, a pad that calls a drop first, keeps both
    (let [fty '(ty "fn() {g}" (fndef "g" []))
          callee '(callee {:kind "item" :symbol "g" :can-unwind true})
          body (fn [pad-stmts pad-term] {:form :body :symbol "np" :args 0 :ret unit :locals [{:mut true :ty unit} {:mut true :ty unit}] :debug []
                                         :blocks [{:cleanup false :stmts [] :term (list 'call (list 'const "g" fty '(zst)) [] '(place 1) 1 '(cleanup 2) callee '(loc "?" 0 0) 0)}
                                                  {:cleanup false :stmts [] :term '(return)}
                                                  {:cleanup true :stmts pad-stmts :term pad-term}]})
          shape (fn [b] (let [f (vec (cg/codegen-fn b glue-lt (cg/new-globals {}))) i (.indexOf ^java.util.List f :body)]
                          [(boolean (some #{:personality} f)) (count (nth f (inc i)))]))]
      (check "C6-4: a no-op landing pad: no personality, one block" (shape (body [] '(resume))) [false 1])
      (check "C6-4 control: a landing pad that does something keeps the personality and its block"
             (let [[p n] (shape (body [] (list 'call (list 'const "g" fty '(zst)) [] '(place 1) nil '(continue) callee '(loc "?" 0 0) 0)))] (if (and p (> n 1)) [:differs p n] [:equal p n])) :differs))
    ;; C1 (2026-11-22, rust-c4-1122): TypeId::of's constant as std's IR writes it, each 8 bytes of the hash a pointer
    ;; `inttoptr (i64 N to ptr)` (rustc_codegen_llvm's scalar_to_backend for GlobalAlloc::TypeId), not bytes: the record's
    ;; TypeId::of::<u32> (the pack rust-front-rsi's unwind) against std's IR's @anon of the same hash
    (let [tid '(ty "std::any::TypeId" (adt "std::any::TypeId" "core::any::TypeId" []))
          lt {"std::any::TypeId" '{:size 16 :align 8 :abi (memory true) :fields [0] :variants (single 0) :uninhabited false}}
          b (fn [bytes] {:form :body :symbol "tid" :args 0 :ret tid :locals [{:mut true :ty tid}] :debug []
                         :blocks [{:cleanup false :stmts [(list 'assign '(place 0) (list 'use (list 'const "const std::any::TypeId::of::<u32>::{constant#0}" tid '(indirect alloc168 0))))]
                                   :term '(return)}]
                         :alloc-data [["alloc168" {:kind :memory :align 8 :mutable false :bytes bytes :init "1111111111111111" :relocs [[0 "alloc170"] [8 "alloc170"]]}]
                                      ["alloc170" {:kind :other}]]})
          consts (fn [bytes] (let [gl (cg/new-globals {})] (cg/codegen-fn (b bytes) lt gl) (vec (keys (:consts @gl)))))
          std-ir '[(packed ptr ptr) (packed [ptr (inttoptr i64 -8815622259637286671 ptr)] [ptr (inttoptr i64 8786967495329273992 ptr)]) 8]]
      (check "C1: TypeId::of::<u32>'s constant as std's IR's (two inttoptr pointers)"
             (if (= [std-ir] (consts "f1084b14439ea885885801b46194f179")) :equal [:differs (consts "f1084b14439ea885885801b46194f179")]) :equal)
      (check "C1 control: another hash's constant differs" (if (= [std-ir] (consts "f1084b14439ea885885801b46194f17a")) [:equal] [:differs]) :differs))
    ;; C1: a scalar pair's niche tag is the component at the tag field's offset (codegen_get_discr's extract_field):
    ;; Option<(usize, char)>'s is the char (offset 8), so the discriminant compares the second value with the niche -1
    (let [opt '(ty "std::option::Option<(usize, char)>" (adt "std::option::Option" "core::option::Option" [(ty "(usize, char)" (tuple [(ty "usize" (uint "usize")) (ty "char" (char))]))]))
          isz '(ty "isize" (int "isize"))
          lt {"std::option::Option<(usize, char)>" '{:size 16 :align 8 :abi (pair (int 64 false nil) (int 32 false [4294967295 1114111]) 8) :fields [8]
                                                     :variants (multiple {:tag (int 32 false [4294967295 1114111]) :tag-field 0 :encoding (niche 1 0 0 4294967295)
                                                                          :variants [{:offsets [] :uninhabited false} {:offsets [0] :uninhabited false}]})
                                                     :discrs [0 1] :uninhabited false}
              "isize" '{:size 8 :align 8 :abi (scalar (int 64 true [0 18446744073709551615])) :fields (primitive) :variants (single 0) :uninhabited false}}
          b {:form :body :symbol "discr" :args 1 :ret isz :locals [{:mut true :ty isz} {:mut false :ty opt}] :debug []
             :blocks [{:cleanup false :stmts ['(assign (place 0) (discriminant (place 1)))] :term '(return)}]}
          f (let [gl (cg/new-globals {})] (cg/codegen-fn b lt gl))
          cmp (first (filter #(and (seq? %) (= 'icmp (first %))) (tree-seq coll? seq f)))]
      (check "C1: Option<(usize, char)>'s discriminant reads the char (the pair's second value) against -1"
             (if (and cmp (= '[i32 %_1.1 -1] [(nth cmp 2) (nth cmp 3) (nth cmp 4)])) :equal [:differs cmp]) :equal))
    (println (str "pack-compare-test: " (if (zero? @bad) "passed" (str @bad " failed"))))
    (System/exit (if (zero? @bad) 0 1))))

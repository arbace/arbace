(ns rust.front.pack-compare-test
  "Queue 443 (RUST-90 S4, C2; doc/rust/FRONTEND-SURVEY.md, \"As built: S4's alloc and std bodies\"): build-run's pack-compare, the
  judge of an instance-judged library body (alloc's, std's) against the record's optimized body at -O0. Pure cases: the record's
  facts beside the forms ignored, RemoveStorageMarkers, SimplifyCfg's goto chain, CopyProp's copy of an argument (a move made a
  copy, as rustc's optimized MIR writes it), SimplifyLocals' unused local and renumbering, each named in :equal-o0; the negative
  cases (an operand, a local's type, a block's cleanup flag, a borrowed temporary not propagated) differ. `bin/rust-front
  pack-compare-test`."
  (:require [arbace.rust.front.build-run :as br] [arbace.rust.front.passes :as passes] [arbace.rust.front.mono :as mono]))

(def i8 '(ty "i8" (int "i8")))
(def u8 '(ty "u8" (uint "u8")))
(def callee (list 'const "std::intrinsics::black_box::<i8>" '(ty "fn(i8) -> i8 {std::intrinsics::black_box::<i8>}" (fndef "std::intrinsics::black_box" [(ty "i8" (int "i8"))])) '(zst)))

;; rustc's -O0 optimized black_box::<i8>, as the pack rust-front-rsi records it (its symbols, callee and location beside the forms)
(def rec {:args 1 :locals [{:mut true :scope 0 :ty i8} {:mut false :scope 0 :ty i8}] :debug [{:name "dummy" :scope 0 :value '(place 1)}]
          :blocks [{:cleanup false :stmts [] :after-dbg []
                    :term (list 'call (concat callee [:fn-symbol "_RINvNtCs_4core10intrinsics9black_boxaE"]) '[(copy (place 1))] '(place 0) 1 '(unreachable)
                                '(callee {:kind "intrinsic" :symbol ""}) '(loc "library/core/src/hint.rs" 491 5) 0)}
                   {:cleanup false :stmts [] :after-dbg [] :term '(return)}]})

;; our runtime MIR of the same instance (the built temporary, its storage markers)
(def ours {:args 1 :locals [{:ty i8} {:ty i8} {:ty i8}] :debug [{:name "dummy" :value '(place 1)}]
           :blocks [{:cleanup false :stmts ['(storage-live 2) '(assign (place 2) (use (move (place 1))))]
                     :term (list 'call callee '[(move (place 2))] '(place 0) 1 '(unreachable))}
                    {:cleanup false :stmts ['(storage-dead 2)] :term '(return)}]})

(defn -main [& _]
  (let [bad (atom 0)
        check (fn [what got want] (let [ok (= want (if (= :differs want) (first got) got))]
                                    (println (if ok "ok  " "FAIL") what (pr-str got)) (when-not ok (swap! bad inc))))]
    (check "the record against itself" (br/pack-compare rec rec) [:equal])
    (check "the record's facts beside the forms ignored (its symbols, callee, location)"
           (br/pack-compare (update rec :blocks (fn [bs] (assoc-in bs [0 :term] (list 'call callee '[(copy (place 1))] '(place 0) 1 '(unreachable))))) rec) [:equal])
    (check "storage markers alone" (br/pack-compare (update-in rec [:blocks 1 :stmts] conj '(storage-dead 1)) rec) [:equal-but-storage])
    (check "our built instance: CopyProp's copy, SimplifyLocals, storage" (br/pack-compare ours rec) [:equal-o0 "copy-prop,locals,storage"])
    (check "a goto chain and a dead local too"
           (br/pack-compare {:args 1 :locals [{:ty i8} {:ty i8} {:ty i8} {:ty i8}] :debug [{:name "dummy" :value '(place 1)}]
                             :blocks [{:cleanup false :stmts ['(storage-live 2) '(assign (place 2) (use (move (place 1))))] :term '(goto 1)}
                                      {:cleanup false :stmts ['(assign (place 3) (use (copy (place 2))))] :term (list 'call callee '[(move (place 2))] '(place 0) 2 '(unreachable))}
                                      {:cleanup false :stmts ['(storage-dead 2)] :term '(return)}]}
                            rec)
           [:equal-o0 "cfg,copy-prop,locals,storage"])
    (let [rt '(ty "&i8" (ref (ty "i8" (int "i8")) false))
          callr (list 'const "f" '(ty "fn(&i8) -> i8 {f}" (fndef "f" [])) '(zst))
          r {:args 1 :locals [{:ty i8} {:ty rt}] :debug []
             :blocks [{:cleanup false :stmts [] :term (list 'call callr '[(copy (place 1))] '(place 0) 1 '(continue))} {:cleanup false :stmts [] :term '(return)}]}
          o {:args 1 :locals [{:ty i8} {:ty rt} {:ty rt}] :debug []
             :blocks [{:cleanup false :stmts ['(storage-live 2) '(assign (place 2) (ref :shared (place 1 (deref))))] :term (list 'call callr '[(move (place 2))] '(place 0) 1 '(continue))}
                      {:cleanup false :stmts ['(storage-dead 2)] :term '(return)}]}]
      (check "a reborrow: InstSimplify's &(*_1), then CopyProp" (br/pack-compare o r) [:equal-o0 "copy-prop,inst-simplify,locals,storage"])
      (check "negative: a reborrow of another type is not simplified"
             (br/pack-compare (assoc-in o [:locals 2 :ty] '(ty "&mut i8" (ref (ty "i8" (int "i8")) true))) r) :differs))
    (let [unit '(ty "()" (tuple))
          callu (list 'const "g" '(ty "fn() {g}" (fndef "g" [])) '(zst))
          r {:args 0 :locals [{:ty unit}] :debug [] :blocks [{:cleanup false :stmts [] :term (list 'call callu [] '(place 1) 1 '(continue))} {:cleanup false :stmts [] :term '(return)}]}
          o (assoc-in r [:blocks 1 :stmts] ['(assign (place 0) (use (const "const ()" (ty "()" (tuple)) (zst))))])]
      (check "RemoveZsts: `_0 = const ()` dropped" (br/pack-compare o r) [:equal-o0 "zsts"]))
    (let [callr (list 'const "f" '(ty "fn() -> i8 {f}" (fndef "f" [])) '(zst))
          r {:args 0 :locals [{:ty i8}] :debug [] :blocks [{:cleanup false :stmts [] :term (list 'call callr [] '(place 0) 1 '(continue))} {:cleanup false :stmts [] :term '(return)}]}
          o {:args 0 :locals [{:ty i8} {:ty i8}] :debug []
             :blocks [{:cleanup false :stmts [] :term (list 'call callr [] '(place 1) 1 '(continue))} {:cleanup false :stmts ['(assign (place 0) (use (copy (place 1))))] :term '(return)}]}]
      (check "RenameReturnPlace: `_0 = copy _1` after the call, _1 renamed _0" (br/pack-compare o r) [:equal-o0 "locals,nrvo"])
      (check "negative: the return place from a local assigned twice is not renamed"
             (br/pack-compare (update-in o [:blocks 1 :stmts] #(into ['(assign (place 1) (use (copy (place 1))))] %)) r) :differs))
    ;; queue 448: SizedTypeProperties' constants evaluated at the instance (sized-const-eval, a stub layout), the record's LAYOUT
    ;; allocation compared by its bytes
    (let [usz '(ty "usize" (uint "usize"))
          lay '(ty "std::alloc::Layout" (adt "std::alloc::Layout" "DefId(2:1 ~ core[0]::alloc::layout::Layout)" []))
          s24 [:adt "alloc::string::String" []]
          uc (fn [nm ty] (list 'const (str "const <std::string::String as std::mem::SizedTypeProperties>::" nm) ty
                               (with-meta (list 'unevaluated (str "core::mem::SizedTypeProperties::" nm) [] nil) {:nc [(str "core::mem::SizedTypeProperties::" nm) [s24]]})))
          body (fn [c] {:args 0 :locals [{:ty usz}] :debug [] :blocks [{:cleanup false :stmts [(list 'assign '(place 0) (list 'use c))] :term '(return)}]})
          layout (fn [t] (if (= t [:adt "core::alloc::layout::Layout" []]) {:size 16 :align 8 :fields [8 0]} {:size 24 :align 8 :fields [0 8 16]}))
          ev (fn [b] (binding [br/*type-layout* layout] (#'br/sized-const-eval b)))
          rec-max (body (list 'const "const <std::string::String as std::mem::SizedTypeProperties>::MAX_SLICE_LEN" usz '(scalar 384307168202282325 8)))]
      (check "SizedTypeProperties::MAX_SLICE_LEN at String: isize::MAX / 24" (br/pack-compare (ev (body (uc "MAX_SLICE_LEN" usz))) rec-max) [:equal])
      (check "negative: MAX_SLICE_LEN left unevaluated without a layout" (br/pack-compare (body (uc "MAX_SLICE_LEN" usz)) rec-max) :differs)
      (check "SizedTypeProperties::ALIGNMENT at String: the alignment's scalar"
             (br/pack-compare (ev (body (uc "ALIGNMENT" usz))) (body (list 'const "const <std::string::String as std::mem::SizedTypeProperties>::ALIGNMENT" usz '(scalar 8 8)))) [:equal])
      (check "negative: SIZE is not MAX_SLICE_LEN" (br/pack-compare (ev (body (uc "SIZE" usz))) rec-max) :differs)
      (let [rec-l (assoc (assoc-in (body (list 'const "const <std::string::String as std::mem::SizedTypeProperties>::LAYOUT" lay '(indirect alloc605 0))) [:locals 0 :ty] lay)
                         :alloc-data [["alloc605" {:kind :memory :align 8 :mutable false :bytes "08000000000000001800000000000000" :init "1111111111111111" :relocs []}]])
            ours-l (assoc-in (ev (body (uc "LAYOUT" lay))) [:locals 0 :ty] lay)]
        (check "SizedTypeProperties::LAYOUT at String: its bytes (align, then size) against the record's allocation" (br/pack-compare ours-l rec-l) [:equal])
        (check "negative: another type's LAYOUT" (br/pack-compare ours-l (assoc-in rec-l [:alloc-data 0 1 :bytes] "08000000000000002000000000000000")) :differs))
      (let [isz '(ty "isize" (int "isize"))
            lc (fn [p id] (list 'const (str "const " p) isz (with-meta (list 'unevaluated id [] nil) {:nc [p []]})))
            rec-u (body (list 'const "const core::cell::UNUSED" isz '(scalar 0 8)))]
        (check "core::cell::UNUSED by its local def id: 0" (br/pack-compare (ev (body (lc "core::cell::UNUSED" "85"))) rec-u) [:equal])
        (check "negative: another private constant stays unevaluated" (br/pack-compare (ev (body (lc "core::cell::OTHER" "86"))) (body (lc "core::cell::OTHER" "86"))) [:equal])
        (check "negative: ... and differs from the record's value" (br/pack-compare (ev (body (lc "core::cell::OTHER" "86"))) (body (list 'const "const core::cell::OTHER" isz '(scalar 0 8)))) :differs)))
    ;; queue n-rust-dyn: a trait object's type form `(dyn)` (build/ty-form's, the helper's), the record's unsizing cast's
    ;; vtable allocation not compared (the run's); a projection normalized at the instance by the run's solver
    (let [rd '(ty "&dyn std::fmt::Debug" (ref (ty "dyn std::fmt::Debug" (dyn)) false))
          rw '(ty "&dyn std::fmt::Write" (ref (ty "dyn std::fmt::Write" (dyn)) false))
          ri '(ty "&i8" (ref (ty "i8" (int "i8")) false))
          body (fn [t & vt] {:args 1 :locals [{:ty t} {:ty ri}] :debug []
                             :blocks [{:cleanup false :stmts [(list 'assign '(place 0) (concat (list 'cast "PointerCoercion(Unsize, Implicit)" '(copy (place 1)) t) vt))]
                                       :term '(return)}]})]
      (check "an unsizing cast to a trait object: the record's :vtable not compared" (br/pack-compare (body rd) (body rd :vtable 'alloc7)) [:equal])
      (check "negative: a cast to another trait object" (br/pack-compare (body rw) (body rd :vtable 'alloc7)) :differs))
    (let [proj [:proj "core::iter::traits::iterator::Iterator::Item" [[:adt "core::str::iter::Chars" [[:re-erased]]]]]
          norm (fn [t] (if (= t [:ref [:re-erased] false proj]) [:ref [:re-erased] false [:char]] t))]
      (check "a library projection normalized by the run's solver" (binding [br/*normalize-ty* norm] (#'br/instance-normalize [:ref [:re-erased] false proj])) [:ref [:re-erased] false [:char]])
      (check "negative: without the run's solver the projection stays" (#'br/instance-normalize [:ref [:re-erased] false proj]) [:ref [:re-erased] false proj]))
    ;; queue 474: SingleUseConsts on our body alone (assert_unsafe_precondition!'s `let msg = ".."` passed by a reborrow:
    ;; rustc's -O0 MIR writes `_t = const ".."` and msg's debug info the constant)
    (let [rs '(ty "&str" (ref (ty "str" str) false))
          unit '(ty "()" (tuple))
          msg '(const "const \"m\"" (ty "&str" (ref (ty "str" str) false)) (slice alloc1 1))
          fs (list 'const "f" '(ty "fn(&str) {f}" (fndef "f" [])) '(zst))
          r {:args 0 :locals [{:ty unit} {:ty rs}] :debug [{:name "msg" :value msg}]
             :blocks [{:cleanup false :stmts [(list 'assign '(place 1) (list 'use msg))] :term (list 'call fs '[(move (place 1))] '(place 0) 1 '(continue))}
                      {:cleanup false :stmts [] :term '(return)}]}
          o {:args 0 :locals [{:ty unit} {:ty rs} {:ty rs}] :debug [{:name "msg" :value '(place 1)}]
             :blocks [{:cleanup false :stmts ['(storage-live 1) (list 'assign '(place 1) (list 'use msg)) '(storage-live 2) '(assign (place 2) (ref :shared (place 1 (deref))))]
                       :term (list 'call fs '[(move (place 2))] '(place 0) 1 '(continue))}
                      {:cleanup false :stmts ['(storage-dead 2) '(storage-dead 1)] :term '(return)}]}]
      (check "SingleUseConsts: a const local used once (by a reborrow made a copy) becomes the operand, its debug info the constant"
             (br/pack-compare o r) [:equal-o0 "inst-simplify,locals,single-use-consts,storage"])
      (check "the pass is not idempotent (the record's `_1 = const` would go), so the record is not taken through it"
             (second (#'br/o0-single-use-consts r)) true)
      (check "negative: a const local used twice stays a local"
             (br/pack-compare (update-in o [:blocks 0 :stmts] conj '(assign (place 0) (use (copy (place 1))))) r) :differs)
      (check "negative: another constant" (br/pack-compare (assoc-in o [:blocks 0 :stmts 1] '(assign (place 1) (use (const "const \"n\"" (ty "&str" (ref (ty "str" str) false)) (slice alloc1 1))))) r) :differs))
    ;; queue 474: RemoveZsts before SimplifyCfg (unchecked_mul's `if ub_checks() { precondition_check(..) }`: both arms'
    ;; `_3 = const ()` gone, their goto blocks bypassed)
    (let [unit '(ty "()" (tuple)) bool '(ty "bool" bool)
          cz1 '(assign (place 1) (use (const "const ()" (ty "()" (tuple)) (zst))))
          cb (list 'const "c" '(ty "fn() -> bool {c}" (fndef "c" [])) '(zst))
          cp (list 'const "p" '(ty "fn() {p}" (fndef "p" [])) '(zst))
          r {:args 0 :locals [{:ty unit} {:ty bool} {:ty unit}] :debug []
             :blocks [{:cleanup false :stmts [] :term (list 'call cb [] '(place 1) 1 '(continue))}
                      {:cleanup false :stmts [] :term '(switch (move (place 1)) [[0 3]] 2)}
                      {:cleanup false :stmts [] :term (list 'call cp [] '(place 2) 3 '(unreachable))}
                      {:cleanup false :stmts [] :term '(return)}]}
          o {:args 0 :locals [{:ty unit} {:ty unit} {:ty bool} {:ty unit}] :debug []
             :blocks [{:cleanup false :stmts [] :term (list 'call cb [] '(place 2) 1 '(continue))}
                      {:cleanup false :stmts [] :term '(switch (move (place 2)) [[0 4]] 2)}
                      {:cleanup false :stmts [] :term (list 'call cp [] '(place 3) 3 '(unreachable))}
                      {:cleanup false :stmts ['(storage-dead 3) cz1] :term '(goto 5)}
                      {:cleanup false :stmts [cz1] :term '(goto 5)}
                      {:cleanup false :stmts [] :term '(return)}]}]
      (check "RemoveZsts before SimplifyCfg: the arms' unit assignments gone, their gotos bypassed" (br/pack-compare o r) [:equal-o0 "cfg,locals,storage,zsts"])
      (check "negative: an arm that assigns a value of a sized type stays a block"
             (br/pack-compare (-> o (assoc-in [:locals 1 :ty] bool) (assoc-in [:blocks 4 :stmts] ['(assign (place 1) (use (const "const true" (ty "bool" bool) (scalar 1 1))))])) r) :differs)
      (check "negative: the unwind action of a nounwind callee" (br/pack-compare (assoc-in o [:blocks 2 :term] (list 'call cp [] '(place 3) 3 '(continue))) r) :differs))
    ;; queue 474: a string constant by its bytes, ours `(raw-str N)` (our allocation's text) against the record's `(slice allocX LEN)`
    (let [rs '(ty "&str" (ref (ty "str" str) false))
          body (fn [v] {:args 0 :locals [{:ty rs}] :debug [] :blocks [{:cleanup false :stmts [(list 'assign '(place 0) (list 'use (list 'const "const \"ab\"" rs v)))] :term '(return)}]})
          r (assoc (body '(slice alloc7 2)) :alloc-data [["alloc7" {:kind :memory :align 1 :mutable false :bytes "6162" :init "11" :relocs []}]])
          o (assoc (body '(raw-str 1)) :alloc-texts {1 "\nalloc1 (size: 2, align: 1) {\n    61 62                                           │ ab\n}\n"})]
      (check "a string constant: our allocation's bytes against the record's" (br/pack-compare o r) [:equal])
      (check "negative: other bytes" (br/pack-compare (assoc o :alloc-texts {1 "\nalloc1 (size: 2, align: 1) {\n    61 63                                           │ ac\n}\n"}) r) :differs)
      (check "negative: the record's slice of another length" (br/pack-compare o (assoc-in r [:blocks 0 :stmts 0] '(assign (place 0) (use (const "const \"ab\"" (ty "&str" (ref (ty "str" str) false)) (slice alloc7 1)))))) :differs))
    ;; queue 479: SimplifyConstCondition after SingleUseConsts (assert_unsafe_precondition!'s `if !false`: unreachable_unchecked's
    ;; and NonZero::new_unchecked's precondition_check, `_1 = const false; switchInt(move _1)`: the record's arm alone, merged)
    (let [unit '(ty "()" (tuple)) bool '(ty "bool" bool) never '(ty "!" never) u8t '(ty "u8" (uint "u8"))
          cg (list 'const "g" '(ty "fn() -> u8 {g}" (fndef "g" [])) '(zst))
          cp (list 'const "p" '(ty "fn(u8) -> ! {p}" (fndef "p" [])) '(zst))
          cf '(const "const false" (ty "bool" bool) (scalar 0 1))
          r {:args 0 :locals [{:ty unit} {:ty never} {:ty u8t}] :debug []
             :blocks [{:cleanup false :stmts [] :term (list 'call cg [] '(place 2) 1 '(unreachable))}
                      {:cleanup false :stmts [] :term (list 'call cp '[(move (place 2))] '(place 1) nil '(unreachable))}]}
          o {:args 0 :locals [{:ty unit} {:ty bool} {:ty never} {:ty u8t}] :debug []
             :blocks [{:cleanup false :stmts ['(storage-live 1) (list 'assign '(place 1) (list 'use cf))] :term '(switch (move (place 1)) [[0 1]] 3)}
                      {:cleanup false :stmts ['(storage-live 3)] :term (list 'call cg [] '(place 3) 2 '(unreachable))}
                      {:cleanup false :stmts [] :term (list 'call cp '[(move (place 3))] '(place 2) nil '(unreachable))}
                      {:cleanup false :stmts ['(assign (place 0) (use (const "const ()" (ty "()" (tuple)) (zst)))) '(storage-dead 1)] :term '(return)}]}]
      (check "SimplifyConstCondition: a switch on a single-use constant made the goto its value selects, the dead arm gone"
             (br/pack-compare o r) [:equal-o0 "const-condition,locals,single-use-consts,storage,zsts"])
      (check "the record (through the pass already) is left as it is" (second (#'br/o0-simplify-const-condition r)) false)
      (check "negative: the constant selects the other arm (`const true`: the return)"
             (br/pack-compare (assoc-in o [:blocks 0 :stmts 1] (list 'assign '(place 1) (list 'use '(const "const true" (ty "bool" bool) (scalar 1 1))))) r) :differs)
      (check "negative: a switch on a local no constant is assigned to stays a switch"
             (br/pack-compare (assoc-in o [:blocks 0 :stmts] ['(storage-live 1)]) r) :differs))
    ;; queue 479: RemoveZsts on the locals zero-sized in the generic body (`?`'s residual in Box::try_new_uninit_in: rustc's
    ;; `from_residual(const Result::<Infallible, AllocError>::Err(AllocError))`, ours `_8 = copy ((_4 as Break).0);
    ;; from_residual(copy _8)`)
    (let [unit '(ty "()" (tuple)) rz '(ty "R" (adt "R" [])) cft '(ty "CF" (adt "CF" []))
          cf (list 'const "f" '(ty "fn(R) {f}" (fndef "f" [])) '(zst))
          r {:args 1 :locals [{:ty unit} {:ty cft}] :debug [{:name "r" :value (list 'const "const R::Err(E)" rz '(zst))}]
             :blocks [{:cleanup false :stmts [] :term (list 'call cf [(list 'const "const R::Err(E)" rz '(zst))] '(place 0) 1 '(continue))}
                      {:cleanup false :stmts [] :term '(return)}]}
          o {:args 1 :zst-locals #{2} :locals [{:ty unit} {:ty cft} {:ty rz}] :debug [{:name "r" :value '(place 2)}]
             :blocks [{:cleanup false :stmts ['(storage-live 2) (list 'assign '(place 2) (list 'use (list 'copy (list 'place 1 '(downcast "Break" 1) (list 'field 0 rz)))))]
                       :term (list 'call cf '[(copy (place 2))] '(place 0) 1 '(continue))}
                      {:cleanup false :stmts ['(storage-dead 2)] :term '(return)}]}]
      (check "RemoveZsts: a zero-sized local's assignment dropped, its operand the type's constant (compared by its type)"
             (br/pack-compare o r) [:equal-o0 "locals,storage,zsts"])
      (check "negative: a local not zero-sized in the generic body stays" (br/pack-compare (dissoc o :zst-locals) r) :differs)
      (check "negative: the record's constant of another type"
             (br/pack-compare o (assoc-in r [:blocks 0 :term] (list 'call cf [(list 'const "const R::Err(E)" cft '(zst))] '(place 0) 1 '(continue)))) :differs)
      (check "negative: a non-zero-sized constant's text is still compared"
             (br/pack-compare (assoc-in r [:blocks 0 :term] (list 'call cf ['(const "const 1_u8" (ty "u8" (uint "u8")) (scalar 1 1))] '(place 0) 1 '(continue)))
                              (assoc-in r [:blocks 0 :term] (list 'call cf ['(const "const 1" (ty "u8" (uint "u8")) (scalar 1 1))] '(place 0) 1 '(continue)))) :differs))
    ;; queue 483: LowerSliceLenCalls at the instance (core-instance): str::len's `<[u8]>::len(move _2)`, the record's
    ;; `_0 = PtrMetadata(move _2)` merged into the block of as_bytes' return
    (let [usz '(ty "usize" (uint "usize")) sr '(ty "&str" (ref (ty "str" str) false)) br8 '(ty "&[u8]" (ref (ty "[u8]" (slice (ty "u8" (uint "u8")))) false))
          fc (fn [txt d] (list 'const txt (with-meta (list 'ty (str "fn {" txt "}") (list 'fndef d [])) {:tc [:fndef d [[:uint "u8"]]]}) '(zst)))
          ab (fc "core::str::<impl str>::as_bytes" "core::str::{impl#0}::as_bytes")
          ln (fc "core::slice::<impl [u8]>::len" "core::slice::{impl#0}::len")
          o {:args 1 :locals [{:ty usz} {:ty sr} {:ty br8}] :debug [{:name "self" :value '(place 1)}]
             :blocks [{:cleanup false :stmts ['(storage-live 2)] :term (list 'call ab '[(copy (place 1))] '(place 2) 1 '(continue))}
                      {:cleanup false :stmts [] :term (list 'call ln '[(move (place 2))] '(place 0) 2 '(continue))}
                      {:cleanup false :stmts ['(storage-dead 2)] :term '(return)}]}
          r {:args 1 :locals [{:ty usz} {:ty sr} {:ty br8}] :debug [{:name "self" :value '(place 1)}]
             :blocks [{:cleanup false :stmts [] :term (list 'call ab '[(copy (place 1))] '(place 2) 1 '(continue))}
                      {:cleanup false :stmts ['(assign (place 0) (unop "PtrMetadata" (move (place 2))))] :term '(return)}]}
          lo (update o :blocks br/lower-slice-len-calls)]
      (check "LowerSliceLenCalls at the instance: `<[u8]>::len` by its def path made PtrMetadata, the goto merged"
             (br/pack-compare lo r) [:equal-o0 "cfg,storage"])
      (check "negative: the instance without the pass (the call kept)" (br/pack-compare o r) :differs)
      (check "negative: another callee is not lowered"
             (br/pack-compare (update (assoc-in o [:blocks 1 :term] (list 'call (fc "core::slice::<impl [u8]>::is_empty" "core::slice::{impl#0}::is_empty") '[(move (place 2))] '(place 0) 2 '(continue)))
                                      :blocks br/lower-slice-len-calls) r) :differs))
    ;; queue 483: LowerIntrinsics' overflowing operators (overflowing_mul at usize: `mul_with_overflow::<u64>(move _6, move _7)`,
    ;; the record's `_5 = MulWithOverflow(move _6, move _7)`, as the pack records it)
    (let [u64t '(ty "u64" (uint "u64")) usz '(ty "usize" (uint "usize")) bool '(ty "bool" bool)
          pair (fn [a] (list 'ty (str "(" (second a) ", bool)") (list 'tuple a bool)))
          mwo (list 'const "std::intrinsics::mul_with_overflow::<u64>"
                    (with-meta (list 'ty "fn(u64, u64) -> (u64, bool) {std::intrinsics::mul_with_overflow::<u64>}" (list 'fndef [u64t]))
                      {:tc [:fndef "core::intrinsics::mul_with_overflow" [[:uint "u64"]]]})
                    '(zst))
          tail ['(assign (place 3) (use (copy (place 5 (field 0 (ty "u64" (uint "u64")))))))
                '(assign (place 4) (use (copy (place 5 (field 1 (ty "bool" bool))))))
                '(assign (place 8) (cast "IntToInt" (copy (place 3)) (ty "usize" (uint "usize"))))
                '(assign (place 0) (aggregate (tuple) [(move (place 8)) (copy (place 4))]))]
          head ['(assign (place 6) (cast "IntToInt" (copy (place 1)) (ty "u64" (uint "u64"))))
                '(assign (place 7) (cast "IntToInt" (copy (place 2)) (ty "u64" (uint "u64"))))]
          locals (mapv (fn [t] {:ty t}) [(pair usz) usz usz u64t bool (pair u64t) u64t u64t usz])
          dbg (vec (for [i [1 2 3 4]] {:name "x" :value (list 'place i)}))
          o {:args 2 :locals locals :debug dbg
             :blocks [{:cleanup false :stmts head :term (list 'call mwo '[(move (place 6)) (move (place 7))] '(place 5) 1 '(unreachable))}
                      {:cleanup false :stmts tail :term '(return)}]}
          r {:args 2 :locals locals :debug dbg
             :blocks [{:cleanup false :stmts (vec (concat head ['(assign (place 5) (binop "MulWithOverflow" (move (place 6)) (move (place 7))))] tail)) :term '(return)}]}]
      (check "LowerIntrinsics: mul_with_overflow made MulWithOverflow, the goto merged" (br/pack-compare (passes/lower-intrinsics o) r) [:equal-o0 "cfg"])
      (check "negative: the instance without the pass (the intrinsic's call kept)" (br/pack-compare o r) :differs)
      (check "negative: the record's AddWithOverflow"
             (br/pack-compare (passes/lower-intrinsics o) (assoc-in r [:blocks 0 :stmts 2] '(assign (place 5) (binop "AddWithOverflow" (move (place 6)) (move (place 7)))))) :differs))
    ;; queue 483: drop_in_place's call of drop_glue::<T> taken natively only where the shim it resolves to is the record's
    ;; (drop-glue-ok-fn, mono's needs_drop and symbol stubbed)
    (let [shim (fn [tt sym] {:instance (str "Shim(DropGlue(DefId(2:3 ~ core[bdd4]::ptr::drop_glue), Some(" tt ")))") :symbol sym})
          ok? (fn [info recs] (with-redefs [mono/drop-glue-info (fn [_ _] info)] ((#'br/drop-glue-ok-fn nil recs) [:uint "u8"])))]
      (check "drop glue: T needs drop, the record's shim of T at mono's symbol" (ok? {:needs-drop true :symbol "_RS"} [(shim "u8" "_RS")]) true)
      (check "drop glue: T needs no drop, the record has no shim of T (the empty glue)" (ok? {:needs-drop false :symbol "_RS"} [(shim "u16" "_RT")]) true)
      (check "negative: the record's shim of T at another symbol" (ok? {:needs-drop true :symbol "_RS"} [(shim "u8" "_RX")]) false)
      (check "negative: T needs drop and the record has no shim of it" (ok? {:needs-drop true :symbol "_RS"} [(shim "u16" "_RS")]) false)
      (check "negative: T needs no drop by mono, but the record has its shim" (ok? {:needs-drop false :symbol "_RS"} [(shim "u8" "_RS")]) false)
      (check "negative: mono refuses T (no symbol)" (ok? nil []) false))
    ;; the negative cases: what -O0's passes do not explain
    (check "negative: another operand" (br/pack-compare (assoc-in ours [:blocks 0 :term] (list 'call callee '[(const "const 1_i8" (ty "i8" (int "i8")) (scalar 1 1))] '(place 0) 1 '(unreachable))) rec) :differs)
    (check "negative: a local's type" (br/pack-compare (assoc-in ours [:locals 1 :ty] u8) rec) :differs)
    (check "negative: a block's cleanup flag" (br/pack-compare (assoc-in ours [:blocks 1 :cleanup] true) rec) :differs)
    (check "negative: a borrowed temporary is not propagated"
           (br/pack-compare (update-in ours [:blocks 0 :stmts] conj '(assign (place 0) (ref :shared (place 2)))) rec) :differs)
    (check "negative: the unwind action" (br/pack-compare (assoc-in ours [:blocks 0 :term] (list 'call callee '[(move (place 2))] '(place 0) 1 '(continue))) rec) :differs)
    (println (str "pack-compare-test: " (if (zero? @bad) "passed" (str @bad " failed"))))
    (System/exit (if (zero? @bad) 0 1))))

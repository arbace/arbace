    ;; queue 498 (493-1 (b)): a body equal to the record's but whose drop runs no glue where the record's does (T needing drop)
    ;; refused, [:differs WHY :drop], until rust-c6-1120's runtime-body writes the glue (*drop-glue-at-run?*: a plain local's)
    (let [st '(ty "std::string::String" (adt "std::string::String" "DefId(5:1 ~ alloc[1234]::string::String)" []))
          unit '(ty "()" (tuple))
          dropb (fn [p g] {:args 1 :locals [{:ty unit} {:ty st}] :debug []

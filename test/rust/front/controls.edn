;; bin/rust-front essential's negative controls (doc/GATE-SURVEY.md, GTS81 (a); doc/rust/FRONTEND-SURVEY.md, "As built: RFP23 (b),
;; RFP24 (b)"): each judge of the step rust-front-essential judges one case against another case's reference, which must differ;
;; one that does not fails the step. Made by the judges themselves in the step's run, from the packs. Read with the Clojure reader.
[{:id "_control/build/crossed" :level :build :judge "arbace.rust.front.build-check"
  :subject "the first program's first equal body (a1's add)" :reference "rustc's built MIR of another body of it (a1's fib)"
  :why "two bodies' texts: the judge's byte-for-byte comparison must find them different (\"differs, as it must\")"}
 {:id "_control/capture/crossed" :level :capture :judge "arbace.rust.front.capture-check"
  :subject "the first closure of one program (collect1)" :reference "the helper's line of another program's (collect2)"
  :why "two closures' kinds, captures and fake reads: must differ"}
 {:id "_control/run/add-sub" :level :run :judge "bin/rust-front run-built" :subject "test/rust/front/a1.rs built with RF10_CONTROL=1 (every Add of Arbace's bodies a Sub)"
  :reference "rustc's executable's status in the pack rust-front-mono (5)"
  :why "the run's status must differ from the record's (156 for 5)"}
 {:id "_control/mono/crossed" :level :mono :judge "arbace.rust.front.mono-check" :subject "a1's and a2's native facts (RFP23 (c))"
  :reference "the other program's record in the pack rust-front-mono"
  :why "two programs' symbols, callees and locations: the entry-by-entry comparison must find differences"}]

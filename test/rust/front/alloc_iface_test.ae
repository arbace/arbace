(ns rust.front.alloc-iface-test
  "RIND9 (a)'s unit cases (doc/rust/FRONTEND-SURVEY.md, \"As built: RIND9 (a), alloc's pass\"), light (under 1 GiB): the crate
  root of a module path, alloc's module tree, the interface less a crate's facts, a path's module, the compare fact by fact
  with its negative control, the helper's shape written and read back; with FRONT-DIR, the pass over one small module of alloc
  (test/rust/front/alloc-iface-units.txt's modules, one process each by bin/rust-front alloc-iface --units) compared with the
  helper's facts of that module, held to the known line. `bin/rust-front alloc-iface --units`."
  (:require [arbace.rust.front.alloc-check :as ac]
            [arbace.rust.front.core-check :as cc]
            [arbace.rust.front.collect :as collect]
            [arbace.rust.front.resolve :as resolve]
            [arbace.rust.front.expand]
            [arbace.string :as str])
  (:import [java.io File]))

(def ^:private module-cases
  "RIND9 (a)'s three causes, fact by fact on the modules passed alone: [WHAT GET EXPECTED] (independent of the helper's
  facts: the values rustc's interface writes, as the helper's std-iface holds them)"
  {"alloc::borrow"
   [["ToOwned::Owned's bounds: the implicit Sized, then Borrow<Self> (explicit_item_bounds)"
     #(get-in % [:traits "alloc::borrow::ToOwned" :items 0 3])
     '[(trait "core::marker::Sized" [(projection "alloc::borrow::ToOwned::Owned" [(param 0 "Self")])])
       (trait "core::borrow::Borrow" [(projection "alloc::borrow::ToOwned::Owned" [(param 0 "Self")]) (param 0 "Self")])]]
    ["Cow's Debug impl: `B: ToOwned<Owned: Debug>`'s bound a clause on the projection, last"
     #(last (get-in % [:impls "alloc::borrow::{impl#12}" :predicates]))
     '(trait "core::fmt::Debug" [(projection "alloc::borrow::ToOwned::Owned" [(param 1 "B")])])]
    ["Cow's Display impl: likewise"
     #(last (get-in % [:impls "alloc::borrow::{impl#13}" :predicates]))
     '(trait "core::fmt::Display" [(projection "alloc::borrow::ToOwned::Owned" [(param 1 "B")])])]
    ["Cow's Default impl: `B: ToOwned<Owned: Default>`, after ToOwned"
     #(vec (take-last 2 (get-in % [:impls "alloc::borrow::{impl#14}" :predicates])))
     '[(trait "alloc::borrow::ToOwned" [(param 1 "B")]) (trait "core::default::Default" [(projection "alloc::borrow::ToOwned::Owned" [(param 1 "B")])])]]
    ["negative: Cow's Hash impl (no associated-type bound) has no projection clause"
     #(boolean (some (fn [c] (str/includes? (pr-str c) "projection")) (get-in % [:impls "alloc::borrow::{impl#15}" :predicates])))
     false]]
   "alloc::alloc"
   [["derive_const(Clone) on Global: TrivialClone's impl, {impl#6}"
     #(get-in % [:impls "alloc::alloc::{impl#6}" :trait]) '(trait "core::clone::TrivialClone" [(adt "alloc::alloc::Global" [])])]
    ["derive_const(Clone): Clone's impl, {impl#7}"
     #(get-in % [:impls "alloc::alloc::{impl#7}" :trait]) '(trait "core::clone::Clone" [(adt "alloc::alloc::Global" [])])]
    ["derive_const(Default): {impl#8}"
     #(get-in % [:impls "alloc::alloc::{impl#8}" :trait]) '(trait "core::default::Default" [(adt "alloc::alloc::Global" [])])]
    ["derive(Copy, Debug) before them, in the attributes' order: {impl#4} Copy, {impl#5} Debug"
     #(mapv (fn [i] (second (get-in % [:impls (str "alloc::alloc::{impl#" i "}") :trait]))) [4 5]) ["core::marker::Copy" "core::fmt::Debug"]]
    ["derive_const's functions const: {impl#7}::clone, {impl#8}::default"
     #(mapv (fn [p] (get-in % [:fns p :const])) ["alloc::alloc::{impl#7}::clone" "alloc::alloc::{impl#8}::default"]) [true true]]
    ["negative: derive(Debug)'s fmt is not const"
     #(get-in % [:fns "alloc::alloc::{impl#5}::fmt" :const]) false]]
   "alloc::slice"
   [["Join::Output's bounds: Sized over the projection, the trait's parameter among its arguments"
     #(get-in % [:traits "alloc::slice::Join" :items 0 3])
     '[(trait "core::marker::Sized" [(projection "alloc::slice::Join::Output" [(param 0 "Self") (param 1 "Separator")])])]]
    ;; round 52: Fn sugar's elided regions are the clause's bound variables
    ["sort_by's `F: FnMut(&T, &T) -> Ordering`: the clause's late-bound regions '^#0 and '^#1"
     #(get-in % [:fns "alloc::slice::{impl#0}::sort_by" :predicates 1])
     '(trait "core::ops::function::FnMut" [(param 1 "F") (tuple [(ref "'^#0" false (param 0 "T")) (ref "'^#1" false (param 0 "T"))])])]
    ["sort_by_key's Output projection: the same binder's '^#0"
     #(get-in % [:fns "alloc::slice::{impl#0}::sort_by_key" :predicates 3])
     '(proj "core::ops::function::FnOnce::Output" [(param 2 "F") (tuple [(ref "'^#0" false (param 0 "T"))])] (param 1 "K"))]
    ["negative: no erased '_ in sort_by_cached_key's clauses"
     #(boolean (str/includes? (pr-str (get-in % [:fns "alloc::slice::{impl#0}::sort_by_cached_key" :predicates])) "'_")) false]
    ;; round 52: an impl in a function's body inside an impl's function inside a function's body, by its def path
    ["to_vec's Drop for DropGuard: {impl#0}::to_vec_in::{impl#0}::to_vec::{impl#0}, the body's ADT by its def path"
     #(get-in % [:impls "alloc::slice::{impl#0}::to_vec_in::{impl#0}::to_vec::{impl#0}" :trait])
     '(trait "core::ops::drop::Drop" [(adt "alloc::slice::{impl#0}::to_vec_in::{impl#0}::to_vec::DropGuard" [(lt "'a") (param 1 "T") (param 2 "A")])])]
    ["its drop: the impl's three parameters its parents"
     #(get-in % [:fns "alloc::slice::{impl#0}::to_vec_in::{impl#0}::to_vec::{impl#0}::drop" :parent-count]) 3]
    ["negative: the body's ConvertVec impl (a body's trait) and the body's ADT not written"
     #(vec (concat (keys (filter (fn [[p _]] (= p "alloc::slice::{impl#0}::to_vec_in::{impl#0}")) (:impls %)))
                   (filter (fn [p] (str/includes? p "DropGuard")) (keys (:adts %))))) []]]
   "alloc::string"
   [["cfg_attr(.., derive(Clone)) on FromUtf8Error: its Clone impl, {impl#85}"
     #(get-in % [:impls "alloc::string::{impl#85}" :trait]) '(trait "core::clone::Clone" [(adt "alloc::string::FromUtf8Error" [])])]
    ["cfg_attr's derive on IntoChars: {impl#133}"
     #(get-in % [:impls "alloc::string::{impl#133}" :trait]) '(trait "core::clone::Clone" [(adt "alloc::string::IntoChars" [])])]
    ["a generic associated type's own argument: `<&'b str as Pattern>::Searcher<'a>`"
     #(get-in % [:impls "alloc::string::{impl#26}" :items 0 3])
     '(projection "core::str::pattern::Pattern::Searcher" [(ref "'b" false (prim "str")) (lt "'a")])]
    ["by-value self no elision candidate: into_searcher's `Searcher<'_>` the haystack's '^#0"
     #(get-in % [:fns "alloc::string::{impl#26}::into_searcher" :output])
     '(projection "core::str::pattern::Pattern::Searcher" [(ref "'b" false (prim "str")) (lt "'^#0")])]
    ["negative: `for<'a> P::Searcher<'a>: ReverseSearcher<'a>` keeps its named '^'a, not '_"
     #(boolean (str/includes? (pr-str (get-in % [:fns "alloc::string::{impl#0}::replace_last" :predicates])) "'_")) false]]
   "alloc::boxed"
   [["Box<T, A = Global>: A's default"
     #(get-in % [:adts "alloc::boxed::Box" :generics]) '[(type "T") (type "A" (adt "alloc::alloc::Global" []))]]
    ["FnOnce for Box: call_once's extern \"rust-call\""
     #(get-in % [:fns "alloc::boxed::{impl#31}::call_once" :abi]) "\"rust-call\""]
    ["negative: Box::new's ABI Rust"
     #(get-in % [:fns "alloc::boxed::{impl#0}::new" :abi]) "\"Rust\""]]
   "alloc::rc"
   [["`impl !Send for Rc<T, A>`: a negative impl, {impl#0}"
     #(mapv (fn [k] (get-in % [:impls "alloc::rc::{impl#0}" k])) [:negative :trait])
     '[true (trait "core::marker::Send" [(adt "alloc::rc::Rc" [(param 0 "T") (param 1 "A")])])]]
    ["negative: Rc's PartialEq impl {impl#100} is positive"
     #(get-in % [:impls "alloc::rc::{impl#100}" :negative]) false]]
   "alloc::raw_vec"
   [["`#[rustfmt::skip] const impl` an attribute invocation, its DefId later: Drop for RawVec is {impl#3}"
     #(get-in % [:impls "alloc::raw_vec::{impl#3}" :trait]) '(trait "core::ops::drop::Drop" [(adt "alloc::raw_vec::RawVec" [(param 0 "T") (param 1 "A")])])]
    ["negative: {impl#2} is an inherent impl (RawVec<T, A>'s non-const block)"
     #(get-in % [:impls "alloc::raw_vec::{impl#2}" :trait]) nil]]
   ;; round 52 (n-rust-alloc4): Self in an impl's trait arguments, a const parameter as an ADT's argument, a length naming a
   ;; crate constant
   "alloc::ffi::c_str"
   [["`impl PartialEq<Cow<'_, Self>> for CStr`: Self in the trait's arguments the self type, {impl#43}"
     #(get-in % [:impls "alloc::ffi::c_str::{impl#43}" :trait])
     '(trait "core::cmp::PartialEq" [(adt "core::ffi::c_str::CStr" []) (adt "alloc::borrow::Cow" [(lt "'_") (adt "core::ffi::c_str::CStr" [])])])]
    ["its eq: `other: &Cow<'_, Self>`"
     #(get-in % [:fns "alloc::ffi::c_str::{impl#43}::eq" :inputs 1])
     '(ref "'^#1" false (adt "alloc::borrow::Cow" [(lt "'^#2") (adt "core::ffi::c_str::CStr" [])]))]
    ["negative: {impl#41} is CStr's inherent impl (no trait)"
     #(get-in % [:impls "alloc::ffi::c_str::{impl#41}" :trait]) nil]]
   "alloc::boxed::iter"
   [["BoxedArrayIntoIter<T, N, A>'s Iterator impl: the const parameter an argument, {impl#26}"
     #(get-in % [:impls "alloc::boxed::iter::{impl#26}" :self])
     '(adt "alloc::boxed::iter::BoxedArrayIntoIter" [(param 0 "T") (cparam 1 "N") (param 2 "A")])]
    ["IntoIterator for Box<[T; N], A>: its IntoIter type written, {impl#33}"
     #(get-in % [:impls "alloc::boxed::iter::{impl#33}" :items 0 3])
     '(adt "alloc::boxed::iter::BoxedArrayIntoIter" [(param 0 "T") (cparam 1 "N") (param 2 "A")])]
    ["negative: {impl#25} is the inherent impl"
     #(get-in % [:impls "alloc::boxed::iter::{impl#25}" :trait]) nil]]
   "alloc::collections::btree::node"
   [["LeafNode's `keys: [MaybeUninit<K>; CAPACITY]`: the length evaluated, 11"
     #(some (fn [[n t]] (when (= "keys" n) t)) (get-in % [:adts "alloc::collections::btree::node::LeafNode" :variants 0 :fields]))
     '(array (adt "core::mem::maybe_uninit::MaybeUninit" [(param 0 "K")]) "11")]
    ["InternalNode's `edges: [..; 2 * B]`: 12"
     #(nth (some (fn [[n t]] (when (= "edges" n) t)) (get-in % [:adts "alloc::collections::btree::node::InternalNode" :variants 0 :fields])) 2)
     "12"]
    ["negative: no length left unevaluated (CAPACITY's text) in LeafNode"
     #(boolean (str/includes? (pr-str (get-in % [:adts "alloc::collections::btree::node::LeafNode"])) "CAPACITY")) false]]
   "alloc::io::buffered::bufreader"
   [["`impl<R> SpecReadByte for BufReader<R> where Self: Read`: Self in the impl's where clause the self type, {impl#5}"
     #(last (get-in % [:impls "alloc::io::buffered::bufreader::{impl#5}" :predicates]))
     '(trait "alloc::io::read::Read" [(adt "alloc::io::buffered::bufreader::BufReader" [(param 0 "R")])])]
    ["negative: `impl<R: ?Sized> BufReader<R>` ({impl#2}) has no Read clause"
     #(boolean (some (fn [c] (str/includes? (pr-str c) "Read")) (get-in % [:impls "alloc::io::buffered::bufreader::{impl#2}" :predicates]))) false]]
   "alloc::io::util"
   [["`impl<R> SpecReadByte for R where Self: Read`: {impl#8}'s clause on R"
     #(last (get-in % [:impls "alloc::io::util::{impl#8}" :predicates])) '(trait "alloc::io::read::Read" [(param 0 "R")])]]
   "alloc::vec::splice"
   [["derive(Debug) on Splice: `I::Item: Debug` (find_type_parameters' projection of a field type), after the item's predicates"
     #(last (get-in % [:impls "alloc::vec::splice::{impl#5}" :predicates]))
     '(trait "core::fmt::Debug" [(projection "core::iter::traits::iterator::Iterator::Item" [(param 1 "I")])])]
    ["negative: a type parameter alone (`replace_with: I`) adds no second `I: Debug`"
     #(count (filter (fn [c] (= c '(trait "core::fmt::Debug" [(param 1 "I")]))) (get-in % [:impls "alloc::vec::splice::{impl#5}" :predicates]))) 1]]
   ;; n-rust-alloc5: a derive's projection bound once (predicates_of's set of (clause, span): the derive's span)
   "alloc::collections::btree::merge_iter"
   [["derive(Clone) on `enum Peeked<I> { A(I::Item), B(I::Item) }`: Sized, Clone, Iterator, then `I::Item: Clone` once"
     #(get-in % [:impls "alloc::collections::btree::merge_iter::{impl#3}" :predicates])
     '[(trait "core::marker::Sized" [(param 0 "I")]) (trait "core::clone::Clone" [(param 0 "I")]) (trait "core::iter::traits::iterator::Iterator" [(param 0 "I")])
       (trait "core::clone::Clone" [(projection "core::iter::traits::iterator::Iterator::Item" [(param 0 "I")])])]]
    ["negative: derive(Debug)'s `I::Item: Debug` not twice"
     #(count (filter (fn [c] (= c '(trait "core::fmt::Debug" [(projection "core::iter::traits::iterator::Iterator::Item" [(param 0 "I")])])))
                     (get-in % [:impls "alloc::collections::btree::merge_iter::{impl#4}" :predicates]))) 1]]
   ;; n-rust-alloc5: `use super::super::borrow::DormantMutRef` (a module built alone: super twice, through std's modules)
   "alloc::collections::btree::map::entry"
   [["VacantEntry's dormant_map: `super::super::borrow::DormantMutRef` resolved"
     #(some (fn [[n t]] (when (= "dormant_map" n) t)) (get-in % [:adts "alloc::collections::btree::map::entry::VacantEntry" :variants 0 :fields]))
     '(adt "alloc::collections::btree::borrow::DormantMutRef" [(lt "'a") (adt "alloc::collections::btree::map::BTreeMap" [(param 1 "K") (param 2 "V") (param 3 "A")])])]
    ["OccupiedEntry written (its handle `super::super::node::Handle`)"
     #(first (second (some (fn [[n t]] (when (= "handle" n) [n t])) (get-in % [:adts "alloc::collections::btree::map::entry::OccupiedEntry" :variants 0 :fields]))))
     'adt]
    ["negative: no field left unresolved in VacantEntry"
     #(boolean (str/includes? (pr-str (get-in % [:adts "alloc::collections::btree::map::entry::VacantEntry"])) "err")) false]]
   ;; round 54: `use super::{SetValZST, map}` names set's own imports (`use super::map::{self, ..}`, `use super::set_val::SetValZST`):
   ;; the index records a `self` import as the module's name, and a chain of imports through with-core-names' rounds
   "alloc::collections::btree::set::entry"
   [["OccupiedEntry's inner: `map::OccupiedEntry<'a, T, SetValZST, A>` through set's `map` and `SetValZST` imports"
     #(some (fn [[n t]] (when (= "inner" n) t)) (get-in % [:adts "alloc::collections::btree::set::entry::OccupiedEntry" :variants 0 :fields]))
     '(adt "alloc::collections::btree::map::entry::OccupiedEntry" [(lt "'a") (param 1 "T") (adt "alloc::collections::btree::set_val::SetValZST" []) (param 2 "A")])]
    ["VacantEntry written" #(boolean (get-in % [:adts "alloc::collections::btree::set::entry::VacantEntry"])) true]
    ["negative: no field left unresolved in VacantEntry"
     #(boolean (str/includes? (pr-str (get-in % [:adts "alloc::collections::btree::set::entry::VacantEntry"])) "err")) false]]
   "alloc::boxed::convert"
   [["From<[T; N]>'s const parameter: ConstArgHasType as the helper's (other TEXT), last"
     #(last (get-in % [:impls "alloc::boxed::convert::{impl#9}" :predicates])) '(other "the constant `N` has type `usize`")]
    ["Box<dyn Any, A>'s inherent impl: the object's default region 'static"
     #(get-in % [:impls "alloc::boxed::convert::{impl#12}" :self])
     '(adt "alloc::boxed::Box" [(dyn (trait "core::any::Any" []) [] [] "'static") (param 0 "A")])]
    ["`dyn Error + Send + Sync + 'a`: the auto traits Sync then Send, the written region"
     #(first (nth (get-in % [:impls "alloc::boxed::convert::{impl#16}" :self]) 2))
     '(dyn (trait "core::error::Error" []) [] ["core::marker::Sync" "core::marker::Send"] "'a")]
    ["`E: Error + 'a`: the type-outlives clause, last"
     #(last (get-in % [:impls "alloc::boxed::convert::{impl#15}" :predicates])) '(type-outlives (param 1 "E") "'a")]
    ["from's body impls: {impl#17}::from::{impl#0} written (StringError's)"
     #(some? (get-in % [:impls "alloc::boxed::convert::{impl#17}::from::{impl#0}"])) true]
    ["negative: From<T> for Box<T> has no (other ..) clause"
     #(boolean (some (fn [c] (= 'other (first c))) (get-in % [:impls "alloc::boxed::convert::{impl#0}" :predicates]))) false]]})

(def ^:private std-module-cases
  "round 54 (RIND9 (a), std): the causes fixed on std's modules passed alone, fact by fact on the native facts"
  {"std::panic"
   [["an elided object lifetime of a trait bounding Self by 'static: `&'a (dyn Any + Send)`'s object 'static"
     #(get-in % [:adts "std::panic::PanicHookInfo" :variants 0 :fields 0 1])
     '(ref "'a" false (dyn (trait "core::any::Any" []) [] ["core::marker::Send"] "'static"))]
    ["the same behind an elided reference in an output: payload's '^#0 and 'static"
     #(get-in % [:fns "std::panic::{impl#0}::payload" :output])
     '(ref "'^#0" false (dyn (trait "core::any::Any" []) [] ["core::marker::Send"] "'static"))]
    ["negative: `Box<dyn Any + Send>` keeps 'static by its own default (no reference)"
     #(boolean (str/includes? (pr-str (get-in % [:fns "std::panic::resume_unwind" :inputs])) "\"'_\"")) false]]
   "std::sync::nonpoison::mutex"
   [["Fn sugar's output elided by its one input lifetime: `F: FnOnce(&mut T) -> &mut U`'s Output '^#0"
     #(last (get-in % [:fns "std::sync::nonpoison::mutex::{impl#17}::map" :predicates]))
     '(proj "core::ops::function::FnOnce::Output" [(param 3 "F") (tuple [(ref "'^#0" true (param 1 "T"))])] (ref "'^#0" true (param 2 "U")))]
    ["negative: no erased '_ left in map's clauses"
     #(boolean (str/includes? (pr-str (get-in % [:fns "std::sync::nonpoison::mutex::{impl#17}::map" :predicates])) "'_")) false]]
   "std::ffi::os_str"
   [["the extern prelude's alloc: `impl Join<&OsStr> for [S]` names alloc::slice::Join"
     #(second (get-in % [:impls "std::ffi::os_str::{impl#53}" :trait])) "alloc::slice::Join"]]
   "std::io::stdio"
   [["the root's alias alloc_crate in the index: io's `pub(crate) use alloc_crate::io::SpecReadByte`"
     #(second (get-in % [:impls "std::io::stdio::{impl#9}" :trait])) "alloc::io::util::SpecReadByte"]
    ;; queue 417: a return-position impl Trait
    ["as_mut_buf's `&mut BufReader<impl Read>`: the opaque type by its def path, the impl's '_, then its captures '_ and '^#0"
     #(get-in % [:fns "std::io::stdio::{impl#7}::as_mut_buf" :output])
     '(ref "'^#0" true (adt "alloc::io::buffered::bufreader::BufReader" [(opaque "std::io::stdio::{impl#7}::as_mut_buf::{opaque#0}" [(lt "'_") (lt "'_") (lt "'^#0")])]))]]
   ;; queue 417: type aliases of an impl Trait as the helper writes them, their text
   "std::backtrace"
   [["Inner's `LazyLock<Capture, LazyResolve>`: the alias of an impl Trait in mod helper as its text"
     #(get-in % [:adts "std::backtrace::Inner" :variants 2 :fields 0 1])
     '(adt "std::sync::lazy_lock::LazyLock" [(adt "std::backtrace::Capture" []) (text "std::backtrace::helper::LazyResolve")])]
    ["negative: lazy_resolve's output the alias too, not an expanded opaque type"
     #(boolean (str/includes? (pr-str (get-in % [:fns "std::backtrace::helper::lazy_resolve" :output])) "opaque")) false]]
   "std::env"
   [["SplitPaths' `paths_imp::SplitPaths<'a>` (sys/paths/unix.rs' alias of a Map of impl Traits, passed before) as its text with its lifetime"
     #(get-in % [:adts "std::env::SplitPaths" :variants 0 :fields])
     '[["inner" (text "std::sys::paths::unix::SplitPaths<'a>")]]]]
   ;; queue 400: libc's and hashbrown's names and aliases read natively from library/vendor
   "std::os::unix::net::addr"
   [["libc's struct by its defining module through libc's globs (`libc::sockaddr_un`), socklen_t its alias's u32"
     #(get-in % [:adts "std::os::unix::net::addr::SocketAddr" :variants 0 :fields])
     '[["addr" (adt "libc::unix::linux_like::sockaddr_un" [])] ["len" (prim "u32")]]]
    ["new's `F: FnOnce(*mut libc::sockaddr, *mut libc::socklen_t) -> c_int`: its Output i32"
     #(last (get-in % [:fns "std::os::unix::net::addr::{impl#0}::new" :predicates]))
     '(proj "core::ops::function::FnOnce::Output" [(param 0 "F") (tuple [(ptr true (adt "libc::unix::linux_like::sockaddr" [])) (ptr true (prim "u32"))])] (prim "i32"))]
    ["negative: no libc type left unresolved in the module's facts"
     #(boolean (some (fn [[_ f]] (str/includes? (pr-str f) "unresolved")) (concat (:fns %) (:adts %)))) false]]
   "std::collections::hash::map"
   [["hashbrown's HashMap by its defining module (`hashbrown::hash_map as base`, `pub use crate::map::*`)"
     #(get-in % [:adts "std::collections::hash::map::HashMap" :variants 0 :fields])
     '[["base" (adt "hashbrown::map::HashMap" [(param 0 "K") (param 1 "V") (param 2 "S") (param 3 "A")])]]]
    ["an iterator's base: hashbrown's Iter with its lifetime"
     #(get-in % [:adts "std::collections::hash::map::Iter" :variants 0 :fields])
     '[["base" (adt "hashbrown::map::Iter" [(lt "'a") (param 1 "K") (param 2 "V")])]]]]})

(defn -main [lib & [front cache & files]]
  (let [bad (atom 0)
        check (fn [what ok] (println (if ok "ok  " "FAIL") what) (when-not ok (swap! bad inc)))]
    (if-not front
      (do
        ;; the crate root of the module being built
        (check "crate-root of alloc::vec is alloc" (= "alloc" (binding [resolve/*crate-path* "alloc::vec"] (resolve/crate-root))))
        (check "crate-root of core is core" (= "core" (binding [resolve/*crate-path* "core"] (resolve/crate-root))))
        (check "no crate-root outside a crate's build" (nil? (binding [resolve/*crate-path* nil] (resolve/crate-root))))
        ;; alloc's module tree (cfg evaluated: test-only modules out)
        (let [mods (binding [cc/*crate* "alloc"] (cc/module-files lib))
              ps (set (map :path mods))]
          (println "     alloc's module files:" (count mods))
          (check "alloc's tree: the root, vec, btree::map, sync, ffi::c_str, raw_vec"
                 (every? ps ["alloc" "alloc::vec" "alloc::collections::btree::map" "alloc::sync" "alloc::ffi::c_str" "alloc::raw_vec"]))
          (check "alloc's tree: the root first, every file under library/alloc/"
                 (and (= "alloc" (:path (first mods))) (every? #(re-find #"/alloc/src/" (:file %)) mods)))
          (check "negative: no cfg(test) module (alloc::tests, a vec's tests)" (not-any? #(re-find #"::tests$" %) ps))
          (check "rel-path names alloc's files as rustc's remapped paths do"
                 (= "library/alloc/src/borrow.rs" (cc/rel-path (str lib "/alloc/src/borrow.rs")))))
        ;; the interface less a crate's facts
        (let [si {:fns {"alloc::a::f" {:x 1} "core::g" {:x 2}} :adts {"alloc::A" {}} :traits {} :consts {}
                  :impls {"alloc::{impl#0}" {:trait '(trait "core::clone::Clone" [])} "core::{impl#0}" {}}
                  :inherent {"alloc::A" ["alloc::{impl#1}"] "core::B" ["core::{impl#0}"]}
                  :trait-impls {"core::clone::Clone" ["alloc::{impl#0}" "core::{impl#0}"]}
                  :trait-impls-by {"core::clone::Clone" {:blanket ["alloc::{impl#0}"] "core::B" ["core::{impl#0}"]}}}
              w (ac/without-crate si "alloc")]
          (check "without-crate: alloc's facts out, core's kept"
                 (and (= {"core::g" {:x 2}} (:fns w)) (empty? (:adts w)) (= ["core::{impl#0}"] (keys (:impls w)))))
          (check "without-crate: alloc's impls out of the indexes"
                 (and (= [] (get-in w [:inherent "alloc::A"])) (= ["core::{impl#0}"] (get-in w [:trait-impls "core::clone::Clone"]))
                      (= [] (get-in w [:trait-impls-by "core::clone::Clone" :blanket]))))
          (check "crate-facts: alloc's alone" (= {"alloc::a::f" {:x 1}} (:fns (ac/crate-facts si "alloc"))))
          (check "negative: crate-path? is not a prefix match (allocator::x is not alloc's)" (not (ac/crate-path? "alloc" "allocator::x"))))
        ;; a path's module
        (let [mps ["alloc" "alloc::vec" "alloc::vec::into_iter" "alloc::collections"]]
          (check "owner: an impl's method in vec/mod.rs" (= "alloc::vec" (ac/owner mps "alloc::vec::{impl#3}::push")))
          (check "owner: the longest module" (= "alloc::vec::into_iter" (ac/owner mps "alloc::vec::into_iter::IntoIter")))
          (check "owner: the root's own" (= "alloc" (ac/owner mps "alloc::format")))
          (check "negative: owner of a path outside alloc is none" (nil? (ac/owner mps "core::vec::x"))))
        ;; the compare and its control
        (let [f1 {:generics [] :inputs ['(prim "u8")] :output '(tuple [])}
              helper {:fns {"alloc::f" f1 "alloc::g" (assoc f1 :output '(prim "bool")) "alloc::h" f1} :adts {} :traits {} :impls {} :consts {}}
              native {:fns {"alloc::f" (assoc f1 :native true) "alloc::g" f1 "alloc::p" f1} :adts {} :traits {} :impls {} :consts {}}
              cmp (ac/compare-facts helper native)
              fs (:fns cmp)]
          (check "compare: f equal (the native mark dropped)" (= 1 (:equal fs)))
          (check "compare: g differs by :output" (= [["alloc::g" [:output]]] (:differs fs)))
          (check "compare: h missing, p a native extra" (and (= ["alloc::h"] (:missing fs)) (= ["alloc::p"] (:extra fs))))
          (check "compare: the total line" (some #(= "alloc-iface: total 3 facts: 1 equal, 1 differ, 1 missing (native extras 1)" %) (ac/summary-lines cmp)))
          (check "control: f judged against g's helper fact differs, as it must" (= ["alloc::f" "alloc::g" true] (ac/control helper native)))
          ;; round 52 (n-rust-alloc5): a module of one fact takes the other fact from the crate's pool
          (let [h1 {:fns {"alloc::f" f1} :adts {} :traits {} :impls {} :consts {}}]
            (check "control: one fact alone, the other from the pool" (= ["alloc::f" "alloc::g" true] (ac/control h1 native helper)))
            (check "negative: one fact alone and no pool, no control" (nil? (ac/control h1 native))))
          ;; round 52: a constant's :value (std's interface writes none) compared only when the helper's fact has one
          (check "a native const's :value the helper lacks: no difference"
                 (= [] (ac/diff-keys {:kind "Const" :ty '(prim "usize")} {:kind "Const" :ty '(prim "usize") :value 8192 :native true})))
          (check "negative: a :value the helper writes is compared"
                 (= [:value] (ac/diff-keys {:kind "Const" :ty '(prim "usize") :value 512} {:kind "Const" :ty '(prim "usize") :value 8192}))))
        ;; RIND9 (a): #[derive_const(...)]'s impls are `const impl` (rustc_builtin_macros' TraitDef is_const): Clone on a Copy
        ;; type without parameters both its impls (TrivialClone's and Clone's), as core's own `const unsafe impl TrivialClone`
        (let [dt #'arbace.rust.front.expand/derive-text
              info {:kind :struct :name "Global" :tparams [] :ptoks nil :gparams [] :shape [:unit] :copy? true :field-spans []}
              c (dt "Clone" (assoc info :const-traits #{"Clone"}) (atom {}))
              d (dt "Clone" (assoc info :const-traits #{}) (atom {}))]
          (check "derive_const(Clone): TrivialClone's impl a const unsafe impl"
                 (str/includes? c "#[doc(hidden)] const unsafe impl $crate::clone::TrivialClone for Global"))
          (check "derive_const(Clone): Clone's impl a const impl" (str/includes? c "#[automatically_derived] const impl $crate::clone::Clone for Global"))
          (check "negative: derive(Clone)'s impls not const" (and (not (str/includes? d "const ")) (str/includes? d "unsafe impl $crate::clone::TrivialClone"))))
        ;; round 52: the regions of a clause's and of a type's own binder, a trait object, outlives clauses (core-check's writer)
        (let [cl #'cc/clause->sty
              r1 [:re-bound nil 1] r2 [:re-bound nil 2]
              t0 [:param 0 "T"]]
          (check "a clause's Fn sugar: its elided regions '^#0, '^#1"
                 (= '(trait "core::ops::function::FnMut" [(param 1 "F") (tuple [(ref "'^#0" false (param 0 "T")) (ref "'^#1" false (param 0 "T"))])])
                    (cl [:trait ["core::ops::function::FnMut" [[:param 1 "F"] [:tuple [[:ref r1 false t0] [:ref r2 false t0]]]]]] identity)))
          (check "a clause's `for<'a>`: '^'a, an elided region after it '^#1"
                 (= '(trait "core::ops::function::Fn" [(param 1 "F") (tuple [(ref "'^'a" false (param 0 "T")) (ref "'^#1" false (param 0 "T"))])])
                    (cl [:trait ["core::ops::function::Fn" [[:param 1 "F"] [:tuple [[:ref [:re-bound "'a" :for] false t0] [:ref r1 false t0]]]]]] identity)))
          (check "negative: outside a binder the region stays '_"
                 (= '(ref "'_" false (param 0 "T")) (cc/ty->sty [:ref r1 false t0] identity)))
          (check "a fn pointer's own binder: '^^#0"
                 (= '(fnptr [(ref "'^^#0" false (param 0 "T"))] (tuple [])) (cc/ty->sty [:fnptr {:inputs [[:ref r1 false t0]] :output [:tuple []]}] identity)))
          (check "a trait object: Self out, Sync before Send, its region"
                 (= '(dyn (trait "core::error::Error" []) [] ["core::marker::Sync" "core::marker::Send"] "'static")
                    (cc/ty->sty [:dyn {:principal ["core::error::Error" []] :projections [] :autos ["core::marker::Send" "core::marker::Sync"]} [:re-static]] identity)))
          (check "a trait object's Fn sugar: its projection, its binder's '^^#0, an anonymous region '_"
                 (= '(dyn (trait "core::ops::function::Fn" [(tuple [(ref "'^^#0" false (param 0 "T"))])])
                          [(proj "core::ops::function::FnOnce::Output" [(tuple [(ref "'^^#0" false (param 0 "T"))])] (tuple []))] [] "'_")
                    (cc/ty->sty [:dyn {:principal ["core::ops::function::Fn" [[:tuple [[:ref r1 false t0]]]]]
                                       :projections [["core::ops::function::FnOnce::Output" [[:tuple [[:ref r1 false t0]]]] [:tuple []]]] :autos []}
                                 [:re-bound nil :anon 7]] identity)))
          (check "`E: 'a` and `'b: 'a`"
                 (= ['(type-outlives (param 1 "E") "'a") '(other "'b: 'a")]
                    [(cl [:type-outlives [:param 1 "E"] [:re-early 0 "'a"]] identity) (cl [:region-outlives [:re-early 1 "'b"] [:re-early 0 "'a"]] identity)]))
          (check "negative: a clause of no known kind is not written" (nil? (cl [:unknown] identity)))
          (check "a const parameter as an ADT's argument: (cparam 1 \"N\")"
                 (= '(adt "alloc::boxed::iter::BoxedArrayIntoIter" [(param 0 "T") (cparam 1 "N") (param 2 "A")])
                    (cc/ty->sty [:adt "alloc::boxed::iter::BoxedArrayIntoIter" [t0 [:cparam 1 "N"] [:param 2 "A"]]] identity)))
          (check "negative: a type of no known kind among the arguments is no fact" (nil? (cc/ty->sty [:adt "x::A" [[:closure 3]]] identity))))
        ;; round 52: an argument of type Self in an impl for a reference: Self's regions are no elision candidates
        (let [ir #'collect/input-regions
              ra [:re-early 0 "'a"] r1 [:re-bound nil 1]
              st [:ref ra false [:prim "str"]]]
          (check "Self's regions no elision candidates: `fn f(x: Self, y: &str)` in `impl for &'a str` has y's alone"
                 (= [r1] (binding [collect/*self-ty* st] (ir [st [:ref r1 false [:prim "str"]]]))))
          (check "Self inside a type likewise: `Option<Self>`"
                 (= [] (binding [collect/*self-ty* st] (ir [[:adt "core::option::Option" [st]]]))))
          (check "negative: the self type written out (`&'a str`, another object) counts its region"
                 (= [ra r1] (binding [collect/*self-ty* st] (ir [[:ref ra false [:prim "str"]] [:ref r1 false [:prim "str"]]])))))
        ;; round 54 (RIND9 (a), std): the module tree and the index read the items a cfg_select! or a cfg_if! declares, the
        ;; arm that holds for the build's cfg, at their own places
        (let [pt #'cc/parse-text sp #'cc/splice-selects
              fg (fn [x k] (when (seq? x) (get (apply hash-map (rest x)) k)))
              nm (fn [it] (let [k (fg it :kind)] (case (first k) Mod (second (nth k 2)) Fn (second (fg (second k) :ident)) (str (first k)))))
              sel (fn [text] (sp (fg (pt text) :items) text))
              t1 "cfg_select! {\n    windows => { mod w; }\n    unix => {\n        mod u;\n        pub fn f() {}\n    }\n    _ => { mod z; }\n}\n"]
          (check "cfg_select!: the first arm that holds (unix), its items" (= ["u" "f"] (mapv nm (sel t1))))
          (check "cfg_select!'s arm read at its own places: `pub fn f` on line 5" (= 5 (first (fg (second (sel t1)) :span))))
          (check "cfg_select!: `_` when no other arm holds" (= ["z"] (mapv nm (sel "cfg_select! { windows => { mod w; } _ => { mod z; } }"))))
          (check "negative: `#[cfg(doc)] cfg_select! {..}` declares nothing"
                 (= [] (mapv nm (sel "#[cfg(doc)]\ncfg_select! { unix => { mod u; } }"))))
          (check "cfg_if!: `if #[cfg(miri)] .. else if #[cfg(unix)] ..` the unix arm"
                 (= ["u"] (mapv nm (sel "cfg_if::cfg_if! { if #[cfg(miri)] { mod m; } else if #[cfg(unix)] { mod u; } else { mod n; } }"))))
          (check "cfg_if!: the else arm"
                 (= ["n"] (mapv nm (sel "cfg_if::cfg_if! { if #[cfg(miri)] { mod m; } else { mod n; } }"))))
          (check "an inline module's cfg_select! too"
                 (= ["g"] (let [[a] (sel "mod a { cfg_select! { unix => { fn g() {} } } }")] (mapv nm (second (nth (fg a :kind) 3))))))
          (check "negative: another macro call stays" (= ["MacCall"] (mapv nm (sel "foo! { unix => { mod u; } }")))))
        (check "std's cfg: the features backtrace and panic-unwind; core's none"
               (and (= #{"backtrace" "panic-unwind"} (get (binding [cc/*crate* "std"] (cc/crate-cfg)) "feature"))
                    (nil? (get (binding [cc/*crate* "core"] (cc/crate-cfg)) "feature"))))
        (check "std's modules read std's prelude, alloc's and core's core's"
               (= ["std" "core" "core"] (mapv #(binding [cc/*crate* %] (cc/prelude-crate)) ["std" "alloc" "core"])))
        (check "std's root aliases alloc as alloc_crate; negative: alloc's root none"
               (and (= {"alloc_crate" "alloc"} (get resolve/root-extern-aliases "std")) (nil? (get resolve/root-extern-aliases "alloc"))))
        ;; queue 400: std's vendored dependencies, libc and hashbrown, read natively (their cfg, roots, item macros, module
        ;; trees, the extern prelude and the index's paths through them)
        (check "libc's cfg: rustc-dep-of-std's features, its build script's freebsd12 and musl_v1_2_3"
               (let [c (binding [cc/*crate* "libc"] (cc/crate-cfg))]
                 (and (= #{"rustc-dep-of-std" "align" "rustc-std-workspace-core"} (get c "feature")) (get c "freebsd12") (get c "musl_v1_2_3"))))
        (check "hashbrown's cfg: rustc-dep-of-std's closure (nightly, core, alloc, rustc-internal-api); negative: no default-hasher, no raw-entry"
               (let [f (get (binding [cc/*crate* "hashbrown"] (cc/crate-cfg)) "feature")]
                 (and (= #{"rustc-dep-of-std" "nightly" "core" "alloc" "rustc-internal-api"} f) (not (f "default-hasher")) (not (f "raw-entry")))))
        (check "a dependency's root under library/vendor; the library's crates' at LIB/CRATE/src"
               (and (re-find #"/vendor/libc-0\.2\.189/src/lib\.rs$" (cc/crate-lib-file lib "libc"))
                    (re-find #"/vendor/hashbrown-0\.17\.1/src/lib\.rs$" (cc/crate-lib-file lib "hashbrown"))
                    (re-find #"/alloc/src/lib\.rs$" (cc/crate-lib-file lib "alloc"))))
        (check "negative: a crate neither in the library nor vendored is refused"
               (try (cc/crate-lib-file lib "nosuchcrate") false (catch Throwable _ true)))
        (let [arm #'cc/item-macro-arm pt #'cc/parse-text
              fg (fn [x k] (when (seq? x) (get (apply hash-map (rest x)) k)))
              md (fn [text] (nth (fg (first (fg (pt text) :items)) :kind) 2))]
          (check "an item macro without parameters: its body's inside" (= [[1 25] [1 43]] (arm (md "macro_rules! p { () => { mod t; fn g() {} }; }"))))
          (check "negative: a macro with parameters, or of two arms, is none"
                 (and (nil? (arm (md "macro_rules! p { ($x:ident) => { mod $x; }; }")))
                      (nil? (arm (md "macro_rules! p { () => { mod t; }; (x) => { mod u; }; }"))))))
        (let [im (cc/crate-item-macros (cc/crate-lib-file lib "libc"))
              mods (binding [cc/*crate* "libc"] (cc/module-files lib))
              ps (set (map :path mods))]
          (println "     libc's module files:" (count mods))
          (check "libc's item macros: prelude!, from macros.rs" (= ["prelude"] (vec (keys im))))
          (check "libc's tree: prelude!()'s `mod types;`, the unix arm's linux_like down to x86_64, new's musl sys::socket"
                 (every? ps ["libc::types" "libc::primitives" "libc::unix::linux_like" "libc::unix::linux_like::linux::musl::b64::x86_64"
                             "libc::new::musl::sys::socket"]))
          (check "negative: no other platform's module (windows, glibc, apple)"
                 (not-any? #(re-find #"windows|glibc|apple|::linux::gnu" %) ps))
          (let [idx (binding [cc/*crate* "libc"] (cc/crate-index (filter #(#{"libc" "libc::unix"} (:path %)) mods)))]
            (check "libc's index: prelude!()'s inline `mod prelude` with its re-exports"
                   (some #(= ["c_int" "libc::c_int"] %) (get-in idx [:names "libc::prelude" :reexports])))
            (check "libc's index: the root's and unix's globs (`pub use unix::*`, `pub use linux_like::*`)"
                   (and (some #{"libc::unix"} (get-in idx [:names "libc" :globs])) (some #{"libc::unix::linux_like"} (get-in idx [:names "libc::unix" :globs]))))))
        (let [hb (binding [cc/*crate* "hashbrown"] (cc/module-files lib))]
          (check "hashbrown's tree: map, set, rustc_entry (rustc-internal-api); negative: no raw_entry"
                 (let [ps (set (map :path hb))] (and (every? ps ["hashbrown::map" "hashbrown::set" "hashbrown::rustc_entry"]) (not (ps "hashbrown::raw_entry"))))))
        (let [fnm #'cc/file-names pt #'cc/parse-text fg (fn [x k] (when (seq? x) (get (apply hash-map (rest x)) k)))
              its (fg (pt "use hashbrown::hash_map::{self as base, RustcOccupiedError};\nuse stdalloc::vec::Vec;") :items)]
          (check "std's index: `use hashbrown::hash_map::{self as base, ..}` names hashbrown's module"
                 (some #(= ["base" "hashbrown::hash_map"] %) (get-in (binding [cc/*crate* "std"] (fnm its "std::collections::hash::map")) ["std::collections::hash::map" :reexports])))
          (check "hashbrown's index: its root's alias stdalloc is alloc"
                 (some #(= ["Vec" "alloc::vec::Vec"] %) (get-in (binding [cc/*crate* "hashbrown"] (fnm its "hashbrown::map")) ["hashbrown::map" :reexports])))
          (check "negative: core names no hashbrown (a uniform path of the module)"
                 (some #(= ["base" "core::x::hashbrown::hash_map"] %) (get-in (binding [cc/*crate* "core"] (fnm its "core::x")) ["core::x" :reexports]))))
        (let [names {"std" {:kind "Mod" :children [{:ns :type :name "a" :kind "Mod" :path "std::a"}]}
                     "std::a" {:kind "Mod" :children [{:ns :type :name "unix" :kind "Mod" :path "std::a::unix"}]
                               :reexports [["imp" "std::a::unix"] ["File" "std::a::imp::File"]]}
                     "std::a::unix" {:kind "Mod" :children [{:ns :type :name "File" :kind "Struct" :path "std::a::unix::File"}]}}
              file-of (fn [m] (some #(when (= "File" (:name %)) (:path %)) (:children (get m "std::a"))))]
          (check "a re-export through a module's renamed import (`use unix as imp; pub use imp::File`): unix's File"
                 (= "std::a::unix::File" (file-of (binding [cc/*crate* "std"] (cc/with-core-names {} names)))))
          (check "negative: core's and alloc's index as before (no File through imp)"
                 (nil? (file-of (binding [cc/*crate* "alloc"] (cc/with-core-names {} names))))))
        ;; queue 417: a later round's names: the round before's macro-made struct (cfg_has_statx!'s FileAttr) taken through
        ;; the index's re-exports again (`use unix as imp; pub use imp::{FileAttr}`)
        (let [index {"std::a" {:kind "Mod" :children [{:ns :type :name "unix" :kind "Mod" :path "std::a::unix"}]
                               :reexports [["imp" "std::a::unix"] ["FileAttr" "std::a::imp::FileAttr"]]}
                     "std::a::unix" {:kind "Mod" :children []}}
              names (binding [cc/*crate* "std"] (cc/with-core-names {"std" {:kind "Mod" :children [{:ns :type :name "a" :kind "Mod" :path "std::a"}]}} index))
              prev {:adts {"std::a::unix::FileAttr" {:kind "Struct" :variants [{:name "FileAttr" :ctor nil :fields []}]}}}
              attr-of (fn [m] (some #(when (= "FileAttr" (:name %)) (:path %)) (:children (get m "std::a"))))]
          (check "a macro-made struct of the round before re-exported through `imp`: std::a's FileAttr is unix's"
                 (= "std::a::unix::FileAttr" (attr-of (binding [cc/*crate* "std"] (cc/with-core-names (cc/with-native-names names prev) index)))))
          (check "negative: with the round's native names alone (no re-export taken again), std::a has no FileAttr"
                 (nil? (attr-of (binding [cc/*crate* "std"] (cc/with-native-names names prev))))))
        ;; queue 417: std's opaque types and type aliases of an impl Trait in the helper's forms
        (check "an alias of an impl Trait at its lifetime: (text \"PATH<'a>\")"
               (= '(text "std::x::SplitPaths<'a>") (binding [cc/*crate* "std"] (cc/ty->sty [:free-alias "std::x::SplitPaths" [[:re-early 0 "'a"]]] identity))))
        (check "negative: an alias of an impl Trait at a type argument is no fact"
               (nil? (binding [cc/*crate* "std"] (cc/ty->sty [:free-alias "std::x::A" [[:param 0 "T"]]] identity))))
        (check "a return-position impl Trait in a signature: its def path, the identity arguments, the captures"
               (= '(opaque "std::x::f::{opaque#0}" [(lt "'_") (lt "'_") (lt "'^#0")])
                  (binding [cc/*crate* "std" cc/*late-sig* (atom [0 {7 0}])]
                    (cc/ty->sty [:opaque [] "std::x::f::{opaque#0}" [[:re-early 0 "'_"]]] identity))))
        (check "negative: core's opaque types as before (no fact), and outside a signature"
               (and (nil? (binding [cc/*crate* "core" cc/*late-sig* (atom [0 {}])] (cc/ty->sty [:opaque [] "core::x::f::{opaque#0}" []] identity)))
                    (nil? (binding [cc/*crate* "std"] (cc/ty->sty [:opaque [] "std::x::f::{opaque#0}" []] identity)))))
        (check "std's extern prelude takes libc and hashbrown; hashbrown's alloc, aliased stdalloc"
               (and (every? (get resolve/crate-deps "std") ["libc" "hashbrown"]) (= #{"core" "alloc"} (get resolve/crate-deps "hashbrown"))
                    (= {"stdalloc" "alloc"} (get resolve/root-extern-aliases "hashbrown"))))
        ;; the helper's shape written and read back
        (let [facts {:fns {"alloc::f" {:generics ['(type "T")] :parent-count 0 :has-self false :predicates [] :inputs [] :output '(param 0 "T")
                                       :variadic false :safety "Safe" :abi "\"Rust\"" :const false :promotable false :nounwind false :native true}}
                     :adts {"alloc::A" {:kind "Struct" :generics [] :parent-count 0 :has-self false :variants [{:name "A" :path "alloc::A" :ctor "Const" :fields []}]}}
                     :traits {} :impls {} :consts {}}
              t (ac/facts-text facts)
              f (str (System/getenv "TMPDIR") "/alloc-iface-units.edn")]
          (spit f t)
          (check "the helper's key order: (si/fn PATH {:generics .. :nounwind ..})"
                 (str/starts-with? t "(si/fn \"alloc::f\" {:generics [(type \"T\")] :parent-count 0 :has-self false :predicates []"))
          (check "written and read back: the same facts" (= (ac/crate-facts {:fns (:fns (ac/read-facts f)) :adts (:adts (ac/read-facts f))} "alloc")
                                                            (ac/crate-facts {:fns {"alloc::f" (ac/strip (get-in facts [:fns "alloc::f"]))} :adts (:adts facts)} "alloc")))))
      ;; one module's pass against the helper's facts of that module; round 52: FILES' earlier modules passed before it as its
      ;; context (vec/drain.rs after vec/mod.rs: its siblings' ADTs' generics), only the last one compared
      (let [crate (or (System/getenv "IFACE_CRATE") "alloc")
            mods (binding [cc/*crate* crate] (cc/module-files lib))
            ms (vec (for [file files] (some #(when (= (.getCanonicalPath (File. ^String file)) (:file %)) %) mods)))
            m (peek ms)
            setup (binding [cc/*crate* crate] (ac/crate-setup crate front cache mods lib))
            mps (map :path mods)
            native (binding [cc/*crate* crate] (ac/pass crate lib setup ms mps 1))
            facts (ac/facts-of-modules (ac/crate-facts native crate) mps [(:path m)])
            helper (ac/facts-of-modules (:helper setup) mps [(:path m)])
            cmp (ac/compare-facts helper facts)
            ctl (ac/control helper facts (:helper setup))]
        (doseq [l (binding [ac/*tag* (str crate "-iface")] (ac/summary-lines cmp))] (println l))
        ;; RIND9 (a): the module's own cases, on the native facts alone
        (doseq [[what f expected] (get (merge module-cases std-module-cases) (:path m))]
          (let [v (f facts)] (check (str what (when (not= v expected) (str ": " (pr-str v)))) (= v expected))))
        (spit (str (System/getenv "TMPDIR") "/" crate "-iface-" (str/replace (:path m) "::" "-") ".report") (ac/report-text cmp helper facts))
        (check (str "no " crate " fact read from the helper's interface: " (count (:fns (ac/crate-facts (:si setup) crate)))) (empty? (:fns (ac/crate-facts (:si setup) crate))))
        (check (str "the control: " (pr-str ctl)) (and ctl (nth ctl 2)))))
    (println (str (or (System/getenv "IFACE_CRATE") "alloc") "-iface units: " (if (zero? @bad) "passed" (str @bad " failed"))))
    (System/exit (if (zero? @bad) 0 1))))

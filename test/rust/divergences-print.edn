;; repr/rust's print level's classes for bin/reap (the REAP row of Rust; test/reap/cells.edn's :rust :print): the text level's known
;; files (a file printed back byte for byte), the pretty layout's and the behaviour level's (a program built from the printed
;; files behaves as the original), in goi's format. Read with the Clojure reader.
[
 {:id :parser-rejects
  :title "a file rustc's parser rejects alone"
  :kind :design
  :why "a module whose text is one string literal (erased-serde's src/features_check/error.rs): rustc's own parser rejects the file alone (rust-lisp D20), so no forms are read to print"
  :decided "RR4; doc/rust/RUST-NOTES.md, \"RR4\""
  :match [#"rustc's parser rejects the file alone"]}
 {:id :converter-depth
  :title "the converter's evaluated call depth"
  :kind :deferred
  :why "the converter, evaluated by the tools' host, nests more than its 10,000 evaluated calls (Compiler's MAX_DEPTH, doc/go/J2G-SPEC.md section 10.5) on three UI-suite files rustc's own stack tests; compiled, the converter has Go's goroutine stack"
  :decided "RR5; doc/rust/RUST-NOTES.md, \"RR5\""
  :match [#"nests more than its 10,000 evaluated calls"]}
 {:id :token-spacing
  :title "token spacing (N3)"
  :kind :design
  :why "a program whose output shows the tokens' spacing (stringify!, assert!'s message): the printer derives its own spacing in the layouts, the original's is rustc's (SPEC N3)"
  :decided "RR5; SPEC section 11.2, N3"
  :match [#"stringify!" #"spacing \(N3\)"]}
 {:id :positions
  :title "positions a layout does not keep"
  :kind :design
  :why "a program that compares the lines or columns Location::caller(), line!(), column!(), a panic location or a backtrace give: the pretty layout keeps no lines and columns, mode :lines keeps the lines (columns differ); mode :full keeps both and has no such program"
  :decided "RR5; SPEC section 11.2"
  :match [#"Location::caller" #"line!\(\)" #"column!\(\)" #"location-detail" #"backtrace"]}
 {:id :own-text
  :title "a program that reads its own text"
  :kind :design
  :why "a program that reads its own source (include_str!(file!())) for its CRLF line ends: only mode :full keeps them"
  :decided "RR5; SPEC section 11.2"
  :match [#"reads its own text" #"include_str!"]}
]

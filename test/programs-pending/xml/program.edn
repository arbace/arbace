;; A15 of the Ghidra demo's G2 plan (the user's GH13 (a), round 53: java.xml stays out of the shipped world): java.xml
;; as this program's world extension. :jdk-extra's java.xml is read from jdk26u's sources at the platform's pin, cut by
;; A3 from JAXP's factories and the implementations JAXP's FactoryFinder names by default (DocumentBuilderFactoryImpl,
;; SAXParserFactoryImpl: Class.forName of a string j2g cannot see; as cut roots their classes are in the world, rooted
;; as the jrt classes are), read by repr/java with --patch-module and translated with the program into jrt; the rest of
;; java.xml declared outside the world (:outside [:platform], A8). The variants are javac's tool world's two java.xml
;; ones (no context class loader; the JDK catalog). Pending (test/programs-pending: no --build-program --check runs it)
;; until the day's build proves it (bin/arbace-go --build-program test/programs-pending/xml, then the run against
;; runs/main.out, written by hand from the JDK's behaviour: Xerces' NamedNodeMap sorts the attributes by name), then
;; git mv to test/programs/xml.
{:main-class demo.xml.Main
 :roots :entry
 :java {:release 25
        :outside [:platform]
        :jdk-extra [{:module "java.xml"
                     :closure {:roots ["javax.xml.parsers.DocumentBuilderFactory"
                                       "javax.xml.parsers.SAXParserFactory"
                                       "com.sun.org.apache.xerces.internal.jaxp.DocumentBuilderFactoryImpl"
                                       "com.sun.org.apache.xerces.internal.jaxp.SAXParserFactoryImpl"]}
                     :variants ["$arbace/overlay/jdk/javac/variants/SecuritySupport.ae"
                                "$arbace/overlay/jdk/javac/variants/JdkXmlConfig.ae"]}]
        :modules [{:name "app" :src ["src"]}]}}

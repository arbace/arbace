;; The paths doc/go/EVAL-SPEED.md's round 2 changed, as values, exception messages and stack traces
;; (the first 8 frames): protocol calls on records, deftypes, reifies, extended classes, nil and
;; objects that do not implement the protocol; a definterface's method; with-redefs of a protocol
;; fn; reflective calls (hits after the first round), their exceptions. Each case runs twice (the
;; inline caches' miss, then their hit).
;;
;; Usage: EXE test/bench/eval-traces.ae > OUT; the same on another executable, or on the frozen
;; JVM (java -cp arbace-for-java-26-v4.jar arbace.lang.Main test/bench/eval-traces.ae), and diff.

(defn inner [x] (throw (ex-info "boom" {:x x})))
(defn st [^Throwable e]
  (mapv (fn [^StackTraceElement f] [(.getClassName f) (.getMethodName f) (.getFileName f) (.getLineNumber f)])
        (take 8 (.getStackTrace e))))
(defn ex [^Throwable e] (str (class e) " " (.getMessage e)))
(defprotocol P (pa [x]) (pb [x y]) (pc [x y z]) (pd [x y z w]))
(defprotocol Q (pa2 [x]))
(defrecord R [v] P (pa [_] (inner v)) (pb [_ y] [v y]) (pc [_ y z] [v y z]) (pd [_ y z w] [v y z w]))
(deftype D [v] P (pa [_] v) (pb [_ y] (/ y 0)))
(defrecord R2 [v] Q (pa2 [_] v))
(extend-type String P (pa [s] (str "s" s)) (pb [s y] (inner y)))
(def rf (reify P (pa [_] :reify) (pb [_ y] (.length ^String y))))
(definterface I (go [x]) (^long prim [x]))
(deftype U [n] I (go [_ x] (if (nil? x) (inner n) [n x])) (prim [_ x] 7))
(dotimes [_ 2]
  (println (pb (->R 1) 2) (pc (->R 1) 2 3) (pd (->R 1) 2 3 4) (pa (D. 5)) (pa "x") (pa rf) (pb rf "abc"))
  (println (st (try (pa (->R 9)) (catch Exception e e))))
  (println (st (try (pb "q" 3) (catch Exception e e))))
  (println (st (try (pb (D. 1) 3) (catch Exception e e))) (try (pb (D. 1) 3) (catch Exception e (ex e))))
  (println (try (pa nil) (catch Exception e (ex e))))
  (println (try (pa 42) (catch Exception e (ex e))))
  (println (try (pa (->R2 1)) (catch Exception e (ex e))))
  (println (try (pb rf nil) (catch Exception e (ex e))))
  (println (try (pb rf 1) (catch Exception e (ex e))))
  (println (st (try (pb rf nil) (catch Exception e e))))
  (println (.go ^I (U. 1) 2) (.prim ^I (U. 1) 2) (st (try (.go ^I (U. 3) nil) (catch Exception e e))))
  (println (try (.go ^I (identity "x") 1) (catch Exception e (ex e))))
  (println (try (.go ^I (identity nil) 1) (catch Exception e (ex e))))
  (println (try (with-redefs [pa (fn [x] :redef)] [(pa (->R 1)) (pa "s")]) (catch Exception e (ex e))))
  (println (map pa [(D. 1) "y" rf (D. 2)]) (map #(pb % "ab") [(->R 1) (->R 2) rf]))
  (println (st (try (.charAt (identity "ab") 7) (catch Exception e e))) (try (.charAt (identity "ab") 7) (catch Exception e (ex e))))
  (println (try (.substring (identity "abc") (identity 1) (identity 2)) (catch Exception e (ex e))) (.indexOf (identity "abc") (int \b)) (.indexOf (identity "abc") "c"))
  (println (try (aget (identity (long-array 2)) 5) (catch Exception e (ex e))) (aget (identity (long-array 2)) 1) (alength (identity (byte-array 3))))
  (println (try (Integer/parseInt (identity "zz")) (catch Exception e (ex e))) (Math/abs (identity -3)) (Math/abs (identity -3.5)))
  (println (st (try (Integer/parseInt (identity "zz")) (catch Exception e e))))
  (println (let [sb (StringBuilder.)] (.append sb (identity "a")) (.append sb (identity 1)) (.append sb (identity \c)) (.append sb (identity 2.5)) (str sb)))
  (println (try (.foo (identity "x")) (catch Exception e (ex e))) (try (.get (java.util.ArrayList.) (identity 3)) (catch Exception e (ex e)))))

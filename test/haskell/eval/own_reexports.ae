;; DECISION 4 (a) of queue 325 (the user, 2026-11-17): the own path's reexported modules from the packages' .cabal files, not
;; ghc-pkg's answers in the pack haskell-ifaces-ghc-9.14.1. Every package of the corpus whose .cabal file's library reexports
;; modules (ghc-prim's GHC.Prim as GHC.Internal.Prim ..., ghc-bignum's GHC.Num.Backend ...), read by lib-check's own
;; arbace.repr.haskell.libcheck/cabal-reexports (Cabal's ModuleReexport items `orig as new`; a bare item, which keeps its name,
;; left out: its module is found by its own name), kept when the own interfaces hold the module it names; printed as
;; reexports.edn ({"NEW" "ORIG" ...}, one pair a line, sorted), the file bin/hsi check --libs own gives the front end.
;; usage: arbace test/haskell/eval/own_reexports.ae CORPUS.edn SRCROOT OWN-IF-DIR
(require '[arbace.repr.haskell.libcheck :as lc])
(import '[java.io File])
(let [[corpus src ifdir] *command-line-args*
      c (read-string (slurp corpus))
      pkgs (filter #(and (map? %) (:name %) (:dir %)) (tree-seq (some-fn map? sequential?) #(if (map? %) (vals %) (seq %)) c))
      aliases (into (sorted-map)
                    (for [p pkgs
                          :let [f (File. (File. ^String src ^String (:dir p)) (str (:name p) ".cabal"))]
                          :when (.isFile f)
                          [new orig] (lc/cabal-reexports (.getPath f))
                          :when (.isFile (File. ^String ifdir (str orig ".iface.edn")))]
                      [new orig]))]
  (println "{")
  (doseq [[a b] aliases] (println (str " " (pr-str a) " " (pr-str b))))
  (println "}"))

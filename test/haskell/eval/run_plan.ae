;; The testsuite's run tests as bin/hsi record-ref's plan (doc/haskell/HASKELL-EVAL-SURVEY.md §8.1, HES16 (a), HES17
;; (a)): test/haskell/eval/testsuite-run.edn's tests, those under one of DIRS (all with "-"), as rows separated by tabs:
;;   ID DIR KIND MAIN FLAGS RUN-OPTS EXIT NAME
;; ID testsuite/DIR/NAME; DIR under the testsuite's tests/; KIND the test's function; MAIN the file GHC is given (NAME.hs
;; or NAME.lhs for compile_and_run, the top module's file for the multi-module ones; "-" when none is found); FLAGS
;; the call's flags and extra_hc_opts (one string); RUN-OPTS extra_run_opts; EXIT the expected status (exit_code,
;; default 0); an empty field is "-". A test whose name is not a string literal (a loop's) is left out with a note on standard error.
;; usage: arbace test/haskell/eval/run_plan.ae TESTSUITE-RUN.edn TESTS-DIR DIRS
(require '[arbace.string :as s])
(import '[java.io File PushbackReader StringReader])

(let [[runs tests-dir dirs] *command-line-args*
      dirs (when (not= dirs "-") (s/split dirs #","))
      rdr (arbace.lang.LineNumberingPushbackReader. (StringReader. (slurp runs)))
      ts (loop [acc []] (let [x (read {:eof ::eof} rdr)] (if (= x ::eof) acc (recur (conj acc x)))))
      under? (fn [d] (or (nil? dirs) (some #(or (= d %) (s/starts-with? d (str % "/"))) dirs)))
      clean (fn [x] (s/replace (str x) #"[\t\n]" " "))]
  (doseq [{:keys [dir name func args hc-opts run-opts exit-code]} ts
          :when (under? dir)]
    (if-not (string? name)
      (binding [*out* *err*] (println "run_plan: left out (a computed name):" dir (pr-str name)))
      (let [d (File. (File. ^String tests-dir) ^String dir)
            exists? (fn [f] (.isFile (File. d ^String f)))
            arg0 (when (sequential? args) (first args))
            [main flags] (case (str func)
                           "compile_and_run" [(first (filter exists? [(str name ".hs") (str name ".lhs")])) arg0]
                           ("multimod_compile_and_run" "multi_compile_and_run")
                           [(when (string? arg0)
                              (first (filter exists? [arg0 (str arg0 ".hs") (str arg0 ".lhs")])))
                            (if (= (str func) "multi_compile_and_run")
                              ;; its extra sources, (tuple FILE OPTS) each (a test's C or Cmm, HES64 (a)), before its flags
                              (s/join " " (concat (for [t (when (sequential? (second args)) (second args))
                                                        :when (and (seq? t) (= 'tuple (first t)))
                                                        x (rest t) :when (and (string? x) (not= "" x))]
                                                    x)
                                                  [(let [o (nth args 2 "")] (if (string? o) o ""))]))
                              (second args))]
                           [nil nil])
            flags (s/trim (str (if (string? flags) flags "") " " (if (string? hc-opts) hc-opts "")))]
        (println (s/join "\t" (map #(if (= "" (str %)) "-" %)
                                    [(str "testsuite/" dir "/" name) dir (str func) (or main "-") (clean flags)
                                     (clean (if (string? run-opts) run-opts "")) (if (integer? exit-code) exit-code 0) name])))))))

;; The testsuite's run tests as bin/hsi record-ref's plan (doc/haskell/HASKELL-EVAL-SURVEY.md §8.1, HES16 (a), HES17
;; (a)): test/haskell/eval/testsuite-run.edn's tests, those under one of DIRS (all with "-"), as rows separated by tabs:
;;   ID DIR KIND MAIN FLAGS RUN-OPTS EXIT NAME
;; ID testsuite/DIR/NAME; DIR under the testsuite's tests/; KIND the test's function; MAIN the file GHC is given (NAME.hs
;; or NAME.lhs for compile_and_run, NAME.cmm for a cmm_src test, the top module's file for the multi-module ones, also when
;; all.T's pre_cmd `{compiler} --run ./GEN.hs` writes it (HES92 (a)); "-" when none is found); FLAGS
;; the call's flags and extra_hc_opts (one string; -threaded added for a test all.T runs only in threaded ways, HES84 (a)); RUN-OPTS extra_run_opts; EXIT the expected status (exit_code,
;; default 0); an empty field is "-". A test whose name is not a string literal (a loop's) is left out with a note on standard error.
;; usage: arbace test/haskell/eval/run_plan.ae TESTSUITE-RUN.edn TESTS-DIR DIRS
(require '[arbace.string :as s])
(import '[java.io File PushbackReader StringReader])

(defn- gen-pre
  "The generator a test's all.T runs before it as `pre_cmd('{compiler} --run ./GEN.hs')` (unboxedsums/ManyUbxSums: GEN writes the
  test's main module), GEN.hs or nil (HES92 (a); bin/lib/hsi/records.bash's hsi_pre_gen, which record-ref and bin/hsi check run first)"
  [opts]
  (some (fn [o] (when (and (seq? o) (= 'pre_cmd (first o)) (string? (second o)))
                  (second (re-matches #"\{compiler\} --run \./(\S+\.l?hs)" (second o)))))
        (if (sequential? opts) opts [opts])))

(defn- threaded-only?
  "A test whose all.T `only_ways` names threaded ways alone (threaded1, threaded2, nonmoving_thr, profthreaded: every way's name
  holds \"thr\", bin/lib/hsi/own-verdicts' rule): GHC's testsuite builds it -threaded, so its reference and hsi's run are the
  threaded RTS's (HES84 (a))"
  [opts]
  (some (fn [o] (when (and (seq? o) (= 'only_ways (first o)) (sequential? (second o)) (seq (second o)))
                  (every? #(and (string? %) (s/includes? % "thr")) (second o))))
        ;; (one option is the call itself, a list: `(only_ways [...])`)
        (if (and (seq? opts) (symbol? (first opts))) [opts] (if (sequential? opts) opts [opts]))))

(defn- linux-run-opts
  "A test's extra_run_opts under a condition on the platform that holds here (x86_64 Linux): `(unless (opsys \"darwin\") ...)`,
  `(when (opsys \"linux\") ...)` (allt.ae keeps only the unconditional ones as :run-opts; T21651's are conditional, HES84 (a)), or nil"
  [opts]
  (let [os? (fn [c] (when (and (seq? c) (= 'opsys (first c)) (string? (second c))) (= "linux" (second c))))]
    (some (fn [o] (when (and (seq? o) (#{'when 'unless} (first o)))
                    (let [c (os? (second o)) x (nth o 2 nil)]
                      (when (and (some? c) (= c (= 'when (first o))) (seq? x) (= 'extra_run_opts (first x)) (string? (second x)))
                        (second x)))))
          (if (and (seq? opts) (symbol? (first opts))) [opts] (if (sequential? opts) opts [opts])))))

(defn- x86-64-hc-opts
  "A test's extra_hc_opts under all.T's `(when (arch \"x86_64\") ...)`, the plan's platform's (x86_64 Linux, as linux-run-opts): CallConv's
  CallConv_x86_64.s (hs-speed, 2026-11-22: its assembly assembled by Arbace and run by x86i, bin/lib/hsi/check), or nil"
  [opts]
  (some (fn [o] (when (and (seq? o) (= 'when (first o)))
                  (let [c (second o) x (nth o 2 nil)]
                    (when (and (seq? c) (= 'arch (first c)) (= "x86_64" (second c))
                               (seq? x) (= 'extra_hc_opts (first x)) (string? (second x)))
                      (second x)))))
        (if (and (seq? opts) (symbol? (first opts))) [opts] (if (sequential? opts) opts [opts]))))

(let [[runs tests-dir dirs] *command-line-args*
      dirs (when (not= dirs "-") (s/split dirs #","))
      rdr (arbace.lang.LineNumberingPushbackReader. (StringReader. (slurp runs)))
      ts (loop [acc []] (let [x (read {:eof ::eof} rdr)] (if (= x ::eof) acc (recur (conj acc x)))))
      under? (fn [d] (or (nil? dirs) (some #(or (= d %) (s/starts-with? d (str % "/"))) dirs)))
      clean (fn [x] (s/replace (str x) #"[\t\n]" " "))]
  (doseq [{:keys [dir name func args hc-opts run-opts exit-code opts]} ts
          :when (under? dir)]
    (if-not (string? name)
      (binding [*out* *err*] (println "run_plan: left out (a computed name):" dir (pr-str name)))
      (let [d (File. (File. ^String tests-dir) ^String dir)
            exists? (fn [f] (.isFile (File. d ^String f)))
            arg0 (when (sequential? args) (first args))
            [main flags] (case (str func)
                           ;; HES92 (a): a test whose source is Cmm (all.T's cmm_src, T17920: the .cmm defines Main's closure),
                           ;; GHC given the .cmm
                           "compile_and_run" [(first (filter exists? (concat [(str name ".hs") (str name ".lhs")]
                                                                             (when (some #{'cmm_src} (if (sequential? opts) opts [opts]))
                                                                               [(str name ".cmm")]))))
                                              arg0]
                           ("multimod_compile_and_run" "multi_compile_and_run")
                           [(when (string? arg0)
                              (or (first (filter exists? [arg0 (str arg0 ".hs") (str arg0 ".lhs")]))
                                  ;; HES92 (a): the main a pre_cmd's generator writes (ManyUbxSums.hs), run first by the plan's users
                                  (when (gen-pre opts) (if (re-find #"\.l?hs$" arg0) arg0 (str arg0 ".hs")))))
                            (if (= (str func) "multi_compile_and_run")
                              ;; its extra sources, (tuple FILE OPTS) each (a test's C or Cmm, HES64 (a)), before its flags
                              (s/join " " (concat (for [t (when (sequential? (second args)) (second args))
                                                        :when (and (seq? t) (= 'tuple (first t)))
                                                        x (rest t) :when (and (string? x) (not= "" x))]
                                                    x)
                                                  [(let [o (nth args 2 "")] (if (string? o) o ""))]))
                              (second args))]
                           [nil nil])
            flags (s/trim (str (if (string? flags) flags "") " " (if (string? hc-opts) hc-opts "")
                               (when-let [x (x86-64-hc-opts opts)] (str " " x))
                               ;; HES84 (a): a test all.T runs only in threaded ways is built and run -threaded (its first way's RTS)
                               (when (and (threaded-only? opts)
                                          (not (re-find #"(^|\s)-threaded(\s|$)" (str flags " " hc-opts))))
                                 " -threaded")))]
        (println (s/join "\t" (map #(if (= "" (str %)) "-" %)
                                    [(str "testsuite/" dir "/" name) dir (str func) (or main "-") (clean flags)
                                     (clean (cond (string? run-opts) run-opts (linux-run-opts opts) (linux-run-opts opts) :else "")) (if (integer? exit-code) exit-code 0) name])))))))

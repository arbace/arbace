;; bin/hsi divergences (HE6, doc/haskell/HASKELL-EVAL-SURVEY.md "As built: HE6 (write-ahead)"): hsi check's recorded results
;; (test/haskell/check-hsi.edn, or --results FILE) judged against test/haskell/divergences.edn with no run, as bin/goi
;; divergences judges goi's and bin/reap the matrix: every program that does not pass in a class (its :ids), the kind of
;; its result among the class's :results, for :hsi its message holding the class's :message; a class whose members are all
;; passing, a member the results do not have and a class with no member are reported, never failures (a class stays
;; while a member is near its limit); the failures are a non-pass in no class and a result of another kind.
;; usage: arbace test/haskell/eval/divergences.ae RESULTS CLASSES [--programs] [--table]
;; exit 0 when every non-pass is classed, 1 else.
(require '[arbace.string :as s])

(defn read-all [f]
  (let [rdr (arbace.lang.LineNumberingPushbackReader. (java.io.StringReader. (slurp f)))]
    (loop [acc []] (let [x (read {:eof ::eof} rdr)] (if (= x ::eof) acc (recur (conj acc x)))))))

(let [[results classes & opts] *command-line-args*
      programs? (some #{"--programs"} opts)
      rs (read-all results)
      classes (first (read-all classes))
      by-id (into {} (map (juxt :id identity) rs))
      owner (into {} (for [c classes i (:ids c)] [i c]))
      nonpass (remove #(= :pass (:result %)) rs)
      bad (atom 0)
      members (group-by #(:id (get owner (:id %))) nonpass)]
  (doseq [r (sort-by :id nonpass)]
    (let [c (get owner (:id r))
          kind (:result r)]
      (cond
        (nil? c) (do (println "hsi divergences:" (:id r) "in no class (" (name kind) ")") (swap! bad inc))
        (and (:results c) (not (some #{kind} (:results c))))
        (do (println "hsi divergences:" (:id r) "in class" (:id c) "but its result" kind "is not the class's" (:results c)) (swap! bad inc))
        ;; HES43 (b): a result's reason, as hsi words it, among the class's :reasons
        (and (:reasons c) (:reason r) (not (some #{(:reason r)} (:reasons c))))
        (do (println "hsi divergences:" (:id r) "in class" (:id c) "but its reason" (:reason r) "is not the class's" (:reasons c)) (swap! bad inc))
        (and (:message c) (= kind :hsi) (not (s/includes? (str (:message r)) (:message c))))
        (do (println "hsi divergences:" (:id r) "in class" (:id c) "but hsi's message is not the class's") (swap! bad inc))
        programs? (println (:id r) (name (:id c)) (name kind)))))
  (println)
  (println "class                 kind      non-pass  pass  not-in-results  title")
  (doseq [c classes]
    (let [ids (:ids c)
          np (count (get members (:id c)))
          present (filter by-id ids)
          pass (count (filter #(= :pass (:result (by-id %))) present))
          absent (- (count ids) (count present))]
      (println (format "%-21s %-9s %8d %5d %15d  %s" (name (:id c)) (name (:kind c)) np pass absent (:title c)))
      (when (and (seq ids) (zero? np) (pos? (count present)))
        (println "  note: every member of the class passes: the class may go"))))
  (let [total (count rs) np (count nonpass) cl (- np @bad)]
    (println)
    (println (str "hsi divergences: " total " programs, " (- total np) " pass, " cl " in a class, " @bad " not")))
  (System/exit (if (zero? @bad) 0 1)))

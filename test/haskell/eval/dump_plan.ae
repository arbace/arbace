;; The boot libraries' STG dumps' plan for bin/hsi dumps (doc/haskell/HASKELL-EVAL-SURVEY.md §5.3, HES6 (a),
;; HES7 (a); "As built: HE1-HE3"): test/haskell/corpus-ghc-9.14.1.edn's library packages (not the PKG-Setup entries)
;; as rows separated by U+001F, one per package:
;;   NAME DIR UNIT-FLAG FLAGS MODULES HSC HSC-FLAGS GENPRIMOPCODE GENERATED
;; UNIT-FLAG the corpus's -this-unit-id (bin/hsi replaces it by the installed unit's id but for a wired-in unit);
;; FLAGS -XLANGUAGE, -XEXT..., the :ghc-flags but -this-unit-id, -i of each source directory (relative to DIR;
;; space-separated, $libdir as written); MODULES
;; the module names (ghc --make's targets, the .hsc modules' and the generated ones' included, GHC.Internal.Prim
;; not: GHC's own); HSC the .hsc files under DIR; HSC-FLAGS hsc2hs's; GENPRIMOPCODE FILE=OPTION; GENERATED
;; FILE=CHECKOUT-PATH. With BIGNUM native (HES7 (a)) ghc-internal's -DBIGNUM_GMP is -DBIGNUM_NATIVE and its module
;; GHC.Internal.Bignum.Backend.GMP left out, as its .cabal's flag bignum-native selects.
;; usage: arbace test/haskell/eval/dump_plan.ae CORPUS.edn [gmp|native]
(let [[f backend] *command-line-args*
      native? (not= backend "gmp")
      c (read-string (slurp f))
      j (fn [xs] (apply str (interpose " " xs)))]
  (doseq [p (:packages c)
          :when (not (.endsWith ^String (:name p) "-Setup"))]
    (let [gf (vec (:ghc-flags p))
          ui (.indexOf ^java.util.List gf "-this-unit-id")
          unit (if (neg? ui) "" (nth gf (inc ui)))
          flags (keep-indexed (fn [i x] (when-not (or (= i ui) (= i (inc ui))) x)) gf)
          internal? (= (:name p) "ghc-internal")
          flags (if (and internal? native?) (map #(if (= % "-DBIGNUM_GMP") "-DBIGNUM_NATIVE" %) flags) flags)
          mods (concat (map (comp str first) (:modules p)) (map (comp str first) (:hsc p))
                       (remove #(= (str %) "GHC.Internal.Prim") (map str (:generated p))))
          mods (if (and internal? native?) (remove #(= % "GHC.Internal.Bignum.Backend.GMP") mods) mods)]
      (println (str (:name p) "\u001f" (:dir p) "\u001f" unit "\u001f"
                    (j (concat [(str "-X" (:language p))] (map #(str "-X" %) (:extensions p)) flags
                               (distinct (for [[m f] (:modules p)]
                                           (let [n (- (count f) (count (str m)) 3)]
                                             (if (pos? n) (str "-i" (subs f 0 (dec n))) "-i."))))))
                    "\u001f" (j mods)
                    "\u001f" (j (map second (:hsc p)))
                    "\u001f" (j (:hsc-flags p))
                    "\u001f" (j (map (fn [[x y]] (str x "=" y)) (:genprimopcode p)))
                    "\u001f" (j (map (fn [[x y]] (str x "=" y)) (:generated-files p))))))))

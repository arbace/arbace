;; repr/haskell's spec (doc/haskell/SPEC.md, §3.2 and Appendix A): the rule that decides whether a
;; Haskell name is written bare in Haskell forms or respelled. Usage:
;;   arbace test/haskell/name_rule.ae NAMES [COUNTS]
;; NAMES holds one Haskell name per line, as GHC prints it (`M.insert`, `:+:`, `</>`); COUNTS, when
;; given, is `uniq -c` output (count, then name) and weights the summary by occurrences. Prints
;; every name that is not bare with its spelling, then a summary.
;;
;; The rule (SPEC §3.2): a name is bare when the reader reads its text, alone between
;; delimiters, as exactly one form that is a symbol without a namespace whose name is the text,
;; or, for a constructor operator (`:|`), a keyword without a namespace that prints as the text.
;; Built-in syntax (`:`, `[]`, `()`, tuples) has forms of its own (SPEC §3.3) and is listed apart.

(require (quote [arbace.string :as s]))

(defn bare? [t]
  (try
    (let [v (read-string (str "[" t "]"))]
      (and (= 1 (count v))
           (let [x (first v)]
             (or (and (symbol? x) (nil? (namespace x)) (= (name x) t))
                 (and (keyword? x) (nil? (namespace x)) (= (str x) t)
                      ;; a keyword whose name begins with a letter or _ is a form keyword
                      (not (re-matches #":[\p{L}_].*" t)))))))
    (catch Throwable _ false)))

(defn built-in? [t]
  (or (#{":" "[]" "()" "(##)" "(# #)" "->"} t)
      (re-matches #"\(#?,+#?\)" t)))

(defn spelling [t]
  (cond (= t ":") ":cons"
        (built-in? t) "(built-in syntax, SPEC §3.3)"
        :else (str "(:name " (pr-str t) ")")))

(let [[names-file counts-file] *command-line-args*
      names (remove s/blank? (s/split-lines (slurp names-file)))
      weight (if counts-file
               (into {} (for [l (s/split-lines (slurp counts-file))
                              :let [[_ n t] (re-matches #"\s*(\d+) (.*)" l)]
                              :when t]
                          [t (Long/parseLong n)]))
               (constantly 1))
      w (fn [t] (or (weight t) 1))
      odd (remove bare? names)
      [bi esc] ((juxt filter remove) built-in? odd)]
  (doseq [t esc] (println (pr-str t) "=>" (spelling t) (w t)))
  (println "names" (count names) "occurrences" (reduce + (map w names)))
  (println "bare" (- (count names) (count odd))
           "occurrences" (reduce + (map w (filter bare? names))))
  (println "respelled" (count esc) "occurrences" (reduce + (map w esc)))
  (println "built-in syntax" (count bi) "occurrences" (reduce + (map w bi))))

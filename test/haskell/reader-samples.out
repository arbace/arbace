;; 1. Haskell lexemes as they are (ghc-lisp's spellings)
::  !!  Invalid token: ::
(:: f T)  !!  Invalid token: ::
:  !!  Invalid token: :
(: x xs)  !!  Invalid token: :
:+:  !!  Invalid token: :+:
M.:+:  !!  Invalid token: M.:+:
:|  =>  1: :| {kw name="|"}
:+  =>  1: :+ {kw name="+"}
:.  =>  1: :. {kw name="."}
:=  =>  1: := {kw name="="}
:/  =>  1: :/ {kw name="/"}
:->  =>  1: :-> {kw name="->"}
::+  =>  1: :user/+ {kw name="+" ns=user}
:%  =>  1: :% {kw name="%"}
:<|  =>  1: :<| {kw name="<|"}
:|>  =>  1: :|> {kw name="|>"}
:!  =>  1: :! {kw name="!"}
:@  !!  Invalid token: :
:#  =>  1: :# {kw name="#"}
:$  =>  1: :$ {kw name="$"}
:&  =>  1: :& {kw name="&"}
:*:  !!  Invalid token: :*:
:<>  =>  1: :<> {kw name="<>"}
:\\  !!  Invalid token: :
(\ x e)  !!  Unsupported character: \ x
\case  !!  Unsupported character: \case
'a'  =>  1: (quote a') {list}
'\n'  !!  Unsupported character: \n'
'\''  !!  Unsupported character: \''
"\1234"  =>  1: "S4" {str len=2 cps=[83 52]}
"a\&b"  !!  Unsupported escape character: \&
"\SOH"  !!  Unsupported escape character: \S
"\^A"  !!  Unsupported escape character: \^
"\x41"  !!  Unsupported escape character: \x
"\o101"  !!  Unsupported escape character: \o
"a\   \b"  !!  Unsupported escape character: \ 
"\DEL"  !!  Unsupported escape character: \D
0o17  !!  Invalid number: 0o17
0b101  !!  Invalid number: 0b101
1_000_000  !!  Invalid number: 1_000_000
0x1.8p1  !!  Invalid number: 0x1.8p1
1e3  =>  1: 1000.0 {double}
1E3  =>  1: 1000.0 {double}
1.5e-3  =>  1: 0.0015 {double}
0x1F  =>  1: 31 {int class java.lang.Long}
007  =>  1: 7 {int class java.lang.Long}
-5  =>  1: -5 {int class java.lang.Long}
-0  =>  1: 0 {int class java.lang.Long}
-0.0  =>  1: -0.0 {double}
3#  !!  Unmatched delimiter: ]
3##  !!  Unmatched delimiter: ]
"x"#  !!  Unmatched delimiter: ]
'x'#  =>  1: (quote x'#) {list}
1.5#  !!  Unmatched delimiter: ]
123#Int8  !!  Unmatched delimiter: ]
#foo  !!  Unmatched delimiter: ]
#.  !!  Unmatched delimiter: ]
^  !!  Unmatched delimiter: ]
^^  !!  Unmatched delimiter: ]
x^y  !!  Unmatched delimiter: ]
.~  !!  Unmatched delimiter: ]
%~  !!  Unmatched delimiter: ]
&~  !!  Unmatched delimiter: ]
<~  !!  Unmatched delimiter: ]
=~  !!  Unmatched delimiter: ]
~  !!  Unmatched delimiter: ]
~~>  =>  1: (arbace.core/unquote (arbace.core/unquote >)) {list}
(~ p)  =>  1: ((arbace.core/unquote p)) {list}
~p  =>  1: (arbace.core/unquote p) {list}
@  !!  Unmatched delimiter: ]
@Int  =>  1: (arbace.core/deref Int) {list}
x@y  =>  2: x {sym} | (arbace.core/deref y) {list}
<@>  =>  2: < {sym} | (arbace.core/deref >) {list}
@?  =>  1: (arbace.core/deref ?) {list}
//  !!  Invalid token: //
/  =>  1: / {sym}
M./  !!  Invalid token: M./
M.//  =>  1: M.// {sym ns=M. name=/}
\\  =>  1: \\ {char 92}
\  !!  EOF while reading
!  =>  1: ! {sym}
!!  =>  1: !! {sym}
$  =>  1: $ {sym}
$!  =>  1: $! {sym}
<$>  =>  1: <$> {sym}
>>=  =>  1: >>= {sym}
.  =>  1: . {sym}
..  =>  1: .. {sym}
Prelude..  =>  1: Prelude.. {sym}
M.!  =>  1: M.! {sym}
|  =>  1: | {sym}
||  =>  1: || {sym}
->  =>  1: -> {sym}
<-  =>  1: <- {sym}
=>  =>  1: => {sym}
=  =>  1: = {sym}
==  =>  1: == {sym}
/=  !!  Invalid token: /=
<=  =>  1: <= {sym}
>=  =>  1: >= {sym}
&&  =>  1: && {sym}
&  =>  1: & {sym}
#  !!  Unmatched delimiter: ]
##  !!  Unmatched delimiter: ]
+#  =>  1: +# {sym}
==#  =>  1: ==# {sym}
*##  =>  1: *## {sym}
x#  =>  1: x# {sym}
Int#  =>  1: Int# {sym}
State#  =>  1: State# {sym}
?x  =>  1: ?x {sym}
foldl'  =>  1: foldl' {sym}
x''  =>  1: x'' {sym}
'Just  =>  1: (quote Just) {list}
''T  =>  1: (quote (quote T)) {list}
'[]  =>  1: (quote []) {list}
'[a b]  =>  1: (quote [a b]) {list}
'(:tuple a b)  =>  1: (quote (:tuple a b)) {list}
':  !!  Invalid token: :
_  =>  1: _ {sym}
_x  =>  1: _x {sym}
x_  =>  1: x_ {sym}
true  =>  1: true {true}
false  =>  1: false {false}
nil  =>  1: nil {nil}
Nil  =>  1: Nil {sym}
True  =>  1: True {sym}
fn  =>  1: fn {sym}
do  =>  1: do {sym}
let  =>  1: let {sym}
if  =>  1: if {sym}
case  =>  1: case {sym}
where  =>  1: where {sym}
data  =>  1: data {sym}
hs/=  =>  1: hs/= {sym ns=hs name==}
hs/sig  =>  1: hs/sig {sym ns=hs name=sig}
hs/data  =>  1: hs/data {sym ns=hs name=data}
hs/::  !!  Invalid token: hs/::
hs/import  =>  1: hs/import {sym ns=hs name=import}
`  !!  Unmatched delimiter: ]
,  =>  0: 
;  !!  EOF while reading
;; 2. The spec's respellings
(:sig f T)  =>  1: (:sig f T) {list}
(hs/sig [f g] T)  =>  1: (hs/sig [f g] T) {list}
(:lambda [x y] e)  =>  1: (:lambda [x y] e) {list}
(:lambda-case (-> 0 a))  =>  1: (:lambda-case (-> 0 a)) {list}
(:lambda-cases (-> 0 1 a))  =>  1: (:lambda-cases (-> 0 1 a)) {list}
(:cons x xs)  =>  1: (:cons x xs) {list}
(:infix x :cons xs)  =>  1: (:infix x :cons xs) {list}
(:name ":+:")  =>  1: (:name ":+:") {list}
(:name "M.:+:")  =>  1: (:name "M.:+:") {list}
(:name "^")  =>  1: (:name "^") {list}
(:name "~")  =>  1: (:name "~") {list}
(:infix x (:name "^") 2)  =>  1: (:infix x (:name "^") 2) {list}
(:name "true")  =>  1: (:name "true") {list}
\a  =>  1: \a {char 97}
\'  =>  1: \' {char 39}
\"  =>  1: \" {char 34}
\\  =>  1: \\ {char 92}
\newline  =>  1: \newline {char 10}
\space  =>  1: \space {char 32}
\tab  =>  1: \tab {char 9}
\return  =>  1: \return {char 13}
\backspace  =>  1: \backspace {char 8}
\formfeed  =>  1: \formfeed {char 12}
\u0000  =>  1: \\u0000 {char 0}
\u0007  =>  1: \\u0007 {char 7}
\u007f  =>  1: \\u007f {char 127}
\u00e9  =>  1: \é {char 233}
\é  =>  1: \é {char 233}
\u3042  =>  1: \あ {char 12354}
\uD800  !!  Invalid character constant: \ud800
\uDFFF  !!  Invalid character constant: \udfff
\uFFFF  =>  1: \￿ {char 65535}
\😀  !!  Unsupported character: \😀
(:char 0x1F600)  =>  1: (:char 128512) {list}
(:char 0xD800)  =>  1: (:char 55296) {list}
"\u0001"  =>  1: "\u0001" {str len=1 cps=[1]}
"\u0000"  =>  1: "\u0000" {str len=1 cps=[0]}
"a\u0000b"  =>  1: "a\u0000b" {str len=3 cps=[97 0 98]}
"Ӓ"  =>  1: "Ӓ" {str len=1 cps=[1234]}
"\uD800"  =>  1: "\ud800" {str len=1 cps=[55296]}
"\uD83D\uDE00"  =>  1: "😀" {str len=2 cps=[55357 56832]}
"😀"  =>  1: "😀" {str len=2 cps=[55357 56832]}
(:string "a" 0xD800 "b")  =>  1: (:string "a" 55296 "b") {list}
(:int# 3)  =>  1: (:int# 3) {list}
(:word# 3)  =>  1: (:word# 3) {list}
(:float# 1.5)  =>  1: (:float# 1.5) {list}
(:double# 1.5)  =>  1: (:double# 1.5) {list}
(:char# \x)  =>  1: (:char# \x) {list}
(:addr# "x")  =>  1: (:addr# "x") {list}
(:int8# 3)  =>  1: (:int8# 3) {list}
(:word64# 18446744073709551615)  =>  1: (:word64# 18446744073709551615N) {list}
(:label "foo")  =>  1: (:label "foo") {list}
(:label "_x")  =>  1: (:label "_x") {list}
(:lazy p)  =>  1: (:lazy p) {list}
(:bang p)  =>  1: (:bang p) {list}
(:as x p)  =>  1: (:as x p) {list}
@T  =>  1: (arbace.core/deref T) {list}
@(Maybe a)  =>  1: (arbace.core/deref (Maybe a)) {list}
@_  =>  1: (arbace.core/deref _) {list}
(f @T x)  =>  1: (f (arbace.core/deref T) x) {list}
(:neg-zero)  =>  1: (:neg-zero) {list}
0.1  =>  1: 0.1 {double}
1000.0  =>  1: 1000.0 {double}
1.0E10  =>  1: 1.0E10 {double}
1E+400M  =>  1: 1E+400M {bigdec}
1E+1000000000M  =>  1: 1E+1000000000M {bigdec}
1/4  =>  1: 1/4 {ratio}
3M  =>  1: 3M {bigdec}
3.0M  =>  1: 3.0M {bigdec}
0.1000000000000000055511151231257827021181583404541015625M  =>  1: 0.1000000000000000055511151231257827021181583404541015625M {bigdec}
18446744073709551616  =>  1: 18446744073709551616N {int class arbace.lang.BigInt}
-9223372036854775809  =>  1: -9223372036854775809N {int class arbace.lang.BigInt}
2r101  =>  1: 5 {int class java.lang.Long}
017  =>  1: 15 {int class java.lang.Long}
0x1F  =>  1: 31 {int class java.lang.Long}
^{:hs/pos [3 1 3 10]} (f x)  =>  1: (f x) {list}
^{:hs/atext {1 "0x1F"}} (f 31)  =>  1: (f 31) {list}
[1 2 ..]  =>  1: [1 2 ..] {vector}
[x | (<- x xs)]  =>  1: [x | (<- x xs)] {vector}
(:tuple a :_)  =>  1: (:tuple a :_) {list}
(:utuple a b)  =>  1: (:utuple a b) {list}
(:usum :_ x :_)  =>  1: (:usum :_ x :_) {list}
;; 3. Operator heads and qualified operators
(+ a b)  =>  1: (+ a b) {list}
(<> a b c)  =>  1: (<> a b c) {list}
(>>= m k)  =>  1: (>>= m k) {list}
(. f g)  =>  1: (. f g) {list}
($ f x)  =>  1: ($ f x) {list}
(M.! m k)  =>  1: (M.! m k) {list}
(Prelude.. f g)  =>  1: (Prelude.. f g) {list}
(:section-l x +)  =>  1: (:section-l x +) {list}
(:section-r + x)  =>  1: (:section-r + x) {list}
(:section-r div 2)  =>  1: (:section-r div 2) {list}
(- x)  =>  1: (- x) {list}
(- a b)  =>  1: (- a b) {list}
(! arr i)  =>  1: (! arr i) {list}
(!! xs 0)  =>  1: (!! xs 0) {list}
(<|> a b)  =>  1: (<|> a b) {list}
(<*> f x)  =>  1: (<*> f x) {list}
(*> a b)  =>  1: (*> a b) {list}
(<* a b)  =>  1: (<* a b) {list}
(<$ a b)  =>  1: (<$ a b) {list}
($> a b)  =>  1: ($> a b) {list}
(<&> a b)  =>  1: (<&> a b) {list}
(>=> f g)  =>  1: (>=> f g) {list}
(<=< f g)  =>  1: (<=< f g) {list}
(.|. a b)  =>  1: (.|. a b) {list}
(.&. a b)  =>  1: (.&. a b) {list}
(** a b)  =>  1: (** a b) {list}
(++ a b)  =>  1: (++ a b) {list}
(\\\\ a b)  =>  1: (\\ \\ a b) {list}
(\\ a b)  =>  1: (\\ a b) {list}
(&&& f g)  =>  1: (&&& f g) {list}
(*** f g)  =>  1: (*** f g) {list}
(>>> f g)  =>  1: (>>> f g) {list}
(<<< f g)  =>  1: (<<< f g) {list}
(<=> a b)  =>  1: (<=> a b) {list}
(|> a b)  =>  1: (|> a b) {list}
(<| a b)  =>  1: (<| a b) {list}
(+++ a b)  =>  1: (+++ a b) {list}
(:+: a b)  !!  Invalid token: :+:
(:-> a b)  =>  1: (:-> a b) {list}
(-< f x)  =>  1: (-< f x) {list}
(-<< f x)  =>  1: (-<< f x) {list}
(>- x f)  =>  1: (>- x f) {list}
(>>- x f)  =>  1: (>>- x f) {list}
;; 4. More names: slashes, colons, Unicode, dots
</>  =>  1: </> {sym ns=< name=>}
<//>  =>  1: <//> {sym ns=< name=/>}
M.</>  =>  1: M.</> {sym ns=M.< name=>}
.:  !!  Invalid token: .:
:-  =>  1: :- {kw name="-"}
:--  =>  1: :-- {kw name="--"}
M.:|  =>  1: M.:| {sym}
M.:+  =>  1: M.:+ {sym}
∘  =>  1: ∘ {sym}
→  =>  1: → {sym}
∷  =>  1: ∷ {sym}
∀  =>  1: ∀ {sym}
⊸  =>  1: ⊸ {sym}
★  =>  1: ★ {sym}
λ  =>  1: λ {sym}
x.y  =>  1: x.y {sym}
A.B.c  =>  1: A.B.c {sym}
.5  =>  1: .5 {sym}
M.True  =>  1: M.True {sym}
Data.Map.Map  =>  1: Data.Map.Map {sym}
::>  =>  1: :user/> {kw name=">" ns=user}
:::  !!  Invalid token: :::
:..  =>  1: :.. {kw name=".."}
-->  =>  1: --> {sym}
|>  =>  1: |> {sym}
<|  =>  1: <| {sym}
?  =>  1: ? {sym}
??  =>  1: ?? {sym}
%  =>  1: % {sym}
%1  =>  1: %1 {sym}
;; 5. Characters that are delimiters or dispatch characters, and one-letter names
\(  =>  1: \( {char 40}
\)  =>  1: \) {char 41}
\[  =>  1: \[ {char 91}
\]  =>  1: \] {char 93}
\{  =>  1: \{ {char 123}
\}  =>  1: \} {char 125}
\;  =>  1: \; {char 59}
\,  =>  1: \, {char 44}
\#  =>  1: \# {char 35}
\@  =>  1: \@ {char 64}
\~  =>  1: \~ {char 126}
\^  =>  1: \^ {char 94}
\`  =>  1: \` {char 96}
\u  =>  1: \u {char 117}
\o  =>  1: \o {char 111}
\n  =>  1: \n {char 110}
\t  =>  1: \t {char 116}
\s  =>  1: \s {char 115}
\x  =>  1: \x {char 120}
[:before 2]  =>  1: [:before 2] {vector}
[:never]  =>  1: [:never] {vector}
(:neg-literal 0)  =>  1: (:neg-literal 0) {list}
(:hex-float 0x18 -3)  =>  1: (:hex-float 24 -3) {list}
(:multiline "hello\n  world")  =>  1: (:multiline "hello\n  world") {list}
(:op "/=" n 0)  =>  1: (:op "/=" n 0) {list}
(:op "~" a b)  =>  1: (:op "~" a b) {list}
':cons  =>  1: (quote :cons) {list}
(':cons a b)  =>  1: ((quote :cons) a b) {list}
(:doc :next " text")  =>  1: (:doc :next " text") {list}
(hs/doc :prev " text")  =>  1: (hs/doc :prev " text") {list}
hs/naked-splice  =>  1: hs/naked-splice {sym ns=hs name=naked-splice}

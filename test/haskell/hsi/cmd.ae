(ns go.arbace.hs.cmd.hsi
  (:require [arbace.go :as go]))

(go/package main
  :path "arbace/hs/cmd/hsi"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["aot.go" "main.go" "rtsflags.go" "rtsusage.go"]
  :init-order [rtsUsage]
  :positions :full)

(load "cmd/aot")
(load "cmd/main")
(load "cmd/rtsflags")
(load "cmd/rtsusage")

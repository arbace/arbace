(in-ns 'go.arbace.hs.cmd.hsi) ^{:go/comments [[3 1 "// rtsUsage is the RTS's usage text (+RTS -? and an option error), rts/RtsFlags.c's usage_text[] of GHC 9.14.1 for the"] [4 1 "// non-threaded and the threaded RTS of x86_64 Linux (TRACING, USE_LARGE_ADDRESS_SPACE; not PROFILING, DEBUG, TICKY_TICKY),"] [5 1 "// transcribed with its #if conditions resolved and its strings concatenated as C concatenates them (the Glasgow Haskell"] [6 1 "// Compiler License, LICENSE.md, \"GHC\")."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [] :go/trails [[137 5] [287 5] [288 3]]} (go/file "rtsusage.go" :imports [])






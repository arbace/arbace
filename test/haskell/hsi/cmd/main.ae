;; Command hsi runs a Haskell program's STG on hsi (arbace/hs), the light driver of bin/hsi:
;;
;;	hsi run --lib DIR... --prog DIR [--image DIR] [--name NAME] [--stats] [-- ARG...]
;;	hsi image --out DIR --lib DIR... [--jobs N]
;;	                   the libraries' images (HES32 (a)): each module's STG compiled into hsi's code trees as bytes,
;;	                   DIR/UNIT/MODULE.img, made when missing or stale; run --image DIR loads the fresh ones
;;	hsi aot [--lib DIR... --image DIR --modules FILE] [--prog DIR] --out DIR
;;	                   the program's modules (unit main) and the libraries' modules FILE names (UNIT:MODULE a line;
;;	                   HSI_AOT_MODULES=FILE on a run writes those it entered) compiled to Go (HE8, aot.go):
;;	                   DIR/aot_UNIT_MODULE.go each, files of package hs for the program's build (bin/hsi aot-build)
;;	hsi primops        the primops hsi implements, one a line
;;	hsi cfunctions     the C functions of its table, one a line
;;	hsi libm           lines NAME A B R (hex bits) on stdin, R the reference's result: each recomputed by hsi's
;;	                   port of musl's libm, the mismatches and a count per function printed (bin/hsi libm-check);
;;	                   --control: by Go's math package instead, the check's negative control (it must mismatch)
(in-ns 'go.arbace.hs.cmd.hsi) ^{:go/comments [[1 1 "// Command hsi runs a Haskell program's STG on hsi (arbace/hs), the light driver of bin/hsi:"] [2 1 "//"] [3 1 "//\thsi run --lib DIR... --prog DIR [--image DIR] [--name NAME] [--stats] [-- ARG...]"] [4 1 "//\thsi image --out DIR --lib DIR... [--jobs N]"] [5 1 "//\t                   the libraries' images (HES32 (a)): each module's STG compiled into hsi's code trees as bytes,"] [6 1 "//\t                   DIR/UNIT/MODULE.img, made when missing or stale; run --image DIR loads the fresh ones"] [7 1 "//\thsi aot [--lib DIR... --image DIR --modules FILE] [--prog DIR] --out DIR"] [8 1 "//\t                   the program's modules (unit main) and the libraries' modules FILE names (UNIT:MODULE a line;"] [9 1 "//\t                   HSI_AOT_MODULES=FILE on a run writes those it entered) compiled to Go (HE8, aot.go):"] [10 1 "//\t                   DIR/aot_UNIT_MODULE.go each, files of package hs for the program's build (bin/hsi aot-build)"] [11 1 "//\thsi primops        the primops hsi implements, one a line"] [12 1 "//\thsi cfunctions     the C functions of its table, one a line"] [13 1 "//\thsi libm           lines NAME A B R (hex bits) on stdin, R the reference's result: each recomputed by hsi's"] [14 1 "//\t                   port of musl's libm, the mismatches and a count per function printed (bin/hsi libm-check);"] [15 1 "//\t                   --control: by Go's math package instead, the check's negative control (it must mismatch)"] [71 1 "// run runs a program; Go's collector runs less often than its default (GOGC 200 unless GOGC is set)."] [100 5 "// a run stopped by SIGTERM or SIGXCPU (a limit) keeps its profile"] [126 2 "// of the RTS's options only -K, the stack's limit (HE4e: as GHC's, StackOverflow past it)"] [138 2 "// collect less often than Go's default: a run allocates fast and keeps little (with the libraries' images the"] [139 2 "// loaded code is small; HE4d measured 200 against 100 to 400: nfib's time within the noise, Loop's peak lower)"] [159 1 "// imageCmd writes the libraries' images (hsi image --out DIR --lib DIR... [--jobs N]): every module without a fresh"] [160 1 "// one compiled into it (HES32 (a)); a count of those made and those fresh, each error on stderr (status 1)."] [194 1 "// libmCmd checks hsi's libm against a reference's lines NAME A B R on stdin (hexadecimal bit patterns; B unused by"] [195 1 "// the functions of one argument): each mismatch printed, then NAME CALLS MISMATCHES per function; status 1 on one."] [196 1 "// control: Go's math package computes them (the libm hsi had before HE4b), which must mismatch"] [249 1 "// goMathCall is libm.Call on Go's math package, the float functions computed in double and rounded"] [272 1 "// progArgs is the program's arguments as GHC's RTS leaves them to getArgs (a program built -rtsopts): the RTS's"] [273 1 "// options, from +RTS to -RTS or the end, taken out, and after --RTS every argument kept as it is. hsi reads none of"] [274 1 "// them (a heap or stack size, -N, statistics: no effect on its run)"] [295 1 "// rtsSize is an RTS option's size (-K8m: 8 MB; k, m, g suffixes), or -1."]] :go/pos {:name [16 9] :package [16 1]} :go/semis [[76 12] [76 27] [129 26] [146 38] [164 12] [164 27] [256 21] [259 22] [262 46] [265 47]]} (go/file "main.go" :doc "Command hsi runs a Haskell program's STG on hsi (arbace/hs), the light driver of bin/hsi:\n\n\thsi run --lib DIR... --prog DIR [--image DIR] [--name NAME] [--stats] [-- ARG...]\n\thsi image --out DIR --lib DIR... [--jobs N]\n\t                   the libraries' images (HES32 (a)): each module's STG compiled into hsi's code trees as bytes,\n\t                   DIR/UNIT/MODULE.img, made when missing or stale; run --image DIR loads the fresh ones\n\thsi aot [--lib DIR... --image DIR --modules FILE] [--prog DIR] --out DIR\n\t                   the program's modules (unit main) and the libraries' modules FILE names (UNIT:MODULE a line;\n\t                   HSI_AOT_MODULES=FILE on a run writes those it entered) compiled to Go (HE8, aot.go):\n\t                   DIR/aot_UNIT_MODULE.go each, files of package hs for the program's build (bin/hsi aot-build)\n\thsi primops        the primops hsi implements, one a line\n\thsi cfunctions     the C functions of its table, one a line\n\thsi libm           lines NAME A B R (hex bits) on stdin, R the reference's result: each recomputed by hsi's\n\t                   port of musl's libm, the mismatches and a count per function printed (bin/hsi libm-check);\n\t                   --control: by Go's math package instead, the check's negative control (it must mismatch)\n" :imports [



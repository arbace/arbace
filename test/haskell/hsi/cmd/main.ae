;; Command hsi runs a Haskell program's STG on hsi (arbace/hs), the light driver of bin/hsi:
;;
;;	hsi run --lib DIR... --prog DIR [--name NAME] [--stats] [-- ARG...]
;;	hsi primops        the primops hsi implements, one a line
;;	hsi cfunctions     the C functions of its table, one a line
(in-ns 'go.arbace.hs.cmd.hsi) (go/file "main.go" :doc "Command hsi runs a Haskell program's STG on hsi (arbace/hs), the light driver of bin/hsi:\n\n\thsi run --lib DIR... --prog DIR [--name NAME] [--stats] [-- ARG...]\n\thsi primops        the primops hsi implements, one a line\n\thsi cfunctions     the C functions of its table, one a line\n" :imports [


    ^{:line 9} [bufio "bufio"]
    ^{:line 10} [fmt "fmt"]
    ^{:line 11} [os "os"]
    ^{:line 12} [debug "runtime/debug"]
    ^{:line 13} [pprof "runtime/pprof"]
    ^{:line 14} [sort "sort"]
    ^{:line 15} [time "time"]

    ^{:line 17} [hs "arbace/hs"]])


^{:go/end 42} (go/func main []
  (when (< (len os/Args) 2)
    (usage))

  (switch (aget os/Args 1)
    (case ["run"]
      (os/Exit (run (subslice os/Args 2))))
    (case ["cfunctions"]
      (let [ns (hs/CFunctions)]
        (sort/Strings ns)
        (range [_ n ns]
          (fmt/Println n))))

    (case ["primops"]
      (let [ns (hs/PrimopNames)]
        (sort/Strings ns)
        (range [_ n ns]
          (fmt/Println n))))

    (default
      (usage))))



^{:go/end 47} (go/func usage []
  (fmt/Fprintln os/Stderr "usage: hsi run --lib DIR... --prog DIR [--name NAME] [--stats] [-- ARG...] | hsi primops")
  (os/Exit 2))




^{:go/end 106} (go/func run "run runs a program; the loaded code is most of the live heap, so Go's collector runs less often than its\ndefault (GOGC 400 unless GOGC is set).\n" ^int [^{:tag (slice string)} args]
  (let [^{:tag (slice string)} libs (zero (slice string))
      (values prog name stats trace) (values "" "main" false false)
      ^{:line 54 :tag (slice string)} rest (zero (slice string))]
    (for [i 0] (< i (len args)) (inc! i)
      (switch (aget args i)
        (case ["--lib"]
          (inc! i)
          (set! libs (append libs (aget args i))))
        (case ["--prog"]
          (inc! i)
          (set! prog (aget args i)))
        (case ["--name"]
          (inc! i)
          (set! name (aget args i)))
        (case ["--stats"]
          (set! stats true))
        (case ["--trace"]
          (set! trace true))
        (case ["--cpuprofile"]
          (inc! i)
          (let [(values f err) (os/Create (aget args i))]
            (when (== err nil)
              (pprof/StartCPUProfile f)
              (defer (pprof/StopCPUProfile)))))

        (case ["--"]
          (set! rest (subslice args (+ i 1)))
          (set! i (len args)))
        (default
          (usage))))


    (let [out (bufio/NewWriterSize os/Stdout (<< 1 16))
        ^{:line 85} errw os/Stderr
        (values m err) (hs/NewMachine libs prog os/Stdin out errw)]
      (when (!= err nil)
        (fmt/Fprintln os/Stderr "hsi:" err)
        (return 3))

      (set! (.-ProgName m) name)
      (set! (.-Args m) rest)
      (set! (.-Trace m) trace)
      ;; the loaded code is most of the live heap: collect less often than Go's default
      (when (== (os/Getenv "GOGC") "")
        (debug/SetGCPercent 400))

      (let [t0 (time/Now)
          ^{:line 99} st (.Run m)]
        (.Flush out)
        (when stats
          (fmt/Fprintf os/Stderr "hsi: %s, %d modules (%d bytes) loaded, %d steps\n" (.Round (time/Since t0) time/Millisecond)
            (.Loaded m) (.LoadedBytes m) (.Steps m)))

        ^{:line 105} st))))

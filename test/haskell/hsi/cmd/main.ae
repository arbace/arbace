;; Command hsi runs a Haskell program's STG on hsi (arbace/hs), the light driver of bin/hsi:
;;
;;	hsi run --lib DIR... --prog DIR [--image DIR] [--c NODES] [--name NAME] [--stats] [-- ARG...]
;;	hsi image --out DIR --lib DIR... [--jobs N]
;;	                   the libraries' images (HES32 (a)): each module's STG compiled into hsi's code trees as bytes,
;;	                   DIR/UNIT/MODULE.img, made when missing or stale; run --image DIR loads the fresh ones
;;	hsi primops        the primops hsi implements, one a line
;;	hsi cfunctions     the C functions of its table, one a line
;;	hsi libm           lines NAME A B R (hex bits) on stdin, R the reference's result: each recomputed by hsi's
;;	                   port of musl's libm, the mismatches and a count per function printed (bin/hsi libm-check);
;;	                   --control: by Go's math package instead, the check's negative control (it must mismatch)
(in-ns 'go.arbace.hs.cmd.hsi) ^{:go/comments [[1 1 "// Command hsi runs a Haskell program's STG on hsi (arbace/hs), the light driver of bin/hsi:"] [2 1 "//"] [3 1 "//\thsi run --lib DIR... --prog DIR [--image DIR] [--c NODES] [--name NAME] [--stats] [-- ARG...]"] [4 1 "//\thsi image --out DIR --lib DIR... [--jobs N]"] [5 1 "//\t                   the libraries' images (HES32 (a)): each module's STG compiled into hsi's code trees as bytes,"] [6 1 "//\t                   DIR/UNIT/MODULE.img, made when missing or stale; run --image DIR loads the fresh ones"] [7 1 "//\thsi primops        the primops hsi implements, one a line"] [8 1 "//\thsi cfunctions     the C functions of its table, one a line"] [9 1 "//\thsi libm           lines NAME A B R (hex bits) on stdin, R the reference's result: each recomputed by hsi's"] [10 1 "//\t                   port of musl's libm, the mismatches and a count per function printed (bin/hsi libm-check);"] [11 1 "//\t                   --control: by Go's math package instead, the check's negative control (it must mismatch)"] [65 1 "// run runs a program; Go's collector runs less often than its default (GOGC 200 unless GOGC is set)."] [69 17 "// a -no-hs-main program: its C's main runs (hsi run --c NODES --c-main)"] [100 5 "// a run stopped by SIGTERM or SIGXCPU (a limit) keeps its profile"] [126 2 "// of the RTS's options only -K, the stack's limit (HE4e: as GHC's, StackOverflow past it)"] [135 2 "// a program's own C (HES64 (a)): its node program loaded over the machine's memory before main"] [145 2 "// collect less often than Go's default: a run allocates fast and keeps little (with the libraries' images the"] [146 2 "// loaded code is small; HE4d measured 200 against 100 to 400: nfib's time within the noise, Loop's peak lower)"] [165 1 "// imageCmd writes the libraries' images (hsi image --out DIR --lib DIR... [--jobs N]): every module without a fresh"] [166 1 "// one compiled into it (HES32 (a)); a count of those made and those fresh, each error on stderr (status 1)."] [200 1 "// libmCmd checks hsi's libm against a reference's lines NAME A B R on stdin (hexadecimal bit patterns; B unused by"] [201 1 "// the functions of one argument): each mismatch printed, then NAME CALLS MISMATCHES per function; status 1 on one."] [202 1 "// control: Go's math package computes them (the libm hsi had before HE4b), which must mismatch"] [255 1 "// goMathCall is libm.Call on Go's math package, the float functions computed in double and rounded"] [278 1 "// progArgs is the program's arguments as GHC's RTS leaves them to getArgs (a program built -rtsopts): the RTS's"] [279 1 "// options, from +RTS to -RTS or the end, taken out, and after --RTS every argument kept as it is. hsi reads none of"] [280 1 "// them (a heap or stack size, -N, statistics: no effect on its run)"] [301 1 "// rtsSize is an RTS option's size (-K8m: 8 MB; k, m, g suffixes), or -1."]] :go/pos {:name [12 9] :package [12 1]} :go/semis [[71 12] [71 27] [129 26] [137 28] [170 12] [170 27] [262 21] [265 22] [268 46] [271 47]]} (go/file "main.go" :doc "Command hsi runs a Haskell program's STG on hsi (arbace/hs), the light driver of bin/hsi:\n\n\thsi run --lib DIR... --prog DIR [--image DIR] [--c NODES] [--name NAME] [--stats] [-- ARG...]\n\thsi image --out DIR --lib DIR... [--jobs N]\n\t                   the libraries' images (HES32 (a)): each module's STG compiled into hsi's code trees as bytes,\n\t                   DIR/UNIT/MODULE.img, made when missing or stale; run --image DIR loads the fresh ones\n\thsi primops        the primops hsi implements, one a line\n\thsi cfunctions     the C functions of its table, one a line\n\thsi libm           lines NAME A B R (hex bits) on stdin, R the reference's result: each recomputed by hsi's\n\t                   port of musl's libm, the mismatches and a count per function printed (bin/hsi libm-check);\n\t                   --control: by Go's math package instead, the check's negative control (it must mismatch)\n" :imports [



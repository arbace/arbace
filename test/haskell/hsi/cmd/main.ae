;; Command hsi runs a Haskell program's STG on hsi (arbace/hs), the light driver of bin/hsi:
;;
;;	hsi run --lib DIR... --prog DIR [--image DIR] [--c NODES] [--name NAME] [--stats] [-- ARG...]
;;	hsi image --out DIR --lib DIR... [--jobs N]
;;	                   the libraries' images (HES32 (a)): each module's STG compiled into hsi's code trees as bytes,
;;	                   DIR/UNIT/MODULE.img, made when missing or stale; run --image DIR loads the fresh ones
;;	hsi aot [--lib DIR... --image DIR --modules FILE] [--prog DIR] --out DIR
;;	                   the program's modules (unit main) and the libraries' modules FILE names (UNIT:MODULE a line;
;;	                   HSI_AOT_MODULES=FILE on a run writes those it entered) compiled to Go (HE8, aot.go):
;;	                   DIR/aot_UNIT_MODULE.go each, files of package hs for the program's build (bin/hsi aot-build)
;;	hsi repl --lib DIR... [--image DIR] --prog DIR --helper EXE --libdir GHCLIBDIR
;;	                   the REPL (HE7): ghci's session on stdin and stdout, the statements compiled by the session server
;;	                   EXE (tools/hsrepl, GHC's API) into DIR's modules and run here
;;	hsi primops        the primops hsi implements, one a line
;;	hsi cfunctions     the C functions of its table, one a line
;;	hsi libm           lines NAME A B R (hex bits) on stdin, R the reference's result: each recomputed by hsi's
;;	                   port of musl's libm, the mismatches and a count per function printed (bin/hsi libm-check);
;;	                   --control: by Go's math package instead, the check's negative control (it must mismatch)
(in-ns 'go.arbace.hs.cmd.hsi) ^{:go/comments [[1 1 "// Command hsi runs a Haskell program's STG on hsi (arbace/hs), the light driver of bin/hsi:"] [2 1 "//"] [3 1 "//\thsi run --lib DIR... --prog DIR [--image DIR] [--c NODES] [--name NAME] [--stats] [-- ARG...]"] [4 1 "//\thsi image --out DIR --lib DIR... [--jobs N]"] [5 1 "//\t                   the libraries' images (HES32 (a)): each module's STG compiled into hsi's code trees as bytes,"] [6 1 "//\t                   DIR/UNIT/MODULE.img, made when missing or stale; run --image DIR loads the fresh ones"] [7 1 "//\thsi aot [--lib DIR... --image DIR --modules FILE] [--prog DIR] --out DIR"] [8 1 "//\t                   the program's modules (unit main) and the libraries' modules FILE names (UNIT:MODULE a line;"] [9 1 "//\t                   HSI_AOT_MODULES=FILE on a run writes those it entered) compiled to Go (HE8, aot.go):"] [10 1 "//\t                   DIR/aot_UNIT_MODULE.go each, files of package hs for the program's build (bin/hsi aot-build)"] [11 1 "//\thsi repl --lib DIR... [--image DIR] --prog DIR --helper EXE --libdir GHCLIBDIR"] [12 1 "//\t                   the REPL (HE7): ghci's session on stdin and stdout, the statements compiled by the session server"] [13 1 "//\t                   EXE (tools/hsrepl, GHC's API) into DIR's modules and run here"] [14 1 "//\thsi primops        the primops hsi implements, one a line"] [15 1 "//\thsi cfunctions     the C functions of its table, one a line"] [16 1 "//\thsi libm           lines NAME A B R (hex bits) on stdin, R the reference's result: each recomputed by hsi's"] [17 1 "//\t                   port of musl's libm, the mismatches and a count per function printed (bin/hsi libm-check);"] [18 1 "//\t                   --control: by Go's math package instead, the check's negative control (it must mismatch)"] [77 1 "// run runs a program; Go's collector runs less often than its default (GOGC 200 unless GOGC is set)."] [81 17 "// a -no-hs-main program: its C's main runs (hsi run --c NODES --c-main)"] [112 5 "// a run stopped by SIGTERM or SIGXCPU (a limit) keeps its profile"] [138 2 "// of the RTS's options only -K, the stack's limit (HE4e: as GHC's, StackOverflow past it)"] [147 2 "// a program's own C (HES64 (a)): its node program loaded over the machine's memory before main"] [157 2 "// collect less often than Go's default: a run allocates fast and keeps little (with the libraries' images the"] [158 2 "// loaded code is small; HE4d measured 200 against 100 to 400: nfib's time within the noise, Loop's peak lower)"] [183 1 "// imageCmd writes the libraries' images (hsi image --out DIR --lib DIR... [--jobs N]): every module without a fresh"] [184 1 "// one compiled into it (HES32 (a)); a count of those made and those fresh, each error on stderr (status 1)."] [218 1 "// libmCmd checks hsi's libm against a reference's lines NAME A B R on stdin (hexadecimal bit patterns; B unused by"] [219 1 "// the functions of one argument): each mismatch printed, then NAME CALLS MISMATCHES per function; status 1 on one."] [220 1 "// control: Go's math package computes them (the libm hsi had before HE4b), which must mismatch"] [273 1 "// goMathCall is libm.Call on Go's math package, the float functions computed in double and rounded"] [296 1 "// progArgs is the program's arguments as GHC's RTS leaves them to getArgs (a program built -rtsopts): the RTS's"] [297 1 "// options, from +RTS to -RTS or the end, taken out, and after --RTS every argument kept as it is. hsi reads none of"] [298 1 "// them (a heap or stack size, -N, statistics: no effect on its run)"] [319 1 "// rtsSize is an RTS option's size (-K8m: 8 MB; k, m, g suffixes), or -1."] [340 1 "// replUnesc undoes the session server's escapes of a line's text (\\n and \\\\)."] [360 1 "// replCmd is the REPL (hsi repl): ghci's transcript on stdin and stdout as `ghc --interactive` writes it (the banner, the"] [361 1 "// prompt \"ghci> \" before each line, \"Leaving GHCi.\" at the end of the input), each line a request to the session server,"] [362 1 "// its statements run on the machine and the values they bind kept for the lines after."] [429 2 "// request sends a line and handles the replies up to OK or FAIL; true for OK"] [461 6 "// the setup statement: its first name is the wrapper itself"]] :go/pos {:name [19 9] :package [19 1]} :go/semis [[83 12] [83 27] [141 26] [149 28] [170 38] [188 12] [188 27] [280 21] [283 22] [286 46] [289 47] [343 12] [343 24] [366 12] [366 27] [408 23] [424 24] [497 12] [497 14]]} (go/file "main.go" :doc "Command hsi runs a Haskell program's STG on hsi (arbace/hs), the light driver of bin/hsi:\n\n\thsi run --lib DIR... --prog DIR [--image DIR] [--c NODES] [--name NAME] [--stats] [-- ARG...]\n\thsi image --out DIR --lib DIR... [--jobs N]\n\t                   the libraries' images (HES32 (a)): each module's STG compiled into hsi's code trees as bytes,\n\t                   DIR/UNIT/MODULE.img, made when missing or stale; run --image DIR loads the fresh ones\n\thsi aot [--lib DIR... --image DIR --modules FILE] [--prog DIR] --out DIR\n\t                   the program's modules (unit main) and the libraries' modules FILE names (UNIT:MODULE a line;\n\t                   HSI_AOT_MODULES=FILE on a run writes those it entered) compiled to Go (HE8, aot.go):\n\t                   DIR/aot_UNIT_MODULE.go each, files of package hs for the program's build (bin/hsi aot-build)\n\thsi repl --lib DIR... [--image DIR] --prog DIR --helper EXE --libdir GHCLIBDIR\n\t                   the REPL (HE7): ghci's session on stdin and stdout, the statements compiled by the session server\n\t                   EXE (tools/hsrepl, GHC's API) into DIR's modules and run here\n\thsi primops        the primops hsi implements, one a line\n\thsi cfunctions     the C functions of its table, one a line\n\thsi libm           lines NAME A B R (hex bits) on stdin, R the reference's result: each recomputed by hsi's\n\t                   port of musl's libm, the mismatches and a count per function printed (bin/hsi libm-check);\n\t                   --control: by Go's math package instead, the check's negative control (it must mismatch)\n" :imports [



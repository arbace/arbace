;; Command hsi runs a Haskell program's STG on hsi (arbace/hs), the light driver of bin/hsi:
;;
;;	hsi run --lib DIR... --prog DIR [--name NAME] [--stats] [-- ARG...]
;;	hsi primops        the primops hsi implements, one a line
;;	hsi cfunctions     the C functions of its table, one a line
;;	hsi libm           lines NAME A B R (hex bits) on stdin, R the reference's result: each recomputed by hsi's
;;	                   port of musl's libm, the mismatches and a count per function printed (bin/hsi libm-check);
;;	                   --control: by Go's math package instead, the check's negative control (it must mismatch)
(in-ns 'go.arbace.hs.cmd.hsi) ^{:go/comments [[1 1 "// Command hsi runs a Haskell program's STG on hsi (arbace/hs), the light driver of bin/hsi:"] [2 1 "//"] [3 1 "//\thsi run --lib DIR... --prog DIR [--name NAME] [--stats] [-- ARG...]"] [4 1 "//\thsi primops        the primops hsi implements, one a line"] [5 1 "//\thsi cfunctions     the C functions of its table, one a line"] [6 1 "//\thsi libm           lines NAME A B R (hex bits) on stdin, R the reference's result: each recomputed by hsi's"] [7 1 "//\t                   port of musl's libm, the mismatches and a count per function printed (bin/hsi libm-check);"] [8 1 "//\t                   --control: by Go's math package instead, the check's negative control (it must mismatch)"] [58 1 "// run runs a program; the loaded code is most of the live heap, so Go's collector runs less often than its"] [59 1 "// default (GOGC 400 unless GOGC is set)."] [103 2 "// the loaded code is most of the live heap: collect less often than Go's default"] [117 1 "// libmCmd checks hsi's libm against a reference's lines NAME A B R on stdin (hexadecimal bit patterns; B unused by"] [118 1 "// the functions of one argument): each mismatch printed, then NAME CALLS MISMATCHES per function; status 1 on one."] [119 1 "// control: Go's math package computes them (the libm hsi had before HE4b), which must mismatch"] [172 1 "// goMathCall is libm.Call on Go's math package, the float functions computed in double and rounded"] [195 1 "// progArgs is the program's arguments as GHC's RTS leaves them to getArgs (a program built -rtsopts): the RTS's"] [196 1 "// options, from +RTS to -RTS or the end, taken out, and after --RTS every argument kept as it is. hsi reads none of"] [197 1 "// them (a heap or stack size, -N, statistics: no effect on its run)"]] :go/pos {:name [9 9] :package [9 1]} :go/semis [[64 12] [64 27] [179 21] [182 22] [185 46] [188 47]]} (go/file "main.go" :doc "Command hsi runs a Haskell program's STG on hsi (arbace/hs), the light driver of bin/hsi:\n\n\thsi run --lib DIR... --prog DIR [--name NAME] [--stats] [-- ARG...]\n\thsi primops        the primops hsi implements, one a line\n\thsi cfunctions     the C functions of its table, one a line\n\thsi libm           lines NAME A B R (hex bits) on stdin, R the reference's result: each recomputed by hsi's\n\t                   port of musl's libm, the mismatches and a count per function printed (bin/hsi libm-check);\n\t                   --control: by Go's math package instead, the check's negative control (it must mismatch)\n" :imports [



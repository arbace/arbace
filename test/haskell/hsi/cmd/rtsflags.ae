(in-ns 'go.arbace.hs.cmd.hsi) ^{:go/comments [[3 1 "// The RTS's options as GHC 9.14.1's RTS reads them (rts/RtsFlags.c's procRtsOpts and its helpers decodeSize, parseDouble,"] [4 1 "// read_trace_flags, bad_option, errorUsage; the Glasgow Haskell Compiler License, LICENSE.md, \"GHC\"), ported rule for rule"] [5 1 "// for x86_64 Linux's non-threaded and threaded RTS (TRACING; not PROFILING, DEBUG, TICKY_TICKY, NOSMP; no libnuma): every"] [6 1 "// option accepted or refused with the RTS's message, an error ending the run as errorUsage ends it (each message and the"] [7 1 "// usage text by errorBelch, status 1). Of the values, hsi uses -K (the stack's limit) and -xq (the allocation limit's"] [8 1 "// grace); the others have no meaning in hsi (heap and GC sizes, the eventlog, statistics files: -s, -S and -t's statistics"] [9 1 "// are not printed)."] [29 1 "// rtsFlags are the values of the RTS's options hsi uses."] [31 20 "// bytes, 0: the default"] [32 20 "// bytes, 0: the default"] [35 1 "// rtsExit ends the option parsing with a status (stg_exit)."] [38 1 "// rtsParser is procRtsOpts's state: the program's name, the build (threaded), the error stream."] [46 1 "// belch is errorBelch: \"PROG: MESSAGE\\n\"."] [53 1 "// errorUsage: the usage text, each line by errorBelch, then status 1."] [66 1 "// strtod is C's strtod on s: the value and the number of bytes it read (0: none)."] [68 2 "// the longest prefix strconv reads (C's strtod: leading space, a sign, digits, a point, an exponent, inf, nan, hex)"] [84 1 "// decodeSize is the size in an option, FLAG's text from OFFSET: a number and a unit suffix (t g m k w b), within [min, max]."] [133 1 "// parseDouble: strtod's value, an error when nothing or more than spaces follows."] [143 1 "// atof is C's atof."] [146 1 "// strtol is C's strtol(s, NULL, base) for the bases procRtsOpts uses."] [177 1 "// readTraceFlags is read_trace_flags (-l's classes): its only observable effect a message."] [190 1 "// ioManagerAvailable is parseIOManagerFlag's answer: available, unavailable, or unrecognised."] [211 1 "// procRtsOpts reads the options args (the RTS's, in order: -with-rtsopts', then the command line's); a refusal panics"] [212 1 "// with rtsExit after its messages."] [337 13 "// getNumberOfProcessors: hsi has one capability's processor"] [372 4 "// openStatsFile: a file name opens the file; the statistics hsi does not have are not written"] [499 1 "// splitRtsFlags is the RTS's splitting of -with-rtsopts' string into options (at spaces and tabs)."] [502 1 "// run reads the options: false with the status when they end the run."]] :go/pos {:name [1 9] :package [1 1]} :go/semis [[73 17] [73 24] [74 46] [144 48] [179 12] [179 26] [235 93] [236 95] [237 95] [259 28] [271 39] [394 38] [505 20]]} (go/file "rtsflags.go" :imports [


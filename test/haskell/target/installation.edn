             "ld supports single module" "NO" "ld is GNU ld" "YES" "Merge objects command" "ld" "Merge objects flags" "-r"
             "Merge objects supports response files" "YES" "ar command" "ar" "ar flags" "q" "ar supports at file" "YES"
             "ar supports -L" "NO" "ranlib command" "ranlib" "otool command" "" "install_name_tool command" ""

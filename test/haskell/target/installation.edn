 ;; the units' .cabal files in the tarball (a .cabal.in: hadrian's templateRules substitute the project version first) and
 ;; the flags hadrian configures them with (src/Settings/Packages.hs), beside the corpus's :cabal-flags
 :cabal {"ghc-internal" {:flags ["+bignum-gmp"]}
         "rts" {:file "rts/rts.cabal" :flags ["+libm" "+librt" "+libdl" "+use-system-libffi" "-libffi-adjustors" "+tables-next-to-code" "+smp"
                             "+profiling" "+debug" "+dynamic" "+threaded"]}
         "ghc" {:file "compiler/ghc.cabal.in" :flags ["+internal-interpreter" "-dynamic-system-linker" "+build-tool-depends"]}
         "ghc-toolchain" {:file "utils/ghc-toolchain/ghc-toolchain.cabal"}
         "haddock-api" {:file "utils/haddock/haddock-api/haddock-api.cabal" :flags ["+in-ghc-tree"]}
         "haddock-library" {:file "utils/haddock/haddock-library/haddock-library.cabal"}}
 ;; the packages' .buildinfo.in substitutions (Cabal's build-type Configure: configure's AC_SUBSTs). EXTRA_LIBS is empty: musl's
 ;; libc holds the functions configure searches libraries for (AC_SEARCH_LIBS); GMP and terminfo are the system's libraries the
 ;; installation was configured against (gmp, ncurses' tinfo), GMP_INSTALL_INCLUDES configure's choice for a system GMP
 :buildinfo {"ghc-internal" {"EXTRA_LIBS" "" "GMP_LIBS" "gmp" "ICONV_LIB_DIRS" "" "GMP_LIB_DIRS" "" "ICONV_INCLUDE_DIRS" ""
                             "GMP_INCLUDE_DIRS" "" "GMP_FRAMEWORK" "" "GMP_INSTALL_INCLUDES" "HsIntegerGmp.h ghc-gmp.h"}
             "unix" {"EXTRA_LIBS" ""}
             "terminfo" {"TERMINFO_LIB_DIRS" "" "TERMINFO_LIB" "tinfo"}}
 ;; the system GMP's version (gmp.h's __GNU_MP_VERSION...) and features, ghc-internal's configure's HsIntegerGmp.h substitutions
 :gmp {"UseIntreeGmp" "0" "GhcGmpVerMj" "6" "GhcGmpVerMi" "3" "GhcGmpVerPl" "0" "HaveSecurePowm" "1"}
 ;; system-cxx-std-lib's three substitutions (mk/system-cxx-std-lib-1.0.conf.in: configure's FP_FIND_CXX_STD_LIB, the C++
 ;; compiler's library directory)
 :cxx-std-lib {:libs "stdc++" :lib-dirs "/usr/lib/gcc/x86_64-alpine-linux-musl/15.2.0/../../../../lib"
               :dyn-lib-dirs "/usr/lib/gcc/x86_64-alpine-linux-musl/15.2.0/../../../../lib"}

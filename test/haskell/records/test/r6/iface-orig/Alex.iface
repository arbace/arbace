  classify :: GHC.Internal.Types.Char -> Tok
  [HasNoCafRefs, LambdaFormInfo: LFReEntrant 1, Arity: 1,
   Strictness: <1!P(L)>,
   Unfolding: Core: StableSystem <1,TrueFalse>
              \ (c['GHC.Internal.Types.Many] :: GHC.Internal.Types.Char) ->
              case c of wild { GHC.Internal.Types.C# c1 ->
              let {
                $j :: Tok JoinPoint(0) []
                = case c1 of wild1 { DEFAULT -> Other ' '# -> Space }
              } in
              case GHC.Internal.Prim.geChar# c1 '0'# of lwild {
                DEFAULT -> $j
                1#
                -> case GHC.Internal.Prim.leChar# c1 '9'# of lwild1 {
                     DEFAULT -> $j 1# -> Digit } } }]

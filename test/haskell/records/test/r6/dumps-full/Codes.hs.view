{-# LINE 1 "Codes.hsc" #-}
{-# LANGUAGE CPP #-}
-- | An .hsc module (R6): C constants through hsc2hs. Its #{enum} makes more lines than it takes,
-- so that GHC's positions after it repeat lines of the .hsc.
module Codes (Errno (..), eNOENT, eINTR, eAGAIN, eEXIST, eBADF, intSize, describe) where



import Foreign.C.Types (CInt)

newtype Errno = Errno CInt
  deriving (Eq, Show)

eNOENT  :: Errno
eNOENT  = Errno 2
eINTR  :: Errno
eINTR  = Errno 4
eAGAIN  :: Errno
eAGAIN  = Errno 11
eEXIST  :: Errno
eEXIST  = Errno 17
eBADF  :: Errno
eBADF  = Errno 9

{-# LINE 20 "Codes.hsc" #-}
-- | The size of a C int, in bytes.
intSize :: Int
intSize = (4)
{-# LINE 23 "Codes.hsc" #-}

describe :: Errno -> String
describe e

{-# LINE 29 "Codes.hsc" #-}
  | e == eNOENT = "no such file"

{-# LINE 31 "Codes.hsc" #-}
  | otherwise = "an error"

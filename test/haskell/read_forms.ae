;; repr/haskell's spec (doc/haskell/SPEC.md, Appendix A): reads a Haskell forms file with Arbace's
;; reader as a consumer would (a line-numbering reader, nothing evaluated) and prints each
;; top-level form's head and :line, then every symbol in it that the name rule (name_rule.ae)
;; would not write bare, which must be none. Usage: arbace test/haskell/read_forms.ae FILE.ae

(require (quote [arbace.string :as s]))

(defn bare? [t]
  (try
    (let [v (read-string (str "[" t "]"))]
      (and (= 1 (count v))
           (let [x (first v)]
             (or (and (symbol? x) (nil? (namespace x)) (= (name x) t))
                 (and (keyword? x) (nil? (namespace x)) (= (str x) t))))))
    (catch Throwable _ false)))

(defn syms [x]
  (cond (symbol? x) [x]
        (or (seq? x) (vector? x)) (mapcat syms x)
        (map? x) (mapcat syms (concat (keys x) (vals x)))
        :else []))

(let [file (first *command-line-args*)
      rdr (arbace.lang.LineNumberingPushbackReader. (java.io.StringReader. (slurp file)))
      forms (loop [acc []]
              (let [f (read {:eof ::eof} rdr)]
                (if (= f ::eof) acc (recur (conj acc f)))))
      body (remove #(and (seq? %) (= 'ns (first %))) forms)
      odd (->> (mapcat syms body)
               (remove #(or (= "hs" (namespace %)) (= % 'arbace.core/deref)))
               (remove #(bare? (str %)))
               distinct)]
  (doseq [f forms]
    (println (:line (meta f)) (if (seq? f) (first f) f)))
  (println "forms" (count forms) "symbols not bare:" (pr-str (vec odd))))

-- | A Backpack signature (R6): a string type and what a module that fills it offers.
signature Str
  ( Str
  , empty
  , append
  , Container (..)
  ) where

import Data.Kind (Type)

-- | The string type, abstract.
data Str

-- | The empty string.
empty :: Str

-- | Two strings, one after the other.
append :: Str -> Str -> Str
infixr 5 `append`

class Container (f :: Type -> Type) where
  size :: f a -> Int

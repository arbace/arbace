(ns reap.main
  "bin/reap (doc/FULL-SUPPORT-SURVEY.md, REAP1, RPS3, RPS13): the REAP matrix, read, eval, AOT and
  print for Clojure, Java, Go, C, C++, Scheme, OCaml and Python (and the rows test/reap/cells.edn adds), from the checks' recorded results alone (no runs). The cells and
  their sources are data, test/reap/cells.edn; each source's reference gives its passing cases and
  its non-passing ones (read-source), each non-pass falls into a class of its classes file, the
  first whose :match finds \"RESULT REASON\" (test/goi/divergences.edn's format), and the matrix
  prints pass / by design / deferred per cell. A non-pass no class takes, or of a result its cell
  refuses (:refuse; Go's: a fail or an error, whatever the classes, as goi's judge), a class's :kind neither
  :design nor :deferred (nor mapped by the cell's :kind-map), or a reference missing fails the
  verb, and so does a file a source names gone (but the :file of a source with :until, a check
  not recorded yet: a cell none of whose checks is recorded yet prints \"no check yet\"), a stale
  :until, a source of passes with no case, an :include that selects nothing. The
  matrix itself is a record, test/reap/matrix.edn (report 021's finding 1: a judge that passed
  everything raised the matrix, and the classes alone could not tell): each cell's counts and each
  source's passes, non-passes and class counts; any difference from it fails the verb until
  --record writes it, so that every change of a check's record shows as a change of the matrix.
  A source's cases are checked against the tests it must have (:ref, :same-cases).

  -main [--entries]          the matrix, each cell's sources and classes (--entries: every
                             non-pass under its class), the classes awaiting the user's decision,
                             against test/reap/matrix.edn
  -main --record [--entries] the same, test/reap/matrix.edn written from it when nothing else
                             fails (the differences it records printed)
  -main --suite RESULTS      the Clojure suite's results RESULTS (bin/clojure-tests' RUN/results.edn,
                             or its reference) judged per test against the Clojure classes
                             (bin/clojure-tests --divergences)
  -main record-native-check REPORT OUT CORPORA
                             test/repr/go/native-check-results.edn written from bin/repr-go
                             native-check's report (.tmp/repr-go/native-check.report.edn), which
                             must have every corpus of CORPORA (bin/repr-go's native_corpora)"
  (:require [arbace.string :as str]
            [arbace.java.io :as io])
  (:import (java.io File PushbackReader)))

(def ^:dynamic *root* ".")

(defn- path [^String f] (if (str/starts-with? f "/") f (str *root* "/" f)))

(defn- exists? [f] (and f (.isFile (File. ^String (path f)))))

(defn- dir? [f] (and f (.isDirectory (File. ^String (path f)))))

(defn- read-edn [f]
  (with-open [r (PushbackReader. (io/reader (path f)))]
    (read r)))

(defn- selected? [src ^String s]
  (and (or (nil? (:include src)) (re-find (:include src) s))
       (or (nil? (:exclude src)) (not (re-find (:exclude src) s)))))

(defn- entry
  ([id result reason] (entry id result reason 1))
  ([id result reason n] {:id (str id) :result result :reason (str reason) :n n}))

;; the readers: a source's {:pass N (nil: not recorded) :entries [entry...] :detail "..."}

(defmulti read-source :reader)

(defn- suite-results
  "Clojure's suite: one case per test (a skipped namespace counts its upstream tests, at least one),
  against upstream's results (every assertion passes there); test.generative's specs with
  :generative. Upstream's tests (and specs) a namespace that ran does not have, neither run nor
  skipped, are an entry :missing (a deftest lost in translation), and with :compiled (the AOT
  level) each source the results' :not-compiled or :evaluated name (loaded from source, its tests
  not compiled) an entry :not-compiled (report 021's finding 7)."
  [src res up]
  (let [nss (filter #(selected? src (str %)) (keys (:namespaces up)))
        skipped (:skipped res)
        skipped-tests (:skipped-tests res)
        ran (:namespaces res)
        per (for [ns nss
                  :let [u (get-in up [:namespaces ns]) r (get ran ns)]]
              (cond
                (contains? skipped ns)
                {:entries [(entry ns :skip (str ns ": " (get skipped ns)) (max 1 (:test u)))]}
                (nil? r)
                {:entries [(entry ns :missing (str ns ": not run, not skipped") (max 1 (:test u)))]}
                (:load-error r)
                {:entries [(entry ns :error (str ns ": failed to load: " (:load-error r)) (max 1 (:test u)))]}
                :else
                (let [failing (:failing r)
                      st (get skipped-tests ns)]
                  {:pass (- (:test r) (count failing))
                   :assertions (:pass r)
                   :entries (concat
                             (let [lost (- (:test u) (:test r) (count st))]
                               (when (pos? lost)
                                 [(entry ns :missing (str ns ": " lost " of upstream's " (:test u) " tests neither run nor skipped") lost)]))
                             (for [[t why] (sort-by (comp str key) st)]
                               (entry (str ns "/" t) :skip (str ns "/" t ": " why)))
                             (for [[t {:keys [fail error]}] (sort-by (comp str key) failing)]
                               (entry (str ns "/" (name t)) (if (pos? fail) :fail :error)
                                      (str ns "/" (name t) " (fail " fail ", error " error ")"))))})))
        gen (when (:generative src) (:generative res))
        gen-lost (when (and gen (:generative up)) (- (:tests (:generative up)) (:tests gen)))
        gen-entries (concat (for [s (sort (map str (:failing gen)))] (entry s :fail (str "spec " s)))
                            (for [n (sort (map str (:load-errors gen)))] (entry n :error (str "load " n)))
                            (when (and gen-lost (pos? gen-lost))
                              [(entry "test.generative" :missing (str "test.generative: " gen-lost " of upstream's "
                                                                      (:tests (:generative up)) " specs not run") gen-lost)]))
        not-compiled (when (:compiled src)
                       (for [[f why] (sort-by (comp str key) (merge (:not-compiled res) (:evaluated res)))]
                         (entry f :not-compiled (str f ": loaded from source: " why))))]
    {:pass (+ (reduce + (keep :pass per)) (if gen (- (:tests gen) (count (:failing gen))) 0))
     :selected (count nss)
     :entries (vec (concat (mapcat :entries per) gen-entries not-compiled))
     :detail (str (count nss) " namespaces, " (format "%,d" (long (reduce + (keep :assertions per)))) " assertions passing"
                  (when gen (str ", test.generative " (- (:tests gen) (count (:failing gen))) " of " (:tests gen) " specs")))}))

(defmethod read-source :clojure-suite [src]
  (suite-results src (read-edn (:file src)) (read-edn (:upstream src))))

(defn- known-cases
  "The cases of a known file in the oracle's shape ({:mismatches [{:reason :cases [{:case}]}]}),
  selected by their :case."
  [src f]
  (for [g (:mismatches (read-edn f)) c (:cases g) :when (selected? src (:case c))]
    (entry (:case c) :known (:reason g))))

(defn- expected-files
  "The oracle's expected files under DIR, relative (\"forms/reader.edn\"), with their :count."
  [dir]
  (let [d (File. ^String (path dir))
        base (inc (count (.getPath d)))]
    (for [^File f (file-seq d) :when (and (.isFile f) (str/ends-with? (.getName f) ".edn"))]
      (let [head (with-open [r (io/reader f)] (let [cs (char-array 400) n (.read r cs)] (String. cs 0 (max n 0))))]
        [(subs (.getPath f) base) (Long/parseLong (second (re-find #":count (\d+)" head)))]))))

(defn- case-file
  "An oracle case's expected file: test/oracle/forms/text.ae:67 -> forms/text.edn."
  [c]
  (str/replace (str/replace c #"^test/oracle/" "") #"\.ae:\d+$" ".edn"))

(defmethod read-source :oracle [src]
  (let [files (filter #(selected? src (first %)) (expected-files (:expected src)))
        sel (set (map first files))
        es (for [g (:mismatches (read-edn (:file src))) c (:cases g) :when (sel (case-file (:case c)))]
             (entry (:case c) :known (:reason g)))]
    {:pass (- (reduce + (map second files)) (count es)) :entries (vec es) :selected (count files)
     :detail (str (count files) " files")}))

(defmethod read-source :known-mismatches [src]
  {:pass nil :entries (vec (known-cases src (:file src)))
   :detail "the known file only: its passing cases are not recorded"})

(defmethod read-source :repr-clojure-rules [src]
  (require 'arbace.repr.clojure.rules)
  (let [rules @(resolve 'arbace.repr.clojure.rules/rules)
        one-way (filter #(= :one-way (:way %)) rules)]
    {:pass (- (count rules) (count one-way))
     :entries (vec (for [r one-way]
                     (entry (:id r) :one-way (str (:id r) ": " (str/replace (str/trim (:loss r)) #"\s+" " ")))))
     :detail "arbace.repr.clojure.rules"}))

(defmethod read-source :repr-clojure-known [src]
  {:pass nil
   :entries (vec (for [[corpus files] (dissoc (read-edn (:file src)) :counts) [f why] files]
                   ;; a corpus keyed [CHECK CORPUS] (bin/pyi scope-check's and compile-check's known files) named CHECK/CORPUS
                   (entry (str (if (vector? corpus) (str/join "/" (map name corpus)) (name corpus)) " " f) :known (str (name corpus) ": " why))))
   :detail "the known file only: its corpora's passing files are not recorded"})

(defmethod read-source :native-check [src]
  (let [r (read-edn (:file src))
        cs (:corpora r)]
    {:pass (reduce + (map :equal cs))
     :entries (vec (concat
                    (for [c cs [k why] (:raw-only c)] (entry (str (:corpus c) " " k) :raw-only (str (:corpus c) ": " why)))
                    (for [c cs [k why] (:extra c)] (entry (str (:corpus c) " " k) :extra (str (:corpus c) ": the helper's failure: " why)))
                    (for [c cs :when (pos? (:rejected c))]
                      (entry (:corpus c) :rejected (str (:corpus c) ": " (:rejected c) " files go/parser rejects") (:rejected c)))
                    ;; what is neither equal nor raw-only, a dump that differs, and the report's
                    ;; unknown ones: no class takes them (report 021's finding 6: they vanished as a
                    ;; smaller :equal)
                    (for [c cs :let [d (- (:dumps c) (:equal c) (count (:raw-only c)))] :when (pos? d)]
                      (entry (:corpus c) :differ (str (:corpus c) ": " d " dumps neither equal nor raw-only") d))
                    (for [c cs :when (pos? (or (:unknown c) 0))]
                      (entry (:corpus c) :unknown (str (:corpus c) ": " (:unknown c) " unknown") (:unknown c)))))
     :detail (str (count cs) " corpora, " (format "%,d" (long (reduce + (map :dumps cs)))) " dumps (" (:recorded r) ")")}))

(defmethod read-source :native-known [src]
  {:pass nil :entries (vec (for [[k why] (read-edn (:file src))] (entry k :known (str k ": " why))))
   :detail "the known file only"})

(defmethod read-source :results [src]
  (let [rows (read-edn (:file src))]
    {:pass (count (filter #(= :pass (second %)) rows)) :ids (mapv first rows)
     :entries (vec (for [[id r why] rows :when (not= :pass r)] (entry id r why)))}))

(defn- c-results-problems
  "A C check's results file (CS240 (a): rows [ID RESULT REASON], ID \"CORPUS FILE\", arbace.repr.c.results) against its
  known file's entries: a row neither :pass nor :known (the record held a failure), a known entry the results pass, and a
  known entry the results lack (the two files from different runs, or the results of a run over fewer corpora than the
  known file's: queue 132, the corpora absent from the results were not checked, an empty results file passed all)."
  [src rows entries]
  (let [by (into {} (map (fn [[id r]] [id r]) rows))
        some-of (fn [xs] (str (str/join "; " (take 3 xs)) (when (> (count xs) 3) (str " ... (" (count xs) ")"))))
        bad (for [[id r why] rows :when (not (#{:pass :known} r))] (str id " " (name r) " " why))
        passed (distinct (for [e entries :when (= :pass (by (:id e)))] (:id e)))
        lacking (distinct (for [e entries :let [id (:id e)] :when (nil? (by id))] id))]
    (concat
     (when (seq bad) [(str (:name src) ": " (count bad) " rows of " (:results src) " neither pass nor known: " (some-of bad))])
     (when (seq passed) [(str (:name src) ": " (count passed) " files of " (:file src) " pass in " (:results src) ": " (some-of passed))])
     (when (seq lacking) [(str (:name src) ": " (count lacking) " files of " (:file src) " absent from " (:results src) ": " (some-of lacking))]))))

(defmethod read-source :c-known [src]
  ;; C's known files (test/repr/c/*-known.edn: bin/ci annotations, bin/repr-c parse-check, check --tokens, roundtrip): the files
  ;; that do not pass, SECTION -> corpus -> file -> {:class K}, the class texts in :classes (flat, or by section as check --tokens'),
  ;; each file a case "corpus file" of the result :known and the reason "K: the class text". :sections: the known file's sections
  ;; taken (default the one :section); a section the file does not have is a problem (:sections-missing; queue 122: a misspelled
  ;; one gave no entries, its cell nothing to judge), the files' writers write each of theirs, empty or not. The passes: the
  ;; check's results file :results (CS240 (a), written by its --record at C9's full run: every file's row [ID RESULT REASON])
  ;; when it is there, its :pass rows counted and held to the known file (c-results-problems); until then not recorded (the
  ;; cell's count is partial).
  ;; :exclude-corpora (queue 132 F3, the user's decision of 2026-11-02): corpora whose rows and entries are not counted (the
  ;; tree check's mutants, synthetic files for error recovery, not conformance tests); the results are held to the known file
  ;; (c-results-problems) over every corpus. :rows, the counted rows' results by id, for a cell's :count-once group (judge-cell).
  (let [m (read-edn (:file src))
        secs (or (:sections src) [(:section src)])
        cls (:classes m)
        ;; :id-sep (C++'s token check, CX10): the separator of a case's corpus and file, "corpus/file" as C++'s records and
        ;; the rotation's lists (GT8.4) name them; default " " (C's)
        sep (or (:id-sep src) " ")
        all (vec (for [sec secs
                       :let [texts (if (contains? cls sec) (get cls sec) cls)]
                       [corpus files] (get m sec)
                       [f v] (sort-by key files)]
                   (entry (str (name corpus) sep f) :known
                          (str (name (:class v)) ": " (str/replace (str (get texts (:class v))) #"\s+" " ")))))
        ex (set (:exclude-corpora src))
        counted? (fn [^String id] (not (ex (first (str/split id (re-pattern (java.util.regex.Pattern/quote sep)) 2)))))
        es (filterv #(counted? (:id %)) all)
        rows (when (exists? (:results src)) (read-edn (:results src)))
        crows (filter #(counted? (first %)) rows)
        missing (vec (remove #(contains? m %) secs))
        excluded (when (seq ex) (str "; not counted: the corpora " (str/join ", " (sort ex))))]
    (if rows
      {:pass (count (filter #(= :pass (second %)) crows)) :entries es :sections-missing missing
       :rows (into {} (map (fn [[id r]] [id r]) crows))
       :results-problems (vec (c-results-problems src rows all))
       :detail (str (count rows) " files in " (:results src) excluded)}
      {:pass nil :entries es :sections-missing missing
       :detail (str "the known file only: the check's passing files are not recorded there"
                    (when (:results src) (str " (" (:results src) " not written yet)")) excluded)})))

;; C++'s round trip (CX10; doc/cpp/CPP-SURVEY.md, "As built: CX10 (write-ahead)"): bin/repr-cpp roundtrip's recorded results,
;; one file a list, :results-dir/KEY.edn (CP124 (b): {:key :summary :files {CORPUS/NAME verdict}}, the verdict :pass,
;; the essential lists' KEY-essential.edn (subsets of the others, the gate's) not counted,
;; [:known CLASS] (a bare :known the old format), :oracle-rejects or :oracle-fails), and the known file (:file,
;; test/repr/cpp/roundtrip-known.edn: :classes, :files CORPUS/NAME -> CLASS). Two parts of one check:
;;   :part :recorded  the recorded lists' files, each a case: the passes counted, a known one "CLASS: the class text" (the record's
;;                    class; the known file's when the record has none), the oracle's verdicts "oracle-rejects: ..." and
;;                    "oracle-fails: ...". A problem: a record whose :summary :files is not its count of files, a file in two
;;                    records, a recorded class the known file gives another class (CP172 (b)'s check, which the run makes, read
;;                    here from the records); a recorded known file the known file no longer lists is counted as recorded (an
;;                    improvement until the list's next --record-results, CP164 (c)) and said in the detail
;;   :part :unrecorded the known file's files no record holds (the corpora pending.edn names, HotSpot's, the samples': lists
;;                    without a record), each a non-pass; their passes are not recorded (the cell's count partial)

(defn- cpp-records [src]
  (let [d (File. ^String (path (:results-dir src)))]
    (vec (for [^File f (sort-by #(.getName ^File %) (or (seq (.listFiles d)) []))
               :let [n (.getName f)]
               ;; the essential lists' records (gxx-dg-essential.edn: a subset of a recorded list, the gate's) are not counted again
               :when (and (str/ends-with? n ".edn") (not= n "pending.edn") (not (str/ends-with? n "-essential.edn")))]
           (assoc (read-edn (str (:results-dir src) "/" n)) :file n)))))

(defmethod read-source :cpp-roundtrip [src]
  (let [known (read-edn (:file src))
        texts (:classes known)
        kfiles (:files known)
        text (fn [c] (str (name c) ": " (str/replace (str (get texts c)) #"\s+" " ")))
        recs (cpp-records src)
        recorded (frequencies (mapcat #(keys (:files %)) recs))]
    (if (= :unrecorded (:part src))
      (let [es (vec (for [[f c] (sort-by key kfiles) :when (not (contains? recorded f))]
                      (entry f :known (text c))))]
        {:pass nil :entries es
         :detail (str (count es) " of the known file's " (count kfiles) " files in no record of " (:results-dir src)
                      "; their lists' passes are not recorded")})
      (let [rv (fn [x] (if (vector? x) (first x) x))
            rc (fn [x] (when (vector? x) (second x)))
            rows (for [r recs [f v] (:files r)] [f v (:file r)])
            es (vec (for [[f v] (sort-by first rows) :when (not= :pass (rv v))]
                      (case (rv v)
                        :known (entry f :known (text (or (rc v) (get kfiles f) :unclassified)))
                        :oracle-rejects (entry f :oracle-rejects "oracle-rejects: clang rejects the file with its own diagnostics (recorded by name, roundtrip-oracle.edn)")
                        :oracle-fails (entry f :oracle-fails "oracle-fails: the oracle's dump failed (a timeout or a crash, recorded by name, roundtrip-oracle.edn)")
                        (entry f (rv v) (str (name (rv v)) ": a verdict the round trip does not record")))))
            stale (for [[f v] rows :when (and (= :known (rv v)) (not (contains? kfiles f)))] f)]
        {:pass (count (filter #(= :pass (rv (second %))) rows)) :entries es
         :results-problems
         (vec (concat
               (for [r recs :let [n (get-in r [:summary :files])] :when (and n (not= n (count (:files r))))]
                 (str (:name src) ": " (:file r) " records " (count (:files r)) " files, its summary " n))
               (for [[f k] recorded :when (> k 1)] (str (:name src) ": " f " in " k " records"))
               (for [[f v] rows :let [c (rc v) kc (get kfiles f)] :when (and c kc (not= c kc))]
                 (str (:name src) ": " f " recorded as " (name c) " in " (nth (vec (first (filter #(= f (first %)) rows))) 2)
                      ", the known file's class is " (name kc)))))
         :detail (str (count recs) " recorded lists (" (str/join ", " (map #(str/replace (:file %) #"\.edn$" "") recs)) ")"
                      (when (seq stale) (str "; " (count stale) " recorded known the known file no longer lists (improvements until"
                                             " --record-results): " (str/join " " (take 3 stale)))))}))))

;; C++'s lowering check (CX6, CX7; bin/cppi lower-check, the lowered C forms compiled by gcc -O0 and run, the second judge before
;; ci): test/cpp/lower-results.edn's :files (NAME -> [STATUS OUTCOME]; :cx6, CX6's summaries, not read) and the known file
;; (:known, test/cpp/lower-known.edn: NAME -> its class), each file a case, a non-pass "CLASS: OUTCOME"

(defmethod read-source :cpp-lower [src]
  (let [r (read-edn (:file src))
        known (if (:known src) (read-edn (:known src)) {})
        fs (:files r)]
    {:pass (count (filter #(= :pass (first (val %))) fs)) :ids (vec (keys fs))
     :entries (vec (for [[f [st out]] (sort-by key fs) :when (not= :pass st)]
                     (entry f st (str (name (or (get known f) :unclassified)) ": " (name (or out :none))))))
     :detail (str (count fs) " files of " (str/join ", " (map name (keys (dissoc r :files :prefixes :cx6)))))}))

(defmethod read-source :jforms-excluded [src]
  ;; diffcheck's exclusions (test/diffcheck/jforms-excluded.edn: the Java forms' classes not given
  ;; to j2g, RPS27 (a)): each class a non-pass, "excluded REASON"
  {:pass nil
   :entries (vec (for [x (:excluded (read-edn (:file src)))
                       c (or (:classes x) [(:class x)])]
                   (entry c :excluded (:reason x))))
   :detail "the excluded file only: diffcheck's translated classes are counted by its pair"})

(defmethod read-source :java-check [src]
  (let [rows (read-edn (:file src))]
    {:pass (count (filter #(= :pass (nth % 2)) rows)) :ids (mapv first rows)
     :entries (vec (for [[id _ r why] rows :when (not= :pass r)] (assoc (entry id r why) :level (:level src))))}))

(defmethod read-source :roundtrip [src]
  (let [r (read-edn (:file src))
        known (into {} (for [[kind p lvls why] (when (:known src) (:known (read-edn (:known src))))]
                         [[kind p] [(set lvls) why]]))
        rows (:results r)
        np (for [[kind p st first-line] rows
                 :let [bad (filter #(not= :pass (get st %)) (:levels r))]
                 :when (seq bad)]
             (let [lv (str/join "," (map name bad))
                   [klv why] (known [kind p])]
               (cond
                 (and klv (every? klv bad)) (entry (str (name kind) " " p) :known (str lv ": " why))
                 (some #(#{:fail :error :differ} (get st %)) bad) (entry (str (name kind) " " p) :fail (str lv ": " first-line))
                 (every? #(= :skip (get st %)) bad) (entry (str (name kind) " " p) :skip (str lv ": " first-line))
                 ;; a status the round trip does not write (or a level missing) is no skip, which
                 ;; the classes take by shape (report 021's finding 5): no class takes it
                 :else (entry (str (name kind) " " p) :unknown
                              (str lv ": the status " (str/join "," (map #(pr-str (get st %)) bad)) ": " first-line)))))]
    {:pass (- (count rows) (count np)) :entries (vec np)
     :detail (str (str/join ", " (map name (:levels r))) " levels; " (pr-str (:config r)))}))

(defmethod read-source :text-known [src]
  {:pass nil :entries (vec (for [[p why] (sort-by key (read-edn (:file src)))] (entry p :known (str "text: " why))))
   :detail "the known file only: the level's passing files are not recorded"})

(defn- scheme-entries
  "A Scheme record's non-pass items (test/scheme/check*-linux-amd64.edn: {:id :verdict :items [{:item \"KIND ID DETAIL\" :class K}]}):
  each an entry of the record's id, its result KIND and its reason the rest of the item, so that a class's :match finds the item
  whole (\"RESULT REASON\"), the class the check recorded kept to be compared (:recorded-class); a non-pass with no item an entry
  :non-pass no class takes."
  [r]
  (if (seq (:items r))
    (for [{:keys [item class]} (:items r)
          :let [[k why] (str/split (str item) #" " 2)]]
      (assoc (entry (:id r) (keyword k) (or why "")) :recorded-class class))
    [(entry (:id r) :non-pass (str (:id r) ": verdict " (pr-str (:verdict r)) " with no item"))]))

(defmethod read-source :scheme [src]
  ;; SM9 (doc/scheme/SCHEME-SURVEY.md, \"As built: SM9 (write-ahead)\"): Scheme's records, one map a program, suite or file. :count
  ;; :verdict (the default): a record is a case, passing when its :verdict is :pass (the :id the case's, its items its non-passes:
  ;; with :per-file one non-pass of its worst kind); :count :tests: a record counts its tests, :pass (or the path :pass-path) the
  ;; passing ones, each item a non-passing one (Chibi's suite, the SRFIs' programs, Chibi's own tests, the mats).
  (let [rows (read-edn (:file src))
        tests? (= :tests (:count src))]
    {:pass (if tests?
             (reduce + (map #(or (get-in % (or (:pass-path src) [:pass])) 0) rows))
             (count (filter #(= :pass (:verdict %)) rows)))
     :ids (when-not tests? (mapv :id rows))
     :entries (vec (mapcat (fn [r] (when (or (not= :pass (:verdict r)) (seq (:items r))) (scheme-entries r))) rows))
     :detail (str (count rows) (if tests? " records" " cases") " in " (:file src))}))
;; ---- OCaml's row (O8, doc/ocaml/OCAML-SURVEY.md, "As built: O8 (write-ahead)"): its records' rows are [ID RESULT REASON ...]
;; with RESULT a string ("pass", "fail", "class", ...: test/ocaml/check-oi.edn, check-aot.edn, check-suite-*.edn,
;; read-results.edn, print-results.edn), read as :results' rows with the result a keyword; columns past the third
;; (the AOT level's OI) are not the level's
(defmethod read-source :ocaml [src]
  (let [rows (for [[id r why] (read-edn (:file src))] [id (keyword (str r)) why])]
    {:pass (count (filter #(= :pass (second %)) rows)) :ids (mapv first rows)
     :entries (vec (for [[id r why] rows :when (not= :pass r)] (entry id r why)))
     :detail (str (count rows) " rows in " (:file src))}))

;; the cases a source must have (report 021's finding 1: a shrunk record is a valid record)

(def ^:private ref-ids
  (memoize
   (fn [f diagnostics?]
     ;; java.check/report's expected: the tests the JDK passes, the golden-diagnostics tests at the
     ;; level diagnostics, the others at the other levels
     (set (for [t (read-edn f) :when (= :pass (:jdk t))
                :when (= diagnostics? (= :compile-fail-ref (:category t)))]
            (:id t))))))

(defn- read-forms
  "Every form of F (a file of one map a line, as test/c/ref-gcc15.edn), where read-edn reads the first."
  [f]
  (with-open [r (PushbackReader. (io/reader (path f)))]
    (loop [xs []]
      (let [x (read r false ::eof)]
        (if (= ::eof x) xs (recur (conj xs x)))))))

(def ^:private ref-run-ids
  (memoize
   (fn [f]
     ;; C's reference runs (bin/ci record-ref): the programs gcc built, whose runs the check judges (queue 122, finding 6)
     (set (for [x (read-forms f) :when (not= :no-build (:status x))] (:id x))))))

(def ^:private py-ref-ids
  (memoize
   (fn [files]
     ;; Python's references (bin/pyi record-ref: one map a line): the synthetic corpus's and the samples' programs
     ;; (test/python/ref-cpython314.edn, every :id: an excluded reference is a case the judge classes), Lib/test's methods
     ;; (ref-cpython314-lib-test*.edn: the :outcome lines, the :module and :excluded ones not cases)
     (set (for [f files x (read-forms f)
                :when (and (:id x) (not (:module x)) (or (contains? x :status) (and (:outcome x) (not (:excluded x)))))]
            (:id x))))))

;; Python's row (queue 201, PY10; doc/python/PYTHON-SURVEY.md §10.1, "As built: PY10"): bin/pyi check --aot's record
;; (test/python/check-aot-linux-ARCH.edn, arbace.python.aot's judge: one map a line, :id, :result :pass, :classed (:class
;; :as-pyi, :reference-excluded or a class of test/python/divergences-aot.edn) or :failed, :reason, :pyi-ms, :pyi-differs)
;; read for two levels:
;;   :column :aot  the compiled run (the AOT level): a pass the record's :pass; a non-pass of the result CLASS, the
;;                 record's class (:as-pyi, the interpreter's own divergence, the compiled run the loop's and pyi's;
;;                 :reference-excluded; a class of divergences-aot.edn), its reason the record's; a :failed row the
;;                 result :failed, "CLASS REASON" (CLASS :differs, :refused, :no-reference: the judge's failures)
;;   :column :pyi  pyi's run on goi (the eval level's synthetic corpus and samples): a pass a :pass without :pyi-differs; a
;;                 non-pass :as-pyi (pyi's run the compiled one's, not CPython's), :pyi-differs (the
;;                 compiled run CPython's, pyi's not: pyi's outcome when the record keeps it, :pyi-outcome), :differs (pyi's outcome in
;;                 the reason). A record made with --no-pyi (no :pyi-ms anywhere) is a problem at this column: it holds
;;                 no run of pyi's.
;;   :column :loop pyi's compiled loop (the eval level's synthetic source in every tier: PY10's DECISION 2, decided: the user,
;;                 2026-11-04, (a)): read as :aot (a :pass's loop run is the compiled run's, so CPython's; a non-pass the
;;                 record's class), named as the loop's; pyi on goi's runs judged beside it (:column :pyi, :role :beside).
(defmethod read-source :pyi-aot [src]
  (let [rows (read-forms (:file src))
        col (or (:column src) :aot)
        es (vec (for [r rows
                      :let [id (:id r) res (:result r) cls (:class r) why (str (:reason r))]
                      :when (not (and (= :pass res) (or (#{:aot :loop} col) (not (:pyi-differs r)))))]
                  (cond
                    (= :pass res) (entry id :pyi-differs
                                         (str "the compiled run is CPython's, pyi's on goi is not"
                                              (when-let [o (:pyi-outcome r)]
                                                (str ": status " (:status o) ", " (:stderr-last o)))))
                    (= :failed res) (entry id :failed (str (name (or cls :failed)) " " why))
                    :else (entry id (or cls :classed) why))))
        no-pyi (and (= :pyi col) (seq rows) (not-any? :pyi-ms rows))]
    {:pass (count (filter #(and (= :pass (:result %)) (or (#{:aot :loop} col) (not (:pyi-differs %)))) rows))
     :ids (mapv :id rows) :entries es
     :results-problems (when no-pyi [(str (:name src) ": " (:file src) " was recorded with --no-pyi: no run of pyi's to judge")])
     :detail (str (count rows) " programs in " (:file src) (case col :pyi ", pyi's runs" :loop ", the loop's runs" nil))}))

(defn- case-problems
  "A source's cases (its rows' ids) against those it must have: a :java-check source's against
  :ref's tests of its :level (test/java/ref-jdk26.edn), a :results source's against the programs
  of :same-cases (goi's AOT level against its eval level's) or of :ref-runs (C's eval level against
  the programs gcc built in test/c/ref-gcc15.edn, every form of it); an id recorded twice is a problem too."
  [src r]
  (when-let [ids (:ids r)]
    (let [want (cond (:ref src) (ref-ids (:ref src) (= :diagnostics (:level src)))
                     ;; Python's (:py-ref, a file or several): the programs every one; Lib/test's methods those of the
                     ;; modules the record holds (:py-ref-modules: the record is per corpus, a module's methods all or none)
                     (:py-ref src) (let [all (py-ref-ids (let [x (:py-ref src)] (if (vector? x) x [x])))]
                                     (if (:py-ref-modules src)
                                       (let [mods (set (map #(first (str/split (str %) #"/" 2)) ids))]
                                         (set (filter #(mods (first (str/split % #"/" 2))) all)))
                                       all))
                     (:same-cases src) (set (map #(if (map? %) (:id %) (first %)) (read-edn (:same-cases src))))
                     (:ref-runs src) (ref-run-ids (:ref-runs src)))
          have (set ids)
          some-of (fn [xs] (str (str/join " " (take 5 xs)) (when (> (count xs) 5) " ...")))]
      (concat
       (for [[id k] (sort-by key (frequencies ids)) :when (> k 1)]
         (str (:name src) ": " id " recorded " k " times in " (:file src)))
       (when want
         (let [miss (sort (remove have want))
               extra (sort (remove want have))]
           (concat
            (when (seq miss)
              [(str (:name src) ": " (count miss) " cases of " (or (:ref src) (:py-ref src) (:same-cases src) (:ref-runs src))
                    " not in " (:file src) ": " (some-of miss))])
            (when (seq extra)
              [(str (:name src) ": " (count extra) " cases of " (:file src) " not in "
                    (or (:ref src) (:py-ref src) (:same-cases src) (:ref-runs src)) ": " (some-of extra))]))))))))

;; the classes

(defn- py-aot-class
  "A class of test/python/divergences-aot.edn (arbace.python.aot's judge: {:classes [...]}, a class's :ids its programs,
  its :match one regex's text) in this file's terms: :ids as :tests, :match a vector of patterns."
  [c]
  (cond-> (dissoc c :ids)
    (:ids c) (update :tests #(vec (concat % (:ids c))))
    (string? (:match c)) (assoc :match [(re-pattern (:match c))])))

(defn- classes-of [f]
  (cond (vector? f) (vec (mapcat classes-of f))
        (exists? f) (let [x (read-edn f)]
                      ;; a map {:classes [...]}: pyi's AOT's classes file (queue 201, PY10)
                      (if (map? x) (mapv py-aot-class (:classes x)) x))
        :else []))

(defn- at-level?
  "Whether the class C applies at the entry's LEVEL (java-check's sources; none: every class), as
  java.check's at-level? (test/java/check.ae): its :level, else one of its :levels, else any."
  [c level]
  (cond (nil? level) true
        (:level c) (= level (:level c))
        (:levels c) (boolean (some #{level} (:levels c)))
        :else true))

(defn- classify
  "An entry's class: the first that applies at its level (at-level?) and names it in :tests or one
  of whose :match regexps finds \"RESULT REASON\" (and, when it lists :programs, names it: goi's
  classify, test/goi/divergences.ae, report 002's finding 7); nil when none does. A flaky result
  only by a class that names it, in :tests or by a :match anchored to it (^flaky), as java.check's
  classify (report 003's findings 4, 5 and 7: :levels and the flaky rule; report 012 had left this
  copy reading :level alone, so a class of the run levels took the other levels' rows)."
  [classes e]
  (let [s (str (name (:result e)) " " (:reason e))
        takes? (fn [re] (or (not= :flaky (:result e)) (str/starts-with? (str re) "^flaky")))]
    (some (fn [c] (when (and (at-level? c (:level e))
                             (or (nil? (:results c)) (some #{(:result e)} (:results c)))
                             (or (some #{(:id e)} (:tests c)) (some #(and (takes? %) (re-find % s)) (:match c)))
                             (or (nil? (:programs c)) (some #{(:id e)} (:programs c))))
                    c))
          classes)))

(defn- kind-of [cell c]
  (let [k (:kind c)]
    (if (#{:design :deferred} k) k (get (:kind-map cell) k))))

(defn- per-file
  "Entries of one id merged into one: an entry in no class kept as it is (a problem), else the first deferred one, else the first;
  its reason names the other levels' classes."
  [es]
  (let [groups (group-by :id es)]
    (vec (for [id (distinct (map :id es))
               :let [g (get groups id)
                     classed (filter :class g)
                     pick (or (first (filter #(= :deferred (:kind %)) classed)) (first classed))]
               e (if (or (nil? pick) (some #(nil? (:class %)) g))
                   g
                   [(cond-> pick
                      (> (count g) 1) (update :reason str " (also: "
                                              (str/join ", " (distinct (for [x g :when (not= x pick)] (name (:id (:class x)))))) ")"))])]
           e))))

(defn- missing-files
  "The files a source names that are not there: its :file, :upstream, :known, :ref and :same-cases,
  the oracle's :expected directory, C++'s round trip's :results-dir (report 021's finding 3: a directory gone gave no cases)."
  [src]
  (concat (for [k [:file :upstream :known :ref :same-cases :ref-runs] :let [f (get src k)] :when (and f (not (exists? f)))] f)
          (for [f (let [x (:py-ref src)] (if (vector? x) x (when x [x]))) :when (not (exists? f))] f)
          (when-let [d (:expected src)] (when-not (dir? d) [d]))
          (when-let [d (:results-dir src)] (when-not (dir? d) [d]))))

(defn- judge-source
  "A source read and judged: its entries with their classes. Every file it names must be there,
  but the :file of a source with :until (a check not recorded yet: then its cell prints \"no check
  yet\"), and an :until whose :file is there is stale, a problem (report 021's finding 3: the stale
  :until keys made a record deleted a cell with no check, or a source gone from its cell's sums);
  a source of passes with no case at all, or whose :include selects nothing, is a problem too."
  [cell src]
  (let [file (or (:file src) "")
        miss (missing-files src)
        ;; a check not recorded yet: its :file missing (with it, the files the same milestone writes: :ref-runs,
        ;; :same-cases; CX10, C++'s eval and AOT cells wait for CX8's record and its references alike)
        not-yet (and (:until src) (some #{(:file src)} miss))
        present (and (empty? miss) (or (= :repr-clojure-rules (:reader src)) (exists? (:file src))))
        cf (or (:classes src) (:classes cell))]
    (if-not present
      (assoc src :present false
                 :problems (when-not not-yet (vec (for [f miss] (str (:name src) ": no " f)))))
      (let [r (read-source src)
            classes (classes-of cf)
            es (for [e (:entries r)] (let [c (classify classes e)] (assoc e :class c :kind (when c (kind-of cell c)))))
            ;; :per-file (the token check's three sections, queue 122 finding 4): a file the known file lists at several levels
            ;; is one non-pass, of its deferred class when any is (the worst kind), else of its first; an entry in no class stays
            es (if (:per-file src) (per-file es) es)]
        (merge src r
               {:present true :classes-file cf :entries (vec es)
                :problems (vec (concat
                                (when (:until src)
                                  [(str (:name src) ": " file " is recorded: its :until " (:until src) " is stale")])
                                (when (and (:pass r) (zero? (+ (:pass r) (reduce + (map :n (:entries r))))))
                                  [(str (:name src) ": no case in " (or (:file src) (:expected src)))])
                                (when (and (:include src) (= 0 (:selected r)))
                                  [(str (:name src) ": its :include " (:include src) " selects nothing")])
                                (for [sec (:sections-missing r)]
                                  (str (:name src) ": " file " has no section " sec))
                                (case-problems src r)
                                (:results-problems r)
                                ;; a result the cell's check refuses whatever the classes (report 021's
                                ;; finding 4: goi's judge, test/goi/divergences.ae, fails on any fail or
                                ;; error; a class whose pattern found one took it as by design here)
                                (for [e es :when (some #{(:result e)} (:refuse cell))]
                                  (str (:name src) ": " (:id e) " " (name (:result e)) " " (:reason e)
                                       ": the cell's check refuses the result " (name (:result e)) " whatever its class"))
;; a Scheme record's item (:scheme): the class its check recorded is the one the matrix finds (SM9)
                                (for [e es :when (and (:recorded-class e) (:class e) (not= (:recorded-class e) (:id (:class e))))]
                                  (str (:name src) ": " (:id e) " " (name (:result e)) " " (:reason e) ": recorded in the class "
                                       (name (:recorded-class e)) ", the matrix finds " (name (:id (:class e)))))
                                (for [e es :when (nil? (:class e))]
                                  (str (:name src) ": " (:id e) " in no class of " cf ": " (name (:result e)) " " (:reason e)))
                                (for [c (distinct (keep :class es)) :when (nil? (kind-of cell c))]
                                  (str cf ": class " (:id c) "'s kind " (:kind c) " is neither :design nor :deferred"))))})))))

(defn- sum [k es] (reduce + (map :n (filter #(= k (:kind %)) es))))

(defn- count-once
  "A cell's :count-once group (queue 132 F3, the user's decision of 2026-11-02: C's token and tree checks run the same corpus
  files): each file one case, a non-pass of its worst kind (per-file) when a check of the group does not pass it, a pass when
  every check of the group whose results hold it passes it; the passes nil (partial) unless every check's results are there."
  [g]
  {:entries (per-file (mapcat :entries g))
   :pass (when (every? :rows g)
           (let [rows (map :rows g)]
             (count (for [id (distinct (mapcat keys rows))
                          :when (every? #(contains? #{nil :pass} (get % id)) rows)]
                      id))))})

(defn- judge-cell [cell]
  (let [ss (mapv #(judge-source cell %) (:sources cell))
        checks (filter #(and (not= :beside (:role %)) (:present %)) ss)
        units (concat (remove :count-once checks)
                      (map count-once (vals (group-by :count-once (filter :count-once checks)))))
        es (mapcat :entries units)]
    (assoc cell :sources ss
                :checked (boolean (seq checks))
                :until (some :until (remove :present (:sources cell)))
                :pass (reduce + (keep :pass units))
                :pass-partial (boolean (some #(and (nil? (:pass %)) (not (:within %))) checks))
                :design (sum :design es) :deferred (sum :deferred es)
                :pending (reduce + (map :n (filter #(= :pending (:decided (:class %))) es))))))

(defn- n [x] (format "%,d" (long x)))

(defn- cell-text [c]
  (if-not (:checked c)
    (str "no check yet" (when (:until c) (str " (" (:until c) ")")))
    (str (n (:pass c)) (when (:pass-partial c) "+") " / " (n (:design c)) " / " (n (:deferred c))
         (when (pos? (:pending c)) (str " (" (n (:pending c)) " pending)")))))

(defn- print-source [s entries?]
  (if-not (:present s)
    (println (str "   " (:name s) (when (= :beside (:role s)) " (beside)") ": not recorded yet"
                  (when (:until s) (str " (" (:until s) ")")) ", " (:file s)))
    (let [es (:entries s)
          by (group-by :class es)]
      (println (str "   " (:name s) (when (= :beside (:role s)) " (beside)") (when (:file s) (str ", " (:file s)))
                    ": " (if (:pass s) (n (:pass s)) "?") " " (:unit s) " pass, "
                    (n (reduce + (map :n es))) " not"
                    (when (:detail s) (str " (" (:detail s) ")"))))
      (doseq [[c xs] (sort-by (comp str :id key) (dissoc by nil))]
        (println (format "      %5d %s: %s (%s%s)" (long (reduce + (map :n xs))) (name (:id c)) (:title c)
                         (name (:kind (first xs)))
                         (if (= :pending (:decided c)) ", decision pending" "")))
        (when entries?
          (doseq [e xs]
            (println (str "              "
                          (if (str/starts-with? (:reason e) (:id e))
                            (str (name (:result e)) " " (:reason e))
                            (let [r (:reason e)] (str (:id e) ": " (name (:result e)) " " (if (> (count r) 100) (str (subs r 0 100) "...") r))))))))))))

(defn- matrix [spec cells]
  (let [nm (:names spec)]
    (println (str "| | " (str/join " | " (map nm (:levels spec))) " |"))
    (println (str "|---|" (str/join (repeat (count (:levels spec)) "---|"))))
    (doseq [l (:languages spec)]
      (println (str "| " (nm l) " | " (str/join " | " (for [v (:levels spec)] (cell-text (get cells [l v])))) " |")))))

;; the matrix as a record (report 021's finding 1): test/reap/matrix.edn

(def ^:private matrix-file "test/reap/matrix.edn")

(defn- source-record [s]
  (if-not (:present s)
    {:name (:name s) :absent true}
    {:name (:name s) :pass (:pass s) :not (reduce + (map :n (:entries s)))
     :classes (vec (sort-by (comp str first)
                            (for [[c xs] (group-by :class (:entries s)) :when c]
                              [(:id c) (reduce + (map :n xs))])))}))

(defn- cell-record [k c]
  {:cell k :checked (:checked c) :pass (:pass c) :design (:design c) :deferred (:deferred c)
   :pending (:pending c) :sources (mapv source-record (:sources c))})

(defn- matrix-text [records]
  (str ";; The REAP matrix as bin/reap computes it from the checks' records (report 021's finding 1):\n"
       ";; per cell its pass / by design / deferred (and pending), per source its passes (nil: the\n"
       ";; check records only its non-passes), non-passes and their classes. bin/reap fails on any\n"
       ";; difference from it; bin/reap --record writes it. Read with the Clojure reader.\n"
       "[\n"
       (str/join "\n"
                 (for [r records]
                   (str " {:cell " (pr-str (:cell r)) " :checked " (pr-str (:checked r))
                        " :pass " (:pass r) " :design " (:design r) " :deferred " (:deferred r)
                        " :pending " (:pending r) "\n  :sources\n  ["
                        (str/join "\n   "
                                  (for [s (:sources r)]
                                    (if (:absent s)
                                      (str "{:name " (pr-str (:name s)) " :absent true}")
                                      (str "{:name " (pr-str (:name s)) " :pass " (pr-str (:pass s))
                                           " :not " (:not s) "\n    :classes " (pr-str (:classes s)) "}"))))
                        "]}")))
       "\n]\n"))

(defn- matrix-diffs
  "The differences between the matrix computed, RECORDS, and test/reap/matrix.edn."
  [records nm]
  (if-not (exists? matrix-file)
    [(str "no " matrix-file " (bin/reap --record writes it)")]
    (let [old (into {} (for [r (read-edn matrix-file)] [(:cell r) r]))
          cname (fn [k] (str (nm (first k)) " " (nm (second k))))
          diff (fn [what f a b] (when (not= a b) [(str what ": " (name f) " " (pr-str a) ", recorded " (pr-str b))]))]
      (concat
       (for [k (keys old) :when (not (some #(= k (:cell %)) records))]
         (str (pr-str k) ": recorded, not a cell of test/reap/cells.edn"))
       (mapcat
        (fn [r]
          (let [o (old (:cell r)) cn (cname (:cell r))]
            (if-not o
              [(str cn ": not recorded")]
              (concat
               (mapcat #(diff cn % (get r %) (get o %)) [:checked :pass :design :deferred :pending])
               (let [os (into {} (for [s (:sources o)] [(:name s) s]))]
                 (concat
                  (for [s (:sources o) :when (not (some #(= (:name s) (:name %)) (:sources r)))]
                    (str cn ", " (:name s) ": recorded, not a source of the cell"))
                  (mapcat
                   (fn [s]
                     (let [x (os (:name s)) sn (str cn ", " (:name s))]
                       (if-not x
                         [(str sn ": not recorded")]
                         (concat
                          (mapcat #(diff sn % (get s %) (get x %)) [:absent :pass :not])
                          (let [a (into {} (:classes s)) b (into {} (:classes x))]
                            (for [id (sort-by str (distinct (concat (keys a) (keys b))))
                                  :when (not= (get a id) (get b id))]
                              (str sn ": class " (name id) " " (or (get a id) 0) ", recorded " (or (get b id) 0))))))))
                   (:sources r))))))))
        records)))))

(defn- run [spec entries? record?]
  (let [cells (into {} (for [[k c] (:cells spec)] [k (judge-cell c)]))
        nm (:names spec)
        order (for [l (:languages spec) v (:levels spec)] [l v])
        judged (mapcat (fn [k] (mapcat :problems (:sources (cells k)))) order)
        records (for [k order] (cell-record k (cells k)))
        diffs (map #(str matrix-file ": " %) (matrix-diffs records nm))
        write? (and record? (empty? judged))
        problems (if record? judged (concat judged diffs))]
    (println "reap: the REAP matrix (doc/FULL-SUPPORT-SURVEY.md, RPS13): pass / by design / deferred per cell,")
    (println "      summed over the cell's checks, each in its unit; + : a check records only its non-passes;")
    (println "      the checks beside a level (RPS16) and the cells' sources below")
    (println)
    (matrix spec cells)
    (println)
    (doseq [k order :let [c (cells k)]]
      (println (str (nm (first k)) " " (nm (second k)) ": " (cell-text c) "; classes " (:classes c)))
      (doseq [s (:sources c)] (print-source s entries?)))
    (let [pending (for [k order s (:sources (cells k)) e (:entries s)
                        :when (= :pending (:decided (:class e)))]
                    [(:classes-file s) (:class e)])
          pc (distinct pending)]
      (when (seq pc)
        (println)
        (println "reap: classes whose decision is pending (the user's):")
        (doseq [[f c] pc]
          (println (str "   " f " " (:id c) ": " (:title c) " (" (name (:kind c)) ", "
                        (count (filter #(= [f c] %) pending)) " cases)")))))
    (println)
    (when write?
      (spit (path matrix-file) (matrix-text records))
      (println (str "reap: wrote " matrix-file (if (seq diffs) ", its changes:" ", unchanged")))
      (doseq [d diffs] (println (str "   " d)))
      (println))
    (println (str "reap: " (count (filter :checked (vals cells))) " of " (count cells) " cells checked, "
                  (count (remove :checked (vals cells))) " with no check yet; "
                  (count problems) " problems"
                  (when (and record? (not write?)) (str "; " matrix-file " not written"))))
    (doseq [p problems] (println (str "   " p)))
    (empty? problems)))

(defn- suite-only
  "bin/clojure-tests --divergences RESULTS: the Clojure cells' suite sources over RESULTS."
  [spec results]
  (let [cells (for [v (:levels spec) :let [k [:clojure v] c (get-in spec [:cells k])]
                    :let [ss (filter #(and (= :clojure-suite (:reader %)) (not (:until %))) (:sources c))]
                    :when (seq ss)]
                [k (assoc c :sources (mapv #(assoc % :file results) ss))])
        js (for [[k c] cells] [k (judge-cell c)])
        problems (mapcat (fn [[_ c]] (mapcat :problems (:sources c))) js)]
    (doseq [[k c] js]
      (println (str "Clojure " ((:names spec) (second k)) ": " (cell-text c) "; classes " (:classes c)))
      (doseq [s (:sources c)] (print-source s true)))
    (println (str "clojure-tests divergences: " results ": " (count problems) " not in a class"))
    (doseq [p problems] (println (str "   " p)))
    (empty? problems)))

(defn- record-native-check
  "The summary of bin/repr-go native-check's report, the read level's reference, written only when
  the report has every corpus of CORPORA (bin/repr-go's native_corpora, space-separated; report
  021's finding 3: a report of native-check --corpus X made a record of one corpus)."
  [report out corpora]
  (let [r (with-open [rd (PushbackReader. (io/reader report))] (read rd))
        want (remove str/blank? (str/split (str/trim (or corpora "")) #"\s+"))
        miss (remove (set (map :corpus (:corpora r))) want)
        at (str (java.time.Instant/ofEpochMilli (.lastModified (File. ^String report))))
        lines (concat
               [";; bin/repr-go native-check's numbers (doc/FULL-SUPPORT-SURVEY.md, REAP1): per corpus its dumps, those"
                ";; equal at every level (E-tree, the raw forms resolved, E-ann, E-forms), the raw-only ones (the"
                ";; final conversion's failure), those dumped natively and not by the helper (its failure), the"
                ";; files go/parser rejects; written from the check's report by bin/reap record-native-check,"
                ";; after a run of bin/repr-go native-check (--fresh) over every corpus. Read with the Clojure reader."
                (str "{:recorded " (pr-str (str "native-check's report of " at)))
                " :corpora"
                " ["]
               (for [c (:corpora r)]
                 (str "  {:corpus " (pr-str (:corpus c)) " :dumps " (:dumps c) " :equal " (:forms-equal c)
                      " :rejected " (:rejected c) " :unknown " (:unknown c)
                      "\n   :raw-only [" (str/join "\n              " (map #(pr-str [(str (first %)) (str (second %))]) (:raw-only c))) "]"
                      "\n   :extra [" (str/join "\n           " (map #(pr-str [(str (first %)) (str/join " | " (take 2 (str/split (str (second %)) #" \| ")))]) (:extra c))) "]}"))
               ["  ]}"])]
    (if (or (empty? want) (seq miss) (:partial r))
      (do (println (str "reap: " report (cond (empty? want) " not judged: no list of corpora"
                                                (:partial r) " is a partial check's (native-check --only, GT8)"
                                                :else (str " lacks the corpora " (str/join " " miss)))
                        " (a run of bin/repr-go native-check over every corpus); " out " not written"))
          false)
      (do (spit out (str (str/join "\n" lines) "\n"))
          (println (str "reap: wrote " out " (" (count (:corpora r)) " corpora)"))
          true))))

(defn -main [& args]
  (binding [*root* (or (System/getenv "REAP_ROOT") ".")]
    (let [spec (read-edn "test/reap/cells.edn")
          ok (case (first args)
               "--suite" (suite-only spec (second args))
               "record-native-check" (record-native-check (second args) (nth args 2) (nth args 3 nil))
               (run spec (some #{"--entries"} args) (some #{"--record"} args)))]
      (shutdown-agents)
      (System/exit (if ok 0 1)))))

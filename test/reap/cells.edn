;; The REAP matrix's cells (doc/FULL-SUPPORT-SURVEY.md, REAP1, RPS3, RPS13, RPS16): for each
;; language and level, the checks whose recorded results judge it and the classes file of its
;; non-passes. bin/reap (test/reap/main.ae) reads only these files (no runs): each source's
;; reference gives its passing cases and its non-passing ones, each non-pass must fall into a
;; class (the first whose :match finds its "RESULT REASON"), and the matrix prints pass / by
;; design / deferred per cell.
;;
;; A cell: :classes, its classes file (test/goi/divergences.edn's format); :kind-map, a class's
;; :kind outside :design and :deferred mapped onto them (JC1's kinds); :refuse, the results its
;; check fails on whatever the classes (Go's cells: a fail or an error, goi's judge's rule, report
;; 021's finding 4; the round trip's :fail entries too); :sources, each
;;   :name     what it is, as printed
;;   :reader   how its files are read (test/reap/main.ae's read-source): :clojure-suite (Clojure's
;;             suite's results against upstream's), :oracle (bin/oracle's expected files and known
;;             mismatches), :known-mismatches (a known file in the oracle's shape: diffcheck's),
;;             :repr-clojure-rules (repr/clojure's one-way rules), :repr-clojure-known,
;;             :native-check (test/repr/go/native-check-results.edn), :native-known, :results
;;             (rows [ID RESULT REASON], goi's check), :java-check (rows [ID TEST RESULT REASON],
;;             JC1's), :jforms-excluded (diffcheck's exclusions, RPS27 (a)), :roundtrip (bin/repr-go roundtrip's reference, with its known file),
;;             :text-known (repr/go's text level)
;;             :c-known (C's known files of test/repr/c/; with :results, the check's results file of every
;;             file's row, CS240 (a), counted for the passes once it is written: it may be missing until then)
;;   :per-file (c-known) a file listed in several sections one non-pass, of its worst kind (queue 122, finding 4)
;;   :count-once the sources of a cell with the same value counted as one: each file once, a non-pass of its worst kind, a pass
;;             only when every check of the group passes it (C's token and tree checks, queue 132 F3, the user's decision)
;;   :exclude-corpora (c-known) corpora not counted, their rows and entries (the tree check's mutants, queue 132 F3)
;;   :ref-runs (results) the reference runs whose built programs must be the record's cases (C's eval, test/c/ref-gcc15.edn)
;;   :file ... the reader's files
;;   :include, :exclude  regexps selecting a source's parts (namespaces, files, cases)
;;   :generative, :compiled  (clojure-suite) test.generative's specs counted; the AOT level's: a
;;             source loaded from source (the results' :not-compiled, :evaluated) a non-pass
;;   :role     :check (the cell's conformance check, the default) or :beside (a check of the
;;             same code that is not the level's reference, RPS16: diffcheck's pairs, the oracle's
;;             Java forms and Go files)
;;   :until    a check not recorded yet, the milestone that brings it: its :file may be missing (a
;;             cell none of whose :check sources' files exist prints "no check yet" and does not
;;             fail); every other file a source names must exist, and an :until whose :file exists
;;             is stale, a problem (report 021's finding 3: every :until here had long passed)
;;   :classes  a classes file of its own, instead of the cell's
;;   :level    (java-check) the classes' :level the source's rows take
;;   :ref      (java-check) the tests its rows must be, test/java/ref-jdk26.edn's of its :level
;;             (report 021's finding 1: a shrunk record is a valid record)
;;   :same-cases (results) a record whose programs its rows must be (goi's AOT level, its eval's)
;;   :within   a known file whose cases are among another source's (its passes counted there)
;;   :unit     what a case is, as printed
;; Adding a check is adding its source here (REAP2's test/goi/check-aot-linux-amd64.edn, REAP3's
;; test/arbace-go-aot-results.edn, JC1's test/java/check-*.edn, JC2's and REAP5's levels are
;; here already, by the paths their plans name); then bin/reap --record, the matrix's record
;; test/reap/matrix.edn. Read with the Clojure reader.
{:languages [:clojure :java :go :c
             :llvm]
 :levels [:read :eval :aot :print]
 :names {:clojure "Clojure" :java "Java" :go "Go" :c "C" :llvm "LLVM" :read "read" :eval "eval" :aot "AOT" :print "print"}
 :cells
 {[:clojure :read]
  {:classes "test/clojure/divergences-read.edn"
   :sources [{:name "Clojure's suite: reader, edn" :unit "tests"
              :reader :clojure-suite :file "test/arbace-go-results.edn" :upstream "test/baseline-results.edn"
              :include #"^clojure\.test-clojure\.(reader|edn)$"}
             {:name "the oracle: the reader's files" :unit "cases"
              :reader :oracle :expected "test/oracle/expected" :file "test/oracle/known-go-amd64-frozen.edn"
              :include #"^(forms/reader|forms/harvest/reader|classes/LispReader)\.edn$"}
             {:name "repr/clojure's one-way rules" :unit "rules"
              :reader :repr-clojure-rules}]}
  [:clojure :eval]
  {:classes "test/clojure/divergences.edn"
   :sources [{:name "Clojure's suite" :unit "tests, specs"
              :reader :clojure-suite :file "test/arbace-go-results.edn" :upstream "test/baseline-results.edn"
              :exclude #"^clojure\.test-clojure\.(reader|edn|printer|pprint)$" :generative true}
             {:name "the oracle" :unit "cases"
              :reader :oracle :expected "test/oracle/expected" :file "test/oracle/known-go-amd64-frozen.edn"
              :exclude #"^(forms/reader|forms/harvest/reader|classes/LispReader|forms/printing|forms/format|forms/harvest/printer|classes/Printer|forms/defclass|forms/defclass_corpus|forms/go)\.edn$"}]}
  [:clojure :aot]
  {:classes "test/clojure/divergences-aot.edn"
   :sources [{:name "Clojure's suite compiled" :unit "tests, specs"
              :reader :clojure-suite :file "test/arbace-go-aot-results.edn" :upstream "test/baseline-results.edn"
              :generative true :compiled true}
             {:name "diffcheck: Clojure's pair" :unit "cases" :role :beside
              :reader :known-mismatches :file "test/diffcheck/known.edn" :exclude #"^test/j2g/"}]}
  [:clojure :print]
  {:classes "test/clojure/divergences-print.edn"
   :sources [{:name "Clojure's suite: printer, pprint" :unit "tests"
              :reader :clojure-suite :file "test/arbace-go-results.edn" :upstream "test/baseline-results.edn"
              :include #"^clojure\.test-clojure\.(printer|pprint)$"}
             {:name "the oracle: the printer's files" :unit "cases"
              :reader :oracle :expected "test/oracle/expected" :file "test/oracle/known-go-amd64-frozen.edn"
              :include #"^(forms/printing|forms/format|forms/harvest/printer|classes/Printer)\.edn$"}
             {:name "repr/clojure's round trip" :unit "files"
              :reader :repr-clojure-known :file "test/repr/clojure/roundtrip-known.edn"}]}
  [:java :read]
  {:classes "test/java/divergences.edn"
   :kind-map {:world :deferred :interp :deferred :analysis :deferred :repl :deferred :repr-java :deferred
              :j2g :deferred :speed :design :harness :deferred :other :deferred :javac :deferred}
   :sources [{:name "bin/java-check read" :unit "tests"
              :reader :java-check :file "test/java/check-read.edn" :level :read :ref "test/java/ref-jdk26.edn"}
             {:name "bin/java-check classes" :unit "tests"
              :reader :java-check :file "test/java/check-classes.edn" :level :classes :ref "test/java/ref-jdk26.edn"}
             {:name "bin/java-check diagnostics" :unit "tests"
              :reader :java-check :file "test/java/check-diagnostics.edn" :level :diagnostics :ref "test/java/ref-jdk26.edn"}]}
  [:java :eval]
  {:classes "test/java/divergences.edn"
   :kind-map {:world :deferred :interp :deferred :analysis :deferred :repl :deferred :repr-java :deferred
              :j2g :deferred :speed :design :harness :deferred :other :deferred}
   :sources [{:name "bin/java-check interp" :unit "tests"
              :reader :java-check :file "test/java/check-interp.edn" :level :interp :ref "test/java/ref-jdk26.edn"}
             {:name "diffcheck: the Java forms' pair" :unit "cases" :role :beside
              :reader :known-mismatches :file "test/diffcheck/known.edn" :include #"^test/j2g/"
              :classes "test/java/divergences-diffcheck.edn"}
             {:name "the oracle: the Java forms' files" :unit "cases" :role :beside
              :reader :oracle :expected "test/oracle/expected" :file "test/oracle/known-go-amd64-frozen.edn"
              :include #"^forms/(defclass|defclass_corpus)\.edn$" :classes "test/clojure/divergences.edn"}]}
  [:java :aot]
  {:classes "test/java/divergences.edn"
   :kind-map {:world :deferred :interp :deferred :analysis :deferred :repl :deferred :repr-java :deferred
              :j2g :deferred :speed :design :harness :deferred :other :deferred}
   :sources [{:name "bin/java-check compiled" :unit "tests"
              :reader :java-check :file "test/java/check-compiled.edn" :level :compiled :ref "test/java/ref-jdk26.edn"}
             {:name "diffcheck's exclusions (Java forms not given j2g)" :unit "classes" :role :beside
              :reader :jforms-excluded :file "test/diffcheck/jforms-excluded.edn"
              :classes "test/java/divergences-diffcheck.edn"}]}
  [:java :print]
  {:classes "test/java/divergences.edn"
   :kind-map {:world :deferred :interp :deferred :analysis :deferred :repl :deferred :repr-java :deferred
              :j2g :deferred :speed :design :harness :deferred :other :deferred}
   :sources [{:name "bin/java-check print" :unit "tests"
              :reader :java-check :file "test/java/check-print.edn" :level :print :ref "test/java/ref-jdk26.edn"}]}
  [:go :read]
  {:classes "test/repr/go/divergences-read.edn"
   :sources [{:name "bin/repr-go native-check" :unit "dumps"
              :reader :native-check :file "test/repr/go/native-check-results.edn"}
             {:name "native-check's known differences" :unit "keys"
              :reader :native-known :file "test/repr/go/native-known.edn"
              :within "bin/repr-go native-check"}]}
  [:go :eval]
  {:classes "test/goi/divergences.edn" :refuse [:fail :error]
   :sources [{:name "bin/goi check (linux/amd64)" :unit "programs"
              :reader :results :file "test/goi/check-linux-amd64.edn"}
             {:name "the oracle: goi's file" :unit "cases" :role :beside
              :reader :oracle :expected "test/oracle/expected" :file "test/oracle/known-go-amd64-frozen.edn"
              :include #"^forms/go\.edn$" :classes "test/clojure/divergences.edn"}]}
  [:go :aot]
  {:classes "test/goi/divergences-aot.edn" :refuse [:fail :error]
   :sources [{:name "bin/goi check --aot (linux/amd64)" :unit "programs"
              :reader :results :file "test/goi/check-aot-linux-amd64.edn"
              :same-cases "test/goi/check-linux-amd64.edn"}]}
  [:go :print]
  {:classes "test/repr/go/divergences-print.edn" :refuse [:fail :error]
   :sources [{:name "bin/repr-go roundtrip linux/amd64" :unit "packages, programs"
              :reader :roundtrip :file "test/repr/go/roundtrip-linux-amd64.edn"}
             {:name "bin/repr-go roundtrip --dirs linux/amd64" :unit "directory tests"
              :reader :roundtrip :file "test/repr/go/roundtrip-dirtest-linux-amd64.edn"
              :known "test/repr/go/roundtrip-dirtest-known.edn"}
             {:name "bin/repr-go roundtrip --tests" :unit "packages"
              :reader :roundtrip :file "test/repr/go/roundtrip-tests.edn"
              :known "test/repr/go/roundtrip-tests-known.edn"}
             {:name "bin/repr-go roundtrip --text amd64" :unit "files"
              :reader :text-known :file "test/repr/go/roundtrip-text-known.edn"}]}
  [:c :read]
  {:classes "test/c/divergences-read.edn" :kind-map {:gap :deferred}
   :sources [{:name "bin/ci dg (gcc 15.2's C23 corpus, DejaGnu directives)" :unit "files"
              :reader :results :file "test/c/check-dg-linux-amd64.edn" :classes "test/c/divergences-dg.edn"}
             {:name "bin/repr-c check --tokens (the preprocessor's tokens against cc's)" :unit "files"
              :reader :c-known :file "test/repr/c/pp-check-known.edn" :sections [:pp :lex :gcc] :per-file true
              :results "test/repr/c/pp-check-results.edn" :count-once :c-corpus-files :exclude-corpora ["mutants"]}
             {:name "bin/repr-c parse-check (the parser's trees against cc's)" :unit "files"
              :reader :c-known :file "test/repr/c/parse-check-known.edn" :section :parse
              :results "test/repr/c/parse-check-results.edn" :count-once :c-corpus-files :exclude-corpora ["mutants"]}]}
  [:c :eval]
  {:classes "test/c/divergences.edn" :kind-map {:gap :deferred}
   :sources [{:name "bin/ci check (linux/amd64, gcc 15.2's runs)" :unit "programs"
              :reader :results :file "test/c/check-linux-amd64.edn" :ref-runs "test/c/ref-gcc15.edn"}
             {:name "bin/ci annotations: the checker against cc's" :unit "files" :role :beside
              :reader :c-known :file "test/repr/c/annot-known.edn" :section :annot
              :results "test/repr/c/annot-results.edn" :classes "test/c/divergences-annot.edn"}]}
  [:c :aot]
  {:classes ["test/c/divergences-aot.edn" "test/c/divergences.edn"] :kind-map {:gap :deferred}
   :sources [{:name "bin/ci check --aot (linux/amd64)" :unit "programs"
              :reader :results :file "test/c/check-aot-linux-amd64.edn"
              :same-cases "test/c/check-linux-amd64.edn"}]}
  [:c :print]
  {:classes "test/c/divergences-print.edn" :refuse [:fail :error]
   :sources [{:name "bin/repr-c roundtrip (the four levels, 20 corpora)" :unit "files"
              :reader :c-known :file "test/repr/c/roundtrip-known.edn" :section :roundtrip
              :results "test/repr/c/roundtrip-results.edn"}]}
  ;; ---- LLVM's row (REAP; doc/llvm/LLVM-CROP-SURVEY.md, "The REAP row as it would be now"): repr/llvm's checks for read and print,
  ;; recorded as rows by bin/lib/repr-llvm/results (test/llvm/check-*.edn); eval and AOT (llvmi) are not built: no check yet
  [:llvm :read]
  {:classes "test/llvm/divergences-read.edn"
   :sources [{:name "bin/repr-llvm roundtrip (282 modules: forms, object, bitcode)" :unit "modules"
              :reader :results :file "test/llvm/check-roundtrip-linux-amd64.edn"}
             {:name "bin/repr-llvm verify-check: the valid modules and 630 mutants against opt -passes=verify" :unit "modules, mutants"
              :reader :results :file "test/llvm/check-verify-linux-amd64.edn"}
             {:name "bin/repr-llvm verify-check: the held-out mutants (two sets, run once)" :unit "mutants"
              :reader :results :file "test/llvm/check-verify-heldout-linux-amd64.edn"}
             {:name "bin/repr-llvm verify-check: the hand-written probes" :unit "probes"
              :reader :results :file "test/llvm/check-verify-probes-linux-amd64.edn"}]}
  [:llvm :eval]
  {:classes "test/llvm/divergences-eval.edn"
   :sources [{:name "llvmi check (the IR lowered to C forms on ci, against clang 23's build)" :unit "modules"
              :reader :results :file "test/llvm/check-eval-linux-amd64.edn" :until "LL2 and LL6: llvmi and its reference file"}]}
  [:llvm :aot]
  {:classes "test/llvm/divergences-eval.edn"
   :sources [{:name "llvmi check --aot (the same C forms through cf2g)" :unit "modules"
              :reader :results :file "test/llvm/check-aot-linux-amd64.edn" :until "LL7: llvmi check --aot"}]}
  [:llvm :print]
  {:classes "test/llvm/divergences-print.edn"
   :sources [{:name "bin/repr-llvm roundtrip --text (mode :full, 282 modules printed back byte for byte)" :unit "modules"
              :reader :results :file "test/llvm/check-text-linux-amd64.edn"}]}}}

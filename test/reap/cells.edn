;; The REAP matrix's cells (doc/FULL-SUPPORT-SURVEY.md, REAP1, RPS3, RPS13, RPS16): for each
;; language and level, the checks whose recorded results judge it and the classes file of its
;; non-passes. bin/reap (test/reap/main.ae) reads only these files (no runs): each source's
;; reference gives its passing cases and its non-passing ones, each non-pass must fall into a
;; class (the first whose :match finds its "RESULT REASON"), and the matrix prints pass / by
;; design / deferred per cell.
;;
;; A cell: :classes, its classes file (test/goi/divergences.edn's format); :kind-map, a class's
;; :kind outside :design and :deferred mapped onto them (JC1's kinds); :sources, each
;;   :name     what it is, as printed
;;   :reader   how its files are read (test/reap/main.ae's read-source): :clojure-suite (Clojure's
;;             suite's results against upstream's), :oracle (bin/oracle's expected files and known
;;             mismatches), :known-mismatches (a known file in the oracle's shape: diffcheck's),
;;             :repr-clojure-rules (repr/clojure's one-way rules), :repr-clojure-known,
;;             :native-check (test/repr/go/native-check-results.edn), :native-known, :results
;;             (rows [ID RESULT REASON], goi's check), :java-check (rows [ID TEST RESULT REASON],
;;             JC1's), :jforms-excluded (diffcheck's exclusions, RPS27 (a)), :roundtrip (bin/repr-go roundtrip's reference, with its known file),
;;             :text-known (repr/go's text level)
;;   :file ... the reader's files
;;   :include, :exclude  regexps selecting a source's parts (namespaces, files, cases)
;;   :role     :check (the cell's conformance check, the default) or :beside (a check of the
;;             same code that is not the level's reference, RPS16: diffcheck's pairs, the oracle's
;;             Java forms and Go files); a cell none of whose :check sources' files exist prints
;;             "no check yet" (with :until, the milestone that brings it) and does not fail
;;   :classes  a classes file of its own, instead of the cell's
;;   :level    (java-check) the classes' :level the source's rows take
;;   :within   a known file whose cases are among another source's (its passes counted there)
;;   :unit     what a case is, as printed
;; Adding a check is adding its source here (REAP2's test/goi/check-aot-linux-amd64.edn, REAP3's
;; test/arbace-go-aot-results.edn, JC1's test/java/check-*.edn, JC2's and REAP5's levels are
;; here already, by the paths their plans name). Read with the Clojure reader.
{:languages [:clojure :java :go]
 :levels [:read :eval :aot :print]
 :names {:clojure "Clojure" :java "Java" :go "Go" :read "read" :eval "eval" :aot "AOT" :print "print"}
 :cells
 {[:clojure :read]
  {:classes "test/clojure/divergences-read.edn"
   :sources [{:name "Clojure's suite: reader, edn" :unit "tests"
              :reader :clojure-suite :file "test/arbace-go-results.edn" :upstream "test/baseline-results.edn"
              :include #"^clojure\.test-clojure\.(reader|edn)$"}
             {:name "the oracle: the reader's files" :unit "cases"
              :reader :oracle :expected "test/oracle/expected" :file "test/oracle/known-go-amd64-frozen.edn"
              :include #"^(forms/reader|forms/harvest/reader|classes/LispReader)\.edn$"}
             {:name "repr/clojure's one-way rules" :unit "rules"
              :reader :repr-clojure-rules}]}
  [:clojure :eval]
  {:classes "test/clojure/divergences.edn"
   :sources [{:name "Clojure's suite" :unit "tests, specs"
              :reader :clojure-suite :file "test/arbace-go-results.edn" :upstream "test/baseline-results.edn"
              :exclude #"^clojure\.test-clojure\.(reader|edn|printer|pprint)$" :generative true}
             {:name "the oracle" :unit "cases"
              :reader :oracle :expected "test/oracle/expected" :file "test/oracle/known-go-amd64-frozen.edn"
              :exclude #"^(forms/reader|forms/harvest/reader|classes/LispReader|forms/printing|forms/format|forms/harvest/printer|classes/Printer|forms/defclass|forms/defclass_corpus|forms/go)\.edn$"}]}
  [:clojure :aot]
  {:classes "test/clojure/divergences-aot.edn"
   :sources [{:name "Clojure's suite compiled" :unit "tests, specs" :until "REAP3"
              :reader :clojure-suite :file "test/arbace-go-aot-results.edn" :upstream "test/baseline-results.edn"
              :generative true}
             {:name "diffcheck: Clojure's pair" :unit "cases" :role :beside
              :reader :known-mismatches :file "test/diffcheck/known.edn" :exclude #"^test/j2g/"}]}
  [:clojure :print]
  {:classes "test/clojure/divergences-print.edn"
   :sources [{:name "Clojure's suite: printer, pprint" :unit "tests"
              :reader :clojure-suite :file "test/arbace-go-results.edn" :upstream "test/baseline-results.edn"
              :include #"^clojure\.test-clojure\.(printer|pprint)$"}
             {:name "the oracle: the printer's files" :unit "cases"
              :reader :oracle :expected "test/oracle/expected" :file "test/oracle/known-go-amd64-frozen.edn"
              :include #"^(forms/printing|forms/format|forms/harvest/printer|classes/Printer)\.edn$"}
             {:name "repr/clojure's round trip" :unit "files"
              :reader :repr-clojure-known :file "test/repr/clojure/roundtrip-known.edn"}]}
  [:java :read]
  {:classes "test/java/divergences.edn"
   :kind-map {:world :deferred :interp :deferred :analysis :deferred :repl :deferred :repr-java :deferred
              :j2g :deferred :speed :design :harness :deferred :other :deferred :javac :deferred}
   :sources [{:name "bin/java-check read" :unit "tests" :until "JC1"
              :reader :java-check :file "test/java/check-read.edn" :level :read}
             {:name "bin/java-check classes" :unit "tests" :until "JC1"
              :reader :java-check :file "test/java/check-classes.edn" :level :classes}
             {:name "bin/java-check diagnostics" :unit "tests" :until "JC3"
              :reader :java-check :file "test/java/check-diagnostics.edn" :level :diagnostics}]}
  [:java :eval]
  {:classes "test/java/divergences.edn"
   :kind-map {:world :deferred :interp :deferred :analysis :deferred :repl :deferred :repr-java :deferred
              :j2g :deferred :speed :design :harness :deferred :other :deferred}
   :sources [{:name "bin/java-check interp" :unit "tests" :until "JC1"
              :reader :java-check :file "test/java/check-interp.edn" :level :interp}
             {:name "diffcheck: the Java forms' pair" :unit "cases" :role :beside
              :reader :known-mismatches :file "test/diffcheck/known.edn" :include #"^test/j2g/"
              :classes "test/java/divergences-diffcheck.edn"}
             {:name "the oracle: the Java forms' files" :unit "cases" :role :beside
              :reader :oracle :expected "test/oracle/expected" :file "test/oracle/known-go-amd64-frozen.edn"
              :include #"^forms/(defclass|defclass_corpus)\.edn$" :classes "test/clojure/divergences.edn"}]}
  [:java :aot]
  {:classes "test/java/divergences.edn"
   :kind-map {:world :deferred :interp :deferred :analysis :deferred :repl :deferred :repr-java :deferred
              :j2g :deferred :speed :design :harness :deferred :other :deferred}
   :sources [{:name "bin/java-check compiled" :unit "tests" :until "JC2"
              :reader :java-check :file "test/java/check-compiled.edn" :level :compiled}
             {:name "diffcheck's exclusions (Java forms not given j2g)" :unit "classes" :role :beside
              :reader :jforms-excluded :file "test/diffcheck/jforms-excluded.edn"
              :classes "test/java/divergences-diffcheck.edn"}]}
  [:java :print]
  {:classes "test/java/divergences.edn"
   :kind-map {:world :deferred :interp :deferred :analysis :deferred :repl :deferred :repr-java :deferred
              :j2g :deferred :speed :design :harness :deferred :other :deferred}
   :sources [{:name "bin/java-check print" :unit "tests" :until "REAP5"
              :reader :java-check :file "test/java/check-print.edn" :level :print}]}
  [:go :read]
  {:classes "test/repr/go/divergences-read.edn"
   :sources [{:name "bin/repr-go native-check" :unit "dumps"
              :reader :native-check :file "test/repr/go/native-check-results.edn"}
             {:name "native-check's known differences" :unit "keys"
              :reader :native-known :file "test/repr/go/native-known.edn"
              :within "bin/repr-go native-check"}]}
  [:go :eval]
  {:classes "test/goi/divergences.edn"
   :sources [{:name "bin/goi check (linux/amd64)" :unit "programs"
              :reader :results :file "test/goi/check-linux-amd64.edn"}
             {:name "the oracle: goi's file" :unit "cases" :role :beside
              :reader :oracle :expected "test/oracle/expected" :file "test/oracle/known-go-amd64-frozen.edn"
              :include #"^forms/go\.edn$" :classes "test/clojure/divergences.edn"}]}
  [:go :aot]
  {:classes "test/goi/divergences-aot.edn"
   :sources [{:name "bin/goi check --aot (linux/amd64)" :unit "programs" :until "REAP2"
              :reader :results :file "test/goi/check-aot-linux-amd64.edn"}]}
  [:go :print]
  {:classes "test/repr/go/divergences-print.edn"
   :sources [{:name "bin/repr-go roundtrip linux/amd64" :unit "packages, programs"
              :reader :roundtrip :file "test/repr/go/roundtrip-linux-amd64.edn"}
             {:name "bin/repr-go roundtrip --dirs linux/amd64" :unit "directory tests"
              :reader :roundtrip :file "test/repr/go/roundtrip-dirtest-linux-amd64.edn"
              :known "test/repr/go/roundtrip-dirtest-known.edn"}
             {:name "bin/repr-go roundtrip --tests" :unit "packages"
              :reader :roundtrip :file "test/repr/go/roundtrip-tests.edn"
              :known "test/repr/go/roundtrip-tests-known.edn"}
             {:name "bin/repr-go roundtrip --text amd64" :unit "files"
              :reader :text-known :file "test/repr/go/roundtrip-text-known.edn"}]}}}

;; jrt: serialization's natives (CDR10, doc/CLOJURE-DESIGN-REVIEW.md, the user's decision of 2026-11-06;
;; doc/go/JRT-NOTES.md, "Serialization"). Staged here with the Java of test/jrt/serialization until
;; serialization joins the world: then go/arbace/jrt/serial.ae, with ClassInfo's SerialNew field
;; (class.ae) and j2g's writing of it (arbace.j2g.decls, the night's build).
;;   SerialAlloc.canAllocate0, allocate0 (jdk.internal.jrt.SerialAlloc): ClassInfo.SerialNew, which j2g
;;     writes for each concrete Serializable class C of the world whose first non-serializable
;;     superclass S has a no-argument constructor accessible to C (ReflectionFactory's rule): C's zero
;;     struct, S's constructor body run on it (Ctor of S's embedded struct, this the object), C's own
;;     constructors and its serializable superclasses' not run, as the JVM's serialization constructor;
;;   ObjectStreamClass.initNative: nothing (the JVM's caches field IDs);
;;   ObjectStreamClass.hasStaticInitializer: the class's Init (C_Init: j2g writes it for a class with
;;     a static initializer or static field initializers, the <clinit> the default serialVersionUID asks).
(in-ns 'go.arbace.jrt)

(go/file "serial.go")

(go/func SerialAlloc_CanAllocate0_Class__Z_native
  "SerialAlloc_CanAllocate0_Class__Z_native tells whether c's objects can be made for deserialization:
its class info has a SerialNew.\n"
  ^bool [^{:tag (* Class)} c]
  (and (!= c nil) (!= (.-SerialNew (.Info c)) nil)))

(go/func SerialAlloc_Allocate0_Class__O_native
  "SerialAlloc_Allocate0_Class__O_native is a new object of c made by its SerialNew.\n"
  ^any [^{:tag (* Class)} c]
  ((.-SerialNew (.Info c))))

(go/func ObjectStreamClass_InitNative__V_native "ObjectStreamClass_InitNative__V_native does nothing.\n" [])

(go/func ObjectStreamClass_HasStaticInitializer_Class__Z_native
  "ObjectStreamClass_HasStaticInitializer_Class__Z_native tells whether c has a static initializer:
its class info's Init.\n"
  ^bool [^{:tag (* Class)} c]
  (!= (.-Init (.Info c)) nil))

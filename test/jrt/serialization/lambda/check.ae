;; JCS169's night check (doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: JCS169 (write-ahead)"): serializable
;; lambdas and method references through the real object streams, on an executable whose world has them
;; (jdk.internal.jrt.SerialLambdas, java.lang.invoke.SerializedLambda): the sample's interpreted lambdas
;; (src/, converted into forms/ by bin/repr-java read --no-javac) and a translated JDK lambda (Comparator's
;; comparing, whose captured function is not serializable: NotSerializableException as on the JVM). Run from
;; the checkout:
;;   ARBACE_PATH=$PWD:$PWD/test/jrt/serialization/lambda/forms EXE -e '(load-file "test/jrt/serialization/lambda/check.ae")'
;; Expected (the JDK's, by the same Java run as a program):
;;   statik 6 6
;;   instance 103 103
;;   ref 3 3
;;   bound sab sab
;;   comparator java.io.NotSerializableException
;;   plain java.io.NotSerializableException
;;   lambda-check: 6 of 6
(require 'slambda)
(import '(java.io ByteArrayInputStream ByteArrayOutputStream ObjectInputStream ObjectOutputStream))
(defn rt [x]
  (let [b (ByteArrayOutputStream.) o (ObjectOutputStream. b)]
    (.writeObject o x) (.close o)
    (.readObject (ObjectInputStream. (ByteArrayInputStream. (.toByteArray b))))))
(defn thrown [f] (try (f) (catch Throwable t (.getName (class t)))))
(def got
  [["statik" (let [s (slambda.Sample/statik 5)] [(.getAsInt s) (.getAsInt (rt s))])]
   ["instance" (let [f (.instance (slambda.Sample.) 3)] [(.get f) (.get (rt f))])]
   ["ref" (let [f (slambda.Sample/ref)] [(.apply f "abc") (.apply (rt f) "abc")])]
   ["bound" (let [f (.bound (slambda.Sample.))] [(.apply f "ab") (.apply (rt f) "ab")])]
   ["comparator" [(thrown #(rt (slambda.Sample/comparator)))]]
   ["plain" [(thrown #(rt (slambda.Sample/plain)))]]])
(def want {"statik" [6 6] "instance" [103 103] "ref" [3 3] "bound" ["sab" "sab"]
           "comparator" ["java.io.NotSerializableException"] "plain" ["java.io.NotSerializableException"]})
(def ok (count (filter (fn [[k v]] (= v (want k))) got)))
(doseq [[k v] got] (println k (apply str (interpose " " v)) (if (= v (want k)) "" "BAD")))
(println "lambda-check:" ok "of" (count want))
(when (< ok (count want)) (System/exit 1))

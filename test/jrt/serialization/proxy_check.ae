;; JCS170's night check (doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: JCS170 (write-ahead)"): java.lang.reflect.Proxy
;; over Dyn on the night's executable. Run from the checkout: EXE -e '(load-file "test/jrt/serialization/proxy_check.ae")'
;; Expected (as the JVM's): every line ok and "proxy-check: 9 of 9".
(import '(java.lang.reflect InvocationHandler Proxy UndeclaredThrowableException)
        '(java.io ByteArrayInputStream ByteArrayOutputStream ObjectInputStream ObjectOutputStream Serializable))
(deftype H [tag] InvocationHandler Serializable
  (invoke [_ p m args]
    (case (.getName m)
      "run" nil
      "apply" (str tag ":" (first args))
      "hashCode" (int 42)
      "toString" (str "proxy " tag)
      "equals" (identical? p (first args))
      "compareTo" (int 7)
      nil)))
(defn mk [ifs h] (Proxy/newProxyInstance (.getContextClassLoader (Thread/currentThread)) (into-array Class ifs) h))
(defn rt [x]
  (let [b (ByteArrayOutputStream.) o (ObjectOutputStream. b)]
    (.writeObject o x) (.close o)
    (.readObject (ObjectInputStream. (ByteArrayInputStream. (.toByteArray b))))))
(defn thrown [f] (try (f) "none" (catch Throwable t (.getName (class t)))))
(def p (mk [java.util.function.Function Comparable] (H. "a")))
(def checks
  [["apply" (= "a:1" (.apply ^java.util.function.Function p 1))]
   ["Object's methods" (and (= 42 (.hashCode p)) (= "proxy a" (str p)) (.equals p p) (not (.equals p 1)))]
   ["isProxyClass" (and (Proxy/isProxyClass (class p)) (not (Proxy/isProxyClass String)))]
   ["name" (boolean (re-matches #"jdk\.proxy1\.\$Proxy\d+" (.getName (class p))))]
   ["superclass" (= Proxy (.getSuperclass (class p)))]
   ["getInvocationHandler" (= "a" (.-tag ^H (Proxy/getInvocationHandler p)))]
   ["one class" (= (class p) (class (mk [java.util.function.Function Comparable] (H. "b"))))]
   ["not an interface" (= "java.lang.IllegalArgumentException" (thrown #(mk [String] (H. "c"))))]
   ["serialized" (let [q (rt p)] (and (Proxy/isProxyClass (class q)) (= "a:2" (.apply ^java.util.function.Function q 2))))]])
(doseq [[k v] checks] (println (if v "ok " "BAD") k))
(def ok (count (filter second checks)))
(println "proxy-check:" ok "of" (count checks))
(when (< ok (count checks)) (System/exit 1))

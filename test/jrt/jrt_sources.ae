;; DataOutput, DataOutputStream, UTFDataFormatException, FilterWriter, ModifiedUtf and
;; ExactConversionsSupport were javac's world's (bin/javac-vendor's base_files) until then.
(def io-sources
  "java.io's classes in the Go build beyond the measured closure's (JC6b): paths relative to
  src/java.base/share/classes."

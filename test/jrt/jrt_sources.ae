                ["AlreadyBoundException" "AlreadyConnectedException" "CancelledKeyException"
                 "ClosedSelectorException" "ConnectionPendingException" "IllegalSelectorException"
                 "NetworkChannel" "NoConnectionPendingException" "NotYetBoundException"
                 "NotYetConnectedException" "Pipe" "SelectableChannel" "SelectionKey" "Selector"
                 "ServerSocketChannel" "SocketChannel" "UnresolvedAddressException"
                 "UnsupportedAddressTypeException"
                 "spi/AbstractSelectableChannel" "spi/AbstractSelectionKey" "spi/AbstractSelector"
                 "spi/SelectorProvider"])
           (map #(str "src/java.base/share/classes/sun/nio/ch/" % ".java")
                ["DummySocketImpl" "ExtendedSocketOption" "IOStatus" "OptionKey" "SelChImpl"
                 "SelectionKeyImpl" "SelectorImpl" "SelectorProviderImpl" "ServerSocketAdaptor"
                 "ServerSocketChannelImpl" "SocketAdaptor" "SocketChannelImpl" "SocketInputStream"
                 "SocketOutputStream"])
           ["src/java.base/share/classes/jdk/internal/event/SocketReadEvent.java"
            "src/java.base/share/classes/jdk/internal/event/SocketWriteEvent.java"
            "src/java.base/share/classes/sun/net/ConnectionResetException.java"
            "src/java.base/share/classes/sun/net/ext/ExtendedSocketOptions.java"]
           (map #(str "src/java.base/unix/classes/sun/nio/ch/" % ".java")
                ["PipeImpl" "PollSelectorProvider" "SinkChannelImpl" "SourceChannelImpl"])
           (map #(str "src/java.base/linux/classes/sun/nio/ch/" % ".java")
                ["DefaultSelectorProvider" "EPollSelectorImpl" "EPollSelectorProvider"])))))

;; Java serialization (JCS167 (a), the user's decision of 2026-11-07; doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built:
;; JCS167 (write-ahead)"; CDR10's staging, doc/go/JRT-NOTES.md, "Serialization"): jdk26u's object streams, their
;; descriptors and filter, and SharedSecrets' serialization accessors' interfaces (the accessors themselves are j2g's,
;; m/j2g-static?). ObjectStreamClass and ObjectInputStream are jrt's variants of jdk26u's (overlay/jdk/java.base/java/io,
;; made by test/jrt/serialization/variants.py), ClassCache jrt's own, the allocation jdk.internal.jrt.SerialAlloc's;
;; java.io.Serial (an annotation, not kept) and SerializationMisdeclarationChecker (JFR's event, cut by the variant)
;; stay out.
(def serial-sources
  "Java serialization in the Go build (JCS167): paths relative to src/java.base/share/classes."
  (vec (sort
         (concat
           (map #(str "java/io/" % ".java")

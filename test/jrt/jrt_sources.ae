(def naming-script-sources
  "javax.script's API and JNDI's names in the Go build (doc/classes/JAVA-DEFERRED-TRIAGE.md, F19, \"As built: F19
  (write-ahead)\"): paths relative to jdk26u, files of src/java.scripting and src/java.naming translated as
  java.base's (added-module-sources' way): javax.script (no engine: none is in JDK 26's image), javax.naming's
  names, references, contexts and exceptions, javax.naming.directory's attributes, javax.naming.ldap's LdapName
  and Rdn, javax.naming.spi's managers and com.sun.naming.internal's helpers (no provider: JNDI's LDAP, DNS and
  RMI providers stay out). Variants ScriptEngineManager.ae, VersionHelper.ae, NamingManager.ae (no
  ServiceLoader, no context class loader, no ClassLoaderValue)."
  (vec (sort
         (concat
           (map #(str "src/java.naming/share/classes/com/sun/naming/internal/" % ".java")
                ["FactoryEnumeration" "NamedWeakReference" "NamingManagerHelper" "ObjectFactoriesFilter"
                 "ResourceManager" "VersionHelper"])
           (map #(str "src/java.naming/share/classes/javax/naming/" % ".java")
                ["BinaryRefAddr" "Binding" "CannotProceedException" "CompositeName" "ConfigurationException"
                 "Context" "InitialContext" "InvalidNameException" "Name" "NameClassPair" "NameImpl"
                 "NameParser" "NamingEnumeration" "NamingException" "NoInitialContextException"
                 "OperationNotSupportedException" "RefAddr" "Reference" "Referenceable" "StringRefAddr"])
           (map #(str "src/java.naming/share/classes/javax/naming/directory/" % ".java")
                ["Attribute" "Attributes" "BasicAttribute" "BasicAttributes" "DirContext" "ModificationItem"
                 "SearchControls" "SearchResult"])
           (map #(str "src/java.naming/share/classes/javax/naming/ldap/" % ".java")
                ["Control" "ExtendedRequest" "ExtendedResponse" "LdapContext" "LdapName" "Rdn"
                 "Rfc2253Parser"])
           (map #(str "src/java.naming/share/classes/javax/naming/spi/" % ".java")
                ["ContinuationContext" "DirObjectFactory" "InitialContextFactory"
                 "InitialContextFactoryBuilder" "NamingManager" "ObjectFactory" "ObjectFactoryBuilder"
                 "ResolveResult" "Resolver" "StateFactory"])
           (map #(str "src/java.scripting/share/classes/javax/script/" % ".java")
                ["AbstractScriptEngine" "Bindings" "Compilable" "CompiledScript" "Invocable" "ScriptContext"
                 "ScriptEngine" "ScriptEngineFactory" "ScriptEngineManager" "ScriptException"
                 "SimpleBindings" "SimpleScriptContext"])))))

(def management-sources
  "java.lang.management in the Go build without JMX (doc/classes/JAVA-DEFERRED-TRIAGE.md, F13, \"As built: F13
  (write-ahead)\"; JCS161 (a)): paths relative to jdk26u, files of src/java.management and src/jdk.management
  translated as java.base's: the MXBean interfaces, sun.management's ThreadImpl, RuntimeImpl, VMManagement and Util
  with the counters' interface, JMX's exceptions MalformedObjectNameException names, jdk.management's
  com.sun.management.ThreadMXBean and HotSpotThreadImpl. jrt's own beside them (overlay/jdk): the skeletons
  javax.management.ObjectName and openmbean.CompositeData, java.lang.management's ManagementFactory, ThreadInfo,
  LockInfo, MonitorInfo and MemoryUsage, sun.management's ManagementFactoryHelper and VMManagementImpl transcribed
  without JMX, jdk.management's (unix) OperatingSystemImpl with its natives over jrt's, jdk.internal.jrt.HostManagement;
  the variants ThreadImpl.ae (its natives over HostManagement) and BaseOperatingSystemImpl.ae (the load average)."
  (vec (sort
         (concat
           (map #(str "src/java.management/share/classes/java/lang/management/" % ".java")
                ["BufferPoolMXBean" "ClassLoadingMXBean" "CompilationMXBean" "GarbageCollectorMXBean"
                 "ManagementPermission" "MemoryMXBean" "MemoryManagerMXBean" "MemoryPoolMXBean" "MemoryType"
                 "OperatingSystemMXBean" "PlatformLoggingMXBean" "PlatformManagedObject" "RuntimeMXBean"
                 "ThreadMXBean"])
           (map #(str "src/java.management/share/classes/javax/management/" % ".java")
                ["JMException" "MalformedObjectNameException" "OperationsException"])
           (map #(str "src/java.management/share/classes/sun/management/" % ".java")
                ["BaseOperatingSystemImpl" "RuntimeImpl" "ThreadImpl" "Util" "VMManagement"])
           (map #(str "src/java.management/share/classes/sun/management/counter/" % ".java")
                ["Counter" "Units" "Variability"])
           (map #(str "src/jdk.management/share/classes/com/sun/management/" % ".java")
                ["OperatingSystemMXBean" "ThreadMXBean" "UnixOperatingSystemMXBean"])
           (map #(str "src/jdk.management/share/classes/com/sun/management/internal/" % ".java")
                ["HotSpotThreadImpl"])))))

(def process-sources
  "Processes in the Go build (the user's decision of 2026-10-10, reversing D6 for them;
  doc/go/JRT-NOTES.md, \"Processes\"): paths relative to jdk26u. Process, ProcessBuilder (with
  its Redirect), ProcessHandle and ProcessHandleImpl are plain Java; ProcessImpl and
  ProcessEnvironment are src/java.base/unix/classes files (KIND unix). ProcessImpl's forkAndExec
  and ProcessHandleImpl's natives are jrt's over the host's optional HostProc (variants
  overlay/jdk/variants/ProcessImpl.ae, ProcessHandleImpl.ae); ProcessEnvironment's environ is
  jrt's over Host.Environ."
  (vec (sort
         (concat
           (map #(str "src/java.base/share/classes/java/lang/" % ".java")
                ["Process" "ProcessBuilder" "ProcessHandle" "ProcessHandleImpl"])
           (map #(str "src/java.base/unix/classes/java/lang/" % ".java")
                ["ProcessImpl" "ProcessEnvironment"])))))

;; The small members (doc/classes/JAVA-DEFERRED-TRIAGE.md, F16, JCS96 (c), "As built: F16
;; (write-ahead)"): jdk26u's classes behind JCS96's batch of small members: Timer, Scanner,
;; PropertyResourceBundle, RandomGeneratorFactory with its generators, java.sql's Time and
;; javax.sql.rowset.serial's SerialBlob and SerialClob, the MIME table. jrt's own beside them
;; (overlay/jdk/java.base): the field updaters (java.util.concurrent.atomic's three
;; Atomic*FieldUpdater, jdk26u's over jdk.internal.jrt.FieldUpdaters' reflection instead of Unsafe's
;; offsets) and java.sql.DriverManager's log writer; variants Timer and PropertyResourceBundle. The
;; members of jrt's hand-written classes the batch also names (Thread, ThreadGroup, Runtime.Version,
;; System's properties, String, StringBuffer, Math.pow) are Go, F16's day work, not here.
(def small-members-sources
  "The small members (F16, JCS96 (c)): paths relative to jdk26u."
  (vec (sort
         (concat
           ;; Readable (a cut class until F16: Scanner reads through it), TypeNotPresentException
           (map #(str "src/java.base/share/classes/java/lang/" % ".java")
                ["Readable" "TypeNotPresentException"])
           ;; java.sql's Time, Blob, Clob and SQLWarning, which javax.sql.rowset.serial needs, are
           ;; added-module-sources' since CDR4 (merged with batch 1, 2026-11-07), SQLException and
           ;; DriverManager jrt's overlays there (CDR4's DriverManager holds F16's log writer too)
           ;; Timer (variant: no Cleaner), TimerTask, Scanner (its channel constructors are
           ;; operation-level stubs until F8 and F7), PropertyResourceBundle (variant: the stream
           ;; decoded without a CharsetDecoder)
           (map #(str "src/java.base/share/classes/java/util/" % ".java")
                ["PropertyResourceBundle" "Scanner" "Timer" "TimerTask"])
           ;; RandomGeneratorFactory, which constructs jdk26u's algorithms from a static table (no
           ;; ServiceLoader)
           (map #(str "src/java.base/share/classes/java/util/random/" % ".java")
                ["RandomGeneratorFactory"])
           ;; SerialBlob, SerialClob (KIND share:java.sql.rowset); their serialization members
           ;; jdk26u's since serialization came into the world (JCS167; stubs before)
           (map #(str "src/java.sql.rowset/share/classes/javax/sql/rowset/serial/" % ".java")
                ["SerialBlob" "SerialClob" "SerialException"])
           ;; the LXM, Xoroshiro and Xoshiro generators RandomGeneratorFactory constructs
           (map #(str "src/java.base/share/classes/jdk/internal/random/" % ".java")
                ["L128X1024MixRandom" "L128X128MixRandom" "L128X256MixRandom" "L32X64MixRandom"
                 "L64X1024MixRandom" "L64X128MixRandom" "L64X128StarStarRandom" "L64X256MixRandom"
                 "Xoroshiro128PlusPlus" "Xoshiro256PlusPlus"])
           ;; the MIME table URLConnection's file name map reads (the image's
           ;; content-types.properties as resource data, bin/jrt-convert's data step)
           (map #(str "src/java.base/share/classes/sun/net/www/" % ".java")
                ["MimeEntry" "MimeTable"])))))

;; Annotations at run time (doc/classes/JAVA-DEFERRED-TRIAGE.md, F14, "As built: F14 (first slice,
;; write-ahead)"): java.lang.annotation's types and exceptions, and java.lang's three RUNTIME
;; annotation types, so that j2g records them (arbace.classes.annot) and translates them with their
;; Go annotation objects (arbace.j2g.decls/annotation-impl-forms). java.lang.annotation.Annotation
;; and java.lang.reflect.AnnotatedElement are jrt's hand-written interfaces (annotation.ae), as Class
;; and Method are, not jdk26u's files.
(def annotation-sources
  "The annotation types and exceptions (F14): paths relative to jdk26u."
  (vec (sort

                 "SSLEngineResult" "SSLException" "SSLHandshakeException" "SSLKeyException"
                 "SSLParameters" "SSLPeerUnverifiedException" "SSLPermission" "SSLProtocolException"
                 "SSLServerSocket" "SSLServerSocketFactory" "SSLSession" "SSLSessionBindingEvent"
                 "SSLSessionBindingListener" "SSLSessionContext" "SSLSocket" "SSLSocketFactory"
                 "StandardConstants" "TrustManager" "TrustManagerFactory" "TrustManagerFactorySpi"
                 "X509ExtendedKeyManager" "X509ExtendedTrustManager" "X509KeyManager" "X509TrustManager"])
           (map #(str "src/java.base/share/classes/javax/security/cert/" % ".java")
                ["Certificate" "CertificateEncodingException" "CertificateException"
                 "CertificateExpiredException" "CertificateNotYetValidException"
                 "CertificateParsingException" "X509Certificate"])
           (map #(str "src/java.base/share/classes/jdk/internal/access/" % ".java")
                ["JavaNetInetAddressAccess"])
           (map #(str "src/java.base/share/classes/jdk/internal/event/" % ".java")
                ["TLSHandshakeEvent"])
           (map #(str "src/java.base/share/classes/jdk/internal/icu/impl/" % ".java")
                ["CharTrie" "Punycode" "StringPrepDataReader" "Trie"])
           (map #(str "src/java.base/share/classes/jdk/internal/icu/lang/" % ".java")
                ["UCharacterDirection" "UCharacterEnums"])
           (map #(str "src/java.base/share/classes/jdk/internal/icu/text/" % ".java")

                ["ByteArrays" "LegacyAlgorithmConstraints"])))))

(def http-sources
  "URL and HTTP's classes in the Go build (doc/classes/JAVA-DEFERRED-TRIAGE.md, F12, \"As built: F12
  (write-ahead)\"): paths relative to jdk26u. java.net's proxies (Proxy, ProxySelector with
  sun.net.spi.DefaultProxySelector, the SOCKS and HTTP-tunnel socket impls over DelegatingSocketImpl),
  URLEncoder, the cookies (HttpCookie, CookieHandler, CookieManager, the in-memory store), Authenticator,
  the response cache's interfaces, HttpURLConnection with jdk26u's implementation of the http: and https:
  handlers' connections (sun.net.www.protocol.http and https, sun.net.www.http's client, keep-alive cache
  and chunked streams), the ftp: and mailto: handlers with their clients (sun.net.ftp, sun.net.smtp),
  javax.net.ssl.HttpsURLConnection (F3 left it out). Over F3's TLS (https:) and jrt's sockets. jrt's own
  beside them (overlay/jdk): sun.util.logging.PlatformLogger (a java.util.logging bridge, JCS155 (b)),
  jdk.internal.misc.InnocuousThread; the variants ProxySelector.ae, DefaultProxySelector.ae,
  NetProperties.ae (conf/net.properties, bin/jrt-convert's data step), HttpCookieAccess.ae and
  HttpURLConnectionCookies.ae (the cookie access in jdk.internal.jrt.NetAccess, no SharedSecrets),
  HttpConnectSocketImpl.ae (no reflection), URL.ae's handlers + ftp, mailto, Socket.ae's createImpl
  jdk26u's again (the SOCKS wrapper ProxySelector reaches), ServerSocket.ae's implAccept jdk26u's."
  (vec (sort
         (concat
           (map #(str "src/java.base/share/classes/java/net/" % ".java")
                ["Authenticator" "CacheRequest" "CacheResponse" "ContentHandlerFactory" "CookieHandler"
                 "CookieManager" "CookiePolicy" "CookieStore" "DelegatingSocketImpl" "HttpConnectSocketImpl"
                 "HttpCookie" "HttpRetryException" "HttpURLConnection" "InMemoryCookieStore"
                 "PasswordAuthentication" "ProtocolException" "Proxy" "ProxySelector" "ResponseCache"
                 "SecureCacheResponse" "SocksConsts" "SocksSocketImpl" "URLEncoder"])
           (map #(str "src/java.base/share/classes/javax/net/ssl/" % ".java")
                ["HttpsURLConnection"])
           (map #(str "src/java.base/share/classes/jdk/internal/access/" % ".java")
                ["JavaNetHttpCookieAccess"])
           (map #(str "src/java.base/share/classes/jdk/internal/util/" % ".java")
                ["ImmutableBitSetPredicate"])
           (map #(str "src/java.base/share/classes/sun/net/" % ".java")
                ["ApplicationProxy" "NetProperties" "NetworkClient" "SocksProxy" "TelnetInputStream"
                 "TelnetOutputStream" "TelnetProtocolException" "TransferProtocolClient"])
           (map #(str "src/java.base/share/classes/sun/net/ftp/" % ".java")
                ["FtpClient" "FtpClientProvider" "FtpDirEntry" "FtpDirParser" "FtpLoginException"
                 "FtpProtocolException" "FtpReplyCode"])
           (map #(str "src/java.base/share/classes/sun/net/ftp/impl/" % ".java")
                ["DefaultFtpClientProvider" "FtpClient"])
           (map #(str "src/java.base/share/classes/sun/net/smtp/" % ".java")
                ["SmtpClient" "SmtpProtocolException"])
           (map #(str "src/java.base/share/classes/sun/net/spi/" % ".java")
                ["DefaultProxySelector"])
           (map #(str "src/java.base/share/classes/sun/net/util/" % ".java")
                ["ProxyUtil"])
           (map #(str "src/java.base/share/classes/sun/net/www/" % ".java")
                ["HeaderParser" "MeteredStream"])
           (map #(str "src/java.base/share/classes/sun/net/www/http/" % ".java")
                ["ChunkedInputStream" "ChunkedOutputStream" "HttpCapture" "HttpCaptureInputStream"
                 "HttpCaptureOutputStream" "HttpClient" "Hurryable" "KeepAliveCache" "KeepAliveCleanerEntry"
                 "KeepAliveStream" "KeepAliveStreamCleaner" "PosterOutputStream"])
           (map #(str "src/java.base/share/classes/sun/net/www/protocol/ftp/" % ".java")
                ["FtpURLConnection" "Handler"])
           (map #(str "src/java.base/share/classes/sun/net/www/protocol/http/" % ".java")
                ["AuthCache" "AuthCacheImpl" "AuthCacheValue" "AuthScheme" "AuthenticationHeader"
                 "AuthenticationInfo" "BasicAuthentication" "DigestAuthentication" "HttpCallerInfo"
                 "HttpURLConnection" "NTLMAuthenticationProxy" "NegotiateAuthentication" "Negotiator"])
           (map #(str "src/java.base/share/classes/sun/net/www/protocol/https/" % ".java")
                ["AbstractDelegateHttpsURLConnection" "DelegateHttpsURLConnection" "HttpsClient"
                 "HttpsURLConnectionImpl"])
           (map #(str "src/java.base/share/classes/sun/net/www/protocol/mailto/" % ".java")
                ["Handler" "MailToURLConnection"])))))

(def httpserver-sources
  "jdk.httpserver in the Go build (doc/classes/JAVA-DEFERRED-TRIAGE.md, F24, \"As built: F24 (write-ahead)\"):
  paths relative to jdk26u, files of src/jdk.httpserver/share/classes translated as java.base's
  (added-module-sources' way): com.sun.net.httpserver's API and its provider interface, sun.net.httpserver's
  server over F10a's selectors and server socket channels (HTTPS over F3's SSLEngine), the dispatcher and
  the idle and request timers over F16's java.util.Timer. jrt's own beside them (overlay/jdk): ServerImpl,
  ExchangeImpl, HttpConnection, HttpContextImpl and ServerConfig derived from jdk26u's by test/jrt/derive.ae
  (System.Logger as jdk.internal.jrt.SystemLoggers.Logger, JCS155), jdk.internal.jrt.SystemLoggers; the
  variant HttpServerProvider.ae (no ServiceLoader). Not here: the simple file server (SimpleFileServer,
  sun.net.httpserver.simpleserver: jwebserver's, one KIND unix file; JCS252)."
  (vec (sort
         (concat
           (map #(str "src/jdk.httpserver/share/classes/com/sun/net/httpserver/" % ".java")
                ["Authenticator" "BasicAuthenticator" "Filter" "Headers" "HttpContext" "HttpExchange" "HttpHandler"

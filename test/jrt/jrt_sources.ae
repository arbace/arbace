(ns jrt.jrt-sources
  "jrt's translated input (B1a step 3, doc/go/JRT-SOURCES.md): the Java source files of the
  translation closure measured by bin/java-surface (doc/go/java-surface.edn, :closure :repl
  :sources), converted by repr/java into Java forms. Run by bin/jrt-convert, which also generates
  the JDK build's generated sources, converts and compares; this namespace holds the
  parts written in Clojure:

  - `sources`: the closure's source files, as paths relative to jdk26u;
  - the locales: jdk.localedata's CLDR bundles of a selection, and jrt's index of them;
  - `report`: the counts of a run: the conversion, the forms compared with the committed ones,
    javac's classes, and the edge's tables (jrt.jrt-edge's edge.edn).

  It runs on the tools' host (bin/lib/tools.bash's arbace_tool) since JN6
  (doc/classes/JAVA-FRONTEND-SURVEY.md, \"As built: JN6\"); the edge, which reads javac's class
  files with the JDK's class file API, is jrt.jrt-edge, on the frozen JVM. Outputs are
  deterministic: sorted, without times."
  (:require [arbace.java.io :as io]
            [arbace.string :as str]
            [arbace.pprint :as pp])
  (:import (java.io File)
           (java.nio.file Files)))

(defn- read-data [f] (binding [*read-eval* false] (read-string (slurp f))))

;; ---------------------------------------------------------------------------------------
;; the closure's sources

(def time-sources
  "java.time in the Go build (the user's decision of 2026-10-10; doc/go/JRT-NOTES.md, \"Time\"):
  paths below src/java.base/share/classes. java.time, java.time.temporal, java.time.format and
  java.time.zone whole (with their serialization proxies, the Ser classes: java.time.zone's, whose
  read methods load tzdb.dat, and since serialization's slice 4 java.time's and java.time.chrono's,
  doc/classes/JAVA-DEFERRED-TRIAGE.md, \"As built: serialization slice 4\"; chrono's cases of the cut
  chronologies operation-level stubs) but ZoneName (generated from CLDR's metazones; zone names
  are jrt's: overlay TimeZoneNameUtility); java.time.chrono with the ISO chronology only (the
  Hijrah, Japanese, Minguo and Thai Buddhist chronologies are cut: AbstractChronology's
  variant registers IsoChronology alone). With them what they use outside the closure:
  DateTimeHelper (the toString of the local types), ParsePosition (DateTimeFormatter's
  parse), DataInput (TzdbZoneRulesProvider and the zone rules' Ser read through it) and the
  exceptions of a corrupt time-zone database; and
  java.util.TimeZone's family (below)."
  (vec (concat
         (map #(str "java/time/" % ".java")
              ["Clock" "DayOfWeek" "Duration" "InstantSource" "LocalDate" "LocalDateTime"
               "LocalTime" "Month" "MonthDay" "OffsetDateTime" "OffsetTime" "Period" "Ser" "Year"
               "YearMonth" "ZoneId" "ZoneOffset" "ZoneRegion" "ZonedDateTime"])
         (map #(str "java/time/chrono/" % ".java")
              ["AbstractChronology" "ChronoLocalDate" "ChronoLocalDateImpl" "ChronoLocalDateTime"
               "ChronoLocalDateTimeImpl" "ChronoPeriod" "ChronoPeriodImpl" "ChronoZonedDateTime"
               "ChronoZonedDateTimeImpl" "Chronology" "Era" "IsoChronology" "IsoEra" "Ser"])
         (map #(str "java/time/format/" % ".java")
              ["DateTimeFormatter" "DateTimeFormatterBuilder" "DateTimeParseContext"
               "DateTimeParseException" "DateTimePrintContext" "DateTimeTextProvider" "DecimalStyle"
               "FormatStyle" "Parsed" "ResolverStyle" "SignStyle" "TextStyle"])
         (map #(str "java/time/temporal/" % ".java")
              ["ChronoField" "ChronoUnit" "IsoFields" "JulianFields" "Temporal" "TemporalAccessor"
               "TemporalAdjuster" "TemporalAdjusters" "TemporalAmount" "TemporalField"
               "TemporalQueries" "TemporalQuery" "TemporalUnit" "UnsupportedTemporalTypeException"
               "ValueRange" "WeekFields"])
         (map #(str "java/time/zone/" % ".java")
              ["Ser" "TzdbZoneRulesProvider" "ZoneOffsetTransition" "ZoneOffsetTransitionRule"
               "ZoneRules" "ZoneRulesException" "ZoneRulesProvider"])
         ["jdk/internal/util/DateTimeHelper.java" "java/text/ParsePosition.java"
          "java/io/DataInput.java" "java/io/StreamCorruptedException.java"
          "java/io/InvalidObjectException.java"]
         ;; java.util.TimeZone, jdk26u's own since the time-zone database is in the Go build
         ;; (replacing jrt's fixed-offset TimeZone and ZoneInfo): SimpleTimeZone, ZoneInfo
         ;; and ZoneInfoFile (which reads tzdb.dat too) and the sun.util.calendar classes they
         ;; compute with; CRC32 (ZoneInfo's checksum; its natives are jrt's over Go's
         ;; hash/crc32)
         (map #(str "java/util/" % ".java") ["TimeZone" "SimpleTimeZone" "zip/CRC32" "zip/Checksum"])
         ;; the bundles of java.base's CLDR locale data (added-gensrc) and what they extend;
         ;; jrt's own ResourceBundle and locale providers (overlay/jdk) read them
         ["java/util/ListResourceBundle.java" "java/util/MissingResourceException.java"
          "sun/util/ResourceBundleEnumeration.java" "sun/util/resources/OpenListResourceBundle.java"
          "sun/util/resources/TimeZoneNamesBundle.java" "sun/util/locale/provider/LocaleDataMetaInfo.java"
          ;; the service provider class of java.time's localized patterns, which jrt's
          ;; JavaTimeDateTimePatternImpl extends
          "java/util/spi/LocaleServiceProvider.java" "sun/text/spi/JavaTimeDateTimePatternProvider.java"]
         (map #(str "sun/util/calendar/" % ".java")
              ["ZoneInfo" "ZoneInfoFile" "AbstractCalendar" "BaseCalendar" "CalendarDate"
               "CalendarSystem" "CalendarUtils" "Era" "Gregorian" "JulianCalendar"
               "ImmutableGregorianDate"]))))

(def text-sources
  "java.text and the locales in the Go build (the user's decision of 2026-10-10;
  doc/go/JRT-NOTES.md, \"Text and locales\"): paths below src/java.base/share/classes.
  java.text's formats, symbols, field positions, MessageFormat, ChoiceFormat, ListFormat,
  Collator (RuleBasedCollator and its tables), BreakIterator and Bidi, with their service
  provider interfaces and jdk26u's provider implementations, which jrt's own
  LocaleProviderAdapter hands out (overlay/jdk); java.util.Currency (its currency.data is
  resource data); and jdk26u's java.util.Locale in place of jrt's hand-written one, with
  sun.util.locale (language tags, extensions, the locale builder and matcher),
  LocaleISOData, StaticProperty (the default locale's properties), the referenced-key caches
  and LazyConstant, which Locale, BaseLocale and the bundles compute their constants with."
  (vec (concat
         (map #(str "java/text/" % ".java")
              ["Annotation" "AttributedCharacterIterator" "AttributedString" "Bidi" "BreakIterator"
               "CalendarBuilder" "CharacterIteratorFieldDelegate" "ChoiceFormat"
               "CollationElementIterator" "CollationKey" "Collator" "CompactNumberFormat" "DateFormat"
               "DateFormatSymbols" "DecimalFormat" "DecimalFormatSymbols" "DigitList"
               "DontCareFieldPosition" "EntryPair" "FieldPosition" "Format" "ListFormat"
               "MergeCollation" "MessageFormat" "NumberFormat" "ParseException" "PatternEntry"
               "RBCollationTables" "RBTableBuilder" "RuleBasedCollationKey" "RuleBasedCollator"
               "SimpleDateFormat" "StringBufFactory" "StringCharacterIterator"])
         (map #(str "java/text/spi/" % ".java")
              ["BreakIteratorProvider" "CollatorProvider" "DateFormatProvider"
               "DateFormatSymbolsProvider" "DecimalFormatSymbolsProvider" "NumberFormatProvider"])
         ;; the collator's and the break iterators' machinery, their JRE data (the root
         ;; collation rules; the break iterators' rule data, which bin/jrt-convert generates as
         ;; the JDK build does)
         (map #(str "sun/text/" % ".java")
              ["CollatorUtilities" "ComposedCharIter" "IntHashtable" "UCompactIntArray"
               "RuleBasedBreakIterator" "SupplementaryCharacterData" "CompactByteArray"
               "resources/BreakIteratorInfo" "resources/BreakIteratorResources"
               "resources/CollationData"])
         ["sun/util/resources/BreakIteratorResourceBundle.java"]
         ;; Bidi: ICU's bidirectional algorithm and its properties (ubidi.icu, resource data)
         (map #(str "jdk/internal/icu/" % ".java")
              ["text/BidiBase" "text/BidiLine" "text/BidiRun" "impl/UBiDiProps"])
         ;; jdk26u's provider implementations, over jrt's LocaleProviderAdapter and
         ;; LocaleResources
         (map #(str "sun/util/locale/provider/" % ".java")
              ["AvailableLanguageTags" "BreakIteratorProviderImpl" "CollationRules"
               "CollatorProviderImpl" "CurrencyNameProviderImpl" "DateFormatProviderImpl"
               "DateFormatSymbolsProviderImpl" "DecimalFormatSymbolsProviderImpl"
               "LocaleNameProviderImpl" "NumberFormatProviderImpl" "JRELocaleConstants"
               ;; the pool of a provider class (jdk26u's, over jrt's one adapter)
               "LocaleServiceProviderPool"])
         ["java/util/Currency.java"]
         ;; the service provider interfaces the pool names
         (map #(str "java/util/spi/" % ".java")
              ["CurrencyNameProvider" "LocaleNameProvider" "TimeZoneNameProvider"
               "CalendarDataProvider" "CalendarNameProvider"])
         ;; java.util.Locale (jrt's hand-written Locale becomes a stand-in for jrt's own build)
         ["java/util/Locale.java" "java/util/LocaleISOData.java"]
         (map #(str "sun/util/locale/" % ".java")
              ["BaseLocale" "Extension" "InternalLocaleBuilder" "LanguageTag" "LocaleExtensions"
               "LocaleMatcher" "LocaleSyntaxException" "LocaleUtils" "StringTokenIterator"
               "UnicodeLocaleExtension"])
         (map #(str "jdk/internal/util/" % ".java")
              ["StaticProperty" "ReferencedKeyMap" "ReferencedKeySet" "ReferenceKey"
               "StrongReferenceKey" "WeakReferenceKey" "SoftReferenceKey"])
         ["java/lang/LazyConstant.java" "jdk/internal/lang/LazyConstantImpl.java"]
         ;; the class data sharing queries BaseLocale and the caches make (natives jrt's: no archive)
         ["jdk/internal/misc/CDS.java"]
         ;; CompactNumberFormat's pattern parsing
         ["java/util/regex/MatchResult.java"])))

(def text-locales
  "The locales of jdk.localedata's CLDR data in the Go build with JRT_LOCALES=common
  (doc/go/JRT-NOTES.md, \"Text and locales\"), as language tags: the languages
  with the most speakers and users of the JDK's locale constants, and the regions the JDK's
  constants and the commonest English, French, German, Spanish, Portuguese and Chinese
  variants name. Each takes its CLDR bundles and those of its parent locales (en-GB takes
  en-001's, es-MX es-419's, zh-TW zh-Hant's). java.base's own root and English data are
  always in. JRT_LOCALES unset or none (the default, the user's decision of 2026-10-11: the
  shipped executables and the freeze carry java.base's root and English data alone) takes
  none; all every locale CLDRConverter writes for jdk.localedata; a comma-separated list of
  tags those."
  ["ar" "de" "es" "fr" "hi" "id" "it" "ja" "ko" "nl" "pl" "pt" "ru" "sv" "tr" "uk" "zh"
   "en-GB" "en-CA" "en-AU" "en-IN" "fr-CA" "de-CH" "es-MX" "pt-PT" "zh-TW" "ar-EG"])

(def ^:private cldr-kinds
  "jdk.localedata's CLDR bundle kinds, with the directory of their generated files."
  [["FormatData" "sun/text/resources/cldr/ext"] ["TimeZoneNames" "sun/util/resources/cldr/ext"]
   ["CurrencyNames" "sun/util/resources/cldr/ext"] ["LocaleNames" "sun/util/resources/cldr/ext"]])

(defn- parse-tag
  "[language script region variant] of a BCP 47 language tag (the part these tags use)."
  [^String tag]
  (let [ps (str/split tag #"[-_]")
        lang (str/lower-case (first ps))
        more (rest ps)
        [script more] (if (and (seq more) (re-matches #"[A-Za-z]{4}" (first more)))
                        [(str (str/upper-case (subs (first more) 0 1)) (str/lower-case (subs (first more) 1))) (rest more)]
                        ["" more])
        [region more] (if (and (seq more) (re-matches #"[A-Za-z]{2}|[0-9]{3}" (first more)))
                        [(str/upper-case (first more)) (rest more)]
                        ["" more])]
    [(if (= lang "und") "" lang) script region (str/join "_" more)]))

(defn- loc-name
  "The bundle suffix of [language script region variant]: \"zh_Hant_TW\", \"\" for the root locale."
  [[l s r v]]
  (str/join "_" (remove empty? [l s r v])))

(defn- loc-tag [[l s r v]]
  (if (every? empty? [l s r v]) "und" (str/join "-" (remove empty? [l s r v]))))

(defn- default-list
  "ResourceBundle.Control's default candidate list (jdk26u's getDefaultList, with its Chinese
  script and region supplied), as [l s r v] vectors, the root locale last."
  [[l s r v]]
  (let [s (if (and (= l "zh") (empty? s) (seq r))
            (case r ("TW" "HK" "MO") "Hant" ("CN" "SG") "Hans" s)
            s)
        variants (when (seq v)
                   (loop [acc [] idx (count v)]
                     (if (= idx -1) acc
                       (recur (conj acc (subs v 0 idx)) (.lastIndexOf ^String v "_" (int (dec idx)))))))
        r2 (if (and (= l "zh") (seq s) (empty? r)) (case s "Hans" "CN" "Hant" "TW" r) r)]
    (vec (concat (for [vv variants] [l s r vv])
                 (when (seq r) [[l s r ""]])
                 (when (seq s)
                   (concat [[l s "" ""]]
                           (for [vv variants] [l "" r2 vv])
                           (when (seq r2) [[l "" r2 ""]])))
                 (when (seq l) [[l "" "" ""]])
                 [["" "" "" ""]]))))

(defn- cldr-candidates
  "The CLDR adapter's candidate locales of a locale (CLDRLocaleProviderAdapter.getCandidateLocales:
  the default list with CLDR's parent locales applied), given parents, a map from a language
  tag to its parent's [l s r v]."
  [parents loc]
  (let [cands (default-list loc)]
    (loop [i 0]
      (if (>= i (dec (count cands)))
        cands
        (let [c (nth cands i)
              p (get parents (loc-tag c))]
          (if (and p (not= (nth cands (inc i)) p))
            (vec (concat (subvec cands 0 (inc i))
                         (if (= p ["" "" "" ""]) [p] (cldr-candidates parents p))))
            (recur (inc i))))))))

(defn- parent-locales
  "CLDR's parent locales from the generated CLDRBaseLocaleDataMetaInfo.java: child tag ->
  parent [l s r v]."
  [meta-file]
  (let [text (slurp meta-file)]
    (into {}
          (for [[_ _ ptag children] (re-seq #"parentLocalesMap\.put\((Locale\.ROOT|Locale\.forLanguageTag\(\"([^\"]*)\"\)),\s*new String\[\] \{([^}]*)\}" text)
                :let [p (if ptag (parse-tag ptag) ["" "" "" ""])]
                child (re-seq #"\"([^\"]+)\"" children)]
            [(second child) p]))))

(defn locale-data-files
  "The generated bundle files of jdk.localedata's CLDR data to translate, relative to the
  converter's output directory ld, for the locale selection spec (\"default\", \"all\",
  \"none\", or comma-separated tags): each locale's candidate locales' existing bundles,
  sorted."
  [spec ld base-meta]
  (let [exists? (fn [rel] (.isFile (io/file ld rel)))
        all (sort (for [dir (distinct (map second cldr-kinds)) :let [d (io/file ld dir)] :when (.isDirectory d)
                        f (.listFiles d) :when (str/ends-with? (.getName ^File f) ".java")]
                    (str dir "/" (.getName ^File f))))]
    (case (if (str/blank? spec) "none" spec)
      "all" (vec (distinct all))
      "none" []
      (let [tags (if (= spec "common") text-locales (str/split spec #","))
            parents (parent-locales base-meta)]
        (vec (sort (distinct
                     (for [t tags
                           c (cldr-candidates parents (parse-tag (str/trim t)))
                           :let [n (loc-name c)] :when (seq n)
                           [kind dir] cldr-kinds
                           :let [rel (str dir "/" kind "_" n ".java")] :when (exists? rel)]
                       rel))))))))

(defn collation-files
  "The JRE collation data of jdk.localedata (src/jdk.localedata/share/classes/sun/text/resources/
  ext/CollationData_X.java, hand-written) for the selected locales: those of each locale's
  default candidate list (the JRE adapter's), paths relative to jdk26u."
  [spec jdk]
  (let [dir "src/jdk.localedata/share/classes/sun/text/resources/ext"
        exists? (fn [rel] (.isFile (io/file jdk rel)))]
    (case (if (str/blank? spec) "none" spec)
      "none" []
      "all" (vec (sort (for [f (.listFiles (io/file jdk dir)) :let [n (.getName ^File f)]
                             :when (re-matches #"CollationData_.*\.java" n)]
                         (str dir "/" n))))
      (let [tags (if (= spec "common") text-locales (str/split spec #","))]
        (vec (sort (distinct (for [t tags c (default-list (parse-tag (str/trim t)))
                                   :let [n (loc-name c) rel (str dir "/CollationData_" n ".java")]
                                   :when (and (seq n) (exists? rel))]
                               rel))))))))

(defn- bundle-key
  "The index key of a generated bundle file (\"FormatData_fr\") and its class."
  [rel]
  (let [cls (str/replace (subs rel 0 (- (count rel) 5)) "/" ".")]
    [(subs cls (inc (.lastIndexOf ^String cls "."))) cls]))

(defn- tag-available?
  "Whether every bundle of a language tag's candidate locales that the converter wrote is in."
  [parents ld included tag]
  (every? (fn [rel] (or (not (.isFile (io/file ld rel))) (included rel)))
          (for [c (cldr-candidates parents (parse-tag tag))
                :let [n (loc-name c)] :when (seq n)
                [kind dir] cldr-kinds]
            (str dir "/" kind "_" n ".java"))))

(defn write-locale-data
  "Writes jrt's generated jdk.internal.jrt.LocaleDataIndex (doc/go/JRT-NOTES.md, \"Text and
  locales\") to out: the language tags of jdk.localedata's CLDR locales whose bundles are all
  in the Go build (of the JDK's CLDRLocaleDataMetaInfo, ld's), and a factory of the bundles by
  name (files: the generated bundles' paths below ld; collation: the JRE collation data's
  paths). Deterministic."
  [ld base-meta files collation out]
  (let [included (set files)
        parents (parent-locales base-meta)
        meta (slurp (io/file ld "sun/util/resources/cldr/provider/CLDRLocaleDataMetaInfo.java"))
        all-tags (str/split (str/trim (second (re-find #"return \"([^\"]*)\";" meta))) #" ")
        tags (filter #(tag-available? parents ld included %) all-tags)
        entries (sort (concat (map bundle-key files)
                              (for [rel collation :let [n (.getName (io/file rel))
                                                        s (subs n 0 (- (count n) 5))]]
                                [(str "jre:" s) (str "sun.text.resources.ext." s)])))
        chunks (partition-all 250 entries)]
    (spit out
          (str "/*\n * Generated by bin/jrt-convert (test/jrt/jrt_sources.ae, write-locale-data); do not edit.\n"
               " * jrt's index of the locale data in the Go build (doc/go/JRT-NOTES.md, \"Text and locales\").\n"
               " */\n"
               "package jdk.internal.jrt;\n\n"
               "import java.util.ResourceBundle;\n\n"
               "/**\n * The locale data of jdk.localedata in the Go build: the CLDR bundles bin/jrt-convert\n"
               " * generated for the selected locales, and the JRE collation data of those locales.\n */\n"
               "public final class LocaleDataIndex {\n"
               "    /** The language tags whose CLDR bundles are all in (CLDRLocaleDataMetaInfo's, filtered). */\n"
               "    public static final String TAGS = \" " (str/join " " tags) "\";\n\n"
               "    private LocaleDataIndex() {\n    }\n\n"
               "    /** A new bundle of the name (\"FormatData_fr\", \"jre:CollationData_fr\"), or null. */\n"
               "    public static ResourceBundle bundle(String name) {\n"
               "        ResourceBundle b;\n"
               (apply str (for [i (range (count chunks))]
                            (str "        if ((b = bundle" i "(name)) != null) {\n            return b;\n        }\n")))
               "        return null;\n"
               "    }\n"
               ;; in chunks of 250 cases: a class file method's code is at most 64 KB
               (apply str (for [[i chunk] (map-indexed vector chunks)]
                            (str "\n    private static ResourceBundle bundle" i "(String name) {\n"
                                 "        switch (name) {\n"
                                 (apply str (for [[k cls] chunk]
                                              (str "            case \"" k "\": return new " cls "();\n")))
                                 "            default: return null;\n"
                                 "        }\n"
                                 "    }\n")))
               "}\n"))))

(defn expand-locales
  "bin/jrt-convert's generate step: rewrites sources-txt with its KIND locales line expanded
  (kept, then followed by the selection's lines): the generated bundles of jdk.localedata
  (gensrc:jdk.localedata, files of the converter's output ld), the JRE collation data
  (share:jdk.localedata, of jdk's src/jdk.localedata) and jrt's index (jrtgen
  jdk/internal/jrt/LocaleDataIndex.java, written to index-out). base-meta is the java.base
  converter's CLDRBaseLocaleDataMetaInfo.java (CLDR's parent locales)."
  [sources-txt ld base-meta jdk index-out]
  (let [lines (str/split-lines (slurp sources-txt))
        expanded? #(re-find #" (gensrc:jdk\.localedata|share:jdk\.localedata|jrtgen) " (str % " "))
        lines (remove expanded? lines)
        spec (some #(second (re-find #"^java\.base locales (.*)$" %)) lines)
        files (locale-data-files spec ld base-meta)
        coll (collation-files spec jdk)
        prefix "src/jdk.localedata/share/classes/"
        coll-rel (map #(subs % (count prefix)) coll)]
    (io/make-parents index-out)
    (write-locale-data ld base-meta files coll-rel index-out)
    (spit sources-txt
          (str (str/join "\n" (concat lines
                                      (map #(str "java.base gensrc:jdk.localedata " %) files)
                                      (map #(str "java.base share:jdk.localedata " %) coll-rel)
                                      ["java.base jrtgen jdk/internal/jrt/LocaleDataIndex.java"]))
               "\n"))
    (println (count files) "jdk.localedata bundles," (count coll-rel) "collation data files for locales" (or spec "none"))))

(def added-sources
  "Files of src/java.base/share/classes added to the measured closure (B1a step 4, phase 2C,
  doc/go/JRT-NOTES.md \"Phase 2C\"): plain Java that jrt had as stand-ins (J2G-SPEC §4.3) or
  that the standard streams need, translated by j2g like the rest of the closure."
  (vec (sort
         (concat
           ;; the 26 stand-ins of jrt whose classes the measured closure did not hold: exceptions
           ;; and interfaces with nothing but constructors, fields and declarations
           (map #(str "java/" % ".java")
                ["io/Serializable" "io/UnsupportedEncodingException"
                 "lang/AbstractMethodError" "lang/ArrayStoreException" "lang/CloneNotSupportedException"
                 "lang/Cloneable" "lang/IllegalAccessException" "lang/IllegalMonitorStateException"
                 "lang/IllegalThreadStateException" "lang/InstantiationException" "lang/InterruptedException"
                 "lang/NegativeArraySizeException" "lang/NoClassDefFoundError" "lang/NoSuchFieldException"
                 "lang/NoSuchMethodException" "lang/Runnable" "lang/StackOverflowError"
                 "lang/reflect/InvocationTargetException" "lang/reflect/Type"
                 "nio/charset/IllegalCharsetNameException" "nio/charset/UnsupportedCharsetException"
                 "util/concurrent/CancellationException" "util/concurrent/ExecutionException"
                 "util/concurrent/RejectedExecutionException" "util/concurrent/TimeoutException"
                 "util/function/Supplier"])
           ;; the standard streams (System.out, err, in): PrintStream and the interfaces of the
           ;; closure's streams and writers
           (map #(str "java/" % ".java")
                ["io/PrintStream" "io/Closeable" "io/Flushable" "lang/AutoCloseable"])
           ;; BigInteger's modInverse and modPow with a negative exponent (the oracle's
           ;; BigNumbers script)
           ["java/math/SignedMutableBigInteger.java"]
           ;; B1a step 5, phase 2B (EVAL-NOTES.md): JDK 21's sequenced collections, which the
           ;; closure's List, Deque, SortedSet, SortedMap, LinkedHashSet and LinkedHashMap
           ;; implement (LinkedHashMap's views are SequencedSets), their reverse-order views and
           ;; SequencedMap's entry holder
           (map #(str "java/util/" % ".java")
                ["SequencedCollection" "SequencedSet" "SequencedMap" "ReverseOrderDequeView"
                 "ReverseOrderSortedSetView" "ReverseOrderSortedMapView"])
           ["jdk/internal/util/NullableKeyValueHolder.java"]
           ;; the JVM's error for compiled code's new of an abstract class, which the
           ;; evaluator's NewExpr throws as compiled code does (EVAL-NOTES.md, "The suite's
           ;; Java fixtures")
           ["java/lang/InstantiationError.java"]
           ;; the constant API's two interfaces, which String and the wrapper classes implement
           ;; (supers, bases and ancestors list them); their methods name classes outside the
           ;; world (Optional, MethodHandles.Lookup) and do not exist in Go
           (map #(str "java/lang/constant/" % ".java") ["Constable" "ConstantDesc"])
           ;; streams (String's lines, chars, codePoints; Collectors; core's stream-reduce!
           ;; and the like): java.util.stream whole, the functional interfaces, Optional and
           ;; its primitive kin, the summary statistics, StringJoiner, Spliterator,
           ;; PrimitiveIterator, and CountedCompleter, the parallel tasks' superclass (whose
           ;; ForkJoinTask internals are jrt's; parallel streams run on jrt's pool)
           (map #(str "java/util/stream/" % ".java")
                ["AbstractPipeline" "AbstractShortCircuitTask" "AbstractSpinedBuffer" "AbstractTask"
                 "BaseStream" "Collector" "Collectors" "DistinctOps" "DoublePipeline" "DoubleStream"
                 "FindOps" "ForEachOps" "Gatherer" "GathererOp" "Gatherers" "IntPipeline" "IntStream"
                 "LongPipeline" "LongStream" "MatchOps" "Node" "Nodes" "PipelineHelper" "ReduceOps"
                 "ReferencePipeline" "Sink" "SliceOps" "SortedOps" "SpinedBuffer" "Stream"
                 "StreamOpFlag" "StreamShape" "StreamSpliterators" "StreamSupport" "Streams"
                 "TerminalOp" "TerminalSink" "Tripwire" "WhileOps"])
           (map #(str "java/util/function/" % ".java")
                ["BiConsumer" "BiFunction" "BiPredicate" "BinaryOperator" "BooleanSupplier" "Consumer"
                 "DoubleBinaryOperator" "DoubleConsumer" "DoubleFunction" "DoublePredicate"
                 "DoubleSupplier" "DoubleToIntFunction" "DoubleToLongFunction" "DoubleUnaryOperator"
                 "Function" "IntBinaryOperator" "IntConsumer" "IntFunction" "IntPredicate" "IntSupplier"
                 "IntToDoubleFunction" "IntToLongFunction" "IntUnaryOperator" "LongBinaryOperator"
                 "LongConsumer" "LongFunction" "LongPredicate" "LongSupplier" "LongToDoubleFunction"
                 "LongToIntFunction" "LongUnaryOperator" "ObjDoubleConsumer" "ObjIntConsumer"
                 "ObjLongConsumer" "Predicate" "Supplier" "ToDoubleBiFunction" "ToDoubleFunction"
                 "ToIntBiFunction" "ToIntFunction" "ToLongBiFunction" "ToLongFunction" "UnaryOperator"])
           (map #(str "java/util/" % ".java")
                ["Optional" "OptionalInt" "OptionalLong" "OptionalDouble" "IntSummaryStatistics"
                 "LongSummaryStatistics" "DoubleSummaryStatistics" "StringJoiner" "Spliterator"
                 "PrimitiveIterator"])
           ["java/util/concurrent/CountedCompleter.java"
            ;; Collectors' concurrent collectors cast to it
            "java/util/concurrent/ConcurrentMap.java"
            ;; Collectors' characteristics sets
            "java/util/EnumSet.java" "java/util/RegularEnumSet.java" "java/util/JumboEnumSet.java"
            ;; StreamOpFlag's flag maps; the spliterators' debugging trip wire
            "java/util/EnumMap.java" "java/util/Tripwire.java"
            ;; the interface Random implements (Collections.shuffle takes one)
            "java/util/random/RandomGenerator.java"]
           ;; Clojure's test suite on the Go build (step 5 phase 2): uri? (java.net.URI's
           ;; parser), the delays' tests (CyclicBarrier, over jrt's ReentrantLock)
           ["java/net/URI.java" "java/net/URISyntaxException.java"
            "java/util/concurrent/CyclicBarrier.java" "java/util/concurrent/BrokenBarrierException.java"]
           ;; java.time.Instant for the REPL (#inst, Date.toInstant; JRT-NOTES.md, phase 2B
           ;; \"Dates\"): Instant and the exception it throws; the rest of java.time stays
           ;; outside the world (its uses in Instant are operation-level stubs, toString a
           ;; variant)
           ["java/time/Instant.java" "java/time/DateTimeException.java"]
           ;; sockets and the socket REPL (arbace.core.server; JRT-NOTES.md, "Sockets"): the plain
           ;; Java of java.net's sockets and addresses, over jrt's own HostSocketImpl
           ;; (overlay/jdk) in place of sun.nio.ch.NioSocketImpl; the name service through
           ;; Inet6AddressImpl's natives (variants over the host's). NetworkInterface, Proxy, the
           ;; SOCKS and HTTP-tunnel impls and the resolver SPI's providers stay outside the world
           (map #(str "java/net/" % ".java")
                ["ServerSocket" "Socket" "SocketImpl" "SocketImplFactory" "SocketAddress"
                 "InetSocketAddress" "InetAddress" "Inet4Address" "Inet6Address" "InetAddressImpl"
                 "Inet4AddressImpl" "Inet6AddressImpl" "SocketOptions" "SocketOption"
                 "StandardSocketOptions" "SocketException" "BindException" "ConnectException"
                 "NoRouteToHostException" "UnknownHostException" "SocketTimeoutException"
                 "spi/InetAddressResolver"])
           ;; (IPAddressUtil, Exceptions and Hashtable, which System.getProperties()'s Properties
           ;; extends, are file-sources')
           ["java/io/InterruptedIOException.java" "sun/net/PlatformSocketImpl.java"]
           ;; the regex flag CANON_EQ (JRT-NOTES.md, "The JDK's resource data"): java.text's
           ;; Normalizer over jdk.internal.icu's normalizer, whose loader reads ICU's nfc.nrm and
           ;; nfkc.nrm through java.nio's heap buffers (the buffers' generated files are
           ;; added-gensrc's); ScopedMemoryAccess's heap paths and the two foreign memory types
           ;; the buffers' constructors and accessors name
           (map #(str "java/text/" % ".java") ["Normalizer" "CharacterIterator"])
           (map #(str "jdk/internal/icu/" % ".java")
                ["text/NormalizerBase" "text/UTF16" "text/UCharacterIterator" "text/Replaceable"
                 "text/ReplaceableString" "impl/UCharacterProperty" "impl/CharacterIteratorWrapper"
                 "impl/ReplaceableUCharacterIterator" "impl/Trie2" "impl/Trie2_16"
                 "util/OutputInt"])
           (map #(str "java/nio/" % ".java")
                ["Buffer" "ByteOrder" "StringCharBuffer" "BufferUnderflowException" "BufferOverflowException"
                 "ReadOnlyBufferException" "InvalidMarkException"])
           ["java/lang/foreign/MemorySegment.java" "jdk/internal/foreign/MemorySessionImpl.java"]
           ;; \N{name} (CharacterName's uniName.dat is zlib-compressed: the overlay's
           ;; InflaterInputStream throws ZipException)
           ["java/util/zip/ZipException.java"]
           time-sources
           text-sources))))

(def added-gensrc
  "Files the JDK build generates (make/modules/java.base/gensrc/GensrcBuffer.gmk,
  GensrcScopedMemoryAccess.gmk) added to the closure, as paths below gensrc/java.base: the heap
  byte, char and int buffers and their views of a byte buffer in either byte order (ICU's data
  loader: JRT-NOTES.md, \"The JDK's resource data\"), since F7 every type's, read-only ones too
  (doc/classes/JAVA-DEFERRED-TRIAGE.md, \"As built: F7 (write-ahead)\"), and ScopedMemoryAccess, through which the
  buffers reach Unsafe. bin/jrt-convert generates them as the JDK build does."
  (vec (concat (map #(str "java/nio/" % ".java")
                    ["ByteBuffer" "CharBuffer" "IntBuffer" "HeapByteBuffer" "HeapCharBuffer"
                     "HeapIntBuffer" "ByteBufferAsCharBufferB" "ByteBufferAsCharBufferL"
                     "ByteBufferAsIntBufferB" "ByteBufferAsIntBufferL"])
               ;; F7 (doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: F7 (write-ahead)"): the long,
               ;; short, float and double buffers with their heap buffers and views of a byte buffer,
               ;; and every type's read-only heap buffer and views (the direct ones are jrt's own
               ;; DirectByteBuffer, overlay)
               (for [t ["Long" "Short" "Float" "Double"]
                     n ["" "Heap" "ByteBufferAs"]
                     s (if (= n "ByteBufferAs") ["B" "L"] [""])]
                 (str "java/nio/" n t "Buffer" s ".java"))
               (for [t ["Byte" "Char" "Int" "Long" "Short" "Float" "Double"]
                     s (if (= t "Byte") ["R"] ["R" "RB" "RL"])]
                 (if (= s "R")
                   (str "java/nio/Heap" t "BufferR.java")
                   (str "java/nio/ByteBufferAs" t "Buffer" s ".java")))
               ["jdk/internal/misc/ScopedMemoryAccess.java"]
               ;; java.time's locale data (JRT-NOTES.md, \"Time\"): java.base's CLDR bundles of
               ;; the root and English locales (GensrcCLDR's CLDRConverter), the metazones of
               ;; zone names (ZoneName) and the CLDR meta data (parent locales, canonical zone IDs)
               ["sun/text/resources/cldr/FormatData.java" "sun/text/resources/cldr/FormatData_en.java"
                "sun/util/resources/cldr/TimeZoneNames.java" "sun/util/resources/cldr/TimeZoneNames_en.java"
                "sun/util/resources/cldr/CalendarData.java" "sun/util/cldr/CLDRBaseLocaleDataMetaInfo.java"
                "java/time/format/ZoneName.java"]
               ;; java.text's (JRT-NOTES.md, \"Text and locales\"): java.base's CLDR currency and
               ;; locale names of the root and English locales
               ["sun/util/resources/cldr/CurrencyNames.java" "sun/util/resources/cldr/CurrencyNames_en.java"
                "sun/util/resources/cldr/LocaleNames.java" "sun/util/resources/cldr/LocaleNames_en.java"
                ;; Locale's language equivalences (filter, lookup), from the language subtag registry
                "sun/util/locale/LocaleEquivalentMaps.java"]
               ;; the JCA's (F1, jca-sources): the elliptic curves', Curve25519's, Curve448's and
               ;; their orders' field arithmetic, which make/modules/java.base/Gensrc.gmk generates
               ;; (TOOL_INTPOLY: build.tools.intpoly.FieldGen with its header.txt)
               (map #(str "sun/security/util/math/intpoly/" % ".java")
                    ["Curve25519OrderField" "Curve448OrderField" "IntegerPolynomial25519"
                     "IntegerPolynomial448" "IntegerPolynomialP256" "IntegerPolynomialP384"
                     "IntegerPolynomialP521" "P256OrderField" "P384OrderField" "P521OrderField"]))))

(def util-sources
  "Files of src/java.base/share/classes added for java.util's plain Java (doc/go/JAVA-BASE.md,
  amendment JB1; the user's decision of 2026-10-10): first the files whose absence made
  translated members throw (operation-level stubs), then the plain Java of java.util that
  Clojure users reach for. java.time and java.util.concurrent are other branches'."
  (vec (sort
         (concat
           ;; Arrays.sort of the primitive arrays (and its parallel sorts on jrt's pool),
           ;; parallelSort of objects, parallelPrefix
           (map #(str "java/util/" % ".java")
                ["DualPivotQuicksort" "ArraysParallelSortHelpers" "ArrayPrefixHelpers"
                 ;; Comparator.naturalOrder, nullsFirst, nullsLast; Collections.reverseOrder
                 "Comparators"
                 ;; TreeSet's and NavigableSet's SortedSet members, Collections' SortedSet
                 ;; methods, instance? SortedSet
                 "SortedSet"])
           ;; RandomGenerator's bounded defaults and streams, Random's streams, SplittableRandom
           ["jdk/internal/util/random/RandomSupport.java"]
           ;; BigInteger.nextProbablePrime of large numbers
           ["java/math/BitSieve.java"]
           ;; plain Java of java.util
           (map #(str "java/util/" % ".java")
                ["BitSet" "PriorityQueue" "WeakHashMap" "StringTokenizer" "Base64"
                 "SplittableRandom" "EventObject" "EventListener" "EventListenerProxy"
                 "Observable" "Observer" "TooManyListenersException" "InputMismatchException"
                 "MissingResourceException" "IllformedLocaleException"
                 "InvalidPropertiesFormatException" "FormattableFlags"
                 "ServiceConfigurationError"])))))

(def added-module-sources
  "Files of other modules' src/MODULE/share/classes added to the closure (paths relative to
  jdk26u), translated as if they were java.base's (javac's --patch-module java.base takes them):
  java.sql.Timestamp, whose class core's #inst support names (JRT-NOTES.md, phase 2B
  \"Dates\"), and java.sql.Date, which Timestamp's toString uses (its Go name is Sql_Date: j2g's
  rename table). Since CDR4 (doc/CLOJURE-DESIGN-REVIEW.md, the user's decision of 2026-11-05) the
  rest of java.sql's interfaces that java.sql.Connection reaches (with DriverManager, Driver and
  SQLException jrt's variants in overlay/jdk), javax.xml.transform's Source and Result (SQLXML's), and of
  java.desktop java.awt.Point, Point2D, Transparency and java.beans.Transient (Color is jrt's
  variant): Clojure's suite names java.sql.Connection (java.javadoc) and java.awt.Point and Color
  (java-interop's test-dot and test-bean)."
  (vec (concat
         (map #(str "src/java.sql/share/classes/java/sql/" % ".java")
              ["Array" "Blob" "CallableStatement" "ClientInfoStatus" "Clob" "Connection"
               "DatabaseMetaData" "Date" "DriverAction" "DriverPropertyInfo" "NClob"
               "ParameterMetaData" "PreparedStatement" "Ref" "ResultSet" "ResultSetMetaData"
               "RowId" "RowIdLifetime" "SQLClientInfoException"
               "SQLFeatureNotSupportedException" "SQLNonTransientException" "SQLType" "SQLUtils"
               "SQLWarning" "SQLXML" "Savepoint" "ShardingKey" "Statement" "Struct" "Time"
               "Timestamp" "Wrapper"])
         (map #(str "src/java.xml/share/classes/javax/xml/transform/" % ".java") ["Result" "Source"])
         (map #(str "src/java.desktop/share/classes/" % ".java")
              ["java/awt/Point" "java/awt/Transparency" "java/awt/geom/Point2D" "java/beans/Transient"]))))

(def file-sources
  "java.io.File and the file system in the Go build (the user's decision of 2026-10-09,
  reversing D6 for files; doc/go/JRT-NOTES.md, \"Files\"): paths relative to jdk26u.
  UnixFileSystem, DefaultFileSystem and the file: URL handler are src/java.base/unix/classes
  files (KIND unix)."
  (vec (sort
         (concat
           ;; File and the abstract FileSystem with its Unix implementation, whose natives are
           ;; jrt's over the host (variants overlay/jdk/variants/UnixFileSystem.ae, File.ae),
           ;; the interfaces and the delete-on-exit hook File uses; FileReader and FileWriter
           (map #(str "src/java.base/share/classes/java/io/" % ".java")
                ["File" "FileSystem" "FileFilter" "FilenameFilter" "DeleteOnExitHook" "FileReader"
                 "FileWriter"])
           (map #(str "src/java.base/unix/classes/java/io/" % ".java")
                ["UnixFileSystem" "DefaultFileSystem"])
           ;; java.nio.file as far as Clojure's java.io namespace, arbace.main and the suite use
           ;; it: jdk26u's Paths, options and exceptions (since F9 all of java.nio.file:
           ;; nio-file-sources)
           (map #(str "src/java.base/share/classes/java/nio/file/" % ".java")
                ["Paths" "OpenOption" "StandardOpenOption" "LinkOption" "CopyOption"
                 "StandardCopyOption" "FileSystemException" "NoSuchFileException"
                 "FileAlreadyExistsException" "DirectoryNotEmptyException" "AccessDeniedException"
                 "InvalidPathException" "ProviderMismatchException" "attribute/FileAttribute"
                 ;; Files.newDirectoryStream (Clojure's suite, java-interop's reflective call
                 ;; with a fn for a DirectoryStream$Filter): the stream's interface, its
                 ;; error, and glob patterns as UnixFileSystem.getPathMatcher makes them
                 "DirectoryStream" "NotDirectoryException"])
           ["src/java.base/share/classes/sun/nio/fs/Globs.java"]
           ;; URLs (io/as-url, readers on file: URLs, slurp of a path string, RT.toUrl): URL and
           ;; its handlers (file:, and http:, https: and jar: for their syntax; their
           ;; connections are outside the world), the file: connection, URLDecoder, and what
           ;; they use (Hashtable, HexFormat, the address checks of IPAddressUtil)
           (map #(str "src/java.base/share/classes/java/net/" % ".java")
                ["URL" "URLStreamHandler" "URLStreamHandlerFactory" "MalformedURLException"
                 "URLConnection" "UnknownServiceException" "URLDecoder" "ContentHandler"
                 "FileNameMap"])
           (map #(str "src/java.base/share/classes/" % ".java")
                ["java/util/Hashtable" "java/util/Dictionary" "java/util/HexFormat"
                 "jdk/internal/util/HexDigits" "jdk/internal/util/Exceptions"
                 "sun/net/util/IPAddressUtil" "sun/net/www/ParseUtil" "sun/net/www/URLConnection"
                 "sun/net/www/MessageHeader" "sun/net/www/protocol/file/FileURLConnection"
                 "sun/net/www/protocol/http/Handler" "sun/net/www/protocol/https/Handler"
                 "sun/net/www/protocol/jar/Handler"])
           ["src/java.base/unix/classes/sun/net/www/protocol/file/Handler.java"]))))

(def concurrent-sources
  "The rest of java.util.concurrent in the Go build (the user's decision of 2026-10-10;
  doc/go/JRT-NOTES.md, \"Concurrency\"): jdk26u's classes over VarHandles, which j2g compiles to
  atomic operations on the fields they name (J2G-SPEC §8.5), and over Unsafe. Paths relative
  to src/java.base/share/classes."
  (vec (sort
         (concat
           ;; the concurrent collections and queues, with the interfaces they implement
           (map #(str "java/util/concurrent/" % ".java")
                ["ConcurrentLinkedQueue" "ConcurrentLinkedDeque" "ConcurrentSkipListMap"
                 "ConcurrentSkipListSet" "ConcurrentNavigableMap" "CopyOnWriteArrayList"
                 "CopyOnWriteArraySet" "LinkedBlockingDeque" "BlockingDeque" "PriorityBlockingQueue"
                 "DelayQueue" "Delayed" "SynchronousQueue" "LinkedTransferQueue" "TransferQueue"])
           ;; the synchronizers and CompletableFuture; RecursiveAction; the reactive streams'
           ;; interfaces and their publisher
           (map #(str "java/util/concurrent/" % ".java")
                ["Exchanger" "Phaser" "CompletableFuture" "CompletionStage" "CompletionException"
                 "RecursiveAction" "Flow" "SubmissionPublisher"])
           ;; the atomic arrays, the adders and accumulators, the stamped and markable references
           (map #(str "java/util/concurrent/atomic/" % ".java")
                ["AtomicReferenceArray" "AtomicIntegerArray" "AtomicLongArray" "Striped64" "LongAdder"
                 "DoubleAdder" "LongAccumulator" "DoubleAccumulator" "AtomicStampedReference"
                 "AtomicMarkableReference"])
           ;; StampedLock (over Unsafe and LockSupport), and the interface of its read-write view
           ["java/util/concurrent/locks/StampedLock.java" "java/util/concurrent/locks/ReadWriteLock.java"]
           ;; what they use of java.util: DelayQueue's PriorityQueue, the SortedSet that
           ;; ConcurrentSkipListSet's views are (both also on java.util's own list of gaps,
           ;; JAVA-BASE.md; a file named twice is translated once)
           ["java/util/PriorityQueue.java" "java/util/SortedSet.java"]
           ;; ThreadLocalRandom whole (jrt had its probes only), over Unsafe on the Thread's
           ;; seed and probe fields, with RandomSupport, its bounded and stream algorithms
           ["java/util/concurrent/ThreadLocalRandom.java" "jdk/internal/util/random/RandomSupport.java"]
           ;; the executors: ThreadPoolExecutor (its workers are AbstractQueuedSynchronizers),
           ;; ScheduledThreadPoolExecutor, FutureTask, Executors' factories, the completion
           ;; service, ExecutorService (jrt's hand-written pools and FutureTask are gone; jrt keeps
           ;; a stand-in of ExecutorService and the other interfaces, which its ForkJoinPool
           ;; implements)
           (map #(str "java/util/concurrent/" % ".java")
                ["ExecutorService" "ThreadPoolExecutor" "ScheduledThreadPoolExecutor" "AbstractExecutorService" "FutureTask"
                 "Executors" "RejectedExecutionHandler" "ExecutorCompletionService" "CompletionService"
                 "RunnableFuture" "ScheduledExecutorService" "ScheduledFuture" "RunnableScheduledFuture"])
           (map #(str "java/util/concurrent/locks/" % ".java")
                ["AbstractQueuedSynchronizer" "AbstractOwnableSynchronizer" "AbstractQueuedLongSynchronizer"])))))

(def security-sources
  "java.security basics in the Go build (the user's decision of 2026-10-10; doc/go/JRT-NOTES.md,
  \"Security\"): MessageDigest and its streams, SecureRandom, javax.crypto.Mac with
  SecretKeySpec, the providers SUN and SunJCE with the services they implement in plain Java
  (the digests, the SHA1PRNG, NativePRNG and DRBG generators, the HMACs), and the provider
  framework (Provider, Security, sun.security.jca) over the JDK's java.security file. Paths
  relative to jdk26u; NativePRNG is a src/java.base/unix/classes file."
  (vec (sort
         (concat
           (map #(str "src/java.base/share/classes/" % ".java")
                (concat
                  ;; the API: the engines, their SPIs, the digest streams, keys and parameters,
                  ;; the exceptions
                  (map #(str "java/security/" %)
                       ["MessageDigest" "MessageDigestSpi" "DigestInputStream" "DigestOutputStream"
                        "SecureRandom" "SecureRandomSpi" "SecureRandomParameters" "DrbgParameters"
                        "Provider" "Security" "Key" "AlgorithmConstraints" "CryptoPrimitive"
                        "spec/AlgorithmParameterSpec" "spec/KeySpec"
                        "GeneralSecurityException" "NoSuchAlgorithmException" "NoSuchProviderException"
                        "DigestException" "InvalidKeyException" "KeyException" "InvalidParameterException"
                        "InvalidAlgorithmParameterException" "ProviderException"])
                  (map #(str "javax/crypto/" %)
                       ["Mac" "MacSpi" "SecretKey" "ShortBufferException" "spec/SecretKeySpec"])
                  ["javax/security/auth/Destroyable" "javax/security/auth/DestroyFailedException"]
                  ;; the constructor parameter types of two engine types Provider describes (its
                  ;; static initializer names them), and the events Provider.getService and
                  ;; Security.setProperty commit (never enabled: no JFR in the Go build)
                  ["java/security/cert/CertStoreParameters" "javax/crypto/KDFParameters"
                   "jdk/internal/event/Event" "jdk/internal/event/SecurityProviderServiceEvent"
                   "jdk/internal/event/SecurityPropertyModificationEvent"]
                  ;; the SUN provider: the digests (the JDK's own, plain Java), the generators,
                  ;; the seed generator
                  (map #(str "sun/security/provider/" %)
                       ["Sun" "SunEntries" "DigestBase" "MD2" "MD5" "SHA" "SHA2" "SHA5" "SHA3"
                        "ByteArrayAccess" "SecureRandom" "DRBG" "AbstractDrbg" "AbstractHashDrbg"
                        "HashDrbg" "HmacDrbg" "EntropySource" "MoreDrbgParameters"])
                  ;; the SunJCE provider's HMACs
                  (map #(str "com/sun/crypto/provider/" %) ["SunJCE" "HmacCore" "HmacMD5" "HmacSHA1"])
                  ;; the provider framework, and what it uses of sun.security.util
                  (map #(str "sun/security/jca/" %)
                       ["GetInstance" "ProviderList" "Providers" "ProviderConfig" "ServiceId" "JCAUtil"])
                  (map #(str "sun/security/util/" %)
                       ["Debug" "SecurityConstants" "SecurityProviderConstants" "SecurityProperties"
                        "KnownOIDs" "MessageDigestSpi2" "CryptoAlgorithmConstraints"
                        "AbstractAlgorithmConstraints" "AlgorithmDecomposer" "PropertyExpander"])))
           ;; NativePRNG (the default SecureRandom on Linux); its seed generator is jrt's own
           ;; SeedGenerator (overlay), over the host's random source
           ["src/java.base/unix/classes/sun/security/provider/NativePRNG.java"]))))

;; Permissions and JAAS's core (doc/classes/JAVA-DEFERRED-TRIAGE.md, F4, "As built: F4
;; (write-ahead)"; JC9, JCS134 (a)): java.security's permission machinery as jdk26u has it since the
;; Security Manager left (AccessController runs the action, checkPermission denies, Policy grants
;; nothing: the unlimited model F1's JceSecurityManager takes for the crypto policy), the permission
;; classes of java.io, java.net, java.util, java.lang and java.util.logging, and
;; javax.security.auth's Subject, callbacks and login with its configuration file. It needs F1
;; (jca-sources: Permission, PermissionCollection, Guard and SecurityException are there) and
;; comes after F5 (LoggingPermission, which logging-sources leaves out). The list is the closure of
;; these seeds computed as F1's was, against the world, jca-sources and logging-sources: 86 files,
;; 20,813 lines, and the two generated message bundles, 90 lines. What it reaches outside the world
;; (serialization's streams, F2's certificates in CodeSource and UnresolvedPermission, IDN in
;; SocketPermission's names) is an operation-level stub, or a variant (overlay/jdk/variants:
;; Password, PasswordCallback, Subject, LoginContext, Configuration, FilePermission, PortConfig,
;; RegisteredDomain).
(def permission-sources
  "Permissions and JAAS's core in the Go build (F4): paths relative to jdk26u."
  (vec (sort
         (concat
           ;; jdk.security.auth's principals (KIND share:jdk.security.auth); not LdapPrincipal
           ;; (javax.naming, F19)
           (map #(str "src/jdk.security.auth/share/classes/com/sun/security/auth/" % ".java")
                ["NTDomainPrincipal" "NTNumericCredential" "NTSid" "NTSidDomainPrincipal"
                 "NTSidGroupPrincipal" "NTSidPrimaryGroupPrincipal" "NTSidUserPrincipal"
                 "NTUserPrincipal" "PrincipalComparator" "UnixNumericGroupPrincipal"
                 "UnixNumericUserPrincipal" "UnixPrincipal" "UserPrincipal"])
           ;; TextCallbackHandler, over sun.security.util's ConsoleCallbackHandler
           (map #(str "src/jdk.security.auth/share/classes/com/sun/security/auth/callback/" % ".java")
                ["TextCallbackHandler"])
           ;; the public ConfigFile, over sun.security.provider.ConfigFile; no login module
           ;; (UnixLoginModule's UnixSystem is native, KeyStoreLoginModule needs F2's KeyStore, the
           ;; JNDI, LDAP and Kerberos ones are F19's and F4b's)
           (map #(str "src/jdk.security.auth/share/classes/com/sun/security/auth/login/" % ".java")
                ["ConfigFile"])
           ;; FilePermission (variant: the paths by Path.of, no FileSystem)
           (map #(str "src/java.base/share/classes/java/io/" % ".java")
                ["FilePermission"])
           ;; RuntimePermission, a cut class until F4
           (map #(str "src/java.base/share/classes/java/lang/" % ".java")
                ["RuntimePermission"])
           ;; ReflectPermission
           (map #(str "src/java.base/share/classes/java/lang/reflect/" % ".java")
                ["ReflectPermission"])
           ;; the network permissions and URLPermission's host and port ranges
           (map #(str "src/java.base/share/classes/java/net/" % ".java")
                ["HostPortrange" "NetPermission" "SocketPermission" "URLPermission"])
           ;; the permission machinery (Permission, PermissionCollection and Guard are F1's):
           ;; BasicPermission, Permissions, AllPermission, SecurityPermission, UnresolvedPermission;
           ;; AccessController, AccessControlContext, Policy, ProtectionDomain, CodeSource,
           ;; DomainCombiner as jdk26u has them since the Security Manager left (they run the
           ;; action, deny every check, grant nothing); the privileged actions; Principal; the
           ;; deprecated identities (Identity, IdentityScope, Signer and the old Certificate
           ;; interface)
           (map #(str "src/java.base/share/classes/java/security/" % ".java")
                ["AccessControlContext" "AccessControlException" "AccessController" "AllPermission"
                 "BasicPermission" "Certificate" "CodeSource" "DomainCombiner" "GuardedObject" "Identity"
                 "IdentityScope" "KeyManagementException" "Permissions" "Policy" "PolicySpi" "Principal"
                 "PrivilegedAction" "PrivilegedActionException" "PrivilegedExceptionAction"
                 "ProtectionDomain" "SecurityPermission" "Signer" "URIParameter" "UnresolvedPermission"
                 "UnresolvedPermissionCollection"])
           ;; PropertyPermission
           (map #(str "src/java.base/share/classes/java/util/" % ".java")
                ["PropertyPermission"])
           ;; LoggingPermission (KIND share:java.logging), which F5 left to F4
           (map #(str "src/java.logging/share/classes/java/util/logging/" % ".java")
                ["LoggingPermission"])
           ;; Subject (variant: the current subject in a ThreadLocal), its domain combiner and
           ;; permissions
           (map #(str "src/java.base/share/classes/javax/security/auth/" % ".java")
                ["AuthPermission" "PrivateCredentialPermission" "RefreshFailedException" "Refreshable"
                 "Subject" "SubjectDomainCombiner"])
           ;; the callbacks (PasswordCallback's variant: no Cleaner)
           (map #(str "src/java.base/share/classes/javax/security/auth/callback/" % ".java")
                ["Callback" "CallbackHandler" "ChoiceCallback" "ConfirmationCallback" "LanguageCallback"
                 "NameCallback" "PasswordCallback" "TextInputCallback" "TextOutputCallback"
                 "UnsupportedCallbackException"])
           ;; LoginContext (variant: no ServiceLoader), Configuration (variant: ConfigFile
           ;; constructed directly), the exceptions
           (map #(str "src/java.base/share/classes/javax/security/auth/login/" % ".java")
                ["AccountException" "AccountExpiredException" "AccountLockedException"
                 "AccountNotFoundException" "AppConfigurationEntry" "Configuration" "ConfigurationSpi"
                 "CredentialException" "CredentialExpiredException" "CredentialNotFoundException"
                 "FailedLoginException" "LoginContext" "LoginException"])
           ;; LoginModule
           (map #(str "src/java.base/share/classes/javax/security/auth/spi/" % ".java")
                ["LoginModule"])
           ;; PortConfig (KIND unix; variant: Linux's ephemeral range from /proc, no native library)
           (map #(str "src/java.base/unix/classes/sun/net/" % ".java")
                ["PortConfig"])
           ;; ConfigFile, the login configuration's parser
           (map #(str "src/java.base/share/classes/sun/security/provider/" % ".java")
                ["ConfigFile"])
           ;; what JAAS uses of sun.security.util: ResourcesMgr, Password (variant: no console),
           ;; ConsoleCallbackHandler, PendingException; RegisteredDomain (variant: no public suffix
           ;; list, so no DomainName)
           (map #(str "src/java.base/share/classes/sun/security/util/" % ".java")
                ["ConsoleCallbackHandler" "Password" "PendingException" "RegisteredDomain" "ResourcesMgr"])
           ;; the security and auth messages ResourcesMgr reads, generated by the JDK build's
           ;; CompileProperties from their .properties (make/modules/java.base/Gensrc.gmk's
           ;; SECURITY_RESOURCES; bin/jrt-convert's generate step), the root locale's alone
           (map #(str "build/linux-x86_64-server-release/support/gensrc/java.base/sun/security/util/resources/" % ".java")
                ["auth" "security"])))))

;; PKI (doc/classes/JAVA-DEFERRED-TRIAGE.md, F2, "As built: F2 (write-ahead)"; JC9, JCS134 (a)):
;; java.security.cert with X.509's certificates, CRLs and PKIX's certificate paths, sun.security.x509,
;; PKCS #7, #9 and #12, the JKS, JCEKS, PKCS12 and DKS key stores, X500Principal. It needs F1
;; (jca-sources: the key encodings, AlgorithmId, the signatures and key factories its certificates
;; use, jrt's CryptoAccess) and F4 (permission-sources: CodeSource, the principals, AuthProvider's
;; login): the list is the closure of its seeds computed as F1's was, against the world and those
;; three lists (F1's, F5's, F4's), not a copy of them: 219 files, 71,353 lines. What it reaches
;; outside the world (serialization's streams; TLS's SSLSession, SSLScope, SNIHostName and SSLLogger
;; in the shared helpers, F3; java.net.HttpURLConnection and URLEncoder, revocation's fetches; IDN;
;; ServiceLoader in keytool's helper) is an operation-level stub, or a variant (overlay/jdk/variants:
;; SignatureAccess, X500Principal, X500Name, SignatureUtil, JceKeyProtector, PKCS12KeyStore, OCSP).
(def pki-sources
  "PKI in the Go build (F2): paths relative to jdk26u."
  (vec (sort
         (concat
           ;; the JCEKS key store F1 left out (JceKeyStore, its KeyProtector, variant
           ;; JceKeyProtector.ae: the key spec cleared through F1's CryptoAccess; its secret keys
           ;; are serialized SealedObjects, by design until serialization's slice 4: SealedObject's
           ;; access in SharedSecrets is j2g's, arbace.j2g.model/serial-accessors)
           (map #(str "src/java.base/share/classes/com/sun/crypto/provider/" % ".java")
                ["JceKeyStore" "KeyProtector" "SealedObjectForKeyProtector"])
           ;; KeyStoreLoginModule (KIND share:jdk.security.auth), F4's login over F2's key store
           (map #(str "src/jdk.security.auth/share/classes/com/sun/security/auth/module/" % ".java")
                ["KeyStoreLoginModule"])
           ;; KeyStore and its SPI and entries, the signers and timestamps of code (CodeSigner,
           ;; Timestamp: F4's CodeSource names them), PKCS12Attribute, DomainLoadStoreParameter,
           ;; AuthProvider
           (map #(str "src/java.base/share/classes/java/security/" % ".java")
                ["AuthProvider" "CodeSigner" "DomainLoadStoreParameter" "KeyStore" "KeyStoreException"
                 "KeyStoreSpi" "PKCS12Attribute" "Timestamp"])
           ;; the certificate API: CertificateFactory, Certificate and X.509's, CRLs, CertPath with
           ;; PKIX's validator and builder and their parameters, trust anchors, cert stores and
           ;; selectors
           (map #(str "src/java.base/share/classes/java/security/cert/" % ".java")
                ["CRL" "CRLException" "CRLReason" "CRLSelector" "CertPath" "CertPathBuilder"
                 "CertPathBuilderException" "CertPathBuilderResult" "CertPathBuilderSpi"
                 "CertPathChecker" "CertPathHelperImpl" "CertPathParameters" "CertPathValidator"
                 "CertPathValidatorException" "CertPathValidatorResult" "CertPathValidatorSpi"
                 "CertSelector" "CertStore" "CertStoreException" "CertStoreSpi" "Certificate"
                 "CertificateEncodingException" "CertificateException" "CertificateExpiredException"
                 "CertificateFactory" "CertificateFactorySpi" "CertificateNotYetValidException"
                 "CertificateParsingException" "CertificateRevokedException"
                 "CollectionCertStoreParameters" "Extension" "LDAPCertStoreParameters"
                 "PKIXBuilderParameters" "PKIXCertPathBuilderResult" "PKIXCertPathChecker"
                 "PKIXCertPathValidatorResult" "PKIXParameters" "PKIXReason" "PKIXRevocationChecker"
                 "PolicyNode" "PolicyQualifierInfo" "TrustAnchor" "URICertStoreParameters" "X509CRL"
                 "X509CRLEntry" "X509CRLSelector" "X509CertSelector" "X509Certificate" "X509Extension"])
           ;; X500Principal (variant: its access through jrt's PkiAccess), X500PrivateCredential
           (map #(str "src/java.base/share/classes/javax/security/auth/x500/" % ".java")
                ["X500Principal" "X500PrivateCredential"])
           ;; the accesses jrt's jdk.internal.jrt.PkiAccess (overlay) holds in SharedSecrets' place
           (map #(str "src/java.base/share/classes/jdk/internal/access/" % ".java")
                ["JavaSecuritySignatureAccess" "JavaxCryptoSealedObjectAccess" "JavaxSecurityAccess"])
           ;; the certificate and validation events (never enabled: no JFR; jrt's EventHelper,
           ;; overlay, never logs)
           (map #(str "src/java.base/share/classes/jdk/internal/event/" % ".java")
                ["X509CertificateEvent" "X509ValidationEvent"])
           ;; ThreadTracker, the certificate path builder's guard against fetching recursively
           (map #(str "src/java.base/share/classes/jdk/internal/misc/" % ".java")
                ["ThreadTracker"])
           ;; PKCS #7 and #9 and their signers (PKCS8Key is F1's)
           (map #(str "src/java.base/share/classes/sun/security/pkcs/" % ".java")
                ["ContentInfo" "EncryptedPrivateKeyInfo" "PKCS7" "PKCS9Attribute" "PKCS9Attributes"
                 "ParsingException" "SignerInfo" "SigningCertificateInfo"])
           ;; the PKCS #12 key store (variant: the key specs cleared through F1's CryptoAccess)
           (map #(str "src/java.base/share/classes/sun/security/pkcs12/" % ".java")
                ["MacData" "PBMAC1Parameters" "PKCS12KeyStore"])
           ;; SUN's certificate factory and key stores (X509Factory, JKS, DKS with its policy
           ;; parser); jrt's JrtServices constructs them
           (map #(str "src/java.base/share/classes/sun/security/provider/" % ".java")
                ["DomainKeyStore" "JavaKeyStore" "KeyProtector" "PolicyParser" "X509Factory"])
           ;; PKIX's validation and building, the revocation checker with CRLs and OCSP (variant
           ;; OCSP.ae: no HTTP client, the responder unreachable as offline), the collection and URI
           ;; cert stores
           (map #(str "src/java.base/share/classes/sun/security/provider/certpath/" % ".java")
                ["AdaptableX509CertSelector" "AdjacencyList" "AlgorithmChecker" "BasicChecker"
                 "BuildStep" "Builder" "CertId" "CertPathConstraintsParameters" "CertPathHelper"
                 "CollectionCertStore" "ConstraintsChecker" "DistributionPointFetcher" "ForwardBuilder"
                 "ForwardState" "IndexedCollectionCertStore" "KeyChecker" "OCSP" "OCSPNonceExtension"
                 "OCSPRequest" "OCSPResponse" "PKIX" "PKIXCertPathValidator" "PKIXExtendedParameters"
                 "PKIXMasterCertPathValidator" "PolicyChecker" "PolicyNodeImpl" "ResponderId"
                 "RevocationChecker" "State" "SunCertPathBuilder" "SunCertPathBuilderException"
                 "SunCertPathBuilderResult" "URICertStore" "UntrustedChecker" "Vertex" "X509CertPath"
                 "X509CertificatePair"])
           ;; the timestamp tokens PKCS #7 reads
           (map #(str "src/java.base/share/classes/sun/security/timestamp/" % ".java")
                ["TSRequest" "TSResponse" "TimestampToken" "Timestamper"])
           ;; KeyStoreUtil (PKCS12KeyStore's isSelfSigned; keytool's other helpers come along,
           ;; unused)
           (map #(str "src/java.base/share/classes/sun/security/tools/" % ".java")
                ["KeyStoreUtil"])
           ;; what PKI uses of sun.security.util: SignatureUtil (variant: Signature's access through
           ;; PkiAccess), the algorithm constraints, the anchors and untrusted certificates, the
           ;; cache, the key store delegator, the host name checker (its TLS parts stubs until F3)
           (map #(str "src/java.base/share/classes/sun/security/util/" % ".java")
                ["AnchorCertificates" "Cache" "ConstraintsParameters" "DisabledAlgorithmConstraints"
                 "Event" "FilePaths" "HostnameChecker" "JarConstraintsParameters" "KeyStoreDelegator"
                 "LocalizedMessage" "PolicyUtil" "SignatureUtil" "UntrustedCertificates"])
           ;; the validators PKIX's algorithm checker names (TLS's, F3, beside)
           (map #(str "src/java.base/share/classes/sun/security/validator/" % ".java")
                ["CADistrustPolicy" "CamerfirmaTLSPolicy" "ChunghwaTLSPolicy" "EndEntityChecker"
                 "EntrustTLSPolicy" "PKIXValidator" "SimpleValidator" "SymantecTLSPolicy"
                 "TrustStoreUtil" "Validator" "ValidatorException"])
           ;; X.509's certificates, CRLs, names, extensions and their OID map (X500Name's variant:
           ;; its access through PkiAccess; AlgorithmId, X509Key are F1's)
           (map #(str "src/java.base/share/classes/sun/security/x509/" % ".java")
                ["AVA" "AccessDescription" "AuthorityInfoAccessExtension"
                 "AuthorityKeyIdentifierExtension" "BasicConstraintsExtension"
                 "CRLDistributionPointsExtension" "CRLExtensions" "CRLNumberExtension"
                 "CRLReasonCodeExtension" "CertificateAlgorithmId" "CertificateExtensions"
                 "CertificateIssuerExtension" "CertificatePoliciesExtension" "CertificatePolicyId"
                 "CertificatePolicyMap" "CertificatePolicySet" "CertificateSerialNumber"
                 "CertificateSubjectName" "CertificateValidity" "CertificateVersion" "CertificateX509Key"
                 "DNSName" "DeltaCRLIndicatorExtension" "DistributionPoint" "DistributionPointName"
                 "EDIPartyName" "ExtendedKeyUsageExtension" "Extension" "FreshestCRLExtension"
                 "GeneralName" "GeneralNameInterface" "GeneralNames" "GeneralSubtree" "GeneralSubtrees"
                 "IPAddressName" "InhibitAnyPolicyExtension" "InvalidityDateExtension"
                 "IssuerAlternativeNameExtension" "IssuingDistributionPointExtension" "KeyIdentifier"
                 "KeyUsageExtension" "NameConstraintsExtension" "NetscapeCertTypeExtension"
                 "OCSPNoCheckExtension" "OIDMap" "OIDName" "OtherName" "PKIXExtensions"
                 "PolicyConstraintsExtension" "PolicyInformation" "PolicyMappingsExtension"
                 "PrivateKeyUsageExtension" "RDN" "RFC822Name" "ReasonFlags" "SerialNumber"
                 "SubjectAlternativeNameExtension" "SubjectInfoAccessExtension"
                 "SubjectKeyIdentifierExtension" "URIName" "UniqueIdentity" "UnparseableExtension"
                 "X400Address" "X500Name" "X509CRLEntryImpl" "X509CRLImpl" "X509CertImpl" "X509CertInfo"])))))

;; TLS (doc/classes/JAVA-DEFERRED-TRIAGE.md, F3, "As built: F3 (write-ahead)"; JCS131 (a)): jdk26u's own
;; SunJSSE (sun.security.ssl: the handshake, the record layer, the key exchanges and cipher suites,
;; X509TrustManagerImpl, SSLSocketImpl and SSLEngineImpl, DTLS, and QUIC's TLS engine, which the
;; handshake names), javax.net.ssl but HttpsURLConnection (java.net's HttpURLConnection is not in the
;; Go build), javax.net, the deprecated javax.security.cert, java.net.IDN with ICU's StringPrep and
;; Punycode (SNIHostName; its data sun/net/idn/uidna.spp by bin/jrt-convert's data step). It needs F1
;; (jca-sources: the ciphers, key agreements, signatures, KDFs), F2 (pki-sources: the certificates,
;; PKIX, the key stores) and F5 (logging-sources: SSLLogger's System.Logger path): the list is the
;; closure of its seeds computed as F1's was, against the world and the four lists (F1's, F5's, F4's,
;; F2's), not a copy of them: 205 files, 77,684 lines. jdk.internal.net.quic's QuicTLSContext (HTTP/3's
;; entry, java.net.http) stays out. jrt's own: SSLLogger (overlay: no System.Logger, JCS138), JsseServices
;; and NetAccess (overlay); variants SSLContext, SNIHostName, SSLSocketImpl, InetAddressAccess and
;; ProviderConfig's SunJSSE case (overlay/jdk/variants; ProviderConfigJsse.ae until JCS232 (a)). What it reaches outside the world (SocketChannel in
;; BaseSSLSocketImpl.getChannel) is an operation-level stub.
(def tls-sources
  "TLS in the Go build (F3): paths relative to jdk26u."
  (vec (sort
         (concat
           (map #(str "src/java.base/share/classes/java/net/" % ".java")
                ["IDN"])
           (map #(str "src/java.base/share/classes/javax/net/" % ".java")
                ["ServerSocketFactory" "SocketFactory"])
           (map #(str "src/java.base/share/classes/javax/net/ssl/" % ".java")
                ["CertPathTrustManagerParameters" "ExtendedSSLSession" "HandshakeCompletedEvent"
                 "HandshakeCompletedListener" "HostnameVerifier" "KeyManager" "KeyManagerFactory"
                 "KeyManagerFactorySpi" "KeyStoreBuilderParameters" "ManagerFactoryParameters"

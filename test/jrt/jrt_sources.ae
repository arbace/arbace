;; The JCA (doc/classes/JAVA-DEFERRED-TRIAGE.md, F1; the user's JCS134 (a), 2026-11-05): javax.crypto
;; with SunJCE's ciphers, MACs, key agreements, KEMs and KDFs, java.security's key factories, key pair
;; generators, signatures and key specs, the SunRsaSign and SunEC providers and SUN's DSA, HSS/LMS
;; and ML-DSA: jdk26u's plain Java over the security basics (security-sources). The list is the
;; closure of these packages' files computed from the sources' names (imports, qualified names and
;; the package's simple names, to a fixpoint over the packages in scope; the converted forms' imports
;; checked against the world), 335 files, 90,145 lines, and the 10 generated fields of added-gensrc,
;; 6,628: +20% on the closure's 483,461 lines ("As built: F1 (write-ahead)"). What it reaches outside
;; the world (serialization's streams, the Cleaner, direct buffers, certificates: J2G-SPEC §12, F17,
;; F7, F2) is an operation-level stub, or a variant (overlay/jdk/variants: the keys without the
;; Cleaner, GaloisCounterMode without JavaNioAccess, SharedSecrets' accesses through jrt's
;; jdk.internal.jrt.CryptoAccess).
(def jca-sources
  "The JCA in the Go build (F1): paths relative to src/java.base/share/classes."
  (vec (sort
         (concat
           ;; javax/crypto: the engines (Cipher, KeyAgreement, KeyGenerator, SecretKeyFactory, KDF,
           ;; KEM, ExemptionMechanism), their SPIs, the cipher streams, EncryptedPrivateKeyInfo,
           ;; NullCipher, SealedObject (its serialization in the world since JCS167), the exceptions, and
           ;; the crypto permissions Cipher holds (CryptoPermission, CryptoAllPermission; jrt's
           ;; JceSecurityManager, overlay, answers the unlimited policy's: CryptoPermissions,
           ;; CryptoPolicyParser and ProviderVerifier, the policy files' and signed jars', are not
           ;; translated)
           (map #(str "javax/crypto/" % ".java")
                ["AEADBadTagException" "BadPaddingException" "Cipher" "CipherInputStream"
                 "CipherOutputStream" "CipherSpi" "CryptoAllPermission" "CryptoPermission"
                 "DecapsulateException" "EncryptedPrivateKeyInfo" "ExemptionMechanism"
                 "ExemptionMechanismException" "ExemptionMechanismSpi" "IllegalBlockSizeException"
                 "KDF" "KDFSpi" "KEM" "KEMSpi" "KeyAgreement" "KeyAgreementSpi" "KeyGenerator"
                 "KeyGeneratorSpi" "NoSuchPaddingException" "NullCipher" "NullCipherSpi"
                 "SealedObject" "SecretKeyFactory" "SecretKeyFactorySpi"])
           ;; javax/crypto/spec: the key and parameter specs
           (map #(str "javax/crypto/spec/" % ".java")
                ["ChaCha20ParameterSpec" "DESKeySpec" "DESedeKeySpec" "DHGenParameterSpec"
                 "DHParameterSpec" "DHPrivateKeySpec" "DHPublicKeySpec" "GCMParameterSpec"
                 "HKDFParameterSpec" "HPKEParameterSpec" "IvParameterSpec" "OAEPParameterSpec"
                 "PBEKeySpec" "PBEParameterSpec" "PSource" "RC2ParameterSpec" "RC5ParameterSpec"])
           ;; javax/crypto/interfaces: the DH and PBE key interfaces
           (map #(str "javax/crypto/interfaces/" % ".java")
                ["DHKey" "DHPrivateKey" "DHPublicKey" "PBEKey"])
           ;; com/sun/crypto/provider: the SunJCE provider's services beside its HMACs: AES, DES,
           ;; DESede, Blowfish, RC2, ARCFOUR, ChaCha20, their modes and paddings, the key wraps,
           ;; RSA's cipher, PBE, PBKDF2, PBMAC1, DH, DHKEM, ML-KEM, HPKE, HKDF, the key generators
           ;; and factories, the parameters; all of the package but the JCEKS key store
           ;; (JceKeyStore, KeyProtector, SealedObjectForKeyProtector: java.security.KeyStore is
           ;; PKI's, F2). jrt's JceServices (overlay) constructs them
           (map #(str "com/sun/crypto/provider/" % ".java")
                ["AEADBufferedStream" "AESCipher" "AESConstants" "AESKeyGenerator" "AESKeyWrap"
                 "AESKeyWrapPadded" "AESParameters" "AES_Crypt" "ARCFOURCipher"
                 "BlockCipherParamsCore" "BlowfishCipher" "BlowfishConstants" "BlowfishCrypt"
                 "BlowfishKeyGenerator" "BlowfishParameters" "ChaCha20Cipher"
                 "ChaCha20Poly1305Parameters" "CipherBlockChaining" "CipherCore" "CipherFeedback"
                 "CipherTextStealing" "ConstructKeys" "CounterMode" "DESCipher" "DESConstants"
                 "DESCrypt" "DESKey" "DESKeyFactory" "DESKeyGenerator" "DESParameters"
                 "DESedeCipher" "DESedeCrypt" "DESedeKey" "DESedeKeyFactory" "DESedeKeyGenerator"
                 "DESedeParameters" "DESedeWrapCipher" "DHKEM" "DHKeyAgreement" "DHKeyFactory"
                 "DHKeyPairGenerator" "DHParameterGenerator" "DHParameters" "DHPrivateKey"
                 "DHPublicKey" "ElectronicCodeBook" "EncryptedPrivateKeyInfo" "FeedbackCipher"
                 "GCM" "GCTR" "GHASH" "GaloisCounterMode" "HKDFKeyDerivation" "HPKE"
                 "HmacMD5KeyGenerator" "HmacPKCS12PBECore" "HmacSHA1KeyGenerator" "ISO10126Padding"
                 "KWUtil" "KeyGeneratorCore" "KeyWrapCipher" "ML_KEM" "ML_KEM_Impls"
                 "OAEPParameters" "OutputFeedback" "PBEKey" "PBEKeyFactory" "PBEParameters"
                 "PBES1Core" "PBES2Core" "PBES2Parameters" "PBEWithMD5AndDESCipher"
                 "PBEWithMD5AndTripleDESCipher" "PBKDF2Core" "PBKDF2KeyImpl" "PBMAC1Core" "PCBC"
                 "PKCS12PBECipherCore" "PKCS5Padding" "Padding" "Poly1305" "PrivateKeyInfo"
                 "RC2Cipher" "RC2Crypt" "RC2Parameters" "RSACipher" "RSACipherAdaptor" "SslMacCore"
                 "SymmetricCipher" "TlsKeyMaterialGenerator" "TlsMasterSecretGenerator"
                 "TlsPrfGenerator" "TlsRsaPremasterSecretGenerator"])
           ;; java/security: the engines and SPIs the JCA adds to MessageDigest and SecureRandom
           ;; (KeyFactory, KeyPairGenerator, Signature, AlgorithmParameters,
           ;; AlgorithmParameterGenerator), the key interfaces, KeyPair, KeyRep, SignedObject, the
           ;; PEM encodings' marker (DEREncodable, PEM), Permission and PermissionCollection with
           ;; Guard (CryptoPermission's supertypes; F4's start), two exceptions
           (map #(str "java/security/" % ".java")
                ["AlgorithmParameterGenerator" "AlgorithmParameterGeneratorSpi"
                 "AlgorithmParameters" "AlgorithmParametersSpi" "AsymmetricKey" "DEREncodable"
                 "Guard" "KeyFactory" "KeyFactorySpi" "KeyPair" "KeyPairGenerator"
                 "KeyPairGeneratorSpi" "KeyRep" "PEM" "Permission" "PermissionCollection"
                 "PrivateKey" "PublicKey" "Signature" "SignatureException" "SignatureSpi"
                 "SignedObject" "UnrecoverableEntryException" "UnrecoverableKeyException"])
           ;; java/security/spec: the key and parameter specs
           (map #(str "java/security/spec/" % ".java")
                ["DSAGenParameterSpec" "DSAParameterSpec" "DSAPrivateKeySpec" "DSAPublicKeySpec"
                 "ECField" "ECFieldF2m" "ECFieldFp" "ECGenParameterSpec" "ECParameterSpec"
                 "ECPoint" "ECPrivateKeySpec" "ECPublicKeySpec" "EdDSAParameterSpec" "EdECPoint"
                 "EdECPrivateKeySpec" "EdECPublicKeySpec" "EllipticCurve" "EncodedKeySpec"
                 "InvalidKeySpecException" "InvalidParameterSpecException" "MGF1ParameterSpec"
                 "NamedParameterSpec" "PKCS8EncodedKeySpec" "PSSParameterSpec"
                 "RSAKeyGenParameterSpec" "RSAMultiPrimePrivateCrtKeySpec" "RSAOtherPrimeInfo"
                 "RSAPrivateCrtKeySpec" "RSAPrivateKeySpec" "RSAPublicKeySpec" "X509EncodedKeySpec"
                 "XECPrivateKeySpec" "XECPublicKeySpec"])
           ;; java/security/interfaces: the RSA, DSA, EC, EdEC and XEC key interfaces
           (map #(str "java/security/interfaces/" % ".java")
                ["DSAKey" "DSAKeyPairGenerator" "DSAParams" "DSAPrivateKey" "DSAPublicKey" "ECKey"
                 "ECPrivateKey" "ECPublicKey" "EdECKey" "EdECPrivateKey" "EdECPublicKey" "RSAKey"
                 "RSAMultiPrimePrivateCrtKey" "RSAPrivateCrtKey" "RSAPrivateKey" "RSAPublicKey"
                 "XECKey" "XECPrivateKey" "XECPublicKey"])
           ;; java/lang: SecurityException (a cut class until F1: Cipher and Permission throw it)
           (map #(str "java/lang/" % ".java")
                ["SecurityException"])
           ;; jdk/internal/access: the two accesses jrt's jdk.internal.jrt.CryptoAccess (overlay)
           ;; holds in SharedSecrets' place
           (map #(str "jdk/internal/access/" % ".java")
                ["JavaSecuritySpecAccess" "JavaxCryptoSpecAccess"])
           ;; sun/security/provider: SUN's DSA (signatures, key pair and parameter generators,
           ;; parameters, key factory, keys), HSS/LMS and ML-DSA, with the named keys' framework
           ;; ML-KEM shares and SHA3Parallel; jrt's JrtServices (overlay) constructs them
           (map #(str "sun/security/provider/" % ".java")
                ["DSA" "DSAKeyFactory" "DSAKeyPairGenerator" "DSAParameterGenerator"
                 "DSAParameters" "DSAPrivateKey" "DSAPublicKey" "DSAPublicKeyImpl" "HSS" "ML_DSA"
                 "ML_DSA_Impls" "NamedKEM" "NamedKeyFactory" "NamedKeyPairGenerator"
                 "NamedSignature" "ParameterCache" "SHA3Parallel"])
           ;; sun/security/rsa: the SunRsaSign provider: RSA's keys, key factory and generator,
           ;; signatures, PSS, the paddings (jrt's RsaServices, overlay, constructs them)
           (map #(str "sun/security/rsa/" % ".java")
                ["MGF1" "PSSParameters" "RSACore" "RSAKeyFactory" "RSAKeyPairGenerator"
                 "RSAPSSSignature" "RSAPadding" "RSAPrivateCrtKeyImpl" "RSAPrivateKeyImpl"
                 "RSAPublicKeyImpl" "RSASignature" "RSAUtil" "SunRsaSign" "SunRsaSignEntries"])
           ;; sun/security/ec: the SunEC provider: ECDSA, ECDH, XDH, their keys, factories and
           ;; generators (its own Provider.Service constructs them, as in the JDK)
           (map #(str "sun/security/ec/" % ".java")
                ["ECDHKeyAgreement" "ECDSAOperations" "ECDSASignature" "ECKeyFactory"
                 "ECKeyPairGenerator" "ECOperations" "ECPrivateKeyImpl" "ECPublicKeyImpl"
                 "ParametersMap" "SunEC" "XDHKeyAgreement" "XDHKeyFactory" "XDHKeyPairGenerator"
                 "XDHPrivateKeyImpl" "XDHPublicKeyImpl" "XECOperations" "XECParameters"])
           ;; sun/security/ec/point: the curves' points
           (map #(str "sun/security/ec/point/" % ".java")
                ["AffinePoint" "ExtendedHomogeneousPoint" "ImmutablePoint" "MutablePoint" "Point"
                 "ProjectivePoint"])
           ;; sun/security/ec/ed: EdDSA
           (map #(str "sun/security/ec/ed/" % ".java")
                ["Ed25519Operations" "Ed448Operations" "EdDSAAlgorithmParameters" "EdDSAKeyFactory"
                 "EdDSAKeyPairGenerator" "EdDSAOperations" "EdDSAParameters" "EdDSAPrivateKeyImpl"
                 "EdDSAPublicKeyImpl" "EdDSASignature" "EdECOperations"])
           ;; sun/security/util: the DER encoding (DerValue, DerInputStream, DerOutputStream,
           ;; ObjectIdentifier), the curves (CurveDB, NamedCurve, ECParameters, ECUtil), the keys'
           ;; and PBE's helpers
           (map #(str "sun/security/util/" % ".java")
                ["ArrayUtil" "BitArray" "ByteArrayLexOrder" "ByteArrayTagOrder" "CurveDB"
                 "DerEncoder" "DerIndefLenConverter" "DerInputStream" "DerOutputStream" "DerValue"

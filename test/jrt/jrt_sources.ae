           ["jdk/internal/util/ModifiedUtf.java" "java/lang/runtime/ExactConversionsSupport.java"]))))

;; zip and jar (doc/classes/JAVA-CONFORMANCE-SURVEY.md, JCS93 (c), "As built: JC6b"): jdk26u's
;; plain Java of java.util.zip and java.util.jar over jrt's own Inflater, Deflater (zlib's inflate
;; and deflate ported to Java), ZipFile and JarFile (jdk26u's without the Cleaner, the file
;; attributes and the signature verification) and JarVerifier (verifying nothing), all in
;; overlay/jdk/java.base; Adler32's and CRC32C's bulk updates are jrt's natives over Go
;; (go/arbace/jrt/checksum.ae).
(def zip-sources
  "java.util.zip and java.util.jar in the Go build (JC6b): paths relative to
  src/java.base/share/classes."

                ["AnnotatedType" "GenericArrayType" "GenericDeclaration" "GenericSignatureFormatError"
                 "MalformedParameterizedTypeException" "ParameterizedType" "TypeVariable" "WildcardType"])
           (map #(str "src/java.base/share/classes/sun/reflect/generics/" % ".java")
                ["factory/CoreReflectionFactory" "factory/GenericsFactory" "parser/SignatureParser"
                 "reflectiveObjects/GenericArrayTypeImpl" "reflectiveObjects/LazyReflectiveObjectGenerator"
                 "reflectiveObjects/NotImplementedException" "reflectiveObjects/ParameterizedTypeImpl"
                 "reflectiveObjects/TypeVariableImpl" "reflectiveObjects/WildcardTypeImpl"
                 "repository/AbstractRepository" "repository/ClassRepository" "repository/ConstructorRepository"
                 "repository/FieldRepository" "repository/GenericDeclRepository" "repository/MethodRepository"
                 "scope/AbstractScope" "scope/ClassScope" "scope/ConstructorScope" "scope/DummyScope"
                 "scope/MethodScope" "scope/Scope"
                 "tree/ArrayTypeSignature" "tree/BaseType" "tree/BooleanSignature" "tree/BottomSignature"
                 "tree/ByteSignature" "tree/CharSignature" "tree/ClassSignature" "tree/ClassTypeSignature"
                 "tree/DoubleSignature" "tree/FieldTypeSignature" "tree/FloatSignature" "tree/FormalTypeParameter"
                 "tree/IntSignature" "tree/LongSignature" "tree/MethodTypeSignature" "tree/ReturnType"
                 "tree/ShortSignature" "tree/Signature" "tree/SimpleClassTypeSignature" "tree/Tree"
                 "tree/TypeArgument" "tree/TypeSignature" "tree/TypeTree" "tree/TypeVariableSignature"
                 "tree/VoidDescriptor" "tree/Wildcard"
                 "visitor/Reifier" "visitor/TypeTreeVisitor" "visitor/Visitor"])))))

;; Charsets (doc/classes/JAVA-DEFERRED-TRIAGE.md, F8, "As built: F8 (write-ahead)"): jdk26u's
;; java.nio.charset and sun.nio.cs in place of jrt's six hand-written charsets (go/arbace/jrt/charset.ae
;; becomes the stand-in standin_charset.ae, kept for jrt's own build; String's Charset overloads code
;; any other charset through jrt's jdk.internal.jrt.CharsetStrings, overlay/jdk), the coders' API
;; public, the streams' coding through StreamDecoder and StreamEncoder, and java.base's tables for
;; linux as the JDK build generates them (charset-gensrc, below). jdk.charsets' extended charsets stay
;; out (JCS proposal: a second step). The charsets are constructed by class name through jrt's
;; sun.nio.cs.JrtCharsets (overlay; variant CsStandardCharsets.ae: no class loading by name).
(def charset-sources
  "jdk26u's charsets in the Go build (F8): paths relative to jdk26u."
  (vec (sort
         (concat
           ;; jdk26u's InputStreamReader and OutputStreamWriter, over sun.nio.cs's StreamDecoder and
           ;; StreamEncoder (jrt's overlays of them, overlay/jdk/java.base/java/io, removed: they
           ;; coded UTF-8, ISO-8859-1 and US-ASCII alone)
           (map #(str "src/java.base/share/classes/java/io/" % ".java")
                ["InputStreamReader" "OutputStreamWriter"])
           ;; the channel interfaces StreamDecoder's channel reader names (Channels.newReader,
           ;; F7's); FileChannel stays a cut class until F7
           (map #(str "src/java.base/share/classes/java/nio/channels/" % ".java")
                ["Channel" "ReadableByteChannel"])
           ;; java.nio.charset whole (Charset, CoderResult, CodingErrorAction,
           ;; CoderMalfunctionError, StandardCharsets; jrt's hand-written Charset and
           ;; StandardCharsets become stand-ins, standin_charset.ae); variant Charset.ae: no
           ;; providers by ServiceLoader, no ScopedValue, the aliases copied
           (map #(str "src/java.base/share/classes/java/nio/charset/" % ".java")
                ["Charset" "CoderMalfunctionError" "CoderResult" "CodingErrorAction"
                 "StandardCharsets"])
           ;; the provider class StandardCharsets extends
           (map #(str "src/java.base/share/classes/java/nio/charset/spi/" % ".java")
                ["CharsetProvider"])
           ;; sun.nio.cs's coders: the Unicode family (UTF-8, UTF-16, UTF-32, CESU-8, with jrt's six
           ;; hand-written charsets replaced), the single- and double-byte machinery the generated
           ;; tables extend, GB18030 (variant GB18030.ae: IS_2000 without VM.initLevel), HKSCS, the
           ;; streams' coders; variant CsStringUTF16.ae (getChar little-endian, no Unsafe)
           (map #(str "src/java.base/share/classes/sun/nio/cs/" % ".java")
                ["ArrayDecoder" "ArrayEncoder" "CESU_8" "CharsetMapping" "DelegatableDecoder"
                 "DoubleByte" "GB18030" "HKSCS" "HistoricallyNamedCharset" "ISO_8859_1" "SingleByte"
                 "StreamDecoder" "StreamEncoder" "StringUTF16" "Surrogate" "ThreadLocalCoders"
                 "US_ASCII" "UTF_16" "UTF_16BE" "UTF_16LE" "UTF_16LE_BOM" "UTF_32" "UTF_32BE"
                 "UTF_32BE_BOM" "UTF_32Coder" "UTF_32LE" "UTF_32LE_BOM" "UTF_8" "Unicode"
                 "UnicodeDecoder" "UnicodeEncoder"])
           ;; the pre-hashed maps of the generated StandardCharsets
           (map #(str "src/java.base/share/classes/sun/util/" % ".java")
                ["PreHashedMap"])))))

;; the charsets' generated sources (F8): CharsetDecoder and CharsetEncoder from
;; Charset-X-Coder.java.template by build.tools.spp.Spp (make/modules/java.base/gensrc/
;; GensrcCharsetCoder.gmk), and sun.nio.cs's StandardCharsets and table-driven charsets for linux by
;; build.tools.charsetmapping.Main (GensrcCharsetMapping.gmk: make/data/charsetmapping's charsets
;; and stdcs-linux), both on javac's tool executable in bin/jrt-convert's generate step
(def charset-gensrc
  "Files the JDK build generates for the charsets (F8), as paths below gensrc/java.base, made by
  bin/jrt-convert's generate step as the JDK build makes them."
  (vec (sort
         (concat
           (map #(str "java/nio/charset/" % ".java")
                ["CharsetDecoder" "CharsetEncoder"])
           (map #(str "sun/nio/cs/" % ".java")
                ["Big5" "Big5_HKSCS" "EUC_CN" "EUC_JP" "EUC_JP_LINUX" "EUC_KR" "EUC_TW"
                 "EUC_TWMapping" "GBK" "HKSCSMapping" "IBM437" "IBM737" "IBM775" "IBM850" "IBM852"
                 "IBM855" "IBM857" "IBM858" "IBM862" "IBM866" "IBM874" "ISO_8859_11" "ISO_8859_13"
                 "ISO_8859_15" "ISO_8859_16" "ISO_8859_2" "ISO_8859_3" "ISO_8859_4" "ISO_8859_5"
                 "ISO_8859_6" "ISO_8859_7" "ISO_8859_8" "ISO_8859_9" "JIS_X_0201" "JIS_X_0208"
                 "JIS_X_0212" "Johab" "KOI8_R" "KOI8_U" "MS1250" "MS1251" "MS1252" "MS1253" "MS1254"
                 "MS1257" "MS932" "SJIS" "StandardCharsets" "TIS_620"])))))

;; file channels and buffers (doc/classes/JAVA-DEFERRED-TRIAGE.md, F7, "As built: F7 (write-ahead)"):
;; jdk26u's channel interfaces, exceptions, FileLock, Channels and the stream adapters, over jrt's
;; own FileChannelImpl (overlay/jdk/java.base/sun/nio/ch: positional I/O, locks and heap mappings over
;; jrt's file table, jdk.internal.jrt.HostFileChannels) and FileChannel (overlay: open asks
;; FileChannelImpl, jrt's Path having no FileSystem); jrt's own MappedByteBuffer and DirectByteBuffer(R)
;; (overlay: a direct or mapped buffer is a heap buffer, a mapping a heap copy written back by force);
;; the streams' getChannel (overlay FileInputStream, FileOutputStream; RandomAccessFile's is jdk26u's,
;; its variant's close closing the channel). AbstractInterruptibleChannel's variant: its blockedOn
;; registers the blocker with jrt's Thread (jdk.internal.jrt.HostThreads, JCS162), whose interrupt calls it
;; as jdk26u's Thread does. The other buffer types are
;; generated (added-gensrc). What stays outside the world in members (the selectable and socket channels
;; ChannelInputStream and Streams test for, AsynchronousFileChannel in FileLock's second constructor,
;; Channels' asynchronous adapters, the memory segments' map with an Arena) is an operation-level stub. Channel and
;; ReadableByteChannel are F8's (charset-sources: StreamDecoder names them).
(def channel-sources
  "java.nio.channels' file channels in the Go build (F7): paths relative to
  src/java.base/share/classes."
  (vec (sort
         (concat
           (map #(str "java/nio/channels/" % ".java")
                ["AsynchronousCloseException" "ByteChannel" "Channels" "ClosedByInterruptException"
                 "ClosedChannelException" "FileLock" "FileLockInterruptionException" "GatheringByteChannel"
                 "IllegalBlockingModeException" "InterruptibleChannel" "NonReadableChannelException"
                 "NonWritableChannelException" "OverlappingFileLockException"
                 "ScatteringByteChannel" "SeekableByteChannel" "WritableByteChannel"
                 "spi/AbstractInterruptibleChannel"])
           (map #(str "sun/nio/ch/" % ".java")
                ["ChannelInputStream" "ChannelOutputStream" "FileLockImpl" "Interruptible" "Streams"])
           ;; the buffers' mismatch (ByteBuffer.mismatch, CharBuffer.compareTo of a StringCharBuffer)
           ["java/nio/BufferMismatch.java"]))))

;; Datagrams and the host's network interfaces (doc/classes/JAVA-DEFERRED-TRIAGE.md, F11, "As built: F11
;; (write-ahead)"): jdk26u's DatagramSocket, MulticastSocket and DatagramPacket over jdk26u's legacy
;; delegate NetMulticastSocket, whose DatagramSocketImpl is jrt's own java.net.HostDatagramSocketImpl
;; (overlay/jdk) over the host's UDP sockets (jdk.internal.jrt.HostDatagram, in HostNet's table), in
;; place of the NIO adaptor (sun.nio.ch.DatagramSocketAdaptor: java.nio's channels and selectors stay
;; out, F10); NetworkInterface and InterfaceAddress with their natives over HostDatagram's interfaces
;; (Go's net.Interfaces). Variants overlay/jdk/variants/NetworkInterface.ae (the natives, no library),
;; InterfaceAddress.ae (a constructor for them); DatagramSocket.ae (createDelegate: the legacy delegate always)
;; until F10b, whose NIO adaptor (datagram-channel-sources, below) is the delegate since, as in jdk26u:
;; HostDatagramSocketImpl stays, unused unless a program's DatagramSocketImplFactory returns it.
(def datagram-sources
  "Datagram sockets, multicast and network interfaces in the Go build (F11): paths relative to
  jdk26u. DefaultInterface is a src/java.base/unix/classes file (KIND unix)."
  (vec (sort
         (concat
           (map #(str "src/java.base/share/classes/java/net/" % ".java")
                ["DatagramPacket" "DatagramSocket" "DatagramSocketImpl" "DatagramSocketImplFactory"
                 "InterfaceAddress" "MulticastSocket" "NetMulticastSocket" "NetworkInterface"
                 "PortUnreachableException" "ProtocolFamily" "StandardProtocolFamily"])
           ["src/java.base/unix/classes/java/net/DefaultInterface.java"]))))

;; Datagram channels and multicast (F10 of doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: F10b"): jdk26u's
;; DatagramChannel and its implementation DatagramChannelImpl, the multicast channel's membership keys and
;; registry, and the NIO adaptor DatagramSocketAdaptor, java.net.DatagramSocket's delegate as in jdk26u (F11's
;; variant of DatagramSocket.createDelegate gone: the legacy NetMulticastSocket over HostDatagramSocketImpl only
;; for a DatagramSocketImplFactory's impl, as the JDK's). Over F10a's native layer: Net's multicast natives and
;; DatagramChannelImpl's receive0, send0 and disconnect0 are HostChannels' (go/arbace/jrt/channels_linux.ae);
;; NativeSocketAddress (a struct sockaddr as a byte array) and DatagramDispatcher are overlays; DatagramChannelImpl
;; (no Cleaner, the natives over the arrays) and DatagramSocketAdaptor (no method handles) have variants.
(def datagram-channel-sources
  "Datagram channels, multicast channels and the NIO datagram socket adaptor in the Go build (F10b): paths
  relative to jdk26u."
  (vec (sort
         (concat
           (map #(str "src/java.base/share/classes/java/nio/channels/" % ".java")
                ["DatagramChannel" "MembershipKey" "MulticastChannel"])
           (map #(str "src/java.base/share/classes/sun/nio/ch/" % ".java")
                ["DatagramChannelImpl" "DatagramSocketAdaptor" "MembershipKeyImpl" "MembershipRegistry"])))))

;; java.nio's selectable channels (F10 of doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: F10a"): selectors,
;; socket and server socket channels, pipes and the sockets' adaptors, jdk26u's Java over jrt's natives at
;; sun.nio.ch's native layer: Net, IOUtil, NativeDispatcher, SocketDispatcher, UnixDispatcher, NativeThread,
;; Poller, Util, UnixDomainSockets, PollSelectorImpl, EPoll, EventFD, FileDispatcherImpl (closeIntFD) and
;; SocketOptionRegistry are overlays (overlay/jdk/java.base/sun/nio/ch, jdk.internal.jrt.HostChannels' natives
;; in go/arbace/jrt/channels_linux.ae); Linux's default selector is jdk26u's EPollSelectorImpl (KIND linux),
;; the poll selector beside it as on Linux; SelectorProvider's Holder, SocketChannelImpl, PollSelectorProvider
;; and EPollSelectorProvider have variants. DatagramChannel (DatagramChannelImpl, multicast) is F10b's, above; the UNIX family
;; (UnixDomainSocketAddress, over F9's java.nio.file) is unix-socket-sources' (JCS164); the asynchronous channels stay outside the world.
(def selector-sources
  "Selectors, socket channels and pipes in the Go build (F10a): paths relative to jdk26u; the four
  src/java.base/unix/classes files are KIND unix, the three src/java.base/linux/classes ones KIND linux."
  (vec (sort

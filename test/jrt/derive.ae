(ns jrt.derive
  "jrt's derived overlays (doc/classes/JAVA-DEFERRED-TRIAGE.md, JCS166 (a), the user's decision of 2026-11-07;
  first used by F24, \"As built: F24 (write-ahead)\"): an overlay of overlay/jdk/java.base that is jdk26u's file
  with a few exact replacements, made here from jdk26u's file (at the platform's pin, jdk/javac/platform.sha256)
  rather than kept by hand: each replacement asserted to match exactly as often as the table says, an Arbace
  header naming the file's origin, the change and its license put before jdk26u's text. derive writes the
  overlays, check compares the committed ones byte for byte (a stale or edited overlay fails).

    bin/jrt-convert derive [--check] [NAME...]   (the overlays named, by their path below overlay/jdk/java.base;
                                                  default all)

  Since JCS251 (a) (the user, 2026-11-08) also the derivations that were scratch scripts: F7's DirectByteBuffer
  and DirectByteBufferR (gendirect.py, from the JDK build's generated HeapByteBuffer(R).java), F10a's Net
  (gennet.py, its natives given bodies, F10b's multicast ones with them), PollSelectorImpl (genpoll.py) and
  SocketOptionRegistry (genopts.py, from its template with Linux's constants, checked against the build's
  gensrc), F9's thirteen (.tmp/f9/derive.py) and JCS164's UnixDomainSockets (.tmp/unix/derive.py), each
  re-derived byte for byte as committed (their headers named the scripts they were first made by; since JCS257 (a)
  they name this namespace). An entry's
  :ops are applied in order: [OLD NEW COUNT] (OLD a string, or a regex whose NEW may name its groups, $1),
  or a function of the text; :verify, a function of the overlay, returns its problems."
  (:require [arbace.string :as str]
            [arbace.java.io :as io]))

(def jdk (or (System/getenv "JDK") "/root/jdk26u"))

(defn- header [lines]
  (str "/*\n" (apply str (map #(str " * " % "\n") lines)) " */\n"))

;; ---------------------------------------------------------------------------------------
;; JCS251 (a): the scratch derivations' tables (made from the scripts' own data by the day's port, then
;; checked byte for byte against the committed overlays)

;; F10a and F10b: sun.nio.ch.Net's natives given bodies (gennet.py's BODIES; F10b's multicast bodies)
(def ^:private net-bodies
  {"isIPv6Available0" "return HostChannels.ipv6Available0() && !Boolean.getBoolean(\"java.net.preferIPv4Stack\");"
   "isReusePortAvailable0" "return true;"
   "isExclusiveBindAvailable" "return -1;"
   "shouldShutdownWriteBeforeClose0" "return false;"
   "shouldSetBothIPv4AndIPv6Options0" "return true;"
   "canIPv6SocketJoinIPv4Group0" "return true;"
   "canJoin6WithIPv4Group0" "return false;"
   "canUseIPv6OptionsWithIPv4LocalAddress0" "return true;"
   "socket0" "int[] err = new int[1];
        int fd = HostChannels.socket0(preferIPv6 && isIPv6Available(), stream, reuse, err);
        if (fd == HostChannels.THROWN)
            throw IOUtil.sneaky(HostChannels.socketException(err[0], null));
        return fd;"
   "bind0" "int[] err = new int[1];
        if (HostChannels.bind0(IOUtil.fdVal(fd), addr.getAddress(), scope(addr), port, err)
                == HostChannels.THROWN)
            throw HostChannels.socketException(err[0], null);"
   "listen" "int[] err = new int[1];
        if (HostChannels.listen0(IOUtil.fdVal(fd), backlog, err) == HostChannels.THROWN)
            throw HostChannels.socketException(err[0], null);"
   "connect0" "int[] err = new int[1];
        int n = HostChannels.connect0(IOUtil.fdVal(fd), remote.getAddress(), scope(remote), remotePort, err);
        if (n == HostChannels.THROWN)
            throw HostChannels.socketException(err[0], null);
        return n;"
   "accept" "int[] err = new int[1];
        int[] newfdVal = new int[1];
        byte[][] addr = new byte[1][];
        int[] port = new int[2];
        int n = HostChannels.accept0(IOUtil.fdVal(fd), newfdVal, addr, port, err);
        if (n == HostChannels.THROWN)
            throw HostChannels.ioException(err[0], \"Accept failed\");
        if (n != 1)
            return n;
        IOUtil.setfdVal(newfd, newfdVal[0]);
        isaa[0] = new InetSocketAddress(inetAddress(addr[0], port[1]), port[0]);
        return 1;"
   "shutdown" "int[] err = new int[1];
        if (HostChannels.shutdown0(IOUtil.fdVal(fd), how, err) == HostChannels.THROWN)
            throw HostChannels.socketException(err[0], null);"
   "localPort" "return sockPort(fd, true);"
   "localInetAddress" "return sockAddress(fd, true);"
   "remotePort" "return sockPort(fd, false);"
   "remoteInetAddress" "return sockAddress(fd, false);"
   "getIntOption0" "int[] err = new int[1];
        int[] value = new int[1];
        if (HostChannels.getIntOption0(IOUtil.fdVal(fd), mayNeedConversion, level, opt, value, err)
                == HostChannels.THROWN)
            throw HostChannels.plainSocketException(err[0], \"sun.nio.ch.Net.getIntOption\");
        return value[0];"
   "setIntOption0" "int[] err = new int[1];
        if (HostChannels.setIntOption0(IOUtil.fdVal(fd), mayNeedConversion, level, opt, arg, isIPv6, err)
                == HostChannels.THROWN)
            throw HostChannels.plainSocketException(err[0], \"sun.nio.ch.Net.setIntOption\");"
   "poll" "int[] err = new int[1];
        int n = HostChannels.poll0(IOUtil.fdVal(fd), events, timeout, err);
        if (n == HostChannels.THROWN)
            throw HostChannels.socketException(err[0], null);
        return n;"
   "pollConnect" "int[] err = new int[1];
        int n = HostChannels.pollConnect0(IOUtil.fdVal(fd), timeout, err);
        if (n == HostChannels.THROWN)
            throw err[0] < 0 ? HostChannels.ioException(-err[0], \"poll failed\")
                             : HostChannels.socketException(err[0], null);
        return n == 1;"
   "available" "int[] err = new int[1];
        int n = HostChannels.available0(IOUtil.fdVal(fd), err);
        if (n == HostChannels.THROWN)
            throw HostChannels.socketException(err[0], null);
        return n;"
   "sendOOB" "int[] err = new int[1];
        int n = HostChannels.sendOOB0(IOUtil.fdVal(fd), data, err);
        if (n == HostChannels.THROWN)
            throw HostChannels.readWriteException(err[0], false);
        return n;"
   "discardOOB" "throw new UnsatisfiedLinkError(\"sun.nio.ch.Net.discardOOB\");"
   "joinOrDrop4" "int[] err = new int[1];
        int n = HostChannels.joinOrDrop40(IOUtil.fdVal(fd), join, group, interf, source, err);
        if (n == HostChannels.THROWN)
            throw HostChannels.socketException(err[0], \"setsockopt failed\");
        return n;"
   "blockOrUnblock4" "int[] err = new int[1];
        int n = HostChannels.blockOrUnblock40(IOUtil.fdVal(fd), block, group, interf, source, err);
        if (n == HostChannels.THROWN)
            throw HostChannels.socketException(err[0], null);
        return n;"
   "joinOrDrop6" "int[] err = new int[1];
        int n = HostChannels.joinOrDrop60(IOUtil.fdVal(fd), join, group, index, source, err);
        if (n == HostChannels.THROWN)
            throw HostChannels.socketException(err[0], \"setsockopt failed\");
        return n;"
   "blockOrUnblock6" "int[] err = new int[1];
        int n = HostChannels.blockOrUnblock60(IOUtil.fdVal(fd), block, group, index, source, err);
        if (n == HostChannels.THROWN)
            throw HostChannels.socketException(err[0], null);
        return n;"
   "setInterface4" "int[] err = new int[1];
        if (HostChannels.setInterface0(IOUtil.fdVal(fd), false, interf, err) == HostChannels.THROWN)
            throw HostChannels.socketException(err[0], null);"
   "getInterface4" "int[] err = new int[1];
        int[] value = new int[1];
        if (HostChannels.getInterface0(IOUtil.fdVal(fd), false, value, err) == HostChannels.THROWN)
            throw HostChannels.socketException(err[0], null);
        return value[0];"
   "setInterface6" "int[] err = new int[1];
        if (HostChannels.setInterface0(IOUtil.fdVal(fd), true, index, err) == HostChannels.THROWN)
            throw HostChannels.socketException(err[0], null);"
   "getInterface6" "int[] err = new int[1];
        int[] value = new int[1];
        if (HostChannels.getInterface0(IOUtil.fdVal(fd), true, value, err) == HostChannels.THROWN)
            throw HostChannels.socketException(err[0], null);
        return value[0];"
   "initIDs" ""
   "pollinValue" "return 0x0001;"
   "polloutValue" "return 0x0004;"
   "pollerrValue" "return 0x0008;"
   "pollhupValue" "return 0x0010;"
   "pollnvalValue" "return 0x0020;"
   "pollconnValue" "return 0x0004;"})

(def ^:private net-helpers
  "    // -- jrt (Arbace): the natives' helpers over jdk.internal.jrt.HostChannels --

    /** The scope id of an IPv6 address (0 for an IPv4 one or none). */
    private static int scope(InetAddress addr) {
        return (addr instanceof Inet6Address a6) ? a6.getScopeId() : 0;
    }

    /**
     * NET_SockaddrToInetAddress: the address of 4 or 16 bytes (a v4-mapped IPv6 address given
     * as its 4 bytes by the native), with scope id scope.
     */
    static InetAddress inetAddress(byte[] addr, int scope) throws IOException {
        if (addr.length == 16 && scope != 0)
            return Inet6Address.getByAddress(null, addr, scope);
        return InetAddress.getByAddress(addr);
    }

    private static InetAddress sockAddress(FileDescriptor fd, boolean local) throws IOException {
        int[] err = new int[1];
        byte[][] addr = new byte[1][];
        int[] port = new int[2];
        if (HostChannels.address0(IOUtil.fdVal(fd), local, addr, port, err) == HostChannels.THROWN)
            throw HostChannels.socketException(err[0], null);
        return inetAddress(addr[0], port[1]);
    }

    private static int sockPort(FileDescriptor fd, boolean local) throws IOException {
        int[] err = new int[1];
        byte[][] addr = new byte[1][];
        int[] port = new int[2];
        if (HostChannels.address0(IOUtil.fdVal(fd), local, addr, port, err) == HostChannels.THROWN)
            throw HostChannels.socketException(err[0], null);
        return port[0];
    }
")


                (cut "    private static boolean isLogging(QuicFrame frame) {" "    public static void logQuic(String s, Object... s1) {")
                (cut "    public static void logQuicPacketOut(String connectionTag, QuicPacket packet) {" "    public static void logError(String s, Object... s1) {")]
               (system-logger 0 3 1)))
   (http "jdk/internal/net/http/common/Logger.java" "System.Logger as jdk.internal.jrt.SystemLoggers.Logger (JCS155)" (system-logger 0 2 0))
   (http "jdk/internal/net/http/common/DebugLogger.java" "System.Logger as jdk.internal.jrt.SystemLoggers.Logger (JCS155)" (system-logger 0 14 3))
   (http "jdk/internal/net/http/common/Utils.java" "System.Logger as jdk.internal.jrt.SystemLoggers.Logger (JCS155)" (system-logger 1 3 0))
   (http "jdk/internal/net/http/hpack/HPACK.java" "System.Logger as jdk.internal.jrt.SystemLoggers.Logger (JCS155)" (system-logger 0 14 0))
   (http "jdk/internal/net/http/Http1Response.java" "System.Logger as jdk.internal.jrt.SystemLoggers.Logger (JCS155)" (system-logger 1 0 0))
   (http "jdk/internal/net/http/WindowController.java" "System.Logger as jdk.internal.jrt.SystemLoggers.Logger (JCS155)" (system-logger 1 0 0))
   (http "jdk/internal/net/http/RawChannelTube.java"
         "the WebSocket debug's Cleaner dropped (no Cleaner in the Go build; it only checked a debug invariant); System.Logger as jdk.internal.jrt.SystemLoggers.Logger (JCS155)"
         (into [["import java.lang.ref.Cleaner;\n" "" 1]
                ["    private static final Cleaner cleaner =\n            Utils.ASSERTIONSENABLED  && Utils.DEBUG_WS ? Cleaner.create() : null;\n" "" 1]
                ["        if (Utils.ASSERTIONSENABLED && Utils.DEBUG_WS) {\n            // this is just for debug...\n            cleaner.register(this, new CleanupChecker(closed, debug));\n        }\n" "" 1]]
               (system-logger 1 2 0)))
   (http "jdk/internal/net/http/HttpClientFacade.java"
         "no Cleaner (not in the Go build): the selector manager notices a collected facade at its next wake-up (NODEADLINE, 3 s), as the JDK's does when the Cleaner has not run yet"
         [["import java.lang.ref.Cleaner;\n" "" 1]
          ["import jdk.internal.ref.CleanerFactory;\n" "" 1]
          ["    static final Cleaner cleaner = CleanerFactory.cleaner();\n\n" "" 1]
          ["        // wakeup the impl when the facade is gc'ed\n        cleaner.register(this, impl::facadeCleanup);\n" "" 1]])])

;; F15 (doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: F15 (java.lang.invoke)"): java.lang.invoke's classes that
;; run over jrt's handles as jdk26u wrote them, but for what names the LambdaForm machinery or the VM
(def ^:private invoke-why
  ["Arbace (overlay/jdk, doc/classes/JAVA-DEFERRED-TRIAGE.md, \"As built: F15 (java.lang.invoke)\"): jdk26u's"
   "%s (src/java.base/share/classes/%s"
   "at https://github.com/openjdk/jdk26u baf63fb), derived by test/jrt/derive.ae (bin/jrt-convert derive): %s;"
   "nothing else changed. jdk26u's text Copyright (c) Oracle and/or its affiliates, under the GNU General Public"
   "License version 2 with the Classpath Exception (LICENSE.md); the derivation Copyright (c) the Arbace authors;"
   "Eclipse Public License 1.0."])

(defn- invoke-derivation [rel what ops]
  {:path rel
   :from (str "src/java.base/share/classes/" rel)
   :header (fn [] (header (-> invoke-why
                              (update 1 #(format % (-> rel (str/replace ".java" "") (str/replace "/" ".")) rel))
                              (update 2 #(format % what)))))
   :ops ops})

(def ^:private invoke-derivations
  [(invoke-derivation "java/lang/invoke/MethodType.java"
     "the cache of the type's Invokers (the LambdaForm invokers jrt's handles do not use) left out"
     [["    private @Stable Invokers invokers;   // cache of handy higher-order adapters\n" "" 1]
      ["    /*non-public*/\n    Invokers invokers() {\n        Invokers inv = invokers;\n        if (inv != null)  return inv;\n        invokers = inv = new Invokers(this);\n        return inv;\n    }\n\n" "" 1]])
   (invoke-derivation "java/lang/invoke/MethodTypeForm.java"
     "the caches of LambdaForms and of the interpreter's entry (MemberName) left out: jrt's handles have neither"
     [["    // Cached lambda form information, for basic types only:\n    private final SoftReference<LambdaForm>[] lambdaForms;\n\n    private SoftReference<MemberName> interpretEntry;\n" "" 1]
      (cut "    public LambdaForm cachedLambdaForm(int which) {" "    /**\n     * Build an MTF for a given type")
      ["            this.lambdaForms   = new SoftReference[LF_LIMIT];\n" "" 1]
      ["            this.lambdaForms = null;\n" "" 1]])
   (invoke-derivation "java/lang/invoke/LambdaMetafactory.java"
     "the metafactory jrt's ProxyLambdaMetafactory (instances as java.lang.reflect.Proxy's, JCS170) in place of InnerClassLambdaMetafactory (a hidden class spun as bytecode)"
     [["new InnerClassLambdaMetafactory(" "new ProxyLambdaMetafactory(" 2]])
   (invoke-derivation "sun/invoke/util/VerifyAccess.java"
     (str "jdk.internal.reflect.Reflection's two answers from java.lang.Class (nestmates by their nest hosts, a class's "
          "access flags as its class file has them from its modifiers: a protected member class public, a private one "
          "package-private); the packages compared by their names' equality (jrt does not intern them); no module "
          "boundary (the Go build's closed world has none, as its reflection checks none: a public class is accessible)")
     [["import jdk.internal.reflect.Reflection;\n" "" 1]
      ["Reflection.areNestMates(defc, lookupClass)" "(defc.getNestHost() == lookupClass.getNestHost())" 1]
      ["        return Reflection.getClassAccessFlags(c);"
       "        int mods = c.getModifiers();\n        return ((mods & (PUBLIC | PROTECTED)) != 0) ? ((mods & ~(PROTECTED | PRIVATE | STATIC)) | PUBLIC)\n                                                    : (mods & ~(PRIVATE | STATIC));" 1]
      (cut "            Module lookupModule = lookupClass.getModule();\n            Module refModule = refc.getModule();\n\n            // early VM startup case"
           "            // public class not accessible to lookupClass\n            return false;")
      ["            // public class not accessible to lookupClass\n            return false;"
       "            // the Go build: no module boundary\n            return true;" 1]
      (cut "        Module refModule = refc.getModule();\n        assert refModule != m1 || refModule != m2;"
           "    }\n\n    /**\n     * Decide if the given method type")
      ["    public static boolean isModuleAccessible(Class<?> refc,  Module m1, Module m2) {\n"
       "    public static boolean isModuleAccessible(Class<?> refc,  Module m1, Module m2) {\n        // the Go build: no module boundary\n        return isPublic(getClassModifiers(refc));\n" 1]
      ["        return class1.getPackageName() == class2.getPackageName();"
       "        return class1.getPackageName().equals(class2.getPackageName());" 1]])])

;; h-java-deferred (2026-11-17; doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: h-java-deferred (write-ahead)"): the
;; interpreted check's largest remaining causes after B2, each a class outside the closed world that jdk26u's file names
;; on a path every caller takes: ObjectInputFilter's System.Logger (every ObjectInputStream's filter factory logs at
;; TRACE through it), java.util.logging's DefaultLoggerFinder.isSystem (every logger LogManager demands for a module),
;; and sun.invoke.util.Wrapper (MethodType's, out of the world since F26 left it, 2026-11-16, with its ClassDescs)
(def ^:private hjd-why
  ["Arbace (overlay/jdk, doc/classes/JAVA-DEFERRED-TRIAGE.md, \"As built: h-java-deferred (write-ahead)\"): jdk26u's"
   "%s (%s"
   "at https://github.com/openjdk/jdk26u baf63fb), derived by test/jrt/derive.ae (bin/jrt-convert derive): %s;"
   "nothing else changed. jdk26u's text Copyright (c) Oracle and/or its affiliates, under the GNU General Public"
   "License version 2 with the Classpath Exception (LICENSE.md); the derivation Copyright (c) the Arbace authors;"
   "Eclipse Public License 1.0."])

(defn- hjd-derivation [module rel what ops]
  (let [from (str "src/" module "/share/classes/" rel)]
    {:path rel
     :from from
     :header (fn [] (header (-> hjd-why
                                (update 1 #(format % (-> rel (str/replace ".java" "") (str/replace "/" ".")) from))
                                (update 2 #(format % what)))))
     :ops ops}))

(def ^:private logger-is-system
  "DefaultLoggerFinder.isSystem (jdk.internal.logger, outside the Go build's world) as jdk.internal.jrt.SystemLoggers.isSystem,
  the same answer (VM.isSystemDomainLoader of the module's loader)"
  [["import static jdk.internal.logger.DefaultLoggerFinder.isSystem;\n" "" 1]])

(def ^:private hjd-derivations
  [(hjd-derivation "java.base" "java/io/ObjectInputFilter.java"
     "System.Logger, which jrt's hand-written java.lang.System has not (JCS155), as jdk.internal.jrt.SystemLoggers.Logger (F24's rule): its Level's constants statically imported from there, System.getLogger as SystemLoggers.getLogger"
     [[#"import static java\.lang\.System\.Logger\.Level\.(\w+);" "import static jdk.internal.jrt.SystemLoggers.Logger.Level.$1;" 3]
      ["private static final System.Logger configLog;" "private static final jdk.internal.jrt.SystemLoggers.Logger configLog;" 1]
      ["System.getLogger(\"java.io.serialization\")" "jdk.internal.jrt.SystemLoggers.getLogger(\"java.io.serialization\")" 1]])
   (hjd-derivation "java.logging" "java/util/logging/Logger.java"
     "DefaultLoggerFinder.isSystem (jdk.internal.logger is outside the Go build's world) as jdk.internal.jrt.SystemLoggers.isSystem, the same answer"
     (conj logger-is-system ["isSystem(" "jdk.internal.jrt.SystemLoggers.isSystem(" 2]))
   (hjd-derivation "java.logging" "java/util/logging/LogManager.java"
     "DefaultLoggerFinder.isSystem (jdk.internal.logger is outside the Go build's world) as jdk.internal.jrt.SystemLoggers.isSystem, the same answer"
     (conj logger-is-system ["isSystem(" "jdk.internal.jrt.SystemLoggers.isSystem(" 1]))
   (hjd-derivation "java.base" "sun/invoke/util/Wrapper.java"
     "the nominal descriptors (basicClassDescriptor, wrapperClassDescriptor: java.lang.constant's ClassDescs, the class-file API's, outside the Go build's world since F26 left it) left out"
     [["\nimport java.lang.constant.ClassDesc;\nimport java.lang.constant.ConstantDescs;\n" "" 1]
      ["    //        basicClassDescriptor    wrapperClassDescriptor\n" "" 1]
      [#",\n            ConstantDescs\.CD_\w+, ConstantDescs\.CD_\w+\)" ")" 10]
      ["    private final ClassDesc basicClassDesc;\n    private final ClassDesc wrapperClassDesc;\n" "" 1]
      [",\n            ClassDesc basicClassDesc,\n            ClassDesc wrapperClassDesc) {" ") {" 1]
      ["        this.basicClassDesc = basicClassDesc;\n        this.wrapperClassDesc = wrapperClassDesc;\n" "" 1]
      ["    /** A nominal descriptor of the wrapped type */\n    public ClassDesc basicClassDescriptor() { return basicClassDesc; }\n\n    /** A nominal descriptor of the wrapper type */\n    public ClassDesc wrapperClassDescriptor() { return wrapperClassDesc; }\n\n" "" 1]])])

(def derivations
  "Each derived overlay: :path below overlay/jdk/java.base, :from (jdk26u's file, relative to the checkout),
  :ops [[OLD NEW COUNT] or a function ...] (OLD a string or a regex, found exactly COUNT times, every one
  replaced; a function of the text), :header (the Arbace comment before the result: a string or a function),
  :verify (a function of the overlay: its problems)."
  (concat
  [{:path "java/nio/DirectByteBuffer.java" :from (str gensrc "java/nio/HeapByteBuffer.java")
    :header header-DirectByteBuffer :ops (direct-ops false)}
   {:path "java/nio/DirectByteBufferR.java" :from (str gensrc "java/nio/HeapByteBufferR.java")
    :header header-DirectByteBufferR :ops (direct-ops true)}
   {:path "sun/nio/ch/Net.java" :from "src/java.base/share/classes/sun/nio/ch/Net.java" :header net-header
    :ops [net-natives
          ["    private static AssertionError shouldNotReachHere()"
           (str net-helpers "\n    private static AssertionError shouldNotReachHere()") 1]
          ["import sun.net.util.IPAddressUtil;\n" "import sun.net.util.IPAddressUtil;\nimport jdk.internal.jrt.HostChannels;\n" 1]]
    :verify (fn [out] (when (str/includes? (str/replace out #"//.*|/\*(?:.|\n)*?\*/" "") "native ")
                        ["sun/nio/ch/Net.java: a native left"]))}
   {:path "sun/nio/ch/PollSelectorImpl.java" :from "src/java.base/unix/classes/sun/nio/ch/PollSelectorImpl.java"
    :header poll-header :ops poll-ops
    :verify (fn [out] (for [w ["pollArray." "Unsafe" "Blocker"] :when (str/includes? out w)]
                        (str "sun/nio/ch/PollSelectorImpl.java: " w " left")))}
   {:path "sun/nio/ch/SocketOptionRegistry.java"
    :from "src/java.base/share/classes/sun/nio/ch/SocketOptionRegistry.java.template"
    :header "" :ops [socket-options] :verify options-as-built}
   {:path "sun/nio/ch/UnixDomainSockets.java" :from "src/java.base/share/classes/sun/nio/ch/UnixDomainSockets.java"
    :header unix-header :ops unix-ops
    :verify (no-native #"\bnative\s+[\w\[\]]+\s+\w+\(" "sun/nio/ch/UnixDomainSockets.java")}
   {:path "sun/nio/ch/InheritedChannel.java" :from "src/java.base/unix/classes/sun/nio/ch/InheritedChannel.java"
    :header inherited-header :ops inherited-ops
    :verify (no-native #"\bnative\s+[\w\[\]]+\s+\w+\(" "sun/nio/ch/InheritedChannel.java")}
   {:path "jdk/net/ExtendedSocketOptions.java" :from "src/jdk.net/share/classes/jdk/net/ExtendedSocketOptions.java"
    :header extopts-header :ops extopts-ops}
   {:path "jdk/net/LinuxSocketOptions.java" :from "src/jdk.net/linux/classes/jdk/net/LinuxSocketOptions.java"
    :header linuxopts-header :ops linuxopts-ops
    :verify (no-native #"\bnative\s+[\w\[\]]+\s+\w+\(" "jdk/net/LinuxSocketOptions.java")}]
  (for [{:keys [path kind header ops]} f9]
    {:path path :from (str "src/java.base/" kind "/classes/" path) :header header :ops ops})
  [(httpserver "sun/net/httpserver/ServerImpl.java"
               [(conj import-logger 1) (conj import-level 1)
                ["System.getLogger (\"com.sun.net.httpserver\")"
                 "jdk.internal.jrt.SystemLoggers.getLogger (\"com.sun.net.httpserver\")" 1]
                ;; jrt's Thread has no thread groups and no stack sizes: Thread(Runnable, String), the current
                ;; thread's group as a null group gives, the default stack as 0 asks; jdk26u's false (no
                ;; inheritable thread locals inherited) is not kept, the dispatcher's code reads none
                ["new Thread(null, dispatcher, \"HTTP-Dispatcher\", 0, false)"
                 "new Thread(dispatcher, \"HTTP-Dispatcher\")" 1]])
   (httpserver "sun/net/httpserver/ExchangeImpl.java" [(conj import-logger 1) (conj import-level 1)])
   (httpserver "sun/net/httpserver/HttpConnection.java" [(conj import-logger 1) (conj import-level 1)])
   (httpserver "sun/net/httpserver/HttpContextImpl.java" [(conj import-logger 1)])
   (httpserver "sun/net/httpserver/ServerConfig.java" [(conj import-logger 1) (conj import-level 1)])]
  jmx-derivations
  [accessflag-derivation]
  [parameter-derivation]
  ta-derivations
  rmi-derivations
  jmx2-derivations
  http-derivations
  invoke-derivations
  hjd-derivations))

;; ---------------------------------------------------------------------------------------

(defn- occurrences [^String s ^String sub]
  (loop [i 0 n 0]
    (let [j (.indexOf s sub i)]
      (if (neg? j) n (recur (+ j (count sub)) (inc n))))))

(defn derive-text
  "The overlay's text: jdk26u's file with the ops applied in order, the header first. Throws when a replacement
  does not match as often as the table says."
  [{:keys [path from header ops]}]
  (let [src (slurp (str jdk "/" from))
        out (reduce (fn [^String s op]
                      (if (fn? op)
                        (op s)
                        (let [[old new n] op
                              k (if (string? old) (occurrences s old) (count (re-seq old s)))]
                          (when (not= k n)
                            (throw (ex-info (str path ": " (pr-str old) " found " k " times, not " n)
                                            {:path path :old old :found k :expected n})))
                          (if (string? old) (.replace s ^CharSequence old ^CharSequence new) (str/replace s old new)))))
                    src ops)]
    (str (if (fn? header) (header) header) out)))

(defn- target [path] (str "overlay/jdk/java.base/" path))

(defn -main [& args]
  (let [check? (some #{"--check"} args)
        names (set (remove #{"--check"} args))
        ds (filter #(or (empty? names) (names (:path %))) derivations)
        bad (atom 0)]
    (when (and (seq names) (not= (count ds) (count names)))
      (binding [*out* *err*] (println "jrt.derive: no derivation of" (pr-str (remove (set (map :path ds)) names))))
      (System/exit 2))
    (doseq [d ds
            :let [t (derive-text d) f (io/file (target (:path d)))]]
      (doseq [p (when-let [v (:verify d)] (v t))]
        (swap! bad inc) (println "PROBLEM  " p))
      (if check?
        (let [have (when (.exists f) (slurp f))]
          (if (= have t)
            (println "same     " (:path d))
            (do (swap! bad inc) (println (if have "DIFFERS  " "MISSING  ") (:path d)))))
        (do (io/make-parents f) (spit f t) (println "derived  " (:path d)))))
    ;; the check's negative control (GTS81 (a)'s rule, JCS251 (a)'s gate step): a derivation whose table miscounts a
    ;; replacement by one must fail, and an overlay one character off must differ
    (when (and check? (empty? names))
      (let [d (first (filter #(= "sun/nio/ch/PollSelectorImpl.java" (:path %)) derivations))
            i (first (keep-indexed (fn [i op] (when (vector? op) i)) (:ops d)))
            miscounted (update-in d [:ops i 2] inc)
            failed? (try (derive-text miscounted) false (catch Exception _ true))
            differs? (not= (str (derive-text d) "x") (derive-text d))]
        (if (and failed? differs?)
          (println "control  a miscounted replacement fails, an overlay one character off differs")
          (do (swap! bad inc) (println "CONTROL  passed what must fail:" (pr-str {:miscounted-failed failed? :differs differs?}))))))
    (println (str "jrt.derive: " (count ds) " overlays" (when check? (str ", " @bad " not as derived"))))
    (System/exit (if (pos? @bad) 1 0))))

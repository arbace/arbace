;; JCS164: sun.nio.ch.UnixDomainSockets (.tmp/unix/derive.py's replacements, each once)
(def ^:private unix-ops
  [["import java.util.Random;
import sun.nio.fs.AbstractFileSystemProvider;
"
    "import java.util.Random;
import jdk.internal.jrt.HostChannels;
import sun.nio.fs.AbstractFileSystemProvider;
" 1]
   ["    private static native byte[] localAddress0(FileDescriptor fd) throws IOException;
"
    "    // Arbace: UnixDomainSockets.c's localAddress0 (getsockname), its sockaddrToUnixAddressBytes in Go
    private static byte[] localAddress0(FileDescriptor fd) throws IOException {
        int[] err = new int[1];
        byte[][] path = new byte[1][];
        if (HostChannels.unixLocalAddress0(IOUtil.fdVal(fd), path, err) == HostChannels.THROWN)
            throw HostChannels.socketException(err[0], null);
        return path[0];
    }
" 1]
   ["    private static native boolean init();

    private static native int socket0() throws IOException;

    private static native void bind0(FileDescriptor fd, byte[] path)
        throws IOException;

    private static native int connect0(FileDescriptor fd, byte[] path)
        throws IOException;

    private static native int accept0(FileDescriptor fd, FileDescriptor newfd, Object[] array)
        throws IOException;
"
    "    // Arbace: UnixDomainSockets.c's natives over jdk.internal.jrt.HostChannels (go/arbace/jrt/channels_linux.ae):
    // the same system calls and results, an error's number in err[0] where the C throws (handleSocketError, Net.c's,
    // is HostChannels.socketException; JNU_ThrowIOExceptionWithLastError is HostChannels.ioException)
    private static boolean init() {
        return true;
    }

    private static int socket0() throws IOException {
        int[] err = new int[1];
        int fd = HostChannels.unixSocket0(err);
        if (fd == HostChannels.THROWN)
            throw HostChannels.socketException(err[0], null);
        return fd;
    }

    // unixSocketAddressToSockaddr's check: nio_util.h's MAX_UNIX_DOMAIN_PATH_LEN, sizeof(sun_path) - 2
    private static void checkPathLength(byte[] path) throws IOException {
        if (path.length > HostChannels.MAX_UNIX_DOMAIN_PATH_LEN)
            throw new java.net.SocketException(\"Unix domain path too long\");
    }

    private static void bind0(FileDescriptor fd, byte[] path)
        throws IOException {
        checkPathLength(path);
        int[] err = new int[1];
        if (HostChannels.unixBind0(IOUtil.fdVal(fd), path, err) == HostChannels.THROWN)
            throw HostChannels.socketException(err[0], null);
    }

    private static int connect0(FileDescriptor fd, byte[] path)
        throws IOException {
        checkPathLength(path);
        int[] err = new int[1];
        int n = HostChannels.unixConnect0(IOUtil.fdVal(fd), path, err);
        if (n == HostChannels.THROWN)
            throw HostChannels.socketException(err[0], null);
        return n;
    }

    private static int accept0(FileDescriptor fd, FileDescriptor newfd, Object[] array)
        throws IOException {
        int[] err = new int[1];
        int[] newfdVal = new int[1];
        byte[][] path = new byte[1][];
        int n = HostChannels.unixAccept0(IOUtil.fdVal(fd), newfdVal, path, err);
        if (n == HostChannels.THROWN)
            throw HostChannels.ioException(err[0], \"Accept failed\");
        if (n != 1)
            return n;
        IOUtil.setfdVal(newfd, newfdVal[0]);
        array[0] = path[0];
        return 1;
    }
" 1]

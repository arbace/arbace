(def ^:private linuxopts-header
  "/*
 * Arbace (overlay/jdk, doc/classes/JAVA-DEFERRED-TRIAGE.md, \"As built: JCS200\"): jdk26u's jdk.net.LinuxSocketOptions
 * (https://github.com/openjdk/jdk26u at baf63fb, src/jdk.net/linux/classes/jdk/net/LinuxSocketOptions.java), derived
 * mechanically (test/jrt/derive.ae, each replacement asserted once): its natives (LinuxSocketOptions.c's) given bodies
 * over jdk.internal.jrt.HostChannels, no library loaded; the rest is jdk26u's. The changes Copyright (c) the Arbace
 * authors; Eclipse Public License 1.0. jdk26u's notice follows.
 */
")

;; F7: the generated heap buffer made a direct one; the counts are each file's
(defn- direct-ops [r?]
  (let [c (fn [plain readonly] (if r? readonly plain))]
    (vec (remove #(and (vector? %) (zero? (nth % 2)))
                 [(fn [s] (subs s (str/index-of s "package java.nio;")))
                  ["import java.util.Objects;" "import java.util.Objects;\nimport jdk.internal.jrt.HostFileChannels;" 1]
                  ["HeapByteBufferR" "DirectByteBufferR" (c 2 7)]
                  ["HeapByteBuffer" "DirectByteBuffer" (c 8 2)]
                  ["    extends ByteBuffer\n" "    extends MappedByteBuffer\n" (c 1 0)]
                  ["public ByteBuffer slice()" "public MappedByteBuffer slice()" 1]
                  ["public ByteBuffer slice(int index, int length)" "public MappedByteBuffer slice(int index, int length)" 1]
                  ["public ByteBuffer duplicate()" "public MappedByteBuffer duplicate()" 1]
                  ["public ByteBuffer compact()" "public MappedByteBuffer compact()" 1]
                  ;; the protected constructor and its super call gain the mapping
                  ["int off, MemorySegment segment)" "int off, MemorySegment segment,\n                                   HostFileChannels.Mapping mapping)" 1]
                  ["super(mark, pos, lim, cap, buf, off, segment);" "super(mark, pos, lim, cap, buf, off, segment, mapping);" (c 1 0)]
                  ["super(buf, mark, pos, lim, cap, off, segment);" "super(buf, mark, pos, lim, cap, off, segment, mapping);" (c 0 1)]
                  ["super(-1, 0, lim, cap, new byte[cap], 0, segment);" "super(-1, 0, lim, cap, new byte[cap], 0, segment, null);" (c 1 0)]
                  ["super(-1, off, off + len, buf.length, buf, 0, segment);" "super(-1, off, off + len, buf.length, buf, 0, segment, null);" (c 1 0)]
                  ;; buffers made from this one: the same mapping
                  [#"(new DirectByteBufferR?\(hb,[^;]*?segment)\)" "$1, mapping)" (c 4 3)]
                  ;; DirectByteBuffer alone: ByteBuffer.allocateDirect's constructor, the JDK's over an address, the
                  ;; mapped buffers' factory
                  ["    DirectByteBuffer(int cap, int lim, MemorySegment segment)"
                   (str direct-ctor "    DirectByteBuffer(int cap, int lim, MemorySegment segment)") (c 1 0)]]))))

(def ^:private gensrc "build/linux-x86_64-server-release/support/gensrc/java.base/")

;; F10a: Net's natives, each declaration given its body (gennet.py's repl)
(defn- net-natives [^String s]
  (let [done (atom #{})
        out (str/replace s #"(?m)^[ \t]*(?:(?:public|private|static|protected)\s+)*native\b[^;{]*;"
                         (fn [^String decl]
                           (let [nm (second (re-find #"(\w+)\s*\(" (subs decl 0 (inc (str/index-of decl "(")))))
                                 body (get net-bodies nm)
                                 _ (when-not body (throw (ex-info (str "no body for native " nm) {})))
                                 _ (swap! done conj nm)
                                 d (str/trimr (let [d (str/replace decl #"\bnative\s+" "")] (subs d 0 (dec (count d)))))]
                             (if (seq body) (str d " {\n        " body "\n    }") (str d " {\n    }")))))
        missing (remove @done (keys net-bodies))]
    (when (seq missing) (throw (ex-info (str "bodies for no native: " (str/join " " (sort missing))) {})))
    out))

(defn- no-native [re what]
  (fn [out] (when (re-find re out) [(str what ": a native declaration left")])))

;; F10a: SocketOptionRegistry from its template, as GensrcMisc.gmk's generate-preproc-src (genopts.py)
(def ^:private socket-constants
  ;; Linux's values (the generic UAPI's asm-generic/socket.h, netinet/in.h, netinet/tcp.h: amd64 and arm64 alike)
  (array-map "SOL_SOCKET" 1 "SO_BROADCAST" 6 "SO_KEEPALIVE" 9 "SO_LINGER" 13 "SO_SNDBUF" 7
             "SO_RCVBUF" 8 "SO_REUSEADDR" 2 "SO_REUSEPORT" 15 "SO_OOBINLINE" 10 "TCP_NODELAY" 1
             "IP_TOS" 1 "IP_MULTICAST_IF" 32 "IP_MULTICAST_TTL" 33 "IP_MULTICAST_LOOP" 34
             "IPV6_TCLASS" 67 "IPV6_MULTICAST_IF" 17 "IPV6_MULTICAST_HOPS" 18 "IPV6_MULTICAST_LOOP" 19))

(defn- socket-options [^String t]
  (let [head (subs t 0 (str/index-of t "@@END_COPYRIGHT@@"))
        body (subs t (+ (str/index-of t "@@START_HERE@@") (count "@@START_HERE@@")))
        body (str/join "\n" (map #(if (str/starts-with? % "#") "" %) (str/split body #"\n" -1)))
        body (str/replace body (re-pattern (str "\\b(" (str/join "|" (keys socket-constants)) ")\\b"))
                          (fn [[_ k]] (str (get socket-constants k))))
        body (str/replace body "PREFIX_" "")]
    (str head
         "// Arbace (overlay/jdk, F10 of doc/classes/JAVA-DEFERRED-TRIAGE.md, \"As built: F10a\"): jdk26u's\n"
         "// template with Linux's constants, derived by test/jrt/derive.ae in place of the C preprocessor.\n"
         "// AUTOMATICALLY GENERATED FILE - DO NOT EDIT"
         body)))

(defn- option-tuples [s]
  (vec (re-seq #"map\.put\(newRegistryKey\(([\w.]+),([\w.]+)\),newOptionKey\((\d+),(\d+)\)\)"
               (str/replace s #"\s+" ""))))

(defn- options-as-built [out]
  ;; genopts.py's check: the (option, family, level, name) tuples are the JDK build's gensrc's
  (let [a (option-tuples out) b (option-tuples (slurp (str jdk "/" gensrc "sun/nio/ch/SocketOptionRegistry.java")))]
    (when-not (and (seq a) (= a b)) [(str "sun/nio/ch/SocketOptionRegistry.java: " (count a) " options, not the build's " (count b))])))


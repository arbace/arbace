;; JCS254 (b): java.net.http's client without HTTP/3 (HTTP/1.1, HTTP/2 and WebSocket; doc/classes/JAVA-DEFERRED-TRIAGE.md,
;; "As built: JCS254 (b)"): the files that name HTTP/3's classes (jdk.internal.net.http.http3, .quic, .qpack, Http3*,
;; HttpQuicConnection, H3FrameOrderVerifier: not in the Go build) cut to the client a JDK whose SSLContext is not QUIC
;; compatible has (HttpClientImpl's client3 null: the code's own path without HTTP/3), System.Logger as F24's
;; jdk.internal.jrt.SystemLoggers.Logger (JCS155, JCS250), and the facade's Cleaner dropped (no Cleaner in the Go build:
;; the selector manager notices a collected facade at its next wake-up, NODEADLINE, 3 s, as the JDK's does without it)

(defn- cut
  "An op removing the text from start (inclusive) to end (exclusive, searched after start), each found once."
  [start end]
  (fn [^String s]
    (let [i (.indexOf s ^String start)
          j (when (>= i 0) (.indexOf s ^String end (+ i (count start))))]
      (when (or (neg? i) (not= i (.lastIndexOf s ^String start)) (nil? j) (neg? j))
        (throw (ex-info (str "cut: " (pr-str (subs start 0 (min 60 (count start)))) " .. "
                             (pr-str (subs end 0 (min 60 (count end)))) " not found once")
                        {:start start :end end})))
      (str (subs s 0 i) (subs s j)))))

(defn- system-logger
  "System.Logger as jdk.internal.jrt.SystemLoggers.Logger: the Level import (imports, then the qualified names, count n),
  System.getLogger (count g)."
  [imports n g]
  (cond-> []
    (pos? imports) (conj ["import java.lang.System.Logger.Level;" "import jdk.internal.jrt.SystemLoggers.Logger.Level;" imports])
    (pos? n) (conj [#"(?<![\w.])System\.Logger\b" "jdk.internal.jrt.SystemLoggers.Logger" n])
    (pos? g) (conj ["System.getLogger(" "jdk.internal.jrt.SystemLoggers.getLogger(" g])))


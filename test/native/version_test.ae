(ns native.version-test
  "Arbace's version (doc/VENDOR-NOTES.md, hand change 20) and data_readers.ae (hand change 21),
  on the stage bin/native-tests runs: *arbace-version* as bin/build-arbace wrote it into the
  stage (arbace/version.edn), the REPL's banner, and a data_readers.ae at the root of the class
  path, beside a data_readers.clj, in a fresh JVM on the same class path plus a temporary
  directory. The Go build's checks are in bin/arbace-go --smoke."
  (:require [arbace.test :refer [deftest is testing]]
            [arbace.java.io :as io]
            [arbace.string :as str]))

(defn- run-java
  "Runs arbace.lang.Main in a new JVM on this one's class path plus extra, with args and the
  text in; its standard output and error."
  [extra in & args]
  (let [java (str (System/getProperty "java.home") "/bin/java")
        cp (str (System/getProperty "java.class.path") (when extra (str java.io.File/pathSeparator extra)))
        p (.start (doto (ProcessBuilder. ^java.util.List (into [java "-cp" cp "arbace.lang.Main"] args))
                    (.redirectErrorStream true)))]
    (with-open [w (io/writer (.getOutputStream p))] (.write w ^String in))
    (let [out (slurp (.getInputStream p))]
      (.waitFor p)
      out)))

(deftest arbace-version-map
  (let [{:keys [describe commit dirty] :as v} *arbace-version*]
    (is (= #{:describe :commit :dirty} (set (keys v))))
    (is (string? describe))
    (is (= describe (arbace-version)))
    (is (and (string? commit) (re-matches #"[0-9a-f]{40}" commit)) "built from a commit")
    (is (boolean? dirty))
    (is (= (boolean dirty) (str/ends-with? describe "-dirty")))
    (testing "*clojure-version* stays, for libraries"
      (is (= "1.13.0-master-SNAPSHOT" (clojure-version))))))

(deftest banner
  (let [{:keys [describe commit]} *arbace-version*]
    (is (= (str "Arbace " describe " (" (subs commit 0 7) ")")
           (first (str/split-lines (run-java nil "")))))))

(deftest data-readers-ae
  (let [dir (io/file (System/getProperty "arbace.tmp" (System/getProperty "java.io.tmpdir"))
                     (str "data-readers-" (System/nanoTime)))]
    (try
      (io/make-parents (io/file dir "dr" "x"))
      (spit (io/file dir "data_readers.ae") "{dr.ae/tag dr.fns/from-ae}")
      (spit (io/file dir "data_readers.clj") "{dr.clj/tag dr.fns/from-clj}")
      (spit (io/file dir "dr" "fns.ae")
            "(ns dr.fns) (defn from-ae [x] [:ae x]) (defn from-clj [x] [:clj x])")
      (is (= "[[:ae 1] [:clj 2]]"
             (str/trim (run-java (str dir) "" "-e"
                                 "(require 'dr.fns) (prn (read-string \"[#dr.ae/tag 1 #dr.clj/tag 2]\"))"))))
      (finally
        (doseq [^java.io.File f (reverse (file-seq dir))] (.delete f))))))

(ns go.arbace.waidriver
  (:require [arbace.go :as go]))

(go/package main
  :path "arbace/waidriver"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["buildok.go" "gojs.go" "main.go" "run.go" "w2g.go" "w2gcases.go"]
  :init-order [w2gControl w2gAlways]
  :positions :lines)

(load "waidriver/buildok")
(load "waidriver/gojs")
(load "waidriver/main")
(load "waidriver/run")
(load "waidriver/w2g")
(load "waidriver/w2gcases")

^{:go/end 717} (go/func control "control: the command K of a plan judged in another role (doc/wasm/WAI.md §5.4); differs when its judge rejects it\n" ^string [^string plan ^string dir ^string k ^string mode ^string plan2 ^string k2]
  (set! wai/Profile (wai/ProfileOf plan))
  (let [(values lines err) (readPlan plan)]
    (when (!= err nil)
      (return (+ "error: " (.Error err))))

    (when (== mode "as-interpreted")
      ;; WA7's control: an AOT program with its translated functions not attached, the command run by the interpreter, which
      ;; the AOT level's judge must refuse (it passes on the interpreter alone)
      (when (== (wai/AOTCount) 0)
        (return "error: not an AOT program"))

      (wai/AOTDisable)
      (set! mode "self"))

    (let [r (newRunner dir)]
      (when (or (== mode "valid-flip") (== mode "valid-self"))
        ;; the validator's row of command K's module judged against the opposite verdict (it must fail) or its own (it must pass)
        (range [_ l lines]
          (when (or (!= (.-k l) k) (< (len (.-f l)) 3) (!= (aget (.-f l) 0) "valid"))
            (continue))

          (let [v (aget (.-f l) 2)]
            (when (== mode "valid-flip")
              (if (== v "ok")
                (set! v (+ "invalid:" (hex/EncodeToString (conv (slice byte) "control"))))

                (set! v "ok")))


            (when [x (.validRow r (+ "testsuite/c#" k) (aget (.-f l) 1) v)] (!= (.-result x) ":pass")
              (return "differs"))

            (return "same")))

        (return (+ "error: no valid line " k)))

      (range [_ l lines]
        (when (!= (.-k l) k)
          (.command r (+ "c#" (.-k l)) (.-f l))
          (continue))

        (let [f (append (lit (slice string)) (spread (.-f l)))]
          (switch mode
            (case ["self"])
            ;; the positive check: the command as it is, which must pass
            (case ["wrong-value"]
              ;; the first expected result changed in its lowest bit
              (when (!= (aget f 0) "assert_return")
                (return "error: not an assert_return"))

              (let [want (fields (aget f 5))]
                (when (== (len want) 0)
                  (return "error: no result"))

                (let [(values kk v _) (strings/Cut (aget want 0) ":")
                    (values x err) (strconv/ParseUint v 16 64)]
                  (when (!= err nil)
                    (return (+ "error: " (aget want 0))))

                  (aset want 0 (+ kk ":" (strconv/FormatUint (bit-xor x 1) 16)))
                  (aset f 5 (strings/Join want " ")))))
            (case ["as-trap"]
              ;; an assert_return judged as an assert_trap: it returns, so it must fail
              (when (!= (aget f 0) "assert_return")
                (return "error: not an assert_return"))

              (aset f 0 "assert_trap")
              (aset f 5 (hex/EncodeToString (conv (slice byte) "unreachable"))))
            (case ["as-return"]
              ;; an assert_trap (assert_exhaustion, assert_exception) judged as an assert_return of no result: it traps
              (switch (aget f 0)
                (case ["assert_trap" "assert_exhaustion"]
                  (aset f 5 ""))
                (case ["assert_exception"]
                  (set! f (append f "")))
                (default
                  (return "error: not an assert_trap")))

              (aset f 0 "assert_return"))
            (case ["as-module"]
              ;; an instantiation that must fail (assert_trap of a module, assert_unlinkable, assert_uninstantiable) judged as a module
              (switch (aget f 0)
                (case ["assert_trap_module" "assert_unlinkable" "assert_uninstantiable"])
                (default
                  (return "error: not a failing module")))

              (set! f (lit (slice string) "module" "-" (aget f 1))))
            (case ["as-uninstantiable"]
              (when (!= (aget f 0) "module")
                (return "error: not a module"))

              (set! f (lit (slice string) "assert_uninstantiable" (aget f 2) (hex/EncodeToString (conv (slice byte) "unreachable")))))
            (case ["vs" "msg-vs"]
              (let [(values other err) (readPlan plan2)]
                (when (!= err nil)
                  (return (+ "error: " (.Error err))))

                (let [^{:tag (slice string)} o (zero (slice string))]
                  (range [_ l2 other]
                    (when (and (== (.-k l2) k2) (== o nil))
                      (set! o (.-f l2))))


                  (when (or (== o nil) (< (len o) 6) (< (len f) 6))
                    (return "error: no such command"))

                  ;; this action judged against the other command's expectation (its results, or its trap's message)
                  (aset f 5 (aget o 5)))))
            (default
              (return (+ "error: unknown mode " mode))))

          (let [before (.-Interpreted (.-m r))
              ^{:line 705} rows (.command r (+ "testsuite/c#" (.-k l)) f)]
            (range [_ x rows]
              (when (!= (.-result x) ":pass")
                (return "differs")))


            (when (and (> (wai/AOTCount) 0) (> (.-Interpreted (.-m r)) before))
              (return "differs"))

            (return "same"))))

      (+ "error: no command " k))))


^{:go/end 789} (go/func main []
  (when (< (len os/Args) 2)
    (fmt/Fprintln os/Stderr "waidriver wast LIST ROWS | control PLAN MODDIR K MODE [PLAN2 K2]")
    (os/Exit 2))

  (switch (aget os/Args 1)
    (case ["wast"]
      (let [(values b err) (os/ReadFile (aget os/Args 2))]
        (when (!= err nil)
          (fmt/Fprintln os/Stderr err)
          (os/Exit 1))

        (let [(values out ^:assign err) (os/Create (aget os/Args 3))]
          (when (!= err nil)
            (fmt/Fprintln os/Stderr err)
            (os/Exit 1))

          (let [w (bufio/NewWriter out)]
            (range [_ l (strings/Split (conv string b) "\n")]
              (when (== l "")
                (continue))

              (let [fs (strings/Split l "\t")]
                (writeRows w (runScript (aget fs 0) (aget fs 1) (aget fs 2)))
                (.Flush w)))

            (.Flush w)
            (.Close out)))))
    (case ["run"]
      (os/Exit (runMain (subslice os/Args 2))))
    (case ["gojs"]
      (os/Exit (gojsMain (subslice os/Args 2))))
    (case ["gojs-imports"]
      ;; the headless world's gojs imports, one a line (the shim's import-list check, WAS15 (a))
      (range [_ n wai/GoJSImports]
        (fmt/Println n)))

    (case ["gpu-ops"]
      ;; the WebGPU bridge's operations (doc/wasm/WEB.md §2): NUMBER ARGS NAME a line, for the shim's table check
      (range [i o wai/GPUOps]
        (fmt/Println i (.-N o) (.-Name o))))

    (case ["buildok"]
      (fmt/Println (buildOK (aget os/Args 2))))
    (case ["w2g-cases"]
      (when [err (w2gGen (aget os/Args 2) (aget os/Args 3))] (!= err nil)
        (fmt/Fprintln os/Stderr "waidriver:" err)
        (os/Exit 1)))

    (case ["w2g-check"]
      (when [err (w2gCheck (aget os/Args 2))] (!= err nil)
        (fmt/Fprintln os/Stderr "waidriver: w2g-check:" err)
        (os/Exit 1)))

    (case ["w2g"]
      (os/Exit (w2gMain (subslice os/Args 2))))
    (case ["ops"]
      (range [_ l (wai/OpRows)]
        (fmt/Println l)))

    (case ["control"]
      (let [a (subslice os/Args 2)]
        (while (< (len a) 6)
          (set! a (append a "")))

        (fmt/Println (control (aget a 0) (aget a 1) (aget a 2) (aget a 3) (aget a 4) (aget a 5)))))
    (default
      (fmt/Fprintln os/Stderr "waidriver: unknown verb" (aget os/Args 1))
      (os/Exit 2))))

^{:go/end 136} (go/func gojsMain "gojsMain is `waidriver gojs [--dir GUEST=HOST[:ro]]... [--env K=V]... [--cwd DIR] [--seed N] [--frames N] [--input FILE]\n[--record FRAMES.EDN] [--no-validate] MODULE [ARG...]` (doc/wasm/WAI.md §10): a GOOS=js program run on the headless world, as\ngo_js_wasm_exec runs it under Node.js (argv the module's path and its arguments; the exit status the program's), or with\n--frames N as a page: N animation frames stepped, the input script's events delivered, the recording of the fakes' calls and\nthe bridge's commands written by frame to FRAMES.EDN. wai's own failures: 125 a module wai does not run, 126 an invalid module,\na link failure, a trap or a crash, with a line `wai: ...` on standard error.\n" ^int [^{:tag (slice string)} args]
  (let [w (addr (lit wai/GoJS :Stdin os/Stdin))
      ^{:line 23} validate true
      ^{:line 24} record ""]
    (while (and (> (len args) 0) (strings/HasPrefix (aget args 0) "--"))
      (when (== (aget args 0) "--no-validate")
        (set! validate false)
        (set! args (subslice args 1))
        (continue))

      (when (< (len args) 2)
        (fmt/Fprintln os/Stderr "wai: option" (aget args 0) "needs a value")
        (return 2))

      (let [v (aget args 1)]
        (switch (aget args 0)
          (case ["--dir"]
            (let [(values g h _) (strings/Cut v "=")
                ^{:line 39} ro (strings/HasSuffix h ":ro")]
              (set! (.-Mounts w) (append (.-Mounts w) (lit wai/Mount :Guest g :Host (strings/TrimSuffix h ":ro") :ReadOnly ro)))))
          (case ["--env"]
            (set! (.-Env w) (append (.-Env w) v)))
          (case ["--cwd"]
            (set! (.-Cwd w) v))
          (case ["--seed"]
            (let [(values n _) (strconv/ParseInt v 10 64)]
              (set! (.-Seed w) n)))
          (case ["--frames"]
            (let [(values n _) (strconv/Atoi v)]
              (set! (.-Frames w) n)))
          (case ["--input"]
            (let [(values evs err) (readInput v)]
              (when (!= err nil)
                (fmt/Fprintln os/Stderr "wai:" err)

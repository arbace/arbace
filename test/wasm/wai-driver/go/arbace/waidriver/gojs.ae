                  (return 125))

                (return 126))

              ^{:line 135} status)))))))



^{:go/end 169} (go/func readInput "readInput reads an input script: `FRAME TYPE [CODE [X Y]]` a line (# comments), CODE \"-\" for none.\n" [^string path] :results [(slice wai/InputEvent) error]
  (let [(values b err) (os/ReadFile path)]
    (when (!= err nil)
      (return nil err))

    (let [^{:tag (slice wai/InputEvent)} out (zero (slice wai/InputEvent))]
      (range [i l (strings/Split (conv string b) "\n")]
        (set! l (strings/TrimSpace l))
        (when (or (== l "") (== (aget l 0) \#))
          (continue))

        (let [f (strings/Fields l)]
          (when (< (len f) 2)
            (return nil (fmt/Errorf "%s:%d: FRAME TYPE [CODE [X Y]]" path (+ i 1))))

          (let [(values n err) (strconv/Atoi (aget f 0))]
            (when (!= err nil)
              (return nil (fmt/Errorf "%s:%d: %v" path (+ i 1) err)))

            (let [e (lit wai/InputEvent :Frame n :Type (aget f 1))]
              (when (and (> (len f) 2) (!= (aget f 2) "-"))
                (set! (.-Code e) (aget f 2)))

              (when (> (len f) 4)
                (set! (values (.-X e) _) (strconv/ParseFloat (aget f 3) 64))
                (set! (values (.-Y e) _) (strconv/ParseFloat (aget f 4) 64)))

              (set! out (append out e))))))

      (return out nil))))




^{:go/end 201} (go/func framesEDN "framesEDN is the recording by frame, for the Clojure reader: [{:frame N :t \"T\" :digest \"SHA-256 of the frame's lines\" :lines\n[...]} ...], frame 0 the calls before the first frame.\n" ^string [^{:tag (slice string)} rec]
  (let [^strings/Builder sb (zero strings/Builder)]
    (.WriteString sb "[")
    (let [(values frame t) (values "0" "0")
        ^{:line 177 :tag (slice string)} lines (zero (slice string))
        ^{:line 178} flush ^{:go/end 188} (fn []
          (let [h (sha256/Sum256 (conv (slice byte) (strings/Join lines "\n")))]
            (fmt/Fprintf (addr sb) "{:frame %s :t %s :digest %s :lines [" frame (ednStr t) (ednStr (hex/EncodeToString (subslice h))))
            (range [i l lines]
              (when (> i 0)
                (.WriteString sb "\n   "))

              (.WriteString sb (ednStr l)))

            (.WriteString sb "]}\n")))]

      (range [_ l rec]
        (when (strings/HasPrefix l "frame ")
          (flush)
          (let [f (strings/Fields l)]
            (set! (values frame t lines) (values (aget f 1) (aget f 2) nil))
            (continue)))

        (set! lines (append lines l)))

      (flush)
      (.WriteString sb "]\n")
      (.String sb))))



^{:go/end 220} (go/func ednStr "ednStr is a string literal for the Clojure reader (\\\" \\\\ and the control characters as \\uXXXX; the rest as it is).\n" ^string [^string s]
  (let [^strings/Builder sb (zero strings/Builder)]
    (.WriteByte sb \")
    (range [_ r s]
      (switch
        (case [(or (== r \") (== r \\))]
          (.WriteByte sb \\)
          (.WriteRune sb r))
        (case [(or (< r 0x20) (== r 0x7f))]
          (fmt/Fprintf (addr sb) "\\u%04x" r))
        (default
          (.WriteRune sb r))))


    (.WriteByte sb \")
    (.String sb)))

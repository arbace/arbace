              (set! (.-Input w) evs)))
          (case ["--record"]
            (set! record v))
          (default
            (fmt/Fprintln os/Stderr "wai: unknown option" (aget args 0))
            (return 2)))

        (set! args (subslice args 2))))

    (when (== (len args) 0)
      (fmt/Fprintln os/Stderr "waidriver gojs [--dir GUEST=HOST[:ro]]... [--env K=V]... [--cwd DIR] [--seed N] [--frames N] [--input FILE] [--record FILE] MODULE [ARG...]")
      (return 2))

    (let [(values b err) (os/ReadFile (aget args 0))]

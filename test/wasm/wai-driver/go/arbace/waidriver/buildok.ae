(in-ns 'go.arbace.waidriver) (go/file "buildok.go" :imports [


    ^{:line 4} [bufio "bufio"]
    ^{:line 5} [os "os"]
    ^{:line 6} [strconv "strconv"]
    ^{:line 7} [strings "strings"]
    ^{:line 8} [unicode "unicode"]

    ^{:line 10} [constraint "go/build/constraint"]])





^{:go/end 49} (go/func buildOK "buildOK is `waidriver buildok FILE`: whether Go's test driver (cmd/internal/testdir's shouldTest and its context's match) runs\nthe program for wasip1/wasm: each build constraint line before the package clause evaluated with GOOS wasip1, GOARCH wasm, gc,\ntest_run and the release tags go1.1 to go1.27 (no cgo, no goexperiment tag); `ok`, or the first constraint that excludes it.\n" ^string [^string path]
  (let [(values f err) (os/Open path)]
    (when (!= err nil)
      (return (+ "error: " (.Error err))))

    (defer (.Close f))
    ^{:go/breaks [[4 48]]} (let [match ^{:go/end 36} (fn ^bool [^string name]
          (when (== name "")
            (return false))

          (range [_ c name]
            (when (and (not (unicode/IsLetter c)) (not (unicode/IsDigit c)) (!= c \_) (!= c \.))
              (return false)))


          (when (strings/HasPrefix name "go1.")
            (let [(values n err) (strconv/Atoi (subslice name 4))]
              (return (and (== err nil) (>= n 1) (<= n 27)))))

          (or (== name "wasip1") (== name "wasm") (== name "gc") (== name "test_run")))

        ^{:line 37} sc (bufio/NewScanner f)]
      (.Buffer sc (make (slice byte) (<< 1 20)) (<< 1 20))
      (while (.Scan sc)
        (let [line (.Text sc)]
          (when (strings/HasPrefix line "package ")
            (break))

          (when [(values expr err) (constraint/Parse line)] (and (== err nil) (not (.Eval expr match)))
            (return line))))


      "ok")))

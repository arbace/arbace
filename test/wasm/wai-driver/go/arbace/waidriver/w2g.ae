(in-ns 'go.arbace.waidriver) (go/file "w2g.go" :imports [

    ;; waidriver w2g OUTDIR [--stats FILE] [--chunk BYTES] MODULE...|@LIST  (doc/wasm/WAI.md §9; WA7): the modules translated by w2g
    ;; into Go packages OUTDIR/pN (package pN, which dot-imports arbace/wai), each about BYTES of Go (default 1.5 MB: a package is one
    ;; compilation of Go's, whose memory grows with it), each registering its functions by their module's SHA-256 in its init, and
    ;; OUTDIR/imports.go, the blank imports of the packages for the AOT program's main (package main, the import path
    ;; arbace/w2gout/pN). A module named twice is translated once; a module wai's validator or decoder refuses is left (the AOT
    ;; program refuses it as the driver does). STATS: a line a module, FILE<tab>FUNCS<tab>TRANSLATED<tab>LEFT (reason=count,...).


    ^{:line 11} [bufio "bufio"]
    ^{:line 12} [fmt "fmt"]
    ^{:line 13} [os "os"]
    ^{:line 14} [filepath "path/filepath"]
    ^{:line 15} [sort "sort"]
    ^{:line 16} [strings "strings"]

    ^{:line 18} [wai "arbace/wai"]])


(go/const ^{:val "// Code generated by waidriver w2g (bin/wai check --aot, go --aot); DO NOT EDIT.\n\npackage %s\n\nimport (\n\t\"encoding/binary\"\n\t\"math\"\n\t\"math/bits\"\n\t\"strconv\"\n\n\t. \"arbace/wai\"\n)\n\nvar _ = binary.LittleEndian\nvar _ = math.MaxInt8\nvar _ = bits.UintSize\nvar _ = strconv.Itoa\nvar _ V\n\n"} w2gPkgHeader "// Code generated by waidriver w2g (bin/wai check --aot, go --aot); DO NOT EDIT.\n\npackage %s\n\nimport (\n\t\"encoding/binary\"\n\t\"math\"\n\t\"math/bits\"\n\t\"strconv\"\n\n\t. \"arbace/wai\"\n)\n\nvar _ = binary.LittleEndian\nvar _ = math.MaxInt8\nvar _ = bits.UintSize\nvar _ = strconv.Itoa\nvar _ V\n\n")




















(go/type w2gPkg (struct
    ^{:line 43 :tag int} n
    ^{:line 44 :tag (* bufio/Writer)} w
    ^{:line 45 :tag (* os/File)} f
    ^{:line 46 :tag int} size
    ^{:line 47 :tag (map (array 32 byte) (slice wai/W2GFunc))} regs
    ^{:line 48 :tag (slice (array 32 byte))} ord))


^{:go/end 225} (go/func w2gMain ^int [^{:tag (slice string)} args]
  (when (< (len args) 1)
    (fmt/Fprintln os/Stderr "waidriver w2g OUTDIR [--stats FILE] [--chunk BYTES] MODULE...")
    (return 2))

  (let [out (aget args 0)]
    (set! args (subslice args 1))
    (let [statsPath ""
        ^{:line 59} chunk 1500000]
      (while (and (>= (len args) 2) (strings/HasPrefix (aget args 0) "--"))
        (switch (aget args 0)
          (case ["--stats"]
            (set! statsPath (aget args 1)))
          (case ["--chunk"]
            (fmt/Sscan (aget args 1) (addr chunk)))
          (default
            (fmt/Fprintln os/Stderr "waidriver w2g: unknown option" (aget args 0))
            (return 2)))

        (set! args (subslice args 2)))

      (when (and (== (len args) 1) (strings/HasPrefix (aget args 0) "@"))
        (let [(values b err) (os/ReadFile (subslice (aget args 0) 1))]
          (when (!= err nil)
            (fmt/Fprintln os/Stderr "waidriver:" err)
            (return 1))

          (set! args nil)
          (range [_ l (strings/Split (conv string b) "\n")]
            (when (!= l "")
              (set! args (append args l))))))



      (let [die ^{:go/end 85} (fn ^int [^error err] (fmt/Fprintln os/Stderr "waidriver:" err) 1)]
        (when [err (os/MkdirAll out 0755)] (!= err nil)
          (return (die err)))

        (let [^{:tag (* bufio/Writer)} sw (zero (* bufio/Writer))]
          (when (!= statsPath "")
            (let [(values sf err) (os/Create statsPath)]
              (when (!= err nil)
                (return (die err)))

              (defer (.Close sf))
              (set! sw (bufio/NewWriter sf))
              (defer (.Flush sw))))

          (let [^{:tag (slice (* w2gPkg))} pkgs (zero (slice (* w2gPkg)))
              ^{:line 100 :tag (* w2gPkg)} cur (zero (* w2gPkg))
              ^{:line 101} closePkg ^{:go/end 131} (fn ^error []
                (when (== cur nil)
                  (return nil))

                ;; the package's registrations: its functions by module, in the order met
                (.WriteString (.-w cur) "func init() {\n")
                (range [_ h (.-ord cur)]
                  (fmt/Fprintf (.-w cur) "\tRegisterAOT([32]byte{")
                  (range [i x h]
                    (when (> i 0)
                      (.WriteString (.-w cur) ", "))

                    (fmt/Fprintf (.-w cur) "%d" x))

                  (.WriteString (.-w cur) "}, map[int]NativeFn{")
                  (range [i f (aget (.-regs cur) h)]
                    (when (> i 0)
                      (.WriteString (.-w cur) ", "))

                    (fmt/Fprintf (.-w cur) "%d: %s" (.-Index f) (.-Name f)))

                  (.WriteString (.-w cur) "})\n"))

                (.WriteString (.-w cur) "}\n")
                (when [err (.Flush (.-w cur))] (!= err nil)
                  (return err))

                (let [err (.Close (.-f cur))]
                  (set! cur nil)
                  ^{:line 130} err))

              ^{:line 132} openPkg ^{:go/end 146} (fn ^error []
                (let [n (len pkgs)
                    ^{:line 134} dir (filepath/Join out (fmt/Sprintf "p%d" n))]
                  (when [err (os/MkdirAll dir 0755)] (!= err nil)
                    (return err))

                  ^{:go/breaks [6]} (let [(values f err) (os/Create (filepath/Join dir "w2g.go"))]
                    (when (!= err nil)
                      (return err))

                    (set! cur (addr (lit w2gPkg :n n :f f :w (bufio/NewWriterSize f (<< 1 20)) :regs (lit (map (array 32 byte) (slice wai/W2GFunc))))))
                    (fmt/Fprintf (.-w cur) w2gPkgHeader (fmt/Sprintf "p%d" n))
                    (set! pkgs (append pkgs cur))
                    nil)))

              ^{:line 147} note ^{:go/end 155} (fn [^{:tag (array 32 byte)} h ^{:tag (* wai/W2GFunc)} f]
                (when [(values _ ok) (aget (.-regs cur) h)] (not ok)
                  (set! (.-ord cur) (append (.-ord cur) h))
                  (aset (.-regs cur) h nil))

                (when (!= f nil)
                  (aset (.-regs cur) h (append (aget (.-regs cur) h) @f))))


              ^{:line 156} seen (lit (map (array 32 byte) bool))
              ^{:line 157} nm 0]
            (range [_ p args]
              (let [(values b err) (os/ReadFile p)]
                (when (!= err nil)
                  (return (die err)))

                (let [h (wai/ModuleHash b)]
                  (when (aget seen h)
                    (continue))

                  (aset seen h true)
                  (when (!= (wai/Validate b) nil)
                    (continue))

                  (let [(values mod ^:assign err) (wai/Decode b)]
                    (when (!= err nil)
                      (when (!= sw nil)
                        (fmt/Fprintf sw "%s\t0\t0\tdecode: %s\n" p (clean (.Error err))))

                      (continue))

                    (let [(values fns st) (wai/W2G mod (fmt/Sprintf "m%d" nm))]
                      (inc! nm)
                      (when (== cur nil)
                        (when [err (openPkg)] (!= err nil)
                          (return (die err))))


                      (note h nil) ; the module translated, even with no function
                      (range [i fns]
                        (when (and (> (.-size cur) 0) (> (+ (.-size cur) (len (.-Go (aget fns i)))) chunk))
                          (when [err (closePkg)] (!= err nil)
                            (return (die err)))

                          (when [err (openPkg)] (!= err nil)
                            (return (die err))))


                        (.WriteString (.-w cur) (.-Go (aget fns i)))
                        (set! (.-size cur) + (len (.-Go (aget fns i))))
                        (note h (addr (aget fns i))))

                      (when (!= sw nil)
                        (let [^{:tag (slice string)} ls (zero (slice string))]
                          (range [k v (.-Left st)]
                            (set! ls (append ls (fmt/Sprintf "%s=%d" k v))))

                          (sort/Strings ls)
                          (fmt/Fprintf sw "%s\t%d\t%d\t%s\n" p (.-Funcs st) (.-Translated st) (strings/Join ls ",")))))))))


            (when [err (closePkg)] (!= err nil)
              (return (die err)))

            ^{:go/breaks [[7 224]]} (let [^strings/Builder ib (zero strings/Builder)]
              (.WriteString ib "// Code generated by waidriver w2g; DO NOT EDIT.\n\npackage main\n\nimport (\n")
              (range [_ p pkgs]
                (fmt/Fprintf (addr ib) "\t_ \"arbace/w2gout/p%d\"\n" (.-n p)))

              (.WriteString ib ")\n")
              (when (== (len pkgs) 0)
                (.Reset ib)
                (.WriteString ib "// Code generated by waidriver w2g; DO NOT EDIT.\n\npackage main\n"))

              (when [err (os/WriteFile (filepath/Join out "imports.go") (conv (slice byte) (.String ib)) 0644)] (!= err nil)
                (return (die err)))

              0)))))))

;; w2g's AOT level's classes (bin/wai check --aot; doc/wasm/WAI.md §9; doc/wasm/WASM-SURVEY.md §7, WA7): every row of
;; test/wasm/aot-results.edn that does not pass is in the first class that names it in :ids, else the first whose :match finds its
;; REASON, in goi's format. Read with the Clojure reader. First w2g's own (a command that called a function w2g leaves to the
;; interpreter: its row fails "w2g: ..." though the command passes on the interpreter; none since WA7's first part), then the eval level's classes (the scripts
;; beyond the root, by what they test: the AOT programs fail where wai fails), copied from test/wasm/divergences-eval.edn.
[
 {:id :w2g-left
  :title "a function w2g leaves to the interpreter"
  :kind :deferred
  :why "w2g translates every function whose instructions are the interpreter's cases or its own transfers of control; one whose op neither knows (none in the testsuite's modules since WA7's first part: try_table's handlers and the tail calls are translated) runs on the interpreter, and a command that calls it is no AOT pass, though it passes on the interpreter"
  :decided "WA7 (first part)"
  :match [#"^w2g: [0-9]+ calls on the interpreter" #"^\[[^\]]*\] w2g: [0-9]+ calls on the interpreter"]}
 {:id :proposal-threads
  :title "proposals/threads: shared memories, atomics, wait and notify"
  :kind :deferred
  :why "the threads proposal (shared memories, the atomics 0xfe, wait and notify; wai refuses a shared memory and an atomic as unimplemented) is WA13's, optional and last (WAS26 (a))"
  :decided "WAS4 (a), WAS26 (a), the user 2026-11-13"
  :match [#"^\[proposal threads\] "]}
 {:id :proposal-custom-descriptors
  :title "proposals/custom-descriptors: descriptor types, exact references and their casts"
  :kind :deferred
  :why "a proposal beyond Wasm 3.0 (WAS4 (a): proposals/ beyond 3.0 deferred)"
  :decided "WAS4 (a), the user 2026-11-13"
  :match [#"^\[proposal custom-descriptors\] "]}
 {:id :proposal-custom-page-sizes
  :title "proposals/custom-page-sizes: a memory's page size"
  :kind :deferred
  :why "a proposal beyond Wasm 3.0 (WAS4 (a))"
  :decided "WAS4 (a), the user 2026-11-13"
  :match [#"^\[proposal custom-page-sizes\] "]}
 {:id :proposal-compact-import-section
  :title "proposals/compact-import-section: imports grouped by module"
  :kind :deferred
  :why "a proposal beyond Wasm 3.0 (WAS4 (a))"
  :decided "WAS4 (a), the user 2026-11-13"
  :match [#"^\[proposal compact-import-section\] "]}
 {:id :proposal-wide-arithmetic
  :title "proposals/wide-arithmetic: i64.add128, i64.mul_wide_s and their kin"
  :kind :deferred
  :why "a proposal beyond Wasm 3.0 (WAS4 (a))"
  :decided "WAS4 (a), the user 2026-11-13"
  :match [#"^\[proposal wide-arithmetic\] "]}
 {:id :proposal-extended-name-section
  :title "proposals/extended-name-section: the name section's type, field, tag, label and segment names, and their annotations"
  :kind :deferred
  :why "a proposal beyond Wasm 3.0 (WAS4 (a)); the name section's subsections 0-2 (module, functions, locals) are read since WA1, the @name annotations of the module and its functions since WA2's rest"
  :decided "WAS4 (a), the user 2026-11-13"
  :match [#"^\[proposal extended-name-section\] "]}
 {:id :legacy-exceptions
  :title "legacy/: the legacy exception handling (try, catch, catch_all, delegate, rethrow)"
  :kind :deferred
  :why "wai runs Wasm 3.0's exceptions (try_table, throw, throw_ref); the legacy instructions (try, catch, delegate, rethrow) it refuses as unimplemented are WA8's (doc/wasm/WASM-SURVEY.md §14: exceptions and legacy/)"
  :decided "doc/wasm/WASM-SURVEY.md §14, WA8"
  :match [#"^\[legacy exceptions\] "]}
]

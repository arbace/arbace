# wai's instruction table (go/arbace/wai/optab.go) from repr/wasm's arbace/repr/wasm/ops.ae (generated from the spec's pin):
# bin/wai ops gen|check. Each row [PREFIX CODE NAME KIND] gives an op constant (the name in Go's spelling: i32.add -> OpI32Add;
# the second row of a name its kind's suffix: select's typed one OpSelectT, ref.test's and ref.cast's nullable ones ...Null) and
# an opInfo {prefix, code, name, kind}.
function goname(n, k,   parts, i, s, p, out) {
  gsub(/[._]/, " ", n); split(n, parts, " "); out = "Op"
  for (i = 1; i in parts; i++) { p = parts[i]; out = out toupper(substr(p, 1, 1)) substr(p, 2) }
  return out
}
/^   \[(nil|0x[0-9a-f]+) 0x[0-9a-f]+ "[^"]+" :[a-z0-9-]+\]$/ {
  line = $0; sub(/^   \[/, "", line); sub(/\]$/, "", line)
  split(line, f, " "); pre = f[1]; code = f[2]; name = f[3]; kind = f[4]
  gsub(/"/, "", name); sub(/^:/, "", kind)
  g = goname(name)
  if (g in seen) { if (kind == "select-t") g = g "T"; else g = g "Null" }
  seen[g] = 1
  k = kind; gsub(/-/, " ", k); split(k, kp, " "); kk = "k"
  for (i = 1; i in kp; i++) kk = kk toupper(substr(kp[i], 1, 1)) substr(kp[i], 2)
  delete kp
  n++; names[n] = g; pres[n] = (pre == "nil" ? "0" : pre); codes[n] = code; tn[n] = name; kinds[n] = kk; kindset[kk] = 1; kindsrc[kk] = kind
}
END {
  print "// Code generated by test/wasm/gen_wai_ops.awk (bin/wai ops gen) from arbace/repr/wasm/ops.ae. DO NOT EDIT."
  print ""
  print "package wai"
  print ""
  print "// The instructions of repr/wasm's table (Wasm 3.0's but the structured ones), in its order."
  print "const ("
  print "\tOpInvalid = iota"
  for (i = 1; i <= n; i++) print "\t" names[i]
  print "\topTableEnd"
  print ")"
  print ""
  print "// The immediates' kinds (doc/wasm/SPEC.md §3.2)."
  print "const ("
  c = 0; m = 0
  for (k in kindset) ks[++m] = k
  # sort the kinds' names
  for (i = 1; i <= m; i++) for (j = i + 1; j <= m; j++) if (ks[j] < ks[i]) { t = ks[i]; ks[i] = ks[j]; ks[j] = t }
  for (i = 1; i <= m; i++) print "\t" ks[i] (i == 1 ? " = iota" : "")
  print ")"
  print ""
  print "// The kinds' names in repr/wasm's table."
  print "var kindNames = [...]string{"
  for (i = 1; i <= m; i++) printf "\t%s: \"%s\",\n", ks[i], kindsrc[ks[i]]
  print "}"
  print ""
  print "var opInfos = [...]opInfo{"
  for (i = 1; i <= n; i++) printf "\t%s: {%s, %s, \"%s\", %s},\n", names[i], pres[i], codes[i], tn[i], kinds[i]
  print "}"
}

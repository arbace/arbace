(ns wasm.judge
  "bin/repr-wasm's judgments (doc/wasm/SPEC.md §6): a run's rows [ID RESULT REASON] (ID CORPUS/NAME) against a record (every
  recorded :pass of the run's corpora passes; every case of the run is recorded and every recorded case of its corpora was
  run) and every non-pass against the classes (goi's format: a row is in the first class that names its id in :ids, else
  the first whose :match finds its REASON); with RECORD the corpora's rows are rewritten from the run. The asm crops'
  judge's shape (test/asm/judge.ae)."
  (:require [arbace.string :as str]))

(defn- read-rows [path]
  (let [r (java.io.PushbackReader. (java.io.StringReader. (slurp path)))
        eof (Object.)
        xs (loop [out []] (let [x (read r false eof)] (if (identical? x eof) out (recur (conj out x)))))]
    (if (and (= 1 (count xs)) (or (empty? (first xs)) (vector? (first (first xs))))) (first xs) xs)))

(defn classify [classes [id result reason]]
  (when-not (= result :pass)
    (or (some (fn [c] (when (some #{id} (:ids c)) (:id c))) classes)
        (some (fn [c] (when (some #(re-find % (str reason)) (:match c)) (:id c))) classes))))

(def headers
  {"roundtrip"
   (str ";; repr/wasm's round trip (bin/repr-wasm roundtrip; doc/wasm/SPEC.md §6): each module of test/wasm/corpora.edn's corpora decoded\n"
        ";; in mode :full, its .ae text read back to the same forms and layer, printed back byte for byte, the canonical print decoded\n"
        ";; again to the same forms with no layer: :pass, else :fail with the first level that failed (malformed: the decoder's\n"
        ";; rejection, with its class). Written by `bin/repr-wasm roundtrip --record`; read by bin/repr-wasm's judgment. Read with the\n"
        ";; Clojure reader.\n")
   "wast"
   (str ";; repr/wasm's read of the testsuite (bin/repr-wasm wast; doc/wasm/SPEC.md §7; WA2): each command of each .wast script of\n"
        ";; test/wasm/corpora.edn's :testsuite judged by its own assertion at the read level: a module (text, binary or quote) read\n"
        ";; into forms, encoded, decoded again to the same forms and its text printed and read again to the same forms; an\n"
        ";; assert_malformed rejected; :pass, else :fail with the reason (an assertion the read level does not judge yet is\n"
        ";; classed). Written by `bin/repr-wasm wast --record`; read by bin/repr-wasm's judgment. Read with the Clojure reader.\n")
   "eval"
   (str ";; wai's run of the testsuite (bin/wai check; doc/wasm/WAI.md §5; WA4): each command of each root .wast script of\n"
        ";; test/wasm/corpora.edn's :testsuite planned by arbace.wasm.check and run by wai's light driver, judged by its own assertion:\n"
        ";; a module instantiated, assert_return's results by the spec's patterns, assert_trap trapped, assert_exhaustion, assert_exception,\n"
        ";; assert_unlinkable and assert_uninstantiable; a msg/ row each trap's or link failure's message against the script's, by\n"
        ";; prefix (the second level). :pass, else :fail with the reason, classed in test/wasm/divergences-eval.edn. Written by\n"
        ";; `bin/wai check --record`; read by bin/wai's judgment and bin/reap. Since WA5 also a valid/ row each module the planner wrote\n"
        ";; and each assert_invalid's module: wai's own validator's verdict against arbace.wasm.valid's (WAS30 (a); beside in the cell).\n"
        ";; Read with the Clojure reader.\n")
   "go"
   (str ";; wai's Go run corpus (bin/wai go; doc/wasm/WAI.md §8; WA5, WAS11 (a)): $GOROOT/test's run programs (goi's record's run actions)\n"
        ";; and Go's own small programs (test/wasm/go-run.txt) built for wasip1/wasm by TamaGo's go and run by wai's light driver under\n"
        ";; WASI preview 1, judged against gc's linux/amd64 run of the original as goi's check judges goi (status, standard output,\n"
        ";; standard error's head) and the own programs by want.out: :pass, :skip (gc's own run does not pass, a build constraint excludes\n"
        ";; wasip1, an action goi skips too) or :fail with the reason, classed in test/wasm/divergences-go.edn. Written by\n"
        ";; `bin/wai go --record`; read by bin/wai's judgment and bin/reap. Read with the Clojure reader.\n")
   "aot"
   (str ";; w2g's AOT level of the testsuite (bin/wai check --aot; doc/wasm/WAI.md §9; WA7, WAS10 (a)): the commands of eval's plans\n"
        ";; (arbace.wasm.check) run by AOT programs, the light driver built by TamaGo's go with every function of the scripts' modules\n"
        ";; that w2g translates compiled as Go, judged by the same assertions; a command that passes but called a function the\n"
        ";; interpreter ran (w2g left it: try_table's handlers, tail calls) is :fail \"w2g: ...\", classed in test/wasm/divergences-aot.edn.\n"
        ";; Written by `bin/wai check --aot --record`; read by bin/wai's judgment and bin/reap. Read with the Clojure reader.\n")
   "js"
   (str ";; wai's js/wasm corpus on the headless world (bin/wai js; doc/wasm/WAI.md §10, doc/wasm/WEB.md; WA11, WA12): syscall/js's tests\n"
        ";; (a row a test, and the binary's), Go's own js programs of test/wasm/js-run.txt (want.out, want.status, want.err), the demo\n"
        ";; scene's frames (test/wasm/js/scene/expected/) and the shim's checks (its gojs imports against Go's, wasm_exec.js's and the\n"
        ";; world's; its WebGPU operation table against the world's), built for js/wasm by TamaGo's go and run by wai's light driver on\n"
        ";; gojs's headless world, each by its own statement: :pass, :skip or :fail with the reason, classed in test/wasm/divergences-js.edn.\n"
        ";; Written by `bin/wai js --record`. Read with the Clojure reader.\n")
   "go-aot"
   (str ";; w2g's AOT level of wai's Go run corpus (bin/wai go --aot; doc/wasm/WAI.md §9; WA7; the whole corpus since WAS51 (a)): the programs\n"
        ";; built for wasip1/wasm, translated by w2g and built as AOT programs, run and judged as bin/wai go judges them; a run any of\n"
        ";; whose functions the interpreter ran is :fail \"w2g: ...\". Classes test/wasm/divergences-go.edn. Written by\n"
        ";; `bin/wai go --aot --record`; read by bin/wai's judgment and bin/reap. Read with the Clojure reader.\n")})

(defn- q [s] (pr-str (str s)))

(defn main [label kind results run-path classes-path record ids]
  (let [ids (set (remove empty? (str/split (str ids) #" ")))
        run (read-rows run-path)
        old (if (.exists (java.io.File. ^String results)) (read-rows results) [])
        classes (read-string (slurp classes-path))
        ;; GDS31 (a), the 11-20 audit: REPR_WASM_ONLY_IDS=FILE (bin/repr-wasm roundtrip --only-list): the run holds FILE's ids alone,
        ;; judged on what ran (a recorded id not listed neither run nor missing)
        only (when-let [f (not-empty (System/getenv "REPR_WASM_ONLY_IDS"))]
               (set (remove #(or (str/blank? %) (str/starts-with? % "#")) (map str/trim (str/split-lines (slurp f))))))
        in-run? (fn [[id]] (and (or (empty? ids) (contains? ids (first (str/split id #"/")))) (or (nil? only) (contains? only id))))
        old-run (filter in-run? old)
        oldm (into {} (map (fn [[i r]] [i r]) old-run))
        runm (into {} (map (fn [[i r]] [i r]) run))
        per (group-by #(first (str/split (first %) #"/")) run)
        problems (atom [])]
    (doseq [[c rs] (sort per)]
      (let [by (frequencies (map #(or (classify classes %) (when (= :pass (second %)) :pass) :unclassed) rs))]
        (println (str label " " c ": " (count rs) " cases, " (get by :pass 0) " pass"
                      (apply str (for [[k n] (sort-by str (dissoc by :pass))] (str ", " n " " (name k))))))))
    (doseq [r run :when (and (not= :pass (second r)) (not (classify classes r)))]
      (swap! problems conj (str "unclassed: " (first r) " " (nth r 2))))
    (if (seq record)
      (let [kept (remove in-run? old)
            rows (sort-by first (concat kept run))]
        (spit results (str (headers kind) "[\n" (apply str (map (fn [[i r why]] (str "[" (q i) " " r " " (q why) "]\n")) rows)) "]\n"))
        (println (str label ": recorded " (count run) " rows of " (str/join " " (sort ids)) " into " results)))
      (do
        (doseq [[i r] oldm :when (and (= r :pass) (not= (runm i) :pass))]
          (swap! problems conj (str "was :pass, now " (runm i) ": " i)))
        (doseq [[i] run :when (not (contains? oldm i))] (swap! problems conj (str "not recorded: " i)))
        (doseq [[i] old-run :when (not (contains? runm i))] (swap! problems conj (str "recorded, not run: " i)))))
    (doseq [p (take 40 @problems)] (println (str "FAIL: " p)))
    (when (> (count @problems) 40) (println (str "FAIL: ... " (- (count @problems) 40) " more")))
    (if (empty? @problems)
      (println (str label ": ok"))
      (do (println (str label ": " (count @problems) " problems")) (System/exit 1)))))

;; Command oi is the light driver of arbace/oi (bin/oi's, until the package is listed in goi's
;; table and the shipped program runs it, doc/ocaml/OCAML-SURVEY.md "As built: O5"): it runs a
;; program's Lambda dumps against the library's, and the toplevel.
;;
;;	oi run LIBDIR UNIT.ae... [-- ARG...]   run the units (in order) with the library of LIBDIR
;;	                                       (LIBDIR/order.txt: the library's units in link order,
;;	                                       one name a line, each LIBDIR/NAME.ae)
;;	oi repl LIBDIR WORKDIR ORACLE          the toplevel (phrases on stdin; ORACLE the command that
;;	                                       compiles a phrase, bin/oi's)
;;	oi cmain NODES [ARG...]                a C program's node program (a test's helper, OC201 (a))
;;	                                       run on ci, its main's status
;;	oi capi                                the light AOT level's C API (queue 413): the stubs of OI_CSTUBS
;;	                                       served to the Java runtime's CApi over the standard streams
(in-ns 'go.arbace.oi.cmd.oi) (go/file "main.go" :doc "Command oi is the light driver of arbace/oi (bin/oi's, until the package is listed in goi's\ntable and the shipped program runs it, doc/ocaml/OCAML-SURVEY.md \"As built: O5\"): it runs a\nprogram's Lambda dumps against the library's, and the toplevel.\n\n\toi run LIBDIR UNIT.ae... [-- ARG...]   run the units (in order) with the library of LIBDIR\n\t                                       (LIBDIR/order.txt: the library's units in link order,\n\t                                       one name a line, each LIBDIR/NAME.ae)\n\toi repl LIBDIR WORKDIR ORACLE          the toplevel (phrases on stdin; ORACLE the command that\n\t                                       compiles a phrase, bin/oi's)\n" :imports [


    ^{:line 13} [bufio "bufio"]
    [binary "encoding/binary"]
    ^{:line 14} [fmt "fmt"]
    [io "io"]
    ^{:line 15} [os "os"]
    ^{:line 16} [filepath "path/filepath"]
    ^{:line 17} [debug "runtime/debug"]
    ^{:line 18} [pprof "runtime/pprof"]
    ^{:line 19} [strings "strings"]
    [sync "sync"]
    [syscall "syscall"]

    ^{:line 21} [oi "arbace/oi"]
    [oicapi "arbace/oicapi"]])


^{:go/end 44} (go/func main []
  (when (< (len os/Args) 2)
    (usage))
  (highPoller)

  (debug/SetMaxStack (<< 1 30))
  (debug/SetGCPercent 400)
  (when [p (os/Getenv "OI_CPUPROFILE")] (!= p "")
    (let [(values f err) (os/Create p)]
      (when (== err nil)
        (pprof/StartCPUProfile f)
        (set! exitHook ^{:go/end 34} (fn [] (pprof/StopCPUProfile) (.Close f))))))


  (switch (aget os/Args 1)
    (case ["run"]
      (exit (run (subslice os/Args 2))))
    (case ["repl"]
      (exit (repl (subslice os/Args 2))))
    ;; a test's helper C program (OC201 (a)): its node program run on ci, the host's kill and getpid
    (case ["cmain"]
      (when (< (len os/Args) 3)
        (usage))
      (let [(values st err) (oicapi/RunMain (aget os/Args 2) (subslice os/Args 2))]
        (when (!= err nil)
          (fmt/Fprintf os/Stderr "oi: cmain: %v\n" err)
          (exit oi/StatusInternal))
        (exit st)))
    ;; the light AOT level's C API (queue 413): the runtime's CApi spawns this process when no main serves capiPath
    (case ["capi"]
      (exit (capiServe))))

  (usage))

;; The light AOT level's C API (queue 413; doc/ocaml/OCAML-SURVEY.md, "As built: queue 413"): the Java runtime on stage 0
;; (jdk/ocaml/ocaml/rt/CApi.ae) has no main of ours to serve capiPath, so it spawns `oi capi` and speaks to it over its standard
;; streams. A message in: u32 its length, then it (oicapi's wire form; 'Z' alone: the program ended, the C's stdio flushed). Its
;; reply out: chunks, a byte and u32 a length then the bytes, 'o' what the C wrote to its standard output since the last reply, 'e' to
;; its standard error, 's' the signals it sent the program (one a byte), 't' once, when the C has started a thread (queue 530: the
;; runtime's agent then polls for the C's threads), then 'm' oicapi.Handle's reply (empty for 'Z'). The
;; runtime writes the C's output into the program's own streams (System/out, System/err: OCaml's channels write there too), so it
;; lands in the program's output where a call made it, and posts the signals as its own (ExtSignal).
(go/type stdBuf "stdBuf is a C stream's bytes since the last reply (or the signals the C sent the program, one a byte).\n" (struct ^sync/Mutex mu ^{:tag (slice byte)} b))

(go/method Write [^{:tag (* stdBuf)} s ^{:tag (slice byte)} p] :results [int error]
  (.Lock (.-mu s))
  (set! (.-b s) (append (.-b s) (spread p)))
  (.Unlock (.-mu s))
  (return (len p) nil))

(go/method take ^{:tag (slice byte)} [^{:tag (* stdBuf)} s]
  (.Lock (.-mu s))
  (let [b (.-b s)]
    (set! (.-b s) nil)
    (.Unlock (.-mu s))
    b))

(go/func chunk "chunk writes the reply's chunk k (an empty output chunk left out).\n" [^{:tag (* bufio/Writer)} w ^byte k ^{:tag (slice byte)} b]
  (when (and (!= k \m) (== (len b) 0))
    (return))
  (.WriteByte w k)
  (let [h (make (slice byte) 4)]
    (.PutUint32 binary/BigEndian h (conv uint32 (len b)))
    (.Write w h)
    (.Write w b)))

(go/func capiServe "capiServe serves the runtime's messages until its end of the pipe closes.\n" ^int []
  (let [out (addr (lit stdBuf))
        errb (addr (lit stdBuf))
        sigs (addr (lit stdBuf))
        in (bufio/NewReader os/Stdin)
        w (bufio/NewWriter os/Stdout)
        hdr (make (slice byte) 4)
        told false]
    (set! oicapi/Stdio (fn [] :results [io/Reader io/Writer io/Writer] (return nil out errb)))
    ;; the program is the runtime that spawned this process: its pid the C's getpid, a signal to it (or to 0, or to this process) the
    ;; runtime's own, sent back with the reply ('s'); another process's the host's kill
    (set! oicapi/Pid os/Getppid)
    (set! oicapi/Signal (fn ^error [^int p ^int sig]
                          (when (or (== p 0) (== p (os/Getppid)) (== p (os/Getpid)))
                            (when (and (> sig 0) (< sig 64))
                              (.Write sigs (lit (slice byte) (conv byte sig))))
                            (return nil))
                          (syscall/Kill p (conv syscall/Signal sig))))
    (while true
      (when [(values _ err) (io/ReadFull in hdr)] (!= err nil)
        (return 0))
      (let [msg (make (slice byte) (.Uint32 binary/BigEndian hdr))]
        (when [(values _ err) (io/ReadFull in msg)] (!= err nil)
          (return oi/StatusInternal))
        (let [^{:tag (slice byte)} reply nil]
          (if (and (== (len msg) 1) (== (aget msg 0) \Z))
            (oicapi/FlushStubs)
            (set! reply (oicapi/Handle msg)))
          (chunk w \o (.take out))
          (chunk w \e (.take errb))
          (chunk w \s (.take sigs))
          ;; (queue 530) once the C started a thread: 't', the runtime's agent polls for the C's threads from then on
          (when (and (not told) (oicapi/ThreadsStarted))
            (set! told true)
            (chunk w \t (lit (slice byte) 1)))
          (chunk w \m reply)
          (when [err (.Flush w)] (!= err nil)
            (return oi/StatusInternal)))))))


;; OC201 (a) (doc/ocaml/OCAML-SURVEY.md, "As built: OC199-OC201"): OCaml's runtime holds no descriptor beyond the standard streams,
;; so a program's descriptors are the lowest free ones as it opens them, and a program exec'd by another sees exactly the descriptors
;; it inherited (lib-unix/common/cloexec). Go's runtime opens its poller's two (epoll, eventfd) at the first file it opens: here, at
;; the driver's start, while the low numbers are held, so they land above the numbers a test uses.
(go/func highPoller "highPoller opens the runtime's poller while descriptors 3 to 63 are held (each free one opened, then closed).\n" []
  (let [^{:tag (slice int)} held (zero (slice int))]
    (while true
      (let [(values fd err) (syscall/Open "." (bit-or syscall/O_RDONLY syscall/O_CLOEXEC) 0)]
        (when (!= err nil)
          (break))
        (set! held (append held fd))
        (when (>= fd 63)
          (break))))
    (when [(values f err) (os/Open "/proc/self/exe")] (== err nil)
      (.Close f))
    (range [_ fd held]
      (syscall/Close fd))))

(go/var exitHook ^{:go/end 46} (fn []))

^{:go/end 51} (go/func exit [^int code]
  (exitHook)
  (os/Exit code))


^{:go/end 56} (go/func usage []
  (fmt/Fprintln os/Stderr "usage: oi run LIBDIR UNIT.ae... [-- ARG...] | oi repl LIBDIR WORKDIR ORACLE | oi cmain NODES [ARG...] | oi capi")
  (os/Exit 2))



^{:go/end 79} (go/func loadLibrary "LoadLibrary reads LIBDIR/order.txt and the units it names.\n" [^string dir] :results [(slice (* oi/CompUnit)) error]
  (let [(values f err) (os/Open (filepath/Join dir "order.txt"))]
    (when (!= err nil)
      (return nil err))

    (defer (.Close f))
    (let [^{:tag (slice (* oi/CompUnit))} lib (zero (slice (* oi/CompUnit)))
        ^{:line 66} sc (bufio/NewScanner f)]
      (while (.Scan sc)
        (let [name (strings/TrimSpace (.Text sc))]
          (when (== name "")
            (continue))

          (let [(values u err) (loadUnit (filepath/Join dir (+ name ".ae")))]
            (when (!= err nil)
              (return nil (fmt/Errorf "%s: %v" name err)))

            (set! lib (append lib u)))))

      (return lib (.Err sc)))))


^{:go/end 87} (go/func loadUnit [^string path] :results [(* oi/CompUnit) error]
  (let [(values b err) (os/ReadFile path)]
    (when (!= err nil)
      (return nil err))

    (oi/ParseUnit b)))


^{:go/end 119} (go/func run ^int [^{:tag (slice string)} args]
  (when (< (len args) 2)
    (usage))

  (let [(values lib err) (loadLibrary (aget args 0))]
    (when (!= err nil)
      (fmt/Fprintf os/Stderr "oi: library: %v\n" err)
      (return oi/StatusInternal))

    (let [^{:tag (slice (* oi/CompUnit))} prog (zero (slice (* oi/CompUnit)))
        last ""
        ^{:line 99} argv (lit (slice string))
        ^{:line 100} rest (subslice args 1)]
      (range [i a rest]
        (when (== a "--")
          (set! argv (append argv (spread (subslice rest (+ i 1)))))
          (break))

        (let [(values u err) (loadUnit a)]
          (when (!= err nil)
            (fmt/Fprintf os/Stderr "oi: %s: %v\n" a err)
            (return oi/StatusInternal))

          (set! prog (append prog u))
          (set! last a)))

      ;; Sys.argv.(0) is the path of a real file, the dump of the program (OC102 (b)): a test that opens its own executable reads it
      (let [name "a.out"]
        (when (!= last "")
          (let [(values abs err) (filepath/Abs last)]
            (set! name last)
            (when (== err nil)
              (set! name abs))))

        (set! argv (append (lit (slice string) name) (spread argv)))
        ;; the program's own C stubs (OI_CSTUBS: their node program, bin/oi cnodes'), loaded into ci beside it
        (when [cs (os/Getenv "OI_CSTUBS")] (!= cs "")
          (when [err (oicapi/Load cs argv)] (!= err nil)
            (fmt/Fprintf os/Stderr "oi: the C stubs: %v\n" err)
            (return oi/StatusInternal)))
        (let [status (oi/RunProgram lib prog argv os/Stderr)]
          (oicapi/Flush)
          status)))))

(ns go.arbace.oi.cmd.oi
  (:require [arbace.go :as go]))

(go/package main
  :path "arbace/oi/cmd/oi"
  :config {:goos "linux" :goarch "amd64" :goamd64 "v1" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["main.go" "repl.go"]
  :init-order [exitHook]
  :positions :lines)

(load "cmd/main")
(load "cmd/repl")

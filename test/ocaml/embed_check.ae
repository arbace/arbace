;; bin/repr-ocaml embed-check (review 008, finding 3; doc/ocaml/OCAML-SURVEY.md, "As built: review 008's fixes"): the sources
;; a shipped build embeds (arbace.j2g.embed/sources, from the checkout at ROOT) are among the sources the keys name
;; (bin/lib/version.bash's arbace_embedded_sources, whose list is read from LIST, one path a line; the keys name more: what
;; the builds read without embedding): no build embeds bytes its key does not cover, and none of repr/ocaml (evaluated from the checkout, not embedded)
;; is among them. Run on stage 0 with ARBACE_PATH at the checkout:  EXE embed_check.ae ROOT LIST
(require '[arbace.string :as str] '[arbace.j2g.embed :as embed])

(let [[root list-file] *command-line-args*
      embedded (set (keys (embed/sources root)))
      keyed (set (remove str/blank? (str/split-lines (slurp list-file))))
      only-embed (sort (remove keyed embedded))
      ocaml (sort (filter #(str/starts-with? % "arbace/repr/ocaml") embedded))]
  (println (str "embed-check: " (count embedded) " embedded sources, " (count keyed) " in the keys"))
  (doseq [p ocaml] (println (str "EMBEDDED repr/ocaml: " p)))
  (doseq [p only-embed :when (not (str/starts-with? p "arbace/repr/ocaml"))] (println (str "EMBEDDED, not in the keys: " p)))
  (when (or (seq ocaml) (seq only-embed)) (System/exit 1))
  (println "embed-check: every embedded source is keyed, none of repr/ocaml"))

;; The pinned OCaml's configuration as ocamltest sees it, and the ocamltest actions that skip a test on it (OC222 (a), the user
;; 2026-11-10; doc/CROPS-SCORE.md, "Decided (the user, 2026-11-10)"): the classes of :kind :na in test/ocaml/divergences.edn and
;; divergences-aot.edn name, per program, the action of its header that ocamltest itself reports skipped on this configuration;
;; bin/crops-score checks each against :config (an action passes when :config's :key holds :passes; a program whose action
;; passes, or whose action is not listed here, is a problem). :config is `ocamlc -config` of the pinned host's OCaml 5.5.0
;; (Alpine's ocaml 5.5.0, x86_64-pc-linux-musl), recorded 2026-11-10; :actions are ocamltest's own (ocaml-5.5.0's
;; ocamltest/builtin_actions.ml and ocaml_actions.ml, pass_or_skip over Ocamltest_config, whose values configure takes from the
;; same configuration: arch, system, target_os_type (os_type), flambda, tsan, frame_pointers (with_frame_pointers)).
;; Read with the Clojure reader.
{:ocaml "5.5.0"
 :recorded "2026-11-10"
 :config {"version" "5.5.0" "architecture" "amd64" "model" "default" "system" "linux" "os_type" "Unix"
          "host" "x86_64-pc-linux-musl" "target" "x86_64-pc-linux-musl" "native_compiler" "true"
          "flambda" "false" "tsan" "false" "with_frame_pointers" "false"
          ;; OT32 (a), OC223 (a) (the user, 2026-11-17): the gate's runner is root (uid 0), and the pinned runtime's caml/s.h defines
          ;; HAS_EXECVPE (musl has execvpe; Alpine's ocaml 5.5.0, read 2026-11-17 on the VM's aarch64-alpine-linux-musl build)
          "runner_is_root" "true" "has_execvpe" "true"
          ;; round 54: ocamltest's skip action has no configuration key: it always skips (a key no configuration sets)
          "skip_action_passes" "false"}
 :actions {"skip" {:key "skip_action_passes" :passes "true" :source "ocamltest/builtin_actions.ml:34-40 (skip: \"Always skip the test\")"}
           "tsan" {:key "tsan" :passes "true" :source "ocamltest/builtin_actions.ml:287-292 (Ocamltest_config.tsan)"}
           "frame_pointers" {:key "with_frame_pointers" :passes "true" :source "ocamltest/builtin_actions.ml:280-285 (Ocamltest_config.frame_pointers)"}
           "flambda" {:key "flambda" :passes "true" :source "ocamltest/ocaml_actions.ml:1134-1139 (Ocamltest_config.flambda)"}
           "target-windows" {:key "os_type" :passes "Win32" :source "ocamltest/builtin_actions.ml:149-154 (target_os_type = \"Win32\")"}
           "macos" {:key "system" :passes "macosx" :source "ocamltest/builtin_actions.ml:191-198 (system = macos_system, \"macosx\")"}
           "arch_power" {:key "architecture" :passes "power" :source "ocamltest/builtin_actions.ml:252-257"}
           "arch_arm64" {:key "architecture" :passes "arm64" :source "ocamltest/builtin_actions.ml:231-236"}
           "arch_riscv" {:key "architecture" :passes "riscv" :source "ocamltest/builtin_actions.ml:259-264"}
           "arch_amd64" {:key "architecture" :passes "amd64" :source "ocamltest/builtin_actions.ml:238-243"}
           "not-root" {:key "runner_is_root" :passes "false" :source "ocamltest/builtin_actions.ml:308-313 (Unix.getuid () <> 0)"}
           "has-execvpe.sh" {:key "has_execvpe" :passes "false" :source "testsuite/tests/lib-unix/unix-execvpe/has-execvpe.sh (TEST_SKIP when runtime/caml/s.h defines HAS_EXECVPE)"}}}

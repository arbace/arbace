;; oi's divergences from ocamlc (doc/ocaml/OCAML-SURVEY.md, "As built: O5 (write-ahead)"): the classes every
;; program of bin/oi check that does not pass falls into, each with why and where it was decided, in
;; test/goi/divergences.edn's format. A program's class is the first whose :match finds "RESULT REASON" (as
;; test/ocaml/check-oi.edn writes them). :kind :design is by design (OC11), :deferred is work a later
;; milestone owns (named), :corpus is the corpus's own (the oracle or the reference refuses it).
;; Read with the Clojure reader.
[
 {:id :multi-file
  :title "tests of several files, prebuilt modules or C stubs"
  :kind :deferred
  :why "O5 runs one file (and the testsuite's lib/testing); ocamltest's modules, all_modules, readonly_files, program and C stubs are O7's (the testsuite's actions)"
  :decided "survey §11 O7; OC61"
  :match [#"^class header: (modules|all_modules|readonly_files|program|module|compile_only|libraries|subdirectories|setup-|use_runtime|plugins|shared-libraries|reference|output|stdout|stderr|ocamlobjinfo|ocamlmklib|script|binary_modules|copy)\b"]}
 {:id :libraries
  :title "the libraries outside the stdlib: unix, threads, str, dynlink, runtime_events, compiler-libs"
  :kind :deferred
  :why "their C stubs are not oi's externals yet (unix's and str's are a library of externals each; systhreads are domains' cousin); OC11 (a) lists them as a class until a milestone ports them"
  :decided "OC11 (a); OC63"
  :match [#"^class header: include (unix|systhreads|str|dynlink|runtime_events|ocamlcommon|config|bigarray)"]}
 {:id :runtime-parameters
  :title "OCAMLRUNPARAM: backtraces, the stack limit, debug levels"
  :kind :design
  :why "backtraces name the bytecode's debug events and the stack limit is OCaml's stack size: oi has neither (OC11 (a): byte-exact Printexc backtraces, stack overflow depth)"
  :decided "OC11 (a)"
  :match [#"^class header: ocamlrunparam"]}
 {:id :tools-and-targets
  :title "tests of other tools, back ends and targets"
  :kind :design
  :why "the debugger, ocamldoc, TSan, frame pointers, flambda, other operating systems and architectures: not a program run"
  :decided "survey §8.2"
  :match [#"^class header: (tsan|frame_pointers|function_sections|debugger|ocamldoc|ocamldebug|flambda|macos|target-windows|arch_|not-|native-dynlink|ocamlopt\.byte|ocamlc\.byte|toplevel|expect|ocaml\b|hasunix|hassysthreads|hasstr|naked_pointers|bytecode-only|no-|ocamldoc|instrumented|ocamlnat|dumpenv|codegen|check-|run\b|skip|cc\b|asmgen|has_)"]}
 {:id :header-flags
  :title "compiler flags oi's oracle does not take"
  :kind :deferred
  :why "flags beyond those ocdump passes to the compiler (-safer-matching, -I with paths of ocamltest's)"
  :decided "OC61"
  :match [#"^class header: flags"]}
 {:id :header-none
  :title "files without a TEST header"
  :kind :corpus
  :why "a .ml with a .reference that is not a test (a module of another test)"
  :decided "OC61"
  :match [#"^class header: none"]}
 {:id :backtraces
  :title "exception backtraces"
  :kind :design
  :why "a backtrace names the bytecode's debug events (ocamlc -g) and the frames of its stack; oi interprets Lambda, which has no events in the dumps and no bytecode frames (Printexc's raw backtraces are empty)"
  :decided "OC11 (a); OC68"
  :match [#"^fail known backtrace: "]}
 {:id :gc-and-memory
  :title "the collector: finalisers, weak pointers, ephemerons, Gc.Memprof, the words allocated"
  :kind :design
  :why "oi's values are Go's and its collector Go's: finalisers are accepted and not run, weak arrays and ephemerons hold their contents strongly, Gc's counters of allocated words stay at zero, Gc.Memprof samples nothing; a program that observes the collector sees none of OCaml's"
  :decided "OC11 (a); OC64, OC68"
  :match [#"^fail known gc: "]}
 {:id :obj-representation
  :title "Obj's view of the heap"
  :kind :design
  :why "Obj.reachable_words, the minor and major heap of a value, a lazy's shortcut by the collector: OCaml's memory layout, which oi's Go values do not have"
  :decided "OC11 (a); OC65"
  :match [#"^fail known obj: "]}
 {:id :bigarray
  :title "bigarrays beyond the stdlib's own use"
  :kind :deferred
  :why "the bigarray externals are the minimal set Random and the channels need (a slice of values a bigarray), not bigarray.c's kinds, layouts, overflow checks and marshalling; a later milestone ports bigarray.c"
  :decided "OC63"
  :match [#"^fail known bigarray: "]}
 {:id :speed
  :title "speed: programs beyond the check's limit"
  :kind :design
  :why "an interpreter of Lambda over Go values is one or two orders of magnitude slower than ocamlc's bytecode on loops of 10^8 or 10^9 steps; the check's limit is OI_TIMEOUT (120 s)"
  :decided "OC65"
  :match [#"^fail timeout "]}
 {:id :backend
  :title "tests written for ocamlopt that ocamlc's bytecode fails"
  :kind :design
  :why "oi runs the bytecode translation (OC53 (a)), judged against ocamlc (OC66 (a)); the test counts allocation, which ocamlc's run does not match; the AOT level is judged against ocamlopt's run and passes"
  :decided "OC66 (a)"
  :match [#"^fail known backend: "]}
 {:id :argv0
  :title "a program reading its own executable"
  :kind :design
  :why "oi runs a Lambda dump, not a file; Sys.argv.(0) names no file"
  :decided "O7, OC102"
  :match [#"^fail known argv0: "]}
 {:id :marshal-closures
  :title "Marshal with the Closures flag"
  :kind :deferred
  :why "closures marshal as code pointers and digests of the program; oi's closures are Go values"
  :decided "O7, OC103"
  :match [#"^fail known marshal: "]}
 {:id :oi-bug
  :title "a bug of oi found by the suite corpus"
  :kind :deferred
  :why "a float array view of a recursive atom: oi's letrec of constants builds a Block where the float array's primitive expects a FloatArray"
  :decided "O7, OC104"
  :match [#"^fail known oi-bug: "]}
 {:id :reference-uncompilable
  :title "ocamlc cannot compile the program (a C primitive, a missing module)"
  :kind :corpus
  :why "the program names an external of a C stub its test directory builds with a C compiler: there is no run to compare with"
  :decided "OC7"
  :match [#"^ref "]}
 {:id :opam-not-run
  :title "opam programs whose dependencies are not in the set"
  :kind :corpus
  :why "a test needing alcotest, b0, Base, unix, ppx_expect, or a library whose sources need cppo or dune's generated shims: the set is pure OCaml with the stdlib only (OC101)"
  :decided "OC101"
  :match [#"^class (test|lib): "]}
]

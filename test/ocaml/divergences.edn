;; oi's divergences from ocamlc (doc/ocaml/OCAML-SURVEY.md, "As built: O5 (write-ahead)"): the classes every
;; program of bin/oi check that does not pass falls into, each with why and where it was decided, in
;; test/goi/divergences.edn's format. A program's class is the first whose :match finds "RESULT REASON" (as
;; test/ocaml/check-oi.edn writes them). :kind :design is by design (OC11), :deferred is work a later
;; milestone owns (named), :corpus is the corpus's own (the oracle or the reference refuses it).
;; Read with the Clojure reader.
[
 {:id :compiler-output
  :title "tests of the compiler's output: shapes, uids, .cmt files, arities, dumpobj"
  :kind :design
  :why "no program runs: the test compares -dshape, -bin-annot's .cmt, ocamlopt's allocation or ocamlobjinfo's dump with a reference; oi has no compiler output to compare. Judged with the typer later (T12, doc/ocaml/TYPER.md section 5) as a check of its own"
  :decided "OT2 (a), the user 2026-11-05"
  :programs ["shape-index/index"
              "shape-index/index_aliases"
              "shape-index/index_bindingops"
              "shape-index/index_constrs"
              "shape-index/index_constrs_records"
              "shape-index/index_functor"
              "shape-index/index_labels"
              "shape-index/index_local_opaque_defs"
              "shape-index/index_modules"
              "shape-index/index_objects"
              "shape-index/index_types"
              "shape-index/index_vb"
              "uid-deps/link_intf_impl"
              "uids/intf_uids_test"
              "no-alias-deps/aliases"
              "syntactic-arity/alloc"
              "syntactic-arity/max_arity"
              "syntactic-arity/measure_runtime_arity"
              "tool-dumpobj/test"]
  :match [#"^class header: "]}
 {:id :ocamltest-tools
  :title "ocamltest's tools, programs the test builds and runs, backtrace references"
  :kind :design
  :why "ocamldoc, caml-tex, ocamllex and ocamlyacc, the debugger, ocamldep, ocamlobjinfo, the toplevel, use_runtime = false; a second program the test compiles and runs by Sys.command or Unix.create_process (reflector.ml, myecho.ml, cmdline_prog.ml: oi would need itself as the program's executable); reference = $ of backtrace tests (OC11 (a))"
  :decided "OT3 (a), the user 2026-11-05"
  :programs ["tool-ocamldoc/t01"
              "tool-ocamldoc/t02"
              "tool-ocamldoc/t03"
              "tool-ocamldoc/t04"
              "tool-ocamldoc/t05"
              "tool-caml-tex/ellipses"
              "tool-caml-tex/redirections"
              "tool-lexyacc/calc"
              "tool-debugger/no_debug_event/noev"
              "tool-ocamldep-shadowing/a"
              "tool-ocamlobjinfo/question"
              "self-contained-toplevel/main"
              "output-complete-obj/github9344"
              "lib-filename/quotecommand"
              "lib-unix/common/redirections"
              "lib-unix/common/wait_nohang"
              "lib-unix/common/test_unix_cmdline"
              "backtrace/backtrace_effects_nested"
              "backtrace/lazy"]
  :match [#"^class header: "]}
 {:id :runtime-events
  :title "Runtime_events"
  :kind :design
  :why "the ring of the runtime's own events (GC phases, user events through a memory-mapped file read by a consumer) observes the GC, which oi's values and the AOT runtime's do not have (OC64: the counters stay at zero)"
  :decided "OT4 (a), the user 2026-11-05"
  :match [#"^class header: include runtime_events"]}
 {:id :dynlink
  :title "Dynlink"
  :kind :design
  :why "Dynlink.loadfile of a .cmo or .cmxs the test builds, with the CRC checks of interfaces and the unit table its messages print; oi and o2j hold Lambda and Java forms, no bytecode or shared objects"
  :decided "OT5 (a), the user 2026-11-05"
  :match [#"^class header: include dynlink"]}
 {:id :c-runtime-internals
  :title "C stubs on the runtime's internals"
  :kind :design
  :why "the stubs use what only OCaml's C runtime has: global roots, the C threads' registration and the master lock, custom blocks' finalizers, caml_startup embedding, the runtime-events consumer, the locale, Windows"
  :decided "OT6 (a), the user 2026-11-05"
  :programs ["backtrace/backtrace_c_exn"
              "c-api/alloc_async"
              "c-api/test_c_thread_has_lock"
              "c-api/test_c_thread_has_lock_systhread"
              "embedded/cmcaml"
              "ephe-c-api/test"
              "gc-roots/globroots_parallel"
              "gc-roots/globroots_parallel_spawn_burn"
              "gc-roots/globroots_sequential"
              "lib-dynlink-native/main"
              "lib-runtime-events/test"
              "lib-systhreads/test_c_thread_register"
              "parallel/test_c_thread_register"
              "lib-unix/win-stat/test"
              "lib-unix/win-env/test_env"
              "locale/test"
              "output-complete-obj/test2"
              "regression/pr11865/mkroot"
              "regression/pr3612/pr3612"
              "statmemprof/bigarray"
              "statmemprof/user_data_regression"]
  :match [#"^class header: "]}
 {:id :c-api
  :title "C stubs on OCaml's stable C API"
  :kind :deferred
  :why "callbacks, externals of many or unboxed arguments, exceptions raised from C, strings and bigarrays from C, Marshal's helper: a C API shim on ci (value as OCaml's tagged words, blocks as handles; a clean-room caml/*.h over oi's values), DEFERRED-TRIAGE's item 9"
  :decided "OT6 (c), the user 2026-11-05"
  :match [#"^class header: (modules|readonly_files) = .*\.[cf]\b"]}
 {:id :multi-file
  :title "tests of several files, prebuilt modules or C stubs"
  :kind :deferred
  :why "O5 runs one file (and the testsuite's lib/testing); ocamltest's modules, all_modules, readonly_files, program and C stubs are O7's (the testsuite's actions)"
  :decided "survey §11 O7; OC61"
  :match [#"^class header: (modules|all_modules|readonly_files|program|module|compile_only|libraries|subdirectories|setup-|use_runtime|plugins|shared-libraries|reference|output|stdout|stderr|ocamlobjinfo|ocamlmklib|script|binary_modules|copy)\b"]}
 {:id :unix-fork
  :title "Unix.fork"
  :kind :design
  :why "Go cannot fork a multithreaded process: the runtime's threads and the interpreter's goroutines do not survive in the child; caml_unix_fork stays an external oi and the runtime lack, failing at its call (doc/ocaml/DEFERRED-TRIAGE.md, OT1)"
  :decided "OT1 (a), the user 2026-11-05"
  :match [#"external caml_unix_fork(/\d+)? is not implemented"]}
 {:id :unix-unported
  :title "the Unix library's externals beyond its core"
  :kind :deferred
  :why "OT9's second fix ports the Unix library's core (errors, the environment, process ids, time, sleeping, the working directory, stat) and loads unix.ml for the programs that include unix (OT10 (b)); a program that calls another caml_unix_* external (descriptors, pipes, files, processes, signals, sockets) fails at the call: doc/ocaml/DEFERRED-TRIAGE.md's fixes 4, 6 and 7"
  :decided "OT9 (a), DEFERRED-TRIAGE §4 items 2 and 4"
  :match [#"external caml_unix_\w+(/\d+)? is not implemented" #"^fail known unix: "]}
 {:id :compiler-libs-parser
  :title "compiler-libs beyond utils/: the parser and its trees"
  :kind :deferred
  :why "OT9's eighth fix loads the tarball's utils/ modules the programs of include config and include ocamlcommon name (Config, Misc, Numbers, Strongly_connected_components, Stable_matching, Compression and their dependencies); parsing/'s units (Location, Lexer, Parser, Parse, Printast, Pprintast, Ast_mapper) need ocamllex's and menhir's generated sources and T10's typer (doc/ocaml/DEFERRED-TRIAGE.md, \"As built: OT9's fixes 6-8\"): a program that names one is not dumped"
  :decided "OT9 (a), DEFERRED-TRIAGE §3 item 8"
  :match [#"Unbound module (Location|Lexer|Parser|Parse|Parsetree|Printast|Pprintast|Ast_mapper|Ast_helper|Ast_invariants|Warnings|Clflags|Load_path|Env|Typemod|Types)\b"]}
 {:id :libraries
  :title "the libraries outside the stdlib: unix, threads, str, dynlink, runtime_events, compiler-libs"
  :kind :deferred
  :why "their C stubs are not oi's externals yet (unix's and str's are a library of externals each; systhreads are domains' cousin); OC11 (a) lists them as a class until a milestone ports them"
  :decided "OC11 (a); OC63"
  :match [#"^class header: include (unix|systhreads|str|dynlink|runtime_events|ocamlcommon|config|bigarray)"]}
 {:id :runtime-parameters
  :title "OCAMLRUNPARAM: backtraces, the stack limit, debug levels"
  :kind :design
  :why "backtraces name the bytecode's debug events and the stack limit is OCaml's stack size: oi has neither (OC11 (a): byte-exact Printexc backtraces, stack overflow depth)"
  :decided "OC11 (a)"
  :match [#"^class header: ocamlrunparam"]}
 {:id :tools-and-targets
  :title "tests of other tools, back ends and targets"
  :kind :design
  :why "the debugger, ocamldoc, TSan, frame pointers, flambda, other operating systems and architectures: not a program run"
  :decided "survey §8.2"
  :match [#"^class header: (tsan|frame_pointers|function_sections|debugger|ocamldoc|ocamldebug|flambda|macos|target-windows|arch_|not-|native-dynlink|ocamlopt\.byte|ocamlc\.byte|toplevel|expect|ocaml\b|hasunix|hassysthreads|hasstr|naked_pointers|bytecode-only|no-|ocamldoc|instrumented|ocamlnat|dumpenv|codegen|check-|run\b|skip|cc\b|asmgen|has_)"]}
 {:id :header-flags
  :title "compiler flags oi's oracle does not take"
  :kind :deferred
  :why "flags beyond those ocdump passes to the compiler (-safer-matching, -I with paths of ocamltest's)"
  :decided "OC61"
  :match [#"^class header: flags"]}
 {:id :header-none
  :title "files without a TEST header"
  :kind :corpus
  :why "a .ml with a .reference that is not a test (a module of another test)"
  :decided "OC61"
  :match [#"^class header: none"]}
 {:id :backtraces
  :title "exception backtraces"
  :kind :design
  :why "a backtrace names the bytecode's debug events (ocamlc -g) and the frames of its stack; oi interprets Lambda, which has no events in the dumps and no bytecode frames (Printexc's raw backtraces are empty)"
  :decided "OC11 (a); OC68"
  :match [#"^fail known backtrace: "]}
 {:id :gc-and-memory
  :title "the collector: finalisers, weak pointers, ephemerons, Gc.Memprof, the words allocated"
  :kind :design
  :why "oi's values are Go's and its collector Go's: finalisers are accepted and not run, weak arrays and ephemerons hold their contents strongly, Gc's counters of allocated words stay at zero, Gc.Memprof samples nothing; a program that observes the collector sees none of OCaml's"
  :decided "OC11 (a); OC64, OC68"
  :match [#"^fail known gc: "]}
 {:id :obj-representation
  :title "Obj's view of the heap"
  :kind :design
  :why "Obj.reachable_words, the minor and major heap of a value, a lazy's shortcut by the collector: OCaml's memory layout, which oi's Go values do not have"
  :decided "OC11 (a); OC65"
  :match [#"^fail known obj: "]}
 {:id :bigarray
  :title "bigarrays beyond the stdlib's own use"
  :kind :deferred
  :why "the bigarray externals are the minimal set Random and the channels need (a slice of values a bigarray), not bigarray.c's kinds, layouts, overflow checks and marshalling; a later milestone ports bigarray.c"
  :decided "OC63"
  :match [#"^fail known bigarray: "]}
 {:id :speed
  :title "speed: programs beyond the check's limit"
  :kind :design
  :why "an interpreter of Lambda over Go values is one or two orders of magnitude slower than ocamlc's bytecode on loops of 10^8 or 10^9 steps; the check's limit is OI_TIMEOUT (120 s); the programs are named in oi-slow.edn"
  :decided "OC65"
  :match [#"^slow timeout "]}
]

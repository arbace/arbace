;; The rollup of the testsuite's files (doc/ocaml/OCAML-SURVEY.md, "As built: O7 (write-ahead)", OC100): every .ml and .mli
;; of testsuite/ (bin/oi suite roles) a row [FILE ROLE ACTION READ EXPECT OI AOT] and a result or a class, on stage 0:
;;
;;   judge|record ROLES.tsv RESULTS.edn
;;       ROLES.tsv   bin/oi suite roles' (FILE, ROLE, run|class, the header's fields or its reason)
;;       RESULTS.edn the rollup written as data (record) or compared with (judge)
;;   The levels' records are read from test/ocaml/ beside RESULTS.edn: roundtrip-known.edn (the read and round-trip level:
;;   a file not in it is equal after the round trip), ref-expect.edn (the expect action on the host), check-oi.edn and
;;   check-suite-oi.edn, check-aot.edn and check-suite-aot.edn (oi and the AOT level), and the classes
;;   divergences-testsuite.edn (the action classes), divergences.edn, divergences-suite.edn (oi's), divergences-aot.edn,
;;   divergences-suite-aot.edn (the AOT level's).
;;   ACTION   run (one program, a level's result below), or the id of the action class its header falls in
;;            (test/ocaml/divergences-testsuite.edn), or for a helper, an interface, infrastructure its role
;;   READ     pass, or the class of roundtrip-known.edn (the helper rejects the file: a syntax test, a lexer test)
;;   EXPECT   the expect action on the host (pass, diff, error), - for a file that is no expect test
;;   OI, AOT  pass, or class:ID (the id of the class the non-pass falls in), - for a file that is no run program
(require '[arbace.string :as str])

(defn tsv [path]
  (->> (str/split-lines (slurp path)) (remove str/blank?) (map #(str/split % #"\t" -1))))
(defn edn [path] (read-string (slurp path)))
(defn exists? [path] (.exists (java.io.File. ^String path)))

(defn class-of [cls line]
  (first (for [c cls :when (some #(re-find % line) (:match c))] (:id c))))

(defn results [path] (into {} (for [[id res reason] (edn path)] [id [res reason]])))
(defn aot-results [path] (into {} (for [[id res reason] (edn path)] [id [res reason]])))

(defn level [id runs cls]
  (when-let [[res reason] (get runs id)]
    (if (= res "pass") "pass"
        (str "class:" (name (or (class-of cls (str res " " reason)) :unclassed))))))

(defn rows [roles-tsv dir]
  (let [rk (edn (str dir "/roundtrip-known.edn"))
        ex (into {} (for [[f r] (edn (str dir "/ref-expect.edn"))] [f r]))
        oi (merge (results (str dir "/check-oi.edn")) (results (str dir "/check-suite-oi.edn")))
        oi5 (results (str dir "/check-oi.edn"))
        suite-oi (results (str dir "/check-suite-oi.edn"))
        aot (merge (results (str dir "/check-aot.edn")) (results (str dir "/check-suite-aot.edn")))
        suite-aot (results (str dir "/check-suite-aot.edn"))
        aot5 (results (str dir "/check-aot.edn"))
        oi-cls (vec (concat (edn (str dir "/divergences.edn")) (edn (str dir "/divergences-suite.edn"))))
        aot-cls (vec (concat (edn (str dir "/divergences-aot.edn")) (edn (str dir "/divergences-suite-aot.edn"))))
        act-cls (edn (str dir "/divergences-testsuite.edn"))]
    (for [[f role kind & more] (tsv roles-tsv)
          :let [id (when (and (= role "test") (str/starts-with? f "tests/") (str/ends-with? f ".ml"))
                     (subs f 6 (- (count f) 3)))
                read (if-let [k (get rk (str "testsuite/" f))] (name (:class k)) "pass")
                runs? (= kind "run")
                ;; a program of the suite corpus is judged there; O5's results hold the others
                oi-r (when id (or (when (contains? suite-oi id) (level id suite-oi oi-cls))
                                  (when (and (contains? oi5 id) (not= "class" (first (get oi5 id)))) (level id oi5 oi-cls))))
                aot-r (when id (or (when (contains? suite-aot id) (level id suite-aot aot-cls))
                                   (when (and (contains? aot5 id) (not= "class" (first (get aot5 id)))) (level id aot5 aot-cls))))
                line (str "class " (first more))
                acls (class-of act-cls line)
                ;; a test with a run header that a level judged is "run"; one O5 or the suite classed by header is its class
                in-run? (or (contains? suite-oi id) (and id (contains? oi5 id) (not= "class" (first (get oi5 id)))))
                action (cond
                         (not= role "test") role
                         in-run? "run"
                         acls (name acls)
                         :else "unclassed")
                expect (if-let [e (get ex f)] e "-")]]
      [f role action read expect (or oi-r "-") (or aot-r "-")])))

(defn text [rs]
  (str ";; The testsuite's files (bin/oi suite rollup; doc/ocaml/OCAML-SURVEY.md, \"As built: O7 (write-ahead)\"): [FILE ROLE ACTION READ EXPECT OI AOT],\n"
       ";; FILE relative to testsuite/; ROLE test, helper, interface, infrastructure, orphan; ACTION run or the action class\n"
       ";; (test/ocaml/divergences-testsuite.edn); READ pass or the class of roundtrip-known.edn; EXPECT the host's expect run; OI, AOT\n"
       ";; pass or class:ID, - for a file that is no run program. Read with the Clojure reader.\n"
       "[\n" (apply str (for [r rs] (str " " (pr-str (vec r)) "\n"))) "]\n"))

(defn summary [rs act-cls]
  (let [by (fn [i] (into (sorted-map) (frequencies (map #(nth % i) rs))))
        bad (concat
              (for [[f role action] rs :when (= action "unclassed") ] [f "unclassed action"])
              (for [[f _ action read] rs :when (and (not= read "pass") (not (#{"syntax-error" "lexer-error" "template" "diff"} read)))] [f (str "read " read)])
              (for [[f _ action _ ex oi aot] rs :when (and (= action "run") (or (= oi "-") (= aot "-")))] [f "run without a level's result"])
              (for [[f _ _ _ _ oi aot] rs :when (or (and oi (str/includes? oi "unclassed")) (and aot (str/includes? aot "unclassed")))] [f "unclassed non-pass"]))]
    (println (str "testsuite: " (count rs) " files; roles " (pr-str (by 1))))
    (println (str "testsuite: actions " (pr-str (by 2))))
    (println (str "testsuite: read " (pr-str (by 3)) "; expect " (pr-str (by 4))))
    (println (str "testsuite: oi " (pr-str (by 5))))
    (println (str "testsuite: aot " (pr-str (by 6))))
    (doseq [[f why] bad] (println (str "FAILING " f ": " why)))
    (println (str "testsuite: " (count bad) " files without a result or a class"))
    (empty? bad)))

(let [[mode roles-tsv results-edn] *command-line-args*
      dir (.getParent (java.io.File. ^String results-edn))
      rs (vec (rows roles-tsv dir))
      ok (summary rs (edn (str dir "/divergences-testsuite.edn")))]
  (if (= mode "record")
    (do (spit results-edn (text rs)) (println (str "testsuite: recorded " results-edn)))
    (let [old (edn results-edn)]
      (when (not= (mapv vec old) (mapv vec rs))
        (println "testsuite: the rollup differs from the record")
        (System/exit 1))))
  (when-not ok (System/exit 1)))

;; The judgment half of bin/oi (doc/ocaml/OCAML-SURVEY.md, "As built: O5 (write-ahead)"), on stage 0:
;;
;;   record-ref REF.tsv CORPUS.tsv REFS.edn
;;       the reference runs (ocamlc's and ocamlopt's, bin/oi record-ref) written as data
;;   judge|record|judge-only|record-only CHECK.tsv CORPUS.tsv REFS.edn RESULTS.edn CLASSES.edn
;;       oi's runs against the references: each program of the corpus a result, pass, or a non-pass
;;       with its reason ("RESULT REASON" is what a class's :match regexes see); every non-pass must
;;       fall in a class of CLASSES.edn (else it is failing); judge compares with the recorded
;;       RESULTS.edn and fails on a change, record rewrites it (-only: a subset, merged)
;;   divergences RESULTS.edn CLASSES.edn
;;       the recorded results against the classes alone
;;   the negative controls (GTS81 (a)): test/ocaml/controls.txt's judge lines of RESULTS.edn (controls-ok)
(require '[arbace.string :as str])

(defn tsv [path]
  (->> (str/split-lines (slurp path))
       (remove str/blank?)
       (map #(str/split % #"\t" -1))))

(defn corpus [path]
  (into (sorted-map)
        (for [[id kind & more] (tsv path)]
          [id (if (= kind "run") {:kind :run} {:kind :class :reason (first more)})])))

(defn refs [path] (into {} (for [r (read-string (slurp path))] [(:test r) r])))

(defn write-refs [ref-tsv corpus-tsv out & [only?]]
  (let [rows (for [[id cs csha cbytes os osha obytes same] (tsv ref-tsv)]
               {:test id
                :ocamlc {:status cs :sha256 csha :bytes (parse-long cbytes)}
                :ocamlopt {:status os :sha256 osha :bytes (parse-long obytes)}
                :reference (= same "true")})
        ;; record-ref-only (bin/oi record-ref --only, --only-list): the rows run replace theirs, the others are kept
        rows (if only?
               (let [ran (set (map :test rows))]
                 (concat rows (remove #(ran (:test %)) (read-string (slurp out)))))
               rows)
        text (str ";; ocamlc's and ocamlopt's runs of oi's run corpus (bin/oi record-ref; doc/ocaml/OCAML-SURVEY.md,\n"
                  ";; \"As built: O5 (write-ahead)\"): the testsuite's .ml files with a .reference that bin/lib/oi/header.awk\n"
                  ";; reads as one program, each compiled by the host's OCaml 5.5.0 and run, stdout and stderr in one\n"
                  ";; file as ocamltest runs them: the status (compile-error when it does not compile), the output's\n"
                  ";; SHA-256 and size, and whether ocamlc's output equals the .reference. oi is judged against\n"
                  ";; ocamlc's run (the bytecode translation's semantics, OC53 (a)). Read with the Clojure reader.\n"
                  "[\n"
                  (apply str (for [r (sort-by :test rows)] (str " " (pr-str r) "\n")))
                  "]\n")]
    (spit out text)
    (println (str "oi: refs: " (count rows) " programs, " (count (filter :reference rows))
                  " with ocamlc's output equal to the .reference, "
                  (count (filter #(not= (get-in % [:ocamlc :sha256]) (get-in % [:ocamlopt :sha256])) rows))
                  " where ocamlopt's output differs; " out))))

(defn known-of
  "ID -> [TEXT KINDS SHAS]: an entry is [ID TEXT], [ID TEXT KINDS] or [ID TEXT KINDS SHAS]: KINDS a prefix of the run's reason or a vector of
  them, SHAS a prefix of the run's output digest or a vector of them (re-review 030's finding 4: a status reason names no output, so
  a program that fails otherwise with the same status is told by its digest; an entry without SHAS pins nothing)."
  [path]
  (if (.exists (java.io.File. path))
    (into {} (for [[id text kinds shas] (read-string (slurp path))]
                [id [text (when kinds (if (string? kinds) [kinds] (vec kinds))) (when shas (if (string? shas) [shas] (vec shas)))]]))
    {}))

(defn slow-of
  "The programs a speed class names (test/ocaml/oi-slow.edn: [ID ...]): those whose timeout is the speed, not a hang."
  [path]
  (if (.exists (java.io.File. path)) (set (read-string (slurp path))) #{}))

(def ^:dynamic *known* {})
(def ^:dynamic *slow* #{})

(defn with-known
  "A failing program test/ocaml/oi-known.edn lists: its text there (\"known TEXT (the run's reason)\"), when the run's reason is
  of the kind the entry was made for (a listed program that now crashes, prints wrong output or loops is not that known thing);
  a listed program whose timeout is its speed (oi-slow.edn): \"slow\"."
  [id [res reason :as r] run]
  (let [[text kinds shas] (get *known* id)
        sha (nth run 2 nil)]
    (cond
      (and text (= res "fail") (or (nil? kinds) (some #(str/starts-with? reason %) kinds))
           (or (nil? shas) (some #(str/starts-with? (or sha "") %) shas))) ["fail" (str "known " text " (" reason ")")]
      (and (contains? *slow* id) (= res "fail") (str/starts-with? reason "timeout ")) ["slow" reason]
      :else r)))

(defn result-of [id c refs runs]
  (if (= (:kind c) :class)
    ["class" (:reason c)]
    (let [r (get refs id) run (get runs id)]
      (cond
        (nil? r) ["no-ref" "not in the references"]
        (nil? run) ["not-run" "no run of oi"]
        (= (get-in r [:ocamlc :status]) "compile-error") ["ref" "ocamlc does not compile it"]
        :else
        (let [[_ st sha bytes secs note] run
              want (:ocamlc r)]
          (cond
            (str/starts-with? (or note "") "dump: ") ["dump" (subs note 6)]
            (and (= st (:status want)) (= sha (:sha256 want))) ["pass" ""]
            (= st "124") ["fail" note]
            (seq note) ["fail" note]
            (not= st (:status want)) ["fail" (str "status " st ", ocamlc " (:status want))]
            :else ["fail" (str "output differs (" bytes " bytes, ocamlc " (:bytes want) ")")]))))))

(defn classes [path] (read-string (slurp path)))

(defn class-of [cls [result reason]]
  (when (not= result "pass")
    (let [line (str result " " reason)]
      (first (for [c cls :when (some #(re-find % line) (:match c))] (:id c))))))

(defn results-text [rows]
  (str ";; oi's results over its run corpus (bin/oi check --record; doc/ocaml/OCAML-SURVEY.md, \"As built: O5\n"
       ";; (write-ahead)\"): [PROGRAM RESULT REASON], RESULT pass, fail (judged by test/ocaml/divergences.edn's\n"
       ";; classes), class (its header puts it outside the run corpus), dump (the oracle refuses it), ref (ocamlc\n"
       ";; does not compile it). Read with the Clojure reader.\n"
       "[\n"
       (apply str (for [[id res reason] rows] (str " " (pr-str [id res reason]) "\n")))
       "]\n"))

(defn summary [rows cls]
  (let [by (frequencies (map second rows))
        classed (for [[id res reason] rows :when (not= res "pass")] [id (class-of cls [res reason])])
        unclassed (filter (comp nil? second) classed)]
    (println (str "oi: " (count rows) " programs: " (pr-str (into (sorted-map) by))))
    (println (str "oi: classes: " (pr-str (into (sorted-map) (frequencies (keep second classed))))))
    (doseq [[id _] unclassed]
      (let [[_ res reason] (first (filter #(= (first %) id) rows))]
        (println (str "FAILING " id ": " res " " reason))))
    (println (str "oi: " (count (filter #(= "pass" (second %)) rows)) " pass, " (count unclassed) " failing (not in a class)"))
    (empty? unclassed)))

;; GTS81 (a), queue 064: the negative controls of this results file (test/ocaml/controls.txt beside it, its lines
;; "judge RESULTS-FILE ID SUBJECT REFERENCE"): the subject's run judged by result-of against the reference's reference run;
;; it must fail. One that passes (the judge passes what differs) or whose reference has no reference run fails the judgment
;; (before anything is recorded); one whose subject has no run (a selection) or no judgment of its own (a class, a dump, a
;; refusal) is left. No control is a row of the results, the record or the counts.
(defn controls-ok [^String results-edn corp rf runs]
  (let [f (java.io.File. (str (.getParent (java.io.File. results-edn)) "/controls.txt"))
        base (.getName (java.io.File. results-edn))
        cs (when (.exists f)
             (for [l (str/split-lines (slurp f))
                   :let [w (str/split (str/trim l) #"\s+")]
                   :when (and (= 5 (count w)) (= "judge" (first w)) (= base (second w)))]
               (drop 2 w)))
        vs (for [[id subject reference] cs]
             (let [v (cond
                       (not (contains? runs subject)) :left
                       (nil? (get rf reference)) :not-judged
                       :else (case (first (result-of subject (corp subject) (assoc rf subject (get rf reference)) runs))
                               "pass" :passes
                               "fail" :differs
                               :left))]
               (println (case v
                          :differs (str "control " id " (" subject " against " reference "'s reference run): differs, as a control must (GTS81 (a))")
                          :passes (str "control passed: " id " (" subject " against " reference "'s reference run): the judge passes what differs")
                          :not-judged (str "control not judged: " id ": " reference " has no reference run")
                          :left (str "control " id ": left (" subject " not run, or no judgment of its own)")))
               v))]
    (not-any? #{:passes :not-judged} (doall vs))))

(defn judge [mode check-tsv corpus-tsv refs-edn results-edn classes-edn]
  (let [corp (corpus corpus-tsv)
        rf (refs refs-edn)
        runs (into {} (for [row (tsv check-tsv)] [(first row) row]))
        only? (str/ends-with? mode "-only")
        ids (if only? (filter #(or (contains? runs %) (= :class (:kind (corp %)))) (keys runs)) (keys corp))
        ids (if only? (keys runs) ids)
        known (known-of (str (.getParent (java.io.File. results-edn)) "/oi-known.edn"))
        slow (slow-of (str (.getParent (java.io.File. results-edn)) "/oi-slow.edn"))
        rows (binding [*known* known *slow* slow]
               (vec (for [id ids] (into [id] (with-known id (result-of id (corp id) rf runs) (get runs id))))))
        _ (doseq [[id res] rows :when (and (= res "pass") (contains? known id))]
            (println (str "STALE " id ": passes, but test/ocaml/oi-known.edn lists it")))
        _ (doseq [[id res] rows :when (and (= res "pass") (contains? slow id))]
            (println (str "STALE " id ": passes, but test/ocaml/oi-slow.edn lists it")))
        old (when (.exists (java.io.File. results-edn)) (read-string (slurp results-edn)))
        merged (if only?
                 (let [m (into (sorted-map) (for [[id & r] old] [id (vec r)]))]
                   (vec (for [[id r] (reduce (fn [m [id & r]] (assoc m id (vec r))) m rows)] (into [id] r))))
                 rows)
        ;; the recorded programs with no row in this run (a full run: the corpus no longer holds them)
        gone (if only? [] (let [have (set (map first rows))] (vec (remove have (map first old)))))
        cls (classes classes-edn)
        ok (summary rows cls)
        _ (when-not (controls-ok results-edn corp rf runs) (System/exit 1))]
    (doseq [[id r t s] rows]
      (when (= r "fail") nil))
    (if (str/starts-with? mode "record")
      (do (doseq [id gone] (println (str "DROPPED " id ": no row in this run, was " (pr-str (vec (rest (first (filter #(= (first %) id) old))))))))
          (spit results-edn (results-text merged))
          (println (str "oi: recorded " results-edn (when (seq gone) (str "; " (count gone) " recorded programs dropped (no row in this run)")))))
      (let [oldm (into {} (for [[id & r] old] [id (vec r)]))
            ;; a listed slow program recorded as slow that finishes under the limit this time (the boundary: its CPU time moves a little with
            ;; the load) is not a change; the row stays as recorded
            near-limit? (fn [id was now] (and (contains? slow id) (= "slow" (first was)) (= ["pass" ""] (vec (take 2 now)))))
            changes (for [[id & r] rows :when (and (not= (vec r) (get oldm id)) (not (near-limit? id (get oldm id) (vec r))))] [id (get oldm id) (vec r)])]
        (doseq [[id was now] changes] (println (str "CHANGED " id ": " (pr-str was) " -> " (pr-str now))))
        (doseq [id gone] (println (str "GONE " id ": recorded, with no row in this run")))
        (when (or (seq changes) (seq gone)) (println (str "oi: " (count changes) " results differ from " results-edn ", " (count gone) " recorded programs gone")))
        (when (or (seq changes) (seq gone)) (System/exit 1))))
    (when-not ok (System/exit 1))))

(let [[mode & args] *command-line-args*]
  (case mode
    "record-ref" (apply write-refs args)
    "record-ref-only" (write-refs (nth args 0) (nth args 1) (nth args 2) true)
    "divergences" (let [[results-edn classes-edn] args]
                    (when-not (summary (read-string (slurp results-edn)) (classes classes-edn)) (System/exit 1)))
    (apply judge mode args)))

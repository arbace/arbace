;; The compiled level's main package (doc/ocaml/DEFERRED-TRIAGE.md, "As built: OT9's first fix"; OC93 (a)): a shard of
;; OCaml programs translated by arbace.o2j into Java forms (each program's units in a package ocaml.p<N>, the library's in
;; ocaml.u) and by j2g into Go; main is the dispatcher's, ocaml.u.Shard (the program O2J_PROG names, the whole command line its
;; argv, argv.(0) O2J_ARGV0 when set), inside jrt.RunMain (the thread main). Given to bin/j2g with --main by bin/oi's compiled level.
(in-ns 'go.arbace.cmd.ocamlprog)

(go/file "main.go" :imports [[os "os"] [jrt "arbace/jrt"] [lang "arbace/lang"]])

(go/func main []
  (jrt/SetHost (jrt/ProgramHost nil))
  (let [args (jrt/NewRefArray jrt/String_class (conv int32 (len os/Args)))]
    (range [i a os/Args]
      (aset (.-A args) i (jrt/Str a)))
    (let [status (jrt/RunMain (fn [] (lang/J_ocaml_u_Shard_J_Main_String1__V args)))]
      (os/Exit status))))

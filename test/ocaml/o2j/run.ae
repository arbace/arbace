;; o2j's light level (doc/ocaml/OCAML-SURVEY.md, "As built: O6 (write-ahead)"): programs' Java
;; forms, as arbace.o2j translated them, defined by the Java forms' interpreter and run, on an
;; existing executable (stage 0). A script, run with the runtime's root on ARBACE_PATH
;; (jdk/ocaml) as
;;
;;   EXE test/ocaml/o2j/run.ae FILE... -- [ARG...]
;;   EXE test/ocaml/o2j/run.ae --batch LIST RESULTS TIMEOUT LIBDIR
;;
;; The first form defines the files (the units in link order, the main class last) and runs the
;; program: its status is the program's; a definition that fails prints "o2j: load-failed: " and
;; its last cause and exits 126. The environment variable O2J_ARGV0, when set, is the program's argv.(0) (else the last file).
;;
;; The second runs many programs in one process (OC88): LIST's lines are ID, OUT, FILES (a file
;; listing the program's files as the first form takes them), ARGV0 and the arguments, by tabs; the
;; library's units (the files under LIBDIR) are defined once, a program's own files each time; its stdout and stderr go to
;; OUT as one stream (System/setOut, System/setErr), the runtime's state is reset (Main/reset,
;; ExtIo/reset) and its units initialised afresh. Each result is a line of RESULTS: ID, the status
;; (126 a load failure, its message in OUT), the seconds. A program still running after TIMEOUT
;; seconds is written "timeout" and the process exits 3 (its threads cannot be stopped): the caller
;; runs the rest again. A program that ends with domains still running ends the process after its result (status 4): the
;; driver runs the rest in a new one.
(ns ocaml.o2j.run
  (:require [arbace.string :as str])
  (:import (java.io File FileOutputStream PrintStream BufferedOutputStream)))

(defn- cause [^Throwable e]
  (let [^Throwable c (last (take 16 (take-while some? (iterate #(.getCause ^Throwable %) e))))
        m (.getMessage c)]
    (if (instance? arbace.lang.ExceptionInfo c) (str m) (str (.getName (class c)) (when m (str ": " m))))))

(defn- one-line [s] (str/replace (str s) #"\s*\n\s*" " "))

;; the units of a program's files (FILE.ae a unit FILE), in their order, the main's own wrapper M__main left out
(defn- unit-names [fs]
  (->> fs (map #(str/replace (.getName (File. ^String %)) #"\.ae$" "")) (remove #{"M__main"})))

;; Dynlink's plugins at the light level (queue 373; jdk/ocaml's ExtCore caml_oi_dynlink_parse and _link, Main/loader): a plugin's
;; Lambda text translated by arbace.o2j when Dynlink reads it (the checkout's, O2J_SRC, its externals' table from the runtime's
;; forms, O2J_RT: loaded at the first plugin), its class defined when Dynlink links it, its initialisation a Runnable
(def ^:private o2j-loaded (atom false))

(defn- o2j! []
  (locking o2j-loaded
    (when-not @o2j-loaded
      (let [src (System/getenv "O2J_SRC") rt (System/getenv "O2J_RT")]
        (when-not (and src rt) (throw (ex-info "O2J_SRC and O2J_RT name arbace.o2j and the runtime's forms" {})))
        (binding [*ns* *ns*] (load-file src))
        ((resolve 'arbace.o2j/load-externals!) rt))
      (reset! o2j-loaded true))))

(defn- plugin-loader []
  (reify java.util.function.Function
    (apply [_ x]
      (let [^objects x x verb (aget x 0) arg (aget x 1)]
        (case verb
          "parse" (do (o2j!)
                      (let [{:keys [name deps refs forms]} ((resolve 'arbace.o2j/plugin-unit) arg)]
                        (object-array [name (into-array String deps) (into-array String refs) forms nil])))
          "define" (let [^objects e arg]
                     (binding [*ns* *ns*] (doseq [f (aget e 3)] (eval f)))
                     (eval (list 'fn [] (list (symbol (str "ocaml.u.M_" (aget e 0)) "init"))))))))))

;; DECISION 453-3 (a), queue 467: the analyser's bodies dropped once built. arbace.classes.interp keeps each class's analysed
;; bodies (its declaration's :state, :bodies :clinit :init: the analyser's trees over the reader's forms) after it has built every
;; method from them, reachable from env/defined and each Klass's :compile-set: about 225 of the 790 MB live after the library's load
;; (lib-hashtbl/htbl's units), which every collection marks. Only a class whose methods and static initializer are all built
;; drops them (a body that names a sibling defined later is built on its first call, from its :bodies); its declaration (names,
;; types, members' signatures), which later compilations read, stays
(defn- drop-analysed! []
  (doseq [[n ^arbace.lang.Compiler$CF$Klass k] (some-> (resolve 'arbace.classes.interp/registry) deref deref)
          :let [st (:state (get (:compile-set (.-info k)) n))]
          :when (and st (not (instance? arbace.lang.Compiler$CF$CallI (.-clinit k)))
                     (not-any? (fn [[_ ^arbace.lang.Compiler$CF$Meth m]] (some? (.-builder m))) (concat (.-methods k) (.-ctors k))))]
    (when (or (:bodies @st) (:clinit @st) (:init @st))
      (swap! st dissoc :bodies :clinit :init))))

(defn- set-loader! [] ((eval '(fn [f] (ocaml.rt.Main/setLoader f))) (plugin-loader)))

(defn- single [argv]
  (let [[files [_ & args]] (split-with #(not= "--" %) argv)]
    (when-not
      (try (require 'ocaml.rt)
           (set-loader!)
           (doseq [f files] (load-file f))
           (drop-analysed!)
           (eval (list 'ocaml.rt.Main/setUnits (list 'into-array 'String (vec (unit-names files)))))
           true
           (catch Throwable e
             (.println System/err (str "o2j: load-failed: " (one-line (cause e))))
             (.flush System/err)
             false))
      (System/exit 126))
    (eval (list 'ocaml.u.M__main/main (list 'into-array 'String (vec (cons (or (System/getenv "O2J_ARGV0") (.getAbsolutePath (File. ^String (last files)))) args)))))))

(defn- batch [list-file results timeout libdir]
  (require 'ocaml.rt)
  (set-loader!)
  (let [loaded (atom #{})
        out0 System/out err0 System/err
        ms (* 1000 (Long/parseLong timeout))
        io-reset (try (eval '(fn [] (ocaml.rt.ExtIo/reset))) (catch Throwable _ (fn [] nil)))]
    (with-open [res (java.io.FileWriter. ^String results true)]
      (doseq [line (str/split-lines (slurp list-file))
              :when (seq line)
              :let [[id out files argv0 & args] (str/split line #"\t")
                    fs (remove str/blank? (str/split-lines (slurp files)))
                    lib (filter #(str/starts-with? % libdir) fs)
                    own (remove #(str/starts-with? % libdir) fs)
                    ps (PrintStream. (BufferedOutputStream. (FileOutputStream. ^String out)) false)
                    t0 (System/nanoTime)
                    status (atom nil)]]
        (System/setOut ps)
        (System/setErr ps)
        (try
          (doseq [f lib :when (not (@loaded f))] (load-file f) (swap! loaded conj f))
          (doseq [f own] (load-file f))
          (drop-analysed!)
          (eval '(ocaml.rt.Main/reset))
          (io-reset)
          ;; the program's units, as Dynlink's platform reads them (queue 355)
          (eval (list 'ocaml.rt.Main/setUnits (list 'into-array 'String (vec (unit-names fs)))))
          ;; the program runs in its OUT's directory (ExtSys keeps the working directory)
          (eval (list 'set! 'ocaml.rt.ExtSys/cwd (.getParent (.getAbsoluteFile (File. ^String out)))))
          (let [run (eval '(fn [args] (ocaml.rt.Main/run args (ocaml.u.M__main/inits))))
                argv (into-array String (cons argv0 (remove str/blank? args)))
                t (Thread. ^Runnable (fn [] (reset! status (try (run argv) (catch Throwable e (.println System/err (str "o2j: " e)) 125)))))]
            (.setDaemon t true)
            (.start t)
            (.join t ms)
            (when (.isAlive t)
              (.flush ps)
              (System/setOut out0) (System/setErr err0)
              (.write res (str id "\ttimeout\t" timeout "\n"))
              (.flush res)
              (System/exit 3)))
          (catch Throwable e
            (.println ps (str "o2j: load-failed: " (one-line (cause e))))
            (reset! status 126)))
        (.flush ps)
        (System/setOut out0)
        (System/setErr err0)
        (.close ps)
        (.write res (str id "\t" @status "\t" (format "%.2f" (/ (- (System/nanoTime) t0) 1e9)) "\n"))
        (.flush res)
        ;; a program that ended with domains still running (parallel/backup_thread's): they would write into the next
        ;; program's output, so the process ends here (status 4) and the driver runs the rest in a new one (OT9's work)
        (when (pos? (long (eval 'ocaml.rt.Effects/domainsRunning)))
          (System/exit 4))))
    (System/exit 0)))

(let [argv *command-line-args*]
  (if (= "--batch" (first argv))
    (apply batch (rest argv))
    (single argv)))

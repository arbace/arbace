(ns go.arbace.cmd.ocamlprog (:require [arbace.go :as go]))

;; The compiled level's main package with the C API (OC215 (a)): test/ocaml/o2j/main's, and capi.go (this tree's), for the shards of
;; the programs with C stubs; bin/oi gives this tree to bin/j2g after the plain one (a later --main's files replace the earlier's).
(go/package main :path "arbace/cmd/ocamlprog" :files ["main.go" "capi.go"])

(load "ocamlprog/main")
(load "ocamlprog/capi")

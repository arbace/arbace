;; The native path's classes (doc/ocaml/TYPER.md §5 and "As built: T11"): what a program of `bin/oi check --native` that
;; passes on ocamlc's path does not do on the native one, in test/ocaml/divergences.edn's format; bin/oi check --native
;; judges with these first, then divergences.edn's. A class is the first whose :match finds "RESULT REASON". The program-level
;; ones (a run whose output differs) are listed in test/ocaml/oi-known-native.edn. Read with the Clojure reader.
[
 {:id :typer-flag
  :title "compiler flags the native path does not model"
  :kind :deferred
  :why "-unsafe is the parser's (a.(i) read as Array.unsafe_get: Clflags.unsafe in parser.mly), -no-strict-formats Typecore's legacy format typing; neither is passed to the native reader or typer yet"
  :decided "TYPER.md, As built: T11 (TY19)"
  :match [#"^dump typer: flag "]}
 {:id :typer-effect-syntax
  :title "effect patterns (match ... with effect E, k -> ...)"
  :kind :deferred
  :why "OCaml 5.3's effect syntax (Ppat_effect, Texp_match's effect cases, transl_handler's continuation): T10's effect handlers"
  :decided "TYPER.md §6, T10"
  :match [#"^dump typer: pattern :Ppat_effect outside the slice"]}
 {:id :typer-outside-slice
  :title "a construct outside the port's slice"
  :kind :deferred
  :why "the reason names it: let operators (Pexp_letop), open of a structure, functor applications in paths, ...; T10's rest of the core (TYPER.md §6)"
  :decided "TYPER.md §5, typer-outside-slice; §6 T10"
  :match [#"^dump typer: .*outside the slice"]}
 {:id :typer-letrec-lazy
  :title "let rec of lazy values the size computation refuses"
  :kind :deferred
  :why "Value_rec_compiler's compute_static_size: a lazy binding whose size is a delayed one of another name (No size found for Static binding); §15's port covers the stdlib's and the samples' cases"
  :decided "TYPER.md, As built: T11"
  :match [#"^dump typer: letrec: No size found for Static binding"]}
 {:id :typer-format-typing
  :title "a format string typed differently"
  :kind :deferred
  :why "Typecore's type_format: a format whose typing differs from OCaml's (the reason names the types)"
  :decided "TYPER.md, As built: T11"
  :match [#"^dump typer: This expression has type \(.*CamlinternalFormatBasics"]}
 {:id :typer-type-error
  :title "a program OCaml accepts the typer rejects"
  :kind :deferred
  :why "the port's typing refuses it (the reason is the typer's message): constructor and label disambiguation by the expected type (Unbound constructor), and the gaps T11's corpus found, each its own milestone's"
  :decided "TYPER.md, As built: T11"
  :match [#"^dump typer: "]}
 {:id :typer-known
  :title "a native run that differs, listed by program"
  :kind :deferred
  :why "the translation differs from ocamlc's in a way the run shows (test/ocaml/oi-known-native.edn names each: Matching, Translmod's recursive modules)"
  :decided "TYPER.md, As built: T11"
  :match [#"^fail known native: "]}
]

;; The testsuite's action classes (doc/ocaml/OCAML-SURVEY.md, "As built: O7 (write-ahead)", OC100): the ocamltest actions of a
;; test file's header that no level of the OCaml crop runs as one program (bin/lib/oi/actions.awk reads the header, bin/oi
;; suite roles the files; test/ocaml/testsuite_check.ae the rollup), in test/goi/divergences.edn's format. A file's class is
;; the first whose :match finds "class REASON", the REASON the header's first statement outside the run set. :kind :design is
;; by design, :deferred is work a later milestone owns (named), :corpus is the corpus's own. Read with the Clojure reader.
[
 {:id :expect
  :title "expect tests: the file is its own reference, the [%%expect] blocks the toplevel's output"
  :kind :deferred
  :why "the blocks are the toplevel's printing of types, values and the compiler's error messages; oi's toplevel types each phrase by the host's ocamlc -c (OC71 (a)), which neither keeps weak types between phrases nor prints Toploop's messages; the host's expect tool (testsuite/tools/expect.ml on compiler-libs) runs them as ocamltest does, recorded in test/ocaml/ref-expect.edn"
  :decided "OC71 (b); survey §11 O8 (the compiler on oi)"
  :match [#"^class header: expect\b"]}
 {:id :toplevel
  :title "tests of the toplevel and of the ocaml command"
  :kind :deferred
  :why "the toplevel's directives, #use, #load and its error display: OC71 (b)'s Toploop-based oracle"
  :decided "OC71 (b)"
  :match [#"^class header: (toplevel|ocaml_script_as_argument|ocaml\b)"]}
 {:id :compiler-libs
  :title "tests linking the compiler's libraries (ocamlcommon, ocamltoplevel, config) or the tools' library"
  :kind :deferred
  :why "the program is the compiler or a tool over its API: it runs on oi when the compiler's own Lambda does (O8, the self-hosting)"
  :decided "survey §11 O8"
  :match [#"^class header: include (tool-ocaml-lib|ocamlcommon|ocamltoplevel|config|ocamlbytecomp|ocamloptcomp)"]}
 {:id :libraries
  :title "the libraries outside the stdlib: unix, threads, str, dynlink, runtime_events"
  :kind :deferred
  :why "their C stubs are not oi's externals yet (OC63)"
  :decided "OC63 (a)"
  :match [#"^class header: (include (unix|systhreads|str|dynlink|runtime_events|bigarray)|hasunix|hassysthreads|hasstr|native-dynlink|shared-libraries)"]}
 {:id :runtime-parameters
  :title "OCAMLRUNPARAM: backtraces, the stack limit, debug levels"
  :kind :design
  :why "backtraces name the bytecode's debug events and the stack limit is OCaml's stack size (OC11 (a), OC69)"
  :decided "OC11 (a)"
  :match [#"^class header: ocamlrunparam"]}
 {:id :c-stubs
  :title "tests with C stubs or objects among their modules"
  :kind :design
  :why "a C file is compiled by the host's C compiler and linked into the runtime: oi and the AOT level run no C"
  :decided "OC7"
  :match [#"^class header: modules = .*\.(c|o|cpp|S|h)\b"]}
 {:id :build-orchestration
  :title "explicit build sequences: setup-*-build-env, compile_only, exit statuses, compiler output references, scripts, programs"
  :kind :design
  :why "the test is of the compiler's command line, its messages or its build products (ocamlc and ocamlopt on the host are the reference); the crop's compilers are the Lambda levels, not the command line"
  :decided "survey §8.2"
  :match [#"^class header: (setup-|compile_only|exit_status|arguments|ocamlc_byte_exit_status|ocamlc_opt_exit_status|ocamlopt_byte_exit_status|ocamlopt_opt_exit_status|compiler_|reference|output|stdout|stderr|script|program|all_modules|module|subdirectories|readonly_files|test_build_directory|use_runtime|ocamlobjinfo|ocamlmklib|copy|binary_modules|plugins|file|src|dst|ocamlopt\.|ocamlc\.|modules)"]}
 {:id :compiler-flags
  :title "compiler flags that print the compiler's dumps or change what it accepts"
  :kind :design
  :why "-dparsetree, -dshape, -dsource, -i, -annot and the like: the compiler's own text, compared with a reference the crop does not produce (the Parsetree is repr/ocaml's, the helper's, checked by the round trip)"
  :decided "survey §8.2"
  :match [#"^class header: (flags|ocamlc_flags)"]}
 {:id :tools-and-targets
  :title "tests of other tools, back ends and targets, and configuration conditions"
  :kind :design
  :why "the debugger, ocamldoc, TSan, frame pointers, flambda, other systems and architectures, flat-float-array and the like: not a program the levels run"
  :decided "survey §8.2"
  :match [#"^class header: (tsan|windows-|frame_pointers|function_sections|debugger|ocamldoc|ocamldebug|flambda|macos|target-windows|arch_|not-|no-|flat-float-array|skip|afl|bytecode-only|native-only|multicore)"]}
 {:id :orphan
  :title "a file with no header that no header names"
  :kind :corpus
  :why "the testsuite's own: a program used through a build the crop does not run (a dune-style dependency, a toplevel script, a data file in OCaml syntax)"
  :decided "survey §8.2"
  :match [#"^orphan"]}]

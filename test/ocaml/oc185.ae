;; OC185 (a) (the user, 2026-11-07; doc/ocaml/OCAML-SURVEY.md, "As built: OC185's switch, prepared"): REAP's OCaml eval and AOT
;; cells move to the native records once each has no fewer passes than its oracle twin. `compare` prints the four pairs and
;; exits 0 when every native record is there with no fewer passes; `apply` does the same, then rewrites test/reap/cells.edn's
;; four sources and test/crops/independence.edn's OCaml eval and AOT scores (0.880 and 0.5 to 1), each edit an exact text
;; replaced once (a text found other than once refuses the whole edit). Run by bin/oi reap-switch [--apply], in the checkout's
;; root. Arbace's own.

(def pairs
  [["eval" "test/ocaml/check-oi-native.edn" "test/ocaml/check-oi.edn"]
   ["eval (suite)" "test/ocaml/check-suite-oi-native.edn" "test/ocaml/check-suite-oi.edn"]
   ["AOT" "test/ocaml/check-aot-native.edn" "test/ocaml/check-aot.edn"]
   ["AOT (suite)" "test/ocaml/check-suite-aot-native.edn" "test/ocaml/check-suite-aot.edn"]])

(defn exists? [p] (.exists (java.io.File. ^String p)))

(defn counts [p]
  (when (exists? p)
    (let [rows (read-string (slurp p))]
      {:rows (count rows) :pass (count (filter #(= "pass" (second %)) rows))})))

(def cells-edits
  ;; [old new]: the four sources of [:ocaml :eval] and [:ocaml :aot] (the comment beside them in cells.edn)
  [["              :reader :ocaml :file \"test/ocaml/check-oi.edn\"}"
    "              :reader :ocaml :file \"test/ocaml/check-oi-native.edn\"\n              :classes [\"test/ocaml/divergences-native.edn\" \"test/ocaml/divergences.edn\"]}"]
   ["              :reader :ocaml :file \"test/ocaml/check-suite-oi.edn\" :classes \"test/ocaml/divergences-suite.edn\"}"
    "              :reader :ocaml :file \"test/ocaml/check-suite-oi-native.edn\" :classes \"test/ocaml/divergences-suite.edn\"}"]
   ["              :reader :ocaml :file \"test/ocaml/check-aot.edn\" :same-cases \"test/ocaml/check-oi.edn\"}"
    "              :reader :ocaml :file \"test/ocaml/check-aot-native.edn\" :same-cases \"test/ocaml/check-oi-native.edn\"}"]
   ["              :reader :ocaml :file \"test/ocaml/check-suite-aot.edn\" :same-cases \"test/ocaml/check-suite-oi.edn\""
    "              :reader :ocaml :file \"test/ocaml/check-suite-aot-native.edn\" :same-cases \"test/ocaml/check-suite-oi-native.edn\""]])

(def independence-edits
  [["   :eval {:score 0.880 :tool \"bin/oi check (native: TY24 (a))"
    "   :eval {:score 1 :tool \"bin/oi check (native: TY24 (a))"]
   ["   :aot {:score 0.5 :tool \"bin/oi check --aot, suite check --aot"
    "   :aot {:score 1 :tool \"bin/oi check --aot, suite check --aot"]])

(defn edit-text [^String text edits path]
  (reduce (fn [^String t [^String old ^String new]]
            (let [n (count (re-seq (re-pattern (java.util.regex.Pattern/quote old)) t))]
              (when (not= 1 n) (throw (ex-info (str path ": the text to replace is found " n " times: " old) {})))
              (.replace t old new)))
          text edits))

(let [[verb] *command-line-args*
      rs (for [[name nat orc] pairs] [name nat orc (counts nat) (counts orc)])
      ok (every? (fn [[_ _ _ n o]] (and n o (>= (long (:pass n)) (long (:pass o))))) rs)]
  (doseq [[name nat orc n o] rs]
    (println (str "oc185: " name ": " nat " " (if n (str (:pass n) " passes of " (:rows n)) "not recorded yet")
                  " against " orc " " (if o (str (:pass o) " of " (:rows o)) "missing")
                  (cond (nil? n) "" (and o (>= (long (:pass n)) (long (:pass o)))) ": no fewer" :else ": FEWER"))))
  (println (str "oc185: " (if ok "every native record has no fewer passes: the switch may be applied" "not yet: the switch waits")))
  (when (and ok (= verb "apply"))
    (let [c "test/reap/cells.edn" i "test/crops/independence.edn"
          ct (edit-text (slurp c) cells-edits c)
          it (edit-text (slurp i) independence-edits i)]
      (spit c ct) (spit i it)
      (println "oc185: applied: test/reap/cells.edn's four OCaml sources, test/crops/independence.edn's eval and AOT scores (now run bin/reap --record and bin/crops-score --record; update the facts' :why)")))
  (System/exit (if ok 0 1)))

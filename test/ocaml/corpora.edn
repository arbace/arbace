;; The OCaml corpora (doc/ocaml/OCAML-SURVEY.md §8.2, OC10 (a); doc/ocaml/SPEC.md §12): every corpus the OCaml
;; levels are checked over, each with its pin. Milestone O1 (2026-10-30) records them; nothing of them is
;; in the tree: each is read from the release tarball fetched into .tmp/ and pinned by SHA-256 (OC10 (a)
;; authorizes the download), or in place (go-whim's whiml at a commit and a tree hash). Read with the Clojure
;; reader. Keys: :id; :what; :where (:pin a key of :pins, :paths under the tarball's top directory, or a
;; :root and :paths); :select (extensions counted; files of those extensions under :paths, recursively);
;; :files and :lines (the counts as of O1, every selected file, `wc -l` over their concatenation; `bin/repr-ocaml
;; corpus check` recomputes them); :ml and :mli (the split of :files); :license; :levels (the REAP cells it serves);
;; :until (the milestone that first reads it, survey §11).
{:pins
 {:ocaml-5.5.0
  {:what "the release tarball of OCaml 5.5.0: the compiler, its stdlib and its testsuite (testsuite/tests is in it)"
   :url "https://caml.inria.fr/pub/distrib/ocaml-5.5/ocaml-5.5.0.tar.xz"
   :fetched-into ".tmp/repr-ocaml/src/ocaml-5.5.0.tar.xz"
   :bytes 4712612
   :sha256 "fcc6ae665d1ec51d52510eaac7834a86a9806bf5a258bb7cca78733fccf015ba"
   :sha512 "11402768b5ae9a5f43a386292167cf38ddb5ed75c72a015c5c3f8e8ad43b78941d2e8a2e71810b30d0645439db16486f354aff45b0d7d1e05e4f0b7e8adb5f05"
   :top "ocaml-5.5.0/"
   :checked ["VERSION inside it reads 5.5.0"
             "the GitHub archive of tag 5.5.0 (below) is a subset of it: `diff -rq` of the two extracted trees lists only the release's extra files (.github, .gitattributes, manual/, release-info/, testsuite/tests/, tools/ci/, the opam files) and testsuite/Makefile; stdlib/ and parsing/ are identical"]
   :license "LGPL-2.1-or-later WITH OCaml-LGPL-linking-exception (LICENSE in the tarball)"}
  :ocaml-5.5.0-github
  {:what "the GitHub archive of tag 5.5.0: what Alpine's ocaml5-5.5.0-r0 is built from; it lacks testsuite/tests, so it is a cross-check, not a corpus"
   :url "https://github.com/ocaml/ocaml/archive/refs/tags/5.5.0.tar.gz"
   :fetched-into ".tmp/repr-ocaml/src/ocaml-5.5.0-github.tar.gz"
   :bytes 5008847
   :sha256 "c018052c8264a3791a8f54f84179e6bcc78ed82eb889bacc2773df445259aed3"
   :sha512 "bf13c18cd1fc7b2e5e9623024ea8623710f646ff2fbc0f59dab70e4d4318ed8623bdcc3ec59ce37af07af2b767f520dea23fb474c26297b3e858b6c8e080b4e6"
   :commit "f5238509da6029a44ba0eb648f5dff7d9c89f519"
   :checked ["the SHA-512 equals the line for ocaml-5.5.0.tar.gz of Alpine aports main/ocaml5/APKBUILD (pkgver 5.5.0, pkgrel 0, _commit f5238509...), fetched from git.alpinelinux.org on 2026-10-30"
             "GitHub regenerates archives; the tarball is pinned by hash, not by URL's stability"]}
  :go-whim
  {:what "go-whim's whiml: vim's editor core emitted as OCaml by crefactor/togo's ML backend"
   :root "/root/go-whim"
   :commit "80c49bf53cd6340487ac623f3d6d135b77ac1db6"
   :tree "28bd9e102b14e49cb19dd655060dc6c8647bb34a"
   :tree-path "whiml"
   :license "go-whim's, Arbace's own pilot (/root/go-whim/LICENSE)"}
  :host
  {:what "the host's OCaml the helper is built with and the reference runs on (doc/ALPINE.md)"
   :ocamlopt "5.5.0"
   :apk {:ocaml5 "5.5.0-r0" :ocaml5-runtime "5.5.0-r0" :ocaml5-compiler-libs "5.5.0-r0"}
   :flambda false
   :ocamlcommon.cmxa-sha256 "d36ebf51026c5fb00b720825c795651fe7a25d0b78745073798d15ae2f430c75"}}
 :corpora
 [{:id :stdlib
   :what "the standard library, an .ml and an .mli per module"
   :where {:pin :ocaml-5.5.0 :paths ["stdlib"]}
   :select ["ml" "mli"]
   :files 150 :ml 71 :mli 79 :lines 52692
   :ocdump-rejects {:count 2 :files ["stdlib/templates/float.template.mli" "stdlib/templates/moreLabels.template.mli"]
                    :why "templates for the build's macro step, not OCaml"}
   :license "LGPL-2.1-or-later WITH OCaml-LGPL-linking-exception"
   :levels [:read :print :eval :aot]
   :until "O2"}
  {:id :compiler-sources
   :what "the compiler's front: parsing, typing, lambda, utils, driver (compiler-libs' ocamlcommon is this code)"
   :where {:pin :ocaml-5.5.0 :paths ["parsing" "typing" "lambda" "utils" "driver"]}
   :select ["ml" "mli"]
   :files 248 :ml 121 :mli 127 :lines 110242
   :excluded "parsing/lexer.mll, parser.mly and the other 18 .mll and 9 .mly files of the tree: generated sources are not read (the generated parser is boot/menhir/parser.ml)"
   :license "LGPL-2.1-or-later WITH OCaml-LGPL-linking-exception"
   :levels [:read :print]
   :until "O2"}
  {:id :compiler-backend
   :what "the compiler's back: asmcomp, bytecomp, middle_end, toplevel, file_formats"
   :where {:pin :ocaml-5.5.0 :paths ["asmcomp" "bytecomp" "middle_end" "toplevel" "file_formats"]}
   :select ["ml" "mli"]
   :files 346 :ml 181 :mli 165 :lines 64245
   :license "LGPL-2.1-or-later WITH OCaml-LGPL-linking-exception"
   :levels [:read :print]
   :until "O2"}
  {:id :testsuite
   :what "the compiler's testsuite: testsuite/tests (ocamltest .ml files, many meant to fail or to print an error) with testsuite/lib and tools"
   :where {:pin :ocaml-5.5.0 :paths ["testsuite"]}
   :select ["ml" "mli"]
   :files 1862 :ml 1761 :mli 101 :lines 179633
   :of-which {:tests-dir {:files 1829 :ml 1745 :mli 84 :lines 174422}
              :test-header 1506
              :with-reference 556}
   :ocdump-rejects {:count 61 :why "tests of syntax errors and of the lexer (O1 probe: syntax errors but for one lexer error); each is judged on the compiler's message at O2"}
   :action :mixed
   :license "LGPL-2.1-or-later WITH OCaml-LGPL-linking-exception (no linking exception for the tests' own text, survey §9)"
   :levels [:read :print :eval :aot]
   :until "O2 (read), O7 (actions and classes)"}
  {:id :whiml
   :what "go-whim's whiml, generated (editor.ml, 57,093 lines) and hand-written OCaml"
   :where {:pin :go-whim :paths ["whiml"]}
   :select ["ml" "mli"]
   :files 8 :ml 7 :mli 1 :lines 58479
   :license "go-whim's"
   :levels [:read :print :eval :aot]
   :until "O2"}
  {:id :samples
   :what "Arbace's own samples, one file per area of the spec (the typed ones also type and lambda)"
   :where {:root "test/ocaml/samples" :paths ["."]}
   :select ["ml" "mli"]
   :files 8 :ml 7 :mli 1 :lines 246
   :typed ["core.ml" "effects.ml"]
   :license "Arbace's"
   :levels [:read :print :eval :aot]
   :until "O1"}]}

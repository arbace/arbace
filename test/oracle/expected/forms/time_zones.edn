  {:id 4 :line 20 :form "(defn rel-gmt\n  \"name n relative to the raw offset raw-ms when n is in the GMT format, else n.\"\n  [n raw-ms]\n  (if-let [[_ sg hh mm] (if (= n \"GMT\") [n \"+\" \"00\" \"00\"] (re-matches #\"GMT([+-])(\\d\\d):(\\d\\d)\" n))]\n    (let [d (- (* (if (= sg \"-\") -1 1) (+ (* 60 (Long/parseLong hh)) (Long/parseLong mm))) (quot raw-ms 60000))]\n      (str \"GMT(raw\" (cond (pos? d) (str \"+\" d) (neg? d) (str d) :else \"\") \")\"))\n    n))" :class "arbace.lang.Var" :value "#'user/rel-gmt"}
  {:id 5 :line 28 :form "(defn zone-names [group ^Locale l]\n  (vec (for [id (take 25 (drop (* 25 group) zone-ids))]\n         (let [tz (TimeZone/getTimeZone ^String id)\n               raw (.getRawOffset tz)\n               names (into [(.getDisplayName tz false TimeZone/LONG l) (.getDisplayName tz false TimeZone/SHORT l)\n                            (.getDisplayName tz true TimeZone/LONG l) (.getDisplayName tz true TimeZone/SHORT l)]\n                           (when (region-ids id)\n                             (let [z (ZoneId/of id)]\n                               [(.getDisplayName z TextStyle/FULL l) (.getDisplayName z TextStyle/SHORT l)])))]\n           (into [id] (map #(rel-gmt % raw)) names)))))" :class "arbace.lang.Var" :value "#'user/zone-names"}

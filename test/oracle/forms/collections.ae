;; ----- large maps
(def big (zipmap (range 1000) (map #(* 2 %) (range 1000))))
(count big)
(hash big)
(reduce + (vals big))
(take 10 (sort (keys big)))
(get big 999)
(get big 1000)
(count (dissoc big 0 1 2))
(count (reduce dissoc big (range 500)))
(hash (reduce dissoc big (range 500)))
(= big (into {} (map (fn [i] [i (* 2 i)]) (range 999 -1 -1))))
(def bigs (zipmap (map #(str "key" %) (range 1000)) (range 1000)))
(get bigs "key500")
(hash bigs)
(take 10 (sort (keys bigs)))
(count (set (vals bigs)))
(reduce-kv (fn [a k v] (+ a v (count k))) 0 bigs)
(def bigset (set (map #(keyword (str "kw" %)) (range 1000))))
(count bigset)
(hash bigset)
(contains? bigset :kw999)
(take 5 (sort bigset))
(count (persistent! (reduce dissoc! (transient big) (range 0 1000 2))))
(hash (persistent! (reduce dissoc! (transient big) (range 0 1000 2))))
(count (into {} (map (fn [i] [(keyword (str i)) i]) (range 1000))))
(let [m (reduce (fn [m i] (assoc m (* i 7919) i)) {} (range 3000))] [(count m) (hash m) (get m (* 1234 7919))])
(let [s (reduce conj #{} (map #(str (char (+ 65 (mod % 26))) %) (range 2000)))] [(count s) (hash s)])


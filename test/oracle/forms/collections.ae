;; ----- large vectors: tail and tree boundaries
(def v32 (vec (range 32)))
(def v33 (vec (range 33)))
(def v1056 (vec (range 1056)))
(def v1057 (vec (range 1057)))
(def v40000 (vec (range 40000)))
(count v32)
(count (conj v32 :x))
(nth (conj v32 :x) 32)
(peek (conj v32 :x))
(pop v33)
(count (pop v33))
(peek (pop v33))
(count v1056)
(nth v1056 1055)
(nth v1056 1024)
(nth v1056 1023)
(peek (conj v1056 :x))
(count (conj v1056 :x))
(nth (conj v1056 :x) 1056)
(count (pop v1057))
(peek (pop v1057))
(nth (pop v1057) 1055)
(count (pop (pop v1057)))
(nth (assoc v1057 1056 :last) 1056)
(nth (assoc v1057 500 :mid) 500)
(nth (assoc v1057 1057 :end) 1057)
(assoc v1057 1058 :bad)
(nth v1057 1057)
(nth v40000 39999)
(nth v40000 32768)
(nth v40000 32767)
(reduce + v40000)
(count (pop v40000))
(peek (pop v40000))
(nth (assoc v40000 33000 :x) 33000)
(subvec v1057 1020 1040)
(take 5 (rseq v1057))
(reduce + (subvec v1057 100 900))
(= v1057 (vec (range 1057)))
(= v1057 (range 1057))
(hash v1057)
(hash v33)
(loop [v v1057 n 0] (if (empty? v) n (recur (pop v) (inc n))))
(let [v (reduce conj [] (range 2000))] [(count v) (nth v 1999) (nth v 1056) (hash v)])
(let [v (loop [v v1057 i 0] (if (= i 1000) v (recur (pop v) (inc i))))] [(count v) (peek v) (hash v)])
(count (into v1056 (range 100)))


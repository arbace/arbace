;; ----- predicates
(map coll? [[] '() {} #{} nil "s" (range 1) (seq [1]) (->P 1 2) (int-array 1)])
(map seq? [[] '() {} #{} nil "s" (range 1) (seq [1]) (lazy-seq nil) (cons 1 nil)])
(map sequential? [[] '() {} #{} nil "s" (range 1) (seq [1]) (subvec [1] 0)])
(map associative? [[] '() {} #{} nil "s" (->P 1 2) (sorted-map)])
(map counted? [[] '() {} #{} nil "s" (range 1) (seq [1]) (lazy-seq nil) (cons 1 nil) (int-array 1)])
(map reversible? [[] '() {} #{} (sorted-map) (sorted-set) (range 3) (subvec [1] 0)])
(map sorted? [[] {} (sorted-map) (sorted-set) (sorted-map-by >)])
(map seqable? [[] nil "s" 1 :a (int-array 1) (java.util.ArrayList.) {}])
(map indexed? [[] '() (subvec [1 2] 1) "s" (vector-of :int)])
(map ifn? [[] {} #{} :a 'a "s" 1 (->P 1 2) inc])
(map fn? [inc :a [] #'inc])
(map vector? [[] (subvec [1] 0) (vector-of :int) '() (first {:a 1})])
(map map? [{} (sorted-map) (->P 1 2) [] (java.util.HashMap.)])
(map set? [#{} (sorted-set) [] (java.util.HashSet.)])
(map list? ['() (list 1) (cons 1 '()) []])
(map record? [(->P 1 2) {}])
(map nil? [nil false []])
(map some? [nil false []])
(map distinct? [1 2 3] [1 2 1] [:a :b :c])
(distinct? 1)
(distinct? 1 1)
(map boolean [nil false 0 "" []])


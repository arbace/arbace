;; oracle: recorded by goi (doc/go/GOI-SPEC.md S54): the frozen JVM Arbace has no Go forms, so these
;; cases' expected results are the Go build's (bin/oracle record --goi IMPL forms/go), reviewed.
;; Cross-dialect cases (goi's GR5, GOI-SPEC.md §7): Arbace calling Go forms and compiled Go, Go
;; forms calling Arbace (the package arbace) and compiled Go, Arbace fns as Go func values, Java
;; forms and Go forms through vars, Go panics leaving Go (GoPanic), Go values printed, in Arbace's
;; collection protocols and by interop; §1.4's session first.

;; ----- §1.4's session
(ns go.oracle.demo (:require [arbace.go :as go]))
(go/import [strings "strings"] [fmt "fmt"])
(go/func Greet ^string [^string name] (+ "hello, " (strings/ToUpper name)))
(Greet "go")
(go/type Point (struct ^int X ^int Y))
(go/method String ^string [^Point p] (fmt/Sprintf "(%d,%d)" (.-X p) (.-Y p)))
(go/eval (fmt/Println (lit Point 1 2)) (lit Point :X 3))
(go/func Div ^int [^int a ^int b] (/ a b))
(Div 7 2)
(Div 1 0)
(go/func Greet ^string [^string name] (+ "hi, " name))
(Greet "go")

;; ----- Arbace calling Go forms: arguments and results converted by the Go types (§5.6)
(go/func Add8 ^int8 [^int8 a ^int8 b] (+ a b))
(Add8 100 27)
(Add8 100 28)
(Add8 300 1)
(Add8 "x" 1)
(go/func Halves [^float64 x] :results [^float64 h ^bool exact] (set! h (/ x 2)) (set! exact (== (* h 2) x)) (return))
(Halves 3.0)
(go/func Words ^{:tag (slice string)} [^string s] (strings/Fields s))
(Words " a b  c ")
(vec (Words " a b  c "))
(count (Words "x y"))
(go/func Lookup [^{:tag (map string int)} m ^string k] :results [^int v ^bool ok] (set! (values v ok) (aget m k)) (return))
(go/func Table ^{:tag (map string int)} [] (lit (map string int) ["one" 1] ["two" 2]))
(Lookup (Table) "two")
(Lookup (Table) "three")
(into (sorted-map) (Table))
(get (Table) "one")
(go/func Sum ^int [& ^{:tag (slice int)} xs] (let [t 0] (range [_ x xs] (set! t + x)) t))
[(Sum) (Sum 1 2 3)]
(Sum (go/spread (go/eval (lit (slice int) 3 4))))

;; ----- Go values in Arbace: printed (§5.7), their fields and methods (GS10), their elements (GS7)
(go/func MkPoint ^Point [^int x ^int y] (lit Point x y))
(MkPoint 1 2)
(str (MkPoint 1 2))
(class (MkPoint 1 2))
(= (MkPoint 1 2) (MkPoint 1 2))
(:X (MkPoint 4 5))
[(get (MkPoint 4 5) :Y) (get (MkPoint 4 5) :Z :none)]
(.-Y (MkPoint 4 5))
(.String (MkPoint 4 5))
(go.oracle.demo/Point.String (MkPoint 6 7))
(go/func Grid ^{:tag (array 2 (array 2 int))} [] (lit (array 2 (array 2 int)) (lit (array 2 int) 1 2) (lit (array 2 int) 3 4)))
(mapv vec (Grid))
(nth (nth (Grid) 1) 0)
(nth (Words "a b") 5)
(nth (Words "a b") 5 :none)

;; ----- Arbace fns as Go func values (§7.5)
(go/func Apply ^int [^{:tag (func [int] [int])} f ^int x] (f x))
(Apply inc 41)
(Apply (fn [x] (* x x)) 12)
(Apply (fn [x] "not an int") 1)
(Apply (fn [x] (throw (ex-info "from Arbace" {:x x}))) 3)
(go/func Twice ^{:tag (func [int] [int])} [^{:tag (func [int] [int])} f] (fn ^int [^int x] (f (f x))))
((Twice inc) 5)
((Twice (Twice (fn [x] (* 2 x)))) 1)
(go/func MapStrings ^{:tag (slice string)} [^{:tag (func [string] [string])} f & ^{:tag (slice string)} xs]
  (let [out (make (slice string) 0)] (range [_ x xs] (set! out (append out (f x)))) out))
(vec (MapStrings (fn [s] (apply str (reverse s))) "abc" "de"))

;; ----- Arbace calling compiled Go: the table's packages (§7.2), Arbace fns given to them
(require '[go.strings :as gs] '[go.sort :as gsort] '[go.strconv :as gconv])
(gs/Map (fn [r] (if (= r (int \a)) (int \A) r)) "banana")
(gs/FieldsFunc "a1b22c" (fn [r] (Character/isDigit (int r))))
(vec (gs/FieldsFunc "a1b22c" (fn [r] (Character/isDigit (int r)))))
(let [xs (go/eval (lit (slice string) "pear" "fig" "apple"))]
  (gsort/Slice xs (fn [i j] (< (count (nth xs i)) (count (nth xs j)))))
  (vec xs))
(gconv/Atoi "42")
(first (gconv/Atoi "x"))
(go/str (second (gconv/Atoi "x")))
(let [b (go/new gs/Builder)] (.WriteString b "ab") (.WriteByte b 99) [(.Len b) (.String b)])

;; ----- Go forms calling Arbace: the package arbace (§7.3)
(ns go.oracle.api (:require [arbace.go :as go]))
(go/import [arbace "arbace"] [strings "strings"])
(go/func Inc ^int64 [^int64 x] (arbace/Long (arbace/Call (arbace/Var "arbace.core/inc") x)))
(Inc 41)
(go/func Join ^string [^any coll] (let [parts (make (slice string) 0)] (range [x (arbace/Seq coll)] (set! parts (append parts (arbace/GoStr x)))) (strings/Join parts ",")))
(Join [1 :a "b" 'c nil 2.5])
(Join (range 4))
(Join nil)
(go/func Names ^string [] (arbace/GoStr (arbace/Call "arbace.core/pr-str" (arbace/Kw "k/w") (arbace/Sym "s") (arbace/Str "t"))))
(Names)
(go/func Upper ^string [^any s] (arbace/GoStr (arbace/Invoke s "toUpperCase")))
(Upper "abc")
(go/func Truths ^{:tag (slice bool)} [& ^{:tag (slice any)} xs] (let [out (make (slice bool) 0)] (range [_ x xs] (set! out (append out (arbace/Bool x)))) out))
(vec (Truths nil false true 0 "" []))
(go/func Counter ^any [] (let [n 0] (arbace/Fn (fn ^any [& ^{:tag (slice any)} xs] (inc! n) (+ n (len xs))))))
(let [f (Counter)] [(f) (f :a :b) (f)])
(go/func Swap ^any [^any a] (arbace/Call "arbace.core/swap!" a (arbace/Var "arbace.core/conj") (arbace/Kw "go")))
(let [a (atom [])] (Swap a) (Swap a) @a)
(go/func Flt ^float64 [^any x] (arbace/Float64 x))
[(Flt 1.5) (Flt 3) (Flt 1/4)]
(Flt "x")
(go/func CallThrows ^string [] (arbace/GoStr (arbace/Call "arbace.core/inc" "x")))
(CallThrows)
(go/func Recovered ^string [] :results [^string r] (defer ((fn [] (set! r (arbace/GoStr (recover)))))) (arbace/Call "arbace.core/inc" "x") (return))
(Recovered)

;; ----- panics leaving Go (§10.4): gc's text, the Java exception as a run-time error's cause
;; (GS11), the interpreted frames (§10.6)
(ns go.oracle.panics (:require [arbace.go :as go]))
(go/import [fmt "fmt"] [errors "errors"])
(go/type Celsius float64)
(go/type Code int)
(go/method String ^string [^Code c] (fmt/Sprintf "code-%d" (conv int c)))
(go/func Fail [^int k]
  (switch k
    (case [0] (panic "a string"))
    (case [1] (panic (errors/New "an error")))
    (case [2] (panic 2.5))
    (case [3] (panic (conv Celsius 36.6)))
    (case [4] (panic (conv Code 7)))
    (case [5] (panic (fmt/Errorf "wrapped: %w" (errors/New "inner"))))
    (case [6] (let [xs (make (slice int) 1)] (fmt/Println (aget xs k))))
    (case [7] (let [^{:tag (* int)} p nil] (fmt/Println @p)))))
(mapv #(try (Fail %) (catch arbace.lang.GoPanic e [(ex-message e) (:go/type (ex-data e)) (some-> (ex-cause e) class)])) (range 8))
(Fail 6)
(go/func Depth ^int [^int n] (when (== n 0) (return (/ n n))) (+ 1 (Depth (- n 1))))
(try (Depth 3) (catch arbace.lang.GoPanic e (mapv first (:go/trace (ex-data e)))))
(try (Depth 3) (catch arbace.lang.GoPanic e (.getClassName (first (.getStackTrace e)))))
(go/func Catch [^{:tag (func [])} f] :results [^string r] (defer ((fn [] (set! r (fmt/Sprint (recover)))))) (f) (return))
(Catch (fn [] (Fail 1)))
(Catch (fn [] (Depth 0)))

;; ----- Java forms and Go forms through vars (§7.6)
(in-ns 'user)
(defclass ^:public GoCaller
  (constructor ^:public [this])
  (method ^:public ^:static greet ^Object [^String s] (.invoke (arbace.lang.RT/var "go.oracle.demo" "Greet") s))
  (method ^:public ^:static applyGo ^Object [f ^long x] (.invoke (arbace.lang.RT/var "go.oracle.demo" "Apply") f x))
  (method ^:public tag ^String [this ^String s] (java-str "<" s ">")))
(GoCaller/greet "java")
(GoCaller/applyGo inc 9)
(in-ns 'go.oracle.api)
(go/func TagIt ^string [^any obj ^string s] (arbace/GoStr (arbace/Invoke obj "tag" s)))
(TagIt (user.GoCaller.) "go")

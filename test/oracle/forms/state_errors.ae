;; ----- regexes
(re-find #"\d+" "abc123def456")
(re-find #"(\d)(\d)" "x12y")
(re-find #"z" "abc")
(re-find #"(a)?b" "b")
(re-matches #"\d+" "123")
(re-matches #"\d+" "123a")
(re-matches #"(\w+)@(\w+)" "me@host")
(re-matches #"(\w+)@(\w+)" "not an email")
(re-matches #"" "")
(re-seq #"\d" "a1b2c3")
(re-seq #"(\w)(\d)" "a1 b2 c3")
(re-seq #"x" "abc")
(re-seq #"" "ab")
(re-seq #"a*" "baaac")
(let [m (re-matcher #"(\d)(\w)" "1a 2b")] [(re-find m) (re-find m) (re-find m)])
(let [m (re-matcher #"(\d)(\w)" "1a 2b")] (re-find m) (re-groups m))
(let [m (re-matcher #"\d" "1")] (re-find m) (re-groups m))
(let [m (re-matcher #"\d" "x")] (re-groups m))
(let [m (re-matcher #"(?<year>\d{4})-(?<month>\d{2})" "on 2024-05 ok")] (when (.find m) [(.group m "year") (.group m "month") (.start m) (.end m)]))
(let [m (re-matcher #"(?<word>[a-z]+)" "123")] (.find m))
(re-find #"(?<y>\d+)" "x42")
(re-find #"(?i)hello" "HeLLo world")
(re-find #"(?m)^b" "a\nb")
(re-find #"(?s)a.b" "a\nb")
(re-find #"a.b" "a\nb")
(re-seq #"\p{Upper}" "aBcD")
(re-seq #"[éè]" "étè")
(re-find #"\bword\b" "a word here")
(re-find #"(a|ab)(c|bcd)(d*)" "abcd")
(re-find #"^$" "")
(re-pattern "a+b")
(re-pattern #"already")
(class (re-pattern "x"))
(str #"a\d")
(pr-str #"a\d")
(pr-str #"\"quoted\"")
(pr-str (re-pattern "/slash"))
(= #"a" #"a")
(.pattern #"a\sb")
(re-find (re-pattern (java.util.regex.Pattern/quote "a.b")) "xa.by")
(re-find #"a.b" "axb")
(str/replace "hello world" #"o" "0")
(str/replace "hello world" #"(\w+) (\w+)" "$2 $1")
(str/replace "a1b2" #"\d" #(str "<" % ">"))
(str/replace "a1b2" #"([a-z])(\d)" (fn [[_ l d]] (str d l)))
(str/replace "x.y.z" "." "-")
(str/replace "$1" "$" "\\")
(str/replace "abc" #"b" "\\$")
(str/replace "abc" #"b" "$")
(str/replace "abc" #"b" "$2")
(str/replace "aaa" #"a" (str/re-quote-replacement "$1"))
(str/replace-first "aaa" #"a" "b")
(str/replace-first "a.a" "." "!")
(str/replace-first "abc" #"(b)" "[$1]")
(str/replace "abc" \b \x)
(str/split "a,b,,c,," #",")
(str/split "a,b,,c,," #"," -1)
(str/split "a1b22c" #"\d+")
(str/split "" #",")
(str/split "abc" #"")
(str/split " a  b " #"\s+")
(str/split "a:b:c" #":" 2)
(str/split-lines "l1\nl2\r\nl3")
(str/re-quote-replacement "a$b\\c")
(re-find #"(\d+)-(\d+)" "10-20")
(let [[_ a b] (re-find #"(\d+)-(\d+)" "10-20")] (+ (parse-long a) (parse-long b)))
(re-matches #"a" nil)
(re-seq #"a" nil)
(re-find #"\d" 123)


(eval #{'(inc 1)})
(eval :kw)
(eval nil)
(eval ''quoted)
(eval '(def evald-var 77))
evald-var
(eval '(do (defn evald-fn [x] (* 3 x)) (evald-fn 3)))
(eval '(undefined-fn 1))
(eval '(let [x] x))
(eval (list 'quote (list 1 2)))
(eval (cons 'vector (range 3)))
(eval (list 'apply '+ [1 2 3]))
(eval '(if false 1))
(fn? (eval '(fn* [] 1)))
(eval '(. "abc" (toUpperCase)))
(str (eval '(new java.lang.StringBuilder "x")))
(eval '(set! *dyn* 1))
(eval '(binding [*dyn* 2] (set! *dyn* 3) *dyn*))

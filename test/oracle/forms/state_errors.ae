(try (throw (ex-info "caught" {:code 42})) (catch arbace.lang.ExceptionInfo e (:code (ex-data e))))
(try (throw (ex-info "caught" {:code 42})) (catch RuntimeException e (ex-data e)))
(let [m (Throwable->map (ex-info "top" {:a 1} (IllegalStateException. "root cause")))] [(:cause m) (mapv :type (:via m)) (mapv :message (:via m)) (:data m) (mapv :data (:via m))])
(let [m (Throwable->map (Exception. "solo"))] (select-keys m [:cause :data]))
(mapv :type (:via (Throwable->map (ex-info "a" {} (ex-info "b" {:n 2} (ArithmeticException. "c"))))))
(:data (Throwable->map (ex-info "a" {} (ex-info "b" {:n 2}))))

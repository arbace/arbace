(fn? (eval (list 'fn '[x] (list '* 'x 'x))))
((eval (list 'fn '[x] (list '* 'x 'x))) 7)
(eval `(let [x# 5] (* x# 2)))
(eval (read-string "(map inc [1 2 3])"))
(eval (read-string "{:a (+ 1 1)}"))

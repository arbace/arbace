;; Dynamic vars, reference types, exceptions, metadata, namespaces, symbols and keywords, regexes,
;; eval.

(require '[arbace.string :as str])

;; ----- dynamic vars
(def ^:dynamic *dyn* :root)
*dyn*
(binding [*dyn* :bound] *dyn*)
(binding [*dyn* 1] (binding [*dyn* 2] *dyn*))
(binding [*dyn* 1] [(binding [*dyn* 2] *dyn*) *dyn*])
(binding [*dyn* 1] (set! *dyn* 5) *dyn*)
(binding [*dyn* 1] (set! *dyn* (inc *dyn*)) (set! *dyn* (* 10 *dyn*)) *dyn*)
*dyn*
(set! *dyn* 3)
(def not-dynamic 1)
(binding [not-dynamic 2] not-dynamic)
(binding [undefined-var 1] 1)
(defn read-dyn [] *dyn*)
(binding [*dyn* :in-fn] (read-dyn))
(let [f (binding [*dyn* :captured] (fn [] *dyn*))] (f))
(let [f (binding [*dyn* :conveyed] (bound-fn [] *dyn*))] (f))
(let [s (binding [*dyn* :lazy] (map (fn [_] *dyn*) [1 2]))] (vec s))
(binding [*dyn* :a] (with-bindings {#'*dyn* :b} *dyn*))
(with-bindings* {#'*dyn* :wb} read-dyn)
(binding [*dyn* 1 *dyn* 2] *dyn*)
(bound? #'*dyn*)
(def unbound-var)
(bound? #'unbound-var)
unbound-var
(class unbound-var)
(thread-bound? #'*dyn*)
(binding [*dyn* 1] (thread-bound? #'*dyn*))
(:dynamic (meta #'*dyn*))
(.isDynamic #'*dyn*)
(.isDynamic #'not-dynamic)
(def ^:dynamic *other* 10)
(binding [*dyn* 1 *other* *dyn*] [*dyn* *other*])
(contains? (get-thread-bindings) #'*ns*)
(binding [*dyn* :x] (get (get-thread-bindings) #'*dyn*))
(def ^:dynamic not-earmuffed 1)
(binding [not-earmuffed 2] not-earmuffed)
(def *earmuffed-not-dynamic* 1)

;; ----- with-redefs, alter-var-root, var-get
(defn target [] :original)
(defn calls-target [] (target))
(with-redefs [target (fn [] :redefined)] (calls-target))
(calls-target)
(with-redefs [target (fn [] :r1) not-dynamic 99] [(target) not-dynamic])
not-dynamic
(try (with-redefs [target (fn [] :temp)] (throw (Exception. "inside"))) (catch Exception e (calls-target)))
(with-redefs-fn {#'target (constantly :fn-version)} calls-target)
(def counter 0)
(alter-var-root #'counter inc)
(alter-var-root #'counter + 10)
counter
(alter-var-root #'counter (fn [_] (throw (Exception. "no"))))
counter
(var-get #'counter)
(= map (var-get #'map))
@#'counter
(#'inc 1)
(var counter)
#'counter
(.-sym #'counter)
(.toSymbol #'counter)
(symbol #'counter)
(.ns #'counter)
(ns-name (.ns #'counter))
(var-set #'counter 5)
(binding [*dyn* 1] (var-set #'*dyn* 7) *dyn*)
(def x-redef 1)
(def x-redef 2)
x-redef
(defonce once-only 1)
(defonce once-only 2)
once-only
(def ^:const konst 42)
(+ konst 1)
(:const (meta #'konst))
(declare later)
later
(def later 3)
later
(intern 'user 'interned-var 99)
interned-var
(intern 'user 'interned-unbound)
(bound? #'interned-unbound)
(intern 'no.such.ns 'x 1)
(var no-such-var)
(find-var 'user/counter)
(find-var 'user/nope)
(find-var 'arbace.core/map)
(find-var 'no.such.ns/x)
(find-var 'unqualified)

;; ----- atoms
(def a (atom 0))
@a
(swap! a inc)
(swap! a + 10)
(swap! a + 1 2 3)
(swap! a (fn [x y z w] (+ x y z w)) 1 1 1)
(swap-vals! a inc)
(reset! a 100)
(reset-vals! a 5)
(compare-and-set! a 5 6)
(compare-and-set! a 5 7)
@a
(let [b (atom [1])] (compare-and-set! b [1] [2]))
(let [v [1] b (atom v)] (compare-and-set! b v [2]))
(let [b (atom 1)] (swap! b (fn [_] (throw (IllegalStateException. "bad swap")))))
(def va (atom 1 :validator pos?))
(swap! va inc)
(swap! va - 10)
@va
(reset! va 0)
(reset! va -1)
(atom -1 :validator pos?)
(set-validator! va #(< % 100))
(reset! va 1000)
(reset! va -5)
(set-validator! va (fn [_] (throw (ex-info "validator threw" {:k 1}))))
(reset! va 1)
(set-validator! va nil)
(reset! va -5)
(get-validator va)
(def wa (atom 0))
(add-watch wa :printer (fn [k r o n] (println "watch" k o "->" n)))
(swap! wa inc)
(reset! wa 10)
(reset! wa 10)
(add-watch wa :second (fn [k r o n] (println "second" n)))
(swap! wa inc)
(remove-watch wa :printer)
(swap! wa inc)
(remove-watch wa :second)
(swap! wa inc)
(count (.getWatches wa))
(def ma (atom 1 :meta {:m 1}))
(meta ma)
(alter-meta! ma assoc :n 2)
(meta ma)
(reset-meta! ma {})
(meta ma)
(deref a)
(deref (atom nil))
(swap! (atom {}) assoc :a 1)
(swap! (atom {}) update :n (fnil inc 0))
(swap! (atom [1 2]) conj 3)
(swap! 1 inc)

;; ----- volatiles
(def v (volatile! 1))
@v
(vswap! v inc)
(vswap! v + 10)
(vreset! v :new)
@v
(volatile? v)
(volatile? (atom 1))
(let [vv (volatile! [])] (dotimes [i 3] (vswap! vv conj i)) @vv)

;; ----- refs and transactions
(def rf (ref 1))
@rf
(dosync (alter rf inc))
(dosync (alter rf + 10) (alter rf * 2))
(dosync (ref-set rf 100))
(dosync (commute rf inc))
@rf
(alter rf inc)
(ref-set rf 5)
(dosync (ensure rf))
(def r2 (ref [] :validator vector?))
(dosync (alter r2 conj 1))
(dosync (ref-set r2 :not-vector))
@r2
(def r3 (ref 0))
(add-watch r3 :w (fn [k r o n] (println "ref-watch" o n)))
(dosync (alter r3 inc) (alter r3 inc))
(try (dosync (ref-set r3 50) (throw (Exception. "rollback"))) (catch Exception e (ex-message e)))
@r3
(dosync)
(dosync 1 2 3)
(sync nil (alter r3 inc))
(let [x (ref 1) y (ref 2)] (dosync (let [s (+ @x @y)] (ref-set x s) (ref-set y (* 2 s)))) [@x @y])
(dosync (dosync (alter r3 inc)))
(io! :ok)
(dosync (io! :not-ok))
(ref-history-count rf)
(ref-min-history rf)
(ref-max-history rf)

;; ----- delays and promises
(def d (delay (println "computing delay") :value))
(realized? d)
@d
@d
(realized? d)
(force d)
(force 5)
(force nil)
(delay? d)
(delay? 1)
(def bad-delay (delay (throw (Exception. "delay failed"))))
@bad-delay
@bad-delay
(realized? bad-delay)
(let [n (atom 0) dd (delay (swap! n inc))] [@dd @dd @n])
(def p (promise))
(realized? p)
(deliver p :delivered)
@p
(realized? p)
(deliver p :again)
@p
(deref (promise) 10 :timed-out)
(let [pp (promise)] (deliver pp nil) [(realized? pp) @pp])

;; ----- exceptions: try/catch/finally ordering
(try 1 (finally (println "finally")))
(try (println "body") 2 (catch Exception e (println "catch") 3) (finally (println "finally")))
(try (println "body") (throw (Exception. "x")) (catch Exception e (println "catch" (ex-message e)) :caught) (finally (println "finally")))
(try (throw (Exception. "x")) (finally (println "finally runs")))
(try 1 (finally 2))
(try (throw (Exception. "x")) (catch Exception e :c) (finally :ignored))
(try)
(try 1 2 3)
(try (/ 1 0) (catch ArithmeticException e (ex-message e)))
(try (/ 1 0) (catch IllegalStateException e :wrong) (catch ArithmeticException e :right))
(try (/ 1 0) (catch RuntimeException e :runtime) (catch ArithmeticException e :arith))
(try (/ 1 0) (catch Exception e :exception) (catch Throwable t :throwable))
(try (throw (Error. "err")) (catch Exception e :exception) (catch Throwable t [:throwable (ex-message t)]))
(try (try (throw (Exception. "inner")) (finally (println "inner finally"))) (catch Exception e (str "outer caught " (ex-message e))))
(try (try (throw (Exception. "first")) (catch Exception e (throw (Exception. "second" e)))) (catch Exception e [(ex-message e) (ex-message (ex-cause e))]))
(try (throw (Exception. "a")) (catch Exception e (try (throw (Exception. "b")) (catch Exception e2 [(ex-message e) (ex-message e2)]))))
(try (throw (Exception. "f")) (finally (throw (Exception. "from finally"))))
(let [log (atom [])] (try (swap! log conj :try) (throw (Exception. "x")) (catch Exception _ (swap! log conj :catch)) (finally (swap! log conj :finally))) @log)
(let [log (atom [])] (try (try (swap! log conj 1) (finally (swap! log conj 2))) (finally (swap! log conj 3))) @log)
(loop [i 0] (if (< i 3) (recur (try (inc i) (finally nil))) i))
(defn try-recur [n] (if (pos? n) (try (recur (dec n)) (finally nil)) :done))
(throw (Exception. "plain"))
(throw (RuntimeException. "runtime"))
(throw (IllegalArgumentException. "illegal arg"))
(throw (Exception.))
(throw (Exception. "with cause" (IllegalStateException. "root")))
(throw (Exception. (Exception. "cause-only")))
(throw "not throwable")
(throw nil)
(throw (ex-info "info" {:a 1}))
(throw (ex-info "info with cause" {:a 1} (ex-info "inner" {:b 2})))
(throw (ex-info "nested" {:l 1} (ex-info "two" {:l 2} (ex-info "three" {:l 3} (Exception. "bottom")))))
(throw (ex-info nil {}))
(ex-data (ex-info "m" nil))
(ex-info "m" 5)
(ex-data (ex-info "m" {:x 1}))
(ex-data (Exception. "m"))
(ex-data nil)
(ex-data 1)

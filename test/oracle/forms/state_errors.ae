;; ----- apply/partial on multimethods
(defmulti mm-op (fn [op & _] op))
(some? (defmethod mm-op :add [_ & xs] (apply + xs)))
(some? (defmethod mm-op :mul [_ & xs] (apply * xs)))
(apply mm-op :add [1 2 3])
(apply mm-op :mul 2 [3 4])
((partial mm-op :add 10) 5)
(map (partial mm-op :mul 2) [1 2 3])
(reduce (partial mm-op :add) 0 [1 2 3])
(apply mm-op [:add])
(try (apply mm-op []) (catch arbace.lang.ArityException e [:arity (.-actual e)]))
(mm-op :sub 1)
((comp (partial mm-op :add 1) (partial mm-op :mul 2)) 5)
(apply mm-op :add (range 30))

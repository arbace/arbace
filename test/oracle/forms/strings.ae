(str {:a "x"})
(str #{})
(str [])
(str ())
(str (list))
(str (range 3))
(str (map inc [1 2]))
(str (lazy-seq nil))
(str (seq [1 2]))
(str (cons 1 nil))
(str \a)
(str \newline)
(str 1.0 1/2 1N 1M)
(str "" "")
(str (StringBuilder. "sb"))
(str [nil])
(str {nil nil})
(str #"a+b")
(str (first {:a 1}))
(apply str (interpose "," ["a" "b" "c"]))
(apply str (reverse "hello"))
(apply str [\a \b])


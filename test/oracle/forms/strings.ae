;; ----- escape and reverse
(str/escape "a<b>&c" {\< "&lt;" \> "&gt;" \& "&amp;"})
(str/escape "abc" {\b nil})
(str/escape "abc" {\b 1})
(str/escape "" {\a "b"})
(str/escape "a😀" {\a "A"})
(str/reverse "hello")
(str/reverse "")
(str/reverse "a😀b")
(map int (str/reverse "a😀b"))
(str/reverse "é")
(apply str (reverse "a😀b"))
(map int (apply str (reverse "a😀b")))
(.toString (.reverse (StringBuilder. "x😀y")))

;; ----- comparison and sorting
(compare "a" "b")
(compare "b" "a")
(compare "abc" "abd")
(compare "abc" "ab")
(compare "ab" "abc")
(compare "" "a")
(compare "A" "a")
(compare "a" "A")
(compare "Z" "a")
(compare "é" "f")
(compare "😀" "\uffff")
(compare "\uffff" "😀")
(compare "a" nil)
(compare nil "a")
(compare "a" :a)
(sort ["banana" "Apple" "cherry" "apple" ""])
(sort ["b" "a" "B" "A" "é" "e" "z" "Z"])
(sort-by count ["ccc" "a" "bb" "" "dd"])
(sort-by str/lower-case ["b" "A" "a" "B"])
(sort ["😀" "\uffff" "a"])
(sort ["10" "9" "100" "1"])
(sort compare ["x" "y" "a"])
(.compareTo "abc" "abd")
(= "abc" "abc")
(= "abc" (str "ab" "c"))
(identical? "abc" (str "ab" "c"))
(= "abc" 'abc)
(= "a" \a)
(max-key count "a" "bbb" "cc")


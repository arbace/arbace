;; ----- seq functions on strings
(map identity "abc")
(filter #(Character/isDigit (char %)) "a1b2")
(apply str (filter #(Character/isDigit (char %)) "a1b2"))
(frequencies "hello")
(group-by #(Character/isUpperCase (char %)) "aBcD")
(partition 2 "abcde")
(into [] "xyz")
(into #{} "aab")
(set "hello")
(reduce str "abc")
(distinct "aabbc")
(take 2 "hello")
(drop 3 "hello")
(interleave "abc" "123")
(mapcat str "ab" "12")
(keep-indexed #(when (even? %1) %2) "abcdef")
(seq (str/split "x y z" #" "))
(str/join (map str/upper-case ["a" "b"]))
(str/join "," (sort (set "banana")))
(string? "")
(string? \a)
(string? nil)
(string? (StringBuilder.))
(vec (char-array "abc"))
(seq (char-array "ab"))
(= (seq "ab") [\a \b])
(= "ab" [\a \b])
(= "ab" (seq "ab"))

;; ----- arbace.string: join and split
(str/join ["a" "b" "c"])
(str/join ", " ["a" "b" "c"])
(str/join ", " [])
(str/join ", " [nil 1 "x" :k])
(str/join \- [1 2])
(str/join "" "abc")
(str/join "/" (range 4))
(str/split "a,b,c" #",")
(str/split "a,b,,c,," #",")
(str/split "a,b,,c,," #"," -1)
(str/split "a,b,c" #"," 2)
(str/split "" #",")
(str/split "abc" #"")
(str/split " a  b " #"\s+")
(str/split "a1b22c333" #"\d+")
(str/split "a😀b" #"")
(str/split "aXbXc" #"X" 0)
(str/split-lines "a\nb\r\nc\n")
(str/split-lines "")
(str/split-lines "\n\n")
(str/split-lines "one")

;; ----- replace
(str/replace "hello world" "o" "0")
(str/replace "hello" \l \L)
(str/replace "hello" #"l+" "L")
(str/replace "hello" #"(l)(o)" "$2$1")
(str/replace "a.b.c" "." "!")
(str/replace "a.b.c" #"." "!")
(str/replace "a$b" "$" "\\")
(str/replace "abc" #"b" "$0$0")
(str/replace "abc" #"b" (str/re-quote-replacement "$0"))
(str/replace "abc" #"x" "y")
(str/replace "hello" #"[aeiou]" str/upper-case)
(str/replace "a1b2" #"\d" (fn [d] (str (* 2 (parse-long d)))))
(str/replace "k=v;x=y" #"(\w)=(\w)" (fn [[_ k v]] (str v "=" k)))
(str/replace "" "" "x")
(str/replace "ab" "" "-")
(str/replace "😀😀" "😀" "x")
(str/replace "abc" #"b" "$1")
(str/replace "abc" #"b" "\\")
(str/replace "aaa" "aa" "b")
(str/replace-first "a-b-c" "-" "+")
(str/replace-first "a-b-c" #"-" "+")
(str/replace-first "a-b-c" \- \+)
(str/replace-first "abcabc" #"(b)(c)" "$2$1")
(str/replace-first "abc" #"b" str/upper-case)
(str/replace-first "abc" #"z" "y")
(str/replace "abc" 1 2)
(str/re-quote-replacement "$1\\x")


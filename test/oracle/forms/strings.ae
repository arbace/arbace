(require '[arbace.string :as str])

;; ----- str
(str)
(str nil)
(str "a" nil "b")
(str 1 2 3)
(str "a" \b 'c :d)
(str :a)
(str :a/b)
(str ::local)
(str 'sym)
(str 'ns/sym)
(str true false)
(str [1 2 "x"])

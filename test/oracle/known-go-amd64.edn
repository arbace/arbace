;; The known mismatches of an implementation in the oracle (doc/go/ORACLE.md):
;; bin/oracle check IMPL --expected FILE passes when the mismatching cases are
;; exactly these. Rewritten by bin/oracle check IMPL --write-expected FILE, which
;; keeps the reasons of the cases still mismatching; edit the reasons by hand.
{:impl "target/arbace-go/amd64/arbace -"
 :about "The Go build on amd64 (ARBACE_GO_ARCHES=amd64 bin/arbace-go --build), checked by bin/gate --full. Counts per reason in doc/go/EVAL-NOTES.md (phase 2B, results)."
 :mismatches
 [{:reason "The class forms at the REPL (doc/go/CLASSFORMS-REPL.md, What remains): Clojure's (Base.) of an abstract class made by defclass is the evaluator's reflective construction on Go, InstantiationException, where the JVM's compiled new gives InstantiationError"
   :cases
   [{:case "test/oracle/forms/defclass.clj:304" :form "(try (Base.) (catch Throwable e (class e)))"}]}

  {:reason "Part A's (EVAL-NOTES.md, phase 2): (deftype Foo/2 [a])'s error comes from import's macro on Go, from deftype*'s analysis on the JVM; types at run time (part 1)"
   :cases
   [{:case "test/oracle/forms/harvest/array_symbols.clj:49" :form "(eval (quote (deftype Foo/2 [a])))"}]}

  {:reason "Not reproducible, as decided for #object printing (EVAL-NOTES.md, phase 2B): the JVM recorded HotSpot's identity hash of a StringBuilder, a per-thread xorshift sequence"
   :cases
   [{:case "test/oracle/forms/strings.clj:408" :form "(hash (StringBuilder. \"x\"))"}]}

  {:reason "The JVM's recorded bug (C2G-NOTES.md, Found on the way): arbace/classes/emit.clj's emit-cond picks dcmpg/dcmpl before negating the comparison, so the JVM Arbace's result for NaN is wrong; Go's is right"
   :cases
   [{:case "test/oracle/classes/UtilRT.clj:345" :form "^{:sig [Object Object]} (Util/equiv ##NaN ##NaN)"}]}

  {:reason "Cut by B1-PLAN's D6 (ORACLE.md, Exclusions): Java serialization (java.io.ObjectOutputStream) is not in the Go build; the proxy itself works (amendment Y4)"
   :cases
   [{:case "test/oracle/forms/harvest/java_interop.clj:14" :form "(-> (java.io.ByteArrayOutputStream.) (java.io.ObjectOutputStream.) (.writeObject (proxy [Object java.io.Serializable] [])))"}]}]}

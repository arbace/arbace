;; j2g's fixtures (see FxCode.ae): checked casts to array types and instanceof of array types
;; (J2G-SPEC §5.7, §5.9; doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JFS65 (b)"), each a case
;; of the type switch j2g writes for them: a primitive array by its Go type, a reference array by
;; its component class (equal, or Object[]), else Class.isInstance (covariance: a String[] is a
;; CharSequence[], an int[][] an Object[]); a failed cast's ClassCastException with the JVM's
;; message, nil cast to any array type.

(in-ns 'j2g.fixtures)

(do

(defclass ^:public FxArrElem)

(defclass ^:public FxArrSub :extends FxArrElem)

(defclass ^:public FxArrays
  (method ^:static msg ^String [^Object o ^String what]
    ;; the cast of o to the array type named by what, or the ClassCastException's message
    (try
      (cond
        (.equals what "Z") (java-str "Z" (alength (cast boolean/1 o)))
        (.equals what "B") (java-str "B" (alength (cast byte/1 o)))
        (.equals what "C") (java-str "C" (alength (cast char/1 o)))
        (.equals what "S") (java-str "S" (alength (cast short/1 o)))
        (.equals what "I") (java-str "I" (alength (cast int/1 o)))
        (.equals what "J") (java-str "J" (alength (cast long/1 o)))
        (.equals what "F") (java-str "F" (alength (cast float/1 o)))
        (.equals what "D") (java-str "D" (alength (cast double/1 o)))
        (.equals what "O") (java-str "O" (alength (cast Object/1 o)))
        (.equals what "OO") (java-str "OO" (alength (cast Object/2 o)))
        (.equals what "Str") (java-str "Str" (alength (cast String/1 o)))
        (.equals what "CS") (java-str "CS" (alength (cast CharSequence/1 o)))
        (.equals what "Cmp") (java-str "Cmp" (alength (cast Comparable/1 o)))
        (.equals what "Num") (java-str "Num" (alength (cast Number/1 o)))
        (.equals what "Int") (java-str "Int" (alength (cast Integer/1 o)))
        (.equals what "II") (java-str "II" (alength (cast int/2 o)))
        (.equals what "JJ") (java-str "JJ" (alength (cast long/2 o)))
        (.equals what "StrStr") (java-str "StrStr" (alength (cast String/2 o)))
        (.equals what "CSCS") (java-str "CSCS" (alength (cast CharSequence/2 o)))
        (.equals what "Elem") (java-str "Elem" (alength (cast FxArrElem/1 o)))
        (.equals what "Sub") (java-str "Sub" (alength (cast FxArrSub/1 o)))
        :else "?")
      ;; the message whole but for a fixture class's loader, which the JVM recording names as its
      ;; DynamicClassLoader (@ its hash) and the Go build as 'app'
      (catch ClassCastException e
        (let [^String m (.getMessage e)]
          (java-str "CCE " (if (.contains m "j2g.fixtures") (.substring m 0 (.indexOf m " (")) m))))))

  (method ^:static values ^Object/1 []
    (new Object/1 [(new boolean/1 1) (new byte/1 2) (new char/1 3) (new short/1 4) (new int/1 5)
                   (new long/1 6) (new float/1 7) (new double/1 8) (new Object/1 9) (new String/1 10)
                   (new Integer/1 11) (new Number/1 12) (new int/2 13) (new String/2 14)
                   (new FxArrSub/1 15) (new FxArrElem/1 16) "str" (Integer/valueOf 1)]))

  (method ^:public ^:static tCastPrimitive ^String []
    (let [sb (StringBuilder.) vs (FxArrays/values)]
      (for-each [^String w (new String/1 ["Z" "B" "C" "S" "I" "J" "F" "D"])]
        (for-each [^Object o vs]
          (.append sb (java-str (FxArrays/msg o w) ";")))
        (.append sb "\n"))
      (.toString sb)))

  (method ^:public ^:static tCastReference ^String []
    (let [sb (StringBuilder.) vs (FxArrays/values)]
      (for-each [^String w (new String/1 ["O" "OO" "Str" "CS" "Cmp" "Num" "Int" "II" "JJ" "StrStr" "CSCS" "Elem" "Sub"])]
        (for-each [^Object o vs]
          (.append sb (java-str (FxArrays/msg o w) ";")))
        (.append sb "\n"))
      (.toString sb)))

  (method ^:public ^:static tCastNull ^String []
    (let [^Object o nil]
      (java-str (nil? (cast int/1 o)) (nil? (cast char/1 o)) (nil? (cast Object/1 o)) (nil? (cast String/1 o))
                (nil? (cast CharSequence/1 o)) (nil? (cast int/2 o)) (nil? (cast FxArrSub/1 o)))))

  (method ^:public ^:static tInstanceOf ^String []
    (let [sb (StringBuilder.)]
      (for-each [^Object o (FxArrays/values)]
        (.append sb (java-str (instance? boolean/1 o) (instance? byte/1 o) (instance? char/1 o) (instance? short/1 o)
                              (instance? int/1 o) (instance? long/1 o) (instance? float/1 o) (instance? double/1 o)
                              " " (instance? Object/1 o) (instance? Object/2 o) (instance? String/1 o)
                              (instance? CharSequence/1 o) (instance? Comparable/1 o) (instance? Number/1 o)
                              (instance? Integer/1 o) (instance? int/2 o) (instance? long/2 o) (instance? String/2 o)
                              (instance? CharSequence/2 o) (instance? FxArrElem/1 o) (instance? FxArrSub/1 o) ";")))
      (let [^Object n nil]
        (.append sb (java-str (instance? int/1 n) (instance? Object/1 n) (instance? String/1 n))))
      (.toString sb)))

  (method ^:public ^:static tCastUse ^String []
    ;; the cast's result used at its type: an element read, a store checked against the array's own
    ;; component class (a String[] seen as Object[] refuses an Integer)
    (let [^Object o (new String/1 ["a" "b"]) ^Object p (new int/1 [4 5 6])
          ^Object/1 os (cast Object/1 o)]
      (java-str (aget (cast String/1 o) 1) (aget (cast int/1 p) 2)
                (try (aset os 0 (Integer/valueOf 1)) "stored"
                     (catch ArrayStoreException e (java-str " ASE " (.getMessage e))))))))

)

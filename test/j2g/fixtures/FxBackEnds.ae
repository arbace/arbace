;; j2g's fixtures (see FxCode.ae): the back ends' findings of JC4c (doc/classes/JAVA-CONFORMANCE-SURVEY.md,
;; "As built: JC4c"), each reduced to a case the interpreter and j2g are compared on (bin/diffcheck): a
;; subclass of jrt's hand-written AtomicReference (JCS111), a lambda's bridge called through the other
;; interface and listed by reflection (JCS116), a class's own private method found and invoked by
;; reflection (JCS117), a lambda of an intersection cast to one of its interfaces, whose default method
;; it implements, and a lambda of an int method whose body throws (JCS118).

(in-ns 'j2g.fixtures)

(import '(java.util.concurrent.atomic AtomicReference))

(do

(defclass ^:public FxBNamed :extends AtomicReference
  (constructor ^:public [this ^Object v] (super. v))
  (method ^:public toString ^String [this] (java-str "Named(" (.get this) ")")))

(defclass ^:public ^:interface FxBK
  (method m ^void [this ^Object t]))

(defclass ^:public ^:interface FxBM
  (method m ^void [this ^String s]))

(defclass ^:public ^:interface FxBKM :extends [FxBK FxBM])

(defclass ^:public ^:interface FxBIA
  (method a ^void [this]))

(defclass ^:public ^:interface FxBIB
  (method b ^String [this]))

(defclass ^:public ^:interface FxBIAB :extends [FxBIA FxBIB]
  (method ^:default a ^void [this])
  (method ^:default b ^String [this] "B"))

(defclass ^:public ^:interface FxBIC
  (method c ^void [this]))

(defclass ^:public ^:interface FxBBar
  (method m ^int [this ^Integer i]))

(defclass ^:public FxBackEnds
  (method ^:private secret ^String [this ^int i] (java-str "secret" i))

  (method ^:public ^:static tAtomicSub ^String []
    (let [n (FxBNamed. "a")]
      (.set n "b")
      (java-str (.toString n) " " (.compareAndSet n "b" "c") " " (.get n))))

  (method ^:public ^:static tLambdaBridge ^String []
    (let [sb (StringBuilder.)
          ^FxBKM km (lambda FxBKM ^void [^String x] (.append sb x))
          ^FxBK k km]
      (.m k "k")
      (.m km "m")
      (java-str sb " " (alength (.getDeclaredMethods (.getClass km))))))

  (method ^:public ^:static tOwnPrivate ^String []
    (let [m (.getDeclaredMethod FxBackEnds "secret" (into-array Class [Integer/TYPE]))]
      (.setAccessible m true)
      (cast String (.invoke m (FxBackEnds.) (into-array Object [(Integer/valueOf 7)])))))

  (method ^:public ^:static tIntersection ^String []
    (let [^Object x (lambda (& FxBIA FxBIB FxBIAB FxBIC) ^void [])]
      (java-str (.b (cast FxBIAB x)) " " (instance? FxBIC x))))

  (method ^:public ^:static tThrowingLambda ^String []
    (let [^FxBBar bar (lambda FxBBar ^int [^Integer i] (throw (IllegalStateException. (java-str "thrown " i))))]
      (try (java-str "no " (.m bar (Integer/valueOf 3)))
           (catch IllegalStateException e (.getMessage e))))))

)

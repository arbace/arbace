;; j2g's fixtures (see FxCode.ae, FxJavac.ae): the two shapes of javac's Java forms that the Java
;; forms' analysis did not take (doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JN2"): an
;; anonymous class in a constructor's prologue reading its outer instance's field and a
;; constructor parameter (Attr.RecoveryInfo's check context), and a lambda whose return type, as
;; javac infers it, is the anonymous class its body creates (Types.DescriptorCache's
;; mergeDescriptors: ^FxJShapes$1).

(in-ns 'j2g.fixtures)

(import '(java.util Optional)
        '(java.util.function Function))

(do

(defclass ^:public FxJShapes
  (field ^String tag "attr")

  (defclass ^:public Info
    (field ^Object context)
    (constructor [this ^Object context] (set! (.-context this) context)))

  (defclass ^:public RecoveryInfo :extends Info
    (constructor ^:public [this ^:final ^String pt]
      (super. (anon Object []
                (method ^:public toString ^String [this] (java-str tag "/" pt))))))

  (method ^:public ^:static tPrologueAnon ^String []
    (let [o (FxJShapes.)]
      (.toString (.-context (.new o RecoveryInfo "pt")))))

  (method ^:public ^:static tLambdaAnonType ^String []
    (let [^{:tag (Optional String)} name (Optional/of "best")]
      (.toString
        (cast Object
              (.orElse (.map name
                             (lambda Function ^FxJShapes$1 [^String best]
                               (anon Object []
                                 (method ^:public toString ^String [this] (java-str "descriptor of " best)))))
                       nil))))))

)

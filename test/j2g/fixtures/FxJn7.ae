;; j2g's fixtures (see FxCode.ae): the shapes java.xml's SAX parser showed j2g in the world of
;; javac's tool build (doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JN7"), each a regression case
;; of a fix: a class reading a static field of its superinterface that is not a constant
;; (xerces' NamespaceSupport reading NamespaceContext's XML_URI, "...".intern()): the read
;; initializes the interface, which the class's own initialization does not (JLS 12.4.1). The fixes
;; for values of classes outside the closed world (a call on such a receiver, such a value passed
;; as an interface of the world) have no case here: the interpreted half cannot name such a class
;; (javac's world, bin/javac-vendor check and the tool build, is their test).

(in-ns 'j2g.fixtures)

(do

(defclass ^:public ^:interface FxJ7Context
  (field ^:public ^:static ^:final ^String URI (.intern (String. "fx-jn7-uri"))))

(defclass ^:public FxJ7Support :implements [FxJ7Context]
  (method ^:public uri ^String [this] FxJ7Context/URI))

(defclass ^:public FxJn7
  (method ^:public ^:static tIfaceStaticInit ^String []
    (let [s (FxJ7Support.)]
      (java-str (.uri s) " " (identical? (.uri s) (.intern (String. "fx-jn7-uri")))))))

)

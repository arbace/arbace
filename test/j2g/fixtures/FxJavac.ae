;; j2g's fixtures (see FxCode.ae): the shapes javac's own Java forms showed j2g first
;; (doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JN2"), each a regression case of a fix: a
;; bound method reference to a private method of an abstract class (Operators.OperatorHelper's
;; this::initOperators), Object.wait(long) on an Object-typed receiver (BaseFileManager), a call
;; of Throwable.printStackTrace(PrintWriter) and (PrintStream) (javac's crash reports),
;; Runtime.version() (SourceVersion), a lambda's last temporary (Resolve's recovery lambdas) and
;; a member read through an outer instance whose class is reached by an interface type
;; (Resolve.MethodReferenceLookupHelper's anonymous helper). The cast of an instanceof pattern to
;; a class outside the closed world has no case here: the interpreted half cannot name such a
;; class (javac's world, bin/javac-vendor check, is its test).

(in-ns 'j2g.fixtures)

(import '(java.io ByteArrayOutputStream PrintStream PrintWriter StringWriter)
        '(java.util.function Supplier))

(do

(defclass ^:public ^:abstract FxJHelper
  (field ^String name)
  (constructor [this ^String name] (set! (.-name this) name))
  (method ^:private parts ^String [this] (java-str "parts of " name))
  (method ^:public get ^String [this]
    (cast String (.get (method-ref Supplier ^String [] this FxJHelper/.parts)))))

(defclass ^:public FxJHelperImpl :extends FxJHelper
  (constructor [this] (super. "impl")))

(defclass ^:public ^:interface FxJRecovery
  (method ^:abstract load ^FxJResolve$LookupBase [this ^String env ^String name]))

(defclass ^:public FxJResolve
  (field ^String notFound "not found")
  (defclass ^:public LookupBase
    (method ^:public lookup ^String [this ^String n] (java-str "base " n)))
  (defclass ^:public Helper :extends LookupBase
    (method ^:public unbound ^FxJResolve$LookupBase [this]
      (anon LookupBase []
        (method ^:public lookup ^String [this ^String n] (java-str notFound " " n)))))
  (defclass ^:public SubHelper :extends Helper)
  (method ^:public recovery ^FxJRecovery [this ^boolean star]
    (lambda FxJRecovery ^FxJResolve$LookupBase [^String env ^String name]
      (let [^String scope (if star "star" "module")
            ^:mutable ^String existing (.concat scope name)]
        (when (.isEmpty name) (return (.new this LookupBase)))
        (when (.startsWith existing "star")
          (try
            (set! existing (.concat existing "!"))
            (return (.new this Helper))
            (catch IllegalStateException e)))
        nil)))

  (method ^:public ^:static tPrivateMethodRef ^String []
    (.get (FxJHelperImpl.)))
  (method ^:public ^:static tWaitLong ^String []
    (let [^Object o (Object.)
          t0 (System/currentTimeMillis)]
      (locking o (.wait o 2))
      (java-str "waited " (>= (unchecked-subtract (System/currentTimeMillis) t0) 0))))
  (method ^:public ^:static tPrintStackTrace ^String []
    (let [sw (StringWriter.)
          pw (PrintWriter. sw)
          bs (ByteArrayOutputStream.)
          ps (PrintStream. bs true)]
      (.printStackTrace (IllegalStateException. "jn2 writer") pw)
      (.flush pw)
      (.printStackTrace (UnsupportedOperationException. "jn2 stream") ps)
      (let [w (.toString sw) s (.toString bs)]
        (java-str (.substring w 0 (.indexOf w "\n")) " | " (.substring s 0 (.indexOf s "\n"))))))
  (method ^:public ^:static tRuntimeVersion ^String []
    (let [v (Runtime/version)]
      (java-str (.feature v) " " (>= (.compareTo v v) 0))))
  (method ^:public ^:static tLambdaTemp ^String []
    (let [r (FxJResolve.)
          show (fn [x] (if (nil? x) "nil" (.lookup ^FxJResolve$LookupBase x "q")))]
      (java-str (.invoke show (.load (.recovery r true) "e" "x")) " " (.invoke show (.load (.recovery r false) "e" ""))
                " " (.invoke show (.load (.recovery r false) "e" "y")))))
  (method ^:public ^:static tOuterThroughInterface ^String []
    (let [r (FxJResolve.)
          ^FxJResolve$Helper h (.new r SubHelper)]
      (java-str (.lookup h "a") " " (.lookup (.unbound h) "b")))))

)

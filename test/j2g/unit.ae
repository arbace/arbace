(ns j2g.unit
  "j2g's unit tests (doc/go/J2G-SPEC.md), each over a fixture of test/j2g/unit/ or a function alone,
  with the edge (jdk/edge.edn) as j2g binds it and no JDK forms: light (seconds, well under a GiB).
  Run: bin/j2g-unit (arbace_tool -p test -m j2g.unit); prints each test's name and pass or FAIL,
  exits 1 on a failure."
  (:require [arbace.string :as str]
            [arbace.java.io :as io]
            [arbace.classes.env :as env]
            [arbace.classes.analyze :as a]
            [arbace.classes.annot :as annot]
            [arbace.j2g.access :as access]
            [arbace.j2g.checks :as chk]
            [arbace.j2g.code :as code]
            [arbace.j2g.decls :as decls]
            [arbace.j2g.dyn :as dyn]
            [arbace.j2g.dyncf :as dyncf]
            [arbace.j2g.edge :as edge]
            [arbace.j2g.embed :as embed]
            [arbace.j2g.main :as jm]
            [arbace.j2g.meta :as meta]
            [arbace.j2g.model :as m]
            [arbace.j2g.names :as nm]
            [arbace.j2g.out :as out]
            [arbace.j2g.start :as start]
            [arbace.j2g.outside :as outside]
            [arbace.j2g.world :as w]
            [j2g.typeann :as ta]
            [j2g.rank :as rank]))

(def ^:private failures (atom 0))

(defn- check [what ok & [detail]]
  (println (str (if ok "pass  " "FAIL  ") what (when (and (not ok) detail) (str "\n      " detail))))
  (when-not ok (swap! failures inc)))

(defn- load-fixture
  "j2g's world over the fixture tree dir alone (load-world as bin/j2g binds it: the edge, no
  source lookup)."
  [dir]
  (#'jm/advance-ids!)
  (let [e (edge/read-edge "jdk/edge.edn")]
    (binding [m/*run* true env/*declared* (:classes e) edge/*edge* e a/*source-lookup* false]
      (w/load-world [{:root dir :tree true}] :variant-files []))))

;; JCS69 (b): the analysis fails at the unresolved class itself, not at the conversion after it

(defn test-unresolved-cause []
  (let [causes {"p/C$D" "members: Unknown type: X (the import q.X)"}]
    (check "unresolved-cause: a constructor of the class named"
           (= (w/unresolved-cause causes "analysis: No accessible constructor of p.C$D (line 4) / No accessible constructor of p.C$D")
              "analysis: No accessible constructor of p.C$D (line 4) / No accessible constructor of p.C$D (because p/C$D: members: Unknown type: X (the import q.X))"))
    (check "unresolved-cause: a static field, by the internal name"
           (= (w/unresolved-cause causes "analysis: No static field f in p/C$D (line 2)")
              "analysis: No static field f in p/C$D (line 2) (because p/C$D: members: Unknown type: X (the import q.X))"))
    (check "unresolved-cause: a longer name is not the class (p.C$DE)"
           (= (w/unresolved-cause causes "analysis: No accessible constructor of p.C$DE")
              "analysis: No accessible constructor of p.C$DE"))
    (check "unresolved-cause: not an analysis failure"
           (= (w/unresolved-cause causes "members: No accessible constructor of p.C$D")
              "members: No accessible constructor of p.C$D"))
    (check "unresolved-cause: no causes"
           (= (w/unresolved-cause {} "analysis: x") "analysis: x"))))

(defn test-unresolved-world []
  (let [world (load-fixture "test/j2g/unit/unresolved")
        failed (:failed world)
        of (fn [n] (vec (for [[c msg] failed :when (= c n)] msg)))
        st (fn [n] (w/with-world world @(:state (a/decl n))))]
    (check "unresolved: Holder's failure is its members', the class named with its import"
           (= (of "p/Holder") ["members: Unknown type: Gadget (the import javax.nonesuch.Gadget)"])
           (pr-str (of "p/Holder")))
    (check "unresolved: Holder not analyzed, marked failed with that cause"
           (let [s (st "p/Holder")] (and (:analyzed s) (= (:analysis-failed s) "members: Unknown type: Gadget")))
           (pr-str (select-keys (st "p/Holder") [:analyzed :analysis-failed])))
    (check "unresolved: User's failure names Holder's cause"
           (let [[m & more] (of "p/User")]
             (and (nil? more) (str/starts-with? m "analysis: No accessible constructor of p.Holder")
                  (str/ends-with? m "(because p/Holder: members: Unknown type: Gadget (the import javax.nonesuch.Gadget))")))
           (pr-str (of "p/User")))
    (check "unresolved: Clean analyzed, no failure"
           (and (empty? (of "p/Clean")) (:analyzed (st "p/Clean")) (nil? (:analysis-failed (st "p/Clean"))))
           (pr-str (of "p/Clean")))
    (check "unresolved: no empty conversion message (\"Cannot convert ... to \")"
           (not-any? (fn [[_ msg]] (re-find #"Cannot convert .* to\s*$" (str msg))) failed)
           (pr-str failed))))

(defn test-analyze-only
  "JCS265 (b): bin/j2g --analyze-only over the fixture, its report.edn the load's failures alone."
  []
  (let [out (str (or (System/getenv "TMPDIR") ".tmp/tmp") "/j2g-unit-analyze-only")
        f (io/file out "report.edn")
        _ (io/delete-file f true)
        e (edge/read-edge "jdk/edge.edn")
        ret (binding [m/*run* true env/*declared* (:classes e) edge/*edge* e a/*source-lookup* false]
              (jm/run* {:analyze-only true :jdk "test/j2g/unit/unresolved" :variant-files [] :inputs []
                        :slice [] :roots [] :out out}))
        r (when (.isFile f) (read-string (slurp f)))
        failed (into {} (map vec (:analysis-failures r)))]
    (check "analyze-only: report.edn written, marked :analyze-only" (true? (:analyze-only r)) (pr-str (keys r)))
    (check "analyze-only: no :errors (the status is 0)" (empty? (:errors ret)) (pr-str (:errors ret)))
    (check "analyze-only: Holder's members failure and User's named cause"
           (and (= (get failed "p/Holder") "members: Unknown type: Gadget (the import javax.nonesuch.Gadget)")
                (str/ends-with? (str (get failed "p/User")) "(because p/Holder: members: Unknown type: Gadget (the import javax.nonesuch.Gadget))"))
           (pr-str (:analysis-failures r)))
    (check "analyze-only: nothing translated (no gen/ nor prog/)"
           (not (or (.exists (io/file out "gen")) (.exists (io/file out "prog")))))
    (check "analyze-only: the classes analyzed counted (Clean, Holder, User)" (= 3 (:classes r)) (pr-str (:classes r)))))

(defn test-support-tables
  "JCS271 (b), JCS273: the jrt methods j2g writes and the roots they need, by J2G-SPEC §4.4's names."
  []
  (check "type annotations: 11 methods (Class 2, Field 1, Method and Constructor 4 each)"
         (= 11 (count out/type-annotation-methods)) (pr-str out/type-annotation-methods))
  (check "type annotations: Go names as J2G-SPEC §4.4 gives them"
         (every? (set out/type-annotation-methods)
                 [["Class" "GetAnnotatedSuperclass__AnnotatedType"] ["Class" "GetAnnotatedInterfaces__AnnotatedType1"]
                  ["Field" "GetAnnotatedType__AnnotatedType"] ["Method" "GetAnnotatedParameterTypes__AnnotatedType1"]
                  ["Constructor" "GetAnnotatedReceiverType__AnnotatedType"]])
         (pr-str out/type-annotation-methods))
  (check "type annotations: 7 roots, TypeAnnotationSupport's"
         (and (= 7 (count out/type-annotation-roots))
              (every? #(= "jdk/internal/jrt/TypeAnnotationSupport" (first %)) out/type-annotation-roots)
              (some #{["jdk/internal/jrt/TypeAnnotationSupport" "annotatedParameterTypes"
                       "(Ljava/lang/reflect/Executable;)[Ljava/lang/reflect/AnnotatedType;"]} out/type-annotation-roots))
         (pr-str out/type-annotation-roots))
  (check "accessFlags: AccessFlagSupport's three roots"
         (= 3 (count out/access-flags-roots)) (pr-str out/access-flags-roots)))

(defn test-throws
  "JCS240 (a) (F27): a class's throws clauses are its data's E records with :throws alone, a JDK class's too (j2g's
  class-data call), and none without; with :members they are written once."
  []
  (let [e (edge/read-edge "jdk/edge.edn")
        ;; load-fixture's binding without its advance-ids! (the counter advances once a run: test-unresolved-world's)
        world (binding [m/*run* true env/*declared* (:classes e) edge/*edge* e a/*source-lookup* false]
                (w/load-world [{:root "test/j2g/unit/throws" :tree true}] :variant-files []))
        data (fn [n & opts] (w/with-world world (some-> (apply annot/class-data n opts) str/split-lines set)))
        es (fn [ls] (set (filter #(str/starts-with? % "E ") ls)))]
    (check "throws: an interface's method, :throws alone"
           (= #{"E M ping ()V java.lang.Exception"} (es (data "q/Pinger" :throws true))) (pr-str (data "q/Pinger" :throws true)))
    (check "throws: a constructor's and a method's, none for a method without"
           (= #{"E C ()V java.lang.InterruptedException" "E M ping ()V java.lang.Exception"} (es (data "q/Impl" :throws true)))
           (pr-str (data "q/Impl" :throws true)))
    (check "throws: none without :throws or :members"
           (empty? (es (data "q/Impl"))) (pr-str (data "q/Impl")))
    (check "throws: with :members and :throws, each record once"
           (let [ls (w/with-world world (str/split-lines (annot/class-data "q/Impl" :members true :throws true)))]
             (= 2 (count (filter #(str/starts-with? % "E ") ls))))
           (pr-str (data "q/Impl" :members true :throws true)))))

(defn test-mxbean-signatures
  "n-j2g-mxsig (doc/classes/JAVA-DEFERRED-TRIAGE.md, \"As built: n-j2g-mxsig\"): an MXBean interface of the world (its
  name ends in MXBean, or @MXBean) has its members' Signatures (G records) with :signatures alone, j2g's class-data call
  for a JDK class, so that JMX's introspection sees getArgs's List<String>; an interface that is not one (Plain, or
  @MXBean(false)) and a class named ...MXBean are not MXBean interfaces, and without :signatures or :members no G record."
  []
  (let [e (edge/read-edge "jdk/edge.edn")
        ;; load-fixture's binding without its advance-ids! (as test-throws)
        world (binding [m/*run* true env/*declared* (:classes e) edge/*edge* e a/*source-lookup* false]
                (w/load-world [{:root "test/j2g/unit/mxsig" :tree true}] :variant-files []))
        mx? (fn [n] (w/with-world world (annot/mxbean-interface? n (a/decl n))))
        data (fn [n & opts] (w/with-world world (some-> (apply annot/class-data n opts) str/split-lines set)))
        gs (fn [ls] (set (filter #(str/starts-with? % "G ") ls)))
        ;; j2g's call: the G records when the class is an MXBean interface
        j2g (fn [n] (gs (data n :throws true :signatures (mx? n))))
        ;; n-java-f13: j2g's call since, the MXBean interfaces and the CompositeDataViews
        mapped? (fn [n] (w/with-world world (annot/mxbean-mapped? n (a/decl n))))
        j2g-mapped (fn [n] (gs (data n :throws true :signatures (mapped? n))))]
    (check "mxsig: the fixture analyzes" (empty? (filter (comp #{"q/FooMXBean" "q/Tagged" "q/Plain" "q/Info"} first) (:failed world)))
           (pr-str (:failed world)))
    (check "mxsig: FooMXBean's generic getters, not its plain one"
           (= #{"G M getArgs ()Lq.Box; ()Lq/Box<Ljava/lang/String;>;"
                "G M getProps ()Lq.Box; ()Lq/Box<Lq/Box<Ljava/lang/String;>;>;"}
              (j2g "q/FooMXBean"))
           (pr-str (j2g "q/FooMXBean")))
    (check "mxsig: @MXBean's Tagged, its name not ending in MXBean"
           (= #{"G M getNames ()Lq.Box; ()Lq/Box<Ljava/lang/String;>;"} (j2g "q/Tagged")) (pr-str (j2g "q/Tagged")))
    (check "mxsig: rule: a name ending in MXBean, @MXBean, not Plain, not @MXBean(false), not a class"
           (and (mx? "q/FooMXBean") (mx? "q/Tagged") (not (mx? "q/Plain")) (not (mx? "q/OptedOutMXBean"))
                (not (mx? "q/ImplMXBean")))
           (pr-str (map (juxt identity mx?) ["q/FooMXBean" "q/Tagged" "q/Plain" "q/OptedOutMXBean" "q/ImplMXBean"])))
    (check "mxsig: negative: Plain, OptedOutMXBean and the class ImplMXBean get no G record from j2g's call"
           (every? empty? (map j2g ["q/Plain" "q/OptedOutMXBean" "q/ImplMXBean"]))
           (pr-str (map j2g ["q/Plain" "q/OptedOutMXBean" "q/ImplMXBean"])))
    (check "mxsig: control: Plain's Signature exists, :signatures forced writes it (the rule leaves it out)"
           (= #{"G M getArgs ()Lq.Box; ()Lq/Box<Ljava/lang/String;>;"} (gs (data "q/Plain" :signatures true)))
           (pr-str (data "q/Plain" :signatures true)))
    (check "mxsig: none without :signatures or :members"
           (empty? (gs (data "q/FooMXBean" :throws true))) (pr-str (data "q/FooMXBean" :throws true)))
    (check "mxsig: with :members and :signatures, each record once"
           (let [ls (w/with-world world (str/split-lines (annot/class-data "q/FooMXBean" :members true :signatures true)))]
             (= 2 (count (filter #(str/starts-with? % "G ") ls))))
           (pr-str (data "q/FooMXBean" :members true :signatures true)))
    (check "mxsig: a CompositeDataView (Info, GcInfo's kind) is mapped, its generic getter's record, not its plain one"
           (and (mapped? "q/Info") (not (mx? "q/Info"))
                (= #{"G M getUsages ()Lq.Box; ()Lq/Box<Ljava/lang/String;>;"} (j2g-mapped "q/Info")))
           (pr-str [(mapped? "q/Info") (j2g-mapped "q/Info")]))
    (check "mxsig: mapped keeps the MXBean interfaces' rule: FooMXBean and Tagged mapped, Plain, OptedOutMXBean and ImplMXBean not"
           (and (mapped? "q/FooMXBean") (mapped? "q/Tagged") (not-any? mapped? ["q/Plain" "q/OptedOutMXBean" "q/ImplMXBean"])
                (= (j2g "q/FooMXBean") (j2g-mapped "q/FooMXBean")))
           (pr-str (map (juxt identity mapped?) ["q/FooMXBean" "q/Tagged" "q/Plain" "q/OptedOutMXBean" "q/ImplMXBean"])))))

(def ^:private typeann-known
  "JCS282 (b): javac's rows the encoder writes otherwise, each with why (the check holds both sides to these)."
  {["p/TA" ["T"] ["0x10" [65535] [[3 0]] ["Lp/B;" [["e" ["e" "Ljava/lang/annotation/ElementType;" "METHOD"]]]]]]
   "an element value of java.lang.annotation.ElementType encodes as a string where the world does not know the enum (the
   edge alone: no JDK forms in the unit tests' world, JCS271 (b)'s day finding); the sample's own enum (Color) encodes as
   javac's e"})

(defn test-type-annotations
  "JCS282 (b) (doc/classes/JAVA-DEFERRED-TRIAGE.md, \"As built: JCS282 (b)\"): the encoder's RuntimeVisibleTypeAnnotations
  records (arbace.classes.annot's Y and N lines) of the sample test/j2g/unit/typeann/p/TA.java (its committed forms), decoded
  and resolved through their pool (j2g.typeann), equal javac's as recorded by hand with the JDK (test/j2g/unit/typeann.edn),
  but the known rows; and the check's negative control, one value changed, differs."
  []
  (let [ours (ta/sorted-set-of (ta/encoder "test/j2g/unit/typeann/p/TA.ae"))
        javac (with-open [r (java.io.PushbackReader. (io/reader "test/j2g/unit/typeann.edn"))] (read r))
        known (set (keys typeann-known))
        missing (remove (set ours) (remove known javac))
        extra (remove (set javac) ours)
        ;; a known row's place: its class, owner, target, path and annotation type (the value is what differs)
        place (fn [[c o [tt info path [ty]]]] [c o tt info path ty])
        extra (remove (fn [row] (some #(= (place %) (place row)) known)) extra)]
    (check (str "type annotations: the encoder's " (count ours) " equal javac's " (count javac) " but " (count known) " known")
           (and (= 29 (count javac)) (empty? missing) (empty? extra))
           (str "javac's not written: " (pr-str (vec missing)) " written, not javac's: " (pr-str (vec extra))))
    (check "type annotations: the known rows are javac's and still differ"
           (and (every? (set javac) known) (not-any? (set ours) known)))
    ;; the negative control: a row with its first int constant changed is not javac's
    (let [bump (fn bump [x] (cond (and (vector? x) (= "I" (first x)) (integer? (second x))) ["I" (inc (second x))]
                                  (vector? x) (mapv bump x)
                                  :else x))
          changed (bump (first ours))]
      (check "type annotations: control: a changed value differs"
             (and (not= changed (first ours)) (not (some #{changed} javac)))))))

(defn- nodes-of
  "Every node (a map with :op) under x."
  [x]
  (filter #(and (map? %) (:op %)) (tree-seq coll? seq x)))

(defn test-invokers
  "F15: in a world with jdk.internal.jrt.Invokers (the fixture test/j2g/unit/invoke, beside the edge's
  java.lang.invoke), the analyzer writes (int) mh.invokeExact(1, \"a\") as Invokers.invokeExactI(mh, int.class,
  {int.class, String.class}, {1, \"a\"}), (String) mh.invoke(x) as invokeL cast to String, a statement's call
  as invokeExactV, MethodHandles.lookup() as Invokers.lookup(U.class); the control: MethodHandle.type() stays a
  virtual call of MethodHandle."
  []
  (if-not (resolve 'arbace.classes.analyze/invokers-call)
    ;; a host whose analysis predates F15 (stage 0 until a re-seed): the gate's build at the checkout's key has it, or
    ;; J2G_UNIT_SOURCES=arbace.classes.analyze
    (println "skip  invokers: the host's arbace.classes.analyze predates F15 (J2G_UNIT_SOURCES=arbace.classes.analyze)")
  (let [e (edge/read-edge "jdk/edge.edn")
        ;; load-fixture's binding without its advance-ids! (as test-throws)
        world (binding [m/*run* true env/*declared* (:classes e) edge/*edge* e a/*source-lookup* false]
                (w/load-world [{:root "test/j2g/unit/invoke" :tree true}] :variant-files []))
        bodies (w/with-world world (:bodies @(:state (a/decl "p/U"))))
        body (fn [nm] (some (fn [[[n _] b]] (when (= n nm) b)) bodies))
        calls (fn [nm] (filter #(= :invoke (:op %)) (nodes-of (body nm))))
        inv (fn [nm] (first (filter #(= "jdk/internal/jrt/Invokers" (:owner %)) (calls nm))))]
    (check "invokers: the fixture analyzes" (and (seq bodies) (not (contains? (into {} (:failed world)) "p/U")))
           (pr-str (:failed world)))
    (let [n (inv "poly")
          [_ r cs os] (:args n)]
      (check "invokers: (int) mh.invokeExact(1, \"a\") is Invokers.invokeExactI, the site's classes and the boxed arguments"
             (and (= "invokeExactI" (:name n)) (= :static (:kind n))
                  (= "(Ljava/lang/invoke/MethodHandle;Ljava/lang/Class;[Ljava/lang/Class;[Ljava/lang/Object;)I" (:desc n))
                  (= "I" (:class r)) (= ["I" "Ljava/lang/String;"] (mapv :class (:elems cs)))
                  (= 2 (count (:elems os))))
             (pr-str (select-keys n [:name :desc]))))
    (check "invokers: (String) mh.invoke(x) is invokeL, cast to String"
           (and (= "invokeL" (:name (inv "gen")))
                (some #(and (= :cast (:op %)) (= "Ljava/lang/String;" (:class %))) (nodes-of (body "gen")))))
    (check "invokers: a statement's mh.invokeExact() is invokeExactV" (= "invokeExactV" (:name (inv "stmt"))))
    (let [n (inv "lk")]
      (check "invokers: MethodHandles.lookup() is Invokers.lookup(U.class)"
             (and (= "lookup" (:name n)) (= "Lp/U;" (:class (first (:args n)))))
             (pr-str (select-keys n [:name :args]))))
    (check "invokers: control: MethodHandle.type() is MethodHandle's own call"
           (and (nil? (inv "plain")) (some #(and (= "java/lang/invoke/MethodHandle" (:owner %)) (= "type" (:name %))) (calls "plain")))))))

(defn test-lookup-call
  "F15 (doc/classes/JAVA-DEFERRED-TRIAGE.md, \"As built: F15 (java.lang.invoke)\"): the analyzer writes
  MethodHandles.lookup() as jdk.internal.jrt.Invokers.lookup(C.class); in a JDK class (C of the JDK's packages,
  pkg-of :jrt) j2g keeps it the nil of J2G-SPEC section 8.5 (the VarHandle idiom's static initializers unchanged), in
  a program's own class or Arbace's a real call; and MethodHandles.lookup() itself (a world without Invokers) is the
  nil as before. The control: a call of another Invokers method is not the lookup."
  []
  (let [lit (fn [c] {:op :class-lit :class (str "L" c ";") :type "Ljava/lang/Class;"})
        call (fn [owner name args] {:op :invoke :kind :static :owner owner :name name :args args})]
    (check "lookup-call: MethodHandles.lookup() is the nil"
           (code/lookup-call? (call "java/lang/invoke/MethodHandles" "lookup" [])))
    (check "lookup-call: Invokers.lookup(C.class) of a JDK class is the nil"
           (code/lookup-call? (call "jdk/internal/jrt/Invokers" "lookup" [(lit "java/util/concurrent/ConcurrentHashMap")])))
    (check "lookup-call: Invokers.lookup(C.class) of a test's class is a real call"
           (not (code/lookup-call? (call "jdk/internal/jrt/Invokers" "lookup" [(lit "t04746/Test7157574")]))))
    (check "lookup-call: Invokers.lookup(C.class) of Arbace's class is a real call"
           (not (code/lookup-call? (call "jdk/internal/jrt/Invokers" "lookup" [(lit "arbace/lang/KeywordInvokeSite")]))))
    (check "lookup-call: control: Invokers.invokeExactI is not the lookup"
           (not (code/lookup-call? (call "jdk/internal/jrt/Invokers" "invokeExactI" [(lit "java/lang/String")]))))))

;; JCS350 (a): a private method of an interpreted class in reflection (arbace.j2g.dyncf's setMethod native, the Go
;; the executable's interpreter runs): JVMS 5.4.6, a private method is selected as itself, so it takes no Dyn slot
;; and no method by key (where a subclass's private method of the same key would replace it), and its member table
;; entry calls its own implementation, not the receiver's class's of that key. The natives are Go forms in j2g's
;; source, checked as data (their run needs the executable, the night's: t07686)

(defn- source-forms [path]
  (with-open [r (java.io.PushbackReader. (io/reader path))]
    (binding [*read-eval* false]
      (doall (take-while #(not= % ::eof) (repeatedly #(read r false ::eof)))))))

(defn- native-form
  "The (list 'go/func (native-name NAME ...) ...) form of NAME in the forms of PATH (the name also as
  (symbol (native-name NAME ...)), dyn.ae's)."
  [path name]
  (let [named? (fn [n] (and (seq? n) (= 'native-name (first n)) (= name (second n))))]
    (some (fn [f] (when (and (seq? f) (= 'list (first f)) (= ''go/func (second f))
                             (let [n (nth f 2 nil)]
                               (or (named? n) (and (seq? n) (= 'symbol (first n)) (named? (second n))))))
                    f))
          (tree-seq coll? seq (source-forms path)))))

(defn- private-rule?
  "Whether a setMethod native's form selects a private method as itself: the slot and by-key stores guarded by
  the private flag, and the member entry's (set! f impl) under it."
  [form]
  (let [subs (tree-seq coll? seq form)
        priv? (fn [x] (some #(= 'jrt/AccPrivate %) (tree-seq coll? seq x)))]
    (boolean
      (and (some #(and (seq? %) (= 'when (first %)) (priv? (second %))
                       (some (fn [y] (= y '(aset (.-ByKey dc) key impl))) (tree-seq coll? seq %)))
                 subs)
           (some #(= % '(when (!= (bit-and flags jrt/AccPrivate) 0) (set! f impl))) subs)))))

(defn test-private-reflection []
  (let [cf (native-form "arbace/j2g/dyncf.ae" "setMethod")
        px (native-form "arbace/j2g/dyn.ae" "setMethod")]
    (check "private reflection: dyncf's setMethod native found" (some? cf))
    (check "private reflection: a private method is selected as itself (no slot, no by-key method, its own impl)"
           (private-rule? cf))
    (check "private reflection: control: a proxy's setMethod (dyn.ae, every method public) has no such rule"
           (and (some? px) (not (private-rule? px))))))

(defn test-inner-ctor-annotations
  "JCS351 (a): a constructor's annotation records (arbace.classes.annot's C and P lines) name javac's descriptor, the one
  jrt's Constructor has (an inner class's outer instance first), and its parameters' indices follow the leading implicit
  parameters as the JDK's getParameterAnnotations gives them (handleParameterNumberMismatch: a member class's one); the
  control, a static nested class's, is unshifted. The fixture test/j2g/unit/innerctor/r/Outer.java (its committed forms)."
  []
  (let [e (edge/read-edge "jdk/edge.edn")
        world (binding [m/*run* true env/*declared* (:classes e) edge/*edge* e a/*source-lookup* false]
                (w/load-world [{:root "test/j2g/unit/innerctor" :tree true}] :variant-files []))
        data (fn [n] (w/with-world world (some-> (annot/class-data n :members true) str/split-lines vec)))
        has (fn [ls re] (some #(re-find re %) ls))
        in (data "r/Outer$In")
        nested (data "r/Outer$Nested")]
    (check "inner ctor: an inner class's constructor annotations by javac's descriptor (the outer instance first)"
           (and (has in #"^C \(Lr[.]Outer;Ljava[.]lang[.]String;\)V ") (not (has in #"^C \(Ljava[.]lang[.]String;\)V ")))
           (pr-str in))
    (check "inner ctor: its parameter's annotation at index 1, after the outer instance"
           (and (has in #"^P <init> \(Lr[.]Outer;Ljava[.]lang[.]String;\)V 1 ") (not (has in #"^P <init> \S+ 0 ")))
           (pr-str in))
    (check "inner ctor: control: a static nested class's, its own descriptor, index 0"
           (and (has nested #"^C \(Ljava[.]lang[.]String;\)V ") (has nested #"^P <init> \(Ljava[.]lang[.]String;\)V 0 "))
           (pr-str nested))))
;; A4-A7 of the Ghidra case study's G1 plan (J2G-SPEC §4.1, "Roots from a program's metadata", "Refusals, stubbed
;; or dropped"; §10.3): the metadata's pure parts over the fixtures of test/programs/, and their negative controls

(defn test-program-meta []
  (let [P "test/programs/"
        specs [(str P "services/resources/a") (str P "services/resources/b") (str P "reflect-meta/resources/lib")]
        [_ data owners] (embed/user-resources specs #{})
        fns (into {} (for [[p f] data] [p #(slurp (io/file f))]))
        svcs (meta/services [["s.S" "w.M"]] fns)]
    ;; A5: the second jar's copy of a path the first holds is a root copy, its index listed
    (check "resources: the second jar's svc.Greeter is root 1's copy"
           (and (contains? data "META-INF/services/svc.Greeter")
                (contains? data "META-INF/arbace/roots/1/META-INF/services/svc.Greeter"))
           (pr-str (keys data)))
    (check "resources: the roots' index names root 1, the directory b"
           (= "1 b\n" (meta/roots-index-text (keys data) (embed/resource-dir-names specs)))
           (pr-str (meta/roots-index-text (keys data) (embed/resource-dir-names specs))))
    ;; GH4 (iii): the class path's entries by name, the owners of the plain paths
    (check "classpath: the entries' index lists every directory, in order"
           (= (meta/classpath-index-text (embed/resource-dir-names specs)) "0 a\n1 b\n2 lib\n")
           (pr-str (meta/classpath-index-text (embed/resource-dir-names specs))))
    (check "classpath: java.class.path is the names, joined"
           (= "a:b:lib" (meta/classpath-property (embed/resource-dir-names specs))))
    (check "classpath: svc.Greeter's plain path is directory a's, directory b's copy is a root copy, owners say so"
           (and (some #{[0 "META-INF/services/svc.Greeter"]} owners)
                (not-any? #(= [1 "META-INF/services/svc.Greeter"] %) owners)
                (not-any? #(re-find #"^META-INF/arbace/roots/" (second %)) owners)
                (every? #(<= 0 (first %) 2) owners))
           (pr-str (take 5 owners)))
    (check "classpath: control: lib's own path is lib's (2), no other directory's"
           (and (some #{[2 "rm/plugins.txt"]} owners) (not-any? #{[0 "rm/plugins.txt"] [1 "rm/plugins.txt"]} owners)))
    (check "classpath: the owners' text, sorted"
           (= (meta/owners-text [[1 "y"] [0 "z"] [0 "x"]]) "0 x\n0 z\n1 y\n"))
    (check "resources: a source two directories hold is an error"
           (try (embed/user-resources [(str P "hello-java/java") (str P "hello-java/java")] #{}) false
                (catch Exception _ true)))
    ;; A4: the registry, the world's first, the jars in order, the duplicate once, the comment dropped
    (check "services: the registry in the class path's order"
           (= (get svcs "svc.Greeter") [["svc.English" :classpath] ["svc.French" :classpath] ["svc.Missing" :classpath]])
           (pr-str svcs))
    (check "services: the world's provides first, kind module"
           (= (get svcs "s.S") [["w.M" :module]]))
    (check "services: the registry's text"
           (= (meta/services-text svcs)
              "module s.S w.M\nclasspath svc.Greeter svc.English\nclasspath svc.Greeter svc.French\nclasspath svc.Greeter svc.Missing\n")
           (pr-str (meta/services-text svcs)))
    (check "services: control: the jars' order reversed is another registry"
           (not= (get (meta/services [] (into {} (for [[p f] [["META-INF/services/svc.Greeter" (str P "services/resources/b/META-INF/services/svc.Greeter")]
                                                               ["META-INF/arbace/roots/1/META-INF/services/svc.Greeter" (str P "services/resources/a/META-INF/services/svc.Greeter")]]]
                                                   [p #(slurp f)])))
                      "svc.Greeter")
                 (get svcs "svc.Greeter")))
    ;; B2 (2026-11-15): the count is the file's lines, which bin/jrt provides writes from the world (two until
    ;; JMX-1, java.rmi and SASL joined it)
    (check "services: jdk/provides.txt is read, a provider a line"
           (= (count (remove #(or (str/blank? %) (str/starts-with? % "#")) (str/split-lines (slurp "jdk/provides.txt"))))
              (count (meta/read-provides "jdk/provides.txt"))))
    ;; A6: the reflect-config's roots, the conditional entry by its condition
    (let [md (meta/data-metadata-roots fns)]
      (check "metadata: reflect-config's roots"
             (= (vec md) [[nil ["rm.Plugin#<clinit>" "rm.Plugin#<init>" "rm.Plugin#run"]]
                          ["rm.Main" ["rm.Conditional#<clinit>" "rm.Conditional#<init>" "rm.Conditional"]]])
             (pr-str md))
      (check "metadata: no errors" (empty? (:errors (meta md))))
      (check "metadata: control: malformed JSON is an error, not roots"
             (let [bad (meta/data-metadata-roots {"META-INF/native-image/x/reflect-config.json" (constantly "[{\"name\": ")})]
               (and (empty? bad) (= 1 (count (:errors (meta bad))))))))
    ;; A7: the refusals sorted by their referrers
    (let [r (meta/refusals {"ui/Tool" "analysis: Unable to resolve class: java.awt.Robot"
                            "ui/Panel" "members: Unknown type: java.awt.datatransfer.Clipboard"}
                           {["ui/Main" "main" "([Ljava/lang/String;)V"] #{"class ui/Tool failed analysis"}
                            ["ui/Tool" "paint" "()I"] #{"class ui/Panel failed analysis"}})]
      (check "refusals: Tool stubbed (Main needs it), Panel dropped (only a refused class names it)"
             (and (= (map first (:stubbed r)) ["ui/Tool"]) (= (map first (:dropped r)) ["ui/Panel"]))
             (pr-str r))
      (check "refusals: control: with no referrer both are dropped"
             (= 2 (count (:dropped (meta/refusals {"ui/Tool" "x" "ui/Panel" "y"} {}))))))))

(defn test-reflective-sites
  "A6: meta/site-roots over analyzed call nodes (the shapes arbace.classes.analyze makes), and the control."
  []
  (let [inv (fn [owner nme target & args] {:op :invoke :owner owner :name nme :target target :args (vec args)})
        lit (fn [c] {:op :class-lit :class (str "L" c ";")})
        s (fn [v] {:op :const :type "Ljava/lang/String;" :val v})]
    (check "sites: Class.forName of a constant roots the class"
           (= [:rooted ["p.C#<clinit>"]] (meta/site-roots (inv "java/lang/Class" "forName" nil (s "p.C")))))
    (check "sites: C.class.getMethod(\"m\") roots C#m"
           (= [:rooted ["p.C#m"]] (meta/site-roots (inv "java/lang/Class" "getMethod" (lit "p/C") (s "m") nil))))
    (check "sites: getConstructor of a literal roots its constructors"
           (= [:rooted ["p.C#<init>"]] (meta/site-roots (inv "java/lang/Class" "getConstructor" (lit "p/C") nil))))
    (check "sites: control: a name not constant is listed, not rooted"
           (= :dynamic (first (meta/site-roots (inv "java/lang/Class" "forName" nil {:op :local :name 'x})))))))

(defn test-properties
  "A13: j2g --property K=V (program.edn :properties): the pairs parsed in order, a value keeping its =, set in
  the main package's main after arbace.version and before the host and the image; none, main unchanged."
  []
  (let [o (jm/parse-args ["--program" "--property" "java.awt.headless=true" "--property" "m=a=b c" "--property" "e="])
        pm @#'jm/program-main-forms
        main-of (fn [& a] (out/form-text (last (apply pm false a))))
        with (main-of "p.Main" ["-x"] (:properties o))
        sets (re-seq #"System_SetProperty_String_String__String \(jrt/Str \"([^\"]*)\"\) \(jrt/Str \"([^\"]*)\"\)" with)]
    (check "properties: parsed in order, the value after the first ="
           (= (:properties o) [["java.awt.headless" "true"] ["m" "a=b c"] ["e" ""]]) (pr-str (:properties o)))
    (check "properties: set after arbace.version, in order"
           (and (= (map rest sets) [["java.awt.headless" "true"] ["m" "a=b c"] ["e" ""]])
                (< (.indexOf ^String with "arbace.version") (.indexOf ^String with "java.awt.headless")))
           (pr-str (map rest sets)))
    (check "properties: before the host and the image"
           (< (.indexOf ^String with "\"e\")") (.indexOf ^String with "ProgramHost") (.indexOf ^String with "setupImage")))
    (check "properties: the REPL's main takes them too"
           (re-find #"\(jrt/Str \"k\"\) \(jrt/Str \"v\"\)" (main-of nil nil [["k" "v"]])))
    (check "properties: none, both mains as without the option"
           (and (= (main-of "p.Main" ["-x"] nil) (main-of "p.Main" ["-x"]))
                (= (main-of nil nil nil) (main-of))
                (not (re-find #"SetProperty.*SetProperty" (main-of)))))
    (check "properties: control: a pair without = is an error"
           (try (jm/parse-args ["--program" "--property" "noequals"]) false (catch Exception _ true)))))

;; B2 (2026-11-15): jrt's files for one architecture each (F9's nio_fs_linux_amd64.ae, _arm64.ae) declare the same
;; names; Go builds one of them, so j2g's duplicate check counts a name once per architecture

(defn test-arch-collisions []
  (let [scan (fn [& fs] {:files (into (sorted-map) (for [[f n] fs] [f {:consts #{n}}]))})
        names (fn [cs] (set (map :name cs)))]
    (check "collisions: one name in an amd64 and an arm64 file is no duplicate"
           (empty? (chk/collisions {} (scan ["x_amd64.ae" "sysStatx"] ["x_arm64.ae" "sysStatx"]))))
    (check "collisions: control: the same name in an amd64 file and a file of no architecture is"
           (= #{"sysStatx"} (names (chk/collisions {} (scan ["x_amd64.ae" "sysStatx"] ["x.ae" "sysStatx"])))))
    (check "collisions: control: two files of one architecture are"
           (= #{"sysStatx"} (names (chk/collisions {} (scan ["x_amd64.ae" "sysStatx"] ["y_amd64.ae" "sysStatx"])))))
    (check "collisions: control: a generated file beside an architecture's is"
           (= #{"sysStatx"} (names (chk/collisions {[:jrt "j2g_cut.go"] ['(go/const [sysStatx 1])]}
                                                    (scan ["x_amd64.ae" "sysStatx"])))))))

;; B2 (2026-11-15): an accessor of an inherited protected static (DigestMD5Base's nested classes calling
;; AbstractSaslImpl.traceOutput): j2g's unaccess gives the call of the declaring class, the one with a Go function

(defn test-inherited-static-accessor []
  (let [e (edge/read-edge "jdk/edge.edn")
        world (binding [m/*run* true env/*declared* (:classes e) edge/*edge* e a/*source-lookup* false]
                (w/load-world [{:root "test/j2g/unit/access" :tree true}] :variant-files []))
        body (fn [cls nm] (w/with-world world
                            (some (fn [[[n _] b]] (when (= n nm) b)) (:bodies @(:state (a/decl cls))))))
        call (fn [cls nm] (first (filter #(= :invoke (:op %)) (nodes-of (body cls nm)))))
        via (call "b/Sub$In" "viaOuter")
        un (w/with-world world (access/unaccess via))
        direct (call "b/Sub" "direct")]
    (check "accessor: the fixture analyzes, In's call is an accessor of Sub"
           (and (= "b/Sub" (:owner via)) (str/starts-with? (str (:name via)) "access$"))
           (pr-str (select-keys via [:owner :name]) (:failed world)))
    (check "accessor: unaccess calls Base.trace, the declaring class (the JVM's resolution), not Sub.trace"
           (and (= "a/Base" (:owner un)) (= "trace" (:name un)) (= "a/Base" (:owner (:method un))))
           (pr-str (select-keys un [:owner :name])))
    (check "accessor: control: Sub's own call of Base.shown needs no accessor"
           (and (= "a/Base" (:owner direct)) (= "shown" (:name direct)))
           (pr-str (select-keys direct [:owner :name])))))

;; A18 of the Ghidra case study's G2 plan (ghidra.util.classfinder.ClassSearcherTest's forNameSafe): Class.forName(name,
;; false, loader) finds a class without running its initializer, which runs on the first active use. The fixture
;; test/j2g/unit/forname/f/Lazy.java (its committed forms; the stand-ins of Class's interfaces beside it): the analysis
;; keeps the call's initialize argument; the call is jrt's Class_ForName_String_Z_ClassLoader__Class, which runs the
;; class's Init only under that argument, its registry lookup ForName none; a program's class is never one initialized at
;; start; the control, Class.forName(String), runs Init unguarded. The run is test/programs/reflect-meta's rm.Lazy (the night's).

(defn- go-func-form
  "The (go/func NAME ...) form of the Go forms file at path."
  [path name]
  (some #(when (and (seq? %) (= 'go/func (first %)) (= name (second %))) %) (source-forms path)))

(defn- init-guards
  "For each call of a class's Init ((.-Init x) in call position) in form: the conditions of the whens around it,
  innermost first."
  [form]
  (let [out (atom [])
        walk (fn walk [x conds]
               (when (seq? x)
                 (when (and (seq? (first x)) (= '.-Init (ffirst (seq [(first x)]))))
                   (swap! out conj conds))
                 (let [conds (if (= 'when (first x)) (cons (second x) conds) conds)]
                   (doseq [y x] (walk y conds)))))]
    (walk form ())
    @out))

(defn test-forname []
  (let [e (edge/read-edge "jdk/edge.edn")
        world (binding [m/*run* true env/*declared* (:classes e) edge/*edge* e a/*source-lookup* false]
                (w/load-world [{:root "test/j2g/unit/forname" :tree true}] :variant-files []))
        body (fn [cls nm] (w/with-world world (some (fn [[[n _] b]] (when (= n nm) b)) (:bodies @(:state (a/decl cls))))))
        fn3 (fn [nm] (first (filter #(and (= :invoke (:op %)) (= "java/lang/Class" (:owner %)) (= "forName" (:name %)))
                                    (nodes-of (body "f/Lazy" nm)))))
        desc "(Ljava/lang/String;ZLjava/lang/ClassLoader;)Ljava/lang/Class;"
        lazy (fn3 "probe")
        eager (fn3 "eager")
        uses-flag? (fn [conds] (some #(some #{'initialize} (tree-seq coll? seq %)) conds))
        three (go-func-form "go/arbace/jrt/reflect.ae" 'Class_ForName_String_Z_ClassLoader__Class)
        one (go-func-form "go/arbace/jrt/class.ae" 'Class_ForName_String__Class)
        lookup (go-func-form "go/arbace/jrt/class.ae" 'ForName)]
    (check "forname: the fixture analyzes" (and (seq (body "f/Lazy" "probe")) (empty? (:failed world))) (pr-str (:failed world)))
    (check "forname: Class.forName(name, false, loader) is the three-argument call, its initialize argument false"
           (and (= desc (:desc lazy)) (= :static (:kind lazy)) (false? (:val (second (:args lazy)))))
           (pr-str (select-keys lazy [:desc :kind :args])))
    (check "forname: control: Class.forName(name, true, loader) keeps true"
           (and (= desc (:desc eager)) (true? (:val (second (:args eager))))) (pr-str (:args eager)))
    (check "forname: its Go function is jrt's Class_ForName_String_Z_ClassLoader__Class"
           (and (= "ForName_String_Z_ClassLoader__Class" (nm/method-base "forName" desc)) (some? three)))
    (check "forname: jrt's function runs the class's Init only under its initialize argument"
           (and (seq (init-guards three)) (every? uses-flag? (init-guards three))) (pr-str (init-guards three)))
    (check "forname: the registry's lookup ForName runs no Init" (and (some? lookup) (empty? (init-guards lookup))))
    (check "forname: the class's initializer is code (Side's static block), so it has an Init to defer"
           (seq (w/with-world world (:clinit @(:state (a/decl "f/Lazy$Side"))))))
    (check "forname: a program's class is never one initialized at start (the runtime's alone)"
           (every? #(re-find #"^arbace/(jrt|lang)[.]" %) start/classes) (pr-str (remove #(re-find #"^arbace/(jrt|lang)[.]" %) start/classes)))
    (check "forname: control: Class.forName(String) runs Init with no initialize argument (the check sees a guard's absence)"
           (and (seq (init-guards one)) (not-any? uses-flag? (init-guards one))) (pr-str (init-guards one)))))
;; A8 and A8b (the Ghidra case study's G1 plan; J2G-SPEC §4.1, "Declarations outside the world"): a class naming
;; a class of a platform module outside the world (java.desktop, java.sql) or of a binary-only jar analyzes, its
;; operations on that class J2g_Missing naming the declaration's source; a class no source declares is refused
;; still. The platform: J2G_UNIT_PLATFORM (bin/j2g-unit: bin/repr-java platform-dir's); the class directory:
;; J2G_UNIT_OUTSIDE_CLASSES (bin/j2g-unit unpacks test/programs/java-project/maven's org.example:toyext:1.0)

(defn- outside-sources []
  (let [p (System/getenv "J2G_UNIT_PLATFORM") c (System/getenv "J2G_UNIT_OUTSIDE_CLASSES")]
    (when (and (seq p) (seq c))
      [(outside/platform-source p) (outside/classes-source c "org.example:toyext:1.0")])))

(defn test-outside []
  (let [srcs (outside-sources)
        e (edge/read-edge "jdk/edge.edn")
        load (fn [declared]
               (binding [m/*run* true env/*declared* declared edge/*edge* e a/*source-lookup* false]
                 ;; with the world's EventListener and EventObject (java.base's, which the java.beans classes extend)
                 [(w/load-world [{:root "test/j2g/unit/outside" :tree true}
                                 {:files ["jdk/forms/java/util/EventListener.ae" "jdk/forms/java/util/EventObject.ae"]}]
                                :variant-files [])
                  declared]))
        failed-of (fn [world] (into {} (for [[c msg] (:failed world)] [c msg])))
        classes ["q/Events" "q/Listener" "q/Store" "q/Texts"]]
    (check "outside: the platform and the class directory given (J2G_UNIT_PLATFORM, J2G_UNIT_OUTSIDE_CLASSES)"
           (some? srcs) "bin/j2g-unit sets them")
    (when srcs
      (let [[w0 _] (load (:classes e))
            f0 (failed-of w0)
            d (outside/declared (:classes e) srcs)
            [w1 _] (load d)
            f1 (failed-of w1)
            reason (fn [cls mname op]
                     (w/with-world w1
                       (binding [m/*w* {:T (set (keys @(:compile-set w1))) :jrt-classes {} :jrt {}}
                                 env/*declared* d]
                         (some (fn [[[n _] b]]
                                 (when (= n mname)
                                   (some #(when (= op (:op %)) (code/missing-reason %)) (nodes-of b))))
                               (:bodies @(:state (a/decl cls)))))))
            fact (fn [n k] (get (get d n) k))]
        (check "outside: control: without the declarations the four classes are refused (JCS69 (b), A7)"
               (every? #(contains? f0 %) classes) (pr-str (keys f0)))
        (check "outside: with them none of the four is refused"
               (not-any? #(contains? f1 %) classes) (pr-str (select-keys f1 classes)))
        (check "outside: control: a class no source declares is refused still (javax.nonesuch.Gadget)"
               (str/includes? (str (get f1 "q/Absent")) "Gadget") (pr-str (get f1 "q/Absent")))
        (check "outside: PropertyChangeEvent's constructor is J2g_Missing naming java.desktop"
               (= (reason "q/Events" "fire" :new)
                  "class java.beans.PropertyChangeEvent is outside the closed world: declarations only, from java.desktop (the platform)")
               (pr-str (reason "q/Events" "fire" :new)))
        (check "outside: a binary-only jar's static call is J2g_Missing naming its coordinate"
               (= (reason "q/Texts" "fancy" :invoke)
                  "class org.example.toyext.ToyText is outside the closed world: declarations only, from org.example:toyext:1.0")
               (pr-str (reason "q/Texts" "fancy" :invoke)))
        (check "outside: a call of a world method whose parameter is an outside interface is no stub (Events.listen)"
               (and (nil? (reason "q/Listener" "wire" :invoke))
                    (w/with-world w1 (binding [m/*w* {:T (set (keys @(:compile-set w1))) :jrt-classes {} :jrt {}} env/*declared* d]
                                       (m/member-mdesc? "(Ljava/beans/PropertyChangeListener;)V"))))
               (pr-str (reason "q/Listener" "wire" :invoke)))
        (check "outside: control: without the declarations that descriptor is no member's (m/member-mdesc?)"
               (w/with-world w0 (binding [m/*w* {:T #{} :jrt-classes {} :jrt {}} env/*declared* (:classes e)]
                                  (not (m/member-mdesc? "(Ljava/beans/PropertyChangeListener;)V")))))
        (check "outside: describe and plain name no outside class (no missing operation)"
               (and (nil? (reason "q/Events" "describe" :invoke)) (nil? (reason "q/Texts" "plain" :invoke))))
        (check "outside: a binary-only jar's constant folded as javac folds it (ToyText.NAME)"
               (some #(= "toyext" (:val %))
                     (w/with-world w1 (nodes-of (some (fn [[[n _] b]] (when (= n "library") b)) (:bodies @(:state (a/decl "q/Texts")))))))
               "library's body")
        (check "outside: the declarations' facts: an inner enum's modifiers and constants, a super, an annotation's retention"
               (and (= 16409 (:flags (fact "java/awt/Desktop$Action" :info)))
                    (= "BROWSE" (nth (fact "java/awt/Desktop$Action" :enum-constants) 4))
                    (= "java/util/EventObject" (:super (fact "java/beans/PropertyChangeEvent" :info)))
                    (nil? (:super (fact "javax/sql/DataSource" :info)))
                    (= :runtime (fact "org/example/toyext/Marker" :retention))
                    (= #{"TYPE" "METHOD" "FIELD"} (fact "org/example/toyext/Marker" :targets))))
        ;; a generic interface's signature names Object as its super: no super in the generic view
        ;; (guava's BiMap in the Ghidra demo's analysis, 2026-11-16)
        (check "outside: a generic interface's generics: its type parameter and its generic superinterface alone"
               (let [g (fact "javax/swing/ListModel" :generics)]
                 (and (= '[E] (:tparams g)) (empty? (:supers g))
                      (some #(= "getElementAt" (:name %)) (:methods g))))
               (pr-str (dissoc (fact "javax/swing/ListModel" :generics) :methods)))
        (check "outside: a generic class's generic superclass (javax.swing.DefaultListModel<E> extends AbstractListModel<E>)"
               (= [{:t :class :name "javax/swing/AbstractListModel" :args [{:t :tvar :sym 'E}]}]
                  (:supers (fact "javax/swing/DefaultListModel" :generics)))
               (pr-str (:supers (fact "javax/swing/DefaultListModel" :generics))))
        (let [r (outside/report srcs d)]
          (check "outside: the report lists each declared class with its source"
                 (and (= "java.desktop (the platform)" (get (outside/asked d) "java/beans/PropertyChangeEvent"))
                      (= "java.sql (the platform)" (get (outside/asked d) "javax/sql/DataSource"))
                      (= "org.example:toyext:1.0" (get (outside/asked d) "org/example/toyext/ToyText"))
                      (= (:declared r) (count (:classes r))))
                 (pr-str (outside/asked d))))
        ;; since A8c java.base's API is declared too, when neither the world nor the edge has the class (its
        ;; internal packages not: test-outside-completion's control)
        (check "outside: java.base's API outside the world is declared from java.base (java.lang.classfile, A8c)"
               (= outside/base-origin (:outside (get d "java/lang/classfile/ClassFile"))))
        (check "outside: the edge's classes keep its answers (String's info is the edge's)"
               (identical? (:info (get (:classes e) "java/lang/String")) (:info (get d "java/lang/String"))))))))

;; A8c (the Ghidra demo's 20 classes left after A8): the world's variants completed from the platform (java.awt.Color's
;; Paint and its cut ColorSpace members), java.base's API that neither the world nor the edge has declared too (in a
;; program's own classes' members alone), an edge class's missing generics read from java.base's class file, and a
;; file's own import before its package's namespace-wide one

(defn test-outside-completion []
  (let [srcs (outside-sources)
        e (edge/read-edge "jdk/edge.edn")
        files ["jdk/forms/java/util/EventListener.ae" "jdk/forms/java/util/EventObject.ae"
               "jdk/forms/java/awt/Color.ae" "jdk/forms/java/awt/Transparency.ae" "jdk/forms/java/io/Serializable.ae"
               "jdk/forms/java/util/function/Supplier.ae"]
        load (fn [declared completion]
               (binding [m/*run* true env/*declared* declared edge/*edge* e a/*source-lookup* false
                         a/*completion* completion]
                 (w/load-world [{:root "test/j2g/unit/outside" :tree true} {:files files}] :variant-files [])))
        failed-of (fn [world] (into {} (for [[c msg] (:failed world)] [c msg])))]
    (when srcs
      (let [d (outside/declared (:classes e) srcs)
            w0 (load (:classes e) nil)
            wd (load d nil)
            w1 (load d (outside/completion d))
            f0 (failed-of w0) fd (failed-of wd) f1 (failed-of w1)
            mw {:T (set (keys @(:compile-set w1))) :jrt-classes {} :jrt {}}
            reason (fn [cls mname op]
                     (w/with-world w1
                       (binding [m/*w* mw env/*declared* d]
                         (some (fn [[[n _] b]]
                                 (when (= n mname)
                                   (some #(when (= op (:op %)) (code/missing-reason %)) (nodes-of b))))
                               (:bodies @(:state (a/decl cls)))))))
            color-method (fn [nm desc] (w/with-world w1 (some #(when (and (= nm (:name %)) (= desc (:desc %))) %)
                                                              (:methods (a/decl "java/awt/Color")))))
            cs "(Ljava/awt/color/ColorSpace;[F)[F"]
        (check "completion: the world's Color and its fixtures load" (not-any? #(contains? f1 %) ["java/awt/Color" "q/Paints" "q/Tint"])
               (pr-str (select-keys f1 ["java/awt/Color" "q/Paints" "q/Tint"])))
        (check "completion: control: with the declarations but no completion, Paints is refused (Color is no Paint)"
               (str/includes? (str (get fd "q/Paints")) "setPaint") (pr-str (get fd "q/Paints")))
        (check "completion: control: without the declarations Paints is refused" (contains? f0 "q/Paints"))
        (check "completion: Color implements java.awt.Paint (the platform's), Transparency and Serializable kept"
               (= ["java/awt/Transparency" "java/io/Serializable" "java/awt/Paint"] (w/with-world w1 (:interfaces (a/decl "java/awt/Color"))))
               (pr-str (w/with-world w1 (:interfaces (a/decl "java/awt/Color")))))
        (check "completion: getComponents(ColorSpace, float[]) is an outside member naming java.desktop"
               (let [mm (color-method "getComponents" cs)]
                 (and (= :outside-member (:derived mm)) (= "java.desktop (the platform)" (:outside mm))
                      (= 1 (:flags mm))))
               (pr-str (color-method "getComponents" cs)))
        (check "completion: the world's own members stay the forms' (getRGB, getComponents(float[]) not derived)"
               (and (nil? (:derived (color-method "getRGB" "()I"))) (nil? (:derived (color-method "getComponents" "([F)[F")))))
        (check "completion: getColorSpace and createContext declared, no constructor"
               (and (color-method "getColorSpace" "()Ljava/awt/color/ColorSpace;")
                    (some #(= "createContext" (:name %)) (w/with-world w1 (:methods (a/decl "java/awt/Color"))))
                    (not-any? #(and (= "<init>" (:name %)) (:derived %)) (w/with-world w1 (:methods (a/decl "java/awt/Color"))))))
        (check "completion: the outside member's Go body throws, naming it"
               (= (str "method java.awt.Color.getComponents" cs " is outside the closed world: the world's java.awt.Color lacks it;"
                       " declarations only, from java.desktop (the platform)")
                  (decls/outside-member-reason "java/awt/Color" (color-method "getComponents" cs))))
        (let [body (w/with-world w1
                     (binding [m/*w* (assoc mw :subclass-index (constantly {})) env/*declared* d code/*f* {}]
                       (try (decls/derived-body :jrt "java/awt/Color" (color-method "getComponents" cs) '[p0 p1])
                            (catch Throwable t (str "threw: " t)))))]
          (check "completion: the outside member's Go body returns J2g_Missing's value, with that message"
                 (and (sequential? body) (= 1 (count body)) (= 'return (first (first body)))
                      (str/includes? (pr-str body) "J2g_Missing")
                      (str/includes? (pr-str body) "lacks it; declarations only, from java.desktop (the platform)"))
                 (pr-str body)))
        (check "completion: the call of the outside member is no stub at the call (Color's method throws)"
               (nil? (reason "q/Paints" "comps" :invoke)) (pr-str (reason "q/Paints" "comps" :invoke)))
        (check "completion: a method the class has or inherits concretely is never added (keys given)"
               (let [f (outside/completion d)
                     ks (set (map (juxt :name :desc) (f :methods "java/awt/Color" [["getColorSpace" "()Ljava/awt/color/ColorSpace;"]])))]
                 (and (contains? ks ["getComponents" cs]) (not (contains? ks ["getColorSpace" "()Ljava/awt/color/ColorSpace;"])))))
        (check "completion: control: an interface is never completed (Transparency)"
               (nil? ((outside/completion d) :methods "java/awt/Transparency" [])))
        ;; java.base's API (A8c)
        (check "base: Guarded, Watcher (extends SecurityManager) and Handler analyze" (not-any? #(contains? f1 %) ["q/Guarded" "q/Watcher" "q/Handler"])
               (pr-str (select-keys f1 ["q/Guarded" "q/Watcher" "q/Handler"])))
        (check "base: control: with the edge alone they are refused (SecurityManager unknown, the handler's generics undeclared)"
               (every? #(contains? f0 %) ["q/Guarded" "q/Watcher" "q/Handler"]) (pr-str (select-keys f0 ["q/Guarded" "q/Watcher" "q/Handler"])))
        (check "base: SecurityManager and FunctionDescriptor declared from java.base"
               (and (= outside/base-origin (get (outside/asked d) "java/lang/SecurityManager"))
                    (= outside/base-origin (get (outside/asked d) "java/lang/foreign/FunctionDescriptor"))))
        (check "base: FunctionDescriptor.ofVoid is J2g_Missing naming java.base"
               (= (reason "q/Guarded" "descriptor" :invoke)
                  "class java.lang.foreign.FunctionDescriptor is outside the closed world: declarations only, from java.base (the platform)")
               (pr-str (reason "q/Guarded" "descriptor" :invoke)))
        (check "base: the edge's UncaughtExceptionHandler gains its generics, not :outside, not reported"
               (let [h (get d "java/lang/Thread$UncaughtExceptionHandler")]
                 (and (contains? h :generics) (nil? (:outside h)) (identical? (:info h) (:info (get (:classes e) "java/lang/Thread$UncaughtExceptionHandler")))
                      (not (contains? (outside/asked d) "java/lang/Thread$UncaughtExceptionHandler")))))
        (w/with-world w1
          (binding [m/*w* mw env/*declared* d]
            (check "base: a program's own member may name a java.base outside class (Guarded's SecurityManager field)"
                   (m/member-desc? "q/Guarded" "Ljava/lang/SecurityManager;"))
            (check "base: control: a world class's member may not (java.awt.Color, a JDK class), nor one without an owner"
                   (and (not (m/member-desc? "java/awt/Color" "Ljava/lang/SecurityManager;"))
                        (not (m/member-desc? "Ljava/lang/SecurityManager;"))))
            (check "base: control: a non-java.base outside class is a world member's type still (A8)"
                   (m/member-desc? "java/awt/Color" "Ljava/awt/color/ColorSpace;"))))
        (check "base: control: java.base's internal packages are not declared (jdk.internal)"
               (nil? (get d "jdk/internal/classfile/impl/ClassFileImpl")))
        ;; a file's own import (A8c)
        (check "imports: Imports' lambda is its own import's Supplier, though Watched.ae's import of q.other.Supplier came last"
               (and (not (contains? f1 "q/Imports")) (not (contains? f1 "q/Watched"))
                    (= "q/other/Supplier" (get-in @env/source-imports ['q 'Supplier])))
               (pr-str (select-keys f1 ["q/Imports" "q/Watched"]) (get-in @env/source-imports ['q 'Supplier])))
        (check "imports: control: without the file's imports the namespace's Supplier is q.other's"
               (w/with-world w1
                 (and (= "java/util/function/Supplier" (a/resolve-class-sym {:class "q/Imports" :ns (the-ns 'q)} 'Supplier))
                      (= "q/other/Supplier" (binding [a/*unit* (dissoc a/*unit* :file-imports)]
                                              (a/resolve-class-sym {:class "q/Imports" :ns (the-ns 'q)} 'Supplier))))))))))

;; h-java-aot-triage (2026-11-17): a null constant cast to a class, (cast String nil), coerced to Object (a varargs
;; element: OneCaseSwitches' method.invoke(null, (String) null, ...), t05934) was (.Ref nil), Go's "nil.Ref undefined"

(defn test-null-up []
  (check "null-up: a null constant to Object is any's nil, not (.Ref nil)"
         (= '(conv any nil) (code/up-sym nil "Ljava/lang/String;" "Ljava/lang/Object;"))
         (pr-str (code/up-sym nil "Ljava/lang/String;" "Ljava/lang/Object;")))
  (check "null-up: control: a String value to Object is its .Ref"
         (= '(.Ref x) (code/up-sym 'x "Ljava/lang/String;" "Ljava/lang/Object;"))
         (pr-str (code/up-sym 'x "Ljava/lang/String;" "Ljava/lang/Object;"))))

;; A14 of the Ghidra case study's G2 plan (J2G-SPEC §4.1, "The run-path ranking"; bin/j2g-rank): each run's stubs on its
;; path by cause, the causes ranked by the runs they block alone. The fixture test/j2g/unit/rank: a report of
;; test/programs/outside's classes' reasons and three runs files of the three shapes; the controls: an empty list ranks
;; nothing, a list naming no stubbed class blocks no run

(defn test-rank []
  (let [d "test/j2g/unit/rank/"
        st (rank/stubs (read-string (slurp (str d "report.edn"))))
        runs (vec (mapcat rank/read-runs [(str d "main.txt") (str d "reach.log") (str d "runs.edn")]))
        r (rank/rank st runs)
        row (fn [c] (some #(when (= c (:cause %)) %) (:ranking r)))
        jar [:outside "org.example:toyext:1.0"]]
    (check "rank: the causes of the reasons (outside by source, jrt's member by class, a refusal by its name)"
           (and (= [:outside "java.desktop (the platform)"] (first (get st "demo/outside/Events")))
                (= #{jar [:jrt-lacks "java.util.prefs.Preferences"]} (get st "demo/outside/Store"))
                (= #{[:refused "java.awt"]} (get st "demo/outside/Gui")))
           (pr-str st))
    (check "rank: the three runs files read (text, -Xlog lines, :runs)"
           (= [["main.txt" ["demo.outside.Main" "demo.outside.Recorder"]] ["reach.log" ["demo.outside.Main" "demo.outside.Events"]]]
              (subvec runs 0 2))
           (pr-str (subvec runs 0 2)))
    (check "rank: four runs, three meet a stub (main's run none)" (and (= 4 (:runs r)) (= 3 (:blocked r))) (pr-str (dissoc r :per-run)))
    (check "rank: toyext's jar first: one run blocked by it alone (JarTest), two in all"
           (and (= jar (:cause (first (:ranking r)))) (= 1 (:sole (row jar))) (= 2 (:runs (row jar)))
                (= ["demo/outside/Store" "demo/outside/Texts"] (:classes (row jar))))
           (pr-str (:ranking r)))
    (check "rank: java.desktop blocks reach's run alone; StoreTest's three causes none alone"
           (and (= 1 (:sole (row [:outside "java.desktop (the platform)"]))) (= 0 (:sole (row [:refused "java.awt"])))
                (= 3 (count (:causes (nth (:per-run r) 3))))))
    (check "rank: control: an empty list ranks nothing" (= {:runs 1 :blocked 0 :ranking []} (dissoc (rank/rank st [["e" []]]) :per-run)))
    (check "rank: control: a list naming no stubbed class blocks no run"
           (zero? (:blocked (rank/rank st [["x" ["demo.outside.Main" "java.lang.String"]]]))))))

;; AT9 (h-java-aot-triage, the user 2026-11-17): the edge's recorder gives every class it records with an info its
;; generics too (a test's Thread.UncaughtExceptionHandler, CountDownLatch, Semaphore: "Undeclared generics"); the
;; reflection stubbed (generics-of), as the Go build's Class has no generic signatures; the controls: a facet the run
;; asked is kept as asked, an array (no class loaded, no info) gains none

(defn test-edge-generics []
  (let [g {:tparams [] :supers [] :methods [] :stub true}
        asked {:tparams ['T] :supers [] :methods []}
        r (binding [env/*declared* nil]
            (:classes (edge/recorded-edge {"java/lang/Runnable" {:exists true}
                                           "java/lang/Comparable" {:exists true :generics asked}
                                           "[I" {:exists true}}
                                          {} (constantly g))))]
    (check "edge-generics: a recorded class with an info gains its generics"
           (and (contains? (get r "java/lang/Runnable") :info) (:stub (:generics (get r "java/lang/Runnable"))))
           (pr-str (get r "java/lang/Runnable")))
    (check "edge-generics: control: generics the run asked are kept as asked"
           (= ['T] (:tparams (:generics (get r "java/lang/Comparable")))) (pr-str (:generics (get r "java/lang/Comparable"))))
    (check "edge-generics: control: an array gains no generics" (not (contains? (get r "[I") :generics)) (pr-str (get r "[I")))))

;; AT10 (h-java-aot-triage, the user 2026-11-17): an instance call of Object.finalize() itself, its class declaring
;; none (ProtectedAccess_3's C.this.finalize(), t06387: Go's "Finalize__V undefined"), is Object's empty body in
;; invoke-val (jrt.NN of the receiver); the controls: a class declaring finalize calls its own, hashCode is not it

(defn test-object-finalize []
  (let [e (edge/read-edge "jdk/edge.edn")
        world (binding [m/*run* true env/*declared* (:classes e) edge/*edge* e a/*source-lookup* false]
                (w/load-world [{:root "test/j2g/unit/finalize" :tree true}] :variant-files []))
        call (fn [cls mn] (w/with-world world
                            (first (filter #(= :invoke (:op %))
                                           (nodes-of (some (fn [[[n _] b]] (when (= n mn) b)) (:bodies @(:state (a/decl cls)))))))))
        plain (call "z/Plain" "fin") own (call "z/Own" "fin") hash (call "z/Plain" "hash")]
    (check "object-finalize: the fixture analyzes" (and plain own hash (empty? (:failed world))) (pr-str (:failed world)))
    (check "object-finalize: Plain's this.finalize() is Object's own, the no-op" (code/object-finalize? plain)
           (pr-str (select-keys plain [:owner :name :desc :kind]) (:owner (:method plain))))
    (check "object-finalize: control: Own's this.finalize() is Own's" (not (code/object-finalize? own))
           (pr-str (select-keys own [:owner :name :desc :kind]) (:owner (:method own))))
    (check "object-finalize: control: hashCode is not finalize" (not (code/object-finalize? hash)))
    ;; the review's risk (round 52, 2026-11-18): jrt.NN takes a *T, so the emitted check is chosen by the receiver's
    ;; Go type: NN on a pointer (a leaf class), J2g_NotNull[T] on an interface (an abstract or non-leaf class's this,
    ;; an interface-typed receiver); each method translated whole by decls/method-forms, as the translation does
    (let [mw {:T (set (keys @(:compile-set world))) :jrt-classes {} :jrt {}}
          mw (assoc mw :subclass-index (m/make-subclass-index mw))
          go-of (fn [cls mn]
                  (w/with-world world
                    (binding [m/*w* mw env/*declared* (:classes e) decls/*reached* #{}
                              code/*pkgstate* {:lits (atom {}) :ups (atom #{}) :lambdas (atom #{}) :cuts (atom #{})}]
                      (let [mm (some #(when (= mn (:name %)) %) (:methods (a/decl cls)))]
                        (binding [decls/*reached* #{[cls (:name mm) (:desc mm)]}]
                          (try (decls/method-forms (m/pkg cls) cls mm) (catch Throwable t (str "threw: " t))))))))
          checks (fn [f] (filter #(and (seq? %) (let [h (first %)]
                                                  (or (= "NN" (name (if (symbol? h) h '_)))
                                                      (and (seq? h) (= 'inst (first h)) (= "J2g_NotNull" (name (second h)))))))
                                 (tree-seq coll? seq f)))
          shape-of (fn [f] (let [cs (checks f)]
                             (when (= 1 (count cs))
                               (let [[h x] (first cs)]
                                 (if (symbol? h) [:nn x] [:not-null (str (nth h 2)) x])))))
          shape (fn [cls mn] (shape-of (go-of cls mn)))
          ;; the judge of an interface-typed this: J2g_NotNull of this, instantiated at the class's interface C_I
          iface-this? (fn [sh simple] (and (= :not-null (first sh)) (= 'this (nth sh 2))
                                           (str/ends-with? (second sh) (str simple "_J_I"))))
          show (fn [cls mn] (pr-str (go-of cls mn)))]
      (check "object-finalize: emitted: a leaf's this (Plain) is jrt.NN of t, the pointer"
             (= [:nn 't] (shape "z/Plain" "fin")) (show "z/Plain" "fin"))
      (check "object-finalize: emitted: an abstract class's this (Abs) is J2g_NotNull[Abs_I], not NN"
             (iface-this? (shape "z/Abs" "fin") "Abs") (show "z/Abs" "fin"))
      (check "object-finalize: emitted: a non-leaf class's this (Base, Sub extends it) is J2g_NotNull[Base_I]"
             (iface-this? (shape "z/Base" "fin") "Base") (show "z/Base" "fin"))
      (check "object-finalize: emitted: an interface-typed receiver (Shape) is J2g_NotNull[Shape] of the parameter"
             (let [sh (shape "z/Base" "onShape")] (and (= :not-null (first sh)) (str/ends-with? (second sh) "Shape_J") (= (quote s) (nth sh 2))))
             (show "z/Base" "onShape"))
      (check "object-finalize: emitted: a leaf-class-typed parameter (Plain) is jrt.NN"
             (= :nn (first (shape "z/Base" "onPlain"))) (show "z/Base" "onPlain"))
      (check "object-finalize: control: Own's own finalize is called, no Object check emitted"
             (empty? (checks (go-of "z/Own" "fin"))) (show "z/Own" "fin"))
      (check "object-finalize: negative control: the old shape, jrt.NN of Abs's interface-typed this, fails the judge"
             (let [old '((go/method Impl_Fin__V [t this] (jrt/NN this)))]
               (and (= [:nn 'this] (shape-of old)) (not (iface-this? (shape-of old) "Abs"))))))))

;; Round 54's fourth pass (doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: n-java-defer (round 54), the fourth pass"): the
;; translated classes the eval cell's tests extend (their own subclasses, anonymous ones too, and RMI's stubs and objects)
;; are class-supers: each a class of jdk/forms (not jrt's hand-written: those need a class interface, JC4c's way), not
;; final and not an interface, so that it gets its DynSub_C; RemoteStub's DynSub_C has its protected constructor (the
;; rmic stubs' super(ref)), the interpreter's "No accessible constructor of java.rmi.server.RemoteStub"
(def ^:private r54-supers
  ["com/sun/security/auth/callback/TextCallbackHandler" "java/util/concurrent/CyclicBarrier"
   "java/util/concurrent/ConcurrentHashMap" "java/io/FileOutputStream" "java/io/IOException" "java/math/BigDecimal"
   "java/util/Hashtable" "java/net/SocketAddress" "java/net/ResponseCache" "java/util/ResourceBundle"
   "java/lang/ExceptionInInitializerError" "javax/management/QueryEval" "javax/rmi/ssl/SslRMIClientSocketFactory"
   "java/util/concurrent/ConcurrentLinkedDeque" "java/util/concurrent/ConcurrentLinkedQueue"
   "java/util/concurrent/LinkedTransferQueue" "java/util/concurrent/LinkedBlockingQueue"
   "java/util/concurrent/LinkedBlockingDeque" "java/util/concurrent/ArrayBlockingQueue"
   "java/util/concurrent/PriorityBlockingQueue" "java/util/concurrent/ThreadPoolExecutor" "java/net/CacheResponse"
   "javax/rmi/ssl/SslRMIServerSocketFactory" "java/rmi/server/RemoteStub" "java/rmi/server/RemoteObject"
   "java/rmi/server/UnicastRemoteObject" "javax/management/remote/rmi/RMIJRMPServerImpl"])

(defn- extendable-translated?
  "Is n a class of jdk/forms whose defclass is neither final nor an interface, and not jrt's hand-written."
  [manifest n]
  (let [f (io/file (str "jdk/forms/" n ".ae"))
        simple (last (str/split n #"/"))]
    (and (.exists f) (not (contains? manifest (str/replace n "/" ".")))
         (let [head (some #(when (re-find (re-pattern (str "^\\(defclass .*\\b" (java.util.regex.Pattern/quote simple) "$")) %) %)
                          (str/split-lines (slurp f)))]
           (and head (not (str/includes? head "^:final")) (not (str/includes? head "^:interface")))))))

(defn test-class-supers-r54 []
  (let [manifest (set (map str (keys (read-string (slurp "go/arbace/jrt/manifest.edn")))))
        ok? (partial extendable-translated? manifest)
        listed (set dyn/sub-supers)]
    (check "class-supers-r54: every round-54 class is listed (model/class-supers, dyn/sub-supers)"
           (every? listed r54-supers) (pr-str (remove listed r54-supers)))
    (check "class-supers-r54: each is a translated class of jdk/forms, not final, not an interface, not jrt's"
           (every? ok? r54-supers) (pr-str (remove ok? r54-supers)))
    (check "class-supers-r54: negative controls: a final class (java.util.Objects), an interface (java.rmi.Remote) and jrt's
      CountDownLatch fail the judge"
           (not-any? ok? ["java/util/Objects" "java/rmi/Remote" "java/util/concurrent/CountDownLatch"]))
    (let [e (edge/read-edge "jdk/edge.edn")
          files (map #(str "jdk/forms/java/rmi/" % ".ae") ["server/RemoteStub" "server/RemoteObject" "server/RemoteRef" "Remote"])
          world (binding [m/*run* true env/*declared* (:classes e) edge/*edge* e a/*source-lookup* false]
                  (try (w/load-world [{:files (vec files)}] :variant-files []) (catch Throwable t {:threw (str t)})))]
      (if (:threw world)
        (println (str "skip  class-supers-r54: RemoteStub's world alone does not load here: " (:threw world)))
        (let [mw {:T (set (keys @(:compile-set world))) :jrt-classes {} :jrt {} :vmethods-cache (atom {}) :trivial-cache (atom {})}
              mw (assoc mw :subclass-index (m/make-subclass-index mw))
              fs (w/with-world world
                   (binding [m/*w* mw env/*declared* (:classes e)
                             code/*pkgstate* {:lits (atom {}) :ups (atom #{}) :lambdas (atom #{}) :cuts (atom #{})}]
                     (try (doall (#'dyncf/sub-forms "java/rmi/server/RemoteStub")) (catch Throwable t [(str "threw: " t)]))))
              txt (pr-str fs)]
          (check "class-supers-r54: RemoteStub's DynSub constructors include its protected RemoteStub(RemoteRef)"
                 (str/includes? txt "(Ljava/rmi/server/RemoteRef;)V") (subs txt 0 (min 600 (count txt))))
          (check "class-supers-r54: RemoteStub is not a leaf once listed"
                 (w/with-world world (binding [m/*w* mw] (not (m/leaf? "java/rmi/server/RemoteStub"))))))))))

;; Round 54 (doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: n-java-defer (round 54), the second pass"): Object.clone of an
;; object of an interpreted class extending a class of the world (a DynSub_C): its Clone__O is C's clone with the
;; object as this, else Object's; its CloneShallow copies the struct and the core when the class is Cloneable (C's
;; supertypes, else the core's interfaces at run time); the interpreter's super.clone() finds it among C's supers
(defn test-dynsub-clone []
  (let [e (edge/read-edge "jdk/edge.edn")
        world (binding [m/*run* true env/*declared* (:classes e) edge/*edge* e a/*source-lookup* false]
                (w/load-world [{:root "test/j2g/unit/clone" :tree true} {:files ["jdk/forms/java/lang/Cloneable.ae"]}] :variant-files []))
        mw {:T (set (keys @(:compile-set world))) :jrt-classes {} :jrt {} :vmethods-cache (atom {}) :trivial-cache (atom {})}
        mw (assoc mw :subclass-index (m/make-subclass-index mw))
        forms (fn [f & args]
                (w/with-world world
                  (binding [m/*w* mw env/*declared* (:classes e)
                            code/*pkgstate* {:lits (atom {}) :ups (atom #{}) :lambdas (atom #{}) :cuts (atom #{})}]
                    (try (doall (apply f args)) (catch Throwable t [(str "threw: " t)])))))
        method (fn [fs nme] (first (filter #(and (seq? %) (= 'go/method (first %)) (= nme (second %))) fs)))
        sub (fn [cls] (forms #'dyn/sub-forms cls [] dyn/object-slots))
        supers (fn [cls] (let [fs (forms #'dyncf/sub-forms cls)
                               v (first (filter #(and (seq? %) (= 'go/var (first %)) (str/starts-with? (name (second %)) "dynCfSupers_")) fs))]
                           (some (fn [x] (when (and (vector? x) (= "clone()Ljava/lang/Object;" (first x))) (second x))) (drop 2 (nth v 2)))))
        has (fn [f x] (some #(= x %) (tree-seq coll? seq f)))
        copied (sub "z/Copied") bare (sub "z/Bare")]
    (check "dynsub-clone: the fixture analyzes" (empty? (:failed world)) (pr-str (:failed world)))
    (check "dynsub-clone: Copied's Clone__O is Copied's clone with the proxy as this"
           (has (method copied 'Clone__O) '(.Impl_Clone__O t t)) (pr-str (method copied 'Clone__O)))
    (check "dynsub-clone: Copied's CloneShallow copies the struct and the core, no run-time check (Copied is Cloneable)"
           (let [f (method copied 'CloneShallow)]
             (and (has f '(set! (.-Self c) (addr c))) (has f '(.ClearHeader (addr c))) (has f '(.MarkDynamic (addr c)))
                  (not (has f 'jrt/Cloneable_class)) (not (has f '(panic (jrt/CloneNotSupported t))))))
           (pr-str (method copied 'CloneShallow)))
    (check "dynsub-clone: Bare's Clone__O is Object's (CloneShallow), its CloneShallow asks the core for Cloneable"
           (and (has (method bare 'Clone__O) '(.CloneShallow t))
                (has (method bare 'CloneShallow) '(.DynImplements t jrt/Cloneable_class)))
           (pr-str (method bare 'Clone__O) (method bare 'CloneShallow)))
    (check "dynsub-clone: the interpreter's super.clone() of Copied is Copied's, of Bare Object's"
           (and (has (supers "z/Copied") '(return (.Impl_Clone__O t t))) (has (supers "z/Bare") '(return (.CloneShallow t))))
           (pr-str (supers "z/Copied") (supers "z/Bare")))
    (check "dynsub-clone: negative control: the old CloneShallow (a panic) fails the judge"
           (let [old '(go/method CloneShallow [t] (panic (jrt/CloneNotSupported t)))]
             (not (has old '(set! (.-Self c) (addr c))))))))

;; A17 of the Ghidra case study's G2 plan (GH15 (a)): the entries' listings, META-INF/arbace/entries, that
;; jdk.internal.jrt.ClassPathResources answers getResources of a package and an entry's JarFile from
(defn test-entries []
  (let [names (meta/tree-class-names "test/j2g/unit/scan")
        owners [[0 "s/plug/a.txt"] [0 "README"] [1 "t/only-b.txt"]]
        paths ["s/plug/a.txt" "README" "t/only-b.txt" "META-INF/arbace/roots/1/s/plug/a.txt" "java/lang/uniName.dat"]
        listing (meta/entries-listing owners paths {0 ["s/Main" "s/Main$Inner"] 1 ["s/plug/Alpha"]})
        of (fn [k] (vec (for [[j n] listing :when (= j k)] n)))]
    (check "entries: a forms tree's classes, top-level and member classes, recursively, package files not"
           (= names ["s/Main" "s/Main$Inner" "s/Main$Inner$Deeper" "s/plug/Alpha"]) (pr-str names))
    (check "entries: entry 0 lists its resources, its classes' class files and the directories above them"
           (= (of 0) ["README" "s/" "s/Main$Inner.class" "s/Main.class" "s/plug/" "s/plug/a.txt"]) (pr-str (of 0)))
    (check "entries: entry 1 lists its root copy by its plain path, its own resource and its class"
           (= (of 1) ["s/" "s/plug/" "s/plug/Alpha.class" "s/plug/a.txt" "t/" "t/only-b.txt"]) (pr-str (of 1)))
    (check "entries: package s/plug/ in both entries, in the class path's order"
           (= [0 1] (vec (for [[k n] listing :when (= n "s/plug/")] k))))
    (check "entries: control: an absent package is no entry's, the JDK's data no entry's"
           (and (not-any? #(= "q/" (second %)) listing) (not-any? #(= "java/lang/uniName.dat" (second %)) listing)
                (not-any? #(neg? (first %)) listing)))
    (check "entries: the listing's text, K NAME a line"
           (= "0 a/\n0 a/b.txt\n" (meta/entries-text (meta/entries-listing [[0 "a/b.txt"]] [] {}))))
    (check "entries: --entry-classes names a --resources directory"
           (= {0 ["s/plug/Alpha"]}
              (#'jm/entry-classes {:resources ["test/programs/resources/resources/a"]
                                   :entry-classes ["a=test/j2g/unit/scan/s/plug"]}))
           (pr-str (#'jm/entry-classes {:resources ["test/programs/resources/resources/a"]
                                        :entry-classes ["a=test/j2g/unit/scan/s/plug"]})))
    (check "entries: control: --entry-classes of no --resources directory is an error"
           (try (#'jm/entry-classes {:resources ["test/programs/resources/resources/a"] :entry-classes ["zz=test/j2g/unit/scan"]}) false
                (catch Exception e (str/includes? (.getMessage e) "no --resources directory zz"))))
    ;; the runtime's side, in the committed forms once bin/jrt-convert has read ClassPathResources afresh
    (let [f (slurp "jdk/forms/jdk/internal/jrt/ClassPathResources.ae")]
      (if (str/includes? f "EmbeddedJarFile")
        (check "entries: jrt's ClassPathResources reads META-INF/arbace/entries, its connection a JarURLConnection"
               (and (str/includes? f "META-INF/arbace/entries") (str/includes? f "JarURLConnection")))
        (println "skip  entries: jdk/forms' ClassPathResources predates A17 (bin/jrt-convert predict, then the night's update)")))))

(defn -main [& _]
  (test-edge-generics)
  (test-object-finalize)
  (test-dynsub-clone)
  (test-class-supers-r54)
  (test-null-up)
  (test-support-tables)
  (test-unresolved-cause)
  (test-unresolved-world)
  (test-analyze-only)
  (test-throws)
  (test-mxbean-signatures)
  (test-type-annotations)
  (test-lookup-call)
  (test-invokers)
  (test-private-reflection)
  (test-inner-ctor-annotations)
  (test-program-meta)
  (test-reflective-sites)
  (test-properties)
  (test-arch-collisions)
  (test-inherited-static-accessor)
  (test-forname)
  (test-entries)
  (test-rank)
  (test-outside)
  (test-outside-completion)
  (println (str "j2g.unit: " (if (zero? @failures) "all passed" (str @failures " failed"))))
  (shutdown-agents)
  (System/exit (if (zero? @failures) 0 1)))

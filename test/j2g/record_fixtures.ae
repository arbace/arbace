;; The recorded results of j2g's fixtures (test/j2g/fixtures/*.ae), which bin/j2g-check compares
;; the translated fixtures with (doc/go/J2G-NOTES.md, "The harness"): each fixture's top-level
;; class's public static methods without parameters whose name starts with t, in name order,
;; called on a JVM (the fixtures loaded here by load-file) and recorded as the oracle's class
;; scripts are. Written to test/j2g/fixtures.edn as [[class-simple-name {:cases [...]}] ...] in
;; the files' and classes' order.
;;
;; Runs on a JVM Arbace (the Go build's Java forms cannot evaluate every fixture: extending a
;; JDK class, java.lang.invoke): `bin/j2g-check --record-fixtures` on the frozen jar
;; (bin/lib/frozen.bash), from the repository's root. It needs arbace.core only. Until
;; standalone S4 bin/j2g-check recorded them on every run, on target/stage2.
;;
;; Usage: SCRIPT [OUT]   (OUT default test/j2g/fixtures.edn)

(ns j2g.record-fixtures
  (:require [arbace.string :as str]))

(def fixtures-dir "test/j2g/fixtures")

(defn- observe [v]
  (cond (nil? v) {:type "nil"}
        (or (string? v) (instance? Boolean v) (instance? Integer v) (instance? Long v) (instance? Double v))
        {:type (.getName (class v)) :value v}
        :else {:type (.getName (class v))}))

(defn- chain [^Throwable e]
  (loop [e e acc [] n 0]
    (if (or (nil? e) (= n 8)) acc (recur (.getCause e) (conj acc [(.getName (class e)) (.getMessage e)]) (inc n)))))

(defn- read-forms [f]
  (with-open [r (arbace.lang.LineNumberingPushbackReader. (java.io.FileReader. ^String f))]
    (binding [*read-eval* false]
      (loop [acc []]
        (let [x (read {:eof ::eof :read-cond :allow} r)]
          (if (= x ::eof) acc (recur (conj acc x))))))))

(def ^:private by-hand
  "The fixtures whose results are kept here, not recorded: the frozen jar's Java forms analysis
  (arbace-for-java-26-v4's) does not take their shapes, which the checkout's does since JN2
  (doc/classes/JAVA-FRONTEND-SURVEY.md, \"As built: JN2\"; an anonymous class in a constructor's
  prologue, a lambda whose return type is the anonymous class its body creates): Java's results,
  as javac's class files give them. {file [class-simple-name {:cases [...]}]}."
  {"test/j2g/fixtures/FxJavacShapes.ae"
   ["FxJShapes" {:cases [{:i 1 :op :static :class "j2g.fixtures.FxJShapes" :name "tLambdaAnonType" :sig []
                          :src "(FxJShapes/tLambdaAnonType)" :result {:type "java.lang.String" :value "descriptor of best"}}
                         {:i 2 :op :static :class "j2g.fixtures.FxJShapes" :name "tPrologueAnon" :sig []
                          :src "(FxJShapes/tPrologueAnon)" :result {:type "java.lang.String" :value "attr/pt"}}]}]
   ;; a functional interface whose method has two erased descriptors (KM's m(String), K's
   ;; m(Object)), which the frozen analysis refuses (doc/classes/JAVA-CONFORMANCE-SURVEY.md,
   ;; "As built: JC4c"): javac's results (the lambda's class declares m and its bridge)
   "test/j2g/fixtures/FxBackEnds.ae"
   ["FxBackEnds" {:cases (vec (map-indexed (fn [i [n v]] {:i (inc i) :op :static :class "j2g.fixtures.FxBackEnds" :name n :sig []
                                                          :src (str "(FxBackEnds/" n ")") :result {:type "java.lang.String" :value v}})
                                           [["tAtomicSub" "Named(b) true c"] ["tIntersection" "B true"] ["tLambdaBridge" "km 2"]
                                            ["tOwnPrivate" "secret7"] ["tThrowingLambda" "thrown 3"]]))}]})

(defn record []
  (let [files (sort (remove by-hand (filter #(str/ends-with? % ".ae") (map #(.getPath ^java.io.File %) (.listFiles (java.io.File. ^String fixtures-dir))))))
        nsname 'j2g.fixtures]
    (binding [*ns* (create-ns nsname)]
      (refer 'arbace.core)
      (doseq [f files] (load-file f)))
    (let [tops (for [f files
                     cf (read-forms f)
                     :when (and (seq? cf) (= 'do (first cf)))
                     dc (rest cf)
                     :when (and (seq? dc) (= 'defclass (first dc)))]
                 (name (second dc)))]
      (vec (for [cn tops
                 :let [^Class c (ns-resolve (the-ns nsname) (symbol cn))
                       ms (->> (.getDeclaredMethods c)
                               (filter (fn [^java.lang.reflect.Method m]
                                         (and (re-matches #"t[A-Z].*" (.getName m)) (zero? (.getParameterCount m))
                                              (java.lang.reflect.Modifier/isStatic (.getModifiers m))
                                              (java.lang.reflect.Modifier/isPublic (.getModifiers m)))))
                               (sort-by #(.getName ^java.lang.reflect.Method %)))]
                 :when (seq ms)]
             [cn {:cases (vec (map-indexed
                                (fn [i ^java.lang.reflect.Method m]
                                  (let [base {:i (inc i) :op :static :class (str nsname "." cn) :name (.getName m) :sig []
                                              :src (str "(" cn "/" (.getName m) ")")}]
                                    (try (assoc base :result (observe (.invoke m nil (object-array 0))))
                                         (catch java.lang.reflect.InvocationTargetException e
                                           (assoc base :throws (chain (.getCause e)))))))
                                ms))}])))))

(let [out (or (first *command-line-args*) "test/j2g/fixtures.edn")
      rs (into (record) (vals (sort by-hand)))]
  (spit out (str ";; The recorded results of test/j2g/fixtures/*.ae (test/j2g/record_fixtures.ae,\n"
                 ";; bin/j2g-check --record-fixtures), on a JVM Arbace.\n"
                 "[\n" (apply str (for [r rs] (str (pr-str r) "\n"))) "]\n"))
  (println "recorded" (count rs) "classes," (reduce + (map #(count (:cases (second %))) rs)) "cases into" out)
  (shutdown-agents)
  (System/exit 0))

(ns j2g.edge-verdict
  "The verdict of bin/j2g-edge trace (test/j2g/edge_trace.ae), apart from the JFR classes so that
  it runs on any executable (test/gate/edge-verdict-test.bash; audit 041, finding 4).")

(defn failed?
  "Whether the trace fails: some traced call was made by j2g itself, or the recording holds no
  jdk.MethodTrace event at all (a filter JFR ignored, a renamed method, a dropped option: the
  trace then proves nothing). total: the events read; bad: the calls by j2g itself (a count)."
  [total bad]
  (or (zero? total) (pos? bad)))

(defn message
  "The line to print when the trace fails for want of events (nil otherwise)."
  [total]
  (when (zero? total)
    "the recording holds no traced call at all: the method trace did not record (its filter?), so it proves nothing"))

;; Round 54's fixture: a Cloneable class with its own clone (super.clone(), then a field reset), as
;; java.util.LinkedList's: an interpreted subclass's DynSub_Copied clones through it.

(in-ns 'z)

(defclass ^:public Copied
  :implements [Cloneable]
  (field ^:public ^int n 0)
  (method ^:public clone :throws [CloneNotSupportedException] [this]
    (let [^Copied c (cast Copied (.clone super))]
      (set! (.-n c) 0)
      c)))

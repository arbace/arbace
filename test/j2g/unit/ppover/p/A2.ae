;; JCS122's fixture, the negative control: T2, in A2's package, extends S2 (package q, its public ppm) and declares
;; ppm, which overrides both A2's package-private one and S2's: one Go method cannot be both names, so the pair
;; (A2, S2) stays the check's error.

(in-ns 'p)

(import '(q S2))

(defclass ^:public A2
  (method ppm ^int [this] 1))

(defclass ^:public T2
  :extends S2
  (method ppm ^int [this] 3))

;; JCS122's fixture (Calendar.getSetStateFields against the test's Koyomi, t05451): A's package-private ppm is not
;; overridden by S's in package q (JVMS 5.4.5); B, in A's package, overrides it. A's callPpm dispatches among A's and
;; B's alone: on an S it is B's.

(in-ns 'p)

(defclass ^:public A
  (method ppm ^int [this] 1)
  (method ^:public callPpm ^int [this] (.ppm this)))

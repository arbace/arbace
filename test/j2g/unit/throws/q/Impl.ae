;; test/j2g/unit.ae's fixture (JCS240 (a), F27): a class whose constructor and method declare checked exceptions.

(in-ns 'q)

(defclass ^:public Impl
  :implements [Pinger]

  (constructor :throws [InterruptedException] ^:public [this])

  (method ^:public ping :throws [Exception] ^void [this])

  (method ^:public quiet ^void [this]))

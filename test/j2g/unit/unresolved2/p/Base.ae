;; test/j2g/unit.ae's fixture (queue 447): a class whose members name a class no world has, its
;; static field set by a member class (jtreg's TestHelper, whose members name ToolProvider, and
;; its TestResult counting testExitValue).

(in-ns 'p)

(import '(javax.nonesuch Gadget))

(defclass ^:public Base
  (field ^:public ^:static ^boolean isWindows false)

  (field ^:static ^int hits 0)

  (field ^:private ^Gadget gadget)

  (defclass ^:static Counter
    (method bump ^void [this]
      (set! hits 1))))

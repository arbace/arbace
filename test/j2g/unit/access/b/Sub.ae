;; B2's accessor fixture: Sub inherits Base's protected statics; its nested class In calls them (javac's accessor
;; access$NNN in Sub, its instruction an invokestatic of Sub.trace, which the JVM resolves to Base.trace), and Sub
;; itself calls one directly (the control: no accessor).

(in-ns 'b)

(import '(a Base))

(defclass ^:public Sub :extends Base
  (method ^:public direct ^int [this] (Base/shown))
  (defclass ^:public ^:static In
    (method ^:public viaOuter ^int [this] (Base/trace 41))))

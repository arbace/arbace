;; B2's accessor fixture: a protected static method of a superclass in another package (as
;; com.sun.security.sasl.util.AbstractSaslImpl's traceOutput), written as repr/java writes the forms.

(in-ns 'a)

(defclass ^:public Base
  (method ^:protected ^:static trace ^int [^int x] (+ x 1))
  (method ^:protected ^:static ^:final shown ^int [] 2))

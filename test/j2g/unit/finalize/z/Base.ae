;; The review's risk (round 52, 2026-11-18): Base has a subclass (Sub), so it is no leaf and its this is
;; Base_I in Go; Shape's calls of finalize() on an interface-typed and a class-typed parameter.

(in-ns 'z)

(defclass ^:public ^:interface Shape)

(defclass ^:public Base
  (method ^:public fin :throws [Throwable] ^void [this] (.finalize this))
  (method ^:public onShape :throws [Throwable] ^void [this ^Shape s] (.finalize s))
  (method ^:public onPlain :throws [Throwable] ^void [this ^Plain p] (.finalize p)))

(defclass ^:public Sub
  :extends Base)

;; The review's risk (round 52, 2026-11-18): Abs is abstract, so its this is a class interface (Abs_I) in Go,
;; and its call of this.finalize() is Object's on an interface-typed receiver.

(in-ns 'z)

(defclass ^:public ^:abstract Abs
  (method ^:public fin :throws [Throwable] ^void [this] (.finalize this)))

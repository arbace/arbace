;; AT10's fixture (h-java-aot-triage, 2026-11-17): Plain declares no finalize, so its call of this.finalize() is
;; Object's (ProtectedAccess_3's C.this.finalize(), t06387).

(in-ns 'z)

(defclass ^:public Plain
  (method ^:public fin :throws [Throwable] ^void [this] (.finalize this))
  (method ^:public hash ^int [this] (.hashCode this)))

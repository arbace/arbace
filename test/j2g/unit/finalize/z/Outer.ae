;; Queue 517's fixture (ProtectedAccess_3, t06387): an anonymous class's Outer.this.finalize(), Outer declaring none: the
;; call's owner is Outer (the receiver's type), its method Object's.

(in-ns 'z)

(defclass ^:public Outer
  (constructor [this]
    (anon Object []
      (method ^:public finalize :throws [Throwable] ^void [this]
        (.finalize Outer/this)))))

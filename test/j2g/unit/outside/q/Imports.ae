;; test/j2g/unit.ae's fixture (A8c): two files of one package importing two classes of one simple name (Ghidra's
;; ghidra.util: DateUtils java.util.function.Predicate, AddressRangeIterators commons-collections4's); the
;; namespace's last import is Watched.ae's, this file's lambda is its own import's (java.util.function.Supplier).

(in-ns 'q)

(import '(java.util.function Supplier))

(defclass ^:public Imports
  (method ^:public ^:static ^Object take [^Supplier s] (.get s))

  (method ^:public ^:static ^Object give [] (Imports/take (lambda Supplier ^Object [] "given"))))

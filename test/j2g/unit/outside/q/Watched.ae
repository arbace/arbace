;; test/j2g/unit.ae's fixture (A8c): the other file of Imports.ae's pair, importing a class of the same simple
;; name, q.other.Supplier, read after Imports.ae: the namespace's import of Supplier is this file's.

(in-ns 'q)

(import '(q.other Supplier))

(defclass ^:public Watched
  (method ^:public ^:static ^String name [^Supplier s] (.name s)))

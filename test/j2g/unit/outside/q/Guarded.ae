;; test/j2g/unit.ae's fixture (A8c): java.base's API that neither the world nor the edge has (log4j's use of
;; java.lang.SecurityManager, Ghidra's of java.lang.foreign's FunctionDescriptor), and a java.base interface the
;; edge holds without its generics (Thread.UncaughtExceptionHandler, as Ghidra's SwingExceptionHandler).

(in-ns 'q)

(import '(java.lang.foreign FunctionDescriptor MemoryLayout))

(defclass ^:public Guarded
  (field ^:private ^SecurityManager manager)

  (method ^:public ^:static ^String name [] "guarded")

  (method ^:public ^:static ^boolean secured [] (some? (System/getSecurityManager)))

  (method ^:public ^:static ^Object descriptor [^MemoryLayout/1 layouts] (FunctionDescriptor/ofVoid layouts)))

(defclass ^:public Watcher
  :extends SecurityManager
  (constructor ^:public [this]))

(defclass ^:public Handler
  :implements [java.lang.Thread$UncaughtExceptionHandler]
  (constructor ^:public [this])
  (method ^:public uncaughtException ^void [this ^Thread t ^Throwable e] nil))

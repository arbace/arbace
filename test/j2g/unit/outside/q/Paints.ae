;; test/j2g/unit.ae's fixture (A8c): the world's java.awt.Color (jrt's variant, which cut Paint and the ColorSpace
;; members) completed from the platform's class: a Color where java.awt.Paint is asked (Graphics2D.setPaint, as
;; Ghidra's docking code), a call of a cut member (getComponents(ColorSpace, float[]), as Ghidra's GColor) and a
;; subclass overriding one.

(in-ns 'q)

(import '(java.awt Color Graphics2D Paint) '(java.awt.color ColorSpace))

(defclass ^:public Paints
  (method ^:public ^:static ^String name [] "paints")

  (method ^:public ^:static ^void fill [^Graphics2D g] (.setPaint g Color/RED))

  (method ^:public ^:static ^Paint paint [] Color/BLUE)

  (method ^:public ^:static ^float/1 comps [^Color c ^ColorSpace cs] (.getComponents c cs nil)))

(defclass ^:public Tint
  :extends Color
  (constructor ^:public [this ^int rgb]
    (super. rgb))
  (method ^:public getComponents ^float/1 [this ^ColorSpace cs ^float/1 a] a))

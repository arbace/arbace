;; test/j2g/unit.ae's fixture (A8): a class implementing an interface outside the world.

(in-ns 'q)

(defclass ^:public Listener
  :implements [java.beans.PropertyChangeListener]
  (constructor ^:public [this])
  (method ^:public propertyChange ^void [this ^java.beans.PropertyChangeEvent e] nil)
  (method ^:public ^:static ^String name [] "listener")
  ;; a world method whose parameter is the outside interface, called with a world object: no stub
  (method ^:public ^:static ^void wire [^Events e] (.listen e (Listener.))))

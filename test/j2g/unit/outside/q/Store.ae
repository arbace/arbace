;; test/j2g/unit.ae's fixture (A8): a field of java.sql's javax.sql.DataSource and a method of java.desktop's
;; java.awt.Desktop (as Ghidra's FileUtilities), neither run.

(in-ns 'q)

(defclass ^:public Store
  (field ^:private ^javax.sql.DataSource source)

  (method ^:public ^:static ^String kind [] "store")

  (method ^:public connect ^Object [this] (.getConnection source))

  (method ^:public ^:static ^boolean browse []
    (.isSupported (java.awt.Desktop/getDesktop) java.awt.Desktop$Action/BROWSE)))

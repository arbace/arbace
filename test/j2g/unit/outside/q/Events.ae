;; test/j2g/unit.ae's fixture (A8): a class whose members and code name java.desktop's java.beans, a module
;; outside the world (as log4j-core's LoggerContext): with the platform's declarations it analyzes, and the
;; operations on PropertyChangeEvent are J2g_Missing; describe() names none of them.

(in-ns 'q)

(import '(java.beans PropertyChangeEvent PropertyChangeListener))

(defclass ^:public Events
  (field ^:private ^PropertyChangeListener listener)

  (method ^:public ^:static ^String describe [] "events")

  (method ^:public listen ^void [this ^PropertyChangeListener l] (set! listener l))

  (method ^:public fire ^void [this ^Object old ^Object neu]
    (let [^PropertyChangeEvent e (PropertyChangeEvent. this "config" old neu)]
      (when (some? listener)
        (.propertyChange listener e)))))

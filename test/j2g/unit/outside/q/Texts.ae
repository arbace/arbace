;; test/j2g/unit.ae's fixture (A8b): a class naming a binary-only jar's classes (org.example:toyext:1.0, on
;; javac's class path alone, as jdom2, commons-io, OSGi and jspecify are Ghidra's and log4j's): a static
;; call, a constant, its checked exception caught, its interface as a parameter and its run-time annotation.

(in-ns 'q)

(import '(org.example.toyext ToyText ToyException ToySource Marker))

(defclass ^:public ^{Marker {value "texts"}} Texts
  (method ^:public ^:static ^String plain [^String s] s)

  (method ^:public ^:static ^String fancy [^String s] (ToyText/upper s))

  (method ^:public ^:static ^String library [] ToyText/NAME)

  (method ^:public ^:static ^String readOr [^ToySource src ^String dflt]
    (try (.read src)
         (catch ToyException e dflt))))

;; Queue 399's fixture (review 1119, item 4): the forwarding method's fallback as arbace/genclass.ae's generate-class
;; writes it for a default inherited from a superinterface (the :implements interface's super, Sub.super.hello(),
;; as its form over java.util.List says (.forEach java.util.List/super p0)), which j2g must translate to the
;; declaring interface's function (Hello's).

(in-ns 'g)

(defclass ^{:public true :arbace/gen-class true} GenSub
  :implements [g.Sub]
  (field ^{:private true :static true :final true :tag Object} hello__var)
  (static-initializer (set! hello__var nil))
  (constructor ^:public [this] (super.))
  (method ^:public hello ^Object [this] (return (.hello g.Sub/super))))

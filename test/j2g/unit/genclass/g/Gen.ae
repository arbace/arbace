;; Queue 399's fixture: a class shaped as arbace/genclass.ae's generate-class writes it for an AOT program
;; (:arbace/gen-class, a private static field per method name), its method of the interface's default method
;; falling back on Greeter.super's (the forwarding to the field's fn left out: the unit translates the fallback
;; alone, without the world a static field's read needs).

(in-ns 'g)

(defclass ^{:public true :arbace/gen-class true} Gen
  :implements [g.Greeter]
  (field ^{:private true :static true :final true :tag Object} greet__var)
  (field ^{:private true :static true :final true :tag Object} who__var)
  (static-initializer (set! greet__var nil) (set! who__var nil))
  (constructor ^:public [this] (super.))
  (method ^:public greet ^Object [this] (return (.greet g.Greeter/super)))
  (method ^:public who ^Object [this] (return who__var)))

;; test/j2g/unit.ae's fixture (n-j2g-mxsig): jdk26u's javax.management.MXBean as jdk/forms has it (the unit tests' world
;; is the edge alone, without the JDK's forms).

(in-ns 'javax.management)

(import '(java.lang.annotation Documented ElementType Retention RetentionPolicy Target))

(defclass ^:public ^{Documented true} ^{Retention RetentionPolicy/RUNTIME} ^{Target [ElementType/TYPE]} ^:annotation MXBean
  (method value :default true ^boolean [this]))

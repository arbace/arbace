;; test/j2g/unit.ae's fixture (n-java-f13): a class JMX maps as a composite (a CompositeDataView), a generic getter beside
;; a plain one, as com.sun.management.GcInfo's getMemoryUsageBeforeGc and getId.

(in-ns 'q)

(import '(javax.management.openmbean CompositeDataView))

(defclass ^:public Info
  :implements [CompositeDataView]
  (method ^:public getUsages ^{:tag (Box String)} [this] nil)
  (method ^:public getId ^long [this] 0))

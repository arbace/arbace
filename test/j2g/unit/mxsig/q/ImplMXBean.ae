;; test/j2g/unit.ae's fixture (n-j2g-mxsig): a class whose name ends in MXBean is no MXBean interface.

(in-ns 'q)

(defclass ^:public ImplMXBean
  :implements [FooMXBean]
  (method ^:public getArgs ^{:tag (Box String)} [this] nil)
  (method ^:public getProps ^{:tag (Box (Box String))} [this] nil)
  (method ^:public getUptime ^long [this] 0))

;; test/j2g/unit.ae's fixture (n-j2g-mxsig): an MXBean interface by its name, a generic getter beside a plain one, as
;; java.lang.management.RuntimeMXBean's getInputArguments and getUptime.

(in-ns 'q)

(defclass ^:public ^:interface FooMXBean
  (method ^:public getArgs ^{:tag (Box String)} [this])
  (method ^:public getProps ^{:tag (Box (Box String))} [this])
  (method ^:public getUptime ^long [this]))

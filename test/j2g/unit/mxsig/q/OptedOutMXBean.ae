;; test/j2g/unit.ae's fixture (n-j2g-mxsig): a name ending in MXBean but @MXBean(false), which JMX's rule takes as no
;; MXBean interface.

(in-ns 'q)

(import '(javax.management MXBean))

(defclass ^:public ^{MXBean false} ^:interface OptedOutMXBean
  (method ^:public getArgs ^{:tag (Box String)} [this]))

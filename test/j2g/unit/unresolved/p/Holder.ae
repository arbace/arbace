;; test/j2g/unit.ae's fixture (JCS69 (b)): a class whose members name a class no world has.

(in-ns 'p)

(import '(javax.nonesuch Gadget))

(defclass ^:public Holder
  (field ^:static ^:final ^long DELAY 5)

  (field ^:static ^long started (System/nanoTime))

  (field ^:private ^Gadget gadget)

  (method ^:public ^long delay [] DELAY))

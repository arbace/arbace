;; The classes initialized at start (Futamura F4, doc/FUTAMURA-SURVEY.md, "F4 and F2's j2g fixes
;; as built"): writes arbace/j2g/start.ae, the runtime's classes (packages arbace/lang and
;; arbace/jrt) that Arbace's Go program initializes before any user code, in the order it
;; initializes them, from the program's own trace (ARBACE_TRACE_INIT: jrt prints "init: NAME" as
;; each class's initialization starts, NAME its Go name). The program is run three ways with a
;; user program that does nothing (-e nil, a script, the REPL on its standard input), and the
;; list is the classes all three initialize, in the order of the first. j2g omits their
;; initialization guards in compiled code, and the first compiled code initializes those not
;; initialized yet (jrt.StartCheck).
;;
;; Usage (in the checkout), on a build of the checkout's runtime:
;;   EXE test/j2g/start_classes.ae EXE          prints the list, and whether arbace/j2g/start.ae has it
;;   EXE test/j2g/start_classes.ae EXE --write  rewrites arbace/j2g/start.ae
;; then the program built again (bin/arbace-go --build): the list changes j2g's output.
(ns start-classes
  (:require [arbace.string :as str]
            [arbace.java.shell :as sh]))

(defn- started
  "The Go names of the runtime's classes one run of exe (args, standard input in) initializes,
  in order."
  [exe in & args]
  (let [r (apply sh/sh exe (concat args [:in in :env (assoc (into {} (System/getenv)) "ARBACE_TRACE_INIT" "1")]))]
    (when-not (zero? (:exit r))
      (throw (ex-info (str "start-classes: the run of " (pr-str args) " failed") r)))
    (distinct (for [l (str/split-lines (:err r))
                    :when (str/starts-with? l "init: ")
                    :let [n (subs l 6)]
                    :when (or (str/starts-with? n "arbace/lang.") (str/starts-with? n "arbace/jrt."))]
                n))))

(let [[exe & opts] *command-line-args*
      _ (when-not exe (throw (ex-info "usage: test/j2g/start_classes.ae EXE [--write]" {})))
      tmp (java.io.File/createTempFile "start-classes" ".ae")
      _ (spit tmp "nil\n")
      runs [(started exe "" "-e" "nil")
            (started exe "" (str tmp))
            (started exe "nil\n")]
      _ (.delete tmp)
      all (map set (rest runs))
      classes (filter (fn [n] (every? #(contains? % n) all)) (first runs))
      out "arbace/j2g/start.ae"
      text (str "(ns arbace.j2g.start\n"
                "  \"The classes initialized at start (Futamura F4, doc/FUTAMURA-SURVEY.md, \\\"F4 and F2's j2g\n"
                "  fixes as built\\\"): the runtime's classes that the program initializes before any user code,\n"
                "  by their Go names (package path, a dot, the Go type name), in the order it initializes them.\n"
                "  In compiled code (arbace.c2j's classes) j2g omits their initialization guard: their static\n"
                "  methods are called through guard-free entries (C_m_NoInit), their statics read and written\n"
                "  unguarded. The first compiled code initializes those whose initialization has not started\n"
                "  yet, in this order, and stops the program when one is still not started (jrt.StartCheck).\n"
                "  Generated by test/j2g/start_classes.ae from the program's ARBACE_TRACE_INIT runs; do not\n"
                "  edit.\")\n\n"
                "(def classes\n  \"The Go names of the classes initialized at start, in order.\"\n  ["
                (str/join "\n   " (map pr-str classes))
                "])\n")]
  (println (count classes) "classes initialized at start (in all of" (count runs) "runs; the first run:"
           (count (first runs)) ")")
  (if (some #{"--write"} opts)
    (do (spit out text) (println "written:" out))
    (let [cur (try (slurp out) (catch Throwable _ ""))]
      (println (if (= cur text) (str out ": the same") (str out ": differs (--write rewrites it)")))
      (doseq [c classes] (println " " c)))))

;; bin/records-check's registry beside test/reap/cells.edn (GD4: doc/GATE-DIET-SURVEY.md §5.2, GDS15 (a), "As built: GD4"). The
;; pairs are cells.edn's :c-known sources with a :results; here what they do not say. Read with the Clojure reader.
;;   :also-known  RESULTS -> the other known files its check reads (a :known row listed in one of them is accounted for)
;;   :pairs       pairs no cell names: {:name :known :results :sections [...] :id-sep}
{:also-known
 {;; C's tree check (arbace.repr.c.parsecheck) takes the token level's known files: a file whose tokens are known ("pp-known")
  "test/repr/c/parse-check-results.edn" ["test/repr/c/pp-check-known.edn"]
  ;; C's annotations read the token level's known file too (bin/gate's :c-records-annot)
  "test/repr/c/annot-results.edn" ["test/repr/c/pp-check-known.edn"]}
 ;;   :exclude-corpora  RESULTS -> corpora whose rows are not judged here: C's tree check's mutants (JN8.3's, made in .tmp by
 ;;                     arbace.repr.c.parsecheck/mutants), whose :known is their original file's entry through a list no record holds
 :exclude-corpora {"test/repr/c/parse-check-results.edn" ["mutants"]}
 :pairs []}

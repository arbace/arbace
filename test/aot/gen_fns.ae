;; Writes arbace/lang/go/CompilerAOTFn.ae (standalone S6, doc/STANDALONE-NOTES.md, SA141): the
;; run-time classes of compiled fns. A compiled fn's code is a class implementing only the
;; interfaces Compiler$AOTF<n> (an arity of n fixed parameters) and Compiler$AOTR<k> (the
;; variadic arity, k required), so that a2g gives it no forwarders of AFunction's methods
;; (A2G-SPEC §5.4); the fn itself is a Compiler$AOTFn (or Compiler$AOTRestFn) holding that
;; object and the fn's class, which IFn's invoke methods call.
;;
;; Usage: target/arbace-go/amd64/arbace test/aot/gen_fns.ae > arbace/lang/go/CompilerAOTFn.ae
(def n 20)
(defn ps [k] (vec (for [i (range k)] (symbol (str "a" i)))))
(println ";; Generated by test/aot/gen_fns.ae (standalone S6, doc/STANDALONE-NOTES.md, SA141): the run-time
;; classes of compiled fns. Go-build variant of arbace.lang.Compiler (A2G-SPEC §4.6): read by a2g
;; only. Regenerate rather than edit.
(in-ns 'arbace.lang)
")
(defn pr-form [f] (binding [*print-meta* true] (prn f)) (println))
(pr-form
  (list 'a2g/variant 'Compiler
    (concat (list 'a2g/add)
      (for [k (range (inc n))]
        (list 'defclass (with-meta (symbol (str "AOTF" k)) {:public true :static true :interface true})
              (list 'method (with-meta 'invoke {:public true :abstract true}) (vec (concat '[this self] (ps k))))))
      (for [k (range (inc n))]
        (list 'defclass (with-meta (symbol (str "AOTR" k)) {:public true :static true :interface true})
              (list 'method (with-meta 'doInvoke {:public true :abstract true}) (vec (concat '[this self] (ps k) '[rest])))))
      [(concat
         (list 'defclass (with-meta 'AOTFn {:public true :static true :final true})
               :extends 'AFunction
               (list 'field (with-meta 'body {:public true :final true}))
               (list 'field (with-meta 'a2g$class {:public true :final true :tag 'Class}))
               (list 'field (with-meta '__meta {:final true :tag 'IPersistentMap}))
               (list 'constructor (with-meta '[this b ^Class c ^IPersistentMap m] {:public true})
                     '(super.) '(set! (.-body this) b) '(set! (.-a2g$class this) c) '(set! (.-__meta this) m))
               (list 'method (with-meta 'meta {:public true}) (with-meta '[this] {:tag 'IPersistentMap}) '__meta)
               (list 'method (with-meta 'withMeta {:public true}) (with-meta '[this ^IPersistentMap m] {:tag 'IObj})
                     '(Compiler$AOTFn. body a2g$class m)))
         (for [k (range (inc n))]
           (list 'method (with-meta 'invoke {:public true}) (vec (cons 'this (ps k)))
                 (list 'if-instance [(with-meta 'f {:tag (symbol (str "Compiler$AOTF" k))}) 'body]
                       (list* '.invoke 'f 'this (ps k))
                       (list '.throwArity 'this (list 'unchecked-int k))))))
       (concat
         (list 'defclass (with-meta 'AOTRestFn {:public true :static true :final true})
               :extends 'RestFn
               (list 'field (with-meta 'body {:public true :final true}))
               (list 'field (with-meta 'a2g$class {:public true :final true :tag 'Class}))
               (list 'field (with-meta '__meta {:final true :tag 'IPersistentMap}))
               (list 'field (with-meta 'required {:final true :tag 'int}))
               (list 'constructor (with-meta '[this b ^Class c ^IPersistentMap m ^int r] {:public true})
                     '(super.) '(set! (.-body this) b) '(set! (.-a2g$class this) c) '(set! (.-__meta this) m)
                     '(set! (.-required this) r))
               (list 'method (with-meta 'getRequiredArity {:public true}) (with-meta '[this] {:tag 'int}) 'required)
               (list 'method (with-meta 'meta {:public true}) (with-meta '[this] {:tag 'IPersistentMap}) '__meta)
               (list 'method (with-meta 'withMeta {:public true}) (with-meta '[this ^IPersistentMap m] {:tag 'IObj})
                     '(Compiler$AOTRestFn. body a2g$class m required)))
         (for [k (range (inc n))]
           (list 'method (with-meta 'doInvoke {:protected true}) (vec (concat ['this] (ps k) '[rest]))
                 (list 'if-instance [(with-meta 'r {:tag (symbol (str "Compiler$AOTR" k))}) 'body]
                       (list* '.doInvoke 'r 'this (concat (ps k) '[rest]))
                       (list '.throwArity 'this (list 'unchecked-int -1)))))
         ;; a fixed arity of a variadic fn: the body's, else RestFn's (the variadic arity)
         (for [k (range (inc n))]
           (list 'method (with-meta 'invoke {:public true}) (vec (cons 'this (ps k)))
                 (list 'if-instance [(with-meta 'f {:tag (symbol (str "Compiler$AOTF" k))}) 'body]
                       (list* '.invoke 'f 'this (ps k))
                       (list* '.invoke 'super (ps k))))))])))

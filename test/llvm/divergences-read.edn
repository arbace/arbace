;; repr/llvm's read level's classes for bin/reap (the REAP row of LLVM; test/reap/cells.edn's :llvm :read): every row of
;; test/llvm/check-verify-*.edn that does not pass (verify's verdict, first message or whole stderr is not opt -passes=verify's: the rules
;; of arbace/repr/llvm/verify.ae not yet ported, doc/cpp/LLVM.md section 6.2) or is a known probe (test/llvm/probes-known.tsv), in goi's
;; format: a row is in the first class whose :match finds its "RESULT REASON" (a mutant's reason begins with its kind, the name's
;; second last field; a known probe's with its class). The round trip's rows (the forms, objects and bitcode of 282 modules) all pass.
;; Read with the Clojure reader.
[
 {:id :phi-messages
  :title "PHI nodes: the messages after the first"
  :kind :deferred
  :why "a mutant that moves a PHI's incoming blocks: verify prints the Verifier's first message as opt does but not every message opt prints after it (the whole stderr differs in 13 mutants; one prints another PHI rule's message first)"
  :decided "LLS17 (a); LLM-CROP-SURVEY, \"What changed since the survey\""
  :match [#"^(stderr|message|verdict) phiblock: "]}
 {:id :intrinsic-rules
  :title "intrinsics: a fuller table"
  :kind :deferred
  :why "a renamed, redeclared or re-argued intrinsic: verify has a table of the common intrinsics, not Intrinsics.td's whole (the overload types' messages, llvm.is.fpclass's mask, llvm.ptrmask, llvm.coro.begin's id): the first message or the whole stderr differs"
  :decided "LLS17 (a); doc/cpp/LLVM.md section 6.2"
  :match [#"^(stderr|message|verdict) (intr-rename|intr-decl|intrinsic|intr-arg): "]}
 {:id :debug-info-rules
  :title "debug info: a few DI and metadata attachment rules"
  :kind :deferred
  :why "a retargeted DILocation scope, a DISubprogram attached to two functions, a metadata attachment: a few rules of the Verifier's debug-info part (and the module-level strip of an invalid version) are not ported, so verify misses the verdict or the whole stderr differs"
  :decided "LLS17 (a); doc/cpp/LLVM.md section 6.2"
  :match [#"^(stderr|message|verdict) (di-retarget|di-attach|md-attach): "]}
 {:id :attribute-rules
  :title "attributes: placement, types and combinations"
  :kind :deferred
  :why "an attribute on the wrong place, of an incompatible type, duplicated (swifterror, preallocated) or paired with a linkage rule (jumptable needs unnamed_addr): the attribute rules not yet ported, so verify's first message or whole stderr differs, or it accepts the module"
  :decided "LLS17 (a); doc/cpp/LLVM.md section 6.2"
  :match [#"^(stderr|message|verdict) attr-(place|type|dup|pair): "]}
 {:id :call-rules
  :title "calls: musttail and operand bundles"
  :kind :deferred
  :why "a musttail call or a convergencectrl bundle altered: the whole stderr of opt carries messages after the first that verify does not print"
  :decided "LLS17 (a); doc/cpp/LLVM.md section 6.2"
  :match [#"^(stderr|message|verdict) (musttail|bundle): "]}
 {:id :probe-label
  :title "a label defined twice"
  :kind :deferred
  :why "LLParser appends the second block's instructions to the first when a label is defined twice; the reader makes a second block"
  :decided "LLM-CROP-SURVEY, probes (test/llvm/probes-known.tsv)"
  :match [#"^known label: "]}
 {:id :probe-reader
  :title "the reader and LLParser disagree on a text"
  :kind :deferred
  :why "the reader takes text LLParser rejects (initializes(), alloc_size without its argument, memory(bogus: read)) or refuses text opt takes (a numbered calling convention cc N, a vararg musttail call): the probes' known file"
  :decided "LLM-CROP-SURVEY, probes (test/llvm/probes-known.tsv)"
  :match [#"^known reader: "]}
 {:id :probe-pointer
  :title "an address in opt's message"
  :kind :design
  :why "opt prints the address of a metadata-as-value operand (metadata <0x7f..>), different at each run: no print can equal it"
  :decided "LLM-CROP-SURVEY, probes (test/llvm/probes-known.tsv)"
  :match [#"^known pointer: "]}
 {:id :probe-metadata
  :title "metadata numbering and uniquing"
  :kind :deferred
  :why "an inline node of a module flag takes a number from the slot tracker, equal nodes are one for LLParser (a different number and distinct in the print): the forms do not number or merge them"
  :decided "LLM-CROP-SURVEY, probes (test/llvm/probes-known.tsv)"
  :match [#"^known (numbering|uniquing): "]}
 {:id :llvmtest-rules
  :title "llvm/test's rejections: the rules not ported"
  :kind :deferred
  :why "verify's verdict is not opt's on these llvm/test modules (test/llvm/check-verify-llvmtest-linux-amd64.edn): LLParser's or the Verifier's rules arbace/repr/llvm/verify.ae does not have yet, most of them a target's intrinsics (AMDGPU's, VP, gc.statepoint and gc.relocate), a few the parser's (DIAssignID's operand, inline asm constraints); doc/llvm/LLVM-CROP-SURVEY.md, \"As built: LL6\""
  :decided "LL4's corpus loop (\"Decided (2026-11-05, the user: after LL1)\": the full loop for Assembler/ and Verifier/, acceptance for the target directories)"
  :tests ["Assembler-invalid-inline-constraint" "DebugInfo-Generic-assignment-tracking-parse-and-verify-operands" "Verifier-AMDGPU-alloca"
          "Verifier-AMDGPU-intrinsic-amdgcn-call-whole-wave" "Verifier-AMDGPU-intrinsic-load-to-lds" "Verifier-AMDGPU-intrinsic-prefetch"
          "Verifier-AMDGPU-intrinsics-av" "Verifier-AMDGPU-llvm.amdgcn.cooperative.atomic" "Verifier-AMDGPU-mfma-scale"
          "Verifier-dilocation-in-wrong-place" "Verifier-gc_none_token" "Verifier-gc_relocate_out_of_bounds" "Verifier-invalid-vp-intrinsics"
          "Verifier-logical-pointer-required-failure" "Assembler-autoupgrade-lifetime-intrinsics-invalid.ll-test1"]}
 {:id :llvmtest-messages
  :title "llvm/test's rejections: the same verdict, another message"
  :kind :deferred
  :why "verify rejects the module as opt does, but its first message or the rest of its stderr is not opt's: LLParser reports another error first (its parse order: an expected token, a redefinition found before the error the test is about) or the Verifier prints another culprit or more lines"
  :decided "LL4's corpus loop (as :llvmtest-rules)"
  :tests ["Assembler-2007-08-06-AliasInvalid" "Assembler-align-param-attr-error1" "Assembler-alloca-addrspace-parse-error-1"
          "Assembler-autoupgrade-invalid-name-mangling" "Assembler-captures-errors" "Assembler-extractvalue-no-idx"
          "Assembler-initializes-attribute-invalid" "Assembler-inline-asm-constraint-error" "Assembler-invalid-call-float-literal"
          "Assembler-invalid-fp80hex" "Assembler-invalid-gep-missing-explicit-type" "Assembler-invalid-load-missing-explicit-type"
          "Assembler-invalid-opaque-ptr-addrspace" "Assembler-memory-attribute-errors" "Assembler-phi-first-class-type"
          "Assembler-target-type-properties" "Assembler-thinlto-bad-summary3" "Bitcode-amdgpu-wmma-drop-ab-mods-upgrade-err"
          "Bitcode-blockaddress-addrspace" "CodeGen-NVPTX-cp-async-bulk-tensor-g2s-invalid" "Verifier-AMDGPU-intrinsic-amdgpu-cs-chain"
          "Verifier-AMDGPU-intrinsic-immarg" "Verifier-alias-scope-metadata" "Verifier-amdgpu-cc" "Verifier-bitcast-address-space-through-gep-2"
          "Verifier-call-to-non-callable-functions" "Verifier-callbr" "Verifier-convergencectrl-invalid" "Verifier-deoptimize-intrinsic"
          "Verifier-element-wise-atomic-memory-intrinsics" "Verifier-fp-intrinsics" "Verifier-frameescape" "Verifier-gc_relocate_addrspace"
          "Verifier-gc_relocate_return" "Verifier-invalid-cleanuppad-chain" "Verifier-invalid-statepoint" "Verifier-invoke" "Verifier-issue176674"
          "Verifier-issue176674_2" "Verifier-matrix-intrinsics" "Verifier-operand-bundles" "Verifier-preallocated-invalid"
          "Verifier-stepvector-intrinsic" "Verifier-swifterror" "Verifier-tbaa" "Verifier-token2" "Verifier-x86_amx9"]}
]

;; llvmi's negative controls (GTS81 (a); bin/llvmi check): each subject's run (ci's, or its AOT build's) judged as the reference
;; module is, by llvmi's own judge (arbace.llvm.check): by the reference's own verdict when it has one (own-result: llvm/test's lit
;; RUN and CHECK lines, gcc's torture harness's exit 0), else against its recorded lli run (run-result), must not pass; a pair whose
;; subject the run does not hold is not judged. The first two cross C programs (lli's records), the third an ExecutionEngine
;; module against another's CHECK line, the fourth a program that exits 3 against a torture program's exit 0. Read with the
;; Clojure reader.
[
 {:subject "c-O0.synth.decl-auto" :reference "c-O0.synth.decl-alignment"}
 {:subject "c-O2.synth.decl-bitfields" :reference "c-O2.synth.decl-auto"}
 {:subject "ee.MCJIT.hello" :reference "ee.MCJIT.fpbitcast"}
 {:subject "c-O0.run.ptr-sub-unsigned" :reference "tx-O0.20000121-1"}
 ;; D358-5 (a): an abort judged against g++'s record (gxx-reference): ctor-throw's run against thread-throw's g++ run, the same status
 ;; (134) and stdout (empty), another stderr: must fail on the stderr
 {:subject "cpp.runtime.ctor-throw" :reference "cpp.runtime.thread-throw"}
 ;; n-llvm-indep (LLS49 (c)): the own outcomes. synth-c23's :expect (a synth program's run against another's .expect: both exit 0,
 ;; another stdout), test/c/run's self-check verdict (an exit 0 program against ptr-sub-unsigned's `exit 3`), and
 ;; test/llvm/selfref-derived.edn's (io's run against threads' derived stdout: both exit 0; ctor-throw's against uncaught's: both 134,
 ;; another stdout and stderr; the first two pairs above now cross own verdicts too)
 {:subject "c-O0.synth.expr-arithmetic" :reference "c-O0.synth.expr-cast"}
 {:subject "c-O2.run.ptr-sub-narrow" :reference "c-O2.run.ptr-sub-unsigned"}
 {:subject "cpp.samples.io" :reference "cpp.runtime.threads"}
 {:subject "cpp.runtime.uncaught" :reference "cpp.runtime.ctor-throw"}
 ;; llvm-judge-1120: an outcome worked out from the module's IR (selfref-derived.edn's :from :ir): pp-define's run (exit 0, 189 bytes)
 ;; against pp-has-attribute's reviewed stdout (exit 0, 96 bytes): must fail on the stdout
 {:subject "c-O2.synth.pp-define" :reference "c-O2.synth.pp-has-attribute"}
]

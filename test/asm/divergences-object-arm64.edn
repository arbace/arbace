;; repr/asm's arm64 object check's classes (bin/repr-asm --arch arm64 object-check; doc/asm/ARM64-SURVEY.md, AR4): every file of
;; test/asm/object-results-arm64.edn whose object is not llvm-mc's byte for byte is in one of these. In goi's format. Read with the
;; Clojure reader.
[
 {:id :canonical
  :title "the same sections, symbols and relocations, another layout"
  :kind :deferred
  :why "the object's sections' bytes, symbols and relocations are llvm-mc's, the file's layout (section order, string table, padding) not"
  :decided "AR4 (AX4's class)"}
 {:id :unsupported-directive
  :title "a directive the object assembler does not take yet"
  :kind :deferred
  :why "the file holds a directive arbace.asm.arm64.obj does not assemble yet (named in the row): the build attributes' .aeabi_subsection and .aeabi_attribute (.ARM.attributes), .reloc, .macro, .single, .org"
  :decided "AR4"}
 {:id :unsupported-instruction
  :title "an instruction AR2's encoder refuses in the object's context"
  :kind :deferred
  :why "a symbolic immediate the encoder needs as a constant (a difference of labels folded at layout: `mov x0, #(b - a)`, `add w0, w1, #(end - start)`), an operand class not built (TEV's and POE2's `nB`), an FP constant without its `#`"
  :decided "AR4"}
 {:id :unsupported-fixup-kind
  :title "a fixup in an instruction class with no kind yet"
  :kind :deferred
  :why "the operand left to a fixup is in a class fixup-kind does not read (PAuth_LR's AUTIASPPC label: fixup_aarch64_pcrel_branch16)"
  :decided "AR4"}
 {:id :unsupported-relocation-specifier
  :title "a relocation specifier not written yet"
  :kind :deferred
  :why "the PAuth ABI's specifiers (:got_auth:, :got_auth_lo12:, @AUTH): R_AARCH64_AUTH_* not in the relocation table yet"
  :decided "AR4"}
 {:id :unsupported-syntax
  :title "a spelling the reader refuses"
  :kind :deferred
  :why "data directives' specifiers (`.word %pltpcrel(f)`, `.xword sym@AUTH(ia, 42)`) the object's reading of AR1's forms does not take"
  :decided "AR4"}
 {:id :unsupported-expression
  :title "an expression the object assembler does not evaluate yet"
  :kind :deferred
  :why "the expression's operator or specifier (`.xword var@DTPREL`) is not taken yet (named in the row)"
  :decided "AR4"}
 {:id :unsupported-literal-pool
  :title "literal pools (ldr x0, =imm)"
  :kind :deferred
  :why "the constant pool (AArch64TargetStreamer's ConstantPools, .ltorg and the section's end) is not emitted yet"
  :decided "AR4"}
 {:id :unsupported-cfi
  :title "a CFI directive not taken yet"
  :kind :deferred
  :why "the file holds a .cfi_* directive arbace.asm.obj does not take for AArch64 yet (.cfi_b_key_frame, .cfi_mte_tagged_frame)"
  :decided "AR4"}
 {:id :unsupported-debug-line
  :title ".loc and .file N (.debug_line)"
  :kind :deferred
  :why "the file holds DWARF line directives, whose .debug_line this slice does not write"
  :decided "AR4 (AX4's class)"}
 ;; the object verdict's (bin/repr-asm --arch arm64 object-verdict): an object run's CHECK line not judged, by cause
 {:id :decoder-text
  :title "a disassembly's text"
  :kind :deferred
  :why "the line states an instruction's text alone (llvm-objdump -d's mnemonic and operands, with a --mattr of its own): the decoder's, AR3 (arm64asm or LLVM's disassembler rebuilt); the line's bytes, when it states them, are judged"
  :decided "AR4"}
 {:id :view-llvm-readobj
  :title "a llvm-readobj view not built"
  :kind :deferred
  :why "the run pipes the object to llvm-readobj with another view than -r (-S, --symbols, --section-data, -h): Arbace's view of it not built yet"
  :decided "AR4"}
 {:id :view-llvm-readelf
  :title "a llvm-readelf view not built"
  :kind :deferred
  :why "the run's viewer is llvm-readelf (-s, -S, --hex-dump, --arch-specific): not built yet"
  :decided "AR4"}
 {:id :view-llvm-objdump
  :title "a llvm-objdump view not built"
  :kind :deferred
  :why "the run's viewer is llvm-objdump with another view than -d or -r (-t, -s, --macho): not built yet"
  :decided "AR4"}
 {:id :view-llvm-dwarfdump
  :title "llvm-dwarfdump's views"
  :kind :deferred
  :why "the run's viewer is llvm-dwarfdump (--debug-frame, -eh-frame): DWARF's printer not built"
  :decided "AR4"}
 {:id :no-viewer
  :title "a run whose object is checked by FileCheck directly"
  :kind :deferred
  :why "llvm-mc -filetype=obj's own diagnostics (warnings) piped to FileCheck: the object assembler's warnings are not written"
  :decided "AR4"}
 {:id :message
  :title "a refusal with another wording"
  :kind :deferred
  :why "an error test's object run (`not llvm-mc ... -filetype=obj`) refused by the object assembler, not with LLVM's fragment (the fixups' range and layout diagnostics, the directives' messages)"
  :decided "AR4 (AR2's :message)"}
 {:id :error-accepted
  :title "an error the object assembler does not find"
  :kind :deferred
  :why "an error test's object run states an error the object assembler does not give (a diagnostic after layout: error-location-post-layout's)"
  :decided "AR4"}
 {:id :filecheck-var
  :title "FileCheck's variables"
  :kind :deferred
  :why "the CHECK line defines or uses a FileCheck variable ([[VAR:...]]), which the FileCheck subset does not take"
  :decided "AR4 (AX4c's)"}
 {:id :split-file
  :title "a split-file test's part"
  :kind :deferred
  :why "the run assembles a part split-file makes (%t/NAME), not the file"
  :decided "AR4"}
]

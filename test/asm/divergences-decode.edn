;; repr/asm's decode check's classes (bin/repr-asm decode-check; doc/asm/AMD64.md §9, AX4's third slice): every unmet check of
;; test/asm/decode-results-amd64.edn is counted under its :by class, one of these (arbace.asm.amd64.decode-check names the class:
;; a run this check does not print, a FileCheck feature it does not take, LLVM's own reading of bytes the matcher wrote otherwise).
;; :mismatch, :crash, :unpaired, :extra, :missing and :assemble-error are failures, never classes. In goi's format. Read with the
;; Clojure reader.
[
 {:id :markup
  :title "llvm-mc --mdis: the printer's markup"
  :kind :deferred
  :why "the run prints with MCInstPrinter's markup (`<reg:%rcx>`, `<mem:...>`, `<imm:...>`), which arbace.asm.amd64.print did not write: none since 2026-11-17 (AXS66 (a): the printer's markup, arbace.asm.amd64.print/*markup*, the two tests' 4 lines met); kept for a markup the printer does not write"
  :decided "AX4's third slice; emptied by AXS66 (a), 2026-11-17"}
 {:id :filecheck-var
  :title "a FileCheck variable"
  :kind :deferred
  :why "the CHECK line names a FileCheck variable or expression ([[VAR]], [[#...]], [[@LINE]]), which the check's FileCheck does not take"
  :decided "AX4's third slice"}
 {:id :other-target
  :title "a run of another target"
  :kind :by-design
  :why "the run's triple names no x86 mode"
  :decided "AX4's third slice"}
 {:id :undecoded
  :title "bytes the decoder refuses where LLVM decodes"
  :kind :pending
  :why "the decoder gives `invalid instruction encoding` where the test states an instruction"
  :decided "AX4's third slice"}
 {:id :apx-undecoded
  :title "an APX instruction the decoder refuses"
  :kind :deferred
  :why "the stated instruction is APX's (REX2, map 4's NDD/NF, CCMP/CTEST, %r16-%r31) and the decoder refuses it"
  :decided "AX4's third slice"}
 {:id :apx
  :title "an APX instruction decoded otherwise"
  :kind :deferred
  :why "the stated instruction is APX's and the decoder reads another"
  :decided "AX4's third slice"}
 {:id :llvm-nop
  :title "xchg of the accumulator with itself read back as nop"
  :kind :by-design
  :why "`xchgw %ax, %ax` (66 90; `xchgl %eax, %eax` in 16-bit mode) encodes as the matcher chose, and LLVM's tables give NOOP for it: setTableFields keeps NOOP against XCHG16ar/32ar/64ar, so llvm-mc --disassemble prints `nop`; the decoder is LLVM's, and the matcher's choice stays the assembler's"
  :decided "AX4's third slice"}
 {:id :eiz-dropped
  :title "a SIB without base nor index read back without %eiz"
  :kind :by-design
  :why "`movq (,%eiz), %rax` in 64-bit mode encodes a SIB with no base and no index under 67; translateRMMemory writes EIZ only when there is no base outside 64-bit mode, so LLVM reads it back as `addr32 movq 0, %rax`: the same bytes, another operand list"
  :decided "AX4's third slice"}
]

(ns asm.encode-judge
  "bin/repr-asm encode-check's judgment (doc/asm/AMD64-SURVEY.md §8.2, AX2): a run's rows (WORK/encode.tsv: NAME STATED MET
  CLASSES ERRORS FAMILIES) against the record test/asm/encode-results-amd64.edn ([ID {:stated N :met N :by {CLASS N}
  :errors [MET STATED] :fam {FAMILY N}}], ID CORPUS/NAME): every file of the run recorded and every recorded file of the
  run's corpora run, its stated encodings the recorded number, its met encodings and error lines not fewer, its failures
  (:mismatch, :rejected, :crash, :unpaired) not more, and every class of the run in test/asm/divergences-encode.edn;
  with RECORD the corpora's rows are rewritten from the run."
  (:require [arbace.string :as str]))

(def header
  (str ";; repr/asm's encoding check (bin/repr-asm encode-check; doc/asm/AMD64-SURVEY.md §8.2, AX2): each file of the corpora, its stated\n"
       ";; encodings (`CHECK: encoding: [...]`, every check prefix) judged by the test's own CHECK lines against Arbace's encoder (no\n"
       ";; llvm-mc): :stated, :met, the rest by class (:by, test/asm/divergences-encode.edn), the error tests' `error:` lines met of stated\n"
       ";; (:errors), the met encodings by the instruction's encoding (:fam). Written by `bin/repr-asm encode-check --record`. Read with\n"
       ";; the Clojure reader.\n"))

(def failing #{:mismatch :rejected :crash :unpaired})

(defn- read-run [work corpus]
  (vec (for [l (str/split-lines (slurp (str work "/encode.tsv"))) :when (seq l)
             :let [[n st met by errs fam crash] (str/split l #"\t")]]
         [(str corpus "/" n)
          (cond-> {:stated (Long/parseLong st) :met (Long/parseLong met) :by (read-string by)}
            (not= "nil" errs) (assoc :errors (read-string errs))
            (and fam (not= "{}" fam)) (assoc :fam (read-string fam))
            crash (assoc :crash crash))])))

(defn main [results works classes-path record]
  (let [run (vec (mapcat (fn [w] (read-run w (.getName (java.io.File. ^String w)))) (str/split works #" ")))
        corpora (set (map #(first (str/split (first %) #"/")) run))
        old (if (.exists (java.io.File. ^String results)) (read-string (slurp results)) [])
        in-run? (fn [[id]] (contains? corpora (first (str/split id #"/"))))
        oldm (into {} (filter in-run? old))
        runm (into {} run)
        classes (set (map :id (read-string (slurp classes-path))))
        problems (atom [])
        tot (fn [k] (reduce + (map (comp k second) run)))]
    (println (str "repr-asm encode-check: " (tot :met) " of " (tot :stated) " stated encodings met, "
                  (pr-str (into (sorted-map) (apply merge-with + (map (comp :fam second) run)))) ", the rest "
                  (pr-str (into (sorted-map) (apply merge-with + (map (comp :by second) run))))))
    (let [es (keep (comp :errors second) run)]
      (println (str "repr-asm encode-check: the error tests' error lines: " (reduce + (map first es)) " of " (reduce + (map second es)) " met")))
    (doseq [[i r] run]
      (when (:crash r) (swap! problems conj (str "crash: " i " " (:crash r))))
      (doseq [k (keys (:by r)) :when (not (classes k))] (swap! problems conj (str "unclassed: " i " " k))))
    (if (seq record)
      (let [rows (sort-by first (concat (remove in-run? old) run))]
        (spit results (str header "[\n" (apply str (map (fn [[i r]] (str "[" (pr-str i) " " (pr-str (into (sorted-map) (update r :by #(into (sorted-map) %)))) "]\n")) rows)) "]\n"))
        (println (str "repr-asm: recorded " (count run) " rows into " results)))
      (do
        (doseq [[i r] run :let [o (oldm i)]]
          (cond
            (nil? o) (swap! problems conj (str "not recorded: " i))
            :else
            (do (when (not= (:stated o) (:stated r)) (swap! problems conj (str i ": stated " (:stated r) ", recorded " (:stated o))))
                (when (< (long (:met r)) (long (:met o))) (swap! problems conj (str i ": met " (:met r) ", recorded " (:met o))))
                (doseq [c failing :when (> (long (get (:by r) c 0)) (long (get (:by o) c 0)))]
                  (swap! problems conj (str i ": " (name c) " " (get (:by r) c) ", recorded " (get (:by o) c 0))))
                (when (and (:errors o) (< (long (first (:errors r [0 0]))) (long (first (:errors o)))))
                  (swap! problems conj (str i ": error lines met " (first (:errors r)) ", recorded " (first (:errors o))))))))
        (doseq [[i] oldm :when (not (contains? runm i))] (swap! problems conj (str "recorded, not run: " i)))))
    (doseq [p (take 40 @problems)] (println (str "FAIL: " p)))
    (if (empty? @problems)
      (println "repr-asm encode-check: ok")
      (do (println (str "repr-asm encode-check: " (count @problems) " problems")) (System/exit 1)))))

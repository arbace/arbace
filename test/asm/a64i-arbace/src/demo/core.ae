(ns demo.core
  (:require [arbace.set :as set]
            [arbace.walk :as walk]
            [arbace.string :as str]
            [arbace.pprint :refer [pprint]]
            [demo.util :as u]))

(defprotocol Shape (area [s]))
(defrecord Rect [w h] Shape (area [_] (* w h)))
(defrecord Circle [r] Shape (area [_] (* 3 r r)))

(defmulti describe :kind)
(defmethod describe :a [m] (str "A:" (:v m)))
(defmethod describe :default [m] (str "other:" (:kind m)))

(defmacro twice [& body] `(do ~@body ~@body))

(defn -main [& args]
  (println "args" (vec args))
  (println (map area [(->Rect 2 3) (->Circle 2)]))
  (println (set/union #{1 2} #{2 3}) (set/difference #{1 2 3} #{2}))
  (println (walk/postwalk #(if (number? %) (inc %) %) {:a [1 2 {:b 3}]}))
  (println (str/join "," (map str/capitalize ["x" "yy" "zzz"])))
  (println (describe {:kind :a :v 1}) (describe {:kind :z}))
  (twice (print "t "))
  (println)
  (pprint {:deep (vec (range 30)) :nested {:k (repeat 5 "word")}})
  (println (u/fact 20) (u/fib-seq 12))
  (println (sort (keys (ns-publics 'demo.util))))
  (try (u/boom) (catch Exception e (println "caught" (class e) (ex-message e) (ex-data e))))
  (shutdown-agents))

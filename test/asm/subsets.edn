;; AXS89 (a), the user 2026-11-10 (doc/asm/AMD64-SURVEY.md, "As built: AXS89, AXS90"; doc/GATE-SURVEY.md, GT8.4): x86i-check's programs for
;; the planner's rotation (test/gate/crops/asm.edn's :rotate on x86i-check, the part :all: the map whose :id is the part, its :subset the
;; program names, as the record test/asm/x86i-results-amd64.edn's rows x86i/NAME, decode/NAME, lockstep/NAME, step/NAME and loader/NAME
;; carry them). The subset runs every night and, alone, in the clean run's rotation tier; the rest of the 45 programs (the 12 synthetic
;; ones, test/asm/x86i/'s, test/asm/run/'s) runs a seventh a night (a program's slice: the first 8 hex digits of the SHA-256 of its name,
;; mod 7), each run `bin/repr-asm x86i-check --only LIST`, judged on what it ran, with its slice-foreign control. --full and the clean
;; run's whole tier run all of them. The subset: the quick programs (under a second of run, the step mode included), which hold the
;; subjects and references of most of the controls (test/asm/controls-x86i.txt: p4-hello, exit-status, calls, loop-sum, tls, relocs-data,
;; weak, comdat, musl-string, musl-setjmp, two-objects, string, misc); the slow ones (alu, muldiv, the synthetic families: 4 to 41 s) rotate.
;; Read with the Clojure reader.
[{:id :all
  :subset ["p4-hello" "exit-status" "calls" "loop-sum" "tls" "relocs-data" "weak" "comdat" "musl-string" "musl-setjmp"
           "two-objects" "string" "misc"]}
 ;; AXS91 (a), the user 2026-11-11: asm-amd64-encode's mc-x86 (the names bare, as the record test/asm/encode-results-amd64.edn's rows
 ;; mc-x86/NAME carry them): the subjects and references of the encode, print and cross-syntax controls (controls-encode.txt,
 ;; controls-print.txt, controls-cross.txt: also :always in the step, so every slice judges its controls) but the two heavy pairs (AVX-64 against AVX2-64 and
 ;; avx512-intel against avx512f_vl-intel: 17,000 stated encodings of the 106,000, the subset's time doubled), which run in --full's whole and the clean run's; the other files run a seventh a night
 {:id :mc-x86
  :subset ["I86-64" "I86-32" "SSE2-32" "SSE2-64" "avx512bw-64-att" "avx512dq-att"
           "avx10.2-bf16-64-intel" "avx10.2-bf16-32-intel" "apx-add-att" "apx-sub-att" "apx-ccmp-att" "apx-ctest-att" "x86-64" "avx-64-intel"]}
 ;; ARS46 (b), the user 2026-11-11 (doc/asm/ARM64-SURVEY.md, "As built: AR7"): a64i-check's programs (test/gate/crops/asm.edn's
 ;; a64i-essential, `bin/a64i check --essential`, and the :rotate on a64i-check's part :a64i: the program names, as the record
 ;; test/asm/a64i-results-arm64.edn's rows eval/NAME, aot/NAME, forms/NAME, cpu/NAME, sys/NAME, step/NAME and loader/NAME carry them).
 ;; The subset: the hand-written programs (test/asm/run-arm64/'s, test/asm/a64i/'s) and five synthetic ones (synth-alu, synth-fp-d and,
 ;; since review 1111 (5), synth-neon-e: a quarter of synth-neon's cases, the Advanced SIMD integer lanes; since AR11, ARS62 (a),
 ;; synth-neon-el-e: a quarter of synth-neon-el's cases, the scalar FP classes and the by-element multiplies; since AR14, ARS69 (a),
 ;; synth-neon-int-e: a quarter of synth-neon-int's cases, the remaining integer lanes, whose decoder sits first in decodeSIMD;
 ;; since AR15, ARS73 (a), synth-neon-est-e: a quarter of synth-neon-est's cases, the rest of ARMv8.0's FP and SIMD, whose decoder
 ;; sits first in decodeFP after AR15's FP16 one; since AR16, ARS76 (a), synth-neon-fp16-e: a quarter of synth-neon-fp16's cases,
 ;; FEAT_FP16, whose decoder sits first in decodeFP after AR16's; since AR17, ARS78 (a), synth-neon-ext-e: a quarter of synth-neon-ext's
 ;; cases, the ARMv8.2-8.4 features, whose decoder sits first in decodeFP after AR17's crypto one; AR18's hand-written crc32,
 ;; lse2-align and auxv-hwcap with the rest; crypto-fips the only crypto program, ARS80 (a); AR20's signal-fault, signal-kill and sys-idregs; AR21's linux-stat and linux-span; AR22's linux-mmap),
 ;; the essential gate's; the other synthetic programs run a seventh a night in --full, all of them in --full's whole and the clean run's.
 {:id :a64i
  :subset ["calls" "comdat" "data-bss" "eh-frame" "exit-status" "linker-symbols" "loop-sum" "merge-strings" "musl-crti"
           "musl-setjmp" "p4-hello" "relocs-data" "tls" "two-objects" "weak" "adc-sbc" "add-ext" "add-imm" "add-shift" "adr-adrp" "auxv-hwcap"
           "bcond" "bfm" "bitfield-sbfm" "bitfield-ubfm" "br-blr-ret" "branch-b-bl" "cbz-cbnz" "ccmp" "clz-cls" "cmp-cmn" "csel"
           "cset-cinc" "div" "exit-code" "extr-ror" "crc32" "crypto-fips" "fpcr-afp" "fpcr-fz" "fault-brk" "fault-null" "fault-rodata" "fault-sp-align" "fault-udf"
           "ldar-stlr" "ldaxr-pair" "ldp-stp" "ldr-literal" "ldr-str-imm" "ldrs" "ldst-pre-post" "ldst-reg" "ldur-stur"
           "ldxr-stxr" "linux-clock" "linux-io" "linux-mem" "lse2-align" "logic-imm" "logic-reg" "lse-cas" "lse-ldadd" "lse-logic"
           "lse-minmax" "lse-swp" "madd-msub" "mov-reg" "mov-wide" "mul-long" "mulh" "neg" "rbit-rev" "shift-reg" "simd-ldst" "simd-qc" "simd-struct"
           "sys-regs" "sys-el0" "fault-dczva" "overlap-wb" "overlap-pair" "signal-fault" "signal-kill" "sys-idregs" "linux-stat" "linux-span" "linux-mmap" "tbz-tbnz" "tst-mvn" "synth-alu" "synth-fp-d" "synth-neon-e"
           "synth-neon-el-e" "synth-neon-int-e" "synth-neon-est-e" "synth-neon-fp16-e" "synth-neon-ext-e"]}]

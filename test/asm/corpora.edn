;; repr/asm's corpora (doc/asm/AMD64-SURVEY.md §10, AX1; doc/asm/ARM64-SURVEY.md §5, AR1; doc/asm/SPEC.md §8): each a directory of
;; a pinned tarball, extracted by `bin/repr-asm corpus extract` into $REPR_ASM_SRC (default MAIN/.tmp/asm/src), or read in place
;; (:root :goroot, TamaGo's GOROOT; :root :checkout, the checkout), listed by `corpus lists`, judged by `roundtrip --arch ARCH`
;; (:arch, amd64 when left out; :syntax :plan9 Go's assembler's text).
;; The pins are those of the other crops (test/c/corpora.edn's :musl-1.2.6, test/cpp/corpora.edn's :llvmorg-23.1.5), restated here
;; with what repr/asm reads of them; no fetch. Read with the Clojure reader.
{:pins
 {:musl-1.2.6
  {:url "https://musl.libc.org/releases/musl-1.2.6.tar.gz"
   :fetched-into ".tmp/c1/musl/musl-1.2.6.tar.gz"
   :bytes 1082499
   :sha256 "d585fd3b613c66151fc3249e8ed44f77020cb5e6c1e635a616d3f9f82460512a"
   :pinned-by "test/c/corpora.edn :musl-1.2.6 (its :checked)"
   :top "musl-1.2.6/"
   :license "MIT (COPYRIGHT in the tarball)"}
  :llvmorg-23.1.5
  {:url "https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.5/llvm-project-23.1.5.src.tar.xz"
   :fetched-into ".tmp/llvm/llvm-project-23.1.5.src.tar.xz"
   :bytes 179220264
   :sha256 "fb50b1eac93ddeb3aa8dab4cfe324dff74f4a9c2bdee6160c9e36188f8d06a6e"
   :pinned-by "test/cpp/corpora.edn :llvmorg-23.1.5 (its :checked)"
   :top "llvm-project-23.1.5.src/"
   :license "Apache-2.0 WITH LLVM-exception (llvm/LICENSE.TXT in the tarball)"}
  :gcc-15.2.0
  {:url "https://ftp.gnu.org/gnu/gcc/gcc-15.2.0/gcc-15.2.0.tar.xz"
   :fetched-into ".tmp/c1/gcc/gcc-15.2.0.tar.xz"
   :bytes 101056276
   :sha256 "438fd996826b0c82485a29da03a72d71d6e3541a83ec702df4271f6fe025d24e"
   :pinned-by "test/c/corpora.edn :gcc-15.2.0 (its :checked)"
   :top "gcc-15.2.0/"
   :license "GPL-3.0-or-later WITH GCC-exception-3.1 (libgcc; COPYING3 and COPYING.RUNTIME in the tarball): read as test data, never ported"}
  :tamago-go
  {:what "TamaGo's Go distribution, read in place ($ARBACE_GOROOT, default /root/tamago-go): its VERSION checked against :version"
   :version "go1.27.1"
   :pinned-by "seed/goroot.sha256 (5745170fd3c8..., over VERSION and every file of src/; bin/seed checks it)"
   :license "BSD-3-Clause (LICENSE in GOROOT)"}}
 ;; the sources of the generated tables (AX2): extracted with the corpora, read by bin/repr-asm table (arbace.asm.tablegen)
 :tables
 [{:id :x86-td
   :what "llvm-project 23.1.5's X86 TableGen files and the target-independent ones X86.td includes (llvm/include/llvm/{Target,CodeGen,IR}/*.td, Target/GlobalISel): the input of amd64's instruction table, asm/amd64/table.edn"
   :pin :llvmorg-23.1.5
   ;; tar's wildcards cross `/`: Target/*.td takes Target/GlobalISel/*.td too
   :extract ["llvm-project-23.1.5.src/llvm/lib/Target/X86/*.td" "llvm-project-23.1.5.src/llvm/include/llvm/Target/*.td"
             "llvm-project-23.1.5.src/llvm/include/llvm/CodeGen/*.td"
             "llvm-project-23.1.5.src/llvm/include/llvm/IR/*.td"]}]
 ;; the decoder's corpora (AX4's third slice): extracted with the corpora, read by bin/repr-asm decode-check alone (not a round
 ;; trip's corpus)
 :decode-corpora
 [{:id :mc-x86-dis
   :what "llvm/test/MC/Disassembler/X86: llvm-mc --disassemble's tests (byte strings and their CHECK lines), 187 files"
   :pin :llvmorg-23.1.5
   :extract ["llvm-project-23.1.5.src/llvm/test/MC/Disassembler/X86"]
   :dir "llvm-project-23.1.5.src/llvm/test/MC/Disassembler/X86"}]
 :corpora
 [{:id :musl
   :what "musl 1.2.6's x86-64 assembly: src/*/x86_64/*.s and crt/x86_64/*.s (32 files, 711 lines; no .S)"
   :pin :musl-1.2.6
   :extract ["musl-1.2.6/src/*/x86_64/*" "musl-1.2.6/crt/x86_64/*" "musl-1.2.6/COPYRIGHT"]
   :dir "musl-1.2.6"
   :arch :amd64
   :match "/x86_64/[^/]*\\.[sS]$"
   :levels [:read :full :canon]}
  {:id :mc-asmparser
   :what "llvm/test/MC/AsmParser's .s files (the directive language; the directory runs only with the X86 target), its AArch64/ apart"
   :pin :llvmorg-23.1.5
   :extract ["llvm-project-23.1.5.src/llvm/test/MC/AsmParser" "llvm-project-23.1.5.src/llvm/LICENSE.TXT"]
   :dir "llvm-project-23.1.5.src/llvm/test/MC/AsmParser"
   :match "\\.s$"
   :arch :amd64
   :exclude "^AArch64/"
   :levels [:read :full :canon]}
  {:id :mc-x86
   :what "llvm/test/MC/X86's .s files (620; the Intel-syntax ones classed :intel until AX3)"
   :pin :llvmorg-23.1.5
   :extract ["llvm-project-23.1.5.src/llvm/test/MC/X86"]
   :arch :amd64
   :dir "llvm-project-23.1.5.src/llvm/test/MC/X86"
   :match "\\.s$"
   :levels [:read :full :canon]}
  ;; arm64 (AR1)
  {:id :a64-musl
   :what "musl 1.2.6's aarch64 assembly: src/*/aarch64/*.[sS] and crt/aarch64/*.s (15 files, 13 .s and memcpy.S, memset.S)"
   :pin :musl-1.2.6
   :arch :arm64
   :extract ["musl-1.2.6/src/*/aarch64/*" "musl-1.2.6/crt/aarch64/*"]
   :dir "musl-1.2.6"
   :match "/aarch64/[^/]*\\.[sS]$"
   :levels [:read :full :canon]}
  {:id :a64-libgcc
   :what "gcc 15.2.0's libgcc/config/aarch64/*.S (7 files: lse.S, crti.S, crtn.S and SME's __arm_*), the C preprocessor's text"
   :pin :gcc-15.2.0
   :arch :arm64
   :extract ["gcc-15.2.0/libgcc/config/aarch64/*.S" "gcc-15.2.0/COPYING3" "gcc-15.2.0/COPYING.RUNTIME"]
   :dir "gcc-15.2.0/libgcc/config/aarch64"
   :match "\\.S$"
   :levels [:read :full :canon]}
  {:id :mc-aarch64
   :what "llvm/test/MC/AArch64's base files, its top level's 408 .s (the 8 .ll and lit.local.cfg are not assembly; the extensions' 1,942 .s in their directories are AR11's)"
   :pin :llvmorg-23.1.5
   :arch :arm64
   :extract ["llvm-project-23.1.5.src/llvm/test/MC/AArch64/*.s"]
   :dir "llvm-project-23.1.5.src/llvm/test/MC/AArch64"
   :match "^[^/]*\\.s$"
   :levels [:read :full :canon]}
  {:id :mc-asmparser-aarch64
   :what "llvm/test/MC/AsmParser/AArch64 (one file: the directive parser's errors on AArch64)"
   :pin :llvmorg-23.1.5
   :arch :arm64
   :extract [] ;; extracted with :mc-asmparser's directory (tar names a member once)
   :dir "llvm-project-23.1.5.src/llvm/test/MC/AsmParser/AArch64"
   :match "\\.s$"
   :levels [:read :full :canon]}
  {:id :a64-box
   :what "the box's arm64 assembly in Plan 9's syntax (7 files: board/boot_arm64.s, guest/cmd/bare/bare_arm64.s, purego's five)"
   :root :checkout
   :arch :arm64
   :syntax :plan9
   :dir "box/go/arbace/box"
   :match "_arm64\\.s$"
   :levels [:read :full :canon]}
  {:id :a64-go-testdata
   :what "Go 1.27.1's cmd/asm testdata for arm64 (arm64.s, arm64enc.s, arm64error.s, arm64sveenc.s, arm64sveerror.s: 6,295 lines)"
   :pin :tamago-go
   :root :goroot
   :arch :arm64
   :syntax :plan9
   :dir "src/cmd/asm/internal/asm/testdata"
   :match "^arm64[a-z]*\\.s$"
   :levels [:read :full :canon]}]}

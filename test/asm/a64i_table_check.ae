;; bin/a64i table-check (queue 277, AR14; ARS70 (a); doc/asm/ARM64-SURVEY.md, "As built: AR14"): goi's checker over a64i's
;; packages of Go forms, as bin/pyi table-check (test/python/table_check.ae) checks pyi's: AR13 found a64i's :init-order two
;; branches stale this way (a scratch wrapper then), and the step holds it. Run on stage 0 (ARBACE_PATH at the checkout, cwd
;; the checkout):
;;   EXE a64i_table_check.ae ROOT PKGS --config GOOS/GOARCH=STDROOT[,OVERLAY]...
;; ROOT: the forms root whose go/ holds the packages (the checkout; the control's scratch root); PKGS: the packages,
;; comma-separated, in import order (arbace/crt,arbace/emu,arbace/a64i), taken as a user's program's (arbace.go.table's
;; user-root: ROOT/go/...); STDROOT: the configuration's std forms (linux/arm64: the closure of a64i's std imports read by
;; repr/go). goi's checker checks each package in each configuration (its files as the configuration's build constraints select
;; them; the package header's :init-order against the checker's order among its annotations): no error, each package's file
;; count and time printed; the errors listed (A64I_TABLE_ERRORS, default 30) and the exit status 1 otherwise.
(require '[arbace.string :as str] '[arbace.go.table :as table] '[arbace.go.check :as ck])

(let [[root pkgs & more] *command-line-args*
      opts (table/parse-args more)
      ps (str/split pkgs #",")
      fails (atom 0)
      fail! (fn [& xs] (swap! fails inc) (apply println "FAIL" xs))]
  (reset! @#'table/user-root {:dir root})
  (doseq [{:keys [cfg root]} (:configs opts)]
    (let [config (merge {:goos (:goos cfg) :goarch (:goarch cfg)}
                        (if (= "amd64" (:goarch cfg)) {:goamd64 "v1"} {:goarm64 "v8.0"}))
          src-of (fn [path _] (#'table/source-of root path config))
          s (ck/session src-of)
          c (str (:goos cfg) "/" (:goarch cfg))]
      (doseq [p ps]
        (let [t0 (System/currentTimeMillis)
              src (src-of p nil)
              cp (binding [arbace.go.check.env/*pkg* (volatile! {:path "arbace/gotable"})
                           arbace.go.check.types/*resolve-named* arbace.go.check.decl/resolve-named!
                           arbace.go.check.types/*method-obj* arbace.go.check.decl/method-data!
                           arbace.go.check.types/*subst-method* arbace.go.check.decl/subst-method]
                   (ck/ensure-package s p nil []))
              errs (when cp (:errors (:result @cp)))]
          (cond
            (nil? cp) (fail! c "no files of" p)
            (seq errs) (do (fail! c (count errs) "errors of goi's checker in" p)
                           (doseq [{:keys [file line msg]} (take (Long/parseLong (or (System/getenv "A64I_TABLE_ERRORS") "30")) errs)]
                             (println (str "  " file ":" line ": " msg))))
            :else (println (str "checked: " p " in " c ", " (count (:files src)) " files, no error, "
                                (quot (- (System/currentTimeMillis) t0) 1000) " s")))))))
  (shutdown-agents)
  (if (zero? @fails)
    (do (println "a64i table-check: ok (" pkgs "checked in" (count (:configs opts)) "configurations)") (System/exit 0))
    (do (println "a64i table-check:" @fails "failures") (System/exit 1))))

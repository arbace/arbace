;; repr/asm's object check's classes (bin/repr-asm object-check; doc/asm/AMD64-SURVEY.md §7.3, AX4): every file of
;; test/asm/object-results-amd64.edn whose object is not llvm-mc's byte for byte is in one of these. In goi's format. Read with the
;; Clojure reader.
[
 {:id :canonical
  :title "the same sections, symbols and relocations, another layout"
  :kind :deferred
  :why "the object's sections' bytes, symbols and relocations are llvm-mc's, the file's layout (section order, string table, padding) not"
  :decided "AX4's first slice: the judge's canonical level"}
 {:id :unsupported-cfi
  :title "CFI directives (.eh_frame)"
  :kind :deferred
  :why "the file holds .cfi_* directives, whose .eh_frame (MCDwarf's FrameEmitterImpl) this slice does not write yet"
  :decided "AX4's first slice"}
 {:id :unsupported-directive
  :title "a directive the object assembler does not take yet"
  :kind :deferred
  :why "the file holds a directive arbace.asm.amd64.obj does not assemble yet (named in the row)"
  :decided "AX4's first slice"}
 {:id :unsupported-apx
  :title "APX"
  :kind :deferred
  :why "an instruction the encoder does not encode yet (test/asm/divergences-encode.edn's :apx): none since the asm branches' merge (AX2d encodes APX; the 11 MC/X86 object tests classed here are equal to llvm-mc's objects); kept for an APX form the encoder refuses"
  :decided "AX2's classes"}
 {:id :unsupported-debug-line
  :title ".loc and .file N (.debug_line)"
  :kind :deferred
  :why "the file holds DWARF line directives the object assembler does not take: since AX12 (AXS92 (a)) .loc's line program is written, so only DWARF 5's `.file 0`, a `.file` with an MD5 or source, or a .loc whose operands are not constants; no row is in it since AX12 (AMD64-SURVEY.md, As built: AX12)"
  :decided "AX4's first slice"}
 {:id :unsupported-large-fill
  :title "a fill too large to hold"
  :kind :deferred
  :why "a .zero/.skip/.fill of more than 64 MiB in a section with contents: the object assembler holds a section's bytes in memory"
  :decided "AX4's first slice (the light lane's memory)"}
 ;; queue 337: the object verdict's classes (bin/repr-asm object-verdict, arbace.asm.amd64.objcheck: MC/X86's object tests that
 ;; mc-x86-obj leaves out, each object run's CHECK lines held to Arbace's view of Arbace's object); the object assembler's classes
 ;; above (:unsupported-directive, ...) serve it too
 {:id :other-format
  :title "an object format whose writer is not built"
  :kind :by-design
  :why "the run's triple asks llvm-mc for an object format whose writer Arbace has not built (XCOFF, GOFF, Wasm ...). None since x86-objs (2026-11-22, AXS99 (b), the user's decision): Mach-O's and COFF's writers and views are Arbace's (arbace.asm.macho, arbace.asm.coff, arbace.asm.amd64.objview), their runs judged by their own CHECK lines; kept for another format"
  :decided "queue 337 (AXS99 (a) proposed); emptied by x86-objs (AXS99 (b), the user 2026-11-22)"}
 {:id :elf32
  :title "an i386 object's view beyond its disassembly"
  :kind :deferred
  :why "an i386 triple's run (ELF32, REL relocations): Arbace assembles it in 32-bit mode with i386's implicit addends into its ELF64 object, so llvm-objdump -d's and --headers' lines are judged, and the views of what ELF32 holds otherwise (relocations, section headers, symbols, R_386_* names in .reloc) wait for an ELF32 writer. None since x86-objs round 2 (2026-11-22, AXS101 (a)): i386's objects are ELF32 with REL relocations (arbace.asm.elf's :class 32, X86ELFObjectWriter's R_386_* types), their views judged; kept as the record's history"
  :decided "queue 337; emptied by x86-objs round 2 (AXS101 (a))"}
 {:id :x32
  :title "the x32 ABI"
  :kind :deferred
  :why "the run's triple is x86_64-*-gnux32 (ELF32 x86-64), which Arbace's object assembler does not write"
  :decided "queue 337"}
 {:id :options
  :title "an llvm-mc option the object verdict does not take"
  :kind :deferred
  :why "the run gives llvm-mc an option that changes the object and that arbace.asm.amd64.obj does not apply (-g, -crel, -mattr, -x86-asm-syntax=intel, ...); taken: -x86-relax-relocations=false (queue 372), -mcpu (the NOPs), --x86-align-branch-boundary, --x86-align-branch, --x86-branches-within-32B-boundaries, -x86-pad-max-prefix-size, -x86-pad-for-align, --mc-relax-all, --defsym"
  :decided "queue 337"}
 {:id :stats
  :title "LLVM's statistics"
  :kind :by-design
  :why "the run's CHECK lines read llvm-mc --stats' counters (REQUIRES: asserts: the layout's relaxation steps), no object's view; the object itself is judged by the file's other runs"
  :decided "queue 337"}
 {:id :split-file
  :title "a split-file test's part or another input"
  :kind :deferred
  :why "the run assembles another file (%S/Inputs) or a split-file part it cannot name (since queue 372 a part NAME or %t/NAME of `split-file %s %t` is assembled and its CHECK lines read from the part, its line numbers the test's)"
  :decided "queue 337 (AR4's arm64 class); narrowed by queue 372"}
 {:id :message
  :title "a refusal with another wording or place"
  :kind :deferred
  :why "an error test's object run (`not llvm-mc ... -filetype=obj`): a CHECK line the object assembler's diagnostics (arbace.asm.obj/diagnostics, as llvm-mc prints them) do not meet (none since queue 372: a relaxed instruction's fixup at `<unknown>:0:`, a spelled `.L` symbol's and a number's caret)"
  :decided "queue 337 (AR4's arm64 class); queue 372"}
 {:id :error-accepted
  :title "an error test the object assembler accepts"
  :kind :deferred
  :why "an error test's object run whose file arbace.asm.amd64.obj assembles: an error llvm-mc reports that it does not yet"
  :decided "queue 337 (AR4's arm64 class)"}
 {:id :filecheck-var
  :title "FileCheck's variables"
  :kind :deferred
  :why "the CHECK line uses a FileCheck numeric expression the FileCheck subset does not take"
  :decided "queue 337 (AR4's arm64 class)"}
 {:id :view-llvm-objdump
  :title "an llvm-objdump view the object verdict does not make"
  :kind :deferred
  :why "llvm-objdump with options whose output arbace.asm.amd64.objcheck does not write (-D, --section, --no-addresses, --unwind-info, --fault-map-section)"
  :decided "queue 337"}
 {:id :view-llvm-readobj
  :title "an llvm-readobj view the object verdict does not make"
  :kind :deferred
  :why "llvm-readobj with options whose output it does not write (--section-data, --sd, ...)"
  :decided "queue 337"}
 {:id :view-llvm-readelf
  :title "an llvm-readelf view the object verdict does not make"
  :kind :deferred
  :why "llvm-readelf with options whose output it does not write"
  :decided "queue 337"}
 {:id :view-llvm-dwarfdump
  :title "llvm-dwarfdump's view"
  :kind :deferred
  :why "the run reads the object's DWARF with llvm-dwarfdump, whose output the object verdict does not write"
  :decided "queue 337"}
 {:id :view-llvm-nm
  :title "llvm-nm's view"
  :kind :deferred
  :why "the run lists the object's symbols with llvm-nm, whose output the object verdict does not write"
  :decided "queue 337"}
 {:id :no-viewer
  :title "an object run with no viewer"
  :kind :deferred
  :why "the run's FileCheck reads llvm-mc's own output beside the object (not an error test)"
  :decided "queue 337"}
]

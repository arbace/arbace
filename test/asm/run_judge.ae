(ns asm.run-judge
  "bin/repr-asm run-check's judgment (doc/asm/AMD64-SURVEY.md §7.3, §8.2, AX4's second slice): a run's rows (WORK/run.tsv: NAME
  RESULT DETAIL; RESULT pass when the program Arbace assembled and linked, run by the CPU, met the verdict its header states,
  else exit, stdout, timeout, or the class of what was not assembled or linked) against the record
  test/asm/run-results-amd64.edn ([ID RESULT DETAIL], ID run/NAME): every test of the run recorded and every recorded test run,
  every recorded :pass still a :pass, no failure, every other result a class of test/asm/divergences-run.edn; with RECORD the rows
  are rewritten from the run (refused when it holds a failure)."
  (:require [arbace.string :as str]))

(def header
  (str ";; repr/asm's run check (bin/repr-asm run-check; doc/asm/AMD64-SURVEY.md §7.3, §8.2, AX4): each test of test/asm/run/\n"
       ";; assembled (arbace.asm.amd64.obj) and linked (arbace.asm.link) by Arbace, run by the CPU, and judged by the verdict its\n"
       ";; header states (exit status, stdout; or the link's refusal): :pass, else its class (test/asm/divergences-run.edn). Written by\n"
       ";; `bin/repr-asm run-check --record`. Read with the Clojure reader.\n"))

(def failing #{:link-accepted :exit :stdout :timeout :link-error :assemble-error :link-crash :assemble-crash :link-reloc})

(defn main [results work classes-path record]
  (let [run (vec (for [l (str/split-lines (slurp (str work "/run.tsv"))) :when (seq l)
                       :let [[n c d] (str/split l #"\t" -1)]]
                   [(str "run/" n) (keyword c) (or d "")]))
        old (if (.exists (java.io.File. ^String results)) (read-string (slurp results)) [])
        oldm (into {} (map (fn [[i c]] [i c]) old))
        classes (set (map :id (read-string (slurp classes-path))))
        problems (atom [])]
    (println (str "repr-asm run-check: " (count (filter #(= :pass (second %)) run)) " of " (count run)
                  " programs assembled, linked and run by the CPU meet their own verdicts; "
                  (pr-str (into (sorted-map) (dissoc (frequencies (map second run)) :pass)))))
    (doseq [[i c d] run]
      (cond (failing c) (swap! problems conj (str "failing: " i " " (name c) " " d))
            (and (not= c :pass) (not (classes c))) (swap! problems conj (str "unclassed: " i " " (name c) " " d))))
    (if (and (seq record) (empty? @problems))
      (do (spit results (str header "[\n" (apply str (map (fn [r] (str (pr-str r) "\n")) (sort-by first run))) "]\n"))
          (println (str "repr-asm: recorded " (count run) " rows into " results)))
      (do (doseq [[i c] run :let [o (oldm i)]]
            (cond (nil? o) (swap! problems conj (str "not recorded: " i))
                  (and (= o :pass) (not= c :pass)) (swap! problems conj (str i ": " (name c) ", recorded :pass"))))
          (doseq [[i] old :when (not (some #(= i (first %)) run))] (swap! problems conj (str "recorded, not run: " i)))))
    (doseq [p @problems] (println (str "FAIL: " p)))
    (when (empty? @problems) (println "repr-asm run-check: ok"))
    (when (seq @problems) (System/exit 1))))

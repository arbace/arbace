;; repr/asm's encoding check's classes (bin/repr-asm encode-check; doc/asm/AMD64-SURVEY.md §8.2, AX2 "equal or classed"): every stated
;; encoding of test/asm/encode-results-amd64.edn that is not met is counted under its :by class, one of these (arbace.asm.amd64.check
;; names the class: the file's syntax, the reader's refusal, what the encoder does not encode yet, or a failure). In goi's format.
;; Read with the Clojure reader.
[
 {:id :intel
  :title "Intel syntax"
  :kind :deferred
  :why "the file is read in Intel syntax (its RUN lines' -x86-asm-syntax=intel, or a part after .intel_syntax), which repr/asm reads at AX3; the encodings are judged then, on the same encoder"
  :decided "AX1's and AX2's scope (doc/asm/AMD64-SURVEY.md §12)"}
 {:id :unread
  :title "a file AX1's reader refuses"
  :kind :deferred
  :why "the reader refuses the file (test/asm/divergences-read.edn's classes: error tests, a lexer option); its encodings follow the read"
  :decided "AX1's classes"}
 {:id :evex
  :title "EVEX (AVX-512, AVX10)"
  :kind :deferred
  :why "the instruction is EVEX-encoded, or names a register only EVEX encodes (%xmm16-31, %zmm, %k0-7): none since AX2's second slice, which encodes EVEX (P0-P2, opmasks, {z}, broadcast, embedded rounding and {sae}, disp8*N, maps 5-7, {evex}); kept for the encoder's EVEX forms not met yet"
  :decided "AX2's first slice (the base integer, x87, MMX, SSE, VEX and XOP encodings); emptied by its second slice"}
 {:id :apx
  :title "APX (REX2, the EVEX maps 4-7, %r16-31)"
  :kind :deferred
  :why "the instruction needs REX2 or the promoted EVEX map 4 forms of APX (NDD, NF, CCMP and CTEST with their {dfv=...}), or an extended GPR %r16-%r31, or asks for them with {rex2} or {evex} cmp/test (CCMP's alias): APX's slice, after EVEX"
  :decided "AX2's first slice; {rex2}, {dfv=} and {evex} cmp/test classed here by its second slice"}
 {:id :forced-encoding
  :title "{evex} or {rex2} asked"
  :kind :deferred
  :why "the statement asks for an EVEX or REX2 encoding with a pseudo prefix: none since AX2's second slice ({evex} encoded, {rex2} under :apx)"
  :decided "AX2's first slice; emptied by its second slice"}
 {:id :prefix-word
  :title "a prefix word the encoder does not take"
  :kind :deferred
  :why "a prefix written before the mnemonic that is neither lock/rep/notrack nor a prefix instruction (cs, ds, rex64, data16, xacquire, ...)"
  :decided "AX2's first slice"}
 {:id :operand-class
  :title "an operand class without its predicate"
  :kind :deferred
  :why "an AsmOperandClass whose X86Operand predicate the matcher does not have yet"
  :decided "AX2's first slice"}
 {:id :render
  :title "an operand class without its render method"
  :kind :deferred
  :why "an AsmOperandClass whose render method (addMaskPairOperands, ...) the matcher does not have yet: AVX-512's mask pairs"
  :decided "AX2's first slice"}
 {:id :form
  :title "an encoding form the encoder does not emit"
  :kind :deferred
  :why "an X86 Format (MRMDestMem4VOp3CC, MRMDestMemFSIB, ...) of the extensions after the first slice"
  :decided "AX2's first slice"}
 {:id :segment-symbol
  :title "a segment named by a symbol"
  :kind :deferred
  :why "a memory operand whose segment is an equated symbol (v_gs:(,)), which the matcher does not resolve yet"
  :decided "AX2's first slice"}
 {:id :pseudo
  :title "a pseudo instruction"
  :kind :deferred
  :why "the matched instruction is a pseudo, encoded by no bytes of its own"
  :decided "AX2's first slice"}
 {:id :other-target
  :title "a run on another target"
  :kind :by-design
  :why "the RUN line's triple names no x86 mode the check knows"
  :decided "AX2's scope"}
 {:id :not-shown
  :title "a run without -show-encoding"
  :kind :by-design
  :why "the CHECK prefix's run prints no encodings (an object read back by llvm-objdump, a disassembly): its encoding CHECK lines are another run's matter (AX4's objects)"
  :decided "AX2's scope"}
 {:id :no-run
  :title "a stated encoding no run judges"
  :kind :by-design
  :why "the CHECK line's prefix is not one an llvm-mc run of the file reads with FileCheck"
  :decided "AX2's scope"}
 {:id :unpaired
  :title "a stated encoding with no instruction left"
  :kind :pending
  :why "FileCheck's order leaves no instruction for the stated encoding (the instructions before it all met earlier lines)"
  :decided "a failure to fix"}
 {:id :mismatch
  :title "another encoding"
  :kind :pending
  :why "Arbace's encoder gives the instruction other bytes than the test states: a failure to fix"
  :decided "a failure to fix"}
 {:id :rejected
  :title "rejected where llvm-mc encodes"
  :kind :pending
  :why "the matcher or the encoder rejects a statement the test encodes: a failure to fix"
  :decided "a failure to fix"}
 {:id :crash
  :title "the encoder crashed"
  :kind :pending
  :why "an exception in the matcher or the encoder: a failure to fix"
  :decided "a failure to fix"}
]

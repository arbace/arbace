(ns go.arbace.a64idriver
  (:require [arbace.go :as go]))

(go/package main
  :path "arbace/a64idriver"
  :config {:goos "linux" :goarch "arm64" :goarm64 "v8.0" :toolchain "go1.27.1" :lang "go1.27" :tags [] :goexperiment "" :cgo false :compiler "gc"}
  :files ["main.go" "trace_linux.go"]
  :init-order []
  :positions :lines)

(load "a64idriver/main")
(load "a64idriver/trace_linux")

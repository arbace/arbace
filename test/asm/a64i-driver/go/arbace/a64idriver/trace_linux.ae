(in-ns 'go.arbace.a64idriver) (go/file "trace_linux.go" :imports [


    ^{:line 4} [fmt "fmt"]
    ^{:line 5} [os "os"]
    ^{:line 6} [strconv "strconv"]

    ^{:line 8} [a64i "arbace/a64i"]])





^{:go/end 53} (go/func trace "trace runs the lockstep (a64i.Lockstep) in the mode sys, step (A64I_STEP_LIMIT: its bound) or bisect (the sys mode, then\nat a difference the sys mode again to the last system call both agreed on and the step mode from there): one line, the\nverdict, and the loader's judge; 0 when equal, 3 when equal to the program's first thread (queue 302).\n" ^int [^string mode ^{:tag (slice string)} argv]
  (let [(values lim _) (strconv/ParseUint (os/Getenv "A64I_STEP_LIMIT") 10 64)
      ^{:line 16} opts (lit a64i/LockstepOpts :StepFrom -1)]
    (when (== mode "step")
      (set! opts (lit a64i/LockstepOpts :Step true :StepLimit lim)))

    ^{:go/breaks [[7 52]]} (let [(values r err) (a64i/Lockstep (aget argv 0) argv (os/Environ) opts)]
      (when (!= err nil)
        (fmt/Fprintf os/Stderr "a64i trace: %v\n" err)
        (return 2))

      (when (.-Thread r)
        ;; queue 302: the lockstep's end at the program's first thread, all before it equal; 3: neither equal nor different
        (fmt/Printf "a64i trace %s: EQUAL TO THE FIRST THREAD: %d system calls, %d instructions (%d stepped, %d exclusive regions), clone at %#x; the native's threads not followed\n" mode (.-Syscalls r) (.-Steps r) (.-Stepped r) (.-Exclusive r) (.-ThreadPC r))
        (fmt/Printf "loader: %s\n" (loaderLine (.-Loader r)))
        (return 3))

      (when (and (== mode "bisect") (not (.-Equal r)))
        (let [sys r]
          (when [(set! (values r err) (a64i/Lockstep (aget argv 0) argv (os/Environ) (lit a64i/LockstepOpts :StepFrom (.-Syscalls sys))))] (!= err nil)
            (fmt/Fprintf os/Stderr "a64i trace: %v\n" err)
            (return 2))

          (if (!= (.-DiffPC r) 0)
            (fmt/Printf "a64i trace bisect: DIFF at %#x %s (family %s), after %d instructions; sys: %s; step: %s\n" (.-DiffPC r) (.-DiffInst r) (.-Family r) (.-Steps r) (.-Diff sys) (.-Diff r))

            (fmt/Printf "a64i trace bisect: DIFF not bisected to an instruction; sys: %s; step: %s\n" (.-Diff sys) (.-Diff r)))

          (fmt/Printf "loader: %s\n" (loaderLine (.-Loader r)))
          (return 1)))

      (if (.-Equal r)
        (let [ret ""]
          (when (> (.-ExclusiveFailed r) 0)
            (set! ret (fmt/Sprintf ", %d of them to the next system call" (.-ExclusiveFailed r))))

          (fmt/Printf "a64i trace %s: EQUAL: %d system calls, %d instructions (%d stepped, %d exclusive regions%s), status %d\n" mode (.-Syscalls r) (.-Steps r) (.-Stepped r) (.-Exclusive r) ret (.-Status r)))

        (let [fam ""]
          (when (!= (.-DiffPC r) 0)
            (set! fam (fmt/Sprintf " (family %s) at %#x %s;" (.-Family r) (.-DiffPC r) (.-DiffInst r))))

          (fmt/Printf "a64i trace %s: DIFF%s after %d system calls, %d instructions: %s\n" mode fam (.-Syscalls r) (.-Steps r) (.-Diff r))))

      (fmt/Printf "loader: %s\n" (loaderLine (.-Loader r)))
      (when (not (.-Equal r))
        (return 1))

      0)))


^{:go/end 60} (go/func loaderLine ^string [^string s]
  (when (== s "")
    (return "EQUAL"))

  (+ "DIFF " s))

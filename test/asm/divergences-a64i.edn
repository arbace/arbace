;; a64i's check's classes (bin/repr-asm --arch arm64 a64i-check; doc/asm/ARM64-SURVEY.md "As built: AR5"): every row of
;; test/asm/a64i-results-arm64.edn that does not pass is in one of these. In goi's format. Read with the Clojure reader.
[
 {:id :eval-got
  :title "a GOT reference (:got:, :got_lo12:, :gottprel:) in the eval"
  :kind :deferred
  :why "a GOT entry is the linker's, made for a relocation; the eval lays the forms out with no relocation, so no GOT exists to load from: the program runs on its bytes (aot/NAME) and against the CPU, its eval waits for the eval's own GOT (the linker's GOT made from the forms' specifiers)"
  :decided "AR5"}
 {:id :eval-tls-model
  :title "a TLS model through the linker's descriptors (:tlsdesc:) in the eval"
  :kind :deferred
  :why "as :eval-got: TLSDESC's entries are the linker's"
  :decided "AR5"}
 {:id :unimplemented
  :title "an instruction a64i does not run"
  :kind :deferred
  :why "a64i decodes it (or reads its form) and raises SIGILL naming it on stderr, never a silent wrong result: SIMD and floating point beyond the SIMD&FP registers' loads and stores (AR6), SVE and SME (AR11), pointer authentication, the system instructions of EL1 (ARS13)"
  :decided "doc/asm/ARM64-SURVEY.md §12, AR5"}
 {:id :code-as-data
  :title "a program that reads its own code as data in the eval"
  :kind :by-design
  :why "the eval executes the forms, never encoded: its executable holds zero words where AOT's holds the instructions (§4.2)"
  :decided "doc/asm/ARM64-SURVEY.md §4.2"}
 {:id :signals
  :title "signal handlers, alternate stacks, sigreturn"
  :kind :deferred
  :why "a64i returns -ENOSYS for rt_sigaction, rt_sigprocmask, sigaltstack and rt_sigreturn: the default dispositions only; arm64's rt_sigframe is AR6's"
  :decided "AR5"}
 {:id :threads
  :title "clone, clone3, execve, futex"
  :kind :deferred
  :why "one thread in AR5: a64i returns -ENOSYS; the frame's scheduler is AR7's"
  :decided "doc/asm/ARM64-SURVEY.md §4.2"}
]

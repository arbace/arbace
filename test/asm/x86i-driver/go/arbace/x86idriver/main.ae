;; Command x86idriver is x86i's light driver (doc/asm/AMD64.md §10; AX5-DESIGN §6, AXS51 (a)): arbace/x86i, arbace/emu and
;; arbace/crt built alone by TamaGo's go, no Arbace build.
;;
;;	x86i run [--stats] EXE [ARG...]   the static executable run on x86i: its exit status, or 128 + the signal that ended it
;;	                                  (an instruction x86i does not implement: SIGILL, named on stderr)
;;	x86i run --coverage FILE EXE ...  the same, each instruction executed written into FILE: NAME FAMILY COUNT a line (AX5.5)
;;	x86i decode-text EXE              its code sections decoded instruction by instruction: ADDR HEX TEXT (the decode judge's)
;;	x86i decode-hex FILE              each line's ID HEX [...] decoded alone: ID HEX TEXT (x86i-decode-check's, AXS70 (b))
;;	x86i claimed                      the decode tables' instructions a family claims: NAME FAMILY a line
;;	x86i trace --mode sys EXE [ARG...] the lockstep's sys mode (AX5.3): EXE run natively under ptrace and on x86i, compared at
;;	                                  each system call; `equal` (status 0) or the first difference (status 1)
(in-ns 'go.arbace.x86idriver) (go/file "main.go" :doc "Command x86idriver is x86i's light driver (doc/asm/AMD64.md §10; AX5-DESIGN §6, AXS51 (a)): arbace/x86i, arbace/emu and\narbace/crt built alone by TamaGo's go, no Arbace build.\n\n\tx86i run [--stats] EXE [ARG...]   the static executable run on x86i: its exit status, or 128 + the signal that ended it\n\t                                  (an instruction x86i does not implement: SIGILL, named on stderr)\n\tx86i run --coverage FILE EXE ...  the same, each instruction executed written into FILE: NAME FAMILY COUNT a line (AX5.5)\n\tx86i decode-text EXE              its code sections decoded instruction by instruction: ADDR HEX TEXT (the decode judge's)\n\tx86i decode-hex FILE              each line's ID HEX [...] decoded alone: ID HEX TEXT (x86i-decode-check's, AXS70 (b))\n\tx86i claimed                      the decode tables' instructions a family claims: NAME FAMILY a line\n\tx86i trace --mode sys EXE [ARG...] the lockstep's sys mode (AX5.3): EXE run natively under ptrace and on x86i, compared at\n\t                                  each system call; `equal` (status 0) or the first difference (status 1)\n" :imports [


    ^{:line 15} [fmt "fmt"]
    ^{:line 16} [rand "math/rand/v2"]
    ^{:line 17} [os "os"]
    ^{:line 18} [strings "strings"]
    ^{:line 19} [time "time"]

    ^{:line 21} [crt "arbace/crt"]
    ^{:line 22} [emu "arbace/emu"]
    ^{:line 23} [x86i "arbace/x86i"]])


^{:go/end 29} (go/func usage []
  (fmt/Fprintln os/Stderr "usage: x86i run [--stats] [--coverage FILE] EXE [ARG...] | x86i decode-text EXE | x86i decode-hex FILE | x86i claimed | x86i trace --mode sys|step|bisect EXE [ARG...]")
  (os/Exit 2))


^{:go/end 74} (go/func main []
  (when (and (== (len os/Args) 2) (== (aget os/Args 1) "claimed"))
    (let [out (addr (lit strings/Builder))]
      (range [_ c (x86i/Claimed)]
        (fmt/Fprintf out "%s %s\n" (aget c 0) (aget c 1)))

      (.WriteString os/Stdout (.String out))
      (return)))

  (when (< (len os/Args) 3)
    (usage))

  (switch (aget os/Args 1)
    (case ["run"]
      (let [args (subslice os/Args 2)
          (values stats cover) (values false "")]
        (while (and (> (len args) 0) (strings/HasPrefix (aget args 0) "--"))
          (switch
            (case [(== (aget args 0) "--stats")]
              (set! (values stats args) (values true (subslice args 1))))
            (case [(and (== (aget args 0) "--coverage") (> (len args) 1))]
              (set! (values cover args) (values (aget args 1) (subslice args 2))))
            (default
              (usage))))


        (when (== (len args) 0)
          (usage))

        (os/Exit (run args stats cover))))
    (case ["trace"]
      (let [args (subslice os/Args 2)]
        (when (or (< (len args) 3) (!= (aget args 0) "--mode") ^:go/paren (and (!= (aget args 1) "sys") (!= (aget args 1) "step") (!= (aget args 1) "bisect")))
          (usage))

        (os/Exit (trace (aget args 1) (subslice args 2)))))
    (case ["decode-text"]
      (decodeText (aget os/Args 2)))
    (case ["decode-hex"]
      (decodeHex (aget os/Args 2)))
    (default
      (usage))))



^{:go/end 124} (go/func run ^int [^{:tag (slice string)} argv ^bool stats ^string cover]
  (let [as (emu/NewAS)
      (values img err) (emu/LoadELF as (aget argv 0))]
    (when (!= err nil)
      (fmt/Fprintf os/Stderr "x86i: %s: %v\n" (aget argv 0) err)
      (return 127))

    (let [^{:tag (array 16 byte)} rnd (zero (array 16 byte))] ; AT_RANDOM's bytes
      (range [i rnd]
        (aset rnd i (conv byte (rand/Uint32))))

      (let [sp (emu/Stack as img argv (os/Environ) rnd)
          ^{:line 88} sys (crt/NewSys (.-M as) os/Stdin os/Stdout os/Stderr)]
        (set! (.-Args sys) argv)
        (set! (.-Env sys) (os/Environ))
        (let [k (emu/NewKernel as img sys)]
          (when [s (os/Getenv "X86I_INJECT")] (!= s "")
            (when [err (x86i/Inject s)] (!= err nil)
              (fmt/Fprintln os/Stderr "x86i:" err)
              (return 2)))


          (let [c (x86i/New as k (.-Entry img) sp)]
            (set! (.-Pid c) 1000) ; crt's process id (a kill's siginfo), user 0
            (when (!= cover "")
              (set! (.-Cover c) (x86i/NewCover)))

            (let [t0 (time/Now)]
              (.Run c)
              (when (!= cover "")
                (let [out (addr (lit strings/Builder))]
                  (range [id n (.-Cover c)]
                    (when (!= n 0)
                      (fmt/Fprintf out "%s %s %d\n" (x86i/InsnName (conv uint16 id)) (x86i/FamilyOf (conv uint16 id)) n)))


                  (when [err (os/WriteFile cover (conv (slice byte) (.String out)) 0644)] (!= err nil)
                    (fmt/Fprintln os/Stderr "x86i:" err))))


              (when stats
                (let [el (time/Since t0)]
                  (fmt/Fprintf os/Stderr "x86i: %d instructions in %v (%.1f M/s)\n" (.-Steps c) el (/ (conv float64 (.-Steps c)) (.Seconds el) 1000000.0))))

              (when (and (!= (.-Signal c) 0) ^:go/paren (or (strings/HasPrefix (.-Reason c) ":unimplemented") (!= (os/Getenv "X86I_VERBOSE") "")))
                (fmt/Fprintf os/Stderr "x86i: signal %d: %s\n" (.-Signal c) (.-Reason c)))

              (.Status c))))))))


^{:go/end 153} (go/func decodeText [^string path]
  (let [(values f err) (emu/ReadELF path)]
    (when (!= err nil)
      (fmt/Fprintf os/Stderr "x86i: %v\n" err)
      (os/Exit 1))

    (let [out (addr (lit strings/Builder))]
      (range [_ s (.-Sections f)]
        (when (or (== (bit-and (.-Flags s) emu/SHF_EXECINSTR) 0) (!= (.-Type s) emu/SHT_PROGBITS))
          (continue))

        (let [b (.Bytes f (.-Off s) (.-Size s))]
          (for [off 0] (< off (len b)) _
            (let [(values in r) (x86i/Decode (subslice b off (min (+ off 15) (len b))) true)
                ^{:line 140} n (max (conv int (.-Len in)) 1)
                ^{:line 141} text (.Text in)]
              (switch r
                (case [x86i/DecInvalid]
                  (set! text "!invalid"))
                (case [x86i/DecUnsupported]
                  (set! text "!unsupported")))

              (fmt/Fprintf out "%x\t%x\t%s\n" (+ (.-Addr s) (conv uint64 off)) (subslice b off (+ off n)) text)
              (set! off + n)))))


      (.WriteString os/Stdout (.String out)))))


^{:go/end 213} (go/func trace ^int [^string mode ^{:tag (slice string)} argv]
  (when [s (os/Getenv "X86I_INJECT")] (!= s "")
    (when [err (x86i/Inject s)] (!= err nil)
      (fmt/Fprintln os/Stderr "x86i:" err)
      (return 2)))


  (let [opts (lit x86i/LockstepOpts :StepFrom -1)]
    (when (== mode "step")
      (set! opts (lit x86i/LockstepOpts :Step true))
      (when [s (os/Getenv "X86I_STEP_LIMIT")] (!= s "")
        (fmt/Sscan s (addr (.-StepLimit opts)))))


    (let [t0 (time/Now)
        (values r err) (x86i/Lockstep (aget argv 0) argv (os/Environ) opts)]
      (when (!= err nil)
        (fmt/Fprintf os/Stderr "x86i trace: %v\n" err)
        (return 2))

      (let [^{:tag (* x86i/LockstepResult)} sys (zero (* x86i/LockstepResult))]
        (when (and (== mode "bisect") (not (.-Equal r)))
          ;; the sys mode's difference bisected: the sys mode to the last system call both agreed on, then the step mode
          (set! sys r)
          (let [from (max (- (.-DiffSyscall r) 1) 0)]
            (when (== (.-DiffSyscall r) 0)
              (set! from (.-Syscalls r)))

            (set! t0 (time/Now))
            (when [(set! (values r err) (x86i/Lockstep (aget argv 0) argv (os/Environ) (lit x86i/LockstepOpts :Step true :StepFrom from)))] (!= err nil)
              (fmt/Fprintf os/Stderr "x86i trace: %v\n" err)
              (return 2))))


        (let [el (time/Since t0)
            ^{:line 190} st 0]
          (switch
            (case [(and (!= sys nil) (!= (.-Inst r) ""))]
              (fmt/Printf "x86i trace bisect: DIFF at %#x %s (family %s), after %d instructions; sys: %s; step: %s\n" (.-At r) (.-Inst r) (.-Family r) (.-Steps r) (.-Diff sys) (.-Diff r))
              (set! st 1))
            (case [(!= sys nil)]
              (fmt/Printf "x86i trace bisect: DIFF not bisected to an instruction; sys: %s; step: %s\n" (.-Diff sys) (.-Diff r))
              (set! st 1))
            (case [(and (.-Equal r) (== mode "step"))]
              (fmt/Printf "x86i trace step: equal: %d instructions compared (of %d), %d system calls, status %d, %.0f instructions/s\n" (.-Stepped r) (.-Steps r) (.-Syscalls r) (.-Status r) (/ (conv float64 (.-Stepped r)) (.Seconds el))))
            (case [(.-Equal r)]
              (fmt/Printf "x86i trace %s: equal: %d system calls, %d instructions, status %d\n" mode (.-Syscalls r) (.-Steps r) (.-Status r)))
            (default
              (fmt/Printf "x86i trace %s: DIFF after %d instructions: %s\n" mode (.-Steps r) (.-Diff r))
              (set! st 1)))

          (if (== (.-Loader r) "")
            (fmt/Println "x86i loader: equal")
            (do
              (fmt/Printf "x86i loader: DIFF: %s\n" (.-Loader r))
              (set! st 1)))

          ^{:line 212} st)))))




^{:go/end 250} (go/func decodeHex "decodeHex decodes each line's bytes (ID TAB HEX [TAB TEXT TAB SIZE]) alone, as x86i-decode-check's lines: ID TAB HEX TAB TEXT,\nthe text `!invalid`, `!unsupported`, or `!length N` when the decoding's length is not SIZE (or, without one, every byte).\n" [^string path]
  (let [(values data err) (os/ReadFile path)]
    (when (!= err nil)
      (fmt/Fprintf os/Stderr "x86i: %v\n" err)
      (os/Exit 1))

    (let [out (addr (lit strings/Builder))]
      (range [_ l (strings/Split (conv string data) "\n")]
        (let [f (strings/Split l "\t")]
          (when (< (len f) 2)
            (continue))

          (let [b (make (slice byte) (/ (len (aget f 1)) 2))]
            (range [i b]
              (fmt/Sscanf (subslice (aget f 1) (* 2 i) (+ (* 2 i) 2)) "%02x" (addr (aget b i))))

            (let [want (len b)]
              (when (>= (len f) 4)
                (fmt/Sscanf (aget f 3) "%d" (addr want)))

              (let [(values in r) (x86i/Decode b true)
                  ^{:line 238} text (.Text in)]
                (switch
                  (case [(== r x86i/DecInvalid)]
                    (set! text "!invalid"))
                  (case [(== r x86i/DecUnsupported)]
                    (set! text "!unsupported"))
                  (case [(!= (conv int (.-Len in)) want)]
                    (set! text (fmt/Sprintf "!length %d %s" (.-Len in) text))))

                (fmt/Fprintf out "%s\t%s\t%s\n" (aget f 0) (aget f 1) text))))))

      (.WriteString os/Stdout (.String out)))))

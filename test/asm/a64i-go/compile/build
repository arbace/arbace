# N DIR PKG [IMPORT=FILE...] (a64i_go_tool, bin/repr-asm): the import configurations go build -trimpath writes for p and for r, r's
# a64ic/p the compile run's own p.a
p . ./p
r . ./r a64ic/p=out/p.a
# AR23 (queue 295): m's (a64ic/p and a64ic/r the runs' own), and the link's: m and every package it depends on, the runs' own m.a, p.a
# (with add_arm64.o packed in) and r.a
m . ./m a64ic/p=out/p.a a64ic/r=out/r.a
ml . ./m -link a64ic/m=out/m.a a64ic/p=out/p.a a64ic/r=out/r.a

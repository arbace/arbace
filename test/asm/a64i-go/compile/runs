# ID FILES ARGS (a64i_go_tool, bin/repr-asm), in this order on one copy of the inputs: the tool, then its arguments as go build -trimpath
# -x runs it for a64ic/p and a64ic/r, $WORK/b001 made out/, the package's directory $PWD's p (r), -buildid a fixed one (go's is the
# action's hash, the host's tools' own); then the listing (-S, into a file: digested), the unoptimized build and the errors (compile's
# on stdout)
version - compile -V=full
symabis out/symabis asm -p a64ic/p -trimpath "$PWD/p=>a64ic/p;$PWD/out=>" -I out/ -I goroot/pkg/include -D GOOS_linux -D GOARCH_arm64 -gensymabis -o out/symabis p/add_arm64.s
compile out/p.a,out/go_asm.h compile -o out/p.a -trimpath "$PWD/p=>a64ic/p;$PWD/out=>" -p a64ic/p -lang=go1.27 -buildid a64ic-p/a64ic-p -goversion go1.27.1 -symabis out/symabis -c=4 -nolocalimports -importcfg work/p/importcfg -pack -asmhdr out/go_asm.h p/p.go p/q.go
asm out/add_arm64.o asm -p a64ic/p -trimpath "$PWD/p=>a64ic/p;$PWD/out=>" -I out/ -I goroot/pkg/include -D GOOS_linux -D GOARCH_arm64 -o out/add_arm64.o p/add_arm64.s
r out/r.a compile -o out/r.a -trimpath "$PWD/r=>a64ic/r;$PWD/out=>" -p a64ic/r -lang=go1.27 -complete -buildid a64ic-r/a64ic-r -goversion go1.27.1 -c=4 -nolocalimports -importcfg work/r/importcfg -pack r/r.go
listing out/listing.s,out/rs.a compile -S -o out/rs.a -trimpath "$PWD/r=>a64ic/r;$PWD/out=>" -p a64ic/r -lang=go1.27 -complete -buildid a64ic-r/a64ic-r -goversion go1.27.1 -c=4 -nolocalimports -importcfg work/r/importcfg -pack r/r.go > out/listing.s
noopt out/pn.a compile -N -l -o out/pn.a -trimpath "$PWD/p=>a64ic/p;$PWD/out=>" -p a64ic/p -lang=go1.27 -buildid a64ic-p/a64ic-p -goversion go1.27.1 -symabis out/symabis -c=4 -nolocalimports -importcfg work/p/importcfg -pack p/p.go p/q.go
bad - compile -o out/bad.a -trimpath "$PWD/bad=>a64ic/bad;$PWD/out=>" -p a64ic/bad -lang=go1.27 -complete -goversion go1.27.1 -nolocalimports -importcfg work/p/importcfg -pack bad/bad.go
asmbad - asm -p a64ic/bad -trimpath "$PWD/bad=>a64ic/bad;$PWD/out=>" -I out/ -I goroot/pkg/include -D GOOS_linux -D GOARCH_arm64 -o out/bad.o bad/bad_arm64.s
missing - compile -o out/m.a -p a64ic/m -importcfg work/p/importcfg nosuch.go
# AR23 (queue 295): cmd/link as go build -trimpath -x runs it: the assembly's object packed into p.a (go build's pack r), m compiled
# against the runs' p.a and r.a, linked (GOROOT unset, a fixed -buildid, no modinfo) into out/m, the executable byte for byte the M2's;
# then out/m run, on a64i the one a64i linked: its output, then with an argument (status 3); the linker's version
pack out/p.a pack r out/p.a out/add_arm64.o
m out/m.a compile -o out/m.a -trimpath "$PWD/m=>a64ic/m;$PWD/out=>" -p main -lang=go1.27 -complete -buildid a64ic-m/a64ic-m -goversion go1.27.1 -c=4 -nolocalimports -importcfg work/m/importcfg -pack m/main.go
link out/m link -o out/m -importcfg work/ml/importcfg -buildmode=exe -buildid=a64ic-m/a64ic-m -extld=gcc out/m.a
run - ./out/m
runarg - ./out/m x
linkv - link -V=full

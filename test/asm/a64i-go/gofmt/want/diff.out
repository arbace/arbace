diff messy.go.orig messy.go
--- messy.go.orig
+++ messy.go
@@ -1,15 +1,28 @@
 // messy is gofmt's input (a64i go-check, AR21): unformatted, with what -s simplifies and -r rewrites
 package messy
-import ( "fmt"
-"strings" )
+
+import (
+	"fmt"
+	"strings"
+)
+
 type P struct{ X, Y int }
-var ps = []P{ P{1,2}, P{ 3, 4 } }
-var m = map[string]P{"a": P{5, 6}}
-func   F(s string, a int)string{
-	for i, _ := range ps { _ = i }
-	if len(s)>a { s = s[a:len(s)] }
-		x := strings.TrimSpace( s )
-	switch { case x=="": return "empty"
-	default: }
-	return fmt.Sprint(x,m)   // a comment
+
+var ps = []P{{1, 2}, {3, 4}}
+var m = map[string]P{"a": {5, 6}}
+
+func F(s string, a int) string {
+	for i := range ps {
+		_ = i
+	}
+	if len(s) > a {
+		s = s[a:]
+	}
+	x := strings.TrimSpace(s)
+	switch {
+	case x == "":
+		return "empty"
+	default:
+	}
+	return fmt.Sprint(x, m) // a comment
 }

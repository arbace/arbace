;; goi's milestone GR3 (doc/go/GOI-SPEC.md §2, §12): Go forms at the REPL, against expected values
;; written by hand: declarations through arbace.go's macros, calls from Arbace, redefinition
;; (cells, generations of types, dependents), package variables and their initialization,
;; constants, go/eval, loading a package of several files from ARBACE_PATH, check errors,
;; panics and os.Exit leaving Go. Run by bin/goi test and bin/arbace-go --smoke (ARBACE_PATH
;; with test/goi/repl-pkgs): it prints each failure, then "goi repl: N passed, M failed", and
;; exits 1 when one failed.
(ns goi.repl-test
  (:require [arbace.go :as go]))

(def passed (atom 0))
(def failed (atom []))

(defn check* [form expected f]
  (let [actual (try (f) (catch Throwable e [:threw (.getName (class e)) (ex-message e)]))]
    (if (= expected actual)
      (swap! passed inc)
      (swap! failed conj [form expected actual]))))

(defmacro is
  "expr's value is expected (=)."
  [expected expr]
  `(check* '~expr ~expected (fn [] ~expr)))

;; ---------------------------------------------------------------------------------------
;; A package typed at the REPL (S2: its package made by its first declaration)

(ns go.rt.demo (:require [arbace.go :as go]))

(go/import [strings "strings"] [fmt "fmt"] [os "os"])
(go/func Greet ^string [^string name] (+ "hello, " (strings/ToUpper name)))
(go/func Twice ^string [^string name] (+ (Greet name) " " (Greet name)))
(goi.repl-test/is "hello, GO" (Greet "go"))
(goi.repl-test/is "hello, A hello, A" (Twice "a"))
(goi.repl-test/is :func (:go/kind (meta #'Greet)))

;; redefinition: the cell keeps, callers see the new code (§2.5, G9)
(go/func Greet ^string [^string name] (+ "hi, " name))
(goi.repl-test/is "hi, a hi, a" (Twice "a"))

;; panics leave Go as GoPanic with gc's text (§10.4)
(go/func Div ^int [^int a ^int b] (/ a b))
(goi.repl-test/is 3 (Div 7 2))
(goi.repl-test/is ["runtime error: integer divide by zero" "runtime.errorString"]
                  (try (Div 1 0) (catch arbace.lang.GoPanic e [(ex-message e) (:go/type (ex-data e))])))
(go/func Fail [^string s] (panic (+ "failed: " s)))
(goi.repl-test/is "failed: x" (try (Fail "x") (catch arbace.lang.GoPanic e (ex-message e))))

;; package variables: initialized when defined (S11), shared with Go code, assigned from Arbace
(go/var counter 10)
(go/func Inc ^int [] (inc! counter) counter)
(goi.repl-test/is [11 12 12] [(Inc) (Inc) @counter])
(go/assign! counter 100)
(goi.repl-test/is 101 (Inc))
(go/var counter 5)                       ; the same type: the same variable, the new initializer
(goi.repl-test/is 6 (Inc))
(go/var ^{:tag (slice string)} names (lit (slice string) "a" "b"))
(goi.repl-test/is "[a b]" (go/str @names))

;; constants, multiple results, variadic functions, closures
(go/const ^{:val 3} Three 3)
(goi.repl-test/is 3 Three)
(go/func DivMod [^int a ^int b] :results [^int q ^int r] (set! q (/ a b)) (set! r (% a b)) (return))
(goi.repl-test/is [2 1] (DivMod 7 3))
(go/func Sum ^int [& ^{:tag (slice int)} xs] (let [t 0] (range [_ x xs] (set! t + x)) t))
(goi.repl-test/is [6 0] [(Sum 1 2 3) (Sum)])
(go/func Adder ^{:tag (func [int] [int])} [^int n] (fn ^int [^int x] (+ x n)))
(goi.repl-test/is 15 ((Adder 10) 5))

;; types: a struct type, its values from Arbace, its generations (§2.5 item 5)
(go/type Point (struct ^int X ^int Y))
(go/func Norm1 ^int [^Point p] (+ (.-X p) (.-Y p)))
(goi.repl-test/is 7 (Norm1 (Point {:X 3 :Y 4})))
(go/func Make ^Point [^int x] (lit Point x (* 2 x)))
(goi.repl-test/is "{1 2}" (go/str (Make 1)))
(go/type Point (struct ^int X ^int Y))   ; the same underlying type: the same generation
(goi.repl-test/is 3 (Norm1 (Make 1)))
(go/type Point (struct ^int X ^int Y ^int Z))   ; a new generation; its dependents rebuilt
(go/func Norm1 ^int [^Point p] (+ (.-X p) (.-Y p) (.-Z p)))
(go/func Make ^Point [^int x] (lit Point x x x))
(goi.repl-test/is 6 (Norm1 (Make 2)))

;; go/eval (§2.4): Go statements, the last one's value
(goi.repl-test/is 3 (go/eval (+ 1 2)))
(goi.repl-test/is "hi, x" (go/eval (Greet "x")))
(goi.repl-test/is ["a" "b" true] (go/eval (strings/Cut "a=b" "=")))
(goi.repl-test/is 30 (go/eval (let [s 0] (for [i 0] (< i 4) (inc! i) (set! s + (* i i))) (+ s 16))))
(goi.repl-test/is 7 (go/eval (Inc)))
(goi.repl-test/is nil (go/eval (set! counter 0)))

;; check errors: the declaration rejected, nothing defined (§3.8)
(goi.repl-test/is ["cannot use \"x\" (untyped string constant) as int value in return statement"]
                  (try (go/func Bad ^int [] "x") (catch Exception e (mapv :msg (:go/errors (ex-data e))))))
(goi.repl-test/is nil (resolve 'go.rt.demo/Bad))

;; os.Exit at the REPL: GoExit, the deferred calls run (S12)
(go/var ran false)
(go/func Quit [] (defer ((fn [] (set! ran true)))) (os/Exit 4))
(goi.repl-test/is [4 true] (try (Quit) (catch arbace.lang.GoExit e [(.status e) @ran])))

;; ---------------------------------------------------------------------------------------
;; A package of two files loaded from ARBACE_PATH (§2.3): checked whole when its load ends,
;; initialized (variables in order, then init), imported by a REPL package

(in-ns 'goi.repl-test)
(require '[go.rt.lib :as lib])
(is "HEY!" (lib/Shout "hey"))
(is "[0 1 4 99]" (go/str @lib/Table))

(ns go.rt.app (:require [arbace.go :as go]))
(go/import [lib "rt/lib"] [fmt "fmt"])
(go/func Count ^int [] (len lib/Table))
(goi.repl-test/is 4 (Count))
(go/func main [] (fmt/Print ""))
(goi.repl-test/is nil (go/run-main 'go.rt.app))

;; ---------------------------------------------------------------------------------------
;; A go.* namespace without the alias: the first go/ head loads arbace.go and aliases it (S4)

(ns go.rt.auto)
(go/func One ^int [] 1)
(goi.repl-test/is 1 (One))

;; ---------------------------------------------------------------------------------------

(in-ns 'goi.repl-test)
(doseq [[form expected actual] @failed]
  (println "FAIL" (pr-str form))
  (println "  expected:" (pr-str expected))
  (println "  got:     " (pr-str actual)))
(println (str "goi repl: " @passed " passed, " (count @failed) " failed"))
(when (seq @failed) (System/exit 1))

;; goi's milestone GR3 (doc/go/GOI-SPEC.md §2, §12): Go forms at the REPL, against expected values
;; written by hand: declarations through arbace.go's macros, calls from Arbace, redefinition
;; (cells, generations of types, dependents), package variables and their initialization,
;; constants, go/eval, loading a package of several files from ARBACE_PATH, check errors,
;; panics and os.Exit leaving Go. Run by bin/goi test and bin/arbace-go --smoke (ARBACE_PATH
;; with test/goi/repl-pkgs): it prints each failure, then "goi repl: N passed, M failed", and
;; exits 1 when one failed.
(ns goi.repl-test
  (:require [arbace.go :as go]))

(def passed (atom 0))
(def failed (atom []))

(defn check* [form expected f]
  (let [actual (try (f) (catch Throwable e [:threw (.getName (class e)) (ex-message e)]))]
    (if (= expected actual)
      (swap! passed inc)
      (swap! failed conj [form expected actual]))))

(defmacro is
  "expr's value is expected (=)."
  [expected expr]
  `(check* '~expr ~expected (fn [] ~expr)))

;; ---------------------------------------------------------------------------------------
;; A package typed at the REPL (S2: its package made by its first declaration)

(ns go.rt.demo (:require [arbace.go :as go]))

(go/import [strings "strings"] [fmt "fmt"] [os "os"])
(go/func Greet ^string [^string name] (+ "hello, " (strings/ToUpper name)))
(go/func Twice ^string [^string name] (+ (Greet name) " " (Greet name)))
(goi.repl-test/is "hello, GO" (Greet "go"))
(goi.repl-test/is "hello, A hello, A" (Twice "a"))
(goi.repl-test/is :func (:go/kind (meta #'Greet)))

;; redefinition: the cell keeps, callers see the new code (§2.5, G9)
(go/func Greet ^string [^string name] (+ "hi, " name))
(goi.repl-test/is "hi, a hi, a" (Twice "a"))

;; panics leave Go as GoPanic with gc's text (§10.4)
(go/func Div ^int [^int a ^int b] (/ a b))
(goi.repl-test/is 3 (Div 7 2))
(goi.repl-test/is ["runtime error: integer divide by zero" "runtime.errorString"]
                  (try (Div 1 0) (catch arbace.lang.GoPanic e [(ex-message e) (:go/type (ex-data e))])))
(go/func Fail [^string s] (panic (+ "failed: " s)))
(goi.repl-test/is "failed: x" (try (Fail "x") (catch arbace.lang.GoPanic e (ex-message e))))

;; package variables: initialized when defined (S11), shared with Go code, assigned from Arbace
(go/var counter 10)
(go/func Inc ^int [] (inc! counter) counter)
(goi.repl-test/is [11 12 12] [(Inc) (Inc) @counter])
(go/assign! counter 100)
(goi.repl-test/is 101 (Inc))
(go/var counter 5)                       ; the same type: the same variable, the new initializer
(goi.repl-test/is 6 (Inc))
(go/var ^{:tag (slice string)} names (lit (slice string) "a" "b"))
(goi.repl-test/is "[a b]" (go/str @names))

;; constants, multiple results, variadic functions, closures
(go/const ^{:val 3} Three 3)
(goi.repl-test/is 3 Three)
(go/func DivMod [^int a ^int b] :results [^int q ^int r] (set! q (/ a b)) (set! r (% a b)) (return))
(goi.repl-test/is [2 1] (DivMod 7 3))
(go/func Sum ^int [& ^{:tag (slice int)} xs] (let [t 0] (range [_ x xs] (set! t + x)) t))
(goi.repl-test/is [6 0] [(Sum 1 2 3) (Sum)])
(go/func Adder ^{:tag (func [int] [int])} [^int n] (fn ^int [^int x] (+ x n)))
(goi.repl-test/is 15 ((Adder 10) 5))

;; types: a struct type, its values from Arbace, its generations (§2.5 item 5)
(go/type Point (struct ^int X ^int Y))
(go/func Norm1 ^int [^Point p] (+ (.-X p) (.-Y p)))
(goi.repl-test/is 7 (Norm1 (Point {:X 3 :Y 4})))
(go/func Make ^Point [^int x] (lit Point x (* 2 x)))
(goi.repl-test/is "{1 2}" (go/str (Make 1)))
(go/type Point (struct ^int X ^int Y))   ; the same underlying type: the same generation
(goi.repl-test/is 3 (Norm1 (Make 1)))
(go/type Point (struct ^int X ^int Y ^int Z))   ; a new generation; its dependents rebuilt
(go/func Norm1 ^int [^Point p] (+ (.-X p) (.-Y p) (.-Z p)))
(go/func Make ^Point [^int x] (lit Point x x x))
(goi.repl-test/is 6 (Norm1 (Make 2)))

;; go/eval (§2.4): Go statements, the last one's value
(goi.repl-test/is 3 (go/eval (+ 1 2)))
(goi.repl-test/is "hi, x" (go/eval (Greet "x")))
(goi.repl-test/is ["a" "b" true] (go/eval (strings/Cut "a=b" "=")))
(goi.repl-test/is 30 (go/eval (let [s 0] (for [i 0] (< i 4) (inc! i) (set! s + (* i i))) (+ s 16))))
(goi.repl-test/is 7 (go/eval (Inc)))
(goi.repl-test/is nil (go/eval (set! counter 0)))

;; check errors: the declaration rejected, nothing defined (§3.8)
(goi.repl-test/is ["cannot use \"x\" (untyped string constant) as int value in return statement"]
                  (try (go/func Bad ^int [] "x") (catch Exception e (mapv :msg (:go/errors (ex-data e))))))
(goi.repl-test/is nil (resolve 'go.rt.demo/Bad))

;; os.Exit at the REPL: GoExit, the deferred calls run (S12)
(go/var ran false)
(go/func Quit [] (defer ((fn [] (set! ran true)))) (os/Exit 4))
(goi.repl-test/is [4 true] (try (Quit) (catch arbace.lang.GoExit e [(.status e) @ran])))

;; ---------------------------------------------------------------------------------------
;; A package of two files loaded from ARBACE_PATH (§2.3): checked whole when its load ends,
;; initialized (variables in order, then init), imported by a REPL package

(in-ns 'goi.repl-test)
(require '[go.rt.lib :as lib])
(is "HEY!" (lib/Shout "hey"))
(is "[0 1 4 99]" (go/str @lib/Table))

(ns go.rt.app (:require [arbace.go :as go]))
(go/import [lib "rt/lib"] [fmt "fmt"])
(go/func Count ^int [] (len lib/Table))
(goi.repl-test/is 4 (Count))
(go/func main [] (fmt/Print ""))
(goi.repl-test/is nil (go/run-main 'go.rt.app))

;; ---------------------------------------------------------------------------------------
;; A go.* namespace without the alias: the first go/ head loads arbace.go and aliases it (S4)

(ns go.rt.auto)
(go/func One ^int [] 1)
(goi.repl-test/is 1 (One))

;; ---------------------------------------------------------------------------------------
;; GR5: the crossings (§7.3, §7.5, §7.6, §10.4, §10.6, §5.7, GS7, GS10, G15)

(in-ns 'goi.repl-test)
(require '[go.strings] '[go.sort])

(ns go.rt.cross (:require [arbace.go :as go]))
(go/import [fmt "fmt"] [strings "strings"] [arbace "arbace"] [errors "errors"])

;; Arbace fns as Go func values (§7.5): for an interpreted function's parameter, for compiled Go's
(go/func Apply ^int [^{:tag (func [int] [int])} f ^int x] (f x))
(goi.repl-test/is 42 (Apply (fn [x] (* 2 x)) 21))
(goi.repl-test/is "HELLO" (go.strings/Map (fn [r] (- r 32)) "hello"))
(go/func Ints ^{:tag (slice int)} [] (lit (slice int) 3 1 2))
(goi.repl-test/is [1 2 3] (let [xs (Ints)] (go.sort/Slice xs (fn [i j] (< (nth xs i) (nth xs j)))) (vec (seq xs))))
(goi.repl-test/is "boom" (try (Apply (fn [x] (throw (ex-info "boom" {}))) 1) (catch Exception e (ex-message e))))
(goi.repl-test/is arbace.lang.ExceptionInfo
                  (try (Apply (fn [x] (throw (ex-info "boom" {}))) 1) (catch Exception e (class e))))
(goi.repl-test/is "java.lang.ClassCastException"
                  (try (Apply (fn [x] "s") 1) (catch Exception e (.getName (class e)))))
;; a GoPanic that goi made, thrown back into Go by an Arbace fn, panics with its Go value (S50)
(go/func Div ^int [^int a ^int b] (/ a b))
(go/func Catch [^{:tag (func [])} f] :results [^string r] (defer ((fn [] (set! r (fmt/Sprint (recover)))))) (f) (return))
(goi.repl-test/is "runtime error: integer divide by zero" (Catch (fn [] (Div 1 0))))
(goi.repl-test/is "<nil>" (Catch (fn [] nil)))

;; GoPanic (§10.4): gc's text, the Java exception of a run-time error as its cause (GS11), the
;; interpreted frames in its ex-data and first in its stack trace (§10.6)
(go/func Deep ^int [^int n] (when (== n 0) (return (/ 1 n))) (Deep (- n 1)))
(goi.repl-test/is ["runtime error: integer divide by zero" java.lang.ArithmeticException
                   '[go.rt.cross/Deep go.rt.cross/Deep go.rt.cross/Deep] "go.rt.cross" "Deep" true]
                  (try (Deep 2)
                       (catch arbace.lang.GoPanic e
                         (let [tr (:go/trace (ex-data e))
                               st (first (.getStackTrace e))]
                           [(ex-message e) (class (ex-cause e)) (mapv first tr) (.getClassName st) (.getMethodName st)
                            (= (nth (first tr) 2) (:line (meta #'Deep)))]))))
(go/type MyErr (struct ^string M))
(go/method Error ^string [^MyErr e] (+ "my error: " (.-M e)))
(go/func Fail [^int k]
  (switch k
    (case [0] (panic (fmt/Errorf "e%d" 7)))
    (case [1] (panic 1.5))
    (case [2] (panic (lit MyErr "x")))
    (case [3] (panic (errors/New "plain")))))
(goi.repl-test/is ["e7" "+1.500000e+000" "my error: x" "plain"]
                  (mapv #(try (Fail %) (catch arbace.lang.GoPanic e (ex-message e))) [0 1 2 3]))
(goi.repl-test/is nil (try (Fail 2) (catch arbace.lang.GoPanic e (ex-cause e))))

;; methods as vars T.M, the receiver first (§2.1, §7.1)
(go/type P (struct ^int X ^int Y))
(goi.repl-test/is 'go.rt.cross/P.Sum (symbol (go/method Sum ^int [^P p] (+ (.-X p) (.-Y p)))))
(go/method Scale [^{:tag (* P)} p ^int k] (set! (.-X p) (* k (.-X p))) (set! (.-Y p) (* k (.-Y p))))
(go/func MkP ^P [^int x ^int y] (lit P x y))
(goi.repl-test/is 3 (go.rt.cross/P.Sum (MkP 1 2)))
(go/func NewP ^{:tag (* P)} [^int x ^int y] (addr (lit P x y)))
(goi.repl-test/is 9 (let [p (NewP 1 2)] (go.rt.cross/P.Scale p 3) (go.rt.cross/P.Sum p)))

;; Go values printed with goi's type names (§5.7), an old generation's with its number
(goi.repl-test/is "#go \"cross.P{X:1, Y:2}\"" (pr-str (MkP 1 2)))
(def old-p (MkP 5 6))
(go/type P (struct ^int X ^int Y ^int Z))
(go/func MkP ^P [^int x ^int y] (lit P x y 0))
(goi.repl-test/is ["cross.P#1{X:5, Y:6}" "cross.P{X:1, Y:2, Z:0}"] [(str old-p) (str (MkP 1 2))])

;; interop on Go values (GS10): methods (the table's for compiled types), fields
(goi.repl-test/is [2 "ab"] (let [b (go/new go.strings/Builder)] (.WriteString b "ab") [(.Len b) (.String b)]))
(go/method Sum ^int [^P p] (+ (.-X p) (.-Y p) (.-Z p)))
(goi.repl-test/is [3 1 2] (let [p (MkP 1 2)] [(.Sum p) (.-X p) (.Y p)]))

;; Go values in Arbace's collection protocols, read-only (GS7)
(go/func M ^{:tag (map string int)} [] (lit (map string int) ["a" 1] ["b" 2]))
(goi.repl-test/is [3 3 [3 1 2] 2 nil 9] (let [xs (Ints)] [(count xs) (nth xs 0) (vec xs) (get (M) "b") (get (M) "z") (get xs 5 9)]))
(goi.repl-test/is [{"a" 1 "b" 2} 2 1 2 nil] (let [p (MkP 1 2)] [(into {} (M)) (count (M)) (:X p) (get p :Y) (:x p)]))

;; Go forms calling Arbace: the package arbace (§7.3)
(go/func CallInc ^int64 [^int64 x] (arbace/Long (arbace/Call (arbace/Var "arbace.core/inc") x)))
(goi.repl-test/is 42 (CallInc 41))
(go/func Names ^string [] (arbace/GoStr (arbace/Call "arbace.core/str" (arbace/Kw "a/b") (arbace/Sym "s") 1)))
(goi.repl-test/is ":a/bs1" (Names))
(go/func SumSeq ^int64 [^any coll] (let [t (conv int64 0)] (range [x (arbace/Seq coll)] (set! t + (arbace/Long x))) t))
(goi.repl-test/is [6 0] [(SumSeq [1 2 3]) (SumSeq nil)])
(go/func Upper ^string [^any s] (arbace/GoStr (arbace/Invoke s "toUpperCase")))
(goi.repl-test/is "ABC" (Upper "abc"))
(go/func Truthy ^bool [^any x] (arbace/Bool x))
(goi.repl-test/is [false false true true] (mapv Truthy [nil false 0 ""]))
(go/func MkFn ^any [] (arbace/Fn (fn ^any [& ^{:tag (slice any)} xs] (len xs))))
(goi.repl-test/is 3 ((MkFn) 1 2 3))
(go/func Deref1 ^any [^any v] (arbace/Deref v))
(goi.repl-test/is 5 (Deref1 (atom 5)))

;; Java forms and Go forms through vars (§7.6)
(in-ns 'goi.repl-test)
(defclass ^:public CrossGo
  (constructor ^:public [this])
  (method ^:public ^:static twice ^Object [x]
    (.invoke (arbace.lang.RT/var "go.rt.cross" "Apply") (arbace.lang.RT/var "arbace.core" "inc") x))
  (method ^:public shout ^String [this ^String s] (.toUpperCase s)))
(is 8 (CrossGo/twice 7))
(def cross-obj (CrossGo.))
(in-ns 'go.rt.cross)
(go/func Shout ^string [^any obj] (arbace/GoStr (arbace/Invoke obj "shout" "hi")))
(goi.repl-test/is "HI" (Shout goi.repl-test/cross-obj))

;; go/run-compiled (G15): the package's program built by gc and run as a child process
(ns go.rt.hello (:require [arbace.go :as go]))
(go/package main)
(go/import [fmt "fmt"] [os "os"])
(go/func main [] (fmt/Println "hello from gc" (len os/Args)) (os/Exit 3))
(goi.repl-test/is {:out "hello from gc 2\n" :err "" :exit 3} (go/run-compiled 'go.rt.hello "x"))

;; generics (GR6, §9): a generic function and a generic type at the REPL, their instances in Go
;; functions called from Arbace, the generic function redefined (its instances' callers see the
;; new code), go/eval inferring type arguments, the interpretable package slices (§9.3)
(ns go.rt.gen (:require [arbace.go :as go]))
(go/import [fmt "fmt"] [slices "slices"])
(go/type Num (interface (| (tilde int) (tilde float64))))
(go/func Pick :type-params [^Num T] ^T [^T a ^:go/grouped ^T b] (if (> a b) (return a) (return b)))
(go/func PickInt ^int [^int a ^int b] (Pick a b))
(go/func PickF ^float64 [^float64 a ^float64 b] (Pick a b))
(goi.repl-test/is [7 2.5] [(PickInt 3 7) (PickF 2.5 1.0)])
(go/func Pick :type-params [^Num T] ^T [^T a ^:go/grouped ^T b] (if (< a b) (return a) (return b)))
(goi.repl-test/is [3 1.0] [(PickInt 3 7) (PickF 2.5 1.0)])
(goi.repl-test/is 1 (go/eval (Pick 1 2)))
(go/type Stack :type-params [T] (struct ^{:tag (slice T)} items))
(go/method Push [^{:tag (* (Stack T))} s ^T x] (set! (.-items s) (append (.-items s) x)))
(go/method Len ^int [^{:tag (* (Stack T))} s] (len (.-items s)))
(go/func Fill ^int [^int n]
  (let [^{:tag (Stack string)} s (zero (Stack string))]
    (range [i n] (.Push (addr s) (fmt/Sprint i)))
    (.Len (addr s))))
(goi.repl-test/is 4 (Fill 4))
(go/func SortedDemo ^string [] (let [ys (lit (slice int) 3 1 2)] (slices/Sort ys) (fmt/Sprint ys (slices/Index ys 3))))
(goi.repl-test/is "[1 2 3] 2" (SortedDemo))

;; reify of Go interfaces (G13, GR7b): an Arbace reify naming interfaces of goi's table is a Go
;; value of each where compiled and interpreted Go code takes one (the interface's wrapper, a
;; proxy in an any), its methods Arbace fns of the object; the object comes back to Arbace as
;; itself
(require '[go.fmt] '[go.io] '[go.sort])
(ns go.rt.reify (:require [arbace.go :as go]))
(go/import [fmt "fmt"] [io "io"])
(go/func Describe ^string [^{:tag fmt/Stringer} s] (+ "<" (.String s) ">"))
(go/func IsStringer ^bool [^any x] (let [(values _ ok) (assert fmt/Stringer x)] ok))
(go/func Id ^any [^any x] x)
(go/func Fill ^int [^{:tag (slice byte)} p ^string s] (copy p s))
(go/func ReadAllString ^string [^{:tag io/Reader} r]
  (let [(values b err) (io/ReadAll r)]
    (if (!= err nil) (return (+ "error: " (.Error err))) (return (conv string b)))))
(in-ns 'goi.repl-test)
(def stringer (let [n 3] (reify go.fmt/Stringer (String [_] (str "n=" n)))))
(is "n=3" (go.fmt/Sprint stringer))
(is "<n=3>" (go.rt.reify/Describe stringer))
(is true (go.rt.reify/IsStringer stringer))
(is false (go.rt.reify/IsStringer "x"))
(is true (identical? stringer (go.rt.reify/Id stringer)))
;; this is the object, which may implement Arbace's interfaces too
(is "count 5" (go.fmt/Sprint (reify go.fmt/Stringer (String [this] (str "count " (count this)))
                                    arbace.lang.Counted (count [_] 5))))
;; io.Reader: compiled io.ReadAll reads through the wrapper, the fn writes the Go slice it is given
(defn chunks-reader [chunks]
  (let [left (atom chunks)]
    (reify go.io/Reader
      (Read [_ p]
        (if-let [c (first @left)]
          (do (swap! left rest) [(go.rt.reify/Fill p c) nil])
          [0 @go.io/EOF])))))
(is "abcdef" (go.rt.reify/ReadAllString (chunks-reader ["ab" "cd" "ef"])))
(is "" (go.rt.reify/ReadAllString (chunks-reader [])))
;; sort.Interface: compiled sort.Sort calls Len, Less and Swap
(is [1 2 3 5 8]
    (let [v (atom [5 3 8 1 2])]
      (go.sort/Sort (reify go.sort/Interface
                      (Len [_] (count @v))
                      (Less [_ i j] (< (nth @v i) (nth @v j)))
                      (Swap [_ i j] (swap! v (fn [x] (assoc x i (nth x j) j (nth x i)))))))
      @v))
(is ["reify: method Less of sort.Interface is missing"]
    (try (reify go.sort/Interface (Len [_] 0)) nil
         (catch IllegalArgumentException e [(ex-message e)])))

;; ---------------------------------------------------------------------------------------

(in-ns 'goi.repl-test)
(doseq [[form expected actual] @failed]
  (println "FAIL" (pr-str form))
  (println "  expected:" (pr-str expected))
  (println "  got:     " (pr-str actual)))
(println (str "goi repl: " @passed " passed, " (count @failed) " failed"))
(when (seq @failed) (System/exit 1))

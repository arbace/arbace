;; goi's check at the AOT level (bin/goi check --aot, REAP2; doc/FULL-SUPPORT-SURVEY.md "As built:
;; REAP2"): the programs of $GOROOT/test whose AOT build or run differs from gc's on the original
;; for a reason recorded, each with it; bin/goi check --aot reports a listed program that does
;; not pass as known (one that passes, as passing), and test/goi/divergences-aot.edn classes the
;; reasons. Read with the Clojure reader.
[
 ;; positions: mode :lines keeps a statement's line, not its expressions' line breaks; the printed
 ;; program has no //line directives (RPS17: the lines layout)
 ["devirtualization_nil_panics.go" "positions: a call split over lines (v. then A() on the next) panics at the statement's line"]
 ["fixedbugs/issue29504.go" "positions: selectors and calls split over lines panic at the statement's line"]
 ["fixedbugs/issue22662.go" "positions: //line directives, which the printed program has not (mode :lines)"]
 ;; the toolchain: runtime.GOROOT under -trimpath; the go command's runs and their logs
 ["winbatch.go" "runtime.GOROOT is empty under go build -trimpath (arbace.build.go's)"]
 ["fixedbugs/issue21317.go" "runs the go command: gc's run fails as the AOT program's, the log's times differ"]
 ["linkobj.go" "runs the go command: gc's run fails as the AOT program's, the log's times differ"]
 ;; go build passes -complete to a package without assembly; Go's test driver's rundir compiles
 ;; without it, and the test's bodiless function is eliminated as dead code
 ["fixedbugs/issue9608.go" "go build's -complete: a function without a body in a package without assembly is an error"]
 ;; the forms of invalid programs (mode :full)
 ["ddd1.go" "errorcheck: the printer refuses the forms of an invalid program (a spread outside a call's arguments)"]
 ["fixedbugs/bug217.go" "errorcheck: the printer refuses the forms of an invalid program (a method without a receiver)"]
 ["makenew.go" "errorcheck: the printer refuses the forms of an invalid program (new and make without their type argument)"]
 ["return.go" "errorcheck: the forms of an invalid program say another program (a function's final expression statement printed as a return)"]
]

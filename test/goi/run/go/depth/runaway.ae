;; goi's depth limit (S23, GC42 (b)): a recursion that never returns ends in goi's depth error, gc's text and status 2 (a
;; panic goi raises at its limit), not in Go's fatal stack overflow of the executable (the goroutines' stack sized by
;; SetDepthLimit for program mode's limit). Run by bin/goi test's depth checks, under program mode's default and under
;; ARBACE_GOI_DEPTH; not in test/goi/run/go/t, where gc's run would be the reference (gc's trace is its runtime's).
;; Converted by repr/go from Go source (bin/repr-go read), its in-ns adjusted.
(ns go.depth.runaway (:require [arbace.go :as go]))
(go/package main :path "main" :lang "go1.27")
(go/file "runaway.go" :imports [])

(go/var ^int calls)


^{:go/end 9} (go/func forever "forever never returns: goi's depth limit ends it, as gc's stack limit ends gc's run\n" ^int []
  (inc! calls)
  (+ (forever) 1))


^{:go/end 13} (go/func main []
  (println (forever)))

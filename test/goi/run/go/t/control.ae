;; goi's interpreter tests: control flow (switch with fallthrough, labeled break and continue,
;; goto), defer order, recover and named results, a panic in a deferred call.
(ns go.t.control (:require [arbace.go :as go]))
(go/package main :path "main")
(go/file "control.go" :imports [[errors "errors"] [fmt "fmt"]])

(go/func classify ^string [^int n]
  (switch
    (case [(< n 0)] (return "negative"))
    (case [(== n 0)] (return "zero")))
  (switch n
    (case [1 2 3] (return "small"))
    (case [4] (fallthrough))
    (case [5] (return "four or five"))
    (default (return "big"))))

(go/func named [] :results [^int r]
  (defer ((fn [] (set! r * 2))))
  (set! r 21)
  (return))

(go/func recovering [] :results [^string s]
  (defer ((fn []
            (let [p (recover)]
              (set! s (fmt/Sprint "recovered " p))))))
  (panic (errors/New "boom")))

(go/func order []
  (for [i 0] (< i 3) (inc! i)
    (defer (fmt/Println "deferred" i))))

(go/func replaced []
  (defer ((fn [] (fmt/Println "outer recovered:" (recover)))))
  (defer ((fn [] (panic "second"))))
  (panic "first"))

(go/func main []
  (range [_ n (lit (slice int) -1 0 2 4 5 9)]
    (fmt/Print (classify n) ", "))
  (fmt/Println)
  (label :outer
    (for [i 0] (< i 3) (inc! i)
      (for [j 0] (< j 3) (inc! j)
        (when (== j 2) (continue :outer))
        (when (== i 2) (break :outer))
        (fmt/Print i j " "))))
  (fmt/Println)
  (let [i 0]
    (label :loop)
    (when (< i 3)
      (fmt/Print "goto" i " ")
      (inc! i)
      (goto :loop))
    (fmt/Println))
  (fmt/Println (named) (recovering))
  (order)
  (replaced)
  (let [k 0]
    (while true
      (inc! k)
      (when (> k 5) (break)))
    (fmt/Println "k" k))
  (range [i 3]
    (fmt/Print i))
  (fmt/Println))

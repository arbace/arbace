;; goi's interpreter tests (GR8b, GC60 (a)): reflect's method members as interpreted code calls
;; them. reflect.Type's NumMethod, Method and MethodByName and reflect.Value's of interpreted
;; types (a struct, a named integer, an empty struct; a pointer type's method set), their method
;; values and method expressions called (variadic too, recover in a deferred one), compiled types'
;; from the table (strings.Builder by name, a value method through a pointer, an interface's),
;; and text/template and html/template calling an interpreted method.
;; Converted by repr/go from Go source (bin/repr-go read -files), its in-ns adjusted.
(ns go.t.reflectm (:require [arbace.go :as go]))
(go/package main :path "main" :lang "go1.27")
(in-ns 'go.t.reflectm) (go/file "reflectm.go" :doc "goi's interpreter tests (GR8b, GC60 (a)): reflect's method members as interpreted code calls\nthem. reflect.Type's NumMethod, Method and MethodByName and reflect.Value's of interpreted\ntypes (a struct, a named integer, an empty struct; a pointer type's method set), their method\nvalues and method expressions called (variadic too, recover in a deferred one), compiled types'\nfrom the table (strings.Builder by name, a value method through a pointer, an interface's),\nand text/template and html/template calling an interpreted method.\n" :imports [


    ^{:line 10} [fmt "fmt"]
    ^:alias ^{:line 11} [htemplate "html/template"]
    ^{:line 12} [os "os"]
    ^{:line 13} [reflect "reflect"]
    ^{:line 14} [strings "strings"]
    ^{:line 15} [template "text/template"]
    ^{:line 16} [time "time"]])


(go/type Greeter (struct ^string Name))

^{:go/end 21} (go/method Hello ^string [^Greeter g] (+ "hi " (.-Name g)))

^{:go/end 23} (go/method Rename [^{:tag (* Greeter)} g ^string n] (set! (.-Name g) n))

^{:go/end 31} (go/method Sum ^int [^Greeter g & ^{:tag (slice int)} xs]
  (let [s (len (.-Name g))]
    (range [_ x xs]
      (set! s + x))

    ^{:line 30} s))


^{:go/end 33} (go/method hidden [^Greeter g])

(go/type M int)

^{:go/end 37} (go/method Double ^M [^M m] (* m 2))

(go/type E (struct))

^{:go/end 41} (go/method X ^string [E] "x")

^{:go/end 47} (go/method R [E]
  (when [r (recover)] (!= r nil)
    (fmt/Println "recovered:" r)))



(go/type Temp float64)

^{:go/end 51} (go/method String ^string [^Temp t] (fmt/Sprintf "%.1f°" (conv float64 t)))

^{:go/end 57} (go/func byValue []
  (let [f (assert (func []) (.Interface (.MethodByName (reflect/ValueOf (lit E)) "R")))]
    (defer (f))
    (panic "by a method value")))


^{:go/end 63} (go/func byExpr []
  (let [f (assert (func [E]) (.Interface (.-Func (.Method (reflect/TypeOf (lit E)) 0))))]
    (defer (f (lit E)))
    (panic "by a method expression")))


^{:go/end 141} (go/func main []
  (let [t (reflect/TypeOf (lit Greeter))
      ^{:line 67} pt (reflect/PointerTo t)]
    (fmt/Println (.NumMethod t) (.NumMethod pt) (.NumMethod (reflect/ValueOf (lit Greeter))))
    (for [i 0] (< i (.NumMethod t)) (inc! i)
      (let [m (.Method t i)]
        (fmt/Println i (.-Name m) (== (.-PkgPath m) "") (.-Type m) (.-Index m))))

    (for [i 0] (< i (.NumMethod pt)) (inc! i)
      (let [m (.Method pt i)]
        (fmt/Println i (.-Name m) (.-Type m))))

    (let [(values m ok) (.MethodByName t "Hello")]
      (fmt/Println ok (.-Index m) (aget (.Call (.-Func m) (lit (slice reflect/Value) (reflect/ValueOf (lit Greeter "cy")))) 0))
      (set! (values _ ok) (.MethodByName t "Rename"))
      (let [(values _ ok2) (.MethodByName t "hidden")]
        (fmt/Println ok ok2)
        (let [hello (assert (func [Greeter] [string]) (.Interface (.-Func m)))]
          (fmt/Println (hello (lit Greeter "dee")))

          (let [g (addr (lit Greeter "ann"))
              ^{:line 86} v (reflect/ValueOf g)]
            (.Call (.MethodByName v "Rename") (lit (slice reflect/Value) (reflect/ValueOf "bob")))
            (fmt/Println (.-Name g) (aget (.Call (.MethodByName v "Hello") nil) 0) (.IsValid (.MethodByName v "Nope")))
            (let [f (assert (func [] [string]) (.Interface (.MethodByName v "Hello")))]
              (set! (.-Name g) "eve")
              (fmt/Println (f) (.Type (.Method v 0)) (.Type (.Method v 1)))
              (let [sum (.MethodByName (reflect/ValueOf (lit Greeter "ab")) "Sum")]
                (fmt/Println (.Type sum) (aget (.Call sum (lit (slice reflect/Value) (reflect/ValueOf 1) (reflect/ValueOf 2))) 0))
                (let [sf (assert (func [& (slice int)] [int]) (.Interface sum))]
                  (fmt/Println (sf 10 20 30))

                  (fmt/Println (aget (.Call (.Method (reflect/ValueOf (conv M 21)) 0) nil) 0) (.NumMethod (reflect/TypeOf (conv M 0))))
                  (fmt/Println ((assert (func [E] [string]) (.Interface (.-Func (.Method (reflect/TypeOf (lit E)) 1)))) (lit E)))
                  (byValue)
                  (byExpr)

                  (let [^strings/Builder b (zero strings/Builder)
                      ^{:line 103} bv (reflect/ValueOf (addr b))]
                    (.Call (.MethodByName bv "WriteString") (lit (slice reflect/Value) (reflect/ValueOf "abc")))
                    (fmt/Println (aget (.Call (.MethodByName bv "Len") nil) 0) (aget (.Call (.MethodByName bv "String") nil) 0))
                    (let [bt (.Type bv)
                        ^{:line 107} names (lit (slice string))]
                      (for [i 0] (< i (.NumMethod bt)) (inc! i)
                        (set! names (append names (.-Name (.Method bt i)))))

                      (fmt/Println (.NumMethod bt) (strings/Join names " "))
                      (let [(values lm _) (.MethodByName bt "Len")]
                        (fmt/Println (.-Type lm) (.-Index lm) (aget (.Call (.-Func lm) (lit (slice reflect/Value) bv)) 0))
                        (let [d (* 1500 time/Millisecond)]
                          (fmt/Println (aget (.Call (.MethodByName (reflect/ValueOf (addr d)) "String") nil) 0))
                          (let [(values ds _) (.MethodByName (reflect/TypeOf (addr d)) "String")]
                            (fmt/Println (.-Type ds) (aget (.Call (.-Func ds) (lit (slice reflect/Value) (reflect/ValueOf (addr d)))) 0))

                            (let [^fmt/Stringer s (conv Temp 21.5)
                                ^{:line 120} iv (.Elem (reflect/ValueOf (addr s)))]
                              (fmt/Println (.Kind iv) (.NumMethod iv) (aget (.Call (.Method iv 0) nil) 0) (aget (.Call (.MethodByName iv "String") nil) 0))
                              (let [st (.Elem (reflect/TypeOf (conv (* fmt/Stringer) nil)))
                                  ^{:line 123} sm (.Method st 0)]
                                (fmt/Println (.NumMethod st) (.-Name sm) (.-Type sm) (.IsValid (.-Func sm)))

                                (let [tt (template/Must (.Parse (template/New "t") "{{.Hello}} ({{.Name}}, {{.Sum 1 2}})\n"))]
                                  (when [err (.Execute tt os/Stdout (lit Greeter "cy"))] (!= err nil)
                                    (fmt/Println err))

                                  (when [err (.Execute tt os/Stdout (addr (lit Greeter "cy")))] (!= err nil)
                                    (fmt/Println err))

                                  (let [mt (template/Must (.Parse (template/New "m") "{{.a}} {{.b.Hello}}\n"))]
                                    (when [err (.Execute mt os/Stdout (lit (map string any) ["a" 1] ["b" (lit Greeter "map")]))] (!= err nil)
                                      (fmt/Println err))

                                    (let [ht (htemplate/Must (.Parse (htemplate/New "h") "<b>{{.Hello}}</b> {{.Name}}\n"))]
                                      (when [err (.Execute ht os/Stdout (lit Greeter "<cy>"))] (!= err nil)
                                        (fmt/Println err)))))))))))))))))))))

;; goi's interpreter tests: structs (values, pointers, copies, embedded fields), recursive types,
;; new, nil pointer dereference recovered.
(ns go.t.structs (:require [arbace.go :as go]))
(go/package main :path "main")
(go/file "structs.go" :imports [[fmt "fmt"]])

(go/type Point (struct ^int X ^int Y))
(go/type Named (struct Point ^string Name))
(go/type node (struct ^int v ^{:tag (* node)} next))
(go/type tree (struct ^int v ^{:tag (slice (* tree))} kids))

(go/func push ^{:tag (* node)} [^{:tag (* node)} l ^int v] (addr (lit node v l)))

(go/func move [^{:tag (* Point)} p ^int dx] (set! (.-X p) + dx))

(go/func total ^int [^{:tag (* tree)} t]
  (let [s (.-v t)]
    (range [_ k (.-kids t)]
      (set! s + (total k)))
    s))

(go/func main []
  (let [p (lit Point 1 2)
        q p
        r (addr p)]
    (set! (.-X q) 10)
    (move r 5)
    (fmt/Println p q @r (== p q) (== p @r))
    (let [n (lit Named :Point (lit Point 3 4) :Name "n")]
      (set! (.-Y n) 40)
      (fmt/Println n (.-X n) (.-Point n) (.-Name n))
      (fmt/Printf "%v %+v\n" n p)))
  (let [^{:tag (* node)} l nil]
    (for [i 0] (< i 4) (inc! i)
      (set! l (push l i)))
    (for [x l] (!= x nil) (set! x (.-next x))
      (fmt/Print (.-v x) " "))
    (fmt/Println))
  (let [t (addr (lit tree 1 (lit (slice (* tree)) (addr (lit tree 2 nil)) (addr (lit tree 3 (lit (slice (* tree)) (addr (lit tree 4 nil))))))))]
    (fmt/Println (total t) (len (.-kids t))))
  (let [pp (new Point)
        a (lit (array 2 Point) (lit Point 1 1))]
    (set! (.-Y pp) 7)
    (set! (.-X (aget a 1)) 2)
    (fmt/Println @pp a (aget a 1))
    (defer ((fn [] (fmt/Println "recovered:" (recover)))))
    (let [^{:tag (* Point)} np nil]
      (fmt/Println (.-X np)))))

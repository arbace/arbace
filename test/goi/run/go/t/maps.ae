;; goi's interpreter tests: maps (literal, comma-ok, delete, len, range sorted, nil map write),
;; struct values as keys, op= on map elements.
(ns go.t.maps (:require [arbace.go :as go]))
(go/package main :path "main")
(go/file "maps.go" :imports [[fmt "fmt"] [sort "sort"]])

(go/type key (struct ^string name ^int n))

(go/func main []
  (let [m (lit (map string int) ["a" 1] ["b" 2])]
    (aset m "c" 3)
    (set! (aget m "a") + 10)
    (inc! (aget m "b"))
    (let [(values v ok) (aget m "z")
          (values w ok2) (aget m "c")]
      (fmt/Println v ok w ok2 (len m) (aget m "a") (aget m "b")))
    (delete m "c")
    (let [ks (make (slice string) 0)]
      (range [k m]
        (set! ks (append ks k)))
      (sort/Strings ks)
      (fmt/Println ks m))
    (let [sm (make (map key (slice int)))]
      (aset sm (lit key "x" 1) (lit (slice int) 1 2))
      (aset sm (lit key "x" 1) (append (aget sm (lit key :name "x" :n 1)) 3))
      (fmt/Println sm (len (aget sm (lit key "y" 0))))
      (let [im (lit (map int bool) [1 true] [2 false])
            fm (make (map float64 string) 4)]
        (aset fm 1.5 "one and a half")
        (fmt/Println im (aget im 1) (aget im 3) fm)
        (clear im)
        (fmt/Println (len im))))
    (let [^{:tag (map string int)} nm nil]
      (fmt/Println (aget nm "x") (len nm))
      (defer ((fn [] (fmt/Println "recovered:" (recover)))))
      (aset nm "x" 1))))

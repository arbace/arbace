;; goi's interpreter tests (GS14 (a)): //go:embed's variables, their files read from the package's
;; forms directory (go/t/embed/, SPEC.md §9.6) when the package loads: a string, a []byte of
;; bytes that are not UTF-8, embed.FS of a directory (its hidden files left out), with all:, of
;; several patterns (a quoted one, a glob), walked, read, opened and listed.
(ns go.t.embed (:require [arbace.go :as go]))
(go/package main :path "main" :lang "go1.27"
  :embed-files [["bin.dat" "2f2e272d087efb57e3a8964f71e382d401c15c42b7a3daf3655a0861ef1754f9"]
                ["hello.txt" "338cf45d3cac7517e83ff65ed2051b1f7be0736c82643dcdef96710a8218e626"]
                ["static/.hidden" "e084a3683ef795d1cdbf5e9b253f2ca1f783ae0d0d6e47e419acbbc4fc80bbfa"]
                ["static/_skip.txt" "badae110bc1d90a6bff107b900b504d08d676dbfee56c16a9c5ac2340d949768"]
                ["static/a.txt" "87428fc522803d31065e7bce3cf03fe475096631e5e07bbd7a0fde60c4cf25c7"]
                ["static/sub/b.txt" "c150e5a8a604acebd8d15bd7bf8ea96b2874bdcc91dee6319977d353251283b0"]])
(go/file "embed.go" :imports [[embed "embed"] [fmt "fmt"] [fs "io/fs"]])

(go/var ^{:tag string :go/embed "hello.txt"} hello)

(go/var ^{:tag (slice byte) :go/embed "hello.txt"} helloBytes)

(go/var ^{:tag (slice byte) :go/embed "bin.dat"} bin)

(go/var ^{:tag embed/FS :go/embed "static"} static)

(go/var ^{:tag embed/FS :go/embed "all:static"} everything)

(go/var ^{:tag embed/FS :go/embed ["\"hello.txt\"" "static/*.txt"]} several)

(go/func walk [^string name ^embed/FS f]
  (fmt/Println name)
  (fs/WalkDir f "." (fn ^error [^string p ^fs/DirEntry d ^error err]
                      (when (!= err nil)
                        (return err))
                      (fmt/Println " " p (.IsDir d))
                      nil)))

(go/func main []
  (fmt/Printf "%q\n" hello)
  (fmt/Println (len helloBytes) (== (conv string helloBytes) hello) bin)
  (walk "static" static)
  (walk "everything" everything)
  (walk "several" several)
  (let [(values data err) (.ReadFile static "static/a.txt")]
    (fmt/Printf "%q %v\n" data err))
  (let [(values _ err) (.ReadFile static "static/.hidden")]
    (fmt/Println err))
  (let [(values data err) (.ReadFile everything "static/.hidden")]
    (fmt/Printf "%q %v\n" data err))
  (let [(values es err) (.ReadDir several "static")]
    (range [_ e es]
      (fmt/Println (.Name e) (.IsDir e)))
    (fmt/Println err))
  (let [(values f err) (.Open static "static/sub/b.txt")]
    (when (!= err nil)
      (fmt/Println err)
      (return))
    (let [(values st _) (.Stat f)]
      (fmt/Println (.Name st) (.Size st) (.Mode st) (.IsDir st))))
  (let [(values sub _) (fs/Sub static "static/sub")
        (values b _) (fs/ReadFile sub "b.txt")]
    (fmt/Printf "%q\n" b)))

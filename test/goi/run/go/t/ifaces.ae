;; goi's interpreter tests (GR4): interface values with methods (proxies), dynamic dispatch,
;; type assertions and switches, embedded interfaces, fmt's Stringer and error, errors
;; through compiled code, a failed assertion's panic.
(ns go.t.ifaces (:require [arbace.go :as go]))
(go/package main :path "main")
(go/file "ifaces.go" :imports [[errors "errors"] [fmt "fmt"] [sort "sort"] [strconv "strconv"] [strings "strings"]])

(go/type Shape (interface (Area ^float64 []) (Name ^string [])))

(go/type Rect (struct ^float64 W ^float64 H))
(go/method Area ^float64 [^Rect r] (* (.-W r) (.-H r)))
(go/method Name ^string [^Rect r] "rect")

(go/type Sq float64)
(go/method Area ^float64 [^Sq s] (* (conv float64 s) (conv float64 s)))
(go/method Name ^string [^{:tag (* Sq)} s] (+ "sq" (strconv/Itoa (conv int @s))))

(go/type MyErr (struct ^int Code))
(go/method Error ^string [^{:tag (* MyErr)} e] (fmt/Sprintf "my error %d" (.-Code e)))

(go/type Temp int)
(go/method String ^string [^Temp t] (fmt/Sprintf "%d°" (conv int t)))

(go/type Named (interface fmt/Stringer (Rank ^int [])))
(go/type Card (struct ^string N ^int R))
(go/method String ^string [^Card c] (.-N c))
(go/method Rank ^int [^Card c] (.-R c))

(go/type byRank (slice Named))
(go/method Len ^int [^byRank b] (len b))
(go/method Less ^bool [^byRank b ^int i ^int j] (< (.Rank (aget b i)) (.Rank (aget b j))))
(go/method Swap [^byRank b ^int i ^int j] (set! (values (aget b i) (aget b j)) (values (aget b j) (aget b i))))

(go/func find ^error [^int code]
  (when (> code 0)
    (return (addr (lit MyErr code))))
  nil)

(go/func describe ^string [^any x]
  (type-switch [v x]
    (case [nil] (return "nil"))
    (case [int] (return (+ "int " (strconv/Itoa v))))
    (case [string] (return (+ "string " v)))
    (case [Shape] (return (fmt/Sprintf "shape %s %.1f" (.Name v) (.Area v))))
    (case [error] (return (+ "error " (.Error v))))
    (case [fmt/Stringer] (return (+ "stringer " (.String v))))
    (case [bool float64] (return (fmt/Sprintf "bool or float %v" v))))
  "other")

(go/func main []
  (let [shapes (lit (slice Shape) (lit Rect 2 3) (new (conv Sq 3)))]
    (range [_ s shapes]
      (fmt/Println (.Name s) (.Area s)))
    (let [(values r ok) (assert Rect (aget shapes 0))]
      (fmt/Println r ok (.-W r)))
    (let [(values _ ok) (assert Rect (aget shapes 1))]
      (fmt/Println ok)))
  (fmt/Println (describe 1) (describe "a") (describe nil) (describe (lit Rect 1 1)))
  (fmt/Println (describe (find 7)) "|" (describe (conv Temp 21)) "|" (describe 2.5) "|" (describe (lit (slice int))))
  (let [err (find 3)]
    (fmt/Println err (!= err nil) (== (find 0) nil))
    (let [w (fmt/Errorf "wrapped: %w" err)
          (values me ok) (assert (* MyErr) err)]
      (fmt/Println w ok (.-Code me))
      (fmt/Println (errors/Is w err) (errors/Is w (find 3)) (== (errors/Unwrap w) err))))
  (let [t (conv Temp 5)
        ^fmt/Stringer s t]
    (fmt/Println t s (fmt/Sprint t) (fmt/Sprintf "%v|%s|%d" t t t))
    (fmt/Println (strings/Join (lit (slice string) (.String s) (.String t)) ",")))
  (let [cards (lit byRank (lit Card "k" 13) (lit Card "a" 1) (lit Card "q" 12))]
    (sort/Sort cards)
    (fmt/Println cards (.Rank (aget cards 0)))
    (let [^any x (aget cards 1)]
      (fmt/Println (== x (lit Card "q" 12)) (== x (lit Card "q" 11)))))
  (defer ((fn [] (fmt/Println "recovered:" (recover)))))
  (let [^any x "str"]
    (fmt/Println (+ (assert int x) 1))))

;; goi's interpreter tests: an uncaught panic (gc's report, status 2), println's formats.
(ns go.t.panic (:require [arbace.go :as go]))
(go/package main :path "main")
(go/file "panic.go" :imports [[fmt "fmt"]])

(go/type Color int)

(go/func main []
  (println "println" 1 -2 3.5 (conv float32 0.25) true "s" (conv uint8 200) (complex 1 -1))
  (print "print" 1 2 "\n")
  (defer (fmt/Println "deferred runs"))
  (fmt/Println (conv Color 3))
  (let [xs (lit (slice int) 1 2 3)
        i 5]
    (fmt/Println (aget xs i))))

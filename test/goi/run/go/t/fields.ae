;; goi's interpreter tests: fields loaded and stored by their words (P7, GOI-SPEC.md "Since v1: loads and
;; stores by their words"): pointer, named pointer, map, channel, unsafe.Pointer, slice, compiled interfaces,
;; any, an empty named interface, a func and a struct; their addresses, nil stores, a struct copy, and
;; loads and stores under collections. Made from Go by repr/go's read (gc's run is the .out).
(ns go.t.fields (:require [arbace.go :as go]))
(go/package main :path "main")
(go/file "fields.go" :imports [[errors "errors"]
    [fmt "fmt"]
    [io "io"]
    [runtime "runtime"]
    [strings "strings"]
    [unsafe "unsafe"]])

(go/type node (struct
    ^{:tag int} v
    ^{:tag (* node)} next))

(go/type P (* node))

(go/type E (interface))

(go/type holder (struct
    ^{:tag (* node)} p
    ^{:tag P} np
    ^{:tag (map string int)} m
    ^{:tag (chan int)} c
    ^{:tag unsafe/Pointer} u
    ^{:tag (slice int)} s
    ^{:tag (slice (* node))} ps
    ^{:tag io/Reader} r
    ^{:tag error} e
    ^{:tag any} a
    ^{:tag E} ea
    ^{:tag (func [] [int])} f
    ^{:tag (struct ^int X ^int Y)} pt))

(go/func main []
  (let [h (addr (lit holder))]
    (fmt/Println (== (.-p h) nil) (== (.-np h) nil) (== (.-m h) nil) (== (.-c h) nil) (== (.-u h) nil) (== (.-s h) nil) (== (.-r h) nil) (== (.-e h) nil) (== (.-a h) nil) (== (.-ea h) nil) (== (.-f h) nil))
    (let [n (addr (lit node :v 1))]
      (set! (.-p h) n)
      (set! (.-np h) n)
      (set! (.-m h) (lit (map string int) ["a" 1]))
      (set! (.-c h) (make (chan int) 1))
      (set! (.-u h) (conv unsafe/Pointer n))
      (set! (.-s h) (lit (slice int) 1 2 3))
      (set! (.-ps h) (lit (slice (* node)) n nil))
      (set! (.-r h) (strings/NewReader "hello"))
      (set! (.-e h) (errors/New "boom"))
      (set! (.-a h) 42)
      (set! (.-ea h) "e")
      (set! (.-f h) (fn ^int [] 7))
      (set! (.-X (.-pt h)) 5)
      (let [q (.-p h)]
        (set! (.-v q) 10)
        (fmt/Println (.-v n) (.-v (.-p h)) (.-v (conv (* node) (.-np h))) (aget (.-m h) "a") (len (.-s h)) (cap (.-s h)) (aget (.-s h) 2) (.-v (aget (.-ps h) 0)) (== (aget (.-ps h) 1) nil) (.-a h) (.-ea h) ((.-f h)) (.-pt h))
        (>! (.-c h) 3)
        (fmt/Println (<! (.-c h)) (.-v (conv (* node) (.-u h))) (.-e h))
        (let [buf (make (slice byte) 5)
            (values k _) (.Read (.-r h) buf)]
          (fmt/Println k (conv string buf))
          (let [^io/Reader w (.-r h)
              (values _ isStr) (assert (* strings/Reader) w)]
            (fmt/Println isStr)
            (let [s (.-s h)]
              (aset s 0 100)
              (fmt/Println (aget (.-s h) 0))
              (set! (.-s h) (append (.-s h) 4))
              (fmt/Println (len (.-s h)) (len s))
              (let [pp (addr (.-p h))]
                (set! @pp (addr (lit node :v 20)))
                (fmt/Println (.-v (.-p h)) (.-v n))
                (let [ps (addr (.-s h))]
                  (set! @ps (subslice @ps _ 1))
                  (fmt/Println (.-s h))
                  (let [g @h]
                    (set! (.-s g) nil)
                    (set! (.-p g) nil)
                    (fmt/Println (!= (.-s h) nil) (!= (.-p h) nil) (== (.-s g) nil) (aget (.-m g) "a"))
                    (let [up (conv (* node) (conv unsafe/Pointer (addr (.-v n))))]
                      (fmt/Println (.-v up))
                      (let [arr (conv (* (array 1 int)) (.-s h))]
                        (fmt/Println (aget arr 0))
                        (set! (.-p h) nil)
                        (set! (.-np h) nil)
                        (set! (.-m h) nil)
                        (set! (.-s h) nil)
                        (set! (.-r h) nil)
                        (set! (.-e h) nil)
                        (set! (.-a h) nil)
                        (set! (.-f h) nil)
                        (fmt/Println (== (.-p h) nil) (== (.-np h) nil) (== (.-m h) nil) (== (.-s h) nil) (== (.-r h) nil) (== (.-e h) nil) (== (.-a h) nil) (== (.-f h) nil))
                        (let [^{:tag (slice (* holder))} list (zero (slice (* holder)))]
                          (for [i 0] (< i 2000) (inc! i)
                            (let [x (addr (lit holder :p (addr (lit node :v i)) :s (make (slice int) 4) :r (strings/NewReader "x")))]
                              (aset (.-s x) 3 i)
                              (set! (.-ps x) (lit (slice (* node)) (.-p x)))
                              (set! (.-m x) (lit (map string int) ["k" i]))
                              (set! list (append list x))
                              (when (== (% i 500) 0)
                                (runtime/GC))))

                          (runtime/GC)
                          (let [sum 0]
                            (range [_ x list]
                              (set! sum + (+ (.-v (.-p x)) (aget (.-s x) 3) (.-v (aget (.-ps x) 0)) (aget (.-m x) "k"))))

                            (fmt/Println sum)))))))))))))))

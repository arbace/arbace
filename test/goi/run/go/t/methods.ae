;; goi's interpreter tests (GR4): methods of value and pointer receivers, method values and
;; expressions, embedding and promotion (through values and pointers), methods of named
;; non-struct types, a method that defers and recovers.
(ns go.t.methods (:require [arbace.go :as go]))
(go/package main :path "main")
(go/file "methods.go" :imports [[fmt "fmt"] [strings "strings"]])

(go/type Point (struct ^int X ^int Y))

(go/method Add ^Point [^Point p ^Point q] (lit Point (+ (.-X p) (.-X q)) (+ (.-Y p) (.-Y q))))
(go/method Scale [^{:tag (* Point)} p ^int k] (set! (.-X p) * k) (set! (.-Y p) * k))
(go/method String ^string [^Point p] (fmt/Sprintf "(%d,%d)" (.-X p) (.-Y p)))

(go/type Celsius float64)
(go/method F ^float64 [^Celsius c] (+ (* (conv float64 c) 1.8) 32))

(go/type Counter int)
(go/method Inc [^{:tag (* Counter)} c] (inc! @c))

(go/type Named (struct ^string Name))
(go/method Hello ^string [^{:tag (* Named)} n] (+ "hello " (.-Name n)))

(go/type Circle (struct Point ^int R))
(go/type Ref (struct (* Named) ^int K))

(go/type Stack (struct ^{:tag (slice int)} items))
(go/method Push [^{:tag (* Stack)} s & ^{:tag (slice int)} xs] (set! (.-items s) (append (.-items s) (spread xs))))
(go/method Pop [^{:tag (* Stack)} s] :results [^int v ^bool ok]
  (when (== (len (.-items s)) 0) (return 0 false))
  (set! v (aget (.-items s) (- (len (.-items s)) 1)))
  (set! (.-items s) (subslice (.-items s) _ (- (len (.-items s)) 1)))
  (return v true))

(go/method Safe ^string [^{:tag (* Stack)} s] :results [^string out]
  (defer ((fn [] (let [r (recover)] (when (!= r nil) (set! out (fmt/Sprint "recovered: " r)))))))
  (let [(values v _) (.Pop s)]
    (fmt/Sprint (/ 10 v))))

(go/func main []
  (let [p (lit Point 1 2)
        q (.Add p (lit Point 10 20))]
    (.Scale (addr q) 2)
    (fmt/Println q (.String q) p)
    (let [f (.-Add p)
          g (method-expr Point Add)
          h (method-expr (* Point) Scale)]
      (set! p (lit Point 5 5))
      (fmt/Println (f (lit Point 1 1)) (g p (lit Point 2 2)))
      (h (addr p) 3)
      (fmt/Println p)))
  (let [c (conv Celsius 100)]
    (fmt/Println (.F c) (fmt/Sprintf "%.1f" (.F (conv Celsius -40)))))
  (let [n (conv Counter 0)]
    (.Inc (addr n)) (.Inc (addr n))
    (let [inc (.-Inc (addr n))]
      (inc) (inc))
    (fmt/Println n))
  (let [ci (lit Circle :Point (lit Point 3 4) :R 7)]
    (fmt/Println (.-X ci) (.String ci) (.Add ci (lit Point 1 1)))
    (.Scale (addr ci) 10)
    (fmt/Println (.-Point ci) (.-R ci)))
  (let [r (lit Ref (addr (lit Named "ann")) 1)]
    (fmt/Println (.Hello r) (strings/ToUpper (.-Name r))))
  (let [s (lit Stack)]
    (.Push (addr s) 1 2 3)
    (.Push (addr s) (spread (lit (slice int) 4 0)))
    (let [(values v ok) (.Pop (addr s))]
      (fmt/Println v ok (len (.-items s))))
    (fmt/Println (.Safe (addr s)) (.Safe (addr s)))))

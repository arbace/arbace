^{:go/end 20} (go/func try [^string name ^{:tag (func [])} f]
  (defer (^{:go/end 18} (fn []
        (let [e (recover)]
          (when [(values re ok) (assert runtime/Error e)] ok
            (fmt/Printf "%s: %T %v\n" name re re)
            (return))

          (fmt/Println name "no panic" e)))))

  (f))


^{:go/end 52} (go/func main []
  (let [s (subslice (lit (slice int) 1 2 3 4) _ 3)

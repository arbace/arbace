;; goi's interpreter tests (GR9a-c): interpreted named types as runtime types of their own
;; (doc/go/GOI-SPEC.md "As built: GR9a-c"), the GR9 survey's X9 checks: %T, %v, %#v, reflect's
;; names, kinds and Implements, io.ReadAll and sort.Sort through interpreted methods, compiled
;; code's assertions, an embedded field, AssignableTo both ways, MakeFunc to a named func type
;; while the collector runs, the runtime's messages, a recursive list and recursion through maps,
;; errors.Unwrap/Is/As and %w, == and map keys of a struct with a blank field, an instance's name,
;; GoString. Converted by repr/go from Go source (bin/repr-go read -files), its in-ns adjusted.
(ns go.t.named (:require [arbace.go :as go]))
(go/package main :path "main" :lang "go1.27")
(in-ns 'go.t.named) (go/file "named.go" :doc "Interpreted named types as runtime types of their own (GOI-SPEC.md, \"As built: GR9a-c\"): the\nGR9 survey's X9 checks as a program goi runs and gc runs alike.\n" :imports [


    ^{:line 6} [errors "errors"]
    ^{:line 7} [fmt "fmt"]
    ^{:line 8} [io "io"]
    ^{:line 9} [reflect "reflect"]
    ^{:line 10} [runtime "runtime"]
    ^{:line 11} [sort "sort"]
    ^{:line 12} [strings "strings"]])


(go/type Celsius float64)

^{:go/end 17} (go/method String ^string [^Celsius c] (fmt/Sprintf "%.1f°C" (conv float64 c)))

(go/type RWS (struct ^{:tag (slice byte)} data))

^{:go/end 28} (go/method Read [^{:tag (* RWS)} r ^{:tag (slice byte)} p] :results [int error]
  (when (== (len (.-data r)) 0)
    (return 0 io/EOF))

  (let [n (copy p (subslice (.-data r) _ 1))]
    (set! (.-data r) (subslice (.-data r) n))
    (return n nil)))

^{:go/end 29} (go/method Write [^{:tag (* RWS)} r ^{:tag (slice byte)} p] :results [int error] (set! (.-data r) (append (.-data r) (spread p))) (return (len p) nil))
^{:go/end 30} (go/method Seek [^{:tag (* RWS)} r ^int64 o ^int w] :results [int64 error] (return o nil))
^{:go/end 31} (go/method String ^string [^{:tag (* RWS)} r] "rws")

(go/type IntSlice (slice int))

^{:go/end 35} (go/method Len ^int [^IntSlice s] (len s))
^{:go/end 36} (go/method Less ^bool [^IntSlice s ^int i ^int j] (< (aget s i) (aget s j)))
^{:go/end 37} (go/method Swap [^IntSlice s ^int i ^int j] (set! (values (aget s i) (aget s j)) (values (aget s j) (aget s i))))

(go/type S1 (struct ^int i))

^{:go/end 41} (go/method Hello ^string [S1] "hello")

(go/type S2 (struct S1))

(go/type P (struct ^int X ^int Y))

(go/type ft (func [] [(* int)]))

(go/type T (struct ^{:tag (slice int)} s))

(go/type Node (struct
    ^{:line 52 :tag (* Node)} Next
    ^{:line 53 :tag int} V))


(go/type M (map string M))

(go/type Rec (struct
    ^{:line 59 :tag (map string Rec2)} M
    ^{:line 60 :tag int} N))


(go/type Rec2 (struct
    ^{:line 64 :tag (* Rec)} R
    ^{:line 65 :tag (* int)} P))


(go/type Code int)

^{:go/end 70} (go/method Error ^string [^Code c] (fmt/Sprintf "code %d" (conv int c)))

(go/type Wrapped (struct ^error err))

^{:go/end 74} (go/method Error ^string [^Wrapped w] (+ "wrapped: " (.Error (.-err w))))
^{:go/end 75} (go/method Unwrap ^error [^Wrapped w] (.-err w))

(go/type Blank (struct
    ^{:line 78 :tag int} A ^int _ ^int B))


(go/type Pair :type-params [^comparable K V] (struct
    ^{:line 82 :tag K} K
    ^{:line 83 :tag V} V))


(go/type Pt (struct ^int X ^int Y))

^{:go/end 88} (go/method GoString ^string [^Pt p] (fmt/Sprintf "Pt(%d, %d)" (.-X p) (.-Y p)))

^{:go/end 191} (go/func main []
  (let [c (conv Celsius 36.6)]
    (fmt/Printf "%T %v %s %#v\n" c c c c)
    (let [t (reflect/TypeOf c)]
      (fmt/Println (.Name t) (.PkgPath t) (.Kind t) (.String t) (.Implements t (.Elem (reflect/TypeOf (conv (* fmt/Stringer) nil)))))
      (fmt/Println (== (reflect/PointerTo t) (reflect/TypeOf (addr c))) (addr c))
      (let [^any x c
          (values _ isFloat) (assert float64 x)]
        (fmt/Println isFloat (conv float64 c))

        (let [r (addr (lit RWS :data (conv (slice byte) "edcba")))
            ^{:line 101 :tag io/ReadWriteSeeker} rws r
            (values b _) (io/ReadAll rws)]
          (fmt/Println (conv string b))
          (let [^io/Reader rd (addr (lit RWS))]
            (fmt/Printf "%[1]T %[1]v %#v\n" rd (addr (lit RWS)))
            (let [(values _ isStringer) (assert fmt/Stringer (conv any (lit RWS)))]
              (fmt/Println isStringer)

              (let [s (lit IntSlice 5 2 4 1 3)]
                (sort/Sort s)
                (fmt/Println s (sort/IsSorted s))

                (let [st (reflect/TypeOf (lit S2))
                    ^{:line 114} f0 (.Field st 0)
                    (values _ found) (.FieldByName st "S1")]
                  (fmt/Println (.-Name f0) (.-Anonymous f0) found)
                  (fmt/Printf "%+v %#v %s\n" (lit S2) (lit S2) ^{:go/via [S1]} (.Hello (lit S2)))

                  (fmt/Println (.AssignableTo (reflect/TypeOf (lit P)) (reflect/TypeOf (lit (struct ^int X ^int Y))))
                    (.AssignableTo (reflect/TypeOf (lit (struct ^int X ^int Y))) (reflect/TypeOf (lit P))))
                  (fmt/Printf "%T %+v\n" (lit P 1 2) (lit P 1 2))

                  (let [fn (conv ft ^{:go/end 123} (fn ^{:tag (* int)} [] (let [v 7] (addr v))))
                      ^{:line 124} mf (assert


                        ^{:line 127} ft ^{:line 124} (.Interface ^{:line 124} (reflect/MakeFunc ^{:line 124} (reflect/TypeOf fn) ^{:line 124 :go/end 127} (fn ^{:tag (slice reflect/Value)} [^{:line 124} (slice reflect/Value)] ^{:line 125} (let [v 8] ^{:line 126} (lit ^{:line 126} (slice reflect/Value) ^{:line 126} (reflect/ValueOf ^{:line 126} (addr v))))))))
                      ^{:line 128} total 0]
                    (for [i 0] (< i 1000) (inc! i)
                      (set! total + @(mf))
                      (when (== (% i 100) 0)
                        (runtime/GC)))


                    (fmt/Printf "%T %d %d %v\n" mf (.NumIn (reflect/TypeOf fn)) total (.Out (reflect/TypeOf fn) 0))

                    (^{:go/end 141} (fn []
                        (defer (^{:go/end 138} (fn [] (fmt/Println (recover)))))
                        (let [m (lit (map any int))]
                          (aset m (lit T) 1))))

                    (^{:go/end 146} (fn []
                        (defer (^{:go/end 143} (fn [] (fmt/Println (recover)))))
                        (let [^any z (lit T)]
                          (fmt/Println (== z z)))))

                    (^{:go/end 151} (fn []
                        (defer (^{:go/end 148} (fn [] (fmt/Println (recover)))))
                        (let [^any z (lit T)]
                          (set! _ (assert fmt/Stringer z)))))


                    (let [^{:tag (* Node)} head (zero (* Node))]
                      (for [i 0] (< i 20000) (inc! i)
                        (set! head (addr (lit Node :Next head :V i))))

                      (runtime/GC)
                      (let [sum 0]
                        (for [n head] (!= n nil) (set! n (.-Next n))
                          (set! sum + (.-V n)))

                        (fmt/Printf "%d %T %+v %v\n" sum @head (lit Node) (.-Type (.Field (reflect/TypeOf (lit Node)) 0)))

                        (let [mm (lit M ["a" (lit M)])]
                          (fmt/Printf "%T %v %v\n" mm mm (.Elem (reflect/TypeOf mm)))
                          (let [rec (lit Rec :M (lit (map string Rec2)) :N 3)]
                            (for [i 0] (< i 5000) (inc! i)
                              (let [p i]
                                (aset (.-M rec) (fmt/Sprint i) (lit Rec2 :R (addr rec) :P (addr p)))))

                            (runtime/GC)
                            (let [ok true]
                              (range [k v (.-M rec)]
                                (when (or (!= (fmt/Sprint @(.-P v)) k) (!= (.-R v) (addr rec)))
                                  (set! ok false)))


                              (fmt/Println (.Size (reflect/TypeOf rec)) (.Size (reflect/TypeOf (lit Rec2))) (len (.-M rec)) ok)

                              (let [^error err (lit Wrapped (conv Code 3))
                                  ^{:line 181 :tag Code} code (zero Code)]
                                (fmt/Println err (errors/Unwrap err) (errors/Is err (conv Code 3)) (errors/As err (addr code)) code)
                                (fmt/Println (fmt/Errorf "outer: %w" err))

                                (let [(values u1 u2) (values (lit Blank :A 1 :B 2) (lit Blank :A 1 :B 2))]
                                  (fmt/Println (== u1 u2) (lit (map Blank int) [u1 1] [u2 2]))

                                  (fmt/Printf "%T %v\n" (lit (Pair string Celsius) "t" 20) (lit (Pair string Celsius) "t" 20))
                                  (fmt/Printf "%#v %v\n" (lit Pt 1 2) (lit (slice Celsius) 1 2))
                                  (fmt/Println (strings/Repeat "=" 3) (fmt/Sprint (conv Code 7))))))))))))))))))))

;; goi's interpreter tests: strings, runes, bytes, range over strings, conversions.
(ns go.t.strs (:require [arbace.go :as go]))
(go/package main :path "main")
(go/file "strs.go" :imports [[fmt "fmt"] [strings "strings"]])

(go/func main []
  (let [s "héllo, 世界"]
    (fmt/Println (len s) (aget s 1) (subslice s 0 3) (subslice s 7))
    (range [i r s]
      (fmt/Print i ":" (conv string r) " "))
    (fmt/Println)
    (let [bs (conv (slice byte) s)
          rs (conv (slice rune) s)]
      (aset bs 0 \H)
      (fmt/Println (conv string bs) (len rs) (conv string (subslice rs 7)) (conv string (aget rs 1)))
      (fmt/Println (strings/ToUpper s) (strings/Repeat "ab" 3) (strings/Index s "世") (+ s "!" "?"))
      (fmt/Println (< "abc" "abd") (== s (conv string rs)) (conv string (conv rune 65)) (conv string (conv rune -1))))))

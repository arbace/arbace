;; goi's interpreter tests: liveness across a fallthrough (2026-11-19, n-py-eval). scan's next is used last in the
;; clause that falls through, inside an if, and again in the clause it falls into; its address is taken, so it is a
;; cell. The plan cleared it after the if (each clause planned alone), so the clause fallen into read a nil cell:
;; expat's doContent, every pyexpat parse of an element with content ("reflect: call of reflect.Value.Interface on
;; zero Value"). The program's output is gc's.
(ns go.t.fallthrough (:require [arbace.go :as go]))
(go/package main :path "main")
(go/file "fallthrough.go" :imports [[fmt "fmt"]])

(go/type ptr (struct ^{:tag (slice byte)} b ^int i))

(go/func tok ^int [^ptr s ^{:tag (* ptr)} next]
  (set! @next (lit ptr (.-b s) (+ (.-i s) 1)))
  (when (>= (+ (.-i s) 1) (len (.-b s)))
    (return 0))
  1)

(go/func scan ^int [^ptr s ^bool flag ^{:tag (* ptr)} out]
  (let [n 0]
    (while true
      (let [next s]
        (when (== (tok s (addr next)) 0)
          (return n))
        (switch (% n 2)
          (case [0]
            (when flag
              (set! @out next)
              (return -1))
            (fallthrough))
          (default
            (inc! n)
            (set! s next)))))))

;; a value (an S slot) used the same way, and a chain of two fallthroughs
(go/func chain ^string [^int k ^string w]
  (let [r ""]
    (switch k
      (case [0]
        (when (== w "")
          (return "empty"))
        (fallthrough))
      (case [1]
        (set! r (+ r "1"))
        (fallthrough))
      (default
        (set! r (+ r w))))
    r))

(go/func main []
  (let [^ptr out (zero ptr)]
    (fmt/Println (scan (lit ptr :b (conv (slice byte) "abcd")) false (addr out)))
    (fmt/Println (scan (lit ptr :b (conv (slice byte) "abcd")) true (addr out)) (.-i out))
    (fmt/Println (chain 0 "x") (chain 0 "") (chain 1 "y") (chain 2 "z"))))

;; goi's interpreter tests (GR8a): the standard library, compiled packages the table grew by
;; (regexp, math/big, encoding/json, bufio, compress/gzip, encoding/base64, encoding/csv, hash,
;; net/url), interpreted ones from the digest's forms (regexp/syntax, container/*, hash/fnv,
;; text/tabwriter, text/template parsed (its Execute asks reflect.Value.MethodByName: GR8b's),
;; flag, go/parser, go/ast, go/format, html), encoding/binary's byte orders through ByteOrder,
;; reflect.TypeFor, strings' iterators over iter.Seq. Converted by repr/go from Go source
;; (bin/repr-go read), its in-ns adjusted.
(ns go.t.stdlib (:require [arbace.go :as go]))
(go/package main :path "main" :lang "go1.27")
(go/file "stdlib.go" :doc "The standard library at goi (GR8a): compiled packages the table grew by, interpreted ones\nfrom the digest's forms, the boundary between them.\n" :imports [


    ^{:line 6} [bufio "bufio"]
    ^{:line 7} [bytes "bytes"]
    ^{:line 8} [gzip "compress/gzip"]
    ^{:line 9} [heap "container/heap"]
    ^{:line 10} [list "container/list"]
    ^{:line 11} [ring "container/ring"]
    ^{:line 12} [base64 "encoding/base64"]
    ^{:line 13} [binary "encoding/binary"]
    ^{:line 14} [csv "encoding/csv"]
    ^{:line 15} [json "encoding/json"]
    ^{:line 16} [errors "errors"]
    ^{:line 17} [flag "flag"]
    ^{:line 18} [fmt "fmt"]
    ^{:line 19} [ast "go/ast"]
    ^{:line 20} [format "go/format"]
    ^{:line 21} [parser "go/parser"]
    ^{:line 22} [token "go/token"]
    ^{:line 23} [hash "hash"]
    ^{:line 24} [crc32 "hash/crc32"]
    ^{:line 25} [fnv "hash/fnv"]
    ^{:line 26} [html "html"]
    ^{:line 27} [io "io"]
    ^{:line 28} [big "math/big"]
    ^{:line 29} [url "net/url"]
    ^{:line 30} [os "os"]
    ^{:line 31} [reflect "reflect"]
    ^{:line 32} [regexp "regexp"]
    ^{:line 33} [syntax "regexp/syntax"]
    ^{:line 34} [slices "slices"]
    ^{:line 35} [strings "strings"]
    ^{:line 36} [tabwriter "text/tabwriter"]
    ^{:line 37} [template "text/template"]
    ^{:line 38} [utf8 "unicode/utf8"]])


(go/type intHeap (slice int))

^{:go/end 43} (go/method Len ^int [^intHeap h] (len h))
^{:go/end 44} (go/method Less ^bool [^intHeap h ^int i ^int j] (< (aget h i) (aget h j)))
^{:go/end 45} (go/method Swap [^intHeap h ^int i ^int j] (set! (values (aget h i) (aget h j)) (values (aget h j) (aget h i))))
^{:go/end 46} (go/method Push [^{:tag (* intHeap)} h ^any x] (set! @h (append @h (assert int x))))
^{:go/end 53} (go/method Pop ^any [^{:tag (* intHeap)} h]
  (let [old @h
      ^{:line 49} n (len old)
      ^{:line 50} x (aget old (- n 1))]
    (set! @h (subslice old _ (- n 1)))
    ^{:line 52} x))


(go/type User (struct
    ^{:line 56 :tag string :go/tag "json:\"name\""} Name
    ^{:line 57 :tag int :go/tag "json:\"age,omitempty\""} Age))


(go/type level int)

^{:go/end 62} (go/method String ^string [^{:tag (* level)} l] (fmt/Sprint (conv int @l)))
^{:go/breaks [5] :go/end 69} (go/method Set ^error [^{:tag (* level)} l ^string s]
  (when (== s "")
    (return (errors/New "empty")))

  (set! @l (conv level (len s)))
  nil)


^{:go/end 206} (go/func main []
  ;; regexp (compiled), regexp/syntax (interpreted)
  (let [re (regexp/MustCompile "(\\w+)@(\\w+)\\.(com|org)")]
    (fmt/Println (.FindAllStringSubmatch re "ann@x.com, bob@y.org; eve@z.net" -1))
    (fmt/Println (.MatchString re "baaa") (.ReplaceAllString re "a@b.com" "$2"))
    (let [(values p err) (syntax/Parse "a+b*" syntax/Perl)]
      (fmt/Println p err (== (.-Op p) syntax/OpConcat))

      ;; math/big (compiled)
      (let [f (.MulRange (new big/Int) 1 30)]
        (fmt/Println f (.BitLen f))
        (let [r (.SetFrac64 (new big/Rat) 10 4)]
          (fmt/Println r (.FloatString r 3))

          ;; encoding/json (compiled) over an interpreted struct
          (let [(values b ^:assign err) (json/Marshal (lit User :Name "bob" :Age 4))]
            (fmt/Println (conv string b) err)
            (let [^User u (zero User)]
              (set! err (json/Unmarshal (conv (slice byte) "{\"name\":\"cy\"}") (addr u)))
              (fmt/Println (.-Name u) (.-Age u) err)
              (let [^{:tag (map string any)} m (zero (map string any))]
                (json/Unmarshal (conv (slice byte) "{\"a\":[1,2,{\"b\":null}]}") (addr m))
                (fmt/Println m)

                ;; bufio (compiled)
                (let [sc (bufio/NewScanner (strings/NewReader "one two\nthree"))]
                  (.Split sc bufio/ScanWords)
                  (let [n 0]
                    (while (.Scan sc)
                      (set! n + (len (.Text sc))))

                    (fmt/Println "words" n)

                    ;; compress/gzip and encoding/base64 (compiled): a round trip
                    (let [^bytes/Buffer buf (zero bytes/Buffer)
                        ^{:line 106} zw (gzip/NewWriter (addr buf))]
                      (.Write zw (conv (slice byte) (strings/Repeat "goi " 50)))
                      (.Close zw)
                      (let [(values zr _) (gzip/NewReader (addr buf))
                          (values out _) (io/ReadAll zr)]
                        (fmt/Println (len out) (conv string (subslice out _ 8)))
                        (let [enc (.EncodeToString base64/StdEncoding (conv (slice byte) "goi at the REPL"))
                            (values dec _) (.DecodeString base64/StdEncoding enc)]
                          (fmt/Println enc (conv string dec))

                          ;; encoding/csv (compiled)
                          (let [(values recs _) (.ReadAll (csv/NewReader (strings/NewReader "a,b\n\"c,d\",e\n")))]
                            (fmt/Println recs (len (aget recs 1)))

                            ;; encoding/binary's byte orders, through the listed ByteOrder
                            (let [bs (lit (slice byte) 1 2 3 4 5 6 7 8)]
                              (fmt/Println (.Uint32 binary/LittleEndian bs) (.Uint16 binary/BigEndian bs) (.Uint64 binary/LittleEndian bs))
                              (.PutUint32 binary/BigEndian bs 0xdeadbeef)
                              (fmt/Println (subslice bs _ 4) (.String binary/LittleEndian))
                              (fmt/Println (.AppendUint16 binary/BigEndian nil 258))

                              ;; hash (compiled): crc32's Hash32 through the listed interface
                              (let [^hash/Hash32 h32 (crc32/NewIEEE)]
                                (.Write h32 (conv (slice byte) "goi"))
                                (fmt/Println (.Sum32 h32))
                                (let [h (fnv/New64a)] ; hash/fnv: interpreted
                                  (.Write h (conv (slice byte) "goi"))
                                  (fmt/Println (.Sum64 h))

                                  ;; container/* (interpreted) over the program's own types
                                  (let [hp (addr (lit intHeap 5 2 8))]
                                    (heap/Init hp)
                                    (heap/Push hp 3)
                                    (let [^{:tag (slice int)} popped (zero (slice int))]
                                      (while (> (.Len hp) 0)
                                        (set! popped (append popped (assert int (heap/Pop hp)))))

                                      (fmt/Println popped)
                                      (let [l (list/New)]
                                        (.PushBack l 1)
                                        (.PushFront l 0)
                                        (.PushBack l 2)
                                        (for [e (.Front l)] (!= e nil) (set! e (.Next e))
                                          (fmt/Print (.-Value e) " "))

                                        (fmt/Println (.Len l))
                                        (let [rg (ring/New 3)]
                                          (for [i 0] (< i 3) (inc! i)
                                            (set! (.-Value rg) i)
                                            (set! rg (.Next rg)))

                                          (let [sum 0]
                                            (.Do rg ^{:go/end 158} (fn [^any x] (set! sum + (assert int x))))
                                            (fmt/Println "ring" sum)

                                            ;; text/tabwriter (interpreted)
                                            (let [tw (tabwriter/NewWriter os/Stdout 0 8 1 \space 0)]
                                              (fmt/Fprintln tw "a\tbb\tccc")
                                              (fmt/Fprintln tw "dddd\te\tf")
                                              (.Flush tw)

                                              ;; text/template (interpreted): parsed; its Execute asks reflect.Value.MethodByName, GR8b's
                                              (let [t (template/Must (.Parse (template/New "t") "{{.Name}} is {{.Age}}; {{range .Tags}}[{{.}}]{{end}}\n"))]
                                                (fmt/Println (.Name t) (len (.-Nodes (.-Root (.-Tree t)))))

                                                ;; flag (interpreted) with an interpreted flag.Value
                                                (let [fs (flag/NewFlagSet "t" flag/ContinueOnError)
                                                    ^{:line 173 :tag level} lv (zero level)]
                                                  (.Var fs (addr lv) "level" "the level")
                                                  (let [verbose (.Bool fs "v" false "verbose")]
                                                    (.Parse fs (lit (slice string) "-v" "-level" "abc" "rest"))
                                                    (fmt/Println @verbose lv (.Args fs))

                                                    ;; go/parser, go/ast, go/format (interpreted)
                                                    (let [fset (token/NewFileSet)
                                                        (values file ^:assign err) (parser/ParseFile fset "x.go" "package x\nfunc  F(a int)int{return a+1}\n" 0)]
                                                      (fmt/Println err (.-Name (.-Name file)) (len (.-Decls file)))
                                                      (ast/Inspect file ^{:go/breaks [[3 187]] :go/end 188} (fn ^bool [^ast/Node nd]
                                                          (when [(values id ok) (assert (* ast/Ident) nd)] ok
                                                            (fmt/Print (.-Name id) " "))

                                                          true))

                                                      (fmt/Println)
                                                      (let [(values src ^:assign err) (format/Source (conv (slice byte) "package x\nfunc  F(a int)int{return a+1}\n"))]
                                                        (fmt/Print (conv string src) err "\n")

                                                        ;; net/url (compiled), html (interpreted)
                                                        (let [(values pu ^:assign err) (url/Parse "https://example.com/a b?q=1&r=x#frag")]
                                                          (fmt/Println (.-Host pu) (.-Path pu) (.Get (.Query pu) "r") (.-Fragment pu) err)
                                                          (fmt/Println (html/EscapeString "<a href='x'>&</a>") (html/UnescapeString "&lt;&amp;"))

                                                          ;; reflect.TypeFor, strings' iterators over iter.Seq (GC63)
                                                          (fmt/Println ((inst reflect/TypeFor int)) ((inst reflect/TypeFor error)) (.NumField ((inst reflect/TypeFor User))))
                                                          (let [^{:tag (slice string)} parts (zero (slice string))]
                                                            (range [s (strings/SplitSeq "a,b,c" ",")]
                                                              (set! parts (append parts s)))

                                                            (fmt/Println parts (^{:inst [string]} slices/Collect (strings/Lines "x\ny\n")))
                                                            (fmt/Println (utf8/RuneCountInString "héllo"))))))))))))))))))))))))))))))))

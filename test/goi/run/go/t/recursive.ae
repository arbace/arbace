;; goi's interpreter tests (GR7a): named types recursive other than through pointers, held in Go
;; memory at their shapes (doc/go/GOI-SPEC.md "As built: GR7a"): through a slice, a function, a
;; channel, a map, a struct's slice of itself with methods in interfaces, mutual recursion, a pointer
;; type recursive through its element and through an array, generic ones, and an interface naming a
;; struct that names it. Converted by repr/go from Go source (bin/repr-go read), its in-ns adjusted.
(ns go.t.recursive (:require [arbace.go :as go]))
(go/package main :path "main" :lang "go1.27")
(go/file "recursive.go" :imports [[fmt "fmt"] [strings "strings"]])



(go/type S "recursive through a slice\n" (slice S))

^{:go/end 21} (go/func depth ^int [^S s]
  (let [d 0]
    (range [_ x s]
      (when [e (+ (depth x) 1)] (> e d)
        (set! d e)))


    ^{:line 20} d))



(go/type F "recursive through a function\n" (func [int] [F]))

^{:go/end 31} (go/func counter ^F [^int n ^{:tag (* (slice int))} out]
  ^{:go/end 30} (fn ^F [^int k]
    (set! @out (append @out (+ n k)))
    (counter (+ n k) out)))




(go/type Ch "through a channel\n" (chan Ch))


(go/type M "through a map\n" (map string M))

^{:go/end 46} (go/func keys [^M m ^string prefix ^{:tag (* (slice string))} out]
  (range [_ k (lit (slice string) "a" "b" "c")]
    (when [(values v ok) (aget m k)] ok
      (set! @out (append @out (+ prefix k)))
      (keys v (+ prefix k ".") out))))





(go/type Tree "a struct through a slice of itself, with methods, in interfaces\n" (struct
    ^{:line 50 :tag string} Name
    ^{:line 51 :tag (slice Tree)} Kids))


^{:go/end 68} (go/method String ^string [^Tree t]
  (let [^strings/Builder b (zero strings/Builder)]
    (.WriteString b (.-Name t))
    (when (> (len (.-Kids t)) 0)
      (.WriteString b "(")
      (range [i k (.-Kids t)]
        (when (> i 0)
          (.WriteString b " "))

        (.WriteString b (.String k)))

      (.WriteString b ")"))

    (.String b)))


^{:go/end 70} (go/method Add [^{:tag (* Tree)} t ^Tree k] (set! (.-Kids t) (append (.-Kids t) k)))


(go/type A "mutual recursion: A through a slice of B, B through a field A\n" (struct
    ^{:line 74 :tag int} n
    ^{:line 75 :tag (slice B)} bs))

(go/type B (struct
    ^{:line 78 :tag A} a
    ^{:line 79 :tag int} m))



(go/type Peano "a pointer type recursive through its element, and through an array\n" (* Peano))

^{:go/end 85} (go/func succ ^Peano [^Peano x] (let [p (new Peano)] (set! @p x) (conv Peano p)))
^{:go/end 93} (go/func count ^int [^Peano x]
  (let [n 0]
    (while (!= x nil)
      (set! x @x)
      (inc! n))

    ^{:line 92} n))


(go/type T18 (* (array 3 T19)))
(go/type T19 T18)


(go/type Src "generic: through a function, a channel; an interface naming a struct that names it\n" :type-params [T] (func [] [T (Src T)]))

^{:go/end 106} (go/func from :type-params [T] ^{:tag (Src T)} [^{:tag (slice T)} xs]
  (when (== (len xs) 0)
    (return nil))

  ^{:go/end 105} (fn [] :results [T (Src T)] (return (aget xs 0) (^{:inst [T]} from (subslice xs 1)))))


(go/type GChan :type-params [T] (chan (GChan T)))

(go/type List :type-params [T] (interface
    (Match ^string [^{:tag (func [] [string])} onNil ^{:tag (func [(Cons T)] [string])} onCons])))

(go/type Nil :type-params [T] (struct))
(go/type Cons :type-params [T] (struct
    ^{:line 115 :tag T} Head
    ^{:line 116 :tag (List T)} Tail))


^{:go/end 119} (go/method Match ^string [(Nil T) ^{:tag (func [] [string])} onNil ^{:tag (func [(Cons T)] [string])} _] (onNil))
^{:go/end 122} (go/method Match ^string [^{:tag (Cons T)} c ^{:tag (func [] [string])} _ ^{:tag (func [(Cons T)] [string])} onCons]
  (onCons c))


^{:go/end 128} (go/func show :type-params [T] ^string [^{:tag (List T)} l]
  (.Match l ^{:go/end 125} (fn ^string [] "nil") ^{:go/end 127} (fn ^string [^{:tag (Cons T)} c]
      (+ (fmt/Sprint (.-Head c)) ":" (^{:inst [T]} show (.-Tail c))))))



^{:go/end 201} (go/func main []
  (let [s (lit S (lit S) (lit S (lit S (lit S))) nil)]
    (set! s (append s (lit S (aget s 1))))
    (fmt/Println "S:" (len s) (depth s) (len (aget (aget (aget s 3) 0) 0)) (== (aget s 2) nil))
    (let [^{:tag (slice S)} ss (zero (slice S))]
      (set! ss (append ss s (aget s 1)))
      (fmt/Println "[]S:" (len ss) (depth (aget ss 0)) (depth (aget ss 1)))

      (let [^{:tag (slice int)} got (zero (slice int))
          ^{:line 139} f (counter 10 (addr got))]
        (set! f (((f 1) 2) 3))
        (let [^F g (zero F)]
          (fmt/Println "F:" got (!= f nil) (== g nil))
          (let [fs (lit (map string F) ["c" (counter 0 (addr got))])]
            ((aget fs "c") 100)
            (fmt/Println "F in a map:" (aget got (- (len got) 1)))

            (let [c (make Ch 1)]
              (>! c c)
              (let [d (<! c)]
                (>! d (make Ch))
                (let [e (<! c)]
                  (fmt/Println "Ch:" (== d c) (!= e nil) (len c) (cap c))

                  (let [m (lit M ["a" (lit M ["b" (lit M)])] ["c" nil])
                      ^{:line 155 :tag (slice string)} ks (zero (slice string))]
                    (keys m "" (addr ks))
                    (fmt/Println "M:" ks (len (aget m "a")) (== (aget m "x") nil))

                    (let [t (lit Tree :Name "root")]
                      (.Add t (lit Tree :Name "x"))
                      (.Add t (lit Tree :Name "y" :Kids (lit (slice Tree) (lit _ :Name "z"))))
                      (let [^fmt/Stringer st t]
                        (fmt/Println "Tree:" t (.String st) (len (.-Kids (aget (.-Kids t) 1))))
                        (let [^any x (aget (.-Kids t) 1)]
                          (when [(values tt ok) (assert Tree x)] ok
                            (fmt/Println "Tree asserted:" (.-Name (aget (.-Kids tt) 0))))

                          (fmt/Printf "Tree %%v: %v\n" t)

                          (let [a (lit A :n 1 :bs (lit (slice B) (lit _ :a (lit A :n 2) :m 3) (lit _ :a (lit A :n 4 :bs (lit (slice B) (lit _ :m 5))))))]
                            (fmt/Println "A:" (.-n a) (len (.-bs a)) (.-n (.-a (aget (.-bs a) 0))) (.-m (aget (.-bs (.-a (aget (.-bs a) 1))) 0)))
                            (let [bs (.-bs (.-a (aget (.-bs a) 1)))]
                              (set! (.-n (.-a (aget bs 0))) 7)
                              (fmt/Println "B:" (.-n (.-a (aget (.-bs (.-a (aget (.-bs a) 1))) 0))))

                              (let [^Peano zero (zero Peano)
                                  ^{:line 177} three (succ (succ (succ zero)))]
                                (fmt/Println "Peano:" (count three) (count @three) (count zero))

                                (let [^{:tag (array 3 T19)} arr (zero (array 3 T19))
                                    ^{:line 181} p19 (conv T19 (addr arr))]
                                  (aset @p19 1 p19)
                                  (fmt/Println "T19:" (== (aget @p19 0) nil) (== (aget @p19 1) p19))

                                  (let [^int sum (zero int)]
                                    (for [(values x next) ((^{:inst [int]} from (lit (slice int) 1 2 3 4)))] _ (set! (values x next) (next))
                                      (set! sum + x)
                                      (when (== next nil)
                                        (break)))


                                    (fmt/Println "Src:" sum)

                                    (let [gc (make (GChan string))]
                                      (go (^{:go/end 195} (fn [] (>! gc (make (GChan string))))))
                                      (let [r (<! gc)]
                                        (fmt/Println "GChan:" (!= r nil))

                                        (let [^{:tag (List int)} l (lit (Cons int) 1 (lit (Cons int) 2 (lit (Nil int))))]
                                          (fmt/Println "List:" (^{:inst [int]} show l)))))))))))))))))))))))

;; goi's interpreter tests: the depth limit in program mode (S23, GC42 (b); GOI-SPEC.md "Since v1: the depth limit"): a
;; recursion 300,000 calls deep, past the REPL's 100,000 and within program mode's 1,000,000, returns (bin/goi test: also
;; under ARBACE_GOI_DEPTH=150000, where it must end in goi's depth error). Converted by repr/go from Go source (bin/repr-go
;; read), its in-ns adjusted.
(ns go.t.deep (:require [arbace.go :as go]))
(go/package main :path "main" :lang "go1.27")
(go/file "deep.go" :imports [

    ^{:line 3} [fmt "fmt"]])


^{:go/end 11} (go/func down "down recurses n calls deep: deeper than goi's REPL limit (100,000), within program mode's (1,000,000)\n" ^int [^int n]
  (when (== n 0)
    (return 0))

  (+ (down (- n 1)) 1))


^{:go/end 15} (go/func main []
  (fmt/Println (down 300000)))

;; goi's interpreter tests: slices, arrays, append, copy, bounds errors recovered, 2D slices.
(ns go.t.slices (:require [arbace.go :as go]))
(go/package main :path "main")
(go/file "slices.go" :imports [[fmt "fmt"]])

(go/func try "try runs f, a panic recovered silently.\n" [^{:tag (func [])} f]
  (defer ((fn [] (recover))))
  (f))

(go/func catch [^{:tag (func [])} f]
  (defer ((fn []
            (let [r (recover)]
              (when (!= r nil)
                (fmt/Println "recovered:" r))))))
  (f))

(go/func sum ^int [& ^{:tag (slice int)} xs]
  (let [t 0]
    (range [_ x xs]
      (set! t + x))
    t))

(go/func main []
  (let [^{:tag (slice int)} xs nil]
    (fmt/Println (len xs) (cap xs) (== xs nil))
    (for [i 0] (< i 10) (inc! i)
      (set! xs (append xs (* i i))))
    (fmt/Println xs (len xs) (sum (spread xs)) (sum 1 2 3) (sum))
    (let [ys (subslice xs 2 5)
          zs (make (slice int) 2 10)]
      (aset ys 0 -1)
      (fmt/Println xs ys (len ys) (cap ys) (copy zs xs) zs)
      (set! zs (append zs 7 8))
      (fmt/Println zs (subslice zs 1 3 4) (cap (subslice zs 1 3 4))))
    (let [^{:tag (array 5 int)} a (lit (array 5 int) 1 2 3)
          b a]
      (aset b 0 9)
      (fmt/Println a b (len a) (subslice a 1 3) (== a b))
      (range [i v a]
        (aset a 4 100)
        (fmt/Print i "=" v " "))
      (fmt/Println a))
    (let [grid (make (slice (slice string)) 3)]
      (range [i _ grid]
        (aset grid i (make (slice string) i))
        (range [j _ (aget grid i)]
          (aset (aget grid i) j (fmt/Sprint i j))))
      (fmt/Println grid))
    (catch (fn [] (fmt/Println (aget xs 10))))
    (catch (fn [] (let [i -1] (fmt/Println (aget xs (+ i 0))))))
    (catch (fn [] (let [n 20] (fmt/Println (subslice xs 2 n)))))
    (catch (fn [] (let [n 3 m 2] (fmt/Println (subslice xs n m)))))
    (catch (fn [] (let [^{:tag (array 3 int)} a (lit (array 3 int)) i 5] (fmt/Println (aget a i)))))
    (catch (fn [] (let [s "abc" i 4] (fmt/Println (aget s i)))))
    (catch (fn [] (let [n -1] (fmt/Println (make (slice int) n)))))
    (try (fn [] (fmt/Print "")))))

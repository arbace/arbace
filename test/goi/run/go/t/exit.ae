;; goi's interpreter tests: os.Exit in program mode (the status, no deferred calls run).
(ns go.t.exit (:require [arbace.go :as go]))
(go/package main :path "main")
(go/file "exit.go" :imports [[fmt "fmt"] [os "os"]])

(go/func main []
  (defer (fmt/Println "not printed"))
  (fmt/Println "exiting" (len os/Args))
  (os/Exit 3))

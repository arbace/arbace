;; goi's interpreter tests (bin/goi test): integer and float arithmetic at every width,
;; wrapping, shifts, conversions, division by zero recovered.
(ns go.t.arith (:require [arbace.go :as go]))
(go/package main :path "main")
(go/file "arith.go" :imports [[fmt "fmt"]])

(go/func div ^int [^int a ^int b] (/ a b))

(go/func safeDiv [^int a ^int b] :results [^int q ^string err]
  (defer ((fn []
            (let [r (recover)]
              (when (!= r nil)
                (set! err (fmt/Sprint r)))))))
  (set! q (div a b))
  (return))

(go/func main []
  (let [^int8 a 100
        ^int8 b 100
        ^uint8 c 250
        ^int16 d -32768
        ^uint32 e 4000000000
        ^uint64 f 18446744073709551615
        ^int64 g -9223372036854775808]
    (fmt/Println (+ a b) (* a b) (- (- a) b) (+ c 10) (- d 1) (* e 2) (+ f 1) (- g 1))
    (fmt/Println (/ -7 2) (% -7 2) (/ g -1) (% (conv int8 -128) (conv int8 -1)))
    (fmt/Println (<< a 1) (>> d 3) (>> e 4) (<< f 63) (>> g 70) (bit-and-not 255 15) (bit-xor 12 10) (bit-not c))
    (let [^uint s 3
          ^int t 65]
      (fmt/Println (<< 1 s) (>> -16 s) (<< (conv uint8 1) t) (<< (conv int64 1) t)))
    (let [^float32 x 0.1
          ^float64 y 0.1]
      (fmt/Println (+ x x x) (+ y y y) (conv float64 x) (conv float32 y) (/ x 3) (* y 1e300 1e10))
      (let [h -3.9
            k 300
            ^int64 m 4294967297
            ^int64 n 9007199254740993
            ^int64 o 16777217]
        (fmt/Println (conv int h) (conv uint8 k) (conv int32 m) (conv float64 n) (conv float32 o) (conv uint64 h)
                     (conv int8 (conv float32 h)) (conv float64 (conv float32 h)))))
    (let [(values q err) (safeDiv 7 0)]
      (fmt/Println q err))
    (let [(values q err) (safeDiv 7 2)]
      (fmt/Println q err))
    (fmt/Printf "%d %x %o %b %c %q %U\n" 42 255 8 5 \a \b \☺)
    (fmt/Printf "%.3f %e %g %v %v\n" 3.14159 1e21 1e-7 (conv float32 1.5) (complex 1 2))))

;; goi's interpreter tests: append(s, t...) evaluates its slice operand once: a call there runs once, and
;; a variable an argument of that call kills (its last use in the statement) is not read again (pyi's
;; bytearray + bytes, append(append([]byte(nil), ba(a).b...), y...), panicked on a nil pointer).
(ns go.t.appendspread (:require [arbace.go :as go]))
(go/package main :path "main")
(go/file "appendspread.go" :imports [[fmt "fmt"]])

(go/type Object (interface (Kind ^string [])))
(go/type BA (struct ^{:tag (slice byte)} b))
(go/method Kind ^string [^{:tag (* BA)} x] "ba")

(go/var ^int calls)

(go/func ba ^{:tag (* BA)} [^Object o]
  (when [(values a ok) (assert (* BA) o)] ok
    (return a))
  nil)

(go/func id ^{:tag (slice byte)} [^{:tag (slice byte)} b]
  (set! calls + 1)
  b)

(go/func add [^Object a ^{:tag (slice byte)} y] :results [Object error]
  (return (addr (lit BA :b (append (append (conv (slice byte) nil) (spread (.-b (ba a)))) (spread y)))) nil))

(go/func main []
  (let [a (addr (lit BA :b (lit (slice byte) 97 98)))
        y (lit (slice byte) 99 100)]
    (fmt/Println (append (id (.-b a)) (spread y)) calls)
    (let [(values r err) (add a y)]
      (fmt/Println (.-b (assert (* BA) r)) err))
    (fmt/Println (append (id (lit (slice byte) 1)) (spread (lit (slice byte) 2 3))) calls)))

;; goi's interpreter tests and measurements (GOI-SPEC.md §12, GR3): fib 22, sumSq 1e6 and sieve
;; 1e6, the survey's programs (the X2 sketch's numbers: fib 22 2.87 ms, sumSq 1e6 22 ms; the
;; survey's sketch's sieve 1e6 55 ms). bin/goi run test/goi/run go.t.fib bench times them, and
;; since GR9a-c compiled code calling interpreted methods through compiled interfaces: sort.Sort of
;; 1e5 ints (Len, Less, Swap through sort.Interface) and 1e5 String calls by fmt (fmt.Stringer).
(ns go.t.fib (:require [arbace.go :as go]))
(go/package main :path "main")
(go/file "fib.go" :imports [[fmt "fmt"] [os "os"] [sort "sort"] [time "time"]])

(go/func fib ^int [^int n]
  (when (< n 2)
    (return n))
  (+ (fib (- n 1)) (fib (- n 2))))

(go/func sumSq ^int64 [^int32 n]
  (let [^int64 s (zero int64)]
    (for [i (conv int32 0)] (< i n) (inc! i)
      (set! s + (* (conv int64 i) (conv int64 i))))
    s))

(go/func sieve "sieve is the number of primes below n (the survey's: a []bool, marked from i*i).\n" ^int [^int n]
  (let [composite (make (slice bool) n)
        count 0]
    (for [i 2] (< i n) (inc! i)
      (when (not (aget composite i))
        (inc! count)
        (for [j (* i i)] (< j n) (set! j + i)
          (aset composite j true))))
    count))

(go/type ints (slice int))
(go/method Len ^int [^ints s] (len s))
(go/method Less ^bool [^ints s ^int i ^int j] (< (aget s i) (aget s j)))
(go/method Swap [^ints s ^int i ^int j] (set! (values (aget s i) (aget s j)) (values (aget s j) (aget s i))))

(go/func sortInts "sortInts sorts n ints by sort.Sort: compiled code calling Len, Less and Swap through sort.Interface.\n" ^bool [^int n]
  (let [s (make ints n)]
    (for [i 0] (< i n) (inc! i)
      (aset s i (% (* i 7919) n)))
    (sort/Sort s)
    (sort/IsSorted s)))

(go/type label int)
(go/method String ^string [^label l] "x")

(go/func stringers "stringers formats n interpreted fmt.Stringers by fmt: compiled code calling String.\n" ^int [^int n]
  (let [b (make (slice byte) 0 64)]
    (for [i 0] (< i n) (inc! i)
      (set! b (fmt/Appendf (subslice b _ 0) "%v" (conv label i))))
    (len b)))

(go/func best "best is the shortest of five runs of f, in ms.\n" ^float64 [^{:tag (func [])} f]
  (let [b (conv time/Duration (<< 1 62))]
    (for [k 0] (< k 5) (inc! k)
      (let [t (time/Now)]
        (f)
        (let [d (time/Since t)]
          (when (< d b)
            (set! b d)))))
    (/ (conv float64 (.Nanoseconds b)) 1e6)))

(go/func main []
  (fmt/Println (fib 22) (sumSq 1000000) (sieve 1000000))
  (when (> (len os/Args) 1)
    (let [r 0
          ^int64 q 0]
      (fmt/Printf "fib 22: %.2f ms\n" (best (fn [] (set! r (fib 22)))))
      (fmt/Printf "sumSq 1e6: %.2f ms\n" (best (fn [] (set! q (sumSq 1000000)))))
      (fmt/Printf "sieve 1e6: %.2f ms\n" (best (fn [] (set! r (sieve 1000000)))))
      (fmt/Printf "sort.Sort 1e5: %.2f ms\n" (best (fn [] (set! _ (sortInts 100000)))))
      (fmt/Printf "fmt.Stringer 1e5: %.2f ms\n" (best (fn [] (set! r (stringers 100000)))))
      (set! _ r)
      (set! _ q))))

;; goi's interpreter tests: closures (captured variables shared, per-iteration loop variables),
;; function values, recursion through a variable, multiple results, variadic calls.
(ns go.t.closures (:require [arbace.go :as go]))
(go/package main :path "main")
(go/file "closures.go" :imports [[fmt "fmt"] [sort "sort"] [strings "strings"]])

(go/func counter ^{:tag (func [] [int])} []
  (let [n 0]
    (fn ^int [] (inc! n) n)))

(go/func divmod [^int a ^int b] :results [^int q ^int r]
  (set! q (/ a b))
  (set! r (% a b))
  (return))

(go/func apply ^int [^{:tag (func [int int] [int])} f ^int a ^int b] (f a b))

(go/func main []
  (let [c (counter)
        d (counter)]
    (c) (c)
    (fmt/Println (c) (d)))
  (let [fs (make (slice (func [] [int])) 0)]
    (for [i 0] (< i 3) (inc! i)
      (set! fs (append fs (fn ^int [] (* i 10)))))
    (range [_ f fs]
      (fmt/Print (f) " "))
    (fmt/Println))
  (let [^{:tag (func [int] [int])} fib nil]
    (set! fib (fn ^int [^int n]
                (when (< n 2) (return n))
                (+ (fib (- n 1)) (fib (- n 2)))))
    (fmt/Println (fib 20)))
  (let [(values q r) (divmod 17 5)]
    (fmt/Println q r (apply (fn ^int [^int x ^int y] (- x y)) 10 3)))
  (let [xs (lit (slice int) 5 2 8 1)]
    (sort/Slice xs (fn ^bool [^int i ^int j] (< (aget xs i) (aget xs j))))
    (fmt/Println xs (strings/Map (fn ^rune [^rune r] (+ r 1)) "HAL")))
  (let [x 1
        add (fn [^int n] (set! x + n))]
    (add 2)
    (add 3)
    (fmt/Println x)))

;; goi's interpreter tests (GR8a, F1): labels on short variable declarations (L: x := e), the
;; targets of goto: forward over statements in a loop (regexp's tryBacktrack), backward in the
;; declaration's scope, in a switch case from a nested block. Converted by repr/go from Go source
;; (bin/repr-go read), its in-ns adjusted.
(ns go.t.labels (:require [arbace.go :as go]))
(go/package main :path "main" :lang "go1.27")
(go/file "labels.go" :doc "Labels on short variable declarations (L: x := e), goto's targets (GR8a, F1).\n" :imports [

    ^{:line 4} [fmt "fmt"]])


^{:go/end 20} (go/func forward "forward: a goto over statements to a labeled declaration (regexp's tryBacktrack)\n" ^int [^int n]
  (let [s 0]
    (for [i 0] (< i n) (inc! i)
      (when (== (% i 2) 0)
        (goto :Skip))

      (set! s + 100)
      (continue)
      (let [
          ^{:line 16 :go/label :Skip} x i]
        (set! s + x)))

    ^{:line 19} s))



^{:go/end 32} (go/func backward "backward: a goto from the declaration's scope back to it, a loop by labels\n" ^int [^int n]
  (let [s 0]
    (let [
        ^{:line 26 :go/label :Again} k (+ s 1)]
      (set! s k)
      (when (< s n)
        (goto :Again))

      ^{:line 31} s)))



^{:go/end 46} (go/func second "second: the label on the second of two declarations\n" [^int n] :results [int int]
  (let [a 1
      ^{:line 37} count 0]
    (let [
        ^{:line 39 :go/label :Loop} b (* a 2)]
      (set! a b)
      (inc! count)
      (when (< a n)
        (goto :Loop))

      (return a count))))



^{:go/end 67} (go/func nested "nested: a labeled declaration inside a switch case, the goto in a nested block\n" ^{:tag (slice string)} [^{:tag (slice int)} xs]
  (let [^{:tag (slice string)} out (zero (slice string))]
    (range [_ v xs]
      (switch
        (case [(> v 0)]
          (when (> v 10)
            (goto :Big))

          (set! out (append out (fmt/Sprint "small " v)))
          (continue)
          (let [
              ^{:line 60 :go/label :Big} w (* v 2)]
            (set! out (append out (fmt/Sprint "big " w)))))
        (default
          (set! out (append out "none")))))


    ^{:line 66} out))


^{:go/end 74} (go/func main []
  (fmt/Println (forward 5) (forward 1) (forward 0))
  (fmt/Println (backward 7))
  (fmt/Println (second 100))
  (fmt/Println (nested (lit (slice int) 3 30 -1 12))))

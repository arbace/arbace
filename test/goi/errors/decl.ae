;; goi's checker: errors of declarations (doc/go/GOI-SPEC.md §3.4, §3.8). Each ERROR comment
;; is gc's message for the line (test/goi/check_test.ae; bin/goi test --gc compares them with gc).
(go/package main :path "main")
(go/file "decl.go" :imports [[fmt "fmt"] [os "os"]]) ; ERROR "\"fmt\" imported and not used"

(go/var ^int x)
(go/var ^string x) ; ERROR "x redeclared in this block"

(go/func init ^int [] 1) ; ERROR "func init must have no arguments and no return values"

^{:go/end 13} (go/func f ^int [^int a]
  (when (> a 0)
    (return 1))) ; ERROR "missing return"

(go/func g []
  (let [y 1 ; ERROR "declared and not used: y"
        z 2]
    (println z undefinedName))) ; ERROR "undefined: undefinedName"

(go/func h []
  (label :L (println 1))) ; ERROR "label L defined and not used"

(go/func main []
  (os/Exit 0))

;; goi's checker: errors of constants (doc/go/GOI-SPEC.md §3.4, §3.5).
(go/package main :path "main")
(go/file "const.go" :imports [])

(go/const ^{:tag int8} a 300) ; ERROR "cannot use 300 (untyped int constant) as int8 value in constant declaration (overflows)"
(go/const b (/ 1 0)) ; ERROR "invalid operation: division by zero"
(go/const c (<< 1 1000)) ; ERROR "constant shift overflow"
(go/const ^{:tag int} d 1.5) ; ERROR "cannot use 1.5 (untyped float constant) as int value in constant declaration (truncated)"
(go/const e (<< 1 -1)) ; ERROR "invalid operation: negative shift count -1 (untyped int constant)"
(go/var ^{:tag (array -1 int)} v) ; ERROR "invalid array length -1 (untyped int constant)"
(go/var ^int w)
(go/const k w) ; ERROR "w (variable of type int) is not constant"

(go/func main [])

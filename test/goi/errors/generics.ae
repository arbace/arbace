;; goi's checker: errors of generic code (doc/go/GOI-SPEC.md §9.1, GR6).
(go/package main :path "main")
(go/file "generics.go" :imports [])

(go/type Number (interface (| (tilde int) (tilde float64))))
(go/type List :type-params [T] (struct ^T head))

(go/func Id :type-params [T] ^T [^T x] x)
(go/func Num :type-params [^Number T] ^T [^T x] x)
(go/func Add :type-params [T] ^T [^T a ^T b]
  (+ a b)) ; ERROR "invalid operation: operator + not defined on a (variable of type T constrained by any)"
(go/func Call :type-params [T] [^T x]
  (.M x)) ; ERROR "x.M undefined (type T has no field or method M)"

(go/var ^{:tag List} bad) ; ERROR "cannot use generic type List[T any] without instantiation"

(go/func main []
  (let [f Id] ; ERROR "cannot use generic function Id without instantiation"
    (println f))
  (println ((inst Id int string) 1)) ; ERROR "got 2 type arguments but want 1"
  (println (Num "a")) ; ERROR "string does not satisfy Number (string missing in ~int | ~float64)"
  (println (Id 1 2))) ; ERROR "too many arguments in call to Id\n\thave (number, number)\n\twant (T)"

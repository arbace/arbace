;; goi's checker: errors of calls, comparisons and interfaces (doc/go/GOI-SPEC.md §3.4).
(go/package main :path "main")
(go/file "calls.go" :imports [])

(go/type I (interface (M ^int [])))
(go/type T (struct))
(go/method M ^string [^T t] "")

(go/func f [^int a ^string b])
(go/func g [^int a & ^{:tag (slice int)} rest])

(go/func main []
  (let [^{:tag (slice int)} s nil
        ^any v nil]
    (f 1) ; ERROR "not enough arguments in call to f\n\thave (number)\n\twant (int, string)"
    (f 1 "a" 2) ; ERROR "too many arguments in call to f\n\thave (number, string, number)\n\twant (int, string)"
    (f "a" "b") ; ERROR "cannot use \"a\" (untyped string constant) as int value in argument to f"
    (f 1 (spread s)) ; ERROR "cannot use ... in call to non-variadic f"
    (g 1 2 3)
    (println (== s s)) ; ERROR "invalid operation: s == s (slice can only be compared to nil)"
    (let [^I i (lit T)] ; ERROR "cannot use T{} (value of struct type T) as I value in variable declaration: T does not implement I (wrong type for method M)\n\t\thave M() string\n\t\twant M() int"
      (println i))
    (type-switch [x v] ; ERROR "x declared and not used"
      (case [int] (println))
      (case [int] (println))) ; ERROR "duplicate case int in type switch"
    (defer (conv int 1)))) ; ERROR "defer requires function call, not conversion int(1) (constant 1 of type int)"

;; goi's checker: a std constraint's terms in a message, in their written order (GC144 (b),
;; doc/go/GOI-SPEC.md, As built: GR7c).
(go/package main :path "main")
(go/file "ordered.go" :imports [[cmp "cmp"]])

(go/func main []
  (println (cmp/Compare true false))) ; ERROR "bool does not satisfy cmp.Ordered (bool missing in ~int | ~int8 | ~int16 | ~int32 | ~int64 | ~uint | ~uint8 | ~uint16 | ~uint32 | ~uint64 | ~uintptr | ~float32 | ~float64 | ~string)"

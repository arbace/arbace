;; goi's checker: cycles and sizes as go/types reports them (doc/go/GOI-SPEC.md, As built: GR7c).
(go/package main :path "main")
(go/file "cycles.go" :imports [[unsafe "unsafe"]])

(go/type A B) ; ERROR "invalid recursive type A"
(go/type B A)

(go/type S1 (struct ^S2 f)) ; ERROR "invalid recursive type S1"
(go/type S2 (struct ^S1 g))

(go/type I (interface I)) ; ERROR "invalid recursive type: I refers to itself"

(go/type E (array 1073741824 complex128))
(go/var ^{:tag (array 1073741824 E)} big)
(go/var _ (unsafe/Sizeof big)) ; ERROR "big (variable of type [1073741824]E) is too large"

(go/func foo [^foo x]) ; ERROR "foo (function) is not a type"

(go/var x y) ; ERROR "initialization cycle for x"
(go/var y x)

(go/func main []
  (let-type [^:alias T T] ; ERROR "invalid recursive type: T refers to itself"
    (println 1)))

;; goi's checker: errors of expressions (doc/go/GOI-SPEC.md §3.4).
(go/package main :path "main")
(go/file "expr.go" :imports [[strings "strings"]])

(go/type P (struct ^int X))

(go/func main []
  (let [i 1
        s "a"
        p (lit P)
        f 1.5]
    (println (+ i s)) ; ERROR "invalid operation: i + s (mismatched types int and string)"
    (println (not i)) ; ERROR "invalid operation: operator ! not defined on i (variable of type int)"
    (println (i 1)) ; ERROR "invalid operation: cannot call i (variable of type int): int is not a function"
    (println @i) ; ERROR "invalid operation: cannot indirect i (variable of type int)"
    (println (.-Y p)) ; ERROR "p.Y undefined (type P has no field or method Y)"
    (println (aget i 0)) ; ERROR "cannot index i (variable of type int)"
    (println (addr 1)) ; ERROR "invalid operation: cannot take address of 1 (untyped int constant)"
    (println (% f 2)))) ; ERROR "invalid operation: operator % not defined on f (variable of type float64)"

(go/func more [^{:tag (* strings/Builder)} b ^P p ^{:tag (slice int)} s]
  (println (.-buf b)) ; ERROR "b.buf undefined (cannot refer to unexported field buf)"
  (println (.-x p)) ; ERROR "p.x undefined (type P has no field or method x, but does have field X)"
  (println (len 1)) ; ERROR "invalid argument: 1 (untyped int constant) for built-in len"
  (append s 1)) ; ERROR "append(s, 1) (value of type []int) is not used"

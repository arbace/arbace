;; goi's checker: errors of type declarations (doc/go/GOI-SPEC.md §3.4).
(go/package main :path "main")
(go/file "types.go" :imports [[strings "strings"]])

(go/type T (struct ^T next)) ; ERROR "invalid recursive type: T refers to itself"

(go/type M (map (slice int) bool)) ; ERROR "invalid map key type []int"

(go/type S (struct ^int X))
(go/method X ^int [^S s] 1) ; ERROR "field and method with the same name X"

(go/method Len ^int [^strings/Builder b] 0) ; ERROR "cannot define new methods on non-local type strings.Builder"

(go/type U int)
(go/method m [^U u])
(go/method m [^U u]) ; ERROR "method U.m already declared at types.go:15"

(go/func main [])

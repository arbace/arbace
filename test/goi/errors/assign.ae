;; goi's checker: errors of assignability and assignments (doc/go/GOI-SPEC.md §3.4).
(go/package main :path "main")
(go/file "assign.go" :imports [])

(go/type I (interface (M [])))
(go/type T (struct))
(go/method M [^{:tag (* T)} t])

(go/func two [] :results [int int] (return 1 2))

(go/func main []
  (let [^int a 0
        ^string s ""
        ^I i nil]
    (set! a s) ; ERROR "cannot use s (variable of type string) as int value in assignment"
    (set! i (lit T)) ; ERROR "cannot use T{} (value of struct type T) as I value in assignment: T does not implement I (method M has pointer receiver)"
    (set! a (two)) ; ERROR "assignment mismatch: 1 variable but two returns 2 values"
    (let [a 1] ; ERROR "declared and not used: a"
      (let [a 2] ; ERROR "no new variables on left side of :="
        (set! (len s) 1))) ; ERROR "cannot assign to len(s) (neither addressable nor a map index expression)"
    (println a s i)))

;; goi's checker: an instantiation cycle (go/types' mono.go, doc/go/GOI-SPEC.md, As built:
;; GR7c), reported when the package has no other error.
(go/package main :path "main")
(go/file "mono.go" :imports [])

(go/func f :type-params [T] [^T t] ; ERROR "instantiation cycle:"
  ((inst f (slice T)) (lit (slice T) t)))

(go/func main []
  ((inst f int) 1))

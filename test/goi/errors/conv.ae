;; goi's checker: errors of conversions and type assertions (doc/go/GOI-SPEC.md §3.4).
(go/package main :path "main")
(go/file "conv.go" :imports [])

(go/type I (interface (M [])))

(go/func main []
  (let [s "a"
        ^I i nil]
    (println (conv int s)) ; ERROR "cannot convert s (variable of type string) to type int"
    (println (conv int8 1000)) ; ERROR "constant 1000 overflows int8"
    (println (assert int i)) ; ERROR "impossible type assertion: i.(int)\n\tint does not implement I (missing method M)"
    (println (assert int s)))) ; ERROR "invalid operation: s (variable of type string) is not an interface"

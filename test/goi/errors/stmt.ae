;; goi's checker: errors of statements (doc/go/GOI-SPEC.md §3.4).
(go/package main :path "main")
(go/file "stmt.go" :imports [])

(go/func f ^int [] (return 1 2)) ; ERROR "too many return values\n\thave (number, number)\n\twant (int)"
(go/func g [] :results [int string] (return 1)) ; ERROR "not enough return values\n\thave (number)\n\twant (int, string)"

(go/func main []
  (let [i 1]
    (when i ; ERROR "non-boolean condition in if statement"
      (println))
    (break) ; ERROR "break is not in a loop, switch, or select"
    (+ i 1) ; ERROR "i + 1 (value of type int) is not used"
    (switch i
      (case [1] (println))
      (case [1] (println))))) ; ERROR "duplicate case 1 (constant of type int) in expression switch"

(go/func labels []
  (goto :L) ; ERROR "goto L jumps over declaration of x at stmt.go:20"
  (let [x 1]
    (label :L (println x))
    (break :M) ; ERROR "break label not defined: M"
    (label :N (println)) ; ERROR "label N defined and not used"
    (goto :Q) ; ERROR "goto Q jumps into block starting at stmt.go:25"
    (do (label :Q (println)))))

;; goi's check (doc/go/GOI-SPEC.md §11.3): the programs of $GOROOT/test whose difference from gc
;; is by design, each with its reason. bin/goi check reports a listed program that does not
;; pass as known (one that passes, as passing). Read with the Clojure reader.
[
 ;; runtime.Caller, runtime.Callers, runtime.FuncForPC and the traces of panics name gc's frames
 ;; and lines: goi's are its own nodes' (§1.1, §10.6; the interpreted frames in traces are GR5's)
 ["fixedbugs/bug348.go" "runtime.Callers' frames (goi's nodes, not gc's)"]
 ["fixedbugs/issue14646.go" "runtime.Caller's lines (goi's nodes, not gc's)"]
 ["fixedbugs/issue17381.go" "runtime.Callers' frames (goi's nodes, not gc's)"]
 ["fixedbugs/issue18149.go" "runtime.Caller's lines with line directives (goi's nodes, not gc's)"]
 ["fixedbugs/issue22662.go" "runtime.Caller's lines with line directives (goi's nodes, not gc's)"]
 ["fixedbugs/issue27201.go" "runtime.Callers' frames of a panic (goi's nodes, not gc's)"]
 ["fixedbugs/issue29504.go" "the lines of panics' tracebacks (goi's nodes, not gc's)"]
 ["fixedbugs/issue4562.go" "runtime.Caller's frames of a panic (goi's nodes, not gc's)"]
 ["fixedbugs/issue58300.go" "runtime.Callers' frames (goi's nodes, not gc's)"]
 ["fixedbugs/issue58300b.go" "runtime.Callers' frames (goi's nodes, not gc's)"]
 ["fixedbugs/issue5856.go" "runtime.Caller's line of a deferred call (goi's nodes, not gc's)"]
 ["inline_literal.go" "runtime.FuncForPC of gc's program counters"]
 ;; the collector's and the compiler's own behaviour: finalizers' timing, stack objects'
 ;; liveness, escape analysis (§1.1)
 ["stackobj.go" "the liveness of stack objects (gc's escape analysis)"]
 ["stackobj3.go" "the liveness of stack objects (gc's escape analysis)"]
 ["finprofiled.go" "finalizers' timing and the memory profile (gc's allocation)"]
 ;; an interpreter's speed: the program takes more than the check's 10 s (fib-like recursion of
 ;; hundreds of millions of calls, gc's 1 s)
 ["abi/fibish.go" "speed: f(40), hundreds of millions of interpreted calls, beyond the check's 10 s"]
 ["abi/fibish_closure.go" "speed: f(40) through closures, beyond the check's 10 s"]
 ["abi/uglyfib.go" "speed: fib-like recursion, beyond the check's 10 s"]
 ["divmod.go" "speed: every int8 to int64 division and remainder of many operands, beyond the check's 10 s"]
 ;; unsafe pointer arithmetic over memory layout gc decides (§1.1)
 ["nilptr.go" "unsafe addresses of huge arrays (gc's layout of the data segment)"]
 ["fixedbugs/issue4585.go" "== of structs with blank fields written through unsafe (reflect-made types compare blank fields)"]
 ;; compiled code's reflect sees an interpreted named non-struct type's value as its proxy (G8, §5.3)
 ["fixedbugs/issue48357.go" "reflect.ValueOf of an interpreted named array type's value: its proxy (§5.3)"]
 ;; the program runs the go command over $GOROOT/test (gc's run fails as goi's; their log lines'
 ;; times differ)
 ["fixedbugs/issue21317.go" "runs the go command (gc's run fails too; the log's time differs)"]
 ["linkobj.go" "runs the go command (gc's run fails too; the log's time differs)"]
]

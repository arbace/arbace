;; goi's check (doc/go/GOI-SPEC.md §11.3): the programs of $GOROOT/test whose difference from gc
;; is by design, each with its reason. bin/goi check reports a listed program that does not
;; pass as known (one that passes, as passing). Read with the Clojure reader.
[
 ;; runtime.Caller, runtime.Callers, runtime.FuncForPC and the traces of panics: goi's frames since
 ;; 2026-11-04 (doc/go/GOI-SPEC.md, "Since v1: frames"), at the forms' statement lines; these name a
 ;; position within a line, which the forms do not keep (SPEC.md §10.1)
 ["fixedbugs/issue22662.go" "runtime.Caller's lines with /*line directives within a line (positions the forms do not keep)"]
 ["fixedbugs/issue29504.go" "the lines of panics' tracebacks set by /*line directives within an expression (positions the forms do not keep)"]
 ;; the collector's and the compiler's own behaviour: finalizers' timing, stack objects'
 ;; liveness, escape analysis (§1.1)
 ["stackobj.go" "the liveness of stack objects (gc's escape analysis)"]
 ["stackobj3.go" "the liveness of stack objects (gc's escape analysis)"]
 ["finprofiled.go" "finalizers' timing and the memory profile (gc's allocation)"]
 ;; an interpreter's speed: the program takes more than the check's 10 s (fib-like recursion of
 ;; hundreds of millions of calls, gc's 1 s)
 ["abi/fibish.go" "speed: f(40), hundreds of millions of interpreted calls, beyond the check's 10 s"]
 ["abi/fibish_closure.go" "speed: f(40) through closures, beyond the check's 10 s"]
 ;; goi's call depth limit (S23: 100,000 interpreted calls, gc's text; GR7a)
 ["peano.go" "goi's call depth limit (S23): fact(9) in Peano numbers recurses 362,880 calls deep"]
 ;; unsafe pointer arithmetic over memory layout gc decides (§1.1)
 ["nilptr.go" "unsafe addresses of huge arrays (gc's layout of the data segment)"]
 ;; GR4 (doc/go/GOI-SPEC.md, As built: GR4); goi's frames since 2026-11-04 ("Since v1: frames"): a
 ;; call spread over lines is at its operator's line in gc's, at its statement's in the forms
 ["devirtualization_nil_panics.go" "runtime.Callers' line of a panic in a call spread over two lines (gc's operator line; the forms keep the statement's)"]
 ;; the collector's and the compiler's own behaviour: finalizers' timing, allocations, escape
 ;; analysis of uintptr arguments, profiling (§1.1)
 ["closure.go" "testing.AllocsPerRun of closures (gc's escape analysis)"]
 ["fixedbugs/issue15281.go" "runtime.ReadMemStats after an allocation (gc's stack allocation)"]
 ["fixedbugs/issue24491a.go" "uintptr arguments keeping their pointers alive (gc's uintptrescapes)"]
 ["fixedbugs/issue24491b.go" "uintptr arguments keeping their pointers alive (gc's uintptrescapes)"]
 ["fixedbugs/issue27518b.go" "a finalizer's timing"]
 ["fixedbugs/issue32477.go" "a finalizer's timing"]
 ["fixedbugs/issue46725.go" "a finalizer's timing"]
 ["fixedbugs/issue57823.go" "a finalizer's timing"]
 ["heapsampling.go" "the heap profile's samples of gc's allocation sites"]
 ["gc2.go" "runtime.ReadMemStats of channels made in a loop (and speed: beyond the check's 10 s)"]
 ;; speed: tens of millions of interpreted method calls across goroutines, beyond the check's 10 s
 ;; (reflectmethod2.go and reflectmethod3.go, known for reflect's method lookups (S39), pass since GR8b)
 ;; GR6 (doc/go/GOI-SPEC.md, As built: GR6): generic programs. A finalizer's timing (an
 ;; interpreter's frames and closures keep the values alive); compiled reflect and %T see an
 ;; interpreted instance's representation (§5.2, §9.4, G8): its proxy, the RT of its underlying
 ;; type, not gc's instance names (main.T[int], the mangled ·N of local types)
 ["fixedbugs/issue54343.go" "a finalizer's timing"]
 ["typeparam/chans.go" "a finalizer's timing (its _Ranger test waits for one)"]
 ["typeparam/chansimp.go" "a finalizer's timing (its _Ranger test waits for one)"]
 ;; errorcheck programs (GR7b): gc's messages that goi's forms or types cannot give (byte, rune
 ;; and aliases are named as written since GC157 (b), 2026-10-24: their six programs pass)
 ;; mode :lines keeps values, not their spellings (doc/go/SPEC.md §10.1): 1e200 is read as 1.0E200
 ["fixedbugs/issue19947.go" "errorcheck: a literal's spelling in messages (1e200; mode :lines keeps values)"]
 ["fixedbugs/issue56220.go" "errorcheck: a literal's spelling in messages (.0000001, 1_000_000; mode :lines keeps values)"]
 ["fixedbugs/issue31747.go" "errorcheck: -lang=go1.12's errors on literal syntax (0b, 0o, _: mode :lines keeps values)"]
 ;; the forms have no columns, nor the line of a composite literal's closing brace
 ["fixedbugs/issue68292.go" "errorcheck: a position with its column in a message (the forms keep lines)"]
 ["fixedbugs/issue23732.go" "errorcheck: an error at a literal's closing brace (its line not in the forms)"]
 ["funcdup2.go" "errorcheck: errors inside a type spanning lines, written on its declaration's line (a tag)"]
 ;; the forms of an invalid program say another program
 ["return.go" "errorcheck: a final expression statement of a function with results is its return in the forms (SPEC §6.4)"]
 ;; GR7c (doc/go/GOI-SPEC.md, As built: GR7c): what the remaining programs' messages need and
 ;; the forms or goi's types cannot say, by GC49's reasons
 ["fixedbugs/bug217.go" "errorcheck: two receivers (a b, c d) are written [^b a ^d c], a receiver and a parameter (SPEC §6.4): the forms say another program (gc's syntax's two errors merged since GPS41 (c); goi's undefined: d left over)"]
 ["fixedbugs/issue11614.go" "errorcheck: a parenthesized expression's spelling in a message ((interface{int})): mode :lines keeps no parentheses (and goi abridges a type literal in an expression as go/types' ExprString does, interface{…})"]
 ;; GR8a (doc/go/GOI-SPEC.md, As built: GR8a): programs that run now that their std packages are
 ;; compiled or interpreted, their difference by design
 ["fixedbugs/issue8606b.go" "== of interfaces holding structs compares their fields by goi's and reflect's equality, not gc's generated order (string lengths first): a string pointing into protected memory faults"]
 ["fixedbugs/issue4618.go" "testing.AllocsPerRun counts the interpreter's allocations, not gc's (escape analysis)"]
 ;; GP6 (doc/go/GO-PARSER-SURVEY.md "As built: GP6", GPS9 (b), GPS43): go/parser rejects these, and
 ;; gc's syntax reports only some of their errors (or none, E2's two it accepts); gc's types2
 ;; reports the rest on syntax's tree, which repr/go does not read (GPS9 (c)); issue23586 and
 ;; issue4468 pass since 2026-11-04, the driver's port of types2's go/defer check (GOI-SPEC.md,
 ;; "Since v1: types2's go and defer check")
 ["fixedbugs/issue50372.go" "errorcheck: go/parser rejects it, gc's syntax accepts it: types2's errors (range clause permits at most two iteration variables) on syntax's tree, which repr/go does not read"]
 ["slice3err.go" "errorcheck: go/parser rejects it, gc's syntax reports some of its errors: types2's (3-index slice of string) on syntax's tree, which repr/go does not read"]
 ;; gc's flags of run actions (doc/go/GOI-SPEC.md, "Since v1: gc's flags of run actions"): run since 2026-11-04, gc's
 ;; reference built with the action's flags, goi running the program as written; these two print what the flags
 ;; make gc's code do, the code generation the flag selects (the three under -l=4's inlining, runtime.Callers'
 ;; frames, pass since goi's frames: GOI-SPEC.md, "Since v1: frames")
 ["convert5.go" "gc flags: -d=converthash=qy selects gc's saturating float-to-integer conversions; goi converts as gc's default on amd64 does"]
 ["maymorestack.go" "gc flags: -d=maymorestack makes gc's function prologues call the program's hook, which goi's calls have not"]
]

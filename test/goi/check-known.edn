 ;; errorcheck programs (GR7b): gc's messages that goi's forms or types cannot give (byte, rune
 ;; and aliases are named as written since GC157 (b), 2026-10-24: their six programs pass)
 ;; mode :lines keeps values, not their spellings (doc/go/SPEC.md §10.1): 1e200 is read as 1.0E200
 ["fixedbugs/issue19947.go" "errorcheck: a literal's spelling in messages (1e200; mode :lines keeps values)"]
 ["fixedbugs/issue56220.go" "errorcheck: a literal's spelling in messages (.0000001, 1_000_000; mode :lines keeps values)"]
 ["fixedbugs/issue31747.go" "errorcheck: -lang=go1.12's errors on literal syntax (0b, 0o, _: mode :lines keeps values)"]
 ;; the forms have no columns, nor the line of a composite literal's closing brace
 ["fixedbugs/issue68292.go" "errorcheck: a position with its column in a message (the forms keep lines)"]

;; goi's divergences from gc at v1 (doc/go/GOI-SPEC.md, "v1's divergences (2026-10-20)", GR10): the
;; classes every program of bin/goi check that does not pass falls into, each with why it is by
;; design or deferred and where that was decided. A program's class is the first whose :match
;; finds its result and reason ("RESULT REASON", as the references and test/goi/check-known.edn
;; write them). bin/goi divergences checks the references against them (test/goi/divergences.ae).
;; Read with the Clojure reader.
[
 {:id :foreign-code
  :title "assembly, cgo, go:linkname"
  :kind :design
  :why "goi interprets Go forms; a function written in assembly (or bodiless), cgo and go:linkname's pulls of gc's symbols have no forms to interpret"
  :decided "§1.1"
  :match [#"^unsupported assembly \(" #"^unsupported go:linkname \(" #"^unsupported a function without a body \(assembly\)" #"cgo"]}
 {:id :embed
  :title "go:embed"
  :kind :deferred
  :why "the embed package is refused at the import (GR8a's out-of-scope list); GS14 (a) decided go:embed for after GR5, not built for v1; the two errorcheck programs expect gc's noder's directive errors"
  :decided "§1.1, GS14, GC101, GC161"
  :match [#"go:embed is out of scope"]}
 {:id :package-tests
  :title "package tests"
  :kind :design
  :why "goi loads a package's own files, not its _test.go files (:test-files); no program of the check needs them"
  :decided "§1.1, S45"
  :match [#":test-files|_test\.go"]}
 {:id :frames
  :title "runtime.Caller, runtime.Callers, FuncForPC and traces naming goi's frames"
  :kind :design
  :why "gc's program counters and frames are its compiled code's; goi's are its nodes' (traces name the interpreted functions and lines, GR5, but not gc's frames)"
  :decided "§1.1, §10.6"
  :match [#"^known .*(runtime\.Callers?|FuncForPC|runtime\.Stack|debug\.Stack|the trace of a panic|tracebacks)"]}
 {:id :memory
  :title "finalizer timing, escape analysis, memory statistics, heap profiles"
  :kind :design
  :why "the collector sees the interpreter's frames, closures and allocations, not gc's escape analysis and stack allocation"
  :decided "§1.1"
  :match [#"^known .*(finalizer|escape analysis|ReadMemStats|heap profile|AllocsPerRun|uintptrescapes|liveness of stack objects)"]}
 {:id :unsafe-layout
  :title "unsafe layout and memory order gc decides"
  :kind :design
  :why "addresses of the data segment and the order of gc's generated comparisons over memory protected by the program are gc's code generation"
  :decided "§1.1, §5.4"
  :match [#"^known unsafe addresses" #"^known == of interfaces holding structs"]}
 {:id :speed
  :title "speed: programs beyond the check's 10 s"
  :kind :design
  :why "an interpreter is 10-100 times slower than gc's code; the check's limit is 10 s per program"
  :decided "§11.1, GR3's criterion"
  :match [#"^known speed: "]}
 {:id :call-depth
  :title "S23's call depth"
  :kind :design
  :why "goi's limit of 100,000 interpreted calls (gc's text when exceeded), where gc's stack grows to 1 GB"
  :decided "S23"
  :match [#"^known goi's call depth limit"]}
 {:id :toolchain
  :title "runs of the go command and the toolchain's root"
  :kind :design
  :why "the program runs the go command over $GOROOT/test (gc's run fails as goi's, the log's times differ) or asks runtime.GOROOT, which goi's program has not"
  :decided "§1.1, GR4"
  :match [#"^known runs the go command" #"^known runtime\.GOROOT"]}
 {:id :no-forms
  :title "syntax errors and invalid programs repr/go cannot convert"
  :kind :design
  :why "goi interprets Go forms; go/parser rejects these programs, or their trees have no forms (a selection without an object, a conversion's arity, x.(type) outside a type switch, a constant without a value or beyond the reader's range)"
  :decided "GC47, G1"
  :match [#"^unsupported syntax errors: " #"^unsupported repr/go cannot convert the invalid program"]}
 {:id :gc-flags
  :title "gc's optimizer diagnostics and flags"
  :kind :design
  :why "escape analysis, inlining, liveness, the SSA back end's passes and their debug output (-m, -l, -live, -N, -wb, -d=...) and run actions built with -gcflags or -ldflags: gc's phases after type checking, which goi does not have"
  :decided "§1.1, GC46"
  :match [#"^unsupported -(m|l|live|N|wb|smallframes)(=[^:]*)?: " #"^unsupported -d=[^:]*: " #"^skip the action needs gc flags: "]}
 {:id :race
  :title "-race"
  :kind :design
  :why "gc's race instrumentation"
  :decided "§1.1, GC46"
  :match [#"^unsupported -race: "]}
 {:id :gc-std
  :title "gc compiling std or the runtime"
  :kind :design
  :why "-std, -+, -complete, -asmhdr, -spectre: gc's modes for compiling the standard library and the runtime"
  :decided "§1.1, GC46"
  :match [#"^unsupported -(std|\+|complete|asmhdr|spectre)[^:]*: "]}
 {:id :gc-phases
  :title "errors of gc's phases after type checking"
  :kind :design
  :why "go/types reports none of the expected errors: they are gc's noder's or the SSA back end's (stack frame too large, misplaced compiler directive), which goi does not have"
  :decided "GC46"
  :match [#"^unsupported errors of gc's phases after type checking"]}
 {:id :line-directives
  :title "line directives"
  :kind :design
  :why "gc's positions follow //line and /*line directives; goi's errors are at the forms' lines"
  :decided "GC46"
  :match [#"^unsupported line directives: "]}
 {:id :spellings
  :title "message spellings, columns and lines the forms do not keep"
  :kind :design
  :why "mode :lines keeps values, statements' lines and no columns (SPEC.md §10.1): a literal's spelling, parentheses, a position's column, a closing brace's or an else's line; and the forms of an invalid program that say another program (two receivers, a final expression statement as a return, a conversion's ...)"
  :decided "GC49, SPEC.md §6.4, §10.1"
  :match [#"^known errorcheck: (a literal's spelling|-lang=go1\.12's errors on literal syntax|a position with its column|an error at a literal's closing brace|errors inside a type spanning lines|a final expression statement|repr/go drops the \.\.\.|two receivers|a parenthesized expression's spelling|the line of an else block's brace)"]}
 {:id :type-names
  :title "byte, rune and aliases named by the types they denote"
  :kind :deferred
  :why "goi's checker identifies byte with uint8, rune with int32 and an alias with its type (types are compared as values, ~700 sites in the checker and the builder); types2 keeps their names for messages. Deferred: GC157"
  :decided "GC49, GC157"
  :match [#"^known errorcheck: (byte|\[\]byte|byte and rune|an alias named)"]}
 {:id :gc-reference
  :title "gc's own errors no longer pass the test"
  :kind :design
  :why "go1.27.1's gc fails the program's own // ERROR comments (its messages changed since the test was written): there is no reference to judge goi against"
  :decided "GR7b"
  :match [#"^skip gc's own errorcheck does not pass here"]}
 {:id :box-console
  :title "the box's console"
  :kind :design
  :why "in the box, TamaGo's console is one stream and the board's line buffer ends an unterminated last line with a newline"
  :decided "GC35, GR7a"
  :match [#"^known the box's console"]}
]

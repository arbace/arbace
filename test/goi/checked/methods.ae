;; Selections (§3.7): fields through embedding, methods with implicit & and *, interface
;; values (implicit conversions), method values and expressions.
(go/package main :path "main")
(go/file "methods.go" :imports [[fmt "fmt"]])

(go/type Point (struct ^int X ^int Y))
(go/type Named (struct Point ^string Name))
(go/type Stringer (interface (String ^string [])))

(go/method Move [^{:tag (* Point)} p ^int dx]
  (set! (.-X p) + dx))

(go/method String ^string [^Point p]
  (fmt/Sprintf "(%d,%d)" (.-X p) (.-Y p)))

(go/func main []
  (let [n (lit Named :Name "n")
        ^Stringer s (.-Point n)
        f (.-String n)
        g (method-expr Point String)]
    (.Move n 3)
    (println ^{:go/via [Point]} (.-X n) (.String s) (f) (g (.-Point n)))))

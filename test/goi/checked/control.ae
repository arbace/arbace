;; Statements (§3.7): constants with iota, maps and comma-ok, range kinds, switch, type switch,
;; closures over captured variables, labels.
(go/package main :path "main")
(go/file "control.go" :imports [])

(go/type Color int)
(go/const
  [^{:tag Color :val 0} Red iota]
  [^{:val 1} Green]
  [^{:val 2} Blue])

(go/var counts (make (map string int)))
(go/var total (sum (lit (slice int) 1 2 3)))

(go/func sum ^int [^{:tag (slice int)} xs]
  (let [t 0]
    (range [_ x xs]
      (set! t + x))
    t))

(go/func describe ^string [^any v]
  (type-switch [x v]
    (case [int]
      (when (> x 0) (return "positive"))
      (return "other"))
    (case [string] (return x))
    (default (return "?"))))

(go/func main []
  (let [(values n ok) (aget counts "a")
        inc (fn [] (set! n + 1))]
    (inc)
    (switch Green
      (case [Red] (println "red"))
      (case [Green Blue] (println "not red")))
    (label :outer
      (range [i 3]
        (range [_ r "ab"]
          (when (== r \b) (continue :outer))
          (println i r))))
    (println n ok total (describe 1))))

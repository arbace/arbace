;; The spec's worked example (doc/go/GOI-SPEC.md, Appendix B): a function of scalars and a loop.
(go/package main :path "main")
(go/file "sumsq.go" :imports [])

(go/func sumSq ^int64 [^int32 n]
  (let [^int64 s (zero int64)]
    (for [i (conv int32 0)] (< i n) (inc! i)
      (set! s + (* (conv int64 i) (conv int64 i))))
    s))

(go/func main []
  (println (sumSq 1000)))

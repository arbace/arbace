(ns go.demo (:require [arbace.go :as go]))
(go/import [strings "strings"] [fmt "fmt"])
(go/func Greet ^string [^string name] (+ "hello, " (strings/ToUpper name)))
(Greet "go")
(go/type Point (struct ^int X ^int Y))
(go/method String ^string [^Point p] (fmt/Sprintf "(%d,%d)" (.-X p) (.-Y p)))
(go/eval (fmt/Println (lit Point 1 2)) (lit Point :X 3))
(go/func Div ^int [^int a ^int b] (/ a b))
(Div 1 0)
(go/func Greet ^string [^string name] (+ "hi, " name))
(Greet "go")

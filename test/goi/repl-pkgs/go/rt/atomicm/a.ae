(in-ns 'go.rt.atomicm)
(go/file "a.go" :imports [[fmt "fmt"] [reflect "reflect"] [atomic "sync/atomic"]])
(go/type Conn (struct ^string name))
(go/method String ^string [^{:tag (* Conn)} c] (+ "conn " (.-name c)))
(go/method Close ^error [^{:tag (* Conn)} c] nil)
(go/type Req (struct ^{:tag (* Conn)} conn ^int n))
(go/type Server (struct ^{:tag (atomic/Pointer Req)} cur))
(go/type Late (struct ^int n))
(go/method String ^string [^{:tag (* Late)} l] (fmt/Sprint "late " (.-n l)))
(go/type Box (struct ^{:tag (* Late)} late))
(go/type LServer (struct ^{:tag (atomic/Pointer Box)} cur))
;; *Conn in a compiled interface before the instance's first call and after it
(go/func Serve ^string []
  (let [c (addr (lit Conn "a"))
        ^{:tag fmt/Stringer} s c
        before (fmt/Sprint s)
        srv (addr (lit Server))]
    (.Store (.-cur srv) (addr (lit Req c 1)))
    (fmt/Sprint before "; " s "; " (.String s) "; " (.NumMethod (reflect/TypeOf s)) "; " (.-n (.Load (.-cur srv))))))
;; *Late first met by the instance's code: its method table
(go/func ServeLate ^string []
  (let [srv (addr (lit LServer))]
    (.Store (.-cur srv) (addr (lit Box (addr (lit Late 2)))))
    (let [^any v (.-late (.Load (.-cur srv)))
          (values s ok) (assert fmt/Stringer v)]
      (when (not ok)
        (return (fmt/Sprint (.NumMethod (reflect/TypeOf v)) "; not a Stringer")))
      (fmt/Sprint (.NumMethod (reflect/TypeOf v)) "; " s))))

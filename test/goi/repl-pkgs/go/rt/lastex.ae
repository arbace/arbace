;; goi's REPL tests (test/goi/repl.ae; review 1111, #2 and #3): a package whose load ends on a file for another
;; configuration (z_windows.go, a _GOOS name), with a file kept out by a // +build line alone (plus.go: go/build
;; applies // +build when a file has no //go:build); both redeclare a.go's Base. A declaration typed at the REPL
;; after the load goes to the last file kept (a.go), not to z_windows.go, which the checker's source leaves out.
(ns go.rt.lastex (:require [arbace.go :as go]))
(go/package lastex :path "rt/lastex" :files ["a.go" "plus.go" "z_windows.go"])
(load "lastex/a")
(load "lastex/plus")
(load "lastex/z_windows")

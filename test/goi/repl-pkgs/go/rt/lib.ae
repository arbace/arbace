;; goi's REPL tests (test/goi/repl.ae): a package of two files, loaded by (require 'go.rt.lib); two more
;; files for other configurations (a //go:build line, a _GOOS name), loaded but left out of the
;; package as go/build leaves them: they redeclare a.go's and b.go's names.
(ns go.rt.lib (:require [arbace.go :as go]))
(go/package lib :path "rt/lib" :files ["a.go" "b.go" "other.go" "x_windows.go"])
(load "lib/a")
(load "lib/other")
(load "lib/x_windows")
(load "lib/b")

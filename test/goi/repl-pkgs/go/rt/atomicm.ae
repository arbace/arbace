;; goi's REPL tests (test/goi/repl.ae): NH11 (b), a package whose types a listed package's generic
;; instance reaches (atomic.Pointer[Req], Req's field a *Conn), loaded by (require 'go.rt.atomicm).
(ns go.rt.atomicm (:require [arbace.go :as go]))
(go/package atomicm :path "rt/atomicm" :files ["a.go"])
(load "atomicm/a")

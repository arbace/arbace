;; goi's checker: annotations that disagree with the checker (doc/go/GOI-SPEC.md §3.6, S16):
;; converted forms (:positions) whose :val, :tag, :go/via, ^:assign and :init-order are wrong.
;; Each ERROR comment is the checker's message at its line (not gc's: these forms are valid Go).
(go/package main :path "main" :init-order [b a] :positions :lines) ; ERROR "annotation :init-order on package main disagrees with goi's checker: forms say [b a], the checker says [a b]"
(go/file "wrong.go" :imports [])

(go/const ^{:val 3} two (+ 1 1)) ; ERROR "annotation :val on two disagrees with goi's checker: forms say 3, the checker says 2"
(go/const ^{:tag float32 :val 0.1} tenth 0.1) ; ERROR "annotation :val on tenth disagrees with goi's checker: forms say 0.1, the checker says 0.10000000149011612"

(go/type P (struct ^int X))
(go/type N (struct P))

(go/var a 1)
(go/var b (+ a 1))

(go/func main []
  (let [n (lit N)
        ^uint s 3
        ^uint8 x ^int8 (<< 1 s)] ; ERROR "annotation :tag on 1 << s disagrees with goi's checker: forms say int8, the checker says uint8"
    (println ^{:go/via [Q]} (.-X n) x) ; ERROR "annotation :go/via on n.X disagrees with goi's checker: forms say [Q], the checker says [P]"
    (let [^:assign y 1] ; ERROR "annotation ^:assign on y disagrees with goi's checker: forms say assigned, the checker says declared"
      (println y))))

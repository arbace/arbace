;; goi's checker: :init-order may not name a variable true, false or nil by the literal (the
;; reader's true, false, nil): the converter writes (go/id "...") (GOI-SPEC GC3).
(go/package names :path "names" :init-order [false] :positions :lines) ; ERROR "annotation :init-order on package names disagrees with goi's checker: forms say [false], the checker says [(go/id \"false\")]"
(go/file "literals.go" :imports [])
(go/var (go/id "false") (== 1 2))

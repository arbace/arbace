;; goi's checker: converted forms naming true, false and nil (go/id "..."), in declarations,
;; :init-order and :go/via (GOI-SPEC GC3, SPEC §4.4): every annotation verified, no error.
(go/package names :path "names" :init-order [(go/id "false") (go/id "true") y] :positions :lines)
(go/file "s4_names.go" :imports [])
(go/type (go/id "nil") (struct ^int x))
(go/type T (struct (go/id "nil")))
(go/var (go/id "true") (== (go/id "false") (go/id "false")))
(go/var (go/id "false") (== 1 2))
(go/var y ^{:go/via [(go/id "nil")]} (.-x (lit T)))
(go/func f ^int [] (let [^T t (zero T)] ^{:go/via [(go/id "nil")]} (.-x t)))

;; bin/cover clojure-classes (doc/GATE-SURVEY.md, GT8.3, GTS205 (a)): the classes of Clojure's suite per test
;; namespace, the unit bin/clojure-tests runs a process for and its coverage is measured by (ARBACE_COVER_DIR/clojure/NS).
;; Arguments: RESULTS UPSTREAM CONTROLS OUT DIVERGENCES... (RESULTS the suite's results, test/arbace-go-results.edn or
;; a run's RUN/results.edn, test/arbace-go-aot-results.edn for --aot; UPSTREAM test/baseline-results.edn; CONTROLS
;; test/clojure/controls.edn; DIVERGENCES the level's class files, the first that classes an entry wins). Each
;; namespace's cases are bin/reap's (test/reap/main.ae's suite-results: a test that fails or errs, a test or
;; namespace skipped, a lost test), each classed by reap's classify. A namespace may hold cases of several classes:
;; its class for the reducer is their set joined by "+" (so one namespace per such set is kept: every class keeps a
;; namespace), - when every case passes. Writes OUT.classes (NS, CLASS), OUT.keep (the namespaces with a case of a
;; class whose :kind is one whose work remains, test/cover/classes.ae's keep-kinds, and the controls' subjects and
;; references) and OUT.cases (NS, RESULT, REASON, CLASS a case a line).
(require '[arbace.string :as str] 'reap.main)

(def keep-kinds #{:deferred :gap :world :interp :analysis :repl :repr-java :j2g :javac :other})

(let [[resf upf ctlf out & divs] *command-line-args*
      rd (fn [f] (read-string (slurp f)))
      res (rd resf) up (rd upf)
      classes (vec (mapcat rd divs))
      suite (#'reap.main/suite-results {} res up)
      classify #'reap.main/classify
      ns-of (fn [^String id] (let [i (.indexOf id "/")] (if (neg? i) id (subs id 0 i))))
      cases (for [e (:entries suite)] (assoc e :ns (ns-of (:id e)) :class (classify classes e)))
      by-ns (group-by :ns cases)
      nss (sort (map str (keys (:namespaces up))))
      ctl (mapcat (fn [c] [(str (:subject c)) (str (:reference c))]) (rd ctlf))
      cname (fn [e] (if-let [c (:class e)] (name (:id c)) (str "unclassed-" (name (:result e)))))]
  (spit (str out ".classes")
        (apply str (for [n nss :let [cs (get by-ns n)]]
                     (str n "\t" (if (seq cs) (str/join "+" (sort (distinct (map cname cs)))) "-") "\n"))))
  (spit (str out ".keep")
        (apply str (for [x (distinct (concat (for [e cases :when (keep-kinds (:kind (:class e)))] (:ns e)) ctl))] (str x "\n"))))
  (spit (str out ".cases")
        (apply str (for [e cases] (str (:ns e) "\t" (name (:result e)) "\t" (:reason e) "\t" (cname e) "\n"))))
  (println "clojure classes:" (count nss) "namespaces," (count cases) "cases," (count (filter :class cases)) "classed,"
           (count (distinct (map cname cases))) "classes," (count (by-ns nil [])) "unattributed;"
           (count (distinct (for [e cases :when (keep-kinds (:kind (:class e)))] (:ns e)))) "namespaces in a kept kind;"
           (count ctl) "control ids"))

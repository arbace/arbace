;; bin/cover classes (doc/GATE-SURVEY.md, GT8.3, GTS205 (a)): each test's class for the subset's reducer.
;; Arguments: DIVERGENCES RESULTS LEVEL CONTROLS OUT (LEVEL and CONTROLS may be empty). RESULTS: rows ID [LEVEL]
;; RESULT REASON, tab-separated; a non-pass takes the first class of DIVERGENCES that names it in :tests or whose
;; :match finds "RESULT REASON" (and whose :level, when it has one, is the row's), as test/goi/divergences.ae and
;; java.check/classify judge. Writes OUT.classes (ID, CLASS: the class's id, - for a pass, unclassed-RESULT for a
;; non-pass in no class) and OUT.keep (the tests of a :deferred or :gap class and the controls' subjects and
;; references: an .edn of maps with :subject and :reference, test/java/controls.edn, or lines LEVEL ID SUBJECT
;; REFERENCE, test/goi/controls.txt).
(let [[div res level controls out] *command-line-args*
      cls (read-string (slurp div))
      lv (when (seq level) (keyword level))
      rows (for [l (arbace.string/split-lines (slurp res)) :let [f (arbace.string/split l #"\t")] :when (>= (count f) 2)]
             (let [[id a b c] f] (if (#{"interp" "compiled" "read" "nread" "classes" "print" "diagnostics"} a) [id a b (or c "")] [id nil a (or b "")])))
      klass (fn [[id l r why]]
              (when-not (= r "pass")
                (let [s (str r " " why)]
                  (first (for [c cls :when (or (nil? (:level c)) (nil? l) (= (name (:level c)) l))
                               :when (or (some #{id} (:tests c)) (some #(re-find % s) (:match c)))] c)))))
      cs (for [r rows :when (or (nil? lv) (nil? (second r)) (= (name lv) (second r)))] [(first r) (klass r) (nth r 2)])
      ctl (when (seq controls)
            (if (.endsWith controls ".edn")
              (mapcat (juxt :subject :reference) (read-string (slurp controls)))
              (for [l (arbace.string/split-lines (slurp controls)) :when (and (seq l) (not (.startsWith l "#")))
                    x (drop 2 (arbace.string/split (arbace.string/trim l) #"\s+"))] x)))]
  (spit (str out ".classes") (apply str (for [[id c r] cs] (str id "\t" (if c (name (:id c)) (if (= r "pass") "-" (str "unclassed-" r))) "\n"))))
  (spit (str out ".keep") (apply str (for [x (distinct (concat (for [[id c] cs :when (#{:deferred :gap} (:kind c))] id) ctl))] (str x "\n"))))
  (println "classes:" (count (filter second cs)) "of" (count cs) "rows classed;" (count (distinct (keep #(some-> % second :id) cs))) "classes;"
           (count (filter #(#{:deferred :gap} (:kind (second %))) cs)) "deferred or gap;" (count ctl) "control ids"))

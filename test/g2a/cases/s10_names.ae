(ns go.names (:require [arbace.go :as go])) (go/package names :path "names" :files ["s10_names.go"] :positions :lines) (go/file "s10_names.go" :imports [])
(go/type Point (struct
    ^{:line 4 :tag int} X ^int Y
    ^{:line 5 :tag int} Z
    ^{:line 6 :tag string} Name))


(go/var (values ^int a ^int b
    ^{:line 10 :tag int} c) ^{:go/breaks [3]} (values 1 2
    3))

^{:go/end 17} (go/func Collect [^{:tag (slice int)} args ^int start ^int numInts ^int numFloats
    ^{:line 14 :tag (slice any)} keep ^{:tag (func [uintptr])} addInt ^{:tag (func [uintptr])} addFloat
    ^{:line 15 :tag (* int)} pInts ^{:tag (* int)} pFloats] :results [(slice int) (slice any)]
  (return (subslice args start) keep))


^{:go/end 23} (go/func Named [^int x
    ^{:line 20 :tag int} y] :results [^int r
    ^{:line 21 :tag int} s]
  (return x y))


^{:go/end 28} (go/func Plain [^int a ^int b

;; The known differences of the round trip of std with its tests (bin/g2c roundtrip --tests,
;; bin/g2c-check --known): entry levels expected to differ, each with the oracle's reason, one
;; per line: [KIND "PATH" [LEVEL ...] "reason"]. The round trips of std and $GOROOT/test for
;; tamago/amd64 and arm64 (without tests) have none.
{:known
 [
  ;; TamaGo's testdata_tamago_test.go files embed the package's own Go sources
  ;; (//go:embed *.go and the like: tamago has no file system at test time). The candidate's
  ;; sources are compiled in the original's place through the overlay, so the embedded data
  ;; is the candidate's text (and, under gocmp's canonical layout, the flattened text of
  ;; either side): a string symbol of the test binary differs, not the program's code.
  [:package "crypto" [:code] "crypto_test embeds the package's files (//go:embed *)"]
  [:package "go/format" [:code] "the tests embed format_test.go"]
  [:package "go/parser" [:code] "the tests embed *.go"]
  [:package "go/printer" [:code] "the tests embed example_test.go and printer.go"]
  [:package "internal/trace" [:code] "the tests embed order.go and internal/tracev1/*"]
  [:package "io/ioutil" [:code] "the tests embed ioutil_test.go"]
  [:package "net/http" [:code] "the tests embed *.go"]
  [:package "os" [:code] "the tests embed *.go and exec/*"]
  [:package "sync" [:code] "the tests embed example_test.go"]
 ]}

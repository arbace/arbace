(ns diffcheck.gen
  "The per-form differential check's sources (doc/FUTAMURA-SURVEY.md, \"F2 as built\";
  bin/diffcheck), written from the oracle's forms (test/oracle/forms, forms/harvest) and j2g's
  fixtures (test/j2g/fixtures, their cases in test/j2g/fixtures.edn) into OUT:

    src/dcf/STEM.ae      a corpus file as a namespace dcf.STEM (dcf.harvest.STEM): one
                         (diffcheck.driver/case ID FILE LINE TEXT) per case, in order; the
                         namespace compiled by the back end (Clojure's pair) when the corpus has
                         no Java forms, and evaluated
    src/dcj/STEM.ae      a corpus with Java forms (defclass.ae, defclass_corpus.ae, j2g's
                         fixtures), the same namespace (its ns form names dcf.STEM) but each case
                         defining classes the program holds compiled replaced by
                         (diffcheck.driver/classes* ID FILE NAMES): evaluated with the classes
                         j2g translated, against src/dcf/STEM.ae evaluated with the same classes
                         interpreted (the Java forms' pair)
    jforms/packages.edn  their Go packages, jf_PKG (j2g's packages.edn, as arbace.aot's)
    jforms/PKG/cN.ae     those classes' Java forms, a tree j2g translates into the program
                         (bin/j2g --input): the case's defclass forms after (in-ns 'PKG) and the
                         imports the namespace made before; j2g's fixtures' files as they are
    corpora.edn          [{:file :src :jsrc :compiled :count :cases [{:id :line :text}]}]
    compiled.txt         the sources of the namespaces the back end compiles, one a line

  A case named in test/diffcheck/excluded.edn (one the back end cannot compile, with the
  reason) becomes (diffcheck.driver/excluded* ID FILE) in both runs. A class defined by more
  than one case (defclass.ae's Again), or named in
  test/diffcheck/jforms-excluded.edn (with the reason), is not compiled: it stays interpreted in
  both runs of the Java forms' pair."
  (:require [arbace.string :as str]
            [arbace.java.io :as io]
            [oracle.runner :as runner]))

;; the corpora with Java forms: their classes compiled by j2g against interpreted. native.ae's
;; code forms in fns, deftypes and reifys are handed over to the Java forms compiler, whose
;; classes the back end does not compile: it is in the Java forms' pair only
(def ^:private java-corpora #{"defclass" "defclass_corpus" "native"})

(defn- stem->ns [^String stem] (str/replace stem "_" "-"))

(defn- class-form? [f]
  (and (seq? f) (symbol? (first f)) (#{"defclass" "defclasses"} (name (first f)))))

(defn- class-forms
  "The defclass forms of a case's form: itself, or a defclasses' elements."
  [f]
  (if (= "defclasses" (name (first f))) (rest f) [f]))

(defn- class-name
  "The binary name of the top-level class a defclass form defines in namespace ns."
  [ns f]
  (let [[_ nm & more] f
        more (if (vector? (first more)) (rest more) more)
        pkg (second (drop-while #(not= :package %) more))
        s (str nm)]
    (cond (some? pkg) (str (when (seq (str pkg)) (str pkg ".")) s)
          (str/includes? s ".") s
          :else (str (munge (name ns)) "." s))))

(defn- ns-switch
  "The namespace a case's form switches to: (ns X ...), (in-ns 'X); else nil."
  [f]
  (when (and (seq? f) (symbol? (first f)))
    (case (name (first f))
      "ns" (second f)
      "in-ns" (let [n (second f)] (if (seq? n) (second n) n))
      nil)))

(defn- imports-of
  "The import forms a case's form makes at the top level: (import ...), an ns form's :import
  clauses."
  [f]
  (when (and (seq? f) (symbol? (first f)))
    (case (name (first f))
      "import" [f]
      "ns" (for [c (drop 2 f) :when (and (seq? c) (= :import (first c)))]
             (list* 'import (map #(list 'quote %) (rest c))))
      nil)))

(defn- emit-str [x] (oracle.driver/emit x))

(defn- write! [^java.io.File f ^String text]
  (.mkdirs (.getParentFile f))
  (spit f text :encoding "UTF-8"))

(defn- header [nsname what]
  (str ";; Written by test/diffcheck/gen.ae (bin/diffcheck) from " what "; regenerated by each run.\n\n"
       "(ns " nsname " (:require diffcheck.driver))\n\n"))

(defn- case-text [id file line text]
  (str "(diffcheck.driver/case " id " " (emit-str file) " " line " " (emit-str text) ")\n"))

(defn- read-excluded []
  (let [f (io/file "test/diffcheck/jforms-excluded.edn")]
    (if (.isFile f)
      (into {} (for [{:keys [class classes reason]} (:excluded (runner/read-expected f))
                     c (if class [class] classes)]
                 [c reason]))
      {})))

(defn- read-excluded-cases
  "The cases the back end cannot compile (test/diffcheck/excluded.edn, with the reasons): case
  id (FILE:LINE) -> reason."
  []
  (let [f (io/file "test/diffcheck/excluded.edn")]
    (if (.isFile f)
      (into {} (for [{:keys [reason cases]} (:excluded (runner/read-expected f)), c cases] [c reason]))
      {})))

(defn- rename-user
  "A case's text with the namespace user named dcf.user ('user, user/): the back end cannot
  compile code analyzed in a namespace of one segment (its holder class, user, is in Java's
  default package, which the Java forms of package arbace cannot name); the corpora's cases run
  in user in the oracle and switch back to it."
  [^String text]
  (-> text
      (str/replace #"'user\b(?![.\-/])" "'dcf.user")
      (str/replace #"(?<![\w.\-*+!?$%&=<>:#])user/" "dcf.user/")))

(defn- oracle-corpus
  "An oracle forms file: its cases, and for a Java forms corpus the def cases (their classes)."
  [^java.io.File f harvest?]
  (let [stem (let [n (.getName f)] (subs n 0 (- (count n) 3)))
        file (str "test/oracle/forms/" (when harvest? "harvest/") (.getName f))
        nsname (str "dcf." (when harvest? "harvest.") (stem->ns stem))
        java? (and (not harvest?) (java-corpora stem))
        cases (vec (map-indexed (fn [i {:keys [line text form]}]
                                  {:id (inc i) :line line :form form
                                   :text (if (and (not harvest?) (java-corpora stem)) text (rename-user text))})
                                (runner/read-source f)))
        ;; the namespace and the imports at each case (Java forms corpora: static, top-level)
        cases (if-not java?
                cases
                (loop [cs cases ns (symbol nsname) imports {} acc []]
                  (if-let [c (first cs)]
                    (let [fm (:form c)
                          ns' (or (ns-switch fm) ns)
                          c (if (class-form? fm)
                              (assoc c :classes (mapv #(class-name ns %) (class-forms fm))
                                       :ns ns :imports (get imports ns []))
                              c)]
                      (recur (rest cs) ns' (update imports ns' (fnil into []) (imports-of fm)) (conj acc c)))
                    acc)))]
    {:file file :stem (str (when harvest? "harvest/") stem) :ns nsname :java java? :compiled (not java?)
     :cases cases}))

(defn- fixtures-corpus
  "j2g's fixtures: one def case per file (loaded, its classes those fixtures.edn names), then
  each recorded case (a static call by the class's binary name)."
  []
  (let [files (sort-by str (filter #(str/ends-with? (str %) ".ae") (.listFiles (io/file "test/j2g/fixtures"))))
        recorded (runner/read-expected (io/file "test/j2g/fixtures.edn"))
        tops (for [f files
                   :let [forms (with-open [r (java.io.PushbackReader. (io/reader f))]
                                 (binding [*read-eval* false]
                                   (doall (take-while #(not= ::eof %) (repeatedly #(read {:eof ::eof :read-cond :allow} r))))))
                         ns (some ns-switch forms)
                         cfs (for [fm forms, g (if (and (seq? fm) (= 'do (first fm))) (rest fm) [fm])
                                   :when (class-form? g)
                                   c (class-forms g)]
                               c)]]
               {:path (str f) :ns ns :classes (mapv #(class-name ns %) cfs)})
        defs (map-indexed (fn [i {:keys [path ns classes]}]
                            {:id (inc i) :line (inc i) :load path :load-ns ns :classes classes :text (str "(load-file " (pr-str path) ")")})
                          tops)
        n (count defs)
        calls (map-indexed (fn [i {:keys [class src]}]
                             (let [simple (subs class (inc (.lastIndexOf ^String class ".")))]
                               {:id (+ n i 1) :line (+ n i 1)
                                :text (str/replace-first src (str "(" simple "/") (str "(" class "/"))}))
                           (for [[_ {:keys [cases]}] recorded, c cases] c))]
    {:file "test/j2g/fixtures" :stem "j2g_fixtures" :ns "dcf.j2g-fixtures" :java true :compiled false
     :fixtures true :cases (vec (concat defs calls))}))

(defn- source-text [{:keys [file ns cases fixtures]} jforms? excluded]
  (str (header ns (str file (when jforms? ", its classes compiled")))
       (apply str
              (for [{:keys [id line text classes load load-ns jcompiled]} cases]
                (cond
                  (excluded (str file ":" line))
                  (str "(diffcheck.driver/excluded* " id " " (emit-str file) ")\n")
                  (and jforms? jcompiled)
                  (str "(diffcheck.driver/classes* " id " " (emit-str file) " " (emit-str classes) " "
                       (cond load ":nil" (str/starts-with? text "(defclasses") ":vector" :else ":last") ")\n")
                  load (str "(diffcheck.driver/load* " id " " (emit-str file) " '" load-ns " " (emit-str load) ")\n")
                  :else (case-text id file line text))))
       "(diffcheck.driver/done " (count cases) ")\n"))

(defn generate
  "Writes OUT (see the namespace's doc); returns the corpora (without their forms)."
  [out]
  (let [out (io/file out)
        oracle (concat (for [f (sort-by str (.listFiles (io/file "test/oracle/forms")))
                             :when (str/ends-with? (str f) ".ae")]
                         (oracle-corpus f false))
                       (for [f (sort-by str (.listFiles (io/file "test/oracle/forms/harvest")))
                             :when (str/ends-with? (str f) ".ae")]
                         (oracle-corpus f true)))
        corpora (concat oracle [(fixtures-corpus)])
        excluded (read-excluded)
        excluded-cases (read-excluded-cases)
        ;; a class defined by more than one case, or excluded: interpreted in both runs
        counts (frequencies (for [c corpora, k (:cases c), n (:classes k)] n))
        compiled? (fn [names] (and (seq names) (every? #(and (= 1 (counts %)) (not (excluded %))) names)))
        corpora (for [c corpora]
                  (update c :cases (fn [cs] (mapv #(if (compiled? (:classes %)) (assoc % :jcompiled true) %) cs))))]
    (doseq [f (reverse (file-seq out))] (io/delete-file f true))
    (doseq [{:keys [stem java fixtures cases] :as c} corpora]
      (write! (io/file out "src" "dcf" (str stem ".ae")) (source-text c false excluded-cases))
      (when java
        (write! (io/file out "src" "dcj" (str stem ".ae")) (source-text c true excluded-cases))
        (doseq [{:keys [id ns imports text load jcompiled]} cases :when jcompiled]
          (if load
            (write! (io/file out "jforms" "j2g_fixtures" (.getName (io/file load))) (slurp load :encoding "UTF-8"))
            (write! (io/file out "jforms" (str/replace (munge (name ns)) "." "/") (str stem "_c" id ".ae"))
                    (binding [*print-meta* true *print-length* nil *print-level* nil]
                      (str ";; Written by test/diffcheck/gen.ae from " (:file c) ", case " id ".\n\n"
                           (pr-str (list 'in-ns (list 'quote ns))) "\n"
                           (apply str (for [i imports] (str (pr-str i) "\n")))
                           ;; j2g reads defclass forms, at the top or in a do
                           "\n" (str/replace-first text #"^\(defclasses\b" "(do") "\n")))))))
    ;; each Java package's classes in a Go package of their own (j2g puts the classes of no
    ;; compiled namespace in lang, where two simple names of two packages collide)
    (spit (io/file out "jforms" "packages.edn")
          (pr-str (into (sorted-map)
                        (for [c corpora, k (:cases c) :when (:jcompiled k), n (:classes k)
                              :let [i (.lastIndexOf ^String n ".")]]
                          [(str/replace n "." "/") (str "jf_" (str/replace (str/replace (subs n 0 (max 0 i)) "." "_") "-" "_"))]))))
    (let [index (vec (for [{:keys [file stem java compiled cases]} corpora]
                       {:file file :src (str "dcf/" stem) :jsrc (when java (str "dcj/" stem)) :compiled compiled
                        :count (count cases)
                        :jcompiled (count (filter :jcompiled cases))
                        :cases (mapv #(select-keys % [:id :line :text]) cases)}))]
      (spit (io/file out "corpora.edn") (pr-str index) :encoding "UTF-8")
      ;; the namespaces the back end compiles, one source path a line
      (spit (io/file out "compiled.txt") (apply str (for [c index :when (:compiled c)] (str (:src c) "\n"))))
      index)))

(defn -main [out]
  (let [cs (generate out)]
    (println "diffcheck gen:" (count cs) "corpora," (reduce + (map :count cs)) "cases;"
             (count (filter :compiled cs)) "compiled by the back end,"
             (reduce + (map :jcompiled cs)) "Java forms cases compiled by j2g")))

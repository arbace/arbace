;; A Java program from sources by modules (bin/arbace-go --build-program, doc/go/BUILD.md, "Java sources by
;; module"; bin/java-project): two modules of sources (a package split over them), a library read from its
;; Maven sources jar at the release's multi-release layer and cut to what its roots reach (A2, A3), and a
;; binary-only annotations jar on the class path alone (A11). The jars are test/java/project/make-jars'.
{:main-class demo.app.Main
 :java {:release 25
        :repository "maven"
        :modules [{:name "util" :src ["util/src"] :resources ["util/res"]}
                  {:name "toylib" :artifact "org.example:toylib:1.0" :resources :jar
                   :artifacts ["org.example:toyapi:1.0"]
                   :closure {:roots ["org.example.toylib.Greeter"] :optional ["org.example.toylib.ext.*"]}}
                  {:name "app" :src ["app/src"] :deps ["util" "toylib"] :artifacts ["org.example:toyapi:1.0"]}]}}

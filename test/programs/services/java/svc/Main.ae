(in-ns 'svc)

(import '(java.util Iterator ServiceConfigurationError ServiceLoader ServiceLoader$Provider))

;; Prints each provider the loader finds (its own verdict: the two jars' providers in the class path's
;; order, the duplicate once, the missing one's ServiceConfigurationError in its place), the stream's
;; types, findFirst, and that a Greeter no services file names is not in the program.
(defclass ^:public Main
  (method ^:public ^:static main ^void [^String/1 args]
    (let [^{:tag (ServiceLoader Greeter)} sl (ServiceLoader/load Greeter)
          ^{:tag (Iterator Greeter)} it (.iterator sl)
          ^:mutable ^boolean more true]
      (while more
        (try
          (if (.hasNext it)
            (let [^Greeter g (.next it)]
              (.println System/out (java-str "greet " (.getName (.getClass g)) ": " (.greet g))))
            (set! more false))
          (catch ServiceConfigurationError e
            (.println System/out (java-str "error " (.getMessage e))))))
      (let [^{:tag (Iterator (ServiceLoader$Provider Greeter))} ps (.iterator (.stream sl))
            ^StringBuilder sb (StringBuilder. "stream")
            ^:mutable ^boolean go true]
        (while go
          (try
            (if (.hasNext ps)
              (.append sb (java-str " " (.getName (.type (cast ServiceLoader$Provider (.next ps))))))
              (set! go false))
            (catch ServiceConfigurationError e
              (.append sb " (error)")
              (set! go false))))
        (.println System/out (.toString sb)))
      (.println System/out (java-str "first " (.greet (cast Greeter (.get (.findFirst (ServiceLoader/load Greeter)))))))
      (.println System/out (java-str "installed " (.isPresent (.findFirst (ServiceLoader/loadInstalled Greeter)))))
      (try
        ;; a name not constant: no reflective site roots it (A6)
        (Class/forName (.toString (.append (StringBuilder. "svc.") "Unlisted")))
        (.println System/out "unlisted present")
        (catch ClassNotFoundException e
          (.println System/out "unlisted absent"))))))

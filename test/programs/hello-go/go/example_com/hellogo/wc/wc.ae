(in-ns 'go.example_com.hellogo.wc)

(go/file "wc.go"
  :doc "Package wc counts a text's lines and words.\n"
  :imports [[bufio "bufio"] [fmt "fmt"] [io "io"] [strings "strings"]])

(go/type Counts
  "Counts are a text's lines and words.\n"
  (struct ^int Lines ^int Words))

(go/method String ^string [^Counts c]
  (fmt/Sprintf "lines %d words %d" (.-Lines c) (.-Words c)))

(go/func Count
  "Count counts r's lines and words.\n"
  [^io/Reader r] :results [Counts error]
  (let [^Counts c (zero Counts)
        sc (bufio/NewScanner r)]
    (while (.Scan sc)
      (inc! (.-Lines c))
      (set! (.-Words c) + (len (strings/Fields (.Text sc)))))
    (return c (.Err sc))))

(in-ns 'go.example_com.hellogo)

(go/file "main.go"
  :doc "Hellogo greets its arguments, counts standard input's lines and words and exits with the number of arguments.\n"
  :imports [[fmt "fmt"] [os "os"] [wc "example.com/hellogo/wc"]])

(go/func main []
  (let [names (subslice os/Args 1)]
    (if (== (len names) 0)
      (fmt/Println "Hello, world!")
      (range [_ n names]
        (fmt/Printf "Hello, %s!\n" n)))
    (let [(values c err) (wc/Count os/Stdin)]
      (when (!= err nil)
        (fmt/Fprintln os/Stderr err)
        (os/Exit 1))
      (fmt/Println c))
    (os/Exit (len names))))

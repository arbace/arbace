(in-ns 'rm)

(import '(java.io BufferedReader InputStreamReader))

;; Makes each class rm/plugins.txt names by reflection and calls its run() (its own verdict: the classes
;; the metadata lists run, the one it does not is absent), then the constant site's class and method, then
;; Class.forName(name, false, loader) and the class's initialization on its first active use (A18).
(defclass ^:public Main
  (field ^:public ^:static ^boolean lazyInit)

  (method ^:public ^:static main ^void [^String/1 args]
    (let [^BufferedReader r (BufferedReader. (InputStreamReader. (ClassLoader/getSystemResourceAsStream "rm/plugins.txt")))
          ^:mutable ^String line (.readLine r)]
      (while (some? line)
        (try
          (let [^Class c (Class/forName line)
                ^Object o (.newInstance (.getConstructor c (new Class/1 0)) (new Object/1 0))]
            (.println System/out (java-str line ": " (.invoke (.getMethod c "run" (new Class/1 0)) o (new Object/1 0)))))
          (catch ClassNotFoundException e
            (.println System/out (java-str line ": absent"))))
        (set! line (.readLine r))))
    (.println System/out (java-str "constant: " (.getName (Class/forName "rm.Constant")) " "
                                   (.invoke (.getMethod Constant "hello" (new Class/1 0)) nil (new Object/1 0))))
    ;; A18: forName without initialization, then the first active use (Lazy's literal's getConstructor roots it)
    (let [^Class l (Class/forName "rm.Lazy" false (ClassLoader/getSystemClassLoader))]
      (.println System/out (java-str "lazy: " (.getName l) " found, initialized " lazyInit))
      (.newInstance (.getConstructor Lazy (new Class/1 0)) (new Object/1 0))
      (.println System/out (java-str "lazy: constructed, initialized " lazyInit ", the same class " (identical? l Lazy))))))

(in-ns 'rm)

;; A18 (the Ghidra case study's G2 plan; ghidra.util.classfinder.ClassSearcherTest): Class.forName("rm.Lazy", false,
;; loader) finds the class without running this initializer, which runs on the first active use, the constructor.
(defclass ^:public Lazy
  (static-initializer (set! Main/lazyInit true))
  (constructor ^:public [this]))

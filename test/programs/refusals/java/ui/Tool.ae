(in-ns 'ui)

;; Refused by j2g: paint's body makes a java.awt.Robot, a class neither the world nor the edge has.
(defclass ^:public Tool
  (method ^:public ^:static version ^String [] "tool 1")
  (method ^:public ^:static paint ^int []
    (let [^java.awt.Robot r (java.awt.Robot.)]
      (.getAutoDelay r))))

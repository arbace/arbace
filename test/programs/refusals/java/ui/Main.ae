(in-ns 'ui)

;; Its own verdict: the clean class runs; the refused class it reaches throws, naming the refusal.
(defclass ^:public Main
  (method ^:public ^:static main ^void [^String/1 args]
    (.println System/out (java-str "clean: " (Clean/name)))
    (try
      (.println System/out (java-str "tool: " (Tool/version)))
      (catch UnsupportedOperationException e
        (.println System/out (java-str "tool stubbed: " (.contains (.getMessage e) "class ui.Tool was refused by j2g")))))))

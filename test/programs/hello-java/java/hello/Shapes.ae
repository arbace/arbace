(in-ns 'hello)

(defclass ^:public Shapes
  (defclass ^:public ^:interface Shape
    (method ^:public ^:abstract area ^double [this])
    (method ^:public ^:abstract name ^String [this]))

  (defclass ^:public ^:static Circle
    :implements [Shape]
    (field ^:final ^double r)
    (constructor ^:public [this ^double r] (set! (.-r this) r))
    (method ^:public area ^double [this] (unchecked-multiply 3.0 (unchecked-multiply r r)))
    (method ^:public name ^String [this] "circle"))

  (defclass ^:public ^:static Square
    :implements [Shape]
    (field ^:final ^double s)
    (constructor ^:public [this ^double s] (set! (.-s this) s))
    (method ^:public area ^double [this] (unchecked-multiply s s))
    (method ^:public name ^String [this] "square"))

  (method ^:public ^:static describe ^String [^Shape/1 shapes]
    (let [^StringBuilder sb (StringBuilder.)
          ^:mutable ^double total 0.0]
      (for-each [^Shape s shapes]
        (.append sb (java-str (.name s) " " (.area s) "; "))
        (set! total (unchecked-add total (.area s))))
      (.toString (.append sb (java-str "total " total))))))

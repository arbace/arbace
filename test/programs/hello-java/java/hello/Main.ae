(in-ns 'hello)

(import '(java.io BufferedReader InputStreamReader)
        '(java.util ArrayList List TreeMap))

(defclass ^:public Main
  (method ^:public ^:static main ^void [^String/1 args]
    (let [^{:tag (List String)} names (ArrayList.)]
      (for-each [^String a args] (.add names a))
      (when (.isEmpty names) (.add names "world"))
      (for-each [^String n names]
        (.println System/out (java-str "Hello, " n "!")))
      (let [^BufferedReader in (BufferedReader. (InputStreamReader. System/in))
            ^{:tag (TreeMap String Integer)} counts (TreeMap.)
            ^:mutable ^int lines 0
            ^:mutable ^String line (.readLine in)]
        (while (some? line)
          (set! lines (unchecked-inc-int lines))
          (for-each [^String w (.split (.trim line) "\\s+")]
            (when-not (.isEmpty w)
              (let [^Integer c (.get counts w)]
                (.put counts w (Integer/valueOf (if (some? c) (unchecked-inc-int (.intValue c)) 1))))))
          (set! line (.readLine in)))
        (.println System/out (java-str "lines " lines " words " counts)))
      (.println System/out (Shapes/describe (new Shapes$Shape/1 [(Shapes$Circle. 1.0) (Shapes$Square. 2.0)])))
      (System/exit (.size names)))))

(in-ns 'props)

;; Prints the properties as the class initializer saw them and as they are now (its own verdict: the
;; values of program.edn's :properties), an absent one's default, and the command line's arguments.
(defclass ^:public Main
  (method ^:public ^:static main ^void [^String/1 args]
    (.println System/out (java-str "clinit headless " Config/HEADLESS))
    (.println System/out (java-str "clinit mode [" Config/MODE "]"))
    (.println System/out (java-str "now headless " (System/getProperty "java.awt.headless")))
    (.println System/out (java-str "empty [" (System/getProperty "sample.empty" "unset") "]"))
    (.println System/out (java-str "absent " (System/getProperty "sample.absent" "unset")))
    (.println System/out (java-str "args " (alength args)))))

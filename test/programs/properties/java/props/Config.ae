(in-ns 'props)

;; Reads the properties in its class initializer, as a library's static configuration does: the program's
;; properties must be set before it runs.
(defclass ^:public Config
  (field ^:public ^:static ^:final ^String HEADLESS (System/getProperty "java.awt.headless" "unset"))
  (field ^:public ^:static ^:final ^String MODE (System/getProperty "sample.mode" "unset")))

(in-ns 'res)

(import '(java.io BufferedReader InputStream InputStreamReader)
        '(java.net URL)
        '(java.util Enumeration))

;; Prints what the class path's resources answer (its own verdict): every jar's copy of a resource in
;; order, the first by getResource, a resource only the second jar has, a class file's URL without bytes,
;; and nothing for absent names.
(defclass ^:public Main
  (method ^:public ^:static text ^String [^InputStream in]
    (let [^BufferedReader r (BufferedReader. (InputStreamReader. in))]
      (.readLine r)))

  (method ^:public ^:static main ^void [^String/1 args]
    (let [^ClassLoader cl (.getClassLoader Main)
          ^{:tag (Enumeration URL)} urls (.getResources cl "data/greeting.txt")
          ^:mutable ^int n 0]
      (while (.hasMoreElements urls)
        (let [^URL u (.nextElement urls)]
          (set! n (unchecked-inc-int n))
          (.println System/out (java-str "resources " n " " (.getProtocol u) ": " (Main/text (.openStream u))))))
      (.println System/out (java-str "resource: " (Main/text (.openStream (.getResource cl "data/greeting.txt")))))
      (.println System/out (java-str "stream: " (Main/text (.getResourceAsStream cl "data/greeting.txt"))))
      (.println System/out (java-str "system: " (Main/text (ClassLoader/getSystemResourceAsStream "data/only-b.txt"))))
      (.println System/out (java-str "system url: " (some? (ClassLoader/getSystemResource "data/only-b.txt"))))
      (let [^URL c (.getResource Main "Main.class")]
        (.println System/out (java-str "class url: " (.getProtocol c) " " (.endsWith (.toString c) "!/res/Main.class")))
        (.println System/out (java-str "class bytes: " (nil? (.getResourceAsStream cl "res/Main.class")))))
      (.println System/out (java-str "absent: " (nil? (.getResource cl "data/absent.txt")) " "
                                     (.hasMoreElements (.getResources cl "res/Nope.class")))))))

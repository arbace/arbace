(ns mixed.main
  "A program of Clojure, Java forms and Go forms: greets its arguments through the Go package
  mixed/caps, counts standard input's words with the Java class mixed.text.Words, and hands that
  class a Clojure fn. It requires the Java package's namespace too (at the REPL its classes'
  loader; in the program a no-op, RPS93), and says whether mixed/caps runs compiled (listed in
  the program's goi table, goi's interpreter never loaded) or interpreted by goi."
  (:require [arbace.go :as go]
            [go.mixed.caps :as caps]
            [mixed.text])
  (:import (mixed.text Words)))

(defn -main [& args]
  (doseq [a (or (seq args) ["world"])]
    (println (caps/Shout (str "hello, " a))))
  (println (caps/Banner 3))
  (let [text (slurp *in*)]
    (println "words" (Words/count text) "longest" (pr-str (Words/longest text))))
  (println "twice" (Words/twice (fn [x] (* 10 x)) 4))
  (println "mixed/caps"
           (if (and (some #{"mixed/caps"} (go/packages)) (nil? (find-ns 'arbace.go.repl)))
             "compiled"
             "interpreted"))
  (System/exit (count args)))

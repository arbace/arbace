(in-ns 'go.mixed.caps)

(go/file "caps.go"
  :doc "Package caps shouts.\n"
  :imports [[strings "strings"]])

(go/func Shout
  "Shout is s in upper case with an exclamation mark.\n"
  ^string [^string s]
  (+ (strings/ToUpper s) "!"))

(go/func Banner
  "Banner is n stars between brackets.\n"
  ^string [^int n]
  (+ "[" (strings/Repeat "*" n) "]"))

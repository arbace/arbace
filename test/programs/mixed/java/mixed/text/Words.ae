(in-ns 'mixed.text)

(import '(arbace.lang IFn))

(defclass ^:public Words
  (method ^:public ^:static count ^int [^String text]
    (let [^String t (.trim text)]
      (if (.isEmpty t) 0 (alength (.split t "\\s+")))))

  (method ^:public ^:static longest ^String [^String text]
    (let [^:mutable ^String best ""]
      (for-each [^String w (.split (.trim text) "\\s+")]
        (when (> (.length w) (.length best)) (set! best w)))
      best))

  ;; a Clojure fn called from Java forms
  (method ^:public ^:static twice ^Object [^IFn f ^Object x]
    (.invoke f (.invoke f x))))

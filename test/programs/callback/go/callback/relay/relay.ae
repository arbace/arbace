(in-ns 'go.callback.relay)

(go/file "relay.go"
  :doc "Package relay calls back Arbace fns.\n"
  :imports [[arbace "arbace"]])

(go/func Apply
  "Apply is f (an Arbace fn) called with n, as an int.\n"
  ^int [^any f ^int n]
  (conv int (arbace/Long (arbace/Call f n))))

(go/func Named
  "Named is the var name (ns/name) called with s, as a string.\n"
  ^string [^string name ^string s]
  (arbace/GoStr (arbace/Call (arbace/Var name) s)))

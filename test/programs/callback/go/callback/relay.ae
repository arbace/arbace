;; The Go package callback/relay of the program (doc/go/SPEC.md §4.1): a namespace of Go forms that
;; callback.main requires; it imports the package arbace (doc/go/GOI-SPEC.md §7.3).
(ns go.callback.relay
  (:require [arbace.go :as go]))

(go/package relay
  :path "callback/relay"
  :files ["relay.go"])

(load "relay/relay")

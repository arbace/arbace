(ns callback.main
  "A program whose Go package calls back Clojure: callback/relay imports the package arbace and
  calls an anonymous fn and the var callback.main/shout through arbace.Call and arbace.Var."
  (:require [arbace.go :as go]
            [go.callback.relay :as relay]))

(defn shout [s] (str (.toUpperCase ^String s) "!"))

(defn -main [& args]
  (println "apply" (relay/Apply (fn [x] (* 7 x)) 6))
  (doseq [a (or (seq args) ["world"])]
    (println (relay/Named "callback.main/shout" (str "hello, " a))))
  (println "callback/relay"
           (if (and (some #{"callback/relay"} (go/packages)) (nil? (find-ns 'arbace.go.repl)))
             "compiled"
             "interpreted"))
  (System/exit (count args)))

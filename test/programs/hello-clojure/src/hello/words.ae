(ns hello.words
  "Words of a text, a second namespace of the program (required by hello.core).")

(defn stats
  "{:lines n :words n :top [[word count] ...]}: the three most frequent words, ties by word."
  [^String text]
  (let [ws (re-seq #"\w+" (.toLowerCase text))
        freq (frequencies ws)]
    {:lines (count (filter #(= \newline %) text))
     :words (count ws)
     :top (take 3 (sort-by (fn [[w n]] [(- n) w]) freq))}))

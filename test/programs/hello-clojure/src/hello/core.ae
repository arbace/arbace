(ns hello.core
  "A user's program of one namespace (bin/arbace-go --build-program): greets its arguments,
  counts standard input's lines and words, exits with the number of arguments."
  (:require [arbace.string :as str]
            [hello.words :as words]))

(defrecord Greeting [who])

(defprotocol Says (say [g]))

(extend-protocol Says
  Greeting (say [g] (str "Hello, " (:who g) "!")))

(defn -main [& args]
  (doseq [a (or (seq args) ["world"])]
    (println (say (->Greeting a))))
  (let [text (slurp *in*)
        {:keys [lines words top]} (words/stats text)]
    (println "lines" lines "words" words)
    (when (seq top) (println "top" (str/join " " (map (fn [[w n]] (str w "=" n)) top)))))
  (println "squares" (transduce (comp (filter odd?) (map #(* % %))) + (range 10)))
  (shutdown-agents)
  (System/exit (count args)))

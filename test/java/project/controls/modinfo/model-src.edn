;; the control of model.edn: the same library as a module of sources whose tree holds the module-info.java (it is not
;; unpacked from a jar, so not dropped): javac goes single-module and the dependent's read fails with "does not read"
{:java {:release 25
        :modules [{:name "modlib" :src ["$controls/modinfo/lib"]}
                  {:name "modapp" :src ["$controls/modinfo/app"] :deps ["modlib"]}]}}

;; bin/java-project test's :patches case: toylib's sources with a variant (patches/greeter-hello.patch, a unified diff
;; over the unpacked sources jar) read with the change applied and listed; and the control: a patch whose context is
;; not in the sources (patches/greeter-absent.patch) fails the sources step
{:java {:release 25 :repository "maven"
        :modules [{:name "toylib" :artifact "org.example:toylib:1.0" :artifacts ["org.example:toyapi:1.0"]
                   :patches ["$controls/patches/greeter-hello.patch"]
                   :closure {:roots ["org.example.toylib.Greeter"]}}]}}

;; bin/java-project test's case: two modules each holding META-INF/NOTICE, the two differing (as Maven artifacts' LICENSE, NOTICE
;; and DEPENDENCIES do): resources.all keeps the first module's, as a class path's getResource answers, and lists the later one in
;; WORK/resources.shadowed; resources.jars keeps each module's own
{:java {:release 25
        :modules [{:name "a" :src ["$controls/dup/a/src"] :resources ["$controls/dup/a/res"]}
                  {:name "b" :src ["$controls/dup/b/src"] :resources ["$controls/dup/b/res"]}]}}

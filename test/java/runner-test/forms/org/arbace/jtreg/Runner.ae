  (method ngRun ^boolean [this ^Method m inst ^Annotation t ^Object/1 row
                          ^{:tag (List Method)} before ^{:tag (List Method)} after]
    (set! run (unchecked-inc-int run))
    (let [what (Runner/describe m row)
          result (Runner/impl "org.testng.ITestResult"
                              (new Class/1 [String Object/1 Object])
                              (.getName m)
                              row
                              inst)]
      (if (not (.ngConfig this before inst m row result))
          (do (set! skipped (unchecked-inc-int skipped)) (.report this what "skipped" nil) false)
          (let [^:mutable ^Throwable thrown nil]
            (try
              (Runner/invoke m inst (.ngArgs this m row result))
              (catch Throwable e (set! thrown e)))
            (let [ex (cast Object/1 (Runner/attr t "expectedExceptions"))
                  ^:mutable failure thrown]
              (when (and (some? ex) (> (alength ex) 0))
                (set! failure nil)
                (if (nil? thrown)
                    (set! failure
                          (AssertionError.
                            (java-str "expected one of "
                                      (Arrays/toString ex)
                                      " but nothing was thrown")))
                    (let [^:mutable match false]
                      (for-each [k ex] (when (.isInstance (cast Class k) thrown) (set! match true)))
                      (let [re (Runner/str t "expectedExceptionsMessageRegExp")]
                        (when (and (and match (not (.isEmpty re))) (not (.equals re ".*")))
                          (let [^String msg (if (nil? (.getMessage thrown)) "" (.getMessage thrown))]
                            (set! match
                                  (.matches (.matcher (Pattern/compile re Pattern/DOTALL) msg)))))
                        (when-not match (set! failure thrown))))))
              (let [^:mutable ^boolean pass false]
                (cond
                  (and (some? failure) (Runner/isNamed failure "org.testng.SkipException"))
                    (do
                      (set! skipped (unchecked-inc-int skipped))
                      (set! pass false)
                      (.report this what "skipped" failure))
                  (some? failure)
                    (do
                      (set! failed (unchecked-inc-int failed))
                      (set! pass false)
                      (.report this what "failure" failure))
                  :else
                    (do
                      (set! passed (unchecked-inc-int passed))
                      (set! pass true)
                      (.report this what "success" nil)))
                (Runner/setStatus result
                                  (cond
                                    pass 1
                                    (and (some? failure)
                                         (Runner/isNamed failure "org.testng.SkipException"))
                                      3
                                    :else 2)
                                  failure)
                (.ngConfig this after inst m row result)
                pass))))))

  (method ngArgs ^Object/1 [this ^Method m ^Object/1 row result]
    (let [^{:tag (array (Class ?))} ts (.getParameterTypes m)
          out (new Object/1 (alength ts))
          ^:mutable ^int j 0]
      (loop [^int i 0]
        (when (< i (alength ts))
          (let [n (.getName (aget ts i))]
            (cond
              (identical? (aget ts i) Method) (do (aset out i m) (recur (unchecked-inc-int i)))
              (.equals n "org.testng.ITestContext")
                (do (aset out i (.ngContext this)) (recur (unchecked-inc-int i)))
              (.equals n "org.testng.ITestResult")
                (do (aset out i result) (recur (unchecked-inc-int i)))
              (< j (alength row))
                (do
                  (aset out i (aget row j))
                  (set! j (unchecked-inc-int j))
                  (recur (unchecked-inc-int i)))
              :else
                (throw (IllegalArgumentException.
                         (java-str "the data provider gave " (alength row) " values for " m)))))))
      (when (< j (alength row))
        (throw (IllegalArgumentException.
                 (java-str "the data provider gave " (alength row) " values for " m))))
      out))

  (method ^:static setStatus ^void [result ^int status ^Throwable t]
    (when (some? result)
      (try
        (let [s (.getDeclaredMethod (.getClass result) "setStatus" Integer/TYPE Throwable)]
          (.setAccessible s true)
          (.invoke s result status t))
        (catch Exception e (throw (RuntimeException. e))))))

  (field ^:static ^:final ^String JU "org.junit.jupiter.api.")

  (field ^:static ^:final ^String JP "org.junit.jupiter.params.")

  (method ^:static isJuTest ^boolean [^Method m]
    (or (or (or (or (some? (Runner/ann m (java-str JU "Test")))
                    (some? (Runner/ann m (java-str JP "ParameterizedTest"))))
                (some? (Runner/ann m (java-str JU "RepeatedTest"))))
            (some? (Runner/ann m (java-str JU "TestFactory"))))
        (some? (Runner/ann m (java-str JU "TestTemplate")))))

  (method juTests ^{:tag (List Method)} [this ^{:tag (Class ?)} c]
    (let [^{:tag (Map String Method)} found (LinkedHashMap.)]
      (for-each [^{:tag (Class ?)} k (Runner/hierarchy c)]
        (for-each [^Method m (.getDeclaredMethods k)]
          (when-not (or (or (.isSynthetic m) (.isBridge m)) (.containsKey found (Runner/sig m)))
            (if (and (and (Runner/isJuTest m) (not (Modifier/isPrivate (.getModifiers m))))
                     (not (Modifier/isStatic (.getModifiers m))))
                (.put found (Runner/sig m) m)
                (when-not (Modifier/isPrivate (.getModifiers m)) (.put found (Runner/sig m) nil))))))
      (let [^{:tag (List Method)} l (ArrayList.)]
        (for-each [^Method m (.values found)] (when (some? m) (.add l m)))
        (.sort l
               (.thenComparing
                 (Comparator/comparingInt
                   (lambda ToIntFunction ^int [^Method m] (.hashCode (.getName m))))
                 (method-ref Function ^String [Method] Runner/sig)))
        (let [^:mutable ^Annotation ord nil]
          (for-each [^{:tag (Class ?)} k (Runner/hierarchy c)]
            (when (some? (set! ord (Runner/ann k (java-str JU "TestMethodOrder")))) (break)))
          (when (some? ord)
            (let [o (.getName (cast Class (Runner/attr ord "value")))]
              (cond
                (.endsWith o "$MethodName")
                  (.sort l
                         (.thenComparing
                           (Comparator/comparing
                             (method-ref Function ^String [Method] Method/.getName))
                           (method-ref Function ^String [Method] Runner/sig)))
                (.endsWith o "$OrderAnnotation")
                  (.sort l
                         (Comparator/comparingInt
                           (lambda ToIntFunction ^int [^Method m]
                             (let [a (Runner/ann m (java-str JU "Order"))]
                               (if (nil? a) 1073741823 (Runner/integer a "value" 1073741823))))))
                (.endsWith o "$DisplayName")
                  (.sort l
                         (Comparator/comparing
                           (lambda Function ^String [^Method m]
                             (let [a (Runner/ann m (java-str JU "DisplayName"))]
                               (if (nil? a) (java-str (.getName m) "()") (Runner/str a "value")))))))))
          l))))

  (method juParam [this ^{:tag (Class ?)} t ^Method test ^{:tag (Class ?)} c ^String display]
    (if (.equals (.getName t) (java-str JU "TestInfo"))
        (Runner/impl (java-str JU "TestInfo") (new Class/1 [String Class Method]) display c test)
        (throw (IllegalArgumentException.
                 (java-str "no parameter resolver for "
                           (.getName t)
                           " (JUnit's extensions are not in the check's runner)")))))

  (method juLifecycle ^boolean [this ^{:tag (List Method)} ms inst ^Method test ^{:tag (Class ?)} c
                                ^String display ^boolean container]
    (for-each [^Method m ms]
      (try
        (let [^{:tag (array (Class ?))} ts (.getParameterTypes m)
              args (new Object/1 (alength ts))]
          (loop [^int i 0]
            (when (< i (alength ts))
              (aset args i (.juParam this (aget ts i) test c display))
              (recur (unchecked-inc-int i))))
          (Runner/invoke m inst args))
        (catch Throwable t
          (if (Runner/isNamed t "org.opentest4j.TestAbortedException")
              (.report this (java-str "lifecycle " (.getName m)) "aborted" t)
              (do
                (when container (set! configFailed (unchecked-inc-int configFailed)))
                (.report this (java-str "lifecycle " (.getName m)) "failure" t)))
          (return false))))
    true)

  (method junit :throws [Throwable] ^void [this ^{:tag (Class ?)} c]
    (for-each [^{:tag (Class ?)} k (Runner/hierarchy c)]
      (for-each [^Method m (.getDeclaredMethods k)]
        (when (some? (Runner/ann m (java-str J4 "Test"))) (.junit4 this c) (return))))
    (let [^:mutable ^Annotation ti nil]
      (for-each [^{:tag (Class ?)} k (Runner/hierarchy c)]
        (when (some? (set! ti (Runner/ann k (java-str JU "TestInstance")))) (break)))
      (let [perClass (and (some? ti)
                          (.equals (String/valueOf (Runner/attr ti "value")) "PER_CLASS"))]
        (if (some? (Runner/ann c (java-str JU "Disabled")))
            (do
              (.report this (.getName c) "disabled" nil)
              (set! run (unchecked-inc-int run))
              (set! skipped (unchecked-inc-int skipped)))
            (let [^:mutable ^Object shared nil]
              (when perClass
                (try
                  (set! shared (Runner/newInstance c))
                  (catch Throwable t
                    (set! configFailed (unchecked-inc-int configFailed))
                    (.report this (java-str (.getName c) ".<init>") "failure" t)
                    (return))))
              (let [^{:tag (List Method)} tests (.juTests this c)
                    ^{:tag (List Method)} beforeEach (Runner/annotated
                                                       c
                                                       (java-str JU "BeforeEach")
                                                       true)
                    ^{:tag (List Method)} afterEach (Runner/annotated
                                                      c
                                                      (java-str JU "AfterEach")
                                                      false)
                    ok (.juLifecycle this
                                     (Runner/annotated c (java-str JU "BeforeAll") true)
                                     shared
                                     nil
                                     c
                                     (.getSimpleName c)
                                     true)]
                (for-each [^Method m tests]
                  (if (or (not ok) (some? (Runner/ann m (java-str JU "Disabled"))))
                      (do
                        (set! run (unchecked-inc-int run))
                        (set! skipped (unchecked-inc-int skipped))
                        (.report this
                                 (Runner/describe m nil)
                                 ^String (if ok "disabled" "skipped")
                                 nil))
                      (let [^:mutable ^{:tag (List Object/1)} rows nil]
                        (try
                          (set! rows (.juRows this m c shared))
                          (catch Throwable t
                            (set! run (unchecked-inc-int run))
                            (set! failed (unchecked-inc-int failed))
                            (.report this
                                     (java-str (Runner/describe m nil) " (its arguments)")
                                     "failure"
                                     t)
                            (continue)))
                        (for-each [^Object/1 row rows]
                          (.juRun this m c shared row beforeEach afterEach)))))
                (.juLifecycle this
                              (Runner/annotated c (java-str JU "AfterAll") false)
                              shared
                              nil
                              c
                              (.getSimpleName c)
                              true)))))))

  (method juRun ^void [this ^Method m ^{:tag (Class ?)} c shared ^Object/1 row
                       ^{:tag (List Method)} before ^{:tag (List Method)} after]
    (set! run (unchecked-inc-int run))
    (let [what (Runner/describe m row)
          display (java-str (.getName m) "()")
          ^:mutable inst shared]
      (when (nil? inst)
        (try
          (set! inst (Runner/newInstance c))
          (catch Throwable t
            (set! failed (unchecked-inc-int failed))
            (.report this what "failure" t)
            (return))))
      (let [^:mutable ^Throwable failure nil]
        (when-not (.juLifecycle this before inst m c display false)
          (set! failure (AssertionError. "a @BeforeEach method failed")))
        (when (nil? failure)
          (try
            (let [^{:tag (array (Class ?))} ts (.getParameterTypes m)
                  args (new Object/1 (alength ts))]
              (loop [^int i 0]
                (when (< i (alength ts))
                  (aset args
                        i
                        (if (< i (alength row))
                            (Runner/convert (aget row i) (aget ts i))
                            (.juParam this (aget ts i) m c display)))
                  (recur (unchecked-inc-int i))))
              (Runner/invoke m inst args))
            (catch Throwable t (set! failure t))))
        (when (and (not (.juLifecycle this after inst m c display false)) (nil? failure))
          (set! failure (AssertionError. "an @AfterEach method failed")))
        (cond
          (and (some? failure) (Runner/isNamed failure "org.opentest4j.TestAbortedException"))
            (do (set! skipped (unchecked-inc-int skipped)) (.report this what "aborted" failure))
          (some? failure)
            (do (set! failed (unchecked-inc-int failed)) (.report this what "failure" failure))
          :else (do (set! passed (unchecked-inc-int passed)) (.report this what "success" nil))))))

  (field ^:static ^:final ^String J4 "org.junit.")

  (method junit4 :throws [Throwable] ^void [this ^{:tag (Class ?)} c]
    (if (some? (Runner/ann c (java-str J4 "Ignore")))
        (do
          (set! run (unchecked-inc-int run))
          (set! skipped (unchecked-inc-int skipped))
          (.report this (.getName c) "ignored" nil))
        (let [^{:tag (List Method)} tests (ArrayList.)]
          (for-each [^Method m (.getMethods c)]
            (when (some? (Runner/ann m (java-str J4 "Test"))) (.add tests m)))
          (.sort tests
                 (.thenComparing
                   (Comparator/comparingInt
                     (lambda ToIntFunction ^int [^Method m] (.hashCode (.getName m))))
                   (method-ref Function ^String [Method] Runner/sig)))
          (let [^{:tag (List Method)} before (Runner/annotated c (java-str J4 "Before") true)
                ^{:tag (List Method)} after (Runner/annotated c (java-str J4 "After") false)
                ok (.juLifecycle this
                                 (Runner/annotated c (java-str J4 "BeforeClass") true)
                                 nil
                                 nil
                                 c
                                 (.getSimpleName c)
                                 true)]
            (for-each [^Method m tests]
              (set! run (unchecked-inc-int run))
              (let [what (Runner/describe m nil)]
                (if (or (not ok) (some? (Runner/ann m (java-str J4 "Ignore"))))
                    (do
                      (set! skipped (unchecked-inc-int skipped))
                      (.report this what ^String (if ok "ignored" "skipped") nil))
                    (let [^:mutable ^Throwable failure nil
                          ^:mutable ^Object inst nil]
                      (try (set! inst (Runner/newInstance c)) (catch Throwable t (set! failure t)))
                      (when (and (nil? failure)
                                 (not (.juLifecycle this before inst m c (.getName m) false)))
                        (set! failure (AssertionError. "a @Before method failed")))
                      (when (nil? failure)
                        (let [^{:tag (Class ?)} ex (cast
                                                     Class
                                                     (Runner/attr
                                                       (Runner/ann m (java-str J4 "Test"))
                                                       "expected"))
                              none (or (nil? ex) (.equals (.getName ex) (java-str J4 "Test$None")))]
                          (try
                            (Runner/invoke m inst)
                            (when-not none
                              (set! failure
                                    (AssertionError.
                                      (java-str "Expected exception: " (.getName ex)))))
                            (catch Throwable t
                              (when (or none (not (.isInstance ex t))) (set! failure t))))))
                      (when (and (and (some? inst)
                                      (not (.juLifecycle this after inst m c (.getName m) false)))
                                 (nil? failure))
                        (set! failure (AssertionError. "an @After method failed")))
                      (if (some? failure)
                          (do
                            (set! failed (unchecked-inc-int failed))
                            (.report this what "failure" failure))
                          (do
                            (set! passed (unchecked-inc-int passed))
                            (.report this what "success" nil)))))))
            (.juLifecycle this
                          (Runner/annotated c (java-str J4 "AfterClass") false)
                          nil
                          nil
                          c
                          (.getSimpleName c)
                          true)))))

  (method juRows :throws [Throwable] ^{:tag (List Object/1)} [this ^Method m ^{:tag (Class ?)} c
                                                              shared]
    (let [^{:tag (List Object/1)} rows (ArrayList.)
          rep (Runner/ann m (java-str JU "RepeatedTest"))]
      (if (some? rep)
          (do
            (loop [^int i 0]
              (when (< i (Runner/integer rep "value" 1))
                (.add rows (new Object/1 0))
                (recur (unchecked-inc-int i))))
            rows)
          (do
            (when (or (some? (Runner/ann m (java-str JU "TestFactory")))
                      (some? (Runner/ann m (java-str JU "TestTemplate"))))
              (throw (UnsupportedOperationException.
                       "JUnit's @TestFactory and @TestTemplate (not in the check's runner)")))
            (if (nil? (Runner/ann m (java-str JP "ParameterizedTest")))
                (do (.add rows (new Object/1 0)) rows)
                (let [^:mutable ^Annotation a nil]
                  (when (or (some? (set! a (Runner/ann m (java-str JP "provider.NullSource"))))
                            (some? (Runner/ann m (java-str JP "provider.NullAndEmptySource"))))
                    (.add rows (new Object/1 [nil])))
                  (when (or (some? (set! a (Runner/ann m (java-str JP "provider.EmptySource"))))
                            (some? (Runner/ann m (java-str JP "provider.NullAndEmptySource"))))
                    (.add rows (new Object/1 [(Runner/empty (aget (.getParameterTypes m) 0))])))
                  (when (some? (set! a (Runner/ann m (java-str JP "provider.ValueSource"))))
                    (for-each [^String e (new String/1
                                              ["shorts" "bytes" "ints" "longs" "floats" "doubles"
                                               "chars" "booleans" "strings" "classes"])]
                      (let [v (Runner/attr a e)]
                        (when (some? v)
                          (loop [^int i 0]
                            (when (< i (Array/getLength v))
                              (.add rows (new Object/1 [(Array/get v i)]))
                              (recur (unchecked-inc-int i))))))))
                  (when (some? (set! a (Runner/ann m (java-str JP "provider.CsvSource"))))
                    (let [^:mutable d (String/valueOf
                                        (if (nil? (Runner/attr a "delimiterString"))
                                            ""
                                            (Runner/attr a "delimiterString")))]
                      (when (.isEmpty d)
                        (set! d
                              (String/valueOf
                                (if (nil? (Runner/attr a "delimiter"))
                                    (Character/valueOf \,)
                                    (Runner/attr a "delimiter")))))
                      (when (.equals d "\u0000") (set! d ","))
                      (for-each [^String line (Runner/strs a "value")]
                        (.add rows (Runner/csv line d)))
                      (for-each [^String line (.split (Runner/str a "textBlock") "\n")]
                        (when (and (not (.isBlank line)) (not (.startsWith (.strip line) "#")))
                          (.add rows (Runner/csv line d))))))
                  (when (some? (set! a (Runner/ann m (java-str JP "provider.EnumSource"))))
                    (let [^:mutable ^{:tag (Class ?)} e (cast Class (Runner/attr a "value"))]
                      (when (or (nil? e) (.endsWith (.getName e) "$NullEnum"))
                        (set! e (aget (.getParameterTypes m) 0)))
                      (let [^{:tag (List String)} names (Arrays/asList (Runner/strs a "names"))
                            mode (String/valueOf (Runner/attr a "mode"))]
                        (for-each [k (.getEnumConstants e)]
                          (let [^:mutable in (or
                                               (.isEmpty names)
                                               (.contains names (.name (cast Enum k))))]
                            (when (.equals mode "EXCLUDE")
                              (set! in
                                    (or (.isEmpty names)
                                        (not (.contains names (.name (cast Enum k)))))))
                            (when in (.add rows (new Object/1 [k]))))))))
                  (when (some? (set! a (Runner/ann m (java-str JP "provider.MethodSource"))))
                    (let [^:mutable names (Runner/strs a "value")]
                      (when (== (alength names) 0) (set! names (new String/1 [""])))
                      (for-each [^String n names]
                        (let [^:mutable ^{:tag (Class ?)} k c
                              ^:mutable ^String mn (if (.isEmpty n) (.getName m) n)]
                          (when (.contains mn "#")
                            (set! k (Class/forName (.substring mn 0 (.indexOf mn \#))))
                            (set! mn (.substring mn (unchecked-add-int (.indexOf mn \#) 1))))
                          (when (.endsWith mn "()")
                            (set! mn (.substring mn 0 (unchecked-subtract-int (.length mn) 2))))
                          (let [^:mutable ^Method src nil]
                            (for-each [^{:tag (Class ?)} h (Runner/hierarchy k)]
                              (for-each [^Method x (.getDeclaredMethods h)]
                                (when (and (.equals (.getName x) mn) (== (.getParameterCount x) 0))
                                  (set! src x)
                                  (break)))
                              (when (some? src) (break)))
                            (when (nil? src)
                              (throw (IllegalArgumentException.
                                       (java-str "no factory method " n " for " m))))
                            (let [inst (when-not (Modifier/isStatic (.getModifiers src))
                                         (if (some? shared) shared (Runner/newInstance c)))]
                              (for-each [e (Runner/elements (Runner/invoke src inst))]
                                (.add rows (Runner/arguments e (.getParameterCount m))))))))))
                  (when (some? (set! a (Runner/ann m (java-str JP "provider.FieldSource"))))
                    (let [^:mutable names (Runner/strs a "value")]
                      (when (== (alength names) 0) (set! names (new String/1 [""])))
                      (for-each [^String n names]
                        (let [^:mutable ^{:tag (Class ?)} k c
                              ^:mutable ^String fn (if (.isEmpty n) (.getName m) n)]
                          (when (.contains fn "#")
                            (set! k (Class/forName (.substring fn 0 (.indexOf fn \#))))
                            (set! fn (.substring fn (unchecked-add-int (.indexOf fn \#) 1))))
                          (let [^:mutable ^Field f nil]
                            (for-each [^{:tag (Class ?)} h (Runner/hierarchy k)]
                              (try
                                (set! f (.getDeclaredField h fn))
                                (break)
                                (catch NoSuchFieldException e)))
                            (when (nil? f)
                              (throw (IllegalArgumentException. (java-str "no field " n " for " m))))
                            (.setAccessible f true)
                            (let [^:mutable v (.get
                                                f
                                                (when-not (Modifier/isStatic (.getModifiers f))
                                                  (if (some? shared) shared (Runner/newInstance c))))]
                              (when (instance? Supplier v) (set! v (.get (cast Supplier v))))
                              (for-each [e (Runner/elements v)]
                                (.add rows (Runner/arguments e (.getParameterCount m))))))))))
                  (when (.isEmpty rows)
                    (throw
                      (IllegalArgumentException.
                        (java-str
                          "a @ParameterizedTest with no source of arguments the check's runner knows: "
                          (Arrays/toString (.getDeclaredAnnotations m))))))
                  rows))))))

  (method ^:static empty [^{:tag (Class ?)} t]
    (cond
      (identical? t String) ""
      (.isArray t) (Array/newInstance (.getComponentType t) 0)
      (or (identical? t List) (identical? t Collection)) (ArrayList.)
      (identical? t Set) (HashSet.)
      (identical? t Map) (HashMap.)
      :else (throw (IllegalArgumentException. (java-str "@EmptySource for " t)))))

  (method ^:static elements ^{:tag (List Object)} [v]
    (let [^{:tag (List Object)} out (ArrayList.)]
      (cond
        (instance? BaseStream v)
          (loop [^{:tag (Iterator ?)} i (.iterator (cast BaseStream v))]
            (when (.hasNext i) (.add out (.next i)) (recur i)))
        (instance? Iterable v) (for-each [e (cast Iterable v)] (.add out e))
        (instance? Iterator v)
          (loop [^{:tag (Iterator ?)} i (cast Iterator v)]
            (when (.hasNext i) (.add out (.next i)) (recur i)))
        (and (some? v) (.isArray (.getClass v)))
          (loop [^int i 0]
            (when (< i (Array/getLength v))
              (.add out (Array/get v i))
              (recur (unchecked-inc-int i))))
        :else (throw (IllegalArgumentException. (java-str "a factory method returned " v))))
      out))

  (method ^:static arguments ^Object/1 [e ^int params]
    (when (some? e)
      (loop [^{:tag (Class ?)} k (.getClass e)]
        (when (some? k)
          (for-each [^{:tag (Class ?)} i (Runner/allInterfaces k)]
            (when (.equals (.getName i) (java-str JP "provider.Arguments"))
              (try
                (let [g (.getMethod i "get")] (return (cast Object/1 (.invoke g e))))
                (catch Exception x (throw (RuntimeException. x))))))
          (recur (.getSuperclass k))))
      (when (and (instance? Object/1 e) (not (.isArray (.getComponentType (.getClass e)))))
        (return (cast Object/1 e))))
    (new Object/1 [e]))

  (method ^:static allInterfaces ^{:tag (List (Class ?))} [^{:tag (Class ?)} k]
    (let [^{:tag (List (Class ?))} l (ArrayList.)]
      (for-each [^{:tag (Class ?)} i (.getInterfaces k)]
        (.add l i)
        (.addAll l (Runner/allInterfaces i)))
      l))

  (method ^:static csv ^Object/1 [^String line ^String d]
    (let [^{:tag (List Object)} out (ArrayList.)
          b (StringBuilder.)
          ^:mutable quoted false
          ^:mutable wasQuoted false]
      (let [^:mutable ^int i 0]
        (while (<= i (.length line))
          (if (or (== i (.length line)) (and (not quoted) (.startsWith line d i)))
              (let [^String s (if wasQuoted (.toString b) (.trim (.toString b)))]
                (.add out (when-not (and (not wasQuoted) (.isEmpty s)) ^Object s))
                (.setLength b 0)
                (set! wasQuoted false)
                (when (< i (.length line))
                  (set! i (unchecked-add-int i (unchecked-subtract-int (.length d) 1)))))
              (let [ch (.charAt line i)]
                (if (== ch \')
                    (if (and (and quoted (< (unchecked-add-int i 1) (.length line)))
                             (== (.charAt line (unchecked-add-int i 1)) \'))
                        (do (.append b \') (set! i (unchecked-inc-int i)))
                        (do
                          (when-not quoted (.setLength b 0))
                          (set! quoted (not quoted))
                          (set! wasQuoted true)))
                    (when-not (and wasQuoted (not quoted)) (.append b ch)))))
          (set! i (unchecked-inc-int i))))
      (.toArray out)))

  (method ^:static convert [v ^{:tag (Class ?)} t]
    (if (or (or (or (not (instance? String v)) (identical? t String)) (identical? t Object))
            (identical? t CharSequence))
        v
        (let [s (cast String v)]
          (cond
            (or (identical? t Integer/TYPE) (identical? t Integer)) (Integer/valueOf s)
            (or (identical? t Long/TYPE) (identical? t Long)) (Long/valueOf s)
            (or (identical? t Short/TYPE) (identical? t Short)) (Short/valueOf s)
            (or (identical? t Byte/TYPE) (identical? t Byte)) (Byte/valueOf s)
            (or (identical? t Double/TYPE) (identical? t Double)) (Double/valueOf s)
            (or (identical? t Float/TYPE) (identical? t Float)) (Float/valueOf s)
            (or (identical? t Boolean/TYPE) (identical? t Boolean)) (Boolean/valueOf s)
            (or (identical? t Character/TYPE) (identical? t Character))
              (do
                (when-not (== (.length s) 1)
                  (throw (IllegalArgumentException. (java-str "not a char: " s))))
                (Character/valueOf (.charAt s 0)))
            :else
              (do
                (when (.isEnum t)
                  (for-each [k (.getEnumConstants t)]
                    (when (.equals (.name (cast Enum k)) s) (return k)))
                  (throw (IllegalArgumentException. (java-str "no constant " s " of " t))))
                (when (identical? t Class)
                  (try
                    (return (Class/forName s))
                    (catch ClassNotFoundException e (throw (IllegalArgumentException. e)))))
                (cond
                  (identical? t BigInteger) (BigInteger. s)
                  (identical? t BigDecimal) (BigDecimal. s)
                  (identical? t Duration) (Duration/parse s)
                  (identical? t Path) (Path/of s (new String/1 []))
                  (identical? t File) (File. s)
                  (identical? t URI) (URI/create s)
                  :else
                    (throw (IllegalArgumentException.
                             (java-str "no implicit conversion of a String to " (.getName t)))))))))))

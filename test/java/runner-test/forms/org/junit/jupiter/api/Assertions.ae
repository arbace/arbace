  (method ^:public ^:static assertThrows :type-params [(T extends Throwable)] ^T [^{:tag (Class T)} expectedType
                                                                                  ^Executable executable
                                                                                  ^{:tag (Supplier String)} messageSupplier]
    (Assertions/throwsOf expectedType executable false messageSupplier))

  (method ^:public ^:static assertThrowsExactly :type-params [(T extends Throwable)] ^T [^{:tag (Class T)} expectedType
                                                                                         ^Executable executable
                                                                                         ^{:tag (Supplier String)} messageSupplier]
    (Assertions/throwsOf expectedType executable true messageSupplier))

  (method ^:public ^:static assertDoesNotThrow ^void [^Executable executable
                                                      ^{:tag (Supplier String)} messageSupplier]
    (try
      (.execute executable)
      (catch Throwable t
        (throw (AssertionFailedError.
                 (java-str (Assertions/msg messageSupplier) "Unexpected exception thrown: " t)
                 t)))))

  (method ^:public ^:static assertDoesNotThrow :type-params [T] ^T [^{:tag (ThrowingSupplier T)} supplier
                                                                    ^{:tag (Supplier String)} messageSupplier]
    (try
      (.get supplier)
      (catch Throwable t
        (throw (AssertionFailedError.
                 (java-str (Assertions/msg messageSupplier) "Unexpected exception thrown: " t)
                 t)))))

  (method ^:public ^:static assertTimeout ^void [^Duration timeout ^Executable executable
                                                 ^{:tag (Supplier String)} messageSupplier]
    (Assertions/timed timeout
                      (lambda ThrowingSupplier [] (.execute executable) nil)
                      messageSupplier))

  (method ^:public ^:static assertTimeout :type-params [T] ^T [^Duration timeout
                                                               ^{:tag (ThrowingSupplier T)} supplier
                                                               ^{:tag (Supplier String)} messageSupplier]
    (Assertions/timed timeout supplier messageSupplier))

  (method ^:public ^:static assertTimeoutPreemptively ^void [^Duration timeout
                                                             ^Executable executable
                                                             ^{:tag (Supplier String)} messageSupplier]
    (Assertions/timed timeout
                      (lambda ThrowingSupplier [] (.execute executable) nil)
                      messageSupplier))

  (method ^:public ^:static assertTimeoutPreemptively :type-params [T] ^T [^Duration timeout
                                                                           ^{:tag (ThrowingSupplier T)} supplier
                                                                           ^{:tag (Supplier String)} messageSupplier]
    (Assertions/timed timeout supplier messageSupplier))

  (method ^:public ^:static assertInstanceOf :type-params [T] ^T [^{:tag (Class T)} expectedType
                                                                  actual
                                                                  ^{:tag (Supplier String)} messageSupplier]
    (when-not (.isInstance expectedType actual)
      (throw (AssertionFailedError.
               (java-str (Assertions/msg messageSupplier)
                         (if (nil? actual) "Unexpected null value" "Unexpected type")
                         ", expected: <"
                         (.getName expectedType)
                         "> but was: <"
                         (when (some? actual) (.getName (.getClass actual)))
                         ">"))))
    (.cast expectedType actual))

  (method ^:static near ^boolean [^double expected ^double actual ^double delta]
    (or (== (Double/doubleToLongBits expected) (Double/doubleToLongBits actual))
        (<= (Math/abs (unchecked-subtract expected actual)) delta)))

  (method ^:static near ^boolean [^float expected ^float actual ^float delta]
    (or (== (Float/floatToIntBits expected) (Float/floatToIntBits actual))
        (<= (Math/abs (unchecked-subtract-float expected actual)) delta)))

  (method ^:static iterableEquals ^boolean [^{:tag (Iterable ?)} expected
                                            ^{:tag (Iterable ?)} actual]
    (cond
      (identical? expected actual) true
      (or (nil? expected) (nil? actual)) false
      :else
        (let [^{:tag (Iterator ?)} e (.iterator expected)
              ^{:tag (Iterator ?)} a (.iterator actual)]
          (while (and (.hasNext e) (.hasNext a))
            (let [x (.next e)
                  y (.next a)]
              (if (and (instance? Iterable x) (instance? Iterable y))
                  (when-not (Assertions/iterableEquals (cast Iterable x) (cast Iterable y))
                    (return false))
                  (when-not (Objects/deepEquals x y) (return false)))))
          (and (not (.hasNext e)) (not (.hasNext a))))))

  (method ^:static linesMatch ^boolean [^{:tag (List String)} expected ^{:tag (List String)} actual]
    (if (not (== (.size expected) (.size actual)))
        false
        (do
          (loop [^int i 0]
            (when (< i (.size expected))
              (let [e (cast String (.get expected i))
                    a (cast String (.get actual i))]
                (if (and (not (.equals e a)) (not (.matches a e)))
                    (return false)
                    (recur (unchecked-inc-int i))))))
          true)))

  (method ^:static throwsOf :type-params [(T extends Throwable)] ^T [^{:tag (Class T)} expectedType
                                                                     ^Executable executable
                                                                     ^boolean exactly m]
    (try
      (.execute executable)
      (catch Throwable t
        (when (if exactly (identical? (.getClass t) expectedType) (.isInstance expectedType t))
          (return (cast Throwable (.cast expectedType t))))
        (throw (AssertionFailedError.
                 (java-str (Assertions/msg m)
                           "Unexpected exception type thrown, expected: <"
                           (.getName expectedType)
                           "> but was: <"
                           (.getName (.getClass t))
                           ">")
                 t))))
    (throw (AssertionFailedError.
             (java-str (Assertions/msg m)
                       "Expected "
                       (.getName expectedType)
                       " to be thrown, but nothing was thrown."))))

  (method ^:static timed :type-params [T] ^T [^Duration timeout
                                              ^{:tag (ThrowingSupplier T)} supplier m]
    (let [t0 (System/nanoTime)
          ^:mutable ^T v nil]
      (try (set! v (.get supplier)) (catch Throwable t (Assertions/rethrow t) (return nil)))
      (let [ms (unchecked-divide (unchecked-subtract (System/nanoTime) t0) 1000000)]
        (when (> ms (.toMillis timeout))
          (throw (AssertionFailedError.
                   (java-str (Assertions/msg m)
                             "execution exceeded timeout of "
                             (.toMillis timeout)
                             " ms by "
                             (unchecked-subtract ms (.toMillis timeout))
                             " ms"))))
        v)))

  (method ^:public ^:static assertAll ^void [& ^Executable/1 executables]
    (Assertions/assertAll (cast String nil) (Arrays/asList executables)))

  (method ^:public ^:static assertAll ^void [^String heading & ^Executable/1 executables]
    (Assertions/assertAll heading (Arrays/asList executables)))

  (method ^:public ^:static assertAll ^void [^{:tag (Collection Executable)} executables]
    (Assertions/assertAll (cast String nil) executables))

  (method ^:public ^:static assertAll ^void [^{:tag (Stream Executable)} executables]
    (Assertions/assertAll (cast String nil) (.toList executables)))

  (method ^:public ^:static assertAll ^void [^String heading ^{:tag (Stream Executable)} executables]
    (Assertions/assertAll heading (.toList executables)))

  (method ^:public ^:static assertAll ^void [^String heading
                                             ^{:tag (Collection Executable)} executables]
    (let [^{:tag (List Throwable)} failures (ArrayList.)]
      (for-each [^Executable e executables]
        (try (.execute e) (catch Throwable t (.add failures t))))
      (when-not (.isEmpty failures)
        (let [e (AssertionFailedError.
                  (java-str (if (nil? heading) "Multiple Failures" heading)
                            " ("
                            (.size failures)
                            " failures) "
                            failures))]
          (for-each [^Throwable t failures] (.addSuppressed e t))
          (throw e))))))

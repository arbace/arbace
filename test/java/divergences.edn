  :decided "JCS42 (b) (doc/classes/JAVA-CONFORMANCE-SURVEY.md, \"Decided (2026-10-25): JCS40-JCS49\", \"As built: JC2b\")"
  :match [#"^refused j2g: .*which j2g's support code takes as a leaf"]}

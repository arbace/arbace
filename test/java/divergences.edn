;; The classes of bin/java-check's non-passing tests (doc/classes/JAVA-CONFORMANCE-SURVEY.md, §6.1,
;; "As built: JC1"): every test of test/java/check-LEVEL.edn that does not pass falls into the first
;; class whose :level is its level (or that has none) and one of whose :match regexps finds its
;; "RESULT REASON" (as bin/java-check writes them in .tmp/java-check/results.tsv); a test no class
;; takes fails the check (java.check/report). :kind says whose the work is: :world (a JDK class or
;; member jrt lacks, deferred, JCS9 (b): JC6 ranks them), :design (out of the Go build for good,
;; J2G-SPEC §12), :interp (the interpreter's bugs and limits: JC4), :analysis (the Java forms'
;; analysis refusing forms javac accepted: JC5, JCS11 (c)), :repl (the REPL's model: JC4, JCS8),
;; :repr-java (the converter: JCS12), :javac (javac on Arbace's own Java, overlay/jdk/javac: its command
;; line and file manager; the diagnostics level, JC3), :speed, :harness (the check's runner, not
;; Arbace), :other. A class nobody decided yet has :decided :pending and names its :proposal.
;; Read with the Clojure reader.
[
 {:id :speed
  :title "speed: beyond the check's limit (20 s an action, the definition included)"
  :kind :speed
  :why "the interpreter is 5-200 times slower than HotSpot (CLASSFORMS-REPL §6); HotSpot's JIT tests loop 10^5-10^6 times to warm the JIT"
  :decided "survey §6.1, JCS10 (a)"
  :match [#"^timeout "]}
 {:id :read-failed
  :title "not interpreted: the read level failed (the test's class at that level)"
  :kind :harness
  :level :interp
  :why "no forms to interpret; the read level's result says why"
  :decided "As built: JC1"
  :match [#"^unread "]}
 {:id :read-stack-overflow
  :title "repr/java: the converter's stack overflows"
  :kind :repr-java
  :level :read
  :why "UncommonTrapStackBang's deeply nested expression: the converter recurses past the tool's stack"
  :decided "As built: JC1 (open)"
  :match [#"StackOverflowError"]}
 {:id :diag-release
  :title "javac on Arbace: --release N, any N (no ct.sym in its platform)"
  :kind :world
  :level :diagnostics
  :why "javac on Arbace attributes against the JDK build tree's exploded modules (jdk/javac/platform.sha256), which hold no ct.sym, the releases' signatures --release reads (survey §5.5): \"release version N not supported\", status 2, for 8-26"
  :decided :pending
  :proposal "JCS50"
  :match [#"release version \d+ not supported"]}
 {:id :diag-processors
  :title "javac on Arbace: annotation processors from class files (\"Could not instantiate an instance of processor\", proc.processor.cant.instantiate)"
  :kind :world
  :level :diagnostics
  :why "a processor built by @build is a class file on the class path; javac on Arbace has no class loader to define it (J2G-SPEC §12: class loading out of the Go build), so the processing tests stop at the processor's instantiation"
  :decided :pending
  :proposal "JCS51"
  :match [#"cant\.instantiate" #"Could not instantiate an instance of processor"]}
 {:id :diag-doclint
  :title "javac on Arbace: -Xdoclint (compiler.warn.doclint.not.available)"
  :kind :world
  :level :diagnostics
  :why "doclint is jdk.javadoc's (jdk.javadoc.internal.doclint), not in javac's world (jdk/javac: jdk.compiler, java.compiler); javac then warns and checks no comments (survey §5.5)"
  :decided :pending
  :proposal "JCS52"
  :match [#"doclint\.not\.available"]}
 {:id :diag-closed-world
  :title "javac on Arbace: a JDK class outside javac's closed world reached (java.lang.annotation.Annotation, java.lang.Module): the compiler's crash"
  :kind :world
  :level :diagnostics
  :why "javac's world is closed (j2g, J2G-SPEC §4.1); Check's leak check of a --patch-module java.base and the processing environment's processor loader (JavacProcessingEnvironment.initProcessorLoader) reach classes j2g left out"
  :decided "As built: JC3 (deferred, JCS9 (b): JC6 ranks the world's classes)"
  :match [#"is not in the closed world"]}
 {:id :diag-file-manager
  :title "javac on Arbace's file manager (jdk.internal.jrt.javac.FileManager, not javac's BaseFileManager): file names in full in raw diagnostics, no source.no.system.modules.path warning for -source N, -source 8's platform classes, a module-info's error twice"
  :kind :javac
  :level :diagnostics
  :why "javac's raw diagnostics print a PathFileObject's short name and other file objects' getName (Bar.class against .../classes/Bar.class); Arguments warns source.no.system.modules.path only for a BaseFileManager's default system modules; -source 8 looks java.lang up on the boot class path, which the platform's file manager does not serve; Log's de-duplication keys on the file object, two of which name one module-info.java"
  :decided :pending
  :proposal "JCS53"
  :tests ["t07441" "t07461"]
  :match [#"misc\.bad\.source\.file\.header: langtools/" #"classfile: RUN/" #"source\.no\.system\.modules\.path" #"Unable to find package java\.lang in platform classes" #"source value 8 is obsolete"]}
 {:id :diag-command-line
  :title "javac on Arbace's command line (jdk.internal.jrt.javac.Main, javac's API underneath, not javac's Main): -XDexpectKeys, the error count after a plug-in error, -encoding ascii, --module-path a jar"
  :kind :javac
  :level :diagnostics
  :why "javac on Arbace's Main parses the file manager's options itself and calls JavacTool.getTask (As built: JN3): what com.sun.tools.javac.main.Main.compile does beyond the task (the expected keys' report, the count when the task stops early) is missing, and the file manager refuses the encodings and module paths it does not serve"
  :decided :pending
  :proposal "JCS53"
  :tests ["t06659" "t07526"]
  :match [#"unsupported on Arbace: "]}
 {:id :read-platform
  :title "javac on Arbace: options its platform lacks (--release N without ct.sym, the charset alias utf8)"
  :kind :world
  :why "javac on Arbace attributes against the JDK build tree's modules, no ct.sym (JAVA-CONFORMANCE-SURVEY §5.5); jrt's charsets know UTF-8, not every alias"
  :decided "survey §5.5, JC3"
  :match [#"release version \d+ not supported" #"TypeEnter\$ImportsPhase/implicitImports" #"Arguments/reportDiag"]}
 {:id :repr-java-dims
  :title "repr/java: an array of more than nine dimensions (String/50)"
  :kind :repr-java
  :why "the converter writes C/N, the reader takes 1-9 dimensions"
  :decided "survey §6.3, JCS12 (b) (the converter writes a string tag)"
  :match [#"Invalid token: \S+/\d\d"]}
 {:id :interp-private-call
  :title "the interpreter: a private method called on another instance of its class (AbstractMethodError)"
  :kind :interp
  :why "by the symptom, a private method dispatched virtually when the receiver is not this (survey §6.2)"
  :decided "survey §6.2, JC4"
  :match [#"AbstractMethodError: (t\d{5}|compiler)\."]}
 {:id :interp-object-method
  :title "the interpreter: an Object method called through a world interface or class (Map.toString(), Collection.getClass())"
  :kind :interp
  :why "by the symptom, looked up among the static type's own methods rather than Object's (JLS 9.2; survey §6.2)"
  :decided "survey §6.2, JC4"
  :match [#"AbstractMethodError: java\.\S+\.(toString|getClass|hashCode|equals)\("]}
 {:id :interp-clone
  :title "the interpreter: clone() of an interpreted Cloneable class"
  :kind :interp
  :why "Object.clone's super call is not in the Go build for interpreted classes"
  :decided "survey §6.2, JC4"
  :match [#"CloneNotSupportedException: t\d{5}" #"super call of java\.lang\.Object\.clone"]}
 {:id :interp-jls
  :title "the interpreter: the JLS corpus's findings (finally's return swallowing an exception, a cast choosing an overload, compile-time constant strings not interned)"
  :kind :interp
  :why "test/java/jls's Exceptions (try { throw } finally { return } rethrows), Overloads (v((Object) \"s\") calls v(String)) and StringConcat (K == \"k12\" false): found by JC1's hand-curated corpus"
  :decided "As built: JC1, JC4"
  :tests ["t03210" "t03216" "t03217"]}
 {:id :interp-extends
  :title "a superclass the Java forms cannot extend yet (Thread, ArrayList, AtomicReference, streams...)"
  :kind :interp
  :why "interpreted classes extend Object, interpreted classes or arbace.j2g.dyn/class-supers' world classes (CLASSFORMS-REPL §2)"
  :decided "survey §6.1, JC4/JC6"
  :match [#"cannot extend \S+ yet"]}
 {:id :interp-protected
  :title "a protected or inherited member of a world class (setChanged, AQS' getState, clearError, findLoadedClass, a world superclass's field)"
  :kind :interp
  :why "interpreted code calls the world by reflection over jrt's public members (CLASSFORMS-REPL §7)"
  :decided "survey §6.1, JC4"
  :match [#"No accessible (static )?method \w+ in (t\d{5}|compiler)\." #"No field \w+ in (t\d{5}|compiler)\."]}
 {:id :repl-sibling
  :title "the REPL's model: a class of the do used before it is defined, a test's class named as a java.lang class"
  :kind :repl
  :why "a static initializer or a superclass needing a class defined later in the do (SPEC §9.2), a class of another of the test's packages not yet defined (the packages' order by their imports); a class Enum or Package of the test's package clashes with the namespace's import of java.lang's"
  :decided "survey §6.1, JCS8 (b), JC4"
  :match [#"\(a Java form of the enclosing do\) is not defined yet" #"already refers to: class java\.lang\."
          #"ClassNotFoundException: (?!java|javax|sun|jdk|com\.sun)[a-z]\w*\."]}
 {:id :analysis
  :title "the analysis: forms javac accepted that arbace.classes.analyze refuses (boxing and generic conversions, switch on long and constant labels, qualified super, intersection types, pattern bindings' scope)"
  :kind :analysis
  :why "the Java forms' analysis is erased by design and leaves some of javac's decisions open; each is the converter's or the analysis' to make (JCS11 (c))"
  :decided "survey §6.3, JC5"
  :match [#"Cannot convert" #"switch without default" #"switch on a value of type" #"switch label is not a constant"
          #"No static field super in" #"is not a functional interface" #"for-each over a value of type" #"\^:const local"
          #"Unknown class int" #"Unknown type: (\[C|AX\$)" #"Unable to resolve symbol: (s|Inclass7)$" #"Local not available here"
          #"No enclosing instance of type" #"No matching (static )?method \S+ for argument types \[(\"L(t\d{5}|java/lang/Object|java/lang/Comparable|java/lang/String)|\"I\" \"J\"|\]$|\]; candidates: \(\"\(I\)Ljava/nio)"
          #"No matching constructor of (t\d{5}|java\.lang\.RuntimeException|java/util/AbstractList for argument types \[\]$)"
          #"No method access\$" #"Class not found: java\.lang\.Object;" #"throw of a non-Throwable"
          #"No accessible method (length|test1) in java\.lang\.Object"]}
 {:id :serialization
  :title "serialization (ObjectInputStream, ObjectOutputStream, Externalizable)"
  :kind :design
  :why "out of the Go build for good"
  :decided "J2G-SPEC §12 (2026-10-10)"
  :match [#"ObjectInputStream|ObjectOutputStream|Externalizable|InvalidClassException|NotSerializableException|ObjectStream|java\.rmi\.MarshalledObject"]}
 {:id :desktop
  :title "AWT, Swing (java.desktop)"
  :kind :design
  :why "out of the Go build for good"
  :decided "J2G-SPEC §12"
  :match [#"java\.awt\.|javax\.swing|java\.applet"]}
 {:id :beans
  :title "java.beans (java.desktop's module)"
  :kind :world
  :why "not in jrt; it shares java.desktop with AWT and Swing; the whole of jdk/java/beans fails here (JCS16)"
  :decided "JCS9 (b), JC6"
  :match [#"java\.beans\."]}
 {:id :javac-api
  :title "javac's API (com.sun.tools.javac.Main, javax.tools, com.sun.source): javac's tool, not the shipped program"
  :kind :world
  :why "javac on Arbace is its own executable (JN3); the executable under test has no javac"
  :decided "JCS9 (b), JC6"
  :match [#"com\.sun\.tools|javax\.tools|com\.sun\.source|javax\.annotation\.processing|javax\.lang\.model"]}
 {:id :management
  :title "java.lang.management, JMX"
  :kind :world
  :why "not in jrt"
  :decided "JCS9 (b), JC6"
  :match [#"java\.lang\.management|javax\.management|com\.sun\.management"]}
 {:id :invoke
  :title "java.lang.invoke (MethodHandle, MethodHandles, CallSite, LambdaConversionException)"
  :kind :world
  :why "no java.lang.invoke beyond what j2g compiles directly (J2G-SPEC §12)"
  :decided "JCS9 (b), JC6"
  :match [#"java\.lang\.invoke"]}
 {:id :classfile
  :title "java.lang.classfile, java.lang.constant"
  :kind :world
  :why "not in jrt"
  :decided "JCS9 (b), JC6"
  :match [#"java\.lang\.classfile|java\.lang\.constant"]}
 {:id :reflection
  :title "annotations and reflection's types and metadata (getAnnotation, getTypeParameters, generic types, Proxy, AccessFlag, isLocalClass, canonical and InnerClasses names, javac's synthetic members)"
  :kind :world
  :why "no annotations at run time, generic reflection as plain classes (J2G-SPEC §12); interpreted classes' metadata is the Dyn's"
  :decided "JCS9 (b), JC6"
  :match [#"getAnnotation|getTypeParameters|getGeneric|getParameters|getDeclaredClasses|getClasses in|getProxyClass|getAnnotated|getProtectionDomain"
          #"java\.lang\.reflect\.(Annotated|AccessFlag|Proxy|TypeVariable|ParameterizedType|Parameter|RecordComponent|Executable|InaccessibleObject)"
          #"java\.lang\.annotation|[Aa]nnotation (status|mismatch)|RecursiveAnnotation|isLocalClass|canonical name|enclosing instance|InnerClasses attribute|static modifier of innerclass"
          #"lambda method|lambda\$|Reflection access checks|setByte in java\.lang\.reflect|SimpleProxy|NewArray allowed dimensions"]}
 {:id :zip
  :title "zip and jar (ZipFile, Deflater, CRC32C, Adler32, GZIPInputStream, JarFile, the jar: and jrt: URLs)"
  :kind :world
  :why "not in jrt (but its own Deflater in javac's tool world)"
  :decided "JCS9 (b), JC6"
  :match [#"java\.util\.(zip|jar)|java/util/(zip|jar)/|ZipEntry|JarFile|JarEntry|JarURLConnection|protocol: jrt"]}
 {:id :logging
  :title "java.util.logging, System.Logger"
  :kind :world
  :why "not in jrt"
  :decided "JCS9 (b), JC6"
  :match [#"java\.util\.logging|System\$Logger"]}
 {:id :references
  :title "references, finalization, collection (PhantomReference, Cleaner, runFinalization, a referent not collected)"
  :kind :world
  :why "Go's collector, not HotSpot's"
  :decided "JCS9 (b), JC6"
  :match [#"PhantomReference|referent not collected|runFinalization|java\.lang\.ref\.|Cleaner"]}
 {:id :stack
  :title "StackWalker, stack traces and their line numbers"
  :kind :world
  :why "the interpreter's frames are its nodes' (CLASSFORMS-REPL §7)"
  :decided "JCS9 (b), JC6"
  :match [#"StackWalker|[Ll]ine number|Exception: Stack trace|StackTraceElement|getAllStackTraces"]}
 {:id :net
  :title "networking (datagrams, multicast, NIO channels and selectors, URL protocols, HTTP client, network interfaces, RMI)"
  :kind :world
  :why "jrt's networking is TCP sockets and their streams"
  :decided "JCS9 (b), JC6"
  :match [#"java\.net\.|java/net/|java\.nio\.channels|sun\.net|NetworkInterface|unknown protocol|java\.rmi|FTP not supported"]}
 {:id :nio
  :title "NIO buffers, files and charsets' coders (direct buffers, FileChannel, FileTime, Charset's encoders)"
  :kind :world
  :why "jrt's NIO is partial"
  :decided "JCS9 (b), JC6"
  :match [#"java\.nio\.|DirectByteBuffer|BufferMismatch|HeapCharBuffer|getChannel in|newDecoder|newEncoder|encode in java\.nio"]}
 {:id :security
  :title "security (KeyStore, certificates, providers, permissions, key generators)"
  :kind :world
  :why "jrt's security is the digests and the TLS the runtime needs"
  :decided "JCS9 (b), JC6"
  :match [#"java\.security|java/security|javax\.crypto|javax\.security|sun\.security|Permission|SunJCE"]}
 {:id :charsets-locales
  :title "charsets and locales (UTF-16LE's and UTF-32's coders, EUC-JP, US-ASCII's aliases, Lithuanian casing, number systems)"
  :kind :world
  :why "three plus three charsets, the root and English locales (J2G-SPEC §12)"
  :decided "JCS9 (b), JC6"
  :match [#"Unsupported ?Encoding|UnsupportedEncodingException|stream coding for|US-ASCII|locale: lt|EUCJIS|number system|toLowerCase returned"]}
 {:id :io
  :title "java.io classes jrt lacks (RandomAccessFile, Piped streams, DataOutputStream, StreamTokenizer, PushbackInputStream...)"
  :kind :world
  :why "not in jrt"
  :decided "JCS9 (b), JC6"
  :match [#"java\.io\."]}
 {:id :threads
  :title "threads and concurrency's members jrt lacks (thread groups, platform threads, ForkJoinPool's, FutureTask's, Phaser's, ScopedValue, Timer)"
  :kind :world
  :why "jrt's threads are goroutines; the members are cut"
  :decided "JCS9 (b), JC6"
  :match [#"java\.lang\.Thread|ThreadGroup|ForkJoinPool|FutureTask|Phaser|Semaphore|Executors\.|ScopedValue|getContextClassLoader|java\.util\.Timer|java\.util\.concurrent"]}
 {:id :classloading
  :title "class loading (ClassLoader's members, defineClass, ServiceLoader, modules, Class.forName of an unqualified name)"
  :kind :design
  :why "no class loading from jars or bytes (J2G-SPEC §12); classes are translated or interpreted"
  :decided "J2G-SPEC §12"
  :match [#"ClassLoader|defineClass|ServiceLoader|ResourceBundle\$Control|Unknown type: Module|ClassNotFoundException: (Foo|T\d+\.package-info)"]}
 {:id :world-other
  :title "other JDK classes and members jrt lacks or cuts (System.getProperty(\"java.version\"), Calendar's and Timezone's internals, RandomGeneratorFactory...)"
  :kind :world
  :why "jrt is the closure Arbace needs; the rest is decided class by class"
  :decided "JCS9 (b), JC6"
  :match [#"ClassNotFoundException: java" #"No accessible (static )?(method|constructor|field)" #"No matching (static )?(method|constructor) .*java[./]"
          #"is not in the Go build|is not in the closed world|jrt lacks|UnsupportedOperationException$" #"No static field \w+ in java"
          #"Unknown type: (StackWalker|System)" #"Java Version: null" #"jdk\.internal" #"sun\.misc"]}
 {:id :identity
  :title "stdout prints identity hash codes or traces (Object.toString, a stack trace to stdout): the same on each side's runs, not between them"
  :kind :harness
  :why "the reference has stdout's digest only; identity hash codes and trace frames are the implementation's (JCS17)"
  :decided "As built: JC1"
  :match [#"^differ .*@[0-9a-f]{6,8}" #"^differ .*ClassCastException: Attempt to insert"]}
 {:id :environment
  :title "the run's environment: temporary directory, canonical paths"
  :kind :harness
  :why "the JDK ran in .tmp/java-check/record, the interpreter in .tmp/java-check/run; java.io.tmpdir is /tmp on the JDK, TMPDIR (.tmp/tmp) on Arbace"
  :decided "As built: JC1"
  :match [#"tmpdir|Canonical Path"]}
 {:id :other
  :title "other failures and output differences, each its own (Calendar's fields, Date's UTC, Math.pow, a ThreadLocal on another thread, a JIT test's arithmetic...): to triage"
  :kind :other
  :why "a failure the classes above do not explain: the interpreter's, jrt's or the test's; JC4 and JC6 take them apart"
  :decided "As built: JC1"
  :match [#"^fail " #"^differ "]}
]

 {:id :interp-private-call
  :title "the interpreter: a private method called on another instance of its class (AbstractMethodError)"
  :kind :interp
  :why "by the symptom, a private method dispatched virtually when the receiver is not this (survey §6.2)"
  :decided "survey §6.2, JC4"
  :match [#"AbstractMethodError: (t\d{5}|compiler)\."]}
 {:id :interp-object-method
  :title "the interpreter: an Object method called through a world interface or class (Map.toString(), Collection.getClass())"
  :kind :interp

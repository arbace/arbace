(ns java.project
  "bin/java-project's data side (doc/go/BUILD.md, \"Java sources by module\"; GH2 (a), GH3 (a), the
  Ghidra case study's A1, A2, A3 and A11; a namespace under test/java/, evaluated on the tools'
  host, as java.check). bin/java-project runs the processes (unzip, javac on Arbace, repr/java's
  read); this namespace reads the project model and the processes' logs:

    plan FILE BASE [--root NAME=DIR]... [--repository DIR]
        the model of FILE (a program.edn, or a plan file holding the same map) checked and
        resolved: its modules in dependency order, one block a module, each line a key and its
        values separated by tabs (bin/java-project reads it with read -a), the paths absolute
        (relative to BASE; $NAME/... under --root NAME=DIR; a coordinate g:a:v in the Maven
        repository); before them the line `outside` with :outside's values (platform,
        class-path: the declarations outside the world j2g takes, A8 and A8b); first among
        them :jdk-extra's modules (A15, the program's world extension: kind jdk, the JDK
        module's source directories in jdk26u's tree, $jdk26u/src/MODULE/{share,unix,linux}/classes,
        its closure and its j2g variants)
    closure-scan LOG ROOT
        a javac log of the closure's compilation (A3): the files of ROOT javac parsed, one
        `parsed FILE` line each, and each file with an error, `error FILE CAUSE NAME MESSAGE`
        (CAUSE absent: a type or package javac cannot find, NAME its name; other: any other error)
    closure-report OUT MODULE ROUNDS LEFT KEPT ROOTS
        the closure's report as data (LEFT: the left-out rows, round, file, cause, name, message;
        KEPT: the files kept; ROOTS: the roots): OUT, an EDN map
    merge-forms OUT [--shadowed FILE] DIR...
        the modules' forms trees merged into OUT (a package split over modules: its namespace
        file's loads united); a class in two trees an error, or with --shadowed (A16) the first
        tree's, as a class path loads it, a later tree's differing copy listed in FILE (`REL
        MODULE` a line, MODULE the tree's directory name) and an equal one silent"
  (:require [arbace.string :as str]
            [arbace.java.io :as io])
  (:import (java.io File PushbackReader)))

(defn- read-edn [f]
  (with-open [r (PushbackReader. (io/reader f))]
    (read r)))

(defn- fail [& msg]
  (binding [*out* *err*] (println (apply str "java-project: " msg)))
  (System/exit 2))

(defn- lines [f]
  (let [f (io/file f)]
    (if (.isFile f) (remove str/blank? (str/split-lines (slurp f))) [])))

;; ---------------------------------------------------------------------------------------------
;; the model

(def ^:private module-keys
  #{:name :src :resources :deps :artifacts :javac :release :artifact :closure :patches})

(def ^:private java-keys #{:release :javac :repository :modules :outside :shadow :jdk-extra})

(def ^:private jdk-extra-keys #{:module :closure :classes :variants})

(defn- check-closure [file what c]
  (when-not (map? c) (fail file ": " what ": :closure is a map of :roots and :optional"))
  (when-let [bad (seq (remove #{:roots :optional} (keys c)))]
    (fail file ": " what ": unknown :closure keys " (vec bad)))
  (when-not (seq (concat (:roots c) (:optional c)))
    (fail file ": " what ": :closure needs :roots or :optional")))

(defn- check-jdk-extra
  "The :jdk-extra entries (A15, GH13 (a)): the JDK modules a program's world extends the shipped one
  with, each {:module NAME :closure {:roots [...] :optional [...]} :variants [PATH ...]}: read from
  jdk26u's sources at the platform's pin, cut by A3 from the roots (a JDK module whole is the
  shipped world's business, A21), read by repr/java with --patch-module, its forms and resources the
  program's. In place of :closure, :classes names the set itself (the round 53 note: a measured
  class-load list, as overlay/jdk/javac/closure.txt is for javac's tool world): class names or
  patterns (p.C, p.*, p.**), a vector or a file of them (a string, one a line, # comments), their
  files read as they are, no cut; what they name outside the set is the platform's (declared outside
  the world with :outside [:platform], A8). Not java.base (the shipped world's own module) and not a name a module
  of :modules has."
  [file j]
  (let [xs (:jdk-extra j)
        names (set (map :name (:modules j)))]
    (when-not (or (nil? xs) (vector? xs))
      (fail file ": :jdk-extra is a vector of {:module NAME :closure {...} :variants [...]} (A15)"))
    (doseq [x xs]
      (when-not (and (map? x) (string? (:module x)) (re-matches #"[a-z][a-z0-9]*(\.[a-z][a-z0-9]*)+" (:module x)))
        (fail file ": a :jdk-extra entry needs a :module, a JDK module's name (java.xml): " (pr-str x)))
      (let [what (str ":jdk-extra " (:module x))]
        (when-let [bad (seq (remove jdk-extra-keys (keys x)))]
          (fail file ": " what ": unknown keys " (vec bad)))
        (when (= "java.base" (:module x))
          (fail file ": " what ": java.base is the shipped world's (its additions go to test/jrt/jrt_sources.ae, A21)"))
        (when (names (:module x))
          (fail file ": " what ": a module of :modules has that name"))
        (when (= (boolean (:closure x)) (boolean (:classes x)))
          (fail file ": " what ": one of :closure (A3's cut from its roots) and :classes (the set itself) is required (a JDK module whole is the shipped world's, A21)"))
        (when (:closure x) (check-closure file what (:closure x)))
        (when-let [c (:classes x)]
          (when-not (or (string? c) (and (vector? c) (seq c) (every? string? c)))
            (fail file ": " what ": :classes is a vector of class names or patterns, or a file of them")))
        (when-not (or (nil? (:variants x)) (and (vector? (:variants x)) (every? string? (:variants x))))
          (fail file ": " what ": :variants is a vector of j2g variant files or directories of them"))))
    (when-let [dup (seq (for [[n c] (frequencies (map :module xs)) :when (> c 1)] n))]
      (fail file ": :jdk-extra names a module twice: " (vec dup)))))

(defn- coord-parts [c]
  (let [ps (str/split (str c) #":")]
    (when-not (= 3 (count ps)) (fail "a coordinate is group:artifact:version, not " (pr-str c)))
    ps))

(defn- coord-path
  "The path of coordinate `c`'s file of `kind` (:jar, :sources) in a Maven repository."
  [repo c kind]
  (let [[g a v] (coord-parts c)]
    (str repo "/" (str/replace g "." "/") "/" a "/" v "/" a "-" v
         (case kind :jar ".jar" :sources "-sources.jar"))))

(defn- resolve-path
  "A path of the model: $NAME/rest under the root NAME, absolute as is, else under base."
  [base roots p]
  (let [p (str p)]
    (cond
      (str/starts-with? p "$") (let [i (or (str/index-of p "/") (count p))
                                     n (subs p 1 i)
                                     d (or (get roots n) (fail "no root " n " (--root " n "=DIR) for " p))]
                                 (str d (subs p i)))
      (str/starts-with? p "/") p
      :else (str base "/" p))))

(defn model
  "The :java map of the model in `file` (a program.edn or a plan file), checked."
  [file]
  (let [m (read-edn file)
        j (:java m)]
    (when-not (map? j) (fail file ": no :java map"))
    (when-let [bad (seq (remove java-keys (keys j)))] (fail file ": unknown :java keys " (vec bad)))
    (when-not (or (nil? (:outside j))
                  (and (vector? (:outside j)) (every? #{:platform :class-path} (:outside j))))
      (fail file ": :outside is a vector of :platform (the platform's modules but java.base) and :class-path (the binary jars on javac's class path alone): the declarations j2g takes outside the world (A8, A8b)"))
    (let [mods (:modules j)
          names (map :name mods)]
      (when-not (and (vector? mods) (seq mods)) (fail file ": :java's :modules is a vector of modules"))
      (doseq [md mods]
        (when-not (and (map? md) (string? (:name md)) (re-matches #"[A-Za-z0-9][A-Za-z0-9._-]*" (:name md)))
          (fail file ": a module needs a :name (letters, digits, . _ -): " (pr-str md)))
        (when-let [bad (seq (remove module-keys (keys md)))]
          (fail file ": module " (:name md) ": unknown keys " (vec bad)))
        (when (= (boolean (:src md)) (boolean (:artifact md)))
          (fail file ": module " (:name md) ": one of :src (source directories) and :artifact (a sources jar)"))
        (when (and (:closure md) (not (:artifact md)))
          (fail file ": module " (:name md) ": :closure is an artifact's (a library cut to what its roots reach)"))
        (when-let [c (:closure md)]
          (check-closure file (str "module " (:name md)) c))
        (when (and (:patches md) (not (and (:artifact md) (vector? (:patches md)) (every? string? (:patches md)))))
          (fail file ": module " (:name md) ": :patches is an artifact's vector of patch files (a dependency's variants)"))
        (when-not (or (nil? (:resources md)) (= :jar (:resources md)) (vector? (:resources md)))
          (fail file ": module " (:name md) ": :resources is a vector of directories, or :jar (an artifact's binary jar's)"))
        (when (and (= :jar (:resources md)) (not (:artifact md)))
          (fail file ": module " (:name md) ": :resources :jar is an artifact's"))
        (doseq [d (:deps md)]
          (when-not (some #{d} names) (fail file ": module " (:name md) ": no module " d " (:deps)"))))
      (when-let [dup (seq (for [[n c] (frequencies names) :when (> c 1)] n))]
        (fail file ": modules named twice: " (vec dup)))
      (when-not (contains? #{nil true false} (:shadow j))
        (fail file ": :shadow is true (the default: a class in two modules the first's) or false (an error)"))
      (check-jdk-extra file j)
      j)))

(defn- topo
  "The modules in dependency order (a module after its :deps; else the model's order), or a failure
  naming a cycle."
  [mods]
  (let [by (into {} (map (juxt :name identity) mods))]
    (loop [done [] seen #{} todo (map :name mods)]
      (if-let [n (first todo)]
        (if (seen n)
          (recur done seen (rest todo))
          (let [visit (fn visit [n path acc]
                        (cond
                          (some #{n} path) (fail "a cycle of :deps: " (str/join " -> " (conj path n)))
                          ((:seen acc) n) acc
                          :else (let [acc (reduce #(visit %2 (conj path n) %1) acc (:deps (by n)))]
                                  (-> acc (update :seen conj n) (update :done conj n)))))
                acc (visit n [] {:seen seen :done done})]
            (recur (:done acc) (:seen acc) (rest todo))))
        (mapv by done)))))

(defn- deps*
  "Module `n`'s dependencies, transitively, in `order`'s order."
  [by order n]
  (let [all (loop [seen #{} todo (:deps (by n))]
              (if-let [d (first todo)]
                (if (seen d) (recur seen (rest todo)) (recur (conj seen d) (concat (rest todo) (:deps (by d)))))
                seen))]
    (filterv all order)))

(defn- tsv-line [k vs]
  (str/join "\t" (cons k (map str vs))))

(defn plan
  "Print the resolved plan of `file` (see the namespace's doc)."
  [file base & opts]
  (let [{:keys [roots repository]}
        (loop [[a b & more :as os] opts acc {:roots {}}]
          (case a
            nil acc
            "--root" (let [i (or (str/index-of b "=") (fail "--root NAME=DIR"))]
                       (recur more (assoc-in acc [:roots (subs b 0 i)] (subs b (inc i)))))
            "--repository" (recur more (assoc acc :repository b))
            (fail "plan: unknown option " a)))
        base (.getCanonicalPath (io/file base))
        j (model file)
        repo (or repository (some->> (:repository j) (resolve-path base roots)))
        mods (topo (:modules j))
        by (into {} (map (juxt :name identity) mods))
        order (mapv :name mods)
        rp (partial resolve-path base roots)
        jar (fn [c kind] (when-not repo (fail "an artifact " c " but no repository (:repository, --repository)"))
              (coord-path repo c kind))]
    ;; the declarations outside the world j2g takes (A8, A8b): the program's line, before the modules'
    (println (tsv-line "outside" (map name (:outside j))))
    ;; :jdk-extra (A15): the JDK modules of the program's world extension, first (a JDK module's resources
    ;; before the class path's, as the platform's loaders find them), each a module of kind jdk whose
    ;; sources are jdk26u's ($jdk26u, bin/java-project's --root jdk26u=DIR) source directories of the
    ;; module, share's then the unix and linux layers' (bin/java-project lays them over in that order,
    ;; those that exist)
    (doseq [{:keys [module closure classes variants]} (:jdk-extra j)
            :let [classes (if (string? classes)
                            (let [f (rp classes)]
                              (when-not (.isFile (io/file f)) (fail file ": :jdk-extra " module ": no :classes file " f))
                              (remove #(or (str/blank? %) (str/starts-with? % "#")) (map str/trim (str/split-lines (slurp f)))))
                            classes)]]
      (println (tsv-line "module" [module]))
      (println (tsv-line "kind" ["jdk"]))
      (println (tsv-line "release" [""]))
      (println (tsv-line "src" (for [l ["share" "unix" "linux"]] (rp (str "$jdk26u/src/" module "/" l "/classes")))))
      (println (tsv-line "jdk-root" [(rp "$jdk26u")]))
      (doseq [k ["resources" "deps" "artifacts" "jars" "javac" "patches"]] (println (tsv-line k [])))
      (println (tsv-line "resources-jar" [""]))
      (println (tsv-line "coord" [""]))
      (println (tsv-line "sources-jar" [""]))
      (println (tsv-line "binary-jar" [""]))
      (println (tsv-line "roots" (:roots closure)))
      (println (tsv-line "optional" (:optional closure)))
      (println (tsv-line "classes" classes))
      (println (tsv-line "variants" (map rp variants)))
      (println (tsv-line "shadow" [(if (false? (:shadow j)) "no" "yes")]))
      (println "end"))
    (doseq [{:keys [name src resources artifacts javac release artifact closure patches]} mods
            :let [ds (deps* by order name)
                  ;; the binary jars on the class path: its own :artifacts and its dependencies'
                  arts (distinct (concat artifacts (mapcat #(:artifacts (by %)) ds)))]]
      (println (tsv-line "module" [name]))
      (println (tsv-line "kind" [(if artifact "artifact" "src")]))
      (println (tsv-line "release" [(or release (:release j) "")]))
      (println (tsv-line "src" (map rp src)))
      (println (tsv-line "resources" (if (vector? resources) (map rp resources) [])))
      (println (tsv-line "resources-jar" [(if (= :jar resources) "yes" "")]))
      (println (tsv-line "deps" ds))
      (println (tsv-line "artifacts" arts))
      (println (tsv-line "jars" (map #(jar % :jar) arts)))
      (println (tsv-line "javac" (concat (:javac j) javac)))
      (println (tsv-line "coord" [(or artifact "")]))
      (println (tsv-line "sources-jar" [(if artifact (jar artifact :sources) "")]))
      (println (tsv-line "binary-jar" [(if artifact (jar artifact :jar) "")]))
      (println (tsv-line "roots" (:roots closure)))
      (println (tsv-line "optional" (:optional closure)))
      (println (tsv-line "patches" (map rp patches)))
      (println (tsv-line "shadow" [(if (false? (:shadow j)) "no" "yes")]))
      (println "end"))))

;; ---------------------------------------------------------------------------------------------
;; the closure (A3): javac's log read

(defn- canonical [p] (try (.getCanonicalPath (io/file p)) (catch Throwable _ p)))

(defn closure-scan
  "Print the parsed files and the errors of javac's log `log` (default format, -verbose), for the
  files under `root` (see the namespace's doc)."
  [log root]
  (let [root (canonical root)
        ls (vec (str/split-lines (slurp log)))
        rel (fn [p] (let [c (canonical p)] (when (str/starts-with? c (str root "/")) (subs c (inc (count root))))))]
    (doseq [l ls
            :let [[_ p] (re-find #"^\[parsing started (?:[A-Za-z]+\[)?(.*?\.java)\]?\]$" l)]
            :when p
            :let [r (rel p)]
            :when r]
      (println (str "parsed\t" r)))
    (doseq [[i l] (map-indexed vector ls)
            :let [[_ p msg] (re-find #"^(/.*?\.java):\d+: error: (.*)$" l)]
            :when p
            :let [r (rel p)]
            :when r]
      (let [follow (take-while #(not (re-find #"^(/.*?\.java):\d+: |^\d+ errors?$|^\[" %)) (subvec ls (inc i)))
            sym (some #(second (re-find #"^\s+symbol:\s+(?:class|interface|enum|record|variable|method|static|package)\s+(\S+?)(?:\(.*)?$" %)) follow)
            [cause nm] (cond
                         (re-find #"^package (\S+) does not exist" msg) [:absent (second (re-find #"^package (\S+) does not exist" msg))]
                         (re-find #"^cannot find symbol" msg) [:absent (or sym "?")]
                         (re-find #"^cannot access (\S+)" msg) [:absent (second (re-find #"^cannot access (\S+)" msg))]
                         (re-find #"^static import only from classes" msg) [:absent "?"]
                         :else [:other ""])]
        (println (str/join "\t" ["error" r (name cause) nm (str/replace msg "\t" " ")]))))))

(defn- file->class [f]
  (-> f (str/replace #"\.java$" "") (str/replace "/" ".")))

(defn closure-report
  "Write the closure's report (see the namespace's doc)."
  [out module rounds left kept roots]
  (let [left (for [l (lines left)] (str/split l #"\t" -1))
        left-classes (set (map #(file->class (nth % 1)) left))
        simple (into {} (map (fn [c] [(last (str/split c #"\.")) c]) left-classes))
        kept (vec (sort (lines kept)))
        rows (vec (for [[round f cause nm msg] left]
                    (cond-> {:file f :round (Long/parseLong round) :cause (keyword cause)}
                      (seq nm) (assoc :names nm)
                      ;; a name of a file left out before (the cascade)
                      (and (= cause "absent") (or (left-classes nm) (simple nm)))
                      (assoc :left-out (or (left-classes nm) (simple nm)))
                      (= cause "other") (assoc :message msg))))
        absent (->> rows (filter #(and (= :absent (:cause %)) (not (:left-out %)))) (map :names) frequencies
                    (into (sorted-map)))]
    (io/make-parents out)
    (spit out (with-out-str
                (println (str ";; bin/java-project's closure of module " module " (A3, doc/go/BUILD.md, \"Java sources by module\"):"))
                (println ";; the files its roots reach (javac's -implicit:class over the sources), less those that name a type")
                (println ";; javac cannot find (:absent, the name) or a file left out before (:left-out), round by round")
                (println "{:module" (pr-str module))
                (println " :roots" (pr-str (vec (lines roots))))
                (println " :rounds" rounds)
                (println " :kept-count" (count kept))
                (println " :left-out-count" (count rows))
                (println " :absent-names" (pr-str absent))
                (println " :left-out")
                (println "  [")
                (doseq [r (sort-by (juxt :round :file) rows)] (println "   " (pr-str r)))
                (println "  ]")
                (println " :kept")
                (println "  [")
                (doseq [k kept] (println "   " (pr-str k)))
                (println "  ]}")))))

;; ---------------------------------------------------------------------------------------------
;; the forms merged

(defn- class-text
  "A class's forms without the header line that names its file (MODULE/PATH, --origins): two
  modules' copies of one class compared."
  [text]
  (str/replace-first text #"\A;; Converted from [^\n]*\n" ""))

(defn merge-forms
  "Merge the forms trees `dirs` into `out`: each class's file copied, each package's namespace
  file written once with the loads of every tree. A class in two trees is an error; with
  `--shadowed FILE` first (A16, a class path's order: the plan's) the first tree's, a later
  differing copy listed in FILE as `REL MODULE` (MODULE the tree's directory name), an equal
  one (but for its header's file name) silent."
  [out & dirs]
  (let [[shadowed dirs] (if (= "--shadowed" (first dirs)) [(second dirs) (nnext dirs)] [nil dirs])
        out (io/file out)
        nsfiles (atom {})
        shadows (atom [])]
    (doseq [d dirs
            :let [d (io/file d)
                  dp (.getCanonicalPath d)]
            ^File f (file-seq d)
            :when (and (.isFile f) (str/ends-with? (.getName f) ".ae"))
            :let [rel (subs (.getCanonicalPath f) (inc (count dp)))
                  text (slurp f)]]
      (if (re-find #"(?m)^\(ns " text)
        (swap! nsfiles update rel (fnil conj []) text)
        (let [o (io/file out rel)]
          (cond
            (not (.exists o)) (do (io/make-parents o) (io/copy f o))
            (not shadowed) (fail "merge-forms: " rel " in two modules")
            (= (class-text text) (class-text (slurp o))) nil
            :else (swap! shadows conj (str rel " " (.getName d)))))))
    (when shadowed
      (spit shadowed (apply str (map #(str % "\n") @shadows))))
    (doseq [[rel texts] @nsfiles
            :let [o (io/file out rel)
                  t (first texts)
                  loads (into (sorted-set) (mapcat #(re-seq #"(?m)^\(load \"[^\"]*\"\)$" %) texts))
                  head (str/replace t #"(?m)^\(load \"[^\"]*\"\)\n?" "")]]
      (io/make-parents o)
      (spit o (str (str/trimr head) "\n\n" (str/join "\n" loads) "\n")))))

(defn -main [cmd & args]
  (case cmd
    "plan" (apply plan args)
    "closure-scan" (apply closure-scan args)
    "closure-report" (apply closure-report args)
    "merge-forms" (apply merge-forms args)
    (fail "unknown command " cmd))
  (shutdown-agents)
  (System/exit 0))

;; bin/java-check's corpora (doc/classes/JAVA-CONFORMANCE-SURVEY.md, JCS2 (b), "As built: JC1"): named
;; selections of jdk26u's jtreg tests, read in place under jdk26u's test/ at the platform's pin
;; (jdk/javac/platform.sha256; the survey's §3), by area (path prefixes under test/, minus :exclude)
;; and category (the survey's §3.1, java.check/categorize): the plain runs of main, those with
;; @compile steps, and those whose only VM options are HotSpot's JIT, heap and logging options,
;; dropped (JCS10 (a)). jdk/java/awt and jdk/java/beans (java.desktop's, out of the Go build with
;; AWT and Swing, J2G-SPEC §12; JCS16 (b)) are excluded; and langtools' golden-diagnostics tests
;; (compile-fail-ref, the diagnostics level, JC3: run in place, javac's output against the golden file,
;; as jtreg compares them). The areas are under jdk26u's test/, or with :root :checkout the checkout's
;; paths (test/java/jls: Arbace's own hand-curated corpus, JCS2 (b), its programs' expected output
;; the JDK's run as for jdk26u's). A test's corpus is the first that takes it. Since JC6 (RPS7 (a),
;; JCS10's categories) also the rest of jdk/ but its desktop parts (AWT, Swing, accessibility, image
;; I/O, printing, sound: java.desktop's, J2G-SPEC §12), :jdk-other, and hotspot/jtreg/runtime,
;; :hotspot-runtime ("As built: JC6"). Read with the Clojure reader (java.check/scan).
{:corpora
 [{:id :jdk-run
   :areas ["jdk/java/"]
   :exclude ["jdk/java/awt/" "jdk/java/beans/"]
   :categories [:run-plain :run-compile :run-jitopts]}
  {:id :jdk-other
   :areas ["jdk/build/" "jdk/com/" "jdk/demo/" "jdk/javax/" "jdk/jdk/" "jdk/jni/" "jdk/lib/"
           "jdk/native_sanity/" "jdk/performance/" "jdk/sanity/" "jdk/security/" "jdk/sun/" "jdk/tools/"]
   :exclude ["jdk/javax/accessibility/" "jdk/javax/imageio/" "jdk/javax/print/" "jdk/javax/sound/"
             "jdk/javax/swing/" "jdk/sun/awt/" "jdk/sun/java2d/" "jdk/com/sun/java/swing/"
             "jdk/sanity/client/" "jdk/lib/client/"]
   :categories [:run-plain :run-compile :run-jitopts]}
  {:id :langtools-run
   :areas ["langtools/tools/javac/"]
   :categories [:run-plain :run-compile :run-jitopts]}
  {:id :hotspot-compiler
   :areas ["hotspot/jtreg/compiler/"]
   :categories [:run-plain :run-compile :run-jitopts]}
  {:id :hotspot-runtime
   :areas ["hotspot/jtreg/runtime/"]
   :categories [:run-plain :run-compile :run-jitopts]}
  {:id :langtools-diagnostics
   :areas ["langtools/"]
   :categories [:compile-fail-ref]}
  {:id :jls
   :root :checkout
   :areas ["test/java/jls/"]
   :categories [:run-plain :run-compile]}]}

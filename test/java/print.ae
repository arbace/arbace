(ns java.print
  "bin/java-check's print level (doc/FULL-SUPPORT-SURVEY.md, \"As built: REAP5\"; RPS9 (a)): the data
  side of repr/java's printer over the conformance corpus, on the tools' host beside java.check.
  bin/java-check runs the processes (repr/java's reads and javac on Arbace on javac's tool
  executable); this namespace prints the forms and judges what the processes left:

    print WORK LIST INDEX
        each test of LIST (ids, one a line) whose read passed (WORK/run/ID/forms.dir, its forms F1)
        printed by arbace.repr.java.print, the lines layout, into WORK/run/ID/print/lines, and its
        forms of mode :full (WORK/run/ID/full.dir, bin/repr-java read --full) in the full layout
        into WORK/run/ID/print/full; INDEX (jdk/forms) loaded once, the declarations the printer
        consults (bin/repr-java print --index); per test WORK/run/ID/print/print.tsv (pass, or fail
        and the first file's failure)
    judge WORK LIST
        each test's print result from its steps, in order (the first that does not pass is the
        result, the others named after it, \"(also: ...)\"):
          print    the printer printed every file (print.tsv)
          javac    javac on Arbace accepts the printed Java (print/javac.exit, javac.err1)
          forms    the printed Java read again (print/f2.dir: F2) holds F1's forms, as data,
                   metadata included (arbace.repr.java.roundtrip/compare-forms: the ae files'
                   text after their first line, else their forms)
          text     mode :full printed back is the renamed source, byte for byte, file by file
          classes  javac on Arbace's class files of the printed Java (-g:none) against the
                   original's (print/classes.res: pass, or differ with the two trees), the
                   differing class files' code compared instruction by instruction (Arbace's own
                   reading, after jrt.classfile) and the differences named as bin/repr-java
                   roundtrip names them (arbace.repr.java.roundtrip/class-differences): a value's
                   control flow, an increment's place, a local's initializer, a switch's arms
          a test whose only step not passing is classes, by class-kinds alone, passes (JCV11 (b)): the
          classes step is a sub-level, its reason kept as the pass's note (classes-note?)
        prints ID<TAB>print<TAB>RESULT<TAB>REASON per test, and the steps' counts on stderr; and for each
        negative control whose subject a test is (its plan's control-print CID REF; GTS84 (a),
        test/java/controls.edn) the control's row: forms, text and classes crossed against REF's
        original, differ only when each differs (control-steps, control-row)
    rejudge FILE
        a recorded print level re-judged by JCV11 (b)'s rule, from the record alone (rejudge)"
  (:require [arbace.string :as str]
            [arbace.java.io :as io]
            [arbace.repr.java.print :as pr]
            [arbace.repr.java.roundtrip :as rt]
            [jrt.classfile])
  (:import (java.io File)))

;; ---------------------------------------------------------------------------------------------
;; files

(defn- lines [f] (let [f (io/file f)] (if (.isFile f) (vec (remove str/blank? (str/split-lines (slurp f)))) [])))
(defn- slurp1 [f] (let [f (io/file f)] (when (.isFile f) (str/trim (slurp f)))))
(defn- one-line [s n] (let [s (str/replace (str s) #"[\t\r\n]+" " ")] (if (> (count s) n) (subs s 0 n) s)))

(defn- files-under
  "The relative paths of the files under dir whose names end with ext, sorted."
  [dir ext]
  (let [base (io/file dir)]
    (if (.isDirectory base)
      (sort (for [^File f (file-seq base)
                  :when (and (.isFile f) (str/ends-with? (.getName f) ext))]
              (str (.relativize (.toPath base) (.toPath f)))))
      [])))

(defn- bytes-of ^bytes [f] (java.nio.file.Files/readAllBytes (.toPath (io/file f))))

;; ---------------------------------------------------------------------------------------------
;; print

(defn- print-units
  "Prints units into out in the layout (\"lines\" or \"full\"), the index's declarations and
  packages beside the units' own (as bin/repr-java print --index does, the index's declared once);
  nil, or [path message] of the first unit that fails."
  [{:keys [pk decls]} units out layout]
  (let [pk (merge-with into pk (pr/package-classes units))]
    (binding [pr/*pkg-classes* pk
              pr/*decls* (merge decls (binding [pr/*pkg-classes* pk] (pr/declare-units units)))]
      (some (fn [u]
              (try
                (let [text (if (and (= "full" layout) (or (:java/file (meta (first (:forms u)))) (:file-record u)))
                             (pr/java-text-full u)
                             (pr/java-text u))
                      o (io/file out (pr/out-path u))]
                  (io/make-parents o)
                  (spit o text)
                  nil)
                (catch Throwable t
                  [(:path u) (str (.getName (class t)) ": " (.getMessage t))])))
            units))))

(defn print-tests [work list index]
  (let [t0 (System/nanoTime)
        iu (pr/load-units [index])
        ipk (pr/package-classes iu)
        idx {:pk ipk :decls (binding [pr/*pkg-classes* ipk] (pr/declare-units iu))}
        ids (lines list)
        rs (doall
            (pmap (fn [id]
                    (let [p (str work "/run/" id)
                          f1 (slurp1 (str p "/forms.dir"))
                          ff (slurp1 (str p "/full.dir"))
                          out (str p "/print")
                          r (cond
                              (nil? f1) nil
                              :else
                              (let [load (fn [d] (try (pr/load-units [d])
                                                      (catch Throwable t [:unread (str d ": " (.getName (class t)) ": " (.getMessage t))])))
                                    run (fn [d dir layout]
                                          (let [us (load d)]
                                            (if (= :unread (first us))
                                              [(str "the forms not read: " (second us)) ""]
                                              (print-units idx us dir layout))))
                                    e1 (run f1 (str out "/lines") "lines")
                                    e2 (when (and (nil? e1) ff) (run ff (str out "/full") "full"))]
                                (cond e1 (str "fail\tthe lines layout: " (one-line (str (first e1) ": " (second e1)) 300))
                                      e2 (str "fail\tthe full layout: " (one-line (str (first e2) ": " (second e2)) 300))
                                      :else "pass\t")))]
                      (when r
                        (io/make-parents (io/file out "print.tsv"))
                        (spit (str out "/print.tsv") (str r "\n")))
                      r))
                  ids))]
    (println (str "java-print print: " (count (remove nil? rs)) " tests printed (" (count (filter #(and % (str/starts-with? % "fail")) rs))
                  " failed), the index " index " (" (count iu) " files), "
                  (format "%.1f" (/ (- (System/nanoTime) t0) 1e9)) " s"))))

;; ---------------------------------------------------------------------------------------------
;; class files: each method's code as lines, instruction by instruction

(def ^:private read-pool @#'jrt.classfile/read-pool)
(def ^:private attributes @#'jrt.classfile/attributes)
(def ^:private skip-members @#'jrt.classfile/skip-members)
(def ^:private insn-length @#'jrt.classfile/insn-length)
(def ^:private member-ref @#'jrt.classfile/member-ref)
(def ^:private constant @#'jrt.classfile/constant)
(def ^:private bootstrap-methods @#'jrt.classfile/bootstrap-methods)

(defn- u1 ^long [^bytes b ^long i] (bit-and (long (aget b i)) 0xff))
(defn- u2 ^long [^bytes b ^long i] (bit-or (bit-shift-left (u1 b i) 8) (u1 b (inc i))))
(defn- s2 ^long [^bytes b ^long i] (long (unchecked-short (u2 b i))))
(defn- s4 ^long [^bytes b ^long i] (long (unchecked-int (bit-or (bit-shift-left (u2 b i) 16) (u2 b (+ i 2))))))

(def ^:private mnemonics
  "JVMS 6.5's mnemonics by opcode (0x00-0xc9)."
  (let [n4 (fn [p] (map #(str p "_" %) (range 4)))]
    (vec (concat
          ["nop" "aconst_null" "iconst_m1" "iconst_0" "iconst_1" "iconst_2" "iconst_3" "iconst_4" "iconst_5"
           "lconst_0" "lconst_1" "fconst_0" "fconst_1" "fconst_2" "dconst_0" "dconst_1" "bipush" "sipush"
           "ldc" "ldc_w" "ldc2_w" "iload" "lload" "fload" "dload" "aload"]
          (mapcat n4 ["iload" "lload" "fload" "dload" "aload"])
          ["iaload" "laload" "faload" "daload" "aaload" "baload" "caload" "saload"
           "istore" "lstore" "fstore" "dstore" "astore"]
          (mapcat n4 ["istore" "lstore" "fstore" "dstore" "astore"])
          ["iastore" "lastore" "fastore" "dastore" "aastore" "bastore" "castore" "sastore"
           "pop" "pop2" "dup" "dup_x1" "dup_x2" "dup2" "dup2_x1" "dup2_x2" "swap"
           "iadd" "ladd" "fadd" "dadd" "isub" "lsub" "fsub" "dsub" "imul" "lmul" "fmul" "dmul"
           "idiv" "ldiv" "fdiv" "ddiv" "irem" "lrem" "frem" "drem" "ineg" "lneg" "fneg" "dneg"
           "ishl" "lshl" "ishr" "lshr" "iushr" "lushr" "iand" "land" "ior" "lor" "ixor" "lxor" "iinc"
           "i2l" "i2f" "i2d" "l2i" "l2f" "l2d" "f2i" "f2l" "f2d" "d2i" "d2l" "d2f" "i2b" "i2c" "i2s"
           "lcmp" "fcmpl" "fcmpg" "dcmpl" "dcmpg" "ifeq" "ifne" "iflt" "ifge" "ifgt" "ifle"
           "if_icmpeq" "if_icmpne" "if_icmplt" "if_icmpge" "if_icmpgt" "if_icmple" "if_acmpeq" "if_acmpne"
           "goto" "jsr" "ret" "tableswitch" "lookupswitch" "ireturn" "lreturn" "freturn" "dreturn" "areturn" "return"
           "getstatic" "putstatic" "getfield" "putfield" "invokevirtual" "invokespecial" "invokestatic"
           "invokeinterface" "invokedynamic" "new" "newarray" "anewarray" "arraylength" "athrow" "checkcast"
           "instanceof" "monitorenter" "monitorexit" "wide" "multianewarray" "ifnull" "ifnonnull" "goto_w" "jsr_w"]))))

(defn- operand
  "The instruction at pc's operands as text (javap's, the constant pool's indices resolved)."
  [pool bsms ^bytes b ^long c0 ^long pc ^long op]
  (let [cref (fn [k] (pr-str (constant pool bsms k)))
        mref (fn [k] (let [{:keys [owner name desc]} (member-ref pool k)] (str owner "." name ":" desc)))
        cls (fn [k] (let [[_ n] (nth pool k)] (second (nth pool n))))]
    (cond
      (#{0x15 0x16 0x17 0x18 0x19 0x36 0x37 0x38 0x39 0x3a 0xa9} op) (str (u1 b (+ c0 pc 1)))
      (= op 0x10) (str (unchecked-byte (u1 b (+ c0 pc 1))))
      (= op 0x11) (str (s2 b (+ c0 pc 1)))
      (= op 0x12) (cref (u1 b (+ c0 pc 1)))
      (#{0x13 0x14} op) (cref (u2 b (+ c0 pc 1)))
      (= op 0x84) (str (u1 b (+ c0 pc 1)) " " (unchecked-byte (u1 b (+ c0 pc 2))))
      (or (<= 0x99 op 0xa8) (#{0xc6 0xc7} op)) (str "L" (+ pc (s2 b (+ c0 pc 1))))
      (#{0xc8 0xc9} op) (str "L" (+ pc (s4 b (+ c0 pc 1))))
      (<= 0xb2 op 0xb9) (mref (u2 b (+ c0 pc 1)))
      (= op 0xba) (let [[_ bi nat] (nth pool (u2 b (+ c0 pc 1)))
                        [_ n d] (nth pool nat)]
                    (str bi " " (second (nth pool n)) ":" (second (nth pool d))))
      (#{0xbb 0xbd 0xc0 0xc1} op) (cls (u2 b (+ c0 pc 1)))
      (= op 0xc5) (str (cls (u2 b (+ c0 pc 1))) " " (u1 b (+ c0 pc 3)))
      (= op 0xbc) (str (u1 b (+ c0 pc 1)))
      (#{0xaa 0xab} op)
      (let [p (+ pc 1 (mod (- 3 pc) 4))
            dflt (+ pc (s4 b (+ c0 p)))]
        (if (= op 0xaa)
          (let [lo (s4 b (+ c0 p 4)) hi (s4 b (+ c0 p 8))]
            (str "default L" dflt " " (str/join " " (for [k (range (inc (- hi lo)))]
                                                      (str (+ lo k) ":L" (+ pc (s4 b (+ c0 p 12 (* 4 k)))))))))
          (let [n (s4 b (+ c0 p 4))]
            (str "default L" dflt " " (str/join " " (for [k (range n)]
                                                      (str (s4 b (+ c0 p 8 (* 8 k))) ":L" (+ pc (s4 b (+ c0 p 12 (* 8 k)))))))))))
      (= op 0xc4) (let [op2 (u1 b (+ c0 pc 1))]
                    (str (get mnemonics op2 op2) " " (u2 b (+ c0 pc 2))
                         (when (= op2 0x84) (str " " (s2 b (+ c0 pc 4))))))
      :else "")))

(defn- code-lines
  "The class file's methods' code as lines \"NAME DESC: MNEMONIC OPERANDS\" (javap -c's, without the
  instructions' offsets and with the constant pool resolved), in the methods' order."
  [f]
  (let [b (bytes-of f)
        [pool i] (read-pool b)
        ni (u2 b (+ i 6))
        [_ i] (skip-members pool b (+ i 8 (* 2 ni)))
        [methods i] (skip-members pool b i)
        [cattrs _] (attributes pool b i)
        bsms (bootstrap-methods pool b cattrs)]
    (vec (for [j methods
               :let [nm (second (nth pool (u2 b (+ j 2))))
                     desc (second (nth pool (u2 b (+ j 4))))
                     [attrs _] (attributes pool b (+ j 6))
                     [c _] (get attrs "Code")]
               :when c
               :let [len (bit-or (bit-shift-left (u2 b (+ c 4)) 16) (u2 b (+ c 6)))
                     c0 (+ c 8)]
               line (loop [pc 0 out []]
                      (if (>= pc len)
                        out
                        (let [op (u1 b (+ c0 pc))]
                          (recur (+ pc (insn-length b c0 pc))
                                 (conj out (str nm " " desc ": " (get mnemonics op (str "op" op)) " "
                                                (operand pool bsms b c0 pc op)))))))]
           line))))

(def ^:private kind-flow "a value's control flow: ?: or a switch expression on one side, if or a switch statement on the other")
(def ^:private kind-inc "an increment's place (i++ in an expression or as a statement)")
(def ^:private kind-init "a local's initializer (Java's default value written or not)")
;; the user's RP1 (a) and RP2 (a) (2026-11-17, round 51; doc/classes/JAVA-DEFERRED-TRIAGE.md, "As built: h-java-readprint")
(def ^:private kind-qual "a static member's pure qualifier (a local, this or a literal, evaluated and dropped, or not written)")
(def ^:private kind-compound "a compound assignment written out or not (s = s + x against s += x)")
(def ^:private kind-owner "a static member's owner (named through the class that inherits it or the class that declares it)")
;; the user's 538-2 (a) (2026-11-24, queue 556b): a switch's case-group locals, one scope (a colon switch's block) or
;; each arm's (the printed arrows'), numbered from other slots
(def ^:private kind-slot "a local's slot (a switch's case-group locals in one scope or in each arm's)")
;; queue 610 (2026-11-27; JCV11 (b): the forms do not record them): an early exit out of a try with a finally or resources
;; (if (c) { s; return; } rest), which the converter folds into the if's arms ((if c (do s) (do rest)), the same forms as the
;; if/else's), javac inlining the finally's code at the exit; and javac's lambda deduplication, of bodies the source spelled
;; apart where the forms do not (this, C.this or implicit; a class named with or without its package; a void lambda's return;)
(def ^:private kind-exit "an early exit's finally code (a return or a jump out of a try with a finally or resources, the finally inlined at it, or the if's arms)")
(def ^:private kind-dedup "a lambda deduplicated (javac's equal lambda bodies, the source's spellings apart: this, C.this or implicit, a qualifier)")

(def ^:private code-norm
  "A code line's instruction as counted: a branch without its target, ldc_w as ldc (the constant's index, the constant
  pool's order)."
  (fn [l] (-> l (str/replace #": (if[a-z_]*|goto|goto_w) L\d+$" ": $1") (str/replace #": ldc_w " ": ldc "))))

(defn- line-method [l] (second (re-find #"^(.*?): " l)))

(defn- exit-copies
  "queue 610: the code lines a and b with the copies of a finally block at an early exit taken out of the side that has
  them: in a method, a run of a's (or b's) lines just before a return or a goto, each of its instructions one the side has
  more of (counted as code-norm counts them), at least two, the run's instructions (code-norm's, in order) also met as a run
  in the other side's same method (the finally's copy on its normal path). [a' b' found?]."
  [a b]
  (let [strip (fn [side other]
                (let [ms (group-by line-method side) mo (group-by line-method other)]
                  (reduce
                   (fn [[out found?] m]
                     (let [ls (vec (get ms m)) lo (mapv code-norm (get mo m))
                           extra (volatile! (merge-with + (frequencies (map code-norm ls))
                                                         (update-vals (frequencies lo) -)))
                           ;; twice: the finally's copies on the normal path and in the handler of every exception
                           occurs? (fn [r] (let [n (count r)]
                                             (<= 2 (count (filter #(= r (subvec lo % (+ % n))) (range 0 (inc (- (count lo) n))))))))
                           drop-idx (volatile! #{})]
                       (doseq [r (range (count ls))
                               :when (re-find #": ([ailfd]?return|goto|goto_w) ?$" (code-norm (ls r)))]
                         ;; the longest run back from r whose lines are all extra
                         (let [s0 (loop [s r e @extra]
                                    (let [k (when (pos? s) (code-norm (ls (dec s))))]
                                      (if (and k (pos? (get e k 0)) (not (@drop-idx (dec s))))
                                        (recur (dec s) (update e k dec))
                                        s)))
                               hit (some (fn [s] (let [run (mapv code-norm (subvec ls s r))]
                                                   (when (occurs? run) s)))
                                         (range s0 (dec r)))]
                           (when hit
                             (doseq [i (range hit r)]
                               (vswap! extra update (code-norm (ls i)) dec)
                               (vswap! drop-idx conj i)))))
                       [(into out (keep-indexed (fn [i l] (when-not (@drop-idx i) l)) ls))
                        (or found? (boolean (seq @drop-idx)))]))
                   [[] false]
                   (distinct (map line-method side)))))
        [a' fa] (strip a b)
        [b' fb] (strip b a)]
    [a' b' (or fa fb)]))

(defn- slots-only?
  "538-2 (a): whether the code lines a and b differ by their locals' slots alone, in methods with a switch: the
  same number of lines, each pair equal but for the slot of a load, store or iinc (aload_1 read as aload 1) and
  the branches' and the switches' targets, at least one slot differing, and each method's slots mapped as a
  function from a's to b's (one original slot one printed slot; the arms' locals may share one printed slot)."
  [a b]
  (let [slot-re #"^(.*: )((?:wide )?(?:[ailfd](?:load|store)|iinc))[ _](\d+)(.*)$"
        untarget (fn [l] (str/replace l #"L\d+" "L"))
        parts (fn [l] (when-let [[_ m op n more] (re-matches slot-re l)] [m op (parse-long n) more]))
        method (fn [l] (second (re-find #"^(.*?): " l)))]
    (and (= (count a) (count b))
         (let [pairs (map vector a b)
               diffs (remove (fn [[x y]] (= (untarget x) (untarget y))) pairs)
               ps (map (fn [[x y]] [(parts x) (parts y)]) diffs)]
           (and (seq diffs)
                (every? (fn [[px py]] (and px py (= (px 0) (py 0)) (= (str/replace (px 1) #"_" " ") (str/replace (py 1) #"_" " "))
                                             (= (px 3) (py 3)) (not= (px 2) (py 2))))
                        ps)
                ;; each method's slot map a function, over all its slot lines (the unchanged too)
                (every? (fn [[_ ls]] (every? (fn [[_ ys]] (= 1 (count (distinct (map (comp second second) ys)))))
                                             (group-by (comp first second) ls)))
                        (group-by (fn [[m _]] m)
                                  (for [[x y] pairs :let [px (parts x) py (parts y)] :when (and px py)]
                                    [(px 0) [(px 2) (py 2)]])))
                (let [ms (set (map (comp method first) diffs))]
                  (every? (fn [m] (some #(and (= m (method %)) (re-find #": (tableswitch|lookupswitch) " %)) a)) ms)))))))

(defn- counted-kinds
  "h-java-readprint (2026-11-17): the kinds of the differences of the method code lines a and b counted, each
  instruction as often as it occurs, a branch without its target (an early return's `return` or a loop's `goto`
  also met elsewhere in the method is a difference, which the sets of lines do not see): the kinds when every
  instruction that differs in number is one of a named kind's, else nil. The instructions of each kind: control
  flow, the branches, goto and the returns, when a goto or a return differs or only conditional branches do (a test's
  sense and its arms swapped); an increment, iinc (also wide) and the
  int arithmetic of i = i + n, when an iinc differs; a local's initializer, a default value's constant and a local's
  store, when such a constant differs; RP1 (a), a static member's pure qualifier, the original's extra pop with the loads,
  constants and static reads it pops; RP2 (a), a compound assignment, aload against dup alone, and a static member's owner, an
  invokestatic, getstatic or putstatic of the same member through another class. None differing: the order of the code."
  [a b]
  (let [[a b exit?] (exit-copies a b)
        norm code-norm
        ;; queue 610: ldc against ldc_w alone is the constant pool's order
        cp? (let [n0 (fn [l] (str/replace l #": (if[a-z_]*|goto|goto_w) L\d+$" ": $1"))
                  c (fn [f] (count (filter (fn [[_ n]] (not= 0 n)) (merge-with + (frequencies (map f a)) (update-vals (frequencies (map f b)) -)))))]
              (not= (c n0) (c norm)))
        unowned (fn [l] (str/replace l #": (invokestatic|getstatic|putstatic) [^ .]+\.([^.: ]+:[^ ]+)$" ": $1 $2"))
        diff (fn [f] (let [fa (frequencies (map f a)) fb (frequencies (map f b))]
                       (vec (for [k (distinct (concat (keys fa) (keys fb)))
                                  :let [na (get fa k 0) nb (get fb k 0)]
                                  :when (not= na nb)]
                              [(str/trim (second (re-find #": (.*)$" k))) (- na nb)]))))
        d1 (diff norm)
        d2 (diff (comp unowned norm))
        owner? (< (count d2) (count d1))
        dn (if owner? d2 d1)
        ds (mapv first dn)
        more (into {} dn)
        has (fn [re] (some #(re-find re %) ds))
        ;; RP1 (a): the original evaluates a pure qualifier and pops it (more pops on the original's side)
        qual? (pos? (get more "pop" 0))
        ;; the receiver read again or dup'ed: a local (aload), or an inner class's outer instance (aload, getfield
        ;; this$N; 538-4 (a), queue 556c)
        compound? (and (some #{"dup"} ds) (every? #(re-find #"^(dup|aload(_\d| \d+)|getfield \S+\.this\$\d+:\S+)$" %) ds))
        branch? (fn [i] (re-find #"^if[a-z_]*$" i))
        inc? (has #"^(wide )?iinc ")
        init? (has #"^([ailfd]const_0|aconst_null)$")
        ;; queue 610: a local assigned in each arm of an if against once from a ?: (the converter folds the if's
        ;; assignments into the local's initializer, SPEC §5.3: the forms are the same), its stores alone differing,
        ;; all on one side
        store-re #"^[ailfd]store(_\d| \d+)$"
        stores (filter #(re-find store-re %) ds)
        ;; (not a local's initializer's store, which its constant names)
        arm-store? (and (not init?) (seq stores) (or (every? #(pos? (more %)) stores) (every? #(neg? (more %)) stores)))
        ;; RP2 (a)'s compound assignment on an array's element: dup2 against the array and the index read again
        acompound? (some #{"dup2"} ds)
        other-ok? (fn [i] (or (and arm-store? (re-find store-re i))
                        (and acompound? (re-find #"^(dup2|aload(_\d| \d+)|getstatic \S+:\[\S*|getfield \S+:\[\S*|iload(_\d| \d+)|iconst_m?\d|bipush .*|sipush .*)$" i)) (and inc? (re-find #"^((wide )?iinc .*|iload(_\d| \d+)|istore(_\d| \d+)|iadd|isub|iconst_m?\d|bipush .*|sipush .*)$" i))
                        (and init? (re-find #"^([ailfd]const_0|aconst_null|[ailfd]store(_\d| \d+))$" i))
                        (and qual? (re-find #"^(pop|[ailfd]load(_\d| \d+)|ldc.*|ldc_w .*|ldc2_w .*|getstatic .*|[il]const_\d|bipush .*|sipush .*)$" i))
                        (and compound? (re-find #"^(dup|aload(_\d| \d+)|getfield \S+\.this\$\d+:\S+)$" i))))
        ;; a goto or a return differing, or conditional branches alone beside the other kinds' instructions
        flow? (or (has #"^(goto|goto_w|[ailfd]?return)$")
                  (and (some branch? ds) (every? #(or (branch? %) (other-ok? %)) ds))
                  arm-store?)
        ;; queue 610: with the control flow, a value boxed once after a ?: or in each arm of an if
        ok? (fn [i] (or (and flow? (re-find #"^(if[a-z_]*|goto|goto_w|[ailfd]?return|invokestatic java/lang/(Integer|Long|Short|Byte|Character|Boolean|Float|Double)\.valueOf:\S+)$" i))
                        (other-ok? i)))
        more-kinds (fn [ks] (cond-> ks exit? (conj kind-exit) cp? (conj "the constant pool's order or an attribute (the same code)")))]
    (cond
      (and (empty? ds) owner?) (more-kinds [kind-owner])
      (and (empty? ds) (or exit? cp?)) (more-kinds [])
      (empty? ds) ["the order of the code (the same instructions)"]
      (every? ok? ds) (more-kinds
                        (cond-> [] flow? (conj kind-flow) inc? (conj kind-inc) init? (conj kind-init)
                          qual? (conj kind-qual) (or compound? acompound?) (conj kind-compound) owner? (conj kind-owner)))
      ;; the user's 538-4 (a) (2026-11-24, queue 556b): RP2 (a)'s compound assignment through an inner class's accessor,
      ;; the accessors' access$N numbered alike: the written-out side reads the outer instance (aload, getfield
      ;; this$N) and calls the getter and adds or subtracts beside the setter, the compound side's one accessor
      ;; does the arithmetic (the outer instance dup'ed), or the accessors only renumbered
      (let [acc (fn [l] (str/replace l #"access\$\d+" (fn [_] "access$N")))
            ;; the accessors' own bodies follow their callers (a getter and a setter, or one accessor doing the
            ;; arithmetic, queue 556c): their lines are left out, the callers judged
            body? #(re-find #"^access\$\d+ \(" %)
            fq (fn [ls] (frequencies (map (comp acc norm) (remove body? ls))))
            fa (fq a) fb (fq b)
            da (vec (for [k (distinct (concat (keys fa) (keys fb)))
                          :let [na (get fa k 0) nb (get fb k 0)]
                          :when (not= na nb)]
                      [(str/trim (second (re-find #": (.*)$" k))) (- na nb)]))
            as (mapv first da)
            accessor? #(re-find #"^invokestatic \S+\.access\$N:\S+$" %)]
        (and (not= (count da) (count d1))
             (every? #(re-find #"^(dup|aload(_\d| \d+)|getfield \S+\.this\$\d+:\S+|invokestatic \S+\.access\$N:\S+|[il](add|sub))$" %) as)
             (or (empty? as) (some accessor? as)
                 ;; or the accessors themselves differ (renumbered, or their bodies)
                 (some #(re-find #"access\$\d+" %) (concat (remove (set b) a) (remove (set a) b))))))
      [kind-compound]
      (slots-only? a b) [kind-slot])))

(defn- lambda-dedup
  "queue 610: the code lines a and b with javac's deduplicated lambdas taken out: a lambda method (lambda$...) of one side
  only whose code is that of another lambda method of the same descriptor which both sides have, the call sites'
  bootstrap indices (invokedynamic N) then not compared. [a' b' found?]."
  [a b]
  (let [ma (group-by line-method a) mb (group-by line-method b)
        body (fn [ls] (mapv #(subs % (count (line-method %))) ls))
        desc (fn [m] (second (re-find #" (\S+)$" m)))
        gone (fn [ms mo]
               (set (for [[m ls] ms
                          :when (and (str/starts-with? m "lambda$") (not (contains? mo m)))
                          :when (some (fn [[m2 ls2]] (and (not= m m2) (str/starts-with? m2 "lambda$") (contains? mo m2)
                                                          (= (desc m) (desc m2)) (= (body ls) (body ls2))))
                                      ms)]
                      m)))
        ga (gone ma mb) gb (gone mb ma)]
    (if (and (empty? ga) (empty? gb))
      [a b false]
      (let [idx (fn [l] (str/replace l #": invokedynamic \d+ " ": invokedynamic N "))
            keep (fn [ls g] (mapv idx (remove #(g (line-method %)) ls)))]
        [(keep a ga) (keep b gb) true]))))

(defn class-differences
  "Short reasons for the differences of class file c in the trees c1 and c2, named as
  arbace.repr.java.roundtrip/class-differences names javap's; where the lines' sets name none, the lines
  counted (counted-kinds) name them when they explain every instruction that differs."
  [c1 c2 c]
  (let [a (code-lines (io/file c1 c)) b (code-lines (io/file c2 c))
        [a b dedup?] (lambda-dedup a b)]
    (cond
      (and dedup? (= a b)) [kind-dedup]
      (= a b) ["the constant pool's order or an attribute (the same code)"]
      :else
      (let [ds (set (remove str/blank? (concat (remove (set b) a) (remove (set a) b))))
            has (fn [re] (some #(re-find re %) ds))]
        (vec (distinct (cond-> []
          ;; 556b-1 (a) (the main session, 2026-11-24): a differing goto or return line names the control flow only by
          ;; counting (counted-kinds: every differing instruction a flow instruction or another named kind's), unless a
          ;; switch's arms differ (fall-through repeated: any instruction); else the code difference is unnamed
          (and (has #": (goto|goto_w|[ailfd]?return) ") (not (has #": (lookupswitch|tableswitch) ")))
          (into (or (counted-kinds a b)
                    ;; the unnamed difference shown by a line of no flow instruction where there is one
                    (let [nf (remove #(re-find #": (if[a-z_]*|goto|goto_w|[ailfd]?return) ?" %) (sort ds))]
                      [(str "code: " (str/trim (first (or (seq nf) (sort ds)))))])))
          (and (has #": (goto|goto_w|[ailfd]?return) ") (has #": (lookupswitch|tableswitch) ")) (conj kind-flow)
          (has #": iinc ") (conj kind-inc)
          (has #": ([ail]const_0|aconst_null|lconst_0|fconst_0|dconst_0) ") (conj kind-init)
          (has #": (lookupswitch|tableswitch) ") (conj "a switch's arms (fall-through repeated)")
          true (#(if (empty? %)
                   (or (when (seq ds) (counted-kinds a b))
                       [(if (seq ds) (str "code: " (str/trim (first (sort ds)))) "the order of the code (the same instructions)")])
                   %))
          dedup? (conj kind-dedup))))))))

(def class-kinds
  "The class-file differences class-differences names (the forms do not record what they differ by: JCV11 (b))."
  #{"a value's control flow: ?: or a switch expression on one side, if or a switch statement on the other"
    "an increment's place (i++ in an expression or as a statement)"
    "a local's initializer (Java's default value written or not)"
    "a switch's arms (fall-through repeated)"
    "the constant pool's order or an attribute (the same code)"
    "the order of the code (the same instructions)"
    "a static member's pure qualifier (a local, this or a literal, evaluated and dropped, or not written)"
    "a compound assignment written out or not (s = s + x against s += x)"
    "a static member's owner (named through the class that inherits it or the class that declares it)"
    "a local's slot (a switch's case-group locals in one scope or in each arm's)"
    kind-exit kind-dedup})

(defn classes-note?
  "JCV11 (b) (the user, 2026-11-08; RPS9 (a) reopened): whether the classes step's reason WHY is a sub-level note,
  not a non-pass: every class file the original's (none on one side only), each differing one's differences all
  class-kinds. The print level then passes on the round trip's own checks (print, javac, forms, text), the class
  files reported beside it; an unnamed code difference, an unread class file or a class file of one side only
  stays a non-pass (:print-classes-unnamed)."
  [why]
  (boolean
    (when-let [[_ ks] (re-matches #"classes: \d+ of \d+ class files differ: (.*) \([^()]*\)" (str why))]
      (every? class-kinds (str/split ks #"; ")))))

(defn- classes-result
  "pass, or differ and the reason: the class trees c1 (the original's) and c2 (the printed Java's)."
  [c1 c2]
  (let [a (set (files-under c1 ".class")) b (set (files-under c2 ".class"))]
    (cond
      (not= a b) (str "differ\tclasses: " (count (remove b a)) " class files only in the original's ("
                      (str/join " " (take 3 (sort (remove b a)))) "), " (count (remove a b)) " only in the printed Java's ("
                      (str/join " " (take 3 (sort (remove a b)))) ")")
      :else (let [bad (sort (remove #(java.util.Arrays/equals (bytes-of (io/file c1 %)) (bytes-of (io/file c2 %))) a))]
              (if (empty? bad)
                "pass\t"
                (str "differ\tclasses: " (count bad) " of " (count a) " class files differ: "
                     (str/join "; " (distinct (mapcat #(try (class-differences c1 c2 %)
                                                            (catch Throwable t [(str "unread: " (.getMessage t))]))
                                                      bad)))
                     " (" (str/join " " (take 3 bad)) ")"))))))

;; ---------------------------------------------------------------------------------------------
;; judge

(defn- text-result
  "pass, or differ and the first file whose full layout's print (under out) is not the renamed source (under
  src)."
  [src out]
  (let [orig (files-under src ".java") printed (set (files-under out ".java"))
        missing (remove printed orig)
        bad (filter #(and (printed %) (not (java.util.Arrays/equals (bytes-of (io/file src %)) (bytes-of (io/file out %))))) orig)]
    (cond
      (seq missing) (str "differ\ttext: " (count missing) " of " (count orig) " files not printed (" (first missing) ")")
      (seq bad) (let [f (first bad)
                      la (str/split-lines (slurp (io/file src f))) lb (str/split-lines (slurp (io/file out f)))
                      n (or (first (keep-indexed (fn [i [x y]] (when (not= x y) i)) (map vector la lb)))
                            (min (count la) (count lb)))]
                  (str "differ\ttext: " (count bad) " of " (count orig) " files differ from the source, " f
                       " at line " (inc n) ": " (one-line (get lb n "nothing") 100) " (the source: " (one-line (get la n "nothing") 100) ")"))
      :else "pass\t")))

(defn- forms-result
  "pass, or differ and the first file whose forms F2 does not hold as F1's."
  [f1 f2]
  (let [rs (rt/compare-forms f1 f2)
        bad (filter (fn [[_ r]] (#{:fail :missing} (:forms r))) rs)]
    (if (empty? bad)
      "pass\t"
      (let [[path r] (first bad)]
        (str "differ\tforms: " (count bad) " of " (count rs) " files, " path " " (one-line (or (:why r) (name (:forms r))) 300))))))

(def ^:private steps [:print :javac :forms :text :classes])

(defn- test-steps
  "{step [RESULT REASON]} of a test's print level, nil for a step not taken."
  [work id]
  (let [p (str work "/run/" id)
        pp (str p "/print")
        split (fn [s] (let [[r why] (str/split s #"\t" 2)] [r (or why "")]))
        prt (some-> (slurp1 (str pp "/print.tsv")) split)
        full-err (slurp1 (str p "/full.err"))
        jx (slurp1 (str pp "/javac.exit"))
        f2 (slurp1 (str pp "/f2.dir"))
        f2-err (slurp1 (str pp "/f2.err"))
        cls (slurp1 (str pp "/classes.res"))]
    (cond-> {}
      prt (assoc :print prt)
      full-err (assoc :text ["fail" (str "text: the read --full failed: " full-err)])
      jx (assoc :javac (if (= jx "0") ["pass" ""] ["fail" (str "javac rejects the printed Java: " (or (slurp1 (str pp "/javac.err1")) (str "status " jx)))]))
      f2 (assoc :forms (split (forms-result (slurp1 (str p "/forms.dir")) f2)))
      (and (nil? f2) f2-err) (assoc :forms ["fail" (str "forms: the printed Java not read: " f2-err)])
      (and (= "pass" (first prt)) (nil? full-err) (.isDirectory (io/file pp "full"))) (assoc :text (split (text-result (str p "/src") (str pp "/full"))))
      cls (assoc :classes (if (= cls "pass") ["pass" ""] (split (classes-result (str pp "/c1") (str pp "/c2"))))))))

(defn- control-steps
  "GTS84 (a), test/java/controls.edn: a control's crossed steps, the subject id's print judged by the steps'
  own comparisons against its reference ref's original: forms (the subject's F2 against the reference's F1),
  text (the subject's full print against the reference's renamed source), classes (the subject's printed class
  files' digest against the reference's JDK digest, print/classes.res.CID; when it differs, the trees against
  the reference's printed class files, its original's as the reference passes); {step [RESULT REASON]}, a step
  whose subject's part is missing left out; :left when the reference's printed run is not there (not in the
  run: a selection)."
  [work id cid ref]
  (let [split (fn [s] (let [[r why] (str/split s #"\t" 2)] [r (or why "")]))
        p (str work "/run/" id) pp (str p "/print")
        rp (str work "/run/" ref) rpp (str rp "/print")
        f1 (slurp1 (str rp "/forms.dir")) f2 (slurp1 (str pp "/f2.dir"))
        cls (slurp1 (str pp "/classes.res." cid))]
    (if-not (and f1 (.isDirectory (io/file rp "src")) (.isDirectory (io/file rpp "c2")))
      :left
      (cond-> {}
        f2 (assoc :forms (split (forms-result f1 f2)))
        (.isDirectory (io/file pp "full")) (assoc :text (split (text-result (str rp "/src") (str pp "/full"))))
        cls (assoc :classes (if (= cls "pass") ["pass" ""] (split (classes-result (str rpp "/c2") (str pp "/c2")))))))))

(defn- control-row
  "A control's line ID print RESULT REASON from its crossed steps: differ when every step taken differs (each
  comparison told the two tests apart), pass naming the steps that passed (a judge that passes what differs),
  left (control-steps' :left), unjudged when no step was taken."
  [cid ref st]
  (cond
    (= :left st) (str cid "\tprint\tleft\tthe reference " ref "'s print is not in this run")
    (empty? st) (str cid "\tprint\tunjudged\tno crossed step taken")
    :else (let [ok (filter #(= "pass" (first (get st %))) (filter st steps))]
            (if (seq ok)
              (str cid "\tprint\tpass\tcrossed steps passed: " (str/join " " (map name ok)))
              (str cid "\tprint\tdiffer\t" (one-line (str/join "; " (for [s steps :when (st s)] (second (st s)))) 600))))))

(defn judge [work list]
  (let [ids (lines list)
        all (doall (pmap (fn [id] [id (test-steps work id)]) ids))
        counts (atom {})]
    ;; GTS84 (a): the controls whose subject a test of the list is (its plan's control-print CID REF lines)
    (doseq [id ids
            [k cid ref] (map #(str/split % #"\t") (lines (str work "/run/" id "/plan.tsv")))
            :when (= k "control-print")]
      (println (control-row cid ref (control-steps work id cid ref))))
    (doseq [[id st] all]
      (doseq [s steps :let [[r] (get st s)] :when r] (swap! counts update-in [s r] (fnil inc 0)))
      (let [bad0 (filter #(and (get st %) (not= "pass" (first (get st %)))) steps)
            ;; JCV11 (b): class files that differ only by class-kinds are the sub-level's note on a pass
            note (when (and (= [:classes] bad0) (classes-note? (second (get st :classes)))) (second (get st :classes)))
            bad (if note [] bad0)
            [r why] (if (seq bad) (get st (first bad)) ["pass" (or note "")])
            r (if (and (empty? bad) (not= (set steps) (set (keys st)))) "fail" r)
            why (if (and (empty? bad) (not= (set steps) (set (keys st))))
                  (str "steps not taken: " (str/join " " (map name (remove (set (keys st)) steps))))
                  why)
            also (rest bad)]
        (println (str id "\tprint\t" r "\t" (one-line why 600)
                      (when (seq also) (str " (also: " (str/join ", " (map name also)) ")"))))))
    (binding [*out* *err*]
      (println (str "java-print judge: " (count all) " tests; by step: "
                    (str/join "; " (for [s steps] (str (name s) " " (str/join ", " (for [[r n] (sort (get @counts s))] (str n " " r)))))))))))

(defn rejudge
  "JCV11 (b)'s re-judge of a recorded print level, FILE (test/java/check-print.edn): each row differ whose reason
  classes-note? takes becomes pass with that reason, the sub-level's note, as judge now writes it; the other rows
  as they are. Prints the counts. (A row whose reason the record cut at 600 characters stays as it is: the next
  whole run judges it from its steps.)"
  [file]
  (let [ls (str/split-lines (slurp file))
        n (atom 0)
        out (for [l ls]
              (if-let [[_ pre why] (re-matches #"( \[\"[^\"]+\" \"[^\"]+\" ):differ (\".*\")\]" l)]
                (let [w (read-string why)]
                  (if (classes-note? w)
                    (do (swap! n inc) (str pre ":pass " why "]"))
                    l))
                l))]
    (spit file (str (str/join "\n" out) "\n"))
    (println (str "java-print rejudge: " @n " rows differ -> pass (JCV11 (b)), " file))))

(defn -main [cmd & args]
  (case cmd
    "print" (apply print-tests args)
    "judge" (apply judge args)
    "rejudge" (apply rejudge args))
  (shutdown-agents)
  (System/exit 0))

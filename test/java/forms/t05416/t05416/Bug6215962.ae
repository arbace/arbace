  (method ^:static testDateFormatSymbols ^void []
    (let [dfs1 (DateFormatSymbols.)
          dfs2 (DateFormatSymbols.)]
      (Bug6215962/check dfs1 dfs2 true)
      (let [tmp (.getMonths dfs1)
            ^:mutable saved (aget tmp 0)]
        (aset tmp 0 "Foo")
        (.setMonths dfs1 tmp)
        (Bug6215962/check dfs1 dfs2 false)
        (aset tmp 0 saved)
        (.setMonths dfs1 tmp)
        (Bug6215962/check dfs1 dfs2 true)
        (let [pattern (.getLocalPatternChars dfs2)]
          (.setLocalPatternChars dfs2 "Bar")
          (Bug6215962/check dfs1 dfs2 false)
          (.setLocalPatternChars dfs2 pattern)
          (Bug6215962/check dfs1 dfs2 true)
          (let [zones (.getZoneStrings dfs1)]
            (set! saved (aget zones 0 1))
            (aset (aget zones 0) 1 "Yokohama Summer Time")
            (.setZoneStrings dfs1 zones)
            (Bug6215962/check dfs1 dfs2 false)
            (aset (aget zones 0) 1 saved)
            (.setZoneStrings dfs1 zones)
            (Bug6215962/check dfs1 dfs2 true))))))


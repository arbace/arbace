  (method ^:static test3 ^void []
    (loop [^int i 0]
      (when (< i (alength input))
        (let [sb (.reverse (StringBuilder. (aget input i)))]
          (Supplementary/check (not (.equals (aget golden3 i) (.toString sb)))
                               (java-str "reverse() for <"
                                         (Supplementary/toHexString (aget input i))
                                         ">")
                               sb
                               (aget golden3 i))
          (recur (unchecked-inc-int i)))))
    (loop [^int i 0]
      (when (< i (alength testdata1))
        (let [sb (.reverse (StringBuilder. (aget testdata1 i 0)))]
          (Supplementary/check (not (.equals (aget testdata1 i 1) (.toString sb)))
                               (java-str "reverse() for <"
                                         (Supplementary/toHexString (aget testdata1 i 0))
                                         ">")
                               sb
                               (aget testdata1 i 1))
          (recur (unchecked-inc-int i))))))

  (method ^:static test4 ^void []
    (loop [^int i 0]
      (when (< i (alength input))
        (let [s (aget input i)
              sb (StringBuilder.)
              ^:mutable ^int c 0]
          (loop [^int j 0]
            (when (< j (.length s))
              (set! c (.codePointAt s j))
              (let [rsb (.appendCodePoint sb c)]
                (Supplementary/check (not (identical? sb rsb))
                                     "appendCodePoint returned a wrong object")
                (let [sbc (.codePointAt sb j)]
                  (Supplementary/check (not (== sbc c))
                                       (java-str "appendCodePoint(" j ") != c")
                                       sbc
                                       c)
                  (recur (unchecked-add-int j (Character/charCount c)))))))
          (Supplementary/check (not (.equals s (.toString sb)))
                               (java-str "appendCodePoint() produced a wrong result with input["
                                         i
                                         "]"))
          (recur (unchecked-inc-int i)))))
    (Supplementary/testAppendCodePoint -1 IllegalArgumentException)
    (Supplementary/testAppendCodePoint (unchecked-add-int Character/MAX_CODE_POINT 1)
                                       IllegalArgumentException))


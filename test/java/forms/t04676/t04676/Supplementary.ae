  (method ^:static testDontReadOutOfBoundsTrailingSurrogate ^void []
    (let [sb (StringBuilder.)
          suppl Character/MIN_SUPPLEMENTARY_CODE_POINT]
      (.appendCodePoint sb suppl)
      (Supplementary/check (not (== (.codePointAt sb 0) suppl))
                           "codePointAt(0)"
                           (.codePointAt sb 0)
                           suppl)
      (Supplementary/check (not (== (.length sb) 2)) "sb.length()")
      (.setLength sb 1)
      (Supplementary/check (not (== (.length sb) 1)) "sb.length()")
      (Supplementary/check (not (== (.codePointAt sb 0) (Character/highSurrogate suppl)))
                           "codePointAt(0)"
                           (.codePointAt sb 0)
                           (Character/highSurrogate suppl))))

  (field ^:static ^:final ^boolean At true)

  (field ^:static ^:final ^boolean Before false)

  (method ^:static testCodePoint ^void [^boolean isAt ^StringBuilder sb ^int index ^int expected]
    (let [^int c (if isAt (.codePointAt sb index) (.codePointBefore sb index))]
      (Supplementary/check (not (== c expected))
                           (java-str "codePoint" (if isAt "At" "Before") "(" index ") for <" sb ">")
                           c
                           expected)))

  (method ^:static testCodePoint ^void [^boolean isAt ^StringBuilder sb ^int index]
    (let [^:mutable exceptionOccurred false]
      (try
        (let [^int c (if isAt (.codePointAt sb index) (.codePointBefore sb index))] nil)
        (catch StringIndexOutOfBoundsException e (set! exceptionOccurred true)))
      (Supplementary/check (not exceptionOccurred)
                           (java-str "codePoint"
                                     (if isAt "At" "Before")
                                     "("
                                     index
                                     ") for <"
                                     sb
                                     "> should throw StringIndexOutOfBoundsPointerException."))))

  (method ^:static testAppendCodePoint ^void [^int codePoint ^Class expectedException]
    (try
      (.appendCodePoint (StringBuilder.) codePoint)
      (catch Exception e
        (when (.isInstance expectedException e) (return))
        (throw (RuntimeException. "Error: Unexpected exception" e))))
    (Supplementary/check true
                         (java-str "appendCodePoint("
                                   (Supplementary/toHexString codePoint)
                                   ") didn't throw "
                                   (.getName expectedException))))

  (method ^:static testCodePointCount ^void [^StringBuilder sb ^int beginIndex ^int endIndex
                                             ^Class expectedException]
    (try
      (let [n (.codePointCount sb beginIndex endIndex)] nil)
      (catch Exception e
        (when (.isInstance expectedException e) (return))
        (throw (RuntimeException. "Error: Unexpected exception" e))))
    (Supplementary/check true
                         (java-str "codePointCount() didn't throw " (.getName expectedException))))

  (method ^:static testOffsetByCodePoints ^void [^StringBuilder sb ^int index ^int offset
                                                 ^Class expectedException]
    (try
      (let [n (.offsetByCodePoints sb index offset)] nil)
      (catch Exception e
        (when (.isInstance expectedException e) (return))
        (throw (RuntimeException. "Error: Unexpected exception" e))))
    (Supplementary/check true
                         (java-str "offsetByCodePoints() didn't throw "
                                   (.getName expectedException))))

  (method ^:static check ^void [^boolean err ^String msg]
    (when err (throw (RuntimeException. (java-str "Error: " msg)))))

  (method ^:static check ^void [^boolean err ^String s ^int got ^int expected]
    (when err
      (throw (RuntimeException.
               (java-str "Error: "
                         s
                         " returned an unexpected value. got "
                         (Supplementary/toHexString got)
                         ", expected "
                         (Supplementary/toHexString expected))))))

  (method ^:static check ^void [^boolean err ^String s ^StringBuilder got ^String expected]
    (when err
      (throw (RuntimeException.
               (java-str "Error: "
                         s
                         " returned an unexpected value. got <"
                         (Supplementary/toHexString (.toString got))
                         ">, expected <"
                         (Supplementary/toHexString expected)
                         ">")))))

  (method ^:private ^:static toHexString ^String [^int c]
    (java-str "0x" (Integer/toHexString c)))

  (method ^:private ^:static toHexString ^String [^String s]
    (let [sb (StringBuilder.)]
      (loop [^int i 0]
        (when (< i (.length s))
          (let [c (.charAt s i)]
            (.append sb " 0x")
            (when (< c 0x10) (.append sb \0))
            (when (< c 0x100) (.append sb \0))
            (when (< c 0x1000) (.append sb \0))
            (.append sb (Integer/toHexString c))
            (recur (unchecked-inc-int i)))))
      (.append sb \space)
      (.toString sb))))

(in-ns 't04490)

(defclass ^:public Decode
  (method ^:private ^:static check ^void [^String val ^byte expected]
    (let [n (.byteValue (Byte/decode val))]
      (when-not (== n expected)
        (throw (RuntimeException. (java-str "Byte.decode failed. String:" val " Result:" n))))))

  (method ^:private ^:static checkFailure ^void [^String val ^String message]
    (try
      (let [n (.byteValue (Byte/decode val))] (throw (RuntimeException. message)))
      (catch NumberFormatException e)))

  (method ^:public ^:static main :throws [Exception] ^void [^String/1 args]
    (Decode/check (String. (java-str "" Byte/MIN_VALUE)) Byte/MIN_VALUE)
    (Decode/check (String. (java-str "" Byte/MAX_VALUE)) Byte/MAX_VALUE)
    (Decode/check "10" (unchecked-byte 10))
    (Decode/check "0x10" (unchecked-byte 16))
    (Decode/check "0X10" (unchecked-byte 16))
    (Decode/check "010" (unchecked-byte 8))
    (Decode/check "#10" (unchecked-byte 16))
    (Decode/check "+10" (unchecked-byte 10))
    (Decode/check "+0x10" (unchecked-byte 16))
    (Decode/check "+0X10" (unchecked-byte 16))
    (Decode/check "+010" (unchecked-byte 8))
    (Decode/check "+#10" (unchecked-byte 16))
    (Decode/check "-10" (unchecked-byte -10))
    (Decode/check "-0x10" (unchecked-byte -16))
    (Decode/check "-0X10" (unchecked-byte -16))
    (Decode/check "-010" (unchecked-byte -8))
    (Decode/check "-#10" (unchecked-byte -16))
    (Decode/check (Integer/toString (int Byte/MIN_VALUE)) Byte/MIN_VALUE)
    (Decode/check (Integer/toString (int Byte/MAX_VALUE)) Byte/MAX_VALUE)
    (Decode/checkFailure "0x-10" "Byte.decode allows negative sign in wrong position.")
    (Decode/checkFailure "0x+10" "Byte.decode allows positive sign in wrong position.")
    (Decode/checkFailure "+" "Raw plus sign allowed.")
    (Decode/checkFailure "-" "Raw minus sign allowed.")
    (Decode/checkFailure (Integer/toString (unchecked-subtract-int (int Byte/MIN_VALUE) 1))
                         "Out of range")
    (Decode/checkFailure (Integer/toString (unchecked-add-int (int Byte/MAX_VALUE) 1))
                         "Out of range")
    (Decode/checkFailure "" "Empty String")))

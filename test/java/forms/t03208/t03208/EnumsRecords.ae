(in-ns 't03208)

(import '(java.util EnumMap EnumSet HashSet List Set))

(defclass ^:public EnumsRecords
  (defclass ^:enum Planet
    (constants (MERCURY [3.303E23 2439700.0]) (EARTH [5.976E24 6378140.0]))

    (field ^:final ^double mass)

    (field ^:final ^double radius)

    (constructor [this ^double mass ^double radius]
      (set! (.-mass this) mass)
      (set! (.-radius this) radius))

    (method gravity ^double [this]
      (unchecked-divide (unchecked-multiply 6.673E-11 mass) (unchecked-multiply radius radius))))

  (defclass ^:enum Op
    (constants
      (PLUS ["+"] (method apply ^int [this ^int a ^int b] (unchecked-add-int a b)))
      (TIMES ["*"] (method apply ^int [this ^int a ^int b] (unchecked-multiply-int a b))))

    (field ^:final ^String sym)

    (constructor [this ^String sym] (set! (.-sym this) sym))

    (method ^:abstract apply ^int [this ^int a ^int b]))

  (defclass ^:record Point [^int x ^int y]
    (field ^:static ^:final ^Point ORIGIN (Point. 0 0))

    (constructor ^:compact [this]
      (when (< x 0) (throw (IllegalArgumentException. "negative x"))))

    (method scale ^Point [this ^int k]
      (Point. (unchecked-multiply-int x k) (unchecked-multiply-int y k)))

    (method ^:static of ^Point [^int v] (Point. v v)))

  (defclass ^:record Named [^String name ^T value]
    :type-params [T]

    (constructor [this ^String name] (this. name nil))

    (method ^:public name ^String [this] (.toUpperCase name)))

  (defclass ^:record Line [^Point a ^Point b])

  (method ^:public ^:static main ^void [^String/1 args]
    (for-each [^Planet p (Planet/values)]
      (.printf System/out "%s %d %.2f%n" (new Object/1 [p (.ordinal p) (.gravity p)])))
    (.println System/out
              (java-str (.name (Planet/valueOf "EARTH"))
                        " "
                        (.compareTo Planet/EARTH Planet/MERCURY)
                        " "
                        (.getSimpleName (.getDeclaringClass Planet/EARTH))))
    (try
      (Planet/valueOf "PLUTO")
      (catch IllegalArgumentException e (.println System/out "no PLUTO")))
    (for-each [^Op o (Op/values)]
      (.print System/out
              (java-str o
                        (.-sym o)
                        (.apply o 6 7)
                        " "
                        (identical? (.getClass o) Op)
                        " "
                        (identical? (.getDeclaringClass o) Op)
                        "; ")))
    (.println System/out)
    (let [^{:tag (EnumMap Op Integer)} em (EnumMap. Op)]
      (.put em Op/TIMES (Integer/valueOf 2))
      (.put em Op/PLUS (Integer/valueOf 1))
      (.println System/out (java-str em " " (EnumSet/allOf Planet) " " (EnumSet/noneOf Op)))
      (let [p (Point. 1 2)]
        (.println System/out
                  (java-str p
                            " "
                            (.x p)
                            " "
                            (.scale p 3)
                            " "
                            Point/ORIGIN
                            " "
                            (Point/of 4)
                            " "
                            (.equals p (Point. 1 2))
                            " "
                            (== (.hashCode p) (.hashCode (Point. 1 2)))))
        (try (Point. -1 0) (catch IllegalArgumentException e (.println System/out (.getMessage e))))
        (let [^{:tag (Named Integer)} n (Named. "n" (Integer/valueOf 5))]
          (.println System/out
                    (java-str n
                              " "
                              (.name n)
                              " "
                              (Named. "bare")
                              " "
                              (.equals (Named. "a" (Integer/valueOf 1))
                                       (Named. "a" (Integer/valueOf 1)))))
          (.println System/out (Line. p Point/ORIGIN))
          (let [^{:tag (Set Point)} set (HashSet.
                                          (List/of
                                            (Point. 1 1)
                                            (.scale (Point. 1 1) 1)
                                            (Point/of 1)))]
            (.println System/out (.size set))
            (switch Planet/EARTH
              EARTH (.println System/out "switch EARTH")
              (.println System/out "other"))))))))

;; Converted from jdk26u test/jdk/java/math/RoundingMode/RoundingModeTests.java (the test t04924, renamed: t04924/RoundingModeTests.java) by arbace.repr.java. Regenerate rather than edit.

(in-ns 't04924)

(import '(java.math RoundingMode))

(defclass ^:public RoundingModeTests
  (method ^:public ^:static main ^void [^String/1 argv]
    (for-each [^RoundingMode rm (RoundingMode/values)]
      (when-not (identical? rm (RoundingMode/valueOf (.toString rm)))
        (throw (RuntimeException. (java-str "Bad roundtrip conversion of " (.toString rm))))))
    (when-not (identical? (RoundingMode/valueOf BigDecimal/ROUND_CEILING) RoundingMode/CEILING)
      (throw (RuntimeException. "Bad mapping for ROUND_CEILING")))
    (when-not (identical? (RoundingMode/valueOf BigDecimal/ROUND_DOWN) RoundingMode/DOWN)
      (throw (RuntimeException. "Bad mapping for ROUND_DOWN")))
    (when-not (identical? (RoundingMode/valueOf BigDecimal/ROUND_FLOOR) RoundingMode/FLOOR)
      (throw (RuntimeException. "Bad mapping for ROUND_FLOOR")))
    (when-not (identical? (RoundingMode/valueOf BigDecimal/ROUND_HALF_DOWN) RoundingMode/HALF_DOWN)
      (throw (RuntimeException. "Bad mapping for ROUND_HALF_DOWN")))
    (when-not (identical? (RoundingMode/valueOf BigDecimal/ROUND_HALF_EVEN) RoundingMode/HALF_EVEN)
      (throw (RuntimeException. "Bad mapping for ROUND_HALF_EVEN")))
    (when-not (identical? (RoundingMode/valueOf BigDecimal/ROUND_HALF_UP) RoundingMode/HALF_UP)
      (throw (RuntimeException. "Bad mapping for ROUND_HALF_UP")))
    (when-not (identical? (RoundingMode/valueOf BigDecimal/ROUND_UNNECESSARY)
                          RoundingMode/UNNECESSARY)
      (throw (RuntimeException. "Bad mapping for ROUND_UNNECESARY")))))

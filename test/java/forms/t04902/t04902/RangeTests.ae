  (method ^:private ^:static testRoundingFromBigInteger ^int [^BigInteger bi ^int scale
                                                              ^MathContext mc]
    (let [^:mutable ^int failures 0
          bd1 (BigDecimal. bi scale mc)
          bd2 (.round (BigDecimal. bi scale) mc)]
      (when-not (.equals bd1 bd2)
        (.println System/out
                  (java-str "new BigDecimal(BigInteger,int,MathContext):BigInteger == "
                            bi
                            ";  scale == "
                            scale
                            "; result == "
                            bd1
                            "; expected  == "
                            bd2))
        (set! failures (unchecked-inc-int failures)))
      failures))


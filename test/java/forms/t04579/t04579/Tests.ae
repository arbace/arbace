  (method ^:public ^:static testTolerance ^int [^String testName ^double input ^double result
                                                ^double expected ^double tolerance]
    (if (not (== (Double/compare expected result) 0))
        (let [difference (unchecked-subtract expected result)]
          (if (or (or (Tests/isUnordered expected result) (Double/isNaN difference))
                  (not (<= (Math/abs (unchecked-divide difference expected))
                           (StrictMath/pow 10.0 (unchecked-negate tolerance)))))
              (do
                (.println System/err
                          (java-str "Failure for "
                                    testName
                                    ":\n\tFor input "
                                    input
                                    "\t("
                                    (Tests/toHexString input)
                                    ")\n\texpected  "
                                    expected
                                    "\t("
                                    (Tests/toHexString expected)
                                    ")\n\tgot       "
                                    result
                                    "\t("
                                    (Tests/toHexString result)
                                    ");\n\tdifference greater than tolerance 10^-"
                                    tolerance))
                1)
              0))
        0))


(in-ns 't05003)

(import '(java.net InetAddress ServerSocket Socket))

(defclass ^:public ShutdownBoth
  (method ^:public ^:static main :throws [Exception] ^void [^String/1 args]
    (let [loopback (InetAddress/getLoopbackAddress)
          ss (ServerSocket. 0 50 loopback)

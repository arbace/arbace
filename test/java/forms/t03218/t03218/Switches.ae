(in-ns 't03218)

(defclass ^:public Switches
  (defclass ^:enum Color
    (constants RED GREEN BLUE))

  (defclass ^:sealed ^:interface Shape
    :permits [Circle Square Rect])

  (defclass ^:record Circle [^double r]
    :implements [Shape])

  (defclass ^:record Square [^int side]
    :implements [Shape])

  (defclass ^:record Rect [^int w ^int h]
    :implements [Shape])

  (method ^:static classic ^String [^int i]
    (let [sb (StringBuilder.)]
      (switch i
        1 (do (.append sb "one ") (.append sb "two "))
        2 (.append sb "two ")
        3 (.append sb "three ")
        4 (.append sb "four ")
        (do (.append sb "other ") (.append sb "four ")))
      (.trim (.toString sb))))

  (method ^:static days ^int [^String m]
    (switch m "feb" 28 ("apr" "jun" "sep" "nov") 30 (let [^int d 31] d)))

  (method ^:static color ^String [^Color c]
    (switch c RED "r" GREEN "g" BLUE "b" (throw (MatchException. nil nil))))

  (method ^:static describe ^String [o]
    (switch o
      nil "null"
      [^Integer i :when (> i 10)] (java-str "big int " i)
      [^Integer i] (java-str "int " i)
      [^String s] (java-str "string of " (.length s))
      [^int/1 a] (java-str "ints " (alength a))
      (java-str "object " (.getSimpleName (.getClass o)))))

  (method ^:static area ^double [^Shape s]
    (switch s
      [^Circle c] (unchecked-multiply (unchecked-multiply Math/PI (.r c)) (.r c))
      [(Square ^int side)] (double (unchecked-multiply-int side side))
      [(Rect ^int w ^int h) :when (== w h)] -1.0
      [(Rect w h)] (double (unchecked-multiply-int w h))
      (throw (MatchException. nil nil))))

  (method ^:public ^:static main ^void [^String/1 args]
    (loop [^int i 0]
      (when (<= i 5)
        (.print System/out (java-str (Switches/classic i) "; "))
        (recur (unchecked-inc-int i))))
    (.println System/out)
    (.println System/out
              (java-str (Switches/days "feb") " " (Switches/days "jun") " " (Switches/days "jan")))
    (for-each [^Color c (Color/values)]
      (.print System/out (java-str (Switches/color c) (.ordinal c))))
    (.println System/out)
    (let [ch \b]
      (switch ch
        \a (.println System/out "a")
        \b (.println System/out "b!")
        (.println System/out "?"))
      (let [os (new Object/1
                    [nil
                     (Integer/valueOf 5)
                     (Integer/valueOf 50)
                     "hello"
                     (new int/1 3)
                     2.5
                     Color/GREEN])]
        (for-each [o os] (.println System/out (Switches/describe o)))
        (let [shapes (new Shape/1 [(Circle. 1.0) (Square. 3) (Rect. 2 2) (Rect. 2 5)])]
          (for-each [^Shape s shapes]
            (.printf System/out "%.3f%n" (new Object/1 [(Switches/area s)])))
          (let [^Object o "pattern"]
            (when-instance [^String s o]
              (when (> (.length s) 3) (.println System/out (java-str "instanceof " s))))
            (if-instance [^Integer n o]
              (.println System/out (unchecked-add-int n 1))
              (.println System/out "not an Integer"))
            (.println System/out
                      (java-str (Rect. 1 2)
                                " "
                                (.equals (Rect. 1 2) (Rect. 1 2))
                                " "
                                (== (.hashCode (Rect. 1 2)) (.hashCode (Rect. 1 2)))))
            (let [big 5 ^String which (if (> big 3) "gt" "le")] (.println System/out which))))))))

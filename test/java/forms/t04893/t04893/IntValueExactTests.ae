(in-ns 't04893)

(import '(java.util List Map Map$Entry))

(defclass ^:public IntValueExactTests
  (method ^:public ^:static main ^void [& ^String/1 args]
    (let [^:mutable ^int failures 0]
      (set! failures (unchecked-add-int failures (IntValueExactTests/intValueExactSuccessful)))
      (set! failures (unchecked-add-int failures (IntValueExactTests/intValueExactExceptional)))
      (when (> failures 0)
        (throw (RuntimeException.
                 (java-str "Incurred " failures " failures while testing intValueExact."))))))

  (method ^:private ^:static simpleIntValueExact ^int [^BigDecimal bd]
    (.intValue (.toBigIntegerExact bd)))

  (method ^:private ^:static intValueExactSuccessful ^int []
    (let [^:mutable ^int failures 0
          ^{:tag (Map BigDecimal Integer)} successCases (Map/ofEntries
                                                          (Map/entry
                                                            (BigDecimal. "2147483647")
                                                            Integer/MAX_VALUE)
                                                          (Map/entry
                                                            (BigDecimal. "2147483647.0")
                                                            Integer/MAX_VALUE)
                                                          (Map/entry
                                                            (BigDecimal. "2147483647.00")
                                                            Integer/MAX_VALUE)
                                                          (Map/entry
                                                            (BigDecimal. "-2147483648")
                                                            Integer/MIN_VALUE)
                                                          (Map/entry
                                                            (BigDecimal. "-2147483648.0")
                                                            Integer/MIN_VALUE)
                                                          (Map/entry
                                                            (BigDecimal. "-2147483648.00")
                                                            Integer/MIN_VALUE)
                                                          (Map/entry
                                                            (BigDecimal. "1e0")
                                                            (Integer/valueOf 1))
                                                          (Map/entry
                                                            (BigDecimal. BigInteger/ONE -9)
                                                            (Integer/valueOf 1000000000))
                                                          (Map/entry
                                                            (BigDecimal. "0e13")
                                                            (Integer/valueOf 0))
                                                          (Map/entry
                                                            (BigDecimal. "0e32")
                                                            (Integer/valueOf 0))
                                                          (Map/entry
                                                            (BigDecimal. "0e512")
                                                            (Integer/valueOf 0))
                                                          (Map/entry
                                                            (BigDecimal.
                                                              "10.000000000000000000000000000000000")
                                                            (Integer/valueOf 10)))]
      (for-each [^Map$Entry testCase (.entrySet successCases)]
        (let [bd (cast BigDecimal (.getKey testCase))
              expected (.intValue (cast Integer (.getValue testCase)))]
          (try
            (let [intValueExact (.intValueExact bd)]
              (when (or (not (== expected intValueExact))
                        (not (== intValueExact (IntValueExactTests/simpleIntValueExact bd))))
                (set! failures (unchecked-inc-int failures))
                (.println System/err
                          (java-str "Unexpected intValueExact result " intValueExact " on " bd))))
            (catch Exception e
              (set! failures (unchecked-inc-int failures))
              (.println System/err (java-str "Error on " bd "\tException message:" (.getMessage e)))))))
      failures))

  (method ^:private ^:static intValueExactExceptional ^int []
    (let [^:mutable ^int failures 0
          ^{:tag (List BigDecimal)} exceptionalCases (List/of
                                                       (BigDecimal. "2147483648")
                                                       (BigDecimal. "2147483648.0")
                                                       (BigDecimal. "2147483648.00")
                                                       (BigDecimal. "-2147483649")
                                                       (BigDecimal. "-2147483649.1")
                                                       (BigDecimal. "-2147483649.01")
                                                       (BigDecimal.
                                                         "9999999999999999999999999999999")
                                                       (BigDecimal.
                                                         "10000000000000000000000000000000")
                                                       (BigDecimal. "0.99")
                                                       (BigDecimal. "0.999999999999999999999"))]
      (for-each [^BigDecimal bd exceptionalCases]

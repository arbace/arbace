  (method ^:static testIntegerExact ^void [^int x ^int y]
    (try
      (let [sum (StrictMath/addExact x y)
            sum2 (unchecked-add (long x) (long y))]
        (if (not (== (unchecked-int sum2) sum2))
            (ExactArithTests/fail
              (java-str "FAIL: int StrictMath.addExact("
                        x
                        " + "
                        y
                        ") = "
                        sum
                        "; expected Arithmetic exception"))
            (when-not (== sum sum2)
              (ExactArithTests/fail
                (java-str "FAIL: long StrictMath.addExact("
                          x
                          " + "
                          y
                          ") = "
                          sum
                          "; expected: "
                          sum2)))))
      (catch ArithmeticException ex
        (let [sum2 (unchecked-add (long x) (long y))]
          (when (== (unchecked-int sum2) sum2)
            (ExactArithTests/fail
              (java-str "FAIL: int StrictMath.addExact(" x " + " y "); Unexpected exception: " ex))))))
    (try
      (let [diff (StrictMath/subtractExact x y)
            diff2 (unchecked-subtract (long x) (long y))]
        (when-not (== (unchecked-int diff2) diff2)
          (ExactArithTests/fail
            (java-str "FAIL: int StrictMath.subtractExact("
                      x
                      " - "
                      y
                      ") = "
                      diff
                      "; expected: "
                      diff2))))
      (catch ArithmeticException ex
        (let [diff2 (unchecked-subtract (long x) (long y))]
          (when (== (unchecked-int diff2) diff2)
            (ExactArithTests/fail
              (java-str "FAIL: int StrictMath.subtractExact("
                        x
                        " - "
                        y
                        "); Unexpected exception: "
                        ex))))))
    (try
      (let [product (StrictMath/multiplyExact x y)
            m2 (unchecked-multiply (long x) (long y))]
        (when-not (== (unchecked-int m2) m2)
          (ExactArithTests/fail
            (java-str "FAIL: int StrictMath.multiplyExact("
                      x
                      " * "
                      y
                      ") = "
                      product
                      "; expected: "
                      m2))))
      (catch ArithmeticException ex
        (let [m2 (unchecked-multiply (long x) (long y))]
          (when (== (unchecked-int m2) m2)
            (ExactArithTests/fail
              (java-str "FAIL: int StrictMath.multiplyExact("
                        x
                        " * "
                        y
                        "); Unexpected exception: "
                        ex))))))
    (try
      (let [inc (StrictMath/incrementExact x)
            inc2 (unchecked-add (long x) 1)]
        (if (not (== (unchecked-int inc2) inc2))
            (ExactArithTests/fail
              (java-str "FAIL: int StrictMath.incrementExact("
                        x
                        ") = "
                        inc
                        "; expected Arithmetic exception"))
            (when-not (== inc inc2)
              (ExactArithTests/fail
                (java-str "FAIL: long StrictMath.incrementExact(" x ") = " inc "; expected: " inc2)))))
      (catch ArithmeticException ex
        (let [inc2 (unchecked-add (long x) 1)]
          (when (== (unchecked-int inc2) inc2)
            (ExactArithTests/fail
              (java-str "FAIL: int StrictMath.incrementExact(" x "); Unexpected exception: " ex))))))
    (try
      (let [dec (StrictMath/decrementExact x)
            dec2 (unchecked-subtract (long x) 1)]
        (if (not (== (unchecked-int dec2) dec2))
            (ExactArithTests/fail
              (java-str "FAIL: int StrictMath.decrementExact("
                        x
                        ") = "
                        dec
                        "; expected Arithmetic exception"))
            (when-not (== dec dec2)
              (ExactArithTests/fail
                (java-str "FAIL: long StrictMath.decrementExact(" x ") = " dec "; expected: " dec2)))))
      (catch ArithmeticException ex
        (let [dec2 (unchecked-subtract (long x) 1)]
          (when (== (unchecked-int dec2) dec2)
            (ExactArithTests/fail
              (java-str "FAIL: int StrictMath.decrementExact(" x "); Unexpected exception: " ex))))))
    (try
      (let [neg (StrictMath/negateExact x)
            neg2 (unchecked-negate (long x))]
        (if (not (== (unchecked-int neg2) neg2))
            (ExactArithTests/fail
              (java-str "FAIL: int StrictMath.negateExact("
                        x
                        ") = "

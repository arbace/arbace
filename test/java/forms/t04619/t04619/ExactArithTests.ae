  (method ^:static testLongExact ^void [^long x ^long y]
    (let [^:mutable ^BigInteger resultBig nil
          xBig (BigInteger/valueOf x)
          yBig (BigInteger/valueOf y)]
      (try
        (set! resultBig (.add xBig yBig))
        (let [sum (StrictMath/addExact x y)]
          (ExactArithTests/checkResult "long StrictMath.addExact" x y sum resultBig))
        (catch ArithmeticException ex
          (when (ExactArithTests/inLongRange resultBig)
            (ExactArithTests/fail
              (java-str "FAIL: long StrictMath.addExact(" x " + " y "); Unexpected exception: " ex)))))
      (try
        (set! resultBig (.subtract xBig yBig))
        (let [diff (StrictMath/subtractExact x y)]
          (ExactArithTests/checkResult "long StrictMath.subtractExact" x y diff resultBig))
        (catch ArithmeticException ex
          (when (ExactArithTests/inLongRange resultBig)
            (ExactArithTests/fail
              (java-str "FAIL: long StrictMath.subtractExact("
                        x
                        " - "
                        y
                        "); Unexpected exception: "
                        ex)))))
      (try
        (set! resultBig (.multiply xBig yBig))
        (let [product (StrictMath/multiplyExact x y)]
          (ExactArithTests/checkResult "long StrictMath.multiplyExact" x y product resultBig))
        (catch ArithmeticException ex
          (when (ExactArithTests/inLongRange resultBig)
            (ExactArithTests/fail
              (java-str "FAIL: long StrictMath.multiplyExact("
                        x
                        " * "
                        y
                        "); Unexpected exception: "
                        ex)))))
      (try
        (set! resultBig (.add xBig BigInteger/ONE))
        (let [inc (StrictMath/incrementExact x)]
          (ExactArithTests/checkResult "long Math.incrementExact" x 1 inc resultBig))
        (catch ArithmeticException ex
          (when (ExactArithTests/inLongRange resultBig)
            (ExactArithTests/fail
              (java-str "FAIL: long Math.incrementExact(" x "); Unexpected exception: " ex)))))
      (try
        (set! resultBig (.subtract xBig BigInteger/ONE))
        (let [dec (StrictMath/decrementExact x)]
          (ExactArithTests/checkResult "long Math.decrementExact" x 1 dec resultBig))
        (catch ArithmeticException ex
          (when (ExactArithTests/inLongRange resultBig)
            (ExactArithTests/fail
              (java-str "FAIL: long Math.decrementExact(" x "); Unexpected exception: " ex)))))
      (try
        (set! resultBig (.negate xBig))
        (let [dec (StrictMath/negateExact x)]
          (ExactArithTests/checkResult "long Math.negateExact" x 0 dec resultBig))
        (catch ArithmeticException ex
          (when (ExactArithTests/inLongRange resultBig)
            (ExactArithTests/fail
              (java-str "FAIL: long Math.negateExact(" x "); Unexpected exception: " ex)))))
      (try
        (let [value (StrictMath/toIntExact x)]
          (when-not (== (long value) x)
            (ExactArithTests/fail
              (java-str "FAIL: long StrictMath.toIntExact("
                        x
                        ") = "
                        value
                        "; expected an arithmetic exception: "))))
        (catch ArithmeticException ex
          (when (<= (.bitLength resultBig) 32)
            (ExactArithTests/fail
              (java-str "FAIL: long StrictMath.toIntExact(" x "); Unexpected exception: " ex)))))))

  (method ^:static checkResult ^void [^String message ^long x ^long y ^long result
                                      ^BigInteger expected]
    (let [resultBig (BigInteger/valueOf result)]
      (if (not (ExactArithTests/inLongRange expected))
          (ExactArithTests/fail
            (java-str "FAIL: "
                      message
                      "("
                      x
                      ", "
                      y
                      ") = "
                      result
                      "; expected an arithmetic exception: "))
          (when-not (.equals resultBig expected)
            (ExactArithTests/fail
              (java-str "FAIL: " message "(" x ", " y ") = " result "; expected " expected))))))

  (method ^:static inLongRange ^boolean [^BigInteger value]
    (<= (.bitLength value) 63)))

(in-ns 't05384)

(import '(java.text ParsePosition SimpleDateFormat)
        '(java.util Locale))

(defclass ^:public Bug4736959
  (method ^:public ^:static main ^void [^String/1 args]
    (let [f (SimpleDateFormat. "a" Locale/US)
          d1 (.parse f "AM" (ParsePosition. 0))]
      (.println System/out (java-str "d1: " d1))
      (when-not (== (.getHours d1) 0)
        (throw (RuntimeException.
                 (java-str "Parsing \"AM\": expected 0 (midnight), got " (.getHours d1)))))
      (let [d2 (.parse f "PM" (ParsePosition. 0))]
        (.println System/out (java-str "d2: " d2))
        (when-not (== (.getHours d2) 12)
          (throw (RuntimeException.
                   (java-str "Parsing \"PM\": expected 12 (noon), got " (.getHours d2)))))))))

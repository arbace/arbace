                                                  Integer)
                                                (Collections/synchronizedMap (HashMap. 16))
                                                (Collections/synchronizedSortedMap (TreeMap.))
                                                (Collections/synchronizedNavigableMap (TreeMap.))]))]
            (loop [^int j 0]
              (when (< j 10)
                (.put this maps (.nextInt r 100) (.nextInt r 100))
                (recur (unchecked-inc-int j))))
            (.removeLastTwo this maps)
            (recur (unchecked-inc-int i)))))))

  (field ^:volatile ^int passed 0)

  (field ^:volatile ^int failed 0)

  (method pass ^void [this] (set! passed (unchecked-inc-int passed)))

  (method fail ^void [this]
    (set! failed (unchecked-inc-int failed))
    (Thread/dumpStack))

  (method fail ^void [this ^String msg]
    (.println System/err msg)
    (.fail this))

  (method unexpected ^void [this ^Throwable t]
    (set! failed (unchecked-inc-int failed))
    (.printStackTrace t))

  (method check ^void [this ^boolean cond]
    (if cond (.pass this) (.fail this)))

  (method equal ^void [this x y]
    (if (if (nil? x) (nil? y) (.equals x y))
        (.pass this)
        (.fail this (java-str x " not equal to " y))))

  (method ^:public ^:static main :throws [Throwable] ^void [^String/1 args]
    (.instanceMain (LockStep.) args))

  (method instanceMain :throws [Throwable] ^void [this ^String/1 args]
    (try (.test this args) (catch Throwable t (.unexpected this t)))
    (.printf System/out "%nPassed = %d, failed = %d%n%n" (new Object/1 [passed failed]))
    (when (> failed 0) (throw (AssertionError. "Some tests failed")))))

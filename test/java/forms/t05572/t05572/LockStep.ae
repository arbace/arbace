(defclass ^:public LockStep
  (method mapsEqual ^void [this ^Map m1 ^Map m2]
    (.equal this m1 m2)
    (.equal this m2 m1)
    (.equal this (.size m1) (.size m2))
    (.equal this (.isEmpty m1) (.isEmpty m2))
    (.equal this (.keySet m1) (.keySet m2))
    (.equal this (.keySet m2) (.keySet m1)))

  (method mapsEqual ^void [this ^{:tag (List Map)} maps]
    (let [first (cast Map (.get maps 0))] (for-each [^Map map maps] (.mapsEqual this first map))))

  (method put ^void [this ^{:tag (List Map)} maps key val]
    (for-each [^Map map maps] (.put map key val))
    (.mapsEqual this maps))

  (method removeLastTwo ^void [this ^{:tag (List Map)} maps]
    (let [first (cast Map (.get maps 0))
          size (.size first)
          fit (.iterator (.keySet first))]
      (loop [^int j 0]
        (when (< j (unchecked-subtract-int size 2)) (.next fit) (recur (unchecked-inc-int j))))
      (let [x1 (.next fit)
            x2 (.next fit)]
        (for-each [^Map map maps]
          (let [it (.iterator (.keySet map))]
            (while (.hasNext it)
              (let [x (.next it)] (when (or (identical? x x1) (identical? x x2)) (.remove it))))))
        (.mapsEqual this maps))))

  (method remove ^void [this ^Map m ^Iterator it]
    (let [size (.size m)]
      (.remove it)
      (when-not (== (.size m) (unchecked-subtract-int size 1))
        (throw (Error. (String/format "Incorrect size!%nmap=%s, size=%d%n"
                                      (new Object/1 [(.toString m) (.size m)])))))))

  (method test :throws [Throwable] ^void [this ^String/1 args]
    (let [^:const ^int iterations 100
          r (Random.)]
      (loop [^int i 0]
        (when (< i iterations)
          (let [^{:tag (List Map)} maps (List/of
                                          (new Map/1
                                               [(IdentityHashMap. 11)
                                                (HashMap. 16)
                                                (LinkedHashMap. 16)
                                                (WeakHashMap. 16)
                                                (Hashtable. 16)
                                                (TreeMap.)
                                                (ConcurrentHashMap. 16)
                                                (ConcurrentSkipListMap.)
                                                (Collections/checkedMap
                                                  (HashMap. 16)
                                                  Integer
                                                  Integer)
                                                (Collections/checkedSortedMap
                                                  (TreeMap.)
                                                  Integer
                                                  Integer)
                                                (Collections/checkedNavigableMap
                                                  (TreeMap.)

(import '(java.io BufferedReader IOException Reader))

(defclass ^:public Fill
  (defclass ^:static Source
    :extends Reader

    (field ^int shortFall)

    (field ^char next 0)

    (constructor [this ^int shortFall] (set! (.-shortFall this) shortFall))

    (method ^:public read :throws [IOException] ^int [this ^char/1 cbuf ^int off ^int len]

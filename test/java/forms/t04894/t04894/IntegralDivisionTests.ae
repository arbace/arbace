(import '(java.math MathContext RoundingMode))

(defclass ^:public IntegralDivisionTests
  (method ^:static dividetoIntegralValueTests ^int []
    (let [^:mutable ^int failures 0
          moreTestCases (new BigDecimal/2
                             [[(BigDecimal. "11003") (BigDecimal. "10") (BigDecimal. "1100")]
                              [(BigDecimal. "11003") (BigDecimal. "1e1") (BigDecimal. "1100.0")]
                              [(BigDecimal. "1e9") (BigDecimal. "1") (BigDecimal. "1e9")]
                              [(BigDecimal. "1e9") (BigDecimal. "1.00") (BigDecimal. "1e9")]
                              [(BigDecimal. "1e9") (BigDecimal. "0.1") (BigDecimal. "1e10")]
                              [(BigDecimal. "10e8") (BigDecimal. "0.1") (BigDecimal. "10e9")]
                              [(BigDecimal. "400e1") (BigDecimal. "5") (BigDecimal. "80e1")]
                              [(BigDecimal. "400e1")
                               (BigDecimal. "4.999999999")
                               (BigDecimal. "8e2")]
                              [(BigDecimal. "40e2") (BigDecimal. "5") (BigDecimal. "8e2")]
                              [(BigDecimal/valueOf 1 Integer/MIN_VALUE)
                               (BigDecimal/valueOf
                                 1
                                 (unchecked-negate-int (bit-and-int Integer/MAX_VALUE 0x7fffff00)))
                               (BigDecimal/valueOf 1 -256)]])]
      (for-each [^BigDecimal/1 testCase moreTestCases]
        (let [^:mutable ^BigDecimal quotient nil]
          (when-not (.equals (set! quotient
                                   (.divideToIntegralValue (aget testCase 0) (aget testCase 1)))
                             (aget testCase 2))
            (set! failures (unchecked-inc-int failures))
            (.println System/err)
            (.println System/err
                      (java-str "dividend  = "
                                (aget testCase 0)
                                " scale = "
                                (.scale (aget testCase 0))))
            (.println System/err
                      (java-str "divisor   = "
                                (aget testCase 1)
                                " scale = "
                                (.scale (aget testCase 1))))
            (.println System/err (java-str "quotient  = " quotient " scale = " (.scale quotient)))
            (.println System/err
                      (java-str "expected  = "
                                (aget testCase 2)
                                " scale = "
                                (.scale (aget testCase 2)))))))
      failures))


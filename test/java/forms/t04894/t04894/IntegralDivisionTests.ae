  (method ^:static divideContextTestPrecs ^int [^BigDecimal dividend ^BigDecimal divisor
                                                ^BigDecimal/1 quotients]
    (let [^:mutable ^int failures 0]
      (loop [^int i 0]
        (when (< i (alength quotients))
          (let [^:mutable ^BigDecimal result nil
                quotient (aget quotients i)]
            (try
              (set! result
                    (.divideToIntegralValue dividend divisor (MathContext. i RoundingMode/DOWN)))
              (catch ArithmeticException e
                (when (some? quotient)
                  (set! failures (unchecked-inc-int failures))
                  (.println System/err)
                  (.println System/err "Unexpected exception:")
                  (.println System/err
                            (java-str "dividend  = " dividend " scale = " (.scale dividend)))
                  (.println System/err
                            (java-str "divisor   = " divisor " scale = " (.scale divisor)))
                  (.println System/err
                            (java-str "expected  = " quotient " scale = " (.scale quotient))))))
            (cond
              (some? quotient)
                (if (not (.equals result quotient))
                    (do
                      (set! failures (unchecked-inc-int failures))
                      (.println System/err)
                      (.println System/err "Unexpected result:")
                      (.println System/err
                                (java-str "dividend  = " dividend " scale = " (.scale dividend)))
                      (.println System/err
                                (java-str "divisor   = " divisor " scale = " (.scale divisor)))
                      (.println System/err
                                (java-str "quotient  = " result " scale = " (.scale result)))
                      (.println System/err
                                (java-str "expected  = " quotient " scale = " (.scale quotient)))
                      (.println System/err (java-str "precision = " i))
                      (recur (unchecked-inc-int i)))
                    (recur (unchecked-inc-int i)))
              (some? result)
                (do
                  (set! failures (unchecked-inc-int failures))
                  (.println System/err)
                  (.println System/err "Unexpected unexceptional result:")
                  (.println System/err
                            (java-str "dividend  = " dividend " scale = " (.scale dividend)))
                  (.println System/err
                            (java-str "divisor   = " divisor " scale = " (.scale divisor)))
                  (.println System/err (java-str "quotient  = " result " scale = " (.scale result)))
                  (.println System/err (java-str "precision = " i))
                  (recur (unchecked-inc-int i)))
              :else (recur (unchecked-inc-int i))))))
      failures))

  (method ^:static divideContextTests ^int [^BigDecimal dividend ^BigDecimal divisor
                                            ^BigDecimal expected ^MathContext mc]
    (let [^:mutable ^int failures 0]
      (set! failures
            (unchecked-add-int failures
                               (IntegralDivisionTests/divideContextTest
                                 dividend
                                 divisor
                                 expected
                                 mc)))
      (set! failures
            (unchecked-add-int failures
                               (IntegralDivisionTests/divideContextTest
                                 (.negate dividend)
                                 (.negate divisor)
                                 expected
                                 mc)))
      (when (some? expected)
        (set! failures
              (unchecked-add-int failures
                                 (IntegralDivisionTests/divideContextTest
                                   (.negate dividend)
                                   divisor
                                   (.negate expected)
                                   mc)))
        (set! failures
              (unchecked-add-int failures
                                 (IntegralDivisionTests/divideContextTest
                                   dividend
                                   (.negate divisor)
                                   (.negate expected)
                                   mc))))
      failures))

  (method ^:static divideContextTest ^int [^BigDecimal dividend ^BigDecimal divisor
                                           ^BigDecimal expected ^MathContext mc]
    (let [^:mutable ^int failures 0
          ^:mutable ^BigDecimal result nil]
      (try
        (set! result (.divideToIntegralValue dividend divisor mc))
        (catch ArithmeticException e
          (when (some? expected)
            (set! failures (unchecked-inc-int failures))
            (.println System/err)
            (.println System/err "Unexpected exception:")
            (.println System/err (java-str "dividend  = " dividend " scale = " (.scale dividend)))
            (.println System/err (java-str "divisor   = " divisor " scale = " (.scale divisor)))
            (.println System/err (java-str "expected  = " expected " scale = " (.scale expected)))
            (.println System/err (java-str "MathContext  = " mc)))))
      (if (some? expected)
          (when-not (.equals result expected)
            (set! failures (unchecked-inc-int failures))
            (.println System/err)
            (.println System/err "Unexpected result:")
            (.println System/err (java-str "dividend  = " dividend " scale = " (.scale dividend)))
            (.println System/err (java-str "divisor   = " divisor " scale = " (.scale divisor)))
            (.println System/err (java-str "expected  = " expected " scale = " (.scale expected)))
            (.println System/err (java-str "result    = " result " scale = " (.scale result)))
            (.println System/err (java-str "MathContext  = " mc)))
          (when (some? result)
            (set! failures (unchecked-inc-int failures))
            (.println System/err)
            (.println System/err "Unexpected unexceptional result:")
            (.println System/err (java-str "dividend  = " dividend " scale = " (.scale dividend)))
            (.println System/err (java-str "divisor   = " divisor " scale = " (.scale divisor)))
            (.println System/err (java-str "quotient  = " result " scale = " (.scale result)))
            (.println System/err (java-str "MathConext = " mc))))
      failures))


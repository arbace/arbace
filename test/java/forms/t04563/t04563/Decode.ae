(in-ns 't04563)

(defclass ^:public Decode
  (method ^:private ^:static check ^void [^String val ^long expected]
    (let [n (.longValue (Long/decode val))]
      (when-not (== n expected)
        (throw (RuntimeException. (java-str "Long.decode failed. String:" val " Result:" n))))))

  (method ^:private ^:static checkFailure ^void [^String val ^String message]
    (try
      (let [n (.longValue (Long/decode val))] (throw (RuntimeException. message)))
      (catch NumberFormatException e)))

  (method ^:public ^:static main :throws [Exception] ^void [^String/1 args]
    (Decode/check (String. (java-str "" Long/MIN_VALUE)) Long/MIN_VALUE)
    (Decode/check (String. (java-str "" Long/MAX_VALUE)) Long/MAX_VALUE)
    (Decode/check "10" 10)
    (Decode/check "0x10" 16)
    (Decode/check "0X10" 16)
    (Decode/check "010" 8)
    (Decode/check "#10" 16)
    (Decode/check "+10" 10)
    (Decode/check "+0x10" 16)
    (Decode/check "+0X10" 16)
    (Decode/check "+010" 8)
    (Decode/check "+#10" 16)
    (Decode/check "-10" -10)
    (Decode/check "-0x10" -16)
    (Decode/check "-0X10" -16)
    (Decode/check "-010" -8)
    (Decode/check "-#10" -16)
    (Decode/check (Long/toString Long/MIN_VALUE) Long/MIN_VALUE)
    (Decode/check (Long/toString Long/MAX_VALUE) Long/MAX_VALUE)
    (Decode/checkFailure "0x-10" "Long.decode allows negative sign in wrong position.")
    (Decode/checkFailure "0x+10" "Long.decode allows positive sign in wrong position.")
    (Decode/checkFailure "+" "Raw plus sign allowed.")
    (Decode/checkFailure "-" "Raw minus sign allowed.")
    (Decode/checkFailure (.toString (.subtract (BigInteger/valueOf Long/MIN_VALUE) BigInteger/ONE))
                         "Out of range")
    (Decode/checkFailure (.toString (.add (BigInteger/valueOf Long/MAX_VALUE) BigInteger/ONE))
                         "Out of range")
    (Decode/checkFailure "" "Empty String")
    (try
      (Long/decode nil)
      (throw (RuntimeException. "Long.decode(null) expected to throw NPE"))
      (catch NullPointerException npe))))

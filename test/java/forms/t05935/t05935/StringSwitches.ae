;; Converted from jdk26u test/langtools/tools/javac/StringsInSwitch/StringSwitches.java (the test t05935, renamed: t05935/StringSwitches.java) by arbace.repr.java. Regenerate rather than edit.

(in-ns 't05935)

(defclass ^:public StringSwitches
  (method ^:public ^:static main ^void [& ^String/1 args]
    (let [^:mutable ^int failures 0]
      (set! failures (unchecked-add-int failures (StringSwitches/testPileup)))
      (set! failures (unchecked-add-int failures (StringSwitches/testSwitchingTwoWays)))
      (set! failures (unchecked-add-int failures (StringSwitches/testNamedBreak)))
      (set! failures (unchecked-add-int failures (StringSwitches/testExtraParens)))
      (when (> failures 0) (throw (RuntimeException.)))))

  (method ^:private ^:static zeroHashes ^int [^String s]
    (let [^:mutable result Integer/MAX_VALUE]
      (switch s
        "" (return 0)
        "\u0000" (set! result 1)
        "\u0000\u0000" (return 2)
        "\u0000\u0000\u0000" (set! result 3)
        "\u0000\u0000\u0000\u0000" (return 4)
        "\u0000\u0000\u0000\u0000\u0000" (set! result 5)
        "\u0000\u0000\u0000\u0000\u0000\u0000" (return 6)
        (set! result -1))
      result))

  (method ^:private ^:static testPileup ^int []
    (let [^:mutable ^int failures 0
          ^:mutable zero ""]
      (let [^:mutable ^int i 0]
        (while (<= i 6)
          (let [result (StringSwitches/zeroHashes zero)]
            (when-not (== result i)
              (set! failures (unchecked-inc-int failures))
              (.printf System/err
                       "For string \"%s\" unexpectedly got %d instead of %d%n."
                       (new Object/1 [zero result i]))))
          (set! i (unchecked-inc-int i))
          (set! zero (java-str zero "\u0000"))))
      (when-not (== (StringSwitches/zeroHashes "foo") -1)
        (set! failures (unchecked-inc-int failures))
        (.println System/err "Failed to get -1 for input string."))
      failures))

  (method ^:private ^:static testSwitchingTwoWays ^int []
    (let [^:mutable ^int failures 0]
      (for-each [^MetaSynVar msv (MetaSynVar/values)]
        (let [enumResult (StringSwitches/enumSwitch msv)
              stringResult (StringSwitches/stringSwitch (.name msv))]
          (when-not (== enumResult stringResult)
            (set! failures (unchecked-inc-int failures))
            (.printf
              System/err
              "One value %s, computed 0x%x with the enum switch and 0x%x with the string one.%n"
              (new Object/1 [msv enumResult stringResult])))))
      failures))

  (defclass ^:private ^:static ^:enum MetaSynVar
    (constants FOO BAR BAZ QUX QUUX QUUUX MUMBLE FOOBAR))

  (method ^:private ^:static enumSwitch ^int [^MetaSynVar msv]
    (let [^:mutable ^int result 0]
      (switch msv
        FOO
          (do
            (set! result (bit-or-int result (bit-shift-left-int 1 0)))
            (set! result (bit-or-int result (bit-shift-left-int 1 1))))
        (BAR BAZ) (set! result (bit-or-int result (bit-shift-left-int 1 1)))
        MUMBLE (do (set! result (bit-or-int result (bit-shift-left-int 1 6))) (return result))
        FOOBAR (set! result (bit-or-int result (bit-shift-left-int 1 7)))
        (do
          (switch msv
            QUX (set! result (bit-or-int result (bit-shift-left-int 1 2)))
            QUUX
              (do
                (set! result (bit-or-int result (bit-shift-left-int 1 3)))
                (set! result (bit-or-int result (bit-shift-left-int 1 4))))
            (set! result (bit-or-int result (bit-shift-left-int 1 4))))
          (set! result (bit-or-int result (bit-shift-left-int 1 5)))))
      (set! result (bit-or-int result (bit-shift-left-int 1 8)))
      result))

  (method ^:private ^:static stringSwitch ^int [^String msvName]
    (let [^:mutable ^int result 0]
      (switch msvName
        "FOO"
          (do
            (set! result (bit-or-int result (bit-shift-left-int 1 0)))
            (set! result (bit-or-int result (bit-shift-left-int 1 1))))
        ("BAR" "BAZ") (set! result (bit-or-int result (bit-shift-left-int 1 1)))
        "MUMBLE" (do (set! result (bit-or-int result (bit-shift-left-int 1 6))) (return result))
        "FOOBAR" (set! result (bit-or-int result (bit-shift-left-int 1 7)))
        (do
          (switch msvName
            "QUX" (set! result (bit-or-int result (bit-shift-left-int 1 2)))
            "QUUX"
              (do
                (set! result (bit-or-int result (bit-shift-left-int 1 3)))
                (set! result (bit-or-int result (bit-shift-left-int 1 4))))
            (set! result (bit-or-int result (bit-shift-left-int 1 4))))
          (set! result (bit-or-int result (bit-shift-left-int 1 5)))))
      (set! result (bit-or-int result (bit-shift-left-int 1 8)))
      result))

  (method ^:private ^:static testNamedBreak ^int []
    (let [^:mutable ^int failures 0
          testStrings (new String/1 ["a" "b" "c" "d" "e"])
          testExpected (new int/1 [2r101011 2r101 2r100001 2r101000 2r10000])]
      (loop [^int i 0]
        (when (< i (alength testStrings))
          (let [expected (aget testExpected i)
                result (StringSwitches/namedBreak (aget testStrings i))]
            (if (not (== result expected))
                (do
                  (set! failures (unchecked-inc-int failures))
                  (.printf System/err
                           "On input %s, got %d instead of %d.%n"
                           (new Object/1 [(aget testStrings i) result expected]))
                  (recur (unchecked-inc-int i)))
                (recur (unchecked-inc-int i))))))
      failures))

  (method ^:private ^:static namedBreak ^int [^String s]
    (let [^:mutable ^int result 0]
      (label :outer
        (label :outer
          (switch s
            ("a" "b" "c")
              (do
                (set! result (bit-or-int result (bit-shift-left-int 1 0)))
                (switch (java-str s s)
                  "aa" (set! result (bit-or-int result (bit-shift-left-int 1 1)))
                  "cc" (break :outer)
                  (do (set! result (bit-or-int result (bit-shift-left-int 1 2))) (return result)))
                (set! result (bit-or-int result (bit-shift-left-int 1 3))))
            "d" (set! result (bit-or-int result (bit-shift-left-int 1 3)))
            (return (set! result (bit-or-int result (bit-shift-left-int 1 4)))))))
      (set! result (bit-or-int result (bit-shift-left-int 1 5)))
      result))

  (method ^:private ^:static testExtraParens ^int []
    (let [^:mutable ^int failures 1
          s "first"]
      (switch s
        "first" (set! failures 0)
        "second" (throw (RuntimeException. "Should not be reached.")))
      failures)))

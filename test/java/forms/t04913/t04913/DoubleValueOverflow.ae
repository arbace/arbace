;; Converted from jdk26u test/jdk/java/math/BigInteger/DoubleValueOverflow.java (the test t04913, renamed: t04913/DoubleValueOverflow.java) by arbace.repr.java. Regenerate rather than edit.

(in-ns 't04913)

(defclass ^:public DoubleValueOverflow
  (method ^:public ^:static main ^void [^String/1 args]
    (try
      (let [x (.shiftLeft (BigInteger/valueOf 2) Integer/MAX_VALUE)]
        (when-not (== (.doubleValue x) Double/POSITIVE_INFINITY)
          (throw (RuntimeException. (java-str "Incorrect doubleValue() " (.doubleValue x)))))
        (.println System/out "Passed with correct result"))
      (catch ArithmeticException e
        (.println System/out "Overflow is reported by ArithmeticException, as expected"))
      (catch OutOfMemoryError e
        (.println System/err "DoubleValueOverflow skipped: OutOfMemoryError")
        (.println System/err "Run jtreg with -javaoption:-Xmx8g")))))

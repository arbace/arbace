(ns crops.score
  "bin/crops-score (doc/CROPS-SCORE.md): each crop's completeness, maturity and independence as
  percentages, from the recorded results alone (no runs), like bin/reap. The tree scored is the
  checkout (default) or a ref's (--ref REF: read by git show, no checkout); --newest scores each
  crop on its newest held branch (test/crops/crops.edn's :branches, the newest ref with the crop's
  REAP row).

  Completeness: per cell (read, eval, AOT, print) pass / (pass + by design + deferred + pending) of
  the tree's REAP matrix record, test/reap/matrix.edn (bin/reap's judging of the checks' records,
  which bin/reap keeps equal to them; --judge recomputes the checkout's with reap.main's own
  judging and fails on a difference); a cell not checked, or a crop with no row, counts 0 and is
  flagged; the crop's is the mean of its four cells.
  Maturity: the checklist of doc/CROPS-SCORE.md, each item an equal share, each measured on the
  tree: the four cells recorded, none unclassed, negative controls of the cells' check families
  (test/crops/crops.edn's :controls rules), gate steps (essential and --full, test/gate/steps.edn,
  half for a GT9 fragment test/gate/crops/CROP.edn only), a REAP row, records without an absolute
  path.
  Independence: per stage (read, eval, AOT, print, judge) the reviewed facts of
  test/crops/independence.edn (1, 0.5, 0), cross-checked with the tree's gate steps: a stage whose
  named steps run on a toolchain host (:hosts, outside the oracle tier; crops.edn's :host-uses the
  exempt uses) scores 0 whatever the claim, and the disagreement is flagged; on the checkout also
  (the independence audit, 2026-11-09) (a) a claim above 0 whose steps run a script that reads a
  toolchain's files by path (crops.edn's :toolchain-reads) and (b) a claim above 0.5 whose cell's
  record says in its header that a live helper wrote it (:helper-records) score 0, refuted; (c) a
  claim above 0 that no step of the tree runs is flagged unverified (its score kept).

  -main [--ref REF | --newest] [--crop C] [--tsv] [--input FILE]... [--judge] [--strict]"
  (:require [arbace.string :as str]
            [arbace.java.io :as io])
  (:import (java.io File)))

(def ^:dynamic *root* ".")

(def levels [:read :eval :aot :print])
(def stages [:read :eval :aot :print :judge])
(def level-names {:read "read" :eval "eval" :aot "AOT" :print "print" :judge "judge"})

;; ---- the tree: the checkout or a ref

(defn- sh
  "Runs CMD in the checkout; {:exit :out}."
  [& cmd]
  (let [pb (ProcessBuilder. ^java.util.List (vec cmd))]
    (.directory pb (File. ^String *root*))
    (.redirectErrorStream pb false)
    (let [p (.start pb) out (slurp (.getInputStream p))]
      {:exit (.waitFor p) :out out})))

(defn- git [& args] (apply sh "git" "-C" *root* args))

(defn- tree
  "A ref's tree (its files by git ls-tree), or the checkout's (nil: its files asked one by one, so that the gate's
  audit sees only the files the scores read)."
  [ref]
  (if ref
    (let [r (git "ls-tree" "-r" "--name-only" ref)]
      (when-not (zero? (:exit r)) (throw (ex-info (str "crops-score: no ref " ref) {})))
      {:ref ref :files (set (remove str/blank? (str/split-lines (:out r))))})
    {:ref nil}))

(defn- has? [t f]
  (if (:ref t) (contains? (:files t) f) (.isFile (File. ^String (str *root* "/" f)))))

(defn- fragment-files [t]
  (sort (if (:ref t)
          (filter #(re-matches #"test/gate/crops/[^/]+\.edn" %) (:files t))
          (for [^File x (or (seq (.listFiles (File. ^String (str *root* "/test/gate/crops")))) [])
                :when (re-matches #"[^/]+\.edn" (.getName x))]
            (str "test/gate/crops/" (.getName x))))))

(def ^:private cache (atom {}))

(defn- text
  "F's text in tree T, or nil."
  [t f]
  (when (has? t f)
    (let [k [(:ref t) f]]
      (or (@cache k)
          (let [s (if (:ref t)
                    (let [r (git "show" (str (:ref t) ":" f))] (when (zero? (:exit r)) (:out r)))
                    (let [x (File. ^String (str *root* "/" f))] (when (.isFile x) (slurp x))))]
            (swap! cache assoc k s)
            s)))))

(defn- edn [t f] (when-let [s (text t f)] (read-string s)))

(defn- edn-forms
  "Every form of F's text in tree T (a file of one form a line, bin/hsi check's), or nil."
  [t f]
  (when-let [s (text t f)] (read-string (str "[" s "\n]"))))

(defn- read-file [f]
  (read-string (slurp (if (str/starts-with? f "/") f (str *root* "/" f)))))

;; ---- the REAP row

(defn- matrix
  "The tree's matrix records by cell, with --input's records over them."
  [t inputs]
  (merge (into {} (for [r (edn t "test/reap/matrix.edn")] [(:cell r) (assoc r :from "test/reap/matrix.edn")]))
         (into {} (for [[f rs] inputs r rs] [(:cell r) (assoc r :from f)]))))

(defn- cases [r] (+ (:pass r 0) (:design r 0) (:deferred r 0) (:pending r 0)))

(defn- cell-score [r]
  (cond (nil? r) {:score 0.0 :flag "no row"}
        (not (:checked r)) {:score 0.0 :flag "no check yet"}
        (zero? (cases r)) {:score 0.0 :flag "no case"}
        (and (seq (remove :absent (:sources r))) (every? #(nil? (:pass %)) (remove :absent (:sources r))))
        {:score (double (/ (:pass r) (cases r))) :flag "passes not recorded: its sources record only their non-passes"}
        :else {:score (double (/ (:pass r) (cases r)))}))

(defn- meant
  "CSP4 (a cell's completeness of what is meant to pass): pass / (pass + deferred + pending), by design out."
  [r]
  (let [d (+ (:pass r 0) (:deferred r 0) (:pending r 0))]
    (if (and r (:checked r) (pos? d)) (double (/ (:pass r) d)) 0.0)))

(defn- completeness [crop m]
  (let [cells (for [l levels :let [r (m [crop l])]] (merge {:level l :record r :meant (meant r)} (cell-score r)))]
    {:cells cells :score (/ (reduce + (map :score cells)) (count levels))
     :meant (/ (reduce + (map :meant cells)) (count levels))}))

;; ---- maturity

(defn- cells-spec [t] (edn t "test/reap/cells.edn"))

(defn- crop-sources
  "The crop's cells' sources in the tree's test/reap/cells.edn, each with its :level."
  [spec crop]
  (for [l levels s (get-in spec [:cells [crop l] :sources])] (assoc s :level l)))

(defn- record-files [t sources]
  (distinct (for [s sources k [:file :results :known :ref-runs :ref :same-cases :upstream]
                  :let [f (get s k)] :when (and (string? f) (has? t f))]
              f)))

(defn- steps-of
  "Every step of the tree: test/gate/steps.edn's (:where :steps) and the GT9 fragments'
  test/gate/crops/*.edn (:where :fragment), each with its crop of the table's :crops."
  [t]
  (let [spec (edn t "test/gate/steps.edn")
        crop-of (into {} (for [[c ns] (:crops spec) n ns] [(str n) c]))
        main (for [s (:steps spec)] (assoc s :where :steps :crop (crop-of (str (:name s)))))
        frags (for [f (fragment-files t)
                    :let [s (text t f)
                          sec (fn [nm] (second (re-find (re-pattern (str "(?s);;@ " nm "\n(.*?)(?:\n;;@ |\\z)")) s)))
                          steps (when-let [x (sec "steps")] (read-string (str "[" x "\n]")))
                          crops (when-let [x (sec "crops")] (read-string (str "{" x "\n}")))
                          fc (into {} (for [[c ns] crops n ns] [(str n) c]))]
                    st steps]
                (assoc st :where :fragment :file f :crop (fc (str (:name st)))))]
    (let [named (set (map #(str (:name %)) main))]
      ;; a fragment's step whose name steps.edn has is the planner's: steps.edn's wins (the fragment's is a merge's draft)
      (concat main (remove #(named (str (:name %))) frags)))))

(defn- crop-steps [cfg steps]
  (filter (fn [s] (let [n (str (:name s))]
                    (and (or (= (:id cfg) (:crop s)) (and (:steps cfg) (re-find (:steps cfg) n)))
                         (not (and (:exclude-steps cfg) (re-find (:exclude-steps cfg) n))))))
          steps))

(defn- item [id title value evidence] {:id id :title title :value (double value) :evidence evidence})

(defn- maturity [t cfg config m steps]
  (let [crop (:id cfg)
        spec (cells-spec t)
        row? (some #{crop} (:languages spec))
        sources (crop-sources spec crop)
        checks (remove #(or (= :beside (:role %)) (:until %)) sources)
        recs (for [l levels :let [r (m [crop l])] :when r] r)
        checked (filter :checked recs)
        unclassed (for [r checked s (:sources r)
                        :when (and (not (:absent s)) (not= (:not s) (reduce + (map second (:classes s)))))]
                    (str (name (second (:cell r))) ": " (:name s)))
        covered (fn [s] (some (fn [rule]
                                (and (re-find (:source rule) (:name s))
                                     (when-let [x (text t (:file rule))]
                                       (if (:match rule) (re-find (:match rule) x) true))
                                     rule))
                              (:controls cfg)))
        ctl (for [s checks] [s (covered s)])
        cs (crop-steps cfg steps)
        live (remove #(= :oracle (:phase %)) cs)
        in-steps (filter #(= :steps (:where %)) live)
        part (fn [ph] (cond (some #(= ph (:phase %)) in-steps) 0.5
                            (some #(= ph (:phase %)) live) 0.25
                            :else 0))
        files (record-files t sources)
        abs (for [f files :let [x (some-> (text t f) (#(reduce (fn [a r] (str/replace a r "")) % (:abs-path-allow config))))
                               hit (when x (re-find (:abs-path config) x))]
                  :when hit]
              (str f " (" (if (string? hit) hit (first hit)) ")"))
        items [(item :cells "the four cells recorded" (/ (count checked) 4)
                     (str (count checked) " of 4 cells checked in test/reap/matrix.edn"
                          (when-let [x (seq (remove #(:checked (m [crop %])) levels))]
                            (str "; not: " (str/join ", " (map level-names x))))))
               (item :classed "every non-pass in a class" (if (and (seq checked) (empty? unclassed)) 1 0)
                     (cond (empty? checked) "no checked cell"
                           (seq unclassed) (str "unclassed: " (str/join "; " unclassed))
                           :else (str "every source's classes sum to its non-passes"
                                      (let [p (reduce + (map #(:pending % 0) checked))]
                                        (when (pos? p) (str "; " p " pending the user's decision"))))))
               (item :controls "negative controls for its check families"
                     (if (seq checks) (/ (count (filter second ctl)) (count checks)) 0)
                     (if (empty? checks) "no check family (no REAP row)"
                         (str (count (filter second ctl)) " of " (count checks) " check families"
                              (when-let [x (seq (remove second ctl))]
                                (str "; none for: " (str/join "; " (map #(str (level-names (:level (first %))) " " (:name (first %))) x))))
                              (when-let [x (seq (distinct (keep #(:file (second %)) ctl)))]
                                (str "; controls " (str/join ", " x))))))
               (item :gate "gate steps: essential and --full" (+ (part :essential) (part :full))
                     (if (empty? cs) "no step in test/gate/steps.edn or test/gate/crops/"
                         (str (str/join ", " (for [ph [:essential :full :oracle]
                                                   :let [x (filter #(= ph (:phase %)) cs)] :when (seq x)]
                                               (str (count x) " " (name ph)
                                                    (let [fr (count (filter #(= :fragment (:where %)) x))]
                                                      (when (pos? fr) (str " (" fr " in a GT9 fragment only)"))))))
                              (when (empty? in-steps) "; none planned in test/gate/steps.edn"))))
               (item :reap "a REAP row (test/reap/cells.edn)" (if row? 1 0)
                     (if row? (str "row " crop ", " (count sources) " sources") "no row"))
               (item :pins "records reproducible (no host or path in a record)"
                     (if (seq files) (/ (- (count files) (count abs)) (count files)) 0)
                     (cond (empty? files) "no record"
                           (seq abs) (str (count abs) " of " (count files) " records hold an absolute path: " (str/join "; " abs))
                           :else (str (count files) " records, no absolute path")))]]
    {:items items :score (/ (reduce + (map :value items)) (count items))}))

;; ---- independence

;; The user's decision of 2026-11-07 (doc/CROPS-SCORE.md, "Decided (the user, 2026-11-07)"): a stage whose cases are judged
;; partly by their own verdict (1) and partly by a recorded reference (0.5), or live (0), scores the case-weighted mean. The
;; facts give the counts as :cases {CHECK [N SCORE] ...} (Scheme's) or :mixed {:own N :jdk-record M} (Java's: own 1, the
;; JDK's record 0.5); with neither, the fact's stated :score stands.
(defn- mixed-score [f]
  (cond (and (map? (:cases f)) (number? (get-in f [:cases :self])) (number? (get-in f [:cases :recorded])))
        ;; C's form (c-indep-b1): {:self N :recorded M}, (N + 0.5 M) / (N + M)
        (let [o (get-in f [:cases :self]) r (get-in f [:cases :recorded]) n (+ o r)]
          (when (pos? n) [(double (/ (+ o (* 0.5 r)) n)) n]))
        (map? (:cases f))
        (let [cs (vals (:cases f)) n (reduce + (map first cs))]
          (when (pos? n) [(double (/ (reduce + (map (fn [[k v]] (* k v)) cs)) n)) n]))
        (and (number? (get-in f [:mixed :own])) (number? (get-in f [:mixed :jdk-record])))
        (let [o (get-in f [:mixed :own]) j (get-in f [:mixed :jdk-record]) n (+ o j)]
          (when (pos? n) [(double (/ (+ o (* 0.5 j)) n)) n]))))

;; ---- RFP53 (a) (the user, 2026-11-10; doc/CROPS-SCORE.md, "Decided (the user, 2026-11-10)"): a case's own inputs

(defn- own-case? [inputs m] (and (map? m) (every? #(= :own (get m %)) inputs)))

(defn- input-rows
  "HF10-P29 (a): a record of inputs' rows as [ID {INPUT VALUE ...}]: one vector of such rows (RFP53's), or one map a case
  with its :id beside its inputs (bin/hsi check's lines: {:id ... :libs :own ...})."
  [forms]
  (let [rows (if (and (= 1 (count forms)) (vector? (first forms)) (every? vector? (first forms))) (first forms) forms)]
    (vec (for [r rows] (if (map? r) [(:id r) r] r)))))

(defn interim?
  "HF10-P29 (a): a record whose first line marks it INTERIM (\";; INTERIM\": not one run's outcome) counts no case."
  [s]
  (boolean (and s (str/starts-with? s ";; INTERIM"))))

(defn rfp53-counts
  "RFP53 (a): of the cell's case ids IDS (TOTAL cases as test/reap/matrix.edn counts them), the cases whose every input of INPUTS
  is :own in ROWS ([ID {INPUT VALUE ...}] a case): {:self N :recorded M}, M every other case of the cell (no row, or an input not
  :own: 0.5, RFP43 (a)); a row whose id is not the cell's counts nothing. JOP13 (a): an id the cell's records hold twice (a
  test at two checks of one cell, Java's read and classes) is two cases, as test/reap/matrix.edn counts them (at most TOTAL)."
  [ids rows inputs total]
  (let [own (set (for [r rows :when (and (vector? r) (own-case? inputs (second r)))] (first r)))
        n (min total (count (filter own ids)))]
    {:self n :recorded (max 0 (- total n))}))

(defn- cell-ids
  "The ids of the cell's cases: the first element of each row of its sources' records."
  [t crop st]
  ;; (JOP13 (a): not a source :role :beside, whose rows the matrix does not count as the cell's cases)
  (for [s (get-in (cells-spec t) [:cells [crop st] :sources]) :let [f (:file s)] :when (and (string? f) (has? t f) (not= :beside (:role s)))
        ;; (bin/hsi check's records: one map a program, HF10-P29 (a))
        r (if (= :hsi-check (:reader s)) (edn-forms t f) (edn t f)) :when (or (vector? r) (and (map? r) (:id r)))]
    (if (map? r) (:id r) (first r))))

(defn- case-inputs
  "A fact's :case-inputs {:file F} (crops.edn's :own-inputs names the crop's inputs): {:self N :recorded M :note ...} counted
  from F and the cell's record, or {:note ...} alone (the stated score stands) when the cell or F is not recorded yet."
  [t config m crop st f]
  (when-let [file (get-in f [:case-inputs :file])]
    (let [inputs (map first (get-in config [:own-inputs crop :inputs]))
          r (m [crop st])]
      (cond (empty? inputs) {:note (str "RFP53 (a): crops.edn names no :own-inputs for " (name crop) ", the stated score")}
            (not (and r (:checked r))) {:note "RFP53 (a): the cell has no record yet, the stated score"}
            (not (has? t file)) {:note (str "RFP53 (a): no " file " yet, the stated score")}
            (interim? (text t file)) {:note (str "HF10-P29 (a): " file " is marked INTERIM (not one run's outcome), the stated score")}
            :else (let [c (rfp53-counts (cell-ids t crop st) (input-rows (edn-forms t file)) inputs (cases r))]
                    (assoc c :note (str "RFP53 (a): " (:self c) " of " (+ (:self c) (:recorded c)) " cases own in all "
                                        (count inputs) " inputs (" file "), the rest 0.5")))))))

;; ---- CP333 (b) (the user, 2026-11-09; doc/cpp/CPP-SURVEY.md, "Decided (2026-11-09, the user: CP325-CP337, P23)"): C++'s eval and AOT
;; stages the mean of the programs' split and the runtime's, a program by Arbace's own route still linking a runtime of clang's IR.
;; A fact's :mean-with {:of TEXT :file F :inputs [K ...] :cases {...}} is that other part: counted from F's rows (every row a case,
;; own when each input of :inputs is :own, RFP53 (a)'s rule; an INTERIM record counts none) when F is in the tree, else its stated
;; :cases; the stage is the mean of the cell's case-weighted score and the part's. It applies only to a stage counted from its cases
;; (a stated :score stands alone, the part with it).

(defn part-counts
  "A :mean-with part's counts from its record's ROWS ([ID {INPUT VALUE}]): every row a case, own when each of INPUTS is :own."
  [rows inputs]
  (rfp53-counts (map first rows) rows inputs (count rows)))

(defn mean-with-part
  "The :mean-with part P of a fact in tree T: [score cases note], or nil when it has neither a readable file nor :cases."
  [t p]
  (let [file (:file p)]
    (cond (and file (has? t file) (not (interim? (text t file))))
          (let [c (part-counts (input-rows (edn-forms t file)) (or (:inputs p) [:ir]))]
            (when-let [[sc n] (mixed-score {:cases c})] [sc n (str (:self c) " of " n " own, " file)]))
          (map? (:cases p)) (when-let [[sc n] (mixed-score p)] [sc n "its stated cases"]))))

(defn with-part
  "CP333 (b): the stage's case-weighted score MIXED of N cases and the part [score cases note]: [mean (N + cases) note]."
  [mixed n part]
  (let [[ps pn note] part]
    [(/ (+ mixed ps) 2.0) (+ n pn) note ps]))
;; ---- 345-1 (a) (the user, 2026-11-18; queues 345, 351): a fact's :count-from {:file F :result R :own K :rest L} counts two of its
;; :cases from a results record F ([ID RESULT REASON] rows, one vector): K the rows whose result is R, L every other row, each with
;; the weight the fact states for it (K 1, L 0.5 when none), so a stage counted from a record cannot fall behind it (C++'s read: the
;; dg check's own front end's passes, test/cpp/check-dg-own-linux-amd64.edn, 823 stated while the record held 950); a missing or
;; INTERIM record leaves the stated cases

(defn count-from-cases
  "345-1 (a): CASES with SPEC's :own key the number of ROWS whose second element is SPEC's :result and its :rest key the other
  rows', each weight kept from CASES (1 and 0.5 when CASES has none)."
  [cases spec rows]
  (let [{:keys [result own rest]} spec
        n (count (filter #(= result (second %)) rows))]
    (assoc cases own [n (or (second (get cases own)) 1)] rest [(- (count rows) n) (or (second (get cases rest)) 0.5)])))

(defn count-from-problem
  "Queue 378 (the main host's review of 351, item 3): why the record's ROWS cannot be counted for CASES and SPEC, or nil: a record
  with no row, or with fewer rows than the stated cases of SPEC's :own and :rest keys (a truncated record, not marked INTERIM),
  would count as a stage whose every case is its own (an empty record gave :dg-own [0 1] and C++'s read 1.0)."
  [cases spec rows]
  (let [stated (+ (long (or (first (get cases (:own spec))) 0)) (long (or (first (get cases (:rest spec))) 0)))
        n (count rows)]
    (cond (zero? n) "no row (an empty record, not marked INTERIM)"
          (< n stated) (str n " rows, fewer than the " stated " cases stated (a truncated record, not marked INTERIM)")
          :else nil)))

;; ---- 497-3 (a) (the main session, 2026-11-20; the user's rule of 2026-11-20): a :count-from's :out CLASSES leaves out of the
;; counted rows the cases the judge counts out, the ids its :kind :na classes name in :tests (C++'s dg :undefined-expectation:
;; expected errors no conforming front end owes), as reap leaves them out of the cell's denominator; their runs stay in the record

(defn na-ids
  "497-3 (a): the ids the :kind :na classes of CLASSES (a classes file's forms) name in :tests."
  [classes]
  (set (for [c classes :when (and (map? c) (= :na (:kind c))) id (:tests c)] id)))

(defn- count-from
  "345-1 (a): fact F's :count-from in tree T: {:cases ... :note ...}, {:note ...} alone (the stated cases stand), {:refused ...
  :note ...} (queue 378: the record refused, the stated cases standing and the claim refuted), or nil."
  [t f]
  (when-let [spec (:count-from f)]
    (let [file (:file spec)]
      (cond (not (has? t file)) {:note (str "345-1 (a): no " file ", the stated cases")}
            (interim? (text t file)) {:note (str "345-1 (a): " file " is marked INTERIM, the stated cases")}
            :else (let [rows (filter #(and (vector? %) (string? (first %))) (input-rows (edn-forms t file)))
                        bad (count-from-problem (:cases f) spec rows)
                        ;; (497-3 (a): the judge's counted-out cases left out, after the record's own check)
                        out (when-let [cf (:out spec)] (when (has? t cf) (na-ids (edn t cf))))
                        kept (if (seq out) (remove #(contains? out (first %)) rows) rows)
                        c (count-from-cases (:cases f) spec kept)]
                    (if bad
                      {:refused (str "345-1 (a): " file " refused: " bad) :note (str "345-1 (a): " file " refused, the stated cases")}
                      {:cases c :note (str "345-1 (a): " (first (get c (:own spec))) " of " (count kept) " " (name (:result spec))
                                         " rows counted from " file
                                         (when (< (count kept) (count rows)) (str " (" (- (count rows) (count kept)) " n/a by " (:out spec) ")")))}))))))

;; ---- JOP7 (a) (the user, 2026-11-17; taken overnight, round 52): a fact's :requires-line {:file F :line L :why W} holds the
;; stage at 0.5 at most until F has the line L exactly (Java's: jdk/javac/platform.sha256's "# kind: own", the own platform's
;; pin, JOP2 (a)): a claim above 0.5 on a tree whose F lacks it is refuted, so the facts cannot move ahead of the switch

(defn requires-line-problem
  "The refutation of fact F's :requires-line against S, the text of its :file (nil: no file), or nil when F names none or S
  holds the line."
  [f s]
  (when-let [{:keys [file line why]} (:requires-line f)]
    (when-not (and s (some #{line} (str/split-lines s)))
      (str file " has no line " (pr-str line) (when why (str " (" why ")")) ": held at 0.5"))))

;; ---- JOP13 (a) (taken overnight, round 52; doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JOP13 (a)"): a fact's
;; :requires-record {:file F :why W} holds the stage at 0.5 at most until F exists, is one run's outcome (not INTERIM) and has a
;; row for every case of the cell (Java's: test/java/sources.edn, the source sets javac on Arbace made, a row a test), so a
;; stated score cannot count a record that is missing or covers only some tests; with it, :case-inputs counts the cases

(defn requires-record-problem
  "The refutation of fact F's :requires-record against S, the text of its :file (nil: no file), ROWS its rows ([ID ...]) and
  IDS the cell's case ids, or nil when F names none or the record covers every case."
  [f s rows ids]
  (when-let [{:keys [file why]} (:requires-record f)]
    (let [have (set (map first (filter vector? rows)))
          ids (distinct ids)
          missing (remove have ids)]
      (cond (nil? s) (str "no " file (when why (str " (" why ")")) ": held at 0.5")
            (interim? s) (str file " is marked INTERIM: held at 0.5")
            (empty? ids) (str file ": the cell has no recorded case to cover: held at 0.5")
            (seq missing) (str file " covers " (- (count ids) (count missing)) " of " (count ids) " of the cell's tests (none for "
                               (first missing) (when (next missing) ", ...") ")" (when why (str " (" why ")")) ": held at 0.5")))))

;; ---- OC222 (a) (the user, 2026-11-10): a class of :kind :na is ocamltest's own skip on the pinned configuration

(defn na-class-problems
  "The problems of class C of FILE (:kind :na) under OC222 (a)'s rule, CONF its :config file read (nil when absent): :skips
  {PROGRAM ACTION} covering :programs exactly, each ACTION one of CONF's :actions and failing on CONF's :config, and :match
  taking only the rows outside the run corpus (\"^class \": a program that runs and fails is never :na)."
  [file c conf]
  (let [skips (:skips c) progs (:programs c) where (str file ": class " (:id c) " (:na)")]
    (cond (not (map? skips)) [(str where " has no :skips (OC222 (a): ocamltest's own skip on the pinned configuration)")]
          (nil? conf) [(str where ": its :config " (pr-str (:config c)) " is not there")]
          :else (concat
                 (when (empty? progs) [(str where " lists no :programs")])
                 (when (seq (:tests c)) [(str where " takes :tests (only :programs with :skips)")])
                 (for [re (:match c) :when (not (str/starts-with? (str re) "^class "))]
                   (str where ": :match " (pr-str (str re)) " takes rows a run judged (only \"^class \" rows)"))
                 (for [p progs :when (not (contains? skips p))] (str where ": " p " names no skipping action"))
                 (for [p (keys skips) :when (not (some #{p} progs))] (str where ": " p " is in :skips, not in :programs"))
                 (for [[p a] skips :let [req (get-in conf [:actions a])]
                       :when (or (nil? req) (= (get-in conf [:config (:key req)]) (:passes req)))]
                   (if req
                     (str where ": " p "'s action " a " passes on the pinned configuration (" (:key req) " " (:passes req) "): ocamltest runs it")
                     (str where ": " p "'s action " a " is not among " (:config c) "'s :actions")))))))

(defn- na-problems
  "OC222 (a): the problems of every :na class in the crop's cells' classes, for a crop with crops.edn's :na-rules."
  [t config crop]
  (when (get-in config [:na-rules crop])
    (let [spec (cells-spec t)
          files (distinct (for [l levels :let [c (get-in spec [:cells [crop l]])]
                                x (cons (:classes c) (map :classes (:sources c)))
                                f (if (sequential? x) x [x]) :when (string? f)]
                            f))]
      (doall (for [f files :when (has? t f) c (edn t f) :when (and (map? c) (= :na (:kind c)))
                   p (na-class-problems f c (when-let [cf (:config c)] (when (has? t cf) (edn t cf))))]
               p)))))

;; ---- the cross-checks beyond the steps' hosts (the independence audit, 2026-11-09; the user's ruling (5))

;; (a) the files a step runs: the scripts its command names, and every file of bin/ or test/ those name by the root
;; ($root/..., (str root "/...")), to a depth of 4, each with the file that named it (its referrer)
(def ^:private cmd-file-re #"(?:^|[\s\"'(=])((?:bin|test)/[A-Za-z0-9_.+-]+(?:/[A-Za-z0-9_.+-]+)*)")
(def ^:private ref-file-re #"(?:\$\{?root\}?\"?|\(str root \")/((?:bin|test)/[A-Za-z0-9_.+-]+(?:/[A-Za-z0-9_.+-]+)*)")

(defn- code-file?
  "A file the step runs that the rules read: a script of bin/, a .bash, .sh or .ae file of bin/ or test/ (not data: .edn, .txt,
  .tsv, .sha256; not the helpers' sources under tools/)."
  [f]
  (and (re-find #"^(bin|test)/" f)
       (or (re-find #"\.(bash|sh|ae)$" f) (and (re-find #"^bin/" f) (not (re-find #"\.[a-z0-9]+$" f))))))

(defn- step-files
  "The files step S runs (its :cmd's scripts and what they name by the root, to depth 4) as [file referrer] pairs."
  [t s]
  (loop [todo (for [[_ f] (re-seq cmd-file-re (str (:cmd s))) :when (has? t f)] [f nil]) seen {} depth 0]
    (if (or (empty? todo) (> depth 4))
      (vec seen)
      (let [new (remove #(contains? seen (first %)) todo)
            seen (into seen new)
            next (distinct (for [[f _] new :let [x (when (code-file? f) (text t f))] :when x
                                 [_ g] (re-seq ref-file-re x)
                                 :let [g (str/replace g #"[.]+$" "")]
                                 :when (and (not (contains? seen g)) (has? t g))]
                             [g f]))]
        (recur next seen (inc depth))))))

(defn- toolchain-reads
  "(a): the steps' files that read a toolchain's files by path (crops.edn's :toolchain-reads: a rule's :reads in the file's
  text), unless the file or its referrer matches the rule's :unless (the sysroot that replaces them); [step rule file]."
  [t config live]
  (for [s live [f by] (step-files t s) :when (code-file? f) rule (:toolchain-reads config)
        :let [x (text t f)]
        :when (and x (re-find (:reads rule) x)
                   (not (re-find (:unless rule) x))
                   (not (and by (some->> (text t by) (re-find (:unless rule))))))]
    [(:name s) rule f]))

;; (b) a cell's record written by a live helper: a sentence of its header (its leading comment lines) naming a helper's path
;; (crops.edn's :helper-records :names) that is not a comparison with the helper or a pin (:ok)
(defn- record-header [t f]
  (when-let [x (text t f)]
    (->> (str/split-lines x) (take 60) (take-while #(or (re-find #"^\s*(;;|#)" %) (str/blank? %) (re-find #"^\s*[\[{]\s*$" %)))
         (filter #(re-find #"^\s*(;;|#)" %))
         (map #(str/replace % #"^\s*(;;+|#+)\s?" ""))
         (str/join " "))))

(defn- helper-records
  "(b): the records of the cell [CROP STAGE] whose header says a live helper wrote them; [file sentence]."
  [t config crop st]
  (let [spec (cells-spec t)
        {:keys [names ok]} (:helper-records config)
        files (record-files t (get-in spec [:cells [crop st] :sources]))]
    (for [f files :let [h (record-header t f)] :when h
          sentence (str/split h #"(?<=[.;])\s+")
          :when (and (re-find names sentence) (not (re-find ok sentence)))]
      [f (str/trim sentence)])))

(defn- independence [t cfg config ind steps m]
  (let [crop (:id cfg)
        facts (get ind crop)
        at (get-in facts [:at (or (:ref t) "checkout")])
        tool-hosts (set (:toolchain-hosts config))
        ;; a host use that is not the toolchain's (crops.edn's :host-uses: a step's java -version alone, the frozen jar's JVM)
        exempt? (fn [s h] (some (fn [u] (and (= h (:host u))
                                             (or (and (:steps u) (re-find (:steps u) (str (:name s))))
                                                 (and (:with-host u) (some #{(:with-host u)} (:hosts s))
                                                      (not (and (:unless-steps u) (re-find (:unless-steps u) (str (:name s)))))))))
                                (:host-uses config)))
        by-name (group-by #(str (:name %)) steps)
        rows (for [st stages
                   :let [f (merge (get-in facts [:stages st]) (get at st))
                         ci (case-inputs t config m crop st f)
                         f (if (:self ci) (assoc f :cases (select-keys ci [:self :recorded]) :rfp53 true) f)
                         cf (count-from t f)
                         f (if (:cases cf) (assoc f :cases (:cases cf)) f)
                         named (mapcat #(by-name (str %)) (:steps f))
                         live (remove #(= :oracle (:phase %)) named)
                         hosted (for [s live h (:hosts s) :when (and (tool-hosts h) (not (exempt? s h)))] [(:name s) h])
                         reads (when (nil? (:ref t)) (toolchain-reads t config live))
                         helped (when (and (nil? (:ref t)) (some #{st} levels)) (helper-records t config crop st))
                         [mixed nmixed] (mixed-score f)
                         part (when (and mixed (:mean-with f)) (mean-with-part t (:mean-with f)))
                         [mixed nmixed part-note part-score] (if part (with-part mixed nmixed part) [mixed nmixed])
                         stated (:score f)
                         claim (if mixed (/ (Math/round (* 1000.0 mixed)) 1000.0) stated)
                         refuted-reads (and (seq reads) claim (pos? claim))
                         refuted-helper (and (seq helped) claim (> claim 0.5))
                         unpinned (when (and claim (> claim 0.5)) (requires-line-problem f (some->> (get-in f [:requires-line :file]) (text t))))
                         ;; queue 378: a :count-from record refused (no row, fewer rows than stated) holds the stage at 0.5
                         unpinned (or unpinned (when (and claim (> claim 0.5)) (:refused cf)))
                         ;; JOP13 (a): the record the stage consumes must exist and cover the cell's cases
                         unpinned (or unpinned
                                      (when (and claim (> claim 0.5) (:requires-record f))
                                        (let [rf (get-in f [:requires-record :file]) s (when (has? t rf) (text t rf))]
                                          (requires-record-problem f s (when (and s (not (interim? s))) (input-rows (edn-forms t rf)))
                                                                   (cell-ids t crop st)))))
                         unverified (and claim (pos? claim) (empty? live))
                         score (cond (nil? claim) 0.0
                                     (and (seq hosted) (pos? claim)) 0.0
                                     refuted-reads 0.0
                                     refuted-helper 0.0
                                     unpinned 0.5
                                     :else (double claim))
                         check (cond (nil? claim) "no fact (test/crops/independence.edn)"
                                     (seq hosted) (str (if (pos? claim) "CLAIM REFUTED: " "steps agree: ")
                                                       (str/join ", " (for [[n h] hosted] (str n " on " h))))
                                     refuted-reads (str "CLAIM REFUTED: "
                                                        (str/join ", " (distinct (for [[n rule fl] reads] (str n " runs " fl ", which reads " (:what rule)
                                                                                                                " (no " (:instead rule) ")")))))
                                     refuted-helper (str "CLAIM REFUTED: the cell's record written by a live helper: "
                                                         (str/join "; " (distinct (for [[fl sn] helped] (str fl " (\"" sn "\")")))))
                                     unpinned (str "CLAIM REFUTED: " unpinned)
                                     (seq live) (if (zero? claim)
                                                  (str "claim 0 though " (str/join ", " (map :name live)) " name no toolchain host")
                                                  (str "steps agree: " (str/join ", " (map :name live)) " on no toolchain host"))
                                     (seq (:steps f)) (str "UNVERIFIED: its :steps (" (str/join ", " (:steps f)) ") are not the tree's steps outside the oracle tier")
                                     (pos? claim) "UNVERIFIED: no :steps (no step of the tree runs it)"
                                     :else "claimed (no step of the tree runs it)")
                         check (if (:note ci) (str check "; " (:note ci)) check)
                         check (if (:note cf) (str check "; " (:note cf)) check)
                         check (if mixed
                                 (str check (if part-note
                                              (str "; CP333 (b): the mean of the cell's case-weighted score and " (get-in f [:mean-with :of] "its other part")
                                                   "'s (" (format "%.3f" (double part-score)) ": " part-note "), " nmixed " cases")
                                              (str "; the case-weighted mean of " nmixed " cases"))
                                      (when (and (number? stated) (> (Math/abs (- (double stated) mixed)) 0.005))
                                        (str " (the fact states " stated ")")))
                                 check)]]
               {:stage st :score score :fact f :check check :unverified (boolean (and unverified (not (str/starts-with? check "CLAIM REFUTED"))))})]
    {:stages rows :score (/ (reduce + (map :score rows)) (count rows))
     :facts-of (cond (nil? (:ref t)) "the checkout" at (:ref t) :else (str "the checkout (no :at for " (:ref t) ")"))
     :refuted (filter #(str/starts-with? (:check %) "CLAIM REFUTED") rows)
     :unverified (filter :unverified rows)}))

;; ---- the newest held branch

(defn- newest-ref [cfg]
  (let [out (:out (git "for-each-ref" "--sort=-committerdate" "--format=%(refname:short)" "refs/remotes/mac"))
        refs (filter #(and (:branches cfg) (re-find (:branches cfg) %)) (str/split-lines out))]
    (first (filter (fn [r] (let [t (tree r)]
                             (some #{(:id cfg)} (:languages (cells-spec t)))))
                   refs))))

;; ---- output

(defn- pct [x] (format "%.1f%%" (* 100.0 (double x))))

(defn- score-crop [cfg config ind ref inputs]
  (let [t (tree ref)
        m (matrix t inputs)
        steps (steps-of t)]
    {:crop cfg :ref (or ref "checkout")
     :completeness (completeness (:id cfg) m)
     :maturity (maturity t cfg config m steps)
     :independence (independence t cfg config ind steps m)
     :na-problems (na-problems t config (:id cfg))}))

(defn- cell-text [c]
  (let [r (:record c)]
    (str (level-names (:level c)) " " (pct (:score c)) " (" (pct (:meant c)) " without by design)"
         (if r (str " (" (:pass r) " pass / " (:design r) " design / " (:deferred r) " deferred / " (:pending r) " pending"
                   (when (pos? (:na r 0)) (str "; " (:na r) " n/a, outside both denominators")) ")") "")
         (when (:flag c) (str " [" (:flag c) "]")))))

(defn- print-details [s]
  (let [cfg (:crop s)]
    (println (str "## " (:name cfg) " (" (:ref s) ")"))
    (println (str "completeness " (pct (get-in s [:completeness :score])) "; " (pct (get-in s [:completeness :meant]))
                  " of what is meant to pass (by design out, CSP4):"))
    (doseq [c (get-in s [:completeness :cells])] (println (str "   " (cell-text c))))
    (println (str "maturity " (pct (get-in s [:maturity :score])) ":"))
    (doseq [i (get-in s [:maturity :items])]
      (println (str "   " (pct (:value i)) "  " (:title i) ": " (:evidence i))))
    (println (str "independence " (pct (get-in s [:independence :score])) " (facts of " (get-in s [:independence :facts-of]) "):"))
    (doseq [r (get-in s [:independence :stages]) :let [f (:fact r)]]
      (println (str "   " (level-names (:stage r)) " " (let [x (double (:score r))] (if (== x (Math/rint x)) (str x) (format "%.3f" x))) ": " (or (:tool f) "?")
                    (when (seq (:host f)) (str "; host " (str/join " " (map name (:host f)))))
                    (when (:why f) (str "; " (:why f)))
                    (let [{:keys [self recorded]} (:cases f)]
                      (when (and (number? self) (number? recorded) (not (:rfp53 f)))
                        (str "; " self " cases by their own verdict, " recorded " by a toolchain's record: (" self " + 0.5 x " recorded ") / " (+ self recorded))))
                    " [" (:check r) "]")))
    (println)))

(defn- tsv [scores]
  (println (str/join "\t" (concat ["crop" "ref" "completeness" "maturity" "independence" "completeness-meant"]
                                  (for [l levels k ["pass" "design" "deferred" "pending"]] (str (name l) "-" k))
                                  (map #(str "m-" (name %)) [:cells :classed :controls :gate :reap :pins])
                                  (map #(str "i-" (name %)) stages))))
  (doseq [s scores]
    (println (str/join "\t" (concat [(name (get-in s [:crop :id])) (:ref s)
                                     (format "%.3f" (get-in s [:completeness :score]))
                                     (format "%.3f" (get-in s [:maturity :score]))
                                     (format "%.3f" (get-in s [:independence :score]))
                                     (format "%.3f" (get-in s [:completeness :meant]))]
                                    (for [c (get-in s [:completeness :cells]) k [:pass :design :deferred :pending]]
                                      (if (:record c) (get (:record c) k 0) ""))
                                    (map #(format "%.2f" (:value %)) (get-in s [:maturity :items]))
                                    (map #(str (:score %)) (get-in s [:independence :stages])))))))

(defn- table [scores]
  (println "| crop | ref | completeness | (without by design) | maturity | independence |")
  (println "|---|---|---|---|---|---|")
  (doseq [s scores]
    (println (str "| " (get-in s [:crop :name]) " | " (:ref s) " | " (pct (get-in s [:completeness :score]))
                  " | " (pct (get-in s [:completeness :meant])) " | " (pct (get-in s [:maturity :score])) " | " (pct (get-in s [:independence :score])) " |"))))

(defn- judge-check
  "--judge: the checkout's matrix judged afresh by reap.main (its readers and judging), against
  test/reap/matrix.edn; the differences."
  []
  (require 'reap.main)
  (let [spec (read-file "test/reap/cells.edn")
        judge @(ns-resolve 'reap.main 'judge-cell)
        record @(ns-resolve 'reap.main 'cell-record)
        old (into {} (for [r (read-file "test/reap/matrix.edn")] [(:cell r) r]))]
    (with-bindings {(ns-resolve (quote reap.main) (quote *root*)) *root*}
      (doall
       (for [[k c] (:cells spec)
             :let [r (record k (judge c)) o (old k)]
             :when (not= (select-keys r [:checked :pass :design :deferred :pending])
                         (select-keys o [:checked :pass :design :deferred :pending]))]
         (str (pr-str k) ": judged " (pr-str (select-keys r [:pass :design :deferred :pending]))
              ", recorded " (pr-str (select-keys o [:pass :design :deferred :pending]))))))))

;; ---- the record (CSP1 (b)): test/crops/scores.edn, the checkout's scores; any difference fails until --record writes it

(def ^:private scores-file "test/crops/scores.edn")

(defn- f4 [x] (format "%.4f" (double x)))

(defn- score-line
  "A crop's scores as its record's line: the three (and CSP4's), each cell's counts, each item, each stage."
  [s]
  (str " {:crop " (get-in s [:crop :id])
       " :completeness " (f4 (get-in s [:completeness :score])) " :meant " (f4 (get-in s [:completeness :meant]))
       " :maturity " (f4 (get-in s [:maturity :score])) " :independence " (f4 (get-in s [:independence :score]))
       "\n  :cells " (pr-str (vec (for [c (get-in s [:completeness :cells]) :let [r (:record c)]]
                                   [(:level c) (boolean (:checked r)) (:pass r 0) (:design r 0) (:deferred r 0) (:pending r 0)])))
       "\n  :items " (pr-str (vec (for [i (get-in s [:maturity :items])] [(:id i) (symbol (f4 (:value i)))])))
       "\n  :stages " (pr-str (vec (for [r (get-in s [:independence :stages])] [(:stage r) (symbol (f4 (:score r)))]))) "}"))

(defn- scores-text [scores]
  (str ";; bin/crops-score's record (doc/CROPS-SCORE.md, CSP1 (b), the user's decision of 2026-11-06): the checkout's scores per\n"
       ";; crop, as bin/crops-score computes them from the records (completeness, CSP4's without by design, maturity,\n"
       ";; independence; each cell's checked, pass, design, deferred, pending; each maturity item; each stage). bin/crops-score\n"
       ";; fails on any difference from it (the gate's crops-score step), so that every change of a score is made on purpose;\n"
       ";; bin/crops-score --record writes it. Read with the Clojure reader.\n"
       "[\n" (str/join "\n" (map score-line scores)) "\n]\n"))

(defn- record-lines
  "The record's lines by crop: the crop's id and its text, as score-line writes it."
  []
  (let [f (File. ^String (str *root* "/" scores-file))]
    (when (.isFile f)
      (into {} (for [[_ id body] (re-seq #"(?ms)^ \{:crop :([a-z][a-z0-9-]*) (.*?)\}$" (slurp f))]
                 [(keyword id) (str " {:crop :" id " " body "}")])))))

(defn- record-diffs [scores]
  (let [old (record-lines)]
    (if-not old
      [(str "no " scores-file " (bin/crops-score --record writes it)")]
      (for [s scores :let [id (get-in s [:crop :id]) now (score-line s) was (old id)]
            :when (not= now was)]
        (str scores-file ": " (name id) (if was (str " differs:\n      now " (str/replace now "\n" " ") "\n      was " (str/replace was "\n" " "))
                                            " not recorded"))))))

;; ---- the rulings' own tests (fabricated cases; run by --self-test and by every --judge): each ruling's number as its plan
;; computes it, and a negative control each that must not pass

(defn self-test
  "The failures of the rulings' tests (empty when every test passes and every control fails as it must)."
  []
  (let [inputs [:c1 :c2 :c3 :c4 :c5 :c6 :c7]
        own (zipmap inputs (repeat :own))
        ids (for [i (range 1 74)] (format "test/rust/x/c%02d.rs" i))
        rows (vec (concat (for [id (take 37 ids)] [id own])
                          (for [id (drop 37 ids)] [id (assoc own :c6 "pack: std's IR (Cargo, rustc, clang)")])
                          [["test/rust/x/outside.rs" own]]))
        indep (fn [counts]
                (let [[e] (mixed-score {:cases counts})
                      [j] (mixed-score {:cases {:self 66692 :recorded 146}})]
                  (format "%.1f" (* 100.0 (/ (+ 1 e e 1 j) 5)))))
        c37 (rfp53-counts ids rows inputs 73)
        ;; HF10-P29 (a): bin/hsi check --libs own's lines, one map a program, counted as :libs :own; the control the same
        ;; programs on the pack; an INTERIM record counts none
        hs-ids (for [i (range 1 11)] (format "samples/P%02d" i))
        hs-own (rfp53-counts hs-ids (input-rows (concat (for [id (take 4 hs-ids)] {:id id :result :pass :libs :own})
                                                        (for [id (drop 4 hs-ids)] {:id id :result :pass :libs :pack})))
                             [:libs] 10)
        hs-ctl (rfp53-counts hs-ids (input-rows (for [id hs-ids] {:id id :result :pass :libs :pack})) [:libs] 10)
        ;; the control: the same 37 cases with C7 test/c/host (ci on gcc's recorded host): none own, the stage 0.5
        ctl-rows (vec (for [[id m] rows] [id (if (= m own) (assoc m :c7 "test/c/host") m)]))
        ctl (rfp53-counts ids ctl-rows inputs 73)
        conf {:config {"architecture" "amd64" "system" "linux" "os_type" "Unix" "tsan" "false" "flambda" "false" "with_frame_pointers" "false"}
              :actions {"tsan" {:key "tsan" :passes "true"} "arch_amd64" {:key "architecture" :passes "amd64"}
                        "target-windows" {:key "os_type" :passes "Win32"}}}
        cls (fn [skips & kv] (merge {:id :config-skipped :kind :na :config "c.edn" :skips skips :programs (vec (keys skips))
                                           :match [#"^class header: "]} (apply hash-map kv)))
        good (na-class-problems "d.edn" (cls {"tsan/a" "tsan" "lib-filename/windows" "target-windows"}) conf)
        controls {"an amd64 program on amd64" (na-class-problems "d.edn" (cls {"native-debugger/linux-gdb-amd64" "arch_amd64"}) conf)
                  "an action not recorded" (na-class-problems "d.edn" (cls {"x/y" "arch_s390x"}) conf)
                  "a program with no action" (na-class-problems "d.edn" (cls {"tsan/a" "tsan"} :programs ["tsan/a" "tsan/b"]) conf)
                  "a run's failure taken" (na-class-problems "d.edn" (cls {"tsan/a" "tsan"} :match [#"^fail "]) conf)
                  "no :skips" (na-class-problems "d.edn" (dissoc (cls {"tsan/a" "tsan"}) :skips) conf)
                  "no configuration" (na-class-problems "d.edn" (cls {"tsan/a" "tsan"}) nil)}
        cell (fn [p d f na] {:checked true :pass p :design d :deferred f :pending 0 :na na})
        compl (fn [m] (format "%.1f" (* 100.0 (:score (completeness :ocaml m)))))
        before {[:ocaml :read] (cell 3082 80 0 0) [:ocaml :eval] (cell 477 195 4 0) [:ocaml :aot] (cell 419 191 66 0) [:ocaml :print] (cell 3080 0 2 0)}
        after (assoc before [:ocaml :eval] (cell 477 162 4 33) [:ocaml :aot] (cell 419 158 66 33))
        ;; CP333 (b) (queue 324): 60 of C++'s 82 programs by Arbace's own IR, the runtime's 198 units the pack's: (60 + 0.5 x 22) / 82 =
        ;; 0.866 and 0.5, the stage 0.683; with libsupc++'s 62 and CP348's 13 units own, 0.689 and 0.778; the control the same
        ;; runtime with its units' :ir a string (the pack's): it must not count one own
        cpp-ids (for [i (range 82)] (format "gxx-dg-run/p%02d.C" i))
        cpp-rows (vec (for [[i id] (map-indexed vector cpp-ids)] [id {:ir (if (< i 60) :own "pack: cpp-ir-gxx-dg-run")}]))
        cpp-c (rfp53-counts cpp-ids cpp-rows [:ir] 82)
        units (for [i (range 198)] (format "u%03d" i))
        rt-pack (part-counts (vec (for [u units] [u {:ir "pack: cpp-runtime-ir"}])) [:ir])
        rt-75 (part-counts (vec (for [[i u] (map-indexed vector units)] [u {:ir (if (< i 75) :own "pack: cpp-runtime-ir")}])) [:ir])
        cpp-stage (fn [rc] (let [[m n] (mixed-score {:cases cpp-c}) [ps pn] (mixed-score {:cases rc})] (format "%.3f" (first (with-part m n [ps pn ""])))))
        ;; CP400 (a), CP401 (a) (n-cpp-indep, taken overnight, round 52): C++'s cell of 81 cases, 50 own
        ;; in :ir and :ci-target, 20 on clang's pack, 11 with no row; its runtime 62 of 198 units own (the :mean-with part): the stage
        ;; the mean of (50 + 0.5 x 31) / 81 and (62 + 0.5 x 136) / 198, 0.733; the control: the same with ci on gcc's recorded
        ;; test/c/host, none own, the runtime's units too: 0.5
        cx-in [:ir :ci-target]
        cx-own {:ir :own :ci-target :own}
        cx-ids (for [i (range 1 82)] (format "gxx-dg-run/p%02d.C" i))
        cx-rows (vec (concat (for [id (take 50 cx-ids)] [id cx-own])
                             (for [id (take 20 (drop 50 cx-ids))] [id (assoc cx-own :ir "pack: cpp-ir-gxx-dg-run")])))
        cx-rt (vec (for [i (range 198)] [(str "u" i) (if (< i 62) cx-own (assoc cx-own :ir "pack: cpp-runtime-ir"))]))
        cx-stage (fn [rows rt] (let [[m n] (mixed-score {:cases (rfp53-counts cx-ids rows cx-in 81)})
                                     [ps pn] (mixed-score {:cases (part-counts rt cx-in)})]
                                 (format "%.3f" (first (with-part m n [ps pn ""])))))
        cx-host (fn [rows] (vec (for [[id m] rows] [id (assoc m :ci-target "gcc's recorded answers, test/c/host")])))
        cx-good (cx-stage cx-rows cx-rt)
        cx-ctl (cx-stage (cx-host cx-rows) (cx-host cx-rt))
        ;; JOP7 (a): the own pin holds the line; the build tree's pin, and a pin that only mentions it, refute the claim
        req {:score 1 :requires-line {:file "jdk/javac/platform.sha256" :line "# kind: own"}}
        own-pin "# The platform of javac on Arbace\n# kind: own\nabc  java.base\n"
        build-pin "# The platform of javac on Arbace (JFS15 (b)): jdk26u's build tree\nabc  java.base\n"
        near-pin "# kind: own (not yet: the switch night writes it)\nabc  java.base\n"
        ;; JOP13 (a): Java's read cell of 10 cases, 4 tests at read and classes each and 2 golden-diagnostics tests; the own
        ;; record's rows with :platform and :sources :own count 10 of 10 (1.0); the control, the same rows on the build tree's
        ;; platform, 0 (0.5); one test own counts twice (read and classes); the guard: a record covering every test passes, one
        ;; without a test, no record and an INTERIM one hold the stage at 0.5
        jv-in [:platform :sources]
        jv-ids (concat ["t1" "t2" "t3" "t4"] ["t1" "t2" "t3" "t4"] ["d1" "d2"])
        jv-rows (vec (for [id ["t1" "t2" "t3" "t4" "d1" "d2"]] [id {:sources :own :platform :own}]))
        jv-build (vec (for [[id m] jv-rows] [id (assoc m :platform "jdk26u's build tree (jdk/javac/platform.sha256)")]))
        jv-own (rfp53-counts jv-ids jv-rows jv-in 10)
        jv-ctl (rfp53-counts jv-ids jv-build jv-in 10)
        jv-one (rfp53-counts jv-ids [["t1" {:sources :own :platform :own}]] jv-in 10)
        jv-f {:score 1 :requires-record {:file "test/java/sources.edn"}}
        jv-text ";; the own record\n[]\n"
        ;; 345-1 (a): C++'s read counted from the dg own record: 950 :pass of 4,564 rows beside the token check's 1,931 give
        ;; (1931 + 950 + 0.5 x 3614) / 6495 = 0.722; the control, the record with one pass turned :fail, must move the count
        cf-spec {:file "x.edn" :result :pass :own :dg-own :rest :dg-clang}
        cf-cases {:tokens [1931 1] :dg-own [823 1] :dg-clang [3741 0.5]}
        cf-rows (vec (for [i (range 4564)] [(str "gxx-dg/f" i ".C") (if (< i 950) :pass :fail) "r"]))
        cf-good (count-from-cases cf-cases cf-spec cf-rows)
        cf-ctl (count-from-cases cf-cases cf-spec (assoc cf-rows 0 ["gxx-dg/f0.C" :fail "r"]))
        ;; queue 378: the record refused when empty or shorter than the stated cases (823 + 3741 = 4564); the full one counted
        cf-empty (count-from-problem cf-cases cf-spec [])
        cf-short (count-from-problem cf-cases cf-spec (subvec cf-rows 0 4000))
        cf-full (count-from-problem cf-cases cf-spec cf-rows)
        ;; 497-3 (a): the ids of the :na classes counted out, five of the 3,614 failing rows: (1931 + 950 + 0.5 x 3609) / 6490;
        ;; the control, the same class :deferred, counts none out
        na-cls [{:id :u :kind :na :tests (vec (for [i (range 950 955)] (str "gxx-dg/f" i ".C")))} {:id :d :kind :deferred :tests ["gxx-dg/f956.C"]}]
        na-out (na-ids na-cls)
        cf-na (count-from-cases cf-cases cf-spec (vec (remove #(contains? na-out (first %)) cf-rows)))
        na-ctl (na-ids (assoc-in na-cls [0 :kind] :deferred))
        ;; 502-2 (a) (queue 504): a second :na class (:host-dependent-expectation's template/nontype10.C beside
        ;; :undefined-expectation's five) counted out by the same :out, six rows: 3,608 at 0.5; the control, that class
        ;; :design (:musl-libc's kind, where nontype10 was), counts its row in again
        na2-cls (conj na-cls {:id :h :kind :na :tests ["gxx-dg/f957.C"]})
        na2-out (na-ids na2-cls)
        cf-na2 (count-from-cases cf-cases cf-spec (vec (remove #(contains? na2-out (first %)) cf-rows)))
        na2-ctl (na-ids (assoc-in na2-cls [2 :kind] :design))]
    (concat
     (when-not (= c37 {:self 37 :recorded 36}) [(str "RFP53: 37 of 73 own counted " (pr-str c37))])
     (when-not (= "90.1" (indep c37)) [(str "RFP53: 37 of 73 own gives " (indep c37) ", the plan 90.1")])
     (when-not (= "80.0" (indep {:self 0 :recorded 73})) [(str "RFP53: none own gives " (indep {:self 0 :recorded 73}) ", not 80.0")])
     (when-not (= ctl {:self 0 :recorded 73}) [(str "RFP53 control (C7 test/c/host) passed: counted " (pr-str ctl))])
     (when-not (= hs-own {:self 4 :recorded 6}) [(str "HF10-P29: 4 of 10 :libs :own counted " (pr-str hs-own))])
     (when-not (= hs-ctl {:self 0 :recorded 10}) [(str "HF10-P29 control (every program :libs :pack) passed: counted " (pr-str hs-ctl))])
     (when-not (and (interim? ";; INTERIM (review)\n{:id \"a\"}") (not (interim? ";; hsi's check\n;; INTERIM"))) ["HF10-P29: the INTERIM mark misread"])
     (when (= "90.1" (indep ctl)) ["RFP53 control (C7 test/c/host) reached 90.1"])
     (when-not (= "0.733" cx-good) [(str "CP401: C++'s 50 of 81 own with the runtime's 62 of 198 gives " cx-good ", expected 0.733")])
     (when-not (= "0.500" cx-ctl) [(str "CP401 control (ci on test/c/host) passed: the stage " cx-ctl ", not 0.500")])
     (when (seq good) [(str "OC222: a valid :na class refused: " (first good))])
     (for [[k v] controls :when (empty? v)] (str "OC222 control passed: " k))
     (when-not (= cpp-c {:self 60 :recorded 22}) [(str "CP333 (b): 60 of 82 programs own counted " (pr-str cpp-c))])
     (when-not (= rt-pack {:self 0 :recorded 198}) [(str "CP333 (b) control (every unit the pack's) passed: counted " (pr-str rt-pack))])
     (when-not (= "0.683" (cpp-stage rt-pack)) [(str "CP333 (b): 60 of 82 own on the pack's runtime gives " (cpp-stage rt-pack) ", the plan 0.683")])
     (when-not (= "0.778" (cpp-stage rt-75)) [(str "CP333 (b): with 75 runtime units own gives " (cpp-stage rt-75) ", the plan 0.778")])
     (when (requires-line-problem req own-pin) [(str "JOP7: the own pin refused: " (requires-line-problem req own-pin))])
     (when (requires-line-problem {:score 1} build-pin) ["JOP7: a fact without :requires-line refuted"])
     (when-not (requires-line-problem req build-pin) ["JOP7 control (the build tree's pin) passed"])
     (when-not (requires-line-problem req near-pin) ["JOP7 control (a pin that only mentions the line) passed"])
     (when-not (requires-line-problem req nil) ["JOP7 control (no pin file) passed"])
     (when-not (= jv-own {:self 10 :recorded 0}) [(str "JOP13: 10 of 10 Java cases own counted " (pr-str jv-own))])
     (when-not (= "1.000" (format "%.3f" (first (mixed-score {:cases jv-own})))) ["JOP13: 10 of 10 own does not give 1"])
     (when-not (= jv-ctl {:self 0 :recorded 10}) [(str "JOP13 control (the build tree's platform) passed: counted " (pr-str jv-ctl))])
     (when-not (= jv-one {:self 2 :recorded 8}) [(str "JOP13: one test at read and classes counted " (pr-str jv-one) ", not 2 cases")])
     (when (requires-record-problem jv-f jv-text jv-rows jv-ids) [(str "JOP13: a covering record refused: " (requires-record-problem jv-f jv-text jv-rows jv-ids))])
     (when (requires-record-problem {:score 1} nil [] jv-ids) ["JOP13: a fact without :requires-record refuted"])
     (when-not (requires-record-problem jv-f jv-text (pop jv-rows) jv-ids) ["JOP13 control (a record without d2) passed"])
     (when-not (requires-record-problem jv-f nil [] jv-ids) ["JOP13 control (no record) passed"])
     (when-not (requires-record-problem jv-f (str ";; INTERIM\n" jv-text) jv-rows jv-ids) ["JOP13 control (an INTERIM record) passed"])
     (when-not (requires-record-problem jv-f jv-text jv-rows []) ["JOP13 control (a cell with no case) passed"])
     (when-not (= (:dg-own cf-good) [950 1]) [(str "345-1: 950 own passes counted " (pr-str (:dg-own cf-good)))])
     (when-not (= "0.722" (format "%.3f" (first (mixed-score {:cases cf-good})))) [(str "345-1: C++'s read from the record gives " (format "%.3f" (first (mixed-score {:cases cf-good}))) ", not 0.722")])
     (when (= (:dg-own cf-ctl) (:dg-own cf-good)) ["345-1 control (one pass turned :fail) passed: the count did not move"])
     (when cf-full [(str "378: the full record refused: " cf-full)])
     (when-not (= (:dg-clang cf-na) [3609 0.5]) [(str "497-3: five n/a rows left out counted " (pr-str (:dg-clang cf-na)))])
     (when-not (= "0.7220" (format "%.4f" (first (mixed-score {:cases cf-na})))) [(str "497-3: C++'s read without the n/a rows gives " (format "%.4f" (first (mixed-score {:cases cf-na}))) ", not 0.7220")])
     (when (seq na-ctl) ["497-3 control (the class :deferred) passed: ids counted out"])
     (when-not (= (:dg-clang cf-na2) [3608 0.5]) [(str "502-2: six n/a rows of two classes left out counted " (pr-str (:dg-clang cf-na2)))])
     (when (contains? na2-ctl "gxx-dg/f957.C") ["502-2 control (the second class :design) passed: its id counted out"])
     (when-not cf-empty ["378 control (an empty record) passed: counted as a stage of its own cases"])
     (when-not cf-short ["378 control (a record of 4,000 rows for 4,564 stated) passed: counted"])
     (when-not (and (= "82.5" (compl before)) (= "84.2" (compl after)))
       [(str "OC222: completeness " (compl before) " to " (compl after) ", expected 82.5 to 84.2 (+1.7)")]))))

(defn- parse-args [args]
  (loop [o {:inputs []} [a & r] args]
    (case a
      nil o
      "--ref" (recur (assoc o :ref (first r)) (rest r))
      "--crop" (recur (assoc o :crop (keyword (first r))) (rest r))
      "--input" (recur (update o :inputs conj (first r)) (rest r))
      "--newest" (recur (assoc o :newest true) r)
      "--tsv" (recur (assoc o :tsv true) r)
      "--judge" (recur (assoc o :judge true) r)
      "--strict" (recur (assoc o :strict true) r)
      "--record" (recur (assoc o :record true) r)
      "--self-test" (recur (assoc o :self-test true) r)
      (throw (ex-info (str "crops-score: unknown argument " a) {})))))

(defn -main [& args]
  (binding [*root* (or (System/getenv "CROPS_ROOT") ".")]
    (when (some #{"--self-test"} args)
      (let [fails (self-test)]
        (doseq [x fails] (println (str "   FAIL " x)))
        (println (str "crops-score: self-test (RFP53 (a), OC222 (a), HF10-P29 (a), CP333 (b), CP401 (a), JOP7 (a), JOP13 (a), 345-1 (a), 378, 497-3 (a), 502-2 (a)): " (if (empty? fails) "every test passes, every control fails as it must" (str (count fails) " failures"))))
        (shutdown-agents)
        (System/exit (if (empty? fails) 0 1))))
    (let [o (parse-args args)
          config (read-file "test/crops/crops.edn")
          ind (read-file "test/crops/independence.edn")
          inputs (for [f (:inputs o) :let [x (read-file f)]] [f (if (map? x) (:cells x) x)])
          cfgs (filter #(or (nil? (:crop o)) (= (:crop o) (:id %))) (:crops config))
          _ (when (empty? cfgs) (throw (ex-info (str "crops-score: no crop " (:crop o)) {})))
          scores (doall (for [c cfgs]
                          (score-crop c config ind (if (:newest o) (or (newest-ref c) (:ref o)) (:ref o)) inputs)))
          refuted (for [s scores r (get-in s [:independence :refuted])]
                    (str (get-in s [:crop :name]) " " (level-names (:stage r)) " (" (:ref s) "): " (:check r)))
          unverified (for [s scores r (get-in s [:independence :unverified])]
                       (str (get-in s [:crop :name]) " " (level-names (:stage r)) " (" (:ref s) "): " (:check r)))
          own? (and (nil? (:ref o)) (not (:newest o)) (empty? (:inputs o)))
          _ (when (and (:record o) (not (and own? (nil? (:crop o)))))
              (throw (ex-info "crops-score: --record records the checkout's scores of every crop (no --ref, --newest, --input, --crop)" {})))
          judged (when (:judge o) (concat (map #(str "test/reap/matrix.edn: " %) (judge-check))
                                          (map #(str "self-test: " %) (self-test))))
          na (for [s scores p (:na-problems s)] (str "OC222 (a): " p))
          diffs (when (and own? (not (:record o))) (record-diffs scores))
          problems (concat judged na (when (:strict o) refuted) diffs)]
      (when (and (:record o) (empty? judged) (empty? na) (or (not (:strict o)) (empty? refuted)))
        (spit (str *root* "/" scores-file) (scores-text scores))
        (println (str "crops-score: wrote " scores-file)))
      (if (:tsv o)
        (tsv scores)
        (do (println "crops-score: completeness, maturity and independence per crop (doc/CROPS-SCORE.md),")
            (println "             from the recorded results alone")
            (println)
            (table scores)
            (println)
            (doseq [s scores] (print-details s))
            (println (str "crops-score: " (count scores) " crops; " (count refuted) " facts refuted by the gate's steps"
                          (when (seq refuted) " (scored 0, or held at 0.5 by a :requires-line)") "; " (count problems) " problems"))
            (doseq [x refuted] (println (str "   refuted: " x)))
            ;; (c): a stage scored above 0 that no step of the tree runs: flagged, its score kept (not a problem)
            (println (str "crops-score: " (count unverified) " facts above 0 unverified (no step of the tree outside the oracle tier runs them)"))
            (doseq [x unverified] (println (str "   unverified: " x)))))
      (doseq [p problems] (binding [*out* *err*] (println (str "   " p))))
      (shutdown-agents)
      (System/exit (if (empty? problems) 0 1)))))

 {:stages
  {:read {:score 1 :tool "arbace.lang.LispReader; bin/repr-clojure read" :host []
          :why "Arbace's own reader" :evidence ["test/reap/cells.edn: [:clojure :read]'s sources run on the test build"]}
   :eval {:score 1 :tool "the test build (bin/clojure-tests, bin/oracle)" :host [] :why "Arbace's evaluator"
          :evidence ["test/gate/steps.edn: suite-go, oracle-go on :gate"] :steps [suite-go]}
   :aot {:score 1 :tool "c2j, j2g, TamaGo's go (bin/clojure-tests --aot)" :host [] :why "Arbace's compiled pipeline"
         :evidence ["test/gate/steps.edn: suite-aot-essential, suite-aot"] :steps [suite-aot-essential suite-aot]}
   :print {:score 1 :tool "arbace.core's printer; bin/repr-clojure print" :host [] :why "Arbace's printer"
           :verified "2026-11-06: bin/repr-clojure roundtrip .tmp/frozen/clojure/walk.clj, 1 of 1 equal, no stub called"}
   :judge {:score 1 :tool "test/baseline-results.edn, test/oracle/expected; the frozen jar" :host []
           :why "references recorded from the frozen v4 jar (pinned), the oracle's live reference the same jar"
           :evidence ["test/oracle/frozen-jar.sha256" "test/gate/steps.edn: oracle-go :hosts [:gate :frozen :jdk]"]
           :steps [suite-go oracle-go diffcheck suite-aot-essential suite-aot repr-clojure]}}}


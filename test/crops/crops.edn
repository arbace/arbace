;; bin/crops-score's crops (doc/CROPS-SCORE.md; test/crops/score.ae reads it). Read with the Clojure reader.
;;
;; A crop:
;;   :id :name        its REAP row's language (test/reap/cells.edn's :languages) and its name, as printed
;;   :steps           a regexp over gate step names (test/gate/steps.edn and the GT9 fragments test/gate/crops/*.edn): the
;;                    crop's steps beside those the table's :crops gives it; :exclude-steps takes some back out (LLVM's out of
;;                    :cpp, whose :crops lists them)
;;   :branches        a regexp over the refs of the remote mac (git for-each-ref refs/remotes/mac, short names): the crop's
;;                    own held branches; --newest scores the newest of them (committer date) whose test/reap/cells.edn has the
;;                    crop's row
;;   :controls        the negative controls of its check families (doc/GATE-SURVEY.md, GTS81 (a)): each rule names the REAP
;;                    sources it covers by a regexp over the source's :name, the control file and a regexp its text must
;;                    hold; a family (a cell's source of :role :check) is covered when one rule matches it and its file holds
;;                    the match in the tree scored. A family with no rule is a missing control (GATE-SURVEY's "M" rows)
;; :toolchain-hosts   the gate's hosts that are a host toolchain (GT9's :host-ids): a step on one of them runs that toolchain
;; :abs-path          a record holding this (an absolute path of the host) is path-dependent (maturity's last item: the share of
;;                    the crop's records without one); :abs-path-allow, the literals of the tests themselves, taken out first
{:toolchain-hosts [:gcc :cxx :llvm :ocaml :chez :chibi :ghc :rustc :python]
 :abs-path #"(?<![A-Za-z0-9_.@-])/(root|home|tmp|Users)/"
 ;; a test's own text that looks like one (taken out before the search): jtreg's TestUnlimited's argument
 :abs-path-allow [#"\"/tmp/unlimited\""]
 :crops
 [{:id :clojure :name "Clojure" :steps #"^(suite-|oracle-go|diffcheck|repr-clojure)" :branches #"^mac/clojure-"
   :controls [{:source #"^Clojure's suite" :file "test/clojure/controls.edn" :match #":subject"}
              {:source #"^the oracle" :file "test/oracle/controls.edn" :match #":subject"}]}
  {:id :java :name "Java" :steps #"^(java-|repr-java|javac-|jrt-convert)" :branches #"^mac/java-"
   :controls [{:source #"^bin/java-check (read|classes|interp|compiled)" :file "test/java/controls.edn" :match #":id \"c0000"}
              {:source #"^bin/java-check diagnostics" :file "test/java/controls.edn" :match #"control-diag|diagnostics"}
              {:source #"^bin/java-check print" :file "test/java/controls.edn" :match #"control-print|print"}]}
  {:id :go :name "Go" :steps #"^(goi|repr-go)" :branches #"^mac/(goi|go|repr-go)-"
   :controls [{:source #"^bin/goi check \(" :file "test/goi/controls.txt" :match #"(?m)^interp "}
              {:source #"^bin/goi check --aot" :file "test/goi/controls.txt" :match #"(?m)^aot "}
              {:source #"^bin/repr-go native-check" :file "test/repr/go/native-controls.edn" :match #":subject"}
              {:source #"^bin/repr-go roundtrip( linux/amd64|\b.*--tests)?$" :file "test/repr/go/roundtrip-controls.txt" :match #"(?m)^(package|test) "}
              {:source #"^bin/repr-go roundtrip --text" :file "test/repr/go/roundtrip-controls.txt" :match #"(?m)^text "}]}
  {:id :c :name "C" :steps #"^c-" :branches #"^mac/(c-|c23-|ci-)"
   :controls [{:source #"^bin/ci dg" :file "test/c/controls.edn" :match #":level :dg"}
              {:source #"^bin/repr-c check --tokens" :file "test/c/controls.edn" :match #":level :(pp|lex|gcc)"}
              {:source #"^bin/repr-c parse-check" :file "test/c/controls.edn" :match #":level :tree"}
              {:source #"^bin/ci check" :file "test/c/controls.edn" :match #":level :run"}
              {:source #"^bin/repr-c roundtrip" :file "test/c/controls.edn" :match #":level :roundtrip"}]}
  {:id :cpp :name "C++" :steps #"^(cpp|cppi)-" :exclude-steps #"^llvm" :branches #"^mac/(cpp|cppi)-"
   :controls [{:source #"^bin/cppi check" :file "test/cpp/controls.edn" :match #":level :run|check"}
              {:source #"^bin/cppi lower-check" :file "test/cpp/controls.edn" :match #"bitfields-vs-io"}
              {:source #"^bin/repr-cpp pp-check" :file "test/cpp/controls.edn" :match #":level :(pp|lex)"}
              {:source #"^bin/repr-cpp dg" :file "test/cpp/controls.edn" :match #":level :dg"}
              {:source #"^bin/repr-cpp roundtrip" :file "test/cpp/controls.edn" :match #":level :roundtrip"}]}
  {:id :ocaml :name "OCaml" :steps #"^(oi|ocaml)-" :branches #"^mac/ocaml-"
   :controls [{:source #"^bin/oi check \(" :file "test/ocaml/controls.txt" :match #"(?m)^judge check-oi\.edn "}
              {:source #"^bin/oi suite check \(" :file "test/ocaml/controls.txt" :match #"(?m)^judge check-suite-oi\.edn "}
              {:source #"^bin/oi check --aot" :file "test/ocaml/controls.txt" :match #"(?m)^judge check-aot\.edn "}
              {:source #"^bin/oi suite check --aot" :file "test/ocaml/controls.txt" :match #"(?m)^judge check-suite-aot\.edn "}
              {:source #"^bin/repr-ocaml roundtrip" :file "test/ocaml/roundtrip-controls.txt"}]}
  {:id :scheme :name "Scheme" :steps #"^(si|scheme)-" :branches #"^mac/scheme-"
   :controls [{:source #"^bin/si check" :file "test/scheme/si/controls.edn" :match #":subject"}
              {:source #"^bin/repr-scheme check" :file "test/scheme/controls.edn" :match #":family :read\b"}
              {:source #"^bin/repr-scheme roundtrip" :file "test/scheme/controls.edn" :match #":family :roundtrip"}
              {:source #"^bin/si r7rs" :file "test/scheme/controls.edn" :match #":family :r7rs"}
              {:source #"^bin/si srfi" :file "test/scheme/controls.edn" :match #":family :srfi"}
              {:source #"^bin/si chibi-tests" :file "test/scheme/controls.edn" :match #":family :chibi-tests"}
              {:source #"^bin/si ecraven" :file "test/scheme/controls.edn" :match #":family :ecraven"}]}
  {:id :haskell :name "Haskell" :steps #"^(hsi|haskell)-" :branches #"^mac/haskell-"
   :controls [{:source #"^bin/hsi check" :file "test/haskell/hsi-controls.txt"}
              {:source #"^bin/repr-haskell roundtrip" :file "test/haskell/roundtrip-controls.edn"}]}
  {:id :rust :name "Rust" :steps #"^(rsi|rust)-" :branches #"^mac/rust-"
   :controls [{:source #"^bin/rsi check" :file "test/rust/controls.edn" :match #":level :run"}
              {:source #"^bin/repr-rust roundtrip" :file "test/rust/roundtrip-controls.edn"}]}
  {:id :llvm :name "LLVM IR" :steps #"^(llvm|llvmi)-" :branches #"^mac/llvm-"
   :controls [{:source #"^bin/llvmi check" :file "test/llvm/controls.edn"}
              {:source #"^bin/repr-llvm" :file "test/llvm/controls.edn" :match #"roundtrip|verify"}]}
  {:id :python :name "Python" :steps #"^(pyi|python)-" :branches #"^mac/(mac/)?[0-9]+-python"
   :controls [{:source #"^bin/pyi check" :file "test/python/controls.edn"}
              {:source #"^pyi's compiled loop" :file "test/python/controls.edn"}
              {:source #"^bin/repr-python" :file "test/python/controls-read.edn"}]}]}

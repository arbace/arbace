;; bin/crops-score's crops (doc/CROPS-SCORE.md; test/crops/score.ae reads it). Read with the Clojure reader.
;;
;; A crop:
;;   :id :name        its REAP row's language (test/reap/cells.edn's :languages) and its name, as printed
;;   :steps           a regexp over gate step names (test/gate/steps.edn and the GT9 fragments test/gate/crops/*.edn): the
;;                    crop's steps beside those the table's :crops gives it; :exclude-steps takes some back out (LLVM's out of
;;                    :cpp, whose :crops lists them)
;;   :branches        a regexp over the refs of the remote mac (git for-each-ref refs/remotes/mac, short names): the crop's
;;                    own held branches; --newest scores the newest of them (committer date) whose test/reap/cells.edn has the
;;                    crop's row
;;   :controls        the negative controls of its check families (doc/GATE-SURVEY.md, GTS81 (a)): each rule names the REAP
;;                    sources it covers by a regexp over the source's :name, the control file and a regexp its text must
;;                    hold; a family (a cell's source of :role :check) is covered when one rule matches it and its file holds
;;                    the match in the tree scored. A family with no rule is a missing control (GATE-SURVEY's "M" rows)
;; :toolchain-hosts   the gate's hosts that are a host toolchain (GT9's :host-ids): a step on one of them runs that toolchain
;; :abs-path          a record holding this (an absolute path of the host) is path-dependent (maturity's last item: the share of
;;                    the crop's records without one); :abs-path-allow, the literals of the tests themselves, taken out first
;; :host-uses        a use of a toolchain host that is not the toolchain's (the independence audit, 2026-11-09): :host, and the
;;                    steps (:steps, a regexp over their names) or the steps that also run on :with-host (less :unless-steps)
;;                    whose use of it is exempt, :why
;; :toolchain-reads   (a) a step that reads a toolchain's files by path: a file the step runs (its :cmd's scripts and the files
;;                    of bin/ and test/ they name by the root, to depth 4; code only: bin/'s scripts, .bash, .sh and .ae
;;                    files, not data) whose text matches :reads refutes a claim
;;                    above 0, unless the file or the file that named it matches :unless (what reads Arbace's own instead)
;; :helper-records    (b) a cell's record written by a live helper: a sentence of a record's header (the cell's sources' files,
;;                    test/reap/cells.edn) matching :names and not :ok (a comparison with the helper, a pin) refutes a claim
;;                    above 0.5 of the cell's stage
{:toolchain-hosts [:gcc :cxx :llvm :ocaml :chez :chibi :ghc :rustc :python :jdk :frozen :llvm-mc]
 :host-uses
 [;; the user's ruling of 2026-11-09: the frozen v4 jar and the JVM that runs it are exempt (test/crops/independence.edn's header);
  ;; the host :frozen is the jar (bin/lib/gate-run.bash: its identity the pin test/oracle/frozen-jar.sha256)
  {:host :frozen :steps #"" :why "the frozen v4 jar (pinned), exempt with its JVM (the user, 2026-11-09)"}
  ;; bin/clojure-tests (suite-go, suite-aot-essential, suite-aot) and bin/gate-tests' frozen-test source bin/lib/java26.bash,
  ;; whose arbace_java_home runs the JDK's java -version (its release, 26): no JDK tool or class runs on the Go build's checks
  {:host :jdk :steps #"^(suite-go|suite-aot-essential|suite-aot|gate-tests)$"
   :why "bin/lib/java26.bash's java -version alone (the JDK's identity), no JDK tool or class used"}
  ;; a step that also runs the frozen jar: the JDK is the JVM that runs it (oracle-go, j2g-edge's recording), but for javac's and
  ;; repr/java's steps, which compare with the JDK's javac or read the platform
  {:host :jdk :with-host :frozen :unless-steps #"^(javac-|repr-java|java-)"
   :why "the JVM that runs the frozen v4 jar (the user, 2026-11-09)"}]
 :toolchain-reads
 [;; gcc's recorded host description over the host's installed headers: test/c/host read with no sysroot (bin/lib/repr-c/sysroot.bash's
  ;; c_sysroot: Arbace's c/target and its sysroot, or gcc's pack c-headers-gcc15); the audit's finding on bin/hsi cnodes
  {:reads #"(?:\$\{?root\}?\"?|\(str root \")/test/c/host(?:/search\.txt)?(?![\w./-])" :unless #"bin/lib/repr-c/sysroot\.bash|ARBACE_C_SYSROOT|ARBACE_C_HOST"
   :what "test/c/host (gcc's recorded search list over the host's installed headers)" :instead "C's sysroot, bin/lib/repr-c/sysroot.bash"}
  ;; libstdc++'s and gcc's installed include directories in place (C++'s readers take them as test/cpp/target.ae makes them)
  {:reads #"\"/usr/include/c\+\+/|\"/usr/lib/gcc/x86_64" :unless #"bin/lib/repr-cpp/sysroot\.bash|REPR_CPP_HEADERS"
   :what "the host's libstdc++ or gcc include directory" :instead "C++'s headers, bin/lib/repr-cpp/sysroot.bash"}]
 :helper-records
 {:names #"\btools/(ocdump|hsdump|rsdump|pydump|ccdump|cxxdump|godump|schemedump)\b"
  :ok #"(?i)differs? from|against|compared? with|the oracle tier|pins? it|pinned by|--reader helper|beside"}
 ;; RFP53 (a) (the user, 2026-11-10; doc/CROPS-SCORE.md, "Decided (the user, 2026-11-10)"): a stage fact's :case-inputs {:file F}
 ;; names a record of the cell's cases, [ID {INPUT VALUE ...}] a case; a case whose every input of its crop's list below is :own
 ;; scores 1, any other case of the cell (one input not :own, or no row) 0.5; the stage is the case-weighted mean over the cell's cases
 ;; (test/reap/matrix.edn's count), the mixed-stage rule of 2026-11-07. With the cell not recorded or F not there, the stated score.
 :own-inputs
 {:rust {:ruling "RFP53 (a), the user 2026-11-10"
         :inputs [[:c1 "the program's bodies from Arbace's front end (no -O0 IR pack)"]
                  [:c2 "std's instances' bodies from Arbace's front end, built from source (not rust-front-rsi's)"]
                  [:c3 "no mono fact refused or taken from the record"]
                  [:c4 "std's interface and the StableCrateIds native (not std-iface's or std-crates-rsi.edn's)"]
                  [:c5 "a native allocator shim (not rustc's shim.ll)"]
                  [:c6 "the library's non-generic items lowered by Arbace (not std's IR from Cargo, rustc and clang)"]
                  [:c7 "ci reads c/target (Arbace's own C target), not test/c/host"]]}
  ;; HF10-P29 (a) (the user, 2026-11-11): a Haskell program is own when bin/hsi check --libs own compiled it on Arbace's own
  ;; interfaces and ran it over Arbace's own libraries' STG alone (its line's :libs :own), counted from the record of the run
  ;; (test/haskell/check-hsi-own.edn, -aot-own: independence.edn's :case-inputs); every other case 0.5 (the packs GHC made)
  :haskell {:ruling "HF10-P29 (a), the user 2026-11-11"
            :inputs [[:libs "the program compiled by the native front end on the own interfaces of ghc-internal, its wired-in Prim and base, and run over their own STG alone (bin/hsi check --libs own: :libs :own), not haskell-stg-libs' and haskell-stg-progs' STG GHC made"]]}
  ;; queue 324 (CP356 (a); CP333 (b), the user 2026-11-09): a C++ program's half of the eval and AOT stages is own when Arbace's own
  ;; front end and code generator made its IR (bin/cppi check --record's test/cpp/{eval,aot}-inputs-linux-amd64.edn, :ir :own) and,
  ;; since CP400 (a), CP401 (a) (n-cpp-indep, taken overnight, round 52), ci read its lowered C on Arbace's own c/target (:ci-target
  ;; :own; bin/cppi's c_target_host), else 0.5 (the packs clang++ made, or gcc's recorded test/c/host); the runtime's units the other
  ;; half (independence.edn's :mean-with, the same two inputs)
  :cpp {:ruling "CP333 (b), the user 2026-11-09; CP356 (a), queue 324; CP401 (a), taken overnight (round 52), on RFP53 (a)'s rule"
        :inputs [[:ir "the program's (or runtime unit's) IR by Arbace's own front end and code generator (arbace.cpp.codegen gen-batch, CPPI_ROUTE ours or auto's ours), not the packs cpp-ir-samples' or cpp-ir-gxx-dg-run's clang++ IR"]
                 [:ci-target "ci reads the lowered C on c/target (Arbace's own C target), not gcc's recorded test/c/host"]]}
  ;; JOP13 (a) (taken overnight, round 52; doc/classes/JAVA-FRONTEND-SURVEY.md, "As built: JOP13 (a)"): a Java test is own when
  ;; its source set is Arbace's own record's (test/java/sources.edn, javac on Arbace's -verbose: :sources :own; a golden-diagnostics
  ;; test run in place :own too) made against the own platform (:platform :own, the pin's "# kind: own"); every other case 0.5
  ;; (the JDK's sets, test/java/ref-jdk26.edn's :files, or the build tree's platform); independence.edn's :requires-record holds
  ;; a stage at 0.5 until the record covers every test of its cell
  :java {:ruling "JOP13 (a), taken overnight (round 52), on RFP53 (a)'s rule"
         :inputs [[:platform "javac on Arbace read against the own platform (jdk26u's sources compiled by javac on Arbace, jdk/javac/platform.sha256's # kind: own), not jdk26u's build tree"]
                  [:sources "the test's source set made by javac on Arbace (bin/java-check sources), not the JDK's javac -verbose (test/java/ref-jdk26.edn's :files)"]]}}
 ;; OC222 (a) (the user, 2026-11-10): a class of :kind :na in the crop's cells' classes must be ocamltest's own skip on the pinned
 ;; configuration: its :skips {PROGRAM ACTION} cover its :programs, its :config file's :actions know each ACTION, and none passes on
 ;; that file's :config (ocamlc -config's values); anything else is a problem (exit 1)
 :na-rules
 {:ocaml {:ruling "OC222 (a), the user 2026-11-10" :rule :ocamltest-skip}}
 :abs-path #"(?<![A-Za-z0-9_.@-])/(root|home|tmp|Users)/"
 ;; a test's own text that looks like one (taken out before the search): jtreg's TestUnlimited's argument
 :abs-path-allow [#"\"/tmp/unlimited\""]
 :crops
 [{:id :clojure :name "Clojure" :steps #"^(suite-|oracle-go|diffcheck|repr-clojure)" :branches #"^mac/clojure-"
   :controls [{:source #"^Clojure's suite" :file "test/clojure/controls.edn" :match #":subject"}
              {:source #"^the oracle" :file "test/oracle/controls.edn" :match #":subject"}
              ;; controls-cg (2026-11-08): the rules' claims (rules/round-trip, bin/repr-clojure check's unit tests) and the
              ;; round trip's corpora (control-verdict, bin/repr-clojure check --roundtrip), a crossed pair each
              {:source #"^repr/clojure's one-way rules" :file "test/repr/clojure/rules-controls.edn" :match #":rule :"}
              {:source #"^repr/clojure's round trip" :file "test/repr/clojure/roundtrip-controls.edn" :match #":corpus :"}]}
  {:id :java :name "Java" :steps #"^(java-|repr-java|javac-|jrt-convert)" :branches #"^mac/java-"
   :controls [{:source #"^bin/java-check (read|classes|interp|compiled)" :file "test/java/controls.edn" :match #":id \"c0000"}
              {:source #"^bin/java-check diagnostics" :file "test/java/controls.edn" :match #"control-diag|diagnostics"}
              {:source #"^bin/java-check print" :file "test/java/controls.edn" :match #"control-print|print"}]}
  {:id :go :name "Go" :steps #"^(goi|repr-go)" :branches #"^mac/(goi|go|repr-go)-"
   :controls [{:source #"^bin/goi check \(" :file "test/goi/controls.txt" :match #"(?m)^interp "}
              {:source #"^bin/goi check --aot" :file "test/goi/controls.txt" :match #"(?m)^aot "}
              {:source #"^bin/repr-go native-check" :file "test/repr/go/native-controls.edn" :match #":subject"}
              ;; controls-cg (2026-11-08): the known differences' judge (annotate/known-difference?) by the controls' level
              ;; :known, and the directory tests' round trip by the kind dirtest
              {:source #"^native-check's known differences" :file "test/repr/go/native-controls.edn" :match #":levels \[[^\]]*:known"}
              {:source #"^bin/repr-go roundtrip --dirs" :file "test/repr/go/roundtrip-controls.txt" :match #"(?m)^dirtest "}
              {:source #"^bin/repr-go roundtrip( linux/amd64|\b.*--tests)?$" :file "test/repr/go/roundtrip-controls.txt" :match #"(?m)^(package|test) "}
              {:source #"^bin/repr-go roundtrip --text" :file "test/repr/go/roundtrip-controls.txt" :match #"(?m)^text "}]}
  {:id :c :name "C" :steps #"^c-" :branches #"^mac/(c-|c23-|ci-)"
   :controls [{:source #"^bin/ci dg" :file "test/c/controls.edn" :match #":level :dg"}
              {:source #"^bin/repr-c check --tokens" :file "test/c/controls.edn" :match #":level :(pp|lex|gcc)"}
              {:source #"^bin/repr-c parse-check" :file "test/c/controls.edn" :match #":level :tree"}
              {:source #"^bin/ci check" :file "test/c/controls.edn" :match #":level :run"}
              {:source #"^bin/repr-c roundtrip" :file "test/c/controls.edn" :match #":level :roundtrip"}]}
  {:id :cpp :name "C++" :steps #"^(cpp|cppi)-" :exclude-steps #"^llvm" :branches #"^mac/(cpp|cppi)-"
   :controls [{:source #"^bin/cppi check" :file "test/cpp/controls.edn" :match #":level :run|check"}
              {:source #"^bin/cppi lower-check" :file "test/cpp/controls.edn" :match #"bitfields-vs-io"}
              {:source #"^bin/repr-cpp pp-check" :file "test/cpp/controls.edn" :match #":level :(pp|lex)"}
              {:source #"^bin/repr-cpp dg" :file "test/cpp/controls.edn" :match #":level :dg"}
              {:source #"^bin/repr-cpp roundtrip" :file "test/repr/cpp/roundtrip-controls.edn" :match #":subject \"samples/"}]}
  {:id :ocaml :name "OCaml" :steps #"^(oi|ocaml)-" :branches #"^mac/ocaml-"
   :controls [{:source #"^bin/oi check \(" :file "test/ocaml/controls.txt" :match #"(?m)^judge check-oi\.edn "}
              {:source #"^bin/oi suite check \(" :file "test/ocaml/controls.txt" :match #"(?m)^judge check-suite-oi\.edn "}
              {:source #"^bin/oi check --aot" :file "test/ocaml/controls.txt" :match #"(?m)^judge check-aot\.edn "}
              {:source #"^bin/oi suite check --aot" :file "test/ocaml/controls.txt" :match #"(?m)^judge check-suite-aot\.edn "}
              {:source #"^bin/repr-ocaml roundtrip" :file "test/ocaml/roundtrip-controls.txt"}]}
  {:id :scheme :name "Scheme" :steps #"^(si|scheme)-" :branches #"^mac/scheme-"
   :controls [{:source #"^bin/si check" :file "test/scheme/si/controls.edn" :match #":subject"}
              {:source #"^bin/repr-scheme check" :file "test/scheme/controls.edn" :match #":family :read\b"}
              {:source #"^bin/repr-scheme roundtrip" :file "test/scheme/controls.edn" :match #":family :roundtrip"}
              {:source #"^bin/si r7rs" :file "test/scheme/controls.edn" :match #":family :r7rs"}
              {:source #"^bin/si srfi" :file "test/scheme/controls.edn" :match #":family :srfi"}
              {:source #"^bin/si chibi-tests" :file "test/scheme/controls.edn" :match #":family :chibi-tests"}
              {:source #"^bin/si ecraven" :file "test/scheme/controls.edn" :match #":family :ecraven"}]}
  {:id :haskell :name "Haskell" :steps #"^(hsi|haskell)-" :branches #"^mac/haskell-"
   :controls [{:source #"^bin/hsi check" :file "test/haskell/hsi-controls.txt"}
              ;; haskell-90 (2026-11-07): the round trip's controls by level, each judged by compare-forms (:tree),
              ;; compare-text --bytes-only (:text) and compare-iface (:iface, the oracle tier's) on the pairs it names
              {:source #"^bin/repr-haskell roundtrip: the tree level" :file "test/haskell/roundtrip-controls.edn" :match #":tree \["}
              {:source #"^bin/repr-haskell roundtrip --iface" :file "test/haskell/roundtrip-controls.edn" :match #":iface \["}
              {:source #"^bin/repr-haskell roundtrip --(text|layout)" :file "test/haskell/roundtrip-controls.edn" :match #":text \["}]}
  {:id :rust :name "Rust" :steps #"^(rsi|rust)-" :branches #"^mac/rust-"
   ;; rust-90: rsi's run controls (the subject's run against another program's rustc run) and the round trips' (the tree, lines
   ;; and text judges over the native trees, each control an edited subject: test/rust/roundtrip-edit-controls.edn, named so at
   ;; batch 2's merge, run last by every bin/repr-rust roundtrip; GT9's crossed pairs beside, test/rust/roundtrip-controls.edn);
   ;; the read cell's rustdoc level is beside (the oracle tier) and has none
   :controls [{:source #"^bin/rsi check" :file "test/rust/controls.edn" :match #":level :run"}
              {:source #"^bin/repr-rust roundtrip" :file "test/rust/roundtrip-edit-controls.edn" :match #":family :(tree|text)"}
              {:source #"^bin/repr-rust roundtrip" :file "test/rust/roundtrip-controls.edn"}]}
  {:id :llvm :name "LLVM IR" :steps #"^(llvm|llvmi)-" :branches #"^mac/llvm-"
   ;; the families rerun on llvm-90 (LL9a): llvmi (eval, AOT), llvm/test's round trip, verify and text checks, the probes; the first
   ;; records' 282-module lists and mutants (inputs made by clang, in no checkout) have none: retired from the cells by LLS31 (b)
   ;; (beside, batch 2) until the pack rt
   :controls [{:source #"^bin/llvmi check" :file "test/llvm/controls.edn" :match #":subject"}
              {:source #"^bin/repr-llvm (roundtrip: llvm/test's|check roundtrip-rt)" :file "test/repr/llvm/roundtrip-controls.txt" :match #"(?m)^_control/"}
              {:source #"^bin/repr-llvm (verify-check: (llvm/test's|the hand-written probes)|check verify-rt)" :file "test/repr/llvm/verify-controls.txt" :match #"(?m)^_control/"}
              {:source #"^bin/repr-llvm (roundtrip --text: llvm/test's|check text-rt)" :file "test/repr/llvm/text-controls.txt" :match #"(?m)^_control/"}]}
  {:id :python :name "Python" :steps #"^(pyi|python)-" :branches #"^mac/(mac/)?[0-9]+-python"
   :controls [{:source #"^bin/pyi check" :file "test/python/controls.edn"}
              {:source #"^pyi's compiled loop" :file "test/python/controls.edn"}
              {:source #"^bin/repr-python" :file "test/python/controls-read.edn"}]}
  ;; AX10 (the user, 2026-11-10: brought forward, CSP7 reversed; doc/asm/AMD64-SURVEY.md §11.2, ARM64-SURVEY.md §10): the two
  ;; assembly crops, their check families' controls bin/repr-asm runs (GTS81 (a): a case judged against another case's reference by
  ;; the family's own judge, which must fail)
  {:id :asm-amd64 :name "x86-64 assembly" :steps #"^(asm-amd64|x86i)-" :branches #"^mac/asm-(ax|amd64|merged)"
   :controls [{:source #"^bin/repr-asm roundtrip( --full)? \(amd64" :file "test/asm/controls.txt" :match #"(?m)^_control/(musl|mc)-"}
              {:source #"^bin/repr-asm decode-check dis" :file "test/asm/controls-decode.txt" :match #"(?m)^_control/\S+ dis "}
              {:source #"^bin/repr-asm x86i-check: the programs run" :file "test/asm/controls-x86i.txt" :match #"(?m)^_control/\S+ (verdict|cpu) "}
              {:source #"^bin/repr-asm x86i-check: the lockstep's sys mode" :file "test/asm/controls-x86i.txt" :match #"(?m)^_control/\S+ (lockstep|bisect) "}
              {:source #"^bin/repr-asm x86i-check: the lockstep's step mode" :file "test/asm/controls-x86i.txt" :match #"(?m)^_control/\S+ step "}
              {:source #"^bin/repr-asm run-check" :file "test/asm/controls-run.txt" :match #"(?m)^_control/"}
              {:source #"^bin/repr-asm object-check" :file "test/asm/controls-object.txt" :match #"(?m)^_control/"}
              {:source #"^bin/repr-asm encode-check's print level" :file "test/asm/controls-print.txt" :match #"(?m)^_control-print/"}
              {:source #"^bin/repr-asm encode-check's cross-syntax" :file "test/asm/controls-cross.txt" :match #"(?m)^_control-cross/"}]}
  {:id :asm-arm64 :name "arm64 assembly" :steps #"^(asm-arm64|a64i)-" :branches #"^mac/asm-(ar|arm64)"
   :controls [{:source #"^bin/repr-asm --arch arm64 roundtrip" :file "test/asm/controls-arm64.txt" :match #"(?m)^_control/"}
              ;; the input level is the encode level's judge (the input line encoded against the stated word): its controls'
              {:source #"^bin/repr-asm --arch arm64 encode-check's input level" :file "test/asm/controls-encode-arm64.txt" :match #"(?m)^_control/(?!print-|msg-)"}
              {:source #"^bin/repr-asm --arch arm64 encode-check's print level" :file "test/asm/controls-encode-arm64.txt" :match #"(?m)^_control/print-"}
              ;; AR4's: the run check's, the object verdict's and the object check's (a case judged by another case's verdict or record)
              {:source #"^bin/repr-asm --arch arm64 run-check" :file "test/asm/controls-run-arm64.txt" :match #"(?m)^_control/"}
              {:source #"^bin/repr-asm --arch arm64 object-verdict" :file "test/asm/controls-objverdict-arm64.txt" :match #"(?m)^_control/"}
              {:source #"^bin/repr-asm --arch arm64 object-check" :file "test/asm/controls-object-arm64.txt" :match #"(?m)^_control/"}
              ;; AR5's: a64i's check (a program's run judged by another's verdict, an injected fault the judge must catch)
              {:source #"^bin/a64i check: the programs run on a64i from their forms" :file "test/asm/controls-a64i.txt" :match #"(?m)^verdict-"}
              {:source #"^bin/a64i check: a64i's runs equal to the arm64 VM's CPU" :file "test/asm/controls-a64i.txt" :match #"(?m)^cpu-"}
              {:source #"^bin/a64i check: the lockstep's sys mode" :file "test/asm/controls-a64i.txt" :match #"(?m)^sys-"}
              {:source #"^bin/a64i check: the lockstep's step mode" :file "test/asm/controls-a64i.txt" :match #"(?m)^(step|bisect)-"}
              {:source #"^bin/a64i check: the same programs" :file "test/asm/controls-a64i.txt" :match #"(?m)^(aot|inject)-"}]}
  ;; WA1-WA2 (the user, 2026-11-13: WAS1 (a), the row after the asm rows; doc/wasm/WASM-SURVEY.md "As built: WA1", "As built: WA2"):
  ;; the round trip's controls (a module's :full print against another module's bytes, against its own bytes flipped; a positive
  ;; check beside) and the testsuite's (an assert_malformed's module judged as a module, a module judged as malformed, two modules'
  ;; forms compared)
  {:id :wasm :name "WebAssembly" :steps #"^(wasm|wai)-" :branches #"^mac/wasm-"
   :controls [{:source #"^bin/repr-wasm roundtrip" :file "test/wasm/controls.txt" :match #"(?m)^_control/"}
              {:source #"^bin/repr-wasm wast" :file "test/wasm/controls-wast.txt" :match #"(?m)^_control/"}
              {:source #"^bin/wai check --aot" :file "test/wasm/controls-aot.txt" :match #"(?m)^_control/"}
              {:source #"^bin/wai (check|essential)" :file "test/wasm/controls-eval.txt" :match #"(?m)^_control/"}
              {:source #"^bin/wai go" :file "test/wasm/controls-go.txt" :match #"(?m)^_control/"}]}]}

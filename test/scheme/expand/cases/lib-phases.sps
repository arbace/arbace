(library (lib phases helper)
  (export add1-at-expand)
  (import (rnrs))
  (define (add1-at-expand x) (+ x 1)))
(library (lib phases user)
  (export three)
  (import (rnrs) (for (lib phases helper) expand))
  (define-syntax three (lambda (x) (syntax-case x () ((_) (add1-at-expand 2))))))
(import (rnrs) (lib phases user))
(write (three))
(newline)

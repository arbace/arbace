#!r6rs
;;; SRFI 69 (srfi :69 basic-hash-tables): written from the SRFI document (https://srfi.schemers.org/srfi-69/srfi-69.html;
;;; the repository has no tests): every procedure of the specification, its stated equivalences and edge cases
;;; (first association wins in alist->hash-table, merge, copy independence, coarser equivalences with their hash,
;;; resizing past the initial size, hash bounds). Each case run on this port under Chez Scheme 10.3.0 and on si.
;;; Prints FAIL lines and a last line "srfi-69: P passed, F failed".
(import (except (rnrs) string-hash string-ci-hash symbol-hash) (srfi :69) (only (srfi :1) iota))

(define passed 0)
(define failed 0)
(define-syntax test
  (syntax-rules ()
    ((_ expr expected)
     (let ((got (guard (e (#t (list 'exception))) expr)))
       (if (equal? got expected)
           (set! passed (+ passed 1))
           (begin (set! failed (+ failed 1))
                  (display "FAIL: ") (write 'expr) (display " => ") (write got)
                  (display ", expected ") (write expected) (newline)))))))
(define-syntax test-error
  (syntax-rules ()
    ((_ expr)
     (let ((got (guard (e (#t 'raised)) expr 'returned)))
       (if (eq? got 'raised)
           (set! passed (+ passed 1))
           (begin (set! failed (+ failed 1))
                  (display "FAIL: ") (write 'expr) (display " => no error") (newline)))))))
(define (sort-pairs l) (list-sort (lambda (a b) (< (car a) (car b))) l))
(define (sort-nums l) (list-sort < l))

;; constructors and predicate
(define h (make-hash-table))
(test (hash-table? h) #t)
(test (hash-table? '()) #f)
(test (hash-table? (vector)) #f)
(test (hash-table-size h) 0)
(test (hash-table-equivalence-function h) equal?)
(test (procedure? (hash-table-hash-function h)) #t)
(test (hash-table-equivalence-function (make-hash-table eq?)) eq?)
(test (hash-table-hash-function (make-hash-table eq?)) hash-by-identity)
(test (hash-table-hash-function (make-hash-table string=?)) string-hash)
(test (hash-table-hash-function (make-hash-table string-ci=?)) string-ci-hash)
(test (hash-table-hash-function (make-hash-table equal? string-hash)) string-hash)

;; single elements
(hash-table-set! h 'a 1)
(hash-table-set! h "b" 2)
(hash-table-set! h '(c d) 3)
(hash-table-set! h 4.5 4)
(hash-table-set! h #\e 5)
(hash-table-set! h '#(1 2) 6)
(test (hash-table-size h) 6)
(test (hash-table-ref h 'a) 1)
(test (hash-table-ref h "b") 2)
(test (hash-table-ref h (list 'c 'd)) 3)
(test (hash-table-ref h 4.5) 4)
(test (hash-table-ref h #\e) 5)
(test (hash-table-ref h (vector 1 2)) 6)
(test-error (hash-table-ref h 'missing))
(test (hash-table-ref h 'missing (lambda () 'thunk)) 'thunk)
(test (hash-table-ref h 'a (lambda () 'thunk)) 1)
(test (hash-table-ref/default h 'missing 'dflt) 'dflt)
(test (hash-table-ref/default h 'a 'dflt) 1)
(test (hash-table-exists? h 'a) #t)
(test (hash-table-exists? h 'zz) #f)
(hash-table-set! h 'a 10)
(test (hash-table-ref h 'a) 10)
(test (hash-table-size h) 6)
(hash-table-delete! h 'a)
(test (hash-table-exists? h 'a) #f)
(test (hash-table-size h) 5)
(hash-table-delete! h 'a)                    ; not an error
(test (hash-table-size h) 5)
(hash-table-update! h "b" (lambda (v) (* v 100)))
(test (hash-table-ref h "b") 200)
(test-error (hash-table-update! h 'nokey (lambda (v) v)))
(hash-table-update! h 'nokey (lambda (v) (+ v 1)) (lambda () 41))
(test (hash-table-ref h 'nokey) 42)
(hash-table-update!/default h 'cnt (lambda (v) (+ v 1)) 0)
(hash-table-update!/default h 'cnt (lambda (v) (+ v 1)) 0)
(test (hash-table-ref h 'cnt) 2)

;; whole contents
(define t (make-hash-table))
(do ((i 0 (+ i 1))) ((= i 200)) (hash-table-set! t i (* i i)))      ; grows past the initial size
(test (hash-table-size t) 200)
(test (hash-table-ref t 199) (* 199 199))
(test (hash-table-ref t 0) 0)
(test (sort-nums (hash-table-keys t)) (iota 200))
(test (sort-nums (hash-table-values t)) (map (lambda (i) (* i i)) (iota 200)))
(test (length (hash-table->alist t)) 200)
(test (equal? (sort-pairs (hash-table->alist t)) (map (lambda (i) (cons i (* i i))) (iota 200))) #t)
(test (let ((s 0)) (hash-table-walk t (lambda (k v) (set! s (+ s k)))) s) (/ (* 199 200) 2))
(test (hash-table-fold t (lambda (k v acc) (+ acc v)) 0) (apply + (map (lambda (i) (* i i)) (iota 200))))
(test (hash-table-fold (make-hash-table) (lambda (k v acc) (+ acc 1)) 'init) 'init)
(do ((i 0 (+ i 2))) ((>= i 200)) (hash-table-delete! t i))
(test (hash-table-size t) 100)
(test (sort-nums (hash-table-keys t)) (filter odd? (iota 200)))

;; alist->hash-table
(define a (alist->hash-table '((x . 1) (y . 2) (x . 3))))
(test (hash-table-ref a 'x) 1)                  ; the first association takes precedence
(test (hash-table-size a) 2)
(test (hash-table-ref a 'y) 2)
(test (hash-table-size (alist->hash-table '())) 0)
(define ci (alist->hash-table '(("Foo" . 1)) string-ci=? string-ci-hash))
(test (hash-table-ref ci "fOO") 1)
(test (hash-table-ref/default ci "bar" 'no) 'no)
;; the round trip stated in the SRFI
(define rt (alist->hash-table (hash-table->alist t) (hash-table-equivalence-function t) (hash-table-hash-function t)))
(test (hash-table-size rt) 100)
(test (equal? (sort-pairs (hash-table->alist rt)) (sort-pairs (hash-table->alist t))) #t)

;; copy and merge
(define c (hash-table-copy a))
(test (hash-table-size c) 2)
(hash-table-set! c 'z 26)
(test (hash-table-exists? a 'z) #f)             ; the copy is independent
(hash-table-set! a 'q 17)
(test (hash-table-exists? c 'q) #f)
(test (eq? (hash-table-equivalence-function c) (hash-table-equivalence-function a)) #t)
(define m1 (alist->hash-table '((a . 1) (b . 2))))
(define m2 (alist->hash-table '((b . 20) (c . 30))))
(test (eq? (hash-table-merge! m1 m2) m1) #t)
(test (sort-pairs (map (lambda (p) (cons (char->integer (string-ref (symbol->string (car p)) 0)) (cdr p))) (hash-table->alist m1)))
      '((97 . 1) (98 . 20) (99 . 30)))
(test (hash-table-size m2) 2)

;; equivalences
(define e (make-hash-table eq?))
(hash-table-set! e 'k 1)
(test (hash-table-ref/default e 'k 0) 1)
(test (hash-table-ref/default e (string #\a) 0) 0)
(define s (make-hash-table string=?))
(hash-table-set! s "abc" 1)
(test (hash-table-ref/default s (string-append "a" "bc") 0) 1)
(define cih (make-hash-table string-ci=?))
(hash-table-set! cih "Hello" 1)
(test (hash-table-ref/default cih "hELLO" 0) 1)
(define ev (make-hash-table eqv?))
(hash-table-set! ev 2.5 'x)
(test (hash-table-ref/default ev 2.5 #f) 'x)
(define coarse (make-hash-table (lambda (x y) (= (div x 10) (div y 10))) (lambda (x . b) (div x 10))))
(hash-table-set! coarse 11 'ten)
(test (hash-table-ref/default coarse 15 #f) 'ten)

;; hashing
(test (hash "abc") (string-hash "abc"))
(test (= (hash "abc") (hash (string-append "ab" "c"))) #t)
(test (= (hash '(1 2 (3))) (hash (list 1 2 (list 3)))) #t)
(test (= (hash 5) 5) #t)
(test (< (hash "anything" 100) 100) #t)
(test (< (string-hash "anything" 7) 7) #t)
(test (>= (hash "anything") 0) #t)
(test (= (string-ci-hash "AbC") (string-ci-hash "aBc")) #t)
(test (= (string-ci-hash "AbC" 1000) (string-ci-hash "abc" 1000)) #t)
(test (= (hash-by-identity 'sym) (hash-by-identity 'sym)) #t)
(test (< (hash-by-identity 'sym 10) 10) #t)
(test (= (hash 1.5) (hash 1.5)) #t)
(test (= (hash (vector 1 2 3)) (hash (vector 1 2 3))) #t)
(test-error (hash car))

(display "srfi-69: ") (display passed) (display " passed, ") (display failed) (display " failed") (newline)

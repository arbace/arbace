  {:text "#!fold-case ẞ" :rule :fold-case :chez [ss] :si [ss]}
  {:text "#!chezscheme a" :rule :hash-bang :chez [a] :si [a]}
  ;; SCS12 (c): full case folding (C and F: ẞ ss, ﬁ fi, µ μ, the final sigma σ, Cherokee's small letters to the capitals), the
  ;; character names folded, the x of a hex scalar value not
  {:text "#!fold-case ẞ ΣΑΣ ﬁx µ ꭰ" :rule :fold-case :chez [ss (scm/sym "σασ") fix (scm/sym "μ") (scm/sym "Ꭰ")] :si [ss (scm/sym "σασ") fix (scm/sym "μ") (scm/sym "Ꭰ")]}
  {:text "#!fold-case #\\Nul İ" :rule :fold-case :chez [\u0000 (scm/sym "i\u0307")] :si [\u0000 (scm/sym "i\u0307")]}
  {:text "#!fold-case #\\X41" :rule :fold-case :chez :error :si :error}
  {:text "#!chezscheme |a| b" :rule :hash-bang :chez [a b] :si [a b] :class :chezscheme-extensions}
  ;; SCS14 (b): the polar numbers, by the correctly rounded cosine and sine
  {:text "1@2" :rule :polar :chez [(scm/complex -0.4161468365471424 0.9092974268256817)] :si [(scm/complex -0.4161468365471424 0.9092974268256817)]}
  {:text "1.1@2.2" :rule :polar :chez [(scm/complex -0.6473512289808805 0.8893460442015492)] :si [(scm/complex -0.6473512289808805 0.8893460442015492)]}

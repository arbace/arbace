;; SCS10 (b) (the user 2026-11-08; doc/scheme/SPEC.md 12, doc/scheme/SCHEME-SURVEY.md "As built: SCS9 (c), SCS10 (b), SCS11 (b)"):
;; si's stated choices where R6RS leaves the reading to the implementation, each checked on cases of its own beside the probes:
;; :text, the choice it exercises (:rule, SPEC 12's id), what Chez Scheme 10.3.0's R6RS reader gives (:chez, recorded by hand
;; 2026-11-08 with tools/schemedump/dump.ss: the data, or :error) and what si's runtime reader gives (:si, go/arbace/scm/read.ae's
;; `read` on an input string port, `bin/si run`, by hand the same day). At every bin/repr-scheme check (choices-test) the report with
;; the choices (arbace.repr.scheme.report) must read each :text as repr/scheme's reader does, and a case whose :chez or :si differs
;; from that reading must name its class (:class, one of :classes); a case named but agreeing fails too (a stale class).
;; The probes' 48 and the files' 2 cases the choices decide agree with Chez's dumps (bin/repr-scheme report-check). Read with the
;; Clojure reader.
{:classes
 {:fold-char-names {:title "#!fold-case folds character names too in Chez and in si's runtime reader (R7RS 2.1's rule); repr/scheme's reader folds identifiers alone (SPEC 12 :fold-case), so #\\SPACE after #!fold-case is an error there"
                    :proposed "SCS12"}
  :fold-full {:title "Chez folds an identifier by string-foldcase (full case folding: ẞ to ss); repr/scheme's reader and si's runtime lower-case it (String.toLowerCase, Go's unicode.ToLower: ẞ to ß)"
              :proposed "SCS12"}
  :chezscheme-directive {:title "#!chezscheme is Chez's directive back to its extended syntax, which si's runtime reader also takes (and ignores); repr/scheme's reader refuses it (SPEC 12 :hash-bang: R6RS mode alone)"
                         :proposed "SCS12"}}
 :cases
 [{:text "1/0" :rule :ratio-over-zero :chez :error :si :error}
  {:text "#i-1/0" :rule :ratio-over-zero :chez [(scm/flonum "-inf.0")] :si [(scm/flonum "-inf.0")]}
  {:text "#i0/0" :rule :ratio-over-zero :chez [(scm/flonum "+nan.0")] :si [(scm/flonum "+nan.0")]}
  {:text "#i-0/0" :rule :ratio-over-zero :chez [(scm/flonum "+nan.0")]}
  {:text "#i1/0+1i" :rule :ratio-over-zero :chez [(scm/complex (scm/flonum "+inf.0") 1.0)] :si [(scm/complex (scm/flonum "+inf.0") 1.0)]}
  {:text "#e+nan.0" :rule :exact-naninf :chez :error :si :error}
  {:text "1.5|10" :rule :mantissa-width :chez [1.5] :si [1.5]}
  {:text "#i1.5|2" :rule :mantissa-width :chez [1.5]}
  {:text "#e1|2" :rule :mantissa-width :chez [1]}
  {:text "1/2+0.5i" :rule :mixed-exactness :chez [(scm/complex 0.5 0.5)]}
  {:text "+inf.0i" :rule :mixed-exactness :chez [(scm/complex 0.0 (scm/flonum "+inf.0"))] :si [(scm/complex 0.0 (scm/flonum "+inf.0"))]}
  {:text "#!fold-case ABC #!no-fold-case ABC" :rule :fold-case :chez [abc ABC] :si [abc ABC]}
  {:text "#!fold-case Ǆ" :rule :fold-case :chez [(scm/sym "ǆ")]}
  {:text "#!FOLD-CASE A" :rule :hash-bang :chez :error}
  {:text "#!eof" :rule :hash-bang :chez :error :si :error}
  {:text "#!fold-case #\\SPACE" :rule :fold-case :chez [\space] :si [\space] :class :fold-char-names}
  {:text "#!fold-case ẞ" :rule :fold-case :chez [ss] :si [(scm/sym "ß")] :class :fold-full}
  {:text "#!chezscheme a" :rule :hash-bang :chez [a] :si [a] :class :chezscheme-directive}]}

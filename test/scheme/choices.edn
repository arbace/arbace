  {:text "#e1@2" :rule :polar :chez :error :si :error}
  {:text "1@1e500" :rule :polar :chez [(scm/complex (scm/flonum "+nan.0") (scm/flonum "+nan.0"))] :si [(scm/complex (scm/flonum "+nan.0") (scm/flonum "+nan.0"))]}
  {:text "+inf.0@1" :rule :polar :chez [(scm/complex (scm/flonum "+inf.0") (scm/flonum "+inf.0"))] :si [(scm/complex (scm/flonum "+inf.0") (scm/flonum "+inf.0"))]}
  {:text "1@0.0" :rule :polar :chez [(scm/complex 1.0 0.0)] :si [(scm/complex 1.0 0.0)]}
  {:text "1@-0.7908624416397423" :rule :polar :chez [(scm/complex 0.7032324157251022 -0.7109600336681642)] :si [(scm/complex 0.7032324157251022 -0.7109600336681642)]
   :reader-class :polar-last-bit}
  {:text "1@5.881877911969697" :rule :polar :chez [(scm/complex 0.9205510832960621 -0.39062219988429553)] :si [(scm/complex 0.9205510832960622 -0.39062219988429553)]
   :class :polar-last-bit :reader-class :polar-last-bit}
  {:text "1@0.6641849478023065" :rule :polar :chez [(scm/complex 0.7874194590966177 0.616417549584687)] :si [(scm/complex 0.7874194590966176 0.616417549584687)]
   :class :polar-last-bit :reader-class :polar-last-bit}
  ;; SCS18 (b): the report's grammar where Chez reads past it (:rule :grammar: no choice applies, the report alone decides); recorded by
  ;; hand 2026-11-09, Chez 10.3.0 on #!r6rs string ports and si's runtime (bin/si run, this tree's light driver)
  {:text "+INF.0" :rule :grammar :chez [(scm/flonum "+inf.0")] :si :error :class :chez-naninf-case}
  {:text "#i-NaN.0" :rule :grammar :chez [(scm/flonum "+nan.0")] :si :error :class :chez-naninf-case}
  {:text "#x1|53" :rule :grammar :chez [1.0] :si :error :class :chez-radix-mantissa-width}
  {:text "#b1|53" :rule :grammar :chez [1.0] :si :error :class :chez-radix-mantissa-width}
  {:text "1|53" :rule :grammar :chez [1.0] :si [1.0]}
  {:text "#e1#t" :rule :grammar :chez :error :si [1 true] :class :chez-hash-after-prefixed-number}
  {:text "#x1#(2)" :rule :grammar :chez :error :si [1 [2]] :class :chez-hash-after-prefixed-number}
  {:text "#e1#;x" :rule :grammar :chez :error :si [1] :class :chez-hash-after-prefixed-number}]}

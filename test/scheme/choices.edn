;; SCS10 (b) (the user 2026-11-08; doc/scheme/SPEC.md 12, doc/scheme/SCHEME-SURVEY.md "As built: SCS9 (c), SCS10 (b), SCS11 (b)"):
;; si's stated choices where R6RS leaves the reading to the implementation, each checked on cases of its own beside the probes:
;; :text, the choice it exercises (:rule, SPEC 12's id), what Chez Scheme 10.3.0's R6RS reader gives (:chez, recorded by hand
;; 2026-11-08 with tools/schemedump/dump.ss: the data, or :error) and what si's runtime reader gives (:si, go/arbace/scm/read.ae's
;; `read` on an input string port, `bin/si run`, by hand the same day). At every bin/repr-scheme check (choices-test) the report with
;; the choices (arbace.repr.scheme.report) must read each :text as repr/scheme's reader does, and a case whose :chez or :si differs
;; from that reading must name its class (:class, one of :classes); a case named but agreeing fails too (a stale class). Since
;; SCS14 (b) a case where repr/scheme's reader reads otherwise than the report names its class too (:reader-class), and a class
;; with :last-bit true holds readings that differ from the report's by one unit in the last place alone (verified: the polar
;; numbers, whose report computes the cosine and the sine correctly rounded). Since SCS12 (c) (the user 2026-11-08) the readers
;; fold by full case folding, fold character names and take #!chezscheme: SCS10's three classes (:fold-char-names, :fold-full,
;; :chezscheme-directive) are gone, their cases agree. The cases below the first eighteen were recorded the same way by hand
;; 2026-11-08 (Chez's with dump.ss; si's runtime's on string ports, `bin/si run`, a light driver of this tree).
;; The probes' 48 and the files' 2 cases the choices decide agree with Chez's dumps (bin/repr-scheme report-check). Read with the
;; Clojure reader.
{:classes
 {:polar-last-bit {:title "a polar number's part one unit in the last place off the report's correctly rounded value (SPEC 12 :polar): repr/scheme's reader takes the cosine and the sine of jrt's StrictMath (fdlibm 5.3's algorithms), Chez 10.3.0 here its C library's (musl's, FreeBSD msun's, fdlibm's descendants), within one ulp and not correctly rounded everywhere (on 2,008 angles sampled: StrictMath 95 values off of 4,016, Chez 87, si's runtime on Go's math none)"
                   :last-bit true}
  :chezscheme-extensions {:title "after #!chezscheme Chez reads its extended syntax and si's runtime reader its R7RS one (|a| a symbol); repr/scheme's reader and the report take the directive and stay in R6RS's syntax (SPEC 12 :hash-bang), so an extension after it is a syntax violation there"
                          :proposed "SCS15"}}
 :cases
 [{:text "1/0" :rule :ratio-over-zero :chez :error :si :error}
  {:text "#i-1/0" :rule :ratio-over-zero :chez [(scm/flonum "-inf.0")] :si [(scm/flonum "-inf.0")]}
  {:text "#i0/0" :rule :ratio-over-zero :chez [(scm/flonum "+nan.0")] :si [(scm/flonum "+nan.0")]}
  {:text "#i-0/0" :rule :ratio-over-zero :chez [(scm/flonum "+nan.0")]}
  {:text "#i1/0+1i" :rule :ratio-over-zero :chez [(scm/complex (scm/flonum "+inf.0") 1.0)] :si [(scm/complex (scm/flonum "+inf.0") 1.0)]}
  {:text "#e+nan.0" :rule :exact-naninf :chez :error :si :error}
  {:text "1.5|10" :rule :mantissa-width :chez [1.5] :si [1.5]}
  {:text "#i1.5|2" :rule :mantissa-width :chez [1.5]}
  {:text "#e1|2" :rule :mantissa-width :chez [1]}
  {:text "1/2+0.5i" :rule :mixed-exactness :chez [(scm/complex 0.5 0.5)]}
  {:text "+inf.0i" :rule :mixed-exactness :chez [(scm/complex 0.0 (scm/flonum "+inf.0"))] :si [(scm/complex 0.0 (scm/flonum "+inf.0"))]}
  {:text "#!fold-case ABC #!no-fold-case ABC" :rule :fold-case :chez [abc ABC] :si [abc ABC]}
  {:text "#!fold-case Ǆ" :rule :fold-case :chez [(scm/sym "ǆ")]}
  {:text "#!FOLD-CASE A" :rule :hash-bang :chez :error}
  {:text "#!eof" :rule :hash-bang :chez :error :si :error}
  {:text "#!fold-case #\\SPACE" :rule :fold-case :chez [\space] :si [\space]}
  {:text "#!fold-case ẞ" :rule :fold-case :chez [ss] :si [ss]}
  {:text "#!chezscheme a" :rule :hash-bang :chez [a] :si [a]}
  ;; SCS12 (c): full case folding (C and F: ẞ ss, ﬁ fi, µ μ, the final sigma σ, Cherokee's small letters to the capitals), the
  ;; character names folded, the x of a hex scalar value not
  {:text "#!fold-case ẞ ΣΑΣ ﬁx µ ꭰ" :rule :fold-case :chez [ss (scm/sym "σασ") fix (scm/sym "μ") (scm/sym "Ꭰ")] :si [ss (scm/sym "σασ") fix (scm/sym "μ") (scm/sym "Ꭰ")]}
  {:text "#!fold-case #\\Nul İ" :rule :fold-case :chez [\u0000 (scm/sym "i\u0307")] :si [\u0000 (scm/sym "i\u0307")]}
  {:text "#!fold-case #\\X41" :rule :fold-case :chez :error :si :error}
  {:text "#!chezscheme |a| b" :rule :hash-bang :chez [a b] :si [a b] :class :chezscheme-extensions}
  ;; SCS14 (b): the polar numbers, by the correctly rounded cosine and sine
  {:text "1@2" :rule :polar :chez [(scm/complex -0.4161468365471424 0.9092974268256817)] :si [(scm/complex -0.4161468365471424 0.9092974268256817)]}
  {:text "1.1@2.2" :rule :polar :chez [(scm/complex -0.6473512289808805 0.8893460442015492)] :si [(scm/complex -0.6473512289808805 0.8893460442015492)]}
  {:text "0@2" :rule :polar :chez [0] :si [0]}
  {:text "#i0@2" :rule :polar :chez [(scm/complex -0.0 0.0)] :si [(scm/complex -0.0 0.0)]}
  {:text "#e1@2" :rule :polar :chez :error :si :error}
  {:text "1@1e500" :rule :polar :chez [(scm/complex (scm/flonum "+nan.0") (scm/flonum "+nan.0"))] :si [(scm/complex (scm/flonum "+nan.0") (scm/flonum "+nan.0"))]}
  {:text "+inf.0@1" :rule :polar :chez [(scm/complex (scm/flonum "+inf.0") (scm/flonum "+inf.0"))] :si [(scm/complex (scm/flonum "+inf.0") (scm/flonum "+inf.0"))]}
  {:text "1@0.0" :rule :polar :chez [(scm/complex 1.0 0.0)] :si [(scm/complex 1.0 0.0)]}
  {:text "1@-0.7908624416397423" :rule :polar :chez [(scm/complex 0.7032324157251022 -0.7109600336681642)] :si [(scm/complex 0.7032324157251022 -0.7109600336681642)]
   :reader-class :polar-last-bit}
  {:text "1@5.881877911969697" :rule :polar :chez [(scm/complex 0.9205510832960621 -0.39062219988429553)] :si [(scm/complex 0.9205510832960622 -0.39062219988429553)]
   :class :polar-last-bit :reader-class :polar-last-bit}
  {:text "1@0.6641849478023065" :rule :polar :chez [(scm/complex 0.7874194590966177 0.616417549584687)] :si [(scm/complex 0.7874194590966176 0.616417549584687)]
   :class :polar-last-bit :reader-class :polar-last-bit}]}

  {:text "+inf.0i" :rule :mixed-exactness :chez [(scm/complex 0.0 (scm/flonum "+inf.0"))] :si [(scm/complex 0.0 (scm/flonum "+inf.0"))]}
  {:text "#!fold-case ABC #!no-fold-case ABC" :rule :fold-case :chez [abc ABC] :si [abc ABC]}
  {:text "#!fold-case Ǆ" :rule :fold-case :chez [(scm/sym "ǆ")]}
  {:text "#!FOLD-CASE A" :rule :hash-bang :chez :error}
  {:text "#!eof" :rule :hash-bang :chez :error :si :error}

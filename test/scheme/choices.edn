  {:text "#i0/0" :rule :ratio-over-zero :chez [(scm/flonum "+nan.0")] :si [(scm/flonum "+nan.0")]}
  {:text "#i-0/0" :rule :ratio-over-zero :chez [(scm/flonum "+nan.0")]}
  {:text "#i1/0+1i" :rule :ratio-over-zero :chez [(scm/complex (scm/flonum "+inf.0") 1.0)] :si [(scm/complex (scm/flonum "+inf.0") 1.0)]}
  {:text "#e+nan.0" :rule :exact-naninf :chez :error :si :error}
  {:text "1.5|10" :rule :mantissa-width :chez [1.5] :si [1.5]}

;; SCS10 (b) (the user 2026-11-08; doc/scheme/SPEC.md 12, doc/scheme/SCHEME-SURVEY.md "As built: SCS9 (c), SCS10 (b), SCS11 (b)"):
;; si's stated choices where R6RS leaves the reading to the implementation, each checked on cases of its own beside the probes:
;; :text, the choice it exercises (:rule, SPEC 12's id), what Chez Scheme 10.3.0's R6RS reader gives (:chez, recorded by hand
;; 2026-11-08 with tools/schemedump/dump.ss: the data, or :error) and what si's runtime reader gives (:si, go/arbace/scm/read.ae's
;; `read` on an input string port, `bin/si run`, by hand the same day). At every bin/repr-scheme check (choices-test) the report with
;; the choices (arbace.repr.scheme.report) must read each :text as repr/scheme's reader does, and a case whose :chez or :si differs
;; from that reading must name its class (:class, one of :classes); a case named but agreeing fails too (a stale class). Since
;; SCS14 (b) a case where repr/scheme's reader reads otherwise than the report names its class too (:reader-class), and a class
;; with :last-bit true holds readings that differ from the report's by one unit in the last place alone (verified: the polar
;; numbers, whose report computes the cosine and the sine correctly rounded). Since SCS12 (c) (the user 2026-11-08) the readers
;; fold by full case folding, fold character names and take #!chezscheme: SCS10's three classes (:fold-char-names, :fold-full,
;; :chezscheme-directive) are gone, their cases agree. The cases below the first eighteen were recorded the same way by hand
;; 2026-11-08 (Chez's with dump.ss; si's runtime's on string ports, `bin/si run`, a light driver of this tree).
;; The probes' 48 and the files' 2 cases the choices decide agree with Chez's dumps (bin/repr-scheme report-check). Read with the
;; Clojure reader.
{:classes
 {:polar-last-bit {:title "a polar number's part one unit in the last place off the report's correctly rounded value (SPEC 12 :polar): repr/scheme's reader takes the cosine and the sine of jrt's StrictMath (fdlibm 5.3's algorithms), Chez 10.3.0 here its C library's (musl's, FreeBSD msun's, fdlibm's descendants), within one ulp and not correctly rounded everywhere (on 2,008 angles sampled: StrictMath 95 values off of 4,016, Chez 87, si's runtime on Go's math none)"
                   :last-bit true}
  :chezscheme-extensions {:title "after #!chezscheme Chez reads its extended syntax and si's runtime reader its R7RS one (|a| a symbol); repr/scheme's reader and the report take the directive and stay in R6RS's syntax (SPEC 12 :hash-bang), so an extension after it is a syntax violation there"
                          :decided "SCS15 (a), the user 2026-11-09: stays classed (the spec's reader is R6RS's, SPEC 6; no corpus file has #!chezscheme)"}
  ;; SCS18 (b) (the user 2026-11-09): where Chez 10.3.0's R6RS mode reads past R6RS 4.2.1's grammar (test/scheme/report-chez.edn's three
  ;; rules until then): both readers refuse as the grammar does (SPEC 12 :report-over-chez), the difference is Chez's; :ids are the
  ;; probes (test/scheme/probes.edn) bin/repr-scheme report-check holds to differ from Chez's dump, :match the shape of their texts
  :chez-naninf-case {:title "R6RS 4.2.1's <naninf> is nan.0 | inf.0 in lower case (the grammar spells the cases it allows elsewhere: #B, #E, #T, E, S, F, D, L, A-F); Chez reads +INF.0 as +inf.0, both readers refuse it"
                     :match #"[+-](?!inf\.0|nan\.0)(?i:inf\.0|nan\.0)"
                     :ids ["num-0033" "num-0173" "num-0243" "num-0313" "num-0383" "num-0453" "num-0663" "num-0733"]}
  :chez-radix-mantissa-width {:title "R6RS 4.2.1's <mantissa width> follows a <decimal R>, which only radix 10 has (<decimal 10>); Chez takes #x1|53 as 1.0, both readers refuse it"
                              :match #"(?i)^(#[eixbod])*#[xbo](#[eixbod])*[0-9a-f]+\|[0-9]+$"
                              :ids ["num-0235" "num-0305" "num-0375" "num-0515" "num-0585" "num-0655" "num-0725"]}
  :chez-hash-after-prefixed-number {:title "# is a <delimiter> (R6RS 4.2.1): #e1# is the number #e1 and then a # lexeme (#e1#t is 1 and #t); Chez's reader keeps the R5RS digit placeholder # inside a prefixed number's token and refuses the whole token, both readers end the token at the #"
                                    :match #"(?i)^(#[eixbod])+[0-9a-f]+#"
                                    :ids ["num-0138" "num-0139" "num-0208" "num-0209" "num-0278" "num-0279" "num-0348" "num-0349" "num-0418" "num-0419" "num-0488" "num-0489" "num-0558" "num-0559" "num-0628" "num-0629" "num-0698" "num-0699" "num-0768" "num-0769" "num-0838" "num-0839"]}}
 :cases
 [{:text "1/0" :rule :ratio-over-zero :chez :error :si :error}

;; The negative controls of the Scheme crop's check families (GTS81 (a); arbace.scheme.controls, doc/scheme/SCHEME-SURVEY.md "As built:
;; SMR8"): bin/si r7rs, srfi, chibi-tests, ecraven and bin/repr-scheme check, roundtrip (bin/si check's own are
;; test/scheme/si/controls.edn). A control judges a run of its :subject case against the :reference case's by the family's own judge,
;; and must be found (a regress line, an own verdict's item) for what :expect names; a :sanity entry is the converse, the run
;; that agrees with its reference must not be found. The runs are made from the families' records (test/scheme/check-*.edn) or are
;; texts of the entry, the references are the judges' results for the reference case's own run; nothing is run. Read with the
;; Clojure reader.
[
 ;; ---- bin/si r7rs: Chibi's R7RS suite, test by test (the own verdict of each test, the count, the references' answers)
 {:id "_control/r7rs-agree" :family :r7rs :sanity true :why "the suite's own run again: nothing is found"}
 {:id "_control/r7rs-fails" :family :r7rs :edit {:pick :first-pass :to :fail} :expect #"new-item r7rs/chibi: fails r7rs/chibi"
  :why "a test that passes in the record fails: the test's own verdict is an item"}
 {:id "_control/r7rs-fails-where-references-pass" :family :r7rs :edit {:pick :both-pass :to :fail} :expect #"new-item r7rs/chibi: against-references"
  :why "si fails a test Chez and Chibi both pass: an item against both references (needs a class)"}
 {:id "_control/r7rs-cut" :family :r7rs :edit {:cut 600} :expect #"count r7rs/chibi"
  :why "a run that stops early with status 0: the expected number of tests"}
 {:id "_control/r7rs-crash" :family :r7rs :edit {:rc "1" :err "boom"} :expect #"crash r7rs/chibi status 1"
  :why "a non-zero status"}

 ;; ---- bin/si srfi: the SRFIs' programs, each with its report line
 {:id "_control/srfi-agree" :family :srfi :subject "srfi-1" :reference "srfi-1" :sanity true}
 {:id "_control/srfi-1-vs-13" :family :srfi :subject "srfi-13" :reference "srfi-1" :expect #"counts srfi/srfi-1: tests 201"
  :why "srfi-13's report judged as srfi-1's: another count of checks than the record's"}
 {:id "_control/srfi-fail-line" :family :srfi :subject "srfi-1" :reference "srfi-1" :edit {:fail-line true} :expect #"new-item srfi/srfi-1: fails srfi/srfi-1"
  :why "a FAIL line and a failed check in the report"}
 {:id "_control/srfi-no-report" :family :srfi :subject "srfi-1" :reference "srfi-1" :edit {:truncate true} :expect #"report srfi/srfi-1"
  :why "a program that prints nothing"}
 {:id "_control/srfi-crash" :family :srfi :subject "srfi-1" :reference "srfi-1" :edit {:rc "1"} :expect #"crash srfi/srfi-1"
  :why "a non-zero status"}

 ;; ---- bin/si chibi-tests: Chibi's own tests, mark by mark against Chibi's
 {:id "_control/chibi-tests-agree" :family :chibi-tests :subject "diff" :reference "diff" :sanity true}
 {:id "_control/chibi-tests-diff-vs-optional" :family :chibi-tests :subject "diff" :reference "optional" :expect #"regress (counts|verdict|pass-fails) chibi-tests/optional"
  :why "diff-test's marks judged as optional-test's: another number of tests"}
 {:id "_control/chibi-tests-fail-mark" :family :chibi-tests :subject "diff" :reference "diff" :edit {:set-si [0 "x"]} :expect #"new-item chibi-tests/diff: fails chibi-tests/diff test 1"
  :why "a failing mark on si where Chibi passes"}
 {:id "_control/chibi-tests-missing-marks" :family :chibi-tests :subject "diff" :reference "diff" :edit {:drop-si 5} :expect #"new-item chibi-tests/diff: marks chibi-tests/diff"
  :why "fewer tests ran on si than on Chibi"}
 {:id "_control/chibi-tests-crash" :family :chibi-tests :subject "diff" :reference "diff" :edit {:rc "1"} :expect #"crash chibi-tests/diff status 1"}

 ;; ---- bin/si ecraven: ecraven's benchmarks, each checks its own result
 {:id "_control/ecraven-agree" :family :ecraven :subject "array1" :sanity true}
 {:id "_control/ecraven-incorrect" :family :ecraven :subject "array1" :edit {:out "CSVLINE!+si,array1,1.5\nINCORRECT\n"} :expect #"fails ecraven/array1 returned an incorrect result"
  :why "the benchmark's own check of its result says INCORRECT"}
 {:id "_control/ecraven-no-csv" :family :ecraven :subject "array1" :edit {:no-csv true} :expect #"crash ecraven/array1"
  :why "no result line: the benchmark did not finish"}
 {:id "_control/ecraven-timeout" :family :ecraven :subject "array1" :edit {:no-csv true :rc "124"} :expect #"crash ecraven/array1 timeout"}

 ;; ---- bin/repr-scheme check: the reader and `write` against Chez's dump of the text (the dump of the reference text stands in:
 ;; no Chez runs in a control; the live check's judge is the same, ck/compare-file)
 {:id "_control/read-agree" :family :read :subject "(define (f x) (+ x 1)) #(1 2) \"s\" #\\a 'q" :sanity true}
 {:id "_control/read-tree" :family :read :subject "(a b c)" :reference "(a b d)" :expect #":kind :tree"
  :why "another text's data: the first datum differs (E-tree)"}
 {:id "_control/read-count" :family :read :subject "a b" :reference "a b c" :expect #":kind :count"
  :why "one datum fewer than Chez read"}
 {:id "_control/read-offset" :family :read :subject "a b" :reference "a  b" :expect #":kind :off"
  :why "the same data at other offsets"}
 {:id "_control/read-write" :family :read :subject "(a b)" :edit {:write "(a  b)"} :expect #":kind :write"
  :why "Chez writes the datum another way (E-write)"}
 {:id "_control/read-error-extra" :family :read :subject "(a" :reference "" :expect #":kind :error-extra"
  :why "Arbace raises where Chez read the text"}
 {:id "_control/read-error-missing" :family :read :subject "(a)" :edit {:chez-error "unexpected close parenthesis"} :expect #":kind :error-missing"
  :why "Chez raises where Arbace read the text (E-error)"}

 ;; ---- bin/repr-scheme roundtrip: the layer prints the text back, byte for byte
 {:id "_control/roundtrip-agree" :family :roundtrip :subject "(define (f x)   ; c\n  #;(skip) x)\n#| b |# 'q\n" :sanity true}
 {:id "_control/roundtrip-other-text" :family :roundtrip :subject "(define (f x) x)" :reference "(define (g x) x)" :expect #":full"
  :why "the printed-back text compared with another case's text (E-full)"}
 {:id "_control/roundtrip-layout" :family :roundtrip :subject "(a b)\n" :reference "(a b)\n\n" :expect #":full"
  :why "a text with one more newline than the printed back"}
]

;; proper tail calls: a loop of 10^7 iterations in constant space (doc/scheme/SCHEME-SURVEY.md §5.2)
(import (rnrs))
(define (count-to n) (let loop ((i 0)) (if (< i n) (loop (+ i 1)) i)))
(display (count-to 10000000)) (newline)
(define (even2? n) (if (= n 0) #t (odd2? (- n 1))))
(define (odd2? n) (if (= n 0) #f (even2? (- n 1))))
(display (even2? 1000001)) (newline)
(define (f n acc) (cond ((= n 0) acc) ((odd? n) (f (- n 1) (+ acc 1))) (else (apply f (list (- n 1) acc)))))
(display (f 1000000 0)) (newline)

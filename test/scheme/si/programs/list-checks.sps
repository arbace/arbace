;;; SMR2: the list arguments Chez checks, a circular, an improper or an altered list, as (chezscheme) takes them: each call prints
;;; ok or raise (the answer, not the message, which the Chez and si words differ in), the same on Chez and on si.
(import (chezscheme))

(define-syntax try
  (syntax-rules ()
    ((_ e) (begin (display (call/cc (lambda (k) (with-exception-handler (lambda (c) (k 'raise)) (lambda () e 'ok))))) (newline)))))

(define (cyc) (let ((l (list 1 2 3))) (set-cdr! (cddr l) l) l))
(define (acyc) (let ((l (list (cons 1 1) (cons 2 2) (cons 3 3)))) (set-cdr! (cddr l) l) l))

(try (for-all values (cyc)))
(try (exists values (cyc)))
(try (for-each values (cyc)))
(try (map values (cyc)))
(try (andmap values (cyc)))
(try (ormap values (cyc)))
(try (andmap values '(1 . 2)))
(try (ormap values 'a))
(try (andmap (lambda (x y) x) '(1 2) '(1 2 3)))
(try (andmap 3 '()))
(try (ormap 3 '()))
(try (fold-left cons 0 (cyc)))
(try (fold-left cons 0 '(1 . 2)))
(try (memp odd? (cyc)))
(try (memp even? '(1 3 . 4)))
(try (memp odd? '(1 3 . 4)))
(try (memp odd? 5))
(try (find even? (cyc)))
(try (find even? '(1 3 . 4)))
(try (assp even? (acyc)))
(try (assp even? '((1) (2) . 3)))
(try (assp even? '((1) 2)))
(try (assq 'a (acyc)))
(try (assq 'a '((b) . 3)))
(try (iota -1))
(try (iota 2.0))
(try (iota 'a))
(try (iota 3))
(try (list-copy '(1 . 2)))
(try (list-copy (cyc)))
(try (list-copy '(1 2)))
;; a list altered by the procedure: for-each, for-all, exists, andmap and ormap see it; map and fold-left's shortening do not
(define (l4) (list 1 2 3 4))
(try (let ((l (l4))) (for-each (lambda (x) (set-cdr! (cdr l) '())) l)))
(try (let ((l (l4))) (for-each (lambda (x) (set-cdr! (cddr l) 1)) l)))
(try (let ((l (l4))) (for-all (lambda (x) (set-cdr! (cdr l) 1) #t) l)))
(try (let ((l (l4))) (exists (lambda (x) (set-cdr! (cdr l) 1) #f) l)))
(try (let ((l (l4))) (andmap (lambda (x) (set-cdr! (cdr l) 1) #t) l)))
(try (let ((l (l4))) (ormap (lambda (x) (set-cdr! (cdr l) 1) #f) l)))
(try (let ((l (l4))) (map (lambda (x) (set-cdr! (cdr l) '()) x) l)))
(try (let ((l (l4))) (fold-left (lambda (a x) (set-cdr! (cdr l) '()) x) 0 l)))
(try (let ((l (l4))) (fold-left (lambda (a x) (set-cdr! (cdr l) 1) x) 0 l)))
(display (list (andmap + '(1 2) '(3 4)) (ormap (lambda (x) (and (> x 1) x)) '(1 2 3)) (list-copy '(1 2 3)) (iota 4)
               (memp even? '(1 2 3)) (assp even? '((1) (2) (3)))))
(newline)

#!chezscheme
;;;; SMR4: numeric corners against Chez's own answers (string->number's extended syntax, number->string's precision, NaN
;;;; as eqv?, signed zeros, remainder and modulo of flonums, expt with bignum powers, exp's overflow, sqrt of NaN parts).
;;;; Each expression prints its value or the message of its condition.
(import (chezscheme))
(define-syntax t (syntax-rules () ((_ e) (begin (write 'e) (display " => ") (write (guard (x (#t (list 'raise (if (message-condition? x) (condition-message x) x)))) (call-with-values (lambda () e) list))) (newline)))))
(define (nan) (/ 0.0 0.0))

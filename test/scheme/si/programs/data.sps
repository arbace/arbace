;; records with parents and protocols, conditions, hashtables, strings, numbers, string ports
(import (rnrs) (rnrs mutable-strings))
(define-record-type point (fields x (mutable y)) (protocol (lambda (new) (lambda (x y) (new (* 2 x) y)))))
(define-record-type (point3 make-point3 point3?) (parent point) (fields z) (protocol (lambda (p) (lambda (x y z) ((p x y) z)))))
(define p (make-point3 1 2 3))
(point-y-set! p 20)
(display (list (point-x p) (point-y p) (point3-z p) (point? p) (point3? p) (point3? (make-point 1 2)))) (newline)
(define-condition-type &my-error &error make-my-error my-error? (detail my-error-detail))
(display (guard (e ((my-error? e) (list (my-error-detail e) (error? e) (message-condition? e)))) (raise (condition (make-my-error 'd) (make-message-condition "m"))))) (newline)
(define h (make-hashtable equal-hash equal?))
(hashtable-set! h '(1 2) 'a) (hashtable-set! h "s" 'b) (hashtable-update! h '(1 2) (lambda (v) (list v v)) #f)
(display (list (hashtable-ref h (list 1 2) #f) (hashtable-ref h "s" #f) (hashtable-size h) (hashtable-contains? h 'x))) (newline)
(define e (make-eqv-hashtable)) (hashtable-set! e 1.5 'f) (hashtable-set! e (expt 2 100) 'big)
(display (list (hashtable-ref e 1.5 #f) (hashtable-ref e (expt 2 100) #f))) (newline)
(define s (make-string 3 #\a)) (string-set! s 1 #\b)
(display (list s (string-upcase "Straße") (string->symbol "hi there") (symbol->string 'abc) (string-append "a" "b") (string->list "xy"))) (newline)
(write (list 1/3 (/ 6 4) (inexact 1/3) (expt 2 70) (- (expt 2 62)) 1e21 123.456 (sqrt 16) (sqrt 2) (exact (floor 2.5)) (round 2.5) (round 7/2) (/ 1. 0.) (string->number "#xff") (number->string 255 16))) (newline)
(write (list #\a #\space "a\nb\"c" 'sym (string->symbol "a b") '#(1 2) #vu8(1 2 3) '(1 . 2) ''q)) (newline)
(let-values (((port get) (open-string-output-port))) (write 'hello port) (display " " port) (display 42 port) (display (get)) (newline))
(display (call-with-string-output-port (lambda (p) (put-string p "abc") (put-char p #\d)))) (newline)
(display (get-line (open-string-input-port "line one\nline two"))) (newline)
(display (read (open-string-input-port "(a . b) rest"))) (newline)
(display (list-sort < '(3 1 2))) (display (vector-sort > '#(3 1 2))) (newline)
(display (fold-left + 0 '(1 2 3))) (display (fold-right cons '() '(1 2 3))) (display (filter odd? '(1 2 3 4 5))) (newline)
(display (assertion-violation? (guard (c (#t c)) (vector-ref (vector 1 2) 5)))) (newline)
(display (guard (c (#t (list (condition-who c) (condition-message c) (condition-irritants c)))) (/ 1. 0))) (newline)

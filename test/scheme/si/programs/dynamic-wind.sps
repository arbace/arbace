;; dynamic-wind with escapes and re-entry, handlers and guard
(import (rnrs))
(define trace '())
(define (note x) (set! trace (cons x trace)))
(define k #f)
(dynamic-wind (lambda () (note 'in1))
              (lambda () (dynamic-wind (lambda () (note 'in2)) (lambda () (call/cc (lambda (c) (set! k c))) (note 'body)) (lambda () (note 'out2))))
              (lambda () (note 'out1)))
(if (< (length trace) 12) (k 'again))
(display (reverse trace)) (newline)
(display (call/cc (lambda (esc) (dynamic-wind (lambda () (display "[")) (lambda () (esc 'escaped)) (lambda () (display "]")))))) (newline)
(display (with-exception-handler (lambda (c) 42) (lambda () (+ 1 (raise-continuable 'oops))))) (newline)
(display (guard (e ((symbol? e) (list 'caught e)) ((string? e) 'string)) (raise 'boom))) (newline)
(display (guard (e ((string? e) 'string)) (guard (e2 ((number? e2) 'number)) (raise "s")))) (newline)
(display (guard (e (#t (list (condition-who e) (condition-message e) (condition-irritants e)))) (error 'me "bad ~s" 1 2))) (newline)
(display (guard (e ((assertion-violation? e) (condition-message e))) (car 5))) (newline)
(display (guard (e ((non-continuable-violation? e) 'non-continuable)) (with-exception-handler (lambda (c) 'returned) (lambda () (raise 'x))))) (newline)
(display (guard (e (#t (list 'reraised e))) (dynamic-wind (lambda () (display "<")) (lambda () (guard (e2 ((number? e2) 'num)) (raise 'sym))) (lambda () (display ">"))))) (newline)
(call-with-values (lambda () (values 1 2 3)) (lambda (a b c) (display (+ a b c)) (newline)))
(let-values (((q r) (div-and-mod 17 5)) ((x) (values 'one))) (display (list q r x)) (newline))
(display (call/cc (lambda (k) (with-exception-handler (lambda (c) (k (list 'handled c))) (lambda () (raise 'deep)))))) (newline)

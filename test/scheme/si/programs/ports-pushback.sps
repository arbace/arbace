;; Chez's port procedures around unget-u8 and unget-char (re-review 033): pushed-back items, set-port-position!, a custom
;; binary port's get-bytevector-some, fresh-line, port-length; run by Chez and by si, the same answers (SCHEME-SURVEY.md,
;; "As built: re-review 033's fixes")
(import (chezscheme))
(define-syntax try (syntax-rules () [(_ e) (guard (c [#t 'err]) e)]))
(define (show . x) (write x) (newline))
;; N1: get-bytevector-some returns pushed-back bytes first
(let* ([p (open-bytevector-input-port #vu8(1 2 3 4 5))] [a (get-u8 p)] [b (try (unget-u8 p 1))] [c (get-bytevector-some p)] [d (get-u8 p)])
  (show 'n1 a c d))
;; N6: get-bytevector-some on a custom binary port calls read!
(let ([p (make-custom-binary-input-port "x" (lambda (bv s n) (bytevector-u8-set! bv s 0) 1) #f #f #f)])
  (show 'n6 (get-bytevector-some p)))
;; N2: set-port-position! discards pushed-back items
(let* ([p (open-bytevector-input-port #vu8(1 2 3 4 5))] [a (get-u8 p)] [b (try (unget-u8 p 1))] [c (set-port-position! p 3)] [d (get-u8 p)])
  (show 'n2 a d))
(let* ([p (open-string-input-port "abcde")] [a (read-char p)] [b (try (unget-char p #\a))] [c (set-port-position! p 2)] [d (read-char p)])
  (show 'n2t a d))
;; N4: fresh-line after an extraction, the length of string ports, nonblocking mode of file ports
(let-values ([(p ex) (open-string-output-port)])
  (put-string p "a") (ex) (fresh-line p) (put-string p "z") (show 'fl (ex)))
(let ([sp (lambda (tag n init)
            (let-values ([(p ex) (open-string-output-port)])
              (put-string p init) (set-port-position! p n) (fresh-line p) (put-string p "Z") (show tag (ex))))])
  (sp 'fl-end 2 "ab")
  (sp 'fl-mid 1 "ab"))
;; re-review 044, M3: a string output port overwrites after set-port-position!, it does not truncate
(let-values ([(p ex) (open-string-output-port)])
  (put-string p "abc") (set-port-position! p 1) (put-string p "X") (let* ([a (port-position p)] [b (ex)]) (show 'ov a b)))
(let-values ([(p ex) (open-string-output-port)])
  (put-string p "ab") (set-port-position! p 0) (show 'ov0 (ex)))
(let ([p (open-output-string)])
  (put-string p "abcd") (set-port-position! p 0) (put-string p "Z") (let* ([a (get-output-string p)] [b (port-position p)]) (show 'ov1 a b)))
;; re-review 047, P2: past the end of a string output port the gap is NUL runes, written with the next output (fresh-line sees a non-newline there)
(let-values ([(p ex) (open-string-output-port)])
  (put-string p "ab") (set-port-position! p 5)
  (let* ([a (port-position p)] [b (port-length p)]) (show 'beyond a b))
  (fresh-line p) (put-string p "Z") (show 'beyond1 (ex)))
(let-values ([(p ex) (open-string-output-port)])
  (put-string p "ab") (set-port-position! p 5) (show 'beyond2 (ex)))
(let-values ([(p ex) (open-string-output-port)])
  (put-string p "ab") (set-port-position! p 5) (set-port-position! p 1) (put-string p "Z") (show 'beyond3 (ex)))
(show 'len (port-has-port-length? (open-string-input-port "ab")) (port-length (open-string-input-port "abc")))
;; re-review 044, M2: nonblocking mode on string, bytevector and binary console ports (#t, #f, settable); the textual console and custom ports have none
(let-values ([(bp bex) (open-bytevector-output-port)] [(sp sex) (open-string-output-port)])
  (for-each (lambda (p) (show 'nb2 (port-has-port-nonblocking?? p) (port-has-set-port-nonblocking!? p) (try (port-nonblocking? p)) (try (begin (set-port-nonblocking! p #f) 'ok))))
            (list (open-string-input-port "a") sp (open-bytevector-input-port #vu8(1)) bp (open-bytevector-input-port #vu8(1) (native-transcoder))
                  (standard-input-port) (standard-output-port) (current-input-port) (current-output-port)
                  (make-custom-binary-input-port "x" (lambda (bv s n) 0) #f #f #f))))
(let ([name "ports-pushback.tmp"])
  ;; the scratch file is deleted even when a line raises (re-review 044, M5; 047, P1: guard, not dynamic-wind, which si does not unwind on an uncaught raise)
  (define (cleanup) (if (file-exists? name) (delete-file name)))
  (guard (c [#t (cleanup) (raise c)])
    (let ([o (open-output-file name 'replace)]) (put-string o "x") (close-port o))
    (let ([p (open-input-file name)])
      (show 'nb (port-has-port-nonblocking?? p) (port-nonblocking? p))
      (close-port p)))
  (cleanup))

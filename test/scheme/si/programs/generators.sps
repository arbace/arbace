;; re-entrant continuations: generators by call/cc
(import (rnrs))
(define (make-generator lst)
  (define return #f)
  (define resume #f)
  (lambda ()
    (call/cc (lambda (r)
      (set! return r)
      (if resume
          (resume #f)
          (begin
            (for-each (lambda (x) (call/cc (lambda (k) (set! resume k) (return x)))) lst)
            (set! resume (lambda (v) (return 'done)))
            (return 'done)))))))
(define (gen-list g n) (if (= n 0) '() (let ((x (g))) (cons x (gen-list g (- n 1))))))
(define g (make-generator '(a b c)))
(display (gen-list g 5)) (newline)
(define (tree-walk tree yield) (cond ((null? tree) 'skip) ((pair? tree) (tree-walk (car tree) yield) (tree-walk (cdr tree) yield)) (else (yield tree))))
(define (tree->generator tree)
  (define caller #f)
  (define (resume-here) (tree-walk tree (lambda (leaf) (call/cc (lambda (k) (set! resume-here (lambda () (k #f))) (caller leaf))))) (caller '*eof*))
  (lambda () (call/cc (lambda (c) (set! caller c) (resume-here)))))
(define (same-fringe? t1 t2)
  (let ((g1 (tree->generator t1)) (g2 (tree->generator t2)))
    (let loop () (let ((a (g1)) (b (g2))) (cond ((not (eqv? a b)) #f) ((eq? a '*eof*) #t) (else (loop)))))))
(display (same-fringe? '(1 (2 3) ((4))) '((1 2) 3 4))) (newline)
(display (same-fringe? '(1 (2 3) 4) '(1 2 (4 3)))) (newline)
;; re-entering map's continuation does not change the earlier result
(define k #f)
(define n 0)
(define r (map (lambda (x) (call/cc (lambda (c) (if (= x 2) (set! k c)) x))) '(1 2 3)))
(display r) (newline)
(set! n (+ n 1))
(if (< n 3) (k (* 10 n)))
(display "end") (newline)

;;;; Chibi-Scheme 0.12.0 as the reference of Chibi's R7RS suite (SC143 (c)): run as `chibi-scheme driver.scm r7rs-tests.scm` (bin/si r7rs --chibi).
;;;; Chibi's reader refuses some of the suite's literals (+nan.0i and the like) and a read error ends a program run from the
;;;; file, so the file is split into its top-level forms, each form read from its text (a form Chibi cannot read prints a line
;;;; UNREADABLE K, K the number of (test forms in its text) and each form is evaluated in the interaction environment, which imports what the file's
;;;; own (import ...) does. The test reporter of (chibi test) is wrapped: each test prints a line as SM8's (chibi test) does
;;;; (TEST N PASS|FAIL SOURCE, then "  expected: E" and "  got: G" or "  error: MESSAGE"), N counting the tests that ran in order;
;;;; the default reporter still keeps the groups' counts (its marks go to a string port), so Chibi's group summaries are printed.
(import (scheme base) (scheme char) (scheme lazy)
        (scheme inexact) (scheme complex) (scheme time)
        (scheme file) (scheme read) (scheme write)
        (scheme eval) (scheme process-context) (scheme case-lambda)
        (scheme r5rs)
        (chibi test))

(define (%d-slurp f)
  (call-with-input-file f
    (lambda (p) (let loop ((acc '()))
                  (let ((c (read-char p))) (if (eof-object? c) (list->string (reverse acc)) (loop (cons c acc))))))))

;; the end of the datum that starts at i (a parenthesized form, else a token)
(define (%d-form-end s i n)
  (define (str j) (cond ((>= j n) n) ((char=? (vector-ref s j) #\\) (str (+ j 2))) ((char=? (vector-ref s j) #\") (+ j 1)) (else (str (+ j 1)))))
  (define (bar j) (cond ((>= j n) n) ((char=? (vector-ref s j) #\\) (bar (+ j 2))) ((char=? (vector-ref s j) #\|) (+ j 1)) (else (bar (+ j 1)))))
  (define (line j) (cond ((>= j n) n) ((char=? (vector-ref s j) #\newline) (+ j 1)) (else (line (+ j 1)))))
  (define (block j d) (cond ((>= j n) n)
                            ((and (char=? (vector-ref s j) #\|) (< (+ j 1) n) (char=? (vector-ref s (+ j 1)) #\#))
                             (if (= d 1) (+ j 2) (block (+ j 2) (- d 1))))
                            ((and (char=? (vector-ref s j) #\#) (< (+ j 1) n) (char=? (vector-ref s (+ j 1)) #\|)) (block (+ j 2) (+ d 1)))
                            (else (block (+ j 1) d))))
  (define (walk j depth)
    (if (>= j n) n
        (let ((c (vector-ref s j)))
          (cond ((char=? c #\") (walk (str (+ j 1)) depth))
                ((char=? c #\|) (walk (bar (+ j 1)) depth))
                ((char=? c #\;) (walk (line j) depth))
                ((and (char=? c #\#) (< (+ j 1) n) (char=? (vector-ref s (+ j 1)) #\|)) (walk (block (+ j 2) 1) depth))
                ((and (char=? c #\#) (< (+ j 1) n) (char=? (vector-ref s (+ j 1)) #\\)) (walk (+ j 3) depth))
                ((char=? c #\() (walk (+ j 1) (+ depth 1)))
                ((char=? c #\)) (if (= depth 1) (+ j 1) (walk (+ j 1) (- depth 1))))
                (else (walk (+ j 1) depth))))))
  (if (char=? (vector-ref s i) #\() (walk i 0)
      (let tok ((j i)) (if (or (>= j n) (char-whitespace? (vector-ref s j))) j (tok (+ j 1))))))

;; the top-level %d-forms' texts, in order
(define (%d-split-forms s)
  (define n (vector-length s))
  (let loop ((i 0) (acc '()))
    (cond ((>= i n) (reverse acc))
          ((char-whitespace? (vector-ref s i)) (loop (+ i 1) acc))
          ((char=? (vector-ref s i) #\;) (let l ((j i)) (if (or (>= j n) (char=? (vector-ref s j) #\newline)) (loop j acc) (l (+ j 1)))))
          ((and (char=? (vector-ref s i) #\#) (< (+ i 1) n) (char=? (vector-ref s (+ i 1)) #\|))
           (let b ((j (+ i 2)) (d 1))
             (cond ((>= j n) (loop n acc))
                   ((and (char=? (vector-ref s j) #\|) (< (+ j 1) n) (char=? (vector-ref s (+ j 1)) #\#)) (if (= d 1) (loop (+ j 2) acc) (b (+ j 2) (- d 1))))
                   ((and (char=? (vector-ref s j) #\#) (< (+ j 1) n) (char=? (vector-ref s (+ j 1)) #\|)) (b (+ j 2) (+ d 1)))
                   (else (b (+ j 1) d)))))
          (else (let ((e (%d-form-end s i n))) (loop e (cons (list->string (vector->list s i e)) acc)))))))

(define (%d-count-tests t)
  (let ((n (string-length t)))
    (let loop ((i 0) (k 0))
      (cond ((> (+ i 6) n) k)
            ((string=? (substring t i (+ i 6)) "(test ") (loop (+ i 6) (+ k 1)))
            (else (loop (+ i 1) k))))))

(define (%d-wr x o)
  (cond ((pair? x)
         (write-char #\( o)
         (let l ((x x) (first #t))
           (cond ((null? x))
                 ((pair? x) (if (not first) (write-char #\space o)) (%d-wr (car x) o) (l (cdr x) #f))
                 (else (write-string " . " o) (%d-wr x o))))
         (write-char #\) o))
        ((vector? x) (write-char #\# o) (%d-wr (vector->list x) o))
        (else (write x o))))
(define (%d-str x) (let ((o (open-output-string))) (%d-wr x o) (get-output-string o)))
(define %d-n 0)
(define %d-default (current-test-reporter))
(define (%d-field k info) (let ((p (assq k info))) (if p (cdr p) #f)))
(current-test-reporter
 (lambda (status info)
   (when (memq status '(PASS FAIL ERROR))
     (set! %d-n (+ %d-n 1))
     (newline) (display "TEST ") (display %d-n) (display (if (eq? status 'PASS) " PASS " " FAIL "))
     (display (%d-str (%d-field 'source info))) (newline)
     (cond ((eq? status 'FAIL)
            (display "  expected: ") (write (%d-field 'expected info)) (newline)
            (display "  got: ") (write (%d-field 'result info)) (newline))
           ((eq? status 'ERROR)
            (let ((e (%d-field 'exception info)))
              (display "  error: ")
              (write (if (error-object? e) (cons (error-object-message e) (error-object-irritants e)) e))
              (newline)))))
   (parameterize ((current-output-port (open-output-string))) (%d-default status info))))

(define %d-forms (%d-split-forms (string->vector (%d-slurp (cadr (command-line))))))
(for-each
 (lambda (t)
   (let ((d (guard (e (#t #f)) (list (read (open-input-string t))))))
     (cond ((not d)
            (do ((k (%d-count-tests t) (- k 1))) ((= k 0))
              (set! %d-n (+ %d-n 1))
              (newline) (display "TEST ") (display %d-n) (display " FAIL ") (write t) (newline)
              (display "  error: Chibi's reader cannot read the form") (newline)))
           (else (guard (e (#t (display "FORMERROR ") (write (if (error-object? e) (error-object-message e) 'raised)) (newline)))
                   (eval (car d) (interaction-environment)))))))
 %d-forms)

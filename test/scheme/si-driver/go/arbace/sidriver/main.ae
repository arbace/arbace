(in-ns 'go.arbace.sidriver)

(go/file "main.go"
  :doc "Command sidriver runs Scheme programs on si: psyntax booted from its expanded system, then each
program expanded by psyntax on si and run.\n\n    sidriver --pp PSYNTAX.ss [--lib DIR]... [--r7rs] [--core|--case|--aot-dump OUT] FILE [ARG...]\n    sidriver --pp PSYNTAX.ss --aot-boot OUT\n\n--r7rs reads with R7RS's lexical syntax (#u8(, |...|, the other identifiers) from the program on (SM8). --aot-boot writes psyntax's boot as the AOT's input (arbace.scheme.aot), --aot-dump FILE's
expansion (its libraries' invoke code and its core form) instead of running it. --core
runs FILE's core forms directly (no psyntax); --case installs FILE's leading library forms first (as the
expander's test cases hold them), marks the end of the expansion on stderr (SI-RUN) and reports an
uncaught raise as data (SI-RAISE). The status is the program's (exit), 255 for an uncaught raise
(reported on stderr as Chez reports it), 0 otherwise. SI_CPUPROFILE names a CPU profile to write; GOGC
defaults to 400\n"
  :imports [[fmt "fmt"] [os "os"] [debug "runtime/debug"] [pprof "runtime/pprof"] [scm "arbace/scm"]])

(go/func readFile ^string [^string name]
  (let [(values b err) (os/ReadFile name)]
    (when (!= err nil)
      (fmt/Fprintln os/Stderr "sidriver:" err)
      (os/Exit 2))
    (conv string b)))

(go/func writeFile [^string name ^string text]
  (let [err (os/WriteFile name (conv (slice byte) text) 0644)]
    (when (!= err nil)
      (fmt/Fprintln os/Stderr "sidriver:" err)
      (os/Exit 2))))

(go/func main []
  (let [pp ""
        ^{:tag (slice string)} libs nil
        core false
        r7rs false
        cases false
        aotBoot ""
        aotDump ""
        args (subslice os/Args 1)]
    (while (and (> (len args) 0) (> (len (aget args 0)) 1) (== (aget (aget args 0) 0) \-))
      (switch (aget args 0)
        (case ["--pp"] (set! pp (aget args 1)) (set! args (subslice args 2)))
        (case ["--lib"] (set! libs (append libs (aget args 1))) (set! args (subslice args 2)))
        (case ["--core"] (set! core true) (set! args (subslice args 1)))
        (case ["--r7rs"] (set! r7rs true) (set! args (subslice args 1)))
        (case ["--aot-boot"] (set! aotBoot (aget args 1)) (set! args (subslice args 2)))
        (case ["--aot-dump"] (set! aotDump (aget args 1)) (set! args (subslice args 2)))
        (case ["--case"]
          (set! scm/ReportData true)
          (set! cases true)
          (set! scm/OnRun (fn [] (scm/FlushAll) (fmt/Fprintln os/Stderr "SI-RUN")))
          (set! args (subslice args 1)))
        (default (fmt/Fprintln os/Stderr "sidriver: unknown option" (aget args 0)) (os/Exit 2))))
    (when (and (== (len args) 0) (== aotBoot ""))
      (fmt/Fprintln os/Stderr "usage: sidriver --pp PSYNTAX.ss [--lib DIR]... [--core] FILE [ARG...]")
      (os/Exit 2))
    (when (> (len args) 0)
      (set! scm/CommandLine args))
    ;; si allocates a frame and an environment a call over a small live heap: Go's default GOGC of 100
    ;; spends half the time collecting (fib: 2.0 s against 1.45 s at 400)
    (when (== (os/Getenv "GOGC") "")
      (debug/SetGCPercent 400))
    (when (!= (os/Getenv "SI_CPUPROFILE") "")
      (let [(values f err) (os/Create (os/Getenv "SI_CPUPROFILE"))]
        (when (== err nil)
          (pprof/StartCPUProfile f)
          (set! scm/AtExit (fn [] (pprof/StopCPUProfile))))))
    (let [m (scm/NewM)
          status (scm/Report (fn []
                   (when (!= aotBoot "")
                     (writeFile aotBoot (.DumpBoot m (scm/ReadAllString (readFile pp))))
                     (return))
                   (when (not core)
                     (.Boot m (scm/ReadAllString (readFile pp)))
                     (.SetLibraryPath m libs))
                   (set! scm/R7RS r7rs)
                   (let [forms (scm/ReadAllString (readFile (aget args 0)))]
                     (when r7rs
                       (range [i f forms]
                         (aset forms i (scm/SelfEvalForms f))))
                     (cond
                       core (range [_ f forms]
                              (.Eval m f))
                       (!= aotDump "") (writeFile aotDump (.DumpProgram m forms))
                       cases (.RunFile m forms)
                       :else (.RunProgram m forms)))))]
      (when (!= scm/AtExit nil)
        (scm/AtExit))
      (os/Exit status))))

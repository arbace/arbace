;; si's light driver (doc/scheme/SCHEME-SURVEY.md, "As built: SM5 (write-ahead)"): a Go program over the
;; package arbace/scm alone, built by bin/si with TamaGo's go from the printed forms, so that si runs
;; before arbace/scm is listed in goi's table and compiled into Arbace's executable (the heavy list).
(ns go.arbace.sidriver
  (:require [arbace.go :as go]))

(go/package main
  :path "arbace/sidriver"
  :files ["main.go"])

(load "sidriver/main")

;; si's divergences on the SM8 corpora (doc/scheme/SCHEME-SURVEY.md, "As built: SM8"): Chibi's R7RS suite
;; (bin/si r7rs), ecraven's r7rs-benchmarks (bin/si ecraven) and Chez's mats (bin/si mats). An item is "KIND CORPUS/ID
;; DETAIL" (arbace.scheme.corpora): fails (a test or mat that runs and gives another answer), notrun (a mat that does
;; not expand or run on si), crash (a program that dies or times out), skip (a form the harness does not run). An
;; item's class is the first whose :match finds it. Goi's format (test/goi/divergences.edn). Read with the Clojure
;; reader.
[
 ;; ---- Chibi's R7RS suite
 {:id :r7rs-underscore-literal
  :title "_ as a syntax-rules literal"
  :kind :deferred
  :why "R7RS lets (syntax-rules (_) ...) match _ literally; psyntax's expander refuses _ among the literals, so (scheme base)'s syntax-rules drops it and _ stays a wildcard (SC100)"
  :decided "SM8 SC100"
  :match [#"^fails r7rs/chibi .*count-to-2_"]}
 {:id :r7rs-complex-branch-cut
  :title "sqrt of a complex number with a negative zero imaginary part"
  :kind :deferred
  :why "si's sqrt of -1.0-0.0i is 0.0-1.0i; R7RS (and Chez) give 0.0+1.0i on that branch cut"
  :decided "SM8 SC101"
  :match [#"^fails r7rs/chibi .*\(sqrt -1\.0-0\.0i\)"]}
 {:id :r7rs-read-labels
  :title "datum labels in read"
  :kind :deferred
  :why "si's reader does not read #0=(1 . #0#) (R7RS read; Chez's reader does): write prints labels (scheme/lib/scheme/write.sls), read does not take them (SC102)"
  :decided "SM8 SC102"
  :match [#"^fails r7rs/chibi .*#0="]}
 {:id :r7rs-write-bars-nan
  :title "write of the symbol |+NaN.0abc|"
  :kind :design
  :why "Chibi writes a symbol that begins like +nan.0 between bars even when the whole name is a valid identifier; (scheme write) bars only the symbols R7RS's grammar needs bars for"
  :decided "SM8 SC103"
  :match [#"^fails r7rs/chibi .*get-output-string out.*\+NaN\.0abc"]}
 {:id :r7rs-float-printing
  :title "shortest printing of denormal and extreme flonums"
  :kind :deferred
  :why "number->string of 4.940656458412465e-324 and its neighbours gives a different digit string from Chibi's accepted list (SC22: si prints the shortest string that reads back, Chez's rule, and the accepted lists include 5.0e-324 forms only where the digits round)"
  :decided "SM8 SC22"
  :match [#"^fails r7rs/chibi \(pair\? ls\)"]}
 ;; ---- ecraven's benchmarks
 {:id :ecraven-input-not-fetched
  :title "a benchmark that reads an input file that is not fetched"
  :kind :design
  :why "inputs/bib (4.4 MB) and inputs/sum1.data (1.1 MB) are not fetched (the disk, SM8); cat, tail, wc and sum1 read them. They run once the inputs are fetched (SC108)"
  :decided "SM8 SC108"
  :match [#"^crash ecraven/\S+ status 255: Exception in call-with-input-file: failed for inputs/(bib|sum1\.data)"]}
 {:id :ecraven-too-slow
  :title "a benchmark over the light tier's time limit"
  :kind :deferred
  :why "si runs the benchmark's real input with repetition count 1 and did not finish in the limit (60 s, 300 s for the slow ones): the interpreter is 50 to 100 times Chez (fib 40 is 84 s); the AOT (SM7) halves that, so these are rerun compiled on the shipped path in the window after the tag (the heavy list)"
  :decided "SM8 SC109"
  :match [#"^crash ecraven/\S+ timeout"]}
 {:id :ecraven-reader-corners
  :title "read0's reader corner cases"
  :kind :deferred
  :why "read0 (from Larceny's reader tests) reads strings and symbols with line-ending characters (CR, NEL, LS inside a string, \")(\" as text) and compares the datum; two of its cases print 'test failed' on si, whose reader follows R6RS's line-ending rules in strings (the cases are recorded in .tmp output, SC102 and the reader proposals)"
  :decided "SM8 SC102"
  :match [#"^fails ecraven/read0 "]}
 ;; ---- Chez's mats
 {:id :mats-chez-identifier
  :title "a mat that uses an identifier of Chez's own"
  :kind :design
  :why "the mat names a procedure or syntax that is not in R6RS (fx+/wraparound, $record, with-interrupts-disabled, foreign-procedure, ...); the mat's whole body is expanded in an R6RS environment of (rnrs) and the harness shim (si mats), so the mat is not in the portable subset. SC10's (chezscheme) subset would bring some in"
  :decided "SM8 SC10"
  :match [#"^notrun mats/\S+ mat \S+: unbound identifier" #"^notrun mats/\S+ definition .* unbound identifier"
          #"^fails mats/\S+ mat \S+: \d+ \d+: (error: )?unbound identifier"]}
 {:id :mats-chez-reader
  :title "a form in Chez's own lexical syntax"
  :kind :design
  :why "#!eof, #vfx(, #vfl(, binary floating-point literals (#b1.1) and the like: si's reader (R6RS lexical syntax, with R7RS's in the mats' run) does not read them, so the form is left out of the run"
  :decided "SM8 SC20"
  :match [#"^notrun mats/\S+ read:"]}
 {:id :mats-toplevel
  :title "a definition inside an expression"
  :kind :design
  :why "a mat clause or a definition is a begin with a define in expression position, which R6RS's expander refuses (Chez's top level takes it)"
  :decided "SM8"
  :match [#"a definition was found where an expression was expected"]}
 {:id :mats-eq-identity
  :title "eq? on numbers and empty objects"
  :kind :design
  :why "Chez's mats test eq? of flonums (never eq?) and of empty vectors and strings (one shared object); si's eq? compares flonums by value and allocates each empty object"
  :decided "SM8 SC110"
  :match [#"^fails mats/\S+ mat (memq|string|vector|make-vector|make-string): \d+ \d+: returned #f"]}
 {:id :mats-arity-one
  :title "comparisons of one argument"
  :kind :design
  :why "Chez accepts (char=? c) and (string=? s) with one argument (true); R6RS asks for two or more and si follows it"
  :decided "SM8 SC110"
  :match [#"^fails mats/\S+ mat (char|string|=|<|<=|>|>=)\S*: \d+ \d+: error: incorrect number of arguments"]}
 {:id :mats-chez-checks
  :title "checks of Chez's own error and optimizer behaviour"
  :kind :design
  :why "mats that expect an error from list-head, number->string, cond or the compiler's simplification (cp0 passes) which Chez raises or does and si, an R6RS system without Chez's compiler, does not; the shim (si mats)'s list-head does not check its arguments"
  :decided "SM8 SC110"
  :match [#"^fails mats/\S+ mat (cond|list-head|number->string|simplify-if|cpvalid2|exact|definition-not-permitted|invalid-bindings|module11|\$primitive): " #"^notrun mats/4\.ms mat case: invalid syntax"]}
 {:id :mats-format
  :title "Chez's format directives"
  :kind :deferred
  :why "format.ms tests Chez's format (~a ~s ~d with column and padding parameters, ~r ~c ~e ~f ~g ~$ ~? ~* ~^ ~[ ~; ~{ ~t); si's format (the primitive psyntax uses) does the plain directives only, and the mat expects errors it does not raise for malformed directives (SC110)"
  :decided "SM8 SC110"
  :match [#"^fails mats/format\.ms mat format-"]}
 {:id :mats-hang
  :title "a mat that does not finish"
  :kind :deferred
  :why "the mat loops on si (a cyclic list given to a procedure that Chez checks, a wait with no other thread) and is skipped on the next run of its file; a file that still timed out after six skips ends there"
  :decided "SM8 SC111"
  :match [#"^skip mats/\S+ mat .*skip list" #"^crash mats/\S+ status 124"]}
 {:id :mats-parameters
  :title "mats with parameters or in files compiled"
  :kind :design
  :why "(mat NAME (parameters ...) ...) and mat/cf compile and load files, which si has no file compiler for"
  :decided "SM8"
  :match [#"^skip mats/\S+ mat .*(parameters|mat/cf)"]}
]

(python/module [(function-def show (arguments :args [label thunk]) [(try [(expr (call print [label (str "->" :quote "'") (call repr [(call thunk [])])]))] [(except-handler [(expr (call print [label (str "->" :quote "'") (attribute (call type [e]) __name__)]))] :type Exception :name e)])]) (assign [^:store operands] (list [7 (unary-op - 3) 0 (float "2.5") (unary-op - (float "0.5")) True (bin-op + 1 (imag "2j")) (str "ab" :quote "'") (bytes "xy" :quote "'") (list [1 2]) (tuple [3]) (set [1 2]) (dict [(str "k" :quote "'")] [1]) None (bin-op ** 10 20)])) (for (tuple [^:store i ^:store a] {:ctx :store}) (call enumerate [operands]) [(for (tuple [^:store j ^:store b] {:ctx :store}) (call enumerate [operands]) [(expr (call show [(tuple [i j]) (lambda (arguments) (compare a [==] [b]))]))])])] {:file "ops/cmp-eq.py" :mode :lines})

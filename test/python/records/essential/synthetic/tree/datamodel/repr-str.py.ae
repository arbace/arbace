(python/module [(function-def show (arguments :args [label thunk]) [(try [(expr (call print [label (str "->" :quote "'") (call repr [(call thunk [])])]))] [(except-handler [(expr (call print [label (str "->" :quote "'") (attribute (call type [e]) __name__)]))] :type Exception :name e)])]) (class-def C [(function-def __repr__ (arguments :args [self]) [(return (str "C()" :quote "'"))]) (function-def __str__ (arguments :args [self]) [(return (str "c" :quote "'"))])]) (expr (call show [0 (lambda (arguments) (call repr [(call C [])]))])) (expr (call show [1 (lambda (arguments) (call str [(call C [])]))])) (expr (call show [2 (lambda (arguments) (joined-str [(formatted-value (call C [])) " " (formatted-value (call C []) :conversion r)] :quote "'"))]))] {:file "datamodel/repr-str.py" :mode :lines})

(python/module [(function-def show (arguments :args [label thunk]) [(try [(expr (call print [label (str "->" :quote "'") (call repr [(call thunk [])])]))] [(except-handler [(expr (call print [label (str "->" :quote "'") (attribute (call type [e]) __name__)]))] :type Exception :name e)])]) (class-def C [(function-def __reversed__ (arguments :args [self]) [(return (call iter [(list [3 2 1])]))])]) (expr (call show [0 (lambda (arguments) (call list [(call reversed [(call C [])])]))]))] {:file "datamodel/reversed.py" :mode :lines})

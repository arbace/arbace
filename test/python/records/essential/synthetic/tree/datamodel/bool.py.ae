(python/module [(function-def show (arguments :args [label thunk]) [(try [(expr (call print [label (str "->" :quote "'") (call repr [(call thunk [])])]))] [(except-handler [(expr (call print [label (str "->" :quote "'") (attribute (call type [e]) __name__)]))] :type Exception :name e)])]) (class-def C [(function-def __bool__ (arguments :args [self]) [(return False)])]) (expr (call show [0 (lambda (arguments) (call bool [(call C [])]))])) (expr (call show [1 (lambda (arguments) (if-exp (call C []) (str "yes" :quote "'") (str "no" :quote "'")))]))] {:file "datamodel/bool.py" :mode :lines})

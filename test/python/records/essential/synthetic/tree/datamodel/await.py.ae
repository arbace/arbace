(python/module [(function-def show (arguments :args [label thunk]) [(try [(expr (call print [label (str "->" :quote "'") (call repr [(call thunk [])])]))] [(except-handler [(expr (call print [label (str "->" :quote "'") (attribute (call type [e]) __name__)]))] :type Exception :name e)])]) (class-def C [(function-def __await__ (arguments :args [self]) [(expr (yield)) (return (str "awaited" :quote "'"))])]) (async-function-def main (arguments) [(return (await (call C [])))]) (function-def drive (arguments :args [co]) [(try [(while True [(expr (call (attribute co send) [None]))])] [(except-handler [(return (attribute e value))] :type StopIteration :name e)])]) (expr (call show [0 (lambda (arguments) (call drive [(call main [])]))]))] {:file "datamodel/await.py" :mode :lines})

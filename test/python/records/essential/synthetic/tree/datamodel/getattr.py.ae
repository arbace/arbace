(python/module [(function-def show (arguments :args [label thunk]) [(try [(expr (call print [label (str "->" :quote "'") (call repr [(call thunk [])])]))] [(except-handler [(expr (call print [label (str "->" :quote "'") (attribute (call type [e]) __name__)]))] :type Exception :name e)])]) (class-def C [(function-def __getattr__ (arguments :args [self n]) [(return (call (attribute n upper) []))])]) (expr (call show [0 (lambda (arguments) (attribute (call C []) abc))])) (expr (call show [1 (lambda (arguments) (call getattr [(call C []) (str "xy" :quote "'")]))])) (expr (call show [2 (lambda (arguments) (call hasattr [(call C []) (str "q" :quote "'")]))]))] {:file "datamodel/getattr.py" :mode :lines})

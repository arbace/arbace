(python/module [(function-def show (arguments :args [label thunk]) [(try [(expr (call print [label (str "->" :quote "'") (call repr [(call thunk [])])]))] [(except-handler [(expr (call print [label (str "->" :quote "'") (attribute (call type [e]) __name__)]))] :type Exception :name e)])]) (class-def C [(function-def __call__ (arguments :args [self] :vararg a :kwarg k) [(return (tuple [a (call sorted [(call (attribute k items) [])])]))])]) (expr (call show [0 (lambda (arguments) (call (call C []) [1] :keywords [(keyword x 2)]))])) (expr (call show [1 (lambda (arguments) (call callable [(call C [])]))]))] {:file "datamodel/call.py" :mode :lines})

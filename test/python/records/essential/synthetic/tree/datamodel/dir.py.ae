(python/module [(function-def show (arguments :args [label thunk]) [(try [(expr (call print [label (str "->" :quote "'") (call repr [(call thunk [])])]))] [(except-handler [(expr (call print [label (str "->" :quote "'") (attribute (call type [e]) __name__)]))] :type Exception :name e)])]) (class-def C [(function-def __dir__ (arguments :args [self]) [(return (list [(str "b" :quote "'") (str "a" :quote "'")]))])]) (expr (call show [0 (lambda (arguments) (call dir [(call C [])]))]))] {:file "datamodel/dir.py" :mode :lines})

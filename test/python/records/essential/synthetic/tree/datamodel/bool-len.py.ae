(python/module [(function-def show (arguments :args [label thunk]) [(try [(expr (call print [label (str "->" :quote "'") (call repr [(call thunk [])])]))] [(except-handler [(expr (call print [label (str "->" :quote "'") (attribute (call type [e]) __name__)]))] :type Exception :name e)])]) (class-def C [(function-def __len__ (arguments :args [self]) [(return 0)])]) (expr (call show [0 (lambda (arguments) (call bool [(call C [])]))])) (expr (call show [1 (lambda (arguments) (call len [(call C [])]))])) (expr (call show [2 (lambda (arguments) (unary-op not (call C [])))]))] {:file "datamodel/bool-len.py" :mode :lines})

(python/module [(function-def show (arguments :args [label thunk]) [(try [(expr (call print [label (str "->" :quote "'") (call repr [(call thunk [])])]))] [(except-handler [(expr (call print [label (str "->" :quote "'") (attribute (call type [e]) __name__)]))] :type Exception :name e)])]) (class-def C [(function-def __fspath__ (arguments :args [self]) [(return (str "some/path" :quote "'"))])]) (expr (call show [0 (lambda (arguments) (call (attribute (call __import__ [(str "os" :quote "'")]) fspath) [(call C [])]))])) (expr (call show [1 (lambda (arguments) (call (attribute (attribute (call __import__ [(str "os" :quote "'")]) path) basename) [(call C [])]))]))] {:file "datamodel/fspath.py" :mode :lines})

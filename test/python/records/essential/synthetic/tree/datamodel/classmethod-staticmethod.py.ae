(python/module [(function-def show (arguments :args [label thunk]) [(try [(expr (call print [label (str "->" :quote "'") (call repr [(call thunk [])])]))] [(except-handler [(expr (call print [label (str "->" :quote "'") (attribute (call type [e]) __name__)]))] :type Exception :name e)])]) (class-def C [(function-def k (arguments :args [cls]) [(return (attribute cls __name__))] :decorators [classmethod]) (function-def s (arguments :args [x]) [(return (bin-op + x 1))] :decorators [staticmethod])]) (expr (call show [0 (lambda (arguments) (call (attribute C k) []))])) (expr (call show [1 (lambda (arguments) (call (attribute (call C []) k) []))])) (expr (call show [2 (lambda (arguments) (call (attribute C s) [1]))])) (expr (call show [3 (lambda (arguments) (call (attribute (call C []) s) [2]))]))] {:file "datamodel/classmethod-staticmethod.py" :mode :lines})

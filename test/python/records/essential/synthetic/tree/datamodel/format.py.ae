(python/module [(function-def show (arguments :args [label thunk]) [(try [(expr (call print [label (str "->" :quote "'") (call repr [(call thunk [])])]))] [(except-handler [(expr (call print [label (str "->" :quote "'") (attribute (call type [e]) __name__)]))] :type Exception :name e)])]) (class-def C [(function-def __format__ (arguments :args [self spec]) [(return (bin-op + (bin-op + (str "<" :quote "'") spec) (str ">" :quote "'")))])]) (expr (call show [0 (lambda (arguments) (call format [(call C []) (str "x>5" :quote "'")]))])) (expr (call show [1 (lambda (arguments) (joined-str [(formatted-value (call C []) :format-spec ["abc"])] :quote "'"))]))] {:file "datamodel/format.py" :mode :lines})

(python/module [(function-def show (arguments :args [label thunk]) [(try [(expr (call print [label (str "->" :quote "'") (call repr [(call thunk [])])]))] [(except-handler [(expr (call print [label (str "->" :quote "'") (attribute (call type [e]) __name__)]))] :type Exception :name e)])]) (class-def OrdMeta [(function-def __prepare__ (arguments :args [mcls name bases]) [(expr (call print [(str "prepare" :quote "'") name])) (return (dict [(str "order" :quote "'")] [(list [])]))] :decorators [classmethod]) (function-def __new__ (arguments :args [mcls name bases ns]) [(expr (call (attribute (subscript ns (str "order" :quote "'")) append) [name])) (return (call (attribute (call super []) __new__) [mcls name bases ns]))])] :bases [type]) (class-def Ordered [(pass)] :keywords [(keyword metaclass OrdMeta)]) (expr (call show [0 (lambda (arguments) (attribute Ordered order))]))] {:file "datamodel/prepare.py" :mode :lines})

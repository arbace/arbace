(python/module [(function-def show (arguments :args [label thunk]) [(try [(expr (call print [label (str "->" :quote "'") (call repr [(call thunk [])])]))] [(except-handler [(expr (call print [label (str "->" :quote "'") (attribute (call type [e]) __name__)]))] :type Exception :name e)])]) (class-def C [(function-def __class_getitem__ (arguments :args [cls item]) [(return (tuple [(str "cgi" :quote "'") item]))])]) (expr (call show [0 (lambda (arguments) (subscript C int))])) (expr (call show [1 (lambda (arguments) (subscript C (tuple [1 2])))]))] {:file "datamodel/class-getitem.py" :mode :lines})

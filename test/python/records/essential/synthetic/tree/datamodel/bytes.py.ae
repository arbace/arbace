(python/module [(function-def show (arguments :args [label thunk]) [(try [(expr (call print [label (str "->" :quote "'") (call repr [(call thunk [])])]))] [(except-handler [(expr (call print [label (str "->" :quote "'") (attribute (call type [e]) __name__)]))] :type Exception :name e)])]) (class-def C [(function-def __bytes__ (arguments :args [self]) [(return (bytes "c" :quote "'"))])]) (expr (call show [0 (lambda (arguments) (call bytes [(call C [])]))]))] {:file "datamodel/bytes.py" :mode :lines})

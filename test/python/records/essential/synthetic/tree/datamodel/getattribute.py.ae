(python/module [(function-def show (arguments :args [label thunk]) [(try [(expr (call print [label (str "->" :quote "'") (call repr [(call thunk [])])]))] [(except-handler [(expr (call print [label (str "->" :quote "'") (attribute (call type [e]) __name__)]))] :type Exception :name e)])]) (class-def C [(function-def __getattribute__ (arguments :args [self n]) [(if (compare n [==] [(str "x" :quote "'")]) [(return 1)]) (return (call (attribute object __getattribute__) [self n]))])]) (expr (call show [0 (lambda (arguments) (attribute (call C []) x))])) (expr (call show [1 (lambda (arguments) (attribute (call C []) y))]))] {:file "datamodel/getattribute.py" :mode :lines})

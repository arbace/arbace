(python/module [(function-def show (arguments :args [label thunk]) [(try [(expr (call print [label (str "->" :quote "'") (call repr [(call thunk [])])]))] [(except-handler [(expr (call print [label (str "->" :quote "'") (attribute (call type [e]) __name__)]))] :type Exception :name e)])]) (class-def C [(function-def __eq__ (arguments :args [self o]) [(return True)])]) (expr (call show [0 (lambda (arguments) (compare (call C []) [==] [1]))])) (expr (call show [1 (lambda (arguments) (attribute C __hash__))]))] {:file "datamodel/eq-unhashable.py" :mode :lines})

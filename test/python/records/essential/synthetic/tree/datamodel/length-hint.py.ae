(python/module [(function-def show (arguments :args [label thunk]) [(try [(expr (call print [label (str "->" :quote "'") (call repr [(call thunk [])])]))] [(except-handler [(expr (call print [label (str "->" :quote "'") (attribute (call type [e]) __name__)]))] :type Exception :name e)])]) (class-def C [(function-def __length_hint__ (arguments :args [self]) [(return 7)])]) (expr (call show [0 (lambda (arguments) (call (attribute (call __import__ [(str "operator" :quote "'")]) length_hint) [(call C [])]))]))] {:file "datamodel/length-hint.py" :mode :lines})

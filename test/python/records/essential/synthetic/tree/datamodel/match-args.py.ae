(python/module [(function-def show (arguments :args [label thunk]) [(try [(expr (call print [label (str "->" :quote "'") (call repr [(call thunk [])])]))] [(except-handler [(expr (call print [label (str "->" :quote "'") (attribute (call type [e]) __name__)]))] :type Exception :name e)])]) (class-def C [(assign [^:store __match_args__] (tuple [(str "a" :quote "'") (str "b" :quote "'")])) (function-def __init__ (arguments :args [self a b]) [(assign [(tuple [(attribute self a {:ctx :store}) (attribute self b {:ctx :store})] {:ctx :store})] (tuple [a b]))])]) (function-def m (arguments :args [x]) [(match x [(match-case (match-class C [(match-value 0) (match-as nil b)]) [(return (tuple [(str "zero" :quote "'") b]))]) (match-case (match-class C [(match-as nil a) (match-as nil b)]) [(return (tuple [a b]))])])]) (expr (call show [0 (lambda (arguments) (call m [(call C [1 2])]))])) (expr (call show [1 (lambda (arguments) (call m [(call C [0 5])]))]))] {:file "datamodel/match-args.py" :mode :lines})

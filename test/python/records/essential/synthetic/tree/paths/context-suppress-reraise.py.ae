(python/module [(import-from contextlib [suppress ExitStack]) (with [(withitem (call suppress [KeyError]))] [(raise KeyError)]) (expr (call print [(str "suppressed" :quote "'")])) (class-def CM [(function-def __enter__ (arguments :args [self]) [(return self)]) (function-def __exit__ (arguments :args [self] :vararg a) [(expr (call print [(str "exit" :quote "'") (attribute (subscript a 0) __name__)])) (return False)])]) (try [(with [(withitem (call CM []))] [(raise ValueError)])] [(except-handler [(expr (call print [(str "reraised" :quote "'")]))] :type ValueError)]) (with [(withitem (call ExitStack []) ^:store st)] [(expr (call (attribute st callback) [print (str "callback 1" :quote "'")])) (expr (call (attribute st callback) [print (str "callback 2" :quote "'")]))])] {:file "paths/context-suppress-reraise.py" :mode :lines})

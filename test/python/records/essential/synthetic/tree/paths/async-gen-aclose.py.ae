(python/module [(import [asyncio]) (async-function-def ag (arguments) [(try [(expr (yield 1)) (expr (yield 2))] [] :finally [(expr (call print [(str "ag finally" :quote "'")]))])]) (async-function-def main (arguments) [(assign [^:store g] (call ag [])) (expr (call print [(await (call (attribute g __anext__) []))])) (expr (await (call (attribute g aclose) []))) (expr (call print [(str "aclosed" :quote "'")]))]) (expr (call (attribute asyncio run) [(call main [])]))] {:file "paths/async-gen-aclose.py" :mode :lines})

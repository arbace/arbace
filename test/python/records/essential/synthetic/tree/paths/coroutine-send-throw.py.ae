(python/module [(import [types]) (function-def ticker (arguments) [(assign [^:store v] (yield (str "tick" :quote "'"))) (return v)] :decorators [(attribute types coroutine)]) (async-function-def co (arguments) [(try [(return (await (call ticker [])))] [(except-handler [(return (str "caught" :quote "'"))] :type KeyError)])]) (assign [^:store c] (call co [])) (expr (call print [(call (attribute c send) [None])])) (try [(expr (call (attribute c send) [(str "v" :quote "'")]))] [(except-handler [(expr (call print [(attribute e value)]))] :type StopIteration :name e)]) (assign [^:store c] (call co [])) (expr (call (attribute c send) [None])) (try [(expr (call (attribute c throw) [(call KeyError [])]))] [(except-handler [(expr (call print [(attribute e value)]))] :type StopIteration :name e)])] {:file "paths/coroutine-send-throw.py" :mode :lines})

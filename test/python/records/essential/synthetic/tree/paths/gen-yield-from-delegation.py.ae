(python/module [(function-def inner (arguments) [(assign [^:store got] (yield (str "i1" :quote "'"))) (expr (call print [(str "inner got" :quote "'") got])) (return (str "inner-done" :quote "'"))]) (function-def outer (arguments) [(assign [^:store r] (yield-from (call inner []))) (expr (call print [(str "outer got" :quote "'") r])) (expr (yield (str "o1" :quote "'")))]) (assign [^:store it] (call outer [])) (expr (call print [(call next [it])])) (expr (call print [(call (attribute it send) [(str "s" :quote "'")])]))] {:file "paths/gen-yield-from-delegation.py" :mode :lines})

(python/module [(import [sys]) (function-def deep (arguments :args [n]) [(return (call deep [(bin-op + n 1)]))]) (try [(expr (call deep [0]))] [(except-handler [(expr (call print [(str "RecursionError" :quote "'")]))] :type RecursionError :name e)])] {:file "paths/recursion-limit.py" :mode :lines})

(python/module [(function-def g (arguments) [(try [(expr (yield 1))] [(except-handler [(expr (call print [(str "exit" :quote "'")])) (raise)] :type GeneratorExit)]) (return (str "r" :quote "'"))]) (assign [^:store it] (call g [])) (expr (call next [it])) (expr (call (attribute it close) [])) (function-def h (arguments) [(expr (yield 1)) (return (str "value" :quote "'"))]) (assign [^:store it] (call h [])) (expr (call next [it])) (try [(expr (call next [it]))] [(except-handler [(expr (call print [(str "stop" :quote "'") (attribute e value)]))] :type StopIteration :name e)])] {:file "paths/gen-return-close.py" :mode :lines})

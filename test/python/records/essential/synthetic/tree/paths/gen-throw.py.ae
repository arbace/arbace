(python/module [(function-def g (arguments) [(while True [(try [(expr (yield (str "ready" :quote "'")))] [(except-handler [(expr (call print [(str "caught" :quote "'") e]))] :type ValueError :name e)])])]) (assign [^:store it] (call g [])) (expr (call next [it])) (expr (call print [(call (attribute it throw) [(call ValueError [(str "x" :quote "'")])])])) (try [(expr (call (attribute it throw) [(call KeyError [(str "k" :quote "'")])]))] [(except-handler [(expr (call print [(str "propagated" :quote "'") e]))] :type KeyError :name e)])] {:file "paths/gen-throw.py" :mode :lines})

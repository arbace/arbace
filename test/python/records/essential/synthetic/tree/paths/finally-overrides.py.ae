(python/module [(function-def f (arguments) [(try [(return (str "try" :quote "'"))] [] :finally [(expr (call print [(str "finally runs" :quote "'")]))])]) (expr (call print [(call f [])])) (function-def g (arguments) [(for ^:store i (call range [3]) [(try [(continue)] [] :finally [(expr (call print [(str "finally" :quote "'") i]))])])]) (expr (call g []))] {:file "paths/finally-overrides.py" :mode :lines})

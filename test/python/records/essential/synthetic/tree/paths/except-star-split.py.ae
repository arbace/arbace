(python/module [(function-def raise_group (arguments) [(raise (call ExceptionGroup [(str "outer" :quote "'") (list [(call ValueError [1]) (call ExceptionGroup [(str "inner" :quote "'") (list [(call TypeError [2]) (call ValueError [3])])])])]))]) (try-star [(try-star [(expr (call raise_group []))] [(except-handler [(expr (call print [(str "value" :quote "'") (attribute eg exceptions)]))] :type ValueError :name eg)])] [(except-handler [(expr (call print [(str "type" :quote "'") (list-comp (attribute (call type [e]) __name__) [(comprehension ^:store e (attribute eg exceptions))])]))] :type TypeError :name eg)]) (assign [^:store eg] (call ExceptionGroup [(str "g" :quote "'") (list [(call ValueError [1]) (call KeyError [2])])])) (assign [(tuple [^:store m ^:store rest] {:ctx :store})] (call (attribute eg split) [ValueError])) (expr (call print [(attribute m exceptions) (attribute rest exceptions)]))] {:file "paths/except-star-split.py" :mode :lines})

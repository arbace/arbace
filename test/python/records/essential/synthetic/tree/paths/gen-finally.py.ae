(python/module [(function-def g (arguments) [(try [(expr (yield 1)) (expr (yield 2))] [] :finally [(expr (call print [(str "finally" :quote "'")]))])]) (assign [^:store it] (call g [])) (expr (call print [(call next [it])])) (expr (call (attribute it close) [])) (expr (call print [(str "closed" :quote "'")]))] {:file "paths/gen-finally.py" :mode :lines})

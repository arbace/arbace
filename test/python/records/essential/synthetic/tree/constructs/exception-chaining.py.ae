(python/module [(try [(try [(expr (bin-op / 1 0))] [(except-handler [(raise (call KeyError [(str "x" :quote "'")]))] :type ZeroDivisionError)])] [(except-handler [(expr (call print [(attribute (call type [(attribute e __context__)]) __name__) (attribute e __cause__) (attribute e __suppress_context__)]))] :type KeyError :name e)]) (assign [^:store e] (call ValueError [(str "a" :quote "'")])) (expr (call (attribute e add_note) [(str "note" :quote "'")])) (expr (call print [(attribute e __notes__)])) (try [(raise RuntimeError :from (call OSError [2]))] [(except-handler [(expr (call print [(call repr [(attribute e __cause__)])]))] :type RuntimeError :name e)])] {:file "constructs/exception-chaining.py" :mode :lines})

(python/module [(import-from contextlib [contextmanager]) (function-def cm (arguments :args [n]) [(expr (call print [(str "enter" :quote "'") n])) (expr (yield n)) (expr (call print [(str "exit" :quote "'") n]))] :decorators [contextmanager]) (with [(withitem (call cm [1]) ^:store a) (withitem (call cm [2]) ^:store b)] [(expr (call print [(str "body" :quote "'") a b]))]) (with [(withitem (call cm [3]) ^:store c)] [(expr (call print [(str "body" :quote "'") c]))])] {:file "constructs/with.py" :mode :lines})

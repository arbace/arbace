(python/module [(import [math (alias os.path :as p)]) (import-from collections [(alias OrderedDict :as OD) deque]) (import-from json [*]) (expr (call print [(call (attribute math floor) [(float "2.5")]) (call (attribute p basename) [(str "a/b" :quote "'")]) (attribute OD __name__) (attribute deque __name__) (call dumps [(list [1])])])) (import [importlib]) (expr (call print [(subscript (attribute (call (attribute importlib import_module) [(str "string" :quote "'")]) ascii_lowercase) (slice nil 3))]))] {:file "constructs/import.py" :mode :lines :type-ignores [(type-ignore 4 "[import]")]})

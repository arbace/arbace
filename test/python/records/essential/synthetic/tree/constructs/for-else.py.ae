(python/module [(for ^:store x (list [1 2]) [(pass)] :else [(expr (call print [(str "done" :quote "'") x]))]) (for ^:store x (call range [10]) [(if (compare x [==] [3]) [(break)])] :else [(expr (call print [(str "unreached" :quote "'")]))]) (expr (call print [x]))] {:file "constructs/for-else.py" :mode :lines})

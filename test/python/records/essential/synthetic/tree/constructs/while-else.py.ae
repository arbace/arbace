(python/module [(assign [^:store i] 0) (while (compare i [<] [3]) [(aug-assign ^:store i + 1) (if (compare i [==] [5]) [(break)])] :else [(expr (call print [(str "no break" :quote "'") i]))]) (while True [(aug-assign ^:store i - 1) (if (compare i [<] [0]) [(break)]) (if (bin-op % i 2) [(continue)]) (expr (call print [(str "even" :quote "'") i]))])] {:file "constructs/while-else.py" :mode :lines})

(python/module [(for ^:store v (tuple [0 1 2]) [(if (compare v [==] [0]) [(expr (call print [(str "zero" :quote "'")]))] :else [(if (compare v [==] [1]) [(expr (call print [(str "one" :quote "'")]))] :else [(expr (call print [(str "other" :quote "'")]))] {:elif true})])])] {:file "constructs/if-elif.py" :mode :lines})

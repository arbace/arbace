(python/module [(try-star [(raise (call ExceptionGroup [(str "g" :quote "'") (list [(call ValueError [1]) (call TypeError [2]) (call ValueError [3])])]))] [(except-handler [(expr (call print [(str "values" :quote "'") (list-comp (attribute e args) [(comprehension ^:store e (attribute eg exceptions))])]))] :type ValueError :name eg) (except-handler [(expr (call print [(str "types" :quote "'") (call len [(attribute eg exceptions)])]))] :type TypeError :name eg)])] {:file "constructs/try-star.py" :mode :lines})

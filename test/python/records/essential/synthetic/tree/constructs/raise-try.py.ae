(python/module [(function-def f (arguments :args [n]) [(try [(if (compare n [==] [0]) [(raise (call ValueError [(str "v" :quote "'")]))]) (if (compare n [==] [1]) [(raise (call KeyError [(str "k" :quote "'")]) :from None)]) (return (str "ok" :quote "'"))] [(except-handler [(return (tuple [(str "value" :quote "'") (call str [e])]))] :type ValueError :name e) (except-handler [(return (tuple [(str "lookup" :quote "'") (call repr [e]) (attribute e __suppress_context__)]))] :type (tuple [KeyError IndexError]) :name e)] :else [(expr (call print [(str "else" :quote "'")]))] :finally [(expr (call print [(str "finally" :quote "'") n]))])]) (for ^:store i (call range [3]) [(expr (call print [(call f [i])]))])] {:file "constructs/raise-try.py" :mode :lines})

(python/module [(assign [^:store a] (list [1 2 3 4])) (delete [(subscript a 0 {:ctx :del}) (subscript a (slice 1 2) {:ctx :del})]) (expr (call print [a])) (assign [^:store b] 1) (delete [^:del b]) (expr (call print [(compare (str "b" :quote "'") [in] [(call dir [])])])) (class-def O [(pass)]) (assign [^:store o] (call O [])) (assign [(attribute o x {:ctx :store})] 1) (delete [(attribute o x {:ctx :del})]) (expr (call print [(call vars [o])]))] {:file "constructs/delete.py" :mode :lines})

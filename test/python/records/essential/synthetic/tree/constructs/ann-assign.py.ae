(python/module [(ann-assign ^:store x int 1) (ann-assign ^:store y (subscript list int)) (ann-assign ^:store z str (str "z" :quote "'") :simple false) (expr (call print [x z (compare (str "y" :quote "'") [in] [(call dir [])])])) (class-def K [(ann-assign ^:store a int 3) (ann-assign ^:store b str)]) (expr (call print [(attribute K a) (attribute K __annotations__)]))] {:file "constructs/ann-assign.py" :mode :lines})

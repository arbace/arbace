(python/module [(function-def deco (arguments :args [tag]) [(function-def wrap (arguments :args [f]) [(function-def w (arguments :vararg a) [(return (tuple [tag (call f [(starred a)])]))]) (return w)]) (return wrap)]) (function-def f (arguments :args [x]) [(return x)] :decorators [(call deco [(str "a" :quote "'")]) (call deco [(str "b" :quote "'")])]) (expr (call print [(call f [1])])) (class-def X [(pass)] :decorators [(lambda (arguments :args [c]) (attribute c __name__))]) (expr (call print [X]))] {:file "constructs/decorators.py" :mode :lines})

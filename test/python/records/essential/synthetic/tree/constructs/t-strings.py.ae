(python/module [(import-from string.templatelib [Template Interpolation]) (assign [(tuple [^:store name ^:store n] {:ctx :store})] (tuple [(str "py" :quote "'") 41])) (assign [^:store t] (template-str ["hi " (interpolation name "name" :conversion s :format-spec [">5"]) " " (interpolation (bin-op + n 1) "n + 1")] :quote "'")) (expr (call print [(attribute t strings) (list-comp (attribute i expression) [(comprehension ^:store i (attribute t interpolations))])])) (expr (call print [(list-comp (tuple [(attribute i value) (attribute i conversion) (attribute i format_spec)]) [(comprehension ^:store i (attribute t interpolations))])])) (expr (call print [(attribute (call type [t]) __name__) (subscript (call list [t]) 0)]))] {:file "constructs/t-strings.py" :mode :lines})

(python/module [(class-def Base [(function-def who (arguments :args [self]) [(return (str "base" :quote "'"))])]) (class-def Kid [(function-def who (arguments :args [self]) [(return (bin-op + (str "kid/" :quote "'") (call (attribute (call super []) who) [])))])] :bases [Base]) (expr (call print [(call (attribute (call Kid []) who) []) (compare (attribute Kid __mro__) [==] [(tuple [Kid Base object])]) (attribute Kid __qualname__)])) (class-def A [(pass)]) (class-def B [(pass)] :bases [A]) (class-def C [(pass)] :bases [A]) (class-def D [(pass)] :bases [B C]) (expr (call print [(list-comp (attribute k __name__) [(comprehension ^:store k (attribute D __mro__))])]))] {:file "constructs/class-def.py" :mode :lines})

(python/module [(import [os]) (assign [^:store x] (list []) {:type-comment "list[int]"}) (function-def scale (arguments :args [(arg a {:type-comment "int"}) (arg b {:type-comment "float"})]) [(return (bin-op * a b))] {:type-comment "(...) -> float"}) (for ^:store i (call range [2]) [(expr (call (attribute x append) [i]))] {:type-comment "int"}) (with [(withitem (call open [(attribute os devnull)]) ^:store fh)] [(pass)] {:type-comment "object"}) (expr (call print [x (call scale [2 (float "1.5")])]))] {:file "type_comments.py" :mode :lines :type-ignores [(type-ignore 2 "[import]")]})

(python/module [(import-from dataclasses [dataclass]) (class-def Point [(ann-assign ^:store x int) (ann-assign ^:store y int)] :decorators [dataclass]) (function-def describe (arguments :args [cmd]) [(match cmd [(match-case (match-mapping ["op"] [(match-value "go")] :rest rest) [(return (tuple ["go" rest]))]) (match-case (match-as (match-or [(match-class Point [] :kwd-attrs [x y] :kwd-patterns [(match-value 0) (match-as)]) (match-sequence [(match-singleton None) (match-singleton True) (match-star)])]) whole) [(return (tuple ["origin or seq" whole]))]) (match-case (match-sequence [(match-value 1) (match-star rest)]) [(return (tuple ["one and" rest]))] :guard rest) (match-case (match-class Point [(match-value 1) (match-as nil y)]) [(return (tuple ["x is one" y]))]) (match-case (match-or [(match-value (unary-op - 1)) (match-value (float "2.5")) (match-value "s") (match-singleton False)]) [(return (tuple ["value" cmd]))]) (match-case (match-or [(match-class str []) (match-class bytes [])]) [(return (tuple ["text" cmd]))]) (match-case (match-as) [(return (tuple ["other" cmd]))])])]) (for ^:store c (list [(dict ["op" "n"] ["go" 1]) (call Point [0 9]) (list [None True 3]) (list [1 2]) (call Point [1 5]) (unary-op - 1) "t" 7]) [(expr (call print [(call describe [c])]))])] {:file "patterns.py" :mode :lines})

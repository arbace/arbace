(python/module [(function-def f (arguments :args [(arg a {:type-comment "int" :pos [1 6 1 7]})]) [(assign [(name x {:ctx :store :pos [4 4 4 5]})] (int "1" {:pos [4 8 4 9]}) {:pos [4 4 4 9]})] {:type-comment "(...) -> None" :pos [1 0 4 9]})] {:file "type-comments.py" :mode :full :type-ignores [(type-ignore 4 "[attr]")] :tokens [:name "def" :ws " " :name "f" :op "(" :name "a" :op "," :ws "  " :comment "# type: int" :nl "
" :ws "      " :op ")" :op ":" :newline "
" :ws "    " :comment "# type: (...) -> None" :nl "
" :indent "    " :name "x" :ws " " :op "=" :ws " " :number "1" :ws "  " :comment "# type: ignore[attr]" :newline "
" :dedent "" :endmarker ""]})

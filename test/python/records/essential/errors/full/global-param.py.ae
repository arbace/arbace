(python/module [(function-def f (arguments :args [(arg x {:pos [2 6 2 7]})]) [(global [x] {:pos [3 4 3 12]})] {:pos [2 0 3 12]})] {:file "global-param.py" :mode :full :tokens [:comment "# A program CPython's symbol table rejects (bin/pyi scope-check, PY5a): global-param" :nl "
" :name "def" :ws " " :name "f" :op "(" :name "x" :op ")" :op ":" :newline "
" :indent "    " :name "global" :ws " " :name "x" :newline "
" :dedent "" :endmarker ""]})

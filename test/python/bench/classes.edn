;; The classes of pyperformance 1.14.0's pure benchmarks that do not run as CPython under pyi (bin/pyi bench; PY6h,
;; queue 200): one map per line, {:id NAME :class CLASS :owner OWNER :why WHY}; bin/pyi bench prints a benchmark not
;; run as CPython with its class and exits 1 on one of no class.
{:id "bm_2to3" :class :pip :owner "none (the harness)" :why "CPython's run fails too: the benchmark pip-installs its vendored lib2to3 (vendor/) into its virtual environment, which bin/pyi bench does not make (pyperf's runner not used, queue 177's decision); under pyi it stops before, at os.scandir (PY6e)"}
{:id "bm_argparse" :class :posix :owner "PY6e" :why "argparse's default formatter asks shutil.get_terminal_size, which builds os.terminal_size: posix's struct sequences are PY6e's"}
{:id "bm_argparse_subparsers" :class :posix :owner "PY6e" :why "as bm_argparse: os.terminal_size"}
{:id "bm_asyncio_tcp" :class :ssl :owner "deferred (survey §6.6)" :why "the benchmark imports ssl at its top for its --ssl variant: _ssl is deferred until x509roots and Go's TLS are wired"}
{:id "bm_asyncio_tcp_ssl" :class :ssl :owner "deferred (survey §6.6)" :why "TLS over asyncio: _ssl"}
{:id "bm_concurrent_imap" :class :threads :owner "PY6f" :why "multiprocessing.pool's ThreadPool: _multiprocessing and threads"}
{:id "bm_gc_collect" :class :finalization :owner "PY7" :why "gc.collect() returns no count of the cycles it freed: Go's collector, survey §6.5 (PYS9)"}
{:id "bm_pathlib" :class :posix :owner "PY6e" :why "os.scandir is PY6e's posix"}
{:id "bm_pickle" :class :pickle :owner "PY6d" :why "the benchmark refuses to run without the C accelerator _pickle (\"Missing C accelerators for pickle\")"}
{:id "bm_pickle_dict" :class :pickle :owner "PY6d" :why "as bm_pickle: _pickle"}
{:id "bm_pickle_list" :class :pickle :owner "PY6d" :why "as bm_pickle: _pickle"}
{:id "bm_unpickle" :class :pickle :owner "PY6d" :why "as bm_pickle: _pickle"}
{:id "bm_unpickle_list" :class :pickle :owner "PY6d" :why "as bm_pickle: _pickle"}
{:id "bm_python_startup" :class :subprocess :owner "PY6e" :why "bench_command runs a subprocess: _posixsubprocess.fork_exec"}
{:id "bm_python_startup_no_site" :class :subprocess :owner "PY6e" :why "as bm_python_startup"}
{:id "bm_scimark" :class :array :owner "PY6d" :why "array.array's sequence operations (array * int): PY6a's minimal array, PY6d ports it whole"}
{:id "bm_sqlite_synth" :class :sqlite :owner "deferred (survey §6.6)" :why "_sqlite3 is deferred, a class in v1"}
{:id "bm_typing_runtime_protocols" :class :typing-runtime :owner "PY5c" :why "issubclass against a runtime-checkable protocol with data members raises where CPython's _ProtocolMeta lets the benchmark's calls through (lib-test's :typing-runtime)"}
{:id "bm_xml_etree" :class :expat :owner "deferred (survey §6.6: the C crop)" :why "pyexpat: expat is a C core for the C crop (PYS11 (b)), not ported"}
{:id "bm_pyflate" :class :hashlib :owner "PY6d" :why "the decompressed output checked by hashlib.md5: the hashes are the data family's"}

;; bin/pyi c2j-check's negative control (queue 206; GTS81 (a)): a namespace c2j must refuse. The macro expands to an
;; evaluated fn that closes over the macro's parameter, a constant the evaluator takes (the fn object is the value) and c2j
;; cannot (arbace/c2j/emit.ae's "a fn closing over locals as a constant"); the check fails when c2j compiles it or refuses
;; it with another message.
(ns pyi.c2j-control)

(defmacro a-closure [x] (fn [] x))

(def closure (a-closure 1))

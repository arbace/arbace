;; bin/pyi cover subset --write (queue 201, PY7; GT8.3): each lib-test corpus's coverage subset written into
;; test/python/corpora.edn as its :subset, the ids of the check's record (MODULE/TEST-ID) one a line, sorted: the corpora
;; language-core, stdlib-tests and lib-test-asyncio in their :corpora maps (a :subset line before :license, replaced when
;; there), lib-test-all, no corpus of :corpora (its modules are the references', less the families'), in the top-level
;; map :lib-test-all (test/gate/plan.ae's corpus-subset finds a map of its :id anywhere in the file).
;; usage: arbace test/python/corpora_subset.ae CORPORA.edn DIR   (DIR/CORPUS.txt, one id a line)
(require '[arbace.string :as str])
(import '[java.io File])

(let [[path dir] *command-line-args*
      text (slurp path)
      ids-of (fn [c] (let [f (File. (str dir "/" c ".txt"))]
                       (when (.exists f) (vec (sort (distinct (remove str/blank? (str/split-lines (slurp f)))))))))
      vec-text (fn [ids indent] (str "[" (str/join (str "\n" indent " ") (map pr-str ids)) "]"))
      set-corpus (fn [t c]
                   (if-let [ids (ids-of c)]
                     (let [i (.indexOf ^String t (str "{:id :" c "\n"))
                           _ (when (neg? i) (throw (ex-info (str "no corpus " c " in " path) {})))
                           j (.indexOf ^String t "\n   :license " i)
                           k (.indexOf ^String t "\n   :subset " i)
                           line (str "\n   :subset " (vec-text ids "            "))]
                       (if (and (pos? k) (< k j))
                         (str (subs t 0 k) line (subs t j))
                         (str (subs t 0 j) line (subs t j))))
                     t))
      t (reduce set-corpus text ["language-core" "stdlib-tests" "lib-test-asyncio"])
      t (if-let [ids (ids-of "lib-test-all")]
          (let [m (str " :lib-test-all\n {:id :lib-test-all\n  :what \"bin/pyi check's corpus of the Lib/test modules no family owns (the modules of ref-cpython314-lib-test-all.edn less test/python/lib-test-all-owners.tsv's): no corpus of :corpora, its files :lib-test's\"\n  :subset "
                       (vec-text ids "          ") "}")
                k (.indexOf ^String t "\n :lib-test-all\n")]
            (if (pos? k)
              (str (subs t 0 (inc k)) m "}\n")
              (str (subs t 0 (.lastIndexOf ^String (str/trimr t) "}")) "\n" m "}\n")))
          t)]
  (read-string t)
  (spit path t)
  (println "corpora.edn: :subset written for" (str/join ", " (for [c ["language-core" "stdlib-tests" "lib-test-asyncio" "lib-test-all"] :when (ids-of c)] (str c " " (count (ids-of c)))))))

;; The gate's subsets of Python's rotated steps whose universe is a check's record (queue 235; test/gate/crops/python.edn's
;; :rotate :subset; test/gate/plan.ae's corpus-subset finds the map whose :id is the step's part): each night runs the
;; subset, the files that failed since and a seventh of the rest, so the whole universe in a week (GT8.4).
;;   pyi-check (bin/pyi check --corpus PART --only LIST): modules, the record's methods' MODULE (the step's :id-re), so a
;;     night runs a seventh of the modules whole (no planner change: a rotation by method, the coverage subset's
;;     MODULE/TEST-ID ids of corpora.edn's :subset, needs pyi-check's :slice-re, GTS243). :subset-check by hand: a cheap
;;     module of each corpus; lib-test-all's the controls' subjects (bin/pyi check --only adds them to every selection too)
;;   pyi-check-aot-goi (bin/pyi check --aot --only-list LIST, pyi on goi): the programs of test/python/essential-aot.txt
;; Read with the Clojure reader.
[{:id :language-core :subset-check ["test_class"]}
 {:id :stdlib-tests :subset-check ["test_errno" "test_stat"]}
 {:id :lib-test-asyncio :subset-check ["test_asyncio.test_futures2"]}
 {:id :lib-test-all :subset-check ["test_bool" "test_getopt"]}
 {:id :with-pyi :subset ["samples/functions.py" "samples/patterns.py" "synth/ops/add.py" "synth/ops/cmp-eq.py" "synth/ops/pow.py" "synth/builtins/str.py" "synth/builtins/dict.py" "synth/constructs/class-def.py" "synth/constructs/comprehensions.py" "synth/constructs/f-strings.py" "synth/constructs/match.py" "synth/constructs/try-star.py" "synth/constructs/with.py" "synth/datamodel/descriptor.py" "synth/datamodel/numeric-binary.py" "synth/datamodel/getattribute.py" "synth/paths/coroutine-send-throw.py" "synth/paths/gen-yield-from-delegation.py" "synth/paths/sys-exit.py" "synth/paths/uncaught-exception.py" "synth/datamodel/del.py"]}]

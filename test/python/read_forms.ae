;; The reader's half of `bin/repr-python spec-check` (doc/python/SPEC.md §15): every NNN.forms file of DIR (the
;; spec's forms blocks, extracted by tools/pydump/spec_check.py) read by Arbace's reader as one vector of forms. Prints
;; one line per failure and a summary; exits 1 when any block does not read or none was found.
(let [dir (first *command-line-args*)
      files (sort (filter #(.endsWith ^String % ".forms") (map str (.listFiles (java.io.File. ^String dir)))))
      bad (atom 0)
      n (atom 0)]
  (doseq [f files]
    (try
      (swap! n + (count (read-string (str "[" (slurp f) "\n]"))))
      (catch Throwable e
        (swap! bad inc)
        (println "FAIL" f (.getMessage e)))))
  (println (str "spec-check: " (count files) " forms blocks read by Arbace's reader, " @n " forms, " @bad " failing"))
  (when (or (pos? @bad) (empty? files)) (System/exit 1)))

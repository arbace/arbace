;; test/python/corpora.edn as tab-separated rows for bin/repr-python (its pins and measures; doc/python/SPEC.md §15):
;;   pin      KEY  FIELD  VALUE                  (:url :fetched-into :extracted-into :sha256 :sha512 :bytes :mirror :apks)
;;   file     PATH SHA256                         (the cpython pin's :files)
;;   corpus   ID   BASE  PATHS  EXCLUDES  FILES  LINES  DIGEST  TESTS
;;            BASE is pin:KEY or root:DIR; PATHS and EXCLUDES comma-separated; TESTS "MODULES CLASSES METHODS" or "-"
;;   rejected ID   PATH  CLASS  MSG
;; usage: arbace test/python/corpora_rows.ae CORPORA.edn
(let [c (read-string (slurp (first *command-line-args*)))
      row (fn [& xs] (println (apply str (interpose "\t" xs))))
      j (fn [xs] (if (seq xs) (apply str (interpose "," xs)) "-"))]
  (doseq [[k p] (sort-by (comp str key) (:pins c))
          f [:url :fetched-into :extracted-into :sha256 :sha512 :bytes :mirror :apks]
          :when (contains? p f)]
    (row "pin" (name k) (name f) (get p f)))
  (doseq [[path sha] (sort (get-in c [:pins :cpython-3.14.10 :files]))]
    (row "file" path sha))
  (doseq [{:keys [id where files lines digest tests rejected]} (:corpora c)]
    (row "corpus" (name id)
         (if (:pin where) (str "pin:" (name (:pin where))) (str "root:" (:root where)))
         (j (:paths where)) (j (:exclude where)) files lines digest
         (if tests (str (:modules tests) " " (:classes tests) " " (:methods tests)) "-"))
    (doseq [[path cls msg] rejected]
      (row "rejected" (name id) path (name cls) msg))))

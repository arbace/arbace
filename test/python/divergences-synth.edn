;; pyi's divergences from CPython 3.14.10 on the synthetic corpus and the samples (bin/reap's [:python :eval] source "pyi on
;; goi" and its [:python :aot] cell's second classes file; queue 201 PY10, doc/python/PYTHON-SURVEY.md, "As built: PY10"), in
;; test/goi/divergences.edn's format (GR10). The cases are bin/pyi check --aot's programs ("synth/DIR/NAME.py",
;; "samples/NAME.py"), their reason "RESULT REASON" as bin/reap's pyi-aot reader writes it from the record
;; (test/python/check-aot-linux-ARCH.edn): "as-pyi WHY" (the compiled run is the loop's and pyi's, not CPython's: the
;; interpreter's own divergence, judged once here for both levels), "pyi-differs ..." (pyi's run alone not CPython's) or
;; "reference-excluded WHY". The classes name their programs (:tests): the AOT judge's reason for a stdout difference is
;; only "stdout not CPython's", so a class is found by comparing the outputs (queue 201's sample run: bin/pyi check --aot
;; --no-pyi on the VM at 9e41dc00, 138 pass, these 13 :as-pyi; the outputs diffed against python3's). Each is the runtime's
;; (go/arbace/py, PY7-runtime's files) unless it says otherwise; a fixed program leaves its class (bin/reap: a class that
;; names a passing program is harmless, but prune it with the record). Read with the Clojure reader.
[
 {:id :bytes-methods
  :title "bytes and bytearray: center's padding, expandtabs and istitle"
  :kind :deferred
  :owner "PY7-runtime (go/arbace/py's bytes methods)"
  :why "b'...'.center(20, b'*') puts the odd pad on the left (CPython: on the right, as str.center); bytes.expandtabs and bytes.istitle are absent (AttributeError)"
  :decided "queue 201, PY10 (the sample run's diff)"
  :tests ["synth/builtins/bytes.py" "synth/builtins/bytearray-shared.py"]}
 {:id :from-number
  :title "3.14's float.from_number and complex.from_number absent"
  :kind :deferred
  :owner "PY7-runtime"
  :why "Python 3.14 added the class methods float.from_number and complex.from_number (PEP-less, gh-121797); pyi raises AttributeError"
  :decided "queue 201, PY10 (the sample run's diff)"
  :tests ["synth/builtins/float.py" "synth/builtins/complex.py"]}
 {:id :dict-reversed
  :title "reversed() of a dict"
  :kind :deferred
  :owner "PY7-runtime"
  :why "dict.__reversed__ (3.8) absent: reversed(d) raises TypeError where CPython iterates the keys in reverse insertion order"
  :decided "queue 201, PY10 (the sample run's diff)"
  :tests ["synth/builtins/dict.py"]}
 {:id :range-methods
  :title "range.count and range.index absent"
  :kind :deferred
  :owner "PY7-runtime"
  :why "range's count and index methods raise AttributeError"
  :decided "queue 201, PY10 (the sample run's diff)"
  :tests ["synth/builtins/range.py"]}
 {:id :buffer-protocol
  :title "memoryview's attributes and the __buffer__ protocol"
  :kind :deferred
  :owner "PY7-runtime (with :buffer-exports of divergences.edn, PYS9)"
  :why "memoryview lacks c_contiguous, f_contiguous, contiguous, count, index, format, itemsize, nbytes, ndim, shape, strides, suboffsets and toreadonly, and release() leaves obj readable; bytes() and memoryview() of a class with __buffer__ (PEP 688) raise TypeError"
  :decided "queue 201, PY10 (the sample run's diff)"
  :tests ["synth/builtins/memoryview.py" "synth/datamodel/buffer.py"]}
 {:id :bytes-dunder
  :title "bytes() of an object with __bytes__"
  :kind :deferred
  :owner "PY7-runtime"
  :why "bytes(x) of a class defining __bytes__ raises TypeError where CPython calls it"
  :decided "queue 201, PY10 (the sample run's diff)"
  :tests ["synth/datamodel/bytes.py"]}
 {:id :gen-close-value
  :title "generator.close() returning the generator's return value"
  :kind :deferred
  :owner "PY7-runtime (generators, PY5d's)"
  :why "since 3.13 close() returns the value a generator returns on GeneratorExit; pyi's returns None"
  :decided "queue 201, PY10 (the sample run's diff)"
  :tests ["synth/paths/gen-return-close.py"]}
 {:id :bool-invert-warning
  :title "~ on a bool: CPython 3.12's DeprecationWarning not issued"
  :kind :deferred
  :owner "PY7-runtime (bool's __invert__ through the warnings module)"
  :why "the outputs are equal; CPython writes \"DeprecationWarning: Bitwise inversion '~' on bool is deprecated\" to standard error (the reference's last line is its source line), pyi writes nothing"
  :decided "queue 201, PY10 (the sample run's diff)"
  :tests ["synth/builtins/bool.py" "synth/ops/unary.py"]}
 {:id :finalization
  :title "finalization: __del__ at the point CPython's reference counting runs it"
  :kind :deferred
  :owner "PY7 (PYS9's measured class: divergences.edn's :finalization)"
  :why "pyi's objects are Go's, collected by Go's collector: a __del__ CPython runs when the last reference goes (del x, a rebinding) runs later or not at all before exit (survey §6.5, PYS9)"
  :decided "PYS9 (a), survey §6.5"
  :tests ["synth/datamodel/del.py"]}
 {:id :reference-excluded
  :title "a reference CPython's own two runs disagree on, or whose output names the machine"
  :kind :design
  :owner "none (by design)"
  :why "bin/pyi record-ref writes such a program :excluded (survey §8.1): there is nothing to judge it against"
  :decided "GTS207 (a), PYS14 (a); PY4"
  :match [#"^reference-excluded "]}
]

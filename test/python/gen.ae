;; The synthetic corpus of the Python crop (doc/python/PYTHON-SURVEY.md §8.3, GT8.6; PYS16 (a); PY4): small deterministic
;; programs, each printing what it computes, generated from the tables below construct by construct and protocol by
;; protocol. Their references are CPython 3.14.10's runs (GTS207 (a), bin/pyi record-ref), not outputs of this generator.
;;
;; Families (one directory each under the output directory):
;;   ops/        every binary, comparison, unary, boolean and augmented operator over every pair of a table of operands
;;               (the reflected-operand rule, NotImplemented and the errors by their exception's name)
;;   datamodel/  one program per special method: a class defining it, the syntax or builtin that calls it, the result
;;   builtins/   one program per builtin type: each of its public methods called on fixed arguments
;;   constructs/ one program per statement and expression kind of the ast (together every node class, checked by
;;               bin/pyi gen --check with the oracle's ast)
;;   paths/      the generator, coroutine, async generator, context manager and exception paths of §8.3 (3)
;; Every program prints repr()s and exception names only (no addresses, ids, times, sizes, platform facts), so the
;; references are the machine's no more than CPython's own semantics are.
;;
;; usage: arbace test/python/gen.ae OUTDIR     (bin/pyi gen; the files are committed under test/python/synth/)
(require '[arbace.string :as str])
(import '[java.io File])

(def out (first *command-line-args*))

(defn emit [rel lines]
  (let [f (File. (str out "/" rel))]
    (.mkdirs (.getParentFile f))
    (spit f (str (str/join "\n" lines) "\n"))
    rel))

(def header "# Generated by test/python/gen.ae (bin/pyi gen): do not edit; the reference is CPython's run (bin/pyi record-ref).")

(def show-fn
  ["def show(label, thunk):"
   "    try:"
   "        print(label, '->', repr(thunk()))"
   "    except Exception as e:"
   "        print(label, '->', type(e).__name__)"
   ""])

;; ---- ops ----

(def operands
  ["7" "-3" "0" "2.5" "-0.5" "True" "(1+2j)" "'ab'" "b'xy'" "[1, 2]" "(3,)" "{1, 2}" "{'k': 1}" "None" "10**20"])

(def binops
  [["add" "+"] ["sub" "-"] ["mul" "*"] ["matmul" "@"] ["truediv" "/"] ["floordiv" "//"] ["mod" "%"] ["pow" "**"]
   ["lshift" "<<"] ["rshift" ">>"] ["and" "&"] ["xor" "^"] ["or" "|"]])

(def cmpops
  [["lt" "<"] ["le" "<="] ["eq" "=="] ["ne" "!="] ["gt" ">"] ["ge" ">="] ["is" "is"] ["is-not" "is not"]
   ["in" "in"] ["not-in" "not in"]])

(defn guard
  "For ** and the shifts, a huge right operand is skipped (7 ** 10**20 does not end)"
  [op ind]
  (when (#{"**" "<<" ">>"} op)
    [(str ind "if isinstance(b, int) and not isinstance(b, bool) and abs(b) > 64:")
     (str ind "    print((i, j), '-> skipped')")
     (str ind "    continue")]))

(defn pair-program [name op]
  (emit (str "ops/" name ".py")
        (concat [header (str "# the operator " op " over every pair of operands") ""] show-fn
                ["operands = [" (str "    " (str/join ", " operands)) "]"
                 "for i, a in enumerate(operands):"
                 "    for j, b in enumerate(operands):"]
                (guard op "        ")
                [(str "        show((i, j), lambda: a " op " b)")])))

(defn aug-program [name op]
  (emit (str "ops/aug-" name ".py")
        (concat [header (str "# the augmented assignment " op "= over every pair of operands, lists and sets in place") ""] show-fn
                ["operands = [" (str "    " (str/join ", " operands)) "]"
                 "for i in range(len(operands)):"
                 "    for j in range(len(operands)):"
                 "        b = operands[j]"]
                (guard op "        ")
                ["        def run(i=i, j=j):"
                 "            a = [1, 2] if i == 9 else {1, 2} if i == 11 else operands[i]"
                 "            alias = a"
                 (str "            a " op "= operands[j]")
                 "            return a, alias is a"
                 "        show((i, j), run)"])))

(defn unary-programs []
  [(emit "ops/unary.py"
         (concat [header "# the unary operators over every operand" ""] show-fn
                 ["operands = [" (str "    " (str/join ", " operands)) "]"
                  "for i, a in enumerate(operands):"
                  "    show(('-', i), lambda: -a)"
                  "    show(('+', i), lambda: +a)"
                  "    show(('~', i), lambda: ~a)"
                  "    show(('not', i), lambda: not a)"
                  "    show(('bool', i), lambda: bool(a))"]))
   (emit "ops/boolean.py"
         (concat [header "# and, or and their short circuit" ""] show-fn
                 ["calls = []"
                  "def v(x):"
                  "    calls.append(x)"
                  "    return x"
                  "values = [0, 1, '', 'a', None, [], [0]]"
                  "for a in values:"
                  "    for b in values:"
                  "        calls.clear()"
                  "        r1 = v(a) and v(b)"
                  "        c1 = list(calls)"
                  "        calls.clear()"
                  "        r2 = v(a) or v(b)"
                  "        print(repr(a), repr(b), repr(r1), c1, repr(r2), list(calls))"
                  "print(1 < 2 < 3, 3 > 2 > 2, 1 == 1.0 == True, 'a' < 'b' <= 'b')"]))])

;; ---- datamodel: [name, class body lines, the calls] ----

(def dunders
  [["init-new" ["def __new__(cls, *a):" "    print('new', a)" "    return super().__new__(cls)"
                "def __init__(self, *a):" "    print('init', a)"] ["type(C(1, 2)).__name__"]]
   ["repr-str" ["def __repr__(self): return 'C()'" "def __str__(self): return 'c'"] ["repr(C())" "str(C())" "f'{C()} {C()!r}'"]]
   ["format" ["def __format__(self, spec): return '<' + spec + '>'"] ["format(C(), 'x>5')" "f'{C():abc}'"]]
   ["bytes" ["def __bytes__(self): return b'c'"] ["bytes(C())"]]
   ["hash-eq" ["def __eq__(self, o): return isinstance(o, C)" "def __hash__(self): return 42"]
    ["hash(C())" "C() == C()" "C() != C()" "len({C(), C()})" "C.__hash__ is not None"]]
   ["eq-unhashable" ["def __eq__(self, o): return True"] ["C() == 1" "C.__hash__"]]
   ["rich-compare" ["def __init__(self, v): self.v = v" "def __lt__(self, o): return self.v < o.v"
                    "def __le__(self, o): return self.v <= o.v" "def __gt__(self, o): return self.v > o.v"
                    "def __ge__(self, o): return self.v >= o.v"]
    ["C(1) < C(2)" "C(1) <= C(1)" "C(3) > C(2)" "C(1) >= C(2)" "sorted([C(3), C(1), C(2)])[0].v" "C(1) < 5"]]
   ["bool-len" ["def __len__(self): return 0"] ["bool(C())" "len(C())" "not C()"]]
   ["bool" ["def __bool__(self): return False"] ["bool(C())" "'yes' if C() else 'no'"]]
   ["getattr" ["def __getattr__(self, n): return n.upper()"] ["C().abc" "getattr(C(), 'xy')" "hasattr(C(), 'q')"]]
   ["getattribute" ["def __getattribute__(self, n):" "    if n == 'x': return 1" "    return object.__getattribute__(self, n)"]
    ["C().x" "C().y"]]
   ["setattr-delattr" ["def __setattr__(self, n, v): object.__setattr__(self, n, v * 2)"
                       "def __delattr__(self, n): print('del', n); object.__delattr__(self, n)"]
    ["(c := C(), setattr(c, 'a', 3), c.a)[2]" "(c := C(), setattr(c, 'a', 3), delattr(c, 'a'), hasattr(c, 'a'))[3]"]]
   ["dir" ["def __dir__(self): return ['b', 'a']"] ["dir(C())"]]
   ["descriptor" [] ["D().attr" "(d := D(), setattr(d, 'attr', 5), d.attr)[2]" "(d := D(), delattr(d, 'attr'))[0].__class__.__name__"]
    ["class Desc:" "    def __set_name__(self, owner, name): print('set_name', owner.__name__, name); self.name = name"
     "    def __get__(self, obj, typ=None): return ('get', self.name, obj is None)"
     "    def __set__(self, obj, v): print('set', v)" "    def __delete__(self, obj): print('delete')"
     "class D:" "    attr = Desc()"]]
   ["property-slots" ["__slots__ = ('_v',)" "def __init__(self): self._v = 1" "@property" "def v(self): return self._v"
                      "@v.setter" "def v(self, x): self._v = x * 10"]
    ["C().v" "(c := C(), setattr(c, 'v', 2), c.v)[2]" "hasattr(C(), '__dict__')" "C.__slots__"]]
   ["classmethod-staticmethod" ["@classmethod" "def k(cls): return cls.__name__" "@staticmethod" "def s(x): return x + 1"]
    ["C.k()" "C().k()" "C.s(1)" "C().s(2)"]]
   ["init-subclass" ["def __init_subclass__(cls, **kw): print('init_subclass', cls.__name__, kw)"]
    ["type('E', (C,), {}).__name__" "(class_d := type('F', (C,), {}, flag=1)).__name__"]]
   ["class-getitem" ["def __class_getitem__(cls, item): return ('cgi', item)"] ["C[int]" "C[1, 2]"]]
   ["mro-entries" [] ["type('G', (M(),), {}).__mro__[1].__name__"]
    ["class M:" "    def __mro_entries__(self, bases): return (int,)"]]
   ["call" ["def __call__(self, *a, **k): return (a, sorted(k.items()))"] ["C()(1, x=2)" "callable(C())"]]
   ["container" ["def __init__(self): self.d = {}" "def __getitem__(self, k): return self.d.get(k, 'missing')"
                 "def __setitem__(self, k, v): self.d[k] = v" "def __delitem__(self, k): del self.d[k]"
                 "def __contains__(self, k): return k in self.d" "def __len__(self): return len(self.d)"]
    ["(c := C(), c.__setitem__(1, 'a'), c[1], 1 in c, 2 in c, len(c))[2:]" "(c := C(), c.__setitem__('k', 1), c.__delitem__('k'), c['k'])[3]"]]
   ["iter-next" ["def __init__(self): self.n = 0" "def __iter__(self): return self"
                 "def __next__(self):" "    self.n += 1" "    if self.n > 3: raise StopIteration" "    return self.n"]
    ["list(C())" "sum(C())" "[x * 2 for x in C()]" "next(iter(C()))"]]
   ["getitem-iteration" ["def __getitem__(self, i):" "    if i >= 3: raise IndexError" "    return i * i"] ["list(C())" "4 in C()"]]
   ["reversed" ["def __reversed__(self): return iter([3, 2, 1])"] ["list(reversed(C()))"]]
   ["length-hint" ["def __length_hint__(self): return 7"] ["__import__('operator').length_hint(C())"]]
   ["missing" [] ["Dm()['x']" "Dm(a=1)['a']"] ["class Dm(dict):" "    def __missing__(self, k): return k * 2"]]
   ["context-manager" ["def __enter__(self): print('enter'); return 'v'"
                       "def __exit__(self, t, v, tb): print('exit', t.__name__ if t else None); return True"]
    ["(lambda: [print('body', v) for v in [0]])()"] [] ["with C() as v:" "    print('in', v)" "    raise KeyError(1)" "print('after')"]]
   ["numeric-binary" ["def __init__(self, v): self.v = v" "def __repr__(self): return f'C({self.v!r})'"
                      "def __add__(self, o): return C(('add', self.v, o))" "def __radd__(self, o): return C(('radd', o, self.v))"
                      "def __iadd__(self, o): self.v = ('iadd', self.v, o); return self"
                      "def __sub__(self, o): return NotImplemented" "def __rsub__(self, o): return ('rsub', o)"
                      "def __mul__(self, o): return ('mul', o)" "def __rmul__(self, o): return ('rmul', o)"
                      "def __matmul__(self, o): return ('matmul', o)" "def __rmatmul__(self, o): return ('rmatmul', o)"
                      "def __truediv__(self, o): return ('truediv', o)" "def __floordiv__(self, o): return ('floordiv', o)"
                      "def __mod__(self, o): return ('mod', o)" "def __divmod__(self, o): return ('divmod', o)"
                      "def __rdivmod__(self, o): return ('rdivmod', o)" "def __pow__(self, o, m=None): return ('pow', o, m)"
                      "def __rpow__(self, o): return ('rpow', o)" "def __lshift__(self, o): return ('lshift', o)"
                      "def __rshift__(self, o): return ('rshift', o)" "def __and__(self, o): return ('and', o)"
                      "def __xor__(self, o): return ('xor', o)" "def __or__(self, o): return ('or', o)"
                      "def __ror__(self, o): return ('ror', o)"]
    ["C(1) + 2" "2 + C(1)" "(c := C(1), c.__iadd__(5))[1]" "C(1) - 1" "1 - C(1)" "C(1) * 3" "3 * C(1)" "C(1) @ 2" "2 @ C(1)"
     "C(1) / 2" "C(1) // 2" "C(1) % 2" "divmod(C(1), 2)" "divmod(2, C(1))" "C(1) ** 2" "pow(C(1), 2, 5)" "2 ** C(1)"
     "C(1) << 1" "C(1) >> 1" "C(1) & 1" "C(1) ^ 1" "C(1) | 1" "1 | C(1)" "C(1) - C(2)"]]
   ["numeric-unary" ["def __neg__(self): return 'neg'" "def __pos__(self): return 'pos'" "def __abs__(self): return 'abs'"
                     "def __invert__(self): return 'invert'" "def __int__(self): return 3" "def __float__(self): return 2.5"
                     "def __complex__(self): return 1j" "def __index__(self): return 4" "def __round__(self, n=None): return ('round', n)"
                     "def __trunc__(self): return 't'" "def __floor__(self): return 'f'" "def __ceil__(self): return 'c'"]
    ["-C()" "+C()" "abs(C())" "~C()" "int(C())" "float(C())" "complex(C())" "[0, 1, 2, 3, 4, 5][C()]" "bin(C())"
     "round(C())" "round(C(), 2)" "__import__('math').trunc(C())" "__import__('math').floor(C())" "__import__('math').ceil(C())"]]
   ["inplace-fallback" ["def __init__(self, v): self.v = v" "def __add__(self, o): return C(self.v + o)"]
    ["(c := C(1), d := c, c.__class__)[2].__name__"] [] ["c = C(1)" "d = c" "c += 2" "print(c.v, d.v, c is d)"]]
   ["instancecheck" [] ["isinstance(1, Any)" "issubclass(str, Any)" "isinstance('s', Any)"]
    ["class Meta(type):" "    def __instancecheck__(cls, x): return isinstance(x, int)"
     "    def __subclasscheck__(cls, s): return s is str" "class Any(metaclass=Meta): pass"]]
   ["prepare" [] ["Ordered.order"]
    ["class OrdMeta(type):" "    @classmethod" "    def __prepare__(mcls, name, bases): print('prepare', name); return {'order': []}"
     "    def __new__(mcls, name, bases, ns): ns['order'].append(name); return super().__new__(mcls, name, bases, ns)"
     "class Ordered(metaclass=OrdMeta): pass"]]
   ["match-args" ["__match_args__ = ('a', 'b')" "def __init__(self, a, b): self.a, self.b = a, b"] ["m(C(1, 2))" "m(C(0, 5))"]
    [] ["def m(x):" "    match x:" "        case C(0, b): return ('zero', b)" "        case C(a, b): return (a, b)"]]
   ["await" ["def __await__(self):" "    yield" "    return 'awaited'"] ["drive(main())"]
    [] ["async def main(): return await C()"
        "def drive(co):" "    try:" "        while True: co.send(None)" "    except StopIteration as e:" "        return e.value"]]
   ["async-iter-ctx" ["def __init__(self): self.n = 0" "def __aiter__(self): return self"
                      "async def __anext__(self):" "    self.n += 1" "    if self.n > 2: raise StopAsyncIteration" "    return self.n"
                      "async def __aenter__(self): print('aenter'); return self" "async def __aexit__(self, *a): print('aexit'); return False"]
    ["drive(main())"] []
    ["async def main():" "    out = []" "    async with C() as c:" "        async for x in c: out.append(x)" "    return out"
     "def drive(co):" "    try:" "        while True: co.send(None)" "    except StopIteration as e:" "        return e.value"]]
   ["copy-reduce" ["def __init__(self, v): self.v = v" "def __reduce__(self): return (C, (self.v + 1,))"
                   "def __eq__(self, o): return self.v == o.v"]
    ["__import__('copy').copy(C(1)).v" "__import__('copy').deepcopy(C(1)).v" "__import__('pickle').loads(__import__('pickle').dumps(C(1))).v"]]
   ["del" ["def __del__(self): print('del', self.v)" "def __init__(self, v): self.v = v"]
    ["(lambda: [C(1) for _ in [0]] and None)()"] [] ["x = C(2)" "del x" "print('after del')"]]])

;; every binary operator's method, its reflected and its in-place one, on one class: generated from binops
(def numeric-all
  ["numeric-all"
   (concat ["def __repr__(self): return 'C'"]
           (mapcat (fn [[n _]] [(str "def __" n "__(self, o): return ('" n "', o)")
                                (str "def __r" n "__(self, o): return ('r" n "', o)")
                                (str "def __i" n "__(self, o): return ('i" n "', o)")])
                   binops)
           ["def __eq__(self, o): return 'eq'" "def __ne__(self, o): return 'ne'"])
   (concat (mapcat (fn [[_ op]] [(str "C() " op " 1") (str "1 " op " C()") (str "aug(" (pr-str op) ")")]) binops)
           ["C() == 1" "C() != 1" "1 != C()"])
   []
   ["def aug(op):" "    ns = {'C': C}" "    exec('c = C()\\nc ' + op + '= 1', ns)" "    return ns['c']"]])

(def more-dunders
  [numeric-all
   ["copy-protocol" ["def __init__(self, v): self.v = v" "def __copy__(self): print('copy'); return C(self.v)"
                     "def __deepcopy__(self, memo): print('deepcopy'); return C([self.v])"
                     "def __getstate__(self): return {'v': self.v, 'pickled': True}"
                     "def __setstate__(self, st): self.__dict__.update(st)" "def __getnewargs__(self): return (0,)"]
    ["__import__('copy').copy(C(1)).v" "__import__('copy').deepcopy(C(1)).v"
     "sorted(vars(__import__('pickle').loads(__import__('pickle').dumps(C(5)))).items())" "C(1).__reduce_ex__(2)[0].__name__"]]
   ["buffer" ["def __buffer__(self, flags): print('buffer'); return memoryview(b'xyz')"
              "def __release_buffer__(self, view): print('release')"]
    ["(lambda m: (bytes(m), m.release()))(memoryview(C()))[0]" "bytes(C())"]]
   ["fspath" ["def __fspath__(self): return 'some/path'"] ["__import__('os').fspath(C())" "__import__('os').path.basename(C())"]]
   ["annotations" ["x: int" "y: 'str' = 'v'" "def m(self, a: int) -> str: pass"]
    ["C.__annotations__" "C.m.__annotations__" "sorted(__import__('annotationlib').get_annotations(C))" "C.__annotate__(1)"]]
   ["abc-subclasshook" [] ["issubclass(int, Sized)" "issubclass(list, Sized)" "isinstance([], Sized)" "Impl()" "sorted(Sized.__abstractmethods__)"]
    ["from abc import ABC, abstractmethod" "class Sized(ABC):" "    @abstractmethod" "    def __len__(self): ..."
     "    @classmethod" "    def __subclasshook__(cls, k): return hasattr(k, '__len__')" "class Impl(Sized): pass"]]
   ["type-attributes" ["\"Doc.\"" "class Inner: pass"]
    ["C.__qualname__" "C.Inner.__qualname__" "C.__module__" "C.__doc__" "C.__bases__" "C.__base__" "C.__mro__"
     "C.__type_params__" "[k.__name__ for k in object.__subclasses__() if k is C]" "type(C).__name__" "C.__dict__['__doc__']"]]
   ["exception-attributes" [] ["err().__cause__" "type(err().__context__).__name__" "err().__suppress_context__"
                               "err().__traceback__.tb_frame.f_code.co_name" "err().args"]
    ["def err():" "    try:" "        try:" "            raise KeyError('k')" "        except KeyError:" "            raise ValueError('v')"
     "    except ValueError as e:" "        return e"]]])

(defn dunder-program [[name body calls pre post]]
  (emit (str "datamodel/" name ".py")
        (concat [header (str "# the data model: " name) ""] show-fn
                pre
                (when (seq body) (concat ["class C:"] (map #(str "    " %) body)))
                post
                (map-indexed (fn [i c] (str "show(" i ", lambda: " c ")")) calls))))

;; ---- builtins: [type-name sample-expression [calls on x ...]] ----

(def builtin-tables
  [["str" "'Hello, World ß ǅ 12'"
    ["x.capitalize()" "x.casefold()" "x.center(30, '*')" "x.count('l')" "x.encode()" "x.endswith('12')" "'a\\tb'.expandtabs(4)"
     "x.find('o')" "x.format()" "'{a}{0}'.format(1, a=2)" "'{a}'.format_map({'a': 3})" "x.index('W')" "'ab1'.isalnum()"
     "'ab'.isalpha()" "x.isascii()" "'12'.isdecimal()" "'²'.isdigit()" "'x_1'.isidentifier()" "x.islower()" "'½'.isnumeric()"
     "'\\x00'.isprintable()" "' \\n'.isspace()" "x.istitle()" "x.isupper()" "'-'.join(['a', 'b'])" "x.ljust(25, '.')" "x.lower()"
     "'  x '.lstrip()" "str.maketrans('ab', 'cd')" "x.partition(', ')" "'prefix-x'.removeprefix('prefix-')" "'x.py'.removesuffix('.py')"
     "x.replace('l', 'L', 2)" "x.rfind('o')" "x.rindex('l')" "x.rjust(25)" "x.rpartition(' ')" "x.rsplit(' ', 1)" "' x  '.rstrip()"
     "x.split()" "'a\\nb\\r\\nc'.splitlines(True)" "x.startswith(('He', 'x'))" "'  x '.strip()" "x.swapcase()" "x.title()"
     "x.translate({ord('l'): 'L'})" "x.upper()" "'42'.zfill(6)" "x[::-1]" "x[3:8]" "len(x)" "x * 2" "'%s-%05.1f' % ('a', 2.25)"]]
   ["bytes" "b'Hello, World 12'"
    ["x.capitalize()" "x.center(20, b'*')" "x.count(b'l')" "x.decode()" "x.endswith(b'12')" "b'a\\tb'.expandtabs(4)" "x.find(b'o')"
     "bytes.fromhex('de ad')" "x.hex()" "x.hex(':', 2)" "x.index(b'W')" "x.isalnum()" "x.isalpha()" "x.isascii()" "b'12'.isdigit()"
     "x.islower()" "b' '.isspace()" "x.istitle()" "x.isupper()" "b'-'.join([b'a', b'b'])" "x.ljust(20)" "x.lower()" "b' x'.lstrip()"
     "bytes.maketrans(b'ab', b'cd')" "x.partition(b', ')" "x.removeprefix(b'Hel')" "x.removesuffix(b'12')" "x.replace(b'l', b'L')"
     "x.rfind(b'o')" "x.rindex(b'l')" "x.rjust(20)" "x.rpartition(b' ')" "x.rsplit(None, 1)" "b'x '.rstrip()" "x.split(b',')"
     "b'a\\nb'.splitlines()" "x.startswith(b'He')" "b' x '.strip()" "x.swapcase()" "x.title()" "x.translate(None, b'l')" "x.upper()"
     "b'7'.zfill(3)" "x[0]" "x[1:4]" "list(x[:3])"]]
   ["bytearray" "bytearray(b'abc')"
    ["(x.append(100), x)[1]" "x.copy()" "(x.extend(b'xy'), x)[1]" "(x.insert(0, 65), x)[1]" "x.pop()" "(x.remove(98), x)[1]"
     "(x.reverse(), x)[1]" "(x.clear(), x)[1]" "bytearray.fromhex('00ff')" "x + b'!'" "(x.__setitem__(0, 66), x)[1]"
     "x.upper()" "x.find(b'b')" "x.split(b'b')" "x.decode()" "(x.resize(5), x)[1]" "x.hex()" "x.startswith(b'a')" "x.zfill(5)" "bytearray(b' a ').strip()"]]
   ["list" "[3, 1, 2, 1]"
    ["(x.append(5), x)[1]" "(x.extend([6, 7]), x)[1]" "(x.insert(1, 9), x)[1]" "(x.remove(1), x)[1]" "x.pop()" "x.pop(0)"
     "(x.clear(), x)[1]" "x.index(2)" "x.count(1)" "(x.sort(), x)[1]" "(x.sort(key=lambda v: -v, reverse=True), x)[1]"
     "(x.reverse(), x)[1]" "x.copy()" "x[1:3]" "x[::-1]" "(x.__setitem__(slice(0, 2), [8]), x)[1]" "(x.__delitem__(0), x)[1]"
     "x * 2" "x + [0]" "sorted(x)" "min(x)" "max(x)" "sum(x)" "[1, 2] < [1, 3]"]]
   ["tuple" "(3, 1, 2, 1)" ["x.count(1)" "x.index(2)" "x[1:]" "x + (0,)" "x * 2" "len(x)" "(1, 2) < (1, 2, 0)" "hash(x) == hash((3, 1, 2, 1))"]]
   ["dict" "{'b': 1, 'a': 2}"
    ["(x.clear(), x)[1]" "x.copy()" "dict.fromkeys('ab', 0)" "x.get('a')" "x.get('z', 9)" "list(x.items())" "list(x.keys())"
     "x.pop('a')" "x.pop('z', None)" "x.popitem()" "x.setdefault('c', 3)" "(x.update(c=4), x)[1]" "list(x.values())" "x | {'z': 0}"
     "(x.__ior__({'y': 1}), x)[1]" "list(reversed(x))" "'a' in x" "len(x)" "x == {'a': 2, 'b': 1}" "x['b']" "x['nope']"]]
   ["set" "{3, 1, 2}"
    ["(x.add(4), sorted(x))[1]" "(x.clear(), x)[1]" "sorted(x.copy())" "sorted(x.difference({1}))" "(x.difference_update({1}), sorted(x))[1]"
     "(x.discard(9), sorted(x))[1]" "sorted(x.intersection({1, 2, 9}))" "(x.intersection_update({1}), x)[1]" "x.isdisjoint({7})"
     "x.issubset({1, 2, 3, 4})" "x.issuperset({1})" "x.pop() in {1, 2, 3}" "(x.remove(1), sorted(x))[1]" "(x.remove(9), x)[1]"
     "sorted(x.symmetric_difference({1, 5}))" "(x.symmetric_difference_update({5}), sorted(x))[1]" "sorted(x.union({8}))"
     "(x.update({0}), sorted(x))[1]" "sorted(x | {9})" "sorted(x & {1})" "sorted(x - {1})" "sorted(x ^ {1, 7})" "x <= {1, 2, 3}"]]
   ["frozenset" "frozenset({3, 1, 2})" ["sorted(x.union({4}))" "x.issubset({1, 2, 3})" "hash(x) == hash(frozenset({1, 2, 3}))" "sorted(x - {1})"
                                        "sorted(x.copy())" "sorted(x.difference({1}))" "sorted(x.intersection({2, 9}))" "x.isdisjoint({8})"
                                        "x.issuperset({1, 2})" "sorted(x.symmetric_difference({1, 7}))"]]
   ["int" "12345"
    ["x.as_integer_ratio()" "x.bit_count()" "x.bit_length()" "x.conjugate()" "x.denominator" "x.imag" "x.is_integer()" "x.numerator"
     "x.real" "x.to_bytes(4, 'big')" "x.to_bytes(4, 'little', signed=True)" "int.from_bytes(b'\\x01\\x02', 'big')" "int('ff', 16)"
     "int('0o17', 0)" "int('1_000')" "divmod(x, -7)" "-x // 7" "-x % 7" "pow(x, -1, 97)" "x ** 3" "str(2 ** 100)" "hex(x)"
     "oct(x)" "bin(x)" "format(x, ',')" "format(x, '#x')" "round(x, -2)" "abs(-x)" "int('12a')"]]
   ["float" "2.5"
    ["x.as_integer_ratio()" "x.conjugate()" "float.fromhex('0x1.8p1')" "x.hex()" "x.imag" "x.is_integer()" "x.real" "repr(0.1 + 0.2)"
     "repr(1e16)" "repr(1e-7)" "str(1/3)" "round(2.675, 2)" "round(0.5)" "round(1.5)" "float('nan') != float('nan')" "float('inf')"
     "-0.0" "divmod(x, -1)" "x // 0.7" "x % -0.7" "format(x, '.3e')" "format(1234.5678, ',.2f')" "format(x, '%')" "x ** 0.5"
     "float('1_000.5')" "int(x)" "hash(x) == hash(2.5)" "1e308 * 10" "2.0 ** 1024" "float.from_number(3)" "float.from_number('1')"]]
   ["complex" "(1+2j)" ["x.conjugate()" "x.real" "x.imag" "abs(x)" "x * x" "x / (1-1j)" "complex('3-4j')" "x ** 2" "repr(complex(0, -0.0))" "complex.from_number(2)"]]
   ["bool" "True" ["x + x" "x & False" "x | False" "~x" "int(x)" "str(x)" "x.bit_length()" "isinstance(x, int)" "x.as_integer_ratio()"
                     "x.bit_count()" "x.conjugate()" "(x.denominator, x.numerator, x.real, x.imag)" "bool.from_bytes(b'\\x01')" "x.is_integer()" "x.to_bytes()"]]
   ["range" "range(2, 20, 3)" ["list(x)" "len(x)" "x[2]" "x[1:3]" "x.count(5)" "x.index(8)" "5 in x" "list(reversed(x))" "x == range(2, 18, 3)" "(x.start, x.stop, x.step)"]]
   ["memoryview" "memoryview(b'abcdef')" ["x[1]" "bytes(x[1:3])" "x.tobytes()" "x.tolist()[:2]" "x.hex()" "len(x)" "x.readonly" "bytes(x.cast('B'))"
     "(x.c_contiguous, x.f_contiguous, x.contiguous)" "x.count(97)" "x.index(98)" "(x.format, x.itemsize, x.nbytes, x.ndim, x.shape, x.strides, x.suboffsets)"
     "x.obj" "(x.release(), x.obj)[1]" "x.toreadonly().readonly"]]
   ["slice" "slice(1, 10, 2)" ["x.indices(5)" "x.start" "x.stop" "x.step" "list(range(20))[x]"]]
   ["builtin-functions" "None"
    ["abs(-2)" "all([1, 0])" "any([0, 1])" "ascii('é')" "bin(5)" "callable(len)" "chr(955)" "divmod(17, 5)" "list(enumerate('ab', 1))"
     "list(filter(None, [0, 1, 2]))" "format(3.14159, '.2f')" "getattr(1, 'real')" "hasattr(1, 'nope')" "hex(255)" "isinstance(1, (str, int))"
     "issubclass(bool, int)" "len('abc')" "list(map(abs, [-1, 2]))" "max(3, 9, 2)" "min([4, 1], default=0)" "next(iter([7]))" "oct(8)"
     "ord('a')" "pow(2, 10)" "list(reversed([1, 2]))" "round(3.14159, 3)" "sorted('cab')" "sum([1, 2], 10)" "type(1).__name__"
     "list(zip('ab', [1, 2], strict=True))" "list(zip('ab', [1]))" "repr(object.__new__(object).__class__)" "vars(type('T', (), {'a': 1}))['a']"
     "int.__mro__" "bool.__mro__" "eval('1 + 2')" "(exec('y = 5', g := {}), g['y'])[1]" "compile('1', 'f', 'eval').co_name"
     "print('printed', sep='', end='!\\n')"]]])

;; bytearray shares bytes' methods: the same calls on a bytearray of the same bytes
(def builtin-tables
  (conj builtin-tables
        ["bytearray-shared" "bytearray(b'Hello, World 12')"
         (nth (first (filter #(= "bytes" (first %)) builtin-tables)) 2)]))

(defn builtin-program [[name sample calls]]
  (emit (str "builtins/" name ".py")
        (concat [header (str "# the builtin " name ": each public method on a fresh sample") ""] show-fn
                (map-indexed (fn [i c] (str "show((" i ", " (pr-str c) "), lambda: (lambda x: " c ")(" sample "))")) calls))))

;; ---- constructs: [name lines] ----

(def constructs
  [["module-docstring" ["\"\"\"A docstring.\"\"\"" "print(__doc__)"]]
   ["assign" ["a = b = [1]" "a.append(2)" "print(a, b, a is b)" "x, *y, z = range(5)" "print(x, y, z)" "(p, q), r = (1, 2), 3" "print(p, q, r)"]]
   ["aug-assign" ["n = 5" "n += 1; n -= 2; n *= 3; n //= 2; n %= 4; n **= 3; n <<= 2; n >>= 1; n |= 8; n &= 12; n ^= 1" "print(n)"]]
   ["ann-assign" ["x: int = 1" "y: list[int]" "(z): str = 'z'" "print(x, z, 'y' in dir())" "class K:" "    a: int = 3" "    b: str" "print(K.a, K.__annotations__)"]]
   ["delete" ["a = [1, 2, 3, 4]" "del a[0], a[1:2]" "print(a)" "b = 1" "del b" "print('b' in dir())" "class O: pass" "o = O(); o.x = 1; del o.x; print(vars(o))"]]
   ["if-elif" ["for v in (0, 1, 2):" "    if v == 0:" "        print('zero')" "    elif v == 1:" "        print('one')" "    else:" "        print('other')"]]
   ["while-else" ["i = 0" "while i < 3:" "    i += 1" "    if i == 5: break" "else:" "    print('no break', i)" "while True:" "    i -= 1" "    if i < 0: break" "    if i % 2: continue" "    print('even', i)"]]
   ["for-else" ["for x in [1, 2]:" "    pass" "else:" "    print('done', x)" "for x in range(10):" "    if x == 3: break" "else:" "    print('unreached')" "print(x)"]]
   ["function-def" ["def f(a, /, b=2, *args, c, d=4, **kw) -> tuple:" "    '''doc'''" "    return a, b, args, c, d, sorted(kw.items())"
                    "print(f(1, c=3), f(1, 5, 6, 7, c=8, e=9))" "print(f.__doc__, f.__defaults__, f.__kwdefaults__, f.__annotations__)"
                    "print(f.__code__.co_argcount, f.__code__.co_posonlyargcount, f.__code__.co_kwonlyargcount)"]]
   ["lambda" ["f = lambda x, y=2, *a, k=1, **kw: (x, y, a, k, kw)" "print(f(1), f(1, 3, 4, k=5, z=6))" "print((lambda: 'nullary')())"]]
   ["closures" ["def outer():" "    x = 1" "    def mid():" "        nonlocal x" "        x += 1" "        def inner(): return x" "        return inner" "    return mid" "print(outer()()())"
                "g = 0" "def setg():" "    global g" "    g = 7" "setg(); print(g)"]]
   ["decorators" ["def deco(tag):" "    def wrap(f):" "        def w(*a): return (tag, f(*a))" "        return w" "    return wrap"
                  "@deco('a')" "@deco('b')" "def f(x): return x" "print(f(1))" "@lambda c: c.__name__" "class X: pass" "print(X)"]]
   ["class-def" ["class Base:" "    def who(self): return 'base'" "class Kid(Base):" "    def who(self): return 'kid/' + super().who()"
                 "print(Kid().who(), Kid.__mro__ == (Kid, Base, object), Kid.__qualname__)"
                 "class A: pass" "class B(A): pass" "class C(A): pass" "class D(B, C): pass" "print([k.__name__ for k in D.__mro__])"]]
   ["return-yield" ["def g():" "    x = yield 1" "    y = yield x" "    return y" "it = g()" "print(next(it), it.send('s'))" "try:" "    it.send('r')" "except StopIteration as e:" "    print('return', e.value)"
                    "def h(): yield from g()" "print(list(h()))" "print(list((x * x for x in range(3))))"]]
   ["raise-try" ["def f(n):" "    try:" "        if n == 0: raise ValueError('v')" "        if n == 1: raise KeyError('k') from None" "        return 'ok'"
                 "    except ValueError as e:" "        return ('value', str(e))" "    except (KeyError, IndexError) as e:" "        return ('lookup', repr(e), e.__suppress_context__)"
                 "    else:" "        print('else')" "    finally:" "        print('finally', n)" "for i in range(3): print(f(i))"]]
   ["try-star" ["try:" "    raise ExceptionGroup('g', [ValueError(1), TypeError(2), ValueError(3)])" "except* ValueError as eg:"
                "    print('values', [e.args for e in eg.exceptions])" "except* TypeError as eg:" "    print('types', len(eg.exceptions))"]]
   ["exception-chaining" ["try:" "    try:" "        1 / 0" "    except ZeroDivisionError:" "        raise KeyError('x')" "except KeyError as e:"
                          "    print(type(e.__context__).__name__, e.__cause__, e.__suppress_context__)"
                          "e = ValueError('a'); e.add_note('note'); print(e.__notes__)"
                          "try:" "    raise RuntimeError from OSError(2)" "except RuntimeError as e:" "    print(repr(e.__cause__))"]]
   ["assert" ["assert True, 'never'" "try:" "    assert 1 == 2, ('msg', 3)" "except AssertionError as e:" "    print('assert', e.args)"]]
   ["import" ["import math, os.path as p  # type: ignore[import]" "from collections import OrderedDict as OD, deque" "from json import *" "print(math.floor(2.5), p.basename('a/b'), OD.__name__, deque.__name__, dumps([1]))"
              "import importlib; print(importlib.import_module('string').ascii_lowercase[:3])"]]
   ["global-nonlocal" ["counter = 0" "def inc():" "    global counter" "    counter += 1" "inc(); inc(); print(counter)"
                       "def mk():" "    n = 0" "    def step():" "        nonlocal n" "        n += 1" "        return n" "    return step" "s = mk(); s(); print(s())"]]
   ["pass-break-continue" ["for i in range(6):" "    if i == 1: continue" "    if i == 4: break" "    if i == 2: pass" "    print(i)"]]
   ["with" ["from contextlib import contextmanager" "@contextmanager" "def cm(n):" "    print('enter', n)" "    yield n" "    print('exit', n)"
            "with cm(1) as a, cm(2) as b:" "    print('body', a, b)" "with (cm(3) as c,):" "    print('body', c)"]]
   ["match" ["def m(x):" "    match x:" "        case 0 | 1: return 'small'" "        case [a, *rest] if rest: return ('seq', a, rest)" "        case {'k': v, **rest}: return ('map', v, rest)"
             "        case str() as s: return ('str', s)" "        case float(): return 'float'" "        case None: return 'none'" "        case (1, 2): return 'pair'" "        case _: return 'other'"
             "for v in [0, [1, 2, 3], [1], {'k': 1, 'z': 2}, 'hi', 2.0, None, (1, 2), object]: print(m(v) if v is not object else m(3))"]]
   ["type-alias-params" ["type Pair[T] = tuple[T, T]" "print(Pair.__value__, Pair.__type_params__)"
                         "def first[T: (int, str), *Ts, **P](x: T) -> T: return x" "print(first(1), [p.__name__ for p in first.__type_params__])"
                         "class Box[T = int]:" "    def __init__(self, v: T): self.v = v" "print(Box[str].__origin__.__name__, Box.__type_params__[0].__default__)"]]
   ["expressions" ["a, b = 7, 2" "print(a if a > b else b, (n := a * b), n)" "print([a, *[b, 3]], (*'xy', 1), {**{'a': 1}, 'b': 2}, {1, *{2}})"
                   "print(a < b < 10, a is not None, 'x' not in 'abc', not a, a <= b, a >= b, a and b, a or b, a > b == 2 != 3)" "print(-a, +a, ~a, a ** -1, a // b, a % b, a @ b if False else 'skip')"]]
   ["comprehensions" ["print([x * y for x in range(3) for y in range(3) if x != y])" "print({x % 3 for x in range(10)})" "print({x: x * x for x in range(4) if x})"
                      "print(sum(x for x in range(5)))" "x = 'outer'" "print([x for x in 'ab'], x)" "print([[i for i in range(j)] for j in range(3)])"]]
   ["subscripts-slices" ["s = list(range(10))" "print(s[2], s[-1], s[2:5], s[::3], s[::-2], s[5:2:-1], s[:])" "d = {(1, 2): 'k'}" "print(d[1, 2])"
                         "import itertools" "print(list(itertools.islice('abcdef', 1, None, 2)))" "class S:" "    def __getitem__(self, k): return k" "print(S()[1:2, ::3, ...])"]]
   ["f-strings" ["x, w, name = 3.14159, 10, 'py'" "print(f'{x:.2f}|{x:>{w}.3}|{name!r}|{name = }|{x=:.1f}|{{lit}}')" "print(f'{\"nested\"}' f\"{f'{1 + 1}'}\")"
                 "print(f'''multi\n{name.upper()}''')" "print(F'{3:#x}' rf'\\n{name}')"]]
   ["t-strings" ["from string.templatelib import Template, Interpolation" "name, n = 'py', 41" "t = t'hi {name!s:>5} {n + 1}'" "print(t.strings, [i.expression for i in t.interpolations])"
                 "print([(i.value, i.conversion, i.format_spec) for i in t.interpolations])" "print(type(t).__name__, list(t)[0])"]]
   ["literals" ["print(0x1F, 0o17, 0b101, 1_000, 1e3, 1.5j, 10**25, 0.1, 1e-310, 1e400)" "print('a' 'b', r'\\d', b'\\x00\\xff', u'u', '''tri\nple''')"
                "print(..., None, True, False, NotImplemented)" "print(repr('é\\u0301\\U0001F600'), ascii('é'), '\\N{GREEK SMALL LETTER ALPHA}')"]]
   ["async" ["import asyncio" "async def agen():" "    for i in range(3):" "        yield i" "        await asyncio.sleep(0)"
             "async def main():" "    out = [i async for i in agen()]" "    async with asyncio.timeout(10):" "        async for i in agen(): out.append(i * 10)"
             "    out.append(await asyncio.gather(asyncio.sleep(0, 'a'), asyncio.sleep(0, 'b')))" "    return out" "print(asyncio.run(main()))"]]
   ["builtins-scope" ["print(__name__, type(__builtins__).__name__ in ('module', 'dict'))" "len = lambda x: 'shadowed'" "print(len([1]))" "del len" "print(len([1]))"]]])

(defn construct-program [[name lines]]
  (emit (str "constructs/" name ".py") (concat [header (str "# the construct: " name) ""] lines)))

;; ---- paths: [name lines] ----

(def paths
  [["gen-finally" ["def g():" "    try:" "        yield 1" "        yield 2" "    finally:" "        print('finally')" "it = g()" "print(next(it))" "it.close()" "print('closed')"]]
   ["gen-throw" ["def g():" "    while True:" "        try:" "            yield 'ready'" "        except ValueError as e:" "            print('caught', e)"
                 "it = g(); next(it)" "print(it.throw(ValueError('x')))" "try:" "    it.throw(KeyError('k'))" "except KeyError as e:" "    print('propagated', e)"]]
   ["gen-return-close" ["def g():" "    try:" "        yield 1" "    except GeneratorExit:" "        print('exit')" "        raise" "    return 'r'" "it = g(); next(it); it.close()"
                        "def h():" "    yield 1" "    return 'value'" "it = h(); next(it)" "try: next(it)" "except StopIteration as e: print('stop', e.value)"]]
   ["gen-yield-from-delegation" ["def inner():" "    got = yield 'i1'" "    print('inner got', got)" "    return 'inner-done'"
                                 "def outer():" "    r = yield from inner()" "    print('outer got', r)" "    yield 'o1'"
                                 "it = outer()" "print(next(it))" "print(it.send('s'))"]]
   ["gen-stopiteration-in-gen" ["def g():" "    raise StopIteration" "    yield" "try:" "    next(g())" "except RuntimeError as e:" "    print('RuntimeError', e)"]]
   ["coroutine-send-throw" ["import types" "@types.coroutine" "def ticker():" "    v = yield 'tick'" "    return v"
                            "async def co():" "    try:" "        return await ticker()" "    except KeyError:" "        return 'caught'"
                            "c = co(); print(c.send(None))" "try: c.send('v')" "except StopIteration as e: print(e.value)"
                            "c = co(); c.send(None)" "try: c.throw(KeyError())" "except StopIteration as e: print(e.value)"]]
   ["async-gen-aclose" ["import asyncio" "async def ag():" "    try:" "        yield 1" "        yield 2" "    finally:" "        print('ag finally')"
                        "async def main():" "    g = ag()" "    print(await g.__anext__())" "    await g.aclose()" "    print('aclosed')" "asyncio.run(main())"]]
   ["context-suppress-reraise" ["from contextlib import suppress, ExitStack" "with suppress(KeyError):" "    raise KeyError" "print('suppressed')"
                                "class CM:" "    def __enter__(self): return self" "    def __exit__(self, *a): print('exit', a[0].__name__); return False"
                                "try:" "    with CM(): raise ValueError" "except ValueError: print('reraised')"
                                "with ExitStack() as st:" "    st.callback(print, 'callback 1')" "    st.callback(print, 'callback 2')"]]
   ["finally-overrides" ["def f():" "    try:" "        return 'try'" "    finally:" "        print('finally runs')" "print(f())"
                         "def g():" "    for i in range(3):" "        try:" "            continue" "        finally:" "            print('finally', i)" "g()"]]
   ["except-star-split" ["def raise_group():" "    raise ExceptionGroup('outer', [ValueError(1), ExceptionGroup('inner', [TypeError(2), ValueError(3)])])"
                         "try:" "    try:" "        raise_group()" "    except* ValueError as eg:" "        print('value', eg.exceptions)"
                         "except* TypeError as eg:" "    print('type', [type(e).__name__ for e in eg.exceptions])"
                         "eg = ExceptionGroup('g', [ValueError(1), KeyError(2)])" "m, rest = eg.split(ValueError)" "print(m.exceptions, rest.exceptions)"]]
   ["recursion-limit" ["import sys" "def deep(n): return deep(n + 1)" "try:" "    deep(0)" "except RecursionError as e:" "    print('RecursionError')"]]
   ["uncaught-exception" ["print('before')" "def f(): raise ValueError('uncaught')" "f()"]]
   ["sys-exit" ["import sys" "print('exiting')" "sys.exit(3)"]]])

(defn path-program [[name lines]]
  (emit (str "paths/" name ".py") (concat [header (str "# the path: " name) ""] lines)))

(let [files (concat (map (fn [[n o]] (pair-program n o)) binops)
                    (map (fn [[n o]] (pair-program (str "cmp-" n) o)) cmpops)
                    (map (fn [[n o]] (aug-program n o)) binops)
                    (unary-programs)
                    (map dunder-program (concat dunders more-dunders))
                    (map builtin-program builtin-tables)
                    (map construct-program constructs)
                    (map path-program paths))
      files (doall files)]
  (spit (str out "/MANIFEST") (str (str/join "\n" (sort files)) "\n"))
  (println (str "gen: " (count files) " programs into " out)))

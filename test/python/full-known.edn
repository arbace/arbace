;; The files of repr/python's round trip (bin/repr-python roundtrip, levels 1-3: roundtrip-known.edn; roundtrip --text,
;; levels 4-5: full-known.edn; doc/python/PYTHON-SURVEY.md, "As built: PY2", "As built: PY3") that do not pass every
;; level, by corpus, each with its class (:classes, each with what it is and the decision it rests on). Written by
;; --record, the classes kept; the writer classes a file only by rule (:rejected, :code-lines, :charset) and never
;; writes a guess: a file of no class makes the run exit 3. Read with the Clojure reader.
{:classes
 {:charset
  {:decided "the printer's refusal, by rule; to decide: jrt's single-byte charsets (the DECISION of queue 176)", :what "mode :full's file is in an encoding Arbace's runtime has no charset for (the print's text is right, its bytes cannot be written: KOI8-R, Lib/test's module_koi8_r.py), so levels 4 and 5 are not reached"}
  :rejected
  {:decided "the survey's §5.3 (PYS3 (a)): the read level's reference is CPython's acceptance and message", :what "CPython's ast.parse rejects the file (a deliberately bad file of Lib/test: an unknown or wrong encoding, a character no identifier takes): the read gives (python/error CLASS MSG ...), judged on CPython's class and message (survey §5.3); nothing to print"}}
 :roundtrip
 {:lib-test
  {"Lib/test/encoded_modules/module_koi8_r.py" {:class :charset, :message "failed: the runtime has no charset koi8-r [class charset]"}
   "Lib/test/tokenizedata/bad_coding.py" {:class :rejected, :error SyntaxError, :message "unknown encoding: uft-8"}
   "Lib/test/tokenizedata/bad_coding2.py" {:class :rejected, :error SyntaxError, :message "encoding problem: utf8 with BOM"}
   "Lib/test/tokenizedata/badsyntax_3131.py" {:class :rejected, :error SyntaxError, :message "invalid character '€' (U+20AC)"}
   "Lib/test/tokenizedata/badsyntax_pep3120.py" {:class :rejected, :error SyntaxError, :message "Non-UTF-8 code starting with '\\xf6' on line 1, but no encoding declared; see https://peps.python.org/pep-0263/ for details"}}

(0, '(x.append(5), x)[1]') -> [3, 1, 2, 1, 5]
(1, '(x.extend([6, 7]), x)[1]') -> [3, 1, 2, 1, 6, 7]
(2, '(x.insert(1, 9), x)[1]') -> [3, 9, 1, 2, 1]
(3, '(x.remove(1), x)[1]') -> [3, 2, 1]
(4, 'x.pop()') -> 1
(5, 'x.pop(0)') -> 3
(6, '(x.clear(), x)[1]') -> []
(7, 'x.index(2)') -> 2
(8, 'x.count(1)') -> 2
(9, '(x.sort(), x)[1]') -> [1, 1, 2, 3]
(10, '(x.sort(key=lambda v: -v, reverse=True), x)[1]') -> [1, 1, 2, 3]
(11, '(x.reverse(), x)[1]') -> [1, 2, 1, 3]
(12, 'x.copy()') -> [3, 1, 2, 1]
(13, 'x[1:3]') -> [1, 2]
(14, 'x[::-1]') -> [1, 2, 1, 3]
(15, '(x.__setitem__(slice(0, 2), [8]), x)[1]') -> [8, 2, 1]
(16, '(x.__delitem__(0), x)[1]') -> [1, 2, 1]
(17, 'x * 2') -> [3, 1, 2, 1, 3, 1, 2, 1]
(18, 'x + [0]') -> [3, 1, 2, 1, 0]
(19, 'sorted(x)') -> [1, 1, 2, 3]
(20, 'min(x)') -> 1
(21, 'max(x)') -> 3
(22, 'sum(x)') -> 7
(23, '[1, 2] < [1, 3]') -> True

(0, 'sorted(x.union({4}))') -> [1, 2, 3, 4]
(1, 'x.issubset({1, 2, 3})') -> True
(2, 'hash(x) == hash(frozenset({1, 2, 3}))') -> True
(3, 'sorted(x - {1})') -> [2, 3]
(4, 'sorted(x.copy())') -> [1, 2, 3]
(5, 'sorted(x.difference({1}))') -> [2, 3]
(6, 'sorted(x.intersection({2, 9}))') -> [2]
(7, 'x.isdisjoint({8})') -> True
(8, 'x.issuperset({1, 2})') -> True
(9, 'sorted(x.symmetric_difference({1, 7}))') -> [2, 3, 7]

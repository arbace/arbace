(0, 'x + x') -> 2
(1, 'x & False') -> False
(2, 'x | False') -> True
(3, '~x') -> -2
(4, 'int(x)') -> 1
(5, 'str(x)') -> 'True'
(6, 'x.bit_length()') -> 1
(7, 'isinstance(x, int)') -> True
(8, 'x.as_integer_ratio()') -> (1, 1)
(9, 'x.bit_count()') -> 1
(10, 'x.conjugate()') -> 1
(11, '(x.denominator, x.numerator, x.real, x.imag)') -> (1, 1, 1, 0)
(12, "bool.from_bytes(b'\\x01')") -> True
(13, 'x.is_integer()') -> True
(14, 'x.to_bytes()') -> b'\x01'

(0, '(x.add(4), sorted(x))[1]') -> [1, 2, 3, 4]
(1, '(x.clear(), x)[1]') -> set()
(2, 'sorted(x.copy())') -> [1, 2, 3]
(3, 'sorted(x.difference({1}))') -> [2, 3]
(4, '(x.difference_update({1}), sorted(x))[1]') -> [2, 3]
(5, '(x.discard(9), sorted(x))[1]') -> [1, 2, 3]
(6, 'sorted(x.intersection({1, 2, 9}))') -> [1, 2]
(7, '(x.intersection_update({1}), x)[1]') -> {1}
(8, 'x.isdisjoint({7})') -> True
(9, 'x.issubset({1, 2, 3, 4})') -> True
(10, 'x.issuperset({1})') -> True
(11, 'x.pop() in {1, 2, 3}') -> True
(12, '(x.remove(1), sorted(x))[1]') -> [2, 3]
(13, '(x.remove(9), x)[1]') -> KeyError
(14, 'sorted(x.symmetric_difference({1, 5}))') -> [2, 3, 5]
(15, '(x.symmetric_difference_update({5}), sorted(x))[1]') -> [1, 2, 3, 5]
(16, 'sorted(x.union({8}))') -> [1, 2, 3, 8]
(17, '(x.update({0}), sorted(x))[1]') -> [0, 1, 2, 3]
(18, 'sorted(x | {9})') -> [1, 2, 3, 9]
(19, 'sorted(x & {1})') -> [1]
(20, 'sorted(x - {1})') -> [2, 3]
(21, 'sorted(x ^ {1, 7})') -> [2, 3, 7]
(22, 'x <= {1, 2, 3}') -> True

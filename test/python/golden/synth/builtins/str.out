(0, 'x.capitalize()') -> 'Hello, world ß ǆ 12'
(1, 'x.casefold()') -> 'hello, world ss ǆ 12'
(2, "x.center(30, '*')") -> '*****Hello, World ß ǅ 12******'
(3, "x.count('l')") -> 3
(4, 'x.encode()') -> b'Hello, World \xc3\x9f \xc7\x85 12'
(5, "x.endswith('12')") -> True
(6, "'a\\tb'.expandtabs(4)") -> 'a   b'
(7, "x.find('o')") -> 4
(8, 'x.format()') -> 'Hello, World ß ǅ 12'
(9, "'{a}{0}'.format(1, a=2)") -> '21'
(10, "'{a}'.format_map({'a': 3})") -> '3'
(11, "x.index('W')") -> 7
(12, "'ab1'.isalnum()") -> True
(13, "'ab'.isalpha()") -> True
(14, 'x.isascii()') -> False
(15, "'12'.isdecimal()") -> True
(16, "'²'.isdigit()") -> True
(17, "'x_1'.isidentifier()") -> True
(18, 'x.islower()') -> False
(19, "'½'.isnumeric()") -> True
(20, "'\\x00'.isprintable()") -> False
(21, "' \\n'.isspace()") -> True
(22, 'x.istitle()') -> False
(23, 'x.isupper()') -> False
(24, "'-'.join(['a', 'b'])") -> 'a-b'
(25, "x.ljust(25, '.')") -> 'Hello, World ß ǅ 12......'
(26, 'x.lower()') -> 'hello, world ß ǆ 12'
(27, "'  x '.lstrip()") -> 'x '
(28, "str.maketrans('ab', 'cd')") -> {97: 99, 98: 100}
(29, "x.partition(', ')") -> ('Hello', ', ', 'World ß ǅ 12')
(30, "'prefix-x'.removeprefix('prefix-')") -> 'x'
(31, "'x.py'.removesuffix('.py')") -> 'x'
(32, "x.replace('l', 'L', 2)") -> 'HeLLo, World ß ǅ 12'
(33, "x.rfind('o')") -> 8
(34, "x.rindex('l')") -> 10
(35, 'x.rjust(25)') -> '      Hello, World ß ǅ 12'
(36, "x.rpartition(' ')") -> ('Hello, World ß ǅ', ' ', '12')
(37, "x.rsplit(' ', 1)") -> ['Hello, World ß ǅ', '12']
(38, "' x  '.rstrip()") -> ' x'
(39, 'x.split()') -> ['Hello,', 'World', 'ß', 'ǅ', '12']
(40, "'a\\nb\\r\\nc'.splitlines(True)") -> ['a\n', 'b\r\n', 'c']
(41, "x.startswith(('He', 'x'))") -> True
(42, "'  x '.strip()") -> 'x'
(43, 'x.swapcase()') -> 'hELLO, wORLD SS ǅ 12'
(44, 'x.title()') -> 'Hello, World Ss ǅ 12'
(45, "x.translate({ord('l'): 'L'})") -> 'HeLLo, WorLd ß ǅ 12'
(46, 'x.upper()') -> 'HELLO, WORLD SS Ǆ 12'
(47, "'42'.zfill(6)") -> '000042'
(48, 'x[::-1]') -> '21 ǅ ß dlroW ,olleH'
(49, 'x[3:8]') -> 'lo, W'
(50, 'len(x)') -> 19
(51, 'x * 2') -> 'Hello, World ß ǅ 12Hello, World ß ǅ 12'
(52, "'%s-%05.1f' % ('a', 2.25)") -> 'a-002.2'

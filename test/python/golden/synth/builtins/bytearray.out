(0, '(x.append(100), x)[1]') -> bytearray(b'abcd')
(1, 'x.copy()') -> bytearray(b'abc')
(2, "(x.extend(b'xy'), x)[1]") -> bytearray(b'abcxy')
(3, '(x.insert(0, 65), x)[1]') -> bytearray(b'Aabc')
(4, 'x.pop()') -> 99
(5, '(x.remove(98), x)[1]') -> bytearray(b'ac')
(6, '(x.reverse(), x)[1]') -> bytearray(b'cba')
(7, '(x.clear(), x)[1]') -> bytearray(b'')
(8, "bytearray.fromhex('00ff')") -> bytearray(b'\x00\xff')
(9, "x + b'!'") -> bytearray(b'abc!')
(10, '(x.__setitem__(0, 66), x)[1]') -> bytearray(b'Bbc')
(11, 'x.upper()') -> bytearray(b'ABC')
(12, "x.find(b'b')") -> 1
(13, "x.split(b'b')") -> [bytearray(b'a'), bytearray(b'c')]
(14, 'x.decode()') -> 'abc'
(15, '(x.resize(5), x)[1]') -> bytearray(b'abc\x00\x00')
(16, 'x.hex()') -> '616263'
(17, "x.startswith(b'a')") -> True
(18, 'x.zfill(5)') -> bytearray(b'00abc')
(19, "bytearray(b' a ').strip()") -> bytearray(b'a')

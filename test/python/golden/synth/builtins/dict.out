(0, '(x.clear(), x)[1]') -> {}
(1, 'x.copy()') -> {'b': 1, 'a': 2}
(2, "dict.fromkeys('ab', 0)") -> {'a': 0, 'b': 0}
(3, "x.get('a')") -> 2
(4, "x.get('z', 9)") -> 9
(5, 'list(x.items())') -> [('b', 1), ('a', 2)]
(6, 'list(x.keys())') -> ['b', 'a']
(7, "x.pop('a')") -> 2
(8, "x.pop('z', None)") -> None
(9, 'x.popitem()') -> ('a', 2)
(10, "x.setdefault('c', 3)") -> 3
(11, '(x.update(c=4), x)[1]') -> {'b': 1, 'a': 2, 'c': 4}
(12, 'list(x.values())') -> [1, 2]
(13, "x | {'z': 0}") -> {'b': 1, 'a': 2, 'z': 0}
(14, "(x.__ior__({'y': 1}), x)[1]") -> {'b': 1, 'a': 2, 'y': 1}
(15, 'list(reversed(x))') -> ['a', 'b']
(16, "'a' in x") -> True
(17, 'len(x)') -> 2
(18, "x == {'a': 2, 'b': 1}") -> True
(19, "x['b']") -> 1
(20, "x['nope']") -> KeyError

 {:sha "9b302971dedaa36d3b58292a3f87a5a1c51119538938f81e3761cfa87b1f2541" :lines
  [[[1 49] "expressions: Boolean operations (and, or: the value of the operand that decides, the second operand evaluated only when needed); library stdtypes: Truth Value Testing" #{:ref :lib}
    "49 rows (a, b) over 0, 1, '', 'a', None, [], [0]; false: 0, '', None, []; true: 1, 'a', [0]. a and b is a when a is false (calls [a]) else b (calls [a, b]); a or b is a when a is true (calls [a]) else b (calls [a, b]). Also computed by models/boolean.awk"]
   [50 "expressions: Comparisons (chaining: x < y <= z is x < y and y <= z, y evaluated once)" #{:ref}
    "1 < 2 < 3 True; 3 > 2 > 2 False (2 > 2 fails); 1 == 1.0 == True True (1 == 1.0, 1.0 == True); 'a' < 'b' <= 'b' True"]]}


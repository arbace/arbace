   [4 "compound_stmts: The finally clause" #{:ref} "finally"]
   [[5 6] "compound_stmts: except* clause (each clause handles its subgroup in order)" #{:ref} "OSError group of size 1, then the ValueError group"]
   [7 "expressions: Operator precedence, Binary arithmetic operations, Shifting operations, Binary bitwise operations, Comparisons, Boolean operations, The power operator" #{:ref}
    "a..g = 7, 2, 3, 5, 6, 12, 4. r: (-7 // 2 = -4) ^ (~5 = -6) = 6, | ((6 & 12) % 4 << 1 >> 1 = 0) = 6. r2: 7/2*3 - 5 + (6**2 % 5 = 1) = 5.5 + 1 = 6.5. ok: not (True and True or ...) is False, or (7 in xs False ...) so False. +a is 7"]

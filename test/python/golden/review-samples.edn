;; Review of the six samples (test/python/samples, queue 247). Format as review-constructs.edn. The samples cite doc/python/SPEC.md of the repository for the
;; grammar they exercise; this review reads them against the Python 3.14 Language Reference.
{
 "samples/classes.py"
 {:sha "c9d316e4da7b9144ecd532ffbf390e33cc513a080d69f6f41bf714a7e37b351c" :lines
  [[1 "compound_stmts: Class definitions, Generic classes (PEP 695/696), Type parameter lists; simple_stmts: The type statement; datamodel: Customizing class creation (metaclass keywords reach __new__)" #{:ref :lib}
    "Box(3) is built by Box.__init__ and shown by __repr__; the metaclass's __new__ stores tag='box' in the namespace; __type_params__ is (T, P) (type parameters print by name); Pair.__value__ evaluates to tuple[K, K]; Alias.__name__ is 'Alias'"]
   [2 "compound_stmts: Generic functions (TypeVarTuple, star-annotated *args); expressions: Subscriptions" #{:ref} "first(1, 2) returns a[:1] = (1,); the type parameters are (Ts,)"]
   [3 "datamodel: Special attributes of classes (__mro__: Generic is inserted after Base); simple_stmts: Annotated assignment statements" #{:ref} "Base follows Box in the MRO; Base.x is 0; __annotations__ holds x and z, not the parenthesised (y): str, which is not a simple target"]
   [4 "simple_stmts: Augmented assignment statements, The del statement (attribute)" #{:ref} "after b.v += 1 and del b.v the instance has no attribute v: False"]]}

 "samples/control.py"
 {:sha "77899f8770c23da3f3f940b2312a0e0f60e70924e20dea6769cd60791ec2063a" :lines
  [[1 "compound_stmts: The for statement (else clause runs when the loop is not broken; continue/break/pass)" #{:ref} "xs = [3, 1, 2]: index 0 continues, 1 and 2 pass the else-branch of the if (x > 2 false), no break: 'no break'"]
   [2 "compound_stmts: The while statement (else clause)" #{:ref} "n counts down to 0 and the else runs: while done 0"]

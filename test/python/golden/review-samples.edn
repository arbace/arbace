   [10 "library: os.path.join (posix), collections.OrderedDict repr (3.12+ form), deque repr, math.floor, sys.maxsize" #{:lib :impl} "1; 'a/b' (the host's path separator is '/'); OrderedDict({'a': 1}); deque([1]); floor(pi) = 3; True"]
   [11 "simple_stmts: The del statement (several targets, left to right)" #{:ref} "[1, 2] and {'d': 1}"]]}


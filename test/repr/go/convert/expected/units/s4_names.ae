;; Expected forms of test/repr/go/convert/units/s4_names.go (bin/repr-go test read --regen; reviewed)
(go/file "s4_names.go" :doc "Names spelled like the literals true, false and nil (SPEC §4.4): declared in the package,\nwritten (go/id \"...\") wherever they stand, :init-order and :go/via included (GOI-SPEC GC3).\n" :imports [])
(go/type (go/id "nil") (struct ^int x))
(go/type T (struct (go/id "nil")))
(go/var (go/id "true") (== (go/id "false") (go/id "false")))
(go/var (go/id "false") (== 1 2))
(go/var y ^{:go/via [(go/id "nil")]} (.-x (lit T)))
(go/func f ^int [] (let [^T t (zero T)] ^{:go/via [(go/id "nil")]} (.-x t)))

;; SPEC §12.2, Groups: names join a group only when their types are the same type form with
;; the same type metadata. A func type's parameter and named result types are the names' :tag,
;; a struct type's field tags :go/tag: = ignores metadata, so
;; func(*Ptr, Ptr) and func(*Ptr16, Ptr16) compared equal and printed as one field
;; (go/arbace/expat's ENCODING, 2026-11-08). Each pair below stands on one line of the forms,
;; so only the types decide; the last pair of each kind is the negative control: equal types
;; with equal metadata, grouped.
(ns go.type-identity (:require [arbace.go :as go]))
(go/package identity :path "identity" :files ["s05_type_identity.go"])
(go/file "s05_type_identity.go" :imports [])

(go/type
  [Ptr (* byte)]
  [Ptr16 (* uint16)]
  [ENCODING (struct
    ^{:tag (func [^{:tag (* ENCODING)} enc ^{:tag (* Ptr)} fromP ^Ptr fromLim ^{:tag (* Ptr)} toP ^Ptr toLim] [int])} utf8Convert ^{:tag (func [^{:tag (* ENCODING)} enc ^{:tag (* Ptr)} fromP ^Ptr fromLim ^{:tag (* Ptr16)} toP ^Ptr16 toLim] [int])} utf16Convert
    ^{:tag (func [^int x] [int])} same1 ^{:tag (func [^int x] [int])} same2
    ^{:tag (func [^int x] [^int n])} r1 ^{:tag (func [^int x] [^string n])} r2
    ^{:tag (func [^int x] [^int n])} r3 ^{:tag (func [^int x] [^int n])} r4
    ^{:tag (struct ^{:tag int :go/tag "a"} x)} t1 ^{:tag (struct ^{:tag int :go/tag "b"} x)} t2
    ^{:tag (struct ^{:tag int :go/tag "a"} x)} t3 ^{:tag (struct ^{:tag int :go/tag "a"} x)} t4)])

(go/func Params [^{:tag (func [^int x])} f ^{:tag (func [^string x])} g ^{:tag (func [^int x])} h ^{:tag (func [^int x])} k]
  :results [^{:tag (func [] [^int n])} a ^{:tag (func [] [^bool n])} b]
  (return nil nil))

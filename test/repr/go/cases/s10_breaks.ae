(ns go.breaks (:require [arbace.go :as go])) (go/package breaks :path "breaks" :files ["s10_breaks.go"] :positions :lines) (go/file "s10_breaks.go" :imports [])
^{:go/breaks [[4 13]] :go/end 14} (go/func Valid ^bool [^string s]
  (range [_ r s]
    (switch r
      (case ^{:go/breaks [9]} [\- \. \_ \: \~ \! \$ \& \'
          \( \) \* \+ \, \; \= \%]
        (continue))
      (case [\@]
        (return false))))


  true)


^{:go/breaks [[4 22]] :go/end 23} (go/func Kind ^int [^any x]
  (type-switch x
    (case [int int8
        ^{:line 19} int16]
      (return 1)))

  0)


^{:go/end 28} (go/func Pair [] :results [int string]
  ^{:go/breaks [2]} (return 1
    "two"))


^{:go/end 36} (go/func Multi ^int []

(ns repr.llvm.expect-test
  "The own verdicts' unit tests for LLS38 (the module flags, llvm.ident), LLS39 (visitCallBase's immarg check and
  visitIntrinsicCall's cases; AutoUpgrade's ctlz over a non-integer), LLS40 (the debug info's scopes and fields) and LLS42
  (AutoUpgrade's memory intrinsics with an alignment, the declaration visited before its calls): each case a small module, the kind's context as
  arbace.repr.llvm.mutate attaches it, the verdict and the message fragment arbace.repr.llvm.expect must give (LLS43 (a): the fragments' sizes; the texts of
  llvm-project 23.1.5's Verifier.cpp, Module.cpp and AutoUpgrade.cpp). The negative controls cross one case's verdict with
  another's expectation by the same judge (verdict equal, the fragment in the message): each must fail.
  Run: test/repr/llvm/expect-test.bash (doc/llvm/LLVM-CROP-SURVEY.md, \"As built: LLS38, LLS39\")."
  (:require [arbace.repr.llvm.read :as rd]
            [arbace.repr.llvm.expect :as ex]
            [arbace.repr.llvm.verify :as vf]
            [arbace.repr.llvm.print :as pr]
            [arbace.string :as str]))

(defn- flags-module [& nodes]
  (str "define void @f() {\n  ret void\n}\n!llvm.module.flags = !{"
       (str/join ", " (map #(str "!" %) (range (count nodes)))) "}\n"
       (str/join "" (map-indexed (fn [i n] (str "!" i " = !{" n "}\n")) nodes))))

(def ^:private dbg-module
  (str "define void @f() !dbg !3 {\n  ret void, !dbg !5\n}\n!llvm.dbg.cu = !{!0}\n!llvm.module.flags = !{!2}\n"
       "!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, emissionKind: FullDebug)\n"
       "!1 = !DIFile(filename: \"a.c\", directory: \"/\")\n!2 = !{i32 2, !\"Debug Info Version\", !\"x\"}\n"
       "!3 = distinct !DISubprogram(name: \"f\", scope: !1, file: !1, type: !4, unit: !0, spFlags: DISPFlagDefinition)\n"
       "!4 = !DISubroutineType(types: !{null})\n!5 = !DILocation(line: 1, scope: !3)\n"))

(def ^:private intr-decls
  (str "declare void @llvm.memset.p0.i64(ptr, i8, i64, i1 immarg)\ndeclare void @llvm.lifetime.start.p0(ptr)\n"
       "declare i1 @llvm.is.fpclass.f32(float, i32 immarg)\ndeclare void @llvm.va_start.p0(ptr)\n"))

(def ^:private di-module
  "LLS40 (a): two subprograms, f's variable !10 (in f's retained nodes) and g's !11, a set type !8 over the enumeration !9."
  (str "define void @f(ptr %p) !dbg !3 {\n    #dbg_value(ptr %p, !10, !DIExpression(), !5)\n  ret void, !dbg !5\n}\n"
       "define void @g(ptr %q) !dbg !12 {\n    #dbg_value(ptr %q, !11, !DIExpression(), !13)\n  ret void, !dbg !13\n}\n"
       "!llvm.dbg.cu = !{!0}\n!llvm.module.flags = !{!2}\n"
       "!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, emissionKind: FullDebug)\n"
       "!1 = !DIFile(filename: \"a.c\", directory: \"/\")\n!2 = !{i32 2, !\"Debug Info Version\", i32 3}\n"
       "!3 = distinct !DISubprogram(name: \"f\", scope: !1, file: !1, type: !4, unit: !0, spFlags: DISPFlagDefinition, retainedNodes: !14)\n"
       "!4 = !DISubroutineType(types: !{null})\n!5 = !DILocation(line: 1, scope: !3)\n"
       "!6 = !DIBasicType(name: \"int\", size: 32, encoding: DW_ATE_signed)\n!7 = !DIDerivedType(tag: DW_TAG_pointer_type, baseType: !6, size: 64)\n"
       "!8 = !DIDerivedType(tag: DW_TAG_set_type, baseType: !9, size: 32)\n"
       "!9 = !DICompositeType(tag: DW_TAG_enumeration_type, name: \"e\", file: !1, size: 32, elements: !{})\n"
       "!10 = !DILocalVariable(name: \"p\", arg: 1, scope: !3, file: !1, type: !7)\n"
       "!11 = !DILocalVariable(name: \"q\", arg: 1, scope: !12, file: !1, type: !8)\n"
       "!12 = distinct !DISubprogram(name: \"g\", scope: !1, file: !1, type: !4, unit: !0, spFlags: DISPFlagDefinition)\n"
       "!13 = !DILocation(line: 2, scope: !12)\n!14 = !{!10}\n"))

(def ^:private frag-module
  "LLS43 (a): f's variable !10 (through the typedef !7 to int) and its fragment (0, 16), the artificial !11's fragment (48, 32)
  past its int (no check: V:7443), the global @g's expression !22 (the CU's globals) a fragment (0, 8) of !23 through !7 too,
  the sizes !30 (8), !31 (16), !32 (64), and !12, another variable of f of 16 bits."
  (str "@g = global i32 0, !dbg !22\n"
       "define void @f(i32 %a) !dbg !3 {\n    #dbg_value(i32 %a, !10, !DIExpression(DW_OP_LLVM_fragment, 0, 16), !5)\n"
       "    #dbg_value(i32 %a, !11, !DIExpression(DW_OP_LLVM_fragment, 48, 32), !5)\n  ret void, !dbg !5\n}\n"
       "!llvm.dbg.cu = !{!0}\n!llvm.module.flags = !{!2}\n"
       "!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, emissionKind: FullDebug, globals: !21)\n"
       "!1 = !DIFile(filename: \"a.c\", directory: \"/\")\n!2 = !{i32 2, !\"Debug Info Version\", i32 3}\n"
       "!3 = distinct !DISubprogram(name: \"f\", scope: !1, file: !1, type: !4, unit: !0, spFlags: DISPFlagDefinition)\n"
       "!4 = !DISubroutineType(types: !{null})\n!5 = !DILocation(line: 1, scope: !3)\n"
       "!6 = !DIBasicType(name: \"int\", size: 32, encoding: DW_ATE_signed)\n!7 = !DIDerivedType(tag: DW_TAG_typedef, name: \"T\", file: !1, baseType: !6)\n"
       "!10 = !DILocalVariable(name: \"x\", scope: !3, file: !1, type: !7)\n"
       "!11 = !DILocalVariable(name: \"y\", scope: !3, file: !1, type: !6, flags: DIFlagArtificial)\n"
       "!12 = !DILocalVariable(name: \"z\", scope: !3, file: !1, type: !31)\n"
       "!21 = !{!22}\n!22 = !DIGlobalVariableExpression(var: !23, expr: !DIExpression(DW_OP_LLVM_fragment, 0, 8))\n"
       "!23 = !DIGlobalVariable(name: \"g\", scope: !0, file: !1, line: 1, type: !7, isLocal: false, isDefinition: true)\n"
       "!30 = !DIBasicType(name: \"c\", size: 8, encoding: DW_ATE_signed)\n!31 = !DIBasicType(name: \"s\", size: 16, encoding: DW_ATE_signed)\n"
       "!32 = !DIBasicType(name: \"l\", size: 64, encoding: DW_ATE_signed)\n"))

(defn- md-index [forms id] (first (keep-indexed (fn [i f] (when (and (= 'llvm/meta (first f)) (= (symbol id) (second f))) i)) forms)))

(defn- with-field
  "The forms with the field `k` of the node `id` sent to `to`, and the di-retarget context."
  [forms id k to]
  (let [i (md-index forms id) f (vec (nth forms i)) n (nth f 2)
        n2 (apply list (first n) (mapcat (fn [[fk v]] [fk (if (= (name fk) k) (symbol to) v)]) (partition 2 (rest n))))]
    [(assoc forms i (apply list (assoc f 2 n2))) {:i i :field (keyword k) :to (symbol to)}]))

(defn- with-record-var
  "LLS43 (a): the forms with the first record of the first definition's first block sent to the variable `to`, and the di-record
  context."
  [forms to]
  (let [fi (first (keep-indexed (fn [i f] (when (= 'llvm/define (first f)) i)) forms))
        f (vec (nth forms fi)) bi (inc (.indexOf ^java.util.List f :body)) blocks (nth f bi) b0 (vec (first blocks))
        r (vec (nth b0 2))]
    [(assoc forms fi (apply list (assoc f bi (assoc blocks 0 (apply list (assoc b0 2 (apply list (assoc r 2 (symbol to)))))))))
     {:k 2 :to (symbol to) :head (first r)}]))

(defn- call-module [call-text]
  (str intr-decls "define void @f(ptr %p, float %x) {\n  %a = alloca i32\n  " call-text "\n  ret void\n}\n"))

(def cases
  "[name kind module-text ctx-fn verdict fragment]; ctx-fn gets the forms."
  (let [defn-i (fn [forms] (first (keep-indexed (fn [i f] (when (= 'llvm/define (first f)) i)) forms)))
        at (fn [ii k] (fn [forms] (let [fi (defn-i forms)] {:at [fi 0 ii] :fi fi :k k})))
        flag (fn [_] {:ref :flag})]
    [["flag-behaviour-unexpected" :md-edit (flags-module "i32 99, !\"x\", i32 1") flag :invalid "invalid behavior operand in module flag (unexpected constant)"]
     ["flag-behaviour-not-int" :md-edit (flags-module "!\"b\", !\"x\", i32 1") flag :invalid "invalid behavior operand in module flag (expected constant integer)"]
     ["flag-behaviour-float" :md-edit (flags-module "float 1.0, !\"x\", i32 1") flag :invalid "(expected constant integer)"]
     ["flag-id-not-string" :md-edit (flags-module "i32 1, i32 5, i32 1") flag :invalid "invalid ID operand in module flag (expected metadata string)"]
     ["flag-count" :md-edit (flags-module "i32 1, !\"x\"") flag :invalid "incorrect number of operands in module flag"]
     ["flag-min-i1-true" :md-edit (flags-module "i32 8, !\"PIC Level\", i1 true") flag :invalid "invalid value for 'min' module flag"]
     ["flag-min-negative" :md-edit (flags-module "i32 8, !\"x\", i32 -1") flag :invalid "invalid value for 'min' module flag"]
     ["flag-pic-max-upgraded" :md-edit (flags-module "i32 7, !\"PIC Level\", i32 2") flag :valid nil]
     ["flag-error-any-value" :md-edit (flags-module "i1 true, !\"x\", !\"s\"") flag :valid nil]
     ["flag-max-string" :md-edit (flags-module "i32 7, !\"Dwarf Version\", !\"x\"") flag :invalid "invalid value for 'max' module flag (expected constant integer)"]
     ["flag-require-not-pair" :md-edit (flags-module "i64 3, !\"x\", i32 2") flag :invalid "invalid value for 'require' module flag (expected metadata pair)"]
     ["flag-require-absent" :md-edit (flags-module "i32 3, !\"x\", !{!\"y\", i32 1}") flag :invalid "invalid requirement on flag, flag is not present in module"]
     ["flag-require-value" :md-edit (flags-module "i32 3, !\"x\", !{!\"y\", i32 1}" "i32 1, !\"y\", i32 2") flag :invalid "flag does not have the required value"]
     ["flag-append-not-node" :md-edit (flags-module "i32 5, !\"x\", i32 2") flag :invalid "invalid value for 'append'-type module flag"]
     ["flag-unique" :md-edit (flags-module "i32 1, !\"x\", i32 2" "i32 2, !\"x\", i32 3") flag :invalid "module flag identifiers must be unique"]
     ["flag-wchar" :md-edit (flags-module "i32 1, !\"wchar_size\", !\"x\"") flag :invalid "wchar_size metadata requires constant integer argument"]
     ["flag-div-stripped" :md-edit dbg-module flag :debug "ignoring debug info with an invalid version (0)"]
     ["flag-div-no-debug" :md-edit (flags-module "i32 2, !\"Debug Info Version\", !\"x\"") flag :valid nil]
     ["ident-not-string" :md-edit (str "!llvm.ident = !{!0}\n!0 = !{i32 1}\n") (fn [_] {:ref :ident}) :invalid "invalid value for llvm.ident metadata entry operand"]
     ["arg-memset-size" :intr-arg (call-module "call void @llvm.memset.p0.i64(ptr %p, i8 0, i64 undef, i1 false)") (at 1 2) :valid nil]
     ["arg-memset-immarg" :intr-arg (call-module "call void @llvm.memset.p0.i64(ptr %p, i8 0, i64 4, i1 undef)") (at 1 3) :invalid "immarg operand has non-immediate parameter"]
     ["arg-lifetime" :intr-arg (call-module "call void @llvm.lifetime.start.p0(ptr undef)") (at 1 0) :invalid "llvm.lifetime.start/end can only be used on alloca or poison"]
     ["arg-fpclass-mask" :intr-arg (call-module "%c = call i1 @llvm.is.fpclass.f32(float %x, i32 undef)") (at 1 1) :invalid "immarg operand has non-immediate parameter"]
     ["arg-va-start" :intr-arg (call-module "call void @llvm.va_start.p0(ptr undef)") (at 1 0) :invalid "va_start called in a non-varargs function"]
     ["rename-ctlz-ptr" :intr-rename
      "declare void @llvm.ctlz.i32(ptr)\ndefine void @f(ptr %p) {\n  call void @llvm.ctlz.i32(ptr %p)\n  ret void\n}\n"
      (fn [_] {:fi 0 :to (symbol "g" "llvm.ctlz.i32")}) :invalid "expected any integer or integer vector, but got ptr"]
     ["rename-fpclass-i1-mask" :intr-rename
      "declare i64 @llvm.is.fpclass.f32(i64, i1 immarg)\ndefine i64 @f(i64 %v) {\n  %r = call i64 @llvm.is.fpclass.f32(i64 %v, i1 true)\n  ret i64 %r\n}\n"
      (fn [_] {:fi 0 :to (symbol "g" "llvm.is.fpclass.f32")}) :invalid "expected any fp or fp vector, but got i64"]
     ;; LLS40 (a): the debug info's field rules (a :mutate case: the ctx-fn returns [forms ctx])
     ["retarget-derived-base" :di-retarget di-module (fn [forms] (with-field forms "!7" "baseType" "!9")) :valid nil]
     ["retarget-set-base" :di-retarget di-module (fn [forms] (with-field forms "!8" "baseType" "!7")) :debug "invalid set base type"]
     ["retarget-var-scope-file" :di-retarget di-module (fn [forms] (with-field forms "!10" "scope" "!1")) :debug "invalid retained nodes, retained node is not local"]
     ["retarget-var-scope-other" :di-retarget di-module (fn [forms] (with-field forms "!10" "scope" "!12")) :debug "invalid retained nodes, retained node does not belong to subprogram"]
     ["retarget-sp-scope" :di-retarget di-module (fn [forms] (with-field forms "!12" "scope" "!9")) :valid nil]
     ["retarget-loc-scope" :di-retarget di-module (fn [forms] (with-field forms "!5" "scope" "!12")) :debug "!dbg attachment points at wrong subprogram for function"]
     ;; LLS43 (a): verifyFragmentExpression with the variable's size through its type chain
     ["frag-var-type-small" :di-retarget frag-module (fn [forms] (with-field forms "!10" "type" "!30")) :debug "fragment is larger than or outside of variable"]
     ["frag-var-type-equal" :di-retarget frag-module (fn [forms] (with-field forms "!10" "type" "!31")) :debug "fragment covers entire variable"]
     ["frag-var-type-big" :di-retarget frag-module (fn [forms] (with-field forms "!10" "type" "!32")) :valid nil]
     ["frag-artificial" :di-retarget frag-module (fn [forms] (with-field forms "!11" "type" "!30")) :valid nil]
     ["frag-global-first" :di-retarget frag-module (fn [forms] (with-field forms "!7" "baseType" "!30")) :debug "fragment covers entire variable"]
     ["frag-record-var" :di-record frag-module (fn [forms] (with-record-var forms "!12")) :debug "fragment covers entire variable"]
     ;; LLS42 (a): AutoUpgrade's memory intrinsics with an alignment and the declaration visited before its calls
     ["decl-mem5" :intr-decl
      "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1 immarg, i32)\ndefine void @f(ptr %p, ptr %q) {\n  call void @llvm.memcpy.p0.p0.i64(ptr %p, ptr %q, i64 4, i1 false)\n  ret void\n}\n"
      (fn [forms] {:fi 0 :orig (nth forms 0)}) :valid nil]
     ["decl-mem5-call-type" :intr-decl
      "declare void @llvm.memset.p0.i64(ptr, i8, i64, i1 immarg, i32)\ndefine void @f(ptr %p) {\n  call void @llvm.memset.p0.i64(ptr %p, i16 0, i64 4, i1 false)\n  ret void\n}\n"
      (fn [forms] {:fi 0 :orig (nth forms 0)}) :invalid "Intrinsic called with incompatible signature"]
     ["decl-before-calls-attr" :intr-decl
      "declare void @llvm.lifetime.end.p0(double captures(none))\ndefine void @f() {\n  %a = alloca i32\n  call void @llvm.lifetime.end.p0(ptr %a)\n  ret void\n}\n"
      (fn [forms] {:fi 0 :orig (list 'llvm/declare (second (nth forms 0)) 'void '[[ptr]])}) :invalid "applied to incompatible type!"]
     ["decl-before-calls-sig" :intr-decl
      "declare void @llvm.lifetime.end.p0()\ndefine void @f() {\n  %a = alloca i32\n  call void @llvm.lifetime.end.p0(ptr %a)\n  ret void\n}\n"
      (fn [forms] {:fi 0 :orig (list 'llvm/declare (second (nth forms 0)) 'void '[[ptr]])}) :invalid "intrinsic has incorrect number of args. Expected 1, but got 0"]]))

(def controls
  "[subject reference]: the subject's verdict judged against the reference's expectation, which must fail."
  [["flag-min-i1-true" "flag-max-string"] ["flag-pic-max-upgraded" "flag-min-i1-true"] ["flag-div-stripped" "flag-div-no-debug"]
   ["arg-memset-size" "arg-memset-immarg"] ["arg-lifetime" "arg-va-start"] ["rename-ctlz-ptr" "rename-fpclass-i1-mask"]
   ["retarget-derived-base" "retarget-set-base"] ["retarget-var-scope-file" "retarget-var-scope-other"]
   ["decl-mem5" "decl-mem5-call-type"] ["decl-before-calls-sig" "decl-before-calls-attr"]
   ["frag-var-type-small" "frag-var-type-equal"] ["frag-var-type-big" "frag-global-first"]])

(defn- judge [e verdict frag]
  (and (= (:verdict e) verdict) (or (nil? frag) (str/includes? (str (:msg e)) frag))))

(defn -main
  "[--dump DIR]: also each case's module as DIR/NAME.ll (for Arbace's verifier and, by hand, opt)."
  [& [flag dir]]
  (when (= flag "--dump")
    ;; the mutant's text: a case whose ctx-fn changes the forms (LLS40 (a), LLS43 (a)) printed from them
    (doseq [[nm _ text ctx-fn] cases]
      (let [forms (vec (rd/read-module text)) c (ctx-fn forms)]
        (spit (str dir "/" nm ".ll") (if (vector? c) (pr/print-module (first c)) text)))))
  (let [got (into {} (for [[nm kind text ctx-fn verdict frag] cases]
                       (let [forms (vec (rd/read-module text))
                             c (ctx-fn forms)
                             [forms c] (if (vector? c) c [forms c])
                             e (ex/expect kind forms c forms)]
                         [nm [e verdict frag]])))
        fails (atom 0)]
    (doseq [[nm _] cases :let [[e verdict frag] (got nm)]]
      (if (judge e verdict frag)
        (println "ok  " nm (ex/header :case e))
        (do (swap! fails inc) (println "FAIL" nm "want" verdict frag "got" (ex/header :case e)))))
    (doseq [[s r] controls :let [[e] (got s) [_ v f] (got r)]]
      (if (judge e v f)
        (do (swap! fails inc) (println "FAIL control passes:" s "vs" r))
        (println "control" s "vs" r "fails as it must")))
    (println (str "expect-test: " (count cases) " cases, " (count controls) " controls, " @fails " failing"))
    (when (pos? @fails) (System/exit 1))))

(ns repr.llvm.expect-test
  "The own verdicts' unit tests for LLS38 (the module flags, llvm.ident), LLS39 (visitCallBase's immarg check and
  visitIntrinsicCall's cases; AutoUpgrade's ctlz over a non-integer), LLS40 (the debug info's scopes and fields) and LLS42
  (AutoUpgrade's memory intrinsics with an alignment, the declaration visited before its calls) and round 52 (a getelementptr's flags in
  StripDebugInfo's walk; ex-type's LLParser errors before the Verifier's unknowns, null and globals as scalars): each case a small module, the kind's context as
  arbace.repr.llvm.mutate attaches it, the verdict and the message fragment arbace.repr.llvm.expect must give (LLS43 (a): the fragments' sizes; the texts of
  llvm-project 23.1.5's Verifier.cpp, Module.cpp and AutoUpgrade.cpp). The negative controls cross one case's verdict with
  another's expectation by the same judge (verdict equal, the fragment in the message): each must fail.
  Run: test/repr/llvm/expect-test.bash (doc/llvm/LLVM-CROP-SURVEY.md, \"As built: LLS38, LLS39\")."
  (:require [arbace.repr.llvm.read :as rd]
            [arbace.repr.llvm.expect :as ex]
            [arbace.repr.llvm.verify :as vf]
            [arbace.repr.llvm.print :as pr]
            [arbace.string :as str]))

(defn- flags-module [& nodes]
  (str "define void @f() {\n  ret void\n}\n!llvm.module.flags = !{"
       (str/join ", " (map #(str "!" %) (range (count nodes)))) "}\n"
       (str/join "" (map-indexed (fn [i n] (str "!" i " = !{" n "}\n")) nodes))))

(def ^:private dbg-module
  (str "define void @f() !dbg !3 {\n  ret void, !dbg !5\n}\n!llvm.dbg.cu = !{!0}\n!llvm.module.flags = !{!2}\n"
       "!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, emissionKind: FullDebug)\n"
       "!1 = !DIFile(filename: \"a.c\", directory: \"/\")\n!2 = !{i32 2, !\"Debug Info Version\", !\"x\"}\n"
       "!3 = distinct !DISubprogram(name: \"f\", scope: !1, file: !1, type: !4, unit: !0, spFlags: DISPFlagDefinition)\n"
       "!4 = !DISubroutineType(types: !{null})\n!5 = !DILocation(line: 1, scope: !3)\n"))

(def ^:private intr-decls
  (str "declare void @llvm.memset.p0.i64(ptr, i8, i64, i1 immarg)\ndeclare void @llvm.lifetime.start.p0(ptr)\n"
       "declare i1 @llvm.is.fpclass.f32(float, i32 immarg)\ndeclare void @llvm.va_start.p0(ptr)\n"))

(def ^:private di-module
  "LLS40 (a): two subprograms, f's variable !10 (in f's retained nodes) and g's !11, a set type !8 over the enumeration !9."
  (str "define void @f(ptr %p) !dbg !3 {\n    #dbg_value(ptr %p, !10, !DIExpression(), !5)\n  ret void, !dbg !5\n}\n"
       "define void @g(ptr %q) !dbg !12 {\n    #dbg_value(ptr %q, !11, !DIExpression(), !13)\n  ret void, !dbg !13\n}\n"
       "!llvm.dbg.cu = !{!0}\n!llvm.module.flags = !{!2}\n"
       "!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, emissionKind: FullDebug)\n"
       "!1 = !DIFile(filename: \"a.c\", directory: \"/\")\n!2 = !{i32 2, !\"Debug Info Version\", i32 3}\n"
       "!3 = distinct !DISubprogram(name: \"f\", scope: !1, file: !1, type: !4, unit: !0, spFlags: DISPFlagDefinition, retainedNodes: !14)\n"
       "!4 = !DISubroutineType(types: !{null})\n!5 = !DILocation(line: 1, scope: !3)\n"
       "!6 = !DIBasicType(name: \"int\", size: 32, encoding: DW_ATE_signed)\n!7 = !DIDerivedType(tag: DW_TAG_pointer_type, baseType: !6, size: 64)\n"
       "!8 = !DIDerivedType(tag: DW_TAG_set_type, baseType: !9, size: 32)\n"
       "!9 = !DICompositeType(tag: DW_TAG_enumeration_type, name: \"e\", file: !1, size: 32, elements: !{})\n"
       "!10 = !DILocalVariable(name: \"p\", arg: 1, scope: !3, file: !1, type: !7)\n"
       "!11 = !DILocalVariable(name: \"q\", arg: 1, scope: !12, file: !1, type: !8)\n"
       "!12 = distinct !DISubprogram(name: \"g\", scope: !1, file: !1, type: !4, unit: !0, spFlags: DISPFlagDefinition)\n"
       "!13 = !DILocation(line: 2, scope: !12)\n!14 = !{!10}\n"))

(def ^:private frag-module
  "LLS43 (a): f's variable !10 (through the typedef !7 to int) and its fragment (0, 16), the artificial !11's fragment (48, 32)
  past its int (no check: V:7443), the global @g's expression !22 (the CU's globals) a fragment (0, 8) of !23 through !7 too,
  the sizes !30 (8), !31 (16), !32 (64), and !12, another variable of f of 16 bits."
  (str "@g = global i32 0, !dbg !22\n"
       "define void @f(i32 %a) !dbg !3 {\n    #dbg_value(i32 %a, !10, !DIExpression(DW_OP_LLVM_fragment, 0, 16), !5)\n"
       "    #dbg_value(i32 %a, !11, !DIExpression(DW_OP_LLVM_fragment, 48, 32), !5)\n  ret void, !dbg !5\n}\n"
       "!llvm.dbg.cu = !{!0}\n!llvm.module.flags = !{!2}\n"
       "!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, emissionKind: FullDebug, globals: !21)\n"
       "!1 = !DIFile(filename: \"a.c\", directory: \"/\")\n!2 = !{i32 2, !\"Debug Info Version\", i32 3}\n"
       "!3 = distinct !DISubprogram(name: \"f\", scope: !1, file: !1, type: !4, unit: !0, spFlags: DISPFlagDefinition)\n"
       "!4 = !DISubroutineType(types: !{null})\n!5 = !DILocation(line: 1, scope: !3)\n"
       "!6 = !DIBasicType(name: \"int\", size: 32, encoding: DW_ATE_signed)\n!7 = !DIDerivedType(tag: DW_TAG_typedef, name: \"T\", file: !1, baseType: !6)\n"
       "!10 = !DILocalVariable(name: \"x\", scope: !3, file: !1, type: !7)\n"
       "!11 = !DILocalVariable(name: \"y\", scope: !3, file: !1, type: !6, flags: DIFlagArtificial)\n"
       "!12 = !DILocalVariable(name: \"z\", scope: !3, file: !1, type: !31)\n"
       "!21 = !{!22}\n!22 = !DIGlobalVariableExpression(var: !23, expr: !DIExpression(DW_OP_LLVM_fragment, 0, 8))\n"
       "!23 = !DIGlobalVariable(name: \"g\", scope: !0, file: !1, line: 1, type: !7, isLocal: false, isDefinition: true)\n"
       "!30 = !DIBasicType(name: \"c\", size: 8, encoding: DW_ATE_signed)\n!31 = !DIBasicType(name: \"s\", size: 16, encoding: DW_ATE_signed)\n"
       "!32 = !DIBasicType(name: \"l\", size: 64, encoding: DW_ATE_signed)\n"))

(defn- loop-module
  "LLS46 (b): the global @h's variable !23 (the CU's globals, a DIGlobalVariableExpression !22), a loop id !6 whose operand !7 is a
  DILocation in f's scope (stripDebugLocFromLoopID drops it), and, when `keep` is a metadata attachment, the global's reachable
  node !23 through a plain attachment (StripDebugInfo leaves it)."
  [keep]
  (str "@h = global i32 0" (if keep ", !keep !23" "") "\n"
       "define void @f() !dbg !3 {\n  br label %l\nl:\n  br label %l, !dbg !5, !llvm.loop !6\n}\n"
       "!llvm.dbg.cu = !{!0}\n!llvm.module.flags = !{!2}\n"
       "!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, emissionKind: FullDebug, globals: !21)\n"
       "!1 = !DIFile(filename: \"a.c\", directory: \"/\")\n!2 = !{i32 2, !\"Debug Info Version\", i32 3}\n"
       "!3 = distinct !DISubprogram(name: \"f\", scope: !1, file: !1, type: !4, unit: !0, spFlags: DISPFlagDefinition)\n"
       "!4 = !DISubroutineType(types: !{null})\n!5 = !DILocation(line: 1, scope: !3)\n"
       "!6 = distinct !{!6, !7}\n!7 = !DILocation(line: 2, scope: !3)\n"
       "!21 = !{!22}\n!22 = !DIGlobalVariableExpression(var: !23, expr: !DIExpression())\n"
       "!23 = distinct !DIGlobalVariable(name: \"h\", scope: !0, file: !1, line: 1, type: !24, isLocal: false, isDefinition: true)\n"
       "!24 = !DIBasicType(name: \"int\", size: 32, encoding: DW_ATE_signed)\n"))

(defn- gep-module
  "Round 52: loop-module's f with a getelementptr whose flags (`inbounds nuw`) come before its type and a !dbg after its
  operands: StripDebugInfo's walk reads that instruction's attachments (the expectation threw on it before)."
  []
  (str/replace (loop-module false) "  br label %l\nl:" "  %q = getelementptr inbounds nuw i8, ptr @h, i64 0, !dbg !5\n  br label %l\nl:"))

(def ^:private type-load-text
  "Round 52: ex-type's load with an attachment: the load's type changed to i64 (the mutant), its use reads i32."
  "define i32 @f(ptr %p) {\n  %a = load i64, ptr %p, align 4, !tbaa !0\n  %b = add i32 %a, 1\n  ret i32 %b\n}\n!0 = !{!\"x\"}\n")

(def ^:private type-load-alone-text
  "Round 52: the same load with no use: no LLParser error, the attachment's check the Verifier's (queue 407: a valid access tag,
  whose checks read no type of the access)."
  "define void @f(ptr %p) {\n  %a = load i64, ptr %p, align 4, !tbaa !0\n  ret void\n}\n!0 = !{!1, !1, i64 0}\n!1 = !{!\"int\", !2, i64 0}\n!2 = !{!\"tbaa\"}\n")

(defn- first-inst
  "The first definition's index and the first instruction of `text`'s first definition (ex-type's :orig)."
  [text]
  (let [forms (vec (rd/read-module text))
        fi (first (keep-indexed (fn [i f] (when (= 'llvm/define (first f)) i)) forms))
        f (vec (nth forms fi)) blocks (nth f (inc (.indexOf ^java.util.List f :body)))]
    (nth (vec (first blocks)) 2)))

(defn- md-index [forms id] (first (keep-indexed (fn [i f] (when (and (= 'llvm/meta (first f)) (= (symbol id) (second f))) i)) forms)))

(defn- with-field
  "The forms with the field `k` of the node `id` sent to `to`, and the di-retarget context."
  [forms id k to]
  (let [i (md-index forms id) f (vec (nth forms i)) n (nth f 2)
        n2 (apply list (first n) (mapcat (fn [[fk v]] [fk (if (= (name fk) k) (symbol to) v)]) (partition 2 (rest n))))]
    [(assoc forms i (apply list (assoc f 2 n2))) {:i i :field (keyword k) :to (symbol to)}]))

(defn- with-record-var
  "LLS43 (a): the forms with the first record of the first definition's first block sent to the variable `to`, and the di-record
  context."
  [forms to]
  (let [fi (first (keep-indexed (fn [i f] (when (= 'llvm/define (first f)) i)) forms))
        f (vec (nth forms fi)) bi (inc (.indexOf ^java.util.List f :body)) blocks (nth f bi) b0 (vec (first blocks))
        r (vec (nth b0 2))]
    [(assoc forms fi (apply list (assoc f bi (assoc blocks 0 (apply list (assoc b0 2 (apply list (assoc r 2 (symbol to)))))))))
     {:k 2 :to (symbol to) :head (first r)}]))

(defn- lpad-module
  "Queue 407: f's block lp, the item `y` before its landingpad (the lpadr mutant's change), the invoke's unwind destination."
  [y]
  (str "declare void @g()\ndeclare i32 @p(...)\n"
       "define void @f() personality ptr @p !dbg !3 {\n  invoke void @g()\n          to label %ok unwind label %lp, !dbg !5\nok:\n  ret void, !dbg !5\n"
       "lp:\n" y "\n  %l = landingpad { ptr, i32 }\n          cleanup\n  resume { ptr, i32 } %l, !dbg !5\n}\n"
       "!llvm.dbg.cu = !{!0}\n!llvm.module.flags = !{!2}\n"
       "!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, emissionKind: FullDebug)\n"
       "!1 = !DIFile(filename: \"a.c\", directory: \"/\")\n!2 = !{i32 2, !\"Debug Info Version\", i32 3}\n"
       "!3 = distinct !DISubprogram(name: \"f\", scope: !1, file: !1, type: !4, unit: !0, spFlags: DISPFlagDefinition, retainedNodes: !8)\n"
       "!4 = !DISubroutineType(types: !{null})\n!5 = !DILocation(line: 1, scope: !3)\n"
       "!6 = !DILocalVariable(name: \"x\", scope: !3, file: !1, type: !7)\n!7 = !DIBasicType(name: \"int\", size: 32, encoding: DW_ATE_signed)\n!8 = !{!6}\n"))

(defn- block-module
  "Queue 407: f's lexical block !20 (scope !3), reached first through the first instruction's location !21 (locations allowed)
  when `by-loc`, else only through the record's variable !10 after it (visitDbgVariableRecord's visitMDNode, no locations allowed)."
  [by-loc]
  (str "define void @f(i32 %a) !dbg !3 {\n  %b = add i32 %a, 1, !dbg " (if by-loc "!21" "!5") "\n    #dbg_value(i32 %a, !10, !DIExpression(), !5)\n  ret void, !dbg !5\n}\n"
       "!llvm.dbg.cu = !{!0}\n!llvm.module.flags = !{!2}\n"
       "!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, emissionKind: FullDebug)\n"
       "!1 = !DIFile(filename: \"a.c\", directory: \"/\")\n!2 = !{i32 2, !\"Debug Info Version\", i32 3}\n"
       "!3 = distinct !DISubprogram(name: \"f\", scope: !1, file: !1, type: !4, unit: !0, spFlags: DISPFlagDefinition)\n"
       "!4 = !DISubroutineType(types: !{null})\n!5 = !DILocation(line: 1, scope: !3)\n!6 = !DIBasicType(name: \"int\", size: 32, encoding: DW_ATE_signed)\n"
       "!10 = !DILocalVariable(name: \"x\", scope: !20, file: !1, type: !6)\n"
       "!20 = distinct !DILexicalBlock(scope: !3, file: !1, line: 2)\n!21 = !DILocation(line: 2, scope: !20)\n"))

(defn- gve-module
  "Queue 407: @g's expression !22 in the unit's globals; with `f?` a function whose subprogram reaches the unit first."
  [f?]
  (str "@g = global i32 0, !dbg !22\n"
       (if f? "define void @f() !dbg !3 {\n  ret void, !dbg !5\n}\n" "")
       "!llvm.dbg.cu = !{!0}\n!llvm.module.flags = !{!2}\n"
       "!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, emissionKind: FullDebug, globals: !21)\n"
       "!1 = !DIFile(filename: \"a.c\", directory: \"/\")\n!2 = !{i32 2, !\"Debug Info Version\", i32 3}\n"
       "!3 = distinct !DISubprogram(name: \"f\", scope: !1, file: !1, type: !4, unit: !0, spFlags: DISPFlagDefinition)\n"
       "!4 = !DISubroutineType(types: !{null})\n!5 = !DILocation(line: 1, scope: !3)\n"
       "!21 = !{!22}\n!22 = !DIGlobalVariableExpression(var: !23, expr: !DIExpression())\n"
       "!23 = distinct !DIGlobalVariable(name: \"g\", scope: !0, file: !1, line: 1, type: !24, isLocal: false, isDefinition: true)\n"
       "!24 = !DIBasicType(name: \"int\", size: 32, encoding: DW_ATE_signed)\n"))

(defn- decl-dbg-module
  "Queue 407: a declaration whose !dbg is `n` (the di-attach mutant's change), beside f's debug info."
  [n]
  (str "declare !dbg " n " void @h()\n" (block-module true)))

(defn- call-module [call-text]
  (str intr-decls "define void @f(ptr %p, float %x) {\n  %a = alloca i32\n  " call-text "\n  ret void\n}\n"))

(def cases
  "[name kind module-text ctx-fn verdict fragment]; ctx-fn gets the forms."
  (let [defn-i (fn [forms] (first (keep-indexed (fn [i f] (when (= 'llvm/define (first f)) i)) forms)))
        at (fn [ii k] (fn [forms] (let [fi (defn-i forms)] {:at [fi 0 ii] :fi fi :k k})))
        flag (fn [_] {:ref :flag})]
    [["flag-behaviour-unexpected" :md-edit (flags-module "i32 99, !\"x\", i32 1") flag :invalid "invalid behavior operand in module flag (unexpected constant)"]
     ["flag-behaviour-not-int" :md-edit (flags-module "!\"b\", !\"x\", i32 1") flag :invalid "invalid behavior operand in module flag (expected constant integer)"]
     ["flag-behaviour-float" :md-edit (flags-module "float 1.0, !\"x\", i32 1") flag :invalid "(expected constant integer)"]
     ["flag-id-not-string" :md-edit (flags-module "i32 1, i32 5, i32 1") flag :invalid "invalid ID operand in module flag (expected metadata string)"]
     ["flag-count" :md-edit (flags-module "i32 1, !\"x\"") flag :invalid "incorrect number of operands in module flag"]
     ["flag-min-i1-true" :md-edit (flags-module "i32 8, !\"PIC Level\", i1 true") flag :invalid "invalid value for 'min' module flag"]
     ["flag-min-negative" :md-edit (flags-module "i32 8, !\"x\", i32 -1") flag :invalid "invalid value for 'min' module flag"]
     ["flag-pic-max-upgraded" :md-edit (flags-module "i32 7, !\"PIC Level\", i32 2") flag :valid nil]
     ["flag-error-any-value" :md-edit (flags-module "i1 true, !\"x\", !\"s\"") flag :valid nil]
     ["flag-max-string" :md-edit (flags-module "i32 7, !\"Dwarf Version\", !\"x\"") flag :invalid "invalid value for 'max' module flag (expected constant integer)"]
     ["flag-require-not-pair" :md-edit (flags-module "i64 3, !\"x\", i32 2") flag :invalid "invalid value for 'require' module flag (expected metadata pair)"]
     ["flag-require-absent" :md-edit (flags-module "i32 3, !\"x\", !{!\"y\", i32 1}") flag :invalid "invalid requirement on flag, flag is not present in module"]
     ["flag-require-value" :md-edit (flags-module "i32 3, !\"x\", !{!\"y\", i32 1}" "i32 1, !\"y\", i32 2") flag :invalid "flag does not have the required value"]
     ["flag-append-not-node" :md-edit (flags-module "i32 5, !\"x\", i32 2") flag :invalid "invalid value for 'append'-type module flag"]
     ["flag-unique" :md-edit (flags-module "i32 1, !\"x\", i32 2" "i32 2, !\"x\", i32 3") flag :invalid "module flag identifiers must be unique"]
     ["flag-wchar" :md-edit (flags-module "i32 1, !\"wchar_size\", !\"x\"") flag :invalid "wchar_size metadata requires constant integer argument"]
     ["flag-div-stripped" :md-edit dbg-module flag :debug "ignoring debug info with an invalid version (0)"]
     ["flag-div-no-debug" :md-edit (flags-module "i32 2, !\"Debug Info Version\", !\"x\"") flag :valid nil]
     ["ident-not-string" :md-edit (str "!llvm.ident = !{!0}\n!0 = !{i32 1}\n") (fn [_] {:ref :ident}) :invalid "invalid value for llvm.ident metadata entry operand"]
     ["arg-memset-size" :intr-arg (call-module "call void @llvm.memset.p0.i64(ptr %p, i8 0, i64 undef, i1 false)") (at 1 2) :valid nil]
     ["arg-memset-immarg" :intr-arg (call-module "call void @llvm.memset.p0.i64(ptr %p, i8 0, i64 4, i1 undef)") (at 1 3) :invalid "immarg operand has non-immediate parameter"]
     ["arg-lifetime" :intr-arg (call-module "call void @llvm.lifetime.start.p0(ptr undef)") (at 1 0) :invalid "llvm.lifetime.start/end can only be used on alloca or poison"]
     ["arg-fpclass-mask" :intr-arg (call-module "%c = call i1 @llvm.is.fpclass.f32(float %x, i32 undef)") (at 1 1) :invalid "immarg operand has non-immediate parameter"]
     ["arg-va-start" :intr-arg (call-module "call void @llvm.va_start.p0(ptr undef)") (at 1 0) :invalid "va_start called in a non-varargs function"]
     ["rename-ctlz-ptr" :intr-rename
      "declare void @llvm.ctlz.i32(ptr)\ndefine void @f(ptr %p) {\n  call void @llvm.ctlz.i32(ptr %p)\n  ret void\n}\n"
      (fn [_] {:fi 0 :to (symbol "g" "llvm.ctlz.i32")}) :invalid "expected any integer or integer vector, but got ptr"]
     ["rename-fpclass-i1-mask" :intr-rename
      "declare i64 @llvm.is.fpclass.f32(i64, i1 immarg)\ndefine i64 @f(i64 %v) {\n  %r = call i64 @llvm.is.fpclass.f32(i64 %v, i1 true)\n  ret i64 %r\n}\n"
      (fn [_] {:fi 0 :to (symbol "g" "llvm.is.fpclass.f32")}) :invalid "expected any fp or fp vector, but got i64"]
     ;; queue 407, D335-2 (a): is.fpclass renamed over a mask that is no ConstantInt (the Verifier's unchecked cast, the pin's answer)
     ["rename-fpclass-ptr-mask" :intr-rename
      "@v = global i32 0\ndefine i1 @f(float %x) {\n  %r = call i1 @llvm.is.fpclass.f32(float %x, ptr @v)\n  ret i1 %r\n}\ndeclare i1 @llvm.is.fpclass.f32(float, ptr)\n"
      (fn [_] {:fi 2 :to (symbol "g" "llvm.is.fpclass.f32")}) :invalid "unsupported bits for llvm.is.fpclass test mask"]
     ["rename-fpclass-mask" :intr-rename
      "define i1 @f(float %x) {\n  %r = call i1 @llvm.is.fpclass.f32(float %x, i32 1024)\n  ret i1 %r\n}\ndeclare i1 @llvm.is.fpclass.f32(float, i32 immarg)\n"
      (fn [_] {:fi 1 :to (symbol "g" "llvm.is.fpclass.f32")}) :invalid "unsupported bits for llvm.is.fpclass test mask"]
     ;; LLS40 (a): the debug info's field rules (a :mutate case: the ctx-fn returns [forms ctx])
     ["retarget-derived-base" :di-retarget di-module (fn [forms] (with-field forms "!7" "baseType" "!9")) :valid nil]
     ["retarget-set-base" :di-retarget di-module (fn [forms] (with-field forms "!8" "baseType" "!7")) :debug "invalid set base type"]
     ["retarget-var-scope-file" :di-retarget di-module (fn [forms] (with-field forms "!10" "scope" "!1")) :debug "invalid retained nodes, retained node is not local"]
     ["retarget-var-scope-other" :di-retarget di-module (fn [forms] (with-field forms "!10" "scope" "!12")) :debug "invalid retained nodes, retained node does not belong to subprogram"]
     ["retarget-sp-scope" :di-retarget di-module (fn [forms] (with-field forms "!12" "scope" "!9")) :valid nil]
     ["retarget-loc-scope" :di-retarget di-module (fn [forms] (with-field forms "!5" "scope" "!12")) :debug "!dbg attachment points at wrong subprogram for function"]
     ;; LLS43 (a): verifyFragmentExpression with the variable's size through its type chain
     ["frag-var-type-small" :di-retarget frag-module (fn [forms] (with-field forms "!10" "type" "!30")) :debug "fragment is larger than or outside of variable"]
     ["frag-var-type-equal" :di-retarget frag-module (fn [forms] (with-field forms "!10" "type" "!31")) :debug "fragment covers entire variable"]
     ["frag-var-type-big" :di-retarget frag-module (fn [forms] (with-field forms "!10" "type" "!32")) :valid nil]
     ;; LLS46 (b): a node reached only through a loop id's DILocation is not left by StripDebugInfo (opt: debug); one a plain attachment names is
     ["retarget-gv-file-loop" :di-retarget (loop-module false) (fn [forms] (with-field forms "!23" "file" "!5")) :debug "invalid file"]
     ["retarget-gv-file-kept" :di-retarget (loop-module true) (fn [forms] (with-field forms "!23" "file" "!5")) :invalid "invalid file"]
     ["frag-artificial" :di-retarget frag-module (fn [forms] (with-field forms "!11" "type" "!30")) :valid nil]
     ["frag-global-first" :di-retarget frag-module (fn [forms] (with-field forms "!7" "baseType" "!30")) :debug "fragment covers entire variable"]
     ["frag-record-var" :di-record frag-module (fn [forms] (with-record-var forms "!12")) :debug "fragment covers entire variable"]
     ;; round 52: a getelementptr's flags before its type (StripDebugInfo's walk); ex-type's Verifier-level unknowns after LLParser's
     ;; errors, and the constants LLParser converts (null, a global's name) to a scalar type
     ["retarget-gv-file-gep-nuw" :di-retarget (gep-module) (fn [forms] (with-field forms "!23" "file" "!5")) :debug "invalid file"]
     ["type-load-md-use" :type type-load-text (fn [forms] {:fi 0 :bi 0 :ii 0}) :invalid "'%a' defined with type 'i64' but expected 'i32'"]
     ;; queue 407: TBAA's checks read no type of the access (V:7960): the load alone is valid; a !range's check reads it (left)
     ["type-load-md-alone" :type type-load-alone-text (fn [forms] {:fi 0 :bi 0 :ii 0}) :valid nil]
     ["type-load-range-alone" :type "define void @f(ptr %p) {\n  %a = load i64, ptr %p, align 4, !range !0\n  ret void\n}\n!0 = !{i32 0, i32 4}\n"
      (fn [forms] {:fi 0 :bi 0 :ii 0}) :unknown nil]
     ["type-ret-null" :type "define i64 @f() {\n  ret i64 null\n}\n" (fn [forms] {:fi 0 :bi 0 :ii 0}) :invalid "null must be a pointer type"]
     ["type-ret-int" :type "define i64 @f() {\n  ret i64 0\n}\n" (fn [forms] {:fi 0 :bi 0 :ii 0}) :valid nil]
     ["type-call-global" :type "@x = global i32 0\ndeclare void @g(i64)\ndefine void @f() {\n  call void @g(i64 @x)\n  ret void\n}\n"
      (fn [forms] {:fi 2 :bi 0 :ii 0 :orig (first-inst "@x = global i32 0\ndeclare void @g(ptr)\ndefine void @f() {\n  call void @g(ptr @x)\n  ret void\n}\n")})
      :invalid "global variable reference must have pointer type"]
     ;; queue 407: a store's constant expression read with the new type (LLParser's ValID::t_Constant); a load's or a store's
     ;; attachments whose checks read no type (!dbg, TBAA, !DIAssignID, ...), and nonnull's pointer type
     ["type-store-cexpr" :type "@v = global [2 x ptr] zeroinitializer\ndefine void @f(ptr %p) {\n  store i64 getelementptr (i8, ptr @v, i64 8), ptr %p, align 8\n  ret void\n}\n"
      (fn [forms] {:fi 1 :bi 0 :ii 0}) :invalid "constant expression type mismatch: got type 'ptr' but expected 'i64'"]
     ["type-store-cexpr-same" :type "@v = global [2 x ptr] zeroinitializer\ndefine void @f(ptr %p) {\n  store ptr getelementptr (i8, ptr @v, i64 8), ptr %p, align 8\n  ret void\n}\n"
      (fn [forms] {:fi 1 :bi 0 :ii 0}) :valid nil]
     ["type-store-assign-id" :type (str "define void @f(ptr %p) !dbg !3 {\n  store i32 10, ptr %p, align 1, !tbaa !6, !DIAssignID !7\n  ret void, !dbg !5\n}\n"
                                        "!llvm.dbg.cu = !{!0}\n!llvm.module.flags = !{!2}\n"
                                        "!0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, emissionKind: FullDebug)\n"
                                        "!1 = !DIFile(filename: \"a.c\", directory: \"/\")\n!2 = !{i32 2, !\"Debug Info Version\", i32 3}\n"
                                        "!3 = distinct !DISubprogram(name: \"f\", scope: !1, file: !1, type: !4, unit: !0, spFlags: DISPFlagDefinition)\n"
                                        "!4 = !DISubroutineType(types: !{null})\n!5 = !DILocation(line: 1, scope: !3)\n"
                                        "!6 = !{!8, !8, i64 0}\n!7 = distinct !DIAssignID()\n!8 = !{!\"char\", !9, i64 0}\n!9 = !{!\"tbaa\"}\n")
      (fn [forms] {:fi 0 :bi 0 :ii 0}) :valid nil]
     ["type-load-nonnull" :type "define void @f(ptr %p) {\n  %a = load i64, ptr %p, align 8, !nonnull !0\n  ret void\n}\n!0 = !{}\n"
      (fn [forms] {:fi 0 :bi 0 :ii 0}) :invalid "nonnull applies only to pointer types"]
     ;; queue 407: a debug record moved above the landingpad is the landingpad's (visitDbgRecords), its own result's too; an
     ;; instruction moved there leaves the unwind destination without its pad
     ["lpadr-record" :lpadr (lpad-module "    #dbg_value(i32 0, !6, !DIExpression(), !5)") (fn [forms] {:fi 2 :bi 2 :ii 0}) :valid nil]
     ["lpadr-record-own" :lpadr (lpad-module "    #dbg_value({ ptr, i32 } %l, !6, !DIExpression(), !5)") (fn [forms] {:fi 2 :bi 2 :ii 0}) :valid nil]
     ["lpadr-inst" :lpadr (lpad-module "  %z = add i32 0, 0") (fn [forms] {:fi 2 :bi 2 :ii 0}) :invalid "The unwind destination does not have an exception handling instruction!"]
     ;; queue 407: verifyFunctionAttrs' jumptable (V:2424), a function attribute beside a vector parameter, immarg on a call site
     ;; whose declaration has it (V:3924)
     ["attr-jumptable" :attr-pair "define void @f() jumptable {\n  ret void\n}\n" (fn [_] {:where :fn :fi 0 :added [:jumptable]})
      :invalid "Attribute 'jumptable' requires 'unnamed_addr'"]
     ["attr-jumptable-unnamed" :attr-pair "define void @f() unnamed_addr jumptable {\n  ret void\n}\n" (fn [_] {:where :fn :fi 0 :added [:jumptable]})
      :valid nil]
     ["attr-allockind-vector" :attr-value
      "declare i32 @llvm.vector.reduce.add.v4i32(<4 x i32>)\ndefine i32 @f(<4 x i32> %v) {\n  %r = call i32 @llvm.vector.reduce.add.v4i32(<4 x i32> %v) allockind(\"alloc,free\")\n  ret i32 %r\n}\n"
      (fn [_] {:where :fn :fi 1 :at [1 0 0] :call? true :added [(list :allockind "\"alloc,free\"")]})
      :invalid "'allockind()' requires exactly one of alloc, realloc, and free"]
     ["attr-immarg-decl" :attr-immarg (call-module "call void @llvm.memset.p0.i64(ptr %p, i8 0, i64 4, i1 immarg false)")
      (fn [forms] (let [fi (defn-i forms)] {:where :param :fi fi :at [fi 0 1] :call? true :pi 3 :added [:immarg]})) :valid nil]
     ["attr-immarg-call-only" :attr-immarg (call-module "call void @llvm.memset.p0.i64(ptr %p, i8 0, i64 immarg 4, i1 false)")
      (fn [forms] (let [fi (defn-i forms)] {:where :param :fi fi :at [fi 0 1] :call? true :pi 2 :added [:immarg]}))
      :invalid "immarg may not apply only to call sites"]
     ;; queue 407: memcpy's declaration remangled (its length i1), its calls of four arguments: UpgradeIntrinsicCall's DefaultCase,
     ;; the call's type not the new declaration's
     ["decl-memcpy-remangled" :intr-decl
      "define void @f(ptr %p, ptr %q) {\n  call void @llvm.memcpy.p0.p0.i64(ptr %p, ptr %q, i64 4, i1 false)\n  ret void\n}\ndeclare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i1, i1 immarg)\n"
      (fn [forms] {:fi 1 :orig (list 'llvm/declare (second (nth forms 1)) 'void '[[ptr] [ptr] [i64] [i1 :immarg]])}) :invalid "Intrinsic called with incompatible signature"]
     ["decl-memcpy-remangled-mem5" :intr-decl
      "define void @f(ptr %p, ptr %q) {\n  call void @llvm.memcpy.p0.p0.i64(ptr %p, ptr %q, i64 4, i32 1, i1 false)\n  ret void\n}\ndeclare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i1, i1 immarg)\n"
      (fn [forms] {:fi 1 :orig (list 'llvm/declare (second (nth forms 1)) 'void '[[ptr] [ptr] [i64] [i1 :immarg]])}) :unknown nil]
     ;; queue 407: a lexical block's file (unread, V:1608) sent to a location: allowed where the block is first reached with
     ;; locations allowed (V:983); a unit's global variable expression's variable sent to a location (D335-2 (a)'s cast);
     ;; a declaration's !dbg sent to a uniqued node of another kind (V:3202's isDistinct, then visitMDNode)
     ["retarget-block-file-loc" :di-retarget (block-module true) (fn [forms] (with-field forms "!20" "file" "!5")) :valid nil]
     ["retarget-block-file-loc-no" :di-retarget (block-module false) (fn [forms] (with-field forms "!20" "file" "!5")) :debug "DILocation not allowed within this metadata node"]
     ["retarget-gve-var-loc" :di-retarget (gve-module true) (fn [forms] (with-field forms "!22" "var" "!5")) :debug "function-local variables are not allowed in a DICompileUnit's global variables list"]
     ["retarget-gve-var-loc-nofn" :di-retarget (gve-module false) (fn [forms] (with-field forms "!22" "var" "!5")) :unknown nil]
     ["attach-decl-uniqued" :di-attach (decl-dbg-module "!4") (fn [_] {:case :fn :fi 0}) :valid nil]
     ["attach-decl-distinct" :di-attach (decl-dbg-module "!20") (fn [_] {:case :fn :fi 0}) :debug "function declaration may only have a unique !dbg attachment"]
     ;; LLS42 (a): AutoUpgrade's memory intrinsics with an alignment and the declaration visited before its calls
     ["decl-mem5" :intr-decl
      "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1 immarg, i32)\ndefine void @f(ptr %p, ptr %q) {\n  call void @llvm.memcpy.p0.p0.i64(ptr %p, ptr %q, i64 4, i1 false)\n  ret void\n}\n"
      (fn [forms] {:fi 0 :orig (nth forms 0)}) :valid nil]
     ["decl-mem5-call-type" :intr-decl
      "declare void @llvm.memset.p0.i64(ptr, i8, i64, i1 immarg, i32)\ndefine void @f(ptr %p) {\n  call void @llvm.memset.p0.i64(ptr %p, i16 0, i64 4, i1 false)\n  ret void\n}\n"
      (fn [forms] {:fi 0 :orig (nth forms 0)}) :invalid "Intrinsic called with incompatible signature"]
     ["decl-before-calls-attr" :intr-decl
      "declare void @llvm.lifetime.end.p0(double captures(none))\ndefine void @f() {\n  %a = alloca i32\n  call void @llvm.lifetime.end.p0(ptr %a)\n  ret void\n}\n"
      (fn [forms] {:fi 0 :orig (list 'llvm/declare (second (nth forms 0)) 'void '[[ptr]])}) :invalid "applied to incompatible type!"]
     ["decl-before-calls-sig" :intr-decl
      "declare void @llvm.lifetime.end.p0()\ndefine void @f() {\n  %a = alloca i32\n  call void @llvm.lifetime.end.p0(ptr %a)\n  ret void\n}\n"
      (fn [forms] {:fi 0 :orig (list 'llvm/declare (second (nth forms 0)) 'void '[[ptr]])}) :invalid "intrinsic has incorrect number of args. Expected 1, but got 0"]
     ;; n-llvm-indep: verifyMustTailCall's ABI attributes (getParameterABIAttributes) and a callee of any spelling; an intrinsic's
     ;; bundles by visitCallBase's loop unless the intrinsic's own checks read them; a personality no instruction needs
     ["musttail-abi-same" :musttail "declare void @g(ptr)\ndefine void @f(ptr align 8 %p) {\n  musttail call void @g(ptr nonnull %p)\n  ret void\n}\n"
      (at 0 nil) :valid nil]
     ["musttail-abi-byval" :musttail "declare void @g(ptr byval(i32))\ndefine void @f(ptr byval(i32) %p) {\n  musttail call void @g(ptr %p)\n  ret void\n}\n"
      (at 0 nil) :invalid "mismatched ABI impacting function attributes"]
     ["musttail-abi-align" :musttail "declare void @g(ptr)\ndefine void @f(ptr byval(i32) align 8 %p) {\n  musttail call void @g(ptr byval(i32) align 4 %p)\n  ret void\n}\n"
      (at 0 nil) :invalid "mismatched ABI impacting function attributes"]
     ["musttail-quoted" :musttail "declare i32 @\"q x\"(i32)\ndefine void @f(i32 %p) {\n  %r = musttail call i32 @\"q x\"(i32 %p)\n  ret void\n}\n"
      (at 0 nil) :invalid "mismatched return types"]
     ["bundle-intr-deopt" :bundle (call-module "call void @llvm.lifetime.start.p0(ptr %a) [ \"deopt\"(), \"deopt\"() ]")
      (fn [forms] (let [fi (defn-i forms)] {:at [fi 0 1] :fi fi :bs [["deopt"] ["deopt"]]})) :invalid "Multiple deopt operand bundles"]
     ["bundle-intr-foo" :bundle (call-module "call void @llvm.lifetime.start.p0(ptr %a) [ \"foo\"(i32 1) ]")
      (fn [forms] (let [fi (defn-i forms)] {:at [fi 0 1] :fi fi :bs [["foo" '[i32 1]]]})) :valid nil]
     ["bundle-assume-foo" :bundle "declare void @llvm.assume(i1)\ndefine void @f() {\n  call void @llvm.assume(i1 true) [ \"foo\"(i32 1) ]\n  ret void\n}\n"
      (fn [forms] {:at [1 0 0] :fi 1 :bs [["foo" '[i32 1]]]}) :unknown nil]
     ["personality-none" :personality "declare i32 @p(...)\ndefine void @f() personality ptr @p {\n  ret void\n}\n"
      (fn [forms] {:fi 1 :drop-personality true}) :valid nil]
     ["personality-resume" :personality "declare i32 @p(...)\ndefine void @f() personality ptr @p {\n  resume { ptr, i32 } poison\n}\n"
      (fn [forms] {:fi 1 :drop-personality true}) :invalid "ResumeInst needs to be in a function with a personality."]]))

(def controls
  "[subject reference]: the subject's verdict judged against the reference's expectation, which must fail."
  [["flag-min-i1-true" "flag-max-string"] ["flag-pic-max-upgraded" "flag-min-i1-true"] ["flag-div-stripped" "flag-div-no-debug"]
   ["arg-memset-size" "arg-memset-immarg"] ["arg-lifetime" "arg-va-start"] ["rename-ctlz-ptr" "rename-fpclass-i1-mask"]
   ["retarget-derived-base" "retarget-set-base"] ["retarget-var-scope-file" "retarget-var-scope-other"]
   ["decl-mem5" "decl-mem5-call-type"] ["decl-before-calls-sig" "decl-before-calls-attr"]
   ["retarget-gv-file-loop" "retarget-gv-file-kept"] ["type-load-md-alone" "type-load-md-use"] ["type-ret-int" "type-ret-null"] ["frag-var-type-small" "frag-var-type-equal"] ["frag-var-type-big" "frag-global-first"]
   ["musttail-abi-same" "musttail-abi-byval"] ["bundle-intr-foo" "bundle-intr-deopt"] ["personality-none" "personality-resume"]
   ;; queue 407
   ["type-store-cexpr-same" "type-store-cexpr"] ["type-load-range-alone" "type-load-md-alone"] ["type-store-assign-id" "type-load-nonnull"]
   ["lpadr-record-own" "lpadr-inst"] ["attr-jumptable-unnamed" "attr-jumptable"] ["attr-immarg-decl" "attr-immarg-call-only"]
   ["decl-memcpy-remangled-mem5" "decl-memcpy-remangled"] ["attr-allockind-vector" "attr-immarg-decl"]
   ["retarget-block-file-loc" "retarget-block-file-loc-no"] ["retarget-gve-var-loc-nofn" "retarget-gve-var-loc"]
   ["attach-decl-uniqued" "attach-decl-distinct"] ["rename-fpclass-ptr-mask" "rename-ctlz-ptr"]])

(defn- judge [e verdict frag]
  (and (= (:verdict e) verdict) (or (nil? frag) (str/includes? (str (:msg e)) frag))))

(defn -main
  "[--dump DIR]: also each case's module as DIR/NAME.ll (for Arbace's verifier and, by hand, opt)."
  [& [flag dir]]
  (when (= flag "--dump")
    ;; the mutant's text: a case whose ctx-fn changes the forms (LLS40 (a), LLS43 (a)) printed from them
    (doseq [[nm _ text ctx-fn] cases]
      (let [forms (vec (rd/read-module text)) c (ctx-fn forms)]
        (spit (str dir "/" nm ".ll") (if (vector? c) (pr/print-module (first c)) text)))))
  (let [got (into {} (for [[nm kind text ctx-fn verdict frag] cases]
                       (let [forms (vec (rd/read-module text))
                             c (ctx-fn forms)
                             [forms c] (if (vector? c) c [forms c])
                             e (ex/expect kind forms c forms)]
                         [nm [e verdict frag]])))
        fails (atom 0)]
    (doseq [[nm _] cases :let [[e verdict frag] (got nm)]]
      (if (judge e verdict frag)
        (println "ok  " nm (ex/header :case e))
        (do (swap! fails inc) (println "FAIL" nm "want" verdict frag "got" (ex/header :case e)))))
    (doseq [[s r] controls :let [[e] (got s) [_ v f] (got r)]]
      (if (judge e v f)
        (do (swap! fails inc) (println "FAIL control passes:" s "vs" r))
        (println "control" s "vs" r "fails as it must")))
    (println (str "expect-test: " (count cases) " cases, " (count controls) " controls, " @fails " failing"))
    (when (pos? @fails) (System/exit 1))))

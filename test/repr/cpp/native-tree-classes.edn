;; The classes of the native tree's read differences (bin/repr-cpp native-check --tree, arbace.repr.cpp.tcheck, doc/cpp/NATIVE.md §9):
;; [CLASS REGEX] in order, the first whose regex finds a match in a difference's detail line (its kind and what is missing,
;; extra or differs; a clang value first, then the native one) gives its class. A difference is READ when the converter's forms
;; change with it; each class is a fact of clang's Sema the parser does not compute and the converter does not need (it writes
;; the construct's text, or reads the same through another node), listed with the files of test/repr/cpp/native-tree-known.edn.
[[:conversion-function "kind clang \"CXXMemberCallExpr\" native \"CXXFunctionalCastExpr\"|^wrapper (CXXMemberCallExpr|MemberExpr)|^missing (MemberExpr|CXXMemberCallExpr)"]
 [:operator-call "CXXOperatorCallExpr"]
 [:dependent-member "CXXDependentScopeMemberExpr|^native lacks member"]
 [:coroutine "CoroutineBodyStmt|^wrapper CompoundStmt"]
 [:template-instances "^missing (TemplateArgument|FunctionDecl|CXXConstructorDecl)"]
 [:abbreviated-template "TemplateTypeParmDecl\"|FunctionTemplateDecl\" native|native lacks isImplicit|^extra (ParmVarDecl|CompoundStmt|CXXConstructorDecl)"]
 [:range-for "^missing VarDecl \\(implicit\\)|^extra VarDecl|^missing BinaryOperator"]
 [:init-list-form "^extra (InitListExpr|IntegerLiteral|ImplicitValueInitExpr)|array_filler|^missing (IntegerLiteral|FloatingLiteral|CXXDefaultInitExpr)"]
 [:implicit-construction "CXXConstructExpr|^missing CXXDefaultArgExpr|native lacks list|ParenListExpr|^extra (CXXFunctionalCastExpr|DeclRefExpr)|^missing CXXFunctionalCastExpr|CXXTemporaryObjectExpr"]
 [:member-access "^missing CXXThisExpr|^extra MemberExpr"]
 [:macro-spelling "spellingLoc|assertion failed"]
 [:builtin-signature "_Nonnull"]
 [:pragma-range "range.end.tokLen"]
 [:attributes "NativeAttr|^missing [A-Za-z]+Attr"]
 [:unresolved-lookup "^native lacks name|UnresolvedLookupExpr|CXXPseudoDestructorExpr"]
 [:gnu-vector "vector_size"]
 [:friend-template "kind clang \"CXXMethodDecl\" native \"FunctionTemplateDecl\"|^extra (TemplateTypeParmDecl|FunctionDecl)"]]

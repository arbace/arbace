;; The files of the C++ token check (bin/repr-cpp pp-check; doc/cpp/CPP-SURVEY.md, "As built: CX2") whose answers
;; are not the compilers': at :pp the stream's tokens are not g++ -E -P's (test/repr/cpp/pp-gxx.sha256), at :lex the
;; raw tokens are not clang's (test/repr/cpp/lex-clang.sha256), each with its class. Written by
;; bin/repr-cpp pp-check --record-known, the classes kept. Read with the Clojure reader.
;; Since pp-ref (doc/cpp/CPP-SURVEY.md, "As built: pp-ref"): :pp-own and :lex-own, the files whose answers are not the own
;; reference's (REPR_CPP_PP_JUDGE=own: GCC 15.2.0's libcpp behind tools/ppref), each with its class; :ref, the reference's
;; answers that are not the records' (bin/repr-cpp pp-check --fidelity, the oracle tier's), each with its level and class.
{:classes
 {:gxx-rejects "g++ -E rejects the file (a pedantic error, an option or a character set it refuses, a header unit): the port reads it, as the compilers' preprocessors agree on its tokens"
  :modules-ts "a -fmodules-ts file: g++ -E looks the imported modules up and rewrites the directives (import \"/abs/path\";), the port reads import <h>; as one header-name token as C++20 says (the lexical check)"
  :named-ucn "C++23's named universal character escape \\N{NAME} (N3366) in an identifier: clang lexes it, the port does not"
  :non-xid-utf8 "valid UTF-8 characters that are no identifier's (C++23's -pedantic-errors test): libcpp lexes the run as one identifier and diagnoses it, clang's raw lexer and the port give each character an unknown token of its own; at :pp the file's stream is judged by the raw tokens (g++ -E is no reference, CP261 (a)), which differ so"
  :not-cxx "not a C++ file (libstdc++'s Makefile.am): clang's raw lexer reads it differently from the port at an apostrophe"
  :raw-udl-suffix "an identifier touching a string or character literal (\"text\"MACRO): libcpp's raw lexing takes it as the literal's user-defined suffix unless it names a macro (lex.cc's is_macro_not_literal_suffix) and the raw lexing runs no #define, where clang's raw lexer and the port leave a suffix without its underscore apart; at :pp libcpp knows the macro and splits as the port does"
  :target-option "an option for a target other than the host's (-march=...): g++ rejects the file"
  :unterminated-raw-string "an unterminated raw string at the file's end: libcpp's token ends at its line's end, clang's and the port's at the file's (an error test)"}
 :pp
 {:gxx-dg
  {"pr60969.C" {:class :target-option}
   "vect/pr99149.cc" {:class :target-option}}}
 :lex
 {:gxx-dg
  {"cpp23/named-universal-char-escape2.C" {:class :named-ucn}}
  :libstdcxx-headers
  {"Makefile.am" {:class :not-cxx}}}
 :pp-own
 {:gxx-dg
  {"cpp23/Winvalid-utf8-11.C" {:class :non-xid-utf8}}}
 :lex-own
 {:cpp-lexical
  {"errors2.cpp" {:class :unterminated-raw-string}
   "udl-cxx11.cpp" {:class :raw-udl-suffix}
   "udl.cpp" {:class :raw-udl-suffix}}
  :gxx-dg
  {"cpp0x/udlit-extended-id-1.C" {:class :raw-udl-suffix}
   "cpp23/Winvalid-utf8-11.C" {:class :non-xid-utf8}}}
 :ref
 {:cpp-lexical
  {"errors2.cpp" {:level :lex, :class :unterminated-raw-string}
   "modules-ts.cpp" {:level :pp, :class :modules-ts}
   "udl-cxx11.cpp" {:level :lex, :class :raw-udl-suffix}
   "udl.cpp" {:level :lex, :class :raw-udl-suffix}}
  :gxx-dg
  {"modules/macro-4_d.C" {:level :pp, :class :modules-ts}
   "modules/auto-3_b.C" {:level :pp, :class :modules-ts}
   "abi/empty15.C" {:level :pp, :class :gxx-rejects}
   "cpp23/Winvalid-utf8-11.C" {:level :lex, :class :non-xid-utf8}
   "pr60969.C" {:level :pp, :class :target-option}
   "modules/tpl-tpl-merge-1_b.C" {:level :pp, :class :modules-ts}
   "abi/empty25.C" {:level :pp, :class :gxx-rejects}
   "modules/legacy-2_d.C" {:level :pp, :class :modules-ts}
   "modules/lambda-7_b.C" {:level :pp, :class :modules-ts}
   "ext/arm-fp16/arm-fp16-ops-1.C" {:level :pp, :class :target-option}
   "modules/builtin-4_b.C" {:level :pp, :class :modules-ts}
   "modules/atom-preamble-3.C" {:level :pp, :class :modules-ts}
   "cpp23/named-universal-char-escape2.C" {:level :lex, :class :named-ucn}
   "modules/cpp-2_c.C" {:level :pp, :class :modules-ts}
   "modules/class-10_b.C" {:level :pp, :class :modules-ts}
   "vect/pr99149.cc" {:level :pp, :class :target-option}
   "modules/ben-1_b.C" {:level :pp, :class :modules-ts}
   "modules/xtreme-header-4_c.C" {:level :pp, :class :modules-ts}
   "modules/depreport-2_b.C" {:level :pp, :class :modules-ts}
   "modules/merge-13_b.C" {:level :pp, :class :modules-ts}
   "modules/alias-1_c.C" {:level :pp, :class :modules-ts}
   "ext/dllexport4.C" {:level :pp, :class :target-option}
   "modules/stat-mem-1_b.C" {:level :pp, :class :modules-ts}
   "header.C" {:level :pp, :class :gxx-rejects}
   "cpp0x/udlit-extended-id-1.C" {:level :lex, :class :raw-udl-suffix}
   "modules/concept-5_b.C" {:level :pp, :class :modules-ts}
   "modules/lto-2_b.C" {:level :pp, :class :modules-ts}
   "modules/tls-1_b.C" {:level :pp, :class :modules-ts}
   "modules/cpp-11.C" {:level :pp, :class :modules-ts}}
  :libstdcxx-headers
  {"Makefile.am" {:level :lex, :class :not-cxx}}}}

;; The files of the C++ token check (bin/repr-cpp pp-check; doc/cpp/CPP-SURVEY.md, "As built: CX2") whose answers
;; are not the compilers': at :pp the stream's tokens are not g++ -E -P's (test/repr/cpp/pp-gxx.sha256), at :lex the
;; raw tokens are not clang's (test/repr/cpp/lex-clang.sha256), each with its class. Written by
;; bin/repr-cpp pp-check --record-known, the classes kept. Read with the Clojure reader.
{:classes
 {:gxx-rejects "g++ -E rejects the file (a pedantic error, an option or a character set it refuses, a header unit): the port reads it, as the compilers' preprocessors agree on its tokens"
  :modules-ts "a -fmodules-ts file: g++ -E looks the imported modules up and rewrites the directives (import \"/abs/path\";), the port reads import <h>; as one header-name token as C++20 says (the lexical check)"
  :named-ucn "C++23's named universal character escape \\N{NAME} (N3366) in an identifier: clang lexes it, the port does not"
  :not-cxx "not a C++ file (libstdc++'s Makefile.am): clang's raw lexer reads it differently from the port at an apostrophe"
  :target-option "an option for a target other than the host's (-march=...): g++ rejects the file"}
 :pp
 {:cpp-lexical
  {"modules-ts.cpp" {:class :modules-ts}}
  :gxx-dg
  {"modules/macro-4_d.C" {:class :modules-ts}
   "modules/auto-3_b.C" {:class :modules-ts}
   "abi/empty15.C" {:class :gxx-rejects}
   "cpp23/Winvalid-utf8-11.C" {:class :gxx-rejects}
   "pr60969.C" {:class :target-option}
   "modules/tpl-tpl-merge-1_b.C" {:class :modules-ts}
   "abi/empty25.C" {:class :gxx-rejects}
   "modules/legacy-2_d.C" {:class :modules-ts}
   "modules/lambda-7_b.C" {:class :modules-ts}
   "ext/arm-fp16/arm-fp16-ops-1.C" {:class :gxx-rejects}
   "modules/builtin-4_b.C" {:class :modules-ts}
   "modules/atom-preamble-3.C" {:class :modules-ts}
   "modules/cpp-2_c.C" {:class :modules-ts}
   "cpp/ucnid-1.C" {:class :gxx-rejects}
   "modules/class-10_b.C" {:class :modules-ts}
   "vect/pr99149.cc" {:class :target-option}
   "modules/ben-1_b.C" {:class :modules-ts}
   "modules/xtreme-header-4_c.C" {:class :modules-ts}
   "modules/depreport-2_b.C" {:class :modules-ts}
   "modules/merge-13_b.C" {:class :modules-ts}
   "modules/alias-1_c.C" {:class :modules-ts}
   "ext/dllexport4.C" {:class :gxx-rejects}
   "modules/stat-mem-1_b.C" {:class :modules-ts}
   "header.C" {:class :gxx-rejects}
   "modules/concept-5_b.C" {:class :modules-ts}
   "modules/lto-2_b.C" {:class :modules-ts}
   "modules/tls-1_b.C" {:class :modules-ts}
   "modules/cpp-11.C" {:class :modules-ts}}}
 :lex
 {:gxx-dg
  {"cpp23/named-universal-char-escape2.C" {:class :named-ucn}}
  :libstdcxx-headers
  {"Makefile.am" {:class :not-cxx}}}}

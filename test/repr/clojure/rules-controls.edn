;; repr/clojure's rules' negative controls (doc/GATE-SURVEY.md, GTS81 (a); "As built: GTS81 (a), Clojure's and Go's last
;; families"): the family "repr/clojure's one-way rules" of bin/reap (test/reap/cells.edn), the claim of each rule of
;; arbace.repr.clojure.rules (:way :reversible or :one-way) judged by arbace.repr.clojure.rules/round-trip (read by the
;; rules, printed back, byte for byte), the judge of print_test's samples. One crossed pair a rule: the SUBJECT, a text
;; the rule rewrites and which comes back, printed back and judged against the REFERENCE's text, which must differ
;; (rules/control-verdict). bin/repr-clojure check's unit tests (test/repr/clojure/print_test.ae, deftest controls) judge
;; them: a control that passes fails the check; one whose rule does not rewrite its subject, or whose subject does not
;; come back, fails it too (a vacuous control). No control is a sample of the unit tests.
;;   :id         the name
;;   :rule       the rule's :id
;;   :ctx        the file's context (default a .clj read into a .ae: {:kind :clj :to-ae true :features #{:clj}})
;;   :subject    the Clojure text judged
;;   :reference  the text its printed text is judged against
[{:id "control/rename" :rule :rename
  :subject "(ns a.b (:require [clojure.string :as s]))\n;; clojure.set\n"
  :reference "(ns a.c (:require [clojure.set :as t]))\n"}
 {:id "control/proxy-methods" :rule :proxy-methods
  :subject "(.__getClojureFnMappings p)" :reference "(.__updateClojureFnMappings p)"}
 {:id "control/core-names" :rule :core-names
  :subject "(ns a\n  (:require b))\n(defn ^:private return [])\n"
  :reference "(ns a\n  (:require b))\n(defmacro ^{:m 1} switch [])\n"}
 {:id "control/security-manager" :rule :security-manager
  :subject "(SecurityManager.)" :reference "(SecurityManager/x)"}
 {:id "control/reader-conditionals" :rule :reader-conditionals :ctx {:kind :cljc :to-ae true :full true :features #{:clj}}
  :subject "(f #?(:cljs 2 :clj 1))" :reference "(g #?(:cljs 3 :clj 4))"}]

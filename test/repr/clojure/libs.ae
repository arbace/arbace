;; repr/clojure's library check (bin/repr-clojure check --libs, doc/REPR-CLOJURE.md): the test
;; libraries of Clojure's suite (test.check, test.generative, tools.namespace, data.generators,
;; with tools.reader and java.classpath) and a library with a data_readers.cljc, translated by
;; repr/clojure into .ae files, loaded and run on Arbace. The output is deterministic (fixed seeds) and must be the same on
;; the JVM build and on the Go build; the last line says whether every check held.

(require '[clojure.test.check :as tc]
         '[clojure.test.check.generators :as gen]
         '[clojure.test.check.properties :as prop]
         '[clojure.test.check.clojure-test :refer [defspec]]
         '[clojure.data.generators :as dg]
         '[clojure.tools.namespace.dependency :as dep]
         '[clojure.tools.namespace.parse :as parse]
         '[clojure.tools.namespace.track :as track]
         '[clojure.tools.reader :as reader]
         '[clojure.tools.reader.edn :as edn]
         '[clojure.test.generative :as tgen]
         '[clojure.test.generative.runner :as runner]
         '[arbace.test :as t])

(def checks (atom []))
(defn check [label ok? & show]
  (swap! checks conj [label (boolean ok?)])
  (apply prn label (if ok? :ok :FAILED) show))

;; a data_readers.cljc translated into data_readers.ae (bin/repr-clojure check writes the library): its
;; tag is known from the start, and reads once its namespace is loaded
(require 'repr-clojure-readers.point)
(check :data-readers (= {:x 1 :y 2 :s "1,2" :ns "arbace.string"} #repr-clojure/point [1 2])
       (contains? *data-readers* 'repr-clojure/point) #repr-clojure/point [1 2])

;; test.check: a property that holds, one that fails and shrinks, values from a fixed seed
(let [r (tc/quick-check 300 (prop/for-all [v (gen/vector gen/small-integer)]
                              (= (sort v) (sort (reverse v))))
                        :seed 42)]
  (check :test.check/pass (:pass? r) (select-keys r [:pass? :num-tests :seed])))
(let [r (tc/quick-check 300 (prop/for-all [v (gen/vector gen/nat)] (< (count v) 4)) :seed 7)]
  (check :test.check/shrink (and (false? (:pass? r)) (= [[0 0 0 0]] (-> r :shrunk :smallest)))
         (select-keys r [:pass? :num-tests :fail]) (-> r :shrunk (select-keys [:smallest :depth]))))
(check :test.check/generate true
       (gen/generate (gen/vector (gen/tuple gen/keyword gen/large-integer gen/string-alphanumeric) 3) 30 1234))
(defspec spec-reverse 50 (prop/for-all [v (gen/vector gen/boolean)] (= v (reverse (reverse v)))))
(let [r (binding [t/*report-counters* (ref t/*initial-report-counters*)]
          (with-out-str (t/test-var #'spec-reverse))
          @t/*report-counters*)]
  (check :test.check/defspec (and (pos? (:pass r)) (zero? (:fail r)) (zero? (:error r))) r))

;; data.generators, on a fixed Random
(binding [dg/*rnd* (java.util.Random. 42)]
  (check :data.generators true
         (vec (repeatedly 4 dg/int)) (dg/string) (dg/vec dg/long 3) (dg/one-of :a :b :c)
         (dg/shuffle (range 8))))

;; tools.reader and its EDN reader
(check :tools.reader (= '(defn f [x] (clojure.core/seq x)) (reader/read-string "(defn f [x] (clojure.core/seq x))"))
       (reader/read-string "#{1 2 [3 {:a \\b}]}"))
(check :tools.reader/syntax-quote
       (= '(arbace.core/seq user/x) (eval (binding [*ns* (the-ns 'user)] (reader/read-string "`(seq x)")))))
(check :tools.reader.edn (= {:a [1 2.5 "s" #{nil}]} (edn/read-string "{:a [1 2.5 \"s\" #{nil}]}")))

;; tools.namespace: ns declarations parsed, a dependency graph, a tracker
(let [decl (parse/read-ns-decl (java.io.PushbackReader.
                                 (java.io.StringReader.
                                   "(ns a.b (:require [c.d :as d] [e.f :refer [g]]) (:import java.io.File))")))
      deps (parse/deps-from-ns-decl decl)
      g (-> (dep/graph) (dep/depend 'a 'b) (dep/depend 'b 'c) (dep/depend 'a 'c) (dep/depend 'd 'a))
      tr (track/add (track/tracker) {'x #{'y} 'y #{'z}})]
  (check :tools.namespace/parse (= '#{c.d e.f} deps) deps)
  (check :tools.namespace/dependency (= '[c b a d] (vec (dep/topo-sort g)))
         (vec (dep/topo-sort g)) (dep/transitive-dependencies g 'd))
  (check :tools.namespace/track (= '[y x] (vec (::track/load tr))) (::track/load tr)))

;; test.generative: a spec's inputs from a fixed seed, and a short run
(tgen/defspec gen-sorted
  (fn [v] (sort v))
  [^{:tag (vec int 5)} v]
  (assert (= (count %) (count v)))
  (assert (apply <= %)))
(let [test (first (runner/get-tests #'gen-sorted))
      ins (binding [clojure.data.generators/*rnd* (java.util.Random. 9)]
            (doall (take 3 (runner/inputs test))))]
  (check :test.generative/inputs (= 3 (count ins)) ins)
  (check :test.generative/apply (every? #(apply gen-sorted %) ins)))
(let [r (runner/run-suite {:nthreads 2 :msec 300 :progress (fn [])} (runner/get-tests #'gen-sorted))]
  (check :test.generative/run-suite (and (zero? (:failures r)) (pos? (:iters r))) (dissoc r :iters)))

(let [failed (remove second @checks)]
  (println (if (empty? failed) "repr-clojure libs: all" "repr-clojure libs: FAILED") (count @checks) "checks"
           (if (empty? failed) "passed" (mapv first failed))))
(shutdown-agents)

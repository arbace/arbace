;; repr/clojure's round trip's negative controls (doc/GATE-SURVEY.md, GTS81 (a); "As built: GTS81 (a), Clojure's and Go's
;; last families"): one crossed pair a corpus of bin/repr-clojure check --roundtrip, both files coming back byte for byte
;; in that corpus (neither in test/repr/clojure/roundtrip-known.edn nor a .cljc's one-way reading). What comes back of the
;; SUBJECT is judged by the round trip's own comparison (arbace.repr.clojure/control-verdict: byte for byte, the
;; difference at its first differing line, then the known entries' judge known-matches?) against the REFERENCE's
;; original, which must differ and not be excused. A control that passes fails the run (exit 1, "CONTROL FAILED"); one
;; whose files the run lacks (--only, a corpus left) is left ("CONTROL left"). No control is a row of the known file or
;; its :counts: the controls add no file to a corpus (the files' paths as the differences name them, a library's as
;; JAR-NAME/path).
;;   :id         the name
;;   :corpus     the corpus (bin/lib/repr-clojure/check's rt, --corpus)
;;   :subject    the file whose round trip's text is judged
;;   :reference  the file whose original it is judged against
[{:id "control/frozen-set-vs-string" :corpus :frozen :subject "set.clj" :reference "string.clj"}
 {:id "control/suite-keep-ext-data-vs-string" :corpus :suite-keep-ext
  :subject "test/clojure/test_clojure/data.clj" :reference "test/clojure/test_clojure/string.clj"}
 {:id "control/suite-ae-data-vs-string" :corpus :suite-ae
  :subject "test/clojure/test_clojure/data.clj" :reference "test/clojure/test_clojure/string.clj"}
 {:id "control/suite-full-data-vs-string" :corpus :suite-full
  :subject "test/clojure/test_clojure/data.clj" :reference "test/clojure/test_clojure/string.clj"}
 {:id "control/libs-keep-ext-edn-vs-file" :corpus :libs-keep-ext
  :subject "tools.reader-1.6.0/clojure/tools/reader/edn.clj" :reference "tools.namespace-1.5.1/clojure/tools/namespace/file.clj"}
 {:id "control/libs-ae-edn-vs-file" :corpus :libs-ae
  :subject "tools.reader-1.6.0/clojure/tools/reader/edn.clj" :reference "tools.namespace-1.5.1/clojure/tools/namespace/file.clj"}
 {:id "control/libs-full-edn-vs-file" :corpus :libs-full
  :subject "tools.reader-1.6.0/clojure/tools/reader/edn.clj" :reference "tools.namespace-1.5.1/clojure/tools/namespace/file.clj"}
 {:id "control/arbace-set-vs-walk" :corpus :arbace :subject "set.ae" :reference "walk.ae"}]

;; The classes of C++'s lowering check (bin/cppi lower-check: the lowered C compiled by gcc -O0 and run, the second judge before
;; ci; doc/cpp/LLVM.md §9; test/cpp/lower-known.edn's), the eval cell's check beside (CX10; doc/cpp/CPP-SURVEY.md, "As built: CX10
;; (write-ahead)"), in test/goi/divergences.edn's format. A case is NAME, its reason "CLASS: OUTCOME" (bin/reap's reader
;; :cpp-lower). No file is in a class today (lower-known.edn is empty, test/cpp/lower-results.edn all :pass). Read with the
;; Clojure reader.
[
 {:id :uncaught-cleanups
  :title "an uncaught exception runs cleanups that print before std::terminate"
  :kind :design
  :why "an uncaught exception runs the cleanups that print before std::terminate (the pending-flag model has no search phase, LLVM.md §8)"
  :decided "CP7 (the pending flag); the kind CX10's"
  :match [#"^[a-z]+ uncaught-cleanups:"]}
 {:id :native-callback-throw
  :title "an exception thrown through a native frame of the C library"
  :kind :deferred
  :why "an exception thrown through a native frame of the C library (qsort, pthread_once, atexit): native code does not test the pending flag (LLVM.md §8); CP160 (b) for atexit, at_quick_exit and __cxa_atexit, the rest until C5 lowers musl"
  :decided "CP160 (b); the kind CX10's"
  :match [#"^[a-z]+ native-callback-throw:"]}
 {:id :refused
  :title "the lowering refuses the construct"
  :kind :deferred
  :why "the lowering refuses the construct (:inline-asm, :vector, :intrinsic, :coroutine, :datalayout, :atomic ...): each a later piece of arbace.cpp.lower"
  :decided "CX6; the kind CX10's"
  :match [#"^[a-z]+ (inline-asm|vector|intrinsic|coroutine|datalayout|atomic|refused):"]}
]

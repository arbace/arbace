;; The effect of g++'s options on its predefined macros (bin/repr-cpp pp-check --record): for a standard and the
;; options the reference is given (a file's dg-options but the ones that write files), the lines added to
;; test/cpp/host/predefined/gxx/STD.h (#define, and #undef of what the options remove). Read with the Clojure reader.
{"c++11 -std=c++11" ""
 "c++20 -std=c++2a" ""
 "c++20 -std=c++2a -fcontracts" "#define __cpp_contracts 201906L\n#define __cpp_contracts_literal_semantics 201906L\n#define __cpp_contracts_roles 201906L\n"
 "gnu++17 -O2" "#undef __NO_INLINE__\n#define _FORTIFY_SOURCE 2\n#define __OPTIMIZE__ 1\n"
 "gnu++17 -O2 -Wall -Wsystem-headers" "#undef __NO_INLINE__\n#define _FORTIFY_SOURCE 2\n#define __OPTIMIZE__ 1\n"
 "gnu++17 -O2 -Wno-psabi -w" "#undef __NO_INLINE__\n#define _FORTIFY_SOURCE 2\n#define __OPTIMIZE__ 1\n"
 "gnu++17 -O2 -Woverflow" "#undef __NO_INLINE__\n#define _FORTIFY_SOURCE 2\n#define __OPTIMIZE__ 1\n"
 "gnu++17 -O2 -fnon-call-exceptions" "#undef __NO_INLINE__\n#define _FORTIFY_SOURCE 2\n#define __OPTIMIZE__ 1\n"
 "gnu++17 -Wconversion-null" ""
 "gnu++17 -Wno-c++11-extensions" ""
 "gnu++17 -Wno-placement-new -Wno-analyzer-use-of-uninitialized-value" ""
 "gnu++17 -Wno-system-headers -w" ""
 "gnu++17 -fexceptions -fnon-call-exceptions -O2" "#undef __NO_INLINE__\n#define _FORTIFY_SOURCE 2\n#define __OPTIMIZE__ 1\n"
 "gnu++17 -flto -Wuninitialized -O1" "#undef __NO_INLINE__\n#define _FORTIFY_SOURCE 2\n#define __OPTIMIZE__ 1\n"
 "gnu++17 -fmodules-ts" "#define __cpp_modules 201810L\n"
 "gnu++17 -fno-elide-constructors" ""
 "gnu++17 -fno-inline -Wtautological-compare -O2" "#define _FORTIFY_SOURCE 2\n#define __OPTIMIZE__ 1\n"
 "gnu++17 -w" ""}

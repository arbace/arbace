;; queue 601 (group 4): the C++ front end's Unicode normalization data, arbace/cpp/nfcdata.ae, generated from the Unicode Character
;; Database 16.0.0's UnicodeData.txt and DerivedNormalizationProps.txt as pinned by test/scheme/ucd.edn (fetched into the main
;; checkout's .tmp/scheme/ucd-16.0.0, each file checked against its SHA-256 there), by the generator repr/scheme's normalization data
;; is made by (arbace.repr.scheme.ucd/normalization, UAX #15's definitions): its D (full canonical decompositions), C (primary
;; composites) and N (canonical combining classes) lines, the compatibility ones (K) left out: P1949R7's identifiers are judged by
;; NFC alone. `gen DIR OUT` writes the file, `check DIR FILE` regenerates it and compares byte for byte. Read with the Clojure reader.
(ns cpp.nfcdata
  (:require [arbace.repr.scheme.ucd :as ucd] [arbace.string :as str]))

(defn text ^String [^String dir]
  (let [norm (ucd/normalization dir)
        lines (remove #(str/starts-with? % "K ") (str/split-lines (:text norm)))]
    (str ";; The C++ front end's Unicode normalization data (P1949R7's NFC identifiers, arbace.cpp.nfc), generated by test/cpp/nfcdata.ae\n"
         ";; from the Unicode Character Database 16.0.0's UnicodeData.txt and DerivedNormalizationProps.txt (pinned by test/scheme/ucd.edn)\n"
         ";; through arbace.repr.scheme.ucd/normalization; `test/cpp/nfcdata.ae check` regenerates and compares. Do not edit. One entry per\n"
         ";; line: D CP X.. the full canonical decomposition (Hangul syllables algorithmic, not listed); C CP A B the primary composite of\n"
         ";; A B; N CCC R.. the code points (ranges LO-HI) of canonical combining class CCC. Read with the Clojure reader.\n"
         "(ns arbace.cpp.nfcdata)\n\n"
         "(def data\n  " (pr-str (str (str/join "\n" lines) "\n")) ")\n")))

(defn -main [verb dir out]
  (let [t (text dir)]
    (case verb
      "gen" (do (spit out t) (println "nfcdata: wrote" out (count t) "chars"))
      "check" (let [ok (= t (slurp out))] (println "nfcdata:" (if ok "the committed file regenerates byte for byte" "DIFFERS")) (System/exit (if ok 0 1))))))

(apply -main *command-line-args*)

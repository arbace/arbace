;; C++'s read level's divergences for repr/cpp's token check (doc/cpp/CPP-SURVEY.md, "As built: CX2", "As built: CX10
;; (write-ahead)"; bin/repr-cpp pp-check): the classes of test/repr/cpp/pp-check-known.edn (CX10, generated from its :classes,
;; their texts; the kinds chosen at CX10: what the compilers settle against each other or a file outside C++ by design, what
;; the port should close deferred), in test/goi/divergences.edn's format. A case is CORPUS/NAME, its reason "CLASS: the class's
;; text" (bin/reap's reader :c-known with :id-sep "/"); a file listed at :pp and :lex one non-pass (:per-file). The dg check's
;; classes are CX9's, test/cpp/divergences-dg.edn. Read with the Clojure reader.
[
 {:id :gxx-rejects
  :title "g++ -E rejects the file; the port reads it, as the compilers' preprocessors agree on its tokens"
  :kind :design
  :why "g++ -E rejects the file (a pedantic error, an option or a character set it refuses, a header unit): the port reads it, as the compilers' preprocessors agree on its tokens (CX2)"
  :decided "CX2; the kind CX10's"
  :match [#"^known gxx-rejects:"]}
 {:id :modules-ts
  :title "a -fmodules-ts file: g++ -E rewrites the import directives, the port reads them as C++20 says"
  :kind :design
  :why "a -fmodules-ts file: g++ -E looks the imported modules up and rewrites the directives (import \"/abs/path\";), the port reads import <h>; as one header-name token as C++20 says (the lexical check); modules beyond a single TU are CP13's"
  :decided "CX2, CP13; the kind CX10's"
  :match [#"^known modules-ts:"]}
 {:id :named-ucn
  :title "C++23's named universal character escape \\N{NAME} in an identifier: clang lexes it, the port does not"
  :kind :deferred
  :why "C++23's named universal character escape \\N{NAME} (N3366) in an identifier: clang lexes it, the port does not (a table of Unicode's names to add to the lexer)"
  :decided "CX2; the kind CX10's"
  :match [#"^known named-ucn:"]}
 {:id :not-cxx
  :title "not a C++ file (libstdc++'s Makefile.am)"
  :kind :design
  :why "not a C++ file (libstdc++'s Makefile.am, in the headers' corpus): clang's raw lexer reads it differently from the port at an apostrophe"
  :decided "CX2; the kind CX10's"
  :match [#"^known not-cxx:"]}
 {:id :target-option
  :title "an option for a target other than the host's (-march=...): g++ rejects the file"
  :kind :design
  :why "an option for a target other than the host's (-march=...): g++ rejects the file, so it has no reference stream"
  :decided "CX2; the kind CX10's"
  :match [#"^known target-option:"]}
]

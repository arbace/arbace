;; The drivers of g++.dg's directories (review 196's finding 2): g++.dg/dg.exp runs the files of every directory but those that
;; hold an .exp of their own (find-cxx-tests); a file is run by the .exp of its nearest directory that has one (gcc 15.2.0's
;; gcc/testsuite/g++.dg/**/*.exp, read). :runner :g++-dg-runtest (g++-dg.exp: the standard list), :once (dg-test once, no
;; standard but the flags'), :gcc-dg-runtest (gcc-dg.exp: the torture list, its first entry -O0, no standard list), :modules (modules.exp's module-init: 17 2a 2b), :unmodelled
;; (the driver's steps are not modelled: its files are unsupported); :flags the default-extra-flags (replaced by a file's
;; dg-options, as DejaGnu's dg-test does), :torture the first torture option. "" is g++.dg itself. Read with the Clojure reader.
{"" {:runner :g++-dg-runtest :flags ["-pedantic-errors" "-Wno-long-long"] :exp "dg.exp"}
 "analyzer" {:runner :g++-dg-runtest :flags ["-fanalyzer" "-Wanalyzer-too-complex" "-fanalyzer-call-summaries"] :exp "analyzer.exp"}
 "asan" {:runner :gcc-dg-runtest :flags [] :always ["-fsanitize=address" "-g"] :torture "-O0" :exp "asan.exp (asan_init: -fsanitize=address -g)"}
 "bprob" {:runner :unmodelled :exp "bprob.exp (profile-feedback runs)"}
 "charset" {:runner :g++-dg-runtest :flags ["-fexec-charset=IBM1047"] :exp "charset.exp"}
 "compat" {:runner :unmodelled :exp "compat.exp, struct-layout-1.exp (two compilers' objects)"}
 "coroutines" {:runner :once :flags ["-pedantic-errors" "-Wno-long-long" "-std=c++20"] :exp "coroutines.exp"}
 "coroutines/torture" {:runner :gcc-dg-runtest :flags ["-pedantic-errors" "-Wno-long-long" "-fcoroutines" "-std=c++17"] :torture "-O0" :exp "coro-torture.exp"}
 "debug" {:runner :unmodelled :exp "debug.exp (gcc-dg-debug-runtest's -g levels)"}
 "debug/dwarf2" {:runner :g++-dg-runtest :flags ["-gdwarf-2"] :exp "dwarf2.exp"}
 "dfp" {:runner :g++-dg-runtest :flags [] :exp "dfp.exp"}
 "gcov" {:runner :g++-dg-runtest :flags [] :exp "gcov.exp"}
 "goacc" {:runner :g++-dg-runtest :flags ["-fopenacc"] :exp "goacc.exp"}
 "goacc-gomp" {:runner :g++-dg-runtest :flags ["-fopenacc" "-fopenmp"] :exp "goacc-gomp.exp"}
 "gomp" {:runner :g++-dg-runtest :flags ["-fopenmp"] :exp "gomp.exp"}
 "graphite" {:runner :unmodelled :exp "graphite.exp (flags by file name)"}
 "guality" {:runner :unmodelled :exp "guality.exp (debugger runs)"}
 "hwasan" {:runner :unmodelled :exp "hwasan.exp (no hwaddress sanitizer on x86_64)"}
 "lto" {:runner :unmodelled :exp "lto.exp (multi-file links)"}
 "modules" {:runner :modules :flags ["-pedantic-errors" "-Wno-long-long"] :exp "modules.exp (module-init: MOD_STD_LIST 17 2a 2b; the modules part itself is read and printed by the round trip at 2a, its preprocess files run here)"}
 "pch" {:runner :unmodelled :exp "pch.exp (a precompiled header built first)"}
 "plugin" {:runner :unmodelled :exp "plugin.exp (plugins built first)"}
 "simulate-thread" {:runner :unmodelled :exp "simulate-thread.exp (gdb runs)"}
 "special" {:runner :unmodelled :exp "ecos.exp (dg-runtest with its own steps)"}
 "tls" {:runner :g++-dg-runtest :flags ["-pedantic-errors" "-Wno-long-long"] :exp "tls.exp"}
 "tm" {:runner :g++-dg-runtest :flags ["-pedantic-errors" "-Wno-long-long"] :exp "tm.exp"}
 "torture" {:runner :gcc-dg-runtest :flags [] :torture "-O0" :exp "dg-torture.exp"}
 "torture/stackalign" {:runner :unmodelled :exp "stackalign.exp (its own flag lists)"}
 "tree-prof" {:runner :unmodelled :exp "tree-prof.exp (profile-feedback runs)"}
 "tsan" {:runner :gcc-dg-runtest :flags [] :always ["-fsanitize=thread" "-g"] :torture "-O0" :exp "tsan.exp (tsan_init: -fsanitize=thread -g)"}
 "ubsan" {:runner :g++-dg-runtest :flags [] :exp "ubsan.exp"}
 "vect" {:runner :unmodelled :exp "vect.exp (check_vect_support_and_set_flags)"}}

;; n-cpp-concepts (doc/cpp/CPP-SURVEY.md, "As built: n-cpp-concepts"): the concept rules' unit cases, test/cpp/selftest/concepts/*.C,
;; each read by Arbace's own front end (arbace.repr.cpp.diag/diagnose, the dg check's own read) at gnu++20, its error lines
;; against the lines that say dg-error, judged as the dg check judges them (arbace.repr.cpp.dg/verdict); a case named
;; *-control.C must fail. Prints a line a case and exits 1 when one does not behave. Read with the Clojure reader.
(ns cpp-selftest-concepts (:require [arbace.repr.cpp.diag :as diag] [arbace.repr.cpp.dg :as dg] [arbace.string :as str]))
(let [files (sort *command-line-args*)
      bad (atom 0)]
  (diag/load-sema!)
  (doseq [f files]
    (let [src (slurp f)
          lines (str/split-lines src)
          exp (vec (keep-indexed (fn [i l] (when (str/includes? l "dg-error") (inc i))) lines))
          nm (.getName (java.io.File. ^String f))
          r {:std "gnu++20" :expect {:error exp} :msgs {} :action :compile}
          res (try (diag/diagnose f nm "gnu++20" ["-iquote" (str (.getParent (java.io.File. ^String f)))])
                   (catch Throwable x {:refused :crash :message (str x)}))
          v (dg/verdict r (diag/read-map nm res))
          control (str/ends-with? nm "-control.C")
          ok (if control (not= :pass (first v)) (= :pass (first v)))]
      (when-not ok (swap! bad inc))
      (println (if ok "ok  " "BAD ") nm (pr-str v) (pr-str (mapv (juxt :line :msg) (filter #(= :error (:kind %)) (:diags res)))))))
  (println "concepts-diag:" (count files) "cases," @bad "not behaving")
  (shutdown-agents)
  (System/exit (if (zero? @bad) 0 1)))

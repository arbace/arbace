#!/bin/bash
# The checks' own tests (doc/cpp/CPP-SURVEY.md, "As built: review 007's fixes"): each test/cpp/selftest/NAME.sh puts bin/cppi,
# bin/repr-cpp, bin/repr-llvm or their judges in a situation a review found mishandled and requires the right verdict; it
# exits 0 when the check behaves. Scratch under .tmp/cpp-selftest/NAME/. Usage: bin/cppi selftest [NAME...]
set -uo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
dir=$root/test/cpp/selftest
names=("$@")
[ ${#names[@]} -gt 0 ] || { for f in "$dir"/*.sh; do b=$(basename "$f" .sh); names+=("$b"); done; }
pass=0 fail=0 failed=""
for n in "${names[@]}"; do
  [ -f "$dir/$n.sh" ] || { echo "selftest: no test $n" >&2; exit 2; }
  mkdir -p "$root/.tmp/cpp-selftest"
  if bash "$dir/$n.sh" > "$root/.tmp/cpp-selftest/$n.log" 2>&1; then echo "pass  $n"; pass=$((pass+1))
  else echo "FAIL  $n (.tmp/cpp-selftest/$n.log)"; tail -5 "$root/.tmp/cpp-selftest/$n.log" | sed 's/^/      /'; fail=$((fail+1)); failed="$failed $n"; fi
done
echo "selftest: $pass pass, $fail fail${failed:+:$failed}"
[ $fail = 0 ]

#!/bin/bash
# The checks' own tests (doc/cpp/CPP-SURVEY.md, "As built: review 007's fixes"): each test/cpp/selftest/NAME.sh puts bin/cppi,
# bin/repr-cpp, bin/repr-llvm or their judges in a situation a review found mishandled and requires the right verdict; it
# exits 0 when the check behaves. Scratch under .tmp/cpp-selftest/NAME/. Usage: bin/cppi selftest [NAME...]
set -uo pipefail
root=$(cd "$(dirname "$0")/../../.." && pwd)
dir=$root/test/cpp/selftest
# the dry mode (CP134 (b)): ARBACE_HOST_EXE=/bin/true, as a machine that cannot run the tools' host (a reviewing VM) sets it: a test
# whose first line is "# needs-host" (the tools' host, or the Go toolchain that builds cxxdump) is skipped, naming it; the others run (and must pass without a host)
dry=; [ "${ARBACE_HOST_EXE:-}" = /bin/true ] && dry=1
# re-review 032's F7: a run that skipped tests exits 3, not 0 (a skip is not a pass): --accept-skips (the caller says it expects them) exits 0
accept=; names=()
# ORS12 (a): --no-toolchain runs the tests that name no compiler or LLVM tool (toolchain.txt lists the others), --toolchain only those
mode=
for a in "$@"; do case $a in --accept-skips) accept=1 ;; --no-toolchain) mode=no ;; --toolchain) mode=only ;; *) names+=("$a") ;; esac; done
[ ${#names[@]} -gt 0 ] || { for f in "$dir"/*.sh; do b=$(basename "$f" .sh)
  case $mode in
    no) grep -qx "$b" "$dir/toolchain.txt" && continue ;;
    only) grep -qx "$b" "$dir/toolchain.txt" || continue ;;
  esac
  names+=("$b"); done; }
pass=0 fail=0 failed="" skipped=""
for n in "${names[@]}"; do
  [ -f "$dir/$n.sh" ] || { echo "selftest: no test $n" >&2; exit 2; }
  if [ -n "$dry" ] && sed -n 1p "$dir/$n.sh" | grep -q '^# needs-host'; then echo "skip  $n (needs the tools' host: dry mode)"; skipped="$skipped $n"; continue; fi
  mkdir -p "$root/.tmp/cpp-selftest"
  if bash "$dir/$n.sh" > "$root/.tmp/cpp-selftest/$n.log" 2>&1; then echo "pass  $n"; pass=$((pass+1))
  else echo "FAIL  $n (.tmp/cpp-selftest/$n.log)"; tail -5 "$root/.tmp/cpp-selftest/$n.log" | sed 's/^/      /'; fail=$((fail+1)); failed="$failed $n"; fi
done
echo "selftest: $pass pass, $fail fail${failed:+:$failed}${dry:+, $(echo $skipped | wc -w) skipped (dry mode):$skipped}"
[ $fail = 0 ] || exit 1
[ -z "$skipped" ] || [ -n "$accept" ] || { echo "selftest: skipped tests are not passes: exit 3 (--accept-skips: exit 0)"; exit 3; }
exit 0

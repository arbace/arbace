;; queue 601: arbace.cpp.nfc against UAX #15's conformance data, the pinned NormalizationTest.txt (test/scheme/ucd.edn): NFC(c1) = NFC(c2) =
;; NFC(c3) = c2 and NFC(c4) = NFC(c5) = c4 on every line; exits 1 on a failure. Run: arbace_tool test/cpp/nfc-test.ae .tmp/scheme/ucd-16.0.0/NormalizationTest.txt
(ns nfc-test (:require [arbace.cpp.nfc :as n] [arbace.string :as str]))
(let [bad (atom 0) tot (atom 0)
      cp (fn [s] (mapv #(Long/parseLong ^String % 16) (str/split (str/trim s) #" ")))]
  (doseq [^String l (str/split-lines (slurp (first *command-line-args*)))
          :when (and (seq l) (not (str/starts-with? l "#")) (not (str/starts-with? l "@")))]
    (let [[c1 c2 c3 c4 c5] (map cp (take 5 (str/split l #";")))]
      (swap! tot inc)
      (when-not (and (= c2 (n/nfc c1)) (= c2 (n/nfc c2)) (= c2 (n/nfc c3)) (= c4 (n/nfc c4)) (= c4 (n/nfc c5)))
        (when (< @bad 5) (println "BAD" l "->" (pr-str (n/nfc c1))))
        (swap! bad inc))))
  (println "nfc:" @tot "lines," @bad "failing")
  (System/exit (if (zero? @bad) 0 1)))

(ns c.judge-test
  "The unit tests of ci's judges (bin/ci judge-test; doc/C23-SURVEY.md, \"As built: review 006's fixes\"): the dg
  check's verdict (arbace.c.dg) on made-up reads and on the small files of test/c/judge/, and the run level's
  result and record comparison (arbace.c.run); since review 027 also the checker's rules it found (dg files of
  test/c/judge/) and the scripts' refusals and retries (bin/ci check and dg on made-up work directories under .tmp/, and
  bin/ci check on ci-run's ptr-sub-unsigned.c with a stand-in cirun). Each test names the finding of the review it covers."
  (:require [arbace.test :refer :all]
            [arbace.c.dg :as dg]
            [arbace.c.run :as run]
            [arbace.c.repl :as repl]
            [arbace.repr.c :as rc]
            [arbace.repr.c.annot :as annot]
            [arbace.repr.c.parse :as cparse]
            [arbace.c.check :as chk]
            [arbace.repr.c.host :as host]
            [arbace.repr.c.layout :as layout]
            [arbace.repr.c.rtcheck :as rt]
            [arbace.repr.c.results :as results]
            [arbace.string :as str]))

(def ^:private judge-dir (str (System/getProperty "user.dir") "/test/c/judge"))

(defn- ok [lines] {:status :ok :lines (into (sorted-map) lines) :other 0 :unlocated 0 :message ""})

(defn- read-one
  "A file of test/c/judge/ read as the dg check reads it (arbace.c.dg/read-file) for `action`, with `opts` (default -std=gnu23)."
  ([name action] (read-one name action ["-std=gnu23"]))
  ([name action opts]
  (let [h (host/load-host "test/c/host")
        fc (host/file-config opts "gnu23")]
    (dg/read-file h judge-dir {:name name :read (str judge-dir "/" name) :fc fc} action))))

;; finding 1: a read that failed, errors not in the main file, a missing row, a preprocessor's panic

(deftest no-read-row
  (is (= :crash (second (dg/verdict (dg/analyze "/* { dg-do compile } */") nil)))))

(deftest stray-errors-stop
  (let [d (dg/analyze "/* { dg-do compile } */")]
    (is (= :stopped (second (dg/verdict d {:status :read-error :lines {} :other 1 :unlocated 0 :message "x.h:1:1: e"}))))
    (is (= :stopped (second (dg/verdict d {:status :read-error :lines {} :other 0 :unlocated 1 :message "panic: e"}))))
    (is (= :stopped (second (dg/verdict d {:status :ok :lines {} :other 2 :unlocated 0 :message "x.h:1:1: e"}))))
    (is (= :stopped (second (dg/verdict d {:status :read-error :lines {} :other 0 :unlocated 0 :message ""}))))))

(deftest stray-errors-line-zero
  ;; a line-0 directive takes errors wherever they are
  (let [d (dg/analyze "/* { dg-do compile } */\n/* { dg-error \"e\" \"\" { target *-*-* } 0 } */")]
    (is (= [:pass] (dg/verdict d {:status :read-error :lines {} :other 1 :unlocated 0 :message "x.h:1:1: e"})))))

(deftest read-error-accounted
  (let [d (dg/analyze "/* { dg-do compile } */\nint x = ; /* { dg-error \"expected\" } */\n")]
    (is (= [:pass] (dg/verdict d {:status :read-error :lines {2 1} :other 0 :unlocated 0 :message "2: e"})))))

(deftest read-error-stops-early
  (let [d (dg/analyze "/* { dg-do compile } */\nint x = ; /* { dg-error \"expected\" } */\nint y = ; /* { dg-error \"expected\" } */\n")]
    (is (= :stopped (second (dg/verdict d {:status :read-error :lines {2 1} :other 0 :unlocated 0 :message "2: e"}))))))

(deftest included-header-error
  (let [r (read-one "inc-error.c" :compile)
        d (dg/analyze (slurp (str judge-dir "/inc-error.c")))]
    (is (pos? (long (:other r))))
    (is (= :stopped (second (dg/verdict d r))))))

(deftest preprocessor-panic
  (let [r (read-one "pp-panic.c" :preprocess)
        d (dg/analyze (slurp (str judge-dir "/pp-panic.c")))]
    (is (= :crash (:status r)))
    (is (str/includes? (:message r) "panic"))
    (is (= :crash (second (dg/verdict d r))))))

;; finding 4: the runner's own failure (status 70 and its refusal line) is never the program's status

(def ^:private empty-sha "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")

(deftest runner-internal-not-a-pass
  (let [ref {:id "c/x.c" :status 2 :stdout empty-sha}
        node ["c/x.c" "ok" "" "" ""]]
    (is (= :pass (second (run/result "c/x.c" ref node ["c/x.c" "2" empty-sha "0" ""]))))
    (is (= :fail (second (run/result "c/x.c" ref node ["c/x.c" "2" empty-sha "0" "cirun: internal: index out of range [3] with length 3"]))))
    (is (= :fail (second (run/result "c/x.c" (assoc ref :status 70) node ["c/x.c" "70" empty-sha "0" "ciaot: internal: no entry"]))))))

;; finding 3: a run against its committed record

(deftest record-regressions
  (let [f (java.io.File/createTempFile "rec" ".edn" (java.io.File. (str (System/getProperty "user.dir") "/.tmp")))
        _ (spit f (pr-str [["c/a.c" :pass ""] ["c/b.c" :fail "known asm: x (differ status 1 (gcc 0))"] ["c/c.c" :pass ""] ["d/z.c" :pass ""]]))
        rows [["c/a.c" :fail "differ stdout" :long-double] ["c/b.c" :fail "known asm: x (differ status 139 (gcc 0))" :by-design]]
        r (run/compare-record rows (.getPath f) ["c"])]
    (.delete f)
    (is (= ["c/a.c" "c/b.c"] (mapv first (:regressions r))))
    (is (= ["c/c.c"] (:absent r)))))

;; finding 6: dg-excess-errors and a line-0 directive no longer wave missed and extra lines through

(deftest excess-keeps-missed
  (let [d (dg/analyze "/* { dg-do compile } */\n/* { dg-excess-errors \"x\" } */\nint a; /* { dg-error \"e\" } */\nint b; /* { dg-error \"e\" } */\n")]
    (is (= :missed (second (dg/verdict d (ok {3 1, 9 1})))))
    (is (= [:pass] (dg/verdict d (ok {3 1, 4 1, 9 1}))))))

(deftest line-zero-counts
  (let [d (dg/analyze "/* { dg-do compile } */\n/* { dg-error \"e\" \"\" { target *-*-* } 0 } */\n")]
    (is (= [:pass] (dg/verdict d (ok {5 1}))))
    (is (= :extra (second (dg/verdict d (ok {5 1, 6 1, 7 1})))))
    (is (= :missed (second (dg/verdict d (ok {})))))))

;; finding 7: a read error stands for a syntax expectation only; an included unit's checker errors carry its file

(deftest read-error-not-semantic
  (let [d (dg/analyze "/* { dg-do compile } */\nif (int i = 1); /* { dg-error \"ISO C does not support if declarations\" } */\n")]
    (is (= :missed (second (dg/verdict d {:status :read-error :lines {2 1} :other 0 :unlocated 0 :message "2:4: unexpected 'int'"})))))
  (let [d (dg/analyze "/* { dg-do compile } */\nint x = ; /* { dg-error \"expected expression\" } */\n")]
    (is (= [:pass] (dg/verdict d {:status :read-error :lines {2 1} :other 0 :unlocated 0 :message "2:9: unexpected ';'"})))))

(deftest included-unit-checker-error
  (let [r (read-one "inc-check.c" :compile)]
    (is (= :ok (:status r)))
    (is (empty? (:lines r)))
    (is (= 1 (:other r)))
    (is (str/starts-with? (:stray r) "inc-check.h:2: "))))

;; finding 8: the C++ names false for C, whatever the table lists; dg-options' selectors read whole

(deftest cxx-selectors
  (is (true? (:applies (dg/sel-info "target { c || c++11 }"))))
  (is (false? (:applies (dg/sel-info "target c++20"))))
  (is (true? (:applies (dg/sel-info "target { ! c++ }"))))
  (is (= ["-DX"] (host/dg-options "/* { dg-options \"-DX\" { target { ! c++ } } } */\n/* { dg-options \"-std=c++20\" { target c++ } } */"))))

;; finding 9: an unsupported test is no pass, and a later dg-do that holds wins

(deftest later-dg-do-wins
  (let [d (dg/analyze "/* { dg-do run { target { ! int128 } } } */\n/* { dg-do compile { target int128 } } */\n")]
    (is (= :compile (:action d)))
    (is (not (:unsupported d))))
  (is (:unsupported (dg/analyze "/* { dg-do compile { target { ! int128 } } } */\n"))))

;; finding 11: an extra line's own message; no checkout's paths in the messages

(deftest extra-line-message
  (let [d (dg/analyze "/* { dg-do compile } */\nint a; /* { dg-error \"e\" } */\n")]
    (is (= "extra [9] got: 9: b" (nth (dg/verdict d (assoc (ok {2 1, 9 1}) :texts {2 "2: a" 9 "9: b"} :message "2: a")) 2)))))

(deftest messages-without-root
  (is (not (str/includes? (:stray (read-one "inc-error.c" :compile)) judge-dir))))

;; CS192 (a): ${srcdir} is the testsuite's root

(deftest srcdir-in-dg-options
  (let [t "/* { dg-additional-options \"--embed-directory=${srcdir}/c-c++-common/cpp/embed-dir\" } */"]
    (is (= ["--embed-directory=/ts/c-c++-common/cpp/embed-dir"] (host/dg-options t "/ts")))
    (is (= ["--embed-directory=./c-c++-common/cpp/embed-dir"] (host/dg-options t)))))

;; CS193 (a): the message count, a report beside the verdict

(deftest message-mismatch-report
  (let [dg {:action :compile :msgs {3 ["expected ';'"] 5 ["wrong thing"]} :expect {:error [3 5]}}
        r {:status :ok :lines {3 1 5 1}
           :all-texts {3 ["3:9: expected ';' before 'x'"] 5 ["5:1: something else" "5:2: another"]}}]
    (is (= [[5 ["wrong thing"] ["5:1: something else" "5:2: another"]]] (dg/msg-mismatch dg r)))
    (is (= [:pass] (dg/verdict dg r)))
    (is (= [] (dg/msg-mismatch dg (assoc-in r [:all-texts 5] ["5:2: a wrong thing here"]))))
    ;; review 031's finding B: a file whose read failed is compared too (before: skipped)
    (is (= [[5 ["wrong thing"] ["5:1: something else" "5:2: another"]]] (dg/msg-mismatch dg (assoc r :status :read-error))))))

(deftest tcl-quoted-backslashes
  (is (= ["_BitInt\\(63\\)"] (dg/tcl-words "\"_BitInt\\\\\\(63\\\\\\)\""))))

;; CS194 (a): C2y's if and switch declarations are read, and the checker's pedwarn before C2y is the expected error

(deftest if-declarations
  (let [txt (slurp (str judge-dir "/if-decl.c"))
        d (dg/analyze txt)
        r (read-one "if-decl.c" :compile ["-std=c23" "-pedantic-errors"])]
    (is (= :ok (:status r)))
    (is (= [8 9 11 16] (vec (keys (:lines r)))))
    (is (= [:pass] (dg/verdict d r)))
    (is (= [] (dg/msg-mismatch d r))))
  (let [r (read-one "if-decl.c" :compile ["-std=c23" "-pedantic-errors" "-Wno-c23-c2y-compat"])]
    (is (= [16] (vec (keys (:lines r)))))))

;; review 027's fixes: the checker's rules the re-review found too strict or too lax (each judged as a dg file)

(deftest constexpr-float-in-float
  ;; finding 1: float op float folded in float, not double
  (let [d (dg/analyze (slurp (str judge-dir "/constexpr-float.c")))
        r (read-one "constexpr-float.c" :compile ["-std=c23" "-pedantic-errors"])]
    (is (= [11 12] (vec (keys (:lines r)))))
    (is (= [:pass] (dg/verdict d r)))))

(deftest constexpr-decimal-of-the-objects-type
  ;; CS215: 1.000000000DF for a _Decimal32 is accepted (the constant is already _Decimal32); another type's stays strict
  (let [d (dg/analyze (slurp (str judge-dir "/constexpr-decimal.c")))
        r (read-one "constexpr-decimal.c" :compile ["-std=c23" "-pedantic-errors"])]
    (is (= [8 10 16 17] (vec (keys (:lines r)))))
    (is (= [:pass] (dg/verdict d r)))))

(deftest constexpr-float16-and-long-double-fraction
  ;; review 031's finding A: _Float16 and __bf16 values are rounded to their formats (a float object holds 0.1f16 exactly);
  ;; 027 #8's missed error: 0.1L is not a double
  (let [d (dg/analyze (slurp (str judge-dir "/constexpr-float16.c")))
        r (read-one "constexpr-float16.c" :compile ["-std=c23" "-pedantic-errors"])]
    (is (= [13 14 15 16 17 20 21] (vec (keys (:lines r)))))
    (is (= [:pass] (dg/verdict d r)))))

(deftest constexpr-float16-evaluated-in-float
  ;; review 053's finding 1: _Float16 and __bf16 are evaluated in float, as gcc 15.2 on x86-64 does; their constants are rounded once
  (let [d (dg/analyze (slurp (str judge-dir "/constexpr-float16-eval.c")))
        r (read-one "constexpr-float16-eval.c" :compile ["-std=c23" "-pedantic-errors"])]
    (is (= [5 6 8 9 22 23] (vec (keys (:lines r)))))
    (is (= [:pass] (dg/verdict d r)))))

(deftest constexpr-long-double-range
  ;; review 053's finding 4: the exact exponent of a long double constant, infinite doubles included, every binary object kind
  (let [d (dg/analyze (slurp (str judge-dir "/constexpr-ldouble-range.c")))
        r (read-one "constexpr-ldouble-range.c" :compile ["-std=c23"])]
    (is (not (:unsupported d)))
    (is (= [5 6 7 8 9 11 12] (vec (keys (:lines r)))))
    (is (= [:pass] (dg/verdict d r)))))

(deftest constexpr-long-double-through-operators
  ;; CS235 (a): :ld survives unary + and - and a cast to long double
  (let [d (dg/analyze (slurp (str judge-dir "/constexpr-ldouble-ops.c")))
        r (read-one "constexpr-ldouble-ops.c" :compile ["-std=c23"])]
    (is (not (:unsupported d)))
    (is (= [4 5 6 10] (vec (keys (:lines r)))))
    (is (= [:pass] (dg/verdict d r)))))

(deftest integer-to-float-rounds-once
  ;; review 057's finding 4: no double rounding of an integer converted to float
  (let [d (dg/analyze (slurp (str judge-dir "/constexpr-int-to-float.c")))
        r (read-one "constexpr-int-to-float.c" :compile ["-std=c23"])]
    (is (empty? (:lines r)))
    (is (= [:pass] (dg/verdict d r)))))

(deftest long-double-compared-exactly
  ;; review 057's finding 4: 0.1L != 0.1
  (let [d (dg/analyze (slurp (str judge-dir "/constexpr-ldouble-compare.c")))
        r (read-one "constexpr-ldouble-compare.c" :compile ["-std=c23"])]
    (is (not (:unsupported d)))
    (is (empty? (:lines r)))
    (is (= [:pass] (dg/verdict d r)))))

(deftest float128-compared-exactly
  ;; review 110's finding 2: _Float128 and _Float64x constants keep their exact value; a comparison in any type wider than double
  ;; compares exactly (0.1L != (_Float128)0.1 on x86-64), integers rounded to the type's significand, the q suffix is _Float128
  (let [d (dg/analyze (slurp (str judge-dir "/constexpr-float128-compare.c")))
        r (read-one "constexpr-float128-compare.c" :compile ["-std=gnu23"])]
    (is (not (:unsupported d)))
    (is (empty? (:lines r)))
    (is (= [:pass] (dg/verdict d r)))))

(deftest constexpr-float128-representable
  ;; review 110's finding 2: binary128's 0.1 is not a double's nor a long double's value; 2^120 + 1 is not a _Float128's
  (let [d (dg/analyze (slurp (str judge-dir "/constexpr-float128.c")))
        r (read-one "constexpr-float128.c" :compile ["-std=c23" "-pedantic-errors"])]
    (is (not (:unsupported d)))
    (is (= [5 7 11 13 14 15] (vec (keys (:lines r)))))
    (is (= [:pass] (dg/verdict d r)))))

(deftest float16-with-bf16-is-float16
  ;; review 057's finding 4: usual arithmetic conversions of _Float16 and __bf16
  (let [d (dg/analyze (slurp (str judge-dir "/generic-float16-bf16.c")))
        r (read-one "generic-float16-bf16.c" :compile ["-std=c23"])]
    (is (empty? (:lines r)))
    (is (= [:pass] (dg/verdict d r)))))

(deftest bf16-suffix-pedwarn
  ;; review 057's finding 4: -pedantic-errors refuses the bf16 suffix, not f16
  (let [d (dg/analyze (slurp (str judge-dir "/bf16-suffix.c")))
        r (read-one "bf16-suffix.c" :compile ["-std=c23" "-pedantic-errors"])]
    (is (= [5 7 8 9 15] (vec (keys (:lines r)))))
    (is (= [:pass] (dg/verdict d r)))))

(deftest equal-rank-float-types
  ;; review 079's finding 6: _Float32 + float is _Float32, double + _Float32x is double, ...
  (let [d (dg/analyze (slurp (str judge-dir "/generic-float-ties.c")))
        r (read-one "generic-float-ties.c" :compile ["-std=c23"])]
    (is (empty? (:lines r)))
    (is (= [:pass] (dg/verdict d r)))))

(deftest generic-incomplete-association
  ;; finding 2: an incomplete or a function association type is a pedwarn before C2y (an error only with -pedantic-errors)
  (let [d (dg/analyze (slurp (str judge-dir "/generic-incomplete.c")))
        r (read-one "generic-incomplete.c" :compile ["-std=c23" "-pedantic-errors"])]
    (is (= [6 7 8] (vec (keys (:lines r)))))
    (is (= [:pass] (dg/verdict d r)))
    (is (= [] (dg/msg-mismatch d r))))
  (is (empty? (:lines (read-one "generic-incomplete.c" :compile ["-std=c23"]))))
  (is (empty? (:lines (read-one "generic-incomplete.c" :compile ["-std=c2y" "-pedantic-errors"])))))

(deftest bit-field-results
  ;; finding 7: sizeof, typeof and _Alignof of an assignment or an increment of a bit-field are accepted
  (let [d (dg/analyze (slurp (str judge-dir "/bitfield-ops.c")))
        r (read-one "bitfield-ops.c" :compile)]
    (is (= [15 16 17 18] (vec (keys (:lines r)))))
    (is (= [:pass] (dg/verdict d r)))))

(deftest constexpr-long-double-and-snan
  ;; finding 8: a wide integer long double holds exactly is accepted; a negated signaling NaN of another type is refused
  (let [d (dg/analyze (slurp (str judge-dir "/constexpr-ldouble.c")))
        r (read-one "constexpr-ldouble.c" :compile ["-std=c23"])]
    (is (not (:unsupported d)))
    (is (= [8 9 10] (vec (keys (:lines r)))))
    (is (= [:pass] (dg/verdict d r)))))

;; queue 154: the builtins of the :missing-builtin class folded by the checker as gcc 15.2 folds them (gcc accepts every
;; _Static_assert of test/c/judge/builtin-fold.c but the seven of the wrong value, lines 36-42, one a family; the checker
;; accepts a _Static_assert it cannot fold, so the wrong values are the test)

(deftest missing-builtins-fold
  ;; the bit builtins (narrow and wide _BitInt), <stdbit.h>'s, the overflow predicates over a _BitInt result,
  ;; the float and long double classification spellings, __atomic_always_lock_free, __builtin_assoc_barrier in an enumerator
  (let [d (dg/analyze (slurp (str judge-dir "/builtin-fold.c")))
        r (read-one "builtin-fold.c" :compile)]
    (is (not (:unsupported d)))
    (is (= [36 37 38 39 40 41 42] (vec (keys (:lines r)))))
    (is (= [:pass] (dg/verdict d r)))))

;; review 027, finding 3: --judge --record after a subset's run refuses, in the three judges

(defn- sh-status
  "The exit status of `cmd` run in the checkout with the environment `env` added (its output dropped)."
  [env & cmd]
  (let [pb (ProcessBuilder. ^java.util.List (vec cmd))
        log (java.io.File/createTempFile "judge-sh" ".log" (java.io.File. (str (System/getProperty "user.dir") "/.tmp")))]
    (.directory pb (java.io.File. ^String (System/getProperty "user.dir")))
    (doseq [[k v] env] (.put (.environment pb) k v))
    (.redirectErrorStream pb true)
    (.redirectOutput pb log)
    (let [st (.waitFor (.start pb))] (.delete log) st)))

;; queue 164: _BitInt wider than 64 bits (and __int128) where the builder refused or built an integer node: wide
;; bit-fields, postfix ++/-- of a wide object, a wide statement expression, a wide switch; the program checks itself
;; against gcc 15.2's values (status 0), run by ci's back end (bin/ci run: the builder and tools/cirun)

(deftest wide-bitint-run
  (is (= 0 (sh-status {} "bin/ci" "run" "test/c/judge/bitint-wide-run.c"))))

;; queue 178 (CX8's finding 1, fixed by queue 173's place of a compound literal): the address of a scalar compound literal,
;; automatic and static, is its object's (memcpy(&x, &(unsigned){7u}, 4) faulted at 0x7); the program checks itself

(deftest complit-scalar-address-run
  (is (= 0 (sh-status {} "bin/ci" "run" "test/c/judge/complit-scalar-addr-run.c"))))

;; queue 178 (CX8's finding 2): a conditional whose arms are structures or unions (6.5.16), which the builder refused ("a
;; conversion from struct pt to struct pt"): objects, calls (only the chosen one evaluated), compound literals, a member of
;; the result; the program checks itself

(deftest struct-conditional-run
  (is (= 0 (sh-status {} "bin/ci" "run" "test/c/judge/struct-conditional-run.c"))))

;; queue 178 (CX8's finding 3): <math.h>'s functions in __builtin_ spellings cc's Builtin does not declare (an undeclared
;; builtin's int result: __builtin_log2(2.75) was 0, __builtin_exp2f an undefined function), every prototype shape and
;; spelling with no header; the program checks itself

(deftest math-builtins-run
  (is (= 0 (sh-status {} "bin/ci" "run" "test/c/judge/math-builtins-run.c"))))

;; queue 178 (CX8's finding 4): musl's sources that include a table inside a declaration (strerror.c, iswalpha.c, iswpunct.c,
;; wcwidth.c, iconv.c), refused as :split-declaration by repr/c, read for ci's libc since (convert/*include-inside*, bound by
;; arbace.c.musl/read-one); the program checks itself

(deftest musl-table-include-run
  (is (= 0 (sh-status {} "bin/ci" "run" "test/c/judge/musl-table-include-run.c"))))

(declare sh-out-env)

(defn- sh-out
  "{:out} the standard output of `cmd` run in the checkout."
  [& cmd]
  (sh-out-env {} cmd))

(defn- sh-out-env
  [env cmd]
  (let [pb (ProcessBuilder. ^java.util.List (vec cmd))]
    (doseq [[k v] env] (.put (.environment pb) k v))
    (.directory pb (java.io.File. ^String (System/getProperty "user.dir")))
    (let [p (.start pb) out (slurp (.getInputStream p))] (.waitFor p) {:out out})))

(deftest judge-record-after-subset
  (let [root (System/getProperty "user.dir")
        work (doto (java.io.File. (str root "/.tmp/judge-test-subset")) (.mkdirs))
        d (doto (java.io.File. work "judge-zz") (.mkdirs))
        recs ["test/c/check-linux-amd64.edn" "test/c/check-aot-linux-amd64.edn" "test/c/check-dg-linux-amd64.edn"]
        before (mapv slurp recs)]
    (try
      (spit (java.io.File. d "list.tsv") "judge-zz/x.c\t.\tc23\t\tx.c\n")
      (spit (java.io.File. d "nodes.tsv") "")
      (spit (java.io.File. d "run.tsv") "")
      (spit (java.io.File. d "dg.edn") "[[\"x.c\" {:action :compile :expect {}}]]")
      (spit (java.io.File. d "read.edn") "[[\"x.c\" {:status :ok :lines {} :other 0 :unlocated 0 :message \"\"}]]")
      (spit (java.io.File. d "subset") "ids.txt\n")
      (is (= 2 (sh-status {"CI_CHECK_WORK" (.getPath work)} "bin/ci" "check" "--judge" "--record" "--corpus" "judge-zz")))
      (is (= 2 (sh-status {"CI_AOT_WORK" (.getPath work) "CI_INTERP" (.getPath work)} "bin/ci" "check" "--aot" "--judge" "--record" "--corpus" "judge-zz")))
      (is (= 2 (sh-status {"CI_DG_WORK" (.getPath work)} "bin/ci" "dg" "--judge" "--record" "--corpus" "judge-zz")))
      (is (= [true true true] (mapv #(= %1 (slurp %2)) before recs)))
      (finally
        (doseq [[f s] (map vector recs before)] (when (not= s (slurp f)) (spit f s)))
        (doseq [f (reverse (file-seq work))] (.delete ^java.io.File f))))))

;; review 027, finding 4: a recorded pass that becomes unsupported is a regression; --essential fails on it

(deftest pass-to-unsupported
  (let [root (System/getProperty "user.dir")
        work (doto (java.io.File. (str root "/.tmp/judge-test-unsupported")) (.mkdirs))
        d (doto (java.io.File. work "gcc-c23") (.mkdirs))
        only (java.io.File. work "only.txt")
        rd "[[\"gcc.dg/c23-tag-6.c\" {:status :ok :lines {} :other 0 :unlocated 0 :message \"\"}]]"
        judge (fn [dg & essential]
                (spit (java.io.File. d "dg.edn") (str "[[\"gcc.dg/c23-tag-6.c\" " dg "]]"))
                (if essential
                  ;; --essential's judge (its environment) on a list of the one file
                  (sh-status {"CI_DG_WORK" (.getPath work) "CI_DG_ONLY" (.getPath only) "CI_DG_ESSENTIAL" "1"} "bin/ci" "dg" "--judge" "--corpus" "gcc-c23")
                  (sh-status {"CI_DG_WORK" (.getPath work)} "bin/ci" "dg" "--judge" "--corpus" "gcc-c23")))]
    (try
      (spit (java.io.File. d "read.edn") rd)
      (spit (java.io.File. d "subset") "a subset: the group's other recorded files are not judged\n")
      (spit only "gcc-c23/gcc.dg/c23-tag-6.c\n")
      ;; c23-tag-6 is a recorded pass: as a pass (no expectation, nothing given) the judge passes; unsupported, it fails
      (is (= 0 (judge "{:action :compile :expect {}}")))
      (is (= 1 (judge "{:action :compile :expect {} :unsupported true}")))
      (is (= 0 (judge "{:action :compile :expect {}}" :essential)))
      (is (= 1 (judge "{:action :compile :expect {} :unsupported true}" :essential)))
      (finally
        (doseq [f (reverse (file-seq work))] (.delete ^java.io.File f))))))

;; review 027, finding 5: option lines' selectors on the reference host's targets, an unlisted name unknown (the line kept,
;; reported)

(deftest option-selectors-on-the-host
  (is (= ["-DX"] (host/dg-options "/* { dg-additional-options \"-DX\" { target { ! ia32 } } } */")))
  (is (= [] (host/dg-options "/* { dg-options \"-mtune=i686\" { target { { i?86-*-* x86_64-*-* } && ia32 } } } */")))
  (is (= [] (host/dg-options "/* { dg-additional-options \"-Wl,-u,_printf_float\" { target newlib_nano_io } } */")))
  (is (= [] (host/dg-options "/* { dg-options \"-DY\" { target arm*-*-* } } */")))
  (is (= ["-DZ"] (host/dg-options "/* { dg-options \"-DZ\" { target { x86_64-*-* i?86-*-* } } } */")))
  (is (= {:opts ["-DW"] :uncertain ["target { ! frobnicate }"]}
         (host/dg-options-info "/* { dg-additional-options \"-DW\" { target { ! frobnicate } } } */" ".")))
  (is (= :unknown (host/for-c? "target { ! ia32 && frobnicate }")))
  (is (false? (host/for-c? "target { ia32 && frobnicate }")))
  (is (true? (host/for-c? "target { c || frobnicate }")))
  ;; the dg-do and dg-error selectors keep their rule: an unlisted name holds
  (is (true? (:applies (dg/sel-info "target frobnicate")))))

;; review 027, finding 6: a recorded pass that timed out (a loaded host) is run or read again alone, once, before it counts

(deftest quiet-retry-of-a-timeout
  ;; the dg read's retry: only a recorded pass's timeout is read again, and the second read stands
  (let [calls (atom [])
        rs [["a.c" {:status :timeout :lines {}}] ["b.c" {:status :timeout :lines {}}] ["c.c" {:status :ok :lines {}}]]
        out (dg/retry-timeouts rs #{"a.c" "c.c"} (fn [nm] (swap! calls conj nm) {:status :ok :lines {3 1}}))]
    (is (= ["a.c"] @calls))
    (is (= [:ok :timeout :ok] (mapv (comp :status second) out)))
    (is (:retried (second (first out)))))
  ;; the run level's: ci-run's ptr-sub-unsigned.c (a recorded pass) on a cirun whose first run hangs past the 10 s
  (let [root (System/getProperty "user.dir")
        work (doto (java.io.File. (str root "/.tmp/judge-test-retry")) (.mkdirs))
        ids (java.io.File. work "ids.txt")
        real (or (System/getenv "CIRUN") (str root "/.tmp/ci/cirun"))]
    (when-not (and (System/getenv "CIRUN") (.exists (java.io.File. ^String real))) (sh-status {} "bin/ci" "cirun-build" "--ensure"))
    (try
      (spit ids "ci-run/ptr-sub-unsigned.c\n")
      (is (= 0 (sh-status {"CI_CHECK_WORK" (.getPath work) "CIRUN" (str root "/test/c/judge/cirun-slow-once")
                           "CIRUN_REAL" real
                           "CIRUN_ONCE" (str (.getPath work) "/once")}
                          "bin/ci" "check" "--corpus" "ci-run" "--only" (.getPath ids))))
      (is (.exists (java.io.File. work "once")))
      (finally
        (doseq [f (reverse (file-seq work))] (.delete ^java.io.File f))))))

;; CS213: Go's fatal errors in cirun (stack exhaustion, out of memory, a concurrent map write) are internal failures, whatever
;; the exit status (here the program's own, 3)

(deftest check-runs-nodes-on-ci-exe
  ;; C9 (CS103): with CI_EXE the run level runs each node program by `CI_EXE -m arbace.c.repl run-nodes FILE`, with no cirun
  ;; built; ci-run's ptr-sub-unsigned.c (a recorded pass) on a stand-in executable that logs its arguments and runs the real cirun
  (let [root (System/getProperty "user.dir")
        work (doto (java.io.File. (str root "/.tmp/judge-test-ciexe")) (.mkdirs))
        ids (java.io.File. work "ids.txt")
        real (or (System/getenv "CIRUN") (str root "/.tmp/ci/cirun"))
        lg (java.io.File. work "log")]
    (when-not (and (System/getenv "CIRUN") (.exists (java.io.File. ^String real))) (sh-status {} "bin/ci" "cirun-build" "--ensure"))
    (try
      (spit ids "ci-run/ptr-sub-unsigned.c\n")
      (is (= 0 (sh-status {"CI_CHECK_WORK" (.getPath work) "CIRUN" "/nonexistent/cirun" "CI_EXE" (str root "/test/c/judge/ciexe-standin")
                           "CIRUN_REAL" real "CIEXE_LOG" (.getPath lg)}
                          "bin/ci" "check" "--corpus" "ci-run" "--only" (.getPath ids))))
      (is (.exists lg))
      (when (.exists lg) (is (re-find #"-m arbace.c.repl run-nodes " (slurp lg))))
      (finally
        (doseq [f (reverse (file-seq work))] (.delete ^java.io.File f))))))

(deftest cinterp-check-on-an-executable
  ;; C9: bin/ci cinterp-check --exe EXE (the window's check of the built executable) on a stand-in whose back end is the Go side of
  ;; CInterp (built by the first call): the fixtures pass; a stand-in whose back end is cirun's is refused
  (let [root (System/getProperty "user.dir")]
    (is (= 0 (sh-status {} "bin/ci" "cinterp-check")))
    (is (= 0 (sh-status {"CINTERP_RUN" (str root "/.tmp/cinterp/cinterp-run")}
                        "bin/ci" "cinterp-check" "--exe" (str root "/test/c/judge/cinterp-exe-standin"))))
    (is (= 1 (sh-status {} "bin/ci" "cinterp-check" "--exe" "/bin/true")))))

(deftest repl-backend-default
  ;; C9 (CS103): arbace.c.repl's default back end is the in-process one only where arbace.lang.CInterp exists (an executable built
  ;; with ci); stage 0 keeps tools/cirun, and arbace.c.cinterp does not load there
  (let [b (repl/backend)]
    (is (#{:cinterp :cirun} b))
    (if (= :cirun b)
      (is (thrown? Throwable (require 'arbace.c.cinterp)))
      (is (fn? @(resolve 'arbace.c.cinterp/run-nodes))))
    ;; the in-process back end is cinterp's var (resolve's), called through it: so a redefinition reaches the REPL
    (is (= (if (= :cirun b) repl/light-run-nodes (resolve 'arbace.c.cinterp/run-nodes)) repl/*run-nodes*))))

(deftest go-fatal-error-is-internal
  (let [ref {:status 3 :stdout "x"}]
    (is (= :fail (second (run/result "a.c" ref ["a.c" "ok" "" "" ""] ["a.c" "3" "x" "0" "fatal error: stack overflow"]))))
    (is (= :pass (second (run/result "a.c" ref ["a.c" "ok" "" "" ""] ["a.c" "3" "x" "0" ""])))))
  (let [root (System/getProperty "user.dir")
        work (doto (java.io.File. (str root "/.tmp/judge-test-fatal")) (.mkdirs))
        ids (java.io.File. work "ids.txt")
        real (or (System/getenv "CIRUN") (str root "/.tmp/ci/cirun"))]
    (when-not (and (System/getenv "CIRUN") (.exists (java.io.File. ^String real))) (sh-status {} "bin/ci" "cirun-build" "--ensure"))
    (try
      (spit ids "ci-run/ptr-sub-unsigned.c\n")
      ;; the stand-in exits 3 as gcc's run of ptr-sub-unsigned.c does, after Go's fatal error lines: a REGRESSION now
      (is (= 1 (sh-status {"CI_CHECK_WORK" (.getPath work) "CIRUN" (str root "/test/c/judge/cirun-fatal")}
                          "bin/ci" "check" "--corpus" "ci-run" "--only" (.getPath ids))))
      (finally
        (doseq [f (reverse (file-seq work))] (.delete ^java.io.File f))))))

;; CS211: the musl forms cache is keyed by the digest of repr/c's files (bin/ci musl key, fresh): a cache read by another
;; repr/c is not fresh, so bin/ci musl read rereads it

(deftest musl-forms-cache-key
  (let [root (System/getProperty "user.dir")
        work (doto (java.io.File. (str root "/.tmp/judge-test-musl-key")) (.mkdirs))
        env {"CI_MUSL_FORMS" (.getPath work)}
        key (str/trim (:out (sh-out "bin/ci" "musl" "key")))]
    (try
      (is (= 64 (count key)))
      ;; no key file (a cache from before CS211) and a stale one: not fresh
      (is (= 1 (sh-status env "bin/ci" "musl" "fresh")))
      (spit (java.io.File. work "key") "0000\n")
      (is (= 1 (sh-status env "bin/ci" "musl" "fresh")))
      (spit (java.io.File. work "key") (str key "\n"))
      (is (= 0 (sh-status env "bin/ci" "musl" "fresh")))
      (finally
        (doseq [f (reverse (file-seq work))] (.delete ^java.io.File f))))))

;; CS212: the judges' residues of review 027. R2: a known row that now passes is an improvement; R4: the main file is the whole
;; relative path; R7: a parser panic is a crash

(deftest known-row-now-passing-is-no-regression
  (let [work (doto (java.io.File. (str (System/getProperty "user.dir") "/.tmp/judge-test-improved")) (.mkdirs))
        recf (java.io.File. work "rec.edn")]
    (try
      (spit recf (pr-str [["ci-run/a.c" :fail "known x"] ["ci-run/b.c" :fail "known y"] ["ci-run/c.c" :pass ""]]))
      (let [c (run/compare-record [["ci-run/a.c" :pass ""] ["ci-run/b.c" :fail "known z"] ["ci-run/c.c" :fail "now fails"]] (.getPath recf) ["ci-run"])]
        ;; a passes now: improved; b's reason changed: regression; c passed and fails: regression
        (is (= ["ci-run/a.c"] (:improved c)))
        (is (= ["ci-run/b.c" "ci-run/c.c"] (mapv first (:regressions c)))))
      (finally (doseq [f (reverse (file-seq work))] (.delete ^java.io.File f))))))

(deftest aot-interpreted-side-needs-its-run
  ;; CS214 (R3): without CI_AOT_NODES and CI_INTERP the compiled runs are not compared with scratch of another state
  (let [root (System/getProperty "user.dir")
        work (doto (java.io.File. (str root "/.tmp/judge-test-interp")) (.mkdirs))
        d (doto (java.io.File. work "ci-run") (.mkdirs))
        id "ci-run/ptr-sub-unsigned.c"
        empty-sum "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"]
    (try
      (spit (java.io.File. d "list.tsv") (str id "\t.\tc23\t\tptr-sub-unsigned.c\n"))
      (spit (java.io.File. d "nodes.tsv") (str id "\tok\t\t\t\n"))
      (spit (java.io.File. d "run.tsv") (str id "\t3\t" empty-sum "\t0\t\n"))
      (let [o (:out (sh-out-env {"CI_AOT_WORK" (.getPath work) "CI_SUBSET" "1"}
                                ["bin/ci" "check" "--aot" "--judge" "--corpus" "ci-run"]))]
        (is (str/includes? o "not compared"))
        (is (not (str/includes? o "with no interpreted run"))))
      ;; a named directory is read
      (let [o (:out (sh-out-env {"CI_AOT_WORK" (.getPath work) "CI_SUBSET" "1" "CI_INTERP" (.getPath work)}
                                ["bin/ci" "check" "--aot" "--judge" "--corpus" "ci-run"]))]
        (is (str/includes? o "the same")))
      (finally (doseq [f (reverse (file-seq work))] (.delete ^java.io.File f))))))

(deftest extension-lines-by-unit
  ;; CS214 (R5): __extension__ silences a pedwarn on its own file's line, not another file's line of the same number. The forms
  ;; read from C carry no line in a unit (the pedwarn stands on the #include's line), so the lines are given to a unit's forms
  ;; as a reread unit's are
  (let [h (host/load-host "test/c/host")
        opts ["-std=c23" "-pedantic-errors"]
        fc (host/file-config opts "gnu23")
        builtins (annot/builtin-forms h fc)
        errors (fn [main]
                 (let [rd (rc/read-c (host/config h fc judge-dir) fc main false)
                       rd (update rd :units (fn [us] (into {} (for [[k u] us]
                                                                [k (update u :forms (fn [fs] (vec (map-indexed (fn [i g] (vary-meta g assoc :line (inc i))) fs))))]))))]
                   (:errors (chk/check-unit rd :c23 builtins :pedantic :errors :ext-lines (:ext-lines rd) :base judge-dir :sys-dirs (:search h)))))]
    ;; the header's own line 3 has __extension__: silenced (before: the main file's lines decided, and it has none)
    (is (= [] (errors "ext-main-a.c")))
    ;; the main file's line 3 has it, the header's line 3 does not: reported (before: silenced)
    (is (= 1 (count (errors "ext-main-b.c"))))
    ;; review 031's finding F: #pragma GCC system_header in the header makes it a system header
    (is (= [] (errors "ext-main-d.c")))
    (is (= 1 (count (errors "ext-main-e.c")))))
  ;; CS231: -isystem DIR is searched after -I and is a system directory: no pedwarn in a header found through it; -I's is an error
  (let [h (host/load-host "test/c/host")
        dir (str judge-dir "/sys")
        rd (fn [& opts]
             (dg/read-file h judge-dir {:name "ext-main-f.c" :read (str judge-dir "/ext-main-f.c")
                                        :fc (host/file-config (vec (concat ["-std=c23" "-pedantic-errors"] opts)) "gnu23")} :compile))]
    (is (= [:ok 0] ((juxt :status :other) (rd "-isystem" dir))))
    ;; review 057's finding 3: the joined spelling and unclean directories are system directories too; -isystem=DIR is a sysroot's (ignored)
    (is (= [:ok 0] ((juxt :status :other) (rd (str "-isystem" dir)))))
    (is (= [:ok 0] ((juxt :status :other) (rd "-isystem" (str judge-dir "/./sys")))))
    (is (= [:ok 0] ((juxt :status :other) (rd "-isystem" (str dir "/")))))
    (is (not= [:ok 0] ((juxt :status :other) (rd (str "-isystem=" dir)))))
    ;; an angled include searches -I too (gcc), and the header there is not a system header: its pedwarn is an error
    (is (= [:ok 1] ((juxt :status :other) (rd (str "-I" dir)))))))

(defn- found-headers
  "The paths (relative to test/c/judge/inc) of the header units the preprocessor finds for the main file `main` of
  test/c/judge/inc/ with the directories of test/c/judge/inc given as `-iquote d`-style options (each option's directory name
  is a name below inc/)."
  [main & opts]
  (let [inc (str judge-dir "/inc")
        h (host/load-host "test/c/host")
        opts (mapv (fn [o] (if (re-matches #"[a-z0-9]+" o) (str inc "/" o) o)) opts)
        fc (host/file-config (vec (concat ["-std=c23"] opts)) "gnu23")
        rd (rc/read-c (host/config h fc inc) fc main false)]
    (vec (sort (map (fn [u] (str/replace (str (:path u)) (str inc "/") "")) (vals (:units rd)))))))

(defn- found-vars
  "The names of the variables the header units of `found-headers`' read declare, sorted."
  [main & opts]
  (let [inc (str judge-dir "/inc")
        h (host/load-host "test/c/host")
        opts (mapv (fn [o] (if (re-matches #"[a-z0-9]+" o) (str inc "/" o) o)) opts)
        fc (host/file-config (vec (concat ["-std=c23"] opts)) "gnu23")
        rd (rc/read-c (host/config h fc inc) fc main false)]
    (vec (sort (map str (for [u (vals (:units rd)) f (:forms u) :when (and (seq? f) (= 'c/var (first f)))] (second f)))))))

(deftest include-search-is-gccs
  ;; review 079's finding 2, each case run with gcc 15.2 (-M): -iquote after the including file's directory and for quoted includes only,
  ;; -idirafter last, a -I that names a system directory dropped, #include_next continuing in -I
  (is (= ["q/zzh.h"] (found-headers "main-q.c" "-iquote" "q" "-I" "i" "-isystem" "s" "-idirafter" "a")))
  (is (= ["i/zzh.h"] (found-headers "main-a.c" "-iquote" "q" "-I" "i" "-isystem" "s" "-idirafter" "a")))
  (is (= ["a/zzh.h"] (found-headers "main-a.c" "-idirafter" "a")))
  (is (= ["a/zzh.h"] (found-headers "main-q.c" "-idirafter" "a")))
  (is (= ["i2/zzh.h"] (found-headers "main-a.c" "-I" "i" "-I" "i2" "-isystem" "i")))
  (is (= ["i/zzh.h"] (found-headers "main-a.c" "-I" "i" "-isystem" "s" "-I" "s")))
  (is (= ["a/zzh.h"] (found-headers "main-a.c" "-idirafter" "a" "-I" "a")))
  (is (= ["i/zzh.h"] (found-headers "main-a.c" "-I" "i" "-I" "i" "-I" "i2")))
  ;; the unit of n1/nx.h holds n2's variable too: its #include_next found n2/nx.h (gcc: n1/nx.h n2/nx.h)
  (is (= ["n1" "n2"] (found-vars "main-n.c" "-I" "n1" "-I" "n2")))
  (is (= ["n1" "n2"] (found-vars "main-nq.c" "-I" "n1" "-I" "n2")))
  (is (= ["q/zzh.h"] (found-headers "main-q.c" "-iquote" "q" "-I" "i")))
  ;; review 086's finding 3: an -iquote directory that is a system directory is dropped from the quote chain
  (is (= ["i/zzh.h"] (found-headers "main-q.c" "-isystem" "s" "-iquote" "s" "-I" "i")))
  (is (= ["i/zzh.h"] (found-headers "main-q.c" "-iquote" "s" "-isystem" "s" "-I" "i")))
  (is (= ["s/zzh.h"] (found-headers "main-q.c" "-iquote" "s" "-I" "i"))))

(deftest system-header-by-the-directory-found-through
  ;; review 079's finding 3: a header is a system header by the search directory that found it (gcc), not by a path prefix
  (let [h (host/load-host "test/c/host")
        errs (fn [dir main & opts]
               (let [base (str judge-dir "/sysx" (when dir (str "/" dir)))
                     r (dg/read-file h base {:name main :read (str base "/" main)
                                             :fc (host/file-config (vec (concat ["-std=c23" "-pedantic-errors"] opts)) "gnu23")} :compile)]
                 [(:status r) (:other r)]))]
    (is (= [:ok 1] (errs nil "m-sub.c" "-I" "sy" "-isystem" "sy/sub")))
    (is (= [:ok 1] (errs nil "m-ph.c" "-isystem" "sy" "-I" "sy/sub")))
    (is (= [:ok 1] (errs nil "m-ph.c" "-I" "sy")))
    (is (= [:ok 0] (errs nil "m-ph.c" "-isystem" "sy")))
    (is (= [:ok 0] (errs "dot" "m-ph.c" "-isystem" ".")))
    (is (= [:ok 1] (errs "dot" "m-q.c" "-isystem" ".")))
    ;; review 086's finding 1: a header a system header includes with quotes, found beside it, takes the includer's status
    (is (= [:ok 0] (errs "qs" "m.c" "-isystem" "sy")))
    ;; the preprocessor's enter records (a nested header is one unit with its includer for the checker, so the records show it)
    (let [enters (fn [& opts]
                   (let [fc (host/file-config (vec (concat ["-std=c23"] opts)) "gnu23")
                         r (cparse/parse (host/config h fc (str judge-dir "/sysx/qs")) "m.c")]
                     (mapv (juxt :path :system) (filter #(= "enter" (:directive %)) (:layer r)))))]
      (is (= [["sy/a.h" true] ["sy/b.h" true]] (enters "-isystem" "sy")))
      (is (= [["sy/a.h" false] ["sy/b.h" false]] (enters "-I" "sy"))))
    (is (= [:ok 1] (errs "qs" "m.c" "-I" "sy")))))

(deftest nested-header-by-its-own-status
  ;; review 110's finding 1: a header a unit's top header includes is judged by its own system status, not the top header's
  ;; (libcpp: system when found through a system directory, entered from a system header or after its pragma); each case run
  ;; with gcc 15.2 -std=c23 -pedantic-errors -fsyntax-only in test/c/judge/sysx/mix
  (let [h (host/load-host "test/c/host")
        base (str judge-dir "/sysx/mix")
        errs (fn [main & opts]
               (let [r (dg/read-file h base {:name main :read (str base "/" main)
                                             :fc (host/file-config (vec (concat ["-std=c23" "-pedantic-errors"] opts)) "gnu23")} :compile)]
                 [(:status r) (:other r)]))
        enters (fn [main & opts]
                 (let [fc (host/file-config (vec (concat ["-std=c23"] opts)) "gnu23")
                       r (cparse/parse (host/config h fc base) main)]
                   (mapv (juxt :path :system) (filter #(= "enter" (:directive %)) (:layer r)))))]
    ;; i/a.h (-I) includes <b.h> found in -isystem sy: b.h's pedwarn is none (gcc 0), with -I sy it is (gcc 1)
    (is (= [:ok 0] (errs "m.c" "-I" "i" "-isystem" "sy")))
    (is (= [:ok 1] (errs "m.c" "-I" "i" "-I" "sy")))
    ;; the includer's own pedwarn after the nested system header still counts (gcc: i/a2.h:2 alone)
    (is (= [:ok 1] (errs "m2.c" "-I" "i" "-isystem" "sy")))
    (is (= [:ok 2] (errs "m2.c" "-I" "i" "-I" "sy")))
    ;; a nested header with `#pragma GCC system_header` (gcc 0)
    (is (= [:ok 0] (errs "m-p.c" "-I" "i")))
    ;; the other direction: a -I header a system header includes is a system header (gcc 0; -I sy2: 1)
    (is (= [:ok 0] (errs "m-c.c" "-isystem" "sy2" "-I" "i2")))
    (is (= [:ok 1] (errs "m-c.c" "-I" "sy2" "-I" "i2")))
    ;; the preprocessor's records: i2/d.h entered from a system header is system (gcc -E's flag 3)
    (is (= [["sy2/c.h" true] ["i2/d.h" true]] (enters "m-c.c" "-isystem" "sy2" "-I" "i2")))
    (is (= [["i/a.h" false] ["sy/b.h" true]] (enters "m.c" "-I" "i" "-isystem" "sy")))))

;; queue 136: the libcpp rules review 130 found missing, each case run with gcc 15.2 -std=c23 -pedantic-errors -fsyntax-only -I i
;; -isystem sy in test/c/judge/sysx/chg (the counts) and with gcc -E (the enter records' flag 3)
(defn- chg-errs [main & opts]
  (let [h (host/load-host "test/c/host")
        base (str judge-dir "/sysx/chg")
        r (dg/read-file h base {:name main :read (str base "/" main)
                                :fc (host/file-config (vec (concat ["-std=c23" "-pedantic-errors"] (or (seq opts) ["-I" "i" "-isystem" "sy"]))) "gnu23")} :compile)]
    [(:status r) (:other r)]))

(defn- chg-enters [main]
  (let [h (host/load-host "test/c/host")
        fc (host/file-config ["-std=c23" "-I" "i" "-isystem" "sy"] "gnu23")
        r (cparse/parse (host/config h fc (str judge-dir "/sysx/chg")) main)]
    (mapv (juxt :path :system) (filter #(= "enter" (:directive %)) (:layer r)))))

(deftest main-file-status-after-a-system-header
  ;; the main file's status is its own again when a system header it includes is left: a -I header after it is not a system
  ;; header (gcc 1; before: the slot kept sy/z.h's status, 0), nor a quoted one beside the main file (gcc 1)
  (is (= [:ok 1] (chg-errs "m-st.c")))
  (is (= [:ok 1] (chg-errs "m-stq.c")))
  (is (= [["sy/z.h" true] ["i/w.h" false]] (chg-enters "m-st.c")))
  (is (= [["sy/z.h" true] ["q.h" false]] (chg-enters "m-stq.c"))))

(deftest includer-pragma-after-the-include
  ;; review 130's finding 1: i/p7.h includes <p7b.h>, then has `#pragma GCC system_header`: p7b.h was entered before the pragma
  ;; and is no system header (gcc 1; before: the includer's pragma anywhere counted, 0)
  (is (= [:ok 1] (chg-errs "m-p7.c")))
  (is (= [["i/p7.h" false] ["i/p7b.h" false]] (chg-enters "m-p7.c")))
  ;; i/p8.h has the pragma before its #include <p7b.h>: p7b.h is a system header (gcc 0; -E: `# 1 "i/p7b.h" 1 3`)
  (is (= [:ok 0] (chg-errs "m-p8.c")))
  (is (= [["i/p8.h" false] ["i/p7b.h" true]] (chg-enters "m-p8.c"))))

(deftest pragma-from-its-place-on
  ;; review 130's finding 2: `#pragma GCC system_header` makes the lines after it a system header's, not the lines before (gcc
  ;; 1 each; before: the pragma anywhere in the file silenced it all, 0): in the unit's top header (m-p1.c), in a nested one
  ;; (m-pn.c: i/pn.h includes <p1.h>), as _Pragma (m-op.c; before: the line regex missed it, 2)
  (is (= [:ok 1] (chg-errs "m-p1.c")))
  (is (= [:ok 1] (chg-errs "m-pn.c")))
  (is (= [:ok 1] (chg-errs "m-op.c")))
  ;; a pragma in an #if 0 group or a comment is none (gcc 2; before: the line regex took it, 0)
  (is (= [:ok 2] (chg-errs "m-p0.c")))
  ;; the pp's record: at the pragma's offset in its file, i/p0.h's none
  (let [h (host/load-host "test/c/host")
        fc (host/file-config ["-std=c23" "-I" "i" "-isystem" "sy"] "gnu23")
        sys (fn [main] (let [r (cparse/parse (host/config h fc (str judge-dir "/sysx/chg")) main)]
                         (mapv (juxt :file :system) (filter #(= "system" (:directive %)) (:layer r)))))]
    (is (= [["i/p1.h" true]] (sys "m-p1.c")))
    (is (= [["i/op.h" true]] (sys "m-op.c")))
    (is (= [] (sys "m-p0.c")))))

(deftest linemarker-flag-3
  ;; review 130's finding 3: a linemarker `# N "FILE"` in a header sets the status of the rest of its file and of the headers it
  ;; includes afterwards: flag 3 a system header's, no flag a user header's. sy/lp.h (-isystem) has `# 4 "sy/lp.h"`, then a
  ;; pedwarn and #include <lpc.h> (i/lpc.h, a pedwarn): gcc 2 (before: 0)
  (is (= [:ok 2] (chg-errs "m-lp.c")))
  (is (= [["sy/lp.h" true] ["i/lpc.h" false]] (chg-enters "m-lp.c")))
  ;; i/lm.h has a pedwarn, `# 4 "i/lm.h" 3`, a pedwarn, #include <lmc.h> (i/lmc.h, a pedwarn): gcc -E `# 1 "i/lmc.h" 1 3`, and
  ;; gcc's errors are i/lm.h's first pedwarn and the linemarker's own "style of line directive is a GCC extension", a pedwarn the
  ;; pp does not give (so 1 here, not gcc's 2; before: 3)
  (is (= [["i/lm.h" false] ["i/lmc.h" true]] (chg-enters "m-lm.c")))
  (is (= [:ok 1] (chg-errs "m-lm.c"))))

;; queue 157 (review 130's finding 4): a header entered more than once is judged entry by entry, each by its own status, its forms in the
;; unit of the main file's #include it came through. i/tw.h is unguarded, with a pedwarn (a _Generic association of incomplete type in a
;; _Static_assert, which may repeat); sy/tws.h includes it. gcc 15.2 (aarch64's, -std=c23 -pedantic-errors -fsyntax-only -I i -isystem
;; sy) gives 1 error each, the user entry's
(defn- chg-units [main]
  (let [h (host/load-host "test/c/host")
        fc (host/file-config ["-std=c23" "-I" "i" "-isystem" "sy"] "gnu23")
        rd (rc/read-c (host/config h fc (str judge-dir "/sysx/chg")) fc main false)]
    (vec (sort (map (fn [u] [(:path u) (:form-sys u)]) (vals (:units rd)))))))

(deftest header-entered-twice-by-its-entries
  ;; system first (through sy/tws.h: -E `# 1 "i/tw.h" 1 3 4`), then from the main file (`# 1 "i/tw.h" 1`): before, both entries'
  ;; forms were in tws.h's unit, judged by the first entry's status (0)
  (is (= [:ok 1] (chg-errs "m-tw.c")))
  (is (= [["i/tw.h" [false false false]] ["sy/tws.h" [true true true]]] (chg-units "m-tw.c")))
  ;; the other order: before, both in tw.h's unit, a user header's (2); the two units' forms are the same, judged otherwise: two units
  (is (= [:ok 1] (chg-errs "m-tw2.c")))
  (is (= [["i/tw.h" [false false false]] ["sy/tws.h" [true true true]]] (chg-units "m-tw2.c")))
  ;; i/tp.h has `#pragma GCC system_header` under #ifdef TP_SYS, which the main file defines between its two includes: the first
  ;; entry is a user header's, the second a system header's after the pragma (gcc 1; before: the pragma's record counted for both, 0)
  (is (= [:ok 1] (chg-errs "m-tp.c")))
  (is (= [["i/tp.h" [false false false]] ["i/tp.h" [true true true]]] (chg-units "m-tp.c")))
  ;; within one unit: i/twn.h includes <tw.h>, then has the pragma, then includes it again (-E: `# 1 "i/tw.h" 1`, then `1 3`): gcc 1
  ;; (before: both entries judged by the first's status, 2)
  (is (= [:ok 1] (chg-errs "m-twn.c")))
  (is (= [["i/twn.h" [false false false true true true]]] (chg-units "m-twn.c")))
  ;; the main file includes it twice (m-tw3.c): two units, each checked at its #include (gcc 2; before: both entries' forms in the first
  ;; unit, 2; the units of the same forms one unit checked once would give 1)
  (is (= [:ok 2] (chg-errs "m-tw3.c")))
  (is (= [["i/tw.h" [false false false]] ["i/tw.h" [false false false]]] (chg-units "m-tw3.c"))))

;; queue 157 (review 130's finding 5): a unit read back from its .ae (arbace.c.musl's cache: load-forms) has no :form-sys and is judged
;; by the old rule (CS214, review 079's finding 3): a system header by the directory of its :path, which load-forms keeps from the
;; c/header form (before: no :path, every such unit a user header's), and by a `#pragma GCC system_header` line anywhere in its file
(defn- reread-errs [dir main & opts]
  (let [h (host/load-host "test/c/host")
        base (str judge-dir "/sysx" (when dir (str "/" dir)))
        fc (host/file-config (vec (concat ["-std=c23" "-pedantic-errors"] opts)) "gnu23")
        rd (rc/read-c (host/config h fc base) fc main false)
        fr (str (System/getProperty "user.dir") "/.tmp/judge-reread/" (or dir "top") "-" main)]
    (doseq [[p t] (rc/unit-texts rd main)]
      (let [f (java.io.File. (str fr "/" p))] (.mkdirs (.getParentFile f)) (spit f t)))
    (spit (str fr "/" main ".units") (pr-str (vec (map str (keys (:units rd))))))
    (let [back ((requiring-resolve 'arbace.c.musl/load-forms) fr main)
          r (chk/check-unit (assoc rd :forms (:forms back) :units (:units back)) (keyword (:std fc)) (annot/builtin-forms h fc)
                            :pedantic (:pedantic fc) :ext-lines (:ext-lines rd) :sys-dirs (host/sys-dirs h fc) :base (:base rd))]
      [(every? (comp nil? :form-sys) (vals (:units back))) (count (:errors r))])))

(deftest reread-unit-by-the-old-rule
  ;; sy/ph.h found through -isystem sy: gcc 0 (before: 1), through -I sy: gcc 1
  (is (= [true 0] (reread-errs nil "m-ph.c" "-isystem" "sy")))
  (is (= [true 1] (reread-errs nil "m-ph.c" "-I" "sy")))
  ;; i/p1.h's pedwarn before its pragma: gcc 1, read from C 1 (pragma-from-its-place-on), read back 0: the old rule's pragma line
  ;; silences the whole file (before: 2, the pragma not seen with no :path)
  (is (= [true 0] (reread-errs "chg" "m-p1.c" "-I" "i" "-isystem" "sy"))))

(deftest gcc-reread-without-status
  ;; review 079's finding 5: a kept gcc output with no status (an interrupted run) is a difference, not an exception
  (let [work (str (System/getProperty "user.dir") "/.tmp/judge-gcc-status")
        d (java.io.File. (str work "/g/gcc"))]
    (.mkdirs d)
    (spit (str work "/g/files.edn") "[{:name \"a.c\"} {:name \"b.c\"}]")
    (spit (str work "/g/base.txt") work)
    (spit (str work "/g/dg.edn") (str "[[\"a.c\" " (pr-str (dg/analyze "/* { dg-do compile } */\n")) "] [\"b.c\" " (pr-str (dg/analyze "/* { dg-do compile } */\n")) "]]"))
    (spit (str work "/g/gcc/a.c.txt") "")
    (spit (str work "/g/gcc/a.c.status") "0\n")
    (spit (str work "/g/gcc/b.c.txt") "")
    (dg/gcc-cmd work "g")
    (let [rows (into {} (read-string (slurp (str work "/g/gcc.edn"))))]
      (is (= :yes (:agrees (get rows "a.c"))))
      (is (= :missing (:status (get rows "b.c"))))
      (is (not= :yes (:agrees (get rows "b.c")))))))

(deftest run-budget-per-program
  ;; CS216: a program listed in test/c/check-budget.edn (CI_BUDGETS) has more than the default 10 s; a stand-in cirun takes 12 s
  (let [root (System/getProperty "user.dir")
        work (doto (java.io.File. (str root "/.tmp/judge-test-budget")) (.mkdirs))
        ids (java.io.File. work "ids.txt")
        budgets (java.io.File. work "budget.edn")
        real (or (System/getenv "CIRUN") (str root "/.tmp/ci/cirun"))
        env {"CI_CHECK_WORK" (.getPath work) "CIRUN" (str root "/test/c/judge/cirun-slow") "CIRUN_REAL" real}]
    (when-not (and (System/getenv "CIRUN") (.exists (java.io.File. ^String real))) (sh-status {} "bin/ci" "cirun-build" "--ensure"))
    (try
      (spit ids "ci-run/ptr-sub-unsigned.c\n")
      (spit budgets "{\"ci-run/ptr-sub-unsigned.c\" 30}\n")
      (is (= "10" (str/trim (:out (sh-out-env {"CI_BUDGETS" (str (.getPath work) "/none.edn")} ["bash" "-c" ". bin/lib/ci/budget.bash; ci_budget ci-run/x.c"])))))
      (is (= "30" (str/trim (:out (sh-out-env {"CI_BUDGETS" (.getPath budgets)} ["bash" "-c" ". bin/lib/ci/budget.bash; ci_budget ci-run/ptr-sub-unsigned.c"])))))
      (is (= "30" (str/trim (:out (sh-out-env {} ["bash" "-c" "root=$PWD; . bin/lib/ci/budget.bash; ci_budget compcert/perlin.c"])))))
      (is (= 1 (sh-status (assoc env "CI_BUDGETS" (str (.getPath work) "/none.edn")) "bin/ci" "check" "--corpus" "ci-run" "--only" (.getPath ids))))
      (is (= 0 (sh-status (assoc env "CI_BUDGETS" (.getPath budgets)) "bin/ci" "check" "--corpus" "ci-run" "--only" (.getPath ids))))
      (finally
        (doseq [f (reverse (file-seq work))] (.delete ^java.io.File f))))))

(deftest gcc-output-kept-whole
  ;; CS201: gcc's output of a file with many warnings (c23-ucn-2: 186 lines, errors at its end) was cut at 20,000 bytes; the
  ;; diagnostics are filtered now, not truncated, so the late errors are there. 8,000 warnings (0.7 MB, far over the old 20,000 bytes) and then an error:
  (let [script (str "root=$PWD; . bin/lib/ci/gcc-diag.bash; "
                    "{ i=0; while [ $i -lt 8000 ]; do echo \"t.c:$i:5: warning: a long warning line of the output $i, to make it big enough ok\"; "
                    "echo \"  $i | #if U'x'\"; i=$((i+1)); done; echo \"t.c:972:5: error: late\"; echo \"t.c:973:1: fatal error: x: No such file or directory\"; "
                    "echo 'compilation terminated.'; } | gcc_diag")
        out (:out (sh-out-env {} ["bash" "-c" script]))
        ls (str/split-lines out)]
    (is (some #{"t.c:972:5: error: late"} ls))
    (is (some #{"t.c:973:1: fatal error: x: No such file or directory"} ls))
    (is (not-any? #(str/starts-with? % " ") ls))
    (is (not-any? #{"compilation terminated."} ls))))

(deftest fatal-error-at-an-expected-line
  ;; CS201: `#embed "no-such-file"` is a fatal error on the line its dg-error expects: gcc agrees with the directives
  (let [d (dg/analyze "/* { dg-do preprocess } */\n/* { dg-options \"\" } */\n\n#embed \"no-such-file\" /* { dg-error \"no-such-file: No such file or directory\" } */\n")
        g (dg/gcc-lines "embed-7.c:4:8: fatal error: no-such-file: No such file or directory\n" "embed-7.c")]
    (is (:fatal g))
    (is (= :yes (dg/gcc-agrees d g)))
    ;; a fatal error on another line than the directive's is still a difference
    (is (not= :yes (dg/gcc-agrees d (dg/gcc-lines "embed-7.c:5:8: fatal error: x: No such file or directory\n" "embed-7.c")))))
  ;; review 031's finding C: a fatal error in a header, or with no line, is not agreement with a file that expects none
  (let [d (dg/analyze "/* { dg-do compile } */\nint x;\n")
        d0 (dg/analyze "/* { dg-do compile } */\nint x;\n/* { dg-error \"\" \"\" { target *-*-* } 0 } */\n")]
    (is (= :yes (dg/gcc-agrees d (dg/gcc-lines "" "a.c"))))
    (is (not= :yes (dg/gcc-agrees d (dg/gcc-lines "h.h:1:10: fatal error: nope.h: No such file or directory\n" "a.c"))))
    (is (not= :yes (dg/gcc-agrees d (dg/gcc-lines "cc1: fatal error: nope.h: No such file or directory\n" "a.c"))))
    (is (= :yes (dg/gcc-agrees d0 (dg/gcc-lines "cc1: fatal error: nope.h: No such file or directory\n" "a.c"))))
    ;; review 053's finding 6: a plain error in a header, or with no line
    (is (not= :yes (dg/gcc-agrees d (dg/gcc-lines "h.h:3:1: error: bad\n" "a.c"))))
    (is (not= :yes (dg/gcc-agrees d (dg/gcc-lines "cc1: error: bad\n" "a.c"))))
    (is (= :yes (dg/gcc-agrees d0 (dg/gcc-lines "h.h:3:1: error: bad\n" "a.c"))))
    ;; review 057's finding 5: the reason is in the differ
    (is (= [:differ [] [] {:other 1 :fatal-other 0}] (dg/gcc-agrees d (dg/gcc-lines "h.h:3:1: error: bad\n" "a.c"))))
    (is (= [:differ [] [] {:other 0 :fatal-other 1}] (dg/gcc-agrees d (dg/gcc-lines "cc1: fatal error: x\n" "a.c"))))))

(deftest unlisted-selector-names-counted
  ;; CS210 (b): the dg-do, dg-error and xfail selectors keep CS142's rule (an unlisted name holds) and report the names
  (let [unk (atom #{})
        d (binding [dg/*unknown-names* unk]
            (dg/analyze (str "/* { dg-do compile { target no_such_effective_target } } */\n"
                             "int x = ;\t/* { dg-error \"expected\" \"\" { target { c && another_unlisted_name } } } */\n"
                             "int y = ;\t/* { dg-error \"expected\" \"\" { xfail c } } */\n")))]
    (is (= #{"no_such_effective_target" "another_unlisted_name"} @unk))
    (is (= :compile (:action d)))
    (is (= [2] (get-in d [:expect :error])))
    (is (= [3] (get-in d [:xfail :error]))))
  ;; listed names are not counted
  (let [unk (atom #{})]
    (binding [dg/*unknown-names* unk] (dg/analyze "/* { dg-do compile { target c } } */\nint x = ;\t/* { dg-error \"e\" \"\" { target { ! ia32 } } } */\n"))
    (is (= #{} @unk))))

(deftest message-as-verdict
  ;; CS200 (a): a pass whose dg-error regex matches none of the checker's messages needs a family of the wording table
  (let [wording {:families [{:id :f :gcc "discards .const. qualifier" :checker "discards qualifier" :files ["g/a.c"]}]
                 :wrong-reason {"g/w.c" "another reason"}}
        d (dg/analyze (str "/* { dg-do compile } */\nint x = 1;\t/* { dg-error \"discards 'const' qualifier\" } */\n"))
        r (fn [msg] {:status :ok :lines {2 1} :all-texts {2 [(str "2: " msg)]} :texts {2 (str "2: " msg)} :other 0 :unlocated 0})]
    ;; the regex matches: nothing to say
    (is (nil? (dg/message-verdict wording "g/a.c" d (r "assignment discards 'const' qualifier"))))
    ;; the family explains the checker's wording
    (is (nil? (dg/message-verdict wording "g/a.c" d (r "assignment discards qualifier from pointer target type"))))
    ;; neither: a regression, unless the file is listed as another reason
    (is (= :message (first (dg/message-verdict wording "g/a.c" d (r "something else entirely")))))
    (is (= [:wrong-reason "another reason"] (dg/message-verdict wording "g/w.c" d (r "something else entirely")))))
  ;; the committed table covers the corpus: every family has the keys, and its patterns are regexes
  (let [w (dg/load-wording)]
    (is (seq (:families w)))
    (is (every? (fn [f] (and (keyword? (:id f)) (re-pattern (:gcc f)) (re-pattern (:checker f)))) (:families w)))
    (is (= 13 (count (:wrong-reason w))))
    (is (every? (fn [[_ v]] (and (seq (:lines v)) (string? (:why v)))) (:wrong-reason w)))))

(deftest every-directive-needs-a-message
  ;; CS236 (a): a line with two dg-error regexes passes only when each matches a message (gcc's dg matches every directive)
  (let [wording {:families [] :wrong-reason {}}
        d (dg/analyze "/* { dg-do compile } */\nint x = 1;\n\nint y = 2;\t/* { dg-error \"aa\" } */ /* { dg-error \"bb\" } */\n")
        row (fn [& ts] {:status :ok :lines {4 1} :all-texts {4 (vec ts)} :texts {4 (first ts)} :other 0 :unlocated 0})
        l (first (keys (:msgs d)))]
    (is (= 2 (count (get (:msgs d) l))))
    (is (nil? (dg/message-verdict wording "g/a.c" d (row "4: aa" "4: bb"))))
    (is (= :message (first (dg/message-verdict wording "g/a.c" d (row "4: aa")))))
    (is (= :message (first (dg/message-verdict wording "g/a.c" d (row "4: cc")))))))

(deftest families-name-their-files-and-wrong-reason-its-wording
  ;; CS238 (a): every family names its :files (none: it explains nothing), and a wrong-reason entry's :checker regex is matched
  (let [w (dg/load-wording)]
    (is (every? (fn [f] (seq (:files f))) (:families w)))
    (is (every? (fn [[_ v]] (string? (:checker v))) (:wrong-reason w))))
  (let [d (dg/analyze "/* { dg-do compile } */\nint x = 1;\n\nint y = 2;\t/* { dg-error \"aa\" } */\n")
        row (fn [msg] {:status :ok :lines {4 1} :all-texts {4 [(str "4: " msg)]} :texts {4 (str "4: " msg)} :other 0 :unlocated 0})
        nofiles {:families [{:id :f :gcc "aa" :checker "bb"}] :wrong-reason {}}
        wr {:families [] :wrong-reason {"g/w.c" {:lines [4] :checker "third|second" :why "another reason"}}}]
    (is (= :message (first (dg/message-verdict nofiles "g/a.c" d (row "bb")))))
    (is (= [:wrong-reason "another reason"] (dg/message-verdict wr "g/w.c" d (row "second wording"))))
    (is (= :message (first (dg/message-verdict wr "g/w.c" d (row "a fourth wording")))))))

(deftest dash-I-is-refused
  ;; CS239 (a): -I- is refused (a class of its own), not judged on a wrong search order
  (let [r (read-one "inc-check.c" :compile ["-std=gnu23" "-I-"])]
    (is (= :refused (:status r)))
    (is (re-find #"^option -I-: not modelled" (:message r)))
    (is (= [:fail :refused (:message r)] (dg/verdict (dg/analyze "/* { dg-do compile } */") r))))
  (is (not= :refused (:status (read-one "inc-check.c" :compile ["-std=gnu23"]))))
  (let [h (host/load-host "test/c/host")
        u (run/read-unit h ["-std=gnu23" "-I-"] judge-dir "inc-check.c")]
    (is (= :read-refused (:status u)))
    (is (re-find #"^option: option -I-" (:message u)))))

(deftest read-error-prefix-is-not-the-message
  ;; review 053's finding 3: the FILE:LINE:COL: of a read error is not part of the message a dg-error regex matches
  (let [wording {:families [] :wrong-reason {}}
        d (dg/analyze "/* { dg-do compile } */\nint x = 1;\n\nint y = 2;\n\nint z;\t/* { dg-error \"macro\" } */\n")
        row (fn [txt] {:status :read-error :lines {6 1} :all-texts {6 [txt]} :texts {6 txt} :other 0 :unlocated 0})]
    (is (= :message (first (dg/message-verdict wording "g/a.c" d (row "macro.c:6:1: expected ';' before 'y'")))))
    (is (nil? (dg/message-verdict wording "g/a.c" d (row "x.c:6:1: unterminated macro call"))))))

(deftest wording-families-pinned
  ;; review 031's finding E: a family with :files applies to those files alone, its patterns are anchored, and a wrong-reason file
  ;; names its lines: an unexplained line outside them fails
  (let [w (dg/load-wording)
        d (dg/analyze "/* { dg-do compile } */\nint x = 1;\n\nint y = 2;\t/* { dg-error \"redefinition\" } */\n")
        r (fn [msg] {:status :ok :lines {4 1} :all-texts {4 [(str "4: " msg)]} :texts {4 (str "4: " msg)} :other 0 :unlocated 0})
        tag "gcc-c23/gcc.dg/c23-tag-1.c"]
    (is (nil? (dg/message-verdict w tag d (r "conflicting types for 'A'"))))
    (is (= :message (first (dg/message-verdict w "gcc-c23/gcc.dg/other.c" d (r "conflicting types for 'A'")))))
    (is (= :message (first (dg/message-verdict w tag d (r "something conflicting types for 'A' else"))))))
  (let [wording {:families [] :wrong-reason {"g/w.c" {:lines [4] :why "another reason"}}}
        d (dg/analyze "/* { dg-do compile } */\nint x = 1;\n\nint y = 2;\t/* { dg-error \"aa\" } */\nint z = 3;\t/* { dg-error \"bb\" } */\n")
        r (fn [ls] {:status :ok :lines (into (sorted-map) (map #(vector % 1) ls)) :all-texts (into {} (map #(vector % [(str % ": other")]) ls))
                    :texts (into {} (map #(vector % (str % ": other")) ls)) :other 0 :unlocated 0})]
    (is (= [:wrong-reason "another reason"] (dg/message-verdict wording "g/w.c" d (r [4]))))
    (is (= :message (first (dg/message-verdict wording "g/w.c" d (r [4 5])))))))

(deftest bad-specs-keep-qualifiers
  ;; review 031's finding G (CS203 (a)): a declare-specs printed from its words writes its qualifiers first, so the reread is equal
  (let [h (host/load-host "test/c/host")
        fc (host/file-config ["-std=c23"] "gnu23")
        rd (rc/read-c (host/config h fc judge-dir) fc "bad-specs-quals.c" false)
        txt (rc/print-c (:file-form rd) (:forms rd))]
    (is (nil? (:error rd)))
    (is (re-find #"const int bool;" txt))
    (is (re-find #"volatile const char bool;" txt))
    ;; CS237 (a): _Atomic, which (atomic T) cannot tell from the specifier, comes through the converter's mark
    (is (re-find #"(?m)^_Atomic int bool;" txt))
    (is (re-find #"const _Atomic int bool;" txt))))

(deftest bad-specs-print-the-words
  ;; queue 168 (CS221 (a) with CS232 (a), the user, 2026-11-03): a c/var, c/declare, c/typedef, member, parameter or definition
  ;; with conflicting specifiers prints its words as written, _BitInt with its width (gcc-bitint's bitint-1.c: long _BitInt(42) h;),
  ;; so the reread keeps :c/bad-specs and its forms are the original's (the round trip's level 1); before: _BitInt(42) h;
  (let [h (host/load-host "test/c/host")
        fc (host/file-config ["-std=c23"] "gnu23")
        rd (rc/read-c (host/config h fc judge-dir) fc "bad-specs-words.c" false)
        txt (rc/print-c (:file-form rd) (:forms rd))
        pdir (doto (java.io.File. (str (System/getProperty "user.dir") "/.tmp/judge-test-bad-specs")) (.mkdirs))
        _ (spit (str pdir "/bad-specs-words.c") txt)
        rd2 (rc/read-c (host/config h fc (str pdir)) fc "bad-specs-words.c" false)
        ftext (fn [r] (str/join "\n" (map #(layout/form-str (rt/strip %)) (:forms r))))]
    (is (nil? (:error rd)))
    (is (nil? (:error rd2)))
    (doseq [re [#"(?m)^long _BitInt\(42\) h;" #"(?m)^unsigned short _BitInt\(7\) \*p;" #"(?m)^unsigned short _BitInt\(7\) q;"
                #"(?m)^const long _Bool z;" #"(?m)^typedef int _BitInt\(9\) T;" #"(?m)^long _BitInt\(8\) f\(void\);"
                #"short _BitInt\(5\) m;" #"(?m)^void g\(long _BitInt\(6\) a\);" #"(?m)^long _BitInt\(10\);"]]
      (is (re-find re txt) (str re)))
    (is (= (ftext rd) (ftext rd2)))))

(deftest read-error-cannot-stand-for-a-semantic-message
  ;; review 031's finding B: a read error stands for an expected line only when its text matches the line's regexes (or a family)
  (let [wording {:families [] :wrong-reason {}}
        d (dg/analyze "/* { dg-do compile } */\nint x = 1;\n\nint y = 2;\n\nf (x);\t/* { dg-error \"expected 'int' but argument\" } */\n")
        row (fn [line txt] {:status :read-error :lines {line 1} :all-texts {line [txt]} :texts {line txt} :other 0 :unlocated 0})
        l (first (keys (:msgs d)))]
    (is (= [:pass] (dg/verdict d (row l "expected ';' before 'x'"))))
    (is (= 1 (count (dg/msg-mismatch d (row l "expected ';' before 'x'")))))
    (is (= :message (first (dg/message-verdict wording "g/a.c" d (row l "expected ';' before 'x'")))))
    (is (nil? (dg/message-verdict wording "g/a.c" d (row l "expected 'int' but argument is of type 'char *'"))))))

(deftest main-file-is-the-whole-path
  ;; suffix.c includes xsuffix.c, whose name ends with the main's: its error is another file's
  (let [r (read-one "suffix.c" :compile)]
    (is (= {} (:lines r)))
    (is (= 1 (:unlocated r)))
    (is (= :stopped (second (dg/verdict (dg/analyze (slurp (str judge-dir "/suffix.c"))) r)))))
  (let [g (dg/gcc-lines "x-embed-1.c:3:1: error: a\nembed-1.c:4:1: error: b\n" "embed-1.c")]
    (is (= {4 1} (:error g)))
    (is (= 1 (:other g)))))

(deftest parser-panic-is-a-crash
  ;; the parser's panic stood in for (the night of 2026-11-02): 30,000 nested parentheses exhausted the evaluated parser's
  ;; stack, but not the compiled one's (C embedded in stage 0 since the re-seed), so the panic no longer depends on the host
  (let [r (with-redefs [cparse/parse-sources (fn [& _] {:panic "stack overflow"})]
            (read-one "parser-panic.c" :compile))]
    (is (= :crash (:status r)))
    (is (= :crash (second (dg/verdict (dg/analyze (slurp (str judge-dir "/parser-panic.c"))) r))))))

;; review 027, finding 9: CS172's layout, kept and documented (doc/C23-SURVEY.md, "As built: re-review 027's fixes"): a
;; definition's name carries its declarator's line, so the .ae puts it on that line, as every nested form is put on its C line

(deftest definition-name-layout
  (let [root (System/getProperty "user.dir")
        out (java.io.File. (str root "/.tmp/judge-test-layout"))]
    (try
      (is (= 0 (sh-status {} "bin/repr-c" "read" "-o" (.getPath out) "test/c/judge/gnu-defn.c")))
      (let [lines (vec (str/split-lines (slurp (java.io.File. out "test/c/judge/gnu-defn.c.ae"))))]
        (is (= "(c/defn" (nth lines 2)))
        (is (str/starts-with? (str/trim (nth lines 3)) "^:static foo ^int [void]"))
        (is (str/includes? (nth lines 5) "(return 1)"))
        (is (= "(c/defn bar ^int [void] (return 2))" (nth lines 7))))
      (finally
        (doseq [f (reverse (file-seq out))] (.delete ^java.io.File f))))))

;; GTS81 (a), queue 064: the negative controls (test/c/controls.edn). The dg level's control-result on made-up directives and
;; reads: the subject's read against another file's directives differs, against its own passes (a control made to pass), and
;; a reference absent from its group is not judged; a group not judged leaves it. The run level's on a made-up work directory.

(deftest dg-controls
  (let [d-a (dg/analyze "/* { dg-do compile } */\nint a; /* { dg-error \"e\" } */\n")
        d-b (dg/analyze "/* { dg-do compile } */\n\nint b; /* { dg-error \"e\" } */\n")
        dgs {"g" {"a.c" d-a "b.c" d-b}}
        rds {"g" {"a.c" (assoc (ok {2 1}) :texts {2 "2: e"}) "b.c" (assoc (ok {3 1}) :texts {3 "3: e"})}}
        w {:families [] :wrong-reason {}}
        c {:subject "g/a.c" :reference "g/b.c"}]
    (is (= [:pass] (dg/verdict d-a (get-in rds ["g" "a.c"]))))
    (is (= :differs (dg/control-result w dgs rds c)))
    (is (= :passes (dg/control-result w dgs rds (assoc c :reference "g/a.c"))))
    (is (= :not-judged (dg/control-result w dgs rds (assoc c :reference "g/z.c"))))
    (is (= :left (dg/control-result w (dissoc dgs "g") rds c)))))

(deftest run-controls
  (let [dir (java.io.File. (str (System/getProperty "user.dir") "/.tmp/ci-judge-test-controls/c"))
        _ (.mkdirs dir)
        w (.getParent dir)
        sha-a "2dc0a3cd4a547ba69389f97f3b447bd4d487fe6216c3cacd2f9bf8c908dc127f"
        refs {"c/a.c" {:id "c/a.c" :status 0 :stdout sha-a :o2 :same} "c/b.c" {:id "c/b.c" :status 0 :stdout empty-sha :o2 :same}}
        c {:subject "c/a.c" :reference "c/b.c"}]
    (spit (str dir "/list.tsv") "c/a.c\tbase\tc11\t\tc/a.c\n")
    (spit (str dir "/nodes.tsv") "c/a.c\tok\t\t\t\n")
    (spit (str dir "/run.tsv") (str "c/a.c\t0\t" sha-a "\t24\t\n"))
    (is (= :differs (run/control-result w refs ["c"] c)))
    (is (= :passes (run/control-result w refs ["c"] (assoc c :reference "c/a.c"))))
    (is (= :not-judged (run/control-result w refs ["c"] (assoc c :reference "c/z.c"))))
    (is (= :left (run/control-result w refs ["d"] c)))))

;; CS240 (a): the token, tree, round-trip and checker's checks write a results file at --record (arbace.repr.c.results), every
;; file's row [ID RESULT REASON]; bin/reap's :c-known reader counts its passes and holds it to the known file
(deftest results-files-give-the-counts
  (require 'arbace.repr.c.results 'reap.main)
  (let [write (resolve 'arbace.repr.c.results/write)
        read-source (resolve 'reap.main/read-source)
        w (str (System/getProperty "user.dir") "/.tmp/judge-test-results")
        put (fn [id s] (.mkdirs (java.io.File. (str w "/" id))) (spit (str w "/" id "/files.tsv") s))
        out (str w "/results.edn")]
    (.delete (java.io.File. out))
    ;; the token check: lex, pp and gcc per file; a lex difference known only when the known file's :lex lists it
    (put "a" (str "x.c\tequal\tequal\td1\tagree\n" "y.c\tdiffer\tequal\td2\tagree\n" "z.c\tequal\tgcc\td3\tknown\n"
                  "w.c\tdiffer\tequal\td4\tagree\n" "v.c\tequal\tdiffer\td5\tdiffer\n"))
    (is (= 1 (write :tokens w out {:a {"y.c" {:class :k}}} ["a"])))
    (is (= {"a v.c" :fail "a w.c" :fail "a x.c" :pass "a y.c" :known "a z.c" :known}
           (into {} (map (fn [[id r]] [id r]) (read-string (slurp out))))))
    ;; the tree check (pp-known: the token check's known file accounts for it), a second corpus kept beside the first
    (put "b" "p.c\tequal\t3\t0\t\nq.c\tpp-known\t3\t0\tpp's class :k\nr.c\tcrash\t0\t0\tboom\n")
    (is (= 1 (write :parse w out {} ["b"])))
    (is (= 8 (count (read-string (slurp out)))))
    ;; a corpus run again replaces its rows alone
    (put "b" "p.c\tequal\t3\t0\t\nq.c\tknown\t3\t0\tclass :k\n")
    (is (= 0 (write :parse w out {} ["b"])))
    (is (= ["a v.c" "a w.c" "a x.c" "a y.c" "a z.c" "b p.c" "b q.c"] (map first (read-string (slurp out)))))
    ;; the round trip's and the checker's statuses
    (put "c" "m.c\tpass\tok\tpass\tpass\tpass\t-\tagree\t\t\nn.c\tknown\tok\tpass\tdiffer\tpass\t-\tagree\tobjects\t\n")
    (is (= 0 (write :roundtrip w (str w "/rt.edn") {} ["c"])))
    (put "d" "m.c\tpass\tequal\tagree\t\t\nn.c\tfail\tdiffer\tagree\t\tline 3\n")
    (is (= 1 (write :annot w (str w "/an.edn") {} ["d"])))
    ;; bin/reap: the passes counted from the results, the known file's entries the judged part
    (spit (str w "/known.edn") (pr-str {:classes {:k "a class"} :parse {:b {"q.c" {:class :k}}}}))
    (let [src {:name "t" :reader :c-known :file (str w "/known.edn") :section :parse :results (str w "/rt-b.edn")}]
      (spit (:results src) (pr-str [["b p.c" :pass "equal"] ["b q.c" :known "known"]]))
      (let [r (read-source src)]
        (is (= 1 (:pass r)))
        (is (= ["b q.c"] (map :id (:entries r))))
        (is (empty? (:results-problems r))))
      ;; a failure recorded, a known file's entry the results pass, an entry the results' corpus lacks: problems
      (spit (:results src) (pr-str [["b p.c" :fail "crash"] ["b q.c" :pass "equal"]]))
      (is (= 2 (count (:results-problems (read-source src)))))
      (spit (:results src) (pr-str [["b p.c" :pass "equal"]]))
      (is (= 1 (count (:results-problems (read-source src)))))
      ;; queue 132: results of another corpus only (a --record over fewer corpora), or none at all: the known file's entries
      ;; absent from them are a problem, not a full count
      (spit (:results src) (pr-str [["a x.c" :pass "equal"]]))
      (is (= 1 (count (:results-problems (read-source src)))))
      (spit (:results src) (pr-str []))
      (is (= 1 (count (:results-problems (read-source src)))))
      ;; no results file yet: the count partial, as before CS240 (a)
      (.delete (java.io.File. ^String (:results src)))
      (is (nil? (:pass (read-source src)))))))

;; queue 122, finding 3: a :c-known source's section the known file lacks is a problem (it gave no entries, the cell nothing)
(deftest c-known-section-missing
  (require 'reap.main)
  (let [read-source (resolve 'reap.main/read-source)
        w (str (System/getProperty "user.dir") "/.tmp/judge-test-sections")
        f (str w "/known.edn")]
    (.mkdirs (java.io.File. w))
    (spit f (pr-str {:classes {:k "a class"} :pp {:a {"x.c" {:class :k}}} :lex {}}))
    (is (= [] (:sections-missing (read-source {:reader :c-known :file f :sections [:pp :lex]}))))
    (is (= [:gcc] (:sections-missing (read-source {:reader :c-known :file f :sections [:pp :lex :gcc]}))))
    (is (= [:roundtrips] (:sections-missing (read-source {:reader :c-known :file f :section :roundtrips}))))))

;; queue 122, findings 4 and 6: the token check's file listed at several levels is one non-pass of its worst kind (:per-file), and
;; C's eval record must hold exactly the programs gcc built (:ref-runs, every form of the reference runs read)
(deftest per-file-and-ref-runs
  (require 'reap.main)
  (let [per-file @(resolve 'reap.main/per-file)
        case-problems @(resolve 'reap.main/case-problems)
        d {:id :d} b {:id :b}
        es [{:id "a x.c" :class b :kind :design :reason "b: one" :n 1} {:id "a x.c" :class d :kind :deferred :reason "d: two" :n 1}
            {:id "a y.c" :class b :kind :design :reason "b: one" :n 1} {:id "a z.c" :class nil :kind nil :reason "?" :n 1}
            {:id "a z.c" :class b :kind :design :reason "b: one" :n 1}]
        m (per-file es)
        w (str (System/getProperty "user.dir") "/.tmp/judge-test-refruns")
        ref (str w "/ref.edn")]
    (is (= ["a x.c" "a y.c" "a z.c" "a z.c"] (map :id m)))
    (is (= [:deferred "d: two (also: b)"] ((juxt :kind :reason) (first m))))
    (.mkdirs (java.io.File. w))
    (spit ref "{:id \"c/a.c\" :status 0}\n{:id \"c/b.c\" :status :no-build}\n{:id \"c/c.c\" :status 1}\n")
    (is (empty? (case-problems {:name "t" :file "r" :ref-runs ref} {:ids ["c/a.c" "c/c.c"]})))
    (is (= 1 (count (case-problems {:name "t" :file "r" :ref-runs ref} {:ids ["c/a.c"]}))))
    (is (= 1 (count (case-problems {:name "t" :file "r" :ref-runs ref} {:ids ["c/a.c" "c/b.c" "c/c.c"]}))))))

;; queue 132 F3 (the user, 2026-11-02): C's read cell counts each corpus file once over the token and tree checks (:count-once), a
;; file passing only when both pass it, and leaves the mutants out (:exclude-corpora), their rows and entries alike
(deftest read-cell-counts-each-file-once
  (require 'reap.main)
  (let [judge-cell @(resolve 'reap.main/judge-cell)
        read-source (resolve 'reap.main/read-source)
        w (str (System/getProperty "user.dir") "/.tmp/judge-test-once")
        f (fn [n x] (let [p (str w "/" n)] (spit p (pr-str x)) p))
        _ (.mkdirs (java.io.File. w))
        cf (let [p (str w "/classes.edn")]
             (spit p "[{:id :k :title \"t\" :kind :deferred :why \"w\" :decided \"x\" :match [#\"^known k:\"]}]") p)
        ka (f "a-known.edn" {:classes {:k "a class"} :pp {:c1 {"x.c" {:class :k}}}})
        kb (f "b-known.edn" {:classes {:k "a class"} :parse {:c1 {"x.c" {:class :k} "z.c" {:class :k}} :mutants {"m1.c" {:class :k}}}})
        ra (str w "/a-results.edn") rb (str w "/b-results.edn")
        src (fn [k r & kvs] (apply assoc {:name k :unit "files" :reader :c-known :file k :results r :count-once :g
                                          :exclude-corpora ["mutants"]} kvs))
        cell {:classes cf :kind-map {:gap :deferred}
              :sources [(src ka ra :sections [:pp]) (src kb rb :section :parse)]}]
    (doseq [p [ra rb]] (.delete (java.io.File. ^String p)))
    ;; no results yet: x.c known by both checks one deferred case, z.c another; the mutant's entry not counted; the passes partial
    (let [c (judge-cell cell)]
      (is (= [0 2 true] ((juxt :pass :deferred :pass-partial) c)))
      (is (empty? (mapcat :problems (:sources c)))))
    ;; both results: y.c passes both, w.c the one check that has it, z.c passes the token check but not the tree check
    (f "a-results.edn" [["c1 w.c" :pass "equal"] ["c1 x.c" :known "known"] ["c1 y.c" :pass "equal"] ["c1 z.c" :pass "equal"]])
    (f "b-results.edn" [["c1 x.c" :known "known"] ["c1 y.c" :pass "equal"] ["c1 z.c" :known "known"]
                        ["mutants m1.c" :known "known"] ["mutants m2.c" :pass "equal"]])
    (let [c (judge-cell cell)]
      (is (= [2 2 false] ((juxt :pass :deferred :pass-partial) c)))
      (is (empty? (mapcat :problems (:sources c))))
      ;; each check alone still counts its own (the mutants left out): 3 and 1 passes
      (is (= [3 1] (map :pass (:sources c)))))
    ;; the results are still held to the known file over every corpus: the mutant's known entry absent from them is a problem
    (f "b-results.edn" [["c1 x.c" :known "known"] ["c1 y.c" :pass "equal"] ["c1 z.c" :known "known"]])
    (is (= 1 (count (:results-problems (read-source (src kb rb :section :parse))))))))

;; GTS81 (a), queue 144: repr/c's and the checker's controls (test/c/controls.edn), each judged on a made-up work directory: the
;; subject's dump against another file's reference differs, against its own passes (a control made to pass), a reference
;; without one is not judged, a corpus not in the run leaves it. A helper writes the files.
(defn- put-files [dir files]
  (doseq [[p s] files] (let [f (java.io.File. (str dir "/" p))] (.mkdirs (.getParentFile f)) (spit f s))))

(deftest token-controls
  (require 'arbace.repr.c.ppcheck)
  (let [res (resolve 'arbace.repr.c.ppcheck/token-control-result)
        w (str (System/getProperty "user.dir") "/.tmp/ci-judge-test-controls-tokens")
        g {"c/a.c" "DA" "c/b.c" "DB"}
        r (fn [lvl ids levels g s rf] (res w ids levels g {:level lvl :subject s :reference rf}))]
    (put-files w {"c/files.edn" "[{:name \"a.c\" :out \"a.c.tsv\"} {:name \"b.c\" :out \"b.c.tsv\"}]\n"
                  "c/port-pp/a.c.tsv" "int\tx\t\n#error\tmine\n" "c/cc-pp/a.c.tsv" "int\tx\t\n#error\tcc's\n"
                  "c/cc-pp/b.c.tsv" "double\tx\t\n" "c/port-lex/a.c.tsv" "int\n" "c/cc-lex/a.c.tsv" "int\n"
                  "c/cc-lex/b.c.tsv" "double\n" "c/files.tsv" "a.c\tequal\tequal\tDA\tagree\n"})
    (doseq [lvl [:pp :lex]]
      (is (= :differs (r lvl ["c"] #{"lex" "pp"} g "c/a.c" "c/b.c")))
      (is (= :passes (r lvl ["c"] #{"lex" "pp"} g "c/a.c" "c/a.c")))
      (is (= :not-judged (r lvl ["c"] #{"lex" "pp"} g "c/a.c" "c/z.c")))
      (is (= :left (r lvl ["d"] #{"lex" "pp"} g "c/a.c" "c/b.c"))))
    (is (= :left (r :lex ["c"] #{"pp"} g "c/a.c" "c/b.c")))
    (is (= :differs (r :gcc-digest ["c"] #{"pp"} g "c/a.c" "c/b.c")))
    (is (= :passes (r :gcc-digest ["c"] #{"pp"} g "c/a.c" "c/a.c")))
    (is (= :passes (r :gcc-digest ["c"] #{"pp"} (assoc g "c/b.c" :rejected) "c/a.c" "c/b.c")))
    (is (= :not-judged (r :gcc-digest ["c"] #{"pp"} (dissoc g "c/b.c") "c/a.c" "c/b.c")))))

(deftest tree-controls
  (require 'arbace.repr.c.parsecheck)
  (let [res (resolve 'arbace.repr.c.parsecheck/tree-control-result)
        w (str (System/getProperty "user.dir") "/.tmp/ci-judge-test-controls-tree")
        r (fn [ids s rf] (res w ids {:level :tree :subject s :reference rf}))]
    (put-files w {"c/files.edn" "[{:name \"a.c\" :out \"a.c.tsv\"} {:name \"b.c\" :out \"b.c.tsv\"} {:name \"n.c\" :out \"n.c.tsv\"}]\n"
                  "c/control/a.c.tsv.port" "TranslationUnit\t0\nint\t1:1\n" "c/cc-tree/a.c.tsv" "TranslationUnit\t0\nint\t1:1\n"
                  "c/cc-tree/b.c.tsv" "TranslationUnit\t0\ndouble\t1:1\n"})
    (is (= :differs (r ["c"] "c/a.c" "c/b.c")))
    (is (= :passes (r ["c"] "c/a.c" "c/a.c")))
    (is (= :not-judged (r ["c"] "c/a.c" "c/n.c")))
    (is (= :left (r ["c"] "c/n.c" "c/b.c")))
    (is (= :left (r ["d"] "c/a.c" "c/b.c")))))

;; queue 158: a redeclaration through a union parameter, as gcc's type_lists_compatible_p allows it (torture-compile's
;; pr34885.c and pr46866.c, reduced), and the conflicts it still leaves (transparent_union dropped by the union's mode,
;; compute_record_mode: a first member of floating type among them); under -pedantic-errors composite_type's pedwarn

(deftest transparent-union-redeclaration
  (let [d (dg/analyze (slurp (str judge-dir "/transparent-union.c")))
        r (read-one "transparent-union.c" :compile ["-std=gnu23"])]
    (is (= :ok (:status r)))
    (is (= [25 28 30 32 35 47 50 53 57] (vec (keys (:lines r)))))
    (is (= [:pass] (dg/verdict d r))))
  (let [d (dg/analyze (slurp (str judge-dir "/transparent-union-pedantic.c")))
        r (read-one "transparent-union-pedantic.c" :compile ["-std=gnu23" "-pedantic-errors"])]
    (is (= [6 8 11] (vec (keys (:lines r)))))
    (is (= [:pass] (dg/verdict d r)))))

(deftest annot-controls
  (let [w (str (System/getProperty "user.dir") "/.tmp/ci-judge-test-controls-annot")
        r (fn [ids s rf] (annot/annot-control-result w ids {:level :annot :subject s :reference rf}))]
    (put-files w {"c/files.edn" (str "[{:name \"a.c\" :out \"a.c.tsv\"} {:name \"b.c\" :out \"b.c.tsv\"} {:name \"p.c\" :out \"p.c.tsv\"}"
                                     " {:name \"g.c\" :out \"g.c.tsv\"} {:name \"n.c\" :out \"n.c.tsv\"}]\n")
                  "c/port/a.c.tsv" "@3\nd main e int()\ne int 0 = 0\n" "c/cc/a.c.tsv" "@3\ne int 0 = 0\nd main e int()\n"
                  "c/cc/b.c.tsv" "@5\nd fasta e void(int)\n@9\ne double\n" "c/cc/p.c.tsv" "#panic\tcc fails\n"
                  "c/cc/g.c.tsv" "@3\nd main e int()\ne int 0 = 7\n"})
    (is (= :differs (r ["c"] "c/a.c" "c/b.c")))
    (is (= :passes (r ["c"] "c/a.c" "c/a.c")))
    ;; every differing item cc's gap (:cc-folds): classed, a pass of the judge, so the control passes
    (is (= :passes (r ["c"] "c/a.c" "c/g.c")))
    (is (= :not-judged (r ["c"] "c/a.c" "c/p.c")))
    (is (= :not-judged (r ["c"] "c/a.c" "c/n.c")))
    (is (= :left (r ["c"] "c/n.c" "c/b.c")))
    (is (= :left (r ["d"] "c/a.c" "c/b.c")))))

(deftest annot-record-writes-no-placeholder
  ;; queue 122 F1: --record keeps a file's class, writes the judge's own class of a file it gave one (gcc-rejects, pp-known)
  ;; with its text, and leaves a failing file of no class out, printed and counted (the run fails), never :unclassified
  (let [w (str (System/getProperty "user.dir") "/.tmp/ci-judge-test-annot-record")
        kf (str w "/known.edn")]
    (put-files w {"c/files.tsv" (str "a.c\tpass\tequal\tagree\t\t\n" "k.c\tknown\tdiffer\tagree\tcc-layout\t@1 x\n"
                                     "g.c\tknown\tdiffer\tboth-reject\tgcc-rejects\t@2 y\n" "f.c\tfail\tequal\tfalse-error\t\t3: boom\n")
                  "known.edn" (pr-str {:classes {:cc-layout "layout"} :annot {:c {"k.c" {:class :cc-layout} "s.c" {:class :cc-layout}}}})})
    (is (= 1 (annot/record w ["c"] (constantly nil) kf)))
    (let [m (read-string (slurp kf))]
      (is (= {"k.c" {:class :cc-layout} "g.c" {:class :gcc-rejects}} (get-in m [:annot :c])))
      (is (= #{:cc-layout :gcc-rejects} (set (keys (:classes m)))))
      (is (not (re-find #"unclassified" (slurp kf)))))
    ;; a guess classes the failing file
    (is (= 0 (annot/record w ["c"] (fn [_ er _] (when (= er "false-error") :checker-gap)) kf)))
    (is (= {:class :checker-gap} (get-in (read-string (slurp kf)) [:annot :c "f.c"])))))

(deftest token-record-writes-no-placeholder
  ;; queue 122 F1: the token check's --record keeps a file's class, else classify's, and leaves a file of no class out
  ;; (printed and counted), never :unclassified; at :gcc only a kept class
  (require 'arbace.repr.c.ppcheck)
  (let [rec (resolve 'arbace.repr.c.ppcheck/record)
        w (str (System/getProperty "user.dir") "/.tmp/ci-judge-test-tokens-record")
        b (str w "/src")
        kf (str w "/known.edn")
        rej (fn [nm port-err] {(str "c/gcc/" nm ".i") "x\n" (str "c/gcc/" nm ".status") "1\n"
                               (str "c/port-pp/" nm ".tsv") (if port-err "#error x\n" "x\n")})]
    (put-files w (merge {"c/base.txt" b "c/files.tsv" "e.c\tdiffer\tequal\td1\nz.c\tdiffer\tequal\td2\ng.c\tequal\tequal\td3\nh.c\tequal\tequal\td4\n"
                         "src/e.c" "#embed \"f\"\n" "src/z.c" "int x;\n" "src/g.c" "int g;\n" "src/h.c" "int h;\n"
                         "known.edn" (pr-str {:classes {:embed "e" :undiagnosed "u"} :pp {} :lex {} :gcc {:c {"g.c" {:class :undiagnosed}}}})}
                        (rej "e.c" true) (rej "z.c" true) (rej "g.c" false) (rej "h.c" false)))
    (is (= 2 (rec w ["c"] kf)))
    (let [m (read-string (slurp kf))]
      (is (= {"e.c" {:class :embed}} (get-in m [:lex :c])))
      (is (= {"g.c" {:class :undiagnosed}} (get-in m [:gcc :c])))
      (is (not (re-find #"unclassified" (slurp kf)))))))

(deftest parse-record-writes-no-placeholder
  ;; queue 122 F1: the tree check's --record: a kept or guessed class, a file of no class left out, never :unclassified
  (require 'arbace.repr.c.parsecheck)
  (let [rec (resolve 'arbace.repr.c.parsecheck/record)
        w (str (System/getProperty "user.dir") "/.tmp/ci-judge-test-parse-record")
        b (str w "/src")
        kf (str w "/known.edn")]
    (put-files w {"c/base.txt" b "c/files.tsv" "a.c\tequal\nk.c\tknown\ne.c\tdiffer\nz.c\tcrash\n"
                  "src/a.c" "int a;\n" "src/k.c" "int k;\n" "src/e.c" "??=define E 1\n" "src/z.c" "int z;\n"
                  "known.edn" (pr-str {:classes {:trigraphs "t" :k "k"} :parse {:c {"k.c" {:class :k}}}})})
    (is (= 1 (rec w ["c"] kf)))
    (is (= {"k.c" {:class :k} "e.c" {:class :trigraphs}} (get-in (read-string (slurp kf)) [:parse :c])))
    (is (not (re-find #"unclassified" (slurp kf))))))

(deftest parse-record-pp-errors-only-the-preprocessors
  ;; CS268 (a): the tree check's --record guesses :pp-errors only when the trees equal and every differing error line is
  ;; the preprocessor's (the port's among its preprocessor's errors, cc's on a directive's line), never the parser's: such
  ;; a file is printed, left out of the known file and counted (the run exits 3)
  (require 'arbace.repr.c.parsecheck)
  (let [rec (resolve 'arbace.repr.c.parsecheck/record)
        w (str (System/getProperty "user.dir") "/.tmp/ci-judge-test-parse-record-pp")
        b (str w "/src")
        kf (str w "/known.edn")
        fc (host/file-config [] "gnu23")
        h (host/load-host "test/c/host")
        srcs {"p.c" "#error boom\nint p;\n" "q.c" "int q = ;\n" "r.c" "#if 1\n#endif\nint r;\n" "s.c" "#if 1\n#endif\nint s;\n"
              "o.c" "#error one\nint o = ;\n"}
        _ (put-files w (into {} (for [[n t] srcs] [(str "src/" n) t])))
        port (fn [n] (cparse/result-dump (cparse/parse (host/config h fc b) n)))
        no-errors (fn [^String d] (str/join (for [l (str/split-lines d) :when (not (.startsWith ^String l "#error"))] (str l "\n"))))
        errs (fn [^String d] (filter #(.startsWith ^String % "#error") (str/split-lines d)))]
    ;; the port's dumps: p.c the preprocessor's #error, q.c the parser's error, r.c and s.c none; o.c both, in this order
    (is (= ["#error\tp.c:1:2: boom"] (errs (port "p.c"))))
    (is (re-find #"^#error\tq\.c:1:9: unexpected" (first (errs (port "q.c")))))
    (is (empty? (errs (port "r.c"))))
    (is (= 2 (count (errs (port "o.c")))))
    (put-files w (merge
                   {"c/base.txt" b "c/files.tsv" (str/join (for [n (keys srcs)] (str n "\tdiffer\n")))
                    "c/files.edn" (pr-str (vec (for [n (keys srcs)] {:name n :read n :out (str n ".tsv") :fc fc})))
                    "known.edn" (pr-str {:classes {:pp-errors "p"} :parse {}})}
                   (into {} (for [n (keys srcs)] [(str "c/diff/" n ".tsv.port") (port n)]))
                   {;; cc without the port's preprocessor's error: guessed
                    "c/diff/p.c.tsv.cc" (no-errors (port "p.c"))
                    ;; cc without the port's parser's error: the parser's, not guessed
                    "c/diff/q.c.tsv.cc" (no-errors (port "q.c"))
                    ;; cc's own error on a directive's line: guessed; on a declaration's line: not
                    "c/diff/r.c.tsv.cc" (str (port "r.c") "#error\tr.c:1:5: cc's complaint\n")
                    "c/diff/s.c.tsv.cc" (str (port "s.c") "#error\ts.c:3:5: cc's complaint\n")
                    ;; cc with the parser's error alone, not the preprocessor's: the preprocessor's differs, guessed
                    "c/diff/o.c.tsv.cc" (str (no-errors (port "o.c")) (last (errs (port "o.c"))) "\n")}))
    (is (= 2 (rec w ["c"] kf)))
    (is (= {"p.c" {:class :pp-errors} "r.c" {:class :pp-errors} "o.c" {:class :pp-errors}} (get-in (read-string (slurp kf)) [:parse :c])))
    ;; o.c the other way: cc with the preprocessor's error alone, the port's parser's error the difference: not guessed
    (put-files w {"c/diff/o.c.tsv.cc" (str (no-errors (port "o.c")) (first (errs (port "o.c"))) "\n")
                  "known.edn" (pr-str {:classes {:pp-errors "p"} :parse {}})})
    (is (= 3 (rec w ["c"] kf)))
    (is (= {"p.c" {:class :pp-errors} "r.c" {:class :pp-errors}} (get-in (read-string (slurp kf)) [:parse :c])))))

(deftest parse-record-no-foreign-class
  ;; CS268 (a): the tree check's --record never takes another check's class (the token check's classify, :c23-if-true,
  ;; :has-c-attribute, :embed): a file only those name is printed, left out and counted
  (require 'arbace.repr.c.parsecheck)
  (let [rec (resolve 'arbace.repr.c.parsecheck/record)
        w (str (System/getProperty "user.dir") "/.tmp/ci-judge-test-parse-record-foreign")
        b (str w "/src")
        kf (str w "/known.edn")]
    (doseq [classes [{:pp-errors "p"} {:pp-errors "p" :c23-if-true "c" :has-c-attribute "h" :embed "e"}]]
      (put-files w {"c/base.txt" b "c/files.tsv" "i.c\tdiffer\nh.c\tdiffer\ne.c\tcrash\n"
                    "src/i.c" "#if true\n#endif\nint i;\n" "src/h.c" "#if __has_c_attribute(nodiscard)\n#endif\n"
                    "src/e.c" "#embed \"f\"\n"
                    "known.edn" (pr-str {:classes classes :parse {}})})
      (is (= 3 (rec w ["c"] kf)))
      (is (nil? (get-in (read-string (slurp kf)) [:parse :c]))))))

(deftest roundtrip-record-writes-no-placeholder
  ;; queue 122 F1: the round trip's --record keeps a file's class and leaves a failing file of no class out, never :unclassified
  (require 'arbace.repr.c.rtcheck)
  (let [rec (resolve 'arbace.repr.c.rtcheck/record)
        w (str (System/getProperty "user.dir") "/.tmp/ci-judge-test-rt-record")
        kf (str w "/known.edn")]
    (put-files w {"c/files.tsv" (str "a.c\tpass\tok\tequal\tequal\tequal\tsame\tagree\t\t\n"
                                     "k.c\tknown\tok\tequal\tequal\tdiffer\t-\tagree\tobjects\tx\n"
                                     "f.c\tfail\tok\tdiffer\tequal\t-\t-\tagree\t\tform 1\n")
                  "known.edn" (pr-str {:classes {:objects "o"} :roundtrip {:c {"k.c" {:class :objects} "s.c" {:class :objects}}}})})
    (is (= 1 (rec w ["c"] kf)))
    (is (= {"k.c" {:class :objects}} (get-in (read-string (slurp kf)) [:roundtrip :c])))
    (is (not (re-find #"unclassified" (slurp kf))))))

(deftest roundtrip-controls
  (require 'arbace.repr.c.rtcheck)
  (let [res (resolve 'arbace.repr.c.rtcheck/roundtrip-control-result)
        w (str (System/getProperty "user.dir") "/.tmp/ci-judge-test-controls-rt")
        ;; benchmarksgame is a run corpus of test/c/corpora.edn: level 4 is judged
        b "benchmarksgame"
        g {[b "a.c"] "0"}
        r (fn [s rf] (res w [b] g {:level :roundtrip :subject (str b "/" s) :reference (str b "/" rf)}))]
    (put-files w {(str b "/forms.tsv") (str "a.c\tok\tequal\tequal\t\tequal\nb.c\tok\tequal\tequal\t\tequal\nq.c\tok\tequal\tequal\t\tequal\n"
                                            "l.c\tok\tdiffer\tequal\tform 1\tequal\nx.c\tok\tequal\tequal\t\tequal\n")
                  (str b "/obj.tsv") "a.c\t0\t0\tequal\nb.c\t0\t0\tequal\nq.c\t0\t0\tequal\nl.c\t0\t0\tequal\nx.c\t1\t1\t-\n"
                  (str b "/obj/orig/a.c.o") "A" (str b "/obj/print/a.c.o") "A" (str b "/obj/orig/b.c.o") "B"
                  (str b "/obj/orig/q.c.o") "A"
                  (str b "/run.tsv") "a.c\t0\t0\tsame\nb.c\t0\t0\tsame\nq.c\t0\t0\tsame\n"
                  (str b "/run/a.c/o/stdout") "228\n" (str b "/run/a.c/p/stdout") "228\n" (str b "/run/q.c/o/stdout") ">ONE\n"})
    (is (= :differs (res w [b] g {:subject (str b "/a.c") :reference (str b "/b.c")})))
    ;; the objects alike, the same status: the standard output tells them apart (level 4)
    (is (= :differs (r "a.c" "q.c")))
    (is (= :passes (r "a.c" "a.c")))
    (is (= :not-judged (r "a.c" "x.c")))
    (is (= :left (r "l.c" "b.c")))
    (is (= :left (res w ["c"] g {:subject (str b "/a.c") :reference (str b "/b.c")})))))

;; queue 159: levels 1 and 2 crossed (test/c/controls.edn, :roundtrip-forms and :roundtrip-full) on the texts the run keeps for
;; the controls' files (control/): the subject's reread forms against another file's read forms, its :full print against
;; another file's original, differ; against its own pass (a control made to pass); a text not kept is not judged; a subject
;; whose own row does not pass, or a corpus not in the run, leaves it.
(deftest roundtrip-text-controls
  (require 'arbace.repr.c.rtcheck)
  (let [res (resolve 'arbace.repr.c.rtcheck/text-control-result)
        w (str (System/getProperty "user.dir") "/.tmp/ci-judge-test-controls-rt-text")
        b "benchmarksgame"
        g {}
        r (fn [lvl s rf] (res w [b] g {:level lvl :subject (str b "/" s) :reference (str b "/" rf)}))]
    (put-files w {(str b "/forms.tsv") (str "a.c\tok\tequal\tequal\t\tequal\nb.c\tok\tequal\tequal\t\tequal\n"
                                            "l.c\tok\tequal\tdiffer\t\tequal\nn.c\tok\tequal\tequal\t\tequal\n")
                  (str b "/obj.tsv") "a.c\t0\t0\tequal\nb.c\t0\t0\tequal\nl.c\t0\t0\tequal\nn.c\t0\t0\tequal\n"
                  (str b "/run.tsv") "a.c\t0\t0\tsame\nb.c\t0\t0\tsame\nl.c\t0\t0\tsame\nn.c\t0\t0\tsame\n"
                  (str b "/control/a.c.read") "(c/fn main)" (str b "/control/a.c.reread") "(c/fn main)"
                  (str b "/control/a.c.read-units") "[]" (str b "/control/a.c.reread-units") "[]"
                  (str b "/control/a.c.orig") "int main;\n" (str b "/control/a.c.full") "int main;\n"
                  (str b "/control/b.c.read") "(c/fn fasta)" (str b "/control/b.c.read-units") "[]"
                  (str b "/control/b.c.orig") "void fasta;\n"
                  (str b "/control/l.c.reread") "(c/fn main)" (str b "/control/l.c.reread-units") "[]"
                  (str b "/control/l.c.full") "int main;\n"})
    (doseq [lvl [:roundtrip-forms :roundtrip-full]]
      (is (= :differs (r lvl "a.c" "b.c")))
      (is (= :passes (r lvl "a.c" "a.c")))
      ;; n.c passes its own row but kept nothing; a reference without kept texts
      (is (= :not-judged (r lvl "n.c" "b.c")))
      (is (= :not-judged (r lvl "a.c" "n.c")))
      (is (= :left (r lvl "l.c" "a.c")))
      (is (= :left (res w ["c"] g {:level lvl :subject (str b "/a.c") :reference (str b "/b.c")}))))
    ;; the read's header units count at level 1, as check-file's comparison counts them
    (put-files w {(str b "/control/b.c.read") "(c/fn main)" (str b "/control/b.c.read-units") "[\"h\"]"})
    (is (= :differs (r :roundtrip-forms "a.c" "b.c")))
    ;; the committed controls name both levels
    (is (= #{:roundtrip-forms :roundtrip-full}
           (set (filter #{:roundtrip-forms :roundtrip-full} (map :level (read-string (slurp "test/c/controls.edn")))))))
    (is (= #{"fannkuchredux.c" "fasta-8.c"} ((resolve 'arbace.repr.c.rtcheck/control-names) "benchmarksgame")))))

;; GT8 (doc/GATE-SURVEY.md, "As built: GT8 (C's read lists)"): --only LIST for the read checks. ppcheck's lists keep a
;; corpus's listed files and mark the run partial (CORPUS/only.txt); a judge holds only the known entries of the files
;; run (an entry of a file not run is not stale), prints each failing file as FAIL CORPUS/NAME, and leaves a control
;; whose reference a partial run does not hold; the drivers refuse --record (and the options that need whole corpora)
;; with a list, and a list's id outside the corpora.

(deftest read-lists-only
  (require 'arbace.repr.c.ppcheck)
  (let [lists (resolve 'arbace.repr.c.ppcheck/lists)
        w (str (System/getProperty "user.dir") "/.tmp/ci-judge-test-only-lists")
        roots {:checkout (System/getProperty "user.dir")}
        names #(mapv :name (read-string (slurp (str w "/ci-run/files.edn"))))
        marked #(.exists (java.io.File. (str w "/ci-run/only.txt")))]
    (lists w roots ["ci-run"] ["ci-run/builtin-bitg.c" "ci-run/nan-to-unsigned.c" "other/x.c"])
    (is (= ["builtin-bitg.c" "nan-to-unsigned.c"] (names)))
    (is (= #{"builtin-bitg.c" "nan-to-unsigned.c"} (results/partial-names w "ci-run")))
    (is (= 2 (count (str/split-lines (slurp (str w "/ci-run/list.jsonl"))))))
    ;; a listed name the corpus does not hold fails the lists
    (is (thrown? Exception (lists w roots ["ci-run"] ["ci-run/no-such.c"])))
    ;; a whole run lists every file and removes the mark
    (lists w roots ["ci-run"] nil)
    (is (< 2 (count (names))))
    (is (not (marked)))
    (is (nil? (results/partial-names w "ci-run")))))

(deftest read-partial-judges
  (let [w (str (System/getProperty "user.dir") "/.tmp/ci-judge-test-only-judges")
        kf (str w "/known.edn")
        only #(spit (str w "/c/only.txt") (str/join (map (fn [n] (str n "\n")) %)))
        whole #(.delete (java.io.File. (str w "/c/only.txt")))]
    ;; the checker's check: a.c passes, s.c is known (absent from a partial run of a.c)
    (put-files w {"c/port.tsv" "a.c\tequal\t0\t\n"
                  "known.edn" (pr-str {:classes {:k "k"} :annot {:c {"s.c" {:class :k}}}})})
    (with-redefs [annot/known-file kf]
      (whole)
      (is (= 1 (annot/judge w "c")) "a whole run: s.c's entry stale")
      (only ["a.c"])
      (is (= 0 (annot/judge w "c")) "a partial run: s.c not run, its entry not stale")
      (put-files w {"c/port.tsv" "a.c\tequal\t0\t\nf.c\tdiffer\t0\tx\n"})
      (only ["a.c" "f.c"])
      (let [out (with-out-str (is (= 1 (annot/judge w "c"))))]
        (is (re-find #"(?m)^FAIL c/f\.c\tannotations differ" out))))
    ;; the round trip: the same rule
    (put-files w {"c/forms.tsv" "a.c\tok\tequal\tequal\t\t\n"
                  "known.edn" (pr-str {:classes {:k "k"} :roundtrip {:c {"s.c" {:class :k}}}})})
    (with-redefs [rt/known-file kf]
      (whole)
      (is (= 1 (rt/judge w "c")))
      (only ["a.c"])
      (is (= 0 (rt/judge w "c")))
      (put-files w {"c/forms.tsv" "a.c\tok\tequal\tequal\t\t\nf.c\tok\tdiffer\tequal\tboom\t\n"})
      (only ["a.c" "f.c"])
      (is (re-find #"(?m)^FAIL c/f\.c\tlevels l1" (with-out-str (rt/judge w "c")))))
    ;; a control whose reference a partial run does not hold is left, not unjudged
    (require 'arbace.repr.c.parsecheck)
    (let [tree (resolve 'arbace.repr.c.parsecheck/tree-control-result)
          ctl {:level :tree :subject "c/a.c" :reference "c/b.c"}]
      (put-files w {"c/files.edn" "[{:name \"a.c\" :out \"a.c.tsv\"}]\n" "c/control/a.c.tsv.port" "TranslationUnit\t0\n"})
      (whole)
      (is (= :not-judged (tree w ["c"] ctl)))
      (only ["a.c"])
      (is (= :left (tree w ["c"] ctl))))
    (put-files w {"c/port/a.c.tsv" "@3\nd main e int()\n"})
    (only ["a.c"])
    (is (= :left (annot/annot-control-result w ["c"] {:level :annot :subject "c/a.c" :reference "c/b.c"})))
    (whole)
    (is (= :not-judged (annot/annot-control-result w ["c"] {:level :annot :subject "c/a.c" :reference "c/b.c"})))))

(deftest read-only-refusals
  (let [w (str (System/getProperty "user.dir") "/.tmp/ci-judge-test-only-refusals")
        l (str w "/list.txt") bad (str w "/bad.txt")]
    (put-files w {"list.txt" "benchmarksgame/fasta.c\n" "bad.txt" "nosuch/x.c\n"})
    (is (= 2 (sh-status {} "bin/repr-c" "check" "--tokens" "--corpus" "benchmarksgame" "--only" l "--record")))
    (is (= 2 (sh-status {} "bin/repr-c" "check" "--tokens" "--corpus" "benchmarksgame" "--only" bad)))
    (is (= 2 (sh-status {} "bin/repr-c" "parse-check" "--corpus" "benchmarksgame" "--only" l "--mutants-only")))
    (is (= 2 (sh-status {} "bin/repr-c" "parse-check" "--corpus" "benchmarksgame" "--only" l "--record")))
    (is (= 2 (sh-status {} "bin/repr-c" "roundtrip" "--corpus" "benchmarksgame" "--only" l "--record")))
    (is (= 2 (sh-status {} "bin/repr-c" "roundtrip" "--corpus" "benchmarksgame" "--only" l "--resume")))
    (is (= 2 (sh-status {} "bin/ci" "annotations" "--corpus" "benchmarksgame" "--only" l "--record")))
    (is (= 2 (sh-status {} "bin/ci" "annotations" "--corpus" "benchmarksgame" "--only" bad)))
    (is (= 2 (sh-status {} "bin/ci" "dg" "--only" l)) "an id outside the dg groups")
    (is (= 2 (sh-status {} "bin/ci" "dg" "--only" l "--essential")))))

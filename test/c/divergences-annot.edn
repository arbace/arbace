;; The checker's divergences from cc's checker (doc/C23-SURVEY.md, "As built: C4"; bin/ci annotations): the classes of
;; test/repr/c/annot-known.edn, in test/goi/divergences.edn's format (C8, generated from its :classes). A case is "corpus file", its
;; reason "known CLASS: the class's text". Read with the Clojure reader.
[
 {:id :cc-attr-mode
  :title "GNU's mode attribute, which cc ignores (the checker gives gcc's type of that width)"
  :kind :design
  :why "GNU's mode attribute, which cc ignores (the checker gives gcc's type of that width)"
  :decided "C8"
  :match [#"^known cc-attr-mode:"]}
 {:id :cc-c23-constants
  :title "C23's nullptr, true and false"
  :kind :design
  :why "C23's nullptr, true and false: cc's Builtin macros ((void*)0, 1, 0) where the checker types nullptr_t and bool"
  :decided "C8"
  :match [#"^known cc-c23-constants:"]}
 {:id :cc-empty-init
  :title "an array of unknown size with an empty initializer {}"
  :kind :design
  :why "an array of unknown size with an empty initializer {}: gcc 15.2's zero-length array, cc's incomplete one"
  :decided "C8"
  :match [#"^known cc-empty-init:"]}
 {:id :cc-layout
  :title "cc's layout of a struct or union differs from the checker's, and gcc agrees with the checker"
  :kind :design
  :why "cc's layout of a struct or union differs from the checker's and gcc 15.2 agrees with the checker (asked by static assertions of the checker's sizes, alignments and offsets appended to the file: .tmp/c4/layout_judge.py, C4.3): packed, aligned and bit-field placements cc's abi.go does not follow"
  :decided "C8"
  :match [#"^known cc-layout:"]}
 {:id :cc-preprocessor
  :title "the file's stream differs from cc's"
  :kind :design
  :why "the file's stream differs from cc's: C23's #elifdef and __has_c_attribute, which cc's preprocessor lacks (test/c/c23/, which the token check does not cover)"
  :decided "C8"
  :match [#"^known cc-preprocessor:"]}
 {:id :cc-redeclared
  :title "cc writes a redeclared array's or function's composite type at the earlier declarator"
  :kind :design
  :why "cc writes a redeclared array's or function's later (composite) type at the earlier declarator"
  :decided "C8"
  :match [#"^known cc-redeclared:"]}
 {:id :checker-gap
  :title "a difference neither cc's known gaps nor the reference explain"
  :kind :deferred
  :why "a difference neither cc's known gaps nor the reference explain: the checker's to look at (CS93)"
  :decided "CS93 (a); C8"
  :match [#"^known checker-gap:"]}
 {:id :checker-layout
  :title "the checker's layout differs from cc's and gcc's static assertions refuse the checker's"
  :kind :deferred
  :why "the checker's layout differs from cc's and gcc 15.2's static assertions refuse the checker's values: the checker's to fix (CS93)"
  :decided "CS93 (a); C8"
  :match [#"^known checker-layout:"]}
 {:id :converter-gap
  :title "the forms lose what the checker needs"
  :kind :deferred
  :why "the forms lose what the checker needs: an imaginary constant's f suffix ((imaginary x) for xif), CS83 (a)'s class"
  :decided "CS83 (a); C8"
  :match [#"^known converter-gap:"]}
 {:id :enum-range
  :title "an enumerator beyond long long's range in an error test"
  :kind :design
  :why "an enumerator beyond long long's range in an error test (gcc rejects the value; cc wraps it, the checker does not)"
  :decided "C8"
  :match [#"^known enum-range:"]}
 {:id :item-placement
  :title "an item cc places on another line or file than the forms"
  :kind :design
  :why "an item cc places on another line or file than the forms (a #line directive, a table brought in by an #include among the items)"
  :decided "C8"
  :match [#"^known item-placement:"]}
 {:id :layout-unjudged
  :title "a layout cc and the checker part on that the judge could not ask gcc about"
  :kind :deferred
  :why "a layout cc and the checker part on that the one-off judge could not ask gcc about (an anonymous or block-scope record, or the file not compiling with the assertions)"
  :decided "C8"
  :match [#"^known layout-unjudged:"]}
 {:id :vector-types
  :title "GNU's vector types, read and checked, out of eval and AOT by design"
  :kind :design
  :why "GNU's vector types, read and checked, out of eval and AOT by design (doc/c/SPEC.md §14); cc reads them as their elements"
  :decided "CS3 (a); C8"
  :match [#"^known vector-types:"]}
]

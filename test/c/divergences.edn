;; ci's divergences from gcc 15.2 (doc/C23-SURVEY.md, "As built: C5 (write-ahead)"; doc/c/SPEC.md §12.5, §13, §14):
;; the classes every program of bin/ci check that does not pass falls into, each with why it is by design or
;; deferred and where that was decided, in test/goi/divergences.edn's format. A program's class is the first
;; whose :match finds its result and reason ("RESULT REASON", as test/c/check-linux-amd64.edn writes them; a
;; program of test/c/check-known.edn fails with "known REASON (...)"). bin/ci divergences judges the recorded
;; check against them. Read with the Clojure reader.
[
 {:id :by-design
  :title "read and printed, out of eval (SPEC §14)"
  :kind :design
  :why "GNU nested functions, inline assembly, vector types, __real__ and __imag__, the decimal and _Float16/_Float128 types: CS3 (a)'s list"
  :decided "SPEC §14, CS3 (a)"
  :match [#"^refused by-design: " #"^fail known asm: " #"^read-refused literal: convert: floating suffix d"]}
 {:id :long-double
  :title "long double is double (CS35)"
  :kind :design
  :why "the user's decision of 2026-10-28: no software x87 arithmetic; a program that declares or converts to long double and differs from gcc's run"
  :decided "CS35, SPEC §12.5"
  :match [#"^fail differ (status 134 \(gcc 0\)|stdout) uses-long-double$" #"^refused checker: main: _Generic without a chosen association uses-long-double$"]}
 {:id :speed
  :title "speed: programs beyond the check's 10 s"
  :kind :design
  :why "an interpreter of nodes is 10 to 100 times slower than gcc's code (goi's class of the same name)"
  :decided "GOI-SPEC §11.1's rule, this section"
  :match [#"^fail differ status timeout"]}
 {:id :ub
  :title "undefined behaviour the reference's runs show (SPEC §13.2)"
  :kind :design
  :why "a program reading uninitialized or out-of-bounds memory, whose result is the layout's and the stack's: gcc's -O0 and -O2 runs differ, or the value is the reference's memory"
  :decided "CS10 (a), SPEC §13.2"
  :match [#"^fail known ub: "]}
 {:id :gcc-builtin
  :title "gcc's own semantics of a builtin a program redefines"
  :kind :design
  :why "gcc expands a call of a library builtin (llabs, ...) itself even where the program defines the function; ci calls the program's definition, as the standard says"
  :decided "SPEC §7.9"
  :match [#"^fail known gcc-builtin: " #"^fail differ status 139 .*undefined function __(builtin|atomic)"]}
 {:id :abi
  :title "gcc's layout options the forms do not carry"
  :kind :design
  :why "-mms-bitfields and similar target options change layout; the reference's runs were made with them, ci lays out by the psABI"
  :decided "SPEC §12.3"
  :match [#"^fail known abi: "]}
 {:id :vla
  :title "variably modified types beyond a block's arrays (deferred)"
  :kind :deferred
  :why "VLAs in structs and parameters' sizes with side effects, sizeof of a variably modified type name, a VLA's storage freed when its scope is left (a loop or goto re-entering it): C5 builds the block-scope VLA on the C stack only (CS106)"
  :decided "CS106"
  :match [#"^refused vla: " #"^fail known vla: " #"stack overflow \(alloca\)"]}
 {:id :complex-int
  :title "GNU's complex integer types (deferred)"
  :kind :deferred
  :why "_Complex int and its arithmetic: the floating complex types are built (CS105)"
  :decided "CS105"
  :match [#"^refused complex: "]}
 {:id :read
  :title "repr/c's reader's known gaps (deferred)"
  :kind :deferred
  :why "a declaration that begins in one file and ends in another, a main file that includes itself: refused by the converter (C3b's classes, test/repr/c/roundtrip-known.edn)"
  :decided "C3b.2, CS104"
  :match [#"^read-refused (split-declaration|self-include): "]}
 {:id :checker
  :title "the checker's own differences ci meets (deferred, CS93 (a))"
  :kind :deferred
  :why "a type or constant the checker computes otherwise than gcc: fixed as ci meets them (CS93 (a)), the rest listed in test/c/check-known.edn"
  :decided "CS93 (a)"
  :match [#"^fail known checker: "]}
 {:id :wide
  :title "the overflow builtins on wide integers (deferred)"
  :kind :deferred
  :why "__builtin_*_overflow is computed in 128 bits; on __int128 operands it needs 129 (CS35's limbs have the room: C6)"
  :decided "CS35, this section"
  :match [#"^refused wide: " #"^fail known wide: "]}
 {:id :threads
  :title "threads (deferred)"
  :kind :deferred
  :why "pthread_create needs musl's clone (assembly) as a native over goroutines (§6.5's plan): C6"
  :decided "§6.5"
  :match [#"^fail known threads: " #"^fail differ status 139 .*undefined function __clone"]}
 {:id :fenv
  :title "floating-point exception flags and signaling NaNs are not modelled (C7)"
  :kind :design
  :why "a program that raises FE_INVALID on a signaling NaN (-fsignaling-nans) and tests fetestexcept: ci's arithmetic keeps no flags (SPEC §12.5)"
  :decided "C7 (write-ahead), CS130"
  :match [#"^fail known fenv: "]}
 {:id :complit-static
  :title "compound literals with storage class specifiers: the builder's places (C7 follow-up)"
  :kind :gap
  :why "C23 6.5.3.6: (static T) {...} and (register T) {...} (file scope and block scope, with goto re-entry): ci's builder places them as automatic objects, c23-complit-2 faults at its first use"
  :decided "C7 follow-up, CS131"
  :match [#"^fail known complit-static: "]}
]

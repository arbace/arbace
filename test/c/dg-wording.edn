;; The dg check's wording equivalences (doc/C23-SURVEY.md, CS200 (a)): a dg-error regex that matches none of the checker's
;; messages on its line is accepted only when a family below explains it: some regex of the line matches the family's :gcc
;; (a pattern over the dg-error regex's text) and some message of the checker's on the line matches its :checker. A pass
;; with a line neither a regex nor a family accounts for fails ("message: ..."), so a new mismatch is a regression. The
;; checker's wording is not changed (the oracle and annotations checks compare it with cc's).
;; A family with :files applies to those files alone; its :gcc and :checker are anchored to the whole text where the wording is
;; exact (review 031's finding E). :wrong-reason lists the files whose line is the right line with another reason than gcc's (the
;; checker says something else about it), each {:lines [the lines] :why REASON}: they are a class of their own
;; (test/c/divergences-dg.edn's :wrong-reason), not passes, and an unexplained line outside :lines fails like any other. Since CS236 (a) a
;; line passes only when every one of its regexes matches a message (gcc's dg matches each directive): the 8 files whose lines gcc gives
;; several diagnostics on, the checker one, are listed here.
;; Read with the Clojure reader.
{:families
 [{:id :qualifier-discard
   :gcc "discards .const. qualifier from pointer target type"
   :checker "discards qualifier from pointer target type"
   :files ["gcc-c23/gcc.dg/c23-qual-5.c"
           "gcc-c23/gcc.dg/c23-qual-6.c"]
   :why "gcc names the qualifier (const), the checker says qualifier"}
  {:id :string-literal-array
   :gcc "from a string literal with type array of"
   :checker "array initialized from a string literal with type array of unsigned char"
   :files ["gcc-c23/gcc.dg/c23-utf8str.c"
           "gcc-gnu23/gcc.dg/gnu23-utf8str.c"]
   :why "gcc's regex has the type spelled with a wildcard"}
  {:id :noreturn-target
   :gcc "can only be applied to functions"
   :checker "attribute can only be applied to declarations other than labels"
   :files ["gcc-c23/gcc.dg/c23-attr-noreturn-2.c"]
   :why "the checker's wording for attributes in a place it does not apply to"}
  {:id :tag-redefinition
   :gcc "redefinition of struct or union"
   :checker "redefinition of '(struct|union) \\w+'"
   :files ["gcc-c23/gcc.dg/c23-tag-1.c"
           "gcc-gnu23/gcc.dg/gnu23-tag-1.c"
           "gcc-gnu23/gcc.dg/gnu23-tag-3.c"]
   :why "gcc's regex is generic, the checker names the tag"}
  {:id :enum-redefinition
   :gcc "conflicting redefinition"
   :checker "redefinition of 'enum \\w+'"
   :files ["gcc-c23/gcc.dg/c23-enum-9.c"
           "gcc-c23/gcc.dg/c23-tag-enum-1.c"]
   :why "the same diagnostic: gcc says conflicting, the checker names the tag"}
  {:id :tag-conflict
   :gcc "^redefinition$"
   :checker "^\\d+: conflicting types for '\\w+'$"
   :files ["gcc-c23/gcc.dg/c23-tag-1.c"
           "gcc-gnu23/gcc.dg/gnu23-tag-1.c"]
   :why "a tag redefined with another content, gcc 'redefinition of', the checker 'conflicting types'"}
  {:id :bitint-specifiers
   :gcc "both '\\w+' and '_BitInt' in declaration specifiers"
   :checker "two or more data types in declaration specifiers"
   :files ["gcc-bitint/gcc.dg/bitint-1.c"]
   :why "gcc names the pair, the checker the general rule"}
  {:id :enum-range
   :gcc "enumerator value outside the range"
   :checker "overflow in enumeration values"
   :files ["gcc-bitint/gcc.dg/bitint-14.c"
           "gcc-c23/gcc.dg/c23-enum-2.c"]
   :why "the checker's wording"}
  {:id :enum-range-intmax
   :gcc "enumeration values exceed range of 'intmax_t'"
   :checker "enumeration values exceed range of largest integer"
   :files ["gcc-c23/gcc.dg/c23-enum-2.c"]
   :why "the checker's wording"}
  {:id :duplicate-case
   :gcc "duplicate .*or overlapping.* case value"
   :checker "duplicate case value"
   :files ["gcc-gnu23/gcc.dg/gnu23-switch-1.c"
           "gcc-gnu23/gcc.dg/gnu23-switch-2.c"]
   :why "gcc's 'or overlapping' is for ranges"}
  {:id :incompatible-pointer
   :gcc "from incompatible pointer type|from a function with incompatible return type"
   :files ["gcc-c23/gcc.dg/c23-mismatching-fn-ptr-a52dec.c" "gcc-c23/gcc.dg/c23-mismatching-fn-ptr-alsatools.c"
           "gcc-c23/gcc.dg/c23-mismatching-fn-ptr.c" "gcc-c23/gcc.dg/c23-qual-5.c" "gcc-c23/gcc.dg/c23-qual-6.c"]
   :checker "^\\d+: (passing argument \\d+|assignment|initialization|return): incompatible pointer type "
   :why "gcc prints the types, the checker its own spelling of them"}
  {:id :embed-division
   :gcc "division by zero in #embed"
   :checker "division by zero"
   :files ["gcc-embed/c-c++-common/cpp/embed-16.c"
           "gcc-embed/c-c++-common/cpp/embed-4.c"]
   :why "the checker's message omits the directive"}
  {:id :embed-missing-file
   :gcc "non-existent-file: No such file or directory"
   :checker "No such file or directory"
   :files ["gcc-embed/c-c++-common/cpp/embed-7.c"
           "gcc-embed/c-c++-common/cpp/embed-8.c"]
   :why "the quoting of the file name"}
  {:id :elif-misplaced
   :gcc "'#elif(n?)def' (after '#else'|without '#if')"
   :checker "(#elif(n?)def after #else|unexpected #elif(n?)def)"
   :files ["gcc-cpp-c23/gcc.dg/cpp/c23-elifdef-2.c"]
   :why "the quoting of the directive"}
  {:id :elif-extra-tokens
   :gcc "extra tokens at end of '#elif(n?)def' directive"
   :checker "extra tokens at end of #elif(n?)def directive"
   :files ["gcc-cpp-c23/gcc.dg/cpp/c23-elifdef-2.c"]
   :why "the quoting of the directive"}
  {:id :elif-no-name
   :gcc "no macro name given in '#elif(n?)def' directive"
   :checker "expected identifier"
   :files ["gcc-cpp-c23/gcc.dg/cpp/c23-elifdef-2.c"]
   :why "the checker's wording"}
  {:id :conditional-began
   :gcc "-:began here"
   :checker "the conditional began here"
   :files ["gcc-cpp-c23/gcc.dg/cpp/c23-elifdef-2.c"]
   :why "gcc's note is matched with a dg-message form"}
  {:id :bitint-signed
   :gcc "ISO C does not support 'signed _BitInt"
   :checker "ISO C does not support '_BitInt\\(15\\)' before C23"
   :files ["gcc-bitint/gcc.dg/bitint-27.c"]
   :why "the checker leaves out the signed"}
  {:id :unary-plus
   :gcc "wrong type argument to unary plus"
   :checker "wrong type argument to unary [+]"
   :files ["gcc-c23/gcc.dg/c23-nullptr-3.c"]
   :why "the checker spells the operator"}
  {:id :enum-underlying
   :gcc "declared with but defined without fixed underlying type"
   :checker "declared both with and without fixed underlying type"
   :files ["gcc-c23/gcc.dg/c23-enum-10.c"]
   :why "the checker's wording"}
  {:id :static-assert-message
   :gcc "^message$"
   :checker "^\\d+: static assertion failed$"
   :files ["gcc-c23/gcc.dg/c23-static-assert-4.c"]
   :why "gcc's regex is the assertion's own message text"}]
 :wrong-reason
 {"gcc-c23/gcc.dg/c23-bool-errors-1.c" {:lines [7 12] :checker "two or more data types in declaration specifiers" :why "gcc: 'bool' cannot be defined via 'typedef'; the checker: two or more data types in declaration specifiers"}
  "gcc-c23/gcc.dg/c23-bool-errors-2.c" {:lines [7] :checker "two or more data types in declaration specifiers" :why "gcc: 'bool' cannot be used here; the checker: two or more data types in declaration specifiers"}
  "gcc-c23/gcc.dg/c23-tag-enum-6.c" {:lines [10 16] :checker "redeclaration of enumerator" :why "gcc: enumerator value outside the range; the checker: redeclaration of enumerator"}
  "gcc-embed/c-c++-common/cpp/embed-9.c" {:lines [4] :checker "No such file or directory" :why "gcc: no include path in which to search; the checker: No such file or directory"}
  "gcc-c23/gcc.dg/c23-nullptr-6.c" {:lines [13] :checker "not an integer constant expression" :why "gcc: not of integer type; the checker: not an integer constant expression"}
  "gcc-c23/gcc.dg/c23-attr-syntax-7.c" {:lines [46 49 51 53 55 57 60 63 66 69 72 75] :checker "(unexpected ':', expected '\\]'|'gnu' attribute ignored)" :why "gcc: the parse error and the ignored-attribute pedwarn a line; the checker: the parse error in its own wording, then the pedwarn"}
  "gcc-c23/gcc.dg/c23-attr-syntax-6.c" {:lines [46 48 51 53 55 57 59 62 65 68 71 74 77 84] :checker "(unexpected ':', expected '\\]'|pasting|'gnu' attribute ignored|attributes before C23)" :why "gcc: the parse error and the ignored-attribute pedwarns a line; the checker: the parse error in its own wording, then the pedwarns"}
  "gcc-c23/gcc.dg/c23-attr-unsequenced-3.c" {:lines [7 10 13] :checker "attribute does not take any arguments" :why "gcc: two diagnostics a line ('expected' and the attribute's arguments); the checker: the attribute's arguments only"}
  "gcc-c23/gcc.dg/c23-bool-errors-3.c" {:lines [7 12] :checker "(cannot use keyword|redeclaration of enumerator)" :why "gcc: a second regex per line quotes another line's message; the checker: the keyword-as-enumerator error"}
  "gcc-c23/gcc.dg/c23-attr-reproducible-3.c" {:lines [7 10 13] :checker "attribute does not take any arguments" :why "gcc: two diagnostics a line ('expected' and the attribute's arguments); the checker: the attribute's arguments only"}
  "gcc-c23/gcc.dg/c23-switch-1.c" {:lines [26 30 39 42 62] :checker "(duplicate case value|range expressions in switch)" :why "gcc: the range pedwarn and the conversion warnings promoted to errors a line; the checker: the pedwarn (and the duplicate case)"}
  "gcc-gnu23/gcc.dg/gnu23-attr-syntax-3.c" {:lines [12] :checker "(unexpected|conflicting types)" :why "gcc: 'expected' and a defaulted-int type error a line; the checker: its parse error and a conflicting-types error"}
  "gcc-embed/c-c++-common/cpp/embed-3.c" {:lines [18 21 26 30 34 38 42 47 52 56 59 60 63 66 69 78 82 83] :checker "(unbalanced|'#embed' expects|unknown embed parameter|division by zero)" :why "gcc: one diagnostic per bracket kind and per parameter fault; the checker: its own wording of the embed errors, once a line"}}}

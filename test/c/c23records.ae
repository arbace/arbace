(ns c.c23records
  "C23's conformance judges from the records (doc/ORACLE-RECORDS-SURVEY.md, ORS1-ORS10 (a), CS79 (a); \"As built: the tooling and
  C\"): bin/repr-c check --c23 without gcc. arbace.repr.c.c23check's judges in its order, judge 1 (the reference accepts the
  original) from test/c/c23/ref-syntax-gcc15.tsv (the driver's syn.tsv), judges 3 (the reference accepts the print) and 5's
  object half (the print's object file the original's) deferred to the oracle tier (gcc on Arbace's output, class D: bin/repr-c
  check --c23 --oracle); the control's wrong prints refused by the judges that need no compiler, their objects' likeness the
  oracle tier's. arbace.repr.c.c23check is embedded (gate_key): this namespace stands in for its records mode until a change
  that rekeys every build folds it in. Run on the tools' host (-p test), never embedded:
    judge WORK           WORK/c23/judges.tsv, the table printed; exit 1 when a file fails
    control-judge WORK   the control's cases (c23check's control-write) refused; exit 1 when a judge takes a wrong print"
  (:require [arbace.string :as str]))

(defn- read-tsv [^String p]
  (let [f (java.io.File. p)]
    (if (.exists f)
      (into {} (map (fn [l] (let [xs (str/split l #"\t" -1)] [(first xs) (vec (rest xs))])) (remove str/blank? (str/split-lines (slurp p)))))
      {})))

(defn judge [^String work]
  (let [d (str work "/c23")
        forms (read-tsv (str d "/forms.tsv"))
        syn (read-tsv (str d "/syn.tsv"))
        expected (read-string (slurp "test/c/c23/expected.edn"))
        rows (for [nm (sort (keys forms))
                   :let [[read l1 l2 _ fix] (get forms nm)
                         answer (cond
                                  (not= "0" (first (get syn nm))) "1 the reference rejects it"
                                  (not= read "ok") (str "2 repr/c does not read it (" read ")")
                                  (not= fix "equal") "4 the print is not a fixpoint"
                                  (not= l2 "equal") "5 the :full print is not the original"
                                  (not= l1 "equal") "6 the forms differ"
                                  :else "pass")
                         e (get expected nm)
                         st (cond (and (= answer "pass") e) "fail (expected to fail, passes)"
                                  (= answer "pass") "pass"
                                  e "expected"
                                  :else "fail")]]
               [nm st answer (or e "")])
        failing (filter #(.startsWith ^String (second %) "fail") rows)]
    (spit (str d "/judges.tsv") (str/join (map #(str (str/join "\t" %) "\n") rows)))
    (doseq [[nm st answer e] rows]
      (println (format "%-26s %-9s %s%s" nm st answer (if (seq e) (str " -- " e) ""))))
    (println (str "c23: " (count rows) " files, " (count (filter #(= "pass" (second %)) rows)) " pass, "
                  (count (filter #(= "expected" (second %)) rows)) " expected failures, " (count failing) " failing"
                  " (records: judges 3 and 5's objects deferred to the oracle tier)"))
    (if (seq failing) 1 0)))

(defn control-judge [^String work]
  (let [bad (atom 0) n (count (filter #(.isDirectory ^java.io.File %) (.listFiles (java.io.File. (str work "/control")))))]
    (doseq [i (range n)]
      (let [c (read-string (slurp (str work "/control/" i "/case.edn")))
            refused (if (= (:kind c) :respell-full) (:text-differs c) (:forms-differ c))]
        (when-not refused (swap! bad inc))
        (println (format "control %-20s %s, objects deferred to the oracle tier" (:name c) (if refused "refused" "TAKEN")))))
    (if (pos? @bad) 1 0)))

(defn -main [cmd work]
  (case cmd
    "judge" (System/exit (judge work))
    "control-judge" (System/exit (control-judge work))
    (do (println "c.c23records: judge or control-judge") (System/exit 2))))

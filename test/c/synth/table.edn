   :top "struct s { int a; double b; int *p; };\nstatic struct s fs = {};"
   :main "int i = {};\nint a[3] = {};\nstruct s st = {};\nunion { int x; char c; } un = {};\nint n = 3;\nint v[n] = {};\nint *p = {};"

  ;; ------------------------------------------------------------------------------------------------------------
  ;; A.2.3 Statements
  {:id "stmt-labeled" :what "labeled statements: labels, case and default, goto forward and backward"
   :clause "6.8.2" :annex-a "labeled-statement, label"
   :top "static int classify(int v) {\n  switch (v) {\n  case 0: return 10;\n  case 1:\n  case 2: return 20;\n  default: return 30;\n  case 3: return 40;\n  }\n}"
   :main "int n = 0;\nback:\nn++;\nif (n < 3) goto back;\ngoto fwd;\nn = 100;\nfwd:\nn += 10;"
   :show ["n" "classify(0)" "classify(2)" "classify(3)" "classify(9)"]}

  {:id "stmt-label-placement" :what "C23's labels before declarations and at the end of compound statements"
   :clause "6.8.2, 6.8.3" :annex-a "labeled-statement, block-item (label)"
   :m2 "labels before declarations and at the end of compound statements"
   :main "int r = 0;\ngoto decl;\ndecl:\nint x = 5;\nr += x;\nswitch (r) {\ncase 5:\nint y = 2;\nr += 1;\nbreak;\ndefault:\n}\n{ r++; end: }\nif (r == 7) goto done;\nr = -1;\ndone:"
   :show ["r"]}

  {:id "stmt-compound-expression" :what "compound statements, expression statements and null statements"
   :clause "6.8.3, 6.8.4" :annex-a "compound-statement, block-item-list, block-item, expression-statement"
   :main "int a = 1;\n{ int b = 2; a += b; { int c = 3; a += c; } }\n;\n;;\na;\n{}\nint i = 0;\nwhile (i++ < 5) ;\n(void)(a + 1);"
   :show ["a" "i"]}

  {:id "stmt-selection" :what "selection statements: if, else, chains, dangling else, switch with fallthrough"
   :clause "6.8.5" :annex-a "selection-statement"
   :m2 "the fallthrough attribute"
   :top "static int sign(int v) { if (v < 0) return -1; else if (v == 0) return 0; else return 1; }\nstatic int dangling(int a, int b) { if (a) if (b) return 1; else return 2; return 3; }\nstatic int fall(int v) {\n  int r = 0;\n  switch (v) {\n  case 1: r += 1; [[fallthrough]];\n  case 2: r += 2; [[fallthrough]];\n  case 3: r += 3; break;\n  case 4: { r = 40; break; }\n  }\n  return r;\n}\nstatic int nested(int a, int b) { switch (a) { case 0: switch (b) { case 0: return 0; default: return 1; } default: return 2; } }"
   :main "int t = 0;\nif (1) t = 1;\nif (0) t = 2; else t += 2;"
   :show ["t" "sign(-5)" "sign(0)" "sign(9)" "dangling(1, 0)" "dangling(0, 1)" "fall(1)" "fall(2)" "fall(4)" "fall(5)"
          "nested(0, 0)" "nested(0, 3)" "nested(1, 0)"]}

  {:id "stmt-iteration" :what "iteration statements: while, do, for with and without declarations, empty clauses"
   :clause "6.8.6" :annex-a "iteration-statement"
   :main "int w = 0, i = 0;\nwhile (i < 4) w += i++;\nint d = 0;\ndo d += 2; while (d < 7);\nint f = 0;\nfor (int k = 0; k < 5; k++) f += k;\nint j;\nfor (j = 10; j > 0; j -= 3) ;\nint inf = 0;\nfor (;;) { if (++inf == 6) break; }\nint skip = 0;\nfor (int a = 0, b = 10; a < b; a++, b--) { if (a % 2) continue; skip += a; }\nint outer = 0;\nfor (int x = 0; x < 3; x++) for (int y = 0; y < 3; y++) { if (y > x) break; outer++; }"
   :show ["w" "d" "f" "j" "inf" "skip" "outer"]}

  {:id "stmt-for-declaration" :what "the for statement's declaration clause: objects, several declarators, a static assertion"
   :clause "6.8.6.1, 6.7.12" :annex-a "iteration-statement (for ( declaration expression_opt ; expression_opt ) statement), static_assert-declaration"
   :main "int n = 0;\nfor (int i = 0, j = 3; i < j; i++) n += i * j;\nint m = 0;\nfor (static_assert(1, \"in a for\"); m < 2; m++) {}\nint k = 0;\nfor (static_assert(sizeof(int) >= 2); k < 5; k += 2) {}"
   :show ["n" "m" "k"]}

  {:id "stmt-jump" :what "jump statements: goto, continue, break, return with and without a value"
   :clause "6.8.7" :annex-a "jump-statement"
   :top "static int calls;\nstatic void noop(int x) { if (x) return; calls++; }\nstatic int find(const int *a, int n, int v) { for (int i = 0; i < n; i++) { if (a[i] != v) continue; return i; } return -1; }"
   :main "int a[4] = {5, 6, 7, 8};\nnoop(0);\nnoop(1);\nint g = 0;\nloop: if (g < 4) { g += 2; goto loop; }\nint br = 0;\nwhile (1) { if (++br > 3) break; }"
   :show ["calls" "find(a, 4, 7)" "find(a, 4, 9)" "g" "br"]}

  {:id "stmt-duff" :what "a switch whose case labels are inside a loop (Duff's device)"
   :clause "6.8.5.3, 6.8.2" :annex-a "selection-statement, labeled-statement, iteration-statement"
   :top "static int duff(const int *from, int count) {\n  int sum = 0, n = (count + 3) / 4;\n  switch (count % 4) {\n  case 0: do { sum += *from++;\n  case 3: sum += *from++;\n  case 2: sum += *from++;\n  case 1: sum += *from++;\n  } while (--n > 0);\n  }\n  return sum;\n}"
   :main "int a[7] = {1, 2, 3, 4, 5, 6, 7};"
   :show ["duff(a, 7)" "duff(a, 4)" "duff(a, 1)"]}

  ;; ------------------------------------------------------------------------------------------------------------
  ;; A.2.4 External definitions
  {:id "ext-functions" :what "function definitions: prototypes, recursion, mutual recursion, static and extern functions"
   :clause "6.9.2" :annex-a "translation-unit, external-declaration, function-definition, function-body"
   :top "static int is_odd(int n);\nstatic int is_even(int n) { return n == 0 ? 1 : is_odd(n - 1); }\nstatic int is_odd(int n) { return n == 0 ? 0 : is_even(n - 1); }\nstatic long long fact(int n) { return n <= 1 ? 1 : n * fact(n - 1); }\nextern int ext_fn(int);\nint ext_fn(int x) { return x + 100; }\nstatic void out(int *p) { *p = 9; }"
   :main "int v = 0;\nout(&v);"
   :show ["is_even(10)" "is_odd(7)" ["%lld" "fact(20)"] "ext_fn(1)" "v"]}

  {:id "ext-objects" :what "external object definitions: initializers with addresses, arrays of strings, pointer arithmetic"
   :clause "6.9.3, 6.7.11" :annex-a "external-declaration, declaration"
   :top "static int data[5] = {10, 20, 30, 40, 50};\nstatic int *mid = &data[2];\nstatic int *end = data + 5;\nstatic const char *names[] = {\"zero\", \"one\", \"two\"};\nstatic const char *const greeting = \"hi\" \" there\";\nstatic struct { const char *k; int v; } kv[] = {{\"a\", 1}, {\"b\", 2}};\nstatic int (*fp)(const char *, ...) = printf;"
   :show ["*mid" "(int)(end - mid)" ["%s" "names[2]"] ["%s" "greeting"] ["%s" "kv[1].k"] "kv[1].v" "fp == printf"]}

  {:id "ext-callbacks" :what "function pointers as callbacks: qsort and bsearch with comparators, dispatch tables"
   :clause "6.9.2, 7.24.5" :annex-a "function-definition, declarator (pointer to function)"
   :inc ["stdio.h" "stdlib.h"]
   :top "static int cmp(const void *a, const void *b) { int x = *(const int *)a, y = *(const int *)b; return (x > y) - (x < y); }\nstatic int add(int a, int b) { return a + b; }\nstatic int sub(int a, int b) { return a - b; }\nstatic int mul(int a, int b) { return a * b; }\nstatic int (*const ops[])(int, int) = {add, sub, mul};"
   :main "int a[6] = {5, 3, 9, 1, 7, 2};\nqsort(a, 6, sizeof a[0], cmp);\nint key = 7;\nint *hit = bsearch(&key, a, 6, sizeof a[0], cmp);"
   :show ["a[0]" "a[5]" "(int)(hit - a)" "ops[0](6, 3)" "ops[1](6, 3)" "ops[2](6, 3)" "(*ops[2])(2, 2)"]}

  ;; ------------------------------------------------------------------------------------------------------------
  ;; A.3 Preprocessing directives
  {:id "pp-define" :what "macros: object-like, function-like, nesting, # and ##, empty arguments, no recursion, #undef"
   :clause "6.10.5" :annex-a "control-line (#define, #undef), replacement-list, identifier-list"
   :top "#define TEN 10\n#define SQ(x) ((x) * (x))\n#define ADD(a, b) ((a) + (b))\n#define STR(x) #x\n#define XSTR(x) STR(x)\n#define CAT(a, b) a##b\n#define EMPTY\n#define SELF SELF\n#define ID(x) x\n#define NONE() 7\n#define TWICE(f, x) f(f(x))\nstatic int SELF = 3;\n#define GONE 1\n#undef GONE\n#ifndef GONE\nstatic int gone = 1;\n#endif"
   :show ["TEN" "SQ(TEN)" "ADD(1, SQ(2))" ["%s" "STR(a + b)"] ["%s" "XSTR(TEN)"] "CAT(TE, N)" "ID() 5 EMPTY"
          "SELF" "NONE()" "TWICE(SQ, 3)" "gone" ["%s" "STR(\"q\\n\")"] "CAT(1, 2)"]}

  {:id "pp-variadic" :what "variadic macros: __VA_ARGS__, C23's __VA_OPT__, stringized arguments"
   :clause "6.10.5.1" :annex-a "control-line (#define ... ( identifier-list , ... ) or ( ... )), va-opt-replacement"
   :m2 "__VA_OPT__"
   :top "#define COUNT(...) count_(0 __VA_OPT__(,) __VA_ARGS__)\nstatic int count_(int z, ...) { (void)z; return 0; }\n#define SUM(first, ...) (first __VA_OPT__(+ sum_rest(__VA_ARGS__)))\n#define sum_rest(...) (__VA_ARGS__)\n#define SHOW(...) #__VA_ARGS__\n#define F(a, ...) f_(a __VA_OPT__(, __VA_ARGS__))\nstatic int f_(int a, ...) { return a; }\n#define NARGS(...) NARGS_(__VA_ARGS__ __VA_OPT__(,) 3, 2, 1, 0)\n#define NARGS_(a, b, c, n, ...) n\n#define EMPTYOPT(...) __VA_OPT__()x\nstatic int x = 5;"
   :show ["COUNT()" "COUNT(1, 2)" "SUM(5)" "SUM(5, 6)" ["%s" "SHOW(a, b,  c)"] ["%s" "SHOW()"] "F(4)" "F(4, 5, 6)"
          "NARGS()" "NARGS(a)" "NARGS(a, b)" "NARGS(a, b, c)" "EMPTYOPT(1)"]}

  {:id "pp-conditional" :what "conditional inclusion: #if, #elif, #else, defined, #ifdef, #ifndef, C23's #elifdef and #elifndef, true and false"
   :clause "6.10.2" :annex-a "if-section, if-group, elif-groups, elif-group, else-group, endif-line"
   :m2 "#elifdef and #elifndef; true and false in #if"
   :top "#define ONE 1\n#if ONE + 1 == 2 && defined(ONE) && defined ONE\nstatic int a = 1;\n#else\nstatic int a = 0;\n#endif\n#if 0\n#error never\n#elif ONE * 3 > 2\nstatic int b = 2;\n#else\nstatic int b = 0;\n#endif\n#ifdef NOPE\nstatic int c = 0;\n#elifdef ONE\nstatic int c = 3;\n#else\nstatic int c = -1;\n#endif\n#ifndef ONE\nstatic int d = 0;\n#elifndef NOPE\nstatic int d = 4;\n#endif\n#if true && !false\nstatic int e = 5;\n#endif\n#if 'A' == 65 && (-1 < 0u) == 0 && 0x10 == 16 && (2 ? 3 : 4) == 3\nstatic int f = 6;\n#endif\n#if __STDC_VERSION__ >= 202311L\nstatic int g = 7;\n#endif\n#if 1'000 == 1000 && 0b11 == 3\nstatic int h = 8;\n#endif\n#if UNDEFINED_NAME == 0\nstatic int i = 9;\n#endif"
   :show ["a" "b" "c" "d" "e" "f" "g" "h" "i"]}

  {:id "pp-include" :what "source file inclusion: quoted and angled forms, a macro naming the header, __has_include, #pragma once"
   :clause "6.10.3, 6.10.1" :annex-a "control-line (#include), has-include-expression"
   :m2 "__has_include"
   :inc []
   :top "#define HDR <stdio.h>\n#include HDR\n#include \"synth.h\"\n#include \"synth.h\"\n#if __has_include(<stdio.h>)\nstatic int has_stdio = 1;\n#else\nstatic int has_stdio = 0;\n#endif\n#if __has_include(\"synth.h\") && !__has_include(\"no-such-synth-header.h\") && !__has_include(<no/such/header.h>)\nstatic int has_local = 1;\n#else\nstatic int has_local = 0;\n#endif\n#if defined(__has_include)\nstatic int defined_has = 1;\n#endif"
   :show ["SYNTH_H" "synth_twice(21)" "has_stdio" "has_local" "defined_has"]}

  {:id "pp-embed" :what "C23's #embed: a resource's bytes, limit, prefix, suffix, if_empty, __has_embed"
   :clause "6.10.4" :annex-a "control-line (#embed), embed-parameter-sequence, has-embed-expression"
   :m2 "#embed and __has_embed"
   :top "static const unsigned char all[] = {\n#embed \"synth-embed.dat\"\n};\nstatic const unsigned char two[] = {\n#embed \"synth-embed.dat\" limit(2)\n};\nstatic const int framed[] = {\n#embed \"synth-embed.dat\" prefix(100, ) suffix(, 200) limit(1)\n};\nstatic const int none[] = {\n#embed \"synth-empty.dat\" if_empty(42)\n};\nstatic const int count = sizeof((const unsigned char[]){\n#embed \"synth-embed.dat\"\n});\n#if __has_embed(\"synth-embed.dat\") == __STDC_EMBED_FOUND__ && __has_embed(\"synth-empty.dat\") == __STDC_EMBED_EMPTY__ && __has_embed(\"no-such-synth.dat\") == __STDC_EMBED_NOT_FOUND__\nstatic int has_ok = 1;\n#else\nstatic int has_ok = 0;\n#endif"
   :show [["%zu" "sizeof all"] "all[0]" "all[3]" "all[4]" ["%zu" "sizeof two"] "two[1]" ["%zu" "sizeof framed / sizeof framed[0]"]
          "framed[0]" "framed[1]" "framed[2]" "none[0]" "count" "has_ok" "__STDC_EMBED_NOT_FOUND__" "__STDC_EMBED_FOUND__"
          "__STDC_EMBED_EMPTY__"]}

  {:id "pp-has-attribute" :what "__has_c_attribute in #if: the standard attributes (202311), prefixed vendor ones, unknown ones (0)"
   :clause "6.10.2" :annex-a "has-c-attribute-express"
   :m2 "__has_c_attribute"
   :top "#if __has_c_attribute(deprecated) == 202311L\nstatic int a0 = 1;\n#else\nstatic int a0 = 0;\n#endif\n#if __has_c_attribute(fallthrough) == 202311L\nstatic int a1 = 1;\n#else\nstatic int a1 = 0;\n#endif\n#if __has_c_attribute(maybe_unused) == 202311L\nstatic int a2 = 1;\n#else\nstatic int a2 = 0;\n#endif\n#if __has_c_attribute(nodiscard) == 202311L\nstatic int a3 = 1;\n#else\nstatic int a3 = 0;\n#endif\n#if __has_c_attribute(noreturn) == 202311L\nstatic int a4 = 1;\n#else\nstatic int a4 = 0;\n#endif\n#if __has_c_attribute(unsequenced) == 202311L\nstatic int a5 = 1;\n#else\nstatic int a5 = 0;\n#endif\n#if __has_c_attribute(reproducible) == 202311L\nstatic int a6 = 1;\n#else\nstatic int a6 = 0;\n#endif\n#if __has_c_attribute(__nodiscard__) == 202311L\nstatic int a7 = 1;\n#else\nstatic int a7 = 0;\n#endif\n#if __has_c_attribute(_Noreturn) == 202311L\nstatic int a8 = 1;\n#else\nstatic int a8 = 0;\n#endif\n#if __has_c_attribute(gnu::packed) == 1\nstatic int a9 = 1;\n#else\nstatic int a9 = 0;\n#endif\n#if __has_c_attribute(foo) == 0\nstatic int a10 = 1;\n#else\nstatic int a10 = 0;\n#endif\n#if __has_c_attribute(x) == 0\nstatic int a11 = 1;\n#else\nstatic int a11 = 0;\n#endif\n#if defined(__has_c_attribute) && __has_c_attribute(nodiscard) && !__has_c_attribute(no_such_attribute)\nstatic int in_if = 1;\n#else\nstatic int in_if = 0;\n#endif"
   :show ["a0" "a1" "a2" "a3" "a4" "a5" "a6" "a7" "a8" "a9" "a10" "a11" "in_if"]}

  {:id "pp-line-pragma" :what "#line, #pragma, _Pragma, the null directive, #warning, __LINE__"
   :clause "6.10.6, 6.10.7, 6.10.8, 6.10.10, 6.10.11" :annex-a "control-line (#line, #pragma, #, #warning), non-directive"
   :m2 "#warning"
   :top "#\n#pragma STDC FP_CONTRACT OFF\n#pragma STDC FENV_ACCESS OFF\n#pragma unknown_pragma_ignored\n_Pragma(\"STDC CX_LIMITED_RANGE OFF\")\n#warning \"a warning, not an error\"\n#line 500\nstatic int at500 = __LINE__;\n#line 700 \"renamed.c\"\nstatic const char *file = __FILE__;\nstatic int at700 = __LINE__;\n#define LINE_HERE __LINE__"
   :show ["at500" "at700" ["%s" "file"] "LINE_HERE > 700"]}

  {:id "pp-predefined" :what "predefined macros: __STDC__, __STDC_VERSION__, __STDC_HOSTED__, __STDC_UTF_16__, __STDC_UTF_32__"
   :clause "6.10.10" :annex-a "(predefined macro names)"
   :m2 "__STDC_VERSION__ 202311L"
   :show ["__STDC__" ["%ld" "__STDC_VERSION__"] "__STDC_HOSTED__" "__STDC_UTF_16__" "__STDC_UTF_32__"
          "defined_check()" ["%d" "__LINE__"]]
   :top "#ifdef __STDC_NO_VLA__\n#define defined_check() 0\n#else\n#define defined_check() 1\n#endif"}

  ;; ------------------------------------------------------------------------------------------------------------
  ;; Clause 7: C23's additions that musl provides
  {:id "lib-string-c23" :what "C23's string functions in musl: strdup, strndup, memccpy"
   :clause "7.26.2.2, 7.26.2.6, 7.26.2.7" :annex-a "(library)"
   :m2 "strdup, strndup and memccpy added to the library"
   :inc []
   :top "#define _XOPEN_SOURCE 700\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>"
   :main "char *d = strdup(\"duplicate\");\nchar *n = strndup(\"abcdef\", 3);\nchar buf[16] = {};\nchar *stop = memccpy(buf, \"key=value\", '=', sizeof buf);"
   :show [["%s" "d"] ["%s" "n"] ["%zu" "strlen(n)"] ["%s" "buf"] "(int)(stop - buf)"]}
 ]}

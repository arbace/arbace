          "acc" "si" "ci" "*p"]}

  {:id "decl-typeof" :what "typeof and typeof_unqual of expressions and types"
   :clause "6.7.3.6" :annex-a "typeof-specifier, typeof-specifier-argument"
   :m2 "typeof and typeof_unqual"
   :top "static int add(int a, int b) { return a + b; }"
   :main "const int ci = 5;\ntypeof(ci) t1 = 6;\ntypeof_unqual(ci) t2 = 7;\nt2++;\ntypeof(int[3]) arr = {1, 2, 3};\ntypeof(add) *fp = add;\ntypeof(typeof(char *)[2]) sp = {\"a\", \"b\"};\nvolatile double vd = 1;\ntypeof_unqual(vd) plain = 2;\ntypeof(1 + 1.0f) f = 0.5f;\n_BitInt(9) b9 = 3;\ntypeof(b9) b9b = b9 + 1;"
   :show ["t1" "t2" "_Generic(&t1, const int *: 1, default: 0)" "_Generic(&t2, int *: 1, default: 0)" "arr[2]" "fp(2, 3)"
          ["%s" "sp[1]"] "_Generic(&plain, double *: 1, default: 0)" "_Generic(f, float: 1, default: 0)" "(int)b9b"
          ["%zu" "sizeof(typeof(arr)) / sizeof(int)"]]}

  {:id "decl-attributes-standard" :what "the standard attributes on declarations: deprecated, nodiscard, maybe_unused, noreturn, unsequenced, reproducible"
   :clause "6.7.13" :annex-a "attribute-specifier-sequence, attribute-specifier, attribute-list, attribute, attribute-token, standard-attribute, attribute-argument-clause"
   :m2 "attributes: deprecated, fallthrough, maybe_unused, nodiscard, noreturn, unsequenced, reproducible"
   :inc ["stdio.h" "stdlib.h"]
   :top "[[deprecated]] static int old(void) { return 1; }\n[[deprecated(\"use new\")]] static int older(void) { return 2; }\n[[nodiscard]] static int must(void) { return 3; }\n[[nodiscard(\"check it\")]] static int must2(void) { return 4; }\n[[maybe_unused]] static int unused_fn(void) { return 5; }\n[[noreturn]] static void quit(void) { exit(0); }\nstatic int pure_sq(int x) [[unsequenced]] { return x * x; }\nstatic int repro(int x) [[reproducible]] { return x + 1; }\n[[__nodiscard__, __maybe_unused__]] static int both(void) { return 6; }\n[[]] static int empty_attrs = 7;"
   :main "[[maybe_unused]] int unused_local = 0;\nif (must() == 0) quit();"
   :show ["old()" "older()" "must2()" "pure_sq(5)" "repro(5)" "both()" "empty_attrs"]}


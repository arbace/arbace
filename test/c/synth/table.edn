;; synth-c23's table (queue 172; doc/GATE-SURVEY.md GT8.6, GTS207 (a)): C23 construct by construct, one program a row,
;; written into test/c/synth/ by bin/ci synth (test/c/synth/gen.ae; bin/ci synth --check compares the committed files
;; with the table's). Read with the Clojure reader.
;;
;; :programs, each a C23 program (gcc -std=c23) with a main:
;;   :id      the file's name (ID.c), its group first: lex- (A.1), expr- (A.2.1), decl- (A.2.2), stmt- (A.2.3),
;;            ext- (A.2.4), pp- (A.3), lib- (clause 7's C23 additions musl has)
;;   :what    what it covers, one line
;;   :clause  ISO/IEC 9899:2024's subclauses
;;   :annex-a Annex A's productions it exercises (their names in the standard)
;;   :m2      the item of § M.2 (the fifth edition's changes) it covers, when it covers one
;;   :inc     the headers included (default ["stdio.h"])
;;   :top     the file scope before main (text)
;;   :main    main's statements before the prints (text, one statement a line, indented by the generator)
;;   :show    the values printed, in order: "EXPR" (printed with %d) or ["FORMAT" "EXPR"], each as
;;            printf("%s = FORMAT\n", "EXPR", EXPR)
;; Every print is the same on every target gcc runs on (no sizeof or alignment of a type whose size differs between
;; LP64 targets, no long double, no plain char's sign, no byte order), so the reference is gcc 15.2 on amd64 (test/c/
;; ref-gcc15.edn, bin/ci record-ref --corpus synth-c23 --only) and the VM's aarch64 runs give the same outputs.
;; :support: files the programs read (#include, #embed), written beside them verbatim.
{:support
 [{:path "synth.h" :text "// synth-c23's header (test/c/synth/table.edn): pp-include and pp-pragma include it\n#pragma once\n#define SYNTH_H 23\nstatic inline int synth_twice(int x) { return 2 * x; }\n"}
  {:path "synth-embed.dat" :text "C23!\n"}
  {:path "synth-empty.dat" :text ""}]

 :programs
 [
  ;; ------------------------------------------------------------------------------------------------------------
  ;; A.1 Lexical grammar
  {:id "lex-int-constants" :what "integer constants: decimal, octal, hexadecimal, binary, every suffix"
   :clause "6.4.4.1" :annex-a "integer-constant, decimal-constant, octal-constant, hexadecimal-constant, binary-constant, integer-suffix"
   :m2 "binary integer constants (0b, 0B)"
   :show ["42" "017" "0x1F" "0X1f" "0b1011" "0B111" "0" ["%u" "4294967295u"] ["%ld" "100l"] ["%ld" "100L"]
          ["%lld" "9223372036854775807LL"] ["%llu" "18446744073709551615ULL"] ["%lu" "7ul"] ["%llu" "8uLL"]
          ["%lld" "0x7fffffffffffffffll"]
          "_Generic(0x80000000, unsigned int: 1, default: 0)" "_Generic(2147483648, long: 1, long long: 2, default: 0)"
          "_Generic(017u, unsigned int: 1, default: 0)" "_Generic(0b1ull, unsigned long long: 1, default: 0)"]}

  {:id "lex-digit-separators" :what "digit separators in every kind of constant"
   :clause "6.4.4.1, 6.4.4.2" :annex-a "digit, octal-digit, hexadecimal-digit, binary-digit, digit-sequence (with ')"
   :m2 "digit separators (')"
   :show ["1'000'000" "0x1'F" "0b1010'1010" "07'7" "1'2'3'4" ["%lld" "1'000'000'000'000LL"]
          ["%.4f" "1'000.250'0"] ["%g" "1'0e1'0"] ["%g" "0x1'0p0"]]}

  {:id "lex-float-constants" :what "floating constants: decimal, hexadecimal, exponents, suffixes"
   :clause "6.4.4.2" :annex-a "floating-constant, decimal-floating-constant, hexadecimal-floating-constant, exponent-part, binary-exponent-part, floating-suffix"
   :show [["%g" "1.5"] ["%g" ".5"] ["%g" "5."] ["%g" "1e3"] ["%g" "2.5E-2"] ["%g" "1.5e+2"] ["%g" "(double)1.25f"]
          ["%g" "(double)0.75F"] ["%g" "(double)1.25L"] ["%g" "0x1p4"] ["%g" "0x1.8p1"] ["%g" "0X.8P-1"] ["%g" "0xAp0"]
          "_Generic(1.0f, float: 1, default: 0)" "_Generic(1.0, double: 1, default: 0)" "_Generic(1.0l, long double: 1, default: 0)"]}

  {:id "lex-char-constants" :what "character constants: plain, escapes, octal, hexadecimal, L, u, U and u8"
   :clause "6.4.4.5" :annex-a "character-constant, encoding-prefix, c-char, escape-sequence, simple-escape-sequence, octal-escape-sequence, hexadecimal-escape-sequence, universal-character-name"
   :m2 "u8 character constants (of type unsigned char)"
   :show ["'a'" "'\\n'" "'\\t'" "'\\0'" "'\\101'" "'\\x41'" "'\\''" "'\\\"'" "'\\\\'" "'\\?'" "'\\a'" "'\\b'" "'\\f'"
          "'\\r'" "'\\v'" "L'a'" "u'a'" "U'a'" "u8'a'" "U'\\u00e9'" "u'\\u20AC'" "(int)U'\\U0001F600'"
          "_Generic(u8'a', unsigned char: 1, default: 0)" "_Generic(u'a', unsigned short: 1, default: 0)"
          "_Generic(U'a', unsigned int: 1, default: 0)" "_Generic('a', int: 1, default: 0)"]}

  {:id "lex-string-literals" :what "string literals: concatenation, escapes, encoding prefixes, trigraphs kept"
   :clause "6.4.5" :annex-a "string-literal, s-char-sequence, encoding-prefix"
   :m2 "trigraphs removed; u8 string literals of type unsigned char[]"
   :show [["%s" "\"ab\" \"cd\""] ["%s" "\"tab\\tend\""] ["%s" "\"\\x41\\102C\""] ["%s" "\"??=??/??(\""]
          ["%zu" "sizeof \"abc\""] ["%zu" "sizeof u8\"\\u00e9\""] ["%zu" "sizeof L\"ab\" / sizeof L\"ab\"[0]"]
          ["%zu" "sizeof u\"ab\" / sizeof u\"ab\"[0]"] ["%zu" "sizeof U\"ab\" / sizeof U\"ab\"[0]"]
          ["%zu" "sizeof \"a\" \"b\" \"c\""] "u8\"\\u00e9\"[0]" "u8\"\\u00e9\"[1]" "(int)U\"x\\U0001F600\"[1]"
          "_Generic(u8\"a\"[0], unsigned char: 1, default: 0)" "_Generic(&\"a\"[0], char *: 1, default: 0)"]}

  {:id "lex-identifiers" :what "identifiers: underscores, digits, universal character names and UTF-8 letters"
   :clause "6.4.2.1, 6.4.3" :annex-a "identifier, identifier-start, identifier-continue, universal-character-name"
   :m2 "identifiers by Unicode's UAX #31 (XID_Start, XID_Continue)"
   :top "static int _x1 = 1, __y = 2, a_b_c = 3, Z9 = 4;\nstatic int \\u00e9t\\u00e9 = 5;\nstatic int caf\u00e9 = 6;"
   :show ["_x1 + __y + a_b_c + Z9" "\u00e9t\u00e9" "caf\\u00e9"]}

  {:id "lex-keywords-c23" :what "C23's new keywords, each used once"
   :clause "6.4.1" :annex-a "keyword"
   :m2 "alignas, alignof, bool, constexpr, false, nullptr, static_assert, thread_local, true, typeof, typeof_unqual keywords"
   :top "static thread_local int tl = 3;\nstatic alignas(8) int al = 4;\nstatic constexpr int ce = 5;\nstatic_assert(ce == 5);"
   :main "bool b = true;\ntypeof(ce) t = ce;\ntypeof_unqual(ce) u = 6;\nint *p = nullptr;\nu = u + (b != false);"
   :show ["b" "false" "tl" "al" "t" "u" "p == nullptr" ["%zu" "alignof(char)"] "_Generic(true, bool: 1, default: 0)"]}

  {:id "lex-punctuators" :what "punctuators, digraphs and comments"
   :clause "6.4.6, 6.4.9" :annex-a "punctuator (digraphs <: :> <% %> %: %:%:)"
   :top "%:define CAT(a, b) a %:%: b\nstatic int arr<:3:> = <%1, 2, 3%>; /* a block comment */ // a line comment\nstatic int CAT(x, y) = 7;"
   :show ["arr<:1:> + arr[2]" "xy" "1 /* in */ + /**/ 2"]}

  ;; ------------------------------------------------------------------------------------------------------------
  ;; A.2.1 Expressions
  {:id "expr-primary" :what "primary expressions: identifiers, constants, strings, parentheses, __func__"
   :clause "6.5.2, 6.4.2.2" :annex-a "primary-expression"
   :top "static int v = 9;\nstatic const char *name(void) { return __func__; }"
   :show ["v" "(v)" "((v + 1))" "\"xyz\"[1]" ["%s" "name()"] ["%s" "__func__"]]}

  {:id "expr-generic" :what "generic selections: type names, default, lvalue conversion, pointers and qualifiers"
   :clause "6.5.2.1" :annex-a "generic-selection, generic-assoc-list, generic-association"
   :top "#define KIND(x) _Generic((x), int: 1, unsigned: 2, long: 3, double: 4, char *: 5, const char *: 6, int *: 7, default: 0)"
   :main "const int ci = 1;\nint a[2] = {0};\nchar s[] = \"s\";\nshort sh = 1;"
   :show ["KIND(1)" "KIND(1u)" "KIND(1l)" "KIND(1.0)" "KIND(s)" "KIND((const char *)s)" "KIND(a)" "KIND(ci)"
          "KIND(1.0f)" "KIND(sh)" "KIND(+sh)" "_Generic(ci, int: 1, const int: 2)"]}

  {:id "expr-postfix" :what "postfix expressions: subscripts both ways, calls, members, increments, compound literals"
   :clause "6.5.3" :annex-a "postfix-expression, argument-expression-list, compound-literal"
   :top "struct pt { int x, y; };\nstatic int add(int a, int b) { return a + b; }\nstatic int none(void) { return 4; }"
   :main "int a[4] = {10, 20, 30, 40};\nstruct pt p = {1, 2};\nstruct pt *pp = &p;\nint i = 5;\nint post = i++;\nint postd = i--;"
   :show ["a[1]" "2[a]" "add(3, 4)" "none()" "p.x" "pp->y" "post" "postd" "i" "(int[]){7, 8, 9}[2]"
          "(struct pt){.y = 6}.y" "((struct pt *)&p)->x" "(&a[0])[3]"]}

  {:id "expr-unary" :what "unary operators, sizeof and alignof"
   :clause "6.5.4" :annex-a "unary-expression, unary-operator"
   :main "int x = 5;\nint pre = ++x;\nint pred = --x;\nint *p = &x;\nint a[6];\nunsigned u = 0;"
   :show ["pre" "pred" "*p" "+x" "-x" "~x" "!x" "!0" ["%u" "~u"] ["%zu" "sizeof x"] ["%zu" "sizeof(int)"]
          ["%zu" "sizeof a / sizeof a[0]"] ["%zu" "sizeof(char)"] ["%zu" "alignof(char)"] ["%zu" "_Alignof(unsigned char)"]
          ["%zu" "sizeof(int[3]) / sizeof(int)"] "*&*p"]}

  {:id "expr-cast" :what "cast expressions: conversions between integer, floating, pointer and void"
   :clause "6.5.5, 6.3" :annex-a "cast-expression"
   :main "double d = 3.75;\nint n = -7;\nvoid *vp = &n;\n(void)d;"
   :show ["(int)d" "(int)-d" "(unsigned char)300" "(signed char)200" ["%g" "(double)7 / 2"] ["%u" "(unsigned)n"]
          "*(int *)vp" "(int)(long long)1e10 == 1410065408" ["%g" "(double)(float)0.1 == 0.1 ? 1.0 : 0.0"]
          "(bool)0.5" "(bool)2" "(int)(unsigned short)-1"]}

  {:id "expr-arithmetic" :what "multiplicative and additive operators, pointer arithmetic, the usual conversions"
   :clause "6.5.6, 6.5.7, 6.3.1.8" :annex-a "multiplicative-expression, additive-expression"
   :main "int a[5] = {1, 2, 3, 4, 5};\nint *p = a + 1;\nint *q = &a[4];"
   :show ["7 * 6" "17 / 5" "17 % 5" "-17 / 5" "-17 % 5" "17 / -5" "17 % -5" "3 + 4" "3 - 10" "*(p + 2)" "*(q - 1)"
          ["%td" "q - p"] ["%td" "p - q"] "-1 < 0u" "(unsigned short)65535 + 1" ["%g" "1 / 2.0"] ["%u" "0u - 1u"]
          ["%lld" "1000000LL * 1000000"] "'a' + 1"]}

  {:id "expr-shift-relational" :what "shift, relational and equality operators"
   :clause "6.5.8, 6.5.9, 6.5.10" :annex-a "shift-expression, relational-expression, equality-expression"
   :main "int a[3];\nunsigned u = 0x80000000u;"
   :show ["1 << 10" "1024 >> 3" ["%u" "u >> 31"] ["%u" "u << 1"] ["%llu" "1ull << 63 >> 62"] "3 < 4" "4 < 3" "3 > 2"
          "3 <= 3" "3 >= 4" "&a[0] < &a[2]" "&a[2] >= &a[1]" "1 == 1" "1 != 1" "(1 < 2) == (2 < 3)" "-1 < 1u"]}

  {:id "expr-bitwise-logical" :what "bitwise and logical operators, short-circuit evaluation"
   :clause "6.5.11-6.5.15" :annex-a "AND-expression, exclusive-OR-expression, inclusive-OR-expression, logical-AND-expression, logical-OR-expression"
   :top "static int calls;\nstatic int hit(int r) { calls++; return r; }"
   :main "int and1 = hit(0) && hit(1);\nint or1 = hit(1) || hit(0);\nint and2 = hit(1) && hit(2);"
   :show ["0xF0 & 0x3C" "0xF0 ^ 0x3C" "0xF0 | 0x0F" "and1" "or1" "and2" "calls" "0 || 0" "5 && 7" "!(1 && 0)"]}

  {:id "expr-conditional-comma" :what "conditional and comma operators"
   :clause "6.5.16, 6.5.18" :annex-a "conditional-expression, expression"
   :main "int a = 1, b = 2, c;\nc = (a++, b++, a + b);\nint *p = a > 5 ? &a : &b;\nconst char *s = c ? \"yes\" : \"no\";"
   :show ["c" "a" "b" "*p" "a ? b : c" "0 ? 1 : 2 ? 3 : 4" ["%s" "s"] ["%g" "1 ? 1 : 2.5"]]}

  {:id "expr-assignment" :what "simple and compound assignment"
   :clause "6.5.17" :annex-a "assignment-expression, assignment-operator"
   :main "int x = 100, y;\nint r[11];\nr[0] = (x *= 3);\nr[1] = (x /= 7);\nr[2] = (x %= 11);\nr[3] = (x += 40);\nr[4] = (x -= 2);\nr[5] = (x <<= 3);\nr[6] = (x >>= 1);\nr[7] = (x &= 0x7C);\nr[8] = (x ^= 0x55);\nr[9] = (x |= 0x100);\nr[10] = (y = x = 5);"
   :show ["r[0]" "r[1]" "r[2]" "r[3]" "r[4]" "r[5]" "r[6]" "r[7]" "r[8]" "r[9]" "r[10]" "y"]}

  {:id "expr-constant" :what "constant expressions: array sizes, case labels, enumerators, static initializers"
   :clause "6.6" :annex-a "constant-expression"
   :top "enum { K = 3 * 4 + 1 };\nstatic int arr[K - 10];\nstatic int *const ptr = &arr[2];\nstatic const int sz = (int)(sizeof arr / sizeof arr[0]);\nstatic int pick(int v) { switch (v) { case K: return 1; case K + 1: return 2; default: return 0; } }"
   :show ["K" "sz" "(int)(ptr - arr)" "pick(13)" "pick(14)" "pick(0)" "(1 ? 2 : 3) * (4 , 5)"]}

  {:id "expr-compound-literals" :what "compound literals at file and block scope, lvalues, C23's storage-class specifiers in them"
   :clause "6.5.3.6" :annex-a "compound-literal, storage-class-specifiers"
   :m2 "storage-class specifiers in compound literals (static, constexpr, register, thread_local)"
   :top "struct pt { int x, y; };\nstatic int *fp = (int[]){4, 5, 6};\nstatic int *counter(void) { return &(static int){0}; }"
   :main "int *bp = (int[3]){1, 2, 3};\nbp[1] = 20;\n++*counter();\n++*counter();\nstruct pt *q = &(struct pt){.x = 3, .y = 4};\nq->y += 1;"
   :show ["fp[2]" "bp[1]" "*counter()" "q->x + q->y" "(constexpr int){42}" "(register int){7} + 1" "(const int){3}"]}

  {:id "expr-nullptr" :what "nullptr and nullptr_t: conversions, comparisons, conditions"
   :clause "6.4.4.6, 7.21.2" :annex-a "predefined-constant (nullptr)"
   :m2 "nullptr and nullptr_t"
   :main "typeof(nullptr) n = nullptr;\nint *p = n;\nvoid *v = nullptr;\nint (*fp)(void) = nullptr;\nint x = 0;\nint *q = &x;"
   :show ["p == nullptr" "v == nullptr" "fp == nullptr" "q != nullptr" "nullptr == n" "n ? 1 : 0" "!nullptr"
          "_Generic(nullptr, typeof(nullptr): 1, default: 0)" "_Generic(n, void *: 1, default: 0)"
          "sizeof(nullptr) == sizeof(void *)" "(p ? 2 : 3)"]}

  {:id "expr-sizeof-vla" :what "sizeof of variable length arrays, evaluated at run time"
   :clause "6.5.4.4, 6.7.7.3" :annex-a "unary-expression (sizeof)"
   :top "static int width(int n) { int a[n]; return (int)(sizeof a / sizeof a[0]); }"
   :main "int n = 6;\nint m[n][n + 1];\nint k = 0;\nsize_t s = sizeof(int[++k]);"
   :show ["width(5)" ["%zu" "sizeof m / sizeof m[0]"] ["%zu" "sizeof m[0] / sizeof m[0][0]"] "k" ["%zu" "s / sizeof(int)"]]}

  {:id "expr-conversions" :what "integer promotions, signed and unsigned mixing, floating to integer"
   :clause "6.3.1" :annex-a "(conversions within expressions)"
   :main "unsigned char uc = 250;\nsigned char sc = -6;\nunsigned short us = 65535;\nlong long ll = -1;\nunsigned u = 3;"
   :show ["uc + 10" "sc * 2" "us + 1" "_Generic(uc + uc, int: 1, default: 0)" "ll < u" "(int)2.99" "(int)-2.99"
          ["%u" "(unsigned)-1"] ["%llu" "(unsigned long long)ll"] ["%g" "(double)(1ull << 53)"] "(int)(char)65"
          "_Generic(1 + 1u, unsigned: 1, default: 0)" "_Generic(1 + 1ll, long long: 1, default: 0)"]}

  {:id "expr-floating" :what "floating arithmetic and comparisons (IEC 60559 double and float)"
   :clause "6.5, Annex F" :annex-a "(arithmetic on floating types)"
   :main "double a = 0.1, b = 0.2;\nfloat f = 1.0f / 3.0f;\ndouble z = 0.0;"
   :show [["%.17g" "a + b"] ["%.9g" "(double)f"] "a + b == 0.3" ["%g" "1.0 / 4"] ["%g" "-z"] "1.0 / 3 > 0.333"
          ["%g" "1e308 * 10 > 1e308 ? 1.0 : 0.0"] ["%.3f" "2.0 * 1.5 - 0.25"] "(int)(7.0 / 2.0)"]}

  ;; ------------------------------------------------------------------------------------------------------------
  ;; A.2.2 Declarations
  {:id "decl-storage-classes" :what "storage-class specifiers: typedef, extern, static, register, auto, thread_local"
   :clause "6.7.2" :annex-a "storage-class-specifier"
   :top "typedef int myint;\nextern int ext;\nint ext = 11;\nstatic int file_static = 12;\nstatic _Thread_local int tl1 = 13;\nstatic thread_local int tl2 = 14;\nstatic int bump(void) { static int n; return ++n; }"
   :main "register int r = 15;\nauto int a = 16;\nmyint m = 17;\nbump();\nbump();\nextern int ext;"
   :show ["ext" "file_static" "tl1" "tl2" "r" "a" "m" "bump()"]}

  {:id "decl-type-specifiers" :what "the basic type specifiers in their combinations"
   :clause "6.7.3" :annex-a "type-specifier"
   :main "void *vp = 0;\nchar c = 'c';\nsigned char sc = -1;\nunsigned char uc = 255;\nshort s = -2;\nshort int si = 3;\nunsigned short us = 4;\nint i = -5;\nsigned si2 = -6;\nunsigned u = 7;\nunsigned int ui = 8;\nlong l = -9;\nlong int li = 10;\nunsigned long ul = 11;\nlong long ll = -12;\nlong long int lli = 13;\nunsigned long long ull = 14;\nfloat f = 1.5f;\ndouble d = 2.5;\nlong double ld = 3.5;\nbool b = 1;\n_Bool b2 = 2;\nsigned long long int slli = -15;\nlong unsigned int lui = 16;"
   :show ["vp == 0" "c" "sc" "uc" "s" "si" "us" "i" "si2" ["%u" "u"] ["%u" "ui"] ["%ld" "l"] ["%ld" "li"] ["%lu" "ul"]
          ["%lld" "ll"] ["%lld" "lli"] ["%llu" "ull"] ["%g" "f"] ["%g" "d"] ["%g" "(double)ld"] "b" "b2" ["%lld" "slli"]
          ["%lu" "lui"]]}

  {:id "decl-bitint" :what "bit-precise integer types: widths, signedness, wb and uwb suffixes, wrap-around"
   :clause "6.2.5, 6.4.4.1, 6.7.3" :annex-a "type-specifier (_BitInt), integer-suffix (wb, uwb)"
   :m2 "bit-precise integer types _BitInt(N) and the wb suffix"
   :main "_BitInt(7) s7 = 63;\nunsigned _BitInt(7) u7 = 127;\nu7 = u7 + 1;\nunsigned _BitInt(1) bit = 1;\n_BitInt(37) w = (_BitInt(37))1 << 35;\nunsigned _BitInt(64) big = 0xFFFFFFFFFFFFFFFFuwb;\n_BitInt(12) neg = -2048;\nsigned _BitInt(2) two = -2;"
   :show ["(int)s7" "(int)u7" "(int)bit" ["%lld" "(long long)w"] ["%llu" "(unsigned long long)big"] "(int)neg" "(int)two"
          "(int)(s7 + 1wb)" "_Generic(1wb, _BitInt(2): 1, default: 0)" "_Generic(1uwb, unsigned _BitInt(1): 1, default: 0)"
          "_Generic(u7 + u7, unsigned _BitInt(7): 1, default: 0)" "(int)(unsigned _BitInt(3))13"]}

  {:id "decl-bitint-wide" :what "wide bit-precise integers (128, 200 and 256 bits): arithmetic, shifts, division"
   :clause "6.2.5, 6.7.3" :annex-a "type-specifier (_BitInt)"
   :m2 "bit-precise integer types _BitInt(N) wider than long long"
   :top "typedef unsigned _BitInt(256) u256;\nstatic unsigned long long part(u256 v, int i) { return (unsigned long long)(v >> (64 * i)); }"
   :main "u256 a = 0xFFFFFFFFFFFFFFFFuwb;\nu256 p = a * a;\nunsigned _BitInt(128) q = (unsigned _BitInt(128))1 << 100;\n_BitInt(200) n = -((_BitInt(200))1 << 150);\nu256 d = p / 0x10001uwb;\nu256 m = p % 1000000007uwb;"
   :show [["%llx" "part(p, 0)"] ["%llx" "part(p, 1)"] ["%llx" "(unsigned long long)(q >> 64)"] "n < 0"
          ["%llx" "(unsigned long long)(-n >> 140)"] ["%llx" "part(d, 0)"] ["%llx" "part(d, 1)"] ["%llu" "part(m, 0)"]
          "(int)(p == a * a)"]}

  {:id "decl-struct-union" :what "structures and unions: members, nesting, anonymous members, flexible array member, tags"
   :clause "6.7.3.2" :annex-a "struct-or-union-specifier, struct-or-union, member-declaration-list, member-declaration, specifier-qualifier-list, member-declarator-list, member-declarator"
   :inc ["stdio.h" "stdlib.h"]
   :top "struct node;\nstruct node { int v; struct node *next; };\nstruct outer { int a; struct { int b, c; }; union { int d; float e; }; struct inner { int f; } in; };\nunion u { int i; unsigned char bytes[4]; };\nstruct flex { int n; int data[]; };"
   :main "struct node n2 = {2, 0}, n1 = {1, &n2};\nstruct outer o = {.a = 1, .b = 2, .c = 3, .d = 4, .in = {5}};\nunion u un = {.i = 0};\nun.bytes[0] = 0;\nstruct flex *fx = malloc(sizeof(struct flex) + 3 * sizeof(int));\nfx->n = 3;\nfor (int i = 0; i < 3; i++) fx->data[i] = i * i;\nstruct inner in2 = o.in;"
   :show ["n1.next->v" "o.a + o.b + o.c + o.d + o.in.f" "un.i" "fx->data[2]" "in2.f"
          "sizeof(struct flex) == sizeof(int)"]}

  {:id "decl-bitfields" :what "bit-fields: unsigned wrap, signed range, bool bit-fields, unnamed and zero-width"
   :clause "6.7.3.2" :annex-a "member-declarator (declarator_opt : constant-expression)"
   :top "struct bf { unsigned u3 : 3; signed s3 : 3; bool flag : 1; unsigned : 0; unsigned rest : 5; unsigned : 2; };"
   :main "struct bf b = {0};\nb.u3 = 9;\nb.s3 = 3;\nb.s3 = b.s3 + 1 - 8;\nb.flag = 5;\nb.rest = 31;\nb.rest++;"
   :show ["b.u3" "b.s3" "b.flag" "b.rest" "_Generic(b.flag, bool: 1, default: 0)"]}

  {:id "decl-tag-compat" :what "C23's tag compatibility: a structure, union or enumeration redefined with the same content"
   :clause "6.7.3.4, 6.2.7" :annex-a "struct-or-union-specifier"
   :m2 "a tag redefined with the same content is the same type"
   :top "struct pair { int a, b; };\nstruct pair { int a, b; };\nunion num { int i; double d; };\nunion num { int i; double d; };\nenum color { RED, GREEN };\nenum color { RED, GREEN };\nstatic int sum(struct pair { int a, b; } p) { return p.a + p.b; }"
   :main "struct pair p = {3, 4};\nunion num n = {.i = 5};"
   :show ["sum(p)" "n.i" "GREEN"]}

  {:id "decl-enum" :what "enumerations: implicit and explicit values, negative values, a trailing comma, use as integers"
   :clause "6.7.3.3" :annex-a "enum-specifier, enumerator-list, enumerator"
   :top "enum fruit { APPLE, PEAR = 5, PLUM, FIG = -2, KIWI, };\nenum { ANON = 100 };\ntypedef enum { T0, T1 } tenum;"
   :main "enum fruit f = PLUM;\ntenum t = T1;"
   :show ["APPLE" "PEAR" "PLUM" "FIG" "KIWI" "ANON" "f" "t" "f == 6" "_Generic(PEAR, int: 1, default: 0)"]}

  {:id "decl-enum-underlying" :what "C23 enumerations with a fixed underlying type and with values beyond int"
   :clause "6.7.3.3" :annex-a "enum-specifier, enum-type-specifier"
   :m2 "enumerations with a fixed underlying type; enumeration constants of types other than int"
   :top "enum small : unsigned char { S0, S1 = 255 };\nenum wide : long long { W0 = -1, W1 = 0x100000000 };\nenum { BIG = 0x100000000, BIGGER };\nenum fwd : short;\nenum fwd : short { F0 = -3 };"
   :main "enum small s = S1;\ns = s + 1;"
   :show [["%zu" "sizeof(enum small)"] "s" "_Generic(S1, enum small: 1, default: 0)" ["%lld" "(long long)W1"]
          ["%lld" "(long long)W0"] ["%zu" "sizeof(enum wide)"] ["%lld" "(long long)BIG"] ["%lld" "(long long)BIGGER"]
          ["%zu" "sizeof BIG"] "(int)F0" ["%zu" "sizeof(enum fwd)"]]}

  {:id "decl-qualifiers" :what "type qualifiers: const, volatile, restrict, _Atomic, on objects and pointers"
   :clause "6.7.4" :annex-a "type-qualifier, type-qualifier-list"
   :top "static int copy(int *restrict dst, const int *restrict src, int n) { for (int i = 0; i < n; i++) dst[i] = src[i]; return dst[n - 1]; }"
   :main "const int c = 1;\nvolatile int v = 2;\nv = v + 1;\nconst volatile int cv = 4;\nint src[3] = {5, 6, 7}, dst[3];\nint x = 8;\nint *const cp = &x;\n*cp = 9;\nconst int *pc = &c;\n_Atomic int at = 10;\nat += 1;\n_Atomic(long) al = 12;"
   :show ["c" "v" "cv" "copy(dst, src, 3)" "x" "*pc" "at" ["%ld" "(long)al"] "_Generic(&c, const int *: 1, default: 0)"]}

  {:id "decl-function-specifiers" :what "function specifiers inline and _Noreturn, and the noreturn attribute"
   :clause "6.7.5, 6.7.13.7" :annex-a "function-specifier"
   :inc ["stdio.h" "stdlib.h"]
   :top "static inline int sq(int x) { return x * x; }\ninline int cube(int x) { return x * x * x; }\nextern inline int cube(int x);\n_Noreturn static void stop(int s) { exit(s); }\n[[noreturn]] static void halt(void) { exit(0); }"
   :main "if (sq(2) == 5) stop(1);\nif (cube(2) == 9) halt();"
   :show ["sq(7)" "cube(3)"]}

  {:id "decl-alignment" :what "alignment specifiers alignas and _Alignas, alignof"
   :clause "6.7.6, 6.5.4.4" :annex-a "alignment-specifier"
   :inc ["stdio.h" "stdint.h"]
   :top "static alignas(32) int a32;\nstatic _Alignas(16) char c16[4];\nstruct al { char c; alignas(8) int i; };\nstatic alignas(double) int ad;"
   :show ["(int)((uintptr_t)&a32 % 32)" "(int)((uintptr_t)c16 % 16)" "alignof(struct al) >= 8"
          ["%zu" "offsetof_i()"] "(int)((uintptr_t)&ad % alignof(double))"]
   :main "#define offsetof_i() ((size_t)&((struct al *)0)->i % 8)"}

  {:id "decl-declarators" :what "declarators: pointers, arrays, functions and their compositions"
   :clause "6.7.7" :annex-a "declarator, direct-declarator, array-declarator, function-declarator, pointer"
   :top "static int one(void) { return 1; }\nstatic int two(void) { return 2; }\nstatic int (*pick(int i))(void) { return i ? two : one; }\nstatic int (*table[2])(void) = {one, two};\nstatic int grid[2][3] = {{1, 2, 3}, {4, 5, 6}};"
   :main "int x = 3;\nint *p = &x;\nint **pp = &p;\nint *arr[2] = {&x, p};\nint (*row)[3] = grid;\nint (*(*fpp))(void) = &table[1];\nint *const *cpp = &p;"
   :show ["**pp" "*arr[1]" "row[1][2]" "pick(0)()" "pick(1)()" "table[0]()" "(*fpp)()" "**cpp" "(*(row + 1))[0]"]}

  {:id "decl-abstract-declarators" :what "type names with abstract declarators in casts, sizeof, compound literals and _Generic"
   :clause "6.7.8" :annex-a "type-name, abstract-declarator, direct-abstract-declarator, array-abstract-declarator, function-abstract-declarator"
   :top "static int inc(int x) { return x + 1; }"
   :main "int a[4] = {1, 2, 3, 4};\nint (*pa)[4] = (int (*)[4])&a;\nint (*f)(int) = (int (*)(int))inc;\nvoid *v = (void *)&a;"
   :show ["(*pa)[3]" "f(4)" ["%zu" "sizeof(int[4]) / sizeof(int)"] "sizeof(int (*)[4]) == sizeof(void *)"
          "_Generic(&a, int (*)[4]: 1, default: 0)" "_Generic(inc, int (*)(int): 1, default: 0)"
          "((int *)v)[2]" "_Generic((int *const *)0, int *const *: 1, default: 0)" "(int){(int)sizeof(char[5])}"]}

  {:id "decl-parameters" :what "parameter lists: (void), C23's (), unnamed parameters in definitions, arrays with static, [*], variadic"
   :clause "6.7.7.4, 6.9.2" :annex-a "parameter-type-list, parameter-list, parameter-declaration"
   :m2 "unnamed parameters in function definitions; () declares no parameters"
   :top "static int nothing();\nstatic int nothing(void) { return 3; }\nstatic int second(int, int b) { return b; }\nstatic int first3(int a[static 3]) { return a[0] + a[1] + a[2]; }\nstatic int qual(int a[const 2]) { return a[1]; }\nstatic int vsum(int n, int a[*]);\nstatic int vsum(int n, int a[n]) { int s = 0; for (int i = 0; i < n; i++) s += a[i]; return s; }\nstatic int count(int n, ...) { return n; }\nstatic int fnparam(int f(int), int x) { return f(x); }\nstatic int neg(int x) { return -x; }\nstatic int star(int, int[*]);\nstatic int star(int n, int a[n]) { return a[n - 1]; }\nstatic int cstat(int a[const static 2]) { return a[1] + 1; }\nstatic int restr(int *restrict[2]);\nstatic int restr(int *restrict p[2]) { return *p[0]; }"
   :main "int a[4] = {1, 2, 3, 4};"
   :show ["nothing()" "second(1, 2)" "first3(a)" "qual(a)" "vsum(4, a)" "count(2, 1.0, \"x\")" "fnparam(neg, 5)" "star(3, a)" "cstat(a)" "restr((int *[2]){a + 3, a})"]}

  {:id "decl-array-params-abstract" :what "array parameters with static in prototypes without names (abstract declarators)"
   :clause "6.7.7.4, 6.7.8" :annex-a "array-abstract-declarator ([ static type-qualifier-list_opt assignment-expression ], [ type-qualifier-list static assignment-expression ])"
   :top "static int stat2(int[static 2]);\nstatic int stat2(int a[static 2]) { return a[0] * a[1]; }\nstatic int cstat2(int[const static 2]);\nstatic int cstat2(int a[const static 2]) { return a[1]; }"
   :main "int a[3] = {3, 4, 5};"
   :show ["stat2(a)" "cstat2(a + 1)"]}

  {:id "decl-floatn-wide" :what "Annex H's _Float16, _Float128 and _Float64x and their suffixes, printed as double (exact values)"
   :clause "H.2, H.4" :annex-a "type-specifier (_Float16, _Float128, _Float64x), floating-suffix (f16, f128, f64x)"
   :main "_Float16 h = 0.5f16;\n_Float32 hs = h * 4;\n_Float16 sum = h + h;\n_Float128 q = 2.0f128;\n_Float64x x = 1.25f64x;"
   :show [["%g" "(double)h"] ["%g" "(double)hs"] ["%g" "(double)sum"] "_Generic(h * h, _Float16: 1, default: 0)"
          ["%g" "(double)q"] ["%g" "(double)x"] ["%g" "(double)(q * x)"] "_Generic(q, _Float128: 1, default: 0)"]}

  {:id "decl-vla" :what "variable length arrays: block scope, parameters, two dimensions, typedef"
   :clause "6.7.7.3" :annex-a "array-declarator"
   :m2 "variably modified types mandatory"
   :top "static int trace(int n, int m[n][n]) { int t = 0; for (int i = 0; i < n; i++) t += m[i][i]; return t; }"
   :main "int n = 4;\nint m[n][n];\nfor (int i = 0; i < n; i++) for (int j = 0; j < n; j++) m[i][j] = i * n + j;\ntypedef int row[n];\nn = 9;\nrow r;\nint (*pm)[4] = m;"
   :show ["trace(4, m)" ["%zu" "sizeof r / sizeof r[0]"] "pm[3][3]"]}

  {:id "decl-typedefs" :what "typedef names: scopes, redeclaration, function and array types, shadowing"
   :clause "6.7.9" :annex-a "typedef-name"
   :top "typedef int T;\ntypedef int T;\ntypedef int fn(int);\ntypedef T arr3[3];\nstatic fn twice;\nstatic int twice(int x) { return 2 * x; }\ntypedef struct { int v; } box;"
   :main "arr3 a = {1, 2, 3};\nbox b = {4};\nint r;\n{ typedef double T; T d = 1.5; r = (int)(d * 2); }\nT T2 = 5;\n{ int T = 6; r += T; }"
   :show ["a[2]" "b.v" "twice(T2)" "r"]}

  {:id "decl-initializers" :what "initializers: scalars, braces, nesting, designators, strings, unions, overrides"
   :clause "6.7.11" :annex-a "initializer, braced-initializer, initializer-list, designation, designator-list, designator"
   :top "struct pt { int x, y; };\nstruct line { struct pt a, b; int tag[2]; };\nunion iu { int i; double d; };"
   :main "int s = {5};\nint a[5] = {1, 2};\nint d[6] = {[4] = 4, [1] = 1, 2};\nstruct pt p = {.y = 2, .x = 1};\nstruct line l = {.b.y = 7, .tag[1] = 9, .a = {3, 4}};\nstruct line l2 = {1, 2, 3, 4, 5, 6};\nchar str[] = \"abc\";\nchar exact[3] = \"xyz\";\nunion iu u1 = {7};\nunion iu u2 = {.d = 2.5};\nint over[3] = {[0] = 1, [0] = 2};\nint m[2][2] = {1, 2, 3};\nstruct pt ps[] = {{1, 2}, [2] = {.y = 5}};"
   :show ["s" "a[1] + a[4]" "d[1] + d[2] + d[4]" "p.x * 10 + p.y" "l.a.y + l.b.y + l.tag[1] + l.b.x" "l2.tag[1]"
          ["%zu" "sizeof str"] "exact[2]" "u1.i" ["%g" "u2.d"] "over[0]" "m[1][0] + m[1][1]" ["%zu" "sizeof ps / sizeof ps[0]"]
          "ps[2].y"]}

  {:id "decl-empty-initializer" :what "C23's empty initializer {} for scalars, arrays, structures, unions and VLAs"

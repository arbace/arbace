#!/bin/bash
# A stand-in for tools/cirun (review 027, finding 6's judge-test): its first run hangs past bin/ci check's 10 s, as a
# loaded host's can; later runs are the real cirun's (CIRUN_REAL). CIRUN_ONCE names its state file.
if [ ! -e "$CIRUN_ONCE" ]; then : > "$CIRUN_ONCE"; exec sleep 15; fi
exec "$CIRUN_REAL" "$@"

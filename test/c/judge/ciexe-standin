#!/bin/bash
# A stand-in for CI_EXE (an executable built with ci) in judge-test: bin/lib/ci/check calls it as
# `CI_EXE -m arbace.c.repl run-nodes FILE`; it logs its arguments and runs the real cirun (CIRUN_REAL) over FILE.
echo "$*" >> "$CIEXE_LOG"
[ "$1 $2 $3" = "-m arbace.c.repl run-nodes" ] || { echo "ciexe-standin: unexpected arguments: $*" >&2; exit 70; }
shift 3
exec "$CIRUN_REAL" "$@"

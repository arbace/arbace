#!/bin/bash
# A stand-in for an executable built with ci in judge-test (bin/ci cinterp-check --exe): `-m arbace.c.repl backend` says cinterp,
# `-m arbace.c.repl run-nodes FILE ARG...` runs FILE on the Go side of CInterp (CINTERP_RUN, the driver bin/ci cinterp-check builds).
[ "$1 $2" = "-m arbace.c.repl" ] || { echo "cinterp-exe-standin: unexpected arguments: $*" >&2; exit 70; }
case $3 in
  backend) echo cinterp ;;
  run-nodes) shift 3; exec "$CINTERP_RUN" "$@" ;;
  *) exit 70 ;;
esac

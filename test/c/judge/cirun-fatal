#!/bin/bash
# A stand-in for tools/cirun (CS213's judge-test): exits with ptr-sub-unsigned.c's status (3, gcc's) after the line Go's
# runtime prints when it dies (stack exhaustion), as a crashed runner whose exit status happens to be the program's.
echo "runtime: goroutine stack exceeds 1000000000-byte limit" >&2
echo "fatal error: stack overflow" >&2
exit 3

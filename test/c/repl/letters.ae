;; ci's REPL session (doc/C23-SURVEY.md §6.6; doc/c/SPEC.md §2's letters.c typed as forms): a unit as a
;; namespace, musl's <stdio.h> included at the REPL, main run in the program mode, a function redefined and
;; seen by the next run, exit and abort ending the run and not the REPL. bin/ci repl-session runs it (on the
;; light path's back end, tools/cirun) and compares its output with letters.out.
(ns c.letters (:require [arbace.c :as c]))

(c/file "letters.c" :std :c23)
(c/include "<stdio.h>")
(c/include "<stdlib.h>")

(c/var ^:static ^{:tag (array 26 int)} count)

(c/defn ^:static tally ^int [^{:tag (* (const char))} s]
  (let [^int n 0]
    (for [] @s (inc! s)
      (when (and (>= @s \a) (<= @s \z))
        (inc! (aget count (- @s \a)))
        (set! n + 1)))
    (return n)))

(c/defn main ^int [void]
  (let [^int n (tally "hello, world")]
    (printf "%d %d\n" n (aget count (- \l \a)))
    (return 0)))

(println "run 1 =>" (c/run-main 'c.letters))

;; a redefinition: the next run calls the new tally (every call goes through its cell)
(c/defn ^:static tally ^int [^{:tag (* (const char))} s]
  (let [^int n 0]
    (for [] @s (inc! s) (set! n + 1))
    (return n)))

(println "run 2 =>" (c/run-main 'c.letters))

;; exit and abort end the run, not the REPL
(c/defn main ^int [void]
  (printf "%d\n" (tally "abc"))
  (exit 7))
(println "run 3 =>" (c/run-main 'c.letters))

(c/defn main ^int [void]
  (puts "aborting")
  (abort))
(println "run 4 =>" (c/run-main 'c.letters))
(println "the REPL goes on")

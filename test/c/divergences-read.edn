;; The read level's divergences of repr/c from cc, the reference of its token and tree checks (doc/C23-SURVEY.md, "As built: C2",
;; "As built: C3"; bin/repr-c check --tokens, parse-check): the classes of test/repr/c/pp-check-known.edn and parse-check-known.edn, in
;; test/goi/divergences.edn's format (C8, generated from their :classes, the kinds chosen there: a difference cc has and gcc settles is
;; by design, a gap of the port's to close is deferred). A file's case is "corpus file", its reason "known CLASS: the class's text"
;; (test/reap/main.ae's :c-known).
;; c23-if-true, elifdef, gnu-builtin-macro and pragma-once take no file now (queue 122, F9): classes of the known files' :classes,
;; kept so that a file the token check gives one is judged by its kind. invalid-paste's files are the tree check's mutants, which the
;; read cell does not count (queue 132 F3, the user's decision of 2026-11-02: test/reap/cells.edn's :exclude-corpora): kept likewise.
;; No class takes `unclassified`, the known file's placeholder its --record gives a new failing file: bin/reap reports
;; such a file as in no class (queue 122). Read with the Clojure reader.
[
 {:id :assembler
  :title "an assembler source (.S) gcc preprocesses as assembler-with-cpp, its lexing not C's"
  :kind :design
  :why "an assembler source (.S) gcc preprocesses as assembler-with-cpp, its lexing not C's"
  :decided "CS260 (a); C8"
  :match [#"^known assembler:"]}
 {:id :c23-colons
  :title "C23's :: punctuator (6.4.6), which cc's scanner lacks"
  :kind :design
  :why "C23's :: punctuator (6.4.6), which cc's scanner lacks: a paste of : and : is one token to gcc in C23, two to the port (whose lexer is cc's), the tokens' texts the same"
  :decided "CS260 (a); C8"
  :match [#"^known c23-colons:"]}
 {:id :c23-if-true
  :title "true and false in a C23 #if (6.10.1)"
  :kind :design
  :why "true and false in a C23 #if (6.10.1): 1 and 0, where cc reads identifiers as 0"
  :decided "CS260 (a); C8"
  :match [#"^known c23-if-true:"]}
 {:id :cc-panic
  :title "cc's preprocessor panics (the port's too, at the same place), where gcc reads the file"
  :kind :design
  :why "cc's preprocessor panics (the port's does too, at the same place), where gcc reads the file"
  :decided "CS260 (a); C8"
  :match [#"^known cc-panic:"]}
 {:id :digit-separators
  :title "C23's digit separators in a #line's number, which cc's ParseUint refuses"
  :kind :design
  :why "C23's digit separators (6.4.4.1) in a #line's number, which cc's ParseUint refuses (the directive ignored)"
  :decided "CS260 (a); C8"
  :match [#"^known digit-separators:"]}
 {:id :elifdef
  :title "C23's #elifdef and #elifndef (6.10.2), which cc reads as non-directives inside a group"
  :kind :design
  :why "C23's #elifdef and #elifndef (6.10.2), which cc reads as non-directives inside a group"
  :decided "CS260 (a); C8"
  :match [#"^known elifdef:"]}
 {:id :embed
  :title "C23's #embed and __has_embed (6.10.4, 6.10.1), which cc lacks"
  :kind :design
  :why "C23's #embed and __has_embed (6.10.4, 6.10.1), which cc lacks: cc reads #embed as a non-directive and __has_embed as an identifier; the port lexes #embed's header name and expands the resource's bytes, its parameters as gcc's (limit, prefix, suffix, if_empty, gnu::offset, gnu::base64)"
  :decided "CS260 (a); C8"
  :match [#"^known embed:"]}
 {:id :error-test
  :title "a file the reference rejects (gcc -E's status not 0, a dg-error test)"
  :kind :design
  :why "a file the reference rejects (gcc -E's status not 0, a dg-error test): the port reports an error too"
  :decided "CS260 (a); C8"
  :match [#"^known error-test:"]}
 {:id :eval-depth
  :title "the parse recurses deeper than the evaluator's 10,000 interpreted calls"
  :kind :deferred
  :why "the parse recurses deeper than the evaluator's 10,000 interpreted calls (Compiler's MAX_DEPTH): cc's Go stack grows to 1 GB, the port evaluated on the tools' host gives the evaluator's StackOverflowError, a panic (CS60)"
  :decided "CS60 (a); C8"
  :match [#"^known eval-depth:"]}
 {:id :gnu-builtin-macro
  :title "gcc's __BASE_FILE__, __INCLUDE_LEVEL__, __FILE_NAME__, __TIMESTAMP__"
  :kind :design
  :why "gcc's __BASE_FILE__, __INCLUDE_LEVEL__, __FILE_NAME__, __TIMESTAMP__"
  :decided "CS260 (a); C8"
  :match [#"^known gnu-builtin-macro:"]}
 {:id :has-c-attribute
  :title "__has_c_attribute (6.10.1), which cc answers 0 (an identifier)"
  :kind :design
  :why "__has_c_attribute (6.10.1), which cc answers 0 (an identifier): the port answers gcc's recorded values"
  :decided "CS260 (a); C8"
  :match [#"^known has-c-attribute:"]}
 {:id :has-gnu
  :title "gcc's __has_attribute, __has_builtin, __has_feature and __has_extension"
  :kind :design
  :why "gcc's __has_attribute, __has_builtin, __has_feature and __has_extension: cc answers its own (0, or its prefix rules); the port gcc's recorded answers"
  :decided "CS260 (a); C8"
  :match [#"^known has-gnu:"]}
 {:id :invalid-paste
  :title "a ## that does not make one token (6.10.5.3, a mutant's)"
  :kind :design
  :why "a ## that does not make one token (6.10.5.3, a mutant's): cc joins the texts, the port keeps the two tokens and reports gcc's error (the token check's class)"
  :decided "CS260 (a); C8"
  :match [#"^known invalid-paste:"]}
 {:id :pp-errors
  :title "the trees equal, the errors not"
  :kind :design
  :why "the trees equal, the errors not: the preprocessor's errors, where the port follows gcc (#if's binary constants and wb suffixes, __has_c_attribute's answers in #error tests, #elifdef, a missing #embed resource) and cc reports another or none"
  :decided "CS260 (a); C8"
  :match [#"^known pp-errors:"]}
 {:id :pp-known
  :title "the preprocessed stream is known to differ from cc's (the token check's class)"
  :kind :design
  :why "the preprocessed stream is known to differ from cc's (test/repr/c/pp-check-known.edn, its class there: the reference's tokens where cc is wrong), and the tree with it"
  :decided "CS260 (a); C8"
  :match [#"^known pp-known:"]}
 {:id :pragma-once
  :title "#pragma once, which cc ignores"
  :kind :design
  :why "#pragma once, which cc ignores"
  :decided "CS260 (a); C8"
  :match [#"^known pragma-once:"]}
 {:id :trigraphs
  :title "phase 1's trigraphs, which cc does not read and gcc does: the port follows gcc"
  :kind :design
  :why "phase 1's trigraphs, which cc does not read and gcc does at -std=c89 to c17 and with -trigraphs: the port follows gcc (CS50 (a))"
  :decided "CS50 (a); C8"
  :match [#"^known trigraphs:"]}
 {:id :u-prefix
  :title "C11's u'x', U'x', u\"x\", U\"x\" (6.4.4.5, 6.4.5)"
  :kind :design
  :why "C11's u'x', U'x', u\"x\", U\"x\" (6.4.4.5, 6.4.5): cc's scanner reads the prefix as an identifier; the port one token (of the wide kinds)"
  :decided "CS260 (a); C8"
  :match [#"^known u-prefix:"]}
 {:id :ucn-identifier
  :title "universal character names in identifiers, one identifier to gcc: the port follows gcc"
  :kind :design
  :why "universal character names in identifiers, which cc lexes as a backslash and an identifier and gcc as one identifier: the port follows gcc (CS50 (a))"
  :decided "CS50 (a); C8"
  :match [#"^known ucn-identifier:"]}
 {:id :undiagnosed
  :title "a file gcc rejects (a dg-error test) whose error the port's preprocessor does not diagnose"
  :kind :deferred
  :why "a file gcc rejects (a dg-error test) whose error the port's preprocessor does not diagnose (UCNs not valid in C23, __VA_OPT__ misuse): C7's error diagnostics"
  :decided "CS260 (a): deferred, the port's preprocessor to diagnose it; C8"
  :match [#"^known undiagnosed:"]}
 {:id :va-opt
  :title "C23's __VA_OPT__ (6.10.5.1), which cc lacks"
  :kind :design
  :why "C23's __VA_OPT__ (6.10.5.1), which cc lacks: cc leaves it an identifier; the port substitutes it as gcc (the variable arguments' presence after expansion, placemarkers where its body is pasted)"
  :decided "CS260 (a); C8"
  :match [#"^known va-opt:"]}
 {:id :xid-identifier
  :title "an identifier holding a character from 0x80 that is not a letter (a combining mark)"
  :kind :design
  :why "an identifier holding a character from 0x80 that is not a letter (a combining mark): one identifier to gcc (C23's XID set), two tokens to cc and the port (CS63)"
  :decided "CS63 (a); C8"
  :match [#"^known xid-identifier:"]}
]

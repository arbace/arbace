;; The oracles' records and packs, one kind a line (doc/ORACLE-RECORDS-SURVEY.md §3, ORS1-ORS14 decided (a); bin/oracle-records
;; reads it with sed: one map a line, the keys below, strings without a double quote inside). Read with the Clojure reader too.
;;   :crop :kind   the kind's name (bin/oracle-records record|verify CROP [KIND])
;;   :class        A an outcome (a committed record), B a dump of a fixed input, C a front-end product, E an installed tree (packs)
;;   :host         the toolchain the record names and its verify needs (test/oracle-records/oracle.bash's oracle_host_id)
;;   :file         the committed record or the pack's pin (test/CROP/records/NAME.sha256, its manifest NAME.tsv beside it)
;;   :record       the command that rewrites it, by hand only (ORS5 (a)); {corpus} a corpus id, {only} --corpus C when given
;;   :verify       the command that runs the live oracle over its entries and compares (ORS6 (a): a moved toolchain reported,
;;                 not failed); {only} as for :record, {sample} --sample N when given; - none yet
[
{:crop "c" :kind "headers" :class "E" :host "gcc" :file "test/c/records/c-headers-gcc15.sha256" :record "bin/repr-c host pack" :verify "bin/repr-c host verify-pack"}
{:crop "c" :kind "host" :class "A" :host "gcc" :file "test/c/host/host.edn" :record "bin/repr-c host record" :verify "bin/repr-c host check"}
{:crop "c" :kind "musl" :class "E" :host "gcc" :file "test/c/records/c-musl-1.2.6-x86_64.sha256" :record "bin/ci musl pack" :verify "bin/ci musl verify-pack"}
{:crop "c" :kind "dg" :class "A" :host "gcc" :file "test/c/ref-dg-gcc15.edn" :record "bin/ci dg --record-ref {only}" :verify "bin/ci dg --verify-ref {only} {sample}"}
{:crop "c" :kind "c23-syntax" :class "A" :host "gcc" :file "test/c/c23/ref-syntax-gcc15.tsv" :record "bin/repr-c check --c23 --record-ref" :verify "bin/repr-c check --c23 --verify-ref"}
{:crop "c" :kind "roundtrip-orig" :class "A" :host "gcc" :file "test/repr/c/records/c-roundtrip-orig-{corpus}.sha256" :record "bin/repr-c roundtrip --record-orig {only}" :verify "bin/repr-c roundtrip --verify-orig {only} {sample}"}
{:crop "c" :kind "parse-gcc" :class "A" :host "gcc" :file "test/repr/c/parse-gcc.tsv" :record "bin/repr-c roundtrip --record-gcc {only}" :verify "-" :note "verified by roundtrip-orig's --verify-orig, file by file"}
{:crop "c" :kind "runs" :class "A" :host "gcc" :file "test/c/ref-gcc15.edn" :record "bin/ci record-ref --corpus {corpus} --only" :verify "-"}
{:crop "c" :kind "tokens" :class "A" :host "gcc" :file "test/repr/c/pp-gcc.sha256" :record "bin/repr-c check --tokens --record {only}" :verify "-"}
{:crop "scheme" :kind "chez-dumps" :class "B" :host "chez" :file "test/scheme/records/scheme-chez-dumps.sha256" :record "bin/repr-scheme check --record-dumps {only}" :verify "bin/repr-scheme check --verify-dumps {only} {sample}" :note "the essential subset's dumps committed in test/scheme/records/essential/"}
{:crop "scheme" :kind "chibi-tests" :class "A" :host "chibi" :file "test/scheme/records/chibi-tests.tsv" :record "bin/si chibi-tests --record-chibi" :verify "bin/si chibi-tests --verify-chibi"}
{:crop "scheme" :kind "boot" :class "D" :host "chez" :file "scheme/psyntax/psyntax.pp.ae" :record "-" :verify "bin/si boot --check" :note "Chez expanding psyntax on Arbace's own product: the oracle tier's, not a record"}
{:crop "haskell" :kind "test-dumps" :class "B" :host "ghc" :file "test/haskell/records/test.tsv" :record "bin/repr-haskell test --record" :verify "bin/repr-haskell test --verify-records" :note "committed (the essential subset): test/haskell/records/test/, the helper's dumps and trees and GHC's interfaces of bin/repr-haskell test's fixed inputs"}
{:crop "haskell" :kind "hsdump-corpus" :class "B" :host "ghc" :file "test/haskell/records/haskell-dumps-ghc-9.14.1.sha256" :record "bin/repr-haskell record-corpus" :verify "bin/repr-haskell verify-corpus {sample}" :note "four packs haskell-{dumps,dumps-full,trees,trees-full}-ghc-9.14.1 (REPR_HASKELL_ONLY_PACKAGES for some packages); --sample counts packages"}
{:crop "haskell" :kind "stg-libs" :class "C" :host "ghc" :file "test/haskell/records/haskell-stg-libs.sha256" :record "bin/hsi dumps --record" :verify "bin/hsi verify-libs {sample}" :note "the boot libraries' STG; --sample N verifies the N smallest packages"}
{:crop "haskell" :kind "stg-progs" :class "C" :host "ghc" :file "test/haskell/records/haskell-stg-progs.sha256" :record "bin/hsi check --live --dump-only --record-progs --corpus samples,synthetic,testsuite-core" :verify "bin/hsi check --verify-progs {sample}" :note "the run corpora's programs' -O0 STG; --sample counts programs"}
{:crop "haskell" :kind "roundtrip" :class "D" :host "ghc" :file "-" :record "-" :verify "bin/repr-haskell test --oracle" :note "GHC reading Arbace's print (trees, interfaces): the oracle tier's haskell-test-oracle and haskell-roundtrip-oracle, nothing to record"}
{:crop "rust" :kind "test-dumps" :class "B" :host "rustc" :file "test/rust/records/test.tsv" :record "bin/repr-rust test --record" :verify "bin/repr-rust test --verify-records" :note "committed (the essential subset): test/rust/records/test/, the helper's dumps (:abs as @WORK@ and @ROOT@) and trees and rustdoc's JSON of bin/repr-rust test's fixed inputs"}
{:crop "rust" :kind "corpus-dumps" :class "B" :host "rustc" :file "test/rust/records/rust-dumps-rustc-1.99.1.sha256" :record "bin/repr-rust record-corpus" :verify "bin/repr-rust verify-corpus {sample}" :note "three packs rust-{dumps,dumps-full,trees}-CORPUS (REPR_RUST_ONLY_CRATES for some crates; the dumps' :abs as @SRC@); --sample counts files a kind; only rustc-1.99.1 is recorded"}
{:crop "rust" :kind "std-ir" :class "C" :host "rustc" :file "test/rust/records/rust-std-ir.sha256" :record "bin/rsi std-record" :verify "bin/rsi std-verify" :note "std's IR (103-110 units, 51 MB) as std-build makes it, the digests of test/rust/runtime/ir.sha256; verify builds std afresh (cargo, about a minute)"}
{:crop "rust" :kind "ir" :class "C" :host "rustc" :file "test/rust/records/rust-ir-{corpus}.sha256" :record "bin/rsi check --record-ir --corpus {corpus}" :verify "bin/rsi check --verify-ir --corpus samples,synthetic {sample}" :note "rsi's per-program IR (the oracle's -O0 IR and the allocator shim's, rustc's failures too), samples and synthetic; ui is the night's"}
{:crop "cpp" :kind "ir" :class "C" :host "cxx" :file "test/cpp/records/cpp-ir-samples.sha256" :record "bin/cppi record-ir {only}" :verify "bin/cppi record-ir --verify {only} {sample}" :note "clang++'s -O0 IR of the run corpora's programs and the outcomes of the native steps on it (the original's link and run, g++'s build and run, x.o's digest); samples and runtime recorded here, libstdcxx and gxx-dg-run (cpp-ir-libstdcxx, cpp-ir-gxx-dg-run) are the night's; --sample counts programs"}
{:crop "cpp" :kind "runtime-ir" :class "C" :host "cxx" :file "test/cpp/records/cpp-runtime-ir.sha256" :record "bin/cppi record-ir --runtime" :verify "bin/cppi record-ir --runtime --verify {sample}" :note "the IR of the lowered runtime's units (test/cpp/runtime/units.edn), whose digests are test/cpp/runtime/ir.sha256's; --sample counts units"}
{:crop "cpp" :kind "cxxdump" :class "B" :host "cxx" :file "test/repr/cpp/records/cxxdump-{corpus}.sha256" :record "bin/repr-cpp record-dumps {corpus}" :verify "bin/repr-cpp verify-dumps {corpus} {sample}" :note "the originals' dumps of a round trip list (clang's AST through tools/cxxdump, its -norm form, the status and errors, the dependencies' digests) as the cache's entries, read by cxxdump -records; CORPUS a roundtrip-corpus key (samples recorded here); --sample counts entries"}
{:crop "cpp" :kind "host" :class "A" :host "cxx" :file "test/cpp/host/host.edn" :record "bin/repr-cpp host record" :verify "bin/repr-cpp host check" :note "the compilers' predefined macros, search lists, __has_* answers and sizes, the libstdc++ headers' digests (the headers alone are `host check --headers`, in the gate's pins)"}
{:crop "cpp" :kind "runs" :class "A" :host "cxx" :file "test/cpp/ref-gxx15.edn" :record "bin/cppi record-ref --corpus {corpus} --only" :verify "-" :note "g++ 15.2's -O0 runs of the run corpora (CX8)"}
{:crop "cpp" :kind "dg" :class "A" :host "cxx" :file "test/cpp/ref-dg-gxx15.edn" :record "bin/repr-cpp dg --record-ref" :verify "-" :note "g++ 15.2's errors of g++.dg's error tests (CX9)"}
{:crop "cpp" :kind "tokens" :class "A" :host "cxx" :file "test/repr/cpp/pp-gxx.sha256" :record "bin/repr-cpp pp-check --record" :verify "-" :note "g++ -E's and clang's raw tokens' digests (lex-clang.sha256 beside)"}
{:crop "llvm" :kind "roundtrip-orig" :class "A" :host "llvm" :file "test/llvm/records/roundtrip-orig.tsv" :record "bin/repr-llvm record-orig all" :verify "bin/repr-llvm verify-orig all {sample}" :note "clang -c's object and llvm-as's bitcode digests of the originals (hw, probes, C++'s runtime IR: 680 modules); --sample counts modules"}
{:crop "llvm" :kind "opt-verify" :class "B" :host "llvm" :file "test/llvm/records/llvm-opt-verify.sha256" :record "bin/repr-llvm record-opt all" :verify "bin/repr-llvm verify-opt all {sample}" :note "opt -passes=verify's status and whole stderr on the same modules (paths as @ROOT@, addresses as <0xADDR>); the mutants' and held-out sets are the night's"}
{:crop "ocaml" :kind "lambda-stdlib" :class "C" :host "ocaml" :file "test/ocaml/records/ocaml-lambda-stdlib.sha256" :record "bin/oi stdlib --record" :verify "bin/oi stdlib --verify" :note "the stdlib's 71 units' simplified Lambda (ocdump --mode lambda after ocamlc -c in dependency order), Testing.ae, order.txt"}
{:crop "ocaml" :kind "lambda-progs" :class "C" :host "ocaml" :file "test/ocaml/records/ocaml-lambda-progs.sha256" :record "bin/oi record-lambda {only}" :verify "bin/oi verify-lambda {sample}" :note "the run corpus's 309 programs' Lambda, ID.ae, a key each (source, flags, helper); --only-list FILE or --only RE records some and keeps the rest"}
{:crop "ocaml" :kind "lambda-suite" :class "C" :host "ocaml" :file "test/ocaml/records/ocaml-lambda-suite.sha256" :record "bin/oi suite record-lambda {only}" :verify "-" :note "the suite corpus's programs' units compiled and dumped: ID/units.list, ID/U.ae or ID/error; verified by running the same record on a scratch store"}
{:crop "ocaml" :kind "repl" :class "C" :host "ocaml" :file "test/ocaml/records/repl.tsv" :record "bin/oi repl-check --record" :verify "bin/oi repl-check --verify-records" :note "committed: the REPL session's phrases' answers (KEY.status, .ae, .typed), test/ocaml/records/repl/"}
{:crop "ocaml" :kind "dumps" :class "B" :host "ocaml" :file "test/ocaml/records/ocaml-dumps-{corpus}.sha256" :record "bin/repr-ocaml record-dumps {corpus}" :verify "bin/repr-ocaml verify-dumps {sample} {corpus}" :note "parse/REL.ae and tokens/REL.ae of every file of samples, stdlib and the spec's examples (parse/ and check/); the other corpora are the night's"}
{:crop "ocaml" :kind "roundtrip" :class "D" :host "ocaml" :file "-" :record "-" :verify "bin/repr-ocaml roundtrip --oracle --cmi samples stdlib" :note "ocdump's parse of Arbace's print and ocamlc -c of the original and the print (.cmi bytes): the oracle tier's ocaml-roundtrip-oracle, nothing to record"}
]

(ns gate.audit
  "bin/gate --audit's comparison (doc/GATE-SURVEY.md, GT4, GTS8 (a), \"As built: GT4, GT6\"): the paths
  a step's command touched under strace (OP<TAB>PATH lines, test/gate/audit.awk's) against the inputs
  the step declares in test/gate/steps.edn.

  -main ROOT PLANDIR STEP PATHS [LOADED]
      PLANDIR holds files.sha256 (the checkout's files, bin/gate's) and hosts.edn; prints the report
      and exits 1 when the step read a file of the checkout it does not declare (an open or an execve
      of a file the step's key does not cover); a directory listed with no declared file below it is
      advisory; since queue 023 (report 022, finding 6) also when it wrote a checked-in file (not in its
  :audit-known), or read a tree outside the checkout that the keys know only by a pin or host it does not
  declare ($GOROOT/test, TamaGo's go, jdk26u, a JDK's java or javac run: outside-problems). LOADED (GT5, GTS4 (c)): the namespaces the step's Arbace processes loaded, one
      scriptbase a line (ARBACE_LOADED_LOG, RT.load): the audit fails on one of its :never-loads

  Since GT5 a step's :uses cover the inputs of the steps they name (their outputs, in its key, are
  a function of them), and a program host (:prog, :javac-prog) covers only the rest of what the
  executables are built from (the build's scripts, bin/lib, overlay/go, x509roots, the pins): the
  sources are in the program's units.

  A file is declared when the step's :inputs select it (groups expanded, the last rule that matches
  wins), it is one of the step's :pins, or it is the gate's own logic (every key holds that). Not
  counted: what the step wrote or derived (.tmp/, target/), .git/ (the commit is not in a key; the
  version stamp is its business), files that are not in the checkout's table. A file only stat'ed is
  listed apart (its existence, not its content, was asked). Reads outside the checkout are
  summarized by directory: the pinned roots (TamaGo's go, the JDK build tree) belong to :pins.

  Since GT7's fix round (doc/GATE-SURVEY.md, \"As built: GT7's fix round\") the reducer marks a read by
  sha256sum H (hashed only). A file hashed only, not otherwise read, is covered (advisory, listed)
  where the hash is an identity check: :prog's full key (gate_key's files, the steps' and their :uses
  producers' hosts: their tools compute the executables' runtime and compiled namespaces' keys, GT5's
  design keys the step by the program's units instead), or a build's inner cache key (javac-tool's
  reader_key hashes jdk/javac/ to keep the compiled reader by key). Until GTS87 (a) :javac-prog's too
  (arbace_javac_key's files: repr_java_host hashed the tool's sources to check that the tool is the
  checkout's); since, bin/gate hands the steps the key (GATE_JAVAC_KEY) and nothing hashes them. Read by
  any other process it is a read."
  (:require [arbace.string :as str]
            [arbace.java.io :as io]
            [gate.plan :as plan])
  (:import (java.io File PushbackReader)))

(defn- read-file [^String f]
  (with-open [r (PushbackReader. (io/reader f))]
    (read r)))

(def ^:private expand @#'gate.plan/expand)
(def ^:private matching @#'gate.plan/matching)
(def ^:private files-table @#'gate.plan/files-table)

;; what a host's identity covers: the files its key (bin/arbace-go's gate_key, bin/lib/javac-key.bash's
;; arbace_javac_key, the pins) is a hash of. A step on that host reads them (the build's sources, the
;; scripts that build) without declaring them again.
(def ^:private seed-pins ["seed/arbace-seed-go.tar.xz.sha256" "seed/goroot.sha256"])
(def ^:private build-scripts ["bin/arbace-go" "bin/j2g" "bin/repr-go" "bin/build-go" "bin/jrt" "bin/seed" "bin/goi"])
(def ^:private host-files
  {:gate (concat ["arbace/" "!arbace/repr/java.ae" "!arbace/repr/java/" "!arbace/repr/haskell.ae" "!arbace/repr/haskell/"
                  "!arbace/repr/rust.ae" "!arbace/repr/rust/"
                  "!arbace/repr/ocaml.ae" "!arbace/repr/ocaml/"
                  "!arbace/repr/scheme.ae" "!arbace/repr/scheme/" "!arbace/scheme/"
                  "!arbace/repr/python.ae" "!arbace/repr/python/"
                  "!arbace/python.ae" "!arbace/python/"
                  "!arbace/repr/cpp.ae" "!arbace/repr/cpp/" "!arbace/repr/llvm.ae" "!arbace/repr/llvm/" "!arbace/cpp/" "go/" "overlay/" "!overlay/jdk/javac/" "jdk/" "!jdk/javac/"
                  ;; queue 038 (054): as gate_key (arbace_embedded_sources and its find): c23's arbace/c and repr/c.ae,
                  ;; JN10's java.base pack jdk/platform/
                  "!jdk/platform/" "!jdk/provenance.edn" "x509roots/" "bin/lib/" "!bin/lib/repr-java/" "!bin/lib/repr-haskell/"
                  "!bin/lib/repr-rust/" "!bin/lib/repr-c/" "test/java-fixtures/" "!test/java-fixtures/provenance.edn"
                  "tamago/goroot/" "tools/godump/"
                  ;; queue 111: as gate_key, the crops' files no build reads
                  "!bin/lib/ci/" "!bin/lib/oi/" "!bin/lib/repr-cpp/" "!jdk/ocaml/"
                  ;; C9: ci, cinterp and crt (go/arbace/{ci,cinterp,crt}) are read since j2g copies them into the program
                  "!go/arbace/oi.ae" "!go/arbace/oi/" "!go/arbace/scm.ae" "!go/arbace/scm/"
                  "!go/arbace/py.ae" "!go/arbace/py/"
                  ;; haskell-full: the musl libm port hsi (and pyi) import, out of every executable
                  "!go/arbace/libm.ae" "!go/arbace/libm/"]
                 seed-pins build-scripts)
   :javac (concat ["arbace/" "go/" "overlay/" "jdk/" "!jdk/provenance.edn" "!jdk/javac/provenance.edn" "x509roots/"
                   "bin/lib/" "!bin/lib/repr-java/" "!bin/lib/repr-go/" "!bin/lib/repr-clojure/" "!bin/lib/repr-haskell/"
                   "!bin/lib/repr-rust/" "!bin/lib/frozen.bash" "tamago/goroot/" "tools/godump/"
                   ;; GTS72 (a): the tool build's own command
                   "bin/javac-vendor"
                   ;; the re-seed after the backlog (the user, 2026-11-03): as arbace_javac_key, the crops' Go forms
                   "!go/arbace/oi.ae" "!go/arbace/oi/" "!go/arbace/scm.ae" "!go/arbace/scm/"
                   "!go/arbace/scminterp.ae" "!go/arbace/scminterp/" "!go/arbace/py.ae" "!go/arbace/py/"
                   "!go/arbace/libm.ae" "!go/arbace/libm/"]
                  seed-pins build-scripts)
   ;; GT5: the program hosts' rest (bin/arbace-go's gate_rest_key, bin/lib/javac-key.bash's
   ;; arbace_javac_rest_key)
   :prog (concat ["overlay/" "!overlay/jdk/" "x509roots/" "bin/lib/" "!bin/lib/repr-java/" "!bin/lib/repr-haskell/"
                  "!bin/lib/repr-rust/" "!bin/lib/repr-c/" "!bin/lib/ci/" "!bin/lib/oi/" "!bin/lib/repr-cpp/"] seed-pins build-scripts)
   :javac-prog (concat ["overlay/" "!overlay/jdk/" "x509roots/" "bin/lib/" "!bin/lib/repr-java/" "!bin/lib/repr-go/"
                        "!bin/lib/repr-clojure/" "!bin/lib/repr-haskell/" "!bin/lib/repr-rust/" "!bin/lib/frozen.bash"
                        "bin/javac-vendor"]
                       seed-pins build-scripts)
   ;; GTS53 (a): stage 0 is built from the seed's tar (its SHA-256 pin is in the identity, bin/seed --check holds it to it)
   :stage0 (concat seed-pins ["seed/arbace-seed-go.tar.xz" "bin/seed" "bin/lib/seed-go.bash"])
   :frozen ["test/oracle/frozen-jar.sha256"]
   :go [] :jdk [] :gcc []})

;; GT7's fix round: the full key whose files a host's identity check hashes. GTS87 (a): only :prog's (the
;; executables' keys its tools compute: bin/lib/version.bash's arbace_runtime_key and arbace_aot_key, through
;; bin/lib/program.bash's program_base and bin/java-check; gate_key), and :gate's, whose files are its own host
;; files anyway; :javac-prog's served only arbace_javac_fresh (repr_java_host, bin/javac-vendor check --from),
;; which since GTS71 (c) compares the tool's key with the one bin/gate hands the steps (GATE_JAVAC_KEY) and
;; hashes nothing: a :javac-prog step's read of the tool's sources by sha256sum is a read like any other
(def ^:private identity-host {:prog :gate :gate :gate})

(defn- parent [^String p] (let [i (.lastIndexOf p "/")] (if (pos? i) (subs p 0 i) "")))

(defn- grouped
  "undeclared paths as lines: a directory with more than 6 of them is one line with its count and
  the first three"
  [paths]
  (let [byd (group-by parent paths)]
    (mapcat (fn [[d ps]]
              (if (> (count ps) 6)
                [(str "   " d "/ (" (count ps) " files: " (str/join ", " (map #(subs % (inc (count d))) (take 3 ps))) ", ...)")]
                (map #(str "   " %) ps)))
            (sort-by key byd))))

(def ^:private system-roots
  ["/usr/" "/lib/" "/lib64/" "/bin/" "/sbin/" "/etc/" "/proc/" "/sys/" "/dev/" "/run/" "/var/" "/opt/"
   "/root/.cache/go-build/" "/root/.config/" "/root/go/pkg/"])

;; queue 023, report 022 finding 6: what the audit fails on beyond the undeclared reads of the checkout
(defn failing-writes
  "the checked-in files the step wrote (opened for writing) that its :audit-known does not list: a step that
  rewrites a tracked file changes its neighbours' inputs while they run, and its own key's"
  [wrote known]
  (sort (remove #(contains? known %) wrote)))

(defn outside-problems
  "the reads outside the checkout whose tree is known to the keys only by a pin or a host the step does not
  declare: [[NEED N EXAMPLE] ...]. OPS {path #{op}}; GOROOT TamaGo's (its test/ needs
  seed/goroot-test.sha256, the rest :go or seed/goroot.sha256), JDK26U jdk26u (jdk/javac/platform.sha256)
  but JDK-HOME, the JDK the steps run (bin/lib/java26.bash's, inside jdk26u's build tree since 2026-11-02), whose files
  the host :jdk keys by its release file; a JDK's java or javac executed needs :jdk, the host's gcc or its cc1 :gcc. DECLARED? a checkout file the step (or a :uses producer, a
  host) declares; HOSTS the step's and its producers' hosts"
  [ops ^String goroot ^String jdk26u ^String jdk-home declared? hosts]
  (let [under? (fn [^String p ^String r] (and (seq r) (or (= p r) (str/starts-with? p (str r "/")))))
        hs (set hosts)
        needs (for [[^String p o] ops
                    ;; an exec or open that found nothing (a PATH search's misses, e.g. /root/tamago-go/bin/bash) read no tree
                    :when (.exists (java.io.File. p))
                    :let [need (cond
                                 (and (o "X") (re-find #"/bin/javac?$" p) (not (under? p goroot)))
                                 (when-not (hs :jdk) ":jdk (a JDK's java or javac run)")
                                 ;; the user, 2026-11-02: the host's gcc (C's reference) is the host :gcc
                                 (and (o "X") (re-find #"/(gcc[-0-9.]*|cc1)$" p) (not (under? p goroot)))
                                 (when-not (hs :gcc) ":gcc (the host's gcc or its cc1 run)")
                                 (not (or (o "R") (o "X") (o "D"))) nil
                                 (under? p (str goroot "/test"))
                                 (when-not (declared? "seed/goroot-test.sha256") "the pin seed/goroot-test.sha256 ($GOROOT/test)")
                                 (under? p goroot)
                                 (when-not (or (hs :go) (declared? "seed/goroot.sha256")) "the host :go or the pin seed/goroot.sha256 (TamaGo's go)")
                                 ;; the directories down to the JDK (/root, /root/jdk26u, its build/...): passed through, no tree
                                 ;; read (every step opens /root)
                                 (str/starts-with? jdk-home (str p "/")) nil
                                 (under? p jdk-home)
                                 (when-not (hs :jdk) ":jdk (the JDK's files)")
                                 (under? p jdk26u)
                                 (when-not (declared? "jdk/javac/platform.sha256") "the pin jdk/javac/platform.sha256 (jdk26u)"))]
                    :when need]
                [need p])]
    (vec (for [[need ps] (sort-by key (group-by first needs))]
           [need (count ps) (first (sort (map second ps)))]))))

(defn -main [root plandir nm paths-file & [loaded-file]]
  (let [{:keys [groups steps]} (read-file (or (System/getenv "GATE_STEPS") (str root "/test/gate/steps.edn")))
        steps (plan/expand-parts steps)
        by-name (into {} (map (juxt (comp str :name) identity) steps))
        ;; a rotated check (GT8.4: NAME.PART.sub, NAME.PART.sK) is its part's declaration over its list
        step (or (by-name nm) (by-name (str/replace nm #"\.(sub|s[0-9]+)$" "")))
        _ (when-not step (println (str "gate audit: no step " nm)) (System/exit 2))
        files (files-table (str plandir "/files.sha256"))
        cache (atom {})
        never (:never-loads step)
        rules (into (vec (expand groups (:inputs step))) (plan/never-rules never))
        ;; the producers of its :uses: their inputs and hosts (GT5)
        prods (keep #(by-name (first (str/split (str %) #"/" 2))) (:uses step))
        own (into (matching cache (keys files) rules)
                  (matching cache (keys files) (expand {} (vec (mapcat host-files (:hosts step))))))
        selected (reduce into own
                         (for [p prods]
                           (into (matching cache (keys files) (expand groups (:inputs p)))
                                 (matching cache (keys files) (expand {} (vec (mapcat host-files (:hosts p))))))))
        loaded (when (and loaded-file (.isFile (File. (str loaded-file))))
                 (into (sorted-set) (remove str/blank? (str/split-lines (slurp (str loaded-file))))))
        ;; a namespace of :never-loads loaded (its scriptbase that prefix's path, or below it)
        unloadable (sort (for [l loaded
                               :when (some #(let [p (plan/ns-path (str %))] (or (= l p) (str/starts-with? l (str p "/")))) never)]
                           l))
        ;; the gate's logic, and the heavy lock's command (GATE_HEAVY_CMD, the tools' ARBACE_HEAVY_CMD: it
        ;; takes the lock and runs the command, it decides nothing; GT7's clean audit found it in every
        ;; :inner step)
        ;; GT7's fix round: what a hashed-only read (H) may be covered by: the identity checks of the
        ;; step's hosts and its producers' (their full keys), and every file for a build (its inner caches)
        id-hosts (distinct (keep identity-host (concat (:hosts step) (mapcat :hosts prods))))
        hashable (into #{} (matching cache (keys files) (expand {} (vec (mapcat host-files id-hosts)))))
        build? (= :build (:kind step))
        hashed (atom [])
        implicit (set (concat ["bin/lib/gate-run.bash" "test/gate/plan.ae" "bin/heavy-lock"] (:pins step)))
        ;; GT7's fix round: a step's :audit-known, reads its key is known to miss (a proposal decides them):
        ;; reported, not failing
        known-gaps (set (map str (:audit-known step)))
        declared? (fn [f] (or (contains? selected f) (contains? implicit f)))
        dirs (into #{} (mapcat (fn [f] (take-while seq (iterate parent (parent f)))) (keys files)))
        sel-dirs (into #{} (mapcat (fn [f] (take-while seq (iterate parent (parent f)))) (concat selected implicit)))
        lines (remove str/blank? (str/split-lines (slurp paths-file)))
        ops (reduce (fn [m l] (let [[op p] (str/split l #"\t" 2)] (update m p (fnil conj #{}) op))) {} lines)
        prefix (str root "/")
        under (fn [p] (when (str/starts-with? p prefix) (subs p (count prefix))))
        in-root (keep (fn [[p o]] (when-let [r (under p)] [r o])) ops)
        read-files (atom #{})
        undecl-read (atom []) undecl-stat (atom []) undecl-dir (atom [])
        wrote (atom []) scratch (atom 0) git (atom 0) other (atom 0)]
    (doseq [[r o] in-root]
      (cond
        (or (str/starts-with? r ".tmp/") (str/starts-with? r "target/") (= r ".tmp") (= r "target")) (swap! scratch inc)
        (or (str/starts-with? r ".git/") (= r ".git")) (swap! git inc)
        (contains? files r)
        (cond
          (or (o "R") (o "X")) (do (swap! read-files conj r)
                                   (when-not (declared? r) (swap! undecl-read conj r)))
          (o "H") (do (swap! read-files conj r)
                      (when-not (declared? r)
                        (if (or build? (contains? hashable r)) (swap! hashed conj r) (swap! undecl-read conj r))))
          (o "W") (swap! wrote conj r)
          (o "S") (do (swap! read-files conj r)
                      (when-not (declared? r) (swap! undecl-stat conj r))))
        (contains? dirs r)
        (when (and (o "D") (not (contains? sel-dirs r))) (swap! undecl-dir conj r))
        :else (swap! other inc)))
    ;; outside the checkout
    (let [outside (remove (fn [[p _]] (or (str/starts-with? p prefix) (= p (subs prefix 0 (dec (count prefix)))))) ops)
          outside (remove (fn [[p _]] (some #(str/starts-with? p %) system-roots)) outside)
          outside (filter (fn [[_ o]] (or (o "R") (o "X") (o "D"))) outside)
          roots (frequencies (map (fn [[p _]] (let [w (remove str/blank? (str/split p #"/"))]
                                               (str "/" (str/join "/" (take 3 w)))))
                                  outside))]
      (println (str "== audit " nm ": " (count selected) " declared files (+ " (count (:pins step)) " pins), "
                    (count in-root) " paths of the checkout touched: " (count @read-files) " tracked files read, "
                    @scratch " in .tmp/ or target/, " @git " in .git/"))
      (let [k (sort (filter known-gaps @undecl-read))]
        (when (seq k)
          (println (str "KNOWN GAPS (the table's :audit-known: reads the step's key misses, not failing it): " (count k)))
          (doseq [l k] (println (str "   " l)))))
      (swap! undecl-read #(vec (remove known-gaps %)))
      (let [u (sort @undecl-read)]
        (println (str "UNDECLARED reads (opened or executed): " (count u)))
        (doseq [l (grouped u)] (println l))
        ;; the same by the first two components of the path: what rule would cover them
        (when (seq u)
          (println (str "   by directory: "
                        (str/join ", " (map (fn [[d n]] (str d "/ " n))
                                            (sort-by (comp - val) (frequencies (map #(str/join "/" (take 2 (str/split % #"/"))) u)))))))))
      ;; a directory listing (a find, a tree walk) depends on the set of files: advisory, since a new file
      ;; in a listed directory changes no key; the topmost directories are listed
      (let [all (set @undecl-dir)
            top (sort (remove #(contains? all (parent %)) all))]
        (when (seq top)
          (println (str "directory listings, no declared file below (advisory): " (count all) " directories, topmost: "
                        (str/join ", " (take 12 top)) (when (> (count top) 12) ", ...")))))
      (when (seq @hashed)
        (println (str "hashed only, covered (" (if build? "a build's inner cache keys" (str "the identity checks of " (str/join " " (map str id-hosts))))
                      "; advisory): " (count @hashed) " files, by directory: "
                      (str/join ", " (map (fn [[d n]] (str d "/ " n))
                                          (take 8 (sort-by (comp - val) (frequencies (map #(str/join "/" (take 2 (str/split % #"/"))) @hashed)))))))))
      (when (seq @undecl-stat)
        (println (str "stat only, undeclared (their existence, not their content): " (count @undecl-stat) " files")))
      (when (seq @wrote)
        (println (str "written checked-in files: " (count @wrote)
                      (when (seq (filter known-gaps @wrote)) " (some in :audit-known, not failing)")))
        (doseq [l (grouped (sort @wrote))] (println l)))
      (when (seq roots)
        (println "outside the checkout (read):")
        (doseq [[r n] (sort-by key roots)] (println (str "   " r " (" n " paths)"))))
      ;; declared rules whose files the step never read: candidates to narrow
      (let [idle (for [[inc? pat] rules
                       :when inc?
                       :let [m (matching cache (keys files) [[true pat]])
                             n (count (filter @read-files m))]
                       :when (and (pos? (count m)) (zero? n))]
                   (str "   " pat " (" (count m) " files)"))]
        (when (seq idle)
          (println (str "declared, never read (candidates to narrow): " (count idle)))
          (doseq [l idle] (println l))))
      ;; GT5: files read that only its :uses' producers declare: sound when the step reads them to make
      ;; the producers' output again (a cache keyed by them, as Java's levels read through the read's
      ;; cache), not when it reads them for their own sake; advisory, to be looked at
      (let [via (sort (remove #(or (contains? own %) (contains? implicit %)) (filter selected @read-files)))]
        (when (seq via)
          (println (str "read through its :uses' producers (covered by their keys; advisory): " (count via) " files"))
          (doseq [l (take 12 (grouped via))] (println l))))
      ;; GT5: the namespaces loaded, against :never-loads
      (when loaded
        (println (str "namespaces loaded: " (count loaded)
                      (when (seq never) (str "; never-loads " (str/join " " (map str never)) ": "
                                             (if (seq unloadable) (str (count unloadable) " LOADED: " (str/join ", " (take 12 unloadable)))
                                                 "none loaded"))))))
      (when (and (seq never) (not loaded))
        (println "namespaces loaded: no record (ARBACE_LOADED_LOG: an executable before GT5 does not write it)"))
      ;; queue 023, report 022 finding 6: a tracked file written, an outside tree read without its pin or host
      (let [wbad (failing-writes @wrote known-gaps)
            obad (outside-problems ops (or (System/getenv "ARBACE_GOROOT") "/root/tamago-go")
                                   (or (System/getenv "JDK") "/root/jdk26u")
                                   (or (System/getenv "ARBACE_FROZEN_JAVA_HOME")
                                       (str (or (System/getenv "JDK") "/root/jdk26u") "/build/linux-x86_64-server-release/images/jdk"))
                                   declared? (concat (:hosts step) (mapcat :hosts prods)))]
        (when (seq obad)
          (println (str "UNDECLARED outside the checkout (a tree the keys know by a pin or host the step lacks): " (count obad)))
          (doseq [[need n ex] obad] (println (str "   " need ": " n " paths, e.g. " ex))))
        (let [bad (+ (count @undecl-read) (count unloadable) (count wbad) (count obad))]
          (println (if (zero? bad) (str "audit " nm ": ok")
                       (str "audit " nm ": " (count @undecl-read) " undeclared"
                            (when (seq wbad) (str ", " (count wbad) " checked-in files written"))
                            (when (seq obad) (str ", " (count obad) " outside trees undeclared"))
                            (when (seq unloadable) (str ", " (count unloadable) " never-loads loaded")))))
          (System/exit (if (zero? bad) 0 1)))))))

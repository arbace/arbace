;; WA1-WA3 (doc/wasm/WASM-SURVEY.md §13.4, "As built: WA1", "As built: WA2", "As built: WA3"; the user 2026-11-13: WAS1-WAS26 as recommended): the
;; WebAssembly crop's steps, on stage 0 and TamaGo's go (the Go-built corpus: not a host toolchain), no Wasm tool: every judge the
;; input's own (a module's bytes printed back from its forms, the testsuite's assertions). The pins are test/wasm/corpora.edn's
;; (fetched into the main checkout's .tmp/wasm/ by bin/repr-wasm corpus fetch). NOT SPLICED YET: written with WA2 for the merge that
;; brings the row (WA10's measurement first, GT9's rule: an essential step at most 3 GiB). Measured 2026-11-13 by hand on stage 0, one
;; run at a time: the whole round trip 1,322 s and 1.55 GB (twenty modules, about 65 s each: the essential pair about 2.5 minutes);
;; bin/repr-wasm wast over the 258 root scripts 362 s and 0.58 GB; the essential step's command 62 s and 0.49 GB. WA3 (with the
;; validator, the proposals/, legacy/ and custom/ scripts, "As built: WA3"): the round trip 1,115 s and 1.56 GB; bin/repr-wasm wast
;; over the 293 scripts 441 s and 0.60 GB; the essential step's command (40 scripts) 101 s and 0.53 GB.
;;@ groups
  :wasm ["bin/repr-wasm" "arbace/repr/wasm.ae" "arbace/repr/wasm/" "arbace/wasm/" "test/wasm/"]
  :wai ["bin/wai" "bin/lib/wai/" "go/arbace/wai.ae" "go/arbace/wai/" "arbace/repr/wasm.ae" "arbace/repr/wasm/" "arbace/wasm/" "test/wasm/"]
  ;; WA5's Go run corpus: also goi's record (its run programs' ids), goi's definitions read from bin/goi, the gate's limits
  ;; WA11, WA12 (doc/wasm/WAI.md §10, doc/wasm/WEB.md): the js/wasm corpus on the headless world: also the shim and the demo's forms
  :wai-js ["bin/wai" "bin/lib/wai/" "go/arbace/wai.ae" "go/arbace/wai/" "test/wasm/" "wasm/web/" "wasm/demo/"]
  :wai-go ["bin/wai" "bin/lib/wai/" "bin/lib/limit.bash" "bin/goi" "go/arbace/wai.ae" "go/arbace/wai/" "test/wasm/" "test/goi/check-linux-amd64.edn"]
;;@ steps
  ;; ---- essential: the chain wasm-essential
  {:name wasm-read-essential :mem-gib 2 :phase :essential :chain wasm-essential
   :cmd "bin/repr-wasm ops check && bin/repr-wasm wast --only test/wasm/essential-wast.txt"
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["test/wasm/corpora.edn"]
   :inputs [:lib-tools :tools :wasm]
   :summary ["^repr-wasm|^control|^FAIL" 6]}
  ;; WA4 (doc/wasm/WAI.md, "As built: WA4"): wai's light driver built by TamaGo's go (the host :go), the essential scripts planned on
  ;; stage 0 and run, with the negative controls; measured by hand 2026-11-13 (see the survey's section)
  {:name wai-essential :mem-gib 1 :phase :essential :chain wasm-essential :needs [wasm-read-essential]
   :cmd "bin/wai ops check && bin/wai essential"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/wasm/corpora.edn"]
   :inputs [:lib-tools :tools :wai]
   :summary ["^wai|^control|^check|^FAIL" 8]}
  ;; WA5 (doc/wasm/WAI.md §8, "As built: WA5"): the Go run corpus's essential list (the own programs and a sample of goi's essential
  ;; run programs) built for wasip1 by TamaGo's go (the host :go; builds cached by key in the main checkout's .tmp/wai-go) and run on
  ;; wai, against goi's gc references (made by TamaGo's go for linux when missing), with the negative controls
  {:name wai-go-essential :mem-gib 1.5 :phase :essential :chain wasm-essential :needs [wai-essential]
   :cmd "bin/wai go --essential"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/wasm/corpora.edn"]
   :inputs [:lib-tools :tools :wai-go]
   :summary ["^wai go|^control|^check|^FAIL" 8]}
  ;; WA7 (doc/wasm/WAI.md §9, "As built: WA7 (first part)"): w2g's bodies regenerated from exec.go and compared, then the essential
  ;; scripts' modules translated by w2g and run as AOT programs built by TamaGo's go (the host :go; kept by key in .tmp/wai/aot-bin),
  ;; with the AOT controls (as-interpreted among them)
  {:name wasm-aot-essential :mem-gib 1.5 :phase :essential :chain wasm-essential :needs [wai-essential]
   :cmd "bin/wai w2g check && bin/wai aot-essential"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/wasm/corpora.edn"]
   :inputs [:lib-tools :tools :wai]
   :summary ["^wai|^control|^check|^FAIL" 8]}
  ;; WA11, WA12 (doc/wasm/WAI.md §10, doc/wasm/WEB.md; "As built: WA11, WA12 (begun)"): Go's js/wasm programs built by TamaGo's go
  ;; (syscall/js's tests, the own programs, the demo scene) and run on gojs's headless world, each
  ;; by its own statement, the scene's frames against expected/frames.edn, the shim's import list and operation table checked, with
  ;; the negative controls; builds cached by key in the main checkout's .tmp/wai-go/js (measured: see the survey's section)
  {:name wai-js-essential :mem-gib 1.5 :phase :essential :chain wasm-essential :needs [wai-essential]
   :cmd "bin/wai js --essential"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/wasm/corpora.edn"]
   :inputs [:lib-tools :tools :wai-js]
   :summary ["^wai js|^control|^check|^FAIL|^frames" 8]}
  ;; ---- --full: the chain wasm-full
  {:name wasm-roundtrip :mem-gib 2 :phase :full :chain wasm-full
   :cmd "bin/repr-wasm roundtrip"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/wasm/corpora.edn"]
   :inputs [:lib-tools :tools :wasm]
   :summary ["^repr-wasm|^control|^check|^FAIL" 6]}
  {:name wasm-wast :mem-gib 2 :phase :full :chain wasm-full :needs [wasm-roundtrip]
   :cmd "bin/repr-wasm wast"
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["test/wasm/corpora.edn"]
   :inputs [:lib-tools :tools :wasm]
   :summary ["^repr-wasm|^control|^FAIL" 6]}
  {:name wai-check :mem-gib 1 :phase :full :chain wasm-full :needs [wasm-wast]
   :cmd "bin/wai check"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/wasm/corpora.edn"]
   :inputs [:lib-tools :tools :wai]
   :summary ["^wai|^control|^check|^FAIL" 8]}
  {:name wai-go :mem-gib 1.5 :phase :full :chain wasm-full :needs [wai-check]
   :cmd "bin/wai go"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/wasm/corpora.edn"]
   :inputs [:lib-tools :tools :wai-go]
   :summary ["^wai go|^control|^check|^FAIL" 8]}
  ;; WA7: the testsuite at AOT (every script, the AOT programs a batch of 24 scripts each) and the Go programs of test/wasm/go-aot.txt
  ;; as AOT programs (a Go-built module about 50 MB of Go in packages of 1.5 MB, built one package at a time)
  {:name wai-aot :mem-gib 1.5 :phase :full :chain wasm-full :needs [wai-go]
   :cmd "bin/wai check --aot"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/wasm/corpora.edn"]
   :inputs [:lib-tools :tools :wai]
   :summary ["^wai|^control|^check|^FAIL" 8]}
  {:name wai-go-aot :mem-gib 1.5 :phase :full :chain wasm-full :needs [wai-aot]
   :cmd "bin/wai go --aot"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/wasm/corpora.edn"]
   :inputs [:lib-tools :tools :wai-go]
   :summary ["^wai go|^control|^check|^FAIL" 8]}
  ;; WAS40 (a): the rest of the Go run corpus at AOT, judged against eval's record program for program (bin/wai go --aot --vs-eval),
  ;; as GT8.4's rotation: the subset test/wasm/subsets.edn's :go (go-aot.txt's programs: the controls' subjects among them) and a
  ;; seventh of the rest a night (about 167 programs, about 3 minutes each when wai changed: WAS43's cost, the AOT programs kept by
  ;; key so a night with wai unchanged skips at its key); --full runs it whole (about 57 hours: the clean run takes the subset)
  {:name wai-go-aot-rest :mem-gib 1.5 :phase :full :chain wasm-full :needs [wai-go-aot]
   :cmd "bin/wai go --aot --vs-eval"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/wasm/corpora.edn"]
   :inputs [:lib-tools :tools :wai-go]
   :parts [{:part go}]
   :summary ["^wai go|^control|^check|^FAIL" 8]
   :rotate {:only "--list {list}" :universe "test/wasm/go-results.edn" :id-re "^\\[\"go/([^\"]+)\""
            :subset "test/wasm/subsets.edn" :failed-re "^FAIL: was :pass, now [^ ]+: go/([^ ]+)$"}}
  {:name wai-js :mem-gib 1.5 :phase :full :chain wasm-full :needs [wai-go-aot-rest]
   :cmd "bin/wai js"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/wasm/corpora.edn"]
   :inputs [:lib-tools :tools :wai-js]
   :summary ["^wai js|^control|^check|^FAIL|^frames" 8]}
;;@ crops
         :wasm [wasm-read-essential wai-essential wai-go-essential wasm-aot-essential wai-js-essential wasm-roundtrip wasm-wast wai-check wai-go wai-aot wai-go-aot wai-go-aot-rest wai-js]
;;@ controls
  wasm-read-essential "test/wasm/controls-wast.txt"
  wai-essential "test/wasm/controls-eval.txt"
  wai-go-essential "test/wasm/controls-go.txt"
  wasm-aot-essential "test/wasm/controls-aot.txt"
  wai-js-essential "test/wasm/controls-js.txt"
  wasm-roundtrip "test/wasm/controls.txt"
  wasm-wast "test/wasm/controls-wast.txt"
  wai-check "test/wasm/controls-eval.txt"
  wai-go "test/wasm/controls-go.txt"
  wai-aot "test/wasm/controls-aot.txt"
  wai-go-aot "test/wasm/controls-go.txt"
  wai-go-aot-rest "test/wasm/controls-go.txt"
  wai-js "test/wasm/controls-js.txt"

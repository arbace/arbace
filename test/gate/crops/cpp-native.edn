;; GT9 (doc/GATE-SURVEY.md, "As built: GT9 (write-ahead)"): merge plan batch 5 (cpp-native, cpp-native2, cpp-tree,
;; crop-controls-cpp): C++'s native reader (CX11), its samples in the essential chain and the two lists nightly (977 files in 101 s
;; at the branch's measure). Splice after crops/cpp.edn
;;@ steps
  {:name cpp-native-essential :mem-gib 2 :phase :essential :chain cpp-essential :needs [cpp-read-essential]
   :cmd "bin/repr-cpp native-check samples .tmp/gate/cpp-native-essential"
   :hosts [:stage0 :cxx] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn"] :inputs [:lib-tools :tools :cpp]
   :summary ["equal|differ|improve|control|FAIL" 4]}
  {:name cpp-native :mem-gib 3 :phase :full :chain cpp-full
   :cmd "bin/repr-cpp native-check test/repr/cpp/native/{part}.list .tmp/gate/cpp-native-{part}"
   :hosts [:stage0 :cxx] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn"] :inputs [:lib-tools :tools :cpp]
   :parts [{:part gxx-a} {:part gxx-b}] :summary ["equal|differ|improve|control|FAIL" 4]}
;;@ crops
         :cpp [cpp-native-essential cpp-native]
;;@ controls
  cpp-native-essential "test/repr/cpp/native-controls.edn"
  cpp-native "test/repr/cpp/native-controls.edn"

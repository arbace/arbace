;; GT9 (doc/GATE-SURVEY.md, "As built: GT9 (write-ahead)"): Haskell's gate steps for merge plan batch 4 (haskell-he4d, haskell-native
;; and its line, crop-controls-haskell; crop-controls before, batch 5 or with gate-crops). Read and print are main's verbs, hsi
;; he4d's, native-check and tables haskell-native's. GT9's changes to GT9.4: the round trip's four levels whole nightly (10 min,
;; nothing rotated; --only FILE is NEW, GTS223); hsi's whole check (two programs of 7.3 and 9.7 GB) is :heavy and in a chain of its
;; own (GTS216: a chain beside the serial run is light, at most 4 GiB a step); hsi's essential list is he4d's 123 programs (check its
;; peak at 3 GiB on the day of the merge: GTS215). The round trip has known files only: its results file (GTS219, --record-results)
;; is NEW, so bin/reap's Haskell row waits for it
;;   - ORS12 (doc/ORACLE-RECORDS-SURVEY.md, "As built: Haskell", branch oracle-records-haskell): this file is gt9-verbs' with GHC's
;;     answers as records. haskell-read-essential loses :ghc (the helper's dumps, trees and interfaces of `bin/repr-haskell test`'s fixed
;;     inputs are test/haskell/records/, committed; GHC's reading of the print, class D, is `test --oracle`); hsi-essential and hsi-check
;;     lose :ghc (the libraries' and the programs' STG are the packs haskell-stg-libs and haskell-stg-progs); haskell-roundtrip is the
;;     oracle tier's (GHC reads Arbace's print at every level: class D until the native reader, haskell-native, reads it, ORS20 below),
;;     the originals' dumps and trees from the four packs haskell-{dumps,dumps-full,trees,trees-full}-ghc-9.14.1; haskell-native-essential
;;     (native-check and tables --check, haskell-native's verbs, whose helper dumps are still live) keeps :ghc until that branch's
;;     native-check reads the packs (ORS20). The oracle tier's three Haskell steps are new. On merge, take this file's side.
;;@ groups
  :haskell ["bin/repr-haskell" "bin/lib/repr-haskell/" "bin/oracle-records" "test/oracle-records/" "arbace/repr/haskell.ae" "arbace/repr/haskell/" "tools/hsdump/" "test/haskell/"]
  :hsi ["bin/hsi" "bin/lib/hsi/" "go/arbace/hs.ae" "go/arbace/hs/" "go/arbace/libm.ae" "go/arbace/libm/"]
;;@ steps
  ;; ---- Haskell (HR*, HE1-HE4e, the native reader; GT9): essential one chain (about 1.2 min), the chain haskell-full at night
  {:name haskell-read-essential :mem-gib 2 :phase :essential :chain haskell-essential
   :cmd "bin/repr-haskell test"
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["test/haskell/corpus-ghc-9.14.1.edn"] :inputs [:lib-tools :tools :haskell]
   :summary ["ok|equal|differ|control|FAIL|skipped|STALE|UNRECORDED|REFUSED" 4]}
  {:name haskell-native-essential :mem-gib 2 :phase :essential :chain haskell-essential :needs [haskell-read-essential]
   :cmd "bin/repr-haskell tables --check && bin/repr-haskell native-check"
   :hosts [:stage0 :ghc] :never-loads [arbace.j2g] :pins ["test/haskell/corpus-ghc-9.14.1.edn"] :inputs [:lib-tools :tools :haskell]
   :summary ["ok|equal|differ|control|FAIL" 4]}
  {:name hsi-essential :mem-gib 3 :phase :essential :chain haskell-essential :needs [haskell-read-essential]
   :cmd "bin/hsi check --only @test/haskell/hsi/essential.txt"
   :hosts [:stage0 :go] :never-loads [arbace.j2g]
   :pins ["test/haskell/eval-corpora.edn" "test/haskell/records/haskell-stg-libs.sha256" "test/haskell/records/haskell-stg-progs.sha256"]
   :inputs [:lib-tools :tools :haskell :hsi]
   :summary ["pass|fail|control|FAIL|STALE|UNRECORDED|REFUSED" 4]}
  {:name hsi-check :heavy true :mem-gib 10 :phase :full :chain haskell-heavy
   :cmd "bin/hsi check --corpus samples,synthetic,testsuite-core --jobs 8"
   :hosts [:stage0 :go] :never-loads [arbace.j2g]
   :pins ["test/haskell/eval-corpora.edn" "test/haskell/records/haskell-stg-libs.sha256" "test/haskell/records/haskell-stg-progs.sha256"]
   :inputs [:lib-tools :tools :haskell :hsi]
   :summary ["pass|fail|hsi|control|FAIL|STALE|UNRECORDED|REFUSED" 4]}
  ;; ---- Haskell's oracle tier (ORS1 (a), ORS8 (a), ORS12; doc/ORACLE-RECORDS-SURVEY.md "As built: Haskell"): the only Haskell steps on :ghc,
  ;; :phase :oracle (bin/gate --oracle), absent where the host lacks GHC, never in the essential gate, --full or the clean run, required at
  ;; a tag. haskell-test-oracle: bin/repr-haskell test with GHC reading the print (the printed modules' trees and interfaces, class D);
  ;; haskell-roundtrip-oracle: the round trip's four levels whole, the originals' dumps and trees from the packs and GHC on the print;
  ;; haskell-records-verify: the helper's and GHC's live answers against the records (ORS6 (a): a moved toolchain reported, not failed),
  ;; each kind with its crossed pair, a sample a night (the whole at a tag's oracle run: `bin/oracle-records verify haskell`)
  {:name haskell-test-oracle :mem-gib 3 :phase :oracle :chain haskell-oracle
   :cmd "bin/repr-haskell test --oracle"
   :hosts [:stage0 :ghc] :never-loads [arbace.j2g] :pins ["test/haskell/corpus-ghc-9.14.1.edn"] :inputs [:lib-tools :tools :haskell]
   :summary ["ok|equal|differ|control|FAIL" 4]}
  {:name haskell-roundtrip-oracle :mem-gib 3 :phase :oracle :chain haskell-oracle
   :cmd "bin/repr-haskell roundtrip {part}"
   :hosts [:stage0 :ghc] :never-loads [arbace.j2g]
   :pins ["test/haskell/corpus-ghc-9.14.1.edn" "test/haskell/records/haskell-dumps-ghc-9.14.1.sha256" "test/haskell/records/haskell-dumps-full-ghc-9.14.1.sha256"
          "test/haskell/records/haskell-trees-ghc-9.14.1.sha256" "test/haskell/records/haskell-trees-full-ghc-9.14.1.sha256"]
   :inputs [:lib-tools :tools :haskell]
   :parts [{:part tree :cmd "bin/repr-haskell roundtrip"} {:part layout :cmd "bin/repr-haskell roundtrip --layout-only"}
           {:part iface :cmd "bin/repr-haskell roundtrip --iface"} {:part text :cmd "bin/repr-haskell roundtrip --text"}]
   :summary ["equal|known|differ|control|FAIL" 4]}
  {:name haskell-records-verify :mem-gib 3 :phase :oracle :chain haskell-oracle
   :cmd "bin/oracle-records verify haskell test-dumps hsdump-corpus stg-libs stg-progs --sample 8"
   :hosts [:stage0 :ghc] :never-loads [arbace.j2g]
   :pins ["test/haskell/eval-corpora.edn" "test/haskell/records/haskell-stg-libs.sha256" "test/haskell/records/haskell-stg-progs.sha256"
          "test/haskell/records/haskell-dumps-ghc-9.14.1.sha256"]
   :inputs [:lib-tools :tools :haskell :hsi]
   :summary ["^verify|FAIL|control" 12]}
;;@ crops
         :haskell [haskell-read-essential haskell-native-essential hsi-essential hsi-check haskell-test-oracle haskell-roundtrip-oracle haskell-records-verify]
;;@ controls
  haskell-read-essential {:waived "bin/repr-haskell test judges the fixed cases against the records and the worked example's spec; its mutants are the cases' own differ checks (iface/changed differs from layout/; a renamed form prints with the name changed)"}
  haskell-native-essential "test/haskell/native-controls.txt"
  hsi-essential "test/haskell/hsi-controls.txt"
  hsi-check "test/haskell/hsi-controls.txt"
  haskell-test-oracle {:waived "the same cases as haskell-read-essential with GHC reading the print: the cases' own differ checks"}
  haskell-roundtrip-oracle "test/haskell/roundtrip-controls.edn"
  haskell-records-verify {:waived "the verifies' own crossed pairs (one unit's live output against another's entry, which must differ: control passed or the verify fails)"}

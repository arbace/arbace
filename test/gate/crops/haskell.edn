;; GT9 (doc/GATE-SURVEY.md, "As built: GT9 (write-ahead)"): Haskell's gate steps for merge plan batch 4 (haskell-he4d, haskell-native
;; and its line, crop-controls-haskell; crop-controls before, batch 5 or with gate-crops). Read and print are main's verbs, hsi
;; he4d's, native-check and tables haskell-native's. GT9's changes to GT9.4: the round trip's four levels whole nightly (10 min,
;; nothing rotated; --only FILE is NEW, GTS223); hsi's whole check (two programs of 7.3 and 9.7 GB) is :heavy and in a chain of its
;; own (GTS216: a chain beside the serial run is light, at most 4 GiB a step); hsi's essential list is he4d's 123 programs (check its
;; peak at 3 GiB on the day of the merge: GTS215). The round trip has known files only: its results file (GTS219, --record-results)
;; is NEW, so bin/reap's Haskell row waits for it
;;@ groups
  :haskell ["bin/repr-haskell" "bin/lib/repr-haskell/" "arbace/repr/haskell.ae" "arbace/repr/haskell/" "tools/hsdump/" "test/haskell/"]
  :hsi ["bin/hsi" "bin/lib/hsi/" "go/arbace/hs.ae" "go/arbace/hs/" "go/arbace/libm.ae" "go/arbace/libm/"]
;;@ steps
  ;; ---- Haskell (HR*, HE1-HE4e, the native reader; GT9): essential one chain (about 1.2 min), the chain haskell-full at night
  {:name haskell-read-essential :mem-gib 2 :phase :essential :chain haskell-essential
   :cmd "bin/repr-haskell test && bin/repr-haskell tables --check && bin/repr-haskell native-check"
   :hosts [:stage0 :ghc] :never-loads [arbace.j2g] :pins ["test/haskell/corpus-ghc-9.14.1.edn"] :inputs [:lib-tools :tools :haskell]
   :summary ["ok|equal|differ|control|FAIL" 4]}
  {:name hsi-essential :mem-gib 3 :phase :essential :chain haskell-essential :needs [haskell-read-essential]
   :cmd "bin/hsi check --only @test/haskell/hsi/essential.txt"
   :hosts [:stage0 :go :ghc] :never-loads [arbace.j2g] :pins ["test/haskell/eval-corpora.edn"] :inputs [:lib-tools :tools :haskell :hsi]
   :summary ["pass|fail|control|FAIL" 4]}
  {:name haskell-roundtrip :mem-gib 3 :phase :full :chain haskell-full
   :cmd "bin/repr-haskell roundtrip {part}"
   :hosts [:stage0 :ghc] :never-loads [arbace.j2g] :pins ["test/haskell/corpus-ghc-9.14.1.edn"] :inputs [:lib-tools :tools :haskell]
   :parts [{:part tree :cmd "bin/repr-haskell roundtrip"} {:part layout :cmd "bin/repr-haskell roundtrip --layout-only"}
           {:part iface :cmd "bin/repr-haskell roundtrip --iface"} {:part text :cmd "bin/repr-haskell roundtrip --text"}]
   :summary ["equal|known|differ|control|FAIL" 4]}
  {:name hsi-check :heavy true :mem-gib 10 :phase :full :chain haskell-heavy
   :cmd "bin/hsi check --corpus samples,synthetic,testsuite-core --jobs 8"
   :hosts [:stage0 :go :ghc] :never-loads [arbace.j2g] :pins ["test/haskell/eval-corpora.edn"] :inputs [:lib-tools :tools :haskell :hsi]
   :summary ["pass|fail|hsi|control|FAIL" 4]}
;;@ crops
         :haskell [haskell-read-essential hsi-essential haskell-roundtrip hsi-check]
;;@ controls
  haskell-read-essential "test/haskell/native-controls.txt"
  hsi-essential "test/haskell/hsi-controls.txt"
  haskell-roundtrip "test/haskell/roundtrip-controls.edn"
  hsi-check "test/haskell/hsi-controls.txt"

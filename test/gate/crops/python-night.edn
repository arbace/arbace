;; queue 317: Python's steps that name a file only the records night writes (doc/GATE-SURVEY.md GT9; queue 258's report): held out
;; of the splice of python.edn and python-oracle.edn, since gate.plan's table check refuses a pin or a :rotate :universe that is no
;; file in every mode (the essential gate's plan too: a whole splice planned with 86 problems, all naming these nine files).
;; Queue 428 (2026-11-19) committed the universes test/python/{roundtrip,parse-check}-results.edn; queue 436 (2026-11-19) split the
;; six held steps by what each waits on, each step's :pins what its run reads in records mode (bin/repr-python's and bin/pyi's
;; pyrec_dump, tools/pydump/records.bash):
;;   - this file: the steps that name no pydump pack, spliced once the main host's records night commits the two check records,
;;     test/python/check-aot-linux-amd64.edn (bin/pyi check --aot --record: pyi-check-aot-goi's universe) and
;;     test/python/check-lib-test-linux-amd64.edn (bin/pyi check --fresh --record: pyi-check's), branch n-py-rec. python-roundtrip
;;     reads no pack in records mode (the originals and the print read by the native reader, levels 2 and 3 by pyi's own ast and
;;     compile since queue 431, REPR_PYTHON_RT_LEVELS=own; its pins named the three packs, which it never read): its universe is
;;     committed, it waits only on test/python/roundtrip-own-known.edn recorded over the whole corpora (queue 431's first command,
;;     bin/repr-python roundtrip --record stdlib site-packages lib-test), else its slices report its :own-code-lines files UNEXPECTED;
;;   - test/gate/crops/python-packs.edn: python-front, python-native and python-records-verify, whose runs read the packs
;;     python-pydump-{stdlib,site-packages,lib-test,mutants-lex,mutants-parse} (REPR_PYTHON_ORACLE=record bin/repr-python records
;;     record stdlib site-packages lib-test mutants, on the main host).
;; Apply, in a main checkout with n-py-rec's records committed:
;;   arbace_tool -p test -m gate.crops splice test/gate/steps.edn test/gate/crops/python-night.edn > .tmp/steps.edn && mv .tmp/steps.edn test/gate/steps.edn
;; (the crops entry joins steps.edn's :python vector). Steps: python-roundtrip (chain python-read, python-packs.edn's two others join
;; it), pyi-check-aot-goi (chain pyi-aot) and pyi-check (chain pyi-full); their notes as python.edn's were (the tiers there).
;;@ steps
  ;; ---- python-read (light: each at most 2 GiB, no :needs on another chain's full step: beside the serial run at night, GTS216 (a)):
  ;; the round trips (a seventh a night over the results file); python-packs.edn's front end and tokens and trees join the chain
  ;; queue 436: no pack among the pins (records mode reads none: roundtrip_one's REPR_PYTHON_RT_ORIG native, queue 431's own levels)
  {:name python-roundtrip :mem-gib 2 :phase :full :chain python-read
   :cmd "bin/repr-python roundtrip {only} {part} && bin/repr-python roundtrip --text {only} {part}"
   :hosts [:stage0] :never-loads [arbace.j2g]
   :pins ["test/python/corpora.edn"]
   :inputs [:lib-tools :tools :python "arbace/python/compile.ae" "arbace/python/scope.ae" "arbace/python/ir.ae"]
   :parts [{:part stdlib} {:part site-packages} {:part lib-test}] :summary ["^roundtrip|FAIL|control" 6]
   :rotate {:only "--only-list {list}" :universe "test/python/roundtrip-results.edn" :id-re "^\\[\"([^ \"]+) ([^\"]+)\"" :id-as "$1/$2"
            :subset "test/python/corpora.edn" :subset-key :subset-roundtrip :failed-re "^FAIL ([^[:cntrl:]]+)[[:cntrl:]].*$"
            :always ["stdlib/Lib/keyword.py" "stdlib/Lib/colorsys.py" "lib-test/Lib/test/test_keyword.py" "lib-test/Lib/test/test_colorsys.py"
                     "site-packages/usr/lib/python3.14/site-packages/packaging/_structures.py"
                     "site-packages/usr/lib/python3.14/site-packages/packaging/errors.py"]}}
  ;; queue 235: pyi on goi over the same programs (the eval cell's beside source; 35 min whole on the VM), a seventh a night over the
  ;; record the night writes (test/python/check-aot-linux-amd64.edn), its subset test/python/gate-subsets.edn's :with-pyi
  ;; DECISION 1 (a) of queue 321 (the user, 2026-11-17): on the gate's executable at the checkout's key, whose compiled runtime is
  ;; the checkout's (go/arbace/py and libm are in gate_key since W2); PYI_RUNTIME_REQUIRE=compiled fails any other (bin/pyi's runtime_guard)
  {:name pyi-check-aot-goi :mem-gib 3 :phase :full :chain pyi-aot :needs [pyi-aot-runtime go-build]
   :cmd "env ARBACE_HOST_EXE=\"$GATE_EXE\" PYI_RUNTIME_REQUIRE=compiled bin/pyi check --aot {only}"
   :hosts [:prog :stage0 :go] :never-loads [arbace.j2g] :pins ["test/python/corpora.edn"] :inputs [:lib-tools :tools :python :pyi]
   :parts [{:part with-pyi}] :summary ["^check --aot:|^verdicts|classed|failing|negative control|FAIL" 6]
   :rotate {:only "--only-list {list}" :universe "test/python/check-aot-linux-amd64.edn" :id-re "^\\{:id \"([^\"]+)\""
            :subset "test/python/gate-subsets.edn" :failed-re "^  failed ([^ ]+) .*$"}}
  ;; queue 235: Lib/test by each test's own verdict (bin/pyi check, PY7; queue 234), a part a corpus, a seventh of each corpus's
  ;; modules a night over the record the night writes (test/python/check-lib-test-linux-amd64.edn): the :id-re's group 1 the
  ;; method's MODULE, group 2 its corpus, so a slice is whole modules (by method, the coverage subset's ids, with :slice-re, GTS243);
  ;; the subsets test/python/gate-subsets.edn's :subset-check; --only adds test/python/controls.edn's subjects to every slice. The
  ;; whole: 2h50 on the VM at 2 jobs (lib-test-all), language-core about 25 min; a seventh about 25 min. PYI_LIB_TEST_JOBS 2: :mem-gib
  ;; the two drivers and the judge
  ;; on the gate's executable (DECISION 1 (a) of queue 321, as pyi-check-aot-goi)
  {:name pyi-check :mem-gib 6 :phase :full :chain pyi-full :needs [pyi-aot-runtime go-build]
   :cmd "env ARBACE_HOST_EXE=\"$GATE_EXE\" PYI_RUNTIME_REQUIRE=compiled bin/pyi check --corpus {part} {only}"
   :hosts [:prog :stage0 :go] :never-loads [arbace.j2g] :pins ["test/python/corpora.edn"] :inputs [:lib-tools :tools :python :pyi]
   :parts [{:part language-core} {:part stdlib-tests} {:part lib-test-asyncio} {:part lib-test-all}]
   :summary ["methods:|classed|failing|regressions|control" 6]
   :rotate {:only "--only {list}" :universe "test/python/check-lib-test-linux-amd64.edn"
            :id-re "^\\s*\\[\"([^\"/]+)/[^\"]*\" :[a-z-]+ \".*\" :([a-z-]+)\\]$"
            :subset "test/python/gate-subsets.edn" :subset-key :subset-check :failed-re "^   failing: ([^/]+)/.*$"}}
;;@ crops
         :python [python-roundtrip pyi-check-aot-goi pyi-check]
;;@ controls
  python-roundtrip "test/python/controls-read.edn"
  pyi-check-aot-goi "arbace/python/aot.ae"
  pyi-check "test/python/controls.edn"

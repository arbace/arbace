;; GT9's OCaml fragment (gt9-verbs: test/gate/crops/ocaml.edn, "merge plan batch 1": ocaml-o8's steps on GT9's planner) with ocamlc's and
;; ocdump's answers as records (ORS12, doc/ORACLE-RECORDS-SURVEY.md, "As built: OCaml", branch oracle-records-ocaml). On merge, take this file's
;; side for the OCaml steps. What differs from GT9's:
;;   - oi-essential, oi-check, oi-aot, oi-suite-aot lose :ocaml: the stdlib's Lambda (pack ocaml-lambda-stdlib), each run program's
;;     (ocaml-lambda-progs, 309 programs), the suite's units' (ocaml-lambda-suite) and the REPL session's phrases' (test/ocaml/records/repl/) are
;;     read from the records (bin/oi, OI_LIVE=1 runs ocamlc and ocdump); :pins name the packs. ocamlc's and ocamlopt's runs are ref-ocaml55.edn
;;     and ref-suite.edn (class A, already data)
;;   - ocaml-read-essential, ocaml-roundtrip (parts stdlib and samples) lose :ocaml: the originals' parse and layout dumps are packs
;;     (ocaml-dumps-{samples,stdlib,spec}), the text level (mode :full printed back byte for byte) and the print run from them, spec-check and
;;     `roundtrip --spec` read the spec examples' dumps from ocaml-dumps-spec. Class D (ocdump's parse of Arbace's print, the tree level's
;;     compare, ocamlc -c of the original and of the print, the .cmi level) is not run there: the oracle tier's ocaml-roundtrip-oracle
;;   - ocaml-judges: `bin/oi judges-test --records` (no ocamlc: the judges' synthetic cases, the floors, the key, the OI column); the cases of the
;;     expect action, the helper's levels test (repr_levels_test) and the determinism test are the oracle tier's ocaml-judges-oracle
;;   - ocaml-dumps (the dumper's own test: two runs each) is the oracle tier's ocaml-dumps-oracle
;;   - ocaml-roundtrip's other corpora (compiler-sources, compiler-backend, testsuite, whiml, opam) have no packs until the night's
;;     `bin/repr-ocaml record-dumps ...`: they run live in the oracle tier (REPR_OCAML_LIVE=1) until then (ORS24)
;;   - ocaml-records-verify: the verify of the kinds, a sample a night
;; Not here: GT9's :rotate over test/ocaml/subsets.edn (gt9v-ocaml's --only-list verbs are on ocaml-o8 only through O8's own, which this branch
;; has: oi's check --only-list; repr-ocaml's --only-list and --cmi-only are gt9v-ocaml's) and the native steps (ocaml-native: batch 3)
;;@ groups
  ;; OCaml's tools (O8): repr/ocaml and o2j evaluated from the checkout on stage 0, the helper tools/ocdump on the host's compiler-libs (:ocaml,
  ;; the oracle tier's only), the records and references (test/ocaml/, its records/), the oracle packs' library (test/oracle-records/)
  :ocaml ["bin/oi" "bin/lib/oi/" "bin/repr-ocaml" "bin/lib/limit.bash" "arbace/repr/ocaml.ae" "arbace/repr/ocaml/" "tools/ocdump/"
          "test/ocaml/" "bin/oracle-records" "test/oracle-records/"]
  ;; oi's driver: go/arbace/oi printed by repr/go and built by TamaGo's go; the AOT level's runtime jdk/ocaml/
  :ocaml-run ["go/arbace/oi.ae" "go/arbace/oi/" "bin/repr-go" "bin/lib/repr-go-host.bash" "bin/lib/repr-go/"]
  :ocaml-aot ["jdk/ocaml/"]
;;@ steps
  ;; ---- OCaml (O8; GT9; ORS12): essential two chains of about 1.4 min warm, the full chain ocaml-full, the oracle tier at night
  {:name oi-essential :mem-gib 2 :phase :essential :chain oi-essential
   :cmd "bin/oi test && bin/oi repl-check && bin/oi check --only-list test/ocaml/essential-check.txt"
   :hosts [:stage0 :go] :never-loads [arbace.j2g]
   :pins ["test/ocaml/corpora.edn" "test/ocaml/records/ocaml-lambda-stdlib.sha256" "test/ocaml/records/ocaml-lambda-progs.sha256"]
   :inputs [:lib-base :lib-tools :tools :ocaml :ocaml-run]
   :summary ["^ok|repl-check|programs:|failing|FAILING|control|STALE|UNRECORDED|REFUSED" 6]}
  {:name oi-divergences :mem-gib 1 :phase :essential :chain oi-essential :needs [oi-essential]
   :cmd "bin/oi divergences && bin/oi divergences --aot && bin/oi suite divergences && bin/oi suite divergences --aot"
   :hosts [:stage0] :never-loads [arbace.j2g] :inputs [:lib-base :ocaml]
   :summary ["pass, [0-9]+ failing|^oi: pins: [0-9]|FAILING" 6]}
  {:name ocaml-read-essential :mem-gib 2 :phase :essential :chain ocaml-read-essential
   :cmd "bin/repr-ocaml roundtrip --text samples stdlib && bin/repr-ocaml roundtrip --spec && bin/repr-ocaml spec-check && bin/repr-ocaml embed-check"
   :hosts [:stage0] :never-loads [arbace.j2g]
   :pins ["test/ocaml/corpora.edn" "test/ocaml/records/ocaml-dumps-samples.sha256" "test/ocaml/records/ocaml-dumps-stdlib.sha256"
          "test/ocaml/records/ocaml-dumps-spec.sha256"]
   :inputs [:lib-base :lib-tools :tools :ocaml "arbace/j2g/embed.ae" "bin/lib/version.bash"]
   :summary ["^compare: |^full: |cmi: |spec|embed|control|FAIL|DIFF|GONE|STALE|UNRECORDED|REFUSED" 10]}
  {:name ocaml-roundtrip :mem-gib 2 :phase :full :chain ocaml-full
   :cmd "bin/repr-ocaml roundtrip --text --corpus {part}"
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["test/ocaml/corpora.edn"]
   :inputs [:lib-base :lib-tools :tools :ocaml]
   :parts [{:part stdlib :pins ["test/ocaml/records/ocaml-dumps-stdlib.sha256"]} {:part samples :pins ["test/ocaml/records/ocaml-dumps-samples.sha256"]}]
   :summary ["^full: |control|FAIL|DIFF|GONE|FLOOR|STALE|UNRECORDED|REFUSED" 6]}
  {:name oi-check :mem-gib 2 :phase :full :chain ocaml-full
   :cmd "bin/oi check {only} && bin/oi suite check && bin/oi suite rollup"
   :hosts [:stage0 :go] :never-loads [arbace.j2g]
   :pins ["test/ocaml/corpora.edn" "test/ocaml/records/ocaml-lambda-stdlib.sha256" "test/ocaml/records/ocaml-lambda-progs.sha256"
          "test/ocaml/records/ocaml-lambda-suite.sha256"]
   :inputs [:lib-base :lib-tools :tools :ocaml :ocaml-run]
   :parts [{:part run}]
   :summary ["programs:|pass, [0-9]+ failing|FAILING|CHANGED|GONE|control|rollup|STALE|UNRECORDED|REFUSED" 8]}
  {:name oi-aot :mem-gib 4 :phase :full :chain ocaml-full :needs [oi-check]
   :cmd "env O2J_JOBS=4 bin/oi check --aot"
   :hosts [:stage0 :go] :never-loads [arbace.j2g]
   :pins ["test/ocaml/corpora.edn" "test/ocaml/records/ocaml-lambda-stdlib.sha256" "test/ocaml/records/ocaml-lambda-progs.sha256"]
   :inputs [:lib-base :lib-tools :tools :ocaml :ocaml-run :ocaml-aot]
   :parts [{:part run}]
   :summary ["^o2j: [0-9]+ programs|pass, [0-9]+ failing|FAILING|CHANGED|GONE|control|STALE|UNRECORDED|REFUSED" 6]}
  {:name oi-suite-aot :mem-gib 4 :phase :full :chain ocaml-full :needs [oi-check]
   :cmd "env O2J_JOBS=4 bin/oi suite check --aot"
   :hosts [:stage0 :go] :never-loads [arbace.j2g]
   :pins ["test/ocaml/corpora.edn" "test/ocaml/records/ocaml-lambda-stdlib.sha256" "test/ocaml/records/ocaml-lambda-suite.sha256"]
   :inputs [:lib-base :lib-tools :tools :ocaml :ocaml-run :ocaml-aot]
   :parts [{:part suite}]
   :summary ["^o2j: [0-9]+ programs|pass, [0-9]+ failing|FAILING|CHANGED|GONE|control|STALE|UNRECORDED|REFUSED" 6]}
  {:name ocaml-judges :mem-gib 2 :phase :full :chain ocaml-full :needs [oi-aot]
   :cmd "bin/oi judges-test --records"
   :hosts [:stage0 :go] :never-loads [arbace.j2g]
   :pins ["test/ocaml/corpora.edn" "test/ocaml/records/ocaml-lambda-stdlib.sha256" "test/ocaml/records/ocaml-lambda-progs.sha256"]
   :inputs [:lib-base :lib-tools :tools :ocaml :ocaml-run :ocaml-aot]
   :summary ["ok|FAIL|cases|skip" 8]}
  ;; ---- OCaml's oracle tier (ORS1 (a), ORS8 (a), ORS12): the only OCaml steps on :ocaml, :phase :oracle (bin/gate --oracle), absent where the host
  ;; lacks ocamlc, never in the essential gate, --full or the clean run, required at a tag. ocaml-roundtrip-oracle: ocdump's parse of Arbace's
  ;; print and ocamlc -c of the original and the print (class D), every corpus live; ocaml-dumps-oracle: the dumper's own test; ocaml-judges-oracle:
  ;; the cases that build and run the helper and the expect tool; ocaml-records-verify: the live answers against the records, each kind with its
  ;; crossed pair where it runs one, a sample a night
  {:name ocaml-roundtrip-oracle :mem-gib 3 :phase :oracle :chain ocaml-oracle
   :cmd "bin/repr-ocaml roundtrip --oracle --cmi --corpus {part}"
   :hosts [:stage0 :ocaml] :never-loads [arbace.j2g] :pins ["test/ocaml/corpora.edn"]
   :inputs [:lib-base :lib-tools :tools :ocaml]
   :parts [{:part samples} {:part stdlib} {:part compiler-sources :clean-only true} {:part compiler-backend :clean-only true}
           {:part testsuite :clean-only true} {:part whiml :clean-only true} {:part opam :clean-only true}]
   :summary ["^compare: |^full: |cmi: |control|FAIL|DIFF|GONE|UNSTABLE|FLOOR" 6]}
  {:name ocaml-dumps-oracle :mem-gib 2 :phase :oracle :chain ocaml-oracle
   :cmd "bin/repr-ocaml dumps && bin/repr-ocaml samples"
   :hosts [:stage0 :ocaml] :never-loads [arbace.j2g] :pins ["test/ocaml/corpora.edn"]
   :inputs [:lib-base :lib-tools :tools :ocaml]
   :summary ["^dumps|FLOOR|unstable|FAIL|ok" 6]}
  {:name ocaml-judges-oracle :mem-gib 3 :phase :oracle :chain ocaml-oracle
   :cmd "bin/oi judges-test"
   :hosts [:stage0 :go :ocaml] :never-loads [arbace.j2g] :pins ["test/ocaml/corpora.edn"]
   :inputs [:lib-base :lib-tools :tools :ocaml :ocaml-run :ocaml-aot]
   :summary ["ok|FAIL|cases|expect" 8]}
  {:name ocaml-records-verify :mem-gib 2 :phase :oracle :chain ocaml-oracle
   :cmd "bin/oracle-records verify ocaml lambda-stdlib lambda-progs repl dumps --sample 8"
   :hosts [:stage0 :ocaml] :never-loads [arbace.j2g]
   :pins ["test/ocaml/records/ocaml-lambda-stdlib.sha256" "test/ocaml/records/ocaml-lambda-progs.sha256" "test/ocaml/records/ocaml-lambda-suite.sha256"
          "test/ocaml/records/ocaml-dumps-samples.sha256" "test/ocaml/records/ocaml-dumps-stdlib.sha256" "test/ocaml/records/ocaml-dumps-spec.sha256"]
   :inputs [:lib-base :lib-tools :tools :ocaml]
   :summary ["^verify|FAIL|control" 12]}
;;@ crops
         :ocaml [oi-essential oi-divergences ocaml-read-essential ocaml-roundtrip oi-check oi-aot oi-suite-aot ocaml-judges
                 ocaml-roundtrip-oracle ocaml-dumps-oracle ocaml-judges-oracle ocaml-records-verify]
;;@ controls
  oi-essential "test/ocaml/controls.txt"
  oi-divergences {:waived "a judgment of the committed records (no run): its negative cases are the judges' tests (ocaml-judges)"}
  ocaml-read-essential "test/ocaml/roundtrip-controls.txt"
  ocaml-roundtrip "test/ocaml/roundtrip-controls.txt"
  oi-check "test/ocaml/controls.txt"
  oi-aot "test/ocaml/controls.txt"
  oi-suite-aot "test/ocaml/controls.txt"
  ocaml-judges {:waived "the judges' own tests: each a negative case"}
  ocaml-roundtrip-oracle "test/ocaml/roundtrip-controls.txt"
  ocaml-dumps-oracle {:waived "the typed and Lambda dumps against their known file and floors, with the determinism test; no crossed pair (GT9.8: not a read or print family)"}
  ocaml-judges-oracle {:waived "the judges' own tests and the expect action's: each a negative case"}
  ocaml-records-verify {:waived "the verifies' own crossed pairs (one unit's live output against another's entry, which must differ: control passed or the verify fails)"}

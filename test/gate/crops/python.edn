;; GT9 (doc/GATE-SURVEY.md, "As built: GT9 (write-ahead)"): Python's gate steps for merge plan batch P (mac/201-python-py7-py11),
;; from doc/python/PY11-PREP.md's block (the Mac's draft, on that branch) on GT9's tooling: its :host-ids map is steps.edn's
;; :host-ids :python (items), its pins line :crop-pins :python. GTS218 (a) keeps out what has no control yet: the round trips (both
;; modes) and parse-check (PY11-PREP's R1: python-roundtrip, python-native, and the round-trip half of python-read-essential), which
;; enter with R1. pyi-check's :slice-re (PY11-PREP's REQUEST cc463c8d to the planner) is not built: a planner change rekeys every step
;; (GTS243 proposes it with the runner's next change); until then its rotation slices by id. Costs are the VM's (GTS222: re-measured
;; on amd64 by the first two nights)
;;@ groups
  :python ["bin/repr-python" "arbace/repr/python.ae" "arbace/repr/python/" "tools/pydump/" "test/python/"]
  :pyi ["bin/pyi" "arbace/python.ae" "arbace/python/" "go/arbace/py.ae" "go/arbace/py/" "go/arbace/libm.ae" "go/arbace/libm/"
        "tools/pyi/" :goi]
;;@ steps
  ;; ---- Python (PY6-PY10; GT9): the AOT cache's build, the essential chain (about 40 s warm on the VM), the chain python-full at night
  {:name pyi-aot-runtime :phase :build :kind :build :mem-gib 3
   :cmd "bin/pyi check --aot --no-pyi --only samples/functions.py"
   :hosts [:stage0 :go] :inputs [:lib-tools :tools :pyi]}
  {:name python-front-essential :mem-gib 2 :phase :essential :chain python-essential
   :cmd "bin/pyi gen --check && bin/pyi scope-check samples synthetic errors && bin/pyi compile-check --full samples synthetic errors"
   :hosts [:stage0 :python] :never-loads [arbace.j2g] :pins ["test/python/corpora.edn" "tools/pydump/PYTHON_VERSION"]
   :inputs [:lib-tools :tools :python :pyi] :summary ["files, 0 failing|equal|differ|FAIL|control" 6]}
  {:name pyi-aot-essential :mem-gib 2 :phase :essential :chain python-essential :needs [python-front-essential pyi-aot-runtime]
   :cmd "bin/pyi check --aot --no-pyi --only-list test/python/essential-aot.txt"
   :hosts [:stage0 :go :python] :never-loads [arbace.j2g] :pins ["test/python/corpora.edn"] :inputs [:lib-tools :tools :python :pyi]
   :summary ["^check --aot:|classed|failing|negative control" 4]}
  {:name python-front :mem-gib 2 :phase :full :chain python-full
   :cmd "bin/pyi scope-check {part} && bin/pyi compile-check --full {part}"
   :hosts [:stage0 :python] :never-loads [arbace.j2g] :pins ["test/python/corpora.edn"] :inputs [:lib-tools :tools :python :pyi]
   :parts [{:part stdlib} {:part site-packages} {:part lib-test}] :summary ["equal|not passing|FAIL|control" 4]}
  {:name pyi-check-aot :mem-gib 3 :phase :full :chain python-full
   :cmd "bin/pyi runtime check && bin/pyi record-ref --check && bin/pyi check --aot --no-pyi"
   :hosts [:stage0 :go :python] :never-loads [arbace.j2g] :pins ["test/python/corpora.edn"] :inputs [:lib-tools :tools :python :pyi]
   :parts [{:part light}] :summary ["^check --aot:|classed|failing|negative control|FAIL" 5]}
  {:name pyi-check-aot-goi :mem-gib 3 :phase :full :chain python-full
   :cmd "bin/pyi check --aot {only}"
   :hosts [:stage0 :go :python] :never-loads [arbace.j2g] :pins ["test/python/corpora.edn"] :inputs [:lib-tools :tools :python :pyi]
   :parts [{:part with-pyi}] :summary ["^check --aot:|classed|failing|negative control|FAIL" 5]
   :rotate {:only "--only-list {list}" :universe "test/python/check-aot-linux-amd64.edn" :id-re "^\\{:id \"([^\"]+)\""
            :subset "test/python/corpora.edn" :failed-re "^  failed ([^ ]+) .*$"}}
  {:name pyi-check :mem-gib 4 :phase :full :chain python-full
   :cmd "bin/pyi check --corpus {part} {only}"
   :hosts [:stage0 :go :python] :never-loads [arbace.j2g] :pins ["test/python/corpora.edn"] :inputs [:lib-tools :tools :python :pyi]
   :parts [{:part language-core} {:part stdlib-tests} {:part lib-test-asyncio} {:part lib-test-all}]
   :summary ["methods:|classed|failing|regressions|control" 5]
   :rotate {:only "--only {list}" :universe "test/python/check-lib-test-linux-amd64.edn" :subset "test/python/corpora.edn"
            :id-re "^\\s*\\[\"([^\"]+)\" :[a-z-]+ \".*\" :([a-z-]+)\\]$" :failed-re "^   failing: (.+)$"}}
  {:name pyi-bench :mem-gib 3 :phase :full :chain python-full :cmd "bin/pyi bench"
   :hosts [:stage0 :go :python] :never-loads [arbace.j2g] :inputs [:lib-tools :tools :python :pyi]
   :parts [{:part pyperformance :clean-only true}] :summary ["benchmarks|classed|FAIL" 3]}
;;@ crops
         :python [pyi-aot-runtime python-front-essential pyi-aot-essential python-front pyi-check-aot pyi-check-aot-goi pyi-check pyi-bench]
;;@ controls
  python-front-essential {:waived "scope-check's and compile-check's own controls (PY7-check dc8aa6d1: classes.py's tree against functions.py's tables), built into the verbs"}
  pyi-aot-essential "test/python/controls.edn"
  python-front {:waived "as python-front-essential"}
  pyi-check-aot "test/python/controls.edn"
  pyi-check-aot-goi "test/python/controls.edn"
  pyi-check "test/python/controls.edn"
  pyi-bench {:waived "a speed record, no verdict of support"}

;; GT9 (doc/GATE-SURVEY.md, "As built: GT9 (write-ahead)"): Python's gate steps for merge plan batch P (mac/201-python-py7-py11);
;; queue 258: GT9's python.edn with queues 212, 213, 235, 240 and 247 in one file, the oracle tier in python-oracle.edn as OCaml's is
;; in ocaml-oracle.edn. Spliced into steps.edn as queue 317 did it (2026-11-17; its splice stayed off next, F1 (a): the records
;; first), by queue 428 (2026-11-19) after the read and print records, with python-oracle.edn:
;;   arbace_tool -p test -m gate.crops splice test/gate/steps.edn test/gate/crops/python.edn > .tmp/steps.edn && mv .tmp/steps.edn test/gate/steps.edn
;;   arbace_tool -p test -m gate.crops splice test/gate/steps.edn test/gate/crops/python-oracle.edn > .tmp/steps.edn && mv .tmp/steps.edn test/gate/steps.edn
;; less the steps that name a file only the records night writes (the planner refuses a pin or a universe that is no file, in
;; every mode): python-roundtrip, pyi-check-aot-goi and pyi-check wait in python-night.edn (the two check records), python-front, python-native
;; and python-records-verify in python-packs.edn (the pydump packs; queue 436's split), spliced the same way once the night's files are committed (seven of nine since queue 428 recorded test/python/{roundtrip,parse-check}-results.edn). :host-ids :python and :crop-pins :python are steps.edn's already (GT9).
;; Tiers (GTS215 (a), GTS216 (a), GTS218 (a)):
;;   - the essential chain python-essential: five light checks of at most 3 GiB, none on a toolchain host, no lock, about 92 s warm on
;;     the VM for the first four (16 + 10 + 41 + 25, queue 258); pyi's AOT runtime a :build step of its own (pyi-aot-runtime: cold,
;;     after a runtime change, the runtime printed and Go's compile of go/arbace/py, 3-4.5 min; warm seconds), so pyi-aot-essential
;;     runs on the cached runtime
;;   - --full: pyi-aot (check --aot judged by the golden texts and CPython's recorded runs, the wheels; light, beside the serial run
;;     at night, GTS216) and pyi-full (runtime check: above :night-concurrent's 4 GiB, serial); python-night.edn adds python-read (the
;;     read and print checks over the whole corpora, light, beside too), pyi on goi to pyi-aot and Lib/test by its own verdict to
;;     pyi-full
;;   - the oracle tier (python3, :python): test/gate/crops/python-oracle.edn
;; Every check names its family's negative control or a waiver (queue 235's inventory, doc/python/PYTHON-SURVEY.md, "As built:
;; 235"). :mem-gib: the VM's measures (arm64, busybox time -v, the gate's measure; queues 235 and 258), rounded up to the GiB with the
;; corpora's margin; GTS222's first two nights on amd64 replace them.
;;@ groups
  ;; repr/python's tools, the records (tools/pydump/records.bash over test/oracle-records/oracle.bash, records mode the default)
  :python ["bin/repr-python" "arbace/repr/python.ae" "arbace/repr/python/" "tools/pydump/" "test/python/" "test/oracle-records/oracle.bash"]
  ;; queue 489: lex-check's own reference, CPython's C tokenizer on Arbace's C (bin/pyi-clib exe pytokenizer: the committed node
  ;; program, cf2g, ci's back end printed by bin/ci cirun-build, TamaGo's go)
  :pytokenizer ["bin/pyi-clib" "tools/pyi/clib/pytokenizer/" "tools/pyi/clib/aot_text.ae" "go/arbace/clib/pytokenizer.ae"
                "go/arbace/clib/pytokenizer/" "arbace/c/cf2g.ae" "go/arbace/ci.ae" "go/arbace/ci/" "go/arbace/crt.ae" "go/arbace/crt/"
                "bin/ci" "bin/lib/ci/cirun-build" "tools/cirun/"]
  ;; pyi: the front end and the AOT (arbace/python), its runtime as Go forms (go/arbace/py and the packages aot_module prints with
  ;; it, all under :goi's go/), its C library's build (bin/pyi-clib, tools/pyi/clib), ssl's roots (x509roots/)
  :pyi ["bin/pyi" "bin/pyi-clib" "arbace/python.ae" "arbace/python/" "go/arbace/py.ae" "go/arbace/py/" "go/arbace/libm.ae" "go/arbace/libm/"
        "tools/pyi/" "x509roots/" :goi]
;;@ steps
  ;; ---- Python (PY6-PY11; GT9): pyi's AOT runtime, the essential chain, the chains python-read, pyi-aot and pyi-full at night
  ;; cold (a changed runtime, or an empty AOT cache) it prints the runtime and compiles go/arbace/py as Go (GOMAXPROCS 4, aot_go):
  ;; queue 258 on the VM (arm64), twice cold with an empty Go cache, 171 and 266 s, peak 4.0 GiB in one process (busybox time -v), the
  ;; tree's 4.7 GiB (MemAvailable's drop); queue 235's 13.5 GB was a Go cache past its trim. Warm about 1 GB, seconds. Not :heavy (below
  ;; 8 GiB); GTS222's amd64 nights measure it again
  {:name pyi-aot-runtime :phase :build :kind :build :mem-gib 6
   :cmd "bin/pyi check --aot --no-pyi --only samples/functions.py"
   :hosts [:stage0 :go] :inputs [:lib-tools :tools :pyi]}
  ;; the read and print levels on the essential corpora, from the committed records (test/python/records/essential/): the spec's
  ;; checklist, the samples, both round trips, the tokens and both trees of samples and lex-errors (queue 212; 240r: no python3 called)
  ;; queue 489: lex-check's reference the C tokenizer's harness, built by TamaGo's go when its key moves (VM, arm64: cf2g 100 s,
  ;; go build 580 s at 2.4 GiB; then kept by key, seconds)
  {:name python-read-essential :mem-gib 3 :phase :essential :chain python-essential :essential-when-changed :python
   :cmd "bin/repr-python spec-check && bin/repr-python samples && bin/repr-python roundtrip samples && bin/repr-python roundtrip --text samples && bin/repr-python lex-check --no-mutants samples lex-errors && bin/repr-python parse-check --full --no-mutants samples lex-errors"
   :hosts [:stage0 :go] :never-loads [arbace.j2g]
   :pins ["test/python/corpora.edn" "tools/pydump/PYTHON_VERSION" "test/python/records/python-pydump-samples.sha256"
          "test/python/records/python-pydump-lex-errors.sha256"]
   ;; queue 431: the round trip's levels 2 and 3 by pyi's own ast and compile load pyi's compiler
   :inputs [:lib-tools :tools :python :pytokenizer "arbace/python/compile.ae" "arbace/python/scope.ae" "arbace/python/ir.ae"]
   :summary ["files, 0 failing|^roundtrip|^lex-check|^parse-check|FAIL|control" 12]}
  ;; queue 258: pyi's front end and the programs' own verdict in one step (GT9's python-front-essential with queue 247's pyi-golden):
  ;; the generated ops/ (gen --check), the golden texts against their reviews, CPython's recorded runs and the awk models (golden),
  ;; scopes and code objects of samples, synthetic and errors (scope-check, compile-check --full); every verb's control is bin/pyi's
  {:name pyi-essential :mem-gib 2 :phase :essential :chain python-essential :essential-when-changed :python
   :cmd "bin/pyi gen --check && bin/pyi golden && bin/pyi universe --check && bin/pyi scope-check samples synthetic errors && bin/pyi compile-check --full samples synthetic errors"
   :hosts [:stage0] :never-loads [arbace.j2g]
   :pins ["test/python/corpora.edn" "tools/pydump/PYTHON_VERSION" "test/python/records/python-pydump-samples.sha256"
          "test/python/records/python-pydump-synthetic.sha256" "test/python/records/python-pydump-errors.sha256"]
   :inputs [:lib-tools :tools :python :pyi] :summary ["files, 0 failing|^golden|^universe|equal|differ|FAIL|control" 10]}
  ;; queue 265: the five runtime tables tools/pyi/*_table.py recorded from CPython's modules, made by Arbace from the pinned sources
  ;; (tools/pyi/runtime_tables.ae: the modules' C preprocessed by repr/c's preprocessor against musl's, Alpine's and Linux's headers),
  ;; byte for byte the printed runtime's, a control per table (no python3)
  {:name pyi-runtime-tables :mem-gib 2 :phase :essential :chain python-essential :essential-when-changed :python
   :cmd "bin/pyi runtime gen-tables"
   :hosts [:stage0 :go] :never-loads [arbace.j2g]
   :pins ["test/python/corpora.edn" "test/c/corpora.edn" "tools/pyi/header-apks.sha256"]
   ;; review 1111 #7: runtime_tables.ae slurps C's recorded predefines; the tarball's fetch runs bin/repr-python pins --fetch,
   ;; which reads test/python/corpora.edn (a pin) through test/python/corpora_rows.ae
   :inputs [:lib-tools :tools :pyi "test/c/host/predefined/" "bin/repr-python" "test/python/corpora_rows.ae"]
   :summary ["byte for byte|DIFFERS|control" 10]}
  ;; test/python/essential-aot.txt's 21 programs compiled and on the loop (not on goi: --no-pyi), judged by their golden texts and
  ;; CPython's recorded runs (queue 247), on the runtime pyi-aot-runtime keeps
  ;; queue 357: builtins_textsig_table.go from the tarball's C sources (tools/pyi/runtime_tables.ae textsig: every module's tables
  ;; preprocessed, about 2.5 minutes and 2 GB a run, its control a second run): --full, light
  {:name pyi-runtime-textsig :mem-gib 3 :phase :full :chain pyi-aot
   :cmd "bin/pyi runtime gen-tables textsig"
   :hosts [:stage0 :go] :never-loads [arbace.j2g]
   :pins ["test/python/corpora.edn" "test/c/corpora.edn" "tools/pyi/header-apks.sha256"]
   :inputs [:lib-tools :tools :pyi "bin/repr-python" "test/python/corpora_rows.ae"]
   :summary ["byte for byte|DIFFERS|control" 4]}
  {:name pyi-aot-essential :mem-gib 2 :phase :essential :chain python-essential :needs [pyi-essential pyi-aot-runtime] :essential-when-changed :python
   :cmd "bin/pyi check --aot --no-pyi --only-list test/python/essential-aot.txt"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/python/corpora.edn"] :inputs [:lib-tools :tools :python :pyi]
   :summary ["^check --aot:|^verdicts|classed|failing|negative control" 5]}
  ;; queue 206: arbace/python's and arbace/repr/python's namespaces compiled by c2j alone on stage 0, as c-c2j for C; :inputs as strace
  ;; on stage 0 found them (c-c2j's c2j closure); no :never-loads arbace.j2g: c2j's emit requires arbace.j2g.jrt and names
  {:name pyi-c2j :mem-gib 3 :phase :essential :chain python-essential :essential-when-changed :python
   :cmd "bin/pyi c2j-check"
   :hosts [:stage0]
   :inputs [:lib-base "bin/pyi" "arbace/python.ae" "arbace/python/" "arbace/repr/python.ae" "arbace/repr/python/" "test/python/c2j/"
            :c2j-runtime "arbace/c2j/" "arbace/j2g/jrt.ae" "arbace/j2g/names.ae" "arbace/classes/types.ae"
            "arbace/repr/go/print.ae" "arbace/repr/go/print_*.ae" "go/arbace/jrt/*.ae"]
   :summary ["^c2j-check: " 4]}
  ;; ---- pyi-aot (light, beside the serial run): the 151 programs compiled and on the loop (whole), pyi on goi over them (a seventh a
  ;; night over the night's record), the pinned wheels; judged by the programs' golden texts (127, queue 247) and CPython's recorded
  ;; runs (24 of ops/), the wheels' samples by CPython's recorded runs and pip's recorded layout (test/python/records/outcomes/wheels/)
  {:name pyi-check-aot :mem-gib 3 :phase :full :chain pyi-aot :needs [pyi-aot-runtime]
   :cmd "bin/pyi check --aot --no-pyi"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/python/corpora.edn"] :inputs [:lib-tools :tools :python :pyi]
   :parts [{:part light}] :summary ["^check --aot:|^verdicts|classed|failing|negative control|FAIL" 6]}
  ;; queues 205, 207: the pinned wheels installed by arbace.python.wheels and their samples on pyi; the wheels from the main
  ;; checkout's .tmp (GTS212); pip on pyi against CPython's pip (pip-probe) is the oracle tier's pyi-oracle
  {:name pyi-wheels :mem-gib 3 :phase :full :chain pyi-aot
   :cmd "bin/pyi wheels fetch && bin/pyi wheels check"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/python/wheels.edn" "test/python/corpora.edn"]
   :inputs [:lib-tools :tools :python :pyi] :summary ["^wheels |FAIL|control" 3]}
  ;; ---- pyi-full (serial: its steps above :night-concurrent's 4 GiB)
  ;; queue 235: bin/pyi runtime check (the smoke programs and REPL sessions against their recorded outcomes), its family's control
  ;; test/python/controls-runtime.edn (a smoke program's and a REPL session's run against another's outcome, smoke_controls)
  ;; on the gate's executable (DECISION 1 (a) of queue 321, as pyi-check-aot-goi)
  {:name pyi-runtime :mem-gib 5 :phase :full :chain pyi-full :needs [go-build]
   :cmd "env ARBACE_HOST_EXE=\"$GATE_EXE\" PYI_RUNTIME_REQUIRE=compiled bin/pyi runtime check"
   :hosts [:prog :stage0 :go] :never-loads [arbace.j2g] :pins ["test/python/corpora.edn"] :inputs [:lib-tools :tools :python :pyi]
   :summary ["^runtime: |^repl: |FAIL|^control" 12]}
;;@ crops
         :python [pyi-aot-runtime python-read-essential pyi-essential pyi-runtime-tables pyi-aot-essential pyi-c2j pyi-check-aot pyi-runtime-textsig pyi-wheels pyi-runtime]
;;@ controls
  python-read-essential "test/python/controls-read.edn"
  pyi-essential "bin/pyi"
  pyi-runtime-tables "bin/pyi"
  pyi-runtime-textsig "bin/pyi"
  pyi-aot-essential "arbace/python/aot.ae"
  pyi-c2j "test/python/c2j/pyi/c2j_control.ae"
  pyi-check-aot "arbace/python/aot.ae"
  pyi-wheels "bin/pyi"
  pyi-runtime "test/python/controls-runtime.edn"

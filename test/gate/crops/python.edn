;; GT9 (doc/GATE-SURVEY.md, "As built: GT9 (write-ahead)"): Python's gate steps for merge plan batch P (mac/201-python-py7-py11),
;; ready to splice the day after Python's records night (night 11, 2026-11-10/11; queue 258: GT9's python.edn with queues 212, 213,
;; 235, 240 and 247 in one file, the oracle tier in python-oracle.edn as OCaml's is in ocaml-oracle.edn). Apply, in a main checkout
;; with the branch merged and the night's records committed:
;;   arbace_tool -p test -m gate.crops splice test/gate/steps.edn test/gate/crops/python.edn > .tmp/steps.edn && mv .tmp/steps.edn test/gate/steps.edn
;;   arbace_tool -p test -m gate.crops splice test/gate/steps.edn test/gate/crops/python-oracle.edn > .tmp/steps.edn && mv .tmp/steps.edn test/gate/steps.edn
;; The night writes the files the planner needs (it refuses a pin or a universe that is no file): the packs' pins
;; test/python/records/python-pydump-{stdlib,site-packages,lib-test,mutants-lex,mutants-parse}.sha256 (bin/repr-python records
;; record stdlib site-packages lib-test mutants) and the rotations' universes test/python/{roundtrip,parse-check}-results.edn,
;; check-aot-linux-amd64.edn and check-lib-test-linux-amd64.edn (--record). Until then a splice plans with table errors naming
;; those nine files alone (queue 258's report). :host-ids :python and :crop-pins :python are steps.edn's already (GT9).
;; Tiers (GTS215 (a), GTS216 (a), GTS218 (a)):
;;   - the essential chain python-essential: four light checks of at most 3 GiB, none on a toolchain host, no lock; pyi's AOT runtime
;;     a :build step of its own (pyi-aot-runtime: cold, after a runtime change, Go's compile of go/arbace/py, :heavy under the big
;;     lock; warm seconds), so pyi-aot-essential runs on the cached runtime
;;   - --full: python-read (the read and print checks over the whole corpora, light: beside the serial run at night, GTS216),
;;     pyi-aot (check --aot judged by the golden texts and CPython's recorded runs, pyi on goi, the wheels; light, beside too) and
;;     pyi-full (runtime check and Lib/test by its own verdict: above :night-concurrent's 4 GiB, serial)
;;   - the oracle tier (python3, :python): test/gate/crops/python-oracle.edn
;; Every check names its family's negative control or a waiver (queue 235's inventory, doc/python/PYTHON-SURVEY.md, "As built:
;; 235"). :mem-gib: the VM's measures (arm64, busybox time -v, the gate's measure; queues 235 and 258), rounded up to the GiB with the
;; corpora's margin; GTS222's first two nights on amd64 replace them.
;;@ groups
  ;; repr/python's tools, the records (tools/pydump/records.bash over test/oracle-records/oracle.bash, records mode the default)
  :python ["bin/repr-python" "arbace/repr/python.ae" "arbace/repr/python/" "tools/pydump/" "test/python/" "test/oracle-records/oracle.bash"]
  ;; pyi: the front end and the AOT (arbace/python), its runtime as Go forms (go/arbace/py and the packages aot_module prints with
  ;; it, all under :goi's go/), its C library's build (bin/pyi-clib, tools/pyi/clib), ssl's roots (x509roots/)
  :pyi ["bin/pyi" "bin/pyi-clib" "arbace/python.ae" "arbace/python/" "go/arbace/py.ae" "go/arbace/py/" "go/arbace/libm.ae" "go/arbace/libm/"
        "tools/pyi/" "x509roots/" :goi]
;;@ steps
  ;; ---- Python (PY6-PY11; GT9): pyi's AOT runtime, the essential chain, the chains python-read, pyi-aot and pyi-full at night
  ;; queue 235: cold (a changed runtime, or an empty AOT cache) it compiles go/arbace/py as Go, 13.5 GB peak on the VM (5 min); queue
  ;; 258's cold measure is in its report; warm about 1 GB. Heavy: under the big lock, so that the essential chain after it is light
  {:name pyi-aot-runtime :phase :build :kind :build :mem-gib 14 :heavy true
   :cmd "bin/pyi check --aot --no-pyi --only samples/functions.py"
   :hosts [:stage0 :go] :inputs [:lib-tools :tools :pyi]}
  ;; the read and print levels on the essential corpora, from the committed records (test/python/records/essential/): the spec's
  ;; checklist, the samples, both round trips, the tokens and both trees of samples and lex-errors (queue 212; 240r: no python3 called)
  {:name python-read-essential :mem-gib 2 :phase :essential :chain python-essential
   :cmd "bin/repr-python spec-check && bin/repr-python samples && bin/repr-python roundtrip samples && bin/repr-python roundtrip --text samples && bin/repr-python lex-check --no-mutants samples lex-errors && bin/repr-python parse-check --full --no-mutants samples lex-errors"
   :hosts [:stage0] :never-loads [arbace.j2g]
   :pins ["test/python/corpora.edn" "tools/pydump/PYTHON_VERSION" "test/python/records/python-pydump-samples.sha256"
          "test/python/records/python-pydump-lex-errors.sha256"]
   :inputs [:lib-tools :tools :python] :summary ["files, 0 failing|^roundtrip|^lex-check|^parse-check|FAIL|control" 12]}
  ;; queue 258: pyi's front end and the programs' own verdict in one step (GT9's python-front-essential with queue 247's pyi-golden):
  ;; the generated ops/ (gen --check), the golden texts against their reviews, CPython's recorded runs and the awk models (golden),
  ;; scopes and code objects of samples, synthetic and errors (scope-check, compile-check --full); every verb's control is bin/pyi's
  {:name pyi-essential :mem-gib 2 :phase :essential :chain python-essential
   :cmd "bin/pyi gen --check && bin/pyi golden && bin/pyi scope-check samples synthetic errors && bin/pyi compile-check --full samples synthetic errors"
   :hosts [:stage0] :never-loads [arbace.j2g]
   :pins ["test/python/corpora.edn" "tools/pydump/PYTHON_VERSION" "test/python/records/python-pydump-samples.sha256"
          "test/python/records/python-pydump-synthetic.sha256" "test/python/records/python-pydump-errors.sha256"]
   :inputs [:lib-tools :tools :python :pyi] :summary ["files, 0 failing|^golden|equal|differ|FAIL|control" 10]}
  ;; test/python/essential-aot.txt's 21 programs compiled and on the loop (not on goi: --no-pyi), judged by their golden texts and
  ;; CPython's recorded runs (queue 247), on the runtime pyi-aot-runtime keeps
  {:name pyi-aot-essential :mem-gib 2 :phase :essential :chain python-essential :needs [pyi-essential pyi-aot-runtime]
   :cmd "bin/pyi check --aot --no-pyi --only-list test/python/essential-aot.txt"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/python/corpora.edn"] :inputs [:lib-tools :tools :python :pyi]
   :summary ["^check --aot:|^verdicts|classed|failing|negative control" 5]}
  ;; queue 206: arbace/python's and arbace/repr/python's namespaces compiled by c2j alone on stage 0, as c-c2j for C; :inputs as strace
  ;; on stage 0 found them (c-c2j's c2j closure); no :never-loads arbace.j2g: c2j's emit requires arbace.j2g.jrt and names
  {:name pyi-c2j :mem-gib 3 :phase :essential :chain python-essential
   :cmd "bin/pyi c2j-check"
   :hosts [:stage0]
   :inputs [:lib-base "bin/pyi" "arbace/python.ae" "arbace/python/" "arbace/repr/python.ae" "arbace/repr/python/" "test/python/c2j/"
            :c2j-runtime "arbace/c2j/" "arbace/j2g/jrt.ae" "arbace/j2g/names.ae" "arbace/classes/types.ae"
            "arbace/repr/go/print.ae" "arbace/repr/go/print_*.ae" "go/arbace/jrt/*.ae"]
   :summary ["^c2j-check: " 4]}
  ;; ---- python-read (light: each at most 2 GiB, no :needs on another chain's full step: beside the serial run at night, GTS216 (a)):
  ;; the front end over the big corpora (whole), the round trips and the tokens and trees (a seventh a night over the results files)
  {:name python-front :mem-gib 2 :phase :full :chain python-read
   :cmd "bin/pyi scope-check {part} && bin/pyi compile-check --full {part}"
   :hosts [:stage0] :never-loads [arbace.j2g]
   :pins ["test/python/corpora.edn" "test/python/records/python-pydump-stdlib.sha256" "test/python/records/python-pydump-site-packages.sha256"
          "test/python/records/python-pydump-lib-test.sha256"]
   :inputs [:lib-tools :tools :python :pyi]
   :parts [{:part stdlib} {:part site-packages} {:part lib-test}] :summary ["equal|not passing|FAIL|control" 4]}
  {:name python-roundtrip :mem-gib 2 :phase :full :chain python-read
   :cmd "bin/repr-python roundtrip {only} {part} && bin/repr-python roundtrip --text {only} {part}"
   :hosts [:stage0] :never-loads [arbace.j2g]
   :pins ["test/python/corpora.edn" "test/python/records/python-pydump-stdlib.sha256" "test/python/records/python-pydump-site-packages.sha256"
          "test/python/records/python-pydump-lib-test.sha256"]
   :inputs [:lib-tools :tools :python]
   :parts [{:part stdlib} {:part site-packages} {:part lib-test}] :summary ["^roundtrip|FAIL|control" 6]
   :rotate {:only "--only-list {list}" :universe "test/python/roundtrip-results.edn" :id-re "^\\[\"([^ \"]+) ([^\"]+)\"" :id-as "$1/$2"
            :subset "test/python/corpora.edn" :subset-key :subset-roundtrip :failed-re "^FAIL ([^[:cntrl:]]+)[[:cntrl:]].*$"
            :always ["stdlib/Lib/keyword.py" "stdlib/Lib/colorsys.py" "lib-test/Lib/test/test_keyword.py" "lib-test/Lib/test/test_colorsys.py"
                     "site-packages/usr/lib/python3.14/site-packages/packaging/_structures.py"
                     "site-packages/usr/lib/python3.14/site-packages/packaging/errors.py"]}}
  ;; queue 240: syntax-errors' cases are made by pyi (bin/pyi script tools/pydump/syntax_cases.py, compiled by pyi's AOT over the
  ;; runtime pyi-aot-runtime compiles) and judged by their own verdicts: TamaGo's go and the runtime's inputs
  {:name python-native :mem-gib 2 :phase :full :chain python-read :needs [pyi-aot-runtime]
   :cmd "bin/repr-python lex-check --no-mutants {only} {part} && bin/repr-python parse-check --full --no-mutants {only} {part}"
   :hosts [:stage0 :go] :never-loads [arbace.j2g]
   :pins ["test/python/corpora.edn" "test/python/records/python-pydump-stdlib.sha256" "test/python/records/python-pydump-site-packages.sha256"
          "test/python/records/python-pydump-lib-test.sha256" "test/python/records/python-pydump-syntax-errors.sha256"
          "test/python/records/python-pydump-mutants-lex.sha256" "test/python/records/python-pydump-mutants-parse.sha256"]
   :inputs [:lib-tools :tools :python :pyi]
   :parts [{:part stdlib} {:part site-packages} {:part lib-test} {:part lex-errors}
           {:part syntax-errors :cmd "bin/repr-python parse-check --no-mutants syntax-errors && bin/repr-python parse-check --full --no-mutants syntax-errors"}
           {:part mutants :clean-only true :cmd "bin/repr-python lex-check samples && bin/repr-python parse-check --full samples"}]
   :summary ["^lex-check|^parse-check|FAIL|control" 6]
   :rotate {:only "--only-list {list}" :universe "test/python/parse-check-results.edn" :id-re "^\\[\"([^ \"]+) ([^\"]+)\"" :id-as "$1/$2"
            :subset "test/python/corpora.edn" :subset-key :subset-native :failed-re "^FAIL ([^[:cntrl:]]+)[[:cntrl:]].*$"
            :always ["stdlib/Lib/keyword.py" "stdlib/Lib/colorsys.py" "lib-test/Lib/test/test_keyword.py" "lib-test/Lib/test/test_colorsys.py"
                     "site-packages/usr/lib/python3.14/site-packages/packaging/_structures.py"
                     "site-packages/usr/lib/python3.14/site-packages/packaging/errors.py"]}}
  ;; ---- pyi-aot (light, beside the serial run): the 151 programs compiled and on the loop (whole), pyi on goi over them (a seventh a
  ;; night over the night's record), the pinned wheels; judged by the programs' golden texts (127, queue 247) and CPython's recorded
  ;; runs (24 of ops/), the wheels' samples by CPython's recorded runs and pip's recorded layout (test/python/records/outcomes/wheels/)
  {:name pyi-check-aot :mem-gib 3 :phase :full :chain pyi-aot :needs [pyi-aot-runtime]
   :cmd "bin/pyi check --aot --no-pyi"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/python/corpora.edn"] :inputs [:lib-tools :tools :python :pyi]
   :parts [{:part light}] :summary ["^check --aot:|^verdicts|classed|failing|negative control|FAIL" 6]}
  ;; queue 235: pyi on goi over the same programs (the eval cell's beside source; 35 min whole on the VM), a seventh a night over the
  ;; record the night writes (test/python/check-aot-linux-amd64.edn), its subset test/python/gate-subsets.edn's :with-pyi
  {:name pyi-check-aot-goi :mem-gib 3 :phase :full :chain pyi-aot :needs [pyi-aot-runtime]
   :cmd "bin/pyi check --aot {only}"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/python/corpora.edn"] :inputs [:lib-tools :tools :python :pyi]
   :parts [{:part with-pyi}] :summary ["^check --aot:|^verdicts|classed|failing|negative control|FAIL" 6]
   :rotate {:only "--only-list {list}" :universe "test/python/check-aot-linux-amd64.edn" :id-re "^\\{:id \"([^\"]+)\""
            :subset "test/python/gate-subsets.edn" :failed-re "^  failed ([^ ]+) .*$"}}
  ;; queues 205, 207: the pinned wheels installed by arbace.python.wheels and their samples on pyi; the wheels from the main
  ;; checkout's .tmp (GTS212); pip on pyi against CPython's pip (pip-probe) is the oracle tier's pyi-oracle
  {:name pyi-wheels :mem-gib 3 :phase :full :chain pyi-aot
   :cmd "bin/pyi wheels fetch && bin/pyi wheels check"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/python/wheels.edn" "test/python/corpora.edn"]
   :inputs [:lib-tools :tools :python :pyi] :summary ["^wheels |FAIL|control" 3]}
  ;; ---- pyi-full (serial: its steps above :night-concurrent's 4 GiB)
  ;; queue 235: bin/pyi runtime check (the smoke programs and REPL sessions against their recorded outcomes), its family's control
  ;; test/python/controls-runtime.edn (a smoke program's and a REPL session's run against another's outcome, smoke_controls)
  {:name pyi-runtime :mem-gib 5 :phase :full :chain pyi-full
   :cmd "bin/pyi runtime check"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/python/corpora.edn"] :inputs [:lib-tools :tools :python :pyi]
   :summary ["^runtime: |^repl: |FAIL|^control" 12]}
  ;; queue 235: Lib/test by each test's own verdict (bin/pyi check, PY7; queue 234), a part a corpus, a seventh of each corpus's
  ;; modules a night over the record the night writes (test/python/check-lib-test-linux-amd64.edn): the :id-re's group 1 the
  ;; method's MODULE, group 2 its corpus, so a slice is whole modules (by method, the coverage subset's ids, with :slice-re, GTS243);
  ;; the subsets test/python/gate-subsets.edn's :subset-check; --only adds test/python/controls.edn's subjects to every slice. The
  ;; whole: 2h50 on the VM at 2 jobs (lib-test-all), language-core about 25 min; a seventh about 25 min. PYI_LIB_TEST_JOBS 2: :mem-gib
  ;; the two drivers and the judge
  {:name pyi-check :mem-gib 6 :phase :full :chain pyi-full :needs [pyi-aot-runtime]
   :cmd "bin/pyi check --corpus {part} {only}"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/python/corpora.edn"] :inputs [:lib-tools :tools :python :pyi]
   :parts [{:part language-core} {:part stdlib-tests} {:part lib-test-asyncio} {:part lib-test-all}]
   :summary ["methods:|classed|failing|regressions|control" 6]
   :rotate {:only "--only {list}" :universe "test/python/check-lib-test-linux-amd64.edn"
            :id-re "^\\s*\\[\"([^\"/]+)/[^\"]*\" :[a-z-]+ \".*\" :([a-z-]+)\\]$"
            :subset "test/python/gate-subsets.edn" :subset-key :subset-check :failed-re "^   failing: ([^/]+)/.*$"}}
;;@ crops
         :python [pyi-aot-runtime python-read-essential pyi-essential pyi-aot-essential pyi-c2j python-front python-roundtrip python-native
                  pyi-check-aot pyi-check-aot-goi pyi-wheels pyi-runtime pyi-check]
;;@ controls
  python-read-essential "test/python/controls-read.edn"
  pyi-essential "bin/pyi"
  pyi-aot-essential "arbace/python/aot.ae"
  pyi-c2j "test/python/c2j/pyi/c2j_control.ae"
  python-front "bin/pyi"
  python-roundtrip "test/python/controls-read.edn"
  python-native "test/python/controls-read.edn"
  pyi-check-aot "arbace/python/aot.ae"
  pyi-check-aot-goi "arbace/python/aot.ae"
  pyi-wheels "bin/pyi"
  pyi-runtime "test/python/controls-runtime.edn"
  pyi-check "test/python/controls.edn"

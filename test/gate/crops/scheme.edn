;; GT9 (doc/GATE-SURVEY.md, "As built: GT9 (write-ahead)"): Scheme's gate steps, scheme-sm9's (SM9, SC230-SC235) on GT8's planner and
;; GT9's tooling, for merge plan batch 1 (after scheme-sm9 and crop-controls). Splice as test/gate/crops/ocaml.edn says; in the merge
;; take next's side for bin/lib/gate-run.bash (sm9's gate_scheme_id is :host-ids :chez and :chibi, the same identities),
;; test/gate/audited-test.bash and gate-tests-test.bash, and sm9's steps.edn hunks but reap's (its :inputs gain "test/scheme/*.edn",
;; its :summary Scheme). GT9's changes to sm9's entries:
;;   - si-ecraven, si-mats: rotated by an :id-re of one group (bare names, as test/scheme/subsets.edn and bin/si's --only take them:
;;     SC233's record-ids extension superseded); si-ecraven runs at SI_TIMEOUT=300 as sm9's
;;   - the read and round-trip steps' controls (scheme-90: test/scheme/controls.edn, in place of crop-controls' test/scheme/repr-controls.edn); every step a control or a waiver
;;   - SC234's pins (Chez's boot files, Chibi's version, whimsical's tree) are :crop-pins :scheme's "bin/repr-scheme pins check" (NEW:
;;     until it exists the :host-ids :chez identity hashes the boot files; whimsical's tree is unchecked)
;;@ groups
  ;; Scheme's tools (SM9): repr/scheme and si's Arbace side evaluated from the checkout on stage 0, psyntax's forms and the libraries
  ;; (scheme/), the records and references (test/scheme/), Chez's dumper; the corpora the main checkout's .tmp/scheme/corpora (GTS212)
  :scheme ["bin/si" "bin/repr-scheme" "bin/oracle-records" "test/oracle-records/" "arbace/repr/scheme.ae" "arbace/repr/scheme/" "arbace/scheme/" "scheme/" "test/scheme/"
           "tools/schemedump/" "tools/psyntax/"]
  ;; si's runtime: go/arbace/scm and the light driver, printed by repr/go and built by TamaGo's go
  :scheme-run ["go/arbace/scm.ae" "go/arbace/scm/" "bin/build-go" "bin/lib/build-go/"]
;;@ steps
  ;; ---- Scheme (SM9; GT9): essential, two chains, about 1.7 min of wall (GTS215); full, the chain scheme-full beside the serial run
  ;; the crops tier: si's interpreted and compiled essential subsets as one step (one declaration before)
  {:name si-essential :mem-gib 2 :phase :essential :chain scheme-essential :essential-when-changed :scheme
   :cmd "bin/si unit && bin/si test --si && bin/si check --only test/scheme/essential-check.txt && bin/si r7rs && bin/si srfi && bin/si corpora controls-test && bin/si check --aot --only test/scheme/essential-aot.txt"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/scheme/corpora.edn"]
   :inputs [:lib-tools :tools :scheme :scheme-run]
   :summary ["^ok|programs pass|programs: the compiled|^r7rs:|^srfi:|regressions:|FAILING|control passed|control not" 14]}
  {:name scheme-read-essential :mem-gib 1 :phase :essential :chain scheme-read-essential :essential-when-changed :scheme
   :cmd "set -f; c='--corpus probes --corpus racket-r6rs --corpus larceny-r6rs --corpus chibi-r7rs --corpus srfi-*'; bin/repr-scheme check $c && bin/repr-scheme roundtrip $c && bin/repr-scheme spec-check && bin/si corpora files"
   ;; SCS2 (a), ORS12 (doc/ORACLE-RECORDS-SURVEY.md, "As built: Scheme"): Chez's dumps of the essential corpora from the committed subset
   ;; test/scheme/records/essential/ (no Chez; a dump whose inputs changed STALE, an unlisted one UNRECORDED: both fail)
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["test/scheme/corpora.edn"]
   :inputs [:lib-tools :tools :scheme]
   :summary ["^files and probes|^roundtrip:|^spec examples|files; |control|UNLISTED|GONE|SCAN|STALE|REFUSED|FAIL" 6]}
  {:name scheme-read :mem-gib 2 :phase :full :chain scheme-full
   :cmd "bin/repr-scheme check --corpus {part}"
   ;; SCS2 (a): Chez's dumps from the pack scheme-chez-dumps (no Chez; the oracle tier's scheme-records-verify checks them live)
   ;; SCS9 (c): the scans part regenerates the Unicode data from UCD 16.0.0 (test/scheme/ucd.edn, the main checkout's
   ;; .tmp/scheme/ucd-16.0.0) and compares, si's go/arbace/scm/unicode.ae among them
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["test/scheme/corpora.edn" "test/scheme/records/scheme-chez-dumps.sha256" "test/scheme/ucd.edn"]
   :inputs [:lib-tools :tools :scheme :scheme-run]
   ;; the 11-20 audit (doc/GATE-DIET-SURVEY.md, "As built: the 11-20 audit"): the parts probes, racket-r6rs, larceny-r6rs, chibi-r7rs and
   ;; srfi, scheme-read-essential's `bin/repr-scheme check` of those corpora, dropped; GDS28 (a) (the user, 2026-11-20): the five as
   ;; one part again, one process as the essential step's (84 s against 104 s of five), with its spec-check: scheme-read-essential subsumed
   :subsumes [scheme-read-essential]
   :parts [{:part corpora :cmd "bin/repr-scheme check --corpus probes --corpus racket-r6rs --corpus larceny-r6rs --corpus chibi-r7rs --corpus 'srfi-*' && bin/repr-scheme spec-check"}
           {:part scans :cmd "bin/repr-scheme ucd check && bin/repr-scheme check --corpus scans"} {:part whimsical}]
   :summary ["^files and probes|^scan |^ucd|choices-test|control|UNLISTED|GONE|SCAN|STALE|REFUSED" 5]}
  {:name scheme-roundtrip :mem-gib 2 :phase :full :chain scheme-full
   :cmd "bin/repr-scheme roundtrip --corpus {part}"
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["test/scheme/corpora.edn"]
   :inputs [:lib-tools :tools :scheme]
   ;; the 11-20 audit: as scheme-read's, the five corpora scheme-read-essential's `bin/repr-scheme roundtrip --corpus ...` runs as one part
   :subsumes [scheme-read-essential]
   :parts [{:part corpora :cmd "bin/repr-scheme roundtrip --corpus probes --corpus racket-r6rs --corpus larceny-r6rs --corpus chibi-r7rs --corpus 'srfi-*'"}
           {:part whimsical}]
   :summary ["^roundtrip:|control|FAIL" 3]}
  ;; GDS28 (a) (the user, 2026-11-20; doc/GATE-DIET-SURVEY.md, "As built: the 11-20 audit"): si-essential's `bin/si test --si` and
  ;; `bin/si unit` here (programs, unicode), so that si-check, si-aot and si-corpora check every case of si-essential
  {:name si-check :mem-gib 2 :phase :full :chain scheme-full
   :subsumes [si-essential]
   :cmd "bin/si check && bin/si test && bin/si test --si && bin/si fixpoint && bin/si check-suite && bin/si vendor verify && bin/si boot --check"
   ;; SCS20 (b), SCS21 (b): the Unicode scans as a part: si's answers to the two scans (every scalar value's (rnrs unicode), string-titlecase's
   ;; word breaks) against Chez 10.3.0's recorded ones (test/scheme/{unicode,wordbreak}-scan.edn: the digests; no Chez at check time), and
   ;; their negative control (a copy of the runtime with a generated table changed must differ in 8 and 1 lines), and SCS26 (b)'s
   ;; control of bin/si unit's TestWordBreakUAX29 (WB3c taken out: 9 positions must differ); about 4 minutes, 2 GiB
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/scheme/corpora.edn"]
   :inputs [:lib-tools :tools :scheme :scheme-run]
   :parts [{:part programs} {:part unicode :cmd "bin/si unit && bin/si unicode-scan && bin/si unicode-scan --control && bin/si unit --control"}]
   :summary ["programs pass|regressions:|FAILING|control passed|control not|of 6 of psyntax|expanded:|bootstrap gives|^unicode-scan|^unit --control" 10]}
  ;; GDS31 (a) (the user, 2026-11-20; doc/GATE-DIET-SURVEY.md, "As built: the 11-20 audit"): `bin/si check --aot` a rotated part (--only LIST, its subset test/scheme/subsets.edn's
  ;; :subset-aot by bin/gate-subsets crops, test/scheme/essential-aot.txt's programs kept), the suites a part run whole
  {:name si-aot :mem-gib 2 :phase :full :chain scheme-full :needs [si-check]
   ;; GDS28 (a): `bin/si check --aot` holds si-essential's `check --aot --only test/scheme/essential-aot.txt`, its subset too
   :subsumes [si-essential] :subsumes-cases {si-essential "test/scheme/essential-aot.txt"}
   :cmd "bin/si check --aot"
   :parts [{:part check
            :rotate {:only "--only {list}" :universe "test/scheme/check-aot-linux-amd64.edn" :id-re "^\\{:id \"([^\"]+)\""
                     :subset "test/scheme/subsets.edn" :subset-key :subset-aot :failed-re "^ +regress [a-z-]+ ([^ :]+):.*$"}}
           {:part suites :cmd "bin/si srfi --aot && bin/si r7rs --aot"}]
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/scheme/corpora.edn"]
   :inputs [:lib-tools :tools :scheme :scheme-run]
   :summary ["programs pass|programs: the compiled|regressions:|FAILING|^srfi:|^r7rs|^FAIL" 8]}
  ;; GDS28 (a) (the user, 2026-11-20; doc/GATE-DIET-SURVEY.md, "As built: the 11-20 audit"): `bin/si r7rs`, `bin/si srfi` and `bin/si corpora
  ;; files` here again (the 11-20 audit's first commit had left them to si-essential and scheme-read-essential), with si-essential's
  ;; `bin/si corpora controls-test`: the full tier holds every case of both, which it subsumes
  {:name si-corpora :mem-gib 1 :phase :full :chain scheme-full
   :subsumes [si-essential scheme-read-essential]
   :cmd "bin/si r7rs && bin/si r7rs --chibi-test && bin/si chibi-tests && bin/si srfi && bin/si corpora files && bin/si corpora controls-test && bin/si corpora divergences"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/scheme/corpora.edn"]
   :inputs [:lib-tools :tools :scheme :scheme-run]
   :summary ["^r7rs|^srfi:|regressions:|FAILING|files; |results pass" 8]}
  {:name si-ecraven :mem-gib 4 :phase :full :chain scheme-full
   :cmd "env SI_TIMEOUT=600 bin/si ecraven"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/scheme/corpora.edn"]
   :inputs [:lib-tools :tools :scheme :scheme-run]
   :parts [{:part ecraven}]
   :summary ["results pass|regressions:|FAILING|BAD RUN" 4]
   :rotate {:only "--only {list}" :universe "test/scheme/check-ecraven-linux-amd64.edn" :id-re "^\\{:id \"ecraven/([^\"]+)\""
            :subset "test/scheme/subsets.edn" :failed-re "^ +[A-Za-z]+ [a-z-]+ ecraven/([^ :]+).*$"}}
  ;; SCS32 (b) (the user, 2026-11-17, round 51): ecraven's benchmarks compiled (h-scheme's bin/si ecraven --aot), the weekly tier's alone
  ;; (58 Go builds and the slow benchmarks' limits, about 1.5 hours serial; each build and run under 2 GiB); judged against
  ;; test/scheme/check-ecraven-aot-linux-amd64.edn once the main host records it (before: no record, the classes alone)
  {:name si-ecraven-aot :mem-gib 2 :phase :weekly :chain scheme-full
   :cmd "env SI_TIMEOUT=300 bin/si ecraven --aot"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/scheme/corpora.edn"]
   :inputs [:lib-tools :tools :scheme :scheme-run]
   :summary ["results pass|regressions:|FAILING|BAD RUN" 4]}
  {:name si-mats :mem-gib 2 :phase :full :chain scheme-full
   :cmd "bin/si mats"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/scheme/corpora.edn"]
   :inputs [:lib-tools :tools :scheme :scheme-run]
   :parts [{:part mats}]
   :summary ["^mats:|regressions:|FAILING" 4]
   :rotate {:only "--only {list}" :universe "test/scheme/check-mats-linux-amd64.edn" :id-re "^\\{:id \"mats/([^\"]+)\""
            :subset "test/scheme/subsets.edn" :failed-re "^ +[A-Za-z]+ [a-z-]+ mats/([^ :]+).*$"}}
  ;; ---- Scheme's oracle tier (ORS1 (a), ORS8 (a), ORS12; doc/ORACLE-RECORDS-SURVEY.md "As built: Scheme"): the only Scheme step on :chez,
  ;; :phase :oracle (bin/gate --oracle), absent where the host lacks Chez, never in the essential gate, --full or the clean run, required at
  ;; a tag: Chez's dumps live against the pack scheme-chez-dumps (ORS6 (a): a moved Chez reported, not failed), with its crossed pair, a
  ;; sample a night (the whole at a tag's oracle run: `bin/oracle-records verify scheme`). The line's si-boot-oracle is not taken: since
  ;; SMR7b `bin/si boot --check` expands psyntax on si (si-check), no Chez; nor its Chibi records: Chibi's marks are the check's record (SCS1)
  {:name scheme-records-verify :mem-gib 2 :phase :oracle :chain scheme-oracle
   :cmd "bin/oracle-records verify scheme chez-dumps --sample 8"
   :hosts [:stage0 :chez] :never-loads [arbace.j2g] :pins ["test/scheme/corpora.edn" "test/scheme/records/scheme-chez-dumps.sha256"]
   :inputs [:lib-tools :tools :scheme]
   :summary ["^verify|FAIL|control" 12]}
;;@ crops
         :scheme [si-essential scheme-read-essential scheme-read scheme-roundtrip si-check si-aot si-corpora si-ecraven si-ecraven-aot si-mats scheme-records-verify]
;;@ controls
  si-essential [{:waived "the check's own negative controls, in test/scheme/essential-check.txt (SM9: control passed or control not judged fails the run)"} {:waived "the compiled level's controls, in test/scheme/essential-aot.txt (SM9)"}]
  scheme-read-essential "test/scheme/controls.edn"
  scheme-read "test/scheme/controls.edn"
  scheme-roundtrip "test/scheme/controls.edn"
  si-check {:waived "the check's own negative controls (SM9), the expander's fixpoint and the Unicode scans' own control (bin/si unicode-scan --control, SCS20 (b): a changed table must differ, else the part fails) and TestWordBreakUAX29's (bin/si unit --control, SCS26 (b): without WB3c exactly 9 positions must differ)"}
  si-aot {:waived "the compiled level's controls (SM9)"}
  si-corpora {:waived "R7RS, SRFI and Chibi's suites judged against their recorded references; no crossed pair yet (GT9.8: Proposed in \"As built: GTS81 (a), the crops' controls\")"}
  si-ecraven-aot {:waived "the ecraven family's negative controls, run by its judge (arbace.scheme.corpora ecraven, test/scheme/controls.edn) at --aot too"}
  si-ecraven {:waived "no crossed pair yet (GT9.8 \"Not covered\"; GTS242 proposes one before the rotation's first week)"}
  si-mats {:waived "no crossed pair yet (GT9.8 \"Not covered\"; GTS242)"}
  scheme-records-verify {:waived "the verify's own crossed pair (one unit's live dump against another's entry, which must differ: control passed or the verify fails)"}

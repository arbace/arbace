;; GT9 (doc/GATE-SURVEY.md, "As built: GT9 (write-ahead)"): Scheme's gate steps, scheme-sm9's (SM9, SC230-SC235) on GT8's planner and
;; GT9's tooling, for merge plan batch 1 (after scheme-sm9 and crop-controls). Splice as test/gate/crops/ocaml.edn says; in the merge
;; take next's side for bin/lib/gate-run.bash (sm9's gate_scheme_id is :host-ids :chez and :chibi, the same identities),
;; test/gate/audited-test.bash and gate-tests-test.bash, and sm9's steps.edn hunks but reap's (its :inputs gain "test/scheme/*.edn",
;; its :summary Scheme). GT9's changes to sm9's entries:
;;   - si-ecraven, si-mats: rotated by an :id-re of one group (bare names, as test/scheme/subsets.edn and bin/si's --only take them:
;;     SC233's record-ids extension superseded); si-ecraven runs at SI_TIMEOUT=300 as sm9's
;;   - the read and round-trip steps' controls (scheme-90: test/scheme/controls.edn, in place of crop-controls' test/scheme/repr-controls.edn); every step a control or a waiver
;;   - SC234's pins (Chez's boot files, Chibi's version, whimsical's tree) are :crop-pins :scheme's "bin/repr-scheme pins check" (NEW:
;;     until it exists the :host-ids :chez identity hashes the boot files; whimsical's tree is unchecked)
;;@ groups
  ;; Scheme's tools (SM9): repr/scheme and si's Arbace side evaluated from the checkout on stage 0, psyntax's forms and the libraries
  ;; (scheme/), the records and references (test/scheme/), Chez's dumper; the corpora the main checkout's .tmp/scheme/corpora (GTS212)
  :scheme ["bin/si" "bin/repr-scheme" "arbace/repr/scheme.ae" "arbace/repr/scheme/" "arbace/scheme/" "scheme/" "test/scheme/"
           "tools/schemedump/" "tools/psyntax/"]
  ;; si's runtime: go/arbace/scm and the light driver, printed by repr/go and built by TamaGo's go
  :scheme-run ["go/arbace/scm.ae" "go/arbace/scm/" "bin/build-go" "bin/lib/build-go/"]
;;@ steps
  ;; ---- Scheme (SM9; GT9): essential, two chains, about 1.7 min of wall (GTS215); full, the chain scheme-full beside the serial run
  {:name si-essential :mem-gib 2 :phase :essential :chain scheme-essential
   :cmd "bin/si unit && bin/si test --si && bin/si check --only test/scheme/essential-check.txt && bin/si r7rs && bin/si srfi"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/scheme/corpora.edn"]
   :inputs [:lib-tools :tools :scheme :scheme-run]
   :summary ["^ok|programs pass|^r7rs:|^srfi:|regressions:|FAILING|control passed|control not" 8]}
  {:name si-aot-essential :mem-gib 2 :phase :essential :chain scheme-essential :needs [si-essential]
   :cmd "bin/si check --aot --only test/scheme/essential-aot.txt"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/scheme/corpora.edn"]
   :inputs [:lib-tools :tools :scheme :scheme-run]
   :summary ["programs pass|programs: the compiled|regressions:|FAILING|control passed|control not" 6]}
  {:name scheme-read-essential :mem-gib 2 :phase :essential :chain scheme-read-essential
   :cmd "set -f; c='--corpus probes --corpus racket-r6rs --corpus larceny-r6rs --corpus chibi-r7rs --corpus srfi-*'; bin/repr-scheme check $c && bin/repr-scheme roundtrip $c && bin/repr-scheme spec-check && bin/si corpora files"
   :hosts [:stage0 :chez] :never-loads [arbace.j2g] :pins ["test/scheme/corpora.edn"]
   :inputs [:lib-tools :tools :scheme]
   :summary ["^files and probes|^roundtrip:|^spec examples|files; |control|UNLISTED|GONE|SCAN|FAIL" 6]}
  {:name scheme-read :mem-gib 2 :phase :full :chain scheme-full
   :cmd "bin/repr-scheme check --corpus {part}"
   :hosts [:stage0 :chez] :never-loads [arbace.j2g] :pins ["test/scheme/corpora.edn"]
   :inputs [:lib-tools :tools :scheme]
   :parts [{:part probes} {:part scans} {:part racket-r6rs} {:part larceny-r6rs} {:part chibi-r7rs} {:part whimsical}
           {:part srfi :cmd "bin/repr-scheme check --corpus 'srfi-*'"}]
   :summary ["^files and probes|^scan |control|UNLISTED|GONE|SCAN" 4]}
  {:name scheme-roundtrip :mem-gib 2 :phase :full :chain scheme-full
   :cmd "bin/repr-scheme roundtrip --corpus {part}"
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["test/scheme/corpora.edn"]
   :inputs [:lib-tools :tools :scheme]
   :parts [{:part probes} {:part racket-r6rs} {:part larceny-r6rs} {:part chibi-r7rs} {:part whimsical}
           {:part srfi :cmd "bin/repr-scheme roundtrip --corpus 'srfi-*'"}]
   :summary ["^roundtrip:|control|FAIL" 3]}
  {:name si-check :mem-gib 2 :phase :full :chain scheme-full
   :cmd "bin/si check && bin/si test && bin/si fixpoint && bin/si check-suite && bin/si vendor verify && bin/si boot --check"
   :hosts [:stage0 :go :chez] :never-loads [arbace.j2g] :pins ["test/scheme/corpora.edn"]
   :inputs [:lib-tools :tools :scheme :scheme-run]
   :summary ["programs pass|regressions:|FAILING|control passed|control not|of 6 of psyntax|expanded:|bootstrap gives" 8]}
  {:name si-aot :mem-gib 2 :phase :full :chain scheme-full :needs [si-check]
   :cmd "bin/si check --aot && bin/si srfi --aot"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/scheme/corpora.edn"]
   :inputs [:lib-tools :tools :scheme :scheme-run]
   :summary ["programs pass|programs: the compiled|regressions:|FAILING|^srfi --aot|^FAIL" 6]}
  {:name si-corpora :mem-gib 2 :phase :full :chain scheme-full
   :cmd "bin/si r7rs && bin/si r7rs --chibi-test && bin/si chibi-tests && bin/si srfi && bin/si corpora files && bin/si corpora divergences"
   :hosts [:stage0 :go :chibi] :never-loads [arbace.j2g] :pins ["test/scheme/corpora.edn"]
   :inputs [:lib-tools :tools :scheme :scheme-run]
   :summary ["^r7rs|^srfi:|regressions:|FAILING|files; |results pass" 8]}
  {:name si-ecraven :mem-gib 2 :phase :full :chain scheme-full
   :cmd "env SI_TIMEOUT=300 bin/si ecraven"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/scheme/corpora.edn"]
   :inputs [:lib-tools :tools :scheme :scheme-run]
   :parts [{:part ecraven}]
   :summary ["results pass|regressions:|FAILING|BAD RUN" 4]
   :rotate {:only "--only {list}" :universe "test/scheme/check-ecraven-linux-amd64.edn" :id-re "^\\{:id \"ecraven/([^\"]+)\""
            :subset "test/scheme/subsets.edn" :failed-re "^ +[A-Za-z]+ [a-z-]+ ecraven/([^ :]+).*$"}}
  {:name si-mats :mem-gib 2 :phase :full :chain scheme-full
   :cmd "bin/si mats"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/scheme/corpora.edn"]
   :inputs [:lib-tools :tools :scheme :scheme-run]
   :parts [{:part mats}]
   :summary ["^mats:|regressions:|FAILING" 4]
   :rotate {:only "--only {list}" :universe "test/scheme/check-mats-linux-amd64.edn" :id-re "^\\{:id \"mats/([^\"]+)\""
            :subset "test/scheme/subsets.edn" :failed-re "^ +[A-Za-z]+ [a-z-]+ mats/([^ :]+).*$"}}
;;@ crops
         :scheme [si-essential si-aot-essential scheme-read-essential scheme-read scheme-roundtrip si-check si-aot si-corpora si-ecraven si-mats]
;;@ controls
  si-essential {:waived "the check's own negative controls, in test/scheme/essential-check.txt (SM9: control passed or control not judged fails the run)"}
  si-aot-essential {:waived "the compiled level's controls, in test/scheme/essential-aot.txt (SM9)"}
  scheme-read-essential "test/scheme/controls.edn"
  scheme-read "test/scheme/controls.edn"
  scheme-roundtrip "test/scheme/controls.edn"
  si-check {:waived "the check's own negative controls (SM9) and the expander's fixpoint"}
  si-aot {:waived "the compiled level's controls (SM9)"}
  si-corpora {:waived "R7RS, SRFI and Chibi's suites judged against their recorded references; no crossed pair yet (GT9.8: Proposed in \"As built: GTS81 (a), the crops' controls\")"}
  si-ecraven {:waived "no crossed pair yet (GT9.8 \"Not covered\"; GTS242 proposes one before the rotation's first week)"}
  si-mats {:waived "no crossed pair yet (GT9.8 \"Not covered\"; GTS242)"}

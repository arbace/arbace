;; cpp-indep (CP240 (a), CP241 (b); doc/cpp/CPP-SURVEY.md, "As built: cpp-indep"): C++'s oracle tier, the steps that run the host's
;; clang++ and g++ (the host :cxx) now that the run checks read clang's IR from the packs (test/cpp/records/) and the readers read
;; libstdc++'s headers from the tree made without g++ (bin/repr-cpp target). They wait here for the planner's :phase :oracle (bin/gate
;; --oracle, mac/oracle-records-cpp2's ORS1 (a), ORS8 (a)), as test/gate/crops/ocaml-oracle.edn does: splice this fragment after that
;; branch's merge. cpp-check-oracle runs the run checks live (CPPI_LIVE=1: clang++'s IR made afresh) with the sampling whose pack is the
;; night's; cpp-records-verify compares the packs with the live toolchain (a moved toolchain reported, not failed: ORS6 (a)); cpp-target-oracle
;; compares the tree with the installed headers file for file and runs the token check on the host's headers as before.
;;@ steps
  {:name cpp-check-oracle :mem-gib 3 :phase :oracle :chain cpp-full
   :cmd "env CPPI_LIVE=1 CPPI_THREADS=2 CPPI_CI_MEMLIMIT=4GiB bin/cppi check {part}"
   :hosts [:stage0 :go :cxx :gcc] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn"]
   :inputs [:lib-tools :tools :cpp :c :c-run]
   :parts [{:part samples-runtime :cmd "env CPPI_LIVE=1 CPPI_THREADS=2 CPPI_CI_MEMLIMIT=4GiB bin/cppi check"}
           {:part gxx-dg-run-every-25 :cmd "env CPPI_LIVE=1 CPPI_THREADS=2 CPPI_CI_MEMLIMIT=4GiB bin/cppi check --corpus gxx-dg-run --sample 25"}
           {:part aot-gxx-dg-run-every-25 :cmd "env CPPI_LIVE=1 CPPI_THREADS=2 CPPI_CI_MEMLIMIT=4GiB bin/cppi check --aot --corpus gxx-dg-run --sample 25"}]
   :summary ["programs:|REGRESSION|control|FAIL" 4]}
  {:name cpp-records-verify :mem-gib 2 :phase :oracle :chain cpp-full
   :cmd "bin/oracle-records verify cpp ir runtime-ir --sample 8"
   :hosts [:stage0 :cxx :gcc] :never-loads [arbace.j2g]
   :pins ["test/cpp/corpora.edn" "test/cpp/records/cpp-ir-samples.sha256" "test/cpp/records/cpp-runtime-ir.sha256"]
   :inputs [:lib-tools :tools :cpp]
   :summary ["verify|crossed|moved|FAIL" 4]}
  {:name cpp-target-oracle :mem-gib 2 :phase :oracle :chain cpp-full
   :cmd "bin/repr-cpp target oracle && bin/repr-cpp host check && env REPR_CPP_HEADERS=host bin/repr-cpp pp-check --essential"
   :hosts [:stage0 :cxx] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn" "test/c/corpora.edn"]
   :inputs [:lib-tools :tools :cpp :c]
   :summary ["oracle:|files,|failing|FAIL" 4]}
  ;; ORS12 (a) (mac/oracle-records-cpp, batch 4): the selftests that run a compiler or an LLVM tool (test/cpp/selftest/toolchain.txt)
  {:name cpp-selftest-oracle :mem-gib 3 :phase :oracle :chain cpp-full
   :cmd "bin/cppi selftest --toolchain"
   :hosts [:stage0 :go :cxx :gcc] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn"]
   :inputs [:lib-tools :tools :cpp :c]
   :summary ["tests?,|pass|fail|FAIL" 4]}
  ;; ORS27, ORS28 (b) (mac/oracle-records-cpp2, batch 4): the lowering with clang's IR made afresh and gcc compiling and running the lowered C
  ;; (CPPI_LIVE=1), and the libstdcxx sampling whose IR pack is the night's
  {:name cpp-lower-oracle :mem-gib 3 :phase :oracle :chain cpp-full :needs [cpp-runtime]
   :cmd "env CPPI_LIVE=1 bin/cppi lower-corpus {part}"
   :hosts [:stage0 :cxx :gcc] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn"]
   :inputs [:lib-tools :tools :cpp :c]
   :parts [{:part essential :cmd "env CPPI_LIVE=1 bin/cppi lower-essential"} {:part samples} {:part libstdcxx-every-15th}]
   :summary ["^lower-check|pass|failing|FAIL" 4]}
;;@ crops
         :cpp-oracle [cpp-check-oracle cpp-records-verify cpp-target-oracle cpp-selftest-oracle cpp-lower-oracle]
;;@ controls
  cpp-check-oracle "test/cpp/controls.edn"
  cpp-records-verify {:waived "the packs' verify prints its crossed pair (one program's live IR against another's record: must differ, ORS7 (a))"}
  cpp-lower-oracle "test/cpp/controls.edn"
  cpp-selftest-oracle {:waived "the checks' own tests: each a negative case (review 007's)"}
  cpp-target-oracle {:waived "a file-for-file byte comparison of two trees, no judge to cross; the token check's own controls run in it"}

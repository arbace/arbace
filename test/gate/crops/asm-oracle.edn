;; AX10 (the user, 2026-11-10; doc/asm/AMD64-SURVEY.md "As built: AX10"): the assembly crops' oracle tier, the steps that run the
;; host's LLVM 23.1.5 tools (the host :llvm-mc: llvm-mc, llvm-tblgen, ld.lld), by hand at a tag (bin/gate --oracle), never in the
;; essential gate, --full or the clean run: amd64's printer against llvm-mc file by file (print-oracle), amd64's and arm64's tables
;; against llvm-tblgen's -print-records (table oracle; every part runs, any difference fails), and the run check's objects linked by
;; ld.lld, the two executables compared at the canonical level (link-oracle). The object check's record (llvm-mc's objects,
;; test/asm/records/) is re-recorded by hand only (bin/repr-asm object-record CORPUS): a recording, not a check. Spliced into
;; test/gate/steps.edn by gate.crops splice.
;;@ steps
  {:name asm-amd64-print-oracle :mem-gib 2 :phase :oracle :chain asm-oracle
   :cmd "bin/repr-asm corpus ensure && bin/repr-asm print-oracle"
   :hosts [:stage0 :llvm-mc] :never-loads [arbace.j2g] :pins ["test/asm/corpora.edn"]
   :inputs [:lib-tools :tools :asm]
   :summary ["^repr-asm print-oracle: [0-9]|^FAIL" 4]}
  {:name asm-amd64-table-oracle :mem-gib 3 :phase :oracle :chain asm-oracle :needs [asm-amd64-print-oracle]
   :cmd "bin/repr-asm table oracle"
   :hosts [:stage0 :llvm-mc] :never-loads [arbace.j2g] :pins ["test/asm/corpora.edn"]
   :inputs [:lib-tools :tools :asm]
   :summary ["^repr-asm table oracle|^FAIL" 6]}
  {:name asm-amd64-link-oracle :mem-gib 2 :phase :oracle :chain asm-oracle :needs [asm-amd64-table-oracle]
   :cmd "bin/repr-asm run-check && bin/repr-asm link-oracle"
   :hosts [:stage0 :llvm-mc] :never-loads [arbace.j2g] :pins ["test/asm/corpora.edn"]
   :inputs [:lib-tools :tools :asm]
   :summary ["run exit|refuses|^FAIL" 6]}
  {:name asm-arm64-table-oracle :mem-gib 3 :phase :oracle :chain asm-oracle :needs [asm-amd64-link-oracle]
   :cmd "bin/repr-asm --arch arm64 table oracle"
   :hosts [:stage0 :go :llvm-mc] :never-loads [arbace.j2g] :pins ["test/asm/corpora.edn"]
   :inputs [:lib-tools :tools :asm]
   :summary ["^repr-asm table oracle|^FAIL" 6]}
;;@ crops
         :asm-amd64 [asm-amd64-print-oracle asm-amd64-table-oracle asm-amd64-link-oracle]
         :asm-arm64 [asm-arm64-table-oracle]
;;@ controls
  asm-amd64-print-oracle {:waived "the oracle tier's comparison of the printer's lines with the host's llvm-mc, file by file; the check level's controls are encode-check's (test/asm/controls-print.txt)"}
  asm-amd64-table-oracle {:waived "the oracle tier's comparison of the table with llvm-tblgen's records row by row; no case to cross"}
  asm-amd64-link-oracle {:waived "the oracle tier's comparison with ld.lld's executables; the run check's controls are test/asm/controls-run.txt"}
  asm-arm64-table-oracle {:waived "the oracle tier's comparison of the table with llvm-tblgen's records; no case to cross"}

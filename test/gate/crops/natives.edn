;; GT9 (doc/GATE-SURVEY.md, "As built: GT9 (write-ahead)"): merge plan batch 3 (ocaml-native and its errors line, crop-controls-ocaml;
;; rust-native and its line, crop-controls-rust): the two native readers' checks. Splice after crops/ocaml.edn and crops/llvm-rust.edn.
;; Each native-check reads its committed list (OCaml's samples and lists, Rust's test/rust/native-check.txt) whole; the corpus-wide
;; runs with --list and ids (GT9.4's `{only}` and *-ids.edn) are NEW (GTS223), until then the stdlib and compiler-sources parts
;; (48 s, 118 s) and Rust's list (45 s). GT9.4's ocaml-read-essential addition (menhir --check, native-check samples) goes into
;; the essential chain here as its own step
;;@ steps
  {:name ocaml-native-essential :mem-gib 2 :phase :essential :chain ocaml-read-essential :needs [ocaml-read-essential]
   :cmd "bin/repr-ocaml menhir --check && bin/repr-ocaml native-check samples"
   :hosts [:stage0 :ocaml] :never-loads [arbace.j2g] :pins ["test/ocaml/corpora.edn"] :inputs [:lib-base :lib-tools :tools :ocaml]
   :summary ["menhir|equal|differ|rejected|control|FAIL" 4]}
  {:name ocaml-native :mem-gib 2 :phase :full :chain ocaml-full
   :cmd "bin/repr-ocaml native-check {part}"
   :hosts [:stage0 :ocaml] :never-loads [arbace.j2g] :pins ["test/ocaml/corpora.edn"] :inputs [:lib-base :lib-tools :tools :ocaml]
   :parts [{:part stdlib} {:part compiler-sources} {:part testsuite :clean-only true}]
   :summary ["equal|differ|rejected|control|FAIL" 4]}
  {:name rust-native-essential :mem-gib 2 :phase :oracle :chain rust-oracle
   :cmd "bin/repr-rust native-check test/rust/sample/*.rs"
   :hosts [:stage0 :rustc] :never-loads [arbace.j2g] :inputs [:lib-tools :tools :rust]
   :summary ["equal|differ|control|FAIL" 3]}
  {:name rust-native :mem-gib 2 :phase :oracle :chain rust-oracle
   :cmd "bin/repr-rust native-check"
   :hosts [:stage0 :rustc] :never-loads [arbace.j2g] :inputs [:lib-tools :tools :rust]
   :summary ["equal|differ|control|FAIL" 3]}
;;@ crops
         :ocaml [ocaml-native-essential ocaml-native]
         :rust [rust-native-essential rust-native]
;;@ controls
  ocaml-native-essential "test/ocaml/native-controls.txt"
  ocaml-native "test/ocaml/native-controls.txt"
  rust-native-essential "test/rust/native-controls.txt"
  rust-native "test/rust/native-controls.txt"

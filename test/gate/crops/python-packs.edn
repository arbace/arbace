;; queue 436 (2026-11-19): Python's three steps whose runs read the records night's pydump packs (CPython's dumps, class B of
;; tools/pydump/records.bash), split from python-night.edn (queue 317's six held steps): gate.plan's table check refuses a pin
;; that is no file in every mode. Each part pins the pack its run reads in records mode (pyrec_dump: bin/pyi scope-check reads a
;; corpus's tree/ and scopes/ members, compile-check --full its full/, bin/repr-python lex-check its tok/, parse-check --full its
;; tree/ and full/; the mutants part the checks' own generated corpora's packs mutants-lex and mutants-parse), the step's pins
;; what every part reads. The packs, recorded by hand on the main host (ORS5 (a): a commit of its own naming :python's identity;
;; whole corpora, CPython 3.14.10 over about 2,800 files in five verbs and pyi's scope and compile checks):
;;   REPR_PYTHON_ORACLE=record bin/repr-python records record stdlib site-packages lib-test mutants
;; writes test/python/records/python-pydump-{stdlib,site-packages,lib-test,mutants-lex,mutants-parse}.{sha256,tsv} and the packs
;; into the main checkout's .tmp/oracle-packs/ (push them to the mirror: bin/oracle-records); python-records-verify's outcomes part
;; also needs the outcomes the night has not recorded (smoke/, repl/, wheels/: REPR_PYTHON_ORACLE=record bin/repr-python records
;; record outcomes), else its verify counts them as differing under the records' own identity. Apply, with the pins committed:
;;   arbace_tool -p test -m gate.crops splice test/gate/steps.edn test/gate/crops/python-packs.edn > .tmp/steps.edn && mv .tmp/steps.edn test/gate/steps.edn
;; (after python-night.edn's or before: python-front and python-native join the chain python-read, python-records-verify the oracle
;; tier's chain python-oracle).
;;@ steps
  ;; ---- python-read: the front end over the big corpora (whole) and the tokens and trees (a seventh a night over the results file)
  {:name python-front :mem-gib 2 :phase :full :chain python-read
   :cmd "bin/pyi scope-check {part} && bin/pyi compile-check --full {part}"
   :hosts [:stage0] :never-loads [arbace.j2g]
   :pins ["test/python/corpora.edn"]
   :inputs [:lib-tools :tools :python :pyi]
   :parts [{:part stdlib :pins ["test/python/records/python-pydump-stdlib.sha256"]}
           {:part site-packages :pins ["test/python/records/python-pydump-site-packages.sha256"]}
           {:part lib-test :pins ["test/python/records/python-pydump-lib-test.sha256"]}]
   :summary ["equal|not passing|FAIL|control" 4]}
  ;; queue 240: syntax-errors' cases are made by pyi (bin/pyi script tools/pydump/syntax_cases.py, compiled by pyi's AOT over the
  ;; runtime pyi-aot-runtime compiles) and judged by their own verdicts: TamaGo's go and the runtime's inputs
  {:name python-native :mem-gib 2 :phase :full :chain python-read :needs [pyi-aot-runtime]
   :cmd "bin/repr-python lex-check --no-mutants {only} {part} && bin/repr-python parse-check --full --no-mutants {only} {part}"
   :hosts [:stage0 :go] :never-loads [arbace.j2g]
   :pins ["test/python/corpora.edn"]
   :inputs [:lib-tools :tools :python :pyi]
   :parts [{:part stdlib :pins ["test/python/records/python-pydump-stdlib.sha256"]}
           {:part site-packages :pins ["test/python/records/python-pydump-site-packages.sha256"]}
           {:part lib-test :pins ["test/python/records/python-pydump-lib-test.sha256"]}
           {:part lex-errors :pins ["test/python/records/python-pydump-lex-errors.sha256"]}
           {:part syntax-errors :pins ["test/python/records/python-pydump-syntax-errors.sha256"]
            :cmd "bin/repr-python parse-check --no-mutants syntax-errors && bin/repr-python parse-check --full --no-mutants syntax-errors"}
           {:part mutants :clean-only true
            :pins ["test/python/records/python-pydump-mutants-lex.sha256" "test/python/records/python-pydump-mutants-parse.sha256"]
            :cmd "bin/repr-python lex-check samples && bin/repr-python parse-check --full samples"}]
   :summary ["^lex-check|^parse-check|FAIL|control" 6]
   :rotate {:only "--only-list {list}" :universe "test/python/parse-check-results.edn" :id-re "^\\[\"([^ \"]+) ([^\"]+)\"" :id-as "$1/$2"
            :subset "test/python/corpora.edn" :subset-key :subset-native :failed-re "^FAIL ([^[:cntrl:]]+)[[:cntrl:]].*$"
            :always ["stdlib/Lib/keyword.py" "stdlib/Lib/colorsys.py" "lib-test/Lib/test/test_keyword.py" "lib-test/Lib/test/test_colorsys.py"
                     "site-packages/usr/lib/python3.14/site-packages/packaging/_structures.py"
                     "site-packages/usr/lib/python3.14/site-packages/packaging/errors.py"]}}
  {:name python-records-verify :mem-gib 2 :phase :oracle :chain python-oracle
   :cmd "bin/repr-python records verify {part}"
   :hosts [:stage0 :go :python] :never-loads [arbace.j2g]
   :pins ["test/python/corpora.edn" "tools/pydump/PYTHON_VERSION"]
   :inputs [:lib-tools :tools :python :pyi]
   :parts [{:part essential :cmd "bin/repr-python records verify samples synthetic errors lex-errors syntax-errors"
            :pins ["test/python/records/python-pydump-samples.sha256" "test/python/records/python-pydump-synthetic.sha256"
                   "test/python/records/python-pydump-errors.sha256" "test/python/records/python-pydump-lex-errors.sha256"
                   "test/python/records/python-pydump-syntax-errors.sha256"]}
           {:part stdlib :cmd "bin/repr-python records verify --sample 64 stdlib" :pins ["test/python/records/python-pydump-stdlib.sha256"]}
           {:part site-packages :cmd "bin/repr-python records verify --sample 64 site-packages"
            :pins ["test/python/records/python-pydump-site-packages.sha256"]}
           {:part lib-test :cmd "bin/repr-python records verify --sample 64 lib-test" :pins ["test/python/records/python-pydump-lib-test.sha256"]}
           {:part mutants :pins ["test/python/records/python-pydump-mutants-lex.sha256" "test/python/records/python-pydump-mutants-parse.sha256"]}
           {:part outcomes}]
   :summary ["^verify|^records|FAIL|control" 12]}
;;@ crops
         :python [python-front python-native python-records-verify]
;;@ controls
  python-front "bin/pyi"
  python-native "test/python/controls-read.edn"
  python-records-verify {:waived "the verifies' own crossed pairs (one file's live dump, or one outcome's live run, against another's record, which must differ: control passed or the verify fails; tools/pydump/records.bash)"}

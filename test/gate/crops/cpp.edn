;; GT9 (doc/GATE-SURVEY.md, "As built: GT9 (write-ahead)"): C++'s gate steps, cpp-cx10's (CX10, CP180-CP184) with cpp-cx8's run and
;; compiled levels and cpp-cx9's dg check, on GT8's planner and GT9's tooling, for merge plan batch 1 (after cpp-cx8, cpp-cx9,
;; cpp-cx10 and crop-controls). Splice as test/gate/crops/ocaml.edn says; in the merge take next's side for bin/lib/gate-run.bash
;; (cx10's gate_cxx_id is :host-ids :cxx, the same identity) and cx10's steps.edn hunks but reap's (its :inputs gain "test/cpp/*.edn",
;; its :summary C\+\+), which stay. GT9's changes to cx10's entries:
;;   - cpp-runtime, a :build step (GTS215): the lowered runtime (4-5 min when stale) and ci's library out of the essential chain's wall
;;   - cpp-check-essential, cpp-check, cpp-aot: cx8's levels on the samples and the runtime (14 programs, the records' rows); the
;;     libstdcxx and gxx-dg-run parts wait for their subsets (CP181, GTS205: the whole libstdcxx is about 23 h on ci)
;;   - cpp-dg: cx9's three corpora, whole (dg-error about 6 min, preprocess under 30 s; modules, about 3 min, :clean-only)
;;   - cpp-roundtrip-dg (gxx-dg-every-10, about 8 min) and cpp-lower's libstdcxx-every-15th (about 16 min) are rotated; the lowering's is a
;;     :clean-only part (its rotation costs 4-5 min a night: remove :clean-only to run it nightly, GTS246); --only-list FILE on
;;     roundtrip-corpus and lower-corpus (gt9v-cpp, on cpp-cx10), :subset-roundtrip and :subset-lower in test/cpp/subsets.edn (by hand, proxies:
;;     GTS205's blocks need a cover build of the lowering and repr/cpp), the records' ids as the universes (roundtrip-results/gxx-dg-every-10.edn,
;;     lower-results.edn); until the subsets (GTS205) the compiled level's runtime programs and dg's modules stay :clean-only (cx8's and cx9's
;;     verbs, not on cpp-cx10); GT9's estimate about 28 min nightly against 24.3 (GTS222 measures it)
;;   - the round trip's controls (crop-controls: test/repr/cpp/roundtrip-controls.edn); every step a control or a waiver
;; Not here: native-check (cpp-native, batch 5: crops/cpp-native.edn); the rotation of cx8's and cx9's levels (their --only is on cpp-cx8 and
;; cpp-cx9 and their records are one-row-a-line only there: CP181 (a)); the essential lists of ci (test/cpp/essential-check.txt, NEW)
;;@ groups
  ;; C++'s tools (CX10): repr/cpp, repr/llvm and the lowering evaluated from the checkout on stage 0, cxxdump (clang's AST, the
  ;; oracle), the records (test/cpp/, test/repr/cpp/); g++ and clang++ are the host :cxx, gcc :gcc
  ;; cpp-indep (CP240 (a), CP241 (b)): the IR packs' tooling (test/oracle-records/) and libstdc++'s tree made without g++ (cpp/target/,
  ;; test/cpp/target.ae over C's sysroot, bin/lib/repr-c/sysroot.bash); the packs' pins test/cpp/records/*.sha256 are under test/cpp/
  :cpp ["cpp/" "bin/lib/crops/musl-hold.bash" "bin/lib/limit.bash" "test/oracle-records/" "bin/lib/repr-c/sysroot.bash" "bin/repr-cpp" "bin/lib/repr-cpp/" "bin/cppi" "bin/lib/cppi/" "arbace/repr/cpp.ae" "arbace/repr/cpp/" "arbace/repr/llvm.ae"
        "arbace/repr/llvm/" "arbace/cpp/" "tools/cxxdump/" "test/cpp/" "test/repr/cpp/"]
;;@ steps
  ;; ---- C++ (CX10 with CX8, CX9; GT9): the runtime's build, the essential chain (about 1.5 min warm), the chain cpp-full at night
  {:name cpp-runtime :mem-gib 8 :phase :build :kind :build
   :cmd "bin/cppi runtime-build && bin/cppi runtime-ci"
   ;; cpp-indep (CP240 (a)): the units' IR from the pack cpp-runtime-ir, no gcc (ORS27: the lowered C read by repr/c and checked by ci);
   ;; CP403 (a) (queue 406): bin/cppi's default route auto, rt_ours_glob's units by Arbace's own code generator (gen-batch, one process
   ;; at GOMEMLIMIT 1500MiB, about 1.6 GB; 10-20 min when the key moves: the parser, sema, the code generator and cpp/target are in it)
   ;; with the names level against the pack's IR, the rest from the pack; all of it under :cpp
   :hosts [:stage0] :never-loads [arbace.j2g] :inputs [:lib-tools :tools :cpp :c]
   :pins ["test/cpp/corpora.edn" "test/cpp/records/cpp-runtime-ir.sha256"]}
  ;; the crops tier: C++'s read, print and lowering subsets as one step (one declaration before: :cpp and :c on stage 0), the runtime's
  ;; build first; cpp-check-essential apart (ci's back end and TamaGo's go beside, its 5 GiB)
  {:name cpp-essential :mem-gib 3 :phase :essential :chain cpp-essential :needs [cpp-runtime] :essential-when-changed :cpp
   ;; ARBACE_NO_AOT=1 until the next re-seed (n-all4, 2026-11-19): stage 0 evaluates a changed embedded namespace from the
   ;; checkout (RT.toolSource), so e0dca79f8's arbace/repr/c/lex.ae defined its deftype Tok anew while the unchanged
   ;; arbace.repr.cpp.ppcheck ran compiled against the seed's Tok (ClassCastException "Tok cannot be cast to Tok",
   ;; doc/W-WINDOW.md §8 risk 2); without the compiled loaders every namespace is the embedded or the checkout's source, one Tok
   :cmd "export ARBACE_NO_AOT=1; bin/repr-cpp target verify && bin/repr-cpp pp-check --essential && bin/repr-cpp roundtrip-corpus gxx-dg-essential --judge own && bin/repr-cpp roundtrip-corpus samples --judge own && bin/cppi lower-essential"
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn" "test/c/corpora.edn"]
   :inputs [:lib-tools :tools :cpp :c]
   :summary ["^(cpp-lexical|gxx-dg|libstdcxx-headers): [0-9]+ files,|failing|stale|^\\{:files|control|^rtcheck: the run|^lower-check|pass|FAIL" 12]}
  ;; ORS27, ORS28 (b) (the user, 2026-11-06; mac/oracle-records-cpp2, batch 4): no gcc and no clang here (bin/cppi's cpr_gcc and cpr_live):
  ;; the IR from the packs, the lowering stopping at the lowered C, read by repr/c and checked by ci's checker; gcc's compile and the
  ;; lowered run are cpp-lower-oracle's, ci's run of io.cpp cpp-check-essential's, of hello.cpp and library.cpp cpp-check's
  {:name cpp-check-essential :mem-gib 5 :phase :essential :chain cpp-essential :needs [cpp-essential] :essential-when-changed :cpp
   ;; cpp-gatefix: ci's builder's GOMEMLIMIT 2GiB, not 4GiB (night 12's 4.1 GiB peak was that soft limit's heap, above :mem-gib 3)
   :cmd "env CPPI_THREADS=2 CPPI_CI_MEMLIMIT=2GiB bin/cppi check --only test/cpp/essential-check.txt"
   ;; cpp-indep (CP240 (a)): the programs' IR from the pack cpp-ir-samples (UNRECORDED fails), no clang
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn" "test/cpp/records/cpp-ir-samples.sha256"]
   :inputs [:lib-tools :tools :cpp :c :c-run]
   :summary ["programs:|REGRESSION|control|FAIL" 4]}
  ;; ORS12 (a) (mac/oracle-records-cpp, batch 4): the selftests that name no compiler or LLVM tool (test/cpp/selftest/toolchain.txt lists
  ;; the others, the oracle tier's cpp-selftest-oracle)
  {:name cpp-selftest :mem-gib 1 :phase :full :chain cpp-full
   :cmd "bin/cppi selftest --no-toolchain"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn"]
   :inputs [:lib-tools :tools :cpp :c]
   :summary ["tests?,|pass|fail|FAIL" 4]}
  {:name cpp-tokens :mem-gib 2 :phase :full :chain cpp-full
   :cmd "bin/repr-cpp pp-check --corpus {part}"
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn" "test/c/corpora.edn"]
   :inputs [:lib-tools :tools :cpp :c]
   :parts [{:part cpp-lexical}
           {:part gxx-dg :cmd "bin/repr-cpp pp-check --corpus gxx-dg --sample 10"}
           {:part libstdcxx-headers :cmd "bin/repr-cpp pp-check --corpus libstdcxx-headers --sample 8"}]
   :summary ["^(cpp-lexical|gxx-dg|libstdcxx-headers): [0-9]+ files,|failing|stale" 4]}
  ;; cpp-target (ORS31 (a), the user's own-verdict decision of 2026-11-07): the parts no toolchain judges, by their own verdicts: preprocess's
  ;; dg directives against the shared preprocessor's errors (Arbace's C++ target, CP244 (b)), modules' round trip by its levels 1 and 5
  ;; (--judge own); the dg-error part, whose acceptance and errors are clang's Sema (CP242): since CP247 (a) on clang's recorded dumps (the
  ;; pack test/repr/cpp/records/cxxdump-dg-error, cxxdump -records: no clang; :go builds the filter), clang live the oracle tier's cpp-dg-oracle;
  ;; until the night records the pack the part prints "no record yet" and passes
  {:name cpp-dg :mem-gib 6 :phase :full :chain cpp-full
   :cmd "bin/repr-cpp dg --corpus {part} --own"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn"]
   :inputs [:lib-tools :tools :cpp :c]
   ;; CX12 (doc/cpp/CPP-SURVEY.md, "As built: CX12 (first slice)"): dg-error-own, the same files by Arbace's own front end's errors
   ;; (bin/repr-cpp dg --front native: the native parser's syntax errors, Sema's checks, the code generator's Sema), no clang, no pack,
   ;; judged by the test's own dg-error lines against test/cpp/check-dg-own-linux-amd64.edn (a recorded own pass that fails, fails)
   ;; GD2 (GDS6 (a), doc/GATE-DIET-SURVEY.md "As built: GD2"): dg-error-own (48 min) rotates, --only over the dg-error part's files (clang's
   ;; record's rows but :unsupported, the files the own run judges), its subset test/cpp/subsets.edn's :subset-dg (bin/gate-subsets cpp), the
   ;; control's two files :always; preprocess (20 s) and dg-error (seconds) run whole
   ;; the 11-20 audit: dg-error dropped, "no record yet (CP247 (a) ...); skipped": a pass that judged nothing (it comes back with its record)
   :parts [{:part preprocess :mem-gib 1}
           {:part dg-error-own :cmd "bin/repr-cpp dg --corpus dg-error --front native"
            :rotate {:only "--only {list}" :universe "test/cpp/check-dg-linux-amd64.edn" :id-re "^\\[\"([^\"]+)\" :(?:pass|fail) "
                     :subset "test/cpp/subsets.edn" :subset-key :subset-dg :always ["gxx-dg/DRs/dr1423.C" "gxx-dg/DRs/dr2082.C"]
                     :failed-re "^FAIL (gxx-dg/[^ ]+) .*$"}}
           {:part modules :clean-only true}]
   :summary ["pass|class|FAIL|stale" 4]}
  ;; CP302 (a): the code generator's light half, no clang, gcc or run (codegen-check's, which needs them, is the night's by hand):
  ;; gen-list over test/cpp/codegen's samples, each refusal's class and each generated sample's forms against their records
  ;; (test/cpp/codegen/refusals.edn, forms.sha256; bin/cppi codegen-gen --record rewrites them), about 5 min at one thread
  {:name cpp-codegen-gen :mem-gib 2 :phase :full :chain cpp-full
   :cmd "bin/cppi codegen-gen"
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn" "test/c/corpora.edn"]
   :inputs [:lib-tools :tools :cpp :c]
   :summary ["^codegen-gen|^FAIL|control" 4]}
  ;; CX12, CP283 (a): clang's identifier table (cpp/target/clang-builtins.edn, the undeclared check's __ names) made again from the
  ;; pinned llvm-project tarball's Builtins*.td and TokenKinds.def and compared (bin/repr-cpp target builtins verify, seconds)
  {:name cpp-builtins :mem-gib 3 :phase :full :chain cpp-full
   :cmd "bin/repr-cpp target builtins verify"
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn"]
   :inputs [:lib-tools :tools :cpp]
   :summary ["builtins|verify|differ" 4]}
  ;; ORS31 (a), CP243 (a): judged by the round trip's own levels 1 and 5 on the native parser (no clang, no objects); clang's levels 3 and 4
  ;; are the oracle tier's cpp-roundtrip-oracle. Held to the own records (roundtrip-results/own/KEY.edn, cpp-print-own's, 2026-11-10; --judge own
  ;; the round trip's default since, CP243 (a))
  {:name cpp-roundtrip :mem-gib 3 :phase :full :chain cpp-full
   :cmd "bin/repr-cpp roundtrip-corpus {part} --judge own"
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn"]
   :inputs [:lib-tools :tools :cpp :c]
   ;; GDS4 (a), GD1: libstdcxx-testsuite-every-40 weekly (54 min); GD3 (GDS4 (b), doc/GATE-DIET-SURVEY.md, "As built: GD3"): a :phase :weekly part
   ;; GD2 (GDS6 (a)): the two every-10 lists rotate as cpp-roundtrip-dg's, --only-list over their own records, the subsets
   ;; test/cpp/subsets.edn's :subset-roundtrip (bin/gate-subsets cpp); samples (no record) runs whole
   :parts [{:part gxx-old-deja-every-10
            :rotate {:only "--only-list {list}" :universe "test/repr/cpp/roundtrip-results/own/gxx-old-deja-every-10.edn" :id-re "^\\s+\"([^\"]+)\" "
                     :subset "test/cpp/subsets.edn" :subset-key :subset-roundtrip :failed-re "^FAIL (.+)$"}}
           {:part c-c++-common-every-10
            :rotate {:only "--only-list {list}" :universe "test/repr/cpp/roundtrip-results/own/c-c++-common-every-10.edn" :id-re "^\\s+\"([^\"]+)\" "
                     :subset "test/cpp/subsets.edn" :subset-key :subset-roundtrip :failed-re "^FAIL (.+)$"}}
           ;; the 11-20 audit (the user's GDS28 decision, 2026-11-20): samples dropped, cpp-essential's `roundtrip-corpus samples --judge own`
           ;; (every tier; ARBACE_NO_AOT=1 apart), its controls with it
           {:part libstdcxx-testsuite-every-40 :phase :weekly}]
   :summary ["^\\{:files|failing|control|^rtcheck: the run|^roundtrip:" 4]}
  {:name cpp-roundtrip-dg :mem-gib 3 :phase :full :chain cpp-full
   :cmd "bin/repr-cpp roundtrip-corpus {part} --judge own"
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn"]
   :inputs [:lib-tools :tools :cpp :c]
   :parts [{:part gxx-dg-every-10}]
   :summary ["^\\{:files|failing|^rtcheck: the run|^roundtrip:" 4]
   :rotate {:only "--only-list {list}" :universe "test/repr/cpp/roundtrip-results/own/gxx-dg-every-10.edn" :id-re "^\\s+\"([^\"]+)\" "
            :subset "test/cpp/subsets.edn" :subset-key :subset-roundtrip :failed-re "^FAIL (.+)$"}}
  ;; ORS28 (b): no gcc, as cpp-lower-essential; libstdcxx-every-15th, whose IR pack is the night's (bin/cppi record-ir --corpus libstdcxx
  ;; --every 15,25: cpp-ir-libstdcxx with the util library's IR, ORS26 (b)), is cpp-lower-oracle's until then
  {:name cpp-lower :mem-gib 3 :phase :full :chain cpp-full :needs [cpp-runtime]
   :cmd "env CPPI_DISK_MAX=90 bin/cppi lower-corpus {part}"
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn"]
   :inputs [:lib-tools :tools :cpp :c]
   :parts [{:part samples}]
   :summary ["^lower-check|pass|failing|FAIL" 4]
   :rotate {:only "--only-list {list}" :universe "test/cpp/lower-results.edn" :id-re "^\\s+\"([0-9][0-9]_[^\"]+)\" \\["
            :subset "test/cpp/subsets.edn" :subset-key :subset-lower :failed-re "^  failing: ([^ ]+) .*$"}}
  ;; CP397 (a) (2026-11-15): as steps.edn's (spliced at batch 1 and edited there since): the essential step's environment, :mem-gib 6
  ;; gate-split (2026-11-20; doc/GATE-DIET-SURVEY.md, "The long single steps split"): the ours route's code generation, one gen-batch process
  ;; over the corpus's programs (the runtime's 8 programs 36.5 of the step's 52 minutes on 11-20), three processes at once (CPPI_GEN_JOBS,
  ;; one a program: the same IR); about 2.8 GB each, so :mem-gib 9 (6 before), about 25 minutes
  {:name cpp-check :mem-gib 9 :phase :full :chain cpp-full :needs [cpp-runtime]
    ;; the cover (doc/GATE-DIET-SURVEY.md, "The cover and unit keys", GDS21): in a run where it runs whole, cpp-check-essential is covered: the run corpora samples and runtime whole, test/cpp/essential-check.txt's programs among them
    :subsumes [cpp-check-essential]
   :cmd "env CPPI_THREADS=2 CPPI_GEN_JOBS=3 CPPI_CI_MEMLIMIT=2GiB bin/cppi check {part}"
   ;; cpp-indep (CP240 (a)): from the packs, no clang; the sampling gxx-dg-run-every-25 waits for its pack (cpp-ir-gxx-dg-run, ORS26 (b),
   ;; the night's record-ir --corpus gxx-dg-run --every 25) in test/gate/crops/cpp-oracle.edn's live parts
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn" "test/cpp/records/cpp-ir-samples.sha256"]
   :inputs [:lib-tools :tools :cpp :c :c-run]
   :parts [{:part samples-runtime :cmd "env CPPI_THREADS=2 CPPI_GEN_JOBS=3 CPPI_CI_MEMLIMIT=2GiB bin/cppi check"}]
   :summary ["programs:|REGRESSION|control|FAIL" 4]}
  ;; gate-split (2026-11-20): the same generation three at once (the runtime's 28 of 48 minutes on 11-20), :mem-gib 9 (7 before), about 30 minutes
  {:name cpp-aot :mem-gib 9 :phase :full :chain cpp-full :needs [cpp-check]
   :cmd "env CPPI_THREADS=2 CPPI_GEN_JOBS=3 CPPI_CI_MEMLIMIT=4GiB bin/cppi check --aot {part}"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn" "test/cpp/records/cpp-ir-samples.sha256"]
   :inputs [:lib-tools :tools :cpp :c :c-run]
   :parts [{:part samples-runtime :cmd "env CPPI_THREADS=2 CPPI_GEN_JOBS=3 CPPI_CI_MEMLIMIT=4GiB bin/cppi check --aot"}]
   :summary ["programs:|compiled against|REGRESSION|control|FAIL" 4]}
;;@ crops
         :cpp [cpp-runtime cpp-essential cpp-check-essential cpp-selftest cpp-tokens cpp-dg cpp-roundtrip cpp-roundtrip-dg cpp-lower cpp-check cpp-aot cpp-builtins cpp-codegen-gen]
;;@ controls
  cpp-essential [{:waived "the token oracle's comparison against g++ -E and clang (GT9.8 \"Not covered\": pp-check; GTS242)"} "test/repr/cpp/roundtrip-controls.edn" "test/cpp/controls.edn"]
  cpp-check-essential "test/cpp/controls.edn"
  cpp-selftest {:waived "the checks' own tests: each a negative case (review 007's)"}
  cpp-tokens {:waived "as cpp-read-essential (GTS242)"}
  cpp-codegen-gen "test/cpp/controls.edn"
  cpp-builtins {:waived "a generated table compared byte for byte with its committed file: no verdict to cross"}
  cpp-dg {:waived "no crossed pair yet (CP214, GTS242)"}
  cpp-roundtrip "test/repr/cpp/roundtrip-controls.edn"
  cpp-roundtrip-dg {:waived "the round trip's control is a crossed pair of two samples (cpp-essential's samples round trip); this step runs the recorded dg list, a partial run on its rotation's subset"}
  cpp-lower "test/cpp/controls.edn"
  cpp-check "test/cpp/controls.edn"
  cpp-aot "test/cpp/controls.edn"

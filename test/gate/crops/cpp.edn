;; GT9 (doc/GATE-SURVEY.md, "As built: GT9 (write-ahead)"): C++'s gate steps, cpp-cx10's (CX10, CP180-CP184) with cpp-cx8's run and
;; compiled levels and cpp-cx9's dg check, on GT8's planner and GT9's tooling, for merge plan batch 1 (after cpp-cx8, cpp-cx9,
;; cpp-cx10 and crop-controls). Splice as test/gate/crops/ocaml.edn says; in the merge take next's side for bin/lib/gate-run.bash
;; (cx10's gate_cxx_id is :host-ids :cxx, the same identity) and cx10's steps.edn hunks but reap's (its :inputs gain "test/cpp/*.edn",
;; its :summary C\+\+), which stay. GT9's changes to cx10's entries:
;;   - cpp-runtime, a :build step (GTS215): the lowered runtime (4-5 min when stale) and ci's library out of the essential chain's wall
;;   - cpp-check-essential, cpp-check, cpp-aot: cx8's levels on the samples and the runtime (14 programs, the records' rows); the
;;     libstdcxx and gxx-dg-run parts wait for their subsets (CP181, GTS205: the whole libstdcxx is about 23 h on ci)
;;   - cpp-dg: cx9's three corpora, whole (dg-error about 6 min, preprocess under 30 s; modules, about 3 min, :clean-only)
;;   - until the subsets (GTS205) the nightly share (24.3 min) is kept by :clean-only parts: the lowering's libstdcxx 15th (16 min),
;;     the compiled level's runtime programs and dg's modules; GT9's estimate is still about 33 min nightly (GTS222 measures it)
;;   - the round trip's controls (crop-controls: test/repr/cpp/roundtrip-controls.edn); every step a control or a waiver
;; Not here: native-check (cpp-native, batch 5: crops/cpp-native.edn); the subsets' :rotate (CP181's one-row-a-line records and
;; --only for roundtrip-corpus and lower-corpus are NEW); the essential lists of ci (test/cpp/essential-check.txt, NEW)
;;@ groups
  ;; C++'s tools (CX10): repr/cpp, repr/llvm and the lowering evaluated from the checkout on stage 0, cxxdump (clang's AST, the
  ;; oracle), the records (test/cpp/, test/repr/cpp/); g++ and clang++ are the host :cxx, gcc :gcc
  :cpp ["bin/repr-cpp" "bin/lib/repr-cpp/" "bin/cppi" "bin/lib/cppi/" "arbace/repr/cpp.ae" "arbace/repr/cpp/" "arbace/repr/llvm.ae"
        "arbace/repr/llvm/" "arbace/cpp/" "tools/cxxdump/" "test/cpp/" "test/repr/cpp/"]
;;@ steps
  ;; ---- C++ (CX10 with CX8, CX9; GT9): the runtime's build, the essential chain (about 1.5 min warm), the chain cpp-full at night
  {:name cpp-runtime :mem-gib 3 :phase :build :kind :build
   :cmd "bin/cppi runtime-build && bin/cppi runtime-ci"
   :hosts [:stage0 :cxx :gcc] :never-loads [arbace.j2g] :inputs [:lib-tools :tools :cpp]}
  {:name cpp-read-essential :mem-gib 2 :phase :essential :chain cpp-essential
   :cmd "bin/repr-cpp pp-check --essential"
   :hosts [:stage0 :cxx] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn"]
   :inputs [:lib-tools :tools :cpp]
   :summary ["^(cpp-lexical|gxx-dg|libstdcxx-headers): [0-9]+ files,|failing|stale" 4]}
  {:name cpp-print-essential :mem-gib 2 :phase :essential :chain cpp-essential :needs [cpp-read-essential]
   :cmd "bin/repr-cpp roundtrip-corpus gxx-dg-essential && bin/repr-cpp roundtrip-corpus samples"
   :hosts [:stage0 :go :cxx] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn"]
   :inputs [:lib-tools :tools :cpp]
   :summary ["^\\{:files|failing|control|^rtcheck: the run" 4]}
  {:name cpp-lower-essential :mem-gib 3 :phase :essential :chain cpp-essential :needs [cpp-print-essential cpp-runtime]
   :cmd "bin/cppi lower-essential"
   :hosts [:stage0 :cxx :gcc] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn"]
   :inputs [:lib-tools :tools :cpp]
   :summary ["^lower-check|pass|failing|FAIL" 4]}
  {:name cpp-check-essential :mem-gib 3 :phase :essential :chain cpp-essential :needs [cpp-lower-essential]
   :cmd "bin/cppi check --corpus samples"
   :hosts [:stage0 :go :cxx :gcc] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn"]
   :inputs [:lib-tools :tools :cpp :c-run]
   :summary ["programs|pass|FAIL|control" 4]}
  {:name cpp-selftest :mem-gib 3 :phase :full :chain cpp-full
   :cmd "bin/cppi selftest"
   :hosts [:stage0 :go :cxx :gcc] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn"]
   :inputs [:lib-tools :tools :cpp]
   :summary ["tests?,|pass|fail|FAIL" 4]}
  {:name cpp-tokens :mem-gib 2 :phase :full :chain cpp-full
   :cmd "bin/repr-cpp pp-check --corpus {part}"
   :hosts [:stage0 :cxx] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn"]
   :inputs [:lib-tools :tools :cpp]
   :parts [{:part cpp-lexical}
           {:part gxx-dg :cmd "bin/repr-cpp pp-check --corpus gxx-dg --sample 10"}
           {:part libstdcxx-headers :cmd "bin/repr-cpp pp-check --corpus libstdcxx-headers --sample 8"}]
   :summary ["^(cpp-lexical|gxx-dg|libstdcxx-headers): [0-9]+ files,|failing|stale" 4]}
  {:name cpp-dg :mem-gib 3 :phase :full :chain cpp-full
   :cmd "bin/repr-cpp dg --corpus {part}"
   :hosts [:stage0 :cxx] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn"]
   :inputs [:lib-tools :tools :cpp]
   :parts [{:part dg-error} {:part preprocess} {:part modules :clean-only true}]
   :summary ["pass|class|FAIL|stale" 4]}
  {:name cpp-roundtrip :mem-gib 3 :phase :full :chain cpp-full
   :cmd "bin/repr-cpp roundtrip-corpus {part}"
   :hosts [:stage0 :go :cxx] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn"]
   :inputs [:lib-tools :tools :cpp]
   :parts [{:part gxx-dg-every-10} {:part gxx-old-deja-every-10} {:part c-c++-common-every-10} {:part libstdcxx-testsuite-every-40}
           {:part samples}]
   :summary ["^\\{:files|failing|control|^rtcheck: the run|^roundtrip:" 4]}
  {:name cpp-lower :mem-gib 3 :phase :full :chain cpp-full :needs [cpp-runtime]
   :cmd "bin/cppi lower-corpus {part}"
   :hosts [:stage0 :cxx :gcc] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn"]
   :inputs [:lib-tools :tools :cpp]
   :parts [{:part samples} {:part libstdcxx-every-15th :clean-only true}]
   :summary ["^lower-check|pass|failing|FAIL" 4]}
  {:name cpp-check :mem-gib 3 :phase :full :chain cpp-full :needs [cpp-runtime]
   :cmd "bin/cppi check --corpus {part}"
   :hosts [:stage0 :go :cxx :gcc] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn"]
   :inputs [:lib-tools :tools :cpp :c-run]
   :parts [{:part samples} {:part runtime}]
   :summary ["programs|pass|FAIL|control" 4]}
  {:name cpp-aot :mem-gib 4 :phase :full :chain cpp-full :needs [cpp-check]
   :cmd "bin/cppi check --aot --corpus {part}"
   :hosts [:stage0 :go :cxx :gcc] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn"]
   :inputs [:lib-tools :tools :cpp :c-run]
   :parts [{:part samples} {:part runtime :clean-only true}]
   :summary ["programs|pass|FAIL|control" 4]}
;;@ crops
         :cpp [cpp-runtime cpp-read-essential cpp-print-essential cpp-lower-essential cpp-check-essential cpp-selftest cpp-tokens cpp-dg
               cpp-roundtrip cpp-lower cpp-check cpp-aot]
;;@ controls
  cpp-read-essential {:waived "the token oracle's comparison against g++ -E and clang (GT9.8 \"Not covered\": pp-check; GTS242)"}
  cpp-print-essential "test/repr/cpp/roundtrip-controls.edn"
  cpp-lower-essential "test/cpp/controls.edn"
  cpp-check-essential "test/cpp/controls.edn"
  cpp-selftest {:waived "the checks' own tests: each a negative case (review 007's)"}
  cpp-tokens {:waived "as cpp-read-essential (GTS242)"}
  cpp-dg {:waived "no crossed pair yet (CP214, GTS242)"}
  cpp-roundtrip "test/repr/cpp/roundtrip-controls.edn"
  cpp-lower "test/cpp/controls.edn"
  cpp-check "test/cpp/controls.edn"
  cpp-aot "test/cpp/controls.edn"

;; AX10 (the user, 2026-11-10: brought forward, CSP7 reversed; doc/asm/AMD64-SURVEY.md §11.2, AXS21, AXS42, AXS65, AXS73, AXS87 (a)
;; moved forward; doc/asm/ARM64-SURVEY.md §10, AR10): the assembly crops' steps, on stage 0 (and TamaGo's go for x86i's light driver),
;; no assembler, linker or TableGen of the host: every judge the test's own (its CHECK lines, its header's verdict, the CPU's run) but the
;; object check's, against llvm-mc's recorded objects. The corpora come from the pinned tarballs into the main checkout's .tmp/asm/src
;; (bin/repr-asm corpus ensure: extracted once per pins, under a lock). Measured 2026-11-10 on stage 0 by hand, one at a time (wall,
;; peak RSS): amd64 round trip whole 1 min 24 s and 1.0 GiB; arm64 round trip 33 s and 0.5 GiB, encode-check 45 s and 0.8 GiB, table
;; check 1 min 28 s and 1.4 GiB; the others in "As built: AX10" (doc/asm/AMD64-SURVEY.md). The oracle tier's steps are
;; test/gate/crops/asm-oracle.edn's. Spliced into test/gate/steps.edn by gate.crops splice.
;;@ groups
  :asm ["bin/repr-asm" "arbace/repr/asm.ae" "arbace/repr/asm/" "arbace/asm/" "asm/" "test/asm/"]
  ;; x86i's light driver (AXS51 (a)): built alone by TamaGo's go from these forms
  :x86i ["go/arbace/x86i.ae" "go/arbace/x86i/" "go/arbace/emu.ae" "go/arbace/emu/" "go/arbace/crt.ae" "go/arbace/crt/"
         "bin/build-go" "bin/lib/build-go/" "bin/lib/repr-go-host.bash" "bin/repr-go" "bin/lib/repr-go/"]
  ;; a64i's light driver (AR5): built alone by TamaGo's go from these forms
  :a64i ["bin/a64i" "go/arbace/a64i.ae" "go/arbace/a64i/" "go/arbace/emu.ae" "go/arbace/emu/" "go/arbace/crt.ae" "go/arbace/crt/"
         "bin/build-go" "bin/lib/build-go/" "bin/lib/repr-go-host.bash" "bin/repr-go" "bin/lib/repr-go/"]
;;@ steps
  ;; ---- x86-64 (AX1-AX5): essential, the chain asm-amd64-essential
  ;; the crops tier (2026-11-17; doc/GATE-DIET-SURVEY.md, "As built: the crops tier"): x86-64's three light checks as one step, one
  ;; declaration before (the same inputs, hosts and pins), each with its controls
  {:name asm-amd64-essential :mem-gib 2 :phase :essential :chain asm-amd64-essential :essential-when-changed :asm-amd64
   :cmd "bin/repr-asm corpus ensure && bin/repr-asm roundtrip musl mc-asmparser && bin/repr-asm run-check && bin/repr-asm object-check musl && bin/repr-asm object-check synthetic"
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["test/asm/corpora.edn"]
   :inputs [:lib-tools :tools :asm]
   :summary ["^repr-asm|^control|^FAIL" 12]}
  ;; ---- x86-64: --full, the chain asm-amd64-full
  {:name asm-amd64-roundtrip :mem-gib 2 :phase :full :chain asm-amd64-full
   :cmd "bin/repr-asm corpus ensure && bin/repr-asm roundtrip"
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["test/asm/corpora.edn"]
   :inputs [:lib-tools :tools :asm]
   :summary ["^repr-asm|^FAIL" 4]}
  {:name asm-amd64-encode :mem-gib 2 :phase :full :chain asm-amd64-full :needs [asm-amd64-roundtrip]
   :cmd "bin/repr-asm encode-check"
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["test/asm/corpora.edn"]
   :inputs [:lib-tools :tools :asm]
   :parts [{:part mc-x86}]
   :summary ["^repr-asm encode-check|^FAIL" 6]
   ;; AXS91 (a): the files of mc-x86 by name (the record's mc-x86/NAME rows, bare), the subset of the controls' files (test/asm/subsets.edn)
   ;; and the seven slices of the rest, each run `bin/repr-asm encode-check --only LIST`, judged on what it ran
   :rotate {:only "--only {list}" :universe "test/asm/encode-results-amd64.edn" :subset "test/asm/subsets.edn"
            :id-re "^\\[\"mc-x86/([^\"]+)\"" :failed-re "^FAIL: ([a-z]+ ?(\\([a-z]+\\))?: )?mc-x86/([^ :]+).*$" :failed-as "\\3"
            :always ["I86-64" "I86-32" "SSE2-32" "SSE2-64" "avx512bw-64-att" "avx512dq-att"
                     "avx10.2-bf16-64-intel" "avx10.2-bf16-32-intel" "apx-add-att" "apx-sub-att" "apx-ccmp-att" "apx-ctest-att" "x86-64" "avx-64-intel"]}}
  {:name asm-amd64-decode :mem-gib 2 :phase :full :chain asm-amd64-full :needs [asm-amd64-roundtrip]
   :cmd "bin/repr-asm decode-check {part}"
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["test/asm/corpora.edn"]
   :inputs [:lib-tools :tools :asm]
   :parts [{:part dis :clean-only true} {:part rt :clean-only true} {:part obj}]
   :summary ["^repr-asm|^FAIL" 4]}
  {:name asm-amd64-object :mem-gib 2 :phase :full :chain asm-amd64-full :needs [asm-amd64-roundtrip]
   :cmd "bin/repr-asm object-check {part}"
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["test/asm/corpora.edn"]
   :inputs [:lib-tools :tools :asm]
   :parts [{:part musl} {:part synthetic} {:part mc-x86-obj}]
   :summary ["^repr-asm|^FAIL" 4]}
  ;; queue 337: MC/X86's object tests object-check leaves out, by their own CHECK lines (arbace.asm.amd64.objcheck), and the
  ;; backend's TableGen facts (asm/amd64/backend.edn) regenerated and compared
  {:name asm-amd64-objverdict :mem-gib 2 :phase :full :chain asm-amd64-full :needs [asm-amd64-roundtrip]
   :cmd "bin/repr-asm object-verdict"
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["test/asm/corpora.edn"]
   :inputs [:lib-tools :tools :asm]
   :summary ["^repr-asm|^control|^FAIL" 4]}
  {:name asm-amd64-table :mem-gib 3 :phase :full :chain asm-amd64-full :needs [asm-amd64-roundtrip]
   :cmd "bin/repr-asm table check && bin/repr-asm backend check && bin/repr-asm x86i gen-check"
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["test/asm/corpora.edn"]
   :inputs [:lib-tools :tools :asm :x86i]
   :parts [{:part tables :clean-only true}]
   :summary ["^repr-asm|^FAIL" 4]}
  {:name x86i-check :mem-gib 2 :phase :full :chain asm-amd64-full :needs [asm-amd64-roundtrip]
   :cmd "bin/repr-asm x86i-check"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/asm/corpora.edn"]
   :inputs [:lib-tools :tools :asm :x86i]
   :parts [{:part all}]
   :summary ["^repr-asm|^FAIL|^control slice" 4]
   ;; AXS89 (a): the programs by name (the record's x86i/, decode/, lockstep/, step/ and loader/ rows of one program one id), the subset
   ;; and the seven slices of the rest (test/asm/subsets.edn); the run judged on what it ran, with its slice-foreign control
   :rotate {:only "--only {list}" :universe "test/asm/x86i-results-amd64.edn" :subset "test/asm/subsets.edn"
            :id-re "^\\[\"(?:x86i|decode|lockstep|step|loader)/([^\"]+)\"" :failed-re "^FAIL: (?:failing|unclassed): [a-z0-9]+/([^ ]+) .*$"}}
  {:name x86i-decode :mem-gib 2 :phase :full :chain asm-amd64-full :needs [asm-amd64-roundtrip]
   :cmd "bin/repr-asm x86i-decode-check"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/asm/corpora.edn"]
   :inputs [:lib-tools :tools :asm :x86i]
   :summary ["^repr-asm|^control|^FAIL" 4]}
  ;; ---- arm64 (AR1, AR2): essential whole (the round trip and the encode check, about 80 s), the table at night
  ;; the crops tier: arm64's five light checks of the bridge and the assembler (the round trip, the encode check, the objects, their
  ;; verdicts, the runs) as one step: the same :asm inputs (the round trip's box/ beside), TamaGo's go and qemu-aarch64 the union of
  ;; their hosts, each with its controls
  {:name asm-arm64-essential :mem-gib 2 :phase :essential :chain asm-arm64-essential :essential-when-changed :asm-arm64
   :cmd "bin/repr-asm corpus ensure && bin/repr-asm --arch arm64 roundtrip && bin/repr-asm --arch arm64 encode-check && bin/repr-asm --arch arm64 object-check && bin/repr-asm --arch arm64 object-check mc-aarch64-obj && bin/repr-asm --arch arm64 object-verdict && bin/repr-asm --arch arm64 run-check"
   :hosts [:stage0 :go :qemu-aarch64] :never-loads [arbace.j2g] :pins ["test/asm/corpora.edn"]
   :inputs [:lib-tools :tools :asm "box/"]
   :summary ["^repr-asm|^control|^FAIL" 26]}
  ;; ---- arm64 AR4: the objects (llvm-mc's records and the tests' own CHECK lines) and the runs (the programs' own verdicts: an arm64
  ;; CPU on an arm64 host, else qemu-aarch64's emulation, REPR_ASM_RUNNER; ARS33), essential, about 25 s and under 1 GiB together
  ;; AR5: a64i's check, eval (the forms) and the bytes (AOT) by their own verdicts, the forms against the decoded words, the
  ;; controls; on an arm64 host also the CPU's runs and the lockstep (sys and step modes, about 15 s of its 34 s on the Mac VM);
  ;; elsewhere their recorded rows stand (the lockstep needs this CPU's ptrace). AR6: with the eight synthetic programs (test/asm/a64i/gen.ae)
  ;; and the coverage's record, 2 min 12 s and under 1 GiB on the main host (ARS46). ARS46 (b), the user 2026-11-11 (AR7): the essential
  ;; step runs test/asm/subsets.edn's :a64i (the hand-written programs, synth-alu and synth-fp-d; --essential, judged on what it ran
  ;; with its slice-foreign control); a64i-check runs the rest in --full, the other synthetic programs a seventh a night (GT8.4's :rotate)
  ;; the crops tier: a64i's three light checks (its essential programs, goi's checker over its packages, the Go programs) as one step,
  ;; kept apart from asm-arm64-essential: their key holds :a64i's driver sources (the emulator, repr/go's printer, the build), which
  ;; the assembler's checks never read
  {:name a64i-essential :mem-gib 3 :phase :essential :chain asm-arm64-essential :needs [asm-arm64-essential] :essential-when-changed :asm-arm64
   :cmd "bin/repr-asm corpus ensure && bin/a64i check --essential && bin/a64i table-check && bin/a64i go-check"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/asm/corpora.edn"]
   :inputs [:lib-tools :tools :asm :a64i "tools/godump/"]
   :summary ["^a64i-check|^a64i table-check|^a64i go-check|^control|^FAIL" 12]}
  ;; queue 277, AR14 (ARS70 (a)): goi's checker over a64i's packages (arbace/crt, arbace/emu, arbace/a64i) in linux/arm64, the package
  ;; header's :init-order and the forms' annotations held to it (AR13 found the order two branches stale by hand), with its control
  ;; (the :init-order's first two entries swapped must fail); warm 32 s and under 1 GiB on the VM, the closure's std read once into
  ;; .tmp/a64i/table (151 s with one job) unless bin/goi table's linux/arm64 cache of std is the checkout's
  ;; queue 291 (ARS86 (a)): bin/a64i go-check, real Go programs (test/asm/a64i-go/: hello, goroutines, timers, maps, nilderef, preempt)
  ;; built for linux/arm64 by TamaGo's go and run on a64i to their end, judged by their own output, natively too on arm64, with its
  ;; controls (test/asm/controls-a64i-go.txt); measured on the VM (4 cores, load 21, warm Go cache): 19.5 s, peak 0.26 GiB
  ;; queue 292 (ARS88 (a)): bin/a64i go-check --tools, gofmt and go vet (test/asm/a64i-go/gofmt, vet: GOROOT's cmd/gofmt and cmd/vet
  ;; built for linux/arm64) run on a64i over a fixed input set (a64i's Go programs, go/format, container/list, text/tabwriter, log's
  ;; facts, a package with a mistake for each analyzer), each run's output, errors, status and files against want/, natively too on
  ;; arm64, with the controls go-3 to go-6; measured on the VM (4 cores, load about 14, warm Go cache): 219 s, peak 0.28 GiB (25 runs,
  ;; 300-400 M instructions on a64i; 10 runs 3.5 to 5.5 minutes), so beside a64i-go in --full
  ;; queue 294 (ARS90 (a)): and cmd/compile and cmd/asm (test/asm/a64i-go/compile: a module of two packages, Go and arm64
  ;; assembly, their import configurations as go build -trimpath writes them; 10 runs, the objects byte for byte the M2's; controls
  ;; go-7 to go-9): 10 runs 241-462 s on the VM (load 12-15; 240-390 M instructions); the step 653 s on the VM, 0.35 GiB
  ;; queue 295 (ARS92 (a)): the compile runs a step of their own, a64i-go-compile; this one gofmt's and vet's (its inputs less the
  ;; compile directory): 272 s on the VM (4 cores, load 13), peak 0.46 GiB
  {:name a64i-go-tools :mem-gib 1 :phase :full :chain asm-arm64-full
   :cmd "bin/a64i go-check --tools gofmt vet"
   :hosts [:stage0 :go] :never-loads [arbace.j2g]
   :inputs [:lib-tools :tools :asm :a64i "!test/asm/a64i-go/compile/"]
   :summary ["^a64i go-check: [a-z]+: [0-9]|^control|^FAIL" 4]}
  ;; queue 295 (ARS92 (a)): cmd/compile's and cmd/asm's runs on a64i (test/asm/a64i-go/compile, AR22), the objects byte for byte the
  ;; M2's, with the controls go-7 to go-9 (its inputs less gofmt's and vet's directories); AR23: and cmd/pack's and cmd/link's, the
  ;; linked program byte for byte the M2's and run on a64i (16 runs; go-10 to go-12): ten in a row 198-431 s on the VM (load 11-13),
  ;; peak 0.35 GiB (1.39 GiB with the tools' build cold): 323 s on the VM (4 cores, load 13), peak
  ;; 1.39 GiB (busybox time -v; the main host's whole a64i-go-tools 1.5 GB on amd64)
  {:name a64i-go-compile :mem-gib 2 :phase :full :chain asm-arm64-full
   :cmd "bin/a64i go-check --tools compile"
   :hosts [:stage0 :go] :never-loads [arbace.j2g]
   :inputs [:lib-tools :tools :asm :a64i "!test/asm/a64i-go/gofmt/" "!test/asm/a64i-go/vet/"]
   :summary ["^a64i go-check: [a-z]+: [0-9]|^control|^FAIL" 4]}
  ;; queue 301 (ARS94 (a), the user's): bin/a64i goroot-check, goi's $GOROOT/test corpus (its linux record's 1,178 run, rundir, buildrundir
  ;; and runindir programs) built for linux/arm64 by TamaGo's go and run on this arm64 CPU, the reference, and on a64i, equal to it (AR24;
  ;; test/asm/a64i-goroot/, the classes test/asm/divergences-a64i-goroot.edn, the record test/asm/a64i-goroot-results-arm64.edn: 1,141 of
  ;; 1,178 pass), with the controls goroot-1 to goroot-3: on arm64 hosts only (the command is a no-op elsewhere: the CPU's run is the
  ;; reference; the planner's absence rule is the :oracle phase's alone). 265-295 s on the VM (3 jobs, load about 9), peak 0.43 GiB
  ;; (busybox time -v). The CPU's run is timed by CPU time, not wall time; the built programs are kept in .tmp/a64i/goroot/built/KEY
  ;; (1.6 GB), KEY the Go tree's and the corpus's pins and one.bash. Its inputs less a64i-go's directory; the pins TamaGo's go and $GOROOT/test's
  {:name a64i-goroot :mem-gib 1 :phase :full :chain asm-arm64-full
   :cmd "case $(uname -m) in aarch64|arm64) bin/a64i goroot-check ;; *) echo 'a64i goroot-check: skipped, not an arm64 host' ;; esac"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["seed/goroot.sha256" "seed/goroot-test.sha256"]
   :inputs [:lib-tools :tools :asm :a64i "test/goi/check-linux-amd64.edn" "!test/asm/a64i-go/"]
   :summary ["^a64i goroot-check|^control|^FAIL" 4]}
  {:name a64i-check :mem-gib 2 :phase :full :chain asm-arm64-full
   :cmd "bin/repr-asm corpus ensure && bin/a64i check"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/asm/corpora.edn"]
   :inputs [:lib-tools :tools :asm :a64i]
   :parts [{:part a64i}]
   :summary ["^a64i-check|^control|^FAIL" 4]
   ;; the programs by name (the record's eval/, aot/, forms/, cpu/, sys/, step/ and loader/ rows of one program one id), the subset
   ;; and the seven slices of the rest; the run judged on what it ran, with its slice-foreign control
   :rotate {:only "--only {list}" :universe "test/asm/a64i-results-arm64.edn" :subset "test/asm/subsets.edn"
            :id-re "^\\[\"(?:eval|aot|forms|cpu|sys|step|loader)/([^\"]+)\"" :failed-re "^FAIL: (?:failing|unclassed): [a-z]+/([^ ]+) .*$"}}
  {:name asm-arm64-table :mem-gib 2 :phase :full :chain asm-arm64-full
   :cmd "bin/repr-asm corpus ensure && bin/repr-asm --arch arm64 table check"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["test/asm/corpora.edn"]
   :inputs [:lib-tools :tools :asm]
   :summary ["^repr-asm|^FAIL" 4]}
;;@ crops
         :asm-amd64 [asm-amd64-essential asm-amd64-roundtrip asm-amd64-encode asm-amd64-decode asm-amd64-object asm-amd64-objverdict asm-amd64-table x86i-check x86i-decode]
         :asm-arm64 [asm-arm64-essential a64i-essential a64i-go-tools a64i-go-compile a64i-goroot a64i-check asm-arm64-table]
;;@ controls
  asm-amd64-essential ["test/asm/controls.txt" "test/asm/controls-run.txt" "test/asm/controls-object.txt"]
  x86i-check "test/asm/controls-x86i.txt"
  asm-amd64-roundtrip "test/asm/controls.txt"
  asm-amd64-encode "test/asm/controls-encode.txt"
  asm-amd64-decode "test/asm/controls-decode.txt"
  asm-amd64-object "test/asm/controls-object.txt"
  asm-amd64-objverdict "test/asm/controls-objverdict.txt"
  asm-amd64-table {:waived "a generation compared with the committed tables byte for byte (asm/amd64/table.edn, go/arbace/x86i/dectab.ae): no case to cross"}
  x86i-decode "test/asm/controls-x86i-decode.txt"
  asm-arm64-essential ["test/asm/controls-arm64.txt" "test/asm/controls-encode-arm64.txt" "test/asm/controls-object-arm64.txt" "test/asm/controls-objverdict-arm64.txt" "test/asm/controls-run-arm64.txt"]
  a64i-essential ["test/asm/controls-a64i.txt" "test/asm/controls-a64i-table.txt" "test/asm/controls-a64i-go.txt"]
  a64i-check "test/asm/controls-a64i.txt"
  a64i-go-tools "test/asm/controls-a64i-go.txt"
  a64i-go-compile "test/asm/controls-a64i-go.txt"
  a64i-goroot "test/asm/a64i-goroot/controls.txt"
  asm-arm64-table {:waived "a generation compared with the committed tables byte for byte (arbace/repr/asm/arm64/table.ae, asm/arm64/table.edn): no case to cross"}

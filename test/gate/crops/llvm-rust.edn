;; GT9 (doc/GATE-SURVEY.md, "As built: GT9 (write-ahead)"): merge plan batch 2 (rust-re4, llvm-read and its line, after batch 1's
;; C++ steps): Rust's read and print (main's verbs) with rsi on ci (rust-re4), and LLVM IR's interim step (GTS221 (a)). Splice
;; after test/gate/crops/cpp.edn (rsi and llvm need cpp-runtime). rust-read-essential runs `test --samples` (cases 1-4 and 6-8: about 35 s
;; of the 68 s; gt9v-rust, on rust-re5, which also has `roundtrip --only-list FILE` and `pins check`); native-check is rust-native's
;; (batch 3: crops/natives.edn). The round trip's corpora run whole: std's levels (3 min) and the UI's tree and text (about 3 min)
;; nightly; library, compiler and the crates (23 min) stay :clean-only parts: --only-list exists, but a rotation needs a universe of ids
;; and a subset (a record of the files, one a line: none yet for Rust), and 22 + a rotated 4-6 min is over the share (24.3). LLVM: repr/llvm's round trip over C++'s pinned runtime IR (the verb
;; on llvm-read is `bin/repr-llvm roundtrip LIST WORK`; GT9.4's roundtrip-corpus is NEW), its list test/llvm/essential.txt NEW (LL1):
;; until LL1 the step takes the runtime's units through cppi's work directory, a plan without them is GTS221's open item
;; rsi-aot (6 GiB, 18 min a program; since queue 362 its samples part :phase :weekly) runs in the serial run: a chain of its own that needs no rust-full step, so that
;; rust-full stays light and beside it (GTS216)
;;@ groups
  :rust ["bin/repr-rust" "bin/lib/crops/musl-hold.bash" "bin/lib/repr-rust/" "bin/lib/crops/take.bash" "bin/lib/gate-cache.bash" "bin/rsi" "bin/lib/rsi/" "arbace/repr/rust.ae" "arbace/repr/rust/" "arbace/rust/"
         "arbace/cpp/" "arbace/repr/llvm.ae" "arbace/repr/llvm/" "tools/rsdump/RUSTC_VERSION" "tools/rsdump/apks.sha256" "test/rust/"]
  ;; rsi (RE1-RE4): rustc's IR lowered by arbace/rust and the shared lowering (C++'s :cpp), run on ci
  :rsi ["bin/rsi" "bin/lib/rsi/" "arbace/rust/" "arbace/cpp/"]
  :llvm ["bin/repr-llvm" "bin/lib/crops/musl-hold.bash" "bin/lib/repr-llvm/" "bin/llvm-corpus" "bin/llvmi" "arbace/repr/llvm.ae" "arbace/repr/llvm/" "arbace/llvm/"
         "arbace/cpp/" "test/llvm/" "test/repr/llvm/"]
;;@ steps
  ;; ---- Rust (RR1-RR6, RE4; GT9): essential one chain (test 58 s, three ci programs), the chain rust-full at night
  ;; the crops tier: the round trip's eight std files and rsi's judge test as one step (one declaration before)
  {:name rust-read-essential :mem-gib 3 :phase :essential :chain rust-essential :essential-when-changed :rust
   :cmd "env REPR_RUST_JOBS=4 bin/repr-rust roundtrip --text --only 'core/src/(ascii|option|cell|hint)\\.rs|alloc/src/(boxed|rc)\\.rs|std/src/(env|process)\\.rs' rustc-1.99.1 && bin/rsi judge-test"
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["tools/rsdump/apks.sha256"]
   :inputs [:lib-tools :tools :rust]
   :summary ["^repr-rust roundtrip|^DIFFERS|^judge-test|^FAIL" 10]}
  ;; gate-split (2026-11-20; doc/GATE-DIET-SURVEY.md, "The long single steps split"): the lowered std (bin/rsi runtime-ci: runtime-build
  ;; --ci, then repr/c's read of its 95 units into ci's library) built by a step of its own, in rsi-essential's environment (evaluated,
  ;; 2 jobs), which rsi-essential, rsi-check's parts and rsi-aot need: a minute when it is at its key, 2.5 to 3 hours when its key moves
  ;; (the lowering's, repr/llvm's and repr/c's sources, the tools' host), hours that were rsi-essential's (its passes 11958-19767 s
  ;; against 1612-1924 s); bin/rsi runtime-ci takes .tmp/rsi/runtime.lock, so the parts never build it twice
  {:name rsi-runtime :mem-gib 8 :phase :full :chain rust-full
   :cmd "env ARBACE_PATH_FIRST=1 ARBACE_NO_AOT=1 ARBACE_NO_IMAGE=1 RSI_JOBS=2 RSI_THREADS=1 RSI_CI_MEMLIMIT=1400MiB bin/rsi runtime-ci"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["tools/rsdump/apks.sha256" "test/c/corpora.edn"]
   :inputs [:lib-tools :tools :rust :c :c-run :c2j-runtime]
   :summary ["^runtime-|^rsi: not read|/ci$|FAIL" 4]}
  {:name rsi-essential :mem-gib 8 :phase :full :chain rust-full :needs [rust-read-essential rsi-runtime]
   :cmd "env ARBACE_PATH_FIRST=1 ARBACE_NO_AOT=1 ARBACE_NO_IMAGE=1 RSI_JOBS=2 RSI_THREADS=1 RSI_BATCH=3 RSI_CI_MEMLIMIT=1400MiB bin/rsi check --essential"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["tools/rsdump/apks.sha256" "test/c/corpora.edn"]
   :inputs [:lib-tools :tools :rust :c :c-run :c2j-runtime]
   :summary ["^(samples|synthetic) |^rsi judge: control|^FAIL" 8]}
  {:name rust-roundtrip :mem-gib 16 :heavy true :phase :full
   :cmd "env REPR_RUST_JOBS=8 bin/repr-rust roundtrip --text {part}"
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["tools/rsdump/apks.sha256"]
   :inputs [:lib-tools :tools :rust]
   :parts [{:part rustc-1.99.1 :mem-gib 3 :clean-only true} {:part rustc-1.99.1-library :clean-only true} {:part rustc-1.99.1-compiler :mem-gib 3 :clean-only true}
           {:part crates-2026-10-18 :clean-only true} {:part rustc-1.99.1-ui :clean-only true}]
   :summary ["^repr-rust roundtrip|^DIFFERS|^FAIL" 6]}
  {:name rust-iface :mem-gib 4 :phase :oracle :chain rust-oracle
   :cmd "bin/repr-rust roundtrip --iface {part}"
   :hosts [:stage0 :rustc] :never-loads [arbace.j2g] :pins ["test/rust/corpus-rustc-1.99.1.edn"] :inputs [:lib-tools :tools :rust :rust-helper]
   :parts [{:part rustc-1.99.1} {:part crates-2026-10-18 :clean-only true :pins ["test/rust/corpus-crates-2026-10-18.edn"]}]
   :summary ["equal|known|differ|control|FAIL" 4]}
  {:name rust-behaviour :mem-gib 4 :phase :oracle :chain rust-oracle
   :cmd "bin/repr-rust roundtrip {part}"
   :hosts [:stage0 :rustc :gcc] :never-loads [arbace.j2g] :pins ["test/rust/corpus-rustc-1.99.1-ui.edn"] :inputs [:lib-tools :tools :rust :rust-helper]
   :parts [{:part run :cmd "bin/repr-rust roundtrip --run rustc-1.99.1-ui"} {:part std :cmd "bin/repr-rust roundtrip --std rustc-1.99.1-ui"}
           {:part code-std :cmd "bin/repr-rust roundtrip --code rustc-1.99.1"}]
   :summary ["same|differ|known|FAIL" 4]}
  ;; gate-split (2026-11-20; doc/GATE-DIET-SURVEY.md, "The long single steps split"): the two corpora in slices (bin/rsi check's --sample N
  ;; --offset K: every Nth program from the Kth, so the slices partition the corpus; each a subset run, CI_SUBSET), each part a chain of
  ;; its own (no :chain: side by side in --concurrent's lanes) and a work directory of its own; synthetic's one builder process over 67
  ;; programs (5523 s) in four (about 25 min each), the samples' (2183 s) in two; after rsi-runtime (the lowered std at its key)
  {:name rsi-check :mem-gib 4 :phase :weekly :needs [rsi-runtime]
   ;; the cover (doc/GATE-DIET-SURVEY.md, "As built: the 11-20 audit"): in the weekly tier, where it runs whole, rsi-essential (a :full
   ;; check) is covered: `bin/rsi check --essential` is test/rust/essential.txt's 13 synthetic programs, each in one of the synthetic
   ;; slices (they partition the corpus), judged by the same run judge; a control needs its subject alone in the run (its reference
   ;; the recorded rustc run), so each is judged in its subject's slice (RSI_BATCH only groups the builder's programs)
   :subsumes [rsi-essential]
   :cmd "env ARBACE_PATH_FIRST=1 ARBACE_NO_AOT=1 ARBACE_NO_IMAGE=1 RSI_JOBS=2 RSI_THREADS=1 RSI_CI_MEMLIMIT=1400MiB RSI_CHECK_WORK=.tmp/rsi-check.{part} bin/rsi check --corpus {part}"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["tools/rsdump/apks.sha256" "test/c/corpora.edn"]
   :inputs [:lib-tools :tools :rust :c :c-run :c2j-runtime]
   ;; GDS4 (a), GD1: weekly (2 h 08 min a night); GD3 (GDS4 (b), doc/GATE-DIET-SURVEY.md, "As built: GD3"): :phase :weekly (the step's, its parts)
   :parts [{:part samples-0 :cmd "env ARBACE_PATH_FIRST=1 ARBACE_NO_AOT=1 ARBACE_NO_IMAGE=1 RSI_JOBS=2 RSI_THREADS=1 RSI_CI_MEMLIMIT=1400MiB RSI_CHECK_WORK=.tmp/rsi-check.{part} bin/rsi check --corpus samples --sample 2 --offset 0"}
           {:part samples-1 :cmd "env ARBACE_PATH_FIRST=1 ARBACE_NO_AOT=1 ARBACE_NO_IMAGE=1 RSI_JOBS=2 RSI_THREADS=1 RSI_CI_MEMLIMIT=1400MiB RSI_CHECK_WORK=.tmp/rsi-check.{part} bin/rsi check --corpus samples --sample 2 --offset 1"}
           {:part synthetic-0 :cmd "env ARBACE_PATH_FIRST=1 ARBACE_NO_AOT=1 ARBACE_NO_IMAGE=1 RSI_JOBS=2 RSI_THREADS=1 RSI_CI_MEMLIMIT=1400MiB RSI_CHECK_WORK=.tmp/rsi-check.{part} bin/rsi check --corpus synthetic --sample 4 --offset 0"}
           {:part synthetic-1 :cmd "env ARBACE_PATH_FIRST=1 ARBACE_NO_AOT=1 ARBACE_NO_IMAGE=1 RSI_JOBS=2 RSI_THREADS=1 RSI_CI_MEMLIMIT=1400MiB RSI_CHECK_WORK=.tmp/rsi-check.{part} bin/rsi check --corpus synthetic --sample 4 --offset 1"}
           {:part synthetic-2 :cmd "env ARBACE_PATH_FIRST=1 ARBACE_NO_AOT=1 ARBACE_NO_IMAGE=1 RSI_JOBS=2 RSI_THREADS=1 RSI_CI_MEMLIMIT=1400MiB RSI_CHECK_WORK=.tmp/rsi-check.{part} bin/rsi check --corpus synthetic --sample 4 --offset 2"}
           {:part synthetic-3 :cmd "env ARBACE_PATH_FIRST=1 ARBACE_NO_AOT=1 ARBACE_NO_IMAGE=1 RSI_JOBS=2 RSI_THREADS=1 RSI_CI_MEMLIMIT=1400MiB RSI_CHECK_WORK=.tmp/rsi-check.{part} bin/rsi check --corpus synthetic --sample 4 --offset 3"}]
   :summary ["^(samples|synthetic) |^rsi judge: control|^FAIL" 8]}
  ;; the 11-20 audit, at gate-split-1120's merge: its chain starts after rsi-runtime, which it needs (test/gate/chain-needs-test.bash)
  {:name rsi-aot :mem-gib 6 :phase :full :chain rust-aot :needs [rsi-runtime] :start-after rsi-runtime
   :cmd "env ARBACE_PATH_FIRST=1 ARBACE_NO_AOT=1 ARBACE_NO_IMAGE=1 RSI_JOBS=1 RSI_THREADS=1 RSI_SHARD=1 RSI_GO_P=1 RSI_CI_MEMLIMIT=1400MiB bin/rsi check --aot --corpus samples"
   :hosts [:stage0 :go] :never-loads [arbace.j2g] :pins ["tools/rsdump/apks.sha256" "test/c/corpora.edn" "seed/goroot.sha256"]
   :inputs [:lib-tools :tools :rust :rsi :c :c-run :c2j-runtime]
   ;; queue 362 (D354-2 (a), the user 2026-11-18): the samples a :phase :weekly part (6 programs, about 30 minutes), so that the
   ;; AOT cell's record (test/rust/check-aot-linux-amd64.edn) is judged every week, not only at a tag's clean run
   :parts [{:part samples :phase :weekly}] :summary ["pass|fail|class" 3]}
  ;; ---- LLVM IR's interim step (GTS221 (a), half a share): the round trip over the C++ runtime's lowered IR
  {:name llvm-roundtrip :mem-gib 3 :phase :full :chain llvm-full :needs [cpp-runtime]
   :cmd "bin/repr-llvm roundtrip .tmp/cppi/runtime/ir-units.txt .tmp/gate/llvm-roundtrip"
   :hosts [:stage0 :cxx :llvm] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn"] :inputs [:lib-tools :tools :llvm]
   :summary ["same|differ|control|FAIL" 3]}
;;@ crops
         :rust [rust-read-essential rsi-runtime rsi-essential rust-roundtrip rust-iface rust-behaviour rsi-check rsi-aot]
         :llvm [llvm-roundtrip]
;;@ controls
  rust-read-essential ["test/rust/roundtrip-edit-controls.edn" {:waived "the judges' own tests: each a negative case (rust-90)"}]
  rsi-essential "test/rust/controls.edn"
  rsi-runtime {:waived "a build (gate-split): the lowered std read as ci's library, no verdict; rsi-essential's and rsi-check's controls judge what runs on it"}
  rust-roundtrip "test/rust/roundtrip-controls.edn"
  rust-iface "test/rust/roundtrip-controls.edn"
  rust-behaviour {:waived "no crossed pair: each program built on both sides (GT9.8 \"Not covered\"; GTS242)"}
  rsi-check "test/rust/controls.edn"
  rsi-aot "test/rust/controls.edn"
  llvm-roundtrip "test/repr/llvm/roundtrip-controls.txt"

;; GT9 (doc/GATE-SURVEY.md, "As built: GT9 (write-ahead)"): merge plan batch 2 (rust-re4, llvm-read and its line, after batch 1's
;; C++ steps): Rust's read and print (main's verbs) with rsi on ci (rust-re4), and LLVM IR's interim step (GTS221 (a)). Splice
;; after test/gate/crops/cpp.edn (rsi and llvm need cpp-runtime). rust-read-essential runs `test --samples` (cases 1-4 and 6-8: about 35 s
;; of the 68 s; gt9v-rust, on rust-re5, which also has `roundtrip --only-list FILE` and `pins check`); native-check is rust-native's
;; (batch 3: crops/natives.edn). The round trip's corpora run whole: std's levels (3 min) and the UI's tree and text (about 3 min)
;; nightly; library, compiler and the crates (23 min) stay :clean-only parts: --only-list exists, but a rotation needs a universe of ids
;; and a subset (a record of the files, one a line: none yet for Rust), and 22 + a rotated 4-6 min is over the share (24.3). LLVM: repr/llvm's round trip over C++'s pinned runtime IR (the verb
;; on llvm-read is `bin/repr-llvm roundtrip LIST WORK`; GT9.4's roundtrip-corpus is NEW), its list test/llvm/essential.txt NEW (LL1):
;; until LL1 the step takes the runtime's units through cppi's work directory, a plan without them is GTS221's open item
;; rsi-aot (6 GiB, 18 min a program, :clean-only) runs in the serial run: a chain of its own that needs no rust-full step, so that
;; rust-full stays light and beside it (GTS216)
;;@ groups
  :rust ["bin/repr-rust" "bin/lib/repr-rust/" "arbace/repr/rust.ae" "arbace/repr/rust/" "tools/rsdump/" "test/rust/"]
  ;; rsi (RE1-RE4): rustc's IR lowered by arbace/rust and the shared lowering (C++'s :cpp), run on ci
  :rsi ["bin/rsi" "bin/lib/rsi/" "arbace/rust/" "arbace/cpp/"]
  :llvm ["bin/repr-llvm" "arbace/repr/llvm.ae" "arbace/repr/llvm/" "test/cpp/runtime/" "test/repr/llvm/"]
;;@ steps
  ;; ---- Rust (RR1-RR6, RE4; GT9): essential one chain (test 58 s, three ci programs), the chain rust-full at night
  {:name rust-read-essential :mem-gib 2 :phase :essential :chain rust-essential
   :cmd "bin/repr-rust test --samples"
   :hosts [:stage0 :rustc] :never-loads [arbace.j2g] :pins ["test/rust/corpus-rustc-1.99.1.edn" "tools/rsdump/apks.sha256"]
   :inputs [:lib-tools :tools :rust] :summary ["ok|equal|differ|FAIL" 4]}
  {:name rsi-essential :mem-gib 3 :phase :essential :chain rust-essential :needs [rust-read-essential cpp-runtime]
   :cmd "bin/rsi check --corpus samples"
   :hosts [:stage0 :go :rustc :cxx :gcc] :never-loads [arbace.j2g] :inputs [:lib-tools :tools :rust :rsi :c-run]
   :summary ["pass|fail|control|FAIL" 4]}
  {:name rust-roundtrip :mem-gib 4 :phase :full :chain rust-full
   :cmd "bin/repr-rust roundtrip --text --pretty {part}"
   :hosts [:stage0 :rustc] :never-loads [arbace.j2g] :inputs [:lib-tools :tools :rust]
   :parts [{:part rustc-1.99.1 :pins ["test/rust/corpus-rustc-1.99.1.edn"]}
           {:part rustc-1.99.1-ui :cmd "bin/repr-rust roundtrip --text rustc-1.99.1-ui" :pins ["test/rust/corpus-rustc-1.99.1-ui.edn"]}
           {:part rustc-1.99.1-library :clean-only true :pins ["test/rust/corpus-rustc-1.99.1-library.edn"]}
           {:part rustc-1.99.1-compiler :clean-only true :pins ["test/rust/corpus-rustc-1.99.1-compiler.edn"]}
           {:part crates-2026-10-18 :clean-only true :pins ["test/rust/corpus-crates-2026-10-18.edn" "test/rust/crates-2026-10-18.sha256"]}]
   :summary ["equal|known|differ|control|FAIL" 4]}
  {:name rust-iface :mem-gib 4 :phase :full :chain rust-full
   :cmd "bin/repr-rust roundtrip --iface {part}"
   :hosts [:stage0 :rustc] :never-loads [arbace.j2g] :pins ["test/rust/corpus-rustc-1.99.1.edn"] :inputs [:lib-tools :tools :rust]
   :parts [{:part rustc-1.99.1} {:part crates-2026-10-18 :clean-only true :pins ["test/rust/corpus-crates-2026-10-18.edn"]}]
   :summary ["equal|known|differ|control|FAIL" 4]}
  {:name rust-behaviour :mem-gib 4 :phase :full :chain rust-full
   :cmd "bin/repr-rust roundtrip {part}"
   :hosts [:stage0 :rustc :gcc] :never-loads [arbace.j2g] :pins ["test/rust/corpus-rustc-1.99.1-ui.edn"] :inputs [:lib-tools :tools :rust]
   :parts [{:part run :cmd "bin/repr-rust roundtrip --run rustc-1.99.1-ui"} {:part std :cmd "bin/repr-rust roundtrip --std rustc-1.99.1-ui"}
           {:part code-std :cmd "bin/repr-rust roundtrip --code rustc-1.99.1"}]
   :summary ["same|differ|known|FAIL" 4]}
  {:name rsi-check :mem-gib 4 :phase :full :chain rust-full :needs [cpp-runtime]
   :cmd "bin/rsi check --corpus {part}"
   :hosts [:stage0 :go :rustc :cxx :gcc] :never-loads [arbace.j2g] :inputs [:lib-tools :tools :rust :rsi :c-run]
   :parts [{:part samples} {:part ui :cmd "bin/rsi check --corpus ui --sample 40"}]
   :summary ["pass|fail|class|control" 4]}
  {:name rsi-aot :mem-gib 6 :phase :full :chain rust-aot :needs [cpp-runtime]
   :cmd "bin/rsi check --aot --corpus samples"
   :hosts [:stage0 :go :rustc :cxx :gcc] :never-loads [arbace.j2g] :inputs [:lib-tools :tools :rust :rsi :c-run]
   :parts [{:part samples :clean-only true}] :summary ["pass|fail|class" 3]}
  ;; ---- LLVM IR's interim step (GTS221 (a), half a share): the round trip over the C++ runtime's lowered IR
  {:name llvm-roundtrip :mem-gib 3 :phase :full :chain llvm-full :needs [cpp-runtime]
   :cmd "bin/repr-llvm roundtrip .tmp/cppi/runtime/ir-units.txt .tmp/gate/llvm-roundtrip"
   :hosts [:stage0 :cxx :llvm] :never-loads [arbace.j2g] :pins ["test/cpp/corpora.edn"] :inputs [:lib-tools :tools :llvm]
   :summary ["same|differ|control|FAIL" 3]}
;;@ crops
         :rust [rust-read-essential rsi-essential rust-roundtrip rust-iface rust-behaviour rsi-check rsi-aot]
         :llvm [llvm-roundtrip]
;;@ controls
  rust-read-essential {:waived "repr/rust's test: its built-in negative cases (GT9.2)"}
  rsi-essential "test/rust/controls.edn"
  rust-roundtrip "test/rust/roundtrip-controls.edn"
  rust-iface "test/rust/roundtrip-controls.edn"
  rust-behaviour {:waived "no crossed pair: each program built on both sides (GT9.8 \"Not covered\"; GTS242)"}
  rsi-check "test/rust/controls.edn"
  rsi-aot "test/rust/controls.edn"
  llvm-roundtrip "test/repr/llvm/roundtrip-controls.txt"

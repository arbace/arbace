;; OC180 (a) (the user, 2026-11-07; doc/ocaml/OCAML-SURVEY.md, "As built: the typer line's merge"): OCaml's oracle tier, the steps that run
;; the host's OCaml (the host :ocaml: ocamlc, ocamlopt, compiler-libs, the oracle tools/ocdump), by hand at a tag. They wait here for the
;; planner's :phase :oracle (bin/gate --oracle, mac/oracle-records-cpp2's ORS1 (a), ORS8 (a)): splice this fragment after that branch's merge.
;; ocaml-dumps is batch 1's step moved off --full; ocaml-oracle gathers the levels moved out of the live steps: corpus check's host pins,
;; the helper's .cmi round trip (roundtrip --cmi, --cmi-only for the rest), the spec's extraction, native-check (the native reader against
;; ocdump), stdlib-check and typer-check (the typer against ocamlc's library and the oracle's dumps), and suite expect (the expect action on the
;; ocaml toplevel)
;;@ steps
  {:name ocaml-dumps :mem-gib 2 :phase :oracle :chain ocaml-full
   :cmd "bin/repr-ocaml dumps && bin/repr-ocaml samples"
   :hosts [:stage0 :ocaml] :never-loads [arbace.j2g] :pins ["test/ocaml/corpora.edn"]
   :inputs [:lib-base :lib-tools :tools :ocaml]
   :summary ["^dumps|FLOOR|unstable|FAIL|ok" 6]}
  {:name ocaml-oracle :mem-gib 2 :phase :oracle :chain ocaml-full
   :cmd "bin/repr-ocaml corpus check --host && bin/repr-ocaml roundtrip --reader helper --cmi samples stdlib && bin/repr-ocaml roundtrip --spec && bin/repr-ocaml spec-check && bin/repr-ocaml native-check samples stdlib && bin/oi stdlib-check && bin/oi typer-check && bin/oi suite expect"
   :hosts [:stage0 :go :ocaml] :never-loads [arbace.j2g] :pins ["test/ocaml/corpora.edn"]
   :inputs [:lib-base :lib-tools :tools :ocaml :ocaml-run]
   :parts [{:part main} {:part cmi-rest :clean-only true
                         :cmd "bin/repr-ocaml roundtrip --cmi-only compiler-sources compiler-backend testsuite whiml opam"}]
   :summary ["^compare: |^full: |cmi: |spec|native-check|stdlib-check|typer-check|expect|FAIL|DIFF" 12]}
;;@ crops
         :ocaml [ocaml-dumps ocaml-oracle]
;;@ controls
  ocaml-dumps {:waived "the typed and Lambda dumps against their known file and floors, with the determinism test; no crossed pair (GT9.8: not a read or print family)"}
  ocaml-oracle "test/ocaml/native-controls.txt"

;; ORS1 (a), ORS8 (a), ORS12 (queue 213, doc/ORACLE-RECORDS-SURVEY.md "As built: Python"): Python's oracle tier, the only Python steps on
;; the host :python (python3: steps.edn's :host-ids :python), :phase :oracle (bin/gate --oracle), absent where python3 is not, never in
;; the essential gate, --full or the clean run, required at a tag. Queue 258 moved them out of python.edn as OCaml's are in
;; ocaml-oracle.edn; spliced after python.edn (same command) by queue 317 but python-records-verify, whose pins are the records
;; night's packs: it waits in python-night.edn.
;;   - python-records-verify: every record against python3 afresh, by the checks in mode verify (ORS6 (a): a moved python3 reported,
;;     not failed; each part's crossed pair, ORS7 (a)); the big corpora a sample of 64 files a night (bin/repr-python records verify
;;     CORPUS, every file, at a tag's oracle run)
;;   - python-roundtrip-oracle: the round trips' levels 2, 3 and 5, CPython on the print (class D), live
;;   - pyi-oracle: CPython's runs verified (record-ref --check, two runs each), the generated Unicode and CJK tables against their
;;     generators, pip on pyi beside CPython's pip, and CPython's speed (the bench, at a tag)
;;@ steps
  {:name python-roundtrip-oracle :mem-gib 2 :phase :oracle :chain python-oracle
   :cmd "REPR_PYTHON_ORACLE=live bin/repr-python roundtrip {part} && REPR_PYTHON_ORACLE=live bin/repr-python roundtrip --text {part}"
   :hosts [:stage0 :python] :never-loads [arbace.j2g] :pins ["test/python/corpora.edn" "tools/pydump/PYTHON_VERSION"]
   :inputs [:lib-tools :tools :python]
   :parts [{:part samples} {:part stdlib} {:part site-packages} {:part lib-test}] :summary ["^roundtrip|FAIL|control" 6]}
  {:name pyi-oracle :mem-gib 3 :phase :oracle :chain python-oracle
   :cmd "bin/pyi record-ref --check"
   :hosts [:stage0 :go :python] :never-loads [arbace.j2g] :pins ["test/python/corpora.edn" "tools/pydump/PYTHON_VERSION" "test/python/wheels.edn"]
   :inputs [:lib-tools :tools :python :pyi]
   :parts [{:part refs} {:part tables :cmd "bin/pyi runtime tables"}
           {:part pip-probe :cmd "bin/pyi wheels fetch && bin/pyi wheels pip-probe"}
           {:part bench :cmd "bin/pyi bench"}]
   :summary ["^check|differs|DIFFERS|^runtime|^wheels|benchmarks|classed|FAIL|control" 6]}
;;@ crops
         :python [python-roundtrip-oracle pyi-oracle]
;;@ controls
  python-roundtrip-oracle "test/python/controls-read.edn"
  pyi-oracle {:waived "record-ref --check judges two runs against the references (tools/pydump/refs.py check), the tables are regenerations compared byte for byte, pip-probe's controls are bin/pyi's, the bench is a speed record"}

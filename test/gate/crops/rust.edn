;; GT9's Rust fragment (gt9-verbs: test/gate/crops/llvm-rust.edn, "merge plan batch 2": rust-re4 and rsi on ci) with rustc's answers as records
;; (ORS12, doc/ORACLE-RECORDS-SURVEY.md, "As built: Rust", branch oracle-records-rust; LLVM IR's interim step stays gt9-verbs'). On merge, take
;; this file's side for the Rust steps.
;;   - rust-read-essential loses :rustc: `bin/repr-rust test` answers the originals from test/rust/records/ (committed); rustc's reading of
;;     Arbace's print (class D) is `test --oracle`, the oracle tier's rust-test-oracle. gt9-verbs' `test --samples` (cases 1-4 and 6-8, on
;;     rust-re5) is the same script's option when the branches meet; the step runs the whole test, 55 s here.
;;   - rsi-essential, rsi-check and rsi-aot lose :rustc: the programs' IR (the oracle's -O0 IR and the allocator shim's) are the packs
;;     rust-ir-samples and rust-ir-synthetic, std's IR the pack rust-std-ir (the units' digests are test/rust/runtime/ir.sha256's, unchanged);
;;     their :pins name the packs. rsi-check's ui part waits for rust-ir-ui (the UI suite's tarball, network: the night's recording): until
;;     then it is not in the table (synthetic, recorded, takes its place).
;;   - rust-roundtrip, rust-iface and rust-behaviour become the oracle tier's (rustc reads and builds Arbace's print, class D, at every
;;     level; `--std` and `--code` too): the round trip's originals' dumps and trees come from the packs for rustc-1.99.1; the larger
;;     corpora (library, compiler, the crates, the UI suite) run live (REPR_RUST_LIVE=1) until their packs are recorded.
;;   - rust-records-verify is the verify of the kinds (test-dumps, corpus-dumps, std-ir, ir), a sample a night.
;;@ groups
  :rust ["bin/repr-rust" "bin/lib/repr-rust/" "bin/oracle-records" "test/oracle-records/" "arbace/repr/rust.ae" "arbace/repr/rust/" "tools/rsdump/" "test/rust/"]
  ;; rsi (RE1-RE4): rustc's IR lowered by arbace/rust and the shared lowering (C++'s :cpp), run on ci
  :rsi ["bin/rsi" "bin/lib/rsi/" "arbace/rust/" "arbace/cpp/"]
;;@ steps
  ;; ---- Rust (RR1-RR6, RE4; GT9, ORS12): essential one chain (test 55 s, three ci programs), the oracle tier at night
  {:name rust-read-essential :mem-gib 2 :phase :essential :chain rust-essential
   :cmd "bin/repr-rust test"
   :hosts [:stage0] :never-loads [arbace.j2g] :pins ["test/rust/corpus-rustc-1.99.1.edn" "tools/rsdump/apks.sha256"]
   :inputs [:lib-tools :tools :rust] :summary ["ok|equal|differ|FAIL|skipped|STALE|UNRECORDED|REFUSED" 4]}
  {:name rsi-essential :mem-gib 3 :phase :essential :chain rust-essential :needs [rust-read-essential cpp-runtime]
   :cmd "bin/rsi check --corpus samples"
   :hosts [:stage0 :go :cxx :gcc] :never-loads [arbace.j2g]
   :pins ["test/rust/records/rust-ir-samples.sha256" "test/rust/records/rust-std-ir.sha256"]
   :inputs [:lib-tools :tools :rust :rsi :c-run]
   :summary ["pass|fail|control|FAIL|STALE|UNRECORDED|REFUSED" 4]}
  {:name rsi-check :mem-gib 4 :phase :full :chain rust-full :needs [cpp-runtime]
   :cmd "bin/rsi check --corpus {part}"
   :hosts [:stage0 :go :cxx :gcc] :never-loads [arbace.j2g]
   :pins ["test/rust/records/rust-std-ir.sha256"]
   :inputs [:lib-tools :tools :rust :rsi :c-run]
   :parts [{:part samples :pins ["test/rust/records/rust-ir-samples.sha256"]}
           {:part synthetic :pins ["test/rust/records/rust-ir-synthetic.sha256"]}]
   :summary ["pass|fail|class|control|STALE|UNRECORDED|REFUSED" 4]}
  {:name rsi-aot :mem-gib 6 :phase :full :chain rust-aot :needs [cpp-runtime]
   :cmd "bin/rsi check --aot --corpus samples"
   :hosts [:stage0 :go :cxx :gcc] :never-loads [arbace.j2g]
   :pins ["test/rust/records/rust-ir-samples.sha256" "test/rust/records/rust-std-ir.sha256"]
   :inputs [:lib-tools :tools :rust :rsi :c-run]
   :parts [{:part samples :clean-only true}] :summary ["pass|fail|class|STALE|UNRECORDED|REFUSED" 3]}
  ;; ---- Rust's oracle tier (ORS1 (a), ORS8 (a), ORS12): the only Rust steps on :rustc, :phase :oracle (bin/gate --oracle), absent where the
  ;; host lacks rustc, never in the essential gate, --full or the clean run, required at a tag. rust-test-oracle: bin/repr-rust test with rustc
  ;; reading the print; rust-roundtrip-oracle, rust-iface-oracle, rust-behaviour-oracle: the round trip's levels, the originals' dumps and trees
  ;; from the packs (rustc-1.99.1; the larger corpora live), rustc on the print; rust-records-verify: the helper's and rustc's live answers against
  ;; the records (ORS6 (a): a moved toolchain reported, not failed), each kind with its crossed pair, a sample a night
  {:name rust-test-oracle :mem-gib 3 :phase :oracle :chain rust-oracle
   :cmd "bin/repr-rust test --oracle"
   :hosts [:stage0 :rustc :gcc] :never-loads [arbace.j2g] :pins ["test/rust/corpus-rustc-1.99.1.edn" "tools/rsdump/apks.sha256"]
   :inputs [:lib-tools :tools :rust] :summary ["ok|equal|differ|FAIL" 4]}
  {:name rust-roundtrip-oracle :mem-gib 4 :phase :oracle :chain rust-oracle
   :cmd "bin/repr-rust roundtrip --text --pretty {part}"
   :hosts [:stage0 :rustc] :never-loads [arbace.j2g] :inputs [:lib-tools :tools :rust]
   :parts [{:part rustc-1.99.1 :pins ["test/rust/corpus-rustc-1.99.1.edn" "test/rust/records/rust-dumps-rustc-1.99.1.sha256"
                                      "test/rust/records/rust-dumps-full-rustc-1.99.1.sha256" "test/rust/records/rust-trees-rustc-1.99.1.sha256"]}
           {:part rustc-1.99.1-ui :cmd "REPR_RUST_LIVE=1 bin/repr-rust roundtrip --text rustc-1.99.1-ui" :pins ["test/rust/corpus-rustc-1.99.1-ui.edn"]}
           {:part rustc-1.99.1-library :clean-only true :cmd "REPR_RUST_LIVE=1 bin/repr-rust roundtrip --text --pretty rustc-1.99.1-library" :pins ["test/rust/corpus-rustc-1.99.1-library.edn"]}
           {:part rustc-1.99.1-compiler :clean-only true :cmd "REPR_RUST_LIVE=1 bin/repr-rust roundtrip --text --pretty rustc-1.99.1-compiler" :pins ["test/rust/corpus-rustc-1.99.1-compiler.edn"]}
           {:part crates-2026-10-18 :clean-only true :cmd "REPR_RUST_LIVE=1 bin/repr-rust roundtrip --text --pretty crates-2026-10-18"
            :pins ["test/rust/corpus-crates-2026-10-18.edn" "test/rust/crates-2026-10-18.sha256"]}]
   :summary ["equal|known|differ|control|FAIL" 4]}
  {:name rust-iface-oracle :mem-gib 4 :phase :oracle :chain rust-oracle
   :cmd "bin/repr-rust roundtrip --iface {part}"
   :hosts [:stage0 :rustc] :never-loads [arbace.j2g] :pins ["test/rust/corpus-rustc-1.99.1.edn" "test/rust/records/rust-dumps-rustc-1.99.1.sha256" "test/rust/records/rust-trees-rustc-1.99.1.sha256"]
   :inputs [:lib-tools :tools :rust]
   :parts [{:part rustc-1.99.1} {:part crates-2026-10-18 :clean-only true :cmd "REPR_RUST_LIVE=1 bin/repr-rust roundtrip --iface crates-2026-10-18" :pins ["test/rust/corpus-crates-2026-10-18.edn"]}]
   :summary ["equal|known|differ|control|FAIL" 4]}
  {:name rust-behaviour-oracle :mem-gib 4 :phase :oracle :chain rust-oracle
   :cmd "REPR_RUST_LIVE=1 bin/repr-rust roundtrip {part}"
   :hosts [:stage0 :rustc :gcc] :never-loads [arbace.j2g] :pins ["test/rust/corpus-rustc-1.99.1-ui.edn"] :inputs [:lib-tools :tools :rust]
   :parts [{:part run :cmd "REPR_RUST_LIVE=1 bin/repr-rust roundtrip --run rustc-1.99.1-ui"} {:part std :cmd "REPR_RUST_LIVE=1 bin/repr-rust roundtrip --std rustc-1.99.1-ui"}
           {:part code-std :cmd "bin/repr-rust roundtrip --code rustc-1.99.1" :pins ["test/rust/records/rust-dumps-rustc-1.99.1.sha256" "test/rust/records/rust-trees-rustc-1.99.1.sha256"]}]
   :summary ["same|differ|known|FAIL" 4]}
  {:name rust-records-verify :mem-gib 3 :phase :oracle :chain rust-oracle
   :cmd "bin/oracle-records verify rust test-dumps corpus-dumps std-ir ir --sample 8"
   :hosts [:stage0 :rustc :gcc] :never-loads [arbace.j2g]
   :pins ["test/rust/records/rust-dumps-rustc-1.99.1.sha256" "test/rust/records/rust-std-ir.sha256" "test/rust/records/rust-ir-samples.sha256" "test/rust/records/rust-ir-synthetic.sha256"]
   :inputs [:lib-tools :tools :rust :rsi]
   :summary ["^verify|FAIL|control" 12]}
;;@ crops
         :rust [rust-read-essential rsi-essential rsi-check rsi-aot rust-test-oracle rust-roundtrip-oracle rust-iface-oracle rust-behaviour-oracle rust-records-verify]
;;@ controls
  rust-read-essential {:waived "repr/rust's test: its built-in negative cases (GT9.2): a changed doc comment found different, a renamed form printed with the name changed, edition 2015 not parsing at 2018"}
  rsi-essential "test/rust/controls.edn"
  rsi-check "test/rust/controls.edn"
  rsi-aot "test/rust/controls.edn"
  rust-test-oracle {:waived "the same cases as rust-read-essential with rustc reading the print: the cases' own differ checks"}
  rust-roundtrip-oracle "test/rust/roundtrip-controls.edn"
  rust-iface-oracle "test/rust/roundtrip-controls.edn"
  rust-behaviour-oracle {:waived "no crossed pair: each program built on both sides (GT9.8 \"Not covered\"; GTS242)"}
  rust-records-verify {:waived "the verifies' own crossed pairs (one unit's live output against another's entry, which must differ: control passed or the verify fails)"}

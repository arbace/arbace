;; The Haskell front end's run checks as gate steps, prepared (the user's decision 1 (a) of 2026-11-06,
;; doc/haskell/FRONTEND-SURVEY.md, "Decided (2026-11-06, ...)"): to be merged into test/gate/steps.edn, beside the step
;; haskell-front's typecheck-check, once haskell-integrate is on main (HF5-HF6's decision 4's condition); not read by
;; the planner before then. The essential gate runs the run corpus (63 programs, about 5 minutes on four shards, at most
;; 1.6 GB a process, hsi at its light caps), --full the 53 single-module nofib programs (about 25 minutes) with hsi's
;; night caps (decision 4: ARBACE_MEM_GIB 16, HSI_TIMEOUT 60). The libraries' STG are the oracle pack haskell-stg-libs
;; pinned by its digest (HSI_LIBS, :pins); the GHC tarball's nofib by its SHA-256 (test/haskell/corpus-ghc-9.14.1.edn).
[{:name haskell-run-check :mem-gib 7 :phase :essential :chain haskell-front
  :cmd "bin/repr-haskell run-check"
  :hosts [:stage0 :ghc] :pins ["tools/hsdump/GHC_VERSION"]
  :inputs ["arbace/repr/haskell.ae" "arbace/repr/haskell/" "bin/repr-haskell" "bin/hsi" "bin/lib/tools.bash" "tools/hsdump/"
           "test/haskell/eval/" "test/haskell/ref-ghc914.edn" "test/haskell/run-check.edn" "test/haskell/run_record.ae"]
  :env ["HSI_LIBS" "REPR_HASKELL_SIMPL"]
  :summary ["^run-check:" 4]}
 {:name haskell-run-check-nofib :mem-gib 20 :phase :full :chain haskell-front :needs [haskell-run-check]
  :cmd "env ARBACE_MEM_GIB=16 HSI_TIMEOUT=60 bin/repr-haskell run-check --nofib"
  :hosts [:stage0 :ghc] :pins ["tools/hsdump/GHC_VERSION" "test/haskell/corpus-ghc-9.14.1.edn"]
  :inputs ["arbace/repr/haskell.ae" "arbace/repr/haskell/" "bin/repr-haskell" "bin/hsi" "bin/lib/tools.bash" "tools/hsdump/"
           "test/haskell/run-check-nofib.txt" "test/haskell/ref-nofib.edn" "test/haskell/run-check-nofib.edn"
           "test/haskell/run_record.ae"]
  :env ["HSI_LIBS" "REPR_HASKELL_NOFIB" "REPR_HASKELL_SIMPL"]
  :summary ["^run-check:" 4]}]

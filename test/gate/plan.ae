(ns gate.plan
  "bin/gate's planner (doc/GATE-SURVEY.md, GT2, GTS2 (a), GTS3 (a), GTS6 (a), GTS7 (a), \"As built:
  GT1-GT3\", \"As built: GT4, GT6\"): reads the steps test/gate/steps.edn declares, validates the
  table (GTS29 (a)), computes each step's key over its declared inputs and decides, against the
  store of passes, which steps run.

  A check's key is the SHA-256 of its material, one line per input: the step's declaration (but
  :doc, :summary, :mem-gib, :heavy and :audit-cmd), the gate's logic (the runner bin/lib/gate-run.bash, this file: GTS22
  (a); bin/gate's header, summary and option parsing are not in a key), each host's identity, each
  pin's and each input file's SHA-256, each declared environment variable's value. Never the
  commit. A pass of that key in the store (STORE/NAME/KEY.edn, bin/gate writes it) skips the step.
  A build runs when a check that runs needs it; an :always step runs.

  -main plan ROOT LOGS STORE MODE [--rerun]
      MODE essential or full; LOGS holds files.sha256 (sha256sum's lines of the checkout's files,
      bin/gate's) and hosts.edn ({:gate ID ...}); writes LOGS/plan.tsv (one step a line, the
      columns NAME DECISION KEY PHASE CHAIN NEEDS START-AFTER HEAVY MEM-GIB BUDGET-S SUMMARY-N SUMMARY-RE
      WHY AUDIT-CMD OUTPUTS USES KIND CMD, '-' for an empty one; DECISION after: the runner keys the step
      once its :uses' producers ran (GT5); HEAVY yes, inner or -; BUDGET-S: three times the longest of the step's last three passes,
      GTS17 (a); GATE_STEPS names another table, for the gate's own tests), LOGS/plan/NAME.inputs (each step's material) and prints the plan: each step,
      its decision and why. --rerun: every check runs (passes are still recorded)
  -main why ROOT LOGS STORE NAME
      after a plan: the step's material, its passes, and what changed since the latest one"
  (:require [arbace.string :as str]
            [arbace.java.io :as io])
  (:import (java.io File PushbackReader)
           (java.security MessageDigest)))

(defn- read-file [^String f]
  (with-open [r (PushbackReader. (io/reader f))]
    (read r)))

(defn- sha256 [^String s]
  (let [md (MessageDigest/getInstance "SHA-256")]
    (.update md (.getBytes s "UTF-8"))
    (apply str (map #(format "%02x" (bit-and (long %) 0xff)) (.digest md)))))

(defn list-sha
  "GT8.4: a rotated check's list digested (its ids, one a line), as its key's line list SHA N and the runs' LIST-SHA"
  [ids] (sha256 (apply str (map #(str % "\n") ids))))

(defn- hex [^bytes b] (apply str (map #(format "%02x" (bit-and (long %) 0xff)) b)))

(defn- file-sha256 [^File f]
  (let [md (MessageDigest/getInstance "SHA-256")]
    (.update md (java.nio.file.Files/readAllBytes (.toPath f)))
    (hex (.digest md))))

(defn- tree-files
  "the files under DIR, relative, sorted as LC_ALL=C sort sorts them"
  [^File dir]
  (let [base (inc (count (.getPath dir)))]
    (sort (for [^File f (file-seq dir) :when (.isFile f)] (subs (.getPath f) base)))))

(defn out-digest
  "GT5: the digest of a step's output, as the runner (bin/lib/gate-run.bash's out_sha) computes it: a
  file's SHA-256; a directory's, the SHA-256 of sha256sum's lines (HASH, two spaces, PATH) of its files
  in order; \"missing\" when there is none"
  [^File f]
  (cond
    (.isFile f) (file-sha256 f)
    (.isDirectory f) (sha256 (apply str (for [r (tree-files f)] (str (file-sha256 (File. f ^String r)) "  " r "\n"))))
    :else "missing"))

(defn- files-table
  "{path sha} from sha256sum's lines"
  [f]
  (into (sorted-map)
        (for [l (str/split-lines (slurp f)) :when (> (count l) 66)]
          [(subs l 66) (subs l 0 64)])))

(defn- glob-re
  "a glob's regular expression: ** any path, * within a name, every other character itself (queue 023,
  report 022 finding 9: each of the regex's special characters quoted, not only .)"
  [^String g]
  (let [special (set "\\.[]{}()+?^$|")
        lit (fn [^String t] (apply str (map (fn [c] (if (contains? special c) (str "\\" c) (str c))) t)))]
    (re-pattern (str "^"
                     (apply str (map (fn [t] (case t "**" ".*" "*" "[^/]*" (lit t))) (re-seq #"\*\*|\*|[^*]+" g)))
                     "$"))))

(defn- rule-matcher [^String r]
  (cond
    (str/ends-with? r "/") (fn [p] (str/starts-with? p r))
    (str/includes? r "*") (let [re (glob-re r)] (fn [p] (boolean (re-find re p))))
    :else (fn [p] (= p r))))

(defn- expand
  "the rules of an :inputs vector, groups expanded, in order: [[include? pattern] ...]"
  [groups inputs]
  (vec (mapcat (fn [x]
                 (if (keyword? x)
                   (let [g (get groups x)]
                     (when-not g (throw (ex-info (str "steps.edn: no group " x) {})))
                     (expand groups g))
                   (let [s (str x)]
                     (if (str/starts-with? s "!") [[false (subs s 1)]] [[true s]]))))
               inputs)))

(defn- matching
  "the files of PATHS the rules select (the last rule that matches a file decides), memoized per
  pattern in CACHE"
  [cache paths rules]
  (reduce (fn [acc [inc? pat]]
            (let [m (or (get @cache pat)
                        (let [f (rule-matcher pat)
                              v (set (filter f paths))]
                          (swap! cache assoc pat v)
                          v))]
              (if inc? (into acc m) (reduce disj acc m))))
          #{} rules))

;; ---- GT5: parts (one step per corpus), the outputs a step uses, the program's units

(defn- part-name [nm p] (str nm "." p))

(defn expand-parts
  "the steps with :parts expanded into one step per part, NAME.PART (GT5, the survey's 4.6): each the
  step's declaration less :parts, the part's :inputs and :pins after the step's, the part's other keys
  over the step's, {part} in :cmd and :audit-cmd its name. A part :clean-only true (GTS19 (a): a parked
  sub-project's corpus) is left out unless GATE_ALL_PARTS=1. A :needs or :uses naming a parted step
  names its parts, a :start-after its last part"
  [steps]
  (let [all? (= "1" (System/getenv "GATE_ALL_PARTS"))
        keep? (fn [p] (or all? (not (:clean-only p))))
        parted (into {} (for [s steps :when (:parts s)]
                          [(str (:name s)) (vec (for [p (:parts s) :when (keep? p)] (part-name (:name s) (:part p))))]))
        names (fn [xs] (vec (mapcat (fn [x] (map symbol (get parted (str x) [(str x)]))) xs)))
        uses (fn [us] (vec (mapcat (fn [u] (let [[st f] (str/split (str u) #"/" 2)]
                                             (if-let [ps (get parted st)] (map #(if f (str % "/" f) %) ps) [(str u)])))
                                   us)))
        fix (fn [s] (cond-> s
                      (:needs s) (update :needs names)
                      (:uses s) (update :uses uses)
                      (:start-after s) (update :start-after #(if-let [ps (get parted (str %))] (symbol (last ps)) %))))
        sub (fn [c p] (when c (str/replace (str c) "{part}" (str (:part p)))))]
    (vec (mapcat (fn [s]
                   (if-let [ps (:parts s)]
                     (for [p ps :when (keep? p)]
                       (fix (cond-> (merge (dissoc s :parts) (dissoc p :part :inputs :pins :clean-only)
                                           {:name (symbol (part-name (:name s) (:part p)))
                                            :part (str (:part p))
                                            :inputs (vec (concat (:inputs s) (:inputs p)))
                                            :cmd (sub (or (:cmd p) (:cmd s)) p)})
                              ;; GT8: {part} in :uses its part's name (a level's part reads its own corpus's read)
                              (or (:uses p) (:uses s)) (assoc :uses (mapv #(sub % p) (or (:uses p) (:uses s))))
                              (or (:pins s) (:pins p)) (assoc :pins (vec (distinct (concat (:pins s) (:pins p)))))
                              (or (:audit-cmd p) (:audit-cmd s)) (assoc :audit-cmd (sub (or (:audit-cmd p) (:audit-cmd s)) p)))))
                     [(fix s)]))
                 steps))))

(defn ns-path
  "a namespace's source path without its extension: arbace.repr.go.print-code, arbace/repr/go/print_code"
  [^String n]
  (-> n (str/replace "." "/") (str/replace "-" "_")))

(defn never-rules
  "GTS4 (c): the rules that take a step's :never-loads namespaces' sources (each prefix's tree and file)
  out of its selection, so that a change to them keeps its key"
  [never]
  (vec (mapcat (fn [n] [[false (str (ns-path (str n)) "/")] [false (str (ns-path (str n)) ".ae")]]) never)))

(defn never?
  "is the namespace U one of the step's :never-loads, or below one"
  [never ^String u]
  (boolean (some #(let [n (str %)] (or (= u n) (str/starts-with? u (str n ".")))) never)))

(defn- units-of
  "a program's units (bin/lib/prog-units.bash's units.tsv: UNIT<TAB>SHA, UNIT a namespace or -core), or
  nil"
  [f]
  (when (and f (.isFile (File. (str f))))
    (vec (for [l (str/split-lines (slurp (str f))) :when (seq l)] (vec (str/split l #"\t" 2))))))

;; the program hosts (GTS4 (b), (c)): a step on :prog runs the gate's executables known by the digest of
;; the program j2g made (its units, less those of the namespaces the step never loads) and of the rest
;; of what the executables are built from (bin/arbace-go --gate-rest-key: the build's scripts, bin/lib,
;; overlay/go, x509roots, the pins); :javac-prog javac's tool likewise. The units are known once the
;; build ran: before, the identity is pending (the step is planned to run and planned again after the
;; builds); a build kept from before the units existed has none, and the identity is the source key
(def ^:private prog-hosts {:prog [:prog-units :prog-rest :gate] :javac-prog [:javac-prog-units :javac-prog-rest :javac]})

(defn- host-id
  "a host's identity for STEP: a string, or :pending"
  [hosts step h]
  (if-let [[uk rk sk] (prog-hosts h)]
    (let [u (get hosts uk)]
      (cond
        (= u "pending") :pending
        (or (nil? u) (= u "none")) (str "src " (get hosts sk))
        :else (let [units (units-of u)]
                (if-not units
                  (str "src " (get hosts sk))
                  (sha256 (str "rest " (get hosts rk) "\n"
                               (apply str (for [[n sha] units :when (not (never? (:never-loads step) n))]
                                            (str n " " sha "\n")))))))))
    (or (get hosts h) (throw (ex-info (str "hosts.edn: no host " h) {})))))

(def ^:private unkeyed
  ;; GT8.4: :rotate (a part run whole keeps its key), :list (its digest is the line list SHA N), :failed-re and
  ;; :rotated-part (the runner's bookkeeping, never a verdict)
  ;; GT8 (the tools' lists): :failed-as (the ids' replacement) and :judges (a judge's failures noted for its producers)
  #{:doc :summary :mem-gib :heavy :audit-cmd :rotate :list :failed-re :failed-as :rotated-part :whole-list :judges})

(defn- material
  "the lines a step's key is the hash of (but its :uses lines, use-lines'); a host whose identity is
  pending gives the line host NAME pending"
  [step rules files hosts cache]
  (let [decl (into (sorted-map) (apply dissoc step unkeyed))
        logic ["bin/lib/gate-run.bash" "bin/lib/gate-cache.bash" "test/gate/plan.ae"]
        sel (sort (matching cache (keys files) (into (vec rules) (never-rules (:never-loads step)))))]
    (concat
     [(str "step " (:name step))
      (str "decl " (pr-str decl))]
     (for [f logic] (str "logic " (get files f "missing") " " f))
     (for [h (:hosts step)] (let [id (host-id hosts step h)] (str "host " (name h) " " (if (= id :pending) "pending" id))))
     (for [p (:pins step)] (str "pin " (get files p "missing") " " p))
     (for [e (:env step)] (let [v (System/getenv (str e))] (str "env " e (if v (str "=" v) " unset"))))
     (when-let [l (:list step)] [(str "list " (list-sha l) " " (count l))])
     (for [f sel] (str "file " (get files f) " " f)))))

(defn- use-line
  "a :uses entry's line: uses PRODUCER[/FILE] DIGEST, the producer's output (in the store, at its pass) digested"
  [^String u ^File out]
  (let [[_ f] (str/split u #"/" 2)]
    (str "uses " u " " (out-digest (if f (File. out ^String f) out)))))

(defn- passes
  "the step's recorded passes in STORE, the latest first: [{...the record... :file F}]"
  [store nm]
  (let [d (File. (str store "/" nm))
        fs (when (.isDirectory d) (.listFiles d))]
    (->> fs
         ;; a pass is KEY.edn; a dotfile is a temporary of record_pass or publish_passes (review 001, finding 3)
         (filter #(let [n (.getName ^File %)] (and (str/ends-with? n ".edn") (not (str/starts-with? n ".")))))
         (keep #(try (assoc (read-file (.getPath ^File %)) :file (.getPath ^File %)) (catch Throwable _ nil)))
         ;; queue 023, report 022 finding 8: a record kept under its own key's name (one copied under another is no pass)
         (filter #(= (.getName (File. ^String (:file %))) (str (:key %) ".edn")))
         ;; GTS95 (b): a record whose log (KEY.log beside it, when there is one) has another digest than its
         ;; :log-sha256 is no pass, as bin/lib/gate-run.bash's pass_reads decides
         (filter #(let [^String f (:file %)
                        lg (File. (str (subs f 0 (- (count f) 4)) ".log"))]
                    (or (not (.isFile lg)) (= (str (:log-sha256 %)) (file-sha256 lg)))))
         (sort-by #(str (:date %)))
         reverse)))

(defn- subject [^String l]
  ;; "file SHA PATH" and "pin SHA PATH": PATH; "host NAME ID": host NAME; "env X=v": env X
  (let [w (str/split l #" ")]
    (case (first w)
      ("file" "pin" "logic") (str/join " " (drop 2 w))
      "host" (str "host " (second w))
      "env" (str "env " (first (str/split (second w) #"=")))
      (first w))))

(defn- changes
  "what differs between the material lines NOW and an earlier pass's THEN: the subjects"
  [now then]
  (let [a (set now) b (set then)
        changed (concat (remove b now) (remove a then))]
    (vec (distinct (map subject changed)))))

(defn- short-list [xs]
  (let [n (count xs)]
    (str (str/join ", " (take 6 xs)) (when (> n 6) (str " (+" (- n 6) " more)")))))

(defn- pass-desc [p]
  (str "passed at " (subs (str (:key p)) 0 12) ", " (subs (str (:commit p) "        ") 0 8) ", " (:date p)
       ", " (:worktree p)))

(defn- dash [x] (let [s (str x)] (if (str/blank? s) "-" s)))

;; GTS29 (a): the table checked. A rule that matches no file (a typo, a moved path) makes a key that
;; never changes, a stale pass waiting.
(defn- check-rules
  "the problems of one :inputs vector: an unknown group, a rule (a step's own or a group's own) that
  matches no file"
  [groups label inputs paths cache]
  (for [x inputs
        :let [s (if (keyword? x) nil (str x))
              pat (when s (if (str/starts-with? s "!") (subs s 1) s))]
        :when (if (keyword? x)
                (not (contains? groups x))
                (empty? (matching cache paths [[true pat]])))]
    (if (keyword? x)
      (str label ": no group " x)
      (str label ": input rule " s " matches no file"))))

(defn- validate
  "the problems of the table, as strings: a duplicate step, a :needs or :start-after naming no step,
  a host absent from hosts.edn, an unknown group, an input rule or pin matching no file, a :cmd's bin/
  script missing, an unknown :phase or :kind"
  [groups steps files hosts cache]
  (let [names (map (comp str :name) steps)
        known (set names)
        paths (keys files)
        ok-script? (fn [t] (contains? files t))]
    (vec
     (concat
      (for [[n c] (frequencies names) :when (> c 1)] (str "step " n " is declared " c " times"))
      (mapcat
       (fn [s]
         (let [nm (str (:name s))]
           (concat
            (when-not (#{:pre :build :essential :full} (:phase s)) [(str nm ": unknown :phase " (:phase s))])
            (when-not (contains? #{nil :check :build :always} (:kind s)) [(str nm ": unknown :kind " (:kind s))])
            (for [x (:needs s) :when (not (known (str x)))] (str nm ": :needs names no step: " x))
            (when (and (:start-after s) (not (known (str (:start-after s)))))
              [(str nm ": :start-after names no step: " (:start-after s))])
            (for [h (:hosts s) :when (not (or (contains? hosts h) (and (prog-hosts h) (contains? hosts (second (prog-hosts h))))))]
              (str nm ": host " h " is not in hosts.edn"))
            (when-not (contains? #{nil true :inner} (:heavy s)) [(str nm ": :heavy is true or :inner, not " (:heavy s))])
            ;; queue 023, report 022 finding 3: the frozen jar runs on the system JVM, whose identity is :jdk's
            (when (and (some #{:frozen} (:hosts s)) (not (some #{:jdk} (:hosts s))))
              [(str nm ": host :frozen without :jdk (the jar runs on the system JVM)")])
            ;; GT5: a step's :uses names an earlier step with :outputs
            (for [u (:uses s)
                  :let [pn (first (str/split (str u) #"/" 2)) pi (.indexOf ^java.util.List (vec names) pn)]
                  :when (or (neg? pi) (>= pi (.indexOf ^java.util.List (vec names) nm))
                            (not (:outputs (nth steps pi))))]
              (str nm ": :uses " u ": no earlier step " pn " with :outputs"))
            (when (and (seq (:never-loads s)) (some #{:gate :javac} (:hosts s)))
              [(str nm ": :never-loads on :gate or :javac, whose identity holds every namespace: :prog, :javac-prog")])
            (for [p (:pins s) :when (not (contains? files p))] (str nm ": pin " p " is not a file"))
            ;; GT8.4: a :rotate names its record and corpora files, and its :only takes the {list}
            (when-let [r (:rotate s)]
              (concat
               (when-not (:part s) [(str nm ": :rotate on a step without :parts")])
               (when-not (str/includes? (str (:only r)) "{list}") [(str nm ": :rotate's :only has no {list}")])
               (for [k [:universe :subset] :let [f (get r k)] :when (and f (not (contains? files f)))]
                 (str nm ": :rotate's " k " " f " is not a file"))
               (when-not (:universe r) [(str nm ": :rotate has no :universe")])
               (when-let [x (:id-re r)]
                 (when-not (try (re-pattern x) (catch Throwable _ nil)) [(str nm ": :rotate's :id-re does not compile: " x)]))
               (when-not (or (nil? (:always r)) (vector? (:always r))) [(str nm ": :rotate's :always is not a vector of ids")])))
            (when-let [j (:judges s)]
              (concat
               (when-not (seq (:uses s)) [(str nm ": :judges on a step without :uses (its producers)")])
               (when-not (:failed-re j) [(str nm ": :judges has no :failed-re")])))
            (for [t (re-seq #"(?:^|[ \"=;&|(])(bin/[A-Za-z0-9._-]+)" (str (:cmd s)))
                  :let [sc (second t)]
                  :when (not (ok-script? sc))]
              (str nm ": :cmd runs " sc ", which is not a file"))
            (check-rules groups nm (:inputs s) paths cache))))
       steps)
      (mapcat (fn [[g rules]] (check-rules groups (str "group " g) rules paths cache)) groups)))))

(defn- budget
  "three times the longest of the step's last three passes (seconds, at least 120), or nil (GTS17 (a))"
  [ps]
  (let [ss (keep :secs (take 3 ps))]
    (when (seq ss) (max 120 (* 3 (apply max ss))))))

(defn- producer [u] (first (str/split (str u) #"/" 2)))

;; ---- GT8.4, GT8.7 (doc/GATE-SURVEY.md, "As built: GT8.4, GT8.7 (write-ahead)"): the rotation. A part whose
;; step declares :rotate {:only "--only {list}" :universe RECORD :subset CORPORA :failed-re ERE} runs, in the
;; nightly tier, its subset (NAME.PART.sub: the corpus's :subset, plus the files that failed since) and one
;; slice of the rest (NAME.PART.sK, K in 0..6: the files whose name's SHA-256, its first 8 hex digits, is K
;; mod 7), each a check of its own, keyed over its list; the clean run its subset alone; --full the whole part.
;; A part with no :subset, or one that covers the universe, is not rotated: it runs whole in every tier.

(def period 7)

(defn slice-of
  "the rotation's slice of a file id: the first 8 hex digits of its SHA-256, mod 7"
  [^String id]
  (mod (Long/parseLong (subs (sha256 id) 0 8) 16) period))

(def ^:private default-id-re "^\\s*\\[\"([^\"]+)\"")

(defn- slice-key
  "the part of an id its slice is computed on: :rotate's :slice-re's group 1 when it finds one (queue 201, PY7: Python's
  methods MODULE/TEST-ID sliced by MODULE, so a night's slice starts a seventh of the modules, not every module for a
  seventh of their methods), else the id"
  [slice-re ^String id]
  (or (when slice-re (second (re-find (re-pattern slice-re) id))) id))

(defn- record-ids
  "the ids of a record under PART: by default its lines [\"ID\" ...] (test/c/check-linux-amd64.edn's shape) whose
  ID is under PART/; with ID-RE (:rotate's :id-re, a regex on a line), its group 1 on every line it finds, and
  when it has a group 2, only the lines whose group 2 is PART (the part named on the line: Java's corpus);
  each id once, in the record's order"
  [^String f ^String part id-re]
  (let [pre (str part "/")
        re (re-pattern (or id-re default-id-re))
        groups (.groupCount (re-matcher re ""))]
    (vec (distinct
          (for [l (str/split-lines (slurp f))
                :let [m (re-find re l)]
                :when m
                :let [id (second m) p (when (> groups 1) (nth m 2))]
                :when (cond (nil? id-re) (str/starts-with? id pre)
                            (> groups 1) (= p part)
                            :else true)]
            id)))))

(defn- corpus-subset
  "the :subset of the map whose :id is :PART anywhere in the file (test/c/corpora.edn's shape), each PART/NAME
  (BARE: each NAME as written, the ids of a record read by an :id-re); nil when it has none"
  [^String f ^String part bare]
  (let [k (keyword part)
        m (first (filter #(and (map? %) (= k (:id %))) (tree-seq coll? seq (read-file f))))]
    (when-let [s (:subset m)] (mapv #(if bare (str %) (str part "/" %)) s))))

(defn- rot-dir [store] (str store "/_rotation"))

(defn- lines-of [^String f]
  (let [x (File. f)] (if (.isFile x) (vec (remove str/blank? (str/split-lines (slurp f)))) [])))

(def ^:private counted
  "review 181 (the user's (a), 2026-11-03): the commits whose runs count toward the rotation's record, this
  commit's ancestors (git rev-list HEAD: LOGS/ancestors.txt for a plan, --ancestors FILE for rotation-status), or
  nil (every run, for a caller that gives none)"
  (atom nil))

(defn- set-counted! [^String f]
  (reset! counted (when (and f (.isFile (File. f))) (set (remove str/blank? (str/split-lines (slurp f)))))))

(defn- counts?
  "does a run (or a failed file's event) count: noted by an ancestor of this commit, from a clean tree"
  [{:keys [commit dirty]}]
  (or (nil? @counted) (and (contains? @counted (str commit)) (= "false" (str dirty)))))

(def run-order
  "the order of the runs (review 181, finding 2): the store's sequence number (STORE/_rotation/.seq, taken under
  its lock by the runner: the run noted last is the later), then the time"
  (juxt :seq :epoch))

(defn runs-of
  "a rotated check's runs that count (counts?), STORE/_rotation/NAME.runs (the runner's lines EPOCH DATE STATUS KEY
  LIST-SHA COMMIT WORKTREE SEQ DIRTY), the latest last"
  [store nm]
  (sort-by run-order
           (filter counts?
                   (for [l (lines-of (str (rot-dir store) "/" nm ".runs"))
                         :let [[e d st k ls c w sq dt] (str/split l #"\t")]
                         :when (re-matches #"[0-9]+" (str e))]
                     {:epoch (Long/parseLong e) :date d :status st :key k :list-sha ls :commit c :worktree w
                      :seq (if (re-matches #"[0-9]+" (str sq)) (Long/parseLong sq) 0) :dirty dt}))))

(defn failed-of
  "the part's files that failed since (STORE/_rotation/NAME.PART.failed, the runner's events SEQ EPOCH ID fail|clear
  COMMIT DIRTY): those whose latest event that counts is a failure (a branch's failure or clearing is not this
  commit's)"
  [store nm]
  (let [evs (filter counts?
                    (for [l (lines-of (str (rot-dir store) "/" nm ".failed"))
                          :let [[sq e id ev c dt] (str/split l #"\t")]
                          :when (and (re-matches #"[0-9]+" (str sq)) id)]
                      {:seq (Long/parseLong sq) :id id :event ev :commit c :dirty dt}))]
    (vec (sort (for [[id es] (group-by :id evs) :when (= "fail" (:event (last (sort-by :seq es))))] id)))))

(defn rotation-lists
  "a rotated part's lists, or nil when it is not rotated: {:universe :subset (the declared one, plus :always's ids
  and the files that failed since, STORE/_rotation/NAME.PART.failed) :failed :always :slices {K [ids]}}. :always
  (the negative controls' subjects, GTS81 (a)): ids of the universe in the subset and in every slice's list, so
  that every run of the part judges its controls"
  [root store step]
  (when-let [{:keys [universe subset id-re always slice-re]} (:rotate step)]
    (when-let [declared (when subset (corpus-subset (str root "/" subset) (:part step) (some? id-re)))]
    (let [part (:part step) nm (str (:name step))
          ;; (the universe read only for a part with a :subset: a plan reads no record of an unrotated part)
          u (record-ids (str root "/" universe) part id-re)
          uset (set u)
          always (filterv uset (map str always))
          failed (filterv uset (failed-of store nm))
          sub (vec (sort (distinct (concat (filter uset declared) always failed))))
          subset-set (set sub)
          rest (remove subset-set u)]
      (when (and declared (seq rest))
        {:universe u :subset sub :failed failed :always always
         :slices (into (sorted-map) (for [k (range period)]
                                      (let [ids (sort (filter #(= k (slice-of (slice-key slice-re %))) rest))]
                                        [k (if (seq ids) (vec (sort (distinct (concat ids always)))) [])])))})))))

(defn- with-only
  "the command with the rotation's list: {only} in it replaced by the :only fragment (else the fragment
  appended), {list} in the fragment the runner's \"$GATE_LIST\"; NIL fragment: {only} removed"
  [cmd frag]
  (let [c (str cmd)
        f (when frag (str/replace (str frag) "{list}" "\"$GATE_LIST\""))]
    (cond
      (str/includes? c "{only}") (str/replace c "{only}" (or f ""))
      f (str c " " f)
      :else c)))

(defn- now-s [] (if-let [n (System/getenv "GATE_NOW")] (Long/parseLong n) (quot (System/currentTimeMillis) 1000)))

(defn slice-state
  "a slice's state for the night's choice and for completeness: its latest run that counts (its own, any list, or the
  whole part's) and its covering run (the latest of its own runs with its current list and the whole part's with the
  current universe), :covered when that one passed (or was skipped at a pass) since SINCE"
  [store nm k ids usha since]
  (let [own (runs-of store (str nm ".s" k))
        wholes (runs-of store (str nm ".whole"))
        ls (list-sha ids)
        latest (last (sort-by run-order (concat own wholes)))
        cover (last (sort-by run-order (concat (filter #(= ls (:list-sha %)) own) (filter #(= usha (:list-sha %)) wholes))))]
    {:k k :n (count ids) :latest latest :cover cover
     :covered (boolean (and cover (#{"pass" "skip"} (:status cover)) (>= (:epoch cover) since)))}))

(defn choose-slices
  "the slices a night runs (GTS202 (a), GTS203 (a); review 181, findings 3 and 4): one whose latest run failed, if
  any (ties by the night index), and beside it the rotation's slice among the others: first one not covered with its
  current list (never run, a list changed since its run, or its run failed or aged), then the one whose latest run is
  oldest (by the store's sequence); ties by the night index (slice NIGHT mod 7 first). A slice that fails naming no file keeps its place the
  next night, but the rotation goes on beside it"
  [store nm lists night]
  (let [usha (list-sha (sort (:universe lists)))
        since (- (now-s) (* period 86400))
        sts (for [[k ids] (:slices lists) :when (seq ids)] (slice-state store nm k ids usha since))
        tie #(mod (- (:k %) night) period)
        failed (first (sort-by tie (filter #(= "fail" (:status (:latest %))) sts)))
        other (first (sort-by (juxt #(if (:covered %) 1 0) #(if (:latest %) (:seq (:latest %)) -1) tie)
                              (remove #(= (:k %) (:k failed)) (remove #(= "fail" (:status (:latest %))) sts))))]
    (vec (keep :k [failed other]))))

(defn rotate-steps
  "the steps with their rotated parts expanded for ROTATION: nil (--full: whole parts), :subset (the clean run:
  NAME.PART.sub alone) or a night index (NAME.PART.sub and the night's slice); each expanded check carries its
  :list (its key's line list SHA N, the runner's GATE_LIST file) and :rotation"
  [root store steps rotation]
  (let [exp (fn [s]
              (let [lists (when rotation (rotation-lists root store s))
                    frag (:only (:rotate s))
                    mk (fn [suffix ids tag]
                         (-> (dissoc s :rotate)
                             (assoc :name (symbol (str (:name s) "." suffix)) :rotation tag :list ids
                                    :rotated-part (str (:name s)) :failed-re (:failed-re (:rotate s))
                                    :failed-as (:failed-as (:rotate s))
                                    :cmd (with-only (:cmd s) frag))))]
                (cond
                  (not lists)
                  [(cond-> s (:cmd s) (update :cmd with-only nil))]
                  ;; a rotated part run whole (--full, the clean run's GATE_CLEAN_WHOLE=1): its key as before (the
                  ;; universe unkeyed, :whole-list), its run noted as NAME.PART.whole, a run of every slice
                  (= rotation :whole)
                  [(-> s (dissoc :rotate) (update :cmd with-only nil)
                       (assoc :whole-list (vec (sort (:universe lists))) :rotated-part (str (:name s))
                              :failed-re (:failed-re (:rotate s)) :failed-as (:failed-as (:rotate s))))]
                  :else
                  (let [sub (mk "sub" (:subset lists) "sub")]
                    (if (= rotation :subset)
                      [sub]
                      (into [sub] (for [k (choose-slices store (str (:name s)) lists rotation)]
                                    (mk (str "s" k) (get (:slices lists) k) (str "s" k "/" period)))))))))
        out (mapv exp steps)
        renamed (into {} (for [[s xs] (map vector steps out) :when (not= [(:name s)] (map :name xs))]
                           [(str (:name s)) (mapv :name xs)]))
        fix (fn [xs] (vec (mapcat #(get renamed (str %) [%]) xs)))
        ;; a :uses naming a rotated part (STEP or STEP/FILE) names its checks
        fix-uses (fn [us] (vec (mapcat (fn [u] (let [[st f] (str/split (str u) #"/" 2)]
                                                 (if-let [ns (get renamed st)] (map #(if f (str % "/" f) (str %)) ns) [(str u)])))
                                       us)))]
    (vec (for [s (apply concat out)]
           (cond-> s
             (:needs s) (update :needs fix)
             (:uses s) (update :uses fix-uses)
             (:start-after s) (update :start-after #(if-let [n (get renamed (str %))] (last n) %)))))))

(defn plan [root logs store mode rerun? & [rotation]]
  (set-counted! (str logs "/ancestors.txt"))
  (let [{:keys [groups steps]} (read-file (or (System/getenv "GATE_STEPS") (str root "/test/gate/steps.edn")))
        steps (expand-parts steps)
        files (files-table (str logs "/files.sha256"))
        hosts (read-file (str logs "/hosts.edn"))
        phases (if (#{"full" "nightly"} mode) #{:pre :build :essential :full} #{:pre :build :essential})
        cache (atom {})
        problems (validate groups steps files hosts cache)
        _ (when (seq problems)
            (println (str "gate plan: " root "/test/gate/steps.edn has " (count problems) " problem(s):"))
            (doseq [p problems] (println (str "   " p)))
            (System/exit 1))
        steps (filter #(phases (:phase %)) steps)
        ;; GT8.4: the rotated parts (--nightly: the subset and the night's slice; the clean run: the subset)
        _ (when (and (= mode "nightly") (not (integer? rotation)))
            (println "gate plan: nightly needs --night N") (System/exit 2))
        steps (rotate-steps root store steps (when (#{"full" "nightly"} mode) (or rotation :whole)))
        pdir (File. (str logs "/plan"))
        _ (.mkdirs pdir)
        rdir (File. (str logs "/rotation"))
        _ (.mkdirs rdir)
        _ (doseq [s steps :when (or (:rotation s) (:whole-list s))
                  :let [l (or (:list s) (:whole-list s)) tag (or (:rotation s) "whole")
                        rn (if (:whole-list s) (str (:name s) ".whole") (str (:name s)))]]
            (spit (str rdir "/" (:name s) ".list") (apply str (map #(str % "\n") l)))
            (spit (str rdir "/" (:name s) ".rot")
                  (str "part\t" (:rotated-part s) "\nslice\t" tag "\nruns\t" rn "\nlist-sha\t" (list-sha l)
                       "\nfailed-re\t" (or (:failed-re s) "") "\nfailed-as\t" (or (:failed-as s) "\\1") "\n")))
        ;; GT8: a judge of rotated checks (:judges {:failed-re ERE :failed-as REPL}): its producers and expressions, for
        ;; the runner's judge_note (a producer that is not rotated has no .rot and is passed over)
        _ (doseq [s steps :when (:judges s) :let [j (:judges s)]]
            (spit (str rdir "/" (:name s) ".judges")
                  (str (apply str (for [p (distinct (map producer (:uses s)))] (str "producer\t" p "\n")))
                       "failed-re\t" (or (:failed-re j) "") "\nfailed-as\t" (or (:failed-as j) "\\1") "\n")))
        used (set (for [s steps u (:uses s)] (producer u)))
        ;; the checks' decisions, in order: a step that uses others' outputs (GT5) is keyed over them,
        ;; known when its producers are skipped (their passes' outputs), else decided by the runner once
        ;; they ran (the decision "after": an early cutoff)
        decided
        (reduce
         (fn [acc s]
           (let [nm (str (:name s)) kind (or (:kind s) :check)
                 by (:by acc)]
             (if (not= kind :check)
               (-> acc (update :v conj {:step s :name nm :kind kind}))
               (let [lines (vec (material s (expand groups (:inputs s)) files hosts cache))
                     pending (some #(re-find #"^host \S+ pending$" %) lines)
                     prods (distinct (map producer (:uses s)))
                     open (remove #(= "skip" (:decision (by %))) prods)
                     lines (if (or pending (seq open))
                             lines
                             (into lines (for [u (:uses s) :let [h (:hit (by (producer u)))]]
                                           (use-line (str u) (File. (str store "/" (producer u) "/" (:key h) ".out"))))))
                     text (str (str/join "\n" lines) "\n")
                     key (sha256 text)
                     _ (spit (str logs "/plan/" nm ".inputs") text)
                     ps (passes store nm)
                     bud (budget ps)
                     hit (first (filter #(= (:key %) key) ps))
                     nfiles (count (filter #(str/starts-with? % "file ") lines))
                     d (cond
                         pending
                         {:decision "run" :provisional true
                          :why (str nfiles " files; a program host is not built yet (" (str/join ", " (map name (filter prog-hosts (:hosts s))))
                                    "): planned again after the builds")}
                         (seq open)
                         {:decision "after" :key nil
                          :why (str nfiles " files; decided once " (str/join ", " open)
                                    " ran: their outputs are in its key (an early cutoff, GT5)")}
                         (and hit (not rerun?))
                         {:key key :decision "skip" :why (pass-desc hit) :hit hit}
                         :else
                         {:key key :decision "run"
                          :why (str "key " (subs key 0 12) ", " nfiles " files; "
                                    (cond
                                      hit "a pass at this key, rerun (--rerun)"
                                      (empty? ps) "never passed"
                                      :else (let [p (first ps)
                                                  then (try (str/split-lines (slurp (str/replace (:file p) #"\.edn$" ".inputs")))
                                                            (catch Throwable _ nil))]
                                              (if then
                                                (str "changed since the pass at " (subs (str (:key p)) 0 12) " (" (:date p) "): "
                                                     (short-list (changes lines then)))
                                                (str "no pass at this key (the latest " (subs (str (:key p)) 0 12) ")")))))})
                     d (merge {:step s :name nm :kind kind :budget bud} d)]
                 (-> acc (update :v conj d) (assoc-in [:by nm] d))))))
         {:v [] :by {}} steps)
        decided (:v decided)
        ;; the canary (GT4, GTS8 (a), survey 4.4 (d)): one skipped check runs anyway, the light one (not
        ;; :heavy, its pass under five minutes) whose pass is oldest, so that a declaration that misses an
        ;; input is found within a few gates; GATE_CANARY=0 turns it off. Not a step whose outputs others
        ;; use (their decisions were made on its pass)
        canary (when-not (or rerun? (= "0" (System/getenv "GATE_CANARY")))
                 (->> decided
                      (filter #(and (= "skip" (:decision %)) (not (:heavy (:step %))) (not (used (:name %)))
                                    (<= (or (:secs (:hit %)) 0) 300)))
                      (sort-by #(str (:date (:hit %))))
                      first))
        decided (mapv (fn [d]
                        (if (and canary (= (:name d) (:name canary)))
                          (assoc d :decision "run"
                                 :why (str "canary: the oldest pass of the light checks (" (:date (:hit d))
                                           "), run again to prove it still holds (GATE_CANARY=0: not)"))
                          d))
                      decided)
        by-name (into {} (map (juxt :name identity) decided))
        needs-of (fn [s] (distinct (concat (map str (:needs s)) (map producer (:uses s)))))
        runs? #{"run" "after"}
        ;; the builds: needed by a check that runs (or may: after), or by a needed build
        needed (loop [need (set (mapcat #(needs-of (:step %)) (filter #(runs? (:decision %)) decided)))]
                 (let [more (into need (mapcat #(needs-of (:step (by-name %))) need))]
                   (if (= more need) need (recur more))))
        decided (vec (for [d decided]
                       (case (:kind d)
                         :always (assoc d :decision "always" :why "every run")
                         :build (if (needed (:name d))
                                  (assoc d :decision "build"
                                         :why (str "needed by "
                                                   (short-list (for [x decided
                                                                     :when (some #{(:name d)} (needs-of (:step x)))
                                                                     :when (or (runs? (:decision x)) (needed (:name x)))]
                                                                 (:name x)))))
                                  (assoc d :decision "none" :why "not needed: no step that runs needs it"))
                         d)))]
    (spit (str logs "/plan.tsv")
          (apply str
                 (for [{:keys [step name decision key why budget kind]} decided
                       :let [[sre sn] (:summary step)]]
                   (str (str/join "\t" [name decision (dash key) (subs (str (:phase step)) 1)
                                        (dash (or (:chain step) name))
                                        (dash (str/join "," (needs-of step)))
                                        (dash (:start-after step))
                                        (case (:heavy step) true "yes" :inner "inner" "-") (dash (:mem-gib step)) (dash budget)
                                        (dash sn) (dash sre) (dash why) (dash (:audit-cmd step))
                                        (if (:outputs step) "yes" "-") (dash (str/join "," (map str (:uses step))))
                                        (subs (str kind) 1) (:cmd step)])
                        "\n"))))
    (let [freq (frequencies (map :decision decided))]
      (println (str "gate plan (" mode "): " (count decided) " steps; "
                    (str/join ", " (for [k ["always" "build" "run" "after" "skip" "none"] :when (freq k)]
                                     (str (freq k) " " k))))))
    (when (some #(:rotation (:step %)) decided)
      (println (str "   rotation (GT8.4): " (if (integer? rotation) (str "night " rotation ", slices of " period) "the subsets alone (the clean run)")
                    "; " (str/join ", " (for [d decided :let [s (:step d)] :when (:rotation s)]
                                          (str (:name d) " " (count (:list s)) " files"))))))
    (doseq [{:keys [name decision why]} decided]
      (println (format "   %-6s %-28s %s" (if (= decision "none") "-" decision) name why)))))

(defn why [root logs store nm]
  (let [f (File. (str logs "/plan/" nm ".inputs"))]
    (when-not (.isFile f)
      (println (str "gate why: no material for " nm " (not a check of the plan: bin/gate --plan [--full] first)"))
      (System/exit 2))
    (let [now (str/split-lines (slurp f))
          ps (passes store nm)
          key (sha256 (str (str/join "\n" now) "\n"))]
      (println (str nm ": key " key ", " (count now) " lines of material (" (.getPath f) ")"))
      (doseq [l now :when (not (str/starts-with? l "file "))] (println (str "   " l)))
      (println (str "   " (count (filter #(str/starts-with? % "file ") now)) " input files"))
      (if (empty? ps)
        (println (str "passes: none in " store "/" nm))
        (do
          (println (str "passes (" (count ps) "), the latest first:"))
          (doseq [p (take 5 ps)]
            (println (str "   " (subs (str (:key p)) 0 12) " " (:date p) " " (:commit p) " " (:worktree p)
                          " " (:secs p) " s, cpu " (:cpu-s p) " s, peak " (:maxrss-kib p) " KiB"
                          (when (= (:key p) key) "  <- this key: the step is skipped"))))
          (let [p (first ps)
                then (try (str/split-lines (slurp (str/replace (:file p) #"\.edn$" ".inputs"))) (catch Throwable _ nil))]
            (when (and then (not= (:key p) key))
              (let [a (set now) b (set then)]
                (println (str "since the latest pass (" (subs (str (:key p)) 0 12) "):"))
                (doseq [l (remove b now)] (println (str "   + " l)))
                (doseq [l (remove a then)] (println (str "   - " l)))))))))))

(defn rotation-status
  "GT8.4, GTS204 (a): the rotation's record complete? For every rotated part (a :subset smaller than its universe):
  every non-empty slice's latest run of its current list (LIST-SHA) passed or was skipped at a pass, within the
  period (7 days, at any key: see the survey), and no file failed since (STORE/_rotation/NAME.PART.failed empty).
  Prints a line a part; exit 1 when incomplete. GATE_NOW: the time (epoch seconds) for the gate's own tests"
  [root store args]
  (set-counted! (second (drop-while #(not= "--ancestors" %) args)))
  (let [{:keys [steps]} (read-file (or (System/getenv "GATE_STEPS") (str root "/test/gate/steps.edn")))
        now (now-s)
        days (if-let [d (second (drop-while #(not= "--days" %) args))] (Long/parseLong d) period)
        since (- now (* days 86400))
        parts (for [s (expand-parts steps) :when (:rotate s)
                    :let [l (rotation-lists root store s)] :when l]
                [s l])
        bad (atom 0)
        edn (second (drop-while #(not= "--edn" %) args))
        evidence (atom [])]
    (if (empty? parts)
      (println "gate rotation: no corpus is compressed (no rotated part has a :subset smaller than its universe): --nightly runs every part whole, nothing to rotate")
      (doseq [[s {:keys [universe subset failed slices]}] parts]
        (let [nm (str (:name s))
              usha (list-sha (sort universe))
              st (for [[k ids] slices :when (seq ids)
                       :let [x (slice-state store nm k ids usha since)]]
                   [k (:n x) (:cover x) (:covered x)])
              incomplete (remove #(nth % 3) st)]
          (when (or (seq incomplete) (seq failed)) (swap! bad inc))
          ;; review 181, finding 5: the evidence, for the clean record: each slice's covering run
          (swap! evidence conj {:part nm :files (count universe) :subset (count subset) :failed (vec failed)
                                :slices (vec (for [[k n r ok] st]
                                               [k n (if r (keyword (:status r)) :none) (:date r) (:commit r) (boolean ok)]))})
          (println (str (if (or (seq incomplete) (seq failed)) "INCOMPLETE " "complete   ") nm ": " (count universe) " files, subset "
                        (count subset) ", " (count st) " slices"
                        (when (seq incomplete)
                          (str "; not passed within " days " days: "
                               (str/join ", " (for [[k n r] incomplete]
                                                (str "s" k " (" n " files, "
                                                     (if r (str (:status r) " " (:date r)) "never run with this list, nor the part whole with this universe") ")")))))
                        (when (seq failed) (str "; failed since, to pass (and to add to :subset): " (str/join " " (take 10 failed))
                                                (when (> (count failed) 10) (str " (+" (- (count failed) 10) ")")))))))))
    (when edn
      (spit edn (pr-str {:status (cond (empty? parts) :none (pos? @bad) :incomplete :else :complete)
                         :days days :now now :parts @evidence})))
    (when (pos? @bad) (System/exit 1))))

(defn -main [& args]
  (case (first args)
    "plan" (let [[_ root logs store mode & more] args
                 night (second (drop-while #(not= "--night" %) more))
                 rot (second (drop-while #(not= "--rotation" %) more))]
             (plan root logs store mode (some #{"--rerun"} more)
                   (cond night (Long/parseLong night) (= rot "subset") :subset :else nil)))
    "rotation-status" (let [[_ root store & more] args] (rotation-status root store more))
    "why" (let [[_ root logs store nm] args] (why root logs store nm))
    (do (println "usage: gate.plan plan ROOT LOGS STORE MODE [--rerun] [--night N|--rotation subset] | why ROOT LOGS STORE NAME | rotation-status ROOT STORE")
        (System/exit 2))))

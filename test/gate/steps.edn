  :llvm-mc [[:require "${REPR_ASM_MC:-/usr/lib/llvm23/bin/llvm-mc}" "${REPR_ASM_TBLGEN:-/usr/lib/llvm23/bin/llvm-tblgen}" "ld.lld"]
            [:version "${REPR_ASM_MC:-/usr/lib/llvm23/bin/llvm-mc}" "--version"] [:exe "${REPR_ASM_MC:-/usr/lib/llvm23/bin/llvm-mc}"]
            [:exe "${REPR_ASM_TBLGEN:-/usr/lib/llvm23/bin/llvm-tblgen}"] [:exe "ld.lld"]]
  ;; ARS34 (a) (the user, 2026-11-10): arm64's run-check on an amd64 main host runs Arbace's linked aarch64 programs under
  ;; qemu-aarch64's user-mode emulation (REPR_ASM_RUNNER), an emulation of the CPU, not a toolchain; the native runs are the VM's
  :qemu-aarch64 [[:require "${REPR_ASM_RUNNER:-qemu-aarch64}"] [:version "${REPR_ASM_RUNNER:-qemu-aarch64}" "--version"]

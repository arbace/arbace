           {:part tcc-tests2} {:part tcc-pp} {:part compcert} {:part mir} {:part cxgo} {:part benchmarksgame} {:part sqlite}
           {:part zlib} {:part quickjs} {:part gcc-c23} {:part gcc-cpp-c23} {:part gcc-c23-sub} {:part gcc-gnu23}
           {:part gcc-embed} {:part gcc-va-opt} {:part gcc-bitint}]
   :summary ["^[a-z0-9-]*: [0-9]|FAIL|fail" 4]
   ;; GT8 (doc/GATE-SURVEY.md, "As built: GT8 (C's read lists)"): --nightly's subset and slice by --only; the universe the results
   ;; file's rows ("CORPUS FILE" as CORPUS/FILE, :id-as), the subset the corpus's :subset-annot (none yet: whole in every tier), the
   ;; controls' files (benchmarksgame's subject and reference) :always
   :rotate {:only "--only {list}" :universe "test/repr/c/annot-results.edn" :id-re "^\\[\"([^ \"]+) ([^\"]+)\"" :id-as "$1/$2"
            :subset "test/c/corpora.edn" :subset-key :subset-annot :always ["benchmarksgame/fannkuchredux.c" "benchmarksgame/fasta-8.c"]
            :failed-re "^FAIL ([^[:cntrl:]]+)[[:cntrl:]].*$"}}
  ;; repr/c's token check (lex and pp against cc, the streams against gcc -E's recorded digests; C9.2 step 7a without --record)

            :subset "test/c/corpora.edn" :subset-key :subset-tokens :always ["benchmarksgame/fannkuchredux.c" "benchmarksgame/fasta-8.c"]
            :failed-re "^FAIL ([^[:cntrl:]]+)[[:cntrl:]].*$"}}

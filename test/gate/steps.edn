;; bin/gate's steps (doc/GATE-SURVEY.md, GT2, GTS2 (a), GTS3 (a), "As built: GT1-GT3"): every step of
;; the essential gate and of --full, with what it reads, read by gate.plan (test/gate/plan.ae) on
;; stage 0. A check's key is the SHA-256 of its declaration (but :doc, :summary, :mem-gib, :heavy, :audit-cmd), the
;; gate's logic (bin/lib/gate-run.bash, test/gate/plan.ae), the content of the files its :inputs and :pins name,
;; the identities of its :hosts and the values of its :env; never the commit. A pass of that key in
;; the store (ARBACE_GATE_STORE) skips it.
;;
;; A step:
;;   :name      the step, as the summary names it
;;   :phase     :pre (one after another, before the plan; always run, never keyed), :build (the
;;              essential phase's builds, one after another), :essential (concurrently by :chain),
;;              :full (with --full: one after another in this order, or by :chain concurrently with
;;              GATE_FULL_PARALLEL=1)
;;   :kind      :check (keyed: skipped when passed at its key), :build (run when a check that runs
;;              needs it; cached by the build itself, never recorded), :always (run every time)
;;   :chain     the concurrent phase's sequence the step belongs to (default its name)
;;   :start-after  a chain's first step, GATE_FULL_PARALLEL=1: the step whose end it waits for
;;   :needs     steps that must have passed (or been skipped) for this one to run
;;   :cmd       run by bash -c in the checkout, with GATE_CACHE (the gate's executables' directory,
;;              ARBACE_GATE_EXES/KEY20), GATE_EXE (its amd64/arbace), GATE_TESTS (amd64/arbace-tests),
;;              GATE_JAVAC_DIR (ARBACE_GATE_EXES/javac-KEY20), GATE_JAVAC (its arbace-javac), GATE_JOBS
;;              (GATE_TEST_JOBS, default 12)
;;   :hosts     the executables it runs on, by identity (bin/gate's hosts.edn): :gate (gate_key, the
;;              narrowed sources of the shipped and test builds), :javac (arbace_javac_key), :stage0
;;              (the seed's and Go's pins), :frozen (the frozen jar's pin), :jdk (the system JDK's
;;              release files, java's and javac's on PATH: the reference javac and the JVM the frozen jar
;;              runs on; a step on :frozen declares :jdk too, queue 023), :go (TamaGo's go: its VERSION), :gcc (the host's
;;              gcc, C's reference: its --version line, its driver's and cc1's digests and the headers test/c/host/headers.sha256 names;
;;              the user, 2026-11-02)
;;   :inputs    paths under the checkout: "dir/" (every file below), "a/*.edn" (a glob: * within a
;;              name, ** across directories), "file"; keywords name a group of :groups; a "!"
;;              prefix takes the files back out; the last rule that matches a file wins
;;   :pins      the checkout's pins of what lies outside it (seed/goroot.sha256: TamaGo's go and its
;;              $GOROOT/test; jdk/javac/platform.sha256: the JDK build tree and jdk26u at its pin)
;;   :env       environment variables whose values are inputs
;;   :heavy     the step's peak is above 8 GiB: it runs under GATE_HEAVY_CMD, by default bin/heavy-lock (GT5: the
;;              host's big-job lock, ARBACE_HEAVY_LOCK, taken in turn), one heavy step at a time host-wide, the rest concurrent
;;              (GT6, GTS25 (a)); :mem-gib, its measured peak (GTS26 (a), "As built: GT1-GT3"'s table, then
;;              the GT6 runs'); not in the key
;;   :mem-gib   (GTS227 (a), "As built: GTS227 (a)") the step's peak in GiB, at least the largest recorded (the larger of
;;              the largest process's RSS and the process tree's sampled peak, over the store's passes and the clean runs'
;;              logs, 2026-11-04); a part may declare its own (its corpus's peak; the step's then the largest). bin/gate
;;              --full [--clean] --concurrent admits each step by it (bin/gate-lane: lane 1 the steps of 16 GiB or more, one
;;              at a time, which the planner requires :heavy; lane 2 the rest beside, within the host's budget);
;;              bin/gate --mem-check and test/gate/lanes-test.bash fail on a recorded peak above it by the margin
;;              (10% and 0.5 GiB). Unmeasured as parts (C's full checks, goi-check-full, Java's levels' parts): the
;;              whole step's, or C9.2's table
;;   :summary   [REGEX LINES]: the lines of its log the summary prints
;;   :audit-cmd a cheaper command for bin/gate --audit (GT4) that exercises the same code paths as :cmd on
;;              a few tests or corpora (the files a step reads in the checkout do not depend on how
;;              many tests it runs); not in the key
;; Since GT5 (doc/GATE-SURVEY.md, "As built: GT5", the inner keys):
;;   :heavy     true: the step under the lock as a whole (its tools take none: ARBACE_HEAVY_HELD=1);
;;              :inner: not, its tools take the lock around their heavy process alone (bin/lib/heavy.bash:
;;              bin/j2g, repr/go's native reader and converter, repr/java's corpus reads), its light work
;;              beside the other steps (GTS31 (b))
;;   :rotate    (GT8.4) {:only "--only {list}" :universe RECORD :subset CORPORA :failed-re ERE} on a parted step: in
;;              bin/gate --nightly a part whose corpus (CORPORA's map :id :P) has a :subset smaller than RECORD's ids
;;              under P/ runs as NAME.P.sub and one slice NAME.P.sK (test/gate/plan.ae's rotate-steps), :only appended
;;              to :cmd (or at {only}) with {list} the planner's list file; not keyed itself (the lists are).
;;              GT8 (the tools' lists): :id-re REGEX (group 1 the id, group 2 when present the part named on the line:
;;              the ids then bare, as the :subset's names), :always [IDS] (the negative controls' subjects: in the subset
;;              and every slice), :failed-as REPL (sed's replacement for :failed-re, default \1)
;;              GT8 (C's read lists): :id-as REPL (with :id-re: the id the match replaced, $1 its group 1, ids then under P/
;;              as without :id-re: C's results files' "CORPUS FILE" as CORPUS/FILE), :subset-key K (the corpus map's key that
;;              holds the subset, default :subset: a corpus two checks rotate keeps one each; GT8.3: a vector of keys, their
;;              union, for a check of two levels: C's c-check [:subset-run :subset-read], c-aot [:subset-aot :subset-cf2g])
;;   :judges    {:failed-re ERE :failed-as REPL} on a step whose :uses read rotated checks' outputs (Java's judge): its
;;              failure's ids noted as a failure of the producer whose list names them (bin/lib/gate-run.bash's judge_note)
;;   :parts     [{:part P :inputs [...] :pins [...] :clean-only true ...} ...]: one step per part, NAME.P,
;;              each keyed alone (the step's :inputs and the part's), {part} in :cmd its name; a :clean-only
;;              part (a parked sub-project's corpus, GTS19 (a)) runs only with GATE_ALL_PARTS=1 (GT7's clean
;;              run); :needs, :uses and :start-after naming the step name its parts
;;   :outputs   true: the step writes into $GATE_OUT (.tmp/gate/out/NAME), kept with its pass and put back
;;              when it is skipped
;;   :uses      ["STEP" "STEP/FILE" ...]: earlier steps' outputs it reads ($GATE_OUTS/STEP), their digests in
;;              its key (an early cutoff: a producer that ran and made the same output keeps it); implies
;;              :needs; it is decided at the plan when its producers are skipped, else once they ran
;;   :hosts     :prog, :javac-prog (GTS4 (b), (c)): the gate's executables, javac's tool, known by the
;;              program j2g made of them (its units: bin/lib/prog-units.bash) and the rest of what they
;;              are built from (bin/arbace-go --gate-rest-key, arbace_javac_rest_key), not by their sources;
;;              a step on them declares the sources it reads itself (the audit holds it to that)
;;   :never-loads  namespaces (and those below) the step never loads: their units out of its program
;;              host's identity and their sources out of its files, so that a change to them (j2g's)
;;              keeps its key; bin/gate --audit records the namespaces a step loads (ARBACE_LOADED_LOG)
;;              and fails on one of these
;; The inputs are declared coarsely (whole trees); bin/gate --audit (GT4) runs a step under strace and fails
;; on a file of the checkout it reads that its declaration, its hosts' keys and the gate's logic do not
;; cover. A host covers the sources its key hashes (:gate gate_key's, :javac arbace_javac_key's, bin/lib
;; with them), so a step on it declares no libraries (GTS23 (a)); the planner (GTS29 (a)) fails on a rule
;; that matches no file, a step, host or pin that does not exist.
;; Stage 0's compiled namespaces (target/seed/aot, made by bin/seed --build but not the gate's
;; --no-aot; RPS95 (b)) are a --build-program base only when their aot.key is the checkout's: a
;; product of :stage0 and of the embedded sources, which :gate's identity covers.
{:groups
 {;; the scripts' common libraries (bin/lib's top level: tmpdir, host, tools, version, ...)
  :lib ["bin/lib/*.bash"]
  ;; the libraries a script reads that no host's identity covers (GTS23 (a), the audit's findings): the
  ;; gate's executables (:gate) and javac's tool (:javac) are keyed by sources that include bin/lib, so a
  ;; step on them declares none; a step on stage 0 alone declares its own
  :lib-base ["bin/lib/tmpdir.bash" "bin/lib/renamed-env.bash"]
  :lib-tools [:lib-base "bin/lib/tools.bash" "bin/lib/host.bash"]
  ;; the checkout's namespaces a tool on stage 0 or on an executable loads instead of its embedded
  ;; copy when they differ (bin/lib/tools.bash): Arbace's sources less the runtime's Java forms
  ;; (arbace/lang/, compiled, not loaded; its namespaces' variants are) and the namespaces no
  ;; executable embeds (repr/java, repr/haskell, repr/rust, repr/ocaml, repr/scheme, scheme, repr/python, repr/cpp,
  ;; repr/llvm, arbace/cpp: arbace/j2g/embed.ae's excluded; repr/ocaml is evaluated, not embedded)
  :tools ["arbace/" "!arbace/lang/" "!arbace/repr/java.ae" "!arbace/repr/java/"
          "!arbace/repr/haskell.ae" "!arbace/repr/haskell/" "!arbace/repr/rust.ae" "!arbace/repr/rust/"
          "!arbace/repr/ocaml.ae" "!arbace/repr/ocaml/"
          "!arbace/repr/scheme.ae" "!arbace/repr/scheme/" "!arbace/scheme/"
          "!arbace/repr/python.ae" "!arbace/repr/python/"
          "!arbace/python.ae" "!arbace/python/"
          "!arbace/repr/cpp.ae" "!arbace/repr/cpp/" "!arbace/repr/llvm.ae" "!arbace/repr/llvm/" "!arbace/cpp/"]
  ;; (the provenance files repr/java writes, which name its sources' hash and the tool, are inputs of
  ;; the verifies that compare them alone: javac-verify, jrt-convert, java-fixtures)
  ;; the build's scripts (a step that builds a program of its own)
  :build ["bin/arbace-go" "bin/lib/program.bash" "bin/j2g" "bin/build-go" "bin/lib/build-go/" "bin/jrt" "bin/goi" "bin/repr-go"
          "bin/lib/repr-go/" "bin/lib/repr-go-host.bash" "x509roots/"]
  :repr-go ["bin/repr-go" "bin/lib/repr-go/" "bin/lib/repr-go-host.bash" "tools/godump/" "tools/gocmp/"
            "tools/godeps/" "tools/goplan/" "test/repr/go/" "go/arbace/repr/"]
  :goi ["bin/goi" "bin/lib/cover.bash" "test/goi/" "go/" "tamago/goroot/"]
  ;; C's tools (C8, CS19): the checkout's arbace/c and arbace/repr/c are evaluated on stage 0 (embedded since C9, but stage 0 is the old seed's until the re-seed),
  ;; the corpora's references test/c/ and test/repr/c/
  :c ["bin/ci" "bin/lib/ci/" "bin/lib/cover.bash" "bin/lib/gate-cache.bash" "bin/repr-c" "bin/lib/repr-c/" "arbace/c.ae" "arbace/c/" "arbace/repr/c.ae" "arbace/repr/c/"
      "test/c/" "test/repr/c/"
      ;; C's own target (c/README.md): its headers and description, read by every C step
      "c/"]
  ;; the run level's back end (queue 138): go/arbace/ci over go/arbace/crt, their package files printed by bin/repr-go and built
  ;; with tools/cirun by bin/ci cirun-build, which bin/ci check, check --aot, repl-session and judge-test run when .tmp/ci/cirun is absent;
  ;; queue 163: its key (.tmp/ci/key) hashes arbace/repr/go{.ae,/}, and its print loads repr/go's printer (arbace.repr.go.print,
  ;; print_code, print_emit, print_text: tool namespaces, the checkout's read beside the embedded copies), as cf2g does (check --aot)
  :c-run ["go/arbace/ci.ae" "go/arbace/ci/" "go/arbace/crt.ae" "go/arbace/crt/" "tools/cirun/" "bin/repr-go" "bin/lib/repr-go-host.bash"
          "arbace/repr/go.ae" "arbace/repr/go/"]
  ;; queue 163: the runtime's namespaces c2j-check reads from the checkout (ARBACE_PATH_FIRST and ARBACE_NO_IMAGE: every namespace
  ;; it loads is the checkout's source, the embedded copies' compiled code kept), probed with strace on stage 0
  :c2j-runtime ["arbace/core.ae" "arbace/core/" "arbace/core_*.ae" "arbace/edn.ae" "arbace/genclass.ae" "arbace/gvec.ae"
                "arbace/instant.ae" "arbace/java/io.ae" "arbace/main.ae" "arbace/set.ae" "arbace/spec/" "arbace/string.ae"
                "arbace/uuid.ae" "arbace/walk.ae"]
  ;; the oracle of repr/c's token and tree checks and of the annotations check: cc run by tools/ccdump, which bin/repr-c
  ;; ccdump-build builds against go-whim's crefactor at test/c/corpora.edn's commit (outside the checkout, checked there)
  :c-ccdump ["tools/ccdump/"]
  :java ["bin/java-check" "test/java/"]
  ;; what the runs of Java's check read (GT5): not its classes and records, which only its judgment reads
  ;; (test/java/divergences*.edn, check-*.edn, levels-known.edn), nor the essential tests' forms and list
  :java-run ["bin/java-check" "bin/lib/cover.bash" "test/java/" "!test/java/divergences.edn" "!test/java/divergences-diffcheck.edn"
             "!test/java/check-*.edn" "!test/java/levels-known.edn" "!test/java/forms/" "!test/java/essential.txt"
             ;; JCV1: the oracle tier's records (the JDK's record's judgment, bin/java-check --judge --oracle by hand)
             "!test/java/oracle/"
             ;; the per-test limits (GTS102): only the steps that run programs (their :inputs name it), so that
             ;; a limit's change (GTS180 (a)) reruns no read, classes, print or diagnostics level
             "!test/java/timeouts.txt"
             ;; the limits' test (gate-tests' input, read by no Java step): editing it, as the lines' lowering
             ;; does, reruns no Java level
             "!test/java/timeouts-test.bash"]
  ;; Java's judgment (bin/java-check --judge, on stage 0)
  :java-judge ["bin/java-check" "test/java/check.ae" "test/java/ref-jdk26.edn" "test/java/corpora.edn"
               "test/java/divergences.edn" "test/java/check-*.edn" "test/java/levels-known.edn"
               ;; GTS81 (a): the negative controls the report judges
               "test/java/controls.edn"
               ;; JCV1: whose verdict judges each test (the own verdict's, the rows judged again by it)
               "test/java/verdicts.edn"
               ;; queue 023, report 022 finding 5: the libraries bin/java-check sources at its top, every --judge
               ;; run (program.bash, and version.bash through it; limit.bash), which the stage 0 host's
               ;; identity does not cover (the audit let them through as java-check's, a :uses producer's)
               "bin/lib/program.bash" "bin/lib/version.bash" "bin/lib/limit.bash"]
  :repr-java ["arbace/repr/java.ae" "arbace/repr/java/" "bin/repr-java" "bin/lib/repr-java/" "test/repr/java/"
              "jdk/" "!jdk/provenance.edn" "!jdk/javac/provenance.edn" "overlay/jdk/" "bin/lib/frozen.bash" "bin/lib/java26.bash" "test/frozen-clojure.sha256"]
  ;; repr/java's tree checks per corpus (GT5): the common inputs, less each corpus's own data, which
  ;; its part declares (:corpus-*)
  :repr-java-checks [:repr-java "bin/lib/heavy.bash" "!test/repr/java/java/" "!test/repr/java/module/"]
  :corpus-samples ["test/repr/java/java/" "test/repr/java/module/"]
  :corpus-jdk ["bin/jrt-convert" "test/jrt/" "doc/go/java-surface.edn" "overlay/jdk/java.base/" "jdk/sources.txt"]
  :corpus-javac ["jdk/javac/sources.txt" "overlay/jdk/javac/"]
  :suite ["bin/clojure-tests" "bin/lib/cover.bash" "test/run_clojure_tests.clj" "test/suite-go/" "test/clojure/" "test/suite_aot_hook.ae"
          "test/baseline-results.edn" "test/arbace-go-results.edn" "test/arbace-go-aot-results.edn"
          "test/java-fixtures/" "!test/java-fixtures/provenance.edn" "bin/lib/repr-clojure/" "bin/repr-clojure" "test/repr/clojure/" "test/frozen-clojure.sha256"]
  ;; C++'s tools (CX10): repr/cpp, repr/llvm and the lowering evaluated from the checkout on stage 0, cxxdump (clang's AST, the
  ;; oracle), the records (test/cpp/, test/repr/cpp/); g++ and clang++ are the host :cxx, gcc :gcc
  ;; cpp-indep (CP240 (a), CP241 (b)): the IR packs' tooling (test/oracle-records/) and libstdc++'s tree made without g++ (cpp/target/,
  ;; test/cpp/target.ae over C's sysroot, bin/lib/repr-c/sysroot.bash); the packs' pins test/cpp/records/*.sha256 are under test/cpp/
  :cpp ["cpp/" "test/oracle-records/" "bin/lib/repr-c/sysroot.bash" "bin/repr-cpp" "bin/lib/repr-cpp/" "bin/cppi" "bin/lib/cppi/" "arbace/repr/cpp.ae" "arbace/repr/cpp/" "arbace/repr/llvm.ae"
        "arbace/repr/llvm/" "arbace/cpp/" "tools/cxxdump/" "test/cpp/" "test/repr/cpp/"]
  ;; Scheme's tools (SM9): repr/scheme and si's Arbace side evaluated from the checkout on stage 0, psyntax's forms and the libraries
  ;; (scheme/), the records and references (test/scheme/), Chez's dumper; the corpora the main checkout's .tmp/scheme/corpora (GTS212)
  :scheme ["bin/si" "bin/repr-scheme" "arbace/repr/scheme.ae" "arbace/repr/scheme/" "arbace/scheme/" "scheme/" "test/scheme/"
           "tools/schemedump/" "tools/psyntax/"]
  ;; si's runtime: go/arbace/scm and the light driver, printed by repr/go and built by TamaGo's go
  :scheme-run ["go/arbace/scm.ae" "go/arbace/scm/" "bin/build-go" "bin/lib/build-go/"]
  ;; OCaml's tools (O8): repr/ocaml and o2j evaluated from the checkout on stage 0, the helper tools/ocdump on the host's compiler-libs
  ;; (:ocaml), the records and references (test/ocaml/); the corpora read in the main checkout's .tmp/repr-ocaml at their pins (GTS212)
  :ocaml ["bin/oi" "bin/lib/oi/" "bin/repr-ocaml" "bin/lib/limit.bash" "arbace/repr/ocaml.ae" "arbace/repr/ocaml/" "tools/ocdump/"
          "test/ocaml/"]
  ;; oi's driver: go/arbace/oi printed by repr/go and built by TamaGo's go; the AOT level's runtime jdk/ocaml/
  :ocaml-run ["go/arbace/oi.ae" "go/arbace/oi/" "bin/repr-go" "bin/lib/repr-go-host.bash" "bin/lib/repr-go/"]
  :ocaml-aot ["jdk/ocaml/"]
  ;;@ groups (GT9: a crop's groups spliced above this line, gate.crops splice: test/gate/crops/*.edn)
  }

 :steps
 [;; ---- before the plan: one after another, each needing the one before
  {:name makefile :phase :pre :kind :always :cmd "make -s check-makefile"}
  {:name seed :phase :pre :kind :always :cmd "bin/seed --check" :summary ["pinned" 1]}
  ;; GTS53 (a): kept by its pins and by the digests of bin/seed and bin/lib/seed-go.bash (bin/seed's pins file, the
  ;; :stage0 host's identity), and audited at the clean run (bin/gate --clean) and by bin/gate --audit stage0
  ;; (ARBACE_SEED_FORCE=1: built, not kept) against these declarations and the host's; GTS83 (a), review 001's fixes:
  ;; in a linked worktree without a current one of its own, bin/gate first links the main checkout's into the worktree's
  ;; target/seed (`bin/seed --link MAIN/target/seed`: when its pins line is this worktree's), which this command then
  ;; keeps; not in the clean run
  {:name stage0 :phase :pre :kind :always :cmd "bin/seed --build --no-aot"
   :hosts [:stage0] :inputs [:lib-base] :audit-cmd "env ARBACE_SEED_FORCE=1 bin/seed --build --no-aot"
   :summary ["bin/seed: .*arbace|stage 0 in|stage 0 kept" 2]}

  ;; ---- the builds: when a check that runs needs them, all before the checks (GT5: then planned again)
  {:name go-build :heavy true :mem-gib 20 :phase :build :kind :build :cmd "bin/arbace-go --gate-build"
   :hosts [:gate]
   :summary ["cached executables|building the executables|built in|FAIL" 3]}
  ;; javac's tool, built once per arbace_javac_key (GTS11 (a)) and kept in ARBACE_GATE_EXES/javac-KEY
  {:name javac-tool :heavy true :mem-gib 27 :phase :full :chain go :kind :build :needs [go-build]
   :cmd "bin/javac-vendor tool \"$GATE_JAVAC_DIR\" --host \"$GATE_EXE\" --aot-base \"$GATE_CACHE/amd64\""
   ;; GTS72 (a): bin/javac-vendor (its own command) is in arbace_javac_key, the :javac host's identity
   :hosts [:javac] :summary ["^javac-vendor tool" 2]}

  ;; goi's steps never load j2g but its zlib (arbace.j2g.zlib: arbace.go.table compresses goi's table with it;
;; GT7's clean audit found goi-aot-essential loading it when the table is made cold): their :never-loads
;; name j2g's other namespaces, one by one
;; ---- the essential checks, concurrently on the cached executables. On :prog (GT5, GTS4 (b), (c)) the
  ;; ones that never load j2g: a j2g change that leaves the program's other units alone keeps them
  ;; (on :gate: its bin/arbace-go --gate computes gate_key, reading every source the build reads: the
  ;; audit of GT5 found 1,560 reads the program host would not cover)
  {:name go-smoke :mem-gib 1 :phase :essential :needs [go-build] :cmd "bin/arbace-go --gate"
   :hosts [:gate]
   :inputs ["bin/arbace-go" "test/arbace-go-rlwrap.py" "tools/tlsserver/" "test/net/"
            "test/goi/calls.ae" "test/goi/repl.ae" "test/goi/session.in" "test/goi/session.expected"
            "test/goi/repl-pkgs/" "test/goi/run/"]
   :summary ["ok|FAIL" 1]}
  {:name suite-go :heavy true :mem-gib 14 :phase :essential :needs [go-build]
   :cmd "env CLOJURE_TESTS_GO=\"$GATE_TESTS\" bin/clojure-tests -j \"$GATE_JOBS\""
   :hosts [:prog :stage0 :jdk] :never-loads [arbace.j2g] :inputs [:tools :suite] :env ["GATE_TEST_JOBS" "ARBACE_FROZEN_JAVA_HOME"]
   :summary ["TOTAL|regressions" 2]}
  {:name oracle-go :mem-gib 5 :phase :essential :needs [go-build]
   :cmd "bin/oracle check \"$GATE_EXE -\" --timeout 900 --expected test/oracle/known-go-amd64-frozen.edn"
   :hosts [:prog :stage0 :frozen :jdk] :never-loads [arbace.j2g] :inputs [:lib-tools "bin/oracle" "test/oracle/"]
   :env ["ARBACE_FROZEN_JAVA_HOME" "FROZEN_CP" "FROZEN_TAG" "ARBACE_ORACLE_JAR" "ARBACE_ORACLE_TAG" "ARBACE_ORACLE_EXPECTED"] :summary ["^== " 2]}
  {:name diffcheck :heavy :inner :mem-gib 31 :phase :essential :needs [go-build] :cmd "bin/diffcheck"
   :hosts [:gate :stage0] :inputs [:tools :build "bin/diffcheck" "test/diffcheck/" "test/oracle/" "test/j2g/"]
   :summary ["^== |^diffcheck: the runs" 5]}

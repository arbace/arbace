  ;; (the user, 2026-11-02): each node program run by the interpreter (tools/cirun) too and the compiled runs compared with it (CS214),
  ;; a compiled run that differs from a passing interpreted one failing the step
  {:name c-aot :heavy true :mem-gib 4 :phase :full :chain c-full
   :cmd "env ARBACE_PATH_FIRST=1 ARBACE_NO_AOT=1 ARBACE_NO_IMAGE=1 CI_AOT_NODES=1 CI_JOBS=4 bin/ci check --aot --corpus {part}"
   :hosts [:stage0 :go :gcc] :never-loads [arbace.j2g] :pins ["test/c/corpora.edn"]
   :inputs [:lib-tools :c :c2j-runtime :c-run]
   :parts [{:part torture-execute} {:part torture-execute-mirror} {:part tcc-tests2} {:part compcert} {:part mir} {:part cxgo}
           {:part benchmarksgame} {:part gcc-c23-run} {:part gcc-cpp-c23-run} {:part gcc-c23-sub-run} {:part gcc-gnu23-run}
           {:part gcc-embed-run} {:part gcc-va-opt-run} {:part gcc-bitint-run} {:part ci-run}]
   :summary ["programs: |regression|no reference|^ci check|FAIL" 6]
   ;; GT8.3: this step's levels, the compiled programs' runtime and cf2g's translation
   :rotate {:only "--only {list}" :universe "test/c/check-aot-linux-amd64.edn" :subset "test/c/corpora.edn" :subset-key [:subset-aot :subset-cf2g]
            ;; review 181 L4: the :run control's subject (test/c/controls.edn) in the subset and every slice
            :always ["benchmarksgame/fannkuchredux.c" "benchmarksgame/fasta.c"] :failed-re "^FAIL ([^[:cntrl:]]+)[[:cntrl:]].*$"}}
  ;; the read level's dg check: gcc 15.2's C23 tests (627 files) by their directives, gcc run on each (about 8 minutes)
  {:name c-dg :heavy true :mem-gib 3 :phase :full :chain c-full
   :cmd "env ARBACE_PATH_FIRST=1 ARBACE_NO_AOT=1 ARBACE_NO_IMAGE=1 CI_JOBS=4 bin/ci dg"
   :hosts [:stage0 :gcc] :never-loads [arbace.j2g] :pins ["test/c/corpora.edn"]

  :ocaml-capi ["bin/ci" "bin/lib/ci/" "bin/lib/crops/musl-hold.bash" "bin/lib/repr-c/" "arbace/c.ae" "arbace/c/" "arbace/repr/c.ae" "arbace/repr/c/" "c/"
               "test/c/corpora.edn" "test/c/host/"]

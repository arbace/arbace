           {:part tcc-pp} {:part compcert} {:part mir} {:part cxgo} {:part benchmarksgame} {:part sqlite} {:part zlib}
           {:part quickjs} {:part gcc-c23} {:part gcc-cpp-c23} {:part gcc-c23-sub} {:part gcc-gnu23} {:part gcc-embed}
           {:part gcc-va-opt} {:part gcc-bitint} {:part mutants :cmd "bin/repr-c parse-check --mutants-only"}]
   :summary ["^[a-z0-9-]*: [0-9]|^mutants:|FAIL|fail" 4]
   ;; GT8 (doc/GATE-SURVEY.md, "As built: GT8 (C's read lists)"): --nightly's subset and slice by --only; the universe the results

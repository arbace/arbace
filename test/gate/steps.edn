 ;; GT8.1 (queue 170): bin/gate --costs (test/gate/costs.ae) alone reads :crops and :budgets; the planner reads :groups and
 ;; :steps, so neither is in any key. :crops: each step's crop, the language whose support it checks (a step's parts are its
 ;; crop's): :clojure, :java, :go, :c, or :shared (the builds, the gate's own steps and those of the whole pipeline: the
 ;; executable's smoke test, the fixpoint, j2g's edge, the generated variants, the mixed programs, the REAP matrix); every
 ;; step in exactly one (bin/gate --costs fails on a step in none, test/gate/costs-test.bash checks this table).
 ;; cpp-c2j and scheme-c2j are C++'s and Scheme's since the rows' merge (CP190 (a), merge plan batch 1)
 :crops {:shared [makefile seed stage0 go-build javac-tool go-smoke programs generated gate-tests j2g-edge reap crops-score provenance
                  fixpoint programs-full]
         :clojure [suite-go oracle-go diffcheck suite-aot-essential suite-aot repr-clojure]
         :java [java-check java-check-judge java-compiled repr-java-closure javac-check javac-verify javac-classes repr-java
                repr-java-roundtrip jrt-convert java-fixtures repr-java-parse repr-java-front repr-java-platform repr-java-attr
                repr-java-nojavac java-read java-interp java-classes java-diagnostics java-compiled-full java-print
                java-forms-verify java-judge java-held]
         :go [goi-check goi-aot-essential repr-go repr-go-native goi goi-check-full goi-aot]
         :c [c-dg-essential c-check-essential c-aot-essential c-c23 c-c2j c-judge-test c-check c-aot c-dg c-annotations c-tokens
             c-parse c-roundtrip]
         :cpp [cpp-runtime cpp-read-essential cpp-print-essential cpp-lower-essential cpp-check-essential cpp-selftest cpp-tokens cpp-dg
               cpp-roundtrip cpp-roundtrip-dg cpp-lower cpp-check cpp-aot cpp-c2j]
         :scheme [si-essential si-aot-essential scheme-read-essential scheme-read scheme-roundtrip si-check si-aot si-corpora si-ecraven si-mats scheme-c2j]
         :ocaml [oi-essential oi-divergences ocaml-read-essential ocaml-roundtrip ocaml-dumps oi-check oi-aot oi-suite-aot ocaml-judges]
         ;;@ crops (GT9: a crop's entry spliced above this line)
         }
 ;; GT8's budgets (the user, 2026-11-03), seconds, for :crops crops: the essential gate's wall (a merge), the nightly run
 ;; (bin/gate --full: serial), the clean run (bin/gate --full --clean: every part, audited)
 :budgets {:crops 10 :essential-s 900 :nightly-s 21600 :clean-s 86400
           ;; GT9 (doc/GATE-SURVEY.md, "GT9: the crops' gate", GTS210-GTS223 decided (a), "As built: GT9 (write-ahead)"): the seven
           ;; crops beyond the four, each a key of :crops once it has a step (bin/gate --costs knows them); their weights in a share
           ;; (GT9.1, LLS17: LLVM IR half a share, carved from C++'s and Rust's; the others 1; the four and the seven sum to :crops);
           ;; GTS222 (a): a new crop's share binds once every one of its steps of the tier has two passes (until then --costs says
           ;; "measuring" in place of OVER); GTS215 (a): a new crop's essential chain at most :chain-s of wall (warm), LLVM's 60,
           ;; its essential checks at most :essential-mem-gib, never :heavy
           :new-crops [:cpp :llvm :ocaml :scheme :haskell :rust :python]
           :shares {:cpp 0.75 :rust 0.75 :llvm 0.5}
           :chain-s 120 :chain-s-by {:llvm 60} :essential-mem-gib 3}

 ;; GTS216 (a): the new crops' light chains at night. In bin/gate --full and --nightly (not the clean run, not --concurrent,
 ;; whose lanes run every chain at once) a :full chain runs beside the serial run when every one of its steps is a new crop's,
 ;; none :heavy, each at most :max-step-gib (its parts' :mem-gib too), and its :needs in the chain or outside the full phase; the
 ;; chains are admitted in the table's order while their peaks (each chain's largest :mem-gib) sum to at most :max-gib.
 ;; GATE_CROPS_CONCURRENT=0: all serial. Read by test/gate/crops.ae (bin/gate), in no key.
 :night-concurrent {:max-step-gib 4 :max-gib 24}

 ;; GTS210 (a): the hosts' identities as data. HOST [ITEM ...], each ITEM [OP ARG ...]: the identity is the SHA-256 of the
 ;; items' lines in order, "none" when a :require command is missing (bin/gate's gate_host_id; test/gate/crops.ae prints the
 ;; recipes of the hosts a step names and bin/lib/gate-run.bash's plan_inputs does not write; test/gate/crops-test.bash). OPs:
 ;;   :require CMD...           every CMD on PATH (command -v), else the identity is none
 ;;   :version CMD ARG...       the first line of its stdout          :version-any  the first line of stdout and stderr
 ;;   :lines CMD ARG...         all of its stdout                     :exe CMD      its executable's SHA-256 through its links
 ;;   :prog MISSING CMD ARG...  the SHA-256 of the file its output names, through its links (MISSING when there is none)
 ;;   :dir CMD ARG...           its output is {dir} in the later items' arguments (no line)
 ;;   :file GLOB...             each match's SHA-256, in order ("missing GLOB" when none)
 ;;   :digest-list FILE         sha256sum's line of each path FILE lists in its second column ("missing PATH" when absent)
 ;; An argument ${NAME:-DEFAULT} is NAME's value from the environment, else DEFAULT. The table is in no key itself: a step on a host
 ;; is keyed by the host's identity. :gcc is gate_gcc_id's (bin/lib/gate-run.bash) item for item, the same identity (crops-test):
 ;; plan_inputs writes :gcc until the runner next changes (the move, "As built: GT9", Proposed GTS240), so that this table rekeys none
 ;; of the four crops' steps. The others: C++'s (cpp-cx10's gate_cxx_id), Scheme's (scheme-sm9's gate_scheme_id) and OCaml's
 ;; (ocaml-o8's gate_ocaml_id), item for item; LLVM IR's, GHC's, rustc's and CPython's new (GT9.2's "Hosts")
 :host-ids
 {:gcc [[:require "gcc"] [:version "gcc" "--version"] [:exe "gcc"] [:prog "no cc1" "gcc" "-print-prog-name=cc1"]
        [:digest-list "test/c/host/headers.sha256"]]
  :cxx [[:require "g++" "clang++"] [:version "g++" "--version"] [:version "clang++" "--version"] [:exe "g++"]
        [:prog "no cc1plus" "g++" "-print-prog-name=cc1plus"] [:exe "clang++"] [:digest-list "test/cpp/host/headers.sha256"]]
  :llvm [[:require "${REPR_LLVM_BIN:-/usr/lib/llvm23/bin}/llvm-as"] [:lines "${REPR_LLVM_BIN:-/usr/lib/llvm23/bin}/llvm-as" "--version"]
         [:exe "${REPR_LLVM_BIN:-/usr/lib/llvm23/bin}/llvm-as"] [:exe "${REPR_LLVM_BIN:-/usr/lib/llvm23/bin}/opt"]
         [:exe "${REPR_LLVM_BIN:-/usr/lib/llvm23/bin}/lli"] [:exe "${REPR_LLVM_BIN:-/usr/lib/llvm23/bin}/FileCheck"]
         [:file "${REPR_LLVM_BIN:-/usr/lib/llvm23/bin}/../lib/libLLVM.so.*"]]
  :ocaml [[:require "ocamlc" "ocamlopt"] [:dir "ocamlc" "-where"] [:version "ocamlc" "-version"] [:version "ocamlopt" "-version"]
          [:exe "ocamlc"] [:exe "ocamlopt"]
          [:file "{dir}/compiler-libs/ocamlcommon.cmxa" "{dir}/compiler-libs/ocamlcommon.a" "{dir}/compiler-libs/ocamlcommon.cma"
           "{dir}/stdlib.cma" "{dir}/stdlib.cmxa" "{dir}/stdlib.a"]]
  :chez [[:require "${CHEZ:-chez}"] [:version-any "${CHEZ:-chez}" "--version"] [:exe "${CHEZ:-chez}"]
         [:file "/usr/lib/csv10.3.0/ta6le/petite.boot" "/usr/lib/csv10.3.0/ta6le/scheme.boot" "/usr/lib/csv10.3.0/ta6le/chez.boot"]]
  :chibi [[:require "${CHIBI:-chibi-scheme}"] [:version-any "${CHIBI:-chibi-scheme}" "-V"] [:exe "${CHIBI:-chibi-scheme}"]]
  :ghc [[:require "ghc"] [:version "ghc" "--version"] [:dir "ghc" "--print-libdir"]
        [:file "{dir}/../bin/ghc-[0-9]*" "{dir}/package.conf.d/ghc-[0-9]*.conf"]]
  :rustc [[:require "rustc"] [:lines "rustc" "--version" "-v"] [:exe "rustc"] [:dir "rustc" "--print" "sysroot"]
          [:file "{dir}/lib/librustc_driver-*.so"]]
  :python [[:require "python3"] [:version "python3" "--version"] [:exe "python3"] [:file "/usr/lib/libpython3.*.so.1.0"]]}

 ;; GTS211 (a): the new crops' pins, run by bin/gate --pins (the clean run's first step) once the crop has a step in :crops, and
 ;; recorded in its map (:crops). One entry a line, [CROP "WHAT" "COMMAND"]: bin/gate reads it with awk (the pins step runs before
 ;; stage 0 exists), test/gate/crops.ae checks it and the awk reading agree (crops-test). A command marked NEW in its comment is
 ;; not built yet; it must be before the crop's first step is merged
 :crop-pins
 [[:cpp "C++'s pins (test/cpp/corpora.edn: the gcc and llvm-project tarballs, the APKBUILD) and the host's compilers' answers (test/cpp/host/)" "bin/repr-cpp pins check && bin/repr-cpp host check"]
  [:llvm "LLVM IR's tools against their pins" "bin/repr-llvm pins check"] ; gt9v-llvm (on llvm-verify3)
  [:ocaml "OCaml's corpora, the 5.5.0 tarball, go-whim's commit and the opam set (test/ocaml/corpora.edn)" "bin/repr-ocaml corpus check"] ; ocaml-o8's verb
  [:scheme "Scheme's corpora's files (test/scheme/corpora.edn), Chez's boot files, Chibi's version and whimsical's tree (SC234)" "bin/repr-scheme pins check"] ; gt9v-scheme (on scheme-sm9)
  [:haskell "GHC 9.14.1's tarball (test/haskell/corpus-ghc-9.14.1.edn), the testsuite tarball and nofib's tree" "bin/repr-haskell corpus check && bin/hsi pins --check"] ; NEW: corpus check; hsi's at haskell-he4d's merge
  [:rust "rust-src and rustc-dev's apks (tools/rsdump/apks.sha256), the crates and the UI tarball" "bin/repr-rust pins check"] ; gt9v-rust (on rust-re5)
  [:python "CPython 3.14.10 (tools/pydump/PYTHON_VERSION), the tarball, the site-packages apks and pyperformance" "bin/repr-python pins --check"]]

 ;; GTS218 (a): each new crop's check step names its negative control before it is gated: STEP "FILE" (the control's record, judged
 ;; by the family's own judge, which the step's run reads: FILE among the step's inputs), or STEP {:waived "WHY"} (a check that
 ;; is itself a judgment of records or a unit test with its own negative cases). bin/gate --costs and crops-test fail on a new
 ;; crop's check with neither
 :controls {
  cpp-read-essential {:waived "the token oracle's comparison against g++ -E and clang (GT9.8 \"Not covered\": pp-check; GTS242)"}
  cpp-print-essential "test/repr/cpp/roundtrip-controls.edn"
  cpp-lower-essential "test/cpp/controls.edn"
  cpp-check-essential "test/cpp/controls.edn"
  cpp-selftest {:waived "the checks' own tests: each a negative case (review 007's)"}
  cpp-tokens {:waived "as cpp-read-essential (GTS242)"}
  cpp-dg {:waived "no crossed pair yet (CP214, GTS242)"}

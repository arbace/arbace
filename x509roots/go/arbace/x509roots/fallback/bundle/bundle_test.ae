(in-ns 'go.arbace.x509roots.fallback.bundle) (go/file "bundle_test.go" :imports [


    ^{:line 8} [sha256 "crypto/sha256"]
    ^{:line 9} [x509 "crypto/x509"]
    ^{:line 10} [hex "encoding/hex"]
    ^{:line 11} [testing "testing"]])


^{:go/end 32} (go/func TestBundle [^{:tag (* testing/T)} t]
  (range [i unparsed unparsedCertificates]
    (let [(values cert err) (x509/ParseCertificate (subslice rawCerts (.-certStartOff unparsed) (+ (.-certStartOff unparsed) (.-certLength unparsed))))]
      (when (!= err nil)
        ^{:go/via [common]} (.Errorf t "ParseCertificate(unparsedCertificates[%v]) unexpected error: %v" i err)
        (continue))


      (when (not (subjectsEqual (.-cn unparsed) (.String (.-Subject cert))))
        ^{:go/via [common]} (.Errorf t "unparsedCertificates[%v].cn = %q; want = %q" i (.-cn unparsed) (.String (.-Subject cert))))


      (let [sum (sha256/Sum256 (.-Raw cert))
          ^{:line 27} sumHex (hex/EncodeToString (subslice sum))]
        (when (!= sumHex (.-sha256Hash unparsed))
          ^{:go/via [common]} (.Errorf t "unparsedCertificates[%v].sha256Hash = %q; want = %q" i (.-sha256Hash unparsed) sumHex))))))

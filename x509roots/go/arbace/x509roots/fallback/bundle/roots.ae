;; Package bundle contains the bundle of root certificates parsed from the NSS
;; trust store, using x509roots/nss.
(in-ns 'go.arbace.x509roots.fallback.bundle) (go/file "roots.go" :doc "Package bundle contains the bundle of root certificates parsed from the NSS\ntrust store, using x509roots/nss.\n" :imports [


    ^{:line 10} [x509 "crypto/x509"]
    ^{:line 11} [_ "embed"]
    ^{:line 12} [fmt "fmt"]
    ^{:line 13} [iter "iter"]
    ^{:line 14} [time "time"]])



(go/var ^{:tag (slice byte) :go/embed "bundle.der"} rawCerts)


(go/type Root "Root represents a root certificate parsed from the NSS trust store.\n" (struct

    ^{:line 23 :tag (slice byte) :doc "Certificate is the DER-encoded certificate (read-only; do not modify!).\n"} Certificate







    ^{:line 31 :tag (func [(slice (* x509/Certificate))] [error]) :doc "Constraint is nil if the root is unconstrained. If Constraint is non-nil,\nthe certificate has additional constraints that cannot be encoded in\nX.509, and when building a certificate chain anchored with this root the\nchain should be passed to this function to check its validity. If using a\n[crypto/x509.CertPool] the root should be added using\n[crypto/x509.CertPool.AddCertWithConstraint].\n"} Constraint))





^{:go/end 63} (go/func Roots "Roots returns the bundle of root certificates from the NSS trust store. The\n[Root.Certificate] slice must be treated as read-only and should not be\nmodified.\n" ^{:tag (iter/Seq Root)} []
  ^{:go/end 62} (fn [^{:tag (func [Root] [bool])} yield]
    (range [_ unparsed unparsedCertificates]
      (let [root ^{:go/breaks [2]} (lit Root
            :Certificate (subslice rawCerts (.-certStartOff unparsed) (+ (.-certStartOff unparsed) (.-certLength unparsed))))]

        ;; parse possible constraints, this should check all fields of unparsedCertificate.
        (when (!= (.-distrustAfter unparsed) "")
          (let [(values distrustAfter err) (time/Parse time/RFC3339 (.-distrustAfter unparsed))]
            (when (!= err nil)
              (panic (fmt/Sprintf "failed to parse distrustAfter %q: %s" (.-distrustAfter unparsed) err)))

            (set! (.-Constraint root) ^{:go/breaks [[3 55]] :go/end 56} (fn ^error [^{:tag (slice (* x509/Certificate))} chain]
                (range [_ c chain]
                  (when (.After (.-NotBefore c) distrustAfter)
                    (return (fmt/Errorf "certificate issued after distrust-after date %q" distrustAfter))))


                nil))))


        (when (not (yield root))
          (return))))))





(go/type unparsedCertificate (struct
    ^{:line 66 :tag string} cn
    ^{:line 67 :tag string} sha256Hash
    ^{:line 68 :tag int} certStartOff
    ^{:line 69 :tag int} certLength


    ^{:line 72 :tag string :doc "possible constraints\n"} distrustAfter))

(in-ns 'go.arbace.x509roots.fallback.bundle) (go/file "bundle127_test.go" :build ["//go:build go1.27"] :imports [])











^{:go/end 21} (go/func subjectsEqual "subjectsEqual reports whether two RFC 2253 DN strings match.\n\nWhen testing with Go 1.27 or newer, it requires subjects to match exactly.\nWhen testing with Go 1.26, it tolerates the rendering difference introduced in Go 1.27,\nwhere string-typed attribute values for OIDs outside attributeTypeNames are rendered\nas strings rather than hex-encoded DER (see Go CL 773800).\n\nWhen Go 1.26 is no longer supported,\nthe Go 1.26 version can be removed and\nthe Go 1.27+ version can be inlined.\n" ^bool [^string a ^string b]
  (== a b))

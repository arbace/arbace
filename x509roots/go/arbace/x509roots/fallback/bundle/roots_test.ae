(in-ns 'go.arbace.x509roots.fallback.bundle) (go/file "roots_test.go" :imports [


    ^{:line 8} [x509 "crypto/x509"]
    ^{:line 9} [testing "testing"]])


^{:go/end 18} (go/func TestRootsCanBeParsed [^{:tag (* testing/T)} t]
  (range [root (Roots)]
    (when [(values _ err) (x509/ParseCertificate (.-Certificate root))] (!= err nil)
      ^{:go/via [common]} (.Fatalf t "Could not parse root certificate: %v" err))))

;; The dialect Arbace's C++ reads (doc/cpp/CPP-SURVEY.md, "As built: cpp-target", CP244 (b)): GNU C++ as g++ 15.2's manual defines
;; it on x86_64-linux-musl (the reference the token check is judged by, CX2), the C++ half of the target whose C half is C's own,
;; c/target/abi.edn (the System V AMD64 ABI's data representation, the floating formats, the GNU identification). test/cpp/predef.ae
;; (cpp.predef, `bin/repr-cpp target gen`) makes cpp/target/host/ from abi.edn, this file, cpp/target/probes.tsv and
;; cpp/target/option-lists.txt, in the layout arbace.repr.cpp.host/load-host reads (test/cpp/host/'s, g++'s recorded answers, is
;; the oracle: `bin/repr-cpp target host-oracle`, by hand). No compiler is run or read. Sources: ISO/IEC 14882:2024 (C++23)
;; [cpp.predefined] and [cpp.cond] (Table 21, the standard attributes' values), WG21's SD-6 (the feature-test macros' values,
;; standard by standard), the GCC 15.2 manual ("Common Predefined Macros", "C++ Dialect Options", "Option Summary", "x86 Options"),
;; musl 1.2.6's include/stdc-predef.h. Read with the Clojure reader.
{;; the identification: C's :dialect (gcc 15.2.0) and g++'s own name for it
 :gnug 15
 ;; __cplusplus by the standard's year ([cpp.predefined]/1.1; C++26 the working draft's value g++ 15 gives it)
 :cplusplus {1998 "199711L" 2011 "201103L" 2014 "201402L" 2017 "201703L" 2020 "202002L" 2023 "202302L" 2026 "202400L"}
 ;; the base: C's macros of the C standard whose inline semantics the C++ standard has (C++98: GNU inline, as C89; from C++11
 ;; the C99 semantics, as C17), less what C alone defines (__STDC_VERSION__; __BITINT_MAXWIDTH__: _BitInt is C23's)
 :c-base {1998 "89" 2011 "17"}
 :c-only ["__STDC_VERSION__" "__BITINT_MAXWIDTH__"]
 ;; C++ writes the double constants' cast in functional notation (double(X), not ((double)X))
 :functional-cast true
 ;; the macros every mode defines: libstdc++'s target needs _GNU_SOURCE (the GNU C library's features, which musl's headers
 ;; take too), exceptions, RTTI and weak symbols on by default, the deprecated features' warnings (__DEPRECATED)
 :always [["_GNU_SOURCE" "1"] ["__DEPRECATED" "1"] ["__EXCEPTIONS" "1"] ["__GXX_RTTI" "1"] ["__GXX_WEAK__" "1"]]
 ;; the macros from a standard's year on
 :from-year [[2011 "__GXX_EXPERIMENTAL_CXX0X__" "1"] [2011 "__GXX_CONSTEXPR_ASM__" "1"] [2011 "__STDCPP_THREADS__" "1"]
             [2017 "__STDCPP_DEFAULT_NEW_ALIGNMENT__" "16"]
             ;; [basic.extended.fp]: the extended floating types the ABI has (binary16, 32, 64, 128 and bfloat16)
             [2023 "__STDCPP_FLOAT16_T__" "1"] [2023 "__STDCPP_FLOAT32_T__" "1"] [2023 "__STDCPP_FLOAT64_T__" "1"]
             [2023 "__STDCPP_FLOAT128_T__" "1"] [2023 "__STDCPP_BFLOAT16_T__" "1"]]
 ;; the GNU modes' extended integer type (__int128, libstdc++'s __GLIBCXX_TYPE_INT_N_0: an integer type only outside strict ISO)
 :gnu-only [["__GLIBCXX_TYPE_INT_N_0" "__int128"] ["__GLIBCXX_BITSIZE_INT_N_0" "128"]]
 ;; char8_t: a type from C++20, or with -fchar8_t (then the type macro and its atomic's lock-freedom, as C23's)
 :char8 {:from 2020 :macros [["__CHAR8_TYPE__" "unsigned char"] ["__GCC_ATOMIC_CHAR8_T_LOCK_FREE" "2"]]}
 ;; the feature-test macros (SD-6; [cpp.predefined]'s Table 22 for the language), the value from a year on; nil: not defined from
 ;; that year. g++'s own choices beside the standard's: the three extensions every mode has (binary literals, hexadecimal floating
 ;; literals and runtime-sized arrays, unless -pedantic: :pedantic below), exceptions and RTTI (unless -fno-exceptions, -fno-rtti),
 ;; the thread-safe statics; the C++26 values those g++ 15 implements
 :features
 {"aggregate_bases" [[2017 201603]] "aggregate_nsdmi" [[2014 201304]] "aggregate_paren_init" [[2020 201902]]
  "alias_templates" [[2011 200704]] "aligned_new" [[2017 201606]] "attributes" [[2011 200809]] "auto_cast" [[2023 202110]]
  "binary_literals" [[1998 201304]] "capture_star_this" [[2017 201603]] "char8_t" [[2020 202207]] "concepts" [[2020 202002]]
  "conditional_explicit" [[2020 201806]] "consteval" [[2020 202211]]
  "constexpr" [[2011 200704] [2014 201304] [2017 201603] [2020 202002] [2023 202211] [2026 202406]]
  "constexpr_dynamic_alloc" [[2020 201907]] "constexpr_in_decltype" [[2020 201711]] "constinit" [[2020 201907]]
  "decltype" [[2011 200707]] "decltype_auto" [[2014 201304]] "deduction_guides" [[2017 201703] [2020 201907]]
  "delegating_constructors" [[2011 200604]] "deleted_function" [[2026 202403]] "designated_initializers" [[2020 201707]]
  "digit_separators" [[2014 201309]] "enumerator_attributes" [[2017 201411]] "exceptions" [[1998 199711]]
  "explicit_this_parameter" [[2023 202110]] "fold_expressions" [[2017 201603]] "generic_lambdas" [[2014 201304] [2020 201707]]
  "guaranteed_copy_elision" [[2017 201606]] "hex_float" [[1998 201603]] "if_consteval" [[2023 202106]]
  "if_constexpr" [[2017 201606]] "impl_coroutine" [[2020 201902]] "impl_destroying_delete" [[2020 201806]]
  "impl_three_way_comparison" [[2020 201907]] "implicit_move" [[2023 202207]] "inheriting_constructors" [[2011 201511]]
  "init_captures" [[2014 201304] [2020 201803]] "initializer_lists" [[2011 200806]] "inline_variables" [[2017 201606]]
  "lambdas" [[2011 200907]] "multidimensional_subscript" [[2023 202211]] "named_character_escapes" [[2023 202207]]
  "namespace_attributes" [[2017 201411]] "nested_namespace_definitions" [[2017 201411]] "noexcept_function_type" [[2017 201510]]
  "nontype_template_args" [[2017 201411] [2020 201911]] "nontype_template_parameter_auto" [[2017 201606]]
  "nontype_template_parameter_class" [[2020 201806]] "nsdmi" [[2011 200809]] "pack_indexing" [[2026 202311]]
  "placeholder_variables" [[2026 202306]] "pp_embed" [[2026 202502]]
  "range_based_for" [[2011 200907] [2017 201603] [2023 202211]] "raw_strings" [[2011 200710]] "ref_qualifiers" [[2011 200710]]
  "return_type_deduction" [[2014 201304]] "rtti" [[1998 199711]] "runtime_arrays" [[1998 198712]]
  "rvalue_reference" [[2011 200610]] "rvalue_references" [[2011 200610]] "size_t_suffix" [[2023 202011]]
  "sized_deallocation" [[2014 201309]] "static_assert" [[2011 200410] [2017 201411] [2026 202306]]
  "static_call_operator" [[2023 202207]] "structured_bindings" [[2017 201606] [2026 202403]] "template_auto" [[2017 201606]]
  "template_template_args" [[2017 201611]] "threadsafe_static_init" [[1998 200806]]
  "unicode_characters" [[2011 200704] [2017 201411]] "unicode_literals" [[2011 200710]] "user_defined_literals" [[2011 200809]]
  "using_enum" [[2020 201907]] "variable_templates" [[2014 201304]] "variadic_friend" [[2026 202403]]
  "variadic_templates" [[2011 200704]] "variadic_using" [[2017 201611]]}
 ;; -pedantic (-pedantic-errors, -Wpedantic): the extensions a strict reading refuses lose their macros: runtime-sized arrays
 ;; always (VLAs are no C++), binary literals before C++14 (their standard), hexadecimal floating literals before C++17 in the ISO
 ;; modes (the GNU modes keep them as an extension)
 :pedantic {:runtime_arrays {} :binary_literals {:before 2014} :hex_float {:before 2017 :iso true}}

 ;; the options' effect on the macros (the manual's "Common Predefined Macros" and each option's entry), applied in order, the last
 ;; of a kind winning:
 ;;   -O, -O1, -O2, -O3, -Og, -Ofast: __OPTIMIZE__, no __NO_INLINE__ (unless -fno-inline); -Os, -Oz: also __OPTIMIZE_SIZE__; -O0 none;
 ;;     Alpine's g++ also defines _FORTIFY_SOURCE=2 when optimizing (its package's default, :fortify); -Ofast is -O3 -ffast-math
 ;;   -ffast-math: :fast-math's macros; then __GCC_IEC_559 0, and musl's <stdc-predef.h> defines __STDC_IEC_559__ only while
 ;;     __GCC_IEC_559 > 0
 ;;   -fno-exceptions, -fno-rtti, -fno-weak, -fno-dwarf2-cfi-asm; -fchar8_t, -fno-char8_t; -fconcepts (C++17: C++20's concepts),
 ;;     -fcontracts, -fmodules(-ts), -fgnu-tm: their feature macros (:option-features)
 ;;   -fopenmp, -fopenacc, -fgnu-tm: their macros and _REENTRANT (the driver links the runtime libraries with -pthread)
 ;;   -fpic, -fPIC, -fpie, -fPIE, -fno-pic, -fno-pie: __pic__/__PIC__ and __pie__/__PIE__ (1 the small model, 2 the large; the
 ;;     target's default is -fPIE, abi.edn's :pic)
 ;;   -fstack-protector(-all|-strong|-explicit), -fno-stack-protector: __SSP__ 1, __SSP_ALL__ 2, __SSP_STRONG__ 3, __SSP_EXPLICIT__ 4
 ;;   -fcf-protection[=full]: __CET__ 3 (=branch 1, =return 2)
 ;;   -fsanitize=address: __SANITIZE_ADDRESS__, -fsanitize=thread: __SANITIZE_THREAD__ (the other sanitizers define nothing)
 ;;   -fsignaling-nans: __SUPPORT_SNAN__; -frounding-math: __ROUNDING_MATH__
 ;;   -fabi-version=N: __GXX_ABI_VERSION 1000+N (N 0: the latest, the default); below 11 the old inheriting constructors
 ;;     (-fnew-inheriting-ctors is the default from ABI 11 on): __cpp_inheriting_constructors 200802L
 ;;   -march=CPU, -mFEATURE, -mno-FEATURE: :isa
 :fortify "2"
 :fast-math [["__FAST_MATH__" "1"] ["__ASSOCIATIVE_MATH__" "1"] ["__FINITE_MATH_ONLY__" "1"] ["__NO_MATH_ERRNO__" "1"]
             ["__NO_SIGNED_ZEROS__" "1"] ["__NO_TRAPPING_MATH__" "1"] ["__RECIPROCAL_MATH__" "1"]
             ["__GCC_IEC_559" "0"] ["__GCC_IEC_559_COMPLEX" "0"]]
 :option-features {:concepts {:from 2017 :macros [["__cpp_concepts" "202002L"]]}
                   :contracts {:macros [["__cpp_contracts" "201906L"] ["__cpp_contracts_literal_semantics" "201906L"]
                                        ["__cpp_contracts_roles" "201906L"]]}
                   :modules {:macros [["__cpp_modules" "201810L"]]}
                   :gnu-tm {:macros [["__cpp_transactional_memory" "201500L"] ["_REENTRANT" "1"]]}
                   :openmp {:macros [["_OPENMP" "201511"] ["_REENTRANT" "1"]]}
                   :openacc {:macros [["_OPENACC" "201711"] ["_REENTRANT" "1"]]}}
 :old-inheriting-ctors {:below-abi 11 :value "200802L"}
 ;; the x86 ISA (the manual's x86 Options): each extension's macro and the extensions it implies; -mX enables X and what it
 ;; implies, -mno-X disables X and what implies it; the baseline is abi.edn's :isa (x86-64 v1, tuned generic: __k8). -march=CPU
 ;; sets the CPU's extensions and its macros in place of the baseline's (__k8, __k8__)
 :isa {:extensions {"sse3" {:macro "__SSE3__"} "ssse3" {:macro "__SSSE3__" :implies ["sse3"]}
                    "sse4.1" {:macro "__SSE4_1__" :implies ["ssse3"]}
                    "sse4.2" {:macro "__SSE4_2__" :implies ["sse4.1" "popcnt" "crc32"]}
                    "sse4" {:implies ["sse4.2"]}
                    "popcnt" {:macro "__POPCNT__"} "crc32" {:macro "__CRC32__"}
                    "xsave" {:macro "__XSAVE__"}
                    "avx" {:macro "__AVX__" :implies ["sse4.2" "xsave"] :biggest-alignment 32}
                    "avx2" {:macro "__AVX2__" :implies ["avx"]}
                    "avx512f" {:macro "__AVX512F__" :implies ["avx2"] :biggest-alignment 64}
                    "sse2" {} "sse" {} "mmx" {}
                    "sahf" {:macro "__LAHF_SAHF__"} "cx16" {:macro "__GCC_HAVE_SYNC_COMPARE_AND_SWAP_16"}}
       :baseline-arch ["__k8" "__k8__"]
       :cpus {"core2" {:extensions ["ssse3" "sahf" "cx16"] :macros ["__core2" "__core2__" "__tune_core2__"]}}}

 ;; the __has_ answers (g++ 15.2's, asked at :has-std; [cpp.cond]'s Table 21 for the standard attributes):
 ;;   __has_cpp_attribute  an unscoped standard attribute g++ implements (X or __X__): its value; gnu::X of :gnu-attributes: 1;
 ;;                        clang::X of :clang-attributes: 1; anything else 0
 ;;   __has_attribute      the GNU operator: an unscoped standard attribute g++ implements: its value, else X or __X__ among
 ;;                        :gnu-attributes 1; gnu::X likewise; anything else 0
 ;;   __has_builtin        a name of :builtins: 1, of :builtin-values: its value
 ;;   __has_feature        :features-on: 1 (none: g++ answers the sanitizers' only when they are on)
 :has-std "c++23"
 ;; Table 21 at C++23; carries_dependency is in the table but g++ 15 answers 0 (it ignores the attribute, P3475), indeterminate is
 ;; C++26's (not in g++ 15)
 :std-attributes {"assume" 202207 "deprecated" 201309 "fallthrough" 201603 "likely" 201803 "maybe_unused" 201603
                  "no_unique_address" 201803 "nodiscard" 201907 "noreturn" 200809 "unlikely" 201803}
 :gnu-attributes ["access" "aligned" "alloc_size" "always_inline" "cold" "const" "constructor" "deprecated" "destructor" "format"
                  "hot" "init_priority" "malloc" "noinline" "nonnull" "noreturn" "packed" "pure" "unused" "used" "visibility"
                  "warn_unused_result" "weak"]
 :clang-attributes ["musttail"]
 :builtins ["__add_lvalue_reference" "__add_pointer" "__add_rvalue_reference" "__array_rank" "__builtin_bit_cast"
            "__builtin_bswap128" "__builtin_clear_padding" "__builtin_clzg" "__builtin_ctzg" "__builtin_dynamic_object_size"
            "__builtin_is_constant_evaluated" "__builtin_is_corresponding_member"
            "__builtin_is_pointer_interconvertible_with_class" "__builtin_is_virtual_base_of" "__builtin_launder"
            "__builtin_nansf128" "__builtin_nansq" "__builtin_popcountg" "__builtin_source_location" "__builtin_toupper"
            "__builtin_va_arg_pack" "__decay" "__has_unique_object_representations" "__is_aggregate" "__is_array"
            "__is_bounded_array" "__is_const" "__is_convertible" "__is_function" "__is_invocable" "__is_layout_compatible"
            "__is_member_function_pointer" "__is_member_object_pointer" "__is_member_pointer" "__is_nothrow_convertible"
            "__is_nothrow_invocable" "__is_object" "__is_pointer" "__is_pointer_interconvertible_base_of" "__is_reference"
            "__is_same" "__is_scoped_enum" "__is_trivially_assignable" "__is_trivially_constructible" "__is_unbounded_array"
            "__is_volatile" "__reference_constructs_from_temporary" "__reference_converts_from_temporary"
            "__remove_all_extents" "__remove_cv" "__remove_cvref" "__remove_extent" "__remove_pointer" "__remove_reference"
            "__type_pack_element"]
 ;; P0784's (C++20) constexpr allocation: __builtin_operator_new answers its paper's date
 :builtin-values {"__builtin_operator_new" 201802}
 :features-on []

 ;; the system search list in g++'s order (the compiler's own directory last for C++, unlike C's), the directories the target's
 ;; trees are laid out in (cpp/target/libstdcxx.edn's :target and :compiler-include, Alpine's prefix /usr with gcc's relative
 ;; spelling of the libstdc++ directories from the compiler's library directory, fortify-headers' /usr/include/fortify)
 :search ["/usr/lib/gcc/x86_64-alpine-linux-musl/15.2.0/../../../../include/c++/15.2.0"
          "/usr/lib/gcc/x86_64-alpine-linux-musl/15.2.0/../../../../include/c++/15.2.0/x86_64-alpine-linux-musl"
          "/usr/lib/gcc/x86_64-alpine-linux-musl/15.2.0/../../../../include/c++/15.2.0/backward"
          "/usr/include/fortify"
          "/usr/include"
          "/usr/lib/gcc/x86_64-alpine-linux-musl/15.2.0/include"]
 :stds ["c++98" "c++03" "c++11" "c++14" "c++17" "c++20" "c++23" "c++26"
        "gnu++98" "gnu++03" "gnu++11" "gnu++14" "gnu++17" "gnu++20" "gnu++23" "gnu++26"]}

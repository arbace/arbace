;; The clang half of Arbace's C++ target (doc/cpp/CPP-SURVEY.md, "As built: CP248 (a)"): the facts of clang 23.1.5 on
;; x86_64-linux-musl that its predefined macros, its system search list and its __has_ answers are computed from, the
;; macros by test/cpp/clang.ae (cpp.clang, a port of clang's InitPreprocessor.cpp, X86.cpp and OSTargets.h) over C's ABI
;; description c/target/abi.edn (the types' sizes and signedness, the floating formats). The native parser (CX11,
;; doc/cpp/NATIVE.md) reads with clang's macros, as the oracle's AST was made with them; `bin/repr-cpp target gen` writes them
;; into cpp/target/host/ (predefined/clang/STD.h, search-clang.txt, has.tsv's fourth column) and `target host-oracle` compares
;; them with clang's recorded answers (test/cpp/host/, by hand). Sources: llvm-project-23.1.5.src.tar.xz (the pin of
;; test/cpp/corpora.edn, sha256 fb50b1eac93ddeb3aa8dab4cfe324dff74f4a9c2bdee6160c9e36188f8d06a6e): clang/lib/Frontend/
;; InitPreprocessor.cpp, clang/lib/Basic/Targets/X86.cpp, Targets/OSTargets.h, TargetInfo.cpp, Targets.cpp; Alpine's clang23
;; package for the vendor string and the driver's defaults (PIE, -fstack-protector-strong). Read with the Clojure reader.
{;; the identification: CLANG_VERSION_*, getClangFullCPPVersion() (Alpine's CLANG_VENDOR "Alpine "), no repository version
 :version [23 1 5]
 :vendor "Alpine"
 ;; LangOpts.GNUCVersion's default (4.2.1) and the ABI version clang names for it
 :gnuc [4 2 1]
 :gxx-abi 1002
 ;; getCPlusPlusLangStd() by the standard's year
 :cplusplus {1998 "199711L" 2011 "201103L" 2014 "201402L" 2017 "201703L" 2020 "202002L" 2023 "202302L" 2026 "202400L"}
 ;; the target's TargetInfo (X86_64TargetInfo over LinuxTargetInfo): the types, as TargetInfo::IntType keys of abi.edn's
 ;; :int-types; WIntType unsigned int (LinuxTargetInfo), the least-width types by width
 :types {:wchar :int :wint :uint :intmax :long :uintmax :ulong :size :ulong :ptrdiff :long :intptr :long :uintptr :ulong
         :sig-atomic :int :char16 :ushort :char32 :uint :int64 :long :uint64 :ulong :int16 :short :uint16 :ushort}
 :least {8 [:schar :uchar] 16 [:short :ushort] 32 [:int :uint] 64 [:long :ulong]}
 ;; TargetInfo::getTypeName's spellings (unlike g++'s "short int", "short unsigned int")
 :type-names {:schar "signed char" :uchar "unsigned char" :short "short" :ushort "unsigned short" :int "int"
              :uint "unsigned int" :long "long int" :ulong "long unsigned int" :llong "long long int"
              :ullong "long long unsigned int"}
 ;; getTypeFormatModifier
 :fmt {:schar "hh" :uchar "hh" :short "h" :ushort "h" :int "" :uint "" :long "l" :ulong "l" :llong "ll" :ullong "ll"}
 ;; the alignment new gets (getNewAlign), the suitable alignment (__BIGGEST_ALIGNMENT__), getMaxBitIntWidth (LLVM's
 ;; IntegerType::MAX_INT_BITS), hardwareInterferenceSizes, the SSE level's half type (HasFloat16: SSE2), __float128
 ;; (HasFloat128 on Linux x86_64)
 :new-align 16
 :suitable-align 16
 :bitint-maxwidth 8388608
 :interference [64 64]
 :float16 true
 :float128 true
 ;; DefineFloatMacros' PickFP tables, the formats the target uses: IEEEhalf for FLT16, IEEEsingle, IEEEdouble,
 ;; x87DoubleExtended for long double; the strings as InitPreprocessor.cpp writes them, the integers its tables give
 :float-formats
 {:half {:denorm-min "5.9604644775390625e-8" :norm-max "6.5504e+4" :epsilon "9.765625e-4" :min "6.103515625e-5"
         :max "6.5504e+4" :dig 3 :decimal-dig 5 :mant-dig 11 :min-10-exp -4 :max-10-exp 4 :min-exp -13 :max-exp 16}
  :single {:denorm-min "1.40129846e-45" :norm-max "3.40282347e+38" :epsilon "1.19209290e-7" :min "1.17549435e-38"
           :max "3.40282347e+38" :dig 6 :decimal-dig 9 :mant-dig 24 :min-10-exp -37 :max-10-exp 38 :min-exp -125 :max-exp 128}
  :double {:denorm-min "4.9406564584124654e-324" :norm-max "1.7976931348623157e+308" :epsilon "2.2204460492503131e-16"
           :min "2.2250738585072014e-308" :max "1.7976931348623157e+308" :dig 15 :decimal-dig 17 :mant-dig 53
           :min-10-exp -307 :max-10-exp 308 :min-exp -1021 :max-exp 1024}
  :x87 {:denorm-min "3.64519953188247460253e-4951" :norm-max "1.18973149535723176502e+4932"
        :epsilon "1.08420217248550443401e-19" :min "3.36210314311209350626e-4932" :max "1.18973149535723176502e+4932"
        :dig 18 :decimal-dig 21 :mant-dig 64 :min-10-exp -4931 :max-10-exp 4932 :min-exp -16381 :max-exp 16384}}
 :floats [["FLT16" :half "F16"] ["FLT" :single "F"] ["DBL" :double ""] ["LDBL" :x87 "L"]]
 ;; the driver's and the toolchain's defaults on Alpine: -fPIE (PICLevel 2, PIE), -fstack-protector-strong (SSPStrong: 2 in
 ;; clang's numbering, 3 in gcc's), math-errno off (musl), DWARF CFI directives, the POSIX thread model, the default CPU
 ;; x86-64 (CK_x86_64: defineCPUMacros "k8" with its tuning macro), the baseline features (MMX, SSE2, FXSR, CX8)
 :pic [2 true]
 :ssp ["__SSP_STRONG__" "2"]
 :math-errno false
 :cpu "k8"
 :sse-level 2
 :features ["__FXSR__" "__MMX__"]
 :sync-cas [1 2 4 8]
 :literal-encoding "UTF-8"
 ;; the language options' defaults that decide feature macros: SizedDeallocation from C++14, AlignedAllocation from C++17,
 ;; Char8 from C++20 (each as clang's CompilerInvocation sets it from the standard)
 :sized-deallocation 2014
 :aligned-allocation 2017
 :char8 2020

 ;; the __has_ answers (clang 23's, at :has-std as the record asks): __has_cpp_attribute: an unscoped standard attribute its
 ;; value (Attr.td's CXX11 spellings, the standard's dates; __X__ normalized to X), gnu::X 1 for a GNU attribute clang has
 ;; with a GCC spelling, clang::X 1 for clang's own; __has_attribute (the GNU spelling): 1 for :gnu-attributes (noreturn and
 ;; assume included, the standard-only nodiscard not), 0 else; __has_builtin: :builtins 1, :builtin-values their value;
 ;; __has_feature: :features-on
 :std-attributes {"assume" 202207 "carries_dependency" 200809 "deprecated" 201309 "fallthrough" 201603 "likely" 201803
                  "maybe_unused" 201603 "no_unique_address" 201803 "nodiscard" 201907 "noreturn" 200809 "unlikely" 201803}
 :gnu-attributes ["aligned" "alloc_size" "always_inline" "assume" "cold" "const" "constructor" "deprecated" "destructor" "format"
                  "hot" "init_priority" "malloc" "noinline" "nonnull" "noreturn" "packed" "pure" "unused" "used" "visibility"
                  "warn_unused_result" "weak"]
 :clang-attributes ["annotate" "fallthrough" "lifetimebound" "musttail" "no_destroy"]
 :builtins ["__add_lvalue_reference" "__add_pointer" "__add_rvalue_reference" "__array_rank" "__builtin_bit_cast"
            "__builtin_clear_padding" "__builtin_clzg" "__builtin_ctzg" "__builtin_dynamic_object_size"
            "__builtin_is_constant_evaluated" "__builtin_is_virtual_base_of" "__builtin_launder" "__builtin_nansf128"
            "__builtin_popcountg" "__builtin_source_location" "__decay" "__has_unique_object_representations" "__is_aggregate"
            "__is_array" "__is_bounded_array" "__is_const" "__is_convertible" "__is_function" "__is_layout_compatible"
            "__is_member_function_pointer" "__is_member_object_pointer" "__is_member_pointer" "__is_nothrow_convertible"
            "__is_object" "__is_pointer" "__is_pointer_interconvertible_base_of" "__is_reference" "__is_same"
            "__is_scoped_enum" "__is_trivially_assignable" "__is_trivially_constructible" "__is_unbounded_array"
            "__is_volatile" "__make_integer_seq" "__reference_constructs_from_temporary" "__reference_converts_from_temporary"
            "__remove_all_extents" "__remove_cv" "__remove_cvref" "__remove_extent" "__remove_pointer" "__type_pack_element"]
 :builtin-values {"__builtin_operator_new" 201802}
 :features-on []

 ;; the system search list in clang's order (the Linux toolchain's: libstdc++'s three directories as gcc's installation
 ;; detection spells them, fortify-headers, the prefix's include, clang's resource directory last), the directories of the
 ;; tree bin/repr-cpp target makes (cpp/target/libstdcxx.edn)
 :search ["/usr/lib/gcc/x86_64-alpine-linux-musl/15.2.0/../../../../include/c++/15.2.0"
          "/usr/lib/gcc/x86_64-alpine-linux-musl/15.2.0/../../../../include/c++/15.2.0/x86_64-alpine-linux-musl"
          "/usr/lib/gcc/x86_64-alpine-linux-musl/15.2.0/../../../../include/c++/15.2.0/backward"
          "/usr/include/fortify"
          "/usr/include"
          "/usr/lib/llvm23/lib/clang/23/include"]}

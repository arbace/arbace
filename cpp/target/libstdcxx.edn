;; libstdc++'s installed headers as the target x86_64-linux-musl has them (doc/cpp/CPP-SURVEY.md, "As built: cpp-indep", CP241 (b)):
;; what test/cpp/target.ae (cpp.target) makes the tree /usr/include/c++/15.2.0 from, the pinned gcc-15.2.0 tarball and the target's
;; C library (musl 1.2.6's headers as C's own target lays them out, c/README.md), with no compiler. Read with the Clojure reader.
;;   :target        the target's directory of configured headers (the triple g++ was configured for)
;;   :thread-model  the gthreads model bits/gthr-default.h is (libgcc/gthr-MODEL.h)
;;   :layout        where each of the tarball's own files is installed: {:to DIR :from DIR} the files directly in DIR (but :except),
;;                  :only the files named, :recursive every file under DIR, :files [[INSTALLED SOURCE] ...] one by one
;;   :version       bits/c++config's release and date macros (gcc/BASE-VER's major, gcc/DATESTAMP)
;;   :switches      bits/c++config's prewritten switches the build sets, with their values
;;   :extra-headers headers the target has beyond the C library's (the kernel's UAPI headers, linux-headers' package)
;;   :facts         configure's answers that are facts of the target or choices of the build, where no probe of the C library's
;;                  headers is configure's check: {:names [...] :value V :why "..."}, V a string (#define NAME V), nil (#undef) or
;;                  :drop (the line left out); every other answer is a probe (cpp.target/probe): a function declared, a header
;;                  present, a name available in a header
{:target "x86_64-alpine-linux-musl"
 :thread-model "posix"
 :layout
 [{:to "" :from "libstdc++-v3/include/std" :except [".editorconfig"]}
  {:to "" :from "libstdc++-v3/include/c_global"}
  {:to "" :from "libstdc++-v3/include/c_compatibility"
   :only ["complex.h" "fenv.h" "math.h" "stdatomic.h" "stdbit.h" "stdckdint.h" "stdlib.h" "tgmath.h"]}
  {:to "" :from "libstdc++-v3/libsupc++" :only ["compare" "cxxabi.h" "exception" "initializer_list" "new" "typeinfo"]}
  {:to "bits" :from "libstdc++-v3/include/bits" :except ["c++config" "version.def" "version.tpl"]}
  {:to "bits" :from "libstdc++-v3/libsupc++"
   :only ["atomic_lockfree_defines.h" "cxxabi_forced.h" "cxxabi_init_exception.h" "exception.h" "exception_defines.h"
          "exception_ptr.h" "hash_bytes.h" "nested_exception.h"]}
  {:to "backward" :from "libstdc++-v3/include/backward"}
  {:to "ext" :from "libstdc++-v3/include/backward" :only ["hash_map" "hash_set"]}
  {:to "ext" :from "libstdc++-v3/include/ext" :recursive true}
  {:to "debug" :from "libstdc++-v3/include/debug" :except ["array"]}
  {:to "decimal" :from "libstdc++-v3/include/decimal"}
  {:to "experimental" :from "libstdc++-v3/include/experimental" :recursive true}
  {:to "parallel" :from "libstdc++-v3/include/parallel"}
  {:to "pstl" :from "libstdc++-v3/include/pstl" :except ["LICENSE.txt"]}
  {:to "tr1" :from "libstdc++-v3/include/tr1"}
  {:to "tr2" :from "libstdc++-v3/include/tr2"}
  {:files [["{target}/bits/atomic_word.h" "libstdc++-v3/config/cpu/generic/atomic_word.h"]
           ["{target}/bits/cpu_defines.h" "libstdc++-v3/config/cpu/generic/cpu_defines.h"]
           ["{target}/bits/cxxabi_tweaks.h" "libstdc++-v3/config/cpu/generic/cxxabi_tweaks.h"]
           ["{target}/bits/opt_random.h" "libstdc++-v3/config/cpu/i486/opt/bits/opt_random.h"]
           ["{target}/ext/opt_random.h" "libstdc++-v3/config/cpu/i486/opt/ext/opt_random.h"]
           ["{target}/bits/basic_file.h" "libstdc++-v3/config/io/basic_file_stdio.h"]
           ["{target}/bits/c++io.h" "libstdc++-v3/config/io/c_io_stdio.h"]
           ["{target}/bits/c++allocator.h" "libstdc++-v3/config/allocator/new_allocator_base.h"]
           ["{target}/bits/c++locale.h" "libstdc++-v3/config/locale/generic/c_locale.h"]
           ["{target}/bits/messages_members.h" "libstdc++-v3/config/locale/generic/messages_members.h"]
           ["{target}/bits/time_members.h" "libstdc++-v3/config/locale/generic/time_members.h"]
           ["{target}/bits/ctype_base.h" "libstdc++-v3/config/os/generic/ctype_base.h"]
           ["{target}/bits/ctype_inline.h" "libstdc++-v3/config/os/generic/ctype_inline.h"]
           ["{target}/bits/error_constants.h" "libstdc++-v3/config/os/generic/error_constants.h"]
           ["{target}/bits/os_defines.h" "libstdc++-v3/config/os/generic/os_defines.h"]
           ["{target}/bits/extc++.h" "libstdc++-v3/include/precompiled/extc++.h"]
           ["{target}/bits/stdc++.h" "libstdc++-v3/include/precompiled/stdc++.h"]
           ["{target}/bits/stdtr1c++.h" "libstdc++-v3/include/precompiled/stdtr1c++.h"]]}]
 :version [["_GLIBCXX_RELEASE" "15"] ["__GLIBCXX__" "20250808"]]
 :switches [["_GLIBCXX_HAVE_ATTRIBUTE_VISIBILITY" 1] ["_GLIBCXX_EXTERN_TEMPLATE" 1] ["_GLIBCXX_USE_DUAL_ABI" 1]
            ["_GLIBCXX_USE_CXX11_ABI" 1] ["_GLIBCXX_INLINE_VERSION" 0] ["_GLIBCXX_VERBOSE_ASSERT" 1]
            ["_GLIBCXX_USE_ALLOCATOR_NEW" 1] ["_GLIBCXX_USE_FLOAT128" 1]]
 :extra-headers ["linux/random.h" "linux/types.h"]
 :facts
 [;; the C library is musl, a complete C99/C11 library (musl's README; its headers in the sysroot declare every function these name)
  {:value "1" :why "musl provides the whole C99 and C11 library (math, complex, fenv, inttypes, stdint, stdio, stdlib, wchar, ctype, uchar)"
   :names ["_GLIBCXX_USE_C99" "_GLIBCXX98_USE_C99_COMPLEX" "_GLIBCXX98_USE_C99_MATH" "_GLIBCXX98_USE_C99_STDIO" "_GLIBCXX98_USE_C99_STDLIB"
           "_GLIBCXX98_USE_C99_WCHAR" "_GLIBCXX11_USE_C99_COMPLEX" "_GLIBCXX11_USE_C99_MATH" "_GLIBCXX11_USE_C99_STDIO"
           "_GLIBCXX11_USE_C99_STDLIB" "_GLIBCXX11_USE_C99_WCHAR" "_GLIBCXX_USE_C99_COMPLEX_ARC" "_GLIBCXX_USE_C99_COMPLEX_TR1"
           "_GLIBCXX_USE_C99_CTYPE" "_GLIBCXX_USE_C99_CTYPE_TR1" "_GLIBCXX_USE_C99_FENV" "_GLIBCXX_USE_C99_FENV_TR1"
           "_GLIBCXX_USE_C99_INTTYPES" "_GLIBCXX_USE_C99_INTTYPES_TR1" "_GLIBCXX_USE_C99_INTTYPES_WCHAR_T"
           "_GLIBCXX_USE_C99_INTTYPES_WCHAR_T_TR1" "_GLIBCXX_USE_C99_MATH_FUNCS" "_GLIBCXX_USE_C99_MATH_TR1" "_GLIBCXX_USE_C99_STDINT"
           "_GLIBCXX_USE_C99_STDINT_TR1" "_GLIBCXX_USE_C11_UCHAR_CXX11" "HAVE_C99_FLT_EVAL_TYPES" "STDC_HEADERS" "HAVE_MBSTATE_T"
           "_GLIBCXX_USE_WCHAR_T" "_GLIBCXX_USE_LONG_LONG" "HAVE_DECL_STRNLEN" "HAVE_GETS" "_GLIBCXX_USE_TMPNAM" "_GLIBCXX_USE_FSEEKO_FTELLO"]}
  {:value nil :why "musl's math.h is C's: it declares none of C++11's floating and integral overloads"
   :names ["__CORRECT_ISO_CPP11_MATH_H_PROTO_FP" "__CORRECT_ISO_CPP11_MATH_H_PROTO_INT"]}
  {:value nil :why "musl's math.h has none of the obsolete or missing forms these name"
   :names ["HAVE_OBSOLETE_ISINF" "HAVE_OBSOLETE_ISNAN" "_GLIBCXX_NO_C99_ROUNDING_FUNCS"]}
  ;; POSIX and Linux facts of the target (musl's headers and the kernel)
  {:value "1" :why "a POSIX.1-2008 system on Linux: clocks, sleeping, scheduling, rwlocks, semaphores, the futex syscall, /dev/random, iconv, d_type, st_mtim, tm_zone, O_NONBLOCK, utimensat, nl_langinfo_l, rlimits"
   :names ["_GLIBCXX_USE_CLOCK_MONOTONIC" "_GLIBCXX_USE_CLOCK_REALTIME" "_GLIBCXX_USE_GETTIMEOFDAY" "_GLIBCXX_USE_NANOSLEEP"
           "_GLIBCXX_USE_SCHED_YIELD" "_GLIBCXX_USE_PTHREAD_RWLOCK_T" "HAVE_POSIX_SEMAPHORE" "HAVE_LINUX_FUTEX" "_GLIBCXX_USE_DEV_RANDOM"
           "_GLIBCXX_USE_RANDOM_TR1" "HAVE_ICONV" "HAVE_STRUCT_DIRENT_D_TYPE" "_GLIBCXX_USE_ST_MTIM" "_GLIBCXX_USE_STRUCT_TM_TM_ZONE"
           "HAVE_O_NONBLOCK" "_GLIBCXX_USE_UTIMENSAT" "_GLIBCXX_USE_NL_LANGINFO_L" "_GTHREAD_USE_MUTEX_TIMEDLOCK"
           "HAVE_LIMIT_AS" "HAVE_LIMIT_DATA" "HAVE_LIMIT_FSIZE" "HAVE_LIMIT_RSS" "_GLIBCXX_RES_LIMITS" "HAVE_UNLINKAT"]}
  {:value "0" :why "Linux has no RLIMIT_VMEM" :names ["HAVE_LIMIT_VMEM"]}
  {:value "" :why "musl's iconv takes char ** (no const)" :names ["ICONV_CONST"]}
  {:value nil :why "checked only when the preferred form is missing: nanosleep, S_ISREG and clock_gettime exist"
   :names ["HAVE_SLEEP" "HAVE_USLEEP" "_GLIBCXX_NO_SLEEP" "HAVE_S_IFREG" "_GLIBCXX_USE_CLOCK_GETTIME_SYSCALL"]}
  {:value nil :why "musl declares these only under _GNU_SOURCE or _BSD_SOURCE, which configure's tests do not define; not glibc, not a BSD, not Windows"
   :names ["HAVE_STRERROR_L" "HAVE_STRXFRM_L" "_GLIBCXX_USE_COPY_FILE_RANGE" "_GLIBCXX_USE_PTHREAD_RWLOCK_CLOCKLOCK" "_GLIBCXX_USE_SYSCTL_HW_NCPU"
           "_GLIBCXX_USE__GET_OSFHANDLE" "_GLIBCXX_USE_UCHAR_C8RTOMB_MBRTOC8_CXX20" "_GLIBCXX_USE_UCHAR_C8RTOMB_MBRTOC8_FCHAR8_T"
           "HAVE_SYS_SDT_H" "_GLIBCXX_USE_LFS" "_FILE_OFFSET_BITS" "_LARGE_FILES"]}
  ;; the ABI and the compiler's capabilities the library is built for (x86-64 System V, LP64; c/target/abi.edn)
  {:value "m" :why "size_t is unsigned long (LP64), mangled m" :names ["_GLIBCXX_MANGLE_SIZE_T"]}
  {:value nil :why "LP64: ptrdiff_t is long, size_t unsigned long" :names ["_GLIBCXX_PTRDIFF_T_IS_INT" "_GLIBCXX_SIZE_T_IS_UINT"]}
  {:value "1" :why "x86-64: thread-local storage, atomics, the unwinder's _Unwind_GetIPInfo, the assembler's .symver, rdrand and rdseed, init_priority, std::hardware_destructive_interference_size alignment, decimal floating point (libgcc's BID)"
   :names ["HAVE_TLS" "_GLIBCXX_ATOMIC_BUILTINS" "HAVE_ATOMIC_LOCK_POLICY" "HAVE_GETIPINFO" "HAVE_AS_SYMVER_DIRECTIVE" "_GLIBCXX_X86_RDRAND"
           "_GLIBCXX_X86_RDSEED" "_GLIBCXX_USE_INIT_PRIORITY_ATTRIBUTE" "_GLIBCXX_CAN_ALIGNAS_DESTRUCTIVE_SIZE" "_GLIBCXX_USE_DECIMAL_FLOAT"]}
  {:value nil :why "TLS is native, not emulated; no GCC 4.6 exception_ptr compatibility on x86-64; no long double compatibility formats"
   :names ["HAVE_CC_TLS" "HAVE_EXCEPTION_PTR_SINCE_GCC46"]}
  {:value :drop :why "the long double compatibility switches are bits/c++config's own; config.h's lines are removed"
   :names ["_GLIBCXX_LONG_DOUBLE_ALT128_COMPAT" "_GLIBCXX_LONG_DOUBLE_COMPAT"]}
  ;; the build's configuration (Alpine's gcc 15.2.0 package: threads posix, no NLS, no symbol versioning, static tzdata)
  {:value "1" :why "the build: gthreads (posix), <stacktrace>, the verbose terminate handler, static tzdata"
   :names ["_GLIBCXX_HAS_GTHREADS" "HAVE_STACKTRACE" "_GLIBCXX_VERBOSE" "_GLIBCXX_STATIC_TZDATA"]}
  {:value "0" :why "the build: no fully dynamic string" :names ["_GLIBCXX_FULLY_DYNAMIC_STRING"]}
  {:value "__STDC_HOSTED__" :why "the build: hosted, as the compiler says" :names ["_GLIBCXX_HOSTED"]}
  {:value "\"/usr/share/zoneinfo\"" :why "the build: the target's tzdata directory" :names ["_GLIBCXX_ZONEINFO_DIR"]}
  {:value nil :why "the build: no NLS (so <libintl.h> is not checked), no symbol versioning, no concept checks, not stdio-pure"
   :names ["_GLIBCXX_USE_NLS" "HAVE_LIBINTL_H" "HAVE_SYMVER_SYMBOL_RENAMING_RUNTIME_SUPPORT" "_GLIBCXX_SYMVER" "_GLIBCXX_SYMVER_DARWIN"
           "_GLIBCXX_SYMVER_GNU" "_GLIBCXX_SYMVER_GNU_NAMESPACE" "_GLIBCXX_SYMVER_SUN" "_GLIBCXX_CONCEPT_CHECKS" "_GLIBCXX_USE_STDIO_PURE"]}
  ;; autoconf's own (the package's names as libstdc++'s configure.ac gives them to AC_INIT, libtool's directory)
  {:value "\"package-unused\"" :why "autoconf: AC_INIT's package" :names ["PACKAGE_NAME"]}
  {:value "\"version-unused\"" :why "autoconf: AC_INIT's version" :names ["PACKAGE_VERSION"]}
  {:value "\"package-unused version-unused\"" :why "autoconf: name and version" :names ["PACKAGE_STRING"]}
  {:value "\"libstdc++\"" :why "autoconf: the tarname" :names ["PACKAGE_TARNAME"]}
  {:value "\"\"" :why "autoconf: none given" :names ["PACKAGE_BUGREPORT" "PACKAGE_URL"]}
  {:value nil :why "automake's PACKAGE and VERSION are not defined in config.h" :names ["PACKAGE" "VERSION"]}
  {:value "\".libs/\"" :why "libtool's object directory" :names ["LT_OBJDIR"]}]}

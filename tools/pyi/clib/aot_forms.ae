;; bin/pyi-clib aot-forms's step on stage 0 (queue 521, DECISION 521-2 (b)): a C library's node program translated by cf2g
;; into the Go forms of its compiled package arbace/clib/LIB/aot, committed under go/ (go/arbace/clib/LIB/aot.ae and
;; aot/prog.ae) as repr/go's generated packages are (go/arbace/repr/go/godump), so goi's table can link it into the
;; executable (through arbace/clib/worlds) and pyi's AOT prints it instead of translating it again.
;;   NODES OUTDIR LIB SHA     NODES the node program's text (aot_text.ae nodes), OUTDIR go/arbace/clib/LIB, SHA the SHA-256
;;                            of go/arbace/clib/LIB/nodes.ae (the forms' key, on their first line)
;; cf2g's Main (ci.AotMain running the program) becomes setup, registered by init with arbace/clib (aot_text.ae setup's
;; rewrite, on the forms).
(require '[arbace.string :as str] 'arbace.c.cf2g 'arbace.go.table)

(defn- clean
  "x without the reader's position metadata (cf2g's quoted forms carry its source's :line and :column), recursively."
  [x]
  (let [y (cond
            (seq? x) (with-meta (apply list (map clean x)) (meta x))
            (vector? x) (with-meta (mapv clean x) (meta x))
            (map? x) (with-meta (into {} (map (fn [[k v]] [(clean k) (clean v)])) x) (meta x))
            :else x)]
    (if (and (instance? arbace.lang.IObj y) (meta y))
      (with-meta y (not-empty (into {} (for [[k v] (meta y) :when (not (#{:line :column :file :end-line :end-column} k))]
                                         [k (clean v)]))))
      y)))

(defn- text [f] (arbace.go.table/form-text (clean f)))

(defn- write-forms [^java.io.Writer w forms]
  (doseq [f forms] (.write w ^String (text f)) (.write w "\n\n")))

(let [[nodes outdir lib sha] *command-line-args*
      path (str "arbace/clib/" lib "/aot")
      [forms _] (arbace.c.cf2g/translate (arbace.c.cf2g/read-nodes (slurp nodes)) "aot" path)
      [ns-f pkg-f in-ns-f file-f & decls] forms
      run (last decls)
      decls (butlast decls)
      _ (when-not (and (seq? run) (= 'go/func (first run)) (= 'Main (second run)))
          (binding [*out* *err*] (println "pyi-clib: cf2g's Main not found for" lib)) (System/exit 1))
      ;; (go/func Main [args] (ci/AotMain args (fn [p l] BODY...)))
      [_ _ _ [_ _ [_ params & body]]] run
      setup (apply list 'go/func 'setup
                   "setup loads the library's data and sets its compiled functions (cf2g's Main's, without running it).\n"
                   params body)
      init (list 'go/func 'init [] (list 'clib/RegisterCompiled lib 'setup))
      file-f (let [v (vec file-f) i (.indexOf ^java.util.List v :imports)]
               (apply list (assoc v (inc i) (vec (cons '[clib "arbace/clib"] (nth v (inc i)))))))
      note (str ";; Code generated by bin/pyi-clib aot-forms " lib " (arbace.c.cf2g from go/arbace/clib/" lib "/nodes.ae, SHA-256 "
                sha ");\n;; DO NOT EDIT. The compiled C world of arbace/clib (queue 521, DECISION 521-2 (b)).\n")
      d (java.io.File. ^String outdir)]
  (.mkdirs (java.io.File. d "aot"))
  (spit (java.io.File. d "aot.ae")
        (str note (text ns-f) "\n\n" (text pkg-f) "\n\n(load \"aot/prog\")\n"))
  (with-open [w (java.io.BufferedWriter. (java.io.FileWriter. (java.io.File. d "aot/prog.ae")) 1048576)]
    (.write w note)
    (.write w (str (text in-ns-f) "\n\n"))
    (write-forms w (concat [file-f] decls [setup init])))
  (println "aot-forms:" lib (count decls) "declarations"))

#!/bin/sh
# tools/pyi/python3: pyi as sys.executable (PY6e): CPython's command line, run by bin/pyi python. Found through its
# own path when started by a symbolic link (posix_spawnp's test links it). pyi's C library semantics are musl's, as
# python3's on Alpine (ld-musl-ARCH.so.1): platform.libc_ver(sys.executable) reads this line, so
# test.support.linked_to_musl() answers as there.
# py-os-1124: the environment the caller gave (this shell's PWD and SHLVL undone by the runtime) kept in PYI_ENTRY_ENV,
# NAME=VALUE records separated by \036 (a newline in a value as \035): os.environ is it, not what bin/pyi adds
# py-limits-1125: a child runs with GOGC 25 (PYI_CHILD_GOGC; GOGC set here, as the parent's own GOGC 100 is in the
# environment it inherits): importing test._test_multiprocessing peaks at 1.45 GB resident where GOGC 100 gives 2.0 GB, its
# wall the same (33-40 s against 34 s: the collector on the other cores), the CPU about 30% more; an idle child 397 MB of
# heap where 100 gives 611 MB (the binary's 390 MB of pages beside it, shared between the processes)
PYI_ENTRY_ENV=$(env -u PYI_ENTRY_ENV -0 | tr '\0\n' '\036\035') GOGC=${PYI_CHILD_GOGC:-25} exec "$(dirname "$(readlink -f "$0")")/../../bin/pyi" python "$@"

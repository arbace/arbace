#!/bin/sh
# tools/pyi/python3: pyi as sys.executable (PY6e): CPython's command line, run by bin/pyi python. Found through its
# own path when started by a symbolic link (posix_spawnp's test links it). pyi's C library semantics are musl's, as
# python3's on Alpine (ld-musl-ARCH.so.1): platform.libc_ver(sys.executable) reads this line, so
# test.support.linked_to_musl() answers as there.
exec "$(dirname "$(readlink -f "$0")")/../../bin/pyi" python "$@"

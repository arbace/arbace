;; tools/pyi/runtime_tables.ae (queue 265; doc/python/PYTHON-SURVEY.md, "As built: 265"): go/arbace/py's runtime tables that
;; tools/pyi/*_table.py recorded from CPython's own modules (python3 at record time), made by Arbace from pinned sources, by the
;; rules CPython's modules apply when they initialize: each module's constants as its C source adds them, preprocessed by
;; arbace.repr.c.pp (repr/c's port of cc's preprocessor) against the pinned headers, the values evaluated here.
;;
;; Run on stage 0 (ARBACE_PATH at the checkout; bin/pyi runtime gen-tables): EXE tools/pyi/runtime_tables.ae OPTION... OUT TABLE...
;;   --cpython DIR   the pinned CPython 3.14.10 tarball's tree (test/python/corpora.edn's :cpython-3.14.10)
;;   --musl DIR      musl 1.2.6's tarball's tree (test/c/corpora.edn's :musl-1.2.6, the C crop's pin): its headers as musl's
;;                   install composes them (obj/include/bits/alltypes.h by tools/mkalltypes.sed's three rules, bits/syscall.h by
;;                   the Makefile's sed, arch/ARCH/bits over arch/generic/bits, include/), for x86_64 and aarch64;
;;                   src/errno/__strerror.h, src/conf/sysconf.c and fpathconf.c
;;   --goroot DIR    TamaGo's GOROOT (seed/goroot.sha256): src/syscall/zerrors_linux_{amd64,arm64}.go
;;   --root-amd64 DIR, --root-arm64 DIR
;;                   tools/pyi/header-apks.sha256's apks extracted (usr/include): Linux's UAPI headers (linux-headers 7.2.1)
;;                   and BlueZ's (bluez-headers 5.87); since queue 357 pyconfig.h's answers are own-pyconfig's, configure.ac's
;;                   rules on Linux over these headers, musl's and musl's sources (--pyconfig alpine, by hand: Alpine's)
;;   --cpython315 DIR  3.15.2's tree (the 315 tables, queue 357)
;;   --work DIR      the preprocessor's translation units, kept for reading (default OUT/work)
;; OUT the directory the tables' Go is written into, not gofmt'd (bin/pyi runtime gen-tables formats it with TamaGo's gofmt
;; and compares it with the printed runtime's file byte for byte). TABLE: opcode, errno, fcntl, socket, posix, slotdocs and ast (queue 350).
;;
;; opcode (opcode_table.py's builtins_opcode_table.go): _opcode's predicates over Include/internal/pycore_opcode_metadata.h's
;; _PyOpcode_opcode_metadata (IS_VALID_OPCODE, OPCODE_HAS_*, pycore_opcode_utils.h's IS_BLOCK_PUSH_OPCODE) for each opcode
;; below 512 that is valid or in Lib/_opcode_metadata.py's opmap; the intrinsics' names (Python/intrinsics.c's
;; INTRINSIC_FUNC_ENTRY tables), the special methods' (Python/ceval.c's _Py_SpecialMethods' _Py_ID names by SPECIAL_ index)
;; and the binary operators' (Modules/_opcode.c's ADD_NB_OP list by NB_ index).
;; errno (errno_table.py's): errnomodule.c's add_errcode calls against musl's <errno.h> (errorcode's entry of a number the last
;; call's name, as _add_errcode's dict); strerror's texts by musl's table (__strerror.h through strerror.c's rule: the entry
;; of the number, the last of a number, else entry 0's), the same on both architectures (checked).
;; fcntl, socket, posix (fcntl_table.py's, socket_table.py's, posix_table.py's): the module's C source preprocessed whole (its
;; quoted includes dropped, socketmodule.h read in place) with PyModule_AddIntMacro and PyModule_AddIntConstant as markers,
;; each value an integer constant expression (casts, sizeof of scalars and of plain structs on LP64, enumerators); each name
;; written syscall.NAME where Go's syscall declares it on both architectures with musl's value, archConst(AMD64, ARM64) where
;; the architectures' values differ or Go's is another (posix: O_ACCMODE, O_LARGEFILE, O_TMPFILE, what posix_table.py's
;; MUSL_ARCH listed by hand), else the number. posix's sysconf, pathconf and confstr names from posixmodule.c's conftables, the
;; values by musl's own rules: sysconf.c's values[] (a short each; >= -1 itself, JT codes by its switch: _POSIX_VERSION,
;; MQ_PRIO_MAX, PAGE_SIZE, SEM_VALUE_MAX, DELAYTIMER_MAX, 0; the run-time ones left to pyi as posix_table.py's DYNAMIC),
;; fpathconf.c's values[], confstr.c's rule.
(require '[arbace.repr.c.pp :as pp] '[arbace.string :as str])
(import '[java.io File])

(defn- fail! [& xs] (throw (ex-info (apply str xs) {})))

(defn- lines [^String f] (str/split-lines (slurp f)))

(defn- region
  "The lines of file `f` from the first that matches `from` (included) to the first after it that matches `to` (excluded)"
  [f from to]
  (let [ls (lines f)
        start (or (first (keep-indexed (fn [i l] (when (re-find from l) i)) ls)) (fail! f ": no line matches " from))
        end (or (first (keep-indexed (fn [i l] (when (and (> i start) (re-find to l)) i)) ls)) (fail! f ": no end " to))]
    (str/join "\n" (subvec (vec ls) start end))))

(defn- defines
  "The one-line #define lines of file `f` whose name matches `re`"
  [f re]
  (str/join "\n" (for [l (lines f) :let [[_ n] (re-find #"^\s*#\s*define\s+([A-Za-z_][A-Za-z0-9_]*)[\s(]" (str l " "))]
                       :when (and n (re-find re n))]
                   l)))

;; ---- musl's headers as its install composes them

(defn- alltypes
  "musl's obj/include/bits/alltypes.h: tools/mkalltypes.sed over arch/ARCH/bits/alltypes.h.in and include/alltypes.h.in"
  [musl arch]
  (str/join "\n"
            (for [f [(str musl "/arch/" arch "/bits/alltypes.h.in") (str musl "/include/alltypes.h.in")]
                  l (lines f)]
              (if-let [[_ k a b] (or (when-let [[_ x y] (re-matches #"TYPEDEF (.*) ([^ ]*);" l)] [nil "" x y])
                                     (when-let [[_ x y] (re-matches #"STRUCT * ([^ ]*) (.*);" l)] [nil "struct_" x y])
                                     (when-let [[_ x y] (re-matches #"UNION * ([^ ]*) (.*);" l)] [nil "union_" x y]))]
                (let [[decl nm] (if (= k "") [(str "typedef " a " " b ";") b] [(str (subs k 0 (dec (count k))) " " a " " b ";") a])]
                  (str "#if defined(__NEED_" k nm ") && !defined(__DEFINED_" k nm ")\n" decl "\n#define __DEFINED_" k nm "\n#endif\n"))
                l))))

(def ^:private arches {:amd64 "x86_64" :arm64 "aarch64"})

(defn- predefined
  "gcc's predefined macros (test/c/host/predefined/gnu17.h, recorded from the C crop's x86_64 gcc), for arm64 with x86's own
  macros replaced by aarch64's: musl's and Linux's arch-specific headers are chosen by directory, not by these"
  [goarch]
  (let [t (slurp "test/c/host/predefined/gnu17.h")]
    (if (= goarch :amd64)
      t
      (str (str/join "\n" (remove #(re-find #"__(x86_64|amd64|SSE|MMX|FXSR|code_model|SEG_)" %) (str/split-lines t)))
           "\n#define __aarch64__ 1\n#define __ARM_ARCH 8\n"))))

(defn- sysroot
  "The search list of musl's headers for `goarch` (the composed alltypes.h written under WORK)"
  [opts goarch]
  (let [musl (:musl opts) arch (arches goarch)
        obj (str (:work opts) "/musl-" arch "/include")]
    (.mkdirs (File. (str obj "/bits")))
    (spit (str obj "/bits/alltypes.h") (alltypes musl arch))
    ;; obj/include/bits/syscall.h: the .in file, then its __NR_ lines as SYS_ (musl's Makefile: cp, then sed -n s/__NR_/SYS_/p)
    (let [in (slurp (str musl "/arch/" arch "/bits/syscall.h.in"))]
      (spit (str obj "/bits/syscall.h")
            (str in (str/join (for [l (str/split-lines in) :when (str/includes? l "__NR_")] (str (str/replace-first l "__NR_" "SYS_") "\n"))))))
    [obj (str musl "/arch/" arch) (str musl "/arch/generic") (str musl "/include")]))

(defn- preprocess
  "The text of translation unit `text` (written as WORK/NAME) preprocessed for `goarch` with search list `sys`"
  [opts goarch sys name text]
  (let [f (str (:work opts) "/" name)]
    (spit f text)
    (let [r (pp/preprocess {:predefined (predefined goarch) :include [] :iquote [] :sys sys :std :gnu17 :has {} :base "."} f)]
      (when (seq (:errors r)) (fail! name ": the preprocessor's errors: " (str/join "; " (take 5 (:errors r)))))
      (pp/text r))))

;; ---- the markers and their values

(defn- tokens
  "C's tokens of `s` (after preprocessing): numbers, identifiers, string and character literals, punctuators"
  [s]
  (re-seq #"\"(?:[^\"\\]|\\.)*\"|'(?:[^'\\]|\\.)*'|[A-Za-z_][A-Za-z0-9_]*|0[xX][0-9A-Fa-f]+[uUlL]*|[0-9]+[uUlL]*|<<|>>|<=|>=|==|!=|&&|\|\||->|[-+*/%&|^~!()<>?:,;{}\[\].=]" s))

(defn- markers
  "Each call `tag`(ARG, ...) in the token sequence `ts`: [[ARG-TOKENS ...] ...], the arguments split at the top level's commas"
  [ts tag]
  (loop [ts (vec ts) i 0 out []]
    (if (>= i (count ts))
      out
      (if (and (= (ts i) tag) (= (get ts (inc i)) "("))
        (let [[args j] (loop [j (+ i 2) depth 0 cur [] args []]
                         (let [t (ts j)]
                           (cond
                             (and (= t ")") (zero? depth)) [(conj args cur) (inc j)]
                             (and (= t ",") (zero? depth)) (recur (inc j) depth [] (conj args cur))
                             (#{"(" "[" "{"} t) (recur (inc j) (inc depth) (conj cur t) args)
                             (#{")" "]" "}"} t) (recur (inc j) (dec depth) (conj cur t) args)
                             :else (recur (inc j) depth (conj cur t) args))))]
          (recur ts j (conj out args)))
        (recur ts (inc i) out)))))

(defn- c-string
  "The bytes of C string literals `ts` (adjacent ones concatenated) as a string"
  [ts]
  (str/join (for [t ts]
              (do (when-not (str/starts-with? t "\"") (fail! "not a string literal: " t))
                  (-> (subs t 1 (dec (count t)))
                      (str/replace #"\\(x[0-9A-Fa-f]+|[0-7]{1,3}|.)"
                                   (fn [[_ e]]
                                     (cond (str/starts-with? e "x") (str (char (Long/parseLong (subs e 1) 16)))
                                           (re-matches #"[0-7]+" e) (str (char (Long/parseLong e 8)))
                                           :else (case e "n" "\n" "t" "\t" "r" "\r" "a" "\u0007" "b" "\b" "f" "\f" "v" "\u000b" e)))))))))

(def ^:private type-words #{"int" "unsigned" "signed" "long" "short" "char" "__u32" "__u16" "__u8" "__s32" "__u64" "__s64"
                            "uint32_t" "uint16_t" "uint8_t" "int32_t" "int64_t" "uint64_t" "size_t" "mode_t" "const" "in_addr_t"})

(defn- cast-fn [words]
  (let [u? (some #{"unsigned" "__u32" "__u16" "__u8" "__u64" "uint32_t" "uint16_t" "uint8_t" "uint64_t" "size_t" "mode_t" "in_addr_t"} words)
        bits (cond (some #{"char" "__u8" "uint8_t"} words) 8
                   (some #{"short" "__u16" "uint16_t"} words) 16
                   (some #{"long" "__u64" "__s64" "uint64_t" "int64_t" "size_t"} words) 64
                   :else 32)]
    (fn [^long v]
      (if (= bits 64)
        v
        (let [m (dec (bit-shift-left 1 bits)) x (bit-and v m)]
          (if (or u? (< x (bit-shift-left 1 (dec bits)))) x (- x (bit-shift-left 1 bits))))))))

(defn- c-number [^String t]
  (let [s (str/replace t #"[uUlL]+$" "")]
    (cond (re-matches #"0[xX][0-9A-Fa-f]+" s) (Long/parseUnsignedLong (subs s 2) 16)
          (re-matches #"0[0-7]*" s) (if (= s "0") 0 (Long/parseLong (subs s 1) 8))
          :else (Long/parseLong s))))

(defn- c-eval
  "The value of integer constant expression `ts` (tokens), identifiers from `env` (enumerators); nil when it is not one"
  [ts env]
  (let [ts (vec ts) pos (atom 0)
        peek (fn [] (get ts @pos)) next! (fn [] (let [t (peek)] (swap! pos inc) t))
        expect (fn [t] (when-not (= (next!) t) (throw (ex-info "syntax" {}))))
        bin {"*" [10 *] "/" [10 quot] "%" [10 rem] "+" [9 +] "-" [9 -] "<<" [8 bit-shift-left] ">>" [8 bit-shift-right]
             "<" [7 #(if (< %1 %2) 1 0)] ">" [7 #(if (> %1 %2) 1 0)] "<=" [7 #(if (<= %1 %2) 1 0)] ">=" [7 #(if (>= %1 %2) 1 0)]
             "==" [6 #(if (= %1 %2) 1 0)] "!=" [6 #(if (not= %1 %2) 1 0)] "&" [5 bit-and] "^" [4 bit-xor] "|" [3 bit-or]
             "&&" [2 #(if (and (not= 0 %1) (not= 0 %2)) 1 0)] "||" [1 #(if (or (not= 0 %1) (not= 0 %2)) 1 0)]}]
    (letfn [(unary []
              (let [t (next!)]
                (cond
                  (nil? t) (throw (ex-info "end" {}))
                  (= t "-") (- (long (unary)))
                  (= t "+") (unary)
                  (= t "~") (bit-not (long (unary)))
                  (= t "!") (if (zero? (long (unary))) 1 0)
                  (= t "sizeof")
                  (do (expect "(")
                      (let [ws (loop [ws []] (if (= (peek) ")") (do (next!) ws) (recur (conj ws (next!)))))]
                        (or ((get env ::sizeof (constantly nil)) ws) (throw (ex-info (str "no size: " ws) {})))))
                  (and (= t "(") (type-words (peek)))
                  (let [ws (loop [ws []] (if (= (peek) ")") (do (next!) ws) (recur (conj ws (next!)))))]
                    ((cast-fn ws) (unary)))
                  (= t "(") (let [v (expr 0)] (expect ")") v)
                  (re-matches #"[0-9].*" t) (c-number t)
                  (re-matches #"'.'" t) (long (int (.charAt ^String t 1)))
                  (contains? env t) (get env t)
                  :else (throw (ex-info (str "not a constant: " t) {})))))
            (expr [^long min]
              (loop [l (unary)]
                (let [op (peek) [p f] (get bin op)]
                  (cond
                    (and p (> (long p) min)) (do (next!) (recur (f l (expr p))))
                    (and (= op "?") (> 0.5 min)) (do (next!) (let [a (expr 0)] (expect ":") (let [b (expr 0)] (if (zero? (long l)) b a))))
                    :else l))))]
      (try (let [v (expr -1)] (when (= @pos (count ts)) (long v)))
           (catch Exception _ nil)))))

(defn- enumerators
  "The enumerators of every enum of preprocessed text `s`, by name (each one's value, its predecessor's plus one when not given)"
  [s]
  (let [ts (vec (tokens s))]
    (loop [i 0 env {}]
      (if (>= i (count ts))
        env
        (if (= (ts i) "enum")
          (let [j (if (= (get ts (+ i 1)) "{") (+ i 1) (when (= (get ts (+ i 2)) "{") (+ i 2)))]
            (if-not j
              (recur (inc i) env)
              (let [[env k] (loop [k (inc j) env env prev -1]
                              (let [nm (ts k)]
                                (if (= nm "}")
                                  [env k]
                                  (let [[vts k2] (if (= (get ts (inc k)) "=")
                                                   (loop [m (+ k 2) depth 0 acc []]
                                                     (let [t (ts m)]
                                                       (cond (and (zero? depth) (#{"," "}"} t)) [acc m]
                                                             (= t "(") (recur (inc m) (inc depth) (conj acc t))
                                                             (= t ")") (recur (inc m) (dec depth) (conj acc t))
                                                             :else (recur (inc m) depth (conj acc t)))))
                                                   [nil (inc k)])
                                        v (if vts (c-eval vts env) (inc (long prev)))
                                        env (if v (assoc env nm v) env)
                                        k3 (if (= (get ts k2) ",") (inc k2) k2)]
                                    (recur k3 env (or v prev))))))]
                (recur (inc k) env))))
          (recur (inc i) env))))))

(defn- values
  "[[NAME VALUE] ...] of the markers `tag`(NAME-STRING, EXPR) in preprocessed text `s`, in order"
  [s tag]
  (let [env (enumerators s)]
    (vec (for [[nm e] (markers (tokens s) tag)
               :let [n (c-string nm) v (c-eval e env)]]
           (if (nil? v) (fail! tag ": " n "'s value is no constant: " (str/join " " e)) [n v])))))

;; ---- opcode

(defn- go-strs [xs] (str/join ", " (map #(str "\"" % "\"") xs)))

(defn- opcode-text
  "_opcode's tables of the tree `py` as builtins_opcode_table.go (sfx \"\") or a release's (queue 357: sfx \"315\", 3.15.2's tree, each
  name with the suffix, as opcode_table.py --suffix 315 run by the 3.15.2 oracle); version the header's release"
  [opts py sfx version]
  (let [inc-dir (str py "/Include/internal")
        ids (defines (str py "/Include/opcode_ids.h") #"^[A-Z_0-9]+$")
        meta-text (preprocess opts :amd64 [] "opcode-meta.c"
                              (str ids "\n"
                                   (defines (str inc-dir "/pycore_opcode_metadata.h") #"^(HAS_[A-Z_0-9]+_FLAG|INSTR_FMT_[A-Za-z0-9_]+)$") "\n"
                                   "#define true 1\n#define false 0\n"
                                   "#define __pyop__(op, v, fmt, flags) __pym__(op, v, flags)\n"
                                   (str/replace (region (str inc-dir "/pycore_opcode_metadata.h")
                                                        #"^const struct opcode_metadata _PyOpcode_opcode_metadata\[" #"^};")
                                                #"(?m)^\s*\[([A-Z_0-9]+)\] = \{ ([^,]+), ([^,]+), ([^}]+) \},$" "__pyop__($1, $2, $3, $4)")
                                   "\n"
                                   ;; IS_BLOCK_PUSH_OPCODE's opcodes
                                   "__pyb__(SETUP_FINALLY) __pyb__(SETUP_WITH) __pyb__(SETUP_CLEANUP)\n"))
        ts (tokens meta-text)
        size (or (some->> (re-find #"_PyOpcode_opcode_metadata\[(\d+)\]" (slurp (str inc-dir "/pycore_opcode_metadata.h"))) second Long/parseLong)
                 (fail! "no metadata size"))
        md (into {} (for [[op v flags] (markers ts "__pym__")] [(c-eval op {}) [(c-eval v {}) (c-eval flags {})]]))
        block (set (for [[op] (markers ts "__pyb__")] (c-eval op {})))
        ;; opmap's values: 3.14's dict display (`    'NAME': N,`), 3.15's frozendict call (`    NAME=N,`)
        md-py (str py "/Lib/_opcode_metadata.py")
        opmap (set (map #(Long/parseLong (second %))
                        (if (re-find #"(?m)^opmap = \{" (slurp md-py))
                          (re-seq #"(?m)^    '[A-Za-z_0-9]+': (\d+),$" (region md-py #"^opmap = \{" #"^\}"))
                          (re-seq #"(?m)^    [A-Za-z_0-9]+=(\d+),$" (region md-py #"^opmap = frozendict\($" #"^\)")))))
        valid? (fn [op] (and (< op size) (when-let [[v] (md op)] (not= 0 (long v)))))
        rows (for [op (range 512)
                   :when (or (valid? op) (opmap op))
                   :let [flags (long (second (md op [0 0])))
                         preds [(bit-and flags 1) (bit-and flags 2) (bit-and flags 4) (bit-and flags 8) (bit-and flags 16)
                                (bit-and flags 32) (if (block op) 1 0)]
                         bits (reduce + (map-indexed (fn [i p] (if (and (valid? op) (not= 0 (long p))) (bit-shift-left 1 i) 0)) preds))]]
               (str op ":" bits ":" (if (valid? op) 1 0)))
        intr (fn [arr hdr-re]
               (let [t (preprocess opts :amd64 [] (str "intrinsics-" arr ".c")
                                   (str (defines (str inc-dir "/pycore_intrinsics.h") hdr-re) "\n"
                                        "#define INTRINSIC_FUNC_ENTRY(N, F) __pyi__(N, #N)\n"
                                        (region (str py "/Python/intrinsics.c") (re-pattern (str "^_PyIntrinsics_" arr "\\[\\] = \\{")) #"^};")))]
                 (mapv second (sort-by first (for [[n s] (markers (tokens t) "__pyi__")] [(c-eval n {}) (c-string s)])))))
        special (let [t (preprocess opts :amd64 [] "special.c"
                                    (str (defines (str inc-dir "/pycore_ceval.h") #"^SPECIAL_") "\n"
                                         "#define _Py_ID(n) #n\n"
                                         (str/replace (region (str py "/Python/ceval.c") #"^const _Py_SpecialMethod _Py_SpecialMethods\[\] = \{" #"^};")
                                                      #"(?m)^    \[(SPECIAL_[A-Z_]+)\] = \{\s*\n\s*\.name = &(_Py_ID\([a-z_]+\)),"
                                                      "__pys__($1, $2) {")))]
                  (mapv second (sort-by first (for [[n s] (markers (tokens t) "__pys__")] [(c-eval n {}) (c-string s)]))))
        nb (let [t (preprocess opts :amd64 [] "nb-ops.c"
                               (str (defines (str py "/Include/opcode.h") #"^NB_") "\n"
                                    "#define ADD_NB_OP(NUM, STR) __pyn__(NUM, #NUM, STR)\n"
                                    (region (str py "/Modules/_opcode.c") #"^\s*ADD_NB_OP\(NB_ADD," #"^#undef ADD_NB_OP")))]
             (mapv rest (sort-by first (for [[n s op] (markers (tokens t) "__pyn__")] [(c-eval n {}) (c-string s) (c-string op)]))))]
    (str "// Code generated by tools/pyi/runtime_tables.ae (opcode" (when (seq sfx) (str " --suffix " sfx)) ") from CPython " version "'s _opcode; DO NOT EDIT.\n\n"
         "package py\n\n"
         "// opcodeRows are OP:FLAGS:VALID, FLAGS a bit per has_arg, has_const, has_name, has_jump, has_free, has_local, has_exc.\n"
         "const opcodeRows" sfx " = \"" (str/join " " rows) "\"\n\n"
         "var opcodeIntrinsic1" sfx " = []string{" (go-strs (intr "UnaryFunctions" #"^(INTRINSIC_|MAX_INTRINSIC_1)")) "}\n\n"
         "var opcodeIntrinsic2" sfx " = []string{" (go-strs (intr "BinaryFunctions" #"^(INTRINSIC_|MAX_INTRINSIC_2)")) "}\n\n"
         "var opcodeSpecialMethods" sfx " = []string{" (go-strs special) "}\n\n"
         "var opcodeNbOps" sfx " = [][2]string{" (str/join ", " (for [[a b] nb] (str "{\"" a "\", \"" b "\"}"))) "}\n")))

(defn- py-version [py]
  (or (second (re-find #"#define\s+PY_VERSION\s+\"([0-9.]+)" (slurp (str py "/Include/patchlevel.h")))) (fail! py ": no PY_VERSION")))

(defn- table-opcode [opts] (opcode-text opts (:cpython opts) "" "3.14.10"))

(defn- table-opcode315 [opts]
  (let [py (or (:cpython315 opts) (fail! "opcode315: no --cpython315"))] (opcode-text opts py "315" (py-version py))))

;; ---- errno

(defn- errno-of
  "errno_exec's add_errcode calls ([[NAME CODE] ...], in order) and musl's strerror ({code text} and the unknown code's text) for goarch"
  [opts goarch]
  (let [py (:cpython opts) sys (sysroot opts goarch)
        calls (values (preprocess opts goarch sys (str "errno-" (name goarch) ".c")
                                  (str "#define _GNU_SOURCE 1\n#include <errno.h>\n"
                                       "#define add_errcode(name, code, comment) __pyc__(name, code);\n"
                                       (region (str py "/Modules/errnomodule.c") #"^#ifdef ENODEV$" #"^    Py_DECREF\(error_dict\);")))
                      "__pyc__")
        st (preprocess opts goarch (conj sys (str (:musl opts) "/src/errno")) (str "strerror-" (name goarch) ".c")
                       "#include <errno.h>\n#define E(n, s) __pye__(n, s);\n#include <__strerror.h>\n")
        msgs (reduce (fn [m [n s]] (assoc m (c-eval n {}) (c-string s))) {} (markers (tokens st) "__pye__"))]
    {:calls calls :strerror (fn [c] (get msgs c (get msgs 0)))}))

(defn- go-quote [s] (str "\"" (-> s (str/replace "\\" "\\\\") (str/replace "\"" "\\\"")) "\""))

(defn- table-errno [opts]
  (let [{:keys [calls strerror]} (errno-of opts :amd64)
        arm (errno-of opts :arm64)
        _ (when-not (and (= calls (:calls arm)) (every? #(= (strerror %) ((:strerror arm) %)) (cons 99999 (map second calls))))
            (fail! "errno: amd64's and arm64's differ"))
        by-name (into {} calls)
        names (sort (keys by-name))
        codes (sort (distinct (vals by-name)))
        errorcode (reduce (fn [m [n c]] (assoc m c n)) {} calls)]
    (str "// Code generated by tools/pyi/runtime_tables.ae (errno) from CPython 3.14.10's errno; DO NOT EDIT.\n\n"
         "package py\n\n"
         "// errnoTable are errno's names and numbers, in name order.\n"
         "var errnoTable = []struct {\n\tname string\n\tv    int\n}{\n"
         (str/join (for [n names] (str "\t{\"" n "\", " (by-name n) "},\n")))
         "}\n\n"
         "// errnoCodes are errno.errorcode: each number's name.\n"
         "var errnoCodes = map[int]string{\n"
         (str/join (for [c codes] (str "\t" c ": \"" (errorcode c) "\",\n")))
         "}\n\n"
         "// strerrorTexts are C's strerror of each errno number (musl's).\n"
         "var strerrorTexts = map[int]string{\n"
         (str/join (for [c codes] (str "\t" c ": " (go-quote (strerror c)) ",\n")))
         "}\n\n"
         "// strerrorUnknown is strerror's text of a number it does not know.\n"
         "const strerrorUnknown = \"" (strerror 99999) "\"\n")))

(def ^:private scalar-sizes
  {"char" 1 "signed char" 1 "unsigned char" 1 "short" 2 "unsigned short" 2 "int" 4 "unsigned" 4 "unsigned int" 4 "long" 8
   "unsigned long" 8 "long long" 8 "unsigned long long" 8 "__u8" 1 "__s8" 1 "__u16" 2 "__s16" 2 "__u32" 4 "__s32" 4 "__u64" 8
   "__s64" 8 "uint8_t" 1 "int8_t" 1 "uint16_t" 2 "int16_t" 2 "uint32_t" 4 "int32_t" 4 "uint64_t" 8 "int64_t" 8 "size_t" 8})

(defn- sizeof-fn
  "sizeof on LP64 (amd64 and arm64 alike) for the scalar types and the structs of preprocessed text `s` whose members are
  scalars or arrays of them (natural alignment); nil for anything else"
  [s]
  (let [structs (into {} (for [[_ nm body] (re-seq #"struct\s+([A-Za-z_][A-Za-z0-9_]*)\s*\{([^{}]*)\}" s)] [nm body]))
        size-of (fn size-of [ws]
                  (let [k (str/join " " (remove #{"const" "volatile"} ws))]
                    (or (scalar-sizes k)
                        (when-let [[_ nm] (re-matches #"struct ([A-Za-z_][A-Za-z0-9_]*)" k)]
                          (when-let [body (structs nm)]
                            (let [ms (for [m (str/split body #";") :let [m (str/trim m)] :when (seq m)]
                                       (let [[_ ty _ n] (re-matches #"(.*?)\s*([A-Za-z_][A-Za-z0-9_]*)\s*(?:\[\s*(\d+)\s*\])?" m)
                                             sz (scalar-sizes (str/trim ty))]
                                         (when sz [sz (* (long sz) (if n (Long/parseLong n) 1))])))]
                              (when (every? some? ms)
                                (let [al (reduce max 1 (map first ms))
                                      end (reduce (fn [off [a n]] (+ (* (quot (+ off (dec a)) a) a) n)) 0 ms)]
                                  (* (quot (+ end (dec al)) al) al)))))))))]
    (fn [ws] (size-of ws))))

;; ---- a module's integer constants (fcntl, posix, _socket)

;; ---- configure's header checks (queue 357): configure.ac's AC_CHECK_HEADERS of a literal list, each header's HAVE_ macro (autoconf's
;; name: upper case, every other character _) defined where the header is found on the search list, as configure finds it

(defn- configure-headers
  "The headers configure checks: autoconf's defaults, then configure.ac's literal lists (AC_CHECK_HEADERS([a.h b/c.h ...]), its first
  argument), in order"
  [opts]
  (let [ac (slurp (str (:cpython opts) "/configure.ac"))]
    (distinct (concat
               ;; autoconf's own: AC_INCLUDES_DEFAULT's headers (every check's prologue, AC_CHECK_INCLUDES_DEFAULT), AC_HEADER_DIRENT's
               ["stdio.h" "stdlib.h" "string.h" "inttypes.h" "stdint.h" "strings.h" "sys/stat.h" "sys/types.h" "unistd.h" "dirent.h"]
               (for [[_ lst] (re-seq #"AC_CHECK_HEADERS\(\s*(?:m4_normalize\(\s*)?\[([^\]]*)\]" ac)
                    h (str/split (str/trim (str/replace lst #"\\\n" " ")) #"\s+")
                    :when (re-matches #"[a-z0-9_/.+-]+\.h" h)]
                h)))))

(defn- have-headers
  "#define HAVE_X_H 1 for each configure-checked header found on the search list `sys`"
  [opts sys]
  (str/join (for [h (configure-headers opts)
                  :when (some #(.isFile (File. (str % "/" h))) sys)]
              (str "#define HAVE_" (str/upper-case (str/replace h #"[^A-Za-z0-9]" "_")) " 1\n"))))

(defn- ac-define-value
  "configure.ac's AC_DEFINE([NAME], [VALUE] ...) value of NAME (the first; 1 when it states none)"
  [^String ac nm]
  (if-let [[_ v] (re-find (re-pattern (str "AC_DEFINE\\(\\[?" nm "\\]?(?:,\\s*\\[?([^\\],)]*)\\]?)?")) ac)]
    (if (or (nil? v) (str/blank? v)) "1" (str/trim v))
    (fail! "configure.ac: no AC_DEFINE of " nm)))

(def ^:private linux-feature-macros
  "configure.ac's feature macros that hold on Linux: the three it defines for every system, _XOPEN_SOURCE's three where
  define_xopen_source stays yes (Linux is in none of its exceptions), the large file pair (use_lfs, the default) and _REENTRANT
  (POSIX threads)"
  ["_NETBSD_SOURCE" "__BSD_VISIBLE" "_DARWIN_C_SOURCE" "_XOPEN_SOURCE" "_XOPEN_SOURCE_EXTENDED" "_POSIX_C_SOURCE"
   "_LARGEFILE_SOURCE" "_FILE_OFFSET_BITS" "_REENTRANT"])

(defn- system-extensions
  "AC_USE_SYSTEM_EXTENSIONS's macros as pyconfig.h.in's block holds them (`# undef NAME` under `#ifndef NAME`): each defined 1 but
  Minix's (_MINIX, _POSIX_SOURCE, _POSIX_1_SOURCE, autoconf's only on Minix) and _XOPEN_SOURCE (configure.ac's own value)"
  [^String in]
  (let [i (or (str/index-of in "/* Enable extensions on AIX") (fail! "pyconfig.h.in: no system extensions' block"))
        blk (subs in i (str/index-of in "\n\n" (str/index-of in "#endif" (str/index-of in "_TANDEM_SOURCE" i))))]
    (for [[_ nm] (re-seq #"(?m)^# undef ([A-Za-z_0-9]+)$" blk)
          :when (not (#{"_MINIX" "_POSIX_SOURCE" "_POSIX_1_SOURCE" "_XOPEN_SOURCE"} nm))]
      nm)))

(def ^:private lp64-musl-sizes
  "The sizes AC_CHECK_SIZEOF asks beyond scalar-sizes' on LP64 with musl (the SysV AMD64 ABI's and AAPCS64's, musl's alltypes.h
  typedefs: off_t and time_t 64-bit, pid_t int, fpos_t 16 bytes, pthread_t a pointer, pthread_key_t unsigned)"
  {"void *" 8 "float" 4 "double" 8 "long double" 16 "_Bool" 1 "off_t" 8 "time_t" 8 "pid_t" 4 "uintptr_t" 8 "fpos_t" 16
   "pthread_t" 8 "pthread_key_t" 4 "wchar_t" 4})

(defn- sizeofs
  "AC_CHECK_SIZEOF's answers on LP64 (amd64 and arm64 alike) for the scalar types `scalar-sizes` knows (autoconf's name: upper
  case, * as P, every other character _)"
  [^String ac]
  (str/join (for [[_ ty] (re-seq #"AC_CHECK_SIZEOF\(\[([^\]]+)\]" ac)
                  :let [n (or (scalar-sizes ty) (lp64-musl-sizes ty))] :when n]
              (str "#define SIZEOF_" (-> ty str/upper-case (str/replace "*" "P") (str/replace #"[^A-Z0-9]+" "_")) " " n "\n"))))

(defn- configure-funcs
  "The functions configure.ac checks by name, [NAME DEFINE]: AC_CHECK_FUNCS of a literal list (HAVE_NAME), PY_CHECK_FUNC([NAME], ...,
  [DEFINE]) and its NETDB and SOCKET forms (DEFINE, else HAVE_NAME), PY_CHECK_FUNC_PRIVATE (_Py_HAVE_NAME)"
  [^String ac]
  ;; a check under `if test "$MACHDEP" != linux` is not made on Linux (lchmod's)
  (distinct (concat (for [[_ lst] (re-seq #"AC_CHECK_FUNCS\(\[([^\]]*)\]" (str/replace ac #"(?s)if test \"\$MACHDEP\" != linux; then.*?\nfi\n" ""))
                          f (str/split (str/trim (str/replace lst #"\\\n" " ")) #"\s+")
                          :when (re-matches #"[a-z_][a-z0-9_]*" f)]
                      [f (str "HAVE_" (str/upper-case f))])
                    (for [[_ priv f d] (re-seq #"PY_CHECK_(?:NETDB_|SOCKET_)?FUNC(_PRIVATE)?\(\[([a-z_][a-z0-9_]*)\](?:,\s*\[[^\]]*\](?:,\s*\[([A-Z_0-9]+)\])?)?" ac)]
                      [f (or d (str (if priv "_Py_HAVE_" "HAVE_") (str/upper-case f)))]))))

(def ^:private musl-symbols-cache (atom {}))

(defn- musl-symbols
  "The functions musl 1.2.6's sources define (configure's link test against its libc): a definition `TYPE NAME(...)` whose body's
  { opens the next line, musl's style, and the weak_alias and strong_alias names"
  [opts]
  (let [musl (:musl opts)]
    (or (@musl-symbols-cache musl)
        (let [syms (set (for [^File f (file-seq (File. (str musl "/src"))) :when (.endsWith (.getName f) ".c")
                              :let [t (slurp f)]
                              n (concat (map second (re-seq #"(?m)^[A-Za-z_][^\n;#]*?\b([A-Za-z_][A-Za-z0-9_]*)\([^;{]*\)\s*\n\{" t))
                                        (map second (re-seq #"(?:weak|strong)_alias\(\s*[A-Za-z_0-9]+\s*,\s*([A-Za-z_0-9]+)\s*\)" t)))]
                          n))]
          (swap! musl-symbols-cache assoc musl syms)
          syms))))

(defn- have-funcs
  "#define HAVE_NAME 1 for each function configure checks that musl defines"
  [opts ^String ac]
  (let [syms (musl-symbols opts)]
    (str/join (distinct (for [[f d] (configure-funcs ac) :when (syms f)] (str "#define " d " 1\n"))))))

(defn- macro-probe
  "Which of the names are macros after the prologue `pre` (C text: the feature macros and includes), preprocessed for goarch over
  `sys`: {NAME true|false}"
  [opts goarch sys pre names]
  (if (empty? names)
    {}
    (let [t (preprocess opts goarch sys (str "probe-" (name goarch) "-" (Math/abs (long (hash [pre names]))) ".c")
                        (str pre (str/join (for [n names] (str "#ifdef " n "\n__pyq__(\"" n "\", 1)\n#else\n__pyq__(\"" n "\", 0)\n#endif\n")))))]
      (into {} (for [[n v] (markers (tokens t) "__pyq__")] [(c-string n) (= ["1"] v)])))))

(defn- have-decls
  "AC_CHECK_DECLS([A, B, ...], [IF-FOUND], [IF-NOT], [@%:@include <H>...]): HAVE_DECL_A 1 or 0 by whether the includes declare A (as a
  macro: every name configure.ac checks so is one), and IF-FOUND's AC_DEFINE([NAME]) when found"
  [opts goarch sys ^String ac pre]
  (str/join
   (for [[whole lst] (re-seq #"AC_CHECK_DECLS\(\[([^\]]*)\][^\n]*(?:\n[ \t]+[^\n]*)*" ac)
         :let [names (map str/trim (str/split lst #","))
               incs (str/join (for [[_ h] (re-seq #"@%:@include <([^>]+)>" whole)] (str "#include <" h ">\n")))
               found (macro-probe opts goarch sys (str pre incs) names)
               then (second (re-find #"AC_DEFINE\(\[([A-Z_0-9]+)\]" whole))]
         n names]
     (str "#define HAVE_DECL_" n " " (if (found n) 1 0) "\n"
          (when (and (found n) then) (str "#define " then " 1\n"))))))

(def ^:private configure-probes
  "configure.ac's own compile and link checks the modules' constants read (AC_CACHE_CHECK with AC_COMPILE_IFELSE or AC_LINK_IFELSE, then
  AC_DEFINE([DEFINE])), each as its program asks: :struct a struct the includes define, :ident a name they declare (an enumerator),
  :macro a macro they define, :func a function musl defines (the link); every entry's cache variable and AC_DEFINE checked to be in
  configure.ac. getaddrinfo's: the link and the run check of a working one (ac_cv_buggy_getaddrinfo no: musl's resolves the test's
  passive and numeric hosts)"
  [{:define "HAVE_GETADDRINFO" :cache "ac_cv_func_getaddrinfo" :includes ["netdb.h"] :need [[:func "getaddrinfo"]]}
   {:define "HAVE_ADDRINFO" :cache "ac_cv_struct_addrinfo" :includes ["netdb.h"] :need [[:struct "addrinfo"]]}
   {:define "HAVE_SOCKADDR_STORAGE" :cache "ac_cv_struct_sockaddr_storage" :includes ["sys/types.h" "sys/socket.h"] :need [[:struct "sockaddr_storage"]]}
   {:define "HAVE_SOCKADDR_ALG" :cache "ac_cv_struct_sockaddr_alg" :includes ["sys/types.h" "sys/socket.h" "linux/if_alg.h"] :need [[:struct "sockaddr_alg"]]}
   {:define "HAVE_LINUX_CAN_RAW_FD_FRAMES" :cache "ac_cv_can_raw_fd_frames" :includes ["linux/can/raw.h"] :need [[:ident "CAN_RAW_FD_FRAMES"]]}
   {:define "HAVE_LINUX_CAN_RAW_JOIN_FILTERS" :cache "ac_cv_can_raw_join_filters" :includes ["linux/can/raw.h"] :need [[:ident "CAN_RAW_JOIN_FILTERS"]]}
   {:define "HAVE_DYNAMIC_LOADING" :cache "DYNLOADFILE" :includes [] :need [[:func "dlopen"]]}
   {:define "HAVE_WORKING_TZSET" :cache "ac_cv_working_tzset" :includes ["time.h"] :need [[:func "tzset"]]}
   {:define "HAVE_MAKEDEV" :cache "ac_cv_func_makedev" :includes ["sys/types.h" "sys/sysmacros.h"] :need [[:macro "makedev"]]}
   {:define "HAVE_DEVICE_MACROS" :cache "ac_cv_device_macros" :includes ["sys/types.h" "sys/sysmacros.h"] :need [[:macro "major"] [:macro "minor"] [:macro "makedev"]]}
   ;; the libraries' (queue 357: their headers the pinned -dev apks'): zlib >= 1.2.0 by pkg-config (inflateCopy's zlib), readline's
   ;; declarations (readline_includes), curses' wide API (_CURSES_INCLUDES; PY_CHECK_CURSES_FUNC's and _VAR's are library-probes')
   {:define "HAVE_ZLIB_COPY" :cache "inflateCopy" :includes ["zlib.h"] :need [[:declared "inflateCopy"]]}
   {:define "HAVE_NCURSESW" :cache "ac_cv_curses_wide" :pre :curses :need [[:declared "setcchar"] [:declared "add_wch"]]}
   {:define "HAVE_CURSES_GETMOUSE" :cache "ac_cv_lib_curses_getmouse" :pre :curses :need [[:declared "getmouse"] [:declared "MEVENT"]]}
   {:define "HAVE_RL_COMPLETION_APPEND_CHARACTER" :cache "rl_completion_append_character" :pre :readline :need [[:declared "rl_completion_append_character"]]}
   {:define "HAVE_RL_COMPLETION_SUPPRESS_APPEND" :cache "rl_completion_suppress_append" :pre :readline :need [[:declared "rl_completion_suppress_append"]]}
   {:define "HAVE_RL_PRE_INPUT_HOOK" :cache "ac_cv_readline_rl_pre_input_hook" :pre :readline :need [[:declared "rl_pre_input_hook"]]}
   {:define "HAVE_RL_COMPLETION_DISPLAY_MATCHES_HOOK" :cache "ac_cv_readline_rl_completion_display_matches_hook" :pre :readline :need [[:declared "rl_completion_display_matches_hook"]]}
   {:define "HAVE_RL_RESIZE_TERMINAL" :cache "ac_cv_readline_rl_resize_terminal" :pre :readline :need [[:declared "rl_resize_terminal"]]}
   {:define "HAVE_RL_COMPLETION_MATCHES" :cache "ac_cv_readline_rl_completion_matches" :pre :readline :need [[:declared "rl_completion_matches"]]}
   {:define "HAVE_RL_CATCH_SIGNAL" :cache "rl_catch_signals" :pre :readline :need [[:declared "rl_catch_signals"]]}
   {:define "HAVE_RL_APPEND_HISTORY" :cache "ac_cv_readline_append_history" :pre :readline :need [[:declared "append_history"]]}
   {:define "HAVE_RL_COMPDISP_FUNC_T" :cache "AC_CHECK_TYPES([rl_compdisp_func_t]" :implicit true :pre :readline :need [[:declared "rl_compdisp_func_t"]]}
   {:define "HAVE_GETRANDOM_SYSCALL" :cache "ac_cv_getrandom_syscall" :includes ["stddef.h" "unistd.h" "sys/syscall.h" "linux/random.h"]
    :need [[:macro "SYS_getrandom"] [:macro "GRND_NONBLOCK"] [:func "syscall"]]}])

(defn- ac-block
  "configure.ac's m4 text of _CURSES_INCLUDES or readline_includes (WITH_EDITLINE not defined: readline's)"
  [^String ac k]
  (case k
    :curses (let [i (+ (str/index-of ac "AC_DEFUN([_CURSES_INCLUDES],dnl\n[") (count "AC_DEFUN([_CURSES_INCLUDES],dnl\n["))]
              (subs ac i (str/index-of ac "\n])" i)))
    :readline (let [i (+ (str/index-of ac "m4_define([readline_includes], [") (count "m4_define([readline_includes], ["))]
                (subs ac i (str/index-of ac "\n    ])" i)))
    nil ""))

(defn- curses-probes
  "PY_CHECK_CURSES_FUNC([F]) and PY_CHECK_CURSES_VAR([V]): HAVE_CURSES_F where _CURSES_INCLUDES declare F (a macro or a declaration)"
  [^String ac]
  (for [[_ nm] (re-seq #"(?m)^PY_CHECK_CURSES_(?:FUNC|VAR)\(\[([A-Za-z_0-9]+)\]\)" ac)]
    {:define (str "HAVE_CURSES_" (str/upper-case nm)) :pre :curses :need [[:declared nm]] :generated true}))

(defn- probe-defines
  "configure-probes' answers for goarch over `sys` after the prologue `pre`"
  [opts goarch sys ^String ac pre]
  (str/join
   (for [{:keys [define cache includes need generated implicit] pk :pre} (concat configure-probes (curses-probes ac))
         :let [_ (when-not (or generated (and (str/includes? ac cache) (or implicit (str/includes? ac (str "AC_DEFINE([" define "]")))))
                   (fail! "configure.ac: no check " cache " defining " define))
               incs (str (ac-block ac pk) "\n" (str/join (for [h includes] (str "#include <" h ">\n"))))
               t (preprocess opts goarch sys (str "probe-" (name goarch) "-" define ".c") (str pre incs))
               ts (vec (tokens t)) tset (set ts)
               macros (macro-probe opts goarch sys (str pre incs) (for [[k n] need :when (#{:macro :declared} k)] n))
               ok? (every? (fn [[k n]]
                             (case k
                               :struct (some (fn [i] (and (= (ts i) "struct") (= (get ts (inc i)) n) (= (get ts (+ i 2)) "{"))) (range (count ts)))
                               :ident (contains? tset n)
                               :macro (macros n)
                               :declared (or (macros n) (contains? tset n))
                               :func (contains? (musl-symbols opts) n)))
                           need)]
         :when ok?]
     (str "#define " define " 1\n"))))

(defn- own-pyconfig
  "pyconfig.h's answers the modules read (queue 357), by configure's rules on Linux over the search list `sys`: the feature
  macros, the system extensions, the headers found"
  [opts goarch sys]
  (let [py (:cpython opts) ac (slurp (str py "/configure.ac")) in (slurp (str py "/pyconfig.h.in"))
        d (fn [nm v] (str "#ifndef " nm "\n#define " nm " " v "\n#endif\n"))]
    (let [features (str (str/join (for [nm linux-feature-macros] (d nm (ac-define-value ac nm))))
                        (str/join (for [nm (system-extensions in)] (d nm "1"))))]
     (str features
         (have-headers opts sys)
         (sizeofs ac)
         (have-funcs opts ac)
         (have-decls opts goarch sys ac features)
         (probe-defines opts goarch sys ac (str features (have-headers opts sys)))))))

(defn- module-unit
  "The module's C source `file` (under Modules/) preprocessed for `goarch` over musl's composed headers, then the extracted apks'
  root `--root-ARCH`'s usr/include (Linux's UAPI and BlueZ's headers), with pyconfig.h's answers configure gives on Linux
  (own-pyconfig, queue 357: no file of CPython's build; `--pyconfig alpine`, by hand, Alpine's python3 apk's pyconfig.h from
  ROOT/usr/include/python3.14, the old input, for comparison): a header of the module's own beside it (socketmodule.h) read in place, the quoted includes (Python.h, the internal
  headers, clinic's) dropped, the system ones kept under their pyconfig gates; PyModule_AddIntMacro and PyModule_AddIntConstant
  (and so the module's ADD_INT_* macros) made markers. {:consts [[NAME VALUE] ...] in order, :text, :env}"
  [opts goarch file]
  (let [root (or (get opts (keyword (str "root-" (name goarch)))) (fail! "--root-" (name goarch) ": the extracted apks' root"))
        alpine? (= "alpine" (:pyconfig opts))
        sys (into (if alpine? [(str root "/usr/include/python3.14")] []) (conj (sysroot opts goarch) (str root "/usr/include")))
        src (slurp (str (:cpython opts) "/Modules/" file))
        src (str/replace src #"(?m)^\s*#\s*include\s+\"([a-z]+\.h)\".*$"
                         (fn [[l h]] (let [f (File. (str (:cpython opts) "/Modules/" h))] (if (.exists f) (slurp f) l))))
        body (str/replace src #"(?m)^\s*#\s*include\s+\"[^\"]*\".*$" "")
        t (preprocess opts goarch sys (str file "-" (name goarch) ".c")
                      (str (if alpine? "#include <pyconfig.h>\n"
                               (let [pc (str (own-pyconfig opts goarch sys) (some-> (:pyconfig-extra opts) (str "-" (name goarch) ".h") slurp))] (spit (str (:work opts) "/pyconfig-" (name goarch) ".h") pc) pc))
                           "#define PyModule_AddIntMacro(m, c) __pyc__(#c, c)\n"
                           "#define PyModule_AddIntConstant(m, name, value) __pyc__(name, value)\n"
                           body))
        env (assoc (enumerators t) ::sizeof (sizeof-fn t))]
    {:text t :env env :sys sys
     :consts (vec (for [[nm e] (markers (tokens t) "__pyc__")
                        :let [v (c-eval e env)]]
                    (if v [(c-string nm) v] (fail! file ": " (c-string nm) "'s value is no constant: " (str/join " " e)))))}))

(defn- go-consts
  "Go's syscall constants of GOROOT's src/syscall/zerrors_linux_ARCH.go: {NAME value}"
  [opts goarch]
  (into {} (for [[_ n v] (re-seq #"\n\s+([A-Za-z_][A-Za-z0-9_]*)\s+= (0x[0-9a-fA-F]+|-?\d+)(?=\n)"
                                 (slurp (str (or (:goroot opts) (fail! "--goroot")) "/src/syscall/zerrors_linux_" (name goarch) ".go")))]
             [n (if (str/starts-with? v "0x") (Long/parseUnsignedLong (subs v 2) 16) (Long/parseLong v))])))

(defn- const-rows
  "The rows of a module's constants, in name order (Python's sorted(dir(module)), its int members), each written as the
  python3 generators wrote it: syscall.NAME where Go's syscall declares NAME for amd64 and arm64 with musl's value on each;
  archConst(AMD64, ARM64) where the two architectures' values differ or Go's syscall declares it with another value (posix's
  MUSL_ARCH, derived here; `arch?` false: a failure); else the number, the same on both"
  [opts file arch?]
  (let [a (:consts (module-unit opts :amd64 file)) r (:consts (module-unit opts :arm64 file))
        _ (when-not (= (map first a) (map first r)) (fail! file ": amd64's and arm64's constants are not the same names"))
        va (into {} a) vr (into {} r) ga (go-consts opts :amd64) gr (go-consts opts :arm64)]
    (for [n (sort (keys va))
          :let [x (va n) y (vr n) gx (ga n) gy (gr n)]]
      (cond
        (and gx gy (= gx x) (= gy y)) (str "\t{\"" n "\", syscall." n "},\n")
        (or (not= x y) (and gx gy))
        (if arch? (str "\t{\"" n "\", archConst(" x ", " y ")},\n")
            (fail! file ": " n " is " x " on amd64, " y " on arm64, Go's syscall " gx ", " gy ": no archConst in this table"))
        :else (str "\t{\"" n "\", " x "},\n")))))

(defn- table-fcntl-like [opts file module var doc]
  (str "//go:build linux\n\n"
       "// Code generated by tools/pyi/runtime_tables.ae (" (str/replace module #"^_" "") ") from CPython 3.14.10's " module "; DO NOT EDIT.\n\n"
       "package py\n\nimport \"syscall\"\n\n"
       "// " var " are " module "'s integer constants, in name order: syscall's where it declares them.\n"
       "var " var " = []struct {\n\tname string\n\tv    int64\n}{\n"
       (str/join (const-rows opts file false))
       "}\n"))

(defn- table-fcntl [opts] (table-fcntl-like opts "fcntlmodule.c" "fcntl" "fcntlConsts" nil))
(defn- table-socket [opts] (table-fcntl-like opts "socketmodule.c" "_socket" "socketConsts" nil))

;; ---- posix's conf tables and musl's values

(defn- conf-names
  "posixmodule.c's table `arr` (posix_constants_sysconf ...) as preprocessed: {NAME number}"
  [text arr env]
  (let [ts (vec (tokens text))
        i (or (first (keep-indexed (fn [i t] (when (and (= t arr) (= (get ts (inc i)) "[")) i)) ts)) (fail! "no table " arr))
        j (+ i 5)]                      ; arr [ ] = { then the entries
    (when-not (= (ts (dec j)) "{") (fail! arr ": not a table"))
    (loop [k j out {}]
      (cond
        (= (ts k) "}") (if (= (ts (inc k)) ";") out (recur (inc k) out))
        (= (ts k) "{") (let [end (loop [m (inc k)] (if (= (ts m) "}") m (recur (inc m))))
                             [nm _ & e] (subvec ts (inc k) end)]
                         (recur (inc end) (assoc out (c-string [nm]) (or (c-eval e env) (fail! arr ": " nm)))))
        :else (recur (inc k) out)))))

(defn- musl-table
  "musl's src/conf/FILE's values[] (designated initializers by _SC_ or _PC_ number), each value as a short: {number value}"
  [opts goarch sys file extra]
  (let [f (str (:musl opts) "/src/conf/" file)
        heads (str/join "\n" (filter #(re-find #"^#include <" %) (lines f)))
        defs (str/join "\n" (filter #(re-find #"^#define (JT|VER|RLIM)" %) (lines f)))
        body (-> (region f #"static const short values\[\] = \{" #"^\t\};")
                 (str/replace #"(?m)^\t\t\[([A-Z_0-9]+)\] = (.*?),?\s*(/\*.*\*/)?$" "__pyv__($1, $2)"))
        t (preprocess opts goarch sys (str file "-" (name goarch) ".c") (str "#define _GNU_SOURCE 1\n" heads "\n" extra "\n" defs "\n" body))
        env (assoc (enumerators t) ::sizeof (sizeof-fn t))]
    (into {} (for [[k e] (markers (tokens t) "__pyv__")]
               [(c-eval k env) ((cast-fn ["short"]) (or (c-eval e env) (fail! file ": " (str/join " " e))))]))))

(def ^:private sysconf-dynamic
  "sysconf's values musl computes at run time (rlimits, the machine, the auxiliary vector): computed by pyi, as posix_table.py's
  DYNAMIC"
  #{"SC_ARG_MAX" "SC_AVPHYS_PAGES" "SC_CHILD_MAX" "SC_NPROCESSORS_CONF" "SC_NPROCESSORS_ONLN" "SC_OPEN_MAX" "SC_PHYS_PAGES"
    "SC_PAGESIZE" "SC_PAGE_SIZE" "SC_MINSIGSTKSZ"})

(defn- table-posix [opts]
  (let [rows (const-rows opts "posixmodule.c" true)
        per (for [ga [:amd64 :arm64]]
              (let [{:keys [text env sys]} (module-unit opts ga "posixmodule.c")
                    sc (conf-names text "posix_constants_sysconf" env)
                    pc (conf-names text "posix_constants_pathconf" env)
                    cs (conf-names text "posix_constants_confstr" env)
                    ;; musl's sysconf(): values[name] >= -1 itself, else by its switch on the low byte (JT's codes)
                    sv (musl-table opts ga sys "sysconf.c" "")
                    num (fn [nm] (let [t (preprocess opts ga sys (str "num-" nm "-" (name ga) ".c")
                                                     (str "#define _GNU_SOURCE 1\n#include <unistd.h>\n#include <limits.h>\n"
                                                          "#include <mqueue.h>\n#include <semaphore.h>\n#include <signal.h>\n__pyh__(\"x\", " nm ")\n"))]
                                   (second (first (values t "__pyh__")))))
                    jt (fn [v] (case (long (bit-and v 255))
                                 1 :ver 3 :mq 4 :page 5 :sem 10 :zero 11 :delay nil))
                    sysconf (fn [k]
                              (let [n (sc k) v (sv n)]
                                (cond (or (nil? v) (zero? (long v))) (fail! "sysconf " k ": EINVAL")
                                      (>= (long v) -1) v
                                      (< (long v) -256) (fail! "sysconf " k ": an rlimit, not static")
                                      :else (let [c (jt v)]
                                              (case c
                                                :ver (num "_POSIX_VERSION") :mq (num "MQ_PRIO_MAX") :page (num "PAGE_SIZE")
                                                :sem (num "SEM_VALUE_MAX") :delay (num "DELAYTIMER_MAX") :zero 0
                                                (fail! "sysconf " k ": computed at run time (" v ")"))))))
                    pv (musl-table opts ga sys "fpathconf.c" "")
                    confstr (fn [n] (let [cs-v6 (num "_CS_POSIX_V6_ILP32_OFF32_CFLAGS")]
                                      (cond (zero? (long n)) "/bin:/usr/bin"
                                            (or (= 1 (bit-and n (bit-not 4))) (<= 0 (- n cs-v6) 35)) ""
                                            :else nil)))]
                {:sc sc :pc pc :cs cs
                 :static (into {} (for [k (keys sc) :when (not (sysconf-dynamic k))] [k (sysconf k)]))
                 :paths (into {} (for [[k n] pc] [k (or (pv n) (fail! "pathconf " k ": EINVAL"))]))
                 :confs (into {} (for [[k n] cs] [k (confstr n)]))}))
        [x y] per
        _ (when-not (= x y) (fail! "posix: amd64's and arm64's conf tables differ"))
        {:keys [sc pc cs static paths confs]} x
        names (fn [var d doc] (str "// " doc "\nvar " var " = []struct {\n\tname string\n\tv    int\n}{\n"
                                   (str/join (for [k (sort (keys d))] (str "\t{\"" k "\", " (d k) "},\n"))) "}\n\n"))
        by-num (fn [m d] (let [seen (atom #{})]
                           (str/join (for [k (sort-by (fn [k] [(long (d k)) k]) (keys m))
                                           :when (not (@seen (d k)))]
                                       (do (swap! seen conj (d k)) (str "\t" (d k) ": " (m k) ", // " k "\n"))))))]
    (str "//go:build linux\n\n"
         "// Code generated by tools/pyi/runtime_tables.ae (posix) from CPython 3.14.10's posix; DO NOT EDIT.\n\n"
         "package py\n\nimport (\n\t\"runtime\"\n\t\"syscall\"\n)\n\n"
         "// posixConsts are posix's integer constants, in name order.\n"
         "var posixConsts = []struct {\n\tname string\n\tv    int64\n}{\n"
         (str/join rows) "}\n\n"
         "// archConst is musl's value of a constant on amd64 or arm64.\n"
         "func archConst(amd64, arm64 int64) int64 {\n\tif runtime.GOARCH == \"amd64\" {\n\t\treturn amd64\n\t}\n\treturn arm64\n}\n\n"
         (names "sysconfNames" sc "sysconfNames are os.sysconf_names (musl's _SC_ numbers).")
         (names "confstrNames" cs "confstrNames are os.confstr_names.")
         (names "pathconfNames" pc "pathconfNames are os.pathconf_names.")
         "// sysconfStatic are musl's sysconf values of its static table (by _SC_ number), the dynamic ones computed.\n"
         "var sysconfStatic = map[int]int64{\n" (by-num static sc) "}\n\n"
         "// pathconfStatic are musl's fpathconf values (a static table: the same for every file).\n"
         "var pathconfStatic = map[int]int64{\n" (by-num paths pc) "}\n\n"
         "// confstrValues are musl's confstr values; absent: EINVAL.\n"
         "var confstrValues = map[int]string{\n"
         (str/join (for [k (sort (keys confs)) :when (some? (confs k))] (str "\t" (cs k) ": \"" (confs k) "\", // " k "\n")))
         "}\n")))

;; ---- slotdocs (queue 350, audit 344's DECISION 1 (a)): the slot wrappers' __doc__, slotdocs.go's slotDocs (recorded by python3 -I -B
;; from CPython's own wrapper_descriptors), made from Objects/typeobject.c: its slotdefs table preprocessed with its own slot macros
;; (BINSLOT's and the others' doc composition), TPSLOT, FLSLOT and ETSLOT, which every other one expands to, as markers; by
;; add_operators' rule an entry without a wrapper makes no wrapper_descriptor (__getattr__, __new__); its __doc__ is
;; _PyType_GetDocFromInternalDoc's (find_signature, skip_signature: the text after the signature's ")\n--\n\n", unless a blank line
;; comes first; an empty one none); a name's doc the last entry's with a wrapper (they differ only for __iadd__ and __imul__, where the
;; sequence slot's is the one the built-in types that define them fill: list, bytearray, collections.deque, array.array)

(defn- doc-without-signature
  "_PyType_DocWithoutSignature(name, doc): doc after its introspection signature, or doc itself"
  [^String nm ^String doc]
  (if-not (and (str/starts-with? doc nm) (= \( (get doc (count nm))))
    doc
    (loop [i (count nm)]
      (cond (>= i (count doc)) doc
            (.startsWith doc ")\n--\n\n" (int i)) (subs doc (+ i 6))
            (.startsWith doc "\n\n" (int i)) doc
            :else (recur (inc i))))))

(defn- table-slotdocs [opts]
  (let [f (str (:cpython opts) "/Objects/typeobject.c")
        unit (str (region f #"^#define TPSLOT\(" #"^static pytype_slotdef slotdefs\[\] = \{")
                  "\n#undef TPSLOT\n#undef FLSLOT\n#undef ETSLOT\n"
                  "#define TPSLOT(NAME, SLOT, FUNCTION, WRAPPER, DOC) __pys__(#NAME, WRAPPER, DOC)\n"
                  "#define FLSLOT(NAME, SLOT, FUNCTION, WRAPPER, DOC, FLAGS) __pys__(#NAME, WRAPPER, DOC)\n"
                  "#define ETSLOT(NAME, SLOT, FUNCTION, WRAPPER, DOC) __pys__(#NAME, WRAPPER, DOC)\n"
                  (region f #"^static pytype_slotdef slotdefs\[\] = \{" #"^\};") "\n};\n")
        ents (markers (tokens (preprocess opts :amd64 [] "slotdefs.c" unit)) "__pys__")
        _ (when (< (count ents) 80) (fail! "slotdocs: " (count ents) " slotdefs entries, fewer than 80"))
        docs (reduce (fn [m [nm wrapper doc]]
                       (let [nm (c-string nm)]
                         (if (or (= wrapper ["NULL"]) (= doc ["NULL"]))
                           m
                           (let [d (doc-without-signature nm (c-string doc))]
                             (if (empty? d) m (assoc m nm d))))))
                     (sorted-map) ents)]
    (str "package py\n\n"
         "// slotDocs are the __doc__ strings of the slot wrappers (typeobject.c's slotdefs), by name; made by tools/pyi/runtime_tables.ae\n"
         "// from CPython 3.14.10's Objects/typeobject.c: add_operators' entries with a wrapper, the last per name (queue 350).\n"
         "var slotDocs = map[string]string{\n"
         (str/join (for [[k v] docs] (str "\t\"" k "\": " (str/replace (go-quote v) "\n" "\\n") ",\n")))
         "}\n")))

;; ---- ast (queue 350, audit 344's DECISION 1 (a)): the _ast module's node table, builtins_ast_table.go's astTable (asdl_table.py's,
;; python3 running CPython's own Parser/asdl.py), from Parser/Python.asdl by ASDL's grammar (asdl.py's parser: `module NAME { DEF* }`, a
;; DEF `NAME = PRODUCT` with `( FIELDS ) [attributes ( FIELDS )]` or `NAME = CON | CON ... [attributes ( FIELDS )]`, a CON `NAME [( FIELDS )]`,
;; a field `TYPE [?|*]... NAME` (the last quantifier decides), `--` to the line's end a comment); the release in the header from Include/patchlevel.h's PY_VERSION.
;; The table's format, a line each:
;;   sum NAME ATTRIBUTES          an abstract node class (expr, stmt ...), its _attributes
;;   con NAME BASE FIELDS         a constructor of a sum type (BASE), its _fields
;;   pro NAME FIELDS ATTRIBUTES   a product type (arguments, keyword ...)
;; FIELDS and ATTRIBUTES: comma-separated name:type:q (q: "" one, "?" optional, "*" sequence), "-" when none. Since queue 366 the header
;; names this generator (before, tools/pyi/asdl_table.py, the oracle's, whose output now differs from the committed file in its first line)

(defn- asdl-tokens [^String text]
  (re-seq #"[A-Za-z_][A-Za-z0-9_]*|[=|(),?*{}]" (str/replace text #"--[^\n]*" "")))

(defn- asdl-fields
  "The fields at ts (after its `(`) up to the `)`: [[[name type q] ...] rest]"
  [ts]
  (loop [ts ts out []]
    (let [[ty & ts] ts
          ;; asdl.py's quantifiers: any number of ? and *, the last one deciding (Dict's expr?* keys a sequence)
          qs (take-while #{"?" "*"} ts) ts (drop (count qs) ts) q (or (last qs) "")
          [nm sep & ts] ts
          out (conj out [nm ty q])]
      (case sep "," (recur ts out) ")" [out ts] (fail! "ASDL: a field list ends at " sep)))))

(defn- asdl-defs [text]
  (let [ts (asdl-tokens text)
        _ (when-not (and (= "module" (first ts)) (= "{" (nth ts 2))) (fail! "ASDL: no module"))
        attrs (fn [ts] (if (= "attributes" (first ts))
                         (do (when-not (= "(" (second ts)) (fail! "ASDL: attributes without (")) (asdl-fields (drop 2 ts)))
                         [[] ts]))]
    (loop [ts (drop 3 ts) out []]
      (if (= "}" (first ts))
        out
        (let [[nm eq & ts] ts]
          (when-not (= "=" eq) (fail! "ASDL: " nm " without ="))
          (if (= "(" (first ts))
            (let [[fs ts] (asdl-fields (rest ts)) [as ts] (attrs ts)]
              (recur ts (conj out [:pro nm fs as])))
            (let [[cons ts] (loop [ts ts cons []]
                              (let [[cn & ts] ts
                                    [fs ts] (if (= "(" (first ts)) (asdl-fields (rest ts)) [[] ts])
                                    cons (conj cons [cn fs])]
                                (if (= "|" (first ts)) (recur (rest ts) cons) [cons ts])))
                  [as ts] (attrs ts)]
              (recur ts (conj out [:sum nm cons as])))))))))

(defn- table-ast [opts]
  (let [py (:cpython opts)
        fields (fn [fs] (if (empty? fs) "-" (str/join "," (for [[n t q] fs] (str n ":" t ":" q)))))
        lines (mapcat (fn [[k nm a b]]
                        (if (= k :pro)
                          [(str "pro " nm " " (fields a) " " (fields b))]
                          (cons (str "sum " nm " " (fields b)) (for [[cn fs] a] (str "con " cn " " nm " " (fields fs))))))
                      (asdl-defs (slurp (str py "/Parser/Python.asdl"))))
        version (or (second (re-find #"#define\s+PY_VERSION\s+\"([0-9.]+)" (slurp (str py "/Include/patchlevel.h")))) (fail! "no PY_VERSION"))]
    (str "// Code generated by tools/pyi/runtime_tables.ae (ast) from CPython " version "'s Parser/Python.asdl; DO NOT EDIT.\n\n"
         "package py\n\n"
         "// astTable is the _ast module's node classes (PY6a): see tools/pyi/runtime_tables.ae (ast) for the format.\n"
         "const astTable = `" (str/join "\n" lines) "\n`\n")))

;; ---- bytecode, bytecode315 (queue 357, D350-1 (a)): pyi's view of CPython's bytecode, bytecode_table.go and bytecode_table315.go
;; (bytecode_table.py's, python3 over the same headers): Include/opcode_ids.h's real and pseudo opcodes that are not specializations
;; (_PyOpcode_Deopt maps them to themselves) nor instrumented, _PyOpcode_Caches, _PyOpcode_num_popped's and _num_pushed's cases (a
;; case followed by its return); 315: 3.15.2's tree (--cpython315) mapped onto 3.14's constants, an opcode 3.14 has not 1000 plus
;; its number. The generator's rules are bytecode_table.py's, regular expression for regular expression

(defn- ordered
  "[k v] pairs as Python's dict of them keeps them: each key at its first place, its last value"
  [kvs]
  (let [m (reduce (fn [m [k v]] (assoc m k v)) {} kvs)]
    (for [k (distinct (map first kvs))] [k (m k)])))

(defn- bc-section [^String meta ^String head]
  (let [i (or (str/index-of meta head) (fail! "bytecode: no " head)) j (str/index-of meta "};" i)] (subs meta i j)))

(defn- bc-table [top]
  (let [ids (slurp (str top "/Include/opcode_ids.h"))
        meta (slurp (str top "/Include/internal/pycore_opcode_metadata.h"))
        ops (ordered (for [[_ k v] (re-seq #"(?m)#define ([A-Z_0-9]+) +(\d+)$" ids)
                           :when (not (#{"HAVE_ARGUMENT" "MIN_SPECIALIZED_OPCODE" "MIN_INSTRUMENTED_OPCODE"} k))]
                       [k (Long/parseLong v)]))
        ops (remove #(str/starts-with? (first %) "INSTRUMENTED_") ops)
        deopt (into {} (map (fn [[_ a b]] [a b]) (re-seq #"\[([A-Z_0-9]+)\] = ([A-Z_0-9]+)," (bc-section meta "_PyOpcode_Deopt[256] = {"))))
        keep (filter (fn [[k _]] (= k (get deopt k k))) ops)
        caches (ordered (map (fn [[_ a b]] [a b]) (re-seq #"\[([A-Z_0-9]+)\] = (\d+)," (bc-section meta "_PyOpcode_Caches[256] = {"))))
        effects (fn [nm] (let [h (str "int " nm "(int opcode, int oparg)  {")
                               i (or (str/index-of meta h) (fail! "bytecode: no " nm))
                               x (subs meta i) x (subs x 0 (str/index-of x "default:"))]
                           (into {} (map (fn [[_ a b]] [a b]) (re-seq #"case ([A-Z_0-9]+):\n\s+return (.*?);" x)))))]
    {:keep (vec (sort-by second keep)) :caches caches :popped (effects "_PyOpcode_num_popped") :pushed (effects "_PyOpcode_num_pushed")}))

(defn- bc-switch [keep fn-name table]
  (let [by (reduce (fn [m [k _]] (if-let [e (table k)] (update m e (fnil conj []) (str "bc" k)) m)) {} keep)]
    (str "func " fn-name "(op, oparg int) int {\n\tswitch op {\n"
         (str/join (for [[e ks] (sort-by key by)] (str "\tcase " (str/join ", " ks) ":\n\t\treturn " e "\n")))
         "\t}\n\treturn 0\n}\n\n")))

(defn- table-bytecode [opts]
  (let [{:keys [keep caches popped pushed]} (bc-table (:cpython opts))]
    (str "// Code generated by tools/pyi/bytecode_table.py from CPython 3.14.10's opcode_ids.h and pycore_opcode_metadata.h; DO NOT EDIT.\n\n"
         "package py\n\n// CPython 3.14's opcodes, the specializations left out.\nconst (\n"
         (str/join (for [[k v] keep] (str "\tbc" k " = " v "\n")))
         ")\n\n// bcCaches is _PyOpcode_Caches: each opcode's inline cache entries.\nvar bcCaches = map[int]int{"
         (str/join ", " (for [[k v] caches] (str "bc" k ": " v)))
         "}\n\n// bcNames are the opcodes' names.\nvar bcNames = map[int]string{"
         (str/join ", " (for [[k _] keep] (str "bc" k ": \"" k "\"")))
         "}\n\n"
         (bc-switch keep "bcPopped" popped) (bc-switch keep "bcPushed" pushed))))

(defn- table-bytecode315 [opts]
  (let [top (or (:cpython315 opts) (fail! "bytecode315: no --cpython315"))
        sfx "315"
        pl (slurp (str top "/Include/patchlevel.h"))
        release (str/join "." (for [k ["MAJOR" "MINOR" "MICRO"]]
                                (or (second (re-find (re-pattern (str "#define PY_" k "_VERSION\\s+(\\d+)")) pl)) (fail! "no PY_" k "_VERSION"))))
        {:keys [keep caches popped pushed]} (bc-table top)
        known (set (map first (:keep (bc-table (:cpython opts)))))
        new (remove #(known (first %)) keep)]
    (str "// Code generated by tools/pyi/bytecode_table.py --suffix " sfx " from CPython " release "'s opcode_ids.h and pycore_opcode_metadata.h; DO NOT EDIT.\n\n"
         "package py\n\n"
         (when (seq new)
           (str "// The opcodes CPython " release " adds to 3.14's (pyi's view never emits them): 1000 plus their number.\nconst (\n"
                (str/join (for [[k v] new] (str "\tbc" k " = " (+ 1000 v) "\n"))) ")\n\n"))
         "// bcNum" sfx " is each opcode's number in CPython " release ", by pyi's constant (an opcode absent from " release " has none).\nvar bcNum" sfx " = map[int]int{"
         (str/join ", " (for [[k v] keep] (str "bc" k ": " v)))
         "}\n\n// bcCaches" sfx " is _PyOpcode_Caches: each opcode's inline cache entries.\nvar bcCaches" sfx " = map[int]int{"
         (str/join ", " (for [[k v] caches] (str "bc" k ": " v)))
         "}\n\n// bcNames" sfx " are the opcodes' names.\nvar bcNames" sfx " = map[int]string{"
         (str/join ", " (for [[k _] keep] (str "bc" k ": \"" k "\"")))
         "}\n\n"
         (bc-switch keep (str "bcPopped" sfx) popped) (bc-switch keep (str "bcPushed" sfx) pushed))))

;; ---- stat (queue 357, D350-1 (a)): _stat's integer constants, builtins_stat_table.go's statConsts (before: recorded from the oracle,
;; CPython 3.14.10 on musl, in builtins_stat.go), from Modules/_stat.c preprocessed against musl 1.2.6's headers with configure's
;; header answers: stat_exec's PyModule_AddIntConstant calls (ADD_INT_MACRO's), the ST_ indexes of its st_constants array

(defn- stat-consts [opts goarch]
  (let [sys (sysroot opts goarch)
        f (str (:cpython opts) "/Modules/_stat.c")
        src (str/replace (slurp f) #"(?m)^\s*#\s*include\s+\"[^\"]*\".*$" "")
        t (preprocess opts goarch sys (str "stat-" (name goarch) ".c")
                      (str (have-headers opts sys)
                           "#define PyModule_AddIntConstant(m, name, value) __pyc__(name, value)\n" src))
        ms (markers (tokens t) "__pyc__")
        named (for [[nm e] ms :when (str/starts-with? (first nm) "\"")]
                [(c-string nm) (or (c-eval e {}) (fail! "stat: " (c-string nm) "'s value is no constant"))])
        st (map c-string (map vector (re-seq #"\"ST_[A-Z]+\"" (region f #"const char\* st_constants\[\] = \{" #"^\s*\};"))))]
    (when (empty? st) (fail! "stat: no st_constants"))
    (into (sorted-map) (concat named (map-indexed (fn [i n] [n i]) st)))))

(defn- table-stat [opts]
  (let [a (stat-consts opts :amd64) r (stat-consts opts :arm64)]
    (when-not (= a r) (fail! "stat: amd64's and arm64's constants differ"))
    (str "// Code generated by tools/pyi/runtime_tables.ae stat from CPython 3.14.10's Modules/_stat.c over musl 1.2.6's headers; DO NOT EDIT.\n\n"
         "package py\n\n"
         "// statConsts are _stat's integer constants (stat_exec's), the same on amd64 and arm64.\n"
         "var statConsts = map[string]int64{\n"
         (str/join (for [[k v] a] (str "\t\"" k "\": " v ",\n")))
         "}\n")))

;; ---- cjk (queue 357, D350-1 (a)): the CJK codecs' mapping tables, builtins_cjk_table.go (cjkcodecs_table.py's, python3 over the same
;; headers), from Modules/cjkcodecs/mappings_*.h: each header's arrays as it spells them (data arrays, the 256-entry indexes as
;; OFFSET+1 bottom top, struct arrays field by field), packed as cjkcodecs_table.py's records, zlib level 9 by jrt's Deflater (zlib's
;; deflate ported), base64; the rules cjkcodecs_table.py's, regular expression for regular expression

(def ^:private cjk-headers [["CN" "mappings_cn.h"] ["HK" "mappings_hk.h"] ["JP" "mappings_jp.h"] ["JP2" "mappings_jisx0213_pair.h"]
                            ["KR" "mappings_kr.h"] ["TW" "mappings_tw.h"]])
(def ^:private cjk-macros {"U" 0xFFFE "N" 0xFFFF "M" 0xFFFE "D" 0xFFFD})
(def ^:private cjk-width {"ucs2_t" 2 "DBCHAR" 2 "Py_UCS4" 4 "unsigned char" 1})
(def ^:private cjk-index #{"struct dbcs_index" "struct widedbcs_index" "struct unim_index"})

(defn- cjk-body
  "The initializer's text from `start` (just after its {) to its closing brace, whitespace removed"
  [^String text start]
  (let [j (loop [depth 1 j (long start)]
            (if (zero? depth) j
                (let [c (.charAt text j)] (recur (case c \{ (inc depth) \} (dec depth) depth) (inc j)))))]
    (str/replace (subs text start (dec j)) #"\s+" "")))

(defn- cjk-num [^String t]
  (or (cjk-macros t)
      (cond (re-matches #"0[xX][0-9a-fA-F]+" t) (Long/parseLong (subs t 2) 16)
            (re-matches #"[0-9]+" t) (Long/parseLong t)
            :else (fail! "cjk: no number " t))))

(defn- cjk-records [^String text hname]
  (let [text (if (str/includes? text "#ifdef EXTERN_JISX0213_PAIR")
               (subs text (str/index-of text "#else") (str/index-of text "#endif")) text)
        m (re-matcher #"(?ms)^static const (ucs2_t|DBCHAR|Py_UCS4|unsigned char|struct \w+(?: \{[^}]*\})?) (\w+)\[(\w*)\] = \{" text)]
    (loop [out []]
      (if-not (.find m)
        out
        (let [ctype (.group m 1) nm (.group m 2) size (.group m 3) b (cjk-body text (.end m))]
          (recur
           (conj out
                 (cond
                   (cjk-width ctype)
                   (let [vals (mapv cjk-num (str/split (str/replace b #",$" "") #","))]
                     (when (and (seq size) (re-matches #"\d+" size) (not= (count vals) (Long/parseLong size)))
                       (fail! hname " " nm ": " (count vals) " values, declared " size))
                     ["d" nm "" (cjk-width ctype) vals])
                   (cjk-index ctype)
                   (let [ents (map second (re-seq #"\{([^{}]*)\}" b))
                         _ (when-not (and (= 256 (count ents)) (= size "256")) (fail! hname " " nm ": not 256 entries"))
                         [base vals] (reduce (fn [[base vals] e]
                                               (let [[p lo hi] (str/split e #",")]
                                                 (if (= p "0")
                                                   (do (when-not (and (= lo "0") (= hi "0")) (fail! nm " " e)) [base (conj vals 0 0 0)])
                                                   (let [[_ bn off] (or (re-matches #"(\w+)\+(\d+)" p) (fail! nm " " e))]
                                                     (when (and base (not= base bn)) (fail! nm ": two bases"))
                                                     [bn (conj vals (inc (Long/parseLong off)) (Long/parseLong lo) (Long/parseLong hi))]))))
                                             [nil []] ents)]
                     ["i" nm (or base "") 4 vals])
                   :else ["s" nm "" 4 (vec (for [e (map second (re-seq #"\{([^{}]*)\}" b)) t (str/split e #",")] (cjk-num t)))]))))))))

(defn- cjk-pack ^bytes [recs]
  (let [o (java.io.ByteArrayOutputStream.)
        le (fn [^long v ^long w] (dotimes [i w] (.write o (int (bit-and (bit-shift-right v (* 8 i)) 0xff)))))]
    (doseq [[kind nm base width vals] recs]
      (.write o (int (first (.getBytes ^String kind "UTF-8"))))
      (.write o (int (count nm))) (doseq [b (.getBytes ^String nm "UTF-8")] (.write o (int b)))
      (.write o (int (count base))) (doseq [b (.getBytes ^String base "UTF-8")] (.write o (int b)))
      (.write o (int width)) (le (count vals) 4)
      (doseq [v vals] (le v width)))
    (.toByteArray o)))

(defn- zlib9 ^bytes [^bytes in]
  (let [d (java.util.zip.Deflater. 9) o (java.io.ByteArrayOutputStream.) buf (byte-array 65536)]
    (.setInput d in) (.finish d)
    (loop [] (when-not (.finished d) (let [n (.deflate d buf)] (.write o buf 0 n)) (recur)))
    (.end d)
    (.toByteArray o)))

(defn- table-cjk [opts]
  (let [dir (str (:cpython opts) "/Modules/cjkcodecs/")
        done (for [[loc h] cjk-headers
                   :let [text (slurp (str dir h)) recs (cjk-records text h)
                         names (set (map second recs))]]
               (do (doseq [[k nm base] recs] (when (and (= k "i") (not (names base))) (fail! h " " nm ": no base " base)))
                   {:loc loc :h h :recs recs :text text}))
        pairs (let [jp2 (first (filter #(= "JP2" (:loc %)) done))
                    n (Long/parseLong (or (second (re-find #"#define JISX0213_ENCPAIRS (\d+)" (:text jp2))) (fail! "no JISX0213_ENCPAIRS")))]
                (when-not (= (* 2 n) (count (nth (first (filter #(= "jisx0213_pair_encmap" (second %)) (:recs jp2))) 4)))
                  (fail! "cjk: jisx0213_pair_encmap is not 2 x JISX0213_ENCPAIRS"))
                n)
        summary (for [{:keys [loc h recs]} done]
                  (str loc " " h " " (str/join " " (for [[k nm _ _ vals] recs] (str k ":" nm ":" (count vals))))))]
    (str "// Code generated by tools/pyi/cjkcodecs_table.py from CPython 3.14.10's Modules/cjkcodecs/mappings_*.h;\n"
         "// DO NOT EDIT.\n\n"
         "package py\n\n"
         "// The CJK codecs' mapping tables (PY6c2): see tools/pyi/cjkcodecs_table.py for the format.\n\n"
         "// cjkPairCount is mappings_jisx0213_pair.h's JISX0213_ENCPAIRS.\n"
         "const cjkPairCount = " pairs "\n\n"
         "// cjkTableArrays: each blob's header and its arrays (KIND:NAME:ELEMENTS).\n"
         "const cjkTableArrays = `" (str/join "\n" summary) "\n`\n"
         (str/join (for [{:keys [loc h recs]} done]
                     (str "\n// cjkBlob" loc " is " h "'s arrays.\n"
                          "const cjkBlob" loc " = \"" (.encodeToString (java.util.Base64/getEncoder) (zlib9 (cjk-pack recs))) "\"\n"))))))

;; ---- unicodedata, unicodedata315 (queue 357, D350-1 (a)): the Unicode database's tables, builtins_unicodedata_table.go and its 315
;; variant (unicodedata_table.py's, python3 over the same headers), from the tarball's Objects/unicodetype_db.h, Modules/unicodedata_db.h
;; and Modules/unicodename_db.h (3.14.10's, 3.15.2's with --cpython315: its records' first six fields, every name with the suffix):
;; the arrays as the headers spell them packed as unicodedata_table.py's records, zlib level 9 by jrt's Deflater, base64; the switch
;; functions' cases, the name tables, the constants; the rules unicodedata_table.py's, regular expression for regular expression

(def ^:private ucd-arrays
  [["ctypeRecords" :type "_PyUnicode_TypeRecords" 4 true "upper lower title decimal digit flags" nil]
   ["ctypeExtendedCase" :type "_PyUnicode_ExtendedCase" 4 false "" nil]
   ["ctypeIndex1" :type "index1" 2 false "" nil]
   ["ctypeIndex2" :type "index2" 2 false "" nil]
   ["dbRecords" :data "_PyUnicode_Database_Records" 1 false "category combining bidirectional mirrored east_asian_width normalization_quick_check" nil]
   ["nfcFirst" :data "nfc_first" 4 false "start count index" nil]
   ["nfcLast" :data "nfc_last" 4 false "start count index" nil]
   ["dbIndex1" :data "index1" 2 false "" nil]
   ["dbIndex2" :data "index2" 2 false "" nil]
   ["decompData" :data "decomp_data" 4 false "" nil]
   ["decompIndex1" :data "decomp_index1" 1 false "" nil]
   ["decompIndex2" :data "decomp_index2" 2 false "" nil]
   ["compIndex" :data "comp_index" 2 false "" nil]
   ["compData" :data "comp_data" 4 false "" nil]
   ["changes320Index" :data "changes_3_2_0_index" 1 false "" nil]
   ["changes320Data" :data "changes_3_2_0_data" 1 false "" nil]
   ["packedNameDawg" :name "packed_name_dawg" 1 false "" nil]
   ["dawgPosToCodepoint" :name "dawg_pos_to_codepoint" 4 false "" nil]
   ["dawgCodepointToPosIndex1" :name "dawg_codepoint_to_pos_index1" 1 false "" nil]
   ["dawgCodepointToPosIndex2" :name "dawg_codepoint_to_pos_index2" 2 false "" nil]
   ["nameAliases" :name "name_aliases" 4 false "" nil]
   ["namedSequences" :name "named_sequences" 4 false "seqlen seq0 seq1 seq2 seq3" 4]
   ["derivedNameRanges" :name "derived_name_ranges" 4 false "first last prefixid" nil]])

(defn- ucd-array-body [^String text nm]
  (let [m (re-matcher (re-pattern (str "\\b" (java.util.regex.Pattern/quote nm) "\\[\\] = \\{")) text)]
    (when-not (.find m) (fail! "unicodedata: no array " nm))
    (let [i (.end m)
          j (loop [depth 1 j i] (if (zero? depth) j (let [c (.charAt text j)] (recur (case c \{ (inc depth) \} (dec depth) depth) (inc j)))))]
      (subs text i (dec j)))))

(defn- py-int
  "Python's int(v, 0) of a C literal: [-]0xHEX or [-]DECIMAL"
  [^String v]
  (let [neg (str/starts-with? v "-") u (if neg (subs v 1) v)
        n (if (re-matches #"0[xX][0-9A-Fa-f]+" u) (Long/parseLong (subs u 2) 16) (Long/parseLong u))]
    (if neg (- n) n)))

(defn- ucd-ints [^String text nm pad]
  (let [b (ucd-array-body text nm)]
    (if (nil? pad)
      (mapv py-int (re-seq #"-?0x[0-9A-Fa-f]+|-?\d+" b))
      (vec (mapcat (fn [[_ a inner]]
                     (let [sq (map py-int (re-seq #"0x[0-9A-Fa-f]+|\d+" inner))]
                       (concat [(py-int a)] sq (repeat (- pad (count sq)) 0))))
                   (re-seq #"\{\s*(-?\w+)\s*,\s*\{([^}]*)\}\s*\}" b))))))

(defn- ucd-strings [text nm] (mapv second (re-seq #"\"((?:[^\"\\]|\\.)*)\"" (ucd-array-body text nm))))

(defn- ucd-define [text nm]
  (or (second (re-find (re-pattern (str "#define " nm " (\\S+)")) text)) (fail! "unicodedata: no #define " nm)))

(defn- ucd-scalar [text nm]
  (or (second (re-find (re-pattern (str "\\b" nm " = (\\w+);")) text)) (fail! "unicodedata: no " nm)))

(defn- ucd-switch
  "A switch function's cases: [[codes expr] ...], the default last with no codes"
  [^String text func]
  (let [m (re-matcher (re-pattern (str (java.util.regex.Pattern/quote func) "\\([^)]*\\)\\s*\\{")) text)
        _ (when-not (.find m) (fail! "unicodedata: no function " func))
        body (subs text (.end m) (str/index-of text "\n}\n" (.end m)))]
    (loop [ls (map str/trim (str/split body #"\n" -1)) codes [] out []]
      (if-let [l (first ls)]
        (let [codes (into codes (map #(Long/parseLong (subs (second %) 2) 16) (re-seq #"case (0x[0-9A-Fa-f]+):" l)))]
          (if-let [[_ e] (re-find #"return (.*);" l)]
            (recur (rest ls) [] (conj out [codes e]))
            (recur (rest ls) codes out)))
        out))))

(defn- ucd-text [py sfx]
  (let [release (or (second (re-find #"#define PY_VERSION\s+\"([^\"]+)\"" (slurp (str py "/Include/patchlevel.h")))) (fail! "no PY_VERSION"))
        TYPE (slurp (str py "/Objects/unicodetype_db.h"))
        DATA (slurp (str py "/Modules/unicodedata_db.h"))
        NAME (slurp (str py "/Modules/unicodename_db.h"))
        texts {:type TYPE :data DATA :name NAME}
        hex (fn [n] (str/upper-case (Long/toHexString n)))
        o (java.io.ByteArrayOutputStream.)
        le (fn [^long v ^long w] (dotimes [i w] (.write o (int (bit-and (bit-shift-right v (* 8 i)) 0xff)))))
        counts (vec (for [[go k c width signed fields pad] ucd-arrays
                          :let [text (texts k)
                                vals (if (and (= k :data) (#{"index1" "index2"} c))
                                       (ucd-ints (subs DATA (str/index-of DATA "#define SHIFT 7")) c nil)
                                       (ucd-ints text c pad))
                                nf (if (seq fields) (count (str/split fields #" ")) 1)
                                vals (if (= c "_PyUnicode_Database_Records")
                                       (let [have (count (re-seq #"-?0x[0-9A-Fa-f]+|-?\d+" (second (re-find #"\{([^{}]*)\}" (ucd-array-body DATA c)))))]
                                         (if (not= have nf) (vec (keep-indexed (fn [i v] (when (< (mod i have) nf) v)) vals)) vals))
                                       vals)
                                _ (when-not (zero? (mod (count vals) nf)) (fail! "unicodedata: " c ": " (count vals) " values, not records of " nf))
                                nb (.getBytes (str go sfx) "UTF-8")]]
                      (do (.write o (int (count nb))) (.write o nb 0 (count nb))
                          (.write o (int (bit-or width (if signed 0x80 0)))) (le (count vals) 4)
                          (doseq [v vals] (le v width))
                          [(str go sfx) c (count vals) fields])))
        numeric (sort-by #(Long/parseLong (first (str/split % #" ")) 16)
                         (for [[codes e] (ucd-switch TYPE "_PyUnicode_ToNumeric")
                               :let [e (str/trim (str/replace e "(double)" ""))
                                     [a b] (let [i (str/index-of e "/")] (if i [(subs e 0 i) (subs e (inc i))] [e ""]))
                                     b (str/trim b)]
                               code codes]
                           (str (hex code) " " (str/trim a) " " (if (empty? b) "1" b))))
        caselist (fn [func] (let [cs (ucd-switch TYPE func)]
                              (when-not (and (= "1" (second (first cs))) (= "0" (second (last cs)))) (fail! "unicodedata: " func))
                              (str/join " " (map hex (first (first cs))))))
        norm320 (for [[codes e] (ucd-switch DATA "normalization_3_2_0") code codes]
                  (str (hex code) " " (hex (Long/parseLong (str/replace e #"^0[xX]" "") 16))))
        changes (for [[_ r] (re-seq #"\{([^}]*)\}" (ucd-array-body DATA "change_records_3_2_0"))]
                  (str/join " " (map str/trim (str/split r #","))))
        b64 (.encodeToString (java.util.Base64/getEncoder) (zlib9 (.toByteArray o)))
        goslice (fn [nm vals] (str "var " nm sfx " = []string{" (str/join ", " (for [v vals] (str "\"" v "\""))) "}\n"))
        shift-of (fn [^String t] (nth (str/split (str/trim (subs t (str/index-of t "#define SHIFT"))) #"\s+") 2))
        consts (map (fn [[n v]] [(str n sfx) v])
                    [["ucdVersion" (ucd-define DATA "UNIDATA_VERSION")] ["ctypeShift" (shift-of TYPE)] ["dbShift" (shift-of DATA)]
                     ["decompShift" (ucd-define DATA "DECOMP_SHIFT")] ["compShift" (ucd-define DATA "COMP_SHIFT")]
                     ["totalFirst" (ucd-define DATA "TOTAL_FIRST")] ["totalLast" (ucd-define DATA "TOTAL_LAST")]
                     ["nameMaxlen" (ucd-define NAME "NAME_MAXLEN")]
                     ["dawgCodepointToPosShift" (ucd-define NAME "DAWG_CODEPOINT_TO_POS_SHIFT")]
                     ["dawgCodepointToPosNotFound" (ucd-define NAME "DAWG_CODEPOINT_TO_POS_NOTFOUND")]
                     ["aliasesStart" (ucd-scalar NAME "aliases_start")] ["aliasesEnd" (ucd-scalar NAME "aliases_end")]
                     ["namedSequencesStart" (ucd-scalar NAME "named_sequences_start")] ["namedSequencesEnd" (ucd-scalar NAME "named_sequences_end")]])]
    (str "// Code generated by tools/pyi/unicodedata_table.py from CPython " release "'s Objects/unicodetype_db.h,\n"
         "// Modules/unicodedata_db.h and Modules/unicodename_db.h; DO NOT EDIT.\n\n"
         "package py\n\n"
         "// The Unicode database's tables (PY6c): see tools/pyi/unicodedata_table.py for the format.\n\n"
         "const (\n" (str/join (for [[n v] consts] (str "\t" n " = " v "\n"))) ")\n\n"
         (goslice "ucdCategoryNames" (ucd-strings DATA "_PyUnicode_CategoryNames"))
         (goslice "ucdBidirectionalNames" (ucd-strings DATA "_PyUnicode_BidirectionalNames"))
         (goslice "ucdEastAsianWidthNames" (ucd-strings DATA "_PyUnicode_EastAsianWidthNames"))
         (goslice "ucdDecompPrefix" (ucd-strings DATA "decomp_prefix"))
         (goslice "ucdDerivedNamePrefixes" (ucd-strings NAME "derived_name_prefixes"))
         "\n// ucdArrayFields: each array of ucdBlob, its C name, its elements and its record's fields.\n"
         "const ucdArrayFields" sfx " = `" (str/join "\n" (for [[g c n f] counts] (str g " " c " " n " " (if (seq f) (str/replace f " " ",") "-")))) "\n`\n\n"
         "// ucdNumeric is _PyUnicode_ToNumeric: CODE A B, the value (double) A/B.\n"
         "const ucdNumeric" sfx " = `" (str/join "\n" numeric) "\n`\n\n"
         "// ucdWhitespace and ucdLinebreak are _PyUnicode_IsWhitespace's and _PyUnicode_IsLinebreak's cases.\n"
         "const ucdWhitespace" sfx " = `" (caselist "_PyUnicode_IsWhitespace") "`\n\n"
         "const ucdLinebreak" sfx " = `" (caselist "_PyUnicode_IsLinebreak") "`\n\n"
         "// ucdNormalization320 is normalization_3_2_0: CODE NORMALIZED.\n"
         "const ucdNormalization320" sfx " = `" (str/join "\n" norm320) "\n`\n\n"
         "// ucdChanges320 is change_records_3_2_0: bidir category decimal mirrored east_asian_width numeric.\n"
         "const ucdChanges320" sfx " = `" (str/join "\n" changes) "\n`\n\n"
         "// ucdBlob is the arrays (the format above).\n"
         "const ucdBlob" sfx " = \"" b64 "\"\n")))

(defn- table-unicodedata [opts] (ucd-text (:cpython opts) ""))
(defn- table-unicodedata315 [opts] (ucd-text (or (:cpython315 opts) (fail! "unicodedata315: no --cpython315")) "315"))

;; ---- textsig (queue 357, D350-1 (a)): the built-ins' __text_signature__, builtins_textsig_table.go's textSigs (textsig_table.py's,
;; recorded from CPython's live built-ins), from the tarball's C sources: the reference configuration's modules (Modules/config.c.in's
;; core, Setup.bootstrap.in's and Setup.stdlib.in's, less textsig-excluded) and Objects/, Python/; each file preprocessed by repr/c's
;; preprocessor over musl's and Linux's headers with own-pyconfig's answers (its local headers and clinic's read in place, the others
;; dropped, Include/'s few macros the tables use taken from the tarball's headers), then its PyMethodDef arrays, static PyTypeObjects,
;; PyType_Specs with their slots, and PyModuleDefs read; a callable's signature _PyType_GetTextSignatureFromInternalDoc's over its doc and
;; flags (find_signature, skip_signature, signature_from_flags), a type's over tp_name and tp_doc, a type with its own tp_new also its
;; __new__ (tp_new_wrapper's doc), the slot wrappers' slotdefs' (the last entry per name with a wrapper, as slotdocs)

(def ^:private textsig-excluded
  "Setup.stdlib.in's modules the reference configuration does not build: the tests' (textsig_table.py leaves out _test* and xx*), Tk's
  (textsig_table.py's own exclusion), the libraries the oracle's build had not (zstd, dbm, gdbm, uuid) and macOS's"
  #"^(_test.*|xx.*|_xxtestfuzz|_tkinter|_scproxy|_zstd|_dbm|_gdbm|_uuid)$")

(defn- setup-modules
  "Setup.bootstrap.in's and Setup.stdlib.in's modules: [[NAME [SOURCE.c ...]] ...] (Modules/-relative sources)"
  [py]
  (for [f ["Modules/Setup.bootstrap.in" "Modules/Setup.stdlib.in"]
        l (str/split-lines (slurp (str py "/" f)))
        :let [l (str/trim (str/replace l #"#.*$" ""))]
        :when (and (seq l) (not (str/starts-with? l "*")))
        :let [ws (str/split (str/replace l #"^@[A-Z0-9_]+@" "") #"\s+")
              nm (first ws) srcs (filter #(str/ends-with? % ".c") (rest ws))]
        :when (and (re-matches #"[A-Za-z_][A-Za-z0-9_]*" nm) (seq srcs) (not (re-matches textsig-excluded nm)))]
    [nm srcs (vec (for [w (rest ws) :let [[_ d] (re-matches #"-I\$\(srcdir\)/(.*)" w)] :when d] d))]))

(defn- textsig-modules
  "The reference configuration's module names: Modules/config.c.in's (the core, builtins and sys among them) and Setup's"
  [py]
  (set (concat (map second (re-seq #"\{\"([A-Za-z_][A-Za-z0-9_]*)\"," (slurp (str py "/Modules/config.c.in"))))
               (map first (setup-modules py)))))

(def ^:private configure-cflags
  "configure.ac's defaults of the bundled libraries' include flags (no --with-system-expat, no --with-system-libmpdec): the modules
  whose PY_STDLIB_MOD takes them, and the configure.ac line that states each"
  {"pyexpat" ["LIBEXPAT_CFLAGS=\"-I\\$(srcdir)/Modules/expat\"" "Modules/expat"]
   "_elementtree" ["LIBEXPAT_CFLAGS=\"-I\\$(srcdir)/Modules/expat\"" "Modules/expat"]
   "_decimal" ["[LIBMPDEC_CFLAGS=\"-I\\$(srcdir)/Modules/_decimal/libmpdec\"" "Modules/_decimal/libmpdec"]})

(defn- configure-include-dirs [py nm]
  (when-let [[line dir] (configure-cflags nm)]
    (when-not (str/includes? (slurp (str py "/configure.ac")) line) (fail! "configure.ac: no " line))
    [dir]))

(defn- internal-macros
  "An internal header's preprocessor lines alone (its feature macros under their conditions; its includes and declarations left
  out): pycore_faulthandler.h's FAULTHANDLER_USER and FAULTHANDLER_USE_ALT_STACK for faulthandler.c"
  [^String f]
  (str/join "\n" (for [l (str/split-lines (slurp f)) :when (re-find #"^\s*#\s*(if|ifdef|ifndef|elif|else|endif|define|undef)\b" l)
                       :when (not (re-find #"^\s*#\s*define\s+Py_INTERNAL_" l))] l)))

(defn- textsig-files [py]
  (let [core (concat (for [d ["Objects" "Python"]
                           ^File f (sort-by #(.getName ^File %) (.listFiles (File. (str py "/" d))))
                           :when (and (.isFile f) (str/ends-with? (.getName f) ".c"))]
                       (str d "/" (.getName f)))
                     ["Modules/gcmodule.c"])]
    (distinct (concat core (for [[_ srcs] (setup-modules py) s srcs] (str "Modules/" s))))))

(def ^:private textsig-public-headers
  "Include/'s headers read in place where a module includes them (their macros decide its tables): py_curses.h, the curses modules'
  header (its NCURSES_OPAQUE and its choice of the curses header), the path relative to the tarball's top"
  {"py_curses.h" "Include/py_curses.h"})

(def ^:private textsig-top (atom nil))

(defn- inline-local
  "File f's text with its quoted includes that name a file beside it (or below its directory, or in one of the Setup line's -I
  directories `dirs`) read in place, recursively; the other quoted includes dropped"
  ([^String f seen] (inline-local f seen []))
  ([^String f seen dirs]
   (let [dir (.getParent (File. f))]
     (str/replace (slurp f) #"(?m)^\s*#\s*include\s+\"([^\"]+)\".*$"
                  (fn [[l h]]
                    (let [g (first (filter #(.isFile ^File %) (map #(File. (str % "/" h)) (cons dir dirs))))
                          g (or g (when-let [x (and @textsig-top (textsig-public-headers h))] (let [x (File. (str @textsig-top "/" x))] (when (.isFile x) x))))]
                      (if (and g (not (contains? seen (.getCanonicalPath ^File g))))
                        (inline-local (.getPath ^File g) (conj seen (.getCanonicalPath ^File g)) dirs)
                        "")))))))

(defn- drop-unfound
  "Text's #include <H> lines whose H is on no directory of `sys` dropped (Python's own headers, <Python.h>, and the libraries' headers
  the VM has not: the reference configuration's libffi, ncurses, readline, OpenSSL, sqlite, bzip2, xz, zlib)"
  [text sys]
  (str/replace text #"(?m)^\s*#\s*include\s+<([^>]+)>.*$"
               (fn [[l h]] (if (some #(.isFile (File. (str % "/" h))) sys) l ""))))

(defn- textsig-prelude [py]
  (str (defines (str py "/Include/pymacro.h") #"^(PyDoc_(VAR|STRVAR)|_?Py_X?STRINGIFY)$") "\n#define PyDoc_STR(str) str\n"
       (defines (str py "/Include/methodobject.h") #"^METH_(VARARGS|KEYWORDS|NOARGS|O|CLASS|STATIC|COEXIST|METHOD)$") "\n"
       "#define METH_FASTCALL 0x0080\n#define METH_STACKLESS 0x0000\n"
       ;; Include/object.h's and moduleobject.h's head initializers, one item each (their contents are not read)
       "#define PyVarObject_HEAD_INIT(type, size) { 0 },\n#define PyObject_HEAD_INIT(type) { 0 },\n#define PyModuleDef_HEAD_INIT { 0 }\n"
       "#define _PyCFunction_CAST(func) func\n#define _PyCFunctionWithKeywords_CAST(func) func\n#define Py_UNUSED(name) name\n"
       "#define WITH_DOC_STRINGS 1\n#define Py_BUILD_CORE 1\n"
       (defines (str py "/Include/pyport.h") #"^LONG_BIT$") "\n"
       ;; Include/pythread.h's PY_HAVE_THREAD_NATIVE_ID, its platform condition
       (str/replace (region (str py "/Include/pythread.h") #"^#if \(defined\(__APPLE__\) \|\| defined\(__linux__\)" #"^#endif") #"(?m)^PyAPI_FUNC.*$" "")
       "\n#endif\n"))

(defn- tolerant-preprocess
  "preprocess, its errors kept rather than failed on: [text errors]"
  [opts goarch sys name text]
  (let [f (str (:work opts) "/" name)]
    (.mkdirs (.getParentFile (File. f)))
    (spit f text)
    (let [r (pp/preprocess {:predefined (predefined goarch) :include [] :iquote [] :sys sys :std :gnu17 :has {} :base "."} f)]
      [(pp/text r) (:errors r)])))

(defn- brace-items
  "The items of the initializer at ts[i] = \"{\": [[item-tokens ...] index-after-}], split at its top-level commas"
  [ts i]
  (loop [j (inc i) depth 0 cur [] items []]
    (let [t (get ts j)]
      (cond
        (nil? t) [items j]
        (and (= t "}") (zero? depth)) [(if (seq cur) (conj items cur) items) (inc j)]
        (and (= t ",") (zero? depth)) (recur (inc j) depth [] (conj items cur))
        (#{"(" "[" "{"} t) (recur (inc j) (inc depth) (conj cur t) items)
        (#{")" "]" "}"} t) (recur (inc j) (dec depth) (conj cur t) items)
        :else (recur (inc j) depth (conj cur t) items)))))

(defn- fields-of
  "An initializer's items mapped to `field-names` by C's rule (positional after the last designator): {field item-tokens}"
  [items field-names]
  (loop [items items pos 0 out {}]
    (if-let [it (first items)]
      (if (and (= "." (first it)) (= "=" (nth it 2 nil)))
        (let [f (second it) p (.indexOf ^java.util.List field-names f)]
          (recur (rest items) (if (neg? p) pos (inc p)) (assoc out f (vec (drop 3 it)))))
        (recur (rest items) (inc pos) (if (< pos (count field-names)) (assoc out (nth field-names pos) it) out)))
      out)))

(defn- strip-casts
  "The tokens less their casts' parentheses: (void *)x, (PyCFunction)(void(*)(void))f -> x, f"
  [it]
  (let [it (vec it)]
    (loop [it it]
      (if (and (= "(" (first it)) (some #{")"} it) (< (inc (.indexOf ^java.util.List it ")")) (count it)))
        (recur (subvec it (inc (loop [j 1 d 1] (cond (= d 0) (dec j) (= (it j) "(") (recur (inc j) (inc d)) (= (it j) ")") (recur (inc j) (dec d)) :else (recur (inc j) d))))))
        it))))

(defn- typeobject-fields [py]
  (let [t (slurp (str py "/Include/cpython/object.h"))
        body (subs t (str/index-of t "struct _typeobject {") (str/index-of t "};" (str/index-of t "struct _typeobject {")))
        body (-> body (str/replace #"/\*(?s:.*?)\*/" "") (str/replace #"//[^\n]*" ""))]
    (vec (cons "ob_base" (for [[_ decl] (re-seq #"(?m)^\s+[A-Za-z_][A-Za-z0-9_ ]*?[\s*]+((?:\*?[A-Za-z_][A-Za-z0-9_]*\s*,\s*)*\*?[A-Za-z_][A-Za-z0-9_]*)\s*;" body)
                               n (str/split decl #"\s*,\s*")]
                           (str/replace n "*" ""))))))

(defn- unit-facts
  "One file's tables, preprocessed: {:docs {var text} :methods {array [[name flags doc] ...]} :types [{:name :doc :methods :new?}]
  :slots {array {slot value}} :specs [{:name :slots}] :modules [{:name :methods}]}"
  [ts type-fields]
  (let [ts (vec ts) n (count ts)
        str? (fn [t] (and t (str/starts-with? t "\"")))
        c-string (fn [it] (when (and (seq it) (every? str? it)) (c-string it)))
        doc-of (fn [it docs] (let [it (strip-casts it)]
                               (cond (every? str? it) (when (seq it) (c-string it))
                                     (= 1 (count it)) (docs (first it))
                                     :else nil)))]
    (loop [i 0 out {:docs {} :methods {} :types [] :slots {} :specs [] :modules [] :structseqs [] :inits [] :no-new #{}}]
      (if (>= i n)
        out
        (let [t (ts i)]
          (cond
            ;; static const char NAME[] = "..." ...;
            (and (= t "char") (= (get ts (+ i 2)) "[") (= (get ts (+ i 3)) "]") (= (get ts (+ i 4)) "=") (str? (get ts (+ i 5))))
            (let [j (loop [j (+ i 5)] (if (str? (get ts j)) (recur (inc j)) j))]
              (recur j (assoc-in out [:docs (ts (inc i))] (c-string (subvec ts (+ i 5) j)))))
            (and (= t "PyMethodDef") (= (get ts (+ i 2)) "[") (some #(= "{" %) (take 6 (drop (+ i 3) ts))))
            (let [k (loop [k (+ i 3)] (if (= (ts k) "{") k (recur (inc k))))
                  [items j] (brace-items ts k)
                  ents (vec (for [it items :when (= "{" (first it))
                                  :let [[parts] (brace-items (vec it) 0)
                                        f (fields-of parts ["ml_name" "ml_meth" "ml_flags" "ml_doc"])
                                        nm (f "ml_name")]
                                  :when (and nm (str? (first nm)))]
                              [(c-string nm) (or (c-eval (f "ml_flags") {}) 0) (f "ml_doc")]))]
              (recur j (assoc-in out [:methods (ts (inc i))] ents)))
            (and (= t "PyTypeObject") (= (get ts (+ i 2)) "=") (= (get ts (+ i 3)) "{"))
            (let [[items j] (brace-items ts (+ i 3))
                  f (fields-of items type-fields)]
              (recur j (update out :types conj {:var (ts (inc i)) :name (some-> (f "tp_name") strip-casts seq c-string)
                                                :doc (f "tp_doc") :methods (some-> (f "tp_methods") strip-casts last)
                                                :new? (let [x (some-> (f "tp_new") strip-casts)] (boolean (and (seq x) (not (#{["0"] ["NULL"]} x)))))})))
            (and (= t "PyType_Slot") (= (get ts (+ i 2)) "[") )
            (let [k (loop [k (+ i 3)] (if (= (ts k) "{") k (recur (inc k))))
                  [items j] (brace-items ts k)]
              (recur j (assoc-in out [:slots (ts (inc i))]
                                 (into {} (for [it items :when (= "{" (first it))
                                                :let [[[a b]] [(first (brace-items (vec it) 0))]]
                                                :when (and a (= 1 (count a)))]
                                            [(first a) b])))))
            (and (= t "PyType_Spec") (= (get ts (+ i 2)) "=") (= (get ts (+ i 3)) "{"))
            (let [[items j] (brace-items ts (+ i 3))
                  f (fields-of items ["name" "basicsize" "itemsize" "flags" "slots"])]
              (recur j (update out :specs conj {:name (some-> (f "name") seq c-string) :slots (some-> (f "slots") strip-casts last)})))
            (and (= t "PyStructSequence_Desc") (= (get ts (+ i 2)) "=") (= (get ts (+ i 3)) "{"))
            (let [[items j] (brace-items ts (+ i 3))
                  f (fields-of items ["name" "doc" "fields" "n_in_sequence"])]
              (recur j (update out :structseqs conj {:var (ts (inc i)) :name (some-> (f "name") seq c-string) :doc (f "doc")})))
            ;; a struct sequence's name set at run time before PyStructSequence_NewType (posixmodule.c's VAR.name = MODNAME ".x";)
            (and (= (get ts (inc i)) ".") (= (get ts (+ i 2)) "name") (= (get ts (+ i 3)) "=") (str? (get ts (+ i 4)))
                 (some #(= t (:var %)) (:structseqs out)))
            (let [j (loop [j (+ i 4)] (if (str? (get ts j)) (recur (inc j)) j))
                  nm (c-string (subvec ts (+ i 4) j))]
              (recur j (update out :structseqs (fn [ds] (mapv #(if (= t (:var %)) (assoc % :name nm) %) ds)))))
            ;; an init function's module definition: PyInit_NAME's (or config.c.in's init function's) body naming &DEF
            (and (re-matches #"(PyInit_[A-Za-z0-9_]+|_?Py[A-Za-z]+_Init)" t) (= (get ts (inc i)) "(") (some #{"{"} (take 6 (drop (+ i 2) ts)))
                 (not= (get ts (dec i)) "="))
            (let [k (loop [k (+ i 2)] (if (= (ts k) "{") k (recur (inc k))))
                  end (loop [k (inc k) d 1] (cond (zero? d) k (>= k n) k (= (ts k) "{") (recur (inc k) (inc d)) (= (ts k) "}") (recur (inc k) (dec d)) :else (recur (inc k) d)))
                  refs (for [m (range k (min end n)) :when (= (ts m) "&")] (get ts (inc m)))]
              (recur end (update out :inits conj [t (vec refs)])))
            (and (= t "_PyStructSequence_InitBuiltinWithFlags") (= (get ts (inc i)) "("))
            (let [args (first (markers (subvec ts i (min n (+ i 64))) "_PyStructSequence_InitBuiltinWithFlags"))]
              (recur (inc i) (if (some #(some #{"Py_TPFLAGS_DISALLOW_INSTANTIATION"} %) args)
                               (update out :no-new into (for [a args :when (= "&" (first a))] (second a)))
                               out)))
            (and (= t "PyModuleDef") (= (get ts (+ i 2)) "=") (= (get ts (+ i 3)) "{"))
            (let [[items j] (brace-items ts (+ i 3))
                  f (fields-of items ["m_base" "m_name" "m_doc" "m_size" "m_methods" "m_slots"])]
              (recur j (update out :modules conj {:var (ts (inc i)) :name (some-> (f "m_name") seq c-string) :methods (some-> (f "m_methods") strip-casts last)})))
            :else (recur (inc i) out)))))))

(defn- text-signature
  "_PyType_GetTextSignatureFromInternalDoc(name, doc, flags): the signature after the name up to the end marker's ), else the flags'"
  [^String nm ^String doc flags]
  (let [nm (last (str/split nm #"\."))
        from-doc (when (and doc (str/starts-with? doc nm) (= \( (get doc (count nm))))
                   (loop [i (count nm)]
                     (cond (>= i (count doc)) nil
                           (.startsWith doc ")\n--\n\n" (int i)) (subs doc (count nm) (inc i))
                           (.startsWith doc "\n\n" (int i)) nil
                           :else (recur (inc i)))))]
    (or from-doc
        (case (long (bit-and (long (or flags 0)) (bit-not 0x40)))
          4 "($self, /)" 20 "($type, /)" 36 "()" 8 "($self, object, /)" 24 "($type, object, /)" 40 "(object, /)" nil))))

(defn- go-str [s] (str "\"" (-> s (str/replace "\\" "\\\\") (str/replace "\"" "\\\"") (str/replace "\n" "\\n")) "\""))

(defn- slot-signatures
  "slotdefs' wrapper entries' signatures by name, the last entry per name (table-slotdocs' reading)"
  [opts]
  (let [f (str (:cpython opts) "/Objects/typeobject.c")
        unit (str (region f #"^#define TPSLOT\(" #"^static pytype_slotdef slotdefs\[\] = \{")
                  "\n#undef TPSLOT\n#undef FLSLOT\n#undef ETSLOT\n"
                  "#define TPSLOT(NAME, SLOT, FUNCTION, WRAPPER, DOC) __pys__(#NAME, WRAPPER, DOC)\n"
                  "#define FLSLOT(NAME, SLOT, FUNCTION, WRAPPER, DOC, FLAGS) __pys__(#NAME, WRAPPER, DOC)\n"
                  "#define ETSLOT(NAME, SLOT, FUNCTION, WRAPPER, DOC) __pys__(#NAME, WRAPPER, DOC)\n"
                  (region f #"^static pytype_slotdef slotdefs\[\] = \{" #"^\};") "\n};\n")]
    (reduce (fn [m [nm wrapper doc]]
              (let [nm (c-string nm)]
                (if (or (= wrapper ["NULL"]) (= doc ["NULL"])) m
                    (if-let [sig (text-signature nm (c-string doc) 0)] (assoc m nm sig) (dissoc m nm)))))
            (sorted-map) (markers (tokens (preprocess opts :amd64 [] "slotdefs-sig.c" unit)) "__pys__"))))

(defn- textsig-rows [opts]
  (let [py (:cpython opts) goarch :amd64
        _ (reset! textsig-top py)
        root (or (:root-amd64 opts) (fail! "textsig: --root-amd64"))
        sys (conj (sysroot opts goarch) (str root "/usr/include"))
        pre (str (own-pyconfig opts goarch sys) (textsig-prelude py))
        tf (typeobject-fields py)
        mods (textsig-modules py)
        ;; a file's names resolve in the file, then in its Setup module's other sources, then in every file
        group-of (into {} (for [[nm srcs] (setup-modules py) s srcs] [(str "Modules/" s) nm]))
        incs-of (into {} (for [[nm srcs ds] (setup-modules py) s srcs]
                           [(str "Modules/" s) (mapv #(str py "/" %) (concat ds (configure-include-dirs py nm)))]))
        facts (vec (for [f (textsig-files py)
                         :let [[t errs] (tolerant-preprocess opts goarch sys (str "textsig/" (str/replace f "/" "__"))
                                                             (str pre (when (= f "Modules/faulthandler.c") (internal-macros (str py "/Include/internal/pycore_faulthandler.h")))
                                                                  "\n" (drop-unfound (inline-local (str py "/" f) #{} (incs-of f [])) sys)))]]
                     (assoc (unit-facts (tokens t) tf) :file f :group (group-of f f) :errors errs)))
        merged (fn [k fs] (apply merge (map k fs)))
        everywhere {:docs (merged :docs facts) :methods (merged :methods facts) :slots (merged :slots facts)}
        by-group (into {} (for [[g fs] (group-by :group facts)] [g {:docs (merged :docs fs) :methods (merged :methods fs) :slots (merged :slots fs)}]))
        look (fn [ft k nm] (when nm (or (get-in ft [k nm]) (get-in by-group [(:group ft) k nm]) (get-in everywhere [k nm]))))
        doc-text (fn [ft it] (when it (let [it (strip-casts it)]
                                        (cond (and (seq it) (every? #(str/starts-with? % "\"") it)) (c-string it)
                                              (= 1 (count it)) (look ft :docs (first it))))))
        typeobj (first (filter #(= "Objects/typeobject.c" (:file %)) facts))
        newdoc (some (fn [[nm _ d]] (when (= nm "__new__") (doc-text typeobj d))) (look typeobj :methods "tp_new_methoddef"))
        key-of (fn [^String tp] (let [i (str/last-index-of tp ".")] (if i [(subs tp 0 i) (subs tp (inc i))] ["builtins" tp])))
        ;; static types every one (textsig_table.py's walk: every non-heap type); heap types (PyType_Spec) of a module of the set
        types (concat (for [ft facts t (:types ft) :when (:name t)] (assoc t :doc (doc-text ft (:doc t)) :ft ft))
                      (for [ft facts s (:specs ft) :when (:name s) :let [sl (look ft :slots (:slots s))]
                            :when (mods (first (key-of (:name s))))]
                        {:name (:name s) :doc (doc-text ft (get sl "Py_tp_doc")) :methods (some-> (get sl "Py_tp_methods") strip-casts last)
                         :new? (contains? sl "Py_tp_new") :ft ft})
                      ;; the struct sequences (PyStructSequence_Desc): Objects/structseq.c's tp_methods and tp_new
                      (let [sq (first (filter #(= "Objects/structseq.c" (:file %)) facts))]
                        (for [ft facts d (:structseqs ft) :when (:name d)
                              :when (or (not (str/includes? (:name d) ".")) (mods (first (key-of (:name d)))))]
                          {:name (:name d) :doc (doc-text ft (:doc d)) :methods "structseq_methods" :new? (not (contains? (:no-new ft) (:var d))) :ft sq})))
        rows (atom (sorted-map))
        put (fn [k v] (when (and k (string? v) (seq v)) (swap! rows #(if (contains? % k) % (assoc % k v)))))]
    (doseq [{:keys [name doc ft] ms :methods new? :new?} types
            :let [[m q] (key-of name) k (str m "." q)]]
      (put (str "type:" k) (text-signature name doc 0))
      (doseq [[nm flags d] (look ft :methods ms)]
        (put (str "meth:" k "." nm) (text-signature nm (doc-text ft d) flags)))
      (when new? (put (str "meth:" k ".__new__") (text-signature "__new__" newdoc 3))))
    ;; the slot wrappers' (slotdefs, as table-slotdocs reads them: the last entry with a wrapper per name)
    (doseq [[nm sig] (slot-signatures opts)] (put (str "slot:" nm) sig))
    ;; a module's functions by its import name: config.c.in's name of its init function, PyInit_NAME's NAME, else m_name
    (let [cfg-init (into {} (for [[_ nm f] (re-seq #"\{\"([A-Za-z_0-9]+)\", ([A-Za-z_0-9]+)\}" (slurp (str py "/Modules/config.c.in")))] [f nm]))
          sysattrs (re-seq #"COPY_SYS_ATTR\(\"([^\"]+)\", \"([^\"]+)\"\)" (slurp (str py "/Python/sysmodule.c")))]
      (doseq [ft facts {:keys [name var] ms :methods} (:modules ft)
              :let [import (or (some (fn [[f refs]] (when (some #{var} refs) (or (cfg-init f) (when (str/starts-with? f "PyInit_") (subs f 7)))))
                                     (:inits ft))
                               name)]
              :when (and import (mods import))
              [nm flags d] (look ft :methods ms)
              :when (zero? (bit-and (long flags) 0x30))]
        (let [sig (text-signature nm (doc-text ft d) flags)]
          (put (str "func:" import "." nm) sig)
          ;; sys's copies of its hooks (COPY_SYS_ATTR("__displayhook__", "displayhook")): the same function under another name
          (when (= import "sys")
            (doseq [[_ copy orig] sysattrs :when (= orig nm)] (put (str "func:sys." copy) sig))))))
    {:rows @rows :errors (for [ft facts :when (seq (:errors ft))] [(:file ft) (count (:errors ft)) (first (:errors ft))])}))

(defn- table-textsig [opts]
  (let [{:keys [rows errors]} (textsig-rows opts)]
    (spit (str (:work opts) "/textsig-errors.txt") (str/join "\n" (map pr-str errors)))
    (str "// Code generated by tools/pyi/textsig_table.py from CPython 3.14.10's built-ins; DO NOT EDIT.\n\n"
         "package py\n\n"
         "// textSigs are CPython's __text_signature__ of its built-in types (type:), the callables in their dicts (meth:),\n"
         "// the modules' functions (func:) and the slot wrappers (slot:), by the type's or module's qualified name\n"
         "var textSigs = map[string]string{\n"
         (str/join (for [[k v] rows] (str "\t" (go-str k) ": " (go-str v) ",\n")))
         "}\n")))

;; ---- the command

(let [[opts tables] (loop [as *command-line-args* opts {}]
                      (if (and (seq as) (str/starts-with? (first as) "--"))
                        (recur (drop 2 as) (assoc opts (keyword (subs (first as) 2)) (second as)))
                        [opts as]))
      [out & tables] tables
      opts (update opts :work #(or % (str out "/work")))
      makers {"opcode" ["builtins_opcode_table.go" table-opcode] "errno" ["builtins_errno_table.go" table-errno]
              "fcntl" ["builtins_fcntl_table.go" table-fcntl] "socket" ["builtins_socket_table.go" table-socket]
              "posix" ["builtins_posix_table.go" table-posix] "slotdocs" ["slotdocs.go" table-slotdocs]
              "ast" ["builtins_ast_table.go" table-ast]
              "bytecode" ["bytecode_table.go" table-bytecode] "bytecode315" ["bytecode_table315.go" table-bytecode315]
              "opcode315" ["builtins_opcode_table315.go" table-opcode315]
              "stat" ["builtins_stat_table.go" table-stat] "cjk" ["builtins_cjk_table.go" table-cjk]
              "unicodedata" ["builtins_unicodedata_table.go" table-unicodedata] "unicodedata315" ["builtins_unicodedata_table315.go" table-unicodedata315]
              "textsig" ["builtins_textsig_table.go" table-textsig]}]
  (.mkdirs (File. ^String (:work opts)))
  (doseq [t tables]
    (let [[f mk] (or (makers t) (fail! "no table " t ": " (str/join ", " (keys makers))))]
      (spit (str out "/" f) (mk opts))
      (println (str "runtime_tables: " f " made from the pinned sources")))))

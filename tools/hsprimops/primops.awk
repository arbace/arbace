# The primops' attributes the -O0 Simplifier reads (doc/haskell/FRONTEND-SURVEY.md, "As built: the -O0 Simplifier"):
# GHC 9.14.1's compiler/GHC/Builtin/primops.txt.pp (BSD-3, LICENSE.md "GHC") read for each primop's name, effect,
# out_of_line, code_size, work_free, cheap, div_like and a bottoming strictness (botDiv/exnDiv), printed as the
# namespace arbace.repr.haskell.primops: awk -f tools/hsprimops/primops.awk primops.txt.pp > arbace/repr/haskell/primops.ae
function flush() {
  if (name == "" || (name in seen)) { name = ""; return }
  seen[name] = 1
  printf "   \"%s\" {:effect :%s :out-of-line %s :code-size %s :work-free %s :cheap %s :div %s :bot %s}\n", name, effect, ool, csize, wf, cheap, div, bot
  name = ""
}
BEGIN {
  print ";; Generated by tools/hsprimops/primops.awk from GHC 9.14.1's compiler/GHC/Builtin/primops.txt.pp"
  print ";; (https://downloads.haskell.org/ghc/9.14.1/ghc-9.14.1-src.tar.xz, BSD-3: LICENSE.md, \"GHC\"); do not edit."
  print "(ns arbace.repr.haskell.primops"
  print "  \"The primops' attributes (GHC.Builtin.PrimOps' primOpEffect, primOpOutOfLine, primOpCodeSize, primOpIsWorkFree,"
  print "  primOpIsCheap, primOpIsDiv and a dead-end strictness): :code-size nil is the default (1), :foreign the foreign"
  print "  call's (4); :work-free and :cheap nil are their defaults (code size 0; ok for speculation).\")"
  print ""
  print "(def table"
  print "  {"
}
/^primop[ \t]/ { flush(); name = $3; gsub(/"/, "", name); effect = "NoEffect"; ool = "false"; csize = "nil"; wf = "nil"; cheap = "nil"; div = "false"; bot = "false"; next }
/^(section|pseudoop|primtype|------)/ { flush(); next }
name != "" && /effect *= */ { e = $0; sub(/.*effect *= */, "", e); sub(/[ \t].*/, "", e); effect = e }
name != "" && /out_of_line *= *True/ { ool = "true" }
name != "" && /code_size *= */ { c = $0; sub(/.*code_size *= */, "", c); if (c ~ /ForeignCall/) csize = ":foreign"; else { sub(/[^0-9].*/, "", c); csize = c } }
name != "" && /work_free *= *True/ { wf = "true" }
name != "" && /work_free *= *False/ { wf = "false" }
name != "" && /cheap *= *True/ { cheap = "true" }
name != "" && /cheap *= *False/ { cheap = "false" }
name != "" && /div_like *= *True/ { div = "true" }
name != "" && /strictness *=.*(botDiv|exnDiv)/ { bot = "true" }
END { flush(); print "  })" }

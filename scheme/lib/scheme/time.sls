#!r6rs
;;;; (scheme time): R7RS-small over /proc: si has no clock primitive and psyntax's primitive list (the $all library)
;;;; is generated at the boot, so the clock is Linux's /proc/uptime (hundredths of a second) and /proc/stat's btime
;;;; (SM8, SC107). A jiffy is a microsecond; the resolution is 10 ms.
(library (scheme time)
  (export current-jiffy current-second jiffies-per-second)
  (import (rnrs))
  (define (read-file-text name)
    (guard (e (#t ""))
      (let* ((p (open-file-input-port name)) (bv (get-bytevector-all p)))
        (close-port p)
        (if (bytevector? bv) (utf8->string bv) ""))))
  (define (uptime)
    (let* ((s (read-file-text "/proc/uptime"))
           (p (open-string-input-port s))
           (x (read p)))
      (if (real? x) x 0)))
  (define (btime)
    (let* ((s (read-file-text "/proc/stat")) (n (string-length s)))
      (let loop ((i 0))
        (cond ((> (+ i 6) n) 0)
              ((and (string=? (substring s i (+ i 6)) "btime ") (or (= i 0) (char=? (string-ref s (- i 1)) #\newline)))
               (let ((x (read (open-string-input-port (substring s (+ i 6) (min n (+ i 24)))))))
                 (if (real? x) x 0)))
              (else (loop (+ i 1)))))))
  (define base (btime))
  (define (jiffies-per-second) 1000000)
  (define (current-second) (inexact (+ base (uptime))))
  (define (current-jiffy) (exact (round (* (uptime) 1000000)))))

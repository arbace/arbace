#!r6rs
;;;; (si format): Chez Scheme's format, printf and fprintf for Arbace's Scheme (si), SC122 (b) (doc/scheme/SCHEME-SURVEY.md,
;;;; "As built: SC115-SC122"). Written for Arbace from Chez's User's Guide (the directives of format) and from the behaviour
;;;; probed on Chez Scheme 10.3.0 and in Chez's format.ms mats; not Chez's code. The directives:
;;;;   ~a ~s (mincol,colinc,minpad,padchar, @ pads on the left)  ~d ~b ~o ~x (mincol,padchar,commachar,commainterval, : commas,
;;;;   @ sign)  ~r (radix; none: English; : ordinal; @ Roman; @: old Roman)  ~c (: names, @ written)  ~p (: back one, @ y/ies)
;;;;   ~% ~& ~~ ~newline  ~* (: back, @ absolute)  ~? ~@?  ~[ ~; ~:; ~] (n, : two clauses, @ test)  ~{ ~} (n, :, @, ~:})
;;;;   ~^ (~:^)  ~( ~) (case)  ~t (column, relative with @)  ~< ~; ~> (justification, ~n:;)  ~f ~e ~g ~$ (floating point).
;;;; The floating point directives print the shortest digits Scheme prints, rounded to the requested digits; the exact
;;;; strings of Chez's quirks for flonums past 17 digits ("9999999999999999#######.") are not reproduced.
(library (si format)
  (export format printf fprintf)
  (import (rnrs) (rnrs mutable-strings))

  (define (ferr msg . irritants) (apply error 'format msg irritants))

  ;; ------------------------------------------------------------------ output buffers (with the column)
  (define-record-type buf (fields (mutable chars) (mutable col)))
  (define (new-buf) (make-buf '() 0))
  (define (emit! b s)
    (let loop ((i 0))
      (when (< i (string-length s))
        (let ((c (string-ref s i)))
          (buf-chars-set! b (cons c (buf-chars b)))
          (buf-col-set! b (if (char=? c #\newline) 0 (+ (buf-col b) 1)))
          (loop (+ i 1))))))
  (define (emit-char! b c) (emit! b (string c)))
  (define (buf->string b) (list->string (reverse (buf-chars b))))
  (define (capture proc) (let ((b (new-buf))) (let ((r (proc b))) (values (buf->string b) r))))

  ;; ------------------------------------------------------------------ the arguments
  (define-record-type st (fields args (mutable idx)))
  (define (st-left s) (- (vector-length (st-args s)) (st-idx s)))
  (define (next-arg! s)
    (when (<= (st-left s) 0) (ferr "too few arguments"))
    (let ((a (vector-ref (st-args s) (st-idx s)))) (st-idx-set! s (+ (st-idx s) 1)) a))
  (define (list->st l) (make-st (list->vector l) 0))

  ;; ------------------------------------------------------------------ directives
  ;; (parse ctl i n s): the directive after the tilde at i-1: (values params colon at char next); a parameter is a number, a
  ;; character, 'v, '# or #f (omitted)
  (define (parse ctl i n)
    (define (digit? c) (char<=? #\0 c #\9))
    (define (ch j) (if (< j n) (string-ref ctl j) (ferr "incomplete directive in control string" ctl)))
    (let ploop ((j i) (ps '()))
      (let* ((c (ch j))
             (pv+j (cond ((or (digit? c) (and (memv c '(#\- #\+)) (< (+ j 1) n) (digit? (string-ref ctl (+ j 1)))))
                          (let dl ((k (+ j 1)))
                            (if (and (< k n) (digit? (string-ref ctl k)))
                                (dl (+ k 1))
                                (cons (string->number (let ((t (substring ctl j k))) (if (char=? (string-ref t 0) #\+) (substring t 1 (string-length t)) t))) k))))
                         ((char=? c #\') (ch (+ j 1)) (cons (string-ref ctl (+ j 1)) (+ j 2)))
                         ((memv c '(#\v #\V)) (cons 'v (+ j 1)))
                         ((char=? c #\#) (cons 'hash (+ j 1)))
                         (else (cons #f j))))
             (ps (cons (car pv+j) ps))
             (k (cdr pv+j)))
        (if (and (< k n) (char=? (string-ref ctl k) #\,))
            (ploop (+ k 1) ps)
            (let floop ((k k) (colon #f) (at #f))
              (let ((c (ch k)))
                (cond ((char=? c #\:) (when colon (ferr "duplicate flag in control string" ctl)) (floop (+ k 1) #t at))
                      ((char=? c #\@) (when at (ferr "duplicate flag in control string" ctl)) (floop (+ k 1) colon #t))
                      (else
                       (let ((ps (reverse ps)))
                         (values (if (and (= (length ps) 1) (not (car ps))) '() ps) colon at c (+ k 1)))))))))))

  ;; the matching close of an open directive at i (after it): the position of the next directive of a char in `ends` at
  ;; depth 0, found by scanning; returns (values start-of-directive params colon at char next)
  (define (opener? c) (memv c '(#\[ #\{ #\( #\<)))
  (define (closer-of c) (case c ((#\[) #\]) ((#\{) #\}) ((#\() #\)) ((#\<) #\>)))
  (define (find-end ctl i n open-char semis?)
    ;; returns the list of (start . directive-info) of the separators ~; at depth 0 and the close: (values seps close-start close-info next)
    (let loop ((j i) (depth 0) (seps '()))
      (let find ((k j))
        (cond ((>= k n) (ferr "missing close for directive in control string" ctl))
              ((char=? (string-ref ctl k) #\~)
               (let-values (((ps colon at c next) (parse ctl (+ k 1) n)))
                 (let ((lc (char-downcase c)))
                   (cond ((opener? lc) (loop next (+ depth 1) seps))
                         ((and (= depth 0) (char=? lc #\;)) (loop next depth (cons (list k next ps colon at) seps)))
                         ((memv lc '(#\] #\} #\) #\>))
                          (cond ((> depth 0) (loop next (- depth 1) seps))
                                ((char=? lc (closer-of open-char)) (values (reverse seps) k (list k next ps colon at) next))
                                (else (ferr "mismatched directive in control string" ctl))))
                         (else (loop next depth seps))))))
              (else (find (+ k 1)))))))

  (define (resolve p s)
    (cond ((eq? p 'v) (next-arg! s))
          ((eq? p 'hash) (st-left s))
          (else p)))

  (define (num-param p s who)
    (let ((v (resolve p s)))
      (cond ((not v) #f)
            ((and (integer? v) (exact? v)) v)
            (else (ferr "invalid parameter" v)))))

  ;; ------------------------------------------------------------------ padding
  (define (pad-string str mincol colinc minpad padchar left?)
    (let* ((len (string-length str))
           (mincol (or mincol 0)) (colinc (if (and colinc (> colinc 0)) colinc 1)) (minpad (or minpad 0))
           (total (let loop ((t (+ len minpad))) (if (>= t mincol) t (loop (+ t colinc)))))
           (pad (make-string (- total len) (or padchar #\space))))
      (if left? (string-append pad str) (string-append str pad))))

  ;; ------------------------------------------------------------------ numbers
  (define (digits-with-commas s commachar interval)
    (let loop ((cs (reverse (string->list s))) (n 0) (acc '()))
      (cond ((null? cs) (list->string acc))
            ((and (> n 0) (= (mod n interval) 0)) (loop cs 0 (cons commachar acc)) )
            (else (loop (cdr cs) (+ n 1) (cons (car cs) acc))))))
  (define (group-commas s commachar interval)
    (let loop ((cs (reverse (string->list s))) (n 0) (acc '()))
      (cond ((null? cs) (list->string acc))
            ((and (> n 0) (= (mod n interval) 0)) (loop cs 0 (cons commachar acc)))
            (else (loop (cdr cs) (+ n 1) (cons (car cs) acc))))))

  (define (format-integer who n radix params colon at s b)
    (let* ((mincol (num-param (list-ref* params 0) s who)) (padchar (let ((p (resolve (list-ref* params 1) s))) p))
           (commachar (or (resolve (list-ref* params 2) s) #\,)) (interval (or (num-param (list-ref* params 3) s who) 3)))
      (if (and (integer? n) (exact? n))
          (let* ((neg (< n 0))
                 (digits (string-upcase (number->string (abs n) radix)))
                 (digits (if colon (group-commas digits commachar interval) digits))
                 (str (string-append (cond (neg "-") (at "+") (else "")) digits)))
            (emit! b (pad-string str mincol 1 0 padchar #t)))
          (emit! b (pad-string (display-string n) mincol 1 0 padchar #t)))))

  (define (no-flags colon at ctl) (when (or colon at) (ferr "invalid flags in control string" ctl)))
  (define (list-ref* l i) (if (< i (length l)) (list-ref l i) #f))

  (define (display-string x) (call-with-string-output-port (lambda (p) (display x p))))
  (define (write-string* x) (call-with-string-output-port (lambda (p) (write x p))))

  (define ones '#("zero" "one" "two" "three" "four" "five" "six" "seven" "eight" "nine" "ten" "eleven" "twelve" "thirteen"
                  "fourteen" "fifteen" "sixteen" "seventeen" "eighteen" "nineteen"))
  (define tens '#("" "" "twenty" "thirty" "forty" "fifty" "sixty" "seventy" "eighty" "ninety"))
  (define scales '#("" "thousand" "million" "billion" "trillion" "quadrillion" "quintillion" "sextillion" "septillion"
                    "octillion" "nonillion" "decillion"))
  (define (below-100 n)
    (cond ((< n 20) (vector-ref ones n))
          ((= (mod n 10) 0) (vector-ref tens (div n 10)))
          (else (string-append (vector-ref tens (div n 10)) "-" (vector-ref ones (mod n 10))))))
  (define (below-1000 n)
    (cond ((< n 100) (below-100 n))
          ((= (mod n 100) 0) (string-append (vector-ref ones (div n 100)) " hundred"))
          (else (string-append (vector-ref ones (div n 100)) " hundred " (below-100 (mod n 100))))))
  (define (join-words ws) (if (null? ws) "" (fold-left (lambda (a w) (string-append a " " w)) (car ws) (cdr ws))))
  (define (cardinal n)   ; n >= 0, below 10^9
    (if (= n 0)
        "zero"
        (let loop ((n n) (scale 0) (words '()))
          (if (= n 0)
              (join-words words)
              (let* ((group (mod n 1000)))
                (loop (div n 1000) (+ scale 1)
                      (cond ((= group 0) words)
                            ((and (= scale 1) (= (div n 1000) 1) #f) words)
                            (else (cons (if (> scale 0) (string-append (below-1000 group) " " (vector-ref scales scale)) (below-1000 group))
                                        words)))))))))
  ;; Chez says "seventeen hundred eighty-two" for 1100 to 1999
  (define (cardinal* n)
    (let* ((r (mod n 1000000)) (hi (- n r)))
      (if (and (<= 1100 r 1999) (not (= (mod r 100) 0) ) #t)
          (let ((s (string-append (below-100 (div r 100)) " hundred" (if (= (mod r 100) 0) "" (string-append " " (below-100 (mod r 100)))))))
            (if (= hi 0) s (string-append (cardinal hi) " " s)))
          (if (and (<= 1100 r 1999))
              (let ((s (string-append (below-100 (div r 100)) " hundred")))
                (if (= hi 0) s (string-append (cardinal hi) " " s)))
              (cardinal n)))))
  (define (ordinalize s)   ; the last word of an English cardinal made ordinal
    (let* ((n (string-length s))
           (start (let loop ((i (- n 1))) (if (or (< i 0) (memv (string-ref s i) '(#\space #\-))) (+ i 1) (loop (- i 1)))))
           (w (substring s start n))
           (o (cond ((string=? w "one") "first") ((string=? w "two") "second") ((string=? w "three") "third")
                    ((string=? w "five") "fifth") ((string=? w "eight") "eighth") ((string=? w "nine") "ninth")
                    ((string=? w "twelve") "twelfth")
                    ((and (> (string-length w) 1) (char=? (string-ref w (- (string-length w) 1)) #\y))
                     (string-append (substring w 0 (- (string-length w) 1)) "ieth"))
                    (else (string-append w "th")))))
      (string-append (substring s 0 start) o)))
  (define (numeric-ordinal n)
    (let* ((a (abs n)) (suffix (cond ((memv (mod a 100) '(11 12 13)) "th")
                                      ((= (mod a 10) 1) "st") ((= (mod a 10) 2) "nd") ((= (mod a 10) 3) "rd") (else "th"))))
      (string-append (group-commas (number->string n) #\, 3) suffix)))
  (define (roman n old?)
    (let loop ((n n) (vals (if old? '(1000 500 100 50 10 5 1) '(1000 900 500 400 100 90 50 40 10 9 5 4 1)))
               (syms (if old? '("M" "D" "C" "L" "X" "V" "I") '("M" "CM" "D" "CD" "C" "XC" "L" "XL" "X" "IX" "V" "IV" "I"))) (acc ""))
      (cond ((= n 0) acc)
            ((>= n (car vals)) (loop (- n (car vals)) vals syms (string-append acc (car syms))))
            (else (loop n (cdr vals) (cdr syms) acc)))))

  (define (format-radix who params colon at s b)
    (let ((arg (next-arg! s)) (rp (resolve (list-ref* params 0) s)))
      (cond
        (rp
         (unless (and (integer? rp) (exact? rp) (<= 2 rp 36)) (ferr "invalid radix" rp))
         (format-integer who arg rp (if (null? params) '() (cdr params)) colon at s b))
        ((not (and (integer? arg) (exact? arg))) (emit! b (display-string arg)))
        ((and at (<= (if colon 1 1) arg (if colon 4999 3999)))
         (emit! b (roman arg colon)))
        (at (emit! b (number->string arg)))
        ((>= (abs arg) 1000000000)
         (emit! b (if colon (numeric-ordinal arg) (group-commas (number->string arg) #\, 3))))
        (else
         (let* ((words (cardinal* (abs arg))) (words (if colon (ordinalize words) words)))
           (emit! b (if (< arg 0) (string-append "minus " words) words)))))))

  ;; ------------------------------------------------------------------ floating point
  (define (flonum-digits x)   ; x > 0 finite: (values digit-string exponent) with x = 0.DIGITS * 10^exponent
    (let* ((s (number->string x)) (n (string-length s))
           (epos (let loop ((i 0)) (cond ((= i n) #f) ((char=? (string-ref s i) #\e) i) (else (loop (+ i 1))))))
           (mant (if epos (substring s 0 epos) s)) (ex (if epos (string->number (substring s (+ epos 1) n)) 0))
           (dot (let loop ((i 0)) (cond ((= i (string-length mant)) #f) ((char=? (string-ref mant i) #\.) i) (else (loop (+ i 1))))))
           (ip (if dot (substring mant 0 dot) mant)) (fp (if dot (substring mant (+ dot 1) (string-length mant)) ""))
           (all (string-append ip fp)) (point (+ (string-length ip) ex))
           ;; strip leading zeros
           (lead (let loop ((i 0)) (if (and (< i (string-length all)) (char=? (string-ref all i) #\0)) (loop (+ i 1)) i)))
           (all2 (substring all lead (string-length all)))
           (trail (let loop ((i (string-length all2))) (if (and (> i 0) (char=? (string-ref all2 (- i 1)) #\0)) (loop (- i 1)) i))))
      (values (substring all2 0 trail) (- point lead))))
  ;; the value rounded to `d` digits after the point, as a string of digits and the position of the point
  (define (round-fixed x d)   ; x >= 0 exact rational: the integer round(x * 10^d)
    (let ((v (* x (expt 10 d)))) (let ((f (floor v))) (let ((r (- v f))) (cond ((> r 1/2) (+ f 1)) ((< r 1/2) f) ((even? f) f) (else (+ f 1)))))))
  (define (fixed-string x d)   ; x >= 0 flonum or exact: "int.frac" with d fraction digits (d >= 0)
    (let* ((ex (exact x)) (n (round-fixed ex d)) (s (number->string n)))
      (let* ((s (if (<= (string-length s) d) (string-append (make-string (- (+ d 1) (string-length s)) #\0) s) s))
             (ip (substring s 0 (- (string-length s) d))) (fp (substring s (- (string-length s) d) (string-length s))))
        (string-append ip "." fp))))
  (define (shortest-fixed x)   ; the shortest digits of x >= 0 as "int.frac" (no exponent)
    (if (= x 0)
        "0.0"
        (let-values (((ds e) (flonum-digits (inexact x))))
          (cond ((<= e 0) (string-append "0." (make-string (- e) #\0) ds))
                ((>= e (string-length ds)) (string-append ds (make-string (- e (string-length ds)) #\0) ".0"))
                (else (string-append (substring ds 0 e) "." (substring ds e (string-length ds))))))))
  (define (sign-of x) (or (< x 0) (and (flonum? x) (eqv? x -0.0))))

  ;; digits (a string, no leading zero) and the position of the point (x = 0.DIGITS * 10^e): "int.frac" in full
  (define (digits->fixed ds e)
    (cond ((<= e 0) (string-append "0." (make-string (- e) #\0) ds))
          ((>= e (string-length ds)) (string-append ds (make-string (- e (string-length ds)) #\0) ".0"))
          (else (string-append (substring ds 0 e) "." (substring ds e (string-length ds))))))
  ;; x = |arg| as digits and point position, shifted by 10^k
  (define (shifted-digits arg k)
    (if (= arg 0) (values "0" 1)
        (let-values (((ds e) (flonum-digits (inexact (abs arg))))) (values ds (+ e k)))))
  (define (round-to-fraction ds e fd)   ; the value 0.DS*10^e rounded to fd digits after the point: "int.frac" string
    (let* ((v (* (string->number ds) (expt 10 (- e (string-length ds))))))
      (fixed-string v fd)))

  (define (format-fixed who params colon at s b)
    (let* ((w (num-param (list-ref* params 0) s who)) (d (num-param (list-ref* params 1) s who))
           (k (or (num-param (list-ref* params 2) s who) 0)) (ovf (resolve (list-ref* params 3) s))
           (padchar (or (resolve (list-ref* params 4) s) #\space)) (arg (next-arg! s)))
      (cond
        ((not (real? arg)) (emit! b (pad-string (display-string arg) w 1 0 padchar #t)))
        ((and (flonum? arg) (or (nan? arg) (infinite? arg)))
         (emit! b (pad-string (display-string arg) w 1 0 #\space #t)))
        (else
         (let-values (((ds e) (shifted-digits arg k)))
           (let* ((neg (sign-of arg)) (sgn (cond (neg "-") (at "+") (else "")))
                  (full (digits->fixed ds e))
                  (dot (let loop ((i 0)) (if (char=? (string-ref full i) #\.) i (loop (+ i 1)))))
                  (ip (substring full 0 dot))
                  (body
                   (cond
                     (d (let ((r (round-to-fraction ds e d)))
                          ;; a width too small for the leading zero drops it
                          (if (and w (> (+ (string-length sgn) (string-length r)) w) (> (string-length r) 1) (char=? (string-ref r 0) #\0) (char=? (string-ref r 1) #\.))
                              (substring r 1 (string-length r))
                              r)))
                     ((not w) full)
                     (else
                      (let ((room (- w (string-length sgn))))
                        (cond ((<= (string-length full) room) full)
                              ((string=? ip "0")
                               (let ((r (round-to-fraction ds e (max 0 (- room 1)))))
                                 (if (let loop ((i 0)) (cond ((= i (string-length r)) #t) ((memv (string-ref r i) '(#\0 #\.)) (loop (+ i 1))) (else #f)))
                                     "0.0"
                                     (substring r 1 (string-length r)))))
                              (else (round-to-fraction ds e (max 0 (- room (string-length ip) 1)))))))))
                  (out (string-append sgn body)))
             (if (and w ovf (> (string-length out) w))
                 (emit! b (make-string w ovf))
                 (emit! b (pad-string out w 1 0 padchar #t)))))))))

  (define (format-dollar who params at colon s b)
    (let* ((d (or (num-param (list-ref* params 0) s who) 2)) (n (or (num-param (list-ref* params 1) s who) 1))
           (w (num-param (list-ref* params 2) s who)) (padchar (or (resolve (list-ref* params 3) s) #\space)) (arg (next-arg! s)))
      (if (not (real? arg))
          (emit! b (pad-string (display-string arg) w 1 0 padchar #t))
          (let* ((neg (sign-of arg)) (sgn (cond (neg "-") (at "+") (else "")))
                 (body (fixed-string (abs arg) d))
                 (dot (let loop ((i 0)) (if (char=? (string-ref body i) #\.) i (loop (+ i 1)))))
                 (body (if (< dot n) (string-append (make-string (- n dot) #\0) body) body)))
            (if colon
                (begin (emit! b sgn) (emit! b (pad-string body (and w (- w (string-length sgn))) 1 0 padchar #t)))
                (emit! b (pad-string (string-append sgn body) w 1 0 padchar #t)))))))

  (define (round-sig ds n)   ; ds rounded to n >= 1 significant digits: (values digits carry?) ; digits has n digits
    (cond ((<= (string-length ds) n) (values (string-append ds (make-string (- n (string-length ds)) #\0)) #f))
          ((char<? (string-ref ds n) #\5) (values (substring ds 0 n) #f))
          (else
           (let ((v (+ 1 (string->number (substring ds 0 n)))))
             (let ((t (number->string v)))
               (if (> (string-length t) n) (values (substring t 0 n) #t) (values t #f)))))))

  (define (format-exp who params at s b)
    (let* ((w (num-param (list-ref* params 0) s who)) (d (num-param (list-ref* params 1) s who))
           (e (num-param (list-ref* params 2) s who)) (k (or (num-param (list-ref* params 3) s who) 1))
           (ovf (resolve (list-ref* params 4) s)) (padchar (or (resolve (list-ref* params 5) s) #\space))
           (expchar (or (resolve (list-ref* params 6) s) #\e)) (arg (next-arg! s)))
      (if (not (real? arg))
          (emit! b (pad-string (display-string arg) w 1 0 padchar #t))
          (let ((neg (sign-of arg)))
            (let-values (((ds0 ex0) (shifted-digits arg 0)))
              (let* ((sgn (cond (neg "-") (at "+") (else "")))
                     (zero? (= arg 0))
                     (nsig (and d (if (> k 0) (+ d 1) (+ d k))))
                     (r (if (and nsig (> nsig 0)) (call-with-values (lambda () (round-sig ds0 nsig)) cons) (cons ds0 #f)))
                     (digs (car r)) (ex (if (cdr r) (+ ex0 1) ex0))
                     (scale (if zero? 0 (- ex k)))
                     (pre (if (> k 0) (let ((t (if (< (string-length digs) k) (string-append digs (make-string (- k (string-length digs)) #\0)) digs))) (substring t 0 k)) ""))
                     (rest (if (> k 0) (if (> (string-length digs) k) (substring digs k (string-length digs)) "")
                               (string-append (make-string (- k) #\0) digs)))
                     (rest (if (and (not d) (string=? rest "")) "0" rest))
                     (es (number->string (abs scale)))
                     (es (if (and e (< (string-length es) e)) (string-append (make-string (- e (string-length es)) #\0) es) es))
                     (tail (string-append "." rest (string expchar) (if (< scale 0) "-" "+") es))
                     (body (string-append (if (string=? pre "") (if (and w (< (+ (string-length sgn) 1 (string-length tail)) (+ w 1))) "0" "") pre) tail))
                     (out (string-append sgn body)))
                (if (and w ovf (> (string-length out) w))
                    (emit! b (make-string w ovf))
                    (emit! b (pad-string out w 1 0 padchar #t)))))))))

  (define (format-general who params at s b)
    (let* ((w (num-param (list-ref* params 0) s who)) (d (num-param (list-ref* params 1) s who))
           (e (num-param (list-ref* params 2) s who)) (k (or (num-param (list-ref* params 3) s who) 1))
           (ovf (resolve (list-ref* params 4) s)) (padchar (or (resolve (list-ref* params 5) s) #\space))
           (arg (next-arg! s)))
      (if (not (and (real? arg) (not (and (flonum? arg) (or (nan? arg) (infinite? arg))))))
          (emit! b (pad-string (display-string arg) w 1 0 #\space #t))
          (let* ((ee (if e (+ e 2) 4)) (ww (and w (- w ee))))
            (let-values (((ds n) (shifted-digits arg 0)))
              (let* ((n (if (= arg 0) 0 n)) (dd (and d (- d n))))
                (if (or (= arg 0) (not d) (and (>= dd 0) (<= dd d)))
                    (let-values (((str r) (capture (lambda (bb)
                                                      (if (= arg 0)
                                                          (emit! bb (string-append (cond ((sign-of arg) "-") (at "+") (else "")) "0."))
                                                          (format-fixed who (list ww dd #f ovf padchar) #f at (list->st (list arg)) bb))))))
                      (emit! b (pad-string (string-append (if (and ww (not (= arg 0))) (pad-string str ww 1 0 padchar #t) (if ww (pad-string str ww 1 0 padchar #t) str))
                                                          (make-string (if w ee 0) #\space)) #f 1 0 #\space #f)))
                    (format-exp who params at (list->st (list arg)) b))))))))

  ;; ------------------------------------------------------------------ case conversion
  (define (titlecase-words str all?)
    (let ((n (string-length str)) (out (make-string (string-length str))))
      (let loop ((i 0) (in-word #f) (first-done #f))
        (if (= i n)
            out
            (let ((c (string-ref str i)))
              (if (or (char-alphabetic? c) (char-numeric? c))
                  (begin
                    (string-set! out i (if (and (not in-word) (or all? (not first-done))) (char-upcase c) (char-downcase c)))
                    (loop (+ i 1) #t (or first-done (char-alphabetic? c))))
                  (begin (string-set! out i c) (loop (+ i 1) #f first-done))))))))
  (define (case-convert str colon at)
    (cond ((and colon at) (string-upcase str))
          (colon (titlecase-words str #t))
          (at (titlecase-words str #f))
          (else (string-downcase str))))

  ;; ------------------------------------------------------------------ the interpreter
  ;; (run ctl lo hi s b ctx): processes ctl[lo,hi); returns #f, 'up (~^ fired) or 'up-all (~:^ fired); ctx the innermost
  ;; iteration: #f, 'list, 'colon-list (for ~^ and ~:^)
  (define (run ctl lo hi s b ctx)
    (let loop ((i lo))
      (cond
        ((>= i hi) #f)
        ((char=? (string-ref ctl i) #\~)
         (let-values (((ps0 colon at c next) (parse ctl (+ i 1) hi)))
           (let ((lc (char-downcase c)) (ps (map (lambda (p) (resolve p s)) ps0)))
             (define (finish) (loop next))
             (case lc
               ((#\a #\s)
                (let* ((arg (next-arg! s))
                       (str (if (char=? lc #\a) (display-string arg) (write-string* arg)))
                       (str (if (and colon (null? arg)) "()" str)))
                  (emit! b (pad-string str (num-param (list-ref* ps 0) s 'a) (num-param (list-ref* ps 1) s 'a)
                                       (num-param (list-ref* ps 2) s 'a) (resolve (list-ref* ps 3) s) at))
                  (finish)))
               ((#\d) (format-integer 'd (next-arg! s) 10 ps colon at s b) (finish))
               ((#\b) (format-integer 'b (next-arg! s) 2 ps colon at s b) (finish))
               ((#\o) (format-integer 'o (next-arg! s) 8 ps colon at s b) (finish))
               ((#\x) (format-integer 'x (next-arg! s) 16 ps colon at s b) (finish))
               ((#\r) (format-radix 'r ps colon at s b) (finish))
               ((#\c)
                (let ((arg (next-arg! s)))
                  (unless (char? arg) (ferr "~c expects a character" arg))
                  (emit! b (cond (colon (cond ((char=? arg #\space) "<space>") ((= (char->integer arg) 27) "<esc>")
                                              ((char=? arg #\newline) "<newline>")
                                              ((< (char->integer arg) 32) (string #\^ (integer->char (+ 64 (char->integer arg)))))
                                              (else (string arg))))
                                 (at (write-string* arg))
                                 (else (string arg))))
                  (finish)))
               ((#\p)
                (when colon (when (<= (st-idx s) 0) (ferr "no previous argument")) (st-idx-set! s (- (st-idx s) 1)))
                (let ((arg (next-arg! s)))
                  (emit! b (if at (if (eqv? arg 1) "y" "ies") (if (eqv? arg 1) "" "s")))
                  (finish)))
               ((#\%) (no-flags colon at ctl) (emit! b (make-string (or (num-param (list-ref* ps 0) s '%) 1) #\newline)) (finish))
               ((#\&) (no-flags colon at ctl)
                (let ((n (or (num-param (list-ref* ps 0) s '&) 1)))
                  (when (> n 0)
                    (unless (= (buf-col b) 0) (emit-char! b #\newline))
                    (emit! b (make-string (- n 1) #\newline))))
                (finish))
               ((#\~) (no-flags colon at ctl) (emit! b (make-string (or (num-param (list-ref* ps 0) s '~) 1) #\~)) (finish))
               ((#\newline #\return)
                (let* ((nl (if (and (char=? c #\return) (< next hi) (char=? (string-ref ctl next) #\newline)) (+ next 1)
                               (begin (when (char=? c #\return) (ferr "bad directive in control string" ctl)) next)))
                       (after (if colon nl (let skip ((k nl)) (if (and (< k hi) (char-whitespace? (string-ref ctl k))) (skip (+ k 1)) k)))))
                  (when (and at (not colon)) (emit-char! b #\newline))
                  (loop after)))
               ((#\*)
                (when (and at colon) (ferr "invalid flags for ~* in control string" ctl))
                (let ((n (or (num-param (list-ref* ps 0) s '*) (if at 0 1))))
                  (cond (at (unless (<= 0 n (vector-length (st-args s))) (ferr "invalid argument index" n)) (st-idx-set! s n))
                        (colon (let ((j (- (st-idx s) n))) (unless (<= 0 j) (ferr "no previous argument")) (st-idx-set! s j)))
                        (else (when (or (< n 0) (> n (st-left s))) (ferr "too few arguments")) (st-idx-set! s (+ (st-idx s) n))))
                  (finish)))
               ((#\?)
                (set! lenient #t)
                (let ((fmt (next-arg! s)))
                  (unless (string? fmt) (ferr "~? expects a string" fmt))
                  (if at
                      (let ((r (run fmt 0 (string-length fmt) s b #f))) (finish))
                      (let ((args (next-arg! s)))
                        (unless (list? args) (ferr "~? expects a list of arguments" args))
                        (run fmt 0 (string-length fmt) (list->st args) b #f)
                        (finish)))))
               ((#\^)
                (let* ((a (resolve (list-ref* ps 0) s)) (b2 (resolve (list-ref* ps 1) s)) (c2 (resolve (list-ref* ps 2) s))
                       (fire (cond (c2 (and (<= a b2) (<= b2 c2))) (b2 (eqv? a b2)) (a (eqv? a 0))
                                   (colon (and (eq? ctx 'colon-list) (outer-empty?)))
                                   (else (= (st-left s) 0)))))
                  (if fire (if colon 'up-all 'up) (finish))))
               ((#\[)
                (let-values (((seps close-start close-info nxt) (find-end ctl next hi #\[ #t)))
                  (let* ((starts (cons next (map cadr seps)))
                         (ends (append (map car seps) (list close-start)))
                         (default-idx (let find ((ss seps) (k 1)) (cond ((null? ss) #f) ((cadddr (car ss)) k) (else (find (cdr ss) (+ k 1))))))
                         (nclauses (length starts))
                         (select (cond (colon (unless (= nclauses 2) (ferr "~:[ takes two clauses"))
                                                (if (next-arg! s) 1 0))
                                       (at (let ((a (next-arg! s))) (if a (begin (st-idx-set! s (- (st-idx s) 1)) 0) #f)))
                                       (else (let ((n (or (resolve (list-ref* ps 0) s) (next-arg! s))))
                                               (cond ((not (and (integer? n) (exact? n))) default-idx)
                                                     ((and (>= n 0) (< n nclauses) (or (not default-idx) (< n default-idx))) n)
                                                     (default-idx default-idx)
                                                     (else #f)))))))
                    (when (and at (> nclauses 1)) (ferr "~@[ takes one clause"))
                    (let ((r (if select (run ctl (list-ref starts select) (list-ref ends select) s b ctx) #f)))
                      (if r r (loop nxt))))))
               ((#\{)
                (let-values (((seps close-start close-info nxt) (find-end ctl next hi #\{ #f)))
                  (unless (null? seps) (ferr "misplaced directive ~; in control string" ctl))
                  (let* ((max-iter (resolve (list-ref* ps 0) s))
                         (once? (cadddr close-info))   ; the close's colon flag: at least once
                         (body-ctl-and-range
                          (if (= next close-start)
                              (let ((f (next-arg! s))) (unless (string? f) (ferr "~{~} expects a string" f)) (cons f (cons 0 (string-length f))))
                              (cons ctl (cons next close-start))))
                         (bctl (car body-ctl-and-range)) (blo (cadr body-ctl-and-range)) (bhi (cddr body-ctl-and-range))
                         (src (if at s (let ((l (next-arg! s))) (unless (list? l) (ferr "~{ expects a list" l)) (list->st l)))))
                    (set! outer-state src)
                    (let iter ((n 0))
                      (cond
                        ((and max-iter (>= n max-iter)) (loop nxt))
                        ((and (= (st-left src) 0) (not (and once? (= n 0)))) (loop nxt))
                        (else
                         (let ((r (if colon
                                      (let ((sub (if (= (st-left src) 0) '() (next-arg! src))))
                                        (unless (list? sub) (ferr "~:{ expects a list of lists" sub))
                                        (let ((saved outer-state))
                                          (set! outer-state src)
                                          (let ((r (run bctl blo bhi (list->st sub) b 'colon-list)))
                                            (set! outer-state saved) r)))
                                      (run bctl blo bhi src b 'list))))
                           (cond ((eq? r 'up-all) (loop nxt))
                                 (else (iter (+ n 1)))))))))))
               ((#\()
                (let-values (((seps close-start close-info nxt) (find-end ctl next hi #\( #f)))
                  (let-values (((str r) (capture (lambda (bb) (run ctl next close-start s bb ctx)))))
                    (emit! b (case-convert str colon at))
                    (or r (loop nxt)))))
               ((#\t)
                (when (> (length ps) 2) (ferr "too many parameters for ~t" ctl))
                (let* ((c1 (or (num-param (list-ref* ps 0) s 't) (if at 1 1))) (c2 (or (num-param (list-ref* ps 1) s 't) 1)) (col (buf-col b)))
                  (when (or (< c1 0) (< c2 0)) (ferr "negative parameter for ~t" ctl))
                  (let ((n (if at
                               (let ((target (+ col c1))) (if (> c2 0) (- (* c2 (ceiling (/ target c2))) col) c1))
                               (cond ((< col c1) (- c1 col))
                                     ((= c2 0) 0)
                                     (else (- (+ c1 (* c2 (+ 1 (div (- col c1) c2)))) col))))))
                    (emit! b (make-string (max 0 n) #\space))
                    (finish))))
               ((#\<)
                (let-values (((seps close-start close-info nxt) (find-end ctl next hi #\< #f)))
                  (let* ((mincol (or (num-param (list-ref* ps 0) s '<) 0)) (colinc (or (num-param (list-ref* ps 1) s '<) 1))
                         (minpad (or (num-param (list-ref* ps 2) s '<) 0)) (padchar (or (resolve (list-ref* ps 3) s) #\space))
                         (starts (cons next (map cadr seps))) (ends (append (map car seps) (list close-start)))
                         ;; ~n,m:; at the start of the first segment gives the overflow rule
                         (first-sep-colon (and (pair? seps) #f)))
                    (let* ((segs-up #f)
                           (segments (let sl ((ss starts) (es ends) (acc '()))
                                       (if (null? ss) (reverse acc)
                                           (let-values (((str r) (capture (lambda (bb) (run ctl (car ss) (car es) s bb ctx)))))
                                             (when r (set! segs-up r))
                                             (sl (cdr ss) (cdr es) (cons str acc))))))
                           (nseg (length segments))
                           (total (apply + (map string-length segments)))
                           (before? (or colon (and (= nseg 1) (not at))))
                           (after? at)
                           (nslots (+ (- nseg 1) (if before? 1 0) (if after? 1 0)))
                           (min-total (+ total (* minpad nslots)))
                           (width (let wl ((w mincol)) (if (>= w min-total) w (wl (+ w colinc)))))
                           (padding (- width total))
                           (per (if (> nslots 0) (div padding nslots) 0))
                           (extra (if (> nslots 0) (mod padding nslots) 0))
                           (order (let ol ((k 0) (acc '())) (if (>= k nslots) (reverse acc) (ol (+ k 2) (cons k acc)))))
                           (order (append order (let ol ((k 1) (acc '())) (if (>= k nslots) (reverse acc) (ol (+ k 2) (cons k acc))))))
                           (extra-slots (let tk ((o order) (n extra) (acc '())) (if (or (= n 0) (null? o)) acc (tk (cdr o) (- n 1) (cons (car o) acc)))))
                           (pad (lambda (k) (make-string (+ per (if (memv k extra-slots) 1 0)) padchar))))
                      (let sl2 ((segs segments) (k (if before? 1 0)) (acc (if before? (list (pad 0)) '())))
                        (if (null? segs)
                            (emit! b (apply string-append (reverse (if after? (cons (pad (- nslots 1)) acc) acc))))
                            (sl2 (cdr segs) (+ k 1)
                                 (if (null? (cdr segs)) (cons (car segs) acc) (cons (pad k) (cons (car segs) acc))))))
                      (or segs-up (loop nxt))))))
               ((#\f) (format-fixed 'f ps colon at s b) (finish))
               ((#\e) (format-exp 'e ps at s b) (finish))
               ((#\g) (format-general 'g ps at s b) (finish))
               ((#\$) (format-dollar '$ ps at colon s b) (finish))
               (else (ferr "unrecognized directive in control string" ctl))))))
        (else
         (let find ((k i))
           (if (and (< k hi) (not (char=? (string-ref ctl k) #\~)))
               (find (+ k 1))
               (begin (emit! b (substring ctl i k)) (loop k))))))))

  (define outer-state #f)
  (define lenient #f)
  (define (outer-empty?) (or (not outer-state) (= (st-left outer-state) 0)))

  (define (do-format who ctl args b)
    (unless (string? ctl) (ferr "control string is not a string" ctl))
    (let ((s (list->st args)))
      (set! outer-state #f)
      (set! lenient #f)
      (run ctl 0 (string-length ctl) s b #f)
      (when (and (> (st-left s) 0) (not lenient)) (ferr "too many arguments" ctl))))

  (define (format first . rest)
    (cond
      ((string? first)
       (let ((b (new-buf))) (do-format 'format first rest b) (buf->string b)))
      ((and (pair? rest) (string? (car rest)) (or (not first) (eq? first #t) (output-port? first)))
       (let ((b (new-buf)))
         (do-format 'format (car rest) (cdr rest) b)
         (cond ((not first) (buf->string b))
               ((eq? first #t) (display (buf->string b) (current-output-port)))
               (else (display (buf->string b) first)))))
      (else (ferr "invalid arguments" first))))

  (define (printf ctl . args)
    (unless (string? ctl) (ferr "control string is not a string" ctl))
    (let ((b (new-buf))) (do-format 'printf ctl args b) (display (buf->string b) (current-output-port))))
  (define (fprintf port ctl . args)
    (unless (and (output-port? port) (string? ctl)) (ferr "invalid arguments" port))
    (let ((b (new-buf))) (do-format 'fprintf ctl args b) (display (buf->string b) port)))
)

;; Arbace's patches to the vendored psyntax (doc/scheme/SCHEME-SURVEY.md, "As built: SM4"), applied to the text the
;; forms print (bin/si psyntax-sources) before the bootstrap; each :from occurs once in its file.
[
 {:file "expander"
  :why "R6RS's (rnrs) does not export environment, environment?, eval, syntax-error, null-environment or scheme-report-environment (they are (rnrs eval)'s and (rnrs r5rs)'s, or Ikarus's); Chez, the bootstrap host, refuses to except what a library does not export"
  :from "    (except (rnrs)
      environment environment? identifier?
      eval generate-temporaries free-identifier=?
      bound-identifier=? datum->syntax syntax-error
      syntax-violation syntax->datum make-variable-transformer
      null-environment scheme-report-environment)"
  :to "    (except (rnrs)
      identifier?
      generate-temporaries free-identifier=?
      bound-identifier=? datum->syntax
      syntax-violation syntax->datum make-variable-transformer)"}
 {:file "expander"
  :why "Arbace's driver expands programs and libraries to their core forms, which compile-r6rs-top-level and eval keep inside"
  :from "new-interaction-environment syntax-transpose)"
  :to "new-interaction-environment syntax-transpose
          ;; Arbace: the drivers' entry points (arbace.scheme.expand)
          top-level-expander library-expander program-expander)"}
 {:file "expander"
  :why "the program's expansion for the driver, without the interaction environment"
  :from "  (define compile-r6rs-top-level
"
  :to "  ;; Arbace: a program expanded without exporting its top-level bindings (top-level-expander exports them all,
  ;; for compile-r6rs-top-level's interaction environment: quadratic in the bindings of the imports)
  (define (program-expander e*)
    (let-values (((imp* b*) (parse-top-level-program e*)))
      (let-values (((imp* invoke-req* visit-req* invoke-code macro* export-subst export-env)
                    (library-body-expander '() imp* b* #t)))
        (values invoke-req* invoke-code))))

  (define compile-r6rs-top-level
"}

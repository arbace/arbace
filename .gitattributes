# Arbace sources (.ae): Clojure plus the Java forms and the Go forms; highlighted as Clojure
*.ae linguist-language=Clojure
# Arbace's version in a tarball (VERSION, bin/lib/version.bash): git archive fills it
/VERSION export-subst
# The JDK's forms and data (jdk/README.md): generated by bin/jrt-convert, kept byte for byte (its
# verify compares them); the data as binary, java.security among them (no end-of-line conversion)
/jdk/forms/** linguist-generated
/jdk/edge.edn linguist-generated
/jdk/data/** binary
# The suite's Java fixtures' forms (test/java-fixtures/README.md): generated by bin/clojure-tests
# --java-fixtures, kept byte for byte (its verify compares them)
/test/java-fixtures/forms/** linguist-generated
# repr/haskell's mode :full cases (bin/repr-haskell test): Haskell text kept byte for byte (a CRLF,
# tabs, a form feed, trailing blanks), no end-of-line conversion
/test/haskell/full/** -text

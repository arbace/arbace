$_jdksum  $_jdktar
27eb13c3907255364223e357e6262ca42619468d7f48822fe4b3598bab292f5f5e737a42dd3de37eaa197c0f15455a626b477df96e79d3b9460d51024bdb9273  arbace.sh
a1e8c1d1ca0dd70d2d54e8ebf6b828015c055d38d21ad71c80d94cbd986fb692334498ab24621361c71f145fc95109ea83c76e287bd3a93042389735a37e95f7  arb.sh

diff --git a/bin/arbace b/bin/arbace
index af09b95..dc9d744 100755
--- a/bin/arbace
+++ b/bin/arbace
@@ -4,9 +4,9 @@
 # With the JDK AOT cache target/arbace.aot (JEP 483, 514) the classes come from the cache,
 # already loaded and linked; it holds no method profiles (JEP 515, see --aot-train). The cache
 # applies only when it was made by this JDK build from this jar with these JVM options: the
-# launcher uses it only when it is newer than the jar, and the JVM checks the rest; if the check
-# fails, the JVM runs without it, silently (its AOT logging is off). Without the cache (or with
-# ARBACE_AOT=off) the launch takes the jar alone.
+# launcher uses it only when it is not older than the jar, and the JVM checks the rest; if the
+# check fails, the JVM runs without it, silently (its AOT logging is off). Without the cache (or
+# with ARBACE_AOT=off) the launch takes the jar alone.
 #
 # Usage: bin/arbace [ARG...]
 #        bin/arbace --aot-train < WORKLOAD   make the cache: a training run of the jar
@@ -54,7 +54,9 @@ if [ "${1:-}" = "--aot-train" ]; then
   exec "$java" "${opts[@]}" -XX:+UnlockDiagnosticVMOptions -XX:-AOTRecordTraining \
     -XX:AOTCacheOutput="$cache" -cp "$jar" arbace.lang.Main "$@"
 fi
-if [ "${ARBACE_AOT:-}" != off ] && [ "$cache" -nt "$jar" ]; then
+# The cache is used when it is not older than the jar: apk (dist/alpine/) installs every file
+# with the same mtime, and the package trains the cache against the jar so dated
+if [ "${ARBACE_AOT:-}" != off ] && [ -f "$cache" ] && [ ! "$jar" -nt "$cache" ]; then
   opts+=(-XX:AOTCache="$cache" '-Xlog:aot*=off' '-Xlog:cds*=off')
 fi
 exec "$java" "${opts[@]}" -cp "$cp" arbace.lang.Main "$@"

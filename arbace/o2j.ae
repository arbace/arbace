(ns arbace.o2j
  "o2j, OCaml's Lambda → Java forms (doc/ocaml/OCAML-SURVEY.md, O6 and OC7 (a); \"As built: O6
  (write-ahead)\"): a unit's Lambda dump (tools/ocdump's, SPEC §11.2: the bytecode translation,
  simplified, OC60) becomes one Java form, the class ocaml.u.M_<Unit>, against the runtime
  ocaml.rt (jdk/ocaml/: values, primitives, externals); a program's units in link order get a
  main class, ocaml.u.M__main. The Java forms are what j2g translates for the compiled level and
  what the Java forms' interpreter runs at the light level (test/ocaml/o2j/run.ae).

  The translation (OC82-OC86):
  - a unit's module block is the static field G, its initialisation the static method init;
    the constants are static fields; a global is the unit's G, a predefined exception Rt's field;
  - a Lambda function is a member class of the unit's (F<n>, extends Closure), its free
    variables as fields given to its constructor, its code the method a<arity> (an above six);
    a letrec's closures are made first and their fields that name each other set after;
  - an application calls a<n> when the closure's arity is the argument count, else Rt/ap;
    the arguments (and then the function) are evaluated right to left, as ocamlc's code does;
    a function's application of itself in tail position is a loop (continue), other tail
    calls are calls (OC84);
  - staticcatch is a label around the body, the exit a break to it, its variables mutable locals;
    a switch is Java's switch on the int or the block's tag; trywith catches every Throwable
    and asks Rt/exnValue for the OCaml exception (the Java stack's overflow is Stack_overflow);
  - the primitives are Rt's methods; the externals (\"caml_...\") the Ext classes' static
    methods of the same name and argument count, or a throw of Rt/missing when the runtime has none."
  (:require [arbace.string :as str]
            [arbace.java.io :as io])
  (:import (java.io File PushbackReader Writer)))

;; ---------------------------------------------------------------------------------------------
;; the dump

(defn- dump-of
  "The dump of form x (SRC names it in errors): {:module :name :size :required :code}."
  [x src]
  (when-not (and (seq? x) (= 'ocaml/lambda (first x)))
    (throw (ex-info (str "not a Lambda dump: " src) {:head (when (seq? x) (first x))})))
  (let [[_ module size required code] (second x)
        [h n] code
        nm (when (and (= 'prim h) (str/starts-with? n "setglobal ")) (subs n 10))]
    (when-not nm (throw (ex-info "the unit's code is not a setglobal" {:file (str src)})))
    {:module module :size size :required required :code code
     :name (str/replace (str/replace nm #"!$" "") #"/.*$" "")}))

(defn read-dump
  "A Lambda dump: {:module :name :size :required :code}."
  [^File f]
  (dump-of (with-open [r (PushbackReader. (io/reader f))] (read r)) f))

(defn- node-body
  "A node's fields: the form less its head and a trailing metadata map."
  [x]
  (let [t (rest x)] (if (and (seq t) (map? (last t))) (butlast t) t)))

(defn- realize
  "x with every lazy sequence in it realized (they read *unit*), metadata kept."
  [x]
  (cond (seq? x) (with-meta (apply list (map realize x)) (meta x))
        (vector? x) (with-meta (mapv realize x) (meta x))
        :else x))

(defn- hd [x] (when (seq? x) (first x)))

;; ---------------------------------------------------------------------------------------------
;; names

(def predefs
  #{"Out_of_memory" "Sys_error" "Failure" "Invalid_argument" "End_of_file" "Division_by_zero"
    "Not_found" "Match_failure" "Stack_overflow" "Sys_blocked_io" "Assert_failure"
    "Undefined_recursive_module"})

(defn class-name "The Java class of unit M." [m] (str "M_" m))

(defn- munge-id [^String id] (symbol (str/replace id #"[^A-Za-z0-9_]" "_")))

(defn- global-name [^String s] (-> s (str/replace #"!$" "") (str/replace #"/.*$" "")))

;; ---------------------------------------------------------------------------------------------
;; the externals' table: name -> [class arity], read from the runtime's forms

(defn- runtime-externals
  "The externals the runtime's Java forms define: every public static method named caml_...
  of a class of DIR (jdk/ocaml/ocaml/rt), with its parameter count."
  [^File dir]
  (into {}
        (for [^File f (sort-by #(.getName ^File %) (.listFiles dir))
              :when (str/ends-with? (.getName f) ".ae")
              form (with-open [r (PushbackReader. (io/reader f))]
                     (doall (take-while #(not= % ::eof) (repeatedly #(read {:eof ::eof} r)))))
              :when (= 'defclass (hd form))
              :let [cls (name (second form))]
              m (rest form)
              ;; the C runtime's caml_* primitives, and the Str library's re_* (otherlibs/str/strstubs.c's names, ExtStrRe)
              :when (and (= 'method (hd m)) (or (str/starts-with? (name (second m)) "caml_") (str/starts-with? (name (second m)) "re_")))
              :let [params (first (filter vector? (drop 2 m)))]]
          [(name (second m)) [(symbol (str "ocaml.rt." cls)) (count params)]])))

(def ^:dynamic *externals* {})

;; the compiled level (OC93 (a)): a program's own units in a package of their own (ocaml.p<N>), the library's in ocaml.u;
;; *pkg* the package of the program's units, *own* their names (the globals that name them are theirs, not the library's)
(def ^:dynamic *pkg* "ocaml.u")
(def ^:dynamic *own* #{})
;; the compiled level's files: each unit's file starts (in-ns 'PKG) and its imports, a package's namespace file
;; (ocaml/u.ae, ocaml/p<N>.ae) apart, as j2g's trees take them (a file whose first form is ns is a package file)
(def ^:dynamic *in-ns* false)
;; the compiled level's plugins (OC220 (a)'s compiled half, queue 373-1): the units a program's Dynlink may load, translated ahead
;; into its package (classes D_<unit>) behind its main class's registry; *plugin* the one being translated
(def ^:dynamic *plugins* #{})
(def ^:dynamic *plugin* nil)

(defn pkg-of "The package of unit m's class." [m] (if (or (contains? *own* m) (contains? *plugins* m)) *pkg* "ocaml.u"))

(defn class-of
  "The qualified name of unit m's class: a program's own unit's M_m in *pkg*, a plugin's D_m there (the compiled level's Dynlink,
  queue 373-1: a plugin may share its name with a unit of the program, pr4229's sub/abstract), the plugin being translated its own,
  else the library's ocaml.u.M_m."
  [m]
  (cond (= m *plugin*) (str *pkg* ".D_" m)
        (contains? *own* m) (str *pkg* "." (class-name m))
        (contains? *plugins* m) (str *pkg* ".D_" m)
        :else (str "ocaml.u." (class-name m))))

(defn- header-forms [pkg imports]
  (if *in-ns*
    (cond-> [(list 'in-ns (list 'quote (symbol pkg)))]
      imports (conj (list 'import (list 'quote imports))))
    [(if imports (list 'ns (symbol pkg) (list :import imports)) (list 'ns (symbol pkg)))]))

(defn load-externals! [dir] (alter-var-root #'*externals* (constantly (runtime-externals (io/file dir)))))

;; ---------------------------------------------------------------------------------------------
;; the unit's state

(def ^:dynamic *unit*
  "{:class sym, :name the unit, :n counter atom, :classes atom (member classes), :consts atom
  ([sym init]...), :ints atom {n field}, :blocks atom {block constant field} (queue 527), :missing atom {name count}}"
  nil)

(defn- fresh [prefix] (symbol (str prefix (swap! (:n *unit*) inc))))

(defn- unit-class [] (:class *unit*))

(defn- note-missing! [n] (swap! (:missing *unit*) update n (fnil inc 0)))

;; ---------------------------------------------------------------------------------------------
;; constants

(def ^:private UNIT 'ocaml.rt.Rt/UNIT)

(defn- latin1 "A Java string of chars 0-255 from an immstring's payload (a string or byte values)."
  [s]
  (if (string? s)
    (let [b (.getBytes ^String s java.nio.charset.StandardCharsets/UTF_8)]
      (String. ^bytes b java.nio.charset.StandardCharsets/ISO_8859_1))
    (String. (char-array (map #(char (bit-and (long %) 255)) s)))))

(defn- parse-float [^String t]
  (let [t (str/replace t "_" "")
        t (if (and (re-find #"^-?0[xX]" t) (not (re-find #"[pP]" t))) (str t "p0") t)]
    (Double/parseDouble t)))

(defn- double-form [^double d]
  (if (or (Double/isNaN d) (Double/isInfinite d))
    (list 'Double/longBitsToDouble (Double/doubleToRawLongBits d))
    d))

(declare const-form)

(defn- const-init
  "The Java form that makes constant c (once: the unit's static field holds it); a block's fields that are blocks the unit's shared
  ones (const-form)."
  [c]
  (let [[h a] c]
    (case h
      (int char) (list 'Long/valueOf a)
      float (list 'Double/valueOf (double-form (parse-float a)))
      int32 (list 'Integer/valueOf (list 'unchecked-int (Long/parseLong a)))
      int64 (list 'ocaml.rt.I64. (Long/parseLong a))
      nativeint (list 'ocaml.rt.NInt. (Long/parseLong a))
      immstring (list 'ocaml.rt.Rt/s (latin1 a))
      float-array (list 'new 'double/1 (mapv #(double-form (parse-float %)) a))
      block (let [[_ tag fs] c]
              (list 'ocaml.rt.Rt/block (list 'unchecked-int tag)
                    (list 'new 'Object/1 (mapv #(if (and (= 'block (first %)) (:blocks *unit*)) (const-form %) (const-init %)) fs))))
      (throw (ex-info (str "constant " h) {:const c})))))

(defn- const-form
  "A constant as an expression: a static field of the unit, one per int value (queue 414: (Long/valueOf n) in place was a call
  of a host method, by reflection at the light level, at each evaluation)."
  [c]
  (let [[h a] c]
    (if (#{'int 'char} h)
      (if-let [ints (:ints *unit*)]
        (let [v (long a)]
          (or (get @ints v)
              (let [k (fresh "i")
                    f (symbol (str (unit-class)) (name k))]
                (swap! (:consts *unit*) conj [k (list 'Long/valueOf v)])
                (swap! ints assoc v f)
                f)))
        (list 'Long/valueOf a))
      (if-let [blocks (and (= 'block h) (:blocks *unit*))]
        ;; (queue 527) a block constant once a unit, shared by every occurrence of an equal one, its fields' blocks too: ocamlopt's
        ;; Closure makes each structured constant a label by Compilenv.new_structured_constant ~shared:true, one for structurally
        ;; equal constants (lib-marshal/intext's `let x = D "sharing" in G(x, x)`, folded into one constant whose fields are x's,
        ;; physically equal)
        (or (get @blocks c)
            (let [init (const-init c)
                  k (fresh "k")
                  f (symbol (str (unit-class)) (name k))]
              (swap! (:consts *unit*) conj [k init])
              (swap! blocks assoc c f)
              f))
        (let [k (fresh "k")]
          (swap! (:consts *unit*) conj [k (const-init c)])
          (symbol (str (unit-class)) (name k)))))))

;; ---------------------------------------------------------------------------------------------
;; free variables

(declare free-ids)

(defn- bound-and-refs
  "[bound refs]: the ids a node binds and those it refers to, nested functions included."
  [x]
  (let [bound (volatile! #{}) refs (volatile! #{})]
    (letfn [(walk [x]
              (when (seq? x)
                (let [h (first x) b (node-body x)]
                  (case h
                    (var mutvar) (vswap! refs conj (first b))
                    const nil
                    function (let [[_ ps _ body] b]
                               (doseq [[p] ps] (vswap! bound conj p))
                               (walk body))
                    (let mutlet) (let [[id def body] (if (= h 'let) (drop 2 b) (drop 1 b))]
                                   (vswap! bound conj id) (walk def) (walk body))
                    letrec (let [[bs body] b]
                             (doseq [[id f] bs] (vswap! bound conj id) (walk f))
                             (walk body))
                    for (let [[id lo hi _ body] b] (vswap! bound conj id) (walk lo) (walk hi) (walk body))
                    trywith (let [[body id handler] b] (vswap! bound conj id) (walk body) (walk handler))
                    staticcatch (let [[body [_ vs] handler] b]
                                  (doseq [[v] vs] (vswap! bound conj v))
                                  (walk body) (walk handler))
                    assign (let [[id e] b] (vswap! refs conj id) (walk e))
                    (doseq [y b] (walk-any y))))))
            (walk-any [y] (cond (seq? y) (walk y) (vector? y) (doseq [z y] (walk-any z)) :else nil))]
      (walk x))
    [@bound @refs]))

(defn- free-ids
  "The ids function node f refers to and does not bind, sorted."
  [f]
  (let [[bound refs] (bound-and-refs f)]
    (sort (remove bound refs))))

;; ---------------------------------------------------------------------------------------------
;; expressions

(declare expr test-form)

;; ctx: {:env {id form} :exits {n {:label kw :vars [sym]}} :self {:id id :label kw :used atom :arity n}}

(defn- lookup [ctx id]
  (or (get (:env ctx) id)
      (throw (ex-info (str "unbound Lambda variable " id) {:id id}))))

(defn- simple?
  "A node whose evaluation has no effect and reads nothing mutable: it may be evaluated out of order."
  [x]
  (let [h (hd x)]
    (or (= 'var h) (= 'const h)
        (and (= 'prim h)
             (let [[n args] (node-body x)]
               (or (str/starts-with? n "global ")
                   (and (str/starts-with? n "field_imm ") (simple? (first args)))))))))

(defn- with-args
  "Evaluates arg nodes right to left (as ocamlc's code does) and calls (k forms): every argument
  that is not simple but the leftmost such one is bound to a temporary first, from the right."
  [ctx nodes k]
  (let [impure (keep-indexed (fn [i x] (when-not (simple? x) i)) nodes)
        bind (set (rest impure))
        temps (into {} (for [i bind] [i (fresh "t$")]))
        forms (vec (map-indexed (fn [i x] (or (temps i) (expr ctx x false))) nodes))
        bindings (vec (mapcat (fn [i] [(temps i) (expr ctx (nth nodes i) false)])
                              (reverse (sort bind))))
        body (k forms)]
    (if (seq bindings) (list 'let bindings body) body)))

(defn- call-form
  "The application of function form f to argument forms (already evaluated, simple). A closure is cast in place, Rt/fn called
  only for another value (queue 414: at the light level each interpreted call is a frame)."
  [f args]
  (let [n (count args)]
    (if (<= 1 n 6)
      (let [c (fresh "c$") v (fresh "f$")]
        (list 'let [v f
                    c (list 'if (list 'instance? 'ocaml.rt.Closure v) (list 'cast 'ocaml.rt.Closure v) (list 'ocaml.rt.Rt/fn v))]
              (list 'if (list '== (list '.-arity c) n)
                    (apply list (symbol (str ".a" n)) c args)
                    (list 'ocaml.rt.Rt/ap c (list 'new 'Object/1 (vec args))))))
      (list 'ocaml.rt.Rt/ap f (list 'new 'Object/1 (vec args))))))

;; ---- backtraces (OC217 (a)'s fifth stage, queue 370; oi's compile.go event, applyEvNode, primEv, raiseNode): a -g unit's
;; after-events, `(event L [KIND DEF FILE L1 C1 EOFF L2 C2])`, are the slots of Bt's shadow stack

(defn- ev-info "An event's information vector, nil without one (an oracle's dump)." [info]
  (when (and (vector? info) (>= (count info) 8)) info))

(defn- slot-ref
  "The unit's static field holding the slot of event information info (a raise's, a primitive's)."
  [info raise? prim?]
  (let [[_ def file l1 c1 eoff l2 c2] info k (fresh "bt")]
    (swap! (:slots *unit*) conj [k (list 'ocaml.rt.Bt/slot def file l1 c1 eoff l2 c2 raise? prim?)])
    (symbol (str (unit-class)) (name k))))

(defn- has-event? "Whether node x holds an event with its information." [x]
  (cond (seq? x) (or (and (= 'event (first x)) (some? (ev-info (second (node-body x))))) (some has-event? x))
        (vector? x) (some has-event? x)
        :else false))

(defn- with-all-args
  "Evaluates arg nodes right to left into temporaries (every one that is not simple) and calls (k forms temps): nothing is
  evaluated inside k's form (a slot entered after the arguments); k clears the temporaries after its call (`clear`), so that a
  value only an argument held is not kept from the collector by the frame (callstack's finaliser)."
  [ctx nodes k]
  (let [temps (into {} (keep-indexed (fn [i x] (when-not (simple? x) [i (with-meta (fresh "t$") {:mutable true :tag 'Object})])) nodes))
        forms (vec (map-indexed (fn [i x] (or (temps i) (expr ctx x false))) nodes))
        bindings (vec (mapcat (fn [i] [(temps i) (expr ctx (nth nodes i) false)]) (reverse (sort (keys temps)))))
        body (k forms (vals temps))]
    (if (seq bindings) (list 'let bindings body) body)))

(defn- clear "The forms that clear temporaries ts." [ts] (map (fn [t] (list 'set! t nil)) ts))

(def ^:private bt-pop
  "Bt/pop in place (queue 414)."
  '(set! ocaml.rt.Bt/sp (unchecked-dec-int ocaml.rt.Bt/sp)))

(def ^:private tick-forms
  "Rt/tick in place (queue 453: a loop's turn without a frame): the turn counted, the slow path past 128."
  '[(set! ocaml.rt.Rt/ticks (unchecked-inc-int ocaml.rt.Rt/ticks))
    (when (> ocaml.rt.Rt/ticks 128) (ocaml.rt.Rt/tickSlow))])

(def ^:private enter-forms
  "Rt/enter in place (queue 453: a call's entry without a frame): the depth and the turn counted, the slow path (the turn's work,
  the depth's limit) past 128 turns."
  '[(set! ocaml.rt.Rt/depth (unchecked-inc-int ocaml.rt.Rt/depth))
    (set! ocaml.rt.Rt/ticks (unchecked-inc-int ocaml.rt.Rt/ticks))
    (when (> ocaml.rt.Rt/ticks 128) (ocaml.rt.Rt/enterSlow))])

(defn- around-slot "Form f run with slot ev entered, then temporaries ts cleared." [ev f & [ts]]
  (let [r (fresh "r$")]
    (list 'do (list 'ocaml.rt.Bt/push ev) (concat (list 'let [r f]) (clear ts) [bt-pop r]))))

(defn- apply-ev-node
  "A non-tail application with an after-event: its slot entered once the arguments and the function are evaluated (bytegen's
  APPLY1-3), before the arguments for four or more (PUSH_RETADDR)."
  [ctx [f args] ev]
  (if (>= (count args) 4)
    (let [r (fresh "r$")]
      (list 'do (list 'ocaml.rt.Bt/push ev)
            (with-all-args ctx (into [f] args)
                           (fn [as ts] (concat (list 'let [r (call-form (first as) (rest as))]) (clear ts) [bt-pop r])))))
    (with-all-args ctx (into [f] args) (fn [as ts] (around-slot ev (call-form (first as) (rest as)) ts)))))

(declare prim-value const-arg)
(def ^:private ^:dynamic *simple-args* "Whether the primitive's argument nodes are all simple (prim-node), or all
  evaluated into temporaries (with-all-args): the inlined makeblock writes them twice." false)

(defn- event-node
  "(event L [INFO]): in tail position, or without information, L alone (bytegen drops the event to keep the tail call); around
  an event, the inner one; around an application or a primitive, their slot entered as they are called; else around L."
  [ctx [inner info] tail?]
  (let [info (ev-info info)]
    (if (or (nil? info) tail?)
      (expr ctx inner tail?)
      (case (hd inner)
        event (expr ctx inner tail?)
        apply (apply-ev-node ctx (node-body inner) (slot-ref info false false))
        prim (let [[n args] (node-body inner)]
               (if (or (#{"&&" "||" "sequand" "sequor" "runstack" "resume" "reperform" "raise" "reraise" "raise_notrace"} n)
                       (str/starts-with? n "setglobal ") (str/starts-with? n "global ")
                       ;; a static block (const-arg) allocates nothing and cannot raise: no slot
                       (and (str/starts-with? n "makeblock") (seq args) (const-arg ctx inner)))
                 (expr ctx inner false)
                 (let [ev (slot-ref info false true)]
                   (with-all-args ctx args (fn [as ts] (around-slot ev (binding [*simple-args* true] (prim-value n as)) ts))))))
        (around-slot (slot-ref info false false) (expr ctx inner false))))))

(defn- raise-slot
  "A raise's argument and slot: the innermost event of the argument (the one at the RAISE's pc), marked a raise; an argument
  that is no call is its value alone; with none, 0 (a compiler-inserted raise, skipped when printed)."
  [x]
  (loop [x x]
    (let [info (when (= 'event (hd x)) (ev-info (second (node-body x))))]
      (if (nil? info)
        [x 0]
        (let [inner (first (node-body x))]
          (cond (= 'event (hd inner)) (recur inner)
                (#{'apply 'prim} (hd inner)) [x (slot-ref info true false)]
                :else [inner (slot-ref info true false)]))))))

(defn- apply-node [ctx [f args] tail?]
  (let [self (:self ctx)]
    (if (and tail? self (= 'var (hd f)) (= (second f) (:id self)) (= (count args) (:arity self)))
      (do (reset! (:used self) true)
          (with-args ctx args (fn [as] (apply list 'continue (:label self) as))))
      ;; a tail call of another function of the letrec group (OC84 (c)): a TailCall the group function's entry bounces
      (if (and tail? (:group ctx) (= 'var (hd f)) (= (get (:group ctx) (second f)) (count args)))
        (do (reset! (:tails ctx) true)
            (with-args ctx (into [f] args)
                       (fn [as] (list 'new 'ocaml.rt.TailCall (first as) (list 'new 'Object/1 (vec (rest as)))))))
      ;; arguments right to left, then the function
      (if (simple? f)
        (with-args ctx args (fn [as] (call-form (expr ctx f false) as)))
        (with-args ctx (into [f] args) (fn [as] (call-form (first as) (rest as)))))))))

;; ---- functions

(defn- method-for [arity params body]
  (if (<= arity 6)
    (list 'method (with-meta (symbol (str "a" arity)) {:public true}) (into ['this] params) body)
    (let [a (symbol "args$")]
      (list 'method (with-meta 'an {:public true}) ['this (with-meta a {:tag 'Object/1})]
            (list 'let (vec (mapcat (fn [i p] [p (list 'aget a i)]) (range) params)) body)))))

(defn- closure-class!
  "Defines the member class of function node f (its free variables fields, self-id's references
  `this`); returns [class-sym free-ids]."
  [ctx f self-id & [group]]
  (let [[kind ps _ body] (node-body f)
        cls (fresh "F")
        free (remove #(= % self-id) (free-ids f))
        params (mapv (comp munge-id first) ps)
        arity (count ps)
        fields (mapv munge-id free)
        env (merge (into {} (map (fn [id s] [id s]) free fields))
                   (into {} (map (fn [[p] s] [p s]) ps params))
                   (when self-id {self-id 'this}))
        used (atom false)
        lbl (keyword (str "self" (swap! (:n *unit*) inc)))
        tails (atom false)
        ictx {:env env :exits {} :self (when self-id {:id self-id :label lbl :used used :arity arity})
              :group (not-empty (dissoc group self-id)) :tails tails}
        b (realize (expr ictx body true))
        ;; a self tail call's loop ticks each turn (Rt/tick: other domains get the lock)
        b (if @used (list 'label lbl (list 'loop (vec (mapcat (fn [p] [p p]) params)) (concat (list 'do) tick-forms [b]))) b)
        ;; a function of a letrec group of several (OC84 (c)): its body the method tb, which returns a TailCall for a tail call
        ;; of another of the group; its entry calls tb and bounces (Rt/bounce: each TailCall's function's tb in turn, in one
        ;; frame). Every function of such a group has a tb, being a TailCall's target or not
        _ (when (:group ictx) (reset! tails true))
        a (symbol "args$")
        tb (when @tails
             (list 'method (with-meta 'tb {:public true}) ['this (with-meta a {:tag 'Object/1})]
                   (list 'let (vec (mapcat (fn [i p] [p (list 'aget a i)]) (range) params)) b)))
        b (if @tails (list 'ocaml.rt.Rt/bounce (list '.tb 'this (list 'new 'Object/1 params))) b)
        ;; the call depth (OC92 (a)): counted on entry, given back on the way out (an exception's way out is the handler's,
        ;; trywith-node)
        r (fresh "r$")
        b (concat (list 'do) enter-forms [(list 'let [r b] '(set! ocaml.rt.Rt/depth (unchecked-dec-int ocaml.rt.Rt/depth)) r)])]
    (when (= kind :tupled) (throw (ex-info "tupled function" {})))
    (swap! (:classes *unit*) conj
           (concat
            (list 'defclass (with-meta cls {:public true :static true}) :extends 'ocaml.rt.Closure)
            (for [fl fields] (list 'field (with-meta fl {:public true})))
            [(concat (list 'constructor (with-meta (into ['this] fields) {:public true})
                           (list 'super. arity))
                     (for [fl fields] (list 'set! (list (symbol (str ".-" fl)) 'this) fl)))
             (method-for arity params b)
             ;; Marshal's Closures flag (OC216 (a); ocaml.rt.Marshal's closureFields, fixClosures): the free variables, a closure
             ;; of the class with none set, and their setting
             (list 'method (with-meta 'envOf {:public true}) (with-meta ['this] {:tag 'Object/1})
                   (if (seq fields)
                     (list 'new 'Object/1 (mapv (fn [fl] (list (symbol (str ".-" fl)) 'this)) fields))
                     (list 'new 'Object/1 0)))
             (list 'method (with-meta 'blank {:public true}) (with-meta ['this] {:tag 'ocaml.rt.Closure})
                   (apply list (symbol (str cls ".")) (repeat (count fields) nil)))
             (concat (list 'method (with-meta 'fill {:public true}) (with-meta ['this (with-meta 'e$ {:tag 'Object/1})] {:tag 'ocaml.rt.Closure}))
                     (map-indexed (fn [i fl] (list 'set! (list (symbol (str ".-" fl)) 'this) (list 'aget 'e$ i))) fields)
                     ['this])]
            (when tb [tb])))
    [cls free]))

(defn- function-node [ctx f]
  (let [[cls free] (closure-class! ctx f nil)]
    (apply list (symbol (str cls ".")) (map #(lookup ctx %) free))))

(defn- letrec-node [ctx [bs body] tail?]
  (let [ids (map first bs)
        idset (set ids)
        syms (into {} (for [id ids] [id (munge-id id)]))
        ctx2 (update ctx :env merge syms)
        ;; the group's functions and their arities (OC84 (c): their tail calls of each other bounce)
        group (into {} (for [[id f] bs :when (= 'function (hd f))] [id (count (second (node-body f)))]))
        made (for [[id f] bs] (let [[cls free] (closure-class! ctx2 f id group)] [id cls free]))
        made (doall made)]
    (list 'let (vec (mapcat (fn [[id cls free]]
                              [(syms id) (apply list (symbol (str cls "."))
                                                (map #(if (idset %) nil (lookup ctx2 %)) free))])
                            made))
          (concat (list 'do)
                  (for [[id _ free] made, fr free :when (idset fr)]
                    (list 'set! (list (symbol (str ".-" (munge-id fr))) (syms id)) (syms fr)))
                  [(expr ctx2 body tail?)]))))

;; ---- lets

(defn- let-chain
  "Consecutive let and mutlet nodes as one let. A let of a constant (or of an immutable block of constants) records the constant
  as the variable's value (:kconst), Closure's Value_const approximation that makes such a block static (const-arg)."
  [ctx x tail?]
  (loop [x x ctx ctx bindings []]
    (case (hd x)
      let (let [[_ _ id def body] (node-body x)
                s (munge-id id)
                k (const-arg ctx def)
                ctx2 (cond-> (assoc-in ctx [:env id] s) k (assoc-in [:kconst id] k) (nil? k) (update :kconst dissoc id))]
            (recur body ctx2 (conj bindings s (expr ctx def false))))
      mutlet (let [[_ id def body] (node-body x)
                   s (with-meta (munge-id id) {:mutable true :tag 'Object})]
               (recur body (assoc-in ctx [:env id] (munge-id id)) (conj bindings s (expr ctx def false))))
      (list 'let bindings (expr ctx x tail?)))))

;; ---- primitives

(defn- num-arg [^String n] (Long/parseLong (first (str/split (str/trim (subs n (inc (.indexOf n " ")))) #"\s+"))))

(declare inline-prim)

(defn- rt [m & args]
  (or (inline-prim m args)
      (apply list (symbol "ocaml.rt.Rt" (name m)) args)))

;; ---- the hot primitives in place (queue 414): at the light level each call of an Rt method is an interpreted call, a frame
;; allocated, and the collector's work after it; the fast path (ints that are Longs, a block's field) is written into the code,
;; the Rt method called for any other value, which does what it did (its error, its other representations)

(defn- bind-vals
  "Calls (k syms) with forms xs bound to locals, in order, where a form is not already a symbol (each evaluated once)."
  [xs k]
  (let [ps (mapv (fn [x] (if (symbol? x) [x nil] [(fresh "v$") x])) xs)
        bs (vec (mapcat (fn [[t x]] (when (some? x) [t x])) ps))
        body (k (mapv first ps))]
    (if (seq bs) (list 'let bs body) body)))

(defn- unbox
  "A Long's long; an inlined int primitive's value (boxed by (cast Object ...), queue 453) unboxed by taking its long."
  [x]
  (if (and (seq? x) (= 'cast (first x)) (= 'Object (second x)) (seq? (nth x 2 nil)) (= 'bit-shift-right (first (nth x 2))))
    (nth x 2)
    (list 'long (list 'cast 'Long x))))

(defn- inline-prim
  "The form of Rt's primitive m on args with its fast path in place, nil when m has none."
  [m args]
  (let [slow (fn [& xs] (apply list (symbol "ocaml.rt.Rt" (name m)) xs))
        ints? (fn [xs] (cons 'and (map #(list 'instance? 'Long %) xs)))]
    (cond
      (= 'b m) (list 'if (first args) 'ocaml.rt.Rt/TRUE 'ocaml.rt.Rt/FALSE)
      (= 't m)
      (bind-vals args (fn [[x]] (list 'if (list 'instance? 'Long x) (list 'not (list '== 0 (unbox x))) true)))
      ;; (queue 453) the int primitives unboxed in place, no call: OCaml's types make their arguments ints (Longs); a value
      ;; that is not (Obj.magic's) fails the cast, where Rt's method raised its internal error. The result boxed by a cast to
      ;; Object, as every node's value (a primitive long bound by a let fails instance?: ast-invariants' load)
      (#{'add 'sub 'mul} m)
      (let [[a b] args op ({'add 'unchecked-add 'sub 'unchecked-subtract 'mul 'unchecked-multiply} m)]
        (list 'cast 'Object (list 'bit-shift-right (list 'bit-shift-left (list op (unbox a) (unbox b)) 1) 1)))
      (= 'offset m)
      (let [[a n] args] (list 'cast 'Object (list 'bit-shift-right (list 'bit-shift-left (list 'unchecked-add (unbox a) n) 1) 1)))
      (#{'lt 'le 'gt 'ge} m)
      (let [[a b] args] (list ({'lt '< 'le '<= 'gt '> 'ge '>=} m) (unbox a) (unbox b)))
      (= 'field m)
      (let [[a n] args]
        (bind-vals [a] (fn [[x]] (list 'if (list 'instance? 'ocaml.rt.Block x)
                                       (list 'aget (list '.-f (list 'cast 'ocaml.rt.Block x)) n)
                                       (slow x n)))))
      :else nil)))

(def ^:private int-ops
  {"~" 'neg "+" 'add "-" 'sub "*" 'mul "/" 'div "/u" 'div "mod" 'mod "mod_unsafe" 'mod "and" 'land
   "or" 'lor "xor" 'lxor "lsl" 'lsl "lsr" 'lsr "asr" 'asr "compare_ints" 'compareInts
   "int_of_float" 'intOfFloat "float_of_int" 'floatOfInt "bswap16" 'bswap16
   "~." 'fneg "abs." 'fabs "+." 'fadd "-." 'fsub "*." 'fmul "/." 'fdiv "compare_floats" 'compareFloats
   "compare_bints" 'compareBints "duprecord" 'dupc "duparray" 'dupc "duparray_imm" 'dupc})

(def ^:private test-ops
  {"<" 'lt "<=" 'le ">" 'gt ">=" 'ge "==" 'eq "isout" 'isout "isint" 'isint
   "==." 'feq "<." 'flt "<=." 'fle ">." 'fgt ">=." 'fge})

(def ^:private negated-test-ops {"!=" "==" "!=." "==." "!<." "<." "!<=." "<=." "!>." ">." "!>=." ">=."})

(def ^:private bint-kinds {"Int32" 0 "Int64" 1 "Nativeint" 2})
(def ^:private bint-names {"int32" 0 "int64" 1 "nativeint" 2})

(defn- array-kind [^String n]
  (let [i (.indexOf n "[")] (if (neg? i) "gen" (subs n (inc i) (.indexOf n "]")))))

(defn- bigarray-ext [^String n nargs]
  (cond (str/starts-with? n "Bigarray.dim_") (str "caml_ba_dim_" (subs n 13))
        (str/includes? n "get16") "caml_ba_uint8_get16"
        (str/includes? n "get32") "caml_ba_uint8_get32"
        (str/includes? n "get64") "caml_ba_uint8_get64"
        (str/includes? n "set16") "caml_ba_uint8_set16"
        (str/includes? n "set32") "caml_ba_uint8_set32"
        (str/includes? n "set64") "caml_ba_uint8_set64"
        ;; Bigarray.get and set with their indices: caml_ba_get_N, caml_ba_set_N (N the dimensions)
        (str/includes? n "get") (str "caml_ba_get_" (dec nargs))
        (str/includes? n "set") (str "caml_ba_set_" (- nargs 2))
        :else n))

(defn- external [name args]
  (if-let [[cls arity] (get *externals* name)]
    (if (= arity (count args))
      (apply list (symbol (str cls) name) args)
      (do (note-missing! (str name "/" (count args))) (list 'throw (rt 'missing (str name "/" (count args))))))
    ;; OC215 (a): an external the runtime does not implement is the program's C stub of that name at the compiled level
    ;; (ocaml.rt.CApi: the main's boundary, test/ocaml/o2j/capi), missing as before where no stubs are loaded
    (do (note-missing! name) (list 'ocaml.rt.CApi/call name (list 'new 'Object/1 (vec args))))))

(def ^:private effect-prims
  {"perform" 'perform "runstack" 'runstack "resume" 'resume "reperform" 'reperform})

(defn- prim-value
  "The Java form of primitive n applied to argument forms as (already evaluated, in order)."
  [^String n as]
  (let [[a b c] as
        word (first (str/split n #"[ \[]"))]
    (cond
      (int-ops n) (apply rt (int-ops n) as)
      (test-ops n) (rt 'b (apply rt (test-ops n) as))
      (negated-test-ops n) (rt 'b (list 'not (apply rt (test-ops (negated-test-ops n)) as)))
      (re-matches #"-?\d+\+" n) (rt 'offset a (Long/parseLong (subs n 0 (dec (count n)))))
      (str/starts-with? n "+:=") (list 'ocaml.rt.Rt/setField a 0 (rt 'offset (rt 'field a 0) (Long/parseLong (subs n 3))))
      (= n "not") (rt 'b (list 'not (rt 't a)))
      (#{"makeblock" "makemutable"} word)
      (let [tag (num-arg n) w (count as)]
        (if (and (not= tag 254) (<= 1 w 256))
          ;; Rt/block in place (queue 414) when every argument is simple (*simple-args*: their forms pure and small, so written twice):
          ;; a Gc.Memprof profile running, Rt/block (the block counted once it exists and given to the profile, queue 438's heap
          ;; model); else its words counted (a minor heap's block of w fields and its header), then the block. No local holds the
          ;; block (a let's slot would keep it reachable while the frame lives: moved_while_blocking's promoted block); with an
          ;; argument that is not simple (inline, evaluated once), the call
          (if *simple-args*
            (list 'if 'ocaml.rt.ExtGc/memprofSampling
                  (rt 'block (list 'unchecked-int tag) (list 'new 'Object/1 (vec as)))
                  (list 'do (list 'set! 'ocaml.rt.Rt/minorWords (list 'unchecked-add 'ocaml.rt.Rt/minorWords (inc w)))
                        (list 'new 'ocaml.rt.Block (list 'unchecked-int tag) (list 'new 'Object/1 (vec as)))))
            (rt 'block (list 'unchecked-int tag) (list 'new 'Object/1 (vec as))))
          (rt 'block (list 'unchecked-int tag) (list 'new 'Object/1 (vec as)))))
      (= word "makefloatblock") (rt 'block 254 (list 'new 'Object/1 (vec as)))
      (= word "makelazyblock") (list 'ocaml.rt.Block. 246 (list 'new 'Object/1 (vec as)))
      (= word "makeforwardblock") (list 'ocaml.rt.Block. 250 (list 'new 'Object/1 (vec as)))
      (#{"field_imm" "field_mut" "field_int"} word) (rt 'field a (list 'unchecked-int (num-arg n)))
      (= n "field_computed") (rt 'field a (rt 'ii b))
      (= n "setfield_computed") (rt 'setField a (rt 'ii b) c)
      (str/starts-with? n "compare_bints") (rt 'compareBints a b)
      (str/starts-with? n "duparray") (rt 'dupc a)
      (and (str/starts-with? n "setfield_") (not (str/starts-with? n "setfield_computed")))
      (if (str/includes? n "computed")
        (rt 'setField a (rt 'ii b) c)
        (rt 'setField a (list 'unchecked-int (num-arg n)) b))
      (= word "floatfield") (rt 'floatField a (list 'unchecked-int (num-arg n)))
      (= word "setfloatfield") (if (str/includes? n "computed")
                                 (rt 'setFloatField a (rt 'ii b) c)
                                 (rt 'setFloatField a (list 'unchecked-int (num-arg n)) b))
      ;; the boxed integers
      (and (str/includes? n ".") (bint-kinds (first (str/split n #"\."))))
      (let [k (bint-kinds (first (str/split n #"\."))) op (subs n (inc (.indexOf n ".")))]
        (case op
          "of_int" (rt 'bintOfInt k a)
          (rt 'bint k op a (if (some? b) b nil))))
      (re-matches #"(int32|int64|nativeint)_of_(int32|int64|nativeint)" n)
      (rt 'mkb (bint-names (first (str/split n #"_of_"))) (rt 'bv a))
      ;; arrays
      (= word "array.length") (rt 'alenv a)
      (#{"makearray" "makearray_imm"} word) (rt 'makeArray (array-kind n) (list 'new 'Object/1 (vec as)))
      (= word "array.get") (rt 'agetChecked a b)
      (= word "array.unsafe_get") (rt 'aget a b)
      (= word "array.set") (rt 'asetChecked a b c)
      (= word "array.unsafe_set") (rt 'aset a b c)
      ;; strings and bytes
      (#{"string.length" "bytes.length"} n) (rt 'slen a)
      (#{"string.unsafe_get" "bytes.unsafe_get"} n) (rt 'sget a b)
      (#{"string.get" "bytes.get"} n) (rt 'sgetChecked a b)
      (= n "bytes.unsafe_set") (rt 'sset a b c)
      (= n "bytes.set") (rt 'ssetChecked a b c)
      (re-matches #"(string|bytes)\.(unsafe_)?get(16|32|64)" n)
      (rt 'sload a b (quot (Long/parseLong (re-find #"\d+$" n)) 8))
      (re-matches #"bytes\.(unsafe_)?set(16|32|64)" n)
      (rt 'sstore a b c (quot (Long/parseLong (re-find #"\d+$" n)) 8))
      (#{"bytes_to_string" "bytes_of_string" "opaque" "int_as_pointer" "obj_magic"} n) a
      (= n "ignore") (list 'do a UNIT)
      (#{"raise" "reraise" "raise_notrace"} n) (list 'throw (list 'ocaml.rt.Exn. a))
      (str/starts-with? n "sys.constant_") (rt 'sysConstant (subs n 13))
      (= n "atomic_load") (rt 'field a 0)
      (= n "dls_get") (external "caml_domain_dls_get" [UNIT])
      (= n "poll") a
      (effect-prims n) (apply list (symbol "ocaml.rt.Effects" (name (effect-prims n))) as)
      (or (str/starts-with? n "Bigarray.") (str/starts-with? n "bigarray.")) (external (bigarray-ext n (count as)) as)
      ;; an external of the C runtime (caml_*) or one the runtime defines under a library's own C name (Str's re_*)
      (or (str/starts-with? n "caml_") (contains? *externals* n)) (external n as)
      ;; an external with no bytecode name (OC199 (a), the typer's native:NAME:ARGS:RESULT): its native function, unboxed words
      (str/starts-with? n "native:")
      (let [[_ nm ar rs] (str/split n #":" -1)]
        (note-missing! nm)
        (list 'ocaml.rt.CApi/nativeCall nm (str ar rs) (list 'new 'Object/1 (vec as))))
      ;; another name: a C stub's (OC215 (a), CApi/prim), else unsupported as before
      :else (do (note-missing! (str "%" n)) (list 'ocaml.rt.CApi/prim n (list 'new 'Object/1 (vec as)))))))

;; ---- static blocks (ocamlopt's Closure, simplif_prim_pure: an immutable Pmakeblock whose arguments' approximations are all
;; Value_const is a structured constant, statically allocated: no allocation counted by Gc.minor_words, one block shared by every
;; evaluation; basic-more/pr1271's functor argument `struct let x = 42 end`, queue 397)

(defn- const-arg
  "The constant node x has the value of (its payload: a const's, a variable's let-bound constant, an immutable makeblock's of
  constants as a block constant), else nil."
  [ctx x]
  (case (hd x)
    const (second x)
    var (get (:kconst ctx) (second x))
    prim (let [[^String n args] (node-body x)]
           (when (= "makeblock" (first (str/split n #"[ \[]")))
             (let [ks (map #(const-arg ctx %) args)]
               (when (every? some? ks) (list 'block (num-arg n) (vec ks))))))
    nil))

(defn- prim-node [ctx [^String n args] tail?]
  (cond
    (and (str/starts-with? n "makeblock") (seq args) (const-arg ctx (list 'prim n args)))
    (const-form (const-arg ctx (list 'prim n args)))
    (#{"raise" "reraise" "raise_notrace"} n)
    (let [[x sl] (raise-slot (first args))]
      (with-args ctx [x] (fn [[a]] (list 'throw (list 'ocaml.rt.Bt/raise a sl (= n "reraise") (= n "raise_notrace"))))))
    (str/starts-with? n "global ")
    (let [g (global-name (subs n 7))]
      (cond (predefs g) (symbol "ocaml.rt.Rt" g)
            :else (symbol (class-of g) "G")))
    (#{"&&" "||" "sequand" "sequor"} n) (rt 'b (test-form ctx (list 'prim n args)))
    :else (binding [*simple-args* (every? simple? args)] (with-args ctx args (fn [as] (prim-value n as))))))

;; ---- tests

(defn test-form
  "Node x as a Java boolean: comparisons, not, && and || directly, anything else Rt/t."
  [ctx x]
  (let [h (hd x)]
    (cond
      (and (= 'prim h) (#{"&&" "sequand"} (first (node-body x))))
      (let [[a b] (second (node-body x))] (list 'and (test-form ctx a) (test-form ctx b)))
      (and (= 'prim h) (#{"||" "sequor"} (first (node-body x))))
      (let [[a b] (second (node-body x))] (list 'or (test-form ctx a) (test-form ctx b)))
      (and (= 'prim h) (= "not" (first (node-body x))))
      (list 'not (test-form ctx (first (second (node-body x)))))
      (and (= 'prim h) (test-ops (first (node-body x))))
      (let [[n args] (node-body x)] (with-args ctx args (fn [as] (apply rt (test-ops n) as))))
      (and (= 'prim h) (negated-test-ops (first (node-body x))))
      (let [[n args] (node-body x)]
        (with-args ctx args (fn [as] (list 'not (apply rt (test-ops (negated-test-ops n)) as)))))
      (and (= 'const h) (#{'int 'char} (first (second x)))) (not (zero? (second (second x))))
      :else (rt 't (expr ctx x false)))))

;; ---- control

(defn- switch-node [ctx [scrut nc consts nb blocks fail] tail?]
  (let [s (fresh "s$")
        fl (when (some? fail) (keyword (str "fail" (swap! (:n *unit*) inc))))
        k (when fl (keyword (str "sw" (swap! (:n *unit*) inc))))
        dflt (when fl [(list 'break fl)])
        cases (fn [cs] (mapcat (fn [[n e]] [n (expr ctx e tail?)]) cs))
        int-sw (concat (list 'switch (rt 'ii s)) (cases consts) dflt)
        blk-sw (concat (list 'switch (list '.-tag (list 'cast 'ocaml.rt.Block s))) (cases blocks) dflt)
        body (cond (zero? nb) int-sw
                   (zero? nc) blk-sw
                   :else (list 'if (list 'instance? 'Long s) int-sw blk-sw))
        sw (list 'let [s (expr ctx scrut false)] body)]
    (if fl
      (list 'label k (list 'label fl (list 'break k sw)) (expr ctx fail tail?))
      sw)))

(defn- stringswitch-node [ctx [scrut cases dflt] tail?]
  (let [s (fresh "s$")]
    (list 'let [s (rt 'js (expr ctx scrut false))]
          (concat (list 'switch s)
                  (mapcat (fn [[k e]] [(latin1 k) (expr ctx e tail?)]) cases)
                  (when (some? dflt) [(expr ctx dflt tail?)])))))

(defn- staticcatch-node [ctx [body [n vars] handler] tail?]
  (let [k (keyword (str "k" (swap! (:n *unit*) inc)))
        e (keyword (str "exit" (swap! (:n *unit*) inc)))
        ;; fresh names: an or-pattern's identifiers are bound again by lets in the body
        syms (mapv (fn [_] (fresh "h$")) vars)
        bctx (assoc-in ctx [:exits n] {:label e :vars syms})
        hctx (update ctx :env merge (zipmap (map first vars) syms))]
    (if (has-event? body)
      ;; an exit out of a slot's region leaves it entered: the handler cuts the stack back (oi's static exit)
      (let [b0 (fresh "b0$")]
        (list 'let [(with-meta b0 {:tag 'int}) 'ocaml.rt.Bt/sp]
              (list 'label k
                    (list 'let (vec (mapcat (fn [s] [(with-meta s {:mutable true :tag 'Object}) nil]) syms))
                          (list 'label e (list 'break k (expr bctx body tail?)))
                          (list 'ocaml.rt.Bt/unwind b0)
                          (expr hctx handler tail?)))))
      (list 'label k
            (list 'let (vec (mapcat (fn [s] [(with-meta s {:mutable true :tag 'Object}) nil]) syms))
                  (list 'label e (list 'break k (expr bctx body tail?)))
                  (expr hctx handler tail?))))))

(defn- staticraise-node [ctx [n args]]
  (let [{:keys [label vars]} (or (get-in ctx [:exits n]) (throw (ex-info (str "exit " n " not in scope") {})))]
    (if (empty? args)
      (list 'break label)
      (let [ts (vec (repeatedly (count args) #(fresh "t$")))]
        ;; right to left, then assigned
        (list 'let (vec (mapcat (fn [t x] [t (expr ctx x false)]) (reverse ts) (reverse args)))
              (concat (list 'do) (map (fn [v t] (list 'set! v t)) vars ts) [(list 'break label)]))))))

(defn- trywith-node [ctx [body id handler] tail?]
  (let [e (fresh "e$") s (munge-id id) d (fresh "d$") bs (fresh "bs$")]
    ;; the handler runs at the depth the try was entered at (the calls the exception left were not given back); the backtrace
    ;; (Bt): the raise's slot and the slots above the handler's depth stashed, the stack cut back to it
    (list 'let [d 'ocaml.rt.Rt/depth (with-meta bs {:tag 'int}) 'ocaml.rt.Bt/sp]
          (list 'try (expr ctx body false)
                (list 'catch 'Throwable e
                      (list 'set! 'ocaml.rt.Rt/depth d)
                      (list 'let [s (rt 'exnValue e)]
                            (list 'ocaml.rt.Bt/stash e bs)
                            (list 'ocaml.rt.Bt/unwind bs)
                            (expr (assoc-in ctx [:env id] s) handler tail?)))))))

(defn- for-node [ctx [id lo hi dir body]]
  (let [l (fresh "lo$") h (fresh "hi$") i (fresh "i$") s (munge-id id)
        up (= dir :to)
        lv (fresh "lv$") hv (fresh "hv$")]
    ;; the bounds unboxed once (queue 414)
    (list 'let [l (expr ctx lo false) h (expr ctx hi false)]
          (list 'let [(with-meta lv {:tag 'long}) (rt 'l l) (with-meta hv {:tag 'long}) (rt 'l h)]
                (list 'when (list (if up '<= '>=) lv hv)
                      (concat (list 'loop [(with-meta i {:tag 'long}) lv])
                            tick-forms
                            [(list 'let [(with-meta s {:tag 'Object}) i] (expr (assoc-in ctx [:env id] s) body false))
                             (list 'when (list 'not (list '== i hv))
                                   (list 'recur (list (if up 'unchecked-inc 'unchecked-dec) i)))])))
          UNIT)))

(defn- flatten-seq [x]
  (if (= 'sequence (hd x)) (mapcat flatten-seq (node-body x)) [x]))

(defn expr
  "Lambda node x as a Java form (an Object's value); tail? when x is in its function's tail."
  [ctx x tail?]
  (let [h (hd x) b (node-body x)]
    (case h
      (var mutvar) (lookup ctx (first b))
      const (const-form (first b))
      apply (apply-node ctx b tail?)
      function (function-node ctx x)
      (let mutlet) (let-chain ctx x tail?)
      letrec (letrec-node ctx b tail?)
      prim (prim-node ctx b tail?)
      switch (switch-node ctx b tail?)
      stringswitch (stringswitch-node ctx b tail?)
      staticraise (staticraise-node ctx b)
      staticcatch (staticcatch-node ctx b tail?)
      trywith (trywith-node ctx b tail?)
      ifthenelse (let [[c t f] b] (list 'if (test-form ctx c) (expr ctx t tail?) (expr ctx f tail?)))
      sequence (let [xs (flatten-seq x)]
                 (concat (list 'do) (map #(expr ctx % false) (butlast xs)) [(expr ctx (last xs) tail?)]))
      while (let [[c body] b] (list 'do (concat (list 'while (test-form ctx c)) tick-forms [(expr ctx body false)]) UNIT))
      for (for-node ctx b)
      assign (let [[id e] b] (list 'do (list 'set! (lookup ctx id) (expr ctx e false)) UNIT))
      send (let [[kind m o args] b
                 ts (vec (repeatedly (count args) #(fresh "t$")))
                 ov (fresh "o$") mv (fresh "m$")]
             ;; the arguments right to left, then the object, then the method (oi's order)
             (list 'let (vec (concat (mapcat (fn [t x] [t (expr ctx x false)]) (reverse ts) (reverse args))
                                     [ov (expr ctx o false) mv (expr ctx m false)]))
                   (call-form (rt 'getMethod (= kind :self) ov mv) (into [ov] ts))))
      event (event-node ctx b tail?)
      ifused (expr ctx (second b) tail?)
      (throw (ex-info (str "Lambda node " h " not known") {:head h})))))

;; ---------------------------------------------------------------------------------------------
;; units and programs

(defn translate-unit
  "The Java forms of a unit's dump: [forms missing], missing the externals and primitives the
  runtime lacks with their counts."
  [{:keys [name code]}]
  (let [cls (symbol (last (str/split (class-of name) #"\.")))]
    (binding [*unit* {:class (symbol (class-of name)) :name name :n (atom 0)
                      :classes (atom []) :consts (atom []) :ints (atom {}) :blocks (atom {}) :slots (atom []) :missing (atom {})}]
      (let [[_ [body]] (node-body code)
            init (realize (expr {:env {} :exits {}} body false))
            classes (mapv realize @(:classes *unit*))
            klass (concat
                   (list 'defclass (with-meta cls {:public true}))
                   [(list 'field (with-meta 'G {:public true :static true}))]
                   (for [[k init] @(:consts *unit*)] (list 'field (with-meta k {:public true :static true :final true}) init))
                   ;; the unit's debugging events (OC217 (a)'s fifth stage): Bt's slots, registered when the class is initialised
                   (for [[k init] @(:slots *unit*)] (list 'field (with-meta k {:public true :static true :final true :tag 'int}) init))
                   classes
                   [(list 'method (with-meta 'init {:public true :static true}) (with-meta [] {:tag 'void})
                          (list 'set! 'G init))])]
        [(conj (header-forms (pkg-of name) (list 'ocaml.rt 'Rt 'Block 'Closure 'Exn))
               (realize klass))
         @(:missing *unit*)]))))

(defn- program-class [u] (str (if (contains? *own* u) *pkg* "ocaml.u") "." (class-name u)))

(defn- jstrs [xs] (list 'new 'String/1 (mapv #(list 'java-str %) xs)))

;; (queue 544) a program one of whose own units calls oi's Dynlink externals itself (the toplevel's topeval.ml, a driver of plugins):
;; its main class sets the runtime's loader as a program that links Dynlink does (main-forms)
(def ^:dynamic *oi-loader* false)

(defn- calls-oi-loader?
  "Whether unit u's code names the external caml_oi_dynlink_parse."
  [u]
  (letfn [(walk [x] (cond (seq? x) (or (and (= 'prim (first x)) (= "caml_oi_dynlink_parse" (second x))) (some walk x))
                          (vector? x) (some walk x)
                          :else false))]
    (boolean (walk (:code u)))))

;; the embedded oi (queue 544, jdk/ocaml's Oi): the externals a Lambda text interpreted at run time calls, by the program's loader's
;; verbs "ext-index" (a name's index and arity, (index << 8) | arity, nil for no external of the runtime) and "ext-call" (an index and the
;; arguments): the runtime has no reflection at the compiled level, so the table is the program's (its main class's static methods)
(defn oi-ext-methods
  "The static methods extIndex and extCall over *externals* (load-externals!), sorted by name."
  []
  (let [es (sort-by key *externals*) n (symbol "n$") i (symbol "i$") a (symbol "a$")]
    [(list 'method (with-meta 'extIndex {:public true :static true}) [(with-meta n {:tag 'String})]
           (concat (list 'switch n)
                   (mapcat (fn [k [nm [_ ar]]] [nm (list 'Long/valueOf (bit-or (bit-shift-left (long k) 8) (long ar)))]) (range) es)
                   [nil]))
     (list 'method (with-meta 'extCall {:public true :static true}) [(with-meta i {:tag 'int}) (with-meta a {:tag 'Object/1})]
           (concat (list 'switch i)
                   (mapcat (fn [k [nm [cls ar]]] [k (apply list (symbol (str cls) nm) (map (fn [j] (list 'aget a j)) (range ar)))]) (range) es)
                   [(list 'throw (list 'ocaml.rt.Rt/internal "oi: no such external"))]))]))

(defn oi-ext-class
  "The light level's table of the externals (test/ocaml/o2j/run.ae): oi-ext-methods in the class ocaml.u.OiExts."
  []
  (conj (header-forms "ocaml.u" nil)
        (concat (list 'defclass (with-meta 'OiExts {:public true})) (oi-ext-methods))))

(defn- registry-methods
  "The compiled level's Dynlink (OC220 (a)'s compiled half, queue 373-1): the program's loader, its main class's static methods. load
  answers jdk/ocaml's Main/loader: \"parse\" a plugin's Lambda text, looked up by its key (plugin-key) among PLUGINS ({:name :key
  :deps :refs}, translated ahead into the package), its entry [NAME DEPS REFS INIT nil] (INIT its class's init as a Runnable), a text
  of no plugin a Failure; \"define\" the entry's INIT; \"global\" a unit's module block (UNITS', then the plugins'), nil for another name."
  [units plugins]
  (let [x (symbol "x$") t (symbol "t$") k (symbol "k$") n (symbol "n$") main (str *pkg* ".M__main")]
    (into
    [(list 'method (with-meta 'load {:public true :static true}) [(with-meta x {:tag 'Object/1})]
           (list 'let [(with-meta t {:tag 'String}) (list 'cast 'String (list 'aget x 0))]
                 (list 'cond
                       (list '.equals t (list 'java-str "parse")) (list (symbol main "plugin") (list 'cast 'String (list 'aget x 1)))
                       (list '.equals t (list 'java-str "define")) (list 'aget (list 'cast 'Object/1 (list 'aget x 1)) 3)
                       (list '.equals t (list 'java-str "global")) (list (symbol main "global") (list 'cast 'String (list 'aget x 1)))
                       ;; the embedded oi's externals (queue 544)
                       (list '.equals t (list 'java-str "ext-index")) (list (symbol main "extIndex") (list 'cast 'String (list 'aget x 1)))
                       (list '.equals t (list 'java-str "ext-call"))
                       (list 'let [(with-meta (symbol "c$") {:tag 'Object/1}) (list 'cast 'Object/1 (list 'aget x 1))]
                             (list (symbol main "extCall") (list 'unchecked-int (list 'long (list 'cast 'Long (list 'aget (symbol "c$") 0))))
                                   (list 'cast 'Object/1 (list 'aget (symbol "c$") 1))))
                       :else nil)))
     (list 'method (with-meta 'plugin {:public true :static true}) [(with-meta t {:tag 'String})]
           (list 'let [(with-meta k {:tag 'String}) (list 'java-str (list 'String/valueOf (list '.hashCode t)) (list 'java-str "#")
                                                          (list 'String/valueOf (list '.length t)))]
                 (concat (list 'cond)
                         (mapcat (fn [{:keys [name key deps refs]}]
                                   [(list '.equals k (list 'java-str key))
                                    (list 'new 'Object/1 [(list 'java-str name) (jstrs deps) (jstrs refs)
                                                          (list 'lambda 'Runnable [] (list (symbol (str *pkg* ".D_" name) "init")) nil)
                                                          nil])])
                                 plugins)
                         ;; a text no plugin of the registry has: the embedded oi's (queue 544: a toplevel phrase's)
                         [:else (list 'ocaml.rt.Oi/parse t)])))
     (list 'method (with-meta 'global {:public true :static true}) [(with-meta n {:tag 'String})]
           (concat (list 'cond)
                   (mapcat (fn [u] [(list '.equals n (list 'java-str u)) (symbol (program-class u) "G")]) (distinct units))
                   (mapcat (fn [{:keys [name]}] [(list '.equals n (list 'java-str name)) (symbol (str *pkg* ".D_" name) "G")])
                           (remove #(some #{(:name %)} units) plugins))
                   [:else (list 'ocaml.rt.Oi/global n)]))]
    (oi-ext-methods))))

(defn main-forms
  "The program's main class: inits, the units' initialisation in link order as one Runnable, and
  main, Main/run's ending and the status. At the compiled level (*in-ns*), for a program that links Dynlink, main first gives the runtime the program's units
  (Main/setUnits, Dynlink's main program units) and its loader (Main/setLoader, registry-methods' load over PLUGINS: queue 373-1)."
  [units & [plugins]]
  (conj (header-forms *pkg* nil)
        (concat
         (list 'defclass (with-meta 'M__main {:public true})
               (list 'method (with-meta 'inits {:public true :static true}) (with-meta [] {:tag 'Runnable})
                     (concat (list 'lambda 'Runnable [])
                             (for [u units] (list (symbol (program-class u) "init")))
                             [nil]))
               (concat
                (list 'method (with-meta 'main {:public true :static true}) (with-meta [(with-meta 'args {:tag 'String/1})] {:tag 'void}))
                (when (and *in-ns* (or (some #{"Dynlink"} units) *oi-loader*))
                  [(list 'ocaml.rt.Main/setUnits (jstrs units))
                   (list 'ocaml.rt.Main/setLoader (list 'lambda 'java.util.function.Function [(symbol "x$")]
                                                        (list (symbol (str *pkg* ".M__main") "load") (list 'cast 'Object/1 (symbol "x$")))))])
                [(list 'System/exit (list 'ocaml.rt.Main/run 'args (list (symbol (str *pkg* ".M__main") "inits"))))]))
         (when (and *in-ns* (or (some #{"Dynlink"} units) *oi-loader*)) (registry-methods units plugins)))))

(defn shard-forms
  "The compiled level's dispatcher (OC93 (a)): the class ocaml.u.Shard, whose main runs the program the environment
  variable O2J_PROG names (a package's last part, p<N>) with the command line, argv.(0) O2J_ARGV0 when set."
  [pkgs]
  (let [p (symbol "p$") a (symbol "a0$")]
    (conj (header-forms "ocaml.u" nil)
          (list 'defclass (with-meta 'Shard {:public true})
                (list 'method (with-meta 'main {:public true :static true}) (with-meta [(with-meta 'args {:tag 'String/1})] {:tag 'void})
                      (list 'let [(with-meta p {:tag 'String}) '(System/getenv "O2J_PROG")
                                  (with-meta a {:tag 'String}) '(System/getenv "O2J_ARGV0")]
                            (list 'when (list 'and (list 'some? a) (list '> '(alength args) 0)) (list 'aset 'args 0 a))
                            (concat (list 'cond)
                                    (mapcat (fn [pk] [(list '.equals (list 'java-str (last (str/split pk #"\."))) p)
                                                      (list (symbol (str pk ".M__main") "main") 'args)])
                                            pkgs)
                                    [:else (list 'do (list '.println 'System/err (list 'java-str "o2j: no program " p)) '(System/exit 126))])))))))

(defn- dir-ae-stems
  "The stems of DIR's .ae files, sorted."
  [^java.io.File dir]
  (sort (for [^java.io.File f (or (.listFiles dir) []) :let [n (.getName f)] :when (str/ends-with? n ".ae")]
          (subs n 0 (- (count n) 3)))))

(defn split-packages
  "The compiled level's Go packages of a shard's classes (queue 544b, DECISION 544-1 (a)), for j2g's packages.edn (the input's
  top-level class -> Go package, arbace.j2g.names/compiled-packages): the runtime's classes (ocaml/rt) the package ocaml_rt, each
  library unit's class (ocaml/u/M_<Unit>) a package of its own, ou_<Unit>, a program's units and plugins one each (ocaml_p<N>_u_<Unit>,
  ocaml_p<N>_d_<Unit>: queue 544c) and its main class ocaml_p<N>;
  the dispatcher ocaml.u.Shard stays in lang, j2g's entry. A unit names only units linked before it and the runtime, a program its units
  and the libraries', the dispatcher the programs: no import cycle. Go then compiles a translated library unit by unit, where one
  package of every class (lang) took Go's compile past 36 GB for compiler-libs' toplevel (queue 544). A sorted map: the same text
  whatever the run."
  [^java.io.File o]
  (into (sorted-map)
        (concat
         (for [c (dir-ae-stems (io/file o "ocaml/rt"))] [(str "ocaml/rt/" c) "ocaml_rt"])
         ;; (a unit's file is named by the unit, its class M_<Unit>: class-name)
         (for [c (dir-ae-stems (io/file o "ocaml/u")) :when (not= c "Shard")] [(str "ocaml/u/" (class-name c)) (str "ou_" c)])
         (for [^java.io.File d (sort-by #(.getName ^java.io.File %) (or (.listFiles (io/file o "ocaml")) []))
               :when (and (.isDirectory d) (re-matches #"p\d+" (.getName d)))
               c (dir-ae-stems d)]
           ;; (queue 544c) a program's own unit and a plugin each a package of its own too, ocaml_p<N>_u_<Unit> and ocaml_p<N>_d_<Unit>, its
           ;; main class ocaml_p<N>: in one package a unit's class M_<Unit> met another's member of j2g's (unit Odoc's class object
           ;; M_Odoc_class against unit Odoc_class's class, ocamldoc's shard)
           (let [p (.getName d)]
             (cond (= c "M__main") [(str "ocaml/" p "/" c) (str "ocaml_" p)]
                   (str/starts-with? c "D_") [(str "ocaml/" p "/" c) (str "ocaml_" p "_d_" (subs c 2))]
                   :else [(str "ocaml/" p "/" (class-name c)) (str "ocaml_" p "_u_" c)]))))))

(defn split?
  "Whether a shard's classes are split into packages (split-packages): O2J_SPLIT 1 always, 0 never, else (the default) when its library
  units' forms (OUT/ocaml/u) pass O2J_SPLIT_BYTES (default 24 MB: compiler-libs' units, 62 MB; the standard library's with Unix and Str
  about 10), so that the compiled level's other shards are built as before."
  [^java.io.File o]
  (case (System/getenv "O2J_SPLIT")
    "1" true
    "0" false
    (> (reduce + (for [^java.io.File f (or (.listFiles (io/file o "ocaml/u")) [])] (.length f)))
       (Long/parseLong (or (System/getenv "O2J_SPLIT_BYTES") "25165824")))))

(defn package-forms
  "A package's namespace file for the compiled level's trees (j2g skips it: its first form is ns)."
  [pkg]
  [(list 'ns (symbol pkg))])

(defn- unlined
  "Form x without the reader's :line and :column (queue 453): the forms this file quotes (bt-pop, the in-place entry and turn)
  carry them, and each printed map is read, attached and kept with the loaded class at every run; the type hints stay."
  [x]
  (let [strip (fn [y] (if-let [m (meta y)]
                        (let [m (dissoc m :line :column)] (with-meta y (when (seq m) m)))
                        y))]
    (cond (seq? x) (strip (with-meta (apply list (map unlined x)) (meta x)))
          (vector? x) (strip (with-meta (mapv unlined x) (meta x)))
          (map? x) (strip (with-meta (into (empty x) (map (fn [[k v]] [(unlined k) (unlined v)]) x)) (meta x)))
          (symbol? x) (strip x)
          :else x)))

(defn write-forms [^File f forms header]
  (io/make-parents f)
  (with-open [w (io/writer f)]
    (binding [*out* w *print-meta* true *print-length* nil *print-level* nil]
      (println (str ";; " header))
      (doseq [x forms] (newline) (prn (unlined x))))))

;; ---------------------------------------------------------------------------------------------
;; linking (oi's Link, run.go): the library units a program needs, in the library's order

(defn unit-refs
  "The units unit u's code names (global X, the predefined exceptions left out) and those it requires."
  [u]
  (let [acc (volatile! #{})]
    (letfn [(walk [x]
              (cond (seq? x) (do (when (and (= 'prim (first x)) (string? (second x)) (str/starts-with? (second x) "global "))
                                   (let [g (global-name (subs (second x) 7))]
                                     (when-not (predefs g) (vswap! acc conj g))))
                                 (run! walk x))
                    (vector? x) (run! walk x)))]
      (walk (:code u)))
    (vec (sort (disj (into @acc (:required u)) (:name u))))))

(defn plugin-key
  "A plugin's key in the compiled level's registry (queue 373-1): its Lambda text's String hashCode and length, as the runtime's
  caml_oi_dynlink_parse has the text (the file after its header) and registry-methods' plugin computes them."
  [^String text]
  (str (.hashCode text) "#" (.length text)))

(defn- plugin-deps
  "A plugin's dependencies, {:deps :refs}: the units it requires and then the globals its code names, and those globals in the order
  the code names them (oi's caml_oi_dynlink_parse and ParseUnit)."
  [u]
  (let [refs (volatile! [])
        seen (volatile! #{(:name u)})]
    (letfn [(walk [x]
              (cond (seq? x) (do (when (and (= 'prim (first x)) (string? (second x)) (str/starts-with? (second x) "global "))
                                   (let [g (global-name (subs (second x) 7))]
                                     (when-not (or (predefs g) (@seen g)) (vswap! seen conj g) (vswap! refs conj g))))
                                 (run! walk x))
                    (vector? x) (run! walk x)))]
      (walk (:code u)))
    {:deps (vec (distinct (remove #{(:name u)} (concat (:required u) @refs)))) :refs @refs}))

(defn plugin-unit
  "A plugin's unit (Dynlink's loader at the light level, queue 373: jdk/ocaml's caml_oi_dynlink_parse through test/ocaml/o2j/run.ae)
  from its Lambda dump's TEXT: {:name :deps :refs :forms}, deps the units it requires and then the globals its code names (the
  implementation imports, as oi's caml_oi_dynlink_parse gives them), refs those globals in the order the code names them (oi's
  ParseUnit, its link's checks), forms its class's Java forms (translate-unit's, the package ocaml.u)."
  [^String text]
  (let [u (dump-of (read-string text) "a plugin")
        {:keys [deps refs]} (plugin-deps u)
        ;; (an external the runtime lacks throws Rt/missing when it is called, as a program's unit's does)
        [forms _] (translate-unit u)]
    {:name (:name u) :deps deps :refs refs :forms forms}))

(defn link
  "The library units programs' units need, in lib-order; deps: unit -> the units it needs. FORCED: library units the program
  links whatever it names (the compiled level's libraries outside the stdlib, OT26 (a): a program that includes unix links
  Unix and UnixLabels as oi and the light level do), with the units they need."
  [lib-order deps prog-units & [forced]]
  (let [progs (set (map :name prog-units))
        need (volatile! #{})]
    (letfn [(visit [n]
              (when-not (or (@need n) (progs n))
                (when-not (contains? deps n) (throw (ex-info (str "no unit " n " in the library") {:unit n})))
                (vswap! need conj n)
                (run! visit (deps n))))]
      (run! visit forced)
      (doseq [u prog-units] (run! visit (unit-refs u))))
    (filterv @need lib-order)))

(defn- translate-units [lo od us libs & [ps plibs]]
  (do
    (doseq [u us]
      (let [[forms missing] (translate-unit u)]
        (write-forms (io/file od (str (:name u) ".ae")) forms
                     (str "Translated by arbace.o2j from the Lambda of " (:name u) "."))
        (doseq [[m c] (sort missing)] (println (str "missing\t" od "\t" (:name u) "\t" m "\t" c)))))
    ;; the plugins (queue 373-1): each its class D_<unit>, its registry entry in the main class
    (doseq [u ps]
      (let [[forms missing] (binding [*plugin* (:name u)] (translate-unit u))]
        (write-forms (io/file od (str "D_" (:name u) ".ae")) forms
                     (str "Translated by arbace.o2j from the Lambda of the plugin " (:name u) "."))
        (doseq [[m c] (sort missing)] (println (str "missing\t" od "\t" (:name u) "\t" m "\t" c)))))
    (write-forms (io/file od "M__main.ae")
                 (binding [*oi-loader* (boolean (some calls-oi-loader? us))] (main-forms (concat libs (map :name us)) (for [u ps] (merge {:name (:name u) :key (:key u)} (plugin-deps u)))))
                 "The program's main class, by arbace.o2j.")
    ;; (the library units only the plugins name after the main class: in the program's tree, not in its link)
    (spit (io/file od "files.txt")
          (str (str/join "\n" (concat (for [n libs] (.getPath (io/file lo (str n ".ae"))))
                                       (for [u us] (.getPath (io/file od (str (:name u) ".ae"))))
                                       [(.getPath (io/file od "M__main.ae"))]
                                       (for [u ps] (.getPath (io/file od (str "D_" (:name u) ".ae"))))
                                       (for [n plibs] (.getPath (io/file lo (str n ".ae"))))))
               "\n"))))

(defn translate-program
  "A program's units (DUMPS, in order) translated into OD with its main class and OD/files.txt,
  the files to define in order: the library's units it needs (LO's) first. PKG (the compiled level, OC93 (a)) the
  package of its units and main class, else ocaml.u."
  [lo od dumps & [pkg]]
  (let [{:keys [order deps]} (read-string (slurp (io/file lo "deps.edn")))
        ;; an entry @UNIT names a library unit the program links (OT26 (a)), the others its own units' dumps
        forced (for [d dumps :when (str/starts-with? d "@")] (subs d 1))
        us (mapv #(read-dump (io/file %)) (remove #(or (str/starts-with? % "@") (str/starts-with? % "+")) dumps))
        ;; an entry +DUMP a plugin the program's Dynlink may load (the compiled level, queue 373-1): translated ahead into its package,
        ;; keyed by its text (plugin-key); the library units only plugins name are in its tree, not its link (ocamlc's link takes those
        ;; the program's units name: a plugin naming another fails at its load, Undefined_global)
        ps (vec (for [d dumps :when (str/starts-with? d "+")
                      :let [f (io/file (subs d 1)) text (slurp f)]]
                  (assoc (dump-of (read-string text) f) :key (plugin-key text))))
        _ (when-let [dup (first (for [[n c] (frequencies (map :name ps)) :when (> c 1)] n))]
            (throw (ex-info (str "two plugins define the unit " dup) {:unit dup})))
        libs (link order deps us forced)
        plibs (if (seq ps) (let [l (set libs)] (remove l (link order deps (concat us ps) forced))) [])]
    (binding [*pkg* (or pkg "ocaml.u") *own* (if pkg (set (map :name us)) #{}) *plugins* (set (map :name ps))]
      (translate-units lo od us libs ps plibs))))

;; ---------------------------------------------------------------------------------------------
;; the command line: o2j unit DUMP OUT, o2j main OUT UNIT...

(defn -main [& [cmd & args]]
  (load-externals! (or (System/getenv "O2J_RT") "jdk/ocaml/ocaml/rt"))
  (case cmd
    "unit" (doseq [[d o] (partition 2 args)]
             (let [u (read-dump (io/file d))
                   [forms missing] (translate-unit u)]
               (write-forms (io/file o) forms (str "Translated by arbace.o2j from the Lambda of " (:name u) ". Regenerate rather than edit."))
               (doseq [[n c] (sort missing)] (println (str "missing\t" (:name u) "\t" n "\t" c)))))
    ;; lib LAMBDA-DIR OUT-DIR: every unit of LAMBDA-DIR/order.txt translated, OUT-DIR/deps.edn
    ;; (lib LAMBDA-DIR OUT-DIR DUMP...: the DUMPs' units after the stdlib's, in their order: the compiled level's libraries outside
    ;; the stdlib, unix, threads, compiler-libs, lib/testing, translated once into ocaml.u, OT26 (a))
    "lib" (let [[ld od & extra] args
                files (concat (for [n (str/split-lines (slurp (io/file ld "order.txt")))] (io/file ld (str n ".ae")))
                              (map io/file extra))
                ;; one unit read at a time (the library's Lambda is not held at once)
                pairs (vec (for [f files]
                             (let [u (read-dump f)
                                   n (:name u)
                                   [forms missing] (translate-unit u)]
                               (write-forms (io/file od (str n ".ae")) forms
                                            (str "Translated by arbace.o2j from the Lambda of " n ". Regenerate rather than edit."))
                               (doseq [[m c] (sort missing)] (println (str "missing\t" n "\t" m "\t" c)))
                               [n (unit-refs u)])))]
            (spit (io/file od "deps.edn") (pr-str {:order (mapv first pairs) :deps (into {} pairs)})))
    ;; prog LIB-OUT OUT-DIR DUMP...: the program's units translated into OUT-DIR, its main class,
    ;; OUT-DIR/files.txt the files to define in order
    "prog" (let [[lo od & dumps] args] (translate-program lo od dumps))
    ;; progs LIB-OUT LIST: LIST's lines OUT-DIR DUMP... (tabs), each a program as prog's; a program
    ;; that does not translate is a line "refused\tOUT-DIR\tWHY"
    "progs" (let [[lo lst] args]
              (doseq [line (str/split-lines (slurp lst)) :when (seq line)
                      :let [[od & dumps] (str/split line #"\t")]]
                (try (translate-program lo od dumps)
                     (catch Throwable e
                       (println (str "refused\t" od "\t" (str/replace (str (.getMessage e)) #"\s+" " ")))))))
    ;; the compiled level (OC93 (a)): clib LAMBDA-DIR OUT-DIR as lib, the units' files in j2g's tree style (*in-ns*);
    ;; cprogs LIB-OUT LIST: LIST's lines PKG OUT-DIR DUMP... (tabs), each a program as prog's in package PKG (ocaml.p<N>), in
    ;; the tree style, a refusal as progs'; shard OUT-DIR PKG...: OUT-DIR/ocaml/u/Shard.ae, the dispatcher, and the packages'
    ;; namespace files OUT-DIR/ocaml/u.ae, OUT-DIR/ocaml/p<N>.ae
    "clib" (binding [*in-ns* true] (apply -main "lib" args))
    "cprogs" (let [[lo lst] args]
               (binding [*in-ns* true]
                 (doseq [line (str/split-lines (slurp lst)) :when (seq line)
                         :let [[pkg od & dumps] (str/split line #"\t")]]
                   (try (translate-program lo od dumps pkg)
                        (catch Throwable e
                          (println (str "refused\t" od "\t" (str/replace (str (.getMessage e)) #"\s+" " "))))))))
    "shard" (let [[o & pkgs] args]
              (binding [*in-ns* true]
                (write-forms (io/file o "ocaml/u/Shard.ae") (shard-forms pkgs) "The compiled level's dispatcher, by arbace.o2j.")
                (doseq [p (cons "ocaml.u" pkgs)]
                  (write-forms (io/file o (str (str/replace p "." "/") ".ae")) (package-forms p) "A package of the compiled level, by arbace.o2j."))
                ;; (queue 544b) a large shard's classes in Go packages of their own (split?, split-packages)
                (if (split? (io/file o))
                  (spit (io/file o "packages.edn") (str (pr-str (split-packages (io/file o))) "\n"))
                  (.delete (io/file o "packages.edn")))))
    "main" (let [[o & units] args]
             (write-forms (io/file o) (main-forms units) "The program's main class, by arbace.o2j."))
    (do (println "usage: o2j lib LAMBDA-DIR OUT-DIR | prog LIB-OUT OUT-DIR DUMP... | unit DUMP OUT [DUMP OUT...] | main OUT UNIT...") (System/exit 2))))

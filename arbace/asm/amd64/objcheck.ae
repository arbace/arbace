(ns arbace.asm.amd64.objcheck
  "x86-64's object verdict (queue 337; doc/asm/AMD64-SURVEY.md, \"As built: queue 337\"): MC/X86's object tests that
  object-check's corpus mc-x86-obj leaves out (the relaxation, padding and branch-alignment runs, -mcpu, the other triples)
  judged by their own CHECK lines, no LLVM tool, as AR4's arm64 verdict (arbace.asm.arm64.objcheck) judges MC/AArch64's. Each
  RUN line that assembles with -filetype=obj (its object piped to a viewer, or written to %t and viewed by a later RUN line)
  is a run: the object is Arbace's (arbace.asm.amd64.obj, with the run's X86AsmBackend options: -mcpu's NOPs, the branch
  alignment, the prefix padding, --mc-relax-all), the viewer's text is Arbace's view of it in that tool's format
  (llvm-objdump -d with each instruction decoded by arbace.asm.amd64.decode and printed by arbace.asm.amd64.print as
  llvm-objdump prints it: the address, the bytes, the text, a branch's target and its symbol; llvm-objdump --headers;
  llvm-readobj's and llvm-readelf's views, arm64's in x86-64's names), and the run's CHECK lines are held to the view as
  FileCheck holds them. A run that states an error (`not llvm-mc`) is met when the assembler reports the stated errors. A
  Mach-O or COFF triple's object is another object writer's (:other-format); an i386 triple's is assembled in 32-bit mode
  with i386's REL addends and judged at the disassembly (:elf32 for its other views: Arbace writes ELF64)."
  (:require [arbace.repr.asm :as asm]
            [arbace.asm.amd64.asm :as x]
            [arbace.asm.amd64.obj :as obj]
            [arbace.asm.amd64.decode :as d]
            [arbace.asm.amd64.print :as p]
            [arbace.asm.obj :as o]
            [arbace.asm.arm64.objcheck :as a]
            [arbace.asm.amd64.decode-check :as dc]
            [arbace.asm.elf :as elf]
            [arbace.string :as str]))

(set! *warn-on-reflection* true)

;; ---------------------------------------------------------------------------------------------------------------------
;; the runs

(defn- triple-of
  "The run's triple; a leading `-` (an empty first component, x86-evenDirective's `-x86_64-unknown-unknown`) dropped, as
  Triple::normalize moves the architecture first."
  [^String mc]
  (str/replace (or (second (re-find #"(?:^|\s)--?m?triple[= ]+(\S+)" mc)) "x86_64-unknown-linux") #"^-+" ""))

(defn- target-of
  "{:mode 16|32|64 :format :elf|:macho|:coff :x32 BOOL :ptr 4|8} of an llvm-mc command line (its -triple, -arch)."
  [^String mc]
  (let [t (str/lower-case (triple-of mc))
        arch (second (re-find #"(?:^|\s)--?arch[= ]+(\S+)" mc))
        a32 (or (= arch "x86") (and (not= arch "x86-64") (re-find #"^(i[3-7]86|x86-?32|x86$)" t)))]
    {:mode (cond (re-find #"code16" t) 16 a32 32 :else 64)
     :ptr (if (or a32 (re-find #"code16" t)) 4 8)
     :format (cond (re-find #"darwin|apple|macos|ios" t) :macho
                   (re-find #"win|msvc|mingw|cygwin|coff|uefi" t) :coff
                   :else :elf)
     :x32 (boolean (re-find #"gnux32" t))
     ;; Triple::isLFI (x86_64_lfi): the LFI rewriter and its note (x86-print)
     :lfi (boolean (re-find #"^x86_64_lfi(-|$)" t))}))

;; llvm-mc's options a run may give, and what each sets of X86AsmBackend's (the rest are an :options class)
(def ^:private known-mc-flags
  #{"-filetype" "--filetype" "-triple" "--triple" "-mtriple" "-arch" "--arch" "-o" "-show-encoding" "--show-encoding"
    "-mcpu" "--mcpu" "--x86-align-branch-boundary" "-x86-align-branch-boundary" "--x86-align-branch" "-x86-align-branch"
    "-x86-pad-max-prefix-size" "--x86-pad-max-prefix-size" "-x86-pad-for-align" "--x86-pad-for-align" "--mc-relax-all"
    "-mc-relax-all" "-defsym" "--defsym" "--stats" "-stats" "-x86-relax-relocations" "--x86-relax-relocations" "--x86-branches-within-32B-boundaries" "-x86-branches-within-32B-boundaries"
    ;; the compact unwind's (x86-objs): MCTargetOptions' EmitDwarfUnwind and EmitCompactUnwindNonCanonical
    "--emit-dwarf-unwind" "-emit-dwarf-unwind" "-emit-compact-unwind-non-canonical" "--emit-compact-unwind-non-canonical"})

(defn- backend-opts
  "The run's X86AsmBackend options, or [:options FLAG] for one this check does not take."
  [^String mc]
  (let [;; (x86-objs: a run that states an error or a crash, `not [--crash] llvm-mc ...`, its llvm-mc's flags alone)
        mc (str/replace mc #"^\s*not\s+(?:--crash\s+)?" "")
        ws (vec (str/split (str/trim mc) #"\s+"))
        ;; a value given after its flag (`-triple -x86_64-unknown-unknown`, `-o -`) is no flag
        valued #{"-triple" "--triple" "-mtriple" "-arch" "--arch" "-o" "-mcpu" "--mcpu" "-filetype" "--filetype" "--emit-dwarf-unwind" "-emit-dwarf-unwind"}
        flags (for [[i w] (map-indexed vector ws) :when (and (re-find #"^-." w) (not (valued (get ws (dec (long i))))))]
                (first (str/split w #"=")))
        unknown (first (remove known-mc-flags flags))
        val (fn [re] (second (re-find re mc)))
        within (re-find #"-x86-branches-within-32B-boundaries" mc)
        b (val #"-x86-align-branch-boundary[= ](\d+)")
        k (val #"-x86-align-branch[= ]([a-z+]+)")]
    (if unknown
      [:options unknown]
      {:cpu (val #"(?:^|\s)--?mcpu[= ](\S+)")
       :boundary (cond b (Long/parseLong b) within 32 :else 0)
       :kinds (cond k (set (map keyword (str/split k #"\+"))) within #{:fused :jcc :jmp} :else #{})
       :prefix-max (if-let [v (val #"-x86-pad-max-prefix-size[= ](\d+)")] (Long/parseLong v) 0)
       :pad-for-align (boolean (re-find #"-x86-pad-for-align(?:=(?:1|true))?(?:\s|$)" mc))
       :relax-all (boolean (re-find #"(?:^|\s)--?mc-relax-all(?:\s|$)" mc))
       ;; -x86-relax-relocations=false: GOTPCREL without its relaxable forms (queue 372)
       :relax-relocations (not (re-find #"-x86-relax-relocations=(?:false|0)" mc))
       ;; the compact unwind's options (x86-objs: arbace.asm.amd64.macho/*unwind*)
       :unwind {:dwarf (keyword (or (val #"-emit-dwarf-unwind[= ](\S+)") "default"))
                :non-canonical (boolean (re-find #"-emit-compact-unwind-non-canonical(?:=(?:1|true))?(?:\s|$)" mc))}})))

(defn- fc-opts [^String fc]
  {:prefixes (let [ps (mapcat #(str/split % #",") (map second (re-seq #"--?check-prefix(?:es)?[= ]+(\S+)" fc)))] (if (seq ps) (vec ps) ["CHECK"]))
   :full-lines (boolean (re-find #"--match-full-lines" fc))
   :implicit-not (mapv second (re-seq #"--implicit-check-not[= ](\S+)" fc))})

(defn- viewer-tool
  "The viewer's kind: :objdump-d, :objdump-h, the arm64 verdict's views (:objdump-r :objdump-t :readobj-r :readobj :readelf-s
  :readelf-x :readelf), else :view-TOOL."
  [^String viewer]
  (let [ws (set (rest (str/split (str/trim viewer) #"\s+")))]
    (cond (and (re-find #"^llvm-objdump" viewer) (re-find #"(^|\s)(-[a-zA-Z]*d[a-zA-Z]*|--disassemble)(\s|$)" viewer)
               (not (re-find #"(^|\s)-D(\s|$)|--disassemble-all|--section[= ]|-j\s|--no-addresses|--unwind|--fault" viewer)))
          :objdump-d
          (and (re-find #"^llvm-objdump" viewer) (some #{"--headers" "-h" "--section-headers"} ws)) :objdump-h
          ;; x86-objs: the unwind information (with --dwarf=frames the call frames after it) and the fault maps
          (and (re-find #"^llvm-objdump" viewer) (some #{"--unwind-info" "-u"} ws)
               (every? #{"--unwind-info" "-u" "--macho" "-m" "--dwarf=frames" "-"} (remove #(re-find #"^%t" %) ws))) :objdump-unwind
          (and (re-find #"^llvm-objdump" viewer) (= #{"--fault-map-section"} (set (remove #(re-find #"^%t|^-$" %) ws)))) :objdump-faultmap
          (and (re-find #"^llvm-nm" viewer) (empty? (remove #(re-find #"^%t|^-$" %) ws))) :nm
          (and (re-find #"^llvm-objdump" viewer) (some #{"-t" "--syms"} ws)) :objdump-t
          (and (re-find #"^llvm-objdump" viewer) (some #{"-r" "--reloc"} ws) (not (re-find #"-D|--section" viewer))) :objdump-r
          (and (re-find #"^llvm-readobj" viewer) (re-find #"(^|\s)(-r|--relocs|--relocations)\b" viewer)
               (not (re-find #"(^|\s)(-S|--sections|-s|--symbols|--section-data|--sd)\b" viewer))) :readobj-r
          (and (re-find #"^llvm-readobj" viewer)
               ;; the sections' data too (--sd; x86-print, as arm64's judge-rest)
               (every? #{"-S" "--sections" "--section-headers" "-r" "--relocs" "--relocations" "--symbols" "--syms" "-" "--elf-output-style=LLVM"
                         "--sd" "--section-data"}
                       (remove #(re-find #"^%t" %) ws))) :readobj
          (and (re-find #"^llvm-readelf" viewer) (= #{"-s"} (set (remove #(re-find #"^%t|^-$" %) ws)))) :readelf-s
          (and (re-find #"^llvm-readelf" viewer) (re-matches #"llvm-readelf(\s+(-S|-r|-x\s+\S+|--hex-dump=\S+))+\s+(-|%t\S*)" (str/trim viewer))) :readelf
          :else (keyword (str "view-" (first (str/split viewer #"\s+")))))))

(defn split-parts
  "split-file's parts of the test (llvm/tools/split-file: a `--- NAME` line after a comment's leader starts part NAME): NAME
  -> its text, its lines after leading blank ones so that its line numbers are the test's (split-file without
  --no-leading-lines; queue 372)."
  [^String src]
  (let [ls (vec (str/split-lines src))
        marks (keep-indexed (fn [i l] (when-let [[_ n] (re-matches #"^(?:#|//|;|!|@)\s*--- (\S+)\s*$" l)] [i n])) ls)]
    (into {} (for [[[i n] [j]] (partition 2 1 [[(count ls)]] marks)]
               [n (str (str/join "\n" (concat (repeat (inc (long i)) "") (subvec ls (inc (long i)) j))) "\n")]))))

(defn- part-of
  "The split-file part a word names (NAME or %t/NAME), or nil."
  [parts ^String w]
  (or (get parts w) (when (str/starts-with? w "%t/") (get parts (subs w 3)))))

(defn runs
  "The object runs of a test: [{:mc TEXT :target {...} :backend {...} :viewer TEXT :tool KIND :prefixes [...] :error? :stdin?
  :defsym :stats?}]: an llvm-mc -filetype=obj command and the viewer its object goes to (a pipe, or %t read by a later
  RUN line), FileCheck's options."
  [^String src]
  (let [lines (a/run-lines src)
        parts (if (some #(re-find #"split-file\s+%s\s+%t" %) lines) (split-parts src) {})
        ;; a run's input and its FileCheck's file in split-file's parts (queue 372): the part's text, its name
        part-in (fn [^String mc] (some #(when-let [t (part-of parts %)] [t (if (str/starts-with? % "%t/") (subs % 3) %)])
                                      (str/split (str/trim mc) #"\s+")))
        part-fc (fn [^String fc] (let [ws (rest (str/split (str/trim fc) #"\s+"))
                                       f (first (remove #(str/starts-with? % "-") ws))]
                                   (when f (part-of parts f))))
        ;; the objects written to a file: NAME -> its llvm-mc command
        written (into {} (for [r lines :let [mc (first (str/split r #"\|"))]
                               :when (and (re-find #"llvm-mc\b" mc) (re-find #"filetype[= ]obj" mc))
                               :let [out (second (re-find #"(?:^|\s)-o\s*(%t\S*)" mc))]
                               :when out]
                           [out mc]))
        mk (fn [mc viewer fc extra]
             (merge {:mc mc :error? (boolean (re-find #"^\s*not\s" mc))
                     :stdin? (boolean (re-find #"<\s*%s" mc))
                     ;; a run that assembles another file of the test's directory (`%S/Inputs/NAME`; x86-objs): that file
                     :input (second (re-find #"(?:^|\s)%S/(\S+)" mc))
                     :split? (boolean (and (not (part-in mc)) (not (re-find #"(?:^|\s)%S/\S+" mc))
                                           (or (re-find #"%t/|%S/|split-file" mc) (not (re-find #"%s" mc)))))
                     :part (part-in mc) :check-src (part-fc fc)
                     :target (target-of mc) :backend (backend-opts mc)
                     :defsym (o/defsym-of mc)
                     :viewer viewer :tool (if viewer (viewer-tool viewer) :no-viewer)}
                    (fc-opts fc) extra))]
    (vec
     (for [r lines
           :let [pieces (mapv str/trim (str/split r #"\|"))
                 fc (first (filter #(re-find #"^FileCheck" %) pieces))]
           :when fc
           :let [p0 (first pieces)
                 run (cond
                       ;; llvm-mc's object, piped
                       (and (re-find #"llvm-mc\b" p0) (re-find #"filetype[= ]obj" p0))
                       (let [viewer (first (filter #(re-find #"^llvm-(objdump|readobj|readelf|dwarfdump|nm)\b" %) (rest pieces)))]
                         (cond (re-find #"--stats" p0) (mk p0 nil fc {:tool :stats})
                               (and (nil? viewer) (not (re-find #"^\s*not\s" p0)) (re-find #"-o\s*%t" p0)) nil
                               :else (mk p0 viewer fc {})))
                       ;; a viewer of an object an earlier RUN line wrote
                       (re-find #"^llvm-(objdump|readobj|readelf|dwarfdump|nm)\b" p0)
                       (when-let [in (some #(when (re-find #"^%t" %) %) (str/split p0 #"\s+"))]
                         (when-let [mc (written in)] (mk mc p0 fc {:file-input in}))))]
           :when run]
       run))))

;; ---------------------------------------------------------------------------------------------------------------------
;; the object of a run

(defn assemble-run
  "The run's object: arbace.asm.amd64.obj/assemble's result for the file at PATH in the run's mode, with its backend options."
  [^String path run]
  (try
    (let [{:keys [mode format ptr]} (:target run)
          ;; a run's input of the test's directory (x86-objs)
          path (if-let [in (:input run)] (str (.getParent (java.io.File. path)) "/" in) path)]
      (obj/assemble (asm/read-items (or (first (:part run)) (asm/latin1 path)) asm/amd64)
                    {:mode mode :defsym (o/defsyms (:defsym run)) :backend (:backend run) :rel? (and (= :elf format) (not= 64 mode))
                     :lfi (:lfi (:target run))
                     ;; the triple's object format (x86-objs, AXS99 (b)): Mach-O's or COFF's writer
                     :format (when-not (= :elf format) format) :ptr-mode (if (= 4 (long ptr)) 32 64)
                     :unwind (:unwind (:backend run))}))
    (catch arbace.lang.ExceptionInfo e
      (if-let [c (:obj/unsupported (ex-data e))] {:unsupported c :what (.getMessage e)} {:unsupported :crash :what (str e)}))
    (catch Throwable e {:unsupported :crash :what (str e)})))

;; ---------------------------------------------------------------------------------------------------------------------
;; llvm-objdump -d (llvm-objdump.cpp's disassembleObject, PrettyPrinter::printInst, printRawData; X86MCInstrAnalysis's
;; evaluateBranch and evaluateMemoryOperandAddress)

(defn- hex2 [b] (format "%02x" (bit-and (long b) 0xff)))

(defn- section-symbols
  "llvm-objdump's symbols of the section: the symbol table's in it but sections' and files', sorted as SymbolInfoTy (address,
  name, type), and the section's name at its start when no symbol is there."
  [o sec]
  (let [i (:index sec)
        ys (for [y (:symbols o) :when (and (= (:shndx y) i) (not (#{elf/STT_SECTION elf/STT_FILE} (:type y))) (pos? (long (:index y))))]
             {:addr (:value y) :name (:name y) :type (:type y)})
        ys (if (some #(zero? (long (:addr %))) ys) ys (conj ys {:addr 0 :name (:name sec) :type 2}))]
    (vec (sort-by (juxt :addr :name :type) (fn [a b] (compare a b)) ys))))

(defn- target-label
  "` <SYM>` or ` <SYM+0xOFF>`: the last symbol at or before the target among the section's."
  [syms ^long t]
  (when-let [y (last (filter #(<= (long (:addr %)) t) syms))]
    (let [disp (- t (long (:addr y)))]
      (str " <" (:name y) (when (pos? disp) (str "+0x" (Long/toHexString disp))) ">"))))

(defn- objdump-flags [^String viewer]
  {:raw (not (re-find #"--no-show-raw-insn" viewer))
   :imm-hex (not (re-find #"--no-print-imm-hex" viewer))
   :relocs (boolean (re-find #"(^|\s)(-[a-zA-Z]*r[a-zA-Z]*|--reloc)(\s|$)" viewer))
   :intel (boolean (re-find #"-M\s*intel|--x86-asm-syntax=intel|--disassembler-options=intel" viewer))
   :mode (when-let [t (second (re-find #"--triple[= ](\S+)" viewer))] (:mode (target-of (str "-triple " t))))})

(defn disasm-lines
  "llvm-objdump -d's lines (disassembleObject) of the code sections `secs` ({:name :addr :data BYTES :syms [{:addr :name :type}],
  each section's symbols at their addresses, :relocs [{:offset :line}] for -r), the file's header line FILE-LINE: each section's
  labels, each instruction with its address, bytes (unless --no-show-raw-insn), text, branch target and RIP-relative operand's
  address, and with -r each relocation after its instruction. Shared by the formats' views (x86-objs)."
  [file-line secs run]
  (let [{:keys [raw imm-hex relocs intel mode]} (objdump-flags (:viewer run))
        tgt (:target run)
        mode (long (or mode (:mode tgt)))
        ptr (long (:ptr tgt))]
    (binding [x/*t* (x/table) p/*t* (x/table) p/*imm-hex* imm-hex p/*intel* intel]
      (concat
       ["" file-line]
       (mapcat
        (fn [sec]
          (let [^bytes data (:data sec) n (alength data) base (long (:addr sec 0))
                bs (mapv #(bit-and (long %) 0xff) data)
                syms (vec (sort-by (juxt :addr :name :type) (fn [a b] (compare a b)) (:syms sec)))
                groups (partition-by :addr syms)
                rs (sort-by :offset (:relocs sec))
                body (vec (mapcat
                           (fn [[g nxt]]
                             (let [start (- (long (:addr (first g))) base) end (long (if nxt (- (long (:addr (first nxt))) base) n)) end (min end n)]
                               (when (< start end)
                                 (let [code (filterv #(not (#{1 5} (long (:type %)))) g)
                                       shown (if (seq code) (last code) (last g))]
                                   (concat
                                    ["" (str (format (if (= 4 ptr) "%08x" "%016x") (+ base start)) " <" (:name shown) ">:")]
                                    (loop [i start out []]
                                      (if (>= i end)
                                        out
                                        (let [e (d/decode bs i mode)
                                              size (long (max 1 (long (:size e 1))))
                                              ibs (subvec bs i (min n (+ i size)))
                                              pc (+ base i)
                                              lead (str (format "%8x:" pc) (when raw (str " " (str/join " " (map hex2 ibs)))))
                                              text (if (:fail e)
                                                     "\t<unknown>"
                                                     (let [info (get-in x/*t* [:insns (:inst e)])
                                                           pc? (re-find #"brtarget" (str (second (first (:ops info)))))]
                                                       (str (binding [p/*branch-address* (when pc? [(+ pc size) ptr])]
                                                              (p/print-inst (:inst e) (:mi e) (:flags e) mode))
                                                            (when pc?
                                                              (let [t (+ pc size (long (:imm (first (:mi e)) 0)))]
                                                                (target-label syms (if (= 4 ptr) (bit-and t 0xffffffff) t))))
                                                            ;; a RIP-relative memory operand's address, a comment
                                                            (when-let [m (#'obj/mem-operand (:inst e))]
                                                              (let [mi (:mi e) [base scale index disp seg] (subvec (vec mi) m (+ (long m) 5))]
                                                                (when (and (= "RIP" (:reg base)) (nil? (:reg index)) (nil? (:reg seg)) (= 1 (:imm scale)) (contains? disp :imm))
                                                                  (let [t (+ pc size (long (:imm disp)))]
                                                                    (str " # 0x" (Long/toHexString t) (target-label syms t)))))))))
                                              rl (when relocs
                                                   (for [r rs :when (and (<= pc (long (:offset r))) (< (long (:offset r)) (+ pc size)))] (:line r)))]
                                          (recur (+ i size) (-> out (conj (str lead " " text)) (into rl)))))))))))
                           (partition 2 1 [nil] groups)))]
            (when (seq body) (concat ["" (str "Disassembly of section " (:name sec) ":")] body))))
        secs)))))

(defn view-objdump-d
  "llvm-objdump -d's lines of the ELF object `o` for the run (disasm-lines over its code sections, the symbols as SymbolInfoTy
  holds them, -r's relocations in llvm-objdump's format)."
  [o run]
  (let [tgt (:target run) ptr (long (:ptr tgt))
        file (if (:file-input run) (:file-input run) "<stdin>")]
    (disasm-lines
     (str file ":\tfile format " (if (= 4 ptr) "elf32-i386" "elf64-x86-64"))
     (for [sec (:sections o) :when (pos? (bit-and (long (:flags sec)) elf/SHF_EXECINSTR))]
       {:name (:name sec) :addr 0 :data (:data sec) :syms (section-symbols o sec)
        :relocs (for [r (filter #(= (:target %) (:index sec)) (:relocs o)) :let [[nm ad] (#'a/value-text o r)]]
                  {:offset (:offset r)
                   :line (str (format "%016x:  " (:offset r)) "\t" (get elf/reloc-names (:type r) (:type r)) "\t"
                              nm (cond (pos? (long ad)) (str "+0x" (Long/toHexString ad))
                                       (neg? (long ad)) (str "-0x" (Long/toHexString (- (long ad))))
                                       :else ""))})})
     run)))

;; llvm-objdump --headers (printSectionHeaders): the sections but the null one, their index, name, size, address and kind
(defn view-objdump-h [o run]
  (let [ptr (long (:ptr (:target run))) secs (rest (:sections o))
        w (max 4 (reduce max 0 (map #(count (:name %)) secs)))]
    (concat
     ["" (str "<stdin>:\tfile format " (if (= 4 ptr) "elf32-i386" "elf64-x86-64")) "" "Sections:"
      (str "Idx " (format (str "%-" w "s") "Name") " Size     " (if (= 4 ptr) "VMA     " "VMA             ") " Type")]
     (for [[k s] (map-indexed vector (:sections o)) :when (pos? (long k))]
       (str (format "%3d " k) (format (str "%-" w "s") (:name s)) " " (format "%08x" (:size s)) " "
            (format (if (= 4 ptr) "%08x" "%016x") 0) " "
            (str/join " " (concat (when (pos? (bit-and (long (:flags s)) elf/SHF_EXECINSTR)) ["TEXT"])
                                  (when (and (zero? (bit-and (long (:flags s)) elf/SHF_EXECINSTR)) (pos? (bit-and (long (:flags s)) 2))
                                             (not= elf/SHT_NOBITS (:type s))) ["DATA"])
                                  (when (= elf/SHT_NOBITS (:type s)) ["BSS"])))))
     [""])))

;; ---------------------------------------------------------------------------------------------------------------------
;; a run judged

(def ^:private x86-target
  {:format "elf64-x86-64" :arch "x86_64" :reloc-names elf/reloc-names
   :sht {0x70000001 "SHT_X86_64_UNWIND"} :shf [["SHF_X86_64_LARGE" 0x10000000]] :gnu-flags {0x10000000 "l"}})

(defn- canon-lines [ls] (mapv (fn [l] {:text l}) ls))

(defn format-view
  "The run's viewer's text of a Mach-O or COFF object's bytes (x86-objs: arbace.asm.amd64.objview), or the class of a view not
  made (the tool's keyword)."
  [fmt ^bytes b run]
  (let [opts (rest (str/split (str/trim (:viewer run)) #"\s+"))
        tool (:tool run)
        f (fn [s] @(requiring-resolve (symbol "arbace.asm.amd64.objview" s)))]
    (case fmt
      :macho (let [o ((requiring-resolve 'arbace.asm.macho/read-object) b)]
               (case tool
                 :objdump-d (doall ((f "view-objdump-d") o run))
                 :readobj (doall ((f "view-readobj") o opts))
                 :readobj-r (doall ((f "view-readobj") o ["-r"]))
                 :objdump-unwind (doall (concat ((f "view-unwind-info") o)
                                                (when (some #{"--dwarf=frames"} opts) (or ((f "view-dwarf-frames") o) []))))
                 :objdump-faultmap (doall ((f "view-fault-map") o))
                 tool))
      :coff (let [o ((requiring-resolve 'arbace.asm.coff/read-object) b)]
              (case tool
                :objdump-d (doall ((f "coff-objdump-d") o run))
                :objdump-r (doall ((f "coff-objdump-r") o run))
                :readobj (doall ((f "coff-readobj") o opts))
                :readobj-r (doall ((f "coff-readobj") o ["-r"]))
                :nm (doall ((f "coff-nm") o))
                tool)))))

(defn judge-run
  "One run's CHECK lines against its object `r`: [[LINE RESULT]], RESULT :pass, :fail or a class."
  [^String src run r]
  (let [cs (a/check-lines src (:prefixes run))
        tgt (:target run)
        unsup (fn [] (keyword (str "unsupported-" (name (:unsupported r)))))
        all (fn [cls] (mapv (fn [[l]] [l cls]) cs))]
    (cond
      (empty? cs) []
      ;; a format whose writer is not built (x86-objs: Mach-O's and COFF's are)
      (not (#{:elf :macho} (:format tgt))) (all :other-format)
      (:x32 tgt) (all :x32)
      (vector? (:backend run)) (all :options)
      ;; llvm-mc --stats (x86-print): MCAssembler's RelaxationSteps, the one statistic the object assembler counts as LLVM's
      ;; relaxOnce does (arbace.asm.obj/layout!); its line in PrintStatistics' format (FileCheck's blanks collapsed)
      (and (= :stats (:tool run)) (:bytes r))
      (let [view [(str (:relax-steps r) " assembler - Number of assembler layout and relaxation steps")]
            res (into {} (map (fn [[l rr]] [l rr]) (binding [dc/*vars* true dc/*full-lines* (:full-lines run)] (dc/filecheck cs (canon-lines view) (:implicit-not run)))))]
        (mapv (fn [[l]] [l (case (get res l :fail) :pass :pass :var :filecheck-var :stats)]) cs))
      (= :stats (:tool run)) (all :stats)
      (:split? run) (all :split-file)
      (:error? run)
      (if (:errors r)
        (let [outs (canon-lines (o/diagnostics (or (first (:part run)) src) r (cond (:stdin? run) "<stdin>" (:part run) (second (:part run)) :else (or (:path run) "test.s"))))
              cs2 (mapv (fn [[l k c]] [l k (#'a/at-line c l)]) cs)
              res (into {} (map (fn [[l rr]] [l rr]) (binding [dc/*vars* true dc/*full-lines* (:full-lines run)] (dc/filecheck cs2 outs (:implicit-not run)))))]
          (mapv (fn [[l]] [l (case (get res l :fail) :pass :pass :var :filecheck-var :message)]) cs))
        (all (cond (:bytes r) :error-accepted (:unsupported r) (unsup) :else :message)))
      ;; an i386 run's .reloc naming an R_386_* type: i386's relocations, which Arbace's ELF64 writer does not write
      (and (= :elf (:format tgt)) (not (:bytes r)) (:error r) (not= 64 (long (:mode tgt))) (re-find #"relocation" (str (:error r)))) (all :elf32)
      (not (:bytes r)) (all (if (:error r) :object-error (unsup)))
      ;; the formats' views (x86-objs, AXS99 (b): Arbace's Mach-O and COFF objects, arbace.asm.amd64.objview)
      (not= :elf (:format tgt))
      (let [view (format-view (:format tgt) (:bytes r) run)]
        (if (keyword? view)
          (all view)
          (let [res (into {} (map (fn [[l rr]] [l rr]) (binding [dc/*vars* true dc/*full-lines* (:full-lines run)] (dc/filecheck cs (canon-lines view) (:implicit-not run)))))]
            (mapv (fn [[l]] [l (case (get res l :fail) :pass :pass :var :filecheck-var :not-found :fail :fail)]) cs))))
      (and (not= 64 (long (:mode tgt))) (not (#{:objdump-d :objdump-h} (:tool run)))) (all :elf32)
      (and (not= 64 (long (:mode tgt))) (:relocs (objdump-flags (:viewer run)))) (all :elf32)
      (#{:objdump-d :objdump-h :objdump-r :readobj-r :readobj :objdump-t :readelf-s :readelf} (:tool run))
      (let [o (elf/read-object (:bytes r))
            view (binding [a/*target* x86-target]
                   (doall
                    (case (:tool run)
                      :objdump-d (view-objdump-d o run)
                      :objdump-h (view-objdump-h o run)
                      :objdump-r (a/view-objdump-r o)
                      :readobj-r (a/view-readobj-r o)
                      :readobj (a/view-readobj o (rest (str/split (str/trim (:viewer run)) #"\s+")))
                      :objdump-t (a/view-objdump-t o)
                      :readelf-s (a/view-readelf-s o)
                      :readelf (a/view-readelf o (:viewer run)))))
            res (into {} (map (fn [[l rr]] [l rr]) (binding [dc/*vars* true dc/*full-lines* (:full-lines run)] (dc/filecheck cs (canon-lines view) (:implicit-not run)))))]
        (mapv (fn [[l]] [l (case (get res l :fail) :pass :pass :var :filecheck-var :not-found :fail :fail)]) cs))
      :else (all (:tool run)))))

(defn line-results
  "Each CHECK line of the test at PATH judged by its object runs: {LINE RESULT}, a line several runs judge failing when one
  fails, else passing when one passes, else the first run's class."
  [^String path]
  (let [src (asm/latin1 path)
        rs (mapv #(assoc % :path path) (runs src))
        asm (memoize (fn [run] (assemble-run path run)))
        res (mapcat #(try (judge-run (or (:check-src %) src) % (asm (select-keys % [:target :backend :defsym :part :input])))
                          (catch Throwable e (binding [*out* *err*] (println (str "repr-asm object-verdict: " path ": " e)))
                            (mapv (fn [[l]] [l :view-crash]) (a/check-lines src (:prefixes %)))))
                    rs)]
    {:per-run (vec res)
     :lines (into (sorted-map)
                  (for [[l g] (group-by first res) :let [vs (map second g)]]
                    [l (or (first (filter #{:fail :view-crash :object-error :unsupported-crash :message :error-accepted} vs))
                           (when (some #{:pass} vs) :pass)
                           (first vs))]))}))

(defn file-row
  "A test's row: {:stated N :met N :by {CLASS N}} over its object runs' CHECK lines (a line once a run that judges it)."
  [^String path]
  (let [f (frequencies (map second (:per-run (line-results path))))]
    {:stated (reduce + 0 (vals f)) :met (get f :pass 0) :by (into (sorted-map) (dissoc f :pass))}))

(defn control
  "A negative control: SUBJECT's object (its first run's) judged by REFERENCE's CHECK lines (its runs, in the subject's
  first run's options; a test against itself: assembled without its runs' X86AsmBackend options, the padding, alignment and
  -mcpu undone): `differs` as it must when a line is not met, `same` when every one is, `left` when there is nothing to judge."
  [subj ref]
  (let [ssrc (asm/latin1 subj) srun (first (runs ssrc))
        src (asm/latin1 ref)
        over (if (= subj ref) {:backend {}} (when srun (select-keys srun [:backend :defsym])))
        res (mapcat (fn [run] (let [r (assemble-run subj (merge run over))]
                                (if (:bytes r) (judge-run src run r) [])))
                    (filter #(and (= :elf (:format (:target %))) (not (:error? %))) (runs src)))]
    (cond (empty? (filter #(#{:pass :fail} (second %)) res)) "left"
          (some #(= :fail (second %)) res) "differs"
          :else "same")))

(defn check
  "Each NAME<tab>PATH of LIST: WORK/objverdict.edn, rows [CORPUS/NAME {:stated :met :by}]."
  [lst corpus work]
  (let [rows (vec (for [l (str/split-lines (slurp lst)) :when (seq l) :let [[n p] (str/split l #"\t")]]
                    [(str corpus "/" n) (file-row p)]))
        tot (fn [k] (reduce + 0 (map (comp k second) rows)))
        by (apply merge-with + (map (comp :by second) rows))]
    (.mkdirs (java.io.File. ^String work))
    (spit (str work "/objverdict.edn") (pr-str rows))
    (println (str "repr-asm object-verdict: " (count rows) " files, " (tot :stated) " CHECK lines of their object runs judge the object, "
                  (tot :met) " met; " (pr-str (into (sorted-map) by))))
    rows))

(def header
  (str ";; repr/asm's x86-64 object verdict (bin/repr-asm object-verdict; doc/asm/AMD64-SURVEY.md, \"As built: queue 337\"): MC/X86's\n"
       ";; object tests that object-check's mc-x86-obj leaves out (the corpus mc-x86-objverdict) assembled by Arbace (arbace.asm.amd64.obj,\n"
       ";; the run's -mcpu, branch alignment, prefix padding and relaxation options), each object run's CHECK lines held to Arbace's view of\n"
       ";; the object in the run's viewer's format (llvm-objdump -d with Arbace's decoder and printer, --headers, llvm-readobj, llvm-readelf),\n"
       ";; no LLVM tool: [CORPUS/NAME {:stated :met :by}], :by the unmet lines by class (test/asm/divergences-object.edn). Written by\n"
       ";; `bin/repr-asm object-verdict --record`. Read with the Clojure reader.\n"))

(def failing #{:fail :object-error :view-crash :unsupported-crash})

(defn judge
  "arm64's judge (arbace.asm.arm64.objcheck/judge) with x86-64's header: the run's rows against RESULTS, every unmet line in
  a class of CLASSES; RECORD rewrites RESULTS from a run with no problem."
  [results work classes-path record]
  (let [run (read-string (slurp (str work "/objverdict.edn")))
        old (if (.exists (java.io.File. ^String results)) (read-string (slurp results)) [])
        oldm (into {} old)
        classes (set (map :id (read-string (slurp classes-path))))
        problems (atom [])]
    (doseq [[i r] run [c n] (:by r)]
      (cond (failing c) (swap! problems conj (str "failing: " i " " n " " (name c)))
            (not (classes c)) (swap! problems conj (str "unclassed: " i " " n " " (name c)))))
    (if (and (seq record) (empty? @problems))
      (do (spit results (str header "[\n" (apply str (map (fn [[i r]] (str (pr-str [i (into (sorted-map) (update r :by #(into (sorted-map) %)))]) "\n")) (sort-by first run))) "]\n"))
          (println (str "repr-asm: recorded " (count run) " rows into " results)))
      (do (doseq [[i r] run :let [o (oldm i)]]
            (cond (nil? o) (swap! problems conj (str "not recorded: " i))
                  (< (long (:met r)) (long (:met o))) (swap! problems conj (str i ": " (:met r) " met, recorded " (:met o)))))
          (doseq [[i] old :when (not (some #(= i (first %)) run))] (swap! problems conj (str "recorded, not run: " i)))))
    (doseq [p @problems] (println (str "FAIL: " p)))
    (when (empty? @problems) (println "repr-asm object-verdict: ok"))
    @problems))

(defn -main [verb & args]
  (case verb
    "check" (apply check args)
    "judge" (when (seq (apply judge args)) (shutdown-agents) (System/exit 1))
    "control" (println (apply control args))
    "row" (prn (file-row (first args)))
    ;; lines FILE: each CHECK line that is not met, with its result and text
    "lines" (let [path (first args) src (str/split-lines (asm/latin1 path))]
              (doseq [[l r] (:lines (line-results path)) :when (not= r :pass)]
                (println l r (nth src (dec (long l))))))
    ;; view FILE N: the view of the file's Nth run (from 0)
    "view" (let [[path n] args src (asm/latin1 path) run (assoc (nth (runs src) (Long/parseLong (or n "0"))) :path path)
                 r (assemble-run path run)]
             (if-not (:bytes r)
               (prn (dissoc r :bytes))
               (let [o (elf/read-object (:bytes r))]
                 (binding [a/*target* x86-target]
                   (doseq [l (case (:tool run) :objdump-d (view-objdump-d o run) :objdump-h (view-objdump-h o run)
                                   :readobj (a/view-readobj o (rest (str/split (str/trim (:viewer run)) #"\s+")))
                                   [(str "no view for " (:tool run))])]
                     (println l))))))
    "runs" (doseq [r (runs (asm/latin1 (first args)))] (prn (dissoc r :part :check-src)))
    ;; diagnostics FILE [N]: the errors of the file's Nth run (from 0) as llvm-mc prints them
    "diagnostics" (let [[path n] args src (asm/latin1 path) run (assoc (nth (runs src) (Long/parseLong (or n "0"))) :path path)
                        r (assemble-run path run)]
                    (doseq [l (o/diagnostics (or (first (:part run)) src) r (if (:stdin? run) "<stdin>" path))] (println l))))
  (shutdown-agents))

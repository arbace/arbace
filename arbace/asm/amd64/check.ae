(ns arbace.asm.amd64.check
  "AX2's encoding check (doc/asm/AMD64-SURVEY.md §8.2): MC/X86's stated encodings, each `CHECK: encoding: [...]` line
  of a test judged by the test's own words (no llvm-mc): the test's RUN lines give each run's mode (the triple) and
  check prefixes, the statements are read by repr/asm (AX1), assembled by arbace.asm.amd64.asm in that mode, and each
  stated encoding is held to the encoding of the instruction it is written beside (as FileCheck holds llvm-mc
  -show-encoding's line), the pattern read as FileCheck reads it ({{regex}}, blanks collapsed). The error tests (`not
  llvm-mc`): each `error:` CHECK line held, in order, to the assembler's own errors.

  A stated encoding that is not met is classed by its cause: the file's syntax (:intel), AX1's refusal (:unread), what
  this slice does not encode (:vex, :evex, :xop, :apx, ...), a statement it cannot pair (:unpaired), and the failures
  :mismatch (another encoding) and :rejected (an error where llvm-mc encodes)."
  (:require [arbace.repr.asm :as asm]
            [arbace.asm.amd64.asm :as x]
            [arbace.asm.amd64.print :as p]
            [arbace.string :as str])
  (:import [java.util.concurrent Executors Callable Future]))

(set! *warn-on-reflection* true)

;; ---------------------------------------------------------------------------------------------------------------------
;; the test's RUN and CHECK lines

(defn- run-lines
  "The RUN lines joined (a trailing \\ continues), in order."
  [^String src]
  (let [ls (keep #(second (re-find #"RUN:\s?(.*)$" %)) (str/split-lines src))]
    (loop [ls ls cur nil out []]
      (if (empty? ls)
        (if cur (conj out cur) out)
        (let [l (str/trim (first ls))
              joined (str cur (when cur " ") (str/replace l #"\\$" ""))]
          (if (.endsWith l "\\") (recur (rest ls) joined out) (recur (rest ls) nil (conj out joined))))))))

(defn- prefixes-of [^String r]
  (let [ps (concat (map second (re-seq #"--?check-prefix(?:es)?[= ]([A-Za-z0-9_,-]+)" r)))]
    (if (seq ps) (vec (mapcat #(str/split % #",") ps)) ["CHECK"])))

(defn- mode-of [^String r]
  (let [t (second (re-find #"-m?triple[= ]+(\S+)" r))]
    (cond (nil? t) (if (re-find #"\s-(16)\b" r) 16 64)
          (re-find #"code16" t) 16
          (re-find #"^(x86_64|amd64)" t) 64
          (re-find #"^i[3-6]86" t) 32
          :else nil)))

(defn runs
  "The runs of llvm-mc on the file: [{:mode M :prefixes [...] :error? B :intel? B :encoding? B}]."
  [^String src]
  (let [rs (run-lines src)]
    (vec (for [[i r] (map-indexed vector rs)
               :when (and (re-find #"llvm-mc\b" r) (re-find #"%s" r))
               :let [;; the FileCheck reading this run's output: on the same line, else a later one reading its %t
                     fc (if (re-find #"FileCheck" r) r
                            (first (filter #(and (re-find #"FileCheck" %) (re-find #"<\s*%t(\s|$)" %)) (drop (inc i) rs))))
                     err? (boolean (re-find #"(^|\s)not\s+llvm-mc" r))
                     ;; the run's own command: the piece of the pipe that runs llvm-mc on the file
                     own (or (first (filter #(and (re-find #"llvm-mc\b" %) (re-find #"%s" %)) (str/split r #"\|"))) r)
                     ;; the llvm-mc whose output is checked: the last of the pipe (a print read again: AX3's round trips)
                     out (or (last (filter #(re-find #"llvm-mc\b" %) (str/split r #"\|"))) r)]
               :when fc]
           {:mode (mode-of r) :prefixes (prefixes-of fc) :error? err?
            :intel? (boolean (re-find #"x86-asm-syntax[= ]intel" own))
            ;; llvm-mc's lexer options the reader takes (the dialect's :masm-integers, :motorola-integers)
            :lexer (cond-> {}
                     (and (re-find #"-masm-integers" own) (not (re-find #"-masm-integers=(0|false)" own))) (assoc :masm-integers true)
                     (re-find #"-motorola-integers" own) (assoc :motorola-integers true))
            :encoding? (boolean (re-find #"-?-show-encoding" r))
            :obj? (boolean (re-find #"filetype[= ]obj" r))
            ;; what llvm-mc prints: AT&T unless the output variant is Intel's; immediates in hex with --print-imm-hex; the
            ;; output read by another tool (objdump, readobj) or with options that change the instructions
            :out-intel? (boolean (or (re-find #"output-asm-variant[= ]1" out)
                                     (and (re-find #"x86-asm-syntax[= ]intel" out) (not (re-find #"output-asm-variant[= ]0" out)))))
            ;; the output read again by another llvm-mc (`llvm-mc -output-asm-variant=1 %s | llvm-mc -x86-asm-syntax=intel`)
            :piped? (boolean (re-find #"llvm-mc[^|]*%s[^|]*\|\s*(not\s+)?llvm-mc" r))
            :imm-hex? (boolean (re-find #"print-imm-hex" r))
            ;; a triple whose rewriter changes the instructions (X86MCLFIRewriter's x86_64_lfi)
            :lfi? (boolean (re-find #"-m?triple[= ]+\S*lfi" r))
            :other-tool? (boolean (or (re-find #"filetype[= ]obj" r) (re-find #"llvm-(objdump|readobj|readelf|nm|dwarfdump)" fc)
                                      (re-find #"llvm-(objdump|readobj|readelf|nm|dwarfdump)" r)))
            ;; AXS97 (a): a run that prints LLVM's debug trace (-debug-only=..., an assertions build's)
            :debug? (boolean (re-find #"-debug-only" r))
            :options? (boolean (re-find #"x86-sse2avx|x86-align-branch|x86-pad-|x86-branches-within|mc-relax-all" r))
            ;; --defsym's names: the print level follows the file's conditionals for them (AXS32 (a)'s part)
            :defsym (let [ds (map second (re-seq #"-?-defsym[= ]([A-Za-z_.$][\w.$]*)=" r))] (when (seq ds) (set ds)))}))))

(defn checks
  "The CHECK lines of `prefixes`: [LINE KIND CONTENT] (KIND \"\" -NEXT ...)."
  [^String src prefixes]
  (let [rx (re-pattern (str "(?:^|[^A-Za-z0-9_-])(" (str/join "|" (map #(java.util.regex.Pattern/quote %) prefixes))
                            ")(-NEXT|-SAME|-NOT|-DAG|-LABEL|-EMPTY|-COUNT-\\d+)?:(.*)$"))]
    (vec (keep-indexed (fn [i l] (when-let [m (re-find rx l)] [(inc i) (or (nth m 2) "") (nth m 3)])) (str/split-lines src)))))

(defn pattern
  "FileCheck's pattern of a CHECK's text: {{regex}} as it is, the rest literal, blanks collapsed."
  [^String s]
  (let [s (str/trim s)
        parts (loop [i 0 out []]
                (let [j (.indexOf s "{{" (int i))]
                  (if (neg? j)
                    (conj out [:lit (subs s i)])
                    (let [k (.indexOf s "}}" (int (+ j 2)))]
                      (if (neg? k) (conj out [:lit (subs s i)])
                          (recur (+ k 2) (conj out [:lit (subs s i j)] [:re (subs s (+ j 2) k)])))))))]
    (re-pattern (apply str (map (fn [[k t]]
                                  (if (= k :re) (str "(?:" t ")")
                                      (str/join "\\s+" (map #(java.util.regex.Pattern/quote %) (str/split t #"\s+" -1)))))
                                parts)))))

;; ---------------------------------------------------------------------------------------------------------------------
;; assembling a file's statements

(defn- line-starts [^String src]
  (let [a (java.util.ArrayList.)]
    (.add a 0)
    (dotimes [i (.length src)] (when (= \newline (.charAt src i)) (.add a (inc i))))
    a))

(defn- line-of ^long [^java.util.ArrayList starts ^long pos]
  (let [i (java.util.Collections/binarySearch starts pos)] (inc (if (neg? i) (- (- i) 2) i))))

(defn- insn? [f] (and (seq? f) (symbol? (first f)) (not= "asm" (namespace (first f)))))

(defn- print-of
  "{:asm LINE} the instruction as llvm-mc prints it (arbace.asm.amd64.print), or {:punsup CLASS} what the printer cannot
  print yet."
  [inst mi flags mode]
  (try (binding [p/*t* x/*t*]
         (let [c (try (p/inst-comment inst mi) (catch Throwable _ nil))]
           (cond-> {:asm (p/print-inst inst mi (or flags #{}) mode)} c (assoc :comment c))))
       (catch arbace.lang.ExceptionInfo e
         (if-let [c (:print/unsupported (ex-data e))] {:punsup c :pwhat (.getMessage e)} (throw e)))))

(defn assemble-file
  "[[LINE ENCODINGS] ...] for each instruction statement in `mode`: ENCODINGS a vector of {:text \"encoding: [...]\"} or
  {:error MSG} or {:unsupported C}. The statements are in the syntax arbace.asm.amd64.asm/*intel* says at the start, then as
  `.intel_syntax` and `.att_syntax` switch it. With `defs` (a run's --defsym names) the conditionals `.ifdef`, `.ifndef`,
  `.else` and `.endif` are followed, a name defined by --defsym or an assignment before (AsmParser's parseDirectiveIfdef);
  without, every statement is assembled."
  ([items starts mode] (assemble-file items starts mode nil))
  ([items starts ^long mode defs]
  (loop [items items mode mode syms {} out [] gcc false intel x/*intel* conds ()]
    (if (empty? items)
      out
      (let [[f s _] (first items)
            h (when (and defs (seq? f) (symbol? (first f)) (= "asm" (namespace (first f)))) (name (first f)))
            active? (every? second conds)]
        (cond
          (not (seq? f)) (recur (rest items) mode syms out gcc intel conds)
          (#{"ifdef" "ifndef" "ifnotdef"} h)
          (let [nm (let [a (second f)] (cond (symbol? a) (name a) (and (seq? a) (= 'sym (first a))) (second a) :else (str a)))
                d (or (contains? defs nm) (contains? syms nm))]
            (recur (rest items) mode syms out gcc intel (conj conds [true (if (= h "ifdef") d (not d))])))
          (and h (.startsWith ^String h "if")) (recur (rest items) mode syms out gcc intel (conj conds [false true]))
          (= h "else") (recur (rest items) mode syms out gcc intel
                              (if (seq conds) (let [[known c] (first conds)] (conj (rest conds) [known (if known (not c) true)])) conds))
          (= h "endif") (recur (rest items) mode syms out gcc intel (if (seq conds) (rest conds) conds))
          (not active?) (recur (rest items) mode syms out gcc intel conds)
          (insn? f)
          (let [es (vec (mapcat (fn [r] (cond (:bytes r) (cond->> [(merge {:text (x/encoding-text r) :inst (:inst r) :mi (:mi r) :pflags (:pflags r) :mode mode}
                                                                         (print-of (:inst r) (:mi r) (:pflags r) mode))]
                                                            (:wait r) (cons (merge {:text "encoding: [0x9b]" :inst "WAIT" :mi [] :pflags #{} :mode mode}
                                                                                   (print-of "WAIT" [] #{} mode))))
                                               :else [r]))
                                (try (binding [x/*gcc* gcc x/*intel* intel] (x/assemble-insn f mode syms))
                                     (catch Throwable e [{:unsupported :crash :what (str (pr-str f) ": " e)}]))))]
            (recur (rest items) mode syms (conj out [(line-of starts s) es]) gcc intel conds))
          :else
          (let [h (name (first f))]
            (case h
              "code16" (recur (rest items) 16 syms out false intel conds)
              "code16gcc" (recur (rest items) 16 syms out true intel conds)
              "code32" (recur (rest items) 32 syms out false intel conds)
              "code64" (recur (rest items) 64 syms out false intel conds)
              "intel_syntax" (recur (rest items) mode syms out gcc true conds)
              "att_syntax" (recur (rest items) mode syms out gcc false conds)
              ("=" "set" "equ")
              (let [[_ a b] f nm (cond (symbol? a) (name a) (and (seq? a) (= 'sym (first a))) (second a))]
                (recur (rest items) mode (if nm (assoc syms nm b) syms) out gcc intel conds))
              (recur (rest items) mode syms out gcc intel conds)))))))))

;; ---------------------------------------------------------------------------------------------------------------------
;; judging a file

(defn- enc-content [^String c] (let [i (.indexOf c "encoding: [")] (when-not (neg? i) (subs c i))))

(defn- judge-encodings
  "Each stated encoding of `cs` ([LINE KIND CONTENT]) judged as FileCheck matches it in llvm-mc's output, in order: the
  first instruction from the last one matched on whose encoding the pattern matches. [LINE CLASS OUTPUTS]: a stated
  encoding no instruction meets is classed by the nearest instruction not matched yet."
  [cs stmts]
  (let [outs (vec (for [[l es] stmts e es] [l e]))
        cs (vec (keep (fn [[l k c]] (when-let [e (enc-content c)] [l (pattern e)])) cs))
        n (count outs)]
    (loop [i 0 cur 0 res []]
      (if (= i (count cs))
        res
        (let [[l p] (nth cs i)
              hit (loop [k cur] (when (< k n)
                                  (let [e (second (nth outs k))]
                                    (if (and (:text e) (re-find p (:text e))) k (recur (inc k))))))]
          (if hit
            (recur (inc i) (inc (long hit)) (conj res [l :pass [(second (nth outs hit))]]))
            (let [;; the instruction it is written beside: the nearest one not matched yet
                  e (when (< cur n) (second (apply min-key #(Math/abs (- (long (first %)) (long l))) (subvec outs cur))))]
              (recur (inc i) cur
                     (conj res [l (cond (nil? e) :unpaired (:unsupported e) (:unsupported e) (:error e) :rejected :else :mismatch)
                                (when e [e])])))))))))

(defn- judge-errors
  "The error test's `error:` CHECK lines held in order to the assembler's errors: [MET STATED]."
  [cs stmts]
  (let [errs (vec (for [[_ es] stmts e es :when (:error e)] (str "error: " (:error e))))
        ps (vec (keep (fn [[_ k c]] (when (and (not= k "-NOT") (re-find #"error:" c))
                                      (pattern (subs c (.indexOf ^String c "error:"))))) cs))]
    (loop [ps ps i 0 met 0]
      (if (empty? ps)
        [met (count (vec (keep (fn [[_ k c]] (when (and (not= k "-NOT") (re-find #"error:" c)) c)) cs)))]
        (let [j (first (keep-indexed (fn [k e] (when (and (>= k i) (re-find (first ps) e)) k)) errs))]
          (if j (recur (rest ps) (inc (long j)) (inc met)) (recur (rest ps) i met)))))))

;; the print level (AXS29 (a)): each CHECK line's text, the part before an `encoding: [...]`, held to the printed
;; instructions as FileCheck holds it to llvm-mc's output (forward from the last match, -SAME on the same line), its
;; blanks collapsed; a line of what this printer does not print (directives, labels, fixups, comments) classed by its kind

(defn- text-part
  "The CHECK content's instruction text: before an `encoding:`, without a trailing `#`; nil when nothing is left."
  [^String c]
  (let [i (.indexOf c "encoding:")
        t (str/trim (if (neg? i) c (subs c 0 i)))
        t (str/trim (str/replace t #"#+$" ""))]
    (when (seq t) t)))

(defn text-kind
  "The kind of a CHECK text this printer does not print, else nil."
  [^String t]
  (let [t' (str/replace t #"^\{\{[^}]*\}\}\s*" "")]
    (cond
      (re-find #"fixup [A-Z]+ - offset|^\s*(value|kind|offset):" t) :fixup
      (re-find #"<MCInst|<MCOperand|^\s*#?\s*<" t) :show-inst
      (re-find #"(^|\s)(error|warning|note):" t) :diagnostic
      (re-find #"^#|imm = 0x|^[a-z0-9]+ = |= mem\[|= zero|\[[0-9u,]+\]$|^ymm|^xmm|^zmm|^k[0-7] =" t') :comment
      (re-find #"^\.[A-Za-z_]" t') :directive
      (re-find #"^[\w.$@\"{}\[\]-]+:(\s|$)" t') :directive
      (re-find #"^\^|^~+$|\.s:\d+:" t) :diagnostic
      :else nil)))

(def ^:private mnemonics-of
  (memoize (fn [t]
             (into #{"lock" "rep" "repne" "notrack" "{nf}" "{vex}" "{vex2}" "{vex3}" "{evex}" "{disp8}" "{disp32}" "callq" "data32"}
                   ;; the matchers' mnemonics too: a print that starts with a print method's text (CCMP's, CTEST's, CFCMOV's
                   ;; and SETZU's condition code, `ccmp` + `b` + `w`) is read by its matchable's mnemonic (`ccmpbw`)
                   (concat (map first (concat (:match t) (:match-intel t)))
                           (for [[_ i] (:insns t) k [:print :print-intel] :let [f (first (k i))] :when (string? f)]
                             (first (str/split f #"[\s]")))
                           (for [[_ ps] (:print-aliases-intel t) [fr] ps :when (string? (first fr))] (first (str/split (first fr) #"\s")))
                           (for [[_ ps] (:print-aliases t) [fr] ps :when (string? (first fr))] (first (str/split (first fr) #"\s"))))))))

(defn- instruction-text?
  "Whether a CHECK text can be an instruction's line: its first word a mnemonic or prefix the printer writes (a
  comparison's predicate in its mnemonic too), or a FileCheck pattern."
  [^String t]
  (let [w (str/lower-case (first (str/split (str/trim t) #"\s+")))]
    (or (.startsWith w "{{") (.startsWith w "[[") (contains? (mnemonics-of x/*t*) w)
        (re-matches #"v?cmp[a-z_]+(ps|pd|ss|sd|sh|ph|bf16)|vpcmp[a-z_]+u?[bwdq]|vpcom[a-z]+u?[bwdq]" w))))

(defn- judge-text
  "Each CHECK text of `cs` held to the printed instructions in order: [LINE CLASS OUTPUT]."
  [cs stmts show?]
  (let [outs (vec (for [[l es] stmts e es] [l e]))
        n (count outs)]
    (loop [cs cs k 0 off 0 res []]
      (if (empty? cs)
        res
        (let [[l kind c] (first cs)
              t (when-not (#{"-NOT" "-EMPTY"} kind) (text-part c))]
          (cond
            (or (nil? t) (re-find #"^-COUNT" kind)) (recur (rest cs) k off res)
            ;; a comment's text held to the printed lines with their comments (`inst-comment`), FileCheck's way: met, else
            ;; :mismatch beside an instruction whose comment the printer writes, else still :comment
            (= :comment (text-kind t))
            (let [pat (pattern t)
                  line (fn [i] (let [e (second (nth outs i))] (when (and (:asm e) (:comment e)) (str (:asm e) "\t# " (:comment e)))))
                  try-at (fn [i from] (when-let [a (line i)]
                                        (let [m (re-matcher pat a)] (when (.find m (int (min (count a) from))) [i (.end m)]))))
                  hit (if (= kind "-SAME")
                        (when (< k n) (try-at k off))
                        (or (when (< k n) (try-at k off)) (some #(try-at % 0) (range (inc k) n))))]
              (if hit
                (recur (rest cs) (long (first hit)) (long (second hit)) (conj res [l :pass (line (first hit))]))
                (let [rest-outs (subvec outs (min k n))
                      e (when (seq rest-outs)
                          (second (reduce (fn [a b] (if (< (Math/abs (- (long (first b)) (long l))) (Math/abs (- (long (first a)) (long l)))) b a))
                                          rest-outs)))]
                  (recur (rest cs) k off (conj res [l (if (:comment e) :mismatch :comment) (when e (:asm e))])))))
            (text-kind t) (recur (rest cs) k off (conj res [l (text-kind t) nil]))
            :else
            (let [pat (pattern t)
                  try-at (fn [i from] (let [e (second (nth outs i))
                                            a (when (:asm e) (if show? (str (:asm e) "\t# " (:text e)) (:asm e)))]
                                        (when a (let [m (re-matcher pat a)]
                                                  (when (.find m (int (min (count a) from))) [i (.end m)])))))
                  hit (if (= kind "-SAME")
                        (when (< k n) (try-at k off))
                        (or (when (< k n) (try-at k off))
                            (some #(try-at % 0) (range (inc k) n))))]
              (if hit
                (recur (rest cs) (long (first hit)) (long (second hit)) (conj res [l :pass (:asm (second (nth outs (first hit))))]))
                (let [rest-outs (subvec outs (min k n))
                      ;; the nearest statement, the earlier one of two as near (a CHECK written after its instruction)
                      e (when (seq rest-outs)
                          (second (reduce (fn [a b] (if (< (Math/abs (- (long (first b)) (long l))) (Math/abs (- (long (first a)) (long l)))) b a))
                                          rest-outs)))]
                  (recur (rest cs) k off
                         (conj res [l (cond (not (instruction-text? t)) :directive
                                            (nil? e) :unpaired (:unsupported e) (:unsupported e) (:error e) :rejected
                                            (:punsup e) (:punsup e) :else :mismatch)
                                    (when e (or (:asm e) (:error e) (:what e) (:pwhat e)))])))))))))))

(defn- norm
  "An MCInst's operands with every quoted name as a symbol (`\"rsi\"` and rsi are one name)."
  [x]
  (cond (and (seq? x) (= 'sym (first x)) (= 2 (count x))) (symbol (second x))
        (seq? x) (apply list (map norm x))
        (vector? x) (mapv norm x)
        (map? x) (into {} (map (fn [[k v]] [k (norm v)]) x))
        :else x))

;; the instructions the matchers' tables name (MatchTable0 and MatchTable1)
(def ^:private matchable-insts (memoize (fn [t] (into #{} (map #(nth % 2)) (concat (:match t) (:match-intel t))))))

(defn cross-judge
  "The cross-syntax judge (doc/asm/AMD64-SURVEY.md §5, §8.1; AX3): each AT&T statement's machine instruction printed in Intel
  syntax by the Intel printer, read back by the Intel reader and matched by the Intel matcher in the same mode with the same
  constant symbols, must be the same machine instruction (instruction and operands). [[LINE CLASS DETAIL] ...]: :pass, or a
  failure (:mismatch another instruction, :rejected the matcher's error, :unread the reader's refusal, :crash), or the class
  of what the printer does not print (its :print/unsupported class)."
  [stmts ^long mode items]
  (let [syms (into {} (keep (fn [[f]] (when (and (seq? f) (#{'asm/= 'asm/set 'asm/equ} (first f)))
                                         (let [[_ a b] f] (when (symbol? a) [(name a) b]))))
                            items))]
    (vec (for [[l es] stmts e es :when (:inst e)]
           (try
             (let [mode (long (or (:mode e) mode))
                   txt (binding [p/*t* x/*t* p/*intel* true p/*imm-hex* false] (p/print-inst (:inst e) (:mi e) (or (:pflags e) #{}) mode))
                   fs (try (mapv first (asm/read-items txt {:arch :amd64 :syntax :intel}))
                           (catch Throwable ex [:unread (.getMessage ex)]))]
               (cond
                 ;; a symbol whose name starts with `$` (AT&T's `$foo` in an expression): Intel has no `$`
                 (and (= :unread (first fs)) (re-find #"[\[ +\-]\$[A-Za-z_]" txt)) [l :dollar-name (str txt " | " (second fs))]
                 (= :unread (first fs)) [l :intel-unread (str txt " | " (second fs))]
                 ;; a standalone mask operand (AVX512PF's `{k1}, [...]`): Intel's operand parser takes `{` for a rounding mode
                 (re-find #"\t\{k[0-7]\}," txt) [l :mask-operand txt]
                 :else
                 (let [rs (vec (mapcat (fn [f] (binding [x/*intel* true] (x/assemble-insn f mode syms))) fs))
                       ok (filter :inst rs)
                       same? (fn [o] (and (= (:inst e) (:inst o)) (= (norm (:mi e)) (norm (:mi o)))))
                       intel-of (fn [o] (binding [p/*t* x/*t* p/*intel* true p/*imm-hex* false] (p/print-inst (:inst o) (:mi o) (or (:pflags o) #{}) mode)))
                       pcrel-imm? (some (fn [[k pm]] (and (= pm "printPCRelImm") (contains? (nth (:mi e) k nil) :imm)))
                                        (filter vector? (:print-intel (get (:insns x/*t*) (:inst e)))))]
                   (cond
                     (and (some :error rs) pcrel-imm?) [l :pcrel-imm (str txt " | " (:error (first (filter :error rs))))]
                     ;; an instruction no matchable names (processInstruction's ROL8r1_ND, DisassembleOnly): no reading prints it
                     (and (some :error rs) (not (contains? (matchable-insts x/*t*) (:inst e))))
                     [l :disassemble-only (str txt " | " (:error (first (filter :error rs))))]
                     (some :error rs) [l :rejected (str txt " | " (:error (first (filter :error rs))))]
                     (some :unsupported rs) [l (:unsupported (first (filter :unsupported rs))) txt]
                     (and (= 1 (count ok)) (same? (first ok))) [l :pass txt]
                     ;; a prefix word printed as its own line (rex64, data16): the instruction after it the statement's
                     (and (seq ok) (same? (last ok))) [l :pass txt]
                     ;; another instruction whose Intel print is the same text: Intel's spelling names both
                     (and (seq ok) (= txt (intel-of (last ok)))) [l :ambiguous (str txt " | " (:inst (last ok)) " for " (:inst e))]
                     ;; another instruction, its print another text (`call [rax]` for lcall, `mov ax, cs` read as mov eax, cs)
                     (and (seq ok) (not= (:inst e) (:inst (last ok)))) [l :other-instruction (str txt " | " (:inst (last ok)) " for " (:inst e))]
                     :else [l :mismatch (str txt " | " (pr-str (map (juxt :inst :mi) ok)) " for " (:inst e) " " (pr-str (:mi e)))]))))
             (catch arbace.lang.ExceptionInfo ex
               (if-let [c (:print/unsupported (ex-data ex))] [l c (.getMessage ex)] [l :crash (str ex)]))
             (catch Throwable ex [l :crash (str ex)]))))))

(def ^:private obj-judged
  ;; AXS95 (a): the files whose objects object-check holds to llvm-mc's recorded ones, their mc-x86-obj rows passing
  ;; (test/asm/object-results-amd64.edn, beside the table: REPR_ASM_TABLE's checkout, else the working directory's)
  (delay
    (let [t (System/getenv "REPR_ASM_TABLE")
          f (or (System/getenv "REPR_ASM_OBJ_RESULTS")
                (if t (str (.getParentFile (.getParentFile (.getParentFile (.getAbsoluteFile (java.io.File. ^String t))))) "/test/asm/object-results-amd64.edn")
                    "test/asm/object-results-amd64.edn"))]
      (set (for [[id r] (read-string (slurp f)) :when (and (= r :pass) (.startsWith ^String id "mc-x86-obj/"))]
             (first (str/split (subs id (count "mc-x86-obj/")) #"@")))))))

(defn- other-tool-class
  "The class of another tool's CHECK text: :other-tool when object-check judges the file's object, else :object-unjudged."
  [^String path]
  (let [n (.getName (java.io.File. path))] (if (contains? @obj-judged (subs n 0 (max 0 (- (count n) 2)))) :other-tool :object-unjudged)))

(defn check-file
  "One file's row: {:stated N :met N :by {CLASS N} :errors [MET STATED] :fails [[LINE CLASS DETAIL] ...]}."
  [^String path flags]
  (let [src (asm/latin1 path)
        rs (runs src)
        all-enc (count (filter (fn [l] (and (re-find #"encoding: \[" l) (re-find #"[A-Za-z0-9_-]+(-NEXT|-SAME)?:.*encoding:" l)))
                               (str/split-lines src)))
        ;; the file read in a run's syntax (AT&T, or Intel's: -x86-asm-syntax=intel), once each
        read-of (memoize (fn [syn lx] (try {:items (asm/read-items src (merge {:arch :amd64 :syntax syn} lx))}
                                        (catch Throwable e {:refused (if (= :intel (:asm/refused (ex-data e))) :intel :unread)}))))
        cross (volatile! nil)
        starts (line-starts src)
        ;; each CHECK line once: the first run that names its prefix judges it
        seen (java.util.HashSet.)
        results (vec (for [r rs
                           :let [cs (vec (remove (fn [[l]] (.contains seen l)) (checks src (:prefixes r))))
                                 _ (doseq [[l] cs] (.add seen l))]
                           :when (seq cs)]
                       (let [read (read-of (if (:intel? r) :intel :att) (:lexer r))
                             txt-cs (when-not (:error? r)
                                      (vec (filter (fn [[_ k c]] (and (not (#{"-NOT" "-EMPTY"} k)) (not (re-find #"^-COUNT" k)) (text-part c))) cs)))
                             txt-as (fn [cls] (vec (for [[l] txt-cs] [l cls])))]
                       (cond
                         (= :intel (:refused read))
                         {:enc (vec (for [[l _ c] cs :when (enc-content c)] [l :intel])) :txt (txt-as :intel)}
                         (:refused read)
                         {:enc (vec (for [[l _ c] cs :when (enc-content c)] [l (:refused read)])) :txt (txt-as (:refused read))}
                         (nil? (:mode r))
                         {:enc (vec (for [[l _ c] cs :when (enc-content c)] [l :other-target])) :txt (txt-as :other-target)}
                         :else
                         (let [stmts (binding [p/*imm-hex* (:imm-hex? r) p/*intel* (:out-intel? r) x/*intel* (:intel? r)]
                                       (assemble-file (:items read) starts (:mode r)))]
                           ;; the cross-syntax judge on the first AT&T run that is no error test
                           (when (and (nil? @cross) (not (:intel? r)) (not (:error? r)) (not (:lfi? r)))
                             (vreset! cross (cross-judge stmts (:mode r) (:items read))))
                           {:enc (if (:encoding? r) (judge-encodings cs stmts) (vec (for [[l _ c] cs :when (enc-content c)] [l :not-shown])))
                            :txt (cond (:debug? r) (txt-as :debug-trace)
                                       (:other-tool? r) (txt-as (other-tool-class path))
                                       (:options? r) (txt-as :options)
                                       (:lfi? r) (txt-as :lfi)
                                       ;; the statements the run's --defsym selects
                                       (:defsym r) (judge-text txt-cs (binding [p/*imm-hex* (:imm-hex? r) p/*intel* (:out-intel? r) x/*intel* (:intel? r)]
                                                                        (assemble-file (:items read) starts (:mode r) (:defsym r)))
                                                               (:encoding? r))
                                       :else (judge-text txt-cs stmts (:encoding? r)))
                            :errors (when (:error? r) (judge-errors cs stmts))})))))
        enc (vec (mapcat :enc results))
        txt (vec (mapcat :txt results))
        tby (frequencies (map second txt))
        by (frequencies (map second enc))
        unjudged (- all-enc (count enc))]
    {:stated all-enc
     :met (get by :pass 0)
     :by (cond-> (dissoc by :pass) (pos? unjudged) (assoc :no-run unjudged))
     ;; the met encodings by the instruction's encoding (legacy, VEX, XOP)
     :fam (frequencies (for [[_ c sts] enc :when (= c :pass)]
                         (case (:enc (get (:insns x/*t*) (:inst (first sts)))) "EncVEX" :vex "EncXOP" :xop "EncEVEX" :evex :legacy)))
     :text {:stated (count txt) :met (get tby :pass 0) :by (dissoc tby :pass)}
     :cross (when-let [c @cross] (let [f (frequencies (map second c))] {:stated (count c) :met (get f :pass 0) :by (dissoc f :pass)}))
     :xfails (vec (for [[l c d] @cross :when (or (System/getenv "REPR_ASM_TEXT_ROWS") (#{:mismatch :rejected :crash :intel-unread} c))] [l c (str d)]))
     :tfails (vec (for [[l c o] txt :when (or (System/getenv "REPR_ASM_TEXT_ROWS") (#{:mismatch :rejected :crash :unpaired} c))] [l c (str o)]))
     :errors (let [es (keep :errors results)] (when (seq es) [(reduce + (map first es)) (reduce + (map second es))]))
     :fails (vec (for [[l c sts] enc :when (or (#{:mismatch :rejected :crash} c) (and (System/getenv "REPR_ASM_ENC_ROWS") (not= c :pass)))]
                   [l c (str/join " | " (map #(or (:text %) (:error %) (:what %)) sts))]))}))

(defn control
  "A negative control: the SUBJECT's statements judged against the REFERENCE's RUN and CHECK lines (the check's own
  judge): `differs` when a stated encoding is not met (as it must), else `same`."
  [^String subject ^String reference]
  (let [src (asm/latin1 reference)
        r (first (filter :encoding? (runs src)))
        items (asm/read-items (asm/latin1 subject) {:arch :amd64 :syntax (if (:intel? r) :intel :att)})
        starts (line-starts (asm/latin1 subject))
        stmts (binding [x/*intel* (:intel? r)] (assemble-file items starts (:mode r)))
        enc (judge-encodings (checks src (:prefixes r)) stmts)]
    (if (every? #(= :pass (second %)) enc) "same" "differs")))

(defn control-print
  "A negative control of the print level: the SUBJECT's statements printed (with immediates in hex when `hex`) and judged
  against the REFERENCE's CHECK texts by the level's own judge, in the mode of the reference's first AT&T run:
  `differs` when a CHECK text of an instruction goes unmet (as it must), else `same`."
  [^String subject ^String reference & [hex]]
  (let [src (asm/latin1 reference)
        ssrc (asm/latin1 subject)
        r (first (filter #(and (not (:error? %)) (:mode %)) (runs src)))
        stmts (binding [p/*imm-hex* (= hex "hex") p/*intel* (:out-intel? r) x/*intel* (:intel? r)]
                (assemble-file (asm/read-items ssrc {:arch :amd64 :syntax (if (:intel? r) :intel :att)}) (line-starts ssrc) (:mode r)))
        cs (vec (filter (fn [[_ k c]] (and (not (#{"-NOT" "-EMPTY"} k)) (text-part c))) (checks src (:prefixes r))))
        res (judge-text cs stmts (:encoding? r))]
    (if (some #{:mismatch :unpaired :rejected} (map second res)) "differs" "same")))

(defn control-cross
  "A negative control of the cross-syntax judge: the SUBJECT's AT&T statements printed in Intel and read back, held to the
  REFERENCE's machine instructions in order by the judge's own comparison: `differs` when one is not the same (as it must),
  else `same`."
  [^String subject ^String reference]
  (let [stmts-of (fn [^String path]
                   (let [src (asm/latin1 path)
                         r (first (filter #(and (not (:error? %)) (not (:intel? %)) (:mode %)) (runs src)))]
                     [(:mode r) (vec (for [[_ es] (assemble-file (asm/read-items src asm/amd64) (line-starts src) (:mode r)) e es :when (:inst e)] e))]))
        [mode ss] (stmts-of subject)
        [_ rs] (stmts-of reference)
        back (vec (for [e ss]
                    (let [txt (binding [p/*t* x/*t* p/*intel* true] (p/print-inst (:inst e) (:mi e) (or (:pflags e) #{}) (long (:mode e mode))))
                          o (last (filter :inst (mapcat #(binding [x/*intel* true] (x/assemble-insn % (long (:mode e mode)) {}))
                                                        (try (mapv first (asm/read-items txt {:arch :amd64 :syntax :intel})) (catch Throwable _ [])))))]
                      [(:inst o) (norm (:mi o))])))]
    (if (= back (mapv (fn [e] [(:inst e) (norm (:mi e))]) rs)) "same" "differs")))

(defn- check-list [lst work]
  (let [rows (vec (for [l (str/split-lines (slurp lst)) :when (seq l)] (str/split l #"\t")))
        threads (Integer/parseInt (or (System/getenv "REPR_ASM_THREADS") "4"))
        pool (Executors/newFixedThreadPool threads)
        t (x/table)
        futs (mapv (fn [[n p fl]] (.submit pool ^Callable (fn [] (binding [x/*t* t]
                                                                   [n (try (check-file p fl)
                                                                           (catch Throwable e {:stated 0 :met 0 :crash (str e)}))]))))
                   rows)
        res (mapv #(.get ^Future %) futs)]
    (.shutdown pool)
    (.mkdirs (java.io.File. ^String work))
    (spit (str work "/encode.tsv")
          (apply str (for [[n r] res]
                       (str n "\t" (:stated r) "\t" (:met r) "\t" (pr-str (into (sorted-map) (:by r))) "\t" (pr-str (:errors r))
                            "\t" (pr-str (into (sorted-map) (:fam r)))
                            "\t" (pr-str (some-> (:text r) (update :by #(into (sorted-map) %)) (->> (into (sorted-map)))))
                            "\t" (pr-str (some-> (:cross r) (update :by #(into (sorted-map) %)) (->> (into (sorted-map)))))
                            (when (:crash r) (str "\tcrash: " (str/replace (:crash r) #"[\t\n]" " "))) "\n"))))
    (spit (str work "/fails.tsv")
          (apply str (for [[n r] res [l c d] (:fails r)] (str n "\t" l "\t" (name c) "\t" d "\n"))))
    (spit (str work "/cross-fails.tsv")
          (apply str (for [[n r] res [l c d] (:xfails r)] (str n "\t" l "\t" (name c) "\t" (str/replace (str d) #"[\t\n]" " ") "\n"))))
    (spit (str work "/print-fails.tsv")
          (apply str (for [[n r] res [l c d] (:tfails r)] (str n "\t" l "\t" (name c) "\t" (str/replace (str d) #"[\t\n]" " ") "\n"))))
    (let [st (reduce + (map (comp :stated second) res)) met (reduce + (map (comp :met second) res))
          by (apply merge-with + (map (comp :by second) res))
          fam (apply merge-with + (map (comp :fam second) res))
          es (keep (comp :errors second) res)]
      (println (str "repr-asm encode-check: " met " of " st " stated encodings met " (pr-str (into (sorted-map) fam))
                    "; the rest " (pr-str (into (sorted-map) by))))
      (let [ts (keep (comp :text second) res)]
        (println (str "repr-asm encode-check: print level: " (reduce + (map :met ts)) " of " (reduce + (map :stated ts))
                      " CHECK texts met; the rest " (pr-str (into (sorted-map) (apply merge-with + (map :by ts)))))))
      (let [ts (keep (comp :cross second) res)]
        (println (str "repr-asm encode-check: cross-syntax: " (reduce + (map :met ts)) " of " (reduce + (map :stated ts))
                      " AT&T instructions read back from Intel; the rest " (pr-str (into (sorted-map) (apply merge-with + (map :by ts)))))))
      (println (str "repr-asm encode-check: error tests' error lines " (reduce + (map first es)) " of " (reduce + (map second es)) " met"))
      (when-let [cs (seq (filter (comp :crash second) res))]
        (println (str "repr-asm encode-check: " (count cs) " files crashed: " (str/join " " (map first cs))))))))

(defn -main
  "check LIST WORK: each NAME<tab>PATH<tab>FLAGS judged (WORK/encode.tsv: NAME STATED MET CLASSES ERRORS FAMILIES;
  WORK/fails.tsv); control SUBJECT REFERENCE."
  [verb & args]
  (case verb
    "check" (apply check-list args)
    "control" (println (apply control args))
    "control-print" (println (binding [x/*t* (x/table)] (apply control-print args)))
    "control-cross" (println (binding [x/*t* (x/table)] (apply control-cross args)))
    ;; print-list LIST OUT: for the oracle by hand (llvm-mc's output beside), each file's first AT&T run's printed
    ;; instructions into OUT/NAME.txt (a line each, <ERROR> or <CLASS> for one not printed) and its llvm-mc options into
    ;; OUT/NAME.run
    "print-list" (let [[lst out] args t (x/table)]
                   (doseq [l (str/split-lines (slurp lst)) :when (seq l)
                           :let [[n path] (str/split l #"\t") src (asm/latin1 path)
                                 r (first (filter #(and (not (:error? %)) (not (:intel? %)) (not (:out-intel? %)) (:mode %)
                                                        (not (:lfi? %)) (not (:options? %)))
                                                  (runs src)))
                                 items (when r (try (asm/read-items src asm/amd64) (catch Throwable _ nil)))]
                           :when items]
                     (binding [x/*t* t p/*imm-hex* (:imm-hex? r)]
                       (let [stmts (try (assemble-file items (line-starts src) (:mode r)) (catch Throwable _ nil))
                             trip (second (re-find #"-m?triple[= ]+(\S+)" (first (filter #(re-find #"llvm-mc" %) (run-lines src)))))]
                         (spit (str out "/" n ".txt")
                               (apply str (for [[_ es] stmts e es]
                                            (str (or (:asm e) (when (:error e) "<ERROR>") (str "<" (name (or (:unsupported e) (:punsup e) :none)) ">")) "\n"))))
                         (spit (str out "/" n ".run") (str (or trip "x86_64") (when (:imm-hex? r) " --print-imm-hex") "\t" path "\n"))))))
    ;; show FILE [MODE]: each statement's printed line and encoding (a debugging aid, beside llvm-mc by hand)
    "show" (let [[path mode syn out] args src (asm/latin1 path) intel? (= syn "intel")]
             (binding [x/*t* (x/table) x/*intel* intel? p/*intel* (= out "intel")]
               (doseq [[l es] (assemble-file (asm/read-items src {:arch :amd64 :syntax (if intel? :intel :att)}) (line-starts src) (Long/parseLong (or mode "64"))) e es]
                 (println (str l ": " (or (:asm e) (:punsup e)) "  # " (or (:text e) (:error e) (:unsupported e))))))))
  (shutdown-agents))

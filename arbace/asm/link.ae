          _ (when @got-off
              (doseq [[ref i] got]
                (put! (bufs (first @got-off)) (+ (long (second @got-off)) (* 8 (long i)))
                      (if (.contains tls-got ref) (tp-off (sym-va ref 0)) (sym-va ref 0)) 8)))
          ;; the relocations applied (X86_64::relocate)
          apply! (fn [^bytes b ^long at ^long p r ref decision]
                   (let [t (long (:type r)) a (long (:addend r)) tname (get elf/reloc-names t t)
                         chk32 (fn [^long v] (when-not (s32? v) (fail (str "relocation " tname " out of range: " v " is not in [-2147483648, 2147483647]"))) v)]
                     (case t
                       0 nil
                       1 (put! b at (target-va ref a) 8)
                       10 (let [v (target-va ref a)] (when-not (and (>= v 0) (<= v 0xffffffff)) (fail (str "relocation R_X86_64_32 out of range: " v))) (put! b at v 4))
                       11 (put! b at (chk32 (target-va ref a)) 4)
                       12 (let [v (target-va ref a)] (when-not (and (>= v -32768) (<= v 65535)) (fail (str "relocation R_X86_64_16 out of range: " v))) (put! b at v 2))
                       14 (let [v (target-va ref a)] (when-not (and (>= v -128) (<= v 255)) (fail (str "relocation R_X86_64_8 out of range: " v))) (put! b at v 1))
                       (2 4) (put! b at (chk32 (- (long (target-va ref a)) p)) 4)
                       24 (put! b at (- (long (target-va ref a)) p) 8)
                       13 (let [v (- (long (target-va ref a)) p)] (when-not (and (>= v -32768) (<= v 32767)) (fail (str "relocation R_X86_64_PC16 out of range: " v))) (put! b at v 2))
                       15 (let [v (- (long (target-va ref a)) p)] (when-not (and (>= v -128) (<= v 127)) (fail (str "relocation R_X86_64_PC8 out of range: " v))) (put! b at v 1))
                       (9 41 42)
                       (case decision
                         :got (put! b at (chk32 (- (+ (long (got-va ref)) a) p)) 4)
                         :relax (let [v (chk32 (- (long (target-va ref a)) p)) op (bit-and (long (aget b (- at 2))) 0xff) modrm (bit-and (long (aget b (- at 1))) 0xff)]
                                  (cond (= op 0x8b) (do (aset-byte b (- at 2) (unchecked-byte 0x8d)) (put! b at v 4))
                                        (= modrm 0x15) (do (aset-byte b (- at 2) (unchecked-byte 0x67)) (aset-byte b (- at 1) (unchecked-byte 0xe8)) (put! b at v 4))
                                        :else (do (aset-byte b (- at 2) (unchecked-byte 0xe9)) (aset-byte b (+ at 3) (unchecked-byte 0x90)) (put! b (- at 1) (inc v) 4))))
                         :relax-nopic (let [v (chk32 (+ (long (target-va ref a)) 4)) op (bit-and (long (aget b (- at 2))) 0xff)
                                            modrm (bit-and (long (aget b (- at 1))) 0xff) rex (bit-and (long (aget b (- at 3))) 0xff)]
                                        (if (= op 0x85)
                                          (do (aset-byte b (- at 1) (unchecked-byte (bit-or 0xc0 (bit-shift-right (bit-and modrm 0x38) 3))))
                                              (aset-byte b (- at 2) (unchecked-byte 0xf7)))
                                          (do (aset-byte b (- at 1) (unchecked-byte (bit-or 0xc0 (bit-shift-right (bit-and modrm 0x38) 3) (bit-and op 0x3c))))
                                              (aset-byte b (- at 2) (unchecked-byte 0x81))))
                                        (aset-byte b (- at 3) (unchecked-byte (bit-or (bit-and rex (bit-not 4)) (bit-shift-right (bit-and rex 4) 2))))
                                        (put! b at v 4)))
                       3 (put! b at (chk32 (- (+ (long (got-va ref)) a) (long (gotplt-va)))) 4)
                       27 (put! b at (- (+ (long (got-va ref)) a) (long (gotplt-va))) 8)
                       25 (put! b at (- (long (target-va ref a)) (long (gotplt-va))) 8)
                       31 (put! b at (- (long (target-va ref a)) (long (gotplt-va))) 8)
                       26 (put! b at (chk32 (- (+ (long (gotplt-va)) a) p)) 4)
                       29 (put! b at (- (+ (long (gotplt-va)) a) p) 8)
                       32 (put! b at (chk32 (+ (long (sym-size ref)) a)) 4)
                       33 (put! b at (+ (long (sym-size ref)) a) 8)
                       (23 21) (put! b at (chk32 (+ (long (tp-off (sym-va ref 0))) a)) 4)
                       (18 17) (put! b at (+ (long (tp-off (sym-va ref 0))) a) 8)
                       22 (let [v (chk32 (+ (long (tp-off (sym-va ref 0))) a)) i0 (bit-and (long (aget b (- at 3))) 0xff)
                                i1 (bit-and (long (aget b (- at 2))) 0xff) m (bit-and (long (aget b (- at 1))) 0xff) reg (bit-shift-right m 3)
                                set3 (fn [x y z] (aset-byte b (- at 3) (unchecked-byte x)) (aset-byte b (- at 2) (unchecked-byte y)) (aset-byte b (- at 1) (unchecked-byte z)))]
                            (cond (and (= i0 0x48) (= i1 0x03) (= m 0x25)) (set3 0x48 0x81 0xc4)
                                  (and (= i0 0x4c) (= i1 0x03) (= m 0x25)) (set3 0x49 0x81 0xc4)
                                  (and (= i0 0x4c) (= i1 0x03)) (set3 0x4d 0x8d (bit-or 0x80 (bit-shift-left reg 3) reg))
                                  (and (= i0 0x48) (= i1 0x03)) (set3 0x48 0x8d (bit-or 0x80 (bit-shift-left reg 3) reg))
                                  (and (= i0 0x4c) (= i1 0x8b)) (set3 0x49 0xc7 (bit-or 0xc0 reg))
                                  (and (= i0 0x48) (= i1 0x8b)) (set3 0x48 0xc7 (bit-or 0xc0 reg))
                                  :else (fail "R_X86_64_GOTTPOFF must be used in MOVQ or ADDQ instructions only"))
                            (put! b at (+ v 4) 4))
                       (unsupported :reloc (str "relocation " tname)))))
          ;; AArch64::relocate: the value into the instruction's field, with lld's range and alignment checks
          a64-apply! (fn [^bytes b ^long at ^long p r ref _decision]
                       (let [t (long (:type r)) a (long (:addend r)) tname (get @a64-reloc-names t t)
                             range! (fn [^long v ^long lo ^long hi] (when-not (<= lo v hi) (fail (str "relocation " tname " out of range: " v " is not in [" lo ", " hi "]"))) v)
                             align! (fn [^long v ^long n] (when-not (zero? (mod v n)) (fail (str "improper alignment for relocation " tname ": 0x" (Long/toHexString v) " is not aligned to " n " bytes"))) v)
                             set-w! (fn [^long mask ^long bits] (put! b at (bit-or (bit-and (u32 b at) (bit-not mask)) (bit-and bits mask)) 4))
                             imm19! (fn [^long v] (set-w! 0xffffe0 (bit-shift-left (bit-and (bit-shift-right v 2) 0x7ffff) 5)))
                             adr! (fn [^long v] (set-w! 0x60ffffe0 (bit-or (bit-shift-left (bit-and v 3) 29) (bit-shift-left (bit-and (bit-shift-right v 2) 0x7ffff) 5))))
                             page (fn [^long x] (bit-and x (bit-not 0xfff)))
                             s+a (fn [] (long (target-va ref a)))
                             imm12! (fn [^long v] (set-w! 0x3ffc00 (bit-shift-left (bit-and v 0xfff) 10)))
                             ldst! (fn [^long v ^long sh] (set-w! 0x3ffc00 (bit-shift-left (bit-shift-right (bit-and v 0xfff) sh) 10)))
                             movw! (fn [^long v ^long g] (set-w! 0x1fffe0 (bit-shift-left (bit-and (bit-shift-right v (* 16 g)) 0xffff) 5)))
                             tp (fn [] (+ (long (tp-off (sym-va ref 0))) a))]
                         (case t
                           0 nil
                           0x101 (put! b at (s+a) 8)
                           0x102 (put! b at (range! (s+a) -2147483648 4294967295) 4)
                           0x103 (put! b at (range! (s+a) -32768 65535) 2)
                           0x104 (put! b at (- (s+a) p) 8)
                           0x105 (put! b at (range! (- (s+a) p) -2147483648 4294967295) 4)
                           0x106 (put! b at (range! (- (s+a) p) -32768 65535) 2)
                           (0x11a 0x11b) (set-w! 0x3ffffff (bit-shift-right (align! (range! (- (s+a) p) -134217728 134217727) 4) 2))
                           (0x111 0x118) (imm19! (align! (range! (- (s+a) p) -1048576 1048575) 4))
                           0x117 (set-w! 0x7ffe0 (bit-shift-left (bit-and (bit-shift-right (align! (range! (- (s+a) p) -32768 32767) 4) 2) 0x3fff) 5))
                           0x112 (adr! (range! (- (s+a) p) -1048576 1048575))
                           (0x113 0x114) (adr! (bit-shift-right (cond-> (- (page (s+a)) (page p)) (= t 0x113) (range! -4294967296 4294967295)) 12))
                           0x115 (imm12! (s+a))
                           0x116 (ldst! (s+a) 0) 0x11c (ldst! (align! (s+a) 2) 1) 0x11d (ldst! (align! (s+a) 4) 2)
                           0x11e (ldst! (align! (s+a) 8) 3) 0x12b (ldst! (align! (s+a) 16) 4)
                           (0x107 0x108) (movw! (s+a) 0) (0x109 0x10a) (movw! (s+a) 1) (0x10b 0x10c) (movw! (s+a) 2) 0x10d (movw! (s+a) 3)
                           ;; the GOT's: the entry's address
                           (0x137 0x21d) (adr! (bit-shift-right (range! (- (page (+ (long (got-va ref)) a)) (page p)) -4294967296 4294967295) 12))
                           (0x138 0x21e) (ldst! (align! (+ (long (got-va ref)) a) 8) 3)
                           (0x135 0x21f) (imm19! (align! (range! (- (+ (long (got-va ref)) a) p) -1048576 1048575) 4))
                           ;; local exec
                           0x225 (imm12! (bit-shift-right (range! (tp) 0 0xffffff) 12))
                           0x226 (imm12! (range! (tp) 0 4095))
                           0x227 (imm12! (tp))
                           (0x220) (movw! (tp) 2) (0x221 0x222) (movw! (tp) 1) (0x223 0x224) (movw! (tp) 0)
                           (0x228 0x229) (ldst! (tp) 0) (0x22a 0x22b) (ldst! (tp) 1) (0x22c 0x22d) (ldst! (tp) 2) (0x22e 0x22f) (ldst! (tp) 3)
                           (0x23a 0x23b) (ldst! (tp) 4)
                           (unsupported :reloc (str "relocation " tname)))))
          _ (doseq [f files [i rs] (:relocs f) :when (live? (:idx f) i)
                    :let [fi (:idx f) s (sec-of files fi i)]
                    :when (and (not (zero? (bit-and (long (:flags s)) elf/SHF_ALLOC))) (not= elf/SHT_NOBITS (:type s)))
                    [ri r] (map-indexed vector rs)]
              (let [ref (symref fi (:sym r))
                    ;; a reference to a symbol of a discarded section (InputFiles' discarded-section rule)
                    _ (when (and (= :local (first ref)) (pos? (long (:sym r))))
                        (let [ls (nth (:symbols (:o f)) (:sym r)) sh (long (:shndx ls))]
                          (when (and (pos? sh) (< sh 0xff00) (not (live? fi sh)))
                            (fail (str "relocation refers to a discarded section: " (:name (sec-of files fi sh)))))))
                    eh? (= ".eh_frame" (:name s))]
                (if eh?
                  (let [recs (eh-records (:data s))
                        rec (first (filter (fn [[at size]] (and (>= (long (:offset r)) (long at)) (< (long (:offset r)) (+ (long at) (long size))))) recs))
                        out (when rec (.get ^java.util.HashMap (:offs eh) [fi i (first rec)]))]
                    (when out
                      (let [at (+ (long (second @eh-off)) (long out) (- (long (:offset r)) (long (first rec))))]
                        ((if aarch64? a64-apply! apply!) (bufs (first @eh-off)) at (+ (long (.get addr (first @eh-off))) at) r ref nil))))
                  (let [[n p] (.get place [fi i])
                        at (+ (long p) (long (:offset r)))]
                    ((if aarch64? a64-apply! apply!) (bufs n) at (+ (long (.get addr n)) at) r ref (.get decisions [fi i ri]))))))
          ;; the symbol table (demoteAndCopyLocalSymbols, finalizeSections, sortSymTabSymbols)
          shidx (into {} (map-indexed (fn [i o] [(:name o) (inc (long i))]) order))
          out-shndx (fn [fi shndx] (let [[n] (.get place [fi shndx])] (long (shidx n))))
          local-entries (vec (for [f files [i s] (map-indexed vector (:symbols (:o f)))
                                   :when (and (pos? (long i)) (= elf/STB_LOCAL (:bind s)) (not= elf/STT_SECTION (:type s)))
                                   :let [sh (long (:shndx s)) fi (:idx f)]
                                   :when (or (= sh elf/SHN_ABS) (zero? sh) (and (< sh 0xff00) (live? fi sh)))
                                   :when (not (and (.startsWith ^String (:name s) ".L") (< 0 sh 0xff00)
                                                   (not (zero? (bit-and (long (:flags (sec-of files fi sh))) SHF_MERGE)))))]
                               {:file fi :name (:name s) :bind elf/STB_LOCAL :type (:type s) :other (:other s)
                                :shndx (cond (= sh elf/SHN_ABS) elf/SHN_ABS (zero? sh) 0 :else (out-shndx fi sh))
                                :value (cond (= sh elf/SHN_ABS) (:value s) (zero? sh) 0 :else (sym-va [:local fi i] 0)) :size (:size s)}))
          internal (count files)
          global-entries (vec (for [[n g] table
                                    :let [st (:state g) s (:sym g) v (long (:vis g))
                                          madev (.get made n)]
                                    :when (or (not= :undef st) true)]
                                (let [hidden (or (= v STV_HIDDEN) (= v STV_INTERNAL) (some? madev))
                                      [shndx value file]
                                      (cond (some? madev) [(or (some (fn [o] (when (and (alloc? o) (<= (long (.get addr (:name o))) (long madev))
                                                                                      (<= (long madev) (+ (long (.get addr (:name o))) (long (:size o)))))
                                                                             (long (shidx (:name o)))))
                                                                  (reverse order))
                                                            elf/SHN_ABS)
                                                        madev internal]
                                            (= st :defined) (let [sh (long (:shndx s))]
                                                              (if (= sh elf/SHN_ABS) [elf/SHN_ABS (:value s) (:file g)]
                                                                  [(out-shndx (:file g) sh) (sym-va [:global n] 0) (:file g)]))
                                            (= st :common) [(long (shidx (first (.get commons n)))) (sym-va [:global n] 0) (:file g)]
                                            :else [0 0 (:file g)])]
                                  {:file file :name n
                                   :bind (cond hidden elf/STB_LOCAL (and (= st :undef) (some? madev)) elf/STB_GLOBAL (:weak g) elf/STB_WEAK :else elf/STB_GLOBAL)
                                   :type (if (some? madev) elf/STT_NOTYPE (if (= st :common) elf/STT_OBJECT (:type s)))
                                   :other (if (some? madev) STV_HIDDEN v)
                                   :shndx shndx :value value :size (if (some? madev) 0 (or (:size g) 0))})))
          all (concat local-entries global-entries)
          locals (let [ls (filter #(= elf/STB_LOCAL (:bind %)) all) groups (java.util.LinkedHashMap.)]
                   (doseq [s ls] (.put groups (:file s) (conj (vec (.get groups (:file s))) s)))
                   (apply concat (vals groups)))
          globals (remove #(= elf/STB_LOCAL (:bind %)) global-entries)
          symtab (vec (concat locals globals))
          ;; the string tables: .strtab in the symbols' order of addition, .shstrtab deduplicated
          strtab-o (java.io.ByteArrayOutputStream.)
          _ (.write strtab-o 0)
          str-off (java.util.HashMap.)
          _ (doseq [s all] (let [p (.size strtab-o) b (.getBytes ^String (:name s) "ISO-8859-1")]
                             (.put str-off s p) (.write strtab-o b 0 (alength b)) (.write strtab-o 0)))
          names (concat (map :name order) [".symtab" ".shstrtab" ".strtab"])
          shstr-o (java.io.ByteArrayOutputStream.)
          _ (.write shstr-o 0)
          shstr-off (java.util.HashMap.)
          _ (doseq [n names :when (not (.containsKey shstr-off n))]
              (let [b (.getBytes ^String n "ISO-8859-1")] (.put shstr-off n (.size shstr-o)) (.write shstr-o b 0 (alength b)) (.write shstr-o 0)))
          symtab-bytes (let [b (byte-array (* 24 (inc (count symtab))))]
                         (doseq [[i s] (map-indexed vector symtab)]
                           (let [h (* 24 (inc (long i)))]
                             (put! b h (long (.get str-off s)) 4)
                             (aset-byte b (+ h 4) (unchecked-byte (bit-or (bit-shift-left (long (:bind s)) 4) (long (:type s)))))
                             (aset-byte b (+ h 5) (unchecked-byte (bit-and (long (or (:other s) 0)) 3)))
                             (put! b (+ h 6) (long (:shndx s)) 2) (put! b (+ h 8) (long (:value s)) 8) (put! b (+ h 16) (long (:size s)) 8)))
                         b)
          strtab-bytes (.toByteArray strtab-o)
          shstr-bytes (.toByteArray shstr-o)
          symtab-off (align-up end-off 8)
          shstr-off* (+ symtab-off (alength symtab-bytes))
          strtab-off (+ shstr-off* (alength shstr-bytes))
          shoff (align-up (+ strtab-off (alength strtab-bytes)) 8)
          nsec (+ 1 (count order) 3)
          out (byte-array (+ shoff (* 64 nsec)))
          ;; the program headers' values (setPhdrs)
          seg (fn [type flags secs align]
                (let [os (map by-name secs) f (first os) z (last os)
                      off (long (.get offset (:name f))) a (long (.get addr (:name f)))]
                  [type flags off a (- (+ (long (.get offset (:name z))) (if (= elf/SHT_NOBITS (:type z)) 0 (long (:size z)))) off)
                   (- (+ (long (.get addr (:name z))) (long (:size z))) a) align]))
          phdrs (vec (concat
                      [[PT_PHDR PF_R 64 (+ image-base 64) (* 56 nphdr) (* 56 nphdr) 8]]
                      (for [l loads]
                        (let [ss (filter string? (:secs l))]
                          (if (keyword? (first (:secs l)))
                            (let [z (when (seq ss) (by-name (last ss)))
                                  fend (if z (+ (long (.get offset (:name z))) (if (= elf/SHT_NOBITS (:type z)) 0 (long (:size z)))) hdr-size)
                                  mend (if z (+ (long (.get addr (:name z))) (long (:size z))) (+ image-base hdr-size))]
                              [PT_LOAD (:flags l) 0 image-base fend (- mend image-base) max-page])
                            (seg PT_LOAD (:flags l) ss max-page))))
                      (when (seq tls-secs) [(seg PT_TLS PF_R tls-secs tls-align)])
                      (when (seq relro-secs) [(seg PT_GNU_RELRO PF_R relro-secs 1)])
                      [[PT_GNU_STACK (bit-or PF_R PF_W) 0 0 0 0 0]]))
          entry-va (let [g (gsym entry)]
                     (if (and g (= :defined (:state g))) (sym-va [:global entry] 0)
                         (do (binding [*out* *err*] (println (str "repr-asm link: warning: cannot find entry symbol " entry "; not setting start address"))) 0)))]
      ;; the ELF header (writeEhdr, writeHeader)
      (System/arraycopy (byte-array [0x7f 0x45 0x4c 0x46 2 1 1 0]) 0 out 0 8)
      (put! out 16 2 2) (put! out 18 (:machine *arch*) 2) (put! out 20 1 4) (put! out 24 entry-va 8) (put! out 32 64 8) (put! out 40 shoff 8)
      (put! out 48 0 4) (put! out 52 64 2) (put! out 54 56 2) (put! out 56 (count phdrs) 2) (put! out 58 64 2) (put! out 60 nsec 2)
      (put! out 62 (+ (count order) 2) 2)
      (doseq [[i [type fl off va fs ms al]] (map-indexed vector phdrs)]
        (let [h (+ 64 (* 56 (long i)))]
          (put! out h type 4) (put! out (+ h 4) fl 4) (put! out (+ h 8) off 8) (put! out (+ h 16) va 8) (put! out (+ h 24) va 8)
          (put! out (+ h 32) fs 8) (put! out (+ h 40) ms 8) (put! out (+ h 48) al 8)))
      (doseq [o order :when (not= elf/SHT_NOBITS (:type o))]
        (let [^bytes b (bufs (:name o))] (System/arraycopy b 0 out (int (.get offset (:name o))) (alength b))))
      (System/arraycopy symtab-bytes 0 out (int symtab-off) (alength symtab-bytes))
      (System/arraycopy shstr-bytes 0 out (int shstr-off*) (alength shstr-bytes))
      (System/arraycopy strtab-bytes 0 out (int strtab-off) (alength strtab-bytes))
      (let [shdr! (fn [^long i nm type fl a off size link info al es]
                    (let [h (+ shoff (* 64 i))]
                      (put! out h nm 4) (put! out (+ h 4) type 4) (put! out (+ h 8) fl 8) (put! out (+ h 16) a 8) (put! out (+ h 24) off 8)
                      (put! out (+ h 32) size 8) (put! out (+ h 40) link 4) (put! out (+ h 44) info 4) (put! out (+ h 48) al 8) (put! out (+ h 56) es 8)))
            k (count order)]
        (doseq [[i o] (map-indexed vector order)]
          (shdr! (inc (long i)) (.get shstr-off (:name o)) (:type o) (:flags o) (.get addr (:name o)) (.get offset (:name o)) (:size o)
                 0 0 (:align o) (:entsize o)))
        (shdr! (+ k 1) (.get shstr-off ".symtab") elf/SHT_SYMTAB 0 0 symtab-off (alength symtab-bytes) (+ k 3) (inc (count locals)) 8 24)
        (shdr! (+ k 2) (.get shstr-off ".shstrtab") elf/SHT_STRTAB 0 0 shstr-off* (alength shstr-bytes) 0 0 1 0)
        (shdr! (+ k 3) (.get shstr-off ".strtab") elf/SHT_STRTAB 0 0 strtab-off (alength strtab-bytes) 0 0 1 0))
      {:bytes out})
    (catch arbace.lang.ExceptionInfo ex
      (let [d (ex-data ex)]
        (cond (:link/unsupported d) {:unsupported (:link/unsupported d) :what (.getMessage ex)}
              (:link/error d) {:error (:link/error d)}
              :else (throw ex))))))

(defn link-files
  "The executable of the object files at `paths`."
  [paths & [opts]]
  (link (vec (for [p paths] [p (java.nio.file.Files/readAllBytes (.toPath (java.io.File. ^String p)))])) opts))

;; ---------------------------------------------------------------------------------------------------------------------
;; the run check (bin/repr-asm run-check): each test's sources assembled (arbace.asm.amd64.obj), linked, run by the CPU (the
;; script, under a timeout) and judged by the verdict its header states

(defn- write-bytes [^String path ^bytes b]
  (java.nio.file.Files/write (.toPath (java.io.File. path)) b ^"[Ljava.nio.file.OpenOption;" (make-array java.nio.file.OpenOption 0)))

(defn verdict
  "A test's own verdict from its header lines: `# exit: N`, `# stdout: \"...\"` (a string as the reader reads it, the lines
  joined), `# with: FILE...` (the other sources linked after it: relative to the test's directory, or `musl:PATH` in musl
  1.2.6's tree), `# before: FILE...` (linked before it, as crti is), `# link-error: TEXT` (the link must fail with an error
  that holds TEXT, lld's words). {:exit N :stdout S :with [...] :before [...] :link-error TEXT}."
  [^String text]
  (reduce (fn [m l]
            (if-let [[_ k v] (re-matches #"#\s*(exit|stdout|with|before|link-error):\s*(.*)" l)]
              (case k
                "exit" (assoc m :exit (Long/parseLong (str/trim v)))
                "stdout" (update m :stdout str (read-string v))
                "with" (update m :with into (remove empty? (str/split (str/trim v) #"\s+")))
                "link-error" (assoc m :link-error (str/trim v))
                "before" (update m :before into (remove empty? (str/split (str/trim v) #"\s+"))))
              m))
          {:exit 0 :stdout "" :with [] :before []}
          (take-while #(str/starts-with? % "#") (str/split-lines text))))

(defn- hexs ^String [^bytes b] (apply str (map #(format "%02x" (bit-and (long %) 0xff)) b)))

(defn build-tests
  "Each NAME<tab>PATH of LIST: its sources assembled and linked into WORK/NAME; WORK/build.tsv: NAME RESULT DETAIL (built,
  else the class of what failed), WORK/want.tsv: NAME EXIT STDOUT-HEX."
  [lst work musl & [arch]]
  (let [assemble (requiring-resolve (if (= arch "arm64") 'arbace.asm.arm64.obj/assemble-file 'arbace.asm.amd64.obj/assemble-file))
        rows (for [l (str/split-lines (slurp lst)) :when (seq l)] (str/split l #"\t"))
        res (vec (for [[n p] rows]
                   (let [v (verdict (slurp p))
                         dir (.getParent (java.io.File. ^String p))
                         src (fn [w] (if (str/starts-with? w "musl:") (str musl "/" (subs w 5)) (str dir "/" w)))
                         srcs (concat (map src (:before v)) [p] (map src (:with v)))
                         objs (reduce (fn [acc s]
                                        (if (map? acc) acc
                                            (let [r (try (assemble s) (catch Throwable e {:unsupported :crash :what (str e)}))]
                                              (cond (:bytes r) (conj acc [s (:bytes r)])
                                                    (:error r) {:class :assemble-error :what (str s ": " (:error r))}
                                                    :else {:class (keyword (str "assemble-" (name (:unsupported r)))) :what (str s ": " (:what r))}))))
                                      [] srcs)
                         r (if (map? objs) objs
                               (let [l (try (link objs) (catch Throwable e {:unsupported :crash :what (str e)}))]
                                 (cond (and (:link-error v) (:error l) (str/includes? (:error l) (:link-error v))) {:class :pass :what (str "refused: " (:error l))}
                                       (and (:link-error v) (:bytes l)) {:class :link-accepted :what (str "linked, stated: " (:link-error v))}
                                       (:bytes l) (do (write-bytes (str work "/" n) (:bytes l)) {:class :built :what ""})
                                       (:error l) {:class :link-error :what (:error l)}
                                       :else {:class (keyword (str "link-" (name (:unsupported l)))) :what (:what l)})))]
                     [n (:class r) (:what r) v])))]
    (spit (str work "/build.tsv") (apply str (for [[n c d] res] (str n "\t" (name c) "\t" (str/replace (str d) #"[\t\n]" " ") "\n"))))
    (spit (str work "/want.tsv") (apply str (for [[n _ _ v] res] (str n "\t" (:exit v) "\t" (hexs (.getBytes ^String (:stdout v) "ISO-8859-1")) "\n"))))
    (println (str "repr-asm run-check: " (count (filter #(= :built (second %)) res)) " of " (count res) " tests assembled and linked"))))

(defn- read-tsv [path] (into {} (for [l (str/split-lines (slurp path)) :when (seq l) :let [[n & r] (str/split l #"\t" -1)]] [n (vec r)])))

(defn- judge-one
  "A run (STATUS, stdout's bytes as hex) against a verdict (EXIT, STDOUT-HEX): [RESULT DETAIL]."
  [status out [want-exit want-out]]
  (cond (= status "124") [:timeout "killed after the time limit"]
        (not= status want-exit) [:exit (str "exit " status ", stated " want-exit)]
        (not= out want-out) [:stdout (str "stdout " (subs out 0 (min 64 (count out))) ", stated " (subs want-out 0 (min 64 (count want-out))))]
        :else [:pass ""]))

(defn- run-of [work n]
  (let [st (str work "/" n ".status") o (java.io.File. (str work "/" n ".out"))]
    (when (.exists (java.io.File. st))
      [(str/trim (slurp st)) (hexs (java.nio.file.Files/readAllBytes (.toPath o)))])))

(defn verdicts
  "WORK/run.tsv: each test's row (NAME RESULT DETAIL), its run (WORK/NAME.status, WORK/NAME.out) judged by its verdict."
  [work]
  (let [built (read-tsv (str work "/build.tsv")) want (read-tsv (str work "/want.tsv"))
        rows (for [[n [c d]] (sort-by key built)]
               (if (not= c "built") [n c (str/replace d "\t" " ")]
                   (let [[st out] (run-of work n)] (into [n] (map str (update (judge-one st out (want n)) 0 name))))))]
    (spit (str work "/run.tsv") (apply str (for [[n c d] rows] (str n "\t" c "\t" d "\n"))))))

(defn control
  "A negative control: SUBJECT's run judged by REFERENCE's verdict: `differs` as it must, else `same`; `left` (a failing control)
  when the subject did not run or the reference has no verdict, so a broken or misspelled control never passes vacuously."
  [work subj ref]
  (let [want (read-tsv (str work "/want.tsv")) [st out] (run-of work subj)]
    (cond (or (nil? st) (nil? (want ref))) "left"
          (= :pass (first (judge-one st out (want ref)))) "same"
          :else "differs")))

;; ---------------------------------------------------------------------------------------------------------------------
;; the canonical view (the oracle's comparison, by hand) and the dump

(defn canonical
  "An executable read back as the comparison sees it, addresses made relative: the entry as SECTION+OFFSET; the segments
  [TYPE FLAGS [SECTION...]]; the allocated sections [NAME TYPE FLAGS SIZE]; the symbols but the null and the STT_FILE ones,
  sorted, [NAME BIND TYPE SECTION OFFSET SIZE] (OFFSET within the section, or the value of an absolute or a TLS symbol: its
  offset in the TLS segment)."
  [^bytes b]
  (let [o (elf/read-object b)
        u (fn [^long at ^long n] (loop [i (dec n) v 0] (if (neg? i) v (recur (dec i) (bit-or (bit-shift-left v 8) (bit-and (long (aget b (+ at i))) 0xff))))))
        secs (:sections o)
        sec-addr (fn [s] (u (+ (u 40 8) (* 64 (long (:index s))) 16) 8))
        alloc (filter #(not (zero? (bit-and (long (:flags %)) elf/SHF_ALLOC))) secs)
        where (fn [^long va] (if-let [s (last (filter #(and (<= (long (sec-addr %)) va) (< va (+ (long (sec-addr %)) (max 1 (long (:size %)))))) alloc))]
                               [(:name s) (- va (long (sec-addr s)))] ["?" va]))
        phoff (u 32 8) phnum (u 56 2)
        ptname {1 "LOAD" 6 "PHDR" 7 "TLS" 0x6474e551 "GNU_STACK" 0x6474e552 "GNU_RELRO" 0x6474e550 "GNU_EH_FRAME" 0x6474e553 "GNU_PROPERTY" 4 "NOTE"}]
    {:entry (where (u 24 8))
     :segments (vec (for [i (range phnum) :let [h (+ phoff (* 56 (long i))) t (u h 4) va (u (+ h 16) 8) ms (u (+ h 40) 8)]]
                      [(get ptname t t) (u (+ h 4) 4)
                       (vec (for [s alloc :let [a (long (sec-addr s))] :when (and (pos? ms) (<= va a) (< a (+ va ms))
                                                                                  ;; PT_TLS holds the TLS sections, the others no .tbss
                                                                                  (let [tls (not (zero? (bit-and (long (:flags s)) elf/SHF_TLS)))]
                                                                                    (if (= t 7) tls (not (and tls (= (:type s) elf/SHT_NOBITS))))))]
                              (:name s)))]))
     :sections (vec (for [s alloc] [(:name s) (:type s) (:flags s) (:size s)]))
     :symbols (vec (sort (for [s (rest (:symbols o)) :when (not= elf/STT_FILE (:type s))]
                           (let [sh (long (:shndx s))]
                             (if (or (= sh elf/SHN_ABS) (zero? sh) (= (:type s) elf/STT_TLS))
                               [(:name s) (:bind s) (:type s) (cond (zero? sh) "*UND*" (= sh elf/SHN_ABS) "*ABS*" :else (:name (nth secs sh))) (:value s) (:size s)]
                               (let [sec (nth secs sh) off (- (long (:value s)) (long (sec-addr sec)))]
                                 [(:name s) (:bind s) (:type s) (:name sec) off (:size s)]))))))}))

(defn- slurp-bytes ^bytes [^String p] (java.nio.file.Files/readAllBytes (.toPath (java.io.File. p))))

(defn compare-exes
  "Arbace's executable against the oracle's, at the canonical level: each part's differences printed."
  [ours theirs]
  (let [a (canonical (slurp-bytes ours)) b (canonical (slurp-bytes theirs))]
    (doseq [k [:entry :segments :sections]]
      (when (not= (k a) (k b)) (println (str "  " (name k) ": ours " (pr-str (k a)) "\n  " (name k) ": theirs " (pr-str (k b))))))
    (let [sa (set (:symbols a)) sb (set (:symbols b))]
      (doseq [s (sort (remove sb sa))] (println (str "  symbol only ours: " (pr-str s))))
      (doseq [s (sort (remove sa sb))] (println (str "  symbol only theirs: " (pr-str s)))))))

(defn oracle-objects
  "Each test's sources assembled into OUT/NAME-K.o for the oracle's linker; OUT/objects.tsv: NAME OBJ...."
  [lst out musl]
  (let [assemble (requiring-resolve 'arbace.asm.amd64.obj/assemble-file)
        rows (for [l (str/split-lines (slurp lst)) :when (seq l)] (str/split l #"\t"))]
    (spit (str out "/objects.tsv")
          (apply str (for [[n p] rows]
                       (let [v (verdict (slurp p)) dir (.getParent (java.io.File. ^String p))
                             src (fn [w] (if (str/starts-with? w "musl:") (str musl "/" (subs w 5)) (str dir "/" w)))
                             srcs (concat (map src (:before v)) [p] (map src (:with v)))
                             objs (for [[k s] (map-indexed vector srcs) :let [r (assemble s) o (str out "/" n "-" k ".o")]
                                        :when (:bytes r)]
                                    (do (write-bytes o (:bytes r)) o))]
                         (str n "\t" (str/join " " objs) "\n")))))))

(defn -main
  "link OUT OBJ...: the executable written (exit 1 with the class); build LIST WORK MUSL; verdicts WORK; control WORK SUBJECT
  REFERENCE."
  [verb & args]
  (case verb
    "link" (let [[out & objs] args
                 [objs arch] (if (= "--arm64" (first objs)) [(rest objs) aarch64] [objs *arch*])
                 r (binding [*arch* arch] (link-files objs))]
             (if-let [bs (:bytes r)]
               (write-bytes out bs)
               (do (binding [*out* *err*] (println (str "repr-asm link: " (if (:error r) (str "error: " (:error r)) (str (name (:unsupported r)) ": " (:what r))))))
                   (System/exit 1))))
    "build" (let [[lst work musl arch] args] (binding [*arch* (if (= arch "arm64") aarch64 *arch*)] (build-tests lst work musl arch)))
    "verdicts" (apply verdicts args)
    "control" (println (apply control args))
    "compare" (apply compare-exes args)
    "oracle-objects" (apply oracle-objects args)
    "dump" (let [c (canonical (slurp-bytes (first args)))]
             (println "entry" (pr-str (:entry c)))
             (doseq [k [:segments :sections :symbols] r (k c)] (println (name k) (pr-str r)))))
  (shutdown-agents))

(ns arbace.asm.link
  "Arbace's static linker for x86-64 ELF (doc/asm/AMD64-SURVEY.md §7.3, AX4's second slice; doc/asm/AMD64.md §8): ELF64
  relocatable objects (Arbace's own, arbace.asm.amd64.obj's) linked into a static executable (ET_EXEC) for x86-64 Linux as
  lld lays one out with no linker script, written again in Arbace from llvm-project 23.1.5's lld/ELF (Driver, InputFiles'
  initializeSymbols and the COMDAT rule, SymbolTable and Symbol::resolve, LinkerScript::getOutputSectionName and
  assignAddresses, Writer's getSectionRank, createPhdrs, fixSectionAlignments, assignFileOffsets and setPhdrs, the synthetic
  .eh_frame, .got, .got.plt and .relro_padding, MergeInputSection's pieces, Arch/X86_64's relocate, adjustGotPcExpr, relaxGot
  and relaxTlsIeToLe), Apache-2.0 WITH LLVM-exception; no code copied.

  What it does, in lld's order: the objects read (arbace.asm.elf); COMDAT groups kept by their first signature, the later
  members discarded; the global symbols resolved (defined over common over undefined, strong over weak, two strong
  definitions an error), commons allocated into .bss; the sections named into output sections (.text.*, .data.*,
  .rodata.*, .bss.*, ... by prefix), the mergeable ones split into pieces and deduplicated, .eh_frame's CIEs deduplicated
  and its dead FDEs dropped; the relocations scanned (GOTPCRELX relaxed as lld relaxes it, a .got entry for the rest); the
  output sections sorted by lld's rank, the program headers made (PT_PHDR, the PT_LOADs by permission, PT_TLS,
  PT_GNU_RELRO, PT_GNU_STACK), the addresses assigned from 0x200000 (a segment's first section on the next page at the
  same page offset), the file offsets made congruent, the relocations applied, the symbol table written (the locals by file,
  hidden globals made local), the entry `_start`.

  Not yet (each its class): archives, shared objects and dynamic linking (AXS11), TLS GD/LD/TLSDESC (relaxed to LE by lld),
  relocations inside mergeable sections, --gc-sections, ICF, linker scripts, static PIE."
  (:require [arbace.asm.elf :as elf]
            [arbace.string :as str]))

(set! *warn-on-reflection* true)

(def SHT_NOTE 7) (def SHT_REL 9) (def SHT_INIT_ARRAY 14) (def SHT_FINI_ARRAY 15) (def SHT_PREINIT_ARRAY 16)
(def SHF_MERGE 0x10) (def SHF_STRINGS 0x20) (def SHF_LINK_ORDER 0x80) (def SHF_EXCLUDE 0x80000000)
(def STV_DEFAULT 0) (def STV_INTERNAL 1) (def STV_HIDDEN 2) (def STV_PROTECTED 3)
(def PT_LOAD 1) (def PT_PHDR 6) (def PT_TLS 7) (def PT_GNU_STACK 0x6474e551) (def PT_GNU_RELRO 0x6474e552)
(def PF_X 1) (def PF_W 2) (def PF_R 4)

(def ^:dynamic *arch*
  "The target (lld's TargetInfo): :machine, :name, :image-base (defaultImageBase), :max-page (defaultMaxPageSize), :common-page,
  :trap (the fill of a code section's gaps, trapInstr). x86-64's by default; AArch64's (AR4) `aarch64`."
  {:machine 62 :name "x86-64" :image-base 0x200000 :max-page 4096 :common-page 4096 :trap 0xcc})

(def aarch64
  "AArch64's TargetInfo (lld/ELF/Arch/AArch64.cpp): defaultImageBase 0x200000 (a 2 MiB superpage), defaultMaxPageSize 64 KiB,
  trapInstr 0xd4d4d4d4."
  {:machine 183 :name "AArch64" :image-base 0x200000 :max-page 65536 :common-page 4096 :trap 0xd4})
(def link-comment "the linker's line in .comment (lld's is its version)" "Linker: Arbace (arbace.asm.link)")

(def ^:private a64-reloc-names (delay @(requiring-resolve 'arbace.asm.arm64.obj/reloc-names)))
(defn- fail [msg] (throw (ex-info (str msg) {:link/error (str msg)})))
(defn- unsupported [cls what] (throw (ex-info (str what) {:link/unsupported cls})))

(defn- align-up ^long [^long x ^long a] (if (<= a 1) x (* a (quot (+ x (dec a)) a))))
(defn- u32 ^long [^bytes b ^long at]
  (bit-or (bit-and (long (aget b at)) 0xff) (bit-shift-left (bit-and (long (aget b (+ at 1))) 0xff) 8)
          (bit-shift-left (bit-and (long (aget b (+ at 2))) 0xff) 16) (bit-shift-left (bit-and (long (aget b (+ at 3))) 0xff) 24)))
(defn- put! [^bytes b ^long at ^long v ^long n]
  (dotimes [i n] (aset-byte b (+ at i) (unchecked-byte (bit-shift-right v (* 8 i))))))
(defn- s32? [^long v] (and (>= v -2147483648) (<= v 2147483647)))

;; ---------------------------------------------------------------------------------------------------------------------
;; the inputs (ObjFile::parse, initializeSections, the COMDAT rule)

(defn- ignored?
  "A section that never reaches the output: the object's own tables, the groups, `.note.GNU-stack` (read for the stack's
  permission), SHF_EXCLUDE."
  [s]
  (or (contains? #{elf/SHT_NULL elf/SHT_SYMTAB elf/SHT_STRTAB elf/SHT_RELA SHT_REL elf/SHT_GROUP} (:type s))
      (= ".note.GNU-stack" (:name s))
      (not (zero? (bit-and (long (:flags s)) SHF_EXCLUDE)))))

(defn- read-input [^long fi ^String path ^bytes b]
  (when (and (>= (alength b) 8) (= "!<arch>\n" (String. b 0 8 "ISO-8859-1")))
    (unsupported :archive (str path ": an archive")))
  (let [o (try (elf/read-object b) (catch Exception _ (fail (str path ": not an ELF64 object"))))
        h (:header o)]
    (when-not (= 1 (:type h)) (if (= 3 (:type h)) (unsupported :shared (str path ": a shared object")) (fail (str path ": not a relocatable object"))))
    (when-not (= (:machine *arch*) (:machine h)) (fail (str path ": not an " (:name *arch*) " object")))
    {:idx fi :path path :o o
     :relocs (group-by :target (:relocs o))}))

(defn- groups
  "The object's groups: [SIGNATURE COMDAT? [MEMBER-INDEX...]]."
  [f]
  (let [o (:o f)]
    (vec (for [s (:sections o) :when (= elf/SHT_GROUP (:type s))]
           (let [d ^bytes (:data s) n (quot (alength d) 4)]
             [(:name (nth (:symbols o) (:info s))) (= 1 (bit-and (u32 d 0) 1)) (mapv #(u32 d (* 4 %)) (range 1 n))])))))

;; ---------------------------------------------------------------------------------------------------------------------
;; the symbols (initializeSymbols, Symbol::resolve)

(defn- vis ^long [s] (bit-and (long (or (:other s) 0)) 3))
(defn- min-vis
  "Symbol::mergeProperties: the most constraining visibility of all references."
  ^long [^long a ^long b]
  (cond (zero? a) b (zero? b) a :else (min a b)))

(defn- resolve-symbols!
  "The global symbol table (in the order names are first seen), each name {:state :undef|:common|:defined :weak :file
  :sym S :size :align :vis}, and each file's symbol index → [:local fi i] or [:global NAME]."
  [files live?]
  (let [table (java.util.LinkedHashMap.)]
    (doseq [f files [i s] (map-indexed vector (:symbols (:o f))) :when (and (pos? (long i)) (not= elf/STB_LOCAL (:bind s)))]
      (let [n (:name s) fi (:idx f) shndx (long (:shndx s))
            old (.get table n)
            kind (cond (= shndx elf/SHN_UNDEF) :undef
                       (= shndx elf/SHN_COMMON) :common
                       (= shndx elf/SHN_ABS) :defined
                       (live? fi shndx) :defined
                       :else :undef)
            weak (= elf/STB_WEAK (:bind s))
            v (if old (min-vis (long (:vis old)) (vis s)) (vis s))
            new {:state kind :weak weak :file fi :sym s :size (:size s) :align (:value s) :vis v :name n}]
        (.put table n
              (if (nil? old)
                new
                (let [old (assoc old :vis v)]
                  (case [(:state old) kind]
                    [:undef :undef] (if (and (:weak old) (not weak)) (assoc old :weak false) old)
                    [:undef :common] new
                    [:undef :defined] new
                    [:common :undef] old
                    [:common :common] (assoc (if (> (long (:size s)) (long (:size old))) new old)
                                             :align (max (long (:value s)) (long (:align old))) :vis v)
                    [:common :defined] new
                    [:defined :undef] old
                    [:defined :common] old
                    [:defined :defined] (cond weak old
                                              (:weak old) new
                                              :else (fail (str "duplicate symbol: " n)))))))))
    table))

;; ---------------------------------------------------------------------------------------------------------------------
;; output sections (getOutputSectionName, getSectionRank)

(def ^:private prefixes
  [".data.rel.ro" ".data" ".rodata" ".bss.rel.ro" ".bss" ".ldata" ".lrodata" ".lbss" ".gcc_except_table" ".init_array"
   ".fini_array" ".tbss" ".tdata" ".ARM.exidx" ".ARM.extab" ".ctors" ".dtors" ".sbss" ".sdata" ".srodata"
   ".gnu.build.attributes"])

(defn- prefix? [^String p ^String n] (or (= n p) (and (.startsWith n p) (= \. (.charAt n (.length p))))))

(defn out-name
  "LinkerScript::getOutputSectionName with no SECTIONS: `.text.*` into `.text`, the other GNU prefixes likewise."
  [^String n]
  (cond (= n "COMMON") ".bss"
        (prefix? ".text" n) ".text"
        (prefix? ".ltext" n) ".ltext"
        :else (or (first (filter #(prefix? % n) prefixes)) n)))

(defn- relro? [o]
  (let [fl (long (:flags o)) n (:name o)]
    (and (not (zero? (bit-and fl elf/SHF_ALLOC))) (not (zero? (bit-and fl elf/SHF_WRITE)))
         (or (not (zero? (bit-and fl elf/SHF_TLS)))
             (contains? #{SHT_INIT_ARRAY SHT_FINI_ARRAY SHT_PREINIT_ARRAY} (:type o))
             (contains? #{".got" ".relro_padding" ".dynamic" ".data.rel.ro" ".bss.rel.ro" ".ctors" ".dtors" ".jcr" ".eh_frame"
                          ".fini_array" ".init_array" ".preinit_array"} n)))))

(defn- rank
  "Writer's getSectionRank for x86-64 (no -T, no large sections): R, RX, RW TLS, RW RELRO, RW; NOBITS after PROGBITS."
  ^long [o]
  (let [fl (long (:flags o)) x (not (zero? (bit-and fl elf/SHF_EXECINSTR))) w (not (zero? (bit-and fl elf/SHF_WRITE)))
        r (bit-shift-left 1 27)]
    (if (zero? (bit-and fl elf/SHF_ALLOC))
      (bit-or r (bit-shift-left 1 26))
      (let [r (cond (and (not w) (not x)) (bit-or r (bit-shift-left 1 9)
                                                 (cond (= (:name o) ".interp") 1 (= (:type o) SHT_NOTE) 2
                                                       (not= (:type o) elf/SHT_PROGBITS) 3 :else (bit-shift-left 1 11)))
                    x (bit-or r (if w (bit-shift-left 1 13) (bit-shift-left 1 12)))
                    :else (bit-or r (bit-shift-left 1 14)
                                  (if (zero? (bit-and fl elf/SHF_TLS)) (bit-shift-left 1 7) 0)
                                  (if (relro? o) 0 (bit-shift-left 1 8))))]
        (if (= (:type o) elf/SHT_NOBITS) (bit-or r (bit-shift-left 1 6)) r)))))

;; ---------------------------------------------------------------------------------------------------------------------
;; mergeable sections (MergeInputSection::splitIntoPieces, MergeNoTailSection)

(defn- pieces
  "The pieces of a mergeable section: [IN-OFFSET SIZE KEY]."
  [s]
  (let [^bytes d (:data s) n (alength d) es (long (max 1 (long (:entsize s))))
        strings (not (zero? (bit-and (long (:flags s)) SHF_STRINGS)))]
    (when-not (zero? (rem n es)) (fail (str (:name s) ": SHF_MERGE section size must be a multiple of sh_entsize")))
    (if strings
      (loop [at (long 0) acc []]
        (if (>= at n)
          acc
          (let [end (loop [e at] (cond (> (+ e es) n) (fail (str (:name s) ": string is not null terminated"))
                                       (every? #(zero? (aget d (+ e (long %)))) (range es)) (+ e es)
                                       :else (recur (+ e es))))]
            (recur (long end) (conj acc [at (- end at) (String. d (int at) (int (- end at)) "ISO-8859-1")])))))
      (vec (for [at (range 0 n es)] [at es (String. d (int at) (int es) "ISO-8859-1")])))))

;; ---------------------------------------------------------------------------------------------------------------------
;; .eh_frame (EhInputSection::split, EhFrameSection)

(defn- eh-records
  "The records of an input .eh_frame: [IN-OFFSET SIZE CIE?]; a zero length ends it."
  [^bytes d]
  (let [n (alength d)]
    (loop [at (long 0) acc []]
      (if (> (+ at 4) n)
        acc
        (let [len (u32 d at)]
          (cond (zero? len) acc
                (= len 0xffffffff) (unsupported :eh-frame "a 64-bit .eh_frame record")
                (> (+ at 4 len) n) (fail "corrupted .eh_frame: CIE/FDE too large")
                :else (recur (long (+ at 4 len)) (conj acc [at (+ 4 len) (zero? (u32 d (+ at 4)))]))))))))

;; ---------------------------------------------------------------------------------------------------------------------
;; the link

(defn- sec-of [files ^long fi ^long i] (nth (:sections (:o (nth files fi))) i))

(defn link
  "The static executable of the objects `inputs` ([PATH BYTES]...): {:bytes BYTES :map {...}}, or {:error MESSAGE}, or
  {:unsupported CLASS :what TEXT}."
  [inputs & [{:keys [entry] :or {entry "_start"}}]]
  (try
    (let [image-base (long (:image-base *arch*)) max-page (long (:max-page *arch*)) common-page (long (:common-page *arch*))
          aarch64? (= 183 (:machine *arch*))
          files (vec (map-indexed (fn [i [p b]] (read-input i p b)) inputs))
          ;; COMDAT: the first group of a signature kept, the members of a later one discarded
          seen (java.util.HashSet.)
          discarded (java.util.HashSet.)
          _ (doseq [f files [sig comdat members] (groups f)]
              (when comdat
                (if (.contains seen sig)
                  (doseq [m members] (.add discarded [(:idx f) m]))
                  (.add seen sig))))
          live? (fn [fi i] (let [i (long i)]
                             (and (pos? i) (< i 0xff00) (not (.contains discarded [fi i]))
                                  (not (ignored? (sec-of files fi i))))))
          table (resolve-symbols! files live?)
          gsym (fn [n] (.get ^java.util.LinkedHashMap table n))
          ;; the input sections into output sections, in creation order
          osecs (java.util.LinkedHashMap.)
          osec! (fn [n type flags]
                  (or (.get osecs n)
                      (let [o (volatile! {:name n :type type :flags 0 :align 1 :entsize nil :items []})] (.put osecs n o) o)))
          add-item! (fn [o item s]
                      (vswap! o (fn [m]
                                  (let [t (:type m)]
                                    (-> m
                                        (update :items conj item)
                                        (assoc :type (if (or (= t (:type s)) (not= t elf/SHT_NOBITS)) (if (= t elf/SHT_NOBITS) (:type s) t) (:type s)))
                                        (update :flags bit-or (bit-and (long (:flags s)) (bit-not (bit-or elf/SHF_GROUP elf/SHF_INFO_LINK))))
                                        (update :align max (long (max 1 (long (:align s)))))
                                        (assoc :entsize (if (or (nil? (:entsize m)) (= (:entsize m) (:entsize s))) (:entsize s) 0)))))))
          eh-inputs (java.util.ArrayList.)
          _ (doseq [f files [i s] (map-indexed vector (:sections (:o f))) :when (live? (:idx f) i)]
              (let [n (out-name (:name s))]
                (if (and (= ".eh_frame" (:name s)) (not (zero? (bit-and (long (:flags s)) elf/SHF_ALLOC))))
                  (.add eh-inputs [(:idx f) i])
                  (let [o (osec! n (:type s) (:flags s))]
                    (when (and (not (zero? (bit-and (long (:flags s)) SHF_MERGE))) (seq (get (:relocs f) i)))
                      (unsupported :merge-relocs (str (:name s) ": relocations in a mergeable section")))
                    (add-item! o {:kind :isec :key [(:idx f) i]} s)))))
          ;; commons: a BSS section of each, in the symbol table's order
          _ (doseq [[n g] table :when (= :common (:state g))]
              (add-item! (osec! ".bss" elf/SHT_NOBITS 0) {:kind :common :name n}
                         {:type elf/SHT_NOBITS :flags (bit-or elf/SHF_ALLOC elf/SHF_WRITE) :align (max 1 (long (:align g))) :entsize 0}))
          ;; the linker's line in .comment
          _ (add-item! (osec! ".comment" elf/SHT_PROGBITS 0) {:kind :comment}
                       {:type elf/SHT_PROGBITS :flags (bit-or SHF_MERGE SHF_STRINGS) :align 1 :entsize 1})
          ;; symbols by file index
          symref (fn [^long fi ^long si]
                   (let [s (nth (:symbols (:o (nth files fi))) si)]
                     (if (= elf/STB_LOCAL (:bind s)) [:local fi si] [:global (:name s)])))
          ;; the relocations scanned: the GOT's entries and GOTPCRELX's relaxation (RelocScan::process, adjustGotPcExpr)
          got (java.util.LinkedHashMap.)
          tls-got (java.util.HashSet.)
          decisions (java.util.HashMap.)
          flags (volatile! #{})
          absolute-or-tls? (fn [[k a b]]
                             (if (= k :local)
                               (let [s (nth (:symbols (:o (nth files a))) b)]
                                 (or (= (:shndx s) elf/SHN_ABS) (= (:type s) elf/STT_TLS)))
                               (let [g (gsym a)]
                                 (or (nil? g) (and (= :undef (:state g)) (:weak g))
                                     (and (= :defined (:state g)) (= (:shndx (:sym g)) elf/SHN_ABS))
                                     (= (:type (:sym g)) elf/STT_TLS)))))
          _ (when-let [g (gsym "_GLOBAL_OFFSET_TABLE_")] (when (= :undef (:state g)) (vswap! flags conj :gotplt)))
          _ (doseq [f files [i rs] (:relocs f) :when (and (live? (:idx f) i) (not= ".eh_frame" (:name (sec-of files (:idx f) i))))
                    [ri r] (map-indexed vector rs)]
              (let [t (long (:type r)) fi (:idx f) ref (symref fi (:sym r))
                    ^bytes d (:data (sec-of files fi i)) off (long (:offset r))]
                (if aarch64?
                  ;; AArch64 (RelocScan for AArch64::getRelExpr): a GOT entry for the GOT's relocations and initial exec's (kept,
                  ;; not relaxed to local exec: the entry holds the offset from the thread pointer)
                  (case t
                    (0x135 0x137 0x138 0x139) (when-not (.containsKey got ref) (.put got ref (.size got)))
                    (0x21d 0x21e 0x21f) (do (when-not (.containsKey got ref) (.put got ref (.size got))) (.add tls-got ref))
                    (0x200 0x201 0x202 0x203 0x204 0x205 0x206 0x207 0x208 0x209 0x20a 0x230 0x231 0x232 0x233 0x234 0x235 0x236 0x237 0x238 0x239)
                    (unsupported :tls-gd-ld (str (get @a64-reloc-names t t) " (TLS GD/LD/TLSDESC)"))
                    nil)
                (case t
                  (9 41 42) ;; GOTPCREL, GOTPCRELX, REX_GOTPCRELX
                  (let [op (when (>= off 2) (bit-and (long (aget d (- off 2))) 0xff))
                        modrm (when (>= off 1) (bit-and (long (aget d (- off 1))) 0xff))
                        e (cond (or (absolute-or-tls? ref) (not= -4 (long (:addend r))) (= t 9)) :got
                                (= op 0x8b) :relax
                                (and (= op 0xff) (or (= modrm 0x15) (= modrm 0x25))) :relax
                                (= t 41) :got
                                :else :relax-nopic)]
                    (.put decisions [fi i ri] e)
                    (if (= e :got) (when-not (.containsKey got ref) (.put got ref (.size got))) (vswap! flags conj :got)))
                  (3 27) (do (when-not (.containsKey got ref) (.put got ref (.size got))) (vswap! flags conj :gotplt))
                  (25 26 29 31) (vswap! flags conj :gotplt)
                  (19 20 34 35 36) (unsupported :tls-gd-ld (str "R_X86_64_" (get elf/reloc-names t t) " (TLS GD/LD/TLSDESC to LE)"))
                  nil))))
          _ (when (or (pos? (.size got)) (contains? @flags :got))
              (add-item! (osec! ".got" elf/SHT_PROGBITS 0) {:kind :got} {:type elf/SHT_PROGBITS :flags (bit-or elf/SHF_ALLOC elf/SHF_WRITE) :align 8 :entsize 0}))
          _ (when (contains? @flags :gotplt)
              (add-item! (osec! ".got.plt" elf/SHT_PROGBITS 0) {:kind :gotplt} {:type elf/SHT_PROGBITS :flags (bit-or elf/SHF_ALLOC elf/SHF_WRITE) :align 8 :entsize 0}))
          ;; .eh_frame: CIEs deduplicated by contents and personality, the FDEs of dead functions dropped
          eh (when (pos? (.size eh-inputs))
               (let [cies (java.util.LinkedHashMap.) out-of (java.util.HashMap.)]
                 (doseq [[fi i] eh-inputs]
                   (let [s (sec-of files fi i) ^bytes d (:data s) rs (sort-by :offset (get (:relocs (nth files fi)) i))
                         recs (eh-records d)
                         first-rel (fn [at size] (first (filter #(and (>= (long (:offset %)) (long at)) (< (long (:offset %)) (+ (long at) (long size)))) rs)))
                         local-cie (java.util.HashMap.)]
                     (doseq [[at size cie?] recs :when cie?]
                       (let [r (first-rel at size)
                             k [(String. d (int at) (int size) "ISO-8859-1") (when r (symref fi (:sym r)))]]
                         (when-not (.containsKey cies k) (.put cies k (volatile! {:src [fi i at size] :fdes []})))
                         (.put local-cie at (.get cies k))))
                     (doseq [[at size cie?] recs :when (not cie?)]
                       (let [cie (.get local-cie (- (+ (long at) 4) (u32 d (+ (long at) 4))))
                             r (first-rel at size)
                             ref (when r (symref fi (:sym r)))
                             fn-live (when ref
                                       (if (= :local (first ref))
                                         (let [s (nth (:symbols (:o (nth files fi))) (nth ref 2))] (live? fi (:shndx s)))
                                         (= :defined (:state (gsym (second ref))))))]
                         (when-not cie (fail "invalid CIE reference"))
                         (when fn-live (vswap! cie update :fdes conj [fi i at size]))))))
                 (let [o (java.io.ByteArrayOutputStream.) offs (java.util.HashMap.)]
                   (doseq [[_ c] cies]
                     (let [[fi i at size] (:src @c) ^bytes d (:data (sec-of files fi i)) cie-off (.size o)]
                       (.put offs [fi i at] cie-off)
                       (.write o d (int at) (int size))
                       (doseq [[fi i at size] (:fdes @c)]
                         (let [^bytes d (:data (sec-of files fi i)) p (.size o) b (java.util.Arrays/copyOfRange d (int at) (int (+ (long at) (long size))))]
                           (put! b 4 (- (+ p 4) cie-off) 4)
                           (.put offs [fi i at] p)
                           (.write o b 0 (alength b))))))
                   {:bytes (.toByteArray o) :offs offs
                    :align (reduce max 1 (map (fn [[fi i]] (long (:align (sec-of files fi i)))) eh-inputs))})))
          _ (when eh (add-item! (osec! ".eh_frame" elf/SHT_PROGBITS 0) {:kind :eh}
                                {:type elf/SHT_PROGBITS :flags elf/SHF_ALLOC :align (:align eh) :entsize 0}))
          _ (add-item! (osec! ".relro_padding" elf/SHT_NOBITS 0) {:kind :relro-pad} {:type elf/SHT_NOBITS :flags (bit-or elf/SHF_ALLOC elf/SHF_WRITE) :align 1 :entsize 0})
          ;; the order: lld's rank, stably
          order0 (vec (sort-by rank (map deref (vals osecs))))
          ;; .relro_padding only after a RELRO section that has a PT_LOAD
          order (let [seen-relro (volatile! false)]
                  (vec (for [o order0
                             :let [keep (or (not= ".relro_padding" (:name o)) @seen-relro)]
                             :when keep]
                         (do (when (and (relro? o) (not (and (= (:type o) elf/SHT_NOBITS) (not (zero? (bit-and (long (:flags o)) elf/SHF_TLS))))))
                               (vreset! seen-relro true))
                             o))))
          ;; each output section's items laid out: the mergeable inputs as one synthetic section at the first one's place
          place (java.util.HashMap.)  ;; [fi i] -> [osec-name offset] or [osec-name {in-off out-off}]
          commons (java.util.HashMap.)
          contents (java.util.HashMap.) ;; osec name -> {:size :parts [[off bytes]]}
          got-off (volatile! nil) gotplt-off (volatile! nil) eh-off (volatile! nil)
          order (vec (for [o order]
                       (let [n (:name o) exec (not (zero? (bit-and (long (:flags o)) elf/SHF_EXECINSTR)))
                             merges (java.util.LinkedHashMap.)
                             items (vec (reduce (fn [acc it]
                                                  (if (and (= :isec (:kind it)) (let [[fi i] (:key it) s (sec-of files fi i)] (not (zero? (bit-and (long (:flags s)) SHF_MERGE)))))
                                                    (let [[fi i] (:key it) s (sec-of files fi i)
                                                          k [(:flags s) (:entsize s) (if (zero? (bit-and (long (:flags s)) SHF_STRINGS)) 0 (:align s))]]
                                                      (if-let [m (.get merges k)]
                                                        (do (vswap! m conj it) acc)
                                                        (let [m (volatile! [it])] (.put merges k m) (conj acc {:kind :merge :members m}))))
                                                    (if (= :comment (:kind it))
                                                      (let [k [(bit-or SHF_MERGE SHF_STRINGS) 1 1]]
                                                        (if-let [m (.get merges k)]
                                                          (do (vswap! m conj it) acc)
                                                          (let [m (volatile! [it])] (.put merges k m) (conj acc {:kind :merge :members m}))))
                                                      (conj acc it))))
                                                [] (:items o)))
                             parts (java.util.ArrayList.)
                             size (reduce
                                   (fn [^long at it]
                                     (case (:kind it)
                                       :isec (let [[fi i] (:key it) s (sec-of files fi i) a (max 1 (long (:align s))) p (align-up at a)]
                                               (.put place [fi i] [n p])
                                               (when-not (= elf/SHT_NOBITS (:type s)) (.add parts [p (:data s)]))
                                               (+ p (long (:size s))))
                                       :common (let [g (gsym (:name it)) p (align-up at (max 1 (long (:align g))))]
                                                 (.put commons (:name it) [n p]) (+ p (long (:size g))))
                                       :merge (let [ms @(:members it)
                                                    a (reduce max 1 (for [m ms] (if (= :comment (:kind m)) 1 (let [[fi i] (:key m)] (long (:align (sec-of files fi i)))))))
                                                    base (align-up at a)
                                                    seen (java.util.HashMap.)
                                                    o (java.io.ByteArrayOutputStream.)]
                                                (doseq [m ms]
                                                  (let [ps (if (= :comment (:kind m))
                                                             (let [b (.getBytes (str link-comment "\u0000") "ISO-8859-1")] [[0 (alength b) (String. b "ISO-8859-1")]])
                                                             (pieces (let [[fi i] (:key m)] (sec-of files fi i))))
                                                        mp (java.util.TreeMap.)]
                                                    (doseq [[in-off sz k] ps]
                                                      (let [out (or (.get seen k)
                                                                    (let [q (align-up (.size o) a)]
                                                                      (dotimes [_ (- q (.size o))] (.write o 0))
                                                                      (.write o (.getBytes ^String k "ISO-8859-1") 0 (int sz))
                                                                      (.put seen k q) q))]
                                                        (.put mp (long in-off) (+ base (long out)))))
                                                    (when (= :isec (:kind m)) (.put place (:key m) [n mp]))))
                                                (.add parts [base (.toByteArray o)])
                                                (+ base (.size o)))
                                       :eh (let [p (align-up at (long (:align eh)))] (vreset! eh-off [n p]) (.add parts [p (:bytes eh)]) (+ p (alength ^bytes (:bytes eh))))
                                       :got (let [p (align-up at 8)] (vreset! got-off [n p]) (+ p (* 8 (.size got))))
                                       :gotplt (let [p (align-up at 8)] (vreset! gotplt-off [n p]) (+ p 24))
                                       :relro-pad at))
                                   0 items)]
                         (.put contents n {:parts (vec parts) :exec exec})
                         (assoc o :size size :entsize (or (:entsize o) 0)))))
          ;; the program headers (createPhdrs)
          alloc? (fn [o] (not (zero? (bit-and (long (:flags o)) elf/SHF_ALLOC))))
          tbss? (fn [o] (and (= (:type o) elf/SHT_NOBITS) (not (zero? (bit-and (long (:flags o)) elf/SHF_TLS)))))
          pflags (fn [o] (bit-or PF_R (if (zero? (bit-and (long (:flags o)) elf/SHF_WRITE)) 0 PF_W)
                                 (if (zero? (bit-and (long (:flags o)) elf/SHF_EXECINSTR)) 0 PF_X)))
          loads (let [acc (java.util.ArrayList.) cur (volatile! {:flags PF_R :secs [:headers] :last-nobits false})
                      relro-end (let [v (volatile! nil) active (volatile! false)]
                                  (doseq [o order :when (and (alloc? o) (not (tbss? o)))]
                                    (if (relro? o) (vreset! active true) (when (and @active (nil? @v)) (vreset! v (:name o)) (vreset! active false))))
                                  @v)]
                  (doseq [o order :when (and (alloc? o) (not (tbss? o)))]
                    (let [f (pflags o) c @cur]
                      (if (and (= f (:flags c)) (not= (:name o) relro-end)
                               (or (= (:type o) elf/SHT_NOBITS) (not (:last-nobits c))))
                        (vswap! cur #(-> % (update :secs conj (:name o)) (assoc :last-nobits (= (:type o) elf/SHT_NOBITS))))
                        (do (.add acc @cur) (vreset! cur {:flags f :secs [(:name o)] :last-nobits (= (:type o) elf/SHT_NOBITS)})))))
                  (.add acc @cur)
                  (vec acc))
          tls-secs (vec (for [o order :when (and (alloc? o) (not (zero? (bit-and (long (:flags o)) elf/SHF_TLS))))] (:name o)))
          relro-secs (vec (for [o order :when (and (alloc? o) (not (tbss? o)) (relro? o))] (:name o)))
          nphdr (+ 1 (count loads) (if (seq tls-secs) 1 0) (if (seq relro-secs) 1 0) 1)
          hdr-size (+ 64 (* 56 nphdr))
          first-of (into {} (for [l loads :let [s (first (:secs l))] :when (string? s)] [s l]))
          tls-first (first tls-secs)
          tls-align (reduce max 1 (for [o order :when (some #{(:name o)} tls-secs)] (long (:align o))))
          ;; the addresses (assignAddresses, fixSectionAlignments)
          addr (java.util.HashMap.)
          _ (loop [os order dot (+ image-base hdr-size)]
              (when-let [o (first os)]
                (if (not (alloc? o))
                  (do (.put addr (:name o) 0) (recur (rest os) dot))
                  (let [dot (cond (and (first-of (:name o)) (= (:name o) tls-first))
                                  (+ (align-up dot max-page) (align-up (rem dot max-page) tls-align))
                                  (first-of (:name o)) (+ (align-up dot max-page) (rem dot max-page))
                                  :else dot)
                        a (align-up dot (long (:align o)))
                        size (if (= ".relro_padding" (:name o)) (- (align-up a common-page) a) (long (:size o)))]
                    (.put addr (:name o) a)
                    (recur (rest os) (if (tbss? o) dot (+ a size)))))))
          order (vec (for [o order] (if (= ".relro_padding" (:name o)) (assoc o :size (- (align-up (long (.get addr ".relro_padding")) common-page) (long (.get addr ".relro_padding")))) o)))
          by-name (into {} (map (juxt :name identity) order))
          ;; the empty PT_LOADs removed (removeEmptyPTLoad)
          loads (vec (filter (fn [l] (let [ss (remove keyword? (:secs l))]
                                       (or (some keyword? (:secs l))
                                           (and (seq ss) (let [f (by-name (first ss)) z (by-name (last ss))]
                                                           (not= (+ (long (.get addr (:name z))) (long (:size z))) (long (.get addr (:name f)))))))))
                             loads))
          load-of (into {} (for [l loads s (:secs l) :when (string? s)] [s l]))
          ;; the file offsets (assignFileOffsets, computeFileOffset)
          offset (java.util.HashMap.)
          end-off (loop [os order off hdr-size]
                    (if-let [o (first os)]
                      (let [n (:name o) l (load-of n) a (long (.get addr n))
                            fo (cond (and l (= n (first (:secs l)))) (+ off (mod (- (rem a max-page) (rem off max-page)) max-page))
                                     (and (= (:type o) elf/SHT_NOBITS) (not (and tls-first (= n tls-first)))) off
                                     (nil? l) (align-up off (long (:align o)))
                                     :else (let [f (first (:secs l))] (if (keyword? f) a
                                                                           (+ (long (.get offset f)) (- a (long (.get addr f)))))))
                            fo (if (and l (keyword? (first (:secs l))) (not= n (first (:secs l)))) (- a image-base) fo)]
                        (.put offset n fo)
                        (recur (rest os) (long (if (= (:type o) elf/SHT_NOBITS) fo (+ (long fo) (long (:size o)))))))
                      off))
          ;; the symbols' addresses
          tls-start (when tls-first (long (.get addr tls-first)))
          tls-memsz (when tls-first (let [z (by-name (last tls-secs))] (- (+ (long (.get addr (:name z))) (long (:size z))) (long tls-start))))
          sec-va (fn [fi shndx value addend-in?]
                   (let [[n p] (.get place [fi shndx])]
                     (when (nil? n) (fail "a symbol in a discarded section"))
                     (if (instance? java.util.TreeMap p)
                       (let [^java.util.TreeMap p p e (.floorEntry p (long value))
                             s (sec-of files fi shndx)]
                         (when-not e (fail (str (:name s) ": entry is past the end of the section")))
                         (+ (long (.get addr n)) (long (.getValue e)) (- (long value) (long (.getKey e)))))
                       (+ (long (.get addr n)) (long p) (long value)))))
          defined-syms (java.util.HashMap.)
          ;; linker-defined symbols (addOptionalRegular): only when referenced and undefined
          reserved (let [first-load (first loads)
                         ro-loads (filter #(zero? (bit-and (long (:flags %)) PF_W)) loads)
                         last-sec (fn [l] (by-name (last (filter string? (:secs l)))))
                         end-of (fn [o] (+ (long (.get addr (:name o))) (long (:size o))))
                         last-load (last loads)]
                     (cond-> {"__ehdr_start" image-base "__executable_start" image-base}
                       (seq ro-loads) (assoc "_etext" (when-let [o (last-sec (last ro-loads))] (end-of o)))
                       last-load (assoc "_end" (end-of (last-sec last-load))
                                        "_edata" (let [o (last (filter #(not= elf/SHT_NOBITS (:type %)) (map by-name (filter string? (:secs last-load)))))]
                                                   (when o (end-of o))))
                       (by-name ".bss") (assoc "__bss_start" (long (.get addr ".bss")))
                       @gotplt-off (assoc "_GLOBAL_OFFSET_TABLE_" (+ (long (.get addr (first @gotplt-off))) (long (second @gotplt-off))))
                       true (into (for [o order :when (re-matches #"[A-Za-z_][A-Za-z0-9_]*" (:name o)) :when (alloc? o)
                                        [k v] [[(str "__start_" (:name o)) (long (.get addr (:name o)))]
                                               [(str "__stop_" (:name o)) (+ (long (.get addr (:name o))) (long (:size o)))]]]
                                    [k v]))
                       true (into (for [[a o] [["__init_array" ".init_array"] ["__fini_array" ".fini_array"] ["__preinit_array" ".preinit_array"]]
                                        [k v] (if-let [s (by-name o)]
                                                [[(str a "_start") (long (.get addr o))] [(str a "_end") (+ (long (.get addr o)) (long (:size s)))]]
                                                [[(str a "_start") image-base] [(str a "_end") image-base]])]
                                    [k v]))))
          reserved (into {} (for [[k v] reserved :let [v (cond (= k "_etext") v (= k "_end") v :else v)] :when v] [k v]))
          reserved (merge reserved (into {} (for [[a b] [["etext" "_etext"] ["edata" "_edata"] ["end" "_end"]] :when (reserved b)] [a (reserved b)])))
          made (java.util.HashMap.)
          _ (doseq [[n g] table :when (and (= :undef (:state g)) (contains? reserved n))]
              (.put made n (reserved n)))
          sym-va (fn sym-va [ref addend]
                   (let [[k a b] ref]
                     (if (= k :local)
                       (let [s (nth (:symbols (:o (nth files a))) b) shndx (long (:shndx s))]
                         (cond (= shndx elf/SHN_ABS) (long (:value s))
                               (= (:type s) elf/STT_SECTION) (sec-va a shndx (+ (long (:value s)) (long addend)) true)
                               (= (:type s) elf/STT_TLS) (- (long (sec-va a shndx (:value s) false)) (long tls-start))
                               :else (sec-va a shndx (:value s) false)))
                       (let [g (gsym a)]
                         (case (:state g)
                           :defined (let [s (:sym g) shndx (long (:shndx s))]
                                      (cond (= shndx elf/SHN_ABS) (long (:value s))
                                            ;; a TLS symbol's address is its offset in the TLS segment (getSymVA)
                                            (= (:type s) elf/STT_TLS) (- (long (sec-va (:file g) shndx (:value s) false)) (long tls-start))
                                            :else (sec-va (:file g) shndx (:value s) false)))
                           :common (let [[n p] (.get commons a)] (+ (long (.get addr n)) (long p)))
                           :undef (cond (.containsKey made a) (long (.get made a))
                                        (:weak g) 0
                                        :else (fail (str "undefined symbol: " a))))))))
          ;; the section addend folded for a section symbol (getSymVA: a merge section's offset includes the addend)
          target-va (fn [ref ^long addend]
                      (let [[k a b] ref
                            sect? (and (= k :local) (let [s (nth (:symbols (:o (nth files a))) b)]
                                                      (and (= (:type s) elf/STT_SECTION)
                                                           (instance? java.util.TreeMap (second (.get place [a (:shndx s)]))))))]
                        (if sect? (sym-va ref addend) (+ (long (sym-va ref 0)) addend))))
          sym-size (fn [ref] (let [[k a b] ref] (if (= k :local) (long (:size (nth (:symbols (:o (nth files a))) b))) (long (or (:size (gsym a)) 0)))))
          got-va (fn [ref] (+ (long (.get addr (first @got-off))) (long (second @got-off)) (* 8 (long (.get got ref)))))
          gotplt-va (fn [] (+ (long (.get addr (first @gotplt-off))) (long (second @gotplt-off))))
          ;; getTlsTpOffset for x86-64 (variant II): the offset in the segment, less its size and the alignment's padding
          tp-off (if aarch64?
                   ;; variant I (AArch64): the offset in the segment after the TCB's two words, aligned to the segment
                   (fn [^long off] (+ off (align-up 16 (long tls-align))))
                   (fn [^long off] (- off (long tls-memsz) (bit-and (- (- (long tls-start)) (long tls-memsz)) (dec (long tls-align))))))
          ;; the output sections' bytes
          buf (fn [o] (let [b (byte-array (long (:size o)))]
                        (when (:exec (.get contents (:name o))) (java.util.Arrays/fill b (unchecked-byte (:trap *arch*))))
                        (doseq [[p ^bytes d] (:parts (.get contents (:name o)))] (System/arraycopy d 0 b (int p) (alength d)))
                        b))
          bufs (into {} (for [o order :when (not= elf/SHT_NOBITS (:type o))] [(:name o) (buf o)]))

(ns arbace.asm.arm64.objcheck
  "AR4's object verdict (doc/asm/ARM64-SURVEY.md §4.4, ARS9 (c)'s own-verdict half): MC/AArch64's object tests judged by their
  own CHECK lines, no LLVM tool. Each test's RUN lines (continuations joined) that assemble with -filetype=obj for an ELF
  triple and pipe the object to a viewer give a run: the object is Arbace's (arbace.asm.arm64.obj), the viewer's text is
  Arbace's view of it in that tool's format (llvm-objdump -d and -r, llvm-readobj -r: the stated bytes and relocations; judge-rest:
  llvm-dwarfdump --debug-frame's call frames, view-dwarfdump-frames), and
  the run's CHECK lines (its prefixes) are held to the view as FileCheck holds them (arbace.asm.amd64.decode-check's
  FileCheck subset). A disassembly's line is held to its stated bytes alone (offset and word, or the data's bytes): its text
  is the decoder's, AR3's (the class :decoder-text). A run that states an error (`not llvm-mc`) is met when the object
  assembler refuses the file with the stated fragment. Every line is a case: met, or classed by cause (the object assembler's
  class, the view not built, :decoder-text, FileCheck's variables)."
  (:require [arbace.repr.asm :as asm]
            [arbace.repr.asm.arm64.lenc :as lenc]
            [arbace.asm.arm64.obj :as obj]
            [arbace.asm.obj :as o]
            [arbace.asm.amd64.decode-check :as dc]
            [arbace.asm.elf :as elf]
            [arbace.string :as str]))

(set! *warn-on-reflection* true)

;; ---------------------------------------------------------------------------------------------------------------------
;; the runs

(defn run-lines
  "The test's RUN lines, continuations joined."
  [^String src]
  (loop [ls (str/split-lines src) cur nil out []]
    (if (empty? ls)
      (if cur (conj out cur) out)
      (let [l (first ls)]
        (if-let [[_ r] (re-find #"RUN:\s*(.*)$" l)]
          (let [c (if cur (str cur " " r) r)]
            (if (re-find #"\\\s*$" c)
              (recur (rest ls) (str/replace c #"\\\s*$" "") out)
              (recur (rest ls) nil (conj out c))))
          (recur (rest ls) cur out))))))

(defn- elf-triple? [^String t]
  (and t (not (re-find #"(?i)darwin|apple|ios|macos|win|coff|ilp32|arm64_32|_be|arm64ec" t))))

(defn- prefixes-of [^String fc]
  (let [ps (concat (mapcat #(str/split % #",") (map second (re-seq #"--?check-prefix(?:es)?[= ]+(\S+)" fc))))]
    (if (seq ps) (vec ps) ["CHECK"])))

(defn- run-of
  "One object run: llvm-mc's command `mc`, the viewer reading its object (nil: none), FileCheck's command `fc`, the RUN line `r`."
  [^String mc viewer ^String fc ^String r]
  {:error? (boolean (re-find #"^not\s" mc))
   ;; the input's name in the diagnostics (ARS43 (a)): `<stdin>` when llvm-mc reads it there, else its path
   :stdin? (boolean (re-find #"<\s*%s" mc))
   :full-lines (boolean (re-find #"--match-full-lines" fc))
   :split? (boolean (re-find #"split-file|%t/" r))
   ;; llvm-mc's standard error FileCheck reads (`2>&1`, no viewer: its diagnostics alone)
   :stderr? (boolean (re-find #"2>\s*&1" mc))
   :prefixes (prefixes-of fc)
   :implicit-not (mapv second (re-seq #"--implicit-check-not[= ](\S+)" fc))
   :viewer viewer
   ;; -implicit-mapsyms (ARS47 (a)): the object assembled so
   :implicit-mapsyms (boolean (re-find #"-implicit-mapsyms" mc))
   ;; --defsym NAME=VALUE (ARS49 (a)): the object assembled with it (an error run's `.ifdef ERR`)
   ;; the values' text, read by arbace.asm.obj/defsyms when the run is assembled, inside its try (review 1111 (8): one
   ;; parser, llvm-mc's radix sensing)
   :defsym (o/defsym-of mc)
   ;; judge-rest: --large-eh-encoding, --large-code-model: the FDEs' pointers in sdata8 (arbace.asm.obj/emit-frames!)
   :large-eh (boolean (re-find #"(^|\s)--?large-(eh-encoding|code-model)\b" mc))
   :tool (cond (nil? viewer) :no-viewer
               (and (re-find #"^llvm-objdump" viewer) (= #{"-t" "-"} (set (rest (str/split (str/trim viewer) #"\s+"))))) :objdump-t
               (and (re-find #"^llvm-readelf" viewer) (= #{"-s" "-"} (set (rest (str/split (str/trim viewer) #"\s+"))))) :readelf-s
               (and (re-find #"^llvm-readelf" viewer) (= #{"--arch-specific" "-"} (set (rest (str/split (str/trim viewer) #"\s+"))))) :readelf-arch
               (and (re-find #"^llvm-readelf" viewer) (re-matches #"llvm-readelf\s+--hex-dump=\S+\s+-" (str/trim viewer))) :readelf-x
               ;; ARS49 (a): GNU style's section headers, relocations and hex dumps together (elf-reloc-ptrauth's -S -r -x)
               (and (re-find #"^llvm-readelf" viewer)
                    (re-matches #"llvm-readelf(\s+(-S|-r|-x\s+\S+|--hex-dump=\S+))+\s+-" (str/trim viewer))) :readelf
               (and (re-find #"^llvm-objdump" viewer) (re-find #"(^|\s)-[a-zA-Z]*d" viewer)) :objdump-d
               ;; judge-rest: -D (every section disassembled), with -r too (mov-expr-as-immediate's -Dr)
               (and (re-find #"^llvm-objdump" viewer) (re-find #"(^|\s)-[a-zA-Z]*D" viewer)) :objdump-dd
               ;; judge-rest: -Ss, the section headers and the symbol table (mapping-within-section's)
               (and (re-find #"^llvm-readelf" viewer) (= #{"-Ss" "-"} (set (rest (str/split (str/trim viewer) #"\s+"))))) :readelf-ss
               (and (re-find #"^llvm-objdump" viewer) (re-find #"(^|\s)-r\b" viewer)) :objdump-r
               (and (re-find #"^llvm-readobj" viewer) (re-find #"(^|\s)(-r|--relocs|--relocations)\b" viewer)
                    (not (re-find #"(^|\s)(-S|--sections|-s|--symbols|--section-data|--sd)\b" viewer))) :readobj-r
               ;; AR6: llvm-readobj's sections, relocations and symbols together; judge-rest: and the sections' data (--sd)
               (and (re-find #"^llvm-readobj" viewer)
                    (every? #{"-S" "--sections" "--section-headers" "-r" "--relocs" "--relocations" "--symbols" "--syms" "-" "--elf-output-style=LLVM"
                              "--sd" "--section-data"}
                            (rest (str/split (str/trim viewer) #"\s+")))) :readobj
               ;; judge-rest: llvm-dwarfdump's call frame dump (--debug-frame, its alias -eh-frame), nothing else
               (re-matches #"llvm-dwarfdump\s+--?(debug-frame|eh-frame)\s+-" (str/trim viewer)) :dwarfdump-frames
               :else (keyword (str "view-" (first (str/split viewer #"\s+")))))})

(defn runs
  "The object runs of a test: [{:tool :objdump-d|:objdump-r|:readobj-r|KEYWORD :opts TEXT :prefixes [...] :error? :defsym?}]: a
  RUN line that pipes llvm-mc's object (-filetype=obj, an ELF triple) to a viewer and FileCheck, and (judge-rest) a two-step one,
  llvm-mc writing the object to a file (`-o %t`) on one RUN line and a later RUN line's viewer reading that file (`llvm-readobj -S
  --sd %t | FileCheck ...`), paired with the last llvm-mc that wrote it (another triple's, big-endian's, overwriting it: no run)."
  [^String src]
  (loop [rls (run-lines src) outs {} acc []]
    (if (empty? rls)
      acc
      (let [r (first rls)
            pieces (mapv str/trim (str/split r #"\|"))
            mc (first pieces)
            triple (second (re-find #"-m?triple[= ]*(\S+)" mc))
            fc (first (filter #(re-find #"FileCheck" %) pieces))
            obj? (and (re-find #"llvm-mc\b" mc) (re-find #"filetype[= ]obj" mc))
            out (when obj? (second (re-find #"(?:^|\s)-o\s+(\S+)" mc)))
            outs (if (and out (not= out "-")) (if (elf-triple? triple) (assoc outs out mc) (dissoc outs out)) outs)
            ;; a viewer reading a file an earlier RUN line's llvm-mc wrote: the file's name as `-`, as the piped runs read it
            in (when-not obj? (when (re-find #"^llvm-(objdump|readobj|readelf|dwarfdump|nm|rtdyld)\b" mc)
                                (first (filter #(contains? outs %) (rest (str/split mc #"\s+"))))))]
        (cond
          (and obj? (elf-triple? triple) fc)
          (recur (rest rls) outs (conj acc (run-of mc (first (filter #(re-find #"^llvm-(objdump|readobj|readelf|dwarfdump|nm)\b" %) (rest pieces))) fc r)))
          (and in fc)
          (recur (rest rls) outs (conj acc (run-of (get outs in) (str/join " " (map #(if (= % in) "-" %) (str/split mc #"\s+"))) fc r)))
          :else (recur (rest rls) outs acc))))))

;; ---------------------------------------------------------------------------------------------------------------------
;; the views (llvm-objdump's and llvm-readobj's formats, the lines CHECK lines hold to)

(defn- value-text [o r]
  (let [syms (:symbols o) s (nth syms (:sym r) nil)
        nm (cond (or (nil? s) (zero? (long (:sym r)))) "*ABS*" (= elf/STT_SECTION (:type s)) (:name (nth (:sections o) (:shndx s))) :else (:name s))
        a (long (:addend r))]
    [nm a]))

(def ^:dynamic *target*
  "The views' target (queue 337: x86-64's object verdict binds its own): the file format's and the architecture's names, the
  relocation types' names, the machine's section types and flags."
  {:format "elf64-littleaarch64" :arch "aarch64" :reloc-names obj/reloc-names
   :sht {0x70000003 "SHT_AARCH64_ATTRIBUTES"} :shf [["SHF_AARCH64_PURECODE" 0x20000000]] :gnu-flags {0x20000000 "y"}})

(defn- reloc-name [t] (get (:reloc-names *target*) t (str "Unknown (" t ")")))

(defn view-objdump-r [o]
  (concat [(str "<stdin>:\tfile format " (:format *target*)) ""]
          (mapcat (fn [rs]
                    (concat [(str "RELOCATION RECORDS FOR [" (:section (first rs)) "]:") "OFFSET           TYPE                     VALUE"]
                            (for [r rs :let [[nm a] (value-text o r)]]
                              (format "%016x %-24s %s" (:offset r) (reloc-name (:type r))
                                      (str nm (cond (pos? a) (str "+0x" (Long/toHexString a)) (neg? a) (str "-0x" (Long/toHexString (- a))) :else ""))))
                            [""]))
                  (partition-by :section (:relocs o)))))

(defn view-readobj-r [o]
  (concat ["Relocations ["]
          (mapcat (fn [rs]
                    (let [r0 (first rs)
                          ri (some #(when (and (= elf/SHT_RELA (:type %)) (= (:info %) (:target r0))) (:index %)) (:sections o))]
                      (concat [(str "  Section (" ri ") .rela" (:section r0) " {")]
                              (for [r rs :let [[nm a] (value-text o r)]]
                                (str "    0x" (str/upper-case (Long/toHexString (:offset r))) " " (reloc-name (:type r)) " "
                                     (if (= nm "*ABS*") "-" nm) " 0x" (str/upper-case (Long/toHexString a))))
                              ["  }"])))
                  (partition-by :section (:relocs o)))
          ["]"]))

(defn- hexu [^long v] (str "0x" (str/upper-case (Long/toHexString v))))

(def ^:private sht-base
  {0 "SHT_NULL" 1 "SHT_PROGBITS" 2 "SHT_SYMTAB" 3 "SHT_STRTAB" 4 "SHT_RELA" 5 "SHT_HASH" 6 "SHT_DYNAMIC" 7 "SHT_NOTE"
   8 "SHT_NOBITS" 9 "SHT_REL" 11 "SHT_DYNSYM" 14 "SHT_INIT_ARRAY" 15 "SHT_FINI_ARRAY" 16 "SHT_PREINIT_ARRAY" 17 "SHT_GROUP"
   18 "SHT_SYMTAB_SHNDX" 0x6fffff4c "SHT_LLVM_ADDRSIG"})
(defn- sht-names [t] (get (merge sht-base (:sht *target*)) t))

(def ^:private shf-base
  [["SHF_ALLOC" 0x2] ["SHF_COMPRESSED" 0x800] ["SHF_EXCLUDE" 0x80000000] ["SHF_EXECINSTR" 0x4] ["SHF_GROUP" 0x200]
   ["SHF_INFO_LINK" 0x40] ["SHF_LINK_ORDER" 0x80] ["SHF_MERGE" 0x10] ["SHF_OS_NONCONFORMING" 0x100] ["SHF_STRINGS" 0x20]
   ["SHF_TLS" 0x400] ["SHF_WRITE" 0x1] ["SHF_GNU_RETAIN" 0x200000]])
(defn- shf-names [] (concat shf-base (:shf *target*)))

(defn- section-data-lines
  "Bytes `d` as llvm-readobj's --sd prints them (ScopedPrinter's printBinaryBlock, raw_ostream's FormattedBytes): 16 a line, in
  groups of 4, upper case, the offset in 4 digits at least (as many as the last line's needs), the ASCII column aligned."
  [^bytes d ^long indent]
  (let [n (if d (alength d) 0)
        last-off (* 16 (quot n 16))
        width (max 4 (quot (+ 3 (if (pos? last-off) (- 64 (Long/numberOfLeadingZeros (dec last-off))) 0)) 4))
        block 35]
    (vec (for [off (range 0 n 16)
               :let [bs (mapv #(bit-and (long (aget d (long %))) 0xff) (range off (min n (+ off 16))))
                     hex (str/join " " (map #(apply str (map (fn [b] (format "%02X" b)) %)) (partition-all 4 bs)))]]
           (str (apply str (repeat indent \space)) (format (str "%0" width "X") off) ": " hex
                (apply str (repeat (+ 2 (- block (count hex))) \space))
                "|" (apply str (map #(if (<= 0x20 (long %) 0x7e) (char %) \.) bs)) "|")))))

(defn view-readobj
  "llvm-readobj's LLVM style (ELFDumper's LLVMELFDumper): the file's summary, then as the options ask the sections (-S), the
  relocations (-r) and the symbols (--symbols), in the tool's order."
  [o opts]
  (let [has (fn [& ks] (some (set opts) ks))
        secs (:sections o)
        sname (fn [^long i] (cond (= i 0) "Undefined (0x0)" (= i 0xfff1) "Absolute (0xFFF1)" (= i 0xfff2) "Common (0xFFF2)"
                                  :else (str (:name (nth secs i)) " " (str "(" (hexu i) ")"))))]
    (concat
     ["" "File: <stdin>" (str "Format: " (:format *target*)) (str "Arch: " (:arch *target*)) "AddressSize: 64bit" "LoadName: <Not found>"]
     (when (has "-S" "--sections" "--section-headers")
       (concat ["Sections ["]
               (mapcat (fn [s]
                         (let [fl (long (:flags s)) set-fl (sort-by first (filter (fn [[_ v]] (= v (bit-and fl (long v)))) (shf-names)))]
                           (concat ["  Section {" (str "    Index: " (:index s)) (str "    Name: " (:name s) " (" (:name-off s) ")")
                                    (str "    Type: " (or (sht-names (:type s)) (str "Unknown")) " (" (hexu (:type s)) ")")
                                    (str "    Flags [ (" (hexu fl) ")")]
                                   (for [[nm v] set-fl] (str "      " nm " (" (hexu v) ")"))
                                   ["    ]" "    Address: 0x0" (str "    Offset: " (hexu (:offset s))) (str "    Size: " (:size s))
                                    (str "    Link: " (:link s)) (str "    Info: " (:info s)) (str "    AddressAlignment: " (:align s))
                                    (str "    EntrySize: " (:entsize s))]
                                   ;; --sd (judge-rest): the section's bytes, but a SHT_NOBITS one's (ELFDumper's printSectionHeaders)
                                   (when (and (has "--sd" "--section-data") (not= 8 (long (:type s))))
                                     (concat ["    SectionData (" ] (section-data-lines (:data s) 6) ["    )"]))
                                   ["  }"])))
                       secs)
               ["]"]))
     (when (has "-r" "--relocs" "--relocations") (view-readobj-r o))
     (when (has "--symbols" "--syms")
       (concat ["Symbols ["]
               (mapcat (fn [y]
                         (let [nm (if (= elf/STT_SECTION (:type y)) (:name (nth secs (:shndx y))) (:name y))
                               other (long (:other y))]
                           (concat ["  Symbol {" (str "    Name: " nm " (" (:name-off y) ")") (str "    Value: " (hexu (:value y)))
                                    (str "    Size: " (:size y))
                                    (str "    Binding: " (get {0 "Local" 1 "Global" 2 "Weak" 10 "Unique"} (:bind y) "Unknown") " (" (hexu (:bind y)) ")")
                                    (str "    Type: " (get {0 "None" 1 "Object" 2 "Function" 3 "Section" 4 "File" 5 "Common" 6 "TLS" 10 "GNU_IFunc"} (:type y) "Unknown")
                                         " (" (hexu (:type y)) ")")]
                                   (if (zero? other)
                                     ["    Other: 0"]
                                     (concat [(str "    Other [ (" (hexu other) ")")]
                                             (for [[n v] (sort-by first [["STV_INTERNAL" 1] ["STV_HIDDEN" 2] ["STV_PROTECTED" 3] ["STO_AARCH64_VARIANT_PCS" 0x80]])
                                                   :when (if (< (long v) 4) (= v (bit-and other 3)) (= v (bit-and other (long v))))]
                                               (str "      " n " (" (hexu v) ")"))
                                             ["    ]"]))
                                   [(str "    Section: " (sname (:shndx y))) "  }"])))
                       (:symbols o))
               ["]"])))))

(defn- sym-name [o y] (if (= elf/STT_SECTION (:type y)) (:name (nth (:sections o) (:shndx y))) (:name y)))

(defn view-objdump-t
  "llvm-objdump -t's symbol table (llvm-objdump.cpp's printSymbol): every symbol but the null one."
  [o]
  (concat
   ["" (str "<stdin>:	file format " (:format *target*)) "" "SYMBOL TABLE:"]
   (for [y (rest (:symbols o))
         :let [sh (long (:shndx y)) und (zero? sh) abs (= sh 0xfff1) com (= sh 0xfff2)
               weak (= 2 (:bind y)) t (:type y)
               gl (if (and (or (not und) abs) (not weak)) (if (= 0 (:bind y)) \l \g) \space)
               dbg (if (#{elf/STT_SECTION elf/STT_FILE} t) \d \space)
               ff (case (long t) 4 \f 2 \F (1 6 5) \O \space)
               sec (cond und "*UND*" abs "*ABS*" com "*COM*" :else (:name (nth (:sections o) sh)))
               vis (bit-and (long (:other y)) 3)]]
     (str (format "%016x" (:value y)) " " gl (if weak \w \space) "  " \space dbg ff " " sec "\t" (format "%016x" (:size y)) " "
          (case vis 2 ".hidden " 3 ".protected " 1 ".internal " "") (sym-name o y)))
   [""]))

(defn view-readelf-s
  "llvm-readelf -s's symbol table (ELFDumper's GNUELFDumper::printSymbol; the columns by PadToColumn)."
  [o]
  (let [syms (:symbols o)
        nonvis (some #(pos? (bit-and (long (:other %)) (bit-not 3))) syms)
        cols [0 8 25 31 39 46 (+ 56 (if nonvis 13 0)) (+ 59 (if nonvis 13 0))]
        line (fn [fields] (let [sb (StringBuilder.)]
                            (doseq [[c f] (map vector cols fields)]
                              (if (< (.length sb) (long c)) (dotimes [_ (- (long c) (.length sb))] (.append sb \space)) (when (pos? (.length sb)) (.append sb \space)))
                              (.append sb ^String f))
                            (str sb)))]
    (concat
     ["" (str "Symbol table '.symtab' contains " (count syms) " entries:")
      (str "   Num:    Value          Size Type    Bind   Vis" (if nonvis "                     " "      ") " Ndx Name")]
     (for [y syms :let [sh (long (:shndx y)) other (long (:other y))]]
       (line [(str (format "%6d" (:index y)) ":") (format "%016x" (:value y)) (format "%5d" (:size y))
              (get {0 "NOTYPE" 1 "OBJECT" 2 "FUNC" 3 "SECTION" 4 "FILE" 5 "COMMON" 6 "TLS" 10 "IFUNC"} (:type y) (str (:type y)))
              (get {0 "LOCAL" 1 "GLOBAL" 2 "WEAK" 10 "UNIQUE"} (:bind y) (str (:bind y)))
              (str (get ["DEFAULT" "INTERNAL" "HIDDEN" "PROTECTED"] (bit-and other 3))
                   (when (pos? (bit-and other 0x80))
                     (str " [VARIANT_PCS" (let [r (bit-and other (bit-not 0x83))] (when (pos? r) (str " | " (Long/toHexString r)))) "]")))
              (cond (zero? sh) "UND" (= sh 0xfff1) "ABS" (= sh 0xfff2) "COM" :else (str sh))
              (sym-name o y)])))))

(defn view-readelf-x
  "llvm-readelf --hex-dump=NAME's lines (ObjDumper's printSectionsAsHex): the address, four words of the bytes in order, the
  characters."
  [o ^String nm]
  (if-let [sec (first (filter #(= nm (:name %)) (:sections o)))]
    (let [^bytes d (:data sec) n (alength d)]
      (concat
       ["" (str "Hex dump of section '" nm "':")]
       (for [off (range 0 n 16)
             :let [bs (for [i (range off (min n (+ off 16)))] (bit-and (long (aget d i)) 0xff))
                   hx (str/join " " (map #(apply str (map (fn [b] (format "%02x" b)) %)) (partition-all 4 bs)))]]
         (str (format "0x%08x " off) hx (apply str (repeat (- 36 (count hx)) \space))
              (apply str (map #(if (<= 32 (long %) 126) (char %) \.) bs))))
       [""]))
    [(str "warning: '<stdin>': could not find section '" nm "'")]))

(defn- pad-line
  "Fields at their columns as formatted_raw_ostream's PadToColumn puts them (one blank when the line is already past it)."
  ^String [cols+fields]
  (let [sb (StringBuilder.)]
    (doseq [[c f] cols+fields]
      (if (< (.length sb) (long c)) (dotimes [_ (- (long c) (.length sb))] (.append sb \space)) (when (pos? (.length sb)) (.append sb \space)))
      (.append sb ^String f))
    (str sb)))

(defn- rjust ^String [^String s ^long w] (str (apply str (repeat (- w (count s)) \space)) s))

(defn- gnu-flags
  "getGNUFlags: the known flags' letters from the least significant bit, then o, p, x."
  ^String [^long fl]
  (let [known {0x1 "W" 0x2 "A" 0x4 "X" 0x10 "M" 0x20 "S" 0x40 "I" 0x80 "L" 0x100 "O" 0x200 "G" 0x400 "T" 0x800 "C"
               0x80000000 "E" 0x200000 "R"}
        known (merge known (:gnu-flags *target*))]
    (loop [f fl out "" os false pr false un false]
      (if (zero? f)
        (str out (when os "o") (when pr "p") (when un "x"))
        (let [b (bit-and f (- f)) f (- f b)]
          (cond (known b) (recur f (str out (known b)) os pr un)
                (pos? (bit-and b 0x0ff00000)) (recur (bit-and f (bit-not 0x0ff00000)) out true pr un)
                (pos? (bit-and b 0xf0000000)) (recur (bit-and f (bit-not 0xf0000000)) out os true un)
                :else (recur f out os pr true)))))))

(defn view-readelf-sections
  "llvm-readelf -S (GNUELFDumper::printSectionHeaders): the count and the table's offset, each section's row, the flags' key."
  [o]
  (let [secs (:sections o)
        cols [7 25 41 58 65 72]]
    (concat
     [(str "There are " (count secs) " section headers, starting at offset 0x" (Long/toHexString (long (get-in o [:header :shoff]))) ":")
      "" "Section Headers:"
      (pad-line (map vector [2 7 25 41 58 65 72 75 79 82 86] ["[Nr]" "Name" "Type" "Address" "Off" "Size" "ES" "Flg" "Lk" "Inf" "Al"]))]
     (for [s secs]
       (pad-line (concat [[2 (str "[" (rjust (str (:index s)) 2) "]")]]
                         (map vector cols [(:name s) (let [t (sht-names (:type s))] (if t (subs t 4) (str "0x" (Long/toHexString (:type s)) ": <unknown>")))
                                           (format "%016x" 0) (format "%06x" (:offset s)) (format "%06x" (:size s)) (format "%02x" (:entsize s))])
                         [[75 (rjust (gnu-flags (:flags s)) 3)] [79 (rjust (str (:link s)) 2)] [82 (rjust (str (:info s)) 3)] [86 (rjust (str (:align s)) 2)]])))
     ["Key to Flags:"
      "  W (write), A (alloc), X (execute), M (merge), S (strings), I (info),"
      "  L (link order), O (extra OS processing required), G (group), T (TLS),"
      "  C (compressed), x (unknown), o (OS specific), E (exclude),"
      "  R (retain), y (purecode), p (processor specific)"])))

(defn view-readelf-r
  "llvm-readelf -r (GNUELFDumper::printRelocations, printRelRelaReloc): each relocation section's header and rows."
  [o]
  (let [secs (:sections o) syms (:symbols o)
        rss (filter #(= elf/SHT_RELA (:type %)) secs)]
    (if (empty? rss)
      ["" "There are no relocations in this file."]
      (mapcat
       (fn [rs]
         (let [r (filter #(= (:target %) (:info rs)) (:relocs o))]
           (concat
            ["" (str "Relocation section '" (:name rs) "' at offset 0x" (Long/toHexString (:offset rs)) " contains " (count r) " entries:")
             "    Offset             Info             Type               Symbol's Value  Symbol's Name + Addend"]
            (for [x r :let [y (when (pos? (long (:sym x))) (nth syms (:sym x) nil))
                            nm (when y (sym-name o y))
                            a (long (:addend x))]]
              (str (pad-line [[0 (format "%016x" (:offset x))] [18 (format "%016x" (bit-or (bit-shift-left (long (:sym x)) 32) (long (:type x))))]
                              [35 (reloc-name (:type x))] [58 (if y (format "%016x" (:value y)) "")] [69 (or nm "")]])
                   (if (seq nm) (if (neg? a) (str " - " (Long/toHexString (- a))) (str " + " (Long/toHexString a))) (Long/toHexString a)))))))
       rss))))

(defn view-readelf
  "llvm-readelf's GNU style for -S, -r and -x NAME together, in the tool's order (the section headers, the relocations, the hex
  dumps)."
  [o ^String viewer]
  (let [ws (rest (str/split (str/trim viewer) #"\s+"))
        hex (concat (map second (re-seq #"--hex-dump=(\S+)" viewer)) (map second (re-seq #"(?:^|\s)-x\s+(\S+)" viewer)))]
    (concat (when (some #{"-S"} ws) (view-readelf-sections o))
            (when (some #{"-r"} ws) (view-readelf-r o))
            (mapcat #(view-readelf-x o %) hex))))

(defn view-readelf-arch
  "llvm-readelf --arch-specific's AArch64 build attributes (ELFAttributeParser's AArch64 printing): the format version, each
  subsection's length, vendor, optionality, type and attributes, the known tags by name."
  [o]
  (let [sec (first (filter #(= 0x70000003 (:type %)) (:sections o)))]
    (if-not sec
      ["BuildAttributes {" "}"]
      (let [^bytes d (:data sec) n (alength d)
            u8 (fn [^long i] (bit-and (long (aget d i)) 0xff))
            uleb (fn [^long i] (loop [i i v 0 sh 0] (let [b (u8 i) v (bit-or v (bit-shift-left (bit-and b 0x7f) sh))]
                                                    (if (bit-test b 7) (recur (inc i) v (+ sh 7)) [v (inc i)]))))
            cstr (fn [^long i] (let [e (loop [j i] (if (zero? (u8 j)) j (recur (inc j))))] [(String. d (int i) (int (- e i)) "ISO-8859-1") (inc e)]))
            tags {"aeabi_feature_and_bits" {0 "Tag_Feature_BTI" 1 "Tag_Feature_PAC" 2 "Tag_Feature_GCS"}
                  "aeabi_pauthabi" {1 "Tag_PAuth_Platform" 2 "Tag_PAuth_Schema"}}]
        (concat
         ["BuildAttributes {" (str "FormatVersion: 0x" (Long/toHexString (u8 0)))]
         (loop [i 1 k 1 out []]
           (if (>= i n)
             out
             (let [len (reduce (fn [a j] (bit-or a (bit-shift-left (u8 (+ i j)) (* 8 j)))) 0 (range 4))
                   end (+ i len)
                   [vn j] (cstr (+ i 4)) opt (u8 j) typ (u8 (inc j))
                   attrs (loop [j (+ j 2) out []]
                           (if (>= j end) out
                               (let [[t j] (uleb j) [v j] (if (zero? typ) (uleb j) (cstr j))]
                                 (recur (long j) (conj out (str "      " (get-in tags [vn t] t) ": " v))))))]
               (recur (long end) (inc k)
                      (into out (concat [(str "  Section " k " {") (str "    SectionLength: " len)
                                         (str "    VendorName: " vn " Optionality: " (if (zero? opt) "required" "optional")
                                              " Type: " (if (zero? typ) "uleb128" "ntbs"))
                                         "    Attributes {"]
                                        attrs ["    }" "  }"]))))))
         ["}"])))))

(defn view-objdump-d
  "llvm-objdump -d's lines without the instructions' text: each section with code, its symbols' labels, each word (or the
  data's bytes under $d), and with `relocs?` the relocations after the word they fall in; with `all?` (-D, judge-rest) every
  allocated section with bytes, not those with code alone."
  ([o relocs?] (view-objdump-d o relocs? false))
  ([o relocs? all?]
  (let [secs (:sections o) syms (:symbols o)]
    (concat
     [(str "<stdin>:\tfile format elf64-littleaarch64")]
     (mapcat
      (fn [s]
        (let [i (:index s) ^bytes d (:data s)
              in-sec (filter #(and (= (:shndx %) i) (not= elf/STT_SECTION (:type %)) (not= elf/STT_FILE (:type %))) syms)
              maps (sort-by :value (filter #(re-matches #"\$[xd](\..*)?" (:name %)) in-sec))
              labels (into (sorted-map) (for [x in-sec :when (not (re-matches #"\$[xd](\..*)?" (:name x)))] [(:value x) (:name x)]))
              labels (if (empty? labels) {0 (:name s)} labels)
              data-at? (fn [^long off] (let [m (last (filter #(<= (long (:value %)) off) maps))] (and m (str/starts-with? (:name m) "$d"))))
              rs (filter #(= (:target %) i) (:relocs o))
              n (alength d)]
          (concat
           ["" (str "Disassembly of section " (:name s) ":")]
           (loop [off 0 out []]
             (if (>= off n)
               out
               (let [lab (when-let [l (get labels off)] ["" (format "%016x <%s>:" off l)])
                     k (min 4 (- n off))
                     bs (for [j (range k)] (bit-and (long (aget d (+ off j))) 0xff))
                     line (if (or (data-at? off) (< k 4))
                            (format "%8x: %s" off (str/join " " (map #(format "%02x" %) bs)))
                            (format "%8x: %08x" off (reduce (fn [a [j b]] (bit-or a (bit-shift-left (long b) (* 8 j)))) 0 (map-indexed vector bs))))
                     rl (when relocs?
                          (for [r rs :when (<= off (long (:offset r)) (+ off 3)) :let [[nm a] (value-text o r)]]
                            (format "\t\t%016x:  %s\t%s" (:offset r) (reloc-name (:type r))
                                    (str nm (cond (pos? a) (str "+0x" (Long/toHexString a)) (neg? a) (str "-0x" (Long/toHexString (- a))) :else "")))))]
                 (recur (+ off k) (-> out (into lab) (conj line) (into rl)))))))))
      (filter #(and (pos? (bit-and (long (:flags %)) (if all? elf/SHF_ALLOC elf/SHF_EXECINSTR))) (not= 8 (long (:type %)))
                    (:data %) (pos? (alength ^bytes (:data %)))) secs))))))

;; ---------------------------------------------------------------------------------------------------------------------
;; llvm-dwarfdump's call frame view (judge-rest: --debug-frame and its alias -eh-frame), written again from llvm-project 23.1.5
;; (Apache-2.0 WITH LLVM-exception): DWARFContext.cpp (dump's section headers, a section's relocations applied by
;; RelocationResolver.cpp's resolveAArch64), DWARFDebugFrame.cpp (parse, CIE::dump, FDE::dump, createUnwindTable),
;; LowLevel/DWARFDataExtractorSimple.h (getEncodedPointer), LowLevel/DWARFCFIProgram.{h,cpp} (the program's parse and its operands'
;; types), DWARFCFIPrinter.cpp, LowLevel/DWARFUnwindTable.cpp (parseRows), DWARFUnwindTablePrinter.cpp, Dwarf.def and Dwarf.cpp
;; (CallFrameString for AArch64), FormatProviders.h (formatv's styles); the registers named as llvm-dwarfdump names them
;; (MCRegisterInfo's getLLVMRegNum and getName: TableGen's RegisterInfoEmitter maps a DWARF number back to the register that
;; states it in AArch64RegisterInfo.td's DwarfRegNum, before the DwarfRegAlias ones take theirs)

(def ^:private dwarf-reg-names
  (merge (into {} (for [i (range 31)] [i (str "W" i)])) {31 "WSP" 46 "VG" 47 "FFR"}
         (into {} (for [i (range 16)] [(+ 48 i) (str "PN" i)]))
         (into {} (for [i (range 32)] [(+ 64 i) (str "B" i)]))
         (into {} (for [i (range 32)] [(+ 96 i) (str "Z" i)]))))

(defn- dwarf-reg-name ^String [^long r] (get dwarf-reg-names r (str "reg" r)))

(defn- hex-min
  "formatv's `{0:x-N}` (and fmt_align's right-aligned zeros): lower hex, no prefix, N digits at least."
  ^String [^long v ^long w]
  (let [s (Long/toHexString v)] (if (< (count s) w) (str (apply str (repeat (- w (count s)) \0)) s) s)))

;; CallFrameString for AArch64 (Dwarf.def's DW_CFA_*: 0x2d is DW_CFA_AARCH64_negate_ra_state there, 0x2e's name is x86's alone)
(def ^:private cfa-names
  {0x00 "nop" 0x40 "advance_loc" 0x80 "offset" 0xc0 "restore" 0x01 "set_loc" 0x02 "advance_loc1" 0x03 "advance_loc2"
   0x04 "advance_loc4" 0x05 "offset_extended" 0x06 "restore_extended" 0x07 "undefined" 0x08 "same_value" 0x09 "register"
   0x0a "remember_state" 0x0b "restore_state" 0x0c "def_cfa" 0x0d "def_cfa_register" 0x0e "def_cfa_offset"
   0x0f "def_cfa_expression" 0x10 "expression" 0x11 "offset_extended_sf" 0x12 "def_cfa_sf" 0x13 "def_cfa_offset_sf"
   0x14 "val_offset" 0x15 "val_offset_sf" 0x16 "val_expression" 0x2c "AARCH64_negate_ra_state_with_pc"
   0x2d "AARCH64_negate_ra_state" 0x30 "LLVM_def_aspace_cfa" 0x31 "LLVM_def_aspace_cfa_sf"})

;; CFIProgram::getOperandTypes: :address OT_Address, :code OT_FactoredCodeOffset, :offset OT_Offset, :sdata OT_SignedFactDataOffset,
;; :udata OT_UnsignedFactDataOffset, :reg OT_Register, :as OT_AddressSpace
(def ^:private cfa-operands
  {0x01 [:address] 0x40 [:code] 0x02 [:code] 0x03 [:code] 0x04 [:code] 0x0c [:reg :offset] 0x12 [:reg :sdata] 0x0d [:reg]
   0x30 [:reg :offset :as] 0x31 [:reg :sdata :as] 0x0e [:offset] 0x13 [:sdata] 0x07 [:reg] 0x08 [:reg] 0x80 [:reg :udata]
   0x05 [:reg :udata] 0x11 [:reg :sdata] 0x14 [:reg :udata] 0x15 [:reg :sdata] 0x09 [:reg :reg] 0xc0 [:reg] 0x06 [:reg]
   0x2e [:offset]})

(defn- frame-relocs
  "The relocations of the section at index `i` as DWARFContext records them for a DWARF section: offset -> its value
  (resolveAArch64 over the symbol's value, the addend and the place; a type it does not support left out, the data as it is;
  the last at an offset its value, AArch64's resolver ignoring the data)."
  [o ^long i]
  (into {} (for [r (:relocs o) :when (= i (long (:target r)))
                 :let [y (when (pos? (long (:sym r))) (nth (:symbols o) (:sym r) nil))
                       s (long (if y (:value y) 0)) a (long (:addend r)) p (long (:offset r)) sa (unchecked-add s a)
                       v (case (long (:type r))
                           (257 1029) sa
                           258 (bit-and sa 0xffffffff)
                           260 (unchecked-subtract sa p)
                           261 (bit-and (unchecked-subtract sa p) 0xffffffff)
                           262 (bit-and (unchecked-subtract sa p) 0xffff)
                           nil)]
                 :when v]
             [p v])))

(defn- parse-frames
  "DWARFDebugFrame::parse over the section's bytes `d` (`rel` its relocations, `eh?` .eh_frame's format): its entries ({:cie? ...}),
  or :error when the parse fails (llvm-dwarfdump reports it and dumps no entry). Throws ::unbuilt on what this view does not
  print (DWARF64, a DWARF expression)."
  [^bytes d rel eh?]
  (let [n (alength d)
        pos (volatile! 0)
        bad (fn [] (throw (ex-info "frame parse" {::parse true})))
        u (fn [^long off ^long size]
            (when (> (+ off size) n) (bad))
            (loop [i 0 v 0] (if (= i size) v (recur (inc i) (bit-or v (bit-shift-left (bit-and (long (aget d (+ off i))) 0xff) (* 8 i)))))))
        take! (fn [^long size] (let [p (long @pos) v (u p size)] (vreset! pos (+ p size)) v))
        ;; getRelocatedValue: the data, or the relocation's value at its offset
        rtake! (fn [^long size] (let [p (long @pos) v (u p size)] (vreset! pos (+ p size)) (long (get rel p v))))
        uleb! (fn [] (loop [v 0 sh 0] (let [b (take! 1) v (if (< sh 64) (bit-or v (bit-shift-left (bit-and b 0x7f) sh)) v)]
                                             (if (bit-test b 7) (recur v (+ sh 7)) v))))
        sleb! (fn [] (loop [v 0 sh 0] (let [b (take! 1) v (if (< sh 64) (bit-or v (bit-shift-left (bit-and b 0x7f) sh)) v) sh (+ sh 7)]
                                             (cond (bit-test b 7) (recur v sh)
                                                   (and (< sh 64) (bit-test b 6)) (bit-or v (bit-shift-left -1 sh))
                                                   :else v))))
        cstr! (fn [] (let [p (long @pos) e (loop [j p] (cond (>= j n) (bad) (zero? (aget d j)) j :else (recur (inc j))))]
                       (vreset! pos (inc e)) (String. d (int p) (int (- e p)) "ISO-8859-1")))
        ;; getEncodedPointer: the value by the encoding's low nibble, PC-relative ones plus `base`; nil when not decoded
        enc-ptr! (fn [^long enc ^long base]
                   (when-not (= enc 0xff)
                     (let [old @pos
                           v (case (bit-and enc 0x0f)
                               0x00 (take! 8) 0x01 (uleb!) 0x09 (sleb!) 0x02 (take! 2) 0x03 (take! 4) 0x04 (take! 8)
                               0x0a (let [x (take! 2)] (if (bit-test x 15) (- x 0x10000) x))
                               0x0b (long (unchecked-int (rtake! 4)))
                               0x0c (rtake! 8)
                               nil)]
                       (when v (case (bit-and enc 0x70) 0x00 v 0x10 (unchecked-add (long v) base) (do (vreset! pos old) nil))))))
        cfis! (fn [^long end]
                (loop [out []]
                  (if (>= (long @pos) end)
                    out
                    (let [op (rtake! 1) prim (bit-and op 0xc0)]
                      (if (pos? prim)
                        (recur (conj out {:op prim :ops (if (= prim 0x80) [(bit-and op 0x3f) (uleb!)] [(bit-and op 0x3f)])}))
                        (recur (conj out {:op op
                                          :ops (case (int op)
                                                 (0x00 0x0a 0x0b 0x2d 0x2c) []
                                                 0x01 [(rtake! 8)]
                                                 0x02 [(rtake! 1)] 0x03 [(rtake! 2)] 0x04 [(rtake! 4)]
                                                 (0x06 0x07 0x08 0x0d 0x0e 0x2e) [(uleb!)]
                                                 0x13 [(sleb!)]
                                                 0x30 [(uleb!) (uleb!) (uleb!)]
                                                 0x31 [(uleb!) (sleb!) (uleb!)]
                                                 (0x05 0x09 0x0c 0x14) [(uleb!) (uleb!)]
                                                 (0x11 0x12 0x15) [(uleb!) (sleb!)]
                                                 ;; a DWARF expression's operations (DWARFExpressionPrinter): not printed by this view
                                                 (0x0f 0x10 0x16) (throw (ex-info "DWARF expression" {::unbuilt true}))
                                                 (bad))})))))))]
    (try
      (loop [entries [] cies {}]
        (if (>= (long @pos) n)
          entries
          (let [start (long @pos)
                ;; getInitialLength: too short or reserved, {0, DWARF32} and the offset left: a terminator
                len (if (> (+ start 4) n) 0 (let [l (u start 4)] (if (>= l 0xfffffff0) (if (= l 0xffffffff) (throw (ex-info "DWARF64" {::unbuilt true})) 0) (do (vreset! pos (+ start 4)) (long (get rel start l))))))]
            (if (zero? len)
              (conj entries {:cie? true :offset start :length 0 :version 0 :aug "" :code 0 :data 0 :ra 0 :aug-data [] :cfis []})
              (let [sstart (long @pos) end (+ sstart len)
                    id (rtake! 4)
                    e (if (= id (if eh? 0 0xffffffff))
                        (let [version (take! 1) aug (cstr!) asize (if (< version 4) 8 (take! 1)) seg (if (< version 4) 0 (take! 1))
                              code (uleb!) data (sleb!) ra (if (= version 1) (take! 1) (uleb!))
                              st (volatile! {:fde-enc 0 :lsda-enc 0xff})]
                          (when eh?
                            (doseq [[i ch] (map-indexed vector aug)]
                              (case ch
                                \L (vswap! st assoc :lsda-enc (take! 1))
                                \P (do (when (:personality @st) (bad))
                                       (let [pe (take! 1)] (vswap! st assoc :personality (enc-ptr! pe 0))))
                                \R (vswap! st assoc :fde-enc (take! 1))
                                (\S \B \G) nil
                                \z (do (when (pos? (long i)) (bad))
                                       (let [l (uleb!)] (vswap! st assoc :aug-start (long @pos) :aug-end (+ (long @pos) l))))
                                (bad)))
                            (when-let [ae (:aug-end @st)] (when-not (= ae @pos) (bad))))
                          (merge {:cie? true :offset start :length len :version version :aug aug :addr-size asize :seg-size seg
                                  :code code :data data :ra ra
                                  :aug-data (if-let [as (:aug-start @st)] (vec (for [j (range as (min n (long (:aug-end @st))))] (bit-and (long (aget d j)) 0xff))) [])}
                                 @st))
                        (let [cie (get cies (if eh? (unchecked-subtract sstart id) id))]
                          (if eh?
                            (do (when-not cie (bad))
                                (let [init (or (enc-ptr! (:fde-enc cie) (long @pos)) 0) rng (or (enc-ptr! (:fde-enc cie) 0) 0)
                                      lsda (when (seq (:aug cie))
                                             (let [l (uleb!) ae (+ (long @pos) l)
                                                   x (when-not (= 0xff (long (:lsda-enc cie))) (enc-ptr! (:lsda-enc cie) 0))]
                                               (when-not (= ae @pos) (bad))
                                               x))]
                                  {:offset start :length len :cie-ptr id :init init :range rng :cie cie :lsda lsda}))
                            (let [init (rtake! 8) rng (rtake! 8)] {:offset start :length len :cie-ptr id :init init :range rng :cie cie}))))
                    e (assoc e :cfis (cfis! end))]
                (when-not (= end @pos) (bad))
                (recur (conj entries e) (if (:cie? e) (assoc cies start e) cies)))))))
      (catch arbace.lang.ExceptionInfo ex (if (::parse (ex-data ex)) :error (throw ex))))))

(defn- cfi-program-lines
  "printCFIProgram: each instruction's name and operands (the advances' addresses from `addr`, an FDE's initial location)."
  [cfis ^long code ^long data addr]
  (let [at (volatile! addr)]
    (mapv (fn [{:keys [op ops]}]
            (str "  " (if-let [nm (cfa-names op)] (str "DW_CFA_" nm) "") ":"
                 (apply str (map (fn [t v]
                                   (let [v (long v)]
                                   (case t
                                     :address (do (vreset! at v) (str " " (Long/toHexString v)))
                                     :offset (if (neg? v) (str " " v) (str " +" v))
                                     :code (if (zero? code)
                                             (str " " v "*code_alignment_factor")
                                             (let [x (unchecked-multiply v code)]
                                               (str " " x (when @at (str " to 0x" (Long/toHexString (vswap! at #(unchecked-add (long %) x))))))))
                                     (:sdata :udata) (if (zero? data) (str " " v "*data_alignment_factor") (str " " (unchecked-multiply v data)))
                                     :reg (str " " (dwarf-reg-name v))
                                     :as (str " in addrspace" (Long/toUnsignedString v)))))
                                 (cfa-operands op) ops))))
          cfis)))

(defn- unwind-rows
  "parseRows: the rows the program `cfis` makes from `row` ({:addr :cfa LOC :regs {REG LOC}}, a LOC {:kind :reg :off :as :deref}),
  [ROWS ROW]; throws ::rows on the errors createUnwindTable reports (no row printed then). `init` the CIE's register rules (nil
  for a CIE's own program)."
  [cfis code data row init]
  (let [code (long code) data (long data)
        err (fn [] (throw (ex-info "rows" {::rows true})))
        fact (fn [v] (if (zero? data) (err) (long (unchecked-int (unchecked-multiply (long v) data)))))]
    (loop [is cfis row row rows [] states []]
      (if (empty? is)
        [rows row]
        (let [{:keys [op ops]} (first is) [a b c] ops
              reg! (fn [r l] (assoc-in row [:regs r] l))
              [row rows states]
              (case (int op)
                0x01 (do (when (<= (Long/compareUnsigned (long a) (long (or (:addr row) 0))) 0) (err))
                         [(assoc row :addr a) (conj rows row) states])
                ;; (a CIE's row has no address: LLVM's slideAddress leaves it so)
                (0x40 0x02 0x03 0x04) (let [x (if (zero? code) (err) (unchecked-multiply (long a) code))]
                                        [(if (:addr row) (update row :addr #(unchecked-add (long %) (long x))) row) (conj rows row) states])
                (0xc0 0x06) (do (when (nil? init) (err))
                                [(if-let [l (get init a)] (reg! a l) (update row :regs dissoc a)) rows states])
                (0x80 0x05 0x11) [(reg! a {:kind :cfa :off (fact b) :deref true}) rows states]
                (0x00 0x2e) [row rows states]
                0x0a [row rows (conj states [(:cfa row) (:regs row)])]
                0x0b (if (empty? states) (err) (let [[cfa regs] (peek states)] [(assoc row :cfa cfa :regs regs) rows (pop states)]))
                0x2d (let [l (get-in row [:regs 34])]
                       (cond (nil? l) [(reg! 34 {:kind :const :off 1}) rows states]
                             (= :const (:kind l)) [(reg! 34 (update l :off #(bit-xor (long %) 1))) rows states]
                             :else (err)))
                ;; (the toggled rule is a copy LLVM does not store back: the row keeps its rule)
                0x2c (let [l (get-in row [:regs 34])]
                       (cond (nil? l) [(reg! 34 {:kind :const :off 3}) rows states]
                             (= :const (:kind l)) [row rows states]
                             :else (err)))
                0x07 [(reg! a {:kind :undefined}) rows states]
                0x08 [(reg! a {:kind :same}) rows states]
                0x09 [(reg! a {:kind :reg :reg b :off 0}) rows states]
                (0x14 0x15) [(reg! a {:kind :cfa :off (fact b)}) rows states]
                0x0d [(assoc row :cfa (if (= :reg (:kind (:cfa row))) (assoc (:cfa row) :reg a) {:kind :reg :reg a :off 0})) rows states]
                0x0e (if (= :reg (:kind (:cfa row))) [(assoc-in row [:cfa :off] (long (unchecked-int (long a)))) rows states] (err))
                0x13 (if (= :reg (:kind (:cfa row))) [(assoc-in row [:cfa :off] (fact a)) rows states] (err))
                0x0c [(assoc row :cfa {:kind :reg :reg a :off (long (unchecked-int (long b)))}) rows states]
                0x12 [(assoc row :cfa {:kind :reg :reg a :off (fact b)}) rows states]
                0x30 [(assoc row :cfa {:kind :reg :reg a :off (long (unchecked-int (long b))) :as c}) rows states]
                0x31 [(assoc row :cfa {:kind :reg :reg a :off (fact b) :as c}) rows states])]
          (recur (rest is) row rows states))))))

(defn- loc-text
  "printUnwindLocation."
  ^String [{:keys [kind reg off as deref]}]
  (let [off (long (or off 0))
        s (case kind
            :unspecified "unspecified" :undefined "undefined" :same "same"
            :cfa (str "CFA" (cond (zero? off) "" (pos? off) (str "+" off) :else off))
            :reg (str (dwarf-reg-name reg) (when-not (and (zero? off) (nil? as)) (str (when (>= off 0) "+") off (when as (str " in addrspace" as)))))
            :const (str off))]
    (if deref (str "[" s "]") s)))

(defn- unwind-table-lines
  "createUnwindTable (an FDE's when `fde` is given, else the CIE's) printed by printUnwindTable; none on its errors."
  [cie fde]
  (let [{:keys [code data]} cie]
    (try
      (let [rows (cond
                   (nil? cie) (throw (ex-info "no CIE" {::rows true}))
                   (and (empty? (:cfis cie)) (or (nil? fde) (empty? (:cfis fde)))) []
                   :else (let [[crows row] (unwind-rows (:cfis cie) code data {:addr (:init fde) :cfa {:kind :unspecified} :regs (sorted-map)} nil)
                               [frows row] (if fde (unwind-rows (:cfis fde) code data row (:regs row)) [[] row])]
                           (cond-> (into crows frows)
                             (or (seq (:regs row)) (not= :unspecified (:kind (:cfa row)))) (conj row))))]
        (vec (for [r rows]
               (str "  " (when (:addr r) (str "0x" (Long/toHexString (:addr r)) ": ")) "CFA=" (loc-text (:cfa r))
                    (when (seq (:regs r)) (str ": " (str/join ", " (for [[g l] (:regs r)] (str (dwarf-reg-name g) "=" (loc-text l))))))))))
      (catch arbace.lang.ExceptionInfo ex (if (::rows (ex-data ex)) [] (throw ex))))))

(defn- frame-entry-lines
  "CIE::dump and FDE::dump."
  [e eh?]
  (if (:cie? e)
    (if (and eh? (zero? (long (:length e))))
      [(str (hex-min (:offset e) 8) " ZERO terminator")]
      (concat
       [(str (hex-min (:offset e) 8) " " (hex-min (:length e) 8) " " (hex-min (if eh? 0 0xffffffff) 8) " CIE")
        "  Format:                DWARF32"]
       (when (and eh? (not= 1 (long (:version e)))) ["WARNING: unsupported CIE version"])
       [(str "  Version:               " (:version e)) (str "  Augmentation:          \"" (:aug e) "\"")]
       (when (>= (long (:version e)) 4) [(str "  Address size:          " (:addr-size e)) (str "  Segment desc size:     " (:seg-size e))])
       [(str "  Code alignment factor: " (bit-and (long (:code e)) 0xffffffff)) (str "  Data alignment factor: " (unchecked-int (:data e)))
        (str "  Return address column: " (unchecked-int (:ra e)))]
       (when (:personality e) [(str "  Personality Address: " (hex-min (:personality e) 16))])
       (when (seq (:aug-data e)) [(str "  Augmentation data:    " (apply str (map #(format " %02X" %) (:aug-data e))))])
       [""] (cfi-program-lines (:cfis e) (:code e) (:data e) nil) [""] (unwind-table-lines e nil) [""]))
    (let [cie (:cie e) code (long (or (:code cie) 0)) data (long (or (:data cie) 0))]
      (concat
       [(str (hex-min (:offset e) 8) " " (hex-min (:length e) 8) " " (hex-min (:cie-ptr e) 8) " FDE cie="
             (if cie (hex-min (:offset cie) 8) "<invalid offset>")
             " pc=" (hex-min (:init e) 8) "..." (hex-min (unchecked-add (long (:init e)) (long (:range e))) 8))
        "  Format:       DWARF32"]
       (when (:lsda e) [(str "  LSDA Address: " (hex-min (:lsda e) 16))])
       (cfi-program-lines (:cfis e) code data (:init e)) [""] (unwind-table-lines cie e) [""]))))

(defn view-dwarfdump-frames
  "llvm-dwarfdump --debug-frame (-eh-frame, its alias) of an AArch64 object: the file's line, then .debug_frame's and .eh_frame's
  dumps (each requested, so each headed even when absent), every CIE and FDE with its fields, its program and its unwind table.
  nil when the object holds what this view does not print (a DWARF expression, DWARF64, a frame section twice or compressed)."
  [o]
  (try
    (let [frame (fn [nm eh?]
                  (let [ss (filter #(and (= nm (str/replace (:name %) #"^[._]+" "")) (not= elf/SHT_NOBITS (:type %))) (:sections o))]
                    (when (or (> (count ss) 1) (some #(pos? (bit-and (long (:flags %)) 0x800)) ss))
                      (throw (ex-info "frame section" {::unbuilt true})))
                    (let [s (first ss)
                          es (if s (parse-frames (:data s) (frame-relocs o (:index s)) eh?) [])]
                      (concat ["" (str "." nm " contents:")]
                              (when-not (= :error es) (cons "" (mapcat #(frame-entry-lines % eh?) es)))))))]
      (when (= "aarch64" (:arch *target*))
        (vec (concat [(str "-:\tfile format " (:format *target*))] (frame "debug_frame" false) (frame "eh_frame" true)))))
    (catch arbace.lang.ExceptionInfo ex (if (::unbuilt (ex-data ex)) nil (throw ex)))))

;; ---------------------------------------------------------------------------------------------------------------------
;; the CHECK lines

(defn check-lines
  "The CHECK lines of `prefixes`: [[LINE KIND CONTENT]] in order, KIND \"\" or -NEXT, -SAME, -NOT, -EMPTY, -LABEL, -DAG."
  [^String src prefixes]
  (let [alt (str/join "|" (map #(java.util.regex.Pattern/quote %) prefixes))
        re (re-pattern (str "(?:^|[^A-Za-z0-9_-])(" alt ")(-NEXT|-SAME|-NOT|-EMPTY|-LABEL|-DAG|-COUNT-\\d+)?:(.*)$"))]
    (vec (keep-indexed (fn [i l] (when-let [[_ _ k c] (re-find re l)] [(inc i) (or k "") c])) (str/split-lines src)))))

(def ^:private hex-line #"^\s*(?:([0-9a-f]+):\s+([0-9a-f]{8}|[0-9a-f]{2}(?: [0-9a-f]{2}){0,3})|([0-9a-f]{8}|[0-9a-f]{2}(?: [0-9a-f]{2}){1,3}))(?=\s|$)")

(defn bytes-only
  "A disassembly's CHECK content held to its stated bytes alone: the offset and word (or data bytes) as the view prints them,
  the content as it is when it is not an instruction's line (a label, a relocation, a header), nil when it states only text."
  [^String c]
  (let [t (str/trim c)]
    (cond (or (re-find #"R_AARCH64_|<.*>:|Disassembly of section|file format" t) (= t "")) c
          ;; judge-rest: an offset a string variable defines or uses (`[[addr:[0-9a-f]+]]: 91000062 add ...`): the variable and the
          ;; word, the text dropped
          (re-find #"^\[\[[A-Za-z_][A-Za-z0-9_]*(?::.*?)?\]\]:\s+(?:[0-9a-f]{8}|[0-9a-f]{2}(?: [0-9a-f]{2}){1,3})(?=\s|$)" t)
          (re-find #"^\[\[[A-Za-z_][A-Za-z0-9_]*(?::.*?)?\]\]:\s+(?:[0-9a-f]{8}|[0-9a-f]{2}(?: [0-9a-f]{2}){1,3})(?=\s|$)" t)
          (re-find #"\{\{|\[\[" (or (second (re-find #"^(\S+)" t)) "")) nil
          ;; a bare word (8 digits) or two bytes at least: a mnemonic spelled in hex digits (`dc`, `add`) is not one
          :else (when-let [[_ off h h2] (re-find hex-line t)]
                  (if off (str off ": " h) h2)))))

;; ---------------------------------------------------------------------------------------------------------------------
;; the stated encodings (judge-rest, the user's goal of 2026-11-20: the object check judged by the test's own words). Many object
;; tests also state each instruction's bytes in a -show-encoding run (`// CHECK-ENCODING: encoding: [0x00,0x20,0x78,0xd5]`):
;; llvm-mc prints there the bytes its object writer emits, so the words of the test's object, in the run's order, are the stated
;; ones. Each such line is a case: held to the code sections' words of Arbace's object as FileCheck holds the run's output (in
;; order, each after the one before), a fixup's bits (the encoding's letters, `0bAAA00010`, `A`) any value

(defn show-runs
  "A test's -show-encoding runs: the RUN lines whose first command is llvm-mc with -show-encoding for an ELF triple, not an
  error run (`not llvm-mc`), an object run or a disassembly, piped to FileCheck: [{:prefixes [...]}]."
  [^String src]
  (vec (for [r (run-lines src)
             :let [pieces (mapv str/trim (str/split r #"\|"))
                   mc (first pieces)
                   triple (second (re-find #"-m?triple[= ]*(\S+)" mc))
                   fc (first (filter #(re-find #"FileCheck" %) pieces))]
             :when (and (re-find #"^llvm-mc\b" mc) (re-find #"(^|\s)--?show-encoding\b" mc)
                        (not (re-find #"filetype[= ]obj" mc)) (not (re-find #"(^|\s)--?disassemble\b" mc))
                        (elf-triple? triple) fc)]
         {:prefixes (prefixes-of fc)})))

(defn enc-bytes
  "A stated encoding's text `0x1f,0bAAA10000,A,0xd5` as [[MASK VALUE] ...], a byte's letters its fixup's bits (mask 0), `0x0b'A'`
  its stated bits set; nil when a byte is spelled otherwise."
  [^String s]
  (let [bs (mapv str/trim (str/split s #","))
        one (fn [^String b]
              (cond (re-matches #"0x[0-9a-fA-F]{1,2}" b) [0xff (Long/parseLong (subs b 2) 16)]
                    (re-matches #"0b[01A-Za-z]{8}" b)
                    (reduce (fn [[m v] ch] (case ch \0 [(inc (* 2 m)) (* 2 v)] \1 [(inc (* 2 m)) (inc (* 2 v))] [(* 2 m) (* 2 v)]))
                            [0 0] (subs b 2))
                    (re-matches #"[A-Za-z]" b) [0 0]
                    ;; `0x0b'A'`: a byte some of whose bits a fixup fills (MCAsmStreamer's AddEncodingComment), the stated bits set
                    ;; in the object (the fixup's field is zero in the stated value and ORed in)
                    (re-matches #"0x[0-9a-fA-F]{1,2}'[A-Za-z]'" b) (let [v (Long/parseLong (subs b 2 (.indexOf b "'")) 16)] [v v])
                    :else nil))
        r (mapv one bs)]
    (when (every? some? r) r)))

(defn- code-words
  "The object's code: every 4-byte word of its executable sections, in section order, each [B0 B1 B2 B3]."
  [o]
  (vec (for [s (:sections o) :when (pos? (bit-and (long (:flags s)) elf/SHF_EXECINSTR))
             :let [^bytes d (:data s)] :when d
             off (range 0 (- (alength d) 3) 4)]
         (mapv #(bit-and (long (aget d (+ (long off) (long %)))) 0xff) (range 4)))))

(defn judge-encodings
  "The stated encodings of the test's -show-encoding runs against the object `r` (arbace.asm.arm64.obj/assemble's result):
  [[LINE RESULT]], one a line (a line several runs state is met when every one of them meets it). Each run's lines in order, each
  found among the code words after the one the line before matched (FileCheck's order; -NOT and -DAG lines not encodings' cases);
  a line not found :fail, the search going on from the same place."
  [^String src r]
  (let [rs (show-runs src)
        lines-of (fn [run] (vec (for [[l k c] (check-lines src (:prefixes run))
                                      :when (not (#{"-NOT" "-DAG"} k))
                                      ;; (an empty encoding, `.tlsdesccall var // encoding: []`, states no word: no case)
                                      :let [[_ e] (re-find #"encoding:\s*\[([^\]]*)\]" c)] :when (and e (not (str/blank? e)))]
                                  [l (enc-bytes e)])))
        per-run (mapv lines-of rs)
        stated (into (sorted-set) (map first (apply concat per-run)))]
    (cond
      (empty? stated) []
      (not (:bytes r)) (mapv (fn [l] [l (if (:error r) :object-error (keyword (str "unsupported-" (name (or (:unsupported r) :crash)))))]) stated)
      :else
      (let [ws (code-words (elf/read-object (:bytes r)))
            hit? (fn [w enc] (and (= (count enc) 4) (every? (fn [[b [m v]]] (= (bit-and (long b) (long m)) (long v))) (map vector w enc))))
            judged (for [ls per-run]
                     (loop [ls ls pos 0 out {}]
                       (if (empty? ls)
                         out
                         (let [[l enc] (first ls)
                               i (when enc (first (filter #(hit? (nth ws %) enc) (range pos (count ws)))))]
                           (recur (rest ls) (if i (inc (long i)) pos)
                                  (assoc out l (cond (nil? enc) :enc-spelling i :pass :else :fail)))))))
            worst (fn [a b] (cond (nil? a) b (= a :pass) b :else a))]
        (vec (for [l stated] [l (reduce worst nil (keep #(get % l) judged))]))))))

;; ---------------------------------------------------------------------------------------------------------------------
;; the disassembly's stated text (judge-rest, the coordinator's round of 2026-11-20): a disassembly's line that states an instruction's
;; text alone (`CHECK: mov x0, #1311673391471656960`, llvm-objdump -d's mnemonic and operands) was the decoder's, AR3, and beside. arm64
;; has no disassembler of Arbace's (AR3 is not built: a64i's decoder gives its own instructions, not llvm-objdump's text), so the line
;; is held to the object the other way: its text read by Arbace's reader (AR1) and encoded by Arbace's encoder
;; (arbace.repr.asm.arm64.lenc: Go's arm64asm table, then LLVM's records) gives a word, which must be among the code words of Arbace's
;; object in the run's order, as the stated encodings are (judge-encodings). A text the reader or the encoder does not take (a branch's
;; printed target `b 0x8 <f+0x8>`, `<unknown>`, a FileCheck pattern, a directive) is not judged and stays beside (:decoder-text)

(defn- text-word
  "The word the disassembly's stated TEXT encodes (Arbace's reader and encoder), or nil when it is not judged: a FileCheck
  pattern or variable, a printed address (a bare number) or label, no single instruction, a refusal."
  [^String text]
  (let [t (-> text str/trim (str/replace #"^[0-9a-f]+:\s+" ""))]
    ;; (an operand that is a bare number, no `#`, is a PC-relative target as llvm-objdump prints it, `adr x2, 0x4`, the
    ;; instruction's address plus its immediate: not the immediate the reader would take)
    (when-not (or (str/blank? t) (re-find #"\{\{|\[\[|<|>|^\." t) (re-find #"(?:\s|,)\s*-?(?:0x[0-9a-fA-F]+|[0-9]+)\s*(?:,|$)" t))
      (try (let [fs (asm/read-text t {:arch :arm64 :syntax :gnu})
                 f (first fs)]
             (when (and (= 1 (count fs)) (seq? f) (symbol? (first f)) (not (str/starts-with? (str (first f)) ".")) (nil? (namespace (first f))))
               (:word (lenc/encode f))))
           (catch Throwable _ nil)))))

(defn judge-texts
  "The disassembly runs' stated texts (lines that state an instruction's text alone) against the object `r`: [[LINE RESULT]] for
  the lines Arbace encodes, each run's in order among the code words after the one the line before matched (FileCheck's order);
  :pass, else :fail. A line several runs state is met when each meets it."
  [^String src r]
  (let [rs (filter #(#{:objdump-d :objdump-dd} (:tool %)) (runs src))
        lines-of (fn [run] (vec (for [[l k c] (check-lines src (:prefixes run))
                                      :when (not (#{"-NOT" "-DAG"} k))
                                      :when (nil? (bytes-only c))
                                      :let [w (text-word c)] :when w]
                                  [l w])))
        per-run (mapv lines-of rs)
        stated (into (sorted-set) (map first (apply concat per-run)))]
    (cond
      (empty? stated) []
      (not (:bytes r)) (mapv (fn [l] [l (if (:error r) :object-error (keyword (str "unsupported-" (name (or (:unsupported r) :crash)))))]) stated)
      :else
      (let [ws (mapv (fn [[b0 b1 b2 b3]] (bit-or (long b0) (bit-shift-left (long b1) 8) (bit-shift-left (long b2) 16) (bit-shift-left (long b3) 24)))
                     (code-words (elf/read-object (:bytes r))))
            judged (for [ls per-run]
                     (loop [ls ls pos 0 out {}]
                       (if (empty? ls)
                         out
                         (let [[l w] (first ls)
                               i (first (filter #(= (long w) (long (nth ws %))) (range pos (count ws))))]
                           (recur (rest ls) (if i (inc (long i)) pos) (assoc out l (if i :pass :fail)))))))
            worst (fn [a b] (cond (nil? a) b (= a :pass) b :else a))]
        (vec (for [l stated] [l (reduce worst nil (keep #(get % l) judged))]))))))

;; ---------------------------------------------------------------------------------------------------------------------
;; a test

(defn- canon-lines [ls] (mapv (fn [l] {:text l}) ls))

;; ---------------------------------------------------------------------------------------------------------------------
;; the diagnostics (ARS43 (a)): every error of the object assembler as llvm-mc prints it (SourceMgr's `<stdin>:LINE:COL: error:
;; MESSAGE`, the source line, the caret), held to an error run's CHECK lines as FileCheck holds them, `[[@LINE]]` the CHECK
;; line's own number

;; (moved into arbace.asm.obj, shared with x86-64's object check's refusals, AX12)
(def diagnostics o/diagnostics)

(defn- at-line
  "A CHECK line's content with FileCheck's `[[@LINE]]`, `[[@LINE+N]]` and `[[@LINE-N]]` replaced by its number."
  [^String c ^long l]
  (str/replace c #"\[\[#?\s*@LINE(?:\s*([+-])\s*(\d+))?\s*\]\]"
               (fn [[_ sg n]] (str (if sg ((if (= sg "+") + -) l (Long/parseLong n)) l)))))

(defn judge-run
  "One run's CHECK lines against the object `r` (arbace.asm.arm64.obj/assemble's result): [[LINE RESULT]]."
  [^String src run r]
  (let [cs (check-lines src (:prefixes run))
        unsupported (fn [] (keyword (str "unsupported-" (name (:unsupported r)))))]
    (cond
      (empty? cs) []
      (:split? run) (mapv (fn [[l]] [l :split-file]) cs)
      ;; an error run (ARS43 (a)): every error as llvm-mc prints it, held to the CHECK lines by FileCheck; an object that assembles
      ;; is :error-accepted, a line not met :message (an unsupported file's lines: its class)
      (:error? run)
      (if (:errors r)
        (let [outs (canon-lines (diagnostics src r (if (:stdin? run) "<stdin>" (or (:path run) "test.s"))))
              cs2 (mapv (fn [[l k c]] [l k (at-line c l)]) cs)
              res (into {} (map (fn [[l rr]] [l rr]) (binding [dc/*vars* true dc/*full-lines* (:full-lines run)] (dc/filecheck cs2 outs (:implicit-not run)))))]
          (mapv (fn [[l]] [l (case (get res l :fail) :pass :pass :var :filecheck-var :message)]) cs))
        (mapv (fn [[l]] [l (cond (:bytes r) :error-accepted (:unsupported r) (unsupported) :else :message)]) cs))
      (not (:bytes r)) (mapv (fn [[l]] [l (if (:error r) :object-error (unsupported))]) cs)
      ;; judge-rest: a run that reads llvm-mc's diagnostics of an object it writes (`-o /dev/null 2>&1 | FileCheck`, no viewer)
      ;; and states only what they must not hold (every line a -NOT, cfi-bad-nesting-elf's `ELF-NOT: error:`): the object
      ;; assembler's diagnostics of an object it assembled, none (it writes no warning), held to the lines
      (and (= :no-viewer (:tool run)) (:stderr? run) (every? #(= "-NOT" (second %)) cs))
      (let [res (into {} (map (fn [[l rr]] [l rr]) (binding [dc/*vars* true] (dc/filecheck cs [] (:implicit-not run)))))]
        (mapv (fn [[l]] [l (case (get res l :fail) :pass :pass :var :filecheck-var :not-found :fail :fail)]) cs))
      ;; judge-rest: an object holding what the frame view does not print (a DWARF expression...): the view not built
      (and (= :dwarfdump-frames (:tool run)) (nil? (view-dwarfdump-frames (elf/read-object (:bytes r)))))
      (mapv (fn [[l]] [l :view-llvm-dwarfdump]) cs)
      (#{:objdump-d :objdump-dd :objdump-r :readobj-r :readobj :objdump-t :readelf-s :readelf-ss :readelf-arch :readelf-x :readelf :dwarfdump-frames} (:tool run))
      (let [o (elf/read-object (:bytes r))
            view (case (:tool run)
                   :objdump-d (view-objdump-d o (boolean (re-find #"(^|\s)-[a-zA-Z]*r" (:viewer run))))
                   :objdump-dd (view-objdump-d o (boolean (re-find #"(^|\s)-[a-zA-Z]*r" (:viewer run))) true)
                   :readelf-ss (concat (view-readelf-sections o) (view-readelf-s o))
                   :objdump-r (view-objdump-r o)
                   :readobj-r (view-readobj-r o)
                   :readobj (view-readobj o (rest (str/split (str/trim (:viewer run)) #"\s+")))
                   :objdump-t (view-objdump-t o)
                   :readelf-s (view-readelf-s o)
                   :readelf-x (view-readelf-x o (second (re-find #"--hex-dump=(\S+)" (:viewer run))))
                   :readelf-arch (view-readelf-arch o)
                   :readelf (view-readelf o (:viewer run))
                   :dwarfdump-frames (view-dwarfdump-frames o))
            ;; a disassembly's lines held to their bytes; the text alone is the decoder's
            cs2 (if (#{:objdump-d :objdump-dd} (:tool run))
                  ;; a line dropped for its text: a -SAME after it is dropped with it, a -NEXT after it is held as a CHECK (its
                  ;; anchor, the dropped line's, is unknown)
                  (loop [cs cs prev-dropped false out []]
                    (if (empty? cs)
                      out
                      (let [[l k c] (first cs)
                            c2 (cond (= k "-NOT") c (and prev-dropped (= k "-SAME")) nil :else (bytes-only c))
                            k2 (if (and prev-dropped (= k "-NEXT")) "" k)]
                        (recur (rest cs) (nil? c2) (conj out [l k2 c2])))))
                  cs)
            judged (filterv #(some? (nth % 2)) cs2)
            res (into {} (map (fn [[l rr]] [l rr]) (binding [dc/*vars* true dc/*full-lines* (:full-lines run)] (dc/filecheck judged (canon-lines view) (:implicit-not run)))))]
        (vec (for [[l _ c] cs2]
               [l (cond (nil? c) :decoder-text
                        :else (case (get res l :fail) :pass :pass :var :filecheck-var :not-found :fail :fail))])))
      :else (mapv (fn [[l]] [l (:tool run)]) cs))))

(defn file-row
  "A test's row: {:stated N :met N :by {CLASS N}} over its object runs' CHECK lines."
  [^String path]
  (let [src (asm/latin1 path)
        rs (mapv #(assoc % :path path) (runs src))
        asm (memoize (fn [implicit defsym large-eh] (try (obj/assemble-file path {:implicit implicit :defsym (o/defsyms defsym) :large-eh large-eh})
                                                (catch arbace.lang.ExceptionInfo e
                                                  (if-let [c (:obj/unsupported (ex-data e))] {:unsupported c :what (.getMessage e)}
                                                    {:unsupported :crash :what (str e)}))
                                                (catch Throwable e {:unsupported :crash :what (str e)}))))
        res (mapcat #(try (judge-run src % (asm (boolean (:implicit-mapsyms %)) (:defsym %) (:large-eh %)))
                          (catch Throwable e (binding [*out* *err*] (println (str "repr-asm object-verdict: " path ": " e)))
                            (mapv (fn [[l]] [l :view-crash]) (check-lines src (:prefixes %)))))
                    rs)
        f (frequencies (map second res))
        ;; a disassembly's text is the decoder's (AR3): beside the object's cases, not one of them
        text (get f :decoder-text 0)
        ;; judge-rest: the stated encodings of its -show-encoding runs, held to the object assembled without options
        enc (try (judge-encodings src (asm false nil false))
                 (catch Throwable e (binding [*out* *err*] (println (str "repr-asm object-verdict: " path ": encodings: " e)))
                   [[0 :view-crash]]))
        fe (frequencies (map second enc))
        ;; judge-rest: the disassembly's stated texts, encoded by Arbace and held to the object's words
        tx (try (judge-texts src (asm false nil false))
                (catch Throwable e (binding [*out* *err*] (println (str "repr-asm object-verdict: " path ": texts: " e)))
                  [[0 :view-crash]]))
        ft (frequencies (map second tx))]
    (cond-> {:stated (- (count res) text) :met (get f :pass 0) :by (into (sorted-map) (dissoc f :pass :decoder-text))}
      (pos? text) (assoc :beside {:decoder-text text})
      (seq enc) (assoc :enc {:stated (count enc) :met (get fe :pass 0) :by (into (sorted-map) (dissoc fe :pass))})
      (seq tx) (assoc :text {:stated (count tx) :met (get ft :pass 0) :by (into (sorted-map) (dissoc ft :pass))}))))

;; ---------------------------------------------------------------------------------------------------------------------
;; the object check by the test's own words (judge-rest, the user's goal of 2026-11-20): a file of the object check's corpora that
;; states words of its own about its object (its object runs' CHECK lines, its -show-encoding runs' encodings), every one judged
;; by the object verdict, is judged by them in place of llvm-mc's recorded object (whose byte-for-byte comparison is the oracle
;; tier's: bin/repr-asm --arch arm64 object-check --oracle); the others, test/asm/object-recorded-arm64.tsv's, by the record

(def failing #{:fail :object-error :view-crash :unsupported-crash})

(def ^:private unjudged
  "The classes of a stated line the object verdict does not judge: a view or a FileCheck feature not built, a split test."
  #{:no-viewer :filecheck-var :split-file :view-llvm-readobj :view-llvm-readelf :view-llvm-objdump :view-llvm-dwarfdump
    :view-llvm-nm :view-llvm-rtdyld :enc-spelling})

(defn own-verdict
  "The object check's verdict of the file at PATH by its own words: [RESULT DETAIL], RESULT :pass when it states a line or an
  encoding at least and every one is met; :not-own when it states none, or one the views do not judge (unjudged); a class of
  the object assembler (an unsupported directive...) when that keeps one from being met; else :fail."
  [^String path]
  (let [row (file-row path)
        enc (:enc row) tx (:text row)
        n (+ (long (:stated row)) (long (get enc :stated 0)) (long (get tx :stated 0)))
        by (merge-with + (:by row) (:by enc) (:by tx))
        what (str (:stated row) " CHECK lines of its object runs" (when enc (str ", " (:stated enc) " stated encodings"))
                  (when tx (str ", " (:stated tx) " disassembly texts encoded")))]
    (cond
      (zero? n) [:not-own "states nothing the object verdict judges (list it in test/asm/object-recorded-arm64.tsv)"]
      (empty? by) [:pass (str "own: " what ", met")]
      (some unjudged (keys by)) [:not-own (str "states lines the object verdict does not judge " (pr-str by) " (list it in test/asm/object-recorded-arm64.tsv)")]
      (some failing (keys by)) [:fail (str what ": " (pr-str by))]
      :else [(first (keys (into (sorted-map) by))) (str what ": " (pr-str by))])))

(defn own-rows
  "Each NAME<tab>PATH of OWN (the files judged by their own words) appended to WORK/obj.tsv as the object check's rows (NAME RESULT
  DETAIL); each of RECORDED (judged by llvm-mc's record) checked not to be judged whole by its own words: a stale entry of
  test/asm/object-recorded-arm64.tsv. Exits non-zero on a stale entry."
  [own work recorded]
  (let [rows (fn [f] (vec (for [l (str/split-lines (slurp f)) :when (seq l)] (str/split l #"\t"))))
        res (vec (for [[n p] (rows own)] (into [n] (own-verdict p))))
        stale (vec (for [[n p] (rows recorded) :when (= :pass (first (own-verdict p)))] n))]
    (spit (str work "/obj.tsv") (apply str (for [[n c d] res] (str n "\t" (name c) "\t" (str/replace (str d) #"[\t\n]" " ") "\n"))) :append true)
    (let [f (frequencies (map second res))]
      (println (str "repr-asm object-check: " (get f :pass 0) " of " (count res) " objects judged by their own words (their object runs' "
                    "CHECK lines, stated encodings and disassembly texts), met; " (pr-str (into (sorted-map) (dissoc f :pass))))))
    (doseq [n stale] (println (str "FAIL: repr-asm object-check: " n " is judged whole by its own words: stale in test/asm/object-recorded-arm64.tsv")))
    (when (seq stale) (shutdown-agents) (System/exit 1))))

(defn control
  "A negative control: SUBJECT's object judged by REFERENCE's CHECK lines (its runs): `differs` as it must when a line is not
  met, `same` when every one is, `left` when the reference states nothing or the subject does not assemble."
  [subj ref]
  (let [src (asm/latin1 ref) r (obj/assemble-file subj)
        ;; judge-rest: the reference's stated encodings too (another test's words must part from the subject's object)
        res (concat (mapcat #(judge-run src % r) (runs src)) (judge-encodings src r) (judge-texts src r))]
    (cond (or (empty? res) (not (:bytes r))) "left"
          (every? #(= :pass (second %)) (filter #(#{:pass :fail} (second %)) res))
          (if (some #(= :fail (second %)) res) "differs" "same")
          :else "differs")))

(defn check
  "Each NAME<tab>PATH of LIST: WORK/objverdict.edn, rows [CORPUS/NAME {:stated :met :by}]."
  [lst corpus work]
  (let [rows (vec (for [l (str/split-lines (slurp lst)) :when (seq l) :let [[n p] (str/split l #"\t")]]
                    [(str corpus "/" n) (file-row p)]))
        tot (fn [k] (reduce + 0 (map (comp k second) rows)))
        by (apply merge-with + (map (comp :by second) rows))]
    (.mkdirs (java.io.File. ^String work))
    (spit (str work "/objverdict.edn") (pr-str rows))
    (println (str "repr-asm object-verdict: " (count rows) " files, " (tot :stated) " CHECK lines of their object runs judge the object, "
                  (tot :met) " met; " (pr-str (into (sorted-map) by)) "; beside, the decoder's text (AR3): "
                  (reduce + 0 (map #(get-in (second %) [:beside :decoder-text] 0) rows)) " lines"))
    (let [enc (keep (comp :enc second) rows)]
      (println (str "repr-asm object-verdict: " (count enc) " files state their encodings in -show-encoding runs: "
                    (reduce + 0 (map :stated enc)) " stated, " (reduce + 0 (map :met enc)) " met by the words of Arbace's object; "
                    (pr-str (into (sorted-map) (apply merge-with + {} (map :by enc)))))))
    (let [tx (keep (comp :text second) rows)]
      (println (str "repr-asm object-verdict: " (count tx) " files' disassembly texts encoded by Arbace: "
                    (reduce + 0 (map :stated tx)) " judged, " (reduce + 0 (map :met tx)) " met by the words of Arbace's object; "
                    (pr-str (into (sorted-map) (apply merge-with + {} (map :by tx)))))))
    rows))


(def header
  (str ";; repr/asm's arm64 object verdict (bin/repr-asm --arch arm64 object-verdict; doc/asm/ARM64-SURVEY.md, AR4): MC/AArch64's object\n"
       ";; tests (the corpus mc-aarch64-obj) assembled by Arbace (arbace.asm.arm64.obj), each object run's CHECK lines held to Arbace's\n"
       ";; view of the object in the run's viewer's format (llvm-objdump -d's bytes and relocations, -r, -t, llvm-readobj -r, -S, --symbols,\n"
       ";; llvm-readelf -s, --hex-dump, --arch-specific, llvm-dwarfdump --debug-frame; FileCheck's string variables, AR6), no LLVM tool:\n"
       ";; [CORPUS/NAME {:stated :met :by}], :by the unmet lines by class (test/asm/divergences-object-arm64.edn). Written by\n"
       ";; `bin/repr-asm --arch arm64 object-verdict --record`. Read with the Clojure reader.\n"))

(defn judge
  "The run's rows (WORK/objverdict.edn) against RESULTS: every file recorded and run, none meeting fewer lines than recorded,
  every unmet line in a class of CLASSES and none failing; RECORD rewrites RESULTS from a run with no problem. The problems."
  [results work classes-path record]
  (let [run (read-string (slurp (str work "/objverdict.edn")))
        old (if (.exists (java.io.File. ^String results)) (read-string (slurp results)) [])
        oldm (into {} old)
        classes (set (map :id (read-string (slurp classes-path))))
        problems (atom [])]
    (doseq [[i r] run [c n] (concat (:by r) (:by (:enc r)) (:by (:text r)))]
      (cond (failing c) (swap! problems conj (str "failing: " i " " n " " (name c)))
            (not (classes c)) (swap! problems conj (str "unclassed: " i " " n " " (name c)))))
    (if (and (seq record) (empty? @problems))
      (do (spit results (str header "[\n" (apply str (map (fn [[i r]] (str (pr-str [i (into (sorted-map) (cond-> (update r :by #(into (sorted-map) %))
                                                                                                         (:enc r) (update :enc (fn [e] (into (sorted-map) (update e :by #(into (sorted-map) %)))))
                                                                                                         (:text r) (update :text (fn [e] (into (sorted-map) (update e :by #(into (sorted-map) %)))))))]) "\n")) (sort-by first run))) "]\n"))
          (println (str "repr-asm: recorded " (count run) " rows into " results)))
      (do (doseq [[i r] run :let [o (oldm i)]]
            (cond (nil? o) (swap! problems conj (str "not recorded: " i))
                  (< (long (:met r)) (long (:met o))) (swap! problems conj (str i ": " (:met r) " met, recorded " (:met o)))
                  (or (not= (get-in r [:enc :stated]) (get-in o [:enc :stated])) (< (long (get-in r [:enc :met] 0)) (long (get-in o [:enc :met] 0))))
                  (swap! problems conj (str i ": its stated encodings " (pr-str (:enc r)) ", recorded " (pr-str (:enc o))))
                  (or (not= (get-in r [:text :stated]) (get-in o [:text :stated])) (< (long (get-in r [:text :met] 0)) (long (get-in o [:text :met] 0))))
                  (swap! problems conj (str i ": its disassembly texts " (pr-str (:text r)) ", recorded " (pr-str (:text o))))))
          (doseq [[i] old :when (not (some #(= i (first %)) run))] (swap! problems conj (str "recorded, not run: " i)))))
    (doseq [p @problems] (println (str "FAIL: " p)))
    (when (empty? @problems) (println "repr-asm object-verdict: ok"))
    @problems))

(defn -main [verb & args]
  (case verb
    "check" (apply check args)
    "judge" (when (seq (apply judge args)) (shutdown-agents) (System/exit 1))
    "control" (println (apply control args))
    "row" (prn (file-row (first args)))
    "own" (prn (own-verdict (first args)))
    "own-rows" (apply own-rows args)
    "diagnostics" (let [src (asm/latin1 (first args)) r (obj/assemble-file (first args))]
                    (doseq [l (diagnostics src r)] (println l)))
    "lines" (let [src (asm/latin1 (first args))]
              (doseq [run (runs src) [l res] (judge-run src (assoc run :path (first args)) (obj/assemble-file (first args) {:implicit (boolean (:implicit-mapsyms run)) :defsym (o/defsyms (:defsym run)) :large-eh (:large-eh run)}))
                      :when (not= res :pass)]
                (println l res (nth (str/split-lines src) (dec (long l)))))
              (doseq [[l res] (judge-encodings src (obj/assemble-file (first args))) :when (not= res :pass)]
                (println l res "(stated encoding)" (nth (str/split-lines src) (dec (long l)))))
              (doseq [[l res] (judge-texts src (obj/assemble-file (first args))) :when (not= res :pass)]
                (println l res "(disassembly text)" (nth (str/split-lines src) (dec (long l)))))))
  (shutdown-agents))

   "TLS_TPREL64" 0x406 "TLSDESC" 0x407 "IRELATIVE" 0x408})

(def reloc-names (into {} (map (fn [[k v]] [v (str "R_AARCH64_" k)]) reloc-numbers)))

;; the specifiers of an LDST fixup by scale: LLVM's names after the access width
(defn- ldst-reloc [^long scale spec]
  (let [w (* 8 scale)]
    (case spec
      ("lo12" nil) (str "LDST" w "_ABS_LO12_NC")
      "dtprel_lo12" (str "TLSLD_LDST" w "_DTPREL_LO12")
      "dtprel_lo12_nc" (str "TLSLD_LDST" w "_DTPREL_LO12_NC")
      "tprel_lo12" (str "TLSLE_LDST" w "_TPREL_LO12")
      "tprel_lo12_nc" (str "TLSLE_LDST" w "_TPREL_LO12_NC")
      "got_lo12" (when (= scale 8) "LD64_GOT_LO12_NC")
      "got_auth_lo12" (when (= scale 8) "AUTH_LD64_GOT_LO12_NC")
      "tlsdesc_auth_lo12" (when (= scale 8) "AUTH_TLSDESC_LD64_LO12")
      "gottprel_lo12" (when (= scale 8) "TLSIE_LD64_GOTTPREL_LO12_NC")
      "tlsdesc_lo12" (when (= scale 8) "TLSDESC_LD64_LO12")
      "gotpage_lo15" (when (= scale 8) "LD64_GOTPAGE_LO15")
      nil)))

(def ^:private movw-relocs
  {"abs_g3" "MOVW_UABS_G3" "abs_g2" "MOVW_UABS_G2" "abs_g2_s" "MOVW_SABS_G2" "abs_g2_nc" "MOVW_UABS_G2_NC"
   "abs_g1" "MOVW_UABS_G1" "abs_g1_s" "MOVW_SABS_G1" "abs_g1_nc" "MOVW_UABS_G1_NC" "abs_g0" "MOVW_UABS_G0"
   "abs_g0_s" "MOVW_SABS_G0" "abs_g0_nc" "MOVW_UABS_G0_NC"
   "prel_g3" "MOVW_PREL_G3" "prel_g2" "MOVW_PREL_G2" "prel_g2_nc" "MOVW_PREL_G2_NC" "prel_g1" "MOVW_PREL_G1"
   "prel_g1_nc" "MOVW_PREL_G1_NC" "prel_g0" "MOVW_PREL_G0" "prel_g0_nc" "MOVW_PREL_G0_NC"
   "gotoff_g3" "MOVW_GOTOFF_G3" "gotoff_g2" "MOVW_GOTOFF_G2" "gotoff_g2_nc" "MOVW_GOTOFF_G2_NC" "gotoff_g1" "MOVW_GOTOFF_G1"
   "gotoff_g1_nc" "MOVW_GOTOFF_G1_NC" "gotoff_g0" "MOVW_GOTOFF_G0" "gotoff_g0_nc" "MOVW_GOTOFF_G0_NC"
   "dtprel_g2" "TLSLD_MOVW_DTPREL_G2" "dtprel_g1" "TLSLD_MOVW_DTPREL_G1" "dtprel_g1_nc" "TLSLD_MOVW_DTPREL_G1_NC"
   "dtprel_g0" "TLSLD_MOVW_DTPREL_G0" "dtprel_g0_nc" "TLSLD_MOVW_DTPREL_G0_NC"
   "tprel_g2" "TLSLE_MOVW_TPREL_G2" "tprel_g1" "TLSLE_MOVW_TPREL_G1" "tprel_g1_nc" "TLSLE_MOVW_TPREL_G1_NC"
   "tprel_g0" "TLSLE_MOVW_TPREL_G0" "tprel_g0_nc" "TLSLE_MOVW_TPREL_G0_NC"
   "gottprel_g1" "TLSIE_MOVW_GOTTPREL_G1" "gottprel_g0_nc" "TLSIE_MOVW_GOTTPREL_G0_NC"
   "tlsdesc_off_g1" "TLSDESC_OFF_G1" "tlsdesc_off_g0_nc" "TLSDESC_OFF_G0_NC"})

(defn reloc-type
  "getRelocType: the R_AARCH64_* number of a fixup of `kind` (nil: data of `size` bytes) with the specifier `spec` (upper or
  lower case, nil when none); LLVM's error when the pair has none."
  [kind ^long size spec pcrel]
  (let [spec (when spec (str/lower-case (str spec)))
        [k scale] kind
        bad (fn [] (o/fail (str "invalid fixup for " (if k (name k) (str size "-byte data")) (when spec (str " relocation :" spec ":")))))
        nm (cond
             (nil? k) (case spec
                        nil (if pcrel ({2 "PREL16" 4 "PREL32" 8 "PREL64"} size) ({2 "ABS16" 4 "ABS32" 8 "ABS64"} size))
                        "plt" (when (and pcrel (= size 4)) "PLT32")
                        "gotpcrel" (when (and pcrel (= size 4)) "GOTPCREL32")
                        "dtprel" (when (and (not pcrel) (= size 8)) "TLS_DTPREL64")
                        nil)
             (= k :call26) (when (contains? #{nil "plt"} spec) "CALL26")
             (= k :branch26) (when (contains? #{nil "plt"} spec) "JUMP26")
             (= k :branch19) (when (nil? spec) "CONDBR19")
             (= k :branch14) (when (nil? spec) "TSTBR14")
             (= k :branch16) (o/fail "relocation of PAC/AUT instructions is not supported")
             (= k :ldr19) (case spec nil "LD_PREL_LO19" "got" "GOT_LD_PREL19" "got_auth" "AUTH_GOT_LD_PREL19" "gottprel" "TLSIE_LD_GOTTPREL_PREL19"
                                "tlsdesc" "TLSDESC_LD_PREL19" nil)
             (= k :adr21) (case spec (nil "abs") "ADR_PREL_LO21" "tlsdesc" "TLSDESC_ADR_PREL21" "tlsgd" "TLSGD_ADR_PREL21"
                                "got_auth" "AUTH_GOT_ADR_PREL_LO21" nil)
             (= k :adrp21) (case spec (nil "pg_hi21") "ADR_PREL_PG_HI21" "pg_hi21_nc" "ADR_PREL_PG_HI21_NC" "got" "ADR_GOT_PAGE"
                                 "gottprel" "TLSIE_ADR_GOTTPREL_PAGE21" "tlsdesc" "TLSDESC_ADR_PAGE21" "tlsgd" "TLSGD_ADR_PAGE21"
                                 "tlsld" "TLSLD_ADR_PAGE21" "got_auth" "AUTH_ADR_GOT_PAGE" "tlsdesc_auth" "AUTH_TLSDESC_ADR_PAGE21" nil)
             (= k :add12) (case spec "lo12" "ADD_ABS_LO12_NC" "dtprel_hi12" "TLSLD_ADD_DTPREL_HI12"
                                "dtprel_lo12" "TLSLD_ADD_DTPREL_LO12" "dtprel_lo12_nc" "TLSLD_ADD_DTPREL_LO12_NC"
                                "tprel_hi12" "TLSLE_ADD_TPREL_HI12" "tprel_lo12" "TLSLE_ADD_TPREL_LO12"
                                "tprel_lo12_nc" "TLSLE_ADD_TPREL_LO12_NC" "tlsdesc_lo12" "TLSDESC_ADD_LO12"
                                "got_auth_lo12" "AUTH_GOT_ADD_LO12_NC" "tlsdesc_auth_lo12" "AUTH_TLSDESC_ADD_LO12" nil)
             (= k :ldst12) (ldst-reloc scale spec)
             (= k :movw) (get movw-relocs spec)
             (= k :tlsdesc-call) "TLSDESC_CALL")]
    (or (get reloc-numbers nm)
        ;; a specifier the table does not hold (the PAuth ABI's :got_auth:, ...) is not written yet; a known one on the wrong
        ;; instruction is LLVM's error
        (if (and spec (not (re-matches #"(lo12|abs|pg_hi21(_nc)?|got(_lo12|page_lo15|_auth|_auth_lo12)?|tlsdesc_auth(_lo12)?|gottprel(_lo12|_g1|_g0_nc)?|tlsdesc(_lo12)?|tlsgd|tlsld|(d)?tprel_(hi12|lo12(_nc)?|g[0-2](_nc)?)|dtprel|abs_g[0-3](_s|_nc)?|prel_g[0-3](_nc)?|gotoff_g[0-3](_nc)?|tlsdesc_off_g1|tlsdesc_off_g0_nc|plt|gotpcrel|dtprel)" spec)))
          (o/unsupported :relocation-specifier (str ":" spec ":"))
          (bad)))))

;; needsRelocateWithSymbol: a specifier with S_GOT's bit (GOT, GOTTPREL, DTPREL, TPREL and their parts) or PLT, GOTPCREL
(defn- keep-symbol? [spec]
  (boolean (when spec (let [s (str/lower-case (str spec))]
                        (or (str/includes? s "got") (str/includes? s "tprel") (#{"plt" "gotpcrel"} s))))))

(def ^:private tls-specs
  (into #{} (map str/upper-case)
        ["gottprel" "gottprel_lo12" "gottprel_g1" "gottprel_g0_nc" "tlsdesc" "tlsdesc_lo12" "tlsdesc_auth" "tlsdesc_auth_lo12" "tlsdesc_off_g1" "tlsdesc_off_g0_nc"
         "tprel_hi12" "tprel_lo12" "tprel_lo12_nc" "tprel_g2" "tprel_g1" "tprel_g1_nc" "tprel_g0" "tprel_g0_nc" "dtprel" "dtprel_hi12"
         "dtprel_lo12" "dtprel_lo12_nc" "dtprel_g2" "dtprel_g1" "dtprel_g1_nc" "dtprel_g0" "dtprel_g0_nc" "tlsgd" "tlsld"]))

;; writeNopData: the padding's odd bytes zero, then NOPs
(defn- nops ^java.util.List [^long n _mode]
  (let [out (java.util.ArrayList.)]
    (dotimes [_ (mod n 4)] (.add out 0))
    (dotimes [_ (quot n 4)] (doseq [b [0x1f 0x20 0x03 0xd5]] (.add out b)))
    out))

;; AArch64's DWARF registers (AArch64RegisterInfo.td: x0-x30 0-30, sp 31, v0-v31 64-95)
(def ^:private dwarf-regs
  (merge (into {} (for [i (range 31) p ["x" "w"]] [(str p i) i]))
         {"sp" 31 "wsp" 31 "fp" 29 "lr" 30}
         (into {} (for [i (range 32) p ["v" "q" "d" "s" "h" "b"]] [(str p i) (+ 64 i)]))))

;; ---------------------------------------------------------------------------------------------------------------------
;; the directives AArch64's parser and streamer add or define otherwise

(defn- data-spec
  "A data value's specifier written AArch64's way, `%dtprel(var)` (AArch64AsmParser's parseDataExpr: (pct dtprel E)), as the
  shared assembler's (at E dtprel)."
  [e]
  (if (and (seq? e) (= 'pct (first e)) (= 3 (count e)) (= "dtprel" (str/lower-case (str (second e)))))
    (list 'at (nth e 2) "dtprel")
    e))

;; ---------------------------------------------------------------------------------------------------------------------
;; the build attributes (AR6): .aeabi_subsection and .aeabi_attribute (AArch64TargetStreamer's emitAttributesSubsection and
;; emitAttribute, AArch64AsmParser's directives), written at the end as .ARM.attributes (MCELFStreamer's
;; createAttributesWithSubsection: 'A', then each subsection: its length, vendor name, optional, parameter type, attributes)

(def ^:dynamic *attrs* nil)

(def ^:private known-vendors
  {"aeabi_feature_and_bits" {:optional 1 :type 0 :tags {"tag_feature_bti" 0 "tag_feature_pac" 1 "tag_feature_gcs" 2}}
   "aeabi_pauthabi" {:optional 0 :type 0 :tags {"tag_pauth_platform" 1 "tag_pauth_schema" 2}}})

(defn- attr-word [x] (when (some? x) (if (symbol? x) (str/lower-case (name x)) (str x))))

(defn- aeabi-subsection! [args]
  (let [args (if (vector? (first args)) (first args) args)
        [nm opt typ] args
        nm (when (symbol? nm) (name nm))
        _ (when-not nm (o/fail "subsection name not found"))
        known (known-vendors nm)
        exists (some #(= nm (:name %)) (:subs @*attrs*))
        opt (attr-word opt) typ (attr-word typ)
        optional (cond (nil? opt) (or (:optional known) (when exists :keep) (o/fail "optionality parameter not found, expected required|optional"))
                       (= opt "required") 0 (= opt "optional") 1
                       :else (o/fail "unknown AArch64 build attributes optionality, expected required|optional"))
        ptype (cond (nil? typ) (or (:type known) (when exists :keep) (o/fail "type parameter not found, expected uleb128|ntbs"))
                    (= typ "uleb128") 0 (= typ "ntbs") 1
                    :else (o/fail "unknown AArch64 build attributes type, expected uleb128|ntbs"))]
    (when (and known (not= :keep optional) (not= optional (:optional known)))
      (o/fail (str "aeabi subsection " nm " must be marked as " (if (zero? (long (:optional known))) "required" "optional"))))
    (swap! *attrs* (fn [a] (cond-> (assoc a :active nm)
                             (not exists) (update :subs conj {:name nm :optional optional :type ptype :items []}))))))

(defn- aeabi-attribute! [args]
  (let [a @*attrs* nm (:active a)
        sub (first (filter #(= nm (:name %)) (:subs a)))
        _ (when-not sub (o/fail "no active subsection, build attribute can not be added"))
        [tag v] args
        tag (cond (integer? tag) (long tag)
                  (symbol? tag) (or (get-in known-vendors [nm :tags (str/lower-case (name tag))]) (o/fail (str "unknown AArch64 build attribute '" (name tag) "' for subsection '" nm "'")))
                  :else (o/fail "AArch64 build attributes tag not found"))
        v (cond (integer? v) v (string? v) (str "\"" v "\"") (symbol? v) (name v) :else (o/fail "AArch64 build attributes value not found"))]
    (swap! *attrs* update :subs
           (fn [ss] (mapv (fn [s] (if (= nm (:name s))
                                    (if (some #(= tag (first %)) (:items s))
                                      (update s :items (fn [is] (mapv #(if (= tag (first %)) [tag v] %) is)))
                                      (update s :items conj [tag v]))
                                    s))
                          ss)))))

(defn- uleb-bytes [^long v] (loop [v v out []] (let [b (bit-and v 0x7f) v (unsigned-bit-shift-right v 7)] (if (zero? v) (conj out b) (recur v (conj out (bit-or b 0x80)))))))

(defn- attributes-section! [ctx]
  (when-let [subs (seq (:subs @*attrs*))]
    (o/section! ctx ".ARM.attributes" 0x70000003 0 0 nil false)
    (o/data! ctx)
    (o/bytes! ctx (concat [0x41]
                          (mapcat (fn [{:keys [name optional type items]}]
                                    (let [body (concat (map int (.getBytes ^String name "ISO-8859-1")) [0 optional type]
                                                       (mapcat (fn [[t v]] (concat (uleb-bytes t)
                                                                                   (if (integer? v) (uleb-bytes v) (concat (map int (.getBytes ^String v "ISO-8859-1")) [0]))))
                                                               items))
                                          n (+ 4 (count body))]
                                      (concat (for [i (range 4)] (bit-and (bit-shift-right n (* 8 i)) 0xff)) body)))
                                  subs)))))

(defn- directive [ctx h args]
  (let [cv (fn [e] (let [e (o/resolve-expr ctx e)] (or (o/const-value e @(:syms ctx)) (o/unsupported :expression (str "." h " " (pr-str e))))))]
    (case h
      "word" (doseq [e args] (o/emit-value! ctx (data-spec e) 4))
      ("xword" "dword") (doseq [e args] (o/emit-value! ctx (data-spec e) 8))
      "align" (o/directive! ctx (cons 'asm/p2align args))
      "inst" (doseq [e args] (emit-word! ctx (cv e) []))
      "tlsdesccall" (let [e (o/resolve-expr ctx (first args))
                          ch (o/cur-data! ctx)]
                      (o/visit-syms! ctx e)
                      (.add ^java.util.ArrayList (:fixups @ch) [(.size ^java.util.ArrayList (:bytes @ch)) 0 (list 'at e "tlsdesc") [:tlsdesc-call] false 0]))
      ("arch" "arch_extension" "cpu") nil
      ("ltorg" "pool") nil
      ;; .reloc OFFSET, TYPE, EXPR (AArch64AsmBackend::getFixupKind: R_AARCH64_* by name, BFD_RELOC_NONE/16/32/64, a number)
      "reloc" (let [[off t e] args
                    tn (if (integer? t) (long t) (str/upper-case (str t)))
                    type (cond (integer? tn) tn
                               (str/starts-with? tn "R_AARCH64_") (get reloc-numbers (subs tn 10))
                               :else ({"BFD_RELOC_NONE" 0 "BFD_RELOC_16" 0x103 "BFD_RELOC_32" 0x102 "BFD_RELOC_64" 0x101} tn))
                    _ (when-not type (o/fail "unknown relocation name"))
                    off (o/resolve-expr ctx off) e (o/resolve-expr ctx (or e 0))]
                (o/visit-syms! ctx e)
                (.add ^java.util.ArrayList (:reloc-directives ctx) [off type e]))
      ;; .single/.float and .double: IEEE binary32 and binary64, little-endian (AR6)
      ("single" "float" "double")
      (let [n (if (= h "double") 8 4)]
        (o/data! ctx)
        (doseq [a args]
          (let [d (cond (number? a) (double a)
                        (= 'float (head a)) (Double/parseDouble (str (second a)))
                        (and (= '- (head a)) (= 2 (count a)) (= 'float (head (second a)))) (- (Double/parseDouble (str (second (second a)))))
                        :else (o/unsupported :expression (str "." h " " (pr-str a))))
                bits (if (= n 8) (Double/doubleToRawLongBits d) (bit-and (long (Float/floatToRawIntBits (float d))) 0xffffffff))]
            (o/bytes! ctx (for [i (range n)] (bit-shift-right bits (* 8 i)))))))
      "aeabi_subsection" (aeabi-subsection! args)
      "aeabi_attribute" (aeabi-attribute! args)
      "variant_pcs" (let [n (o/sym-name (first args))] (o/register! ctx n) (swap! (o/symbol! ctx n) assoc :st-other 0x80))
      :unhandled)))

(defn- cfi [h _args]
  (case h
    "cfi_negate_ra_state" {:op :escape :bytes [0x2d]}
    nil))

(def arch
  "AArch64's part of arbace.asm.obj (its *arch*)."
  {:machine EM_AARCH64
   :emit-insn! emit-insn!
   :needs-relax? (fn [_ _ _] false)
   :relax! identity
   :pcrel-bias (fn [_] 0)
   :put-fixup! put-fixup!
   :force-reloc? (fn [kind] (= :adrp21 (first kind)))
   :resolve-spec? (fn [spec] (boolean (re-matches #"abs_g[0-3](_s|_nc)?" (str/lower-case (str spec)))))
   :min-inst-align 4
   :reloc-type reloc-type
   :keep-symbol? keep-symbol?
   :tls-specs tls-specs
   :directive directive
   :wrap (fn [t] (binding [*attrs* (atom {:subs [] :active nil})] (t)))
   :finish attributes-section!
   :cfi cfi
   :on-data (fn [ctx] (mapping! ctx :data))
   :nops nops
   :nops-max (fn [_] Long/MAX_VALUE)
   :dwarf-regs dwarf-regs
   :eh-frame-type elf/SHT_PROGBITS
   :cie {:ra 30 :data-align -4 :init [0x0c 31 0] :cfa 0}})

(defn assemble
  "The ELF64 object of the forms `items` ([FORM START END] as arbace.repr.asm/read-items gives them): {:bytes BYTES}, or
  {:unsupported CLASS :what TEXT}, or {:error MESSAGE}."
  [items]
  (binding [o/*arch* arch] (o/assemble items)))

(defn assemble-file [^String path]
  (let [items (try (asm/read-items (asm/latin1 path) (asm/dialect "arm64" nil path))
                   (catch arbace.lang.ExceptionInfo e
                     (if (= :syntax (:asm/refused (ex-data e))) {:unsupported :syntax :what (.getMessage e)} (throw e))))]
    (if (map? items) items (assemble items))))

(defn check-list [lst work record] (binding [o/*arch* arch] (o/check-list assemble-file lst work record)))
(defn control [subj-path ref-name record] (binding [o/*arch* arch] (o/control assemble-file subj-path ref-name record)))

(defn -main
  "object IN.s OUT.o; dump OBJ; check LIST WORK RECORD; control SUBJECT REFNAME RECORD (arbace.asm.obj/main)."
  [verb & args]
  (binding [o/*arch* arch] (apply o/main assemble-file verb args)))

(ns arbace.asm.arm64.obj
  "arm64's object assembler (doc/asm/ARM64-SURVEY.md §4.3, AR4): AArch64's part of the shared object assembler arbace.asm.obj
  (`arch`), after llvm-project 23.1.5's AArch64 back end: AArch64MCCodeEmitter.cpp (which operand gives which fixup kind),
  AArch64AsmBackend.cpp (adjustFixupValue: a resolved fixup's value into its field, with its range and alignment checks;
  shouldForceRelocation: ADRP always relocated; writeNopData), AArch64ELFObjectWriter.cpp (getRelocType: the R_AARCH64_*
  type by fixup kind and specifier; needsRelocateWithSymbol), AArch64ELFStreamer.cpp (the mapping symbols $x and $d,
  .inst, .tlsdesccall) and AArch64AsmParser.cpp's directives (.word 4 bytes, .xword, .align a power of 2, .arch, .cpu,
  .variant_pcs), and MCDwarf's CIE for AArch64 (data alignment -4, return address x30, DW_CFA_def_cfa sp, 0), Apache-2.0
  WITH LLVM-exception, written again in Arbace; no code copied. The instructions are AR2's encoder's
  (arbace.repr.asm.arm64.lenc: Go's table, then LLVM's records), each a word and the operands it leaves to a fixup; the
  fixup's kind is read off the encoded word's class (the field the operand fills).

  `assemble` gives {:bytes BYTES} or {:unsupported CLASS :what TEXT} or {:error MESSAGE}."
  (:require [arbace.repr.asm :as asm]
            [arbace.repr.asm.arm64.lenc :as lenc]
            [arbace.repr.asm.arm64.enc :as enc]
            [arbace.asm.obj :as o]
            [arbace.asm.elf :as elf]
            [arbace.string :as str]))

(set! *warn-on-reflection* true)

(def EM_AARCH64 183)

(defn- head [x] (when (seq? x) (first x)))

;; ---------------------------------------------------------------------------------------------------------------------
;; the mapping symbols (AArch64ELFStreamer: emitA64MappingSymbol, emitDataMappingSymbol; the state kept per section)

(defn- mapping! [ctx kind]
  (let [sec (o/cur-sec ctx)]
    (when-not (= kind (:ems @sec))
      (let [nm (if (= kind :code) "$x" "$d")
            k (str nm "\u0000" (vswap! (:tmp ctx) inc))
            s (o/label! ctx k)]
        ;; NOTYPE before the label, which makes a symbol of a TLS section STT_TLS ($d in .tbss is)
        (swap! s assoc :out-name nm :bind elf/STB_LOCAL)
        (swap! sec assoc :ems kind)))))

;; ---------------------------------------------------------------------------------------------------------------------
;; the fixups: the kind by the encoded word's class (AArch64MCCodeEmitter's operand encoders), the expression and its
;; specifier from the operand

(defn fixup-kind
  "The fixup kind of an instruction word whose operand is left to a fixup: :call26, :branch26, :branch19, :branch14,
  :ldr19 (a literal load), :adr21, :adrp21, :add12, :ldst12 (with :scale), :movw; nil for another class."
  [^long w]
  (cond
    ;; PAuth_LR's AUTIASPPC, AUTIBSPPC, RETAASPPC, RETABSPPC <label>: fixup_aarch64_pcrel_branch16 (AR6)
    (or (= (bit-and w 0xffdf001f) 0xf380001f) (= (bit-and w 0xffdf001f) 0x5500001f)) [:branch16]
    (= (bit-and w 0x7c000000) 0x14000000) (if (bit-test w 31) [:call26] [:branch26])
    (= (bit-and w 0xff000000) 0x54000000) [:branch19]
    (= (bit-and w 0x7e000000) 0x34000000) [:branch19]
    (= (bit-and w 0x7e000000) 0x36000000) [:branch14]
    (= (bit-and w 0x3b000000) 0x18000000) [:ldr19]
    (= (bit-and w 0x9f000000) 0x10000000) [:adr21]
    (= (bit-and w 0x9f000000) 0x90000000) [:adrp21]
    (= (bit-and w 0x1f800000) 0x11000000) [:add12]
    (= (bit-and w 0x3b000000) 0x39000000)
    (let [size (bit-and (bit-shift-right w 30) 3) v (bit-test w 26) opc (bit-and (bit-shift-right w 22) 3)]
      [:ldst12 (if (and v (zero? size) (>= opc 2)) 16 (bit-shift-left 1 size))])
    (= (bit-and w 0x1f800000) 0x12800000) [:movw]
    :else nil))

(def ^:private pcrel-kinds #{:call26 :branch26 :branch19 :branch14 :branch16 :ldr19 :adr21 :adrp21})

(defn fix-expr
  "The relocated expression of a fixup operand and its specifier: [EXPR SPEC] (SPEC the lower-case name of `:SPEC:`, or nil)."
  [op]
  (cond
    (= 'spec (head op)) [(nth op 2) (str/lower-case (str (second op)))]
    (= 'at (head op)) [(second op) (str/lower-case (str (nth op 2)))]
    (#{'imm 'lit} (head op)) (fix-expr (second op))
    (#{'mem 'wb} (head op)) (first (keep #(when-not (#{'reg 'shift} (head %)) (fix-expr %)) (rest op)))
    (#{'reg 'shift 'rlist 'elt} (head op)) nil
    :else [op nil]))

(defn- const-subst
  "The form with the symbols the file assigned a constant replaced by their values (outside registers)."
  [ctx f]
  (let [syms @(:syms ctx)]
    (letfn [(walk [x]
              (cond (symbol? x) (if-let [c (and (contains? syms (name x)) (o/const-value x syms))] c x)
                    ;; a literal beyond a long is its 64 bits (MCExpr's int64_t arithmetic)
                    (and (integer? x) (not (instance? Long x))) (.longValue (biginteger x))
                    (#{'reg 'shift 'elt 'rlist} (head x)) x
                    (seq? x) (apply list (first x) (map walk (rest x)))
                    :else x))]
      (cons (first f) (map walk (rest f))))))

;; ---------------------------------------------------------------------------------------------------------------------
;; the instructions

(defn- emit-word! [ctx ^long w fixups]
  (mapping! ctx :code)
  (let [ch (o/cur-data! ctx) ^java.util.ArrayList b (:bytes @ch) base (.size b)]
    (dotimes [i 4] (.add b (bit-and (bit-shift-right w (* 8 i)) 0xff)))
    (doseq [fx fixups] (.add ^java.util.ArrayList (:fixups @ch) (assoc fx 0 base)))))

(def ^:private fold-sym
  "The placeholder an immediate's label arithmetic is encoded as (ARS36 (a)): a bare symbol the encoder leaves to a fixup."
  'arbace_fold)

(defn- fold-imm
  "The forms with its one immediate whose value is an expression of symbols, without a specifier (`#(end - start)`), replaced
  by the placeholder (bare, then as :lo12:, which add and sub take): [[FORM...] EXPR], or nil when it has none."
  [f]
  (let [i (first (keep-indexed (fn [i op] (when (and (= 'imm (head op)) (seq? (second op)) (not (#{'spec 'at} (head (second op)))))
                                            i))
                               (rest f)))]
    (when i
      [(for [ph [fold-sym (list 'spec 'lo12 fold-sym)]] (apply list (first f) (assoc (vec (rest f)) i (list 'imm ph))))
       (second (nth (rest f) i))])))

(defn- optional-hash
  "The form with its bare immediates written with their `#` (AArch64AsmParser takes an immediate without it: `cmp w0, 123`,
  `fmov s0, 1.0625`, `fcmeq v0.2s, v1.2s, 0.0`): a number or a (float ...) operand after the first becomes (imm ...)."
  [f]
  (apply list (first f) (first (rest f))
         (map (fn [op] (if (or (number? op) (= 'float (head op))) (list 'imm op) op)) (rest (rest f)))))

(defn- emit-insn! [ctx f]
  (let [f (const-subst ctx (o/resolve-expr ctx f))
        f (if (some #(= 'float (head %)) (rest f)) (optional-hash f) f)
        _ (when (some #(= 'lit (head %)) (rest f)) (o/unsupported :literal-pool (str "ldr =: " (pr-str f))))
        refused (fn [^Exception e] (o/unsupported :instruction (str (or (:asm/message (ex-data e)) (.getMessage e)) ": " (pr-str f))))
        r (try (lenc/encode f)
               (catch arbace.lang.ExceptionInfo e
                 (if-not (:asm/refused (ex-data e))
                   (throw e)
                   ;; label arithmetic as an immediate (ARS36 (a), AR6): encoded with a placeholder left to a fixup, the
                   ;; expression its value, folded at layout when its labels are in one section (MC's evaluateAsAbsolute
                   ;; after layout), else the fixup's relocation is refused as LLVM refuses it
                   (if-let [[f2s ex] (fold-imm f)]
                     (let [r2 (first (keep #(try (lenc/encode %) (catch arbace.lang.ExceptionInfo _ nil)) f2s))]
                       (if (and r2 (= 1 (count (:fixups r2))))
                         (assoc r2 :fixups [(list 'imm ex)])
                         (refused e)))
                     (refused e)))))
        w (long (:word r))
        ;; emitA64MappingSymbol before the instruction's symbols are visited
        _ (mapping! ctx :code)
        ;; getAddSubImmOpValue: a HI12 specifier shifts the immediate by 12
        w (if (some #(let [[_ sp] (fix-expr %)] (and sp (str/ends-with? sp "hi12"))) (:fixups r)) (bit-or w 0x400000) w)
        fxs (vec (for [op (distinct (:fixups r))
                       :let [[e spec] (fix-expr op)]
                       :when (some? e)]
                   (let [[kind scale] (or (fixup-kind w) (o/unsupported :fixup-kind (str "a fixup in " (pr-str f))))
                         e (if spec (list 'at e spec) e)]
                     (o/visit-syms! ctx e)
                     [0 4 e (if scale [kind scale] [kind]) (contains? pcrel-kinds kind) 0])))]
    (emit-word! ctx w fxs)))

;; ---------------------------------------------------------------------------------------------------------------------
;; a resolved fixup into its field (adjustFixupValue, applyFixup), the relocation types (getRelocType)

(defn- range! [^long v ^long lo ^long hi]
  (when-not (<= lo v hi) (o/fail "fixup value out of range")))

(defn- align! [^long v ^long a]
  (when-not (zero? (mod v a)) (o/fail "fixup not sufficiently aligned")))

(defn field-of
  "The bits a resolved fixup of `kind` with value `v` sets in its instruction word."
  ^long [[kind scale] ^long v]
  (case kind
    (:call26 :branch26) (do (range! v -134217728 134217727) (align! v 4) (bit-and (bit-shift-right v 2) 0x3ffffff))
    (:branch19 :ldr19) (do (range! v -1048576 1048575) (align! v 4) (bit-shift-left (bit-and (bit-shift-right v 2) 0x7ffff) 5))
    ;; an unsigned offset backwards: the negative value inverted (adjustFixupValue)
    :branch16 (let [v (- v)] (range! v 0 262143) (align! v 4) (bit-shift-left (bit-and (bit-shift-right v 2) 0xffff) 5))
    :branch14 (do (range! v -32768 32767) (align! v 4) (bit-shift-left (bit-and (bit-shift-right v 2) 0x3fff) 5))
    :adr21 (do (range! v -1048576 1048575)
               (bit-or (bit-shift-left (bit-and v 3) 29) (bit-shift-left (bit-and (bit-shift-right v 2) 0x7ffff) 5)))
    :add12 (do (range! v 0 4095) (bit-shift-left v 10))
    :ldst12 (do (range! v 0 (* 4095 (long scale))) (align! v scale) (bit-shift-left (quot v (long scale)) 10))
    :movw (do (range! v 0 65535) (bit-shift-left v 5))
    (o/unsupported :fixup-kind (str "a resolved " kind))))

(defn- movw-value
  "adjustFixupValue's MOVW with an absolute specifier (:abs_gN[_s|_nc]:): [FIELD MOVN?] of the value `v`."
  [^String spec ^long v]
  (let [[_ g s] (re-matches #"abs_g([0-3])(_s|_nc)?" spec)
        x (bit-shift-right v (* 16 (Long/parseLong g)))]
    (cond (= s "_nc") [(bit-and x 0xffff) nil]
          (= s "_s") (do (range! x -65535 65535) [(if (neg? x) (bit-not x) x) (neg? x)])
          :else (do (when-not (zero? (unsigned-bit-shift-right x 16)) (o/fail "fixup value out of range")) [x nil]))))

(defn- put-fixup! [^java.util.ArrayList bs off size kind ^long x reloc? spec]
  (let [off (long off) spec (when spec (str/lower-case (str spec)))]
    (cond
      reloc? nil
      (nil? kind) (dotimes [i size] (.set bs (+ off i) (bit-and (bit-shift-right x (* 8 i)) 0xff)))
      (and (= :movw (first kind)) spec)
      (let [[f movn?] (movw-value spec x) f (bit-shift-left (long f) 5)]
        (dotimes [i 4] (.set bs (+ off i) (bit-or (long (.get bs (+ off i))) (bit-and (bit-shift-right f (* 8 i)) 0xff))))
        ;; applyFixup: a signed group's negative value makes the MOVZ a MOVN (bit 30 clear), else MOVZ
        (when (some? movn?)
          (let [b3 (long (.get bs (+ off 3)))] (.set bs (+ off 3) (if movn? (bit-and b3 (bit-not 0x40)) (bit-or b3 0x40))))))
      :else (let [f (field-of kind x)]
              (dotimes [i 4] (.set bs (+ off i) (bit-or (long (.get bs (+ off i))) (bit-and (bit-shift-right f (* 8 i)) 0xff))))))))


   "TLSDESC_ADD_LO12" 0x234 "TLSDESC_OFF_G1" 0x235 "TLSDESC_OFF_G0_NC" 0x236 "TLSDESC_LDR" 0x237 "TLSDESC_ADD" 0x238
   "TLSDESC_CALL" 0x239 "TLSLE_LDST128_TPREL_LO12" 0x23a "TLSLE_LDST128_TPREL_LO12_NC" 0x23b

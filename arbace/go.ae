(ns arbace.go
  "Go forms at the REPL (doc/go/GOI-SPEC.md), milestone GR1: Arbace calling compiled Go.

  A package of goi's table of compiled packages (go/arbace/gotable.edn: strings, strconv, math,
  time, fmt ...) is a namespace, go. and its import path (go.strings, go.math.rand.v2), made
  from the table when it is required (§2.1, §7.2; arbace.lang.RT's load asks
  arbace.lang.GoInterp first):

    (require '[go.strings :as strings])
    (strings/ToUpper \"go\")                      ;=> \"GO\"
    (strings/Cut \"k=v\" \"=\")                     ;=> [\"k\" \"v\" true]
    (let [b (go/new go.strings/Builder)]
      (strings/Builder.WriteString b \"x\")       ; a method: T.M, the receiver first
      (strings/Builder.String b))               ;=> \"x\"

  Its vars are made on first use (S9): each function a GoFn, each method T.M a GoFn of its
  method expression, each variable a GoVar (deref it), each type a GoType (an IFn: (T) its zero
  value, (T v) a conversion, (T {:Field v}) a struct), each constant its value. Arguments and
  results convert by the Go types (§5.6): Long, Double, Boolean, String, Character for Go's
  scalars and strings, Go values (of the class arbace.lang.GoValue, printed #go \"...\") for the
  rest; several results are a vector; a panic is an arbace.lang.GoPanic, os.Exit an
  arbace.lang.GoExit.

  GR3: the macros of Go forms (§2.2). In a go.* namespace a Go package is the namespace's
  (go/package, or implicitly the first declaration's: S2); each declaration head of Go forms is
  a macro that hands its form, quoted, to arbace.go.repl, which checks and defines it at once
  at the REPL (§2.5), or queues it while the package's file loads (§2.3):

    (ns go.demo (:require [arbace.go :as go]))
    (go/import [strings \"strings\"])
    (go/func Greet ^string [^string name] (+ \"hello, \" (strings/ToUpper name)))
    (Greet \"go\")                                ;=> \"hello, GO\"
    (go/eval (Greet \"x\"))                       ;=> \"hello, X\"

  The forms are data from the reader to the checker: nothing in them is evaluated as Arbace.

  GR5: Arbace fns given for Go func parameters are Go funcs (§7.5); a panic leaving Go is a
  GoPanic with gc's text, its interpreted frames in its trace and ex-data, a run-time error's
  Java exception as its cause (§10.4, §10.6); Go values print as gc's %#v with goi's type names
  (§5.7); their methods and fields are reachable by interop ((.Len buf), (.-X p): GS10), their
  elements by count, nth, get and seq (GS7); Go forms reach Arbace through the package arbace
  (§7.3); go/run-compiled builds a package's program with gc and runs it (G15)."
  (:refer-clojure :exclude [new str type import eval])
  (:import (arbace.lang GoInterp GoFn GoVar GoType Namespace)
           (java.io PushbackReader StringReader)))

;; ---------------------------------------------------------------------------------------
;; The digest (§6.5): the listed packages' declarations as Go forms, without bodies

(defn path->ns
  "The namespace of Go import path p (SPEC.md §4.1): go. and the path, / as ., . and - inside an
  element as _."
  [^String p]
  (symbol (arbace.core/str "go." (apply arbace.core/str (interpose "." (map #(.replaceAll ^String % "[.-]" "_") (.split p "/")))))))

(def ^:private digest-index
  (delay
    (when-let [^String s (GoInterp/digest)]
      (let [nl (.indexOf s "\n")]
        {:index (read-string (subs s 0 nl)) :text s :start (inc nl)}))))

(defn digest-forms
  "The forms of the digest of listed package path p (§6.5): its go/package, go/file and
  declaration forms, or nil."
  [p]
  (when-let [{:keys [index ^String text start]} @digest-index]
    (when-let [[a b] (get index p)]
      (let [r (PushbackReader. (StringReader. (subs text (+ start a) (+ start b))))]
        (binding [*read-eval* false]
          (loop [acc []]
            (let [f (read {:eof ::eof} r)]
              (if (= f ::eof) acc (recur (conj acc f))))))))))

(defn- params-of
  "The parameter names of a signature's vector (Go's names; p1 ... for unnamed ones)."
  [pv]
  (vec (map-indexed (fn [i x]
                      (cond
                        (= '& x) '&
                        (and (symbol? x) (:tag (meta x)) (not= '_ x)) (symbol (name x))
                        :else (symbol (arbace.core/str "p" (inc i)))))
                    pv)))

(defn- strip-doc [xs] (if (string? (first xs)) [(first xs) (rest xs)] [nil xs]))

(defn- const-value
  "A constant's :val as an Arbace value (§2.1, §5.6): integers as Long or BigInt, floats as a
  Double (a Float for a float32 constant), runes as their Long, strings as String, complex
  values as Go values."
  [v underlying]
  (cond
    (integer? v) v
    (char? v) (long (int v))
    (or (float? v) (ratio? v) (decimal? v)) (if (= 'float32 underlying) (float v) (double v))
    (seq? v) (case (arbace.core/str (first v))
               "rune" (long (second v))
               "byte-string" (String. (byte-array (mapcat (fn [x] (if (string? x) (seq (.getBytes ^String x "UTF-8")) [(unchecked-byte x)])) (rest v)))
                                      "UTF-8")
               "complex" (GoInterp/complex (double (second v)) (double (nth v 2)))
               "binary-float" (* (double (second v)) (Math/pow 2.0 (double (nth v 2))))
               v)
    :else v))

(defn- digest-info
  "What the digest says of package p's exported names: {name {:doc :arglists :const value}}."
  [p]
  (reduce
    (fn [acc f]
      (if-not (and (seq? f) (symbol? (first f)) (= "go" (namespace (first f))))
        acc
        (case (name (first f))
          "func" (let [[doc xs] (strip-doc (drop 2 f))
                       gen (= :type-params (first xs))
                       xs (if gen (drop 2 xs) xs)]
                   (assoc acc (arbace.core/str (second f)) (cond-> {:doc doc :arglists (list (params-of (first xs)))}
                                                             gen (assoc :generic true))))
          "method" (let [[doc xs] (strip-doc (drop 2 f))
                         gen (= :type-params (first xs))
                         xs (if gen (drop 2 xs) xs)
                         pv (first xs)
                         r (first pv)
                         rt (if (and (symbol? r) (:tag (meta r))) (:tag (meta r)) r)
                         rt (if (and (seq? rt) (= '* (first rt))) (second rt) rt)
                         ;; a generic type's method (GR9d): (List T)
                         [rt gen] (if (seq? rt) [(first rt) true] [rt gen])]
                     (if (symbol? rt)
                       (assoc acc (arbace.core/str rt "." (second f)) (cond-> {:doc doc :arglists (list (params-of pv))}
                                                                         gen (assoc :generic true)))
                       acc))
          "const" (let [n (second f) m (meta n)]
                    (assoc acc (arbace.core/str n) {:doc (:doc m) :const (const-value (:val m) (:go/underlying m))}))
          "type" (assoc acc (arbace.core/str (second f)) {:doc (let [d (nth f 2 nil)] (when (string? d) d))})
          "var" (assoc acc (arbace.core/str (second f)) {:doc (:doc (meta (second f)))})
          acc)))
    {}
    (digest-forms p)))

;; ---------------------------------------------------------------------------------------
;; The namespaces of the table's packages (§2.1, §7.2)

(declare repl-fn)

(defn- member-var
  "Interns the var of member name (kind, handle, digest info) in ns."
  [ns ^String path ^String nm kind handle info]
  (let [full (arbace.core/str path "." nm)
        m (cond-> {:go/kind kind :go/package path}
            (:doc info) (assoc :doc (:doc info))
            (:arglists info) (assoc :arglists (:arglists info)))]
    (intern ns (with-meta (symbol nm) m)
            (case kind
              (:func :method) (GoFn. handle full)
              :var (GoVar. handle full)
              :type (GoType. handle)
              :const (:const info)))))

(defn table-ns!
  "Makes the namespace of listed package path p (arbace.lang.GoInterp's loadTable, for
  RT.load): its vars are made when first resolved, all of them when the namespace's mappings
  are asked for (ns-publics, refer: S9)."
  [p]
  (let [ns (create-ns (path->ns p))
        ;; vars interned before (a compiled namespace's constants name them before its ns form
        ;; requires the package: a user's program's Go package, REAP7b): made with the rest
        early (vec (for [[s v] (.getMappings ^Namespace ns)
                         :when (and (var? v) (identical? ns (.-ns ^arbace.lang.Var v)) (not (bound? v)))]
                     (name s)))
        ms (GoInterp/members p)
        members (into {} (for [[k n h] (partition 3 ms)] [n [(keyword k) h]]))
        info (delay (digest-info p))
        consts (delay (into {} (for [[n i] @info :when (contains? i :const) :when (not (contains? members n))] [n i])))
        make (fn [^String n]
               (if-let [[kind h] (get members n)]
                 (member-var ns p n kind h (get @info n))
                 (if-let [i (get @consts n)]
                   (member-var ns p n :const nil i)
                   ;; a generic function or a generic type's method (GR9d): a GoGenericFn
                   ;; over the digest's declaration (§9.3)
                   (when (:generic (get @info n))
                     ((repl-fn "listed-generic!") ns p n (get @info n))))))
        resolver (fn
                   ([_]
                    (doseq [n (sort (concat (keys members) (keys @consts)))]
                      (make n)))
                   ([_ sym]
                    (make (name sym))))]
    (.setResolver ^Namespace ns resolver)
    (doseq [n early] (make n))
    ns))

(defn interpretable-ns!
  "arbace.lang.GoInterp's loadTable for a go/ resource of one element that is no listed
  package (GR9d): an interpretable package of the digest (go/slices, §9.3) is loaded by goi,
  its namespace and vars made (generic functions' GoGenericFns among them); true then, else
  false."
  [^String p]
  (boolean (when ((repl-fn "interpretable?") p)
             ((repl-fn "load-import") p)
             true)))

(defn packages
  "The import paths of the table's packages (go/arbace/gotable.edn, §6.6)."
  []
  (vec (GoInterp/paths)))

;; ---------------------------------------------------------------------------------------
;; Go values from Arbace (§7.1, §2.8)

(defn new
  "Go's new(T) for GoType t: a pointer to a new zero T (a Go value)."
  [^GoType t]
  (GoInterp/newValue (.-handle t)))

(defn zero
  "The zero value of GoType t, converted to Arbace by t."
  [^GoType t]
  (GoInterp/zero (.-handle t)))

(defn type-of
  "The Go type (a GoType) of Go value v, or nil."
  [v]
  (GoInterp/typeOf v))

(defn str
  "fmt.Sprint of v (a Go value; an Arbace scalar or string as Go's) as a String."
  [v]
  (GoInterp/str v))

(defn spread
  "(go/spread xs) as the last argument of a variadic Go function passes the Go slice xs as its
  variadic parameter (Go's f(a, xs...))."
  [xs]
  (GoInterp/spread xs))

(defn assign!
  "Assigns the package variable of GoVar v (a var's root: (go/assign! go.x/V 3)) the Arbace
  value x, converted by the variable's type."
  [^GoVar v x]
  (GoInterp/store (.-cell v) x)
  x)

;; ---------------------------------------------------------------------------------------
;; Arbace objects implementing Go interfaces (G13, GR7b): what reify makes of a reify naming Go
;; interfaces of the table (arbace.core/reify, its Go specs)

(def ^:private reify-types (atom {}))

(defn- type-names [ts] (apply arbace.core/str (interpose ", " (map #(.getName ^GoType %) ts))))

(defn reify-type
  "The reify type of Go interface types ts (GoTypes of listed packages' interfaces) and its
  methods' names in order: [T name...], made once per list."
  [ts]
  (or (get @reify-types ts)
      (let [r (vec (GoInterp/reifyType (object-array ts)))]
        (swap! reify-types assoc ts r)
        r)))

(defn reify-data
  "The data of a reify of Go interfaces (arbace.lang.GoReify's goiReify): rt its reify-type,
  fns its methods' fns by name (each taking the object first), as an Object[] [T f...] in rt's
  order; every method of the interfaces must be given."
  [rt ts fns]
  (let [[t & names] rt]
    (doseq [k (keys fns)]
      (when-not (some #{k} names)
        (throw (IllegalArgumentException.
                (arbace.core/str "reify: " k " is no method of " (type-names ts))))))
    (object-array
     (cons t (for [n names]
               (or (get fns n)
                   (throw (IllegalArgumentException.
                           (arbace.core/str "reify: method " n " of " (type-names ts) " is missing")))))))))

;; ---------------------------------------------------------------------------------------
;; The macros of Go forms (§2.2, GR3): each hands its form to arbace.go.repl, loaded on first use

(defn repl-fn "arbace.go.repl's function nm (the namespace loaded on first use)." [nm] (requiring-resolve (symbol "arbace.go.repl" nm)))

(defn- pos-of [form] (select-keys (meta form) [:line :column]))

(defmacro package
  "go/package: the namespace's Go package (its name, :path, :files ...)."
  [nm & opts]
  `((repl-fn "package!") '~(ns-name *ns*) '~nm '~(vec opts)))

(defmacro file
  "go/file: the namespace's current Go file, its :imports (S5)."
  [nm & opts]
  `((repl-fn "file!") '~(ns-name *ns*) ~nm '~(apply hash-map opts)))

(defn declare*
  "A declaration form's call of arbace.go.repl/declare! (the macros')."
  [form opts]
  ((repl-fn "declare!") form opts))

(defmacro func "go/func: a Go function (§2.5): checked and defined, its var returned." [& _]
  `(declare* '~&form '~(assoc (pos-of &form) :ns (ns-name *ns*))))

(defmacro method "go/method: a Go method (§2.5)." [& _]
  `(declare* '~&form '~(assoc (pos-of &form) :ns (ns-name *ns*))))

(defmacro type "go/type: a Go type (§2.5)." [& _]
  `(declare* '~&form '~(assoc (pos-of &form) :ns (ns-name *ns*))))

(defmacro var "go/var: a Go package variable (§2.5)." [& _]
  `(declare* '~&form '~(assoc (pos-of &form) :ns (ns-name *ns*))))

(defmacro const "go/const: a Go constant (§2.5)." [& _]
  `(declare* '~&form '~(assoc (pos-of &form) :ns (ns-name *ns*))))

(defmacro directive "go/directive: accepted, ignored (§2.2)." [& _] nil)

(defmacro import
  "go/import: import specs [name \"path\"] for the current REPL file (S5)."
  [& specs]
  `((repl-fn "import!") '~(ns-name *ns*) '~(vec specs)))

(defmacro inst
  "(go/inst f T...): explicit type arguments (GR9d, GC73): f names a generic function's var
  (a GoGenericFn, a generic type's method T.M too) or a generic type of an interpreted package
  (go.main/List), each T a Go type form resolved in the namespace's package (go.user's outside
  go.*). Every type argument given: the instance's GoFn (a function, a method: its receiver
  first) or GoType (a type); fewer: a GoGenericFn inferring the rest, those given fixed (Go's
  partial instantiation)."
  [f & types]
  `((repl-fn "inst!") '~(ns-name *ns*) '~f '~(vec types)))

(defmacro eval
  "go/eval: Go statements run in the namespace's package (go.user outside go.*), the last one's
  value as Arbace's (§2.4)."
  [& stmts]
  `((repl-fn "eval!") '~(vec stmts) '~{:ns (ns-name *ns*)}))

(defn run-main
  "Runs package ns-sym's main (§2.6): nil, or a GoExit when it called os.Exit."
  [ns-sym]
  ((repl-fn "run-main!") ns-sym))

(defn run-compiled
  "Prints package ns-sym's program (it and the interpreted packages it imports) with repr/go,
  builds it with build/go and runs it with args as a child process (G15): {:out :err :exit}."
  [ns-sym & args]
  ((repl-fn "run-compiled!") ns-sym (vec args)))

(defn check
  "The errors of package ns-sym checked again, as data (nothing defined)."
  [ns-sym]
  ((repl-fn "check!") ns-sym))

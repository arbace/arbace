;; arbace.tls's host layer (doc/go/BOX-NOTES.md, "TLS (option 2)", BX70; the Go build's variant
;; until S4, when the JVM's javax.net.ssl one left with the JVM: doc/STANDALONE-NOTES.md): over
;; jrt's own Java jdk.internal.jrt.TlsSocket, a java.net.Socket upgraded in place by Go's
;; crypto/tls (go/arbace/jrt/tls.ae), in the box over the monitor's stream and natively over the
;; host's socket.
(ns arbace.tls.host
  "arbace.tls's host layer: jdk.internal.jrt.TlsSocket."
  (:import (java.net InetSocketAddress)
           (jdk.internal.jrt HostNet TlsSocket)))

(defn connect
  "A TlsSocket connected to host and port, the handshake made for server-name, alpn (the
  protocols separated by commas, or nil), roots (PEM bytes, or nil: Mozilla's), waiting up to
  timeout ms for each (0: no limit); or [kind message] for TLS's failures, kind :verify,
  :handshake or :roots. The network's errors throw as java.net's."
  [^String host port ^String server-name ^String alpn ^bytes roots timeout]
  (let [s (TlsSocket.)]
    (try
      (.connect s (InetSocketAddress. host (int port)) (int timeout))
      (catch Throwable t
        (.close s)
        (throw t)))
    (let [err (make-array String 1)
          r (try
              (.startTls s server-name alpn roots (int timeout) err)
              (catch Throwable t
                (.close s)
                (throw t)))]
      (if (zero? r)
        s
        (do (.close s)
            (case (int r)
              -11 [:verify (aget ^objects err 0)]
              -12 [:handshake (aget ^objects err 0)]
              -13 [:roots (aget ^objects err 0)]
              (throw (HostNet/exception (int r) (aget ^objects err 0) "Read timed out"))))))))

(defn session
  "The session of TlsSocket s as a map (:application-protocol \"\" when none)."
  [^TlsSocket s]
  (let [^objects info (.session s)]
    (when info
      {:protocol (aget info 0) :cipher-suite (aget info 1)
       :application-protocol (aget info 2) :server-name (aget info 3)})))

(defn peer-certificates
  "The peer's certificates of TlsSocket s, DER, its own first."
  [^TlsSocket s]
  (seq (.peerCertificates s)))

(ns arbace.cpp.check
  "The judges of bin/cppi (doc/cpp/LLVM.md §9, §10; doc/cpp/CPP-SURVEY.md, \"As built: CX6 (write-ahead)\", \"As built: CX7
  (write-ahead)\", \"As built: review 007's fixes\"): `judge`, lower-check's verdict on each file of a list from the levels its
  steps left in WORK, against the known file and the recorded results; `runtime-judge`, runtime-build's on each unit. Apart
  from arbace.cpp.lower since review 007, so that a change of a judge does not change the lowered runtime's key."
  (:require [arbace.string :as str]))

(set! *warn-on-reflection* true)

(defn- slurp? [^String p] (let [f (java.io.File. p)] (when (.exists f) (str/trim (slurp f)))))
(defn- same-bytes? [^String a ^String b]
  (let [fa (java.io.File. a) fb (java.io.File. b)]
    (and (.exists fa) (.exists fb)
         (java.util.Arrays/equals (java.nio.file.Files/readAllBytes (.toPath fa)) (java.nio.file.Files/readAllBytes (.toPath fb))))))

(defn oracle-rejection?
  "Whether a compile's status and log are clang rejecting the source (review 007's finding 2): status 1 and one of clang's
  own diagnostics (`FILE:LINE:COL: error:` or `fatal error:`) in the log. Any other failure (a timeout of ours, 124; a tool
  missing, 126 or 127; a signal, 128 and up; a missing file or another driver error, `clang++: error: ...`) is not the
  oracle's verdict on the source."
  [status ^String log]
  (boolean (and (= status "1") log (re-find #"(?m)^[^\s:][^:\n]*:[0-9]+:[0-9]+: (fatal )?error: " log))))

(defn run-verdict
  "The lowered run (LD's low.status, low.out, low.err) against the original's (OD's orig.*): no-original, none, not-comparable,
  differs, stderr-differs or same. OD and LD are a file's directory (with its trailing /), the same one but for the negative
  controls (GTS81 (a))."
  [^String od ^String ld]
  (let [orig (slurp? (str od "orig.status")) low (slurp? (str ld "low.status"))
        ;; the run: the status, stdout and stderr the original's (review 007's finding 6: uncaught.cpp's terminate message, the
        ;; testsuite's assertion messages are on stderr)
        ;; a run is comparable only when it ended by itself (review 007's finding 12): not our timeout (124), not a signal
        ;; (128 and up) but the program's own abort (134), its output not cut at bin/cppi's cap (1 MB, the program then dies
        ;; of SIGPIPE)
        ;; stderr is capped likewise (review 018's R7: bin/cppi's runs are limited to a 1 MiB file, SIGXFSZ past it): a stderr at the
        ;; cap was cut, and two cut streams agree on their first MiB only
        comparable? (fn [status ^String d out err]
                      (and (re-matches #"[0-9]+" status)
                           (let [n (Long/parseLong status)] (and (not= n 124) (or (< n 128) (= n 134))))
                           (< (.length (java.io.File. ^String (str d out))) 1048576)
                           (< (.length (java.io.File. ^String (str d err))) 1048576)))]
    (cond (nil? orig) "no-original" (nil? low) "none"
          (not (and (comparable? orig od "orig.out" "orig.err") (comparable? low ld "low.out" "low.err"))) "not-comparable"
          (not (and (= orig low) (same-bytes? (str od "orig.out") (str ld "low.out")))) "differs"
          (not (same-bytes? (str od "orig.err") (str ld "low.err"))) "stderr-differs"
          :else "same")))

;; GTS81 (a), queue 064: the negative controls (test/cpp/controls.edn beside the known file: [{:id :subject NAME :reference NAME
;; :why}...]): the subject's lowered run judged by run-verdict against the reference's original run; it must differ

(defn control-result
  "A control judged: :differs, :passes (the run's comparison passes what differs), :not-judged (the reference in the run with
  no original run), :left (the subject or the reference not in the run, the subject not run or its run not comparable)."
  [^String work names {:keys [subject reference]}]
  (let [in (set names)]
    (if-not (and (in subject) (in reference))
      :left
      (case (run-verdict (str work "/files/" reference "/") (str work "/files/" subject "/"))
        ("differs" "stderr-differs") :differs
        "same" :passes
        "no-original" :not-judged
        :left))))

(defn file-result
  "One file's levels and outcome: {:name :outcome :ir :rt :obj :lower :gcc :run :gxx}; outcome :pass, :oracle-rejected
  (clang rejects the file with its own diagnostics: not a lowering's case), :ir (the IR was not made for another reason:
  a failure of the check's), or the first level that did not hold."
  [^String work ^String n]
  (let [d (str work "/files/" n "/")
        st #(slurp? (str d %))
        ir (st "ir.status")
        rt (some-> (st "rt.status") (str/split #"\t") first)
        obj (or (st "object") "none")
        refused (st "lower.refused")
        gcc (st "gcc.status")
        orig (st "orig.status") low (st "low.status")
        ;; the run: the status, stdout and stderr the original's (review 007's finding 6: uncaught.cpp's terminate message, the
        ;; testsuite's assertion messages are on stderr)
        ;; a run is comparable only when it ended by itself (review 007's finding 12): not our timeout (124), not a signal
        ;; (128 and up) but the program's own abort (134), its output not cut at bin/cppi's cap (1 MB, the program then dies
        ;; of SIGPIPE)
        ;; stderr is capped likewise (review 018's R7: bin/cppi's runs are limited to a 1 MiB file, SIGXFSZ past it): a stderr at the
        ;; cap was cut, and two cut streams agree on their first MiB only
        run (run-verdict d d)
        gxx (cond (nil? (st "gxx.status")) "none"
                  (and (= orig (st "gxx.status")) (same-bytes? (str d "orig.out") (str d "gxx.out"))) "agrees" :else "differs")
        no-main (= "1" (st "no-main"))
        run (if (and no-main (= gcc "0")) "no-main" run)
        outcome (cond
                  (and (not= ir "0") (oracle-rejection? ir (st "ir.log"))) :oracle-rejected
                  (not= ir "0") :ir
                  (and (not no-main) (not= (st "orig-link.status") "0")) :original-link
                  (not= rt "ok") :forms
                  (not= obj "same") :object
                  refused :lowering
                  (not= gcc "0") :gcc
                  (not (#{"same" "no-main"} run)) :run
                  :else :pass)]
    {:name n :outcome outcome :ir ir :rt rt :obj obj :lower (if refused (first (str/split refused #"\t")) "ok") :gcc (or gcc "-")
     :run run :gxx gxx :orig-status orig :low-status low}))

(defn judge
  "WORK/results.tsv and WORK/summary.edn from the files' levels against the known file (NAME -> class): a non-pass is known
  when its name is listed, else failing; and against the recorded results (test/cpp/lower-results.edn's :files, NAME ->
  [status outcome]; review 007's finding 2): a file recorded :pass that does not pass is a regression, failing whatever
  else holds (an oracle rejection or a known class included). A list with no file is refused.

  A run of a recorded list is held to the whole list (review 018's R4): the record's summaries (:samples, :libstdcxx-every-15th:
  top-level keys whose map has :files) each own the names of :files that start with one of its `:prefixes` (`{:samples
  [\"samples/\" \"runtime/\"]}`; the one summary without prefixes owns the rest). RECORDED is a summary's key (\"samples\"): the run
  is that list; \"none\": no list; else (nil, \"auto\") the list the header line `#list KEY` of the run's list names (WORK/list.key, which
  bin/cppi lower-check writes from it; no header: no recorded list; a header key without a summary: refused, exit 2 (re-review 032's F6); review 018's CP132 (b), the heuristic
  of more than half the names gone). A run of a recorded list
  fails when a name recorded for it is missing from the run, or when the run's count is not the summary's :files."
  ([^String work ^String known-path] (judge work known-path nil nil))
  ([^String work ^String known-path ^String results-path] (judge work known-path results-path nil))
  ([^String work ^String known-path ^String results-path ^String recorded-mode]
  (let [known (if (.exists (java.io.File. known-path)) (read-string (slurp known-path)) {})
        rec-all (if (and results-path (.exists (java.io.File. results-path))) (read-string (slurp results-path)) {})
        recorded (:files rec-all {})
        prefixes (:prefixes rec-all {})
        summaries (into {} (filter (fn [[k v]] (and (map? v) (number? (:files v)) (not= k :cx6))) rec-all))
        claimed? (fn [nm] (some (fn [[_ ps]] (some #(str/starts-with? nm %) ps)) prefixes))
        group-of (fn [k] (set (for [nm (keys recorded)
                                    :when (if-let [ps (get prefixes k)] (some #(str/starts-with? nm %) ps) (not (claimed? nm)))]
                                nm)))
        names (for [l (str/split-lines (slurp (str work "/list.tsv"))) :when (and (seq l) (not (str/starts-with? l "#")))] (first (str/split l #"\t")))
        _ (when (empty? names) (println "lower-check: the list has no file") (System/exit 2))
        rs (mapv #(file-result work %) names)
        run-names (set names)
        ;; CP132 (b): the list's header line, written to WORK/list.key; a key that is no summary is refused (exit 2, re-review 032's F6), as an unknown RECORDED is
        header-key (let [f (java.io.File. (str work "/list.key"))]
                     (when (.exists f) (let [k (str/trim (slurp f))] (when (seq k) (keyword k)))))
        listed (cond (= recorded-mode "none") nil
                     (and recorded-mode (not= recorded-mode "auto")) (keyword recorded-mode)
                     :else header-key)
        _ (when (and listed (not (contains? summaries listed)))
            (println (str "lower-check: no recorded list " listed)) (System/exit 2))
        rec-missing (when listed (vec (sort (remove run-names (group-of listed)))))
        rec-count-bad (when listed (not= (count run-names) (:files (get summaries listed))))
        recorded-bad (boolean (when listed (or (seq rec-missing) rec-count-bad)))
        regression? (fn [r] (and (= :pass (first (get recorded (:name r)))) (not= :pass (:outcome r))))
        ;; a known file is known only at the level its class names (review 007's finding 8): a refusal's class at the lowering
        ;; with that refusal, the run classes at the run
        fits? (fn [r] (let [c (get known (:name r))]
                        (case c
                          nil false
                          ;; the run classes: the lowered run differs from the original's (review 018's R6: not a timeout or a
                          ;; run that cannot be compared)
                          (:uncaught-cleanups :native-callback-throw) (and (= :run (:outcome r)) (contains? #{"differs" "stderr-differs"} (:run r)))
                          (and (= :lowering (:outcome r)) (= (name c) (:lower r))))))
        status (fn [r] (cond (= :pass (:outcome r)) :pass (regression? r) :failing (= :oracle-rejected (:outcome r)) :oracle-rejected
                             (fits? r) :known :else :failing))
        lines (for [r rs] (str/join "\t" [(:name r) (name (status r)) (name (:outcome r)) (:rt r) (:obj r) (:lower r) (:gcc r) (:run r) (:gxx r)
                                         (or (:orig-status r) "-") (or (:low-status r) "-") (if-let [c (get known (:name r))] (name c) "-")]))
        cnt (fn [k] (count (filter #(= k (status %)) rs)))
        by (fn [f] (into (sorted-map) (frequencies (map f rs))))
        summary {:files (count rs) :pass (cnt :pass) :known (cnt :known) :failing (cnt :failing) :oracle-rejected (cnt :oracle-rejected)
                 :outcomes (by (comp name :outcome)) :forms (by #(or (:rt %) "-")) :objects (by :obj) :lowering (by :lower)
                 :gxx (by :gxx) :regressions (count (filter regression? rs))
                 :recorded-list (when listed (name listed)) :recorded-missing (count rec-missing)
                 :known-classes (into (sorted-map) (frequencies (keep #(when (= :known (status %)) (name (get known (:name %)))) rs)))}]
    (spit (str work "/results.tsv") (str "name\tstatus\toutcome\tforms\tobject\tlowering\tgcc\trun\tgxx\torig\tlow\tclass\n" (str/join "\n" lines) "\n"))
    (spit (str work "/summary.edn") (str (pr-str summary) "\n"))
    (println (str "lower-check: " (count rs) " files, " (:pass summary) " pass, " (:known summary) " known, " (:failing summary) " failing, "
                  (:oracle-rejected summary) " rejected by the oracle"))
    (doseq [r rs :when (= :failing (status r))]
      (println "  failing:" (:name r) (name (:outcome r)) (:lower r) (if (regression? r) "(recorded :pass)" "")
               (if-let [c (get known (:name r))] (str "(known as " (name c) ")") "")))
    (when recorded-bad
      (println (str "lower-check: the run of the recorded list " (name listed) " has " (count run-names) " files, the record " (:files (get summaries listed))
                    "; " (count rec-missing) " recorded names missing" (when (seq rec-missing) (str ": " (str/join " " (take 8 rec-missing)))))))
    (let [cf (java.io.File. (str (.getParent (.getAbsoluteFile (java.io.File. known-path))) "/controls.edn"))
          cbad (some true? (doall (for [{:keys [id subject reference] :as c} (if (.exists cf) (remove :level (read-string (slurp cf))) [])
                                        :let [v (control-result work names c)]]
                                    (do (println (case v
                                                   :differs (str "lower-check: control " id " (" subject "'s lowered run against " reference "'s original): differs, as a control must (GTS81 (a))")
                                                   :passes (str "lower-check: control passed: " id " (" subject "'s lowered run against " reference "'s original): the comparison passes what differs")
                                                   :not-judged (str "lower-check: control not judged: " id ": " reference " has no original run")
                                                   :left (str "lower-check: control " id ": left (" subject " or " reference " not in the run, or not comparable)")))
                                        (contains? #{:passes :not-judged} v)))))]
      (when (or recorded-bad (pos? (:failing summary)) cbad) (System/exit 1))))))

(defn runtime-judge
  "OUT/results.tsv and OUT/summary.edn of bin/cppi runtime-build: each unit's levels (the oracle's IR, the forms' round trip, the
  objects, the lowering, gcc); every unit of test/cpp/runtime/units.edn is to pass them all."
  [^String out]
  (let [units (for [l (str/split-lines (slurp (str out "/units.tsv"))) :when (seq l)] (first (str/split l #"\t")))
        rs (vec (for [u units]
                  (let [d (str out "/units/" u "/") st #(slurp? (str d %))
                        ir (st "ir.status") rt (some-> (st "rt.status") (str/split #"\t") first)
                        obj (or (st "object") "none") refused (st "lower.refused") gcc (st "gcc.status")
                        outcome (cond (not= ir "0") :ir (not= rt "ok") :forms (not= obj "same") :object refused :lowering
                                      (not= gcc "0") :gcc :else :pass)]
                    {:unit u :outcome outcome :ir (or ir "-") :forms (or rt "-") :object obj
                     :lower (if refused (first (str/split refused #"\t")) "ok") :gcc (or gcc "-")})))
        by (fn [f] (into (sorted-map) (frequencies (map f rs))))
        summary {:units (count rs) :pass (count (filter #(= :pass (:outcome %)) rs)) :outcomes (by (comp name :outcome))
                 :objects (by :object) :lowering (by :lower)
                 :libsupc++ (count (filter #(str/starts-with? (:unit %) "libsupc++/") rs))
                 :libstdc++exp (count (filter #(str/starts-with? (:unit %) "exp/") rs))}]
    (spit (str out "/results.tsv") (str "unit\toutcome\tir\tforms\tobject\tlowering\tgcc\n"
                                        (str/join "\n" (for [r rs] (str/join "\t" [(:unit r) (name (:outcome r)) (:ir r) (:forms r) (:object r) (:lower r) (:gcc r)])))
                                        "\n"))
    (spit (str out "/summary.edn") (str (pr-str summary) "\n"))
    (println (str "runtime-build: " (count rs) " units, " (:pass summary) " pass"))
    (doseq [r rs :when (not= :pass (:outcome r))] (println "  failing:" (:unit r) (name (:outcome r)) (:lower r)))
    (when (not= (:pass summary) (count rs)) (System/exit 1))))

;; ---------------------------------------------------------------------------------------------
;; The run checks (bin/cppi check, check --aot; doc/cpp/CPP-SURVEY.md, "As built: CX8 (write-ahead)"): C's judge
;; (arbace.c.run/result) for C++: g++'s run recorded (test/cpp/ref-gxx15.edn), stderr compared too

(defn- tsv [^String f]
  (let [x (java.io.File. f)]
    (if (.exists x) (mapv #(str/split % #"\t" -1) (remove str/blank? (str/split-lines (slurp x)))) [])))

(defn- read-all-forms [^String f]
  (let [r (arbace.lang.LineNumberingPushbackReader. (java.io.StringReader. (slurp f))) eof (Object.)]
    (loop [out []] (let [x (read r false eof)] (if (identical? x eof) out (recur (conj out x)))))))

(defn run-result
  "A program's result: [id result reason], result :pass, :fail or the build's status (:oracle-rejected, :ir-error,
  :lower-refused, :read-error, :check-error, :refused, :build-error). node: [id status class message flags secs]; run:
  [id status stdout-sum bytes fault stderr-sum secs]; ref: g++'s run. The status and stdout and stderr g++'s, or, when g++'s -O0
  and -O2 runs differ, the status alone."
  [id ref node run]
  (let [[_ nst ncls nmsg flags] node
        fl (set (str/split (str flags) #" "))
        ld (if (fl "long-double") " uses-long-double" "")
        ;; review 191, F2: the program's functions that read their va_list inline (va-arg=NAME,...): a fault in one is the class va-arg
        va (set (mapcat #(str/split (subs % 7) #",") (filter #(str/starts-with? % "va-arg=") fl)))
        va-fault? (fn [fault] (when-let [[_ f] (re-find #"fault: .* in (\S+)" (str fault))] (contains? va f)))
        ;; the flag once (review 191's low: a runtime unit's refusal carries it in its message already)
        with-ld (fn [^String r] (if (str/ends-with? r " uses-long-double") r (str r ld)))]
    (cond
      (nil? ref) [id :fail "no g++ run recorded (bin/cppi record-ref)"]
      (nil? node) [id :fail "not built"]
      (not= nst "ok") [id (keyword nst) (with-ld (str (when (seq ncls) (str ncls ": ")) nmsg))]
      (nil? run) [id :fail "not run"]
      :else
      (let [[_ st sum _ fault esum] run
            want (:status ref)
            st (if (= st "timeout") :timeout (Long/parseLong st))
            same-status (= st want)
            loose (= :differ (:o2 ref))]
        (cond
          ;; never flagged long-double (review 191, F1): the runner's failure is no program's layout
          (re-find #"^(ci(run|aot): internal|fatal error: |runtime: )" (str fault)) [id :fail (str "internal: " fault)]
          (and same-status (or loose (and (= sum (:stdout ref)) (= esum (:stderr ref))))) [id :pass ""]
          :else [id :fail (str (cond (not same-status) (str "differ status " (if (keyword? st) (name st) st) " (g++ " (if (keyword? want) (name want) want) ")")
                                     (not= sum (:stdout ref)) "differ stdout"
                                     :else "differ stderr")
                               (when (seq fault) (str " " fault)) (when (va-fault? fault) " uses-va-arg") ld)])))))

(defn- ir-row
  "The build row of a program whose IR the oracle did not make: clang's rejection (its own diagnostics) or another failure."
  [^String work id]
  (let [d (str work "/files/" id "/")
        st (slurp? (str d "ir.status")) log (slurp? (str d "ir.log"))]
    (if (oracle-rejection? st log)
      [id "oracle-rejected" "" (str/replace (str (first (filter #(re-find #"error" %) (str/split-lines log)))) #"^\S*/gcc-15\.2\.0/" "") ""]
      [id "ir-error" "" (str "status " st) ""])))

(defn run-judge
  "run-judge WORK LEVEL [--record] CORPUS...: LEVEL eval (bin/cppi check: WORK/CORPUS/nodes.tsv, run.tsv) or aot (check --aot:
  the same, and the interpreted record beside); each program's result against g++'s run and the classes (test/cpp/divergences.edn;
  aot: divergences-aot.edn first), the committed record (arbace.c.run/compare-record), the negative controls (test/cpp/controls.edn,
  :level :run). --record rewrites the level's record and its times."
  [[work level & more]]
  (require 'arbace.c.run)
  (let [record (some #{"--record"} more)
        ;; --sample N (cppi-check, 2026-11-05): a sampling of the corpora (every Nth program, bin/cppi check --sample N) held to
        ;; its own record, test/cpp/check[-aot]-every-N-linux-amd64.edn, which --record writes (the sampled corpora's reference,
        ;; test/cpp/ref-gxx15.edn, holds every 25th program of libstdcxx and gxx-dg-run)
        sample (second (drop-while #(not= "--sample" %) more))
        corpora (let [xs (vec more)
                      i (.indexOf ^java.util.List xs "--sample")
                      xs (if (neg? i) xs (into (subvec xs 0 i) (subvec xs (min (count xs) (+ i 2)))))]
                  (remove #{"--record" ""} xs))
        aot (= level "aot")
        every (when sample (str "-every-" sample))
        recf (str "test/cpp/check" (when aot "-aot") every "-linux-amd64.edn")
        timesf (str "test/cpp/check" (when aot "-aot") every "-times-linux-amd64.edn")
        _ (when-let [m (and record (not sample) ((resolve 'arbace.c.run/subset-record-refusal) work corpora))]
            (println "cppi judge:" m) (System/exit 2))
        refs (into {} (map (juxt :id identity) (read-all-forms "test/cpp/ref-gxx15.edn")))
        classes (into (if aot (vec (read-string (slurp "test/cpp/divergences-aot.edn"))) [])
                      (read-string (slurp "test/cpp/divergences.edn")))
        klass (fn [[_ r reason]]
                (let [s (str (name r) " " reason)]
                  (some (fn [c] (when (some #(re-find % s) (:match c)) (:id c))) classes)))
        ;; test/cpp/check-known.edn: {ID REASON}, a program whose non-pass needs a reason its row cannot show (C's check-known.edn)
        known (let [f (java.io.File. "test/cpp/check-known.edn")] (if (.exists f) (read-string (slurp f)) {}))
        interp (when aot (let [f (java.io.File. (str "test/cpp/check" every "-linux-amd64.edn"))] (if (.exists f) (into {} (map (juxt first identity) (read-string (slurp f)))) {})))
        rows (vec (for [c corpora
                        :let [nodes (into {} (map (juxt first identity) (tsv (str work "/" c "/nodes.tsv"))))
                              runs (into {} (map (juxt first identity) (tsv (str work "/" c "/run.tsv"))))]
                        [id] (tsv (str work "/" c "/list.tsv"))]
                    (let [node (let [n (get nodes id)] (if (and n (= "ir-missing" (second n))) (ir-row work id) n))
                          row (run-result id (get refs id) node (get runs id))
                          kr (get known id)
                          row (if (and (not= :pass (second row)) kr (not (str/starts-with? (str (nth row 2)) "internal: ")))
                                [id :fail (str "known " kr " (" (nth row 2) ")")]
                                row)
                          row (if (= :pass (second row)) row (conj row (klass row)))]
                      (if aot (conj (if (= 3 (count row)) (conj row nil) row) (second (get interp id))) row))))
        cmp ((resolve 'arbace.c.run/compare-record) rows recf corpora)
        ;; review 191, F1: a recorded non-pass whose class changes (a long-double check error that now segfaults) is a regression
        ;; too; compare-record sees only a recorded pass that fails and a changed known reason
        cmp (let [old (let [f (java.io.File. recf)] (if (.exists f) (read-string (slurp f)) []))
                  now (into {} (map (juxt first identity) rows))
                  moved (vec (for [[id r reason :as o] old
                                   :when (some #(str/starts-with? id (str % "/")) corpora)
                                   :let [n (get now id)]
                                   :when (and n (not= :pass r) (not= :pass (second n)) (not= (klass o) (nth n 3 nil)))]
                               [id (str "recorded " (name r) " in class " (some-> (klass o) name) ", now " (name (second n)) " " (nth n 2)
                                        " in class " (some-> (nth n 3 nil) name))]))]
              (update cmp :regressions into moved))
        failing (filter #(and (not= :pass (second %)) (nil? (nth % 3 nil))) rows)
        controls (filterv #(= :run (:level %)) (read-string (slurp "test/cpp/controls.edn")))
        cfail (vec (for [{:keys [id subject reference]} controls
                         :let [c (first (str/split subject #"/"))
                               in (and (some #{c} corpora) (some #(= subject (first %)) (tsv (str work "/" c "/list.tsv"))))
                               node (get (into {} (map (juxt first identity) (tsv (str work "/" c "/nodes.tsv")))) subject)
                               run (get (into {} (map (juxt first identity) (tsv (str work "/" c "/run.tsv")))) subject)
                               ref (get refs reference)
                               v (cond (not in) :left (nil? ref) :not-judged (or (nil? run) (not= "ok" (second node))) :left
                                       (= :pass (second (run-result subject ref node run))) :passes :else :differs)
                               _ (println (str "cppi judge: control " id " (" subject " against " reference "'s g++ run): "
                                               (case v :differs "differs, as a control must (GTS81 (a))" :passes "PASSES: the judge passes what differs"
                                                     :not-judged "not judged: no g++ run of the reference" :left "left (not in the run, not built or not run)")))]
                         :when (#{:passes :not-judged} v)]
                     [id :fail (str "control " (name v) " (test/cpp/controls.edn)")]))]
    (spit (str work "/results-" level ".edn") (str "[\n" (str/join "\n" (map pr-str rows)) "\n]\n"))
    (doseq [c corpora]
      (let [rs (filter #(str/starts-with? (first %) (str c "/")) rows)
            by (frequencies (map #(if (= :pass (second %)) :pass (or (nth % 3 nil) :fail)) rs))]
        (println (format "%-12s %5d programs: %s" c (count rs) (str/join ", " (map (fn [[k v]] (str (name k) " " v)) (sort-by (comp - val) by)))))))
    (when aot
      (let [both (frequencies (map (fn [r] [(= :pass (second r)) (= :pass (nth r 4 nil))]) rows))]
        (println "compiled against interpreted (the record):" (get both [true true] 0) "both pass," (get both [false false] 0) "neither,"
                 (get both [true false] 0) "compiled only," (get both [false true] 0) "interpreted only")))
    (when record
      (let [old (if (.exists (java.io.File. recf)) (read-string (slurp recf)) [])
            in? (fn [id] (some #(str/starts-with? id (str % "/")) corpora))
            all (sort-by first (concat (remove (comp in? first) old) (map (fn [[id r reason]] [id r reason]) rows)))
            told (if (.exists (java.io.File. timesf)) (read-string (slurp timesf)) {})
            tnew (into {} (for [c corpora [id ir lw b r] (tsv (str work "/" c "/times.tsv"))]
                            [id (mapv #(if (re-matches #"[0-9.]+" (str %)) (Double/parseDouble %) nil) [ir lw b r])]))
            tall (into (sorted-map) (concat (remove (comp in? key) told) tnew))]
        (spit recf (str ";; cppi's " (if aot (str "AOT check (bin/cppi check --aot" (when sample (str " --sample " sample)) " --record): each program of the run corpora compiled by cf2g")
                                         (str "check (bin/cppi check" (when sample (str " --sample " sample)) " --record): each program of the run corpora run on ci"))
                        (when sample (str ",\n;; a sampling: every " sample "th program of each corpus's list (bin/lib/cppi/lists.bash), not the whole corpora"))
                        ",\n;; [ID RESULT REASON], against g++ 15.2's -O0 run (test/cpp/ref-gxx15.edn); its classes "
                        (if aot "test/cpp/divergences-aot.edn, then " "") "test/cpp/divergences.edn.\n[\n"
                        (str/join "\n" (map pr-str all)) "\n]\n"))
        (spit timesf (str ";; each program's seconds in bin/cppi check" (if aot " --aot" "") "'s last recorded run (GT8, GTS205's subsets): ID [IR "
                          (if aot "BUILD TRANSLATE RUN" "LOWER BUILD RUN") "], the light tier's (4 jobs, 3 threads); nil: the step did not run.\n{\n"
                          (str/join "\n" (for [[k v] tall] (str " " (pr-str k) " " (pr-str v)))) "\n}\n"))
        (println "recorded" recf "and" timesf)))
    (let [fids (set (map first failing))
          failing (concat failing (remove #(fids (first %)) ((resolve 'arbace.c.run/report-record) cmp)) cfail)]
      (doseq [r (take 40 failing)] (println "FAIL" (first r) (nth r 2)))
      (System/exit (if (seq failing) 1 0)))))

(defn divergences
  "divergences LEVEL [N]: the recorded check's non-passes (test/cpp/check-linux-amd64.edn, aot: check-aot-linux-amd64.edn; with N
  the sampling's record, check[-aot]-every-N-linux-amd64.edn), each in a class or listed UNCLASSED."
  [level & [n]]
  (let [aot (= level "aot")
        rows (read-string (slurp (str "test/cpp/check" (when aot "-aot") (when n (str "-every-" n)) "-linux-amd64.edn")))
        classes (into (if aot (vec (read-string (slurp "test/cpp/divergences-aot.edn"))) []) (read-string (slurp "test/cpp/divergences.edn")))
        klass (fn [[_ r reason]] (let [s (str (name r) " " reason)] (some (fn [c] (when (some #(re-find % s) (:match c)) (:id c))) classes)))
        non (remove #(= :pass (second %)) rows)
        by (group-by klass non)]
    (println (count rows) "programs," (- (count rows) (count non)) "pass")
    (doseq [c classes] (println (format "  %-24s %5d  %s" (name (:id c)) (count (get by (:id c))) (:title c))))
    (doseq [r (get by nil)] (println "UNCLASSED" (pr-str r)))
    (System/exit (if (seq (get by nil)) 1 0))))

(defn -main
  "bin/cppi's judges: judge WORK KNOWN [RESULTS], runtime-judge OUT, run-judge WORK LEVEL [--record] CORPUS..., divergences LEVEL."
  [verb & args]
  (case verb
    "judge" (let [[work known results recorded] args] (judge work known results recorded))
    "runtime-judge" (runtime-judge (first args))
    "run-judge" (run-judge args)
    "divergences" (divergences (or (first args) "eval") (second args))
    (do (println "cppi check: judge or runtime-judge") (System/exit 2))))

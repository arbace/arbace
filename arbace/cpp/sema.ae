                (cond
                  (= :str (:op a)) (let [us (str-units a)
                                         n (long (or (:n (abi/unq (:ty a))) (inc (count us))))
                                         el (:of (abi/unq (:ty a)))
                                         cs (mapv #(ce-wrap el %) us)]

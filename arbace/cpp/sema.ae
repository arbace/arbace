       ;; (cpp-rt-own: the bit counts and byte swaps folded as clang's ExprConstant does them, BI__builtin_popcount, clz, ctz and
       ;; bswap with their g forms: a zero's clz or ctz is not a constant but by the fallback operand; memory_resource.cc's
       ;; constexpr pool sizes over std::__bit_width)
       :bitop (let [t (abi/unq (:ty (:e e)))
                    bits (int (* 8 (long (abi/size-of t))))
                    m (.shiftLeft java.math.BigInteger/ONE bits)
                    x (.mod (biginteger (ce-num (ev (:e e)))) m)
                    zero? (zero? (.signum x))
                    fb #(if (:fb e) (ce-num (ev (:fb e))) (not-constant "a bit count of zero"))]
                (case (:which e)
                  :ctpop (long (.bitCount x))
                  :ctlz (if zero? (fb) (long (- bits (.bitLength x))))
                  :cttz (if zero? (fb) (long (.getLowestSetBit x)))
                  :bswap (let [n (quot bits 8)
                               r (reduce (fn [^java.math.BigInteger acc ^long i]
                                           (.or (.shiftLeft acc 8) (.and (.shiftRight x (int (* 8 i))) (biginteger 0xff))))
                                         java.math.BigInteger/ZERO (range n))]
                           (ce-wrap t r))
                  (not-constant "the bit operation " (:which e))))
       ;; (cpp-p2564, the checker: a function's address and a call through it, in global-init's judgment of P2564's enclosing
       ;; expression alone, *ce-fnptr*)
       :fnaddr (if (and *ce-fnptr* (:fn e)) {::fnp (:fn e)} (not-constant "the expression :fnaddr"))
       :icall (let [p (when *ce-fnptr* (ev (:callee e)))]
                (if-let [fid (and (map? p) (::fnp p))]
                  (ev {:op :call :fn fid :args (:args e) :ty (:ty e) :cat (:cat e) :cx-at (:cx-at e)})
                  (not-constant "the expression :icall")))
       (not-constant "the expression " (:op e))))))



(defn- ce-exec
  "Executes a constexpr function's typed statement: [:normal], [:ret v], [:break] or [:continue]."
  [s env]
  ;; (CP378 (a): an if consteval's run-time branch carries the other as ::ce-alt in its metadata, taken when the evaluation
  ;; is manifestly constant-evaluated: std::__is_constant_evaluated()'s `if consteval { return true; } else { return false; }`)
  (if-let [alt (when *ce-manifest* (::ce-alt (meta s)))]
    (if (= :refused alt) (not-constant "an if consteval's branch not analyzed") (ce-exec alt env))
  (case (:s s)
    (nil :null) [:normal]
    :block (let [env (atom env) env0 @env
                 ;; (cpp-ce2: the block's objects in their declarations' order, destroyed in the reverse at its end)
                 order (atom [])
                 ext (atom [])
                 r (loop [[x & more] (mapcat #(if (:flat %) (:items %) [%]) (:items s))]
               (if (nil? x) [:normal]
                   (if (= :decl (:s x))
                     (let [_ (when-let [p (:cx-at x)] (when *ce-pos* (reset! *ce-pos* p)))
                           v (var* (:var x)) init (:init x)
                           ;; (cpp-s4: a local array of scalars from a list, its elements' values a vector; [dcl.init.aggr]/5's
                           ;; elements without an initializer from the list's filler)
                           at (abi/unq (:ty v))
                           ;; (queue 569, the checker: GNU's variable-length array, the GCC manual's "Variable Length": its bound
                           ;; evaluated here, where the declaration is, and the array's elements so many; a braced list longer
                           ;; than the bound, an access past it ([expr.const]/5.8, undefined: [dcl.init.aggr]/3's explicitly
                           ;; initialized elements beyond the array's), GCC's "array subscript value ... is outside the bounds")
                           at (if-let [b (and (:vla at) (checking?) (:vla-n v))]
                                (let [k (long (ce-num (ce-eval b @env)))]
                                  (when (neg? k) (ce-sure! "the size of the variable-length array '" (:name v) "' is negative"))
                                  (when (and (= :list (:i init)) (> (count (:items init)) k))
                                    (ce-sure! "array subscript value '" k "' is outside the bounds of array '" (:name v) "'"))
                                  (assoc at :n k))
                                at)
                           arr? (and (abi/arr? at) (= :list (:i init)) (:n at) (not (abi/class? (abi/unq (:of at)))))
                           el (fn [i] (case (:i i) :expr (ce-wrap (:of at) (ce-eval (:e i) @env)) (:zero :none nil) 0 (not-constant "an element's initializer")))
                           ;; (CP374 (a): a local of an empty class, a captureless lambda's closure, holds nothing to read: its calls
                           ;; are evaluated without it, as ce-eval's :call does)
                           emp? (and (abi/class? at) (abi/empty-class? (:id at)))
                           ;; (CP378 (a): a class object by its initializer, ce-init: a constexpr constructor's, a copy, a
                           ;; list; one whose destructor is not trivial is not evaluated, the slice runs no destructor)
                           _ (when (and (= :ctor (:i init)) (ce-not-constexpr? (fnd (:fn init))))
                               (ce-sure! "call to non-'constexpr' function '" (:name (fnd (:fn init))) "'"))
                           ;; (cpp-ce2, the checker: from C++20 a constexpr destructor, [dcl.constexpr]/3, run at the block's end,
                           ;; ce-destroy!)
                           _ (when (and (abi/class? at) (not emp?) (not (trivial-dtor? (:id at)))
                                        (not (and (checking?) (>= (long *cxx-year*) 20))))
                               (not-constant "a local with a destructor (" (:name v) ")"))
                           val (ce-full-expr (cond
                                 ;; (cpp-sweep, the checker: an empty class's user-provided constructor still run, its errors the
                                 ;; evaluation's: cpp1y/constexpr-diag1.C's `Jam j;` whose Jam() calls a function not constexpr)
                                 emp? (do (when (and (checking?) (= :ctor (:i init)) (:body (fnd (:fn init))))
                                            (ce-init (:ty v) init @env))
                                          ::empty)
                                 arr? (let [xs (mapv el (:items init))]
                                        (into xs (repeat (- (long (:n at)) (count xs)) (el (:fill init)))))
                                 ;; (queue 569: a VLA with no list, its elements zero, as a fixed array's are here: the evaluator
                                 ;; reads no array element as indeterminate)
                                 (and (:vla at) (:n at) (#{:none :zero} (:i init))) (ce-zero-of at)
                                 (and (abi/arr? at) (= :string (:i init))) (ce-init (:ty v) init @env)
                                 ;; (cpp-vec, the checker: a local vector from a braced list, ce-init's :vec)
                                 (and (checking?) (= :vec (:k at)) (= :vec (:i init))) (ce-init (:ty v) init @env)
                                 ;; (cpp-sweep, the checker: a local array of class objects from a list, ce-init's, destroyed at
                                 ;; the block's end below: cpp2a/constexpr-dtor3.C's f5)
                                 (and (checking?) (abi/arr? at) (= :list (:i init)) (:n at) (abi/class? (abi/unq (:of at))))
                                 (ce-init (if (:vla at) at (:ty v)) init @env)
                                 (#{:expr :zero :none} (:i init)) (if (and (abi/class? at) (not= :expr (:i init)))
                                                                    (ce-init (:ty v) init @env)
                                                                    ;; (h-cpp-consteval, the checker: a scalar default-initialized,
                                                                    ;; its value indeterminate, [basic.indet], nil)
                                                                    (case (:i init) :expr (ce-init (:ty v) init @env) :none (if (and (checking?) (abi/scalar? at)) nil 0) 0))
                                 (and init (or (abi/class? at) (abi/ref? (:ty v))))
                                 (try (let [r (ce-init (:ty v) init @env)]
                                        ;; (n-review-b: a reference bound to a temporary's member or base subobject extends the
                                        ;; temporary's lifetime to the reference's, [class.temporary]/6, `const int& r = S{}.x;`:
                                        ;; its cell kept out of the full-expression's temporaries; not through a call's result)
                                        (when (and *ce-temps* (abi/ref? (:ty v)) (or (and (= :bind (:i init)) (ce-extended-temp? (:e init)))
                                                                                     (and (checking?) (= :bind-temp (:i init))))
                                                   (ce-loc? r))
                                          (let [c (::cell r)]
                                            (swap! *ce-temps* (fn [ts] (filterv #(not (identical? % c)) ts)))
                                            ;; (cpp-ce2: an extended temporary ends its life with the block, [class.temporary]/6)
                                            (when (checking?) (swap! ext conj c))))
                                        r)
                                      (catch arbace.lang.ExceptionInfo x
                                        (if (:codegen/not-constant (ex-data x))
                                          (throw (ex-info (str (.getMessage x) " (in a local's initializer (" (:i init) " of " (:name v) "))") (ex-data x)))
                                          (throw x))))
                                 :else (not-constant "a local's initializer (" (:i init) " of " (:name v) ")")))]
                       (let [c (atom (if (or arr? emp? (nil? val)) val (ce-store (:ty v) val)))]
                         (ce-adopt! c [] @c)
                         ;; (h-cpp-consteval: a const or constexpr object, const once initialized)
                         (when (and *ce-const* (not (abi/ref? (:ty v))) (or (:constexpr v) (ce-const-type? (:ty v))))
                           (swap! *ce-const* conj c))
                         (swap! env assoc (:var x) c)
                         (when-not (abi/ref? (:ty v)) (swap! order conj [(:var x) c])))
                       (recur more))
                     (let [r (ce-exec x @env)] (if (= :normal (first r)) (recur more) r)))))]
             ;; (cpp-ce2, the checker: each object of the block destroyed in the reverse order of its declaration,
             ;; [stmt.dcl]/2, [class.dtor]/14: a class's constexpr destructor run, ce-destroy!; one whose lifetime an explicit
             ;; destructor call already ended, GCC's "destroying ... outside its lifetime" at the block's closing brace)
             (when (checking?)
               (let [at (when (:cx-end s) {:cx-at (:cx-end s)})]
                 (doseq [[vid c] (rseq @order)]
                   (if (and *ce-dead* (contains? @*ce-dead* c))
                     (if at (ub! at "destroying '" (:name (var* vid)) "' outside its lifetime") (ce-sure! "destroying '" (:name (var* vid)) "' outside its lifetime"))
                     (let [u (abi/unq (:ty (var* vid)))]
                       (when (and (abi/class? u) (not= ::empty @c) (not (trivial-dtor? (:id u))))
                         (ce-destroy! (or at s) (:id u) {::cell c ::path []}))
                       ;; (an array's elements in the reverse order, [class.dtor]/13)
                       (when (and (abi/arr? u) (vector? @c) (>= (long *cxx-year*) 20))
                         (doseq [k (range (dec (count @c)) -1 -1) :let [x (nth @c k)]]
                           (when (and (map? x) (::cls x) (not (trivial-dtor? (::cls x))))
                             (ce-destroy! (or at s) (::cls x) {::cell c ::path [k]})))))))))
             (when (seq @ext) (ce-destroy-cells! (rseq @ext)) (ce-kill! @ext))
             ;; (h-cpp-consteval: the block's locals end their lifetimes)
             (when *ce-dead* (ce-kill! (for [[k c] @env :when (and (not (contains? env0 k)) (not (keyword? k)))] c)))
             r)
    :return (cond (:void-e s) [:ret 0] (:init s) [:ret (ce-full-expr (ce-init (::ret env) (:init s) env))] :else [:ret 0])
    :expr (do (ce-full-expr (ce-eval (:e s) env)) [:normal])
    :if (if (zero? (ce-num (ce-eval (:cond s) env))) (if (:else s) (ce-exec (:else s) env) [:normal]) (ce-exec (:then s) env))
    ;; (cpp-ce3, the checker: a loop's iterations bounded by GCC's -fconstexpr-loop-limit, [implimits]: past it GCC's error at the loop)
    :while (loop [k 0] (if (zero? (ce-num (ce-eval (:cond s) env))) [:normal]
                           (let [_ (ce-loop-limit! s k) r (ce-exec (:body s) env)] (case (first r) :ret r :break [:normal] (recur (inc k))))))
    :do (loop [k 0] (let [_ (ce-loop-limit! s k) r (ce-exec (:body s) env)]
                      (case (first r) :ret r :break [:normal]
                            (if (zero? (ce-num (ce-eval (:cond s) env))) [:normal] (recur (inc k))))))
    :for (loop [k 0] (if (and (:cond s) (zero? (ce-num (ce-eval (:cond s) env)))) [:normal]
                         (let [_ (ce-loop-limit! s k) r (ce-exec (:body s) env)]
                           (case (first r) :ret r :break [:normal]
                                 (do (when (:inc s) (ce-eval (:inc s) env)) (recur (inc k)))))))
    :break [:break]
    :continue [:continue]
    ;; (cpp-ce3: a statement expression's value, ce-eval's :stmt-expr)
    :se-value [:se-value (ce-eval (:e s) env)]
    ;; (h-cpp-consteval: a switch, [stmt.switch]: its body's statements from the label its condition's value selects, else
    ;; default's, labels passed through; a body declaring at its top not evaluated)
    (:case :default :label) (ce-exec (:body s) env)
    :switch (let [b (:body s)
                  items (when (= :block (:s b)) (vec (mapcat #(if (:flat %) (:items %) [%]) (:items b))))
                  _ (when (or (nil? items) (some #(= :decl (:s %)) items)) (not-constant "a switch's body"))
                  ;; (n-review-b: a case or default label below the body's top, inside a nested statement, is not found by
                  ;; the label scan: not a constant rather than a wrong branch)
                  _ (when (some #(ce-has-label? (loop [x %] (if (#{:case :default} (:s x)) (recur (:body x)) x))) items)
                      (not-constant "a switch's label inside a nested statement"))
                  v (ce-num (ce-eval (:e s) env))
                  labels (fn [x] (loop [x x ls []] (if (#{:case :default} (:s x)) (recur (:body x) (conj ls (if (= :case (:s x)) (:v x) :default))) ls)))
                  hit (or (first (keep-indexed (fn [i x] (when (some #(and (number? %) (= (ce-num %) v)) (labels x)) i)) items))
                          (first (keep-indexed (fn [i x] (when (some #{:default} (labels x)) i)) items)))]
              (if (nil? hit) [:normal]
                  (loop [i (long hit)]
                    (if (>= i (count items)) [:normal]
                        (let [r (ce-exec (nth items i) env)]
                          (case (first r) :normal (recur (inc i)) :break [:normal] r))))))
    ;; (h-cpp-consteval, the checker: [expr.const]/5.27 an asm-declaration, 5.28 a goto; [stmt.dcl]/? control through a static
    ;; or thread-local variable's definition, [expr.const]/5.2 of C++23's P2242)
    :asm (if (checking?) (ub! s "inline assembly is not a constant expression") (not-constant "the statement :asm"))
    :goto (if (checking?) (ub! s "'goto' is not a constant expression") (not-constant "the statement :goto"))
    :static-local (if (checking?)
                    (if (:cx-extern s) [:normal]
                    (let [v (var* (:var s))]
                      (ub! s "control passes through definition of '" (:name v) "' with " (if (:tls v) "thread" "static") " storage duration")))
                    (not-constant "the statement :static-local"))
    (not-constant "the statement " (:s s)))))

(defn- ce-destroy!
  "cpp-ce2 (the checker): the destruction of the object of class `cid` at location `l` ([class.dtor]/14): its destructor's
  body (a user-provided one: constexpr, [expr.const]/5.2, else GCC's \"call to non-'constexpr' function\"), then its non-static
  data members of class type with a non-trivial destructor and its bases, in the reverse order of their construction (a union's
  members none, [class.union.general]/3); `e` the node a refusal is put at."
  [e cid l]
  (let [c (abi/cls cid) d (some-> (:dtor c) fnd)]
    (when (and d (not (:implicit d)) (not (:defaulted d)))
      (when (ce-not-constexpr? d) (ub! e "call to non-'constexpr' function '" (:name d) "'"))
      (when-not (or (:constexpr d) (:consteval d)) (not-constant "a call of the destructor " (:name d)))
      (when-not (:tbody d)
        (when (:body d) (binding [*ce-manifest* false *ce-analyzing* (conj *ce-analyzing* (:id d))] (analyze-fn! (:id d)))))
      (let [d (fnd (:id d))]
        (when-not (:tbody d) (not-constant "a destructor without its body"))
        (when (>= (long *ce-depth*) (long *constexpr-depth*)) (not-constant "'constexpr' evaluation depth exceeded"))
        (binding [*ce-in-call* true *ce-depth* (inc (long *ce-depth*))]
          (ce-exec (:tbody d) {::this l ::ret abi/void}))))
    (when-not (:union c)
      (let [v (let [x @(::cell l)] (if (seq (::path l)) (get-in x (::path l)) x))]
        (doseq [f (reverse (:fields c)) :when (and (not (:static f)) (contains? v (:i f)))]
          (let [u (abi/unq (:ty f))]
            (when (and (abi/class? u) (not (trivial-dtor? (:id u))))
              (ce-destroy! e (:id u) (update l ::path conj (:i f))))))
        (doseq [b (reverse (:bases c))]
          (when-not (trivial-dtor? (:cls b))
            (ce-destroy! e (:cls b) (update l ::path conj [:b (:cls b)]))))))))

(defn- ce-explicit-dtor!
  "cpp-ce2 (the checker): an explicit destructor call, [class.dtor]/18: the object destroyed, ce-destroy!, its lifetime ended
  ([basic.life]/1.4); one already ended, GCC's \"destroying ... outside its lifetime\"; a subobject's not evaluated."
  [e env]
  (let [f (fnd (:fn e)) l (ce-lv (:obj e) env)]
    (when-not (ce-loc? l) (not-constant "a destructor's object"))
    (when (and *ce-dead* (contains? @*ce-dead* (::cell l))) (ub! e "destroying an object outside its lifetime"))
    (when (seq (::path l)) (not-constant "an explicit destructor call of a subobject"))
    (ce-destroy! e (:cls f) l)
    (ce-kill! [(::cell l)])
    0))

(defn- ce-base-paths
  "cpp-ce2: every base subobject of class `to` in an object of class `from`, [path public?] (non-virtual bases)."
  [from to]
  (if (= from to)
    [[[] true]]
    (mapcat (fn [b] (map (fn [[p pub]] [(into [[:b (:cls b)]] p) (and pub (= :public (:access b)))]) (ce-base-paths (:cls b) to)))
            (:bases (abi/cls from)))))

(defn- ce-dyncast
  "cpp-ce2 (the checker): dynamic_cast<T>(v) in a constant evaluation, [expr.dynamic.cast]/7-9 (P1327R1): the most derived object
  of v's object (its location's path less its trailing base steps; a member subobject's own class); to void*, that object; else
  the C object v's object is a public base subobject of (a downcast), else the unambiguous public base C of the most derived
  object, when v's is a public one of it (a crosscast); failing, a pointer's result null and a reference's GCC's \"reference
  'dynamic_cast' failed\" ([expr.const]/5.21's throw). A class with virtual bases, or an object under construction, no constant."
  [e env]
  (let [x (:e e) ref (:ref e)
        l (ce-res (if ref (ce-lv x env) (ce-eval x env)))]
    (if (and (not ref) (number? l) (zero? (double l)))
      0
      (let [_ (when-not (ce-loc? l) (not-constant "dynamic_cast of " (pr-str (type l))))
            p (vec (::path l))
            n0 (loop [k (count p)] (if (and (pos? k) (vector? (nth p (dec k)))) (recur (dec k)) k))
            p0 (subvec p 0 n0) tail (subvec p n0)
            v0 (let [v @(::cell l)] (if (seq p0) (get-in v p0) v))
            ;; (cpp-ce3: an object whose constructor is building its bases, [class.cdtor]/6: the dynamic type the base subobject's
            ;; own on the operand's path, constructed; one not constructed yet, its vtable pointer uninitialized)
            [p0 tail v0] (if (and (empty? p0) (seq tail) (contains? *ce-bases* (::cell l)))
                           (let [b (first tail) v1 (get v0 b)]
                             (when-not (map? v1) (ub! e "accessing uninitialized member"))
                             [[b] (subvec tail 1) v1])
                           [p0 tail v0])
            d (when (map? v0) (::cls v0))
            _ (when-not d (not-constant "dynamic_cast of an object of no class"))
            _ (when (abi/has-vbases? d) (not-constant "dynamic_cast in a class with virtual bases"))
            ;; the classes along the tail and whether each step is public
            steps (loop [c d ts (seq tail) acc []]
                    (if-let [[_ b] (first ts)]
                      (let [bs (first (filter #(= b (:cls %)) (:bases (abi/cls c))))]
                        (recur b (next ts) (conj acc [c (= :public (:access bs))])))
                      acc))
            cls-at (fn [k] (if (zero? k) d (second (nth tail (dec k)))))
            pub-from (fn [k] (every? second (subvec steps k)))
            dc (:to e)
            res (cond
                  (:void e) (assoc l ::path p0)
                  :else
                  (or (some (fn [k] (when (and (= dc (cls-at k)) (pub-from k)) (assoc l ::path (into p0 (subvec tail 0 k)))))
                            (range (count tail) -1 -1))
                      (when (pub-from 0)
                        (let [ps (ce-base-paths d dc)]
                          (when (and (= 1 (count ps)) (second (first ps)))
                            (assoc l ::path (into p0 (first (first ps)))))))))]
        (cond res res
              ref (ub! e "reference 'dynamic_cast' failed")
              :else 0)))))

(defn- ce-heap-cell
  "The cell of the allocation the pointer value `p` points to the start of (nil when it is none of the evaluation's)."
  [p]
  ;; (cpp-ce3: or a base subobject of it, a delete through a pointer to a base, [expr.delete]/3: the most derived object's)
  (cond (ce-loc? p) (let [l (ce-res p)] (when (every? vector? (::path l)) (::cell l)))
        (ce-ptr? p) (let [b (::base p)] (when (and (ce-loc? b) (zero? (long (::i p)))) (let [l (ce-res b)] (when (empty? (::path l)) (::cell l)))))
        :else nil))

(def ^:dynamic *constexpr-loop-limit* 262144)

(defn- ce-loop-limit!
  "cpp-ce3 (the checker): the loop `s` entering its iteration `k` (from 0): past GCC's -fconstexpr-loop-limit (262144 by default)
  its error at the loop, \"'constexpr' loop iteration count exceeds limit of N\"."
  [s k]
  (when (and (>= (long k) (long *constexpr-loop-limit*)) (checking?))
    (ub! s "'constexpr' loop iteration count exceeds limit of " *constexpr-loop-limit* " (use '-fconstexpr-loop-limit=' to increase the limit)")))

(defn- ce-std-construct-at?
  "cpp-ce3: whether the function `fid` is std::construct_at (a specialization of it; in namespace std or one inline in it)."
  [fid]
  (let [f (when fid (fnd fid))]
    (boolean (and f (not (:cls f)) (= "std" (some (fn [p] (when (= :ns (first p)) (second p))) (:path f)))
                  (re-matches #"construct_at(<.*)?" (str (:name f)))))))

(defn- ce-new
  "cpp-ce2 (the checker): a new-expression in a constant evaluation, [expr.new], [expr.const]/5.20 (P0784R7): the global
  replaceable allocation function's storage, an object of its own cell, initialized ([expr.new]/22: default-initialized, a
  scalar's value indeterminate); a placement form or a class's own operator new no constant."
  [e env]
  (let [alloc (some-> (:alloc e) fnd)]
    (when (and alloc (:cls alloc)) (not-constant "a class-specific new-expression"))
    (if (:placement e)
      ;; (the reserved placement form, std::construct_at's, [specialized.construct]/2, [expr.const]/5.20.1: an object of the type
      ;; begun at the location, its lifetime's start making a union's member there active, [class.union.general]/6; a location in
      ;; a member that is not active GCC's "accessing ... member instead of initialized ..." or "accessing uninitialized member")
      (let [;; (cpp-ce3, the user's decision of 2026-11-23: before C++26 the placement form is no constexpr function, so its call
            ;; is no constant but in std::construct_at's own body, [expr.const]/5.20.1 of C++20 and C++23, GCC's
            ;; is_std_construct_at of the evaluation's innermost call; from C++26 constexpr, P2747R2, [new.delete.placement])
            _ (when (and (checking?) (< (long *cxx-year*) 26) (not (ce-std-construct-at? (::fn env))))
                (if *ce-in-call*
                  (ub! e "call to non-'constexpr' function 'void* operator new(std::size_t, void*)'")
                  (do (ce-top-sure! "call to non-'constexpr' function 'void* operator new(std::size_t, void*)'")
                      (not-constant "a placement new outside std::construct_at"))))
            p (ce-eval (:placement e) env)
            l (cond (ce-loc? p) (ce-res p)
                    (and (ce-ptr? p) (ce-loc? (::base p))) (ce-res (update (::base p) ::path conj (::i p)))
                    :else (not-constant "a placement new at " (pr-str (type p))))
            et (:et e) u (abi/unq et)]
        (when (:n e) (not-constant "an array placement new"))
        (ce-union-write! e nil l true)
        (let [i (:init e)
              v (if (and (= :none (:i i)) (abi/scalar? u)) nil (ce-store et (ce-init et i env)))]
          (when (and *ce-dead* (empty? (::path l))) (swap! *ce-dead* disj (::cell l)))
          (ce-adopt! (::cell l) (vec (::path l)) v)
          (ce-put! l v)
          l))
    (let [et (:et e) u (abi/unq et)
          at (:cx-at e)]
      (if (:n e)
        (let [n (long (ce-num (ce-eval (:n e) env)))
              _ (when (or (neg? n) (> n 100000)) (not-constant "an array new of " n " elements"))
              i (:init e)
              v (cond (and (= :none (:i i)) (abi/scalar? u)) (vec (repeat n nil))
                      (= :list (:i i)) (ce-init (abi/arr n et) i env)
                      :else (not-constant "an array new's initializer " (:i i)))
              c (atom v)]
          (ce-adopt! c [] v)
          (swap! *ce-heap* assoc c {:array true :at at})
          {::base {::cell c ::path []} ::i 0 ::n n})
        (let [i (:init e)
              v (if (and (= :none (:i i)) (abi/scalar? u)) nil (ce-store et (ce-init et i env)))
              c (atom v)]
          (ce-adopt! c [] v)
          (swap! *ce-heap* assoc c {:array false :at at})
          {::cell c ::path []}))))))

(defn- ce-delete
  "cpp-ce2 (the checker): a delete-expression in a constant evaluation, [expr.delete]: a null pointer nothing; else the object
  the evaluation allocated by the same form (GCC's \"deallocation of storage that was not previously allocated\", \"... already
  deallocated\", \"(non-)array deallocation of object allocated with (non-)array allocation\"), destroyed, its storage freed."
  [e env]
  (let [p (ce-eval (:e e) env)]
    (if (and (number? p) (zero? (double p)))
      0
      (let [c (ce-heap-cell p)
            h (when c (get @*ce-heap* c))]
        (when-not (or (ce-loc? p) (ce-ptr? p)) (not-constant "a delete of " (pr-str (type p))))
        (cond (nil? h) (ub! e "deallocation of storage that was not previously allocated")
              (:freed h) (ub! e "deallocation of already deallocated storage")
              (and (:array e) (not (:array h))) (ub! e "array deallocation of object allocated with non-array allocation")
              (and (not (:array e)) (:array h)) (ub! e "non-array deallocation of object allocated with array allocation")
              :else nil)
        (when (and *ce-dead* (contains? @*ce-dead* c)) (ub! e "deallocation of already deallocated storage"))
        (let [v @c]
          (if (:array h)
            (when (vector? v)
              (doseq [k (range (dec (count v)) -1 -1) :let [x (nth v k)]]
                (when (and (map? x) (::cls x) (not (trivial-dtor? (::cls x))))
                  (ce-destroy! e (::cls x) {::cell c ::path [k]}))))
            (when (and (map? v) (::cls v) (not (trivial-dtor? (::cls v))))
              (ce-destroy! e (::cls v) {::cell c ::path []}))))
        (swap! *ce-heap* assoc-in [c :freed] true)
        (ce-kill! [c])
        0))))

(defn- ce-heap-refs
  "The allocations' cells the value `v` points into."
  [v]
  (cond (ce-loc? v) [(::cell (ce-res v))]
        (ce-ptr? v) (if (ce-loc? (::base v)) [(::cell (ce-res (::base v)))] [])
        (map? v) (mapcat ce-heap-refs (vals v))
        (vector? v) (mapcat ce-heap-refs v)
        :else []))

(defn- ce-heap-end!
  "cpp-ce2 (the checker): the outermost evaluation's end, [expr.const]/6 (P0784R7): its result points to no storage it
  allocated (GCC's \"is not a constant expression because it refers to a result of 'operator new'\"), and it freed all it
  allocated (\"allocated storage has not been deallocated\"), each at the new-expression."
  [v]
  (when-let [hp *ce-heap*]
    (let [h @hp]
      (when (seq h)
        (when-let [c (first (filter #(contains? h %) (ce-heap-refs v)))]
          (throw (ex-info "not a constant: is not a constant expression because it refers to a result of 'operator new'"
                          {:codegen/not-constant true :cx/sure true :cx/at (:at (get h c))})))
        (when-let [[_ a] (first (remove (comp :freed val) h))]
          (throw (ex-info "not a constant: is not a constant expression because allocated storage has not been deallocated"
                          {:codegen/not-constant true :cx/sure true :cx/at (:at a)})))))))

(defn- ce-has-label?
  "n-review-b: whether the statement `s` holds a case or default label of the enclosing switch (not a nested switch's)."
  [s]
  (and (map? s)
       (case (:s s)
         (:case :default) true
         :switch false
         (boolean (some (fn [x] (cond (map? x) (ce-has-label? x) (sequential? x) (some ce-has-label? x) :else false)) (vals s))))))

(defn- ce-base-path
  "The keys from an object of class `from` down to its base subobject of class `to` ([:b B] each), the first path found."
  [from to]
  (if (= from to) []
      (some (fn [b] (when-let [p (ce-base-path (:cls b) to)] (into [[:b (:cls b)]] p))) (:bases (abi/cls from)))))

(defn- ce-lv
  "CP378 (a): the location of the glvalue `e` (a local, a member, a base subobject, an object through a pointer or a
  reference, a temporary)."
  [e env]
  (when-let [p (:cx-at e)] (when *ce-pos* (reset! *ce-pos* p)))
  (case (:op e)
    :var (if-let [c (get env (:id e))] {::cell c ::path []}
           (let [v (var* (:id e))]
             ;; (h-cpp-consteval: a constexpr variable whose initializer was surely not constant: not usable, [expr.const]/4)
             (cond
               (:cx-bad v)
               (throw (ex-info (str "not a constant: the value of '" (:name v) "' is not usable in a constant expression") {:codegen/not-constant true :cx/sure true}))
               ;; (h-cpp-consteval, the checker: a constexpr class object of namespace or class scope, its initializer's value in
               ;; a cell of its own, const, [expr.const]/4)
               ;; (cpp-ce2: a constexpr static local's too, its :sinit)
               (and (checking?) (or (:constexpr v) (:cx-constexpr v)) (map? (or (:ginit v) (:sinit v))) (not= :none (:i (or (:ginit v) (:sinit v))))
                    (not (abi/ref? (:ty v))) (abi/class? (abi/unq (:ty v))))
               ;; (cpp-ce2: one cell a variable in an evaluation, so that two of its lvalues are one location: `&g == &g`)
               (if-let [c (some-> *ce-unknown* deref (get [:global (:id e)]))]
                 {::cell c ::path []}
                 (let [c (atom (binding [*ce-in-call* true] (ce-init (:ty v) (or (:ginit v) (:sinit v)) {})))]
                   (ce-adopt! c [] @c)
                   (when *ce-const* (swap! *ce-const* conj c))
                   (when *ce-unknown* (swap! *ce-unknown* assoc [:global (:id e)] c))
                   {::cell c ::path []}))
               ;; (cpp-rt-own4, the code generator: a constexpr object of class type of namespace or class scope, usable in
               ;; constant expressions ([expr.const]/4), its initializer's value as the checker's: <chrono>'s `inline constexpr
               ;; month January{1}` in tzdb.cc's year::min()/January/1, whose POD local clang initializes from a constant)
               (and (not (checking?)) (:cg-constexpr v) (#{:global :member-static} (:storage v)) (map? (:ginit v)) (not= :none (:i (:ginit v)))
                    (not (abi/ref? (:ty v))) (abi/class? (abi/unq (:ty v))))
               (let [c (atom (binding [*ce-in-call* true] (ce-init (:ty v) (:ginit v) {})))]
                 (when *ce-const* (swap! *ce-const* conj c))
                 {::cell c ::path []})
               ;; (cpp-ce, the checker: a scalar variable usable in constant expressions outside the evaluation -- constexpr,
               ;; or a const integral one with an initializer, [expr.const]/4 -- its object a const cell of its value, so that
               ;; an evaluation reads it through a pointer or a reference: cpp23/constexpr-nonlit12.C's `fn0 (&i)`)
               (and (checking?) (not (abi/ref? (:ty v))) (abi/scalar? (abi/unq (:ty v))) (or (:init v) (:init-node v))
                    (or (:constexpr v) (:cx-constexpr v) (and (:c (:ty v)) (abi/integral? (:ty v)))))
               (if-let [c (some-> *ce-unknown* deref (get [:global (:id e)]))]
                 {::cell c ::path []}
                 (let [init (or (:init v) (:init-node v))
                       x (rv (binding [*cutoff* Long/MAX_VALUE] (analyze {:scope (or (:def-scope v) *root*)} init)))
                       c (atom (ce-wrap (:ty v) (binding [*ce-manifest* true *ce-in-call* true] (ce-eval x {}))))]
                   (when *ce-const* (swap! *ce-const* conj c))
                   (when *ce-unknown* (swap! *ce-unknown* assoc [:global (:id e)] c))
                   {::cell c ::path []}))
               ;; (cpp-ce2, the checker: a namespace-scope or static member variable not usable in constant expressions, its lvalue
               ;; alone, *ce-unknown*'s: its address formed, compared, deleted -- a read or a write of it no constant)
               (and (checking?) (not (abi/ref? (:ty v))) (#{:global :member-static} (:storage v)))
               (assoc (ce-unknown-loc [:var (:id e)]) ::uvar (:id e))

               ;; (cpp-rt-own3: an object of a variable outside the evaluation, its lvalue alone, *ce-unknown*'s)
               (and (not (checking?)) (not (abi/ref? (:ty v))) (#{:local :param :global :static-local :member-static} (:storage v)))
               (ce-unknown-loc [:var (:id e)])
               :else (not-constant "a variable's object"))))
    :deref (let [p (ce-eval (:e e) env)]
             (cond (ce-loc? p) (ce-res p)
                   ;; (h-cpp-consteval: [expr.unary.op]/1, [expr.const]/5: an indirection through a null pointer)
                   (and (number? p) (zero? (double p)) (checking?)) (ce-sure! "dereferencing a null pointer")
                   ;; (an element of a local array in its cell; of a string literal, its characters, in a cell of their own:
                   ;; a reference bound to one, char_traits' eq(const char_type&, const char_type&))
                   (ce-ptr? p) (let [b (::base p)]
                                 (if (ce-loc? b) (update b ::path conj (::i p))
                                     (cond-> {::cell (if (vector? b) (atom b) b) ::path [(::i p)]}
                                       ;; (cpp-def: a string literal's characters, for the overlap rule of :cmp)
                                       (and (vector? b) (::lit p)) (assoc ::lit-chars b))))
                   :else (not-constant "an object through a pointer")))
    :field (update (ce-lv (:obj e) env) ::path conj (:i e))
    ;; (cpp-vec: a vector's element, its lanes a vector as an array's elements)
    :vec-elem (let [n (long (ce-num (ce-eval (:n e) env))) vt (abi/unq (:ty (:e e)))]
                (when-not (< -1 n (long (:n vt))) (not-constant "a vector's element outside it"))
                (update (ce-lv (:e e) env) ::path conj n))
    ;; (cpp-ce2: o.*m of a pointer to data member, ::mdata's path from the object; a null one, [expr.mptr.oper]/6, no constant)
    :mfield (let [l (ce-lv (:obj e) env) m (ce-eval (:m e) env)]
              (if (and (map? m) (::mdata m))
                (update l ::path into (second (::mdata m)))
                (if (and (number? m) (checking?)) (ce-sure! "dereferencing a null pointer to member") (not-constant "a pointer to member applied"))))
    :base-lv (let [from (some-> (:ty (:e e)) abi/unq :id)
                   p (when from (ce-base-path from (:to e)))]
               (when-not p (not-constant "a base subobject"))
               (update (ce-lv (:e e) env) ::path into p))
    :temp (let [l (ce-cell-loc (ce-init (:ty e) (:init e) env))] (ce-temp! (::cell l)) l)
    :temp-obj (let [l (ce-cell-loc (ce-eval e env))] (ce-temp! (::cell l)) l)
    :cond (if (zero? (ce-num (ce-eval (:c e) env))) (ce-lv (:else e) env) (ce-lv (:then e) env))
    :comma (do (ce-eval (:l e) env) (ce-lv (:r e) env))
    :call (let [v (ce-eval e env)] (if (ce-loc? v) v (let [l (ce-cell-loc v)] (ce-temp! (::cell l)) l)))
    ;; (cpp-ce2, the checker: a dynamic_cast to a reference, ce-dyncast)
    :dyncast (if (and (checking?) (:ref e)) (ce-dyncast e env) (not-constant "the object of :dyncast"))
    ;; (h-cpp-consteval: a const_cast's lvalue, the type the same but its cv-qualifiers, [expr.const.cast]/4: the object itself)
    :reinterpret-lv (cond (and (:cx-reinterpret e) (checking?)) (ub! e "'reinterpret_cast' is not a constant expression")
                          (= (abi/unq (:ty e)) (abi/unq (abi/non-ref (:ty (:e e))))) (ce-lv (:e e) env)
                          :else (not-constant "a reinterpret_cast's lvalue"))
    ;; (cpp-def, the checker: [expr.typeid]/3 with P2280R4, typeid of a polymorphic glvalue through a reference whose object
    ;; the evaluation does not know -- a namespace-scope reference with no initializer here, `extern Swim& trident;` -- asks a
    ;; dynamic type no constant expression gives: GCC's "... is not a constant expression", cpp2a/constexpr-ref1.C)
    :typeid (let [x (:e e)
                  ;; (a reference's object: *ref, the analyzer's deref of the reference's load)
                  x (if (and (= :deref (:op x)) (= :load (:op (:e x))) (= :var (:op (:e (:e x)))) (:raw (:e (:e x)))) (:e (:e x)) x)
                  v (when (= :var (:op x)) (var* (:id x)))]
              (if (and (checking?) v (abi/ref? (:ty v)) (#{:global :member-static} (:storage v)) (nil? (or (:init v) (:init-node v))) (:name v))
                (ub! e "'" (:name v) "' is not a constant expression")
                (not-constant "the object of :typeid")))
    (not-constant "the object of " (:op e))))

(defn- ce-glvalue
  "The value of the object the expression `e` names (a glvalue's object, read) or makes (a prvalue)."
  [e env]
  (if (#{:lv :xv} (:cat e)) (ce-get (ce-lv e env)) (ce-eval e env)))

(defn- ce-store
  "The value `v` as an object, a reference or a parameter of type `t` holds it."
  [t v]
  (let [u (abi/unq (abi/non-ref t))]
    (cond (= ::empty v) v
          (abi/ref? t) (if (ce-loc? v) v (not-constant "a reference to a value"))
          (or (abi/class? u) (abi/arr? u)) v
          ;; (cpp-vec: a vector's lanes, as an array's elements)
          (and (= :vec (:k u)) (vector? v)) v
          (abi/void? u) 0
          ;; (cpp-ce2: an indeterminate scalar, a bit_cast's unsigned char of indeterminate bits, [bit.cast]/2: nil, its read the error)
          (nil? v) nil
          :else (ce-wrap t v))))

;; cpp-ce2: __builtin_bit_cast's value ([bit.cast]/2-3, GCC's cxx_eval_bit_cast, clang's ExprConstant BitCastBuffer): the
;; operand's object representation as bits (a bit indeterminate, nil: padding, an unnamed bit-field, a member or element never
;; initialized), the destination's value made from them; not a constant expression when a type of either is or contains a
;; union, a pointer, a pointer to member, a reference member or a volatile object ([bit.cast]/3), nor when a value bit of the
;; result is indeterminate and its type is not unsigned char or std::byte ([bit.cast]/2: the value of such an object is then
;; indeterminate, a read of it the error). x87's long double and the other floating types beyond float and double are no constant.
(defn- bc-type-check! [e t top]
  (let [u (abi/unq t) nm #(gcc-type-str t)
        why (fn [what] (ub! e "'__builtin_bit_cast' is not a constant expression because '" (gcc-type-str top) "' " (if (identical? t top) "is " "contains ") what))]
    (cond (:v t) (ub! e "'__builtin_bit_cast' is not a constant expression because '" (nm) "' is volatile")
          (abi/ref? t) (why "a reference type")
          (abi/ptr? u) (why "a pointer type")
          (abi/mptr? u) (why "a pointer to member type")
          (abi/arr? u) (bc-type-check! e (:of u) top)
          (abi/class? u) (let [c (abi/cls (:id u))]
                           (when (:union c) (why "a union type"))
                           (doseq [b (:bases c)] (bc-type-check! e {:k :class :id (:cls b)} top))
                           (doseq [f (:fields c) :when (not (:static f))]
                             (when (abi/ref? (:ty f)) (why "a reference type"))
                             (bc-type-check! e (:ty f) top)))
          :else nil)))

(defn- bc-uchar? [t]
  (let [u (abi/unq t)]
    (or (= :uchar (abi/bn u))
        (and (abi/enum? u) (= "byte" (:name (abi/enm (:id u)))) (= :uchar (abi/bn (abi/unq (abi/underlying u))))))))

(defn- bc-put! [^objects a ^long off ^long n v]
  (if (nil? v)
    nil
    (let [x (biginteger v)] (dotimes [i n] (aset a (+ off i) (if (.testBit x (int i)) 1 0))))))

(defn- bc-ser!
  "The value `v` of type `t` written as bits into `a` from bit `off`."
  [^objects a t v ^long off]
  (let [u (abi/unq t)]
    (cond
      (or (nil? v) (= ::empty v)) nil
      (abi/class? u)
      (let [c (abi/cls (:id u)) l (abi/layout (:id u))]
        (when-not (and (map? v) (::cls v)) (not-constant "__builtin_bit_cast of a class's value"))
        (doseq [[i b] (map-indexed vector (:bases c))]
          (when-let [bo (nth (:bases l) i)]
            (bc-ser! a {:k :class :id (:cls b)} (get v [:b (:cls b)]) (+ off (* 8 (long bo))))))
        (doseq [[i f] (map-indexed vector (:fields c)) :when (not (:static f))]
          (if-let [bo (nth (:bitoffs l) i nil)]
            (when (and (:name f) (pos? (long (:bits f))))
              (let [x (get v i)] (when (some? x) (bc-put! a (+ off (long bo)) (long (:bits f)) (ce-num x)))))
            (bc-ser! a (:ty f) (get v i) (+ off (* 8 (long (nth (:fields l) i))))))))
      (abi/arr? u)
      (let [es (abi/size-of (:of u))]
        (when-not (vector? v) (not-constant "__builtin_bit_cast of an array's value"))
        (dotimes [i (count v)] (bc-ser! a (:of u) (nth v i) (+ off (* 8 i es)))))
      (= :float (abi/bn u)) (bc-put! a off 32 (Float/floatToRawIntBits (float (double v))))
      (= :double (abi/bn u)) (bc-put! a off 64 (Double/doubleToRawLongBits (double v)))
      (abi/integral? u) (bc-put! a off (* 8 (abi/size-of u)) (ce-num v))
      :else (not-constant "__builtin_bit_cast of a value of " (pr-str u)))))

(defn- bc-int
  "The integer of bits [off, off+n) of `a`, sign-extended when `signed`; nil when one of them is indeterminate."
  [^objects a ^long off ^long n signed]
  (when (every? #(some? (aget a (+ off (long %)))) (range n))
    (let [x (reduce (fn [^java.math.BigInteger x ^long i] (if (= 1 (aget a (+ off i))) (.setBit x (int i)) x)) java.math.BigInteger/ZERO (range n))
          x (if (and signed (pos? n) (.testBit x (int (dec n)))) (.subtract x (.shiftLeft java.math.BigInteger/ONE (int n))) x)]
      (if (< (.bitLength x) 64) (.longValue x) (bigint x)))))

(defn- bc-de
  "The value of type `t` the bits of `a` from bit `off` make (nil: an indeterminate unsigned char or std::byte)."
  [e ^objects a t ^long off]
  (let [u (abi/unq t)
        undef! (fn [^long n] (let [i (first (filter #(nil? (aget a (+ off (long %)))) (range n)))]
                               (ub! e "'__builtin_bit_cast' accessing uninitialized byte at offset " (quot (+ off (long i)) 8))))]
    (cond
      (abi/class? u)
      (let [c (abi/cls (:id u)) l (abi/layout (:id u))]
        (as-> {::cls (:id u)} o
          (reduce (fn [o [i b]] (if-let [bo (nth (:bases l) i)] (assoc o [:b (:cls b)] (bc-de e a {:k :class :id (:cls b)} (+ off (* 8 (long bo))))) o))
                  o (map-indexed vector (:bases c)))
          (reduce (fn [o [i f]]
                    (if (:static f) o
                      (if-let [bo (nth (:bitoffs l) i nil)]
                        (if (and (:name f) (pos? (long (:bits f))))
                          (let [w (long (:bits f)) ft (abi/underlying (abi/unq (:ty f)))
                                x (bc-int a (+ off (long bo)) w (abi/signed? ft))]
                            (cond (some? x) (assoc o i (ce-wrap (:ty f) x))
                                  (bc-uchar? (:ty f)) o
                                  :else (let [i0 (first (filter #(nil? (aget a (+ off (long bo) (long %)))) (range w)))]
                                          (ub! e "'__builtin_bit_cast' accessing uninitialized byte at offset " (quot (+ off (long bo) (long i0)) 8)))))
                          o)
                        (let [x (bc-de e a (:ty f) (+ off (* 8 (long (nth (:fields l) i)))))]
                          (if (some? x) (assoc o i x) o)))))
                  o (map-indexed vector (:fields c)))))
      (abi/arr? u)
      (let [es (abi/size-of (:of u))]
        (mapv #(bc-de e a (:of u) (+ off (* 8 (long %) es))) (range (long (or (:n u) 0)))))
      (#{:float :double} (abi/bn u))
      (let [n (if (= :float (abi/bn u)) 32 64) x (bc-int a off n false)]
        (when (nil? x) (undef! n))
        (if (= 32 n) (double (Float/intBitsToFloat (unchecked-int (long x)))) (Double/longBitsToDouble (long x))))
      (abi/integral? u)
      (let [n (* 8 (abi/size-of u)) x (bc-int a off n (abi/signed? (abi/underlying u)))]
        (cond (some? x) (if (and (= :bool (abi/bn u)) (not (#{0 1} x)))
                          (not-constant "__builtin_bit_cast to a bool of value " x)
                          (ce-wrap u x))
              (bc-uchar? u) nil
              :else (undef! n)))
      :else (not-constant "__builtin_bit_cast to " (pr-str u)))))

(defn- ce-bit-cast [e env]
  (when (:bad e) (not-constant "__builtin_bit_cast of an object of incomplete type"))
  (let [t (:ty e) x (:e e) st (abi/unq (abi/non-ref (:ty x)))
        _ (bc-type-check! e t t)
        _ (bc-type-check! e (abi/non-ref (:ty x)) (abi/non-ref (:ty x)))
        n (* 8 (abi/size-of (abi/unq t)))
        _ (when (> n 65536) (not-constant "__builtin_bit_cast of a large object"))
        v (if (abi/class? st) (ce-glvalue x env) (ce-eval x env))
        a (object-array n)]
    (bc-ser! a st v 0)
    (bc-de e a t 0)))

(defn- ce-zero-of [t]
  (let [u (abi/unq t)]
    (cond (abi/ref? t) nil
          (abi/class? u) (let [c (abi/cls (:id u))]
                           (as-> {::cls (:id u)} o
                             (reduce (fn [o b] (assoc o [:b (:cls b)] (ce-zero-of {:k :class :id (:cls b)}))) o (:bases c))
                             ;; (h-cpp-consteval: a union's first member alone, [dcl.init.general]/6.4)
                             (reduce (fn [o f] (if-some [z (ce-zero-of (:ty f))] (assoc o (:i f) z) o)) o (if (:union c) (take 1 (filter :name (:fields c))) (:fields c)))))
          (abi/arr? u) (vec (repeat (long (or (:n u) 0)) (ce-zero-of (:of u))))
          :else 0)))

(defn- ce-args-env
  "The parameters of `f` bound to its call's initializers `inits`, each in a cell (an argument of an empty class, a tag
  such as true_type, a value nothing reads; G4)."
  [f inits env]
  (into {} (map (fn [i pid]
                  ;; (by value or by reference, as before CP378: allocator_traits::max_size(const allocator_type&)'s object, its
                  ;; member call evaluated without it)
                  ;; (cpp-rt-own3, DECISION cpp-rt-own2-1 (a): a reference parameter's argument evaluated as clang evaluates every
                  ;; argument, its object an unknown one when outside the evaluation, so that one which is no constant fails the call:
                  ;; basic_string::max_size()'s `_Alloc_traits::max_size(_M_get_allocator())`, `this` outside a member's evaluation,
                  ;; clang's call of _M_get_allocator() const, folded before; by value, an empty argument nothing reads, as before)
                  (let [pt (:ty (var* pid)) u (abi/unq (abi/non-ref pt))]
                    ;; (cpp-sweep, the checker: a parameter by value of a type surely not literal, its object a temporary of
                    ;; non-literal type, GCC's error at the argument: cpp0x/constexpr-diag1.C's f(B()))
                    (when (and (checking?) (not (abi/ref? pt)) (abi/class? u) (cx-non-literal u))
                      (ub! (if (map? (:e i)) (:e i) i) "temporary of non-literal type '" (:name (abi/cls (:id u))) "' in a constant expression"))
                    [pid (let [c (atom (if (and (abi/class? u) (abi/empty-class? (:id u)) (or (checking?) (not (abi/ref? pt))))
                                        (do
                                          ;; (queue 578, the checker: an empty argument that is a call's result is still evaluated, the
                                          ;; parameter's initialization part of the evaluation ([expr.const]/5, [expr.call]/7), its sure
                                          ;; errors given and its value nothing reads: GCC's "used before its definition" at the call of
                                          ;; cpp0x/constexpr-non-const-arg2.C's `f (duration<0>::min (), ...)` before f's body is entered)
                                          (when (and (checking?) (loop [x i k 0] (cond (not (map? x)) false (= :call (:op x)) true
                                                                                       (and (< k 4) (map? (:e x))) (recur (:e x) (inc k)) :else false)))
                                            (try (ce-init pt i env)
                                                 (catch arbace.lang.ExceptionInfo x (when (:cx/sure (ex-data x)) (throw x)))))
                                          ::empty)
                                        (ce-store pt (ce-init pt i env))))]
                           (ce-adopt! c [] @c)
                           c)]))
                inits (:params f))))

(defn- ce-not-constexpr?
  "h-cpp-consteval (the checker): whether the function `f` is surely not constexpr ([dcl.constexpr]/1, no
  -fimplicit-constexpr): declared by the main file without constexpr or consteval, no implicit or defaulted member, no closure's
  member, no template's specialization, no builtin."
  [f]
  (boolean (and (checking?) f (not (:constexpr f)) (not (:consteval f)) (not (:implicit f)) (not (:defaulted f)) (not (:tinst f))
                (not (and (:cls f) (some-> (abi/cls (:cls f)) :lambda)))
                (:node f)
                (or (and (not (header-node? (:node f))) (not (str/starts-with? (str (:name f)) "__")))
                    ;; (queue 567: a function the C library's headers declare -- C has no constexpr, so none of them is one, and GCC
                    ;; folds only its __builtin_ names -- with no definition in the unit: musl's __assert_fail, which `assert`
                    ;; calls when its condition is false, GCC's "call to non-'constexpr' function", cpp0x/constexpr-ice16.C; not
                    ;; libstdc++'s headers nor the compiler's own include directories)
                    (and (header-node? (:node f)) (nil? (:cls f)) (not (:body f)) (not (:tbody f))
                         (not (str/starts-with? (str (:name f)) "__builtin"))
                         (let [fl (str (:file (loc-of (get-in (:node f) [:range :begin]))))]
                           (and (re-find #"/usr/include/" fl) (not (re-find #"/c\+\+/|/lib/gcc/|/lib/clang/" fl)))))))))

(defn- ce-undefined?
  "cpp-ce3 (the checker): whether the constexpr function `f` of the main file has no definition yet where the evaluation is
  ([expr.const]/5.3): no body, or one after *ce-point* in the same file; not defaulted or implicit, no template's specialization,
  no builtin."
  [f]
  (boolean (and (checking?) f (or (:constexpr f) (:consteval f))
                (or (and (not (:body f)) (not (:tbody f)))
                    (when-let [pt *ce-point*]
                      (let [a (some-> (get-in (:node f) [:range :begin]) loc-of) b (some-> (:begin pt) loc-of)]
                        (and (:body f) (:offset a) (:offset b) (= (:file a) (:file b)) (> (long (:offset a)) (long (:offset b)))))))
                (not (:defaulted f)) (not (:implicit f))
                (not (:out-of-line-default f)) (not (:ool-defaulted f)) (not (:deleted f)) (not (:tinst f))
                (not (and (:cls f) (some-> (abi/cls (:cls f)) :lambda)))
                (:node f) (not (header-node? (:node f))) (not (str/starts-with? (str (:name f)) "__")))))

(defn- ce-construct
  "The value of an object of class `cid` its constexpr constructor `fid` makes from the initializers `args`: its
  mem-initializers (the bases', then the members', [class.base.init]/13), then its body with `this`; `start` the object
  before (a zero-initialized one for :zero-then), else uninitialized."
  [cid fid args env start]
  (let [f (fnd fid)]
    ;; (cpp-rt-own2, the code generator: an implicit or first-declaration-defaulted constructor is constexpr when it can be,
    ;; [class.default.ctor]/4, [dcl.constexpr]/7: evaluated, a member's or base's that is not failing the evaluation in turn;
    ;; <charconv>'s _S_make_table()'s `type __table;` over `unsigned char __data[256] = {};`)
    ;; (cpp-ce2, the checker: from C++20 too, P1331R2's constexpr constructor leaving members uninitialized: an implicit or
    ;; first-declaration-defaulted one is constexpr unless the class has virtual bases, [class.default.ctor]/4, [dcl.constexpr]/3,
    ;; a subobject's non-constexpr constructor failing the evaluation in turn)
    (when-not (or (:constexpr f) (and (or (not (checking?)) (>= (long *cxx-year*) 20)) (not (:body f)) (not (:out-of-line-default f)) (not (:ool-defaulted f))
                                      (or (:implicit f) (:defaulted f))))
      (if (ce-not-constexpr? f)
        (ce-sure! "call to non-'constexpr' function '" (:name f) "'")
        (not-constant "a call of the constructor " (:name f))))
    (when (ce-undefined? f)
      (if-let [at *ce-mi-at*] (ub! {:cx-at at} "'" (:name f) "' used before its definition") (ce-sure! "'" (:name f) "' used before its definition")))
    (when (seq (abi/vbases-init cid)) (not-constant "a class with virtual bases"))
    (when-not (:tbody f) (when (:body f) (binding [*ce-manifest* false] (analyze-fn! fid))))
    (if (and (or (:defaulted f) (:implicit f)) (not (:body f)) (= 1 (count args))
             (or (copy-ctor? f cid) (move-ctor? f cid)))
    ;; (a defaulted or implicit copy or move constructor: the object's value, memberwise, [class.copy.ctor]/14)
    (let [v (ce-init (first (:ps (:ty f))) (first args) env)]
      (if (ce-loc? v) (ce-get v) (not-constant "a copy of a value")))
    (let [f (fnd fid)
          c (abi/cls cid)
          cell (atom (or start {::cls cid}))
          env2 (assoc (ce-args-env f args env) ::this {::cell cell ::path []} ::ret abi/void ::fn fid)
          ti (:tinits f)
          p0 (some-> *ce-pos* deref)]
      ;; (h-cpp-consteval: a mem-initializer's errors at the constructor)
      (when-let [r (some-> (:node f) :range)] (when *ce-pos* (reset! *ce-pos* r)))
      ;; (cpp-sweep, the checker: a constructor failing the potential constant check, cx-pce-bad?, whose evaluation fails surely: GCC's
      ;; "'constexpr Jam::Jam()' called in a constant expression" at the construction too, as for a call; cpp1y/constexpr-diag1.C)
      (try
      (binding [*ce-in-call* true *ce-mi-at* nil]
        (if-let [d (:delegate ti)]
          (reset! cell (ce-adopt! cell [] (ce-init {:k :class :id cid} d env2)))
          (do (binding [*ce-bases* (if (checking?) (conj *ce-bases* cell) *ce-bases*)]
                (doseq [b (:bases ti)]
                  (swap! cell assoc [:b (:base b)] (ce-adopt! cell [[:b (:base b)]] (binding [*ce-mi-at* (:at b)] (ce-init {:k :class :id (:base b)} (:init b) env2))))))
              (doseq [fl (:fields ti)]
                (let [ft (:ty (nth (:fields c) (:field fl)))]
                  (when-not (and (= :none (:i (:init fl))) (not (abi/class? (abi/unq ft))))
                    (swap! cell assoc (:field fl) (ce-adopt! cell [(:field fl)] (ce-store ft (binding [*ce-mi-at* (:at fl)] (ce-init ft (:init fl) env2))))))))))
        (ce-exec (:tbody f) env2))
      (catch arbace.lang.ExceptionInfo x
        (let [d (ex-data x)]
          (when (and (checking?) *on-refusal* (:cx/sure d) (not (:cx/pce d)) p0 (cx-pce-bad? fid))
            (*on-refusal* (ex-info (str "codegen: expression is not a constant expression ('" (:name f) "' called in a constant expression)")
                                   {:codegen/refused :constexpr :cx/node {:range p0}})
                          nil))
          (throw (if (and (checking?) (:cx/sure d) (cx-pce-bad? fid)) (ex-info (.getMessage x) (assoc d :cx/pce true)) x)))))
      ;; (cpp-ce2, the checker: the value tagged with its cell, which its place aliases, ce-adopt!)
      (ce-made @cell cell)))))

(defn- ce-range-in?
  "cpp-ce3: whether the position range `at` begins within the range `r` (one file's offsets)."
  [at r]
  (let [a (some-> (:begin at) loc-of) b (some-> (:begin r) loc-of) e (some-> (:end r) loc-of)]
    (boolean (and (:offset a) (:offset b) (:offset e) (= (:file a) (:file b))
                  (<= (long (:offset b)) (long (:offset a)) (long (:offset e)))))))

(defmacro ^:private ce-dmi-at
  "cpp-ce3 (the checker): the aggregate item `it`'s initialization (`body`); when it is a default member initializer's
  (:dmi-range), a sure error at an operation of that initializer's own text is the use's ([dcl.init.aggr]/5.1, [class.mem.general]:
  the initializer taken where the aggregate is initialized; GCC's copy of it bears the use's location), at `use` (nil: the variable
  the evaluation initializes, cx-sure-error!'s); one inside a function it calls stays there."
  [it use body]
  `(let [r# (:dmi-range ~it)]
     (if-not r#
       ~body
       (try ~body
            (catch arbace.lang.ExceptionInfo x#
              (let [d# (ex-data x#)]
                (if (and (:cx/sure d#) (:cx/at d#) (ce-range-in? (:cx/at d#) r#))
                  (throw (ex-info (.getMessage x#) (assoc d# :cx/at ~use)))
                  (throw x#))))))))

(defn- ce-mutable-member
  "cpp-rind: [class.copy]'s trivial copy reads every non-static data member: the first mutable one of class `cid`, its bases' and
  its class-type members' ([name of its class, name]), or nil."
  [cid ^long depth]
  (when-let [c (and (< depth 8) (abi/cls cid))]
    (or (some (fn [fl] (when (and (:mutable fl) (:name fl)) [(:name c) (:name fl)])) (:fields c))
        (some (fn [b] (ce-mutable-member (:cls b) (inc depth))) (:bases c))
        (some (fn [fl] (let [t (abi/unq (:ty fl))] (when (and (abi/class? t) (not (:mutable fl))) (ce-mutable-member (:id t) (inc depth))))) (:fields c)))))

(defn- ce-init
  "CP378 (a): the value an initializer (init-for's) gives an object, a reference or a parameter of type `t` (nil: the
  initializer's own expression's type)."
  [t i env]
  (let [u (when t (abi/unq (abi/non-ref t)))
        cls? (and u (not (abi/ref? t)) (abi/class? u))]
    (case (:i i)
      :expr (if (and (:agg-this i) (not (::agg-this env)))
              (not-constant "a default member initializer's this")
              (let [x (:e i)] (if (or cls? (and (nil? t) (abi/class? (abi/unq (:ty x))))) (ce-glvalue x env) (let [v (ce-eval x env)] (if t (ce-store t v) v)))))
      :bind (ce-lv (:e i) env)
      ;; (cpp-ce2, the checker: the temporary a full-expression's, [class.temporary]/4 -- a reference variable's declaration takes it
      ;; out, ce-exec's lifetime extension; a return statement's dies at its end, [class.temporary]/6.11)
      :bind-temp (let [l (ce-cell-loc (ce-init (:ty i) (:init i) env))
                       _ (when (checking?) (ce-temp! (::cell l)))]
                   (if (:to i) (update l ::path into (or (ce-base-path (:id (abi/unq (:ty i))) (:to i)) (not-constant "a base subobject"))) l))
      :ctor (if cls? (ce-construct (:id u) (:fn i) (:args i) env nil) (not-constant "a constructor's call for " (pr-str t)))
      :zero-then (if cls? (ce-construct (:id u) (:fn (:then i)) (:args (:then i)) env (ce-zero-of u)) (not-constant "an initializer :zero-then"))
      :copy (do
              ;; (cpp-rind, the checker: [expr.const]/5.9 (C++14 on) and /2 of C++11, a trivial copy reads every subobject, and a
              ;; mutable one of an object whose lifetime began outside the evaluation -- a namespace-scope variable's -- is no
              ;; constant: GCC's "mutable 'S::n' is not usable in a constant expression"; cpp0x/constexpr-mutable2.C)
              (when (and (checking?) cls? (= :var (:op (:e i))) (not (contains? env (:id (:e i)))))
                (when-let [[c f] (ce-mutable-member (:id u) 0)]
                  (ub! (:e i) "mutable '" c "::" f "' is not usable in a constant expression")))
              (ce-glvalue (:e i) env))
      :zero (if u (ce-zero-of u) 0)
      ;; (cpp-vec: a vector from a braced list, its lanes' values and zeros to its length, as an array's)
      :vec (if (and u (= :vec (:k u)))
             (let [xs (mapv #(ce-store (:of u) (ce-eval % env)) (:items i))]
               (into xs (repeat (- (long (:n u)) (count xs)) (ce-zero-of (:of u)))))
             (not-constant "a vector's initializer"))
      :none (if cls? {::cls (:id u)} 0)
      ;; (cpp-rt-own2: an array of characters from a string literal, its code units and zeros to its bound, [dcl.init.string]:
      ;; <charconv>'s `constexpr unsigned char __lower_letters[27] = "abcdefghijklmnopqrstuvwxyz";` in _S_make_table())
      :string (if (and u (abi/arr? u))
                (let [n (long (or (:n u) (:n i) (inc (count (str-units (:e i))))))]
                  (mapv #(ce-wrap (:of u) %) (take n (concat (str-units (:e i)) (repeat 0)))))
                (not-constant "a string literal's initializer for " (pr-str t)))
      :list (cond
              (:cls i) (let [cid (:cls i) c (abi/cls cid) items (:items i) fu (:fields-used i)
                             nb (- (count items) (count fu))
                             bs (take nb (:bases c))]
                         (if (some :agg-this items)
                           ;; (h-cpp-consteval: a default member initializer naming `this`, [class.mem.general]/? and
                           ;; [dcl.init.aggr]/5: the aggregate in a cell of its own, `this` its location, each member's
                           ;; lifetime begun as its initialization starts -- a union's member then its active one)
                           (let [cell (atom {::cls cid})
                                 env2 (assoc env ::this {::cell cell ::path []} ::agg-this true)
                                 ;; (cpp-ce3: the use's position, ce-dmi-at's: within a call the operation that entered last, else
                                 ;; none, the variable's own)
                                 use (when *ce-in-call* (some-> *ce-pos* deref))]
                             (doseq [[b it] (map vector bs items)]
                               (swap! cell assoc [:b (:cls b)] (ce-adopt! cell [[:b (:cls b)]] (ce-init {:k :class :id (:cls b)} it env2))))
                             (doseq [[fi it] (map vector fu (drop nb items))]
                               (let [ft (:ty (nth (:fields c) fi))]
                                 (swap! cell assoc fi (ce-fresh-of ft))
                                 (let [x (ce-store ft (ce-dmi-at it use (ce-init ft it env2)))] (swap! cell assoc fi (ce-adopt! cell [fi] x)))))
                             ;; (cpp-ce2: tagged with its cell, which its place aliases, ce-adopt!)
                             (ce-made @cell cell))
                         (as-> {::cls cid} o
                           (reduce (fn [o [b it]] (assoc o [:b (:cls b)] (ce-init {:k :class :id (:cls b)} it env))) o (map vector bs items))
                           (reduce (fn [o [fi it]] (let [ft (:ty (nth (:fields c) fi))] (assoc o fi (ce-store ft (ce-init ft it env))))) o (map vector fu (drop nb items))))))
              (and u (abi/arr? u)) (let [el (:of u)
                                         xs (mapv #(ce-store el (ce-init el % env)) (:items i))]
                                     (into xs (repeat (- (long (or (:n u) (count xs))) (count xs)) (if (:fill i) (ce-store el (ce-init el (:fill i) env)) (ce-zero-of el)))))
              :else (not-constant "a list's initializer"))
      (not-constant "an initializer " (:i i)))))

(defn ce-call-fn
  "The value of the call of the constexpr function `fid` with the integral constants `args` ([expr.const]; an array
  bound written as a call), or an ex-info {:codegen/not-constant true}."
  [fid args]
  (let [f (fnd fid)]
    (when-not (:constexpr f) (not-constant "a call of " (:name f)))
    (when-not (:tbody f) (when (:body f) (analyze-fn! (:id f))))
    (let [f (fnd fid)]
      (binding [*ce-steps* (atom 0) *ce-manifest* true]
        (let [env (assoc (into {} (map (fn [pid a] [pid (atom (if (and (map? a) (contains? a ::cls)) a (ce-wrap (:ty (var* pid)) a)))]) (:params f) args)) ::ret (:ret (:ty f)))
              r (ce-exec (:tbody f) env)]
          (if (and (= :ret (first r)) (not (ce-ptr? (second r))) (not (map? (second r)))) (ce-wrap (:ret (:ty f)) (second r)) (not-constant "no return")))))))

(def ^:dynamic *ce-object-manifest* true)

(defn ce-object
  "cpp-rt-own: the value the initializer `i` (init-for's) gives an object of class type `t` by the evaluator -- a constexpr
  constructor's mem-initializers and body -- as ce-construct makes it ({::cls id, a field's index its value, [:b base] a base's},
  arrays vectors), or nil when it is no constant: the constant initialization clang's ConstantEmitter makes of `constexpr
  _cpp_trigraph_map_s _cpp_trigraph_map_d;` (libcpp's init.cc), whose constructor's body assigns the map's elements."
  [t i]
  ;; (cpp-rt-own2: with the addresses of objects of static storage duration, ce-static-addr; an unforeseen use of one in a
  ;; computation, a host exception, is no constant rather than a crash)
  ;; (cpp-rt-own3: manifestly constant-evaluated unless *ce-object-manifest* says not, a local's initializer, the code generator's
  ;; const-local!)
  (let [ga (atom false)]
  (try (binding [*ce-steps* (atom 0) *ce-const* (or *ce-const* (atom #{})) *ce-pos* (or *ce-pos* (atom nil)) *ce-dead* (or *ce-dead* (atom #{}))
                 *ce-temps* (or *ce-temps* (atom [])) *ce-manifest* *ce-object-manifest* *ce-gaddr* ga *ce-unknown* (or *ce-unknown* (atom {}))]
         (let [v (ce-init t i {})] (when (map? v) v)))
       (catch arbace.lang.ExceptionInfo x (when-not (or (:codegen/not-constant (ex-data x)) (:codegen/refused (ex-data x))) (throw x)) nil)
       (catch RuntimeException x (if @ga nil (throw x))))))

(defn ce-field-value
  "cpp-rt-own: a member's value in an object value of ce-object's: the field of index `i`, or the base `cid`'s ([:b cid]); nil when
  unset."
  [o k]
  (get o k))

(defn ce-try
  "The constant `e` folds to (a typed literal of its type), or nil. A fold of code that runs (fold-mark's): not manifestly
  constant-evaluated, `__builtin_is_constant_evaluated()` false; `manifest` true for a variable usable in constant
  expressions' initializer (CP378 (a))."
  ([e] (ce-try e false))
  ([e manifest]
  (try (let [t (abi/unq (:ty e))
             ;; (cpp-s13: a 128-bit type's value outside 64 bits folds to its i128 constant)
             v (binding [*ce-manifest* manifest *ce-wide* (boolean (wide? t))] (ce-eval e))]
         (cond (abi/floating? t) {:op :float :v (double v) :ty t :cat :pr}
               (wide-value? v) {:op :int :v (wide-literal v) :ty t :cat :pr}
               :else {:op :int :v (long v) :ty t :cat :pr}))
       (catch arbace.lang.ExceptionInfo x (when-not (:codegen/not-constant (ex-data x)) (when-not (:codegen/refused (ex-data x)) (throw x))) nil))))

(defn fold-mark
  "The condition `c` with :folds true or false when it constant-folds to an integer as clang's CodeGen asks
  (ConstantFoldsToSimpleInteger: EvaluateAsInt, not a constant-evaluated context; the code generator then writes only the
  live branch of an if, a conditional operator, && and ||)."
  [c]
  (if-let [v (ce-try c)]
    (if (= :int (:op v)) (assoc c :folds (not (zero? (long (:v v))))) c)
    c))

;; ---------------------------------------------------------------------------------------------
;; Expressions: typed nodes {:op ... :ty T :cat :lv|:xv|:pr}

(defn- lv? [e] (#{:lv :xv} (:cat e)))

(defn- cast-node [e ck t] {:op :cast :ck ck :e e :ty t :cat :pr})

(defn- fn-matching
  "The function of the overload set `e` whose type is the function type `ft` (the address of an overloaded function,
  [over.over]), or its only one when `ft` is nil."
  [e ft]
  (let [fs (:fns e)
        same? #(let [g (fnd %)] (and (not (and (:cls g) (not (:static g))))
                                     (= (mapv abi/unq (:ps (:ty g))) (mapv abi/unq (:ps ft))) (= (abi/unq (:ret (:ty g))) (abi/unq (:ret ft)))))]
    (if ft
      (or (first (filter same? fs))
          ;; the templates' specializations deduced from the target type ([over.over]/2: a non-template preferred)
          (when-let [h (and (seq (:tmpls e)) (:fnaddr-specs @hooks))] (first (filter same? (h e ft)))))
      (or (when (= 1 (count fs)) (first fs))
          ;; (cpp-p2564, the checker: a template-id naming one specialization with no target type, `auto p = &f0<int>;`)
          (when-let [h (and (empty? fs) (= 1 (count (:tmpls e))) (:targs-text e) (cx-p2564?) (:fnaddr-explicit-specs @hooks))]
            (let [r (distinct (h e))] (when (= 1 (count r)) (first r))))))))

(defn mptr-fn-node [fid]
  (let [f (fnd fid)]
    {:op :mptr-fn :fn fid :ty {:k :mptr :cls (:cls f) :to (cond-> (:ty f) (:cq f) (assoc :cq true) (:vq f) (assoc :vq true)
                                                              (and (checking?) (:refq f)) (assoc :refq (:refq f))
                                                              ;; (cpp-rt-own4, the code generator: a noexcept member function's type is
                                                              ;; noexcept since C++17, [except.spec]/1, abi's Do)
                                                              (and (not (checking?)) (:noexcept f) (>= (long *cxx-year*) 17)) (assoc :nx true))} :cat :pr}))

(declare ptr-literal-of)

;; cpp-ce2 (the checker): __builtin_bit_cast(T, e), std::bit_cast's ([bit.cast]/1; clang's BuiltinBitCastExpr, GCC's
;; cp_build_bit_cast): T and e's type complete, trivially copyable, of one size, T no array (GCC's diagnostics); the value the
;; constant evaluator's ce-bit-cast. The code generator's mode refuses it as before (no lowering yet).
(defn- bc-trivially-copyable? [t]
  (let [u (abi/unq (loop [t t] (if (abi/arr? t) (recur (:of t)) t)))]
    (and (not (abi/ref? u))
         (or (abi/scalar? u) (and (abi/class? u) (trivial-copy? (:id u)) (trivial-dtor? (:id u)))))))

(defn- bit-cast-expr [ctx t e]
  (when-not (checking?) (fail :expr "a builtin expression __builtin_bit_cast"))
  (let [st (:ty e)
        ;; (a variable of incomplete type as the operand: GCC's "'v' has incomplete type" at the variable's declaration)
        bad-var (when (and (= :var (:op e)) (cx-incomplete-cls st) (not (cx-incomplete-cls t)))
                  (let [v (var* (:id e))]
                    (when-let [n (or (:node v) (:cx-decl v))]
                      (*on-refusal* (ex-info (str "codegen: '" (:name v) "' has incomplete type") {:codegen/refused :incomplete}) n)
                      true)))
        _ (when-let [c (and (not bad-var) (or (cx-incomplete-cls t) (cx-incomplete-cls st)))]
            (fail :incomplete "invalid use of incomplete type 'struct " (:name c) "'"))
        _ (cond bad-var nil
                (abi/ref? t) (fail :bit-cast "'__builtin_bit_cast' destination type '" (gcc-type-str t) "' is not trivially copyable")
                (abi/arr? (abi/unq t)) (fail :bit-cast "'__builtin_bit_cast' destination type '" (gcc-type-str t) "' is an array type")
                (not (bc-trivially-copyable? t)) (fail :bit-cast "'__builtin_bit_cast' destination type '" (gcc-type-str t) "' is not trivially copyable")
                (not (bc-trivially-copyable? st)) (fail :bit-cast "'__builtin_bit_cast' source type '" (gcc-type-str st) "' is not trivially copyable")
                :else nil)
        sz (if bad-var 0 (abi/size-of (abi/unq t))) ssz (if bad-var 0 (abi/size-of (abi/unq (abi/non-ref st))))]
    (when (not= sz ssz)
      (fail :bit-cast "'__builtin_bit_cast' source size '" ssz "' not equal to destination type size '" sz "'"))
    (cond-> {:op :bit-cast :e (if (abi/class? (abi/unq st)) e (rv e)) :ty (abi/unq t) :cat :pr} bad-var (assoc :bad true))))

(defn rv
  "The prvalue of a glvalue of non-class type (lvalue-to-rvalue), an array's decay, a function's."
  [e]
  (let [t (:ty e)]
    (cond
      (= :fnset (:op e)) (if-let [f (fn-matching e nil)] {:op :fnaddr :fn f :ty (abi/ptr (:ty (fnd f))) :cat :pr} e)
      (= :mptr-fnset (:op e)) (if (= 1 (count (:fns e))) (mptr-fn-node (first (:fns e))) e)
      (abi/arr? t) {:op :decay :e e :ty (abi/ptr (:of t)) :cat :pr}
      ;; a function lvalue: its address; *p of a function pointer p: p itself
      ;; (cpp-s14: a call's :fn is the function called, not the one its reference result designates)
      (abi/fn? t) (if (= :deref (:op e)) (:e e) {:op :fnaddr :e e :fn (when-not (= :call (:op e)) (:fn e)) :ty (abi/ptr t) :cat :pr})
      ;; (cpp-sweep, the checker: not a volatile one, whose read is no constant expression, [expr.const]/5.10)
      (and (= :var (:op e)) (:c t) (abi/integral? t) (:init (var* (:id e))) (not= :local (:storage (var* (:id e))))
           (not (and (checking?) (:v t))))
      ;; (cpp-s13: a 128-bit constant outside 64 bits too, its i128 constant: __numeric_traits_integer<__int128>::__max)
      (let [c (try (binding [*ce-wide* (boolean (wide? t))] (var-const-int (:id e))) (catch arbace.lang.ExceptionInfo _ nil))]
        (if c {:op :int :v (if (wide-value? c) (wide-literal c) c) :ty (abi/unq t) :cat :pr} {:op :load :e e :ty (abi/unq t) :cat :pr}))
      ;; o.k of a constant static member: o evaluated, k folded (not an odr-use)
      (and (= :comma (:op e)) (= :var (:op (:r e))) (lv? e) (not (abi/class? t)))
      (let [r (rv (:r e))] (if (= :int (:op r)) {:op :comma :l (:l e) :r r :ty (:ty r) :cat :pr} {:op :load :e e :ty (abi/unq t) :cat :pr}))
      ;; (cpp-tzdb, the code generator: a constexpr pointer variable whose initializer is a string literal's address, read in
      ;; place, the literal's, as clang folds the read of a constexpr variable: <bits/chrono_io.h>'s __formatter_chrono<char>'s
      ;; `static constexpr const _CharT* _S_chars = _GLIBCXX_WIDEN(...)`, which clang never writes nor guards)
      (and (not (checking?)) (= :var (:op e)) (abi/ptr? (abi/unq t)) (:cg-constexpr (var* (:id e))) (:init (var* (:id e))))
      (or (ptr-literal-of (:id e)) {:op :load :e e :ty (abi/unq t) :cat :pr})
      (and (lv? e) (not (abi/class? t))) {:op :load :e e :ty (abi/unq t) :cat :pr}
      :else e)))

(defn- ptr-literal-of
  "cpp-tzdb: the string literal's decayed address a constexpr pointer variable `id` is initialized with (an immediate
  invocation's folded value among them), or nil; kept on the variable."
  [id]
  (let [v (var* id)]
    (if (contains? v :cptr)
      (:cptr v)
      (let [r (try (let [x (binding [*cutoff* Long/MAX_VALUE] (rv (analyze {:scope (or (:def-scope v) *root*) :statics (atom [])} (:init v))))]
                     ;; (or an element's address in it, a constant offset: __formatter_chrono's `_S_plus_minus = _S_chars + 10`)
                     (when ((fn lit? [x] (or (and (= :decay (:op x)) (= :str (:op (:e x))))
                                             (and (= :ptradd (:op x)) (some? (ce-try (:n x))) (lit? (:p x)))))
                            x)
                       x))
                   (catch arbace.lang.ExceptionInfo _ nil))]
        (upd-var! id assoc :cptr r)
        r))))

(defn- promote-type [t]
  (let [t (abi/unq t)]
    (cond
      (abi/enum? t) (let [u (abi/underlying t)] (promote-type u))
      (#{:bool :char :schar :uchar :short :ushort :char8 :char16} (abi/bn t)) abi/int*
      :else t)))

(def ^:private unsigned-of {:int :uint :long :ulong :llong :ullong :i128 :u128})

(defn arith-common
  "The usual arithmetic conversions' type ([expr.arith.conv])."
  [a b]
  (when-not (and (abi/arith? (abi/unq (abi/underlying (abi/unq a)))) (abi/arith? (abi/unq (abi/underlying (abi/unq b)))))
    (fail :type "arithmetic on " (pr-str (select-keys a [:k :n :id])) " and " (pr-str (select-keys b [:k :n :id]))))
  (let [a (promote-type a) b (promote-type b)]
    (cond
      ;; ([expr.arith.conv]/1.2-1.3, P1467R9: the floating type of the greater conversion rank, of equal ranks the greater
      ;; subrank; unordered ranks ill-formed, GCC's "invalid operands")
      (and (abi/floating? a) (abi/floating? b))
      (let [c (abi/fp-rank-cmp a b)]
        (cond (nil? c) (fail :type "invalid operands of types '" (name (abi/bn a)) "' and '" (name (abi/bn b)) "' (unordered conversion ranks)")
              (pos? (long c)) (abi/b (abi/bn a))
              (neg? (long c)) (abi/b (abi/bn b))
              (>= (abi/fp-subrank a) (abi/fp-subrank b)) (abi/b (abi/bn a))
              :else (abi/b (abi/bn b))))
      (abi/floating? a) (abi/b (abi/bn a))
      (abi/floating? b) (abi/b (abi/bn b))
      (= a b) a
      :else
      (let [ra (long (abi/int-ranks (abi/bn a))) rb (long (abi/int-ranks (abi/bn b)))
            ua (contains? abi/unsigned-ns (abi/bn a)) ub (contains? abi/unsigned-ns (abi/bn b))]
        (cond
          (= ua ub) (if (>= ra rb) a b)
          (and ua (>= ra rb)) a
          (and ub (>= rb ra)) b
          :else (let [[s u] (if ua [b a] [a b])]
                  (if (> (abi/size-of s) (abi/size-of u)) s (abi/b (unsigned-of (abi/bn s))))))))))

(defn- null-constant?
  "A null pointer constant ([conv.ptr]/1): a prvalue of type std::nullptr_t, or an integral zero; (CX12, the checker) from
  C++11 an integer literal ([conv.ptr]/1 since CWG 903), so `false`, a bool, is none."
  [e]
  (or (= :nullptr (abi/bn (:ty e)))
      (and (= :int (:op e)) (zero? (long (:v e))) (abi/integral? (:ty e)) (not (abi/enum? (:ty e)))
           (not (and (checking?) (>= (long *cxx-year*) 11) (= :bool (abi/bn (:ty e)))))
           ;; (queue 518: nor a character literal, `'\0'`, cpp0x/nullptr36.C's `void *p = '\0';`, GCC's "invalid conversion")
           (not (and (checking?) (>= (long *cxx-year*) 11) (#{:char :wchar :char8 :char16 :char32} (abi/bn (:ty e))))))))

(defn- class-id [t] (when (abi/class? (abi/unq t)) (:id (abi/unq t))))

;; queue 460 (the checker alone): implicit conversions between scalar types the standard conversions do not make
;; ([conv]/1: an implicit conversion sequence is the standard conversions of [conv.lval]-[conv.bool] in order; [conv.ptr]/2-3,
;; [conv.qual]/3, [conv.mem]/2, [conv.integral]/1 from an unscoped enumeration only, [conv.bool]/1's std::nullptr_t by
;; direct-initialization only), refused with a message of their own that the dg check's own read reports (arbace.repr.cpp.diag's
;; sema-rules); a type the slice knows only in part (a pointer to an unknown type, a function or array pointee, a class not
;; complete, an undeduced or dependent type) is left as before.

(def ^:dynamic *cx-union-init* false) ; queue 460: inside a union's aggregate initialization (its member as the slice takes it)

(defn- cx-type-key
  "Queue 484: a type's identity when the checker knows it whole (a builtin type, an enumeration, a class not a template's,
  pointers to them, each with its cv-qualifiers), else nil."
  [t]
  (when (map? t)
    (let [cv [(boolean (:c t)) (boolean (:v t))]]
      (case (:k t)
        :b (when (keyword? (:n t)) [:b (:n t) cv])
        :enum (when (abi/enm (:id t)) [:enum (:id t) cv])
        :class (let [c (abi/cls (:id t))]
                 (when (and c (not (:lambda c))
                            ;; (cpp-tpl2: a class template's specialization by arguments of no dependence, one class a list of
                            ;; arguments, template/ttp args by their template: cpp0x/alias-decl-equiv1.C's X<Y> and X<Z>)
                            (or (not (:tmpl c)) (and (:targs c) (not (dt-dependent? (:targs c))) (:complete c))))
                   [:class (:id t) cv]))
        :ptr (when-let [k (cx-type-key (:to t))] [:ptr k cv])
        nil))))

(defn- cx-typedef-redecl!
  "Queue 484, the checker: [dcl.typedef]/6 with [basic.scope.declarative]: a typedef or alias name redeclared in the same
  namespace or block scope that names another type than the earlier typedef, class or enumeration of the name
  (`using I = int; using I = float;`, cpp0x/alias-decl-56.C; `struct B; typedef int B;`, warn/pr81119.C): g++'s
  \"conflicting declaration\", clang's err_redefinition_different_typedef. Both types known whole (cx-type-key)."
  [scope n]
  (when (and (checking?) (#{:ns :block :fn} (:kind scope)) (not (header-node? n)))
    (let [es (filter #(= :type (:e %)) (.get ^java.util.HashMap (:names scope) (ucn-name (:name n))))]
      (when (> (count es) 1)
        (let [nk (cx-type-key (:ty (last es)))]
          ;; (against the first declaration, which a conflicting one leaves in force, as GCC: diagnostic/local1.C's third
          ;; `using type = void;` agrees with the first)
          (when (and nk (let [k (cx-type-key (:ty (first es)))] (and k (not= k nk))))
            (*on-refusal* (ex-info (str "codegen: conflicting declaration of '" (:name n) "'") {:codegen/refused :redecl}) n)))))))

(defn- cx-sure-scalar?
  "A scalar type whose conversions the checker judges: arithmetic, an enumeration, a pointer to object of such a type or
  of a complete class (cv-qualified at any level), a pointer to member."
  [t]
  (let [t (abi/unq t)]
    (case (:k t)
      :b (not (#{:float16 :float128 :i128 :u128} (:n t)))
      :enum (some? (abi/enm (:id t)))
      :mptr (some? (:to t))
      :class (let [c (abi/cls (:id t))] (boolean (and c (:complete c) (not (:tmpl c)))))
      :ptr (let [p (:to t)] (and (some? p) (if (and (= :b (:k p)) (= :void (:n p))) true (cx-sure-scalar? p))))
      false)))

(defn- cx-cv-ok?
  "Whether `to`'s cv-qualifiers include `from`'s ([conv.qual]/3's first level)."
  [from to]
  (and (or (:c to) (not (:c from))) (or (:v to) (not (:v from)))))

(defn- cx-shape [t] (if (= :ptr (:k t)) (assoc (abi/unq t) :to (cx-shape (:to t))) (abi/unq t)))

(defn- cx-qual-bad?
  "cpp-diag-b (2026-11-22): [conv.qual]/3 over two similar pointer types' pointees `f` and `t` (levels 1, 2, ...): each level's
  cv-qualifiers of `t` include `f`'s, and where they differ at a level j > 1, every level of `t` from 1 to j-1 has const."
  [f t]
  (let [cvs (fn [x] (loop [x x out []] (let [out (conj out [(boolean (:c x)) (boolean (:v x))])] (if (abi/ptr? x) (recur (:to x) out) out))))
        lf (cvs f) lt (cvs t)]
    (when (= (count lf) (count lt))
      (loop [j 0 all-const true]
        (when (< j (count lf))
          (let [[fc fv] (nth lf j) [tc tv] (nth lt j)]
            (cond (or (and fc (not tc)) (and fv (not tv))) true
                  (and (not= [fc fv] [tc tv]) (pos? j) (not all-const)) true
                  :else (recur (inc j) (and all-const tc)))))))))


(declare cx-tyname cx-qual-levels cx-mptr-base! base-subobjects mptr-fn-node)

(defn- cx-named-cast!
  "cpp-diag-b (2026-11-22), the checker: the conversions reinterpret_cast and const_cast make to a type that is no reference,
  [expr.reinterpret.cast]/2-10 (no class, array or floating target; an integer from a pointer, its own type or std::nullptr_t; a
  pointer from a pointer, an integer or an enumeration, its constness kept; a pointer to member from one of the same kind) and
  [expr.const.cast]/3-5 (pointers or pointers to members of similar types alone, else the operand's own type): GCC's \"invalid cast
  from type 'S' to type 'const S'\", \"invalid 'const_cast' from type ...\"."
  [kind t e]
  ;; (cpp-diag-b, round 2: a static_cast's or C-style cast's pointer to member conversion either way, [expr.static.cast]/12)
  ;; (cpp-sweep: [expr.static.cast]/4 with [dcl.init.ref]/5, a reference to an array of known bound from an array of another
  ;; or unknown bound of the same element type: neither reference-compatible nor a temporary's initializer, GCC's "invalid
  ;; 'static_cast' from type 'int []' to type 'int (&)[4]'", cpp0x/rv-cast7.C)
  (when (and (checking?) (= "CXXStaticCastExpr" kind) (abi/ref? t) (some? (:ty e)))
    (let [to (abi/unq (:to t)) f (abi/unq (abi/non-ref (:ty e)))]
      (when (and (abi/arr? to) (:n to) (abi/arr? f) (not= (:n to) (:n f)) (= (abi/unq (:of to)) (abi/unq (:of f))))
        (fail :named-cast "invalid cast from type " (cx-tyname f) " to type " (cx-tyname to) ": a reference to an array of another bound (static_cast)"))))
  (when (and (checking?) (#{"CXXStaticCastExpr" "CStyleCastExpr"} kind) (some? (:ty e)))
    ;; ([expr.static.cast]/11: a pointer or reference to a base cast to its derived class's, the base neither virtual nor ambiguous:
    ;; GCC's "cannot convert from pointer to base class 'A' to pointer to derived class 'B' because the base is virtual")
    (let [tu (abi/unq t) f (abi/unq (:ty e))
          [dc bc] (cond (and (abi/ptr? tu) (abi/ptr? f)) [(class-id (:to tu)) (class-id (:to f))]
                        (abi/ref? t) [(class-id (:to t)) (class-id f)]
                        :else nil)]
      (when (and dc bc (not= dc bc) (abi/derived-from? dc bc))
        (cond (> (count (base-subobjects dc bc)) 1) (fail :mptr-base "'" (:name (abi/cls bc)) "' is an ambiguous base of '" (:name (abi/cls dc)) "'")
              (some? (nth (abi/base-path dc bc) 2))
              (fail :mptr-base "pointer to member conversion via virtual base '" (:name (abi/cls bc)) "': cannot convert from pointer to base class to pointer to derived class because the base is virtual")
              :else nil)))
    (let [tu (abi/unq t) f0 (abi/unq (:ty e))
          f (if (and (= :mptr-fnset (:op e)) (seq (:fns e))) (abi/unq (:ty (mptr-fn-node (first (:fns e))))) f0)]
      ;; (another member type, or the constness cast away, [expr.static.cast]/12)
      (when (and (= kind "CXXStaticCastExpr") (abi/mptr? tu) (abi/mptr? f) (some? (:to f)) (some? (:to tu)))
        (cond (not= (abi/unq (:to tu)) (abi/unq (:to f))) (fail :named-cast "invalid cast from type " (cx-tyname f) " to type " (cx-tyname tu))
              (or (and (:c (:to f)) (not (:c (:to tu)))) (and (:v (:to f)) (not (:v (:to tu)))))
              (fail :named-cast "invalid cast from type " (cx-tyname f) " to type " (cx-tyname tu) ": casts away qualifiers")
              :else nil))
      (when (and (abi/mptr? tu) (abi/mptr? f) (:cls tu) (:cls f))
        (let [a (let [c (:cls tu)] (if (map? c) (:id c) c)) b (let [c (:cls f)] (if (map? c) (:id c) c))]
          (when (and a b (not= a b))
            (cond (abi/derived-from? a b) (cx-mptr-base! a b (= kind "CXXStaticCastExpr"))
                  (abi/derived-from? b a) (cx-mptr-base! b a (= kind "CXXStaticCastExpr"))
                  :else nil))))))
  (when (and (checking?) (#{"CXXReinterpretCastExpr" "CXXConstCastExpr"} kind) (not (abi/ref? t)) (some? (:ty e)))
    (let [tu (abi/unq t)
          f0 (abi/unq (:ty e))
          f (cond (abi/arr? f0) (abi/ptr (:of f0)) (abi/fn? f0) (abi/ptr f0) :else f0)
          same (= (cx-shape tu) (cx-shape f))
          sure (fn [x] (or (cx-sure-scalar? x) (abi/class? x) (and (abi/ptr? x) (abi/fn? (abi/unq (:to x))))))]
      ;; (pointers to arrays, cpp-diag-b round 2: const_cast between similar types alone, its bounds equal; reinterpret_cast casting
      ;; away no qualifier, [expr.const.cast]/7)
      (when (and (abi/ptr? tu) (abi/ptr? f) (not (abi/void? (abi/unq (:to tu)))) (not (abi/void? (abi/unq (:to f)))))
        (let [[lf] (cx-qual-levels (:to f)) [lt] (cx-qual-levels (:to tu))]
          (when (and lf lt (or (some #(vector? (first %)) lf) (some #(vector? (first %)) lt)))
            (if (= kind "CXXConstCastExpr")
              (when (or (not= (count lf) (count lt)) (not= (map first lf) (map first lt)) (not= (second (cx-qual-levels (:to f))) (second (cx-qual-levels (:to tu)))))
                (fail :named-cast "invalid 'const_cast' from type " (cx-tyname f) " to type " (cx-tyname tu)))
              (when (and (= (count lf) (count lt)) (some (fn [[a b]] (or (and (second a) (not (second b))) (and (nth a 2) (not (nth b 2))))) (map vector lf lt)))
                (fail :named-cast "invalid cast from type " (cx-tyname f) " to type " (cx-tyname tu) ": casts away qualifiers"))))))
      (when (and (sure tu) (sure f))
        (if (= kind "CXXConstCastExpr")
          (when-not (or (and (or (abi/ptr? tu) (abi/mptr? tu)) (= (cx-shape tu) (cx-shape f)))
                        (= tu f))
            (fail :named-cast "invalid 'const_cast' from type " (cx-tyname f) " to type " (cx-tyname tu)))
          (when (cond
                  (abi/class? tu) true
                  (abi/floating? tu) true
                  (abi/integral? tu) (not (or (abi/ptr? f) (= tu f) (= :nullptr (abi/bn f))))
                  (abi/enum? tu) (not= tu f)
                  (abi/ptr? tu) (or (not (or (abi/ptr? f) (abi/integral? f) (abi/enum? f)))
                                    (and (abi/ptr? f) (not (abi/fn? (abi/unq (:to f)))) (not (abi/fn? (abi/unq (:to tu))))
                                         (or (and (:c (:to f)) (not (:c (:to tu)))) (and (:v (:to f)) (not (:v (:to tu)))))))
                  (abi/mptr? tu) (not (and (abi/mptr? f) (= (abi/fn? (:to tu)) (abi/fn? (:to f)))))
                  :else false)
            (fail :named-cast "invalid cast from type " (cx-tyname f) " to type " (cx-tyname tu))))))))

(defn- cx-qual-levels
  "cpp-diag-b, round 2: the qualification-decomposition ([conv.qual]/1) of a pointer type's pointee `x`: [[kind const volatile] ...
  base], kind :ptr, [:arr n] (n nil an unknown bound), :end; an array's cv-qualifiers its elements' ([basic.type.qualifier]/3);
  nil when a level is no pointer, array or sure scalar."
  [x]
  (let [ecv (fn ecv [t] (if (abi/arr? (abi/unq t)) (ecv (:of (abi/unq t))) [(boolean (:c t)) (boolean (:v t))]))]
    (loop [x x out []]
      (let [u (abi/unq x)]
        (cond
          (abi/arr? u) (recur (:of u) (conj out (into [[:arr (:n u)]] (ecv x))))
          (abi/ptr? u) (recur (:to u) (conj out [:ptr (boolean (:c x)) (boolean (:v x))]))
          (or (abi/void? u) (cx-sure-scalar? u)) [(conj out [:end (boolean (:c x)) (boolean (:v x))]) u]
          :else nil)))))

(defn- cx-array-qual-bad?
  "cpp-diag-b, round 2: [conv.qual]/3 (DR 330, P0388) for pointers whose pointees hold an array level: :similar-bad when the types
  are not similar or a bound differs (to an unknown bound from C++20 aside), :cv-bad when the cv-qualifiers are not added as
  [conv.qual]/3 asks, nil when the conversion is a qualification conversion or not judged."
  [from to]
  (let [[lf bf] (cx-qual-levels (:to from)) [lt bt] (cx-qual-levels (:to to))]
    (when (and lf lt (or (some #(vector? (first %)) lf) (some #(vector? (first %)) lt)))
      (cond
        (or (not= (count lf) (count lt)) (not= bf bt)) :similar-bad
        (some (fn [[a b]] (let [ka (first a) kb (first b)]
                            (not (or (= ka kb)
                                     (and (vector? ka) (vector? kb) (nil? (second kb)) (>= (long *cxx-year*) 20))))))
              (map vector lf lt))
        :similar-bad
        :else
        (loop [j 0 all-const true]
          (when (< j (count lf))
            (let [[_ fc fv] (nth lf j) [_ tc tv] (nth lt j)]
              (cond (or (and fc (not tc)) (and fv (not tv))) :cv-bad
                    (and (or (not= fc tc) (not= fv tv)) (pos? j) (not all-const)) :cv-bad
                    :else (recur (inc j) (and all-const tc))))))))))

(defn- cx-bad-ptr-conv?
  "Whether the prvalue of pointer type `from` surely does not convert implicitly to the pointer type `to` ([conv.ptr]/2-3:
  to cv void* and to a base class's pointer; [conv.qual]: the cv-qualifiers added only, judged at the first level, the
  deeper levels' alone similar; the rest no standard conversion makes)."
  [from to]
  (let [f (:to from) t (:to to)]
    (when (and (cx-sure-scalar? from) (cx-sure-scalar? to))
      (cond
        (abi/void? t) (not (cx-cv-ok? f t))
        (abi/void? f) true
        (= (abi/unq f) (abi/unq t)) (not (cx-cv-ok? f t))
        (and (class-id f) (class-id t)) (or (not (abi/derived-from? (class-id f) (class-id t))) (not (cx-cv-ok? f t)))
        :else true))))

(defn- cx-tyname ^String [t] (pr-str (select-keys (abi/unq t) [:k :n :id :to :cls])))

(defn- cx-implicit-scalar!
  "Queue 460, the checker: the copy- (`style` :copy) or direct-initialization of the scalar type `to` from the prvalue `e`
  of scalar type, refused where no implicit conversion is made (see cx-sure-scalar?)."
  [e to style]
  (when (and (checking?) (not *cx-union-init*))
    (let [from (abi/unq (:ty e)) to (abi/unq to)]
      (cond
        ;; ([conv.bool]/1: std::nullptr_t converts to bool by direct-initialization alone; DR 1423)
        (and (= :bool (abi/bn to)) (= :nullptr (abi/bn from)) (not= style :direct))
        (fail :conversion "cannot convert " (cx-tyname from) " to " (cx-tyname to) " implicitly (std::nullptr_t to bool requires direct-initialization)")
        ;; ([conv.integral]/1, [conv.fpint]/2, [conv.bool]/1: a scoped enumeration converts to no arithmetic type)
        (and (abi/enum? from) (:scoped (abi/enm (:id from))) (abi/arith? to))
        (fail :conversion "cannot convert " (cx-tyname from) " to " (cx-tyname to) " implicitly (a scoped enumeration)")
        ;; (cpp-1123: no standard conversion takes a pointer, a pointer to member or std::nullptr_t to an integral or floating
        ;; type but bool, [conv.integral], [conv.fpint], [conv.bool] -- GCC's permerror "invalid conversion from 'void*' to
        ;; 'int'", nothing under -fpermissive, sema-errors' rule; init/pr43064-2.C's `m_int(NULL)` with NULL `((void *)0)`)
        (and (or (abi/integral? to) (abi/floating? to)) (not= :bool (abi/bn to)) (not (abi/enum? to))
             (or (abi/ptr? from) (abi/mptr? from) (= :nullptr (abi/bn from))))
        (fail :conversion "cannot convert " (cx-tyname from) " to " (cx-tyname to) " implicitly (a pointer to an arithmetic type)")
        ;; ([conv.ptr]/1: a null pointer constant is an integer literal of value zero, or a prvalue of std::nullptr_t; an
        ;; integral constant expression of value zero before C++11, CWG 903 -- a folded constant counts as one here)
        (and (abi/ptr? to) (or (abi/arith? from) (abi/enum? from)) (not (null-constant? e)) (cx-sure-scalar? to))
        (fail :conversion "cannot convert " (cx-tyname from) " to " (cx-tyname to) " implicitly (an integer to a pointer)")
        ;; (cpp-diag-b, 2026-11-22: [conv.array]/1 with [lex.string]/? : since C++11 a string literal, an array of const char,
        ;; converts to no char*; GCC's pedwarn "ISO C++ forbids converting a string constant to 'char*'", an error under
        ;; -pedantic-errors)
        (and *pedantic-errors* (>= (long *cxx-year*) 11) (abi/ptr? to) (abi/ptr? from) (= :decay (:op e)) (= :str (:op (:e e)))
             (cx-bad-ptr-conv? from to))
        (fail :write-strings "ISO C++ forbids converting a string constant to " (cx-tyname to))
        ;; (cpp-diag-b, round 2: a pointer to member of a base to one of the derived class, [conv.mem]/2)
        (and (abi/mptr? to) (abi/mptr? from) (not (null-constant? e)) (:cls from) (:cls to))
        (let [cid (fn [c] (if (map? c) (:id c) c)) a (cid (:cls from)) b (cid (:cls to))
              ft (:to from) tt (:to to)]
          (cond
            (and (not= a b) (abi/cls a) (abi/cls b) (not (abi/derived-from? b a)))
            (fail :conversion "cannot convert " (cx-tyname from) " to " (cx-tyname to) " implicitly (a pointer to member of a class not a base)")
            (and (not (abi/fn? (abi/unq ft))) (not (abi/fn? (abi/unq tt))) (cx-sure-scalar? (abi/unq ft)) (cx-sure-scalar? (abi/unq tt))
                 (or (not= (abi/unq ft) (abi/unq tt)) (and (:c ft) (not (:c tt))) (and (:v ft) (not (:v tt)))))
            (fail :conversion "cannot convert " (cx-tyname from) " to " (cx-tyname to) " implicitly (another member type)")
            ;; (cpp-rind: a pointer to member function converts to none of another function type, [conv.mem]/2 keeping the
            ;; member's type T (C++17's [conv.fctptr] taking only noexcept away); judged when every parameter and result type is
            ;; one the checker judges, the qualifiers left to the rule below: conversion/ptrmem7.C)
            (and (abi/fn? (abi/unq ft)) (abi/fn? (abi/unq tt))
                 (let [x (abi/unq ft) y (abi/unq tt)
                       sure? (fn [t] (let [t (abi/non-ref t)] (or (abi/void? (abi/unq t)) (and (not (abi/fn? (abi/unq t))) (cx-sure-scalar? t)))))]
                   (and (every? sure? (cons (:ret x) (:ps x))) (every? sure? (cons (:ret y) (:ps y)))
                        (or (not= (abi/unq (:ret x)) (abi/unq (:ret y))) (not= (mapv abi/unq (:ps x)) (mapv abi/unq (:ps y)))
                            (not= (boolean (:va x)) (boolean (:va y)))))))
            (fail :conversion "cannot convert " (cx-tyname from) " to " (cx-tyname to) " implicitly (another member function type)")
            (not= a b) (cx-mptr-base! b a true)
            :else nil))
        ;; (cpp-diag-b, round 2: [conv.ptr]/2 converts object pointers alone to cv void*, and nothing converts void* back: a
        ;; pointer to function and void* are converted by reinterpret_cast alone, CWG 195)
        (and (abi/ptr? to) (abi/ptr? from) (not (null-constant? e))
             (let [a (abi/unq (:to from)) b (abi/unq (:to to))]
               (or (and (abi/fn? a) (abi/void? b)) (and (abi/void? a) (abi/fn? b)))))
        (fail :conversion "cannot convert " (cx-tyname from) " to " (cx-tyname to) " implicitly (a function pointer and void*)")
        ;; (cpp-decl2: a pointer to function converts to no pointer to another function type, [conv.fctptr]/1 taking only
        ;; noexcept away (C++17); judged when every parameter and result type is one the checker judges: GCC's "cannot convert
        ;; 'void (*)(int)' to 'void (*)()' in initialization", conversion/err-recover1.C)
        (and (abi/ptr? to) (abi/ptr? from) (not (null-constant? e))
             (abi/fn? (abi/unq (:to from))) (abi/fn? (abi/unq (:to to)))
             (let [a (abi/unq (:to from)) b (abi/unq (:to to))
                   sure? (fn [t] (let [t (abi/non-ref t)] (or (abi/void? (abi/unq t)) (and (not (abi/fn? (abi/unq t))) (cx-sure-scalar? t)))))]
               (and (every? sure? (cons (:ret a) (:ps a))) (every? sure? (cons (:ret b) (:ps b)))
                    (or (not= (abi/unq (:ret a)) (abi/unq (:ret b))) (not= (mapv abi/unq (:ps a)) (mapv abi/unq (:ps b)))
                        (not= (boolean (:va a)) (boolean (:va b)))))))
        (fail :conversion "cannot convert " (cx-tyname from) " to " (cx-tyname to) " implicitly (another function type)")
        ;; (cpp-diag-b, round 2: pointers to arrays, [conv.qual]/3 with DR 330)
        (and (abi/ptr? to) (abi/ptr? from) (not (null-constant? e)) (not (abi/void? (abi/unq (:to to)))) (cx-array-qual-bad? from to))
        (fail :conversion "cannot convert " (cx-tyname from) " to " (cx-tyname to) " implicitly (no qualification conversion of arrays)")
        (and (abi/ptr? to) (abi/ptr? from) (not (null-constant? e))
             ;; (a string literal's decay to char*: ISO C++11's ill-formed conversion GCC gives as a warning unless
             ;; -pedantic-errors, -Wwrite-strings; not judged here)
             (not (and (= :decay (:op e)) (= :str (:op (:e e)))))
             (cx-bad-ptr-conv? from to))
        (fail :conversion "cannot convert " (cx-tyname from) " to " (cx-tyname to) " implicitly (no pointer conversion)")
        :else nil))))

(declare fp-lesser? gcc-type-str)

(defn- fp-rank-pedwarn!
  "cpp-extfloat (the checker): the implicit conversion of `e` from the floating type `from` to `to`, a lesser or unordered
  conversion rank between types not both standard (fp-lesser?): GCC's pedwarn \"ISO C++ does not allow converting to 'T' from
  'F' with greater conversion rank\" [-Wnarrowing], reported where *fp-rank-error* makes it an error (the analysis goes on)."
  [e from to]
  (when (and *fp-rank-error* (checking?) *on-refusal* (fp-lesser? from to))
    (let [n (if-let [r (:cx-at e)] {:range r} (some-> *at* deref))
          c (abi/fp-rank-cmp to from)]
      (when n
        (*on-refusal* (ex-info (str "codegen: narrowing conversion: ISO C++ does not allow converting to '" (gcc-type-str to) "' from '"
                                    (gcc-type-str from) "' with " (if c "greater" "unordered") " conversion rank")
                               {:codegen/refused :narrowing :cx/node n})
                      n)))))

(defn convert-scalar
  "The standard conversion of the prvalue `e` to the scalar type `t` (implicit or, with `explicit?`, a cast's)."
  [e t explicit?]
  (let [e (if (and (= :fnset (:op e)) (abi/ptr? (abi/unq t)) (abi/fn? (:to (abi/unq t))))
            (if-let [f (fn-matching e (:to (abi/unq t)))] {:op :fnaddr :fn f :ty (abi/ptr (:ty (fnd f))) :cat :pr} (fail :conversion "no function of the set matches"))
            e)
        ;; (queue 380: &f of an overload set converted to a pointer to function: the set's function of the target's type)
        e (if-let [f (when (and (= :fnaddr (:op e)) (:set e) (abi/ptr? (abi/unq t)) (abi/fn? (:to (abi/unq t))))
                       (fn-matching (:set e) (:to (abi/unq t))))]
            {:op :fnaddr :fn f :ty (abi/ptr (:ty (fnd f))) :cat :pr}
            e)
        e (if (= :mptr-fnset (:op e))
            (let [mt (abi/unq t)
                  ok (filter #(let [n (mptr-fn-node %)] (= (:to (:ty n)) (:to mt))) (:fns e))]
              (if (and (abi/mptr? mt) (seq ok)) (mptr-fn-node (first ok)) (rv e)))
            e)
        from (abi/unq (:ty e)) to (abi/unq t)]
    (cond
      (= from to) e
      (abi/void? to) (cast-node e :void to)
      (= :bool (abi/bn to)) (cast-node e :to-bool to)
      (and (abi/integral? from) (abi/integral? to)) (if (= (abi/llvm-type from) (abi/llvm-type to)) (cast-node e :noop to) (cast-node e :int to))
      (and (abi/integral? from) (abi/floating? to)) (cast-node e :int->fp to)
      (and (abi/floating? from) (abi/integral? to)) (cast-node e :fp->int to)
      (and (abi/floating? from) (abi/floating? to)) (do (when-not explicit? (fp-rank-pedwarn! e from to)) (cast-node e :fp to))
      (and (abi/ptr? to) (null-constant? e)) {:op :null :ty to :cat :pr}
      (and (abi/mptr? to) (null-constant? e)) {:op :null :ty to :cat :pr}
      ;; (queue 492: [conv.ptr]/1, a null pointer constant of integral type converts to std::nullptr_t,
      ;; `decltype(nullptr) n = 0;`)
      (and (= :nullptr (abi/bn to)) (abi/integral? from) (null-constant? e)) {:op :null :ty to :cat :pr}
      ;; (cpp-tzdb, the code generator: [conv.fctptr]/1, a pointer to a noexcept member function to one to the same function
      ;; type without it, the same value -- eh_ptr.cc's `return _M_exception_object ? &exception_ptr::_M_safe_bool_dummy :
      ;; nullptr;` to __safe_bool, since cpp-rt-own4 keeps noexcept on the member function pointer's type, :nx)
      (and (not (checking?)) (abi/mptr? to) (abi/mptr? from) (= (:cls to) (:cls from)) (abi/fn? (:to from)) (abi/fn? (:to to))
           (:nx (:to from)) (= (dissoc (:to from) :nx) (dissoc (:to to) :nx)))
      (assoc e :ty to)
      (and (abi/mptr? to) (abi/mptr? from) (abi/derived-from? (:cls to) (:cls from)))
      {:op :mptr-adj :e e :off (second (abi/base-path (:cls to) (:cls from))) :ty to :cat :pr}
      ;; (cpp-rind: [conv.qual]/3, a pointer to data member of one class whose member type gains cv-qualifiers, `const int D::* q =
      ;; &D::x;`, a qualification conversion; it had been refused as no conversion, a false error)
      (and (abi/mptr? to) (abi/mptr? from) (= (:cls to) (:cls from)) (not (abi/fn? (abi/unq (:to to))))
           (= (abi/unq (:to to)) (abi/unq (:to from)))
           (or explicit? (and (or (:c (:to to)) (not (:c (:to from)))) (or (:v (:to to)) (not (:v (:to from)))))))
      (cast-node e :noop to)
      (and (abi/ptr? to) (abi/ptr? from))
      (let [fc (class-id (:to from)) tc (class-id (:to to))]
        (cond
          (and fc tc (abi/derived-from? fc tc)) (cast-node e :base to)
          (and fc tc explicit? (abi/derived-from? tc fc)) (cast-node e :derived to)
          :else (cast-node e :noop to)))
      (and (abi/ptr? to) (abi/integral? from) explicit?) (cast-node e :int->ptr to)
      (and (abi/integral? to) (abi/ptr? from) explicit?) (cast-node e :ptr->int to)
      (and (abi/ptr? to) (= :nullptr (abi/bn from))) {:op :null :ty to :cat :pr}
      ;; (CX12, the checker: two pointers to member functions of one class whose types differ only in the member
      ;; function's qualifiers, [conv.mem]/2 converts neither way: clang's err_typecheck_convert_incompatible)
      (and (checking?) (not explicit?) (abi/mptr? to) (abi/mptr? from) (abi/fn? (:to to)) (abi/fn? (:to from)) (= (:cls to) (:cls from))
           (not= (:to to) (:to from))
           (= (apply dissoc (:to to) [:refq :cq :vq]) (apply dissoc (:to from) [:refq :cq :vq])))
      (fail :conversion "incompatible member function pointer types (qualifiers)")
      ;; (queue 460, the checker: an implicit conversion between scalar types it knows, none of the above, is refused
      ;; as the program's: void, std::nullptr_t to an integer, a pointer to an integer, unrelated pointers to members)
      (and (checking?) (not explicit?) (not *cx-union-init*) (cx-sure-scalar? from) (cx-sure-scalar? to) (not= :nullptr (abi/bn to)))
      (fail :conversion "cannot convert " (cx-tyname from) " to " (cx-tyname to) " implicitly")
      :else (fail :conversion "conversion from " (pr-str from) " to " (pr-str to)))))

;; Implicit conversion sequences: {:rank 0 exact, 1 promotion, 2 conversion, 3 user-defined, 4 ellipsis, :sub n}

(declare ctor-candidates resolve-overload analyze-implicit!)

(defn fp-lesser?
  "cpp-extfloat: whether converting the floating type `from` to the floating type `to` goes to a lesser or unordered conversion
  rank between types not both standard, no standard conversion ([conv.double]/1, P1467R9): GCC's pedwarn \"converting to ...
  with greater conversion rank\" (-Wnarrowing)."
  [from to]
  (let [from (abi/unq from) to (abi/unq to)]
    (boolean (and (abi/floating? from) (abi/floating? to)
                  (not (and (abi/standard-floating (abi/bn from)) (abi/standard-floating (abi/bn to))))
                  (let [c (abi/fp-rank-cmp to from)] (or (nil? c) (neg? (long c))))))))

(defn- std-rank
  "The rank of the standard conversion from the prvalue type `from` (expression e) to the non-reference type `to`, or nil."
  [e from to]
  (let [from (abi/unq from) to (abi/unq to)]
    (cond
      (= from to) 0
      (and (abi/arith? to) (or (abi/arith? from) (and (abi/enum? from) (not (:scoped (abi/enm (:id from)))))))
      (if (or (= (promote-type from) to)
              ;; (cpp-rind, the checker: [conv.prom]/4, an unscoped enumeration with a fixed underlying type promotes to that type
              ;; too, not only to its promoted type: cpp0x/scoped_enum11.C's f4(e2) for f4(short) and f4(long))
              (and (checking?) (abi/enum? from) (:fixed (abi/enm (:id from))) (= (abi/unq (abi/underlying from)) to)))
        (if (or (abi/enum? from) (contains? abi/int-ranks (abi/bn from))) 1 2)
        (if (and (= :float (abi/bn from)) (= :double (abi/bn to))) 1 2))
      (and (= :bool (abi/bn to)) (or (abi/ptr? from) (abi/arith? from))) 2
      (and (abi/ptr? to) (null-constant? e)) 2
      ;; (queue 518, the checker: [conv.ptr]/1, an integral null pointer constant to std::nullptr_t, a null pointer conversion
      ;; as to a pointer's, so `k(0)` for k(char*) and k(nullptr_t) is ambiguous: cpp0x/nullptr19.C)
      (and (checking?) (= :nullptr (abi/bn to)) (abi/integral? from) (null-constant? e)) 2
      (and (abi/ptr? to) (abi/ptr? from))
      (let [ft (:to from) tt (:to to)]
        (cond
          (and (= (abi/unq ft) (abi/unq tt)) (or (:c tt) (not (:c ft)))) (if (= ft tt) 0 0)
          (and (abi/void? tt) (or (:c tt) (not (:c ft)))) 2
          (and (class-id ft) (class-id tt) (abi/derived-from? (class-id ft) (class-id tt)) (or (:c tt) (not (:c ft)))) 2
          :else nil))
      (and (abi/mptr? to) (null-constant? e)) 2
      (and (abi/mptr? to) (abi/mptr? from) (= (:to from) (:to to)) (abi/derived-from? (:cls to) (:cls from))) 2
      (and (= :bool (abi/bn to)) (abi/mptr? from)) 2
      :else nil)))

(defn- arr-unq "A type without its cv-qualifiers, an array's at its elements ([basic.type.qualifier]/3)." [t]
  (if (abi/arr? t) (assoc (abi/unq t) :of (arr-unq (:of t))) (abi/unq t)))
(defn- arr-cv "The type whose qualifiers are the type's (an array's elements')." [t] (if (abi/arr? t) (arr-cv (:of t)) t))

(defn conv-fns
  "The conversion functions of class `id` and its bases ([class.conv.fct]), a derived class's hiding a base's of the same
  name."
  [id]
  (let [c (abi/cls id)
        own (filter #(= :conv (:kind (fnd %))) (:methods c))
        names (set (map #(:name (fnd %)) own))]
    (concat own (remove #(names (:name (fnd %))) (mapcat #(conv-fns (:cls %)) (:bases c))))))

(declare deduced! method-call init-for var-node)

(defn conv-tmpls
  "cpp-s14 (CP389 (a)): the conversion function templates of class `id` and its bases ([class.conv.fct]/1, [temp.mem]/5)."
  [id]
  (let [c (abi/cls id)] (distinct (concat (:conv-tmpls c) (mapcat #(conv-tmpls (:cls %)) (:bases c))))))

(defn- conv-specs
  "cpp-s14 (CP389 (a)): the conversion function templates' specializations of class `id` for the target type `t`
  ([temp.deduct.conv]; [over.match.conv]/1: a template's specialization deduced for the target is a candidate)."
  [id t]
  (when (seq (conv-tmpls id))
    (when-let [h (:conv-candidates @hooks)] (h id t))))

(defn- glam-conv!
  "CP301 (a): the conversion of a captureless generic lambda's closure (class `cid`) to a pointer to the function type
  `F` ([expr.prim.lambda.closure]/9-10): the specialization of its conversion function template for F, made once per F,
  returning the address of a static invoker (`__invoke`, a specialization of the invoker template as clang's, its
  arguments the call operator's) that calls the call operator's specialization deduced from F's parameter types on a
  closure object; nil when none is deduced or its type is not F (the result type is a pointer to the specialization's
  type, which converts to no other pointer to function)."
  [cid F]
  (let [c (abi/cls cid)
        {:keys [tid base-f]} (:glam-conv c)]
    (when tid
      (or (get (:glam-convs c) F)
          ;; (the checker's position stays the conversion's: the call operator's specialization is analyzed here)
          (when-let [fid (let [a *at* saved (some-> a deref)]
                           (try (some-> (when-let [h (:glam-spec @hooks)] (h tid F)) deduced!) (finally (when a (reset! a saved)))))]
            (let [f (fnd fid)
                  ret (let [r (:ret (:ty f))] (if (= :auto (:k r)) abi/void r))
                  ps (:ps (:ty f))
                  t {:k :class :id cid}
                  ;; (the target's own function type: the conversion's result type is exactly the parameter's)
                  ft F]
              (when (and (= (abi/unq ret) (abi/unq (:ret F))) (= (mapv abi/unq ps) (mapv abi/unq (:ps F))))
                (let [ivid (next-id) cvid (next-id)
                      ipids (vec (for [pt ps] (let [pid (next-id)] (swap! *vars* assoc pid {:id pid :name nil :ty pt :storage :param :fn ivid}) pid)))
                      lv (next-id)
                      _ (swap! *vars* assoc lv {:id lv :name nil :ty t :storage :local :fn ivid})
                      _ (swap! *fns* assoc ivid (merge base-f {:id ivid :name "__invoke" :kind :method :static true :ty ft :param-names []
                                                               :tinst (assoc (:tinst f) :tid [:invoke tid])}))
                      call (binding [*cx-no-imm* true] (method-call {:scope (:scope base-f)} fid {:op :var :id lv :ty t :cat :lv} (mapv var-node ipids) false))
                      ret-s (if (abi/void? ret) {:s :return :void-e call} {:s :return :init (init-for ret call {:scope (:scope base-f)} :copy)})]
                  (upd-fn! ivid assoc :params ipids :tbody {:s :block :items [{:s :decl :var lv :init {:i :none}} ret-s]})
                  (swap! *fns* assoc cvid (merge base-f {:id cvid :name "operator function" :kind :conv :cq true :ty {:k :fn :ret (abi/ptr ft) :ps [] :va false} :cx-callop fid
                                                        ;; (mangled as clang's specialization of the conversion function
                                                        ;; template, `template <class T> operator auto (*)(T)() const`)
                                                        :tinst (assoc (:tinst f) :tid [:conv tid] :tsig {:k :fn :ret nil :ps [] :va false})
                                                        :mangle-ret (abi/ptr (let [sg (:tsig (:tinst f))] {:k :fn :ret (:ret sg) :ps (:ps sg) :va (boolean (:va sg))}))
                                                        :param-names [] :params []
                                                        :tbody {:s :block :items [{:s :return :init {:i :expr :e {:op :fnaddr :fn ivid :ty (abi/ptr ft) :cat :pr}}}]}}))
                  (abi/update-cls! cid #(-> % (update :methods (fnil conj []) cvid) (assoc-in [:glam-convs F] cvid)))
                  cvid))))))))

(defn- conv-for
  "The conversion function of class `id` that converts best to the non-class type `t` (explicit ones when
  `explicit?`), or nil."
  [id t explicit? & [obj-c]]
  ;; (CP301 (a): a captureless generic lambda's conversion to a pointer to function made for the target's function type)
  (when (and (:glam-conv (abi/cls id)) (abi/ptr? (abi/unq t)) (abi/fn? (abi/unq (:to (abi/unq t)))))
    (glam-conv! id (abi/unq (:to (abi/unq t)))))
  (let [cands (for [fid (concat (conv-fns id) (conv-specs id t))
                    :let [f (fnd fid)] :when (or explicit? (not (:explicit f)))
                    ;; (CX12: a const object's conversion functions are the const ones, the implicit object parameter's
                    ;; binding, [over.match.funcs]/4-5; the checker's, since CP312 (a) the code generator's too)
                    :when (or (not obj-c) (:cq f) (:cq (:ty f)))
                    ;; (CX12: in direct-initialization an explicit conversion function is a candidate only when it yields
                    ;; the type, or one a qualification conversion converts to it, [over.match.conv]/1.1; since CP312 (a) for
                    ;; the code generator too)
                    :when (or (not explicit?) (not (:explicit f)) (abi/class? (abi/unq t))
                              (= (abi/unq (abi/non-ref (:ret (:ty f)))) (abi/unq t)))
                    ;; (cpp-s14: an array or function result decayed first, [over.best.ics]'s second standard conversion
                    ;; from the lvalue: a conversion function template returning a reference to one, [temp.deduct.conv]/3)
                    :let [rt (abi/non-ref (:ret (:ty f)))
                          rt (cond (abi/arr? rt) (abi/ptr (:of rt)) (abi/fn? rt) (abi/ptr rt) :else rt)
                          r (if (= (abi/unq rt) (abi/unq t)) 0 (std-rank {:op :call :ty rt} rt t))] :when r]
                [r fid])]
    (second (first (sort-by first cands)))))

(defn- cx-conv-ambiguous?
  "Queue 518 (the checker): whether class `id`'s conversion to the non-class type `t` (conv-for's) is ambiguous ([over.match.conv],
  [over.match.best]): two or more conversion functions, no templates, of one implicit object parameter's qualifiers, whose results
  convert to `t` by the best rank, an exact match or a promotion, which no tie-breaker separates (conversion/ambig1.C's operator
  char and operator short to int, lookup/conv-1.C's operator int of two bases)."
  [id t explicit? & [obj-c]]
  (when (checking?)
    (let [cands (for [fid (distinct (conv-fns id))
                      :let [f (fnd fid)] :when (or explicit? (not (:explicit f)))
                      :when (or (not obj-c) (:cq f) (:cq (:ty f)))
                      :when (or (not explicit?) (not (:explicit f)) (= (abi/unq (abi/non-ref (:ret (:ty f)))) (abi/unq t)))
                      :let [rt (abi/non-ref (:ret (:ty f)))
                            r (when (and (abi/arith? (abi/unq rt)) (abi/arith? (abi/unq t)))
                                (if (= (abi/unq rt) (abi/unq t)) 0 (std-rank {:op :call :ty rt} rt t)))]
                      :when r]
                  [r fid (boolean (or (:cq f) (:cq (:ty f))))])
          best (when (seq cands) (reduce min (map first cands)))
          tied (filter #(= best (first %)) cands)]
      (boolean (and best (<= (long best) 1) (>= (count tied) 2) (empty? (conv-specs id t))
                    (= 1 (count (distinct (map #(nth % 2) tied)))))))))

(defn- ref-conv-for
  "cpp-s14: the conversion function of class `id` whose result the reference type `t` binds to directly ([dcl.init.ref]
  /5.1.2 for an lvalue reference: an lvalue of a type `t` is reference-compatible with; /5.3.2 for an rvalue reference:
  an xvalue of one; [over.match.ref]), a conversion function template's specialization deduced for the reference
  ([temp.deduct.conv]/4) among them; an exact type before a base's; or nil; :ambiguous when no candidate is better
  than every other ([over.match.best], [over.ics.rank]/4.4.4: two results of unrelated classes derived from the
  reference's, PR c++/57948's g++.dg/conversion/ambig2.C). (A prvalue result binds through a temporary as before.)"
  [id t & [obj-c]]
  (let [pt (:to t)
        tmpl (set (conv-specs id t))
        cands (for [fid (distinct (concat (conv-fns id) (conv-specs id t)))
                    :let [f (fnd fid) r (:ret (:ty f)) rt (:to r)]
                    :when (and (not (:explicit f)) (or (not obj-c) (:cq f) (:cq (:ty f)))
                               (= (if (= :ref (:k t)) :ref :rref) (:k r)))
                    :let [same (= (arr-unq rt) (arr-unq pt))
                          derived (and (not same) (class-id rt) (class-id pt) (abi/derived-from? (class-id rt) (class-id pt)))]
                    :when (and (or same derived)
                               (or (:c (arr-cv pt)) (not (:c (arr-cv rt))))
                               (or (:v (arr-cv pt)) (not (:v (arr-cv rt)))))]
                {:r (if same 0 1) :fid fid :cls (class-id rt) :tmpl (contains? tmpl fid) :cq (boolean (or (:cq f) (:cq (:ty f))))})
        ;; (gate b1-1115: the first of the sorted candidates was taken, so an ambiguous binding was accepted.) X is better
        ;; than Y: an identity before a derived-to-base conversion; of two derived-to-base, the result's class nearer the
        ;; reference's ([over.ics.rank]/4.4.4); else of the same result a function before a template's specialization
        ;; ([over.match.best]/2.5) and, for a non-const object, a non-const function before a const one (/2.1, the implicit
        ;; object parameter's binding, [over.ics.rank]/3.2.6)
        better? (fn [x y]
                  (or (< (:r x) (:r y))
                      (and (= 1 (:r x) (:r y)) (not= (:cls x) (:cls y)) (abi/derived-from? (:cls y) (:cls x)))
                      (and (= (:r x) (:r y)) (= (:cls x) (:cls y))
                           (or (and (not (:tmpl x)) (:tmpl y))
                               (and (= (:tmpl x) (:tmpl y)) (not obj-c) (not (:cq x)) (:cq y))))))
        best (filter (fn [x] (every? #(or (= % x) (better? x %)) cands)) cands)]
    (cond (empty? cands) nil
          (= 1 (count best)) (:fid (first best))
          :else :ambiguous)))

(def ^:dynamic *no-user* false) ; inside a user-defined conversion: standard conversions only ([over.best.ics]/4)
(def ^:dynamic *conv-tmpl-cache* nil) ; atom {[class arg-type cat value op] bool}: a converting constructor template converts

(defn- list-ctor-viable?
  "cpp-s11 ([over.match.list], for [over.ics.list]/7): whether a constructor of the non-aggregate class `id` is viable
  for the braced list's elements `items`: an initializer-list constructor taken as viable (its own conversion is the
  element's, as before), an empty list as viable (value-initialization), else the constructors (the templates' deduced
  specializations among them) for the elements as arguments; a refusal other than \"no viable function\" leaves it
  viable, as before. Memoized per class and the elements' types and categories."
  [id items]
  (let [k [:list-ctor id (mapv (juxt :ty :cat :op) items)]
        m *conv-tmpl-cache*
        v (if m (get @m k ::none) ::none)]
    (if (not= ::none v)
      v
      (let [r (cond
                (empty? items) true
                (some #(when-let [p0 (first (:ps (:ty (fnd %))))] (init-list-elem (abi/non-ref p0))) (ctor-candidates id)) true
                :else
                (let [cands (concat (ctor-candidates id) (when-let [h (:ctor-candidates @hooks)] (h id items)))]
                  (try (resolve-overload cands items nil) true
                       (catch arbace.lang.ExceptionInfo e
                         (not (re-find #"^codegen: no viable function" (str (ex-message e))))))))]
        (when m (swap! m assoc k r))
        r))))

(defn- unspelled-fn [t] (when (map? t) (dissoc t :written :qual)))

;; cpp-decl2: designated initializer lists in overload resolution ([over.ics.list]/2, C++20): a designated-initializer-list
;; converts only to an aggregate class its designators can initialize, each naming a direct non-static data member (or one
;; of an anonymous member's); the order is not part of the conversion, but once the function is chosen its parameter's
;; initialization is ill-formed when the designators do not follow the members' declaration order ([dcl.init.list]/3.1,
;; [dcl.init.aggr]/3.1: GCC's "designator order for field 'A::x' does not match declaration order in 'A'"; cpp2a/desig4.C,
;; cpp2a/desig6.C). The parser places a non-overloaded callee's list itself (arbace.repr.cpp.parse/designate).
(defn- desig-field-index
  "The index among class `cid`'s non-static data members of the member the designator name `v` names, directly or through
  an anonymous member (that member's index), or nil."
  [cid v]
  (let [fls (vec (remove :static (:fields (abi/cls cid))))]
    (some (fn [[i fl]]
            (cond (= v (:name fl)) i
                  (and (:anon fl) (abi/class? (abi/unq (:ty fl))) (desig-field-index (:id (abi/unq (:ty fl))) v)) i
                  :else nil))
          (map-indexed vector fls))))

(defn- desig-convertible?
  "Whether the designated list `e` (an :init-list with :desigs) can initialize the type `pt` ([over.ics.list]/2)."
  [e pt]
  (let [u (abi/unq pt)]
    (and (abi/class? u) (aggregate? u) (not (:union (abi/cls (:id u))))
         (every? (fn [d] (or (nil? d) (let [[k v] (first d)] (and (= :f k) (desig-field-index (:id u) v))))) (:desigs e)))))

(defn- desig-order!
  "The checker: the designated list `a` initializing a parameter of type `p`, its designators out of the members' order."
  [a p]
  (when (and (checking?) *on-refusal* (= :init-list (:op a)) (:desigs a))
    (let [u (abi/unq (abi/non-ref p))]
      (when (and (abi/class? u) (aggregate? u) (not (:union (abi/cls (:id u)))))
        (loop [ds (seq (:desigs a)) prev -1]
          (when ds
            (let [d (first ds) [k v] (first d)
                  i (when (and d (= :f k)) (desig-field-index (:id u) v))]
              (cond (nil? i) (recur (next ds) prev)
                    (< (long i) (long prev))
                    (let [cn (:name (abi/cls (:id u)))]
                      (*on-refusal* (ex-info (str "codegen: designator order for field '" cn "::" v "' does not match declaration order in '" cn "'")
                                             {:codegen/refused :init :cx/node (:desig-node a)})
                                    (:desig-node a)))
                    :else (recur (next ds) (long i))))))))))

(declare better-ics?)

(defn ics
  "The implicit conversion sequence of the argument `e` (a typed expression or {:op :init-list}) to the parameter type `p`."
  [e p]
  (let [pt (abi/non-ref p)
        at (:ty e)]
    (cond
      ;; (queue 514, the checker: a name that is functions, no template, binds an lvalue reference to a function type one of
      ;; them has exactly, [over.ics.ref]/1 with [over.over]/1: template/unify7.C's Foo(f) for Foo<int &()>(int &(&)()))
      (and (checking?) (= :fnset (:op e)) (empty? (:tmpls e)) (= :ref (:k p)) (abi/fn? (abi/unq pt))
           (some #(= (unspelled-fn (abi/unq pt)) (unspelled-fn (:ty (fnd %)))) (:fns e)))
      {:rank 0}
      ;; (cpp-decl2: a designated list converts to an aggregate its designators name members of, [over.ics.list]/2)
      (and (= :init-list (:op e)) (:desigs e) (not (desig-convertible? e pt))) nil
      ;; an overload set converts to a pointer to function only ([over.over]; G5: std::endl among operator<<'s candidates)
      (and (= :fnset (:op e)) (not (and (abi/ptr? (abi/unq pt)) (abi/fn? (:to (abi/unq pt)))))) nil
      ;; (queue 423: a braced list for a reference to a class, [over.ics.list]/9 with [dcl.init.list]/3.10: one element of a
      ;; reference-related class binds the reference to it, its own conversion; else the reference binds the list's temporary,
      ;; an rvalue, so that [over.ics.rank]/3.2.3 prefers the rvalue reference: `s = {}` of an aggregate had ranked the
      ;; implicit copy and move assignments equal, "ambiguous call (2 viable)")
      (and (= :init-list (:op e)) (abi/ref? p) (abi/class? pt)
           (= 1 (count (:items e))) (:ty (first (:items e))) (class-id (:ty (first (:items e))))
           (or (= (class-id (:ty (first (:items e)))) (:id pt)) (abi/derived-from? (class-id (:ty (first (:items e)))) (:id pt))))
      (ics (first (:items e)) p)
      (and (= :init-list (:op e)) (abi/ref? p) (abi/class? pt))
      (when-let [r (ics e pt)]
        (when-not (and (= :ref (:k p)) (not (:c pt)))
          (assoc r :sub (if (= :rref (:k p)) -1 1))))
      (= :init-list (:op e))
      (cond (init-list-elem pt) (let [el (init-list-elem pt) rs (map #(ics % el) (:items e))]
                                  ;; [over.ics.list]/5: the worst conversion of an element
                                  (when (every? some? rs) {:rank (reduce max 0 (map #(long (:rank %)) rs))}))
            (and (abi/class? pt) (aggregate? pt)) {:rank 3}
            ;; (cpp-s11: a non-aggregate class, [over.ics.list]/7: a user-defined conversion when [over.match.list] finds
            ;; a viable constructor for the list, none when it finds none; <format>'s _Utf32_view<subrange<iterator>>
            ;; ({__first, __last}) had taken _Utf_view's copy and move constructors for viable beside its explicit
            ;; _Utf_view(_View), and refused initializing a _Utf_view from the two iterators)
            (and (abi/class? pt) (seq (ctor-candidates (:id pt)))) (when (list-ctor-viable? (:id pt) (:items e)) {:rank 3})
            ;; (a non-const lvalue reference binds no list's temporary, [over.ics.list]/9 with [dcl.init.ref]/5)
            (and (= :ref (:k p)) (not (:c pt)) (not (and (= 1 (count (:items e))) (lv? (first (:items e)))))) nil
            (and (abi/scalar? pt) (<= (count (:items e)) 1)) {:rank (if (seq (:items e)) (or (std-rank (rv (first (:items e))) (:ty (rv (first (:items e)))) pt) 9) 0)}
            :else nil)
      (abi/ref? p)
      ;; (cpp-rt-own: marked a reference binding, :refb, whose :sub better-ics? weighs against another reference binding's alone,
      ;; [over.ics.rank]/3.2.3 and /3.2.6: `const I&` and a by-value `F` for an lvalue are both identities, the call then decided
      ;; by the templates' partial ordering, <bits/stl_iterator.h>'s __niter_wrap(const _Iterator&, _Iterator))
      (some-> (let [same (= (arr-unq at) (arr-unq pt))
            derived (and (class-id at) (class-id pt) (abi/derived-from? (class-id at) (class-id pt)))
            cv-ok (and (or (:c (arr-cv pt)) (not (:c (arr-cv at))))
                       ;; CX12 (the checker): volatile too ([dcl.init.ref]/4-5, reference-compatible: cv1 >= cv2)
                       (or (not (checking?)) (:v (arr-cv pt)) (not (:v (arr-cv at)))))
            cv-sup (or (not (checking?)) (not (or same derived))
                       (and (or (:c (arr-cv pt)) (not (:c (arr-cv at)))) (or (:v (arr-cv pt)) (not (:v (arr-cv at))))))]
        (cond
          (and (= :ref (:k p)) (lv? e) (= :lv (:cat e)) (or same derived) cv-ok)
          (cond-> {:rank (if derived 2 0) :sub (if (and (:c pt) (not (:c at))) 1 0)}
            derived (assoc :d2b [(class-id at) (class-id pt)])
            ;; (CX12, the checker: [over.ics.rank]/3.2.6 orders two such bindings by their cv-qualifiers' inclusion)
            (checking?) (assoc :cvq (cond-> #{} (:c (arr-cv pt)) (conj :c) (:v (arr-cv pt)) (conj :v))))
          ;; (cpp-rt-own: with the cv-qualifiers it binds, [over.ics.rank]/3.2.6: std::get<0>(std::move(p)) of a pair, get(pair&&)
          ;; before get(const pair&&), memory_resource.cc's, the latter taken before)
          (and (= :rref (:k p)) (not= :lv (:cat e)) (or same derived) cv-sup) (cond-> {:rank (if derived 2 0) :sub -1
                                                                                       :cvq (cond-> #{} (:c (arr-cv pt)) (conj :c) (:v (arr-cv pt)) (conj :v))}
                                                                                derived (assoc :d2b [(class-id at) (class-id pt)]))
          ;; (cpp-s14: a class's conversion function binding the reference directly, [over.ics.ref]/1, [dcl.init.ref]/5.1.2)
          (and (not *no-user*) (class-id at) (not (or same derived)) (ref-conv-for (class-id at) p (:c at))) {:rank 3}
          ;; (CX12, the checker: a reference-related type losing a qualifier binds neither directly nor to a temporary,
          ;; [dcl.init.ref]/5.4.4)
          (not cv-sup) nil
          ;; (CX12, the checker: an lvalue reference to volatile binds no rvalue, [dcl.init.ref]/5.4)
          (and (checking?) (= :ref (:k p)) (:v (arr-cv pt))) nil
          (and (= :ref (:k p)) (lv? e) (not (:c pt))) nil
          (and (= :ref (:k p)) (not (:c pt))) nil
          ;; a const lvalue reference or an rvalue reference to a temporary
          (and (= :rref (:k p)) (= :lv (:cat e)) (or same derived)) nil
          :else (when-let [r (ics (if (lv? e) e e) pt)] (assoc r :sub (if (= :rref (:k p)) -1 (inc (long (or (:sub r) 0))))))))
              (assoc :refb true))
      (abi/class? pt)
      (cond
        (and (class-id at) (= (class-id at) (:id pt))) {:rank 0}
        ;; (queue 367: with its classes, [over.ics.rank]/4.4.4: of two derived-to-base conversions of one class, the nearer
        ;; base's better; basic_string's _M_construct(.., forward_iterator_tag) over (.., input_iterator_tag) for a
        ;; random_access_iterator_tag, string-inst.cc's S::basic_string(C*, C*, const allocator<C>&))
        (and (class-id at) (abi/derived-from? (class-id at) (:id pt))) {:rank 2 :d2b [(class-id at) (:id pt)]}
        *no-user* nil
        ;; the source class's conversion function to the class ([over.ics.user]; G5: strong_ordering to partial_ordering)
        (and (class-id at) (conv-for (class-id at) (abi/unq pt) false (:c at))) {:rank 3}
        :else (let [converts? (fn [cid] (let [f (fnd cid)]
                                          (and (not (:explicit f)) (>= (count (:ps (:ty f))) 1)
                                               (not (let [p0 (first (:ps (:ty f)))] (and (abi/ref? p0) (= (class-id (:to p0)) (:id pt)))))
                                               (<= (- (count (:ps (:ty f))) (count (filter some? (:defaults f)))) 1)
                                               (let [r (binding [*no-user* true] (ics e (first (:ps (:ty f)))))] (and r (< (long (:rank r)) 3))))))]
                (when (or (some converts? (ctor-candidates (:id pt)))
                          ;; (a converting constructor template's specialization for the argument, [over.match.copy]/1.1 with
                          ;; [temp.deduct.call]: std::basic_string's C++17 `template<typename = _RequireAllocator<_Alloc>>
                          ;; basic_string(const _CharT*, const _Alloc& = _Alloc())`, a literal given to a const string&; tried
                          ;; only when no constructor that is no template converts; cpp-route)
                          (when-let [h (:ctor-candidates @hooks)]
                            (when-not (= :init-list (:op e))
                              ;; (by the class and the argument's type, category and, for a null pointer constant, value: a
                              ;; program asks the same conversion many times, and each asks deduction and instantiation)
                              (let [k [(:id pt) (:ty e) (:cat e) (when (= :int (:op e)) (:v e)) (:op e)]
                                    c *conv-tmpl-cache*]
                                (if-some [v (when c (get @c k))]
                                  v
                                  (let [v (boolean (some converts? (binding [*no-user* true] (h (:id pt) [e]))))]
                                    (when c (swap! c assoc k v))
                                    v))))))
                  ;; (queue 518, the checker: two converting constructors neither of whose argument conversions is better,
                  ;; an ambiguous conversion sequence, [over.best.ics]/10: a user-defined one indistinguishable from any other,
                  ;; whose use by the function chosen is ill-formed (resolve-overload*'s :amb): overload/ambig3.C's f(3l) for
                  ;; A(int) and A(unsigned))
                  (if-let [rs (when (checking?)
                                (seq (keep (fn [cid] (when (converts? cid) (binding [*no-user* true] (ics e (first (:ps (:ty (fnd cid))))))))
                                           (ctor-candidates (:id pt)))))]
                    (if (and (>= (count rs) 2) (not-any? (fn [r] (every? #(or (identical? r %) (better-ics? r %)) rs)) rs))
                      {:rank 3 :amb true}
                      {:rank 3})
                    {:rank 3}))))
      (abi/class? at) (when (and (not *no-user*) (conv-for (class-id at) pt false (:c at)))
                        ;; (queue 518, the checker: an ambiguous conversion sequence, [over.best.ics]/10, resolve-overload*'s :amb)
                        (if (cx-conv-ambiguous? (class-id at) pt false (:c at)) {:rank 3 :amb true} {:rank 3}))
      (= :fnset (:op e)) (when (and (abi/ptr? (abi/unq pt)) (abi/fn? (:to (abi/unq pt))) (fn-matching e (:to (abi/unq pt)))) {:rank 0})
      ;; (queue 380: &f of an overload set, its set's function the parameter's type matches, an exact match, [over.ics.scs]/3)
      (and (= :fnaddr (:op e)) (:set e) (abi/ptr? (abi/unq pt)) (abi/fn? (:to (abi/unq pt))) (fn-matching (:set e) (:to (abi/unq pt))))
      {:rank 0}
      :else (let [r (std-rank e (:ty (rv e)) pt)
                  ft (abi/unq (:ty (rv e))) tt (abi/unq pt)]
              ;; [over.ics.rank]/3.2.6: a pointer's qualification adjustment ranks behind the identity
              ;; (cpp-rt-own: and behind the same conversion without it, /3.2.5: char* to void* before char* to const void*,
              ;; <cstring>'s void* memchr(void*, int, size_t) over ::memchr(const void*, ...) for a char*, floating_from_chars.cc's,
              ;; "ambiguous call (2 viable)" before)
              (when r (cond-> {:rank r :sub (if (and (abi/ptr? ft) (abi/ptr? tt)
                                                     (or (and (:c (:to tt)) (not (:c (:to ft)))) (and (:v (:to tt)) (not (:v (:to ft))))))
                                              1 0)}
                        ;; (cpp-rt-own: what [over.ics.rank]/4 orders among conversions of one rank, better-ics?'s: a pointer's to bool,
                        ;; to cv void*, to a base class's pointer)
                        (and (or (abi/ptr? ft) (abi/mptr? ft)) (= :bool (abi/bn tt))) (assoc :ptr-bool true)
                        ;; (cpp-rind, the checker: [over.ics.rank]/4.2 (DR 1601), the promotion of an enumeration with a fixed
                        ;; underlying type to that type before its promotion to the promoted type)
                        (and (checking?) (= 1 r) (abi/enum? ft) (:fixed (abi/enm (:id ft))) (= (abi/unq (abi/underlying ft)) tt))
                        (assoc :enum-under true)
                        (and (abi/ptr? ft) (abi/ptr? tt) (abi/void? (:to tt)) (not (abi/void? (:to ft)))) (assoc :ptr-void true)
                        (and (abi/ptr? ft) (abi/ptr? tt) (class-id (:to ft)) (class-id (:to tt))
                             (abi/derived-from? (class-id (:to ft)) (class-id (:to tt))))
                        (assoc :ptr-d2b [(class-id (:to ft)) (class-id (:to tt))])
                        ;; (cpp-extfloat, the checker: an arithmetic conversion's types, [over.ics.rank]/4.5's; a floating one to a
                        ;; lesser or unordered rank between types not both standard no standard conversion, [conv.double]/1)
                        (and (checking?) (= 2 (long r)) (abi/arith? ft) (abi/arith? tt)) (assoc :arith [ft tt])
                        (and (checking?) (fp-lesser? ft tt)) (assoc :fp-bad true)))))))

(defn- fp-better?
  "cpp-extfloat (the checker): [over.ics.rank]/4.5 (P1467R9), of the arithmetic conversions `a` and `b` ([from to] each) in one
  direction from or to one type FP1: a conversion between FP1 and a floating type FP2 of equal rank is better than one between
  FP1 and T3 when T3 is no floating type, or its rank is not FP1's, or FP2's subrank is greater than T3's."
  [[af at] [bf bt]]
  (let [[fp1 fp2 t3] (cond (= af bf) [af at bt] (= at bt) [at af bf] :else nil)]
    (boolean (and fp1 (abi/floating? fp1) (abi/floating? fp2) (= 0 (abi/fp-rank-cmp fp1 fp2))
                  (or (not (abi/floating? t3)) (not= 0 (abi/fp-rank-cmp fp1 t3)) (> (abi/fp-subrank fp2) (abi/fp-subrank t3)))))))

(defn- better-ics? [a b]
  (or (< (long (:rank a)) (long (:rank b)))
      (and (= (:rank a) (:rank b))
           (cond
             (and (:arith a) (:arith b) (fp-better? (:arith a) (:arith b))) true
             (and (:arith a) (:arith b) (fp-better? (:arith b) (:arith a))) false
             ;; (cpp-rt-own: [over.ics.rank]/4.1, a conversion that does not convert a pointer to bool before one that does;
             ;; /4.4.2-4.4.3, a pointer's conversion to its base's before its conversion to void*, and to a nearer base's before
             ;; a farther's: fs_ops.cc's `__os << __x` of a basic_filebuf*, operator<<(bool), (const void*) and
             ;; (basic_streambuf*) ambiguous before)
             (and (:ptr-bool b) (not (:ptr-bool a))) true
             (and (:ptr-bool a) (not (:ptr-bool b))) false
             (and (:enum-under a) (not (:enum-under b))) true
             (and (:enum-under b) (not (:enum-under a))) false
             (and (:ptr-d2b a) (:ptr-void b)) true
             (and (:ptr-void a) (:ptr-d2b b)) false
             (and (:ptr-d2b a) (:ptr-d2b b) (= (first (:ptr-d2b a)) (first (:ptr-d2b b))) (not= (second (:ptr-d2b a)) (second (:ptr-d2b b))))
             (boolean (abi/derived-from? (second (:ptr-d2b a)) (second (:ptr-d2b b))))
             (and (:d2b a) (:d2b b) (= (first (:d2b a)) (first (:d2b b))) (not= (second (:d2b a)) (second (:d2b b))))
             (boolean (abi/derived-from? (second (:d2b a)) (second (:d2b b))))
             (and (:cvq a) (:cvq b))
             (let [x (:cvq a) y (:cvq b)] (and (not= x y) (every? y x)))
             ;; (cpp-rt-own: a reference binding's :sub against another's alone; a pointer's qualification adjustment's against
             ;; a non-reference's)
             (not= (boolean (:refb a)) (boolean (:refb b))) false
             ;; (cpp-decl2, the checker: [over.ics.rank]/3.2.3 compares no binding of an implicit object parameter of a member
             ;; function declared without a ref-qualifier against an rvalue reference's: B::g(this S&&) and S::g() for S{}.g()
             ;; neither better, cpp2a/concepts-memfun4.C)
             (and (or (:noref a) (:noref b)) (or (neg? (long (or (:sub a) 0))) (neg? (long (or (:sub b) 0))))) false
             :else (< (long (or (:sub a) 0)) (long (or (:sub b) 0)))))))

(declare resolve-overload*)

(defn- cx-cmp-explain!
  "cpp-sweep (the checker): a defaulted comparison operator defined as deleted for its subobjects (defaulted-comparison!'s
  :cx-cmp-explain), used: GCC's explanation of each subobject at it (and of the declaration for a return type no comparison
  category type), once."
  [fid]
  (let [f (fnd fid)]
    (when (and (checking?) *on-refusal* (seq (:cx-cmp-explain f)) (not (:cx-cmp-reported f)))
      (upd-fn! fid assoc :cx-cmp-reported true)
      (doseq [{:keys [msg node]} (:cx-cmp-explain f) :when (and node (not (header-node? node)))]
        (*on-refusal* (ex-info (str "codegen: " msg) {:codegen/refused :nomatch :cx/node node}) node)))))

(declare cx-deleted-implicit!)

(defn resolve-overload
  "The best viable function of `cands` (fn ids) for the arguments `args` (typed expressions; `obj` the implicit object
  argument of a method call, or nil), or a refusal."
  [cands args obj]
  (resolve-overload* (map (fn [c] [c args obj true]) (distinct cands)) (count args)))

(declare strip-positions)

(defn resolve-overload*
  "The best viable of the candidates `cs` ([fn-id args obj] each: a member operator's with its object, a non-member's
  with every operand, [over.match.oper]/3), `n` the operands' count, or a refusal."
  [cs ^long n0]
  (let [;; (cpp-sweep, the checker: [dcl.link]/6, functions of C language linkage of one name declared in different namespaces
        ;; are one function: its declarations brought in by using-declarations one candidate, no ambiguity; a call that uses a
        ;; default argument the declarations give differently is GCC's "call to 'void f(int)' uses the default argument for
        ;; parameter 1, which is not yet defined"/"default argument mismatch": overload/extern-C-1.C)
        cs (if-not (checking?)
             cs
             (let [key (fn [[cid]] (let [f (fnd cid)]
                                     (when (and (= :c (:linkage f)) (nil? (:cls f)) (:name f))
                                       [(:name f) (mapv abi/unq (:ps (:ty f))) (boolean (:va (:ty f)))])))
                   groups (group-by key cs)]
               (vec (keep (fn [c]
                            (if-let [k (key c)]
                              (let [g (get groups k)]
                                (when (identical? c (first g))
                                  (when (> (count (distinct (map first g))) 1)
                                    (let [nargs (count (second c)) ps (:ps (:ty (fnd (first c))))]
                                      (when (< nargs (count ps))
                                        (let [ds (map (fn [[cid]] (mapv #(when % (strip-positions %)) (drop nargs (:defaults (fnd cid))))) g)]
                                          (when (> (count (distinct ds)) 1)
                                            (fail :overload "default argument mismatch in overload resolution for '" (:name (fnd (first c))) "'"))))))
                                  c))
                              c))
                          cs))))
        cands (map first cs)
        viable (for [[cid args obj prefix] cs
                     :let [f (fnd cid)
                           ps (:ps (:ty f))
                           nreq (- (count ps) (count (filter some? (take-last (count ps) (concat (repeat (count ps) nil) (:defaults f))))))
                           n (count args)]
                     :when (and (>= n nreq) (or (<= n (count ps)) (:va (:ty f))) (trailing-ok? f))
                     :let [convs (map-indexed (fn [i a] (if (< i (count ps)) (ics a (nth ps i)) {:rank 4})) args)
                           ;; the implicit object parameter: a const method takes a const object, a non-const prefers a non-const one
                           oc (if (and obj (:cls f) (not (:static f)) (not= :ctor (:kind f)))
                                (cond (and (:c (:ty obj)) (not (:cq f))) nil
                                      ;; a ref-qualified one ([over.match.funcs]/5): && takes an rvalue object, & (not const) an lvalue
                                      (and (= "&&" (:refq f)) (= :lv (:cat obj))) nil
                                      (and (= "&" (:refq f)) (not (:cq f)) (not= :lv (:cat obj))) nil
                                      ;; (cpp-rt-own4, the code generator: a const&& one for a non-const rvalue is worse than a && one,
                                      ;; [over.ics.rank]/3.2.6, the more cv-qualified reference, and better than a const& one, /3.2.3:
                                      ;; `*opt` of a prvalue std::optional had been ambiguous among its operator*s)
                                      (and (= "&&" (:refq f)) (:cq f) (not (:c (:ty obj))) (not (checking?))) {:rank 0 :sub 0}
                                      (and (= "&&" (:refq f))) {:rank 0 :sub -1}
                                      (and (:cq f) (not (:c (:ty obj)))) (cond-> {:rank 0 :sub 1} (and (checking?) (nil? (:refq f))) (assoc :noref true))
                                      :else (cond-> {:rank 0 :sub 0} (and (checking?) (nil? (:refq f))) (assoc :noref true)))
                                {:rank 0 :sub 0})
                           ;; (cpp-rt-own: an object of a class derived from the member's binds the implicit object parameter by a
                           ;; derived-to-base Conversion, [over.match.funcs]/5 with [over.best.ics]/6: complex_io.cc's `__s << '('` of
                           ;; a basic_ostringstream, basic_ostream's member operator<<(int) by promotion against the non-member
                           ;; operator<<(basic_ostream<char, _Traits>&, char) by that conversion and an exact match, had been 17 viable
                           ;; and ambiguous with the member taken for an exact match)
                           ;; (queue 510's rule, [over.match.funcs.general]/4: a member a using-declaration of class U nominates is U's
                           ;; member for its implicit object parameter, no conversion from an object of U: cpp1z/using1.C's B().f(1)
                           ;; between B::f(short) and A::f(short, int = 0) by `using A::f;` ambiguous, as clang; the checker's since
                           ;; mac/510-cpp-dg-own14 eb1ac403f, the code generator's too since cpp-rt-own3, DECISION 510-1 (a))
                           ucls (when (and oc obj (:cls f) (not (:static f)) (not= :ctor (:kind f)))
                                  (when-let [oid (class-id (:ty obj))]
                                    (when (and (not= oid (:cls f)) (abi/derived-from? oid (:cls f)))
                                      (some (fn [[_ e]] (when (and (= :fn (:e e)) (= cid (:id e))) (:ucls e))) (class-lookup oid (:name f))))))
                           _ (when (and ucls (System/getenv "CPP_UCLS_TRACE")) (binding [*out* *err*] (println "ucls" (:name f) (:name (abi/cls ucls)) (:name (abi/cls (:cls f))))))
                           oc (let [oid (when (and oc obj (:cls f) (not (:static f)) (not= :ctor (:kind f))) (class-id (:ty obj)))
                                    mc (or ucls (:cls f))]
                                (if (and oid (not= oid mc) (abi/derived-from? oid mc))
                                  (assoc oc :rank 2 :d2b [oid mc])
                                  oc))]
                     :when (and oc (every? some? convs))]
                 ;; (a member operator's object is the first operand, a non-member's first operand its first argument:
                 ;; `prefix` false)
                 [cid (if prefix (cons oc convs) convs)])
        ;; (cpp-extfloat, the checker: a floating conversion to a lesser or unordered conversion rank between types not both
        ;; standard is no standard conversion ([conv.double]/1, P1467R9), ics's :fp-bad: g++ 15.2 takes such a candidate only when
        ;; no other is viable and it is the only one so (with its pedwarn at the conversion), two or more "no matching function"
        ;; (by hand; cpp23/ext-floating3.C's bar(f128x))
        viable (if (and (checking?) (some (fn [[_ convs]] (some :fp-bad convs)) viable))
                 (let [bad? (fn [[_ convs]] (some :fp-bad convs))
                       good (remove bad? viable)]
                   (cond (seq good) good
                         (= 1 (count viable)) viable
                         :else []))
                 viable)
        tiebreak (or (:tiebreak @hooks) (constantly false))
        better (fn [[fa a] [fb b]] (and (every? true? (map #(not (better-ics? %2 %1)) a b))
                                        (or (some true? (map better-ics? a b)) (tiebreak fa fb n0))))
        best (filter (fn [x] (every? #(or (identical? % x) (better x %)) viable)) viable)]
    (cond
      (= 1 (count best)) (let [b (ffirst best) f (fnd b)
                               ;; (queue 497, the checker: GNU's unavailable attribute on the function chosen, GCC's "is
                               ;; unavailable", when chosen as surely as the CX12 rule below trusts a choice)
                               _ (when (and (checking?) (:unavailable f)
                                            (or (= 1 (count viable)) (every? #(zero? (long (:rank %))) (second (first best)))))
                                   (fail :unavailable "'" (:name f) "' is unavailable"))
                               ;; (queue 518, the checker: an argument's ambiguous conversion sequence, ics's :amb, used by the
                               ;; function chosen, [over.best.ics]/10: GCC's "conversion from 'long int' to 'A' is ambiguous";
                               ;; trusted as the CX12 rule below trusts a choice, the only viable function)
                               _ (when (and (checking?) (= 1 (count viable)) (some :amb (second (first best))))
                                   (fail :overload "ambiguous call (an ambiguous user-defined conversion of an argument of " (:name f) ")"))]
                           ;; CX12 (the checker): the best viable function deleted ([dcl.fct.def.delete]/2; clang's
                           ;; err_ovl_deleted_call, err_ovl_deleted_special_init), when it was the only viable one: the
                           ;; slice's ranking is not trusted to have chosen it over another)
                           ;; (queue 460: or when each of its conversions is exact, [over.ics.scs]/3's Exact Match rank, which
                           ;; no other candidate's betters: the others lost by a worse conversion or by [over.match.best]/2's
                           ;; tie-breakers)
                           (when (and (checking?) (:deleted-sure f)
                                      (or (= 1 (count viable)) (every? #(zero? (long (:rank %))) (second (first best)))))
                             (cx-deleted-implicit! f)
                             (cx-cmp-explain! (:id f))
                             (fail :overload "call to a deleted function " (:name f) (if (:implicit f) " (implicitly deleted)" "")))
                           ;; (queue 497, the checker: [class.compare.default]/2, a defaulted == of a class with a member of
                           ;; reference type or with variant members (a union, an anonymous union member) is defined as
                           ;; deleted; chosen as the CX12 rule above trusts a choice)
                           (when (and (checking?) (:defaulted f) (= "==" (:op f))
                                      (or (= 1 (count viable)) (every? #(zero? (long (:rank %))) (second (first best)))))
                             (when-let [c (some-> (or (:cls f) (class-id (abi/non-ref (first (:ps (:ty f)))))) abi/cls)]
                               (when (or (:union c)
                                         (some #(abi/ref? (:ty %)) (:fields c))
                                         (some #(and (:anon %) (:union (abi/cls-of (:ty %)))) (:fields c)))
                                 (fail :overload "call to a deleted function " (:name f) " (implicitly deleted)"))))
                           ;; (queue 510, the checker: a defaulted == or <=> not yet defined, defined now (as the declarations'
                           ;; entries would later), so that one defined as deleted (defaulted-comparison!: a flexible array
                           ;; member, [class.spaceship]/2's subobject of no comparison category type) is the error of its use;
                           ;; a definition that refuses is left to its entry)
                           (when (and (checking?) (:defaulted f) (#{"==" "<=>"} (:op f)) (not (:params f)) (not (:deleted f)) (not (:analyzed f))
                                      (or (= 1 (count viable)) (every? #(zero? (long (:rank %))) (second (first best)))))
                             (upd-fn! b assoc :analyzed true)
                             (try (analyze-implicit! b)
                                  (catch arbace.lang.ExceptionInfo _ (upd-fn! b dissoc :analyzed)))
                             (when (and (:deleted (fnd b)) (:deleted-sure (fnd b)))
                               (cx-cmp-explain! b)
                               (fail :overload "call to a deleted function " (:name f) " (implicitly deleted)")))
                           b)
      (empty? viable)
      (let [{:keys [sure-drops unsure-drops explain]} (when (checking?) *drops*)]
        ;; (CX12, the checker: the templates whose deduction failed by the algorithm alone count as candidates; one that may
        ;; have failed by the slice keeps the call from being diagnosed)
        (cond
          (and unsure-drops (pos? (long unsure-drops)))
          (fail :overload "no viable function (a template's deduction unsure) among " (count (distinct cands)) " for " n0 " arguments")
          ;; (CP290 (a): a generic lambda's closure's conversion function templates to pointers to function; since CP301 (a)
          ;; made by glam-conv! for a captureless one (a capturing one has none), but for a parameter pack (auto...), whose
          ;; deduction from a pointer to function the slice does not model: a candidate it may have made viable is not known
          ;; not to be)
          (and (checking?) (some (fn [[_ args]] (some #(when-let [i (class-id (:ty %))]
                                                         (when-let [{:keys [tid]} (:glam-conv (abi/cls i))]
                                                           (some (fn [P] (= :pack-exp (:k P)))
                                                                 (:ps ((requiring-resolve 'arbace.cpp.template/sym-sig) ((requiring-resolve 'arbace.cpp.template/tmpl) tid))))))
                                                      args))
                                 cs))
          (fail :overload "no viable function (a generic lambda's conversion not modeled) among " (count (distinct cands)) " for " n0 " arguments")
          ;; (cpp-tpl2, the checker: the candidates' substitution failures, call-candidates' :explain, reported with the call's
          ;; error, each at its construct, as GCC's explanations; arbace.repr.cpp.diag's handler)
          (seq explain)
          (throw (ex-info (str "codegen: no viable function among " (+ (count (distinct cands)) (long (or sure-drops 0))) " for " n0 " arguments")
                          {:codegen/refused :overload :cx/explain (vec (distinct explain))}))
          :else
          (fail :overload "no viable function among " (+ (count (distinct cands)) (long (or sure-drops 0))) " for " n0 " arguments: " (pr-str (map :ty (second (first cs)))))))
      :else (fail :overload "ambiguous call (" (count viable) " viable)" (when (System/getenv "CPP_HDR_TRACE") (str ": " (pr-str (map (fn [[f]] [(:name (fnd f)) (:ps (:ty (fnd f))) (loc-of (get-in (:node (fnd f)) [:range :begin]))]) viable))))))))

;; ---------------------------------------------------------------------------------------------
;; Initialization ([dcl.init]): an initializer of an object of type T, written for codegen as
;;  {:i :none} default-initialization of a trivial type   {:i :zero} zero-initialization
;;  {:i :expr :e prvalue}  a scalar's value, or a class prvalue constructed in place
;;  {:i :ctor :fn id :args [...]}  a constructor call   {:i :copy :e glvalue}  a trivial copy
;;  {:i :list :items [init ...] :fill init}  an array's or an aggregate's elements (bases first)
;;  {:i :bind :e glvalue}  a reference bound to an object   {:i :bind-temp :init init :ty T}  to a temporary

(declare init-for args-for default-ctor-init method-call materialize ctor-init)
(declare cx-movable-var cx-implicit-move-init)

(defn user-conv
  "The class object `e` converted to the non-class type `t` by a conversion function: the call's value."
  [ctx e t explicit?]
  (let [cid (class-id (:ty e))
        ;; (queue 584: the checker's position, which the conversion function templates' specializations made below move)
        at0 (some-> *at* deref)
        ;; (queue 518, the checker: an ambiguous choice among the conversion functions, cx-conv-ambiguous?)
        _ (when (cx-conv-ambiguous? cid t explicit? (:c (:ty e)))
            (fail :overload "ambiguous call (the conversion of '" (:name (abi/cls cid)) "' to " (cx-tyname t) " is ambiguous)"))
        fid (or (conv-for cid t explicit? (:c (:ty e)))
                ;; (CX12, the checker: copy-initialization from a class none of whose conversion functions is non-explicit,
                ;; [over.match.conv]/1.1, [dcl.init]/16.7: no candidate at all, clang's err_typecheck_convert_incompatible's
                ;; "no viable conversion", gcc's "cannot convert")
                ;; (queue 518: and a capturing closure's, which has none, [expr.prim.lambda.closure]/9: lambda-conv8.C)
                (when (and (checking?) (or (not (:lambda (abi/cls cid))) (:cx-capturing (abi/cls cid)))
                           ;; (in direct-initialization: no explicit one yielding the type either, [over.match.conv]/1.1)
                           (not-any? #(not (:explicit (fnd %))) (conv-fns cid))
                           (or (not explicit?) (not-any? #(= (abi/unq (abi/non-ref (:ret (:ty (fnd %))))) (abi/unq t)) (conv-fns cid)))
                           ;; (no conversion function template in the class or its bases: those are not in conv-fns)
                           (not ((fn tm? [id] (let [c (abi/cls id)]
                                                (or (some (fn [[k es]] (and (str/starts-with? (str k) "operator ") (some #(= :tmpl (:e %)) es)))
                                                          (.entrySet ^java.util.HashMap (:names (:scope c))))
                                                    (some #(tm? (:cls %)) (:bases c)))))
                                 cid)))
                  (fail :noconv "no viable conversion from '" (:name (abi/cls cid)) "' to " (pr-str (select-keys t [:k :n]))))
                ;; (queue 584, the checker: in copy-initialization, conversion functions all explicit, surely, and each
                ;; conversion function template's specialization for the target made and explicit, its explicit-specifier
                ;; evaluated with the deduced and default arguments, [dcl.fct.spec]/3 with [over.match.copy]/1.2 and
                ;; [temp.deduct.conv]: no candidate, GCC's "cannot convert"; cpp2a/explicit8.C's explicit(N) operator T())
                (when (and (checking?) (not explicit?) (not (:lambda (abi/cls cid))) (seq (conv-tmpls cid))
                           (every? #(let [f (fnd %)] (and (:explicit f) (:explicit-sure f))) (conv-fns cid)))
                  (let [specs (distinct (conv-specs cid t))]
                    (when (and (= (count specs) (count (conv-tmpls cid)))
                               (every? #(let [f (fnd %)] (and (:explicit f) (:explicit-sure f))) specs))
                      (when-let [a *at*] (reset! a at0))
                      (fail :noconv "no viable conversion from '" (:name (abi/cls cid)) "' to " (pr-str (select-keys t [:k :n])) " (explicit conversion function templates)"))))
                (fail :conversion "no conversion function of " (:name (abi/cls cid)) " to " (pr-str t)))
        obj (if (= :pr (:cat e)) (materialize e) e)]
    (rv (method-call ctx fid obj [] true))))

(defn ctor-candidates
  "The constructors of class `id` overload resolution considers: the deleted ones too for the checker ([over.match.funcs]:
  a deleted function is a candidate, and choosing it is the error, [dcl.fct.def.delete]/2), those it is sure of."
  [id]
  (if (checking?)
    (remove #(let [f (fnd %)] (and (:deleted f) (or (:cx-move f) (not (:deleted-sure f))))) (:ctors (abi/cls id)))
    (remove #(:deleted (fnd %)) (:ctors (abi/cls id)))))

(def ^:dynamic *cx-default-active* #{})

(defn- call-args
  "The parameters' initializers for a call of `f` with the typed arguments `args` (default arguments analyzed in the
  function's scope)."
  [f args ctx]
  (let [ps (:ps (:ty f))
        ;; (cpp-tzdb, the code generator: an immediate invocation's argument naming a constexpr pointer to a string literal is
        ;; that literal's address, as the call is a constant clang never runs -- <bits/chrono_io.h>'s `std::format(_S_empty_spec,
        ;; ...)`, whose consteval basic_format_string(const _Tp&) had read __formatter_chrono's _S_empty_spec at run time, the
        ;; variable then written and guarded)
        args (if (and (:consteval f) (not (checking?)))
               (mapv (fn [a] (or (when (and (= :var (:op a)) (abi/ptr? (abi/unq (:ty a))) (:cg-constexpr (var* (:id a))))
                                   (ptr-literal-of (:id a)))
                                 a))
                     args)
               args)]
    (vec (concat
          (map-indexed (fn [i a] (if (< i (count ps))
                                   ;; (queue 492, the checker: a braced argument copy-list-initializes its parameter, cx-explicit-list!)
                                   (do (desig-order! a (nth ps i))
                                       (binding [*cx-copy-list* (or *cx-copy-list* (and (checking?) (= :init-list (:op a))))] (init-for (nth ps i) a ctx :copy)))
                                   (let [a (rv a)]
                                                                                           ;; [expr.call]/12: a class argument through the ellipsis is
                                                                                           ;; conditionally-supported; clang passes a trivially copyable and
                                                                                           ;; destructible one by value as a parameter of its type (the psABI's
                                                                                           ;; classes, the registers counted on), refuses the others
                                                                                           ;; (err_cannot_pass_non_trivial_c_object_to_vararg)
                                                                                           ;; (cpp-decl2, the checker: a volatile class object's copy for the
                                                                                           ;; ellipsis binds no implicit copy constructor's const A&
                                                                                           ;; ([class.copy.ctor]/7), GCC's "binding reference of type 'const A&'
                                                                                           ;; to 'volatile A' discards qualifiers": overload/ellipsis3.C, whose
                                                                                           ;; A(...) had taken it again without end)
                                                                                           (when (and (checking?) (abi/class? (abi/unq (:ty a))) (:v (:ty a)))
                                                                                             (fail :varargs "binding a const reference to a volatile object passed through '...' discards qualifiers"))
                                                                                           (when (abi/class? (abi/unq (:ty a)))
                                                                                             (let [id (:id (abi/unq (:ty a)))]
                                                                                               (when-not (and (trivial-copy? id) (trivial-dtor? id)) (fail :varargs "a non-trivial class through ..."))))
                                                                                           (if (abi/class? (abi/unq (:ty a)))
                                                                                             (assoc (init-for (abi/unq (:ty a)) a ctx :copy) :va-ty (abi/unq (:ty a)))
                                                                                           (let [t (abi/unq (:ty a))]
                                                                                             {:i :expr :e (cond (= :float (abi/bn t)) (convert-scalar a abi/double* false)
                                                                                                                (and (abi/integral? t) (not= t (promote-type t))) (convert-scalar a (promote-type t) false)
                                                                                                                :else a)})))))
                       args)
          (for [i (range (count args) (count ps))]
            (let [d (nth (:defaults f) i nil)]
              (when-not d (fail :call "missing argument"))
              ;; (cpp-tzdb: a template's specialization's in the scope binding its parameters, its :def-scope, whose parent is
              ;; the class's: filesystem::path's `string(const _Allocator& __a = _Allocator())`, defined outside the class)
              ;; (cpp-decl2: a default argument `{...}` for a reference to an abstract class, its temporary at the call)
              (when (and (checking?) (map? d) (= "InitListExpr" (:kind d)) (abi/ref? (nth ps i)))
                (when-let [at (some-> *at* deref)] (cx-abstract! (abi/non-ref (nth ps i)) at "a temporary")))
              ;; (cpp-rind, the checker: [dcl.fct.default]/9's default argument evaluated at each call, one that calls the
              ;; function itself with that argument defaulted again recurses without end: GCC's "recursive evaluation of default
              ;; argument for 'int foo(T, int)'", overload/defarg1.C, whose analysis had overflowed the stack)
              (let [k [(:name f) (:ty f) i]]
                (when (and (checking?) (contains? *cx-default-active* k))
                  (throw (ex-info (str "codegen: recursive evaluation of default argument for '" (:name f) "'")
                                  (cond-> {:codegen/refused :default-arg} (and (map? d) (:range d)) (assoc :cx/node d)))))
                (binding [*cx-default-active* (if (checking?) (conj *cx-default-active* k) *cx-default-active*)]
                  ;; (cpp-ce3: a default argument's immediate invocations not evaluated here, cx-immediate-eval!)
                  ;; (cpp-p2564: in a consteval unit, a default argument of the main file's evaluated in the caller's context,
                  ;; [expr.const]/16-18 with P2564R3: an escalating caller escalates, another's error at the call; its positions the
                  ;; call's, GCC's place)
                  (let [own (and (cx-p2564?) (map? d) (not (header-node? d)) (or (nil? (:fn-id ctx)) (cx-main-fn? (fnd (:fn-id ctx)))))
                        at (when own (or *cx-at-override* (some-> *at* deref :range)))
                        call-at (some-> *at* deref)]
                    ((fn [g] (if-not (and (checking?) *at* call-at *on-refusal* (map? d) (not (header-node? d)) (not (:tinst f))
                                          (not (some-> (:cls f) abi/cls :targs seq)))
                               (g)
                               ;; (cpp-def2, the checker: a default argument of a function that is no template's whose conversion
                               ;; to the parameter's type fails, [dcl.fct.default]/1 with [dcl.init]: GCC's error at the default
                               ;; argument, the analysis's place for it, and again at the call that uses it, there: overload/defarg9.C's
                               ;; `C c;` with `C(A& a = B())`)
                               (try (g)
                                    (catch arbace.lang.ExceptionInfo x
                                      (if (and (:codegen/refused (ex-data x)) (nil? (:cx/node (ex-data x)))
                                               (not= (get-in (some-> *at* deref) [:range :begin :offset]) (get-in call-at [:range :begin :offset])))
                                        (do (*on-refusal* x (some-> *at* deref))
                                            (reset! *at* call-at)
                                            (throw x))
                                        (throw x))))))
                     #(init-for (nth ps i) (binding [*cutoff* Long/MAX_VALUE *cx-no-imm* (if own *cx-no-imm* true) *cx-at-override* (if own at *cx-at-override*)]
                                           ;; (cpp-def, the checker: an error of the default argument's own expression is GCC's at the
                                           ;; default argument, in the declaration, not at the call that uses it ([dcl.fct.default]/5:
                                           ;; its names bound and its semantic constraints checked where it appears); its conversion to
                                           ;; the parameter's type still the call's: parse/crash40.C)
                                           (try (analyze (assoc ctx :scope (if (and (:tinst f) (:def-scope f) (not (checking?))) (:def-scope f) (:scope f))) d)
                                                (catch arbace.lang.ExceptionInfo x
                                                  (let [xd (ex-data x)]
                                                    (if (and (checking?) (:codegen/refused xd) (nil? (:cx/node xd)) (map? d) (not (header-node? d))
                                                             (get-in d [:range :begin :offset]))
                                                      (throw (ex-info (ex-message x) (assoc xd :cx/node d)))
                                                      (throw x))))))
                              ctx :copy)))))))))))

(defn init-list-elem
  "E when the type `t` (cv-qualified, or a reference to it) is std::initializer_list<E>, else nil."
  [t]
  (let [u (abi/unq (abi/non-ref t))]
    (when (abi/class? u)
      (let [c (abi/cls (:id u))]
        (when (and (= "initializer_list" (:name c)) (= [[:ns "std"]] (:path c)) (seq (:targs c)))
          (abi/unq (first (:targs c))))))))

(defn- std-init-list
  "The prvalue std::initializer_list<E> a braced list `l` initializes ([dcl.init.list]/5-6, clang's
  CXXStdInitializerListExpr): a backing array const E[N] whose elements are copy-initialized from the list's, the
  object its first element's address and N; nil when an element does not convert to E."
  [t l ctx]
  (let [e (init-list-elem t) items (:items l)]
    ;; (cpp-sweep, the checker: std::initializer_list<E> of a reference E, its backing array of references ill-formed
    ;; ([dcl.array]/1; the class's pointer members to E too): GCC's "could not convert '{0}' ... to 'std::initializer_list<int&&>'",
    ;; cpp0x/initlist-array4.C)
    ;; (cpp-singles: and GCC's error in <initializer_list> itself, where the instantiation forms the pointer to the reference
    ;; type: an error outside the main file, :cx/header-error, arbace.repr.cpp.diag/sema-errors's line 0)
    (when (and (checking?) e (abi/ref? e))
      (throw (ex-info "codegen: no viable conversion from a braced list to std::initializer_list of a reference type"
                      {:codegen/refused :noconv :cx/header-error "forming pointer to reference type"})))
    (when (every? #(ics % e) items)
      {:op :std-init-list :elem e :n (count items) :items (mapv #(init-for e % ctx :copy) items)
       :ty (abi/unq (abi/non-ref t)) :cat :pr})))

;; queue 412 (round 7): [dcl.init.list]/7, a narrowing conversion in a list-initialization (C++11 on). The implicit conversion
;; of a list's element to a scalar element, member, object or parameter of arithmetic type: from a floating type to an integer
;; type; from long double to double or float, or double to float, but a constant whose value is within the target's range;
;; from an integer or unscoped enumeration type to a floating type, but a constant the target represents exactly; from an
;; integer or unscoped enumeration type to an integer type that cannot represent all its values, but a constant that fits.
;; GCC's permerror for a constant, its pedwarn (an error under -pedantic-errors alone) for a non-constant; an unscoped
;; enumeration's non-constant value is not judged (GCC takes the enumeration's own range), nor a value the evaluator refuses,
;; nor the extended floating types. Checked once the initialization is chosen (a candidate's conversions are not: narrowing
;; does not take part in overload resolution, [over.ics.list]); a parenthesized aggregate initialization (P0960) is none.
(def ^:private narrow-names
  {:bool "bool" :char "char" :schar "signed char" :uchar "unsigned char" :char8 "char8_t" :short "short int"
   :ushort "short unsigned int" :char16 "char16_t" :int "int" :uint "unsigned int" :char32 "char32_t" :wchar "wchar_t"
   :long "long int" :ulong "long unsigned int" :llong "long long int" :ullong "long long unsigned int" :i128 "__int128"
   :u128 "__int128 unsigned" :float "float" :double "double" :ldouble "long double"})

(defn- narrow-type-name ^String [t]
  (if (abi/enum? t) (str (:name (abi/enm (:id t)))) (get narrow-names (abi/bn t) "?")))

(defn- narrow-int-range
  "[lo hi] of the integer type `t`'s values."
  [t]
  (if (= :bool (abi/bn t))
    [0 1]
    (let [n (* 8 (abi/size-of t))]
      (if (abi/signed? t)
        [(- (.shiftLeft java.math.BigInteger/ONE (dec n))) (dec (.shiftLeft java.math.BigInteger/ONE (dec n)))]
        [0 (dec (.shiftLeft java.math.BigInteger/ONE n))]))))

(def ^:private narrow-fp-rank {:float 1 :double 2 :ldouble 3})

(defn- narrowing-kind
  "How the conversion from `ft` to `tt` (unqualified) narrows: :always, :fp-range, :fp-exact, :fits, or nil (it does not)."
  [ft tt]
  (cond
    (= ft tt) nil
    (not (abi/arith? tt)) nil
    (and (abi/enum? ft) (:scoped (abi/enm (:id ft)))) nil
    ;; (cpp-extfloat: [dcl.init.list]/7.2 since P1467R9, a floating type to one whose conversion rank is neither greater than nor
    ;; equal to its, an extended type's too: :fp-ext, a constant whose value is finite and in the target's range excepted)
    (and (abi/floating? ft) (abi/floating? tt) (not (and (narrow-fp-rank (abi/bn ft)) (narrow-fp-rank (abi/bn tt)))))
    (let [c (abi/fp-rank-cmp tt ft)] (when (or (nil? c) (neg? (long c))) :fp-ext))
    (abi/floating? ft) (cond (not (narrow-fp-rank (abi/bn ft))) nil
                             (abi/integral? tt) :always
                             (not (narrow-fp-rank (abi/bn tt))) nil
                             (< (long (narrow-fp-rank (abi/bn tt))) (long (narrow-fp-rank (abi/bn ft)))) :fp-range)
    (abi/integral? ft) (cond (abi/floating? tt) (when (narrow-fp-rank (abi/bn tt)) :fp-exact)
                             (abi/integral? tt) (if (abi/enum? ft)
                                                  :fits
                                                  (let [[fl fh] (narrow-int-range ft) [tl th] (narrow-int-range tt)]
                                                    (when (or (< (compare fl tl) 0) (> (compare fh th) 0)) :fits))))))

(defn- narrow-int-value
  "The integer the evaluation's `v` of the type `ft` stands for (a 64-bit unsigned value held as a negative long, 2^64 more)."
  ^java.math.BigInteger [ft v]
  (let [b (biginteger v)]
    (if (and (neg? (.signum b)) (not (abi/signed? ft)) (= 8 (abi/size-of (abi/underlying ft))))
      (.add b (.shiftLeft java.math.BigInteger/ONE 64))
      b)))

(defn- narrows-value?
  "Whether the constant `v` of the type `ft` narrows in the conversion of kind `k` to `tt`."
  [k ft tt v]
  (case k
    :always true
    :fp-ext (let [d (double v)
                  mx (case (abi/fp-format-of tt) :half 65504.0 :bfloat 3.3895313892515355E38 :single (double Float/MAX_VALUE) Double/MAX_VALUE)]
              (and (not (Double/isNaN d)) (not (Double/isInfinite d)) (> (Math/abs d) mx)))
    :fp-range (let [d (double v)]
                (and (not (Double/isNaN d)) (not (Double/isInfinite d)) (= :float (abi/bn tt))
                     (> (Math/abs d) (double Float/MAX_VALUE))))
    :fp-exact (let [b (narrow-int-value ft v)]
                (case (abi/bn tt)
                  :float (not= 0 (compare (.toBigInteger (java.math.BigDecimal. (double (float (.doubleValue b))))) b))
                  :double (not= 0 (compare (.toBigInteger (java.math.BigDecimal. (.doubleValue b))) b))
                  (> (.bitLength b) 64)))
    :fits (let [b (narrow-int-value ft v) [lo hi] (narrow-int-range tt)]
            (or (< (compare b lo) 0) (> (compare b hi) 0)))))

(defn- narrow-value
  "The constant value of the typed expression `e`, :nonconst when it is no constant, :unknown when the evaluation refuses it."
  [e]
  (try (let [v (binding [*ce-manifest* true] (ce-eval e))] (if (number? v) v :unknown))
       (catch arbace.lang.ExceptionInfo x
         (let [d (ex-data x)]
           (cond (:cpp/timeout d) (throw x)
                 (:codegen/not-constant d) :nonconst
                 :else :unknown)))))

(def ^:dynamic *cx-requirement* "cpp-extfloat: a requires-expression's expression requirement being analyzed (the checker)" false)

(defn- narrow-check!
  "The initializer `init` (init-for's) of an object of type `t` from the list element `src`: a narrowing conversion refused
  (:narrowing, at the element). `init` returned."
  [init t src]
  (when (and *narrowing* (checking?) (>= (long *cxx-year*) 11) (map? init) (not= :init-list (:op src)))
    (case (:i init)
      :bind-temp (narrow-check! (:init init) (:ty init) src)
      :expr (let [x (:e init) tt (abi/unq (abi/non-ref t))]
              (when (and (= :cast (:op x)) (:e x) (abi/arith? tt))
                (let [e (:e x) ft (abi/unq (:ty e))]
                  (when-let [k (narrowing-kind ft tt)]
                    (let [v (narrow-value e)]
                      (when (cond (= v :unknown) false
                                  ;; (cpp-extfloat: in a requirement's expression the narrowing is the substitution's failure,
                                  ;; [expr.prim.req.simple]/1 with [dcl.init.list]/3: libstdc++'s C++23 complex<T>(const complex<U>&),
                                  ;; explicit(!requires(_Up __u) { value_type{__u}; }), cpp23/ext-floating12.C)
                                  (= v :nonconst) (and (or *pedantic-errors* *cx-requirement*) (not (abi/enum? ft)))
                                  :else (narrows-value? k ft tt v))
                        (throw (ex-info (str "codegen: narrowing conversion from '" (narrow-type-name ft) "' to '" (narrow-type-name tt) "'"
                                             (when (= v :nonconst) " (not a constant)"))
                                        (if-let [r (or (:cx-at src) (:cx-at e))]
                                          {:codegen/refused :narrowing :cx/node {:range r}}
                                          ;; (a literal has no position of its own: the last node analyzed, a macro's at its
                                          ;; expansion, `signed char a { __INT_MAX__ };`)
                                          (let [n (some-> *at* deref) b (get-in n [:range :begin])]
                                            (cond-> {:codegen/refused :narrowing}
                                              (:expansionLoc b) (assoc :cx/node {:range (assoc (:range n) :begin (:expansionLoc b))}))))))))))))
      nil))
  init)

(defn- narrow-list-check!
  "narrow-check! over a std::initializer_list's backing array `a` (std-init-list's) built from the list `l`."
  [a l]
  (when (= :std-init-list (:op a))
    (doseq [[init src] (map vector (:items a) (:items l))]
      (narrow-check! init (:elem a) src)
      ;; (cpp-decl2: an element of class type copy-initialized from an expression by a converting constructor, the
      ;; argument's conversion to its parameter, [dcl.init.list]/5: "If a narrowing conversion is required to initialize any
      ;; of the elements, the program is ill-formed"; GCC judges it for std::initializer_list's elements alone, not for an
      ;; aggregate's members (observed by hand, g++ 15.2): cpp0x/initlist36.C's B b2 {1.0} over B(initializer_list<A>), A(int))
      (when (and (map? init) (= :ctor (:i init)) (:fn init) (= 1 (count (:args init))))
        (when-let [p (first (:ps (:ty (fnd (:fn init)))))]
          (when (abi/arith? (abi/unq (abi/non-ref p)))
            (narrow-check! (first (:args init)) p src))))))
  a)

(defn- narrow-ctor-check!
  "narrow-check! over a constructor call's parameters (`r`, ctor-init's) initialized from the list's elements `items`."
  [r items]
  (when (and (= :ctor (:i r)) (:fn r) (vector? (:args r)))
    (let [ps (:ps (:ty (fnd (:fn r))))]
      (doseq [[init p src] (map vector (:args r) ps items)] (narrow-check! init p src))))
  r)

(defn- init-list-ctors
  "The initializer-list constructors of class `id` ([dcl.init.list]/2): a first parameter std::initializer_list<E> or a
  reference to one, every other with a default argument."
  [id]
  (filter #(let [f (fnd %) ps (:ps (:ty f))]
             (and (seq ps) (init-list-elem (first ps))
                  (<= (dec (count ps)) (count (filter some? (rest (:defaults f)))))))
          (ctor-candidates id)))

(declare aggr-subs)

;; The rest of CP313 (a): clang's SemaAccess.cpp (llvmorg-23.1.5) for the checker: EffectiveContext (the classes and the
;; function a use is in), GetFriendKind (by name: a friend the slice cannot match grants, so a miss is never a wrong error),
;; HasAccess with [class.protected]'s object rule, and the naming class's path to the member's class ([class.access.base]
;; /5: a member's access as a member of a derived class, through the bases' access specifiers, or through an accessible
;; base); a use the slice does not model -- a template's specialization, a closure's or a local class's member, a member
;; named through two paths -- is not judged.

(defn- cx-enclosing-classes
  "The class `cid` and the classes it is nested in ([class.access.nest]: a nested class is a member, with its enclosing
  classes' access), or nil for a closure or a local class (not judged)."
  [cid]
  (loop [c cid out #{}]
    (let [cl (abi/cls c)]
      (when (and cl (not (:lambda cl)))
        (let [out (conj out c)
              s (loop [s (:outer cl)] (if (and s (= :tparams (:kind s))) (recur (:parent s)) s))]
          (cond (or (nil? s) (= :ns (:kind s))) out
                (and (= :class (:kind s)) (:cls s)) (recur (:cls s) out)
                :else nil))))))

(defn- cx-tinst-context
  "Queue 502 (the checker; 499-3 (a)): EffectiveContext of the body of a function template's specialization `f`
  ([temp.inst]: its names are looked up and their access checked in the instantiation as in the template's definition,
  [class.access]/2 with [temp.res.general]): the specialization's class and its enclosing classes, the function itself
  for the friends that name it; nil (not judged) for a closure's or a local class's member, or a specialization a
  deduction guide or an invented function stands for."
  [f]
  (when (and (not (:guide f)) (not (vector? (:tid (:tinst f)))))
    (if-let [cid (:cls f)]
      (when-let [rs (cx-enclosing-classes cid)] {:records rs :fn f})
      {:records #{} :fn f})))

(defn cx-context
  "EffectiveContext of the analysis context `ctx`: {:records :fn}, the classes the use is a member of (the function's
  class, or the class a member's initializer is analyzed in, with their enclosing classes) and the function; nil when
  the slice does not judge it."
  [ctx]
  (let [f (some-> (:fn-id ctx) fnd)]
    (cond
      ;; (queue 499: a lambda's body is in the context of the lambda-expression, [expr.prim.lambda.closure]/12 with
      ;; [class.access]/2's members and friends: the enclosing analysis's context, a generic lambda's specialization not
      ;; judged)
      (:lambda ctx) (when-let [e (:encl (:lambda ctx))] (cx-context e))
      (and f (:tinst f)) (cx-tinst-context f)
      f (if-let [cid (:cls f)] (when-let [rs (cx-enclosing-classes cid)] {:records rs :fn f}) {:records #{} :fn f})
      :else (if-let [cid (or (:cx-member-of ctx) (:cls (:scope ctx)))] (when-let [rs (cx-enclosing-classes cid)] {:records rs}) {:records #{}}))))

(defn- cx-ns-by-path
  "Queue 502: the namespace scope of the path `p` ([:ns NAME] and [:anon] steps from the global scope), or nil."
  [p]
  (reduce (fn [s st] (if-let [m (and s (:names s))]
                       (:scope (first (filter #(= :ns (:e %)) (.get ^java.util.HashMap m (str " ns " (if (= [:anon] st) "" (second st)))))))
                       (reduced nil)))
          *root* p))

(defn- cx-friend-ns-miss?
  "Queue 502 (the checker): whether the class `r`, named as the friend classes of `cl` are by name, is surely none of
  them: every friend of that name an unqualified elaborated-type-specifier (cx-friend-class-ns! recorded its innermost
  enclosing namespace's path), `r` a member of a namespace, and for each such scope neither that namespace (or one
  nested in it, an inline namespace's member found there) nor a class or template of that name the namespace's own names
  hold being `r`'s."
  [cl r]
  (let [nm (:name (abi/cls r))
        ss (get (:friend-class-nss cl) nm)
        rc (abi/cls r)
        rs (loop [s (:outer rc)] (if (and s (= :tparams (:kind s))) (recur (:parent s)) s))]
    (boolean
      (and (seq ss) (not-any? #{:any} ss) rs (= :ns (:kind rs))
           (let [rp (vec (:path rs))]
             (not-any? (fn [sp]
                         (or (= sp (vec (take (count sp) rp)))
                             (let [s (cx-ns-by-path sp)]
                               (or (nil? s)
                                   (some (fn [e] (or (and (= :type (:e e)) (= r (class-id (:ty e))))
                                                     (and (= :tmpl (:e e)) (:tmpl rc) (= (:id e) (:tmpl rc)))))
                                         (.get ^java.util.HashMap (:names s) nm))))))
                       ss))))))

(defn- cx-friend-fn-miss?
  "Queue 505 (the checker; 502-1 (a)): whether the function `f`, of the name of a friend function of the class `cl`, is
  surely none of the functions its friend declarations name, by the identities cx-friend-fn-ident! recorded under that
  name (none :any): an unqualified non-template friend, a non-template non-member function of the innermost enclosing
  namespace with the declaration's parameter types ([namespace.memdef]/3; template/friend79.C's friend of A<int> is not
  A<void>'s); an unqualified friend function template, the specializations of a template of that namespace
  ([temp.friend]/1.3); a friend template-id, the specialization of a template its name finds with those parameter types
  ([temp.friend]/1.2; tc1/dr166.C's N::f<int>, not M::f<int> nor N::f<long>)."
  [cl f]
  (let [es (get (:friend-fn-ids cl) (:name f))]
    (boolean
      (and (seq es) (not-any? #{:any} es)
           (let [p (vec (:path f)) ti (:tinst f) ps (some->> (:ty f) :ps (mapv abi/unq))]
             (not-any? (fn [e]
                         (case (:k e)
                           :plain (and (nil? (:cls f)) (nil? ti) (= (:ns e) p) (= (:ps e) ps))
                           :tmpl (and (nil? (:cls f)) (some? ti) (= (:ns e) p))
                           :spec (and (some? ti) (contains? (:tids e) (:tid ti)) (= (:ps e) ps))
                           true))
                       es))))))

(defn- cx-friend-of?
  "GetFriendKind: whether class `c` may befriend the context `cx`: a friend function of its function's name (queue 505:
  not one whose identity the friend declarations surely do not name, cx-friend-fn-miss?), a friend
  class among its classes by name (queue 502: not one an unqualified friend declaration surely does not name,
  cx-friend-ns-miss?), or a friend the slice did not classify."
  [c cx]
  (let [cl (abi/cls c)]
    (boolean (or (:friend-unknown cl)
                 (and (:fn cx) (contains? (:friend-fns cl) (:name (:fn cx))) (not (cx-friend-fn-miss? cl (:fn cx))))
                 (and (:friend-classes cl)
                      (or (contains? (:friend-class-names cl) "")
                          (some #(and (contains? (:friend-class-names cl) (:name (abi/cls %))) (not (cx-friend-ns-miss? cl %))) (:records cx))))))))

(defn- cx-member-ok?
  "HasAccess ([class.access]/2, [class.protected]): a member of class `nc` with access `a` (as a member of nc) named in
  the context `cx`; `obj` the object expression's class for a non-static member, else nil: a protected member through a
  class D derived from nc that the context is a member or friend of needs an object of D or of a class derived from it."
  [cx nc a obj]
  (or (= :public a)
      (contains? (:records cx) nc)
      (cx-friend-of? nc cx)
      (and (= :protected a)
           (boolean (some (fn [d] (and (not= d nc) (abi/derived-from? d nc)
                                       (or (nil? obj) (= obj d) (abi/derived-from? obj d))))
                          (concat (:records cx)
                                  (keep (fn [[id c]] (when (and (:has-friends c) (cx-friend-of? id cx)) id)) @abi/*classes*)))))))

(defn- cx-paths [from to]
  (if (= from to) [[]] (mapcat (fn [b] (map #(cons [from b] %) (cx-paths (:cls b) to))) (:bases (abi/cls from)))))

(declare cx-access-ok-path?)

(defn cx-access-ok?
  "Whether a member of class `dc` with access `a` named through the class `nc` (dc or a class derived from it) is
  accessible in the context `cx` ([class.access.base]/5): true, false, or nil when the slice does not know (two paths)."
  [cx dc a nc obj]
  (if (= nc dc)
    (cx-member-ok? cx dc a obj)
    (let [ps (cx-paths nc dc)]
      (if (< 1 (count ps) 9)
        ;; (queue 499: several paths, [class.access.base]/6: the path that gives most access; true when one path does,
        ;; false when every path is sure to give none, else not known: lookup/scoped12.C's d.a through B and C)
        (let [vs (mapv #(cx-access-ok-path? cx dc a % obj) ps)]
          (cond (some true? vs) true (every? false? vs) false :else nil))
      (when (= 1 (count ps))
        (cx-access-ok-path? cx dc a (first ps) obj))))))

(defn- cx-access-ok-path?
  "cx-access-ok?'s judgment along one path `p` of base steps from the naming class to `dc` ([class.access.base]/5)."
  [cx dc a p obj]
        (let [steps (vec p)
              cs (conj (mapv first steps) dc)
              sp (mapv #(:access (second %)) steps)
              rank {:public 0 :protected 1 :private 2}
              ;; the access of a member declared in cs[j] with access a0 as a member of cs[i] (:none: inaccessible there)
              acc (fn acc [i j a0] (if (= i j) a0
                                     (let [x (acc (inc i) j a0)]
                                       (if (#{:none :private} x) :none (if (> (long (rank (sp i))) (long (rank x))) (sp i) x)))))
              direct (fn [i j a0] (let [ai (acc i j a0)] (and (not= :none ai) (cx-member-ok? cx (cs i) ai obj))))
              ;; (cs[k] an accessible base of cs[i]: an invented public member of it accessible as a member of cs[i])
              base-ok? (fn base-ok? [i k]
                         (or (direct i k :public)
                             (boolean (some (fn [l] (and (base-ok? l k) (base-ok? i l))) (range (inc i) k)))))
              ok? (fn ok? [i j a0]
                    (or (direct i j a0)
                        (boolean (some (fn [k] (and (ok? k j a0) (base-ok? i k))) (range (inc i) (inc j))))))]
          (ok? 0 (dec (count cs)) a)))

(defn- cx-friend-class-ns!
  "Queue 502 (the checker): a friend class declaration `k` of class `id` (its scope `cs`; `fd` nil): an unqualified
  elaborated-type-specifier (`friend struct B;`, `template<class U> friend struct B;`) names the class B of the innermost
  enclosing namespace, declared there when not yet ([namespace.memdef]/3, [dcl.type.elab]/4: no scope outside that
  namespace is considered; template/pr59930-1.C's N::B, not ::B): that namespace's path recorded under the name in
  :friend-class-nss; any other friend class (qualified, a simple-type-specifier `friend B;`, a local befriending class)
  records :any, which cx-friend-ns-miss? never judges."
  [cs id k fd]
  (when (and (checking?) (nil? fd))
    (let [ct (some (fn [x] (when (= "ClassTemplateDecl" (:kind x)) x)) (:inner k))
          qt (str (get-in k [:type :qualType]))
          nm (or (:name ct) (some-> qt (str/replace #"<.*$" "") (str/replace #"^\s*(?:class|struct|union)\s+" "") (str/split #"::") last str/trim))
          elab? (or ct (re-find #"^\s*(?:class|struct|union)\s+[A-Za-z_][A-Za-z_0-9]*\s*(?:<.*>)?\s*$" qt))
          ns (loop [s cs] (cond (nil? s) nil (= :ns (:kind s)) s (#{:class :tparams} (:kind s)) (recur (:parent s)) :else nil))]
      (when (and nm (seq nm))
        (abi/update-cls! id update-in [:friend-class-nss nm] (fnil conj []) (if (and elab? ns (not (str/includes? qt "::"))) (vec (:path ns)) :any))))))

(defn- cx-dependent-type?
  "Queue 505: whether the type `t` names a template parameter or a dependent or undeduced type anywhere."
  [t]
  (boolean (some #(and (map? %) (#{:tparam :tdep :dep :auto} (:k %))) (tree-seq coll? seq t))))

(defn- cx-friend-fn-ident!
  "Queue 505 (the checker; 502-1 (a)): the identity of the friend function declaration `k` (its function `fd`) of class
  `id` (its scope `cs`), recorded under the function's name in :friend-fn-ids for cx-friend-fn-miss?: {:k :plain :ns
  :ps} an unqualified non-template friend, {:k :tmpl :ns} an unqualified friend function template, {:k :spec :tids :ps}
  a template-id (the templates its name finds from the class); :any (never judged) for a qualified friend, a member, a
  class of the headers, a local class's friend, parameter types not known or dependent, or a plain friend whose name
  finds a function template (`friend void t<>(int);`, whose `<>` the tree does not keep)."
  [cs id k fd]
  (when (and (checking?) fd (string? (:name fd)) (seq (:name fd)))
    (let [nm (:name fd)
          ns (loop [s cs] (cond (nil? s) nil (= :ns (:kind s)) s (#{:class :tparams} (:kind s)) (recur (:parent s)) :else nil))
          ps (fn [] (try (let [t (resolve-type cs (get-in fd [:type :qualType]))]
                           (when (and (abi/fn? t) (not (cx-dependent-type? t))) (mapv abi/unq (:ps t))))
                         (catch arbace.lang.ExceptionInfo _ nil)))
          qual? (or (and (string? (:_qual fd)) (seq (str/trim (:_qual fd))))
                    (some #(and (string? (:_qual %)) (seq (str/trim (:_qual %)))) (:inner fd)))
          ent (cond
                (or (nil? ns) qual? (:header (abi/cls id)) (header-node? k)) :any
                (= "FunctionTemplateDecl" (:kind fd)) {:k :tmpl :ns (vec (:path ns))}
                (not= "FunctionDecl" (:kind fd)) :any
                (some #(= "TemplateArgument" (:kind %)) (:inner fd))
                (let [tids (try (set (keep #(when (= :tmpl (:e %)) (:id %)) (lookup cs nm))) (catch arbace.lang.ExceptionInfo _ nil))
                      p (ps)]
                  (if (and (seq tids) p) {:k :spec :tids tids :ps p} :any))
                ;; (a template of the name visible: `friend void t<>(int);`, a template-id the tree does not mark, may be meant)
                (try (some #(= :tmpl (:e %)) (lookup cs nm)) (catch arbace.lang.ExceptionInfo _ true)) :any
                :else (if-let [p (ps)] {:k :plain :ns (vec (:path ns)) :ps p} :any))]
      (abi/update-cls! id update-in [:friend-fn-ids nm] (fnil conj []) ent))))

(defn- cx-friend-member-access!
  "Queue 499 (the checker): a friend declaration `k` of the class `id` (its scope `cs`) whose function `fd` is a member
  of another class named by a qualified name (`friend void A::f();`), [class.friend]/7 with [class.access]/4: the name is
  looked up and its access checked in the befriending class; every member function of that name in the named class
  private or protected and inaccessible from `id` (any one the declaration matches is): GCC's \"'void A::f()' is private
  within this context\" at the friend declaration. The befriending class neither a template nor a specialization of one,
  nor local nor a closure."
  [cs id k fd]
  (when (and (checking?) *on-refusal* fd (= "FunctionDecl" (:kind fd)) (string? (:_qual fd)) (string? (:name fd)) (seq (:name fd))
             (not (:tmpl (abi/cls id))) (not (:targs (abi/cls id))))
    (when-let [rs (cx-enclosing-classes id)]
      (let [q (vec (remove str/blank? (map str/trim (str/split (str/replace (:_qual fd) #"::\s*$" "") #"::"))))
            cid (when (and (seq q) (not-any? #(str/includes? % "<") (butlast q)))
                  (try (some-> (first (filter #(= :type (:e %)) (lookup-qualified cs q))) :ty class-id)
                       (catch arbace.lang.ExceptionInfo _ nil)))
            fs (when (and cid (not (contains? rs cid)) (:complete (abi/cls cid)))
                 (keep (fn [[_ e]] (when (= :fn (:e e)) (fnd (:id e)))) (class-lookup cid (:name fd))))]
        (when (and (seq fs)
                   (every? (fn [f] (and (#{:private :protected} (:access f)) (:cls f)
                                        (false? (cx-access-ok? {:records rs} (:cls f) (:access f) cid nil))))
                           fs))
          (*on-refusal* (ex-info (str "codegen: '" (:name fd) "' is a " (name (:access (first fs))) " member of '" (:name (abi/cls cid)) "'")
                                 {:codegen/refused :access :cx/node k})
                        k))))))

(defn- cx-access!
  "The checker: a member `nm` of class `dc` with access `a`, named through class `nc` (nil: dc) with the object of class
  `obj` (nil for a static member, a type, a constructor), inaccessible in the context of `ctx`: the error."
  [ctx dc nm a nc obj]
  (when (and (checking?) dc a)
    (let [nc (if (and nc (or (= nc dc) (abi/derived-from? nc dc))) nc dc)]
      (when (or (not= :public a) (not= nc dc))
        (when-let [cx (cx-context ctx)]
          (when (false? (cx-access-ok? cx dc a nc obj))
            (if (= :public a)
              (fail :access "'" nm "' is a member of '" (:name (abi/cls dc)) "', an inaccessible base of '" (:name (abi/cls nc)) "'")
              (fail :access "'" nm "' is a " (name a) " member of '" (:name (abi/cls dc)) "'"))))))))

;; (queue 463: a static data member's access; in a constraint's satisfaction, [temp.constr.atomic]/3, the access is checked in
;; the constrained declaration's context, which a friend declaration of a template may name -- not judged, the satisfaction
;; doubtful, so that no friend's access makes a false constraint failure: cpp2a/concepts-access2.C)
(defn- cx-static-access!
  [ctx dc nm a nc]
  (if *constraint-doubt*
    (try (cx-access! ctx dc nm a nc nil)
         (catch arbace.lang.ExceptionInfo x
           (if (= :access (:codegen/refused (ex-data x)))
             ;; (cpp-tpl2: the constrained template's name known, *cx-constraint-of*, and the class naming no friend that could be
             ;; it -- a friend class or function of that name, or one it cannot tell -- the error is sure: concepts-access2.C's B)
             (let [c (abi/cls dc) tn *cx-constraint-of*]
               (if (and (string? tn) c
                        (not (contains? (:friend-class-names c) tn)) (not (contains? (:friend-fns c) tn))
                        (not (contains? (:friend-class-names c) "")))
                 (throw x)
                 (doubt!)))
             (throw x))))
    (cx-access! ctx dc nm a nc nil)))

(defn- cx-ctor-access!
  "CX12 (the checker): the constructor an initialization `r` calls, private or protected, inaccessible in its context
  ([class.access]/1-2; [class.protected]: a protected one through a derived class's member or friend; the rest of CP313
  (a): every context cx-context judges, a constructor template's specialization with its template's access; before it,
  a namespace-scope variable's initializer alone)."
  [ctx r]
  (when (and (checking?) (map? r))
    (when-let [fid (or (when (= :ctor (:i r)) (:fn r)) (when (= :ctor (:i (:then r))) (:fn (:then r))) (:cx-ctor r))]
      (let [f (fnd fid)]
        (when (and (#{:private :protected} (:access f)) (:cls f) (not (:implicit f)))
          ;; (cpp-singles: the constructor is odr-used all the same, [basic.def.odr]/? -- access is checked after overload
          ;; resolution, the choice stands --, so a class template's member constructor is instantiated though the error
          ;; leaves the initialization out: its own errors reported, cpp1y/pr66690.C's D<int>::D(); instantiate-lazy's)
          (when (:lazy f) (upd-fn! fid assoc :cx-odr-used true))
          (if (:cx-global ctx)
            (fail :access "'" (:name f) "' is a " (name (:access f)) " member of '" (:name (abi/cls (:cls f))) "'")
            (cx-access! ctx (:cls f) (:name f) (:access f) nil nil))))))
  r)

;; queue 499 (the checker): a subobject's destructor that is deleted or inaccessible deletes the implicit destructor
;; ([class.dtor]/7.2), and an inaccessible one the implicit default, copy and move constructors too ([class.default.ctor]/2.7,
;; [class.copy.ctor]/10.4; a deleted one is queue 492's); GCC reports the inaccessible destructor at the class ("'A::~A()'
;; is private within this context"), as cx-deleted-implicit! reports a subobject's deleted member. Judged only where sure:
;; a private destructor declared by the user, the class neither a union nor nested in a class nor local, no friend the
;; slice cannot classify; an abstract class's virtual bases (no potentially constructed subobjects since C++14, DR 1658,
;; GCC from C++14 on: cpp0x/pr66443-cxx11-2.C, cpp1y/pr79393-2.C) not judged.

(declare cx-deleted-implicit!)

(defn- cx-sub-classes
  "Queue 499: the classes of class `cid`'s potentially constructed subobjects ([special]/7): its direct non-virtual
  bases, its non-static data members of class type (or arrays of it), its virtual bases unless (from C++14) it may be
  abstract; nil for a union or a class the slice does not judge."
  [cid]
  (let [c (abi/cls cid)]
    (when (and c (not (:union c)) (not (:lambda c)) (cx-enclosing-classes cid) (= #{cid} (cx-enclosing-classes cid)))
      (let [vb (abi/vbases cid)
            abstract? (fn [] (some (fn [k] (some #(:pure (fnd %)) (:methods (abi/cls k)))) (cons cid (map :cls (:bases c)))))]
        (distinct
          (concat (keep #(when-not (:virtual %) (:cls %)) (:bases c))
                  (keep (fn [fl] (let [t (abi/unq (loop [t (:ty fl)] (if (abi/arr? t) (recur (:of t)) t)))]
                                   (when (and (abi/class? t) (not (abi/ref? (:ty fl)))) (:id t))))
                        (remove :static (:fields c)))
                  (when (and (seq vb) (or (< (long *cxx-year*) 14) (not (abstract?)))) vb)))))))

(defn- cx-sub-dtor!
  "Queue 499: the implicit special member `f` (a destructor, or a default, copy or move constructor) of class `cls`,
  deleted for a potentially constructed subobject's destructor: a private user-declared one inaccessible from `cls`'s
  members (cx-access-ok?), or for a destructor a deleted one; the deletion thrown as a deleted call, the subobject's
  destructor (:cx-q499-sub) for cx-deleted-implicit!'s chain."
  [f cls]
  (when (and (checking?) (:implicit f) (#{:ctor :dtor} (:kind f)) (not (:inh-from f)))
    (doseq [sc (cx-sub-classes cls)
            :let [d (some-> (abi/cls sc) :dtor fnd)]
            :when d]
      (when (and (= :dtor (:kind f)) (:deleted d) (:deleted-sure d))
        (throw (ex-info (str "codegen: call to a deleted function ~" (:name (abi/cls sc)))
                        {:codegen/refused :overload :cx-q499-sub (when (:implicit d) (:id d))})))
      (when (and (= :private (:access d)) (not (:implicit d)) (not= sc cls)
                 (false? (cx-access-ok? {:records #{cls}} sc :private sc nil)))
        (throw (ex-info (str "codegen: call to a deleted function ~" (:name (abi/cls sc)) " (a private destructor)")
                        {:codegen/refused :overload}))))))

(defn- cx-user-dtor-subs!
  "Queue 499: a user-provided destructor `f` of class `cls` destroys its potentially constructed subobjects
  ([class.dtor]/13): one whose destructor is deleted (cx-sub-dtor!'s, the checker sure of it) is a use of a deleted
  function, reported at the body's end (GCC's place) after the deleted destructor's reason at its class."
  [f cls]
  (when (and (checking?) *on-refusal* (= :dtor (:kind f)) (not (:implicit f)) (not (:defaulted f)) (:body f))
    (when-let [d (some (fn [sc] (let [d (some-> (abi/cls sc) :dtor fnd)] (when (and d (:deleted d) (:deleted-sure d) (:implicit d) (:cx-sub-deleted d)) d)))
                       (cx-sub-classes cls))]
      (when-let [e (get-in (:body f) [:range :end])]
        (cx-deleted-implicit! d)
        (let [n {:range {:begin e :end e}}]
          (*on-refusal* (ex-info (str "codegen: call to a deleted function " (:name d) " (implicitly deleted)") {:codegen/refused :overload :cx/node n}) n))))))

(defn- cx-sub-dtor-chain!
  "Queue 499: after cx-deleted-implicit! reported the implicit member `f` at its class, the subobject's implicitly
  deleted destructor it was deleted for (cx-sub-dtor!'s :cx-q499-sub), reported at its own class."
  [f]
  (when-let [g (some-> (:cx-q499-sub f) fnd)]
    (cx-deleted-implicit! g)))

;; (queue 463, the checker: an implicitly declared special member deleted because a subobject's corresponding member is
;; deleted ([class.default.ctor]/2, [class.copy.ctor]/10, [class.copy.assign]/7, [class.dtor]/7), at its first use: GCC
;; reports the subobject's deleted call again at the class, where it implicitly defines the member ("use of deleted
;; function" on the class's line, besides the use's); once a member)
(defn- cx-deleted-implicit!
  [f]
  (when (and (checking?) *on-refusal* (not *cx-in-implicit*) (or (:implicit f) (:defaulted f)) (:cx-sub-deleted f) (not (:cx-class-reported f)))
    (when-let [cn (or (:cx-union-node f) (when (and (:defaulted f) (not (:implicit f))) (:node f)) (:cx-node (abi/cls (:cls f))))]
      (upd-fn! (:id f) assoc :cx-class-reported true)
      (*on-refusal* (ex-info (str "codegen: call to a deleted function " (:cx-sub-deleted f) " (implicitly defining " (:name f) ")")
                             {:codegen/refused :overload :cx/node cn})
                    cn)
      ;; (queue 499: the subobject's member, implicitly deleted for queue 499's reasons, its own reason at its class too)
      (cx-sub-dtor-chain! f)
      ;; (cpp-decl2: a default constructor deleted for subobjects' deleted default constructors, [class.default.ctor]/2.5:
      ;; each such subobject's own reason at its class too, as GCC explains the deletion member by member down to the
      ;; uninitialized const or reference member, "uninitialized const member in 'struct Y11'": init/pr25811.C's Y1 over
      ;; Y11 a[1], Z over Z1-Z4, init/const10.C's D over its base B)
      (when (and (= :ctor (:kind f)) (empty? (:ps (:ty f))))
        (let [c (abi/cls (:cls f))]
          (doseq [sc (distinct (concat (map :cls (:bases c))
                                       (keep (fn [fl] (let [t (abi/unq (loop [t (:ty fl)] (if (abi/arr? t) (recur (:of t)) t)))]
                                                        (when (and (abi/class? t) (not (abi/ref? (:ty fl)))) (:id t))))
                                             (remove :static (:fields c)))))
                  :when (and sc (not= sc (:cls f)))
                  :let [g (some (fn [cid] (let [g (fnd cid)] (when (and (= :ctor (:kind g)) (empty? (:ps (:ty g))) (:implicit g)
                                                                         (:deleted g) (:deleted-sure g) (:cx-sub-deleted g))
                                                                g)))
                                (:ctors (abi/cls sc)))]
                  :when g]
            (cx-deleted-implicit! g)))))))

;; (queue 463, the checker: the destructor a variable's definition makes potentially invoked, [class.dtor]/15: "a program
;; is ill-formed if a destructor that is potentially invoked is deleted or not accessible from the context of the
;; invocation"; [basic.stc.static], [basic.stc.auto], [stmt.dcl]: a variable of class type, or an array of them, of static
;; or automatic storage duration; the user-declared destructor's access as cx-ctor-access! judges a constructor's)
(defn- cx-dtor-access!
  [ctx t]
  (when (and (checking?) t (not (abi/ref? t)))
    (let [u (loop [u (abi/unq t) k 0] (if (and (abi/arr? u) (< k 8)) (recur (abi/unq (:of u)) (inc k)) u))]
      (when (abi/class? u)
        (when-let [d (some-> (:dtor (abi/cls (:id u))) fnd)]
          ;; (queue 463: a deleted one, written so or implicitly deleted for a subobject's, [class.dtor]/15 with
          ;; [dcl.fct.def.delete]/2, GCC's "use of deleted function 'A::~A()'")
          (when (and (:deleted d) (:deleted-sure d))
            (cx-deleted-implicit! d)
            (fail :overload "call to a deleted function " (:name d) (if (:implicit d) " (implicitly deleted)" "")))
          (when (and (#{:private :protected} (:access d)) (:cls d) (not (:implicit d)))
            (if (:cx-global ctx)
              (fail :access "'" (:name d) "' is a " (name (:access d)) " member of '" (:name (abi/cls (:cls d))) "'")
              (cx-access! ctx (:cls d) (:name d) (:access d) nil nil))))))))

;; queue 492 (the checker): a variable's copy-list-initialization (`T t = {...};`) in progress, [over.match.list]/1: in
;; copy-list-initialization an explicit constructor chosen makes the program ill-formed.

(defn- cx-explicit-list!
  "Queue 492: the constructor a list-initialization `r` of class type `t` chose, when explicit in a copy-list-initialization
  (*cx-copy-list*): GCC's \"converting to 'A' from initializer list would use explicit constructor\"; else `r`."
  [t r]
  (when (and (checking?) *cx-copy-list* (map? r) (= :ctor (:i r)))
    (when-let [f (some-> (:fn r) fnd)]
      ;; (a conditional explicit-specifier, explicit(e), and a template's specialization not judged: a value the slice
      ;; cannot evaluate counts as explicit, explicit-spec)
      ;; (queue 497: explicit(cond) judged when the slice evaluated cond, :explicit-sure)
      (when (and (:explicit f) (:node f) (:explicit-sure f))
        (throw (ex-info (str "codegen: converting to '" (:name (abi/cls (:id (abi/unq t)))) "' from initializer list would use explicit constructor")
                        ;; (queue 497: at the braced list's end, as GCC: cpp2a/explicit20.C's list over five lines)
                        (cond-> {:codegen/refused :init}
                          (map? *cx-copy-list*) (assoc :cx/node (let [r (:range *cx-copy-list*)]
                                                                  (if (and (:end r) (:offset (:end r)))
                                                                    (assoc *cx-copy-list* :range {:begin (merge (:begin r) (:end r))})
                                                                    *cx-copy-list*)))))))))
  r)

(defn- cx-closure-members!
  "Queue 508 (the checker): a closure type's special members ([expr.prim.lambda.closure]/13 of C++20; /20 of C++17):
  before C++20 it has a deleted default constructor and a deleted copy assignment operator (so no implicit move
  assignment, its move assignment deleted alike); from C++20 the same for a lambda with a lambda-capture (`[&]` and `[=]`
  among them), which has no default constructor at all, a captureless one's both defaulted. GCC's \"use of deleted
  function\" at the default-initialization or the assignment (cpp2a/lambda1.C, cpp0x/lambda/lambda-ctor-neg.C)."
  [id capture?]
  (when (and (checking?) (or (< (long *cxx-year*) 20) capture?))
    (let [c (abi/cls id)
          del {:deleted true :deleted-sure true :deleted-why "a lambda closure type has a deleted default constructor or copy assignment operator"}]
      (doseq [x (:ctors c) :let [g (fnd x)] :when (and (:implicit g) (empty? (:ps (:ty g))))]
        (if (< (long *cxx-year*) 20)
          (upd-fn! x merge del)
          (abi/update-cls! id update :ctors (fn [cs] (vec (remove #{x} cs))))))
      (doseq [x (:methods c) :let [g (fnd x)] :when (and (:implicit g) (= "=" (:op g)))]
        (upd-fn! x merge del)))))

(defn- cx-elided-copy!
  "Queue 508 (the checker): before C++17 an object of class `id` initialized from a prvalue of its own class -- the
  converted prvalue of a copy-initialization ([dcl.init]/17.6.3 of C++14: \"the result of the call ... is then used to
  direct-initialize\"), a variable, return value, argument or member initialized from one, a mem-initializer's
  `b(f())` -- is initialized by a copy or move constructor that may be elided, and still [class.copy]/31 of C++14 requires
  it ([class.temporary]/1: \"even if the copy/move constructor is not called, all the semantic restrictions, such as
  accessibility, shall be satisfied\"): a deleted one chosen is GCC's \"use of deleted function\". Judged as CX12's rule
  judges any call (resolve-overload*: the deleted one chosen surely); any other refusal of that choice is not judged.
  `e` the prvalue (or nil: a prvalue of the class made by the copy-initialization's converting constructor)."
  [id e]
  (when (and (checking?) (< (long *cxx-year*) 17))
    (let [a (or e {:op :temp :init {:i :none} :ty {:k :class :id id} :cat :pr})]
      (try (resolve-overload (ctor-candidates id) [a] nil)
           (catch arbace.lang.ExceptionInfo x
             (when (re-find #"call to a deleted function" (str (.getMessage x))) (throw x))
             ;; (cpp-decl2: none viable, the class's constructors all known -- no constructor template, none inherited, not a
             ;; header's -- is GCC's "cannot bind non-const lvalue reference of type 'A&' to an rvalue": template/crash126.C's
             ;; A(A&) for A<int,int>(A<int,int>()) at C++14)
             (let [c (abi/cls id)]
               (when (and (re-find #"^codegen: no viable function among [1-9]" (str (.getMessage x)))
                          (empty? (:ctor-tmpls c)) (empty? (:inherits-ctors c)) (not (:header c)) (not (:cx-ctor-dropped c)))
                 (throw x))))))))

(def ^:dynamic *copy-init-ctors* nil) ; cpp-tzdb: a copy-initialization from the class's own type, class-init's: no explicit template

(defn- class-init
  "The initialization of an object of class type `t` by the arguments `args` (typed expressions or an init-list)."
  [t args ctx style]
  ;; (queue 492, the checker: an object of a class type the checker knows incomplete here initialized, a cast's, an
  ;; argument's or a variable's, [basic.def]/5, [dcl.init.general]/7, [expr.type.conv]/1; GCC's "invalid use of incomplete
  ;; type")
  (when-let [c (and (checking?) (cx-incomplete-cls t))]
    (fail :incomplete "invalid use of incomplete type '" (:name c) "'"))
  (let [id (:id (abi/unq t))]
    (cx-ctor-access! ctx
    (cond
      ;; copy-initialization from a prvalue of the class: in place ([dcl.init]/17.6.1)
      (and (= 1 (count args)) (not= :init-list (:op (first args))) (= (class-id (:ty (first args))) id) (= :pr (:cat (first args))))
      (do (cx-elided-copy! id (first args)) {:i :expr :e (first args)})
      ;; (cpp-s11: a braced list as the one argument of a parenthesized direct-initialization, `U u({3, 4})`, is no
      ;; list-initialization of U: the constructors are chosen for the list as their argument, [dcl.init.general]/16.6.2.1
      ;; with [over.ics.list]; it had initialized U from the list's elements, <format>'s _Utf32_view<subrange<iterator>>
      ;; __uv({__first, __last}) "no viable function among 2 for 2 arguments")
      (and (= 1 (count args)) (= :init-list (:op (first args))) (not= style :direct))
      (cx-explicit-list! t
      (let [l (first args)]
        (if (aggregate? (abi/unq t))
          (init-for t l ctx :list)
          (cond
            ;; T{} with a default constructor: value-initialization ([dcl.init.list]/3.5)
            (and (empty? (:items l)) (seq (filter #(let [f (fnd %)] (<= (count (:ps (:ty f))) (count (filter some? (:defaults f))))) (ctor-candidates id))))
            (default-ctor-init id true)
            ;; [over.match.list]/1.1: the initializer-list constructors with the list as one argument first
            :else
            (or (let [ils (init-list-ctors id)
                      viable (keep (fn [fid] (when-let [a (std-init-list (first (:ps (:ty (fnd fid)))) l ctx)] [fid a])) ils)]
                  (when (seq viable)
                    (let [fid (if (= 1 (count viable)) (ffirst viable) (resolve-overload (map first viable) [(second (first viable))] nil))
                          a (some #(when (= fid (first %)) (second %)) viable)]
                      ;; (narrowing judged when one initializer-list constructor is viable: between several the choice
                      ;; above does not rank the elements' conversions, [over.ics.list]/7)
                      (when (= 1 (count viable)) (narrow-list-check! a l))
                      {:i :ctor :fn fid :args (call-args (fnd fid) [a] ctx)})))
                ;; 1.2: all the constructors with the list's elements (each an argument, a list among them too)
                (narrow-ctor-check! (ctor-init id (:items l) ctx (and (= 1 (count (:items l))) (= :init-list (:op (first (:items l)))))) (:items l)))))))
      (and (empty? args)) (default-ctor-init id (= style :value))
      ;; from another class with a conversion function to this one: the conversion's prvalue ([dcl.init]/17.6.3,
      ;; [over.match.copy]; G5: strong_ordering to partial_ordering; else the copy constructor's reference would bind
      ;; through the same conversion, again and again)
      (and (= 1 (count args)) (not= :init-list (:op (first args))) (class-id (:ty (first args)))
           (not= (class-id (:ty (first args))) id) (not (abi/derived-from? (class-id (:ty (first args))) id))
           (conv-for (class-id (:ty (first args))) (abi/unq t) false (:c (:ty (first args)))))
      {:i :expr :e (user-conv ctx (first args) (abi/unq t) false)}
      ;; C++20's parenthesized initialization of an aggregate ([dcl.init.general]/16.6.2.2, P0960): no constructor viable
      ;; for the parenthesized arguments, the elements copy-initialized from them in order (CP280 (a); brace elision
      ;; and the narrowing check do not apply: the list's rules, which elide and check more, are not used for a
      ;; refusal -- a list the slice refuses refuses the initialization as before)
      (and (= style :direct) (seq args) (>= (long *cxx-year*) 20) (aggregate? (abi/unq t))
           (not-any? #(= :init-list (:op %)) args))
      (try (ctor-init id args ctx)
           (catch arbace.lang.ExceptionInfo x
             (if (and (= :overload (:codegen/refused (ex-data x))) (re-find #"no viable" (str (.getMessage x))))
               (let [subs (aggr-subs (abi/unq t) (count args))]
                 (when (> (count args) (count subs)) (throw x))
                 ;; (cpp-rind, the checker: no brace elision in a parenthesized aggregate initialization, an array element is
                 ;; copy-initialized from its argument: an argument that is no braced list, string literal or array is GCC's
                 ;; "array must be initialized with a brace-enclosed initializer"; cpp2a/paren-init19.C)
                 (when (checking?)
                   (doseq [[st a] (map vector subs args)]
                     (when (and (abi/arr? (abi/unq st)) (map? a) (not= :str (:op a)) (some? (:ty a))
                                (not (abi/arr? (abi/unq (abi/non-ref (:ty a))))))
                       (fail :array-init "array must be initialized with a brace-enclosed initializer"))))
                 (init-for t {:op :init-list :items (vec args) :paren true} ctx :list))
               (throw x))))
      ;; (queue 508, the checker: a copy-initialization from another type, by a converting constructor, before C++17
      ;; then copies the prvalue it made, cx-elided-copy!)
      (and (= style :copy) (= 1 (count args)) (not= :init-list (:op (first args)))
           (let [c (class-id (:ty (first args)))] (not (and c (or (= c id) (abi/derived-from? c id))))))
      (let [r (ctor-init id args ctx)]
        ;; (cpp-decl2, the checker: copy-initialization from another type considers the converting constructors alone,
        ;; [over.match.copy]/1.1, [class.conv.ctor]/2: an explicit constructor chosen, none of the others viable, is GCC's
        ;; "conversion from 'int' to non-scalar type 'A' requested"; cpp0x/nsdmi3.C's default member initializer `A a1 = 1;`)
        (when (and (checking?) (map? r) (= :ctor (:i r)))
          (let [f (some-> (:fn r) fnd)]
            (when (and f (:explicit f) (:explicit-sure f) (:node f))
              (let [others (remove #(:explicit (fnd %)) (ctor-candidates id))]
                (when (or (empty? others)
                          (try (resolve-overload others args nil) false
                               (catch arbace.lang.ExceptionInfo x (boolean (re-find #"no viable function among" (str (.getMessage x)))))))
                  (throw (ex-info (str "codegen: conversion from " (cx-tyname (:ty (first args))) " to non-scalar type '" (:name (abi/cls id)) "' requested (an explicit constructor)")
                                  {:codegen/refused :init :cx/conv-explicit true})))))))
        (cx-elided-copy! id nil) r)
      ;; (cpp-tzdb: a copy-initialization from the class's own type or a derived one, [over.match.ctor]/1: the converting
      ;; constructors alone, no explicit constructor template's specialization -- <format>'s basic_format_arg::handle,
      ;; `template<typename _Tp> explicit handle(_Tp&)`, had taken a non-const handle copied by value, formatter<handle>)
      (and (= style :copy) (= 1 (count args)) (not= :init-list (:op (first args)))
           (let [c (class-id (:ty (first args)))] (and c (or (= c id) (abi/derived-from? c id)))))
      (binding [*copy-init-ctors* true] (ctor-init id args ctx))
      :else (ctor-init id args ctx)))))

(defn- inheriting-ctor!
  "CP330 (a): the constructor of class `id` that inherits the base constructor `bfid` ([namespace.udecl]/3,
  [class.inhctor.init]), made once: the base constructor's parameters (and default arguments), its definition the base
  subobject initialized by `bfid` with the parameters forwarded and the other subobjects default-initialized (as an
  implicit default constructor's, their default member initializers), analyze-implicit!'s :inh-from. Mangled as Itanium
  §5.1.4.3's inheriting constructor (CI1/CI2 and the base's name, abi/unqualified-name), as clang emits it at -O0. It is no
  member of the class's :ctors: the base constructor stays the candidate overload resolution sees."
  [id bfid]
  (or (get-in (abi/cls id) [:inheriting bfid])
      (let [b (fnd bfid)
            c (abi/cls id)
            fid (next-id)
            f (merge {:id fid :name (:name c) :kind :ctor :cls id :ty (:ty b) :implicit :ctor :inline true
                      :path (conj (vec (:path c)) [:cls id]) :scope (:scope c) :def-scope (:scope c) :linkage :cpp
                      :param-names (mapv (fn [_] nil) (:ps (:ty b))) :defaults (vec (:defaults b)) :pos -1
                      :inh-from bfid :inh-base (:cls b) :access (:access b)
                      ;; (cpp-s4: mangled by the class whose constructor it inherits in the end, Itanium §5.1.4.3, as
                      ;; clang names _Move_assign_base's `CI2 _Variant_storage`, which calls _Copy_assign_base's of the same)
                      :inh-name (or (:inh-name b) (:cls b))}
                     (when (:tinst b) {:tinst (:tinst b)})
                     ;; (cpp-rt-own3: an internal class's inheriting constructor internal, as implicit-fn!'s members: format.cc's
                     ;; __uniq_ptr_data<(anonymous)::__encoding, ...>'s CI2 __uniq_ptr_impl, written linkonce_odr before)
                     (when (:internal (:scope c)) {:internal true})
                     (select-keys b [:explicit :noexcept :constexpr]))]
        (swap! *fns* assoc fid f)
        (abi/update-cls! id assoc-in [:inheriting bfid] fid)
        (swap! *order* conj [:fn fid])
        fid)))

(defn- inherit-through!
  "cpp-s4: the inheriting constructor of class `id` for the base constructor `g`, `g`'s class a direct base of `id` or
  an indirect one whose constructors the bases between inherit ([class.inhctor.init]/1, each base's inheriting
  constructor made in turn)."
  [id g]
  (let [gc (:cls (fnd g))
        below? (fn below? [c] (or (= c gc) (some #(below? (:cls %)) (:bases (abi/cls c)))))
        bs (map :cls (:bases (abi/cls id)))]
    (if (some #{gc} bs)
      (inheriting-ctor! id g)
      (let [b (or (first (filter below? bs)) (fail :overload "an inherited constructor's base"))]
        (inheriting-ctor! id (inherit-through! b g))))))

(defn- cx-inh-report!
  "Queue 509 (the checker): the refusal `x` reported again at the using-declaration of class `id` that names the class
  `bname` (GCC's place for the inheriting constructor's own error, [class.inhctor.init]/1), when one is known."
  [id bname x]
  (when-let [n (and *on-refusal* (get (:cx-inh-nodes (abi/cls id)) bname))]
    (when-not (header-node? n)
      (*on-refusal* (ex-info (.getMessage ^Throwable x) (assoc (ex-data x) :cx/node n)) n))))

(defn- cx-inherited-deleted!
  "Queue 509 (the checker): the base constructor `fid` inherited and chosen for an initialization of class `id`. The
  inheriting constructor initializes the other subobjects as an implicit default constructor would ([class.inhctor.init]/1),
  so one whose default-initialization chooses a deleted constructor surely (CX12, default-ctor-init) deletes it
  ([class.default.ctor]/2.4 by [namespace.udecl]/3): GCC's \"use of deleted function 'C::C()'\" at the using-declaration and
  \"use of deleted function 'B::B(T) [inherited from A]'\" at the use. Judged only where sure: `fid`'s class a direct
  non-virtual base of `id`, no virtual base, `id` no union; the other direct bases and the non-static members of class type
  (or arrays of it) without a default member initializer, no reference, no anonymous member."
  [id fid]
  (let [c (abi/cls id)
        bc (:cls (fnd fid))]
    (when (and (checking?) bc (not (:union c)) (empty? (abi/vbases id)) (not (:tmpl c))
               (some #(and (= bc (:cls %)) (not (:virtual %))) (:bases c)))
      (let [subs (concat (keep #(when (not= bc (:cls %)) (:cls %)) (:bases c))
                         (keep (fn [fl]
                                 (when (and (not (:static fl)) (not (:init fl)) (not (:anon fl)) (:ty fl) (not (abi/ref? (:ty fl))))
                                   (let [t (abi/unq (loop [t (:ty fl)] (if (abi/arr? t) (recur (:of t)) t)))]
                                     (when (abi/class? t) (:id t)))))
                               (:fields c)))
            x (some (fn [sc] (try (default-ctor-init sc false) nil
                                  (catch arbace.lang.ExceptionInfo x
                                    ;; (queue 510: or no default constructor, surely: cpp1z/inh-ctor22.C's D2's `B1 b;`)
                                    (when (or (re-find #"call to a deleted function" (str (.getMessage x))) (:cx/no-default-sure (ex-data x))) x))))
                    subs)]
        (when x
          (cx-inh-report! id (:name (abi/cls bc)) x)
          (fail :overload "call to a deleted function " (:name c) " (inherited from " (:name (abi/cls bc)) ")"))))))

(defn- cx-inh-paths
  "Queue 510 (the checker): the base constructors class `cid` inherits by its using-declarations, transitively through the
  bases that inherit them in turn ([namespace.udecl]/3, [class.inhctor.init]/1), each as [fid virtual?] once per path,
  `virtual?` when a virtual base is on the path; copy and move constructors and those without parameters left out."
  [cid args seen]
  (let [c (abi/cls cid) nms (:inherits-ctors c)]
    (when (and (seq nms) (not (contains? seen cid)))
      (for [b (:bases c)
            :let [bc (:cls b)]
            :when (contains? nms (:name (abi/cls bc)))
            [fid v] (concat (for [fid (concat (ctor-candidates bc) (when-let [h (:ctor-candidates @hooks)] (h bc args)))
                                  :let [f (fnd fid)]
                                  :when (and (seq (:ps (:ty f))) (not (copy-ctor? f (:cls f))) (not (move-ctor? f (:cls f))))]
                              [fid false])
                            (cx-inh-paths bc args (conj seen cid)))]
        [fid (boolean (or v (:virtual b)))]))))

(defn- cx-inh-ambiguous!
  "Queue 510 (the checker): an initialization of class `id` by `args` that chooses, among its own constructors and those it
  inherits transitively (cx-inh-paths), a base constructor inherited from two base class subobjects -- two paths without a
  virtual base -- is ill-formed ([namespace.udecl]/3 with [class.inhctor.init]: P0136R1's D1 d1(0), cpp1z/inh-ctor24.C);
  judged when overload resolution chooses it; a virtual base's (one subobject, D2) is not."
  [id args own]
  (let [paths (cx-inh-paths id args #{})
        by (group-by first paths)]
    (when (some (fn [[_ ps]] (<= 2 (count (remove second ps)))) by)
      (let [fid (try (resolve-overload (distinct (concat own (map first paths))) args nil) (catch arbace.lang.ExceptionInfo _ nil))]
        (when (and fid (<= 2 (count (remove second (get by fid)))))
          ;; (GCC deletes such an inheriting constructor: "use of deleted function 'D1::D1(int) [inherited from A]'")
          (fail :overload "call to a deleted function " (:name (abi/cls id)) " (inherited from " (:name (abi/cls (:cls (fnd fid))))
                " through multiple base class subobjects)"))))))

(def ^:dynamic *cx-ctor-active* #{})

(declare ctor-init*)

(defn- ctor-init
  "A constructor of class `id` chosen for the arguments `args` by overload resolution, its call's initializer. `nested`:
  the second phase of [over.match.list] with one element itself a list, where a conversion to X by a user-defined
  conversion is not considered for a constructor's first parameter of type X or reference to X ([over.best.ics]/4)."
  ([id args ctx] (ctor-init id args ctx false))
  ([id args ctx nested]
  ;; (cpp-rind, the checker: a constructor call whose argument's initialization needs the same constructor call again --
  ;; B from const B by B(const A&), A from B by A(B), B from const B ... ([over.best.ics]/4: a user-defined conversion's own
  ;; argument takes no other) -- is no conversion, GCC's "no matching function"; it had recursed until the stack overflowed:
  ;; overload/copy1.C)
  (let [k (when (checking?) [id (mapv #(when (map? %) [(abi/unq (:ty %)) (:cat %)]) args)])]
    (when (and k (contains? *cx-ctor-active* k))
      (fail :overload "no viable function among 1 (a constructor's argument converted by the same constructor call again)"))
    (binding [*cx-ctor-active* (if k (conj *cx-ctor-active* k) *cx-ctor-active*)]
      (ctor-init* id args ctx nested)))))

(defn- ctor-init*
  [id args ctx nested]
  ;; (cpp-tzdb: copy-initialization, *copy-init-ctors*, takes no explicit constructor among the hooks' candidates)
  (let [copy? *copy-init-ctors*]
  (binding [*copy-init-ctors* nil]
  (let [hc (when-let [h (:ctor-candidates @hooks)] (cond->> (h id args) copy? (remove #(:explicit (fnd %)))))
        cands (concat (ctor-candidates id) hc)
        ;; (CP323 (a), the checker: the constructors a class inherits by `using B::B;` ([namespace.udecl]/3,
        ;; [over.match.funcs]/8-9: B's constructors but its copy and move constructors and a default constructor), its
        ;; own declared beside them; one chosen is checked for its access as B's member ([namespace.udecl]/19) and the
        ;; initialization left unanalyzed, the object declared all the same)
        ;; (CP330 (a): the code generator's too; a base constructor with the parameter types of one of the class's own
        ;; is hidden by it, [namespace.udecl]/15)
        own-ps (set (map #(mapv abi/unq (:ps (:ty (fnd %)))) cands))
        ;; (cpp-s4: inherited transitively, a base's constructors that it inherits itself, [namespace.udecl]/3 and
        ;; [class.inhctor.init]/1: variant's _Move_assign_base, _Copy_assign_base, _Move_ctor_base and _Copy_ctor_base each
        ;; `using _Base::_Base;` down to _Variant_storage's)
        inh-of (fn inh-of [cid seen]
                 (when (and (seq (:inherits-ctors (abi/cls cid))) (not (contains? seen cid)))
                   (let [nms (:inherits-ctors (abi/cls cid))]
                     (vec (for [b (:bases (abi/cls cid))
                                :let [bc (:cls b)]
                                :when (and (contains? nms (:name (abi/cls bc))) (or (checking?) (not (:virtual b))))
                                fid (concat (concat (ctor-candidates bc) (when-let [h (:ctor-candidates @hooks)] (h bc args)))
                                            (when-not (checking?)
                                              (inh-of bc (conj seen cid))))
                                :let [f (fnd fid)]
                                :when (and (seq (:ps (:ty f))) (not (copy-ctor? f (:cls f))) (not (move-ctor? f (:cls f)))
                                           (or (checking?) (not= cid id) (not (contains? own-ps (mapv abi/unq (:ps (:ty f)))))))]
                            fid)))))
        inh (inh-of id #{})
        cands (concat cands inh)
        cands (if nested (remove #(= id (class-id (abi/non-ref (or (first (:ps (:ty (fnd %)))) abi/void)))) cands) cands)
        fid (try (binding [*drops* (assoc *drops* :explain (:explain (meta hc)))] (resolve-overload cands args nil))
                     (catch arbace.lang.ExceptionInfo e
                       (cond
                         ;; (cpp-decl2, the checker: an ambiguity among the class's own constructors and those it inherits from
                         ;; direct non-virtual bases that inherit none themselves, the candidates all known as for "no viable"
                         ;; below; a base constructor with the parameter types of one of the class's own hidden by it,
                         ;; [namespace.udecl]/15, before the ranking: [over.match.best]/2 has no tie-breaker for a base's
                         ;; constructor of other parameter types, so cpp1z/inh-ctor30.C's B(short) and A(double) for 1 are
                         ;; ambiguous)
                         (and (checking?) (:inherits-ctors (abi/cls id)) (not nested)
                              (re-find #"^codegen: ambiguous call \(\d+ viable\)$" (str (.getMessage e)))
                              (let [c (abi/cls id) nms (:inherits-ctors c)
                                    bs (filter #(contains? nms (:name (abi/cls (:cls %)))) (:bases c))]
                                (and (= (count nms) (count (set (map #(:name (abi/cls (:cls %))) bs))))
                                     (every? #(and (not (:virtual %)) (empty? (:inherits-ctors (abi/cls (:cls %))))) bs))))
                         (let [own (concat (ctor-candidates id) (when-let [h (:ctor-candidates @hooks)] (h id args)))
                               vis (remove #(contains? own-ps (mapv abi/unq (:ps (:ty (fnd %))))) inh)]
                           (resolve-overload (concat own vis) args nil))
                         ;; (CP323 (a): a class inheriting constructors, which the slice does not declare: for the checker
                         ;; an initialization no declared constructor accepts is not judged, the object declared all the same;
                         ;; the code generator refuses it, as before)
                         ;; (n-cpp-concepts: judged when every class named by its using-declarations is a direct base
                         ;; that inherits none itself, so the candidates above are all of them, [namespace.udecl]/3: a
                         ;; base constructor whose constraints are not satisfied is no candidate, concepts/inherit-ctor1.C)
                         (and (checking?) (:inherits-ctors (abi/cls id)) (re-find #"no viable|ambiguous" (str (.getMessage e)))
                              (not (and (re-find #"^codegen: no viable function among [1-9]" (str (.getMessage e)))
                                        (let [c (abi/cls id) nms (:inherits-ctors c)
                                              bs (filter #(contains? nms (:name (abi/cls (:cls %)))) (:bases c))]
                                          (and (= (count nms) (count (set (map #(:name (abi/cls (:cls %))) bs))))
                                               (every? #(and (not (:virtual %)) (empty? (:inherits-ctors (abi/cls (:cls %))))) bs))))))
                         ::inherited
                         (and (System/getenv "CPP_HDR_TRACE") (:codegen/refused (ex-data e)))
                         (fail (:codegen/refused (ex-data e)) (.getMessage e) " (constructing " (:name (abi/cls id)) ")")
                         ;; (queue 509, the checker: an inherited base constructor chosen that is deleted, reported at the
                         ;; using-declaration too, GCC's place: cpp0x/inh-ctor31.C)
                         :else (do (when (checking?)
                                     (when-let [[_ bn] (re-find #"^codegen: call to a deleted function (\S+)$" (str (.getMessage e)))]
                                       (when (and (not= bn (:name (abi/cls id)))
                                                  (some #(and (:deleted-sure (fnd %)) (= bn (:name (fnd %)))) inh))
                                         (cx-inh-report! id bn e))))
                                   (throw e)))))
            f (when-not (= ::inherited fid) (fnd fid))]
        ;; (queue 510, the checker: a base constructor inherited from two base class subobjects, cx-inh-ambiguous!)
        (when (and (checking?) (seq (:inherits-ctors (abi/cls id))) (or (= ::inherited fid) (some #{fid} inh)))
          (cx-inh-ambiguous! id args cands))
        (cond
          (= ::inherited fid) {:i :none}
          (and (checking?) (some #{fid} inh)) (do (cx-ctor-access! ctx {:i :ctor :fn fid}) (cx-inherited-deleted! id fid) {:i :none})
          ;; (CP330 (a), the code generator: the class's inheriting constructor for the chosen base constructor, called
          ;; with the arguments as that constructor's own would be, [class.inhctor.init]/1)
          ;; (a constructor inherited through a base that inherits it: that base's inheriting constructor first, cpp-s4)
          (some #{fid} inh) (let [d (inherit-through! id fid)] {:i :ctor :fn d :args (call-args (fnd d) args ctx)})
          ;; (cpp-s11: a trivial copy or move from a braced list, `T x({...})`, copies the list's temporary, [over.ics.list]:
          ;; the list initializes it, and the initialization is that temporary's)
          ;; (cpp-indep, the checker: that parameter's initialization a copy-list-initialization, [over.match.list]/1 with
          ;; [over.ics.list]: an explicit constructor chosen for it is ill-formed, cx-explicit-list!, cpp0x/initlist4.C's `A a2({1,2})`)
          (and (:trivial f) (= 1 (count args)) (= :init-list (:op (first args))))
          (binding [*cx-copy-list* (or *cx-copy-list* (checking?))] (init-for {:k :class :id id} (first args) ctx :copy))
          ;; (cpp-tzdb: an argument of the class or a class derived from it; one of another class reaches the trivial copy or
          ;; move constructor's reference through its conversion function, [over.ics.user], whose prvalue initializes the
          ;; object in place -- tzdb.cc's `sys_days{y/mwdl}`, year_month_weekday_last's operator sys_days(), whose 4 bytes had
          ;; been copied as the 8 of a time_point)
          (and (:trivial f) (= 1 (count args)) (not= :init-list (:op (first args)))
               (let [c (class-id (:ty (first args)))] (and c (not= c id) (not (abi/derived-from? c id)) (conv-for c {:k :class :id id} false (:c (:ty (first args)))))))
          {:i :expr :e (user-conv ctx (first args) {:k :class :id id} false)}
          (and (:trivial f) (= 1 (count args))) {:i :copy :e (first args) :cls id}
          ;; an immediate function's constructor of an empty class: evaluated, nothing at run time ([expr.const]/16;
          ;; G5: <compare>'s __cmp_cat::__unspec)
          (and (:consteval f) (abi/empty-class? id) (not (and (cx-p2564?) (cx-main-fn? f)))) {:i :none}
          :else {:i :ctor :fn fid :args (call-args f args ctx)})))))

(defn- cx-no-default-sure?
  "Queue 510 (the checker): whether class `id` surely has no default constructor ([class.default.ctor]/1, [over.match.ctor]):
  a complete class of the main file (a class template's specialization too, round 2), no instance whose definition refused,
  none inheriting constructors
  (a base's default constructor inherited, [namespace.udecl]/3), whose every constructor (the deleted ones too, an implicit
  one deleted unsure among them) has a parameter without a default argument, and whose every constructor template has more
  parameters that are no pack and have no default argument than none (template.ae's too-few-args?)."
  [id]
  (let [c (abi/cls id)
        h (:ctor-tmpls-need-args? @hooks)]
    (boolean
     (and (checking?) c (:complete c) (not (:defining c)) (not (:header c)) (not (:cx-inst-refused c)) (empty? (:inherits-ctors c))
          (every? (fn [fid] (let [f (fnd fid) ps (:ps (:ty f))]
                              (and (seq ps) (> (count ps) (count (filter some? (:defaults f)))))))
                  (:ctors c))
          (or (empty? (:ctor-tmpls c)) (and h (h id)))))))

(defn default-ctor-init
  "Default- (or with `value?` value-) initialization of a class object."
  [id value?]
  (let [zero? #(let [f (fnd %)] (<= (count (:ps (:ty f))) (count (filter some? (:defaults f)))))
        cands (filter zero? (ctor-candidates id))
        ;; no constructor that is no template takes no argument: the constructor templates' specializations for no
        ;; argument, by overload resolution ([class.default.ctor]/1, [over.match.ctor]; std::pair's C++17 default
        ;; constructors are templates whose conditions, enable_if<...>::type = true, choose the implicit or the explicit one)
        cands (or (seq cands)
                  (when-let [h (:ctor-candidates @hooks)]
                    (let [ts (filter zero? (h id []))]
                      (seq (if (> (count ts) 1) [(resolve-overload ts [] nil)] ts))))
                  ;; (cpp-rt-own: a base's default constructor its using-declaration inherits, [namespace.udecl]/16 (C++17, P0136R1:
                  ;; the inherited constructors are candidates as the class's own): unique_ptr's __uniq_ptr_data, `using
                  ;; __uniq_ptr_impl<_Tp, _Dp>::__uniq_ptr_impl;` beside its defaulted move constructor, value-initialized by
                  ;; unique_ptr() : _M_t() (fs_path.cc), "no default constructor" before; called through the class's inheriting
                  ;; constructor, as ctor-init calls an inherited one)
                  (let [c (abi/cls id) nms (:inherits-ctors c)]
                    (when (and (seq nms) (not (checking?)))
                      (seq (for [b (:bases c) :when (and (not (:virtual b)) (contains? nms (:name (abi/cls (:cls b)))))
                                 fid (ctor-candidates (:cls b)) :when (and (zero? fid) (empty? (:ps (:ty (fnd fid)))))]
                             fid)))))
        fid (first cands)
        fid (if (and fid (not= id (:cls (fnd fid)))) (inherit-through! id fid) fid)]
    (if (and (nil? fid) (checking?)
             (or (:cx-inst-refused (abi/cls id))
                 ;; (cpp-def2: a specialization surely without a definition, its variable's error cx-sure-incomplete-refusal's)
                 (and (:cx-sure-incomplete (abi/cls id)) (not (:complete (abi/cls id))))
                 ;; (queue 510, the checker: a base's default constructor its using-declaration inherits, as the code
                 ;; generator's branch above finds it ([namespace.udecl]/3, [over.match.funcs]/8 excludes only the copy and move
                 ;; constructors' shapes; g++ 15.2 accepts `struct D : B { using B::B; D(double); }; D d;` at C++11 to 20): not
                 ;; judged, as ctor-init leaves a chosen inherited constructor)
                 (let [c (abi/cls id) nms (:inherits-ctors c)]
                   (and (seq nms)
                        (some (fn [b] (and (not (:virtual b)) (contains? nms (:name (abi/cls (:cls b))))
                                           (some #(let [g (fnd %)] (and (empty? (:ps (:ty g))) (not (:deleted g)))) (:ctors (abi/cls (:cls b))))))
                              (:bases c))))))
      ;; (queue 487, the checker: an instance whose definition refused, its implicit members never declared: no error of
      ;; its own, the instantiation's being the one, template.ae's declare-instance!)
      {:i :none}
    (do
    (when-not fid
      ;; (queue 510, the checker: sure when cx-no-default-sure?, so that it deletes an implicit member or an inheriting
      ;; constructor surely, [class.default.ctor]/2.4)
      (if (cx-no-default-sure? id)
        (throw (ex-info (str "codegen: no default constructor for " (:name (abi/cls id))) {:codegen/refused :init :cx/no-default-sure true}))
        (fail :init "no default constructor for " (:name (abi/cls id)))))
    ;; (queue 510, the checker: an implicit default constructor not yet defined -- a class template's specialization or a
    ;; local class made after the declarations' entries -- defined now, so that one deleted surely for a subobject's deleted
    ;; or missing default constructor is the error of this use, as the entries define the main file's classes' before
    ;; their uses; any other refusal left to its entry: cpp2a/concepts-inherit-ctor2.C's S2<int>)
    (let [f (fnd fid)]
      (when (and (checking?) (:implicit f) (= :ctor (:kind f)) (not (:analyzed f)) (not (:params f)) (not (:deleted f)) (not (:inh-from f))
                 (not *cx-in-implicit*))
        (upd-fn! fid assoc :analyzed true)
        (try (analyze-implicit! fid)
             (catch arbace.lang.ExceptionInfo e
               (let [m (str (.getMessage e))
                     sub (or (second (re-find #"call to a deleted function (\S+)" m))
                             (when (:cx/no-default-sure (ex-data e)) (second (re-find #"no default constructor for (\S+)" m))))]
                 (if sub
                   (upd-fn! fid assoc :deleted true :deleted-sure true :tinits nil :cx-sub-deleted sub :cx-union-node (:cx-union-node (ex-data e)))
                   (upd-fn! fid dissoc :analyzed)))))))
    (when (and (checking?) (:deleted-sure (fnd fid)))
      ;; (queue 492: an implicitly deleted one's reason at its class too, as resolve-overload*'s)
      (cx-deleted-implicit! (fnd fid))
      (fail :overload "call to a deleted function " (:name (fnd fid))))
    (let [f (fnd fid)]
      (cond
        ;; (queue 463, the checker: the trivial default constructor chosen, a user-declared defaulted one among them, kept
        ;; for its access, cx-ctor-access!, [class.access]/1 with [class.default.ctor]: `class B { B() = default; }; B b;`)
        (:trivial f) (cond-> (if value? {:i :zero} {:i :none}) (and (checking?) (not (:implicit f))) (assoc :cx-ctor fid))
        (and value? (or (:implicit f) (:defaulted f))) {:i :zero-then :then {:i :ctor :fn fid :args []}}
        :else {:i :ctor :fn fid :args (call-args f [] {:scope (:scope f)})}))))))

(defn- materialize
  "A prvalue of class type as a temporary object (an xvalue)."
  [e]
  {:op :temp :init {:i :expr :e e} :ty (:ty e) :cat :xv})

(declare aggregate?)

(defn- aggr-subs
  "The types an aggregate's elements have, in order (an array of unknown bound: as many as `n`)."
  [u n]
  (cond
    (abi/arr? u) (repeat (or (:n u) n) (:of u))
    :else (let [c (abi/cls (:id u))
                subs (concat (map (fn [b] {:k :class :id (:cls b)}) (:bases c))
                             (map :ty (remove #(and (:bits %) (nil? (:name %))) (:fields c))))]
            (if (:union c) (take 1 subs) subs))))

(declare elide-agg)

(defn- elide-sub
  "One element of type `st` initialized from the flat items `items` ([dcl.init.aggr]/16, brace elision): a braced
  item, an item that initializes it whole, or as many items as a subaggregate takes. [item rest]."
  [st items]
  (let [it (first items) u (abi/unq st)]
    (cond
      (#{:init-list :default-init :value-init} (:op it)) [it (rest items)]
      (and (or (abi/arr? u) (and (abi/class? u) (aggregate? u)))
           (not (and (abi/class? u) (let [k (class-id (:ty it))] (or (= k (:id u)) (and k (abi/derived-from? k (:id u)))))))
           (not (and (abi/arr? u) (= :str (:op it)))))
      (let [[sub r] (elide-agg u items)] [{:op :init-list :items sub} r])
      :else [it (rest items)])))

(defn- elide-agg [u items]
  (loop [ts (aggr-subs u (count items)) items items out []]
    (if (or (empty? ts) (empty? items))
      [out items]
      (let [[x r] (elide-sub (first ts) items)] (recur (rest ts) r (conj out x))))))

;; (cpp-singles, the checker: [dcl.init.aggr]/16, an array's element of an aggregate class with no element (no base, no named
;; non-static data member) from an expression of a type that is no class: no implicit conversion makes the element from it, so
;; its braces are elided and the class takes no item, the expression left over; GCC's "initializer for 's' must be
;; brace-enclosed" at the list's closing brace, init/ptrfn2.C's `s array[] = { (fptr1)0 };`)
(defn- cx-empty-agg-elide!
  [el items src]
  (let [u (abi/unq el)]
    (when (and (checking?) (abi/class? u) (:list-end src) (aggregate? u) (empty? (aggr-subs u 0)))
      (when-let [x (some #(when (and (map? %) (not (#{:init-list :default-init :value-init} (:op %))) (:ty %)
                                     (not (abi/class? (abi/unq (abi/non-ref (:ty %))))) (not= :init-list (:k (:ty %))))
                            %)
                         items)]
        (throw (ex-info (str "codegen: initializer for '" (:name (abi/cls (:id u))) "' must be brace-enclosed")
                        {:codegen/refused :init :cx/node {:range {:begin (:list-end src) :end (:list-end src)}}}))))))

(defn- brace-elide
  "The braced list `src` for the aggregate `u` with its elided braces restored (fully braced), when some are elided."
  [u src]
  (let [items (:items src)
        one (when (= 1 (count items)) (first items))
        ;; (the native parser's semantic form braces a lone item of the class's own type as if it were elided:
        ;; {{o.a}} for a{o.a}, unwrapped: [dcl.init.list]/3.2 copies it)
        items (if (and one (= :init-list (:op one)) (= 1 (count (:items one))) (abi/class? u)
                       (= (class-id (:ty (first (:items one)))) (:id u)))
                (:items one) items)
        src (assoc src :items items)]
    (if (and (= 1 (count items)) (abi/class? u) (= (class-id (:ty (first items))) (:id u)))
      src
      (let [[out r] (elide-agg u items)]
        (if (seq r) src (assoc src :items out))))))


(def ^:dynamic *nsdmi-active* #{})

(defn- nsdmi-guard
  "cpp-decl2: the analysis `f` of class `cid`'s field `fl`'s default member initializer, which its own analysis needs again
  (`int i = sizeof(A{});` in A: A{} uses i's initializer, CWG 1397): in the checker GCC's \"default member initializer for
  'A::i' required before the end of its enclosing class\", the code generator's refusal; not a recursion without end."
  [cid fl f]
  (let [k [cid (:i fl)]]
    (if (contains? *nsdmi-active* k)
      (let [e (ex-info (str "codegen: default member initializer for '" (:name (abi/cls cid)) "::" (:name fl) "' required before the end of its enclosing class")
                       (cond-> {:codegen/refused :nsdmi} (:node fl) (assoc :cx/node (:node fl))))]
        ;; (reported here, once, the refusal unwinding the analyses that asked it)
        (when (and (checking?) *on-refusal* (:node fl)) (*on-refusal* e (:node fl)))
        (throw (ex-info (.getMessage e) (assoc (ex-data e) :cx/reported true))))
      (binding [*nsdmi-active* (conj *nsdmi-active* k)] (f)))))

(defn- cx-string-fits!
  "cpp-diag-b (2026-11-22): [dcl.init.string]/2, no more initializers than the array has elements, the string literal's
  terminating null among them: GCC's \"initializer-string for 'char [4]' is too long\"."
  [e tu]
  (when (and (checking?) (:n tu) (= :arr (:k (abi/unq (:ty e)))) (:n (abi/unq (:ty e)))
             (> (long (:n (abi/unq (:ty e)))) (long (:n tu))))
    (fail :string-long "initializer-string for an array of " (:n tu) " elements is too long")))

(defn init-for
  "The initializer of an object of type `t` from `src`: nil (none), a typed expression, an init-list node
  {:op :init-list :items [...]}, or a vector of constructor arguments (direct-initialization); `style` :copy :direct
  :list :value :default."
  [t src ctx style]
  (let [tu (abi/unq t)]
    (cond
      ;; a semantic list's value-initialized element (the native parser's ImplicitValueInitExpr fill, [dcl.init.aggr]/5.2)
      (= :value-init (:op src)) (init-for t nil ctx :value)
      (and (= :init-list (:op src)) (init-list-elem t))
      (let [a (narrow-list-check! (or (std-init-list t src ctx) (fail :init "a list's element does not convert to the initializer_list's")) src)]
        (if (abi/ref? t) {:i :bind-temp :init {:i :expr :e a} :ty (:ty a)} {:i :expr :e a}))
      ;; [dcl.init.list]/3.10: a list for a reference that is not a single element of a reference-related type: a prvalue of
      ;; the referenced type copy-list-initialized from it, the reference bound to the temporary (a const lvalue or an
      ;; rvalue reference; libstdc++'s __do_is_implicitly_default_constructible_impl, __helper<const _Tp&>({}), which
      ;; std::pair's C++17 default constructor's condition asks)
      (and (abi/ref? t) (= :init-list (:op src))
           (not (and (= 1 (count (:items src))) (not= :init-list (:op (first (:items src))))
                     (let [at (:ty (first (:items src))) pt (:to t)]
                       (or (= (arr-unq at) (arr-unq pt))
                           (and (class-id at) (class-id pt) (abi/derived-from? (class-id at) (class-id pt))))))))
      (do (when-not (or (:c (:to t)) (= :rref (:k t))) (fail :init "a non-const reference to a list's temporary"))
          {:i :bind-temp :init (init-for (abi/unq (:to t)) src ctx :list) :ty (abi/unq (:to t))})
      (abi/ref? t)
      (let [e (if (= :init-list (:op src)) (if (= 1 (count (:items src))) (first (:items src)) (fail :init "a list for a reference")) src)
            e (if (vector? e) (if (= 1 (count e)) (first e) (fail :init "a reference from arguments")) e)
            pt (:to t)
            at (:ty e)
            same (= (arr-unq at) (arr-unq pt))
            ;; (cpp-rind, the checker: [dcl.init.ref]/4 with [conv.qual]/3 (DR 330), an array type reference-compatible with
            ;; another whose pointer converts to a pointer to it by a qualification conversion, `const int *const (&r)[4] = ar;`
            ;; for `int *ar[4]`: bound directly; it had bound a temporary and refused the non-const array reference, a false
            ;; error: conversion/ref2.C)
            same (or same (and (checking?) (abi/arr? (abi/unq at)) (abi/arr? (abi/unq pt)) (not= (arr-unq at) (arr-unq pt))
                               (some? (cx-qual-levels at)) (some? (cx-qual-levels pt))
                               (nil? (cx-array-qual-bad? (abi/ptr at) (abi/ptr pt)))))
            derived (and (class-id at) (class-id pt) (abi/derived-from? (class-id at) (class-id pt)))]
        (cond
          ;; (cpp-s14: a reference to function bound to a function named by an overload set, [dcl.init.ref]/5.1 with
          ;; [over.over]: `int (&f)(int) = twice;`, a conversion function template's `return twice;`)
          (and (= :fnset (:op e)) (abi/fn? (abi/unq pt)))
          (if-let [f (fn-matching e (abi/unq pt))]
            {:i :bind :e {:op :deref :e {:op :fnaddr :fn f :ty (abi/ptr (:ty (fnd f))) :cat :pr} :ty (:ty (fnd f)) :cat :lv}}
            (fail :init "no function of the set matches the reference"))
          (and (lv? e) (or same derived) (or (= :lv (:cat e)) (= :rref (:k t)) (:c pt))
               (or (not= :rref (:k t)) (not= :lv (:cat e))))
          {:i :bind :e (if derived {:op :base-lv :e e :to (class-id pt) :ty (assoc (abi/unq pt) :c (:c at)) :cat (:cat e)} e)}
          (and (= :pr (:cat e)) (or same derived) (abi/class? (abi/unq at)))
          (do ;; (cpp-diag-b, 2026-11-22: [dcl.init.ref]/5.4, an lvalue reference binds an rvalue only when it is to a const
              ;; non-volatile type: GCC's "cannot bind non-const lvalue reference of type 'bar&' to an rvalue of type 'bar'")
              (when (and (checking?) (= :ref (:k t)) (or (not (:c pt)) (:v pt)))
                (fail :init "a non-const reference to a temporary"))
              {:i :bind-temp :init {:i :expr :e e} :ty (abi/unq at) :to (when derived (class-id pt))})
          ;; (cpp-s14: bound directly to a conversion function's lvalue (an lvalue reference) or xvalue (an rvalue
          ;; reference), [dcl.init.ref]/5.1.2, /5.3.2 with [over.match.ref]; a conversion function template's
          ;; specialization deduced for the reference, [temp.deduct.conv]/4, CP389 (a))
          (and (class-id at) (not (or same derived)) (ref-conv-for (class-id at) t (:c at)))
          (let [fid (ref-conv-for (class-id at) t (:c at))
                _ (when (= :ambiguous fid) (fail :init "reference initialization is ambiguous (two conversion functions bind it, neither better)"))
                c (method-call ctx fid (if (= :pr (:cat e)) (materialize e) e) [] true)
                rt (:ty c)
                d (not= (class-id rt) (class-id pt))]
            {:i :bind :e (if (and d (class-id pt)) {:op :base-lv :e c :to (class-id pt) :ty (assoc (abi/unq pt) :c (:c rt)) :cat (:cat c)} c)})
          (or (and (:c pt) (not (and (checking?) (:v pt)))) (= :rref (:k t)))
          {:i :bind-temp :init (if (and (checking?) (vector? src) (>= (long *cxx-year*) 20) (abi/class? (abi/unq pt)) (aggregate? (abi/unq pt))
                                        (not (class-id at)))
                                 ;; (cpp-decl2, the checker: a reference direct-initialized by a parenthesized expression of
                                 ;; another type binds a temporary of an aggregate class initialized from it as C++20's
                                 ;; parenthesized aggregate initialization ([dcl.init.general]/16.6.2.2), as g++ 15.2 does:
                                 ;; cpp2a/paren-init23.C's `const S& s(1);` accepted)
                                 (init-for (abi/unq pt) src ctx :direct)
                                 (init-for (abi/unq pt) e ctx :copy))
           :ty (abi/unq pt)}
          :else (fail :init "a non-const reference to a temporary")))
      (vector? src)
      (cond
        (abi/class? tu) (class-init tu src ctx (if (and (empty? src) (= style :value)) :value :direct))
        (empty? src) {:i :zero}
        (= 1 (count src)) (init-for t (first src) ctx :direct)
        :else (fail :init "several values for a scalar"))
      (nil? src)
      (cond
        ;; (queue 463, the checker: default-initialization's constructor, its access as class-init's, [dcl.init.general]/7.1)
        (abi/class? tu) (cx-ctor-access! ctx (default-ctor-init (:id tu) (= style :value)))
        (abi/arr? tu) (let [el (init-for (:of tu) nil ctx style)] (if (#{:none :zero} (:i el)) el {:i :list :items [] :fill el :n (:n tu)}))
        (= style :value) {:i :zero}
        :else {:i :none})
      ;; a complex object from a list of its real and imaginary parts (cpp-s3: complex(long double __r, long double __i) :
      ;; _M_value{ __r, __i }; GCC's extension, [dcl.init.list] taking it as an aggregate of two)
      ;; a GNU vector from a list of its lanes (n-cpp-eval; GCC's vector initializer, the lanes not written zero)
      (and (= :init-list (:op src)) (= :vec (:k tu)))
      (let [items (:items src) et (:of tu)]
        (when (> (count items) (long (:n tu))) (fail :init "too many initializers for a vector"))
        (when (some #(or (= :init-list (:op %)) (not (abi/arith? (abi/unq (:ty %))))) items) (fail :init "a vector's lane from a non-arithmetic value"))
        {:i :vec :items (mapv #(convert-scalar (rv %) et false) items)})
      (and (= :init-list (:op src)) (= :complex (:k tu)))
      (let [items (:items src) et (:of tu)]
        (when (> (count items) 2) (fail :init "too many initializers for a complex"))
        {:i :complex :items (mapv #(convert-scalar (rv %) et false) items)})
      (= :init-list (:op src))
      (cond
        (abi/arr? tu)
        (let [items (:items (brace-elide tu src))
              el (:of tu)
              ;; (cpp-diag-b, 2026-11-22: C++98's [dcl.init.aggr]/? takes a scalar element from an expression: braces around one are
              ;; GCC's "braces around scalar initializer"; C++11's list-initialization takes them, [dcl.init.list]/3.9)
              _ (when (and (checking?) (< (long *cxx-year*) 11) (abi/scalar? (abi/unq el)) (some #(= :init-list (:op %)) items))
                  (fail :scalar-braces "braces around scalar initializer"))
              _ (cx-empty-agg-elide! el items src)]
          (if (and (= 1 (count items)) (= :str (:op (first items))) (#{:char :schar :uchar :char8 :wchar :char16 :char32} (abi/bn (abi/unq el))))
            (do (cx-string-fits! (first items) tu) {:i :string :e (first items) :n (:n tu)})
            ;; (the elements not written value-initialized: analyzed only when there are some, [dcl.init.aggr]/5)
            ;; (cpp-decl2, the checker: each element's error at the element, the others analyzed on, as GCC reports each:
            ;; diagnostic/array-init1.C; when the list's elements are its items, :item-nodes)
            (let [nodes (when (and (checking?) *on-refusal* (= (count items) (count (:items src)) (count (:item-nodes src)))
                                   (every? true? (map identical? items (:items src))))
                          (:item-nodes src))
                  one (fn [i x] (cond-> (init-for el x ctx :copy) (not (:paren src)) (narrow-check! el x)))]
              {:i :list
               :items (if nodes
                        (vec (map-indexed (fn [i x]
                                            (try (one i x)
                                                 (catch arbace.lang.ExceptionInfo e
                                                   (if (and (:codegen/refused (ex-data e)) (not (:cpp/timeout (ex-data e))) (map? (nth nodes i)) (:range (nth nodes i)))
                                                     (do (*on-refusal* e (nth nodes i)) {:i :none})
                                                     (throw e)))))
                                          items))
                        (vec (map-indexed one items)))
               ;; (queue 569: a VLA's elements past the list's value-initialized too, its bound known when it is evaluated)
               :fill (when (or (and (:n tu) (< (count items) (long (:n tu)))) (:vla tu)) (init-for el nil ctx :value)) :n (:n tu)})))
        (and (abi/class? tu) (aggregate? tu))
        (let [c (abi/cls (:id tu))
              items (:items (brace-elide tu src))
              ;; a single item of the class's own type copies it ([dcl.init.list]/3.2)
              _ (when (seq (:bases c)) nil)
              subs (concat (map (fn [b] {:base true :ty {:k :class :id (:cls b)}}) (:bases c))
                           (map (fn [f] {:ty (:ty f) :field f}) (remove #(and (:bits %) (nil? (:name %))) (:fields c))))
              ;; (cpp-ce2: a union's designated member, the list's :field, [dcl.init.aggr]/5; else its first)
              ;; (cpp-ce2, the checker: an empty list for a union with a default member initializer initializes that member,
              ;; [dcl.init.aggr]/5.4 with [class.union.general]/? -- at most one variant member has one)
              nsdmi-u (when (and (checking?) (:union c) (empty? items)) (first (filter #(and (:field %) (:init (:field %))) subs)))
              subs (if (:union c)
                     (or (when-let [fname (:field src)] (seq (filter #(= fname (:name (:field %))) subs))) (when nsdmi-u [nsdmi-u]) (take 1 subs))
                     subs)]
          (cond
            (and (= 1 (count items)) (not= :init-list (:op (first items))) (= (class-id (:ty (first items))) (:id tu)))
            (class-init tu [(first items)] ctx :copy)
            (and (:union c) (empty? items) (not nsdmi-u)) {:i :zero}
            :else
            (do (when (> (count items) (count subs)) (fail :init "too many initializers"))
                {:i :list :cls (:id tu)
                 ;; (queue 460: a union's list takes its first member, a designator not read: the member's implicit
                 ;; conversion not judged)
                 :items (binding [*cx-union-init* (or *cx-union-init* (boolean (:union c)))] (vec (map-indexed (fn [i s]
                                            ;; (the native parser's semantic list holds a default member initializer's
                                            ;; place as CXXDefaultInitExpr, :default-init: the member's own initializer)
                                            (if (and (< i (count items)) (not= :default-init (:op (nth items i))))
                                              (cond-> (do ;; (cpp-diag-b: C++98's braced scalar member, as an array's element)
                                                          (when (and (checking?) (< (long *cxx-year*) 11) (abi/scalar? (abi/unq (:ty s)))
                                                                     (= :init-list (:op (nth items i))))
                                                            (fail :scalar-braces "braces around scalar initializer"))
                                                          (init-for (:ty s) (nth items i) ctx :copy))
                                                ;; (a union's: the member its designator names is not the one taken here)
                                                (not (or (:paren src) (:union c))) (narrow-check! (:ty s) (nth items i)))
                                              (if-let [d (or (:init (:field s))
                                                             ;; (cpp-diag-b, 2026-11-22: [dcl.init.aggr]/5.2, a reference member neither
                                                             ;; explicitly initialized nor with a default member initializer: GCC's
                                                             ;; "uninitialized reference member")
                                                             ;; (cpp-indep: at the list, not the last expression analyzed -- a member's
                                                             ;; default initializer before it, cpp1y/pr84593.C)
                                                             (when (and (checking?) (abi/ref? (:ty s)) (not (:union c)))
                                                               (throw (ex-info "codegen: uninitialized reference member"
                                                                               (cond-> {:codegen/refused :uninit-ref}
                                                                                 (:cx-at src) (assoc :cx/node {:range (:cx-at src)}))))))]
                                                ;; (its `this` the aggregate being initialized, [class.mem.general]/11; clang's
                                                ;; CXXDefaultInitExprScope: :agg-this, the code generator binds it to the object)
                                                (some-> (init-for (:ty s) (binding [*cutoff* Long/MAX_VALUE *cx-no-imm* true] (nsdmi-guard (:id tu) (:field s) #(analyze {:scope (:scope c) :cls (:id tu) :this-type (abi/ptr tu)} d))) ctx :copy)
                                                        (assoc :agg-this true)
                                                        ;; (cpp-ce3: the initializer's own range, ce-dmi-at)
                                                        (cond-> (and (checking?) (map? d) (:range d)) (assoc :dmi-range (:range d))))
                                                (init-for (:ty s) {:op :init-list :items []} ctx :value))))
                                          subs)))
                 :fields-used (mapv (comp :i :field) (remove :base subs))})))
        (abi/class? tu) (class-init tu [src] ctx :list)
        :else (case (count (:items src))
                0 {:i :zero}
                ;; ([dcl.init.list]/3.9: from the element, by direct-initialization for direct-list-initialization;
                ;; CP280 (a): an explicit conversion function is then a candidate, [over.match.conv]/1.1)
                1 (do ;; (cpp-diag-b, 2026-11-22: [dcl.init.list]/3.9, a scalar from a list's single element, an expression: a
                      ;; braced list there is GCC's "braces around scalar initializer")
                      (when (and (checking?) (= :init-list (:op (first (:items src)))) (abi/scalar? tu))
                        (fail :scalar-braces "braces around scalar initializer"))
                      (narrow-check! (init-for t (first (:items src)) ctx (if (= style :list) :direct :copy)) t (first (:items src))))
                (fail :init "several values for a scalar")))
      (abi/class? tu) (class-init tu [src] ctx style)
      (abi/arr? tu)
      (if (= :str (:op src)) (do (cx-string-fits! src tu) {:i :string :e src :n (:n tu)})
          (do ;; (cpp-diag-b, 2026-11-22: [dcl.init.general]/16.5, an array is initialized from a braced list or a string literal:
              ;; from an expression of no array type GCC's "array must be initialized with a brace-enclosed initializer"; an array's
              ;; copy, the implicit members' and captures', left to the code generator's refusal)
              (when (and (checking?) (not (abi/arr? (abi/unq (:ty src)))) (not (vector? src)) (some? (:ty src)))
                (fail :array-init "array must be initialized with a brace-enclosed initializer"))
              (fail :init "an array from an expression")))
      :else
      (let [e (rv src)
            ft (abi/unq (:ty e))]
        ;; (CX12, the checker: no implicit conversion yields an enumeration, [conv.integral]/1 converts from one, so an
        ;; enumeration is initialized from its own type alone: from another scoped enumeration in any initialization (an
        ;; unscoped one converts to the underlying type a direct-list-initialization of a fixed enumeration takes,
        ;; [dcl.init.list]/3.8), from any other arithmetic type in copy-initialization; clang's err_init_conversion_failed)
        (when (and (checking?) (abi/enum? tu) (not= ft tu) (not (abi/class? ft))
                   (or (and (abi/enum? ft) (:scoped (abi/enm (:id ft))))
                       (and (= style :copy) (or (abi/enum? ft) (abi/arith? ft)))))
          (fail :conversion "cannot initialize a variable of type '" (:name (abi/enm (:id tu))) "' with a value of another type"))
        ;; (queue 460: an implicit conversion no standard conversion makes, the checker's)
        (when-not (abi/class? ft) (cx-implicit-scalar! e tu style))
        ;; (direct-initialization: the explicit conversion functions too, [over.match.conv]/1.1; CP280 (a))
        {:i :expr :e (convert-scalar (if (abi/class? (abi/unq (:ty e))) (user-conv ctx e tu (= style :direct)) e) tu false)}))))

;; ---------------------------------------------------------------------------------------------
;; Analysis of expressions

(defn- int-type-of [^String qt] (case qt "int" abi/int* "unsigned int" abi/uint* "long" abi/long* "unsigned long" abi/ulong*
                                  "long long" (abi/b :llong) "unsigned long long" (abi/b :ullong) "char" abi/char* "bool" abi/bool* abi/int*))

(defn decode-string
  "The bytes of a string literal as clang prints it (\"...\" with C escapes, octal for the others)."
  ^String [^String s]
  (let [s (subs s (inc (.indexOf s "\"")) (.lastIndexOf s "\""))
        sb (StringBuilder.)]
    (loop [i 0]
      (when (< i (count s))
        (let [c (.charAt s i)]
          (if (= c \\)
            (let [d (.charAt s (inc i))]
              (cond
                (Character/isDigit d) (let [j (loop [j (inc i) k 0] (if (and (< j (count s)) (< k 3) (Character/isDigit (.charAt s j))) (recur (inc j) (inc k)) j))]
                                        (.append sb (char (Integer/parseInt (subs s (inc i) j) 8))) (recur j))
                (= d \x) (let [j (loop [j (+ i 2)] (if (and (< j (count s)) (re-matches #"[0-9a-fA-F]" (str (.charAt s j)))) (recur (inc j)) j))]
                           (.append sb (char (Integer/parseInt (subs s (+ i 2) j) 16))) (recur j))
                :else (do (.append sb (case d \n \newline \t \tab \r \return \a (char 7) \b (char 8) \f (char 12) \v (char 11) \0 (char 0) d))
                          (recur (+ i 2)))))
            (do (.append sb c) (recur (inc i)))))))
    (str sb)))

(defn- wide-units
  "The code units of a wide or Unicode string literal as clang prints it (L\"...\", u\"...\", U\"...\": each unit a
  printable character or an escape, \\Uxxxxxxxx for the others, cpp-s12, CP382 (a))."
  [^String s]
  (let [s (subs s (inc (.indexOf s "\"")) (.lastIndexOf s "\""))
        n (count s) hex? #(re-matches #"[0-9a-fA-F]" (str %))]
    (loop [i 0 out []]
      (if (>= i n)
        out
        (let [c (.charAt s i)]
          (if (= c \\)
            (let [d (.charAt s (inc i))]
              (cond
                (#{\u \U} d) (let [j (+ i 2 (if (= d \u) 4 8))] (recur j (conj out (Long/parseLong (subs s (+ i 2) j) 16))))
                (= d \x) (let [j (loop [j (+ i 2)] (if (and (< j n) (hex? (.charAt s j))) (recur (inc j)) j))]
                           (recur j (conj out (Long/parseLong (subs s (+ i 2) j) 16))))
                (Character/isDigit d) (let [j (loop [j (inc i) k 0] (if (and (< j n) (< k 3) (Character/isDigit (.charAt s j))) (recur (inc j) (inc k)) j))]
                                        (recur j (conj out (Long/parseLong (subs s (inc i) j) 8))))
                :else (recur (+ i 2) (conj out (long (int (case d \n \newline \t \tab \r \return \a (char 7) \b (char 8) \f (char 12) \v (char 11) d)))))))
            (recur (inc i) (conj out (long (int c))))))))))

(defn str-units
  "A string literal node's code units, without the terminating zero."
  [a]
  (or (:units a) (mapv #(long (int %)) (:s a))))

(declare capture-field)

(defn- this-expr [ctx]
  (if (:lambda ctx)
    (capture-field ctx :this)
    (let [tt (or (:this-type ctx) *constraint-this*
                 ;; (cpp-rt-own: a non-static member named in an unevaluated operand of a static member function, [expr.prim.id]/3:
                 ;; its type alone is read, floating_from_chars.cc's `static constexpr int guaranteed_capacity() { return
                 ;; sizeof(m_buf); }`, the parser's implicit this->m_buf typed by the function's class)
                 (when @#'*unevaluated*
                   (when-let [c (or (some-> (:fn-id ctx) fnd :cls)
                                    ;; (a decltype's operand, analyzed in its scope alone: the class the scope is in, memory_resource.cc's
                                    ;; `numeric_limits<decltype(_M_bytes)>::max()` in a static member function)
                                    (loop [s (:scope ctx)] (when s (or (:cls s) (recur (:parent s))))))]
                     (abi/ptr {:k :class :id c}))))]
      (when-not tt (fail :this "this outside a method"))
      {:op :this :ty tt :cat :pr})))

(defn- deref-node [e]
  (let [e (rv e)]
    (when-not (abi/ptr? (:ty e)) (fail :deref "* of a non-pointer"))
    {:op :deref :e e :ty (:to (:ty e)) :cat :lv}))

(defn- base-subobjects
  "The distinct base class subobjects of type `to` in class `from` ([class.mi]/4-6: the paths to it, those through a
  virtual base the same subobject past it), as their identities."
  [from to]
  ;; (each path's identity: the virtual base nearest `to` on it with the path below it, else the whole path)
  (letfn [(paths [c]
            (if (= c to)
              [[nil []]]
              (mapcat (fn [[i b]] (for [[v p] (paths (:cls b))]
                                    (cond v [v p] (:virtual b) [(:cls b) p] :else [nil (cons [c i] p)])))
                      (map-indexed vector (:bases (abi/cls c))))))]
    (set (paths from))))

(defn- cx-naming-class
  "CX12 (the checker): the class a qualified name's nested-name-specifier names (B of B::f), or nil."
  [ctx n]
  (when (and (checking?) (seq (:qualifier n)))
    (try (class-id (:ty (first (filter #(= :type (:e %)) (lookup-qualified (:scope ctx) (vec (:qualifier n)))))))
         (catch arbace.lang.ExceptionInfo _ nil))))

(defn- cx-mptr-base!
  "cpp-diag-b, round 2 (the checker): [conv.mem]/2 and [expr.static.cast]/12: a pointer to member of a base `b` and one of its derived
  class `d` convert into one another only when `b` is an unambiguous non-virtual base of `d`, accessible (not for a C-style cast,
  [expr.cast]/4): GCC's \"pointer to member conversion via virtual base 'V'\", \"'A' is an ambiguous base of 'D'\", \"'P' is an
  inaccessible base of 'D'\"."
  [d b check-access?]
  (let [d (if (map? d) (:id d) d) b (if (map? b) (:id b) b)]
  (when (and (checking?) d b (not= d b) (abi/cls d) (abi/cls b) (abi/derived-from? d b))
    (let [subs (base-subobjects d b)]
      (cond
        (> (count subs) 1) (fail :mptr-base "'" (:name (abi/cls b)) "' is an ambiguous base of '" (:name (abi/cls d)) "'")
        (some? (nth (abi/base-path d b) 2)) (fail :mptr-base "pointer to member conversion via virtual base '" (:name (abi/cls b)) "'")
        check-access?
        (let [steps (first (abi/base-path d b))]
          (when (some (fn [[c i]] (not= :public (:access (nth (:bases (abi/cls c)) i)))) steps)
            (fail :mptr-base "'" (:name (abi/cls b)) "' is an inaccessible base of '" (:name (abi/cls d)) "'")))
        :else nil)))))

(defn- to-base-lv
  "The glvalue `obj` of a derived class seen as its base `bid`."
  [obj bid]
  ;; (CX12, the checker: a base class two subobjects of which the class holds is an ambiguous conversion, [conv.ptr]/3,
  ;; [class.member.lookup]; clang's err_ambiguous_derived_to_base_conv)
  (when (and (checking?) (class-id (:ty obj)) (not= (class-id (:ty obj)) bid)
             (> (count (base-subobjects (class-id (:ty obj)) bid)) 1))
    (fail :conversion "ambiguous conversion from derived class '" (:name (abi/cls (class-id (:ty obj)))) "' to base class '" (:name (abi/cls bid)) "'"))
  (if (= (class-id (:ty obj)) bid) obj {:op :base-lv :e obj :to bid :ty (assoc {:k :class :id bid} :c (:c (:ty obj))) :cat (:cat obj)}))

(defn- subobject-lv
  "Queue 518: the glvalue `obj` seen as its direct base or virtual base `bid` itself, a subobject its class names, no conversion
  ([class.base.init]/13, [class.copy.ctor]/14, [class.copy.assign]/12: an implicit special member's or a defaulted comparison's
  bases), so not judged ambiguous as to-base-lv's conversion is: `struct BB : B1, B2` with B a virtual base of B1 and a base of
  B2, lookup/ambig1.C, whose class had been refused whole at its implicit copy constructor."
  [obj bid]
  (if (= (class-id (:ty obj)) bid) obj {:op :base-lv :e obj :to bid :ty (assoc {:k :class :id bid} :c (:c (:ty obj))) :cat (:cat obj)}))

(defn- cx-via
  "CX12 (the checker): the object glvalue seen first as the naming class `qc` of a qualified member when that is a proper
  base of its class ([class.access.base]/6, [class.member.lookup]: the member's subobject is the naming class's), so the
  conversion to the member's class is judged from there."
  [obj qc]
  (let [oc (class-id (:ty obj))]
    (if (and (checking?) qc oc (not= qc oc) (abi/derived-from? oc qc) (= 1 (count (base-subobjects oc qc))))
      {:op :base-lv :e obj :to qc :ty (assoc {:k :class :id qc} :c (:c (:ty obj))) :cat (:cat obj)}
      obj)))

(defn- field-node [obj cid i]
  (let [f (nth (:fields (abi/cls cid)) i)
        o (to-base-lv obj cid)
        ft (:ty f)]
    (if (abi/ref? ft)
      {:op :deref :e {:op :load :e {:op :field :obj o :cls cid :i i :ty abi/void :cat :lv :raw true} :ty (abi/ptr (:to ft)) :cat :pr} :ty (:to ft) :cat :lv}
      {:op :field :obj o :cls cid :i i :ty (cond-> ft (and (:c (:ty obj)) (not (:mutable f))) (assoc :c true)) :cat (if (= :lv (:cat obj)) :lv :xv)})))

(declare has-auto? global-init)

(defn- var-node [id]
  (let [v (var* id)
        ;; (queue 393: a static data member or namespace-scope variable declared `auto` whose initializer was not analyzed
        ;; yet, an inline static constexpr member's, `static constexpr auto f = []() {...};`: its type deduced at this use,
        ;; [dcl.spec.auto.general]/11; g++.dg's coroutines/torture/pr95519-01-initial-suspend.C's promise's initial_suspend)
        ;; (the checker's analysis as before: its dg records were made without it)
        v (if (and (not (checking?)) (has-auto? (:ty v)) (:init v) (#{:member-static :global} (:storage v)) (not (:ginit v)))
            (do (upd-var! id assoc :ginit (global-init id)) (var* id))
            v)
        t (:ty v)]
    (if (abi/ref? t)
      {:op :deref :e {:op :load :e {:op :var :id id :ty t :cat :lv :raw true} :ty (abi/ptr (:to t)) :cat :pr} :ty (:to t) :cat :lv}
      {:op :var :id id :ty t :cat :lv})))

(def ^:dynamic *unevaluated*
  "CP304 (a): true while an unevaluated operand is analyzed (sizeof's, alignof's, noexcept's): an enclosing function's
  variable named there is not odr-used, so a lambda does not capture it ([expr.prim.lambda.capture]/7-8); only its type is
  read."
  false)

(declare check-access!)

(defn- entity-expr [ctx es n]
  (let [;; (cpp-rt-own: a class name and a function or variable of the same name found together -- a using-declaration names
        ;; both, ops-common.h's `using ::stat;` in std::filesystem::__gnu_posix -- in an expression the class is hidden,
        ;; [basic.scope.hiding]/2, the `struct stat` rule: fs_ops.cc's `posix::stat(from.c_str(), &from_st)`)
        es (if (and (= :type (:e (first es))) (some #(or (#{:fn :var} (:e %)) (and (= :tmpl (:e %)) (#{:fn :var} (:tk %)))) es)) (vec (remove #(= :type (:e %)) es)) es)
        e (first es)]
    (case (if (empty? es) :fn (:e e))
      :var (let [v (var* (:id e))]
             ;; (queue 463, the checker: a static data member named by an id-expression, its access through the naming class:
             ;; the qualifier's, else the function's class it is looked up from, [class.access.base]/5)
             (when (and (checking?) (:cx-access v))
               (cx-static-access! ctx (:cx-cls v) (:name v) (:cx-access v) (or (cx-naming-class ctx n) (some-> (:fn-id ctx) fnd :cls))))
             (if (and (:lambda ctx) (#{:local :param} (:storage v)) (not= (:fn v) (:fn-id ctx)) (not *unevaluated*))
               (capture-field ctx (:id e))
               (var-node (:id e))))
      ;; a structured binding of an array's element or a data member: the subobject's expression (decomposition!)
      :binding (if (and (:lambda ctx) (not= (:fn e) (:fn-id ctx)))
                 (fail :decl "a structured binding captured by a lambda")
                 (:expr e))
      :capfield (field-node (deref-node {:op :this :ty (:this-type ctx) :cat :pr}) (:cls (:lambda ctx)) (:i e))
      :field (let [tc (some-> (:fn-id ctx) fnd :cls)]
               ;; (cpp-rind, the checker: [expr.prim.id.general]/3 (C++23 /4), a non-static data member named outside an
               ;; unevaluated operand only in a member function of its class or of a class derived from it (its implicit this):
               ;; in a free function, a static member function or an unrelated class's member function GCC's "invalid use of
               ;; non-static data member 'A::i'"; lambdas and contexts with no function (a default member initializer) not
               ;; judged; lookup/scoped8.C)
               (when (and (checking?) (not *unevaluated*) (:fn-id ctx) (not (:lambda ctx)) (not (:this-type ctx))
                          (let [f (fnd (:fn-id ctx))] (and f (not (:lambda (some-> (:cls f) abi/cls))))))
                 (fail :member-use "invalid use of non-static data member '" (get-in n [:referencedDecl :name]) "'"))
               (when (and (checking?) (not *unevaluated*) tc (:this-type ctx) (not (:lambda ctx)) (not (:lambda (abi/cls tc)))
                          (not= tc (:cls e)) (not (abi/derived-from? tc (:cls e))))
                 (fail :member-use "invalid use of non-static data member '" (get-in n [:referencedDecl :name]) "'"))
               ;; (the rest of CP313 (a): a member named in a member function, its access through the naming class)
               (when (and (checking?) tc (not (:lambda ctx)))
                 (check-access! ctx (:cls e) (get-in n [:referencedDecl :name]) (:access (nth (:fields (abi/cls (:cls e))) (:i e)))
                                (or (cx-naming-class ctx n) tc) tc))
               (field-node (cx-via (deref-node (this-expr ctx)) (cx-naming-class ctx n)) (:cls e) (:i e)))
      :indirect (reduce (fn [o [c i]] (field-node o c i)) (cx-via (deref-node (this-expr ctx)) (cx-naming-class ctx n)) (:chain e))
      :enumerator (do ;; (queue 492, the checker: an enumerator of a private or protected member enumeration, unscoped, a member
                      ;; of the class with the enumeration's access, [class.access]/1, [dcl.enum]/11)
                      (when (and (checking?) (:cx-access e) (not (:ucls e)))
                        (cx-static-access! ctx (:cx-cls e) (get-in n [:referencedDecl :name]) (:cx-access e)
                                           (or (cx-naming-class ctx n) (some-> (:fn-id ctx) fnd :cls))))
                      (when (:ucls e)
                        ;; (the rest of CP313 (a): an enumerator a class's using-declaration names, its access there; the naming
                        ;; class the qualifier's, else the class the name is looked up from when derived from it)
                        (let [nc (or (cx-naming-class ctx n) (:cls (:scope ctx)) (some-> (:fn-id ctx) fnd :cls))]
                          (cx-access! ctx (:ucls e) (get-in n [:referencedDecl :name]) (:uaccess e) nc nil)))
                      {:op :int :v (:val e) :ty (:ty e) :cat :pr})
      ;; a pointer or reference non-type template parameter bound to a function or a variable (CODEGEN.md G3)
      :declconst (let [[k id] (:decl e) t (:ty e)]
                   (cond
                     (:null e) {:op :null :ty t :cat :pr}
                     (abi/ref? t) (if (= k :var) (var-node id) (fail :template "a reference to a function as an argument"))
                     (= k :fn) {:op :fnaddr :fn id :ty t :cat :pr}
                     :else {:op :addr :e (var-node id) :ty t :cat :pr}))
      (:fn :tmpl) (cond
                    (and (= :tmpl (:e e)) (= :concept (:tk e)))
                    {:op :int :v (long ((:concept-id @hooks) ctx e n)) :ty abi/bool* :cat :pr}
                    :else
                  (if (and (= :tmpl (:e e)) (= :var (:tk e)))
                    (if-let [h (:var-template @hooks)] (var-node (h ctx e n)) (fail :template "a variable template"))
                    (cond-> {:op :fnset :fns (mapv :id (filter #(= :fn (:e %)) es)) :tmpls (mapv :id (filter #(and (= :tmpl (:e %)) (= :fn (:tk %))) es))
                             :name (get-in n [:referencedDecl :name]) :ty {:k :overload} :cat :lv :implicit-this true}
                      (cx-naming-class ctx n) (assoc :cx-qcls (cx-naming-class ctx n))
                      ;; (the rest of CP313 (a): a member function named in a member function, judged at the call)
                      (and (checking?) (some-> (:fn-id ctx) fnd :cls) (not (:lambda ctx)))
                      (assoc :member-access true :cx-nc (or (cx-naming-class ctx n) (some-> (:fn-id ctx) fnd :cls)) :cx-obj (some-> (:fn-id ctx) fnd :cls)
                             :cx-using (cx-using-map es)))))
      (do
        ;; (queue 584, the checker: [temp.res.general]/3, a qualified name whose qualifier names a template's type parameter is
        ;; assumed to name no type outside a type-only context; an instantiation where it names one is ill-formed: GCC's
        ;; "dependent-name 'T::x' is parsed as a non-type, but instantiation yields a type"; cpp2a/typename3.C's `T::x * i;`)
        (when (and (checking?) (= :type (:e e)) (seq (:qualifier n)) (string? (first (:qualifier n)))
                   (loop [sc (:scope ctx)]
                     (cond (nil? sc) false
                           (seq (.get ^java.util.HashMap (:names sc) (first (:qualifier n)))) (= :tparams (:kind sc))
                           :else (recur (:parent sc)))))
          (fail :typename "dependent-name '" (str/join "::" (:qualifier n)) "::" (:name (:referencedDecl n)) "' is parsed as a non-type, but instantiation yields a type"))
        (fail :name "name " (:name (:referencedDecl n)) " of kind " (:e e))))))

(def ^:private implicit-alloc-fns
  ;; [basic.stc.dynamic.general]/2: the global allocation and deallocation functions implicitly declared in each translation
  ;; unit (those that name no std type; their mangled names _Znwm, _Znam, _ZdlPv, _ZdaPv, _ZdlPvm, _ZdaPvm)
  {"operator new" ["void *(unsigned long)" ["unsigned long"]]
   "operator new[]" ["void *(unsigned long)" ["unsigned long"]]
   "operator delete" [["void (void *) noexcept" ["void *"]] ["void (void *, unsigned long) noexcept" ["void *" "unsigned long"]]]
   "operator delete[]" [["void (void *) noexcept" ["void *"]] ["void (void *, unsigned long) noexcept" ["void *" "unsigned long"]]]})

(defn- implicit-alloc!
  "The implicit global declarations of the allocation or deallocation function `nm` entered in the root scope, the first
  time a name expression names one that no declaration (<new>'s) has declared (cpp-route: g++.dg's cpp0x/defaulted19a.C,
  ::operator new (t) without <new>)."
  [nm]
  (let [d (implicit-alloc-fns nm)
        ds (if (string? (first d)) [d] d)
        ;; (cpp-s3: those of the signatures no declaration has: a unit that declares only a placement form,
        ;; `void *operator new(size_t, void *)`, still has the implicit `operator new(size_t)`, pr77550.C)
        have (set (for [e (binding [*cutoff* Long/MAX_VALUE] (own-names *root* nm)) :when (= :fn (:e e))]
                    (mapv abi/unq (:ps (:ty (fnd (:id e)))))))]
    (.put ^java.util.HashMap (:names *root*) (str " implicit " nm) [])
    (doseq [[qt ps] ds :when (not (have (mapv #(abi/unq (resolve-type *root* %)) ps)))]
      (declare-fn! *root* {:kind "FunctionDecl" :name nm :type {:qualType qt}
                           :inner (mapv (fn [t] {:kind "ParmVarDecl" :type {:qualType t}}) ps)}))))

(defn- type-named-by
  "queue 380 (W3d): the type a name expression `n` names, when the native parser read a type's name as an expression
  because the name was not a type in its scope (a member type of the class an out-of-class member's definition names,
  `sizeof(_Rep_base)` in basic_string::_Rep::_S_max_size's initializer, `__wmask_type()` in ctype<wchar_t>'s member, a
  class's injected name): the first entity its lookup finds, when that is a type ([expr.type.conv], [expr.sizeof]); else nil.
  No name with explicit template arguments."
  [ctx n]
  (let [n (loop [k n] (if (and (map? k) (= "ParenExpr" (:kind k)) (= 1 (count (kids k)))) (recur (first (kids k))) k))]
    (when (and (map? n) (= "DeclRefExpr" (:kind n)) (not (:explicitTemplateArgs n)))
      (let [nm (get-in n [:referencedDecl :name]) [g q] (ref-qualifier n)
            es (when (and nm (not (written-targs n nm)))
                 (try (if (or g (seq q)) (lookup-qualified (:scope ctx) (conj q nm) g) (lookup (:scope ctx) nm))
                      (catch arbace.lang.ExceptionInfo e (if (:codegen/refused (ex-data e)) nil (throw e)))))]
        ;; (a type alone: a function or variable of the name, stat beside struct stat, is the call's)
        (when (and (seq es) (= :type (:e (first es))) (:ty (first es)) (not-any? #(#{:fn :var :tmpl} (:e %)) es)) (:ty (first es)))))))

(defn- name-expr [ctx n]
  (let [nm (get-in n [:referencedDecl :name])
        [g q] (ref-qualifier n)
        lk #(if (or g (seq q))
              (lookup-qualified (:scope ctx) (conj q nm) g)
              (lookup (:scope ctx) nm))
        es (lk)
        es (if (and (empty? q) (implicit-alloc-fns nm) (not (.containsKey ^java.util.HashMap (:names *root*) (str " implicit " nm))))
             (do (implicit-alloc! nm) (lk)) es)
        ;; class members found through a class's scope keep their class
        es (if (and (seq q) (seq es)) es es)]
    ;; (queue 492, the checker: an unqualified name no lookup finds, the parser's own lookup found nothing either (:_ent),
    ;; and no declaration of the unit has its name, so argument-dependent lookup cannot find it either, [basic.lookup.argdep]/4,
    ;; [temp.names]/3; GCC's "'x' was not declared in this scope", at the name)
    (when (and (checking?) (empty? es) (not g) (empty? q) (:_wn n) (nil? (:_ent n)) (cx-declared-nowhere? nm))
      (throw (ex-info (str "codegen: use of undeclared identifier '" nm "'") {:codegen/refused :undecl :cx/node n})))
    ;; nothing visible: a call's argument-dependent lookup may still find a function (template)
    (when (and (empty? es) (or g (seq q)))
      ;; (n-cpp-concepts: a qualified name a complete class without bases does not declare, T::is_pettable for a T bound to
      ;; such a class: said so, the constraints' sure substitution failure, sure-failure?)
      (let [qt (when (and (checking?) (seq q))
                 (try (:ty (first (filter #(= :type (:e %)) (lookup-qualified (:scope ctx) q g)))) (catch arbace.lang.ExceptionInfo _ nil)))
            cid (when qt (try (class-id qt) (catch arbace.lang.ExceptionInfo _ nil)))
            c (when cid (abi/cls cid))
            ;; (queue 484: an enumeration with its enumerators declared, scoped or not, names no other member,
            ;; [basic.lookup.qual]/1 with [dcl.enum]/2: `E::TURNUP`, lookup/suggestions-scoped-enums.C; g++'s "is not a member
            ;; of", clang's err_no_member)
            en (when (and (map? qt) (abi/enum? qt)) (abi/enm (:id qt)))]
        (cond
          (and c (:complete c) (not (:defining c)) (empty? (:bases c)) (not (dt-dependent? (:targs c))))
          (fail :name "unknown name " nm ": no member of the complete class " (:name c))
          ;; (queue 484: a qualifier naming a class not defined, [basic.lookup.qual]/1's complete-class requirement,
          ;; [expr.prim.id.qual]: `A::g()` with A only declared, expr/member-of-incomplete-type-1.C)
          (and c (cx-incomplete-cls qt))
          (fail :incomplete "incomplete type '" (:name c) "' used in nested name specifier")
          (and en (:name en) (pos? (.size ^java.util.HashMap (:names (:scope en)))))
          (fail :name "unknown name " nm ": no member of the complete class " (:name en))
          ;; (cpp-def2: an enumeration only opaque-declared -- no enumerator list before the name, and none anywhere a qualified
          ;; definition, `enum A<T>::E : T { ... }`, could give an instantiation -- has no enumerators, [dcl.enum]/3 with
          ;; [basic.lookup.qual]/1: `C<int>::E::e1`, GCC's "'e1' is not a member of 'C<int>::E'"; cpp0x/pr82401.C)
          (and en (:name en) (checking?) (not (:body en)) (zero? (.size ^java.util.HashMap (:names (:scope en))))
               (not (re-find (re-pattern (str "\\benum\\s+(?:class\\s+|struct\\s+)?[^;{}]*"
                                             (when-let [o (some-> (seq (butlast q)) last str (str/replace #"<.*$" "") str/trim not-empty)]
                                               (str "\\b" (java.util.regex.Pattern/quote o) "\\s*(?:<[^;{}]*>)?\\s*"))
                                             "::\\s*" (java.util.regex.Pattern/quote (str (:name en))) "\\b[^;]*\\{"))
                             (str *src*))))
          (fail :name "'" nm "' is not a member of '" (str/join "::" (conj (vec (butlast q)) (last q))) "'")
          ;; (queue 487: a namespace of the main file's that declares no such member, cx-ns-lacks?)
          (cx-ns-lacks? (:scope ctx) q g nm)
          (fail :name "'" nm "' is not a member of '" (last q) "'")
          :else (fail :name "unknown name " nm))))
    (let [e (entity-expr ctx es n)]
      ;; (an unqualified name that finds nothing, with explicit template arguments: argument-dependent lookup's templates
      ;; take them, [temp.names]/3's P0846; get<i>(e) of a structured binding, [dcl.struct.bind]/4)
      ;; (queue 514, the checker: a name finding functions that are no templates, written with template arguments (the tree's
      ;; own, :explicitTemplateArgs), keeps them: a template-id still, [temp.names]/3 with P0846, analyze-call's nontmpl)
      (if-let [tt (when (or (seq (:tmpls e)) (and (= :fnset (:op e)) (empty? (:fns e)) (empty? es))
                            (and (checking?) (= :fnset (:op e)) (seq (:fns e)) (:_wn n) (seq (:explicitTemplateArgs n))))
                    (written-targs n nm))]
        (assoc e :targs-text tt :targs-scope (:scope ctx))
        e))))

(defn- arith-binop [o l r]
  (let [l (rv l) r (rv r)
        lv (abi/unq (:ty l)) rv' (abi/unq (:ty r))]
    (if (and (checking?) (or (= :vec (:k lv)) (= :vec (:k rv'))))
      ;; (cpp-vec, 2026-11-25, the checker: the GCC manual's "Using Vector Instructions": an operator of two vectors of the same
      ;; type, or of a vector and a scalar converted to its element type, applies lane by lane, its type the vector's; the
      ;; checker types it, the constant evaluator does not evaluate it)
      (let [vt (if (= :vec (:k lv)) lv rv')]
        (when (and (= :vec (:k lv)) (= :vec (:k rv')) (not= (dissoc lv :c :v) (dissoc rv' :c :v)))
          (fail :type "arithmetic on two vectors of different types"))
        {:op :vec-binop :o o :l l :r r :ty (dissoc vt :c :v) :cat :pr})
      (let [ct (arith-common (:ty l) (:ty r))]
        {:op :binop :o o :l (convert-scalar l ct false) :r (convert-scalar r ct false) :ty ct :cat :pr}))))

(defn- to-bool [e]
  ;; (cpp-1123, the checker: a scoped enumeration has no implicit conversion to bool, so no contextual one, [conv.bool],
  ;; [dcl.enum]/10 with [conv]/4: GCC's "could not convert 'y' from 'Col' to 'bool'"; cpp0x/scoped_enum_examples.C)
  (when (and (checking?) (abi/enum? (abi/unq (:ty e))) (:scoped (abi/enm (:id (abi/unq (:ty e))))))
    (fail :conversion "cannot convert '" (:name (abi/enm (:id (abi/unq (:ty e))))) "' to 'bool' implicitly"))
  ;; (cpp-rind, the checker: a void expression has no conversion to bool, [conv]/1, [expr.type]: GCC's "could not convert
  ;; '<statement>' from 'void' to 'bool'", a statement expression ending in a statement or a throw-expression as a condition;
  ;; other/error19.C, other/error32.C)
  (when (and (checking?) (abi/void? (abi/unq (:ty e))) (#{:stmt-expr :throw} (:op e)))
    (fail :conversion "cannot convert void to 'bool' implicitly (could not convert '" (if (= :throw (:op e)) "<throw-expression>" "<statement>") "' from 'void' to 'bool')"))
  (if (abi/class? (abi/unq (:ty e)))
    (convert-scalar (user-conv {:scope *root*} e abi/bool* true) abi/bool* false)
    (convert-scalar (rv e) abi/bool* false)))

(declare operator-call analyze-call analyze-args rewritten-relational)

(defn- class->scalar
  "A class operand of a built-in operator by its conversion function (the one non-explicit, [over.built]'s candidates
  narrowed to it); another operand unchanged."
  [ctx e]
  (if (abi/class? (abi/unq (:ty e)))
    (let [fs (filter #(not (:explicit (fnd %))) (conv-fns (class-id (:ty e))))]
      (case (count fs)
        1 (user-conv ctx e (abi/unq (abi/non-ref (:ret (:ty (fnd (first fs)))))) false)
        0 e ; contextually converted later (&&, ||) or refused there
        (do ;; (cpp-decl2, the checker: conversion functions to one type declared in different classes, two bases', are
            ;; ranked by no rule -- their implicit object parameters differ, so constraints are not compared,
            ;; [over.match.best.general]/2.6 (CWG 2789) -- the operator's conversion ambiguous: GCC's "ambiguous overload for
            ;; 'operator=='", cpp2a/concepts-memfun4.C's S2<>{} == 5)
            (when (and (checking?) (empty? (conv-tmpls (class-id (:ty e))))
                       (= 1 (count (distinct (map #(abi/unq (abi/non-ref (:ret (:ty (fnd %))))) fs))))
                       (= (count fs) (count (distinct (map #(:cls (fnd %)) fs))))
                       (not (:header (abi/cls (class-id (:ty e))))))
              (fail :overload "ambiguous call (the operand's conversion functions of " (count fs) " base classes)"))
            (fail :conversion "a class operand with " (count fs) " conversion functions"))))
    e))

(defn- class-operand? [e] (or (abi/class? (abi/unq (:ty e))) (abi/enum? (abi/unq (:ty e)))))

(defn- ordering-type
  "std::strong_ordering, weak_ordering or partial_ordering (<compare>'s classes), or a refusal."
  [^String nm]
  (or (:ty (type-entity (try (lookup-qualified *root* ["std" nm] true) (catch arbace.lang.ExceptionInfo _ nil))))
      (fail :operator "<=> without <compare>")))

(defn- three-way
  "The built-in three-way comparison ([expr.spaceship]): the operands' common type, its category's class prvalue
  ({:op :cmp3}, the code generator's -1, 0, 1 or partial_ordering's unordered 2)."
  [l r]
  (let [a (rv l) b (rv r) lt (:ty a) rt (:ty b)]
    (cond
      (and (abi/arith? lt) (abi/arith? rt))
      (let [ct (arith-common lt rt)]
        {:op :cmp3 :l (convert-scalar a ct false) :r (convert-scalar b ct false) :ct ct
         :ty (ordering-type (if (abi/floating? ct) "partial_ordering" "strong_ordering")) :cat :pr})
      (and (abi/ptr? lt) (abi/ptr? rt)) {:op :cmp3 :l a :r (convert-scalar b lt false) :ct lt :ty (ordering-type "strong_ordering") :cat :pr}
      :else (fail :operator "<=> of " (pr-str lt) " and " (pr-str rt)))))

(defn- builtin-binop [o l r]
  (let [lt (:ty (rv l)) rt (:ty (rv r))]
    (case o
      "<=>" (three-way l r)
      ("+" "-")
      (cond
        (and (abi/ptr? lt) (abi/integral? rt)) {:op :ptradd :o o :p (rv l) :n (convert-scalar (rv r) abi/long* false) :ty lt :cat :pr}
        (and (= o "+") (abi/integral? lt) (abi/ptr? rt)) {:op :ptradd :o o :p (rv r) :n (convert-scalar (rv l) abi/long* false) :ty rt :cat :pr}
        ;; (cpp-diag-b, 2026-11-22: [expr.add]/1, pointer arithmetic on pointers to completely-defined object types, no
        ;; function's: GCC's "pointer to a function used in arithmetic", "invalid use of pointer to function in subtraction")
        (and (checking?) (or (and (abi/ptr? lt) (abi/fn? (abi/unq (:to lt)))) (and (abi/ptr? rt) (abi/fn? (abi/unq (:to rt))))))
        (fail :fn-arith "pointer to a function used in arithmetic")
        (and (= o "-") (abi/ptr? lt) (abi/ptr? rt)) {:op :ptrdiff :l (rv l) :r (rv r) :ty abi/long* :cat :pr}
        :else (arith-binop o l r))
      ("*" "/" "%" "&" "|" "^") (arith-binop o l r)
      ("<<" ">>") (let [l (rv l) pl (promote-type (:ty l))]
                    {:op :binop :o o :l (convert-scalar l pl false) :r (convert-scalar (rv r) pl false) :ty pl :cat :pr})
      ("<" ">" "<=" ">=" "==" "!=")
      (let [l (rv l) r (rv r)]
        ;; (cpp-diag-b, 2026-11-22: [expr.rel]/? since C++11 (CWG 1512), a relational operator's operands are no pointer and null
        ;; pointer constant, nor two null pointer constants one a std::nullptr_t: GCC's "ordered comparison of pointer with integer
        ;; zero")
        (when (and (checking?) (#{"<" ">" "<=" ">="} o) (>= (long *cxx-year*) 11)
                   (or (and (abi/ptr? lt) (null-constant? r)) (and (abi/ptr? rt) (null-constant? l))
                       (and (null-constant? l) (null-constant? r) (or (= :nullptr (abi/bn lt)) (= :nullptr (abi/bn rt))))))
          (fail :ordered-cmp "ordered comparison of pointer with integer zero"))
        ;; (cpp-diag-b, round 2: [expr.eq]/3 and [expr.rel]/3, two pointers compared through their composite pointer type
        ;; ([expr.type]/4): pointees the same up to cv-qualifiers, a class and its base, or one of them void (an object's); else
        ;; GCC's "comparison between distinct pointer types 'int*' and 'double*' lacks a cast")
        (when (and (checking?) (abi/ptr? lt) (abi/ptr? rt) (not (null-constant? l)) (not (null-constant? r)))
          (let [a (abi/unq (:to lt)) b (abi/unq (:to rt))
                bad (cond (or (abi/void? a) (abi/void? b)) (and (or (abi/fn? a) (abi/fn? b)) false)
                          (or (abi/fn? a) (abi/fn? b)) (not= a b)
                          (and (class-id a) (class-id b)) (not (or (= a b) (abi/derived-from? (class-id a) (class-id b)) (abi/derived-from? (class-id b) (class-id a))))
                          (or (class-id a) (class-id b)) (and (or (abi/class? a) (abi/class? b)) (not= (abi/class? a) (abi/class? b)) (cx-sure-scalar? (if (abi/class? a) b a)))
                          (and (cx-sure-scalar? lt) (cx-sure-scalar? rt)) (not= (cx-shape lt) (cx-shape rt))
                          :else false)]
            (when bad (fail :ptr-cmp "comparison between distinct pointer types lacks a cast"))))
        (cond
          (or (abi/mptr? lt) (abi/mptr? rt))
          (let [pt (abi/unq (if (abi/mptr? lt) lt rt))]
            {:op :cmp :o o :l (convert-scalar l pt false) :r (convert-scalar r pt false) :ct pt :ty abi/bool* :cat :pr})
          (or (abi/ptr? lt) (abi/ptr? rt))
          (let [pt (if (abi/ptr? lt) lt rt)]
            {:op :cmp :o o :l (convert-scalar l pt false) :r (convert-scalar r pt false) :ct pt :ty abi/bool* :cat :pr})
          :else (let [ct (arith-common lt rt)]
                  {:op :cmp :o o :l (convert-scalar l ct false) :r (convert-scalar r ct false) :ct ct :ty abi/bool* :cat :pr})))
      "&&" {:op :land :l (fold-mark (to-bool l)) :r (to-bool r) :ty abi/bool* :cat :pr}
      "||" {:op :lor :l (fold-mark (to-bool l)) :r (to-bool r) :ty abi/bool* :cat :pr}
      "," {:op :comma :l l :r r :ty (:ty r) :cat (:cat r)}
      (".*" "->*")
      (let [obj (if (= o "->*") (deref-node l) l)
            m (rv r)
            mt (abi/unq (:ty m))
            ;; (CX12, the checker: [expr.mptr.oper]/6, a ref-qualified member function's pointer and the object's category;
            ;; C++20's const & taking an rvalue too)
            _ (when (and (checking?) (abi/fn? (:to mt)))
                (let [rq (:refq (:to mt)) lv (= :lv (:cat obj))]
                  (when (or (and (= rq "&") (not lv) (not (:cq (:to mt)))) (and (= rq "&&") lv))
                    (fail :mptr "pointer-to-member function type requires an " (if lv "rvalue" "lvalue")))))
            obj (if (= :pr (:cat obj)) (materialize obj) obj)
            obj (to-base-lv obj (:cls mt))]
        (if (abi/fn? (:to mt))
          {:op :mbound :obj obj :m m :fty (:to mt) :ty {:k :overload} :cat :pr}
          {:op :mfield :obj obj :m m :ty (cond-> (:to mt) (:c (:ty obj)) (assoc :c true)) :cat (if (= :lv (:cat obj)) :lv :xv)}))
      (fail :operator "binary " o))))

(defn- cx-read-only!
  "h-cpp-consteval (the checker): [expr.assign]/1, the left operand of an assignment a modifiable lvalue: not a variable of a
  const-qualified scalar type (GCC's \"assignment of read-only variable\")."
  [l & [what ctx]]
  (when (and (checking?) (= :var (:op l)) (:c (:ty l)) (not (abi/ref? (:ty l))) (abi/scalar? (abi/unq (:ty l))))
    (when-let [v (var* (:id l))]
      (when (and (:name v) (:c (:ty v)) (not (abi/ref? (:ty v))))
        (fail :assign (or what "assignment") " of read-only variable '" (:name v) "'"))))
  ;; (cpp-indep: any other lvalue of a const-qualified scalar type is no modifiable lvalue either, [basic.lval]/? with
  ;; [expr.assign]/1, [expr.pre.incr]/1: a comma's, a call's returning a reference to const, a dereferenced pointer to const,
  ;; a member of a const object but a mutable one -- GCC's "assignment of read-only location", other/const5.C's `(0, i) = 1`,
  ;; concepts/abbrev6.C's `f(5) = 0` of `const auto& f(auto)`)
  ;; (only in the user's own code: a function's body that is neither implicit nor defaulted -- an implicitly declared copy
  ;; assignment's memberwise `=` of a const member is the deletion's business, [class.copy.assign]/10, its unit's analysis
  ;; otherwise refused; init/uninitialized1.C, cpp1y/constexpr-tracking-const4.C)
  (when (and (checking?) (not= :var (:op l)) (#{:lv :xv} (:cat l)) ctx
             (let [f (some-> (:fn-id ctx) fnd)] (and f (not (:implicit f)) (not (:defaulted f)) (not (:header f)))))
    (let [t (abi/non-ref (:ty l))]
      (when (and (map? t) (:c t) (abi/scalar? (abi/unq t)))
        (fail :assign (or what "assignment") " of read-only location")))))

(defn- assign-node [ctx l r]
  (cond
    (abi/class? (abi/unq (:ty l))) (operator-call ctx "=" [l r])
    :else (do (when-not (lv? l) (fail :assign "assignment to an rvalue"))
              ;; (queue 412, round 7, the checker: [expr.assign]/1 with [basic.lval]/7, an array is no modifiable lvalue; GCC's
              ;; "invalid array assignment", from a braced list its "assigning to an array from an initializer list")
              (when (and (checking?) (abi/arr? (abi/unq (:ty l))))
                (if (= :init-list (:op r))
                  (fail :assign "assigning to an array from an initializer list")
                  (fail :assign "invalid array assignment")))
              (cx-read-only! l nil ctx)
              (if-let [cx (let [t (abi/unq (:ty l)) rr (when-not (= :init-list (:op r)) (rv r))]
                            (when (and (= :complex (:k t)) rr (abi/arith? (abi/unq (:ty rr))) (lv? l))
                              ;; (cpp-rt-own: a real value assigned to a GNU complex, its real part the value and its imaginary
                              ;; part zero (GCC's manual, "Complex Numbers"): <complex>'s complex<float>::operator=(float),
                              ;; `_M_value = __f;`, complex_io.cc's)
                              (let [et (:of t)
                                    part (fn [i] {:op :cpart :part i :e l :ty et :cat :lv})
                                    zero (if (abi/floating? et) {:op :float :v 0.0 :ty et :cat :pr} {:op :int :v 0 :ty et :cat :pr})]
                                {:op :comma :l {:op :assign :l (part 0) :r (convert-scalar rr et false) :ty et :cat :lv}
                                 :r {:op :comma :l {:op :assign :l (part 1) :r zero :ty et :cat :lv} :r l :ty (:ty l) :cat :lv}
                                 :ty (:ty l) :cat :lv})))]
                cx
              (let [t (abi/unq (:ty l))
                    ;; (cpp-s11: a braced list on the right of a scalar, [expr.assign]/8: x = {} assigns a value-initialized
                    ;; T, x = {e} e converted as T{e}; <charconv>'s `__res.ec = {};` of the enumeration errc)
                    r (if (= :init-list (:op r))
                        (case (count (:items r))
                          0 (convert-scalar {:op :int :v 0 :ty abi/int* :cat :pr} t true)
                          ;; (queue 412: x = {e} as T{e}, [expr.assign]/8: narrowing judged)
                          1 (:e (narrow-check! {:i :expr :e (convert-scalar (rv (first (:items r))) t false)} t (first (:items r))))
                          (fail :assign "a list of several values assigned to a scalar"))
                        (let [r (rv r)]
                          ;; (queue 460: [expr.assign]/3, the right operand implicitly converted, the checker's)
                          (when-not (abi/class? (abi/unq (:ty r))) (cx-implicit-scalar! r t :copy))
                          ;; (cpp-diag-b, 2026-11-22: [expr.assign]/3 with [conv.integral]/1: no implicit conversion yields an
                          ;; enumeration, so an enumeration is assigned from its own type alone: from another enumeration GCC's
                          ;; "cannot convert 'Y' to 'X' in assignment", from an arithmetic value its permerror "invalid conversion")
                          (let [ft (abi/unq (:ty r))]
                            (when (and (checking?) (abi/enum? t) (not= ft t) (not (abi/class? ft)))
                              (cond (abi/enum? ft) (fail :conversion "cannot initialize a variable of type '" (:name (abi/enm (:id t))) "' with a value of another type")
                                    (abi/arith? ft) (fail :conversion "cannot convert " (cx-tyname ft) " to " (cx-tyname t) " implicitly (an arithmetic value to an enumeration)")
                                    :else nil)))
                          ;; (cpp-rt-own: a class's by its conversion function, [expr.assign]/3 with [over.match.conv]: a captureless
                          ;; lambda assigned to a pointer to function, libcpp's errors.cc `m_pfile->cb.diagnostic = [] (...) { ... };`)
                          (convert-scalar (if (and (abi/class? (abi/unq (:ty r))) (not (abi/class? t))) (user-conv ctx r t false) r) t false)))]
                {:op :assign :l l :r r :ty (:ty l) :cat :lv})))))

(defn- compound-node [o l r & [ctx]]
  (cx-read-only! l nil ctx)
  (let [lt (abi/unq (:ty l)) r (rv r)]
    (if (abi/ptr? lt)
      {:op :cassign :o o :l l :r (convert-scalar r abi/long* false) :ct lt :ty (:ty l) :cat :lv :ptr true}
      (let [ct (if (#{"<<" ">>"} o) (promote-type lt) (arith-common lt (:ty r)))]
        {:op :cassign :o o :l l :r (convert-scalar r (if (#{"<<" ">>"} o) ct ct) false) :ct ct :ty (:ty l) :cat :lv}))))

(defn- cx-reinterpret-cast?
  "h-cpp-consteval: whether the typed conversion `r` (a C-style cast's) converts between pointers to, or references of,
  unrelated object types (neither void, nor a class and its base): a reinterpret_cast."
  [r]
  (let [unrelated? (fn [a b]
                     (let [a (abi/unq a) b (abi/unq b) ca (class-id a) cb (class-id b)]
                       (and (not= a b) (not (abi/void? a)) (not (abi/void? b)) (not (abi/fn? a)) (not (abi/fn? b))
                            (not (and ca cb (or (abi/derived-from? ca cb) (abi/derived-from? cb ca)))))))]
    (case (:op r)
      :cast (and (= :noop (:ck r)) (abi/ptr? (abi/unq (:ty r))) (some-> r :e :ty abi/unq abi/ptr?)
                 (unrelated? (:to (abi/unq (:ty r))) (:to (abi/unq (:ty (:e r))))))
      :reinterpret-lv (unrelated? (:ty r) (abi/non-ref (:ty (:e r))))
      false)))

(defn- cast-expr [ctx t e explicit]
  (cond
    (and (abi/class? (abi/unq (:ty e))) (not (abi/ref? t)) (not (abi/class? (abi/unq t))) (not (abi/void? t)))
    (convert-scalar (user-conv ctx e (abi/unq t) true) t true)
    (abi/void? t) {:op :cast :ck :void :e e :ty abi/void :cat :pr}
    (abi/ref? t) (let [pt (:to t)
                       fc (class-id (:ty e)) tc (class-id pt)]
                   (cond
                     ;; (cpp-rt-own: to an rvalue reference an xvalue, [expr.static.cast]/2-3: <tuple>'s last _Tuple_impl's move
                     ;; constructor, `_Base(static_cast<_Base&&>(__in))`, had passed its base as an lvalue, so _Head_base's
                     ;; forwarding constructor template outranked its move constructor: a unique_ptr with an empty deleter could
                     ;; not be moved, fs_path.cc's path::_List)
                     (and fc tc (abi/derived-from? fc tc)) (cond-> (to-base-lv e tc) (= :rref (:k t)) (assoc :cat :xv))
                     (and fc tc (abi/derived-from? tc fc)) {:op :derived-lv :e e :to tc :ty pt :cat (if (= :rref (:k t)) :xv :lv)}
                     :else {:op :reinterpret-lv :e e :ty pt :cat (if (= :rref (:k t)) :xv :lv)}))
    (abi/class? (abi/unq t)) {:op :temp-obj :init (init-for t [e] ctx :direct) :ty (abi/unq t) :cat :pr}
    :else (convert-scalar (rv e) t true)))

(defn- scalar-list-cast
  "T{items...} of a non-class type `t` ([expr.type.conv]/2, [dcl.init.list]/3.10-3.11): no item, the value-initialized
  prvalue; one, it converted to `t` (a narrowing conversion not diagnosed); more, a refusal."
  [ctx t items]
  (case (count items)
    0 {:op :zero-val :ty (abi/unq t) :cat :pr}
    1 (:e (narrow-check! {:i :expr :e (cast-expr ctx t (first items) true)} t (first items)))
    (fail :expr "a braced functional cast of a scalar type with " (count items) " elements")))

(defn- cx-using-map
  "CP324 (a): {fn-id [class access]} for the functions among the entities `es` that a class's using-declaration named."
  [es]
  (not-empty (into {} (for [e es :when (and (= :fn (:e e)) (:ucls e))] [(:id e) [(:ucls e) (:uaccess e)]]))))

(defn- method-set-of
  "[class-id fn-ids] of the members named `nm` of the class of object `obj`."
  [cid nm]
  (let [es (class-lookup cid nm)
        ;; (cpp-rt-own: a data member of the class's own name hides its injected-class-name, [basic.scope.hiding]/2 and [class.mem]/22:
        ;; libcpp's expr.cc `struct op { ...; enum cpp_ttype op; }`, `top->op = CPP_EOF`, "member op" before)
        es (if (and (= :type (:e (second (first es)))) (some #(#{:field :indirect :var :fn} (:e (second %))) es))
             (vec (remove #(= :type (:e (second %))) es))
             es)]
    (when (seq es) [(first (first es)) (mapv (comp :id second) (filter #(= :fn (:e (second %))) es)) (second (first es))])))

(defn- cx-type-friend?
  "The rest of CP313 (a): whether a friend declaration may grant a member type of class `cid` with access `acc` (the
  class declares a friend, or for a protected one a class derived from it does), in place of the third slice's gate (no
  class of the unit declaring a friend)."
  [cid acc]
  (boolean (or (:has-friends (abi/cls cid))
               (and (= :protected acc) (some (fn [d] (and (:has-friends d) (abi/derived-from? (:id d) cid))) (vals @abi/*classes*))))))

(defn- check-type-access!
  "CX12 (the checker): [class.access]/1-2 for the member types a declaration's type names by a qualified name (A::X with
  X a private or protected typedef of the class A), in a declaration that is no class member's (a variable at namespace
  scope with an unqualified name, or a local of a function that is no class's member nor a template's specialization),
  where no class of the unit declares a friend: inaccessible ([class.access]/6's deferred check of a member's own
  declaration, A::X A::v, is not judged: only unqualified declarators). `node` the declaration (its position)."
  [scope ^String text node]
  ;; (CX12, fifth slice: a template-id's member type, Beta<0>::Y, its class the qualifier resolved as a type)
  (when (and (checking?) text (str/includes? text "<"))
    (when-let [[_ q nm] (re-matches #"(?:const\s+)?([A-Za-z_][\w:]*<[^<>]*>)\s*::\s*([A-Za-z_]\w*)\s*" text)]
      (let [cid (try (class-id (resolve-type scope q)) (catch arbace.lang.ExceptionInfo _ nil))
            es (when cid (.get ^java.util.HashMap (:names (:scope (abi/cls cid))) nm))
            acc (some #(when (= :type (:e %)) (:access %)) es)]
        (when (and (#{:private :protected} acc) (not (cx-type-friend? cid acc)))
          (throw (ex-info (str "codegen: '" nm "' is a " (name acc) " member of '" (:name (abi/cls cid)) "'")
                          {:codegen/refused :access :cx/node node}))))))
  ;; (queue 492: a member class template named by a qualified template-id, X::Y<int>, its access as a member type's)
  (when (and (checking?) text (str/includes? text "<"))
    (doseq [[_ q0 nm] (re-seq #"(?<![\w:<,>])((?:[A-Za-z_][A-Za-z_0-9]*::)+)([A-Za-z_][A-Za-z_0-9]*)\s*<" text)
            :let [parts (vec (remove str/blank? (str/split q0 #"::")))
                  ce (try (first (filter #(= :type (:e %)) (lookup-qualified scope parts))) (catch arbace.lang.ExceptionInfo _ nil))
                  cid (when ce (class-id (:ty ce)))]
            :when cid
            :let [es (.get ^java.util.HashMap (:names (:scope (abi/cls cid))) nm)
                  acc (some #(when (and (= :tmpl (:e %)) (= :class (:tk %))) (:access %)) es)]
            :when (and (#{:private :protected} acc) (not (cx-type-friend? cid acc)))]
      (throw (ex-info (str "codegen: '" nm "' is a " (name acc) " member of '" (:name (abi/cls cid)) "'")
                      {:codegen/refused :access :cx/node node}))))
  (when (and (checking?) text (str/includes? text "::") (not (str/includes? text "<")))
    (doseq [[_ q0 nm0] (re-seq #"((?:[A-Za-z_][A-Za-z_0-9]*::)+)([A-Za-z_][A-Za-z_0-9]*)" text)
            ;; (queue 492: each step of the qualifier too, Bar::type2::type1's type2 in Bar)
            :let [all (conj (vec (remove str/blank? (str/split q0 #"::"))) nm0)]
            j (range 1 (count all))
            :let [parts (subvec all 0 j) nm (nth all j)
                  ce (try (first (filter #(= :type (:e %)) (lookup-qualified scope parts))) (catch arbace.lang.ExceptionInfo _ nil))
                  cid (when ce (class-id (:ty ce)))]
            :when cid
            :let [es (.get ^java.util.HashMap (:names (:scope (abi/cls cid))) nm)
                  acc (some #(when (= :type (:e %)) (:access %)) es)]
            :when (and (#{:private :protected} acc) (not (cx-type-friend? cid acc)))]
      (throw (ex-info (str "codegen: '" nm "' is a " (name acc) " member of '" (:name (abi/cls cid)) "'")
                      {:codegen/refused :access :cx/node node})))))

(defn- cx-tparam-access!
  "Queue 502 (the checker): the template parameters of a namespace-scope template declaration `n` (a class, function,
  variable or alias template) name members whose access is checked where they appear, in the namespace's context
  ([class.access]/1-2, [class.access]/8: a default template argument's names at its declaration, not at its uses): a
  non-type parameter's type or a type parameter's default naming a private or protected member type (check-type-access!),
  a non-type parameter's default naming a private or protected static data member (A::b), a template template parameter's
  default naming a private or protected member class template (A::c); each reported at the parameter (*on-refusal*), the
  declaration going on. Not judged when the member's class may grant it by a friend (cx-type-friend?). GCC's \"'typedef
  int foo::memfun' is private within this context\" (parse/access8.C, template/access18.C)."
  [scope n]
  (when (and (checking?) *on-refusal* (= :ns (:kind scope))
             (#{"ClassTemplateDecl" "FunctionTemplateDecl" "VarTemplateDecl" "TypeAliasTemplateDecl"} (:kind n)))
    (doseq [p (:inner n)
            :let [k (:kind p)
                  report (fn [nm acc cid]
                           (*on-refusal* (ex-info (str "codegen: '" nm "' is a " (name acc) " member of '" (:name (abi/cls cid)) "'")
                                                  {:codegen/refused :access :cx/node p})
                                         p))]]
      (try
        (case k
          "TemplateTypeParmDecl"
          (when-let [qt (some #(when (= "TemplateArgument" (:kind %)) (get-in % [:type :qualType])) (:inner p))]
            (check-type-access! scope (str qt) p))
          "NonTypeTemplateParmDecl"
          (do (check-type-access! scope (str (get-in p [:type :qualType])) p)
              (doseq [a (:inner p) :when (= "TemplateArgument" (:kind a))
                      d (:inner a) :when (and (= "DeclRefExpr" (:kind d)) (seq (:qualifier d)) (not (:_g d)))
                      :let [nm (get-in d [:referencedDecl :name])
                            v (when (string? nm)
                                (some #(when (= :var (:e %)) (var* (:id %)))
                                      (try (lookup-qualified scope (conj (vec (:qualifier d)) nm)) (catch arbace.lang.ExceptionInfo _ nil))))]
                      :when (and v (#{:private :protected} (:cx-access v)) (:cx-cls v) (not (cx-type-friend? (:cx-cls v) (:cx-access v))))]
                (report nm (:cx-access v) (:cx-cls v))))
          "TemplateTemplateParmDecl"
          (when-let [[_ q0 nm] (re-find #"=\s*((?:[A-Za-z_][A-Za-z_0-9]*\s*::\s*)+)([A-Za-z_][A-Za-z_0-9]*)\s*$" (or (node-text p) ""))]
            (let [parts (vec (remove str/blank? (map str/trim (str/split q0 #"::"))))
                  ce (try (first (filter #(= :type (:e %)) (lookup-qualified scope parts))) (catch arbace.lang.ExceptionInfo _ nil))
                  cid (when ce (class-id (:ty ce)))
                  acc (when cid (some #(when (and (= :tmpl (:e %)) (= :class (:tk %))) (:access %))
                                      (.get ^java.util.HashMap (:names (:scope (abi/cls cid))) nm)))]
              (when (and (#{:private :protected} acc) (not (cx-type-friend? cid acc)))
                (report nm acc cid))))
          nil)
        (catch arbace.lang.ExceptionInfo e
          (if (= :access (:codegen/refused (ex-data e)))
            (*on-refusal* e p)
            (throw e)))))))

;; queue 506 (the checker; 502-3 (a)): type access on instantiation. A member type named through a template parameter,
;; T::X, has its access checked in the specialization, in the context the name appears in ([temp.inst], [class.access]/2
;; with [temp.res.general]): a class template's member declaration in the instantiated class's (template/access3.C's
;; `typename T::template X<int> x;`, template/qualttp8.C's `C<T::template B> c;` with T a class whose X or B is private),
;; an alias template's defining-type-id in the alias template's (cpp0x/alias-decl-22.C's `using foo = typename T::bar;`,
;; foo<B> named by B's member, EDG's and GCC's reading); and, in or out of templates, a base-specifier's names in the
;; derived class's ([class.access]/7, CWG 372: template/access31.C's `struct exploit2 : C::Private`) and a member
;; template's parameters' in the class's ([class.access]/8, as cx-tparam-access! at namespace scope: access31.C's
;; `template<class U = C::Private>`). Judged only where sure: a member declared in the qualifier's class itself (no base's),
;; cx-access-ok? false (a friend by name grants), no header's declaration, and an alias template's specialization only
;; when a declaration's own type names it (a substitution in a deduction is SFINAE, not judged).

(def ^:dynamic *cx-alias-check* nil) ; queue 506: the template-id form whose alias template's specialization is checked

(defn- cx-qual-type-names
  "Queue 506: the [qualifier-parts name] steps of the qualified names the type spelling `text` writes, `typename` and the
  `template` disambiguator dropped: T::X and T::X::Y of T::X::Y."
  [text]
  (let [t (-> (str text) (str/replace #"\btypename\s+" "") (str/replace #"::\s*template\s+" "::") (str/replace #"\s*::\s*" "::"))]
    (for [[_ q0 nm0] (re-seq #"(?<![\w:])((?:[A-Za-z_]\w*::)+)([A-Za-z_]\w*)" t)
          :let [all (conj (vec (remove str/blank? (str/split q0 #"::"))) nm0)]
          j (range 1 (count all))]
      [(subvec all 0 j) (nth all j)])))

(defn- cx-qual-type-access!
  "Queue 506: the first qualified name the type spelling `text` writes (cx-qual-type-names, its qualifier's parts chosen by
  `pred`, resolved in `scope` to a class) whose member type or member class template, declared in that class, is private or
  protected and surely inaccessible in the context `cx` (cx-access-ok? false): reported at `node` (*on-refusal*), true."
  [scope text node cx pred]
  (when (and (checking?) *on-refusal* cx (string? text) (str/includes? text "::"))
    (when-let [[nm acc qc]
               (some (fn [[parts nm]]
                       (when (pred parts)
                         (let [ce (try (first (filter #(= :type (:e %)) (lookup-qualified scope parts))) (catch arbace.lang.ExceptionInfo _ nil))
                               qc (when ce (class-id (:ty ce)))
                               c (when qc (abi/cls qc))
                               acc (when (:scope c)
                                     (some #(when (or (= :type (:e %)) (and (= :tmpl (:e %)) (= :class (:tk %)))) (:access %))
                                           (.get ^java.util.HashMap (:names (:scope c)) nm)))]
                           (when (and (#{:private :protected} acc) (false? (cx-access-ok? cx qc acc qc nil)))
                             [nm acc qc]))))
                     (cx-qual-type-names text))]
      (*on-refusal* (ex-info (str "codegen: '" nm "' is a " (name acc) " member of '" (:name (abi/cls qc)) "'")
                             {:codegen/refused :access :cx/node node})
                    node)
      true)))

(defn- cx-tparam-qualifier
  "Queue 506: a predicate over a qualifier's parts: one name, a parameter the scope `bs` (a :tparams scope) binds."
  [bs]
  (fn [parts] (and (= 1 (count parts)) (boolean (seq (.get ^java.util.HashMap (:names bs) (first parts)))))))

(defn- cx-tinst-member-type-access!
  "Queue 506: a member declaration `k` (a field, typedef or alias) of the class `cid` (its scope `cs`) declared in a scope
  binding template parameters (a class template's specialization, or a member class of one): its type's T::X with T a
  parameter bound to a class, X's access checked in the class's context (cx-qual-type-access!). In a template's pattern T
  stands for itself, no class: not judged."
  [cs cid k]
  (when (and (checking?) (not (header-node? k)))
    (when-let [bs (loop [s (:parent cs)] (case (:kind s) :tparams s :class (recur (:parent s)) nil))]
      (when-let [rs (cx-enclosing-classes cid)]
        (cx-qual-type-access! cs (str (get-in k [:type :qualType])) k {:records rs} (cx-tparam-qualifier bs))))))

(defn cx-alias-access!
  "Queue 506: the alias template `t`'s specialization, its parameters bound by the scope `bs`, named by a declaration's own
  type (template-id's alias branch, when *cx-alias-check* is its form): its defining-type-id's T::X with T a parameter
  checked in the alias template's context, a namespace's (cx-qual-type-access!), reported at the alias's declaration."
  [t bs]
  (let [p (:pattern t)]
    (when (and (checking?) p (:range p) (not (header-node? p)) (= :ns (:kind (:scope t))))
      (cx-qual-type-access! bs (str (get-in p [:type :qualType])) p {:records #{}} (cx-tparam-qualifier bs)))))

(defn- cx-alias-member-access!
  "Queue 506: a member declaration `k` of a class (its scope `cs`) whose type is an unqualified alias template's
  specialization, foo<B>: the template-id resolved once more with *cx-alias-check* its form, so that cx-alias-access!
  judges that specialization alone (not the template-ids inside it, nor a deduction's)."
  [cs k]
  (when (and (checking?) *on-refusal* (not (header-node? k)) (:template-id @hooks))
    (let [qt (str (get-in k [:type :qualType]))]
      (when (str/includes? qt "<")
        (let [f (try (ct/parse-type (strip-type-attrs qt)) (catch Exception _ nil))]
          (when (and (seq? f) (= '<> (first f)) (symbol? (second f)) (nil? (namespace (second f)))
                     (some #(and (= :tmpl (:e %)) (= :alias (:tk %))) (lookup cs (name (second f)))))
            (binding [*cx-alias-check* f]
              (try ((:template-id @hooks) cs f) (catch Exception _ nil)))))))))

(defn- cx-base-type-access!
  "Queue 506: the base-specifiers of the class `id` (its node `n`, declared in `scope`): a qualified name's member type
  checked in the derived class's context ([class.access]/7, CWG 372), cx-qual-type-access!."
  [scope id n]
  (when (and (checking?) *on-refusal* (not (header-node? n)))
    (when-let [rs (cx-enclosing-classes id)]
      (doseq [bs (:bases n)
              :let [qt (str (get-in bs [:type :qualType]))]
              :when (and (not (:isPackExpansion bs)) (str/includes? qt "::"))]
        (cx-qual-type-access! scope qt (if (:range bs) bs n) {:records rs} (constantly true))))))

(defn- cx-member-tparam-access!
  "Queue 506: a member template `n` of the class whose scope is `scope`: a type parameter's default and a non-type
  parameter's type naming a member type, checked in the class's context ([class.access]/8), cx-qual-type-access!."
  [scope n]
  (when (and (checking?) *on-refusal* (= :class (:kind scope)) (:cls scope) (not (header-node? n))
             (#{"ClassTemplateDecl" "FunctionTemplateDecl" "VarTemplateDecl" "TypeAliasTemplateDecl"} (:kind n)))
    (when-let [rs (cx-enclosing-classes (:cls scope))]
      (doseq [p (:inner n)
              :let [qt (case (:kind p)
                         "TemplateTypeParmDecl" (some #(when (= "TemplateArgument" (:kind %)) (get-in % [:type :qualType])) (:inner p))
                         "NonTypeTemplateParmDecl" (get-in p [:type :qualType])
                         nil)]
              :when qt]
        (cx-qual-type-access! scope (str qt) p {:records rs} (constantly true))))))

(defn- friend-may-grant?
  "CP313 (a), clang's SemaAccess.cpp (llvmorg-23.1.5) EffectiveContext and GetFriendKind for a non-member function `f`
  naming a member of class `cid`: whether a friend declaration could make it accessible -- `cid` declares a friend function
  or function template of f's name (by name: an overload or a qualified friend counts, missed never wrong), or a friend it
  could not classify; for a protected member ([class.protected]: a friend of a derived class may name it through the
  derived class) any class derived from `cid` that declares a friend; a class's friend classes grant nothing to a
  non-member function."
  [cid f access]
  (let [c (abi/cls cid)]
    (boolean
      (or (:friend-unknown c)
          (contains? (:friend-fns c) (:name f))
          (and (= :protected access)
               (some (fn [d] (and (:has-friends d) (not= (:id d) cid) (abi/derived-from? (:id d) cid))) (vals @abi/*classes*)))))))

(defn- check-access!
  "CX12 (the checker): [class.access]/1-2 for a member named in an expression: a private or protected member of class
  `cid` named in a function that is no class's member (nor in a class's scope): inaccessible unless a friend declaration
  may grant it (CP313 (a), friend-may-grant?; before it, judged only where no class of the unit declared a friend).
  Everything else (members, templates' patterns, using-declarations) is not judged."
  ([ctx cid nm access]
   (when (and (checking?) (#{:private :protected} access) cid)
     (let [f (when-let [i (:fn-id ctx)] (fnd i))]
       (when (and f (not (:cls f)) (not (:this-type ctx)) (not (:tinst f))
                  (not (friend-may-grant? cid f access)))
         (fail :access "'" nm "' is a " (name access) " member of '" (:name (abi/cls cid)) "'")))))
  ;; (the rest of CP313 (a): with the naming class and the object's class, in every context cx-context judges)
  ([ctx cid nm access nc obj]
   (cx-access! ctx cid nm access nc obj)))

(defn- cx-anon-union-access!
  "Queue 499 (the checker): a member of an anonymous union (`e` the name's :indirect entry, its chain of [class field]
  steps) named by a class member access, o.m: a member of the class the union is declared in ([class.union.anon]/1),
  with the access of the anonymous union's own member there (an anonymous union has no private or protected members);
  judged when every step after the first is an anonymous union's member (a GNU anonymous struct's not)."
  [ctx e nm nc obj]
  (when (checking?)
    (let [[[c0 i0] & more] (:chain e)]
      (when (and c0 (every? (fn [[c _]] (:union (abi/cls c))) more) (seq more))
        (check-access! ctx c0 nm (:access (nth (:fields (abi/cls c0)) i0 nil)) nc obj)))))

(defn- cx-mptr-access!
  "Queue 502 (the checker): &C::m, a pointer to member ([expr.unary.op]/4), names the member m through the naming class C
  (the qualifier's), so its access is checked there as any qualified name's ([class.access]/1-2, [class.access.base]/5):
  a non-static data member inaccessible as a member of C; a member function when every member function of that name
  the lookup `es` finds is inaccessible (overload resolution picks among them later, [over.over]); a protected member's
  object rule ([class.protected]) not applied, so no false error. GCC's \"'void base::foo()' is private within this
  context\" (template/access34.C, in a class template's member, a member template's specialization and an out-of-line
  member alike)."
  [ctx es q g nm]
  (when (and (checking?) (seq es))
    (when-let [qc (try (class-id (:ty (type-entity (lookup-qualified (:scope ctx) q g)))) (catch arbace.lang.ExceptionInfo _ nil))]
      (let [e (first es)]
        (case (:e e)
          :field (let [a (:access (nth (:fields (abi/cls (:cls e))) (:i e) nil))]
                   (when (#{:private :protected} a) (cx-access! ctx (:cls e) nm a qc nil)))
          :fn (let [fs (keep #(when (= :fn (:e %)) (fnd (:id %))) es)]
                (when (and (seq fs) (every? #(and (:cls %) (not (:static %)) (#{:private :protected} (:access %))) fs))
                  (when-let [cx (cx-context ctx)]
                    (when (every? #(false? (cx-access-ok? cx (:cls %) (:access %) (if (or (= qc (:cls %)) (abi/derived-from? qc (:cls %))) qc (:cls %)) nil)) fs)
                      (fail :access "'" nm "' is a " (name (:access (first fs))) " member of '" (:name (abi/cls (:cls (first fs)))) "'")))))
          nil)))))

(defn- cx-injected-qualifier?
  "Queue 502 (the checker): whether the one-name qualifier `q` of o.Q::m may name the class `qcid` by its
  injected-class-name, found as a member of o's class ([basic.lookup.qual]/1, [class.access.base]/5): its name is the
  class's own. A template parameter (lookup/scoped15.C's `D{}.T::a` in g<A>, judged since specializations are) or a
  typedef name names the class directly, with no base's access to check."
  [q qcid]
  (= (str (first q)) (str (:name (abi/cls qcid)))))

(defn- member-expr [ctx n]
  (let [[objn] (kids n)
        o (analyze ctx objn)
        ;; p->m of a class object: its operator-> applied until a pointer ([over.ref]; G4: unique_ptr)
        o (if (:isArrow n)
            (loop [o o k 0]
              (if (and (class-id (:ty o)) (< k 8))
                (recur (or (operator-call ctx "->" [o])
                           ;; (cpp-rind, the checker: a complete class with no operator-> the base operand of ->, [over.ref]/1 with
                           ;; [expr.ref]/2: GCC's "base operand of '->' has non-pointer type 'C'";
                           ;; diagnostic/base-operand-non-pointer-1.C)
                           (fail (if (and (checking?) (:complete (abi/cls (class-id (:ty o)))) (not (:tmpl (abi/cls (class-id (:ty o)))))) :arrow-op :member)
                                 "no operator-> of " (:name (abi/cls (class-id (:ty o))))))
                       (inc k))
                o))
            o)
        obj (if (:isArrow n) (deref-node o) o)
        cid (class-id (:ty obj))
        nm (:name n)
        ;; (cpp-sweep, the checker: GCC names a closure's capture member `__x` for the capture x, a name the program can
        ;; reach (the closure type's members unspecified, [expr.prim.lambda.closure]/2 and /10): `lambda.__val` is that
        ;; member as g++ 15.2 takes it, pr85515-1.C)
        capf (when-let [c (and (checking?) cid (str/starts-with? (str nm) "__") (abi/cls cid))]
               (when (:lambda c) (some #(when (= (subs (str nm) 2) (:cx-capname %)) %) (:fields c))))
        ;; a qualified member (o.B::f): looked up in B, called without virtual dispatch
        q (if (:_wn n)
            (not-empty (vec (:qualifier n)))
            (let [t (or (node-text n) "")
                  m (re-find #"(?:\.|->)\s*((?:[A-Za-z_][A-Za-z_0-9]*\s*(?:<[^.]*>)?\s*::\s*)+)~?[A-Za-z_][A-Za-z_0-9]*\s*(?:<.*>)?\s*$" t)]
              ;; the qualifier's parts, a template-id among them (o.A<int>::f)
              (when m (vec (map str/trim (remove str/blank? (split-scope (second m))))))))
        qcid (when (seq q) (let [e (first (filter #(= :type (:e %)) (lookup-qualified (:scope ctx) q)))] (class-id (:ty e))))]
    (when-not cid (fail :member "member of a non-class"))
    (if capf
      (field-node obj cid (:i capf))
    (do
    ;; (the rest of CP313 (a): o.B::m names B by its injected-class-name found in o's class, a member of it through the
    ;; bases, [basic.lookup.qual]/1 and [class.access.base]/5: inaccessible through a private base; ::B::m does not)
    (when (and (checking?) qcid (not= qcid cid) (= 1 (count q)) (abi/derived-from? cid qcid)
               (cx-injected-qualifier? q qcid)
               (not (re-find #"(?:\.|->)\s*::" (or (node-text n) ""))))
      (cx-access! ctx qcid (first q) :public cid nil))
    (let [[fcid fids e] (if (str/starts-with? (str nm) "~")
                          ;; an explicit destructor call (p->~T(), [class.dtor]/14): the class's destructor
                          ;; (cpp-rt-own4, DECISION cpp-rt-own3-2 (a), the code generator: a class not complete here, its
                          ;; destructor not declared yet, resolved when the function is written, codegen's :late-dtor-call:
                          ;; floating_from_chars.cc's vector<__pool_resource::_BigBlock, polymorphic_allocator<_BigBlock>>
                          ;; destroyed, whose _BigBlock the unit never defines, `__p->~_Up()` in allocator_traits<
                          ;; polymorphic_allocator<_Tp>>::destroy, analyzed by the lazy round though clang never instantiates it)
                          (let [k (or qcid cid) c (abi/cls k) d (:dtor c)]
                            (cond d [k [d] {:e :fn :id d}]
                                  (and (not (checking?)) (or (not (:complete c)) (:defining c))) [k [] {:e :late-dtor :cls k}]
                                  :else nil))
                          (method-set-of (or qcid cid) nm))
          fids (if qcid fids fids)
          ;; (round 54, fourth pass: o.B::Y whose qualifier names an enumeration of o's class, [expr.ref]/7.5: a member
          ;; enumerator, looked up in the class's scope, a prvalue after o's evaluation; enum25.C's `a.B::Y`)
          en (when (and (nil? e) (seq q) (nil? qcid) cid (:scope (abi/cls cid))
                        (some? (.get ^java.util.HashMap (:names (:scope (abi/cls cid))) (first q))))
               (try (let [r (name-expr (assoc ctx :scope (:scope (abi/cls cid)))
                                       {:kind "DeclRefExpr" :_wn true :qualifier q :referencedDecl {:name nm}})]
                      (when (and (:ty r) (abi/enum? (:ty r)) (not (#{:fnset :fn} (:op r))) (not= :var (:op r))) r))
                    (catch arbace.lang.ExceptionInfo _ nil)))]
      (cond
        en {:op :comma :l obj :r en :ty (:ty en) :cat (:cat en)}
        ;; (cpp-def, the checker: [class.access.base]/6, a non-static member named o.C::m is reached through a conversion of o to
        ;; the naming class C: a C that is not o's class nor a base of it is GCC's "'C' is not a base of 'B'"; parse/crash40.C)
        (and (checking?) qcid cid (not= qcid cid) (not (abi/derived-from? cid qcid))
             (let [c (abi/cls cid)] (and (:complete c) (not (:tmpl c)) (not (:targs c)) (not (:defining c))))
             (or (= :field (:e e)) (and (seq fids) (every? #(let [f (fnd %)] (and f (not (:static f)))) fids))
                 ;; (a member function template not declared static, its pattern's storage class)
                 (and (= :tmpl (:e e)) (= :fn (:tk e)) (empty? fids)
                      (let [t (some-> (resolve 'arbace.cpp.template/*tmpls*) deref deref (get (:id e)))]
                        (and t (map? (:pattern t)) (not= "static" (:storageClass (:pattern t))))))))
        (fail :member "'" (:name (abi/cls qcid)) "' is not a base of '" (:name (abi/cls cid)) "'")
        (= :late-dtor (:e e)) {:op :late-dtor :cls (:cls e) :obj (update (cx-via obj qcid) :ty #(if (map? %) (dissoc % :c :v) %))
                               :qualified (boolean qcid) :ty {:k :overload} :cat :lv}
        ;; (queue 526, the checker: of a class a refusal dropped or changed, cx-dropped-class?, its cascade: no rule)
        (and (nil? e) (cx-dropped-class? (or qcid cid))) (fail :type "a member of a class a refusal dropped or changed: " nm)
        (nil? e) (fail :member "no member " nm (when (System/getenv "CPP_HDR_TRACE") (str " (" (node-text n) ") of " (:name (abi/cls (or qcid cid))) " " (pr-str (:targs (abi/cls (or qcid cid)))) " fields " (pr-str (mapv :name (:fields (abi/cls (or qcid cid))))))))
        (= :field (:e e)) (do (check-access! ctx (:cls e) nm (:access (nth (:fields (abi/cls (:cls e))) (:i e))) (or qcid cid) cid)
                              ;; (cpp-decl2, the checker: a data member of a virtual base through a null pointer constant cast,
                              ;; `((B*)0)->i`, whose virtual base's place no object gives: GCC's "invalid access to non-static data
                              ;; member 'A::i' of NULL object", other/offsetof8.C)
                              (when (and (checking?) (:isArrow n) (not= (:cls e) cid)
                                         (let [x (loop [x o] (if (#{:cast :convert} (:op x)) (recur (:e x)) x))]
                                           (or (= :null (:op x)) (and (= :int (:op x)) (= 0 (:v x)))))
                                         (nth (abi/base-path cid (:cls e)) 2 nil))
                                (fail :null-object "invalid access to non-static data member '" nm "' of NULL object"))
                              (field-node (cx-via (if (= :pr (:cat obj)) (materialize obj) obj) qcid) (:cls e) (:i e)))
        (= :indirect (:e e)) (do (cx-anon-union-access! ctx e nm (or qcid cid) cid)
                                 (reduce (fn [o [c i]] (field-node o c i)) (if (= :pr (:cat obj)) (materialize obj) obj) (:chain e)))
        (= :var (:e e)) (let [v (var* (:id e))]
                          ;; (queue 463, the checker: a static data member named by a class member access, o.m, [expr.ref]/7.1)
                          (when (and (checking?) (:cx-access v)) (cx-static-access! ctx (:cx-cls v) nm (:cx-access v) (or qcid cid)))
                          {:op :comma :l obj :r (var-node (:id e)) :ty (:ty v) :cat :lv})
        (#{:fn :tmpl} (:e e))
        (let [tm (vec (keep (fn [[_ x]] (when (= :tmpl (:e x)) (:id x))) (class-lookup (or qcid cid) nm)))
              t (or (node-text n) "")
              ;; (cpp-rt-own: a destructor is invoked for a const or volatile object too, [class.dtor]/5: fs_path.cc's
              ;; `back().~_Cmpt()` of a const _Cmpt&, "no viable function among 1" before)
              obj (if (str/starts-with? (str nm) "~") (update obj :ty #(if (map? %) (dissoc % :c :v) %)) obj)]
          (cond-> {:op :fnset :fns fids :tmpls tm :name nm :obj (cx-via (if (= :pr (:cat obj)) (materialize obj) obj) qcid) :ty {:k :overload} :cat :lv :qualified (boolean qcid)}
            (checking?) (assoc :member-access true :cx-nc (or qcid cid) :cx-obj cid
                               :cx-using (cx-using-map (map second (class-lookup (or qcid cid) nm))))
            (and (seq tm) (:_wn n) (:explicitTemplateArgs n)) (assoc :targs-text (written-targs n nm) :targs-scope (:scope ctx))
            (and (seq tm) (not (:_wn n)) (re-find #"<[^<>]*(?:<[^<>]*>[^<>]*)*>\s*$" t)) (assoc :targs-text (second (re-find #"(?:\.|->)\s*(?:template\s+)?(.*)$" t)) :targs-scope (:scope ctx))))
        (= :enumerator (:e e)) {:op :int :v (:val e) :ty (:ty e) :cat :pr}
        :else (fail :member "member " nm)))))))

(declare analyze-fn! has-auto?)

(declare defaulted-comparison!)

(defn- deduced!
  "The function `fid` with its deduced return type deduced ([dcl.spec.auto.general]/11: a use needs its definition
  analyzed first; G4: <bits/ptr_traits.h>'s auto __to_address)."
  [fid]
  (let [f (fnd fid)]
    ;; (a defaulted <=> with auto: its category deduced from the members')
    (when (and (has-auto? (:ret (:ty f))) (:defaulted f) (= "<=>" (:op f)) (not (:tbody f)))
      (defaulted-comparison! fid))
    (when (and (has-auto? (:ret (:ty f))) (:body f) (not (:tbody f)) (not (:analyzing f)))
      (upd-fn! fid assoc :analyzing true)
      (analyze-fn! fid)
      (upd-fn! fid assoc :analyzed true)
      (upd-fn! fid dissoc :analyzing))
    fid))

(declare cx-immediate-call! cx-immediate-eval!)

(defn- method-call
  "A call of the method `fid` on the object glvalue `obj` with the typed arguments."
  [ctx fid obj args virtual-ok]
  (let [f (fnd (deduced! fid))
        _ (cx-immediate-call! ctx f)
        _ (cx-closure-conv! ctx f)
        o (when-not (:static f) (to-base-lv obj (:cls f)))]
    ;; (cpp-sweep, the checker: a member function's immediate invocation evaluated as a free function's is, cx-immediate-eval!:
    ;; cpp2a/consteval-memfn1.C's `s.size(-1)` whose body throws)
    (cx-immediate-eval! ctx f
      {:op :call :fn fid :obj o :args (call-args f args ctx) :virtual (and virtual-ok (:virtual f) (not (:static f)))
       :ty (abi/non-ref (:ret (:ty f))) :cat (let [r (:ret (:ty f))] (case (:k r) :ref :lv :rref :xv :pr))})))

(defn- cx-immediate-call!
  "CP310 (b), the checker: an immediate invocation ([expr.const]/16: a call of an immediate function outside one) is a
  constant expression, so one of a function whose own body the checker found not constant (a constexpr error in it) is
  not, at the call."
  [ctx f]
  (when (and (checking?) (:consteval f) (:cx-imm-error f)
             (not (some-> (:fn-id ctx) fnd :consteval)))
    (fail :constexpr "call to consteval function '" (:name f) "' is not a constant expression")))

(declare cx-immediate-eval!)

(defn- imm-fold
  "cpp-tzdb, the code generator: an immediate invocation ([expr.const]/16: a call of a consteval function outside one) is
  evaluated at compile time, its value in place of the call, as clang's ConstantExpr: an integral or floating value, or a
  pointer to a string literal's first element (<format>'s _Widen<char>(\"...\", L\"...\")); the call kept when it does not
  fold (and the function then emitted as before). <chrono>'s __add_modulo's __modulo_offset<7, long>()."
  [ctx call f]
  (if (and (not (checking?)) (:consteval f) (not *unevaluated*) (not (some-> (:fn-id ctx) fnd :consteval)))
    (or (try (ce-try call true) (catch RuntimeException _ nil))
        (let [v (try (binding [*ce-manifest* true *ce-steps* (atom 0) *ce-const* (atom #{}) *ce-pos* (atom nil) *ce-dead* (atom #{})
                               *ce-temps* (atom []) *ce-unknown* (atom {}) *ce-wide* true]
                       (ce-eval call {}))
                     (catch RuntimeException _ nil))]
          (when (and (ce-ptr? v) (::lit v) (zero? (long (::i v))) (abi/ptr? (abi/unq (:ty call))))
            (rv (::lit v))))
        call)
    call))

(defn- fn-call [ctx fid args]
  (let [f (fnd (deduced! fid))
        _ (cx-immediate-call! ctx f)]
    (imm-fold ctx
              (cx-immediate-eval! ctx f
                {:op :call :fn fid :args (call-args f args ctx)
                 :ty (abi/non-ref (:ret (:ty f))) :cat (let [r (:ret (:ty f))] (case (:k r) :ref :lv :rref :xv :pr))})
              f)))

(defn adl-nss
  "CP338 (a): the namespace `ns` with, when it is an inline namespace, the namespaces enclosing it as far as the first that is
  not ([basic.lookup.argdep]/3: an inline namespace's enclosing namespace is associated too; std::__cxx11's std, where
  operator+(const _CharT*, const basic_string&) is)."
  [ns]
  (loop [s ns out [ns]]
    (let [pa (:parent s)]
      (if (and pa (= :ns (:kind s)) (.containsKey ^java.util.HashMap (:names s) " inline"))
        (recur pa (conj out pa))
        out))))

(defn- enum-assoc
  "cpp-s11: an enumeration's associated entities ([basic.lookup.argdep]/3.3): its innermost enclosing namespace (with
  adl-nss's inline enclosers), and when it is a class member that class, as [:ns NS] and [:cls CID]."
  [eid]
  (when-let [es (:scope (abi/enm eid))]
    (let [ds (:parent es)
          ns (loop [s ds] (if (or (nil? s) (= :ns (:kind s))) s (recur (:parent s))))]
      (concat (when ns (map (fn [n] [:ns n]) (adl-nss ns)))
              (when-let [c (:cls ds)] [[:cls c]])))))

(defn adl-class-nss
  "cpp-s3: the namespaces associated with the class `cid` ([basic.lookup.argdep]/3): its innermost enclosing namespace's
  (adl-nss), its bases', and for a class template's specialization its template type arguments' (classes, and the classes
  pointers, references and arrays name), each class once; pr77550.C's distance(begin, end), std::distance found through an
  iterator adaptor's argument std::F<...>. Scopes by identity."
  [cid]
  (let [seen (java.util.HashSet.) out (java.util.ArrayList.) nss (java.util.IdentityHashMap.)]
    (letfn [(ty! [t]
              (cond (map? t) (let [t (abi/unq t)]
                               (cond (abi/class? t) (cls! (:id t))
                                     ;; (cpp-s11: an enumeration's namespace and class, [basic.lookup.argdep]/3.3, also as
                                     ;; a template argument's, /3.2)
                                     (abi/enum? t) (doseq [[k x] (enum-assoc (:id t))]
                                                     (if (= :cls k) (cls! x) (when-not (.containsKey nss x) (.put nss x true) (.add out x))))
                                     (#{:ptr :ref :rref :arr} (:k t)) (ty! (or (:to t) (:of t)))
                                     (:pack t) (doseq [x (:pack t)] (ty! x))
                                     :else nil))
                    :else nil))
            (cls! [cid]
              (when (and cid (.add seen cid))
                (let [c (abi/cls cid)]
                  (when-let [o (:outer c)]
                    (doseq [n (adl-nss (loop [s o] (if (or (nil? s) (= :ns (:kind s))) s (recur (:parent s)))))]
                      (when (and n (not (.containsKey nss n))) (.put nss n true) (.add out n))))
                  (doseq [b (:bases c)] (cls! (:cls b)))
                  (doseq [a (:targs c)] (ty! a)))))]
      (if (map? cid) (ty! cid) (cls! cid))
      (vec out))))

(defn- adl-classes
  "cpp-s8: the classes associated with the arguments `args` ([basic.lookup.argdep]/3: each class argument's class, its
  bases, a specialization's template type arguments' classes; a pointer's or reference's pointee's), as a set of ids."
  [args]
  (let [seen (java.util.HashSet.)]
    (letfn [(ty! [t]
              (when (map? t)
                (let [t (abi/unq t)]
                  (cond (abi/class? t) (cls! (:id t))
                        ;; (cpp-s11: a member enumeration's class, [basic.lookup.argdep]/3.3)
                        (abi/enum? t) (doseq [[k x] (enum-assoc (:id t)) :when (= :cls k)] (cls! x))
                        (#{:ptr :ref :rref :arr} (:k t)) (ty! (or (:to t) (:of t)))
                        (sequential? (:pack t)) (doseq [x (:pack t)] (ty! x))
                        :else nil))))
            (cls! [cid]
              (when (and cid (.add seen cid))
                (let [c (abi/cls cid)]
                  (doseq [b (:bases c)] (cls! (:cls b)))
                  (doseq [a (:targs c)] (ty! a)))))]
      (doseq [a args] (ty! (:ty a)))
      (set seen))))

(defn- friend-visible?
  "cpp-s8: whether the entity `e` (a lookup's entry) is visible to a call with arguments of the associated classes `acls`:
  a friend function (template) defined in a class and not declared in its namespace (a hidden friend, [class.friend]/7,
  [namespace.memdef]/3) is found by argument-dependent lookup alone, when its class is associated ([basic.lookup.argdep]/4.3);
  <bits/unreachable_sentinel.h>'s `template<weakly_incrementable _It> friend bool operator==(unreachable_sentinel_t,
  const _It&)` had been a candidate for every `a == b`, and its constraint's satisfaction for a __normal_iterator recursed
  through iterator_traits into itself."
  [acls e]
  (let [c (:friend-cls e)] (or (nil? c) (contains? acls c))))

(defn- befriended?
  "cpp-rt-own4 (the code generator): whether the hidden friend `e` named `nm` is declared a friend by one of the associated
  classes `acls` ([basic.lookup.argdep]/4.3: a friend declared in an associated class is visible, wherever it is defined);
  each class's friend declarations alone (template.ae's friend!) declared here once, on the first lookup that asks, and
  matched by signature."
  [acls e nm]
  (and (not (checking?)) (:friend-cls e)
       (let [g (fnd (:id e))]
         (some (fn [a]
                 (let [ds (get (:friend-decls (abi/cls a)) nm)]
                   (some (fn [i]
                           (let [d (nth ds i)
                                 fid (if (contains? d :fid)
                                       (:fid d)
                                       (let [fid (try (declare-fn! (:fs d) (:k d)) (catch Exception _ nil))]
                                         (abi/update-cls! a assoc-in [:friend-decls nm i :fid] fid)
                                         fid))]
                             (and fid (same-sig? (fnd fid) g))))
                         (range (count ds)))))
               acls))))

(defn- adl-fns
  "The functions named `nm` in the namespaces of the class arguments' classes ([basic.lookup.argdep], for classes)."
  [args nm]
  (distinct
   (for [a args
         ;; (cpp-s4: a pointer's, [basic.lookup.argdep]/3.4, its pointee's)
         :let [pt (loop [t (abi/unq (abi/non-ref (:ty a)))] (if (abi/ptr? t) (recur (abi/unq (:to t))) t))
               ;; (cpp-s11: an enumeration's too, [basic.lookup.argdep]/3.3: <system_error>'s error_condition(errc) calls
               ;; make_error_condition(__e) after `using __adl_only::make_error_condition;`, a deleted nullary function,
               ;; and std::make_error_condition(errc) is found by the enumeration errc's namespace alone; it had been
               ;; "no viable function among 1 for 1 arguments")
               cid (or (class-id pt) (when (abi/enum? pt) pt))] :when cid
         :let [acls (adl-classes args)]
         ns (adl-class-nss cid)
         e (binding [*cutoff* Long/MAX_VALUE] (own-names ns nm)) :when (and (= :fn (:e e)) (or (friend-visible? acls e) (befriended? acls e nm)))]
     (:id e))))

(defn- sure-assoc-nss
  "CX12 (the checker): the associated namespaces of the arguments `args` ([basic.lookup.argdep]/3) when the slice knows
  them all -- each argument of a fundamental type, an enumeration, a pointer or reference to one, or a class that is no
  template's specialization, with its bases' classes the same -- and no class of the unit declares a friend (a hidden
  friend is found by ADL alone); nil when unsure."
  [args]
  ;; (cpp-singles: a friend class declaration, or a friend class template's, makes no function ADL could find, [basic.lookup.argdep]/4.3
  ;; naming friend functions alone: concepts-friend2.C's S<X> with `friend class Foo<T>;`)
  (when (not-any? #(and (:has-friends %) (or (:friend-fn-any %) (:friend-unknown %) (seq (:friend-fns %)))) (vals @abi/*classes*))
    (let [ns-of (fn [s] (loop [s s] (if (or (nil? s) (= :ns (:kind s))) s (recur (:parent s)))))
          out (java.util.ArrayList.)
          ok (atom true)
          cls! (fn cls! [cid]
                 (let [c (abi/cls cid)]
                   (if (or (:tmpl c) (:lambda c) (nil? (:outer c)))
                     (reset! ok false)
                     (do (when-let [n (ns-of (:outer c))] (.add out n))
                         (doseq [b (:bases c)] (cls! (:cls b)))))))]
      (doseq [a args
              :let [t (loop [t (abi/unq (abi/non-ref (:ty a)))] (if (abi/ptr? t) (recur (abi/unq (:to t))) t))]]
        (cond (abi/class? t) (cls! (:id t))
              (abi/enum? t) (reset! ok false)
              (or (abi/arith? t) (abi/void? t)) nil
              :else (reset! ok false)))
      ;; (scopes by identity: a scope's map holds its parent's)
      (when @ok (let [seen (java.util.IdentityHashMap.)]
                  (vec (filter #(when-not (.containsKey seen %) (.put seen % true) true) out)))))))

(defn- declared-in? [nss ^String nm]
  (some (fn [s] (seq (filter #(#{:fn :tmpl} (:e %)) (binding [*cutoff* Long/MAX_VALUE] (own-names s nm))))) nss))

(defn- no-operator!
  "CX12 (the checker): an operator expression with a class operand that no overloaded operator was found for
  ([over.match.oper]/3: no member candidate, no non-member found by unqualified lookup -- at a template's definition,
  [temp.res]/[temp.dep.candidate] -- or by ADL, and no operator template among them) and that has no conversion function, so
  no built-in candidate applies ([over.built]): ill-formed (clang's err_ovl_no_viable_oper, \"invalid operands to binary
  expression\"; gcc's \"no match for 'operator@'\"). Only where the slice is sure: the associated namespaces known
  (sure-assoc-nss) and none declaring the operator's name."
  [ctx ^String o args]
  (when (and (checking?) (not (#{"," "=" "->" "()" "[]"} o)) (not (and (= o "&") (= 1 (count args)))))
    (let [nm (str "operator" o)
          cids (keep #(class-id (:ty %)) args)]
      (when (and (seq cids)
                 (every? #(and (empty? (conv-fns %)) (empty? (conv-tmpls %))) cids)
                 (not (some #(= :enum (:k (abi/unq (abi/non-ref (:ty %))))) args))
                 (empty? (class-lookup (first cids) nm))
                 (or (nil? (class-id (:ty (first args)))) (= (first cids) (class-id (:ty (first args)))))
                 (empty? (filter #(#{:fn :tmpl} (:e %)) (lookup (:scope ctx) nm)))
                 (when-let [nss (sure-assoc-nss args)] (not (declared-in? nss nm))))
        (fail :nomatch "no match for '" nm "' (operand types " (pr-str (mapv #(select-keys (abi/unq (abi/non-ref (:ty %))) [:k :n :id]) args)) ")")))))

(defn- adl-not-found!
  "CX12 (the checker): an unqualified call in a function template's specialization that nothing names: not unqualified
  lookup at the template's definition ([temp.dep.candidate]: the declarations visible there), not ADL at its
  instantiation, though a later declaration at namespace scope declares the name ([temp.res]/[temp.point]; clang's
  err_not_found_by_two_phase_lookup, gcc's \"... not declared in this scope, and no declarations were found by
  argument-dependent lookup at the point of instantiation\"). Only where the associated namespaces are sure."
  [ctx callee args]
  (when (and (checking?) (seq args) (:name callee) (not (:qualified callee)) (not (:obj callee)))
    (let [f (when-let [i (:fn-id ctx)] (fnd i))
          nm (:name callee)]
      (when (and f (:tinst f) (not (:cls f)) (not (:this-type ctx))
                 (seq (filter #(#{:fn :tmpl} (:e %)) (binding [*cutoff* Long/MAX_VALUE] (lookup (:scope ctx) nm))))
                 (when-let [nss (sure-assoc-nss args)] (not (declared-in? nss nm))))
        (fail :adl "call to function '" nm "' that is neither visible in the template definition nor found by argument-dependent lookup")))))

(defn- undeclared-call!
  "CX12 (the checker): an unqualified call outside any template's specialization that unqualified lookup finds nothing
  for and whose associated namespaces (sure-assoc-nss) declare no function of the name: no ADL candidate either
  ([basic.lookup.argdep]/4; clang's err_undeclared_var_use, gcc's \"was not declared in this scope\")."
  [ctx callee args]
  (when (and (checking?) (seq args) (:name callee) (not (:qualified callee)) (not (:obj callee)))
    (let [f (when-let [i (:fn-id ctx)] (fnd i))
          nm (:name callee)]
      (when (and f (not (:tinst f)) (not (:this-type ctx)) (not (str/starts-with? (str nm) "__"))
                 (not (str/starts-with? (str nm) "operator")))
        (when-let [nss (sure-assoc-nss args)]
          (when (and (seq nss) (not (declared-in? nss nm))
                     ;; (nor any declaration visible from here, wherever it is in the unit: not a declaration the slice
                     ;; would have hidden by its position)
                     (empty? (binding [*cutoff* Long/MAX_VALUE] (lookup (:scope ctx) nm))))
            (fail :undecl "use of undeclared identifier '" nm "'")))))))

(declare block-ctx)

;; ---------------------------------------------------------------------------------------------
;; GNU's __atomic builtins (G5c; clang's AtomicExpr: Sema::BuildAtomicExpr's operand forms for the GNU builtins, the
;; operands' conversions of [atomics.types.operations] as GCC documents them, "Built-in Functions for Memory Model Aware
;; Atomic Operations"): libsupc++'s guard.cc, new_handler.cc, atomicity.h, std::atomic's members

(def ^:private atomic-forms
  ;; name -> [which shape rmw-op post?]: shape the operands after the pointer, :v a value of T, :vp a pointer to T,
  ;; :o an order, :w the weak flag
  (merge
   {"__atomic_load_n" [:load [:o]] "__atomic_load" [:load [:rp :o]]
    "__atomic_store_n" [:store [:v :o]] "__atomic_store" [:store [:vp :o]]
    "__atomic_exchange_n" [:xchg [:v :o]] "__atomic_exchange" [:xchg [:vp :rp :o]]
    "__atomic_compare_exchange_n" [:cmpxchg [:ep :v :w :o :fo]] "__atomic_compare_exchange" [:cmpxchg [:ep :vp :w :o :fo]]
    "__atomic_test_and_set" [:tas [:o]] "__atomic_clear" [:clear [:o]]
    ;; (CP338 (a): the fences, no pointer: clang's EmitBuiltinExpr for __atomic_thread_fence and __atomic_signal_fence)
    "__atomic_thread_fence" [:fence [:o]] "__atomic_signal_fence" [:sfence [:o]]}
   (into {} (for [op ["add" "sub" "and" "or" "xor" "nand" "min" "max"]
                  [nm post] [[(str "__atomic_fetch_" op) false] [(str "__atomic_" op "_fetch") true]]]
              [nm [:rmw [:v :o] (keyword op) post]]))))

(defn atomic-builtin? [^String nm] (contains? atomic-forms nm))

(defn- atomic-expr
  "The node of a GNU __atomic builtin `nm` applied to the argument nodes `args`."
  [ctx ^String nm args]
  (if (#{:fence :sfence} (first (atomic-forms nm)))
    (let [_ (when-not (= 1 (count args)) (fail :expr nm " with " (count args) " arguments"))
          o (convert-scalar (rv (analyze ctx (first args))) abi/int* false)]
      {:op :atomic :which (first (atomic-forms nm)) :o o :oc (:v (ce-try o)) :ty abi/void :cat :pr})
  (let [[which shape rmw post] (or (atomic-forms nm) (fail :expr "the atomic builtin " nm))
        _ (when-not (= (count args) (inc (count shape))) (fail :expr nm " with " (count args) " arguments"))
        p (rv (analyze ctx (first args)))
        _ (when-not (abi/ptr? (abi/unq (:ty p))) (fail :expr nm " of a non-pointer"))
        vt (let [t (abi/unq (:to (abi/unq (:ty p))))] (dissoc t :v))
        vt (if (#{:tas :clear} which) abi/char* vt)
        ;; (the generic forms, every operand through a pointer, of a float or a double: the integer of its size, the bits
        ;; moved as clang's EmitAtomicExpr does through its integer-typed temporaries; cpp-s3: std::atomic<double>'s load,
        ;; store, exchange and fetch_add's compare-exchange loop, runtime/deferred.cpp)
        vt (if (and (abi/floating? vt) (not (some #{:v} shape)) (#{4 8} (abi/size-of vt))) (if (= 4 (abi/size-of vt)) abi/uint* abi/ulong*) vt)
        _ (when-not (or (abi/integral? vt) (abi/ptr? vt) (= :enum (:k vt)) (#{:tas :clear} which)) (fail :type nm " of " (pr-str vt)))
        _ (when (and (= :rmw which) (not (abi/integral? vt))) (fail :type nm " of " (pr-str vt)))
        _ (when-not (#{1 2 4 8} (abi/size-of vt)) (fail :type nm " of a " (abi/size-of vt) "-byte type"))
        ops (into {} (map (fn [k a]
                            (let [e (rv (analyze ctx a))]
                              [k (case k
                                   :v (convert-scalar e vt false)
                                   (:o :fo) (convert-scalar e abi/int* false)
                                   :w (convert-scalar e abi/bool* false)
                                   (:vp :rp :ep) e)]))
                          shape (rest args)))
        const (fn [k] (when-let [e (ops k)] (:v (ce-try e))))]
    (merge {:op :atomic :which which :rmw rmw :post post :p p :vt vt :oc (const :o) :foc (const :fo) :wc (const :w) :cat :pr
            :ty (case which (:load :xchg) (if (or (:rp ops) (:vp ops)) abi/void vt) :rmw vt (:cmpxchg :tas) abi/bool* abi/void)}
           ops))))

(def ^:private value-builtins
  {"__builtin_expect" :expect "__builtin_expect_with_probability" :expect "__builtin_constant_p" :constant-p
   "__builtin_is_constant_evaluated" :is-constant-evaluated
   "__builtin_addressof" :addressof
   ;; (queue 393, W4: <coroutine>'s coroutine_handle over the frame, clang's CGCoroutine's llvm.coro.done, .resume, .destroy
   ;; and .promise, which CoroCleanup lowers as the switch ABI lays the frame out: the resume and destroy functions' pointers
   ;; first, the promise after them at its alignment; arbace.cpp.codegen's :coro-builtin)
   "__builtin_coro_done" :coro-done "__builtin_coro_resume" :coro-resume "__builtin_coro_destroy" :coro-destroy
   "__builtin_coro_promise" :coro-promise "__builtin_coro_noop" :coro-noop
   ;; (cpp-s8: the type-generic floating-point classifications <format>'s __formatter_fp uses)
   "__builtin_signbit" :signbit "__builtin_isfinite" :isfinite
   ;; (cpp-rt-own: and floating_from_chars.cc's __builtin_isinf, with __builtin_isnan beside it)
   "__builtin_isinf" :isinf "__builtin_isnan" :isnan
   ;; (cpp-rt-own4: floating_to_chars.cc's __builtin_fpclassify)
   "__builtin_fpclassify" :fpclassify
   "__builtin_alloca" :alloca
   "__builtin_clear_padding" :clear-padding
   ;; (cpp-tzdb: x86's spin-wait hint, <bits/atomic_wait.h>'s __thread_relax, clang's llvm.x86.sse2.pause, which the lowering drops)
   "__builtin_ia32_pause" :pause
   ;; (n-cpp-eval: GCC's __builtin_shuffle of GNU vectors, g++.dg's torture/vshuf-*.C)
   "__builtin_shuffle" :shuffle
   "__atomic_always_lock_free" :lock-free "__atomic_is_lock_free" :lock-free
   "__builtin_va_start" :va-start "__builtin_c23_va_start" :va-start "__builtin_va_end" :va-end "__builtin_va_copy" :va-copy
   "__builtin_add_overflow" :add-overflow "__builtin_sub_overflow" :sub-overflow "__builtin_mul_overflow" :mul-overflow
   ;; the bit counts and byte swaps (G5c: <bit>'s std::__popcount, __countl_zero, __countr_zero over __builtin_popcountg,
   ;; __builtin_clzg, __builtin_ctzg; libsupc++'s new_opa.cc), clang's CGBuiltin: llvm.ctpop, llvm.ctlz and llvm.cttz with
   ;; zero undefined (x86's isCLZForZeroUndef), a fallback operand selected for zero, the count an int; llvm.bswap
   "__builtin_popcount" [:ctpop :uint] "__builtin_popcountl" [:ctpop :ulong] "__builtin_popcountll" [:ctpop :ullong] "__builtin_popcountg" [:ctpop nil]
   "__builtin_clz" [:ctlz :uint] "__builtin_clzl" [:ctlz :ulong] "__builtin_clzll" [:ctlz :ullong] "__builtin_clzg" [:ctlz nil]
   "__builtin_ctz" [:cttz :uint] "__builtin_ctzl" [:cttz :ulong] "__builtin_ctzll" [:cttz :ullong] "__builtin_ctzg" [:cttz nil]
   "__builtin_bswap16" [:bswap :ushort] "__builtin_bswap32" [:bswap :uint] "__builtin_bswap64" [:bswap :ulong]
   ;; (queue 380, W3d: <limits>'s numeric_limits<T>::infinity() and quiet_NaN(), c++locale.cc's long double's; clang folds
   ;; them, its constant evaluator's VisitCallExpr: HUGE_VAL and inf a constant infinity of the type, nan("") the type's
   ;; default quiet NaN)
   "__builtin_huge_val" :fconst "__builtin_huge_valf" :fconst "__builtin_huge_vall" :fconst
   "__builtin_inf" :fconst "__builtin_inff" :fconst "__builtin_infl" :fconst
   "__builtin_nan" :fconst "__builtin_nanf" :fconst "__builtin_nanl" :fconst
   ;; (queue 380, W3d: hashtable_c++0x.cc's __builtin_floor: the rounding builtins clang's CGBuiltin writes as LLVM's
   ;; intrinsics whatever -fmath-errno says, llvm.floor and the rest of the operand's type; errno-setting ones stay calls)
   "__builtin_floor" :fmath "__builtin_floorf" :fmath "__builtin_floorl" :fmath
   "__builtin_ceil" :fmath "__builtin_ceilf" :fmath "__builtin_ceill" :fmath
   "__builtin_trunc" :fmath "__builtin_truncf" :fmath "__builtin_truncl" :fmath
   "__builtin_round" :fmath "__builtin_roundf" :fmath "__builtin_roundl" :fmath
   "__builtin_rint" :fmath "__builtin_rintf" :fmath "__builtin_rintl" :fmath
   "__builtin_nearbyint" :fmath "__builtin_nearbyintf" :fmath "__builtin_nearbyintl" :fmath
   "__builtin_fabs" :fmath "__builtin_fabsf" :fmath "__builtin_fabsl" :fmath
   ;; (cpp-singles, the checker: GNU's complex conjugate, conj of C's <complex.h>, a value of its complex operand's type)
   "__builtin_conj" :conj "__builtin_conjf" :conj "__builtin_conjl" :conj})

(defn- fp-builtin
  "A floating builtin's stem and type (queue 380): __builtin_floorl -> [\"floor\" long double], f float, l long double."
  [^String nm]
  (let [b (subs nm (count "__builtin_"))
        stems #{"huge_val" "inf" "nan" "floor" "ceil" "trunc" "round" "rint" "nearbyint" "fabs"}
        b0 (subs b 0 (dec (count b)))]
    (cond (stems b) [b abi/double*]
          (and (stems b0) (str/ends-with? b "f")) [b0 abi/float*]
          (and (stems b0) (str/ends-with? b "l")) [b0 (abi/b :ldouble)]
          :else (fail :name "unknown name " nm))))

(def ^:private std-builtins
  {"move" :cast "forward" :cast "move_if_noexcept" :cast "as_const" :cast "forward_like" :cast "addressof" :addr "__addressof" :addr})

(declare cast-expr)

(defn analyze-call [ctx callee args]
  (case (:op callee)
    ;; (cpp-rt-own4: an explicit destructor call of a class not complete where analyzed, member-expr's :late-dtor; the
    ;; destructor found when the call is written)
    :late-dtor (if (seq args)
                 (fail :call "a destructor call with arguments")
                 {:op :late-dtor-call :cls (:cls callee) :obj (:obj callee) :virtual-ok (not (:qualified callee)) :ty abi/void :cat :pr})
    :mbound (let [ft (:fty callee)]
              {:op :mcall :obj (:obj callee) :m (:m callee) :fty ft
               :args (vec (map-indexed (fn [i a] (if (< i (count (:ps ft))) (init-for (nth (:ps ft) i) a ctx :copy) {:i :expr :e (rv a)})) args))
               :ty (abi/non-ref (:ret ft)) :cat (case (:k (:ret ft)) :ref :lv :rref :xv :pr)})
    :fnset (let [;; the function templates' specializations their deduction from the arguments declares
                 tcands (when-let [h (:call-candidates @hooks)] (h ctx callee args))
                 ms (mapv fnd (concat (:fns callee) tcands))
                 obj (:obj callee)
                 any-method (some #(and (:cls %) (not (:static %))) ms)
                 obj (or obj (when (and (:implicit-this callee) any-method (:this-type ctx)) (cx-via (deref-node (this-expr ctx)) (:cx-qcls callee))))
                 ;; (cpp-s8: a hidden friend only by ADL, friend-visible?)
                 ;; (queue 367-2 (a), the code generator: a specialization of one of the call's templates is its candidate through
                 ;; that template's deduction alone ([temp.over]/1), not again as the function its name lookup found: two of one
                 ;; type made `_M_construct<true>(...)` ambiguous with `_M_construct<false>`)
                 tset (set (:tmpls callee))
                 ;; (cpp-tpl2, the checker: with explicit template arguments too, a specialization made before for other
                 ;; arguments is no candidate of its own, concepts-explicit-spec7.C's A<int>::f<43>() after f<42>())
                 own-fns (if (and (checking?) (not (:targs-text callee))) (:fns callee) (remove #(contains? tset (:tid (:tinst (fnd %)))) (:fns callee)))
                 ;; (queue 514, the checker: a template-id names the specializations of the templates its name finds, never a
                 ;; function that is no template ([temp.names]/3 with P0846, [over.call.func]): those found are no candidates,
                 ;; sure drops, cpp2a/fn-template17.C's `f<T> ()` of a using-declaration's `void f ()`)
                 ;; (cpp-tzdb, the code generator too: a template-id names the templates alone, [temp.names]/3 -- filesystem::path's
                 ;; `string() const { return string<char>(); }` had called itself, the non-template string() among the candidates)
                 nontmpl (when (and (:targs-text callee) (or (checking?) (seq (:tmpls callee))))
                           (filter #(let [f (fnd %)] (and (not (:tinst f)) (not (:tid f)))) own-fns))
                 own-fns (if (seq nontmpl) (remove (set nontmpl) own-fns) own-fns)
                 ;; (cpp-rt-own4, the code generator: no argument-dependent lookup for a qualified name, [basic.lookup.argdep]/1:
                 ;; floating_from_chars.cc's `fast_float::from_chars(first, last, value, fmt)` had found std::from_chars through
                 ;; the std::chars_format argument, a better match than the template, from_chars(double&) calling itself)
                 cands (concat (let [acls (adl-classes args)] (filter #(friend-visible? acls (fnd %)) own-fns)) tcands (when (and (not (:obj callee)) (not any-method) (not (and (:qualified callee) (not (checking?))))) (adl-fns args (or (:name callee) (:name (first ms))))))
                 _ (when (and (empty? cands) (System/getenv "CPP_TMPL_TRACE"))
                     (binding [*out* *err*] (println "call of" (:name callee) "no candidates:" (count (:fns callee)) "fns" (count (:tmpls callee)) "templates" (pr-str (map :ty args)))))
                 ;; (queue 588, the checker: a template argument-dependent lookup found, dropped by its deduction or constraints,
                 ;; makes the call's "no viable function", judged by resolve-overload with those drops, not an unknown name:
                 ;; cpp2a/concepts-recursive-sat2.C's foo(t) in Fooable's requirement once the concept's definition binds
                 ;; its lookup, foo found by ADL alone)
                 _ (when (and (empty? cands) (empty? (:tmpls callee)) (empty? nontmpl)
                              (not (and (checking?) (pos? (+ (long (or (:sure-drops (meta tcands)) 0)) (long (or (:unsure-drops (meta tcands)) 0)))))))
                     (adl-not-found! ctx callee args) (undeclared-call! ctx callee args)
                      ;; (queue 492, the checker: a literal operator's name no lookup finds, called or a user-defined
                      ;; literal's, [over.literal], [lex.ext]/2-8, its arguments of no class type (no ADL candidate either);
                      ;; GCC's "'operator\"\"_X' was not declared in this scope", "unable to find ... literal operator")
                      (when (and (checking?) (not (:qualified callee)) (not (:obj callee))
                                 (str/starts-with? (str (:name callee)) "operator\"\"")
                                 (not-any? #(let [t (abi/unq (abi/non-ref (:ty %)))] (or (abi/class? t) (abi/enum? t) (nil? t))) args)
                                 (cx-undeclared? (:scope ctx) (:name callee)))
                        (fail :undecl "use of undeclared identifier '" (:name callee) "'"))
                      ;; (queue 492, the checker: an unqualified call, in a template's specialization or a member function
                      ;; too, of a name no declaration of the unit has, so neither unqualified lookup nor argument-dependent
                      ;; lookup finds a candidate; with explicit template arguments ([temp.names]/3, P0846) too)
                      (when (and (checking?) (not (:qualified callee)) (not (:obj callee)) (cx-declared-nowhere? (:name callee)))
                        (fail :undecl "use of undeclared identifier '" (:name callee) "'"))
                      ;; (queue 588, the checker: in a main file's concept's constraint, at its definition's cutoff, an
                      ;; unqualified call whose name no declaration before the concept has and argument-dependent lookup finds
                      ;; nothing for: the substitution surely fails, [temp.dep.candidate]/1; cpp2a/concepts-recursive-sat3.C's
                      ;; foo(t) for an int)
                      (when (and (checking?) *cx-concept-cutoff* (= (long *cutoff*) (long *cx-concept-cutoff*))
                                 (not (:qualified callee)) (not (:obj callee)) (:name callee))
                        (fail :undecl "use of undeclared identifier '" (:name callee) "'"))
                      (fail :name "unknown name " (:name callee)))
                 ;; (a function found twice, through a using-declaration and its class: one candidate; G4)
                 fid (binding [*drops* (cond-> (meta tcands) (seq nontmpl) (update :sure-drops (fnil + 0) (count (distinct nontmpl))))]
                       (resolve-overload (distinct cands) args obj))
                 f (fnd fid)
                 ;; (cpp-tpl2, the checker: in a constraint's satisfaction, a non-static member function called by a qualified name
                 ;; with no object and no `this`, [class.mfct.non.static]/1 (expr.prim.id.general/3): GCC's "cannot call member
                 ;; function ... without object", a sure substitution failure of the atom, cpp2a/concepts-class3.C)
                 _ (when (and (checking?) *cx-constraint-of* (:qualified callee) (nil? obj) (nil? (:this-type ctx))
                              (:cls f) (not (:static f)) (= :method (:kind f)))
                     (fail :call "cannot call member function '" (:name f) "' without object"))
                 ;; (CP324 (a): a function found through a class's using-declaration has that declaration's access as a
                 ;; member of its class)
                 _ (when (:member-access callee)
                     (if-let [[uc ua] (get (:cx-using callee) fid)]
                       (check-access! ctx uc (:name f) ua (:cx-nc callee) (when-not (:static f) (:cx-obj callee)))
                       (check-access! ctx (:cls f) (:name f) (:access f) (:cx-nc callee) (when-not (:static f) (:cx-obj callee)))))
                 std-builtin (when (and (= 1 (count args)) (= [[:ns "std"]] (:path f)) (not (:cls f)))
                               (std-builtins (:name f)))]
             (cond
               ;; the standard library's functions clang builds in (Builtins.td's LIBBUILTIN std::move, forward,
               ;; move_if_noexcept, as_const, addressof, __addressof, forward_like: CodeGen folds the call to its
               ;; argument, no function emitted, even at -O0; G4)
               (= std-builtin :cast) (cast-expr ctx (:ret (:ty f)) (first args) true)
               ;; std::__is_constant_evaluated(), always_inline: clang inlines it even at -O0 (the AlwaysInliner),
               ;; its run-time value false; no function emitted (G4); marked :ice, the evaluator's true when manifestly
               ;; constant-evaluated (CP378 (a))
               (and (empty? args) (= [[:ns "std"]] (:path f)) (= "__is_constant_evaluated" (:name f)))
               {:op :int :v 0 :ice true :ty abi/bool* :cat :pr}
               (= std-builtin :addr) (let [e (first args)] {:op :addr :e e :ty (abi/ptr (:ty e)) :cat :pr})
               :else
             (if (and (:cls f) (not (:static f)))
               (method-call ctx fid obj args (not (:qualified callee)))
               (fn-call ctx fid args))))
    (let [p (rv callee)
          ft (let [t (abi/unq (:ty p))] (if (abi/ptr? t) (:to t) t))]
      ;; (queue 526, the checker: a callee whose type the slice left undeduced or dependent -- a class template's
      ;; specialization's `static constexpr auto a = [](auto n) { ... };`, cpp2a/concepts-lambda2.C's foo1.a(5.5) -- is the
      ;; slice's, not "call of a non-function")
      (when (and (checking?) (not (abi/fn? ft)) (or (nil? ft) (#{:auto :dep :tdep :tparam} (:k ft))))
        (fail :type "a call of an undeduced callee type"))
      (when-not (abi/fn? ft) (fail :call "call of a non-function"))
      {:op :icall :callee p :fty ft
       :args (vec (map-indexed (fn [i a] (if (< i (count (:ps ft))) (init-for (nth (:ps ft) i) a ctx :copy) {:i :expr :e (rv a)})) args))
       :ty (abi/non-ref (:ret ft)) :cat (case (:k (:ret ft)) :ref :lv :rref :xv :pr)})))

(declare operator-call)

(defn- rewritten-better?
  "cpp-rt-own4 (the code generator): whether x <=> y's best candidate, a function template's specialization of the same parameter
  types as `best` (a non-member operator@'s, another template's), is more specialized than it (template.ae's tiebreak: partial
  ordering, then [temp.func.order]/6's more constrained), so the rewritten candidate wins, [over.match.best]/2.5 before /2.8."
  [ctx o args best ms]
  (when (and (not (checking?)) (#{"<" ">" "<=" ">="} o) (= 2 (count args)) (not (contains? ms best)) (:tinst (fnd best)) (:tiebreak @hooks))
    (let [c (try (operator-call ctx "<=>" args) (catch arbace.lang.ExceptionInfo _ nil))
          cf (when (and (= :call (:op c)) (nil? (:obj c))) (fnd (:fn c)))
          bf (fnd best)]
      (boolean (and cf (:tinst cf) (not= (:tid (:tinst cf)) (:tid (:tinst bf)))
                    (= (mapv #(abi/unq (abi/non-ref %)) (:ps (:ty cf))) (mapv #(abi/unq (abi/non-ref %)) (:ps (:ty bf))))
                    ((:tiebreak @hooks) (:fn c) best 2))))))

(def ^:private ^:dynamic *reversing-eq*
  "cpp-tzdb: the operand types [y x] of the reversed y == x being resolved (reversed-eq), so that it is not reversed back."
  nil)

(defn- reversible-eq?
  "cpp-tzdb (the code generator): whether x == y with no viable candidate may take a reversed one, y == x's ([over.match.oper]/3.4.4,
  C++20), once (not from inside a reversed one)."
  [o args]
  (and (not (checking?)) (= o "==") (= 2 (count args)) (>= (long *cxx-year*) 20) (not= *reversing-eq* (mapv :ty args))
       (some #(class-id (:ty %)) args)))

(defn- reversed-eq
  "cpp-tzdb (the code generator): x == y by a reversed candidate, the operator== found for y == x ([over.match.oper]/3.4.4): a
  string == string_view by <string_view>'s operator==(basic_string_view, __type_identity_t<basic_string_view>), its second
  parameter taking the string by its conversion function; equality_comparable_with<string_view, const string&>, tzdb.cc's
  ranges::equal_range over Rule::name (nil when none is viable that way either)."
  [ctx args]
  (binding [*reversing-eq* [(:ty (second args)) (:ty (first args))]] (operator-call ctx "==" [(second args) (first args)])))

(defn operator-call
  "An overloaded operator's call ([over.match.oper]): the members of the first operand's class and the non-members found
  by unqualified lookup and ADL; nil when none is viable (the built-in operator then)."
  [ctx o args]
  (let [nm (str "operator" o)
        [l & more] args
        lc (class-id (:ty l))
        mtmpls (when lc (vec (keep (fn [[_ x]] (when (and (= :tmpl (:e x)) (= :fn (:tk x))) (:id x))) (class-lookup lc nm))))
        ;; the member operator templates' specializations deduced from the other operands (G4: ranges::iter_move's
        ;; operator() template)
        mspecs (when (and (seq mtmpls) (:call-candidates @hooks))
                 (try ((:call-candidates @hooks) ctx {:op :fnset :fns [] :name nm :tmpls mtmpls :obj l} more)
                      (catch arbace.lang.ExceptionInfo _ nil)))
        members (when lc (concat (second (method-set-of lc nm)) mspecs))
        found (let [acls (adl-classes args)] (filter #(friend-visible? acls %) (lookup (:scope ctx) nm)))
        ;; the operator function templates found by lookup and ADL, their specializations deduced from the operands
        ;; (G4: <bits/stl_iterator.h>'s operator- of two __normal_iterators)
        tspecs (when-let [h (:call-candidates @hooks)]
                 (try (h ctx {:op :fnset :fns [] :name nm :tmpls (mapv :id (filter #(and (= :tmpl (:e %)) (= :fn (:tk %))) found))} args)
                      (catch arbace.lang.ExceptionInfo _ nil)))
        frees (concat (filter #(not (:cls (fnd %))) (map :id (filter #(= :fn (:e %)) found))) (adl-fns args nm) tspecs)
        cands (concat (map (fn [m] [:m m]) members) (map (fn [f] [:f f]) (distinct frees)))]
    (when (and (empty? cands) (System/getenv "CPP_OP_TRACE")) (binding [*out* *err*] (println "operator" o "no candidates for" (pr-str (map :ty args)) (pr-str (map #(some-> (class-id (:ty %)) abi/cls ((juxt :name :lambda :targs))) args)))))
    (if (empty? cands)
      (cond
        ;; (cpp-tpl2, the checker: a call of a class's object whose operator() templates all drop out surely, a closure's
        ;; constrained call operator, [over.call.object]/1 with [temp.deduct]/8 and [over.match.viable]/3: GCC's "no match for
        ;; call", with the drops' explanations, call-candidates' meta)
        (and (= o "()") (checking?) (seq mtmpls) (empty? (second (method-set-of lc nm)))
             (let [{:keys [sure-drops unsure-drops]} (meta mspecs)] (and sure-drops (pos? (long sure-drops)) (zero? (long (or unsure-drops 0))))))
        (throw (ex-info (str "codegen: no viable function among " (:sure-drops (meta mspecs)) " for " (count more) " arguments")
                        (cond-> {:codegen/refused :overload} (seq (:explain (meta mspecs))) (assoc :cx/explain (vec (distinct (:explain (meta mspecs))))))))
        ;; (queue 584, the checker: an operator whose only candidates were operator templates, member or found by lookup, each
        ;; dropped surely -- its deduction failed or its constraints are not satisfied, [temp.deduct]/8, [over.match.viable]/3 --
        ;; with class operands that have no conversion function, so no built-in candidate applies, [over.match.oper]/3.3 with
        ;; [over.built]: no viable function, GCC's "no match for 'operator@'"; not the rewritten or the special operators:
        ;; cpp2a/concepts-recursive-sat5.C's `tab | 1`, concepts-pr88395.C's `a += b`)
        (and (checking?) (not (#{"=" "," "->" "()" "[]" "==" "!=" "<" ">" "<=" ">=" "<=>"} o)) (not (and (= o "&") (= 1 (count args))))
             (let [ds [(meta mspecs) (meta tspecs)]]
               (and (pos? (long (reduce + (map #(long (or (:sure-drops %) 0)) ds))))
                    (every? #(zero? (long (or (:unsure-drops %) 0))) ds)))
             (let [cids (keep #(class-id (:ty %)) args)]
               (and (seq cids) (every? #(and (empty? (conv-fns %)) (empty? (conv-tmpls %))) cids)
                    (not (some #(= :enum (:k (abi/unq (abi/non-ref (:ty %))))) args)))))
        (throw (ex-info (str "codegen: no match for '" nm "' (no viable operator template, operand types "
                             (pr-str (mapv #(select-keys (abi/unq (abi/non-ref (:ty %))) [:k :n :id]) args)) ")")
                        (cond-> {:codegen/refused :nomatch}
                          (seq (mapcat #(:explain (meta %)) [mspecs tspecs])) (assoc :cx/explain (vec (distinct (mapcat #(:explain (meta %)) [mspecs tspecs])))))))
        (= o "=") (fail :assign "no operator=")
        ;; C++20's rewritten candidate: a != b as !(a == b)
        (= o "!=") (when-let [c (operator-call ctx "==" args)] {:op :not :e (convert-scalar (rv c) abi/bool* false) :ty abi/bool* :cat :pr})
        (#{"<" ">" "<=" ">="} o) (rewritten-relational ctx o args)
        (reversible-eq? o args) (reversed-eq ctx args)
        :else nil)
      (let [;; one candidate set ([over.match.oper]/3): members as functions of the remaining operands with the object
            ;; as their first, non-members of all
            ms (set members)
            best (try (resolve-overload* (concat (map (fn [m] [m more l true]) (distinct members))
                                                 (map (fn [f] [f args nil false]) (remove ms (distinct frees))))
                                         (count args))
                      (catch arbace.lang.ExceptionInfo x (if (= :overload (:codegen/refused (ex-data x)))
                                                           (do (when (System/getenv "CPP_OP_TRACE") (binding [*out* *err*] (println "operator" o (.getMessage x) (count members) (count frees))))
                                                               (when (re-find #"ambiguous|deleted function" (.getMessage x)) (throw x))
                                                               ;; (queue 497, the checker: an assignment to a class, which has no
                                                               ;; built-in candidate ([over.built] has none for a class), whose
                                                               ;; operator= candidates are surely none viable: GCC's "no match for
                                                               ;; 'operator='")
                                                               (when (and (checking?) (= o "=") lc (not *cx-in-implicit*)
                                                                          ;; (not inside an implicit or defaulted member's body: a deleted
                                                                          ;; copy assignment's memberwise body, constexpr-tracking-const3.C)
                                                                          (not (some-> (:fn-id ctx) fnd ((some-fn :implicit :defaulted))))
                                                                          (re-find #"^codegen: no viable function among [1-9]" (.getMessage x)))
                                                                 (fail :nomatch "no match for 'operator=' (operand types " (pr-str (mapv #(select-keys (abi/unq (abi/non-ref (:ty %))) [:k :n :id]) args)) ")")))
                                                           (throw x))))]
        (cond
          (nil? best) (cond (#{"<" ">" "<=" ">="} o) (rewritten-relational ctx o args)
                            ;; (CP338 (a): none viable, a != b's rewritten candidate !(a == b), [over.match.oper]/3.4: a
                            ;; class's defaulted operator!= visible in a defaulted <=>'s body, (x <=> y) != 0 of std::strong_ordering)
                            (= o "!=") (when-let [c (operator-call ctx "==" args)] {:op :not :e (convert-scalar (rv c) abi/bool* false) :ty abi/bool* :cat :pr})
                            (reversible-eq? o args) (reversed-eq ctx args))
          ;; (cpp-rt-own4, the code generator: the built-in candidate for two operands of one enumeration type, [over.built]/16's
          ;; operator==(T, T) and the relational ones, exact matches, better than a function reached through a user-defined
          ;; conversion of an operand ([over.match.best]/2.1, [over.ics.rank]/2.1): floating_from_chars.cc's auto_locale, `ec ==
          ;; errc{}` of a std::errc, had called operator==(const error_condition&, const error_condition&) through
          ;; error_condition's converting constructor; the built-in operator then, as when none is viable)
          (and (not (checking?)) (#{"==" "!=" "<" ">" "<=" ">="} o) (= 2 (count args)) (nil? lc)
               (let [[ta tb] (map #(abi/unq (abi/non-ref (:ty %))) args)] (and (abi/enum? ta) (= ta tb)))
               (not (contains? ms best))
               (some #(abi/class? (abi/unq (abi/non-ref %))) (:ps (:ty (fnd best)))))
          nil
          ;; (cpp-rt-own4, the code generator: the rewritten candidate (x <=> y) @ 0 of a function template more specialized than
          ;; the best operator@ one, [over.match.best]/2.5 coming before /2.8's preference for the candidate not rewritten:
          ;; [temp.func.order]/6, the template parameter lists equivalent ([temp.over.link]/6: a type-constraint is not part of
          ;; the equivalence) and the parameters the same, the more constrained -- <bits/chrono.h>'s `operator<=>(const
          ;; time_point<_Clock, _Dur1>&, const time_point<_Clock, _Dur2>&)` with `three_way_comparable_with<_Dur1> _Dur2` over the
          ;; unconstrained operator<, duration's likewise: tzdb.cc's ranges::less over sys_seconds, clang's operator<=> and
          ;; operator<(strong_ordering, __unspec))
          (rewritten-better? ctx o args best ms)
          (operator-call ctx o [(operator-call ctx "<=>" args) {:op :int :v 0 :ty abi/int* :cat :pr}])
          (contains? ms best) (method-call ctx best l more true)
          :else (fn-call ctx best args))))))

(defn- rewritten-relational
  "x @ y for a relational @ by a three-way comparison ([over.match.oper]/3.4, /8): (x <=> y) @ 0, else 0 @ (y <=> x)."
  [ctx o args]
  (let [zero {:op :int :v 0 :ty abi/int* :cat :pr}
        [x y] args
        ;; (queue 510, the checker: a deleted <=> chosen surely, resolve-overload*'s CX12 rule, is the error, not a rewritten
        ;; candidate's absence, [over.match.oper]/8 with [dcl.fct.def.delete]/2: cpp2a/spaceship-synth-neg5.C's `c1 > c2`)
        three (fn [a b] (or (when (or (class-operand? a) (class-operand? b))
                              (try (operator-call ctx "<=>" [a b])
                                   (catch arbace.lang.ExceptionInfo e
                                     (if (and (checking?) (re-find #"^codegen: call to a deleted function" (str (.getMessage e)))) (throw e) nil))))
                            (try (three-way a b) (catch arbace.lang.ExceptionInfo _ nil))))]
    (or (when-let [c (three x y)] (operator-call ctx o [c zero]))
        (when-let [c (three y x)] (operator-call ctx o [zero c])))))

;; ---------------------------------------------------------------------------------------------
;; Allocation and deallocation functions ([expr.new]/9-28, [expr.delete]/7-12; clang's Sema::FindAllocationFunctions,
;; resolveAllocationOverload, resolveDeallocationOverload with UsualDeallocFnInfo::Compare, FindDeallocationFunction,
;; FindUsualDeallocationFunction, FindDeallocationFunctionForDestructor, doesUsualArrayDeleteWantSize; Itanium's array
;; cookie). A choice is {:fn id} (a declared function) or {:sym name} (an implicitly declared global one, [basic.stc.dynamic]/2,
;; when no header declares it), with :size and :align (the deallocation's implicit arguments) and an allocation's
;; :align (the alignment passed) and :places (the placement arguments' initializers).

(def ^:private new-align 16) ; __STDCPP_DEFAULT_NEW_ALIGNMENT__ on x86-64

(defn overaligned? [t] (> (long (abi/align-of t)) (long new-align)))

(defn- align-val-t [] (some-> (try (lookup-qualified *root* ["std" "align_val_t"] true) (catch arbace.lang.ExceptionInfo _ nil)) type-entity :ty))

(defn- size-t? [t] (= (abi/unq t) abi/ulong*))
(defn- align-t? [t] (let [t (abi/unq t)] (and (abi/enum? t) (= "align_val_t" (:name (abi/enm (:id t)))))))
(defn- void-ptr? [t] (let [t (abi/unq t)] (and (abi/ptr? t) (abi/void? (abi/unq (:to t))))))

(defn- fn-ids [es] (vec (distinct (keep #(when (= :fn (:e %)) (:id %)) es))))

(defn- alloc-lookup
  "[:class ids] when the class `cid` (not ::-qualified) declares or inherits `nm`, else [:global ids] (ids empty when no
  header declares it: the implicit declarations)."
  [cid ^String nm global?]
  (let [cl (when (and cid (not global?)) (fn-ids (map second (class-lookup cid nm))))]
    (if (seq cl) [:class cl] [:global (fn-ids (lookup *root* nm))])))

(defn- usual-dealloc-info
  "UsualDeallocFnInfo of a deallocation function: {:size :align} when it is a usual (non-placement) one, else nil."
  [fid]
  (let [f (fnd fid) ps (vec (:ps (:ty f)))]
    (when (and (not (:va (:ty f))) (seq ps) (void-ptr? (first ps)) (not (:deleted f)))
      (let [i (if (and (< 1 (count ps)) (size-t? (nth ps 1))) 2 1)
            j (if (and (< i (count ps)) (align-t? (nth ps i))) (inc i) i)]
        (when (= j (count ps)) {:size (= i 2) :align (> j i)})))))

(defn- resolve-dealloc
  "The usual deallocation function of `ids` preferred for the target {:size :align} (Compare: the alignment parameter as
  the target asks, then the size parameter), or nil."
  [ids target]
  (let [infos (keep (fn [id] (when-let [u (usual-dealloc-info id)] (assoc u :fn id))) ids)
        score (fn [u] [(if (= (:align u) (:align target)) 1 0) (if (= (:size u) (:size target)) 1 0)])]
    (when (seq infos)
      (let [best (reduce (fn [a b] (if (pos? (compare (score b) (score a))) b a)) infos)]
        (select-keys best [:fn :size :align])))))

(defn- implicit-dealloc
  "The implicitly declared global deallocation function for {:size :align} ([basic.stc.dynamic]/2)."
  [array? {:keys [size align]}]
  {:sym (str (if array? "_ZdaPv" "_ZdlPv") (when size "m") (when align "St11align_val_t")) :size (boolean size) :align (boolean align)})

(defn global-dealloc
  "FindUsualDeallocationFunction: the global usual deallocation function for {:size :align}."
  [array? target]
  (let [nm (if array? "operator delete[]" "operator delete")
        ids (second (alloc-lookup nil nm true))]
    (or (resolve-dealloc ids target) (implicit-dealloc array? target))))

(defn dtor-dealloc
  "FindDeallocationFunctionForDestructor: the deallocation function a deleting destructor of class `cid` calls."
  [cid]
  (let [[k ids] (alloc-lookup cid "operator delete" false)
        t {:k :class :id cid}]
    (or (when (= :class k) (resolve-dealloc ids {:size false :align (overaligned? t)}))
        (global-dealloc false {:size true :align (overaligned? t)}))))

(defn- array-delete-wants-size?
  "doesUsualArrayDeleteWantSize: the class's own usual operator delete[] takes a size."
  [et]
  (let [cid (class-id (loop [t (abi/unq et)] (if (abi/arr? t) (recur (abi/unq (:of t))) t)))]
    (boolean (when cid (let [[k ids] (alloc-lookup cid "operator delete[]" false)]
                         (when (= :class k) (:size (resolve-dealloc ids {:size false :align (overaligned? et)}))))))))

(defn- find-allocation
  "FindAllocationFunctions for `new T` (`array?`, `global?` for ::new, `place` the placement arguments): {:alloc choice
  :dealloc choice-or-nil :reserved bool} (:reserved: the reserved placement form operator new(size_t, void*), which clang
  calls not; G4)."
  [ctx et array? global? place]
  (let [cid (class-id (loop [t (abi/unq et)] (if (abi/arr? t) (recur (abi/unq (:of t))) t)))
        nm (if array? "operator new[]" "operator new")
        over (overaligned? et)
        avt (align-val-t)
        size {:op :int :v 0 :ty abi/ulong* :cat :pr}
        ;; (cpp-ce2: in a function template's specialization, the global scope's declarations at the point of instantiation,
        ;; [temp.point]/1, [temp.res.general]/1: a dependent new-expression's allocation function, [expr.new]/12 -- std::construct_at's
        ;; placement new over construct_at.h's operator new declared after it)
        [scope ids] (if (and (checking?) (some-> (:fn-id ctx) fnd :tinst)) (binding [*cutoff* Long/MAX_VALUE] (alloc-lookup cid nm global?)) (alloc-lookup cid nm global?))
        try-res (fn [args] (try (resolve-overload ids args nil) (catch arbace.lang.ExceptionInfo x (if (= :overload (:codegen/refused (ex-data x))) nil (throw x)))))
        ;; (the implicit global declarations are always there, [basic.stc.dynamic]/2: a program's own global placement
        ;; form does not hide them)
        ids (if (and (= :global scope) (empty? place) (seq ids) (nil? (try-res [size]))) [] ids)
        [fid aligned] (cond
                        (empty? ids) [nil over]
                        (and over avt) (if-let [f (try-res (into [size {:op :int :v (abi/align-of et) :ty avt :cat :pr}] place))]
                                         [f true]
                                         [(try-res (into [size] place)) false])
                        :else [(try-res (into [size] place)) false])
        _ (when (and (seq ids) (nil? fid)) (fail :new "no viable " nm " for " (count place) " placement arguments"))
        alloc (if fid
                (let [f (fnd fid) ps (vec (:ps (:ty f))) k (if aligned 2 1)]
                  {:fn fid :align (when aligned (abi/align-of et))
                   :places (call-args (assoc f :ty (assoc (:ty f) :ps (subvec ps k)) :defaults (vec (drop k (:defaults f)))) place ctx)})
                (do (when (seq place)
                      ;; (queue 510, the checker: none at all, the implicit declarations being only the usual forms
                      ;; ([basic.stc.dynamic.general]/2: <new>'s placement form is no implicit one), so no candidate for the
                      ;; placement arguments, GCC's "no matching function for call to 'operator new(sizetype, int*)'": a block
                      ;; scope's declaration is not found by the new-expression's lookup (lookup/new1.C); not when a header's
                      ;; declaration of it was dropped)
                      (when (and (checking?) (not-any? #(= nm (nth % 2 nil)) (some-> *header-drops* deref vals)))
                        (fail :new "no matching " nm " for " (count place) " placement arguments"))
                      (fail :new "a placement new without a declared operator new"))
                    {:sym (str (if array? "_Zna" "_Znw") "m" (when aligned "St11align_val_t")) :align (when aligned (abi/align-of et)) :places []}))
        f (when fid (fnd fid))
        reserved (boolean (and f (not (:cls f)) (= 2 (count (:ps (:ty f)))) (void-ptr? (second (:ps (:ty f))))
                               (= 1 (count place))))
        dnm (if array? "operator delete[]" "operator delete")
        [dscope dids] (alloc-lookup cid dnm global?)
        placement? (or (seq place) (and f (or (:va (:ty f)) (not= (count (:ps (:ty f))) (if aligned 2 1)))))
        dealloc (if placement?
                  ;; the placement deallocation function whose parameters after the first are the allocation function's
                  ;; after the size ([expr.new]/28)
                  (let [want (into [:void-ptr] (map abi/unq (drop 1 (:ps (:ty f)))))]
                    (first (keep (fn [id] (let [g (fnd id) ps (:ps (:ty g))]
                                            (when (and (= (count ps) (count want)) (void-ptr? (first ps)) (= (map abi/unq (rest ps)) (rest want)) (= (boolean (:va (:ty g))) (boolean (:va (:ty f)))))
                                              {:fn id :place true})))
                                 dids)))
                  (let [target {:size (= :global dscope) :align over}]
                    (or (when (seq dids) (resolve-dealloc dids target)) (when (= :global dscope) (implicit-dealloc array? target)))))]
    {:alloc alloc :dealloc dealloc :reserved reserved :scope scope}))

(defn- delete-dealloc
  "The deallocation function of `delete p` / `delete[] p` (ActOnCXXDelete), with the array's cookie need."
  [et array? global?]
  (let [cid (class-id (loop [t (abi/unq et)] (if (abi/arr? t) (recur (abi/unq (:of t))) t)))
        nm (if array? "operator delete[]" "operator delete")
        over (overaligned? et)
        cls (when (and cid (not global?)) (let [[k ids] (alloc-lookup cid nm false)] (when (= :class k) (resolve-dealloc ids {:size false :align over}))))
        wants (if array? (if cls (boolean (:size cls)) (array-delete-wants-size? et)) false)
        destructed (boolean (and cid (not (trivial-dtor? cid))))]
    (or cls
        (global-dealloc array? {:size (boolean (and (let [u (abi/unq et)] (or (not (abi/class? u)) (:complete (abi/cls (:id u))))) (or (not array?) wants destructed))) :align over}))))

;; cpp-small (G2): [expr.new]/8, an array new-expression's size past the implementation's maximum object size is ill-formed when
;; its count is a constant. Arbace's target takes GCC's limit, PTRDIFF_MAX (c/target/abi.edn's :typedefs "PTRDIFF" :long, 8
;; bytes) plus one less an array cookie's size_t (8 bytes), 2^63 - 8, whether or not the type needs a cookie: observed on g++ 15.2 by hand (behaviour
;; only: `new char[0x7ffffffffffffff8]` accepted, `[0x7ffffffffffffff9]` "size ... of array exceeds maximum object size
;; '9223372036854775807'"; the same for a type with a destructor, for an over-aligned one at 2^63, for a non-constant outer count
;; with a constant inner bound and for `new (T[N])`); init/new44.C, init/new46.C. The size is the constant counts' product
;; times the innermost element's size, exact (an overflow is past the limit); a negative count is not judged here.
(def ^:private max-new-size 9223372036854775800N) ; 2^63 less the cookie

(defn- cx-new-size!
  [ctx n nexpr et]
  (when (map? nexpr)
    (try
      (let [cnt (let [e (rv (binding [*cutoff* Long/MAX_VALUE] (analyze ctx nexpr)))
                      t (abi/unq (:ty e))]
                  (when (and (map? t) (abi/integral? t))
                    ;; (an evaluation the evaluator's long arithmetic overflows judges nothing here)
                    (when-let [c (try (ce-try e) (catch ArithmeticException _ nil))]
                      (let [v (:v c)]
                        (when (and (= :int (:op c)) (integer? v))
                          (let [b (bigint v)]
                            (cond (not (neg? b)) b
                                  (abi/signed? t) nil
                                  :else (+' b 18446744073709551616N))))))))
            [inner leaf] (loop [t (abi/unq et) acc 1N]
                           (if (and (abi/arr? t) (integer? (:n t)))
                             (recur (abi/unq (:of t)) (*' acc (let [k (bigint (:n t))] (if (neg? k) (+' k 18446744073709551616N) k))))
                             [acc t]))
            sz (when-not (or (abi/arr? leaf) (= :fn (:k leaf)))
                 (try (bigint (abi/size-of leaf)) (catch Exception _ nil)))]
        (when (System/getenv "CX_NEW_TRACE") (binding [*out* *err*] (println "new-size" cnt inner (pr-str leaf) sz)))
        (when sz
          (let [total (*' inner sz (or cnt 1N))]
            (when (> total max-new-size)
              (*on-refusal* (ex-info (str "codegen: size '" total "' of array exceeds maximum object size '9223372036854775807'")
                                     {:codegen/refused :array})
                            n)))))
      (catch arbace.lang.ExceptionInfo x (when (System/getenv "CX_NEW_TRACE") (binding [*out* *err*] (println "new-size refused" (ex-message x)))) nil))))

(defn- cx-const-default-constructible?
  "cpp-decl2 (the checker): [dcl.init.general]/8, whether class `id` is const-default-constructible: its default-initialization
  invokes a user-provided constructor of its own, or each direct non-variant non-static data member has a default member
  initializer or is of a const-default-constructible class type, and each direct base is (a union: some variant member has a
  default member initializer); true when the slice cannot tell (an anonymous member, a template, a header's class)."
  [id]
  (let [c (abi/cls id)]
    (or (nil? c) (not (:complete c)) (:tmpl c) (:header c)
        (some #(let [f (fnd %)] (and (empty? (:ps (:ty f))) (not (:implicit f)) (or (not (:defaulted f)) (:ool-defaulted f)))) (:ctors c))
        (seq (:ctor-tmpls c)) (seq (:inherits-ctors c))
        (if (:union c)
          (boolean (some :init (:fields c)))
          (and (every? #(cx-const-default-constructible? (:cls %)) (:bases c))
               (every? (fn [fl] (or (:static fl) (:init fl) (:anon fl) (not (string? (:name fl)))
                                    (let [t (abi/unq (loop [t (:ty fl)] (if (abi/arr? t) (recur (:of t)) t)))]
                                      (and (abi/class? t) (cx-const-default-constructible? (:id t))))))
                       (:fields c)))))))

(defn- new-expr [ctx n]
  (let [t (resolve-type (:scope ctx) (get-in n [:type :qualType]))
        et (:to t)
        ks (kids n)
        [nexpr ks] (if (:isArray n) [(first ks) (rest ks)] [nil ks])
        ;; the initializer when written, then the placement arguments (the native parser's order; G4)
        initn (when (or (:initStyle n) (not (:isPlacement n))) (first ks))
        place (vec (if initn (rest ks) ks))
        pargs (when (:isPlacement n) (vec (analyze-args ctx place)))
        fa (find-allocation ctx (if nexpr et et) (boolean nexpr) (boolean (:isGlobal n)) (vec pargs))
        ;; the reserved placement form new (p) T: clang's CodeGen uses its argument, calls nothing
        placement (when (:reserved fa) (convert-scalar (rv (first pargs)) (abi/ptr abi/void) false))
        ;; (queue 570, the checker: a new-expression's type of GNU's VLA type, a local typedef's: `new A[5]` and `new (A[0])`
        ;; make an array of it, a bound past the first no converted constant expression, [expr.new]/8: GCC's "array size in
        ;; new-expression must be constant"; `new A` alone GNU's array new of A's bound, the slice's refusal; init/new35.C)
        _ (when (and (checking?) (or (and nexpr (cx-vm? et))
                                     (and (map? et) (abi/arr? (abi/unq et)) (not (:vla (abi/unq et))) (cx-vm? (:of (abi/unq et))))))
            (throw (ex-info "codegen: array size in new-expression must be constant" {:codegen/refused :vla-type :cx/node n})))
        _ (when (and (checking?) (nil? nexpr) (map? et) (:vla (abi/unq et)))
            (fail :new-array "a new-expression of a GNU variable-length array type"))
        ;; (cpp-rind, the checker: [expr.new]/1-2, a new-type-id of an array type of unknown bound (a typedef's, `new A` for A =
        ;; int[]) has no size: GCC's "invalid use of array with unspecified bounds"; init/new20.C)
        _ (when (and (checking?) (nil? nexpr) (map? et) (abi/arr? (abi/unq et)) (nil? (:n (abi/unq et))) (nil? initn))
            (fail :new-array "invalid use of array with unspecified bounds"))
        _ (when (and (checking?) (nil? initn) (nil? nexpr) (:c et) (not (abi/ref? et))
                     (or (abi/scalar? (abi/unq et))
                         (and (abi/class? (abi/unq et)) (not (cx-const-default-constructible? (:id (abi/unq et)))))))
            ;; (cpp-decl2, the checker: [expr.new]/22 with [dcl.init.general]/7, a new-expression without an initializer
            ;; default-initializes its object, a const one of a type not const-default-constructible ill-formed: GCC's
            ;; "uninitialized const in 'new' of 'const struct B'"; cpp0x/defaulted2.C)
            (fail :uninit "uninitialized const in 'new' of a type not const-default-constructible"))
        init (cond
               nexpr nil
               (nil? initn) (init-for et nil ctx :default)
               ;; (its pack expansions spliced: new T(std::forward<Args>(args)...), G4)
               (= "ParenListExpr" (:kind initn)) (init-for et (vec (analyze-args ctx (kids initn))) ctx (if (empty? (kids initn)) :value :direct))
               ;; (cpp-indep, the checker: `new T({...})`, the parser's call style over one braced list, direct-initializes from
               ;; that list as an argument, [expr.new]/24 with [dcl.init.general]/16.6: a constructor's parameter copy-list-
               ;; initialized from it, not T{...}; cpp0x/initlist4.C's `new A({1,2})` of an explicit A(int,int))
               (and (checking?) (= "InitListExpr" (:kind initn)) (= "call" (:initStyle n))) (init-for et [(analyze ctx initn)] ctx :direct)
               (= "InitListExpr" (:kind initn)) (init-for et (analyze ctx initn) ctx :list)
               (= "PackExpansionExpr" (:kind initn)) (let [as (vec (analyze-args ctx [initn]))] (init-for et (when (seq as) as) ctx (if (seq as) :direct :value)))
               :else (init-for et [(analyze ctx initn)] ctx :direct))
        init (if (and (= :ctor (:i init)) (empty? (:args init)) (nil? initn)) init init)]
    (when (and nexpr initn (not= "InitListExpr" (:kind initn))) nil)
    (when (and nexpr (checking?)) (cx-new-size! ctx n nexpr et))
    ;; (cpp-sweep, the checker: [expr.new]/8, the expression of a noptr-new-declarator of integral or unscoped enumeration
    ;; type, or a class converted to one: a floating one, a template's specialization's among them (the parser's check judges
    ;; the non-dependent ones), GCC's "size in array new must have integral type": diagnostic/integral-array-size-1.C)
    (when (and nexpr (checking?))
      (let [nv (try (rv (analyze ctx nexpr)) (catch arbace.lang.ExceptionInfo _ nil))
            nt (some-> nv :ty abi/unq)]
        (when (and nt *on-refusal* (abi/arith? nt) (not (abi/integral? nt)) (not (abi/enum? nt)))
          (*on-refusal* (ex-info "codegen: size in array new must have integral type" {:codegen/refused :new :cx/node nexpr}) nexpr))))
    ;; (cpp-decl2, the checker: C++20's parenthesized initialization of an array by a new-expression, [dcl.init.general]/16.5,
    ;; its elements copy-initialized from the expressions; g++ 15.2 takes the elements past them as copy-list-initialized from
    ;; {}, so an explicit default constructor is its "converting to 'T' from initializer list would use explicit constructor":
    ;; expr/anew5.C's new T[3](1, 2), not new T[2](1, 2) nor new T[3]())
    (when (and nexpr (checking?) (>= (long *cxx-year*) 20) (= "ParenListExpr" (:kind initn)) (seq (kids initn)))
      (let [nv (try (analyze ctx nexpr) (catch arbace.lang.ExceptionInfo _ nil))]
        (when (and (= :int (:op nv)) (integer? (:v nv)) (> (long (:v nv)) (count (kids initn))))
          (binding [*cx-copy-list* initn]
            (init-for et {:op :init-list :items []} ctx :list)))))
    ;; (cpp-indep, the checker: the same of a braced new-initializer with fewer elements than the bound, [dcl.init.aggr]/5.2:
    ;; an element with no initializer copy-initialized from {}, expr/anew7.C's new S[1]{} of `explicit S()`)
    (when (and nexpr (checking?) initn (= "InitListExpr" (:kind initn)) (not= "call" (:initStyle n)))
      (let [nv (try (analyze ctx nexpr) (catch arbace.lang.ExceptionInfo _ nil))]
        (when (and (= :int (:op nv)) (integer? (:v nv)) (> (long (:v nv)) (count (kids initn))))
          (binding [*cx-copy-list* initn]
            ;; (an array element's own elements alike: the innermost element type's, new S[1][1]{})
            (init-for (loop [x et] (if (abi/arr? (abi/unq x)) (recur (:of (abi/unq x))) x)) {:op :init-list :items []} ctx :list)))))
    {:op :new :placement placement :alloc (when-not placement (:alloc fa)) :dealloc (when-not placement (:dealloc fa))
     :cookie (boolean (and nexpr (not placement) (let [bt (loop [x (abi/unq et)] (if (abi/arr? x) (recur (abi/unq (:of x))) x)) c (class-id bt)]
                                   (or (and c (not (trivial-dtor? c)))
                                       (:size (delete-dealloc et true (boolean (:isGlobal n))))))))
     :ty t :et et :n (when nexpr (convert-scalar (rv (analyze ctx nexpr)) abi/ulong* false))
     :init (if nexpr
             (cond (nil? initn) (init-for et nil ctx :default)
                   (#{"ImplicitValueInitExpr" "ParenListExpr"} (:kind initn)) {:i :list :items [] :fill (init-for et nil ctx :value)}
                   ;; (the elements past the list's from {} when the count is not the list's, [expr.new]/24)
                   :else (assoc (init-for (abi/arr nil et) (analyze ctx initn) ctx :list)
                                :fill (try (init-for et {:op :init-list :items []} ctx :list) (catch arbace.lang.ExceptionInfo _ nil))))
             init)
     :cat :pr}))

(defn- dtor-of [cid] (:dtor (abi/cls cid)))

;; cpp-small (H): where g++ 15.2 places a diagnostic about an element an #embed made (observed by hand, behaviour only: lists of
;; one directive's bytes, limit 1 to 300): a run of fewer than 64 at the directive, a longer one's first and last element at the
;; directive and the others at the list's closing brace (cpp/embed-7.C, cpp/embed-16.C). The preprocessor gives each of a run's
;; integer literals the directive's position, so a run is the literals of one position on a line that is an #embed directive.
(defn- embed-line?
  [b]
  (let [o (:offset b) t (text-of (:file b))]
    (and (integer? o) (string? t) (< (long o) (count t))
         (let [ls (inc (.lastIndexOf ^String t "\n" (int (dec (long o)))))
               le (let [i (.indexOf ^String t "\n" (int o))] (if (neg? i) (count t) i))]
           (boolean (re-find #"^\s*#\s*embed\b" (subs t ls le)))))))

(defn- embed-positions
  "The analyzed elements `xs` of the list node `n` (its kids), each element an #embed's run made given the position g++ reports
  it at (:cx-at)."
  [n xs]
  (let [ks (vec (kids n))]
    (if (or (not= (count ks) (count xs)) (not-any? #(= "IntegerLiteral" (:kind %)) ks))
      xs
      (let [pos (fn [k] (when (= "IntegerLiteral" (:kind k)) (let [b (get-in k [:range :begin])] [(:file b) (:offset b)])))
            runs (partition-by pos (map-indexed vector ks))
            end (get-in n [:range :end])]
        (reduce (fn [xs run]
                  (let [[_ k0] (first run) p (pos k0) c (count run)]
                    (if (and p end (embed-line? (get-in k0 [:range :begin])))
                      (reduce (fn [xs [j [i k]]]
                                (let [x (nth xs i)]
                                  (if (map? x)
                                    (assoc xs i (assoc x :cx-at (if (and (>= c 64) (< 0 (long j) (dec c))) {:begin end :end end} (:range k))))
                                    xs)))
                              xs (map-indexed vector run))
                      xs)))
                (vec xs) runs)))))

(defn- analyze-args
  "The typed expressions of argument nodes, a pack expansion (args...) analyzed once for each of its packs' elements."
  [ctx ns]
  (vec (mapcat (fn [a] (if (= "PackExpansionExpr" (:kind a))
                         (if-let [h (:expand-pack @hooks)] (h ctx a) (fail :pack "a pack expansion"))
                         [(analyze ctx a)]))
               ns)))

(defn- cx-list-items
  "cpp-decl2, the checker: a braced list's elements as analyze-args gives them; when an element's analysis is refused, each
  other element is analyzed too and every refusal reported at its element (GCC reports each: other/offsetof8.C's two), the
  first then thrown as reported, the list's initialization not made."
  [ctx ns]
  (if-not *on-refusal*
    (analyze-args ctx ns)
    (let [errs (java.util.ArrayList.)
          out (vec (mapcat (fn [a]
                             (try (if (= "PackExpansionExpr" (:kind a)) (analyze-args ctx [a]) [(analyze ctx a)])
                                  (catch arbace.lang.ExceptionInfo e
                                    (if (and (:codegen/refused (ex-data e)) (not (:cpp/timeout (ex-data e))) (not (:cx/reported (ex-data e)))
                                             (map? a) (:range a))
                                      (do (.add errs [e a]) [])
                                      (throw e)))))
                           ns))]
      (if (.isEmpty errs)
        out
        (if (= 1 (count errs))
          (throw (first (first errs)))
          (do (doseq [[e a] errs] (*on-refusal* e (or (:cx/node (ex-data e)) a)))
              (let [[e] (first errs)] (throw (ex-info (.getMessage ^Throwable e) (assoc (ex-data e) :cx/reported true))))))))))

;; ---------------------------------------------------------------------------------------------
;; Lambdas ([expr.prim.lambda]): the closure class (a local class, mangled as clang names it: $_N in a function of
;; internal or external linkage, Ul<params>E<n>_ in an inline one), a field per capture in the order captured
;; (explicit, then implicit at first use), its operator() (const unless mutable, the return type deduced from the
;; first return), for a captureless lambda the conversion to a function pointer and its static __invoke

(declare stmt nrvo-var analyze-implicit! deduce-auto cx-check-constant!)

(def ^:dynamic *lambda-counts* nil) ; atom {[enclosing-fid kind-key] n}

(defn- split-top
  "The comma-separated parts of `s` at bracket depth 0."
  [^String s]
  (loop [i 0 d 0 start 0 out []]
    (if (>= i (count s))
      (let [p (str/trim (subs s start))] (if (seq p) (conj out p) out))
      (let [c (.charAt s i)]
        (cond
          (#{\( \[ \{ \<} c) (recur (inc i) (inc d) start out)
          (#{\) \] \} \>} c) (recur (inc i) (dec d) start out)
          (and (= c \,) (zero? d)) (recur (inc i) d (inc i) (conj out (str/trim (subs s start i))))
          :else (recur (inc i) d start out))))))

(defn- capture-intro [^String text]
  (let [b (.indexOf text "[")]
    (loop [i (inc b) d 1]
      (let [c (.charAt text i)]
        (cond (= c \[) (recur (inc i) (inc d))
              (= c \]) (if (= d 1) (subs text (inc b) i) (recur (inc i) (dec d)))
              :else (recur (inc i) d))))))

(defn capture-field
  "The expression of a captured entity (a variable's id or :this) inside the lambda of `ctx`: the closure's field,
  added (with its initializer, analyzed in the enclosing context) on the first use."
  [ctx k]
  (let [lam (:lambda ctx)
        lid (:cls lam)
        caps (:caps lam)
        encl (:encl lam)
        obj (deref-node {:op :this :ty (:this-type ctx) :cat :pr})]
    (if-let [i (get @caps k)]
      (let [f (nth (:fields (abi/cls lid)) i)] (if (= :this k) (rv (field-node obj lid i)) (field-node obj lid i)))
      (let [_ (when (some-> (:sealed lam) deref)
                ;; (CP290 (a): a generic lambda's closure object is made where the lambda is; a capture its call operator's
                ;; specialization finds that the definition's scan did not is refused, not added to an object already built)
                (fail :lambda "a capture of a generic lambda its definition did not name: " (if (= :this k) "this" (:name (var* k)))))
            mode (or (get (:explicit lam) k) (:default lam))
            v (when (not= :this k) (var* k))]
        (cond
          (= :this k)
          (let [te (this-expr encl)
                i (count (:fields (abi/cls lid)))]
            (abi/update-cls! lid update :fields conj {:name nil :ty (:ty te) :access :private :i i :capture true})
            (swap! caps assoc k i)
            (swap! (:inits lam) conj [i {:i :expr :e te}])
            (rv (field-node obj lid i)))
          (nil? mode)
          (let [t (:ty v)]
            (if-let [c (when (and (:c t) (abi/integral? t) (:init-node v)) (try (const-int (:scope encl) (:init-node v)) (catch arbace.lang.ExceptionInfo _ nil)))]
              {:op :int :v c :ty (abi/unq t) :cat :pr}
              (fail :lambda "a variable the lambda does not capture: " (:name v))))
          :else
          (let [;; (queue 570, the checker: a VLA captured by copy, its closure member an array copied element by element,
                ;; [expr.prim.lambda.capture]/10, /15, which a bound known only at run time cannot size: GCC's "array of runtime
                ;; bound cannot be captured by copy, only by reference"; cpp1y/vla5.C)
                _ (when (and (checking?) (= :copy mode) (:vla (abi/unq (abi/non-ref (:ty v)))))
                    (fail :vla-type "array of runtime bound '" (:name v) "' cannot be captured by copy, only by reference"))
                src (entity-expr encl [{:e :var :id k}] nil)
                i (count (:fields (abi/cls lid)))
                ft (if (= :ref mode) (abi/lref (:ty src)) (abi/non-ref (:ty v)))]
            (abi/update-cls! lid update :fields conj (cond-> {:name nil :ty ft :access :private :i i :capture true} (checking?) (assoc :cx-capname (:name v))))
            (swap! caps assoc k i)
            (swap! (:inits lam) conj [i (if (= :ref mode) {:i :bind :e src} (init-for ft src encl :copy))])
            (field-node obj lid i)))))))

(defn- init-capture!
  "An init-capture ([expr.prim.lambda.capture]/6): a field of the deduced type initialized by the expression analyzed in
  the enclosing context, its name the field's in the lambda's body."
  [lctx fs amp nm node]
  (let [lam (:lambda lctx) lid (:cls lam) encl (:encl lam)
        e (analyze encl node)
        byref (= amp "&")
        ft (if byref (abi/lref (:ty e)) (deduce-auto {:k :auto} e))
        i (count (:fields (abi/cls lid)))]
    (abi/update-cls! lid update :fields conj (cond-> {:name nil :ty ft :access :private :i i :capture true} (checking?) (assoc :cx-capname nm)))
    (swap! (:inits lam) conj [i (if byref {:i :bind :e e} (init-for ft e encl :copy))])
    (enter! fs nm {:e :capfield :i i})))

(declare generic-lambda-expr)

(defn- lambda-expr [ctx n]
  (if (:_glam (first (kids n)))
    (generic-lambda-expr ctx n)
  (let [ks (kids n)
        rd (first ks) body (last ks)
        init-nodes (vec (butlast (rest ks)))
        init-i (atom -1)
        md (first (filter #(= "CXXMethodDecl" (:kind %)) (kids rd)))
        text (node-text n)
        intro (capture-intro text)
        head (subs text 0 (max 0 (- (long (get-in body [:range :begin :offset])) (long (get-in n [:range :begin :offset])))))
        mutable (boolean (re-find #"\)\s*mutable\b" head))
        pn (param-nodes md)
        _ (when (some #(re-find #"\bauto\b" (get-in % [:type :qualType] "")) pn) (fail :generic-lambda "a generic lambda"))
        ps (mapv #(resolve-type (:scope ctx) (get-in % [:type :qualType])) pn)
        qt (get-in md [:type :qualType])
        ret (if (re-find #"^auto\s*\(" qt)
              (if-let [[_ r] (re-find #"->\s*(.+?)\s*$" head)] (resolve-type (:scope ctx) r) {:k :auto})
              (:ret (resolve-type (:scope ctx) qt)))
        encl-f (when (:fn-id ctx) (fnd (:fn-id ctx)))
        inline? (boolean (and encl-f (:inline encl-f) (not (:internal encl-f))))
        ;; clang names a closure Ul...E_ in an inline function's body and in a closure's, $_N elsewhere
        ul? (or inline? (boolean (and encl-f (:cls encl-f) (:lambda (abi/cls (:cls encl-f))))))
        ckey [(:fn-id ctx) (if ul? (abi/mangle-params ps) :dollar)]
        k (long (or (get @*lambda-counts* ckey) 0))
        _ (swap! *lambda-counts* assoc ckey (inc k))
        mname (when ul? (str "Ul" (abi/mangle-params ps) "E" (if (zero? k) "" (dec k)) "_"))
        path (if encl-f [[:local encl-f]] (vec (:path (:scope ctx))))
        id (next-id)
        cs (new-scope :class (:scope ctx) :cls id :path (conj path [:cls id]))
        t {:k :class :id id}
        _ (swap! abi/*classes* assoc id (cond-> {:id id :name nil :mname mname :dollar-key (when-not ul? [:fn (:fn-id ctx)]) :path path :scope cs :fields [] :bases [] :outer (:scope ctx) :lambda true}
                                          ;; (cpp-p2564: the lambda-expression's place, cx-main-fn?)
                                          (and (checking?) (:range n)) (assoc :cx-lambda-node {:range (:range n)})
                                          ;; (cpp-rt-own2: the parameters, mangled in the enclosing name's substitutions, abi's part-name)
                                          ul? (assoc :ul [ps k])))
        fid (next-id)
        base-f {:cls id :inline inline? :internal (not inline?) :path (conj path [:cls id]) :scope cs :def-scope cs :linkage :cpp :defaults [] :pos -1}
        _ (swap! *fns* assoc fid (merge base-f {:id fid :name "operator()" :kind :method :op "()" :ty {:k :fn :ret ret :ps ps :va false}
                                                :cq (not mutable) :param-names (mapv :name pn)}
                                               ;; (cpp-p2564, the checker: the call operator's default arguments, as a function's,
                                               ;; [expr.prim.lambda.closure]/3: consteval-prop1.C's `[] (int u = undef ()) {...}()`)
                                               (when (and (checking?) (some #(seq (kids %)) pn))
                                                 {:defaults (mapv (fn [p] (first (remove #(str/ends-with? (str (:kind %)) "Attr") (kids p)))) pn)})))
        _ (enter! cs "operator()" {:e :fn :id fid :pos -1})
        _ (abi/update-cls! id update :methods (fnil conj []) fid)
        _ (swap! *order* conj [:fn fid])
        ;; the captures written
        items (if (str/blank? intro) [] (split-top intro))
        default (some #(case % "=" :copy "&" :ref nil) items)
        fs (new-scope :fn (:scope ctx))
        lam {:cls id :caps (atom {}) :inits (atom []) :default default :encl ctx :explicit {}}
        pids (vec (map-indexed (fn [i pt] (let [pid (next-id) nm (:name (nth pn i))]
                                            (swap! *vars* assoc pid {:id pid :name nm :ty pt :storage :param :fn fid})
                                            (when nm (enter! fs nm {:e :var :id pid}))
                                            pid))
                               ps))
        lctx {:scope fs :fn-id fid :this-type (abi/ptr (cond-> t (not mutable) (assoc :c true))) :statics (atom []) :lambda lam}
        explicit (into {} (for [it items :when (not (#{"=" "&"} it)) :when (not (str/includes? it "="))
                                :let [byref (str/starts-with? it "&") nm (str/trim (str/replace it #"^&" ""))]]
                            (cond (= nm "this") [:this :copy]
                                  (= nm "*this") (fail :lambda "a capture of *this")
                                  :else (let [e (first (filter #(= :var (:e %)) (lookup (:scope ctx) nm)))]
                                          ;; (queue 492, the checker: a simple capture names an entity unqualified lookup
                                          ;; finds, [expr.prim.lambda.capture]/5; GCC's "'i' was not declared in this scope";
                                          ;; judged only for a name no declaration of the unit has: a variable whose own
                                          ;; initializer names it is in scope there, [basic.scope.pdecl]/1)
                                          (when (and (not e) (cx-declared-nowhere? nm) (cx-undeclared? (:scope ctx) nm)) (fail :undecl "use of undeclared identifier '" nm "'"))
                                          (when-not e (fail :lambda "capture of " nm))
                                          [(:id e) (if byref :ref :copy)]))))
        lam (assoc lam :explicit explicit)
        lctx (assoc lctx :lambda lam)
        ;; explicit captures in their order, then init-captures
        _ (doseq [it items :when (not (#{"=" "&"} it))]
            (if-let [[_ amp nm _] (re-matches #"(?s)(&?)\s*([A-Za-z_][A-Za-z_0-9]*)\s*=\s*(.+)" it)]
              (init-capture! lctx fs amp nm (nth init-nodes (swap! init-i inc)))
              (let [byref (str/starts-with? it "&") nm (str/trim (str/replace it #"^&" ""))]
                (capture-field lctx (if (= nm "this") :this (:id (first (filter #(= :var (:e %)) (lookup (:scope ctx) nm)))))))))
        body-s (binding [*cutoff* Long/MAX_VALUE] (stmt lctx body))
        ret (:ret (:ty (fnd fid)))
        ret (if (= :auto (:k ret)) abi/void ret)
        _ (upd-fn! fid #(-> % (assoc-in [:ty :ret] ret) (assoc :params pids :tbody body-s :nrvo (nrvo-var body-s) :statics @(:statics lctx))))
        _ (cx-addr-escalation! fid)
        _ (finish-class! id)
        _ (cx-closure-members! id (not (str/blank? intro)))
        _ (doseq [m (:methods (abi/cls id)) :let [g (fnd m)] :when (:implicit g)]
            (try (analyze-implicit! m) (catch arbace.lang.ExceptionInfo _ (upd-fn! m assoc :deleted true))))
        inits (sort-by first @(:inits lam))
        ;; (queue 518, the checker: a closure that captures has no conversion function, [expr.prim.lambda.closure]/9)
        _ (when (and (checking?) (seq inits)) (abi/update-cls! id assoc :cx-capturing true))]
    (when (empty? inits)
      ;; the conversion to a pointer to function and the static __invoke it returns
      (let [ivid (next-id) cvid (next-id) ft {:k :fn :ret ret :ps ps :va false}
            ipids (vec (for [pt ps] (let [pid (next-id)] (swap! *vars* assoc pid {:id pid :name nil :ty pt :storage :param :fn ivid}) pid)))
            lv (next-id)
            _ (swap! *vars* assoc lv {:id lv :name nil :ty t :storage :local :fn ivid})
            _ (swap! *fns* assoc ivid (merge base-f {:id ivid :name "__invoke" :kind :method :static true :ty ft :param-names []}))
            ;; (cpp-p2564: the invoker's call of the operator, a closure member's, no immediate invocation of its own)
            call (binding [*cx-no-imm* true] (method-call {:scope cs} fid {:op :var :id lv :ty t :cat :lv} (mapv var-node ipids) false))
            ret-s (if (abi/void? ret) {:s :return :void-e call} {:s :return :init (init-for ret call {:scope cs} :copy)})]
        (upd-fn! ivid assoc :params ipids :tbody {:s :block :items [{:s :decl :var lv :init {:i :none}} ret-s]})
        (swap! *fns* assoc cvid (merge base-f {:id cvid :name "operator function" :kind :conv :cq true :ty {:k :fn :ret (abi/ptr ft) :ps [] :va false}
                                              :param-names [] :params [] :cx-callop fid
                                              :tbody {:s :block :items [{:s :return :init {:i :expr :e {:op :fnaddr :fn ivid :ty (abi/ptr ft) :cat :pr}}}]}}))
        (abi/update-cls! id update :methods (fnil conj []) cvid)))
    {:op :temp-obj :init {:i :list :cls id :items (mapv second inits) :fields-used (mapv first inits)} :ty t :cat :pr})))

(defn- node-children
  "A node's children for the generic lambda's scans: its :inner, a fold expression's operands (CP291 (a)) and a nested
  generic lambda's parameters (CP290 (a)), kept as data."
  [x]
  (concat (:inner x) (keep #(get (:_fold x) %) [:l :r]) (:params (:_glam x))))

(defn- glam-names
  "CP290 (a): the names a generic lambda's body refers to by an unqualified id, and whether it uses `this`, in the
  order written ([{:name s} or :this])."
  [body]
  (let [out (java.util.ArrayList.) seen (java.util.HashSet.)]
    (letfn [(walk [x]
              (cond
                ;; CP304 (a): an unevaluated operand names no capture ([expr.prim.lambda.capture]/7-8: only a potentially
                ;; evaluated expression odr-uses; [expr.context]/1: sizeof's, alignof's, noexcept's operands and a
                ;; requires-expression are unevaluated; clang's tryCaptureVariable is not reached for them)
                (and (map? x) (#{"UnaryExprOrTypeTraitExpr" "CXXNoexceptExpr" "RequiresExpr" "SizeOfPackExpr"} (:kind x))) nil
                (map? x) (do (cond
                               (and (= "DeclRefExpr" (:kind x)) (not (:qualifier x)) (not (:globalQualifier x)))
                               (let [nm (get-in x [:referencedDecl :name])]
                                 (when (and (string? nm) (seq nm) (.add seen nm)) (.add out nm)))
                               (= "CXXThisExpr" (:kind x)) (when (.add seen :this) (.add out :this)))
                             (doseq [k (node-children x)] (walk k)))
                (sequential? x) (doseq [k x] (walk k))))]
      (walk body))
    (vec out)))

(defn- glam-declared
  "The names a generic lambda's body declares (its variables, bindings, functions' parameters): a reference to one of
  them is not taken for a capture."
  [body]
  (set (for [x (tree-seq (fn [x] (or (map? x) (sequential? x))) (fn [x] (if (map? x) (node-children x) x)) body)
             :when (and (map? x) (#{"VarDecl" "ParmVarDecl" "BindingDecl" "DecompositionDecl"} (:kind x)) (:name x))]
         (:name x))))

(defn- generic-lambda-expr
  "CP290 (a): a generic lambda ([expr.prim.lambda.closure]/3-4: a parameter declared `auto` or a template-parameter-list):
  its closure's function call operator is a member function template, one invented type template parameter for each
  parameter's `auto` (a pack for `auto...`) after the explicit ones, its specializations deduced from a call and
  instantiated on use as a function template's are (arbace.cpp.template), their bodies analyzed in the lambda's context
  (the captures, `this`). The closure object is made here, so its captures are found here: the explicit ones, and for a
  capture-default the variables and `this` the body names ([expr.prim.lambda.capture]/7: in a generic lambda an entity
  named in a dependent full-expression is captured), in the order written; a specialization that needs another is
  refused. No conversion to a pointer to function (a conversion function template): a use of one is refused."
  [ctx n]
  (let [ks (kids n)
        rd (first ks) body (last ks)
        init-nodes (vec (butlast (rest ks)))
        init-i (atom -1)
        glam (:_glam rd)
        text (node-text n)
        intro (capture-intro text)
        head (subs text 0 (max 0 (- (long (get-in body [:range :begin :offset])) (long (get-in n [:range :begin :offset])))))
        mutable (boolean (re-find #"\)\s*mutable\b" head))
        ;; the invented template parameters ([dcl.fct]/22: one for each placeholder of a parameter's type)
        explicit-tps (vec (:tparams glam))
        inv (atom 0)
        pn (mapv (fn [p]
                   (let [qt (str (get-in p [:type :qualType]))]
                     (if (re-find #"\bauto\b" qt)
                       (let [nm (str "__lambda_auto_" (swap! inv inc))
                             ;; (cpp-tpl2: a constrained placeholder, `False auto t`: the type-constraint the invented
                             ;; parameter's, [dcl.fct]/22, its spelling taken out of the parameter's type)
                             [_ tc] (when (checking?) (re-find #"((?:[A-Za-z_]\w*::)*[A-Za-z_]\w*(?:\s*<[^<>]*>)?)\s+auto\b" qt))
                             tc (when (and tc (not (#{"const" "volatile" "signed" "unsigned"} tc))) tc)
                             qt (if tc (str/replace-first qt (re-pattern (str (java.util.regex.Pattern/quote tc) "\\s+(?=auto\\b)")) "") qt)]
                         (assoc-in (cond-> (assoc p :_inv nm :_invpack (boolean (re-find #"\.\.\.\s*$" qt)))
                                     tc (assoc :_invtc tc))
                                   [:type :qualType] (str/replace-first qt #"\bauto\b" nm)))
                       p)))
                 (:params glam))
        _ (when (some #(re-find #"\bdecltype\s*\(\s*auto" (str (get-in % [:type :qualType]))) pn) (fail :generic-lambda "a decltype(auto) parameter"))
        tps (into explicit-tps (for [p pn :when (:_inv p)]
                                 (cond-> {:kind "TemplateTypeParmDecl" :name (:_inv p) :inner [] :isImplicit true}
                                   (:_invpack p) (assoc :isParameterPack true)
                                   (:_invtc p) (assoc :_tc (vec (str/split (str/trim (str/replace (:_invtc p) #"<.*$" "")) #"::"))
                                                      :_tcargs (str/includes? (:_invtc p) "<") :_tctext (:_invtc p)))))
        tr (when-let [[_ r] (re-find #"->\s*(.+?)\s*$" head)] r)
        qt (str (or tr "auto") " (" (str/join ", " (map #(get-in % [:type :qualType]) pn)) ")" (when-not mutable " const"))
        pattern (cond-> {:kind "CXXMethodDecl" :name "operator()" :type {:qualType qt} :inline true
                         :inner (conj (vec (map #(dissoc % :_inv :_invpack :_invtc) pn)) body) :_b (:_b n)}
                  ;; (cpp-tpl2, the checker: its trailing requires-clause, the parser's :_glam :trc)
                  (and (checking?) (:trc glam)) (assoc :trailingRequiresClause (:trc glam)))
        encl-f (when (:fn-id ctx) (fnd (:fn-id ctx)))
        inline? (boolean (and encl-f (:inline encl-f) (not (:internal encl-f))))
        ul? (or inline? (boolean (and encl-f (:cls encl-f) (:lambda (abi/cls (:cls encl-f))))))
        path (if encl-f [[:local encl-f]] (vec (:path (:scope ctx))))
        id (next-id)
        ;; (its specializations of internal linkage outside an inline function, as the non-generic operator is)
        cs (new-scope :class (:scope ctx) :cls id :path (conj path [:cls id]) :internal (not inline?))
        t {:k :class :id id}
        _ (swap! abi/*classes* assoc id (cond-> {:id id :name nil :mname nil :dollar-key (when-not ul? [:fn (:fn-id ctx)]) :path path :scope cs :fields [] :bases [] :outer (:scope ctx) :lambda true}
                                          (and (checking?) (:range n)) (assoc :cx-lambda-node {:range (:range n)})))
        ;; the call operator template, declared in the closure as a member template is (the :declare hook)
        _ (let [h (or (:declare @hooks) (fail :generic-lambda "a generic lambda without templates"))]
            (h cs (cond-> {:kind "FunctionTemplateDecl" :name "operator()" :inner (conj tps pattern) :_b (:_b n)}
                    ;; (cpp-tpl2, the checker: its template-head's requires-clause, the parser's :_glam :rc)
                    (and (checking?) (:rc glam)) (assoc :requiresClause (:rc glam)))))
        tid (some #(when (= :tmpl (:e %)) (:id %)) (.get ^java.util.HashMap (:names cs) "operator()"))
        _ (when-not tid (fail :generic-lambda "the call operator template not declared"))
        ;; clang names a closure Ul<the parameters, the template's own>E_ in an inline function's body
        sps (when ul? (:ps ((requiring-resolve 'arbace.cpp.template/sym-sig) ((requiring-resolve 'arbace.cpp.template/tmpl) tid))))
        ckey [(:fn-id ctx) (if ul? (abi/mangle-params sps) :dollar)]
        k (long (or (get @*lambda-counts* ckey) 0))
        _ (swap! *lambda-counts* assoc ckey (inc k))
        _ (when ul? (abi/update-cls! id assoc :mname (str "Ul" (abi/mangle-params sps) "E" (if (zero? k) "" (dec k)) "_") :ul [sps k]))
        items (if (str/blank? intro) [] (split-top intro))
        default (some #(case % "=" :copy "&" :ref nil) items)
        fs (new-scope :fn (:scope ctx))
        lam {:cls id :caps (atom {}) :inits (atom []) :default default :encl ctx :explicit {} :sealed (atom false)}
        lctx {:scope fs :fn-id nil :this-type (abi/ptr (cond-> t (not mutable) (assoc :c true))) :statics (atom []) :lambda lam}
        explicit (into {} (for [it items :when (not (#{"=" "&"} it)) :when (not (str/includes? it "="))
                                :let [byref (str/starts-with? it "&") nm (str/trim (str/replace it #"^&" ""))]]
                            (cond (= nm "this") [:this :copy]
                                  (= nm "*this") (fail :lambda "a capture of *this")
                                  :else (let [e (first (filter #(= :var (:e %)) (lookup (:scope ctx) nm)))]
                                          ;; (queue 492, the checker: a simple capture names an entity unqualified lookup
                                          ;; finds, [expr.prim.lambda.capture]/5; GCC's "'i' was not declared in this scope";
                                          ;; judged only for a name no declaration of the unit has: a variable whose own
                                          ;; initializer names it is in scope there, [basic.scope.pdecl]/1)
                                          (when (and (not e) (cx-declared-nowhere? nm) (cx-undeclared? (:scope ctx) nm)) (fail :undecl "use of undeclared identifier '" nm "'"))
                                          (when-not e (fail :lambda "capture of " nm))
                                          [(:id e) (if byref :ref :copy)]))))
        lam (assoc lam :explicit explicit)
        lctx (assoc lctx :lambda lam)
        _ (doseq [it items :when (not (#{"=" "&"} it))]
            (if-let [[_ amp nm _] (re-matches #"(?s)(&?)\s*([A-Za-z_][A-Za-z_0-9]*)\s*=\s*(.+)" it)]
              (init-capture! lctx fs amp nm (nth init-nodes (swap! init-i inc)))
              (let [nm (str/trim (str/replace it #"^&" ""))]
                (capture-field lctx (if (= nm "this") :this (:id (first (filter #(= :var (:e %)) (lookup (:scope ctx) nm)))))))))
        ;; the implicit captures of a capture-default: what the body names, in order
        _ (when default
            (let [own (into (glam-declared body) (keep :name pn))
                  caps-by-name (set (keys (:names fs)))]
              (doseq [x (glam-names body)]
                (if (= :this x)
                  (when (:this-type ctx) (capture-field lctx :this))
                  (when-not (or (own x) (caps-by-name x))
                    (when-let [e (first (lookup (:scope ctx) x))]
                      (when (= :var (:e e))
                        (let [v (var* (:id e))]
                          (when (and (#{:local :param} (:storage v)) (:fn v))
                            (capture-field lctx (:id e)))))))))))
        _ (reset! (:sealed lam) true)
        ;; the init-captures' names in the specializations' bodies, the lambda's context for them
        _ (abi/update-cls! id assoc :glam (assoc lam :names (into {} (:names fs))) :glam-cutoff (long (or (:_b n) *cutoff*)))
        ;; (CP301 (a): no lambda-capture, so a conversion function template to a pointer to function, its
        ;; specializations made on use by glam-conv!; [expr.prim.lambda.closure]/9)
        _ (when (str/blank? intro)
            (abi/update-cls! id assoc :glam-conv {:tid tid :base-f {:cls id :inline inline? :internal (not inline?) :path (conj path [:cls id])
                                                                    :scope cs :def-scope cs :linkage :cpp :defaults [] :pos -1}}))
        _ (finish-class! id)
        _ (cx-closure-members! id (not (str/blank? intro)))
        _ (doseq [m (:methods (abi/cls id)) :let [g (fnd m)] :when (:implicit g)]
            (try (analyze-implicit! m) (catch arbace.lang.ExceptionInfo _ (upd-fn! m assoc :deleted true))))
        inits (sort-by first @(:inits lam))]
    {:op :temp-obj :init {:i :list :cls id :items (mapv second inits) :fields-used (mapv first inits)} :ty t :cat :pr}))

(def ^:private opaque-ids (atom 0))

(defn- cond-node
  "The conditional operator's node of the analyzed condition `c` (contextually bool) and operands `a`, `b` ([expr.cond])."
  [ctx c a b]
  ;; (cpp-diag-b, 2026-11-22: [expr.cond]/2, an operand of type void with the other neither void nor a throw-expression: GCC's
  ;; "second operand to the conditional operator is of type 'void', but the third operand is neither a throw-expression nor of type
  ;; 'void'")
  (when (and (checking?) (some? (:ty a)) (some? (:ty b))
             (not= (abi/void? (abi/unq (:ty a))) (abi/void? (abi/unq (:ty b))))
             ;; (cpp-sweep: the operand of type void is the throw-expression, [expr.cond]/2.1; the other had been asked:
             ;; cpp23/constexpr-nonlit8.C's `b ? throw 0 : 0`)
             (not (#{:throw :rethrow} (:op (if (abi/void? (abi/unq (:ty a))) a b)))))
    (fail :cond-void "an operand of the conditional operator is of type 'void', the other neither a throw-expression nor of type 'void'"))
  (cond
    ;; (cpp-sweep, the checker: [expr.cond]/2.1, a throw-expression operand: the result the other's, its type and value category)
    (and (checking?) (some? (:ty a)) (some? (:ty b)) (not= (abi/void? (abi/unq (:ty a))) (abi/void? (abi/unq (:ty b))))
         (#{:throw :rethrow} (:op (if (abi/void? (abi/unq (:ty a))) a b))))
    (let [o (if (abi/void? (abi/unq (:ty a))) b a)] {:op :cond :c c :then a :else b :ty (:ty o) :cat (:cat o)})
    (and (lv? a) (lv? b) (= (:ty a) (:ty b))) {:op :cond :c c :then a :else b :ty (:ty a) :cat :lv}
    (and (abi/class? (abi/unq (:ty a))) (= (abi/unq (:ty a)) (abi/unq (:ty b))))
    {:op :cond :c c :then (if (= :pr (:cat a)) a {:op :temp-obj :init (init-for (abi/unq (:ty a)) a ctx :copy) :ty (abi/unq (:ty a)) :cat :pr})
     :else (if (= :pr (:cat b)) b {:op :temp-obj :init (init-for (abi/unq (:ty b)) b ctx :copy) :ty (abi/unq (:ty b)) :cat :pr}) :ty (abi/unq (:ty a)) :cat :pr}
    ;; [expr.cond]/4: one operand of class type, the other not (and not void): the class operand converted to the other's
    ;; type after lvalue-to-rvalue conversion, by its conversion function (g++.dg's ext/cond3.C: X() ? X() : false)
    (and (not= (boolean (abi/class? (abi/unq (:ty a)))) (boolean (abi/class? (abi/unq (:ty b)))))
         (not (abi/void? (abi/unq (:ty a)))) (not (abi/void? (abi/unq (:ty b)))))
    (let [swap? (not (abi/class? (abi/unq (:ty a))))
          [k o] (if swap? [b a] [a b])
          ot (abi/unq (:ty (rv o)))
          kt (abi/unq (:ty k))
          [k o] (if (conv-for (class-id kt) ot false (:c (:ty k)))
                  [(user-conv ctx k ot false) o]
                  ;; (else the other operand converted to the class, a temporary by its converting constructor)
                  [k {:op :temp-obj :init (init-for kt o ctx :copy) :ty kt :cat :pr}])]
      (if swap? (cond-node ctx c o k) (cond-node ctx c k o)))
    ;; (cpp-tzdb, the code generator: [expr.cond]/4.3.3, operands of two unrelated class types: the one that converts
    ;; implicitly to the other's type after lvalue-to-rvalue conversion (its cv kept) converted so, exactly one of them, the
    ;; result a prvalue of that type: `false ? declval<const string_view&>() : declval<const string&>()` is a prvalue const
    ;; string_view, <type_traits>' __cond_res, so common_reference_t<const string_view&, const string&> and common_type_t,
    ;; tzdb.cc's ranges::equal_range(node->rules, ri.rules(), ranges::less{}, &Rule::name) over totally_ordered_with)
    (and (not (checking?)) (class-id (:ty a)) (class-id (:ty b)) (not= (class-id (:ty a)) (class-id (:ty b)))
         (not (abi/derived-from? (class-id (:ty a)) (class-id (:ty b)))) (not (abi/derived-from? (class-id (:ty b)) (class-id (:ty a)))))
    (let [target (fn [o] (cond-> (abi/unq (:ty o)) (:c (:ty o)) (assoc :c true) (:v (:ty o)) (assoc :v true)))
          ;; (the implicit conversion sequence first, ics: an explicit constructor is no candidate, basic_string's from a
          ;; string_view-like type)
          conv (fn [e o] (let [t (target o)]
                           (when (ics e (abi/unq t))
                             (try {:op :temp-obj :init (init-for (abi/unq t) e ctx :copy) :ty t :cat :pr}
                                  (catch arbace.lang.ExceptionInfo _ nil)))))
          ab (conv a b) ba (conv b a)]
      (cond (and ab (not ba)) (let [b' (if (= :pr (:cat b)) b {:op :temp-obj :init (init-for (abi/unq (:ty b)) b ctx :copy) :ty (target b) :cat :pr})]
                                {:op :cond :c c :then ab :else b' :ty (target b) :cat :pr})
            (and ba (not ab)) (let [a' (if (= :pr (:cat a)) a {:op :temp-obj :init (init-for (abi/unq (:ty a)) a ctx :copy) :ty (target a) :cat :pr})]
                                {:op :cond :c c :then a' :else ba :ty (target a) :cat :pr})
            :else (fail :conversion "the conditional operator's operands of class types " (:name (abi/cls (class-id (:ty a)))) " and "
                        (:name (abi/cls (class-id (:ty b)))) ": " (if ab "each converts to the other" "neither converts to the other"))))
    :else (let [a (rv a) b (rv b)
                ;; ([expr.cond]/7.1: operands of the same type, that type; bool ? bool stays bool)
                ;; (cpp-rind: [expr.cond]/7.3 with [expr.type]/4, two pointers to classes one derived from the other: the composite
                ;; pointer type the base's, with both operands' cv-qualifiers (it had been the first operand's, refusing a
                ;; derived second operand's conversion); to unrelated classes none, in the checker GCC's "conditional expression
                ;; between distinct pointer types 'Boolean*' and 'IsZero*' lacks a cast": expr/cond2.C)
                ca (when (and (abi/ptr? (:ty a)) (abi/ptr? (:ty b))) (class-id (:to (abi/unq (:ty a)))))
                cb (when (and (abi/ptr? (:ty a)) (abi/ptr? (:ty b))) (class-id (:to (abi/unq (:ty b)))))
                cvp (fn [base other] (let [ft (:to (abi/unq other)) bt (:to (abi/unq base))]
                                       (abi/ptr (cond-> bt (:c ft) (assoc :c true) (:v ft) (assoc :v true)))))
                _ (when (and (checking?) ca cb (not= ca cb) (not (abi/derived-from? ca cb)) (not (abi/derived-from? cb ca)))
                    (fail :conversion "cannot convert between distinct pointer types implicitly (conditional expression between distinct pointer types lacks a cast)"))
                t (cond (= (abi/unq (:ty a)) (abi/unq (:ty b))) (abi/unq (:ty a))
                        (and (abi/arith? (:ty a)) (abi/arith? (:ty b))) (arith-common (:ty a) (:ty b))
                        (and (checking?) ca cb (not= ca cb) (abi/derived-from? ca cb)) (cvp (:ty b) (:ty a))
                        (and (checking?) ca cb (not= ca cb) (abi/derived-from? cb ca)) (cvp (:ty a) (:ty b))
                        (abi/ptr? (:ty a)) (:ty a) (abi/ptr? (:ty b)) (:ty b)
                        (abi/void? (:ty a)) abi/void
                        :else (abi/unq (:ty a)))]
            {:op :cond :c c :then (convert-scalar a t false) :else (convert-scalar b t false) :ty t :cat :pr})))

(declare analyze-node)

(defn- ctad-expr
  "CP311 (a): T(args) or T{...} with T the placeholder `ct` ([tid #{cv}]) for a deduced class type ([expr.type.conv]/1:
  the type deduced as for a variable direct-initialized by the initializer), a temporary of it."
  [ctx n ct]
  (let [ks (kids n)
        [kind a] (if (and (= "CXXFunctionalCastExpr" (:kind n)) (= "InitListExpr" (:kind (first ks))))
                   [:list-direct (analyze ctx (first ks))]
                   [:direct (analyze-args ctx ks)])
        t ((:ctad @hooks) ctx (first ct) kind a)]
    {:op :temp-obj :init (init-for t a ctx (cond (map? a) :list (empty? a) :value :else :direct)) :ty t :cat :pr}))

(def ^:dynamic *analyze-depth*
  "h-cpp-read: when bound (arbace.repr.cpp.diag's Sema, a long array of one), the nesting of `analyze` on this thread; past
  `max-analyze-depth` a StackOverflowError, as the evaluating host throws one when its stack ends: compiled into stage 0 (W2)
  the analysis' own stack had grown to Go's 1 GB limit, a fatal error ending the whole run (constexpr-recursion1.C)."
  nil)

(def ^:const max-analyze-depth 4000)

;; ---------------------------------------------------------------------------------------------
;; Coroutines (queue 393, W4; doc/cpp/CODEGEN.md, "As built: coroutines"): [dcl.fct.def.coroutine], [expr.await],
;; [expr.yield], [stmt.return.coroutine] as clang's SemaCoroutine builds them; the frame, its suspension points and the
;; split into the ramp, resume and destroy functions are arbace.cpp.codegen's (emit-coro!)

(defn- typed-node [e] {:kind "_Typed" :_e e})

(defn- member-call-node
  "The node of the call obj.m(args...), `obj` and `args` typed expressions."
  [obj ^String m args]
  {:kind "CallExpr" :inner (vec (cons {:kind "MemberExpr" :name m :isArrow false :inner [(typed-node obj)]} (map typed-node args)))})

(defn- std-template
  "<coroutine>'s class template std::NM (in libstdc++'s inline namespace std::__n4861)."
  [^String nm]
  (or (first (filter #(= :tmpl (:e %)) (try (lookup-qualified *root* ["std" nm] true) (catch arbace.lang.ExceptionInfo _ nil))))
      (fail :coroutine "no std::" nm " (<coroutine> not included)")))

(defn- coro-promise-call
  "promise.m(args...) of the coroutine whose body `ctx` analyzes ([dcl.fct.def.coroutine]/5's p)."
  [ctx ^String m args]
  (let [co (:coro ctx)]
    (analyze ctx (member-call-node {:op :var :id (:promise co) :ty (:ptype co) :cat :lv} m args))))

(defn- coro-await
  "The await-expression of the operand `e` ([expr.await]/3.2-3.7): a co_await's operand through promise.await_transform
  when the promise type declares one (`how` :await; not a co_yield's, nor the initial and final suspends), then its operator
  co_await when one is viable, the awaiter materialized when a prvalue; await_ready contextually converted to bool,
  await_suspend called with std::coroutine_handle<P>::from_address(the frame) converted to its parameter, await_resume the
  expression's value. {:op :co-await :id k :e awaiter :ready :suspend :sk :void|:bool :resume :final}, the awaiter the opaque
  value k in the three calls."
  [ctx e how]
  (let [co (or (:coro ctx) (fail :coroutine "co_await outside a coroutine"))
        a (if (and (= how :await) (:await-transform co)) (coro-promise-call ctx "await_transform" [e]) e)
        aw (or (when (class-operand? a) (operator-call ctx " co_await" [a])) a)
        aw (if (and (= :pr (:cat aw)) (abi/class? (abi/unq (:ty aw)))) (materialize aw) aw)
        _ (when-not (and (lv? aw) (class-id (:ty aw))) (fail :coroutine "an awaiter of type " (pr-str (:ty aw))))
        k (swap! opaque-ids inc)
        ov {:op :opaque :id k :ty (:ty aw) :cat :lv}
        call (fn [m args] (analyze ctx (member-call-node ov m args)))
        ready (to-bool (call "await_ready" []))
        ht ((:instantiate-class @hooks) (:id (std-template "coroutine_handle")) [(:ptype co)])
        fa (or (some (fn [[_ x]] (when (= :fn (:e x)) (:id x))) (class-lookup (class-id ht) "from_address"))
               (fail :coroutine "no coroutine_handle<P>::from_address"))
        h (fn-call ctx fa [{:op :coro-frame :ty (abi/ptr abi/void) :cat :pr}])
        sus (call "await_suspend" [h])
        st (abi/unq (:ty sus))
        ;; ([expr.await]/5.1-5.3: a coroutine_handle's, the symmetric transfer, is not built yet)
        sk (cond (abi/void? st) :void (= :bool (abi/bn st)) :bool :else (fail :coroutine "an await_suspend returning " (pr-str st)))
        res (call "await_resume" [])]
    {:op :co-await :id k :e aw :ready ready :suspend sus :sk sk :resume res :final (= how :final) :ty (:ty res) :cat (:cat res)}))

(declare analyze*)

(defn analyze
  "The typed expression of the tree node `n` in the context `ctx` ({:scope :fn :this-type ...})."
  [ctx n]
  (if-let [^longs d *analyze-depth*]
    (let [k (aget d 0)]
      (when (> k max-analyze-depth) (throw (StackOverflowError.)))
      (aset d 0 (inc k))
      (try (analyze* ctx n) (finally (aset d 0 k))))
    (analyze* ctx n)))

(defn- analyze*
  [ctx n]
  (let [r (analyze-node ctx n)]
    ;; (cpp-1123, the checker: a prvalue of an abstract class type, or an array of it, made by an evaluated call, explicit
    ;; type conversion or list -- a temporary of that type, [class.abstract]/3: other/abstract8.C's `A{}`, `Aa{}`, `f()`)
    (when (and (checking?) (not *unevaluated*) (map? r) (= :pr (:cat r))
               (#{"CallExpr" "CXXMemberCallExpr" "CXXOperatorCallExpr" "CXXTemporaryObjectExpr" "CXXFunctionalCastExpr"
                  "CXXStaticCastExpr" "CStyleCastExpr"} (:kind n)))
      (cx-abstract! (:ty r) n "an object"))
    ;; (CX12, the checker: a binary operator's position kept, for the constant evaluation's diagnostics)
    ;; (h-cpp-consteval: and an assignment's, an increment's)
    ;; (a begin inside a macro's expansion, its expansion's location: the line the diagnostic is on)
    ;; (cpp-p2564: a default argument's or a default member initializer's at its use, *cx-at-override*)
    (if (and (checking?) (map? r) (:op r) (not (#{:int :float :str :null} (:op r))) (:range n) (or *cx-at-override* (not (:cx-at r))))
      (assoc r :cx-at (or *cx-at-override* (let [b (get-in n [:range :begin])] (if-let [x (:expansionLoc b)] (assoc (:range n) :begin x) (:range n)))))
      r)))

;; ---------------------------------------------------------------------------------------------
;; __PRETTY_FUNCTION__ as GCC writes it (cpp-1123; the GCC 15.2 manual, "Function Names as Strings": "the signature of the
;; function as well as its bare name"; the spelling below observed on g++ 15.2 by hand, behaviour only, no GCC code): the
;; declaration specifiers static and virtual, the return type (none for a constructor, destructor or conversion function),
;; the qualified name, the parameters, the cv- and ref-qualifiers; a function of a template (a member of a class template's
;; specialization, a function template's specialization) printed as its pattern, its parameters' names, then
;; " [with P = A; ...]" binding them, the function template's parameters first, then each enclosing class template's from
;; the innermost out. Types print as GCC's: `long int`, `long unsigned int`, `char*`, `const char*`, `int (*)(int)`,
;; `int (&)[3]`, `std::nullptr_t`, `std::vector<std::vector<int> >`, namespaces' `{anonymous}`; a specialization's trailing
;; arguments that are the standard library's defaults (allocator, char_traits, less, hash, equal_to, default_delete of the
;; first argument) left out as GCC leaves out an argument equal to its default. A pattern's types print from their
;; spelling, normalized (GCC prints them from its trees: a spelling's own qualification is kept).

(def ^:private gcc-builtin-names
  {:bool "bool" :char "char" :schar "signed char" :uchar "unsigned char" :char8 "char8_t" :short "short int"
   :ushort "short unsigned int" :char16 "char16_t" :int "int" :uint "unsigned int" :char32 "char32_t" :wchar "wchar_t"
   :long "long int" :ulong "long unsigned int" :llong "long long int" :ullong "long long unsigned int" :i128 "__int128"
   :u128 "__int128 unsigned" :float "float" :double "double" :ldouble "long double" :void "void" :nullptr "std::nullptr_t"
   :float16 "_Float16" :float128 "__float128" :float32 "_Float32" :float64 "_Float64" :float128n "_Float128" :float32x "_Float32x"
   :float64x "_Float64x" :bf16 "__bf16"})

(declare gcc-type-str gcc-spell)

(defn- gcc-tmpl-params
  "The template `tid`'s parameters ([{:name :kind :qt}]), from arbace.cpp.template's state when it is loaded."
  [tid]
  (when-let [v (resolve 'arbace.cpp.template/*tmpls*)]
    (when-let [a @v] (:params (get @a tid)))))

(defn- gcc-default-arg?
  "Whether a class specialization's trailing argument `a` is one the standard library's templates default from the
  first argument `a0` (GCC leaves an argument equal to its default out)."
  [a a0]
  (and (abi/class? a)
       (let [c (abi/cls (:id a))]
         (and (= "std" (some (fn [p] (when (= :ns (first p)) (second p))) (:path c)))
              (contains? #{"allocator" "char_traits" "less" "hash" "equal_to" "default_delete"} (:name c))
              (= [(abi/unq a0)] (mapv abi/unq (:targs c)))))))

(defn- gcc-arg-str ^String [a]
  (cond
    (and (map? a) (contains? a :val))
    (let [v (:val a) t (abi/unq (:ty a))]
      (cond (= :bool (abi/bn t)) (if (and v (not= 0 v) (not= false v)) "true" "false")
            (and (#{:char :schar :uchar} (abi/bn t)) (integer? v) (<= 32 (long v) 126)) (str "'" (char (long v)) "'")
            :else (str v)))
    (map? a) (gcc-type-str a)
    :else (str a)))

(defn- gcc-targs-str ^String [args & [tid]]
  (let [args (vec args)
        params (when tid (vec (gcc-tmpl-params tid)))
        ;; a trailing argument equal to its parameter's default: a library default of the first argument's, or one whose
        ;; default's spelling prints as the argument does (`class U = int`)
        dflt? (fn [as] (let [i (dec (count as)) a (peek as) d (:default (get params i))]
                         (or (gcc-default-arg? a (first as))
                             (and (string? d) (map? a) (not (contains? a :val)) (= (gcc-spell d) (gcc-arg-str a))))))
        args (loop [as args] (if (and (> (count as) 1) (dflt? as)) (recur (pop as)) as))
        s (str/join ", " (map gcc-arg-str args))]
    (str "<" s (if (str/ends-with? s ">") " >" ">"))))

(defn- gcc-scope-str
  "The qualification of the parts `path` (`ns::C<int>::`), \"\" for the global namespace."
  ^String [path]
  (apply str (for [p path]
               (str (case (first p)
                      :ns (second p)
                      :anon "{anonymous}"
                      :cls (let [c (abi/cls (second p))] (str (:name c) (when (:tmpl c) (gcc-targs-str (:targs c) (:tmpl c)))))
                      :enum (:name (abi/enm (second p)))
                      "?")
                    "::"))))

(defn- gcc-class-name ^String [c]
  (str (gcc-scope-str (:path c)) (or (:name c) "<unnamed>") (when (:tmpl c) (gcc-targs-str (:targs c) (:tmpl c)))))

(defn- gcc-decl
  "GCC's spelling of the type `t` around the declarator `d` (\"\" for an abstract one)."
  ^String [t ^String d]
  (let [cv (str (when (:c t) "const") (when (and (:c t) (:v t)) " ") (when (:v t) "volatile"))
        group? (fn [^String s] (boolean (re-find #"^(\*|&|[A-Za-z_{].*::\*)" s)))
        wrap (fn [^String s] (if (group? s) (str "(" s ")") s))
        lead (fn [^String base ^String d] (cond (str/blank? d) base
                                                (or (str/starts-with? d "(") (str/starts-with? d "[")) (str base " " d)
                                                (re-find #"^[A-Za-z_]" d) (str base " " d)
                                                :else (str base d)))
        named (fn [^String n] (lead (if (seq cv) (str cv " " n) n) d))]
    (case (:k t)
      :b (named (get gcc-builtin-names (:n t) (name (:n t))))
      :class (named (gcc-class-name (abi/cls (:id t))))
      :enum (named (let [e (abi/enm (:id t))] (str (gcc-scope-str (:path e)) (:name e))))
      :ptr (gcc-decl (:to t) (str "*" (when (seq cv) (str " " cv)) d))
      :ref (gcc-decl (:to t) (str "&" d))
      :rref (gcc-decl (:to t) (str "&&" d))
      :mptr (gcc-decl (:to t) (str (if (map? (:cls t)) (gcc-type-str (:cls t)) (gcc-class-name (abi/cls (:cls t)))) "::*" (when (seq cv) (str " " cv)) d))
      :arr (gcc-decl (:of t) (str (wrap d) "[" (or (:n t) "") "]"))
      :fn (gcc-decl (:ret t) (str (wrap d) "(" (str/join ", " (concat (map #(gcc-decl % "") (:ps t)) (when (:va t) ["..."]))) ")"))
      (:tparam :tdep) (named (str (or (:name t) "?")))
      (named (or (:name t) "?")))))

(defn gcc-type-str ^String [t] (gcc-decl t ""))

(defn- gcc-builtin-spelling
  "A run of the builtin type keywords as GCC names the type (`unsigned` unsigned int, `long unsigned` long unsigned int)."
  ^String [ws]
  (let [n-long (count (filter #{"long"} ws)) u (some #{"unsigned"} ws) s (some #{"signed"} ws)
        has (fn [w] (some #{w} ws))]
    (cond
      (has "char") (cond u "unsigned char" s "signed char" :else "char")
      (has "short") (if u "short unsigned int" "short int")
      (has "double") (if (pos? n-long) "long double" "double")
      (= 2 n-long) (if u "long long unsigned int" "long long int")
      (= 1 n-long) (if u "long unsigned int" "long int")
      u "unsigned int"
      :else "int")))

(defn- gcc-spell
  "A type's spelling as written, normalized to GCC's printing: one space between words, none before `*` and `&`, a space
  after a comma, builtin keyword runs as GCC names them, `T const` as `const T` for a single word."
  ^String [^String s]
  (let [toks (re-seq #"[A-Za-z_][A-Za-z_0-9]*|::|\.\.\.|&&|[^\sA-Za-z_0-9]" (str s))
        kw #{"unsigned" "signed" "short" "long" "int" "char" "double"}
        toks (loop [ts toks out []]
               (if-let [t (first ts)]
                 (if (and (kw t) (not (and (= t "int") (empty? (filter #{"unsigned" "signed" "short" "long"} (take-while kw ts)))
                                           (not (kw (second ts)))))
                          (not (and (#{"char" "double"} t) (not (kw (second ts))))))
                   (let [run (take-while kw ts)] (recur (drop (count run) ts) (conj out (gcc-builtin-spelling run))))
                   (recur (rest ts) (conj out t)))
                 out))
        word? (fn [^String t] (boolean (re-find #"^[A-Za-z_0-9]" t)))]
    (loop [ts toks prev nil sb (StringBuilder.)]
      (if-let [^String t (first ts)]
        (let [sep (cond (nil? prev) ""
                        (= prev ",") " "
                        (and (word? prev) (word? t)) " "
                        (and (= prev ">") (word? t)) " "
                        (and (#{"*" "&" "&&"} prev) (word? t)) " "
                        (and (= t "(") (word? prev)) " "
                        (and (= t "(") (= prev ">")) " "
                        :else "")]
          (recur (rest ts) t (.append (.append sb ^String sep) t)))
        (-> (str sb) (str/replace #"^(\w+) const(?=$|[*&])" "const $1") (str/replace ">>" "> >"))))))

(defn- gcc-split-fn-text
  "A function type's spelling `R (P, ...) quals`: [R [P ...]] at its outermost parameter list, or nil."
  [^String qt]
  (let [s (str qt) n (count s)]
    ;; the parameter list: the top-level parenthesis whose group is followed only by qualifiers
    (loop [i 0 depth 0 start -1 found nil]
      (if (>= i n)
        (when found
          (let [[a b] found
                inner (subs s (inc a) b)
                ps (loop [j 0 d 0 cur (StringBuilder.) acc []]
                     (if (>= j (count inner))
                       (let [c (str/trim (str cur))] (if (seq c) (conj acc c) acc))
                       (let [ch (.charAt inner j)]
                         (cond
                           (and (= ch \,) (zero? d)) (recur (inc j) d (StringBuilder.) (conj acc (str/trim (str cur))))
                           (#{\( \< \[} ch) (recur (inc j) (inc d) (.append cur ch) acc)
                           (#{\) \> \]} ch) (recur (inc j) (dec d) (.append cur ch) acc)
                           :else (recur (inc j) d (.append cur ch) acc)))))]
            [(str/trim (subs s 0 a)) (if (= ps ["void"]) [] ps)]))
        (let [ch (.charAt s i)]
          (cond
            (and (= ch \() (zero? depth)) (recur (inc i) 1 i found)
            (#{\( \< \[} ch) (recur (inc i) (inc depth) start found)
            (and (= ch \)) (= depth 1)) (recur (inc i) 0 -1 (if (re-matches #"\s*(const|volatile|&|&&|noexcept(\(.*\))?|throw\s*\(.*\)|\s)*(->.*)?" (subs s (inc i))) [start i] found))
            (#{\) \> \]} ch) (recur (inc i) (dec depth) start found)
            :else (recur (inc i) depth start found)))))))

(defn- gcc-pretty-function
  "__PRETTY_FUNCTION__ of the function `f` (sema's record), or nil when its parts are not known (the bare name stands)."
  [f]
  (let [cid (:cls f)
        c (when cid (abi/cls cid))]
    (when-not (or (nil? f) (:lambda c))
      (let [;; the template parameters bound around the function, innermost first: [[params args] ...]
            fn-t (when-let [ti (:tinst f)] [(gcc-tmpl-params (:tid ti)) (:args ti)])
            cls-chain (loop [c c acc []]
                        (if-not c acc
                          (recur (some (fn [p] (when (= :cls (first p)) (abi/cls (second p)))) (reverse (:path c)))
                                 (if (:tmpl c) (conj acc [(gcc-tmpl-params (:tmpl c)) (:targs c)]) acc))))
            binds (cond->> cls-chain fn-t (cons fn-t))
            templated? (boolean (seq binds))
            node (:node f)
            pattern (when templated? (gcc-split-fn-text (get-in node [:type :qualType])))
            _ (when (and templated? (not pattern)) (throw (ex-info "no pattern" {})))
            pname (fn [c] (str (:name c) (when-let [ps (and (:tmpl c) (gcc-tmpl-params (:tmpl c)))]
                                           (str "<" (str/join ", " (map #(str (:name %) (when (:pack %) "...")) ps)) ">"))))
            cls-q (when c (str (if templated? (str (gcc-scope-str (:path c)) (pname c)) (gcc-class-name c)) "::"))
            ns-q (if c cls-q (gcc-scope-str (vec (:path f))))
            nm (case (:kind f)
                 :dtor (str "~" (:name c))
                 :ctor (str (:name c))
                 :conv (str "operator " (if templated? (gcc-spell (first pattern)) (gcc-type-str (:ret (:ty f)))))
                 (str (:name f)))
            nm (if (and (:tinst f) (not (str/starts-with? nm "operator"))) (str/replace nm #"<.*$" "") nm)
            ps (if templated?
                 (mapv gcc-spell (second pattern))
                 (vec (concat (map gcc-type-str (:ps (:ty f))) (when (:va (:ty f)) ["..."]))))
            ret (when-not (#{:ctor :dtor :conv} (:kind f))
                  (if templated? (gcc-spell (first pattern)) (gcc-type-str (:ret (:ty f)))))
            with (when templated?
                   (str/join "; " (for [[params args] binds :when (seq params)
                                        [p a] (map vector params args)]
                                    (str (when (= :value (:kind p)) (str (gcc-spell (:qt p)) " ")) (:name p) " = " (gcc-arg-str a)))))]
        (str (when (and c (:static f)) "static ") (when (and c (:virtual f)) "virtual ")
             (when ret (str ret " ")) ns-q nm "(" (str/join ", " ps) ")"
             (when (:cq f) " const") (when-let [r (:refq f)] (str " " r))
             (when (seq with) (str " [with " with "]")))))))

(defn- predefined-name
  "__func__, __FUNCTION__ (the bare name) or __PRETTY_FUNCTION__ (GCC's signature) of the function `f`."
  ^String [f ^String which]
  (let [bare (case (:kind f)
               :dtor (str "~" (:name (abi/cls (:cls f))))
               :ctor (str (:name (abi/cls (:cls f))))
               :conv (str "operator " (gcc-type-str (:ret (:ty f))))
               (let [nm (str (:name f))] (if (str/starts-with? nm "operator") nm (str/replace nm #"<.*$" ""))))]
    (if (and f (= "__PRETTY_FUNCTION__" which))
      (or (try (gcc-pretty-function f) (catch Exception _ nil)) bare)
      (if f bare ""))))

(defn- analyze-node
  [ctx n]
  (tick!)
  (when-let [a *at*] (when (:range n) (reset! a n)))
  (case (:kind n)
    ;; (queue 393: an expression analyzed already, in a node the analysis builds, a coroutine's promise and awaiter calls)
    "_Typed" (:_e n)
    ;; (queue 393: co_await e and co_yield e, promise.yield_value(e) awaited ([expr.yield]/1), in a coroutine's body; the
    ;; parser's CoyieldExpr holds clang's member call of yield_value, the written operand its second child)
    "CoawaitExpr" (if (:coro ctx) (coro-await ctx (analyze ctx (first (kids n))) :await) (fail :expr "expression " (:kind n)))
    "CoyieldExpr" (if (:coro ctx)
                    (coro-await ctx (coro-promise-call ctx "yield_value" [(analyze ctx (second (kids (first (kids n)))))]) :yield)
                    (fail :expr "expression " (:kind n)))
    "IntegerLiteral" (let [t (int-type-of (get-in n [:type :qualType]))] {:op :int :v (let [v (bigint (:value n))] (if (> v Long/MAX_VALUE) (long (- v 18446744073709551616N)) (long v))) :ty t :cat :pr})
    "CharacterLiteral" {:op :int :v (long (:value n)) :ty (int-type-of (get-in n [:type :qualType] "char")) :cat :pr}
    ;; a type trait's value (G4: the headers' __is_constructible(T, Args...)), its text evaluated by the templates' hook
    ;; a user-defined literal ([lex.ext]/3-8): the literal operator's call, operator""X(...) with the literal's value
    "UserDefinedLiteral"
    (if-let [u (:_udl n)]
      (let [opname (str "operator\"\"" (:suffix u))
            callee {:kind "DeclRefExpr" :referencedDecl {:name opname} :range (:range n)}
            ;; (cpp-1123: [lex.ext]/3-4, a numeric literal's operator: one whose parameter is unsigned long long (an integer)
            ;; or long double (a floating literal) called with the value; else the raw literal operator (const char*) with the
            ;; spelling as a string; else the numeric literal operator template with the spelling's characters as its
            ;; template arguments, operator""X<'c', ...>(): <chrono>'s `operator""min<'0'>()` for 0min, tzdb.cc)
            numeric (when (#{:int :float} (:k u))
                      (let [es (try (lookup (:scope ctx) opname) (catch arbace.lang.ExceptionInfo _ nil))
                            one-param (fn [pred] (some #(when (= :fn (:e %))
                                                          (let [ps (:ps (:ty (fnd (:id %))))]
                                                            (and (= 1 (count ps)) (pred (abi/unq (first ps))))))
                                                       es))
                            want (if (= :int (:k u)) :ullong :ldouble)]
                        (cond
                          (one-param #(= want (abi/bn %))) nil
                          (and (:text u) (one-param #(and (abi/ptr? %) (= :char (abi/bn (abi/unq (:to %)))))))
                          {:raw true}
                          (and (:text u) (some #(= :tmpl (:e %)) es))
                          {:tmpl (mapv #(if (= \' %) "'\\''" (str "'" % "'")) (:text u))})))
            args (case (:k u)
                   :str [{:kind "StringLiteral" :value (:value u) :type {:qualType (str "const " (:ty u) "[" (:n u) "]")} :valueCategory "lvalue" :range (:range n)}
                         {:kind "IntegerLiteral" :value (str (dec (long (:n u)))) :type {:qualType "unsigned long"} :valueCategory "prvalue"}]
                   :chr [{:kind "CharacterLiteral" :value (:value u) :type {:qualType (:ty u)} :valueCategory "prvalue"}]
                   :int [{:kind "IntegerLiteral" :value (str (:value u)) :type {:qualType "unsigned long long"} :valueCategory "prvalue"}]
                   :float [{:kind "FloatingLiteral" :value (str (:value u)) :type {:qualType "long double"} :valueCategory "prvalue"}])
            [callee args] (cond
                            (:raw numeric)
                            [callee [{:kind "StringLiteral" :value (pr-str (:text u)) :type {:qualType (str "const char[" (inc (count (:text u))) "]")}
                                      :valueCategory "lvalue" :range (:range n)}]]
                            (:tmpl numeric)
                            [(assoc callee :_wn true :explicitTemplateArgs (:tmpl numeric)) []]
                            :else [callee args])]
        (analyze ctx {:kind "CallExpr" :inner (vec (cons callee args)) :range (:range n)}))
      (fail :expr "a user-defined literal"))
    "AtomicExpr" (if (:_atomic n) (atomic-expr ctx (:_atomic n) (:_args n)) (fail :expr "AtomicExpr"))
    ;; __builtin_va_arg(ap, T) (clang's VAArgExpr; G5): the next argument of a va_list
    ;; __builtin_offsetof(T, m.n[i]) ([support.types.layout]/1; clang's OffsetOfExpr, folded by ExprConstant's
    ;; VisitOffsetOfExpr): the fields' offsets in their classes' layouts, a member of a base class at its base's offset, an
    ;; index times its element's size
    "BuiltinExpr" (if-let [{:keys [type path]} (:_offsetof n)]
                    (loop [t (resolve-type (:scope ctx) type) off 0 [c & cs] path]
                      (if-not c
                        {:op :int :v off :ty abi/ulong* :cat :pr}
                        (if-let [nm (:f c)]
                          (let [cid (or (class-id t) (fail :expr "offsetof in a non-class " (pr-str t)))
                                [owner e] (first (class-lookup cid nm))
                                bo (when owner (let [[_ o vb] (abi/base-path cid owner)] (when vb (if (checking?)
                                                                                                  ;; (cpp-decl2: GCC's error, [support.types.layout]/1's conditionally-
                                                                                                  ;; supported non-standard-layout class: other/offsetof8.C)
                                                                                                  (fail :null-object "invalid access to non-static data member '" nm "' of NULL object (through a virtual base)")
                                                                                                  (fail :expr "offsetof through a virtual base"))) o))
                                chain (case (:e e) :field [[(:cls e) (:i e)]] :indirect (:chain e) (fail :expr "offsetof of a non-field " nm))
                                fo (reduce (fn [a [k i]] (+ (long a) (long (get (:fields (abi/layout k)) i)))) 0 chain)
                                [k i] (peek chain)]
                            (when (:bits (nth (:fields (abi/cls k)) i)) (fail :expr "offsetof of a bit-field"))
                            (recur (:ty (nth (:fields (abi/cls k)) i)) (+ off (long bo) (long fo)) cs))
                          (let [at (abi/unq t)
                                _ (when-not (abi/arr? at) (fail :expr "offsetof's [] of a non-array"))
                                i (or (:v (ce-try (rv (analyze ctx (:i c))))) (fail :expr "offsetof's index not a constant"))]
                            (recur (:of at) (+ off (* (long i) (long (abi/size-of (:of at))))) cs)))))
                  (if-let [x (:_vaarg n)]
                    (let [t (resolve-type (:scope ctx) (:_vatype n))]
                      {:op :va-arg :e (rv (analyze ctx x)) :ty (abi/unq t) :cat :pr})
                    (if-let [x (:_bitcast n)]
                      (bit-cast-expr ctx (resolve-type (:scope ctx) (:_bctype n)) (analyze ctx x))
                      (fail :expr "a builtin expression " (node-text n)))))
    "TypeTraitExpr" (let [t (or (:_text n) (node-text n))
                          v (if-let [h (:trait-text @hooks)] (h (:scope ctx) t) (fail :expr "a type trait"))]
                      (when (map? v) (fail :expr "a dependent type trait " t))
                      {:op :int :v (long v) :ty (if (re-find #"^\s*__(is|has|reference)_" t) abi/bool* abi/ulong*) :cat :pr})
    "CXXBoolLiteralExpr" {:op :int :v (if (:value n) 1 0) :ty abi/bool* :cat :pr}
    "FloatingLiteral" (let [qt (get-in n [:type :qualType])]
                        {:op :float :v (Double/parseDouble (:value n)) :lit (when (= qt "long double") (:value n))
                         :ty (case qt "float" abi/float* "long double" (abi/b :ldouble) "_Float16" (abi/b :float16) "__float128" (abi/b :float128)
                               ;; (cpp-extfloat: GCC's suffixes, arbace.repr.cpp.lit/*gnu-floats*)
                               "_Float32" (abi/b :float32) "_Float64" (abi/b :float64) "_Float128" (abi/b :float128n)
                               "_Float32x" (abi/b :float32x) "_Float64x" (abi/b :float64x) "__bf16" (abi/b :bf16) abi/double*) :cat :pr})
    ;; (cpp-s12, CP382 (a): a wide or Unicode literal, L, u, U, as its code units, :units, the element type's width
    ;; each: UTF-32 for U and L (wchar_t on x86-64 Linux), UTF-16 for u, as the parser encoded them; u8's char8_t a narrow
    ;; literal's bytes. <format>'s _GLIBCXX_WIDEN(S) is `_Widen<_CharT>(S, L##S)`, so every char instantiation names the
    ;; wide literal too, its consteval call choosing the narrow one)
    "StringLiteral" (let [t (resolve-type (:scope ctx) (get-in n [:type :qualType]))
                          eb (abi/bn (abi/unq (:of t)))]
                      (cond
                        (#{:char :schar :uchar :char8} eb) {:op :str :s (decode-string (:value n)) :ty t :cat :lv}
                        (#{:wchar :char16 :char32} eb) {:op :str :units (wide-units (:value n)) :w (abi/size-of (abi/unq (:of t))) :ty t :cat :lv}
                        :else (fail :string "a string literal of " (pr-str (:of t)))))
    ;; __func__, __FUNCTION__, __PRETTY_FUNCTION__ ([dcl.fct.def.general]/8): the enclosing function's name (the pretty
    ;; one approximated by the name: G4, the headers' assertions, whose strings no run reads)
    ;; (cpp-1123: each name as GCC gives it, __PRETTY_FUNCTION__ its signature, predefined-name; before, the bare name for all)
    "PredefinedExpr" (let [nm (predefined-name (fnd (:fn-id ctx)) (str/trim (node-text n)))]
                       {:op :str :s nm :ty (abi/arr (inc (count nm)) (assoc abi/char* :c true)) :cat :lv})
    ;; a requires-expression ([expr.prim.req]): true when each requirement holds, its parameters local names of their
    ;; types; an expression's requirement holds when it analyzes (a substitution failure is false), a type's when it
    ;; resolves, a nested one when its constraint is satisfied; a compound one's return-type requirement not checked (G4)
    "RequiresExpr" (if (and (empty? (:inner n)) (nil? (:params n)))
                     (fail :expr "a requires-expression the parser kept as its text")
                     (let [c (block-ctx ctx)
                           ;; (n-cpp-concepts, the checker: a parameter of type void, [dcl.fct]/2 with [expr.prim.req.general]/5:
                           ;; the substitution fails, the requires-expression false; GCC's "invalid parameter type", reported
                           ;; at the requires-expression)
                           void-param (atom false)
                           _ (doseq [pn (:params n)
                                     :let [qt (str (get-in pn [:type :qualType]))
                                           ;; (queue 518: a function parameter pack, `Args&&... args` of cpp2a/concepts-pr67148.C's
                                           ;; Function concept, [expr.prim.req.general]/3: its parameters from the expanded
                                           ;; parameter list, its name standing for them, as fn-type-scope's :varpack)
                                           fty (when (re-find #"\.\.\.\s*$" qt)
                                                 (try (resolve-type (:scope c) (str "void (" qt ")")) (catch arbace.lang.ExceptionInfo _ nil)))
                                           pk (when (and (= :fn (:k fty)) (not-any? #(= :pack-exp (:k %)) (:ps fty))) (:ps fty))]]
                             (if pk
                               (let [ids (mapv (fn [t] (let [id (next-id)] (swap! *vars* assoc id {:id id :name nil :ty t :storage :local :fn (:fn-id ctx)}) id)) pk)]
                                 (when (:name pn) (enter! (:scope c) (:name pn) {:e :varpack :ids ids})))
                               (let [id (next-id)
                                     pt (resolve-type (:scope c) (get-in pn [:type :qualType]))]
                                 (when (and (checking?) (abi/void? pt) (not (:c pt)) (not (:v pt)) (not (str/includes? (str (get-in pn [:type :qualType])) "...")))
                                   (reset! void-param true))
                                 (swap! *vars* assoc id {:id id :name (:name pn) :ty pt :storage :local :fn (:fn-id ctx)})
                                 (when (:name pn) (enter! (:scope c) (:name pn) {:e :var :id id})))))
                           ;; (queue 584: not for a requires-expression inside a fold expression that is the atomic constraint,
                           ;; [temp.constr.atomic]: GCC explains the fold, its expression false, cpp2a/concepts-requires33.C,
                           ;; g++ 15.2's recorded errors)
                           _ (when (and @void-param (not= "CXXFoldExpr" (:kind (last *constraint-node*))))
                               (when-let [h *on-refusal*]
                                 (h (ex-info "codegen: invalid parameter type 'void' in a requires-expression's parameters" {:codegen/refused :constraint :cx/node n}) n)))
                           ;; (CX12, the checker: a requirement the program surely fails is false with no doubt: a type
                           ;; requirement naming a member of a type that is no class, [temp.res.general]/3's typename-
                           ;; specifier over a scalar or pointer; an expression requirement whose analysis failed by an error
                           ;; Sema is sure of, `*` of a non-pointer or a member of a non-class)
                           type-sure-false? (fn [r]
                                              (when-let [[_ q] (re-matches #"(?:typename\s+)?(.+?)\s*::\s*(?:template\s+)?[A-Za-z_]\w*(?:<.*>)?" (str/trim (str (get-in r [:type :qualType]))))]
                                                (let [qt (try (abi/unq (abi/non-ref (resolve-type (:scope c) q))) (catch arbace.lang.ExceptionInfo _ nil))
                                                      ;; (n-cpp-concepts: else the qualifier's first name, a plain identifier bound
                                                      ;; to a type that is no class: T::_name_t::template _member_t<int> for T = int,
                                                      ;; concepts/template-parm11.C)
                                                      qt (or qt (when-let [[_ q0] (re-matches #"([A-Za-z_]\w*)\s*::.*" q)]
                                                                  (try (abi/unq (abi/non-ref (resolve-type (:scope c) q0))) (catch arbace.lang.ExceptionInfo _ nil))))]
                                                  (and qt (or (abi/arith? qt) (abi/ptr? qt) (abi/void? qt))))))
                           sure-expr-failure? sure-failure?
                           ok? (fn [r]
                                 (try (case (:kind r)
                                        "TypeRequirement" (try (resolve-type (:scope c) (get-in r [:type :qualType]))
                                                               ;; (n-cpp-concepts, [expr.prim.req.type]/1 with [class.access]/1: a
                                                               ;; private or protected member type named where no class's scope
                                                               ;; grants it, a concept's definition, is a substitution failure)
                                                               (when (and (checking?) (not (:this-type c)) (not (class-scope? (:scope c))))
                                                                 (check-type-access! (:scope c) (-> (str (get-in r [:type :qualType])) (str/replace #"^\s*typename\s+" "") (str/replace #"\s*::\s*" "::")) r))
                                                               true
                                                               (catch arbace.lang.ExceptionInfo e
                                                                 ;; (n-cpp-concepts: and a nested-name-specifier naming a type
                                                                 ;; that is no class, [temp.res.general]/3, resolve-type-form's)
                                                                 (if (and (checking?) (or (type-sure-false? r) (sure-failure? e)
                                                                                          (re-find #"^codegen: a scope of a non-class" (str (ex-message e)))))
                                                                   false (throw e))))
                                        "NestedRequirement" (constraint-satisfied? (:scope c) (first (:inner r)))
                                        (let [x (binding [*cx-requirement* (checking?)] (analyze c (first (:inner r))))]
                                          (cond
                                            ;; (CX12, CP281 (a): a compound requirement's return-type-requirement,
                                            ;; [expr.prim.req.compound]/1.3: the type-constraint's immediately-declared
                                            ;; constraint satisfied by decltype((E)); since CP292 (a) for the code
                                            ;; generator too. What the slice cannot evaluate, and a noexcept it does
                                            ;; not check: in the checker a doubt, for the code generator true as before)
                                            ;; (n-cpp-concepts: one the parser found no type-constraint, its error given there:
                                            ;; judged by nothing)
                                            (:_ret_bad r) (do (doubt!) true)
                                            (and (:_ret r) (:type-constraint @hooks))
                                            (let [t (abi/non-ref (:ty x))
                                                  dt (case (:cat x) :lv (abi/lref t) :xv (abi/rref t) t)
                                                  d (atom false)
                                                  ok (binding [*constraint-doubt* d] ((:type-constraint @hooks) (:scope c) (str/trim (:_ret r)) dt))]
                                              (when @d (doubt!))
                                              (when (:_noexcept r) (doubt!))
                                              ;; (cpp-tpl2: a return-type-requirement surely not satisfied, GCC's "placeholder
                                              ;; constraints not satisfied" at it at -fconcepts-diagnostics-depth=2 or more)
                                              (when-let [xs (when (and (checking?) (false? ok) (not @d) (>= (long *concepts-diag-depth*) 2)) *cx-constraint-explain*)]
                                                (swap! xs conj {:msg "codegen: placeholder constraints not satisfied (a return-type-requirement)" :node (if (:range r) r (first (:inner r)))}))
                                              (cond (nil? ok) (if (checking?) (doubt!) true)
                                                    ;; (a false met with a doubt: for the code generator true, as before)
                                                    (and (not ok) @d (not (checking?))) true
                                                    :else ok))
                                            (or (:_ret r) (:_noexcept r)) (do (doubt!) true)
                                            ;; (cpp-tpl2, the checker: a non-static member function named by a class member access
                                            ;; and not called, [expr.ref]/6.3.2 ("can be used only as the left-hand operand of a
                                            ;; member function call"): GCC's "invalid use of non-static member function", the
                                            ;; requirement surely false, concepts/diagnostic10.C's `t.f`)
                                            (and (checking?) (#{"MemberExpr" "UnresolvedMemberExpr" "CXXDependentScopeMemberExpr"} (:kind (first (:inner r))))
                                                 (= :fnset (:op x)) (:obj x) (seq (:fns x))
                                                 (every? #(let [f (fnd %)] (and (:cls f) (not (:static f)))) (:fns x)))
                                            (fail :expr "invalid use of non-static member function '" (:name (fnd (first (:fns x)))) "'")
                                            :else true)))
                                      (catch arbace.lang.ExceptionInfo e
                                        ;; (cpp-tpl2: a requirement's sure error, GCC's explanation at -fconcepts-diagnostics-depth=2 or
                                        ;; more, *concepts-diag-depth*: at depth 1 GCC notes it)
                                        (when-let [xs (when (and (checking?) (sure-expr-failure? e) (>= (long *concepts-diag-depth*) 2)) *cx-constraint-explain*)]
                                          (swap! xs conj {:msg (ex-message e) :node (or (:cx/node (ex-data e)) (first (:inner r)) r)}))
                                        (when (System/getenv "CPP_CONCEPT_TRACE") (binding [*out* *err*] (println "requirement" (:kind r) "fails:" (ex-message e) "|" (some-> (node-text r) (subs 0 (min 120 (count (node-text r))))))))
                                        (if (and (checking?) (sure-expr-failure? e)) false (doubt!)))))]
                       {:op :int :v (if (and (not @void-param) (every? (fn [r] (let [v (ok? r)]
                                                         (when (and (not v) (System/getenv "CPP_CONCEPT_TRACE"))
                                                           (binding [*out* *err*] (println "requirement" (:kind r) "false:" (pr-str (some-> (node-text r) (subs 0 (min 120 (count (node-text r)))))) (pr-str (keys r)))))
                                                         v))
                                                (:inner n))) 1 0) :ty abi/bool* :cat :pr}))
    ;; noexcept(e) ([expr.unary.noexcept]): e unevaluated, true when no function it calls may throw (an implicit or
    ;; defaulted special member counted as not throwing; G4)
    "CXXNoexceptExpr" (let [x (binding [*unevaluated* true] (analyze ctx (first (kids n))))
                            fns (atom #{})
                            ;; (cpp-rt-own4, the code generator: a call through a pointer to member function of a type not
                            ;; non-throwing may throw, [except.spec]/6, since C++17 when noexcept is the type's (its :nx):
                            ;; <type_traits>' __call_is_nt for `long (Z::*)() const`, __is_nothrow_invocable had been true)
                            thr (atom false)
                            walk (fn walk [x] (cond (map? x) (when-not (:kind x)
                                                                (when (integer? (:fn x)) (swap! fns conj (:fn x)))
                                                                (when (and (= :mcall (:op x)) (not (checking?)) (>= (long *cxx-year*) 17) (not (:nx (:fty x))))
                                                                  (reset! thr true))
                                                                (doseq [[k v] x :when (not (#{:scope :node :def-scope :parent :names :usings :ty} k))] (walk v)))
                                                    (sequential? x) (doseq [y x] (walk y))
                                                    :else nil))]
                        (walk x)
                        {:op :int :v (if (and (not @thr) (every? #(let [f (fnd %)] (or (:noexcept f) (:implicit f) (:defaulted f))) @fns)) 1 0) :ty abi/bool* :cat :pr})
    "CXXNullPtrLiteralExpr" {:op :null :ty abi/nullptr-t :cat :pr}
    "GNUNullExpr" {:op :int :v 0 :ty abi/long* :cat :pr}
    "ParenExpr" (analyze ctx (first (kids n)))
    "DeclRefExpr" (let [x (name-expr ctx n)]
                    ;; (queue 497, the checker: a variable declared with GNU's unavailable attribute, named)
                    (when-let [v (when (checking?) (some #(when (and (map? %) (= :var (:op %)) (:id %)) %) [x (:e x) (:e (:e x))]))]
                      (when (:unavailable (var* (:id v)))
                        (fail :unavailable "'" (:name (var* (:id v))) "' is unavailable")))
                    x)
    "CXXThisExpr" (this-expr ctx)
    "UnaryOperator"
    (or
     ;; &C::m: a pointer to member ([expr.unary.op]/4)
     (when (and (= "&" (:opcode n)) (= "DeclRefExpr" (:kind (first (kids n)))))
       (let [k (first (kids n)) [g q] (ref-qualifier k)]
         (when (seq q)
           (let [es (lookup-qualified (:scope ctx) (conj q (get-in k [:referencedDecl :name])) g)
                 e (first es)]
             ;; (queue 502: the member's access through the qualifier's class, cx-mptr-access!)
             (cx-mptr-access! ctx es q g (get-in k [:referencedDecl :name]))
             (case (:e e)
               :field (let [qc (class-id (:ty (type-entity (lookup-qualified (:scope ctx) q g))))
                            f (nth (:fields (abi/cls (:cls e))) (:i e))]
                        (cond-> {:op :mptr-data :off (+ (long (second (abi/base-path qc (:cls e)))) (abi/field-offset (:cls e) (:i e)))
                                 :ty {:k :mptr :cls qc :to (:ty f)} :cat :pr}
                          ;; (cpp-ce2, the checker: the member for the constant evaluator, ce-eval's :mptr-data)
                          (checking?) (assoc :cx-cls (:cls e) :cx-i (:i e))))
               :fn (let [fs (mapv :id (filter #(= :fn (:e %)) es))
                         ms (filter #(let [f (fnd %)] (and (:cls f) (not (:static f)))) fs)]
                     (when (seq ms)
                       {:op :mptr-fnset :fns (vec ms) :ty {:k :overload} :cat :pr}))
               nil)))))
    (let [o (:opcode n) e (analyze ctx (first (kids n)))]
      (or (when (and (class-operand? e) (not= o "&")) (operator-call ctx o (if (and (#{"++" "--"} o) (:isPostfix n)) [e {:op :int :v 0 :ty abi/int* :cat :pr}] [e])))
          (when (class-operand? e) (no-operator! ctx o [e]))
          (case o
            "&" (cond (= :fnset (:op e)) (let [f (or (first (:fns e))
                                                     ;; (cpp-p2564, the checker: a template-id naming one specialization, fn-matching)
                                                     (when (and (empty? (:fns e)) (cx-p2564?)) (fn-matching e nil)))]
                                           ;; (queue 380, W3d: the address of an overloaded name keeps its set, :set, for the
                                           ;; target type to choose from, [over.over]/1: debug.cc's `pretty_print(ctx, s,
                                           ;; &print_string)` of print_string's two overloads; the first stands alone)
                                           ;; (queue 514, the checker: the address of a name that is one function and no template
                                           ;; is typed by it exactly, :one, so a deduction from it may fail surely)
                                           (cond-> {:op :fnaddr :fn f :ty (abi/ptr (:ty (fnd f))) :cat :pr}
                                             (and (empty? (:tmpls e)) (< 1 (count (distinct (:fns e))))) (assoc :set e)
                                             (and (checking?) (empty? (:tmpls e)) (= 1 (count (distinct (:fns e))))) (assoc :one true)))
                      (lv? e) {:op :addr :e e :ty (abi/ptr (:ty e)) :cat :pr}
                      :else (fail :addr "& of an rvalue"))
            "*" (deref-node e)
            ("++" "--") (do (when-not (lv? e) (fail :incdec "++ of an rvalue"))
                            (cx-read-only! e (if (= o "++") "increment" "decrement") ctx)
                            ;; (cpp-diag-b, 2026-11-22: [expr.pre.incr]/1, [expr.post.incr]/1: the operand of ++ is no bool since
                            ;; C++17 (deprecated before), of -- never: GCC's "use of an operand of type 'bool' in 'operator--' is
                            ;; forbidden")
                            (when (and (checking?) (= :bool (abi/bn (abi/unq (:ty e)))) (or (= o "--") (>= (long *cxx-year*) 17)))
                              (fail :bool-incdec "use of an operand of type 'bool' in 'operator" o "' is forbidden" (when (= o "++") " in C++17")))
                            {:op :incdec :o o :post (boolean (:isPostfix n)) :e e :ty (abi/unq (:ty e)) :cat (if (:isPostfix n) :pr :lv)})
            "!" {:op :not :e (to-bool e) :ty abi/bool* :cat :pr}
            ;; GNU's __real__ and __imag__ of a complex glvalue: the part's glvalue (cpp-s3); of a real operand, the
            ;; operand and zero (GCC's manual, "Complex Numbers")
            ("__real" "__imag")
            (let [t (abi/unq (:ty e))]
              (cond (= :complex (:k t)) (do (when-not (lv? e) (fail :complex "__real__ of a complex prvalue"))
                                            {:op :cpart :part (if (= o "__real") 0 1) :e e :ty (assoc (:of t) :c (:c (:ty e))) :cat (:cat e)})
                    (abi/arith? t) (cond (= o "__real") e (abi/floating? t) {:op :float :v 0.0 :ty t :cat :pr} :else {:op :int :v 0 :ty t :cat :pr})
                    :else (fail :operator "unary " o)))
            "__extension__" e
            ("-" "+" "~") (let [r (rv e) pt (promote-type (:ty r))]
                            ;; (cpp-diag-b, 2026-11-22: [expr.unary.op]/7-10: unary + takes an arithmetic, unscoped enumeration or
                            ;; pointer operand, unary - an arithmetic or unscoped enumeration one, ~ an integral or unscoped
                            ;; enumeration one: GCC's "wrong type argument to unary minus", "to bit-complement")
                            (when (checking?)
                              (let [t (abi/unq (:ty r)) en (and (abi/enum? t) (not (:scoped (abi/enm (:id t)))))]
                                (when (and (cx-sure-scalar? t)
                                           (case o
                                             "+" (not (or (abi/arith? t) en (abi/ptr? t)))
                                             "-" (not (or (abi/arith? t) en))
                                             "~" (not (or (abi/integral? t) en (= :complex (:k t)) (= :vec (:k t))))))
                                  (fail :unary-type "wrong type argument to unary " (case o "+" "plus" "-" "minus" "~" "bit-complement")))))
                            {:op :unop :o o :e (convert-scalar r pt false) :ty pt :cat :pr})
            (fail :operator "unary " o)))))
    "BinaryOperator"
    (let [o (:opcode n) [ln rn] (kids n) l (analyze ctx ln) r (analyze ctx rn)
          ;; (cpp-rind, the checker: a member function named as an assignment's left operand, `foo = 0;` with foo a member
          ;; function, [expr.ref]/6.3.2: GCC's "invalid use of member function 'void A::foo(int)'"; parse/error45.C)
          _ (when (and (checking?) (= "=" o) (= :fnset (:op l)) (seq (:fns l))
                       (every? #(let [f (fnd %)] (and (:cls f) (not (:static f)))) (:fns l)))

                  (fail :name "unknown name " nm)))
        ;; (cpp-rt-own2: of an integral, enumeration or floating operand that is no constant and has no side effects, not a
        ;; constant the code generator folds, as clang (ExprConstant fails it outside a constant context, CodeGen calls
        ;; llvm.is.constant, false at -O0): <stl_iterator_base_funcs.h>'s __advance keeps its `if (__builtin_constant_p(__n) &&
        ;; __n == -1) --__i;`, fs_path.cc's move_iterator<path::_Cmpt*>::operator--() written as clang writes it; 0 run time)
        :constant-p (let [x (rv (analyze ctx (second (kids n))))
                          t (abi/unq (:ty x))
                          pure? (fn pure? [e] (and (map? e) (case (:op e) (:int :float :var :null) true (:load :cast :field) (pure? (or (:e e) (:obj e))) false)))]
                      (cond (ce-try x) {:op :int :v 1 :ty abi/int* :cat :pr}
                            (and (or (abi/integral? t) (abi/enum? t) (abi/floating? t)) (pure? x)) {:op :int :v 0 :ty abi/int* :cat :pr :no-fold true}
                            :else {:op :int :v 0 :ty abi/int* :cat :pr}))
        ;; (CP378 (a): 0 in code that runs, marked :ice: the evaluator's 1 when manifestly constant-evaluated)
        :is-constant-evaluated {:op :int :v 0 :ice true :ty abi/bool* :cat :pr}
        :pause {:op :pause :ty abi/void :cat :pr}
        ;; (cpp-s8: __builtin_signbit(x), the sign bit of a floating x, -0 and a NaN's too: copysign(1, x) < 0 by libm's
        ;; copysign of x's type (clang reads the bit of the value's representation, the same answer); __builtin_isfinite(x):
        ;; x - x == x - x, false for an infinity and a NaN alone. Both an int, as clang's)
        ;; (cpp-rt-own: __builtin_isinf(x): x == x and x - x != x - x, an infinity alone (a NaN is not equal to itself, a finite
        ;; x - x is 0); __builtin_isnan(x): x != x. Both an int, as clang's, whose llvm.fabs and fcmp no unit's names see)
        (:signbit :isfinite :isinf :isnan)
        (let [xn (second (kids n))
              t (abi/unq (:ty (rv (analyze ctx xn))))
              qt (case (abi/bn t) :float "float" :ldouble "long double" :double "double"
                   (fail :type (name b) " of " (pr-str t)))
              lit (fn [v] {:kind "FloatingLiteral" :value v :type {:qualType qt} :valueCategory "prvalue" :range (:range n)})
              bin (fn [o a c] {:kind "BinaryOperator" :opcode o :inner [a c] :range (:range n)})
              node (case b
                     :signbit
                     {:kind "BinaryOperator" :opcode "<" :range (:range n)
                      :inner [{:kind "CallExpr" :range (:range n)
                               :inner [{:kind "DeclRefExpr" :referencedDecl {:name (str "__builtin_copysign" (case qt "float" "f" "long double" "l" ""))} :range (:range n)}
                                       (lit "1.0") xn]}
                              (lit "0.0")]}
                     :isfinite (let [d (bin "-" xn xn)] (bin "==" d d))
                     :isinf (let [d (bin "-" xn xn)] (bin "&&" (bin "==" xn xn) (bin "!=" d d)))
                     :isnan (bin "!=" xn xn))]

                                      ;; conversion function template returning a pointer among them, name more than one type --
                                      ;; GCC's "ambiguous default type conversion from 'B<int>'", template/delete2.C)
                                      (abi/class? t)
                                      (when-let [cid (class-id t)]
                                        (let [obj-ptr? (fn [r] (let [r (abi/unq (abi/non-ref r))] (and (abi/ptr? r) (not (abi/fn? (abi/unq (:to r)))))))
                                              rs (distinct (for [f (distinct (conv-fns cid)) :let [g (fnd f)]
                                                                 :when (and (not (:explicit g)) (obj-ptr? (:ret (:ty g))))]
                                                             (abi/unq (abi/non-ref (:ret (:ty g))))))
                                              ts (filter #(let [pt (:pattern ((requiring-resolve (quote arbace.cpp.template/tmpl)) %))]
                                                            (and (not (:explicit pt)) (re-find #"\*\s*(?:const\s*)?\(\)" (str (get-in pt [:type :qualType])))))
                                                         (conv-tmpls cid))]
                                          (when (and (> (+ (count rs) (count ts)) 1) (seq ts) (not (:header (abi/cls cid))))
                                            (fail :delete-arg "ambiguous default type conversion from '" (:name (abi/cls cid)) "'"))))
                                      (not (abi/ptr? t)) (when (cx-sure-scalar? t) (fail :delete-arg "type of the argument given to 'delete', expected pointer"))
                                      (abi/fn? (abi/unq (:to t))) (fail :delete-arg "cannot delete a function")
                                      :else nil)))
                          et (:to (abi/unq (:ty e)))
                          arr (boolean (:isArrayAsWritten n))
                          ;; (queue 497, the checker: [expr.delete]/9-10 with [dcl.fct.def.delete]/2, the class's own lookup of
                          ;; operator delete (a destroying one, [expr.delete]/10.1, among them) finding deleted functions alone:
                          ;; whichever the selection takes is deleted, GCC's "use of deleted function")
                          _ (when (and (checking?) (not (:isGlobal n)))
                              (when-let [cid (let [u (abi/unq et)] (when (abi/class? u) (class-id u)))]
                                (let [dn (if arr "operator delete[]" "operator delete")
                                      [k ids] (alloc-lookup cid dn false)]
                                  (when (and (= :class k) (seq ids) (every? #(let [f (fnd %)] (and (:deleted f) (:deleted-sure f))) ids))
                                    (fail :overload "call to a deleted function " dn))
                                  ;; (cpp-tpl2, the checker: [expr.delete]/12 ([class.free]: the deallocation function's access
                                  ;; checked), the class's own operator delete inaccessible in the context: in a function template's
                                  ;; signature substituted, a substitution failure, template/sfinae30.C's decltype(delete[] t); in
                                  ;; a function's body check-access!'s rule)
                                  (when (and (= :class k) (= 1 (count ids)))
                                    (let [acc (:access (fnd (first ids)))]
                                      (when (#{:private :protected} acc)
                                        (if (cx-subst?)
                                          (when (and (nil? (:cls (:scope ctx))) (not (cx-subst-friend? cid acc)))
                                            (fail :access "'" dn "' is a " (name acc) " member of '" (:name (abi/cls cid)) "'"))
                                          (check-access! ctx cid dn acc))))))))
                          d (delete-dealloc et arr (boolean (:isGlobal n)))
                          bt (loop [t (abi/unq et)] (if (abi/arr? t) (recur (abi/unq (:of t))) t)) c (class-id bt)]
                      {:op :delete :e e :array arr :dealloc d :global (boolean (:isGlobal n))
                       ;; the array's cookie: a non-trivial destructor, or a usual operator delete[] taking the size
                       :cookie (boolean (and arr (or (and c (not (trivial-dtor? c))) (:size d))))
                       :ty abi/void :cat :pr})
    "ExprWithCleanups" (analyze ctx (first (kids n)))
    "LambdaExpr" (lambda-expr ctx n)
    "CXXTypeidExpr"
    (let [ti (let [es (lookup-qualified *root* ["std" "type_info"] true)] (:ty (type-entity es)))
          _ (when-not ti (fail :rtti "typeid without std::type_info"))
          ti (assoc ti :c true)]
      (if-let [ta (get-in n [:typeArg :qualType])]
        (let [t (binding [*cx-vla* (when (checking?) (:scope ctx))] (resolve-type (:scope ctx) ta))]
          ;; (queue 570, the checker: typeid of a variably modified type, [expr.typeid]/4-5 (its std::type_info fixed at
          ;; translation): GCC's "cannot create type information for type 'int (*)[i]' because it involves types of
          ;; variable size", ext/vla4.C)
          (when (and (checking?) (cx-vm? t)) (cx-vm-typeid! n))
          {:op :typeid :t (abi/unq (abi/non-ref t)) :ty ti :cat :lv})
        (let [e (analyze ctx (first (kids n)))
              _ (when (and (checking?) (cx-vm? (:ty e))) (cx-vm-typeid! n))
              cid (class-id (:ty e))]
          (if (and cid (lv? e) (abi/dynamic? cid))
            {:op :typeid :e e :ty ti :cat :lv}
            {:op :comma :l (if (and cid (= :pr (:cat e))) {:op :cast :ck :void :e e :ty abi/void :cat :pr} {:op :cast :ck :void :e e :ty abi/void :cat :pr})
             :r {:op :typeid :t (abi/unq (:ty e)) :ty ti :cat :lv} :ty ti :cat :lv}))))
    "CXXDynamicCastExpr"
    (let [t (resolve-type (:scope ctx) (get-in n [:type :qualType]))
          ;; (a cast to a reference: the tree's type is the referred type, its value category the reference's, as clang's
          ;; dump writes it and the other casts read it)
          t (cond (abi/ref? t) t
                  (#{:xvalue "xvalue"} (:valueCategory n)) (abi/rref t)
                  (= "lvalue" (:valueCategory n)) (abi/lref t)
                  :else t)
          e (analyze ctx (first (kids n)))
          ref (abi/ref? t)
          src (if ref e (rv e))
          sc (if ref (class-id (:ty src)) (class-id (:to (abi/unq (:ty src)))))
          dt (if ref (abi/unq (:to t)) (:to (abi/unq t)))
          dc (class-id dt)]
      (cond
        (and dc sc (or (= dc sc) (abi/derived-from? sc dc))) (cast-expr ctx t e false)
        (and (not ref) (abi/void? dt)) {:op :dyncast :e src :void true :ty t :cat :pr}
        :else {:op :dyncast :e src :ref ref :from sc :to dc :ty (if ref dt t) :cat (if ref (if (= :rref (:k t)) :xv :lv) :pr)
               :hint (if-let [[_ off vb] (abi/base-path dc sc)] (if vb -1 off) -2)}))
    "CXXThrowExpr" (if-let [k (first (kids n))]
                     (let [e (analyze ctx k)
                           r (if (abi/class? (abi/unq (:ty e))) e (rv e))
                           t (abi/unq (:ty r))]
                       ;; (queue 570, the checker: an exception object of a variably modified type, [except.throw]/3: GCC's
                       ;; "cannot throw expression of type 'int (*)[i]'", at the operand, the analysis going on; ext/vla4.C)
                       (when (and (checking?) *on-refusal* (cx-vm? t))
                         (*on-refusal* (ex-info "codegen: cannot throw expression of a variably modified type" {:codegen/refused :vla-type :cx/node k}) k))
                       ;; (queue 463, the checker: the exception object's destructor potentially invoked, [except.throw]/5)
                       ;; (queue 509, the checker: an implicitly movable entity's implicit move, [class.copy.elision]/3)
                       (let [i (if (and (checking?) (abi/class? (abi/unq (:ty e))) (cx-movable-var ctx e))
                                 (cx-implicit-move-init t e ctx)
                                 (init-for t e ctx :copy))]
                         (cx-dtor-access! ctx t)
                         ;; (cpp-1123: an exception object of an abstract class type, [class.abstract]/3)
                         (cx-abstract! t n "the exception object")
                         {:op :throw :ety t :init i :ty abi/void :cat :pr}))
                     {:op :throw :ty abi/void :cat :pr})
    (fail :expr "expression " (:kind n) (when (System/getenv "CPP_HDR_TRACE") (str " at " (pr-str (loc-of (get-in n [:range :begin]))))))))

;; ---------------------------------------------------------------------------------------------
;; Statements

(defn- p2266-xvalue
  "C++23's P2266 ([expr.prim.id.unqual]/3 with [basic.lval]/4): in a return statement an id-expression naming an implicitly
  movable entity -- an automatic variable or parameter of object type, or of rvalue reference type to an object type, not
  volatile -- is an xvalue, whatever the return type (found with CP305's explicit instantiations, cpp23/elision7); the typed
  expression `a` as one, or as it was."
  [a]
  (if (and (>= (long *cxx-year*) 23) (not= :xv (:cat a)))
    (let [vid (case (:op a)
                :var (:id a)
                :deref (when (and (= :load (get-in a [:e :op])) (= :var (get-in a [:e :e :op])) (get-in a [:e :e :raw]))
                         (get-in a [:e :e :id]))
                nil)
          v (when vid (var* vid))
          vt (:ty v)]
      (if (and v (#{:local :param} (:storage v)) (not (:static v)) (not (:v (abi/unq (abi/non-ref vt))))
               (or (and (= :var (:op a)) (not (abi/ref? vt)))
                   (and (= :deref (:op a)) (= :rref (:k vt)) (not (abi/fn? (:to vt))))))
        (assoc a :cat :xv)
        a))
    a))

;; (queue 509, the checker: implicit move, [class.copy.elision]/3. An implicitly movable entity -- before C++20 an automatic
;; local object (no parameter in a throw, no handler's parameter), from C++20 (P1825) also a parameter, a handler's
;; parameter and an rvalue reference to an object; not volatile, not static -- named alone by a return statement or by a
;; throw-expression's operand (a throw's only when its scope does not extend beyond the innermost enclosing try-block or
;; function-try-block: the entity declared within the same try-block's compound statement, or outside every try-block of
;; its function when the throw is in none) is first an rvalue. Until C++23 the initialization is done again with it as an
;; lvalue when the first overload resolution fails, or when the constructor it chooses does not take an rvalue reference
;; (before C++20: to the entity's own class; GCC's LOOKUP_PREFER_RVALUE keeps that from C++20 too for a first parameter
;; that is not an rvalue reference at all, cpp23/elision2.C's twelve); from C++23 (P2266) it is an xvalue alone.)

(defn- cx-movable-var
  "Queue 509 (the checker): the id of the implicitly movable entity the typed operand `a` of a throw-expression names (the
  expression context `ctx`), or nil."
  [ctx a]
  (let [y (long *cxx-year*)
        vid (case (:op a)
              :var (:id a)
              :deref (when (and (>= y 20) (= :load (get-in a [:e :op])) (= :var (get-in a [:e :e :op])) (get-in a [:e :e :raw]))
                       (get-in a [:e :e :id]))
              nil)
        v (when vid (var* vid))
        vt (:ty v)]
    (when (and v (>= y 11) (some? (:fn-id ctx)) (= (:fn v) (:fn-id ctx)) (not (:static v)) (not (:v (abi/unq (abi/non-ref vt))))
               (or (and (= :var (:op a)) (not (abi/ref? vt)))
                   (and (= :deref (:op a)) (= :rref (:k vt)) (not (abi/fn? (:to vt)))))
               (if (>= y 20)
                 (#{:local :param} (:storage v))
                 (and (= :local (:storage v)) (not (:cx-handler v))))
               (= (:cx-try v) (:cx-try ctx)))
      vid)))

(defn- cx-implicit-move-init
  "Queue 509 (the checker): the copy-initialization of an object of type `t` from the typed operand `a` naming an
  implicitly movable entity (see above), as [class.copy.elision]/3 makes it by the standard's year."
  [t a ctx]
  (let [y (long *cxx-year*)
        axv (assoc a :cat :xv)
        alv (assoc a :cat :lv)]
    (if (>= y 23)
      (init-for t axv ctx :copy)
      (let [id (class-id (abi/unq t))
            sid (class-id (:ty a))
            cands (when id (remove #(:explicit (fnd %)) (ctor-candidates id)))
            rref? (fn [fid] (let [p (first (:ps (:ty (fnd fid))))]
                              (boolean (and p (= :rref (:k p)) (or (>= y 20) (and sid (= sid (class-id (:to p)))))))))
            ;; (the first overload resolution's choice among the constructors: :lv when it chose one that takes no rvalue
            ;; reference, :rv when it did, or a deleted one that does is chosen, nil when it failed or was not done)
            pre (when (seq cands)
                  (try (if (rref? (resolve-overload cands [axv] nil)) :rv :lv)
                       (catch arbace.lang.ExceptionInfo x
                         (when (re-find #"call to a deleted function" (str (.getMessage x)))
                           (if (some #(and (:deleted (fnd %)) (rref? %)) cands) :rv :lv)))))]
        (if (= :lv pre)
          (init-for t alv ctx :copy)
          (try (init-for t axv ctx :copy)
               (catch arbace.lang.ExceptionInfo x
                 (if (and (= :overload (:codegen/refused (ex-data x)))
                          (re-find #"ambiguous|no viable" (str (.getMessage x))))
                   (init-for t alv ctx :copy)
                   (throw x)))))))))

(declare stmt)

(declare analyze-args)

(defn- ctad-init
  "CP311 (a): a variable's initializer analyzed for class template argument deduction, [kind init]: kind :direct,
  :copy, :list-direct or :list-copy ([dcl.init.general]/15-16, [dcl.init.list]/1), init the arguments' vector, the
  expression or the init-list."
  [ctx n]
  (let [init (init-kid n)]
    (case (when init (:init n))
      ;; (no initializer: deduced as from an empty parenthesized list, default-initialized)
      nil [:direct []]
      "call" [:direct (if (= "ParenListExpr" (:kind init)) (analyze-args ctx (kids init)) [(analyze ctx init)])]
      "list" [:list-direct (analyze ctx init)]
      (let [a (analyze ctx init)] [(if (= :init-list (:op a)) :list-copy :copy) a]))))

(defn- ctad-var
  "CP311 (a): {:ty :ctad-init} for a variable declared with the placeholder `ct` ([tid #{cv}]) for a deduced class type
  ([dcl.type.class.deduct]/1): the type the :ctad hook deduces from the analyzed initializer (kept for the variable's
  initialization, analyzed once), else -- the slice not sure, or for the code generator also a program it finds
  ill-formed -- the parser's own deduction when it made one (`qt` spelled with the arguments, the tree's type)."
  [ctx n ct qt]
  (let [[kind a] (ctad-init ctx n)
        r (try {:ty ((:ctad @hooks) ctx (first ct) kind a)} (catch arbace.lang.ExceptionInfo e {:err e}))
        fallback (fn [] (cond
                          (and (:_ctad n) (not= qt (:_ctad n))) (try (resolve-type (:scope ctx) qt) (catch arbace.lang.ExceptionInfo _ nil))
                          ;; (no initializer: the template's default arguments alone, T<>, as the checker tried before)
                          (and (nil? (init-kid n)) (checking?) (re-matches #"[A-Za-z_]\w*" (str qt)))
                          (try (resolve-type (:scope ctx) (str qt "<>")) (catch arbace.lang.ExceptionInfo _ nil))))]
    (cond
      (:ty r) {:ty (cond-> (:ty r) ((second ct) 'const) (assoc :c true) ((second ct) 'volatile) (assoc :v true)) :ctad-init a}
      ;; (the checker: the program's error, raised where the variable is initialized, the variable declared with a
      ;; dependent placeholder type so that its uses report nothing more, as clang marks the declaration invalid)
      (and (checking?) (= :ctad (:codegen/refused (ex-data (:err r)))))
      {:ty {:k :dep :name "<deduction failed>"} :ctad-error (ex-info (.getMessage ^Throwable (:err r)) (assoc (ex-data (:err r)) :cx/node n))}
      :else (if-let [t (fallback)] {:ty t :ctad-init a} (throw (:err r))))))

(defn- vla-local
  "cpp-rt-own4 (DECISION cpp-rt-own3-1 (a)), the code generator's: GNU's variable-length array, a block-scope array whose
  outermost bound is no constant (floating_to_chars.cc's `char buffer[output_length_upper_bound + 1];`): [type bound], the
  type {:k :arr :n nil :vla true :of T} and the bound the parser kept (the VarDecl's :_vla, outermost first) analyzed here
  as an integer prvalue, clang's VariableArrayType's size expression, evaluated where the declaration is (codegen's
  local-decl!: llvm.stacksave, a dynamic alloca, llvm.stackrestore at the scope's exits). Nil when the declaration is no
  such array (the element type must resolve: an inner bound no constant stays the refusal).
  queue 569 (the checker's, `list?`): also one initialized by a braced list, the GCC manual's \"Variable Length\" (GNU C++
  takes an initializer for a VLA), its elements evaluated by the constant evaluator against the bound evaluated at the
  declaration (ce-exec's :decl)."
  ([ctx n qt] (vla-local ctx n qt false))
  ([ctx n qt list?]
  (let [b (first (:_vla n))
        f (try (ct/parse-type (strip-type-attrs qt)) (catch Exception _ nil))
        ik (init-kid n)]
    (when (and (map? b) (seq? f) (= 'array (first f)) (= 3 (count f)) (not (number? (second f)))
               (not= "static" (:storageClass n)) (not (:tls n))
               (or (nil? ik) (and list? (= "InitListExpr" (:kind ik)))))
      (let [et (resolve-type-form (:scope ctx) (nth f 2))
            e (rv (analyze ctx b))]
        ;; (queue 570, the checker: a bound of floating-point or pointer type, which no conversion makes an integer's
        ;; ([dcl.array]/1: a converted constant expression of type std::size_t; GNU's VLA takes an integer bound): GCC's "size
        ;; of array 'a' has non-integral type 'double'")
        (when (and (checking?) (let [u (abi/unq (abi/underlying (abi/unq (:ty e))))] (or (abi/floating? u) (abi/ptr? u))))
          (throw (ex-info (str "codegen: size of array '" (:name n) "' has non-integral type") {:codegen/refused :vla-type :cx/node n})))
        (when (and (abi/integral? (abi/unq (abi/underlying (abi/unq (:ty e))))) (not (abi/class? (abi/unq et))))
          [(assoc (abi/arr nil et) :vla true) e]))))))

(defn- cx-vm-local-type
  "queue 570-2 (a), the checker: a block-scope variable's written type `qt` built from a VLA but no VLA itself (a pointer or
  reference to one; *cx-vla* its scope), else the refusal `x` as before (a VLA vla-local does not take stays refused)."
  [ctx qt x]
  (let [t (try (binding [*cx-vla* (:scope ctx)] (resolve-type (:scope ctx) qt)) (catch arbace.lang.ExceptionInfo _ nil))]
    (if (and t (cx-vm? t) (not (:vla (abi/unq t)))) t (throw x))))

(defn- local-var! [ctx n storage]
  (let [qt (get-in n [:type :qualType])
        ct (ctad-template (:scope ctx) (or (:_ctad n) qt))
        cv (if ct (ctad-var ctx n ct qt) (ctad-compound-var (:scope ctx) n qt))
        vla (atom nil)
        ty (if cv (:ty cv) (try (resolve-type (:scope ctx) qt)
                (catch arbace.lang.ExceptionInfo x
                  (cond
                    ;; (cpp-rt-own4, the code generator: a VLA, vla-local)
                    (and (not (checking?)) (= :local storage) (:_vla n) (boolean (re-find #"not a constant" (str (.getMessage x)))))
                    (if-let [[t e] (vla-local ctx n qt)] (do (reset! vla e) t) (throw x))
                    ;; (queue 570, the checker: a bound that reads no variable yet holds an address, cx-address-bound?: GCC's
                    ;; "size of array 'tbl' is not an integral constant-expression"; ext/vla22.C, parse/array-size2.C)
                    ;; (reported, the analysis going on, the variable declared as an array of no known bound: its uses report
                    ;; nothing more)
                    (and (checking?) *on-refusal* (= :local storage) (:_vla n)
                         (let [f (try (ct/parse-type (strip-type-attrs qt)) (catch Exception _ nil))]
                           (and (seq? f) (= 'array (first f)) (= 3 (count f)) (cx-address-bound? (:scope ctx) (second f)))))
                    (let [et (resolve-type-form (:scope ctx) (nth (ct/parse-type (strip-type-attrs qt)) 2))]
                      (*on-refusal* (ex-info (str "codegen: size of array '" (:name n) "' is not an integral constant-expression") {:codegen/refused :vla-type :cx/node n}) n)
                      (assoc (abi/arr nil et) :vla true))
                    ;; (cpp-singles, the checker: a VLA's bound analyzed, so that its immediate invocations are evaluated,
                    ;; [expr.const]/16 -- GCC's "call to consteval function 'bar(3)' is not a constant expression" at the call,
                    ;; cpp2a/consteval34.C's `int a1[bar(3)];` --, the refusal then as before)
                    ;; (queue 569, the checker: GNU's VLA, its bound evaluated where it is declared by the constant evaluator,
                    ;; vla-local's with a braced list too; else the refusal as before)
                    (and (checking?) (= :local storage) (map? (first (:_vla n))) (boolean (re-find #"not a constant" (str (.getMessage x)))))
                    (if-let [[t e] (vla-local ctx n qt true)] (do (reset! vla e) t) (do (analyze ctx (first (:_vla n))) (cx-vm-local-type ctx qt x)))
                    ;; (queue 570-2 (a), the checker: a local pointer or reference to a VLA, `int (*p)[n] = &a;`, declared with its
                    ;; variably modified type)
                    (and (checking?) (= :local storage) (boolean (re-find #"not a constant" (str (.getMessage x)))))
                    (cx-vm-local-type ctx qt x)
                  ;; (CX12, the checker: a class template's name as the type of a variable with no initializer,
                  ;; [dcl.type.class.deduct]: class template argument deduction from no argument, [over.match.class.deduct],
                  ;; succeeds with the template's default arguments alone -- the slice tries T<>, every parameter defaulted)
                    (and (checking?) (nil? (init-kid n)) (re-matches #"[A-Za-z_]\w*" (str qt)))
                    (try (resolve-type (:scope ctx) (str qt "<>")) (catch arbace.lang.ExceptionInfo _ (throw x)))
                    ;; (queue 500: a specialization surely without a definition, the variable's refusal)
                    :else (throw (or (cx-sure-incomplete-refusal n nil x) x))))))
        _ (incomplete-var! n ty)
        ;; (queue 570, the checker: a constexpr variable of a variably modified type, [dcl.constexpr]/6 with [expr.const]: its
        ;; object's size is a run-time value, GCC's "'constexpr' variable 'x' has variably-modified type 'const int [i]'";
        ;; gomp/pr85134.C)
        _ (when (and (checking?) *on-refusal* (:constexpr n) (or @vla (cx-vm? ty)))
            (*on-refusal* (ex-info (str "codegen: 'constexpr' variable '" (:name n) "' has variably-modified type") {:codegen/refused :vla-type :cx/node n}) n))
        _ (cx-void-var! n ty)
        _ (when-let [r (cx-sure-incomplete-refusal n ty nil)] (*on-refusal* r n))
        ;; (cpp-sweep, the checker: [dcl.constexpr]/3.4 of C++14-C++20 (P2242R3 dropped it in C++23), no definition of a variable
        ;; of non-literal type in a constexpr function's body: GCC's error "variable 'v' of non-literal type 'T' in 'constexpr'
        ;; function only available with '-std=c++23'" at it (g++ 15.2 by hand, C++14 and C++20); a template's specialization,
        ;; a closure's member and a header's not judged: cpp2a/constexpr-dtor3.C's t4)
        _ (when-let [f (and (checking?) *on-refusal* (<= 14 (long *cxx-year*) 20) (= :local storage) (:fn-id ctx) (not (:lambda ctx))
                            (not (header-node? n)) (not= "static" (:storageClass n)) (not (:tls n)) (not (:constexpr n)) (not (abi/ref? ty))
                            (let [f (fnd (:fn-id ctx))]
                              (when (and (:constexpr f) (not (:tinst f)) (not (:implicit f)) (:node f) (not (header-node? (:node f)))
                                         (or (nil? (:cls f)) (cx-plain-class? (:cls f))) (or (nil? (:friend-cls f)) (cx-plain-class? (:friend-cls f))))
                                f)))]
            (when-let [why (cx-non-literal ty)]
              (*on-refusal* (ex-info (str "codegen: variable '" (:name n) "' of non-literal type in '" (if (:consteval f) "consteval" "constexpr")
                                          "' function only available with '-std=c++23' (" why ")")
                                     {:codegen/refused :constexpr :cx/node n})
                            n)))
        id (next-id)
        ;; (thread_local at block scope implies static, [dcl.stc]/4)
        st (if (or (= "static" (:storageClass n)) (:tls n)) :static-local storage)
        v (cond-> {:id id :name (:name n) :ty ty :storage st :fn (:fn-id ctx) :init-node (init-kid n) :constexpr (boolean (:constexpr n)) :tls (boolean (:tls n))}
            cv (assoc :ctad-init (:ctad-init cv) :ctad-error (:ctad-error cv))
            @vla (assoc :vla-n @vla)
            (and (checking?) (unavailable-node? n)) (assoc :unavailable true)
            ;; (queue 509: the innermost try-block it is declared in, for cx-movable-var)
            (and (checking?) (:cx-try ctx)) (assoc :cx-try (:cx-try ctx))
            (and (checking?) (:constexpr n)) (assoc :cx-constexpr true :cx-range (:range n))
            (and (checking?) (not (:constexpr n)) (or (:_constinit n) (some #(= "ConstInitAttr" (:kind %)) (:inner n)))) (assoc :cx-constinit true :cx-range (:range n)))
        ;; a constant local's initializer, for constant expressions (an array bound, a template argument)
        v (if (and (:c ty) (abi/integral? (abi/unq ty)) (init-kid n)) (assoc v :init (init-kid n) :def-scope (:scope ctx)) v)]
    (swap! *vars* assoc id v)
    id))

(defn- has-auto? [t] (cond (= :auto (:k t)) true (#{:ref :rref :ptr} (:k t)) (has-auto? (:to t)) :else false))

(declare deduce-auto)

(defn- placeholder-check!
  "n-cpp-concepts (the checker), [dcl.type.auto.deduct]/2: a constrained placeholder's type `t` (an auto with :tc, under
  references or a pointer) deduced as `d`: the type T deduced for its auto satisfies the immediately-declared constraint
  C<T, A...> of its type-constraint, looked up in `scope` (template.ae's :type-constraint hook); a false met with no doubt is
  the program's error, GCC's \"placeholder constraints not satisfied\" (\"deduced initializer does not satisfy\", \"deduced
  return type does not satisfy\")."
  [scope t d what node]
  (when (and (checking?) scope)
    (when-let [[a T] (loop [t t d d]
                       (cond (= :auto (:k t)) [t d]
                             ;; (a forwarding reference given an lvalue: T is the lvalue reference, [temp.deduct.call]/3)
                             (and (= :rref (:k t)) (= :auto (:k (:to t))) (= :ref (:k d))) [(:to t) d]
                             (and (#{:ref :rref :ptr} (:k t)) (map? d) (:to d)) (recur (:to t) (:to d))
                             :else nil))]
      (when-let [tc (:tc a)]
        (when-let [h (:type-constraint @hooks)]
          (let [dd (atom false)
                T (if (abi/ref? T) T (abi/unq T))
                ok (when-not (dt-dependent? T) (binding [*constraint-doubt* dd] (h scope tc T)))]
            (when (and (false? ok) (not @dd))
              (throw (ex-info (str "codegen: placeholder constraints not satisfied: the deduced " what " does not satisfy " tc)
                              ;; (at the declaration, else its initializer: a namespace-scope variable's node made of
                              ;; its initializer alone, global-init's)
                              (let [at (if (:range node) node (first (filter :range (:inner node))))]
                                (cond-> {:codegen/refused :placeholder} at (assoc :cx/node at))))))))))))

(defn deduce-auto
  "The type `t` with its auto deduced from the initializer `e` ([dcl.type.auto.deduct]: a plain auto drops references,
  top-level cv-qualifiers and decays; auto& keeps the initializer's cv; auto&& is a forwarding reference); with `scope`
  (the checker) a constrained placeholder's constraint checked too (placeholder-check!)."
  ([t e scope what node] (let [d (deduce-auto t e)] (placeholder-check! scope t d what node) d))
  ([t e]
  (case (:k t)
    :auto (let [;; (cpp-tzdb: a template-id naming a function template's one specialization, its arguments written and
                ;; defaulted, is an lvalue of that function, [temp.arg.explicit]/4 with [over.over]: <format>'s
                ;; basic_format_arg::handle, `auto __func = _S_format<__maybe_const_t<_Tp>>;`, deduced a pointer to it
                ;; (an overload set's type before))
                e (if-let [f (when (and (= :fnset (:op e)) (nil? (fn-matching e nil)) (empty? (:fns e)))
                               (when-let [h (:single-spec @hooks)] (h e)))]
                    (if (and (:cls (fnd f)) (not (:static (fnd f)))) e {:op :fnaddr :fn f :ty (abi/ptr (:ty (fnd f))) :cat :pr})
                    e)
                et (if (abi/class? (abi/unq (:ty e))) (abi/unq (:ty e)) (abi/unq (:ty (rv e))))] (cond-> et (:c t) (assoc :c true) (:v t) (assoc :v true)))
    :ref (assoc t :to (if (= :auto (:k (:to t))) (cond-> (:ty e) (:c (:to t)) (assoc :c true)) (deduce-auto (:to t) e)))
    :rref (if (and (= :auto (:k (:to t))) (= :lv (:cat e))) (abi/lref (:ty e)) (assoc t :to (if (= :auto (:k (:to t))) (:ty e) (deduce-auto (:to t) e))))
    :ptr (assoc t :to (let [pt (:to (abi/unq (:ty (rv e))))] (if (= :auto (:k (:to t))) (cond-> pt (:c (:to t)) (assoc :c true)) (deduce-auto (:to t) {:op :deref :ty pt :cat :lv}))))
    t)))

(defn- cx-array-paren!
  "cpp-rind (the checker): [dcl.init.general]/16.5, an array is initialized by a braced list or a string literal: a written
  parenthesized initializer of one array expression (`s(a)` in a mem-initializer, `string x[1](a);`) is GCC's \"array must be
  initialized with a brace-enclosed initializer\" (init/array62.C); an implicit copy's member arrays not judged here."
  [t args]
  (when (and (checking?) (abi/arr? (abi/unq t)) (= 1 (count args)) (map? (first args)) (not= :str (:op (first args)))
             (abi/arr? (abi/unq (abi/non-ref (or (:ty (first args)) {})))))
    (fail :array-init "array must be initialized with a brace-enclosed initializer")))

(defn- decl-init
  "A local declaration's initializer from its node (`:init` c, call or list)."
  [ctx id n]
  ;; (CP311 (a): a deduction that failed, the program's error, the local variable declared all the same)
  (when-let [e (:ctad-error (var* id))]
    (when (#{:local :static-local} (:storage (var* id))) (enter! (:scope ctx) (or (:name n) "") {:e :var :id id}))
    (throw e))
  (let [t (:ty (var* id))
        init (init-kid n)
        t (if (and (abi/arr? t) (nil? (:n t)) init)
            (let [a (analyze ctx init)]
              (cond (= :init-list (:op a)) (if (and (= 1 (count (:items a))) (= :str (:op (first (:items a))))) (assoc t :n (inc (count (str-units (first (:items a)))))) (assoc t :n (count (:items a))))
                    (= :str (:op a)) (assoc t :n (inc (count (str-units a))))
                    :else t))
            t)
        pre (cond (and init (has-auto? t) (not (#{"call" "list"} (:init n)))) (analyze ctx init)
                  ;; (cpp-rind, the checker: [dcl.type.auto.deduct]/4 since N3922, `auto x{e}` deduced from its one element e, and
                  ;; `auto x(e)` from e: the initializer's type, its constant evaluation judged; cpp0x/constexpr-95307.C)
                  (and (checking?) init (has-auto? t) (= "list" (:init n)) (= "InitListExpr" (:kind init)) (= 1 (count (kids init)))
                       (not (#{"InitListExpr" "DesignatedInitExpr" "PackExpansionExpr"} (:kind (first (kids init))))))
                  (analyze ctx (first (kids init)))
                  :else nil)
        ;; (cpp-rind, the checker: [dcl.type.auto.deduct]/4, `auto x = {a, b};` deduces std::initializer_list<E>, E the elements'
        ;; one type, as a braced range-for range does; it had deduced the first element's type and refused the list as "excess
        ;; elements in scalar initializer", a false error: asan/pr117845.C; elements of different types or no <initializer_list>
        ;; left to the deduction below, the refusal over auto unreported as before)
        il (when (and (checking?) pre (= :init-list (:op pre)) (= :auto (:k t)) (seq (:items pre)))
             (let [ts (distinct (map #(abi/unq (:ty (rv %))) (:items pre)))
                   te (first (filter #(= :tmpl (:e %)) (lookup-qualified *root* ["std" "initializer_list"] true)))]
               (when (and (= 1 (count ts)) te (not (abi/class? (first ts))) (not= :init-list (:k (first ts))))
                 (cond-> ((:instantiate-class @hooks) (:id te) [(first ts)]) (:c t) (assoc :c true) (:v t) (assoc :v true)))))
        t (cond il il pre (deduce-auto t pre (:scope ctx) "initializer" n) :else t)
        _ (upd-var! id assoc :ty t)
        ;; (CP311 (a): the initializer a deduced class type was deduced from, analyzed once)
        ci (:ctad-init (var* id))]
    (when (and ci *at* (:range (init-kid n))) (reset! *at* (init-kid n)))
    (cond
      ci (case (:init n)
           "call" (init-for t ci ctx :direct)
           "list" (init-for t ci ctx :list)
           (init-for t ci ctx (if (= :init-list (:op ci)) :list :copy)))
      pre (init-for t pre ctx (if (= :init-list (:op pre)) :list :copy))
      (nil? init) (init-for t nil ctx :default)
      ;; (cpp-rind, the checker: [dcl.init.general]/16.9 (C++23 /16.9), a scalar or a reference to one direct-initialized by a
      ;; parenthesized braced-init-list, `int a({0});`: the braced list no expression a scalar converts from, GCC's "cannot convert
      ;; '<brace-enclosed initializer list>' to 'int'"; cpp0x/initlist56.C)
      (and (checking?) (= "call" (:init n)) (abi/scalar? (abi/unq (abi/non-ref t)))
           (let [as (if (= "ParenListExpr" (:kind init)) (kids init) [init])] (and (= 1 (count as)) (= "InitListExpr" (:kind (first as))))))
      (fail :conversion "cannot convert '<brace-enclosed initializer list>' implicitly to a scalar in a parenthesized initializer")
      (and (checking?) (= "call" (:init n)) (abi/arr? (abi/unq t)) (not= "ParenListExpr" (:kind init)) (not= "CXXConstructExpr" (:kind init))
           (let [a (analyze ctx init)] (cx-array-paren! t [a]) false))
      nil
      (= "call" (:init n)) (init-for t (cond (= "ParenListExpr" (:kind init)) (analyze-args ctx (kids init))
                                             ;; (cpp-s11: `U u({3, 4});`, the native parser's CXXConstructExpr of the
                                             ;; declaration's own type, untyped, around its arguments: they are the
                                             ;; initializer's; it had crashed in resolve-type)
                                             (and (= "CXXConstructExpr" (:kind init)) (nil? (get-in init [:type :qualType])))
                                             (analyze-args ctx (kids init))
                                             :else [(analyze ctx init)]) ctx :direct)
      (= "list" (:init n)) (init-for t (analyze ctx init) ctx :list)
      ;; (queue 492, the checker: `T t = {...};`, a copy-list-initialization, cx-explicit-list!)
      :else (let [a (analyze ctx init)] (binding [*cx-copy-list* (and (checking?) (= :init-list (:op a)) (or (when (:range init) init) true))]
                                          (init-for t a ctx (if (= :init-list (:op a)) :list :copy)))))))


(defn- decomposition!
  "A structured binding declaration ([dcl.struct.bind]): the DecompositionDecl `d`, its initializer the typed `src`
  (a range-for's *__begin) or its own. The unnamed variable e of the declared (auto) type, deduced from the
  initializer (an array's copy element by element when the declaration has no ref-qualifier, /1); then its bindings:
  of an array e's elements (/2); of a tuple-like type (std::tuple_size<E>::value a constant, /4) variables of type
  Ti& or Ti&& (as the initializer is an lvalue) initialized by get<i>(e) (argument-dependent lookup; e an lvalue when
  its type is an lvalue reference, else an xvalue; a member get<i>() when E has a member template get), Ti the call's
  result type; else of e's non-static data members in declaration order, all of one class (/5). The bindings of /2
  and /5 are names of e's subobjects (no variable: clang's BindingDecl's holding expression), entered as :binding.
  The statements: e's declaration and the tuple-like bindings' variables'."
  [ctx d src]
  (let [bs (filter #(= "BindingDecl" (:kind %)) (kids d))
        d0 (assoc d :inner (vec (remove #(= "BindingDecl" (:kind %)) (kids d))))
        _ (when (or (= "static" (:storageClass d)) (:tls d)) (fail :decl "a static or thread-local structured binding"))
        eid (local-var! ctx d0 :local)
        t (:ty (var* eid))
        initn (init-kid d0)
        pre (or src (when initn
                      (let [a (if (= "ParenListExpr" (:kind initn)) (let [as (analyze-args ctx (kids initn))] (if (= 1 (count as)) (first as) (fail :decl "a structured binding from several values"))) (analyze ctx initn))]
                        (if (and (= :init-list (:op a)) (= 1 (count (:items a)))) (first (:items a)) a)))
                (fail :decl "a structured binding without an initializer"))
        pu (abi/unq (:ty pre))
        ;; ([dcl.struct.bind]/1: E an array of unknown bound is an incomplete type, clang's err_decomp_decl... incomplete;
        ;; cpp26/decomp11.C, a crash before CP331 (a) modelled the declaration in the checker)
        _ (when (and (abi/arr? pu) (nil? (:n pu)))
            (throw (ex-info "codegen: cannot decompose an array of unknown bound: its type is incomplete"
                            {:codegen/refused :decomp :cx/node d})))
        [t init] (if (and (= :auto (:k t)) (abi/arr? pu))
                   (let [at (cond-> pu (:c t) (assoc :c true) (:v t) (assoc :v true))
                         ;; (n-cpp-concepts: a constrained placeholder's T, the array type, [dcl.type.auto.deduct]/2)
                         _ (placeholder-check! (:scope ctx) t pu "initializer" d)
                         el (:of pu) pt (abi/ptr el)]
                     [at {:i :list :n (:n pu)
                          :items (vec (for [i (range (:n pu))]
                                        (init-for (:of at) {:op :deref :e {:op :ptradd :o "+" :p (rv pre) :n {:op :int :v i :ty abi/long* :cat :pr} :ty pt :cat :pr} :ty el :cat :lv} ctx :copy)))}])
                   (let [t (deduce-auto t pre (:scope ctx) "initializer" d)] [t (init-for t pre ctx :copy)]))
        _ (upd-var! eid assoc :ty t)
        hn (str "__binding" eid)
        _ (enter! (:scope ctx) hn {:e :var :id eid})
        ref {:kind "DeclRefExpr" :referencedDecl {:name hn}}
        ecv (abi/non-ref t)
        E (abi/unq ecv)
        n (count bs)
        bind! (fn [b x] (enter! (:scope ctx) (:name b) {:e :binding :expr x :fn (:fn-id ctx)}))
        tuple-n (when (abi/class? E)
                  (let [tn (str "__bindingE" eid)]
                    (enter! (:scope ctx) tn {:e :type :ty ecv})
                    (try (const-int (:scope ctx) {:kind "DeclRefExpr" :_wn true :qualifier ["std" (str "tuple_size<" tn ">")] :referencedDecl {:name "value"}})
                         (catch arbace.lang.ExceptionInfo _ nil))))
        more (cond
               (abi/arr? E)
               (do (when-not (= n (:n E)) (fail :decl "a structured binding of " n " names for " (:n E) " elements"))
                   (doseq [[i b] (map-indexed vector bs)]
                     (bind! b (analyze ctx {:kind "ArraySubscriptExpr" :inner [ref {:kind "IntegerLiteral" :value (str i) :type {:qualType "unsigned long"}}]})))
                   [])
               tuple-n
               (do (when-not (= n tuple-n) (fail :decl "a structured binding of " n " names for a tuple-like size " tuple-n))
                   (let [member? (some (fn [[_ e]] (= :tmpl (:e e))) (class-lookup (:id E) "get"))
                         ev (let [x (var-node eid)] (if (= :ref (:k t)) x (assoc x :cat :xv)))]
                     (vec (for [[i b] (map-indexed vector bs)]
                            (let [;; (cpp-def, the checker: [dcl.struct.bind]/4, the i-th variable a reference to Ti,
                                  ;; std::tuple_element<i, E>::type: a void Ti, no reference to it, is GCC's
                                  ;; "'std::tuple_element<0, A>::type' is 'void'"; cpp1z/decomp55.C)
                                  _ (when (checking?)
                                      (let [ti (try (resolve-type (:scope ctx) (str "std::tuple_element<" i ", __bindingE" eid ">::type"))
                                                    (catch arbace.lang.ExceptionInfo _ nil))]
                                        (when (and (map? ti) (= abi/void (abi/unq ti)))
                                          (throw (ex-info (str "codegen: cannot decompose: 'std::tuple_element<" i ", " (or (:name (abi/cls (:id E))) "E") ">::type' is 'void'")
                                                          {:codegen/refused :decomp :cx/node d})))))
                                  r (if member?
                                      (analyze ctx {:kind "CallExpr" :inner [{:kind "MemberExpr" :name "get" :isArrow false :_wn true :explicitTemplateArgs [(str i)] :inner [ref]}]})
                                      (analyze-call ctx (analyze ctx {:kind "DeclRefExpr" :referencedDecl {:name "get"} :_wn true :explicitTemplateArgs [(str i)]}) [ev]))
                                  bt (if (= :lv (:cat r)) (abi/lref (abi/non-ref (:ty r))) (abi/rref (abi/unq (abi/non-ref (:ty r)))))
                                  bid (next-id)]
                              (swap! *vars* assoc bid {:id bid :name (:name b) :ty bt :storage :local :fn (:fn-id ctx)})
                              (enter! (:scope ctx) (:name b) {:e :var :id bid})
                              {:s :decl :var bid :init (init-for bt r ctx :copy)})))))
               (abi/class? E)
               (let [cid (loop [c (:id E)]
                           (let [own (remove #(and (:bits %) (nil? (:name %))) (:fields (abi/cls c)))
                                 bs* (filter #(seq (remove (fn [f] (and (:bits f) (nil? (:name f)))) (:fields (abi/cls (:cls %))))) (:bases (abi/cls c)))]
                             (cond (seq own) c (= 1 (count bs*)) (recur (:cls (first bs*))) :else c)))
                     fs (remove #(and (:bits %) (nil? (:name %))) (:fields (abi/cls cid)))]
                 (when-not (= n (count fs)) (fail :decl "a structured binding of " n " names for " (count fs) " members"))
                 (when (some #(or (:anon %) (nil? (:name %))) fs) (fail :decl "a structured binding of an anonymous member"))
                 (doseq [[f b] (map vector fs bs)]
                   (bind! b (analyze ctx {:kind "MemberExpr" :name (:name f) :isArrow false :inner [ref]})))
                 [])
               ;; (queue 584, the checker: E neither an array, nor tuple-like, nor a class, [dcl.struct.bind]/3-5: GCC's "cannot
               ;; decompose non-array non-class type 'int'"; cpp2a/decomp4.C's `auto [y] = x;` for x an int)
               (and (checking?) (abi/scalar? E) (not (re-find #":k :(auto|dep|tparam|tdep)" (pr-str E))))
               (throw (ex-info (str "codegen: cannot decompose non-array non-class type " (cx-tyname E)) {:codegen/refused :decomp :cx/node d}))
               :else (fail :decl "a structured binding of " (pr-str E)))]
    (vec (cons {:s :decl :var eid :init init} more))))

(declare check-static-assert!)

(defn- cx-decomposition!
  "The rest of CP313 (a), the checker: [dcl.struct.bind]/4 for a structured binding declaration `d` whose initializer is
  of a class type E that is not tuple-like (no std::tuple_size in the unit; clang's checkMemberDecomposition with
  findDecomposableBaseClass): E's non-static data members all direct members of E or of one base class of E (else
  \"both it and its base class\" or \"its base classes\" have them), no anonymous union or struct member among them,
  each accessible as a member of E in the context, and as many as the names; an array's elements as many as the names."
  [ctx d]
  (when (checking?)
    (let [tinst (some-> (:fn-id ctx) fnd :tinst)
          init (first (remove #(= "BindingDecl" (:kind %)) (kids d)))
          names (filter #(= "BindingDecl" (:kind %)) (kids d))
          a (when init (analyze ctx init))
          a (if (= :init-list (:op a)) (when (= 1 (count (:items a))) (first (:items a))) a)
          t (when (and a (:ty a)) (abi/unq (abi/non-ref (:ty a))))
          tuple-like? (seq (try (lookup-qualified *root* ["std" "tuple_size"]) (catch arbace.lang.ExceptionInfo _ nil)))
          err (fn [& m] (throw (ex-info (apply str "codegen: " m) {:codegen/refused :decomp :cx/node d})))
          data (fn [c] (remove #(and (:bits %) (nil? (:name %))) (:fields (abi/cls c))))]
      (cond
        ;; (cpp-indep: [dcl.struct.bind]/2-4, E an array, a tuple-like type or a class: a scalar is none, GCC's "cannot decompose
        ;; non-array non-class type 'int'", a function template's or a class template member's specialization's too, its types
        ;; whole; cpp1z/decomp25.C)
        (and t (or (abi/scalar? t) (abi/void? t)) (not (abi/class? t)) (not (abi/arr? t))
             (not-any? #(and (map? %) (#{:tparam :tparam-v :ttp :dep :tdep :texpr :auto :pack-exp} (:k %))) (tree-seq coll? seq t)))
        (err "cannot decompose non-array non-class type " (cx-tyname t))
        ;; (cpp-def: [dcl.struct.bind]/4 for a namespace-scope one, as the block's analysis checks it: a tuple-like E of the
        ;; global namespace, its i-th std::tuple_element<i, E>::type void, no reference to it; cpp1z/decomp55.C)
        (and t (abi/class? t) tuple-like? (nil? (:fn-id ctx))
             (let [c (abi/cls (:id t))]
               (and (string? (:name c)) (empty? (:path c)) (not (:targs c)) (not (:tmpl c))
                    (some (fn [i] (let [ti (try (resolve-type *root* (str "std::tuple_element<" i ", " (:name c) ">::type"))
                                               (catch arbace.lang.ExceptionInfo _ nil))]
                                    (and (map? ti) (= abi/void (abi/unq ti)))))
                          (range (count names))))))
        (err "cannot decompose: 'std::tuple_element<0, " (:name (abi/cls (:id t))) ">::type' is 'void'")
        ;; (a closure type's, a function template's specialization's too: cpp1z/decomp39.C)
        (and tinst t (abi/class? t) (:lambda (abi/cls (:id t))))
        (err "cannot decompose lambda closure type '" (:name (abi/cls (:id t))) "'")
        tinst nil
        (and t (abi/arr? t) (:n t) (not= (long (:n t)) (count names)))
        (err "type decomposes into " (:n t) " elements, but " (count names) " names were provided")
        (and t (abi/class? t) (not tuple-like?) (not (abi/dynamic? (:id t))))
        (let [E (:id t)
              holder (fn holder [c]
                       (let [bs (map :cls (:bases (abi/cls c)))]
                         (if (seq (data c))
                           (do (when-let [b (first (filter #(some? (holder %)) bs))]
                                 (err "cannot decompose class type '" (:name (abi/cls c)) "': both it and its base class '" (:name (abi/cls b)) "' have non-static data members"))
                               c)
                           (let [hs (distinct (keep holder bs))]
                             (cond (empty? hs) nil
                                   (> (count hs) 1) (err "cannot decompose class type '" (:name (abi/cls c)) "': its base classes '" (:name (abi/cls (first hs))) "' and '" (:name (abi/cls (second hs))) "' have non-static data members")
                                   :else (first hs))))))
              h (holder E)
              fs (if h (vec (data h)) [])]
          ;; (a closure type's members are the implementation's: err_decomp_decl_lambda)
          (when (and h (:lambda (abi/cls h)))
            (err "cannot decompose lambda closure type '" (:name (abi/cls h)) "'"))
          (when-let [an (first (filter :anon fs))]
            (err "cannot decompose class type '" (:name (abi/cls E)) "' because it has an anonymous " (if (:union (abi/cls (:id (abi/unq (:ty an))))) "union" "struct") " member"))
          (doseq [f fs :when (#{:private :protected} (:access f))]
            (when-let [cx (cx-context ctx)]
              (when (false? (cx-access-ok? cx h (:access f) E nil))
                (err "cannot decompose inaccessible member '" (:name (abi/cls h)) "::" (:name f) "' of '" (:name (abi/cls E)) "'"))))
          (when (not= (count fs) (count names))
            (err "type '" (:name (abi/cls E)) "' decomposes into " (count fs) " elements, but " (count names) " names were provided")))
        :else nil))))

(defn- decl-stmt [ctx n]
  (vec (mapcat #(if (vector? %) % [%]) (for [d (kids n)]
         (case (:kind d)
           ;; a structured binding declaration: e's declaration and the tuple-like bindings' variables
           ;; (CP331 (a): the checker checks the rules of [dcl.struct.bind]/4 (cpp-props3's), then models the declaration as
           ;; the code generator does, so the bindings' uses are analyzed too; cpp-route had refused it after the rules)
           "DecompositionDecl" (do (when (checking?) (cx-decomposition! ctx d))
                                   (decomposition! ctx d nil))
           "VarDecl" (let [_ (when (checking?)
                               (let [f (when-let [i (:fn-id ctx)] (fnd i))]
                                 ;; (a function template's specialization that is no member, fifth slice: its names are
                                 ;; bound, the access checked in the template's context, [temp.spec.general]/6)
                                 (when (and f (not (:cls f)) (not (:this-type ctx)))
                                   (check-type-access! (:scope ctx) (get-in d [:type :qualType]) d))))
                           id (local-var! ctx d :local)
                           v (var* id)]
                       (if (= :static-local (:storage v))
                         (do (swap! (:statics ctx) conj id)
                             (let [c (count (filter #(= (:name (var* %)) (:name v)) @(:statics ctx)))]
                               (upd-var! id assoc :disc (dec c) :init-node (first (kids d))))
                             (let [init (decl-init ctx id d)]
                               (cx-dtor-access! ctx (:ty (var* id)))
                               (cx-check-constant! (var* id) init)
                               (enter! (:scope ctx) (or (:name d) "") {:e :var :id id})
                               (upd-var! id assoc :sinit init)
                               ;; (queue 584, the checker: a block-scope extern declaration defines no variable, [basic.def]/2.3,
                               ;; so no static or thread_local definition the constant evaluation passes through, [expr.const]/5
                               ;; of C++23: cpp23/constexpr-nonlit1.C's `extern thread_local int a;`)
                               (cond-> {:s :static-local :var id}
                                 (checking?) (assoc :cx-at (:range d))
                                 (and (checking?) (= "extern" (:storageClass d))) (-> (dissoc :cx-at) (assoc :cx-extern true)))))
                         (let [;; (queue 492, the checker: a variable whose initialization is refused is declared all the
                               ;; same, as GCC declares it, so the block's later statements find it: `A a2 (a); a2 = a;`)
                               init (try (let [init (binding [*cx-arms-evaluated* (and (checking?) (not (:constexpr d)) (not (:c (:ty (var* id))))
                                                                                       (not (abi/ref? (:ty (var* id)))))]
                                                      (decl-init ctx id d))]
                                           (cx-dtor-access! ctx (:ty (var* id)))
                                           (cx-check-constant! (var* id) init)
                                           ;; (cpp-p2564: an immediate constructor's call, an immediate invocation)
                                           (cx-ctor-immediate! ctx (var* id) init d)
                                           init)
                                         (catch arbace.lang.ExceptionInfo x
                                           (when (and (checking?) (:codegen/refused (ex-data x)) (:name d) (not (has-auto? (:ty (var* id)))))
                                             (enter! (:scope ctx) (:name d) {:e :var :id id}))
                                           ;; (queue 508, the checker: a default-initialization's refusal, no initializer
                                           ;; analyzed to locate it, at the declaration, as GCC: it had taken the stale last
                                           ;; node, a later function's line)
                                           (if (and (checking?) (:codegen/refused (ex-data x)) (nil? (:cx/node (ex-data x)))
                                                    (nil? (init-kid d)) (:range d))
                                             (throw (ex-info (.getMessage x) (assoc (ex-data x) :cx/node d) x))
                                             (throw x))))
                               t (:ty (var* id))
                               ;; a constexpr local, or a const integral one, initialized by a constant: folded (clang
                               ;; emits the value)
                               ;; (manifestly constant-evaluated, the variable usable in constant expressions: CP378 (a))
                               init (if (and (= :expr (:i init)) (abi/scalar? (abi/unq t)) (or (not (#{:int :float :null} (:op (:e init)))) (:ice (:e init)))
                                             (or (:constexpr d) (and (:c t) (abi/integral? t))))
                                      (if-let [c (ce-try (:e init) true)] (assoc init :e c) init)
                                      init)]
                           (enter! (:scope ctx) (or (:name d) "") {:e :var :id id})
                           (cond-> {:s :decl :var id :init init} (and (checking?) (:range d)) (assoc :cx-at (:range d))))))
           "CXXRecordDecl" (do (declare-class! (:scope ctx) d) {:s :null})
           ;; a block-scope function declaration (queue 445: the code generator's at its enclosing namespace, *block-fn*)
           "FunctionDecl" (do (binding [*block-fn* (not (checking?))] (declare-fn! (:scope ctx) d)) {:s :null})
           "EnumDecl" (do (declare-enum! (:scope ctx) d) {:s :null})
           ("TypedefDecl" "TypeAliasDecl" "UsingDecl" "UsingDirectiveDecl" "UsingEnumDecl" "NamespaceAliasDecl")
           ;; (queue 570, the checker: a block scope's typedef or alias declaration may name a variably modified type, GNU's,
           ;; ext/vlm2.C's `typedef int X[n];`)
           (do (binding [*cx-vla* (when (and (checking?) (#{"TypedefDecl" "TypeAliasDecl"} (:kind d))) (:scope ctx))] (declare-node! (:scope ctx) d)) {:s :null})
           ;; (a static_assert: no code; CX12, the checker: checked in a function no template's specialization)
           ;; (queue 497, the checker: in a function template's specialization for arguments with no dependent part too,
           ;; [temp.inst]/11 with [dcl.pre]/10, its failure alone judged -- a sure false value; any other refusal there the
           ;; slice's, dropped)
           "StaticAssertDecl" (do (if-let [ti (some-> (:fn-id ctx) fnd :tinst)]
                                    (when (and (checking?)
                                               (not-any? #(and (map? %) (#{:tparam :tparam-v :ttp :dep :tdep :texpr :auto :pack-exp} (:k %)))
                                                         (tree-seq coll? seq (:args ti)))
                                               ;; (no requires-expression: its value is the slice's approximation, [expr.prim.req]'s
                                               ;; substitution judged by what the slice analyzes; cpp2a/spaceship-sfinae3.C)
                                               (not-any? #(and (map? %) (= "RequiresExpr" (:kind %)))
                                                         (tree-seq #(or (map? %) (vector? %)) #(if (map? %) (vals (dissoc % :_t :_ent :range :loc)) (seq %)) d))
                                               (let [b (get-in d [:range :begin :offset]) e (get-in d [:range :end :offset])]
                                                 (and b e (<= (long b) (long e) (count *src*)))))
                                      ;; (on one line: GCC reports a failed conjunct where it is written; cpp-indep: over several
                                      ;; lines when the failure is placed at its false conjunct, sassert-false-conjunct's,
                                      ;; diagnostic/static_assert1.C)
                                      (let [one-line (let [b (get-in d [:range :begin :offset]) e (get-in d [:range :end :offset])]
                                                       (not (str/includes? (subs *src* (int b) (int e)) "\n")))]
                                        (try (check-static-assert! ctx d)
                                             (catch arbace.lang.ExceptionInfo x
                                               (when (and (= "codegen: static assertion failed" (.getMessage x))
                                                          (or one-line (not (identical? d (:cx/node (ex-data x))))))
                                                 (throw x))))))
                                    (check-static-assert! ctx d))
                                  {:s :null})
           (fail :decl "local declaration " (:kind d)))))))

(defn- block-ctx [ctx] (assoc ctx :scope (new-scope :block (:scope ctx))))

(defn- full [e] {:s :expr :e e})

(defn- cx-decomp-condition!
  "cpp-def (the checker): C++26's structured binding declaration as a condition (P0963R3, [stmt.pre]/? with [dcl.struct.bind]),
  an extension before (GCC's pedwarn): the decision variable is the whole object, contextually converted to bool (`:bool`, an if
  or a while) or converted to an integral or enumeration type (`:switch`); an initializer of array type takes none, GCC's \"array
  initializer for structured binding declaration in condition\"; a class of the unit with no conversion function, or (a switch)
  none but explicit ones, GCC's \"could not convert '<structured bindings>' from 'S' to 'bool'\", \"switch quantity not an
  integer\" (cpp26/decomp9.C). The DeclStmt `cvar`."
  [ctx cvar what]
  (when (checking?)
    (when-let [d (first (filter #(= "DecompositionDecl" (:kind %)) (kids cvar)))]
      (let [init (first (remove #(= "BindingDecl" (:kind %)) (kids d)))
            a (when init (try (binding [*unevaluated* true] (analyze ctx init)) (catch arbace.lang.ExceptionInfo _ nil)))
            t (when (and a (map? (:ty a))) (abi/unq (abi/non-ref (:ty a))))
            err (fn [& m] (throw (ex-info (apply str "codegen: " m) {:codegen/refused :decomp :cx/node d})))]
        (cond
          (nil? t) nil
          (abi/arr? t) (err "array initializer for structured binding declaration in condition")
          (abi/class? t)
          (let [c (abi/cls (:id t))
                convs (keep #(let [f (fnd %)] (when (= :conv (:kind f)) f)) (:methods c))]
            (when (and (:complete c) (not (:tmpl c)) (not (:targs c)) (not (:defining c)) (empty? (:bases c)) (not (:union c)))
              (case what
                :bool (when (empty? convs) (err "could not convert '<structured bindings>' from '" (:name c) "' to 'bool'"))
                :switch (when (every? :explicit convs) (err "switch quantity not an integer"))
                nil)))
          :else nil)))))

(defn- cond-of [ctx n]
  (to-bool (analyze ctx n)))

(declare local-var! stmt)

(defn- range-for-class
  "A range-based for over a class ([stmt.ranged]/1: auto&& __range = e; auto __begin = __range.begin(), __end =
  __range.end(); for (; __begin != __end; ++__begin) { T x = *__begin; body }), the members begin and end (G4: the
  headers' containers), their operators by overload resolution."
  [c range-e loopd body]
  (let [ref (fn [nm] {:kind "DeclRefExpr" :referencedDecl {:name nm}})
        local! (fn [nm t]
                 (let [id (next-id)]
                   (swap! *vars* assoc id {:id id :name nm :ty t :storage :local :fn (:fn-id c)})
                   (enter! (:scope c) nm {:e :var :id id})
                   id))
        rt (if (= :lv (:cat range-e)) (abi/lref (:ty range-e)) (abi/rref (abi/unq (:ty range-e))))
        rid (local! "__range1" rt)
        rinit (init-for rt range-e c :copy)
        ;; (cpp-rt-own: [stmt.ranged]/1.3, a class without members named begin or end: begin(__range) and end(__range) by
        ;; argument-dependent lookup, fs_ops.cc's `for (const directory_entry& x : directory_iterator(from, ec))` of
        ;; std::filesystem's non-member begin and end; "no member begin" before)
        cid (class-id (abi/unq (abi/non-ref (:ty range-e))))
        members? (or (nil? cid) (seq (class-lookup cid "begin")) (seq (class-lookup cid "end")))
        call (fn [m] (analyze c (if members?
                                  {:kind "CallExpr" :inner [{:kind "MemberExpr" :name m :isArrow false :inner [(ref "__range1")]}]}
                                  {:kind "CallExpr" :inner [(ref m) (ref "__range1")]})))
        be (call "begin") ee (call "end")
        bt (abi/unq (abi/non-ref (:ty be))) et (abi/unq (abi/non-ref (:ty ee)))
        bid (local! "__begin1" bt) eid (local! "__end1" et)
        binit (init-for bt be c :copy) einit (init-for et ee c :copy)
        cnd (cond-of c {:kind "BinaryOperator" :opcode "!=" :inner [(ref "__begin1") (ref "__end1")]})
        inc (analyze c {:kind "UnaryOperator" :opcode "++" :inner [(ref "__begin1")]})
        ic (block-ctx c)
        de (analyze ic {:kind "UnaryOperator" :opcode "*" :inner [(ref "__begin1")]})
        decls (if (= "DecompositionDecl" (:kind loopd))
                (decomposition! ic loopd de)
                (let [lid (local-var! ic loopd :local)
                      lt (:ty (var* lid))
                      lt (if (has-auto? lt) (deduce-auto lt de) lt)
                      _ (upd-var! lid assoc :ty lt)
                      linit (init-for lt de ic :copy)]
                  (enter! (:scope ic) (:name loopd) {:e :var :id lid})
                  [{:s :decl :var lid :init linit}]))]
    {:s :block :items [{:s :decl :var rid :init rinit} {:s :decl :var bid :init binit} {:s :decl :var eid :init einit}
                       {:s :for :cond cnd :inc inc :body {:s :block :items (conj (vec decls) (stmt ic body))}}]}))

(defn- constexpr-if-value
  "An if constexpr's condition's value ([stmt.if]/2: a contextually converted constant expression of type bool): an
  integral constant (const-int), or an object of class type converted to bool as a condition is (to-bool: its conversion
  function, explicit ones too, [conv]/4) and evaluated (`if constexpr (__is_invocable<...>{})`, std::map's
  _Rb_tree::_S_key; CP332 (a))."
  [scope cn]
  (let [e (binding [*cutoff* Long/MAX_VALUE] (rv (analyze {:scope scope} cn)))]
    (when (System/getenv "CPP_CONSTEXPR_IF_TRACE")
      (binding [*out* *err*] (println "if constexpr" (pr-str (some-> (node-text cn) (subs 0 (min 200 (count (node-text cn)))))) (pr-str (loc-of (get-in cn [:range :begin]))))))
    ;; (cpp-s8: a condition the evaluator cannot compute is a refusal, `constexpr-if`, not a crash of the analysis:
    ;; <format>'s `if constexpr (__unicode::__literal_encoding_is_utf8())`, whose consteval body reads the execution
    ;; character set's name through pointers into a string literal)
    (try
      (if (abi/class? (abi/unq (:ty e)))
        (let [v (binding [*cutoff* Long/MAX_VALUE *ce-manifest* true] (ce-eval (to-bool e)))]
          (if (number? v) v (if v 1 0)))
        (const-int scope cn))
      (catch arbace.lang.ExceptionInfo x
        (if (and (:codegen/not-constant (ex-data x)) (not (checking?)))
          (fail :constexpr-if "an if constexpr's condition not evaluated (" (.getMessage x) ")")
          (throw x))))))

(declare stmt*)

(defn stmt
  "The typed statement of a tree node."
  [ctx n]
  (let [r (stmt* ctx n)]
    ;; (h-cpp-consteval, the checker: the position of a statement a constant evaluation refuses, at its own line)
    (cond
      (not (and (checking?) (map? r) (:range n))) r
      (#{:asm :goto} (:s r)) (assoc r :cx-at (:range n))
      ;; (cpp-ce3: a loop's, where its iteration count's limit is reported)
      (#{:while :do :for} (:s r)) (assoc r :cx-at (:range n))
      ;; (cpp-ce2: a compound statement's closing brace, where its objects are destroyed)
      (and (= "CompoundStmt" (:kind n)) (= :block (:s r)) (get-in n [:range :end]))
      (assoc r :cx-end {:begin (get-in n [:range :end]) :end (get-in n [:range :end])})
      ;; (an if's, for the potential constant check's "neither branch")
      (and (= "IfStmt" (:kind n)) (= :block (:s r)) (= :if (:s (peek (:items r)))))
      (update r :items #(conj (pop %) (assoc (peek %) :cx-at (:range n))))
      :else r)))

(defn- stmt*
  "The typed statement of a tree node (stmt's)."
  [ctx n]
  (tick!)
  (when-let [a *at*] (when (:range n) (reset! a n)))
  (case (:kind n)
    nil {:s :null}
    "CompoundStmt" (let [c (block-ctx ctx)
                         ;; CX12: as a checker (*on-refusal* bound) a refused statement is reported and the block goes on
                         st (if-let [h *on-refusal*]
                              (fn [x] (try (stmt c x)
                                           (catch arbace.lang.ExceptionInfo e
                                             (if (:codegen/refused (ex-data e))
                                               (do ;; (CP310 (b): an immediate function whose body is not constant, its
                                                   ;; invocations not either)
                                                   (when (and (= :constexpr (:codegen/refused (ex-data e))) (:fn-id ctx) (:consteval (fnd (:fn-id ctx))))
                                                     (upd-fn! (:fn-id ctx) assoc :cx-imm-error true))
                                                   ;; (cpp-sweep: a constexpr function's too, its calls in a constant evaluation then
                                                   ;; GCC's "called in a constant expression": cpp2a/inline-asm3.C)
                                                   (when (and (= :constexpr (:codegen/refused (ex-data e))) (:fn-id ctx) (:constexpr (fnd (:fn-id ctx)))
                                                              (not (:consteval (fnd (:fn-id ctx)))) (re-find #"constexpr variable '" (str (ex-message e))))
                                                     (upd-fn! (:fn-id ctx) assoc :cx-body-error true))
                                                   (h e (some-> *at* deref)) {:s :null})
                                               (throw e)))))
                              #(stmt c %))]
                     {:s :block :items (vec (mapcat #(let [x (st %)] (if (vector? x) x [x])) (kids n)))})
    "DeclStmt" {:s :block :flat true :items (decl-stmt ctx n)}
    "NullStmt" {:s :null}
    "ReturnStmt" (binding [*cx-arms-evaluated* (checking?)]
                 (let [[e] (kids n)
                       _ (some-> (:saw-return ctx) (reset! true))
                       rt (:ret (:ty (fnd (:fn-id ctx))))
                       ;; (a deduced return type: auto, and since CP301 (a) auto&, auto&&, auto* -- a generic lambda's
                       ;; `-> auto&` among them -- [dcl.spec.auto.general]/11)
                       pre (when (and e (has-auto? rt)) (p2266-xvalue (analyze ctx e)))
                       rt (if (has-auto? rt)
                            (let [t (cond (nil? pre) abi/void
                                          ;; (decltype(auto): an unparenthesized name or member access its declared type, else
                                          ;; T& of an lvalue, T&& of an xvalue, T of a prvalue, [dcl.type.decltype]/1)
                                          ;; (queue 584: C++23's P2266, a possibly parenthesized id-expression naming an
                                          ;; implicitly movable entity an xvalue there too, [expr.prim.id.unqual]/4:
                                          ;; `decltype(auto) f(int&& x) { return (x); }` returns int&&, cpp23/elision6.C)
                                          (:decltype rt) (let [x (p2266-xvalue (analyze ctx e))]
                                                           (cond (and (= "DeclRefExpr" (:kind e)) (= :var (:op x))) (:ty (var* (:id x)))
                                                                 ;; (queue 584: a reference variable's name, its declared reference
                                                                 ;; type, [dcl.type.decltype]/1.3: cpp23/decltype1.C's f12, f14)
                                                                 (and (= "DeclRefExpr" (:kind e)) (= :deref (:op x)) (= :load (get-in x [:e :op]))
                                                                      (= :var (get-in x [:e :e :op])) (get-in x [:e :e :raw]))
                                                                 (:ty (var* (get-in x [:e :e :id])))
                                                                 (#{"DeclRefExpr" "MemberExpr"} (:kind e)) (:ty x)
                                                                 (= :lv (:cat x)) (abi/lref (:ty x))
                                                                 (= :xv (:cat x)) (abi/rref (:ty x))
                                                                 :else (abi/unq (:ty x))))
                                          ;; (cpp-rind, the checker: [dcl.type.auto.deduct]/4, auto* deduced from a returned
                                          ;; operand of no pointer type fails: GCC's "unable to deduce 'auto*' from '0'";
                                          ;; cpp1y/auto-fn37.C)
                                          (and (checking?) (= :ptr (:k rt)) (= :auto (:k (:to rt)))
                                               (let [u (abi/unq (:ty (rv pre)))] (and (some? (:k u)) (not (abi/ptr? u)) (not (abi/arr? u)) (not (abi/fn? u))
                                                                                     (not (re-find #":k :(auto|dep|tparam|tdep)" (pr-str u))))))
                                          (fail :deduce "unable to deduce 'auto*' from the returned operand")
                                          :else (deduce-auto rt pre))]
                              ;; (n-cpp-concepts: a constrained placeholder's, [dcl.type.auto.deduct]/2)
                              (placeholder-check! (:scope ctx) rt t "return type" n)
                              (upd-fn! (:fn-id ctx) assoc-in [:ty :ret] t) t)
                            rt)]
                   ;; (cpp-diag-b, 2026-11-22: [stmt.return]/2, a return statement without an operand in a function whose return type
                   ;; is no cv void: GCC's "return-statement with no value, in function returning 'int'"; one with an operand of a
                   ;; type other than void in a function returning void: "return-statement with a value", from a constructor
                   ;; "returning a value from a constructor")
                   (when (and (checking?) (nil? e) (nil? pre) (some? rt) (not (abi/void? rt)) (not (has-auto? (:ret (:ty (fnd (:fn-id ctx)))))))
                     (fail :return-value "return-statement with no value, in function returning a value"))
                   (when (and (checking?) e (nil? pre) (abi/void? rt))
                     (let [a (analyze ctx e)]
                       (when (and (some? (:ty a)) (not (abi/void? (abi/unq (:ty a)))))
                         (fail :return-value "return-statement with a value, in function returning 'void'"))))
                   (cond
                     (nil? e) {:s :return}
                     pre (if (abi/void? rt) {:s :return :void-e pre}
                             ;; (cpp-rt-own2, the code generator: [class.copy.elision]/3 in a function whose return type was deduced
                             ;; too, a returned local of class type an rvalue first: <bits/fs_path.h>'s auto path::_S_convert's
                             ;; `return __str;` of its std::string, clang's move constructor, a copy before)
                             (let [a (if (and (not (checking?)) (= :var (:op pre)) (not (abi/ref? rt)) (abi/class? (abi/unq rt))
                                              (#{:local :param} (:storage (var* (:id pre)))) (abi/class? (abi/unq (:ty pre))))
                                       (assoc pre :cat :xv)
                                       pre)]
                               {:s :return :init (init-for rt a ctx (if (= :init-list (:op a)) :list :copy))}))
                     (abi/void? rt) {:s :return :void-e (analyze ctx e)}
                     :else (let [a (analyze ctx e)
                                 ;; [class.copy.elision]/3: a returned local is an rvalue first
                                 a (if (and (= :var (:op a)) (#{:local :param} (:storage (var* (:id a)))) (abi/class? (abi/unq (:ty a))))
                                     (assoc a :cat :xv :nrvo-var (:id a)) a)
                                 a (p2266-xvalue a)]
                             {:s :return :init (if (and (checking?) (:nrvo-var a) (< (long *cxx-year*) 23))
                                                 ;; (CX12, the checker: before C++23, [class.copy.elision]/3 -- an overload
                                                 ;; resolution as an rvalue that fails, no viable or ambiguous, is done
                                                 ;; again with the local as an lvalue, and since queue 509 one that chooses
                                                 ;; a constructor taking no rvalue reference; C++23's P2266 makes it an
                                                 ;; xvalue alone)
                                                 (cx-implicit-move-init rt a ctx)
                                                 ;; (cpp-indep, the checker: `return {...};` copy-list-initializes the result,
                                                 ;; [stmt.return]/2 with [over.match.list]/1, cx-explicit-list!; cpp0x/initlist4.C)
                                                 (binding [*cx-copy-list* (or *cx-copy-list* (and (checking?) (= :init-list (:op a)) (or (when (:range e) e) true)))]
                                                   (init-for rt a ctx (if (= :init-list (:op a)) :list :copy))))
                              :nrvo-var (:nrvo-var a)}))))
    "IfStmt" (if (:isConsteval n)
               ;; if consteval ([stmt.if]/4): at run time the branch of a context not constant-evaluated (G4: the
               ;; headers' std::__is_constant_evaluated)
               ;; (CP378 (a): the other branch, the constant evaluation's, kept as the run-time one's metadata ::ce-alt for
               ;; ce-exec; not for the checker, whose verdicts it would move)
               (let [[a e] (:inner n)
                     br (fn [x] (if x (stmt (block-ctx ctx) x) {:s :null}))
                     rt (if (:isNegatedConsteval n) (br a) (br e))
                     alt (when-not (checking?)
                           (try (if (:isNegatedConsteval n) (br e) (br a))
                                (catch arbace.lang.ExceptionInfo x
                                  (if (or (:codegen/refused (ex-data x)) (:codegen/not-constant (ex-data x))) :refused (throw x)))))]
                 (if (and alt (map? rt)) (vary-meta rt assoc ::ce-alt alt) rt))
             (let [c (block-ctx ctx)
                   ks (vec (:inner n))
                   ;; clang's IfStmt: [init?] [condvar decl?] cond then else?, the flags say which
                   [init ks] (if (:hasInit n) [(first ks) (subvec ks 1)] [nil ks])
                   [cvar ks] (if (:hasVar n) [(first ks) (subvec ks 1)] [nil ks])
                   init-s (when init (stmt c init))
                   _ (when cvar (cx-decomp-condition! c cvar :bool))
                   cvar-s (when cvar (stmt c cvar))
                   cn (first ks)
                   cn (if (and cvar (nil? (get-in cn [:referencedDecl :name])))
                        (assoc cn :referencedDecl {:name (:name (first (kids cvar)))}) cn)]
               {:s :block :items (vec (concat (when init-s [init-s]) (when cvar-s [cvar-s])
                                              (if (:isConstexpr n)
                                                ;; if constexpr ([stmt.if]/2): the condition a constant, the discarded branch not analyzed
                                                ;; (CX12, the checker: a condition [expr.const]/5 makes surely not constant, clang's
                                                ;; err_constexpr_if_condition_expression_is_not_constant, at the condition)
                                                [(if (not= 0 (long (try (constexpr-if-value (:scope c) cn)
                                                                        (catch arbace.lang.ExceptionInfo x
                                                                          (if (and (checking?) (:cx/sure (ex-data x)))
                                                                            (throw (ex-info (str "codegen: constexpr if condition is not a constant expression ("
                                                                                                 (str/replace (str (ex-message x)) #"^not a constant: " "") ")")
                                                                                            {:codegen/refused :constexpr :cx/node {:range (or (:cx/at (ex-data x)) (:range cn))}}))
                                                                            (throw x))))))
                                                   (stmt (block-ctx c) (nth ks 1))
                                                   (if (:hasElse n) (stmt (block-ctx c) (nth ks 2)) {:s :null}))]
                                                ;; (cpp-sweep, the checker: a branch that is one statement, refused, reported and the if going on,
                                                ;; as a compound statement's statements are: its other branch's errors kept, cpp2a/consteval11.C's
                                                ;; `if (0) bar (9); else bar (10);`)
                                                (let [br (fn [x] (if-let [h (when (checking?) *on-refusal*)]
                                                                   (try (stmt (block-ctx c) x)
                                                                        (catch arbace.lang.ExceptionInfo e
                                                                          (if (and (:codegen/refused (ex-data e)) (not= "CompoundStmt" (:kind x)))
                                                                            (do (when (and (= :constexpr (:codegen/refused (ex-data e))) (:fn-id ctx) (:consteval (fnd (:fn-id ctx))))
                                                                                  (upd-fn! (:fn-id ctx) assoc :cx-imm-error true))
                                                                                (h e (some-> *at* deref)) {:s :null})
                                                                            (throw e))))
                                                                   (stmt (block-ctx c) x)))]
                                                  [{:s :if :cond (fold-mark (cond-of c cn)) :then (br (nth ks 1))
                                                    :else (when (:hasElse n) (br (nth ks 2)))}]))))}))
    "WhileStmt" (let [c (block-ctx ctx) ks (vec (:inner n))
                      [cvar ks] (if (:hasVar n) [(first ks) (subvec ks 1)] [nil ks])]
                  (when cvar (fail :stmt "a while condition's declaration (destroyed each iteration)"))
                  {:s :while :cond (cond-of c (first ks)) :body (stmt (block-ctx c) (second ks))})
    "DoStmt" (let [[b cn] (kids n)] {:s :do :body (stmt (block-ctx ctx) b) :cond (cond-of ctx cn)})
    "ForStmt" (let [c (block-ctx ctx)
                    [init cvar cn inc body] (:inner n)
                    init (when (:kind init) (stmt c init))]
                (when (:kind cvar) (fail :stmt "a for condition's declaration"))
                {:s :block :items [(or init {:s :null})
                                   {:s :for :cond (when (:kind cn) (cond-of c cn)) :inc (when (:kind inc) (analyze c inc))
                                    :body (stmt (block-ctx c) body)}]})
    "CXXForRangeStmt"
    (let [c (block-ctx ctx)
          ks (vec (:inner n))
          ;; (the native parser's node is clang's: init-statement (or none), the range's DeclStmt, begin, end, cond, inc, the
          ;; loop variable's DeclStmt, the body; C++20's init-statement, [stmt.ranged]/1, analyzed first in the loop's scope:
          ;; it was taken for the range; g++.dg's cpp2a/range-for14.C; cpp-route)
          init-s (when (and (= 8 (count ks)) (:kind (first ks))) (stmt c (first ks)))
          rangen (if (= 8 (count ks)) (nth ks 1) (some #(when (= "DeclStmt" (:kind %)) %) ks))
          range-e (analyze c (first (kids (first (kids rangen)))))
          ;; (cpp-def: the loop variable's DeclStmt the last before the body, which may be a declaration statement itself,
          ;; `for (auto _ : s) int _ = 5;`, cpp26/name-independent-decl10.C)
          loopd (first (kids (last (filter #(= "DeclStmt" (:kind %)) (butlast ks)))))
          body (last ks)
          ;; for (x : {a, b}): the range a std::initializer_list<E>, E the elements' deduced type ([stmt.ranged]/1,
          ;; [dcl.type.auto.deduct]/4; G5)
          range-e (if (= :init-list (:op range-e))
                    (let [ts (distinct (map #(abi/unq (:ty (rv %))) (:items range-e)))
                          e (if (= 1 (count ts)) (first ts) (fail :range-for "a braced range of elements of different types"))
                          te (first (filter #(= :tmpl (:e %)) (lookup-qualified *root* ["std" "initializer_list"] true)))
                          t (if te ((:instantiate-class @hooks) (:id te) [e]) (fail :range-for "a braced range without <initializer_list>"))]
                      (materialize (or (std-init-list t range-e c) (fail :range-for "a braced range"))))
                    range-e)
          at (:ty range-e)]
      ((fn [r] (if init-s {:s :block :items [init-s r]} r))
      (if (and (not (abi/arr? (abi/unq at))) (class-id at))
        (range-for-class c range-e loopd body)
      (do
      ;; (queue 492, the checker: a range of arithmetic or pointer type: begin-expr is begin(__range) found by
      ;; argument-dependent lookup alone, [stmt.ranged]/1.3 with [basic.lookup.argdep]/3 (a fundamental type, or a pointer
      ;; to one, has no associated namespace or class), so nothing; GCC's "'begin' was not declared in this scope" at the range)
      ;; (queue 492, the checker: a range that is a name unqualified lookup does not find, the loop's own variable not yet
      ;; declared there, [stmt.ranged]/1's __range declared first; GCC's "'v' was not declared in this scope")
      (let [rn (first (kids (first (kids rangen))))
            rn (loop [k rn] (if (and (map? k) (#{"ImplicitCastExpr" "ParenExpr"} (:kind k)) (= 1 (count (kids k)))) (recur (first (kids k))) k))
            nm (get-in rn [:referencedDecl :name])]
        (when (and (checking?) (= "DeclRefExpr" (:kind rn)) (= :fnset (:op range-e)) (empty? (:fns range-e)) (empty? (:tmpls range-e))
                   (nil? (ref-qualifier rn)) (cx-undeclared? (:scope c) nm))
          (throw (ex-info (str "codegen: use of undeclared identifier '" nm "'") {:codegen/refused :undecl :cx/node rn}))))
      (when (and (checking?) (let [u (abi/unq (abi/non-ref at))]
                               (or (abi/arith? u) (and (abi/ptr? u) (let [p (abi/unq (:to u))] (or (abi/arith? p) (abi/void? p)))))))
        (throw (ex-info "codegen: use of undeclared identifier 'begin' (a range of fundamental type)"
                        {:codegen/refused :undecl :cx/node (first (kids (first (kids rangen))))})))
      (when-not (abi/arr? (abi/unq at)) (fail :range-for "a range for over a non-array"))
      ;; for (T x : a) as { T* b = a; T* e = a + N; for (; b != e; ++b) { T x = *b; body } }
      (let [et (:of at)
            pt (abi/ptr et)
            bid (next-id) eid (next-id)
            _ (swap! *vars* assoc bid {:id bid :name "__begin" :ty pt :storage :local :fn (:fn-id ctx)} eid {:id eid :name "__end" :ty pt :storage :local :fn (:fn-id ctx)})
            bvar {:op :var :id bid :ty pt :cat :lv}
            evar {:op :var :id eid :ty pt :cat :lv}
            ic (block-ctx c)
            de {:op :deref :e (rv bvar) :ty et :cat :lv}
            decls (if (= "DecompositionDecl" (:kind loopd))
                    (decomposition! ic loopd de)
                    (let [lid (local-var! ic loopd :local)
                          lt (:ty (var* lid))
                          lt (if (has-auto? lt) (deduce-auto lt de) lt)
                          _ (upd-var! lid assoc :ty lt)
                          linit (init-for lt de ic :copy)]
                      (enter! (:scope ic) (:name loopd) {:e :var :id lid})
                      [{:s :decl :var lid :init linit}]))]
        {:s :block :items [{:s :decl :var bid :init {:i :expr :e (rv range-e)}}
                           {:s :decl :var eid :init {:i :expr :e {:op :ptradd :o "+" :p (rv range-e) :n {:op :int :v (:n at) :ty abi/long* :cat :pr} :ty pt :cat :pr}}}
                           {:s :for :cond {:op :cmp :o "!=" :l (rv bvar) :r (rv evar) :ct pt :ty abi/bool* :cat :pr}
                            :inc {:op :incdec :o "++" :post false :e bvar :ty pt :cat :lv}
                            :body {:s :block :items (conj (vec decls) (stmt ic body))}}]})))))
    ;; (queue 393: [stmt.return.coroutine]: co_return; and co_return of a void operand promise.return_void(), co_return e
    ;; promise.return_value(e) -- a local of class type named alone moved, [class.copy.elision]/3 -- then the final suspend)
    "CoreturnStmt" (if (:coro ctx)
                     (let [[e] (kids n)
                           x (when e (analyze ctx e))]
                       (cond
                         (nil? x) {:s :co-return :call (coro-promise-call ctx "return_void" [])}
                         (abi/void? (:ty x)) {:s :co-return :pre x :call (coro-promise-call ctx "return_void" [])}
                         :else (let [x (if (and (= :var (:op x)) (#{:local :param} (:storage (var* (:id x)))) (abi/class? (abi/unq (:ty x))))
                                         (assoc x :cat :xv) x)]
                                 {:s :co-return :call (coro-promise-call ctx "return_value" [x])})))
                     (fail :stmt "statement " (:kind n)))
    "BreakStmt" {:s :break}
    "ContinueStmt" {:s :continue}
    ;; (CP338 (a): GNU's asm statement as clang's CodeGenFunction::EmitAsmStmt takes the one at -O0 that the lowering keeps,
    ;; a compiler barrier: an empty template, no outputs, no goto labels, its inputs scalar values in registers (`r`); any
    ;; other a refusal)
    ;; (cpp-vec: GCC 15's constexpr asm strings, each checked by cx-constexpr-string!; the statement no code in the checker, a
    ;; refusal in the code generator)
    "GCCAsmStmt" (if (seq (:_cxstrs n))
                   (if (checking?)
                     (do (doseq [x (:_cxstrs n)] (cx-constexpr-string! ctx x n true)) {:s :null})
                     (fail :stmt "an asm statement with a constexpr string"))
                 (let [a (or (:_asm n) (fail :stmt "statement GCCAsmStmt"))
                       _ (when (or (seq (:outputs a)) (seq (:labels a)) (:goto a)) (fail :stmt "an asm statement with outputs or labels"))
                       _ (when-not (= "\"\"" (:template a)) (fail :stmt "an asm statement's template " (:template a)))
                       ins (mapv (fn [[nm c] x]
                                   (let [c (subs c 1 (dec (count c)))
                                         ;; (queue 411: a register among memory, `rm`, is a value in a register too, as clang's
                                         ;; EmitAsmInput takes a scalar when the constraint allows a register; the constraint kept
                                         ;; as written: thread.cc's `asm ("" : : "rm" (depend))`)
                                         _ (when (or nm (not (re-matches #"[rm]*r[rm]*" c))) (fail :stmt "an asm operand's constraint " c))
                                         e (rv (analyze ctx x))]
                                     (when-not (or (abi/integral? (abi/unq (:ty e))) (abi/ptr? (abi/unq (:ty e))))
                                       (fail :stmt "an asm operand of " (pr-str (:ty e))))
                                     (assoc e :asm-c c)))
                                 (:inputs a) (:inner n))
                       cl (mapv (fn [c] (let [c (subs c 1 (dec (count c)))]
                                          (when-not (#{"memory" "cc"} c) (fail :stmt "an asm clobber " c))
                                          c))
                                (:clobbers a))]
                   {:s :asm :ins ins :clobbers cl}))
    "SwitchStmt" (let [c (block-ctx ctx) ks (vec (:inner n))
                       [init ks] (if (:hasInit n) [(first ks) (subvec ks 1)] [nil ks])
                       _ (when (:hasVar n) (cx-decomp-condition! c (first ks) :switch))
                       _ (when (:hasVar n) (fail :stmt "a switch condition's declaration"))
                       e (rv (class->scalar c (analyze c (first ks))))
                       pt (promote-type (:ty e))]
                   {:s :block :items (vec (concat (when init [(stmt c init)])
                                                  [{:s :switch :e (convert-scalar e pt false) :ty pt :body (stmt (block-ctx c) (second ks))}]))})
    "CaseStmt" (let [[v body] (kids n)
                     _ (cx-cce-type! (:scope ctx) v "a case label" false)]
                 {:s :case :v (const-int (:scope ctx) v) :body (stmt ctx body)})
    "DefaultStmt" {:s :default :body (stmt ctx (first (kids n)))}
    "LabelStmt" {:s :label :name (:name n) :body (stmt ctx (first (kids n)))}
    "GotoStmt" (let [t (when-not (:label n) (node-text n)) [_ l] (re-find #"goto\s+([A-Za-z_][A-Za-z_0-9]*)" (or t ""))] {:s :goto :name (or (:label n) l)})
    "AttributedStmt" (stmt ctx (last (kids n)))
    "CXXTryStmt" (let [[body & hs] (kids n)]
                   ;; (queue 509: the try-block's compound statement marked, cx-movable-var; its handlers are not in it)
                   {:s :try :body (stmt (if (checking?) (assoc ctx :cx-try (Object.)) ctx) body)
                    :handlers (vec (for [h hs]
                                     (let [c (block-ctx ctx)
                                           ks (kids h)
                                           vd (when (= "VarDecl" (:kind (first ks))) (first ks))
                                           b (last ks)]
                                       (if vd
                                         (let [;; (queue 487, the checker: a handler's type refused at the handler, GCC's
                                               ;; place for it, not the try statement's: parse/error54.C)
                                               id (try (binding [*cx-vla* (when (checking?) (:scope c))] (local-var! c vd :local))
                                                       (catch arbace.lang.ExceptionInfo x
                                                         (throw (if (and (checking?) (= :ambiguous (:codegen/refused (ex-data x))) (not (:cx/node (ex-data x))))
                                                                  (ex-info (.getMessage x) (assoc (ex-data x) :cx/node h))
                                                                  x))))
                                               t (:ty (var* id))
                                               ;; (queue 570, the checker: a handler of a variably modified type, [except.handle]/1:
                                               ;; GCC's "cannot catch type 'int (*)[i]' of variable size"; ext/vla4.C)
                                               _ (when (and (checking?) (cx-vm? t))
                                                   (throw (ex-info "codegen: cannot catch a type of variable size" {:codegen/refused :vla-type :cx/node h})))
                                               ct (abi/unq (abi/non-ref t))
                                               src {:op :exn-obj :ty ct :cat :lv}
                                               init (cond (abi/ref? t) {:i :bind :e src}
                                                          (abi/ptr? ct) {:i :expr :e {:op :exn-ptr :ty ct :cat :pr}}
                                                          :else (init-for t src c :copy))]
                                           (enter! (:scope c) (:name vd) {:e :var :id id})
                                           (when (checking?) (swap! *vars* assoc-in [id :cx-handler] true))
                                           {:ty ct :var id :init init :body (stmt c b)})
                                         {:body (stmt c b)}))))})
    (if (or (str/ends-with? (str (:kind n)) "Expr") (str/ends-with? (str (:kind n)) "Operator") (str/ends-with? (str (:kind n)) "Literal"))
      (let [x (binding [*cx-arms-evaluated* (checking?)] (analyze ctx n))]
        ;; (cpp-tpl2, the checker: [expr.prim.id.general]/4 and [expr.ref]/6.3.2, an expression statement that names
        ;; non-static member functions and does not call them: GCC's "invalid use of non-static member function",
        ;; template/pr84973-2.C's `b;`)
        (when (and (checking?) (#{"DeclRefExpr" "MemberExpr"} (:kind n)) (= :fnset (:op x)) (seq (:fns x)) (empty? (:tmpls x))
                   (every? #(let [f (fnd %)] (and (:cls f) (not (:static f)))) (:fns x)))
          (fail :expr "invalid use of non-static member function '" (:name (fnd (first (:fns x)))) "'"))
        (full x))
      (fail :stmt "statement " (:kind n)))))

;; ---------------------------------------------------------------------------------------------
;; Functions' bodies

;; (cpp-singles, the checker: a base's default-initialization by a user-provided constructor without mem-initializers, whose
;; constructor is inaccessible: GCC's access error at the body's opening brace, where it checks the deferred accesses, not at the
;; declarator as its other errors there; cpp1y/pr66690.C's D<int>::D() over the private B::B())
(defn- base-default-init
  [t ctx f]
  (if (and (checking?) (not (:implicit f)) (not (:defaulted f)) (empty? (:inits f)) (get-in (:body f) [:range :begin :offset]))
    (try (init-for t nil ctx :default)
         (catch arbace.lang.ExceptionInfo e
           (if (and (= :access (:codegen/refused (ex-data e))) (not (:cx/node (ex-data e))))
             (throw (ex-info (.getMessage e) (assoc (ex-data e) :cx/node {:range {:begin (get-in (:body f) [:range :begin])}})))
             (throw e))))
    (init-for t nil ctx :default)))

(defn- ctor-inits
  "A constructor's mem-initializers as [{:base bid :init} ...] and [{:field i :init} ...] in initialization order."
  [ctx f]
  (let [cid (:cls f)
        c (abi/cls cid)
        given (into {} (for [i (:inits f)]
                         (let [k (if-let [b (or (:baseInit i) (:delegatingInit i))]
                                   ;; (the class's own name: a delegating constructor, the injected-class-name of a
                                   ;; template's specialization written without its arguments, G5: istreambuf_iterator; the
                                   ;; parser's :delegatingInit since cpp-90's tree, G5c)
                                   [:base (if (= (str/trim (str (:qualType b))) (:name c)) cid (:id (resolve-type (:scope ctx) (:qualType b))))]
                                   [:field (get-in i [:anyInit :name])])
                               [x] (kids i)]
                           [k x])))
        ;; (cpp-ce3, the checker: each mem-initializer's range, the place of its constructor call's errors, ce-construct's *ce-mi-at*)
        at-of (if (checking?) (into {} (for [i (:inits f) :when (or (:range i) (:_range i))]
                                         [(if-let [b (or (:baseInit i) (:delegatingInit i))]
                                            [:base (if (= (str/trim (str (:qualType b))) (:name c)) cid (:id (resolve-type (:scope ctx) (:qualType b))))]
                                            [:field (get-in i [:anyInit :name])])
                                          (or (:range i) (:_range i))]))
                  {})
        init-of (fn [t x]
                  (cond
                    (nil? x) nil
                    (= "ParenListExpr" (:kind x)) (init-for t (analyze-args ctx (kids x)) ctx (if (empty? (kids x)) :value :direct))
                    ;; base() or member(): value-initialization ([dcl.init.general]/16.4)
                    ;; (cpp-rind, the checker: [dcl.init.general]/9, a reference is not value-initialized, `ref()` of a reference
                    ;; member: GCC's "value-initialization of reference type 'int&'"; init/ctor9.C)
                    (= "ImplicitValueInitExpr" (:kind x)) (init-for t nil ctx :value)
                    (= "InitListExpr" (:kind x)) (init-for t (analyze ctx x) ctx :list)
                    (= "CXXParenListInitExpr" (:kind x)) (init-for t (mapv #(analyze ctx %) (kids x)) ctx :direct)
                    ;; (a mem-initializer whose one argument is a pack expansion, `_Inherited(std::forward<_UTypes>(__u)...)`,
                    ;; [temp.variadic]/5: as many arguments as the pack has; CP332 (a), tuple's constructors)
                    (= "PackExpansionExpr" (:kind x)) (let [as (analyze-args ctx [x])]
                                                        (init-for t as ctx (if (empty? as) :value :direct)))
                    ;; (cpp-indep: the native parser's `member({...})`, a typeless CXXConstructExpr over its arguments: direct-
                    ;; initialization from them, [class.base.init]/7 -- a braced list the argument of a constructor, A's copy
                    ;; constructor's for an aggregate; cpp0x/constexpr-ice3.C, initlist4.C)
                    (and (= "CXXConstructExpr" (:kind x)) (nil? (get-in x [:type :qualType])))
                    (init-for t (mapv #(analyze ctx %) (kids x)) ctx :direct)
                    :else (let [a (analyze ctx x)]
                            (cx-array-paren! t [a])
                            (init-for t [a] ctx :direct))))
        deleg (get given [:base cid])
        ;; (round 54, the checker: [class.base.init]/5, a mem-initializer-list initializes at most one member of a union)
        _ (when (and (checking?) (:union c))
            (when-let [i2 (second (filter #(and (not (:baseInit %)) (not (:delegatingInit %)) (get-in % [:anyInit :name])) (:inits f)))]
              (throw (ex-info (str "codegen: initializations for multiple members of '" (:name c) "'") {:codegen/refused :union :cx/node i2}))))]
    ;; (queue 497, the checker: [class.base.init]/12, a non-delegating user-provided constructor potentially invokes the
    ;; destructor of each potentially constructed subobject of class type (a union's variant members aside), and
    ;; [class.dtor]/15 makes a deleted one ill-formed: GCC's "use of deleted function 'A::~A()'" at the constructor)
    (when (and (checking?) (not deleg) (not (:implicit f)) (not (:defaulted f)) (not (:inh-from f)) (not (:union c)))
      (doseq [t (concat (map (fn [b] {:k :class :id (:cls b)}) (:bases c))
                        (map (fn [v] {:k :class :id v}) (abi/vbases-init cid))
                        (map :ty (remove :anon (:fields c))))
              :let [u (loop [u (abi/unq t) k 0] (if (and (abi/arr? u) (< k 8)) (recur (abi/unq (:of u)) (inc k)) u))]
              :when (and (not (abi/ref? t)) (abi/class? u))
              :let [d (some-> (:dtor (abi/cls (:id u))) fnd)]
              :when (and d (:deleted d) (:deleted-sure d))]
        (throw (ex-info (str "codegen: call to a deleted function " (:name d) (if (:implicit d) " (implicitly deleted)" ""))
                        (cond-> {:codegen/refused :overload} (:node f) (assoc :cx/node (:node f)))))))
    (if deleg
      (let [d (init-of {:k :class :id cid} deleg)]
        ;; (cpp-rind, the checker: [class.base.init]/6, a constructor whose mem-initializer delegates to the constructor itself,
        ;; the target chosen by overload resolution being the same constructor: GCC's "constructor delegates to itself", at the
        ;; mem-initializer; cpp0x/dc8.C, template/meminit1.C)
        (when (and (checking?) (= :ctor (:i d)) (some? (:fn-id ctx)) (= (:fn d) (:fn-id ctx)))
          (throw (ex-info "codegen: constructor delegates to itself"
                          (cond-> {:codegen/refused :ctor-deleg} (get at-of [:base cid]) (assoc :cx/node {:range (get at-of [:base cid])})))))
        {:delegate d})
      {:bases (vec (for [[i b] (map-indexed vector (:bases c)) :when (not (:virtual b))]
                     (let [t {:k :class :id (:cls b)}
                           x (get given [:base (:cls b)])]
                       {:base (:cls b) :idx i :at (get at-of [:base (:cls b)]) :init (cond (contains? (:pre-inits f) (:cls b)) (get (:pre-inits f) (:cls b))
                                                         (contains? given [:base (:cls b)]) (init-of t x)
                                                         :else (base-default-init t ctx f))})))
       ;; the virtual bases, which the complete object's constructor initializes ([class.base.init]/7)
       :vbases (vec (for [v (abi/vbases-init cid)]
                      (let [t {:k :class :id v}]
                        {:base v :init (if (contains? given [:base v]) (init-of t (get given [:base v])) (base-default-init t ctx f))})))
       :fields (vec (for [fl (:fields c)]
                      (let [x (get given [:field (:name fl)])]
                        {:field (:i fl) :at (get at-of [:field (:name fl)])
                         :init (cond
                                 (contains? given [:field (:name fl)]) (if (or (nil? x) (and (checking?) (abi/ref? (:ty fl))
                                                                                                    (or (= "ImplicitValueInitExpr" (:kind x)) (and (= "ParenListExpr" (:kind x)) (empty? (kids x))))))
                                                                          (do ;; (cpp-rind, the checker: [dcl.init.general]/9, no reference is
                                                                              ;; value-initialized, `ref()`: init/ctor9.C)
                                                                              (when (and (checking?) (abi/ref? (:ty fl)))
                                                                                (throw (ex-info "codegen: invalid value-initialization of reference type"
                                                                                                (cond-> {:codegen/refused :init-ref} (get at-of [:field (:name fl)]) (assoc :cx/node {:range (get at-of [:field (:name fl)])})))))
                                                                              (init-for (:ty fl) nil ctx :value))
                                                                          (init-of (:ty fl) x))
                                 ;; a mem-initializer of an anonymous union's (or struct's) member
                                 (and (:anon fl) (some #(contains? given [:field (:name %)]) (:fields (abi/cls-of (:ty fl)))))
                                 (let [ac (abi/cls-of (:ty fl))
                                       m (first (filter #(contains? given [:field (:name %)]) (:fields ac)))]
                                   {:i :list :cls (:id ac) :items [(init-of (:ty m) (get given [:field (:name m)]))] :fields-used [(:i m)]})
                                 ;; (cpp-s4: a union's other members are not initialized, [class.base.init]/9.2 -- variant's
                                 ;; _Variadic_union, its _M_first by the mem-initializer and its _M_rest left alone -- nor, when
                                 ;; one member has a mem-initializer, the one a default member initializer names, /9.1)
                                 (and (:union c) (or (not (:init fl)) (some #(and (vector? %) (= :field (first %))) (keys given))))
                                 {:i :none}
                                 (:init fl)
                                 (let [dn (:init fl)
                                       ;; (cpp-decl2, the checker: a default member initializer `= {...}` copy-list-initializes
                                       ;; its member, [dcl.init.general]/15, an explicit constructor's choice ill-formed
                                       ;; (cx-explicit-list!); one `= x` of another type takes converting constructors alone
                                       ;; (class-init); either error reported at the initializer and the rest of the
                                       ;; constructor analyzed, as GCC reports it once at the member: cpp0x/nsdmi3.C)
                                       cl (when (and (checking?) (map? dn) (= "InitListExpr" (:kind dn)) (not (header-node? dn)))
                                            (when-let [b (get-in dn [:range :begin :offset])]
                                              (let [^String src *src*]
                                                (when (<= (long b) (count src))
                                                (loop [i (dec (long b))]
                                                  (cond (neg? i) nil
                                                        (Character/isWhitespace (.charAt src (int i))) (recur (dec i))
                                                        (= \= (.charAt src (int i))) dn
                                                        :else nil))))))]
                                   (try (binding [*cx-copy-list* (or *cx-copy-list* cl)]
                                          ;; (cpp-p2564: in a consteval unit a main-file constructor's default member initializer has its
                                          ;; immediate invocations evaluated in the constructor's context, at its place (a defaulted one's
                                          ;; declaration, an implicit one's class), [expr.const]/16-18: prop6's SS::SS(), X() = default)
                                          (init-for (:ty fl) (let [own (and (cx-p2564?) (cx-main-fn? f) (not (header-node? dn)))
                                                                   at (when own (or (some-> (if (and (:defaulted f) (not (:implicit f))) (:node f) (or (when-not (:implicit f) (:node f)) (:cx-node c))) :range)))
                                                                   d (binding [*cx-no-imm* (not own) *cx-at-override* (if own (or *cx-at-override* at) *cx-at-override*)] (nsdmi-guard cid fl #(analyze ctx dn)))] (if (= :init-list (:op d)) d d)) ctx (if (= "InitListExpr" (:kind dn)) :list :copy)))
                                        (catch arbace.lang.ExceptionInfo e
                                          (if (and (checking?) *on-refusal* (map? dn) (:range dn)
                                                   (or (:cx/conv-explicit (ex-data e)) (re-find #"from initializer list would use explicit constructor" (str (.getMessage e)))))
                                            (do (*on-refusal* e dn) {:i :none})
                                            (throw e)))))
                                 ;; (cpp-decl2, the checker: a user-provided constructor leaving a member of reference type or of
                                 ;; const-qualified non-class type (or an array of it) without initialization, [class.base.init]/9.3
                                 ;; with [dcl.init.general]/7 (default-initialization of a const object of a type that is not
                                 ;; const-default-constructible) and [class.base.init]/8 of C++11 (a reference member): GCC's
                                 ;; "uninitialized const member in 'const int'", "uninitialized reference member in 'int&'" at the
                                 ;; constructor; init/pr29043.C's `C5() {}` over `int const iit[1]`)
                                 (and (checking?) *on-refusal* (not (:implicit f)) (not (:defaulted f)) (not (:inh-from f)) (:node f)
                                      (string? (:name fl)) (seq (:name fl)) (not (:static fl)) (not (:anon fl)) (not (:union c)) (:ty fl)
                                      (let [t (loop [t (:ty fl)] (if (abi/arr? t) (recur (:of t)) t))]
                                        (or (abi/ref? (:ty fl)) (and (:c t) (not (abi/class? (abi/unq t))) (not (abi/arr? (abi/unq t))))
                                            ;; (a const member of a class type not const-default-constructible, [dcl.init.general]/7:
                                            ;; cpp0x/defaulted2.C's `const B b;` with B() = default over an int)
                                            (and (:c t) (abi/class? (abi/unq t)) (not (cx-const-default-constructible? (:id (abi/unq t))))))))
                                 (do (*on-refusal* (ex-info (str "codegen: uninitialized " (if (abi/ref? (:ty fl)) "reference" "const") " member '" (:name fl) "' in a constructor")
                                                            {:codegen/refused :uninit :cx/node (:node f)})
                                                   (:node f))
                                     {:i :none})
                                 :else (init-for (:ty fl) nil ctx :default))})))})))

(defn- nrvo-var
  "The local every return statement of the body returns, when there is one ([class.copy.elision]/1.1, as clang's
  computeNRVO decides it for one variable)."
  [body-s]
  (let [rets (atom [])]
    ((fn walk [s]
       (when (map? s)
         (when (= :return (:s s)) (swap! rets conj (:nrvo-var s)))
         (doseq [k [:items :then :else :body :handlers]] (let [x (get s k)] (if (vector? x) (doseq [y x] (walk y)) (walk x))))))
     body-s)
    (let [vs (distinct @rets)]
      (when (and (= 1 (count vs)) (first vs) (= :local (:storage (var* (first vs))))) (first vs)))))

(defn- consteval-ctor-body-stores?
  "cpp-s5b (pending review 1111 #1, CP362 (a)'s scope): whether the body (its node) of class `cls`'s consteval constructor
  may store to the object it constructs beyond its mem-initializers: an assignment, a compound assignment or ++/-- whose
  operand is a member of *this (a member named alone, this->m, a member of one, an element of one, *this), a call of a
  member function of the class named alone or through this, a call on a member, or `this`/`*this` passed. The scan is
  syntactic and conservative (a member passed by reference is not counted: basic_format_string's
  `_Checking_scanner<...> __scanner(_M_str)` only reads it)."
  [cls body]
  (let [member? (fn [nm] (and (string? nm) (seq nm)
                              (some (fn [[_ e]] (or (= :field (:e e)) (and (= :fn (:e e)) (not (:static (fnd (:id e)))))))
                                    (try (class-lookup cls nm) (catch arbace.lang.ExceptionInfo _ nil)))))
        strip (fn [x] (loop [x x] (if (#{"ParenExpr" "ImplicitCastExpr"} (:kind x)) (recur (first (:inner x))) x)))
        this? (fn [x] (let [x (strip x)] (or (= "CXXThisExpr" (:kind x))
                                             (and (= "UnaryOperator" (:kind x)) (= "*" (:opcode x)) (= "CXXThisExpr" (:kind (strip (first (:inner x)))))))))
        of-this? (fn of-this? [x]
                   (let [x (strip x)]
                     (case (:kind x)
                       "CXXThisExpr" true
                       "DeclRefExpr" (boolean (member? (get-in x [:referencedDecl :name])))
                       ("MemberExpr" "CXXDependentScopeMemberExpr" "UnresolvedMemberExpr")
                       (let [b (first (:inner x))] (or (nil? b) (of-this? b)))
                       "ArraySubscriptExpr" (of-this? (first (:inner x)))
                       "UnaryOperator" (and (= "*" (:opcode x)) (of-this? (first (:inner x))))
                       false)))
        store? (fn [x]
                 (case (:kind x)
                   "BinaryOperator" (and (= "=" (:opcode x)) (of-this? (first (:inner x))))
                   "CompoundAssignOperator" (of-this? (first (:inner x)))
                   "UnaryOperator" (and (#{"++" "--"} (:opcode x)) (of-this? (first (:inner x))))
                   ("CallExpr" "CXXMemberCallExpr")
                   (or (of-this? (first (:inner x))) (some this? (rest (:inner x))))
                   ("CXXConstructExpr" "ParenListExpr" "InitListExpr" "CXXTemporaryObjectExpr") (some this? (:inner x))
                   false))]
    (boolean (some #(and (map? %) (store? %)) (tree-seq #(and (map? %) (seq (:inner %))) :inner body)))))

(defn coroutine-node?
  "Whether a function body's node holds a co_await, co_yield or co_return outside a lambda's body or a local class: the
  function is a coroutine ([dcl.fct.def.coroutine]/1)."
  [n]
  (boolean ((fn walk [x] (when (map? x)
                           (case (:kind x)
                             ("CoawaitExpr" "CoyieldExpr" "CoreturnStmt") true
                             ("LambdaExpr" "CXXRecordDecl") false
                             (some walk (:inner x)))))
            n)))

(defn- coroutine-body
  "The body of the coroutine `fid` (queue 393, W4; [dcl.fct.def.coroutine]/5-13, as clang's SemaCoroutine builds it):
  the promise type std::coroutine_traits<R, [cv C& for a member,] P1, ..., Pn>::promise_type (/4); each named parameter
  copied (/13: a class by value move-constructed, a reference bound again) and the body's names the copies; the promise
  initialized with the copies' lvalues (and *this for a member that is no lambda's call operator, as clang's
  buildPromiseInitialization) when that initialization is valid, else default-initialized (/5); the returned object
  initialized from promise.get_return_object() at once when of the same type, else that value kept and converted when
  the ramp returns (clang's); the statement { co_await p.initial_suspend(); try { body; [p.return_void();] } catch (...)
  { p.unhandled_exception(); } final-suspend: co_await p.final_suspend(); }. The ramp's parts in the function's :coro."
  [ctx fid pids body-n]
  (let [f (fnd fid)
        _ (when (seq (:param-packs f)) (fail :coroutine "a coroutine with a function parameter pack"))
        _ (when (some #(nil? (:name (var* %))) pids) (fail :coroutine "a coroutine with an unnamed parameter"))
        member (when (and (:cls f) (not (:static f))) (cond-> {:k :class :id (:cls f)} (:cq f) (assoc :c true)))
        targs (vec (concat [(:ret (:ty f))] (when member [(if (= :rref (:refq f)) (abi/rref member) (abi/lref member))]) (:ps (:ty f))))
        ;; (<coroutine>'s template <typename _Result, typename... _ArgTypes>: the pack's arguments grouped, as the templates'
        ;; argument lists bind them)
        tt ((:instantiate-class @hooks) (:id (std-template "coroutine_traits")) [(first targs) {:pack (vec (rest targs))}])
        pt (some-> (type-entity (map second (class-lookup (class-id tt) "promise_type"))) :ty abi/unq)
        _ (when-not (class-id pt) (fail :coroutine "no promise_type in std::coroutine_traits"))
        pc (class-id pt)
        _ (doseq [m ["get_return_object_on_allocation_failure" "operator new" "operator delete"]]
            (when (seq (class-lookup pc m)) (fail :coroutine "a promise type's " m)))
        sc (new-scope :block (:scope ctx))
        ref (fn [nm] {:kind "DeclRefExpr" :referencedDecl {:name nm}})
        copies (vec (for [p pids]
                      (let [v (var* p) t (:ty v)
                            x (analyze ctx (ref (:name v)))
                            x (if (or (= :rref (:k t)) (and (not (abi/ref? t)) (abi/class? (abi/unq t)))) (assoc x :cat :xv) x)
                            ct (if (abi/ref? t) t (abi/unq t))
                            id (next-id)]
                        (swap! *vars* assoc id {:id id :name (:name v) :ty ct :storage :local :fn fid})
                        {:var id :param p :init (if (abi/ref? ct) (init-for ct x ctx :copy) (init-for ct [x] ctx :direct))})))
        _ (doseq [{:keys [var]} copies] (enter! sc (:name (var* var)) {:e :var :id var}))
        c (assoc ctx :scope sc)
        prid (next-id)
        _ (swap! *vars* assoc prid {:id prid :name "__promise" :ty pt :storage :local :fn fid})
        lambda-op (and member (:lambda (abi/cls (:cls f))))
        args (vec (concat (when (and member (not lambda-op)) [(deref-node {:op :this :ty (:this-type ctx) :cat :pr})])
                          (map (fn [{:keys [var]}] (analyze c (ref (:name (var* var))))) copies)))
        pinit (or (when (seq args)
                    (try (init-for pt args c :direct)
                         (catch arbace.lang.ExceptionInfo x (if (:codegen/refused (ex-data x)) nil (throw x)))))
                  (init-for pt nil c :default))
        c (assoc c :coro {:promise prid :ptype pt :await-transform (boolean (seq (class-lookup pc "await_transform")))})
        g (coro-promise-call c "get_return_object" [])
        rt (:ret (:ty f))
        gt (abi/unq (:ty g))
        gro (cond (abi/void? rt) {:k :void :e g}
                  (if (class-id gt) (= (class-id gt) (class-id rt)) (= gt (abi/unq rt))) {:k :eager :init (init-for rt g c :copy)}
                  :else (let [gid (next-id)]
                          (swap! *vars* assoc gid {:id gid :name "__coro_gro" :ty gt :storage :local :fn fid})
                          {:k :deferred :var gid :init (init-for gt g c :copy)
                           :ret (init-for rt {:op :var :id gid :ty gt :cat :xv} c :copy)}))
        init-aw (coro-await c (coro-promise-call c "initial_suspend" []) :initial)
        body (stmt c body-n)
        fall (when (seq (class-lookup pc "return_void")) {:s :expr :e (coro-promise-call c "return_void" [])})
        ue {:s :expr :e (coro-promise-call c "unhandled_exception" [])}
        fin-aw (coro-await c (coro-promise-call c "final_suspend" []) :final)]
    (upd-fn! fid assoc :coro {:promise prid :pinit pinit :copies copies :gro gro :this (boolean member)})
    {:s :block :items [{:s :expr :e init-aw}
                       {:s :try :body {:s :block :items (cond-> [body] fall (conj fall))} :handlers [{:body ue}]}
                       {:s :label :name "__coro_final" :body {:s :expr :e fin-aw}}]}))

(declare analyze-fn!*)

(defn analyze-fn!
  "Analyzes a function's body (and a constructor's mem-initializers) into :tbody."
  [fid]
  ;; (cpp-extfloat: a body analyzed while a requirement is (an instantiation it asks) is no requirement's expression)
  (if *cx-requirement* (binding [*cx-requirement* false] (analyze-fn!* fid)) (analyze-fn!* fid)))

(defn- analyze-fn!*
  [fid]
  (let [f (fnd fid)
        cls (:cls f)
        ;; a namespace member defined outside its namespace by a qualified name (`void std::terminate() { get_terminate(); }`,
        ;; libsupc++'s eh_terminate.cc): its body's names are looked up in the namespace, then the enclosing ones
        ;; ([basic.lookup.unqual]/4: the scopes of the declarations' target scope)
        home-ns (let [h (:scope f)] (when (and (not cls) (not (:keep-def-scope f)) h (= :ns (:kind h)) (= :ns (:kind (:def-scope f))) (not (identical? h (:def-scope f)))) h))
        fs (new-scope :fn (or home-ns (:def-scope f) (:scope f)) :internal (boolean (:internal f)))
        ;; a class or enumeration declared in the body is local to the function: its names mangle as Z <encoding> E ...
        ;; (abi's [:local f] path, as G2's closures have it)
        fs (assoc fs :path [[:local (select-keys f [:id :name :kind :cls :ty :cq :op :static :linkage :internal-l :internal :path :tinst :inline])]])
        ;; a member's body sees the class's members: its scope is the class's for lookups
        fs (if (and cls (not (:keep-def-scope f))) (assoc fs :parent (:scope (abi/cls cls))) fs)
        pids (vec (map-indexed (fn [i t]
                                 (let [id (next-id) nm (nth (:param-names f) i nil)
                                       ;; (cpp-rt-own4, the code generator: the parameter's top-level const, declare-fn!'s
                                       ;; :param-const, when the parameters are as many as the function's: floating_to_chars.cc's
                                       ;; `const optional<int> precision`, whose value() is the const& one, and `const int precision`
                                       ;; given to optional<int>(_Up&&) as const int&)
                                       t (if (and (= (count (:param-const f)) (count (:ps (:ty f)))) (nth (:param-const f) i false)
                                                  (not (abi/ref? t)) (not (checking?)))
                                           (assoc t :c true) t)]
                                   (swap! *vars* assoc id {:id id :name nm :ty t :storage :param :fn fid})
                                   (when nm (enter! fs nm {:e :var :id id}))
                                   id))
                               (:ps (:ty f))))
        ;; a function parameter pack's name stands for its parameters (CODEGEN.md G3)
        _ (doseq [[nm idxs] (:param-packs f)] (enter! fs nm {:e :varpack :ids (mapv #(nth pids %) idxs)}))
        this-t (when (and cls (not (:static f))) (abi/ptr (cond-> {:k :class :id cls} (:cq f) (assoc :c true))))
        cut (if cls (let [outer (loop [id cls] (let [c (abi/cls id) s (:outer c)] (if (= :class (:kind s)) (recur (:cls s)) c)))] Long/MAX_VALUE) (:pos f))
        ;; (CP290 (a): a generic lambda's call operator specialization: the lambda's captures, its init-captures' names,
        ;; and the names visible at the lambda, [temp.res])
        glam (when cls (:glam (abi/cls cls)))
        _ (when glam (doseq [[nm es] (:names glam) e es] (enter! fs nm e)))
        ctx (cond-> {:scope fs :fn-id fid :this-type this-t :statics (atom []) :saw-return (atom false)} glam (assoc :lambda glam))]
    (binding [*cutoff* (cond glam (long (:glam-cutoff (abi/cls cls))) cls Long/MAX_VALUE :else (max (long cut) (long (or (:_b (:body f)) 0))))
              *src* (or (:src f) *src*)]
      (let [trace (fn [g] (if (System/getenv "CPP_HDR_TRACE")
                            (try (g) (catch arbace.lang.ExceptionInfo e
                                       (binding [*out* *err*] (println "in the body of" (:name f) (pr-str (loc-of (get-in (:node f) [:range :begin]))) ":" (.getMessage e)))
                                       (throw e)))
                            (g)))
            ;; (queue 492, the checker: a refusal of a subobject's implicit initialization, which has no node of its own, at
            ;; the constructor's when it has no mem-initializer (GCC's place: `C4() {}`), not at the last node an earlier
            ;; function's analysis left, init/pr29043.C; with mem-initializers GCC's place is theirs, left as before)
            _ (when (and (checking?) *at* (= :ctor (:kind f)) (not (:implicit f)) (:range (:node f)) (empty? (:inits f)))
                (reset! *at* (:node f)))
            ;; (cpp-singles: with mem-initializers, GCC's place of such a refusal is the mem-initializer-list's last token, the
            ;; last mem-initializer's closing parenthesis or brace: a base initialized before any mem-initializer's expression is
            ;; analyzed had the last node of an earlier function, cpp0x/pr66443-cxx11.C's `C::C () : A( 1 )` over B's deleted
            ;; default constructor)
            _ (when (and (checking?) *at* (= :ctor (:kind f)) (not (:implicit f)) (seq (:inits f)))
                (let [r (some #(or (:range %) (:_range %)) (reverse (:inits f)))]
                  (when-let [e (:end r)]
                    (when (:offset e) (reset! *at* {:range {:begin e :end e}})))))
            inits (when (= :ctor (:kind f)) (when-not (:implicit f) (trace #(ctor-inits ctx f))))
            ;; (CP362 (a), the user 2026-11-11: a consteval constructor's body, which only checks (basic_format_string's runs
            ;; the format string's scanner at compile time), is not evaluated by the code generator: the immediate invocation
            ;; stores the mem-initializers' value, the program taken as valid, as clang and g++ accepted it)
            ;; (pending review 1111 #1, cpp-s5b: only a body that stores to no member; one that does is analyzed, the
            ;; constructor run when its immediate invocation is reached, its value the one clang folds)
            body (when (:body f) (cond (and (:consteval f) (= :ctor (:kind f)) (not (checking?)) (not (consteval-ctor-body-stores? cls (:body f))))
                                       {:s :block :items []}
                                       ;; (queue 393, W4: a coroutine's body, by the code generator; the checker's analysis as before)
                                       (and (not (checking?)) (coroutine-node? (:body f))) (trace #(coroutine-body ctx fid pids (:body f)))
                                       :else (trace #(stmt ctx (:body f)))))
            ;; (queue 499: a user-provided destructor destroying a subobject whose destructor is deleted, cx-user-dtor-subs!)
            _ (when body (cx-user-dtor-subs! f cls))
            ;; a constructor's or destructor's function-try-block: control reaching a handler's end rethrows the exception
            ;; ([except.handle]/15; clang's ExitCXXTryStmt, doImplicitRethrow); another function's handler falls through to its end
            ;; ([except.handle]/16). The mem-initializers stay before the try (cpp-90: an exception of theirs is not caught by the
            ;; handlers yet, clang's EmitConstructorBody enters the try before the prologue)
            body (if (and body (= "CXXTryStmt" (:kind (:body f))) (contains? #{:ctor :dtor} (:kind f)) (= :try (:s body)))
                   (update body :handlers (fn [hs] (mapv (fn [h] (update h :body (fn [b] {:s :block :items [b {:s :expr :e {:op :throw :ty abi/void :cat :pr}}]}))) hs)))
                   body)]
        (upd-fn! fid assoc :params pids :tbody body :tinits inits :nrvo (when body (nrvo-var body)) :statics @(:statics ctx))
        ;; (cpp-p2564: an immediate function's address in it, P2564's escalation or its error)
        (cx-addr-escalation! fid)
        ;; (a generic lambda's body with no return statement: void, [expr.prim.lambda.closure]/4's deduction)
        ;; (cpp-s3: any function's declared `auto` with no return statement in its body, [dcl.spec.auto.general]/10:
        ;; pr77550.C's `static auto construct(_Alloc, _Tp p2, _Args) { _S_construct(p2); }`)
        (when (or (and glam (has-auto? (:ret (:ty (fnd fid))))) (and body (= :auto (:k (:ret (:ty (fnd fid)))))))
          ;; (n-cpp-concepts: a constrained placeholder's void, [dcl.type.auto.deduct]/2, at the function's declaration)
          ;; (a body whose return statement the checker refused leaves the auto: not this case)
          (let [rt (:ret (:ty (fnd fid)))]
            (upd-fn! fid assoc-in [:ty :ret] abi/void)
            (when (and (= :auto (:k rt)) (not @(:saw-return ctx))) (placeholder-check! (:scope ctx) rt abi/void "return type" (:node f)))))
        ;; (cpp-rind, the checker: auto*, auto& or auto&& declared and no return statement: void deduces none of them,
        ;; [dcl.spec.auto.general]/10 with [dcl.type.auto.deduct]/4: GCC's "no return statements in function returning 'auto*'",
        ;; at the function; cpp1y/auto-fn38.C)
        (let [rt (:ret (:ty (fnd fid)))]
          (when (and (checking?) body *on-refusal* (#{:ptr :ref :rref} (:k rt)) (= :auto (:k (:to rt))) (not @(:saw-return ctx)) (:node f))
            (*on-refusal* (ex-info "codegen: no return statements in function returning a deduced pointer or reference" {:codegen/refused :deduce :cx/node (:node f)}) (:node f))))))))

(defn- defaulted-comparison!
  "A defaulted == or <=> ([class.compare.default], [class.eq], [class.spaceship]): the bases' and members' comparisons
  in order -- == their conjunction, <=> the first that is not equal (the common comparison category's, deduced for an
  auto return type) or equal."
  [fid]
  (let [f (fnd fid)
        ps (:ps (:ty f))
        member? (and (:cls f) (not (:static f)) (= 1 (count ps)))
        cls (if member? (:cls f) (class-id (abi/non-ref (first ps))))
        pids (vec (map-indexed (fn [i t] (let [id (next-id)] (swap! *vars* assoc id {:id id :name (str "__p" i) :ty t :storage :param :fn fid}) id)) ps))
        ctx {:scope (:scope (abi/cls cls)) :fn-id fid :this-type (when member? (abi/ptr (cond-> {:k :class :id cls} (:cq f) (assoc :c true)))) :statics (atom [])}
        a (if member? (deref-node (this-expr ctx)) (var-node (first pids)))
        b (var-node (last pids))
        c (abi/cls cls)
        subs (concat (for [bb (:bases c)] (with-meta [(subobject-lv a (:cls bb)) (subobject-lv b (:cls bb))] {::where (:cx-node c) ::what (:name (abi/cls (:cls bb)))}))
                     (for [fl (:fields c)] (with-meta [(field-node a cls (:i fl)) (field-node b cls (:i fl))] {::where (:node fl) ::what (str (:name c) "::" (:name fl))})))
        bin0 (fn [o x y] (or (when (or (class-operand? x) (class-operand? y)) (operator-call ctx o [x y]))
                             (let [x (class->scalar ctx x) y (class->scalar ctx y)]
                               ;; (cpp-sweep, the checker: no operator function and an operand of class type still, no conversion
                               ;; to a built-in operand: no match, sure)
                               (when (and (checking?) (or (class-operand? x) (class-operand? y)))
                                 (fail :nomatch "no match for 'operator" o "' (no operator function, no conversion)"))
                               (builtin-binop o x y))))
        ;; (cpp-sweep, the checker: [class.compare.default]/1 with [class.eq]/2 and [class.spaceship]/2, a subobject whose
        ;; comparison is surely not usable -- no operator found, no conversion -- defines the operator as deleted, each such
        ;; subobject GCC's explanation at it when the deleted operator is used ("no match for 'operator=='"), cx-cmp-explain;
        ;; a refusal the slice is unsure of propagates as before: cpp2a/spaceship-eq14.C, spaceship-synth-neg2.C)
        explain (atom [])
        synth (atom nil)
        sure-fail? (fn [x] (let [m (str (ex-message x))]
                             (and (checking?) (:codegen/refused (ex-data x)) (not (re-find #"unsure|:k :(auto|dep|tparam)" m))
                                  (re-find #"^codegen: (no match for 'operator|no viable function|cannot convert .* implicitly|no viable conversion|no operator|no conversion function of|ambiguous call)" m))))
        bin (fn [o x y & [sub]]
              (if-let [where (and (checking?) sub (::where (meta sub)))]
                (try (bin0 o x y)
                     (catch arbace.lang.ExceptionInfo ex
                       (when (System/getenv "CPP_CMP_TRACE") (binding [*out* *err*] (println "cmp sub failed:" (ex-message ex))))
                       (cond
                         (not (sure-fail? ex)) (throw ex)
                         ;; ([class.spaceship]/1: a declared comparison category return type synthesizes a missing <=> from ==
                         ;; and <, P1186R3: no failure unless one of them fails surely too; a synthesized one the slice does not
                         ;; build, the definition refused as before once no other subobject deletes it, synth)
                         (and (= "<=>" o) (not (re-find #"^codegen: ambiguous call" (str (ex-message ex))))
                              (let [r (abi/unq (abi/non-ref (:ret (:ty f))))]
                                (and (abi/class? r) (#{"partial_ordering" "weak_ordering" "strong_ordering"} (:name (abi/cls (:id r))))))
                              (not (some #(try (bin0 % x y) false (catch arbace.lang.ExceptionInfo ex2 (sure-fail? ex2))) ["==" "<"])))
                         (do (swap! synth #(or % ex)) nil)
                         :else (do (swap! explain conj {:msg (str "no match for 'operator" o "' (operand types are '" (::what (meta sub)) "')") :node where}) nil))))
                (bin0 o x y)))
        ;; (queue 510, the checker: a defaulted == or <=> defined as deleted, not refused, so a use of it is the error,
        ;; resolve-overload*'s CX12 rule: GCC's "use of deleted function" at the use)
        deleted! (fn [why] (upd-fn! fid assoc :deleted true :deleted-sure true :deleted-why why) fid)]
    (binding [*cutoff* Long/MAX_VALUE]
      (cond
        ;; (a flexible array member, GNU's extension: GCC's "cannot default compare flexible array member";
        ;; cpp2a/spaceship-synth-neg5.C)
        (and (checking?) (#{"==" "<=>"} (:op f)) (some #(and (not (:static %)) (abi/arr? (:ty %)) (nil? (:n (:ty %)))) (:fields c)))
        (deleted! "a flexible array member")
        :else
      (case (:op f)
        ;; (CP338 (a): a defaulted secondary comparison, [class.compare.secondary]/2: x @ y by its rewritten candidate alone,
        ;; != as !(x == y), a relational as (x <=> y) @ 0, the result converted to bool; it had been emitted unreachable)
        ("!=" "<" ">" "<=" ">=")
        (let [o (:op f)
              r (if (= "!=" o)
                  (when-let [c (operator-call ctx "==" [a b])] {:op :not :e (to-bool c) :ty abi/bool* :cat :pr})
                  (rewritten-relational ctx o [a b]))
              _ (when-not r (fail :overload "a defaulted operator" o " with no usable rewritten candidate"))]
          (upd-fn! fid assoc :params pids :tbody {:s :return :init {:i :expr :e (to-bool r)}}))
        "==" (let [ts (doall (for [[x y :as sub] subs] (bin "==" x y sub)))]
               (cond
                 ;; (cpp-sweep, the checker: [class.compare.default]/1, a defaulted == declared to return another type than
                 ;; bool is ill-formed (the parser's error at it) and taken as deleted, as GCC does: its use the error, the
                 ;; static_assert of cpp2a/spaceship-eq8.C)
                 (and (checking?) (not= :bool (abi/bn (abi/unq (:ret (:ty f))))) (not= :auto (:k (:ret (:ty f)))))
                 (deleted! "a defaulted == not returning bool")
                 :else
               (if (seq @explain)
                 (deleted! "a subobject's comparison not usable")
                 (let [e (reduce (fn [acc t] (let [t (to-bool t)] (if acc {:op :land :l acc :r t :ty abi/bool* :cat :pr} t))) nil ts)
                       e (or e {:op :int :v 1 :ty abi/bool* :cat :pr})]
                   (upd-fn! fid assoc :params pids :tbody {:s :return :init {:i :expr :e e}})))))
        "<=>" (let [cs (vec (for [[x y :as sub] subs] (bin "<=>" x y sub)))
                    declared0 (:ret (:ty f))
                    category? (fn [t] (let [t (abi/unq (abi/non-ref t))]
                                        (and (abi/class? t) (#{"partial_ordering" "weak_ordering" "strong_ordering"} (:name (abi/cls (:id t)))))))
                    ;; (cpp-sweep: a declared return type R neither auto nor a comparison category type: each subobject's x <=> y
                    ;; static_cast to R, [class.spaceship]/1's synthesized three-way comparison of type R; one that does not
                    ;; convert, or a subobject with no usable <=> at all, deletes the operator, GCC's "invalid 'static_cast'" at
                    ;; the declaration beside the subobject's: cpp2a/spaceship-err6.C, spaceship-synth-neg6.C, spaceship-synth17.C)
                    _ (when (and (checking?) (not= :auto (:k declared0)) (not (category? declared0)) (:node f))
                        (doseq [[x sub] (map vector cs subs) :when x]
                          (when (category? (:ty x))
                            (when-not (try (init-for (abi/unq declared0) [x] ctx :copy) true
                                           (catch arbace.lang.ExceptionInfo ex
                                             (when (System/getenv "CPP_CMP_TRACE") (binding [*out* *err*] (println "cmp conv failed:" (ex-message ex))))
                                             (if (sure-fail? ex) false (throw ex))))
                              (swap! explain conj {:msg (str "three-way comparison of '" (::what (meta sub)) "' does not convert to the declared return type") :node (::where (meta sub))}))))
                        ;; (and the all-equal result, static_cast<R>(std::strong_ordering::equal), which converts to no scalar
                        ;; type: an R of scalar type deletes the operator whatever its subobjects, GCC's "invalid 'static_cast'"
                        ;; at it: cpp2a/spaceship-synth-neg7.C's B and C)
                        (when (or (seq @explain) (abi/scalar? (abi/unq (abi/non-ref declared0))))
                          (swap! explain conj {:msg "invalid 'static_cast' to the declared return type" :node (:node f)})))
                    ;; (cpp-sweep: a declared comparison category type: a subobject's three-way comparison of a weaker category
                    ;; does not convert to it ([cmp.categories]: strong to weak to partial alone), the operator deleted, GCC's
                    ;; error at the subobject: cpp2a/spaceship-p1186.C's F over E's partial_ordering)
                    _ (when (and (checking?) (category? declared0))
                        (let [rank {"partial_ordering" 0 "weak_ordering" 1 "strong_ordering" 2}
                              rn (fn [t] (rank (:name (abi/cls (:id (abi/unq (abi/non-ref t)))))))]
                          (doseq [[x sub] (map vector cs subs) :when (and x (category? (:ty x)) (::where (meta sub)))]
                            (when (< (long (rn (:ty x))) (long (rn declared0)))
                              (swap! explain conj {:msg (str "three-way comparison of '" (::what (meta sub)) "' does not convert to the declared return type") :node (::where (meta sub))})))))
                    nm (fn [t] (:name (abi/cls (class-id t))))
                    declared (:ret (:ty f))
                    ;; (queue 510, the checker: an auto return type and a subobject whose three-way comparison's type is no
                    ;; comparison category type -- a scalar, or a class not <compare>'s -- is defined as deleted,
                    ;; [class.spaceship]/2 (P2002): cpp2a/spaceship-synth-neg4.C's `bool operator<=>`)
                    bad (when (and (checking?) (= :auto (:k declared)))
                          (some (fn [x] (let [t (abi/unq (abi/non-ref (:ty x)))]
                                          (or (abi/scalar? t)
                                              (and (abi/class? t)
                                                   (not (#{"partial_ordering" "weak_ordering" "strong_ordering"} (nm t)))))))
                                (remove nil? cs)))]
                (cond
                  (seq @explain) (deleted! "a subobject's three-way comparison not usable")
                  @synth (throw @synth)
                  bad
                  (deleted! "a subobject's three-way comparison of no comparison category type")
                  :else
                (let [rt (if (= :auto (:k declared))
                         (ordering-type (cond (some #(= "partial_ordering" (nm (:ty %))) cs) "partial_ordering"
                                              (some #(= "weak_ordering" (nm (:ty %))) cs) "weak_ordering"
                                              :else "strong_ordering"))
                         (abi/unq declared))
                    zero {:op :int :v 0 :ty abi/int* :cat :pr}
                    as-rt (fn [x] (if (= (class-id (:ty x)) (class-id rt)) x {:op :temp-obj :init (init-for rt [x] ctx :copy) :ty rt :cat :pr}))
                    e (reduce (fn [acc x] {:op :cond :c (to-bool (bin "!=" x zero)) :then (as-rt x) :else acc :ty rt :cat :pr})
                              {:op :ord :v 0 :ty rt :cat :pr} (reverse cs))]
                (upd-fn! fid #(-> % (assoc-in [:ty :ret] rt) (assoc :params pids :tbody {:s :return :init {:i :expr :e e}})))))))))
    (when (seq @explain) (upd-fn! fid assoc :cx-cmp-explain @explain))
    fid))

(defn- analyze-implicit*!
  "An implicit (or defaulted) special member's definition: params and, for a default constructor, the members'
  initializers."
  [fid]
  (if (or (#{"==" "<=>"} (:op (fnd fid))) (and (:defaulted (fnd fid)) (#{"!=" "<" ">" "<=" ">="} (:op (fnd fid)))))
    (defaulted-comparison! fid)
  (do (let [f (fnd fid)
        cls (:cls f)
        fs (new-scope :fn (:scope (abi/cls cls)))
        pids (vec (map-indexed (fn [i t] (let [id (next-id)] (swap! *vars* assoc id {:id id :name (str "__p" i) :ty t :storage :param :fn fid}) id)) (:ps (:ty f))))
        ctx {:scope fs :fn-id fid :this-type (abi/ptr {:k :class :id cls}) :statics (atom [])}
        f (assoc f :params pids)]
    (swap! *fns* assoc fid f)
    ;; (CP330 (a): an inheriting constructor, [class.inhctor.init]/1: the base subobject by the inherited constructor, the
    ;; parameters forwarded (static_cast<T&&>(p): an lvalue reference's an lvalue, else an xvalue); the rest as an implicit
    ;; default constructor initializes them)
    (if-let [bfid (:inh-from f)]
      (let [b (fnd bfid)
            args (mapv (fn [pid] (let [n (var-node pid)] (if (= :ref (:k (:ty (var* pid)))) n (assoc n :cat :xv)))) pids)
            bi {:i :ctor :fn bfid :args (call-args b args ctx)}]
        (binding [*cutoff* Long/MAX_VALUE]
          (upd-fn! fid assoc :tinits (ctor-inits ctx (assoc f :inits [] :pre-inits {(:inh-base f) bi})))))
    (do
    ;; (queue 499: a subobject's deleted or inaccessible destructor, cx-sub-dtor!)
    (cx-sub-dtor! f cls)
    ;; (cpp-decl2, the checker: an implicit copy or move constructor or assignment operator ([class.copy.ctor]/10,
    ;; [class.copy.assign]/7) is deleted when a subobject's overload resolution surely finds nothing viable: the subobject's class
    ;; (a base, or a member of class type or an array of it) declares only copy constructors (assignment operators) whose
    ;; parameter is a non-const lvalue reference, and the source is const (a const member, or the copy's `const X&`) or an rvalue
    ;; (a move); GCC's "no matching function for call to 'G::G(const G&)'" or "cannot bind non-const lvalue reference" at the
    ;; class where it is implicitly defined: init/synth2.C, cpp0x/pr71979.C's B::operator=(B&&) over A::operator=(A&))
    (when (and (checking?) (or (:implicit f) (and (:defaulted f) (not (:ool-defaulted f)) (:node f))) (#{:ctor :method} (:kind f))
               (not (:inh-from f)) (= 1 (count (:ps (:ty f))))
               (or (= :ctor (:kind f)) (= "operator=" (:name f)))
               (#{:ref :rref} (:k (first (:ps (:ty f))))))
      (let [c (abi/cls cls)
            p0 (first (:ps (:ty f)))
            move? (= :rref (:k p0))
            pc (:c (:to p0))
            assign? (= "operator=" (:name f))]
        (when (and (not (:union c)) (string? (:name c)) (:cx-node c) (not (header-node? (:cx-node c))))
          (doseq [[sid const?] (concat (for [b (:bases c) :when (not (:virtual b))] [(:cls b) pc])
                                       (for [fl (remove :static (:fields c))
                                             :let [t (loop [t (:ty fl)] (if (abi/arr? t) (recur (:of t)) t)) u (abi/unq t)]
                                             :when (and (abi/class? u) (not (abi/ref? (:ty fl))) (not (:anon fl)) (string? (:name fl)))]
                                         [(:id u) (or pc (:c t))]))
                  :when (or move? const?)
                  :let [m (abi/cls sid)
                        cands (if assign?
                                (filter #(let [g (fnd %)] (and (= "operator=" (:name g)) (= 1 (count (:ps (:ty g)))) (not (:deleted g)))) (:methods m))
                                (filter #(let [g (fnd %)] (and (= 1 (- (count (:ps (:ty g))) (count (filter some? (:defaults g))))) (not (:deleted g)))) (:ctors m)))]
                  :when (and m (:complete m) (not (:tmpl m)) (not (:header m)) (empty? (:ctor-tmpls m)) (empty? (:inherits-ctors m))
                             (or (not assign?) (empty? (:conv-tmpls m)))
                             (seq cands)
                             ;; (each candidate's parameter a reference to M the source cannot bind: a non-const lvalue reference
                             ;; for an rvalue or a const source, a non-const rvalue reference for an lvalue or a const source)
                             (every? #(let [g (fnd %) q (first (:ps (:ty g)))]
                                        (and (#{:ref :rref} (:k q)) (= sid (class-id (:to q))) (not (:c (:to q)))
                                             (or const? (if (= :ref (:k q)) move? (not move?)))))
                                     cands))]
            (throw (ex-info (str "codegen: call to a deleted function " (:name m) (if assign? "::operator=" "")
                                 " (no " (if assign? "assignment operator" "constructor") " of " (:name m) " takes "
                                 (if const? "a const " "an ") (if move? "rvalue" "lvalue") ")")
                            {:codegen/refused :overload :cx-defaulted-delete (boolean (:defaulted f))}))))))
    ;; (cpp-decl2, the checker: a union's implicit default constructor, copy or move constructor or destructor is deleted when a
    ;; variant member's corresponding one is non-trivial (the default constructor: no variant member with a default member
    ;; initializer), [class.default.ctor]/2.1, [class.copy.ctor]/10.1, [class.dtor]/7.1: GCC's "union member 'U::g' with
    ;; non-trivial 'G::G()'" at the member, cx-deleted-implicit!; cpp0x/defaulted2.C, cpp0x/union1.C)
    (when (and (checking?) (:implicit f) (#{:ctor :dtor} (:kind f)) (not (:inh-from f)))
      (let [c (abi/cls cls)
            k (cond (= :dtor (:kind f)) :dtor (empty? (:ps (:ty f))) :default (= 1 (count (:ps (:ty f)))) :copy)]
        ;; (a union-like class's variant members too, an anonymous union member's, [class.union.anon]/? with
        ;; [class.default.ctor]/2.1: cpp0x/union1.C's C over union { A a; })
        (doseq [[c' cid'] (cond (and (:union c) (string? (:name c)) (seq (:name c))) [[c cls]]
                                (and (not (:union c)) (string? (:name c))) (for [fl (:fields c) :when (:anon fl)
                                                                                 :let [ac (abi/cls-of (:ty fl))] :when (and ac (:union ac))]
                                                                             [ac nil])
                                :else nil)
                :let [c c']]
        (when (and k (:union c) (not (header-node? (:cx-node (abi/cls cls)))) (or cid' (not (header-node? (:node (first (:fields c))))))
                   (not (and (= k :default) (some :init (:fields c)))))
          (doseq [fl (remove :static (:fields c))
                  :let [t (abi/unq (loop [t (:ty fl)] (if (abi/arr? t) (recur (:of t)) t)))]
                  :when (and (abi/class? t) (not (abi/ref? (:ty fl))) (string? (:name fl)) (:node fl)
                             (case k
                               ;; (a member whose default constructor is deleted or missing is the rule below's, at the union)
                               :default (and (default-ctor-nontrivial? (:id t))
                                             (let [zs (filter #(empty? (:ps (:ty (fnd %)))) (:ctors (abi/cls (:id t))))]
                                               (and (seq zs) (not-any? #(:deleted (fnd %)) zs))))
                               :copy (not (trivial-copy? (:id t)))
                               :dtor (not (trivial-dtor? (:id t)))))]
            (throw (ex-info (str "codegen: call to a deleted function " (:name fl) " (a union member with a non-trivial "
                                 (case k :default "default constructor" :copy "copy constructor" :dtor "destructor") ")")
                            {:codegen/refused :overload :cx-union-node (:node fl)})))))))
    ;; (queue 492, the checker: a defaulted default, copy or move constructor is deleted when a potentially constructed
    ;; subobject's destructor is deleted, [class.default.ctor]/2.7, [class.copy.ctor]/10.4: the subobject's deleted
    ;; destructor, as a deleted call, the member's deletion)
    (when (and (checking?) (= :ctor (:kind f)) (:implicit f))
      (let [c (abi/cls cls)
            subs (concat (map :cls (:bases c))
                         (keep (fn [fl] (let [t (abi/unq (loop [t (:ty fl)] (if (abi/arr? t) (recur (:of t)) t)))] (when (abi/class? t) (:id t))))
                               (remove :static (:fields c))))]
        (doseq [sc subs :when sc
                :let [d (some-> (abi/cls sc) :dtor fnd)]
                :when (and d (:deleted d) (:deleted-sure d))]
          (fail :overload "call to a deleted function ~" (:name (abi/cls sc))))
        ;; (a default constructor, deleted for a reference member or a const member of a type that is no class, with no
        ;; default member initializer, [class.default.ctor]/2.2-2.3 (an anonymous union's members aside): the member,
        ;; as cx-deleted-implicit! reports it at the class, GCC's "uninitialized const member in 'class bar'")
        ;; (cpp-decl2: a union all of whose variant members are of const-qualified type, or arrays of them, none with a
        ;; default member initializer, [class.default.ctor]/2.3 of C++20 (/2.4 of C++11): GCC's "uninitialized const
        ;; member in 'union U'" at the union, init/pr25811.C, init/pr43719.C)
        (when (and (empty? (:ps (:ty f))) (:union c) (string? (:name c)) (seq (:name c)))
          (let [fls (filter #(and (not (:static %)) (string? (:name %)) (seq (:name %)) (:ty %)) (:fields c))]
            (when (and (seq fls) (not-any? :init fls)
                       (every? #(let [t (loop [t (:ty %)] (if (abi/arr? t) (recur (:of t)) t))] (and (not (abi/ref? t)) (:c t))) fls))
              (fail :overload "call to a deleted function " (:name (first fls))))))
        (when (and (empty? (:ps (:ty f))) (not (:union c)))
          (doseq [fl (:fields c)
                  :when (and (not (:static fl)) (not (:init fl)) (string? (:name fl)) (seq (:name fl)) (:ty fl)
                             (or (abi/ref? (:ty fl)) (and (:c (:ty fl)) (abi/scalar? (abi/unq (:ty fl))))))]
            (fail :overload "call to a deleted function " (:name fl))))
        ;; (a union's default constructor, deleted when a variant member's default constructor is, no member having a
        ;; default member initializer, [class.default.ctor]/2.1-2.4: the union's members are not initialized by the
        ;; analysis below)
        (when (and (:union c) (empty? (:ps (:ty f))) (not-any? :init (:fields c)))
          (doseq [fl (remove :static (:fields c))
                  :let [t (abi/unq (:ty fl))]
                  :when (abi/class? t)
                  :let [dc (some (fn [cid] (let [g (fnd cid)] (when (and (empty? (:ps (:ty g))) (:deleted g) (:deleted-sure g)) g))) (:ctors (abi/cls (:id t))))]
                  :when dc]
            (fail :overload "call to a deleted function " (:name (abi/cls (:id t))))))))
    (when (and (= :ctor (:kind f)) (empty? (:ps (:ty f))))
      (binding [*cutoff* Long/MAX_VALUE] (upd-fn! fid assoc :tinits (ctor-inits ctx (assoc f :inits [])))))
    (when (= :ctor (:kind f))
      (when (= 1 (count (:ps (:ty f))))
        ;; the implicit copy: each base and member copied from the source's
        (let [src (var-node (first pids))
              src {:op :deref :e {:op :load :e {:op :var :id (first pids) :ty (first (:ps (:ty f))) :cat :lv :raw true} :ty (abi/ptr (:to (first (:ps (:ty f))))) :cat :pr} :ty (:to (first (:ps (:ty f)))) :cat (if (and (or (checking?) (:defaulted f) (:cx-move f)) (= :rref (:k (first (:ps (:ty f)))))) :xv :lv)}
              ;; (queue 392: a defaulted move constructor's source an xvalue in the code generator's mode too, as the move
              ;; assignment's below: its bases and members moved, cow-stdexcept.cc's `logic_error(logic_error&&) noexcept =
              ;; default` by exception(exception&&), clang's _ZNSt9exceptionC2EOS_)
              c (abi/cls cls)]
          (binding [*cutoff* Long/MAX_VALUE]
            (upd-fn! fid assoc :tinits
                     {:bases (vec (for [[i b] (map-indexed vector (:bases c)) :when (not (:virtual b))]
                                    {:base (:cls b) :idx i :init (init-for {:k :class :id (:cls b)} [(subobject-lv src (:cls b))] ctx :direct)}))
                      :vbases (vec (for [v (abi/vbases-init cls)] {:base v :init (init-for {:k :class :id v} [(subobject-lv src v)] ctx :direct)}))
                      :fields (vec (for [fl (:fields c)]
                                     {:field (:i fl) :init (let [t (:ty fl)]
                                                             (if (abi/arr? t) {:i :copy-bytes :e (field-node src cls (:i fl))}
                                                                 (init-for t [(field-node src cls (:i fl))] ctx :direct)))}))})))))
    (when (and (= :method (:kind f)) (= "=" (:op f)))
      ;; (a defaulted move assignment's source an xvalue in the code generator's mode too, its members moved:
      ;; explicit-obj-default2.C, cpp-s3)
      (let [src {:op :deref :e {:op :load :e {:op :var :id (first pids) :ty (first (:ps (:ty f))) :cat :lv :raw true} :ty (abi/ptr (:to (first (:ps (:ty f))))) :cat :pr} :ty (:to (first (:ps (:ty f)))) :cat (if (and (or (checking?) (:defaulted f) (:cx-move f)) (= :rref (:k (first (:ps (:ty f)))))) :xv :lv)}
            me (deref-node (this-expr ctx))
            c (abi/cls cls)]
        (binding [*cutoff* Long/MAX_VALUE]
          (upd-fn! fid assoc :tassign
                   (vec (concat (for [b (:bases c)] (full (assign-node ctx (subobject-lv me (:cls b)) (subobject-lv src (:cls b)))))
                                (for [fl (:fields c)]
                                  (if (abi/arr? (:ty fl))
                                    {:s :copy-bytes :dst (field-node me cls (:i fl)) :src (field-node src cls (:i fl))}
                                    (full (assign-node ctx (field-node me cls (:i fl)) (field-node src cls (:i fl)))))))))))))))
  fid)))

;; ---------------------------------------------------------------------------------------------
;; The program

;; (cpp-singles, the checker: an implicit copy constructor ([class.copy.ctor]/10.2) whose subobject's constructor, chosen by
;; overload resolution from the copy's source, is inaccessible from the class is deleted surely, so that its use is GCC's "use of
;; deleted function" and its reason, the access error, is reported at the class where it is implicitly defined ("'A::A(T&) [with
;; T = A]' is private within this context" on the class's line, cpp0x/implicit-trivial1.C). The move constructor stays queue 509's
;; unsure deletion (a deleted defaulted move constructor is no candidate, [class.copy.ctor]/10), as do the assignments and the
;; default constructor; a class of a header, a template's specialization or a closure not judged.
(defn- cx-access-deleted?
  [id e]
  (let [f (fnd id) c (abi/cls (:cls f)) p0 (first (:ps (:ty f)))]
    (boolean (and (checking?) (:implicit f) (= :access (:codegen/refused (ex-data e))) (= :ctor (:kind f)) (not (:cx-move f))
                  (= 1 (count (:ps (:ty f)))) (= :ref (:k p0)) (= (:cls f) (class-id (:to p0)))
                  (string? (:name c)) (:cx-node c) (not (header-node? (:cx-node c))) (not (:header c)) (not (:targs c)) (not (:lambda c))
                  (re-find #"^codegen: '[^']+' is a (private|protected) member of " (str (.getMessage e)))))))

(defn analyze-implicit!
  "An implicit (or defaulted) special member's definition (analyze-implicit*!); a deleted call in it is the member's
  deletion, no use of the deleted function (queue 463: cx-deleted-implicit! reports at a use only)."
  [fid]
  (binding [*cx-in-implicit* true] (analyze-implicit*! fid))
  (cx-addr-escalation! fid))

(defn- immediate-address
  "CP310 (b): the immediate function whose address the typed expression `e` is (a pointer to it, a pointer to member
  function of it, through no-op conversions), or nil."
  [e]
  (case (:op e)
    (:fnaddr :mptr-fn) (when-let [f (some-> (:fn e) fnd)] (when (:consteval f) f))
    :cast (when (= :noop (:ck e)) (immediate-address (:e e)))
    nil))

(defn- returned-immediate
  "CP310 (b): an immediate function the function `fid`'s return statements return the address of, or nil (its body as
  analyzed)."
  [fid]
  (let [f (fnd fid)
        ;; (cpp-sweep: also an address among a returned braced list's or class object's initializers, `return { 5, foo };`,
        ;; [expr.const]/18's constituent values: cpp2a/consteval7.C's baz)
        in-init (fn [i] (some (fn [y] (when (map? y) (or (when (= :expr (:i y)) (immediate-address (:e y))) (immediate-address y))))
                              (tree-seq #(or (map? %) (vector? %)) #(if (map? %) (vals (select-keys % [:items :args :init :e :then :fill])) (seq %)) i)))]
    (some (fn [x] (when (and (map? x) (= :return (:s x)))
                    (if (= :expr (get-in x [:init :i])) (immediate-address (get-in x [:init :e])) (in-init (:init x)))))
          (tree-seq #(or (map? %) (vector? %)) #(if (map? %) (vals (select-keys % [:items :then :else :body :init :s])) (seq %)) (:tbody f)))))

(defn- cx-sure-error!
  "h-cpp-consteval (the checker): the evaluation of the constexpr or constinit variable `v`'s initializer threw `x`; when sure,
  the variable marked not usable (:cx-bad) and the error thrown: a constexpr variable's at the operation (gcc's place, the
  variable's line its note), a constinit one's at the variable (\"does not have a constant initializer\") with the operation's
  own error beside it."
  [v x]
  (let [d (ex-data x)]
    (when (:cx/sure d)
      (when (:id v) (upd-var! (:id v) assoc :cx-bad true))
      (let [m (subs (str (.getMessage ^Throwable x)) (count "not a constant: "))]
        (if (:cx-constinit v)
          ;; (cpp-singles: a call of a function not constexpr that the initializer makes implicitly -- a converting constructor
          ;; of the temporary a reference binds, `constinit const nonliteral &r5 = 42;` --, which has no place of its own: at the
          ;; initializer, as GCC: cpp2a/constinit11.C)
          (do (when-let [p (or (:cx/at d) (:cx/top d) (when (str/starts-with? m "call to non-'constexpr' function") (:cx-init-range v)))]
                (when-let [h *on-refusal*]
                  (h (ex-info (str "codegen: expression is not a constant expression (" m ")") {:codegen/refused :constexpr :cx/node {:range p}}) nil)))
              (throw (ex-info (str "codegen: constinit variable '" (:name v) "' does not have a constant initializer (" m ")")
                              {:codegen/refused :constexpr :cx/node {:range (:cx-range v)}})))
          (do
            ;; (the variable's own line too, GCC's "in 'constexpr' expansion of" there, an error where the evaluation's
            ;; failure is the variable's: cpp23/constexpr-nonlit6.C)
            (when (and (:cx/at d) (:cx/pce d) (:cx-range v))
              (when-let [h *on-refusal*]
                (h (ex-info (str "codegen: constexpr variable '" (:name v) "' must be initialized by a constant expression (" m ")")
                            {:codegen/refused :constexpr :cx/node {:range (:cx-range v)}}) nil)))
            ;; (cpp-sweep: since C++23 a call of a function failing the potential constant check is GCC's "called in a constant
            ;; expression" error at the call alone, the function's own construct a -Winvalid-constexpr warning:
            ;; cpp23/constexpr-nonlit13.C)
            (throw (ex-info (str "codegen: constexpr variable '" (:name v) "' must be initialized by a constant expression (" m ")")
                            {:codegen/refused :constexpr :cx/node {:range (or (when-not (and (:cx/pce d) (>= (long *cxx-year*) 23) *invalid-constexpr-warned*) (:cx/at d)) (:cx-range v))}}))))))))

(defn- cx-indeterminate-member
  "cpp-sweep (the checker): the name of a scalar non-static data member of the evaluated object `o` (a class's value, its
  bases' and class members' values in it) that holds no value, or nil; a union's, an empty or anonymous member's not judged."
  [o]
  (when-let [c (abi/cls (::cls o))]
    (when-not (:union c)
      (or (some (fn [fl]
                  (when (and (not (:static fl)) (string? (:name fl)) (seq (:name fl)) (not (:anon fl)) (not (abi/ref? (:ty fl))))
                    (let [t (abi/unq (:ty fl)) x (get o (:i fl))]
                      (cond (abi/scalar? t) (when (nil? x) (str (:name c) "::" (:name fl)))
                            (and (abi/class? t) (map? x) (::cls x)) (cx-indeterminate-member x)
                            :else nil))))
                (:fields c))
          (some (fn [b] (let [x (get o [:b (:cls b)])] (when (and (map? x) (::cls x)) (cx-indeterminate-member x)))) (:bases c))))))

(defn cx-check-constant!
  "CX12 (the checker): a constexpr variable's scalar initializer `i` evaluated ([dcl.constexpr]/10: a constant
  expression); an evaluation the program's own operation makes not constant (ub!) diagnosed at that operation, clang's
  err_constexpr_var_requires_const_init. An evaluation the slice cannot do judges nothing.
  CP310 (b), [expr.const]/16-18: the result of a manifestly constant-evaluated initializer is no pointer to an immediate
  function (a permitted result's constituent values do not refer to one): the initializer the address itself (g++'s
  \"constant evaluation returns address of immediate function\") or an immediate invocation that returns one (\"immediate
  evaluation returns ...\", its callee's return statement the address), at the variable."
  [v i]
  ;; (cpp-sweep: [dcl.constexpr]/10 (C++11-C++23 /6-/9), a constexpr variable's type a literal type: GCC's "the type 'const T'
  ;; of 'constexpr' variable 'v' is not literal", at the variable; its initializer's evaluation still judged, as its errors are
  ;; GCC's too: cpp0x/constexpr-diag3.C's obj)
  (when-let [why (and (checking?) *on-refusal* (:cx-constexpr v) (not (abi/ref? (:ty v))) (cx-non-literal (:ty v)))]
    (when (:id v) (upd-var! (:id v) assoc :cx-bad true))
    (*on-refusal* (ex-info (str "codegen: the type of 'constexpr' variable '" (:name v) "' is not literal (" why ")")
                           {:codegen/refused :constexpr :cx/node {:range (:cx-range v)}})
                  nil))
  (when (and (checking?) (:cx-constexpr v) (#{:expr :copy} (:i i)))
    (let [e (:e i)
          imm (immediate-address e)
          inv (when (and (nil? imm) (= :call (:op e)) (:consteval (fnd (:fn e)))) (returned-immediate (:fn e)))]
      (when (or imm inv)
        (throw (ex-info (str "codegen: constexpr variable '" (:name v) "' must be initialized by a constant expression ("
                             (if imm "constant" "immediate") " evaluation returns address of immediate function '" (:name (or imm inv)) "')")
                        {:codegen/refused :constexpr :cx/node {:range (:cx-range v)}})))))
  ;; (cpp-sweep: [expr.const]/13, a reference variable of thread storage duration bound to a temporary, which shares its
  ;; storage: no constant initializer, the address of an object of thread storage duration no permitted result:
  ;; cpp2a/constinit5.C's T::r2)
  (when (and (checking?) (or (:cx-constexpr v) (:cx-constinit v)) (:tls v) (abi/ref? (:ty v)) (= :bind-temp (:i i)))
    (cx-sure-error! v (ex-info "not a constant: a reference of thread storage duration bound to a temporary" {:codegen/not-constant true :cx/sure true})))
  ;; (cpp-sweep: a reference variable's initializer too, [expr.const]/13-14: its referent's glvalue, or the temporary it binds,
  ;; evaluated -- a call of a function not constexpr, a temporary of non-literal type, surely no constant -- and a reference of
  ;; static storage duration bound to an automatic variable, no permitted result: cpp2a/constinit11.C's r3, r5, r6 and l)
  (when (and (checking?) (or (:cx-constexpr v) (:cx-constinit v)) (abi/ref? (:ty v)) (#{:bind :bind-temp} (:i i)))
    (when (and (= :bind (:i i)) (= :var (:op (:e i))) (not= :local (:storage v)) (not= :param (:storage v)))
      (let [w (var* (:id (:e i)))]
        (when (and (#{:local :param} (:storage w)) (not (abi/ref? (:ty w))))
          (cx-sure-error! v (ex-info (str "not a constant: '" (:name w) "' is not a constant expression (a reference to an automatic variable)")
                                     {:codegen/not-constant true :cx/sure true :cx/at (:cx-at (:e i))})))))
    (try (binding [*ce-manifest* true *ce-point* (:cx-range v) *ce-steps* (atom 0) *ce-wide* true *ce-const* (atom #{}) *ce-pos* (atom nil) *ce-dead* (atom #{}) *ce-temps* (atom [])]
           (ce-init (:ty v) i {}))
         (catch arbace.lang.ExceptionInfo x (cx-sure-error! v x))))
  ;; (cpp-vec: and a GNU vector's, cpp1y/pr68180.C's `constexpr float32x4_t v = fill(1.f);`)
  (when (and (checking?) (or (:cx-constexpr v) (:cx-constinit v)) (= :expr (:i i)) (or (abi/scalar? (abi/unq (:ty v))) (= :vec (:k (abi/unq (:ty v))))))
    (try (binding [*ce-manifest* true *ce-point* (:cx-range v)] (ce-eval (:e i)))
         (catch arbace.lang.ExceptionInfo x (cx-sure-error! v x))))
  ;; (h-cpp-consteval: a class object's initializer too, its constructor's evaluation: [dcl.constexpr]/10's full-expression)
  (when (and (checking?) (or (:cx-constexpr v) (:cx-constinit v)) (#{:ctor :zero-then :list :copy :expr} (:i i))
             (not (abi/ref? (:ty v))) (abi/class? (abi/unq (:ty v))))
    (try (binding [*ce-manifest* true *ce-point* (:cx-range v) *ce-steps* (atom 0) *ce-wide* true *ce-const* (atom #{}) *ce-pos* (atom nil) *ce-dead* (atom #{}) *ce-temps* (atom [])]
           (let [o (ce-init (:ty v) i {})]
             ;; (cpp-sweep: [expr.const]/13-14, a constant expression's object has no indeterminate subobject: a scalar member
             ;; of a non-union class a constexpr constructor left uninitialized makes the variable's initializer no constant
             ;; expression, GCC's error at the variable; cpp2a/constexpr-init1.C's s2)
             (when-let [m (and (map? o) (cx-indeterminate-member o))]
               ;; (queue 567: before C++20, [dcl.constexpr]/4.5 with /6 of C++17: a class template's specialization whose constexpr
               ;; constructor leaves the member uninitialized is still constexpr but no call of it is a constant expression; GCC
               ;; explains the variable's error by the rule's own error at the constructor's body, as cx-ctor-c17-inits! gives it
               ;; for a plain class: cpp0x/constexpr-template2.C)
               (let [f (when (= :ctor (:i i)) (fnd (:fn i)))
                     body (some #(when (= "CompoundStmt" (:kind %)) %) (:inner (:node f)))]
                 (when (and f *on-refusal* (< (long *cxx-year*) 20) (or (:tinst f) (and (:cls f) (not (cx-plain-class? (:cls f))))) (:constexpr f) (= :ctor (:kind f)) (not (:delegate (:tinits f)))
                            body (not (header-node? body)))
                   (*on-refusal* (ex-info (str "codegen: member '" m "' must be initialized by mem-initializer in 'constexpr' constructor")
                                          {:codegen/refused :constexpr :cx/node body})
                                 body)))
               (throw (ex-info (str "not a constant: the member '" m "' is not initialized") {:codegen/not-constant true :cx/sure true})))
             ;; (cpp-sweep: [expr.const]/13, the object's value holds no pointer to a temporary of its initializer, which dies at
             ;; the full-expression's end: before C++17 `constexpr A b = A();` copies the temporary's `this`, GCC's error at the
             ;; variable; cpp0x/constexpr-ctor14a.C)
             (when (and (map? o) *ce-temps*
                        (or (seq @*ce-temps*)
                            ;; (before C++17 a copy-initialization from a prvalue of the class copies a temporary, the object
                            ;; the evaluation built for it: its cell a temporary's too)
                            (and (< (long *cxx-year*) 17) (= :expr (:i i)) (= :temp-obj (:op (:e i))) (::from (meta o)))))
               (let [temps (java.util.IdentityHashMap.)]
                 (doseq [c @*ce-temps*] (.put temps c true))
                 (when (and (< (long *cxx-year*) 17) (= :expr (:i i)) (= :temp-obj (:op (:e i))) (::from (meta o)))
                   (.put temps (::from (meta o)) true))
                 (when (some #(and (ce-loc? %) (.containsKey temps (::cell (ce-res %))))
                             (tree-seq #(and (map? %) (not (ce-loc? %))) vals o))
                   (throw (ex-info "not a constant: a pointer to a temporary in a constexpr variable's value" {:codegen/not-constant true :cx/sure true})))))
             ;; (cpp-sweep: a constexpr variable's constant destruction, [expr.const]/7 of C++20: its destructor evaluated as
             ;; at its end, ce-destroy-cells!: cpp2a/constexpr-dtor3.C's W1 whose ~W1 meets inline assembly)
             (when (and (:cx-constexpr v) (map? o) (not (cx-non-literal (:ty v)))) (ce-destroy-cells! [(atom o)]))))
         (catch arbace.lang.ExceptionInfo x (cx-sure-error! v x))))
  ;; (cpp-sweep: an array of class objects with non-trivial destructors likewise, its elements destroyed in reverse order,
  ;; [class.dtor]/14 with [expr.const]/7: cpp2a/constexpr-dtor3.C's W2 w5[3])
  (when (and (checking?) (:cx-constexpr v) (>= (long *cxx-year*) 20) (= :list (:i i)) (abi/arr? (abi/unq (:ty v)))
             (let [et (abi/unq (:of (abi/unq (:ty v))))] (and (abi/class? et) (not (trivial-dtor? (:id et))))))
    (try (binding [*ce-manifest* true *ce-point* (:cx-range v) *ce-steps* (atom 0) *ce-wide* true *ce-const* (atom #{}) *ce-pos* (atom nil) *ce-dead* (atom #{}) *ce-temps* (atom [])]
           (let [o (ce-init (:ty v) i {})]
             (when (and (vector? o) (every? map? o)) (ce-destroy-cells! (map atom (rseq o))))))
         (catch arbace.lang.ExceptionInfo x (cx-sure-error! v x)))))

;; cpp-p2564 (the checker): P2564R3's immediate escalation ([expr.const]/16-18), *cx-consteval-unit* above.

(defn- cx-p2564? [] (and (checking?) *cx-consteval-unit* (>= (long *cxx-year*) 20)))

(defn- cx-imm-escalating?
  "[expr.const]/18: whether the function `g` is immediate-escalating, its immediate invocations no full-expressions of their own:
  a closure's member (its call operator), a constexpr function made by a template's instantiation, a header's or one no plain
  class has (cpp-sweep's judgment), and in a consteval unit a defaulted or implicit special member, constexpr or not."
  [g]
  (boolean
   (or (and (:cls g) (some-> (abi/cls (:cls g)) :lambda))
       (and (cx-p2564?) (or (:implicit g) (:defaulted g)) (or (#{:ctor :dtor} (:kind g)) (= "operator=" (:name g))))
       (and (:constexpr g) (or (:tinst g) (:implicit g) (:defaulted g) (not (:node g)) (header-node? (:node g))
                               (and (:cls g) (not (cx-plain-class? (:cls g))))
                               (and (:friend-cls g) (not (cx-plain-class? (:friend-cls g)))))))))

(defn- cx-main-fn?
  "Whether the function `g` is the main file's (an implicit member: its class's)."
  [g]
  (if-let [n (:node g)]
    (not (header-node? n))
    (let [c (some-> (:cls g) abi/cls) cn (when c (or (:cx-node c) (:cx-lambda-node c)))] (boolean (and c (not (:header c)) cn (not (header-node? cn)))))))

(defn- cx-esc-markable?
  "Whether the escalation of the function `g` is judged: an immediate-escalating function of the main file, no consteval one."
  [g]
  (boolean (and g (cx-p2564?) (not (:consteval g)) (cx-imm-escalating? g) (cx-main-fn? g))))

(defn- cx-escalate! [g] (when-not (:cx-escalated (fnd (:id g))) (upd-fn! (:id g) assoc :cx-escalated true)))

(defn- cx-analyze-early!
  "The definition of the function `f` analyzed where a use asks whether it escalated (a template's specialization is analyzed
  after the declarations otherwise): its body or, an implicit or defaulted member, its implicit definition; a refusal undoes it,
  the entry's analysis then reporting it in order. The analysis' position restored."
  [f]
  (let [fid (:id f) f (fnd fid)]
    (when (and (not (:tbody f)) (not (:tinits f)) (not (:cx-early f)) (not (:analyzing f)) (not (:deleted f))
               (not (contains? *ce-analyzing* fid))
               (or (and (:body f) (not (:cx-no-body f))) (and (or (:implicit f) (:defaulted f)) (not (:params f)))))
      (let [a *at* saved (some-> a deref)]
        (upd-fn! fid assoc :cx-early true)
        (try (binding [*cx-no-imm* false *unevaluated* false *ce-analyzing-imm* false *cx-at-override* nil *cx-imm-pending* nil
                       *ce-manifest* false *cx-arms-evaluated* false *ce-analyzing* (conj *ce-analyzing* fid)
                       *tmpl-chain* (long (or (:inst-chain f) 0)) *tmpl-slack* (if (:inst-vt f) 1 0)]
               (if (and (:body f) (not (:implicit f)))
                 (analyze-fn! fid)
                 (analyze-implicit! fid))
               (upd-fn! fid assoc :analyzed true))
             (catch arbace.lang.ExceptionInfo e
               (when (:cpp/timeout (ex-data e)) (throw e))
               (swap! *fns* assoc fid (assoc f :cx-early true)))
             (finally (when a (reset! a saved))))))))

(defn- cx-escalated?
  "Whether the function `f` is an immediate function by P2564's escalation (its definition analyzed first when it is not yet)."
  [f]
  (boolean (and f (cx-esc-markable? f)
                (do (cx-analyze-early! f) (:cx-escalated (fnd (:id f)))))))

(defn- cx-imm-fn? [f] (boolean (and f (or (:consteval f) (cx-escalated? f)))))

(defn- cx-imm-context?
  "Whether the context `ctx` is an immediate function context: a consteval function's, or one escalated."
  [ctx]
  (let [g (some-> (:fn-id ctx) fnd)] (boolean (and g (or (:consteval g) (:cx-escalated g))))))

(defn- cx-imm-addrs
  "[expr.const]/17.1: the function address nodes of the typed tree `x` naming an immediate function (consteval, or escalated)
  that are no operand of an immediate invocation."
  [x]
  (let [out (java.util.ArrayList.)]
    ((fn w [x]
       (cond (map? x) (case (:op x)
                        :fnaddr (when-let [f (some-> (:fn x) fnd)] (when (cx-imm-fn? f) (.add out x)))
                        :call (when-not (cx-imm-fn? (some-> (:fn x) fnd))
                                (doseq [[k v] x :when (and (coll? v) (not (#{:ty :cx-at} k)))] (w v)))
                        (doseq [[k v] x :when (and (coll? v) (not (#{:ty :fty :cx-at :range} k)))] (w v)))
             (sequential? x) (doseq [y x] (w y))
             :else nil))
     x)
    (vec out)))

(defn- cx-addr-report!
  "An escalated function's address taken outside an immediate function context: GCC's \"taking address of an immediate
  function\", at the address (else `n`)."
  [addrs n]
  (when-let [h *on-refusal*]
    (doseq [a addrs :let [f (fnd (:fn a))] :when (and (not (:consteval f)) (:cx-escalated f))]
      (h (ex-info (str "codegen: taking address of an immediate function '" (:name f) "'")
                  {:codegen/refused :constexpr :cx/node (if (:cx-at a) {:range (:cx-at a)} n)})
         nil))))

(defn- cx-addr-escalation!
  "After the definition of the function `fid` is analyzed: an escalating one taking an immediate function's address escalates;
  another (no consteval one) taking an escalated one's is ill-formed."
  [fid]
  (when (cx-p2564?)
    (let [f (fnd fid)]
      (cond (or (:consteval f) (:cx-escalated f)) nil
            (cx-esc-markable? f) (when (seq (cx-imm-addrs [(:tbody f) (:tinits f)])) (cx-escalate! f))
            (and (not (cx-imm-escalating? f)) (cx-main-fn? f)) (cx-addr-report! (cx-imm-addrs [(:tbody f) (:tinits f)]) (:node f))
            :else nil))))

(defn- cx-imm-sure
  "The sure refusal of the immediate invocation `node`'s constant evaluation, or nil."
  [node]
  (let [x (try (binding [*ce-manifest* true *ce-point* nil *ce-analyzing-imm* true] (ce-eval node) nil)
               (catch arbace.lang.ExceptionInfo x x))]
    (when (:cx/sure (ex-data x)) x)))

(defn- cx-imm-error!
  "An immediate invocation of `f` surely no constant expression (`x` its evaluation's refusal): the operation's own error where it
  is, then GCC's \"call to consteval function 'f(...)' is not a constant expression\" thrown (at *cx-at-override* when bound)."
  [f x]
  (let [d (ex-data x) m (subs (str (.getMessage ^Throwable x)) (count "not a constant: "))]
    (when-let [at (:cx/at d)]
      (when-let [h *on-refusal*]
        (h (ex-info (str "codegen: expression is not a constant expression (" m ")") {:codegen/refused :constexpr :cx/node {:range at}}) nil)))
    (if-let [o *cx-at-override*]
      (throw (ex-info (str "codegen: call to consteval function '" (:name f) "' is not a constant expression")
                      {:codegen/refused :constexpr :cx/node {:range o}}))
      (fail :constexpr "call to consteval function '" (:name f) "' is not a constant expression"))))

(defn- cx-ctor-immediate!
  "cpp-p2564 (the checker): a variable `v` (its declaration `n`) initialized by `i`, a call of an immediate constructor (a consteval
  one, or one escalated: [expr.const]/16's implicit invocation) outside an immediate function context, neither constexpr nor
  constinit (their initializers are manifestly constant-evaluated): an immediate invocation, the object's construction evaluated;
  surely no constant, an escalating function escalates, another's is GCC's \"call to consteval function\" at the variable, the
  operation's own error beside."
  [ctx v i n]
  (when (and (cx-p2564?) (map? i) (or (= :ctor (:i i)) (and (= :zero-then (:i i)) (= :ctor (:i (:then i)))))
             (not *unevaluated*) (not *cx-no-imm*) (not *ce-analyzing-imm*)
             (not (:cx-constexpr v)) (not (:cx-constinit v)) (not (:constexpr v)) (not (abi/ref? (:ty v))))
    ;; (a value-initialization's zeroing then its constructor, :zero-then: the constructor's)
    (let [f (fnd (:fn (if (= :ctor (:i i)) i (:then i))))]
      (when (and f (cx-imm-fn? f) (not (cx-imm-context? ctx)))
        (let [g (some-> (:fn-id ctx) fnd)
              sure (fn [] (let [x (try (binding [*ce-manifest* true *ce-point* nil *ce-analyzing-imm* true *ce-steps* (atom 0) *ce-wide* true
                                                 *ce-const* (atom #{}) *ce-pos* (atom nil) *ce-dead* (atom #{}) *ce-temps* (atom [])
                                                 *ce-heap* (atom {}) *ce-moved* (atom {}) *ce-unknown* (atom {})]
                                         (ce-init (:ty v) i {}) nil)
                                       (catch arbace.lang.ExceptionInfo x x))]
                            (when (:cx/sure (ex-data x)) x)))]
          (cond
            (and g (cx-imm-escalating? g)) (when (and (cx-esc-markable? g) (sure)) (cx-escalate! g))
            :else (when-let [x (sure)]
                    (let [d (ex-data x) m (subs (str (.getMessage ^Throwable x)) (count "not a constant: "))]
                      (when-let [h *on-refusal*]
                        (when-let [at (:cx/at d)]
                          (h (ex-info (str "codegen: expression is not a constant expression (" m ")") {:codegen/refused :constexpr :cx/node {:range at}}) nil))
                        ;; (at the declarator's name, GCC's place: `struct S2 { ... } s2;`)
                        (h (ex-info (str "codegen: call to consteval function '" (:name f) "' is not a constant expression")
                                    {:codegen/refused :constexpr
                                     :cx/node (let [l (:loc n)] (if (and (map? l) (integer? (:offset l))) (assoc-in n [:range :begin] l) n))})
                           nil))))))))))

(defn- cx-closure-conv!
  "cpp-p2564 (the checker): a closure's conversion function `f` to a pointer to function, its call operator escalated: the
  conversion returns an immediate function's address ([expr.const]/16-18), an escalating context escalating, another's
  GCC's \"call to consteval function ... returns address of immediate function\"."
  [ctx f]
  (when-let [op (and (cx-p2564?) (= :conv (:kind f)) (:cx-callop f))]
    (let [o (fnd op)]
      (when (and (:cx-escalated o) (not *unevaluated*) (not *cx-no-imm*) (not *ce-analyzing-imm*) (not (cx-imm-context? ctx)))
        (let [g (some-> (:fn-id ctx) fnd)]
          (if (and g (cx-imm-escalating? g))
            (when (cx-esc-markable? g) (cx-escalate! g))
            (fail :constexpr "call to consteval function '" (:name f) "' is not a constant expression (it returns address of immediate function '" (:name o) "')")))))))

(defn- cx-immediate-eval!
  "cpp-ce3 (the checker): an immediate invocation ([expr.const]/16-17: a call of a consteval function in no immediate function
  context: not in a consteval function, not in an immediate-escalating one, a constexpr function or a lambda's call operator,
  P2564R3, and in no unevaluated operand) is a full-expression that is a constant expression: the call `node` evaluated, an
  evaluation the program's own operation makes surely not constant GCC's \"call to consteval function 'f(...)' is not a constant
  expression\" at the call, the operation's own error beside it. The call node returned.
  cpp-p2564: a call of an escalated function too; in an escalating function of the main file (cx-esc-markable?) such an
  invocation surely not constant, or one returning an immediate function's address, escalates the function instead; at a
  namespace-scope variable's initializer one returning an immediate function's address is judged by the whole initializer
  (*cx-imm-pending*, global-init)."
  [ctx f node]
  (when (and (checking?) (not *unevaluated*) (not *ce-analyzing-imm*) (not *cx-no-imm*)
             (not (and (:cls ctx) (not (:fn-id ctx))))
             (or (and (:consteval f) (not (:cx-imm-error f))) (and (not (:consteval f)) (cx-escalated? f))))
    (let [g (some-> (:fn-id ctx) fnd)]
      (cond
        (and g (or (:consteval g) (:cx-escalated g))) nil
        ;; (cpp-sweep: P2564R3's immediate-escalating functions alone, [expr.const]/18 -- a closure's call operator, a
        ;; defaulted special member, a constexpr function made by a template's instantiation -- not a constexpr function
        ;; that is none: its immediate invocations evaluated, cpp2a/consteval34.C's foo, consteval-prop1.C's f3)
        (and g (cx-imm-escalating? g))
        (when (and (cx-esc-markable? g) (or (cx-imm-sure node) (returned-immediate (:id f))))
          (cx-escalate! g))
        :else
        (if-let [x (cx-imm-sure node)]
          (cx-imm-error! f x)
          (when-let [r (and *cx-imm-pending* (cx-p2564?) (returned-immediate (:id f)))]
            (swap! *cx-imm-pending* conj [node f r]))))))
  node)

(defn- sassert-unsure-node?
  "Whether a static_assert's condition holds a node whose value the slice approximates: a type trait, sizeof or alignof
  (the layouts of the slice's types), a call through the trait hook's text."
  [n]
  (boolean (some #(and (map? %) (#{"TypeTraitExpr" "UnaryExprOrTypeTraitExpr" "CXXNoexceptExpr" "OffsetOfExpr"} (:kind %)))
                 (tree-seq #(or (map? %) (vector? %)) #(if (map? %) (vals (dissoc % :_t :_ent :range :loc)) (seq %)) n))))

(defn- sassert-false-conjunct
  "cpp-rind (the checker): GCC places a failed static assertion whose condition is a chain of && at the first operand that
  evaluates to false (its \"'is_same<int*, int>::value' evaluates to false\"), on that operand's own line when the chain spans
  several: that operand's node (with a range), or nil (diagnostic/static_assert1.C)."
  [ctx c]
  (letfn [(strip [x] (if (#{"ParenExpr" "ImplicitCastExpr" "ExprWithCleanups"} (:kind x)) (strip (first (kids x))) x))
          (conjuncts [x] (let [x (strip x)]
                           (if (and (= "BinaryOperator" (:kind x)) (= "&&" (:opcode x)) (= 2 (count (kids x))))
                             (concat (conjuncts (first (kids x))) (conjuncts (second (kids x))))
                             [x])))]
    (let [ks (conjuncts c)]
      (when (> (count ks) 1)
        (some (fn [k]
                (when (and (:range k) (not (sassert-unsure-node? k)))
                  (let [v (try (binding [*cutoff* Long/MAX_VALUE *constraint-doubt* (atom false) *ce-manifest* true]
                                 (ce-eval (convert-scalar (rv (analyze ctx k)) abi/bool* false)))
                               (catch arbace.lang.ExceptionInfo _ nil))]
                    (when (and (number? v) (zero? (long v))) k))))
              ks)))))

;; cpp-vec (2026-11-25, the checker; 577-1 (a)): a constexpr string, C++26's [dcl.pre]/11-12 (P2741R3, a static_assert-declaration's
;; message) and GCC 15's constexpr asm strings (the GCC manual's "Extended Asm": a template, constraint or clobber written as a
;; parenthesized constant expression): an object M such that M.size() is implicitly convertible to std::size_t and M.data() to
;; const char*, each a constant expression, and every M.data()[i] below the size one too. GCC's errors, at the declaration or
;; statement `at`: "constexpr string must be a string literal or object with 'size' and 'data' members", "constexpr string
;; 'size()' must be implicitly convertible to 'std::size_t'", "... 'data()' ... to 'const char*'", "constexpr string 'size()' must
;; be a constant expression", "constexpr string 'data()' must be a core constant expression", "constexpr string 'data()[I]' must
;; be a constant expression"; the evaluation's own error beside, where it is; a call's own error (a deleted, inaccessible or
;; unviable size or data) as the call reports it.
(def ^:private cx-cstr-ptr {:k :ptr :to (assoc abi/char* :c true)})

(defn- cx-constexpr-string!
  "`eval?`: the size, data and elements evaluated too (a static_assert's message only when its condition is false, [dcl.pre]/12)."
  [ctx x at eval?]
  (when-let [h (when (checking?) *on-refusal*)]
    (let [report! (fn [msg] (h (ex-info (str "codegen: " msg) {:codegen/refused :cxstr :cx/node at}) nil))
          primary "constexpr string must be a string literal or object with 'size' and 'data' members"
          member? (fn [^Throwable ex] (re-find #"no member|unknown name|not a member|member of a non-class|request for member" (str (.getMessage ex))))
          eval! (fn [t i]
                  (binding [*ce-manifest* true *ce-point* (:range at) *ce-steps* (atom 0) *ce-wide* true *ce-const* (atom #{})
                            *ce-pos* (atom nil) *ce-dead* (atom #{}) *ce-temps* (atom [])]
                    (ce-init t i {})))
          sure! (fn [^Throwable ex msg]
                  (let [d (ex-data ex)]
                    (when (:cx/sure d)
                      (let [m (subs (str (.getMessage ex)) (min (count "not a constant: ") (count (str (.getMessage ex)))))]
                        (when-let [p (:cx/at d)]
                          (h (ex-info (str "codegen: expression is not a constant expression (" m ")") {:codegen/refused :constexpr :cx/node {:range p}}) nil)))
                      (report! msg))
                    (boolean (:cx/sure d))))
          e (try (rv (analyze ctx x)) (catch arbace.lang.ExceptionInfo ex (h ex at) nil))
          t (some-> e :ty abi/non-ref abi/unq)]
      (cond
        (nil? t) nil
        (#{:dep :tparam :auto} (:k t)) nil
        (not (abi/class? t)) (report! primary)
        :else
        (let [call (fn [nm] {:kind "CallExpr" :range (:range x)
                             :inner [{:kind "MemberExpr" :name nm :isArrow false :range (:range x) :inner [x]}]})
              an (fn [nm] (try (rv (analyze ctx (call nm)))
                               (catch arbace.lang.ExceptionInfo ex
                                 (if (member? ex) (report! primary) (h ex at))
                                 ::bad)))
              sz (an "size")
              da (when-not (= ::bad sz) (an "data"))]
          (when (and (map? sz) (map? da))
            (let [si (try (init-for abi/ulong* sz ctx :copy)
                          (catch arbace.lang.ExceptionInfo _ (report! "constexpr string 'size()' must be implicitly convertible to 'std::size_t'") nil))
                  di (try (init-for cx-cstr-ptr da ctx :copy)
                          (catch arbace.lang.ExceptionInfo _ (report! "constexpr string 'data()' must be implicitly convertible to 'const char*'") nil))]
              (when (and si di eval?)
                (let [n (try (eval! abi/ulong* si)
                             (catch arbace.lang.ExceptionInfo ex (sure! ex "constexpr string 'size()' must be a constant expression") nil))
                      pv (when (number? n)
                           (try (eval! cx-cstr-ptr di)
                                (catch arbace.lang.ExceptionInfo ex (sure! ex "constexpr string 'data()' must be a core constant expression") nil)))]
                  (when (and (number? n) (some? pv) (= :expr (:i di)))
                    (let [n (long n)
                          elem (fn [k] {:op :load :ty abi/char* :cat :pr
                                        :e {:op :deref :ty (assoc abi/char* :c true) :cat :lv
                                            :e {:op :ptradd :o "+" :p (:e di) :n {:op :int :v k :ty abi/long* :cat :pr} :ty cx-cstr-ptr :cat :pr}}})]
                      ;; (the last first, as GCC reports a string past its object at its last index; then the others, at most 4096)
                      (some (fn [k] (try (eval! abi/char* {:i :expr :e (elem k)}) false
                                         (catch arbace.lang.ExceptionInfo ex
                                           (sure! ex (str "constexpr string 'data()[" k "]' must be a constant expression")))))
                            (distinct (concat (when (pos? n) [(dec n)]) (range (min n 4096))))))))))))))))

(defn check-static-assert!
  "CX12 (the checker): a static_assert-declaration ([dcl.pre]/10): its condition analyzed (a refusal of the analysis
  is reported as its own error) and, when it evaluates with no doubt to false, \"static assertion failed\" at the
  declaration (clang's err_static_assert_failed). A condition with a type trait, sizeof or alignof, or a constraint
  the slice doubted, judges nothing."
  [ctx n]
  (when (checking?)
    (let [c (first (kids n))]
      (when c
        (let [d (atom false)
              ;; (cpp-tpl2: a concept's atoms' errors, GCC's explanations of the assertion's failure)
              ex (atom [])
              e (binding [*cutoff* Long/MAX_VALUE *constraint-doubt* d *cx-constraint-explain* ex] (rv (analyze ctx c)))
              sure (atom nil)
              v (when-not (sassert-unsure-node? c)
                  (try (binding [*constraint-doubt* d *ce-manifest* true *ce-point* (:range n) *cx-constraint-explain* ex] (ce-eval (convert-scalar e abi/bool* false)))
                       (catch arbace.lang.ExceptionInfo x
                         (when (:cx/sure (ex-data x)) (reset! sure x)) nil)))]
          ;; (h-cpp-consteval: a condition [expr.const]/5 makes surely not constant, GCC's "non-constant condition for static
          ;; assertion" at the declaration, and the operation's own error where it is, [dcl.pre]/10)
          (when-let [x (when-not @d @sure)]
            (let [m (subs (str (.getMessage ^Throwable x)) (count "not a constant: "))]
              (when-let [at (:cx/at (ex-data x))]
                (when-let [h *on-refusal*]
                  (h (ex-info (str "codegen: expression is not a constant expression (" m ")") {:codegen/refused :constexpr :cx/node {:range at}}) nil)))
              (throw (ex-info (str "codegen: non-constant condition for static assertion (" m ")") {:codegen/refused :sassert :cx/node n}))))
          ;; (cpp-vec: C++26's message that is no string-literal, a constexpr string, [dcl.pre]/11-12: its size and data always
          ;; checked, evaluated when the condition is false; GCC takes one in every standard, a pedwarn before C++26)
          (when-let [m (second (kids n))]
            (when (and (map? m) (:kind m) (not= "StringLiteral" (:kind m)))
              (cx-constexpr-string! ctx m n (and (number? v) (zero? (long v)) (not @d)))))
          (when (and (number? v) (zero? (long v)) (not @d))
            (throw (ex-info "codegen: static assertion failed" (cond-> {:codegen/refused :sassert :cx/node (or (sassert-false-conjunct ctx c) n)} (and (seq @ex) (>= (long *concepts-diag-depth*) 2)) (assoc :cx/explain (vec (distinct @ex))))))))))))

(defn- cx-static-member-init?
  "CP321 (a): whether the checker analyzes the static data member `v`'s in-class initializer: a member of a class of the
  main file that is no closure, no local class, and no class template's specialization but one an explicit instantiation
  definition names."
  [v]
  (when-let [cid (:cls (:def-scope v))]
    (let [c (abi/cls cid)]
      (and c (not (:header c)) (not (:lambda c))
           (or (nil? (:tmpl c)) (:explicit-inst-def c))
           (some? (cx-enclosing-classes cid))))))

(defn global-init
  "A namespace-scope variable's initializer."
  [vid]
  (let [v (var* vid)
        sc (or (:def-scope v) (:scope v))
        ;; (CX12, the checker: a namespace-scope variable's own initializer, a context no friend declaration names --
        ;; friendship is granted to functions and classes, [class.friend]/1-2 -- nor a derived class's member)
        ;; (queue 463: a static data member's definition, `int A::x = ...;`, its initializer in A's context, [class.static.data]/3)
        ctx (cond-> {:scope sc :statics (atom [])}
              (and (checking?) (:cx-cls v)) (assoc :cx-member-of (:cx-cls v))
              (and (checking?) (= :ns (:kind sc)) (not (:cx-cls v))) (assoc :cx-global true))
        init (:init v)]
    ;; (queue 463, the checker: a refusal with no node of its own -- a default-initialized variable's constructor or
    ;; destructor, cx-ctor-access! and cx-dtor-access! -- at the variable's declaration, not the last node analyzed before)
    (when (and (checking?) *at* (:cx-decl v)) (reset! *at* (:cx-decl v)))
    ;; (queue 526, the checker: `auto x = { ... };` deduces std::initializer_list<E>, [dcl.type.auto.deduct]/4, which the
    ;; slice's type does not: unsure, not "several values for a scalar"; cpp0x/initlist-n3922.C's x1, reached once the
    ;; unit no longer stopped at an earlier refusal)
    (when (and (checking?) (:cx-decl v) (map? init) (= "InitListExpr" (:kind init)) (not (#{"list" "call"} (:init-style v)))
               (re-find #"^(?:\s*(?:static|const|constexpr|inline|extern|volatile|thread_local)\b)*\s*auto\b" (or (node-text (:cx-decl v)) "")))
      (fail :type "auto deduced from a copy-list-initialization (std::initializer_list<E>)"))
    (binding [*cutoff* Long/MAX_VALUE *cx-imm-pending* (when (cx-p2564?) (atom []))]
      (let [i (cond
                (nil? init) (init-for (:ty v) nil ctx :value)
                :else (decl-init ctx vid (assoc (or (:node v) {}) :init (:init-style v) :inner [init] :kind "VarDecl")))
            _ (cx-dtor-access! ctx (:ty (var* vid)))
            ;; (cpp-ce: the variable as decl-init left it, an `auto` one's deduced type -- a scalar's initializer checked)
            _ (cx-check-constant! (var* vid) i)
            ;; (cpp-p2564: an immediate constructor's call; an escalated function's address; an immediate invocation returning an
            ;; immediate function's address, no constant expression unless the whole initializer is one -- constant initialization,
            ;; manifestly constant-evaluated ([expr.const]/20): cpp2a/consteval-prop19.C's `f(1)(2)` and `f(1)(2) + r`)
            _ (when (cx-p2564?)
                (cx-ctor-immediate! ctx (var* vid) i (:cx-decl v))
                (when-not (or (:cx-constexpr (var* vid)) (:cx-constinit (var* vid)))
                  (cx-addr-report! (cx-imm-addrs i) (:cx-decl v))
                  (when-let [[node f r] (first @*cx-imm-pending*)]
                    (when-not (and (= :expr (:i i))
                                   (try (binding [*ce-fnptr* true *ce-manifest* true *ce-point* (:cx-range (var* vid))] (ce-eval (:e i)) true)
                                        (catch arbace.lang.ExceptionInfo _ false)))
                      (throw (ex-info (str "codegen: call to consteval function '" (:name f) "' is not a constant expression (immediate evaluation returns address of immediate function '" (:name r) "')")
                                      {:codegen/refused :constexpr :cx/node (if (:cx-at node) {:range (:cx-at node)} (:cx-decl v))}))))))]
        ;; a scalar initialized by a constant expression: constant initialization ([basic.start.static])
        ;; (CP378 (a): a constexpr variable's or a const integral one's initializer manifestly constant-evaluated)
        (if (and (= :expr (:i i)) (abi/scalar? (abi/unq (:ty v))) (or (not (#{:int :float :null} (:op (:e i)))) (:ice (:e i))))
          (if-let [c (binding [*ce-fold* true] (ce-try (:e i) (boolean (or (:constexpr v) (and (:c (:ty v)) (abi/integral? (:ty v)))))))] (assoc i :e c) i)
          i)))))

(def prelude-typeinfo
  ;; std::type_info as the Itanium ABI lays it out (§2.9.4: the vptr, then the name) and compares it (§2.9.4: equal
  ;; names' addresses, else equal strings unless the name starts with *, a type of internal linkage); declared for
  ;; typeid in place of <typeinfo>'s class, whose bodies the native parser skims (CODEGEN.md §4)
  "namespace std {
class type_info {
public:
  virtual ~type_info();
  const char* name() const noexcept { return __name[0] == '*' ? __name + 1 : __name; }
  bool before(const type_info& __arg) const noexcept { return __builtin_strcmp(name(), __arg.name()) < 0; }
  bool operator==(const type_info& __arg) const noexcept {
    return __name == __arg.__name || (__name[0] != '*' && __builtin_strcmp(__name, __arg.__name) == 0);
  }
protected:
  const char* __name;
};
}
")

(defn- strip-positions [x]
  (cond (map? x) (into {} (for [[k v] x :when (not= k :_b)] [k (strip-positions v)]))
        (vector? x) (mapv strip-positions x)
        :else x))

(defn- prelude-nodes []
  (let [f (java.io.File/createTempFile "cg-prelude" ".cpp")]
    (try
      (spit f prelude-typeinfo)
      (mapv strip-positions (:nodes ((requiring-resolve 'arbace.repr.cpp.native/parse-file) (.getPath f) (.getName f) "c++23" [])))
      (finally (.delete f)))))

;; h-cpp-consteval (the checker): [dcl.constexpr]/6 of C++20 and before (P2448R2 dropped it in C++23), a constexpr function for
;; which no invocation can be a constant expression, as GCC's potential_constant_expression judges its body at its definition
;; (constexpr.cc): a statement or full-expression every path of which surely meets a construct [expr.const]/5 refuses -- a
;; throw-expression, a call of a function surely not constexpr, a reinterpret_cast or a conversion between a pointer and an
;; integer, an asm-declaration before C++20 -- an if's branch only when its condition folds, both branches when it does not
;; ("neither branch of 'if' is a constant expression"), a conditional's and a logical operator's likewise; a loop's body, a
;; switch's, a lambda's not judged. The first finding of a body, [message position].

(declare pce-stmt)

(defn- pce-fold [c] (when-let [v (ce-try c true)] (when (= :int (:op v)) (not (zero? (long (:v v)))))))

(defn- pce-expr
  [e]
  (when (map? e)
    (case (:op e)
      :throw [(str "expression '<throw-expression>' is not a constant expression") (:cx-at e)]
      :call (or (when (and (not (:virtual e)) (ce-not-constexpr? (fnd (:fn e))) (:cx-at e))
                  [(str "call to non-'constexpr' function '" (:name (fnd (:fn e))) "'") (:cx-at e)])
                (pce-expr (:obj e)) (some pce-expr (:args e)))
      ;; (GCC's: any reinterpret_cast, and a nonzero integer constant converted to a pointer; not a pointer to an integer)
      ;; (cpp-1123: a reinterpret_cast between a pointer and an integer is no failure here, GCC's potential constant check
      ;; passing it and its evaluation failing, "conversion from pointer type ... in a constant expression": g++ 15.2 by hand,
      ;; cpp1y/constexpr-82304.C, whose use then has no error of its own)
      :cast (or (when (and (or (and (:cx-reinterpret e) (not (#{:ptr->int :int->ptr} (:ck e))))
                               (and (= :int->ptr (:ck e)) (= :int (:op (:e e))) (not (zero? (long (:v (:e e)))))))
                           (:cx-at e))
                  ["'reinterpret_cast' is not a constant expression" (:cx-at e)])
                (pce-expr (:e e)))
      ;; (cpp-sweep: a volatile glvalue's lvalue-to-rvalue conversion, [expr.const]/5.10: cpp23/constexpr-nonlit13.C)
      :load (if (and (map? (:ty (:e e))) (:v (:ty (:e e))) (not (abi/ref? (:ty (:e e)))) (:cx-at (:e e)))
              ["lvalue-to-rvalue conversion of a volatile lvalue" (:cx-at (:e e))]
              (pce-expr (:e e)))
      ;; (cpp-sweep: before C++20 a new-expression's allocation function, no constexpr function: cpp1y/constexpr-new.C)
      :new (or (when (and (< (long *cxx-year*) 20) (not (:placement e)) (not (some-> (:alloc e) fnd :cls)) (:cx-at e))
                 ["call to non-'constexpr' function 'void* operator new(std::size_t)'" (:cx-at e)])
               (pce-expr (:n e)))
      :reinterpret-lv (or (when (and (:cx-reinterpret e) (:cx-at e)) ["'reinterpret_cast' is not a constant expression" (:cx-at e)])
                          (pce-expr (:e e)))
      :cond (or (pce-expr (:c e))
                (case (pce-fold (:c e))
                  true (pce-expr (:then e)) false (pce-expr (:else e))
                  (let [a (pce-expr (:then e)) b (pce-expr (:else e))] (when (and a b) a))))
      (:land :lor) (pce-expr (:l e))
      :comma (or (pce-expr (:l e)) (pce-expr (:r e)))
      ;; (an operator's operands, in no particular order: the first finding)
      (some pce-expr (for [k [:e :l :r :obj :p :n] :let [x (get e k)] :when (map? x)] x)))))

(defn- pce-stmt
  [s]
  (when (map? s)
    (case (:s s)
      :block (some pce-stmt (mapcat #(if (:flat %) (:items %) [%]) (:items s)))
      :expr (pce-expr (:e s))
      :return (when (= :expr (get-in s [:init :i])) (pce-expr (get-in s [:init :e])))
      :decl (when (= :expr (get-in s [:init :i])) (pce-expr (get-in s [:init :e])))
      :if (or (pce-expr (:cond s))
              (case (pce-fold (:cond s))
                true (pce-stmt (:then s)) false (pce-stmt (:else s))
                (let [a (pce-stmt (:then s)) b (pce-stmt (:else s))]
                  (when (and a b (:else s))
                    (if (:cx-at s) ["neither branch of 'if' is a constant expression" (:cx-at s)] a)))))
      :asm (when (and (< (long *cxx-year*) 20) (:cx-at s)) ["inline assembly is not a constant expression" (:cx-at s)])
      :goto (when (:cx-at s) ["'goto' is not a constant expression" (:cx-at s)])
      ;; (cpp-ce3: a do statement's body runs at least once, [stmt.do]/1)
      :do (pce-stmt (:body s))
      :static-local (when (:cx-at s) [(str "'" (:name (var* (:var s))) "' defined '" (if (:tls (var* (:var s))) "thread_local" "static") "' in 'constexpr' context") (:cx-at s)])
      nil)))

(defn cx-pce-bad?
  "Whether the constexpr function `id`'s body fails the potential constant check (kept on the function): GCC then says at
  an evaluation's call of it that it is called in a constant expression, the evaluation's own error beside."
  [id]
  (let [f (fnd id)]
    (if (contains? f :cx-pce)
      (:cx-pce f)
      (let [r (boolean (and (:constexpr f) (not (:consteval f)) (:tbody f)
                            (binding [*ce-steps* (atom 0) *ce-pos* nil *ce-dead* nil *ce-temps* nil *ce-const* nil]
                              (pce-stmt (:tbody f)))))]
        (upd-fn! id assoc :cx-pce r)
        r))))

(defn- cx-literal-signature!
  "cpp-sweep (the checker): [dcl.constexpr]/3 of C++11-C++20 (P2448R2 dropped it in C++23), a constexpr function's
  parameter types and return type literal types: GCC's pedwarn -Winvalid-constexpr, an error under -pedantic-errors, at the
  definition's name (\"invalid type for parameter N of 'constexpr' function\", \"invalid return type 'T' of 'constexpr'
  function\"); a template's specialization not judged (it is then no constexpr function, [dcl.constexpr]/7 of C++20), nor a
  closure's member (g++ 15.2 by hand: a declaration without a definition not judged either)."
  [id]
  (let [f (fnd id)]
    (when (and (checking?) *on-refusal* *invalid-constexpr-error* (< (long *cxx-year*) 23) (:constexpr f) (not (:consteval f))
               (not (:tinst f)) (not (:implicit f)) (:node f) (not (header-node? (:node f)))
               (or (nil? (:cls f)) (cx-plain-class? (:cls f))) (or (nil? (:friend-cls f)) (cx-plain-class? (:friend-cls f))))
      (let [bad (or (first (keep-indexed (fn [i t] (when (cx-non-literal t) (str "invalid type for parameter " (inc i) " of 'constexpr' function '" (:name f) "'")))
                                         (:ps (:ty f))))
                    (when (and (#{:fn :method} (:kind f)) (cx-non-literal (:ret (:ty f))))
                      (str "invalid return type of 'constexpr' function '" (:name f) "'")))]
        (when bad
          (*on-refusal* (ex-info (str "codegen: " bad) {:codegen/refused :constexpr :cx/node (:node f)}) (:node f)))))))

(defn- cx-ctor-c17-inits!
  "cpp-sweep (the checker): [dcl.constexpr]/4.5 of C++11-C++17 (P1331R2 dropped it in C++20), a constexpr constructor of a class
  that is no union initializes every non-variant non-static data member and base class subobject: a scalar member without a
  mem-initializer or default member initializer, or a base default-initialized by its trivial implicit constructor while it has
  members, is GCC's \"member ... must be initialized by mem-initializer in 'constexpr' constructor\", at the body; a template's
  specialization and a delegating constructor not judged: cpp0x/constexpr-base8.C."
  [id]
  (let [f (fnd id) c (some-> (:cls f) abi/cls) ti (:tinits f)]
    (when (and (checking?) *on-refusal* (= :ctor (:kind f)) (:constexpr f) (< (long *cxx-year*) 20) (not (:tinst f)) c (not (:union c))
               ti (not (:delegate ti)) (:node f) (not (header-node? (:node f))) (cx-plain-class? (:cls f)) (not (:implicit f)) (not (:defaulted f)))
      (let [bad (or (some (fn [{:keys [field init]}]
                            (let [fl (nth (:fields c) field nil)
                                  t (when fl (abi/unq (loop [t (:ty fl)] (if (abi/arr? t) (recur (:of t)) t))))]
                              (when (and fl (not (:static fl)) (string? (:name fl)) (seq (:name fl)) (not (:anon fl)) (not (:bits fl))
                                         (abi/scalar? t) (or (nil? init) (= :none (:i init))))
                                (str "member '" (:name c) "::" (:name fl) "'"))))
                          (:fields ti))
                    (some (fn [{:keys [base init]}]
                            (let [bc (abi/cls base) g (when (= :ctor (:i init)) (fnd (:fn init)))]
                              (when (and bc (some #(not (:static %)) (:fields bc))
                                         (or (= :none (:i init)) (and g (:implicit g) (:trivial g))))
                                (str "member '" (:name c) "::<anonymous>'"))))
                          (:bases ti)))]
        (when bad
          (let [body (some #(when (= "CompoundStmt" (:kind %)) %) (:inner (:node f)))
                at (or body (:node f))]
            (*on-refusal* (ex-info (str "codegen: " bad " must be initialized by mem-initializer in 'constexpr' constructor")
                                   {:codegen/refused :constexpr :cx/node at})
                          at)))))))

(defn- cx-potential-constant!
  "The potential constant check of the constexpr function `id`'s analyzed body (above), its finding an error."
  [id]
  (let [f (fnd id)]
    ;; (cpp-sweep: GCC's -Winvalid-constexpr pedwarn, an error under -pedantic-errors or -Werror=invalid-constexpr alone, a warning
    ;; else: cpp23/constexpr-nonlit8.C's dg-options "")
    (when (and (checking?) *invalid-constexpr-error* (:constexpr f) (not (:consteval f)) (not (:tinst f)) (:tbody f) (< (long *cxx-year*) 23)
               (:node f) (not (header-node? (:node f))) (not (and (:cls f) (some-> (abi/cls (:cls f)) :lambda))))
      (when-let [[m at] (binding [*ce-steps* (atom 0) *ce-pos* nil *ce-dead* nil *ce-temps* nil *ce-const* nil] (pce-stmt (:tbody f)))]
        (when-let [h *on-refusal*]
          (h (ex-info (str "codegen: expression is not a constant expression (" m ")") {:codegen/refused :constexpr :cx/node {:range at}}) nil))))))

(defn analyze-program
  "The program of the native parse's nodes (its global scope `proot`) of the source text `src`: {:fns {id fn} :vars
  {id var} :order [...] :classes {id class} :enums {...}}."
  [nodes proot ^String src]
  (let [root (new-scope :ns nil :path [])
        ;; (queue 526: the checker's refusals that follow from a dropped declaration not reported, cx-poisoned?)
        dropped (when (checking?) (atom #{}))
        h0 *on-refusal*]
  (binding [*cx-dropped* dropped
            *on-refusal* (if dropped (fn [e n] (when-not (cx-poisoned? e n) (h0 e n))) h0)
            *src* src *fns* (atom {}) *vars* (atom {}) *ids* (atom 0) *order* (atom [])
            abi/*classes* (atom {}) abi/*enums* (atom {}) abi/*ns-tags* (atom {}) *proot* proot *root* root *header-cache* (atom {}) *last-anon* (atom nil) *lambda-counts* (atom {})
            *conv-tmpl-cache* (atom {}) *cx-udir-pos* (when (checking?) (java.util.IdentityHashMap.))
            *cx-hdr-ns* (when (checking?) (java.util.IdentityHashMap.))
            *cx-hdr-names* (when (checking?) (cx-hdr-names nodes))
            *cx-all-names* (when (checking?) (cx-all-names nodes))
            *fatal* (when (checking?) (atom false))
            ;; (cpp-p2564: P2564's escalation judged in a unit that names consteval)
            *cx-consteval-unit* (boolean (and (checking?) (re-find #"\bconsteval\b" src)))]
    (do
      ((or (:wrap @hooks) (fn [f] (f)))
       (fn []
         ;; (the headers parsed in full, G4: <typeinfo>'s own class)
         (when (and (re-find #"\btypeid\b|\btype_info\b" src) (not-any? header-node? nodes))
           (binding [*src* prelude-typeinfo]
             (doseq [n (prelude-nodes)] (declare-node! root n))))
         (binding [*retry* (atom [])]
           (let [retry! (fn [] (let [r @*retry*] (reset! *retry* []) (doseq [[sc n] r] (declare-node! sc n))))
                 [hs ms] (split-with header-node? nodes)]
             (doseq [n hs] (declare-node! root n))
             ;; rounds until one declares nothing more
             (let [rounds! (fn [] (loop [k 0]
                                    (let [before (count @*retry*)]
                                      (retry!)
                                      (when (and (< k 6) (pos? before) (< (count @*retry*) before)) (recur (inc k))))))]
               (rounds!)
               ;; (cpp-s13: what is still refused for a class template's specialization whose template is not defined by
               ;; the headers (<iosfwd>'s typedef basic_istream<char> istream without <istream>): an incomplete class, as
               ;; clang has it ([temp.inst]/2: naming a specialization does not instantiate it), completed in place should
               ;; the main file define the template; then the rounds again for the declarations that named those)
               (when (seq @*retry*)
                 (binding [*incomplete-ok* true] (retry!))
                 (rounds!)))
             (binding [*main-retry* (atom [])]
               (let [again! (fn [] (let [r @*main-retry*] (reset! *main-retry* []) (doseq [[sc n] r] (declare-node! sc n))))]
                 (doseq [n ms] (declare-node! root n) (when (seq @*main-retry*) (again!)))
                 ;; (one still refused: its refusal, as before)
                 ;; (queue 526, the checker: each dropped, its names recorded, and the unit going on, as a namespace-scope
                 ;; declaration's refusal is, declare-node!)
                 (when-let [[_ _ e] (first @*main-retry*)]
                   (if (and (checking?) *cx-dropped* (every? (fn [[_ n e]] (and (not (header-node? n)) (cx-recoverable? e))) @*main-retry*))
                     (doseq [[sc n] @*main-retry*] (cx-dropped! sc n))
                     (throw e)))))))
         ;; the declarations in order, then (templates) the lazy definitions each round made used, until none
         (let [entry! (fn [[k id]]
                        (case k
                          :fn (let [f (fnd id)]
                                (when-not (or (:lazy f) (:analyzed f))
                                  (cond
                                    ;; (cpp-read, 2026-11-24, the checker: a template specialization's definition that only bodies
                                    ;; which reported errors use is not instantiated, GCC's limit_bad_template_recursion (errors
                                    ;; since the enclosing instantiation of a non-constexpr function began stop the instantiation
                                    ;; of further definitions): template/recurse3.C's f<T, N+1> after T(0) = 0's error, no
                                    ;; instantiation depth error; `pending` marks them, :cx-bad-parent)
                                    (and (:cx-bad-parent f) (checking?))
                                    (upd-fn! id assoc :analyzed true)
                                    (and (:body f) (not (:tbody f)) (not (:cx-no-body f)))
                                    (do (upd-fn! id assoc :analyzed true)
                                        (binding [*tmpl-chain* (long (or (:inst-chain f) 0)) *tmpl-slack* (if (:inst-vt f) 1 0)]
                                          (when (System/getenv "CPP_DEPTH_TRACE") (binding [*out* *err*] (println "body" (:name f) id "chain" *tmpl-chain*)))
                                          (if-let [h *on-refusal*]
                                            ;; (cpp-small, G1: a specialization's definition past the instantiation depth limit is not
                                            ;; analyzed, GCC's fatal "template instantiation depth exceeds maximum" at its declaration's
                                            ;; name: template/vtable2.C, cpp0x/alias-decl-55.C; the uses it would make stop there)
                                            (if (> (long *tmpl-chain*) (long *max-tmpl-depth*))
                                              (h (ex-info (str "codegen: recursive template instantiation exceeded maximum depth of " *max-tmpl-depth* " (" (:name f) ")")
                                                          {:codegen/refused :depth})
                                                 (let [n (:node f) l (:loc n)]
                                                   (if (and (map? l) (integer? (:offset l))) (assoc-in n [:range :begin] l) n)))
                                              (let [errd (atom false)
                                                    h (fn [& xs] (reset! errd true) (apply h xs))]
                                                ;; (cpp-read: the body under analysis, for a constant evaluation's call of it before its
                                                ;; definition is complete, [expr.const]/5.3)
                                                (binding [*on-refusal* h *ce-analyzing* (conj *ce-analyzing* id)]
                                                  (try (cx-literal-signature! id)
                                                       (analyze-fn! id)
                                                       (cx-potential-constant! id)
                                                       (cx-ctor-c17-inits! id)
                                                       (catch arbace.lang.ExceptionInfo e
                                                         ;; (queue 526: a main-file function's body refused for a constant the evaluation
                                                         ;; does not reach or a type's gap ends that body, not the unit; no rule names them)
                                                         (if (or (:codegen/refused (ex-data e))
                                                                 (and *cx-dropped* (cx-recoverable? e) (some-> (:node f) header-node? not)))
                                                           (h e (some-> *at* deref)) (throw e)))))
                                                ;; (cpp-read: a template specialization's non-constexpr body that reported an error,
                                                ;; for `pending`'s :cx-bad-parent)
                                                (when (and @errd (:tinst f) (not (:cx-espec f)) (not (:constexpr f)) (not (:consteval f)))
                                                  (upd-fn! id assoc :cx-errored true))))
                                            (analyze-fn! id))))
                                    ;; (a closure's implicit members are analyzed, or deleted, where the lambda is)
                                    (and (or (:implicit f) (:defaulted f)) (not (:params f)) (not (:deleted f)))
                                    (do (upd-fn! id assoc :analyzed true)
                                        ;; a defaulted member whose subobjects' members are not viable is deleted
                                        ;; ([class.copy.ctor]/10, [class.default.ctor]/2; G4: the headers' classes)
                                        (try (analyze-implicit! id)
                                             (catch arbace.lang.ExceptionInfo e
                                               (when (System/getenv "CPP_HDR_TRACE")
                                                 (binding [*out* *err*] (println "implicit member failed:" (:name (fnd id)) (:implicit (fnd id)) (:name (abi/cls (:cls (fnd id)))) (:header (abi/cls (:cls (fnd id)))) (.getMessage e))))
                                               (if (or
                                                    ;; (queue 510, the checker: a defaulted == or <=> whose definition refuses
                                                    ;; is defined as deleted, [class.compare.default]/1-2, [class.eq]/2,
                                                    ;; [class.spaceship]/2 (its subobjects' comparisons not usable), unsure but
                                                    ;; for a deleted function chosen, no longer the unit's refusal: the == a
                                                    ;; defaulted <=> declares, cpp2a/spaceship-synth-neg4.C's A without ==)
                                                    (and (checking?) (:defaulted (fnd id)) (#{"==" "<=>"} (:op (fnd id)))
                                                         (:codegen/refused (ex-data e)))
                                                    ;; (cpp-decl2: a member defaulted on its first declaration that the subobjects'
                                                    ;; overload resolution surely deletes, analyze-implicit*'s :cx-defaulted-delete)
                                                    (and (checking?) (:defaulted (fnd id)) (:cx-defaulted-delete (ex-data e)))
                                                    (and (:implicit (fnd id))
                                                        (or (= :overload (:codegen/refused (ex-data e)))
                                                            ;; ([class.default.ctor]/2.5: a member or base with no default
                                                            ;; constructor deletes the implicit one; CX12)
                                                            (and (= :init (:codegen/refused (ex-data e))) (= :ctor (:kind (fnd id)))
                                                                 (re-find #"^codegen: no default constructor for " (str (.getMessage e))))
                                                            ;; (queue 509, the checker: a subobject's constructor or assignment
                                                            ;; inaccessible from the class deletes the implicit one,
                                                            ;; [class.copy.ctor]/10.2, [class.default.ctor]/2.7,
                                                            ;; [class.copy.assign]/7.4; deleted unsure, so no use of it is judged,
                                                            ;; the unit no longer refused: cpp2a/implicit-move1.C's derived)
                                                            (and (checking?) (= :access (:codegen/refused (ex-data e)))
                                                                 (or (= :ctor (:kind (fnd id))) (= "operator=" (:name (fnd id)))))
                                                            (and (:codegen/refused (ex-data e)) (:header (abi/cls (:cls (fnd id)))))))
                                                    ;; (queue 526, the checker: any other recoverable refusal (after the rules above, which delete the
                                                    ;; member surely or by their own judgment; cpp-vm-1125: first, it had poisoned
                                                    ;; their classes, cpp0x/implicit4.C and 38 other rows lost) of a main-file
                                                    ;; class's implicit or defaulted member: deleted, unsure, so no use of it
                                                    ;; is judged, the unit no longer refused)
                                                    (and (checking?) *cx-dropped* (cx-recoverable? e)
                                                         (some-> (abi/cls (:cls (fnd id))) :header not)
                                                         ;; (and its class's name recorded, cx-dropped!'s: its uses not judged,
                                                         ;; cpp0x/decltype37.C's `holder<int> h;` "no default constructor")
                                                         (do (cx-poison-class! (:cls (fnd id))) true)))
                                                 ;; (CX12: deleted for a subobject's deleted member, the checker sure of it)
                                                 (upd-fn! id assoc :deleted true :tinits nil
                                                          :deleted-sure (boolean (and (checking?) (or (re-find #"call to a deleted function" (str (.getMessage e)))
                                                                                                      ;; (queue 510: a subobject surely without a default constructor)
                                                                                                      (and (= :ctor (:kind (fnd id))) (:cx/no-default-sure (ex-data e)))
                                                                                                      (cx-access-deleted? id e))))
                                                          ;; (queue 463: the subobject's deleted member, for cx-deleted-implicit!)
                                                          :cx-sub-deleted (when (and (checking?)
                                                                                     ;; (an assignment deleted for a reference or const member, [class.copy.assign]/7.2-3:
                                                                                     ;; GCC names no subobject's member at the class: inherit/pr97268.C)
                                                                                     (not (and (= "operator=" (:name (fnd id)))
                                                                                               (some #(or (abi/ref? (:ty %)) (:c (:ty %))) (:fields (abi/cls (:cls (fnd id))))))))
                                                                            (or (second (re-find #"call to a deleted function (\S+)" (str (.getMessage e))))
                                                                                ;; (cpp-singles: the subobject's inaccessible copy constructor, cx-access-deleted?)
                                                                                (when (cx-access-deleted? id e)
                                                                                  (second (re-find #"^codegen: '([^']+)' is a " (str (.getMessage e)))))
                                                                                ;; (queue 510: the subobject surely without a default constructor,
                                                                                ;; GCC's "no matching function for call to 'B1::B1()'" at the class)
                                                                                (when (and (= :ctor (:kind (fnd id))) (:cx/no-default-sure (ex-data e)))
                                                                                  (second (re-find #"no default constructor for (\S+)" (str (.getMessage e)))))))
                                                          ;; (queue 499: the subobject's implicitly deleted destructor, cx-sub-dtor-chain!)
                                                          :cx-q499-sub (:cx-q499-sub (ex-data e))
                                                          ;; (cpp-decl2: a union's member, its place)
                                                          :cx-union-node (:cx-union-node (ex-data e)))
                                                 (throw e)))))
                                    :else nil)))
                          ;; (the rest of CP313 (a): an error found while declaring, reported in order)
                          :cx-error (when-let [h *on-refusal*] (h id nil))
                          ;; (CX12, the checker: a namespace-scope static_assert)
                          :sassert (if-let [h *on-refusal*]
                                     (try (check-static-assert! (cond-> {:scope (:scope id) :statics (atom [])}
                                                                  (:member id) (assoc :cls (:cls (:scope id))))
                                                                (:node id))
                                          (catch arbace.lang.ExceptionInfo e
                                            ;; (queue 526: and a main file's other recoverable refusal, without a rule)
                                            (cond (not (or (:codegen/refused (ex-data e))
                                                           (and *cx-dropped* (cx-recoverable? e) (some-> (:node id) header-node? not))))
                                                  (throw e)
                                                  ;; (a member's: its failure alone, any other refusal the slice's)
                                                  (and (:member id) (not= "codegen: static assertion failed" (.getMessage e))) nil
                                                  :else (h e (some-> *at* deref)))))
                                     nil)
                          :var (let [v (var* id)]
                                 ;; (CP321 (a), the checker: a static data member's in-class initializer, analyzed in its class's
                                 ;; scope as the definition's would be ([class.static.data]/3-4, [dcl.init]); a class template's
                                 ;; specialization's only when an explicit instantiation definition names it ([temp.explicit]/10,
                                 ;; [temp.inst]/4: an implicit instantiation's initializer is instantiated when used); the
                                 ;; code generator's definitions unchanged)
                                 (when (and *on-refusal* (= :member-static (:storage v)) (:init v) (not (:defined v)) (not (:cx-sinit v))
                                            (cx-static-member-init? v))
                                   (upd-var! id assoc :cx-sinit true)
                                   ;; (the position of the analysis restored after: a later refusal without a node of its own,
                                   ;; a default-initialized variable's, is not given this initializer's)
                                   (let [at0 (some-> *at* deref)]
                                     (try (global-init id)
                                          (catch arbace.lang.ExceptionInfo e
                                            (if (:codegen/refused (ex-data e)) (*on-refusal* e (some-> *at* deref)) (throw e)))
                                          (finally (when *at* (reset! *at* at0))))))
                                 (when (and (:defined v) (not (:ginit v)))
                                   ;; (CX12: as a checker a refused initializer is reported and the analysis goes on)
                                   (if-let [h *on-refusal*]
                                     (try (when (:cx-type-text v) (check-type-access! (:def-scope v) (:cx-type-text v) (:cx-decl v)))
                                          (upd-var! id assoc :ginit (global-init id))
                                          (catch arbace.lang.ExceptionInfo e
                                            ;; (queue 526: and a main-file variable's other recoverable refusal, without a rule)
                                            (if (or (:codegen/refused (ex-data e))
                                                    (and *cx-dropped* (cx-recoverable? e) (:cx-decl v) (not (header-node? (:cx-decl v)))))
                                              (do (upd-var! id assoc :ginit {:i :none}) (h e (some-> *at* deref))) (throw e))))
                                     (upd-var! id assoc :ginit (global-init id)))))))]
           (loop [i 0]
             (let [order @*order*]
               (if (and (< i (count order)) (not (some-> *fatal* deref)))
                 (do (entry! (nth order i)) (recur (inc i)))
                 (when-let [more (seq (when-not (some-> *fatal* deref) (when-let [h (:pending @hooks)] (h))))]
                   (doseq [x more] (when-not (some-> *fatal* deref) (entry! x)))
                   (recur i))))))))
      {:fns @*fns* :vars @*vars* :order @*order* :classes @abi/*classes* :enums @abi/*enums* :ns-tags @abi/*ns-tags* :root root}))))

               ;; (cpp-ce3, the checker: a member call on an object whose storage the evaluation freed, [basic.life]/7, GCC's "use of
               ;; allocated storage after deallocation", before a virtual call's refusal)
               (when (and (checking?) *ce-heap* (:obj e) (:cls f) (not (:static f))
                          ;; (an object expression of no side effect, evaluated again below: a variable, a load, *, ., ->)
                          ((fn pure? [x] (and (map? x) (case (:op x) (:var :this) true (:load :deref :field :base-lv :decay) (pure? (or (:e x) (:obj x))) false))) (:obj e)))
                 (let [o (try (ce-lv (:obj e) env) (catch arbace.lang.ExceptionInfo _ nil))
                       c (when (ce-loc? o) (::cell (ce-res o)))]
                   (when (and c (get-in @*ce-heap* [c :freed]))
                     (ub! e "use of allocated storage after deallocation in a constant expression"))))
               ;; (cpp-sweep, the checker: a defaulted comparison operator not declared constexpr is constexpr when it can be,
               ;; [class.compare.default]/3 of C++20 (implicitly constexpr since C++23, [dcl.constexpr]/5): one whose definition
               ;; calls a function surely not constexpr is GCC's "call to non-'constexpr' function" at the call, its definition's
               ;; call the explanation at its declaration, cx-cmp-not-constexpr; else evaluated as a constexpr function:
               ;; cpp2a/spaceship-eq3.C, spaceship-constexpr1.C)
               (when-let [why (and (checking?) (>= (long *cxx-year*) 20) (cx-cmp-not-constexpr (:id f)))]
                 (when (and *on-refusal* (:node f) (not (header-node? (:node f))) (not (:cx-cmp-nc-reported f)))
                   (upd-fn! (:id f) assoc :cx-cmp-nc-reported true)
                   (*on-refusal* (ex-info (str "codegen: expression is not a constant expression (call to non-'constexpr' function '" why "')")
                                          {:codegen/refused :constexpr :cx/node (:node f)})
                                 (:node f)))
                 (if (>= (long *cxx-year*) 23)
                   (ub! e "call to non-'constexpr' function '" why "'")
                   (ub! e "call to non-'constexpr' function '" (:name f) "'")))
               (when (and (checking?) (:cx-body-error f))
                 (ub! e "'" (:name f) "' called in a constant expression"))
               ;; (cpp-def, the checker: [expr.const]/5.2, a call of abort -- __builtin_unreachable's stand-in, reached -- is no
               ;; constant expression: GCC's "'__builtin_unreachable()' is not a constant expression" at the call, ubsan/pr63956.C)

                       (let [v (var* (:id a))] (and v (or (:constexpr v) (:cx-constexpr v)) (or (:init v) (:init-node v))
                                                    (:n (abi/unq (:ty v))) (#{:global :member-static} (:storage v)))))
                  (let [v (var* (:id a))
                        at (abi/unq (:ty v))
                        ctx {:scope (or (:def-scope v) *root*)}
                        i (binding [*cutoff* Long/MAX_VALUE *vci-active* (conj *vci-active* (:id a))]
                            (init-for (:ty v) (analyze ctx (or (:init v) (:init-node v))) ctx :copy))
                        el (fn [i] (case (:i i) :expr (ce-wrap (:of at) (binding [*ce-manifest* true *vci-active* (conj *vci-active* (:id a))] (ce-eval (:e i) {})))
                                     (:zero :none nil) 0 (not-constant "an element's initializer")))]
                    (if (and (= :list (:i i)) (:n at) (not (abi/class? (abi/unq (:of at)))) (abi/scalar? (abi/unq (:of at))))
                      (let [xs (mapv el (:items i))]
                        {::base (into xs (repeat (- (long (:n at)) (count xs)) (el (:fill i)))) ::i 0})
                      (not-constant "the decay of a global array")))
                  ;; (cpp-def, the checker: an array of static storage duration not usable in constant expressions, its address
                  ;; alone -- [expr.const]/13's address constant: elements' addresses formed and compared, none read -- a pointer into
                  ;; its unknown object, *ce-unknown*'s, its bound kept: cpp1y/constexpr-89074-3.C's `&a[0] == &v[4]`)
                  (and (checking?) (= :var (:op a)) (not (contains? env (:id a)))
                       (let [v (var* (:id a))] (and v (not (abi/ref? (:ty v))) (:n (abi/unq (:ty v))) (#{:global :member-static} (:storage v)))))
                  (let [n (long (:n (abi/unq (:ty (var* (:id a))))))]
                    {::base (assoc (ce-unknown-loc [:var (:id a)]) ::uvar (:id a) ::arr-n n) ::i 0 ::n n})
                  ;; (h-cpp-consteval: an array subobject, a member's, an element's: its location)
                  (#{:field :deref :base-lv :reinterpret-lv} (:op a))
                  (let [l (ce-lv a env) n (:n (abi/unq (abi/non-ref (:ty a))))]
                    (cond n {::base l ::i 0 ::n (long n)}
                          (vector? (ce-get l)) {::base l ::i 0}
                          :else (not-constant "the decay of a non-array")))
                  :else (not-constant "the decay of " (:op a))))
       :ptradd (let [p (ev (:p e))
                     ;; (cpp-vec, 2026-11-25, the checker: a location that is an array's element, `&"test"[q]`, moved within the
                     ;; array, [expr.add]/4.2: its index moved, 0 to one past the last element; outside them undefined)
                     arr-el (when (and (checking?) (ce-loc? p) (integer? (peek (vec (::path p)))))
                              (let [path (vec (::path p)) up (pop path)
                                    a (let [v @(::cell p)] (if (seq up) (get-in v up) v))]
                                (when (vector? a) [path a])))]
                 (if-let [[path a] arr-el]
                   (let [n (long (ce-num (ev (:n e)))) n (if (= "-" (:o e)) (- n) n) j (+ (long (peek path)) n)]
                     (when-not (<= 0 j (count a)) (ce-sure! "pointer arithmetic outside the bounds of its array (index " j ")"))
                     (assoc p ::path (conj (pop path) j)))
                 ;; (h-cpp-consteval: a pointer to an object, an array of one element, [expr.add]/4: moved by 0, itself)
                 (if (and (ce-loc? p) (zero? (long (ce-num (ev (:n e)))))) p
                 (do
                 ;; (cpp-rind, the checker: moved below 0 or past one beyond its one element, undefined, [expr.add]/4.3: GCC's
                 ;; error naming the index; cpp0x/constexpr-ptrsub2.C's `*(&c - 1)`)
                 (when (and (checking?) (ce-loc? p) (number? (ce-num (ev (:n e)))))
                   (let [n (long (ce-num (ev (:n e)))) n (if (= "-" (:o e)) (- n) n)]
                     (when-not (<= 0 n 1) (ce-sure! "pointer arithmetic outside the bounds of its object (index " n ")"))))
                 (when-not (ce-ptr? p) (not-constant "pointer arithmetic"))
                 (let [n (long (ev (:n e)))] (ce-ptr-add p (if (= "-" (:o e)) (- n) n)))))))
       ;; (h-cpp-consteval: a new-expression's array size evaluated first, its own errors; the allocation not evaluated)
       ;; (cpp-ce2, the checker: from C++20 a new-expression of the global allocation function allocates, ce-new)
       :new (if (and (checking?) (>= (long *cxx-year*) 20) *ce-heap*)
              (ce-new e env)
              (do (when (:n e) (ev (:n e)))
                  ;; (cpp-sweep, the checker: before C++20 the global allocation function a new-expression calls is no constexpr
                  ;; function, [expr.const]/2 of C++17: GCC's "call to non-'constexpr' function 'void* operator new(std::size_t)'",
                  ;; sure; cpp1y/constexpr-new.C)
                  (when (and (checking?) (< (long *cxx-year*) 20) (not (:placement e)) (not (some-> (:alloc e) fnd :cls)))
                    (ub! e "call to non-'constexpr' function 'void* operator new(std::size_t)'"))
                  (not-constant "a new-expression")))
       :delete (if (and (checking?) (>= (long *cxx-year*) 20) *ce-heap*)
                 (ce-delete e env)
                 (not-constant "a delete-expression"))
       ;; (h-cpp-consteval, the checker: [expr.const]/5.24, a throw-expression)
       :throw (if (checking?) (ub! e "'<throw-expression>' is not a constant expression") (not-constant "a throw"))
       ;; (cpp-ce2, the checker: a pointer to data member, {::mdata [class path]}: the path from its class's object to the member,
       ;; through base subobjects ([expr.unary.op]/3.1); .* and ->* apply it, ce-lv's :mfield)
       :mptr-data (if-let [fc (:cx-cls e)]
                    (let [qc (:cls (abi/unq t))
                          bp (or (ce-base-path qc fc) (not-constant "a pointer to member of a virtual or ambiguous base"))]
                      {::mdata [qc (conj bp (:cx-i e))]})
                    (not-constant "the expression :mptr-data"))

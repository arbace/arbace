          ;; '__alignof__' to a void type" (GNU's __alignof and sizeof of void are its pedwarns, not errors); cpp0x/alignas20.C)
          _ (when (and (checking?) (= "alignof" (:name n)) at (= abi/void (abi/unq t)))

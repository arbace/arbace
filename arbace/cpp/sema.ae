        "sizeof" (if-let [vid (and (checking?) (:vla (abi/unq t)) (= :var (:op x)) (:vla-n (var* (:id x))) (:id x))]
                   ;; (queue 569, the checker: sizeof of a GNU variable-length array, evaluated where it is, the GCC manual's
                   ;; "Variable Length": its elements' count, known when its declaration was evaluated, times an element's size)
                   {:op :vla-sizeof :var vid :esize (abi/size-of (:of (abi/unq t))) :ty abi/ulong* :cat :pr}
                   {:op :int :v (abi/size-of t) :ty abi/ulong* :cat :pr})

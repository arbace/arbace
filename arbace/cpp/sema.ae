          ;; of one, expr/sizeof3.C; not in a function template's specialization, whose point of instantiation may follow
          ;; the class's definition)
          _ (when (and (checking?) (not (some-> (:fn-id ctx) fnd :tinst)))
              (when-let [c (cx-incomplete-cls (loop [t t] (if (abi/arr? t) (recur (:of t)) t)))]

    "SizeOfPackExpr" (let [e (first (lookup (:scope ctx) (:name n)))]
                       (when-not (#{:pack :varpack} (:e e)) (fail :pack "sizeof... of a non-pack " (:name n)))
                       {:op :int :v (count (or (:elems e) (:ids e))) :ty abi/ulong* :cat :pr})
    "UnaryExprOrTypeTraitExpr"
    (let [;; (queue 380, W3d: an operand the parser read as an expression that names a type, type-named-by)
          at (get-in n [:argType :qualType])
          nt (when-not at (type-named-by ctx (first (kids n))))
          x (when-not (or at nt) (binding [*unevaluated* true] (analyze ctx (first (kids n)))))

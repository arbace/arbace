                          (:cls f) (cx-non-literal {:k :class :id (:cls f)}))
                 (when (and *on-refusal* (not (cx-plain-class? (:cls f))) (:node f) (not (header-node? (:node f))) (not (:cx-c11-explained f)))
                   (upd-fn! (:id f) assoc :cx-c11-explained true)
                   (*on-refusal* (ex-info (str "codegen: enclosing class of 'constexpr' non-static member function '" (:name f) "' is not a literal type")
                                          {:codegen/refused :constexpr :cx/node (:node f)})

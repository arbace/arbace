(ns arbace.cpp.sema
  "The code generator's semantic analysis (doc/cpp/CODEGEN.md §3): the native parser's tree (clang's AST as data,
  arbace.repr.cpp.native) analyzed as clang's Sema analyzes it for the slice of C++ CODEGEN.md §6 names -- the
  declarations entered into scopes (namespaces, classes, blocks), every expression typed with its value category and
  its implicit conversions written out (lvalue-to-rvalue, promotions, the usual arithmetic conversions, decay, the
  pointer conversions, derived-to-base), names looked up as [basic.lookup] says (unqualified, qualified, class members
  through the bases, the operators' ADL in the classes' namespaces), overload resolution by the implicit conversion
  sequences' ranks ([over.match.best], [over.ics.rank]: exact, promotion, conversion, user-defined, ellipsis, with the
  reference bindings' qualification tie-break), initialization ([dcl.init]: default, value, copy, direct, list and
  aggregate initialization, reference binding with temporaries materialized), the implicit special members
  ([class.default.ctor], [class.copy.ctor], [class.dtor]: declared, trivial or defined), virtual functions and their
  overriders. The result is a program of typed functions and variables that arbace.cpp.codegen writes as LLVM forms.
  Anything outside the slice is refused: (ex-info ... {:codegen/refused class})."
  (:require [arbace.cpp.abi :as abi]
            [arbace.repr.cpp.scope]
            [arbace.repr.cpp.types :as ct]
            [arbace.string :as str]))

(set! *warn-on-reflection* true)

(def fail abi/fail)

;; Templates (doc/cpp/CODEGEN.md §G3) live in arbace.cpp.template, which installs these hooks: :declare (a template's
;; declaration node, nil when not one), :template-id (a type form (<> name args...)), :const-bound (an array bound
;; that is not a literal), :call-candidates (the specializations a call's function templates deduce), :tiebreak
;; ([over.match.best]/2.2-2.5: a non-template over a template, the more specialized template), :pending (the lazily
;; instantiated definitions a round of analysis made used), :wrap (the analysis run inside the templates' state).
(def hooks (atom {}))

;; ---------------------------------------------------------------------------------------------
;; State

(def ^:dynamic *src* "")
;; CX12 (arbace.repr.cpp.diag): an atom of the last node with a position analyzed, and the handler of an entry's refusal
;; ((fn [ex node]) called with the refusal and that node, the analysis going on with the next entry); nil: off
(def ^:dynamic *at* nil)
(def ^:dynamic *on-refusal* nil)
;; (queue 463: within an implicit special member's definition, analyze-implicit!)
(def ^:dynamic *cx-in-implicit* false)
(def ^:dynamic *pedantic-errors* false)
;; cpp-sweep: GCC's -Winvalid-constexpr (a constexpr function no invocation of which is constant, its non-literal signature,
;; before C++23) an error: -pedantic-errors, -Werror=invalid-constexpr or -Werror given (arbace.repr.cpp.diag binds it)
(def ^:dynamic *invalid-constexpr-error* true)
;; cpp-sweep: -Winvalid-constexpr given (since C++23 GCC then warns at a definition no invocation of which is constant, and a constant
;; evaluation's call of it is the error alone)
(def ^:dynamic *invalid-constexpr-warned* false) ; CP311 (a): -pedantic-errors given, an extension's diagnostic an error (the checker)
;; queue 365: -pedantic, -Wpedantic or -pedantic-errors given (the checker): GCC's diagnostics of the GNU extensions it otherwise
;; accepts silently (a zero-size array)
(def ^:dynamic *pedantic* false)
;; queue 412 (round 7): [dcl.init.list]/7's narrowing conversions judged (the checker): false under -Wno-narrowing, -fpermissive
;; or -Wno-error=narrowing (GCC's permerror then a warning or nothing), and for the code generator
(def ^:dynamic *narrowing* false)
;; cpp-extfloat (the checker): GCC's pedwarn on an implicit floating conversion to a lesser or unordered conversion rank between
;; types not both standard ([conv.double]/1, P1467R9; -Wnarrowing) an error: -pedantic-errors, -Werror=narrowing or -Werror
;; given, neither -Wno-narrowing nor -Wno-error=narrowing (arbace.repr.cpp.diag binds it)
(def ^:dynamic *fp-rank-error* false)
;; queue 518 (the checker): P0522's matching of template template arguments ([temp.arg.template]/3-4), GCC's -fnew-ttp-matching,
;; on by default from C++17; nil: by the standard, true or false: the option given (-fnew-ttp-matching, -fno-new-ttp-matching)
(def ^:dynamic *new-ttp-matching* nil)
;; CX12 (second slice): the checker's rules that the code generator does not apply (on with *on-refusal*: a program the
;; checker reads may be ill-formed; the code generator's programs are not, and its analysis stays as it was)
(defn checking? [] (some? *on-refusal*))
;; cpp-small (G1): the limit on the depth of nested template instantiations ([temp.inst]/17, [implimits]): clang's 1024 for the
;; code generator, GCC's -ftemplate-depth for the checker (arbace.repr.cpp.diag binds it: the option's N, else GCC's default 900);
;; and the depth of the function body being analyzed, a specialization's definition instantiated where a body of depth d uses it
;; at d + 1 (arbace.cpp.template/pending; 0 for a function no template's), the class instantiations under way counted above it
(def ^:dynamic *max-tmpl-depth* 1024)
(def ^:dynamic *tmpl-chain* 0)
;; (1 in a body analyzed as a virtual function of a class instantiated in another body, arbace.cpp.template/chain-members!)
(def ^:dynamic *tmpl-slack* 0)
;; (the checker: an atom set once an infinite instantiation was reported, GCC's fatal error: the unit's analysis stops after the
;; entry under way, depth-fatal!)
(def ^:dynamic *fatal* nil)

(defn depth-fatal!
  "cpp-small (G1), the checker: an instantiation recursion found unbounded (the same substitution re-entered, or constraint
  satisfactions nested with ever new arguments) reported as GCC's fatal \"template instantiation depth exceeds maximum\" at the
  node `n` (else the analysis' position), the unit's analysis stopped after the entry under way (*fatal*); then a refusal of
  the substitution under way thrown."
  [what n]
  (when-let [h *on-refusal*]
    (when-not (some-> *fatal* deref)
      (h (ex-info (str "codegen: recursive template instantiation exceeded maximum depth of " *max-tmpl-depth* " (" what ")")
                  {:codegen/refused :depth})
         (or n (some-> *at* deref)))
      (when *fatal* (reset! *fatal* true))))
  (throw (ex-info (str "codegen: recursive template instantiation exceeded maximum depth (" what ")") {:codegen/refused :depth :cx/reported true})))
;; CP329 (a): the dg read's time cap for one file (arbace.repr.cpp.diag binds it: System/nanoTime's deadline, 0 none); past it
;; every analysis step throws {:cpp/timeout true}, which the refusals' handlers may catch, so the analysis unwinds with nothing
;; more done and the reader, seeing the deadline passed, reports the file's read as :timeout
(def ^:dynamic *deadline* 0)
(defn tick! []
  (let [d (long *deadline*)]
    (when (and (pos? d) (> (System/nanoTime) d))
      (throw (ex-info "codegen: the read's time cap passed" {:cpp/timeout true})))))
;; the function templates of the call being resolved whose deduction gave no candidate: {:sure-drops n :unsure-drops m}
(def ^:dynamic *drops* nil)
;; cpp-tpl2 (the checker): true while a function template's signature is substituted (arbace.cpp.template/instantiate-fn: its
;; non-type parameters' types, its declaration), false again in a class template's instantiation it asks for (whose errors are
;; no substitution failure, [temp.deduct.general]/8's immediate context)
(def ^:dynamic *cx-subst* false)
(defn cx-subst?
  "cpp-tpl2: whether a type or expression formed now is a function template's signature being substituted (the checker)."
  [] (boolean (and *cx-subst* (checking?))))
(declare cx-type-friend?)
(defn- cx-subst-friend?
  "cpp-tpl2: whether a friend declaration of class `cid` may grant the template being substituted (*cx-subst*, its name) a member
  with access `acc`: a friend class, a friend function of its name, or cx-type-friend?'s gate when the name is not known."
  [cid acc]
  (let [c (abi/cls cid)]
    (if (string? *cx-subst*)
      (boolean (or (:friend-classes c) (seq (:friend-class-names c)) (contains? (:friend-fns c) *cx-subst*)
                   (and (= :protected acc) (some (fn [d] (and (:has-friends d) (abi/derived-from? (:id d) cid))) (vals @abi/*classes*)))))
      (cx-type-friend? cid acc))))
(defn cx-subst-fail!
  "cpp-tpl2, the checker: a construct a substitution of template arguments forms that is ill-formed by itself ([temp.deduct.general]/8:
  an invalid type or expression in the immediate context is a substitution failure): the template surely drops out of the call's
  candidates, and its message is the explanation GCC gives as an error at the construct when the call then finds no viable
  function (arbace.cpp.template/call-candidates' :explain)."
  [& msg]
  (throw (ex-info (str "codegen: " (apply str msg)) {:codegen/refused :subst :cx/sure-drop true :cx/subst true})))
;; the access of the class member being declared (the access-specifier before it)
(def ^:dynamic *member-access* nil)
;; the language's year (11, 14, 17, 20, 23, 26; 3 for C++98/03), bound from the file's standard by the checker and, since
;; CP293 (a), by the code generator (arbace.cpp.codegen/gen-file)
(def ^:dynamic *cxx-year* 17)
(defn new-ttp-matching? [] (if (nil? *new-ttp-matching*) (>= (long *cxx-year*) 17) (boolean *new-ttp-matching*)))

(defn cxx-year
  "The year of the standard `std` names (c++98 and c++03 as 3, gnu++NN as c++NN; 17 when unknown)."
  ^long [std]
  (let [[_ y] (re-find #"\+\+(\d\d|[0-9a-z]{2})$" (str std))]
    (case y ("98" "03") 3 "0x" 11 "1y" 14 "1z" 17 "2a" 20 "2b" 23 "2c" 26
      (if (and y (re-matches #"\d\d" y)) (Long/parseLong y) 17))))
(declare ^:dynamic *unevaluated*) ; cpp-rt-own: decltype-of and this-expr read it before its definition below
(def ^:dynamic *fns* nil)    ; atom {id fn}
(def ^:dynamic *vars* nil)   ; atom {id var}
(def ^:dynamic *ids* nil)    ; atom counter
(def ^:dynamic *order* nil)  ; atom [[:fn id] [:var id] ...] in declaration order (the definitions' emission order)

(defn- next-id [] (swap! *ids* inc))
(defn fnd [id] (get @*fns* id))
(defn var* [id] (get @*vars* id))
(defn- upd-fn! [id f & args] (apply swap! *fns* update id f args))
(defn- upd-var! [id f & args] (apply swap! *vars* update id f args))

;; A scope: {:kind :ns|:class|:block|:fn :names HashMap(name -> [entity]) :parent scope :path mangling path :cls id
;;           :usings ArrayList :pos-limited bool}
(defn- new-scope [kind parent & {:as more}]
  (merge {:kind kind :names (java.util.HashMap.) :parent parent :usings (java.util.ArrayList.)
          :path (:path parent [])}
         more))

(defn ucn-name
  "A name with its universal character names as their characters ([lex.charset]/2, [lex.name]: `\\u00C1`, `\\u00c1` and
  `\\U000000C1` one identifier, as clang's IdentifierInfo holds it); a name without a backslash itself (cpp-route: g++.dg's
  other/ucnid-1.C). Queue 439: their characters as UTF-8 bytes (abi/ucn-bytes), as the reader holds a UTF-8 source's: a name
  spelled in UTF-8 and with universal character names one identifier."
  ^String [^String nm]
  (abi/ucn-bytes nm))

(defn- enter! [scope ^String nm e]
  (when nm
    (let [^java.util.HashMap m (:names scope) nm (ucn-name nm)]
      (.put m nm (conj (or (.get m nm) []) e))))
  e)

(def ^:dynamic *cutoff* Long/MAX_VALUE)
(def drop-count
  "cpp-s8: the header declarations dropped so far (each drop counted, a later round's success not subtracted): a
  provisional instance's test of whether a member of its definition was dropped (template.ae's declare-instance!)."
  (java.util.concurrent.atomic.AtomicLong.))

(def ^:dynamic *last-anon* nil) ; atom: the type of the last unnamed class declared (its member's or variable's type) ; a namespace-scope name declared at or after this token is not visible yet

(declare class-lookup)
(declare cx-constexpr-string!)

(defn- own-names
  "The entities `nm` names in `scope` and, transitively, in the namespaces its using-directives nominate, each namespace
  once ([namespace.udir]/2-3, [basic.lookup.unqual]/2: the nominated sets' union; a cycle of directives -- libsupc++'s
  tinfo.h nominating __cxxabiv1 from inside a namespace __cxxabiv1 nominates -- is the same set)."
  ([scope ^String nm] (own-names scope nm (java.util.IdentityHashMap.)))
  ([scope ^String nm ^java.util.IdentityHashMap seen]
   (when-not (.containsKey seen (:names scope))
     (.put seen (:names scope) true)
     (let [es (.get ^java.util.HashMap (:names scope) (ucn-name nm))
           es (if (= :ns (:kind scope)) (filterv #(< (long (or (:pos %) -1)) (long *cutoff*)) es) es)]
       (concat es (doall (mapcat #(own-names % nm seen) (:usings scope))))))))

(defn- find-here
  "The entities `nm` names in `scope` itself (a class: with its bases', [class.member.lookup])."
  ([scope ^String nm] (find-here scope nm false))
  ([scope ^String nm unqualified?]
   (if (= :class (:kind scope))
     (seq (map second (class-lookup (:cls scope) nm unqualified?)))
     (seq (own-names scope nm)))))

(declare header-entities)

(declare builtin-entities)

;; queue 487 (the checker): an ambiguous name found through using-directives, [basic.lookup.general]/1 and /4 ("if the
;; declarations found ... do not all denote the same entity ... the program is ill-formed", unless they are functions or a
;; type hidden by a non-type), with [namespace.udir]/2 and /4 (unqualified lookup: a nominated namespace's members appear as
;; if declared in the nearest enclosing namespace that contains both the directive and the namespace, transitively) and
;; [namespace.qual]/2 (qualified lookup: X's own declarations and its inline namespace set's, else the union over the
;; namespaces X's directives nominate, each such set alike). GCC's "reference to 'X' is ambiguous". The own-names approximation
;; puts the nominated members at the directive's scope; the checker's own sets below are exact where they are judged:
;; unqualified, from the global namespace or from blocks of a function of it (every nominated namespace then appears at the
;; global namespace), no block or parameter scope declaring the name; qualified, in a namespace. Judged only when every
;; declaration found is a variable, or every one a type the checker knows whole (cx-type-key), or (unqualified) every one a
;; namespace; and two of them differ. A namespace-scope directive at or after *cutoff* is not in force yet.
(def ^:dynamic *cx-udir-pos* nil) ; IdentityHashMap: a scope's :usings list -> IdentityHashMap {nominee's :names -> the directive's position}

(declare cx-type-key lookup-qualified lookup check-type-access! class-id cx-incomplete-cls cx-type-friend?)

(defn- cx-udir-visible? [s u]
  (or (not= :ns (:kind s))
      (let [^java.util.IdentityHashMap m (some-> ^java.util.IdentityHashMap *cx-udir-pos* (.get (:usings s)))
            p (when m (.get m (:names u)))]
        (or (nil? p) (< (long p) (long *cutoff*))))))

(defn- cx-own [s ^String nm]
  ;; (cpp-decl2: a scope without names, a using-directive's nominee no declaration made -- `using namespace std;` without a
  ;; header, lookup/missing-std-include-7.C -- has none of them)
  (let [es (some-> ^java.util.HashMap (:names s) (.get (ucn-name nm)))]
    (if (= :ns (:kind s)) (filterv #(< (long (or (:pos %) -1)) (long *cutoff*)) es) (vec es))))

(defn- cx-inline-ns? [u] (.containsKey ^java.util.HashMap (:names u) " inline"))

(defn- cx-nominees!
  "The namespaces `s`'s directives in force nominate, transitively, each once (added to `out`)."
  [s ^java.util.IdentityHashMap seen ^java.util.ArrayList out]
  (doseq [u (:usings s) :when (and (not (.containsKey seen (:names u))) (cx-udir-visible? s u))]
    (.put seen (:names u) true)
    (.add out u)
    (cx-nominees! u seen out)))

(defn- cx-ambiguous-set?
  [es ns-ok?]
  (and (> (count es) 1)
       (let [k (:e (first es))]
         (and (every? #(= k (:e %)) es)
              (#{:var :type :ns} k)
              (or ns-ok? (not= :ns k))
              (let [ks (map #(case k :var (:id %) :type (cx-type-key (:ty %)) :ns (some-> (:scope %) :names System/identityHashCode)) es)]
                (and (every? some? ks) (> (count (distinct ks)) 1)))))))

(defn- cx-unqualified-ambiguous!
  [scope ^String nm]
  (let [chain (vec (take-while some? (iterate :parent scope)))
        root (peek chain)
        inner (pop chain)]
    (when (and (= :ns (:kind root)) (every? #(#{:block :fn} (:kind %)) inner) (not-any? #(seq (cx-own % nm)) inner))
      (let [seen (java.util.IdentityHashMap.) us (java.util.ArrayList.)]
        (.put seen (:names root) true)
        (doseq [s chain] (cx-nominees! s seen us))
        (let [es (into (cx-own root nm) (mapcat #(cx-own % nm) us))]
          (when (cx-ambiguous-set? es true)
            (fail :ambiguous "reference to '" nm "' is ambiguous")))))))

(defn- cx-qualified-set
  "[namespace.qual]/2's S(X, m) for the namespace scope `x`."
  [x ^String nm ^java.util.IdentityHashMap seen]
  (when-not (.containsKey seen (:names x))
    (.put seen (:names x) true)
    (let [iset (loop [todo [x] out []] (if-let [s (first todo)] (recur (into (vec (rest todo)) (filter cx-inline-ns? (:usings s))) (conj out s)) out))
          own (vec (mapcat #(cx-own % nm) iset))]
      (if (seq own)
        own
        (vec (for [s iset u (:usings s) :when (and (not (cx-inline-ns? u)) (cx-udir-visible? s u))
                   e (cx-qualified-set u nm seen)]
               e))))))

(def ^:dynamic *cx-hdr-ns* nil) ; IdentityHashMap: the :names of the namespaces a header's declaration opens (queue 487)

(defn- cx-ns-lacks?
  "Queue 487, the checker: [basic.lookup.qual]/1 with [namespace.qual]/2, a qualified name `nm` whose qualifier `q` names a
  namespace that declares nothing of that name visible here (S(X, nm) empty), when that namespace, its inline namespace set and
  the namespaces it nominates are the main file's alone (no header opens one: the headers' namespaces are read in part) and
  are not the global namespace. GCC's \"'x' is not a member of 'N'\"."
  [scope q g ^String nm]
  (when (and (checking?) *cx-hdr-ns* (seq q))
    (let [x (try (:scope (first (filter #(= :ns (:e %)) (lookup-qualified scope q g)))) (catch arbace.lang.ExceptionInfo _ nil))]
      (when (and x (= :ns (:kind x)) (:parent x))
        (let [seen (java.util.IdentityHashMap.)]
          (and (empty? (cx-qualified-set x nm seen))
               (not-any? #(.containsKey ^java.util.IdentityHashMap *cx-hdr-ns* %) (.keySet seen))))))))

;; queue 492 (the checker): the names any declaration of the headers names (the native parser's nodes of the headers, in
;; full), so a name none of them names is not one the analysis could have missed in a part of a header it skipped.
(def ^:dynamic *cx-copy-list* false)
(def ^:dynamic *cx-hdr-names* nil) ; a delay of a HashSet of names

(declare header-node?)

(defn- cx-hdr-names [nodes]
  (delay (let [hs (java.util.HashSet.) bad (atom false)]
           (letfn [(w [x] (cond (map? x) (do (when (= "NativeDecline" (:kind x)) (reset! bad true))
                                            (when (and (string? (:name x)) (string? (:kind x)) (str/ends-with? (:kind x) "Decl")) (.add hs (:name x)))
                                            (doseq [[k v] x :when (and (not= k :_ent) (coll? v))] (w v)))
                                (sequential? x) (doseq [y x] (w y))
                                :else nil))]
             (doseq [n nodes :when (header-node? n)] (w n)))
           (when-not @bad hs))))

(def ^:dynamic *cx-all-names* nil) ; a delay of a HashSet: the names any declaration of the unit names, the main file's too

(defn- cx-all-names [nodes]
  (delay (let [hs (java.util.HashSet.) bad (atom false)]
           (letfn [(w [x] (cond (map? x) (do (when (= "NativeDecline" (:kind x)) (reset! bad true))
                                            (when (and (string? (:name x)) (string? (:kind x)) (str/ends-with? (:kind x) "Decl")) (.add hs (:name x)))
                                            (doseq [[k v] x :when (and (not= k :_ent) (coll? v))] (w v)))
                                (sequential? x) (doseq [y x] (w y))
                                :else nil))]
             (w nodes))
           (when-not @bad hs))))

;; queue 526 (518-1 (a), the checker): the names a refusal dropped -- a main-file declaration of namespace scope, a member of a
;; main-file class that is no template's specialization, a specialization's member template whose template parameters do not
;; resolve -- an atom of a set (nil: off, the code generator). GCC goes on past an erroneous declaration and keeps its name, an
;; error type, so that later uses of it say nothing; here the declaration is gone, and a later refusal whose message quotes such
;; a name, or whose node's text names it, is the dropped declaration's cascade: not reported (cx-poisoned?).
(def ^:dynamic *cx-dropped* nil)

(defn cx-recoverable?
  "Queue 526: a refusal the checker recovers from at a declaration: the slice's or the program's (:codegen/refused, a constant
  the evaluation does not reach, a type's :cpp/gap), not the time cap nor a crash."
  [e]
  (let [d (ex-data e)] (boolean (or (:codegen/refused d) (:codegen/not-constant d) (:cpp/gap d)))))

(declare qualifier-before)
(defn cx-dropped!
  "Queue 526: records the names the dropped declaration node `n` of `scope` declares (its own, and its class's when a member),
  for cx-poisoned?. A name whose entity stands -- a qualified declarator's (an out-of-line member's, `template<> int
  A::v<int>;`), or one a visible declaration already declares (a redeclaration; not a class's or an enumeration's, which
  enters itself before its body refuses) -- is not recorded: its uses are not the
  dropped declaration's cascade (cpp2a/concepts-var-templ1a.C's A::v<char>)."
  [scope n]
  (when *cx-dropped*
    (let [nm (:name n)
          op? (and (string? nm) (re-matches #"operator\s*\S.*" nm))
          own? (and (string? nm) (or op? (re-matches #"[A-Za-z_][A-Za-z_0-9]*" nm))
                    (empty? (try (qualifier-before n) (catch Exception _ nil)))
                    ;; (an operator function's name always: the implicit global allocation functions stand beside a
                    ;; dropped placement operator new, warn/Wplacement-new-size-6.C's after its size_t's typedef refused)
                    (or op?
                    ;; (a class, a class template or an enumeration is entered before its body refuses: its own entity)
                    (or (#{"CXXRecordDecl" "ClassTemplateDecl" "EnumDecl" "ClassTemplatePartialSpecializationDecl"} (:kind n))
                        (empty? (try (lookup scope nm) (catch Exception _ nil))))))
          nms (cond-> #{}
                own? (conj nm)
                (:cls scope) (into (keep #(when (and (string? %) (re-matches #"[A-Za-z_][A-Za-z_0-9]*" %)) %)
                                         [(some-> (abi/cls (:cls scope)) :name (str/replace #"<.*$" "") (str/split #"::") last)])))]
      (when (seq nms) (swap! *cx-dropped* into nms)))))

(def ^:private cx-word-res (java.util.concurrent.ConcurrentHashMap.))
(defn- cx-word-re [^String nm]
  (or (.get cx-word-res nm)
      (let [r (re-pattern (str "(?<![A-Za-z0-9_$])" (java.util.regex.Pattern/quote nm) "(?![A-Za-z0-9_$])"))] (.put cx-word-res nm r) r)))

(defn cx-dropped-class?
  "Queue 526: whether the class `cid` is named by a dropped declaration (*cx-dropped*): its own refused, or one of its members."
  [cid]
  (boolean
   (when-let [ds (some-> *cx-dropped* deref not-empty)]
     (when-let [nm (some-> (abi/cls cid) :name str)]
       (contains? ds (-> nm (str/replace #"<.*$" "") (str/split #"::") last str/trim))))))

(defn cx-poison-class!
  "Queue 526: records the class `cid`'s name among the dropped ones (*cx-dropped*): a refusal changed it."
  [cid]
  (when-let [nm (and *cx-dropped* (some-> (abi/cls cid) :name str (str/replace #"<.*$" "") (str/split #"::") last str/trim not-empty))]
    (when (re-matches #"[A-Za-z_][A-Za-z_0-9]*" nm) (swap! *cx-dropped* conj nm))))

(declare node-text)
(defn- cx-poisoned?
  "Queue 526: whether the refusal `e` at the node `n` follows from a dropped declaration (*cx-dropped*): its message quotes a
  dropped name ('x', 'x<...>', 'x::...', or after \"no member \", \"unknown name \", \"unknown type \", \"for \"), or the text of its
  node names one."
  [e n]
  (let [ds (some-> *cx-dropped* deref)]
    (boolean
     (when (seq ds)
       (let [m (if (instance? Throwable e) (str (ex-message e)) "")
             nd (or (when (instance? Throwable e) (:cx/node (ex-data e))) n)
             t (when (map? nd) (try (node-text nd) (catch Exception _ nil)))]
         (or (some (fn [^String nm]
                     (or (and (str/starts-with? nm "operator") (str/includes? m nm))
                         (re-find (re-pattern (str "(?:'|\\b(?:no member|unknown name|unknown type|for) )" (java.util.regex.Pattern/quote nm) "(?![A-Za-z0-9_$])")) m)
                         (and t (re-find (cx-word-re nm) t))))
                   ds)
             ;; (a type the message spells as data, {:k :class :id N}: a dropped class's)
             (some (fn [[_ i]] (cx-dropped-class? (Long/parseLong i))) (re-seq #":k :class, :id (\d+)" m))))))))

(defn- cx-declared-nowhere?
  "Queue 492: no declaration of the unit, a header's or the main file's, a member, a hidden friend or a local, names `nm`: no
  lookup, unqualified, qualified or argument-dependent, at any point, can find it ([basic.lookup.argdep]/4)."
  [^String nm]
  (and (checking?) *cx-all-names* @*cx-all-names* (string? nm) (re-matches #"(?:operator\"\")?[A-Za-z_][A-Za-z_0-9]*" nm) (not (str/starts-with? nm "__"))
       (not (.contains ^java.util.HashSet @*cx-all-names* nm))))

(defn- cx-undeclared?
  "Queue 492: `nm`, an identifier, is surely undeclared from `scope`: unqualified lookup finds nothing there wherever the
  main file's declaration (no position cut-off), and no declaration of the headers has that name."
  [scope ^String nm]
  (and (checking?) *cx-hdr-names* @*cx-hdr-names* (string? nm) (re-matches #"(?:operator\"\")?[A-Za-z_][A-Za-z_0-9]*" nm) (not (str/starts-with? nm "__"))
       (not (.contains ^java.util.HashSet @*cx-hdr-names* nm))
       (empty? (binding [*cutoff* Long/MAX_VALUE] (try (lookup scope nm) (catch arbace.lang.ExceptionInfo _ [:x]))))))

(defn- cx-qualified-ambiguous!
  [x ^String nm]
  (when (= :ns (:kind x))
    (when (cx-ambiguous-set? (cx-qualified-set x nm (java.util.IdentityHashMap.)) false)
      (fail :ambiguous "reference to '" nm "' is ambiguous"))))

(defn lookup
  "Unqualified lookup: the entities of the first scope outward that declares `nm` (the headers' last, through the
  native parser's scopes)."
  [scope ^String nm]
  (when (checking?) (cx-unqualified-ambiguous! scope nm))
  (when (and nm (= nm (System/getenv "CPP_LOOKUP_TRACE")))
    (binding [*out* *err*]
      (loop [s scope] (when s (println "lookup" nm (:kind s) (count (:usings s)) (pr-str (map #(select-keys % [:e :pos]) (.get ^java.util.HashMap (:names s) nm)))
                                       (pr-str (map (fn [u] (map #(select-keys % [:e :pos]) (.get ^java.util.HashMap (:names u) nm))) (:usings s))) *cutoff*) (recur (:parent s))))))
  (or (loop [s scope] (when s (or (find-here s nm true) (recur (:parent s)))))
      (header-entities [nm])
      (builtin-entities nm)))

;; ---------------------------------------------------------------------------------------------
;; Classes: members by name, through the bases

(defn class-lookup
  "[[class-id entity] ...]: the members named `nm` in class `id` or, if none, in its bases ([class.member.lookup]: the
  bases' sets merged, a set found in a base of another found one's class dropped -- dominance through virtual bases;
  of the rest the first). `unqualified?`: an unqualified name in a template's specialization does not look into a base
  that was dependent in the pattern ([temp.dep]/4: two-phase lookup's first phase; this-> and qualified names do)."
  ([id ^String nm] (class-lookup id nm false))
  ([id ^String nm unqualified?]
   (let [c (abi/cls id)
         own (seq (.get ^java.util.HashMap (:names (:scope c)) (ucn-name nm)))]
     (if own
       (mapv (fn [e] [id e]) own)
       ;; (cpp-tzdb: a base whose type is no class, a pattern's dependent base without a class id, holds no member: the
       ;; lookup had recurred on nil, a crash in tzdb.cc)
       (let [found (keep #(when (:cls %) (seq (class-lookup (:cls %) nm unqualified?))) (if unqualified? (remove :dependent (:bases c)) (:bases c)))
             keep? (fn [r] (not-any? (fn [o] (abi/derived-from? (ffirst o) (ffirst r))) found))
             kept (filter keep? found)]
         ;; (cpp-decl2, the checker: [class.member.lookup]/6, the sets of two bases' classes differing make the lookup
         ;; ambiguous: GCC's "request for member 'f' is ambiguous"; judged for functions and data members of the main file's
         ;; classes, cpp2a/concepts-memfun4.C's S2<>{}.f() over B<>::f and C<>::f)
         (when (and (checking?) (>= (count (distinct (map ffirst kept))) 2)
                    (every? (fn [r] (every? #(#{:fn :field} (:e (second %))) r)) kept)
                    (not-any? #(:header (abi/cls (ffirst %))) kept) (not (:header c)))
           (fail :ambiguous "reference to '" nm "' is ambiguous (found in several base classes)"))
         (first kept))))))

;; ---------------------------------------------------------------------------------------------
;; Types from clang's qualType strings

(declare resolve-type-form resolve-type lookup-qualified const-int cx-typedef-redecl! cx-incomplete-cls cx-type-key)

;; ---------------------------------------------------------------------------------------------
;; The headers' declarations: the native parser skims them into its scopes (arbace.repr.cpp.scope); a C function
;; (extern "C", its entity's :clink) and a typedef of a builtin or pointer type are taken from there

(def ^:dynamic *proot* nil)   ; the native parser's global scope
(def ^:dynamic *root* nil)    ; ours
(def ^:dynamic *header-cache* nil) ; atom {parts entities}

(defn- opaque-class
  "A class the headers declare and the program uses only through pointers (FILE's struct _IO_FILE): incomplete. (cpp-rt-own: the
  class of that name the global namespace declares when it does, and else one entered there, as an elaborated-type-specifier's
  `struct X` declares X in the namespace that holds it, [basic.scope.pdecl]/7 and [dcl.type.elab]/3, so that its definition later
  completes it: libcpp's symtab.h `typedef int (*ht_cb) (struct cpp_reader *, hashnode, const void *);` before internal.h's
  `struct cpp_reader { ... }`, two classes before, `no member hash_ob of cpp_reader`)"
  [^String nm]
  (or (get @*header-cache* [:opaque nm])
      (when-let [e (some #(when (and (= :type (:e %)) (abi/class? (:ty %))) %) (.get ^java.util.HashMap (:names *root*) nm))]
        (:ty e))
      (let [id (next-id) t {:k :class :id id}]
        (swap! abi/*classes* assoc id {:id id :name nm :path [] :scope (new-scope :class *root* :cls id :path [[:cls id]]) :fields [] :bases [] :outer *root*})
        (swap! *header-cache* assoc [:opaque nm] t)
        (when-not (seq (.get ^java.util.HashMap (:names *root*) nm)) (enter! *root* nm {:e :type :ty t :pos -1}))
        t)))

(declare finish-class!)

(defn- va-list-tag
  "x86-64's struct __va_list_tag {unsigned gp_offset, fp_offset; void *overflow_arg_area, *reg_save_area;} (the SysV
  psABI §3.5.7), a complete trivial class (a va_list local is default-initialized: nothing runs)."
  []
  (or (get @*header-cache* [:va-list])
      (let [id (next-id) t {:k :class :id id}
            u (abi/b :uint) vp (abi/ptr abi/void)]
        (swap! abi/*classes* assoc id {:id id :name "__va_list_tag" :path [] :scope (new-scope :class *root* :cls id :path [[:cls id]])
                                       :bases [] :outer *root* :complete true
                                       :fields (vec (map-indexed (fn [i [nm ty]] {:name nm :ty ty :access :public :i i})
                                                                 [["gp_offset" u] ["fp_offset" u] ["overflow_arg_area" vp] ["reg_save_area" vp]]))})
        (finish-class! id)
        (swap! *header-cache* assoc [:va-list] t)
        t)))

(defn- ptype->type
  "Our type of the native parser's type map (a builtin's words, a pointer, a named type through its entity)."
  [t]
  (let [r (case (:t t)
            :b (resolve-type-form *root* (ct/builtin-symbol (:w t)))
            :p (abi/ptr (ptype->type (:of t)))
            :n (let [e (:ent t)]
                 (cond (:ty e) (ptype->type (:ty e))
                       (:target e) (ptype->type (:ty (:target e)))
                       (and (:tag e) (#{"struct" "class" "union"} (:tag e))) (opaque-class (:name e))
                       :else (fail :header-type "header type " (:s t))))
            :elab (if (#{"struct" "class" "union"} (:kw t)) (opaque-class (:s t)) (fail :header-type "header type " (:s t)))
            ;; (cpp-rt-own: a function type, a header's pointer to function: libcpp's symtab.h ht_cb)
            :f {:k :fn :ret (ptype->type (:r t))
                :ps (mapv (fn [p] (let [u (ptype->type p)] (cond (abi/arr? u) (abi/ptr (:of u)) (abi/fn? u) (abi/ptr u) :else u)))
                          (if (and (= 1 (count (:ps t))) (= :b (:t (first (:ps t)))) (= ["void"] (vec (:w (first (:ps t)))))) [] (:ps t)))
                :va (boolean (:va t))}
            (fail :header-type "header type " (pr-str (dissoc t :ent))))]
    (cond-> r (:c t) (assoc :c true) (:v t) (assoc :v true))))

(def ^:private nothrow-libc
  #{"memcpy" "memmove" "memset" "memcmp" "memchr" "strlen" "strcmp" "strncmp" "strcpy" "strncpy" "strcat" "strncat" "strchr"
    "strrchr" "strstr" "strspn" "strcspn" "strpbrk" "abs" "labs" "llabs" "fabs" "sqrt" "sin" "cos" "tan" "exp" "log" "pow" "floor"
    "ceil" "fmod" "malloc" "calloc" "realloc" "free" "toupper" "tolower" "isalpha" "isdigit" "isspace" "isupper" "islower" "isalnum"
    ;; (G5c: the ones that do not return, Builtins' NoThrow and NoReturn)
    "abort" "exit" "_Exit" "quick_exit"})

;; queue 351: the C library functions clang 23.1.5 declares NoThrow (clang/include/clang/Basic/Builtins.td's LibBuiltin defs
;; with NoThrow among their Attributes, as Sema::AddKnownFunctionAttributes adds it to their extern "C" declarations): calls
;; of them are nounwind, never an invoke (assert_fail.cc's fprintf in a noexcept function: no terminate pad)
(def ^:private clang-nothrow-libc
  #{"abort" "fprintf" "isalnum" "isalpha" "isblank" "iscntrl" "isdigit" "isgraph" "islower" "isprint" "ispunct" "isspace"
    "isupper" "isxdigit" "memchr" "memcpy" "memmove" "memset" "snprintf" "sprintf" "strcat" "strchr" "strcmp" "strcpy"
    "strlen" "strncat" "strncmp" "strncpy" "strpbrk" "strrchr" "strspn" "strstr" "tolower" "toupper" "umask" "va_copy"
    "va_end" "va_start" "vfprintf" "vprintf" "vsnprintf" "vsprintf" "wcschr" "wcscmp" "wcslen" "wcsncmp" "wmemchr" "wmemcmp"
    "wmemcpy" "wmemmove"})

(defn header-entities
  "Our entities for the header declaration the parts name ([\"printf\"], [\"std\" \"printf\"]), or nil."
  [parts]
  (if (= parts ["__builtin_abort"])
    ;; the builtin clang calls as abort (CodeGen's EmitBuiltinExpr for __builtin_abort)
    (or (get @*header-cache* parts)
        (let [id (next-id)]
          (swap! *fns* assoc id {:id id :name "abort" :kind :fn :ty {:k :fn :ret abi/void :ps [] :va false} :linkage :c :path []
                                 :scope *root* :param-names [] :defaults [] :pos -1 :header true :noreturn true})
          (swap! *header-cache* assoc parts [{:e :fn :id id :pos -1}])
          [{:e :fn :id id :pos -1}]))
  (when *proot*
    (or (get @*header-cache* parts)
        (let [pe (loop [s *proot* [p & more] parts]
                   (when s
                     (let [e (if (identical? s *proot*) (arbace.repr.cpp.scope/lookup s p) (arbace.repr.cpp.scope/find-in s p))]
                       (if (empty? more) e (recur (:scope e) more)))))
              es (when pe
                   (case (:k pe)
                     :fn (when (and (:clink pe) (not (:tmpl pe)) (:qt pe))
                           (when (:ovl pe) (fail :header-overload "an overloaded header function " (last parts)))
                           (let [id (next-id)
                                 f {:id id :name (:name pe) :kind :fn :ty (resolve-type *root* (:qt pe)) :linkage :c :path []
                                    :scope *root* :param-names [] :defaults [] :pos -1 :header true
                                    ;; the C library functions clang knows as nothrow builtins (nounwind at their calls)
                                    :noexcept (boolean (or (nothrow-libc (:name pe)) (clang-nothrow-libc (:name pe))))
                                    ;; (and as not returning: Builtins.def's abort, exit, _Exit, quick_exit; G5c)
                                    :noreturn (contains? #{"abort" "exit" "_Exit" "quick_exit"} (:name pe))}]
                             (swap! *fns* assoc id f)
                             [{:e :fn :id id :pos -1}]))
                     :var (when (and (:clink pe) (:ty pe) (not (:tmpl pe)))
                            (let [id (next-id)]
                              (swap! *vars* assoc id {:id id :name (:name pe) :ty (ptype->type (:ty pe)) :storage :global :path []
                                                      :linkage :c :defined false :extern true :pos -1 :header true})
                              [{:e :var :id id :pos -1}]))
                     :type (when (and (:ty pe) (not (:tag pe)) (not (:tmpl pe))) [{:e :type :ty (ptype->type (:ty pe)) :pos -1}])
                     nil))]
          (swap! *header-cache* assoc parts es)
          es)))))

(def ^:private builtin-fns
  ;; the builtins the samples call, as the C functions they stand for (clang writes some as intrinsics)
  {"__builtin_memcpy" ["memcpy" "void *(void *, const void *, unsigned long)"]
   "__builtin_memmove" ["memmove" "void *(void *, const void *, unsigned long)"]
   "__builtin_memset" ["memset" "void *(void *, int, unsigned long)"]
   "__builtin_memcmp" ["memcmp" "int (const void *, const void *, unsigned long)"]
   "__builtin_strlen" ["strlen" "unsigned long (const char *)"]
   "__builtin_strcmp" ["strcmp" "int (const char *, const char *)"]
   "__builtin_abs" ["abs" "int (int)"]
   "__builtin_labs" ["labs" "long (long)"]
   "__builtin_strcpy" ["strcpy" "char *(char *, const char *)"]
   "__builtin_strncpy" ["strncpy" "char *(char *, const char *, unsigned long)"]
   "__builtin_strcat" ["strcat" "char *(char *, const char *)"]
   "__builtin_strncmp" ["strncmp" "int (const char *, const char *, unsigned long)"]
   "__builtin_strchr" ["strchr" "char *(const char *, int)"]
   "__builtin_strrchr" ["strrchr" "char *(const char *, int)"]
   "__builtin_memchr" ["memchr" "void *(const void *, int, unsigned long)"]
   "__builtin_printf" ["printf" "int (const char *, ...)"]
   "__builtin_puts" ["puts" "int (const char *)"]
   "__builtin_putchar" ["putchar" "int (int)"]
   "__builtin_exit" ["exit" "void (int)"]
   "__builtin_malloc" ["malloc" "void *(unsigned long)"]
   "__builtin_free" ["free" "void (void *)"]
   "__builtin_vsnprintf" ["vsnprintf" "int (char *, unsigned long, const char *, __builtin_va_list)"]
   "__builtin_vsprintf" ["vsprintf" "int (char *, const char *, __builtin_va_list)"]
   "__builtin_snprintf" ["snprintf" "int (char *, unsigned long, const char *, ...)"]
   "__builtin_sprintf" ["sprintf" "int (char *, const char *, ...)"]
   "__builtin_abort" ["abort" "void ()"]
   ;; (cpp-s8: <format>'s floating-point formatter, __formatter_fp::format's frexp of the value; clang calls libm's frexp,
   ;; frexpf, frexpl for a value not constant; <format>'s _M_format_str's toupper)
   "__builtin_frexp" ["frexp" "double (double, int *)"]
   "__builtin_frexpf" ["frexpf" "float (float, int *)"]
   "__builtin_frexpl" ["frexpl" "long double (long double, int *)"]
   "__builtin_toupper" ["toupper" "int (int)"]
   "__builtin_copysign" ["copysign" "double (double, double)"]
   "__builtin_copysignf" ["copysignf" "float (float, float)"]
   "__builtin_copysignl" ["copysignl" "long double (long double, long double)"]
   ;; never reached (clang writes LLVM's unreachable): abort stands for it (G4: the headers' __builtin_unreachable)
   "__builtin_unreachable" ["abort" "void ()"]})

(defn- builtin-entities [^String nm]
  (when-let [[cn qt] (builtin-fns nm)]
    (or (get @*header-cache* [:builtin nm])
        (let [id (next-id)
              es [{:e :fn :id id :pos -1}]]
          (swap! *fns* assoc id {:id id :name cn :kind :fn :ty (resolve-type *root* qt) :linkage :c :path [] :scope *root*
                                 :param-names [] :defaults [] :pos -1 :header true :noexcept (not= cn "abort")
                                 :noreturn (contains? #{"abort" "exit"} cn)})
          (swap! *header-cache* assoc [:builtin nm] es)
          es))))

(def ^:private builtin-syms
  {'void :void 'bool :bool 'char :char 'signed-char :schar 'unsigned-char :uchar 'short :short 'unsigned-short :ushort
   'int :int 'unsigned :uint 'long :long 'unsigned-long :ulong 'long-long :llong 'unsigned-long-long :ullong
   ;; (cpp-s5: GNU's __int128, [basic.fundamental]/1's extended integer types as clang has them on x86-64: <format>'s
   ;; _Arg_value union and _S_to_arg_type, under __SIZEOF_INT128__)
   '__int128 :i128 'unsigned-__int128 :u128 '__int128_t :i128 '__uint128_t :u128
   '_Float16 :float16 '__float128 :float128
   ;; (cpp-extfloat: GCC's extended floating-point types, the own front end's keywords; abi/fp-rank-cmp)
   '_Float32 :float32 '_Float64 :float64 '_Float128 :float128n '_Float32x :float32x '_Float64x :float64x '__bf16 :bf16
   'float :float 'double :double 'long-double :ldouble 'wchar_t :wchar 'char8_t :char8 'char16_t :char16 'char32_t :char32
   'std/nullptr_t :nullptr 'nullptr_t :nullptr 'decltype/nullptr :nullptr})

(defn- name-parts [sym] (if (namespace sym) (str/split (str sym) #"/") [(name sym)]))

(defn- type-entity [es] (first (filter #(= :type (:e %)) es)))

(def ^:dynamic *decltypes* nil) ; G4: the native parser's decltype operands {text-without-spaces node}

(declare analyze)

;; (cpp-s2) an atom a caller binds to learn that a decltype's operand did not analyze and was kept as a dependent stand-in:
;; with every argument bound that is a substitution failure ([temp.deduct.general]/8), which a partial specialization's match
;; reads as no match (libstdc++'s __shared_ptr::__has_esft_base<_Yp, __void_t<__esft_base_t<_Yp>>>, whose __void_t drops it)
(def ^:dynamic *decltype-failed* nil)

;; (cpp-s15, CP391 (a): a dependent decltype in a function template's signature is mangled as clang mangles it, Itanium
;; 5.1.5.3's DT <expression> E with 5.1.6's expressions. Its operand is kept beside the stand-in as plain data (`:dt`),
;; made here where the names resolve: the function's parameters fp_ (their index and top-level cv, recorded by
;; declare-fn!'s trailing-return scope), the template's non-type parameters, the types written resolved (their template
;; parameters without their template's id: inert to substitution and deduction, which match parameters by it), the
;; unresolved names as written. What it cannot write is kept as {:x :fail}, refused only when the name is mangled.)
(defn- dt-dependent?
  "Whether a type names a template's parameter (template.ae's dependent?, which sema does not reach)."
  [x]
  (cond (map? x) (or (contains? #{:tparam :tparam-v :tspec :tdep :texpr :pack-exp} (:k x)) (boolean (some dt-dependent? (vals x))))
        (sequential? x) (boolean (some dt-dependent? x))
        :else false))

(defn- dt-strip [t]
  (cond (and (map? t) (#{:tparam :tparam-v :ttp} (:k t))) (dissoc t :tid)
        (map? t) (into {} (map (fn [[k v]] [k (dt-strip v)]) t))
        (vector? t) (mapv dt-strip t)
        :else t))

(defn- dt-type [scope ^String s]
  (try (dt-strip (resolve-type scope s))
       (catch arbace.lang.ExceptionInfo _ {:x :fail :what (str "type " s)})))

(defn- dt-targ
  "An explicit template argument as written: an integer literal, a non-type parameter, else a type."
  [scope ^String s]
  (let [s (str/trim s)]
    (cond
      (re-matches #"\d+" s) {:val (Long/parseLong s) :ty (abi/b :int)}
      :else (let [e (when (re-matches #"[A-Za-z_]\w*" s) (first (lookup scope s)))]
              (if (= :nttp (:e e)) {:k :tparam-v :i (:i e)} (dt-type scope s))))))


(def ^:private dt-unops {"*" "de" "&" "ad" "-" "ng" "+" "ps" "!" "nt" "~" "co"})
(def ^:private dt-binops
  {"+" "pl" "-" "mi" "*" "ml" "/" "dv" "%" "rm" "<<" "ls" ">>" "rs" "&" "an" "|" "or" "^" "eo" "<" "lt" ">" "gt"
   "<=" "le" ">=" "ge" "==" "eq" "!=" "ne" "&&" "aa" "||" "oo" "=" "aS" "," "cm" "+=" "pL" "-=" "mI" "*=" "mL" "/=" "dV"
   "%=" "rM" "&=" "aN" "|=" "oR" "^=" "eO" "<<=" "lS" ">>=" "rS" "<=>" "ss" ".*" "ds" "->*" "pm"})
(def ^:private dt-casts {"CXXStaticCastExpr" "sc" "CStyleCastExpr" "cv" "CXXReinterpretCastExpr" "rc" "CXXConstCastExpr" "cc"
                         "CXXDynamicCastExpr" "dc"})

(defn- dt-written-type
  "A cast's or construction's type as written: the node's type with the reference its value category says."
  ^String [n]
  (str (get-in n [:type :qualType]) (case (:valueCategory n) "lvalue" " &" "xvalue" " &&" "")))

(defn- dt-ir
  "The operand `n` (the native parser's node) of a dependent decltype as the mangler's data, its names resolved in `scope`."
  [scope n]
  (let [ir #(dt-ir scope %)
        in (vec (filter map? (:inner n)))
        targs (fn [n] (when-let [as (:explicitTemplateArgs n)] (mapv #(dt-targ scope %) as)))
        simple (fn [nm] (if (or (empty? nm) (str/starts-with? nm "~") (str/starts-with? nm "operator"))
                          {:x :fail :what (str "name " nm)} nm))
        member (fn [n base]
                 (let [nm (simple (or (:member n) (:name n) (get-in n [:referencedDecl :name])))]
                   (cond (map? nm) nm
                         (seq (:qualifier n)) {:x :fail :what "a qualified member"}
                         (or (nil? base) (and (= "CXXThisExpr" (:kind base)) (:implicit base)))
                         {:x :mem :implicit true :n nm :targs (targs n)}
                         :else {:x :mem :arrow (boolean (:isArrow n)) :base (ir base) :n nm :targs (targs n)})))]
    (case (:kind n)
      ("ParenExpr" "ImplicitCastExpr") (ir (first in))
      ("CallExpr" "CXXMemberCallExpr") {:x :call :f (ir (first in)) :args (mapv ir (rest in))}
      ("MemberExpr" "CXXDependentScopeMemberExpr") (member n (first in))
      "UnresolvedMemberExpr" (member n (first in))
      ("DeclRefExpr" "UnresolvedLookupExpr")
      (let [nm (get-in n [:referencedDecl :name]) q (:qualifier n)]
        (cond
          (:_this n) (member n nil)
          (:globalQualifier n) {:x :fail :what "a ::-qualified name"}
          (map? (simple nm)) (simple nm)
          (seq q)
          (let [e (when (= 1 (count q)) (type-entity (lookup scope (str/trim (first q)))))
                qt (when e (abi/unq (:ty e)))]
            (cond
              ;; T::f, a template parameter's member: sr <unresolved-type> <base-unresolved-name>
              (= :tparam (:k qt)) {:x :name :qt (dt-strip qt) :n nm :targs (targs n)}
              (some #(not (re-matches #"\s*[A-Za-z_]\w*\s*" (str %))) q) {:x :fail :what (str "a qualifier " (pr-str q))}
              :else {:x :name :q (mapv str/trim q) :n nm :targs (targs n)}))
          :else
          (let [es (lookup scope nm) e (first es) v (when (= :var (:e e)) (var* (:id e)))]
            (cond
              (:fpi v) {:x :fp :i (:fpi v) :c (boolean (:c (:ty v))) :v (boolean (:v (:ty v)))}
              (= :nttp (:e e)) {:x :tpv :i (:i e)}
              ;; (cpp-rt-own2: a non-static data member of the enclosing class named alone, an implicit this's member access,
              ;; clang's dtdefpT <name>: <bits/refwrap.h>'s _Mem_fn_base<_MemObjPtr, false>::operator()'s
              ;; decltype(std::__invoke(_M_pm, ...)), fs_ops' and exp ops' _Mem_fn_base<long stat::*>, had been sr-less 5_M_pm)
              (= :field (:e e)) (member n nil)
              ;; (a variable not a parameter: clang's L <mangled> E, not written)
              v {:x :fail :what (str "variable " nm)}
              ;; a function's or template's name, or nothing found: an unresolved name (the call's ADL)
              :else {:x :name :n nm :targs (targs n)}))))
      "CXXThisExpr" {:x :raw :s "fpT"}
      "UnaryOperator" (if-let [c (dt-unops (:opcode n))] {:x :op :code c :args [(ir (first in))]} {:x :fail :what (str "operator " (:opcode n))})
      ("BinaryOperator" "CompoundAssignOperator")
      (if-let [c (dt-binops (:opcode n))] {:x :op :code c :args (mapv ir in)} {:x :fail :what (str "operator " (:opcode n))})
      "ConditionalOperator" {:x :op :code "qu" :args (mapv ir in)}
      "ArraySubscriptExpr" (if (= 2 (count in)) {:x :op :code "ix" :args (mapv ir in)} {:x :fail :what "a subscript"})
      "PackExpansionExpr" {:x :op :code "sp" :args [(ir (first in))]}
      "CXXNoexceptExpr" {:x :op :code "nx" :args [(ir (first in))]}
      "IntegerLiteral" (let [v (str (:value n))]
                         (if (re-matches #"\d+" v) {:x :lit :t (dt-type scope (or (get-in n [:type :qualType]) "int")) :v v} {:x :fail :what (str "literal " v)}))
      "CXXBoolLiteralExpr" {:x :raw :s (if (:value n) "Lb1E" "Lb0E")}
      "CXXNullPtrLiteralExpr" {:x :raw :s "LDnE"}
      "UnaryExprOrTypeTraitExpr"
      (let [k (get {"sizeof" ["st" "sz"] "alignof" ["at" "az"] "_Alignof" ["at" "az"] "__alignof" ["at" "az"]} (:name n))]
        (cond (nil? k) {:x :fail :what (:name n)}
              (:argType n) {:x :tyop :code (first k) :t (dt-type scope (get-in n [:argType :qualType]))}
              :else {:x :op :code (second k) :args [(ir (first in))]}))
      ;; sizeof...(P): sZ <template-param> or sZ <function-param>
      "SizeOfPackExpr" (let [es (lookup scope (:name n)) te (type-entity es) e (first es)
                             v (when (= :var (:e e)) (var* (:id e)))]
                         (cond (= :tparam (:k (:ty te))) {:x :sz :i (:i (:ty te))}
                               (= :nttp (:e e)) {:x :sz :i (:i e)}
                               (:fpi v) {:x :op :code "sZ" :args [{:x :fp :i (:fpi v) :c false :v false}]}
                               :else {:x :fail :what "sizeof..."}))
      ("CXXUnresolvedConstructExpr" "CXXTemporaryObjectExpr" "CXXFunctionalCastExpr")
      (let [li (and (= 1 (count in)) (= "InitListExpr" (:kind (first in))))]
        {:x :construct :t (dt-type scope (dt-written-type n)) :list li
         :args (mapv ir (if li (filter map? (:inner (first in))) in))})
      (if-let [c (dt-casts (:kind n))]
        {:x :cast :code c :t (dt-type scope (dt-written-type n)) :args [(ir (first in))]}
        {:x :fail :what (str "a " (:kind n))}))))

(declare sure-failure?)

(defn- decltype-of
  "decltype(e) ([dcl.type.decltype]/1): the operand the native parser kept for the text `t`, analyzed in `scope`
  (unevaluated: its result is not kept); an unparenthesized id-expression or member access its entity's declared type,
  else T& for an lvalue, T&& for an xvalue, T for a prvalue."
  [scope ^String t]
  (let [n (get *decltypes* (str/replace t #"\s+" ""))]
    (when-not n
      (when (System/getenv "CPP_TMPL_TRACE") (binding [*out* *err*] (println "decltype(" t ") not kept by the parser")))
      (fail :decltype "decltype(" t ")"))
    (let [outer *decltype-failed*
          ;; (the failures of the decltypes the operand's analysis meets on the way, overload candidates' signatures, are
          ;; theirs: only this decltype's own is its caller's, cpp-s2)
          x (try (binding [*decltype-failed* nil *unevaluated* true] (analyze {:scope scope :statics (atom [])} n))
                 ;; (an operand that does not analyze, a template's parameters in it: a dependent type, the decltype
                 ;; analyzed again where the arguments are bound; G4: __void_t<decltype(declval<_Alloc&>().allocate(...))>)
                 (catch arbace.lang.ExceptionInfo e
                   ;; (cpp-tpl2, the checker: in a function template's signature substituted, an operand whose error is surely the
                   ;; program's, sure-failure?'s, is a substitution failure, [temp.deduct.general]/8 ("invalid types and expressions
                   ;; ... in the immediate context"): cx-subst-fail! with its message and node, GCC's explanation)
                   (when (and (cx-subst?) (sure-failure? e) (not (:cx/subst (ex-data e))))
                     (throw (ex-info (str "codegen: " (subs (str (ex-message e)) 9)) (assoc (ex-data e) :codegen/refused :subst :cx/sure-drop true :cx/subst true))))
                   (when (and (cx-subst?) (:cx/subst (ex-data e))) (throw e))
                   (if (:codegen/refused (ex-data e))
                     (do (when (System/getenv "CPP_TMPL_TRACE") (binding [*out* *err*] (println "decltype(" t ") dependent:" (.getMessage e))))
                         ;; (only an unknown name, a lookup that found nothing after argument-dependent lookup, is
                         ;; taken for a real substitution failure: the analysis' own gaps, `size_t{}` as an argument,
                         ;; refuse with other classes, which keep the dependent stand-in as before)
                         (when (and outer (= :name (:codegen/refused (ex-data e)))) (reset! outer true))
                         {:dependent-decltype t})
                     (throw e))))]
      (cond
        ;; (cpp-s15, CP391 (a): in a function's type, an operand that analyzed but is type-dependent ([temp.dep.expr]: its
        ;; type, or a parameter it names, depends on the template's parameters) is the dependent decltype too, clang's DT
        ;; in the mangling, not the type the pattern's analysis gave: `decltype(ns::id<T>(t))`, `decltype(hh(t, t))::type`)
        (or (:dependent-decltype x)
            (and (loop [s scope] (cond (nil? s) false (:fn-type s) true :else (recur (:parent s))))
                 (or (dt-dependent? (:ty x))
                     (some #(and (map? %) (#{"DeclRefExpr" "UnresolvedLookupExpr"} (:kind %)) (empty? (:qualifier %))
                                 (let [e (first (lookup scope (str (get-in % [:referencedDecl :name])))) v (when (= :var (:e e)) (var* (:id e)))]
                                   (and (:fpi v) (dt-dependent? (:ty v)))))
                           (tree-seq map? #(filter map? (:inner %)) n)))))
        {:k :tdep :base {:k :tparam :i -1 :tid -1 :name "decltype"} :names [(str "decltype(" t ")")]
         :dt (dt-ir scope n)}
        (and (= "DeclRefExpr" (:kind n)) (= :var (:op x))) (:ty (var* (:id x)))
        ;; (cpp-tzdb: and a reference's, its declared reference type, not the referred object's -- var-node's deref of the
        ;; raw reference: a generic lambda's `auto&& __lhs` deduced from an lvalue, ranges' __make_comp_proj, `using _TL =
        ;; decltype(__lhs)`, whose std::forward<_TL> had made the projection's argument an rvalue: __invoke<identity&, Z>
        ;; for clang's <identity&, Z&>)
        (and (= "DeclRefExpr" (:kind n)) (= :deref (:op x)) (= :load (:op (:e x))) (= :var (:op (:e (:e x)))) (:raw (:e (:e x)))
             (abi/ref? (:ty (var* (:id (:e (:e x)))))))
        (:ty (var* (:id (:e (:e x)))))
        ;; (cpp-s14: a function's name, an overload set of one function and no template: the function's type
        ;; ([dcl.type.decltype]/1.3, [over.over]/1's set of one: `decltype(f)`, <refwrap.h>'s users); several, ill-formed)
        (and (= :fnset (:op x)) (not (:obj x)) (empty? (:tmpls x)) (= 1 (count (distinct (:fns x)))))
        (:ty (fnd (first (:fns x))))
        (#{"DeclRefExpr" "MemberExpr"} (:kind n)) (:ty x)
        (= :lv (:cat x)) (abi/lref (:ty x))
        (= :xv (:cat x)) (abi/rref (:ty x))
        :else (:ty x)))))

(declare cx-elab-declare!)

;; (cpp-tpl2, the checker: the types a substitution may not form, [dcl.ptr]/4 ("there shall be no pointers to references"),
;; [dcl.ref]/1 and /5 (no reference to void, no arrays of references), [dcl.array]/1 (an element type is no reference, void,
;; function or array of unknown bound), [dcl.fct]/11 (no function returns an array or a function), [dcl.mptr]/4 (no pointer to a
;; member of reference type or of cv void, nor of a non-class): in a function template's signature substituted, a substitution
;; failure ([temp.deduct.general]/11's list: "attempting to create an array with an element type that is void, a function type,
;; or a reference type", "a pointer to member ... of reference type", "a function type whose return type is a function or an
;; array"), cx-subst-fail!; GCC's words as its explanation)
(defn- cx-formed!
  [k t & [c]]
  (when (cx-subst?)
    (let [u (abi/unq t)
          tv (fn [t] (re-find #":k :(auto|dep|tparam|tdep|tspec)" (pr-str t)))]
      (when-not (tv t)
        (case k
          :ptr (when (abi/ref? t) (cx-subst-fail! "forming pointer to reference type"))
          :ref (when (abi/void? u) (cx-subst-fail! "forming reference to void"))
          :arr (cond (abi/ref? t) (cx-subst-fail! "creating array of references")
                     (abi/fn? u) (cx-subst-fail! "creating array of functions")
                     (abi/void? u) (cx-subst-fail! "creating array of void")
                     (and (abi/arr? u) (nil? (:n u))) (cx-subst-fail! "creating array of an array of unknown bound"))
          :ret (cond (abi/arr? u) (cx-subst-fail! "function returning an array")
                     (abi/fn? u) (cx-subst-fail! "function returning a function"))
          :mptr (cond (abi/ref? t) (cx-subst-fail! "creating pointer to member reference type")
                      (abi/void? u) (cx-subst-fail! "creating pointer to member of type void")
                      (and (map? c) (not (tv c)) (not (abi/class? (abi/unq c)))) (cx-subst-fail! "creating pointer to member of non-class type")))))))

;; (cpp-tpl2, the checker: a substituted elaborated-type-specifier whose class-key names no class, [dcl.type.elab]/6 with
;; [temp.deduct.general]/8 -- `struct enable_if<true, T>::type` for T = int: a substitution failure; GCC's "which is not a class type")
(defn- cx-elab-class! [f t]
  (when (and (cx-subst?) (#{'struct 'class 'union "struct" "class" "union"} (second f)) (map? t)
             (not (abi/class? (abi/unq t))) (not (re-find #":k :(auto|dep|tparam|tdep|tspec)" (pr-str t))))
    (cx-subst-fail! "'" (pr-str (nth f 2)) "' resolves to " (pr-str (abi/unq t)) ", which is not a class type"))
  t)

(defn- cx-no-type-named!
  "cpp-tpl2 (the checker): the refusal of a qualified name of the type `nm` that the complete class `t` (its bases complete, no
  dependent argument, no header's) does not declare as a type ([temp.res.general]/3, [class.member.lookup]): in a function
  template's signature substituted a substitution failure ([temp.deduct.general]/11, cx-subst-fail!: enable_if<false, T>::type),
  else the program's error (cpp0x/alias-decl-pr92206-1.C's alias default; \"unknown type\" kept first, the headers' retry
  reads it). Nil when the class is not such."
  [t ^String nm f]
  (let [c (when (abi/class? (abi/unq t)) (abi/cls (:id (abi/unq t))))]
    (when (and (checking?) c (:complete c) (not (:defining c)) (not (:header c)) (not (dt-dependent? (:targs c)))
               (every? #(let [b (abi/cls (:cls %))] (and b (:complete b))) (:bases c))
               (not (some #(= :type (:e (second %))) (class-lookup (:id (abi/unq t)) nm false))))
      (if (cx-subst?)
        (cx-subst-fail! "no type named '" nm "' in '" (:name c) "'")
        (fail :type "unknown type " (pr-str f) ": no type named '" nm "' in the complete class '" (:name c) "'")))))

;; ---------------------------------------------------------------------------------------------
;; queue 570 (the checker): GNU's variable-length arrays, the types built from one (doc/cpp/CPP-SURVEY.md, "As built: 570").
;; The GCC manual's "Variable Length": GNU C++ takes an automatic array whose bound is no constant expression, its storage
;; made where the declaration is executed; C's term for a type built from one is variably modified (C23 6.7.7.3). C++ has no
;; such types: every bound is a converted constant expression ([dcl.array]/1), so a construct the standard asks a complete
;; object type of, or a type fixed at translation, cannot take one -- a thrown object's and a handler's type ([except.throw]/3,
;; [except.handle]/1), typeid's operand ([expr.typeid]), a non-static data member ([class.mem.general]), a constexpr variable
;; ([dcl.constexpr]/6: a constant expression's object has a size known at translation); a closure's copy of an array is its
;; element-wise copy ([expr.prim.lambda.capture]/15), which a bound known only at run time cannot size.

(declare strip-type-attrs header-node? cx-runtime-bound? cx-vm?)

(def ^:dynamic *cx-vla*
  "queue 570, the checker: the block scope (the object itself) whose written type may be variably modified -- a local typedef
  or alias declaration, a handler's type, typeid's type operand --, where an array bound surely no constant expression makes
  GNU's VLA type {:k :arr :n nil :vla true :of T}, vla-local's, instead of the refusal; nil elsewhere."
  nil)

(defn- cx-field-bound-error
  "queue 570, the checker: a non-static data member `k` whose array bound (any of its declarator's) surely is no constant
  expression (cx-runtime-bound?): a member's bound is a converted constant expression ([dcl.array]/1) and GNU's VLA an
  automatic variable's alone (the GCC manual's \"Variable Length\"): GCC's \"size of array 'ar' is not an integral
  constant-expression\", the error the field takes (ext/vla1.C's local class's `int ar[1][i];`). Nil when not sure."
  [cs k]
  (when (and (checking?) (not (header-node? k)) (not (:isBitfield k)))
    (let [f (try (ct/parse-type (strip-type-attrs (get-in k [:type :qualType]))) (catch Exception _ nil))
          bs (loop [f f acc []]
               (if (and (seq? f) (#{'array '* '& '&& 'const 'volatile} (first f)))
                 (recur (last f) (if (and (= 'array (first f)) (= 3 (count f))) (conj acc (second f)) acc))
                 acc))]
      (when (some #(and (not (number? %)) (cx-runtime-bound? cs %)) bs)
        (ex-info (str "codegen: size of array '" (:name k) "' is not an integral constant-expression") {:codegen/refused :vla-type :cx/node k})))))

(defn- cx-field-vla-type
  "queue 570-1 (a), the checker: the member `k`'s type with its bounds surely no constant made GNU's VLA type (*cx-vla* the class
  scope `cs`), kept after cx-field-bound-error's error; nil when it does not resolve so."
  [cs k]
  (when (and (checking?) (cx-field-bound-error cs k))
    (let [t (try (binding [*cx-vla* cs] (resolve-type cs (get-in k [:type :qualType]))) (catch arbace.lang.ExceptionInfo _ nil))]
      (when (cx-vm? t) t))))

(defn- cx-vm-typeid!
  "queue 570: typeid's operand `n` of a variably modified type, the program's error."
  [n]
  (throw (ex-info "codegen: cannot create type information for a type of variable size" {:codegen/refused :vla-type :cx/node n})))

(defn cx-vm?
  "queue 570: the type `t` is variably modified: a VLA type, or a pointer, reference or array built from one."
  [t]
  (loop [t t]
    (cond (not (map? t)) false
          (:vla t) true
          (#{:ptr :ref :rref} (:k t)) (recur (:to t))
          (= :arr (:k t)) (recur (:of t))
          :else false)))

(def ^:private cx-bound-skip
  ;; an operand whose value is not read, or whose names a written bound does not show as variables: an unevaluated operand, a
  ;; conditional or short-circuit operator, an address, a qualified name, a literal, a call's or a functional cast's parenthesis
  #"\b(?:sizeof|alignof|__alignof__|_Alignof|decltype|typeid|noexcept|__typeof__|typeof|requires|__builtin_\w+)\b|\?|&|\[|\{|::|\"|'|[A-Za-z_]\w*\s*\(")

(defn- cx-runtime-var?
  "queue 570: the name `parts` (unqualified or qualified) names a variable whose value is never a constant expression's: a
  function parameter, or a variable neither of reference type nor const-qualified (a constexpr variable is const)
  ([expr.const]/4, /10: no other variable is usable in constant expressions, and an lvalue-to-rvalue conversion of it is no
  core constant expression, /5.9)."
  [scope parts]
  (let [es (try (if (= 1 (count parts)) (lookup scope (first parts)) (lookup-qualified scope parts)) (catch arbace.lang.ExceptionInfo _ nil))
        e (first es)]
    (when (and (= :var (:e e)) (every? #(= :var (:e %)) es))
      (let [v (var* (:id e)) t (:ty v)]
        (boolean (and (map? t) (not (abi/ref? t))
                      (or (= :param (:storage v))
                          (not (:c (loop [t t] (if (abi/arr? t) (recur (:of t)) t)))))))))))

(defn cx-runtime-bound?
  "queue 570: the array bound's form `b` (a name, a qualified name, or (cpp/text s), as the type parser keeps it) surely is no
  constant expression: every operand of it is read and one names a variable cx-runtime-var? says no constant reads (`i`,
  `n + 1`, `A::i`). Nil when not sure."
  [scope b]
  (let [names (cond (symbol? b) [(name-parts b)]
                    (and (seq? b) (= 'cpp/text (first b)) (string? (second b)) (not (re-find cx-bound-skip (second b))))
                    (let [toks (re-seq #"->|[A-Za-z_]\w*|\S" (second b))]
                      (for [[p t] (map vector (cons nil toks) toks)
                            :when (and (re-matches #"[A-Za-z_]\w*" t) (not (#{"->" "."} p)))]
                        [t]))
                    :else nil)]
    (boolean (some #(cx-runtime-var? scope %) names))))

(def ^:private cx-type-words
  #{"char" "short" "int" "long" "unsigned" "signed" "bool" "float" "double" "void" "wchar_t" "char8_t" "char16_t" "char32_t"
    "__int128" "struct" "class" "union" "enum" "const" "volatile" "__SIZE_TYPE__" "__PTRDIFF_TYPE__"})

(defn cx-address-bound?
  "queue 570: the array bound's form `b` reads no variable and calls nothing, yet holds an address: a string literal or a cast
  to a pointer type (ext/vla22.C's `(long) \"h\"`, parse/array-size2.C's `(char *) &((struct S *) 0)->b - (char *) 0`). Its
  value is fixed at translation, so it makes no GNU VLA, whose bound is a value computed at run time; and it is no integral
  constant expression, a pointer's conversion to an integer being a reinterpret_cast ([expr.const]/5.15) -- GCC's \"size of
  array 'tbl' is not an integral constant-expression\"."
  [scope b]
  (when (and (seq? b) (= 'cpp/text (first b)) (string? (second b)))
    (let [s (second b)]
      (and (re-find #"\"|\*\s*\)" s)
           (not (re-find #"\b(?:sizeof|alignof|__alignof__|_Alignof|decltype|typeid|noexcept|__typeof__|typeof|__builtin_\w+)\b|\?" s))
           (let [toks (re-seq #"\"(?:[^\"\\]|\\.)*\"|->|::|[A-Za-z_]\w*|\S" s)]
             (every? (fn [[p t]]
                       (or (not (re-matches #"[A-Za-z_]\w*" t)) (#{"->" "." "::"} p) (cx-type-words t)
                           (let [es (try (lookup scope t) (catch arbace.lang.ExceptionInfo _ nil))]
                             (and (seq es) (every? #(= :type (:e %)) es)))))
                     (map vector (cons nil toks) toks)))))))

(defn resolve-type-form [scope f]
  (cond
    (symbol? f)
    (if-let [n (builtin-syms f)]
      (abi/b n)
      (cond (= 'auto f) {:k :auto}
            ;; (cpp-s4: decltype(auto), [dcl.type.auto.deduct]/5: deduced as decltype of the initializer or the returned
            ;; operand; mangled Dc; variant's __detail::__variant::__get)
            (= 'decltype-auto f) {:k :auto :decltype true}
            ;; x86-64's va_list (the SysV ABI §3.5.7): struct __va_list_tag[1], the struct opaque here
            (= '__builtin_va_list f) (abi/arr 1 (va-list-tag))
            :else
      (let [parts (name-parts f)
            es (if (= 1 (count parts)) (lookup scope (first parts))
                   (or (when-let [h (:dependent-name @hooks)] (h scope parts)) (lookup-qualified scope parts)))
            e (type-entity es)]
        (or (:ty e)
            ;; (cpp-tpl2, the checker: a qualified name `T::x` whose qualifier is a complete class that declares no type x: the
            ;; cpp/scope form's rule below)
            (when (and (checking?) (> (count parts) 1))
              (when-let [qt (try (:ty (first (filter #(= :type (:e %)) (lookup-qualified scope (vec (butlast parts)))))) (catch arbace.lang.ExceptionInfo _ nil))]
                (when (abi/class? (abi/unq qt))
                  (cx-no-type-named! (abi/unq qt) (last parts) f))))
            (fail :type "unknown type " f)))))
    (seq? f)
    (case (first f)
      * (let [t (resolve-type-form scope (second f))] (cx-formed! :ptr t) (abi/ptr t))
      ;; references to references collapse ([dcl.ref]/7: a substituted T& or T&&)
      & (let [t (resolve-type-form scope (second f))] (cx-formed! :ref t) (abi/lref (if (abi/ref? t) (:to t) t)))
      && (let [t (resolve-type-form scope (second f))] (cx-formed! :ref t) (if (abi/ref? t) t (abi/rref t)))
      ;; GNU's __complex__ T (_Complex T): {:k :complex :of T} (cpp-s3: std::complex<long double>'s _M_value)
      complex {:k :complex :of (abi/unq (resolve-type-form scope (second f)))}
      ;; (cpp-s4: cv on an array type is on its elements, [basic.type.qualifier]/3: `const T&` of T = char[4], std::format's
      ;; basic_format_string(const _Tp&) under convertible_to)
      ;; (queue 514, the checker: cv on a function type, a substituted `const T` of T a function type, is ignored, [dcl.fct]/9:
      ;; template/unify7.C's Foo(const T &) for `int &f ()`)
      const (let [cv (fn cv [t] (cond (abi/arr? t) (assoc t :of (cv (:of t))) (and (checking?) (abi/fn? t)) t :else (assoc t :c true)))] (cv (resolve-type-form scope (second f))))
      volatile (let [cv (fn cv [t] (cond (abi/arr? t) (assoc t :of (cv (:of t))) (and (checking?) (abi/fn? t)) t :else (assoc t :v true)))] (cv (resolve-type-form scope (second f))))
      restrict (resolve-type-form scope (second f))
      cpp/attributed (resolve-type-form scope (last f))
      array (if (= 2 (count f))
              (abi/arr nil (doto (resolve-type-form scope (second f)) (->> (cx-formed! :arr))))
              (let [b (second f)
                    n (cond (number? b) b
                            ;; (queue 570, the checker: in *cx-vla*'s block scope a bound surely no constant expression is
                            ;; GNU's VLA's)
                            (and b (:const-bound @hooks) *cx-vla* (identical? scope *cx-vla*) (checking?))
                            (try ((:const-bound @hooks) scope b)
                                 (catch arbace.lang.ExceptionInfo x (if (cx-runtime-bound? scope b) ::vla (throw x))))
                            (and b (:const-bound @hooks)) ((:const-bound @hooks) scope b) :else nil)]
                ;; (cpp-tpl2, the checker: [temp.deduct.general]/11's "attempting to create an array with ... a size that
                ;; is zero or negative", [dcl.array]/1; GCC's words)
                (when (and (number? n) (<= (long n) 0) (cx-subst?))
                  (cx-subst-fail! (if (zero? (long n)) "zero-size array" "size of array is negative")))
                (let [et (doto (resolve-type-form scope (nth f 2)) (->> (cx-formed! :arr)))]
                  (if (= ::vla n) (assoc (abi/arr nil et) :vla true) (abi/arr n et)))))
      fn (if-let [tt (when (and (symbol? (nth f 2 nil)) (str/starts-with? (str (nth f 2)) "__") (:is-trait @hooks) ((:is-trait @hooks) (str (nth f 2))))
                       (:trait-type @hooks))]
           ;; a transform trait's type (G4: __remove_cv(T)), spelled as a function type returning the trait's name
           (tt scope (str (nth f 2)) (second f))
         (let [[_ ps r] f
               va (some #{'&} ps)
               ps (remove #{'&} ps)
               ps (if (= ['void] (vec ps)) [] ps)]
           {:k :fn :ret (doto (resolve-type-form scope r) (->> (cx-formed! :ret)))
            ;; a parameter of array or function type is a pointer ([dcl.fct]/5), a substituted one too
            :ps (mapv (fn [t] (cond (abi/arr? t) (abi/ptr (:of t)) (abi/fn? t) (abi/ptr t) :else t))
                      (mapcat #(if (and (seq? %) (= 'pack-expand (first %)))
                                 (if-let [h (:pack-expand @hooks)] (h scope (second %)) (fail :pack "a pack expansion"))
                                 [(resolve-type-form scope %)])
                              ps))
            :va (boolean va)}))
      ;; (cpp-rt-own: an elaborated-type-specifier's name is looked up ignoring the names that are no types, [basic.lookup.elab]/1:
      ;; libcpp's traditional.cc, `struct block *block;` then `block = (struct block *) (exp + macro->count);`, the variable had
      ;; hidden the class, "unknown type block")
      cpp/elaborated (cx-elab-class! f (let [x (nth f 2)
                           simple (when (and (symbol? x) (not (builtin-syms x)) (= 1 (count (name-parts x)))) (first (name-parts x)))]
                       (or (when (and simple (not (checking?)))
                             (some-> (loop [s scope] (when s (or (type-entity (find-here s simple true)) (recur (:parent s))))) :ty))
                           (if (and simple (#{'struct 'class 'union "struct" "class" "union"} (second f)))
                             ;; (cpp-rt-own: a class key and a name no declaration names declare an incomplete class in the smallest
                             ;; namespace or block scope holding it, [basic.scope.pdecl]/7.2: libcpp's symtab.h `typedef int (*ht_cb)
                             ;; (struct cpp_reader *, hashnode, const void *);` before any cpp_reader, the typedef dropped before)
                             (try (resolve-type-form scope x)
                                  (catch arbace.lang.ExceptionInfo e
                                    (if (and (= :type (:codegen/refused (ex-data e))) (not (checking?)))
                                      (let [home (loop [s scope] (if (and s (#{:class :tparams} (:kind s)) (:parent s)) (recur (:parent s)) s))]
                                        (if (identical? home *root*)
                                          (opaque-class simple)
                                          (let [id (next-id) t {:k :class :id id}]
                                            (swap! abi/*classes* assoc id {:id id :name simple :path (:path home) :scope (new-scope :class home :cls id :path (conj (vec (:path home)) [:cls id]))
                                                                           :fields [] :bases [] :outer home})
                                            (enter! home simple {:e :type :ty t :pos -1})
                                            t)))
                                      ;; (queue 505, the checker: a class first named by an elaborated-type-specifier the parser did not
                                      ;; leave a node for, a parameter's, cx-elab-declare!; n-merge-1120b: cpp-rt-own's declaration above
                                      ;; is the code generator's, 505's the checker's, each as its records were made)
                                      (if-let [t (cx-elab-declare! scope f e)] t (throw e)))))
                             (try (resolve-type-form scope x)
                                  (catch arbace.lang.ExceptionInfo e
                                    (if-let [t (cx-elab-declare! scope f e)] t (throw e))))))))
      ;; (n-cpp-concepts, the checker: a constrained placeholder, `C auto` ([dcl.spec.auto.general]/1), an auto with its
      ;; type-constraint's text, checked once deduced: placeholder-check!; the code generator refuses it as before)
      constrained (if (and (checking?) (:tc-text (meta f)) (#{'auto 'decltype-auto} (nth f 2 nil)))
                    (assoc (resolve-type-form scope (nth f 2)) :tc (:tc-text (meta f)))
                    (fail :type "type form " (pr-str f)))
      typename (resolve-type-form scope (second f))
      ;; decltype of the two forms headers name types by (typedef decltype(nullptr) nullptr_t; ... decltype(sizeof 0)
      ;; size_t;): the others wait for decltype proper
      decltype (let [x (second f) t (str/trim (if (and (seq? x) (= 'cpp/text (first x))) (second x) (str x)))]
                 (cond (= t "nullptr") abi/nullptr-t
                       (re-find #"^(sizeof|alignof)\b" t) abi/ulong*
                       :else (decltype-of scope t)))
      ;; (cpp-small: GNU's typeof of the forms g++.dg's tests name size_t and ptrdiff_t by, `typedef __typeof__ (sizeof 0)
      ;; size_t;` (init/new44.C, init/new46.C): sizeof's and alignof's type, std::size_t ([expr.sizeof]/6); the others refused as
      ;; before)
      typeof-text (let [t (str/trim (str (second f)))]
                    (cond (= t "nullptr") abi/nullptr-t
                          (re-find #"^(sizeof|alignof|__alignof__)\b" t) abi/ulong*
                          :else (fail :type "type form " (pr-str f))))
      <> (if-let [h (:template-id @hooks)] (h scope f) (fail :template "template-id " (pr-str f)))
      cpp/scope (loop [t (resolve-type-form scope (second f))
                       ;; X::template Y<A>::Z: the parts after `template` (G4: __alloc_traits<_Alloc>::template rebind<_Tp>::other)
                       [p & more] (mapcat (fn [x] (if (and (seq? x) (= 'template (first x)))
                                                    (let [y (second x)] (if (and (seq? y) (= 'cpp/scope (first y))) (rest y) [y]))
                                                    [x]))
                                          (nnext f))]
                  (cond
                    (nil? p) t
                    ;; a member of a dependent type in a template's signature (CODEGEN.md G3); a member template's
                    ;; specialization among the names (G4)
                    (#{:tparam :tspec :tdep} (:k (abi/unq t)))
                    {:k :tdep :base t :names (mapv #(cond (symbol? %) (name %)
                                                          (and (seq? %) (= '<> (first %)) (symbol? (second %)))
                                                          {:name (name (second %)) :args (mapv (fn [a] (resolve-type-form scope a)) (nnext %))}
                                                          :else (fail :type "type form " (pr-str f)))
                                                   (cons p more))}
                    ;; (cpp-tpl2, the checker: a substituted nested-name-specifier's type that is no class, [temp.deduct.general]/11's
                    ;; "attempting to use a type that is not a class or enumeration type in a qualified name"; GCC's words)
                    (not (abi/class? t)) (if (and (cx-subst?) (not (abi/enum? (abi/unq t))) (not (re-find #":k :(auto|dep|tparam|tdep|tspec)" (pr-str t))))
                                           (cx-subst-fail! "'" (pr-str (abi/unq t)) "' is not a class, struct, or union type")
                                           (fail :type "a scope of a non-class " (pr-str f)))
                    ;; a member template's specialization (Outer<int>::Inner<double>): its name found in the class, its
                    ;; arguments resolved here
                    (and (seq? p) (= '<> (first p)))
                    (recur ((:template-id @hooks) scope (apply list '<> {:in (:scope (abi/cls-of t)) :name (second p)} (nnext p))) more)
                    (symbol? p)
                    ;; (a qualified name: the class's members and its bases', dependent ones in the pattern too,
                    ;; [class.member.lookup]; G5: move_iterator<It>::iterator_category from __move_iter_cat)
                    (let [e (type-entity (or (seq (map second (class-lookup (:id (abi/unq t)) (name p) false)))
                                             (lookup-qualified (:scope (abi/cls-of t)) [(name p)] false)))
                          ;; (cpp-tpl2, the checker: in a function template's signature substituted, a member type named by a
                          ;; qualified name that the template, no class's member, may not access, [temp.deduct.general]/8 (access
                          ;; checking is done as part of the substitution process) with [class.access]/1-2: a substitution
                          ;; failure, cx-subst-fail!; a class that declares a friend not judged, cx-type-friend?)
                          cid (:id (abi/unq t))
                          acc (when (and e (cx-subst?) (nil? (:cls scope))) (:access e))
                          _ (when (and (#{:private :protected} acc) (not (cx-subst-friend? cid acc)))
                              (cx-subst-fail! "'" (name p) "' is a " (name acc) " member of '" (:name (abi/cls cid)) "' within this context"))]
                      (recur (or (:ty e)
                                 ;; (cpp-tpl2, the checker: a substituted qualified name a complete class does not declare as a type,
                                 ;; [temp.deduct.general]/11's "attempting to use a type in a nested-name-specifier ... when that type
                                 ;; does not contain the specified member": enable_if<false, T>::type; GCC's "no type named")
                                 (cx-no-type-named! t (name p) f)
                                 ;; (cpp-tpl2, the checker: a typename-specifier naming a member class template, not a type, before
                                 ;; C++17's deduced class type ([temp.res.general]/5 with [dcl.type.simple]/3): GCC's "names ...,
                                 ;; which is not a type"; cpp1z/class-deduction107.C at C++11)
                                 (when (and (checking?) (< (long *cxx-year*) 17)
                                            (some #(and (= :tmpl (:e (second %))) (= :class (:tk (second %)))) (class-lookup (:id (abi/unq t)) (name p) false)))
                                   (fail :name "'" (name p) "' names a template, which is not a type"))
                                 (fail :type "unknown type " (pr-str f))) more))
                    :else (fail :type "type form " (pr-str f))))
      member-ptr (let [c (resolve-type-form scope (second f))
                       u (resolve-type-form scope (nth f 2))
                       u (if (and (abi/fn? u) (or (:c u) (:const (meta (nth f 2))))) (-> u (dissoc :c) (assoc :cq true)) u)
                       ;; (CX12, the checker: a volatile member function's type)
                       u (if (and (checking?) (abi/fn? u) (or (:v u) (:volatile (meta (nth f 2))))) (-> u (dissoc :v) (assoc :vq true)) u)
                       ;; (and its ref-qualifier, [dcl.fct]/4)
                       u (if-let [r (when (and (checking?) (abi/fn? u)) (:cpp/ref (meta (nth f 2))))] (assoc u :refq (if (= r :&&) "&&" "&")) u)
                       ;; (cpp-rt-own4, the code generator: a non-throwing member function's type, noexcept part of the type since
                       ;; C++17 ([except.spec]/1 with [dcl.fct]/1), as mptr-fn-node's &C::f: <type_traits>' __call_is_nt over `long
                       ;; (Z::*)() const noexcept`, mangled KDoF..E, abi's)
                       u (if (and (not (checking?)) (abi/fn? u) (true? (:noexcept (meta (nth f 2)))) (>= (long *cxx-year*) 17)) (assoc u :nx true) u)
                       _ (cx-formed! :mptr u c)]
                   ;; (CX12, the checker: a template parameter's class kept, T::* deduced)
                   ;; (cpp-rt-own: the code generator's too, its template signatures' `_Tp _Class::*`: std::mem_fn(&stat_type::st_nlink),
                   ;; fs_ops.cc's hard_link_count, "mem_fn does not deduce"; mangled M <template-param>, abi's)
                   {:k :mptr :cls (if (= :tparam (:k c)) c (:id c)) :to u})
      cpp/global (binding [] (resolve-type-form (loop [s scope] (if (:parent s) (recur (:parent s)) s)) (second f)))
      (fail :type "type form " (pr-str f)))
    :else (fail :type "type form " (pr-str f))))

(defn- strip-type-attrs
  "A spelling without its GNU attributes (`void () noexcept __attribute__((noreturn))`): none of them changes the type
  the analysis needs (G4: the headers' declarations)."
  ^String [^String s]
  (if (str/includes? s "__attribute__")
    (loop [s s]
      (let [i (.indexOf s "__attribute__")]
        (if (neg? i)
          (str/trim s)
          (let [j (.indexOf s "((" i)
                k (when (>= j 0) (loop [k (+ j 2) d 2] (cond (>= k (count s)) nil (= \( (.charAt s k)) (recur (inc k) (inc d))
                                                             (= \) (.charAt s k)) (if (= d 1) (inc k) (recur (inc k) (dec d))) :else (recur (inc k) d))))]
            (if k (recur (str (subs s 0 i) (subs s k))) (str/trim s))))))
    s))

(defn- vector-bytes
  "vector_size's BYTES, the spelling `b` (queue 439): an integer literal, or an integer constant expression of literals,
  `sizeof ( TYPE )` (TYPE resolved in `scope`), + - * / and parentheses, its value; nil for anything else."
  [scope ^String b]
  (if (re-matches #"\s*\d+\s*" b)
    (Long/parseLong (str/trim b))
    (let [toks (re-seq #"sizeof\s*\(\s*[^()]+?\s*\)|\d+[uUlL]*|[-+*/()]|\S" b)
          toks (mapv (fn [^String t]
                       (cond (str/starts-with? t "sizeof")
                             (let [[_ ty] (re-matches #"sizeof\s*\(\s*([^()]+?)\s*\)" t)
                                   sz (try (abi/size-of (abi/unq (resolve-type scope ty))) (catch Exception _ nil))]
                               (if sz (long sz) :bad))
                             (re-matches #"\d+[uUlL]*" t) (Long/parseLong (str/replace t #"[uUlL]" ""))
                             (#{"+" "-" "*" "/" "(" ")"} t) t
                             :else :bad))
                     toks)]
      (when-not (some #{:bad} toks)
        ;; recursive descent over toks: expr := term (+|- term)*, term := factor (*|/ factor)*, factor := N | ( expr ) | - factor
        (let [pos (volatile! 0)
              peek (fn [] (get toks @pos))
              next! (fn [] (let [t (peek)] (vswap! pos inc) t))]
          (letfn [(factor [] (let [t (next!)]
                               (cond (number? t) t
                                     (= "-" t) (when-let [v (factor)] (- (long v)))
                                     (= "(" t) (let [v (expr)] (when (= ")" (next!)) v))
                                     :else nil)))
                  (term [] (loop [v (factor)]
                             (if (and v (#{"*" "/"} (peek)))
                               (let [op (next!) w (factor)]
                                 (when w (recur (if (= op "*") (* (long v) (long w)) (when-not (zero? (long w)) (quot (long v) (long w)))))))
                               v)))
                  (expr [] (loop [v (term)]
                             (if (and v (#{"+" "-"} (peek)))
                               (let [op (next!) w (term)]
                                 (when w (recur (if (= op "+") (+ (long v) (long w)) (- (long v) (long w))))))
                               v)))]
            (let [v (expr)] (when (= @pos (count toks)) v))))))))

(defn resolve-type
  "The semantic type of clang's spelling `s` in `scope`."
  [scope ^String s0]
  ;; GNU's vector types (vector_size, clang's VectorType): the attribute is no type attribute strip-type-attrs may drop (g++.dg's
  ;; ext/is_aggregate.C read a vector typedef as its element type: a wrong answer, cpp-90). For the code generator (n-cpp-eval)
  ;; `__attribute__((__vector_size__(BYTES))) T`, BYTES a literal, is {:k :vec :n LANES :of T}: held, copied, initialized from a
  ;; list and given its size and alignment; its lanes' operators are refused where they are met. The checker still refuses the
  ;; type (its traits and conversions are not modelled)
  ;; (queue 439: BYTES an integer constant expression of literals, sizeof (TYPE), + - * / and parentheses, g++.dg's
  ;; ext/is_aggregate.C's `vector_size (4 * sizeof (int))`, evaluated by vector-bytes)
  (when (re-find #"vector_size__\s*\(" s0)
    (let [[_ b et] (re-find #"^\s*__attribute__\(\(__vector_size__\((.+)\)\)\)\s+(.*)$" s0)]
      (when (or (nil? b) (nil? (vector-bytes scope b))) (fail :type "a GNU vector type (" s0 ")"))))
  ;; (cpp-vec, 2026-11-25: the checker's too, 577-1 (a): the GCC manual's "Using Vector Instructions through Built-in Functions"
  ;; -- a vector is declared, initialized from a braced list, given its size, its elements read by subscript; what the checker
  ;; does not model of it, its operators and conversions, it refuses where it meets them, as the code generator does)
  (if-let [[_ b et] (re-find #"^\s*__attribute__\(\(__vector_size__\((.+)\)\)\)\s+(.*)$" s0)]
    (let [n (long (vector-bytes scope b))
          vec-of (fn [t]
                   (let [e (abi/unq t)
                         es (when (or (abi/integral? e) (abi/floating? e)) (abi/size-of e))]
                     (when (or (nil? es) (not (pos? n)) (pos? (rem n (long es))) (not= 1 (Long/bitCount (quot n (long es)))))
                       (fail :type "a GNU vector type (" s0 ")"))
                     (cond-> {:k :vec :n (quot n (long es)) :of e} (:c t) (assoc :c true) (:v t) (assoc :v true))))
          ;; (queue 439: the declaration specifiers' vector type in a declarator's type, `V f() const`, `V *p`: the attribute
          ;; applies to the innermost type, the specifiers')
          wrap (fn wrap [t]
                 (case (:k t)
                   (:ptr :ref :rref) (update t :to wrap)
                   :arr (update t :of wrap)
                   :fn (update t :ret wrap)
                   (vec-of t)))]
      (wrap (resolve-type scope et)))
  (let [s (strip-type-attrs s0)]
  (if (re-find #"\((unnamed|anonymous) (union|struct|class|enum) at " s)
    (let [t @*last-anon*
          ;; (cpp-rt-own: with a declarator after it, `struct (unnamed struct at f.cc:2:8)[NUM]`, the unnamed class in its place:
          ;; libcpp's directives.cc `static struct { int len; const char *name; } embed_params[NUM_EMBED_PARAMS] = {...}`, a
          ;; struct before, "several values for a scalar" or "conversion from a class to long" at embed_params[i])
          rest (str/trim (str/replace s #"^(?:const\s+)?(?:(?:struct|class|union|enum)\s+)?\((?:unnamed|anonymous) (?:union|struct|class|enum) at [^)]*\)" ""))]
      (if (and t (seq rest) (re-find #"^[\[*&(]" rest))
        (let [sc (new-scope :block scope)]
          (enter! sc "__arbace_unnamed" {:e :type :ty (cond-> t (re-find #"^const " s) (assoc :c true)) :pos -1})
          (resolve-type-form sc (ct/parse-type (str "__arbace_unnamed " rest))))
        (cond-> t (re-find #"^const " s) (assoc :c true))))
  (try (resolve-type-form scope (ct/parse-type s))
       (catch arbace.lang.ExceptionInfo e (if (:codegen/refused (ex-data e)) (throw e) (fail :type "type " s ": " (.getMessage e)))))))))

;; CP311 (a): class template argument deduction ([dcl.type.class.deduct]): a placeholder for a deduced class type, a
;; template-name with no argument list, deduced from the initializer by arbace.cpp.template/ctad (the :ctad hook)
(defn ctad-template
  "The class or alias template the placeholder `s` (a type's spelling: a template-name, maybe qualified and
  cv-qualified, no argument list) names in `scope` where no type of that name is found (the injected-class-name is a
  type), as [tid #{cv}], or nil."
  [scope s]
  (when (and (string? s) (:ctad @hooks))
    (let [f (try (ct/parse-type (strip-type-attrs s)) (catch Exception _ nil))
          [f cv] (loop [f f cv #{}] (if (and (seq? f) (#{'const 'volatile} (first f))) (recur (second f) (conj cv (first f))) [f cv]))]
      ;; (CP327 (a): a member template named through a class, `T<double>::AFoo`, [temp.res.general]/1 and
      ;; [dcl.type.simple]/3: the nested-name-specifier's class resolved, then its member found by class member lookup)
      (if (and (seq? f) (= 'cpp/scope (first f)) (symbol? (last f)) (> (count f) 2))
        (let [pre (if (= 3 (count f)) (second f) (apply list (butlast f)))
              t (try (abi/unq (resolve-type-form scope pre)) (catch arbace.lang.ExceptionInfo _ nil))]
          (when (abi/class? t)
            (let [nm (name (last f))
                  es (or (seq (map second (class-lookup (:id t) nm false)))
                         (try (lookup-qualified (:scope (abi/cls-of t)) [nm] false) (catch arbace.lang.ExceptionInfo _ nil)))]
              (when (and (seq es) (nil? (type-entity es)))
                (when-let [e (first (filter #(and (= :tmpl (:e %)) (#{:class :alias} (:tk %))) es))]
                  [(:id e) cv])))))
      (when (and (symbol? f) (not (builtin-syms f)) (not= 'auto f))
        (let [parts (name-parts f)
              es (try (if (= 1 (count parts)) (lookup scope (first parts)) (lookup-qualified scope parts))
                      (catch arbace.lang.ExceptionInfo _ nil))]
          (when (and (seq es) (nil? (type-entity es)))
            (when-let [e (first (filter #(and (= :tmpl (:e %)) (#{:class :alias} (:tk %))) es))]
              [(:id e) cv]))))))))

(defn ctad-compound!
  "CP311 (a), the checker: a variable's type `s` that does not resolve and holds a placeholder for a deduced class type
  inside a compound type (a pointer, a reference, an array, a function's parameter or return: [dcl.type.class.deduct]/2
  allows the placeholder only as the whole declared type; clang's err_deduced_class_template_compound_type)."
  [scope s]
  (when (and (checking?) (string? s) (:ctad @hooks))
    (let [f (try (ct/parse-type (strip-type-attrs s)) (catch Exception _ nil))
          syms (fn syms [x] (cond (symbol? x) [x]
                                  (and (seq? x) (= '<> (first x))) (mapcat syms (nnext x))
                                  (sequential? x) (mapcat syms x)
                                  :else []))]
      (when (and (seq? f) (not (#{'const 'volatile '<>} (first f))))
        (when (some #(ctad-template scope (str %)) (syms f))
          (fail :ctad "cannot form a compound type of a deduced class template specialization type (" s ")"))))))

(defn ctad-compound-var
  "CP311 (a), the checker: {:ty :ctad-error} for a variable whose type `qt` is ctad-compound!'s error (the variable
  declared with a dependent placeholder type, the error raised at its initialization), else nil."
  [scope n qt]
  (when (checking?)
    (when-not (try (resolve-type scope qt) (catch arbace.lang.ExceptionInfo _ nil))
      (try (ctad-compound! scope qt) nil
           (catch arbace.lang.ExceptionInfo e
             (when (= :ctad (:codegen/refused (ex-data e)))
               {:ty {:k :dep :name "<deduction failed>"} :ctad-error (ex-info (.getMessage e) (assoc (ex-data e) :cx/node n))}))))))

(defn- before-exception-spec
  "cpp-rt-own: a function type's spelling up to its exception specification or trailing return type (`noexcept`, `throw`
  or `->` outside parentheses), where its cv- and ref-qualifiers end: a noexcept's operand holds parentheses and `&&` --
  <span>'s `span(_Range&& __range) noexcept(noexcept(ranges::data(__range)) && noexcept(ranges::size(__range)))` had been
  read as a constructor with the ref-qualifier &&, mangled _ZNOSt4span...C2 (print.cc)."
  ^String [^String qt]
  (let [n (count qt)]
    (loop [i 0 d 0]
      (if (>= i n)
        qt
        (let [c (.charAt qt i)]
          (cond
            (= c \() (recur (inc i) (inc d))
            (= c \)) (recur (inc i) (dec d))
            (and (zero? d)
                 (or (.startsWith qt "->" i)
                     (some (fn [^String w] (and (.startsWith qt w i)
                                                (let [j (+ i (count w))] (or (>= j n) (not (Character/isJavaIdentifierPart (.charAt qt j)))))))
                           ["noexcept" "throw"]))
                 (or (zero? i) (not (Character/isJavaIdentifierPart (.charAt qt (dec i))))))
            (subs qt 0 i)
            :else (recur (inc i) d)))))))

(defn- method-const? [^String qt] (boolean (re-find #"\)\s*const(\s|$|&)" (before-exception-spec qt))))
(defn- method-volatile? [^String qt] (boolean (re-find #"\)\s*(?:const\s*)?volatile(\s|$|&)" (before-exception-spec qt))))

(defn- method-refq
  "A member function's ref-qualifier from its type's spelling: \"&\", \"&&\" or nil ([dcl.fct]/4)."
  [^String qt]
  (second (re-find #"\)\s*(?:const\s*)?(?:volatile\s*)?(&&|&)(?:\s|$)" (before-exception-spec (or qt "")))))

;; ---------------------------------------------------------------------------------------------
;; The main file's text: qualifiers the tree does not keep

(def ^:dynamic *main-name* nil) ; the main file's name in the native tree's locations (its text is *src*)
;; the main file's directory: a header the preprocessor found beside it by a quoted #include is named relative to it in the
;; locations ("new" for libsupc++'s own <new> through -I its directory; cpp-90: its text was taken for the main file's)
(def ^:dynamic *main-dir* nil)
(def ^:private file-texts (atom {}))

(defn- loc-of
  "A location's file position: its own, or a macro token's expansion location."
  [l]
  (if (:offset l) l (:expansionLoc l)))

(defn- blank-comments
  "A header's text with its comments blanked (spaces, its newlines kept: the offsets unchanged), so that the analysis's
  readings of a node's text (a partial specialization's arguments) see no comment (G4); string and character literals
  kept."
  ^String [^String t]
  (let [sb (StringBuilder. t) n (count t)]
    (loop [i 0]
      (when (< i n)
        (let [c (.charAt t i)]
          (cond
            (or (= c \") (= c \')) (recur (loop [j (inc i)] (cond (>= j n) j (= \\ (.charAt t j)) (recur (+ j 2)) (= c (.charAt t j)) (inc j) (= \newline (.charAt t j)) j :else (recur (inc j)))))
            (and (= c \/) (< (inc i) n) (= \/ (.charAt t (inc i))))
            (recur (loop [j i] (if (or (>= j n) (= \newline (.charAt t j))) j (do (.setCharAt sb j \space) (recur (inc j))))))
            (and (= c \/) (< (inc i) n) (= \* (.charAt t (inc i))))
            (recur (loop [j i] (cond (>= j n) j
                                     (and (= \* (.charAt t j)) (< (inc j) n) (= \/ (.charAt t (inc j)))) (do (.setCharAt sb j \space) (.setCharAt sb (inc j) \space) (+ j 2))
                                     :else (do (when-not (= \newline (.charAt t j)) (.setCharAt sb j \space)) (recur (inc j))))))
            :else (recur (inc i))))))
    (.toString sb)))

;; queue 324: a header the preprocessor read from the target tree (ARBACE_C_SYSROOT, bin/lib/repr-cpp/sysroot.bash: a name under
;; one of its roots.txt directories read from the tree alone, arbace.repr.c.pp's sysroot-file) is read from there here too, never
;; from the host's installed file of that name (on amd64 it held the same bytes, 834 of 834; on another host it is absent or another
;; target's: an arm64 host has no x86_64-alpine-linux-musl/bits/c++config.h, and its declarations' text fell back to the main file's)
(def ^:private sysroot
  (let [s (System/getenv "ARBACE_C_SYSROOT")]
    (when (and s (not= s "") (not= s "/")) (str/replace s #"/+$" ""))))

(def ^:private sysroot-roots
  (delay (when sysroot
           (let [f (java.io.File. (str sysroot "/roots.txt"))]
             (when (.isFile f)
               (vec (for [l (str/split-lines (slurp f)) :let [l (str/trim l)] :when (not= l "")] (str/replace l #"/+$" ""))))))))

(defn- sysroot-file
  "The tree's file of an absolute header name under the sysroot's roots, nil for any other name (arbace.repr.c.pp's rule)."
  ^java.io.File [^String name]
  (when (and sysroot (some #(or (= name %) (str/starts-with? name (str % "/"))) @sysroot-roots))
    (java.io.File. (str sysroot name))))

(defn- located-file
  "The file a location's relative name `file` is: as named, else under the main file's directory, else (CP368 (a)) under
  the root the main file's own name is relative to (the dg read names the main file `coroutines/x.C` and its quoted header
  `coroutines/coro.h`, both relative to g++.dg, while *main-dir* is the main file's directory). An absolute name under the
  target tree's roots is the tree's file (queue 324)."
  ^java.io.File [^String file]
  (let [f (or (sysroot-file file) (java.io.File. file))]
    (if (or (.isFile f) (.isAbsolute f) (nil? *main-dir*))
      f
      (let [g (java.io.File. ^String *main-dir* file)
            p (when *main-name* (.getParent (java.io.File. ^String *main-name*)))
            ^String md *main-dir*]
        (if (or (.isFile g) (nil? p) (not (str/ends-with? md (str "/" p))))
          g
          (let [h (java.io.File. (subs md 0 (- (count md) (count p) 1)) file)]
            (if (.isFile h) h g)))))))

(defn text-of
  "The text of the file `file` names in the tree's locations: the main file's *src*, a header's read once (G4: header
  bodies are parsed, so their nodes' text is their own file's)."
  ^String [file]
  (if (or (nil? file) (= file *main-name*))
    *src*
    ;; (CP322 (a): read once a process, so the text is keyed by the file's resolved path: a header named relative to
    ;; the main file's directory is another file for another main file, and the dg read's threads read many)
    (let [f (located-file file)
          k (.getAbsolutePath f)]
      (or (get @file-texts k)
          (if (.isFile f)
            (let [t (blank-comments (String. (java.nio.file.Files/readAllBytes (.toPath f)) "ISO-8859-1"))]
              (swap! file-texts assoc k t)
              t)
            *src*)))))

;; queue 499 (the checker): a file the main file includes by a quoted name from its own directory, itself a test or a
;; header marked as a system header (deleted16a.C's
;; `#include "deleted16.C"`, error6a.C's error6.C, sys-narrow1.C's sys-narrow.h) is checked as the main file's own text, its
;; errors at its own lines: DejaGnu's dg-error matches a diagnostic by its line alone, whatever file it names, so such a test
;; states the included file's errors by their line numbers (`{ dg-error "deleted" "" { target *-*-* } 21 }`)
(def ^:private local-includes (atom {}))

(defn local-include-file
  "Queue 499: the file a location's name `file` is when it is no main file's but a file in the main file's own directory (a
  quoted #include beside it), checked as the main file's text; else nil."
  ^java.io.File [file]
  (when (and (string? file) *main-name* *main-dir* (not= file *main-name*) (not (str/starts-with? file "/")))
    (let [k [*main-dir* file]]
      (if (contains? @local-includes k)
        (get @local-includes k)
        (let [f (located-file file)
              r (when (and (.isFile f)
                           (= (.getCanonicalPath (.getParentFile (.getAbsoluteFile f)))
                              (.getCanonicalPath (java.io.File. ^String *main-dir*)))
                           ;; (a test of its own, its dg directives restated by line in the includer, or a header marked
                           ;; `#pragma GCC system_header`, where a test checks the errors GCC still gives in a system header;
                           ;; a helper header (coroutines/coro.h's) is not judged: its definitions are the slice's to analyze
                           ;; lazily, as before)
                           (let [t (String. (java.nio.file.Files/readAllBytes (.toPath f)) "ISO-8859-1")]
                             (or (re-find #"\{\s*dg-" t) (re-find #"(?m)^\s*#\s*pragma\s+GCC\s+system_header\b" t))))
                  f)]
          (swap! local-includes assoc k r)
          r)))))

(defn header-node?
  "Whether a node is a header's (G4: its location's file a header's path, not the main file's)."
  [n]
  (let [f (:file (loc-of (get-in n [:range :begin])))]
    (boolean (and (string? f) (not= f *main-name*) (or (str/starts-with? f "/") (and *main-dir* (.isFile (located-file f))))
                  ;; (queue 499: a quoted include from the main file's own directory is the checker's main text)
                  (not (and (checking?) (local-include-file f)))
                  ;; (queue 351: for the code generator a source file the unit includes, `#include <hashtable-aux.cc>` in
                  ;; hashtable_tr1.cc, a shim's `#include <assert_fail.cc>`, is the unit's own text, its definitions emitted as
                  ;; clang emits every definition of the translation unit; the checker's reading unchanged)
                  (not (and (not (checking?)) (re-find #"\.(cc|cpp|cxx)$" f)))))))

(defn main-fn-node?
  "Whether a node is the program's `main` (a FunctionDecl named main, not a member): n-cpp-eval, g++.dg's torture/vshuf-*.C define
  main in a quoted include beside the test (vshuf-main.inc), a header's file by header-node?, whose definitions are analyzed only
  when used and dropped when refused: such a main was never emitted (an empty module), or its refusal hidden. main is the
  program's however it is included ([basic.start.main]: one definition the program has), so it is neither."
  [n]
  (and (= "FunctionDecl" (:kind n)) (= "main" (:name n))))

(defn- lazy-header-node?
  "header-node?, but the program's main for the code generator (the checker's reading of the headers unchanged)."
  [n]
  (and (header-node? n) (not (and (not (checking?)) (main-fn-node? n)))))

(defn- node-text ^String [n]
  (let [bl (loc-of (get-in n [:range :begin])) el (loc-of (get-in n [:range :end]))
        b (:offset bl) e (:offset el) l (:tokLen el)]
    (when (and b e (= (:file bl) (:file el)))
      (let [src (text-of (:file bl))]
        (when (<= (long b) (count src))
          (subs src b (max (long b) (min (count src) (+ (long e) (long (or l 0)))))))))))

(defn- text-after
  "At most `k` characters of a node's file after its range's last token, or nil."
  ^String [n k]
  (let [el (loc-of (get-in n [:range :end])) e (:offset el) l (:tokLen el)]
    (when (and e (:file el))
      (let [src (text-of (:file el)) a (min (count src) (+ (long e) (long (or l 0))))]
        (subs src a (min (count src) (+ a (long k))))))))

(defn- strip-directives
  "The text with its preprocessing directives' lines left out (a `#` first on a line, with its continuations): a
  declaration's text before its name is the source's, and a conditional may stand between the qualifier and the name
  (CP377 (a): libstdc++ 15's basic_string.tcc writes `basic_string<_CharT, _Traits, _Alloc>::` then `#ifdef
  __glibcxx_string_resize_and_overwrite` before `resize_and_overwrite(`, so the definition had been taken for a namespace's
  function template and the member template had no body)."
  ^String [^String t]
  (if (str/includes? t "#") (str/replace t #"(?m)^[ \t]*#(?:[^\n]*\\\n)*[^\n]*(?:\n|$)" "") t))

(defn text-before-name
  "The text a declaration's node has before its name (its location), in its own file, or nil (its preprocessing
  directives' lines left out)."
  ^String [n]
  (let [bl (loc-of (get-in n [:range :begin])) ll (loc-of (:loc n))
        b (:offset bl) l (:offset ll)]
    (when (and b l (< (long b) (long l)) (= (:file bl) (:file ll)))
      (let [src (text-of (:file bl))] (strip-directives (subs src b (min (count src) (long l))))))))

(defn- expanded-qualifier
  "queue 367-2 (a), the code generator: the parts of a function declaration's nested-name-specifier from the parser's
  tokens after macro expansion (:_qual, tok-text's: `ctype_byname < wchar_t > ::`), each a name or a template-id; nil
  when the node has none."
  [n]
  (when-let [^String t (when-not (checking?) (:_qual n))]
    (let [t (str/trim (str/replace (str/trim t) #"(::\s*)?~?$" ""))
          parts (loop [i 0 d 0 b 0 out []]
                  (if (>= i (count t))
                    (conj out (str/trim (subs t b)))
                    (let [c (.charAt t i)]
                      (cond (= c \<) (recur (inc i) (inc d) b out)
                            (= c \>) (recur (inc i) (dec d) b out)
                            (and (zero? d) (= c \:) (< (inc i) (count t)) (= \: (.charAt t (inc i))))
                            (recur (+ i 2) d (+ i 2) (conj out (str/trim (subs t b i))))
                            :else (recur (inc i) d b out)))))
          parts (vec (remove str/blank? parts))]
      (when (seq parts) parts))))

(defn- qualifier-before
  "The parts of the nested-name-specifier written before a declaration's name (`int ns::P::get()`: [\"ns\" \"P\"])."
  [n]
  (let [bl (loc-of (get-in n [:range :begin])) ll (loc-of (:loc n))
        b (:offset bl) l (:offset ll)]
    (when (and b l (< (long b) (long l)) (= (:file bl) (:file ll)))
      (let [src (text-of (:file bl))
            t (strip-directives (subs src b (min (count src) (long l))))
            m (re-find #"((?:[A-Za-z_][A-Za-z_0-9]*\s*::\s*)+)(~\s*)?$" t)]
        (when m (vec (map str/trim (remove str/blank? (str/split (second m) #"::")))))))))

(defn- qualifier-tid-before
  "cpp-s13: qualifier-before's parts when the nested-name-specifier names a template-id (`bool ctype<char>::is(...)`, a member
  of an explicit specialization defined outside it, [temp.expl.spec]/5: no template<> before it): each part a name or a
  template-id as written (lookup-qualified resolves those), or nil."
  [n]
  (when-let [^String t (text-before-name n)]
    (let [t (str/trim (str/replace t #"~\s*$" ""))]
      (when (str/ends-with? t "::")
        (loop [t (str/trim (subs t 0 (- (count t) 2))) parts ()]
          (let [part (if (str/ends-with? t ">")
                       (let [i (loop [i (dec (count t)) d 0]
                                 (when (>= i 0)
                                   (let [c (.charAt t i)]
                                     (cond (= c \>) (recur (dec i) (inc d))
                                           (= c \<) (if (= d 1) i (recur (dec i) (dec d)))
                                           :else (recur (dec i) d)))))
                             m (when i (re-find #"([A-Za-z_][A-Za-z_0-9]*)\s*$" (subs t 0 i)))]
                         (when m [(- i (count (first m))) (str (second m) (str/replace (subs t i) #"\s+" " "))]))
                       (when-let [m (re-find #"([A-Za-z_][A-Za-z_0-9]*)\s*$" t)] [(- (count t) (count (first m))) (second m)]))]
            (if-not part
              (when (some #(str/includes? % "<") parts) (vec parts))
              (let [[b p] part rest-t (str/trim (subs t 0 b)) parts (cons p parts)]
                (if (str/ends-with? rest-t "::")
                  (recur (str/trim (subs rest-t 0 (- (count rest-t) 2))) parts)
                  (when (some #(str/includes? % "<") parts) (vec parts)))))))))))

(defn- split-scope
  "A qualified name's parts: the text split at the :: outside template argument lists and parentheses."
  [^String t]
  (loop [i 0 d 0 start 0 out []]
    (if (>= i (count t))
      (conj out (subs t start))
      (let [c (.charAt t i)]
        (cond
          (#{\< \(} c) (recur (inc i) (inc d) start out)
          (#{\> \)} c) (recur (inc i) (max 0 (dec d)) start out)
          (and (zero? d) (= c \:) (< (inc i) (count t)) (= \: (.charAt t (inc i)))) (recur (+ i 2) d (+ i 2) (conj out (subs t start i)))
          :else (recur (inc i) d start out))))))

(defn- ref-qualifier
  "A DeclRefExpr's written qualifier's parts and whether it starts with :: (the tree's, P13; else its text's)."
  [n]
  (if (:_wn n)
    (when (or (:globalQualifier n) (seq (:qualifier n))) [(boolean (:globalQualifier n)) (vec (:qualifier n))])
  (let [t (node-text n)]
    (when (and t (str/includes? t "::"))
      (let [g (str/starts-with? (str/trim t) "::")
            parts (vec (map str/trim (remove str/blank? (split-scope t))))]
        [g (vec (butlast parts))])))))

(defn written-targs
  "The text `name<args>` of a name expression's explicit template arguments (the tree's, P13 (b)), or nil; a node of
  no written name (the parser's own) by its text."
  [n ^String nm]
  (if (:_wn n)
    (when-let [as (:explicitTemplateArgs n)] (str nm "<" (str/join ", " as) ">"))
    (let [t (node-text n)] (when (and t (str/includes? t "<")) t))))

(defn lookup-qualified
  "The entities of a qualified name's last part, its qualifiers looked up from `scope` (the first unqualified)."
  ([scope parts] (lookup-qualified scope parts false))
  ([scope parts global?]
   (let [root (loop [s scope] (if (:parent s) (recur (:parent s)) s))]
     (loop [s (if global? root nil) [p & more] parts done []]
       (let [_ (when (and s (checking?) (not (str/includes? p "<"))) (cx-qualified-ambiguous! s p))
             es (when-not (or (str/includes? p "<") (str/starts-with? (str/trim p) "decltype")) (if s (find-here s p) (lookup scope p)))
             ;; a template-id after a qualifier: its arguments resolved where the name is written, its template
             ;; through the qualifier (ns::X<T>::v in a template's body)
             tid-type (fn [] (if (seq done)
                               (resolve-type scope (str (when global? "::") (str/join "::" (conj done p))))
                               (resolve-type (or s scope) p)))]
         ;; (cpp-tpl2, the checker: a substituted signature's qualified name of a member type its template, no class's member,
         ;; may not access, resolve-type-form's cpp/scope rule)
         (when-let [acc (when (and (empty? more) s (:cls s) (cx-subst?) (nil? (:cls scope)))
                          (some #(when (= :type (:e %)) (:access %)) es))]
           (when (and (#{:private :protected} acc) (not (cx-subst-friend? (:cls s) acc)))
             (cx-subst-fail! "'" p "' is a " (name acc) " member of '" (:name (abi/cls (:cls s))) "' within this context")))
         (if (empty? more)
           (if (str/includes? p "<")
             [{:e :type :ty (tid-type) :pos -1}] ; a template-id names a type (A<int>)
             (or (seq es) (when (and (nil? s) (= :ns (:kind scope))) nil) (header-entities parts)))
           (let [e (cond
                     ;; (cpp-s14: a decltype-specifier as the first nested-name-specifier, [expr.prim.id.qual]/1:
                     ;; `decltype(g(0))::v`, its type's scope; a reference's referred class)
                     (and (nil? s) (empty? done) (re-matches #"(?s)\s*decltype\s*\(.*\)\s*" p))
                     {:e :type :ty (abi/unq (abi/non-ref (decltype-of scope (second (re-matches #"(?s)\s*decltype\s*\((.*)\)\s*" p)))))}
                     (str/includes? p "<") {:e :type :ty (tid-type)} ; a template-id (Box<int>::count)
                     :else (first (filter #(#{:ns :type} (:e %)) es)))
                 s2 (cond (= :ns (:e e)) (:scope e)
                          (abi/class? (:ty e)) (:scope (abi/cls-of (:ty e)))
                          (abi/enum? (:ty e)) (:scope (abi/enm (:id (:ty e))))
                          :else nil)]
             (if s2
               (recur s2 more (conj done p))
               ;; a namespace only the headers declare (std::printf)
               (or (header-entities parts)
                   ;; (cpp-tpl, the checker: [basic.lookup.qual.general]/1, a nested-name-specifier's type that is no class nor
                   ;; enumeration -- a template parameter's argument int in T::x ([temp.res.general]/3 at the instantiation) --
                   ;; GCC's "'int' is not a class, struct, or union type")
                   (when (and (checking?) (= :type (:e e)) (#{:b :ptr :ref :rref :arr :mptr :fn} (:k (:ty e)))
                              (or (cx-subst?) (and (not (abi/void? (:ty e))) (not= :fn (:k (:ty e)))))
                              (not (re-find #":k :(auto|dep|tparam|tdep)" (pr-str (:ty e)))))
                     ;; (cpp-tpl2: in a function template's signature substituted, a substitution failure, cx-subst-fail!)
                     (if (cx-subst?)
                       (cx-subst-fail! "'" p "' is not a class, struct, or union type")
                       (fail :name "'" p "' is not a class, struct, or union type")))
                   (fail :lookup "no scope " p))))))))))

;; ---------------------------------------------------------------------------------------------
;; Declarations

(defn- kids [n] (filter #(and (map? %) (:kind %)) (:inner n)))

(defn body-of
  "A function declaration's body: its compound statement, or its function-try-block ([dcl.fct.def.general]/1, [except.pre]/3: the
  native parser's CXXTryStmt, as clang's FunctionDecl holds it)."
  [n]
  (first (filter #(contains? #{"CompoundStmt" "CXXTryStmt"} (:kind %)) (kids n))))

(defn- gnu-attr-arg
  "The argument of a GNU attribute `nm` among a declaration's attribute nodes (init_priority(200)): a number, or true
  when written without one; nil when absent."
  [n nm]
  (some #(when (and (= "NativeAttr" (:kind %)) (#{nm (str "__" nm "__")} (:_gnu %)))
           (or (some-> (:_arg %) str/trim parse-long) true))
        (:inner n)))

(def ^:private mode-bits
  ;; GCC's machine modes as clang's Sema::AddModeAttr (parseModeAttrArg) reads them for x86-64: QI, HI, SI, DI, TI, byte,
  ;; word (64), pointer (64), unwind_word (the target's: word), libgcc_cmp_return and libgcc_shift_count (word)
  {"QI" 8 "HI" 16 "SI" 32 "DI" 64 "TI" 128 "byte" 8 "word" 64 "pointer" 64 "unwind_word" 64 "libgcc_cmp_return" 64 "libgcc_shift_count" 64})

(defn- mode-type
  "The type `t` of a declaration `n` under GNU's mode attribute (G5c: cxxabi.h's `typedef int __guard
  __attribute__((mode (__DI__)))`, unwind.h's _Unwind_Word): an integer type of the mode's width and `t`'s signedness,
  the first of char, short, int, long, long long, __int128 of that width (clang's ASTContext::getIntTypeForBitwidth);
  `t` without one."
  [n t]
  (if-let [a (some #(when (and (= "NativeAttr" (:kind %)) (#{"mode" "__mode__"} (:_gnu %))) %) (:inner n))]
    (let [m (str/replace (str/trim (str (:_arg a))) #"^__|__$" "")
          w (or (mode-bits m) (fail :type "the mode " m))
          u (abi/unq t)]
      (when-not (and (abi/integral? u) (not= :enum (:k u))) (fail :type "the mode " m " of " (pr-str t)))
      (let [signed (abi/signed? u)
            n (case (long w) 8 (if signed :schar :uchar) 16 (if signed :short :ushort) 32 (if signed :int :uint) 64 (if signed :long :ulong)
                    128 (if signed :i128 :u128)
                    (fail :type "the mode " m))]
        (merge (abi/b n) (select-keys t [:c :v]))))
    t))

(defn- init-kid
  "A variable declaration's initializer node: its first child that is not an attribute (__attribute__((init_priority(N)))
  comes first in the tree; G5)."
  [n]
  (first (remove #(str/ends-with? (str (:kind %)) "Attr") (kids n))))

(defn- linkage-c? [scope] (:extern-c scope))

(defn internal-type?
  "cpp-rt-own2: whether the type `t` names a type of internal linkage (clang's LinkageComputer: a compound type's linkage is the
  least of its parts'): a class of an unnamed namespace or local to an internal function (its scope's :internal, declare-class!),
  a closure named $_N (internal as its call operator), a specialization of a class template with such arguments, an enumeration
  of an unnamed namespace, through pointers, references, arrays, member pointers, function types and packs. Template's
  internal-args? over a specialization's arguments; a member function's type (declare-fn!), clang's getLVForClassMember."
  ([t] (internal-type? t (java.util.HashSet.)))
  ([t ^java.util.HashSet seen]
   (letfn [(ty? [t]
             (cond
               (not (map? t)) false
               (and (contains? t :pack) (nil? (:k t)) (sequential? (:pack t))) (boolean (some ty? (:pack t)))
               (= :class (:k t)) (let [id (:id t)]
                                   (and (.add seen id)
                                        (let [c (abi/cls id)]
                                          (boolean (or (:internal (:scope c)) (and (:lambda c) (:dollar-key c))
                                                       (some ty? (:targs c)))))))
               (= :enum (:k t)) (boolean (some #(= [:anon] %) (:path (abi/enm (:id t)))))
               (#{:ptr :ref :rref :arr} (:k t)) (ty? (or (:to t) (:of t)))
               (= :mptr (:k t)) (or (ty? (:to t)) (ty? (if (map? (:cls t)) (:cls t) {:k :class :id (:cls t)})))
               (= :fn (:k t)) (boolean (or (ty? (:ret t)) (some ty? (:ps t))))
               :else false))]
     (ty? t))))

(defn- ns-scope! [parent nm anon]
  (let [k (if anon "" nm)
        ^java.util.HashMap m (:names parent)
        old (first (filter #(= :ns (:e %)) (.get m (str " ns " k))))]
    (if old
      (:scope old)
      (let [s (new-scope :ns parent :path (conj (:path parent) (if anon [:anon] [:ns nm])) :internal (or anon (:internal parent)))]
        (enter! parent (str " ns " k) {:e :ns :scope s :pos -1})
        (if anon
          (.add ^java.util.ArrayList (:usings parent) s)
          (enter! parent nm {:e :ns :scope s :pos -1}))
        s))))

(declare declare-node! special-members! finish-class!)

(defn- cx-member-recover!
  "Queue 526 (the checker): runs `f`, the declaration of the member node `k` of the class `id` (its scope `cs`); a recoverable
  refusal (cx-recoverable?) of a main-file member of a class that is no template's specialization nor a local class drops
  the member and records its names (cx-dropped!)."
  [cs id k f]
  (if (and (checking?) *cx-dropped* (not (header-node? k))
           (let [c (abi/cls id)] (and c (not (:tmpl c)) (not (:targs c)) (not (:header c)) (not (:lambda c))))
           ;; (not a local class's: its refusal is its function's, reported there by its rule as before)
           (not (loop [s (:parent cs)] (cond (nil? s) false (#{:block :fn} (:kind s)) true :else (recur (:parent s))))))
    (try (f)
         (catch arbace.lang.ExceptionInfo e
           (if (cx-recoverable? e) (cx-dropped! cs k) (throw e))))
    (f)))

(defn cx-unexpanded-packs
  "Queue 573 (the checker): the names of `packs` (a set) the type text `s` names outside a pack expansion, [temp.variadic]/5
  (arbace.repr.cpp.diag's unexpanded-in-text, the rule the checker's caller reports by; nil when that namespace is not
  loaded, outside the checker)."
  [packs s]
  (when (and (seq packs) (seq s))
    (when-let [f (some-> (find-ns 'arbace.repr.cpp.diag) (ns-resolve 'unexpanded-in-text))]
      (f packs s))))

(defn cx-sans-noexcept
  "Queue 573: a function type's text up to its noexcept-specifier, if any."
  ^String [^String s]
  (if-let [m (re-find #"(?s)^(.*?)\s*\bnoexcept\b" s)] (second m) s))

(defn- cx-pack-dropped-member?
  "Queue 573 (567-2 (a), the checker): whether the member node `k` of the class `id`, a main file's class template's
  specialization, declares a type that names a pack of the template's head (the class's :cx-packs) outside a pack
  expansion, ill-formed by [temp.variadic]/5 (diag.ae reports it at the pattern). GCC drops such a member from the class
  after its error, so a later use of it is an error of its own: cpp0x/pr32127.C's `A<int>::i` \"is not a member\",
  cpp0x/pr31437.C's `A<int> a(0)` with the constructor gone \"no matching function\". Not recorded among the dropped names
  (cx-dropped!): those later errors are GCC's too. A member template's own parameters hide the class's packs of their names."
  [id k]
  (when (and (checking?) (not (header-node? k)) (not (:isImplicit k))
             (#{"FieldDecl" "VarDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXConversionDecl" "FunctionDecl" "TypedefDecl"
                "TypeAliasDecl" "FunctionTemplateDecl"} (:kind k)))
    (let [c (abi/cls id)
          packs (:cx-packs c)]
      (when (and (seq packs) (:targs c) (not (:header c)))
        (let [[packs x] (if (= "FunctionTemplateDecl" (:kind k))
                          (let [tps (filter #(#{"TemplateTypeParmDecl" "NonTypeTemplateParmDecl" "TemplateTemplateParmDecl"} (:kind %)) (kids k))]
                            [(reduce (fn [s p] (if (:name p) (if (:isParameterPack p) (conj s (:name p)) (disj s (:name p))) s)) packs tps)
                             (first (filter #(#{"FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXConversionDecl"} (:kind %)) (kids k)))])
                          [packs k])]
          ;; (a function's noexcept-specifier left out: GCC reports its pack there and keeps the member, cpp0x/noexcept66.C)
          (boolean (and x (cx-unexpanded-packs packs (cx-sans-noexcept (str (get-in x [:type :qualType])))))))))))

(defn- fn-op [^String nm] (when (str/starts-with? nm "operator") (let [o (str/trim (subs nm 8))] (when (seq o) o))))

(defn- param-nodes [n] (filter #(= "ParmVarDecl" (:kind %)) (kids n)))



(defn- same-sig? [f g]
  (and (= (:name f) (:name g)) (= (:kind f) (:kind g)) (= (boolean (:cq f)) (boolean (:cq g))) (= (:refq f) (:refq g))
       (= (mapv abi/unq (:ps (:ty f))) (mapv abi/unq (:ps (:ty g))))))

;; queue 367-2 (a): the function template specialization being declared ({:tid :args}, template.ae's instantiate-fn): another
;; specialization of the same template with other arguments is no redeclaration of it though their types are equal
;; ([temp.over.link]: the template arguments are part of a specialization's identity; string-inst.cc's S::_M_construct<false>
;; and <true>, both (const C*, size_t), had been one function, its arguments the last's)
(def ^:dynamic *instantiating* nil)

(defn- find-redecl [scope f]
  (let [^java.util.HashMap m (:names scope)
        other-spec? (fn [g] (when-let [{:keys [tid args]} *instantiating*]
                              (let [ti (:tinst g)] (and ti (= tid (:tid ti)) (not= args (:args ti))))))]
    (some (fn [e] (when (and (= :fn (:e e)) (same-sig? (fnd (:id e)) f) (not (other-spec? (fnd (:id e))))
                             ;; (cpp-decl2, the checker: a base's member a using-declaration names is no declaration the class's
                             ;; own member redeclares: it hides it or overloads it, [namespace.udecl]/14, cx-udecl-hide!)
                             (not (and (checking?) (:ucls e) (:cls f) (not= (:cls (fnd (:id e))) (:cls f)))))
                    (:id e)))
          (.get m (case (:kind f) :ctor " ctor" :dtor " dtor" (:name f))))))

(defn- cx-udecl-hide!
  "cpp-decl2, the checker: [namespace.udecl]/14 (C++20), the class's member function `f` (node `n`) hides a base's member a
  using-declaration brought in with the same name, parameter-type-list, cv- and ref-qualifiers and trailing requires-clause; one
  whose requires-clause differs stays a candidate beside it (cpp2a/concepts-memfun4.C's S<>{}.f(): ambiguous, CWG 2789)."
  [home f n]
  (when (and (checking?) (:cls f))
    (let [^java.util.HashMap m (:names home)
          k (:name f)
          rq (fn [x] (some-> (:trailingRequiresClause x) node-text (str/replace #"\s+" "")))]
      (when-let [es (seq (.get m k))]
        (let [keep (remove (fn [e] (and (= :fn (:e e)) (:ucls e)
                                        (let [g (fnd (:id e))]
                                          (and g (not= (:cls g) (:cls f)) (same-sig? g f) (= (rq (:node g)) (rq n))))))
                           es)]
          (when (< (count keep) (count es)) (.put m k (vec keep))))))))

;; queue 445: a block-scope function declaration ([basic.link]/6, [basic.scope.block]: `void terminate() noexcept;` in c++config.h's
;; std::__terminate) declares the function of its innermost enclosing namespace, named in the block alone: clang mangles it
;; at that namespace (_ZSt9terminatev, not a local entity's _ZZSt11__terminatevE9terminatev, which no unit defines). The
;; code generator's (bound by analyze's DeclStmt when not checking): its declaration joins one of the namespace, and one
;; made first is kept in the namespace under a key no lookup uses, which a later namespace-scope declaration joins.
(def ^:dynamic *block-fn* false)

(defn- block-fn-key ^String [^String nm] (str " block-fn " nm))

(defn- find-block-redecl [scope f]
  (when (= :fn (:kind f))
    (some (fn [e] (when (same-sig? (fnd (:id e)) f) (:id e))) (.get ^java.util.HashMap (:names scope) (block-fn-key (:name f))))))

(declare analyze rv ce-try cx-cce-type!)

(defn- noexcept-of
  "Whether a function type's spelling says noexcept: `noexcept`, `noexcept(true)`, or noexcept(e) of a constant e
  true ([except.spec]/2; G4: the headers' noexcept(__and_<...>::value), evaluated in `scope`, not noexcept when it
  cannot be)."
  [scope ^String qt]
  (let [qt (or qt "")
        m (re-matcher #"\bnoexcept\b" qt)]
    (if-not (.find m)
      ;; throw(): noexcept(true) since C++17 ([except.spec]/1, clang's EST_DynamicNone)
      (boolean (re-find #"\bthrow\s*\(\s*\)" qt))
      (let [i (.end m)
            j (loop [j i] (if (and (< j (count qt)) (Character/isWhitespace (.charAt qt j))) (recur (inc j)) j))]
        (if (or (>= j (count qt)) (not= \( (.charAt qt j)))
          true
          (let [k (loop [k (inc j) d 1] (cond (>= k (count qt)) nil (= \( (.charAt qt k)) (recur (inc k) (inc d))
                                               (= \) (.charAt qt k)) (if (= d 1) k (recur (inc k) (dec d))) :else (recur (inc k) d)))
                e (when k (str/trim (subs qt (inc j) k)))]
            (cond (nil? e) false
                  (= e "true") true
                  (= e "false") false
                  ;; the operand the native parser kept (G5): analyzed with the parameters in scope, a constant
                  (get *decltypes* (str "noexcept:" (str/replace e #"\s+" "")))
                  (let [x (get *decltypes* (str "noexcept:" (str/replace e #"\s+" "")))
                        a (when (checking?) (try (rv (binding [*cutoff* Long/MAX_VALUE] (analyze {:scope scope} x))) (catch arbace.lang.ExceptionInfo _ nil)))
                        v (try (ce-try (rv (binding [*cutoff* Long/MAX_VALUE] (analyze {:scope scope} x))))
                               (catch arbace.lang.ExceptionInfo _ nil))]
                    ;; (queue 584, the checker: the operand a contextually converted constant expression of type bool,
                    ;; [except.spec]/1 with [expr.const]/12 (P1401R5): an integer constant other than 0 and 1 narrows, GCC's
                    ;; "narrowing conversion of '2' from 'long unsigned int' to 'bool'"; cpp23/narrowing-bool1.C)
                    (when-let [h (and a v (= :int (:op v)) (not (#{0 1} (long (:v v)))) (abi/integral? (abi/unq (:ty a)))
                                      (not= :bool (:n (abi/unq (:ty a)))) (map? x) (not (header-node? x)) *on-refusal*)]
                      (h (ex-info (str "codegen: narrowing conversion of '" (:v v) "' to 'bool' in a noexcept-specifier") {:codegen/refused :narrowing :cx/node x}) x))
                    (boolean (and v (= :int (:op v)) (not (zero? (long (:v v)))))))
                  :else (let [v (try (when-let [h (:trait-text @hooks)] (binding [*cutoff* Long/MAX_VALUE] (h scope e)))
                                     (catch arbace.lang.ExceptionInfo _ nil))]
                          (and (number? v) (not (zero? (double v))))))))))))

(def ^:dynamic *constraint-depth* 0)
;; (cpp-small: the function templates' specializations whose associated constraints are being checked, [tid args] outermost first,
;; arbace.cpp.template/instantiate-fn's)
(def ^:dynamic *constraint-insts* [])
;; (and the constraint expressions being checked, outermost first: the innermost one not a concept-id is where the recursion is
;; reported, the requires-expression whose call makes the next specialization)
(def ^:dynamic *constraint-node* nil)
(def ^:dynamic *constraint-stack* nil)
;; CX12, CP281 (a) (the checker): an atom set when a satisfaction's evaluation met an expression the slice could not analyze
;; or evaluate (a refusal read as not satisfied): its false then not sure. A false with the atom unset is the program's own
;; (an atomic constraint that evaluated to false, [temp.constr.atomic]/3), a sure deduction failure.
(def ^:dynamic *constraint-doubt* nil)
(def ^:dynamic *constraint-this*
  "n-cpp-concepts (the checker): the class pointer type `this` has in a member function's trailing requires-clause while it is
  checked at the declaration ([expr.prim.this]/2; its unevaluated operands name the members, [expr.prim.id.general]/3), else nil."
  nil)

(defn doubt! [] (when-let [d *constraint-doubt*] (reset! d true)) false)

(defn- class-scope?
  "Whether `scope` is a class's or within one (a member's body, a member template's constraint)."
  [scope]
  (loop [s scope] (cond (nil? s) false (or (:cls s) (= :class (:kind s))) true :else (recur (:parent s)))))

(defn sure-failure?
  "n-cpp-concepts (the checker): whether the refusal `e`, met while a constraint or a requirement was substituted or analyzed,
  is the program's own error ([temp.constr.atomic]/3, [expr.prim.req.simple]/1: a substitution failure, so not satisfied, with
  no doubt): the errors the checker reports as the program's at a statement (arbace.repr.cpp.diag's sema-rules: no member, an
  inaccessible or deleted function, no viable or an ambiguous call, no operator, an undeclared name, a call of a non-function,
  too few arguments, `*` of a non-pointer, a member of a non-class; queue 584: a unary operator's operand of a type it does not
  take, [expr.unary.op]/7-10; a nested-name-specifier's type that is no class, [temp.deduct.general]/11.3), and a qualified name no complete class without bases declares (name-expr's); never over a type
  the slice left dependent or undeduced."
  [e]
  (let [m (str (ex-message e))]
    (boolean (and (checking?)
                  (re-find #"^codegen: (\* of a non-pointer|member of a non-class|no member |'[^']*' is a (private|protected) member of|call to a deleted function|no viable function among [1-9]|ambiguous call|no match for 'operator|use of undeclared identifier|call of a non-function|missing argument|narrowing conversion from|unknown name \S+: no member of the complete class|template constraint failure for|cannot call member function '[^']*' without object|invalid use of non-static member function|ordered comparison of pointer with integer zero|wrong type argument to unary|'[^']*' is not a class, struct, or union type)" m)
                  (not (re-find #":k :(auto|dep|tparam)" m))))))

(declare const-int analyze)

(defn- atom-types-check
  "n-cpp-concepts (the checker), [temp.constr.atomic]/3: each atomic constraint satisfaction reaches (the operands of the
  constraint-expression's && and ||, in order, short-circuited, [temp.constr.op]/3-4) has type bool, no conversion; one of
  class type, or the non-bool result of a call (an overloaded operator's), is GCC's \"constraint expression does not have type
  'bool'\", reported at the atom: ::bad (not satisfied), else nil. Anything the slice cannot analyze or evaluate decides
  nothing here (the satisfaction's own evaluation follows)."
  [scope n]
  (let [k (:kind n)]
    (cond
      (#{"ParenExpr" "ExprWithCleanups"} k) (atom-types-check scope (first (kids n)))
      (and (= "BinaryOperator" k) (#{"&&" "||"} (:opcode n)))
      (let [[a b] (kids n)
            ra (atom-types-check scope a)]
        (if (= ::bad ra)
          ::bad
          (let [v (try (const-int scope a) (catch arbace.lang.ExceptionInfo _ nil))]
            (if (or (nil? v) (if (= "&&" (:opcode n)) (not= 0 (long v)) (= 0 (long v))))
              (when v (atom-types-check scope b))
              nil))))
      ;; (a concept-id is no atom: normalized into its concept's, checked by its own satisfaction)
      (= "ConceptSpecializationExpr" k) nil
      :else
      (let [x (try (binding [*cutoff* (long (or (:cx-cutoff scope) Long/MAX_VALUE))] (analyze {:scope scope} n)) (catch arbace.lang.ExceptionInfo _ nil))
            t (some-> x :ty abi/non-ref abi/unq)]
        (when (and t (not (dt-dependent? t)) (not= :bool (abi/bn t))
                   (or (abi/class? t) (and (= :call (:op x)) (or (abi/arith? t) (abi/ptr? t)))
                       ;; (cpp-tpl2: a name alone, a non-type template parameter or a variable, of an integral or pointer type
                       ;; other than bool: `requires N` of an int N, cpp2a/concepts-requires1.C's S1 and S4<int, 0>)
                       (and (= "DeclRefExpr" k) (or (abi/integral? t) (abi/ptr? t)) (not (header-node? n)))))
          (when-let [h *on-refusal*]
            (h (ex-info "codegen: constraint expression does not have type 'bool'" {:codegen/refused :constraint :cx/node n}) n))
          ::bad)))))

(declare ^:dynamic *ce-manifest* ce-eval convert-scalar rv)
;; cpp-tpl2 (the checker): the name of the template whose associated constraints are being checked (a static member's access in
;; them judged by the friends of that name, cx-static-access!), or nil
(def ^:dynamic *cx-constraint-of* nil)
;; cpp-tpl2 (the checker): GCC's -fconcepts-diagnostics-depth=N (arbace.repr.cpp.diag binds it; GCC's default 1)
(def ^:dynamic *concepts-diag-depth* 1)
;; cpp-tpl2 (the checker): an atom the satisfactions under way add their atomic constraints' sure errors to ({:msg :node}), GCC's
;; explanations of a constraint not satisfied; nil when no caller reports them
(def ^:dynamic *cx-constraint-explain* nil)

(defn constraint-satisfied?
  "A constraint expression's satisfaction in `scope` ([temp.constr.constr]: the atomic constraints constant expressions
  of type bool; a substitution failure or an expression not constant is not satisfied)."
  [scope rc]
  ;; (a satisfaction that needs itself, through the constraints of the templates it instantiates, is not satisfied:
  ;; clang's "satisfaction of constraint depends on itself", [temp.constr.atomic]/3; the depth bounds it, G5)
  (try (when (> (long *constraint-depth*) 24)
         (when (System/getenv "CPP_CONCEPT_TRACE") (binding [*out* *err*] (println "constraint depth" (pr-str *constraint-stack*))))
         ;; (cpp-small, G1, the checker: the satisfactions under way the constraints of one function template's specializations, each
         ;; with arguments not seen before in the chain, a recursion that makes new specializations without end, `foo<N + 1>(t)` in
         ;; the constraint of foo<N>: GCC's fatal "template instantiation depth exceeds maximum" at the atom being checked,
         ;; cpp2a/concepts-recursive-sat1.C; the same arguments again stay a satisfaction that depends on itself)
         (when (checking?)
           (let [xs *constraint-insts*]
             (when (and (>= (count xs) 10) (apply = (map first (take-last 10 xs))) (apply distinct? (take-last 10 xs)))
               (when (System/getenv "CPP_DEPTH_TRACE") (binding [*out* *err*] (println "constraint nodes" (pr-str (map (juxt :kind #(get-in % [:range :begin :offset])) *constraint-node*)))))
               (depth-fatal! "the constraints' satisfaction" (last (filter #(and (map? %) (:range %) (not (#{"ConceptSpecializationExpr" "DeclRefExpr"} (:kind %)))) *constraint-node*))))))
         (fail :template "a constraint's satisfaction depends on itself"))
       (binding [*constraint-depth* (inc (long *constraint-depth*)) *constraint-node* (if (checking?) (conj (or *constraint-node* []) rc) *constraint-node*)
                 *constraint-stack* (when (System/getenv "CPP_CONCEPT_TRACE") (conj (or *constraint-stack* []) (let [t (str (node-text rc))] (subs t 0 (min 60 (count t))))))]
         ;; (the checker's position stays the call's: the constraint's nodes are the template's)
         (let [a *at* saved (some-> a deref)]
           (try (if (and (checking?) (= ::bad (atom-types-check scope rc)))
                  false
                  (not= 0 (long (const-int scope rc))))
                (finally (when a (reset! a saved))))))
       (catch arbace.lang.ExceptionInfo e
         (when (or (System/getenv "CPP_TMPL_TRACE") (System/getenv "CPP_CONCEPT_TRACE")) (binding [*out* *err*] (println "constraint not satisfied:" (.getMessage e))))
         ;; (cpp-tpl2, the checker: [temp.constr.atomic]/3, an atomic constraint that analyzes but is surely no constant
         ;; expression -- `bool(T(1))` for T = int*, a reinterpret_cast, [expr.const]/5.15 -- makes the program ill-formed, not
         ;; the constraint false: the checker's evaluator's sure refusal (h-cpp-consteval's :cx/sure) reported at its operation,
         ;; the constraint then not satisfied: cpp2a/concepts-pr98644.C)
         (if-let [y (when (and (checking?) (not (:cx/sure (ex-data e))) (not (sure-failure? e)) (map? rc) (not (header-node? rc))
                                 ;; (not for a recursion found, nor deep in nested satisfactions: cpp2a/concepts-recursive-sat1.C)
                                 (not= :depth (:codegen/refused (ex-data e))) (not (re-find #"depends on itself" (str (ex-message e))))
                                 (<= (long *constraint-depth*) 1))
                      (try (let [x (binding [*cutoff* (long (or (:cx-cutoff scope) Long/MAX_VALUE))] (analyze {:scope scope} rc))]
                             (binding [*ce-manifest* true] (ce-eval (convert-scalar (rv x) abi/bool* false)))
                             nil)
                           (catch arbace.lang.ExceptionInfo y (when (:cx/sure (ex-data y)) y))))]
           (do (when-let [h *on-refusal*]
                 (h (ex-info (str "codegen: expression is not a constant expression (" (subs (str (ex-message y)) (min (count (str (ex-message y))) (count "not a constant: "))) ")")
                             {:codegen/refused :constexpr :cx/node (if-let [at (:cx/at (ex-data y))] {:range at} rc)})
                    nil))
               false)
         ;; (n-cpp-concepts: an atomic constraint whose substitution fails by the program's own error is false, no doubt)
         ;; (cpp-tpl2: and a main file's atom that names a type as its expression, ill-formed, GCC's "expected primary-expression"
         ;; there, arbace.repr.cpp.diag's type-exprs: never satisfied, cpp2a/concepts-requires15.C)
         (if (or (sure-failure? e)
                 (and (checking?) (re-find #"^codegen: name \S+ of kind :type" (str (ex-message e)))
                      (map? rc) (= "DeclRefExpr" (:kind rc)) (not (header-node? rc))))
           (do ;; (cpp-tpl2: the error recorded as GCC's explanation of the unsatisfied constraint, at the atom, when a caller asks,
               ;; *cx-constraint-explain*: the template constraint failure's or the call's report carries it)
               (when-let [x *cx-constraint-explain*]
                 (swap! x conj {:msg (ex-message e) :node (or (:cx/node (ex-data e)) rc)}))
               false)
           (doubt!))))))

(defn- always-inline-node?
  "Whether a function declaration's attributes hold GNU's always_inline ([[gnu::always_inline]], __attribute__((always_inline)))."
  [n]
  (boolean (some #(and (= "NativeAttr" (:kind %)) (#{"always_inline" "__always_inline__"} (:_gnu %))) (:inner n))))

(defn- noreturn-node?
  "Whether a function declaration says it does not return ([[noreturn]], __attribute__((noreturn)); [dcl.attr.noreturn])."
  [n]
  (boolean (some #(and (= "NativeAttr" (:kind %))
                       (or (#{"noreturn" "__noreturn__"} (:_gnu %))
                           (and (nil? (:_gnu %)) (re-find #"^\s*\[\[\s*(?:std\s*::\s*)?noreturn\b" (str (node-text %))))))
                 (:inner n))))


;; queue 497 (the checker): GNU's unavailable attribute ("the entity is available for declaration but not for use":
;; __attribute__((unavailable)), [[gnu::unavailable]]), whose use GCC rejects ("'f' is unavailable"), as clang's
;; err_unavailable: a declaration that carries it.
(defn- unavailable-node? [n]
  (boolean (and (map? n)
                (or (some #(and (map? %) (= "NativeAttr" (:kind %)) (#{"unavailable" "__unavailable__"} (:_gnu %))) (:inner n))
                    (some #(#{"unavailable" "__unavailable__"} (:name %)) (:_gattrs n))))))

(declare explicit-spec* to-bool)

(defn- explicit-spec
  "A function declaration's explicit-specifier ([dcl.fct.spec]/3): `explicit`, or `explicit(constant-expression)` true
  when the expression converts to true (C++20; CP280 (a)); a value the slice cannot evaluate counts as explicit, as
  before."
  [scope ^String text]
  (first (explicit-spec* scope text)))

(defn- explicit-spec*
  "explicit-spec's [explicit? sure?]: sure? false for an explicit(cond) whose value the slice could not evaluate (queue 497)."
  [scope ^String text]
  (let [t (or text "")]
    ;; (cpp-tzdb, the code generator: the text is the source's, so a reserved macro's name may stand before `explicit`,
    ;; <bits/basic_string.h>'s `_GLIBCXX20_CONSTEXPR explicit basic_string(const _Tp&, const _Alloc& = _Alloc())`, which had
    ;; converted a string_view to a string implicitly: the conditional operator's string_view : string had both ways)
    (if-let [[_ rest] (if (checking?)
                        (re-find #"(?s)^\s*(?:inline\s+|constexpr\s+)*explicit(?![A-Za-z0-9_$])\s*(\(.*)?" t)
                        (re-find #"(?s)^\s*(?:inline\s+|constexpr\s+|_[A-Z][A-Z0-9_]*\s+)*explicit(?![A-Za-z0-9_$])\s*(\(.*)?" t))]
      (if (and rest (str/starts-with? rest "("))
        (let [depth (atom 0)
              end (loop [i 0] (if (>= i (count rest)) nil
                                  (let [c (.charAt ^String rest i)]
                                    (cond (= c \() (do (swap! depth inc) (recur (inc i)))
                                          (= c \)) (if (= 1 (long @depth)) i (do (swap! depth dec) (recur (inc i))))
                                          :else (recur (inc i))))))
              x (when end (subs rest 1 end))
              ;; (queue 584, the checker: the operand the native parser kept, a contextually converted constant expression of
              ;; type bool, manifestly constant-evaluated, [dcl.fct.spec]/3, [expr.const]/20: analyzed and evaluated as such,
              ;; a class's conversion to bool and __builtin_is_constant_evaluated() among it; cpp2a/explicit5.C's
              ;; explicit(W()), is-constant-evaluated8.C)
              v (when-let [xn (and x (checking?) (get *decltypes* (str "explicit:" (str/replace x #"\s+" ""))))]
                  (try (let [a (binding [*cutoff* Long/MAX_VALUE] (analyze {:scope scope :statics (atom [])} xn))
                             r (ce-try (to-bool a) true)]
                         (when (and (= :int (:op r)) (number? (:v r))) (:v r)))
                       (catch Exception _ nil)))
              v (or v (when x (try (when-let [h (:trait-text @hooks)] (binding [*cutoff* Long/MAX_VALUE] (h scope x)))
                                   (catch arbace.lang.ExceptionInfo _ nil))))]
          (if (number? v) [(not (zero? (double v))) true] [true false]))
        [true true])
      [false true])))

(defn- unfinished-targs?
  "cpp-s11: whether `scope` is a class template specialization's (or within one) whose template arguments name a class
  not finished yet (abi's :finished)."
  [scope]
  (loop [s scope]
    (cond (nil? s) false
          (:cls s) (let [c (abi/cls (:cls s))]
                     (or (boolean (some #(and (map? %) (= :class (:k %)) (not (:finished (abi/cls (:id %))))) (tree-seq coll? seq (:targs c))))
                         (recur (:parent s))))
          :else (recur (:parent s)))))

(defn trailing-ok?
  "cpp-s11: a function declared with its trailing requires-clause deferred (declare-fn!'s :trailing-defer) satisfies it
  now; any other true."
  [f]
  (if-let [[ps rc] (:trailing-defer f)]
    (if (checking?)
      ;; (n-cpp-concepts: in the checker a doubt keeps the function viable, its class's `this` in scope)
      (let [d (atom false)
            v (binding [*constraint-doubt* d *constraint-this* (when-let [c (:cls f)] (abi/ptr {:k :class :id c}))] (constraint-satisfied? ps rc))]
        (or v @d))
      (constraint-satisfied? ps rc))
    true))

(defn fn-type-scope
  "The scope a function declaration's type is resolved in: `rs`, or when its spelling has a decltype or a noexcept(e), a
  block scope over it with the parameters ([basic.scope.param]: a trailing return type's decltype names them, `->
  decltype(make_move_iterator(__it.base()))`, G4), each with its index (:fpi, a dependent decltype's fp_ in the mangling,
  CP391 (a))."
  [rs n]
  (let [qt (get-in n [:type :qualType])]
    (if (and qt (or (str/includes? qt "decltype") (str/includes? qt "noexcept(")))
      (let [ps (new-scope :block rs :fn-type true)
            pns (vec (param-nodes n))
            packed (mapv #(boolean (re-find #"\.\.\.\s*$" (or (get-in % [:type :qualType]) ""))) pns)
            ;; (cpp-rt-own2: a function parameter pack, `_Args&&... __args`, its parameters from the function type's (the pack
            ;; expanded) and its name standing for them, as a body's (analyze-fn!'s :varpack): <alloc_traits.h>'s construct,
            ;; `noexcept(noexcept(__a.construct(__p, std::forward<_Args>(__args)...)))`, not noexcept before (__args unbound),
            ;; so vector's _S_use_relocate() false and its reallocation a copy where clang relocates)
            fty (when (some true? packed) (try (resolve-type rs qt) (catch arbace.lang.ExceptionInfo _ nil)))
            n-pack (when (= :fn (:k fty)) (- (count (:ps fty)) (dec (count pns))))]
        (if (and n-pack (= 1 (count (filter true? packed))) (>= (long n-pack) 0))
          (loop [i 0 j 0]
            (when (< i (count pns))
              (let [pn (nth pns i)]
                (if (nth packed i)
                  (let [ids (vec (for [k (range j (+ j (long n-pack)))]
                                   (let [id (next-id)] (swap! *vars* assoc id {:id id :name nil :ty (nth (:ps fty) k) :storage :param :fpi i}) id)))]
                    (when (:name pn) (enter! ps (:name pn) {:e :varpack :ids ids}))
                    (recur (inc i) (+ j (long n-pack))))
                  (do (when (:name pn)
                        (let [id (next-id)]
                          (swap! *vars* assoc id {:id id :name (:name pn) :ty (nth (:ps fty) j) :storage :param :fpi i})
                          (enter! ps (:name pn) {:e :var :id id})))
                      (recur (inc i) (inc j)))))))
          (doseq [[i pn] (map-indexed vector pns) :when (:name pn)]
            (when-let [t (try (resolve-type rs (get-in pn [:type :qualType])) (catch arbace.lang.ExceptionInfo _ nil))]
              (let [id (next-id)]
                (swap! *vars* assoc id {:id id :name (:name pn) :ty t :storage :param :fpi i})
                (enter! ps (:name pn) {:e :var :id id})))))
        ps)
      rs)))

(declare cx-type-friend?)

(defn- cx-member-type-access!
  "Queue 492 (the checker): [class.access]/1, a member declaration `k` of the class `cid` (scope `cs`) whose written type
  names a private member type of another class: unqualified, found in a base class (the class itself declaring no such
  name), or qualified by a class that is neither `cid` nor one enclosing it; that class declaring no friend (cx-type-friend?).
  GCC's \"'typedef int A::mytype' is private within this context\", at the member."
  [cs cid k]
  (when (and (checking?) (not (header-node? k)))
    (let [t (-> (str (get-in k [:type :qualType])) (str/replace #"^\s*(?:(?:const|volatile|typename|struct|class|enum|union)\s+)+" ""))
          priv (fn [c nm] (let [es (.get ^java.util.HashMap (:names (:scope c)) nm)]
                            (when (seq es) [(some #(when (= :type (:e %)) (:access %)) es)])))
          bad (fn [c nm] (throw (ex-info (str "codegen: '" nm "' is a private member of '" (:name c) "'") {:codegen/refused :access :cx/node k})))
          enclosing (loop [c (abi/cls cid) out #{}] (if c (recur (when (= :class (:kind (:outer c))) (abi/cls (:cls (:outer c)))) (conj out (:id c))) out))]
      (try
        (if-let [[_ nm] (re-find #"^([A-Za-z_]\w*)(?![\w:<])" t)]
          ;; unqualified: the first base, breadth first, that declares it
          (when (empty? (.get ^java.util.HashMap (:names cs) nm))
            (loop [todo (map :cls (remove :dependent (:bases (abi/cls cid)))) seen #{}]
              (when-let [b (first todo)]
                (let [c (abi/cls b)]
                  (cond (or (nil? b) (nil? c) (seen b)) (recur (rest todo) (conj seen b))
                        :else (if-let [[acc] (priv c nm)]
                                (when (and (= :private acc) (not (cx-type-friend? b acc))) (bad c nm))
                                (recur (concat (rest todo) (map :cls (remove :dependent (:bases c)))) (conj seen b))))))))
          (when-let [[_ q nm] (re-find #"^((?:[A-Za-z_]\w*::)+)([A-Za-z_]\w*)(?![\w:<])" t)]
            (let [parts (vec (remove str/blank? (str/split q #"::")))
                  ce (try (first (filter #(= :type (:e %)) (lookup-qualified cs parts))) (catch arbace.lang.ExceptionInfo _ nil))
                  qc (when ce (try (class-id (:ty ce)) (catch arbace.lang.ExceptionInfo _ nil)))]
              (when (and qc (not (enclosing qc)) (abi/cls qc))
                (when-let [[acc] (priv (abi/cls qc) nm)]
                  (when (and (= :private acc) (not (cx-type-friend? qc acc))) (bad (abi/cls qc) nm)))))))
        (catch arbace.lang.ExceptionInfo x
          (if (= :access (:codegen/refused (ex-data x))) (*on-refusal* x k) (throw x)))))))

;; cpp-rt-own4, the code generator: a member function's type being resolved (declare-fn!), where a class template's
;; specialization is only named ([temp.inst]/2): template.ae's instantiate-class* names one lazily there when its template
;; is already being instantiated twice up the stack (<valarray>'s _Expr<_UnClos<__unary_plus, _Expr, _Clos>, value_type>
;; operator+() const, an endless chain of instantiations otherwise); declare-instance! binds it false for a class's body
(def ^:dynamic *in-signature* false)

(declare cx-abstract!)

(defn- declare-fn!
  "A function, method, constructor or destructor declaration (or definition) in `scope`; out-of-line definitions join
  their declaration. One whose trailing requires-clause is not satisfied is not declared (nil; P14 (b), G4)."
  [scope n]
  ;; (cpp-decl2, the checker: a non-member operator=, operator(), operator[] or operator-> is ill-formed, [over.ass]/1,
  ;; [over.call]/1, [over.sub]/1, [over.ref]/1 (the parser's error); GCC does not declare it, so its use is "'operator='
  ;; not defined", other/operator1.C)
  (if (and (checking?) (= "FunctionDecl" (:kind n)) (not (:cls scope)) (not (:friend n))
           (#{"operator=" "operator()" "operator[]" "operator->"} (:name n)))
    nil
  (let [rc (:trailingRequiresClause n)
        ;; (its parameters in scope: requires { __lhs.base() == __rhs.base(); }, G4)
        rps (when rc (let [ps (new-scope :block scope)]
                       (doseq [pn (param-nodes n) :when (:name pn)]
                         (when-let [t (try (resolve-type scope (get-in pn [:type :qualType])) (catch arbace.lang.ExceptionInfo _ nil))]
                           (let [id (next-id)]
                             (swap! *vars* assoc id {:id id :name (:name pn) :ty t :storage :param})
                             (enter! ps (:name pn) {:e :var :id id}))))
                       ps))
        ;; (cpp-s11: a member of a class template's specialization whose arguments name a class not finished yet, the
        ;; derived class of a CRTP base being instantiated for it -- view_interface<subrange<...>>'s `empty() requires
        ;; forward_range<_Derived>` while subrange<...> is declared -- keeps its constraint for overload resolution,
        ;; [over.match.viable]/3, where it is checked: declared now, neither dropped nor kept by an answer that would
        ;; change once the class is complete)
        defer (boolean (and rc (unfinished-targs? scope)))
        ;; (n-cpp-concepts, the checker: a member's constraint with `this` its class's, *constraint-this*; one not satisfied
        ;; with a doubt, the function declared with its constraint deferred to overload resolution, trailing-ok?, where a
        ;; doubt keeps it viable: before, dropped, its calls "no member": cpp2a/concepts-this1.C's A<B>().g(0))
        dd (atom false)
        sat (or (nil? rc) defer (binding [*constraint-this* (when (and (checking?) (:cls scope)) (abi/ptr {:k :class :id (:cls scope)}))
                                          *constraint-doubt* (if (checking?) dd *constraint-doubt*)]
                                  (constraint-satisfied? rps rc)))
        _ (when (and (checking?) @dd *constraint-doubt*) (reset! *constraint-doubt* true))
        defer (or defer (boolean (and (checking?) (not sat) @dd)))]
  (if (and (not sat) (not defer))
    (do ;; (queue 510, the checker: a constructor so dropped is user-declared all the same, [class.default.ctor]/1: no implicit
        ;; default constructor for its class, finish-class!; cpp2a/concepts-inherit-ctor2.C's S1<int>)
        (when (and (checking?) (= "CXXConstructorDecl" (:kind n)) (:cls scope))
          (abi/update-cls! (:cls scope) assoc :cx-ctor-dropped true))
        nil)
  (let [q (when (#{"CXXMethodDecl" "CXXConstructorDecl" "CXXDestructorDecl" "FunctionDecl" "CXXConversionDecl"} (:kind n))
            (or (when-let [q (expanded-qualifier n)] (when (some #(str/includes? % "<") q) q))
                (qualifier-before n) (qualifier-tid-before n)
                ;; (cpp-rt-own: a declaration a macro writes has no source text before its name, so the parser's tokens:
                ;; libcpp's init.cc `TRIGRAPH_MAP`, `constexpr _cpp_trigraph_map_s::_cpp_trigraph_map_s () : map {} {`, a
                ;; constructor taken for a function of the global namespace, "this outside a method")
                (expanded-qualifier n)))
        home (if (seq q)
               (let [e (first (filter #(#{:ns :type} (:e %))
                                      ;; (cpp-tpl2, the checker: a qualifier naming a class template's specialization surely without
                                      ;; a definition, select-instance!'s :cx/sure-incomplete -- the class a partial specialization not
                                      ;; deducible declares, template/crash98.C -- is the invalid use of an incomplete type below)
                                      (try (lookup-qualified scope q)
                                           (catch arbace.lang.ExceptionInfo x
                                             (if-let [nm (when (checking?) (:cx/sure-incomplete (ex-data x)))]
                                               (throw (ex-info (str "codegen: invalid use of incomplete type '" nm "'")
                                                               {:codegen/refused :incomplete :cx/node n}))
                                               (throw x))))))]
                 (cond (= :ns (:e e)) (:scope e)
                       ;; (queue 492, the checker: a member defined outside a class the checker knows incomplete, [basic.def]/5
                       ;; with [class.mfct]: `A::~A() {}` after `struct A;`; GCC's "invalid use of incomplete type", reported at
                       ;; the definition and the declaration dropped, declare-node!)
                       (and (checking?) (abi/class? (:ty e)) (cx-incomplete-cls (:ty e)))
                       (throw (ex-info (str "codegen: invalid use of incomplete type '" (:name (abi/cls (:id (abi/unq (:ty e))))) "'")
                                       {:codegen/refused :incomplete :cx/node n}))
                       ;; (queue 497, the checker: [class.mfct]/4 with [dcl.meaning.general]/2.1, a member function or
                       ;; conversion function declared with its class's name before its own, of a complete class (no
                       ;; template's) that declares no member of that name at all (for a conversion function no conversion
                       ;; function): GCC's "no declaration matches", at the declaration)
                       (and (checking?) (abi/class? (:ty e)) (#{"CXXMethodDecl" "CXXConversionDecl"} (:kind n)) (string? (:name n))
                            (let [c (abi/cls-of (:ty e))]
                              (and c (:complete c) (not (:defining c)) (not (:tmpl c)) (not (:targs c)) (not (:lambda c)) (not (:header c))
                                   (if (= "CXXConversionDecl" (:kind n))
                                     (not-any? #(= :conv (:kind (fnd %))) (:methods c))
                                     (empty? (.get ^java.util.HashMap (:names (:scope c)) (:name n)))))))
                       (throw (ex-info (str "codegen: no declaration matches '" (:name n) "' in '" (:name (abi/cls-of (:ty e))) "'")
                                       {:codegen/refused :decl :cx/node n}))
                       (abi/class? (:ty e)) (:scope (abi/cls-of (:ty e))) :else (fail :lookup "qualifier " q)))
               scope)
        ;; (queue 445: a block-scope declaration's home is its innermost enclosing namespace, its types resolved in its block)
        bns (when (and *block-fn* (empty? q)) (loop [s scope] (if (or (nil? (:parent s)) (= :ns (:kind s))) s (recur (:parent s)))))
        home (or bns home)
        cid (:cls home)
        ;; (cpp-s9: a qualified declaration declared in a scope within the qualifier's, a member template's specialization
        ;; made from its out-of-line definition `template<class T> int S::h(T)` in a scope binding T over S's: its types
        ;; resolved there, where the template's parameters are, S's names through it)
        rs (if (or bns (and (seq q) (not (identical? scope home))
                    (loop [s (:parent scope)] (cond (nil? s) false (identical? (:names s) (:names home)) true :else (recur (:parent s))))))
             scope home)
        k (case (:kind n) "CXXConstructorDecl" :ctor "CXXDestructorDecl" :dtor "CXXConversionDecl" :conv (if cid :method :fn))
        qt (get-in n [:type :qualType])
        ;; (a trailing return type's decltype names the parameters: `-> decltype(make_move_iterator(__it.base()))`;
        ;; they are in its scope, [basic.scope.param]; G4)
        tscope (fn-type-scope rs n)
        ty (assoc (binding [*in-signature* (and cid (not (checking?)))] (resolve-type tscope qt)) :cq (method-const? qt))
        ty (dissoc ty :cq)
        nm (:name n)
        body (body-of n)
        pn (param-nodes n)
        ;; cpp-s3: an explicit object parameter (C++23, P0847R7) of reference type to the class: the member function as an
        ;; implicit object one with that ref-qualifier and cv ([over.match.funcs]/4: the same object parameter), the
        ;; parameter's type kept for the mangling (Itanium's H <prefix> <name> E with it first among the parameters);
        ;; explicit-obj-default2.C's defaulted assignments. By value, deduced (this auto&&) or named in a body: refused
        xobj (when (and cid (:isExplicitObjectParameter (first pn)))
               (let [o (first (:ps ty))]
                 (when-not (and (abi/ref? o) (abi/class? (abi/unq (:to o)))
                                (or (= cid (:id (abi/unq (:to o))))
                                    ;; (cpp-decl2, the checker: a reference to another class, a derived one's `this S<T>&&`
                                    ;; ([dcl.fct]/6 allows any type), declared all the same so that its class is complete:
                                    ;; cpp2a/concepts-memfun4.C's B<>, whose using-declarations in S<> had found nothing)
                                    (checking?)))
                   (fail :xobj "an explicit object parameter not a reference to its class"))
                 (when (and (:name (first pn)) body) (fail :xobj "an explicit object parameter named in a body"))
                 o))
        ty (if xobj (update ty :ps (comp vec rest)) ty)
        pn (if xobj (vec (rest pn)) pn)
        ;; (cpp-tpl2, the checker: [class.copy.ctor]/5, a constructor of class X whose only parameter is of type cv X -- a class
        ;; template's specialization's `A(A<T, T>)` for A<int, int> -- is ill-formed: GCC's "invalid constructor", the
        ;; declaration reported and dropped, declare-node!)
        _ (when (and (checking?) (= k :ctor) cid (= 1 (count (:ps ty))) (= {:k :class :id cid} (abi/unq (first (:ps ty)))))
            (throw (ex-info "codegen: invalid constructor: its only parameter of its own class type" {:codegen/refused :decl :cx/node n})))
        f {:name nm :kind k :cls cid :ty ty
           ;; (cpp-sweep, the checker: C++11's [dcl.constexpr]/8, a constexpr non-static member function other than a constructor
           ;; is const, C++14 dropping it: ubsan/vptr-4.C's `t.foo()` of a constexpr object)
           :cq (if xobj (boolean (:c (:to xobj)))
                   (or (method-const? qt)
                       (and (checking?) cid (= k :method) (= 11 (long *cxx-year*)) (:constexpr n) (not (:_consteval n))
                            (not= "static" (:storageClass n)))))
           :refq (if xobj (if (= :rref (:k xobj)) "&&" "&") (when cid (method-refq qt))) :op (when (and nm (not= k :conv)) (fn-op nm))
           ;; (a class's allocation and deallocation functions are static members, [class.free]/1)
           :static (and cid (or (= "static" (:storageClass n)) (contains? #{"operator new" "operator new[]" "operator delete" "operator delete[]"} nm)))
           :virtual (boolean (:virtual n)) :pure (boolean (:pure n))
           :constexpr (boolean (or (:constexpr n) (:_consteval n)))
           :consteval (boolean (:_consteval n))
           ;; GNU's always_inline (clang's AlwaysInlineAttr, `alwaysinline` in the IR: inlined at -O0 by LLVM's
           ;; AlwaysInliner, arbace.cpp.inline; P16 (a))
           ;; (CP362 (a), cpp-s5: a consteval constructor, for the code generator, inlined as always_inline (clang emits no
           ;; immediate function: an immediate invocation is its value), its body not analyzed below)
           :always-inline (or (always-inline-node? n) (and (:_consteval n) (= "CXXConstructorDecl" (:kind n)) (not (checking?))))
           ;; (queue 392: GNU's alias("target"), the function another name of the target's definition, clang's AliasAttr: an
           ;; alias in the module; cow-stdexcept.cc's transactional clones, `_ZGTtNSt11logic_errorC2EPKc` of ...C1EPKc)
           :alias-of (some #(when (and (= "NativeAttr" (:kind %)) (#{"alias" "__alias__"} (:_gnu %)))
                              (not-empty (apply str (map second (re-seq #"\"((?:[^\"\\]|\\.)*)\"" (str (:_arg %)))))))
                           (:inner n))
           ;; G5c: a call of it ends its block (clang's EmitCall: the call, then unreachable), so a catch (...) { abort(); }
           ;; ends no catch on the normal path
           :noreturn (noreturn-node? n)
           ;; GNU's used (G5c: exception_ptr.h's _GLIBCXX_EH_PTR_USED members in eh_ptr.cc): emitted though inline and
           ;; unused, as clang's UsedAttr keeps a definition (CodeGenModule::addUsedGlobal, MustBeEmitted)
           :used (boolean (gnu-attr-arg n "used"))
           ;; __attribute__((constructor(N))): run before main, in llvm.global_ctors at its priority (65535 unwritten)
           :ctor-attr (when-let [x (gnu-attr-arg n "constructor")] (if (number? x) x 65535))
           ;; (the C library's functions that do not return, nothrow builtins for clang, G5c: musl's abort; not free, which
           ;; clang invokes in del_op.cc's noexcept operator delete)
           :noexcept (or (noexcept-of tscope qt) (and (linkage-c? home) (not cid) (or (contains? #{"abort" "exit" "_Exit" "quick_exit"} nm)
                                                                                       (contains? clang-nothrow-libc nm))))
           :noexcept-false (boolean (re-find #"\bnoexcept\s*\(\s*false" (or qt "")))
           ;; queue 351: `throw()`, clang's EST_DynamicNone: before C++17 an exception filter, not noexcept's terminate scope
           :dynamic-none (boolean (and (not (re-find #"\bnoexcept\b" (or qt ""))) (re-find #"\bthrow\s*\(\s*\)" (or qt ""))))
           :linkage (if (linkage-c? home) :c :cpp)
           ;; (cpp-rt-own2: a member function whose type as written names a type of internal linkage is not externally
           ;; visible, clang's getLVForClassMember (UniqueExternalLinkage, emitted internal): memory_resource.cc's
           ;; __pool_resource::_Pool::vector::begin() returning an unnamed namespace's chunk*, linkonce_odr before)
           :internal (boolean (or (and (not cid) (= "static" (:storageClass n))) (:internal home) (and cid (internal-type? ty))))
           :internal-l (boolean (and (not cid) (= "static" (:storageClass n)) (not (:internal home))))
           :inline (boolean (or (:inline n) (:constexpr n) (:_consteval n) (and cid (= scope home) (or body (:explicitlyDefaulted n)))))
           :path (:path home)
           :scope home
           :explicit (explicit-spec scope (node-text n))
           ;; (queue 497, the checker: whether that is the program's value, not the slice's default)
           :explicit-sure (or (not (checking?)) (second (explicit-spec* scope (node-text n))))
           :defaulted (when (:explicitlyDefaulted n) true) :deleted (boolean (:explicitlyDeleted n))
           :pos (long (or (:_b n) 0))
           :src *src*}
        ;; GNU's abi_tag("t", ...) (cpp-s3: <complex>'s real() and imag()): B <source-name> after the name, the tags sorted
        tags (not-empty (vec (sort (distinct (for [a (:inner n) :when (and (= "NativeAttr" (:kind a)) (#{"abi_tag" "__abi_tag__"} (:_gnu a)))
                                                           [_ t] (re-seq #"\"([^\"]*)\"" (str (:_arg a)))]
                                                       t)))))
        f (cond-> f xobj (assoc :xobj xobj) tags (assoc :abi-tags tags))
        ;; (CX12, the checker: a deletion the program wrote, a call of which it diagnoses; a volatile member function)
        f (cond-> f (checking?) (assoc :deleted-sure (boolean (:explicitlyDeleted n)) :vq (method-volatile? (or qt ""))
                                       :access (when cid *member-access*)
                                       ;; (queue 497: GNU's unavailable attribute)
                                       :unavailable (unavailable-node? n)))
        ;; (round 54, the checker: [dcl.fct.def.general]/2, a function definition's return type a class incomplete at its body -- declared,
        ;; not defined there, not one being defined (a member's body is a complete-class context) nor a template's instance; clang's
        ;; err_func_def_incomplete_result)
        inc-ret (when (and (checking?) body (not (:explicitlyDeleted n)))
            (let [r (:ret (:ty f))]
              (when (abi/class? r)
                (let [c (abi/cls (:id r))]
                  (when (and c (not (:tmpl c)) (not (:lambda c)) (not (:defining c)) (not (:complete c)))
                    (*on-refusal* (ex-info (str "codegen: incomplete result type '" (:name c) "' in function definition") {:codegen/refused :incomplete}) n)
                    true)))))
        ;; (cpp-sweep: such a definition's body not analyzed, as GCC leaves it: other/return1.C's `return *wxGetEmptyString();`)
        f (cond-> f inc-ret (assoc :cx-no-body true))
        ;; (queue 484, the checker: and a parameter's type, the same paragraph, other/crash-2.C's `void foo(A a) {}` before A's
        ;; definition; not a function template's specialization, nor a deleted function)
        _ (when (and (checking?) body (not (:explicitlyDeleted n)) (nil? *instantiating*) (not (header-node? n))
                     (not (when cid (let [c (abi/cls cid)] (or (:tmpl c) (:targs c))))))
            (when-let [c (some cx-incomplete-cls (:ps (:ty f)))]
              (*on-refusal* (ex-info (str "codegen: parameter has incomplete type '" (:name c) "'") {:codegen/refused :incomplete}) n)))
        ;; (queue 518, the checker: [dcl.fct]/2, a parameter of type cv void other than a lone unnamed `(void)` without a default
        ;; argument: GCC's "invalid use of type 'void' in parameter declaration", other/main1.C's `int main(void, char**)`,
        ;; parse/operator7.C's `operator+(void, void)`, other/void2.C's `foo(void = 0)`; the type as written, not dependent)
        _ (when (and (checking?) (nil? *instantiating*) (not (header-node? n)))
            (let [pns (vec (param-nodes n))
                  void? (fn [pn] (re-matches #"(?:(?:const|volatile)\s+)*void(?:\s+(?:const|volatile))*" (str/trim (str (get-in pn [:type :qualType])))))]
              (when-let [pn (first (filter #(and (void? %) (or (> (count pns) 1) (:name %) (seq (kids %)))) pns))]
                (*on-refusal* (ex-info "codegen: invalid use of type 'void' in parameter declaration" {:codegen/refused :incomplete}) pn))
              ;; (cpp-decl2: a lone unnamed parameter of cv-qualified void is no empty parameter list, [dcl.fct]/2 names
              ;; void alone: GCC's "invalid use of cv-qualified type 'const void' in parameter declaration", conversion/err-recover1.C)
              (when (and (= 1 (count pns)) (void? (first pns)) (not (:name (first pns))) (empty? (kids (first pns)))
                         (re-find #"\b(?:const|volatile)\b" (str (node-text (first pns)))))
                (*on-refusal* (ex-info "codegen: invalid use of cv-qualified type 'void' in parameter declaration" {:codegen/refused :incomplete :cx/cv-void true}) (first pns)))))
        ;; (the function's type keeps that parameter, as GCC's erroneous one, so a conversion to a pointer to `void ()` fails:
        ;; GCC's "cannot convert")
        f (if (and (checking?) (nil? *instantiating*) (not (header-node? n)) (empty? (:ps (:ty f)))
                   (let [pns (vec (param-nodes n))]
                     (and (= 1 (count pns))
                          (re-matches #"(?:(?:const|volatile)\s+)*void(?:\s+(?:const|volatile))*" (str/trim (str (get-in (first pns) [:type :qualType]))))
                          ;; (a named one too, `A(void x)`, so that it is no default constructor: other/error13.C)
                          (or (:name (first pns)) (seq (kids (first pns)))
                              (re-find #"\b(?:const|volatile)\b" (str (node-text (first pns))))))))
            (assoc-in f [:ty :ps] [(assoc abi/void :c true)])
            f)
        ;; (queue 492, the checker: a non-member function definition's written return and parameter types, their member
        ;; types' access as a namespace-scope variable's, check-type-access!; [class.access]/1-2)
        _ (when (and (checking?) body (nil? cid) (nil? *instantiating*) (not (header-node? n)) (= :ns (:kind scope)) (not (:friend f)))
            (try (check-type-access! scope (get-in n [:type :qualType]) n)
                 (catch arbace.lang.ExceptionInfo x
                   (if (:codegen/refused (ex-data x)) (*on-refusal* x n) (throw x)))))
        old (or (find-redecl home f)
                ;; (cpp-rt-own: a function defined by a qualified name is the one declared before in the namespace it names or in
                ;; one of its inline namespaces, [namespace.memdef]/2 with [namespace.def]/7: filesystem/path.cc's `size_t
                ;; fs::hash_value(const path& p) noexcept` of <experimental/bits/fs_path.h>'s in ...::filesystem::v1::__cxx11,
                ;; mangled at std::experimental::filesystem before; the declaration's path kept)
                (when (and (seq q) (= :ns (:kind home)))
                  (let [seen (java.util.IdentityHashMap.)]
                    (letfn [(inl [s] (some (fn [u] (when (and (.containsKey ^java.util.HashMap (:names u) " inline") (nil? (.put seen (:names u) true)))
                                                     (or (find-redecl u f) (inl u))))
                                           (:usings s)))]
                      (inl home)))))
        ;; (queue 445: a block-scope declaration made before it, kept under its hidden key)
        hidden (when-not old (find-block-redecl home f))
        old (or old hidden)
        _ (when (and old (or bns hidden))
            (enter! (if bns scope home) (if (= k :ctor) " ctor" (if (= k :dtor) " dtor" nm)) {:e :fn :id old :pos (:pos f)}))
        id (or old (next-id))
        pinfo (cond-> {:param-names (mapv :name pn)
                       :defaults (mapv (fn [p] (first (remove #(str/ends-with? (str (:kind %)) "Attr") (kids p)))) pn)}
                ;; (cpp-rt-own4, the code generator: each parameter's top-level const, which the function's type leaves out,
                ;; [dcl.fct]/5, and its variable keeps: analyze-fn!)
                (not (checking?)) (assoc :param-const (mapv #(boolean (:_const %)) pn)))
        ;; (cpp-1123, the checker: a function definition's parameter or return type an abstract class, [class.abstract]/3)
        _ (when (and (checking?) body (not (header-node? n)) (not (:explicitlyDeleted n)))
            (doseq [[pt pnode] (map vector (:ps ty) pn) :when (map? pt)]
              (cx-abstract! pt pnode "parameter"))
            (when-not (#{:ctor :dtor :conv} k) (cx-abstract! (:ret ty) n "return type")))
        ;; (cpp-decl2, the checker: a default argument `{...}` for a reference to an abstract class creates a temporary of
        ;; that type, [dcl.init.list]/3.10 with [class.abstract]/3: GCC's "cannot declare ... to be of abstract type" at the
        ;; declaration, cpp0x/abstract-default1.C; its uses' at the call, call-args)
        _ (when (and (checking?) (not (header-node? n)) (nil? *instantiating*))
            (doseq [[pt pnode d] (map vector (:ps ty) pn (:defaults pinfo))
                    :when (and (map? pt) (abi/ref? pt) (map? d) (= "InitListExpr" (:kind d)))]
              (cx-abstract! (abi/non-ref pt) pnode "a temporary")))]
    (if old
      (do
      ;; (queue 518, the checker: [dcl.fct.def.delete]/4, a deleted definition is the function's first declaration: one after a
      ;; declaration that is not deleted is GCC's "deleted definition of 'X' is not first declaration", cpp0x/deleted11.C's
      ;; `sometype::sometype() = delete;`, cpp0x/deleted10.C's explicit specializations)
      (when (and (checking?) (:explicitlyDeleted n) (not (header-node? n)) (not (:deleted (fnd id))))
        (*on-refusal* (ex-info (str "codegen: deleted definition of '" (:name n) "' is not its first declaration") {:codegen/refused :redecl}) n))
      (upd-fn! id (fn [g] (cond-> (merge g (select-keys pinfo (if body [:param-names :param-const] [])))
                            (some some? (:defaults pinfo)) (assoc :defaults (:defaults pinfo))
                            (:always-inline f) (assoc :always-inline true)
                            (:used f) (assoc :used true)
                            (:noreturn f) (assoc :noreturn true)
                            (:unavailable f) (assoc :unavailable true)
                            ;; an out-of-line `= default` definition (G5c: nested_exception::~nested_exception() noexcept = default
                            ;; in nested_exception.cc): defined here, not inline, the class's key function
                            (and (:defaulted f) (not (header-node? n))) (assoc :defaulted true :out-of-line-default true)
                            ;; (cpp-rt-own2: a header's out-of-line `= default` definition, user-provided and so not trivial,
                            ;; [dcl.fct.def.default]/5, defined where used as an inline function's, linkonce_odr: <experimental/bits/
                            ;; fs_path.h>'s `inline path::path(const path&) = default;`, `inline path::~path() = default;` and its
                            ;; copy assignment, declared alone before, exp/filesystem/ops.cc's calls of them undefined in its IR)
                            (and (:defaulted f) (header-node? n) (not (:defaulted g)))
                            (assoc :defaulted true :ool-defaulted true :trivial false :inline (or (:inline g) (boolean (:inline n))))
                            ;; (CX12, the checker: a deleted function redeclared -- ill-formed, or two overloads the
                            ;; slice's types do not tell apart, noexcept among them -- is not trusted to be deleted)
                            ;; (queue 460: but a plain redeclaration of the same type after the deleted definition keeps it,
                            ;; [dcl.fct.def.delete]/4: the deleted definition is the first declaration, later ones redeclare it)
                            (and (checking?) (or (:deleted g) (:deleted f))
                                 (not (and (:deleted-sure g) (not (:deleted f)) (or (not body) (not (header-node? n)))
                                           (= (:ty g) (:ty f)) (= (:cq g) (:cq f)) (= (:refq g) (:refq f)))))
                            (assoc :deleted-sure false)
                            ;; (cpp-def2, the checker: a definition of a function whose first declaration is its deleted
                            ;; definition, [dcl.fct.def.delete]/4 with [basic.def.odr]/1, is a redefinition: GCC's error there, the
                            ;; function staying deleted, its body not taken, so that a call of it is "use of deleted function";
                            ;; cpp0x/defaulted10.C)
                            (and body (not (and (checking?) (:deleted-sure g) (not (:deleted f)) (not (header-node? n)) (= (:ty g) (:ty f))
                                                (= (:cq g) (:cq f)) (= (:refq g) (:refq f)))))
                            (assoc :body body :node n :def-scope scope :inits (filter #(= "CXXCtorInitializer" (:kind %)) (kids n))
                                        :inline (or (:inline g) (boolean (:inline n))))
                            ;; a header's definition: analyzed when used (G4), as clang emits an inline function
                            (and body (lazy-header-node? n) (not (or (:used f) (:used g)))) (assoc :lazy true)))))
      (do (swap! *fns* assoc id (merge f pinfo {:id id :node n :def-scope scope}
                                      (when body {:body body :inits (filter #(= "CXXCtorInitializer" (:kind %)) (kids n))})
                                      (when (and (or body (:explicitlyDefaulted n)) (lazy-header-node? n) (not (:used f))) {:lazy true})))
          ;; (queue 367-2 (a): a specialization whose type another specialization of its template already has is reached
          ;; through its template alone, not entered by name: two entries of one type would make every call naming it
          ;; ambiguous, basic_string's _M_construct<true>(__s, __n) once _M_construct<false> is its own function)
          (when-not (and *instantiating*
                         (some (fn [e] (when (= :fn (:e e))
                                         (let [g (fnd (:id e))]
                                           (and (same-sig? g f) (= (:tid *instantiating*) (:tid (:tinst g)))))))
                               (.get ^java.util.HashMap (:names home) (if (= k :ctor) " ctor" (if (= k :dtor) " dtor" nm)))))
            (enter! (if bns scope home) (if (= k :ctor) " ctor" (if (= k :dtor) " dtor" nm)) {:e :fn :id id :pos (:pos f)}))
          (when (and cid (= k :method)) (cx-udecl-hide! home f n))
          (when bns (enter! home (block-fn-key nm) {:e :fn :id id :pos (:pos f)}))
          (when (= k :ctor) (abi/update-cls! cid update :ctors (fnil conj []) id))
          (when (= k :dtor) (abi/update-cls! cid assoc :dtor id))
          (when (and cid (:virtual f)) (abi/update-cls! cid update :virtuals (fnil conj []) id))
          (when cid (abi/update-cls! cid update :methods (fnil conj []) id))
          (swap! *order* conj [:fn id])
          ;; a defaulted <=> declares a defaulted == alongside it ([class.compare.default]/5)
          (when (and cid (:explicitlyDefaulted n) (= "operator<=>" nm)
                     (not (some #(= :fn (:e %)) (.get ^java.util.HashMap (:names home) "operator=="))))
            (declare-fn! scope (assoc n :name "operator==" :type {:qualType (str/replace (str qt) #"^\s*auto\b" "bool")})))))
    (when defer (upd-fn! id assoc :trailing-defer [rps rc]))
    ;; (cpp-rt-own3, DECISION cpp-rt-own2-2 (a): a templated member function's trailing requires-clause mangled after its
    ;; parameters, as clang 23 does, its types resolved in its class's constraint scope: :tq; a function template's is its
    ;; instantiation's, arbace.cpp.template/instantiate-fn)
    (when (and rc id (nil? *instantiating*) (not (checking?)) (:cls scope))
      (when-let [q ((requiring-resolve 'arbace.cpp.template/member-tq) scope rc)] (upd-fn! id assoc :tq q)))
    id)))))

(declare ctad-var)

(defn- cx-incomplete-cls
  "Queue 484: the class `t` names (cv-qualified) when the checker knows it incomplete here: declared, not defined yet,
  not being defined, not a class template's specialization, a lambda's nor a header's; else nil."
  [t]
  (let [u (when (map? t) (abi/unq t))]
    (when (abi/class? u)
      (let [c (abi/cls (:id u))]
        (when (and c (not (:complete c)) (not (:defining c)) (not (:tmpl c)) (not (:targs c)) (not (:lambda c)) (not (:header c)))
          c)))))

(defn- cx-subscript-incomplete!
  "Queue 499 (the checker): a subscript E1[E2] whose pointer operand `p` (typed) points to a class the checker knows
  incomplete ([expr.sub]/2 with [expr.add]/1: the pointer arithmetic needs a completely-defined object type): GCC's
  \"invalid use of incomplete type\", parse/crash49.C."
  [p]
  (when (checking?)
    (when-let [c (and (abi/ptr? (:ty p)) (cx-incomplete-cls (:to (:ty p))))]
      (fail :incomplete "invalid use of incomplete type '" (:name c) "'"))))

;; (cpp-1123, the checker: [class.abstract]/2-3. A class is abstract when it has a pure virtual function that no final
;; overrider replaces: one of its own or of a base that neither it nor a class between them declares again with the same
;; name, parameter-type-list, cv- and ref-qualifiers ([class.virtual]/2), a pure destructor only its own class's. While a
;; class is being defined only its own pure functions decide (an overrider may follow). An object of an abstract class
;; cannot be created: a variable's definition, a non-static data member, a function definition's parameter or return
;; type, a thrown object (GCC's "cannot declare variable 'a' to be of abstract type 'A'", "invalid abstract parameter
;; type", "invalid abstract return type", reported where declared, the analysis going on); other/abstract2.C,
;; other/abstract8.C, cpp0x/ref-qual8.C)
(defn- cx-pure-overridden?
  "Whether the pure function `p` of the class `k` is overridden in the class `cid` or a class between them."
  [p k cid]
  (let [sig (fn [f] [(:name f) (mapv abi/unq (:ps (:ty f))) (boolean (:cq f)) (:refq f)])
        ps (sig p)
        between (fn between [c] ;; c and its bases derived from k (k excluded)
                  (when (and c (not= c k) (or (= c cid) (abi/derived-from? c k)))
                    (cons c (mapcat (fn [b] (between (:cls b))) (:bases (abi/cls c))))))]
    (some (fn [c] (some (fn [m] (let [g (fnd m)] (and g (not (:pure g)) (= ps (sig g))))) (:methods (abi/cls c))))
          (distinct (between cid)))))

(defn- cx-abstract-class
  "The name of a pure virtual function that makes the class `cid` abstract, or nil (not abstract, or not sure)."
  [cid]
  (let [c (abi/cls cid)]
    (when (and c (not (:lambda c)) (not (:union c)))
      (or (when-let [d (some-> (:dtor c) fnd)] (when (:pure d) (str "~" (:name c))))
          (some (fn [m] (let [f (fnd m)] (when (and f (:pure f)) (:name f)))) (:methods c))
          (when-not (:defining c)
            (let [all (fn all [k] (cons k (mapcat (fn [b] (all (:cls b))) (:bases (abi/cls k)))))]
              (some (fn [k] (some (fn [m] (let [f (fnd m)]
                                            (when (and f (:pure f) (not= :dtor (:kind f)) (not (cx-pure-overridden? f k cid))) (:name f))))
                                  (:methods (abi/cls k))))
                    (rest (distinct (all cid))))))))))

(defn- cx-abstract-type
  "The abstract class's name when the type `t` (an array of it too) is an abstract class type, else nil."
  [t]
  (let [u (loop [u t k 0] (if (and (map? u) (abi/arr? u) (< k 8)) (recur (:of u) (inc k)) u))]
    (when (and (map? u) (abi/class? (abi/unq u)) (cx-abstract-class (:id (abi/unq u))))
      (:name (abi/cls (:id (abi/unq u)))))))

(defn- cx-abstract!
  "Reports, the analysis going on, the creation of an object of the abstract type `t` at the node `n` (`what` its kind)."
  [t n ^String what]
  (when (and (checking?) *on-refusal* n (not (header-node? n)))
    (when-let [cn (cx-abstract-type t)]
      (*on-refusal* (ex-info (str "codegen: cannot declare " what " to be of abstract type '" cn "'") {:codegen/refused :abstract :cx/node n}) n))))

(defn- incomplete-var!
  "Round 54, the checker: [basic.def]/5, [dcl.init.general]/7: a variable's definition `n` of a class type `ty` incomplete at that
  point (declared and not yet or never defined, or still being defined; not an extern declaration nor a class template's instance):
  clang's err_typecheck_decl_incomplete_type, reported at the declaration, the analysis going on, as a field's is."
  [n ty]
  ;; (cpp-1123: a variable of an abstract class type, or an array of it, [class.abstract]/3)
  (when (and (checking?) (not= "extern" (:storageClass n)) (not (:extern n)))
    (cx-abstract! ty n (str "variable '" (:name n) "'")))
  (when (and (checking?) (not= "extern" (:storageClass n)) (not (:extern n)) (abi/class? ty))
    (let [c (abi/cls (:id ty))]
      ;; (queue 497: a variable of a class declared with GNU's unavailable attribute, GCC's "'Foo' is unavailable")
      ;; (named by the class's own name: a typedef's name is no use of it to GCC, ext/attr-unavailable-8.C)
      (when (and c (:unavailable c) (not (:tmpl c))
                 (re-find (re-pattern (str "(?<![A-Za-z0-9_])" (java.util.regex.Pattern/quote (str (:name c))) "(?![A-Za-z0-9_])"))
                          (str (get-in n [:type :qualType]))))
        (*on-refusal* (ex-info (str "codegen: '" (:name c) "' is unavailable") {:codegen/refused :unavailable}) n))
      (when (and c (not (:tmpl c)) (not (:lambda c)) (or (:defining c) (not (:complete c))))
        (*on-refusal* (ex-info (str "codegen: variable has incomplete type '" (:name c) "'") {:codegen/refused :incomplete}) n)))))

(defn- cx-void-var!
  "Queue 518 (the checker): [basic.types.general]/5 with [dcl.type.general]: a variable of type cv void (an extern declaration
  too, CWG2475; a class template's static member or a function template's local once substituted): GCC's \"variable or field
  declared void\", DRs/dr2475.C, template/static9.C, cpp0x/pr78649.C."
  [n ty]
  (when (and (checking?) (map? ty) (abi/void? (abi/unq ty)) (not (header-node? n)))
    ;; (reported at its name, as GCC's: `extern void g(),\n y;`)
    (*on-refusal* (ex-info (str "codegen: variable or field '" (:name n) "' declared void") {:codegen/refused :incomplete})
                  (if (get-in n [:loc :offset]) (assoc-in n [:range :begin] (merge (get-in n [:range :begin]) (:loc n))) n))))

(defn- cx-sure-incomplete-refusal
  "Queue 500 (the checker; 497-2 (a)): [basic.def]/5, [dcl.init.general]/7 for a class template's specialization: the refusal
  to report for the variable definition `n` whose type, as written, is the specialization itself (a template-id, no declarator
  operator after it) that the templates found surely without a definition here (`e` thrown by its instantiation with
  :cx/sure-incomplete, or `ty` an instance marked :cx-sure-incomplete and not complete); GCC's \"aggregate ... has incomplete
  type and cannot be defined\", reported at the declaration as clang's err_typecheck_decl_incomplete_type. Nil otherwise."
  [n ty e]
  (let [qt (str (get-in n [:type :qualType]))
        c (when (and (map? ty) (abi/class? ty)) (abi/cls (:id ty)))
        tn (or (:cx/sure-incomplete (ex-data e)) (when (and c (:cx-sure-incomplete c) (not (:complete c))) (:name c)))]
    (when (and tn (checking?) (= "VarDecl" (:kind n)) (not= "extern" (:storageClass n)) (not (:extern n))
               (re-find #">\s*$" qt)
               ;; (an enumeration's underlying type without a fixed one is implementation-defined, [dcl.enum]/7: the slice's
               ;; answer may not be GCC's, cpp0x/enum37.C's same<unsigned int, __underlying_type(E)>)
               (not (re-find #"underlying_type" qt))
               (re-find (re-pattern (str "(?<![A-Za-z0-9_])" (java.util.regex.Pattern/quote (str tn)) "\\s*<")) qt))
      (ex-info (str "codegen: variable has incomplete type '" qt "'") {:codegen/refused :incomplete}))))

(declare str-units)

(defn- cx-incomplete-base!
  "cpp-tpl2 (the checker): [class.derived.general]/2, a base-specifier's class that is incomplete or still being defined (a
  class only declared, a class template's specialization without a definition): GCC's \"invalid use of incomplete type\",
  reported at the base-specifier `bs`, true (the base dropped, as GCC goes on without it). Not judged in a header, for a
  header's class, nor for one a template's instance waits to complete."
  [bt bs n id]
  (when (and (checking?) *on-refusal* (map? bt) (abi/class? bt) (not (header-node? n)))
    (let [c (abi/cls (:id bt))]
      ;; (a closure type is complete once its lambda-expression is analyzed: not judged, cpp0x/lambda/lambda-field-names.C,
      ;; cpp1z/decomp62.C; nor an unnamed class)
      (when (and c (not (:header c)) (not (:lazy-inst c)) (not (:lambda c)) (seq (str (:name c)))
                 (or (not (:complete c)) (= (:id bt) id))
                 (or (not (:tmpl c)) (:cx-sure-incomplete c)))
        (*on-refusal* (ex-info (str "codegen: invalid use of incomplete type '" (:name c) "'")
                               {:codegen/refused :incomplete :cx/node (if (:range bs) bs n)})
                      n)
        true))))

(defn- declare-var!
  [scope n storage]
  (let [qt (get-in n [:type :qualType])
        ;; (queue 367, the code generator: a qualifier naming a template-id, as declare-fn!'s, cpp-s13: limits.cc's out-of-line
        ;; definitions `constexpr bool numeric_limits<bool>::is_specialized;` of an explicit specialization's static members)
        q (or (qualifier-before n) (when-not (checking?) (qualifier-tid-before n))
              ;; (queue 411: a definition a macro writes, its qualifier from the parser's tokens after expansion: limits.cc's
              ;; INT_N(__GLIBCXX_TYPE_INT_N_0), numeric_limits<__int128>'s static members)
              (expanded-qualifier n))
        ;; (CP311 (a): a deduced class type, deduced from the initializer analyzed as global-init would)
        ct (when (empty? q) (ctad-template scope (or (:_ctad n) qt)))
        cv (when ct (binding [*cutoff* Long/MAX_VALUE]
                      (ctad-var (cond-> {:scope scope :statics (atom [])} (and (checking?) (= :ns (:kind scope))) (assoc :cx-global true)) n ct qt)))
        cv (or cv (when (empty? q) (ctad-compound-var scope n qt)))
        home (if (seq q)
               (let [e (first (filter #(#{:ns :type} (:e %)) (lookup-qualified scope q)))]
                 (cond (= :ns (:e e)) (:scope e) (abi/class? (:ty e)) (:scope (abi/cls-of (:ty e))) :else (fail :lookup "qualifier " q)))
               scope)
        ;; (queue 380, W3d: a qualified declarator's type in its class's or namespace's scope, [basic.lookup.unqual]/9 with
        ;; [dcl.meaning]: pool_allocator.cc's `__pool_alloc_base::_Obj* volatile __pool_alloc_base::_S_free_list[_S_free_list_size]`,
        ;; the bound the class's enumerator; the home scope's parents are the namespace's)
        ty (if cv (:ty cv) (resolve-type (if (and (seq q) (not (identical? scope home))
                                                  (not (loop [s (:parent scope)] (cond (nil? s) false (identical? (:names s) (:names home)) true :else (recur (:parent s))))))
                                           home scope)
                                         qt))
        ;; (cpp-s11: an array of unknown bound of scalars completed by its braced initializer's count at its declaration,
        ;; [dcl.array]/7, as a local's is at its initialization: <bits/unicode-data.h>'s `inline constexpr char32_t
        ;; __width_edges[] = {...}` given to std::end(T (&)[N]), whose N had been nil)
        ty (let [i (init-kid n)]
             (cond
               (and (abi/arr? ty) (nil? (:n ty)) (abi/scalar? (abi/unq (:of ty))) (= "InitListExpr" (:kind i)))
               (do ;; (round 54, the checker: [dcl.init.aggr]/9: an array of unknown bound initialized by an empty list has no element,
                   ;; [dcl.array]/1's bound greater than zero: GCC's "zero-size array")
                   ;; (queue 365: GCC's extension, accepted silently unless -pedantic, -Wpedantic or -pedantic-errors: g++ 15.2 gives
                   ;; `int a[] = {};` no diagnostic at -std=gnu++20 or -std=c++20 alone)
                   (when (and (checking?) *pedantic* (empty? (kids i)))
                     (*on-refusal* (ex-info "codegen: zero-size array" {:codegen/refused :array}) n))
                   (assoc ty :n (count (kids i))))
               ;; (n-cpp-eval: of GNU vectors, each element its own braced list: g++.dg's torture/vshuf-*.inc `constexpr V in1[] =
               ;; { {...}, ... }`, whose sizeof had been 0; a vector's lanes with their braces elided refused)
               (and (abi/arr? ty) (nil? (:n ty)) (= :vec (:k (abi/unq (:of ty)))) (= "InitListExpr" (:kind i)))
               (if (every? #(= "InitListExpr" (:kind %)) (kids i))
                 (assoc ty :n (count (kids i)))
                 (fail :init "an array of unknown bound of vectors with their braces elided"))
               ;; (queue 380: of a class, each element its own braced list: <text_encoding>'s `static inline constexpr _Rep
               ;; _S_reps[] = { {...}, ... }` given to std::end(T (&)[N]); with braces elided the count is not the bound: left)
               (and (abi/arr? ty) (nil? (:n ty)) (abi/class? (abi/unq (:of ty))) (= "InitListExpr" (:kind i))
                    (seq (kids i)) (every? #(= "InitListExpr" (:kind %)) (kids i)))
               (assoc ty :n (count (kids i)))
               ;; (cpp-tzdb: of characters, by a string literal, alone or in braces, [dcl.init.string]/1-2 and [dcl.array]/7:
               ;; tzdb.cc's `static const char tzdata_chars[] = R"__libstdcxx__(...)__libstdcxx__";` given to std::size(const
               ;; T (&)[N]), whose N had been nil, the deduction's crash)
               (and (abi/arr? ty) (nil? (:n ty)) (abi/integral? (abi/unq (:of ty))) i
                    (let [s (if (= "InitListExpr" (:kind i)) (when (= 1 (count (kids i))) (first (kids i))) i)]
                      (= "StringLiteral" (:kind s))))
               (let [s (if (= "InitListExpr" (:kind i)) (first (kids i)) i)
                     a (analyze {:scope scope :statics (atom [])} s)]
                 (if (= :str (:op a)) (assoc ty :n (inc (count (str-units a)))) ty))
               :else ty))
        ^java.util.HashMap m (:names home)
        old (some #(when (= :var (:e %)) (:id %)) (.get m (:name n)))
        init (init-kid n)
        st (if (:cls home) :member-static storage)
        ;; (round 54, the checker: [basic.def]/5, [dcl.init.general]/7: a variable's definition of a class type incomplete at that point,
        ;; one declared and not yet or never defined or still being defined -- not a static data member's declaration in its class, nor
        ;; an extern declaration, nor a class template's instance; clang's err_typecheck_decl_incomplete_type)
        _ (when (and (not= st :member-static) (empty? q)) (incomplete-var! n ty))
        ;; (cpp-decl2, the checker: an inline static data member's declaration in its class is its definition, [class.static.data]/4,
        ;; so its type is complete there, [basic.def]/5: GCC's "'B V::var22' has incomplete type", a class template's instance's
        ;; too; cpp1z/inline-var2.C)
        _ (when (and (checking?) (= st :member-static) (empty? q) (:inline n) (not (header-node? n)))
            (when-let [c (cx-incomplete-cls ty)]
              (*on-refusal* (ex-info (str "codegen: '" (:name n) "' has incomplete type") {:codegen/refused :incomplete}) n)))
        _ (cx-void-var! n ty)
        ;; (queue 500: a specialization surely without a definition)
        _ (when (and (not= st :member-static) (empty? q))
            (when-let [r (cx-sure-incomplete-refusal n ty nil)] (*on-refusal* r n)))]
    (if (and old (seq q))
      ;; a qualified definition of a namespace member declared `extern` (libsupc++'s `const nothrow_t std::nothrow = ...`,
      ;; `terminate_handler __cxxabiv1::__terminate_handler = ...`): the definition, no longer extern ([basic.def]/2)
      ;; (cpp-s12: a redeclaration without an initializer keeps the in-class one, `constexpr int A::n;` of a constexpr
      ;; static data member, [class.static.data]/4, deprecated since C++17, [depr.static.constexpr]; it had been zero)
      (do ;; (queue 484, the checker: [basic.link]/11, the definition's type another than the declaration's, `static float x;`
          ;; then `double A::x = ...;`, torture/pr70621.C; both known whole, their top-level cv-qualifiers left out)
          (when (and (checking?) (not (header-node? n)))
            (let [ok (cx-type-key (abi/unq (:ty (var* old)))) nk (cx-type-key (abi/unq ty))]
              (when (and ok nk (not= ok nk))
                (*on-refusal* (ex-info (str "codegen: conflicting declaration of '" (:name n) "'") {:codegen/refused :redecl}) n))))
          (when (and init (checking?) (or (:cx-constexpr (var* old)) (:cx-constinit (var* old)) (:constexpr n) (:_constinit n)))
            ;; (h-cpp-consteval, the checker: the initializer's errors at the definition)
            (upd-var! old assoc :cx-range (:range n)
                      :cx-constinit (boolean (or (:cx-constinit (var* old)) (and (not (:constexpr n)) (:_constinit n))))))
          (if init
            ;; (cpp-rt-own: a static data member's initializer is in its class's scope, [class.static.data]/3 (C++23
            ;; [class.static.data]/2): locale_facets.cc's `const money_base::pattern money_base::_S_default_pattern = { {symbol,
            ;; sign, none, value} };`, its enumerators money_base's, "conversion from an overload set" before)
            (upd-var! old assoc :init init :init-style (:init n) :defined true :extern false :def-scope (if (and (:cls home) (not (identical? scope home)) (not= :tparams (:kind scope))
                                                                                                     (not (loop [s (:parent scope)] (cond (nil? s) false (identical? (:names s) (:names home)) true :else (recur (:parent s))))))
                                                                                              home scope))
            (do (upd-var! old assoc :defined true :extern false)
                ;; (cpp-rt-own2, the code generator: since C++17 the redundant out-of-line definition of an inline (constexpr)
                ;; static data member, [depr.static.constexpr], is a definition clang writes whether used or not, weak_odr
                ;; (GVA_StrongODR), as an explicit instantiation's: exp/filesystem/path.cc's `constexpr path::value_type
                ;; path::preferred_separator [[gnu::used]];`, dropped as unused before)
                (when (and (not (checking?)) (not (header-node? n)) (>= (long *cxx-year*) 17)
                           (= :member-static (:storage (var* old))) (:linkonce (var* old)) (not (:internal (var* old))))
                  (upd-var! old assoc :explicit-inst true))))
          ;; (cpp-rt-own: and among the definitions emit-globals writes, a static data member of a template's instance not
          ;; there before: locale_facets.cc's `template<> const char* __timepunct_cache<char>::_S_timezones[14] = {...};`)
          (when (and init (not (some #{[:var old]} @*order*))) (swap! *order* conj [:var old]))
          ;; (cpp-s7: a static data member's out-of-line definition in a header is an ordinary definition, not linkonce:
          ;; before CP369 every such member was internal and so never linkonce here; now external, thread_local11.h's
          ;; `thread_local S T::u3` would have been taken for a template's member, thread_local12e.C refused)
          (when (header-node? n) (upd-var! old #(cond-> (assoc % :defined false :pending-def true)
                                                  (not (or (:internal %) (= :member-static (:storage %)))) (assoc :linkonce true))))
          old)
      (let [id (next-id)
            ;; (queue 380, W3d: an array of const elements is a const object, [basic.type.qualifier]/3, internal at namespace
            ;; scope, [basic.link]/3.2: c_locale.cc's `const char* const category_names[...]` had been an external global)
            cq (loop [t ty] (cond (:c t) true (abi/arr? t) (recur (:of t)) :else false))
            v {:id id :name (:name n) :ty ty :storage st :init init :init-style (:init n) :path (:path home)
               :unavailable (and (checking?) (unavailable-node? n))
               :linkage (if (linkage-c? home) :c :cpp)
               ;; (queue 351: `extern` with an initializer is a definition, [basic.def]/2: hashtable-aux.cc's `extern const
               ;; unsigned long __prime_list[] = {...}`, external though const, [basic.link]/3)
               :defined (not (or (= st :member-static) (and (= "extern" (:storageClass n)) (not init))))
               :extern (and (= "extern" (:storageClass n)) (not init))
               ;; (cpp-rt-own3: an inline const variable is not internal, [basic.link]/3.2: <ranges>' customization point objects,
               ;; `inline constexpr __access::_Data data{};`, linkonce_odr as clang writes them, print.cc's _ZNSt6ranges4_Cpo4dataE)
               :internal-l (boolean (and (= st :global) (not (:cls home)) (or (= "static" (:storageClass n)) (and cq (not (:extern n)) (not= "extern" (:storageClass n)) (not (:inline n)))) (not (:internal home))))
               ;; (CP369 (a): `static` on a static data member is not its linkage, [basic.link]/4: internal only by an unnamed
               ;; namespace on its class's path, its home's; clang's dso_local external global for `int A::y = f();`)
               :internal (boolean (or (:internal home) (and (not= st :member-static) (= "static" (:storageClass n)))
                                      (and (= st :global) cq (not= "extern" (:storageClass n)) (not (:inline n)))))
               :def-scope scope
               :ctad-init (:ctad-init cv) :ctad-error (:ctad-error cv)
               :init-priority (let [x (gnu-attr-arg n "init_priority")] (when (number? x) x))
               ;; thread_local, _Thread_local, __thread ([basic.stc.thread]; G5c: libsupc++'s eh_globals.cc)
               :tls (boolean (:tls n))
               ;; (cpp-s5b, pending review 1111 #4: the TLS kind, clang's VarDecl::getTLSKind: "dynamic" for C++'s
               ;; thread_local, "static" for __thread and _Thread_local; with constinit, [dcl.constinit], a thread-local
               ;; variable clang reads directly, never through its wrapper)
               :tls-kind (:tls n)
               :constinit (boolean (or (:_constinit n) (some #(= "ConstInitAttr" (:kind %)) (:inner n))))
               :pos (long (or (:_b n) 0))}
            ;; (CX12, the checker: a constexpr variable, its initializer checked as a constant expression)
            v (cond-> v (and (checking?) (:constexpr n)) (assoc :cx-constexpr true :cx-range (:range n)))
            ;; (cpp-rt-own4, the code generator: a constexpr variable of namespace or class scope marked for the evaluator alone,
            ;; ce-lv's read of a constexpr class object)
            v (cond-> v (and (not (checking?)) (:constexpr n)) (assoc :cg-constexpr true))
            ;; (h-cpp-consteval, the checker: a constinit variable's initializer a constant expression too, [dcl.constinit]/2)
            v (cond-> v (and (checking?) (not (:constexpr n)) (:constinit v)) (assoc :cx-constinit true :cx-range (:range n)
                                                                                     ;; (cpp-singles: its initializer's place, cx-sure-error!)
                                                                                     :cx-init-range (:range (init-kid n))))
            ;; (queue 463, the checker: a static data member's access, [class.access]/1, judged where it is named)
            v (cond-> v (and (checking?) (:cls home)) (assoc :cx-cls (:cls home))
                    (and (checking?) (:cls home) (#{:private :protected} *member-access*)) (assoc :cx-access *member-access*))
            ;; (CX12, the checker: the type's member names' access, an unqualified declarator at namespace scope)
            v (cond-> v (and (checking?) (empty? q) (= :ns (:kind home)) (not (header-node? n)))
                (assoc :cx-type-text (get-in n [:type :qualType]) :cx-decl (cond-> {:range (:range n)} (:loc n) (assoc :loc (:loc n)))))]
        ;; a header's definition: defined when odr-used (G4: clang emits an unused inline variable not at all)
        (swap! *vars* assoc id (cond
                                 ;; (cpp-rt-own3: and an inline variable anywhere, [dcl.inline]/6, defined when odr-used, linkonce_odr)
                                 (and (or (header-node? n) (and (:inline n) (not (checking?)))) (:defined v) (= st :global))
                                 (cond-> (assoc v :defined false :pending-def true) (not (:internal v)) (assoc :linkonce true))
                                 ;; (cpp-s7: an inline static data member, its in-class declaration a definition ([class.static.data]/4,
                                 ;; [dcl.inline]/6): defined when used, linkonce_odr as clang emits an inline variable; member_kinds.C's
                                 ;; `static inline int i = f();` had no definition, lower's "unknown global _ZN1A1iE")
                                 ;; (cpp-s12: a constexpr static data member is implicitly inline since C++17, [dcl.constexpr]/1,
                                 ;; [depr.static.constexpr]: <charconv>'s __from_chars_alnum_to_val_table<false>::value, library.cpp's
                                 ;; "unknown global")
                                 (and (= st :member-static) (empty? q) (or (:inline n) (and (:constexpr n) (>= (long *cxx-year*) 17))) (init-kid n))
                                 (assoc v :pending-def true :linkonce true :internal-l false)
                                 :else v))
        (when (and (:name n) (= (:name n) (System/getenv "CPP_LOOKUP_TRACE"))) (binding [*out* *err*] (println "declare" (:name n) (:path home) (System/identityHashCode (:names home)) (:pos v))))
        ;; (cpp-rt-own: a redeclaration of a namespace-scope variable declared `extern` before keeps its linkage and language
        ;; linkage, [basic.link]/? and [dcl.link]/6: libcpp's init.cc `constexpr _cpp_trigraph_map_s _cpp_trigraph_map_d;` of
        ;; internal.h's `extern const struct _cpp_trigraph_map_s { ... } _cpp_trigraph_map_d;` in an extern "C" block, clang's
        ;; @_cpp_trigraph_map_d; an internal _ZL19_cpp_trigraph_map_d before)
        (when-let [pv (when (and old (= st :global) (not (:cls home))) (var* old))]
          (when (and (:extern pv) (not (:internal pv)) (not (:internal-l pv)))
            (swap! *vars* update id assoc :linkage (:linkage pv) :internal false :internal-l false)))
        (enter! home (:name n) {:e :var :id id :pos (:pos v)})
        (when (:cls home) (abi/update-cls! (:cls home) update :statics (fnil conj []) id))
        (swap! *order* conj [:var id])
        id))))

(declare declare-enum!*)

(defn- declare-enum!
  "An enumeration's declaration; the checker leaves out (cpp-decl2) a qualified opaque-enum-declaration and a definition by a
  qualified name in a scope that does not enclose its enumeration ([dcl.enum]/2, /4: diag's enum-redecls reports them)."
  [scope n]
  (if (and (checking?) (seq (:_equal n))
           (let [has-body (or (:_body n) (some #(= "EnumConstantDecl" (:kind %)) (kids n)))]
             (or (not has-body)
                 (let [e (try (first (lookup-qualified scope (vec (:_equal n)))) (catch arbace.lang.ExceptionInfo _ nil))
                       target (cond (= :ns (:e e)) (:scope e)
                                    (= :type (:e e)) (when-let [cid (try (class-id (:ty e)) (catch arbace.lang.ExceptionInfo _ nil))] (:scope (abi/cls cid)))
                                    :else nil)]
                   (and target (not (loop [s target] (cond (nil? s) false (identical? (:names s) (:names scope)) true :else (recur (:parent s))))))))))
    nil
    (declare-enum!* scope n)))

(defn- declare-enum!* [scope n]
  (let [;; (queue 492, the checker: an enumeration defined by a qualified name is the named class's or namespace's member,
        ;; its enumerators too, [dcl.enum]/1, [class.mem]: `enum A::B : int { x };` then A::x)
        scope (or (when-let [q (and (checking?) (seq (:_equal n)))]
                    (let [e (try (first (lookup-qualified scope (vec q))) (catch arbace.lang.ExceptionInfo _ nil))]
                      (cond (= :ns (:e e)) (:scope e)
                            (= :type (:e e)) (when-let [cid (try (class-id (:ty e)) (catch arbace.lang.ExceptionInfo _ nil))] (:scope (abi/cls cid)))
                            :else nil)))
                  scope)
        nm (:name n)
        ;; (cpp-decl2, the checker: a redeclaration of an enumeration declared in the same scope, `enum class E : int;` then its
        ;; definition, declares the same entity, [dcl.enum]/3 (C++23 [dcl.enum]/4): its id kept, so its name finds one type, not
        ;; two ("reference to 'E6' is ambiguous" before: cpp0x/forw_enum6.C)
        old-id (when (and (checking?) nm)
                 (some #(when (and (= :type (:e %)) (= :enum (:k (:ty %)))
                                   (= (:path (abi/enm (:id (:ty %)))) (:path scope)))
                          (:id (:ty %)))
                       (.get ^java.util.HashMap (:names scope) nm)))
        id (or old-id (next-id))
        scoped (boolean (:scopedEnumTag n))
        under (if-let [ft (get-in n [:fixedUnderlyingType :qualType])] (resolve-type scope ft) abi/int*)
        ;; (cpp-indep, the checker: [dcl.enum]/2, an enum-base names an integral type, a typedef's too: GCC's "underlying type
        ;; 'float' of 'E6' must be an integral type", at the enumeration; cpp0x/enum_base.C; then int, as GCC goes on)
        under (if (and (checking?) (get-in n [:fixedUnderlyingType :qualType]) (map? under) (not (header-node? n))
                       (let [u (abi/unq under)] (and (#{:b :ptr :class :mptr} (:k u)) (not (abi/integral? u)))))
                (do (*on-refusal* (ex-info (str "codegen: underlying type of '" (or (:name n) "<unnamed>") "' must be an integral type")
                                           {:codegen/refused :enum})
                                  n)
                    abi/int*)
                under)
        es (or (when old-id (:scope (abi/enm old-id))) (new-scope :enum scope :path (conj (:path scope) [:enum id])))
        t {:k :enum :id id}
        ;; (queue 492, the checker: a member enumeration's access, its own or an earlier declaration's in the class: an opaque
        ;; `enum D : int;` under private:, defined by `enum C::D : int { y };` at namespace scope)
        eacc (when (and (checking?) (= :class (:kind scope)) (:cls scope))
               (or *member-access* (when nm (some #(when (= :type (:e %)) (:access %)) (.get ^java.util.HashMap (:names scope) nm)))))]
    (when-not nm (reset! *last-anon* t))
    ;; (cpp-def2, the checker: an enumeration's definition seen, its enumerator list; an opaque-enum-declaration alone declares
    ;; none, [dcl.enum]/3, name-expr's qualified lookup below)
    (when (and (checking?) old-id (:_body n)) (swap! abi/*enums* assoc-in [old-id :body] true))
    (when-not old-id (swap! abi/*enums* assoc id (cond-> {:id id :name nm :path (:path scope) :under under :scope es :scoped scoped}
                                                  (and (checking?) (:_body n)) (assoc :body true)
                                                  ;; (cpp-rind: a fixed underlying type, [conv.prom]/4's and DR 1601's)
                                                  (get-in n [:fixedUnderlyingType :qualType]) (assoc :fixed true))))
    (when (and nm (not old-id)) (enter! scope nm (cond-> {:e :type :ty t :pos (long (or (:_b n) 0))}
                                ;; (queue 492, the checker: a member enumeration's access, check-type-access!)
                                (and (checking?) (= :class (:kind scope)) *member-access*) (assoc :access *member-access*))))
    ;; (cpp-s4: an enumerator's initializer sees the earlier enumerators, of the underlying type before the closing brace,
    ;; [dcl.enum]/5 and [basic.scope.enum]: a scoped enumeration's too, <charconv>'s `general = fixed | scientific`)
    (let [neg (atom false)
          ;; (cpp-read, 2026-11-24: the enumerators' values for [dcl.enum]/7 below)
          vals (atom [])]
      (loop [[c & more] (filter #(= "EnumConstantDecl" (:kind %)) (kids n)) v 0 bs (new-scope :enum scope :path (:path scope))]
        (when c
          ;; (cpp-s14: an enumerator's attributes are no initializer: <ios_base.h>'s `enum __attribute__((__flag_enum__))
          ;; _Ios_Openmode`, the native parser's NativeAttr before an enumerator's value)
          (let [x (first (remove #(str/ends-with? (str (:kind %)) "Attr") (kids c)))
                ;; (cpp-read: an initializer past 64 bits, an __int128's, is no standard integer type's value: [dcl.enum]/7 below
                ;; under D342-4 (a), the enumerator 0 then)
                wide (atom false)
                v (if x
                    (if (checking?)
                      (try (const-int bs x)
                           (catch arbace.lang.ExceptionInfo ex
                             (cond
                               (and (not (get-in n [:fixedUnderlyingType :qualType])) (not scoped)
                                    (re-find #"a 128-bit value outside 64 bits" (str (ex-message ex))))
                               (do (reset! wide true) 0)
                               ;; (cpp-read, 2026-11-24, the checker: [dcl.enum]/2, an enumerator's initializer is a constant
                               ;; expression: one surely not (a call of a non-constexpr function, of the function whose body
                               ;; declares the enumeration, ...) is GCC's "enumerator value for 'a' is not an integer constant", at
                               ;; the enumerator, its value 0 then; cpp1y/constexpr-recursion1.C)
                               (and (:codegen/not-constant (ex-data ex)) (:cx/sure (ex-data ex)) *on-refusal*)
                               (do (*on-refusal* (ex-info (str "codegen: enumerator value for '" (:name c) "' is not an integer constant")
                                                          {:codegen/refused :enum})
                                                 c)
                                   0)
                               :else (throw ex))))
                      (const-int bs x))
                    v)
                e {:e :enumerator :val v :ty t :pos (long (or (:_b c) 0))}]
            ;; (cpp-indep, the checker: [dcl.enum]/5, with a fixed underlying type -- a scoped enumeration's int when none is
            ;; written -- an enumerator's initializer is a converted constant expression of that type, so a value it cannot
            ;; represent is ill-formed ([expr.const]/12's narrowing): GCC's "enumerator value 500 is outside the range of
            ;; underlying type 'char'", at the enumerator; cpp0x/enum_base.C, enum27.C)
            (when (and (checking?) x (integer? v) (not @wide) (or scoped (get-in n [:fixedUnderlyingType :qualType]))
                       (abi/integral? (abi/unq under)) (not= :bool (abi/bn (abi/underlying (abi/unq under)))))
              (let [bits (* 8 (abi/size-of under))
                    sg (abi/signed? under)
                    xv (if (and (neg? (long v)) (re-find #"^unsigned long( long)?( int)?$" (str/trim (str (get-in x [:type :qualType])))))
                         (+ (bigint v) (bigint (.shiftLeft java.math.BigInteger/ONE 64)))
                         (bigint v))
                    lo (if sg (- (bigint (.shiftLeft java.math.BigInteger/ONE (int (dec bits))))) 0N)
                    hi (if sg (dec (bigint (.shiftLeft java.math.BigInteger/ONE (int (dec bits))))) (dec (bigint (.shiftLeft java.math.BigInteger/ONE (int bits)))))]
                (when (and (<= bits 64) (or (< xv lo) (> xv hi)))
                  (*on-refusal* (ex-info (str "codegen: enumerator value '" xv "' is outside the range of underlying type '"
                                              (str/trim (str (or (get-in n [:fixedUnderlyingType :qualType]) "int"))) "'")
                                         {:codegen/refused :enum})
                                c))))
            (when (neg? (long v)) (reset! neg true))
            ;; (an unsigned long or unsigned long long initializer's value past long's, held as a negative long)
            (swap! vals conj (cond @wide :wide
                                   (and (integer? v) (neg? (long v)) x (re-find #"^unsigned long( long)?( int)?$" (str/trim (str (get-in x [:type :qualType])))))
                                   (+ (bigint v) (bigint (.shiftLeft java.math.BigInteger/ONE 64)))
                                   :else v))
            ;; (queue 484, the checker: [basic.scope.declarative]/5, [dcl.enum]: two enumerators of one name in an enumeration,
            ;; `enum E { e, e };`, DRs/dr2530.C; g++'s "redefinition of", at the second)
            (when (and (checking?) (seq (.get ^java.util.HashMap (:names es) (ucn-name (:name c)))))
              (*on-refusal* (ex-info (str "codegen: redefinition of enumerator '" (:name c) "'") {:codegen/refused :redecl}) c))
            (enter! bs (:name c) (assoc e :ty under))
            (enter! es (:name c) e)
            (when-not scoped (enter! scope (:name c) (cond-> e (#{:private :protected} eacc) (assoc :cx-access eacc :cx-cls (:cls scope)))))
            ;; (round 54: the next enumerator's implicit value past the last one; LONG_MAX's successor, underlying_type7.C's
            ;; `enum class E6 : long { c = __LONG_MAX__ }`, is never read: unchecked, not an overflow's crash)
            ;; (queue 368, the checker: [dcl.enum]/5, a next enumerator with no initializer takes the previous value plus one,
            ;; which a fixed underlying type must represent: `enum E : long { a = __LONG_MAX__, b }`, g++'s "enumerator value
            ;; '9223372036854775808' is outside the range of underlying type 'long int'", at that enumerator)
            (when-let [c2 (first more)]
              (when (and (checking?) (or (integer? v) (boolean? v)) (get-in n [:fixedUnderlyingType :qualType])
                         (empty? (remove #(str/ends-with? (str (:kind %)) "Attr") (kids c2))))
                (let [bits (* 8 (abi/size-of under))
                      boolt (= :bool (abi/bn (abi/underlying (abi/unq under))))
                      sg (abi/signed? under)
                      hi (cond boolt 1N sg (dec (.shiftLeft java.math.BigInteger/ONE (int (dec bits)))) :else (dec (.shiftLeft java.math.BigInteger/ONE (int bits))))
                      nxt (inc (bigint (if (boolean? v) (if v 1 0) v)))]
                  (when (> nxt (bigint hi))
                    (*on-refusal* (ex-info (str "codegen: enumerator value '" nxt "' is outside the range of underlying type '"
                                                (get {"long" "long int" "unsigned long" "long unsigned int" "short" "short int"
                                                      "unsigned short" "short unsigned int" "unsigned" "unsigned int" "long long" "long long int"
                                                      "unsigned long long" "long long unsigned int"}
                                                     (str/trim (str (get-in n [:fixedUnderlyingType :qualType])))
                                                     (str/trim (str (get-in n [:fixedUnderlyingType :qualType]))))
                                                "'")
                                           {:codegen/refused :enum})
                                  c2)))))
            (recur more (unchecked-inc (long v)) bs))))
      ;; (cpp-s13: an enumeration without a fixed underlying type and no negative enumerator has clang's unsigned int as its
      ;; integer type ([dcl.enum]/7; Sema's ActOnEnumBody), which a bit-field of it reads zero-extended: <format>'s _Spec's
      ;; `_Align _M_align : 2` held _Align_right, 2, read back as -2, and "{:>6}" padded on the left's other side)
      (when (and (not scoped) (not (get-in n [:fixedUnderlyingType :qualType])) (not @neg))
        (swap! abi/*enums* assoc-in [id :nonneg] true))
      ;; (cpp-read, 2026-11-24, the checker: [dcl.enum]/7, an enumeration without a fixed underlying type whose enumerators' values
      ;; no standard integer type represents -- a negative one beside one above long long's maximum, or one past unsigned long
      ;; long's -- is ill-formed (D342-4 (a): the standard's rule, no extended integer type): GCC's "no integral type can represent all
      ;; of the enumerator values for 'E'", at the enumeration's closing brace; init/enum1.C)
      (when (and (checking?) (not scoped) (not (get-in n [:fixedUnderlyingType :qualType])) (seq @vals))
        (let [bs (concat (map #(bigint (if (boolean? %) (if % 1 0) %)) (filter #(or (integer? %) (boolean? %)) @vals))
                         ;; (a value past 64 bits: past every standard type's)
                         (when (some #{:wide} @vals) [(inc (bigint (.shiftLeft java.math.BigInteger/ONE 64)))]))
              lo (when (seq bs) (apply min bs)) hi (when (seq bs) (apply max bs))
              m63 (dec (.shiftLeft java.math.BigInteger/ONE 63)) m64 (dec (.shiftLeft java.math.BigInteger/ONE 64))]
          (when (and lo (or (and (neg? lo) (> hi (bigint m63))) (< lo (- (inc (bigint m63)))) (> hi (bigint m64))))
            (let [end (get-in n [:range :end])]
              (*on-refusal* (ex-info (str "codegen: no integral type can represent all of the enumerator values for '" (or nm "<unnamed>") "'")
                                     {:codegen/refused :enum})
                            (if (and (map? end) (:offset end)) (assoc n :range {:begin end}) n)))))))
    t))

(declare cx-friend-member-access! cx-friend-class-ns! cx-tparam-access! cx-elab-decl-scope cx-friend-fn-ident!)
(declare cx-tinst-member-type-access! cx-alias-member-access! cx-base-type-access! cx-member-tparam-access!) ; queue 506

(def ^:dynamic *class-ids* nil) ; cpp-tzdb: an atom {[class-id name] id}: the nested classes a remade instance reuses
(declare cx-plain-class? cx-non-literal cx-defaulted-not-constexpr)

(defn- declare-class! [scope0 n]
  (let [;; (cpp-rt-own: an elaborated-type-specifier's class, `struct P *p;` a member of S, is declared in the smallest namespace or
        ;; block scope holding it, [basic.scope.pdecl]/7.2 (the parser's :_elab-decl, queue 505's mark, 8c2fa2b4d): libcpp's cpp_reader
        ;; `struct cpp_savedstate *savedstate;` and pch.cc's `struct cpp_savedstate { ... }` one class, two before, "no member definedhash")
        ;; (queue 505, the checker: the same rule, cx-elab-decl-scope; the code generator's since cpp-rt-own2)
        scope0 (cond (checking?) (cx-elab-decl-scope scope0 n)
                     (and (:_elab-decl n) (not (:completeDefinition n)))
                     (loop [s scope0] (if (and s (#{:class :tparams} (:kind s)) (:parent s)) (recur (:parent s)) s))
                     :else scope0)
        nm (:name n)
        ;; a nested class defined outside its class (class L::F { ... }, [class.nest]/3): in the enclosing class's
        ;; scope (G5: <locale_classes.h>'s class locale::facet)
        ;; (not a class template's specialization's, declared in its parameters' scope: `template<...> class
        ;; __format::_Arg_store`'s qualifier is its template's, cpp-s5)
        q (when (and (:completeDefinition n) (not= :tparams (:kind scope0))) (qualifier-before n))
        scope (or (when (seq q)
                    (let [e (first (filter #(#{:ns :type} (:e %)) (lookup-qualified scope0 q)))]
                      (cond (= :ns (:e e)) (:scope e) (and e (abi/class? (:ty e))) (:scope (abi/cls-of (:ty e))) :else nil)))
                  scope0)
        ;; (cpp-rt-own: a class defined by a qualified name is the one declared before in the namespace it names or in one of
        ;; that namespace's inline namespaces, [namespace.memdef]/2 with [namespace.def]/7: fs_dir.cc's `struct fs::_Dir` of
        ;; <bits/fs_dir.h>'s `struct _Dir;` in std::filesystem::__cxx11, which directory_iterator's __shared_ptr<_Dir> names;
        ;; a class of its own in std::filesystem before, and `_M_dir->entry` "no member entry"; the definition's scope then
        ;; the declaration's; its members mangled in the namespace the definition names, as clang's tag redeclaration takes the
        ;; qualifier's context for its semantic one: _ZNKSt10filesystem4_Dir7currentEv, no __cxx11, while the type itself, the
        ;; first declaration's, keeps it: __shared_ptr<std::filesystem::__cxx11::_Dir>)
        qns (when (and (seq q) (= :ns (:kind scope))) scope)
        scope (or (when (and (seq q) nm (= :ns (:kind scope))
                             (not (some #(and (= :type (:e %)) (abi/class? (:ty %))) (.get ^java.util.HashMap (:names scope) nm))))
                    (let [seen (java.util.IdentityHashMap.)]
                      (letfn [(inl [s]
                                (some (fn [u] (when (and (.containsKey ^java.util.HashMap (:names u) " inline") (nil? (.put seen (:names u) true)))
                                                (if (some #(and (= :type (:e %)) (abi/class? (:ty %))) (.get ^java.util.HashMap (:names u) nm))
                                                  u
                                                  (inl u))))
                                      (:usings s)))]
                        (inl scope))))
                  scope)
        ^java.util.HashMap m (:names scope)
        old (when nm (some #(when (and (= :type (:e %)) (abi/class? (:ty %))) (:id (:ty %))) (.get m nm)))
        _ (when (and old qns (not (identical? qns scope)))
            (abi/update-cls! old #(-> % (update :scope assoc :path (conj (vec (:path qns)) [:cls old]))
                                       ;; (cpp-rt-own3, DECISION cpp-rt-own2-3 (a): and the definition's position, the code
                                       ;; generator's emission-order naming, arbace.cpp.codegen's redef-name)
                                       (assoc :mangle-path-after [(vec (:path qns)) (inc (long @*ids*)) (long (or (:_b n) 0))]))))
        ;; (cpp-tzdb: a provisional instance made again in place keeps its nested classes' ids, template.ae's class-completed!:
        ;; a class declared between the two makings names them -- <format>'s basic_format_arg<_Context>::handle derives from
        ;; _Arg_value<_Context>::_HandleBase, and _Arg_value<format_context>, made inside basic_format_context's definition, is
        ;; made again once the context is complete: its new _HandleBase had been another class than handle's base, so
        ;; derived_from<handle, _HandleBase> was false in _M_set)
        reused (when (and (not old) nm *class-ids* (:cls scope))
                 (let [k [(:cls scope) nm] r (get @*class-ids* k)]
                   (when r (swap! *class-ids* dissoc k) r)))
        id (or old reused (next-id))
        ;; (a class of an unnamed namespace, or local to an internal function, has internal linkage and so have its
        ;; members, [basic.link]/4; G5c: libsupc++'s vec.cc's uncatch_exception, atexit_thread.cc's key_s)
        ;; (queue 351: a class local to a function that is neither inline nor a template's instance has internal linkage
        ;; for the code generator too, clang's getLVForLocalDecl: shared_ptr.cc's get_mutex's M; an inline one's, linkonce_odr)
        internal (loop [s scope] (cond (nil? s) false (:internal s) true (= :ns (:kind s)) false
                                       (and (= :fn (:kind s)) (= :local (ffirst (:path s)))
                                            (let [lf (second (first (:path s)))] (and (map? lf) (not (or (:inline lf) (:tinst lf))))))
                                       true
                                       :else (recur (:parent s))))
        cs (or (when-not reused (:scope (abi/cls id))) (new-scope :class scope :cls id :path (conj (:path scope) [:cls id]) :internal internal))
        t {:k :class :id id}]
    (when-not old
      (swap! abi/*classes* assoc id {:id id :name nm :path (:path scope) :scope cs :fields [] :bases [] :outer scope
                                     :union (= "union" (:tagUsed n)) :header (header-node? n)
                                     ;; (queue 497, the checker: GNU's unavailable attribute on the class)
                                     :unavailable (and (checking?) (unavailable-node? n))})
      (when nm (enter! scope nm (cond-> {:e :type :ty t :pos (long (or (:_b n) 0))}
                                  ;; (queue 492, the checker: a member class's access, as a member typedef's, check-type-access!)
                                  (and (checking?) (= :class (:kind scope)) *member-access*) (assoc :access *member-access*)))))
    ;; (cpp-s13: GNU's abi_tag on a class, Itanium 5.1.2's <abi-tags> after its name wherever it is mangled: <ios_base.h>'s
    ;; `class _GLIBCXX_ABI_TAG_CXX11 failure`, std::ios_base::failure[abi:cxx11], _ZTINSt8ios_base7failureB5cxx11E; without it
    ;; a program's catch named the old ABI's failure, whose type_info no __ios_failure the library throws reaches)
    (when-let [tags (and nm (not-empty (vec (sort (distinct (for [a (:inner n) :when (and (= "NativeAttr" (:kind a)) (#{"abi_tag" "__abi_tag__"} (:_gnu a)))
                                                                  [_ t] (re-seq #"\"([^\"]*)\"" (str (:_arg a)))]
                                                              t))))))]
      (abi/update-cls! id assoc :mname (str (abi/source-name nm) (apply str (map #(str "B" (count %) %) tags))) :abi-tags tags))
    (when (:completeDefinition n)
      (when nm (.put ^java.util.HashMap (:names cs) nm [{:e :type :ty t :pos -1}])) ; the injected-class-name
      (abi/update-cls! id assoc :complete true :defining true
                       :bases (vec (for [[bi bs] (map-indexed vector (:bases n))
                                         ;; (cpp-s4: a pack expansion among the bases, [temp.variadic]/5's base-specifier-list:
                                         ;; one base per element of the packs it names, variant's `_Build_FUN<_Ind, _Tp, _Ti>...`)
                                         :let [qt (get-in bs [:type :qualType])
                                               ss (when (:isPackExpansion bs)
                                                    (when-let [h (:pack-scopes @hooks)]
                                                      (h scope (distinct (re-seq #"[A-Za-z_][A-Za-z_0-9]*" (str qt))))))]
                                         bt (if ss (map #(resolve-type % qt) ss)
                                                [(try (resolve-type scope qt)
                                                      ;; (cpp-tpl2, the checker: a base naming a class template's specialization
                                                      ;; surely without a definition, select-instance!'s :cx/sure-incomplete,
                                                      ;; [class.derived.general]/2: GCC's "invalid use of incomplete type", at the
                                                      ;; base-specifier)
                                                      (catch arbace.lang.ExceptionInfo x
                                                        (if-let [tn (when (checking?) (:cx/sure-incomplete (ex-data x)))]
                                                          (do (abi/update-cls! id assoc :cx-inst-refused true)
                                                          (throw (ex-info (str "codegen: invalid use of incomplete type '" tn "'")
                                                                          {:codegen/refused :incomplete :cx/node (if (:range bs) bs n)})))
                                                          ;; (cpp-tpl2: a base naming a member class as a template, template-id's
                                                          ;; refusal, at the base-specifier too)
                                                          (if (and (checking?) (re-find #"^codegen: '.*' names a class, which is not a class template" (str (ex-message x))))
                                                            (do (abi/update-cls! id assoc :cx-inst-refused true)
                                                                (throw (ex-info (ex-message x) (assoc (ex-data x) :cx/node (if (:range bs) bs n)))))
                                                            (throw x)))))])
                                         :when (not (cx-incomplete-base! bt bs n id))]
                                       (cond-> {:cls (:id bt) :virtual (boolean (:isVirtual bs)) :access (keyword (or (#{"public" "protected" "private"} (:writtenAccess bs))
                                                                                                         (if (= "class" (:tagUsed n)) "private" "public")))}
                                         ;; a base dependent in a template's pattern (CODEGEN.md G3: [temp.dep]/4)
                                         (contains? (:dep-bases (abi/cls id)) bi) (assoc :dependent true)))))
      ;; (queue 463, the checker: the class's definition, where an implicitly deleted special member's reason is reported)
      (when (and (checking?) (:range n)) (abi/update-cls! id assoc :cx-node {:range (:range n)}))
      (cx-base-type-access! scope id n) ; (queue 506: a base-specifier's names in the derived class's context)
      ;; (round 54, the checker: [class.mi]/3, a class named twice as a direct base: reported at the class, the later one dropped)
      (when (checking?)
        (let [bs (:bases (abi/cls id))
              dup (some (fn [[i b]] (when (and (:cls b) (not (:dependent b)) (some #(= (:cls b) (:cls %)) (take i bs))) b))
                        (map-indexed vector bs))]
          (when dup
            (*on-refusal* (ex-info (str "codegen: duplicate base type '" (:name (abi/cls (:cls dup))) "' is invalid") {:codegen/refused :base}) n)
            (abi/update-cls! id assoc :bases (reduce (fn [o b] (if (and (:cls b) (not (:dependent b)) (some #(= (:cls b) (:cls %)) o)) o (conj o b))) [] bs)))))
      ;; (cpp-1123, the checker: [class.pre]/5, a class marked with the class-virt-specifier final named as a base,
      ;; GCC's "cannot derive from 'final' base 'B2' in derived type 'D2'", reported at the class: cpp0x/override2.C)
      (when (some #(= "FinalAttr" (:kind %)) (:inner n)) (abi/update-cls! id assoc :final true))
      (when (and (checking?) (not (header-node? n)))
        (doseq [b (:bases (abi/cls id))
                ;; (cpp-singles: a base dependent in the pattern too, in a class template's specialization, where it names
                ;; a class: GCC's error at the template's definition, cpp0x/override2.C's D4<B2> over `template<class T> struct D4
                ;; : T {}`)
                :let [bc (when (and (:cls b) (or (not (:dependent b)) (:targs (abi/cls id)))) (abi/cls (:cls b)))]
                :when (:final bc)]
          (*on-refusal* (ex-info (str "codegen: cannot derive from 'final' base '" (:name bc) "' in derived type '" nm "'") {:codegen/refused :base}) n)))
      ;; alignas on the class ([dcl.align]): its alignment at least the strictest one written (a type's or a constant's)
      ;; (and GNU's aligned, G5c: unwind.h's `struct _Unwind_Exception { ... } __attribute__((__aligned__))`, without an
      ;; argument the target's largest alignment, 16 on x86-64, as GCC documents it and clang's TargetInfo's
      ;; getDefaultAlignForAttributeAligned)
      (when-let [as (seq (concat (keep :_arg (filter #(= "AlignedAttr" (:kind %)) (:inner n)))
                                 (for [a (:inner n) :when (and (= "NativeAttr" (:kind a)) (#{"aligned" "__aligned__"} (:_gnu a)))]
                                   (let [x (some-> (:_arg a) str/trim)] (if (seq x) x "16")))))]
        (abi/update-cls! id assoc :align-attr
                         (apply max (for [a as]
                                      (long (or (parse-long (str/trim a))
                                                (try (abi/align-of (resolve-type scope a)) (catch arbace.lang.ExceptionInfo _ nil))
                                                ((:const-bound @hooks) scope a)))))))
      (let [access (atom (if (= "class" (:tagUsed n)) :private :public))]
        ;; (cpp-s5: the unnamed class an anonymous member's type names is this body's last one: a class the members'
        ;; declarations instantiate meanwhile declares its own unnamed ones, which took its place; <format>'s
        ;; _Arg_value's union, after basic_format_args' had been declared in between)
        (try
        (binding [*last-anon* (atom nil)]
        (doseq [k (kids n)]
          ;; (queue 526, 518-1 (a), the checker: a member of a main-file class that is no template's specialization, refused by
          ;; the slice or the program, is dropped and its class goes on, as GCC drops an erroneous member declaration; its name
          ;; and its class's recorded (cx-dropped!), so that the cascades it leaves are not reported. Before, the refusal left
          ;; the class, the class's declaration was refused, and the unit with it)
          ;; (queue 573: a class template's specialization's member that names a pack unexpanded, cx-pack-dropped-member?: not
          ;; declared)
          (when-not (cx-pack-dropped-member? id k)
          (cx-member-recover! cs id k (fn []
          (when (and (checking?) (#{"FieldDecl" "TypedefDecl" "TypeAliasDecl"} (:kind k)))
            (cx-member-type-access! cs id k)
            (cx-tinst-member-type-access! cs id k) ; (queue 506: T::X's access in a class template's specialization)
            (cx-alias-member-access! cs k))        ; (queue 506: an alias template's T::X in its own context)
          (case (:kind k)
            "AccessSpecDecl" (reset! access (keyword (:access k)))
            "FieldDecl" (if (and (nil? @*last-anon*) (header-node? k)
                                 (re-find #"\((unnamed|anonymous) (union|struct|class) at " (str (get-in k [:type :qualType]))))
                          ;; (cpp-s8: an anonymous member whose unnamed class a header's drop left undeclared: left out, a
                          ;; drop, so a provisional instance is made again later; before, a member of no type, and the
                          ;; class's layout refused "no size for nil": <format>'s _Arg_value's union)
                          (do (.incrementAndGet ^java.util.concurrent.atomic.AtomicLong drop-count)
                              (when (System/getenv "CPP_HDR_TRACE") (binding [*out* *err*] (println "header drop: an anonymous member of" (:name n) "(its class dropped)"))))
                        (if-let [bad (let [t0 (try (resolve-type cs (get-in k [:type :qualType]))
                                                   (catch arbace.lang.ExceptionInfo x
                                                     ;; (queue 570-1 (a): the error reported and the member kept with GNU's
                                                     ;; VLA type, so that its uses report nothing more; template/array9.C)
                                                     (if-let [b (cx-field-bound-error cs k)]
                                                       (if-let [t (cx-field-vla-type cs k)]
                                                         (do (swap! *order* conj [:cx-error b]) (vary-meta t assoc ::vla-reported true))
                                                         b)
                                                       (throw x))))]
                                       (if (instance? arbace.lang.ExceptionInfo t0)
                                         t0
                                       (let [et (loop [t t0] (if (abi/arr? t) (recur (:of t)) t))]
                                       ;; (CP368 (a): a member of a class still being defined, its own or an enclosing one's,
                                       ;; or a class template's instance being instantiated: an incomplete type,
                                       ;; [class.mem.general]/7, clang's err_field_incomplete_or_sizeless; pr67405.C's `S f;` in
                                       ;; S, template/instantiate1.C's Z<int> through Y<Z<int>> and X<Z<int>>: the class had
                                       ;; contained itself, and trivial-copy? and the layout recursed without end. The checker
                                       ;; reports it and leaves the member out; the code generator refuses)
                                       ;; (queue 484, the checker: also a class declared and never or not yet defined,
                                       ;; [class.mem.general]/7, [basic.def]/5 -- `struct A; struct B { A a; };`,
                                       ;; init/array26.C; a member of the main file's, not a class template's or a
                                       ;; lambda's, as incomplete-var!'s)
                                       (or
                                       (when (and (abi/class? et)
                                                  (let [c (abi/cls (:id et))]
                                                    (or (:defining c)
                                                        (and (checking?) c (not (:complete c)) (not (:tmpl c)) (not (:lambda c))
                                                             (not (header-node? k))))))
                                         (ex-info (str "codegen: field has incomplete type '" (:name (abi/cls (:id et))) "'")
                                                  {:codegen/refused :incomplete :cx/node k}))
                                       ;; (cpp-rind, the checker: a data member of a function type, an instance's `T v;` for a
                                       ;; function type T, [temp.inst]/? with [class.mem.general]/? : GCC's "field 'v' invalidly
                                       ;; declared function type"; template/fn.C)
                                       (when (and (checking?) (map? et) (abi/fn? (abi/unq et)) (not (header-node? k))
                                                  ;; (an instance's alone: a class's own `F f;` of a function typedef declares a member
                                                  ;; function)
                                                  (some? (:targs (abi/cls id))))
                                         (ex-info (str "codegen: variable or field '" (:name k) "' declared void (field invalidly declared function type)")
                                                  {:codegen/refused :incomplete :cx/node k}))
                                       ;; (queue 518, the checker: a member of type cv void, an instance's `T m;` for T = void,
                                       ;; GCC's "variable or field declared void"; template/error2.C)
                                       (when (and (checking?) (map? et) (abi/void? (abi/unq et)) (not (header-node? k)))
                                         (ex-info (str "codegen: variable or field '" (:name k) "' declared void")
                                                  {:codegen/refused :incomplete :cx/node k}))
                                       ;; (cpp-decl2, the checker: a bit-field of a type neither integral nor an enumeration,
                                       ;; [class.bit]/3 (the parser's error, GCC's "bit-field 'i' with non-integral type"): left
                                       ;; out of the class as GCC drops it, so a use is "has no member named 'i'"; no
                                       ;; diagnostic of its own here; parse/bitfield1.C)
                                       (when (and (checking?) (:isBitfield k) (map? et) (not (header-node? k))
                                                  (let [u (abi/unq et)] (and (#{:b :ptr :class :mptr} (:k u)) (not (abi/integral? u)))))
                                         (ex-info "codegen: a bit-field of a type neither integral nor an enumeration" {:codegen/refused :bitfield-type :cx/node k}))
                                       ;; (cpp-1123: a member of an abstract class type or an array of it, [class.abstract]/3)
                                       (when-let [an (and (checking?) (not (header-node? k)) (cx-abstract-type et))]
                                         (ex-info (str "codegen: cannot declare field '" (:name k) "' to be of abstract type '" an "'")
                                                  {:codegen/refused :abstract :cx/node k}))
                                       ;; (queue 570, the checker: a member of a variably modified type, [class.mem.general]: GCC's
                                       ;; "data member may not have variably modified type 'int [n]'"; ext/vlm2.C's typedef)
                                       ;; (queue 570-1 (a): reported, the member kept)
                                       (when (and (checking?) (not (header-node? k)) (cx-vm? t0) (not (::vla-reported (meta t0))))
                                         (swap! *order* conj [:cx-error (ex-info (str "codegen: data member '" (:name k) "' may not have variably modified type")
                                                                                 {:codegen/refused :vla-type :cx/node k})])
                                         nil)))))]
                          (if (checking?)
                            (do (swap! *order* conj [:cx-error bad])
                                ;; (cpp-rind: the class marked, its members' bodies not analyzed for an explicit instantiation,
                                ;; whose uses of the member left out would be the error's cascade: template/instantiate3.C)
                                (abi/update-cls! id assoc :cx-dropped-field true))
                            (throw bad))
                          (let [ft (try (resolve-type cs (get-in k [:type :qualType]))
                                        ;; (queue 570-1 (a): a member whose bound is surely no constant, reported above, kept)
                                        (catch arbace.lang.ExceptionInfo x (or (cx-field-vla-type cs k) (throw x))))
                              i (count (:fields (abi/cls id)))
                              _ (when (:isBitfield k) (cx-cce-type! cs (first (kids k)) "a bit-field's width"))
                              bits (when (:isBitfield k) (const-int cs (first (kids k))))
                              init (when (:hasInClassInitializer k) (if bits (second (kids k)) (first (kids k))))]
                          (abi/update-cls! id update :fields conj (cond-> {:name (:name k) :ty ft :init init :access @access :i i :bits bits
                                                                            :anon (boolean (and (nil? (:name k)) (not bits)))
                                                                            ;; (queue 387: `mutable`, which the parser's FieldDecl carries and
                                                                            ;; field-node and the constant evaluator read, had never been kept:
                                                                            ;; facet's `mutable _Atomic_word _M_refcount` through a const this was
                                                                            ;; const, cow-locale_init.cc's &_M_refcount a const int*)
                                                                            :mutable (boolean (:mutable k))}
                                                                     ;; (cpp-decl2, the checker: the member's node, a union member's
                                                                     ;; diagnostic's place, cx-deleted-implicit!)
                                                                     (checking?) (assoc :node k)
                                                                     ;; (queue 570-1 (a): kept with GNU's VLA type, abi's layout's no bytes)
                                                                     (and (checking?) (cx-vm? ft)) (assoc :cx-vla true)
                                                                     ;; [[no_unique_address]] on a member of class type: potentially
                                                                     ;; overlapping ([intro.object]/8, Itanium §1.1; cpp-gatefix)
                                                                     (and (not bits) (abi/class? (abi/unq ft))
                                                                          (some #(and (= "NativeAttr" (:kind %)) (= "no_unique_address" (:_std %))) (:inner k)))
                                                                     (assoc :nua true)))
                          (if (:name k)
                            (enter! cs (:name k) {:e :field :cls id :i i :pos -1})
                            ;; an anonymous union or struct member: its members named in the class ([class.union.anon])
                            (when (and (not bits) (abi/class? ft))
                              (doseq [[mn es] (.entrySet ^java.util.HashMap (:names (:scope (abi/cls-of ft))))
                                      e es :when (#{:field :indirect} (:e e))]
                                (enter! cs mn {:e :indirect :chain (into [[id i]] (if (= :field (:e e)) [[(:cls e) (:i e)]] (:chain e))) :pos -1})))))))
            (do (when (and (checking?) (= "FriendDecl" (:kind k)))
                  ;; (CP313 (a): the friends each class declares, clang's EffectiveContext's matching by them: a function's
                  ;; or a function template's name, else a class, else unknown)
                  (let [fd (first (filter #(#{"FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "FunctionTemplateDecl"} (:kind %)) (:inner k)))]
                    (abi/update-cls! id #(cond-> (assoc % :has-friends true)
                                           ;; (cpp-singles: a friend function of any name, which ADL may find, sure-assoc-nss)
                                           fd (assoc :friend-fn-any true)
                                           (and fd (string? (:name fd)) (seq (:name fd))) (update :friend-fns (fnil conj #{}) (:name fd))
                                           (and (nil? fd) (or (get-in k [:type :qualType]) (some (fn [x] (= "ClassTemplateDecl" (:kind x))) (:inner k))))
                                           (assoc :friend-classes true)
                                           ;; (the rest of CP313 (a): a friend class's name, its last component, matched by name)
                                           (nil? fd)
                                           (update :friend-class-names (fnil conj #{})
                                                   (or (some (fn [x] (when (= "ClassTemplateDecl" (:kind x)) (:name x))) (:inner k))
                                                       (some-> (get-in k [:type :qualType]) (str/replace #"<.*$" "") (str/replace #"^\s*(?:class|struct|union)\s+" "")
                                                               (str/split #"::") last str/trim)
                                                       ""))
                                           (and (nil? fd) (nil? (get-in k [:type :qualType])) (not-any? (fn [x] (= "ClassTemplateDecl" (:kind x))) (:inner k)))
                                           (assoc :friend-unknown true)))
                    ;; (queue 502: an unqualified elaborated friend class's namespace, cx-friend-class-ns!)
                    (cx-friend-class-ns! cs id k fd)
                    ;; (queue 499: a friend declaration naming another class's inaccessible member function)
                    (cx-friend-member-access! cs id k fd)
                    ;; (queue 505: a friend function's identity, cx-friend-fn-ident!)
                    (cx-friend-fn-ident! cs id k fd)
                    ;; (cpp-tpl2: a friend class naming a constrained class template's specialization of non-dependent
                    ;; arguments, [temp.names]/7: its constraints checked, GCC's "template constraint failure" at the class
                    ;; declaring it, concepts-friend2.C's `friend class Foo<T>;` in S<X>)
                    (when-let [qt (when (and (nil? fd) (not (header-node? n))) (get-in k [:type :qualType]))]
                      (when (str/includes? (str qt) "<")
                        (try (resolve-type cs (str/replace (str qt) #"^\s*(?:class|struct|union)\s+" ""))
                             (catch arbace.lang.ExceptionInfo x
                               (when (re-find #"^codegen: template constraint failure for" (str (ex-message x)))
                                 (*on-refusal* x (let [l (:loc n) l (if (:expansionLoc l) (:expansionLoc l) l)] (if (:offset l) {:range {:begin l}} n))))))))))
                (binding [*member-access* @access] (declare-node! cs k)))))))))
        (finally (abi/update-cls! id dissoc :defining))))
      ;; (round 54, the checker: at most one variant member of a union with a default member initializer,
      ;; [class.mem.general]/11: GCC's "initializations for multiple members of 'A'", at the union)
      ;; (cpp-small, H: at the union's name, an unnamed union's at its `{`, as g++ 15.2 places it (observed by hand:
      ;; `union U` at U, `union\n {` at the brace): cpp0x/pr58510.C)
      (when (and (checking?) (:union (abi/cls id)) (< 1 (count (filter :init (:fields (abi/cls id))))))
        (*on-refusal* (ex-info (str "codegen: initializations for multiple members of '" nm "'") {:codegen/refused :union})
                      (let [l (:loc n) o (:offset l)]
                        (if (and (integer? o) (:file l) (= (:file l) (get-in n [:range :begin :file])))
                          (let [o (if nm (long o) (let [i (.indexOf ^String (text-of (:file l)) "{" (int o))] (if (neg? i) (long o) i)))]
                            (assoc-in n [:range :begin] (assoc l :offset o)))
                          n))))
      (finish-class! id)
      ;; (CP365 (a): finished, and the provisional instances that waited for it made again)
      (abi/update-cls! id assoc :finished true)
      ;; (cpp-sweep, the checker: C++11's [dcl.constexpr]/8, the class of a constexpr non-static member function other than a
      ;; constructor a literal type (DR 1684 dropped it in C++14): GCC's pedwarn, an error under -pedantic-errors, "enclosing
      ;; class of 'constexpr' non-static member function ... is not a literal type" at each such member, declared or defined,
      ;; once the class is complete; a class template's specialization not judged here (GCC explains it at a constant
      ;; evaluation's call instead): cpp1y/constexpr-dr1684.C, cpp0x/constexpr-data1.C)
      (when (and (checking?) *on-refusal* *pedantic-errors* (= 11 (long *cxx-year*)) (not (header-node? n)) (cx-plain-class? id))
        (when (cx-non-literal t)
          (doseq [mid (:methods (abi/cls id))
                  :let [f (fnd mid)]
                  :when (and (:constexpr f) (= :method (:kind f)) (not (:static f)) (not (:implicit f)) (:node f) (not (header-node? (:node f))))]
            (*on-refusal* (ex-info (str "codegen: enclosing class of 'constexpr' non-static member function '" (:name f) "' is not a literal type")
                                   {:codegen/refused :constexpr :cx/node (:node f)})
                          (:node f)))))
      ;; (cpp-sweep, the checker: [dcl.fct.def.default]/3 (C++20; [dcl.constexpr]/3-5 before), a special member defaulted on its
      ;; first declaration declared constexpr or consteval only when its implicit definition would be constexpr: GCC's
      ;; "explicitly defaulted function ... cannot be declared 'constexpr' because the implicit declaration is not 'constexpr'"
      ;; at it, cx-defaulted-not-constexpr: cpp0x/constexpr-diag3.C's Def, cpp2a/consteval3.C's C, cpp2a/constexpr-dtor3.C)
      (when (and (checking?) *on-refusal* (not (header-node? n)) (cx-plain-class? id) (not (:union (abi/cls id))))
        (doseq [fid (concat (:ctors (abi/cls id)) (some-> (:dtor (abi/cls id)) vector))
                :let [f (fnd fid)]
                :when (and (:constexpr f) (:defaulted f) (not (:ool-defaulted f)) (not (:out-of-line-default f)) (not (:implicit f))
                           (:node f) (not (header-node? (:node f))) (cx-defaulted-not-constexpr id f))]
          (*on-refusal* (ex-info (str "codegen: explicitly defaulted function '" (:name f) "' cannot be declared '" (if (:consteval f) "consteval" "constexpr")
                                      "' because the implicit declaration is not 'constexpr' (" (cx-defaulted-not-constexpr id f) ")")
                                 {:codegen/refused :constexpr :cx/node (:node f)})
                        (:node f))))
      (when-let [h (:class-completed @hooks)] (h id))
      (when-not nm (reset! *last-anon* t)))
    t))

(declare declare-node*! cx-access! cx-using-map)
(declare init-for cx-decomposition!) ; cpp-def: ce-eval's global arrays, namespace-scope structured bindings

(def ^:dynamic *retry* nil) ; atom [[scope node] ...]: header declarations to declare again after the headers (G4)
(def ^:dynamic *main-retry* nil) ; atom [[scope node exception] ...]: the main file's typedefs to declare again (CP338 (a))
;; queue 383: a class template's specialization only named, not used (a header's typedef, `typedef basic_string<char> string;`
;; in <bits/stringfwd.h> before char_traits is defined; template.ae's __is_same): an incomplete class, completed in place when
;; its template is defined (CP372 (a)), not a refusal ([temp.inst]/2)
(def ^:dynamic *name-only* false)
(def ^:dynamic *incomplete-ok* nil) ; cpp-s13: the headers' last round, a class template's specialization named before (or
                                    ; without) its definition an incomplete class (template's incomplete-instance!, CP372 (a))
(def ^:dynamic *header-drops* nil) ; atom {place [class kind name message]}: the header declarations not declared (G4; CP364 (a):
                                    ; one declared on a later round taken out, gen-batch's drops.tsv)

(defn- drop-key
  "A header declaration's key in *header-drops*: the node itself (a retry declares the same node), by identity."
  [n]
  [(System/identityHashCode n) (get-in n [:range :begin]) (:kind n) (:name n)])

(defn declare-node!
  "Enters a declaration node of namespace or class scope. A header's declaration that the analysis refuses is dropped
  (G4: a use of it fails later as an unknown name; CPP_HDR_TRACE=1 prints each)."
  [scope n]
  (if (lazy-header-node? n)
    (try (let [r (declare-node*! scope n)]
           (when *header-drops* (swap! *header-drops* dissoc (drop-key n)))
           r)
         (catch arbace.lang.ExceptionInfo e
           (if (or (:codegen/refused (ex-data e)) (:codegen/not-constant (ex-data e)))
             (do (.incrementAndGet ^java.util.concurrent.atomic.AtomicLong drop-count)
                 (when *header-drops*
                   (swap! *header-drops* assoc (drop-key n)
                          [(or (:codegen/refused (ex-data e)) :not-constant) (:kind n) (:name n) (.getMessage e)]))
                 ;; a declaration that named a class template's specialization before its specialization was defined
                 ;; (<stringfwd.h>'s typedef basic_string<char> string, char_traits<char> defined later): tried again
                 ;; after the headers (clang instantiates only when the type must be complete)
                 ;; (G5: and one that named a type such a declaration declares: <ostream>'s typedef, then <iostream>'s
                 ;; extern ostream cout)
                 (when (and *retry* (re-find #"an incomplete class template|unknown type|header type" (str (.getMessage e))))
                   (swap! *retry* conj [scope n]))
                 (when (System/getenv "CPP_HDR_TRACE")
                   (binding [*out* *err*] (println "header drop:" (:kind n) (:name n) (get-in n [:range :begin :offset]) (.getMessage e) (:file (loc-of (get-in n [:range :begin]))))))
                 nil)
             (throw e))))
    (let [retry? (and *main-retry* (#{"TypedefDecl" "TypeAliasDecl"} (:kind n)))
          declare! (fn []
                     (if retry?
                       ;; (CP338 (a): a main file's typedef or alias naming a class template's specialization before the template, or its
                       ;; specialization, is defined (pr77550's `typedef basic_string<char> string;` before char_traits<char>): declared again
                       ;; after each later top-level declaration, as the headers' are after them; clang instantiates only when the type must
                       ;; be complete)
                       (try (declare-node*! scope n)
                            (catch arbace.lang.ExceptionInfo e
                              (cond
                                (and (:codegen/refused (ex-data e)) (re-find #"an incomplete class template" (str (.getMessage e))))
                                (do (swap! *main-retry* conj [scope n e]) nil)
                                ;; (cpp-tpl2, the checker: a type a complete class surely does not declare, cx-no-type-named!: reported at the
                                ;; alias and dropped, as the other declarations' refusals below)
                                (and (checking?) (re-find #"^codegen: unknown type .*: no type named '.*' in the complete class" (str (.getMessage e))))
                                (do (*on-refusal* e n) nil)
                                :else (throw e))))
                       (declare-node*! scope n)))]
      ;; (n-cpp-concepts, the checker: a main file's declaration that names a constrained class template's specialization
      ;; whose constraints are surely not satisfied, or deduces a constrained placeholder's type that does not satisfy its
      ;; constraint, is reported at the declaration and dropped, the unit going on, as a statement's refusal is)
      ;; (queue 526: a typedef's or alias's other refusals too, which had ended the unit outside this recovery)
      (if (checking?)
        (try (when-not retry?
               (cx-tparam-access! scope n) ; (queue 502: a namespace-scope template's parameters' access)
               (cx-member-tparam-access! scope n)) ; (queue 506: a member template's parameters' access)
             (declare!)
             (catch arbace.lang.ExceptionInfo e
               (if-let [r (when-not (:cls scope) (cx-sure-incomplete-refusal n nil e))]
                 ;; (queue 500: a variable of a specialization surely without a definition, reported and dropped; and a
                 ;; declaration whose refusal the templates reported already, :cx/reported, dropped)
                 (do (*on-refusal* r n) nil)
               (if (:cx/reported (ex-data e))
                 nil
               ;; (queue 487: and one that names an ambiguous name, cx-unqualified-ambiguous!, cx-qualified-ambiguous!)
               ;; (queue 497: and an out-of-line member declaration no member of its class matches)
               (cond
                 ;; (cpp-tpl2: and one whose class template's template template argument surely does not match, [temp.arg.template]/3-4)
                 (re-find #"^codegen: (template constraint failure for|placeholder constraints not satisfied|reference to '.*' is ambiguous|invalid use of incomplete type|no declaration matches '|a template template argument whose parameters do not match|pack expansion argument for non-pack parameter of alias template|'.*' names a class, which is not a class template|invalid constructor: |could not convert an expression of type int to a pointer in a converted constant expression|narrowing conversion of '-?\d+' to the template parameter's type|unknown type .*: no type named '.*' in the complete class)" (str (.getMessage e)))
                 (do (*on-refusal* e n) nil)
                 ;; (queue 518: a namespace-scope variable's, function's or alias's declaration whose template argument is no
                 ;; constant, `S<f()> s;`, cpp0x/pr78765.C's ValueTypeInfo<var>: dropped without a word and the unit going on, as
                 ;; GCC goes on past an erroneous declaration; before, the unit stopped there, every later error of the file lost.)
                 ;; (cpp-sweep: a namespace-scope structured binding declaration, which the slice does not declare, dropped
                 ;; and the unit going on, its later errors kept: cpp2a/consteval3.C's `consteval auto [ b, c ] = ...`)
                 (and (checking?) (not (:cls scope)) (not (header-node? n)) (= "DecompositionDecl" (:kind n))
                      (re-find #"^codegen: declaration DecompositionDecl" (str (.getMessage e))))
                 ;; (cpp-def: its [dcl.struct.bind] rules still checked, cx-decomposition!'s own errors alone reported:
                 ;; cpp1z/decomp55.C's tuple_element<0, A>::type void)
                 (do (try (cx-decomposition! {:scope scope} n)
                          (catch arbace.lang.ExceptionInfo x
                            (when (= :decomp (:codegen/refused (ex-data x))) (*on-refusal* x n))))
                     nil)
                 ;; (queue 526, 518-1 (a): any main-file declaration of namespace scope the slice or the program refuses, of any
                 ;; kind (a class, a template, an enumeration as well), dropped, its names recorded (cx-dropped!) so that a later
                 ;; refusal that follows from it is not reported (cx-poisoned?); a variable's, function's, typedef's or alias's
                 ;; refusal reported by its rule when it has one (a class's or a template's says nothing: its members' refusals
                 ;; are recovered in the class, declare-class!). 518's broader form un-silenced cascades: cpp2a/class-deduction-
                 ;; aggr3.C's aggregate deduction the slice does not make (now unsure, template.ae's aggregate-guide), then
                 ;; `c2.len`; cpp0x/vt-34753.C's `B<int> c;` after a constructor template GCC drops (now dropped as well,
                 ;; template.ae's cx-bad-member-template?))
                 (and (= :ns (:kind scope)) (not (:cls scope)) (not (header-node? n)) (cx-recoverable? e))
                 (do (when (#{"VarDecl" "FunctionDecl" "TypedefDecl" "TypeAliasDecl"} (:kind n)) (*on-refusal* e n))
                     (cx-dropped! scope n)
                     nil)
                 :else (throw e))))))
        (declare!)))))

;; queue 505 (500-2 (a), the checker): a class first declared by an elaborated-type-specifier `class-key identifier` that
;; is not a declaration of its own (`struct T { struct S *a; };`, `void f(struct S *p);`) is declared in the smallest
;; namespace or block scope that contains the declaration ([basic.scope.pdecl]/7.2, [dcl.type.elab]/3; a function
;; prototype's parameters and a class's members are neither), as GCC and clang declare it: opt/pr69483.C's `struct S b;`
;; then names the incomplete ::S. Before, the class's node, which the parser leaves among the members, declared T::S, and a
;; parameter's class was no class at all: the unit refused on "unknown type S".
(defn- cx-elab-target
  "Queue 505: the smallest namespace or block scope enclosing the scope `s` (a class's, template parameters', an
  enumeration's or a function type's parameters' scopes passed by)."
  [s]
  (loop [s s] (cond (nil? s) nil
                    (or (#{:class :tparams :enum} (:kind s)) (:fn-type s)) (recur (:parent s))
                    :else s)))

(defn- cx-elab-decl-scope
  "Queue 505 (the checker): the scope declare-class! enters the class node `n` in: for a node the parser marks :_elab-decl
  (a class first named by an elaborated-type-specifier of a declaration with declarators) declared in a class's scope,
  the smallest enclosing namespace or block scope (cx-elab-target); else `scope`."
  [scope n]
  (or (when (and (checking?) (:_elab-decl n) (not (:completeDefinition n)) (#{:class :tparams} (:kind scope)))
        (cx-elab-target scope))
      scope))

(defn- cx-elab-declare!
  "Queue 505 (the checker): the type of the elaborated-type-specifier form `f` ((cpp/elaborated KEY NAME)) whose name
  lookup in `scope` found nothing (`e`, the refusal): with `struct`, `class` or `union` and a plain identifier, while the
  main file's declarations are entered (*main-retry*), the class declared in the smallest enclosing namespace or block
  scope ([basic.scope.pdecl]/7.2), incomplete, and its type; else nil."
  [scope f e]
  (let [[_ kw nm] f]
    ;; (cpp-small: also in a function's body, a block scope, as in a template argument `ft<struct a*, 0>(0)`, cpp0x/decltype29.C)
    (when (and (checking?) (or *main-retry* (#{:block :fn} (:kind (cx-elab-target scope)))) (= :type (:codegen/refused (ex-data e)))
               (#{'struct 'class 'union} kw) (symbol? nm) (re-matches #"[A-Za-z_][A-Za-z_0-9]*" (str nm)))
      (when-let [s (cx-elab-target scope)]
        (declare-class! s {:kind "CXXRecordDecl" :tagUsed (str kw) :name (str nm)})
        (resolve-type-form scope nm)))))

(defn- placeholder-split
  "cpp-s11: a parameter's type as written with a placeholder ([dcl.spec.auto]: `auto`, `C auto`, `C<A...> auto`, cv and
  declarator operators around it, `auto...`): [before the type-constraint, the type-constraint's text or nil, after
  `auto`], or nil when it has none (decltype(auto) is none: a parameter may not be declared with it)."
  [^String qt]
  (let [m (re-matcher #"\bauto\b" qt)]
    (when (.find m)
      (let [j (.start m) e (.end m)]
        (when-not (re-find #"decltype\s*\(\s*$" (subs qt 0 j))
          (let [k (loop [k j] (if (and (pos? k) (Character/isWhitespace (.charAt qt (dec k)))) (recur (dec k)) k))
                ;; (a type-constraint's template arguments, balanced back to their `<`)
                k2 (if (and (pos? k) (= \> (.charAt qt (dec k))))
                     (loop [i (- k 2) d 1]
                       (cond (neg? i) nil
                             (= \> (.charAt qt i)) (recur (dec i) (inc d))
                             (= \< (.charAt qt i)) (if (= d 1) i (recur (dec i) (dec d)))
                             :else (recur (dec i) d)))
                     k)
                cs (when k2 (loop [i k2] (if (and (pos? i) (let [c (.charAt qt (dec i))] (or (Character/isLetterOrDigit c) (= c \_) (= c \:)))) (recur (dec i)) i)))
                c (when (and cs (< (long cs) (long k))) (str/trim (subs qt cs k)))
                ;; (cv-qualifiers are no type-constraint: `const auto&`)
                c (when (and c (not (re-matches #"(?:const|volatile)" c))) c)]
            [(subs qt 0 (if c cs j)) c (subs qt e)]))))))

(defn- abbreviated-template
  "cpp-s11: an abbreviated function template ([dcl.fct]/22): a function declaration with a placeholder in a parameter's
  type is a function template with an invented type template parameter for each, after the declared ones (a pack for
  `auto...`), the placeholder's type-constraint the invented parameter's ([temp.param]/4: `C<A...> auto` the immediately-
  declared constraint C<P, A...>). The node `n` (a function declaration, or a FunctionTemplateDecl whose function has
  such parameters) as the FunctionTemplateDecl it declares, or nil when it has none. <bits/ranges_util.h>'s
  subrange(__convertible_to_non_slicing<_It> auto __i, _Sent __s) had been dropped (\"type form (constrained ...)\"), so
  <format>'s _Utf32_view<subrange<iterator>>({__first, __last}) found no constructor."
  [n]
  (let [fkinds #{"FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXConversionDecl"}
        [wrap f] (cond (fkinds (:kind n)) [nil n]
                       (= "FunctionTemplateDecl" (:kind n)) [n (first (filter #(fkinds (:kind %)) (kids n)))]
                       :else [nil nil])
        pn (when f (param-nodes f))]
    (when (some #(placeholder-split (str (get-in % [:type :qualType]))) pn)
      (let [inv (atom 0) tps (atom [])
            fqt (atom (str (get-in f [:type :qualType]))) at (atom (max 0 (long (or (str/index-of @fqt "(") 0)))) ok (atom true)
            pn2 (mapv (fn [p]
                        (let [qt (str (get-in p [:type :qualType]))]
                          (if-let [[pre c post] (placeholder-split qt)]
                            (let [nm (str "__auto_" (swap! inv inc))
                                  nqt (str pre nm post)
                                  i (str/index-of @fqt qt (long @at))]
                              (if i
                                (do (reset! fqt (str (subs @fqt 0 i) nqt (subs @fqt (+ (long i) (count qt)))))
                                    (reset! at (+ (long i) (count nqt))))
                                (reset! ok false))
                              (swap! tps conj (cond-> {:kind "TemplateTypeParmDecl" :name nm :inner [] :isImplicit true}
                                                (re-find #"\.\.\.\s*$" post) (assoc :isParameterPack true)
                                                c (assoc :_tc (vec (remove str/blank? (str/split (str/replace c #"\s*<.*$" "") #"\s*::\s*")))
                                                         :_tcargs (boolean (str/includes? c "<")) :_tctext c)))
                              (assoc-in p [:type :qualType] nqt))
                            p)))
                      pn)]
        (when @ok
          (let [pi (atom -1)
                f2 (-> f
                       (assoc-in [:type :qualType] @fqt)
                       (assoc :inner (mapv #(if (= "ParmVarDecl" (:kind %)) (nth pn2 (swap! pi inc)) %) (:inner f))))]
            (if wrap
              (assoc wrap :inner (let [ks (:inner wrap)
                                       last-tp (long (or (last (keep-indexed (fn [i k] (when (#{"TemplateTypeParmDecl" "NonTypeTemplateParmDecl" "TemplateTemplateParmDecl"} (:kind k)) i)) ks)) -1))]
                                   (vec (concat (take (inc last-tp) ks) @tps
                                                (map #(if (identical? % f) f2 %) (drop (inc last-tp) ks))))))
              (cond-> {:kind "FunctionTemplateDecl" :name (:name f) :inner (conj @tps f2) :_b (:_b f) :_abbreviated true}
                (:range f) (assoc :range (:range f))
                (:_e f) (assoc :_e (:_e f))))))))))

(defn- declare-node*!
  [scope n]
  (let [n (or (abbreviated-template n) n)]
  (if-let [r (when-let [h (:declare @hooks)] (h scope n))]
    r
  (case (:kind n)
    "NamespaceDecl" (let [s (ns-scope! scope (:name n) (nil? (:name n)))]
                      ;; (queue 487, the checker: a namespace a header opens, cx-ns-lacks?)
                      (when (and *cx-hdr-ns* (header-node? n)) (.put ^java.util.IdentityHashMap *cx-hdr-ns* (:names s) true))
                      ;; (cpp-rt-own2: GNU's abi_tag on a namespace, the implicit tags of the functions whose return type uses it,
                      ;; abi's fn-abi-tags: <c++config.h>'s `inline namespace __cxx11 __attribute__((__abi_tag__ ("cxx11")))`)
                      ;; (the native parser's :_abi-tags)
                      (when-let [tags (and abi/*ns-tags* (:name n) (not-empty (:_abi-tags n)))]
                        (swap! abi/*ns-tags* update (:path s) #(vec (sort (distinct (concat % tags))))))
                      ;; an inline namespace's members are members of the enclosing one too ([namespace.def]/7; G4:
                      ;; std::__cxx11)
                      (when (and (:isInline n) (:name n))
                        ;; (CP338 (a): marked inline for argument-dependent lookup, adl-nss)
                        (.put ^java.util.HashMap (:names s) " inline" [])
                        (let [^java.util.ArrayList us (:usings scope)] (when-not (some #(identical? % s) us) (.add us s))))
                      (doseq [k (kids n)] (declare-node! s k)))
    "LinkageSpecDecl" (let [s (assoc scope :extern-c (= "C" (:language n)))] (doseq [k (kids n)] (declare-node! s k)))
    ("FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXDestructorDecl" "CXXConversionDecl") (declare-fn! scope n)
    "VarDecl" (declare-var! scope n :global)
    "CXXRecordDecl" (declare-class! scope n)
    "EnumDecl" (declare-enum! scope n)
    ("TypedefDecl" "TypeAliasDecl")
    (let [qt (get-in n [:type :qualType])
          la (some-> *last-anon* deref)]
      ;; (queue 383: a header's typedef names its type, [temp.inst]/2: std::string declared in the headers' first pass, so
      ;; that <bits/locale_facets.h>'s numpunct<char>, instantiated there, keeps its `virtual string do_grouping() const`,
      ;; dropped as "unknown type string" until the retry had declared the typedef -- its vtable a slot short)
      (binding [*name-only* (and (not (checking?)) (= "TypedefDecl" (:kind n)) (header-node? n))]
      (enter! scope (:name n)
              (cond-> {:e :type
                       ;; (a typedef or alias declaration's name: a dependent expression's qualifier written with it is
                       ;; mangled as written, an unresolved-qualifier-level <simple-id>, not as the type it names; clang's
                       ;; mangleUnresolvedTypeOrSimpleId, Itanium 5.1.5.3's <unresolved-name>; the template's arguments
                       ;; there as in libstdc++'s std::pair `_PCCP::template _MoveConstructiblePair<_U1, _U2>()`)
                       :typedef true
                       :ty (if (and la (abi/class? la) (= qt (str (or (second (re-find #"^(struct|class|union) " (str qt))) "") " " (:name n)))
                                    (nil? (:name (abi/cls (:id la))))
                                    ;; (typedef struct { ... } T: the unnamed class named T for linkage, [dcl.typedef]/9;
                                    ;; the parser spells it `struct T` as clang does; CP280 (a); the class defined in this
                                    ;; declaration: its text holds the body)
                                    (re-find #"^\s*typedef\s+(?:struct|class|union)\s*(?:__attribute__\s*\(\(.*?\)\)\s*)?\{" (or (node-text n) ""))
                                    (empty? (filter #(= :type (:e %)) (own-names scope (:name n)))))
                             ;; (queue 367: and the name its mangling takes, as the enumeration's and the `own` case's below:
                             ;; musl's `typedef struct { ... } pthread_mutex_t`, __basic_file<char>'s __c_lock*, P15pthread_mutex_t,
                             ;; had been mangled as an empty name, P0)
                             (do (when-not (checking?) (abi/update-cls! (:id la) assoc :name (:name n))) la)
                             ;; `typedef enum { ... } E;` ([dcl.typedef]/9, the typedef name for linkage): the parser writes the
                             ;; type as `enum E`, the unnamed enumeration or class just declared (G5c: unwind.h's
                             ;; _Unwind_Reason_Code); it takes the name for its mangling
                             ;; (only when the written type names nothing else: `typedef struct X X;` of a named X resolves)
                             (let [t0 (try (resolve-type scope qt) (catch arbace.lang.ExceptionInfo e (if (:codegen/refused (ex-data e)) nil (throw e))))
                                   own (when-let [[_ nm] (when-not t0 (re-matches #"(?:enum|struct|union|class) (\S+)" (str qt)))]
                                         (when (and (= nm (:name n)) la)
                                           (let [t la]
                                             (cond (= :enum (:k t)) (when-not (:name (get @abi/*enums* (:id t))) (swap! abi/*enums* assoc-in [(:id t) :name] nm) t)
                                                   (abi/class? t) (when-not (:name (abi/cls (:id t))) (abi/update-cls! (:id t) assoc :name nm) t)))))]
                               (mode-type n (or t0 own
                                                (try (resolve-type scope qt)
                                                     ;; (CP332 (a), the checker: __type_pack_element's index refused, the error
                                                     ;; reported in the analysis' order at the alias, the declaration going on)
                                                     (catch arbace.lang.ExceptionInfo x
                                                       (if (and (checking?) (= :pack-element (:codegen/refused (ex-data x))))
                                                         (do (swap! *order* conj [:cx-error (ex-info (.getMessage x) (update (ex-data x) :cx/node #(or % n)))])
                                                             abi/int*)
                                                         (throw x))))))))
                       :pos (long (or (:_b n) 0))}
                ;; (CX12, the checker: a member typedef's access)
                (and (checking?) (= :class (:kind scope)) *member-access*) (assoc :access *member-access*))))
      (cx-typedef-redecl! scope n))
    "NamespaceAliasDecl" (let [t (node-text n)
                               [_ target] (re-find #"=\s*([^;]+);?\s*$" (or t ""))
                               parts (vec (map str/trim (remove str/blank? (str/split (str/trim target) #"::"))))
                               e (first (filter #(= :ns (:e %)) (lookup-qualified scope parts)))]
                           (enter! scope (:name n) (assoc e :pos (long (or (:_b n) 0)))))
    "UsingDirectiveDecl" (let [t (node-text n)
                               [_ target] (re-find #"namespace\s+([^;]+);?\s*$" (or t ""))
                               parts (vec (map str/trim (remove str/blank? (str/split (str/trim target) #"::"))))
                               e (first (filter #(= :ns (:e %)) (lookup-qualified scope parts)))]
                           (when (System/getenv "CPP_LOOKUP_TRACE") (binding [*out* *err*] (println "using" (pr-str t) parts (:path (:scope e)) (count (:names (:scope e))) (System/identityHashCode (:names (:scope e))))))
                           ;; (queue 487, the checker: the directive's position, cx-udir-visible?)
                           (when (and *cx-udir-pos* (:scope e))
                             (let [^java.util.IdentityHashMap m *cx-udir-pos*]
                               (when-not (.containsKey m (:usings scope)) (.put m (:usings scope) (java.util.IdentityHashMap.)))
                               (let [^java.util.IdentityHashMap mm (.get m (:usings scope))]
                                 (when-not (.containsKey mm (:names (:scope e))) (.put mm (:names (:scope e)) (long (or (:_b n) 0)))))))
                           ;; (cpp-decl2: a namespace no declaration made nominates nothing: `using namespace std;` with no
                           ;; header, lookup/missing-std-include-7.C, had added nil)
                           (when (:scope e) (.add ^java.util.ArrayList (:usings scope) (:scope e))))
    ;; (a using-declaration naming a dependent base's member, resolved in the specialization: G4)
    ("UsingDecl" "UnresolvedUsingValueDecl" "UnresolvedUsingTypenameDecl")
                ;; (cpp-s15, CP392 (a): its tokens as the preprocessor gave them when the parser kept them, a macro's
                ;; expansion where its name stands: <vector>'s `using _GLIBCXX_STD_C::vector;`)
                (let [t (or (:_text n) (node-text n))
                      [_ target] (or (re-find #"using\s+(?:typename\s+)?([^;]+);?\s*$" (or t ""))
                                     ;; (cpp-singles: an access declaration, the using-declaration without its keyword, `C::x;`)
                                     (re-find #"^\s*([^;\s][^;]*);?\s*$" (or t "")))
                      ;; (cpp-s4: a pack expansion, `using _Build_FUN<_Ind, _Tp, _Ti>::_S_fun...;` of variant's _Build_FUNs,
                      ;; [namespace.udecl]/1, [temp.variadic]/5: the declaration once per element of the packs its qualifier
                      ;; names, the members each one finds together)
                      pack? (or (str/ends-with? (str/trim target) "...") (boolean (re-find #"^\s*\.\.\." (or (text-after n 16) ""))))
                      target (if (str/ends-with? (str/trim target) "...") (subs (str/trim target) 0 (- (count (str/trim target)) 3)) target)
                      ;; (cpp-rt-own: split outside template argument lists, split-scope's: <functional>'s `using
                      ;; _Mem_fn_base<_Tp _Class::*>::_Mem_fn_base;`, whose `_Class::*` had cut the name, its constructors not inherited)
                      parts (vec (map str/trim (remove str/blank? (split-scope (str/trim target)))))
                      gq? (str/starts-with? (str/trim target) "::")
                      es (if pack?
                           (if-let [ss (when-let [h (:pack-scopes @hooks)]
                                         (h scope (distinct (re-seq #"[A-Za-z_][A-Za-z_0-9]*" (str/join " " (butlast parts))))))]
                             (vec (distinct (mapcat #(lookup-qualified % parts gq?) ss)))
                             (lookup-qualified scope parts gq?))
                           (lookup-qualified scope parts gq?))]
                  ;; (cpp-singles, the checker: [namespace.udecl]/3, in a class template's specialization a using-declaration's (or an
                  ;; access declaration's) nested-name-specifier names a base class: one naming another class is GCC's "type 'X' is
                  ;; not a base type for type 'C<void>'", at the declaration, as at its instantiation -- template/crash13.C's `X::Y;`
                  ;; over `typedef typename A<T>::B X;` -- the non-template classes diag.ae's using-and-consteval-overrides')
                  (when-let [cid (and (checking?) (:cls scope) (not (header-node? n)) (>= (count parts) 2) (not gq?)
                                      (:targs (abi/cls (:cls scope))) (:cls scope))]
                    (when-let [q (try (let [t (resolve-type scope (str/join "::" (butlast parts)))] (when (abi/class? (abi/unq t)) (:id (abi/unq t))))
                                      (catch arbace.lang.ExceptionInfo _ nil))]
                      (when (and (not= q cid) (not (abi/derived-from? cid q)) (:complete (abi/cls q))
                                 ;; (and no base the specialization dropped, an incomplete one: cpp1z/class-deduction69.C)
                                 (not (:cx-inst-refused (abi/cls cid)))
                                 ;; (C++20's P1099: a using-declarator naming an enumerator needs no base)
                                 (not (and (>= (long *cxx-year*) 20) (seq es) (every? #(= :enumerator (:e %)) es))))
                        (swap! *order* conj [:cx-error (ex-info (str "codegen: type '" (:name (abi/cls q)) "' is not a base type for type '" (:name (abi/cls cid)) "'")
                                                                {:codegen/refused :using :cx/node n})]))))
                  ;; (the rest of CP313 (a): a using-declaration names its members with their access where they were found,
                  ;; [namespace.udecl]/19, and gives them its own as members of its class, [class.access]/... ; enumerators
                  ;; and types alone, the others keep their own)
                  (when (and (checking?) (not (header-node? n)))
                    (doseq [e es :when (and (:ucls e) (#{:enumerator :type} (:e e)))]
                      (try (cx-access! {:scope scope} (:ucls e) (last parts) (:uaccess e) nil nil)
                           (catch arbace.lang.ExceptionInfo x
                             (swap! *order* conj [:cx-error (ex-info (.getMessage x) (assoc (ex-data x) :cx/node n))]))))
                    ;; (CP324 (a): a class's using-declaration of member functions, [namespace.udecl]/19: each function it
                    ;; names accessible where it is (its own access, or a using-declaration's that named it), not a
                    ;; constructor's)
                    (when (:cls scope)
                      (when-let [x (first (keep (fn [e]
                                                  (when (= :fn (:e e))
                                                    (let [f (fnd (:id e))]
                                                      (when (and (:cls f) (not= :ctor (:kind f)))
                                                        (try (if (:ucls e)
                                                               (cx-access! {:scope scope} (:ucls e) (last parts) (:uaccess e) nil nil)
                                                               (cx-access! {:scope scope} (:cls f) (last parts) (:access f) nil nil))
                                                             nil
                                                             (catch arbace.lang.ExceptionInfo x x))))))
                                                es))]
                        (swap! *order* conj [:cx-error (ex-info (.getMessage ^Throwable x) (assoc (ex-data x) :cx/node n))]))))
                  ;; (CP323 (a): `using B::B;` inherits B's constructors, [namespace.udecl]/3 and [class.inhctor.init]: the
                  ;; class marked with the bases' names, their constructors candidates of its initializations, ctor-init)
                  (when (and (:cls scope) (>= (count parts) 2)
                             (= (last parts) (str/trim (str/replace (nth parts (- (count parts) 2)) #"<.*$" ""))))
                    (abi/update-cls! (:cls scope) update :inherits-ctors (fnil conj #{}) (last parts))
                    ;; (queue 509, the checker: the using-declaration's node, where cx-inherited-deleted! reports)
                    (when (checking?) (abi/update-cls! (:cls scope) assoc-in [:cx-inh-nodes (last parts)] n))
                    ;; (cpp-s4: the base named through a typedef or an alias, `using _Base::_Base;` of variant's
                    ;; _Move_assign_base and the rest, [class.qual]/2: the constructors of the class it names)
                    (when-let [bn (try (let [t (resolve-type scope (str/join "::" (butlast parts)))]
                                         (when (abi/class? t) (:name (abi/cls (:id t)))))
                                       (catch arbace.lang.ExceptionInfo _ nil))]
                      (abi/update-cls! (:cls scope) update :inherits-ctors conj bn)
                      (when (checking?) (abi/update-cls! (:cls scope) assoc-in [:cx-inh-nodes bn] n))))
                  (doseq [e es
                          ;; (cpp-decl2, the checker: a base member hidden by the class's own declared before the using-declaration,
                          ;; [namespace.udecl]/14, cx-udecl-hide!'s rule in the other order)
                          :when (not (and (checking?) (:cls scope) (= :fn (:e e))
                                          (let [g (fnd (:id e))
                                                rq (fn [x] (some-> (:trailingRequiresClause x) node-text (str/replace #"\s+" "")))]
                                            (and g (some (fn [o] (and (= :fn (:e o)) (not (:ucls o))
                                                                      (let [h (fnd (:id o))]
                                                                        (and h (= (:cls h) (:cls scope)) (not= (:cls g) (:cls h))
                                                                             (same-sig? g h) (= (rq (:node g)) (rq (:node h)))))))
                                                         (.get ^java.util.HashMap (:names scope) (last parts)))))))]
                    (enter! scope (last parts) (cond-> (assoc e :pos (long (or (:_b n) 0)))
                                                             (and (checking?) (:cls scope) (#{:enumerator :type} (:e e)))
                                                             (assoc :ucls (:cls scope) :uaccess (or *member-access* :public))
                                                             ;; (CP324 (a): a member function's synonym has the using-declaration's
                                                             ;; access as a member of its class, [namespace.udecl]/19)
                                                             ;; (cpp-rt-own3, DECISION 510-1 (a): and the code generator's, for queue 510's
                                                             ;; implicit object parameter of a using-declared member)
                                                             (and (:cls scope) (= :fn (:e e)) (:cls (fnd (:id e))))
                                                             (assoc :ucls (:cls scope) :uaccess (or *member-access* :public))))))
    ;; (cpp-s12: `using enum E;`, [enum.udecl]/2: E's enumerators declared in the scope as by using-declarations, at
    ;; namespace, class or block scope; <bits/unicode.h>'s _Grapheme_cluster_iterator::_M_is_break, f8's)
    "UsingEnumDecl" (let [t (node-text n)
                          [_ target] (re-find #"using\s+enum\s+([^;]+?)\s*;?\s*$" (or t ""))
                          et (when target (abi/unq (resolve-type scope target)))]
                      (when-not (abi/enum? et) (fail :decl "using enum of a non-enumeration " (pr-str target)))
                      (doseq [[nm es] (:names (:scope (abi/enm (:id et)))) e es]
                        (enter! scope nm (cond-> (assoc e :pos (long (or (:_b n) 0)))
                                           (and (checking?) (:cls scope)) (assoc :ucls (:cls scope) :uaccess (or *member-access* :public))))))
    ;; (CX12, the checker: a namespace-scope static_assert of the main file checked in the analysis' order)
    "StaticAssertDecl" (when (and (checking?) (not (header-node? n)))
                         (cond
                           (= :ns (:kind scope)) (swap! *order* conj [:sassert {:node n :scope scope}])
                           ;; (cpp-indep: a member-declaration's static_assert, [class.mem.general]/1 with [dcl.pre]/10, of a class
                           ;; that is no template's pattern -- a class's, or a class template's specialization for arguments with no
                           ;; dependent part, [temp.inst]/3 -- checked in order too, its failure alone judged as a function template
                           ;; specialization's: cpp0x/static_assert1.C's `class X`, static_assert2.C's accept_evens<1>)
                           (and (= :class (:kind scope)) (:cls scope)
                                (let [c (abi/cls (:cls scope))]
                                  (and c (not (:header c))
                                       ;; (a specialization's scope binds its parameters; any other class under a template's
                                       ;; parameters is a pattern's)
                                       (or (:tmpl c)
                                           (not (loop [s scope k 0] (when (and s (< k 64)) (or (= :tparams (:kind s)) (recur (:parent s) (inc k)))))))
                                       (not-any? #(and (map? %) (#{:tparam :tparam-v :ttp :dep :tdep :texpr :auto :pack-exp} (:k %)))
                                                 (tree-seq coll? seq (:targs c))))))
                           (swap! *order* conj [:sassert {:node n :scope scope :member true}])
                           :else nil))
    ("EmptyDecl" "AccessSpecDecl" "FriendDecl") nil
    (if (str/ends-with? (str (:kind n)) "Attr") nil (fail :decl "declaration " (:kind n)))))))

;; ---------------------------------------------------------------------------------------------
;; Classes completed: special members, virtual functions

(defn- user-ctors [id] (filter #(not (:implicit (fnd %))) (:ctors (abi/cls id))))
(defn- copy-ctor? [f id]
  (let [ps (:ps (:ty f))] (and (= :ctor (:kind f)) (= 1 (count ps)) (abi/ref? (first ps)) (= :ref (:k (first ps))) (= id (:id (abi/unq (:to (first ps))))))))
(defn- move-ctor? [f id]
  (let [ps (:ps (:ty f))] (and (= :ctor (:kind f)) (= 1 (count ps)) (= :rref (:k (first ps))) (= id (:id (abi/unq (:to (first ps))))))))
(defn- copy-assign? [f id]
  (let [ps (:ps (:ty f))] (and (= "operator=" (:name f)) (= 1 (count ps)) (= :ref (:k (first ps))) (= id (:id (abi/unq (:to (first ps))))))))
(defn- move-assign? [f id]
  (let [ps (:ps (:ty f))] (and (= "operator=" (:name f)) (= 1 (count ps)) (= :rref (:k (first ps))) (= id (:id (abi/unq (:to (first ps))))))))
(defn- class-like-members [id]
  (concat (map :cls (:bases (abi/cls id)))
          (keep (fn [f] (let [t (loop [t (:ty f)] (if (abi/arr? t) (recur (:of t)) t))] (when (abi/class? t) (:id t)))) (:fields (abi/cls id)))))

(defn trivial-dtor? [id]
  (let [c (abi/cls id) d (when (:dtor c) (fnd (:dtor c)))]
    (and (or (nil? d) (and (:implicit d) (:trivial d)) (and (:defaulted d) (not (:virtual d)) (:trivial d)))
         (or (nil? d) (not (:virtual d))))))

(defn trivial-copy? [id]
  (let [c (abi/cls id)]
    (and (not (abi/dynamic? id))
         (every? #(let [f (fnd %)] (or (not (copy-ctor? f id)) (and (or (:implicit f) (:defaulted f)) (:trivial f)))) (:ctors c))
         (every? trivial-copy? (class-like-members id)))))

;; queue 378 (the main host's review of 351, item 1): the Itanium C++ ABI's "non-trivial for the purposes of calls" (§3.1.2.1, the
;; psABI's MEMORY class for such a type: passed by address), as clang's Sema::canPassInRegisters decides it: every copy constructor,
;; move constructor and the destructor that is not deleted is trivial, and one copy or move constructor is not deleted. A move
;; constructor is trivial when implicit or defaulted and the moves of the bases and members are ([class.copy.ctor]/11); the implicit
;; one is declared when the class declares no copy or move member and no destructor ([class.copy.ctor]/8), which codegen's analysis
;; does not make an entity of, so it is judged here; a member's move is its move constructor's, or its copy constructor's when it
;; has none.

(declare move-trivial?)

(defn- implicit-move?
  "Whether the class `id` has an implicitly declared move constructor ([class.copy.ctor]/8)."
  [id]
  (let [c (abi/cls id)]
    (and (not-any? #(let [g (fnd %)] (and (not (:implicit g)) (or (copy-ctor? g id) (move-ctor? g id)))) (:ctors c))
         (not-any? #(let [g (fnd %)] (and (not (:implicit g)) (or (copy-assign? g id) (move-assign? g id)))) (:methods c))
         (let [d (:dtor c)] (or (nil? d) (:implicit (fnd d)))))))

(defn- members-move-trivial? [id] (and (not (abi/dynamic? id)) (every? move-trivial? (class-like-members id))))

(defn move-trivial?
  "Whether the constructor that moves an object of the class `id` is trivial: its declared move constructors defaulted (and the
  bases' and members' moves trivial), else its implicit one's, else (no move constructor) its copy constructor's."
  [id]
  (let [c (abi/cls id)
        mv (filter #(let [g (fnd %)] (and (move-ctor? g id) (not (:implicit g)))) (:ctors c))]
    (cond (seq mv) (every? #(let [g (fnd %)] (and (:defaulted g) (not (:deleted g)) (members-move-trivial? id))) mv)
          (implicit-move? id) (members-move-trivial? id)
          :else (trivial-copy? id))))

(defn trivial-for-call?
  "Queue 378: the class `id` trivial for the purposes of calls (Itanium C++ ABI §3.1.2.1, clang's canPassInRegisters): passed in
  registers when the psABI classifies it so, else by address."
  [id]
  (let [c (abi/cls id)
        cs (map fnd (:ctors c))
        live? (fn [g] (not (:deleted g)))
        copies (filter #(copy-ctor? % id) cs)
        moves (filter #(and (move-ctor? % id) (not (:implicit %))) cs)
        imove (implicit-move? id)]
    (and (not (abi/dynamic? id))
         (every? #(or (not (live? %)) (and (or (:implicit %) (:defaulted %)) (:trivial %))) copies)
         (every? #(or (not (live? %)) (and (:defaulted %) (members-move-trivial? id))) moves)
         (or (not imove) (members-move-trivial? id))
         (trivial-dtor? id)
         (boolean (or (some live? copies) (some live? moves) imove)))))

(defn call-memory?
  "Queue 378: a class trivial for calls that holds a base or a member (an array's element) that is not, at any depth: the psABI's
  MEMORY class (clang's X86_64ABIInfo::classify gives such a member's eightbytes MEMORY), passed on the stack (byval)."
  [id]
  (boolean (some #(or (not (trivial-for-call? %)) (call-memory? %)) (class-like-members id))))

(defn- trivial-assign?
  "cpp-s3: the class's copy and move assignments trivial ([class.copy.assign]/9) as far as trivial-copy? does not tell:
  no user-provided one, its bases' and members' trivial too. (An implicit or defaulted assignment over a member whose
  operator= is user-provided is a call of it, not a copy of the bytes: explicit-obj-default2.C's S over A.)"
  [id]
  (and (not (abi/dynamic? id))
       (not-any? #(let [f (fnd %)] (and (or (copy-assign? f id) (move-assign? f id)) (not (or (:implicit f) (:defaulted f)))))
                 (:methods (abi/cls id)))
       (every? trivial-assign? (class-like-members id))))

(defn- implicit-fn! [id k nm ty & {:as more}]
  (let [fid (next-id)
        c (abi/cls id)
        f (merge {:id fid :name nm :kind k :cls id :ty ty :implicit k :inline true :path (conj (vec (:path c)) [:cls id])
                  :scope (:scope c) :def-scope (:scope c) :linkage :cpp :param-names (mapv (fn [_] nil) (:ps ty)) :defaults [] :pos -1}
                 ;; (queue 351: an internal class's implicit members are internal, as its declared ones, [basic.link]/4)
                 (when (:internal (:scope c)) {:internal true})
                 ;; a header class's implicit members analyzed when used (G4)
                 (when (:header c) {:lazy true})
                 more)]
    (swap! *fns* assoc fid f)
    (enter! (:scope c) (case k :ctor " ctor" :dtor " dtor" nm) {:e :fn :id fid :pos -1})
    (case k
      :ctor (abi/update-cls! id update :ctors (fnil conj []) fid)
      :dtor (abi/update-cls! id assoc :dtor fid)
      nil)
    (abi/update-cls! id update :methods (fnil conj []) fid)
    (swap! *order* conj [:fn fid])
    fid))

(defn- has-ctor-of? [id pred] (some #(pred (fnd %) id) (:ctors (abi/cls id))))

(defn- default-ctor-nontrivial?
  "Whether a base's or member's class `bid` makes its owner's default constructor non-trivial ([class.default.ctor]/3): its own
  default constructor not trivial, or (cpp-rt-own2) none that is no template, as clang's hasTrivialDefaultConstructor (a class
  whose default constructor is a template's specialization, <tuple>'s tuple(), has none: user-provided): unique_ptr's
  __uniq_ptr_impl() = default over its tuple<pointer, _Dp> _M_t, non-trivial, clang's __uniq_ptr_data<...>::__uniq_ptr_data()
  called after the zeroing of unique_ptr() : _M_t()."
  [bid]
  (let [zs (filter #(empty? (:ps (:ty (fnd %)))) (:ctors (abi/cls bid)))]
    (or (empty? zs) (some #(not (:trivial (fnd %))) zs))))

;; (cpp-1123, the checker: [class.copy.assign]/7.2-7.3, a defaulted copy or move assignment operator of a class with a
;; non-static data member of const non-class type (or an array of it) or of reference type is defined as deleted;
;; [class.copy.ctor]/10.1, a defaulted copy constructor of a class with a member of rvalue reference type. GCC reports
;; the reason at the class where it implicitly defines the member ("non-static const member ..., cannot use default
;; assignment operator", "copying non-static data member ... of rvalue reference type"), cx-deleted-implicit!'s place,
;; and the use as "use of deleted function": cpp0x/defaulted17.C, cpp0x/rv-copy1.C)
(defn- cx-member-deleting
  "The first non-static data member of the class `id` that deletes its implicit copy assignment (`k` :assign: a const
  non-class or a reference member) or copy constructor (`k` :copy: an rvalue reference member), as \"'T C::m'\", or nil."
  [id k]
  (let [c (abi/cls id)]
    (when-not (:lambda c)
      (some (fn [fl]
              (let [t (loop [t (:ty fl)] (if (abi/arr? t) (recur (:of t)) t))]
                (when (and t (not (:static fl)) (string? (:name fl))
                           (case k
                             :assign (or (abi/ref? (:ty fl)) (and (:c t) (not (abi/class? (abi/unq t)))))
                             :copy (= :rref (:k (:ty fl)))))
                  (str "member '" (:name fl) "'"))))
            (:fields c)))))

(defn finish-class!
  "A complete class: its virtual functions (declared or overriding), its implicit special members, its vtable."
  [id]
  (let [c (abi/cls id)
        t {:k :class :id id}
        cref (abi/lref (assoc t :c true))
        ;; overriders: a method of a base's virtual function's name and parameters is virtual
        base-virtuals (fn self [bid] (let [b (abi/cls bid)] (concat (:virtuals b) (mapcat #(self (:cls %)) (:bases b)))))
        bv (mapcat #(base-virtuals (:cls %)) (:bases c))]
    (doseq [mid (:methods c)]
      (let [f (fnd mid)]
        (when (and (not (:virtual f)) (#{:method :dtor} (:kind f))
                   (some #(let [g (fnd %)] (and (= (:kind g) (:kind f)) (or (= :dtor (:kind f)) (and (= (:name g) (:name f)) (= (:cq g) (:cq f)) (= (mapv abi/unq (:ps (:ty g))) (mapv abi/unq (:ps (:ty f)))))))) bv))
          (upd-fn! mid assoc :virtual true)
          (abi/update-cls! id update :virtuals (fnil conj []) mid))))
    ;; (cpp-decl2, the checker: [class.virtual]/18 (C++23 /20), a function with a deleted definition overrides none without
    ;; one and one without a deleted definition overrides none with one: GCC's "non-deleted function 'virtual void D::f()'
    ;; overriding deleted function", "deleted function ... overriding non-deleted function", at the overrider; the written
    ;; deletions alone, cpp0x/defaulted2.C)
    (when (and (checking?) *on-refusal*)
      (doseq [mid (:methods c)
              :let [f (fnd mid)]
              :when (and (= :method (:kind f)) (:node f) (not (:implicit f)) (not (header-node? (:node f))))
              :let [g (some #(let [g (fnd %)] (when (and (= :method (:kind g)) (= (:name g) (:name f)) (= (boolean (:cq g)) (boolean (:cq f)))
                                                         (= (mapv abi/unq (:ps (:ty g))) (mapv abi/unq (:ps (:ty f)))))
                                                g))
                            bv)]
              :when (and g (not= (boolean (:deleted-sure f)) (boolean (:deleted-sure g))) (= (boolean (:deleted f)) (boolean (:deleted-sure f)))
                         (= (boolean (:deleted g)) (boolean (:deleted-sure g))))]
        (*on-refusal* (ex-info (str "codegen: " (if (:deleted-sure f) "deleted" "non-deleted") " function '" (:name f) "' overriding "
                                    (if (:deleted-sure g) "deleted" "non-deleted") " function")
                               {:codegen/refused :virtual :cx/node (:node f)})
                      (:node f))))
    ;; the destructor
    (let [members (class-like-members id)
          d (:dtor (abi/cls id))
          ;; [class.dtor]/8: trivial unless virtual or a base's or member's is not (a vptr alone does not make it so)
          nontriv (some #(not (trivial-dtor? %)) members)]
      (cond
        (nil? d) (let [virt (some #(let [b (abi/cls (:cls %))] (and (:dtor b) (:virtual (fnd (:dtor b))))) (:bases c))
                       fid (implicit-fn! id :dtor (str "~" (:name c)) {:k :fn :ret abi/void :ps [] :va false}
                                         :trivial (not (or nontriv virt)) :virtual (boolean virt))]
                   (when virt (abi/update-cls! id update :virtuals (fnil conj []) fid)))
        (:defaulted (fnd d)) (upd-fn! d assoc :trivial (not (or nontriv (:virtual (fnd d)))))
        :else nil))
    ;; the default constructor
    ;; (queue 510, the checker: a user-declared constructor template is a user-declared constructor too, [class.default.ctor]/1:
    ;; cpp1z/inh-ctor22.C's `struct B1 { template <class... Ts> B1(int, Ts...) { } };` has no default constructor; the main
    ;; file's classes only. cpp-rt-own3, the code generator: none when the class declares a constructor template, every class.
    ;; Each mode keeps the rule its records were made with.)
    (when (and (empty? (:ctors (abi/cls id)))
               (not (if (checking?)
                      (and (or (seq (:ctor-tmpls (abi/cls id))) (:cx-ctor-dropped (abi/cls id))) (not (:header (abi/cls id))))
                      (seq (:ctor-tmpls (abi/cls id))))))
      (let [nontriv (or (abi/dynamic? id) (some :init (:fields c))
                        (some default-ctor-nontrivial? (class-like-members id)))
            fid (implicit-fn! id :ctor (:name c) {:k :fn :ret abi/void :ps [] :va false} :trivial (not nontriv))]
        ;; (cpp-tzdb, the code generator: [class.default.ctor]/2.2, a member of reference type without a default member
        ;; initializer defines the implicit default constructor as deleted -- tzdb.cc's `struct quoted { string& str; ... }`,
        ;; whose definition had been analyzed, the reference default-initialized: "a non-const reference to a temporary".
        ;; The checker keeps the rule its records were made with)
        (when (and (not (checking?)) (not (:union c))
                   (some #(and (abi/ref? (:ty %)) (not (:init %))) (:fields c)))
          (upd-fn! fid assoc :deleted true))))
    ;; (cpp-rt-own2: and when a base's default constructor is inherited by a using-declaration and the class declares none of its
    ;; own, as clang's needsImplicitDefaultConstructor declares it (HasInheritedDefaultConstructor): unique_ptr's __uniq_ptr_data,
    ;; `using __uniq_ptr_impl<_Tp, _Dp>::__uniq_ptr_impl;` beside its defaulted move constructor, value-initialized by unique_ptr()
    ;; : _M_t(), clang's __uniq_ptr_data<...>::__uniq_ptr_data() C2Ev, not the inheriting constructor CI2 default-ctor-init had
    ;; called (fs_ops' unique_ptr<char[], (anonymous)::free_as_in_malloc>, its _Head_base<0, char*>() then unwritten))
    (when (and (not (checking?)) (seq (:inherits-ctors (abi/cls id)))
               (not-any? #(empty? (:ps (:ty (fnd %)))) (:ctors (abi/cls id)))
               (some (fn [b] (and (not (:virtual b)) (contains? (:inherits-ctors (abi/cls id)) (:name (abi/cls (:cls b))))
                                  (some #(let [g (fnd %)] (and (empty? (:ps (:ty g))) (not (:deleted g)))) (:ctors (abi/cls (:cls b))))))
                     (:bases c)))
      (let [nontriv (or (abi/dynamic? id) (some :init (:fields c))
                        (some default-ctor-nontrivial? (class-like-members id)))]
        (implicit-fn! id :ctor (:name c) {:k :fn :ret abi/void :ps [] :va false} :trivial (not nontriv))))
    (doseq [x (:ctors (abi/cls id))]
      (let [g (fnd x)] (when (and (:defaulted g) (empty? (:ps (:ty g))))
                         ;; (trivial only when its bases' and members' default constructors are: [class.default.ctor]/3;
                         ;; G4: std::vector() = default over _Vector_impl's user-provided one)
                         (upd-fn! x assoc :trivial (not (or (abi/dynamic? id) (some :init (:fields c))
                                                            (some default-ctor-nontrivial? (class-like-members id))))))))
    ;; the copy constructor and the copy assignment
    ;; CX12 (the checker): [class.copy.ctor]/6, [class.copy.assign]/2: a class that declares a move constructor or a move
    ;; assignment operator has its implicit copy constructor and copy assignment defined as deleted
    (let [moves (or (has-ctor-of? id move-ctor?) (some #(move-assign? (fnd %) id) (:methods (abi/cls id))))
          del (when (and moves (checking?)) {:deleted true :deleted-sure true :deleted-why "a user-declared move constructor or move assignment operator"})]
    ;; ([class.copy.ctor]/7, [class.copy.assign]/2: the implicit copy constructor's parameter is X& when a base or member
    ;; of class type M has copy constructors none of which takes a const M&, else const X&; the copy assignment's alike)
    (let [non-const? (fn [pred sel]
                       (some (fn [m] (let [cs (filter #(pred (fnd %) m) (sel (abi/cls m)))]
                                       (and (seq cs) (not-any? #(:c (:to (first (:ps (:ty (fnd %)))))) cs))))
                             (class-like-members id)))
          ctor-p (if (non-const? copy-ctor? :ctors) (abi/lref t) cref)
          assign-p (if (non-const? copy-assign? :methods) (abi/lref t) cref)]
    (when-not (has-ctor-of? id copy-ctor?)
      (let [fid (implicit-fn! id :ctor (:name c) {:k :fn :ret abi/void :ps [ctor-p] :va false} :trivial (trivial-copy? id))]
        (when del (upd-fn! fid merge del))
        ;; (cpp-1123: an rvalue reference member, [class.copy.ctor]/10.1)
        (when-let [m (and (checking?) (not del) (cx-member-deleting id :copy))]
          (upd-fn! fid merge {:deleted true :deleted-sure true :cx-sub-deleted m :deleted-why "a member of rvalue reference type"}))))
    (doseq [x (:ctors (abi/cls id))]
      ;; (queue 351: trivial-copy? asks every copy constructor's :trivial, this one's too: taken as trivial while it is
      ;; judged, so `X(const X&) = default` is trivial when the rest is ([class.copy.ctor]/11), a copy of bytes and the
      ;; psABI's registers as clang's; before, never: futex.cc's chrono::seconds by the address of a copy made by a call)
      (let [g (fnd x)] (when (and (:defaulted g) (copy-ctor? g id)) (upd-fn! x assoc :trivial true) (upd-fn! x assoc :trivial (trivial-copy? id))))
      ;; (cpp-rt-own: a move constructor defaulted on its first declaration likewise, [class.copy.ctor]/11, as the implicit one:
      ;; <tuple>'s `constexpr _Head_base(_Head_base&&) = default;` of a pointer or an empty deleter, a copy of bytes in clang's
      ;; IR, no _ZNSt10_Head_base...C2EOS_ written; fs_path.cc's and cow-fs_dir.cc's unique_ptr<_Impl, _Impl_deleter> moved)
      ;; (the bases' and members' moves judged, members-move-trivial?: <tuple>'s `_Tuple_impl(_Tuple_impl&&) = default` over a base
      ;; whose move constructor is user-provided is not trivial, clang's _ZNSt11_Tuple_impl...C2EOS6_ defined)
      (let [g (fnd x)] (when (and (:defaulted g) (not (:ool-defaulted g)) (move-ctor? g id)) (upd-fn! x assoc :trivial (members-move-trivial? id)))))
    (when-not (some #(copy-assign? (fnd %) id) (:methods (abi/cls id)))
      (let [fid (implicit-fn! id :method "operator=" {:k :fn :ret (abi/lref t) :ps [assign-p] :va false} :op "=" :trivial (trivial-assign? id))]
        (when del (upd-fn! fid merge del))
        ;; (cpp-1123: a const non-class or a reference member, [class.copy.assign]/7.2-7.3)
        (when-let [m (and (checking?) (not del) (cx-member-deleting id :assign))]
          (upd-fn! fid merge {:deleted true :deleted-sure true :cx-sub-deleted m :deleted-why "a const or reference member"})))))
    ;; CX12 (the checker): the implicit move constructor and move assignment ([class.copy.ctor]/8, [class.copy.assign]/4:
    ;; declared when the class declares no copy or move member and no destructor); one defined as deleted is no
    ;; candidate ([over.match.funcs]/8, ctor-candidates). (Queue 411, DECISION 392-1 (a): declared in the code generator's mode
    ;; too, as clang declares them: an xvalue of such a class moved, not copied; COW basic_string's _Alloc_hider(_Alloc_hider&&),
    ;; clang's _ZNSs12_Alloc_hiderC2EOS_ in cow-stdexcept.cc, cow-string-inst.cc, cow-wstring-inst.cc and cow-sstream-inst.cc. The
    ;; copy constructor and copy assignment a user-declared move deletes stay the checker's alone.)
    (when (and (not moves)
               (not-any? #(let [g (fnd %)] (and (not (:implicit g)) (copy-ctor? g id))) (:ctors (abi/cls id)))
               (not-any? #(let [g (fnd %)] (and (not (:implicit g)) (copy-assign? g id))) (:methods (abi/cls id)))
               (let [d (:dtor (abi/cls id))] (or (nil? d) (:implicit (fnd d)))))
      (let [rref {:k :rref :to t}]
        (implicit-fn! id :ctor (:name c) {:k :fn :ret abi/void :ps [rref] :va false} :trivial (trivial-copy? id) :cx-move true)
        (implicit-fn! id :method "operator=" {:k :fn :ret (abi/lref t) :ps [rref] :va false} :op "=" :trivial (trivial-assign? id) :cx-move true))))
    (doseq [x (:methods (abi/cls id))]
      ;; (queue 351: an assignment's triviality is its own, [class.copy.assign]/9: not the copy constructor's, which
      ;; std::allocator's user-provided one made non-trivial; clang writes no call of allocator<char>::operator=)
      ;; (cpp-rt-own2: a move assignment defaulted on its first declaration likewise: <fs_fwd.h>'s file_status&
      ;; operator=(file_status&&) noexcept = default over two enumerations, a copy of the bytes in clang's IR, no
      ;; _ZNSt10filesystem11file_statusaSEOS0_ written)
      (let [g (fnd x)] (when (and (:defaulted g) (not (:ool-defaulted g)) (or (copy-assign? g id) (move-assign? g id))) (upd-fn! x assoc :trivial (trivial-assign? id)))))
    (abi/update-cls! id assoc :user-ctor (boolean (seq (filter #(not (:implicit (fnd %))) (:ctors (abi/cls id)))))
                     :user-dtor (boolean (let [d (:dtor (abi/cls id))] (and d (not (:implicit (fnd d))))))
                     :user-copy-assign (boolean (some #(let [g (fnd %)] (and (copy-assign? g id) (not (:implicit g)))) (:methods (abi/cls id)))))
    ;; the vtable: the primary base's slots, overridden, then the new virtual functions (a destructor two slots)
    (when (abi/dynamic? id)
      (let [pb (abi/primary-base id)
            inherited (if pb (:vtable (abi/cls (:cls pb))) [])
            mine (map fnd (:virtuals (abi/cls id)))
            overrides? (fn [f slot] (let [g (fnd (:fn slot))]
                                      (and (= (:kind g) (:kind f))
                                           (or (= :dtor (:kind f))
                                               (and (= (:name g) (:name f)) (= (:cq g) (:cq f)) (= (mapv abi/unq (:ps (:ty g))) (mapv abi/unq (:ps (:ty f)))))))))
            ;; a covariant return that needs an adjustment (the base's offset is not 0 or is virtual) does not reuse the slot
            ;; of the nearest overridden function: the overrider gets a slot of its own and the old slot holds a thunk
            ;; (clang's AddMethods, ComputeReturnAdjustmentBaseOffset)
            ret-class (fn [g] (let [r (abi/unq (:ret (:ty g))) t (when (#{:ptr :ref :rref} (:k r)) (abi/unq (:to r)))] (when (and t (abi/class? t)) (:id t))))
            ret-adj? (fn [f g] (let [d (ret-class f) b (ret-class g)]
                                 (boolean (and d b (not= d b) (abi/derived-from? d b)
                                               (let [[_ off vb] (abi/base-path d b)] (or vb (not (zero? (long off)))))))))
            vt0 (vec inherited)
            vt (reduce (fn [vt f]
                         (let [idxs (keep-indexed (fn [i slot] (when (overrides? f slot) i)) vt)]
                           (cond
                             (empty? idxs) vt
                             (= :dtor (:kind f)) (reduce #(assoc-in %1 [%2 :fn] (:id f)) vt idxs)
                             :else (let [n (last idxs)]
                                     (if (ret-adj? f (fnd (:fn (nth vt n)))) vt (assoc-in vt [n :fn] (:id f)))))))
                       vt0 mine)
            new-fs (remove (fn [f] (some #(= (:id f) (:fn %)) vt)) mine)
            vt (into vt (mapcat (fn [f] (if (= :dtor (:kind f)) [{:fn (:id f) :v 1} {:fn (:id f) :v 0}] [{:fn (:id f)}])) new-fs))]
        (abi/update-cls! id assoc :vtable vt)))
    ;; (the layout of the finished class, any earlier one computed while its members were entered dropped)
    (abi/update-cls! id #(-> % (assoc :finished true) (dissoc :layout)))
    (abi/layout id)
    id))

(defn aggregate?
  "[dcl.init.aggr]/1 (C++20): an array, or a class with no user-declared constructors, no private or protected direct
  non-static data members, no virtual functions and no virtual, private or protected bases."
  [t]
  (or (abi/arr? t)
      (and (abi/class? t)
           (let [id (:id t) c (abi/cls id)]
             ;; (cpp-rt-own3: a constructor template is a user-declared constructor too, [class.ctor.general]/1: `template<typename... U>
             ;; explicit constexpr CI(U&&... a)` over a union's member, `constinit CI<D> dr{};` value-initialized by it, its vptr
             ;; written, not zeroed as an aggregate's member)
             (and (not (:user-ctor c)) (empty? (:ctor-tmpls c)) (not (abi/dynamic? id))
                  (every? #(= :public (:access %)) (:fields c))
                  (every? #(= :public (:access %)) (:bases c)))))))

(defn cx-plain-class?
  "cpp-sweep (the checker): whether the class `id` is no template's specialization nor a member of one, and not local to a
  function: its enclosing scopes namespaces and such classes."
  [id]
  (loop [id id]
    (let [c (abi/cls id) s (:outer c)]
      (cond (nil? s) false
            (= :ns (:kind s)) true
            (and (= :class (:kind s)) (:cls s)) (recur (:cls s))
            :else false))))

(defn- cx-user-fn-not-constexpr? [f]
  (boolean (and f (not (:implicit f)) (not (:defaulted f)) (not (:constexpr f)) (not (:deleted f)))))

(defn cx-dtor-not-constexpr
  "cpp-sweep (the checker): the reason the destructor of the class `id` is surely not constexpr ([dcl.constexpr]/5 of C++20):
  a user-provided one not declared constexpr, a virtual base, or (implicit or defaulted) a base's or member's such; else nil."
  ([id] (cx-dtor-not-constexpr id #{}))
  ([id seen]
   (let [c (abi/cls id) d (some-> (:dtor c) fnd)]
     (when (and c (:finished c) (not (:header c)) (not (:lambda c)) (not (seen id)))
       (cond (cx-user-fn-not-constexpr? d) (str "'" (:name c) "' has a destructor not declared 'constexpr'")
             (some :virtual (:bases c)) (str "'" (:name c) "' has a virtual base")
             :else (some #(when (cx-dtor-not-constexpr % (conj seen id)) (str "subobject of class '" (:name (abi/cls %)) "' has a non-'constexpr' destructor"))
                         (class-like-members id)))))))

(declare analyze-implicit!)

(defn- cx-cmp-defaulted? [f]
  (boolean (and (checking?) (:defaulted f) (not (:constexpr f)) (not (:deleted f)) (not (:implicit f))
                (#{"==" "<=>" "!=" "<" ">" "<=" ">="} (:op f)) (:node f) (not (header-node? (:node f))))))

(defn- cx-cmp-body!
  "cpp-sweep: the analyzed body of the defaulted comparison `fid` (analyze-implicit!, once), or nil when it does not analyze."
  [fid]
  (let [f (fnd fid)]
    (or (:tbody f)
        (when-not (or (:analyzed f) (:params f))
          (upd-fn! fid assoc :analyzed true)
          (try (analyze-implicit! fid) (:tbody (fnd fid))
               (catch arbace.lang.ExceptionInfo _ (upd-fn! fid dissoc :analyzed) nil))))))

(defn cx-cmp-not-constexpr
  "cpp-sweep (the checker): for a defaulted comparison operator not declared constexpr ([class.compare.default]/3 of C++20),
  the name of the function surely not constexpr its definition calls (directly, or through another such operator), or nil."
  ([fid] (cx-cmp-not-constexpr fid #{}))
  ([fid seen]
   (let [f (fnd fid)]
     (when (and (cx-cmp-defaulted? f) (not (seen fid)))
       (when-let [b (cx-cmp-body! fid)]
         (some (fn [x] (when (and (map? x) (= :call (:op x)) (:fn x))
                         (let [g (fnd (:fn x))]
                           (cond (and (not (:constexpr g)) (not (:consteval g)) (not (:implicit g)) (not (:defaulted g)) (not (:tinst g))
                                      (:node g) (not (header-node? (:node g))) (not (str/starts-with? (str (:name g)) "__")))
                                 (:name g)
                                 (cx-cmp-defaulted? g) (when (cx-cmp-not-constexpr (:id g) (conj seen fid)) (:name g))
                                 :else nil))))
               (tree-seq coll? #(if (map? %) (vals %) (seq %)) b)))))))

(defn- cx-cmp-constexpr?
  "cpp-sweep: whether the defaulted comparison `fid` is constexpr by [class.compare.default]/3 (C++20): its definition calls no
  function surely not constexpr (cx-cmp-not-constexpr)."
  [fid]
  (let [f (fnd fid)]
    (boolean (and (>= (long *cxx-year*) 20) (cx-cmp-defaulted? f) (cx-cmp-body! fid) (not (cx-cmp-not-constexpr fid))))))

(defn- cx-defaulted-not-constexpr
  "cpp-sweep (the checker): why the special member `f` of the class `id`, defaulted on its first declaration, would not be
  constexpr implicitly, or nil (constexpr, or not known surely): a destructor (C++20) by cx-dtor-not-constexpr; a default
  constructor by a virtual base, a base's or member's default constructor user-provided and not constexpr, or before C++20 a
  non-static data member of scalar type without a default member initializer ([dcl.constexpr]/4.5 of C++17: every member
  initialized)."
  [id f]
  (let [c (abi/cls id)]
    (case (:kind f)
      :dtor (when (>= (long *cxx-year*) 20) (cx-dtor-not-constexpr id))
      :ctor (when (empty? (:ps (:ty f)))
              (or (when (some :virtual (:bases c)) (str "'" (:name c) "' has a virtual base"))
                  (some (fn [m] (let [mc (abi/cls m)
                                      dc (some #(let [g (fnd %)] (when (empty? (:ps (:ty g))) g)) (:ctors mc))]
                                  (when (and mc (not (:header mc)) (cx-user-fn-not-constexpr? dc) (empty? (:ctor-tmpls mc)))
                                    (str "defaulted constructor calls non-'constexpr' '" (:name dc) "'"))))
                        (class-like-members id))
                  (when (< (long *cxx-year*) 20)
                    (some (fn [fl] (let [t (loop [t (:ty fl)] (if (abi/arr? t) (recur (:of t)) t))]
                                     (when (and (not (:static fl)) (not (:init fl)) (string? (:name fl)) (seq (:name fl)) (abi/scalar? (abi/unq t)))
                                       (str "defaulted default constructor does not initialize '" (:name fl) "'"))))
                          (:fields c)))))
      nil)))

(defn cx-non-literal
  "cpp-sweep (the checker): the reason the type `t` is surely no literal type ([basic.types.general]/10 of C++11-C++23), in
  GCC's words, or nil (literal, or not known surely). A class: a destructor not trivial (before C++20; since, a user-provided
  one not constexpr), or not an aggregate with user-declared constructors none of which is constexpr and not a copy or move
  constructor (a constructor template, an inheriting constructor or a defaulted default constructor unsure), or a base or a
  non-static data member of a non-literal or volatile type; a union, a closure, a header's class and an incomplete one unsure.
  As g++ 15.2 judges it (probes by hand: a class without user-declared constructors is literal by its implicit default
  constructor, private members, default member initializers or virtual functions notwithstanding)."
  ([t] (cx-non-literal t #{}))
  ([t seen]
   (let [t (abi/unq t)]
     (cond
       (abi/arr? t) (cx-non-literal (:of t) seen)
       (not (abi/class? t)) nil
       :else
       (let [id (:id t) c (abi/cls id) nm (:name c)]
         (when (and c (:finished c) (string? nm) (not (:lambda c)) (not (:header c)) (not (:union c)) (not (seen id)))
           (let [seen (conj seen id)
                 d (some-> (:dtor c) fnd)
                 user-ctors (remove :implicit (map fnd (:ctors c)))]
             (cond
               (and (< (long *cxx-year*) 20) (not (trivial-dtor? id)))
               (str "'" nm "' has a non-trivial destructor")
               (and (>= (long *cxx-year*) 20) d (not (:implicit d)) (not (:defaulted d)) (not (:constexpr d)))
               (str "'" nm "' does not have 'constexpr' destructor")
               (and (seq user-ctors) (empty? (:ctor-tmpls c)) (empty? (:inherits-ctors c)) (not (:cx-ctor-dropped c))
                    (not (aggregate? t))
                    (not-any? #(or (and (:defaulted %) (empty? (:ps (:ty %))))
                                   (and (:constexpr %) (not (copy-ctor? % id)) (not (move-ctor? % id))))
                              user-ctors))
               (str "'" nm "' is not an aggregate, does not have a trivial default constructor, and has no 'constexpr' constructor that is not a copy or move constructor")
               :else
               (or (some (fn [b] (when (cx-non-literal {:k :class :id (:cls b)} seen)
                                   (str "base class '" (:name (abi/cls (:cls b))) "' of '" nm "' is non-literal")))
                         (:bases c))
                   (some (fn [fl] (when-not (:static fl)
                                    (cond (:v (:ty fl)) (str "non-static data member '" nm "::" (:name fl) "' has volatile type")
                                          (cx-non-literal (:ty fl) seen) (str "non-static data member '" nm "::" (:name fl) "' has non-literal type"))))
                         (:fields c)))))))))))

;; ---------------------------------------------------------------------------------------------
;; Constant integers (enumerators, array bounds, case labels)

(declare analyze rv init-list-elem)

(declare ce-eval ce-wrap ub! not-constant)

(def ^:dynamic *ce-wide*
  "cpp-s13: true inside an evaluation (const-int's, ce-eval's), where a 128-bit value outside 64 bits is a value (a BigInt);
  its result outside 64 bits is not a constant (narrow-out), as before: only evaluations' own steps see them (an if
  constexpr's comparison of __numeric_traits_integer<__int128>::__max)."
  false)

(defn ce-num
  "An evaluation's integral value as a number to compute with: a long, or a BigInt outside 64 bits (a 128-bit value)."
  [v]
  ;; (cpp-rt-own2: a pointer's or an object's value, a map, is no number: not a constant, never a ClassCastException)
  (when (map? v) (throw (ex-info "not a constant: a pointer or an object as a number" {:codegen/not-constant true})))
  (if (and (integer? v) (not (instance? Long v)) (or (> v Long/MAX_VALUE) (< v Long/MIN_VALUE))) (bigint v) (long v)))

(defn- wide-value? [v] (and (integer? v) (not (instance? Long v)) (or (> v Long/MAX_VALUE) (< v Long/MIN_VALUE))))

(defn- wide-literal
  "cpp-s13: a 128-bit value as an :int node's :v (its LLVM constant): the signed representation, as a 64-bit unsigned one is a
  negative long."
  [v]
  (let [x (bigint v)] (if (>= x 170141183460469231731687303715884105728N) (- x 340282366920938463463374607431768211456N) x)))

(declare wide?)

(defn- from-src
  "cpp-s13: an integral value of the type `src` as the value it stands for when converted to a 128-bit type: a 64-bit unsigned
  one held as a negative long is 2^64 more ([conv.integral]/2's zero extension)."
  [src t v]
  (let [src (when src (abi/underlying (abi/unq src)))]
    (if (and (wide? t) src (abi/integral? src) (not (abi/signed? src)) (not (wide? src)) (instance? Long v) (neg? (long v)))
      (+ (bigint v) 18446744073709551616N)
      v)))

(defn- narrow-out
  "An evaluation's result `v` where it leaves the evaluator: a 128-bit value outside 64 bits not a constant (CP5b's rule)."
  [v]
  (if (wide-value? v) (not-constant "a 128-bit value outside 64 bits") v))

(defn- wide?
  "cpp-s5b (pending review 1111 #2): whether the integral type `t` is wider than 64 bits (__int128, unsigned __int128)."
  [t]
  (let [t (abi/underlying (abi/unq t))]
    (and (abi/integral? t) (> (* 8 (long (abi/size-of t))) 64))))

(defn- wide-binop
  "cpp-s5b (pending review 1111 #2): a 128-bit type's arithmetic on the operands' values computed exactly (cpp-s13: the operands
  themselves may be outside 64 bits, ce-wrap holding a 128-bit value as a BigInt then), for ce-wrap to reduce to the type's
  width, never computed modulo 2^64 (`(unsigned __int128)1 << 64` was 0); a shift by a count outside 0..127 and a division by
  zero are not constants."
  [^String o a b]
  (let [A (biginteger (ce-num a)) B (biginteger (ce-num b))]
    (case o
      "+" (bigint (.add A B)) "-" (bigint (.subtract A B)) "*" (bigint (.multiply A B))
      ("/" "%") (if (zero? (.signum B)) (not-constant "division by zero") (bigint (if (= o "/") (.divide A B) (.remainder A B))))
      "<<" (let [n (long (ce-num b))] (if (<= 0 n 127) (bigint (.shiftLeft A (int n))) (not-constant "a shift by " n)))
      ">>" (let [n (long (ce-num b))] (if (<= 0 n 127) (bigint (.shiftRight A (int n))) (not-constant "a shift by " n)))
      "&" (bigint (.and A B)) "|" (bigint (.or A B)) "^" (bigint (.xor A B))
      nil)))

(declare const-int)

;; CP378 (a): true while an evaluation is manifestly constant-evaluated ([expr.const]/22: a constant-expression -- an array
;; bound, a template argument, a case label, an enumerator --, an if constexpr's condition, a static_assert's, a constraint's,
;; the initializer of a variable usable in constant expressions (constexpr, or a const integral one), an immediate
;; invocation), where `__builtin_is_constant_evaluated()` and `if consteval` say true; false in the folds of code that runs
;; (fold-mark's, ce-try's), as clang's InConstantContext
(def ^:dynamic *ce-manifest* false)
;; (cpp-rt-own2: an atom while ce-object evaluates a namespace-scope object's initializer, which may then take the address of an
;; object of static storage duration, [expr.const]/13's address constant: ce-global-addr; it holds true once one was taken)
(def ^:dynamic *ce-gaddr* nil)

(def ^:dynamic *vci-active*
  "cpp-indep: the variables whose initializers var-const-int is evaluating, nested."
  #{})

(declare ce-sure! not-constant)

(defn- var-const-int
  "A const integral variable's value, its initializer's constant (const-int in its definition's scope), kept on the variable
  once found: a variable's initializer is the same expression at every use, and a class template's static member whose
  initializer names its other specializations' (cpp0x/overflow1's Fib<i-1>::value + Fib<i-2>::value) is otherwise evaluated
  again for each path, exponentially (the dg read's one file that never ended). A failure is not kept."
  [id]
  (let [v (var* id)]
    (if (contains? v :cint)
      (if *ce-wide* (:cint v) (narrow-out (:cint v)))
      (let [_ (when (contains? *vci-active* id)
                ;; (cpp-indep: a variable read in its own initializer is not initialized yet, [basic.life]/? with
                ;; [expr.const]/5.9: GCC's "the value of 'X' is not usable in a constant expression", "used in its own
                ;; initializer"; cpp0x/constexpr-diag2.C's `constexpr int X (X);`, a recursion without end before)
                (if (checking?)
                  (ce-sure! "the value of '" (:name v) "' is not usable in a constant expression (used in its own initializer)")
                  (not-constant "a variable in its own initializer")))
            c (binding [*ce-wide* true *vci-active* (conj *vci-active* id)] (const-int (or (:def-scope v) *root*) (:init v)))]
        (upd-var! id assoc :cint c)
        (if *ce-wide* c (narrow-out c))))))

(declare analyze rv)

(defn- cx-cce-type!
  "Queue 518 (the checker): a converted constant expression of integral type ([expr.const]/12: integral promotions and
  conversions other than narrowing, no floating-integral conversion, no conversion from a scoped enumeration) written as `n`, a
  case label's ([stmt.switch]/2) or a bit-field's width ([class.bit]/1, an integral constant expression): one of floating or
  scoped enumeration type is GCC's \"could not convert\", reported at `n` (cpp0x/enum28.C's `case 1.0:`, cpp0x/scoped_enum2.C's
  `int i: E::e;`; a case label of scoped enumeration type is the condition's own when it switches on that enumeration, so only
  its floating labels, `enum?` false). The analysis goes on."
  [scope n what & [enum?]]
  (when (and (checking?) (map? n))
    (let [t (try (abi/unq (:ty (binding [*cutoff* Long/MAX_VALUE] (analyze {:scope scope} n)))) (catch arbace.lang.ExceptionInfo _ nil))]
      (when (and (map? t) (or (abi/floating? t) (and (not= false enum?) (abi/enum? t) (:scoped (abi/enm (:id t))))))
        (*on-refusal* (ex-info (str "codegen: could not convert an expression of type " (if (abi/floating? t) "floating" "scoped enumeration")
                                    " to an integral type in a converted constant expression (" what ")")
                               {:codegen/refused :conversion})
                      n)))))

(def ^:dynamic *cx-concept-cutoff*
  "Queue 588 (the checker): the cutoff a main file's concept's satisfaction under way binds its lookups to (template.ae's
  concept-satisfied?), or nil."
  nil)

(defn const-int [scope n]
  (tick!)
  ;; (queue 588: a main file's concept's constraint at its definition's cutoff, the scope's :cx-cutoff, template.ae's
  ;; concept-satisfied?)
  (let [e (binding [*cutoff* (long (or (:cx-cutoff scope) Long/MAX_VALUE))] (rv (analyze {:scope scope} n)))
        ;; (queue 518: a variable's braced initializer of one element, the scalar it initializes, [dcl.init.list]/3.9:
        ;; integral_constant's `static constexpr T value {Value};` read by var-const-int in a constraint, cpp2a/concepts-pr67148.C's,
        ;; had been "not a constant: the expression :init-list")
        e (if (and (= :init-list (:op e)) (= 1 (count (:items e)))) (rv (first (:items e))) e)]
    (letfn [(ev [e]
              (case (:op e)
                :int (if (:ice e) 1 (if (and (:ty e) (wide? (:ty e))) (ce-wrap (:ty e) (:v e)) (:v e)))
                ;; G5c: the value converted to the cast's type ([conv.integral]/3: modulo 2^N for an unsigned one), so that
                ;; libstdc++'s __numeric_traits_integer<unsigned>::__is_signed, (_Value)(-1) < 0, is false
                :cast (let [v (ev (:e e))] (if (abi/integral? (:ty e)) (ce-wrap (:ty e) (from-src (:ty (:e e)) (:ty e) v)) (fail :const "constant cast")))
                ;; (CP325 (a): 64-bit arithmetic wraps, as the unsigned types' modulo 2^N does; a signed overflow is the
                ;; program's error, which this evaluation does not judge -- parse/enum4.C's 9223372036854775807ULL * 2 + 1 had
                ;; thrown Java's ArithmeticException, a crash of the analysis)
                :unop (let [v (ev (:e e))]
                        (if (and (#{"-" "~"} (:o e)) (wide? (:ty e)))
                          (ce-wrap (:ty e) (if (= "-" (:o e)) (- (bigint v)) (- -1 (bigint v))))
                          (case (:o e) "-" (unchecked-negate (long v)) "+" v "~" (bit-not (long v)) "!" (if (zero? (ce-num v)) 1 0))))
                ;; (review 1111 #5: && and || short-circuit, [expr.log.and]/1, so that 2 || 1 / 0 is 1; a division by zero is not a
                ;; constant, as ce-eval's, never Java's ArithmeticException: warn/overflow-warn-3.C's enumerators had crashed Sema)
                :binop (let [a (ce-num (ev (:l e)))
                             sc (case (:o e) "&&" (when (zero? a) 0) "||" (when-not (zero? a) 1) nil)
                             b (if sc 0 (ce-num (ev (:r e))))
                             u (and (abi/integral? (:ty e)) (not (abi/signed? (:ty e))))
                             _ (when (and (not sc) (#{"/" "%"} (:o e)) (zero? b))
                                 (if (checking?) (ub! e "division by zero") (not-constant "division by zero")))
                             r (if-some [w (when (and (not sc) (wide? (:ty e))) (wide-binop (:o e) a b))] w
                               (case (:o e) "+" (unchecked-add a b) "-" (unchecked-subtract a b) "*" (unchecked-multiply a b)
                                     "/" (if u (Long/divideUnsigned a b) (quot a b)) "%" (if u (Long/remainderUnsigned a b) (rem a b))
                                     "<<" (bit-shift-left a b) ">>" (if u (unsigned-bit-shift-right a b) (bit-shift-right a b))
                                     "&" (bit-and a b) "|" (bit-or a b) "^" (bit-xor a b)
                                     "<" (if (< a b) 1 0) ">" (if (> a b) 1 0) "<=" (if (<= a b) 1 0) ">=" (if (>= a b) 1 0)
                                     "==" (if (= a b) 1 0) "!=" (if (not= a b) 1 0) "&&" (if (and (not= a 0) (not= b 0)) 1 0)
                                     "||" (if (or (not= a 0) (not= b 0)) 1 0)))]
                         (if (abi/integral? (:ty e)) (ce-wrap (:ty e) r) r))
                :cond (if (zero? (ce-num (ev (:c e)))) (ev (:else e)) (ev (:then e)))
                ;; (compared in the operands' common type: unsigned ones as unsigned, [expr.rel]/5, [conv.arith]; a 128-bit
                ;; value as its value, cpp-s13)
                :cmp (let [a (ce-num (ev (:l e))) b (ce-num (ev (:r e)))
                           c (cond (or (wide-value? a) (wide-value? b)) (compare (bigint a) (bigint b))
                                   (and (:ct e) (abi/integral? (:ct e)) (not (abi/signed? (:ct e))) (not (wide? (:ct e)))) (Long/compareUnsigned a b)
                                   :else (compare a b))]
                       (case (:o e) "<" (if (neg? c) 1 0) ">" (if (pos? c) 1 0) "<=" (if (<= c 0) 1 0) ">=" (if (>= c 0) 1 0)
                             "==" (if (zero? c) 1 0) "!=" (if (zero? c) 0 1)))
                :not (if (zero? (ce-num (ev (:e e)))) 1 0)
                :land (if (and (not (zero? (ce-num (ev (:l e))))) (not (zero? (ce-num (ev (:r e)))))) 1 0)
                :lor (if (or (not (zero? (ce-num (ev (:l e))))) (not (zero? (ce-num (ev (:r e)))))) 1 0)
                :load (let [v (var* (:id (:e e)))] (if (and (:c (:ty v)) (:init v)) (var-const-int (:id (:e e))) (ce-eval e)))
                (ce-eval e)))]
      (if *ce-wide*
        (binding [*ce-manifest* true] (ev e))
        (narrow-out (binding [*ce-manifest* true *ce-wide* true] (ev e)))))))

;; ---------------------------------------------------------------------------------------------
;; Constant evaluation ([expr.const]): the typed expressions of integral and floating values, calls of constexpr
;; functions with their parameters, locals, conditions, loops and assignments (as clang's ExprConstant evaluates them,
;; for what the slice's code asks: initializers of globals, constexpr and const integral locals, array bounds and case
;; labels); anything else is not a constant (ex-info {:codegen/not-constant true})

(declare analyze-fn! stmt ce-exec)

;; h-cpp-consteval: the cells whose objects' lifetimes ended (an atom of a set: a block's locals after it, a call's parameters
;; after it, a full-expression's temporaries after it, [basic.life], [class.temporary]/4) and the temporaries of the
;; full-expressions being evaluated (an atom of a vector), the checker's
(def ^:dynamic *ce-dead* nil)
(def ^:dynamic *ce-temps* nil)

(defn- ce-kill! [cells] (when (and *ce-dead* (seq cells)) (swap! *ce-dead* into cells)))

(defn- ce-temp! [c] (when *ce-temps* (swap! *ce-temps* conj c)) c)

;; cpp-ce2 (the checker): the evaluation's allocations, P0784R7 ([expr.const]/5.20, /6): {cell {:array bool :at the new-expression's
;; position :freed bool}}; *ce-heap-top* true below the outermost evaluation, whose end checks them (ce-heap-end!)
(def ^:dynamic *ce-heap* nil)
(def ^:dynamic *ce-heap-top* nil)

;; cpp-ce2 (the checker): an object a constructor or an aggregate initialization with `this` makes in a cell of its own (its value
;; tagged ::from that cell, ce-made) is the object of the place its value is first put in ([dcl.init.general]/16.6.1, [class.temporary]/2:
;; a prvalue initializes its result object, no copy): that cell aliases the place, {cell [cell2 path]} (ce-adopt!), so a pointer the
;; construction kept, `this` stored in a member, locates the object where it lives (ce-res)
(def ^:dynamic *ce-moved* nil)
;; cpp-ce3 (the checker): the cells of the objects whose constructors are initializing their base classes ([class.base.init]/13.2),
;; whose dynamic type is not their own class yet ([class.cdtor]/5-6: during a base's construction a virtual call or a dynamic_cast
;; sees the subobject's own class, the most derived object's not begun): a constructed base subobject's dynamic type its own,
;; one not constructed yet no object (GCC's vtable pointer read, "accessing uninitialized member")
(def ^:dynamic *ce-bases* #{})
(def ^:dynamic *ce-mi-at*
  "cpp-ce3 (the checker): the range of the mem-initializer whose initialization is under way (its constructor call's place)."
  nil)

(def ^:dynamic *ce-analyzing-imm* false) ; cpp-ce3: true while an immediate invocation is evaluated (cx-immediate-eval!: none nested)
;; cpp-ce3: true while a conditional's branch, a default argument or a default member initializer is analyzed: its immediate
;; invocations are not evaluated there (a branch not taken; the use's, P2564R3's escalation to the constructor)
(def ^:dynamic *cx-no-imm* false)
;; cpp-sweep (the checker): true while an expression statement or an automatic variable's initializer that is neither constexpr nor
;; const is analyzed, no manifestly constant-evaluated context ([expr.const]/20): an immediate invocation in a conditional's arm is
;; one there ([expr.const]/16, P2564R3's immediate function context excludes it), evaluated (cpp2a/consteval11.C's `int h = 0 ?
;; bar (7) : 1;`); a nested declaration or statement binds it again
(def ^:dynamic *cx-arms-evaluated* false)
;; cpp-p2564 (the checker): P2564R3's immediate escalation ([expr.const]/16-18; GCC applies it in C++20 too), judged in a unit whose
;; text names consteval (*cx-consteval-unit*, bound by analyze-program): an immediate-escalating function of the main file (a
;; closure's call operator, a defaulted special member, a constexpr function made by a template's instantiation) whose body has an
;; immediate-escalating expression -- an immediate invocation surely not constant, the address of an immediate function -- is an
;; immediate function (:cx-escalated), its calls and its address then as a consteval function's (cx-immediate-eval!,
;; cx-ctor-immediate!, cx-addr-escalation!). *cx-at-override*: the range every expression analyzed takes as its position for the
;; constant evaluation's diagnostics (a default argument's at its call, a default member initializer's at its constructor: GCC's
;; places), and the place of an immediate invocation's error there. *cx-imm-pending*: while a namespace-scope variable's
;; initializer is analyzed, the immediate invocations that return an immediate function's address, judged by the whole
;; initializer's constant evaluation (constant initialization makes it manifestly constant-evaluated, [expr.const]/20).
;; *ce-fnptr*: the evaluator's function addresses ({::fnp id}) and calls through them, in that judgment alone.
(def ^:dynamic *cx-consteval-unit* false)
(def ^:dynamic *cx-at-override* nil)
(def ^:dynamic *cx-imm-pending* nil)
(def ^:dynamic *ce-fnptr* false)
(declare cx-addr-escalation! cx-ctor-immediate! cx-closure-conv! cx-p2564? cx-main-fn? cx-imm-addrs cx-addr-report!)

(def ^:dynamic *ce-point*
  "cpp-ce3 (the checker): the range of the declaration whose initializer or condition the evaluation is of (a constexpr or
  constinit variable's, a static_assert's): where the evaluation is, [expr.const]/5.3's \"before its definition\"."
  nil)

(def ^:private ce-from ::from)
(defn- ce-made [v cell] (if (and (map? v) (checking?)) (vary-meta v assoc ::from cell) v))
(defn- ce-adopt!
  "The objects made in cells of their own within the value `v`, now at `path` of `cell`, aliased there (the first placing alone)."
  [cell path v]
  (when (and *ce-moved* (checking?))
    (letfn [(walk [path v]
              (cond (map? v) (do (when-let [x (::from (meta v))]
                                   (when-not (or (identical? x cell) (contains? @*ce-moved* x))
                                     (swap! *ce-moved* assoc x [cell path])))
                                 (doseq [[k x] v :when (and (not (keyword? k)) (coll? x))] (walk (conj path k) x)))
                    (vector? v) (when (< (count v) 4096) (dotimes [i (count v)] (let [x (nth v i)] (when (coll? x) (walk (conj path i) x)))))
                    :else nil))]
      (walk (vec path) v)))
  v)
(defn- ce-res
  "The location `l` where its object lives (ce-adopt!'s aliases followed)."
  [l]
  (if-let [[c p] (and *ce-moved* (map? l) (contains? l ::cell) (get @*ce-moved* (::cell l)))]
    (recur (assoc l ::cell c ::path (into p (::path l))))
    l))

(declare ub! ce-sure! ce-destroy!)

(defn- ce-destroy-cells!
  "cpp-ce2 (the checker, from C++20): the class objects of the cells `cells` (the temporaries of a full-expression, a call's
  parameters) destroyed in that order ([class.temporary]/4, [expr.call]/7), ce-destroy!; one whose lifetime already ended left to
  ce-end-lives!."
  [cells]
  (when (and (checking?) (>= (long *cxx-year*) 20))
    (doseq [c cells]
      (let [v @c]
        (when (and (map? v) (::cls v) (not (and *ce-dead* (contains? @*ce-dead* c))) (not (trivial-dtor? (::cls v))))
          (ce-destroy! nil (::cls v) {::cell c ::path []}))))))

(defn- ce-end-lives!
  "cpp-ce2 (the checker): the objects of the cells `cells` end their lifetimes (ce-kill!); one whose lifetime already ended, by an
  explicit destructor call ([class.dtor]/18: its destruction at its scope's end is then undefined, [basic.life]/9), is GCC's
  \"destroying ... outside its lifetime\", at the node `at` (nil: the evaluation's last position)."
  [cells at]
  (when (and (checking?) *ce-dead* (some #(contains? @*ce-dead* %) cells))
    (if at (ub! at "destroying an object outside its lifetime") (ce-sure! "destroying an object outside its lifetime")))
  (ce-kill! cells))

(defn- ce-extended-temp?
  "n-review-b: whether the glvalue `e` is a temporary object or a member or base subobject of one, by member access and
  base conversions alone ([class.temporary]/6: a reference bound to it extends the temporary's lifetime)."
  [e]
  (case (:op e)
    (:temp :temp-obj) true
    :field (recur (:obj e))
    :base-lv (recur (:e e))
    false))

(defmacro ^:private ce-full-expr
  "The body evaluated as a full-expression: the temporaries it makes die at its end."
  [& body]
  `(let [m# (when *ce-temps* (count @*ce-temps*))
         r# (do ~@body)]
     (when m# (let [ts# @*ce-temps*] (ce-destroy-cells! (rseq (subvec ts# m#))) (ce-end-lives! (subvec ts# m#) nil) (reset! *ce-temps* (subvec ts# 0 m#))))
     r#))

;; h-cpp-consteval: the position of the expression the evaluation entered last (an atom, the checker's): a diagnostic of an
;; operation whose own node carries none (a read of a subobject) is put there
(def ^:dynamic *ce-pos* nil)

(defn- ub!
  "CX12 (the checker): an evaluation [expr.const]/5 makes not a core constant expression by the program's own operation
  (undefined behaviour, [expr.shift]/1-3, [expr.mul]/4, [expr.pre]/4), sure: at the operation's node."
  [e & msg]
  (throw (ex-info (apply str "not a constant: " msg) {:codegen/not-constant true :cx/sure true :cx/at (or (:cx-at e) (some-> *ce-pos* deref))})))

(defn- ce-sure!
  "h-cpp-consteval (the checker): ub! at the evaluation's last position; outside the checker, not a constant."
  [& msg]
  (if (checking?)
    (throw (ex-info (apply str "not a constant: " msg) {:codegen/not-constant true :cx/sure true :cx/at (some-> *ce-pos* deref)}))
    (throw (ex-info (apply str "not a constant: " msg) {:codegen/not-constant true}))))

;; (cpp-def, the checker: [expr.eq]/3, two functions' addresses compared by == or != -- each operand a function's name, its
;; function-to-pointer conversion -- equal when they are one function's: 1 or 0, else nil; cpp1y/constexpr-89074-3.C's
;; `fn1 != fn1`, `fn1 == fn2`)
(declare checking?)
(defn- ce-fn-cmp [e]
  (when (and (checking?) (#{"==" "!="} (:o e)))
    (let [f (fn f [x] (cond (not (map? x)) nil
                            (= :fnaddr (:op x)) (when (and (:fn x) (nil? (:e x))) (:fn x))
                            (and (= :cast (:op x)) (= :noop (:ck x))) (f (:e x))
                            :else nil))
          a (f (:l e)) b (f (:r e))]
      (when (and a b)
        (if (= (= a b) (= "==" (:o e))) 1 0)))))

(defn- not-constant [& msg] (when (System/getenv "CPP_NC_STACK") (.printStackTrace (Exception. ^String (apply str msg)))) (throw (ex-info (apply str "not a constant: " msg) {:codegen/not-constant true})))

(defn- ce-ptr?
  "CP374 (a): whether the evaluator's value is a pointer: {::base B ::i I}, B the elements' values (a string literal's, a
  vector) or a local array's atom holding them, I the index (0 to the count, one past the last element)."
  [v]
  (and (map? v) (contains? v ::base)))

(declare ce-get ce-loc?)

;; (h-cpp-consteval: a base may also be the location of an array subobject, {::cell ::path}: a member array's elements)
(defn- ce-elems [p] (let [b (::base p)] (cond (vector? b) b (ce-loc? b) (let [v (ce-get b)] (if (vector? v) v (not-constant "a pointer into a non-array"))) :else @b)))

(defn- ce-ptr-add
  "The pointer `p` moved by `n` elements ([expr.add]/4: within its array or one past it, else not a constant)."
  [p ^long n]
  (let [i (+ (long (::i p)) n)]
    (if (<= 0 i (long (or (::n p) (count (ce-elems p))))) (assoc p ::i i) (ce-sure! "pointer arithmetic outside the bounds of its array (index " i ")"))))

(defn- ce-same-base? [a b]
  (let [x (::base a) y (::base b)]
    (or (identical? x y) (and (map? x) (map? y) (contains? x ::cell) (identical? (::cell x) (::cell y)) (= (::path x) (::path y))))))

;; CP378 (a): class objects. An object's value is a map {::cls C, field index -> value, [:b B] -> a base subobject's value}
;; (immutable: a copy is the value itself, [class.copy.ctor]'s memberwise copy of a literal class); an object lives in a
;; cell, an atom (a local's, a parameter's, a temporary's), and an lvalue of it or of a subobject is a location
;; {::cell A ::path P} (P the field indices and base keys from the cell's value down), also the value of a pointer to it
;; (`this`) and of a reference bound to it.

(defn- ce-loc? [v] (and (map? v) (contains? v ::cell)))

(defn- ce-gaddr?
  "cpp-rt-own2: whether the evaluator's value is the address of an object of static storage duration: {::gaddr VAR-ID ::off
  BYTES}, made by ce-global-addr under ce-object alone; passed, stored and returned, never read through or computed with."
  [v]
  (and (map? v) (contains? v ::gaddr)))

(defn ce-null?
  "cpp-tzdb: whether the evaluator's value is ce-object's null pointer, {::gaddr ::null}: an object's pointer member a null pointer
  constant initialized (<atomic>'s atomic<T*>{nullptr}, tzdb.cc's constinit statics)."
  [v]
  (and (ce-gaddr? v) (= ::null (::gaddr v))))

(defn ce-global-addr
  "cpp-rt-own2: [var-id byte-offset] of an address value of ce-object's object (the code generator's pointer leaf), else nil."
  [v]
  (when (and (ce-gaddr? v) (not (ce-null? v))) [(::gaddr v) (::off v)]))

(defn ce-union-member
  "cpp-rt-own2: the active member's index of a union's value of ce-object's, nil when none is."
  [v]
  (when (map? v) (first (filter integer? (keys v)))))

(defn- ce-member-name [cid k]
  (let [c (abi/cls cid)] (str (:name c) "::" (:name (nth (:fields c) k nil)))))

(defn- ce-union? [x] (boolean (and (map? x) (::cls x) (:union (abi/cls (::cls x))))))

(defn- ce-union-active [x] (first (filter integer? (keys x))))

(defn- ce-get
  "The value at location `l` (an uninitialized subobject, nil there, is not a constant: [expr.const]/5.9).
  h-cpp-consteval (the checker, sure): a union's member other than its active one ([class.union.general]/2, [expr.const]/5.10),
  a member never initialized ([expr.const]/5.9: GCC's \"accessing uninitialized member\")."
  [l]
  (let [l (ce-res l)]
  (when (and *ce-dead* (contains? @*ce-dead* (::cell l))) (ce-sure! "accessing an object outside its lifetime"))
  ;; (cpp-sweep, the checker: [expr.const]/5.9 with /4, a read of a namespace-scope or static member variable not usable in
  ;; constant expressions, or of its subobject -- not constexpr, not a const integral one -- sure: GCC's "the value of 'b' is not
  ;; usable in a constant expression", cpp0x/constexpr-ex3.C's b.t)
  (when (and (= ::unknown @(::cell l)) (checking?) (::uvar l))
    (let [v (var* (::uvar l))]
      (when (and (:name v) (not (:constexpr v)) (not (:cx-constexpr v)) (not (and (:c (:ty v)) (abi/integral? (:ty v)))))
        (ce-sure! "the value of '" (:name v) "' is not usable in a constant expression"))))
  (when (and (= ::unknown @(::cell l)) (checking?) (::uref l))
    (ce-sure! "'" (:name (var* (::uref l))) "' is not a constant expression"))
  (when (= ::unknown @(::cell l)) (not-constant "a read of an object of unknown value"))
  (let [p (::path l) v @(::cell l)
        x (loop [x v ks (seq p)]
            (if-let [[k & more] ks]
              (do (when (and (vector? x) (integer? k) (not (< -1 (long k) (count x))))
                    (ce-sure! "array subscript value '" k "' is outside the bounds of array"))
                  (when (and (integer? k) (ce-union? x) (not (contains? x k)))
                    (if-let [a (ce-union-active x)]
                      (ce-sure! "accessing '" (ce-member-name (::cls x) k) "' member instead of initialized '" (ce-member-name (::cls x) a) "' member")
                      (ce-sure! "accessing uninitialized member '" (ce-member-name (::cls x) k) "'")))
                  (recur (get x k) more))
              x))]
    (when (nil? x)
      (when (System/getenv "CPP_CE_TRACE") (binding [*out* *err*] (println "ce-get" (pr-str p) (pr-str v))))
      (cond (and (seq p) (::cls v)) (ce-sure! "accessing uninitialized member")
            (empty? p) (ce-sure! "the value of an uninitialized variable is not usable in a constant expression")
            :else (not-constant "a read of an uninitialized object")))
    x)))

(declare ce-fresh-of ce-zero-of)

(defn- ce-lhs-steps
  "The path steps the assignment's left operand `x` names by member access and subscripts ([class.union.general]/6's S(E))."
  ^long [x]
  (case (:op x)
    :field (inc (ce-lhs-steps (:obj x)))
    :deref (let [a (:e x)]
             (if (and (= :ptradd (:op a)) (= :decay (:op (:p a)))) (inc (ce-lhs-steps (:e (:p a)))) 0))
    0))

(declare ce-const-type?)

(defn- ce-implicit-lifetime?
  "Whether a member of type `t` can begin its lifetime by a store to a subobject ([class.union.general]/6: its default
  constructor neither deleted nor nontrivial; here, a class with no constructor of its own and no const or reference member
  without a default member initializer, nor such a base or member)."
  [t]
  (let [u (abi/unq t)]
    (cond (abi/arr? u) (ce-implicit-lifetime? (:of u))
          (abi/class? u) (let [c (abi/cls (:id u))]
                           (and c
                                (not-any? (fn [[_ f]] (and (= :ctor (:kind f)) (= (:cls f) (:id u)) (not (:implicit f)))) @*fns*)
                                (every? (fn [fl] (and (not (abi/ref? (:ty fl))) (or (:init fl) (not (ce-const-type? (:ty fl)))) (ce-implicit-lifetime? (:ty fl)))) (:fields c))
                                (every? #(ce-implicit-lifetime? {:k :class :id (:cls %)}) (:bases c))))
          :else true)))

(defn- ce-union-write!
  "h-cpp-consteval: before a store through location `l` by the assignment `e` (left operand `x`), the subobjects on its path
  made: a member not there yet a fresh object of its type; through a union's member that is not its active one (the
  checker's rules, sure), the member made active when the assignment names it by member access and subscripts from C++20
  on ([class.union.general]/6), else not a constant (\"change of the active member\" before C++20, [expr.const]/5.10 of
  C++17; from C++20 an access out of the member's lifetime, \"accessing ... member instead of initialized ...\" or
  \"accessing uninitialized member\")."
  ([e x l] (ce-union-write! e x l false))
  ([e x l create?]
  (let [l (ce-res l) p (vec (::path l)) n (count p) syn (if create? 1 (if x (ce-lhs-steps x) 0))]
    (loop [j 0]
      (when (< j n)
        (let [pre (subvec p 0 j) k (nth p j)
              v (if (seq pre) (get-in @(::cell l) pre) @(::cell l))]
          (when (and (vector? v) (integer? k) (not (< -1 (long k) (count v))))
            (ub! e "array subscript value '" k "' is outside the bounds of array"))
          (when (and (integer? k) (map? v) (::cls v) (not (contains? v k)))
            (let [c (abi/cls (::cls v)) fl (nth (:fields c) k nil)]
              (when fl
                (when (:union c)
                  (let [a (ce-union-active v) named (>= j (- n syn))]
                    (cond (not (checking?)) (when a (not-constant "a union's member changed"))
                          (< (long *cxx-year*) 20) (when a (ub! e "change of the active member of a union from '" (ce-member-name (::cls v) a) "' to '" (ce-member-name (::cls v) k) "'"))
                          ;; (cpp-ce2: a new-expression's object at the member itself, its creation, [intro.object]/1)
                          (and named (or create? (ce-implicit-lifetime? (:ty fl)))) nil
                          a (ub! e "accessing '" (ce-member-name (::cls v) k) "' member instead of initialized '" (ce-member-name (::cls v) a) "' member")
                          :else (ub! e "accessing uninitialized member '" (ce-member-name (::cls v) k) "'"))))
                (let [u (assoc (if (:union c) (select-keys v [::cls]) v) k (ce-fresh-of (:ty fl)))]
                  (if (seq pre) (swap! (::cell l) assoc-in pre u) (reset! (::cell l) u))))))
          (recur (inc j))))))))

(defn- ce-fresh-of
  "An object of type `t` whose lifetime began with no initialization (h-cpp-consteval): a class's {::cls}, an array's
  elements fresh, a scalar's nil (indeterminate)."
  [t]
  (let [u (abi/unq t)]
    (cond (abi/class? u) {::cls (:id u)}
          (abi/arr? u) (vec (repeat (long (or (:n u) 0)) (ce-fresh-of (:of u))))
          :else nil)))

(defn- ce-put! [l x]
  (let [l (ce-res l)]
  (when (= ::unknown @(::cell l)) (not-constant "a write to an object of unknown value"))
  (let [p (::path l)] (if (seq p) (swap! (::cell l) assoc-in p x) (reset! (::cell l) x)) x)))

;; cpp-rt-own3 (DECISION cpp-rt-own2-1 (a)): the objects an evaluation names but never reads, clang's ExprConstant: an automatic or
;; static variable's object outside the evaluation, whose lvalue is formed without a read (T::ms(a) of a local `a` folds in every
;; dialect), and since C++23 the object a reference variable outside the evaluation refers to (P2280R4, unknown references:
;; text_encoding.cc's range-for `auto __end = __range.end();`); a read or a write of one is no constant. One cell a variable in an
;; evaluation, so that two lvalues of one object are one location. The code generator's alone, not the checker's.
(def ^:dynamic *ce-unknown* nil) ; atom {key cell}

(defn- ce-unknown-loc [k]
  (if-let [a *ce-unknown*]
    {::cell (or (get @a k) (let [c (atom ::unknown)] (swap! a assoc k c) c)) ::path []}
    {::cell (atom ::unknown) ::path []}))

;; h-cpp-consteval: the cells of the complete const objects of an evaluation (an atom of a set of cells, compared by identity):
;; a const or constexpr local once its initialization is complete ([dcl.type.cv]/4, [expr.const]/5.16: a modification of a const
;; object in its lifetime is undefined; during its construction it is not const yet, [class.ctor.general]/5)
(def ^:dynamic *ce-const* nil)

(defn- ce-const-type? [t] (let [t (abi/non-ref t)] (boolean (or (:c t) (and (abi/arr? t) (ce-const-type? (:of t)))))))

(defn- ce-check-const!
  "h-cpp-consteval (the checker): the store through location `l` by the operation `e` modifies no const object: the cell's
  complete const object (but through a mutable member), nor a const member subobject of an object, which is const from its
  own initialization on (GCC's \"modifying a const object\", ExprConstant's note_constexpr_modify_const_type)."
  [e l]
  (let [l (ce-res l)]
  (when (and (checking?) *ce-dead* (contains? @*ce-dead* (::cell l))) (ub! e "modifying an object outside its lifetime"))
  (when (checking?)
    (loop [v @(::cell l) ks (seq (::path l)) rc (boolean (and *ce-const* (contains? @*ce-const* (::cell l))))]
      (if-let [[k & more] ks]
        (cond (and (map? v) (integer? k) (::cls v))
              (let [fl (nth (:fields (abi/cls (::cls v))) k nil)]
                (when (and fl (ce-const-type? (:ty fl))) (ub! e "modifying a const object"))
                (recur (get v k) more (boolean (and rc (not (:mutable fl))))))
              (and (vector? v) (integer? k)) (recur (nth v k nil) more rc)
              (map? v) (recur (get v k) more rc)
              :else (when rc (ub! e "modifying a const object")))
        (when rc (ub! e "modifying a const object")))))))

(defn- ce-cell-loc [v] (let [c (atom v)] (ce-adopt! c [] v) {::cell c ::path []}))

(defn- ce-static-addr
  "cpp-rt-own2: the address of the glvalue `e` as ce-gaddr? holds it when `e` names an object of static storage duration (a
  namespace-scope or static data member variable, not thread-local, not a local of the evaluation) or a non-bit-field member or
  non-virtual base subobject of one, else nil: memory_resource.cc's `__constinit constant_init<atomic_mem_res>
  default_res{&newdel_res.obj}`, constant-initialized by clang, atomic<memory_resource*>'s constructor never emitted."
  [e env]
  (let [g (letfn [(walk [e]
                    (case (:op e)
                      :var (when-not (contains? env (:id e))
                             (let [v (var* (:id e))]
                               (when (and (#{:global :member-static} (:storage v)) (not (:tls v)) (not (abi/ref? (:ty v))))
                                 {::gaddr (:id e) ::off 0})))
                      :field (when-let [g (walk (:obj e))]
                               (let [cid (some-> (:ty (:obj e)) abi/unq :id) c (when cid (abi/cls cid))
                                     fd (when c (nth (:fields c) (:i e) nil))]
                                 (when (and fd (not (:bits fd)))
                                   (update g ::off + (long (nth (:fields (abi/layout cid)) (:i e)))))))
                      :base-lv (when-let [g (walk (:e e))]
                                 (let [fc (some-> (:ty (:e e)) abi/unq :id) [_ off vb] (when fc (abi/base-path fc (:to e)))]
                                   (when (and off (nil? vb)) (update g ::off + (long off)))))
                      nil))]
            (walk e))]
    (when g (reset! *ce-gaddr* true))
    g))

(declare str-units)

(defn- fp->long
  "queue 380: a floating value's integer for a conversion ([conv.fpint]/1), or not a constant when it has none, an infinity
  or a NaN, or is past a long's range (undefined past 64 bits, so no constant, [expr.const]/5.8): ubsan/pr63956.C's
  fn11(__builtin_inf()) had crashed Sema once __builtin_inf was a value."
  ^long [v]
  (let [d (double v)]
    (when-not (< -9.2e18 d 9.2e18) (not-constant "a floating value out of an integer's range"))
    (long d)))

(defn ce-wrap
  "The value `v` as the type `t` holds it (integers wrapped to its width, bool 0/1, floats as doubles)."
  [t v]
  (let [t (abi/underlying (abi/unq t))]
    (cond
      ;; (CP374 (a): a pointer into a string literal or a local array, ce-ptr's value, as a pointer type holds it)
      (ce-ptr? v) (if (or (abi/ptr? t) (= :bool (abi/bn t))) (if (abi/ptr? t) v 1) (not-constant "a pointer as " (pr-str t)))
      ;; (CP378 (a): a pointer to an object, `this`, a location)
      (ce-loc? v) (if (abi/ptr? t) v (if (= :bool (abi/bn t)) 1 (not-constant "a pointer as " (pr-str t))))
      ;; (cpp-ce2: a pointer to data member's value)
      (and (map? v) (contains? v ::mdata)) (if (abi/mptr? t) v (not-constant "a pointer to member as " (pr-str t)))
      ;; (cpp-p2564: a function's address, *ce-fnptr*'s)
      (and (map? v) (contains? v ::fnp)) (if (abi/ptr? t) v (not-constant "a function's address as " (pr-str t)))
      ;; (cpp-rt-own2: the address of an object of static storage duration, ce-object's: a pointer's value alone)
      (ce-gaddr? v) (if (or (abi/ptr? t) (and (ce-null? v) (= :nullptr (abi/bn t)))) v (not-constant "an address as " (pr-str t)))
      (= :bool (abi/bn t)) (if (if (number? v) (not (zero? (double v))) v) 1 0)
      ;; (h-cpp-consteval, the checker: a null pointer, :null's 0)
      (and (or (abi/ptr? t) (= :nullptr (abi/bn t))) (number? v) (zero? (double v)) (checking?)) 0
      (abi/floating? t) (if (= :float (abi/bn t)) (double (unchecked-float (double v))) (double v))
      ;; (cpp-s5b, pending review 1111 #2: a 128-bit value is held as a long while it fits 64 bits, as the type's value
      ;; (an unsigned one not negative); outside, not a constant, never truncated)
      ;; (cpp-s13: reduced to the type's width, [conv.integral]/3, a BigInt when outside 64 bits: only inside an evaluation,
      ;; narrow-out refusing such a result where it leaves)
      (wide? t) (let [bits (int (* 8 (long (abi/size-of t))))
                      x (biginteger (if (float? v) (fp->long v) (ce-num v)))
                      m (.shiftLeft java.math.BigInteger/ONE bits)
                      y (.mod x m)
                      y (if (and (abi/signed? t) (.testBit y (int (dec bits)))) (.subtract y m) y)]
                  (if (< (.bitLength y) 64) (.longValue y) (bigint y)))
      (abi/integral? t) (let [bits (* 8 (abi/size-of t)) x (if (float? v) (fp->long v) (if (wide-value? v) (.longValue (biginteger v)) (long v)))]
                          (if (>= bits 64) x
                              (let [m (dec (bit-shift-left 1 bits)) y (bit-and x m)]
                                (if (and (abi/signed? t) (>= y (bit-shift-left 1 (dec bits)))) (- y (bit-shift-left 1 bits)) y))))
      :else (not-constant "a value of " (pr-str t)))))

(def ^:dynamic *ce-steps* nil)
;; CX12 (the checker): true while a constexpr function's body is evaluated (the sure rules below judge the initializer's own
;; operations only, where gcc and clang put the error on the variable's line)
(def ^:dynamic *ce-in-call* false)
;; round 54: the nesting of the evaluated calls, bounded by [implimits]'s recursive constexpr function invocations (512, clang's and
;; GCC's default; -fconstexpr-depth=N sets it, arbace.repr.cpp.diag binds it from the file's options): past it the evaluation is not
;; a constant, at the call (constexpr-recursion.C's `return f (i-1);` had overflowed the analysis' stack)
(def ^:dynamic *ce-depth* 0)
(def ^:dynamic *constexpr-depth* 512)

;; clang's EvaluateAsInitializer (VarDecl::evaluateValue, the constant initialization CodeGen tries for every variable's initializer):
;; a constant fold, not a core constant expression, so a const variable of floating type with a constant initializer reads as its value
;; (ExprConstant's CCEDiag note_constexpr_ltor_non_constexpr: noted, not refused); g++.dg's init/float1.C (cpp-90)
(def ^:dynamic *ce-fold* false)

(defn- ce-top-sure!
  "CX12 (the checker): an operation of the constexpr variable's initializer itself that [expr.const]/5 makes not a core
  constant expression whatever the values: sure, at the variable."
  [& msg]
  (when (and (checking?) (not *ce-in-call*) (not *ce-fold*))
    (throw (ex-info (apply str "not a constant: " msg) {:codegen/not-constant true :cx/sure true :cx/top (some-> *ce-pos* deref)}))))

(declare ce-loop-limit! ce-undefined? ce-lv ce-init ce-glvalue ce-store ce-construct ce-args-env ce-not-constexpr? cx-pce-bad? ce-has-label? ce-bit-cast gcc-type-str ce-base-path ce-destroy! ce-explicit-dtor! ce-dyncast ce-new ce-delete ce-heap-end!)

(def ^:dynamic *ce-analyzing*
  "h-cpp-read: the functions whose bodies a constant evaluation is analyzing (their ids), so that a call of one from within
  its own body is not evaluated again."
  #{})

(defn ce-eval
  "The constant value of the typed expression `e` (`env` {var-id atom} the locals of the evaluated calls; ::this the
  location of a member's object, ::ret the function's return type)."
  ;; (CP374 (a): a pointer is a value inside an evaluation only: as its result, not a constant -- the callers fold integers
  ;; and floats; codegen-gen's globals.cpp, a pointer global's initializer folded to a long, had crashed)
  ;; (CP378 (a): likewise an object's value or a location)
  ([e] (binding [*ce-steps* (atom 0) *ce-heap* (or *ce-heap* (atom {})) *ce-moved* (or *ce-moved* (atom {})) *ce-const* (or *ce-const* (atom #{})) *ce-pos* (or *ce-pos* (atom nil)) *ce-dead* (or *ce-dead* (atom #{})) *ce-temps* (or *ce-temps* (atom []))
                 *ce-unknown* (or *ce-unknown* (atom {}))]
        (let [top (and (checking?) (nil? *ce-heap-top*))
              w *ce-wide* v (binding [*ce-wide* true *ce-heap-top* (or *ce-heap-top* true)] (ce-eval e {}))]
          (when top (ce-heap-end! v))
          (if (or (ce-ptr? v) (map? v)) (not-constant (if (ce-ptr? v) "a pointer's value" "an object's value")) (if w v (narrow-out v))))))
  ([e env]
   ;; (cpp-ce3: the checker's budget above -fconstexpr-loop-limit's iterations of a loop of a few steps, so that its error comes first)
   (when (> (long (swap! *ce-steps* inc)) (if (checking?) 3000000 1000000)) (not-constant "too many steps"))
   (when-let [p (or (:cx-at e) (when (= :load (:op e)) (:cx-at (:e e))))] (when *ce-pos* (reset! *ce-pos* p)))
   (when (zero? (rem (long @*ce-steps*) 4096)) (tick!))
   (let [ev #(ce-eval % env)
         t (:ty e)]
     (case (:op e)
       ;; (queue 569: sizeof of a VLA, its object's elements counted)
       :vla-sizeof (let [c (get env (:var e))]
                     (if (and c (vector? @c)) (* (count @c) (long (:esize e))) (not-constant "the size of a variable-length array outside its evaluation")))
       ;; (CP378 (a): `__builtin_is_constant_evaluated()`, an :int 0 marked :ice, true when manifestly constant-evaluated)
       :int (cond (and (:ice e) *ce-manifest*) 1
                  ;; (cpp-rt-own2: __builtin_constant_p of a value that is no constant: false when manifestly constant-evaluated, else
                  ;; no constant, clang's EvaluateBuiltinConstantP)
                  (:no-fold e) (if *ce-manifest* 0 (not-constant "__builtin_constant_p of a value"))
                  :else (if (and (:ty e) (wide? (:ty e))) (ce-wrap (:ty e) (:v e)) (:v e)))
       :float (:v e)
       ;; (h-cpp-consteval, the checker: a null pointer, the value 0 of a pointer type -- not in the code generator's folds)
       ;; (cpp-tzdb: under ce-object, the object's constant initialization, a null pointer value its pointer leaf writes)
       :null (cond (checking?) 0 *ce-gaddr* {::gaddr ::null ::off 0} :else (not-constant "a null pointer"))
       ;; (CP378 (a): class objects: `this`, an address, a prvalue object, a value-initialized scalar)
       :this (ce-res (or (::this env) (not-constant "this outside a member's evaluation")))
       :addr (or (when *ce-gaddr* (ce-static-addr (:e e) env)) (ce-lv (:e e) env))
       ;; (cpp-sweep, the checker: a temporary of a type surely not literal, GCC's "temporary of non-literal type 'T' in a
       ;; constant expression" in every standard (g++ 15.2 by hand), at the evaluation's position: cpp0x/constexpr-friend.C)
       :temp-obj (do (when (and (checking?) (abi/class? (abi/unq (:ty e))) (cx-non-literal (:ty e)))
                       (ub! e "temporary of non-literal type '" (:name (abi/cls (:id (abi/unq (:ty e))))) "' in a constant expression"))
                     (ce-init (:ty e) (:init e) env))
       :zero-val (if (abi/class? (abi/unq t)) (ce-init t {:i :zero} env) 0)
       ;; (cpp-ce2, the checker: a discarded-value conversion to void, [expr.static.cast]/6: the operand evaluated, a glvalue's
       ;; object not read; a pseudo-destructor call of a scalar, [expr.call]/5, ends its object's lifetime, [basic.life]/1.4)
       :cast (if (and (= :void (:ck e)) (checking?))
               (let [x (:e e)]
                 (if (#{:lv :xv} (:cat x))
                   (let [l (ce-lv x env)]
                     (when (:cx-pseudo-dtor e)
                       (when-not (ce-loc? l) (not-constant "a pseudo-destructor's object"))
                       (when (and *ce-dead* (contains? @*ce-dead* (::cell l))) (ub! e "destroying an object outside its lifetime"))
                       (ce-check-const! e l)
                       (if (seq (::path l)) (not-constant "a pseudo-destructor call of a subobject") (ce-kill! [(::cell l)]))))
                   (ev x))
                 0)
             (let [_ (when (#{:ptr->int :int->ptr} (:ck e))
                       (if *ce-in-call* (when (checking?) (ub! e "reinterpret_cast: conversion from pointer type")) (ce-top-sure! "reinterpret_cast: conversion from pointer type")))
                   ;; (h-cpp-consteval, the checker: [expr.const]/5.15, a reinterpret_cast of any kind)
                   _ (when (and (:cx-reinterpret e) (checking?)) (ub! e "'reinterpret_cast' is not a constant expression"))
                   _ (when (and (:cx-void-cast e) (checking?)) (ub! e "cast from 'void*' is not allowed in a constant expression"))
                   v (ev (:e e))]
               (case (:ck e)
                 (:noop :int :int->fp :fp :fp->int) (if (ce-gaddr? v)
                                                      (if (= :noop (:ck e)) (ce-wrap t v) (not-constant "an address converted"))
                                                      (do
                                                      ;; (cpp-def, the checker: [conv.fpint]/1, a floating value whose truncation the
                                                      ;; integer type cannot represent -- an infinity, a NaN among them -- converts
                                                      ;; undefined, no constant: GCC's "overflow in constant expression", ubsan/pr63956.C's
                                                      ;; fn11(__builtin_inf ()))
                                                      (when (and (checking?) (= :fp->int (:ck e)) (number? v) (abi/integral? t))
                                                        (let [d (double v)
                                                              bits (* 8 (long (abi/size-of (abi/underlying (abi/unq t)))))
                                                              u (not (abi/signed? t))
                                                              half (.shiftLeft java.math.BigInteger/ONE (int (dec bits)))
                                                              lo (if u 0N (- (bigint half))) hi (if u (dec (* 2 (bigint half))) (dec (bigint half)))]
                                                          (when (or (Double/isNaN d) (Double/isInfinite d)
                                                                    (let [r (bigint (.toBigInteger (java.math.BigDecimal. d)))] (or (< r lo) (> r hi))))
                                                            (ub! e "overflow in constant expression"))))
                                                      (ce-wrap t (if (and (= :fp->int (:ck e))) (fp->long v) (from-src (:ty (:e e)) t v)))))
                 :to-bool (if (or (ce-ptr? v) (ce-loc? v) (ce-gaddr? v)) 1 (if (zero? (double v)) 0 1))
                 ;; (cpp-rt-own2: a derived class's address of static storage duration to its non-virtual base's, offset by its place)
                 ;; (cpp-ce2, the checker: a pointer to an object, its base subobject's location, [conv.ptr]/3; a null pointer null)
                 :base (cond
                         (and (checking?) (number? v) (zero? (double v))) 0
                         (and (checking?) (ce-loc? v))
                         (let [fc (some-> (:ty (:e e)) abi/unq :to abi/unq :id) tc (some-> t abi/unq :to abi/unq :id)
                               bp (when (and fc tc) (ce-base-path fc tc))]
                           (if bp (update v ::path into bp) (not-constant "a pointer to a base")))
                         :else
                         (if (ce-gaddr? v)
                         (let [fc (some-> (:ty (:e e)) abi/unq :to abi/unq :id) tc (some-> t abi/unq :to abi/unq :id)
                               [_ off vb] (when (and fc tc) (abi/base-path fc tc))]
                           (if (and off (nil? vb)) (update v ::off + (long off)) (not-constant "an address to a virtual base")))
                         (not-constant "cast :base")))

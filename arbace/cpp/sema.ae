    ("CStyleCastExpr" "CXXStaticCastExpr" "CXXReinterpretCastExpr" "CXXConstCastExpr" "CXXFunctionalCastExpr")
    (if-let [ct (when (= "CXXFunctionalCastExpr" (:kind n)) (ctad-template (:scope ctx) (get-in n [:type :qualType])))]
      (ctad-expr ctx n ct)
    (if-let [k (and (checking?) (= "CXXFunctionalCastExpr" (:kind n)) (= "auto" (str/trim (str (get-in n [:type :qualType])))) (= 1 (count (kids n)))
                    (let [k (first (kids n))] (if (= "InitListExpr" (:kind k)) (when (= 1 (count (kids k))) (first (kids k))) k)))]
      ;; (cpp-singles: C++23's auto(x) and auto{x}, [expr.type.conv]/1 with [dcl.type.auto.deduct]/2.2 (P0849R8): a prvalue of the
      ;; operand's decayed type, its result object copy-initialized from it -- cpp23/concepts-err1.C's closure-typed atom
      ;; `auto([]{})`, of no type before)
      (let [a (analyze ctx k)
            t (let [u (abi/non-ref (:ty a))] (cond (abi/arr? u) (abi/ptr (:of u)) (abi/fn? u) (abi/ptr u) :else (abi/unq u)))]
        (if (abi/class? t)
          {:op :temp-obj :init (init-for t [a] ctx :copy) :ty t :cat :pr}
          (cast-expr ctx t a true)))
    (let [t (resolve-type (:scope ctx) (get-in n [:type :qualType]))
          [k] (kids n)
          t (if (and (#{:xvalue "xvalue"} (:valueCategory n)) (not (abi/ref? t))) (abi/rref t) t)

                 ;; (cpp-def2, the checker: [expr.const]/5.6 of C++20 (P1064R0), an invocation of a virtual function for an object
                 ;; neither usable in constant expressions nor begun within the evaluation is no constant expression: the object
                 ;; through a pointer formed from a variable outside the evaluation, `static_cast<VBase*>(&m)->foo()` with `Main m;`
                 ;; a local, not constexpr; cpp2a/constexpr-virtual20.C. (A call on the variable itself, `m.foo()`, GCC
                 ;; devirtualizes, its object's type known: left as it was.)
                 (when-let [v (let [x (:obj e)]
                                (when (= :deref (:op x))
                                  (let [x (loop [x (:e x)] (if (and (map? x) (= :cast (:op x))) (recur (:e x)) x))]
                                    (when (and (map? x) (= :addr (:op x)) (map? (:e x)) (= :var (:op (:e x))) (not (contains? env (:id (:e x)))))
                                      (var* (:id (:e x)))))))]
                   (when (and (:name v) (not (abi/ref? (:ty v))) (abi/class? (abi/unq (:ty v)))
                              (not (or (:constexpr v) (:cx-constexpr v))) (#{:local :global :static-local} (:storage v)))
                     (ub! e "virtual call on '" (:name v) "', an object not usable in constant expressions, is not a constant expression")))
                 (let [o (try (ce-lv (:obj e) env) (catch arbace.lang.ExceptionInfo _ nil))]
                   (when (and (ce-loc? o) (::uref o) (empty? (::path o)))
                     (ub! e "virtual call on '" (:name (var* (::uref o))) "', an object of unknown dynamic type, is not a constant expression"))))
               (when (or (not (or (:constexpr f) (and (:cls f) (:lambda (abi/cls (:cls f))))
                                  (cx-cmp-constexpr? (:id f))))
                         (:virtual e))
                 (not-constant "a call of " (:name f)))
               ;; (h-cpp-read: a call from within the function's own definition, before its body is analyzed -- f3's
               ;; `enum E { a = f3 () };` -- is not a constant, GCC's "called in a constant expression before its definition is
               ;; complete", [expr.const]/5.3: the analysis had recursed until the stack overflowed, fatal on stage 0's Go)
               (when (and (not (:tbody f)) (contains? *ce-analyzing* (:id f)))
                 ;; (cpp-read, 2026-11-24: sure, as "used before its definition" below: GCC's error, cpp1y/constexpr-recursion1.C)
                 (if (and *ce-in-call* (not *ce-fold*))
                   (ub! e "'" (:name f) "' called in a constant expression before its definition is complete")
                   (do (ce-top-sure! "'" (:name f) "' called in a constant expression before its definition is complete")
                       (not-constant "'" (:name f) "' called in a constant expression before its definition is complete"))))
               (when-not (:tbody f) (when (:body f) (binding [*ce-manifest* false *ce-analyzing* (conj *ce-analyzing* (:id f))] (analyze-fn! (:id f)))))
               ;; (cpp-ce3, the checker: a constexpr function of the main file not defined yet where the evaluation is,
               ;; [expr.const]/5.3, GCC's "used before its definition")
               (when (ce-undefined? f)
                 (if *ce-in-call*
                   (ub! e "'" (:name f) "' used before its definition")
                   (do (ce-top-sure! "'" (:name f) "' used before its definition") (not-constant "an undefined function"))))
               (let [f (fnd (:fn e))
                     member? (and (:cls f) (not (:static f)))
                     _ (when (and member? (abi/empty-class? (:cls f)) (= :deref (:op (:obj e))) (checking?))
                         (ce-lv (:obj e) env))
                     this (when (and member? (not (abi/empty-class? (:cls f))))
                            (cond (:obj e) (ce-lv (:obj e) env)
                                  (::this env) (::this env)
                                  :else (not-constant "a member call without its object")))
                     rt (:ret (:ty f))]
                 (if (and this (= "=" (:op f)) (or (:defaulted f) (:implicit f)) (not (:body f)) (= 1 (count (:args e))))
                   ;; (a defaulted or implicit copy or move assignment: the object's value, memberwise, [class.copy.assign]/12;
                   ;; the result the object)
                   (let [v (ce-init (first (:ps (:ty f))) (first (:args e)) env)]
                     (ce-put! this (if (ce-loc? v) (ce-get v) v))
                     this)
                   (let [env2 (cond-> (assoc (ce-args-env f (:args e) env) ::ret rt ::fn (:id f)) this (assoc ::this this))
                         p0 (some-> *ce-pos* deref)
                         pce-bad (and (checking?) (cx-pce-bad? (:id f)))
                         _ (when (>= (long *ce-depth*) (long *constexpr-depth*))
                             (if (checking?)
                               (ub! e "'constexpr' evaluation depth exceeds maximum of " *constexpr-depth*)
                               (not-constant "'constexpr' evaluation depth exceeds maximum of " *constexpr-depth*)))
                         r (try (binding [*ce-in-call* true *ce-mi-at* nil *ce-depth* (inc (long *ce-depth*))] (ce-exec (:tbody f) env2))
                                (catch arbace.lang.ExceptionInfo x
                                  (if (and pce-bad (:cx/sure (ex-data x)) (not (:cx/pce (ex-data x))))
                                    (throw (ex-info (.getMessage x) (assoc (ex-data x) :cx/pce true)))
                                    (throw x))))
                         _ (when *ce-pos* (reset! *ce-pos* (or (:cx-at e) p0)))
                         _ (ce-destroy-cells! (reverse (keep #(when-not (abi/ref? (:ty (var* %))) (get env2 %)) (:params f))))
                         _ (ce-end-lives! (keep #(get env2 %) (:params f)) e)]
                     (cond (abi/void? (abi/unq rt)) 0
                           (= :ret (first r)) (if (or (abi/ref? rt) (abi/class? (abi/unq rt))) (ce-store rt (second r)) (ce-wrap t (second r)))
                           :else (not-constant "no return")))))))
       ;; (CP374 (a): pointers into string literals and arrays, as clang's ExprConstant's LValue with its designator: a
       ;; string literal's or a local array's first element by decay, moved by + and -, read by a subscript or *, compared;

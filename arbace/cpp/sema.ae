        "__alignof" {:op :int :v (abi/align-of t) :ty abi/ulong* :cat :pr}
        (fail :trait (:name n))))
    "CXXNewExpr" (new-expr ctx n)
    "CXXDeleteExpr" (let [e (rv (analyze ctx (first (kids n))))
                          ;; (cpp-diag-b, 2026-11-22: [expr.delete]/1, the operand is a pointer to object type (or of a class type
                          ;; converted to one): GCC's "type 'bool' argument given to 'delete', expected pointer", "cannot delete a

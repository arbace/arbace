(ns arbace.cpp.sema
  "The code generator's semantic analysis (doc/cpp/CODEGEN.md §3): the native parser's tree (clang's AST as data,
  arbace.repr.cpp.native) analyzed as clang's Sema analyzes it for the slice of C++ CODEGEN.md §6 names -- the
  declarations entered into scopes (namespaces, classes, blocks), every expression typed with its value category and
  its implicit conversions written out (lvalue-to-rvalue, promotions, the usual arithmetic conversions, decay, the
  pointer conversions, derived-to-base), names looked up as [basic.lookup] says (unqualified, qualified, class members
  through the bases, the operators' ADL in the classes' namespaces), overload resolution by the implicit conversion
  sequences' ranks ([over.match.best], [over.ics.rank]: exact, promotion, conversion, user-defined, ellipsis, with the
  reference bindings' qualification tie-break), initialization ([dcl.init]: default, value, copy, direct, list and
  aggregate initialization, reference binding with temporaries materialized), the implicit special members
  ([class.default.ctor], [class.copy.ctor], [class.dtor]: declared, trivial or defined), virtual functions and their
  overriders. The result is a program of typed functions and variables that arbace.cpp.codegen writes as LLVM forms.
  Anything outside the slice is refused: (ex-info ... {:codegen/refused class})."
  (:require [arbace.cpp.abi :as abi]
            [arbace.repr.cpp.scope]
            [arbace.repr.cpp.types :as ct]
            [arbace.string :as str]))

(set! *warn-on-reflection* true)

(def fail abi/fail)

;; Templates (doc/cpp/CODEGEN.md §G3) live in arbace.cpp.template, which installs these hooks: :declare (a template's
;; declaration node, nil when not one), :template-id (a type form (<> name args...)), :const-bound (an array bound
;; that is not a literal), :call-candidates (the specializations a call's function templates deduce), :tiebreak
;; ([over.match.best]/2.2-2.5: a non-template over a template, the more specialized template), :pending (the lazily
;; instantiated definitions a round of analysis made used), :wrap (the analysis run inside the templates' state).
(def hooks (atom {}))

;; ---------------------------------------------------------------------------------------------
;; State

(def ^:dynamic *src* "")
(def ^:dynamic *fns* nil)    ; atom {id fn}
(def ^:dynamic *vars* nil)   ; atom {id var}
(def ^:dynamic *ids* nil)    ; atom counter
(def ^:dynamic *order* nil)  ; atom [[:fn id] [:var id] ...] in declaration order (the definitions' emission order)

(defn- next-id [] (swap! *ids* inc))
(defn fnd [id] (get @*fns* id))
(defn var* [id] (get @*vars* id))
(defn- upd-fn! [id f & args] (apply swap! *fns* update id f args))
(defn- upd-var! [id f & args] (apply swap! *vars* update id f args))

;; A scope: {:kind :ns|:class|:block|:fn :names HashMap(name -> [entity]) :parent scope :path mangling path :cls id
;;           :usings ArrayList :pos-limited bool}
(defn- new-scope [kind parent & {:as more}]
  (merge {:kind kind :names (java.util.HashMap.) :parent parent :usings (java.util.ArrayList.)
          :path (:path parent [])}
         more))

(defn- enter! [scope ^String nm e]
  (when nm
    (let [^java.util.HashMap m (:names scope)]
      (.put m nm (conj (or (.get m nm) []) e))))
  e)

(def ^:dynamic *cutoff* Long/MAX_VALUE)
(def ^:dynamic *last-anon* nil) ; atom: the type of the last unnamed class declared (its member's or variable's type) ; a namespace-scope name declared at or after this token is not visible yet

(declare class-lookup)

(defn- own-names [scope ^String nm]
  (let [es (.get ^java.util.HashMap (:names scope) nm)
        es (if (= :ns (:kind scope)) (filterv #(< (long (or (:pos %) -1)) (long *cutoff*)) es) es)]
    (concat es (mapcat #(own-names % nm) (:usings scope)))))

(defn- find-here
  "The entities `nm` names in `scope` itself (a class: with its bases', [class.member.lookup])."
  ([scope ^String nm] (find-here scope nm false))
  ([scope ^String nm unqualified?]
   (if (= :class (:kind scope))
     (seq (map second (class-lookup (:cls scope) nm unqualified?)))
     (seq (own-names scope nm)))))

(declare header-entities)

(declare builtin-entities)

(defn lookup
  "Unqualified lookup: the entities of the first scope outward that declares `nm` (the headers' last, through the
  native parser's scopes)."
  [scope ^String nm]
  (when (= nm (System/getenv "CPP_LOOKUP_TRACE"))
    (binding [*out* *err*]
      (loop [s scope] (when s (println "lookup" nm (:kind s) (count (:usings s)) (pr-str (map #(select-keys % [:e :pos]) (.get ^java.util.HashMap (:names s) nm)))
                                       (pr-str (map (fn [u] (map #(select-keys % [:e :pos]) (.get ^java.util.HashMap (:names u) nm))) (:usings s))) *cutoff*) (recur (:parent s))))))
  (or (loop [s scope] (when s (or (find-here s nm true) (recur (:parent s)))))
      (header-entities [nm])
      (builtin-entities nm)))

;; ---------------------------------------------------------------------------------------------
;; Classes: members by name, through the bases

(defn class-lookup
  "[[class-id entity] ...]: the members named `nm` in class `id` or, if none, in its bases ([class.member.lookup]: the
  bases' sets merged, a set found in a base of another found one's class dropped -- dominance through virtual bases;
  of the rest the first). `unqualified?`: an unqualified name in a template's specialization does not look into a base
  that was dependent in the pattern ([temp.dep]/4: two-phase lookup's first phase; this-> and qualified names do)."
  ([id ^String nm] (class-lookup id nm false))
  ([id ^String nm unqualified?]
   (let [c (abi/cls id)
         own (seq (.get ^java.util.HashMap (:names (:scope c)) nm))]
     (if own
       (mapv (fn [e] [id e]) own)
       (let [found (keep #(seq (class-lookup (:cls %) nm unqualified?)) (if unqualified? (remove :dependent (:bases c)) (:bases c)))
             keep? (fn [r] (not-any? (fn [o] (abi/derived-from? (ffirst o) (ffirst r))) found))]
         (first (filter keep? found)))))))

;; ---------------------------------------------------------------------------------------------
;; Types from clang's qualType strings

(declare resolve-type-form resolve-type lookup-qualified const-int)

;; ---------------------------------------------------------------------------------------------
;; The headers' declarations: the native parser skims them into its scopes (arbace.repr.cpp.scope); a C function
;; (extern "C", its entity's :clink) and a typedef of a builtin or pointer type are taken from there

(def ^:dynamic *proot* nil)   ; the native parser's global scope
(def ^:dynamic *root* nil)    ; ours
(def ^:dynamic *header-cache* nil) ; atom {parts entities}

(defn- opaque-class
  "A class the headers declare and the program uses only through pointers (FILE's struct _IO_FILE): incomplete."
  [^String nm]
  (or (get @*header-cache* [:opaque nm])
      (let [id (next-id) t {:k :class :id id}]
        (swap! abi/*classes* assoc id {:id id :name nm :path [] :scope (new-scope :class *root* :cls id :path [[:cls id]]) :fields [] :bases [] :outer *root*})
        (swap! *header-cache* assoc [:opaque nm] t)
        t)))

(declare finish-class!)

(defn- va-list-tag
  "x86-64's struct __va_list_tag {unsigned gp_offset, fp_offset; void *overflow_arg_area, *reg_save_area;} (the SysV
  psABI §3.5.7), a complete trivial class (a va_list local is default-initialized: nothing runs)."
  []
  (or (get @*header-cache* [:va-list])
      (let [id (next-id) t {:k :class :id id}
            u (abi/b :uint) vp (abi/ptr abi/void)]
        (swap! abi/*classes* assoc id {:id id :name "__va_list_tag" :path [] :scope (new-scope :class *root* :cls id :path [[:cls id]])
                                       :bases [] :outer *root* :complete true
                                       :fields (vec (map-indexed (fn [i [nm ty]] {:name nm :ty ty :access :public :i i})
                                                                 [["gp_offset" u] ["fp_offset" u] ["overflow_arg_area" vp] ["reg_save_area" vp]]))})
        (finish-class! id)
        (swap! *header-cache* assoc [:va-list] t)
        t)))

(defn- ptype->type
  "Our type of the native parser's type map (a builtin's words, a pointer, a named type through its entity)."
  [t]
  (let [r (case (:t t)
            :b (resolve-type-form *root* (ct/builtin-symbol (:w t)))
            :p (abi/ptr (ptype->type (:of t)))
            :n (let [e (:ent t)]
                 (cond (:ty e) (ptype->type (:ty e))
                       (:target e) (ptype->type (:ty (:target e)))
                       (and (:tag e) (#{"struct" "class" "union"} (:tag e))) (opaque-class (:name e))
                       :else (fail :header-type "header type " (:s t))))
            :elab (if (#{"struct" "class" "union"} (:kw t)) (opaque-class (:s t)) (fail :header-type "header type " (:s t)))
            (fail :header-type "header type " (pr-str (dissoc t :ent))))]
    (cond-> r (:c t) (assoc :c true) (:v t) (assoc :v true))))

(def ^:private nothrow-libc
  #{"memcpy" "memmove" "memset" "memcmp" "memchr" "strlen" "strcmp" "strncmp" "strcpy" "strncpy" "strcat" "strncat" "strchr"
    "strrchr" "strstr" "strspn" "strcspn" "strpbrk" "abs" "labs" "llabs" "fabs" "sqrt" "sin" "cos" "tan" "exp" "log" "pow" "floor"
    "ceil" "fmod" "malloc" "calloc" "realloc" "free" "toupper" "tolower" "isalpha" "isdigit" "isspace" "isupper" "islower" "isalnum"})

(defn header-entities
  "Our entities for the header declaration the parts name ([\"printf\"], [\"std\" \"printf\"]), or nil."
  [parts]
  (if (= parts ["__builtin_abort"])
    ;; the builtin clang calls as abort (CodeGen's EmitBuiltinExpr for __builtin_abort)
    (or (get @*header-cache* parts)
        (let [id (next-id)]
          (swap! *fns* assoc id {:id id :name "abort" :kind :fn :ty {:k :fn :ret abi/void :ps [] :va false} :linkage :c :path []
                                 :scope *root* :param-names [] :defaults [] :pos -1 :header true})
          (swap! *header-cache* assoc parts [{:e :fn :id id :pos -1}])
          [{:e :fn :id id :pos -1}]))
  (when *proot*
    (or (get @*header-cache* parts)
        (let [pe (loop [s *proot* [p & more] parts]
                   (when s
                     (let [e (if (identical? s *proot*) (arbace.repr.cpp.scope/lookup s p) (arbace.repr.cpp.scope/find-in s p))]
                       (if (empty? more) e (recur (:scope e) more)))))
              es (when pe
                   (case (:k pe)
                     :fn (when (and (:clink pe) (not (:tmpl pe)) (:qt pe))
                           (when (:ovl pe) (fail :header-overload "an overloaded header function " (last parts)))
                           (let [id (next-id)
                                 f {:id id :name (:name pe) :kind :fn :ty (resolve-type *root* (:qt pe)) :linkage :c :path []
                                    :scope *root* :param-names [] :defaults [] :pos -1 :header true
                                    ;; the C library functions clang knows as nothrow builtins (nounwind at their calls)
                                    :noexcept (boolean (nothrow-libc (:name pe)))}]
                             (swap! *fns* assoc id f)
                             [{:e :fn :id id :pos -1}]))
                     :var (when (and (:clink pe) (:ty pe) (not (:tmpl pe)))
                            (let [id (next-id)]
                              (swap! *vars* assoc id {:id id :name (:name pe) :ty (ptype->type (:ty pe)) :storage :global :path []
                                                      :linkage :c :defined false :extern true :pos -1 :header true})
                              [{:e :var :id id :pos -1}]))
                     :type (when (and (:ty pe) (not (:tag pe)) (not (:tmpl pe))) [{:e :type :ty (ptype->type (:ty pe)) :pos -1}])
                     nil))]
          (swap! *header-cache* assoc parts es)
          es)))))

(def ^:private builtin-fns
  ;; the builtins the samples call, as the C functions they stand for (clang writes some as intrinsics)
  {"__builtin_memcpy" ["memcpy" "void *(void *, const void *, unsigned long)"]
   "__builtin_memmove" ["memmove" "void *(void *, const void *, unsigned long)"]
   "__builtin_memset" ["memset" "void *(void *, int, unsigned long)"]
   "__builtin_memcmp" ["memcmp" "int (const void *, const void *, unsigned long)"]
   "__builtin_strlen" ["strlen" "unsigned long (const char *)"]
   "__builtin_strcmp" ["strcmp" "int (const char *, const char *)"]
   "__builtin_abs" ["abs" "int (int)"]
   "__builtin_labs" ["labs" "long (long)"]
   "__builtin_strcpy" ["strcpy" "char *(char *, const char *)"]
   "__builtin_strncpy" ["strncpy" "char *(char *, const char *, unsigned long)"]
   "__builtin_strcat" ["strcat" "char *(char *, const char *)"]
   "__builtin_strncmp" ["strncmp" "int (const char *, const char *, unsigned long)"]
   "__builtin_strchr" ["strchr" "char *(const char *, int)"]
   "__builtin_strrchr" ["strrchr" "char *(const char *, int)"]
   "__builtin_memchr" ["memchr" "void *(const void *, int, unsigned long)"]
   "__builtin_printf" ["printf" "int (const char *, ...)"]
   "__builtin_puts" ["puts" "int (const char *)"]
   "__builtin_putchar" ["putchar" "int (int)"]
   "__builtin_exit" ["exit" "void (int)"]
   "__builtin_malloc" ["malloc" "void *(unsigned long)"]
   "__builtin_free" ["free" "void (void *)"]
   "__builtin_vsnprintf" ["vsnprintf" "int (char *, unsigned long, const char *, __builtin_va_list)"]
   "__builtin_vsprintf" ["vsprintf" "int (char *, const char *, __builtin_va_list)"]
   "__builtin_snprintf" ["snprintf" "int (char *, unsigned long, const char *, ...)"]
   "__builtin_sprintf" ["sprintf" "int (char *, const char *, ...)"]
   "__builtin_abort" ["abort" "void ()"]
   ;; never reached (clang writes LLVM's unreachable): abort stands for it (G4: the headers' __builtin_unreachable)
   "__builtin_unreachable" ["abort" "void ()"]})

(defn- builtin-entities [^String nm]
  (when-let [[cn qt] (builtin-fns nm)]
    (or (get @*header-cache* [:builtin nm])
        (let [id (next-id)
              es [{:e :fn :id id :pos -1}]]
          (swap! *fns* assoc id {:id id :name cn :kind :fn :ty (resolve-type *root* qt) :linkage :c :path [] :scope *root*
                                 :param-names [] :defaults [] :pos -1 :header true :noexcept (not= cn "abort")})
          (swap! *header-cache* assoc [:builtin nm] es)
          es))))

(def ^:private builtin-syms
  {'void :void 'bool :bool 'char :char 'signed-char :schar 'unsigned-char :uchar 'short :short 'unsigned-short :ushort
   'int :int 'unsigned :uint 'long :long 'unsigned-long :ulong 'long-long :llong 'unsigned-long-long :ullong
   'float :float 'double :double 'long-double :ldouble 'wchar_t :wchar 'char8_t :char8 'char16_t :char16 'char32_t :char32
   'std/nullptr_t :nullptr 'nullptr_t :nullptr 'decltype/nullptr :nullptr})

(defn- name-parts [sym] (if (namespace sym) (str/split (str sym) #"/") [(name sym)]))

(defn- type-entity [es] (first (filter #(= :type (:e %)) es)))

(def ^:dynamic *decltypes* nil) ; G4: the native parser's decltype operands {text-without-spaces node}

(declare analyze)

(defn- decltype-of
  "decltype(e) ([dcl.type.decltype]/1): the operand the native parser kept for the text `t`, analyzed in `scope`
  (unevaluated: its result is not kept); an unparenthesized id-expression or member access its entity's declared type,
  else T& for an lvalue, T&& for an xvalue, T for a prvalue."
  [scope ^String t]
  (let [n (get *decltypes* (str/replace t #"\s+" ""))]
    (when-not n
      (when (System/getenv "CPP_TMPL_TRACE") (binding [*out* *err*] (println "decltype(" t ") not kept by the parser")))
      (fail :decltype "decltype(" t ")"))
    (let [x (try (analyze {:scope scope :statics (atom [])} n)
                 ;; (an operand that does not analyze, a template's parameters in it: a dependent type, the decltype
                 ;; analyzed again where the arguments are bound; G4: __void_t<decltype(declval<_Alloc&>().allocate(...))>)
                 (catch arbace.lang.ExceptionInfo e
                   (if (:codegen/refused (ex-data e))
                     (do (when (System/getenv "CPP_TMPL_TRACE") (binding [*out* *err*] (println "decltype(" t ") dependent:" (.getMessage e))))
                         {:dependent-decltype t})
                     (throw e))))]
      (cond
        (:dependent-decltype x) {:k :tdep :base {:k :tparam :i -1 :tid -1 :name "decltype"} :names [(str "decltype(" t ")")]}
        (and (= "DeclRefExpr" (:kind n)) (= :var (:op x))) (:ty (var* (:id x)))
        (#{"DeclRefExpr" "MemberExpr"} (:kind n)) (:ty x)
        (= :lv (:cat x)) (abi/lref (:ty x))
        (= :xv (:cat x)) (abi/rref (:ty x))
        :else (:ty x)))))

(defn resolve-type-form [scope f]
  (cond
    (symbol? f)
    (if-let [n (builtin-syms f)]
      (abi/b n)
      (cond (= 'auto f) {:k :auto}
            ;; x86-64's va_list (the SysV ABI §3.5.7): struct __va_list_tag[1], the struct opaque here
            (= '__builtin_va_list f) (abi/arr 1 (va-list-tag))
            :else
      (let [parts (name-parts f)
            es (if (= 1 (count parts)) (lookup scope (first parts))
                   (or (when-let [h (:dependent-name @hooks)] (h scope parts)) (lookup-qualified scope parts)))
            e (type-entity es)]
        (or (:ty e) (fail :type "unknown type " f)))))
    (seq? f)
    (case (first f)
      * (abi/ptr (resolve-type-form scope (second f)))
      ;; references to references collapse ([dcl.ref]/7: a substituted T& or T&&)
      & (let [t (resolve-type-form scope (second f))] (abi/lref (if (abi/ref? t) (:to t) t)))
      && (let [t (resolve-type-form scope (second f))] (if (abi/ref? t) t (abi/rref t)))
      const (assoc (resolve-type-form scope (second f)) :c true)
      volatile (assoc (resolve-type-form scope (second f)) :v true)
      restrict (resolve-type-form scope (second f))
      cpp/attributed (resolve-type-form scope (last f))
      array (if (= 2 (count f))
              (abi/arr nil (resolve-type-form scope (second f)))
              (abi/arr (let [b (second f)] (cond (number? b) b (and b (:const-bound @hooks)) ((:const-bound @hooks) scope b) :else nil))
                       (resolve-type-form scope (nth f 2))))
      fn (if-let [tt (when (and (symbol? (nth f 2 nil)) (str/starts-with? (str (nth f 2)) "__") (:is-trait @hooks) ((:is-trait @hooks) (str (nth f 2))))
                       (:trait-type @hooks))]
           ;; a transform trait's type (G4: __remove_cv(T)), spelled as a function type returning the trait's name
           (tt scope (str (nth f 2)) (second f))
         (let [[_ ps r] f
               va (some #{'&} ps)
               ps (remove #{'&} ps)
               ps (if (= ['void] (vec ps)) [] ps)]
           {:k :fn :ret (resolve-type-form scope r)
            ;; a parameter of array or function type is a pointer ([dcl.fct]/5), a substituted one too
            :ps (mapv (fn [t] (cond (abi/arr? t) (abi/ptr (:of t)) (abi/fn? t) (abi/ptr t) :else t))
                      (mapcat #(if (and (seq? %) (= 'pack-expand (first %)))
                                 (if-let [h (:pack-expand @hooks)] (h scope (second %)) (fail :pack "a pack expansion"))
                                 [(resolve-type-form scope %)])
                              ps))
            :va (boolean va)}))
      cpp/elaborated (resolve-type-form scope (nth f 2))
      typename (resolve-type-form scope (second f))
      ;; decltype of the two forms headers name types by (typedef decltype(nullptr) nullptr_t; ... decltype(sizeof 0)
      ;; size_t;): the others wait for decltype proper
      decltype (let [x (second f) t (str/trim (if (and (seq? x) (= 'cpp/text (first x))) (second x) (str x)))]
                 (cond (= t "nullptr") abi/nullptr-t
                       (re-find #"^(sizeof|alignof)\b" t) abi/ulong*
                       :else (decltype-of scope t)))
      <> (if-let [h (:template-id @hooks)] (h scope f) (fail :template "template-id " (pr-str f)))
      cpp/scope (loop [t (resolve-type-form scope (second f))
                       ;; X::template Y<A>::Z: the parts after `template` (G4: __alloc_traits<_Alloc>::template rebind<_Tp>::other)
                       [p & more] (mapcat (fn [x] (if (and (seq? x) (= 'template (first x)))
                                                    (let [y (second x)] (if (and (seq? y) (= 'cpp/scope (first y))) (rest y) [y]))
                                                    [x]))
                                          (nnext f))]
                  (cond
                    (nil? p) t
                    ;; a member of a dependent type in a template's signature (CODEGEN.md G3); a member template's
                    ;; specialization among the names (G4)
                    (#{:tparam :tspec :tdep} (:k (abi/unq t)))
                    {:k :tdep :base t :names (mapv #(cond (symbol? %) (name %)
                                                          (and (seq? %) (= '<> (first %)) (symbol? (second %)))
                                                          {:name (name (second %)) :args (mapv (fn [a] (resolve-type-form scope a)) (nnext %))}
                                                          :else (fail :type "type form " (pr-str f)))
                                                   (cons p more))}
                    (not (abi/class? t)) (fail :type "a scope of a non-class " (pr-str f))
                    ;; a member template's specialization (Outer<int>::Inner<double>): its name found in the class, its
                    ;; arguments resolved here
                    (and (seq? p) (= '<> (first p)))
                    (recur ((:template-id @hooks) scope (apply list '<> {:in (:scope (abi/cls-of t)) :name (second p)} (nnext p))) more)
                    (symbol? p)
                    ;; (a qualified name: the class's members and its bases', dependent ones in the pattern too,
                    ;; [class.member.lookup]; G5: move_iterator<It>::iterator_category from __move_iter_cat)
                    (let [e (type-entity (or (seq (map second (class-lookup (:id (abi/unq t)) (name p) false)))
                                             (lookup-qualified (:scope (abi/cls-of t)) [(name p)] false)))]
                      (recur (or (:ty e) (fail :type "unknown type " (pr-str f))) more))
                    :else (fail :type "type form " (pr-str f))))
      member-ptr (let [c (resolve-type-form scope (second f))
                       u (resolve-type-form scope (nth f 2))
                       u (if (and (abi/fn? u) (or (:c u) (:const (meta (nth f 2))))) (-> u (dissoc :c) (assoc :cq true)) u)]
                   {:k :mptr :cls (:id c) :to u})
      cpp/global (binding [] (resolve-type-form (loop [s scope] (if (:parent s) (recur (:parent s)) s)) (second f)))
      (fail :type "type form " (pr-str f)))
    :else (fail :type "type form " (pr-str f))))

(defn- strip-type-attrs
  "A spelling without its GNU attributes (`void () noexcept __attribute__((noreturn))`): none of them changes the type
  the analysis needs (G4: the headers' declarations)."
  ^String [^String s]
  (if (str/includes? s "__attribute__")
    (loop [s s]
      (let [i (.indexOf s "__attribute__")]
        (if (neg? i)
          (str/trim s)
          (let [j (.indexOf s "((" i)
                k (when (>= j 0) (loop [k (+ j 2) d 2] (cond (>= k (count s)) nil (= \( (.charAt s k)) (recur (inc k) (inc d))
                                                             (= \) (.charAt s k)) (if (= d 1) (inc k) (recur (inc k) (dec d))) :else (recur (inc k) d))))]
            (if k (recur (str (subs s 0 i) (subs s k))) (str/trim s))))))
    s))

(defn resolve-type
  "The semantic type of clang's spelling `s` in `scope`."
  [scope ^String s0]
  ;; GNU's vector types (vector_size, clang's VectorType): not modelled; the attribute is no type attribute strip-type-attrs may drop
  ;; (g++.dg's ext/is_aggregate.C read a vector typedef as its element type: a wrong answer, cpp-90), so the type is refused
  (when (re-find #"vector_size__\s*\(" s0) (fail :type "a GNU vector type (" s0 ")"))
  (let [s (strip-type-attrs s0)]
  (if (re-find #"\((unnamed|anonymous) (union|struct|class|enum) at " s)
    (let [t @*last-anon*] (cond-> t (re-find #"^const " s) (assoc :c true)))
  (try (resolve-type-form scope (ct/parse-type s))
       (catch arbace.lang.ExceptionInfo e (if (:codegen/refused (ex-data e)) (throw e) (fail :type "type " s ": " (.getMessage e))))))))

(defn- method-const? [^String qt] (boolean (re-find #"\)\s*const(\s|$|&)" qt)))

(defn- method-refq
  "A member function's ref-qualifier from its type's spelling: \"&\", \"&&\" or nil ([dcl.fct]/4)."
  [^String qt]
  (second (re-find #"\)\s*(?:const\s*)?(?:volatile\s*)?(&&|&)(?:\s|$)" (or qt ""))))

;; ---------------------------------------------------------------------------------------------
;; The main file's text: qualifiers the tree does not keep

(def ^:dynamic *main-name* nil) ; the main file's name in the native tree's locations (its text is *src*)
;; the main file's directory: a header the preprocessor found beside it by a quoted #include is named relative to it in the
;; locations ("new" for libsupc++'s own <new> through -I its directory; cpp-90: its text was taken for the main file's)
(def ^:dynamic *main-dir* nil)
(def ^:private file-texts (atom {}))

(defn- loc-of
  "A location's file position: its own, or a macro token's expansion location."
  [l]
  (if (:offset l) l (:expansionLoc l)))

(defn- blank-comments
  "A header's text with its comments blanked (spaces, its newlines kept: the offsets unchanged), so that the analysis's
  readings of a node's text (a partial specialization's arguments) see no comment (G4); string and character literals
  kept."
  ^String [^String t]
  (let [sb (StringBuilder. t) n (count t)]
    (loop [i 0]
      (when (< i n)
        (let [c (.charAt t i)]
          (cond
            (or (= c \") (= c \')) (recur (loop [j (inc i)] (cond (>= j n) j (= \\ (.charAt t j)) (recur (+ j 2)) (= c (.charAt t j)) (inc j) (= \newline (.charAt t j)) j :else (recur (inc j)))))
            (and (= c \/) (< (inc i) n) (= \/ (.charAt t (inc i))))
            (recur (loop [j i] (if (or (>= j n) (= \newline (.charAt t j))) j (do (.setCharAt sb j \space) (recur (inc j))))))
            (and (= c \/) (< (inc i) n) (= \* (.charAt t (inc i))))
            (recur (loop [j i] (cond (>= j n) j
                                     (and (= \* (.charAt t j)) (< (inc j) n) (= \/ (.charAt t (inc j)))) (do (.setCharAt sb j \space) (.setCharAt sb (inc j) \space) (+ j 2))
                                     :else (do (when-not (= \newline (.charAt t j)) (.setCharAt sb j \space)) (recur (inc j))))))
            :else (recur (inc i))))))
    (.toString sb)))

(defn text-of
  "The text of the file `file` names in the tree's locations: the main file's *src*, a header's read once (G4: header
  bodies are parsed, so their nodes' text is their own file's)."
  ^String [file]
  (if (or (nil? file) (= file *main-name*))
    *src*
    (or (get @file-texts file)
        (let [f (java.io.File. ^String file)
              f (if (or (.isFile f) (.isAbsolute f) (nil? *main-dir*)) f (java.io.File. ^String *main-dir* ^String file))]
          (if (.isFile f)
            (let [t (blank-comments (String. (java.nio.file.Files/readAllBytes (.toPath f)) "ISO-8859-1"))]
              (swap! file-texts assoc file t)
              t)
            *src*)))))

(defn header-node?
  "Whether a node is a header's (G4: its location's file a header's path, not the main file's)."
  [n]
  (let [f (:file (loc-of (get-in n [:range :begin])))]
    (boolean (and (string? f) (not= f *main-name*) (or (str/starts-with? f "/") (and *main-dir* (.isFile (java.io.File. ^String *main-dir* ^String f))))))))

(defn- node-text ^String [n]
  (let [bl (loc-of (get-in n [:range :begin])) el (loc-of (get-in n [:range :end]))
        b (:offset bl) e (:offset el) l (:tokLen el)]
    (when (and b e (= (:file bl) (:file el)))
      (let [src (text-of (:file bl))]
        (when (<= (long b) (count src))
          (subs src b (max (long b) (min (count src) (+ (long e) (long (or l 0)))))))))))

(defn text-before-name
  "The text a declaration's node has before its name (its location), in its own file, or nil."
  ^String [n]
  (let [bl (loc-of (get-in n [:range :begin])) ll (loc-of (:loc n))
        b (:offset bl) l (:offset ll)]
    (when (and b l (< (long b) (long l)) (= (:file bl) (:file ll)))
      (let [src (text-of (:file bl))] (subs src b (min (count src) (long l)))))))

(defn- qualifier-before
  "The parts of the nested-name-specifier written before a declaration's name (`int ns::P::get()`: [\"ns\" \"P\"])."
  [n]
  (let [bl (loc-of (get-in n [:range :begin])) ll (loc-of (:loc n))
        b (:offset bl) l (:offset ll)]
    (when (and b l (< (long b) (long l)) (= (:file bl) (:file ll)))
      (let [src (text-of (:file bl))
            t (subs src b (min (count src) (long l)))
            m (re-find #"((?:[A-Za-z_][A-Za-z_0-9]*\s*::\s*)+)(~\s*)?$" t)]
        (when m (vec (map str/trim (remove str/blank? (str/split (second m) #"::")))))))))

(defn- split-scope
  "A qualified name's parts: the text split at the :: outside template argument lists and parentheses."
  [^String t]
  (loop [i 0 d 0 start 0 out []]
    (if (>= i (count t))
      (conj out (subs t start))
      (let [c (.charAt t i)]
        (cond
          (#{\< \(} c) (recur (inc i) (inc d) start out)
          (#{\> \)} c) (recur (inc i) (max 0 (dec d)) start out)
          (and (zero? d) (= c \:) (< (inc i) (count t)) (= \: (.charAt t (inc i)))) (recur (+ i 2) d (+ i 2) (conj out (subs t start i)))
          :else (recur (inc i) d start out))))))

(defn- ref-qualifier
  "A DeclRefExpr's written qualifier's parts and whether it starts with :: (the tree's, P13; else its text's)."
  [n]
  (if (:_wn n)
    (when (or (:globalQualifier n) (seq (:qualifier n))) [(boolean (:globalQualifier n)) (vec (:qualifier n))])
  (let [t (node-text n)]
    (when (and t (str/includes? t "::"))
      (let [g (str/starts-with? (str/trim t) "::")
            parts (vec (map str/trim (remove str/blank? (split-scope t))))]
        [g (vec (butlast parts))])))))

(defn written-targs
  "The text `name<args>` of a name expression's explicit template arguments (the tree's, P13 (b)), or nil; a node of
  no written name (the parser's own) by its text."
  [n ^String nm]
  (if (:_wn n)
    (when-let [as (:explicitTemplateArgs n)] (str nm "<" (str/join ", " as) ">"))
    (let [t (node-text n)] (when (and t (str/includes? t "<")) t))))

(defn lookup-qualified
  "The entities of a qualified name's last part, its qualifiers looked up from `scope` (the first unqualified)."
  ([scope parts] (lookup-qualified scope parts false))
  ([scope parts global?]
   (let [root (loop [s scope] (if (:parent s) (recur (:parent s)) s))]
     (loop [s (if global? root nil) [p & more] parts done []]
       (let [es (when-not (str/includes? p "<") (if s (find-here s p) (lookup scope p)))
             ;; a template-id after a qualifier: its arguments resolved where the name is written, its template
             ;; through the qualifier (ns::X<T>::v in a template's body)
             tid-type (fn [] (if (seq done)
                               (resolve-type scope (str (when global? "::") (str/join "::" (conj done p))))
                               (resolve-type (or s scope) p)))]
         (if (empty? more)
           (if (str/includes? p "<")
             [{:e :type :ty (tid-type) :pos -1}] ; a template-id names a type (A<int>)
             (or (seq es) (when (and (nil? s) (= :ns (:kind scope))) nil) (header-entities parts)))
           (let [e (if (str/includes? p "<")
                     {:e :type :ty (tid-type)} ; a template-id (Box<int>::count)
                     (first (filter #(#{:ns :type} (:e %)) es)))
                 s2 (cond (= :ns (:e e)) (:scope e)
                          (abi/class? (:ty e)) (:scope (abi/cls-of (:ty e)))
                          (abi/enum? (:ty e)) (:scope (abi/enm (:id (:ty e))))
                          :else nil)]
             (if s2
               (recur s2 more (conj done p))
               ;; a namespace only the headers declare (std::printf)
               (or (header-entities parts) (fail :lookup "no scope " p))))))))))

;; ---------------------------------------------------------------------------------------------
;; Declarations

(defn- kids [n] (filter #(and (map? %) (:kind %)) (:inner n)))

(defn body-of
  "A function declaration's body: its compound statement, or its function-try-block ([dcl.fct.def.general]/1, [except.pre]/3: the
  native parser's CXXTryStmt, as clang's FunctionDecl holds it)."
  [n]
  (first (filter #(contains? #{"CompoundStmt" "CXXTryStmt"} (:kind %)) (kids n))))

(defn- gnu-attr-arg
  "The argument of a GNU attribute `nm` among a declaration's attribute nodes (init_priority(200)): a number, or true
  when written without one; nil when absent."
  [n nm]
  (some #(when (and (= "NativeAttr" (:kind %)) (#{nm (str "__" nm "__")} (:_gnu %)))
           (or (some-> (:_arg %) str/trim parse-long) true))
        (:inner n)))

(defn- init-kid
  "A variable declaration's initializer node: its first child that is not an attribute (__attribute__((init_priority(N)))
  comes first in the tree; G5)."
  [n]
  (first (remove #(str/ends-with? (str (:kind %)) "Attr") (kids n))))

(defn- linkage-c? [scope] (:extern-c scope))

(defn- ns-scope! [parent nm anon]
  (let [k (if anon "" nm)
        ^java.util.HashMap m (:names parent)
        old (first (filter #(= :ns (:e %)) (.get m (str " ns " k))))]
    (if old
      (:scope old)
      (let [s (new-scope :ns parent :path (conj (:path parent) (if anon [:anon] [:ns nm])) :internal (or anon (:internal parent)))]
        (enter! parent (str " ns " k) {:e :ns :scope s :pos -1})
        (if anon
          (.add ^java.util.ArrayList (:usings parent) s)
          (enter! parent nm {:e :ns :scope s :pos -1}))
        s))))

(declare declare-node! special-members! finish-class!)

(defn- fn-op [^String nm] (when (str/starts-with? nm "operator") (let [o (str/trim (subs nm 8))] (when (seq o) o))))

(defn- param-nodes [n] (filter #(= "ParmVarDecl" (:kind %)) (kids n)))

(defn- same-sig? [f g]
  (and (= (:name f) (:name g)) (= (:kind f) (:kind g)) (= (boolean (:cq f)) (boolean (:cq g))) (= (:refq f) (:refq g))
       (= (mapv abi/unq (:ps (:ty f))) (mapv abi/unq (:ps (:ty g))))))

(defn- find-redecl [scope f]
  (let [^java.util.HashMap m (:names scope)]
    (some (fn [e] (when (and (= :fn (:e e)) (same-sig? (fnd (:id e)) f)) (:id e))) (.get m (case (:kind f) :ctor " ctor" :dtor " dtor" (:name f))))))

(declare analyze rv ce-try)

(defn- noexcept-of
  "Whether a function type's spelling says noexcept: `noexcept`, `noexcept(true)`, or noexcept(e) of a constant e
  true ([except.spec]/2; G4: the headers' noexcept(__and_<...>::value), evaluated in `scope`, not noexcept when it
  cannot be)."
  [scope ^String qt]
  (let [qt (or qt "")
        m (re-matcher #"\bnoexcept\b" qt)]
    (if-not (.find m)
      ;; throw(): noexcept(true) since C++17 ([except.spec]/1, clang's EST_DynamicNone)
      (boolean (re-find #"\bthrow\s*\(\s*\)" qt))
      (let [i (.end m)
            j (loop [j i] (if (and (< j (count qt)) (Character/isWhitespace (.charAt qt j))) (recur (inc j)) j))]
        (if (or (>= j (count qt)) (not= \( (.charAt qt j)))
          true
          (let [k (loop [k (inc j) d 1] (cond (>= k (count qt)) nil (= \( (.charAt qt k)) (recur (inc k) (inc d))
                                               (= \) (.charAt qt k)) (if (= d 1) k (recur (inc k) (dec d))) :else (recur (inc k) d)))
                e (when k (str/trim (subs qt (inc j) k)))]
            (cond (nil? e) false
                  (= e "true") true
                  (= e "false") false
                  ;; the operand the native parser kept (G5): analyzed with the parameters in scope, a constant
                  (get *decltypes* (str "noexcept:" (str/replace e #"\s+" "")))
                  (let [x (get *decltypes* (str "noexcept:" (str/replace e #"\s+" "")))
                        v (try (ce-try (rv (binding [*cutoff* Long/MAX_VALUE] (analyze {:scope scope} x))))
                               (catch arbace.lang.ExceptionInfo _ nil))]
                    (boolean (and v (= :int (:op v)) (not (zero? (long (:v v)))))))
                  :else (let [v (try (when-let [h (:trait-text @hooks)] (binding [*cutoff* Long/MAX_VALUE] (h scope e)))
                                     (catch arbace.lang.ExceptionInfo _ nil))]
                          (and (number? v) (not= 0 (long v)))))))))))

(def ^:dynamic *constraint-depth* 0)

(defn constraint-satisfied?
  "A constraint expression's satisfaction in `scope` ([temp.constr.constr]: the atomic constraints constant expressions
  of type bool; a substitution failure or an expression not constant is not satisfied)."
  [scope rc]
  ;; (a satisfaction that needs itself, through the constraints of the templates it instantiates, is not satisfied:
  ;; clang's "satisfaction of constraint depends on itself", [temp.constr.atomic]/3; the depth bounds it, G5)
  (try (when (> (long *constraint-depth*) 24) (fail :template "a constraint's satisfaction depends on itself"))
       (binding [*constraint-depth* (inc (long *constraint-depth*))]
         (not= 0 (long (const-int scope rc))))
       (catch arbace.lang.ExceptionInfo e
         (when (System/getenv "CPP_TMPL_TRACE") (binding [*out* *err*] (println "constraint not satisfied:" (.getMessage e))))
         false)))

(defn- always-inline-node?
  "Whether a function declaration's attributes hold GNU's always_inline ([[gnu::always_inline]], __attribute__((always_inline)))."
  [n]
  (boolean (some #(and (= "NativeAttr" (:kind %)) (#{"always_inline" "__always_inline__"} (:_gnu %))) (:inner n))))

(defn- declare-fn!
  "A function, method, constructor or destructor declaration (or definition) in `scope`; out-of-line definitions join
  their declaration. One whose trailing requires-clause is not satisfied is not declared (nil; P14 (b), G4)."
  [scope n]
  (if (and (:trailingRequiresClause n)
           ;; (its parameters in scope: requires { __lhs.base() == __rhs.base(); }, G4)
           (not (constraint-satisfied? (let [ps (new-scope :block scope)]
                                         (doseq [pn (param-nodes n) :when (:name pn)]
                                           (when-let [t (try (resolve-type scope (get-in pn [:type :qualType])) (catch arbace.lang.ExceptionInfo _ nil))]
                                             (let [id (next-id)]
                                               (swap! *vars* assoc id {:id id :name (:name pn) :ty t :storage :param})
                                               (enter! ps (:name pn) {:e :var :id id}))))
                                         ps)
                                       (:trailingRequiresClause n))))
    nil
  (let [q (when (#{"CXXMethodDecl" "CXXConstructorDecl" "CXXDestructorDecl" "FunctionDecl" "CXXConversionDecl"} (:kind n)) (qualifier-before n))
        home (if (seq q)
               (let [e (first (filter #(#{:ns :type} (:e %)) (lookup-qualified scope q)))]
                 (cond (= :ns (:e e)) (:scope e) (abi/class? (:ty e)) (:scope (abi/cls-of (:ty e))) :else (fail :lookup "qualifier " q)))
               scope)
        cid (:cls home)
        k (case (:kind n) "CXXConstructorDecl" :ctor "CXXDestructorDecl" :dtor "CXXConversionDecl" :conv (if cid :method :fn))
        qt (get-in n [:type :qualType])
        ;; (a trailing return type's decltype names the parameters: `-> decltype(make_move_iterator(__it.base()))`;
        ;; they are in its scope, [basic.scope.param]; G4)
        tscope (if (and qt (or (str/includes? qt "decltype") (str/includes? qt "noexcept(")))
                 (let [ps (new-scope :block home)]
                   (doseq [pn (param-nodes n) :when (:name pn)]
                     (when-let [t (try (resolve-type home (get-in pn [:type :qualType])) (catch arbace.lang.ExceptionInfo _ nil))]
                       (let [id (next-id)]
                         (swap! *vars* assoc id {:id id :name (:name pn) :ty t :storage :param})
                         (enter! ps (:name pn) {:e :var :id id}))))
                   ps)
                 home)
        ty (assoc (resolve-type tscope qt) :cq (method-const? qt))
        ty (dissoc ty :cq)
        nm (:name n)
        body (body-of n)
        pn (param-nodes n)
        f {:name nm :kind k :cls cid :ty ty :cq (method-const? qt) :refq (when cid (method-refq qt)) :op (when (and nm (not= k :conv)) (fn-op nm))
           ;; (a class's allocation and deallocation functions are static members, [class.free]/1)
           :static (and cid (or (= "static" (:storageClass n)) (contains? #{"operator new" "operator new[]" "operator delete" "operator delete[]"} nm)))
           :virtual (boolean (:virtual n)) :pure (boolean (:pure n))
           :constexpr (boolean (or (:constexpr n) (:_consteval n)))
           :consteval (boolean (:_consteval n))
           ;; GNU's always_inline (clang's AlwaysInlineAttr, `alwaysinline` in the IR: inlined at -O0 by LLVM's
           ;; AlwaysInliner, arbace.cpp.inline; P16 (a))
           :always-inline (always-inline-node? n)
           ;; __attribute__((constructor(N))): run before main, in llvm.global_ctors at its priority (65535 unwritten)
           :ctor-attr (when-let [x (gnu-attr-arg n "constructor")] (if (number? x) x 65535))
           :noexcept (noexcept-of tscope qt)
           :noexcept-false (boolean (re-find #"\bnoexcept\s*\(\s*false" (or qt "")))
           :linkage (if (linkage-c? home) :c :cpp)
           :internal (boolean (or (and (not cid) (= "static" (:storageClass n))) (:internal home)))
           :internal-l (boolean (and (not cid) (= "static" (:storageClass n)) (not (:internal home))))
           :inline (boolean (or (:inline n) (:constexpr n) (and cid (= scope home) (or body (:explicitlyDefaulted n)))))
           :path (:path home)
           :scope home
           :explicit (boolean (re-find #"^\s*(?:inline\s+|constexpr\s+)*explicit\b" (or (node-text n) "")))
           :defaulted (when (:explicitlyDefaulted n) true) :deleted (boolean (:explicitlyDeleted n))
           :pos (long (or (:_b n) 0))
           :src *src*}
        old (find-redecl home f)
        id (or old (next-id))
        pinfo {:param-names (mapv :name pn)
               :defaults (mapv (fn [p] (first (remove #(str/ends-with? (str (:kind %)) "Attr") (kids p)))) pn)}]
    (if old
      (upd-fn! id (fn [g] (cond-> (merge g (select-keys pinfo (if body [:param-names] [])))
                            (some some? (:defaults pinfo)) (assoc :defaults (:defaults pinfo))
                            (:always-inline f) (assoc :always-inline true)
                            body (assoc :body body :node n :def-scope scope :inits (filter #(= "CXXCtorInitializer" (:kind %)) (kids n))
                                        :inline (or (:inline g) (boolean (:inline n))))
                            ;; a header's definition: analyzed when used (G4), as clang emits an inline function
                            (and body (header-node? n)) (assoc :lazy true))))
      (do (swap! *fns* assoc id (merge f pinfo {:id id :node n :def-scope scope}
                                      (when body {:body body :inits (filter #(= "CXXCtorInitializer" (:kind %)) (kids n))})
                                      (when (and (or body (:explicitlyDefaulted n)) (header-node? n)) {:lazy true})))
          (enter! home (if (= k :ctor) " ctor" (if (= k :dtor) " dtor" nm)) {:e :fn :id id :pos (:pos f)})
          (when (= k :ctor) (abi/update-cls! cid update :ctors (fnil conj []) id))
          (when (= k :dtor) (abi/update-cls! cid assoc :dtor id))
          (when (and cid (:virtual f)) (abi/update-cls! cid update :virtuals (fnil conj []) id))
          (when cid (abi/update-cls! cid update :methods (fnil conj []) id))
          (swap! *order* conj [:fn id])
          ;; a defaulted <=> declares a defaulted == alongside it ([class.compare.default]/5)
          (when (and cid (:explicitlyDefaulted n) (= "operator<=>" nm)
                     (not (some #(= :fn (:e %)) (.get ^java.util.HashMap (:names home) "operator=="))))
            (declare-fn! scope (assoc n :name "operator==" :type {:qualType (str/replace (str qt) #"^\s*auto\b" "bool")})))))
    id)))

(defn- declare-var!
  [scope n storage]
  (let [ty (resolve-type scope (get-in n [:type :qualType]))
        q (qualifier-before n)
        home (if (seq q)
               (let [e (first (filter #(#{:ns :type} (:e %)) (lookup-qualified scope q)))]
                 (cond (= :ns (:e e)) (:scope e) (abi/class? (:ty e)) (:scope (abi/cls-of (:ty e))) :else (fail :lookup "qualifier " q)))
               scope)
        ^java.util.HashMap m (:names home)
        old (some #(when (= :var (:e %)) (:id %)) (.get m (:name n)))
        init (init-kid n)
        st (if (:cls home) :member-static storage)]
    (if (and old (seq q))
      (do (upd-var! old assoc :init init :init-style (:init n) :defined true :def-scope scope)
          (when (header-node? n) (upd-var! old #(cond-> (assoc % :defined false :pending-def true) (not (:internal %)) (assoc :linkonce true))))
          old)
      (let [id (next-id)
            v {:id id :name (:name n) :ty ty :storage st :init init :init-style (:init n) :path (:path home)
               :linkage (if (linkage-c? home) :c :cpp)
               :defined (not (or (= st :member-static) (= "extern" (:storageClass n))))
               :extern (= "extern" (:storageClass n))
               :internal-l (boolean (and (= st :global) (not (:cls home)) (or (= "static" (:storageClass n)) (and (:c ty) (not (:extern n)) (not= "extern" (:storageClass n)))) (not (:internal home))))
               :internal (boolean (or (:internal home) (= "static" (:storageClass n)) (and (= st :global) (:c ty) (not= "extern" (:storageClass n)))))
               :def-scope scope
               :init-priority (let [x (gnu-attr-arg n "init_priority")] (when (number? x) x))
               :pos (long (or (:_b n) 0))}]
        ;; a header's definition: defined when odr-used (G4: clang emits an unused inline variable not at all)
        (swap! *vars* assoc id (if (and (header-node? n) (:defined v) (= st :global))
                                 (cond-> (assoc v :defined false :pending-def true) (not (:internal v)) (assoc :linkonce true))
                                 v))
        (when (= (:name n) (System/getenv "CPP_LOOKUP_TRACE")) (binding [*out* *err*] (println "declare" (:name n) (:path home) (System/identityHashCode (:names home)) (:pos v))))
        (enter! home (:name n) {:e :var :id id :pos (:pos v)})
        (when (:cls home) (abi/update-cls! (:cls home) update :statics (fnil conj []) id))
        (swap! *order* conj [:var id])
        id))))

(defn- declare-enum! [scope n]
  (let [id (next-id)
        nm (:name n)
        scoped (boolean (:scopedEnumTag n))
        under (if-let [ft (get-in n [:fixedUnderlyingType :qualType])] (resolve-type scope ft) abi/int*)
        es (new-scope :enum scope :path (conj (:path scope) [:enum id]))
        t {:k :enum :id id}]
    (when-not nm (reset! *last-anon* t))
    (swap! abi/*enums* assoc id {:id id :name nm :path (:path scope) :under under :scope es :scoped scoped})
    (when nm (enter! scope nm {:e :type :ty t :pos (long (or (:_b n) 0))}))
    (loop [[c & more] (filter #(= "EnumConstantDecl" (:kind %)) (kids n)) v 0]
      (when c
        (let [v (if-let [x (first (kids c))] (const-int scope x) v)
              e {:e :enumerator :val v :ty t :pos (long (or (:_b c) 0))}]
          (enter! es (:name c) e)
          (when-not scoped (enter! scope (:name c) e))
          (recur more (inc (long v))))))
    t))

(defn- declare-class! [scope0 n]
  (let [nm (:name n)
        ;; a nested class defined outside its class (class L::F { ... }, [class.nest]/3): in the enclosing class's
        ;; scope (G5: <locale_classes.h>'s class locale::facet)
        q (when (:completeDefinition n) (qualifier-before n))
        scope (or (when (seq q)
                    (let [e (first (filter #(#{:ns :type} (:e %)) (lookup-qualified scope0 q)))]
                      (cond (= :ns (:e e)) (:scope e) (and e (abi/class? (:ty e))) (:scope (abi/cls-of (:ty e))) :else nil)))
                  scope0)
        ^java.util.HashMap m (:names scope)
        old (when nm (some #(when (and (= :type (:e %)) (abi/class? (:ty %))) (:id (:ty %))) (.get m nm)))
        id (or old (next-id))
        cs (or (:scope (abi/cls id)) (new-scope :class scope :cls id :path (conj (:path scope) [:cls id])))
        t {:k :class :id id}]
    (when-not old
      (swap! abi/*classes* assoc id {:id id :name nm :path (:path scope) :scope cs :fields [] :bases [] :outer scope
                                     :union (= "union" (:tagUsed n)) :header (header-node? n)})
      (when nm (enter! scope nm {:e :type :ty t :pos (long (or (:_b n) 0))})))
    (when (:completeDefinition n)
      (when nm (.put ^java.util.HashMap (:names cs) nm [{:e :type :ty t :pos -1}])) ; the injected-class-name
      (abi/update-cls! id assoc :complete true
                       :bases (vec (for [[bi bs] (map-indexed vector (:bases n))]
                                     (let [bt (resolve-type scope (get-in bs [:type :qualType]))]
                                       (cond-> {:cls (:id bt) :virtual (boolean (:isVirtual bs)) :access (keyword (or (#{"public" "protected" "private"} (:writtenAccess bs))
                                                                                                         (if (= "class" (:tagUsed n)) "private" "public")))}
                                         ;; a base dependent in a template's pattern (CODEGEN.md G3: [temp.dep]/4)
                                         (contains? (:dep-bases (abi/cls id)) bi) (assoc :dependent true))))))
      ;; alignas on the class ([dcl.align]): its alignment at least the strictest one written (a type's or a constant's)
      (when-let [as (seq (keep :_arg (filter #(= "AlignedAttr" (:kind %)) (:inner n))))]
        (abi/update-cls! id assoc :align-attr
                         (apply max (for [a as]
                                      (long (or (parse-long (str/trim a))
                                                (try (abi/align-of (resolve-type scope a)) (catch arbace.lang.ExceptionInfo _ nil))
                                                ((:const-bound @hooks) scope a)))))))
      (let [access (atom (if (= "class" (:tagUsed n)) :private :public))]
        (doseq [k (kids n)]
          (case (:kind k)
            "AccessSpecDecl" (reset! access (keyword (:access k)))
            "FieldDecl" (let [ft (resolve-type cs (get-in k [:type :qualType]))
                              i (count (:fields (abi/cls id)))
                              bits (when (:isBitfield k) (const-int cs (first (kids k))))
                              init (when (:hasInClassInitializer k) (if bits (second (kids k)) (first (kids k))))]
                          (abi/update-cls! id update :fields conj {:name (:name k) :ty ft :init init :access @access :i i :bits bits
                                                                   :anon (boolean (and (nil? (:name k)) (not bits)))})
                          (if (:name k)
                            (enter! cs (:name k) {:e :field :cls id :i i :pos -1})
                            ;; an anonymous union or struct member: its members named in the class ([class.union.anon])
                            (when (and (not bits) (abi/class? ft))
                              (doseq [[mn es] (.entrySet ^java.util.HashMap (:names (:scope (abi/cls-of ft))))
                                      e es :when (#{:field :indirect} (:e e))]
                                (enter! cs mn {:e :indirect :chain (into [[id i]] (if (= :field (:e e)) [[(:cls e) (:i e)]] (:chain e))) :pos -1})))))
            (declare-node! cs k))))
      (finish-class! id)
      (when-not nm (reset! *last-anon* t)))
    t))

(declare declare-node*!)

(def ^:dynamic *retry* nil) ; atom [[scope node] ...]: header declarations to declare again after the headers (G4)
(def ^:dynamic *header-drops* nil) ; atom [[kind name message] ...]: the header declarations not declared (G4)

(defn declare-node!
  "Enters a declaration node of namespace or class scope. A header's declaration that the analysis refuses is dropped
  (G4: a use of it fails later as an unknown name; CPP_HDR_TRACE=1 prints each)."
  [scope n]
  (if (header-node? n)
    (try (declare-node*! scope n)
         (catch arbace.lang.ExceptionInfo e
           (if (or (:codegen/refused (ex-data e)) (:codegen/not-constant (ex-data e)))
             (do (when *header-drops* (swap! *header-drops* conj [(:kind n) (:name n) (.getMessage e)]))
                 ;; a declaration that named a class template's specialization before its specialization was defined
                 ;; (<stringfwd.h>'s typedef basic_string<char> string, char_traits<char> defined later): tried again
                 ;; after the headers (clang instantiates only when the type must be complete)
                 ;; (G5: and one that named a type such a declaration declares: <ostream>'s typedef, then <iostream>'s
                 ;; extern ostream cout)
                 (when (and *retry* (re-find #"an incomplete class template|unknown type|header type" (str (.getMessage e))))
                   (swap! *retry* conj [scope n]))
                 (when (System/getenv "CPP_HDR_TRACE")
                   (binding [*out* *err*] (println "header drop:" (:kind n) (:name n) (get-in n [:range :begin :offset]) (.getMessage e) (:file (loc-of (get-in n [:range :begin]))))))
                 nil)
             (throw e))))
    (declare-node*! scope n)))

(defn- declare-node*!
  [scope n]
  (if-let [r (when-let [h (:declare @hooks)] (h scope n))]
    r
  (case (:kind n)
    "NamespaceDecl" (let [s (ns-scope! scope (:name n) (nil? (:name n)))]
                      ;; an inline namespace's members are members of the enclosing one too ([namespace.def]/7; G4:
                      ;; std::__cxx11)
                      (when (and (:isInline n) (:name n))
                        (let [^java.util.ArrayList us (:usings scope)] (when-not (some #(identical? % s) us) (.add us s))))
                      (doseq [k (kids n)] (declare-node! s k)))
    "LinkageSpecDecl" (let [s (assoc scope :extern-c (= "C" (:language n)))] (doseq [k (kids n)] (declare-node! s k)))
    ("FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXDestructorDecl" "CXXConversionDecl") (declare-fn! scope n)
    "VarDecl" (declare-var! scope n :global)
    "CXXRecordDecl" (declare-class! scope n)
    "EnumDecl" (declare-enum! scope n)
    ("TypedefDecl" "TypeAliasDecl") (enter! scope (:name n) {:e :type :ty (resolve-type scope (get-in n [:type :qualType])) :pos (long (or (:_b n) 0))})
    "NamespaceAliasDecl" (let [t (node-text n)
                               [_ target] (re-find #"=\s*([^;]+);?\s*$" (or t ""))
                               parts (vec (map str/trim (remove str/blank? (str/split (str/trim target) #"::"))))
                               e (first (filter #(= :ns (:e %)) (lookup-qualified scope parts)))]
                           (enter! scope (:name n) (assoc e :pos (long (or (:_b n) 0)))))
    "UsingDirectiveDecl" (let [t (node-text n)
                               [_ target] (re-find #"namespace\s+([^;]+);?\s*$" (or t ""))
                               parts (vec (map str/trim (remove str/blank? (str/split (str/trim target) #"::"))))
                               e (first (filter #(= :ns (:e %)) (lookup-qualified scope parts)))]
                           (when (System/getenv "CPP_LOOKUP_TRACE") (binding [*out* *err*] (println "using" (pr-str t) parts (:path (:scope e)) (count (:names (:scope e))) (System/identityHashCode (:names (:scope e))))))
                           (.add ^java.util.ArrayList (:usings scope) (:scope e)))
    ;; (a using-declaration naming a dependent base's member, resolved in the specialization: G4)
    ("UsingDecl" "UnresolvedUsingValueDecl" "UnresolvedUsingTypenameDecl")
                (let [t (node-text n)
                      [_ target] (re-find #"using\s+(?:typename\s+)?([^;]+);?\s*$" (or t ""))
                      parts (vec (map str/trim (remove str/blank? (str/split (str/trim target) #"::"))))
                      es (lookup-qualified scope parts (str/starts-with? (str/trim target) "::"))]
                  (doseq [e es] (enter! scope (last parts) (assoc e :pos (long (or (:_b n) 0))))))
    ("EmptyDecl" "StaticAssertDecl" "AccessSpecDecl" "FriendDecl") nil
    (if (str/ends-with? (str (:kind n)) "Attr") nil (fail :decl "declaration " (:kind n))))))

;; ---------------------------------------------------------------------------------------------
;; Classes completed: special members, virtual functions

(defn- user-ctors [id] (filter #(not (:implicit (fnd %))) (:ctors (abi/cls id))))
(defn- copy-ctor? [f id]
  (let [ps (:ps (:ty f))] (and (= :ctor (:kind f)) (= 1 (count ps)) (abi/ref? (first ps)) (= :ref (:k (first ps))) (= id (:id (abi/unq (:to (first ps))))))))
(defn- move-ctor? [f id]
  (let [ps (:ps (:ty f))] (and (= :ctor (:kind f)) (= 1 (count ps)) (= :rref (:k (first ps))) (= id (:id (abi/unq (:to (first ps))))))))
(defn- copy-assign? [f id]
  (let [ps (:ps (:ty f))] (and (= "operator=" (:name f)) (= 1 (count ps)) (= :ref (:k (first ps))) (= id (:id (abi/unq (:to (first ps))))))))
(defn- class-like-members [id]
  (concat (map :cls (:bases (abi/cls id)))
          (keep (fn [f] (let [t (loop [t (:ty f)] (if (abi/arr? t) (recur (:of t)) t))] (when (abi/class? t) (:id t)))) (:fields (abi/cls id)))))

(defn trivial-dtor? [id]
  (let [c (abi/cls id) d (when (:dtor c) (fnd (:dtor c)))]
    (and (or (nil? d) (and (:implicit d) (:trivial d)) (and (:defaulted d) (not (:virtual d)) (:trivial d)))
         (or (nil? d) (not (:virtual d))))))

(defn trivial-copy? [id]
  (let [c (abi/cls id)]
    (and (not (abi/dynamic? id))
         (every? #(let [f (fnd %)] (or (not (copy-ctor? f id)) (and (or (:implicit f) (:defaulted f)) (:trivial f)))) (:ctors c))
         (every? trivial-copy? (class-like-members id)))))

(defn- implicit-fn! [id k nm ty & {:as more}]
  (let [fid (next-id)
        c (abi/cls id)
        f (merge {:id fid :name nm :kind k :cls id :ty ty :implicit k :inline true :path (conj (vec (:path c)) [:cls id])
                  :scope (:scope c) :def-scope (:scope c) :linkage :cpp :param-names (mapv (fn [_] nil) (:ps ty)) :defaults [] :pos -1}
                 ;; a header class's implicit members analyzed when used (G4)
                 (when (:header c) {:lazy true})
                 more)]
    (swap! *fns* assoc fid f)
    (enter! (:scope c) (case k :ctor " ctor" :dtor " dtor" nm) {:e :fn :id fid :pos -1})
    (case k
      :ctor (abi/update-cls! id update :ctors (fnil conj []) fid)
      :dtor (abi/update-cls! id assoc :dtor fid)
      nil)
    (abi/update-cls! id update :methods (fnil conj []) fid)
    (swap! *order* conj [:fn fid])
    fid))

(defn- has-ctor-of? [id pred] (some #(pred (fnd %) id) (:ctors (abi/cls id))))

(defn finish-class!
  "A complete class: its virtual functions (declared or overriding), its implicit special members, its vtable."
  [id]
  (let [c (abi/cls id)
        t {:k :class :id id}
        cref (abi/lref (assoc t :c true))
        ;; overriders: a method of a base's virtual function's name and parameters is virtual
        base-virtuals (fn self [bid] (let [b (abi/cls bid)] (concat (:virtuals b) (mapcat #(self (:cls %)) (:bases b)))))
        bv (mapcat #(base-virtuals (:cls %)) (:bases c))]
    (doseq [mid (:methods c)]
      (let [f (fnd mid)]
        (when (and (not (:virtual f)) (#{:method :dtor} (:kind f))
                   (some #(let [g (fnd %)] (and (= (:kind g) (:kind f)) (or (= :dtor (:kind f)) (and (= (:name g) (:name f)) (= (:cq g) (:cq f)) (= (mapv abi/unq (:ps (:ty g))) (mapv abi/unq (:ps (:ty f)))))))) bv))
          (upd-fn! mid assoc :virtual true)
          (abi/update-cls! id update :virtuals (fnil conj []) mid))))
    ;; the destructor
    (let [members (class-like-members id)
          d (:dtor (abi/cls id))
          ;; [class.dtor]/8: trivial unless virtual or a base's or member's is not (a vptr alone does not make it so)
          nontriv (some #(not (trivial-dtor? %)) members)]
      (cond
        (nil? d) (let [virt (some #(let [b (abi/cls (:cls %))] (and (:dtor b) (:virtual (fnd (:dtor b))))) (:bases c))
                       fid (implicit-fn! id :dtor (str "~" (:name c)) {:k :fn :ret abi/void :ps [] :va false}
                                         :trivial (not (or nontriv virt)) :virtual (boolean virt))]
                   (when virt (abi/update-cls! id update :virtuals (fnil conj []) fid)))
        (:defaulted (fnd d)) (upd-fn! d assoc :trivial (not (or nontriv (:virtual (fnd d)))))
        :else nil))
    ;; the default constructor
    (when (empty? (:ctors (abi/cls id)))
      (let [nontriv (or (abi/dynamic? id) (some :init (:fields c))
                        (some #(let [b (abi/cls %)] (some (fn [x] (let [g (fnd x)] (and (empty? (:ps (:ty g))) (not (:trivial g))))) (:ctors b))) (class-like-members id)))]
        (implicit-fn! id :ctor (:name c) {:k :fn :ret abi/void :ps [] :va false} :trivial (not nontriv))))
    (doseq [x (:ctors (abi/cls id))]
      (let [g (fnd x)] (when (and (:defaulted g) (empty? (:ps (:ty g))))
                         ;; (trivial only when its bases' and members' default constructors are: [class.default.ctor]/3;
                         ;; G4: std::vector() = default over _Vector_impl's user-provided one)
                         (upd-fn! x assoc :trivial (not (or (abi/dynamic? id) (some :init (:fields c))
                                                            (some #(let [b (abi/cls %)] (some (fn [y] (let [g (fnd y)] (and (empty? (:ps (:ty g))) (not (:trivial g))))) (:ctors b)))
                                                                  (class-like-members id))))))))
    ;; the copy constructor and the copy assignment
    (when-not (has-ctor-of? id copy-ctor?)
      (implicit-fn! id :ctor (:name c) {:k :fn :ret abi/void :ps [cref] :va false} :trivial (trivial-copy? id)))
    (doseq [x (:ctors (abi/cls id))]
      (let [g (fnd x)] (when (and (:defaulted g) (copy-ctor? g id)) (upd-fn! x assoc :trivial (trivial-copy? id)))))
    (when-not (some #(copy-assign? (fnd %) id) (:methods (abi/cls id)))
      (implicit-fn! id :method "operator=" {:k :fn :ret (abi/lref t) :ps [cref] :va false} :op "=" :trivial (trivial-copy? id)))
    (doseq [x (:methods (abi/cls id))]
      (let [g (fnd x)] (when (and (:defaulted g) (copy-assign? g id)) (upd-fn! x assoc :trivial (trivial-copy? id)))))
    (abi/update-cls! id assoc :user-ctor (boolean (seq (filter #(not (:implicit (fnd %))) (:ctors (abi/cls id)))))
                     :user-dtor (boolean (let [d (:dtor (abi/cls id))] (and d (not (:implicit (fnd d))))))
                     :user-copy-assign (boolean (some #(let [g (fnd %)] (and (copy-assign? g id) (not (:implicit g)))) (:methods (abi/cls id)))))
    ;; the vtable: the primary base's slots, overridden, then the new virtual functions (a destructor two slots)
    (when (abi/dynamic? id)
      (let [pb (abi/primary-base id)
            inherited (if pb (:vtable (abi/cls (:cls pb))) [])
            mine (map fnd (:virtuals (abi/cls id)))
            overrides? (fn [f slot] (let [g (fnd (:fn slot))]
                                      (and (= (:kind g) (:kind f))
                                           (or (= :dtor (:kind f))
                                               (and (= (:name g) (:name f)) (= (:cq g) (:cq f)) (= (mapv abi/unq (:ps (:ty g))) (mapv abi/unq (:ps (:ty f)))))))))
            ;; a covariant return that needs an adjustment (the base's offset is not 0 or is virtual) does not reuse the slot
            ;; of the nearest overridden function: the overrider gets a slot of its own and the old slot holds a thunk
            ;; (clang's AddMethods, ComputeReturnAdjustmentBaseOffset)
            ret-class (fn [g] (let [r (abi/unq (:ret (:ty g))) t (when (#{:ptr :ref :rref} (:k r)) (abi/unq (:to r)))] (when (and t (abi/class? t)) (:id t))))
            ret-adj? (fn [f g] (let [d (ret-class f) b (ret-class g)]
                                 (boolean (and d b (not= d b) (abi/derived-from? d b)
                                               (let [[_ off vb] (abi/base-path d b)] (or vb (not (zero? (long off)))))))))
            vt0 (vec inherited)
            vt (reduce (fn [vt f]
                         (let [idxs (keep-indexed (fn [i slot] (when (overrides? f slot) i)) vt)]
                           (cond
                             (empty? idxs) vt
                             (= :dtor (:kind f)) (reduce #(assoc-in %1 [%2 :fn] (:id f)) vt idxs)
                             :else (let [n (last idxs)]
                                     (if (ret-adj? f (fnd (:fn (nth vt n)))) vt (assoc-in vt [n :fn] (:id f)))))))
                       vt0 mine)
            new-fs (remove (fn [f] (some #(= (:id f) (:fn %)) vt)) mine)
            vt (into vt (mapcat (fn [f] (if (= :dtor (:kind f)) [{:fn (:id f) :v 1} {:fn (:id f) :v 0}] [{:fn (:id f)}])) new-fs))]
        (abi/update-cls! id assoc :vtable vt)))
    ;; (the layout of the finished class, any earlier one computed while its members were entered dropped)
    (abi/update-cls! id #(-> % (assoc :finished true) (dissoc :layout)))
    (abi/layout id)
    id))

(defn aggregate?
  "[dcl.init.aggr]/1 (C++20): an array, or a class with no user-declared constructors, no private or protected direct
  non-static data members, no virtual functions and no virtual, private or protected bases."
  [t]
  (or (abi/arr? t)
      (and (abi/class? t)
           (let [id (:id t) c (abi/cls id)]
             (and (not (:user-ctor c)) (not (abi/dynamic? id))
                  (every? #(= :public (:access %)) (:fields c))
                  (every? #(= :public (:access %)) (:bases c)))))))

;; ---------------------------------------------------------------------------------------------
;; Constant integers (enumerators, array bounds, case labels)

(declare analyze rv init-list-elem)

(declare ce-eval)

(defn const-int [scope n]
  (let [e (binding [*cutoff* Long/MAX_VALUE] (rv (analyze {:scope scope} n)))]
    (letfn [(ev [e]
              (case (:op e)
                :int (:v e)
                :cast (let [v (ev (:e e))] (if (abi/integral? (:ty e)) v (fail :const "constant cast")))
                :unop (let [v (ev (:e e))] (case (:o e) "-" (- (long v)) "+" v "~" (bit-not (long v)) "!" (if (zero? (long v)) 1 0)))
                :binop (let [a (long (ev (:l e))) b (long (ev (:r e)))]
                         (case (:o e) "+" (+ a b) "-" (- a b) "*" (* a b) "/" (quot a b) "%" (rem a b) "<<" (bit-shift-left a b)
                               ">>" (bit-shift-right a b) "&" (bit-and a b) "|" (bit-or a b) "^" (bit-xor a b)
                               "<" (if (< a b) 1 0) ">" (if (> a b) 1 0) "<=" (if (<= a b) 1 0) ">=" (if (>= a b) 1 0)
                               "==" (if (= a b) 1 0) "!=" (if (not= a b) 1 0) "&&" (if (and (not= a 0) (not= b 0)) 1 0)
                               "||" (if (or (not= a 0) (not= b 0)) 1 0)))
                :cond (if (zero? (long (ev (:c e)))) (ev (:else e)) (ev (:then e)))
                :cmp (let [a (long (ev (:l e))) b (long (ev (:r e)))]
                       (case (:o e) "<" (if (< a b) 1 0) ">" (if (> a b) 1 0) "<=" (if (<= a b) 1 0) ">=" (if (>= a b) 1 0)
                             "==" (if (= a b) 1 0) "!=" (if (not= a b) 1 0)))
                :not (if (zero? (long (ev (:e e)))) 1 0)
                :land (if (and (not= 0 (long (ev (:l e)))) (not= 0 (long (ev (:r e))))) 1 0)
                :lor (if (or (not= 0 (long (ev (:l e)))) (not= 0 (long (ev (:r e))))) 1 0)
                :load (let [v (var* (:id (:e e)))] (if (and (:c (:ty v)) (:init v)) (const-int (:def-scope v) (:init v)) (ce-eval e)))
                (ce-eval e)))]
      (ev e))))

;; ---------------------------------------------------------------------------------------------
;; Constant evaluation ([expr.const]): the typed expressions of integral and floating values, calls of constexpr
;; functions with their parameters, locals, conditions, loops and assignments (as clang's ExprConstant evaluates them,
;; for what the slice's code asks: initializers of globals, constexpr and const integral locals, array bounds and case
;; labels); anything else is not a constant (ex-info {:codegen/not-constant true})

(declare analyze-fn! stmt ce-exec)

(defn- not-constant [& msg] (when (System/getenv "CPP_NC_STACK") (.printStackTrace (Exception. ^String (apply str msg)))) (throw (ex-info (apply str "not a constant: " msg) {:codegen/not-constant true})))

(defn ce-wrap
  "The value `v` as the type `t` holds it (integers wrapped to its width, bool 0/1, floats as doubles)."
  [t v]
  (let [t (abi/underlying (abi/unq t))]
    (cond
      (= :bool (abi/bn t)) (if (if (number? v) (not (zero? (double v))) v) 1 0)
      (abi/floating? t) (if (= :float (abi/bn t)) (double (float (double v))) (double v))
      (abi/integral? t) (let [bits (* 8 (abi/size-of t)) x (long (if (float? v) (long (double v)) v))]
                          (if (>= bits 64) x
                              (let [m (dec (bit-shift-left 1 bits)) y (bit-and x m)]
                                (if (and (abi/signed? t) (>= y (bit-shift-left 1 (dec bits)))) (- y (bit-shift-left 1 bits)) y))))
      :else (not-constant "a value of " (pr-str t)))))

(def ^:dynamic *ce-steps* nil)

;; clang's EvaluateAsInitializer (VarDecl::evaluateValue, the constant initialization CodeGen tries for every variable's initializer):
;; a constant fold, not a core constant expression, so a const variable of floating type with a constant initializer reads as its value
;; (ExprConstant's CCEDiag note_constexpr_ltor_non_constexpr: noted, not refused); g++.dg's init/float1.C (cpp-90)
(def ^:dynamic *ce-fold* false)

(defn ce-eval
  "The constant value of the typed expression `e` (`env` {var-id atom} the locals of the evaluated calls)."
  ([e] (binding [*ce-steps* (atom 0)] (ce-eval e {})))
  ([e env]
   (when (> (long (swap! *ce-steps* inc)) 1000000) (not-constant "too many steps"))
   (let [ev #(ce-eval % env)
         t (:ty e)]
     (case (:op e)
       :int (:v e)
       :float (:v e)
       :cast (let [v (ev (:e e))]
               (case (:ck e)
                 (:noop :int :int->fp :fp :fp->int) (ce-wrap t (if (and (= :fp->int (:ck e))) (long (double v)) v))
                 :to-bool (if (zero? (double v)) 0 1)
                 (not-constant "cast " (:ck e))))
       :unop (let [v (ev (:e e))]
               (ce-wrap t (case (:o e) "-" (if (float? v) (- (double v)) (- (long v))) "+" v "~" (bit-not (long v)))))
       :not (if (zero? (long (ev (:e e)))) 1 0)
       :binop (let [a (ev (:l e)) b (ev (:r e))]
                (if (abi/floating? t)
                  (let [a (double a) b (double b)]
                    (ce-wrap t (case (:o e) "+" (+ a b) "-" (- a b) "*" (* a b) "/" (/ a b) (not-constant "op " (:o e)))))
                  (let [a (long a) b (long b) u (not (abi/signed? t))]
                    (ce-wrap t (case (:o e)
                                 "+" (+ a b) "-" (- a b) "*" (* a b)
                                 "/" (if (zero? b) (not-constant "division by zero") (if u (Long/divideUnsigned a b) (quot a b)))
                                 "%" (if (zero? b) (not-constant "division by zero") (if u (Long/remainderUnsigned a b) (rem a b)))
                                 "<<" (bit-shift-left a b) ">>" (if u (unsigned-bit-shift-right a b) (bit-shift-right a b))
                                 "&" (bit-and a b) "|" (bit-or a b) "^" (bit-xor a b))))))
       :cmp (let [a (ev (:l e)) b (ev (:r e))
                  c (if (or (float? a) (float? b)) (compare (double a) (double b))
                        (if (abi/signed? (:ct e)) (compare (long a) (long b)) (Long/compareUnsigned (long a) (long b))))]
              (if (case (:o e) "<" (neg? c) ">" (pos? c) "<=" (<= c 0) ">=" (>= c 0) "==" (zero? c) "!=" (not (zero? c))) 1 0))
       :land (if (and (not (zero? (long (ev (:l e))))) (not (zero? (long (ev (:r e)))))) 1 0)
       :lor (if (or (not (zero? (long (ev (:l e))))) (not (zero? (long (ev (:r e)))))) 1 0)
       :cond (if (zero? (long (ev (:c e)))) (ev (:else e)) (ev (:then e)))
       :comma (do (ev (:l e)) (ev (:r e)))
       :load (let [x (:e e)]
               (if (and (= :var (:op x)) (contains? env (:id x)))
                 @(get env (:id x))
                 (let [v (when (= :var (:op x)) (var* (:id x)))
                       init (or (:init v) (:init-node v))]
                   (if (and v (:c (:ty v)) init (or (abi/integral? (:ty v)) (:constexpr v) (and *ce-fold* (abi/floating? (:ty v)))))
                     (ce-wrap (:ty v) (ce-eval (rv (binding [*cutoff* Long/MAX_VALUE] (analyze {:scope (or (:def-scope v) *root*)} init))) {}))
                     (not-constant "a load")))))
       :assign (let [x (:l e)] (when-not (and (= :var (:op x)) (contains? env (:id x))) (not-constant "an assignment"))
                 (let [v (ce-wrap (:ty x) (ev (:r e)))] (reset! (get env (:id x)) v) v))
       :cassign (let [x (:l e)] (when-not (and (= :var (:op x)) (contains? env (:id x))) (not-constant "an assignment"))
                  (let [old @(get env (:id x))
                        r (ev (:r e))
                        ct (:ct e)
                        v (ce-eval {:op :binop :o (:o e) :ty ct :l {:op (if (float? old) :float :int) :v old} :r {:op (if (float? r) :float :int) :v r}} env)
                        v (ce-wrap (:ty x) v)]
                    (reset! (get env (:id x)) v) v))
       :incdec (let [x (:e e)] (when-not (and (= :var (:op x)) (contains? env (:id x))) (not-constant "an increment"))
                 (let [old @(get env (:id x)) nv (ce-wrap (:ty x) ((if (= "++" (:o e)) + -) old 1))]
                   (reset! (get env (:id x)) nv) (if (:post e) old nv)))
       :call (let [f (fnd (:fn e))]
               (when (or (not (:constexpr f)) (:obj e) (and (:cls f) (not (:static f)))) (not-constant "a call of " (:name f)))
               (when-not (:tbody f) (when (:body f) (analyze-fn! (:id f))))
               (let [f (fnd (:fn e))
                     ;; (an argument of an empty class, a tag such as true_type: a value nothing reads; G4)
                     args (mapv (fn [i pid] (cond (= :expr (:i i)) (ev (:e i))
                                                  (let [t (abi/unq (abi/non-ref (:ty (var* pid))))] (and (abi/class? t) (abi/empty-class? (:id t)))) ::empty
                                                  :else (not-constant "an argument")))
                                (:args e) (:params f))
                     env2 (into {} (map (fn [pid a] [pid (atom (if (= ::empty a) a (ce-wrap (:ty (var* pid)) a)))]) (:params f) args))
                     r (ce-exec (:tbody f) env2)]
                 (if (= :ret (first r)) (ce-wrap t (second r)) (not-constant "no return"))))
       (not-constant "the expression " (:op e))))))

(defn- ce-exec
  "Executes a constexpr function's typed statement: [:normal], [:ret v], [:break] or [:continue]."
  [s env]
  (case (:s s)
    (nil :null) [:normal]
    :block (let [env (atom env)]
             (loop [[x & more] (mapcat #(if (:flat %) (:items %) [%]) (:items s))]
               (if (nil? x) [:normal]
                   (if (= :decl (:s x))
                     (let [v (var* (:var x)) init (:init x)
                           val (case (:i init) :expr (ce-eval (:e init) @env) (:zero :none) 0 (not-constant "a local's initializer"))]
                       (swap! env assoc (:var x) (atom (ce-wrap (:ty v) val)))
                       (recur more))
                     (let [r (ce-exec x @env)] (if (= :normal (first r)) (recur more) r))))))
    :return (cond (:void-e s) [:ret 0] (:init s) [:ret (ce-eval (:e (:init s)) env)] :else [:ret 0])
    :expr (do (ce-eval (:e s) env) [:normal])
    :if (if (zero? (long (ce-eval (:cond s) env))) (if (:else s) (ce-exec (:else s) env) [:normal]) (ce-exec (:then s) env))
    :while (loop [] (if (zero? (long (ce-eval (:cond s) env))) [:normal]
                        (let [r (ce-exec (:body s) env)] (case (first r) :ret r :break [:normal] (recur)))))
    :do (loop [] (let [r (ce-exec (:body s) env)]
                   (case (first r) :ret r :break [:normal]
                         (if (zero? (long (ce-eval (:cond s) env))) [:normal] (recur)))))
    :for (loop [] (if (and (:cond s) (zero? (long (ce-eval (:cond s) env)))) [:normal]
                      (let [r (ce-exec (:body s) env)]
                        (case (first r) :ret r :break [:normal]
                              (do (when (:inc s) (ce-eval (:inc s) env)) (recur))))))
    :break [:break]
    :continue [:continue]
    (not-constant "the statement " (:s s))))

(defn ce-call-fn
  "The value of the call of the constexpr function `fid` with the integral constants `args` ([expr.const]; an array
  bound written as a call), or an ex-info {:codegen/not-constant true}."
  [fid args]
  (let [f (fnd fid)]
    (when-not (:constexpr f) (not-constant "a call of " (:name f)))
    (when-not (:tbody f) (when (:body f) (analyze-fn! (:id f))))
    (let [f (fnd fid)]
      (binding [*ce-steps* (atom 0)]
        (let [env (into {} (map (fn [pid a] [pid (atom (ce-wrap (:ty (var* pid)) a))]) (:params f) args))
              r (ce-exec (:tbody f) env)]
          (if (= :ret (first r)) (ce-wrap (:ret (:ty f)) (second r)) (not-constant "no return")))))))

(defn ce-try
  "The constant `e` folds to (a typed literal of its type), or nil."
  [e]
  (try (let [v (ce-eval e) t (abi/unq (:ty e))]
         (if (abi/floating? t) {:op :float :v (double v) :ty t :cat :pr} {:op :int :v (long v) :ty t :cat :pr}))
       (catch arbace.lang.ExceptionInfo x (when-not (:codegen/not-constant (ex-data x)) (when-not (:codegen/refused (ex-data x)) (throw x))) nil)))

(defn fold-mark
  "The condition `c` with :folds true or false when it constant-folds to an integer as clang's CodeGen asks
  (ConstantFoldsToSimpleInteger: EvaluateAsInt, not a constant-evaluated context; the code generator then writes only the
  live branch of an if, a conditional operator, && and ||)."
  [c]
  (if-let [v (ce-try c)]
    (if (= :int (:op v)) (assoc c :folds (not (zero? (long (:v v))))) c)
    c))

;; ---------------------------------------------------------------------------------------------
;; Expressions: typed nodes {:op ... :ty T :cat :lv|:xv|:pr}

(defn- lv? [e] (#{:lv :xv} (:cat e)))

(defn- cast-node [e ck t] {:op :cast :ck ck :e e :ty t :cat :pr})

(defn- fn-matching
  "The function of the overload set `e` whose type is the function type `ft` (the address of an overloaded function,
  [over.over]), or its only one when `ft` is nil."
  [e ft]
  (let [fs (:fns e)
        same? #(let [g (fnd %)] (and (not (and (:cls g) (not (:static g))))
                                     (= (mapv abi/unq (:ps (:ty g))) (mapv abi/unq (:ps ft))) (= (abi/unq (:ret (:ty g))) (abi/unq (:ret ft)))))]
    (if ft
      (or (first (filter same? fs))
          ;; the templates' specializations deduced from the target type ([over.over]/2: a non-template preferred)
          (when-let [h (and (seq (:tmpls e)) (:fnaddr-specs @hooks))] (first (filter same? (h e ft)))))
      (when (= 1 (count fs)) (first fs)))))

(defn mptr-fn-node [fid]
  (let [f (fnd fid)]
    {:op :mptr-fn :fn fid :ty {:k :mptr :cls (:cls f) :to (cond-> (:ty f) (:cq f) (assoc :cq true))} :cat :pr}))

(defn rv
  "The prvalue of a glvalue of non-class type (lvalue-to-rvalue), an array's decay, a function's."
  [e]
  (let [t (:ty e)]
    (cond
      (= :fnset (:op e)) (if-let [f (fn-matching e nil)] {:op :fnaddr :fn f :ty (abi/ptr (:ty (fnd f))) :cat :pr} e)
      (= :mptr-fnset (:op e)) (if (= 1 (count (:fns e))) (mptr-fn-node (first (:fns e))) e)
      (abi/arr? t) {:op :decay :e e :ty (abi/ptr (:of t)) :cat :pr}
      ;; a function lvalue: its address; *p of a function pointer p: p itself
      (abi/fn? t) (if (= :deref (:op e)) (:e e) {:op :fnaddr :e e :fn (:fn e) :ty (abi/ptr t) :cat :pr})
      (and (= :var (:op e)) (:c t) (abi/integral? t) (:init (var* (:id e))) (not= :local (:storage (var* (:id e)))))
      (let [v (var* (:id e))
            c (try (const-int (or (:def-scope v) *root*) (:init v)) (catch arbace.lang.ExceptionInfo _ nil))]
        (if c {:op :int :v c :ty (abi/unq t) :cat :pr} {:op :load :e e :ty (abi/unq t) :cat :pr}))
      ;; o.k of a constant static member: o evaluated, k folded (not an odr-use)
      (and (= :comma (:op e)) (= :var (:op (:r e))) (lv? e) (not (abi/class? t)))
      (let [r (rv (:r e))] (if (= :int (:op r)) {:op :comma :l (:l e) :r r :ty (:ty r) :cat :pr} {:op :load :e e :ty (abi/unq t) :cat :pr}))
      (and (lv? e) (not (abi/class? t))) {:op :load :e e :ty (abi/unq t) :cat :pr}
      :else e)))

(defn- promote-type [t]
  (let [t (abi/unq t)]
    (cond
      (abi/enum? t) (let [u (abi/underlying t)] (promote-type u))
      (#{:bool :char :schar :uchar :short :ushort :char8 :char16} (abi/bn t)) abi/int*
      :else t)))

(def ^:private unsigned-of {:int :uint :long :ulong :llong :ullong})

(defn arith-common
  "The usual arithmetic conversions' type ([expr.arith.conv])."
  [a b]
  (when-not (and (abi/arith? (abi/unq (abi/underlying (abi/unq a)))) (abi/arith? (abi/unq (abi/underlying (abi/unq b)))))
    (fail :type "arithmetic on " (pr-str (select-keys a [:k :n :id])) " and " (pr-str (select-keys b [:k :n :id]))))
  (let [a (promote-type a) b (promote-type b)]
    (cond
      (or (= :ldouble (abi/bn a)) (= :ldouble (abi/bn b))) (abi/b :ldouble)
      (or (= :double (abi/bn a)) (= :double (abi/bn b))) abi/double*
      (or (= :float (abi/bn a)) (= :float (abi/bn b))) abi/float*
      (= a b) a
      :else
      (let [ra (long (abi/int-ranks (abi/bn a))) rb (long (abi/int-ranks (abi/bn b)))
            ua (contains? abi/unsigned-ns (abi/bn a)) ub (contains? abi/unsigned-ns (abi/bn b))]
        (cond
          (= ua ub) (if (>= ra rb) a b)
          (and ua (>= ra rb)) a
          (and ub (>= rb ra)) b
          :else (let [[s u] (if ua [b a] [a b])]
                  (if (> (abi/size-of s) (abi/size-of u)) s (abi/b (unsigned-of (abi/bn s))))))))))

(defn- null-constant? [e]
  (or (= :nullptr (abi/bn (:ty e)))
      (and (= :int (:op e)) (zero? (long (:v e))) (abi/integral? (:ty e)) (not (abi/enum? (:ty e))))))

(defn- class-id [t] (when (abi/class? (abi/unq t)) (:id (abi/unq t))))

(defn convert-scalar
  "The standard conversion of the prvalue `e` to the scalar type `t` (implicit or, with `explicit?`, a cast's)."
  [e t explicit?]
  (let [e (if (and (= :fnset (:op e)) (abi/ptr? (abi/unq t)) (abi/fn? (:to (abi/unq t))))
            (if-let [f (fn-matching e (:to (abi/unq t)))] {:op :fnaddr :fn f :ty (abi/ptr (:ty (fnd f))) :cat :pr} (fail :conversion "no function of the set matches"))
            e)
        e (if (= :mptr-fnset (:op e))
            (let [mt (abi/unq t)
                  ok (filter #(let [n (mptr-fn-node %)] (= (:to (:ty n)) (:to mt))) (:fns e))]
              (if (and (abi/mptr? mt) (seq ok)) (mptr-fn-node (first ok)) (rv e)))
            e)
        from (abi/unq (:ty e)) to (abi/unq t)]
    (cond
      (= from to) e
      (abi/void? to) (cast-node e :void to)
      (= :bool (abi/bn to)) (cast-node e :to-bool to)
      (and (abi/integral? from) (abi/integral? to)) (if (= (abi/llvm-type from) (abi/llvm-type to)) (cast-node e :noop to) (cast-node e :int to))
      (and (abi/integral? from) (abi/floating? to)) (cast-node e :int->fp to)
      (and (abi/floating? from) (abi/integral? to)) (cast-node e :fp->int to)
      (and (abi/floating? from) (abi/floating? to)) (cast-node e :fp to)
      (and (abi/ptr? to) (null-constant? e)) {:op :null :ty to :cat :pr}
      (and (abi/mptr? to) (null-constant? e)) {:op :null :ty to :cat :pr}
      (and (abi/mptr? to) (abi/mptr? from) (abi/derived-from? (:cls to) (:cls from)))
      {:op :mptr-adj :e e :off (second (abi/base-path (:cls to) (:cls from))) :ty to :cat :pr}
      (and (abi/ptr? to) (abi/ptr? from))
      (let [fc (class-id (:to from)) tc (class-id (:to to))]
        (cond
          (and fc tc (abi/derived-from? fc tc)) (cast-node e :base to)
          (and fc tc explicit? (abi/derived-from? tc fc)) (cast-node e :derived to)
          :else (cast-node e :noop to)))
      (and (abi/ptr? to) (abi/integral? from) explicit?) (cast-node e :int->ptr to)
      (and (abi/integral? to) (abi/ptr? from) explicit?) (cast-node e :ptr->int to)
      (and (abi/ptr? to) (= :nullptr (abi/bn from))) {:op :null :ty to :cat :pr}
      :else (fail :conversion "conversion from " (pr-str from) " to " (pr-str to)))))

;; Implicit conversion sequences: {:rank 0 exact, 1 promotion, 2 conversion, 3 user-defined, 4 ellipsis, :sub n}

(declare ctor-candidates resolve-overload)

(defn- std-rank
  "The rank of the standard conversion from the prvalue type `from` (expression e) to the non-reference type `to`, or nil."
  [e from to]
  (let [from (abi/unq from) to (abi/unq to)]
    (cond
      (= from to) 0
      (and (abi/arith? to) (or (abi/arith? from) (and (abi/enum? from) (not (:scoped (abi/enm (:id from)))))))
      (if (= (promote-type from) to)
        (if (or (abi/enum? from) (contains? abi/int-ranks (abi/bn from))) 1 2)
        (if (and (= :float (abi/bn from)) (= :double (abi/bn to))) 1 2))
      (and (= :bool (abi/bn to)) (or (abi/ptr? from) (abi/arith? from))) 2
      (and (abi/ptr? to) (null-constant? e)) 2
      (and (abi/ptr? to) (abi/ptr? from))
      (let [ft (:to from) tt (:to to)]
        (cond
          (and (= (abi/unq ft) (abi/unq tt)) (or (:c tt) (not (:c ft)))) (if (= ft tt) 0 0)
          (and (abi/void? tt) (or (:c tt) (not (:c ft)))) 2
          (and (class-id ft) (class-id tt) (abi/derived-from? (class-id ft) (class-id tt)) (or (:c tt) (not (:c ft)))) 2
          :else nil))
      (and (abi/mptr? to) (null-constant? e)) 2
      (and (abi/mptr? to) (abi/mptr? from) (= (:to from) (:to to)) (abi/derived-from? (:cls to) (:cls from))) 2
      (and (= :bool (abi/bn to)) (abi/mptr? from)) 2
      :else nil)))

(defn- arr-unq "A type without its cv-qualifiers, an array's at its elements ([basic.type.qualifier]/3)." [t]
  (if (abi/arr? t) (assoc (abi/unq t) :of (arr-unq (:of t))) (abi/unq t)))
(defn- arr-cv "The type whose qualifiers are the type's (an array's elements')." [t] (if (abi/arr? t) (arr-cv (:of t)) t))

(defn conv-fns
  "The conversion functions of class `id` and its bases ([class.conv.fct]), a derived class's hiding a base's of the same
  name."
  [id]
  (let [c (abi/cls id)
        own (filter #(= :conv (:kind (fnd %))) (:methods c))
        names (set (map #(:name (fnd %)) own))]
    (concat own (remove #(names (:name (fnd %))) (mapcat #(conv-fns (:cls %)) (:bases c))))))

(defn- conv-for
  "The conversion function of class `id` that converts best to the non-class type `t` (explicit ones when
  `explicit?`), or nil."
  [id t explicit?]
  (let [cands (for [fid (conv-fns id)
                    :let [f (fnd fid)] :when (or explicit? (not (:explicit f)))
                    :let [rt (abi/non-ref (:ret (:ty f)))
                          r (if (= (abi/unq rt) (abi/unq t)) 0 (std-rank {:op :call :ty rt} rt t))] :when r]
                [r fid])]
    (second (first (sort-by first cands)))))

(def ^:dynamic *no-user* false) ; inside a user-defined conversion: standard conversions only ([over.best.ics]/4)

(defn ics
  "The implicit conversion sequence of the argument `e` (a typed expression or {:op :init-list}) to the parameter type `p`."
  [e p]
  (let [pt (abi/non-ref p)
        at (:ty e)]
    (cond
      ;; an overload set converts to a pointer to function only ([over.over]; G5: std::endl among operator<<'s candidates)
      (and (= :fnset (:op e)) (not (and (abi/ptr? (abi/unq pt)) (abi/fn? (:to (abi/unq pt)))))) nil
      (= :init-list (:op e))
      (cond (init-list-elem pt) (let [el (init-list-elem pt) rs (map #(ics % el) (:items e))]
                                  ;; [over.ics.list]/5: the worst conversion of an element
                                  (when (every? some? rs) {:rank (reduce max 0 (map #(long (:rank %)) rs))}))
            (and (abi/class? pt) (or (aggregate? pt) (seq (ctor-candidates (:id pt))))) {:rank 3}
            (and (abi/scalar? pt) (<= (count (:items e)) 1)) {:rank (if (seq (:items e)) (or (std-rank (rv (first (:items e))) (:ty (rv (first (:items e)))) pt) 9) 0)}
            :else nil)
      (abi/ref? p)
      (let [same (= (arr-unq at) (arr-unq pt))
            derived (and (class-id at) (class-id pt) (abi/derived-from? (class-id at) (class-id pt)))
            cv-ok (or (:c (arr-cv pt)) (not (:c (arr-cv at))))]
        (cond
          (and (= :ref (:k p)) (lv? e) (= :lv (:cat e)) (or same derived) cv-ok) {:rank (if derived 2 0) :sub (if (and (:c pt) (not (:c at))) 1 0)}
          (and (= :rref (:k p)) (not= :lv (:cat e)) (or same derived)) {:rank (if derived 2 0) :sub -1}
          (and (= :ref (:k p)) (lv? e) (not (:c pt))) nil
          (and (= :ref (:k p)) (not (:c pt))) nil
          ;; a const lvalue reference or an rvalue reference to a temporary
          (and (= :rref (:k p)) (= :lv (:cat e)) (or same derived)) nil
          :else (when-let [r (ics (if (lv? e) e e) pt)] (assoc r :sub (if (= :rref (:k p)) -1 (inc (long (or (:sub r) 0))))))))
      (abi/class? pt)
      (cond
        (and (class-id at) (= (class-id at) (:id pt))) {:rank 0}
        (and (class-id at) (abi/derived-from? (class-id at) (:id pt))) {:rank 2}
        *no-user* nil
        ;; the source class's conversion function to the class ([over.ics.user]; G5: strong_ordering to partial_ordering)
        (and (class-id at) (conv-for (class-id at) (abi/unq pt) false)) {:rank 3}
        :else (when (some (fn [cid] (let [f (fnd cid)]
                                      (and (not (:explicit f)) (>= (count (:ps (:ty f))) 1)
                                           (not (let [p0 (first (:ps (:ty f)))] (and (abi/ref? p0) (= (class-id (:to p0)) (:id pt)))))
                                           (<= (- (count (:ps (:ty f))) (count (filter some? (:defaults f)))) 1)
                                           (let [r (binding [*no-user* true] (ics e (first (:ps (:ty f)))))] (and r (< (long (:rank r)) 3))))))
                          (ctor-candidates (:id pt)))
                {:rank 3}))
      (abi/class? at) (when (and (not *no-user*) (conv-for (class-id at) pt false)) {:rank 3})
      (= :fnset (:op e)) (when (and (abi/ptr? (abi/unq pt)) (abi/fn? (:to (abi/unq pt))) (fn-matching e (:to (abi/unq pt)))) {:rank 0})
      :else (let [r (std-rank e (:ty (rv e)) pt)
                  ft (abi/unq (:ty (rv e))) tt (abi/unq pt)]
              ;; [over.ics.rank]/3.2.6: a pointer's qualification adjustment ranks behind the identity
              (when r {:rank r :sub (if (and (abi/ptr? ft) (abi/ptr? tt) (= (abi/unq (:to ft)) (abi/unq (:to tt)))
                                             (or (and (:c (:to tt)) (not (:c (:to ft)))) (and (:v (:to tt)) (not (:v (:to ft))))))
                                      1 0)})))))

(defn- better-ics? [a b]
  (or (< (long (:rank a)) (long (:rank b)))
      (and (= (:rank a) (:rank b)) (< (long (or (:sub a) 0)) (long (or (:sub b) 0))))))

(declare resolve-overload*)

(defn resolve-overload
  "The best viable function of `cands` (fn ids) for the arguments `args` (typed expressions; `obj` the implicit object
  argument of a method call, or nil), or a refusal."
  [cands args obj]
  (resolve-overload* (map (fn [c] [c args obj true]) (distinct cands)) (count args)))

(defn resolve-overload*
  "The best viable of the candidates `cs` ([fn-id args obj] each: a member operator's with its object, a non-member's
  with every operand, [over.match.oper]/3), `n` the operands' count, or a refusal."
  [cs ^long n0]
  (let [cands (map first cs)
        viable (for [[cid args obj prefix] cs
                     :let [f (fnd cid)
                           ps (:ps (:ty f))
                           nreq (- (count ps) (count (filter some? (take-last (count ps) (concat (repeat (count ps) nil) (:defaults f))))))
                           n (count args)]
                     :when (and (>= n nreq) (or (<= n (count ps)) (:va (:ty f))))
                     :let [convs (map-indexed (fn [i a] (if (< i (count ps)) (ics a (nth ps i)) {:rank 4})) args)
                           ;; the implicit object parameter: a const method takes a const object, a non-const prefers a non-const one
                           oc (if (and obj (:cls f) (not (:static f)) (not= :ctor (:kind f)))
                                (cond (and (:c (:ty obj)) (not (:cq f))) nil
                                      ;; a ref-qualified one ([over.match.funcs]/5): && takes an rvalue object, & (not const) an lvalue
                                      (and (= "&&" (:refq f)) (= :lv (:cat obj))) nil
                                      (and (= "&" (:refq f)) (not (:cq f)) (not= :lv (:cat obj))) nil
                                      (and (= "&&" (:refq f))) {:rank 0 :sub -1}
                                      (and (:cq f) (not (:c (:ty obj)))) {:rank 0 :sub 1}
                                      :else {:rank 0 :sub 0})
                                {:rank 0 :sub 0})]
                     :when (and oc (every? some? convs))]
                 ;; (a member operator's object is the first operand, a non-member's first operand its first argument:
                 ;; `prefix` false)
                 [cid (if prefix (cons oc convs) convs)])
        tiebreak (or (:tiebreak @hooks) (constantly false))
        better (fn [[fa a] [fb b]] (and (every? true? (map #(not (better-ics? %2 %1)) a b))
                                        (or (some true? (map better-ics? a b)) (tiebreak fa fb n0))))
        best (filter (fn [x] (every? #(or (identical? % x) (better x %)) viable)) viable)]
    (cond
      (= 1 (count best)) (ffirst best)
      (empty? viable) (fail :overload "no viable function among " (count (distinct cands)) " for " n0 " arguments: " (pr-str (map :ty (second (first cs)))))
      :else (fail :overload "ambiguous call (" (count viable) " viable)" (when (System/getenv "CPP_HDR_TRACE") (str ": " (pr-str (map (fn [[f]] [(:name (fnd f)) (:ps (:ty (fnd f))) (loc-of (get-in (:node (fnd f)) [:range :begin]))]) viable))))))))

;; ---------------------------------------------------------------------------------------------
;; Initialization ([dcl.init]): an initializer of an object of type T, written for codegen as
;;  {:i :none} default-initialization of a trivial type   {:i :zero} zero-initialization
;;  {:i :expr :e prvalue}  a scalar's value, or a class prvalue constructed in place
;;  {:i :ctor :fn id :args [...]}  a constructor call   {:i :copy :e glvalue}  a trivial copy
;;  {:i :list :items [init ...] :fill init}  an array's or an aggregate's elements (bases first)
;;  {:i :bind :e glvalue}  a reference bound to an object   {:i :bind-temp :init init :ty T}  to a temporary

(declare init-for args-for default-ctor-init method-call materialize ctor-init)

(defn user-conv
  "The class object `e` converted to the non-class type `t` by a conversion function: the call's value."
  [ctx e t explicit?]
  (let [cid (class-id (:ty e))
        fid (or (conv-for cid t explicit?) (fail :conversion "no conversion function of " (:name (abi/cls cid)) " to " (pr-str t)))
        obj (if (= :pr (:cat e)) (materialize e) e)]
    (rv (method-call ctx fid obj [] true))))

(defn ctor-candidates [id] (remove #(:deleted (fnd %)) (:ctors (abi/cls id))))

(defn- call-args
  "The parameters' initializers for a call of `f` with the typed arguments `args` (default arguments analyzed in the
  function's scope)."
  [f args ctx]
  (let [ps (:ps (:ty f))]
    (vec (concat
          (map-indexed (fn [i a] (if (< i (count ps)) (init-for (nth ps i) a ctx :copy) (let [a (rv a)]
                                                                                           (when (abi/class? (:ty a)) (fail :varargs "a class through ..."))
                                                                                           (let [t (abi/unq (:ty a))]
                                                                                             {:i :expr :e (cond (= :float (abi/bn t)) (convert-scalar a abi/double* false)
                                                                                                                (and (abi/integral? t) (not= t (promote-type t))) (convert-scalar a (promote-type t) false)
                                                                                                                :else a)}))))
                       args)
          (for [i (range (count args) (count ps))]
            (let [d (nth (:defaults f) i nil)]
              (when-not d (fail :call "missing argument"))
              (init-for (nth ps i) (binding [*cutoff* Long/MAX_VALUE] (analyze (assoc ctx :scope (:scope f)) d)) ctx :copy)))))))

(defn init-list-elem
  "E when the type `t` (cv-qualified, or a reference to it) is std::initializer_list<E>, else nil."
  [t]
  (let [u (abi/unq (abi/non-ref t))]
    (when (abi/class? u)
      (let [c (abi/cls (:id u))]
        (when (and (= "initializer_list" (:name c)) (= [[:ns "std"]] (:path c)) (seq (:targs c)))
          (abi/unq (first (:targs c))))))))

(defn- std-init-list
  "The prvalue std::initializer_list<E> a braced list `l` initializes ([dcl.init.list]/5-6, clang's
  CXXStdInitializerListExpr): a backing array const E[N] whose elements are copy-initialized from the list's, the
  object its first element's address and N; nil when an element does not convert to E."
  [t l ctx]
  (let [e (init-list-elem t) items (:items l)]
    (when (every? #(ics % e) items)
      {:op :std-init-list :elem e :n (count items) :items (mapv #(init-for e % ctx :copy) items)
       :ty (abi/unq (abi/non-ref t)) :cat :pr})))

(defn- init-list-ctors
  "The initializer-list constructors of class `id` ([dcl.init.list]/2): a first parameter std::initializer_list<E> or a
  reference to one, every other with a default argument."
  [id]
  (filter #(let [f (fnd %) ps (:ps (:ty f))]
             (and (seq ps) (init-list-elem (first ps))
                  (<= (dec (count ps)) (count (filter some? (rest (:defaults f)))))))
          (ctor-candidates id)))

(defn- class-init
  "The initialization of an object of class type `t` by the arguments `args` (typed expressions or an init-list)."
  [t args ctx style]
  (let [id (:id (abi/unq t))]
    (cond
      ;; copy-initialization from a prvalue of the class: in place ([dcl.init]/17.6.1)
      (and (= 1 (count args)) (not= :init-list (:op (first args))) (= (class-id (:ty (first args))) id) (= :pr (:cat (first args))))
      {:i :expr :e (first args)}
      (and (= 1 (count args)) (= :init-list (:op (first args))))
      (let [l (first args)]
        (if (aggregate? (abi/unq t))
          (init-for t l ctx :list)
          (cond
            ;; T{} with a default constructor: value-initialization ([dcl.init.list]/3.5)
            (and (empty? (:items l)) (seq (filter #(let [f (fnd %)] (<= (count (:ps (:ty f))) (count (filter some? (:defaults f))))) (ctor-candidates id))))
            (default-ctor-init id true)
            ;; [over.match.list]/1.1: the initializer-list constructors with the list as one argument first
            :else
            (or (let [ils (init-list-ctors id)
                      viable (keep (fn [fid] (when-let [a (std-init-list (first (:ps (:ty (fnd fid)))) l ctx)] [fid a])) ils)]
                  (when (seq viable)
                    (let [fid (if (= 1 (count viable)) (ffirst viable) (resolve-overload (map first viable) [(second (first viable))] nil))
                          a (some #(when (= fid (first %)) (second %)) viable)]
                      {:i :ctor :fn fid :args (call-args (fnd fid) [a] ctx)})))
                ;; 1.2: all the constructors with the list's elements (each an argument, a list among them too)
                (ctor-init id (:items l) ctx (and (= 1 (count (:items l))) (= :init-list (:op (first (:items l))))))))))
      (and (empty? args)) (default-ctor-init id (= style :value))
      ;; from another class with a conversion function to this one: the conversion's prvalue ([dcl.init]/17.6.3,
      ;; [over.match.copy]; G5: strong_ordering to partial_ordering; else the copy constructor's reference would bind
      ;; through the same conversion, again and again)
      (and (= 1 (count args)) (not= :init-list (:op (first args))) (class-id (:ty (first args)))
           (not= (class-id (:ty (first args))) id) (not (abi/derived-from? (class-id (:ty (first args))) id))
           (conv-for (class-id (:ty (first args))) (abi/unq t) false))
      {:i :expr :e (user-conv ctx (first args) (abi/unq t) false)}
      :else (ctor-init id args ctx))))

(defn- ctor-init
  "A constructor of class `id` chosen for the arguments `args` by overload resolution, its call's initializer. `nested`:
  the second phase of [over.match.list] with one element itself a list, where a conversion to X by a user-defined
  conversion is not considered for a constructor's first parameter of type X or reference to X ([over.best.ics]/4)."
  ([id args ctx] (ctor-init id args ctx false))
  ([id args ctx nested]
  (let [cands (concat (ctor-candidates id) (when-let [h (:ctor-candidates @hooks)] (h id args)))
        cands (if nested (remove #(= id (class-id (abi/non-ref (or (first (:ps (:ty (fnd %)))) abi/void)))) cands) cands)
        fid (try (resolve-overload cands args nil)
                     (catch arbace.lang.ExceptionInfo e
                       (if (and (System/getenv "CPP_HDR_TRACE") (:codegen/refused (ex-data e)))
                         (fail (:codegen/refused (ex-data e)) (.getMessage e) " (constructing " (:name (abi/cls id)) ")")
                         (throw e))))
            f (fnd fid)]
        (cond
          (and (:trivial f) (= 1 (count args))) {:i :copy :e (first args) :cls id}
          ;; an immediate function's constructor of an empty class: evaluated, nothing at run time ([expr.const]/16;
          ;; G5: <compare>'s __cmp_cat::__unspec)
          (and (:consteval f) (abi/empty-class? id)) {:i :none}
          :else {:i :ctor :fn fid :args (call-args f args ctx)}))))

(defn default-ctor-init
  "Default- (or with `value?` value-) initialization of a class object."
  [id value?]
  (let [cands (filter #(let [f (fnd %)] (<= (count (:ps (:ty f))) (count (filter some? (:defaults f))))) (ctor-candidates id))
        fid (first cands)]
    (when-not fid (fail :init "no default constructor for " (:name (abi/cls id))))
    (let [f (fnd fid)]
      (cond
        (:trivial f) (if value? {:i :zero} {:i :none})
        (and value? (or (:implicit f) (:defaulted f))) {:i :zero-then :then {:i :ctor :fn fid :args []}}
        :else {:i :ctor :fn fid :args (call-args f [] {:scope (:scope f)})}))))

(defn- materialize
  "A prvalue of class type as a temporary object (an xvalue)."
  [e]
  {:op :temp :init {:i :expr :e e} :ty (:ty e) :cat :xv})

(declare aggregate?)

(defn- aggr-subs
  "The types an aggregate's elements have, in order (an array of unknown bound: as many as `n`)."
  [u n]
  (cond
    (abi/arr? u) (repeat (or (:n u) n) (:of u))
    :else (let [c (abi/cls (:id u))
                subs (concat (map (fn [b] {:k :class :id (:cls b)}) (:bases c))
                             (map :ty (remove #(and (:bits %) (nil? (:name %))) (:fields c))))]
            (if (:union c) (take 1 subs) subs))))

(declare elide-agg)

(defn- elide-sub
  "One element of type `st` initialized from the flat items `items` ([dcl.init.aggr]/16, brace elision): a braced
  item, an item that initializes it whole, or as many items as a subaggregate takes. [item rest]."
  [st items]
  (let [it (first items) u (abi/unq st)]
    (cond
      (= :init-list (:op it)) [it (rest items)]
      (and (or (abi/arr? u) (and (abi/class? u) (aggregate? u)))
           (not (and (abi/class? u) (let [k (class-id (:ty it))] (or (= k (:id u)) (and k (abi/derived-from? k (:id u)))))))
           (not (and (abi/arr? u) (= :str (:op it)))))
      (let [[sub r] (elide-agg u items)] [{:op :init-list :items sub} r])
      :else [it (rest items)])))

(defn- elide-agg [u items]
  (loop [ts (aggr-subs u (count items)) items items out []]
    (if (or (empty? ts) (empty? items))
      [out items]
      (let [[x r] (elide-sub (first ts) items)] (recur (rest ts) r (conj out x))))))

(defn- brace-elide
  "The braced list `src` for the aggregate `u` with its elided braces restored (fully braced), when some are elided."
  [u src]
  (let [items (:items src)
        one (when (= 1 (count items)) (first items))
        ;; (the native parser's semantic form braces a lone item of the class's own type as if it were elided:
        ;; {{o.a}} for a{o.a}, unwrapped: [dcl.init.list]/3.2 copies it)
        items (if (and one (= :init-list (:op one)) (= 1 (count (:items one))) (abi/class? u)
                       (= (class-id (:ty (first (:items one)))) (:id u)))
                (:items one) items)
        src (assoc src :items items)]
    (if (and (= 1 (count items)) (abi/class? u) (= (class-id (:ty (first items))) (:id u)))
      src
      (let [[out r] (elide-agg u items)]
        (if (seq r) src (assoc src :items out))))))

(defn init-for
  "The initializer of an object of type `t` from `src`: nil (none), a typed expression, an init-list node
  {:op :init-list :items [...]}, or a vector of constructor arguments (direct-initialization); `style` :copy :direct
  :list :value :default."
  [t src ctx style]
  (let [tu (abi/unq t)]
    (cond
      (and (= :init-list (:op src)) (init-list-elem t))
      (let [a (or (std-init-list t src ctx) (fail :init "a list's element does not convert to the initializer_list's"))]
        (if (abi/ref? t) {:i :bind-temp :init {:i :expr :e a} :ty (:ty a)} {:i :expr :e a}))
      (abi/ref? t)
      (let [e (if (= :init-list (:op src)) (if (= 1 (count (:items src))) (first (:items src)) (fail :init "a list for a reference")) src)
            e (if (vector? e) (if (= 1 (count e)) (first e) (fail :init "a reference from arguments")) e)
            pt (:to t)
            at (:ty e)
            same (= (arr-unq at) (arr-unq pt))
            derived (and (class-id at) (class-id pt) (abi/derived-from? (class-id at) (class-id pt)))]
        (cond
          (and (lv? e) (or same derived) (or (= :lv (:cat e)) (= :rref (:k t)) (:c pt))
               (or (not= :rref (:k t)) (not= :lv (:cat e))))
          {:i :bind :e (if derived {:op :base-lv :e e :to (class-id pt) :ty (assoc (abi/unq pt) :c (:c at)) :cat (:cat e)} e)}
          (and (= :pr (:cat e)) (or same derived) (abi/class? (abi/unq at)))
          {:i :bind-temp :init {:i :expr :e e} :ty (abi/unq at) :to (when derived (class-id pt))}
          (or (:c pt) (= :rref (:k t)))
          {:i :bind-temp :init (init-for (abi/unq pt) e ctx :copy) :ty (abi/unq pt)}
          :else (fail :init "a non-const reference to a temporary")))
      (vector? src)
      (cond
        (abi/class? tu) (class-init tu src ctx (if (and (empty? src) (= style :value)) :value :direct))
        (empty? src) {:i :zero}
        (= 1 (count src)) (init-for t (first src) ctx :direct)
        :else (fail :init "several values for a scalar"))
      (nil? src)
      (cond
        (abi/class? tu) (default-ctor-init (:id tu) (= style :value))
        (abi/arr? tu) (let [el (init-for (:of tu) nil ctx style)] (if (#{:none :zero} (:i el)) el {:i :list :items [] :fill el :n (:n tu)}))
        (= style :value) {:i :zero}
        :else {:i :none})
      (= :init-list (:op src))
      (cond
        (abi/arr? tu)
        (let [items (:items (brace-elide tu src))
              el (:of tu)]
          (if (and (= 1 (count items)) (= :str (:op (first items))) (#{:char :schar :uchar} (abi/bn (abi/unq el))))
            {:i :string :e (first items) :n (:n tu)}
            ;; (the elements not written value-initialized: analyzed only when there are some, [dcl.init.aggr]/5)
            {:i :list :items (mapv #(init-for el % ctx :copy) items) :fill (when (and (:n tu) (< (count items) (long (:n tu)))) (init-for el nil ctx :value)) :n (:n tu)}))
        (and (abi/class? tu) (aggregate? tu))
        (let [c (abi/cls (:id tu))
              items (:items (brace-elide tu src))
              ;; a single item of the class's own type copies it ([dcl.init.list]/3.2)
              _ (when (seq (:bases c)) nil)
              subs (concat (map (fn [b] {:base true :ty {:k :class :id (:cls b)}}) (:bases c))
                           (map (fn [f] {:ty (:ty f) :field f}) (remove #(and (:bits %) (nil? (:name %))) (:fields c))))
              subs (if (:union c) (take 1 subs) subs)]
          (cond
            (and (= 1 (count items)) (not= :init-list (:op (first items))) (= (class-id (:ty (first items))) (:id tu)))
            (class-init tu [(first items)] ctx :copy)
            (and (:union c) (empty? items)) {:i :zero}
            :else
            (do (when (> (count items) (count subs)) (fail :init "too many initializers"))
                {:i :list :cls (:id tu)
                 :items (vec (map-indexed (fn [i s]
                                            (if (< i (count items))
                                              (init-for (:ty s) (nth items i) ctx :copy)
                                              (if-let [d (:init (:field s))]
                                                (init-for (:ty s) (binding [*cutoff* Long/MAX_VALUE] (analyze {:scope (:scope c) :cls (:id tu) :this-type (abi/ptr tu)} d)) ctx :copy)
                                                (init-for (:ty s) {:op :init-list :items []} ctx :value))))
                                          subs))
                 :fields-used (mapv (comp :i :field) (remove :base subs))})))
        (abi/class? tu) (class-init tu [src] ctx :list)
        :else (case (count (:items src))
                0 {:i :zero}
                1 (init-for t (first (:items src)) ctx :copy)
                (fail :init "several values for a scalar")))
      (abi/class? tu) (class-init tu [src] ctx style)
      (abi/arr? tu)
      (if (= :str (:op src)) {:i :string :e src :n (:n tu)} (fail :init "an array from an expression"))
      :else
      (let [e (rv src)]
        {:i :expr :e (convert-scalar (if (abi/class? (abi/unq (:ty e))) (user-conv ctx e tu false) e) tu false)}))))

;; ---------------------------------------------------------------------------------------------
;; Analysis of expressions

(defn- int-type-of [^String qt] (case qt "int" abi/int* "unsigned int" abi/uint* "long" abi/long* "unsigned long" abi/ulong*
                                  "long long" (abi/b :llong) "unsigned long long" (abi/b :ullong) "char" abi/char* "bool" abi/bool* abi/int*))

(defn decode-string
  "The bytes of a string literal as clang prints it (\"...\" with C escapes, octal for the others)."
  ^String [^String s]
  (let [s (subs s (inc (.indexOf s "\"")) (.lastIndexOf s "\""))
        sb (StringBuilder.)]
    (loop [i 0]
      (when (< i (count s))
        (let [c (.charAt s i)]
          (if (= c \\)
            (let [d (.charAt s (inc i))]
              (cond
                (Character/isDigit d) (let [j (loop [j (inc i) k 0] (if (and (< j (count s)) (< k 3) (Character/isDigit (.charAt s j))) (recur (inc j) (inc k)) j))]
                                        (.append sb (char (Integer/parseInt (subs s (inc i) j) 8))) (recur j))
                (= d \x) (let [j (loop [j (+ i 2)] (if (and (< j (count s)) (re-matches #"[0-9a-fA-F]" (str (.charAt s j)))) (recur (inc j)) j))]
                           (.append sb (char (Integer/parseInt (subs s (+ i 2) j) 16))) (recur j))
                :else (do (.append sb (case d \n \newline \t \tab \r \return \a (char 7) \b (char 8) \f (char 12) \v (char 11) \0 (char 0) d))
                          (recur (+ i 2)))))
            (do (.append sb c) (recur (inc i)))))))
    (str sb)))

(declare capture-field)

(defn- this-expr [ctx]
  (if (:lambda ctx)
    (capture-field ctx :this)
    (do (when-not (:this-type ctx) (fail :this "this outside a method"))
        {:op :this :ty (:this-type ctx) :cat :pr})))

(defn- deref-node [e]
  (let [e (rv e)]
    (when-not (abi/ptr? (:ty e)) (fail :deref "* of a non-pointer"))
    {:op :deref :e e :ty (:to (:ty e)) :cat :lv}))

(defn- to-base-lv
  "The glvalue `obj` of a derived class seen as its base `bid`."
  [obj bid]
  (if (= (class-id (:ty obj)) bid) obj {:op :base-lv :e obj :to bid :ty (assoc {:k :class :id bid} :c (:c (:ty obj))) :cat (:cat obj)}))

(defn- field-node [obj cid i]
  (let [f (nth (:fields (abi/cls cid)) i)
        o (to-base-lv obj cid)
        ft (:ty f)]
    (if (abi/ref? ft)
      {:op :deref :e {:op :load :e {:op :field :obj o :cls cid :i i :ty abi/void :cat :lv :raw true} :ty (abi/ptr (:to ft)) :cat :pr} :ty (:to ft) :cat :lv}
      {:op :field :obj o :cls cid :i i :ty (cond-> ft (and (:c (:ty obj)) (not (:mutable f))) (assoc :c true)) :cat (if (= :lv (:cat obj)) :lv :xv)})))

(defn- var-node [id]
  (let [v (var* id) t (:ty v)]
    (if (abi/ref? t)
      {:op :deref :e {:op :load :e {:op :var :id id :ty t :cat :lv :raw true} :ty (abi/ptr (:to t)) :cat :pr} :ty (:to t) :cat :lv}
      {:op :var :id id :ty t :cat :lv})))

(defn- entity-expr [ctx es n]
  (let [e (first es)]
    (case (if (empty? es) :fn (:e e))
      :var (let [v (var* (:id e))]
             (if (and (:lambda ctx) (#{:local :param} (:storage v)) (not= (:fn v) (:fn-id ctx)))
               (capture-field ctx (:id e))
               (var-node (:id e))))
      :capfield (field-node (deref-node {:op :this :ty (:this-type ctx) :cat :pr}) (:cls (:lambda ctx)) (:i e))
      :field (field-node (deref-node (this-expr ctx)) (:cls e) (:i e))
      :indirect (reduce (fn [o [c i]] (field-node o c i)) (deref-node (this-expr ctx)) (:chain e))
      :enumerator {:op :int :v (:val e) :ty (:ty e) :cat :pr}
      ;; a pointer or reference non-type template parameter bound to a function or a variable (CODEGEN.md G3)
      :declconst (let [[k id] (:decl e) t (:ty e)]
                   (cond
                     (:null e) {:op :null :ty t :cat :pr}
                     (abi/ref? t) (if (= k :var) (var-node id) (fail :template "a reference to a function as an argument"))
                     (= k :fn) {:op :fnaddr :fn id :ty t :cat :pr}
                     :else {:op :addr :e (var-node id) :ty t :cat :pr}))
      (:fn :tmpl) (cond
                    (and (= :tmpl (:e e)) (= :concept (:tk e)))
                    {:op :int :v (long ((:concept-id @hooks) ctx e n)) :ty abi/bool* :cat :pr}
                    :else
                  (if (and (= :tmpl (:e e)) (= :var (:tk e)))
                    (if-let [h (:var-template @hooks)] (var-node (h ctx e n)) (fail :template "a variable template"))
                    {:op :fnset :fns (mapv :id (filter #(= :fn (:e %)) es)) :tmpls (mapv :id (filter #(and (= :tmpl (:e %)) (= :fn (:tk %))) es))
                   :name (get-in n [:referencedDecl :name]) :ty {:k :overload} :cat :lv :implicit-this true}))
      (fail :name "name " (:name (:referencedDecl n)) " of kind " (:e e)))))

(defn- name-expr [ctx n]
  (let [nm (get-in n [:referencedDecl :name])
        [g q] (ref-qualifier n)
        es (if (or g (seq q))
             (lookup-qualified (:scope ctx) (conj q nm) g)
             (lookup (:scope ctx) nm))
        ;; class members found through a class's scope keep their class
        es (if (and (seq q) (seq es)) es es)]
    ;; nothing visible: a call's argument-dependent lookup may still find a function (template)
    (when (and (empty? es) (or g (seq q))) (fail :name "unknown name " nm))
    (let [e (entity-expr ctx es n)]
      (if-let [tt (when (seq (:tmpls e)) (written-targs n nm))]
        (assoc e :targs-text tt :targs-scope (:scope ctx))
        e))))

(defn- arith-binop [o l r]
  (let [l (rv l) r (rv r) ct (arith-common (:ty l) (:ty r))]
    {:op :binop :o o :l (convert-scalar l ct false) :r (convert-scalar r ct false) :ty ct :cat :pr}))

(defn- to-bool [e]
  (if (abi/class? (abi/unq (:ty e)))
    (convert-scalar (user-conv {:scope *root*} e abi/bool* true) abi/bool* false)
    (convert-scalar (rv e) abi/bool* false)))

(declare operator-call analyze-call analyze-args rewritten-relational)

(defn- class->scalar
  "A class operand of a built-in operator by its conversion function (the one non-explicit, [over.built]'s candidates
  narrowed to it); another operand unchanged."
  [ctx e]
  (if (abi/class? (abi/unq (:ty e)))
    (let [fs (filter #(not (:explicit (fnd %))) (conv-fns (class-id (:ty e))))]
      (case (count fs)
        1 (user-conv ctx e (abi/unq (abi/non-ref (:ret (:ty (fnd (first fs)))))) false)
        0 e ; contextually converted later (&&, ||) or refused there
        (fail :conversion "a class operand with " (count fs) " conversion functions")))
    e))

(defn- class-operand? [e] (or (abi/class? (abi/unq (:ty e))) (abi/enum? (abi/unq (:ty e)))))

(defn- ordering-type
  "std::strong_ordering, weak_ordering or partial_ordering (<compare>'s classes), or a refusal."
  [^String nm]
  (or (:ty (type-entity (try (lookup-qualified *root* ["std" nm] true) (catch arbace.lang.ExceptionInfo _ nil))))
      (fail :operator "<=> without <compare>")))

(defn- three-way
  "The built-in three-way comparison ([expr.spaceship]): the operands' common type, its category's class prvalue
  ({:op :cmp3}, the code generator's -1, 0, 1 or partial_ordering's unordered 2)."
  [l r]
  (let [a (rv l) b (rv r) lt (:ty a) rt (:ty b)]
    (cond
      (and (abi/arith? lt) (abi/arith? rt))
      (let [ct (arith-common lt rt)]
        {:op :cmp3 :l (convert-scalar a ct false) :r (convert-scalar b ct false) :ct ct
         :ty (ordering-type (if (abi/floating? ct) "partial_ordering" "strong_ordering")) :cat :pr})
      (and (abi/ptr? lt) (abi/ptr? rt)) {:op :cmp3 :l a :r (convert-scalar b lt false) :ct lt :ty (ordering-type "strong_ordering") :cat :pr}
      :else (fail :operator "<=> of " (pr-str lt) " and " (pr-str rt)))))

(defn- builtin-binop [o l r]
  (let [lt (:ty (rv l)) rt (:ty (rv r))]
    (case o
      "<=>" (three-way l r)
      ("+" "-")
      (cond
        (and (abi/ptr? lt) (abi/integral? rt)) {:op :ptradd :o o :p (rv l) :n (convert-scalar (rv r) abi/long* false) :ty lt :cat :pr}
        (and (= o "+") (abi/integral? lt) (abi/ptr? rt)) {:op :ptradd :o o :p (rv r) :n (convert-scalar (rv l) abi/long* false) :ty rt :cat :pr}
        (and (= o "-") (abi/ptr? lt) (abi/ptr? rt)) {:op :ptrdiff :l (rv l) :r (rv r) :ty abi/long* :cat :pr}
        :else (arith-binop o l r))
      ("*" "/" "%" "&" "|" "^") (arith-binop o l r)
      ("<<" ">>") (let [l (rv l) pl (promote-type (:ty l))]
                    {:op :binop :o o :l (convert-scalar l pl false) :r (convert-scalar (rv r) pl false) :ty pl :cat :pr})
      ("<" ">" "<=" ">=" "==" "!=")
      (let [l (rv l) r (rv r)]
        (cond
          (or (abi/mptr? lt) (abi/mptr? rt))
          (let [pt (abi/unq (if (abi/mptr? lt) lt rt))]
            {:op :cmp :o o :l (convert-scalar l pt false) :r (convert-scalar r pt false) :ct pt :ty abi/bool* :cat :pr})
          (or (abi/ptr? lt) (abi/ptr? rt))
          (let [pt (if (abi/ptr? lt) lt rt)]
            {:op :cmp :o o :l (convert-scalar l pt false) :r (convert-scalar r pt false) :ct pt :ty abi/bool* :cat :pr})
          :else (let [ct (arith-common lt rt)]
                  {:op :cmp :o o :l (convert-scalar l ct false) :r (convert-scalar r ct false) :ct ct :ty abi/bool* :cat :pr})))
      "&&" {:op :land :l (fold-mark (to-bool l)) :r (to-bool r) :ty abi/bool* :cat :pr}
      "||" {:op :lor :l (fold-mark (to-bool l)) :r (to-bool r) :ty abi/bool* :cat :pr}
      "," {:op :comma :l l :r r :ty (:ty r) :cat (:cat r)}
      (".*" "->*")
      (let [obj (if (= o "->*") (deref-node l) l)
            m (rv r)
            mt (abi/unq (:ty m))
            obj (if (= :pr (:cat obj)) (materialize obj) obj)
            obj (to-base-lv obj (:cls mt))]
        (if (abi/fn? (:to mt))
          {:op :mbound :obj obj :m m :fty (:to mt) :ty {:k :overload} :cat :pr}
          {:op :mfield :obj obj :m m :ty (cond-> (:to mt) (:c (:ty obj)) (assoc :c true)) :cat (if (= :lv (:cat obj)) :lv :xv)}))
      (fail :operator "binary " o))))

(defn- assign-node [ctx l r]
  (cond
    (abi/class? (abi/unq (:ty l))) (operator-call ctx "=" [l r])
    :else (do (when-not (lv? l) (fail :assign "assignment to an rvalue"))
              {:op :assign :l l :r (convert-scalar (rv r) (abi/unq (:ty l)) false) :ty (:ty l) :cat :lv})))

(defn- compound-node [o l r]
  (let [lt (abi/unq (:ty l)) r (rv r)]
    (if (abi/ptr? lt)
      {:op :cassign :o o :l l :r (convert-scalar r abi/long* false) :ct lt :ty (:ty l) :cat :lv :ptr true}
      (let [ct (if (#{"<<" ">>"} o) (promote-type lt) (arith-common lt (:ty r)))]
        {:op :cassign :o o :l l :r (convert-scalar r (if (#{"<<" ">>"} o) ct ct) false) :ct ct :ty (:ty l) :cat :lv}))))

(defn- cast-expr [ctx t e explicit]
  (cond
    (and (abi/class? (abi/unq (:ty e))) (not (abi/ref? t)) (not (abi/class? (abi/unq t))) (not (abi/void? t)))
    (convert-scalar (user-conv ctx e (abi/unq t) true) t true)
    (abi/void? t) {:op :cast :ck :void :e e :ty abi/void :cat :pr}
    (abi/ref? t) (let [pt (:to t)
                       fc (class-id (:ty e)) tc (class-id pt)]
                   (cond
                     (and fc tc (abi/derived-from? fc tc)) (to-base-lv e tc)
                     (and fc tc (abi/derived-from? tc fc)) {:op :derived-lv :e e :to tc :ty pt :cat (if (= :rref (:k t)) :xv :lv)}
                     :else {:op :reinterpret-lv :e e :ty pt :cat (if (= :rref (:k t)) :xv :lv)}))
    (abi/class? (abi/unq t)) {:op :temp-obj :init (init-for t [e] ctx :direct) :ty (abi/unq t) :cat :pr}
    :else (convert-scalar (rv e) t true)))

(defn- method-set-of
  "[class-id fn-ids] of the members named `nm` of the class of object `obj`."
  [cid nm]
  (let [es (class-lookup cid nm)]
    (when (seq es) [(first (first es)) (mapv (comp :id second) (filter #(= :fn (:e (second %))) es)) (second (first es))])))

(defn- member-expr [ctx n]
  (let [[objn] (kids n)
        o (analyze ctx objn)
        ;; p->m of a class object: its operator-> applied until a pointer ([over.ref]; G4: unique_ptr)
        o (if (:isArrow n)
            (loop [o o k 0]
              (if (and (class-id (:ty o)) (< k 8))
                (recur (or (operator-call ctx "->" [o]) (fail :member "no operator-> of " (:name (abi/cls (class-id (:ty o)))))) (inc k))
                o))
            o)
        obj (if (:isArrow n) (deref-node o) o)
        cid (class-id (:ty obj))
        nm (:name n)
        ;; a qualified member (o.B::f): looked up in B, called without virtual dispatch
        q (if (:_wn n)
            (not-empty (vec (:qualifier n)))
            (let [t (or (node-text n) "")
                  m (re-find #"(?:\.|->)\s*((?:[A-Za-z_][A-Za-z_0-9]*\s*(?:<[^.]*>)?\s*::\s*)+)~?[A-Za-z_][A-Za-z_0-9]*\s*(?:<.*>)?\s*$" t)]
              ;; the qualifier's parts, a template-id among them (o.A<int>::f)
              (when m (vec (map str/trim (remove str/blank? (split-scope (second m))))))))
        qcid (when (seq q) (let [e (first (filter #(= :type (:e %)) (lookup-qualified (:scope ctx) q)))] (class-id (:ty e))))]
    (when-not cid (fail :member "member of a non-class"))
    (let [[fcid fids e] (if (str/starts-with? (str nm) "~")
                          ;; an explicit destructor call (p->~T(), [class.dtor]/14): the class's destructor
                          (let [k (or qcid cid) d (:dtor (abi/cls k))] (when d [k [d] {:e :fn :id d}]))
                          (method-set-of (or qcid cid) nm))
          fids (if qcid fids fids)]
      (cond
        (nil? e) (fail :member "no member " nm (when (System/getenv "CPP_HDR_TRACE") (str " (" (node-text n) ") of " (:name (abi/cls (or qcid cid))))))
        (= :field (:e e)) (field-node (if (= :pr (:cat obj)) (materialize obj) obj) (:cls e) (:i e))
        (= :indirect (:e e)) (reduce (fn [o [c i]] (field-node o c i)) (if (= :pr (:cat obj)) (materialize obj) obj) (:chain e))
        (= :var (:e e)) {:op :comma :l obj :r (var-node (:id e)) :ty (:ty (var* (:id e))) :cat :lv}
        (#{:fn :tmpl} (:e e))
        (let [tm (vec (keep (fn [[_ x]] (when (= :tmpl (:e x)) (:id x))) (class-lookup (or qcid cid) nm)))
              t (or (node-text n) "")]
          (cond-> {:op :fnset :fns fids :tmpls tm :name nm :obj (if (= :pr (:cat obj)) (materialize obj) obj) :ty {:k :overload} :cat :lv :qualified (boolean qcid)}
            (and (seq tm) (:_wn n) (:explicitTemplateArgs n)) (assoc :targs-text (written-targs n nm) :targs-scope (:scope ctx))
            (and (seq tm) (not (:_wn n)) (re-find #"<[^<>]*(?:<[^<>]*>[^<>]*)*>\s*$" t)) (assoc :targs-text (second (re-find #"(?:\.|->)\s*(?:template\s+)?(.*)$" t)) :targs-scope (:scope ctx))))
        (= :enumerator (:e e)) {:op :int :v (:val e) :ty (:ty e) :cat :pr}
        :else (fail :member "member " nm)))))

(declare analyze-fn! has-auto?)

(declare defaulted-comparison!)

(defn- deduced!
  "The function `fid` with its deduced return type deduced ([dcl.spec.auto.general]/11: a use needs its definition
  analyzed first; G4: <bits/ptr_traits.h>'s auto __to_address)."
  [fid]
  (let [f (fnd fid)]
    ;; (a defaulted <=> with auto: its category deduced from the members')
    (when (and (has-auto? (:ret (:ty f))) (:defaulted f) (= "<=>" (:op f)) (not (:tbody f)))
      (defaulted-comparison! fid))
    (when (and (has-auto? (:ret (:ty f))) (:body f) (not (:tbody f)) (not (:analyzing f)))
      (upd-fn! fid assoc :analyzing true)
      (analyze-fn! fid)
      (upd-fn! fid assoc :analyzed true)
      (upd-fn! fid dissoc :analyzing))
    fid))

(defn- method-call
  "A call of the method `fid` on the object glvalue `obj` with the typed arguments."
  [ctx fid obj args virtual-ok]
  (let [f (fnd (deduced! fid))
        o (when-not (:static f) (to-base-lv obj (:cls f)))]
    {:op :call :fn fid :obj o :args (call-args f args ctx) :virtual (and virtual-ok (:virtual f) (not (:static f)))
     :ty (abi/non-ref (:ret (:ty f))) :cat (let [r (:ret (:ty f))] (case (:k r) :ref :lv :rref :xv :pr))}))

(defn- fn-call [ctx fid args]
  (let [f (fnd (deduced! fid))]
    {:op :call :fn fid :args (call-args f args ctx)
     :ty (abi/non-ref (:ret (:ty f))) :cat (let [r (:ret (:ty f))] (case (:k r) :ref :lv :rref :xv :pr))}))

(defn- adl-fns
  "The functions named `nm` in the namespaces of the class arguments' classes ([basic.lookup.argdep], for classes)."
  [args nm]
  (distinct
   (for [a args
         :let [cid (class-id (:ty a))] :when cid
         :let [outer (loop [s (:outer (abi/cls cid))] (if (= :ns (:kind s)) s (recur (:parent s))))]
         e (binding [*cutoff* Long/MAX_VALUE] (own-names outer nm)) :when (= :fn (:e e))]
     (:id e))))

(declare block-ctx)

(def ^:private value-builtins
  {"__builtin_expect" :expect "__builtin_expect_with_probability" :expect "__builtin_constant_p" :constant-p
   "__builtin_is_constant_evaluated" :is-constant-evaluated
   "__builtin_addressof" :addressof
   "__builtin_alloca" :alloca
   "__builtin_va_start" :va-start "__builtin_c23_va_start" :va-start "__builtin_va_end" :va-end "__builtin_va_copy" :va-copy
   "__builtin_add_overflow" :add-overflow "__builtin_sub_overflow" :sub-overflow "__builtin_mul_overflow" :mul-overflow})

(def ^:private std-builtins
  {"move" :cast "forward" :cast "move_if_noexcept" :cast "as_const" :cast "forward_like" :cast "addressof" :addr "__addressof" :addr})

(declare cast-expr)

(defn analyze-call [ctx callee args]
  (case (:op callee)
    :mbound (let [ft (:fty callee)]
              {:op :mcall :obj (:obj callee) :m (:m callee) :fty ft
               :args (vec (map-indexed (fn [i a] (if (< i (count (:ps ft))) (init-for (nth (:ps ft) i) a ctx :copy) {:i :expr :e (rv a)})) args))
               :ty (abi/non-ref (:ret ft)) :cat (case (:k (:ret ft)) :ref :lv :rref :xv :pr)})
    :fnset (let [;; the function templates' specializations their deduction from the arguments declares
                 tcands (when-let [h (:call-candidates @hooks)] (h ctx callee args))
                 ms (mapv fnd (concat (:fns callee) tcands))
                 obj (:obj callee)
                 any-method (some #(and (:cls %) (not (:static %))) ms)
                 obj (or obj (when (and (:implicit-this callee) any-method (:this-type ctx)) (deref-node (this-expr ctx))))
                 cands (concat (:fns callee) tcands (when (and (not (:obj callee)) (not any-method)) (adl-fns args (or (:name callee) (:name (first ms))))))
                 _ (when (and (empty? cands) (empty? (:tmpls callee))) (fail :name "unknown name " (:name callee)))
                 ;; (a function found twice, through a using-declaration and its class: one candidate; G4)
                 fid (resolve-overload (distinct cands) args obj)
                 f (fnd fid)
                 std-builtin (when (and (= 1 (count args)) (= [[:ns "std"]] (:path f)) (not (:cls f)))
                               (std-builtins (:name f)))]
             (cond
               ;; the standard library's functions clang builds in (Builtins.td's LIBBUILTIN std::move, forward,
               ;; move_if_noexcept, as_const, addressof, __addressof, forward_like: CodeGen folds the call to its
               ;; argument, no function emitted, even at -O0; G4)
               (= std-builtin :cast) (cast-expr ctx (:ret (:ty f)) (first args) true)
               ;; std::__is_constant_evaluated(), always_inline: clang inlines it even at -O0 (the AlwaysInliner),
               ;; its run-time value false; no function emitted (G4)
               (and (empty? args) (= [[:ns "std"]] (:path f)) (= "__is_constant_evaluated" (:name f)))
               {:op :int :v 0 :ty abi/bool* :cat :pr}
               (= std-builtin :addr) (let [e (first args)] {:op :addr :e e :ty (abi/ptr (:ty e)) :cat :pr})
               :else
             (if (and (:cls f) (not (:static f)))
               (method-call ctx fid obj args (not (:qualified callee)))
               (fn-call ctx fid args))))
    (let [p (rv callee)
          ft (let [t (abi/unq (:ty p))] (if (abi/ptr? t) (:to t) t))]
      (when-not (abi/fn? ft) (fail :call "call of a non-function"))
      {:op :icall :callee p :fty ft
       :args (vec (map-indexed (fn [i a] (if (< i (count (:ps ft))) (init-for (nth (:ps ft) i) a ctx :copy) {:i :expr :e (rv a)})) args))
       :ty (abi/non-ref (:ret ft)) :cat (case (:k (:ret ft)) :ref :lv :rref :xv :pr)})))

(defn operator-call
  "An overloaded operator's call ([over.match.oper]): the members of the first operand's class and the non-members found
  by unqualified lookup and ADL; nil when none is viable (the built-in operator then)."
  [ctx o args]
  (let [nm (str "operator" o)
        [l & more] args
        lc (class-id (:ty l))
        mtmpls (when lc (vec (keep (fn [[_ x]] (when (and (= :tmpl (:e x)) (= :fn (:tk x))) (:id x))) (class-lookup lc nm))))
        ;; the member operator templates' specializations deduced from the other operands (G4: ranges::iter_move's
        ;; operator() template)
        mspecs (when (and (seq mtmpls) (:call-candidates @hooks))
                 (try ((:call-candidates @hooks) ctx {:op :fnset :fns [] :name nm :tmpls mtmpls :obj l} more)
                      (catch arbace.lang.ExceptionInfo _ nil)))
        members (when lc (concat (second (method-set-of lc nm)) mspecs))
        found (lookup (:scope ctx) nm)
        ;; the operator function templates found by lookup and ADL, their specializations deduced from the operands
        ;; (G4: <bits/stl_iterator.h>'s operator- of two __normal_iterators)
        tspecs (when-let [h (:call-candidates @hooks)]
                 (try (h ctx {:op :fnset :fns [] :name nm :tmpls (mapv :id (filter #(and (= :tmpl (:e %)) (= :fn (:tk %))) found))} args)
                      (catch arbace.lang.ExceptionInfo _ nil)))
        frees (concat (filter #(not (:cls (fnd %))) (map :id (filter #(= :fn (:e %)) found))) (adl-fns args nm) tspecs)
        cands (concat (map (fn [m] [:m m]) members) (map (fn [f] [:f f]) (distinct frees)))]
    (when (and (empty? cands) (System/getenv "CPP_OP_TRACE")) (binding [*out* *err*] (println "operator" o "no candidates for" (pr-str (map :ty args)))))
    (if (empty? cands)
      (cond
        (= o "=") (fail :assign "no operator=")
        ;; C++20's rewritten candidate: a != b as !(a == b)
        (= o "!=") (when-let [c (operator-call ctx "==" args)] {:op :not :e (convert-scalar (rv c) abi/bool* false) :ty abi/bool* :cat :pr})
        (#{"<" ">" "<=" ">="} o) (rewritten-relational ctx o args)
        :else nil)
      (let [;; one candidate set ([over.match.oper]/3): members as functions of the remaining operands with the object
            ;; as their first, non-members of all
            ms (set members)
            best (try (resolve-overload* (concat (map (fn [m] [m more l true]) (distinct members))
                                                 (map (fn [f] [f args nil false]) (remove ms (distinct frees))))
                                         (count args))
                      (catch arbace.lang.ExceptionInfo x (if (= :overload (:codegen/refused (ex-data x)))
                                                           (do (when (System/getenv "CPP_OP_TRACE") (binding [*out* *err*] (println "operator" o (.getMessage x) (count members) (count frees))))
                                                               (when (re-find #"ambiguous" (.getMessage x)) (throw x)))
                                                           (throw x))))]
        (cond
          (nil? best) (when (#{"<" ">" "<=" ">="} o) (rewritten-relational ctx o args))
          (contains? ms best) (method-call ctx best l more true)
          :else (fn-call ctx best args))))))

(defn- rewritten-relational
  "x @ y for a relational @ by a three-way comparison ([over.match.oper]/3.4, /8): (x <=> y) @ 0, else 0 @ (y <=> x)."
  [ctx o args]
  (let [zero {:op :int :v 0 :ty abi/int* :cat :pr}
        [x y] args
        three (fn [a b] (or (when (or (class-operand? a) (class-operand? b)) (try (operator-call ctx "<=>" [a b]) (catch arbace.lang.ExceptionInfo _ nil)))
                            (try (three-way a b) (catch arbace.lang.ExceptionInfo _ nil))))]
    (or (when-let [c (three x y)] (operator-call ctx o [c zero]))
        (when-let [c (three y x)] (operator-call ctx o [zero c])))))

;; ---------------------------------------------------------------------------------------------
;; Allocation and deallocation functions ([expr.new]/9-28, [expr.delete]/7-12; clang's Sema::FindAllocationFunctions,
;; resolveAllocationOverload, resolveDeallocationOverload with UsualDeallocFnInfo::Compare, FindDeallocationFunction,
;; FindUsualDeallocationFunction, FindDeallocationFunctionForDestructor, doesUsualArrayDeleteWantSize; Itanium's array
;; cookie). A choice is {:fn id} (a declared function) or {:sym name} (an implicitly declared global one, [basic.stc.dynamic]/2,
;; when no header declares it), with :size and :align (the deallocation's implicit arguments) and an allocation's
;; :align (the alignment passed) and :places (the placement arguments' initializers).

(def ^:private new-align 16) ; __STDCPP_DEFAULT_NEW_ALIGNMENT__ on x86-64

(defn overaligned? [t] (> (long (abi/align-of t)) (long new-align)))

(defn- align-val-t [] (some-> (try (lookup-qualified *root* ["std" "align_val_t"] true) (catch arbace.lang.ExceptionInfo _ nil)) type-entity :ty))

(defn- size-t? [t] (= (abi/unq t) abi/ulong*))
(defn- align-t? [t] (let [t (abi/unq t)] (and (abi/enum? t) (= "align_val_t" (:name (abi/enm (:id t)))))))
(defn- void-ptr? [t] (let [t (abi/unq t)] (and (abi/ptr? t) (abi/void? (abi/unq (:to t))))))

(defn- fn-ids [es] (vec (distinct (keep #(when (= :fn (:e %)) (:id %)) es))))

(defn- alloc-lookup
  "[:class ids] when the class `cid` (not ::-qualified) declares or inherits `nm`, else [:global ids] (ids empty when no
  header declares it: the implicit declarations)."
  [cid ^String nm global?]
  (let [cl (when (and cid (not global?)) (fn-ids (map second (class-lookup cid nm))))]
    (if (seq cl) [:class cl] [:global (fn-ids (lookup *root* nm))])))

(defn- usual-dealloc-info
  "UsualDeallocFnInfo of a deallocation function: {:size :align} when it is a usual (non-placement) one, else nil."
  [fid]
  (let [f (fnd fid) ps (vec (:ps (:ty f)))]
    (when (and (not (:va (:ty f))) (seq ps) (void-ptr? (first ps)) (not (:deleted f)))
      (let [i (if (and (< 1 (count ps)) (size-t? (nth ps 1))) 2 1)
            j (if (and (< i (count ps)) (align-t? (nth ps i))) (inc i) i)]
        (when (= j (count ps)) {:size (= i 2) :align (> j i)})))))

(defn- resolve-dealloc
  "The usual deallocation function of `ids` preferred for the target {:size :align} (Compare: the alignment parameter as
  the target asks, then the size parameter), or nil."
  [ids target]
  (let [infos (keep (fn [id] (when-let [u (usual-dealloc-info id)] (assoc u :fn id))) ids)
        score (fn [u] [(if (= (:align u) (:align target)) 1 0) (if (= (:size u) (:size target)) 1 0)])]
    (when (seq infos)
      (let [best (reduce (fn [a b] (if (pos? (compare (score b) (score a))) b a)) infos)]
        (select-keys best [:fn :size :align])))))

(defn- implicit-dealloc
  "The implicitly declared global deallocation function for {:size :align} ([basic.stc.dynamic]/2)."
  [array? {:keys [size align]}]
  {:sym (str (if array? "_ZdaPv" "_ZdlPv") (when size "m") (when align "St11align_val_t")) :size (boolean size) :align (boolean align)})

(defn global-dealloc
  "FindUsualDeallocationFunction: the global usual deallocation function for {:size :align}."
  [array? target]
  (let [nm (if array? "operator delete[]" "operator delete")
        ids (second (alloc-lookup nil nm true))]
    (or (resolve-dealloc ids target) (implicit-dealloc array? target))))

(defn dtor-dealloc
  "FindDeallocationFunctionForDestructor: the deallocation function a deleting destructor of class `cid` calls."
  [cid]
  (let [[k ids] (alloc-lookup cid "operator delete" false)
        t {:k :class :id cid}]
    (or (when (= :class k) (resolve-dealloc ids {:size false :align (overaligned? t)}))
        (global-dealloc false {:size true :align (overaligned? t)}))))

(defn- array-delete-wants-size?
  "doesUsualArrayDeleteWantSize: the class's own usual operator delete[] takes a size."
  [et]
  (let [cid (class-id (loop [t (abi/unq et)] (if (abi/arr? t) (recur (abi/unq (:of t))) t)))]
    (boolean (when cid (let [[k ids] (alloc-lookup cid "operator delete[]" false)]
                         (when (= :class k) (:size (resolve-dealloc ids {:size false :align (overaligned? et)}))))))))

(defn- find-allocation
  "FindAllocationFunctions for `new T` (`array?`, `global?` for ::new, `place` the placement arguments): {:alloc choice
  :dealloc choice-or-nil :reserved bool} (:reserved: the reserved placement form operator new(size_t, void*), which clang
  calls not; G4)."
  [ctx et array? global? place]
  (let [cid (class-id (loop [t (abi/unq et)] (if (abi/arr? t) (recur (abi/unq (:of t))) t)))
        nm (if array? "operator new[]" "operator new")
        over (overaligned? et)
        avt (align-val-t)
        size {:op :int :v 0 :ty abi/ulong* :cat :pr}
        [scope ids] (alloc-lookup cid nm global?)
        try-res (fn [args] (try (resolve-overload ids args nil) (catch arbace.lang.ExceptionInfo x (if (= :overload (:codegen/refused (ex-data x))) nil (throw x)))))
        ;; (the implicit global declarations are always there, [basic.stc.dynamic]/2: a program's own global placement
        ;; form does not hide them)
        ids (if (and (= :global scope) (empty? place) (seq ids) (nil? (try-res [size]))) [] ids)
        [fid aligned] (cond
                        (empty? ids) [nil over]
                        (and over avt) (if-let [f (try-res (into [size {:op :int :v (abi/align-of et) :ty avt :cat :pr}] place))]
                                         [f true]
                                         [(try-res (into [size] place)) false])
                        :else [(try-res (into [size] place)) false])
        _ (when (and (seq ids) (nil? fid)) (fail :new "no viable " nm " for " (count place) " placement arguments"))
        alloc (if fid
                (let [f (fnd fid) ps (vec (:ps (:ty f))) k (if aligned 2 1)]
                  {:fn fid :align (when aligned (abi/align-of et))
                   :places (call-args (assoc f :ty (assoc (:ty f) :ps (subvec ps k)) :defaults (vec (drop k (:defaults f)))) place ctx)})
                (do (when (seq place) (fail :new "a placement new without a declared operator new"))
                    {:sym (str (if array? "_Zna" "_Znw") "m" (when aligned "St11align_val_t")) :align (when aligned (abi/align-of et)) :places []}))
        f (when fid (fnd fid))
        reserved (boolean (and f (not (:cls f)) (= 2 (count (:ps (:ty f)))) (void-ptr? (second (:ps (:ty f))))
                               (= 1 (count place))))
        dnm (if array? "operator delete[]" "operator delete")
        [dscope dids] (alloc-lookup cid dnm global?)
        placement? (or (seq place) (and f (or (:va (:ty f)) (not= (count (:ps (:ty f))) (if aligned 2 1)))))
        dealloc (if placement?
                  ;; the placement deallocation function whose parameters after the first are the allocation function's
                  ;; after the size ([expr.new]/28)
                  (let [want (into [:void-ptr] (map abi/unq (drop 1 (:ps (:ty f)))))]
                    (first (keep (fn [id] (let [g (fnd id) ps (:ps (:ty g))]
                                            (when (and (= (count ps) (count want)) (void-ptr? (first ps)) (= (map abi/unq (rest ps)) (rest want)) (= (boolean (:va (:ty g))) (boolean (:va (:ty f)))))
                                              {:fn id :place true})))
                                 dids)))
                  (let [target {:size (= :global dscope) :align over}]
                    (or (when (seq dids) (resolve-dealloc dids target)) (when (= :global dscope) (implicit-dealloc array? target)))))]
    {:alloc alloc :dealloc dealloc :reserved reserved :scope scope}))

(defn- delete-dealloc
  "The deallocation function of `delete p` / `delete[] p` (ActOnCXXDelete), with the array's cookie need."
  [et array? global?]
  (let [cid (class-id (loop [t (abi/unq et)] (if (abi/arr? t) (recur (abi/unq (:of t))) t)))
        nm (if array? "operator delete[]" "operator delete")
        over (overaligned? et)
        cls (when (and cid (not global?)) (let [[k ids] (alloc-lookup cid nm false)] (when (= :class k) (resolve-dealloc ids {:size false :align over}))))
        wants (if array? (if cls (boolean (:size cls)) (array-delete-wants-size? et)) false)
        destructed (boolean (and cid (not (trivial-dtor? cid))))]
    (or cls
        (global-dealloc array? {:size (boolean (and (let [u (abi/unq et)] (or (not (abi/class? u)) (:complete (abi/cls (:id u))))) (or (not array?) wants destructed))) :align over}))))

(defn- new-expr [ctx n]
  (let [t (resolve-type (:scope ctx) (get-in n [:type :qualType]))
        et (:to t)
        ks (kids n)
        [nexpr ks] (if (:isArray n) [(first ks) (rest ks)] [nil ks])
        ;; the initializer when written, then the placement arguments (the native parser's order; G4)
        initn (when (or (:initStyle n) (not (:isPlacement n))) (first ks))
        place (vec (if initn (rest ks) ks))
        pargs (when (:isPlacement n) (vec (analyze-args ctx place)))
        fa (find-allocation ctx (if nexpr et et) (boolean nexpr) (boolean (:isGlobal n)) (vec pargs))
        ;; the reserved placement form new (p) T: clang's CodeGen uses its argument, calls nothing
        placement (when (:reserved fa) (convert-scalar (rv (first pargs)) (abi/ptr abi/void) false))
        init (cond
               nexpr nil
               (nil? initn) (init-for et nil ctx :default)
               ;; (its pack expansions spliced: new T(std::forward<Args>(args)...), G4)
               (= "ParenListExpr" (:kind initn)) (init-for et (vec (analyze-args ctx (kids initn))) ctx (if (empty? (kids initn)) :value :direct))
               (= "InitListExpr" (:kind initn)) (init-for et (analyze ctx initn) ctx :list)
               (= "PackExpansionExpr" (:kind initn)) (let [as (vec (analyze-args ctx [initn]))] (init-for et (when (seq as) as) ctx (if (seq as) :direct :value)))
               :else (init-for et [(analyze ctx initn)] ctx :direct))
        init (if (and (= :ctor (:i init)) (empty? (:args init)) (nil? initn)) init init)]
    (when (and nexpr initn (not= "InitListExpr" (:kind initn))) nil)
    {:op :new :placement placement :alloc (when-not placement (:alloc fa)) :dealloc (when-not placement (:dealloc fa))
     :cookie (boolean (and nexpr (not placement) (let [bt (loop [x (abi/unq et)] (if (abi/arr? x) (recur (abi/unq (:of x))) x)) c (class-id bt)]
                                   (or (and c (not (trivial-dtor? c)))
                                       (:size (delete-dealloc et true (boolean (:isGlobal n))))))))
     :ty t :et et :n (when nexpr (convert-scalar (rv (analyze ctx nexpr)) abi/ulong* false))
     :init (if nexpr
             (cond (nil? initn) (init-for et nil ctx :default)
                   (#{"ImplicitValueInitExpr" "ParenListExpr"} (:kind initn)) {:i :list :items [] :fill (init-for et nil ctx :value)}
                   ;; (the elements past the list's from {} when the count is not the list's, [expr.new]/24)
                   :else (assoc (init-for (abi/arr nil et) (analyze ctx initn) ctx :list)
                                :fill (try (init-for et {:op :init-list :items []} ctx :list) (catch arbace.lang.ExceptionInfo _ nil))))
             init)
     :cat :pr}))

(defn- dtor-of [cid] (:dtor (abi/cls cid)))

(defn- analyze-args
  "The typed expressions of argument nodes, a pack expansion (args...) analyzed once for each of its packs' elements."
  [ctx ns]
  (vec (mapcat (fn [a] (if (= "PackExpansionExpr" (:kind a))
                         (if-let [h (:expand-pack @hooks)] (h ctx a) (fail :pack "a pack expansion"))
                         [(analyze ctx a)]))
               ns)))

;; ---------------------------------------------------------------------------------------------
;; Lambdas ([expr.prim.lambda]): the closure class (a local class, mangled as clang names it: $_N in a function of
;; internal or external linkage, Ul<params>E<n>_ in an inline one), a field per capture in the order captured
;; (explicit, then implicit at first use), its operator() (const unless mutable, the return type deduced from the
;; first return), for a captureless lambda the conversion to a function pointer and its static __invoke

(declare stmt nrvo-var analyze-implicit! deduce-auto)

(def ^:dynamic *lambda-counts* nil) ; atom {[enclosing-fid kind-key] n}

(defn- split-top
  "The comma-separated parts of `s` at bracket depth 0."
  [^String s]
  (loop [i 0 d 0 start 0 out []]
    (if (>= i (count s))
      (let [p (str/trim (subs s start))] (if (seq p) (conj out p) out))
      (let [c (.charAt s i)]
        (cond
          (#{\( \[ \{ \<} c) (recur (inc i) (inc d) start out)
          (#{\) \] \} \>} c) (recur (inc i) (dec d) start out)
          (and (= c \,) (zero? d)) (recur (inc i) d (inc i) (conj out (str/trim (subs s start i))))
          :else (recur (inc i) d start out))))))

(defn- capture-intro [^String text]
  (let [b (.indexOf text "[")]
    (loop [i (inc b) d 1]
      (let [c (.charAt text i)]
        (cond (= c \[) (recur (inc i) (inc d))
              (= c \]) (if (= d 1) (subs text (inc b) i) (recur (inc i) (dec d)))
              :else (recur (inc i) d))))))

(defn capture-field
  "The expression of a captured entity (a variable's id or :this) inside the lambda of `ctx`: the closure's field,
  added (with its initializer, analyzed in the enclosing context) on the first use."
  [ctx k]
  (let [lam (:lambda ctx)
        lid (:cls lam)
        caps (:caps lam)
        encl (:encl lam)
        obj (deref-node {:op :this :ty (:this-type ctx) :cat :pr})]
    (if-let [i (get @caps k)]
      (let [f (nth (:fields (abi/cls lid)) i)] (if (= :this k) (rv (field-node obj lid i)) (field-node obj lid i)))
      (let [mode (or (get (:explicit lam) k) (:default lam))
            v (when (not= :this k) (var* k))]
        (cond
          (= :this k)
          (let [te (this-expr encl)
                i (count (:fields (abi/cls lid)))]
            (abi/update-cls! lid update :fields conj {:name nil :ty (:ty te) :access :private :i i :capture true})
            (swap! caps assoc k i)
            (swap! (:inits lam) conj [i {:i :expr :e te}])
            (rv (field-node obj lid i)))
          (nil? mode)
          (let [t (:ty v)]
            (if-let [c (when (and (:c t) (abi/integral? t) (:init-node v)) (try (const-int (:scope encl) (:init-node v)) (catch arbace.lang.ExceptionInfo _ nil)))]
              {:op :int :v c :ty (abi/unq t) :cat :pr}
              (fail :lambda "a variable the lambda does not capture: " (:name v))))
          :else
          (let [src (entity-expr encl [{:e :var :id k}] nil)
                i (count (:fields (abi/cls lid)))
                ft (if (= :ref mode) (abi/lref (:ty src)) (abi/non-ref (:ty v)))]
            (abi/update-cls! lid update :fields conj {:name nil :ty ft :access :private :i i :capture true})
            (swap! caps assoc k i)
            (swap! (:inits lam) conj [i (if (= :ref mode) {:i :bind :e src} (init-for ft src encl :copy))])
            (field-node obj lid i)))))))

(defn- init-capture!
  "An init-capture ([expr.prim.lambda.capture]/6): a field of the deduced type initialized by the expression analyzed in
  the enclosing context, its name the field's in the lambda's body."
  [lctx fs amp nm node]
  (let [lam (:lambda lctx) lid (:cls lam) encl (:encl lam)
        e (analyze encl node)
        byref (= amp "&")
        ft (if byref (abi/lref (:ty e)) (deduce-auto {:k :auto} e))
        i (count (:fields (abi/cls lid)))]
    (abi/update-cls! lid update :fields conj {:name nil :ty ft :access :private :i i :capture true})
    (swap! (:inits lam) conj [i (if byref {:i :bind :e e} (init-for ft e encl :copy))])
    (enter! fs nm {:e :capfield :i i})))

(defn- lambda-expr [ctx n]
  (let [ks (kids n)
        rd (first ks) body (last ks)
        init-nodes (vec (butlast (rest ks)))
        init-i (atom -1)
        md (first (filter #(= "CXXMethodDecl" (:kind %)) (kids rd)))
        text (node-text n)
        intro (capture-intro text)
        head (subs text 0 (max 0 (- (long (get-in body [:range :begin :offset])) (long (get-in n [:range :begin :offset])))))
        mutable (boolean (re-find #"\)\s*mutable\b" head))
        pn (param-nodes md)
        _ (when (some #(re-find #"\bauto\b" (get-in % [:type :qualType] "")) pn) (fail :generic-lambda "a generic lambda"))
        ps (mapv #(resolve-type (:scope ctx) (get-in % [:type :qualType])) pn)
        qt (get-in md [:type :qualType])
        ret (if (re-find #"^auto\s*\(" qt)
              (if-let [[_ r] (re-find #"->\s*(.+?)\s*$" head)] (resolve-type (:scope ctx) r) {:k :auto})
              (:ret (resolve-type (:scope ctx) qt)))
        encl-f (when (:fn-id ctx) (fnd (:fn-id ctx)))
        inline? (boolean (and encl-f (:inline encl-f) (not (:internal encl-f))))
        ;; clang names a closure Ul...E_ in an inline function's body and in a closure's, $_N elsewhere
        ul? (or inline? (boolean (and encl-f (:cls encl-f) (:lambda (abi/cls (:cls encl-f))))))
        ckey [(:fn-id ctx) (if ul? (abi/mangle-params ps) :dollar)]
        k (long (or (get @*lambda-counts* ckey) 0))
        _ (swap! *lambda-counts* assoc ckey (inc k))
        mname (when ul? (str "Ul" (abi/mangle-params ps) "E" (if (zero? k) "" (dec k)) "_"))
        path (if encl-f [[:local encl-f]] (vec (:path (:scope ctx))))
        id (next-id)
        cs (new-scope :class (:scope ctx) :cls id :path (conj path [:cls id]))
        t {:k :class :id id}
        _ (swap! abi/*classes* assoc id {:id id :name nil :mname mname :dollar-key (when-not ul? [:fn (:fn-id ctx)]) :path path :scope cs :fields [] :bases [] :outer (:scope ctx) :lambda true})
        fid (next-id)
        base-f {:cls id :inline inline? :internal (not inline?) :path (conj path [:cls id]) :scope cs :def-scope cs :linkage :cpp :defaults [] :pos -1}
        _ (swap! *fns* assoc fid (merge base-f {:id fid :name "operator()" :kind :method :op "()" :ty {:k :fn :ret ret :ps ps :va false}
                                                :cq (not mutable) :param-names (mapv :name pn)}))
        _ (enter! cs "operator()" {:e :fn :id fid :pos -1})
        _ (abi/update-cls! id update :methods (fnil conj []) fid)
        _ (swap! *order* conj [:fn fid])
        ;; the captures written
        items (if (str/blank? intro) [] (split-top intro))
        default (some #(case % "=" :copy "&" :ref nil) items)
        fs (new-scope :fn (:scope ctx))
        lam {:cls id :caps (atom {}) :inits (atom []) :default default :encl ctx :explicit {}}
        pids (vec (map-indexed (fn [i pt] (let [pid (next-id) nm (:name (nth pn i))]
                                            (swap! *vars* assoc pid {:id pid :name nm :ty pt :storage :param :fn fid})
                                            (when nm (enter! fs nm {:e :var :id pid}))
                                            pid))
                               ps))
        lctx {:scope fs :fn-id fid :this-type (abi/ptr (cond-> t (not mutable) (assoc :c true))) :statics (atom []) :lambda lam}
        explicit (into {} (for [it items :when (not (#{"=" "&"} it)) :when (not (str/includes? it "="))
                                :let [byref (str/starts-with? it "&") nm (str/trim (str/replace it #"^&" ""))]]
                            (cond (= nm "this") [:this :copy]
                                  (= nm "*this") (fail :lambda "a capture of *this")
                                  :else (let [e (first (filter #(= :var (:e %)) (lookup (:scope ctx) nm)))]
                                          (when-not e (fail :lambda "capture of " nm))
                                          [(:id e) (if byref :ref :copy)]))))
        lam (assoc lam :explicit explicit)
        lctx (assoc lctx :lambda lam)
        ;; explicit captures in their order, then init-captures
        _ (doseq [it items :when (not (#{"=" "&"} it))]
            (if-let [[_ amp nm _] (re-matches #"(?s)(&?)\s*([A-Za-z_][A-Za-z_0-9]*)\s*=\s*(.+)" it)]
              (init-capture! lctx fs amp nm (nth init-nodes (swap! init-i inc)))
              (let [byref (str/starts-with? it "&") nm (str/trim (str/replace it #"^&" ""))]
                (capture-field lctx (if (= nm "this") :this (:id (first (filter #(= :var (:e %)) (lookup (:scope ctx) nm)))))))))
        body-s (binding [*cutoff* Long/MAX_VALUE] (stmt lctx body))
        ret (:ret (:ty (fnd fid)))
        ret (if (= :auto (:k ret)) abi/void ret)
        _ (upd-fn! fid #(-> % (assoc-in [:ty :ret] ret) (assoc :params pids :tbody body-s :nrvo (nrvo-var body-s) :statics @(:statics lctx))))
        _ (finish-class! id)
        _ (doseq [m (:methods (abi/cls id)) :let [g (fnd m)] :when (:implicit g)]
            (try (analyze-implicit! m) (catch arbace.lang.ExceptionInfo _ (upd-fn! m assoc :deleted true))))
        inits (sort-by first @(:inits lam))]
    (when (empty? inits)
      ;; the conversion to a pointer to function and the static __invoke it returns
      (let [ivid (next-id) cvid (next-id) ft {:k :fn :ret ret :ps ps :va false}
            ipids (vec (for [pt ps] (let [pid (next-id)] (swap! *vars* assoc pid {:id pid :name nil :ty pt :storage :param :fn ivid}) pid)))
            lv (next-id)
            _ (swap! *vars* assoc lv {:id lv :name nil :ty t :storage :local :fn ivid})
            _ (swap! *fns* assoc ivid (merge base-f {:id ivid :name "__invoke" :kind :method :static true :ty ft :param-names []}))
            call (method-call {:scope cs} fid {:op :var :id lv :ty t :cat :lv} (mapv var-node ipids) false)
            ret-s (if (abi/void? ret) {:s :return :void-e call} {:s :return :init (init-for ret call {:scope cs} :copy)})]
        (upd-fn! ivid assoc :params ipids :tbody {:s :block :items [{:s :decl :var lv :init {:i :none}} ret-s]})
        (swap! *fns* assoc cvid (merge base-f {:id cvid :name "operator function" :kind :conv :cq true :ty {:k :fn :ret (abi/ptr ft) :ps [] :va false}
                                              :param-names [] :params []
                                              :tbody {:s :block :items [{:s :return :init {:i :expr :e {:op :fnaddr :fn ivid :ty (abi/ptr ft) :cat :pr}}}]}}))
        (abi/update-cls! id update :methods (fnil conj []) cvid)))
    {:op :temp-obj :init {:i :list :cls id :items (mapv second inits) :fields-used (mapv first inits)} :ty t :cat :pr}))

(defn analyze
  "The typed expression of the tree node `n` in the context `ctx` ({:scope :fn :this-type ...})."
  [ctx n]
  (case (:kind n)
    "IntegerLiteral" (let [t (int-type-of (get-in n [:type :qualType]))] {:op :int :v (let [v (bigint (:value n))] (if (> v Long/MAX_VALUE) (long (- v 18446744073709551616N)) (long v))) :ty t :cat :pr})
    "CharacterLiteral" {:op :int :v (long (:value n)) :ty (int-type-of (get-in n [:type :qualType] "char")) :cat :pr}
    ;; a type trait's value (G4: the headers' __is_constructible(T, Args...)), its text evaluated by the templates' hook
    ;; a user-defined literal ([lex.ext]/3-8): the literal operator's call, operator""X(...) with the literal's value
    "UserDefinedLiteral"
    (if-let [u (:_udl n)]
      (let [callee {:kind "DeclRefExpr" :referencedDecl {:name (str "operator\"\"" (:suffix u))} :range (:range n)}
            args (case (:k u)
                   :str [{:kind "StringLiteral" :value (:value u) :type {:qualType (str "const " (:ty u) "[" (:n u) "]")} :valueCategory "lvalue" :range (:range n)}
                         {:kind "IntegerLiteral" :value (str (dec (long (:n u)))) :type {:qualType "unsigned long"} :valueCategory "prvalue"}]
                   :chr [{:kind "CharacterLiteral" :value (:value u) :type {:qualType (:ty u)} :valueCategory "prvalue"}]
                   :int [{:kind "IntegerLiteral" :value (str (:value u)) :type {:qualType "unsigned long long"} :valueCategory "prvalue"}]
                   :float [{:kind "FloatingLiteral" :value (str (:value u)) :type {:qualType "long double"} :valueCategory "prvalue"}])]
        (analyze ctx {:kind "CallExpr" :inner (vec (cons callee args)) :range (:range n)}))
      (fail :expr "a user-defined literal"))
    ;; __builtin_va_arg(ap, T) (clang's VAArgExpr; G5): the next argument of a va_list
    "BuiltinExpr" (if-let [x (:_vaarg n)]
                    (let [t (resolve-type (:scope ctx) (:_vatype n))]
                      {:op :va-arg :e (rv (analyze ctx x)) :ty (abi/unq t) :cat :pr})
                    (fail :expr "a builtin expression " (node-text n)))
    "TypeTraitExpr" (let [t (or (:_text n) (node-text n))
                          v (if-let [h (:trait-text @hooks)] (h (:scope ctx) t) (fail :expr "a type trait"))]
                      (when (map? v) (fail :expr "a dependent type trait " t))
                      {:op :int :v (long v) :ty (if (re-find #"^\s*__(is|has|reference)_" t) abi/bool* abi/ulong*) :cat :pr})
    "CXXBoolLiteralExpr" {:op :int :v (if (:value n) 1 0) :ty abi/bool* :cat :pr}
    "FloatingLiteral" (let [qt (get-in n [:type :qualType])]
                        {:op :float :v (Double/parseDouble (:value n)) :lit (when (= qt "long double") (:value n))
                         :ty (case qt "float" abi/float* "long double" (abi/b :ldouble) abi/double*) :cat :pr})
    "StringLiteral" (let [s (decode-string (:value n))
                          t (resolve-type (:scope ctx) (get-in n [:type :qualType]))]
                      (when-not (= :char (abi/bn (abi/unq (:of t)))) (fail :string "a wide string"))
                      {:op :str :s s :ty t :cat :lv})
    ;; __func__, __FUNCTION__, __PRETTY_FUNCTION__ ([dcl.fct.def.general]/8): the enclosing function's name (the pretty
    ;; one approximated by the name: G4, the headers' assertions, whose strings no run reads)
    "PredefinedExpr" (let [nm (or (:name (fnd (:fn-id ctx))) "")]
                       {:op :str :s nm :ty (abi/arr (inc (count nm)) (assoc abi/char* :c true)) :cat :lv})
    ;; a requires-expression ([expr.prim.req]): true when each requirement holds, its parameters local names of their
    ;; types; an expression's requirement holds when it analyzes (a substitution failure is false), a type's when it
    ;; resolves, a nested one when its constraint is satisfied; a compound one's return-type requirement not checked (G4)
    "RequiresExpr" (if (and (empty? (:inner n)) (nil? (:params n)))
                     (fail :expr "a requires-expression the parser kept as its text")
                     (let [c (block-ctx ctx)
                           _ (doseq [pn (:params n)]
                               (let [id (next-id)]
                                 (swap! *vars* assoc id {:id id :name (:name pn) :ty (resolve-type (:scope c) (get-in pn [:type :qualType])) :storage :local :fn (:fn-id ctx)})
                                 (when (:name pn) (enter! (:scope c) (:name pn) {:e :var :id id}))))
                           ok? (fn [r]
                                 (try (case (:kind r)
                                        "TypeRequirement" (do (resolve-type (:scope c) (get-in r [:type :qualType])) true)
                                        "NestedRequirement" (constraint-satisfied? (:scope c) (first (:inner r)))
                                        (do (analyze c (first (:inner r))) true))
                                      (catch arbace.lang.ExceptionInfo _ false)))]
                       {:op :int :v (if (every? ok? (:inner n)) 1 0) :ty abi/bool* :cat :pr}))
    ;; noexcept(e) ([expr.unary.noexcept]): e unevaluated, true when no function it calls may throw (an implicit or
    ;; defaulted special member counted as not throwing; G4)
    "CXXNoexceptExpr" (let [x (analyze ctx (first (kids n)))
                            fns (atom #{})
                            walk (fn walk [x] (cond (map? x) (when-not (:kind x)
                                                                (when (integer? (:fn x)) (swap! fns conj (:fn x)))
                                                                (doseq [[k v] x :when (not (#{:scope :node :def-scope :parent :names :usings :ty} k))] (walk v)))
                                                    (sequential? x) (doseq [y x] (walk y))
                                                    :else nil))]
                        (walk x)
                        {:op :int :v (if (every? #(let [f (fnd %)] (or (:noexcept f) (:implicit f) (:defaulted f))) @fns) 1 0) :ty abi/bool* :cat :pr})
    "CXXNullPtrLiteralExpr" {:op :null :ty abi/nullptr-t :cat :pr}
    "GNUNullExpr" {:op :int :v 0 :ty abi/long* :cat :pr}
    "ParenExpr" (analyze ctx (first (kids n)))
    "DeclRefExpr" (name-expr ctx n)
    "CXXThisExpr" (this-expr ctx)
    "UnaryOperator"
    (or
     ;; &C::m: a pointer to member ([expr.unary.op]/4)
     (when (and (= "&" (:opcode n)) (= "DeclRefExpr" (:kind (first (kids n)))))
       (let [k (first (kids n)) [g q] (ref-qualifier k)]
         (when (seq q)
           (let [es (lookup-qualified (:scope ctx) (conj q (get-in k [:referencedDecl :name])) g)
                 e (first es)]
             (case (:e e)
               :field (let [qc (class-id (:ty (type-entity (lookup-qualified (:scope ctx) q g))))
                            f (nth (:fields (abi/cls (:cls e))) (:i e))]
                        {:op :mptr-data :off (+ (long (second (abi/base-path qc (:cls e)))) (abi/field-offset (:cls e) (:i e)))
                         :ty {:k :mptr :cls qc :to (:ty f)} :cat :pr})
               :fn (let [fs (mapv :id (filter #(= :fn (:e %)) es))
                         ms (filter #(let [f (fnd %)] (and (:cls f) (not (:static f)))) fs)]
                     (when (seq ms)
                       {:op :mptr-fnset :fns (vec ms) :ty {:k :overload} :cat :pr}))
               nil)))))
    (let [o (:opcode n) e (analyze ctx (first (kids n)))]
      (or (when (and (class-operand? e) (not= o "&")) (operator-call ctx o (if (and (#{"++" "--"} o) (:isPostfix n)) [e {:op :int :v 0 :ty abi/int* :cat :pr}] [e])))
          (case o
            "&" (cond (= :fnset (:op e)) (let [f (first (:fns e))] {:op :fnaddr :fn f :ty (abi/ptr (:ty (fnd f))) :cat :pr})
                      (lv? e) {:op :addr :e e :ty (abi/ptr (:ty e)) :cat :pr}
                      :else (fail :addr "& of an rvalue"))
            "*" (deref-node e)
            ("++" "--") (do (when-not (lv? e) (fail :incdec "++ of an rvalue"))
                            {:op :incdec :o o :post (boolean (:isPostfix n)) :e e :ty (abi/unq (:ty e)) :cat (if (:isPostfix n) :pr :lv)})
            "!" {:op :not :e (to-bool e) :ty abi/bool* :cat :pr}
            ("-" "+" "~") (let [r (rv e) pt (promote-type (:ty r))] {:op :unop :o o :e (convert-scalar r pt false) :ty pt :cat :pr})
            (fail :operator "unary " o)))))
    "BinaryOperator"
    (let [o (:opcode n) [ln rn] (kids n) l (analyze ctx ln) r (analyze ctx rn)]
      (cond
        (= o "=") (assign-node ctx l r)
        (#{".*" "->*"} o) (builtin-binop o l r)
        :else
        (or (when (and (or (class-operand? l) (class-operand? r)) (not= o ",")) (operator-call ctx o [l r]))
            (builtin-binop o (class->scalar ctx l) (class->scalar ctx r)))))
    "CompoundAssignOperator"
    (let [o (:opcode n) [ln rn] (kids n) l (analyze ctx ln) r (analyze ctx rn)]
      (or (when (or (class-operand? l) (class-operand? r)) (operator-call ctx o [l r]))
          (compound-node (subs o 0 (dec (count o))) l (class->scalar ctx r))))
    "ConditionalOperator"
    (let [[c a b] (kids n) c (fold-mark (to-bool (analyze ctx c))) a (analyze ctx a) b (analyze ctx b)]
      (cond
        (and (lv? a) (lv? b) (= (:ty a) (:ty b))) {:op :cond :c c :then a :else b :ty (:ty a) :cat :lv}
        (and (abi/class? (abi/unq (:ty a))) (= (abi/unq (:ty a)) (abi/unq (:ty b))))
        {:op :cond :c c :then (if (= :pr (:cat a)) a {:op :temp-obj :init (init-for (abi/unq (:ty a)) a ctx :copy) :ty (abi/unq (:ty a)) :cat :pr})
         :else (if (= :pr (:cat b)) b {:op :temp-obj :init (init-for (abi/unq (:ty b)) b ctx :copy) :ty (abi/unq (:ty b)) :cat :pr}) :ty (abi/unq (:ty a)) :cat :pr}
        :else (let [a (rv a) b (rv b)
                    t (cond (and (abi/arith? (:ty a)) (abi/arith? (:ty b))) (arith-common (:ty a) (:ty b))
                            (abi/ptr? (:ty a)) (:ty a) (abi/ptr? (:ty b)) (:ty b)
                            (abi/void? (:ty a)) abi/void
                            :else (abi/unq (:ty a)))]
                {:op :cond :c c :then (convert-scalar a t false) :else (convert-scalar b t false) :ty t :cat :pr})))
    "CallExpr"
    (if-let [op (when (= "DeclRefExpr" (:kind (first (kids n))))
                  ({"__builtin_operator_new" "operator new" "__builtin_operator_delete" "operator delete"}
                   (get-in (first (kids n)) [:referencedDecl :name])))]
      ;; __builtin_operator_new/delete: the global operator new or delete called as by a new- or delete-expression
      ;; (clang's EmitBuiltinNewDeleteCall; G4: std::allocator's allocate and deallocate)
      (analyze ctx (assoc n :inner (vec (cons (assoc (first (kids n)) :referencedDecl {:name op} :_wn true :globalQualifier true) (rest (kids n))))))
    (if-let [b (when (= "DeclRefExpr" (:kind (first (kids n)))) (value-builtins (get-in (first (kids n)) [:referencedDecl :name])))]
      ;; the builtins that are their operand's value (G4: the headers' __builtin_expect(e, v): e as a long;
      ;; __builtin_constant_p: 0 at run time, as clang folds it at -O0 when e is not a constant)
      (case b
        :expect (convert-scalar (rv (analyze ctx (second (kids n)))) abi/long* false)
        :constant-p {:op :int :v (if (ce-try (rv (analyze ctx (second (kids n))))) 1 0) :ty abi/int* :cat :pr}
        :is-constant-evaluated {:op :int :v 0 :ty abi/bool* :cat :pr}
        ;; __builtin_addressof(x): x's address, no operator& ([specialized.addressof])
        :addressof (let [e (analyze ctx (second (kids n)))] {:op :addr :e e :ty (abi/ptr (:ty e)) :cat :pr})
        ;; __builtin_alloca(n): n bytes of the frame (clang's alloca i8, i64 n, align 16)
        ;; va_start, va_end, va_copy: LLVM's intrinsics on the va_list's address (x86-64: __va_list_tag[1], decayed)
        (:va-start :va-end :va-copy)
        (let [as (mapv #(rv (analyze ctx %)) (rest (kids n)))]
          {:op :va :which b :args (if (= b :va-copy) (subvec as 0 2) (subvec as 0 1)) :ty abi/void :cat :pr})
        :alloca {:op :alloca :e (convert-scalar (rv (analyze ctx (second (kids n)))) abi/ulong* false) :ty (abi/ptr abi/void) :cat :pr}
        ;; __builtin_{add,sub,mul}_overflow(a, b, &r): r = a op b in r's type; the overflow flag false (a divergence
        ;; when it overflows: no wider arithmetic yet; G4: <bits/stl_vector.h>'s size computations)
        (:add-overflow :sub-overflow :mul-overflow)
        (let [[x y r] (mapv #(analyze ctx %) (rest (kids n)))
              dst (deref-node (rv r))
              o ({:add-overflow "+" :sub-overflow "-" :mul-overflow "*"} b)]
          {:op :comma :l (assign-node ctx dst (convert-scalar (arith-binop o x y) (abi/unq (:ty dst)) false)) :r {:op :int :v 0 :ty abi/bool* :cat :pr}
           :ty abi/bool* :cat :pr}))
    (let [[cn & an] (kids n)
          ;; a pseudo-destructor call (p->~T() of a scalar T, [expr.prim.id.dtor]): its object evaluated, no effect (G4:
          ;; std::destroy_at<int>)
          pseudo (when (and (= "MemberExpr" (:kind cn)) (str/starts-with? (str (:name cn)) "~") (empty? an))
                   (let [o (analyze ctx (first (kids cn))) o (if (:isArrow cn) (deref-node o) o)]
                     (when-not (class-id (:ty o)) o)))]
     (if pseudo
      (cast-expr ctx abi/void pseudo true)
    (let [callee (analyze ctx cn)
          args (analyze-args ctx an)]
      (if (and (abi/class? (abi/unq (:ty callee))) (not= :fnset (:op callee)))
        (or (operator-call ctx "()" (into [callee] args)) (fail :call "no operator()"))
        (analyze-call ctx (if (and (= :fnset (:op callee)) (if (:_wn cn) (boolean (or (:globalQualifier cn) (seq (:qualifier cn)))) (str/includes? (or (node-text cn) "") "::"))) (assoc callee :qualified true) callee) args)))))
)
)
    "MemberExpr" (member-expr ctx n)
    ;; a member named in a template's pattern whose lookup clang left to the instantiation (f<T>() in a member)
    "UnresolvedMemberExpr" (if (seq (kids n))
                             (member-expr ctx (assoc n :name (or (get-in n [:referencedDecl :name]) (:name n))))
                             (name-expr ctx n))
    "ArraySubscriptExpr"
    (let [[an in] (kids n) a (analyze ctx an) i (analyze ctx in)]
      (or (when (class-operand? a) (operator-call ctx "[]" [a i]))
          (let [i (class->scalar ctx i)]
          (let [[p ix] (if (abi/ptr? (:ty (rv a))) [(rv a) (rv i)] [(rv i) (rv a)])]
            {:op :deref :e {:op :ptradd :o "+" :p p :n (convert-scalar ix abi/long* false) :ty (:ty p) :cat :pr} :ty (:to (:ty p)) :cat :lv}))))
    ("CStyleCastExpr" "CXXStaticCastExpr" "CXXReinterpretCastExpr" "CXXConstCastExpr" "CXXFunctionalCastExpr")
    (let [t (resolve-type (:scope ctx) (get-in n [:type :qualType]))
          [k] (kids n)
          t (if (and (#{:xvalue "xvalue"} (:valueCategory n)) (not (abi/ref? t))) (abi/rref t) t)
          t (if (and (= "lvalue" (:valueCategory n)) (not (abi/ref? t))) (abi/lref t) t)]
      (if (and (= "CXXFunctionalCastExpr" (:kind n)) (abi/class? (abi/unq t)))
        {:op :temp-obj :init (init-for t (if (= "InitListExpr" (:kind k)) (analyze ctx k) [(analyze ctx k)]) ctx :direct) :ty (abi/unq t) :cat :pr}
        (cast-expr ctx t (analyze ctx k) true)))
    ("CXXTemporaryObjectExpr" "CXXUnresolvedConstructExpr" "CXXConstructExpr")
    (let [t (resolve-type (:scope ctx) (get-in n [:type :qualType]))
          args (analyze-args ctx (kids n))]
      (if (abi/class? (abi/unq t))
        {:op :temp-obj :init (init-for t args ctx (if (empty? args) :value :direct)) :ty (abi/unq t) :cat :pr}
        (if (empty? args) {:op :zero-val :ty t :cat :pr} (cast-expr ctx t (first args) true))))
    "CXXScalarValueInitExpr" (let [t (resolve-type (:scope ctx) (get-in n [:type :qualType]))] {:op :zero-val :ty t :cat :pr})
    "InitListExpr" {:op :init-list :items (analyze-args ctx (kids n)) :ty {:k :init-list}}
    ;; sizeof...(pack): the number of a pack's elements (CODEGEN.md G3)
    "SizeOfPackExpr" (let [e (first (lookup (:scope ctx) (:name n)))]
                       (when-not (#{:pack :varpack} (:e e)) (fail :pack "sizeof... of a non-pack " (:name n)))
                       {:op :int :v (count (or (:elems e) (:ids e))) :ty abi/ulong* :cat :pr})
    "UnaryExprOrTypeTraitExpr"
    (let [t (if-let [at (get-in n [:argType :qualType])] (resolve-type (:scope ctx) at) (:ty (analyze ctx (first (kids n)))))
          t (abi/non-ref t)]
      (case (:name n)
        "sizeof" {:op :int :v (abi/size-of t) :ty abi/ulong* :cat :pr}
        "alignof" {:op :int :v (abi/align-of t) :ty abi/ulong* :cat :pr}
        ;; GNU's __alignof__: the preferred alignment, x86-64's the ABI's for every type the slice lays out
        "__alignof" {:op :int :v (abi/align-of t) :ty abi/ulong* :cat :pr}
        (fail :trait (:name n))))
    "CXXNewExpr" (new-expr ctx n)
    "CXXDeleteExpr" (let [e (rv (analyze ctx (first (kids n))))
                          et (:to (abi/unq (:ty e)))
                          arr (boolean (:isArrayAsWritten n))
                          d (delete-dealloc et arr (boolean (:isGlobal n)))
                          bt (loop [t (abi/unq et)] (if (abi/arr? t) (recur (abi/unq (:of t))) t)) c (class-id bt)]
                      {:op :delete :e e :array arr :dealloc d :global (boolean (:isGlobal n))
                       ;; the array's cookie: a non-trivial destructor, or a usual operator delete[] taking the size
                       :cookie (boolean (and arr (or (and c (not (trivial-dtor? c))) (:size d))))
                       :ty abi/void :cat :pr})
    "ExprWithCleanups" (analyze ctx (first (kids n)))
    "LambdaExpr" (lambda-expr ctx n)
    "CXXTypeidExpr"
    (let [ti (let [es (lookup-qualified *root* ["std" "type_info"] true)] (:ty (type-entity es)))
          _ (when-not ti (fail :rtti "typeid without std::type_info"))
          ti (assoc ti :c true)]
      (if-let [ta (get-in n [:typeArg :qualType])]
        {:op :typeid :t (abi/unq (abi/non-ref (resolve-type (:scope ctx) ta))) :ty ti :cat :lv}
        (let [e (analyze ctx (first (kids n)))
              cid (class-id (:ty e))]
          (if (and cid (lv? e) (abi/dynamic? cid))
            {:op :typeid :e e :ty ti :cat :lv}
            {:op :comma :l (if (and cid (= :pr (:cat e))) {:op :cast :ck :void :e e :ty abi/void :cat :pr} {:op :cast :ck :void :e e :ty abi/void :cat :pr})
             :r {:op :typeid :t (abi/unq (:ty e)) :ty ti :cat :lv} :ty ti :cat :lv}))))
    "CXXDynamicCastExpr"
    (let [t (resolve-type (:scope ctx) (get-in n [:type :qualType]))
          e (analyze ctx (first (kids n)))
          ref (abi/ref? t)
          src (if ref e (rv e))
          sc (if ref (class-id (:ty src)) (class-id (:to (abi/unq (:ty src)))))
          dt (if ref (abi/unq (:to t)) (:to (abi/unq t)))
          dc (class-id dt)]
      (cond
        (and dc sc (or (= dc sc) (abi/derived-from? sc dc))) (cast-expr ctx t e false)
        (and (not ref) (abi/void? dt)) {:op :dyncast :e src :void true :ty t :cat :pr}
        :else {:op :dyncast :e src :ref ref :from sc :to dc :ty (if ref dt t) :cat (if ref (if (= :rref (:k t)) :xv :lv) :pr)
               :hint (if-let [[_ off vb] (abi/base-path dc sc)] (if vb -1 off) -2)}))
    "CXXThrowExpr" (if-let [k (first (kids n))]
                     (let [e (analyze ctx k)
                           r (if (abi/class? (abi/unq (:ty e))) e (rv e))
                           t (abi/unq (:ty r))]
                       {:op :throw :ety t :init (init-for t e ctx :copy) :ty abi/void :cat :pr})
                     {:op :throw :ty abi/void :cat :pr})
    (fail :expr "expression " (:kind n) (when (System/getenv "CPP_HDR_TRACE") (str " at " (pr-str (loc-of (get-in n [:range :begin]))))))))

;; ---------------------------------------------------------------------------------------------
;; Statements

(declare stmt)

(defn- local-var! [ctx n storage]
  (let [ty (resolve-type (:scope ctx) (get-in n [:type :qualType]))
        id (next-id)
        st (if (= "static" (:storageClass n)) :static-local storage)
        v {:id id :name (:name n) :ty ty :storage st :fn (:fn-id ctx) :init-node (init-kid n) :constexpr (boolean (:constexpr n))}
        ;; a constant local's initializer, for constant expressions (an array bound, a template argument)
        v (if (and (:c ty) (abi/integral? (abi/unq ty)) (init-kid n)) (assoc v :init (init-kid n) :def-scope (:scope ctx)) v)]
    (swap! *vars* assoc id v)
    id))

(defn- has-auto? [t] (cond (= :auto (:k t)) true (#{:ref :rref :ptr} (:k t)) (has-auto? (:to t)) :else false))

(defn deduce-auto
  "The type `t` with its auto deduced from the initializer `e` ([dcl.type.auto.deduct]: a plain auto drops references,
  top-level cv-qualifiers and decays; auto& keeps the initializer's cv; auto&& is a forwarding reference)."
  [t e]
  (case (:k t)
    :auto (let [et (if (abi/class? (abi/unq (:ty e))) (abi/unq (:ty e)) (abi/unq (:ty (rv e))))] (cond-> et (:c t) (assoc :c true) (:v t) (assoc :v true)))
    :ref (assoc t :to (if (= :auto (:k (:to t))) (cond-> (:ty e) (:c (:to t)) (assoc :c true)) (deduce-auto (:to t) e)))
    :rref (if (and (= :auto (:k (:to t))) (= :lv (:cat e))) (abi/lref (:ty e)) (assoc t :to (if (= :auto (:k (:to t))) (:ty e) (deduce-auto (:to t) e))))
    :ptr (assoc t :to (let [pt (:to (abi/unq (:ty (rv e))))] (if (= :auto (:k (:to t))) (cond-> pt (:c (:to t)) (assoc :c true)) (deduce-auto (:to t) {:op :deref :ty pt :cat :lv}))))
    t))

(defn- decl-init
  "A local declaration's initializer from its node (`:init` c, call or list)."
  [ctx id n]
  (let [t (:ty (var* id))
        init (init-kid n)
        t (if (and (abi/arr? t) (nil? (:n t)) init)
            (let [a (analyze ctx init)]
              (cond (= :init-list (:op a)) (if (and (= 1 (count (:items a))) (= :str (:op (first (:items a))))) (assoc t :n (inc (count (:s (first (:items a)))))) (assoc t :n (count (:items a))))
                    (= :str (:op a)) (assoc t :n (inc (count (:s a))))
                    :else t))
            t)
        pre (when (and init (has-auto? t) (not (#{"call" "list"} (:init n)))) (analyze ctx init))
        t (if pre (deduce-auto t pre) t)
        _ (upd-var! id assoc :ty t)]
    (cond
      pre (init-for t pre ctx (if (= :init-list (:op pre)) :list :copy))
      (nil? init) (init-for t nil ctx :default)
      (= "call" (:init n)) (init-for t (if (= "ParenListExpr" (:kind init)) (analyze-args ctx (kids init)) [(analyze ctx init)]) ctx :direct)
      (= "list" (:init n)) (init-for t (analyze ctx init) ctx :list)
      :else (let [a (analyze ctx init)] (init-for t a ctx (if (= :init-list (:op a)) :list :copy))))))

(defn- decl-stmt [ctx n]
  (vec (for [d (kids n)]
         (case (:kind d)
           "VarDecl" (let [id (local-var! ctx d :local)
                           v (var* id)]
                       (if (= :static-local (:storage v))
                         (do (swap! (:statics ctx) conj id)
                             (let [c (count (filter #(= (:name (var* %)) (:name v)) @(:statics ctx)))]
                               (upd-var! id assoc :disc (dec c) :init-node (first (kids d))))
                             (let [init (decl-init ctx id d)]
                               (enter! (:scope ctx) (or (:name d) "") {:e :var :id id})
                               (upd-var! id assoc :sinit init)
                               {:s :static-local :var id}))
                         (let [init (decl-init ctx id d)
                               t (:ty (var* id))
                               ;; a constexpr local, or a const integral one, initialized by a constant: folded (clang
                               ;; emits the value)
                               init (if (and (= :expr (:i init)) (abi/scalar? (abi/unq t)) (not (#{:int :float :null} (:op (:e init))))
                                             (or (:constexpr d) (and (:c t) (abi/integral? t))))
                                      (if-let [c (ce-try (:e init))] (assoc init :e c) init)
                                      init)]
                           (enter! (:scope ctx) (or (:name d) "") {:e :var :id id})
                           {:s :decl :var id :init init})))
           "CXXRecordDecl" (do (declare-class! (:scope ctx) d) {:s :null})
           "FunctionDecl" (do (declare-fn! (:scope ctx) d) {:s :null}) ; a block-scope function declaration
           "EnumDecl" (do (declare-enum! (:scope ctx) d) {:s :null})
           ("TypedefDecl" "TypeAliasDecl" "UsingDecl" "UsingDirectiveDecl" "NamespaceAliasDecl") (do (declare-node! (:scope ctx) d) {:s :null})
           ;; (a static_assert: checked by clang's route, no code)
           "StaticAssertDecl" {:s :null}
           (fail :decl "local declaration " (:kind d))))))

(defn- block-ctx [ctx] (assoc ctx :scope (new-scope :block (:scope ctx))))

(defn- full [e] {:s :expr :e e})

(defn- cond-of [ctx n]
  (to-bool (analyze ctx n)))

(declare local-var! stmt)

(defn- range-for-class
  "A range-based for over a class ([stmt.ranged]/1: auto&& __range = e; auto __begin = __range.begin(), __end =
  __range.end(); for (; __begin != __end; ++__begin) { T x = *__begin; body }), the members begin and end (G4: the
  headers' containers), their operators by overload resolution."
  [c range-e loopd body]
  (let [ref (fn [nm] {:kind "DeclRefExpr" :referencedDecl {:name nm}})
        local! (fn [nm t]
                 (let [id (next-id)]
                   (swap! *vars* assoc id {:id id :name nm :ty t :storage :local :fn (:fn-id c)})
                   (enter! (:scope c) nm {:e :var :id id})
                   id))
        rt (if (= :lv (:cat range-e)) (abi/lref (:ty range-e)) (abi/rref (abi/unq (:ty range-e))))
        rid (local! "__range1" rt)
        rinit (init-for rt range-e c :copy)
        call (fn [m] (analyze c {:kind "CallExpr" :inner [{:kind "MemberExpr" :name m :isArrow false :inner [(ref "__range1")]}]}))
        be (call "begin") ee (call "end")
        bt (abi/unq (abi/non-ref (:ty be))) et (abi/unq (abi/non-ref (:ty ee)))
        bid (local! "__begin1" bt) eid (local! "__end1" et)
        binit (init-for bt be c :copy) einit (init-for et ee c :copy)
        cnd (cond-of c {:kind "BinaryOperator" :opcode "!=" :inner [(ref "__begin1") (ref "__end1")]})
        inc (analyze c {:kind "UnaryOperator" :opcode "++" :inner [(ref "__begin1")]})
        ic (block-ctx c)
        de (analyze ic {:kind "UnaryOperator" :opcode "*" :inner [(ref "__begin1")]})
        lid (local-var! ic loopd :local)
        lt (:ty (var* lid))
        lt (if (has-auto? lt) (deduce-auto lt de) lt)
        _ (upd-var! lid assoc :ty lt)
        linit (init-for lt de ic :copy)
        _ (enter! (:scope ic) (:name loopd) {:e :var :id lid})]
    {:s :block :items [{:s :decl :var rid :init rinit} {:s :decl :var bid :init binit} {:s :decl :var eid :init einit}
                       {:s :for :cond cnd :inc inc :body {:s :block :items [{:s :decl :var lid :init linit} (stmt ic body)]}}]}))

(defn stmt
  "The typed statement of a tree node."
  [ctx n]
  (case (:kind n)
    nil {:s :null}
    "CompoundStmt" (let [c (block-ctx ctx)] {:s :block :items (vec (mapcat #(let [x (stmt c %)] (if (vector? x) x [x])) (kids n)))})
    "DeclStmt" {:s :block :flat true :items (decl-stmt ctx n)}
    "NullStmt" {:s :null}
    "ReturnStmt" (let [[e] (kids n)
                       rt (:ret (:ty (fnd (:fn-id ctx))))
                       pre (when (and e (= :auto (:k rt))) (analyze ctx e))
                       rt (if (= :auto (:k rt))
                            (let [t (if pre (deduce-auto rt pre) abi/void)] (upd-fn! (:fn-id ctx) assoc-in [:ty :ret] t) t)
                            rt)]
                   (cond
                     (nil? e) {:s :return}
                     pre (if (abi/void? rt) {:s :return :void-e pre}
                             {:s :return :init (init-for rt pre ctx (if (= :init-list (:op pre)) :list :copy))})
                     (abi/void? rt) {:s :return :void-e (analyze ctx e)}
                     :else (let [a (analyze ctx e)
                                 ;; [class.copy.elision]/3: a returned local is an rvalue first
                                 a (if (and (= :var (:op a)) (#{:local :param} (:storage (var* (:id a)))) (abi/class? (abi/unq (:ty a))))
                                     (assoc a :cat :xv :nrvo-var (:id a)) a)]
                             {:s :return :init (init-for rt a ctx (if (= :init-list (:op a)) :list :copy)) :nrvo-var (:nrvo-var a)})))
    "IfStmt" (if (:isConsteval n)
               ;; if consteval ([stmt.if]/4): at run time the branch of a context not constant-evaluated (G4: the
               ;; headers' std::__is_constant_evaluated)
               (let [[a e] (:inner n)]
                 (if (:isNegatedConsteval n) (stmt (block-ctx ctx) a) (if e (stmt (block-ctx ctx) e) {:s :null})))
             (let [c (block-ctx ctx)
                   ks (vec (:inner n))
                   ;; clang's IfStmt: [init?] [condvar decl?] cond then else?, the flags say which
                   [init ks] (if (:hasInit n) [(first ks) (subvec ks 1)] [nil ks])
                   [cvar ks] (if (:hasVar n) [(first ks) (subvec ks 1)] [nil ks])
                   init-s (when init (stmt c init))
                   cvar-s (when cvar (stmt c cvar))
                   cn (first ks)
                   cn (if (and cvar (nil? (get-in cn [:referencedDecl :name])))
                        (assoc cn :referencedDecl {:name (:name (first (kids cvar)))}) cn)]
               {:s :block :items (vec (concat (when init-s [init-s]) (when cvar-s [cvar-s])
                                              (if (:isConstexpr n)
                                                ;; if constexpr ([stmt.if]/2): the condition a constant, the discarded branch not analyzed
                                                [(if (not= 0 (long (const-int (:scope c) cn)))
                                                   (stmt (block-ctx c) (nth ks 1))
                                                   (if (:hasElse n) (stmt (block-ctx c) (nth ks 2)) {:s :null}))]
                                                [{:s :if :cond (fold-mark (cond-of c cn)) :then (stmt (block-ctx c) (nth ks 1))
                                                  :else (when (:hasElse n) (stmt (block-ctx c) (nth ks 2)))}])))}))
    "WhileStmt" (let [c (block-ctx ctx) ks (vec (:inner n))
                      [cvar ks] (if (:hasVar n) [(first ks) (subvec ks 1)] [nil ks])]
                  (when cvar (fail :stmt "a while condition's declaration (destroyed each iteration)"))
                  {:s :while :cond (cond-of c (first ks)) :body (stmt (block-ctx c) (second ks))})
    "DoStmt" (let [[b cn] (kids n)] {:s :do :body (stmt (block-ctx ctx) b) :cond (cond-of ctx cn)})
    "ForStmt" (let [c (block-ctx ctx)
                    [init cvar cn inc body] (:inner n)
                    init (when (:kind init) (stmt c init))]
                (when (:kind cvar) (fail :stmt "a for condition's declaration"))
                {:s :block :items [(or init {:s :null})
                                   {:s :for :cond (when (:kind cn) (cond-of c cn)) :inc (when (:kind inc) (analyze c inc))
                                    :body (stmt (block-ctx c) body)}]})
    "CXXForRangeStmt"
    (let [c (block-ctx ctx)
          ks (vec (:inner n))
          rangen (some #(when (= "DeclStmt" (:kind %)) %) ks)
          range-e (analyze c (first (kids (first (kids rangen)))))
          loopd (first (kids (last (filter #(= "DeclStmt" (:kind %)) ks))))
          body (last ks)
          ;; for (x : {a, b}): the range a std::initializer_list<E>, E the elements' deduced type ([stmt.ranged]/1,
          ;; [dcl.type.auto.deduct]/4; G5)
          range-e (if (= :init-list (:op range-e))
                    (let [ts (distinct (map #(abi/unq (:ty (rv %))) (:items range-e)))
                          e (if (= 1 (count ts)) (first ts) (fail :range-for "a braced range of elements of different types"))
                          te (first (filter #(= :tmpl (:e %)) (lookup-qualified *root* ["std" "initializer_list"] true)))
                          t (if te ((:instantiate-class @hooks) (:id te) [e]) (fail :range-for "a braced range without <initializer_list>"))]
                      (materialize (or (std-init-list t range-e c) (fail :range-for "a braced range"))))
                    range-e)
          at (:ty range-e)]
      (if (and (not (abi/arr? (abi/unq at))) (class-id at))
        (range-for-class c range-e loopd body)
      (do
      (when-not (abi/arr? (abi/unq at)) (fail :range-for "a range for over a non-array"))
      ;; for (T x : a) as { T* b = a; T* e = a + N; for (; b != e; ++b) { T x = *b; body } }
      (let [et (:of at)
            pt (abi/ptr et)
            bid (next-id) eid (next-id)
            _ (swap! *vars* assoc bid {:id bid :name "__begin" :ty pt :storage :local :fn (:fn-id ctx)} eid {:id eid :name "__end" :ty pt :storage :local :fn (:fn-id ctx)})
            bvar {:op :var :id bid :ty pt :cat :lv}
            evar {:op :var :id eid :ty pt :cat :lv}
            ic (block-ctx c)
            lid (local-var! ic loopd :local)
            lt (:ty (var* lid))
            lt (if (has-auto? lt) (deduce-auto lt {:op :deref :e (rv bvar) :ty et :cat :lv}) lt)
            _ (upd-var! lid assoc :ty lt)
            linit (init-for lt {:op :deref :e (rv bvar) :ty et :cat :lv} ic :copy)
            _ (enter! (:scope ic) (:name loopd) {:e :var :id lid})]
        {:s :block :items [{:s :decl :var bid :init {:i :expr :e (rv range-e)}}
                           {:s :decl :var eid :init {:i :expr :e {:op :ptradd :o "+" :p (rv range-e) :n {:op :int :v (:n at) :ty abi/long* :cat :pr} :ty pt :cat :pr}}}
                           {:s :for :cond {:op :cmp :o "!=" :l (rv bvar) :r (rv evar) :ct pt :ty abi/bool* :cat :pr}
                            :inc {:op :incdec :o "++" :post false :e bvar :ty pt :cat :lv}
                            :body {:s :block :items [{:s :decl :var lid :init linit} (stmt ic body)]}}]}))))
    "BreakStmt" {:s :break}
    "ContinueStmt" {:s :continue}
    "SwitchStmt" (let [c (block-ctx ctx) ks (vec (:inner n))
                       [init ks] (if (:hasInit n) [(first ks) (subvec ks 1)] [nil ks])
                       _ (when (:hasVar n) (fail :stmt "a switch condition's declaration"))
                       e (rv (class->scalar c (analyze c (first ks))))
                       pt (promote-type (:ty e))]
                   {:s :block :items (vec (concat (when init [(stmt c init)])
                                                  [{:s :switch :e (convert-scalar e pt false) :ty pt :body (stmt (block-ctx c) (second ks))}]))})
    "CaseStmt" (let [[v body] (kids n)] {:s :case :v (const-int (:scope ctx) v) :body (stmt ctx body)})
    "DefaultStmt" {:s :default :body (stmt ctx (first (kids n)))}
    "LabelStmt" {:s :label :name (:name n) :body (stmt ctx (first (kids n)))}
    "GotoStmt" (let [t (node-text n) [_ l] (re-find #"goto\s+([A-Za-z_][A-Za-z_0-9]*)" (or t ""))] {:s :goto :name l})
    "AttributedStmt" (stmt ctx (last (kids n)))
    "CXXTryStmt" (let [[body & hs] (kids n)]
                   {:s :try :body (stmt ctx body)
                    :handlers (vec (for [h hs]
                                     (let [c (block-ctx ctx)
                                           ks (kids h)
                                           vd (when (= "VarDecl" (:kind (first ks))) (first ks))
                                           b (last ks)]
                                       (if vd
                                         (let [id (local-var! c vd :local)
                                               t (:ty (var* id))
                                               ct (abi/unq (abi/non-ref t))
                                               src {:op :exn-obj :ty ct :cat :lv}
                                               init (cond (abi/ref? t) {:i :bind :e src}
                                                          (abi/ptr? ct) {:i :expr :e {:op :exn-ptr :ty ct :cat :pr}}
                                                          :else (init-for t src c :copy))]
                                           (enter! (:scope c) (:name vd) {:e :var :id id})
                                           {:ty ct :var id :init init :body (stmt c b)})
                                         {:body (stmt c b)}))))})
    (if (or (str/ends-with? (str (:kind n)) "Expr") (str/ends-with? (str (:kind n)) "Operator") (str/ends-with? (str (:kind n)) "Literal"))
      (full (analyze ctx n))
      (fail :stmt "statement " (:kind n)))))

;; ---------------------------------------------------------------------------------------------
;; Functions' bodies

(defn- ctor-inits
  "A constructor's mem-initializers as [{:base bid :init} ...] and [{:field i :init} ...] in initialization order."
  [ctx f]
  (let [cid (:cls f)
        c (abi/cls cid)
        given (into {} (for [i (:inits f)]
                         (let [k (if-let [b (:baseInit i)]
                                   ;; (the class's own name: a delegating constructor, the injected-class-name of a
                                   ;; template's specialization written without its arguments, G5: istreambuf_iterator)
                                   [:base (if (= (str/trim (str (:qualType b))) (:name c)) cid (:id (resolve-type (:scope ctx) (:qualType b))))]
                                   [:field (get-in i [:anyInit :name])])
                               [x] (kids i)]
                           [k x])))
        init-of (fn [t x]
                  (cond
                    (nil? x) nil
                    (= "ParenListExpr" (:kind x)) (init-for t (analyze-args ctx (kids x)) ctx (if (empty? (kids x)) :value :direct))
                    ;; base() or member(): value-initialization ([dcl.init.general]/16.4)
                    (= "ImplicitValueInitExpr" (:kind x)) (init-for t nil ctx :value)
                    (= "InitListExpr" (:kind x)) (init-for t (analyze ctx x) ctx :list)
                    (= "CXXParenListInitExpr" (:kind x)) (init-for t (mapv #(analyze ctx %) (kids x)) ctx :direct)
                    :else (init-for t [(analyze ctx x)] ctx :direct)))
        deleg (get given [:base cid])]
    (if deleg
      {:delegate (init-of {:k :class :id cid} deleg)}
      {:bases (vec (for [[i b] (map-indexed vector (:bases c)) :when (not (:virtual b))]
                     (let [t {:k :class :id (:cls b)}
                           x (get given [:base (:cls b)])]
                       {:base (:cls b) :idx i :init (if (contains? given [:base (:cls b)]) (init-of t x) (init-for t nil ctx :default))})))
       ;; the virtual bases, which the complete object's constructor initializes ([class.base.init]/7)
       :vbases (vec (for [v (abi/vbases-init cid)]
                      (let [t {:k :class :id v}]
                        {:base v :init (if (contains? given [:base v]) (init-of t (get given [:base v])) (init-for t nil ctx :default))})))
       :fields (vec (for [fl (:fields c)]
                      (let [x (get given [:field (:name fl)])]
                        {:field (:i fl)
                         :init (cond
                                 (contains? given [:field (:name fl)]) (if (nil? x) (init-for (:ty fl) nil ctx :value) (init-of (:ty fl) x))
                                 ;; a mem-initializer of an anonymous union's (or struct's) member
                                 (and (:anon fl) (some #(contains? given [:field (:name %)]) (:fields (abi/cls-of (:ty fl)))))
                                 (let [ac (abi/cls-of (:ty fl))
                                       m (first (filter #(contains? given [:field (:name %)]) (:fields ac)))]
                                   {:i :list :cls (:id ac) :items [(init-of (:ty m) (get given [:field (:name m)]))] :fields-used [(:i m)]})
                                 (:init fl) (init-for (:ty fl) (let [d (analyze ctx (:init fl))] (if (= :init-list (:op d)) d d)) ctx (if (= "InitListExpr" (:kind (:init fl))) :list :copy))
                                 :else (init-for (:ty fl) nil ctx :default))})))})))

(defn- nrvo-var
  "The local every return statement of the body returns, when there is one ([class.copy.elision]/1.1, as clang's
  computeNRVO decides it for one variable)."
  [body-s]
  (let [rets (atom [])]
    ((fn walk [s]
       (when (map? s)
         (when (= :return (:s s)) (swap! rets conj (:nrvo-var s)))
         (doseq [k [:items :then :else :body :handlers]] (let [x (get s k)] (if (vector? x) (doseq [y x] (walk y)) (walk x))))))
     body-s)
    (let [vs (distinct @rets)]
      (when (and (= 1 (count vs)) (first vs) (= :local (:storage (var* (first vs))))) (first vs)))))

(defn analyze-fn!
  "Analyzes a function's body (and a constructor's mem-initializers) into :tbody."
  [fid]
  (let [f (fnd fid)
        cls (:cls f)
        fs (new-scope :fn (or (:def-scope f) (:scope f)))
        ;; a class or enumeration declared in the body is local to the function: its names mangle as Z <encoding> E ...
        ;; (abi's [:local f] path, as G2's closures have it)
        fs (assoc fs :path [[:local (select-keys f [:id :name :kind :cls :ty :cq :op :static :linkage :internal-l :internal :path :tinst :inline])]])
        ;; a member's body sees the class's members: its scope is the class's for lookups
        fs (if (and cls (not (:keep-def-scope f))) (assoc fs :parent (:scope (abi/cls cls))) fs)
        pids (vec (map-indexed (fn [i t]
                                 (let [id (next-id) nm (nth (:param-names f) i nil)]
                                   (swap! *vars* assoc id {:id id :name nm :ty t :storage :param :fn fid})
                                   (when nm (enter! fs nm {:e :var :id id}))
                                   id))
                               (:ps (:ty f))))
        ;; a function parameter pack's name stands for its parameters (CODEGEN.md G3)
        _ (doseq [[nm idxs] (:param-packs f)] (enter! fs nm {:e :varpack :ids (mapv #(nth pids %) idxs)}))
        this-t (when (and cls (not (:static f))) (abi/ptr (cond-> {:k :class :id cls} (:cq f) (assoc :c true))))
        cut (if cls (let [outer (loop [id cls] (let [c (abi/cls id) s (:outer c)] (if (= :class (:kind s)) (recur (:cls s)) c)))] Long/MAX_VALUE) (:pos f))
        ctx {:scope fs :fn-id fid :this-type this-t :statics (atom [])}]
    (binding [*cutoff* (if cls Long/MAX_VALUE (max (long cut) (long (or (:_b (:body f)) 0))))
              *src* (or (:src f) *src*)]
      (let [trace (fn [g] (if (System/getenv "CPP_HDR_TRACE")
                            (try (g) (catch arbace.lang.ExceptionInfo e
                                       (binding [*out* *err*] (println "in the body of" (:name f) (pr-str (loc-of (get-in (:node f) [:range :begin]))) ":" (.getMessage e)))
                                       (throw e)))
                            (g)))
            inits (when (= :ctor (:kind f)) (when-not (:implicit f) (trace #(ctor-inits ctx f))))
            body (when (:body f) (trace #(stmt ctx (:body f))))
            ;; a constructor's or destructor's function-try-block: control reaching a handler's end rethrows the exception
            ;; ([except.handle]/15; clang's ExitCXXTryStmt, doImplicitRethrow); another function's handler falls through to its end
            ;; ([except.handle]/16). The mem-initializers stay before the try (cpp-90: an exception of theirs is not caught by the
            ;; handlers yet, clang's EmitConstructorBody enters the try before the prologue)
            body (if (and body (= "CXXTryStmt" (:kind (:body f))) (contains? #{:ctor :dtor} (:kind f)) (= :try (:s body)))
                   (update body :handlers (fn [hs] (mapv (fn [h] (update h :body (fn [b] {:s :block :items [b {:s :expr :e {:op :throw :ty abi/void :cat :pr}}]}))) hs)))
                   body)]
        (upd-fn! fid assoc :params pids :tbody body :tinits inits :nrvo (when body (nrvo-var body)) :statics @(:statics ctx))))))

(defn- defaulted-comparison!
  "A defaulted == or <=> ([class.compare.default], [class.eq], [class.spaceship]): the bases' and members' comparisons
  in order -- == their conjunction, <=> the first that is not equal (the common comparison category's, deduced for an
  auto return type) or equal."
  [fid]
  (let [f (fnd fid)
        ps (:ps (:ty f))
        member? (and (:cls f) (not (:static f)) (= 1 (count ps)))
        cls (if member? (:cls f) (class-id (abi/non-ref (first ps))))
        pids (vec (map-indexed (fn [i t] (let [id (next-id)] (swap! *vars* assoc id {:id id :name (str "__p" i) :ty t :storage :param :fn fid}) id)) ps))
        ctx {:scope (:scope (abi/cls cls)) :fn-id fid :this-type (when member? (abi/ptr (cond-> {:k :class :id cls} (:cq f) (assoc :c true)))) :statics (atom [])}
        a (if member? (deref-node (this-expr ctx)) (var-node (first pids)))
        b (var-node (last pids))
        c (abi/cls cls)
        subs (concat (for [bb (:bases c)] [(to-base-lv a (:cls bb)) (to-base-lv b (:cls bb))])
                     (for [fl (:fields c)] [(field-node a cls (:i fl)) (field-node b cls (:i fl))]))
        bin (fn [o x y] (or (when (or (class-operand? x) (class-operand? y)) (operator-call ctx o [x y])) (builtin-binop o (class->scalar ctx x) (class->scalar ctx y))))]
    (binding [*cutoff* Long/MAX_VALUE]
      (case (:op f)
        "==" (let [e (reduce (fn [acc [x y]] (let [t (to-bool (bin "==" x y))] (if acc {:op :land :l acc :r t :ty abi/bool* :cat :pr} t))) nil subs)
                   e (or e {:op :int :v 1 :ty abi/bool* :cat :pr})]
               (upd-fn! fid assoc :params pids :tbody {:s :return :init {:i :expr :e e}}))
        "<=>" (let [cs (vec (for [[x y] subs] (bin "<=>" x y)))
                    nm (fn [t] (:name (abi/cls (class-id t))))
                    declared (:ret (:ty f))
                    rt (if (= :auto (:k declared))
                         (ordering-type (cond (some #(= "partial_ordering" (nm (:ty %))) cs) "partial_ordering"
                                              (some #(= "weak_ordering" (nm (:ty %))) cs) "weak_ordering"
                                              :else "strong_ordering"))
                         (abi/unq declared))
                    zero {:op :int :v 0 :ty abi/int* :cat :pr}
                    as-rt (fn [x] (if (= (class-id (:ty x)) (class-id rt)) x {:op :temp-obj :init (init-for rt [x] ctx :copy) :ty rt :cat :pr}))
                    e (reduce (fn [acc x] {:op :cond :c (to-bool (bin "!=" x zero)) :then (as-rt x) :else acc :ty rt :cat :pr})
                              {:op :ord :v 0 :ty rt :cat :pr} (reverse cs))]
                (upd-fn! fid #(-> % (assoc-in [:ty :ret] rt) (assoc :params pids :tbody {:s :return :init {:i :expr :e e}}))))))
    fid))

(defn analyze-implicit!
  "An implicit (or defaulted) special member's definition: params and, for a default constructor, the members'
  initializers."
  [fid]
  (if (#{"==" "<=>"} (:op (fnd fid)))
    (defaulted-comparison! fid)
  (do (let [f (fnd fid)
        cls (:cls f)
        fs (new-scope :fn (:scope (abi/cls cls)))
        pids (vec (map-indexed (fn [i t] (let [id (next-id)] (swap! *vars* assoc id {:id id :name (str "__p" i) :ty t :storage :param :fn fid}) id)) (:ps (:ty f))))
        ctx {:scope fs :fn-id fid :this-type (abi/ptr {:k :class :id cls}) :statics (atom [])}
        f (assoc f :params pids)]
    (swap! *fns* assoc fid f)
    (when (and (= :ctor (:kind f)) (empty? (:ps (:ty f))))
      (binding [*cutoff* Long/MAX_VALUE] (upd-fn! fid assoc :tinits (ctor-inits ctx (assoc f :inits [])))))
    (when (= :ctor (:kind f))
      (when (= 1 (count (:ps (:ty f))))
        ;; the implicit copy: each base and member copied from the source's
        (let [src (var-node (first pids))
              src {:op :deref :e {:op :load :e {:op :var :id (first pids) :ty (first (:ps (:ty f))) :cat :lv :raw true} :ty (abi/ptr (:to (first (:ps (:ty f))))) :cat :pr} :ty (:to (first (:ps (:ty f)))) :cat :lv}
              c (abi/cls cls)]
          (binding [*cutoff* Long/MAX_VALUE]
            (upd-fn! fid assoc :tinits
                     {:bases (vec (for [[i b] (map-indexed vector (:bases c)) :when (not (:virtual b))]
                                    {:base (:cls b) :idx i :init (init-for {:k :class :id (:cls b)} [(to-base-lv src (:cls b))] ctx :direct)}))
                      :vbases (vec (for [v (abi/vbases-init cls)] {:base v :init (init-for {:k :class :id v} [(to-base-lv src v)] ctx :direct)}))
                      :fields (vec (for [fl (:fields c)]
                                     {:field (:i fl) :init (let [t (:ty fl)]
                                                             (if (abi/arr? t) {:i :copy-bytes :e (field-node src cls (:i fl))}
                                                                 (init-for t [(field-node src cls (:i fl))] ctx :direct)))}))})))))
    (when (and (= :method (:kind f)) (= "=" (:op f)))
      (let [src {:op :deref :e {:op :load :e {:op :var :id (first pids) :ty (first (:ps (:ty f))) :cat :lv :raw true} :ty (abi/ptr (:to (first (:ps (:ty f))))) :cat :pr} :ty (:to (first (:ps (:ty f)))) :cat :lv}
            me (deref-node (this-expr ctx))
            c (abi/cls cls)]
        (binding [*cutoff* Long/MAX_VALUE]
          (upd-fn! fid assoc :tassign
                   (vec (concat (for [b (:bases c)] (full (assign-node ctx (to-base-lv me (:cls b)) (to-base-lv src (:cls b)))))
                                (for [fl (:fields c)]
                                  (if (abi/arr? (:ty fl))
                                    {:s :copy-bytes :dst (field-node me cls (:i fl)) :src (field-node src cls (:i fl))}
                                    (full (assign-node ctx (field-node me cls (:i fl)) (field-node src cls (:i fl)))))))))))))
  fid)))

;; ---------------------------------------------------------------------------------------------
;; The program

(defn global-init
  "A namespace-scope variable's initializer."
  [vid]
  (let [v (var* vid)
        ctx {:scope (or (:def-scope v) (:scope v)) :statics (atom [])}
        init (:init v)]
    (binding [*cutoff* Long/MAX_VALUE]
      (let [i (cond
                (nil? init) (init-for (:ty v) nil ctx :value)
                :else (decl-init ctx vid (assoc (or (:node v) {}) :init (:init-style v) :inner [init] :kind "VarDecl")))]
        ;; a scalar initialized by a constant expression: constant initialization ([basic.start.static])
        (if (and (= :expr (:i i)) (abi/scalar? (abi/unq (:ty v))) (not (#{:int :float :null} (:op (:e i)))))
          (if-let [c (binding [*ce-fold* true] (ce-try (:e i)))] (assoc i :e c) i)
          i)))))

(def prelude-typeinfo
  ;; std::type_info as the Itanium ABI lays it out (§2.9.4: the vptr, then the name) and compares it (§2.9.4: equal
  ;; names' addresses, else equal strings unless the name starts with *, a type of internal linkage); declared for
  ;; typeid in place of <typeinfo>'s class, whose bodies the native parser skims (CODEGEN.md §4)
  "namespace std {
class type_info {
public:
  virtual ~type_info();
  const char* name() const noexcept { return __name[0] == '*' ? __name + 1 : __name; }
  bool before(const type_info& __arg) const noexcept { return __builtin_strcmp(name(), __arg.name()) < 0; }
  bool operator==(const type_info& __arg) const noexcept {
    return __name == __arg.__name || (__name[0] != '*' && __builtin_strcmp(__name, __arg.__name) == 0);
  }
protected:
  const char* __name;
};
}
")

(defn- strip-positions [x]
  (cond (map? x) (into {} (for [[k v] x :when (not= k :_b)] [k (strip-positions v)]))
        (vector? x) (mapv strip-positions x)
        :else x))

(defn- prelude-nodes []
  (let [f (java.io.File/createTempFile "cg-prelude" ".cpp")]
    (try
      (spit f prelude-typeinfo)
      (mapv strip-positions (:nodes ((requiring-resolve 'arbace.repr.cpp.native/parse-file) (.getPath f) (.getName f) "c++23" [])))
      (finally (.delete f)))))

(defn analyze-program
  "The program of the native parse's nodes (its global scope `proot`) of the source text `src`: {:fns {id fn} :vars
  {id var} :order [...] :classes {id class} :enums {...}}."
  [nodes proot ^String src]
  (let [root (new-scope :ns nil :path [])]
  (binding [*src* src *fns* (atom {}) *vars* (atom {}) *ids* (atom 0) *order* (atom [])
            abi/*classes* (atom {}) abi/*enums* (atom {}) *proot* proot *root* root *header-cache* (atom {}) *last-anon* (atom nil) *lambda-counts* (atom {})]
    (do
      ((or (:wrap @hooks) (fn [f] (f)))
       (fn []
         ;; (the headers parsed in full, G4: <typeinfo>'s own class)
         (when (and (re-find #"\btypeid\b|\btype_info\b" src) (not-any? header-node? nodes))
           (binding [*src* prelude-typeinfo]
             (doseq [n (prelude-nodes)] (declare-node! root n))))
         (binding [*retry* (atom [])]
           (let [retry! (fn [] (let [r @*retry*] (reset! *retry* []) (doseq [[sc n] r] (declare-node! sc n))))
                 [hs ms] (split-with header-node? nodes)]
             (doseq [n hs] (declare-node! root n))
             ;; rounds until one declares nothing more
             (loop [k 0]
               (let [before (count @*retry*)]
                 (retry!)
                 (when (and (< k 6) (pos? before) (< (count @*retry*) before)) (recur (inc k)))))
             (doseq [n ms] (declare-node! root n))))
         ;; the declarations in order, then (templates) the lazy definitions each round made used, until none
         (let [entry! (fn [[k id]]
                        (case k
                          :fn (let [f (fnd id)]
                                (when-not (or (:lazy f) (:analyzed f))
                                  (cond
                                    (and (:body f) (not (:tbody f))) (do (upd-fn! id assoc :analyzed true) (analyze-fn! id))
                                    ;; (a closure's implicit members are analyzed, or deleted, where the lambda is)
                                    (and (or (:implicit f) (:defaulted f)) (not (:params f)) (not (:deleted f)))
                                    (do (upd-fn! id assoc :analyzed true)
                                        ;; a defaulted member whose subobjects' members are not viable is deleted
                                        ;; ([class.copy.ctor]/10, [class.default.ctor]/2; G4: the headers' classes)
                                        (try (analyze-implicit! id)
                                             (catch arbace.lang.ExceptionInfo e
                                               (when (System/getenv "CPP_HDR_TRACE")
                                                 (binding [*out* *err*] (println "implicit member failed:" (:name (fnd id)) (:implicit (fnd id)) (:name (abi/cls (:cls (fnd id)))) (:header (abi/cls (:cls (fnd id)))) (.getMessage e))))
                                               (if (and (:implicit (fnd id))
                                                        (or (= :overload (:codegen/refused (ex-data e)))
                                                            (and (:codegen/refused (ex-data e)) (:header (abi/cls (:cls (fnd id)))))))
                                                 (upd-fn! id assoc :deleted true :tinits nil)
                                                 (throw e)))))
                                    :else nil)))
                          :var (let [v (var* id)] (when (and (:defined v) (not (:ginit v))) (upd-var! id assoc :ginit (global-init id))))))]
           (loop [i 0]
             (let [order @*order*]
               (if (< i (count order))
                 (do (entry! (nth order i)) (recur (inc i)))
                 (when-let [more (seq (when-let [h (:pending @hooks)] (h)))]
                   (doseq [x more] (entry! x))
                   (recur i))))))))
      {:fns @*fns* :vars @*vars* :order @*order* :classes @abi/*classes* :enums @abi/*enums* :root root}))))

        ;; (cpp-rind, the checker: [expr.type.conv]/1-2, T(e) of an array type T, no list, has no meaning (an array is no
        ;; class nor scalar, and initialized only by a list): GCC's "functional cast to array type 'A'";
        ;; diagnostic/functional-cast-to-array-type-1.C)
        (and (checking?) (= "CXXFunctionalCastExpr" (:kind n)) (abi/arr? (abi/unq t)) (not= "InitListExpr" (:kind k)))
        (fail :cast-array "functional cast to array type")
        ;; (T(pack...): a functional notation whose one argument is a pack expansion is T(e1, ..., en),
        ;; [expr.type.conv]/2, as many as the pack has; CP332 (a), make_tuple's __result_type(std::forward<_Elements>(__args)...))
        (and (= "CXXFunctionalCastExpr" (:kind n)) (= "PackExpansionExpr" (:kind k)))
        (let [args (analyze-args ctx [k])]
          (cond (abi/class? (abi/unq t)) {:op :temp-obj :init (init-for t args ctx (if (empty? args) :value :direct)) :ty (abi/unq t) :cat :pr}
                (empty? args) {:op :zero-val :ty t :cat :pr}
                (= 1 (count args)) (cast-expr ctx t (first args) true)
                :else (fail :expr "a functional cast of a scalar type with " (count args) " arguments: " (pr-str t) " from " (get-in n [:type :qualType]))))
        (and (= "CXXFunctionalCastExpr" (:kind n)) (abi/class? (abi/unq t)))
        {:op :temp-obj :init (init-for t (if (= "InitListExpr" (:kind k)) (analyze ctx k) [(analyze ctx k)]) ctx :direct) :ty (abi/unq t) :cat :pr}
        ;; (cpp-s8: T{} and T{e} of a scalar type, [expr.type.conv]/2 with [dcl.init.list]/3.9-3.11: value-initialized, or
        ;; the one element converted; <concepts>' default_initializable<char*>, `requires { _Tp{}; ... }`, had been false)
        (and (= "CXXFunctionalCastExpr" (:kind n)) (= "InitListExpr" (:kind k)) (not (abi/ref? t)))
        (scalar-list-cast ctx t (analyze-args ctx (kids k)))
        :else (let [a (analyze ctx k)
                    _ (cx-named-cast! (:kind n) t a)
                    ;; (cpp-sweep, the checker: a reinterpret_cast between pointer to member types, [expr.reinterpret.cast]/10,
                    ;; which the slice's conversions refuse: a cast of its own, no constant expression, cpp0x/pr85437-2.C)
                    r (if (and (checking?) (= "CXXReinterpretCastExpr" (:kind n)) (abi/mptr? (abi/unq t)) (some-> a :ty abi/unq abi/mptr?)
                               (= (boolean (abi/fn? (:to (abi/unq t)))) (boolean (abi/fn? (:to (abi/unq (:ty a)))))))
                        {:op :cast :ck :noop :e (rv a) :ty (abi/unq t) :cat :pr}
                        (cast-expr ctx t a true))]
                ;; (h-cpp-consteval, the checker: a reinterpret_cast's own conversion, marked for the constant evaluation)
                (cond
                  (and (checking?) (= "CXXReinterpretCastExpr" (:kind n)) (#{:cast :reinterpret-lv} (:op r))
                       (or (= :reinterpret-lv (:op r)) (abi/ptr? (abi/unq (:ty r))) (abi/mptr? (abi/unq (:ty r)))
                           (some-> r :e :ty abi/unq abi/ptr?)))
                  (assoc r :cx-reinterpret true)
                  ;; (a C-style cast that is a reinterpret_cast, [expr.cast]/4.4: a pointer to an unrelated object type, a
                  ;; reference to an unrelated type)
                  (and (checking?) (= "CStyleCastExpr" (:kind n)) (cx-reinterpret-cast? r))
                  (assoc r :cx-reinterpret true)
                  ;; (cpp-rind, the checker: [expr.const]/5.14 before C++26, a conversion from cv void* to a pointer-to-object
                  ;; type, marked for the constant evaluation: GCC's "cast from 'void*' is not allowed"; cpp0x/constexpr-cast4.C)
                  (and (checking?) (< (long *cxx-year*) 26) (#{"CXXStaticCastExpr" "CStyleCastExpr"} (:kind n)) (= :cast (:op r))
                       (abi/ptr? (abi/unq (:ty r))) (not (abi/void? (abi/unq (:to (abi/unq (:ty r))))))
                       (not (abi/fn? (abi/unq (:to (abi/unq (:ty r))))))
                       (some-> a :ty abi/unq abi/ptr?) (abi/void? (abi/unq (:to (abi/unq (:ty a))))))
                  (assoc r :cx-void-cast true)
                  :else r))))))
    ;; queue 439: GNU's compound literal `(T){...}` in C++ (g++.dg's ext/attribute-test-1.C, a vector's), for the code
    ;; generator: a prvalue temporary list-initialized as T{...} is (clang's CompoundLiteralExpr of a C++ class, vector or
    ;; scalar type, materialized where it is used); an array's (an lvalue in GNU C++) is refused. The checker refuses it still.
    "CompoundLiteralExpr"
    (let [t (when-not (checking?) (some->> (get-in n [:type :qualType]) (resolve-type (:scope ctx))))
          tu (some-> t abi/unq)
          [k] (kids n)]
      (cond
        (or (nil? tu) (abi/ref? tu) (abi/arr? tu) (not= "InitListExpr" (:kind k)))
        (fail :expr "expression " (:kind n))
        (abi/class? tu) {:op :temp-obj :init (init-for tu (analyze ctx k) ctx :direct) :ty tu :cat :pr}
        (#{:vec :complex} (:k tu)) {:op :temp-obj :init (init-for tu (analyze ctx k) ctx :list) :ty tu :cat :pr}
        :else (scalar-list-cast ctx tu (analyze-args ctx (kids k)))))
    ("CXXTemporaryObjectExpr" "CXXUnresolvedConstructExpr" "CXXConstructExpr")
    (if-let [ct (when-not (= "CXXConstructExpr" (:kind n)) (ctad-template (:scope ctx) (get-in n [:type :qualType])))]
      (ctad-expr ctx n ct)
    (let [t (resolve-type (:scope ctx) (get-in n [:type :qualType]))
          ;; (CX12, fifth slice: T(...) naming a member type, its access as a declaration's, check-type-access!)
          _ (when (checking?)
              (let [f (when-let [i (:fn-id ctx)] (fnd i))]
                (when (and f (not (:cls f)) (not (:this-type ctx))) (check-type-access! (:scope ctx) (get-in n [:type :qualType]) n))))
          ks (kids n)
          ;; (queue 423: T{...} of a dependent type, the native parser's CXXUnresolvedConstructExpr whose one operand is the
          ;; braced list itself, ending where it ends (T({...}) ends at its parenthesis): list-initialization of T,
          ;; [expr.type.conv]/2, as the functional cast's T{...} below, not a constructor called with one braced argument,
          ;; which ranked the copy and move constructors equal for `t = T{}` of an aggregate, "ambiguous call (2 viable)")
          brace? (and (= "CXXUnresolvedConstructExpr" (:kind n)) (= 1 (count ks)) (= "InitListExpr" (:kind (first ks)))
                      (some? (:offset (loc-of (get-in n [:range :end]))))
                      (= (:offset (loc-of (get-in n [:range :end]))) (:offset (loc-of (get-in (first ks) [:range :end])))))
          args (analyze-args ctx ks)]
      (if (abi/class? (abi/unq t))
        {:op :temp-obj :init (if brace? (init-for t (first args) ctx :direct) (init-for t args ctx (if (empty? args) :value :direct))) :ty (abi/unq t) :cat :pr}
        (cond (empty? args) {:op :zero-val :ty t :cat :pr}
              ;; (cpp-s8: T{...} of a scalar type in a template, its one argument the braced list)
              (and (= 1 (count args)) (= :init-list (:op (first args))) (not (abi/ref? t))) (scalar-list-cast ctx t (:items (first args)))
              :else (cast-expr ctx t (first args) true)))))
    "CXXScalarValueInitExpr" (let [qt (get-in n [:type :qualType])
                                   t (resolve-type (:scope ctx) qt)]
                               ;; (CX12, fifth slice: T() naming a member type, its access as a declaration's, check-type-access!)
                               (when (checking?)
                                 (let [f (when-let [i (:fn-id ctx)] (fnd i))]
                                   (when (and f (not (:cls f)) (not (:this-type ctx))) (check-type-access! (:scope ctx) qt n))))
                               {:op :zero-val :ty t :cat :pr})
    "InitListExpr" (cond-> {:op :init-list :items (cond->> (if (checking?) (cx-list-items ctx (kids n)) (analyze-args ctx (kids n))) (checking?) (embed-positions n)) :ty {:k :init-list}}
                     ;; (cpp-decl2: a designated list the parser left as written, an overloaded callee's argument: its
                     ;; designators, for [over.ics.list]/2 and the order check of the parameter's initialization, desig-*)
                     (and (:_desigs n) (some some? (:_desigs n))) (assoc :desigs (:_desigs n) :desig-node n)
                     ;; (cpp-decl2: the elements' nodes, an array element's error at its element)
                     (checking?) (assoc :item-nodes (vec (kids n)))
                     ;; (cpp-singles: the list's closing brace, the place of GCC's errors at its end, cx-empty-agg-elide!)
                     (and (checking?) (get-in n [:range :end :offset])) (assoc :list-end (get-in n [:range :end]))
                     ;; (cpp-ce2: a union's member the list initializes, the semantic form's `field`: its designator's)
                     (get-in n [:field :name]) (assoc :field (get-in n [:field :name])))

                              (float? old) (ce-wrap (:ty x) ((if (= "++" (:o e)) + -) old 1))
                              (or (wide? (:ty x)) (wide-value? old)) (ce-wrap (:ty x) ((if (= "++" (:o e)) + -) (bigint old) 1))
                              :else (let [o (long old) r (if (= "++" (:o e)) (unchecked-inc o) (unchecked-dec o))
                                          ux (abi/underlying (abi/unq (:ty x)))]
                                      ;; (an int's or wider's, the promoted type's own; a narrower one's is converted back, [conv.integral]/3)
                                      (when (and (abi/integral? ux) (abi/signed? ux) (not= :bool (abi/bn ux)) (>= (long (abi/size-of ux)) 4))
                                        (let [bits (* 8 (long (abi/size-of ux)))
                                              lim (cond (= bits 64) (if (= "++" (:o e)) Long/MAX_VALUE Long/MIN_VALUE)
                                                        (= "++" (:o e)) (dec (bit-shift-left 1 (dec bits)))
                                                        :else (- (bit-shift-left 1 (dec bits))))]
                                          (when (= o lim)
                                            (if (checking?) (ub! e "value " (if (= "++" (:o e)) (inc (bigint o)) (dec (bigint o)))
                                                                 " is outside the range of representable values")
                                                (not-constant "a signed overflow")))))
                                      (ce-wrap (:ty x) r)))]
                 (ce-put! l nv) (if (:post e) old nv))
       :call (if (and (checking?) (= :dtor (:kind (fnd (:fn e)))) (:obj e) (not (:virtual e)))
               (ce-explicit-dtor! e env)
               (let [f (fnd (:fn e))]
               ;; ([expr.const]/5.2: a call of a function that is not constexpr: a namespace-scope function the main file
               ;; declares, not inline -- gcc's -fimplicit-constexpr makes those constexpr -- nor a template's specialization)
               ;; (h-cpp-consteval, the checker: anywhere in the evaluation, at the call, and of a member function of the main
               ;; file's classes, inline or not: GCC without -fimplicit-constexpr, [dcl.constexpr]/1)
               (when (ce-not-constexpr? f)
                 (if *ce-in-call*
                   (ub! e "call to non-'constexpr' function '" (:name f) "'")
                   (ce-top-sure! "call to non-constexpr function '" (:name f) "'")))
               ;; (cpp-sweep, the checker: C++11's [dcl.constexpr]/8 under -pedantic-errors, a constexpr non-static member function
               ;; of a class surely not literal is no constexpr function: GCC's "call to non-'constexpr' function" at the call, and
               ;; for a class template's specialization (a plain class's member is reported at its class, declare-class!) its
               ;; explanation "enclosing class of 'constexpr' non-static member function ... is not a literal type" at the member:
               ;; cpp0x/constexpr-diag1.C's A<B>().f())

      ;; __builtin_constant_p: 0 at run time, as clang folds it at -O0 when e is not a constant)
      (if (vector? b)
        (let [[which tn] b
              x (rv (analyze ctx (second (kids n))))
              t (if tn (abi/b tn) (abi/unq (:ty x)))
              ;; (cpp-s13: the generic ones of a 128-bit operand too, clang's llvm.ctlz.i128 and the rest, which the lowering
              ;; splits in halves: <bit>'s __countl_zero<unsigned __int128> under <format>)
              _ (when-not (and (abi/integral? t) (or (#{1 2 4 8} (abi/size-of t)) (and (= 16 (abi/size-of t)) (not= :bswap which))))
                  (fail :type (name which) " of " (pr-str t)))
              fb (when-let [f (nth (kids n) 2 nil)] (convert-scalar (rv (analyze ctx f)) abi/int* false))]
          {:op :bitop :which which :e (convert-scalar x t false) :fb fb :ty (if (= :bswap which) t abi/int*) :cat :pr})
      (case b
        :expect (convert-scalar (rv (analyze ctx (second (kids n)))) abi/long* false)
        :fconst (let [nm (get-in (first (kids n)) [:referencedDecl :name]) [stem t] (fp-builtin nm)]
                  (if (= stem "nan")
                    (let [a (loop [a (second (kids n))] (if (#{"ImplicitCastExpr" "ParenExpr"} (:kind a)) (recur (first (kids a))) a))
                          s (when (= "StringLiteral" (:kind a)) (:s (analyze ctx a)))]
                      (when-not (= "" s) (fail :expr nm " of a payload"))
                      {:op :float :v Double/NaN :ty t :cat :pr})
                    {:op :float :v Double/POSITIVE_INFINITY :ty t :cat :pr}))
        :fmath (let [nm (get-in (first (kids n)) [:referencedDecl :name]) [stem t] (fp-builtin nm)]
                 {:op :fmath :fn stem :e (convert-scalar (rv (analyze ctx (second (kids n)))) t false) :ty t :cat :pr})
        ;; (cpp-singles, the checker: __builtin_conj of a complex operand of its type, the value's type alone needed --
        ;; other/error26.C's `__builtin_conj(x)()`, a call of no function --; else the unknown name as before)
        :conj (let [nm (get-in (first (kids n)) [:referencedDecl :name])
                    t (cond (str/ends-with? nm "conjf") abi/float* (str/ends-with? nm "conjl") (abi/b :ldouble) :else abi/double*)
                    x (when (and (checking?) (= 2 (count (kids n)))) (rv (analyze ctx (second (kids n)))))]
                (if (and x (= {:k :complex :of t} (abi/unq (:ty x))))

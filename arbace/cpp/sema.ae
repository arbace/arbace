      ;; (cpp-diag-b, 2026-11-22: [basic.fundamental]/? (C++23 /15): an expression of type void is no operand of an assignment
      ;; or of an arithmetic, relational or bitwise operator (the comma's aside): GCC's "void value not ignored as it ought to be")
      (when (and (checking?) (not= o ",") (not (class-operand? l)) (or (abi/void? (abi/unq (:ty r))) (and (not= o "=") (abi/void? (abi/unq (:ty l))))))
        (fail :void-value "void value not ignored as it ought to be"))
      (cond
        (= o "=") (assign-node ctx l r)
        (#{".*" "->*"} o) (or (when (and (checking?) (= o "->*") (or (class-operand? l) (class-operand? r)))
                                (or (operator-call ctx o [l r]) (no-operator! ctx o [l r])))
                              (builtin-binop o l r))
        :else
        (or (when (and (or (class-operand? l) (class-operand? r)) (not= o ",")) (operator-call ctx o [l r]))
            (when (and (or (class-operand? l) (class-operand? r)) (not= o ",")) (no-operator! ctx o [l r]))
            (builtin-binop o (class->scalar ctx l) (class->scalar ctx r)))))
    "CompoundAssignOperator"
    (let [o (:opcode n) [ln rn] (kids n) l (analyze ctx ln) r (analyze ctx rn)]
      (when (and (checking?) (not (class-operand? l)) (abi/void? (abi/unq (:ty r))))
        (fail :void-value "void value not ignored as it ought to be"))
      (or (when (= :complex (:k (abi/unq (:ty l))))
            ;; a complex glvalue op= a real value (cpp-s3: std::complex<long double>'s operator*=(long double)): + and - on the
            ;; real part, * and / on both, as clang's ComplexExprEmitter does with a real right operand
            (let [et (:of (abi/unq (:ty l))) r (rv r)]
              (when-not (and (lv? l) (abi/arith? (abi/unq (:ty r))) (#{"+=" "-=" "*=" "/="} o))
                (fail :complex "a complex compound assignment " o))
              {:op :ccompound :o (subs o 0 1) :l l :r (convert-scalar r et false) :ty (:ty l) :cat :lv}))
          (when (or (class-operand? l) (class-operand? r)) (operator-call ctx o [l r]))
          (when (or (class-operand? l) (class-operand? r)) (no-operator! ctx o [l r]))
          (compound-node (subs o 0 (dec (count o))) l (class->scalar ctx r) ctx)))
    "ConditionalOperator"
    ;; (cpp-rt-own: an operand naming one function, an overload set of one, is its address, [expr.cond]/7 after the
    ;; function-to-pointer conversion: libcpp's macro.cc `(kind == CPP_time_kind::FIXED ? gmtime : localtime) (&tt)`, "call
    ;; of a non-function" before)
    (let [[c a b] (kids n)
          fa (fn [x] (if (and (= :fnset (:op x)) (= 1 (count (:fns x))) (empty? (:tmpls x)) (not (:obj x))) (rv x) x))]
      ;; (cpp-ce3: an immediate invocation in a branch is not evaluated where the branch is analyzed, cx-immediate-eval!)
      (cond-node ctx (fold-mark (to-bool (analyze ctx c))) (binding [*cx-no-imm* (not *cx-arms-evaluated*)] (fa (analyze ctx a))) (binding [*cx-no-imm* (not *cx-arms-evaluated*)] (fa (analyze ctx b)))))
    ;; GNU's `x ?: y` ([GCC manual, Conditionals with Omitted Operands]; clang's BinaryConditionalOperator): x evaluated once,
    ;; bound as an opaque value (a glvalue's address, a class prvalue materialized, else its value), the condition and the
    ;; true operand both that value (clang's OpaqueValueExpr, CodeGenFunction::OpaqueValueMapping)
    "BinaryConditionalOperator"
    (let [[x y] (kids n)
          x (analyze ctx x)
          x (if (and (= :pr (:cat x)) (abi/class? (abi/unq (:ty x)))) (materialize x) x)
          k (swap! opaque-ids inc)
          ov {:op :opaque :id k :ty (:ty x) :cat (:cat x)}
          r (cond-node ctx (to-bool ov) ov (binding [*cx-no-imm* (not *cx-arms-evaluated*)] (analyze ctx y)))]
      {:op :bind-opaque :id k :e x :body r :ty (:ty r) :cat (:cat r)})
    "CallExpr"
    (if-let [op (when (= "DeclRefExpr" (:kind (first (kids n))))
                  ({"__builtin_operator_new" "operator new" "__builtin_operator_delete" "operator delete"}
                   (get-in (first (kids n)) [:referencedDecl :name])))]
      ;; __builtin_operator_new/delete: the global operator new or delete called as by a new- or delete-expression
      ;; (clang's EmitBuiltinNewDeleteCall; G4: std::allocator's allocate and deallocate)
      (analyze ctx (assoc n :inner (vec (cons (assoc (first (kids n)) :referencedDecl {:name op} :_wn true :globalQualifier true) (rest (kids n))))))
    (if (and (= "DeclRefExpr" (:kind (first (kids n)))) (atomic-builtin? (str (get-in (first (kids n)) [:referencedDecl :name]))))
      ;; an __atomic builtin a template's pattern wrote as a call (the parser keeps AtomicExpr outside templates)
      (atomic-expr ctx (get-in (first (kids n)) [:referencedDecl :name]) (rest (kids n)))
    (if-let [b (when (= "DeclRefExpr" (:kind (first (kids n))))
                 (let [b (value-builtins (get-in (first (kids n)) [:referencedDecl :name]))]
                   ;; (cpp-rt-own4: __builtin_fpclassify the code generator's alone, the checker's records made without it)
                   (when-not (and (= :fpclassify b) (checking?)) b)))]

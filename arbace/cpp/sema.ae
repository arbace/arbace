        ;; CGBuiltin tests it: zero when x == 0, nan when x is unordered, inf when |x| is infinite (x - x a NaN), normal when |x| is
        ;; at least the type's smallest normal (<cfloat>'s FLT_MIN, DBL_MIN, LDBL_MIN), else subnormal; an int)
        :fpclassify
        (let [[an ai anorm asub az xn] (rest (kids n))
              _ (when-not xn (fail :call "__builtin_fpclassify of " (count (rest (kids n))) " arguments"))
              t (abi/unq (:ty (rv (analyze ctx xn))))
              [qt mn] (case (abi/bn t)
                        :float ["float" "1.17549435082228750796873653722224568e-38"]
                        :double ["double" "2.22507385850720138309023271733240406e-308"]
                        :ldouble ["long double" "3.36210314311209350626267781732175260e-4932"]
                        (fail :type "__builtin_fpclassify of " (pr-str t)))
              lit (fn [v] {:kind "FloatingLiteral" :value v :type {:qualType qt} :valueCategory "prvalue" :range (:range n)})
              bin (fn [o a c] {:kind "BinaryOperator" :opcode o :inner [a c] :range (:range n)})
              cnd (fn [c a e] {:kind "ConditionalOperator" :inner [c a e] :range (:range n)})
              d (bin "-" xn xn)
              node (cnd (bin "==" xn (lit "0.0")) az
                        (cnd (bin "!=" xn xn) an
                             (cnd (bin "!=" d d) ai
                                  (cnd (bin "||" (bin ">=" xn (lit mn)) (bin "<=" xn {:kind "UnaryOperator" :opcode "-" :inner [(lit mn)] :range (:range n)}))
                                       anorm asub))))]
          (convert-scalar (rv (analyze ctx node)) abi/int* false))
        ;; __builtin_addressof(x): x's address, no operator& ([specialized.addressof])
        :addressof (let [e (analyze ctx (second (kids n)))] {:op :addr :e e :ty (abi/ptr (:ty e)) :cat :pr})
        ;; __builtin_alloca(n): n bytes of the frame (clang's alloca i8, i64 n, align 16)
        ;; va_start, va_end, va_copy: LLVM's intrinsics on the va_list's address (x86-64: __va_list_tag[1], decayed)
        (:va-start :va-end :va-copy)
        (let [as (mapv #(rv (analyze ctx %)) (rest (kids n)))]
          {:op :va :which b :args (if (= b :va-copy) (subvec as 0 2) (subvec as 0 1)) :ty abi/void :cat :pr})
        ;; (CP338 (a): __builtin_clear_padding(p): the padding bits of *p zeroed, clang's EmitBuiltinClearPadding; a
        ;; pointer to a complete object type)
        :clear-padding (let [p (rv (analyze ctx (second (kids n))))
                             t (abi/unq (:ty p))]
                         (when-not (and (abi/ptr? t) (not (abi/void? (:to t))) (not (abi/fn? (:to t))))
                           (fail :expr "__builtin_clear_padding of " (pr-str (:ty p))))
                         {:op :clear-padding :p p :to (abi/unq (:to t)) :ty abi/void :cat :pr})
        ;; (CP338 (a): __atomic_always_lock_free(n, p) and __atomic_is_lock_free(n, p) with a constant size and a null pointer
        ;; (an object of n bytes aligned to n), folded as clang's x86-64 target does: lock-free for 1, 2, 4 and 8 bytes;
        ;; <bits/shared_ptr_base.h>'s _Sp_counted_base<_S_atomic>::_M_release)
        ;; (queue 411: and with an object's address, as clang's ExprConstant (VisitBuiltinCallExpr, BI__atomic_always_lock_free):
        ;; a size of 1, 2, 4 or 8 is lock-free when the pointer is null, the size 1, or the pointee's alignment (the operand
        ;; before its implicit conversions) at least the size; else __atomic_always_lock_free is false and __atomic_is_lock_free
        ;; is left to the library; locale.cc's `__atomic_always_lock_free(sizeof(_M_index), &_M_index)`)
        :lock-free (let [[szn pn] (rest (kids n))
                         strip (fn [k] (loop [k k] (if (and (map? k) (= "ImplicitCastExpr" (:kind k)) (seq (kids k))) (recur (first (kids k))) k)))
                         sz (rv (analyze ctx szn)) pp (when pn (rv (analyze ctx pn)))
                         nv (:v (ce-try sz)) pv (when pp (ce-try pp))
                         always (= "__atomic_always_lock_free" (get-in (first (kids n)) [:referencedDecl :name]))
                         null (and pp (some? pv) (zero? (long (or (:v pv) 0))))
                         pt (when (and pn (not null)) (let [t (abi/unq (:ty (rv (analyze ctx (strip pn)))))] (when (abi/ptr? t) (abi/unq (:to t)))))
                         aligned (when (and (number? nv) pt (not (abi/void? pt)) (not (abi/fn? pt)))
                                   (try (>= (abi/align-of pt) (long nv)) (catch Exception _ nil)))]
                     (when-not (and (number? nv) pp (or null (= 1 (long nv)) aligned (and always (some? aligned))))
                       (fail :expr "a lock-free query not folded"))
                     {:op :int :v (if (and (#{1 2 4 8} (long nv)) (or null (= 1 (long nv)) aligned)) 1 0) :ty abi/bool* :cat :pr})
        ;; (n-cpp-eval: GCC's __builtin_shuffle(a, mask) and (a, b, mask), GCC's manual "Using Vector Instructions through
        ;; Built-in Functions": lane i of the result is lane mask[i] of a, or of a and b taken as one vector of 2N lanes, the
        ;; mask's lanes taken modulo N, or 2N; the mask an integer vector of as many lanes of the same width; clang has no such
        ;; builtin, its __builtin_shufflevector takes constant indices)
        :shuffle (let [as (mapv #(rv (analyze ctx %)) (rest (kids n)))
                       _ (when-not (#{2 3} (count as)) (fail :expr "__builtin_shuffle with " (count as) " arguments"))
                       [a b m] (if (= 2 (count as)) [(first as) nil (second as)] as)
                       vt (abi/unq (:ty a)) mt (abi/unq (:ty m))]
                   (when-not (and (= :vec (:k vt)) (= :vec (:k mt)) (abi/integral? (:of mt)) (= (:n vt) (:n mt))
                                  (= (abi/size-of (:of vt)) (abi/size-of (:of mt))) (or (nil? b) (= vt (abi/unq (:ty b)))))
                     (fail :expr "__builtin_shuffle of " (pr-str (mapv :ty as))))
                   {:op :vshuffle :a a :b b :m m :ty vt :cat :pr})
        :alloca {:op :alloca :e (convert-scalar (rv (analyze ctx (second (kids n)))) abi/ulong* false) :ty (abi/ptr abi/void) :cat :pr}
        ;; (queue 393, W4: the coroutine builtins, a frame's address their first operand; __builtin_coro_promise(p, align, from)
        ;; with a constant alignment, from-promise true the frame from the promise's address)
        (:coro-done :coro-resume :coro-destroy :coro-promise)
        (let [[p a fr] (map #(rv (analyze ctx %)) (rest (kids n)))
              p (convert-scalar p (abi/ptr abi/void) true)
              al (when a (let [v (:v (ce-try a))] (if (number? v) (long v) (fail :expr "__builtin_coro_promise of an alignment not constant"))))
              from (when fr (let [v (:v (ce-try fr))] (cond (number? v) (not (zero? (long v))) (boolean? v) v :else (fail :expr "__builtin_coro_promise's direction not constant"))))]
          {:op :coro-builtin :which b :p p :align al :from from :cat :pr
           :ty (case b :coro-done abi/bool* :coro-promise (abi/ptr abi/void) abi/void)})
        :coro-noop (fail :coroutine "__builtin_coro_noop (std::noop_coroutine)")
        ;; __builtin_{add,sub,mul}_overflow(a, b, &r): r = a op b in r's type; the overflow flag false (a divergence
        ;; when it overflows: no wider arithmetic yet; G4: <bits/stl_vector.h>'s size computations)
        (:add-overflow :sub-overflow :mul-overflow)
        (let [[x y r] (mapv #(analyze ctx %) (rest (kids n)))
              dst (deref-node (rv r))
              o ({:add-overflow "+" :sub-overflow "-" :mul-overflow "*"} b)]
          {:op :comma :l (assign-node ctx dst (convert-scalar (arith-binop o x y) (abi/unq (:ty dst)) false)) :r {:op :int :v 0 :ty abi/bool* :cat :pr}
           :ty abi/bool* :cat :pr})))

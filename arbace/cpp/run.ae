(ns arbace.cpp.run
  "cppi's programs on ci (doc/cpp/CPP-SURVEY.md, \"As built: CX8 (write-ahead)\"; doc/cpp/LLVM.md §11): a C++ program's
  lowered C (arbace.cpp.lower's, printed by repr/c) read by repr/c and checked by ci's checker as any C program is
  (arbace.c.run/read-unit), then linked as a static link pulls archive members (arbace.c.musl's rule: a unit when it defines a
  symbol the program still needs, a strong definition before a weak one) from the libraries in order: the program's own
  (the testsuite's util/ lowered), the lowered runtime (bin/cppi runtime-build's units: libsupc++, libstdc++-v3/src,
  libstdc++exp, and the pending-flag layer arbace/cpp/rt/eh.c.ae) and musl's forms (arbace.c.musl), and built into a node
  program (arbace.c.build) that ci's back end runs (tools/cirun on the light path); for AOT the node program translated by
  cf2g (arbace.c.cf2g/translate) into a Go package.

  A library here is a directory of read units (read-lib): DIR/forms/NAME.ae (repr/c's .ae of the unit, its header units
  under DIR/forms/c/h/), DIR/index.edn {NAME {:defs {name {:weak :alias}} :refs #{names}}}, DIR/read.tsv each unit's read
  (ok, or the error). Evaluated from the checkout on the tools' host (arbace.c.* is stage 0's, at the checkout's sources)."
  (:require [arbace.repr.c :as rc]
            [arbace.repr.c.host :as host]
            [arbace.c.build :as build]
            [arbace.c.musl :as musl]
            [arbace.c.run :as crun]
            [arbace.cpp.lower :as lower]
            [arbace.repr.llvm :as llvm]
            [arbace.string :as str])
  (:import (java.io File)
           (java.util ArrayDeque HashMap HashSet)
           (java.util.concurrent ConcurrentHashMap ConcurrentLinkedQueue)))

(set! *warn-on-reflection* true)

;; runtime-ci-key begin: what bin/cppi runtime-ci keys the library on (the read and its options), to the end marker
(def ci-atomics
  "gcc's __atomic builtins, which the lowering writes for the IR's atomics (CP121 (c), LLVM.md §7) and ci's back end does not
  have (C's class missing-builtin), as macros of plain operations for ci's one thread (CP1: ci runs no threads, doc/c/SPEC.md
  §6.5): each evaluates its operands once, the memory orders not at all. gcc's judge of the lowered C (lower-check) keeps the
  builtins; only ci's read defines these (LLVM.md §11). Not the generic __atomic_load, __atomic_store and __atomic_exchange, which
  repr/c's <builtin> source declares without parameters (stdatomic.h's), so a macro of three would break the declaration: since
  cppi-deferred the lowering writes them only for an x86_fp80 (a float's or double's atomics are the _n ones on its bits)."
  (let [rmw (fn [nm op new?]
              [(str "__atomic_" nm "(p,v,o)")
               (str "({ __typeof__(p) cx$ap = (p); __typeof__(*cx$ap) cx$ao = *cx$ap; __typeof__(*cx$ap) cx$an = " op "; *cx$ap = cx$an; "
                    (if new? "cx$an" "cx$ao") "; })")])]
    (into [["__atomic_load_n(p,o)" "(*(p))"]
           ["__atomic_store_n(p,v,o)" "((void)(*(p) = (v)))"]
           ["__atomic_exchange_n(p,v,o)" "({ __typeof__(p) cx$ap = (p); __typeof__(*cx$ap) cx$ao = *cx$ap; *cx$ap = (v); cx$ao; })"]
           ["__atomic_compare_exchange_n(p,e,d,w,s,f)"
            "({ __typeof__(p) cx$ap = (p); __typeof__(e) cx$ae = (e); _Bool cx$ok = *cx$ap == *cx$ae; if (cx$ok) *cx$ap = (d); else *cx$ae = *cx$ap; cx$ok; })"]
           ["__atomic_compare_exchange(p,e,d,w,s,f)"
            "({ _Bool cx$ok = __builtin_memcmp((p), (e), sizeof(*(p))) == 0; if (cx$ok) __builtin_memcpy((p), (d), sizeof(*(p))); else __builtin_memcpy((e), (p), sizeof(*(p))); cx$ok; })"]
           ["__atomic_thread_fence(o)" "((void)0)"]
           ["__atomic_signal_fence(o)" "((void)0)"]
           ["__atomic_is_lock_free(n,p)" "1"]
           ["__atomic_always_lock_free(n,p)" "1"]
           ["__atomic_test_and_set(p,o)" "({ unsigned char *cx$ab = (unsigned char *)(p); _Bool cx$ok = *cx$ab; *cx$ab = 1; cx$ok; })"]
           ["__atomic_clear(p,o)" "((void)(*(unsigned char *)(p) = 0))"]]
          (for [[nm op] [["add" "cx$ao + (v)"] ["sub" "cx$ao - (v)"] ["and" "cx$ao & (v)"] ["or" "cx$ao | (v)"] ["xor" "cx$ao ^ (v)"]
                         ["nand" "~(cx$ao & (v))"]]
                [k new?] [[(str "fetch_" nm) false] [(str nm "_fetch") true]]]
            (rmw k op new?)))))

(def opts
  "The lowered C's options: the lowering prints C at gnu23 (LLVM.md §7); ci-atomics' macros and ci's x86-64 va_list fields
  (arbace.cpp.lower/va-field-macros, cppi-deferred). (CX8's ci-math macros went with
  queue 178: ci's checker declares the math builtins it lacked, check.ae's math-builtin-fns.)"
  (into ["-std=gnu23"] (for [[n d] (concat ci-atomics (:ci lower/va-field-macros))] (str "-D" n "=" d))))

(defn- spit-mk [^String path ^String s]
  (.mkdirs (.getParentFile (File. path)))
  (spit path s))

(defn- clean [s] (str/replace (str s) #"[\t\n\r]" " "))

(defn- tsv [^String f]
  (let [x (File. f)]
    (if (.exists x) (mapv #(str/split % #"\t" -1) (remove str/blank? (str/split-lines (slurp x)))) [])))

;; ---------------------------------------------------------------------------------------------
;; Libraries of read units

(defn read-one
  "The lowered C file `path` read by repr/c into DIR/forms/NAME.ae: nil, or the error's text."
  [h ^String dir ^String nm ^String path]
  (let [f (File. path)
        fc (host/file-config opts "gnu23")
        rd (rc/read-c (host/config h fc (.getParent f)) fc (.getName f) false)]
    (cond
      (:error rd) (str "read-error: " (str/join "; " (take 2 (:error rd))))
      (:refused rd) (str "read-refused: " (name (:refused rd)) ": " (:message rd))
      :else (do (doseq [[p t] (rc/unit-texts rd (.getName f))]
                  (let [out (if (str/starts-with? p "c/h/") (str dir "/forms/" p) (str dir "/forms/" nm ".ae"))]
                    (when-not (and (str/starts-with? p "c/h/") (.exists (File. out)))
                      (spit-mk out t))))
                (spit-mk (str dir "/forms/" nm ".units") (pr-str (vec (map str (keys (:units rd))))))
                nil))))

(defn load-unit
  "A library unit's read: {:forms :units} as arbace.repr.c/read-c gives."
  [^String dir ^String nm]
  (let [[_ forms] (rc/read-unit-text (slurp (str dir "/forms/" nm ".ae")))
        us (read-string (slurp (str dir "/forms/" nm ".units")))]
    {:forms forms
     :units (into {} (for [u us]
                       (let [[hf hforms] (rc/read-unit-text (slurp (str dir "/forms/c/h/" (subs u 4) ".ae")))]
                         [(symbol u) {:forms hforms :header (second hf)}])))}))

(defn read-lib
  "read-lib DIR LIST THREADS: each line of LIST (NAME PATH: a unit's lowered C) read into DIR (the units already read kept
  when DIR/read.tsv says so), DIR/index.edn written; the errors printed. Exit 0 when every unit read."
  [h ^String dir ^String list threads]
  (let [lines (mapv #(str/split % #"\t") (remove str/blank? (str/split-lines (slurp list))))
        done (into {} (map (juxt first identity) (tsv (str dir "/read.tsv"))))
        todo (vec (remove (fn [[n]] (= "ok" (second (get done n)))) lines))
        q (ConcurrentLinkedQueue. ^java.util.Collection todo)
        res (ConcurrentHashMap.)
        k (atom 0)
        workers (doall (for [_ (range threads)]
                         (future
                           (loop []
                             (when-let [[n p] (.poll q)]
                               (let [t0 (System/nanoTime)
                                     e (try (read-one h dir n p) (catch Throwable e (str "error: " e)))]
                                 (.put res n (str/join "\t" [n (if e "error" "ok") (clean (or e "")) (format "%.1f" (/ (- (System/nanoTime) t0) 1e9))]))
                                 (let [i (swap! k inc)] (when (zero? (mod i 20)) (binding [*out* *err*] (println "cppi: read" i "of" (count todo)))))
                                 (recur)))))))]
    (doseq [w workers] @w)
    (let [rows (sort-by first (concat (for [[n r] done :when (not (.containsKey res n))] (str/join "\t" r)) (vals res)))
          rows (map #(if (string? %) % (str/join "\t" %)) rows)]
      (spit (str dir "/read.tsv") (str (str/join "\n" rows) "\n")))
    (let [ok (for [[n st] (tsv (str dir "/read.tsv")) :when (= st "ok")] n)
          ix (into (sorted-map)
                   (for [n ok]
                     (let [u (load-unit dir n)
                           all (concat (:forms u) (mapcat :forms (vals (:units u))))]
                       [n {:defs (musl/unit-defs (:forms u)) :refs (set (musl/refs all))}])))]
      (spit (str dir "/index.edn") (pr-str ix))
      (let [bad (for [[n st e] (tsv (str dir "/read.tsv")) :when (not= st "ok")] [n e])]
        (doseq [[n e] bad] (println "cppi: not read:" n e))
        (println "cppi: read" (count ok) "units of" (count lines) "into" dir)
        (empty? bad)))))

;; runtime-ci-key end

(defn library
  "A library of read units: {:dir :index :by-name {name [[unit weak] ...]} :checked (atom {unit checked})}."
  [^String dir]
  (let [ix (read-string (slurp (str dir "/index.edn")))
        by (HashMap.)]
    (doseq [[s {:keys [defs]}] ix
            [n d] defs]
      (.put by n (conj (or (.get by n) []) [s (:weak d)])))
    {:dir dir :index ix :by-name by :checked (ConcurrentHashMap.)}))

;; The constructors (LLVM.md §11): ci's builder does not run __attribute__((constructor)) functions, and the lowering makes
;; llvm.global_ctors such wrappers (cx$ctor$N, static, LLVM.md §8). Before a unit is checked, each is renamed to a name of the
;; program's own (cx$init$TAG$N) and made external; build-linked adds a unit defining musl's _init (which __libc_start_main
;; calls before main: its own is a weak dummy), calling them as the linker's .init_array orders them: by priority, then the
;; unprioritized ones, each group in link order.

(defn- ctor-attr
  "A c/defn name's constructor attribute: nil, or its priority (65536 when it has none, after every priority)."
  [m]
  (some (fn [a] (when (and (seq? a) (= '__attribute__ (first a)))
                  (some (fn [x] (cond (= 'constructor x) 65536
                                      (and (vector? x) (= 'constructor (first x))) (long (second x))))
                        (rest a))))
        (:c/decl-attrs m)))

(defn ctors
  "A read's top-level forms with its constructors renamed (TAG distinguishes the units): [forms [[priority name] ...]]."
  [forms ^String tag]
  (let [acc (java.util.ArrayList.)
        tag (str/replace tag #"[^A-Za-z0-9_]" "_")
        fs (mapv (fn [f]
                   (if (and (seq? f) (= 'c/defn (first f)))
                     (let [nm (second f) m (meta nm)]
                       (if-let [pr (ctor-attr m)]
                         (let [n2 (symbol (str "cx$init$" tag "$" (name nm)))]
                           (.add acc [pr (name n2)])
                           (apply list (first f) (with-meta n2 (-> m (dissoc :static) (update :c/decl-attrs #(vec (remove (fn [a] (and (seq? a) (some #{'constructor} (map (fn [x] (if (vector? x) (first x) x)) (rest a))))) %)))))
                                  (drop 2 f)))
                         f))
                     f))
                 forms)]
    [fs (vec acc)]))

(defn- with-ctors
  "A read with its constructors renamed (ctors), the list kept as :ctors."
  [rd tag]
  (let [[fs cs] (ctors (:forms rd) tag)] (assoc rd :forms fs :ctors cs)))

(declare check-lib-unit)

(defn- checked-lib-unit
  "A library unit read from its directory and checked as a program's unit is (kept in the library; a unit is checked once, the
  other threads that need it wait for it)."
  [h lib ^String nm]
  (let [^ConcurrentHashMap m (:checked lib)
        d (or (.get m nm) (let [d (delay (check-lib-unit h lib nm))] (or (.putIfAbsent m nm d) d)))]
    @d))

(defn- check-lib-unit
  [h lib ^String nm]
  (do
      (let [rd (with-ctors (load-unit (:dir lib) nm) (str (.getName (File. ^String (:dir lib))) "_" nm))
            u (assoc (crun/check-read h (host/file-config opts "gnu23") rd) :src nm)]
        (when (seq (:errors u))
          (throw (ex-info (str "the library unit " nm " does not check: " (str/join "; " (take 2 (:errors u)))
                               (when (crun/uses-long-double? (:forms rd)) " uses-long-double"))
                          {:ci/refused :runtime-check})))
        u)))

(defn closure
  "The library units a program needs, in the libraries' order (each a library map, musl's last): for a name the program or
  a linked unit references and nothing linked defines, the first library defining it gives its unit (a strong definition
  before a weak one). Returns [[lib unit] ...]."
  [libs prog-defs prog-refs]
  (let [defined (HashSet. ^java.util.Collection prog-defs)
        linked (java.util.LinkedHashSet.)
        q (ArrayDeque.)]
    (doseq [r (concat musl/roots prog-refs)] (.add q r))
    (while (not (.isEmpty q))
      (let [n (.poll q)]
        (when-not (.contains defined n)
          (when-let [[lib cands] (some (fn [lib] (when-let [c (.get ^HashMap (:by-name lib) n)] [lib c])) libs)]
            (let [[s _] (or (first (remove second cands)) (first cands))]
              (when (.add linked [lib s])
                (let [{:keys [defs refs]} (get (:index lib) s)]
                  (doseq [d (keys defs)] (.add defined d))
                  (doseq [r refs]
                    (when-not (.contains defined r) (.add q r))
                    (when (str/starts-with? r "__builtin_") (.add q (subs r 10)))))))))))
    (vec linked)))

(defn- sym-name [x] (cond (symbol? x) (name x) (and (seq? x) (= 'c/id (first x))) (str (second x))))

(defn- def-name
  "A top-level form's defined name and whether it is static: [name static?] for a c/defn or a non-extern c/var, else nil."
  [f]
  (when (seq? f)
    (case (first f)
      c/defn [(sym-name (second f)) (boolean (:static (meta (second f))))]
      c/var (let [m (meta (second f))] (when-not (:extern m) [(sym-name (second f)) (boolean (:static m))]))
      nil)))

(defn prune
  "The library units' forms cut to the definitions the program reaches (a linker's --gc-sections for ci, CX8): every form that
  defines nothing is kept (types, declarations, assertions, groups), and its references are roots, as are `roots` (the names
  the program's own units and musl's reference, the constructors); a name referenced in a unit is its own definition there
  when it has one (static or not), else every external definition of the name in the units. units: checked units; returns
  them with :rd's :forms cut (the forms are the checked ones, so the checker's results still hold)."
  [units roots]
  (let [n (count units)
        forms (mapv #(vec (:forms (:rd %))) units)
        ;; per unit: name -> [form index ...]; globally: external name -> [[unit index] ...]
        local (mapv (fn [fs] (let [m (HashMap.)]
                               (doseq [[i f] (map-indexed vector fs) :let [[nm] (def-name f)] :when nm]
                                 (.put m nm (conj (or (.get m nm) []) i)))
                               m))
                    forms)
        global (let [m (HashMap.)]
                 (doseq [u (range n) [i f] (map-indexed vector (forms u)) :let [[nm st] (def-name f)] :when (and nm (not st))]
                   (.put m nm (conj (or (.get m nm) []) [u i])))
                 m)
        keep (mapv (fn [_] (HashSet.)) (range n))
        q (ArrayDeque.)
        mark! (fn [u i] (when (.add ^HashSet (keep u) i) (.add q [u i])))
        ref! (fn [u nm] (if-let [is (and u (.get ^HashMap (local u) nm))]
                          (doseq [i is] (mark! u i))
                          (doseq [[v i] (.get global nm)] (mark! v i))))]
    (doseq [r roots] (ref! nil r))
    (doseq [u (range n) [i f] (map-indexed vector (forms u)) :when (nil? (def-name f))] (mark! u i))
    (while (not (.isEmpty q))
      (let [[u i] (.poll q)]
        (doseq [r (musl/refs [((forms u) i)])] (ref! u r))))
    (mapv (fn [u cu] (assoc-in cu [:rd :forms] (vec (keep-indexed (fn [i f] (when (.contains ^HashSet (keep u) i) f)) (forms u)))))
          (range n) units)))

(defn- init-unit
  "The checked unit defining _init, which calls the constructors named, in order."
  [h names]
  (let [f (File/createTempFile "cppi-init" ".c")
        text (str (str/join (for [n names] (str "void " n "(void);\n")))
                  "void _init(void) {\n" (str/join (for [n names] (str "  " n "();\n"))) "}\n")]
    (try
      (spit f text)
      (let [fc (host/file-config opts "gnu23")
            rd (rc/read-c (host/config h fc (.getParent f)) fc (.getName f) false)
            u (crun/check-read h fc rd)]
        (when (or (:error rd) (seq (:errors u)))
          (throw (ex-info (str "the constructors' unit does not check: " (or (:error rd) (:errors u))) {:ci/refused :init})))
        u)
      (finally (.delete f)))))

(defn build-linked
  "The node program's commands of the program's checked units linked with the libraries (musl's library last, a map of
  arbace.c.musl/library's)."
  [h libs units]
  (let [pdefs (set (mapcat #(keys (musl/unit-defs (:forms (:rd %)))) units))
        prefs (set (mapcat #(musl/refs (concat (:forms (:rd %)) (mapcat :forms (vals (:units (:rd %)))))) units))
        prefs (into prefs (keep #(when (str/starts-with? % "__builtin_") (subs % 10)) prefs))
        linked (closure libs pdefs prefs)
        _ (when (System/getenv "CPPI_TRACE") (binding [*out* *err*] (println "cppi: linked" (count linked) (mapv second linked))))
        t0 (System/nanoTime)
        us (mapv (fn [[lib s]] (if (:root lib) (musl/checked-unit lib s) (checked-lib-unit h lib s))) linked)
        t1 (System/nanoTime)
        cs (mapcat #(:ctors (:rd %)) (concat units us))
        ;; the C++ libraries' units cut to what the program reaches (musl's kept whole: ci's builder may call its functions)
        cpp? (mapv (fn [[lib]] (not (:root lib))) linked)
        musl-us (keep-indexed (fn [i u] (when-not (cpp? i) u)) us)
        roots (concat (map second cs) ["main" "_init"]
                      (mapcat #(musl/refs (concat (:forms (:rd %)) (mapcat :forms (vals (:units (:rd %)))))) (concat units musl-us)))
        pruned (if (System/getenv "CPPI_NO_PRUNE") (keep-indexed (fn [i u] (when (cpp? i) u)) us)
                   (prune (vec (keep-indexed (fn [i u] (when (cpp? i) u)) us)) roots))
        us (let [pq (java.util.ArrayDeque. ^java.util.Collection (vec pruned))]
             (mapv (fn [i u] (if (cpp? i) (.poll pq) u)) (range (count us)) us))
        init (when (seq cs) (init-unit h (map second (sort-by first cs))))]
    (let [t2 (System/nanoTime)
          r (build/build-program (cond-> (vec units) init (conj init) true (into us)) :libc-start true)]
      (when (System/getenv "CPPI_TRACE")
        (binding [*out* *err*]
          (println (format "cppi: units checked %.1f s, pruned %.1f s, built %.1f s; forms %d of %d" (/ (- t1 t0) 1e9) (/ (- t2 t1) 1e9)
                           (/ (- (System/nanoTime) t2) 1e9) (reduce + (map #(count (:forms (:rd %))) pruned))
                           (reduce + (keep-indexed (fn [i [lib s]] (when (cpp? i) (count (:forms (:rd (checked-lib-unit h lib s)))))) linked))))))
      r)))

;; ---------------------------------------------------------------------------------------------
;; Programs

(defn- secs [t0] (format "%.1f" (/ (- (System/nanoTime) t0) 1e9)))

(defn uses-atomic-generic?
  "Whether the forms call gcc's generic __atomic_load, __atomic_store or __atomic_exchange, which the lowering writes for an
  atomic of a floating type and repr/c's <builtin> source declares without parameters (the class atomic-generic, review 191 F3)."
  [forms]
  (letfn [(walk [x] (or (and (seq? x) (#{'__atomic_load '__atomic_store '__atomic_exchange} (first x)))
                        (and (or (seq? x) (vector? x)) (some walk x))))]
    (boolean (some walk forms))))

(defn va-arg-fns
  "The functions of the IR at `ll` that read a va_list as clang writes va_arg for x86-64 at -O0, inline, by getelementptr into
  %struct.__va_list_tag (gp_offset, reg_save_area): ci's va_list is its own, so on ci they read garbage (the class va-arg, review
  191 F2; the user's decision: a gap class now, ci's x86-64 va_list later). Their names as the IR spells them."
  [^String ll]
  (let [out (java.util.LinkedHashSet.)]
    (loop [ls (str/split-lines (slurp ll)) cur nil]
      (when-let [^String l (first ls)]
        (let [cur (if (str/starts-with? l "define ")
                    (second (re-find #"@\"?([^\"(]+)\"?\(" l))
                    cur)]
          (when (and cur (str/includes? l "getelementptr") (str/includes? l "%struct.__va_list_tag,")) (.add out cur))
          (recur (rest ls) cur))))
    (vec out)))

(defn read-program
  "A program's lowered C read and checked (arbace.c.run/read-unit's, its constructors renamed): a unit with :status :ok, or
  {:status :read-error|:read-refused|:check-error :message}."
  [h ^File f]
  (let [fc (host/file-config opts "gnu23")
        rd (rc/read-c (host/config h fc (.getParent f)) fc (.getName f) false)]
    (cond
      (:error rd) {:status :read-error :message (str/join "; " (take 3 (:error rd)))}
      (:refused rd) {:status :read-refused :message (str (name (:refused rd)) ": " (:message rd))}
      :else (let [u (crun/check-read h fc (with-ctors rd "p"))]
              (if (seq (:errors u))
                (assoc u :status :check-error :message (str (str/join "; " (take 3 (:errors u)))
                                                            (when (uses-atomic-generic? (:forms rd)) " uses-atomic-generic")
                                                            (when (crun/uses-long-double? (:forms rd)) " uses-long-double")))
                (assoc u :status :ok))))))

(defn lower-ll
  "The IR at `ll` lowered (arbace.cpp.lower/lower-file) into lowered.c beside it: nil, or [\"lower-refused\" class message]."
  [^String ll]
  (let [c (str (.getParent (File. ll)) "/lowered.c")
        r (lower/lower-file ll "lowered.c")]
    (if (:refused r)
      ["lower-refused" (name (:refused r)) (:message r)]
      (do (llvm/spit-latin1 c (:c r)) nil))))

(defn- build-one
  "One program: its IR lowered (a path ending in .ll; else the path is lowered C already), the lowered C read and checked,
  linked, built: [status class message flags seconds cmds], seconds \"LOWER+BUILD\"."
  [h libs-of ^String path]
  (let [ll path
        t0 (System/nanoTime)
        refused (when (str/ends-with? path ".ll") (lower-ll path))
        ls (secs t0)
        t0 (System/nanoTime)
        path (if (str/ends-with? path ".ll") (str (.getParent (File. path)) "/lowered.c") path)
        f (File. path)
        u (when-not refused (read-program h f))
        secs (fn [t] (str ls "+" (secs t)))]
    (cond
      refused (conj refused "" ls nil)
      (not= :ok (:status u)) [(name (:status u)) "" (:message u) "" (secs t0) nil]
      :else
      (let [va (when (str/ends-with? ll ".ll") (seq (va-arg-fns ll)))
            ;; the flags, space-separated: long-double, va-arg=NAME,NAME (the judge's)
            ld (str/join " " (remove nil? [(when (crun/uses-long-double? (:forms (:rd u))) "long-double")
                                           (when va (str "va-arg=" (str/join "," va)))]))
            r (try {:cmds (build-linked h (libs-of) [u])}
                   (catch arbace.lang.ExceptionInfo e
                     (if-let [c (:ci/refused (ex-data e))]
                       {:refused c :message (.getMessage e)}
                       (throw e))))]
        (if (:cmds r)
          ["ok" "" "" ld (secs t0) (:cmds r)]
          ["refused" (name (:refused r)) (:message r) ld (secs t0) nil])))))

(defn- work-list
  "Runs f on each line of LIST in `threads` threads; f returns the row's fields after the id; WORK/OUT.tsv the rows."
  [^String list threads ^String out f]
  (let [lines (vec (remove str/blank? (str/split-lines (slurp list))))
        q (ConcurrentLinkedQueue. ^java.util.Collection lines)
        res (ConcurrentHashMap.)
        workers (doall (for [_ (range threads)]
                         (future
                           (loop []
                             (when-let [^String l (.poll q)]
                               (let [fs (str/split l #"\t" -1)
                                     r (try (f fs) (catch Throwable e ["build-error" "" (str (.getName (class e)) ": " (.getMessage e)) "" ""]))]
                                 (.put res (first fs) (str/join "\t" (cons (first fs) (map clean r)))))
                               (recur))))))]
    (doseq [w workers] @w)
    (spit out (str (str/join "\n" (sort (vals res))) "\n"))))

(defn- libs-fn
  "A function of a program's extra library directory (or \"\") giving its libraries: [extra? runtime musl], each loaded once."
  [h ^String rtlib]
  (let [rt (delay (library rtlib))
        ;; ci's overrides (test/cpp/runtime/ci/*.c, read by bin/cppi runtime-ci into RTLIB/over): linked before the runtime
        over (delay (when (.exists (File. (str rtlib "/over/index.edn"))) (library (str rtlib "/over"))))
        ms (delay (musl/library h (System/getProperty "user.dir")))
        extra (ConcurrentHashMap.)]
    (fn [^String xdir]
      (vec (concat (when (seq xdir) [(or (.get extra xdir) (let [l (library xdir)] (.putIfAbsent extra xdir l) (.get extra xdir)))])
                   (when @over [@over])
                   [@rt @ms])))))

(defn nodes-list
  "nodes-list WORK LIST RTLIB THREADS: each line of LIST (ID LOWERED.C EXTRA-LIB) built into WORK/ID.nodes; WORK/nodes.tsv
  lists ID STATUS CLASS MESSAGE FLAGS SECONDS (arbace.c.run's nodes-list's, with the build's seconds)."
  [h ^String work ^String list ^String rtlib threads]
  (let [lf (libs-fn h rtlib)]
    (work-list list threads (str work "/nodes.tsv")
               (fn [[id path xdir]]
                 (let [[st cls msg ld s cmds] (if (= path "-") ["ir-missing" "" "" "" "" nil] (build-one h #(lf (or xdir "")) path))]
                   (when cmds (spit-mk (str work "/" id ".nodes") (build/program-text cmds)))
                   [st cls msg ld s])))))

(defn compile-list
  "compile-list OUT LIST RTLIB THREADS: each line of LIST (ID LOWERED.C EXTRA-LIB PKG) built and translated by cf2g into
  OUT/progs/PKG/prog.go (package PKG, path arbace/progs/PKG); OUT/nodes.tsv as nodes-list's (cf2g's refusal: refused, its
  class). CI_AOT_NODES: the node program kept beside, prog.nodes, for the interpreted run."
  [h ^String out ^String list ^String rtlib threads]
  (require 'arbace.c.cf2g)
  (let [lf (libs-fn h rtlib)
        translate (resolve 'arbace.c.cf2g/translate)
        go-text (resolve 'arbace.c.cf2g/go-text)]
    (work-list list threads (str out "/nodes.tsv")
               (fn [[id path xdir pkg]]
                 (let [[st cls msg ld s cmds] (if (= path "-") ["ir-missing" "" "" "" "" nil] (build-one h #(lf (or xdir "")) path))]
                   (if-not cmds
                     [st cls msg ld s]
                     (let [t0 (System/nanoTime)]
                       (try (let [[forms] (translate cmds pkg (str "arbace/progs/" pkg))
                                  d (str out "/progs/" pkg)]
                              (when (System/getenv "CI_AOT_NODES") (spit-mk (str d "/prog.nodes") (build/program-text cmds)))
                              (spit-mk (str d "/prog.go") (go-text forms))
                              ["ok" "" "" ld (str s "+" (secs t0))])
                            (catch arbace.lang.ExceptionInfo e
                              (if-let [c (:cf2g/refused (ex-data e))]
                                ["refused" (name c) (.getMessage e) ld s]
                                (throw e)))))))))))

(defn check-c
  "check-c LIST THREADS (ORS27: the lowering's C level from the records, where gcc compiling the lowered C was): each line of LIST
  (NAME DIR) has DIR/lowered.c read by repr/c and checked by ci's checker as a program is (read-program); DIR/ci-check.status the
  outcome (ok, read-error, read-refused, check-error, check-crash), DIR/ci-check.log its message. LIST.out the rows (work-list's)."
  [h ^String list threads]
  (work-list list threads (str list ".out")
             (fn [[_ dir]]
               (let [r (try (read-program h (File. (str dir "/lowered.c")))
                            (catch Throwable e {:status :check-crash :message (str (.getName (class e)) ": " (.getMessage e))}))
                     st (name (:status r))]
                 (spit (str dir "/ci-check.status") (str st "\n"))
                 (spit (str dir "/ci-check.log") (str (:message r "") "\n"))
                 [st (:message r "")]))))

(defn -main
  "bin/cppi's ci steps: read-lib DIR LIST THREADS, lower-lib DIR LIST THREADS, check-c LIST THREADS, nodes-list WORK LIST RTLIB THREADS, compile-list OUT LIST RTLIB THREADS,
  nodes RTLIB EXTRA-LIB OUT LOWERED.C."
  [verb & args]
  (let [h (host/load-host "test/c/host")
        th #(Long/parseLong (or % "3"))]
    (case verb
      "read-lib" (let [[dir list t] args] (System/exit (if (read-lib h dir list (th t)) 0 1)))
      ;; lower-lib DIR LIST THREADS: each line of LIST (NAME LL) lowered beside its IR, then read as read-lib does
      "lower-lib" (let [[dir list t] args
                        rows (mapv #(str/split % #"\t") (remove str/blank? (str/split-lines (slurp list))))
                        bad (doall (keep (fn [[n ll]] (when-let [r (lower-ll ll)] (str n ": " (str/join " " r)))) rows))]
                    (doseq [b bad] (println "cppi: not lowered:" b))
                    (spit (str dir "/read.list") (str/join (for [[n ll] rows] (str n "\t" (.getParent (File. ^String ll)) "/lowered.c\n"))))
                    (System/exit (if (and (empty? bad) (read-lib h dir (str dir "/read.list") (th t))) 0 1)))
      "check-c" (let [[list t] args] (check-c h list (th t)))
      "nodes-list" (let [[work list rt t] args] (nodes-list h work list rt (th t)))
      "compile-list" (let [[out list rt t] args] (compile-list h out list rt (th t)))
      "nodes" (let [[rt xdir out path] args
                    [st cls msg _ s cmds] (build-one h #((libs-fn h rt) xdir) path)]
                (if cmds
                  (do (spit out (build/program-text cmds)) (println "cppi: built in" s "s"))
                  (do (binding [*out* *err*] (println (str st (when (seq cls) (str " (" cls ")")) ": " msg))) (System/exit 1))))
      (do (println "arbace.cpp.run: read-lib, nodes-list, compile-list, nodes") (System/exit 2)))
    (shutdown-agents)
    (System/exit 0)))

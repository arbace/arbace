;; Part of Arbace. Ports parts of the LLVM Project's clang (https://github.com/llvm/llvm-project at llvmorg-23.1.4,
;; commit 7a941dfb2877a0b8cf30323fefa85ad019e0b0f5): clang/lib/Sema/SemaTemplateDeduction.cpp's
;; DeduceTemplateArgumentsByTypeMatch, AdjustFunctionParmAndArgTypesForDeduction, DeduceTemplateSpecArguments with
;; DeduceTemplateBases, checkDeducedTemplateArguments, isForwardingReference, hasInconsistentOrSupersetQualifiersOf and
;; isAtLeastAsSpecializedAs (a call's partial ordering), ported by hand on 2026-11-05 (doc/cpp/CODEGEN.md §G3); and at llvmorg-23.1.5
;; (llvm-project-23.1.5.src.tar.xz, the pin of test/cpp/corpora.edn) clang/lib/Sema/SemaTemplateDeductionGuide.cpp's
;; DeclareImplicitDeductionGuides, transformConstructor, buildSimpleDeductionGuide and DeclareAggregateDeductionGuideFromInitList
;; and clang/lib/Sema/SemaInit.cpp's DeduceTemplateSpecializationFromInitializer (class template argument deduction, `ctad`),
;; ported by hand on 2026-11-09 (doc/cpp/CPP-SURVEY.md, "As built: CP311 (a) and the rest of CP313 (a)"). Their notice:
;;
;;   Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
;;   See https://llvm.org/LICENSE.txt for license information.
;;   SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
;;
;; The rest of this file is Arbace's own. LICENSE.md states which license covers what.

(ns arbace.cpp.template
  "Templates for the code generator (doc/cpp/CODEGEN.md §G3): class and function templates declared, specialized and
  instantiated on use. The native parser's tree keeps a template's pattern as it was written (clang's dependent
  nodes as syntax: a type is its spelling, a name its identifier), so an instantiation is the pattern declared again
  by arbace.cpp.sema in a scope that binds the template's parameters to its arguments -- what clang's TreeTransform
  does by substitution, done here by re-analysis -- and a member's or a function template's definition is analyzed
  only when the program uses it (clang's InstantiateFunctionDefinition on odr-use: `:lazy` until a round of analysis
  references it). Deduction from a call ([temp.deduct.call]: P/A adjusted, then matched structurally as
  DeduceTemplateArgumentsByTypeMatch does), explicit arguments, default arguments, non-type parameters, explicit
  specializations of class and function templates, partial specializations of class templates chosen by deduction and
  ordered as [temp.class.order] says, partial ordering of function templates ([temp.func.order],
  [temp.deduct.partial]) and the overload tie-breaks of [over.match.best]/2.2-2.5; packs, alias and variable
  templates, template template parameters, pointer and reference non-type parameters, members defined outside their
  class (of the primary or of a partial specialization), explicit specializations of members, friends defined in
  classes, two-phase lookup's dependent bases. The structure follows clang's
  SemaTemplateDeduction.cpp, SemaTemplateInstantiate.cpp and SemaTemplateInstantiateDecl.cpp at llvmorg-23.1.4 (read
  as the model; their functions' names are kept where the parts correspond; CODEGEN.md §G3 says what is ported and
  what written). Refusals as in sema: {:codegen/refused :template ...}."
  (:require [arbace.cpp.abi :as abi]
            [arbace.cpp.sema :as sema]
            [arbace.repr.cpp.types :as ct]
            [arbace.string :as str]))

(set! *warn-on-reflection* true)

(def fail abi/fail)

;; sema's private parts this namespace builds on
(defn- next-id [] (#'sema/next-id))
(defn- new-scope [kind parent & more] (apply #'sema/new-scope kind parent more))
(defn- enter! [scope nm e] (#'sema/enter! scope nm e))
(defn- upd-fn! [id f & args] (apply swap! sema/*fns* update id f args))
(defn- upd-var! [id f & args] (apply swap! sema/*vars* update id f args))
(defn- kids [n] (filter #(and (map? %) (:kind %)) (:inner n)))
(defn- node-text ^String [n] (#'sema/node-text n))

;; ---------------------------------------------------------------------------------------------
;; State: the templates by id
;;  {:id :tk :fn|:class :name :scope (the declaring scope) :path :params [{:name :kind :type|:value :qt :default}]
;;   :pattern node :pos :insts {args id} :specs {args node} :partials [{:params :args :node}] :ool [{:k :fn|:var :node :pnames}]}
;; Arguments: a type (a map with :k) or a value {:val n :ty T}. In a template's signature its own parameters are
;; {:k :tparam :i i :tid tid :name s} (a type) and {:k :tparam-v :i i :tid tid} (a value: an array bound, an argument),
;; a template-id with such arguments {:k :tspec :tmpl tid :name s :path p :args [...]}.

(def ^:dynamic *tmpls* nil)
;; CP365 (a): the provisional instances, {arg-class-id #{instance-class-id}}, and how to make each again {cid (fn [])}
(def ^:dynamic *provisional* nil)

(defn- same-arg? [a b] (if (and (map? a) (contains? a :val)) (= (:val a) (:val b)) (= a b)))
(def ^:dynamic *scanned* nil)
(def ^:dynamic *instance* nil) ; the class specialization being declared, or nil ; atom #{[:fn id] [:var id]} the pending scan has walked

(defn tmpl [tid] (get @*tmpls* tid))
(defn- upd-tmpl! [tid f & args] (apply swap! *tmpls* update tid f args))

(defn dependent?
  "Whether a type or argument names a template's parameter."
  [x]
  (cond
    (map? x) (or (#{:tparam :tparam-v :tspec :tdep :texpr :pack-exp} (:k x)) (some dependent? (vals x)))
    (sequential? x) (some dependent? x)
    :else false))

;; ---------------------------------------------------------------------------------------------
;; Template parameter lists

(defn- tc-arg-forms
  "A type-constraint's template arguments as written (`__eligible_tuple_like<tuple> _UTuple`: [tuple]), as forms, from the
  parameter's text: the arguments after the concept's last name; nil when the text does not show them."
  [k]
  (let [ts (vec (ct/tokens (or (node-text k) "")))
        nm (peek (:_tc k))
        i (some (fn [i] (when (and (= nm (nth (get ts i) 1 nil)) (= "<" (nth (get ts (inc i)) 1 nil))) i)) (range 0 (dec (count ts))))]
    (when i (first (ct/template-args ts (+ 2 i))))))

(defn- tparams
  "The template parameters of a template declaration node's kids."
  [n]
  (vec (for [k (kids n) :when (#{"TemplateTypeParmDecl" "NonTypeTemplateParmDecl" "TemplateTemplateParmDecl"} (:kind k))]
         (do
           (cond->
             (case (:kind k)
               "TemplateTypeParmDecl" (cond-> {:name (:name k) :kind :type :default (some-> (first (kids (update k :inner (fn [is] (remove #(= "ConceptSpecializationExpr" (:kind %)) is))))) (get-in [:type :qualType]))}
                                        ;; a type-constraint ([temp.param]/4): the concept's name as written
                                        (:_tc k) (assoc :tc (:_tc k) :tc-args (:_tcargs k))
                                        ;; (its arguments' forms as written, C<A...> T: the immediately-declared constraint
                                        ;; C<T, A...>, [temp.param]/4; from the parameter's text)
                                        (and (:_tc k) (:_tcargs k)) (assoc :tc-forms (tc-arg-forms k)))
               "NonTypeTemplateParmDecl" {:name (:name k) :kind :value :qt (str/replace (get-in k [:type :qualType]) #"\s*\.\.\.$" "")
                                          :default (some-> (first (kids k)) kids first)}
               "TemplateTemplateParmDecl" {:name (:name k) :kind :template})
             ;; (cpp-s4: a pack's `...` is written before its name, not in its default argument -- variant's
             ;; `typename = enable_if_t<sizeof...(_Types) != 0>` is no pack -- nor in a template template parameter's own
             ;; parameter list, `template<typename...> class _Tp`)
             (or (:isParameterPack k)
                 (let [t (first (str/split (or (node-text k) "") #"=" 2))
                       t (if (= "TemplateTemplateParmDecl" (:kind k)) (subs t (inc (long (or (str/last-index-of t ">") -1)))) t)]
                   (re-find #"\.\.\." t)))
             (assoc :pack true))))))

(defn- strip-tparam-kids [n]
  (assoc n :inner (vec (remove #(#{"TemplateTypeParmDecl" "NonTypeTemplateParmDecl" "TemplateTemplateParmDecl" "TemplateArgument"} (:kind %)) (:inner n)))))

;; ---------------------------------------------------------------------------------------------
;; Scopes binding the parameters

(defn- param-type [scope p] (abi/unq (sema/resolve-type scope (:qt p))))

(declare arg-entity)
(declare ^:dynamic *unstable*)

(defn- bind-scope
  "A scope of the parameters `params` bound to `args` (a type each, or {:val n}) over `parent`; with `sym-tid` (and no
  args) each parameter stands for itself, as in the template's signature."
  [parent params args sym-tid]
  (let [s (new-scope :tparams parent :internal (:internal parent) :cls (:cls parent) :extern-c (:extern-c parent))]
    (doseq [[i p] (map-indexed vector params)]
      (enter! s (:name p)
              (if sym-tid
                (case (:kind p)
                  :type {:e :type :ty (cond-> {:k :tparam :i i :tid sym-tid :name (:name p)} (:pack p) (assoc :pack true)) :pos -1}
                  :template {:e :ttp :i i :tid sym-tid :pos -1}
                  {:e :nttp :i i :tid sym-tid :ty (param-type s p) :pack (:pack p) :pos -1})
                (arg-entity p (nth args i)))))
    s))

(defn- arg-entity
  "The entity a parameter's name stands for when bound to the argument `a`: a type, a value (an enumerator's
  entity), a non-type parameter or a dependent expression of a signature, a pack of them ({:pack [...]})."
  [p a]
  (cond
    ;; (a parameter pack's own type in a signature, {:k :tparam :pack true}, is a type, not a pack of arguments: an alias
    ;; template's argument in a pack expansion's pattern, tuple<typename __decay_and_strip<_Elements>::__type...>; CP332 (a))
    (and (contains? a :pack) (not (:k a))) {:e :pack :kind (:kind p) :elems (:pack a) :pos -1}
    (= :type (:kind p)) {:e :type :ty a :pos -1}
    ;; a template template parameter: the template, or in a signature the parameter itself
    (= :template (:kind p)) (if (:tmpl a) {:e :tmpl :tk :class :id (:tmpl a) :pos -1} {:e :ttp :i (:i a) :tid (:tid a) :pos -1})
    (contains? a :val) {:e :enumerator :val (:val a) :ty (:ty a) :pos -1}
    (= :tparam-v (:k a)) {:e :nttp :i (:i a) :tid (:tid a) :pos -1}
    (contains? a :decl) {:e :declconst :decl (:decl a) :ty (:ty a) :null (:null a) :pos -1}
    :else {:e :texpr :x a :pos -1}))

;; ---------------------------------------------------------------------------------------------
;; Constant expressions written as text (a template argument the type parser leaves as (cpp/text s))

(declare resolve-arg)

(defn- var-value
  "cpp-s4: a constant variable's value as its type holds it, its initializer converted ([conv.integral]/3:
  `static const _Value __max = ... : ~(_Value)0;` of __numeric_traits_integer<unsigned char> is 255, not -1)."
  [v x]
  (if (and (number? x) (abi/integral? (abi/unq (:ty v)))) (sema/ce-wrap (:ty v) x) x))

(defn- const-entity [scope parts]
  (let [es (if (= 1 (count parts)) (sema/lookup scope (first parts)) (sema/lookup-qualified scope parts))
        e (first es)]
    (case (:e e)
      :enumerator (:val e)
      :nttp (cond-> {:k :tparam-v :i (:i e) :tid (:tid e)} (:pack e) (assoc :pack true))
      :texpr (:x e)
      :var (let [v (sema/var* (:id e))]
             (if (and (:c (:ty v)) (:init v)) (var-value v (sema/const-int (or (:def-scope v) scope) (:init v))) (fail :template "not a constant: " (str/join "::" parts))))
      (fail :template "not a constant: " (str/join "::" parts)))))

(defn- member-constant
  "The constant `nm` of the class type `t` (X<T>::value), or, when `t` is dependent, the expression standing for it
  ({:k :texpr :o :sr}, mangled sr...)."
  [t ^String nm]
  (if (dependent? t)
    {:k :texpr :o :sr :base t :name nm}
    (do (when-not (abi/class? t) (fail :template "a member of a non-class: " nm))
        ;; a qualified name: its dependent bases searched too ([temp.dep.type]; G4: value through __and_<...>::type)
        (let [e (first (map second (sema/class-lookup (:id t) nm false)))]
          (if (= :var (:e e))
            (let [v (sema/var* (:id e))]
              (if (and (:c (:ty v)) (:init v)) (var-value v (sema/const-int (or (:def-scope v) (:scope (abi/cls (:id t)))) (:init v))) (fail :template "not a constant: " nm)))
            (const-entity (:scope (abi/cls (:id t))) [nm]))))))

(def ^:private binary-fns
  {"+" unchecked-add "-" unchecked-subtract "*" unchecked-multiply "/" quot "%" rem "<<" bit-shift-left ">>" bit-shift-right "&" bit-and "|" bit-or "^" bit-xor
   "<" #(if (< %1 %2) 1 0) ">" #(if (> %1 %2) 1 0) "<=" #(if (<= %1 %2) 1 0) ">=" #(if (>= %1 %2) 1 0)
   "==" #(if (= %1 %2) 1 0) "!=" #(if (not= %1 %2) 1 0) "&&" #(if (and (not= %1 0) (not= %2 0)) 1 0)
   "||" #(if (or (not= %1 0) (not= %2 0)) 1 0)})

(def ^:private two64 18446744073709551616N)

(defn- u64?
  "An unsigned 64-bit value above Long/MAX_VALUE, the one value of the text's evaluation held as a BigInt."
  [x]
  (instance? arbace.lang.BigInt x))

(defn- lng
  "A value's 64-bit pattern as a long (an unsigned 64-bit BigInt wrapped: 18446744073709551615N is -1)."
  [x]
  (if (u64? x) (.longValue (.toBigInteger ^arbace.lang.BigInt x)) (long x)))

(defn- u64
  "A value as unsigned long long's ([conv.integral]/3: modulo 2^64), normalized: a long when it fits, else a BigInt."
  [x]
  (let [v (mod (bigint x) two64)]
    (if (<= v 9223372036854775807) (long v) v)))

(defn- fold
  "An operator applied to constants: its value, or (an operand dependent) the expression {:k :texpr :o o :args [...]}.
  The values are exact integers, one representation (review 1111 #3, cpp-s5b): a long, or an unsigned 64-bit value above
  Long/MAX_VALUE as a BigInt (`size_t(-1)`, `18446744073709551615ULL`, `0x8000000000000000`). An operand of that kind
  makes the operation unsigned long long's, as the usual arithmetic conversions do ([expr.arith.conv]/1.5): the operands
  taken modulo 2^64 and the result too, a comparison of the converted values; else 64-bit arithmetic wraps as sema's
  const-int. A division by zero and a shift by a count outside 0..63 are not constants: refusals, never Java's
  exceptions (review 1111 #5)."
  [o args]
  (if (every? number? args)
    (let [ok (fn [b] (cond (and (#{"/" "%"} o) (zero? b)) (fail :template "division by zero in a constant expression")
                           (and (#{"<<" ">>"} o) (not (<= 0 b 63))) (fail :template "a shift by " b " in a constant expression")
                           :else b))]
      (if (some u64? args)
        (let [[a b c] args
              ua (bigint (u64 a))
              ub (when (some? b) (bigint (u64 b)))
              bit (fn [f] (u64 (bigint (f (.toBigInteger ^arbace.lang.BigInt ua) (.toBigInteger ^arbace.lang.BigInt ub)))))]
          (case o
            "neg" (u64 (- ua)) "!" (if (zero? ua) 1 0) "~" (u64 (- two64 1 ua)) "?" (if (zero? (lng a)) c b)
            "+" (u64 (+ ua ub)) "-" (u64 (- ua ub)) "*" (u64 (* ua ub))
            "/" (u64 (quot ua (ok ub))) "%" (u64 (rem ua (ok ub)))
            "<<" (u64 (* ua (.pow (java.math.BigInteger/valueOf 2) (int (ok (lng b))))))
            ">>" (u64 (quot ua (bigint (.pow (java.math.BigInteger/valueOf 2) (int (ok (lng b)))))))
            "&" (bit #(.and ^java.math.BigInteger %1 ^java.math.BigInteger %2))
            "|" (bit #(.or ^java.math.BigInteger %1 ^java.math.BigInteger %2))
            "^" (bit #(.xor ^java.math.BigInteger %1 ^java.math.BigInteger %2))
            "<" (if (< ua ub) 1 0) ">" (if (> ua ub) 1 0) "<=" (if (<= ua ub) 1 0) ">=" (if (>= ua ub) 1 0)
            "==" (if (== ua ub) 1 0) "!=" (if (== ua ub) 0 1)
            "&&" (if (and (not (zero? ua)) (not (zero? ub))) 1 0) "||" (if (or (not (zero? ua)) (not (zero? ub))) 1 0)))
        (let [[a b c] (map long args)]
          (case o
            "neg" (unchecked-negate a) "!" (if (zero? a) 1 0) "~" (bit-not a) "?" (if (zero? a) c b)
            (do (ok b) (long ((binary-fns o) a b)))))))
    {:k :texpr :o o :args (vec args)}))

(def ^:private cast-types #{"bool" "char" "short" "int" "long" "unsigned" "signed"})

(defn- cast-to
  "A constant converted to a builtin integral type named by its words (bool: 0 or 1; the others kept, the slice's
  values fitting)."
  [^String ty v]
  (cond (map? v) {:k :texpr :o "cast" :type ty :args [v]}
        (str/starts-with? ty "bool") (if (zero? (lng v)) 0 1)
        (#{"char" "signed char"} ty) (long (unchecked-byte (lng v)))
        (= ty "unsigned char") (bit-and (lng v) 0xff)
        (#{"short" "signed short"} ty) (long (unchecked-short (lng v)))
        (= ty "unsigned short") (bit-and (lng v) 0xffff)
        (#{"int" "signed" "signed int"} ty) (long (unchecked-int (lng v)))
        (#{"unsigned" "unsigned int"} ty) (bit-and (lng v) 0xffffffff)
        ;; (cpp-s5b: a 128-bit type's constant is not evaluated in the text, a refusal, never computed modulo 2^64)
        (str/includes? ty "__int128") (fail :template "a constant of type " ty)
        ;; (review 1111 #3: unsigned long (long) as unsigned long long's value, fold's representation)
        (str/includes? ty "unsigned") (u64 (lng v))
        :else (lng v)))

;; ---------------------------------------------------------------------------------------------
(declare expand-type-pack)

;; The type-trait builtins (G4; clang's lib/Sema/SemaTypeTraits.cpp, EvaluateUnaryTypeTrait, EvaluateBinaryTypeTrait,
;; EvaluateBooleanTypeTrait, and the transform traits of BuiltinTypes' TransformTypeTraits): the ones libstdc++ 15's
;; <type_traits> uses when __has_builtin says so, each a constant or a type of its type arguments; written from the
;; standard's [meta] definitions with clang's functions as the model

(defn- declval-node
  "An expression of type `t` as std::declval<T>() is: an lvalue for T&, an xvalue for T&& and for an object type."
  [t]
  (cond (= :ref (:k t)) {:op :declval :ty (:to t) :cat :lv}
        (= :rref (:k t)) {:op :declval :ty (:to t) :cat :xv}
        :else {:op :declval :ty t :cat :xv}))

(defn- works? [f] (try (f) true (catch arbace.lang.ExceptionInfo _ false)))

(defn- complete-class? [t] (and (abi/class? (abi/unq t)) (seq (:fields (abi/cls (:id (abi/unq t))))) true))

(defn- object-type? [t] (not (or (abi/ref? t) (abi/fn? t) (abi/void? t))))

(def ^:dynamic *constructing* #{}) ; the [T args] whose constructibility is being asked (a cycle: not constructible)

(defn- trait-constructible? [scope t args]
  (cond
    (contains? *constructing* [t args]) false
    (abi/void? (abi/unq t)) false
    (abi/fn? t) false
    (and (abi/arr? t) (nil? (:n t))) false
    (and (abi/arr? t) (seq args)) false
    (and (abi/ref? t) (empty? args)) false
    :else (binding [*constructing* (conj *constructing* [t args])]
           (works? #(sema/init-for t (cond (empty? args) nil
                                         (= 1 (count args)) (if (abi/class? (abi/unq t)) [(declval-node (first args))] (declval-node (first args)))
                                         :else (mapv declval-node args))
                                  {:scope scope :statics (atom [])} (cond (empty? args) :value (= 1 (count args)) :direct :else :direct))))))

(declare walk-refs)

(defn- calls-nothrow?
  "Whether every function an analyzed initialization or expression calls is noexcept (an implicit or defaulted special
  member counted so: the trivial and the implicit ones of the samples' classes)."
  [x]
  (let [acc (atom {:fns #{} :vars #{} :classes #{}})]
    (walk-refs acc x)
    (every? (fn [id] (let [f (sema/fnd id)] (or (:noexcept f) (:implicit f) (:defaulted f)))) (:fns @acc))))


(defn- trait-nothrow-constructible? [scope t args]
  (and (trait-constructible? scope t args)
       (try (calls-nothrow? (sema/init-for t (cond (empty? args) nil
                                                   (= 1 (count args)) (if (abi/class? (abi/unq t)) [(declval-node (first args))] (declval-node (first args)))
                                                   :else (mapv declval-node args))
                                           {:scope scope :statics (atom [])} (if (empty? args) :value :direct)))
            (catch arbace.lang.ExceptionInfo _ false))))

(defn- trait-nothrow-assignable? [scope t u]
  (try (calls-nothrow? (#'sema/assign-node {:scope scope :statics (atom [])} (declval-node t) (declval-node u)))
       (catch arbace.lang.ExceptionInfo _ false)))

(defn- trait-convertible? [scope from to]
  (cond (abi/void? (abi/unq to)) (abi/void? (abi/unq from))
        (or (abi/fn? to) (abi/arr? to)) false
        :else (and (some? (try (sema/ics (declval-node from) to) (catch arbace.lang.ExceptionInfo _ nil)))
                   (works? #(sema/init-for to (declval-node from) {:scope scope :statics (atom [])} :copy)))))

(defn- trait-assignable? [scope t u]
  (works? #(#'sema/assign-node {:scope scope :statics (atom [])} (declval-node t) (declval-node u))))

(defn- trivial-class? [t pred]
  (let [u (abi/unq t)]
    (if (abi/class? u) (boolean (pred (:id u))) true)))

(defn- trivially-default? [id]
  (let [c (abi/cls id)]
    (and (not (abi/dynamic? id))
         (every? #(let [f (sema/fnd %)] (or (seq (:ps (:ty f))) (and (or (:implicit f) (:defaulted f)) (not (:tinits f)) true))) (:ctors c))
         (every? (fn [fl] (and (nil? (:init fl)) (trivial-class? (loop [t (:ty fl)] (if (abi/arr? t) (recur (:of t)) t)) trivially-default?))) (:fields c))
         (every? #(trivially-default? (:cls %)) (:bases c)))))

(def ^:private value-traits
  {"__is_same" (fn [_ [a b]] (= a b))
   ;; (clang's alias of __is_same, TokenKinds.def's ALIAS("__is_same_as", __is_same, KEYCXX))
   "__is_same_as" (fn [_ [a b]] (= a b))
   "__is_void" (fn [_ [a]] (abi/void? (abi/unq a)))
   "__is_integral" (fn [_ [a]] (contains? abi/int-ranks (abi/bn (abi/unq a))))
   "__is_floating_point" (fn [_ [a]] (boolean (abi/floating? (abi/unq a))))
   "__is_arithmetic" (fn [_ [a]] (abi/arith? (abi/unq a)))
   "__is_fundamental" (fn [_ [a]] (= :b (:k a)))
   "__is_class" (fn [_ [a]] (and (abi/class? (abi/unq a)) (not (:union (abi/cls (:id (abi/unq a)))))))
   "__is_union" (fn [_ [a]] (and (abi/class? (abi/unq a)) (boolean (:union (abi/cls (:id (abi/unq a)))))))
   "__is_enum" (fn [_ [a]] (abi/enum? (abi/unq a)))
   "__is_scoped_enum" (fn [_ [a]] (and (abi/enum? (abi/unq a)) (boolean (:scoped (abi/enm (:id (abi/unq a)))))))
   "__is_array" (fn [_ [a]] (abi/arr? a))
   "__is_bounded_array" (fn [_ [a]] (and (abi/arr? a) (some? (:n a))))
   "__is_unbounded_array" (fn [_ [a]] (and (abi/arr? a) (nil? (:n a))))
   "__is_pointer" (fn [_ [a]] (abi/ptr? a))
   "__is_reference" (fn [_ [a]] (boolean (abi/ref? a)))
   "__is_lvalue_reference" (fn [_ [a]] (= :ref (:k a)))
   "__is_rvalue_reference" (fn [_ [a]] (= :rref (:k a)))
   "__is_function" (fn [_ [a]] (abi/fn? a))
   "__is_member_pointer" (fn [_ [a]] (abi/mptr? a))
   "__is_member_function_pointer" (fn [_ [a]] (abi/mfn-ptr? a))
   "__is_member_object_pointer" (fn [_ [a]] (and (abi/mptr? a) (not (abi/mfn-ptr? a))))
   "__is_const" (fn [_ [a]] (boolean (:c (loop [t a] (if (abi/arr? t) (recur (:of t)) t)))))
   "__is_volatile" (fn [_ [a]] (boolean (:v (loop [t a] (if (abi/arr? t) (recur (:of t)) t)))))
   "__is_object" (fn [_ [a]] (object-type? a))
   "__is_scalar" (fn [_ [a]] (abi/scalar? (abi/unq a)))
   "__is_signed" (fn [_ [a]] (let [u (abi/unq a)] (or (abi/floating? u) (and (contains? abi/int-ranks (abi/bn u)) (not (contains? abi/unsigned-ns (abi/bn u)))))))
   "__is_unsigned" (fn [_ [a]] (let [u (abi/unq a)] (contains? abi/unsigned-ns (abi/bn u))))
   "__is_empty" (fn [_ [a]] (let [u (abi/unq a)] (and (abi/class? u) (not (:union (abi/cls (:id u)))) (abi/empty-class? (:id u)))))
   "__is_polymorphic" (fn [_ [a]] (let [u (abi/unq a)] (and (abi/class? u) (boolean (abi/dynamic? (:id u))))))
   "__is_abstract" (fn [_ [a]] (let [u (abi/unq a)] (and (abi/class? u) (boolean (some #(:pure (sema/fnd (:fn %))) (:vtable (abi/cls (:id u))))))))
   "__is_final" (fn [_ [a]] (let [u (abi/unq a)] (and (abi/class? u) (boolean (:final (abi/cls (:id u)))))))
   "__is_aggregate" (fn [_ [a]] (let [u (abi/unq a)] (or (abi/arr? u) (and (abi/class? u) (boolean (sema/aggregate? (:id u)))))))
   "__has_virtual_destructor" (fn [_ [a]] (let [u (abi/unq a)] (and (abi/class? u) (boolean (some-> (:dtor (abi/cls (:id u))) sema/fnd :virtual)))))
   "__is_base_of" (fn [_ [b d]] (let [b (abi/unq b) d (abi/unq d)]
                                  ;; (cpp-s8: a class whose definition is under way has not all its bases yet: the answer
                                  ;; may change, so a concept's satisfaction that asked it is not kept, *unstable*)
                                  (when (and (abi/class? d) (not (:finished (abi/cls (:id d))))) (some-> *unstable* (reset! true)))
                                  (and (abi/class? b) (abi/class? d) (or (= b d) (boolean (abi/derived-from? (:id d) (:id b)))))))
   "__is_convertible" (fn [scope [f t]] (trait-convertible? scope f t))
   "__is_convertible_to" (fn [scope [f t]] (trait-convertible? scope f t))
   "__is_nothrow_convertible" (fn [scope [f t]] (trait-convertible? scope f t))
   "__is_constructible" (fn [scope [t & as]] (trait-constructible? scope t as))
   "__is_nothrow_constructible" (fn [scope [t & as]] (trait-nothrow-constructible? scope t as))
   "__is_trivially_constructible"
   (fn [scope [t & as]]
     (and (trait-constructible? scope t as)
          (let [u (abi/unq (loop [t t] (if (abi/arr? t) (recur (:of t)) t)))]
            (cond (not (abi/class? u)) true
                  (empty? as) (trivially-default? (:id u))
                  (and (= 1 (count as)) (= u (abi/unq (abi/non-ref (first as))))) (sema/trivial-copy? (:id u))
                  :else false))))
   "__is_assignable" (fn [scope [t u]] (trait-assignable? scope t u))
   "__is_nothrow_assignable" (fn [scope [t u]] (trait-nothrow-assignable? scope t u))
   "__is_trivially_assignable" (fn [scope [t u]] (and (trait-assignable? scope t u)
                                                      (let [c (abi/unq (abi/non-ref t))] (or (not (abi/class? c)) (sema/trivial-copy? (:id c))))))
   "__is_destructible" (fn [_ [a]] (not (or (abi/void? (abi/unq a)) (abi/fn? a) (and (abi/arr? a) (nil? (:n a))))))
   "__is_nothrow_destructible" (fn [_ [a]] (not (or (abi/void? (abi/unq a)) (abi/fn? a) (and (abi/arr? a) (nil? (:n a))))))
   "__is_trivially_destructible" (fn [_ [a]] (and (not (abi/void? (abi/unq a))) (trivial-class? (loop [t a] (if (abi/arr? t) (recur (:of t)) t)) sema/trivial-dtor?)))
   "__has_trivial_destructor" (fn [_ [a]] (trivial-class? (loop [t a] (if (abi/arr? t) (recur (:of t)) t)) sema/trivial-dtor?))
   "__is_trivially_copyable" (fn [_ [a]] (let [u (abi/unq (loop [t a] (if (abi/arr? t) (recur (:of t)) t)))]
                                           (or (abi/scalar? u) (and (abi/class? u) (sema/trivial-copy? (:id u)) (sema/trivial-dtor? (:id u))))))
   "__is_trivial" (fn [_ [a]] (let [u (abi/unq (loop [t a] (if (abi/arr? t) (recur (:of t)) t)))]
                                (or (abi/scalar? u) (and (abi/class? u) (sema/trivial-copy? (:id u)) (sema/trivial-dtor? (:id u)) (trivially-default? (:id u))))))
   "__is_standard_layout" (fn [_ [a]] (let [u (abi/unq (loop [t a] (if (abi/arr? t) (recur (:of t)) t)))]
                                        (or (abi/scalar? u) (and (abi/class? u) (not (abi/dynamic? (:id u)))))))
   "__is_pod" (fn [_ [a]] (let [u (abi/unq (loop [t a] (if (abi/arr? t) (recur (:of t)) t)))]
                            (or (abi/scalar? u) (and (abi/class? u) (not (abi/dynamic? (:id u))) (sema/trivial-copy? (:id u)) (sema/trivial-dtor? (:id u))))))
   "__is_literal_type" (fn [_ [a]] (let [u (abi/unq a)] (or (abi/scalar? u) (abi/ref? a) (abi/void? u) (and (abi/class? u) (sema/trivial-dtor? (:id u))))))
   "__has_unique_object_representations" (fn [_ [a]] (let [u (abi/unq a)] (or (contains? abi/int-ranks (abi/bn u)) (abi/ptr? u) (abi/enum? u))))
   "__reference_binds_to_temporary" (fn [_ _] false)
   "__reference_constructs_from_temporary"
   (fn [_ [t u]] (and (abi/ref? t) (not (abi/ref? u)) (or (= :rref (:k t)) (:c (:to t))) (= (abi/unq (:to t)) (abi/unq u))))
   "__reference_converts_from_temporary"
   (fn [_ [t u]] (and (abi/ref? t) (not (abi/ref? u)) (or (= :rref (:k t)) (:c (:to t))) (= (abi/unq (:to t)) (abi/unq u))))})

(defn- decay [t]
  (let [t (abi/non-ref t)]
    (cond (abi/arr? t) (abi/ptr (:of t))
          (abi/fn? t) (abi/ptr t)
          :else (abi/unq t))))

(def ^:private type-traits
  {"__remove_cv" (fn [[a]] (if (abi/arr? a) (assoc a :of (abi/unq (:of a))) (abi/unq a)))
   "__remove_const" (fn [[a]] (dissoc a :c))
   "__remove_volatile" (fn [[a]] (dissoc a :v))
   "__remove_reference" (fn [[a]] (abi/non-ref a))
   "__remove_cvref" (fn [[a]] (let [t (abi/non-ref a)] (if (abi/arr? t) (assoc t :of (abi/unq (:of t))) (abi/unq t))))
   "__decay" (fn [[a]] (decay a))
   "__remove_pointer" (fn [[a]] (if (abi/ptr? (abi/unq a)) (:to (abi/unq a)) a))
   "__add_pointer" (fn [[a]] (if (or (abi/fn? a) (abi/void? (abi/unq a)) (object-type? a) (abi/ref? a)) (abi/ptr (abi/non-ref a)) a))
   "__add_lvalue_reference" (fn [[a]] (if (abi/void? (abi/unq a)) a (abi/lref (abi/non-ref a))))
   "__add_rvalue_reference" (fn [[a]] (cond (abi/void? (abi/unq a)) a (abi/ref? a) a :else (abi/rref a)))
   "__remove_extent" (fn [[a]] (if (abi/arr? a) (:of a) a))
   "__remove_all_extents" (fn [[a]] (loop [t a] (if (abi/arr? t) (recur (:of t)) t)))
   "__underlying_type" (fn [[a]] (abi/underlying (abi/unq a)))})

(defn- split-top-commas
  "A text split at its commas outside brackets and parentheses."
  [^String t]
  (loop [i 0 d 0 start 0 out []]
    (if (>= i (count t))
      (let [x (str/trim (subs t start))] (if (seq x) (conj out x) out))
      (let [c (.charAt t i)]
        (cond (#{\( \< \[ \{} c) (recur (inc i) (inc d) start out)
              (#{\) \> \] \}} c) (recur (inc i) (max 0 (dec d)) start out)
              (and (zero? d) (= c \,)) (recur (inc i) d (inc i) (conj out (str/trim (subs t start i))))
              :else (recur (inc i) d start out))))))

(defn trait-name? [x] (let [n (str x)] (or (contains? value-traits n) (contains? type-traits n))))

(defn- trait-args [scope forms]
  (vec (mapcat (fn [f]
                 (cond (and (seq? f) (= 'pack-expand (first f))) (expand-type-pack scope (second f))
                       (and (seq? f) (= 'cpp/text (first f))) [(sema/resolve-type scope (second f))]
                       :else [(sema/resolve-type-form scope f)]))
               forms)))

(defn trait-value
  "A value trait's constant (0 or 1) of its type arguments' forms, or a dependent {:k :texpr :o :trait} in a template's
  signature."
  [scope ^String nm forms]
  (let [ts (trait-args scope forms)]
    (if (some dependent? ts)
      {:k :texpr :o :trait :name nm :types ts}
      (if ((value-traits nm) scope ts) 1 0))))

(defn trait-type
  "A transform trait's type of its type arguments' forms (__remove_cv(T), __decay(T), ...), dependent in a signature."
  [scope ^String nm forms]
  (let [ts (trait-args scope forms)]
    (cond
      (some dependent? ts) {:k :tdep :trait nm :base (first ts) :types ts :names []}
      (contains? type-traits nm) ((type-traits nm) ts)
      :else (fail :template "the type trait " nm))))

(defn- template-name? [scope ^String nm]
  (let [es (sema/lookup scope nm)]
    (some #(or (= :tmpl (:e %)) (and (= :type (:e %)) (abi/class? (:ty %)) (:tmpl (abi/cls (:id (:ty %)))))) es)))

(defn- qualified-template-name?
  "cpp-s4: whether the qualified name `ps` (its parts) names a template: `__gnu_cxx::__int_traits<_IntType>::__max` in
  parse_numbers.h's _Select_int_base, written in another namespace than the template's."
  [scope ps]
  (if (= 1 (count ps))
    (template-name? scope (first ps))
    (let [es (try (sema/lookup-qualified scope ps) (catch arbace.lang.ExceptionInfo _ nil))]
      (some #(or (= :tmpl (:e %)) (and (= :type (:e %)) (abi/class? (:ty %)) (:tmpl (abi/cls (:id (:ty %)))))) es))))

(declare static-call-value packs-named const-form)

(defn eval-text
  "The value of a constant expression's text in `scope` (integers, the operators, parentheses, the conditional
  operator, names of constants and of non-type parameters, members of classes (X<T>::value), sizeof(type), true and
  false): a number, or in a template's signature the dependent expression standing for it."
  [scope ^String s]
  (let [ts (vec (ct/tokens s))
        pos (atom 0)
        peek (fn [] (nth (get ts @pos) 1 nil))
        next! (fn [] (let [t (get ts @pos)] (swap! pos inc) t))
        ;; an integer literal ([lex.icon]): decimal, 0x, 0b or octal, digit separators ', the suffixes u, l, ll, z in any
        ;; case and order; its value modulo 2^64 in fold's representation, a BigInt above Long/MAX_VALUE (an unsigned
        ;; long long: 18446744073709551615ULL; review 1111 #5: template/array32.C's 18446744073709551615 had thrown Java's
        ;; NumberFormatException, a crash of Sema; 0b literals and separators were not read; #3: one representation)
        num (fn [^String t] (let [t (str/replace (str/replace (str/lower-case t) "'" "") #"[ulz]+$" "")
                                  [d r] (cond (str/starts-with? t "0x") [(subs t 2) 16]
                                              (str/starts-with? t "0b") [(subs t 2) 2]
                                              (and (> (count t) 1) (str/starts-with? t "0")) [(subs t 1) 8]
                                              :else [t 10])]
                              ;; (cpp-s7: a floating literal, `(T) 1.0` in cpp2a/explicit6.C's explicit-specifier, is not read
                              ;; here: a refusal, not Java's NumberFormatException, a crash of Sema since review 1111 #5)
                              (when-not (re-matches (case (int r) 16 #"[0-9a-f]+" 2 #"[01]+" 8 #"[0-7]*" #"[0-9]+") d)
                                (fail :template "not an integer literal " t))
                              (u64 (bigint (if (= "" d) java.math.BigInteger/ZERO (java.math.BigInteger. ^String d (int r)))))))
        prec {"||" 1 "&&" 2 "|" 3 "^" 4 "&" 5 "==" 6 "!=" 6 "<" 7 ">" 7 "<=" 7 ">=" 7 "<<" 8 ">>" 8 "+" 9 "-" 9 "*" 10 "/" 10 "%" 10}
        ;; the tokens of a bracketed run from the current position (its opening token consumed), joined
        run (fn [^String open ^String close]
              (let [start @pos]
                (loop [d 1]
                  (let [[_ x] (next!)]
                    (cond (nil? x) (fail :template "constant expression " s)
                          (= x open) (recur (inc d))
                          (= x close) (if (= 1 d) (str/join " " (map second (subvec ts start (dec @pos)))) (recur (dec d)))
                          :else (recur d))))))]
    (letfn [(cast-named [nm v]
              (let [ty (abi/unq (sema/resolve-type scope nm))]
                (cond (or (map? v) (dependent? ty)) {:k :texpr :o "cast" :type ty :args [v]}
                      (= :bool (:n ty)) (if (zero? (lng v)) 0 1)
                      ;; (cpp-s5b: a 128-bit type's constant is not evaluated in the text, a refusal)
                      (and (abi/integral? ty) (> (* 8 (long (abi/size-of ty))) 64)) (fail :template "a 128-bit constant expression " s)
                      ;; (an unsigned 64-bit type's value as fold's: modulo 2^64, a BigInt above Long/MAX_VALUE)
                      (abi/integral? ty) (let [b (* 8 (abi/size-of ty))]
                                           (if (>= b 64) (if (abi/signed? ty) (lng v) (u64 (lng v)))
                                               (let [m (dec (bit-shift-left 1 b)) u (bit-and (lng v) m)]
                                                 (if (and (abi/signed? ty) (bit-test u (dec b))) (- u (inc m)) u))))
                      ;; (cpp-s5: a floating type's value, the operators' integers: `double(-1) < double(0)`)
                      (abi/floating? ty) v
                      :else (fail :template "constant expression " s))))
            (primary []
              (let [[k t] (next!)]
                (cond
                  ;; a C-style cast to a builtin type: (bool)(x)
                  (and (= t "(") (contains? cast-types (peek)))
                  (let [ws (loop [ws []] (let [[_ x] (next!)] (if (= x ")") ws (recur (conj ws x)))))]
                    (cast-to (str/join " " ws) (primary)))
                  ;; (cpp-s4: a C-style cast to a type named by one identifier, a template's type parameter or a typedef:
                  ;; parse_numbers.h's `(_IntType)_Val` in _Select_int_base's base; an integral type's value range)
                  (and (= t "(") (= :id (first (get ts @pos))) (= ")" (nth (get ts (inc @pos)) 1 nil))
                       (some #(= :type (:e %)) (sema/lookup scope (peek))))
                  (let [[_ nm] (next!) _ (next!)]
                    (cast-named nm (primary)))
                  ;; (cpp-s5: a functional cast to a type named by one identifier, [expr.type.conv]/2: <type_traits>'
                  ;; __is_signed_helper's `__bool_constant<_Tp(-1) < _Tp(0)>`, so that is_signed_v<long> holds; an unsigned
                  ;; 64-bit value above Long/MAX_VALUE as the integer it is, so that the comparison is the type's)
                  (and (= k :id) (= "(" (peek)) (not (template-name? scope t))
                       (some #(= :type (:e %)) (sema/lookup scope t)))
                  (let [_ (next!) v (expr 0) _ (next!)]
                    (cast-named t v))
                  (= t "(") (let [v (expr 0)] (next!) v)
                  (= t "-") (fold "neg" [(primary)])
                  (= t "+") (primary)
                  (= t "!") (fold "!" [(primary)])
                  (= t "~") (fold "~" [(primary)])
                  (= t "true") 1
                  (= t "false") 0
                  ;; static_cast<T>(x) to a builtin type (G5: <locale_facets.h>'s 1 + static_cast<unsigned char>(-1))
                  (and (#{"static_cast" "reinterpret_cast" "const_cast"} t) (= "<" (peek)))
                  (let [_ (next!) ty (run "<" ">") _ (next!) v (expr 0)] (next!) (cast-to ty v))
                  ;; a functional cast to a builtin type: bool(x), int(x)
                  (and (contains? cast-types t) (= "(" (peek)))
                  (do (next!) (let [v (expr 0)] (next!) (cast-to t v)))
                  ;; (CP338 (a): sizeof...(pack) in a type's text, a base's argument: tuple_size<tuple<_Elements...>>'s
                  ;; integral_constant<size_t, sizeof...(_Elements)>; the count of the pack's elements, dependent when unbound)
                  (and (= t "sizeof") (= "..." (peek)))
                  (let [_ (next!) _ (next!) nm (str/trim (run "(" ")"))
                        [[_ e]] (packs-named scope [nm])]
                    (if e (count (or (:elems e) (:ids e))) {:k :texpr :o "sizeof..." :name nm}))
                  (= t "sizeof") (let [_ (next!)
                                       r (str/trim (run "(" ")"))
                                       ;; (cpp-s4: sizeof of a member or a variable named alone, [expr.sizeof]/1's expression
                                       ;; operand: any's `unsigned char _M_buffer[sizeof(_M_ptr)];`)
                                       e (when (re-matches #"[A-Za-z_][A-Za-z_0-9]*" r)
                                           (first (filter #(#{:field :var} (:e %)) (sema/lookup scope r))))
                                       ty (abi/non-ref (case (:e e)
                                                         :field (:ty (nth (:fields (abi/cls (:cls e))) (:i e)))
                                                         :var (:ty (sema/var* (:id e)))
                                                         (sema/resolve-type scope r)))]
                                   (if (dependent? ty) {:k :texpr :o "sizeof" :type ty} (abi/size-of ty)))
                  ;; a value trait (G4): __is_same(T, U), its arguments types
                  (and (= k :id) (= "(" (peek)) (contains? value-traits t))
                  (let [_ (next!) txt (run "(" ")")]
                    (trait-value scope t (mapv (fn [^String a] (if (str/ends-with? a "...")
                                                                 (list 'pack-expand (ct/parse-type (str/trim (subs a 0 (- (count a) 3)))))
                                                                 (list 'cpp/text a)))
                                               (split-top-commas txt))))
                  (= k :num) (num t)
                  (= k :chr) (long (int (.charAt ^String t 1)))
                  ;; a call of a constexpr function (an array bound `int[sq(3)]`) on constant arguments
                  (and (= k :id) (= "(" (peek)) (not (template-name? scope t))
                       (some #(= :fn (:e %)) (sema/lookup scope t)))
                  (let [_ (next!)
                        args (if (= ")" (peek)) (do (next!) [])
                               (loop [as []] (let [a (expr 0) [_ x] (next!)] (if (= x ",") (recur (conj as a)) (conj as a)))))
                        cands (filter #(and (= :fn (:e %)) (= (count args) (count (:ps (:ty (sema/fnd (:id %))))))) (sema/lookup scope t))]
                    (when (or (empty? cands) (not-every? number? args)) (fail :template "constant call " s))
                    (sema/ce-call-fn (:id (first cands)) args))
                  (= k :id)
                  ;; a name, qualified, its parts maybe template-ids: Name<...>::member
                  (let [tkw (atom false)
                        parts (loop [ps [t]]
                                (cond
                                  (and (= "<" (peek)) (or (template-name? scope (last ps)) (and @tkw (> (count ps) 1))
                                                           (and (> (count ps) 1) (qualified-template-name? scope ps))))
                                  (do (next!) (recur (conj (pop ps) (str (last ps) "<" (run "<" ">") ">"))))
                                  ;; (`X::template f<...>`: a member template named after a dependent qualifier)
                                  (= "::" (peek)) (do (next!) (when (= "template" (peek)) (next!) (reset! tkw true)) (recur (conj ps (second (next!)))))
                                  :else ps))]
                    (cond
                      ;; a call without arguments of a static member (function template's specialization), G5c:
                      ;; `_PCCP::template _ConstructiblePair<_U1, _U2>() && ...` (libstdc++'s C++17 std::pair)
                      (and (> (count parts) 1) (= "(" (peek)) (= ")" (nth (get ts (inc @pos)) 1 nil)))
                      (do (next!) (next!) (static-call-value scope (ct/parse-name (str/join "::" parts))))
                      ;; (cpp-s4: a variable template's specialization alone, `__accepted_index<_Tp>` as a template argument in
                      ;; variant's `__to_type<__accepted_index<_Tp>>`: const-form's, its partial specializations matched)
                      (and (= 1 (count parts)) (str/includes? (first parts) "<"))
                      (const-form scope (ct/parse-name (first parts)))
                      (some #(str/includes? % "<") parts)
                      (let [r (member-constant (sema/resolve-type scope (str/join "::" (butlast parts))) (last parts))
                            tp (last (butlast parts))
                            i (str/index-of tp "<")]
                        ;; (an unresolved name's spelling for its mangling: its arguments as written, its namespaces)
                        r)
                      :else
                      (let [es (when (> (count parts) 1) (sema/lookup scope (first parts)))
                            e (first (filter #(= :type (:e %)) es))]
                        (if (and e (dependent? (:ty e)))
                          (member-constant (sema/resolve-type scope (str/join "::" (butlast parts))) (last parts))
                          (const-entity scope parts)))))
                  :else (fail :template "constant expression " s))))
            (expr [^long minp]
              (loop [l (primary)]
                (let [o (peek) p (get prec o)]
                  (cond
                    (and (= o "?") (<= minp 0)) (do (next!) (let [a (expr 0) _ (next!) b (expr 0)] (fold "?" [l a b])))
                    (and p (> (long p) minp)) (do (next!) (recur (fold o [l (expr p)])))
                    :else l))))]
      (let [v (expr 0)]
        (when (< (long @pos) (count ts)) (fail :template "constant expression " s))
        ;; (review 1111 #3: outside the text a value is its 64-bit pattern, a long, as sema's ce-wrap gives it)
        (if (u64? v) (lng v) v)))))

(declare resolve-args complete-args instantiate-fn var-template-inst written-qualifier)

(defn- static-call-value
  "The value of a call without arguments of a constexpr static member function, or of a specialization of a static
  member function template given its template arguments (`_PCCP::template _ConstructiblePair<_U1, _U2>()`, libstdc++'s
  C++17 std::pair constructors' enable_if conditions; G5c: libsupc++'s eh_alloc.cc); dependent in a pattern's signature
  ({:k :texpr :o :mcall})."
  [scope callee]
  (let [[cls tf] (if (and (seq? callee) (= 'cpp/scope (first callee))) [(second callee) (last callee)] [nil callee])
        tf (if (and (seq? tf) (= 'template (first tf))) (second tf) tf)
        [nsym targs] (if (and (seq? tf) (= '<> (first tf))) [(second tf) (vec (nnext tf))] [tf nil])
        ;; (a qualified name read as one symbol, P/f: its qualifier the class)
        [cls nm] (if (and (nil? cls) (symbol? nsym) (namespace nsym)) [(symbol (namespace nsym)) (name nsym)] [cls (str nsym)])
        ct (when cls (sema/resolve-type-form scope cls))
        ;; (the qualifier as written when it is a typedef's or an alias template's name: its mangling is that name, an
        ;; unresolved-qualifier-level <simple-id> with the alias template's arguments as written, Itanium 5.1.5.3, clang's
        ;; mangleUnresolvedTypeOrSimpleId on the TypedefType or the alias's TemplateSpecializationType; not the class it
        ;; names: libstdc++'s pair<_T1, _T2>::_PCCP, `using _PCCP = _PCC<true, _T1, _T2>`, mangles sr5_PCCPE, not
        ;; sr3std4_PCCILb1E...E with the class's arguments substituted; eh_alloc.cc's two pair constructors)
        wb (written-qualifier scope cls)]
    (if (and ct (dependent? ct))
      (cond-> {:k :texpr :o :mcall :base ct :name nm} wb (assoc :wbase wb))
      (try
      (let [_ (when (and ct (not (abi/class? (abi/unq ct)))) (fail :template "a member call of a non-class: " nm))
            es (if ct (map second (sema/class-lookup (:id (abi/unq ct)) nm false)) (sema/lookup scope nm))
            fid (if targs
                  (let [e (or (first (filter #(and (= :tmpl (:e %)) (= :fn (:tk %))) es)) (fail :template "no member function template " nm))
                        t (tmpl (:id e))
                        args (or (complete-args t (resolve-args scope t targs false)) (fail :template "the template arguments of " nm))
                        ;; (the template's own parameters in a pattern's signature: dependent, evaluated once substituted)
                        _ (when (some dependent? args) (throw (ex-info "dependent" {::dependent true ::targs args})))]
                    (instantiate-fn (:id e) args))
                  (:id (or (first (filter #(and (= :fn (:e %)) (empty? (:ps (:ty (sema/fnd (:id %)))))) es)) (fail :template "no function " nm))))]
        (sema/ce-call-fn fid []))
      (catch arbace.lang.ExceptionInfo x
        (if (::dependent (ex-data x)) (cond-> {:k :texpr :o :mcall :base ct :name nm :targs (::targs (ex-data x))} wb (assoc :wbase wb)) (throw x)))))))

(defn- written-qualifier
  "A static member call's qualifier as written, when it is a typedef's name (`_PCCP`) or an alias template's
  specialization (`_PCCFP<_U1, _U2>`): {:name s} or {:name s :args [...]} (the arguments resolved, as written); nil for a
  class's own name, a template parameter or a qualified name (mangled from the type)."
  [scope cls]
  (cond
    (and (symbol? cls) (nil? (namespace cls)))
    (when (:typedef (first (filter #(= :type (:e %)) (sema/lookup scope (name cls)))))
      {:name (name cls)})
    (and (seq? cls) (= '<> (first cls)) (symbol? (second cls)) (nil? (namespace (second cls))))
    (let [e (first (filter #(= :tmpl (:e %)) (sema/lookup scope (name (second cls)))))
          t (when e (tmpl (:id e)))]
      (when (and t (= :alias (:tk t)))
        {:name (name (second cls)) :args (or (resolve-args scope t (vec (nnext cls)) false) (fail :template "the template arguments of " (:name t)))}))))

(defn- concept-named
  "The entry of the concept the name `nm` (a symbol, n/C qualified) denotes in `scope`, or nil."
  [scope nm]
  (let [es (try (if (namespace nm) (sema/lookup-qualified scope (vec (concat (str/split (namespace nm) #"/") [(name nm)]))) (sema/lookup scope (name nm)))
                (catch arbace.lang.ExceptionInfo _ nil))]
    (first (filter #(and (= :tmpl (:e %)) (= :concept (:tk %))) es))))

(declare concept-satisfied?)

(defn- const-form
  "A constant of a template argument's or array bound's form: a number, a name, X<T>::member, (cpp/text s)."
  [scope f]
  (cond
    (number? f) (long f)
    (true? f) 1 (false? f) 0
    (symbol? f) (let [parts (if (namespace f) (concat (str/split (namespace f) #"/") [(name f)]) [(name f)])
                      e (when (> (count parts) 1) (first (filter #(= :type (:e %)) (sema/lookup scope (first parts)))))]
                  (if (and e (dependent? (:ty e)))
                    (member-constant (sema/resolve-type-form scope (symbol (str/join "/" (butlast parts)))) (last parts))
                    (const-entity scope parts)))
    (and (seq? f) (= 'cpp/scope (first f))) (member-constant (sema/resolve-type-form scope (second f)) (name (last f)))
    (and (seq? f) (= 'cpp/text (first f))) (eval-text scope (second f))
    ;; a type trait's value (G4: __is_same(T, U))
    (and (seq? f) (= 'fn (first f)) (vector? (second f)) (symbol? (nth f 2 nil)) (contains? value-traits (str (nth f 2))))
    (trait-value scope (str (nth f 2)) (second f))
    ;; (CP338 (a): a variable template's specialization, its arguments not dependent: the specialization's constant
    ;; initializer; libstdc++'s variant<_Types...>::__not_in_place_tag<_Tp> in its converting constructor's enable_if_t)
    (and (seq? f) (= '<> (first f)) (symbol? (second f)) (nil? (namespace (second f)))
         (some #(and (= :tmpl (:e %)) (= :var (:tk %))) (sema/lookup scope (name (second f)))))
    (let [e (first (filter #(and (= :tmpl (:e %)) (= :var (:tk %))) (sema/lookup scope (name (second f)))))
          t (tmpl (:id e))
          args (or (complete-args t (resolve-args scope t (vec (nnext f)) false)) (fail :template "the template arguments of " (:name t)))
          ;; (cpp-s4: with dependent arguments, in a template's symbolic signature, the expression standing for it: any's
          ;; `enable_if_t<is_copy_constructible_v<_VTp> && ..., bool> = true`, a non-type parameter's type)
          dep? (some dependent? args)]
      (if dep?
        {:k :texpr :o :vt :name (:name t) :args args}
        (let [v (sema/var* (var-template-inst t args))]
          (if (and (:c (:ty v)) (:init v)) (var-value v (sema/const-int (or (:def-scope v) scope) (:init v))) (fail :template "not a constant: " (pr-str f))))))
    ;; (cpp-s8: a concept-id, [temp.names]/8: true when its concept is satisfied, a prvalue of type bool; with dependent
    ;; arguments, in a template's symbolic signature, the expression standing for it -- <ranges_base.h>'s
    ;; borrowed_iterator_t<_Range> = __conditional_t<borrowed_range<_Range>, iterator_t<_Range>, dangling>, whose refusal
    ;; had taken ranges::copy's operator() for a range out)
    (and (seq? f) (= '<> (first f)) (symbol? (second f)) (concept-named scope (second f)))
    (let [c (tmpl (:id (concept-named scope (second f))))
          args (or (complete-args c (resolve-args scope c (vec (nnext f)) false)) (fail :template "the template arguments of " (:name c)))]
      (if (some dependent? args)
        {:k :texpr :o :concept :name (:name c) :tid (:id c) :args args}
        (if (concept-satisfied? c args) 1 0)))
    ;; a call without arguments of a static member (function template's specialization), G5c
    (and (seq? f) (= 'fn (first f)) (= [] (second f)) (let [c (nth f 2 nil)] (and (seq? c) (#{'cpp/scope '<>} (first c)))))
    (static-call-value scope (nth f 2))
    ;; a functional cast T(e) of a constant (G4: the headers' bool(_Bn::value))
    (and (seq? f) (= 'fn (first f)) (vector? (second f)) (= 1 (count (second f))))
    (let [v (const-form scope (first (second f)))
          t (abi/unq (sema/resolve-type-form scope (nth f 2)))]
      (cond (map? v) v
            (= :bool (abi/bn t)) (if (zero? (long v)) 0 1)
            :else (long v)))
    :else (fail :template "constant " (pr-str f))))

(defn- value-arg [v ^String _ t]
  (if (map? v) v {:val (if (= :bool (abi/bn t)) (if (zero? (long v)) 0 1) (long v)) :ty t}))

(defn- template-arg-of
  "A template template argument (a class template's name): {:tmpl tid :name :path}, or a signature's template template
  parameter {:k :ttp}."
  [scope f]
  (let [[scope f] (if (and (seq? f) (= 'cpp/global (first f))) [(loop [s scope] (if (:parent s) (recur (:parent s)) s)) (second f)] [scope f])
        nm (if (and (seq? f) (= 'cpp/text (first f))) (symbol (str/replace (str/trim (second f)) "::" "/")) f)
        _ (when-not (symbol? nm) (fail :template "a template template argument " (pr-str f)))
        parts (if (namespace nm) (concat (str/split (namespace nm) #"/") [(name nm)]) [(name nm)])
        es (if (= 1 (count parts)) (sema/lookup scope (first parts)) (sema/lookup-qualified scope (vec parts)))
        e (first (filter #(#{:tmpl :ttp :type} (:e %)) es))]
    (case (:e e)
      :ttp {:k :ttp :i (:i e) :tid (:tid e)}
      :tmpl (let [t (tmpl (:id e))] {:tmpl (:id e) :name (:name t) :path (:path t)})
      :type (if-let [tid (and (abi/class? (:ty e)) (:tmpl (abi/cls (:id (:ty e)))))]
              (let [t (tmpl tid)] {:tmpl tid :name (:name t) :path (:path t)})
              (fail :template "not a template: " nm))
      (fail :template "not a template: " nm))))

(defn- decl-arg
  "The argument of a pointer or reference non-type parameter of type `pt` ([temp.arg.nontype]): a function or a
  variable named (&F, F, &v, v for a reference), {:decl [:fn|:var id] :ty pt :mangled s}, or a null pointer; in a
  signature a parameter passed on."
  [scope pt f]
  (let [text (cond (symbol? f) (str/replace (str f) "/" "::")
                   (and (seq? f) (= 'cpp/text (first f))) (second f)
                   (nil? f) "nullptr"
                   :else (fail :template "a pointer argument " (pr-str f)))
        text (str/trim text)
        amp (str/starts-with? text "&")
        nm (str/trim (if amp (subs text 1) text))]
    (if (#{"nullptr" "0"} nm)
      {:decl [:null] :null true :ty pt}
      (let [parts (vec (map str/trim (str/split nm #"::")))
            es (if (= 1 (count parts)) (sema/lookup scope (first parts)) (sema/lookup-qualified scope parts))
            e (first es)]
        (case (:e e)
          :nttp {:k :tparam-v :i (:i e) :tid (:tid e)}
          :declconst {:decl (:decl e) :ty pt :mangled (:mangled e) :ref (boolean (abi/ref? pt))}
          :fn (let [want (if (abi/ptr? pt) (:to pt) (:to pt))
                    fid (or (some #(let [g (sema/fnd (:id %))]
                                     (when (and (= :fn (:e %)) (= (mapv abi/unq (:ps (:ty g))) (mapv abi/unq (:ps want))) (= (abi/unq (:ret (:ty g))) (abi/unq (:ret want))))
                                       (:id %)))
                                  es)
                            (fail :template "no function " nm " of the parameter's type"))]
                {:decl [:fn fid] :ty pt :mangled (abi/mangle-fn (sema/fnd fid)) :ref (boolean (abi/ref? pt))})
          :var (let [v (sema/var* (:id e))
                     _ (when (abi/arr? (:ty v)) (fail :template "an array's address as an argument"))
                     m (abi/mangle-var v)]
                 {:decl [:var (:id e)] :ty pt :ref (boolean (abi/ref? pt))
                  :mangled (if (str/starts-with? m "_Z") m (str "_Z" (abi/source-name m)))})
          (do
            ;; (CX12, the checker: `(T)f`, a function cast to a pointer to function of another type, is a reinterpret_cast
            ;; ([expr.cast]/4), never a converted constant expression ([temp.arg.nontype]/2, [expr.const]/5.15): the
            ;; explicit argument is invalid, the template surely no candidate)
            (when (sema/checking?)
              (when-let [[_ ty fname] (re-matches #"\(\s*([^()]+?)\s*\)\s*&?\s*([A-Za-z_]\w*)" text)]
                (let [ct (try (abi/unq (sema/resolve-type scope ty)) (catch arbace.lang.ExceptionInfo _ nil))
                      fs (sema/lookup scope fname)]
                  (when (and ct (abi/ptr? ct) (abi/fn? (:to ct)) (seq fs) (every? #(= :fn (:e %)) fs)
                             (not-any? #(= (abi/unq (:ty (sema/fnd (:id %)))) (abi/unq (:to ct))) fs))
                    (throw (ex-info (str "codegen: a reinterpret_cast as a template argument: " text)
                                    {:codegen/refused :template :cx/sure-drop true}))))))
            (fail :template "a pointer argument " text)))))))

(defn resolve-arg
  "A template argument's form for the parameter `p` in `scope`."
  [scope p f & [pscope]]
  (case (:kind p)
    :type (if (and (seq? f) (= 'cpp/text (first f))) (sema/resolve-type scope (second f)) (sema/resolve-type-form scope f))
    :template (template-arg-of scope f)
    (let [pt (param-type (or pscope scope) p)]
      (if (or (abi/ptr? pt) (abi/ref? pt))
        (decl-arg scope pt f)
        (value-arg (const-form scope f) (:name p) pt)))))

(defn- node-arg
  "A TemplateArgument node's argument for the parameter `p` (an explicit specialization's)."
  [scope p n]
  (cond
    (get-in n [:type :qualType]) (sema/resolve-type scope (get-in n [:type :qualType]))
    (contains? n :value) (value-arg (let [v (:value n)] (if (boolean? v) (if v 1 0) (long v))) (:name p) (param-type scope p))
    (:isPack n) {:pack (mapv #(node-arg scope p %) (filter (fn [k] (= "TemplateArgument" (:kind k))) (kids n)))}
    (seq (kids n)) (value-arg (sema/const-int scope (first (kids n))) (:name p) (param-type scope p))
    :else (fail :template "template argument " (pr-str (dissoc n :inner)))))

(defn- inherit-default
  "The parameter `p` (the `i`th of the declaration `to`) with the default argument of the `i`th of the declaration `from`;
  written in terms of `from`'s parameters, which it keeps as :dparams when their names differ from `to`'s
  ([temp.param]/12: `template <typename _CharT, typename = char_traits<_CharT>> struct basic_string;` then
  `template <typename, typename, typename> struct basic_string {...}`, pr77550.C)."
  [p from to ^long i]
  (let [q (get from i)
        dps (or (:dparams q) (subvec (vec from) 0 i))]
    (cond-> (assoc p :default (:default q))
      (not= (map :name dps) (map :name (subvec (vec to) 0 i))) (assoc :dparams dps))))

(defn- complete-args
  "The arguments `given` (a vector, maybe shorter) completed by the template's default arguments, each resolved in a
  scope binding the parameters before it ([temp.arg]/9); nil when one is missing."
  [t given]
  (loop [i (count given) args (vec given)]
    (if (= i (count (:params t)))
      args
      (let [p (nth (:params t) i)
            d (:default p)]
        (if (:pack p)
          (recur (inc i) (conj args {:pack []}))
        (when d
          (let [s (bind-scope (:scope t) (or (:dparams p) (subvec (:params t) 0 i)) args nil)
                a (if (= :type (:kind p))
                    (sema/resolve-type s d)
                    (value-arg (binding [sema/*cutoff* Long/MAX_VALUE]
                                 (try (sema/const-int s d)
                                      (catch arbace.lang.ExceptionInfo e
                                        ;; (cpp-s8: a default that names the parameters before it, given dependent
                                        ;; arguments: the dependent expression standing for it, read from its text as a
                                        ;; signature's -- <type_traits>' __match_cv_qualifiers<_Qualified, _Unqualified,
                                        ;; bool _IsConst = is_const<_Qualified>::value, ...> under __copy_cv<_Xp, _Yp>, so
                                        ;; __common_ref_impl's partial specializations had been dropped)
                                        (let [v (when (some dependent? args)
                                                  (try (eval-text s (#'sema/node-text d)) (catch arbace.lang.ExceptionInfo _ nil)))]
                                          (if (map? v) v (throw e))))))
                               (:name p) (param-type s p)))]
            (recur (inc i) (conj args a)))))))))

;; ---------------------------------------------------------------------------------------------
;; Packs ([temp.variadic]): a pack's elements, its expansions in types, argument lists and expressions

(defn- form-symbols [f]
  (cond (symbol? f) [f] (sequential? f) (mapcat form-symbols f) :else []))

(defn- packs-named
  "The packs among the entities the names `nms` denote in `scope`: [[name entity] ...]."
  [scope nms]
  (distinct (for [nm nms
                  :let [e (first (sema/lookup scope nm))]
                  :when (#{:pack :varpack} (:e e))]
              [nm e])))

(defn- elementwise
  "The scopes over `scope` binding each pack of `packs` to its i-th element, for each i."
  [scope packs]
  (let [ns (distinct (map (fn [[_ e]] (count (or (:elems e) (:ids e)))) packs))]
    (when (> (count ns) 1) (fail :pack "packs of different lengths in one expansion"))
    (for [i (range (or (first ns) 0))]
      (let [s (new-scope :tparams scope :internal (:internal scope) :cls (:cls scope))]
        (doseq [[nm e] packs]
          (enter! s nm (if (= :varpack (:e e)) {:e :var :id (nth (:ids e) i) :pos -1} (arg-entity {:kind (:kind e)} (nth (:elems e) i)))))
        s))))

(defn expand-type-pack
  "The :pack-expand hook: the types a pack expansion's pattern (Ts&... in a parameter list or argument list) stands
  for, one per element of its packs; in a template's signature, the pattern as {:k :pack-exp}."
  [scope X]
  (let [names (distinct (map #(if (namespace %) (first (str/split (namespace %) #"/")) (name %)) (form-symbols X)))
        packs (packs-named scope names)]
    (if (seq packs)
      (mapv #(sema/resolve-type-form % X) (elementwise scope packs))
      (let [t (sema/resolve-type-form scope X)]
        (if (dependent? t) [{:k :pack-exp :of t}] (fail :pack "a pack expansion without a pack"))))))

(defn expand-expr-pack
  "The :expand-pack hook: a PackExpansionExpr's pattern analyzed once per element of the packs its text names."
  [ctx n]
  (let [pat (first (kids n))
        names (distinct (re-seq #"[A-Za-z_][A-Za-z_0-9]*" (or (node-text pat) "")))
        packs (packs-named (:scope ctx) names)]
    (when (empty? packs) (fail :pack "a pack expansion without a pack"))
    (mapv #(sema/analyze (assoc ctx :scope %) pat) (elementwise (:scope ctx) packs))))

(defn- resolve-args
  "Template argument forms for the template `t`: each resolved for its parameter, pack expansions spliced, the
  arguments of a trailing parameter pack gathered into {:pack [...]} (always with `group-all`, else when given)."
  [scope t forms group-all]
  (let [ps (:params t)
        np (count ps)
        pack? (and (pos? np) (:pack (last ps)))
        param (fn [i] (nth ps (min i (dec np)) nil))
        args (loop [fs forms out []]
               (if (seq fs)
                 (let [f (first fs)
                       p (or (param (count out)) (fail :template "too many template arguments for " (:name t)))
                       xs (if (and (seq? f) (= 'pack-expand (first f)))
                            (if (= :type (:kind p))
                              (expand-type-pack scope (second f))
                              (let [packs (packs-named scope [(name (second f))])]
                                (if (seq packs) (vec (:elems (second (first packs))))
                                  ;; (CP338 (a): the parameter's type in the template's own scope, as resolve-arg's: IT's
                                  ;; `template<sz... I>` named from another namespace, std::_Index_tuple<_Ind...> of std::thread)
                                  [(value-arg (const-form scope (second f)) nil
                                              (param-type (let [i (min (count out) (dec np))]
                                                            (or (try (bind-scope (:scope t) (subvec ps 0 i) (subvec out 0 i) nil)
                                                                     (catch arbace.lang.ExceptionInfo _ nil))
                                                                scope))
                                                          p))])))
                            ;; a non-type parameter's type may name the parameters before it (template <class T, T v>)
                            [(resolve-arg scope p f (let [i (min (count out) (dec np))]
                                                      (try (bind-scope (:scope t) (subvec ps 0 i) (subvec out 0 i) nil)
                                                           (catch arbace.lang.ExceptionInfo _ nil))))])]
                   (recur (rest fs) (into out xs)))
                 out))]
    (when (and (not pack?) (> (count args) np)) (fail :template "too many template arguments for " (:name t)))
    (if (and pack? (or group-all (>= (count args) np)))
      (conj (vec (take (dec np) args)) {:pack (vec (drop (dec np) args))})
      args)))

;; ---------------------------------------------------------------------------------------------
;; Deduction ([temp.deduct.type]): P (a signature's type with the template's parameters) matched against A

(defn- tparam-of? [x tid] (and (map? x) (= tid (:tid x)) (#{:tparam :tparam-v :ttp} (:k x))))

;; Qualifiers: an array's are its elements' ([basic.type.qualifier]/3), as clang's getUnqualifiedArrayType sees them
(defn- arr-cv [t] (if (abi/arr? t) (arr-cv (:of t)) t))
(defn- quals [t] (let [t (arr-cv t)] (cond-> #{} (:c t) (conj :c) (:v t) (conj :v))))
(defn- unq-array [t] (if (abi/arr? t) (assoc (abi/unq t) :of (unq-array (:of t))) (abi/unq t)))
(defn- with-quals [t qs]
  (if (abi/arr? t) (assoc t :of (with-quals (:of t) qs)) (cond-> (abi/unq t) (qs :c) (assoc :c true) (qs :v) (assoc :v true))))
(defn- inconsistent-or-superset?
  "hasInconsistentOrSupersetQualifiersOf: P has a qualifier A lacks."
  [P A] (not (every? (quals A) (quals P))))

(defn- canonical [t]
  (cond (and (map? t) (#{:tparam :tparam-v} (:k t))) (select-keys t [:k :i :c :v])
                (map? t) (into {} (map (fn [[k v]] [k (canonical v)]) t))
        (vector? t) (mapv canonical t)
        :else t))

(defn- unspelled
  "A type without its template-ids' spellings (:written, :qual): functionally equivalent signatures compare equal."
  [t]
  (cond (map? t) (into {} (map (fn [[k v]] [k (unspelled v)]) (dissoc t :written :qual)))
        (vector? t) (mapv unspelled t)
        :else t))

(declare deduce-by-type-match)
(def ^:dynamic *satisfaction* nil)
(def ^:dynamic *unstable* nil) ; cpp-s8: an atom set when a satisfaction asked about a class still being defined (not memoized)

;; CX12 (second slice, the checker: sema/checking?): a template's deduction that gives no candidate is the program's
;; error only for the reasons below, each sure ([temp.deduct.type]'s mismatches of a member function's qualifiers or a
;; member pointer's class, a call with fewer arguments than the parameters without defaults); `*unsure*` is set where the
;; slice, not the program, may be the cause (a type the port does not match, an argument it does not adjust), `*sure*`
;; where one of those reasons decided; a call no template gave a candidate for is diagnosed only when every template
;; failed surely
(def ^:dynamic *unsure* nil)
(def ^:dynamic *sure* nil)
(defn- unsure! [] (when-let [u *unsure*] (reset! u true)) false)
(defn- sure! [] (when-let [u *sure*] (reset! u true)) false)

(defn- bind-arg!
  "checkDeducedTemplateArguments: the parameter i deduced as `a`, consistent with an earlier deduction."
  [b i a]
  (let [old (get @b i)]
    (if (some? old) (same-arg? old a) (do (swap! b assoc i a) true))))

(defn- subst-value
  "A dependent value with the parameters of `tid` the bindings give substituted (an operator over numbers folded)."
  [x b tid]
  (cond
    (and (map? x) (= :tparam-v (:k x)) (= tid (:tid x))) (let [a (get b (:i x))] (cond (nil? a) x (contains? a :val) (:val a) :else a))
    (and (map? x) (= :texpr (:k x)) (:args x) (not= :sr (:o x)) (not= "cast" (:o x)))
    (let [args (mapv #(subst-value % b tid) (:args x))]
      (if (every? number? args) (let [v (fold (:o x) args)] (if (u64? v) (lng v) v)) (assoc x :args args)))
    :else x))

(defn- dependent-on? [x tid] (some #(and (map? %) (#{:tparam :tparam-v :ttp} (:k %)) (= tid (:tid %))) (tree-seq coll? seq x)))

(declare match-args)

(defn- match-arg
  "One template argument of a signature (or a partial specialization's pattern) against an argument: a parameter
  bound, a value compared, a non-deduced expression checked, a pack matched element-wise, a type deduced."
  [b tid p a]
  (cond
    ;; (a cv-qualified parameter, `const T` of allocator<const T>, is matched by type: [temp.deduct.type]/8; G4)
    (and (tparam-of? p tid) (not (:c p)) (not (:v p))) (bind-arg! b (:i p) a)
    (and (map? p) (contains? p :val)) (= (:val p) (:val a))
    ;; a non-deduced expression (HoldInt<-N>): consistent with what the others deduced
    (= :texpr (:k p)) (let [v (subst-value p @b tid)]
                        (or (dependent-on? v tid) (same-arg? (if (number? v) {:val v} v) a)))
    (and (map? p) (contains? p :pack) (not (:k p))) (and (map? a) (contains? a :pack) (not (:k a)) (match-args b tid (:pack p) (:pack a)))
    :else (deduce-by-type-match b tid p a #{} :none)))

(defn- pack-pattern?
  "A trailing pack expansion of an argument list: a parameter pack of tid, or {:k :pack-exp}."
  [p tid]
  (and (map? p) (or (and (:pack p) (#{:tparam :tparam-v} (:k p)) (= tid (:tid p))) (= :pack-exp (:k p)))))

(defn match-args
  "Argument lists matched ([temp.deduct.type]/9-10): a trailing pack expansion takes the remaining arguments, each
  pack it names bound to the elements deduced from them."
  [b tid ps as]
  (let [ps (vec ps) as (vec as) lastp (peek ps)]
    (if (and lastp (pack-pattern? lastp tid))
      (let [n (dec (count ps))]
        (and (>= (count as) n)
             (every? true? (map #(match-arg b tid %1 %2) (subvec ps 0 n) (subvec as 0 n)))
             (if (= :pack-exp (:k lastp))
               (let [pat (:of lastp)
                     packs (distinct (keep #(when (and (map? %) (:pack %) (= tid (:tid %))) (:i %)) (tree-seq coll? seq pat)))
                     elems (for [a (subvec as n)] (let [b2 (atom (apply dissoc @b packs))] (when (match-arg b2 tid pat a) @b2)))]
                 (and (every? some? elems)
                      (every? true? (for [i packs] (bind-arg! b i {:pack (mapv #(get % i) elems)})))))
               (bind-arg! b (:i lastp) {:pack (subvec as n)}))))
      (and (= (count ps) (count as)) (every? true? (map #(match-arg b tid %1 %2) ps as))))))

(defn- deduce-template-spec
  "DeduceTemplateSpecArguments: P a template-id of the template, A a class; the arguments matched pairwise
  (TDF_None), and with :derived-class, failing that, A's bases searched (DeduceTemplateBases, [temp.deduct.call]/4.3:
  the deduction must be unique)."
  [b tid P A tdf]
  (let [one (fn [A]
              ;; A a class, or (in partial ordering) another signature's template-id
              (let [c (if (= :tspec (:k A)) {:tmpl (:tmpl A) :targs (:args A)} (abi/cls (:id A))) snap @b
                    ;; P's template a template template parameter of tid: deduced as A's template
                    ttp-ok (if-let [tt (:ttp P)]
                             (and (= tid (:tid tt)) (:tmpl c) (bind-arg! b (:i tt) (let [t (tmpl (:tmpl c))] {:tmpl (:tmpl c) :name (:name t) :path (:path t)})))
                             (= (:tmpl c) (:tmpl P)))]
                (if (and ttp-ok (match-args b tid (:args P) (:targs c)))
                  true
                  (do (reset! b snap) false))))]
    (and (or (abi/class? A) (= :tspec (:k A)))
         (or (one A)
             (and (tdf :derived-class) (abi/class? A)
                  (let [snap @b
                        found (loop [todo (map :cls (:bases (abi/cls (:id A)))) seen #{} hits []]
                                (if-let [c (first todo)]
                                  (if (seen c)
                                    (recur (rest todo) seen hits)
                                    (do (reset! b snap)
                                        (if (one {:k :class :id c})
                                          (recur (rest todo) (conj seen c) (conj hits [c @b]))
                                          (recur (concat (rest todo) (map :cls (:bases (abi/cls c)))) (conj seen c) hits))))
                                  hits))]
                    (reset! b snap)
                    (when (= 1 (count (distinct (map second found))))
                      (reset! b (second (first found)))
                      true)))))))

(defn deduce-by-type-match
  "DeduceTemplateArgumentsByTypeMatch (SemaTemplateDeduction.cpp at llvmorg-23.1.4), ported for the types of the
  slice: P (a type with the parameters of the template `tid`) matched against A, the deductions bound in the atom `b`
  ({index argument}); true on success. `tdf` the deduction flags (#{:skip-non-dependent :param-with-reference
  :ignore-qualifiers :derived-class}), `pok` :call while partially ordering a call's parameters ([temp.deduct.partial]
  /5-/9), else :none."
  [b tid P A tdf pok]
  (let [[P A ok tdf]
        (if (= pok :call)
          ;; [temp.deduct.partial]/5: references replaced by their referred types; /9: of two references to the same
          ;; type, an lvalue reference's or a more cv-qualified one's argument is not as specialized
          (let [pr (abi/ref? P) ar (abi/ref? A)
                P (abi/non-ref P) A (abi/non-ref A)
                ;; the same type as clang's canonical types compare: a parameter by its depth and index
                bad (and pr ar (= (canonical (unq-array P)) (canonical (unq-array A)))
                         (or (and (= :ref pr) (not= :ref ar))
                             (and (every? (quals P) (quals A)) (not= (quals P) (quals A)))))]
            ;; /7: the top-level cv-qualifiers removed
            [(unq-array P) (unq-array A) (not bad) tdf])
          [(if (tdf :param-with-reference) (with-quals (unq-array P) (set (filter (quals A) (quals P)))) P) A true tdf])]
    (cond
      (not ok) false
      ;; T, cv-list T
      (and (= :tparam (:k P)) (= tid (:tid P)))
      (when (or (tdf :ignore-qualifiers) (not (inconsistent-or-superset? P A)))
        (when-not (and (abi/fn? A) (seq (quals P)))
          ;; the parameter's qualifiers removed from the deduced type
          (bind-arg! b (:i P) (with-quals (unq-array A) (set (remove (quals P) (quals A)))))))
      :else
      (let [qual-ok (or (tdf :ignore-qualifiers)
                        (if (tdf :param-with-reference)
                          (not (inconsistent-or-superset? P A))
                          (= (quals P) (quals A))))]
        (cond
          (not qual-ok) false
          (not (dependent? P)) (or (boolean (tdf :skip-non-dependent))
                                   (if (tdf :ignore-qualifiers) (= (unq-array P) (unq-array A)) (= P A))
                                   ;; (CX12, the checker: two function types that differ in a member function's qualifiers
                                   ;; alone, a sure mismatch)
                                   (and (sema/checking?) (abi/fn? P) (abi/fn? A)
                                        (= (dissoc P :cq :vq :refq) (dissoc A :cq :vq :refq)) (sure!)))
          :else
          (let [down (if (= pok :call) :none pok)]
            (case (:k P)
              :ptr (and (abi/ptr? A) (deduce-by-type-match b tid (:to P) (:to A) (set (filter #{:ignore-qualifiers :derived-class} tdf)) down))
              :ref (and (= :ref (:k A)) (deduce-by-type-match b tid (:to P) (:to A) #{} down))
              :rref (and (= :rref (:k A)) (deduce-by-type-match b tid (:to P) (:to A) #{} down))
              :arr (and (abi/arr? A)
                        (deduce-by-type-match b tid (:of P) (:of A) (set (filter #{:ignore-qualifiers} tdf)) down)
                        (let [n (:n P)]
                          ;; a dependent bound: the array's size deduces the non-type parameter (DeducedFromArrayBound)
                          (if (and (map? n) (= :tparam-v (:k n)) (= tid (:tid n)))
                            (bind-arg! b (:i n) {:val (:n A) :bound true})
                            (= n (:n A)))))
              ;; (CX12, the checker) MemberPointer: the pointee, then the class ([temp.deduct.type]/8, T::*)
              :mptr (if (sema/checking?)
                      (and (abi/mptr? A)
                           (deduce-by-type-match b tid (:to P) (:to A) (set (filter #{:ignore-qualifiers} tdf)) down)
                           (let [c (:cls P)]
                             (cond (and (map? c) (= :tparam (:k c)) (= tid (:tid c))) (bind-arg! b (:i c) {:k :class :id (:cls A)})
                                   (map? c) (unsure!)
                                   (= c (:cls A)) true
                                   :else (sure!))))
                      false)
              :fn (and (abi/fn? A) (= (boolean (:va P)) (boolean (:va A)))
                       ;; (CX12, the checker: a member function's qualifiers match exactly, FunctionProto's getMethodQuals)
                       (or (not (sema/checking?)) (and (= (boolean (:cq P)) (boolean (:cq A))) (= (boolean (:vq P)) (boolean (:vq A)))) (sure!))
                       (deduce-by-type-match b tid (:ret P) (:ret A) #{} down)
                       (if (= :pack-exp (:k (peek (vec (:ps P)))))
                         (match-args b tid (:ps P) (:ps A)) ; R(Args...): the trailing pack takes the rest
                         (and (= (count (:ps P)) (count (:ps A)))
                              (every? true? (map #(deduce-by-type-match b tid %1 %2 #{} pok) (:ps P) (:ps A))))))
              :tspec (deduce-template-spec b tid P A tdf)
              ;; T::name: a non-deduced context ([temp.deduct.type]/5.1)
              :tdep true
              :texpr true ; an expression: non-deduced ([temp.deduct.type]/5.3)
              ;; a pack expansion's pattern against the type (partial ordering, [temp.deduct.partial]/8)
              :pack-exp (deduce-by-type-match b tid (:of P) (if (= :pack-exp (:k A)) (:of A) A) tdf down)
              :tparam true ; another template's parameter at another depth: skipped
              (unsure!))))))))

(defn- deduce-type "TDF_None outside partial ordering." [b tid P A] (deduce-by-type-match b tid P A #{} :none))

(defn- sym-scope [t] (bind-scope (:scope t) (:params t) nil (:id t)))

(defn sym-sig
  "A function template's signature with its own parameters (the type its specializations are mangled with)."
  [t]
  (or (:sig t)
      ;; (a signature whose decltype calls the template itself, `-> decltype(__niter_base(...))`: refused inside, G4)
      (do (when (:sig-pending (tmpl (:id t))) (fail :template "a signature that names its own template " (:name t)))
          (upd-tmpl! (:id t) assoc :sig-pending true)
          (let [s (try (sema/resolve-type (sym-scope t) (get-in (:pattern t) [:type :qualType]))
                       (finally (upd-tmpl! (:id t) dissoc :sig-pending)))
                s (dissoc s :cq)]
            (upd-tmpl! (:id t) assoc :sig s)
            s))))

(defn- finish-deduction
  "The bindings as the template's argument list: the deduced bound of an array ({:bound}) typed by its parameter,
  defaults for the rest; nil when a parameter stays undeduced."
  [t b]
  (let [ps (:params t)
        n (count ps)
        ;; a trailing pack nothing deduced is empty ([temp.arg.explicit]/4)
        b (reduce (fn [b i] (if (and (:pack (nth ps i)) (not (contains? b i))) (assoc b i {:pack []}) b)) b (range n))
        ;; (cpp-s3: a parameter that is not deduced takes its default argument also before deduced ones, [temp.deduct]/5:
        ;; `template<bool _AtomicRef = false, typename _Tp> bool compare_exchange_weak(_Tp* ...)`, std::atomic<double>)
        later? (fn [i] (some #(contains? b %) (range (inc i) n)))
        given (loop [i 0 out []]
                (cond
                  (= i n) out
                  (contains? b i)
                  (let [a (get b i)
                        a (if (:bound a) (value-arg (:val a) (:name (nth ps i)) (param-type (sym-scope t) (nth ps i))) a)]
                    (recur (inc i) (conj out a)))
                  (and (:default (nth ps i)) (not (:pack (nth ps i))) (later? i))
                  (if-let [as (complete-args (assoc t :params (subvec (vec ps) 0 (inc i))) out)]
                    (recur (inc i) as)
                    out)
                  :else out))]
    (when (every? #(or (contains? b %) (:default (nth ps %))) (range (count given)))
      (when (= (count (filter #(contains? b %) (range (count given)))) (count (filter #(contains? b %) (range n))))
        (complete-args t given)))))

(defn- explicit-args
  "The explicit template arguments written after a name (`f<int, 3>`), resolved for the template `t` in `scope`."
  [t ^String text scope]
  (when text
    (let [f (ct/parse-name (str/trim text))
          f (if (and (seq? f) (= 'cpp/scope (first f))) (last f) f)
          forms (when (and (seq? f) (= '<> (first f))) (nnext f))]
      (resolve-args scope t forms false))))

(defn- forwarding-reference?
  "isForwardingReference: an rvalue reference to a cv-unqualified parameter of the template itself."
  [P tid]
  (and (= :rref (:k P)) (= :tparam (:k (:to P))) (= tid (:tid (:to P))) (empty? (quals (:to P)))))

(defn- simple-template-id? [t] (= :tspec (:k (abi/unq t))))

(defn- adjust-for-deduction
  "AdjustFunctionParmAndArgTypesForDeduction ([temp.deduct.call]/2-/4), ported: [P A tdf] for the parameter type P
  and the argument expression `e`, or nil."
  [P e tid]
  (let [;; (an expression's type is never a reference, [expr.type]/1: a call of a function whose return type a decltype
        ;; makes a reference, std::declval<T>(), carried T&& as its type, and _Tp deduced from it was T&&, so that
        ;; std::pair's C++17 default constructor's condition, __helper<const _Tp&>({}), bound int& to {}; cpp-route)
        A (some-> (:ty e) abi/non-ref)
        P (abi/unq P)
        pref (when (abi/ref? P) P)
        P (if pref (:to P) P)]
    (when-not (or (= :fnset (:op e)) (= :init-list (:op e)) (nil? A))
      (let [A (if pref
                (if (and (forwarding-reference? pref tid) (= :lv (:cat e))) (abi/lref A) A)
                (cond (abi/arr? A) (abi/ptr (:of A))
                      (abi/fn? A) (abi/ptr A)
                      :else (unq-array A)))
            tdf (cond-> #{:skip-non-dependent}
                  pref (conj :param-with-reference)
                  (abi/ptr? A) (conj :ignore-qualifiers)
                  (or (simple-template-id? P) (and (abi/ptr? P) (simple-template-id? (:to P)))) (conj :derived-class))]
        [P A tdf]))))

(defn- tparams-in [P tid]
  (distinct (keep #(when (and (map? %) (#{:tparam :tparam-v :ttp} (:k %)) (= tid (:tid %))) (:i %)) (tree-seq coll? seq P))))

(defn- deducible-tparams
  "cpp-s4: the template parameters of `tid` that `P` names outside non-deduced contexts (a dependent member type's
  qualifier, X<T>::type)."
  [P tid]
  (distinct ((fn walk [x]
               (cond (and (map? x) (= :tdep (:k x))) []
                     (and (map? x) (#{:tparam :tparam-v :ttp} (:k x)) (= tid (:tid x))) (cons (:i x) (mapcat walk (vals x)))
                     (map? x) (mapcat walk (vals x))
                     (coll? x) (mapcat walk x)
                     :else []))
             P)))

(defn deduce-call
  "DeduceTemplateArguments for a call ([temp.deduct.call]): the template arguments of the function template `t` for
  the call's typed arguments after the explicit ones, each parameter's P and A adjusted (adjust-for-deduction) and
  matched (deduce-by-type-match); nil when deduction fails."
  [t explicit args]
  (let [sig (sym-sig t)
        all (:ps sig)
        pk (when (= :pack-exp (:k (last all))) (last all))
        ps (if pk (vec (butlast all)) all)
        tid (:id t)
        explicit-b (into {} (map-indexed vector explicit))
        b (atom explicit-b)
        ;; (CX12, the checker) the template parameters of parameters that are non-deduced contexts by the program's own
        ;; argument ([temp.deduct.call]/1: a braced list for a P that is no initializer_list nor array; /6: an overload
        ;; set of two or more functions for a P that any of them would deduce): left undeduced, a sure failure
        ;; when no other parameter names them (bare-tparam: P a template parameter of tid alone, cv and references
        ;; removed)
        nondeduced (atom #{})
        bare-tparam (fn [P] (let [q (abi/unq (abi/non-ref (abi/unq P)))] (when (and (= :tparam (:k q)) (= tid (:tid q)) (not (:pack q))) (:i q))))]
    (when (or (<= (count args) (count ps)) (:va sig) pk)
      (when (every? true?
                    (for [[P e] (map vector ps args)
                          ;; a parameter whose template parameters were all given explicitly has them substituted
                          ;; ([temp.deduct]/2-/3): nothing left to deduce, overload resolution checks the argument
                          :when (and (dependent? P) (not (every? (set (keys explicit-b)) (tparams-in P tid))))
                          ;; (cpp-s4: a parameter whose template parameters are all in non-deduced contexts, a nested-name-
                          ;; specifier's, takes no part, [temp.deduct.type]/5.1, clang's hasDeducibleTemplateParameters:
                          ;; std::format's `format_string<_Args...>`, basic_format_string<char, type_identity_t<_Args>...>)
                          :when (seq (deducible-tparams P tid))
                          ;; an overload set holding a function template: a non-deduced context ([temp.deduct.call]/6;
                          ;; G5: std::endl given to a stream's operator<< templates)
                          :when (not (and (= :fnset (:op e)) (seq (:tmpls e))))]
                      (if-let [[P A tdf] (when-not (and (sema/checking?) (= :mptr-fnset (:op e))) (adjust-for-deduction P e tid))]
                        (deduce-by-type-match b tid P A tdf :none)
                        (cond
                          ;; (CX12, the checker) [temp.deduct.call]/6.2: an overload set of member functions tried
                          ;; member by member, the one that deduces used, none or several a non-deduced context
                          (and (sema/checking?) (= :mptr-fnset (:op e)))
                          (let [snap @b
                                oks (keep (fn [fid] (reset! b snap)
                                            (when-let [[P A tdf] (adjust-for-deduction P (sema/mptr-fn-node fid) tid)]
                                              (when (deduce-by-type-match b tid P A tdf :none) @b)))
                                          (:fns e))]
                            (reset! b (if (= 1 (count oks)) (first oks) snap))
                            true)
                          ;; (CX12, the checker: the non-deduced contexts above)
                          (and (sema/checking?) (bare-tparam P)
                               (or (= :init-list (:op e))
                                   (and (= :fnset (:op e)) (empty? (:tmpls e)) (not (:obj e)) (>= (count (distinct (map #(:ty (sema/fnd %)) (:fns e)))) 2))))
                          (do (swap! nondeduced conj (bare-tparam P)) true)
                          :else (unsure!)))))
        ;; a trailing function parameter pack: its pattern deduced from each remaining argument, each pack the
        ;; elements so deduced ([temp.deduct.call]/1)
        (when (or (nil? pk)
                  (let [packs (distinct (keep #(when (and (map? %) (:pack %) (= tid (:tid %))) (:i %)) (tree-seq coll? seq (:of pk))))
                        rest-args (drop (count ps) args)
                        elems (for [e rest-args]
                                (let [b2 (atom (apply dissoc @b packs))]
                                  (when-let [[P A tdf] (adjust-for-deduction (:of pk) e tid)]
                                    (when (deduce-by-type-match b2 tid P A tdf :none) @b2))))]
                    (when (every? some? elems)
                      (doseq [i packs :when (not (contains? @b i))] (swap! b assoc i {:pack (mapv #(get % i) elems)}))
                      true)))
          (let [r (finish-deduction t @b)]
            (when (and (nil? r) (seq @nondeduced))
              (let [named-elsewhere (fn [i] (some (fn [P] (and (not= i (bare-tparam P)) (some #{i} (tparams-in P tid)))) all))
                    ps-t (:params t)]
                (when (some (fn [i] (and (not (contains? @b i)) (< (long i) (count ps-t))
                                         (not (:default (nth ps-t i))) (not (:pack (nth ps-t i)))
                                         (not (named-elsewhere i))
                                         (= 1 (count (filter #(= i (bare-tparam %)) all)))))
                            @nondeduced)
                  (sure!))))
            r))))))

(declare instantiate-fn)

(defn fnaddr-specs
  "The specializations of an overload set's function templates whose types match the function type `ft` the set's address
  is taken for ([over.over]/2, [temp.deduct.funcaddr]: each template's function type deduced against `ft`; G5: std::endl
  given to operator<<)."
  [e ft]
  (vec (for [tid (:tmpls e)
             :let [t (tmpl tid)
                   fid (try (let [sig (sym-sig t)
                                  b (atom {})]
                              (when (and (= (count (:ps sig)) (count (:ps ft)))
                                         (every? true? (map (fn [P A] (deduce-by-type-match b tid P A #{} :none)) (cons (:ret sig) (:ps sig)) (cons (:ret ft) (:ps ft)))))
                                (when-let [a (finish-deduction t @b)] (instantiate-fn tid a))))
                            (catch arbace.lang.ExceptionInfo _ nil))]
             :when fid]
         fid)))

;; ---------------------------------------------------------------------------------------------
;; Partial ordering ([temp.func.order], [temp.deduct.partial])

(defn- at-least-as-specialized?
  "isAtLeastAsSpecializedAs for a call: the template tid2's parameters deduced from tid1's, pair by pair, with
  TDF_None in the partial ordering of a call (the references' and qualifiers' rules inside the match)."
  [tid2 p2s p1s]
  (let [b (atom {})]
    ;; (cpp-s4: a function parameter pack's pattern against each parameter it stands for, [temp.deduct.partial]/8 and /11:
    ;; deduced apart; a pack against a non-pack fails -- any's `_S_create(_Storage&, _Up&&)` over its
    ;; `_S_create(_Storage&, _Args&&...)`)
    (every? true? (map (fn [p2 p1]
                         (let [pk2 (= :pack-exp (:k p2)) pk1 (= :pack-exp (:k p1))]
                           (cond (and pk1 (not pk2)) false
                                 (and pk2 pk1) (deduce-by-type-match (atom @b) tid2 (:of p2) (:of p1) #{} :call)
                                 pk2 (deduce-by-type-match (atom @b) tid2 (:of p2) p1 #{} :call)
                                 :else (deduce-by-type-match b tid2 p2 p1 #{} :call))))
                       p2s p1s))))

(declare concept-of)

;; ---------------------------------------------------------------------------------------------
;; CP300 (a): constraints' normal forms and their partial ordering ([temp.constr.normal], [temp.constr.order]; clang's
;; SemaConcept.cpp at llvmorg-23.1.5: NormalizedConstraint, IsAtLeastAsConstrained, subsumes over the DNF and CNF)

(defn- concept-ref
  "The concept a constraint's node names (a concept-id, `C<A...>`) with its arguments resolved in `scope`: [concept args],
  or nil (not a concept-id, or arguments the slice cannot resolve)."
  [scope n]
  (when (= "DeclRefExpr" (:kind n))
    (let [nm (get-in n [:referencedDecl :name])
          ;; (cpp-s8: a qualified concept-id, `__detail::__has_member_element_type<_Tp>` in a requires-clause, looked up
          ;; by its qualifier: before, an atom of its own, so no partial specialization subsumed another through it)
          [_ q] (#'sema/ref-qualifier n)
          es (when (string? nm) (try (if (seq q) (sema/lookup-qualified scope (conj (vec q) nm)) (sema/lookup scope nm))
                                     (catch arbace.lang.ExceptionInfo _ nil)))
          e (first (filter #(and (= :tmpl (:e %)) (= :concept (:tk %))) es))]
      (when e
        (let [c (tmpl (:id e))
              args (try (complete-args c (or (explicit-args c (sema/written-targs n (:name c)) scope) []))
                        (catch arbace.lang.ExceptionInfo _ nil))]
          (when (and args (not-any? #(and (map? %) (contains? % :pack)) args)) [c args]))))))

(defn- normal-form
  "The normal form of the constraint expression `n` in `scope` ([temp.constr.normal]/1): [:and P Q], [:or P Q], or an atomic
  constraint [:atom KEY], a concept-id replaced by its concept's constraint-expression normalized with the parameter mapping
  of its arguments; KEY the atom's expression (its position: the same expression of the same concept's definition) and
  its mapping (the arguments, each template's own parameters by their index, canonical), so that two declarations' atoms
  are identical only through a concept ([temp.constr.atomic]/2)."
  [scope n mapping depth]
  (let [k (:kind n)]
    (cond
      (> (long depth) 16) [:atom [:deep (System/identityHashCode n)]]
      (#{"ParenExpr" "ExprWithCleanups"} k) (normal-form scope (first (kids n)) mapping depth)
      (and (= "BinaryOperator" k) (#{"&&" "||"} (:opcode n)))
      [(if (= "&&" (:opcode n)) :and :or) (normal-form scope (first (kids n)) mapping depth) (normal-form scope (second (kids n)) mapping depth)]
      :else
      (if-let [[c args] (concept-ref scope n)]
        (normal-form (bind-scope (:scope c) (:params c) args nil) (:expr c) (canonical args) (inc (long depth)))
        [:atom [(get-in n [:range :begin :file]) (get-in n [:range :begin :offset]) (:_b n) mapping]]))))

(defn- associated-constraints
  "A function template's associated constraints ([temp.constr.decl]/3) as one normal form or nil: its type-constraints'
  immediately-declared constraints in order, its requires-clause, its trailing requires-clause, conjoined."
  [t]
  (let [ss (sym-scope t)
        tcs (for [[i p] (map-indexed vector (:params t))
                  :when (and (:tc p) (not (:tc-args p)) (not (:pack p)))
                  :let [c (concept-of t p)]
                  :when c]
              (normal-form (bind-scope (:scope c) (:params c) [(:ty (first (sema/lookup ss (:name p))))] nil) (:expr c)
                           (canonical [(:ty (first (sema/lookup ss (:name p))))]) 1))
        rc (when-let [x (:constraint t)] (normal-form ss x nil 0))
        trc (when-let [x (:trailingRequiresClause (:pattern t))] (normal-form ss x nil 0))
        parts (remove nil? (concat tcs [rc trc]))]
    (when (seq parts) (reduce (fn [a b] [:and a b]) parts))))

(defn- dnf [f]
  (case (first f)
    :atom [#{(second f)}]
    :or (into (dnf (nth f 1)) (dnf (nth f 2)))
    :and (vec (for [a (dnf (nth f 1)) b (dnf (nth f 2))] (into a b)))))

(defn- cnf [f]
  (case (first f)
    :atom [#{(second f)}]
    :and (into (cnf (nth f 1)) (cnf (nth f 2)))
    :or (vec (for [a (cnf (nth f 1)) b (cnf (nth f 2))] (into a b)))))

(defn- subsumes?
  "[temp.constr.order]/1: P subsumes Q when every disjunctive clause of P's disjunctive normal form subsumes every
  conjunctive clause of Q's conjunctive normal form, a clause subsuming another when an atom of the one is identical to
  one of the other (clang's subsumes; a form of more than 64 clauses is not ordered)."
  [P Q]
  (let [dp (dnf P) cq (cnf Q)]
    (and (<= (count dp) 64) (<= (count cq) 64)
         (every? (fn [pi] (every? (fn [qj] (some #(contains? qj %) pi)) cq)) dp))))

(defn more-constrained-fn?
  "[temp.func.order]/6.2.2, [temp.constr.order]/2: the function template tid1's associated constraints subsume tid2's
  and not the reverse (no constraints are subsumed by any)."
  [tid1 tid2]
  (let [p (try (associated-constraints (tmpl tid1)) (catch arbace.lang.ExceptionInfo _ ::unknown))
        q (try (associated-constraints (tmpl tid2)) (catch arbace.lang.ExceptionInfo _ ::unknown))]
    (when (System/getenv "CPP_CONSTRAINT_TRACE") (binding [*out* *err*] (println "more-constrained" tid1 tid2 (pr-str p) (pr-str q))))
    (cond
      (or (= ::unknown p) (= ::unknown q)) false
      (nil? p) false
      (nil? q) true
      :else (and (subsumes? p q) (not (subsumes? q p))))))

(defn more-specialized-fn?
  "getMoreSpecialized for a call with `n` arguments: tid1 at least as specialized as tid2 and not the reverse."
  [tid1 tid2 n]
  (let [;; (cpp-s4: a trailing function parameter pack stands for each argument it takes)
        upto (fn [ps] (let [v (vec ps)]
                        (take n (if (= :pack-exp (:k (peek v))) (concat (pop v) (repeat (peek v))) v))))
        s1 (upto (:ps (sym-sig (tmpl tid1)))) s2 (upto (:ps (sym-sig (tmpl tid2))))]
    (let [a (at-least-as-specialized? tid2 s2 s1) b (at-least-as-specialized? tid1 s1 s2)
          variadic? (fn [tid] (some #(= :pack-exp (:k %)) (:ps (sym-sig (tmpl tid)))))]
      (or (and a (not b))
          ;; [temp.func.order]/5 (after [temp.deduct.partial]/11): of two otherwise equal, the one without a trailing pack
          (and a b (variadic? tid2) (not (variadic? tid1)))
          ;; CP300 (a), [temp.func.order]/6: of two otherwise equal with equivalent template parameter lists, the more
          ;; constrained
          (and a b (= (boolean (variadic? tid1)) (boolean (variadic? tid2)))
               (= (map (juxt :kind :pack) (:params (tmpl tid1))) (map (juxt :kind :pack) (:params (tmpl tid2))))
               (more-constrained-fn? tid1 tid2))))))

(defn tiebreak
  "[over.match.best]/2.4-2.5 for two candidates no argument ranks apart: a non-template function over a template's
  specialization; of two specializations, the more specialized template's."
  [fa fb & [nargs]]
  (let [a (sema/fnd fa) b (sema/fnd fb) ta (:tinst a) tb (:tinst b)
        ;; CP311 (a), [over.match.best]/2.9-2.11 for two guides of class template argument deduction: one from a
        ;; deduction-guide over one not, the copy deduction candidate over another, one from a non-template constructor
        ;; over one from a constructor template
        guide-better (fn [] (let [ka (:guide a) kb (:guide b)
                                  n (or nargs (count (:ps (:ty a))))
                                  same-ps (= (map abi/unq (take n (:ps (:ty a)))) (map abi/unq (take n (:ps (:ty b)))))]
                              (boolean (and ka kb
                                            (cond ;; (CP323 (a), C++23's [over.match.best.general]/2.10 (P2582R1): one not from
                                                  ;; inherited constructors over one that is, the parameters the same)
                                                  (and (not (:inherited a)) (:inherited b) same-ps) true
                                                  (and (:inherited a) (not (:inherited b)) same-ps) false
                                                  (and (= :user ka) (not= :user kb)) true
                                                  (or (= :user kb) (= :user ka)) false
                                                  (and (= :copy ka) (not= :copy kb)) true
                                                  (= :copy kb) false
                                                  :else (and (= :ctor ka) (= :ctor-tmpl kb)))))))]
    (cond
      (and (not ta) tb) true
      ;; the parameters compared are those the call has arguments for ([temp.deduct.partial]/3)
      (and ta tb (not= (:tid ta) (:tid tb))) (let [n (or nargs (count (:ps (:ty a))))]
                                               (or (more-specialized-fn? (:tid ta) (:tid tb) n)
                                                   (and (:guide a) (:guide b) (not (more-specialized-fn? (:tid tb) (:tid ta) n)) (guide-better))))
      (and ta (not tb)) false
      :else (guide-better))))

;; ---------------------------------------------------------------------------------------------
;; Class templates: instantiation, explicit and partial specializations

(declare attach-ool! attach-one! instantiate-fn)

(declare name-pack-params!)

(defn- declare-instance!
  "The class of the template `t` for `args` from the pattern node `node` in a scope binding `params` to `bargs`
  (a partial specialization's or the primary's); `explicit?`: an explicit specialization (its members ordinary)."
  ([t args node params bargs explicit?] (declare-instance! t args node params bargs explicit? nil))
  ([t args node params bargs explicit? cid0]
  (let [tid (:id t)
        cid (or cid0 (next-id))
        ps (bind-scope (:scope t) params bargs nil)
        cs (new-scope :class ps :cls cid :path (conj (vec (:path ps)) [:cls cid]))
        first-fn (inc (long @sema/*ids*))
        ;; (CP365 (a): the argument classes not complete yet, declared only or still being defined)
        waits (set (for [a args :when (map? a) :let [u (abi/unq a)] :when (abi/class? u) :let [c (abi/cls (:id u))]
                         :when (or (not (:complete c)) (:defining c))]
                     (:id u)))]
    (swap! abi/*classes* assoc cid {:id cid :name (:name t) :path (:path ps) :scope cs :fields [] :bases [] :outer ps
                                    :union (= "union" (:tagUsed node)) :tmpl tid :targs args :header (sema/header-node? node)})
    (enter! ps (:name t) {:e :type :ty {:k :class :id cid} :pos -1})
    (upd-tmpl! tid assoc-in [:insts args] cid)
    (when-let [nm (System/getenv "CPP_INST_TRACE")]
      (when (= nm (:name t)) (binding [*out* *err*] (println "instance" (:name t) tid cid (pr-str args) (if cid0 "again" "") (System/identityHashCode *tmpls*) (count (:insts (tmpl tid))) (get-in (tmpl tid) [:insts args])))))
    (when (:completeDefinition node)
      ;; the bases dependent in the pattern, which unqualified lookup in the specialization does not search
      (when-not explicit?
        (let [ss (bind-scope (:scope t) params nil (next-id))]
          (abi/update-cls! cid assoc :dep-bases
                           (set (keep-indexed (fn [i bs] (when (try (dependent? (sema/resolve-type ss (get-in bs [:type :qualType])))
                                                                    (catch arbace.lang.ExceptionInfo _ true))
                                                           i))
                                              (:bases node))))))
      ;; (CP365 (a): an instance whose definition did not finish while one of its arguments was incomplete, a header's
      ;; declaration dropped or the refusal thrown: <format>'s _Arg_value<format_context> made inside basic_format_context's
      ;; definition, its member naming `_Context::char_type` before the context declares it. Provisional: made again in
      ;; place, the same class, once every such argument is complete (class-completed!); clang instantiates it only where
      ;; it must be complete, by then)
      ;; (cpp-s8: or that finished with a member declaration dropped, a nested class's among them: <format>'s
      ;; _Arg_value<_Context>'s anonymous union, whose `_CharT _M_c` dropped it whole, so _M_none and the rest were no
      ;; members)
      (let [drops0 (.get ^java.util.concurrent.atomic.AtomicLong sema/drop-count)]
      (try
        (binding [sema/*cutoff* Long/MAX_VALUE *instance* (when-not explicit? cid)]
          (sema/declare-node! ps (assoc (strip-tparam-kids node) :kind "CXXRecordDecl")))
        (finally
          (when (and (seq waits) (not explicit?) *provisional*
                     (or (not (:finished (abi/cls cid)))
                         (> (.get ^java.util.concurrent.atomic.AtomicLong sema/drop-count) drops0)))
            (when (System/getenv "CPP_TMPL_TRACE")
              (binding [*out* *err*] (println "provisional instance" (:name t) cid "waiting for" (mapv #(:name (abi/cls %)) waits))))
            (swap! *provisional* (fn [m] (-> (reduce (fn [m w] (update-in m [:waits w] (fnil conj #{}) cid)) m waits)
                                             (assoc-in [:remake cid] [t args node params bargs]))))))))
      ;; the members' definitions: instantiated when used ([temp.inst]/11), linkonce_odr as clang writes them
      (when-not explicit?
        (doseq [[id f] @sema/*fns* :when (and (>= (long id) first-fn) (= cid (:cls f)) (:body f) (not (:implicit f)))]
          (upd-fn! id assoc :lazy true :inline true)))
      ;; members whose parameter list expands a pack of the class (R call(A... a))
      (doseq [[id f] @sema/*fns* :when (and (>= (long id) first-fn) (= cid (:cls f)) (:node f) (not (:implicit f)))]
        (name-pack-params! id (:node f)))
      (when (identical? node (:pattern t)) (abi/update-cls! cid assoc :from-primary true) (attach-ool! tid cid)))
    {:k :class :id cid})))

(defn- class-completed!
  "CP365 (a): the class `id` complete; each provisional instance that waited for it and for no other incomplete class is
  made again in place (declare-instance! with its class id: the class's record, scope and members made afresh, the old
  members' functions left unlisted), its partial specialization's out-of-line members attached again, and the classes'
  layouts computed again on use (a class holding the instance had laid it out broken)."
  [id]
  (when-let [p *provisional*]
    (when (System/getenv "CPP_TMPL_TRACE") (binding [*out* *err*] (println "class completed" (:name (abi/cls id)) id (pr-str (get-in @p [:waits id])))))
    (when-let [cids (seq (get-in @p [:waits id]))]
      (swap! p update :waits dissoc id)
      (doseq [cid cids
              :let [still (some (fn [[w cs]] (and (contains? cs cid) (let [c (abi/cls w)] (or (not (:complete c)) (:defining c)))))
                                (:waits @p))]
              :when (not still)
              :let [[t0 args node params bargs] (get-in @p [:remake cid])]
              :when t0
              :let [t (tmpl (:id t0))]]
        (swap! p (fn [m] (-> m (update :remake dissoc cid)
                             (update :waits (fn [ws] (into {} (for [[w cs] ws :let [cs (disj cs cid)] :when (seq cs)] [w cs])))))))
        (when (System/getenv "CPP_TMPL_TRACE")
          (binding [*out* *err*] (println "provisional instance" (:name t) cid "made again")))
        (let [fp (abi/cls cid)]
          (declare-instance! t args node params bargs false cid)
          (when-let [[ptid pps pb] (:from-partial fp)]
            (abi/update-cls! cid assoc :from-partial [ptid pps pb])
            (when-let [pt (some #(when (= ptid (:id %)) %) (:partials t))]
              (doseq [o (:ool pt)] (attach-one! (:id t) cid o [pps pb])))))
        (swap! abi/*classes* (fn [m] (reduce-kv (fn [m k v] (if (:layout v) (assoc m k (dissoc v :layout)) m)) m m)))))))

(declare type-constraints-satisfied?)

(defn- partial-args
  "A partial specialization's arguments as written after its name, resolved in `scope`, and completed by the primary
  template's default arguments ([temp.spec.partial.general]/8 with [temp.arg.general]/9: `template<class X, class Y>
  struct __common_ref_impl<X&, Y&&>` of `template<class A, class B, class = void> struct __common_ref_impl` is
  <X&, Y&&, void>; cpp-s8: before, its two arguments never matched an instance's three, so common_reference_t<char&,
  char&&> was <type_traits>' bullet 3's char&, and indirectly_readable<char*> false); as written when a default does not
  resolve."
  [scope t forms]
  (let [args (resolve-args scope t forms true)]
    (if (< (count args) (count (:params t)))
      (or (try (complete-args t args) (catch arbace.lang.ExceptionInfo _ nil)) args)
      args)))

(defn- partial-match
  "The partial specialization `pt`'s parameters deduced from the arguments, or nil ([temp.class.spec.match])."
  [pt args]
  (let [b (atom {}) tid (:id pt)]
    (when (match-args b tid (:args pt) args)
      (when (= (count @b) (count (:params pt)))
        (let [ded (mapv #(get @b %) (range (count (:params pt))))]
          ;; its associated constraints satisfied ([temp.spec.partial.match]/2; G4)
          (when (and ;; (its parameters' type-constraints too, [temp.param]/4's immediately-declared constraints first in its
                     ;; associated constraints, [temp.constr.decl]/3.1; cpp-s5: <format>'s formatter<__formattable_float _Tp,
                     ;; __char _CharT> matched formatter<int, char> beside the integers' one)
                     (or (not-any? :tc (:params pt))
                         (let [k [:partial-tc (:id pt) (canonical ded)] m *satisfaction* v (if m (get @m k ::none) ::none)]
                           (if (= ::none v)
                             (let [r (boolean (type-constraints-satisfied? pt ded (bind-scope (:scope pt) (:params pt) ded nil)))]
                               (when m (swap! m assoc k r)) r)
                             v)))
                     (or (nil? (:constraint pt))
                         (let [k [:partial (:id pt) (canonical ded)] m *satisfaction* v (if m (get @m k ::none) ::none)]
                           (if (= ::none v)
                             (let [r (sema/constraint-satisfied? (bind-scope (:scope pt) (:params pt) ded nil) (:constraint pt))]
                               (when m (swap! m assoc k r)) r)
                             v)))
                     ;; the partial specialization's arguments substituted ([temp.spec.partial.match]/2: a failure is no
                     ;; match, SFINAE: __void_t<typename _Alloc::value_type, decltype(...)>; G4) equal to the arguments
                     (or (nil? (:forms pt))
                         ;; (a decltype in them whose operand does not analyze with every parameter bound is a failure too,
                         ;; though an alias like __void_t drops it: sema/*decltype-failed*, cpp-s2)
                         (let [failed (atom false)]
                           (when-let [sub (try (binding [sema/*decltype-failed* failed]
                                                 (partial-args (bind-scope (:scope pt) (:params pt) ded nil) (:tmpl pt) (:forms pt)))
                                               (catch arbace.lang.ExceptionInfo _ nil))]
                             (and (or (not @failed) (dependent? ded)) (= (canonical sub) (canonical args)))))))
            ded))))))

(defn- partial-constraints
  "A class template partial specialization's associated constraints ([temp.constr.decl]/3) as one normal form or nil: its
  parameters' type-constraints, then its requires-clause, as associated-constraints's for a function template."
  [pt]
  (let [ss (bind-scope (:scope pt) (:params pt) nil (:id pt))
        tcs (for [p (:params pt)
                  :when (and (:tc p) (not (:tc-args p)) (not (:pack p)))
                  :let [c (concept-of pt p)]
                  :when c
                  :let [ty (:ty (first (sema/lookup ss (:name p))))]]
              (normal-form (bind-scope (:scope c) (:params c) [ty] nil) (:expr c) (canonical [ty]) 1))
        rc (when-let [x (:constraint pt)] (normal-form ss x nil 0))
        parts (remove nil? (concat tcs [rc]))]
    (when (seq parts) (reduce (fn [a b] [:and a b]) parts))))

(defn- more-constrained-partial?
  [p1 p2]
  (let [p (try (partial-constraints p1) (catch arbace.lang.ExceptionInfo _ ::unknown))
        q (try (partial-constraints p2) (catch arbace.lang.ExceptionInfo e (when (System/getenv "CPP_CONSTRAINT_TRACE") (binding [*out* *err*] (println "partial-constraints" (.getMessage e)))) ::unknown))]
    (when (System/getenv "CPP_CONSTRAINT_TRACE") (binding [*out* *err*] (println "more-constrained-partial" (:id p1) (:id p2) (pr-str p) (pr-str q))))
    (cond
      (or (= ::unknown p) (= ::unknown q)) false
      (nil? p) false
      (nil? q) true
      :else (and (subsumes? p q) (not (subsumes? q p))))))

(defn- more-specialized-partial?
  "[temp.class.order]: the partial specialization p1 more specialized than p2 (p2's arguments deduced from p1's, not
  the reverse)."
  [p1 p2]
  (let [ded (fn [pa pb] (match-args (atom {}) (:id pa) (:args pa) (:args pb)))
        a (ded p2 p1)]
    (or (and a (not (ded p1 p2)))
        ;; (cpp-s8: of two whose arguments deduce each other, the more constrained, [temp.spec.partial.order]/1 with
        ;; [temp.func.order]/6.2.2: <iterator_concepts.h>'s indirectly_readable_traits<__has_member_value_type _Tp>
        ;; requires __has_member_element_type<_Tp> && same_as<...> (LWG 3446) over <__has_member_value_type _Tp> and over
        ;; LWG 3541's, std::span's value_type had been "ambiguous partial specializations")
        (and a (= (map (juxt :kind :pack) (:params p1)) (map (juxt :kind :pack) (:params p2)))
             (more-constrained-partial? p1 p2)))))

(def ^:dynamic *inst-depth*
  "CP368 (a): the class instantiations under way, nested (clang's -ftemplate-depth, 1024 by default:
  err_template_recursion_depth_exceeded)."
  0)

(declare instantiate-class* select-instance! incomplete-instance!)

(defn instantiate-class
  "The class of the class template `tid` for the complete arguments `args`: an explicit specialization's, the most
  specialized matching partial specialization's, or the primary template's ([temp.spec.partial.match]). CP368 (a): at
  most 1024 instantiations nested, as clang's -ftemplate-depth; the analysis' stack may end first (about 900 on the tools'
  host's thread), so the outermost one turns a StackOverflowError under it into the same refusal, a diagnostic, not a
  crash."
  [tid args]
  (if (pos? (long *inst-depth*))
    (instantiate-class* tid args)
    (try (instantiate-class* tid args)
         (catch StackOverflowError _
           (throw (ex-info (str "codegen: recursive template instantiation exceeded maximum depth (the analysis' stack, under "
                                (:name (tmpl tid)) ")")
                           {:codegen/refused :depth}))))))

(defn- instantiate-class*
  [tid args]
  (sema/tick!)
  (binding [sema/*decltype-failed* nil] ; (a class's own members' dependent decltypes are not its user's failure)
  (or (when-let [cid (get-in @*tmpls* [tid :insts args])] {:k :class :id cid})
      (binding [*inst-depth* (inc (long *inst-depth*))]
      (when (> (long *inst-depth*) 1024)
        (throw (ex-info (str "codegen: recursive template instantiation exceeded maximum depth of 1024 (" (:name (tmpl tid)) ")")
                        {:codegen/refused :depth})))
      (let [t (tmpl tid)]
        (when-let [nm (System/getenv "CPP_INST_TRACE")]
          (when (= nm (:name t))
            (binding [*out* *err*] (println "instance miss" (:name t) tid (pr-str args) (System/identityHashCode *tmpls*) (count (:insts t))))))
        (if (and (empty? (:partials t)) (nil? (:pattern t)) (not (contains? (:specs t) args)) *provisional* sema/*main-retry*)
          (incomplete-instance! t args)
          (select-instance! t args nil)))))))

(defn- select-instance!
  "The class of the template `t` for `args`, its definition chosen ([temp.spec.partial.match]) and declared; `cid0` the class
  id to make it under (CP372 (a): an incomplete instance completed in place), else a new one."
  [t args cid0]
  (if-let [node (get (:specs t) args)]
    (declare-instance! t args node [] [] true cid0)
    (let [ms (vec (keep (fn [pt] (when-let [b (partial-match pt args)] [pt b])) (:partials t)))
          best (vec (filter (fn [[p _]] (every? (fn [[q _]] (or (identical? p q) (more-specialized-partial? p q))) ms)) ms))
          ;; (cpp-s8: the partial specializations' constraints, evaluated just now, may have instantiated this very
          ;; specialization (std::span's __iterator_traits<span<char>, void>: __cpp17_iterator<span> through
          ;; iterator_traits<span>, whose base it is): that one, not a second class of the same arguments -- iterator_traits
          ;; had derived from the first while the cache held the second, so __primary_traits_iter<span> was false and
          ;; ranges::input_range<span<char>&> with it)
          made (when-not cid0 (get-in @*tmpls* [(:id t) :insts args]))]
      (cond
        made {:k :class :id made}
        (empty? ms) (do (when-not (:pattern t) (fail :template "an incomplete class template " (:name t)))
                        (declare-instance! t args (:pattern t) (:params t) args false cid0))
        (= 1 (count best)) (let [[pt b] (first best)
                                 c (declare-instance! t args (:node pt) (:params pt) b false cid0)]
                             ;; its out-of-line members
                             (abi/update-cls! (:id c) assoc :from-partial [(:id pt) (:params pt) b])
                             (doseq [o (:ool pt)] (attach-one! (:id t) (:id c) o [(:params pt) b]))
                             c)
        :else (fail :template "ambiguous partial specializations of " (:name t)
                    (when (System/getenv "CPP_TMPL_TRACE") (str " " (pr-str (map (fn [[p b]] [(:args p) b]) ms)) " for " (pr-str args))))))))

(defn- incomplete-instance!
  "CP372 (a): a specialization of a class template not defined yet, named in the main file (prov2.C's `using ctx = Ctx<int,
  short>;` before Ctx's definition): an incomplete class ([temp.inst]/2: naming it does not instantiate it), cached as the
  template's instance and completed in place, the same class id, when the template's definition arrives (template-defined!).
  Before, \"an incomplete class template\" and CP338's retry of the typedef, which a later use of the alias's name did not
  wait for. The headers keep their retry (sema's *retry*): only while the main file is declared (*main-retry* bound)."
  [t args]
  (let [tid (:id t) cid (next-id)
        ps (bind-scope (:scope t) (:params t) args nil)
        cs (new-scope :class ps :cls cid :path (conj (vec (:path ps)) [:cls cid]))]
    (swap! abi/*classes* assoc cid {:id cid :name (:name t) :path (:path ps) :scope cs :fields [] :bases [] :outer ps
                                    :tmpl tid :targs args})
    (upd-tmpl! tid assoc-in [:insts args] cid)
    (swap! *provisional* update-in [:templates tid] (fnil conj #{}) cid)
    (when (System/getenv "CPP_TMPL_TRACE")
      (binding [*out* *err*] (println "incomplete instance" (:name t) cid "waiting for its template's definition")))
    {:k :class :id cid}))

(defn- drop-layouts! []
  (swap! abi/*classes* (fn [m] (reduce-kv (fn [m k v] (if (:layout v) (assoc m k (dissoc v :layout)) m)) m m))))

(defn- complete-instance!
  "CP372 (a): the incomplete instance `cid` of `t` for `args` made in place by `f` (its definition chosen now, or an explicit
  specialization's), out of the waiting set; the layouts computed again on use. A refusal leaves it incomplete (a use that
  needs it complete refuses then, as before)."
  [t cid f]
  (swap! *provisional* update-in [:templates (:id t)] disj cid)
  (when (System/getenv "CPP_TMPL_TRACE")
    (binding [*out* *err*] (println "incomplete instance" (:name t) cid "completed")))
  (try (f)
       (catch arbace.lang.ExceptionInfo e
         (when-not (:codegen/refused (ex-data e)) (throw e))))
  (drop-layouts!))

(defn- incomplete-waiting? [tid cid]
  (boolean (and *provisional* (contains? (get-in @*provisional* [:templates tid]) cid))))

(defn- template-defined!
  "CP372 (a): the class template `tid` defined; its incomplete instances completed in place."
  [tid]
  (when-let [p *provisional*]
    (doseq [cid (sort (get-in @p [:templates tid]))
            :let [t (tmpl tid) args (:targs (abi/cls cid))]]
      (complete-instance! t cid #(select-instance! t args cid)))))

(defn- tmpl-of-entity [es]
  (or (some #(when (and (= :tmpl (:e %)) (#{:class :alias} (:tk %))) (:id %)) es)
      (some #(when (and (= :type (:e %)) (abi/class? (:ty %))) (:tmpl (abi/cls (:id (:ty %))))) es)))

(def ^:dynamic *alias-node* nil) ; the alias template's declaration being substituted (its errors' position)

(defn- type-pack-element
  "clang's builtin template __type_pack_element<N, T...> (BuiltinTemplateDecl BTK__type_pack_element: the Nth type of the
  pack, N < sizeof...(T)), which <bits/utility.h>'s _Nth_type uses when __has_builtin answers 1 (cpp/target's clang
  half, CP248 (a)); dependent in a signature. CP332 (a): std::get<I>(tuple) and every tuple_element<I, tuple<...>>."
  [scope forms]
  (let [bad (fn [& m] (throw (ex-info (apply str "codegen: " m)
                                       (cond-> {:codegen/refused :pack-element} *alias-node* (assoc :cx/node *alias-node*)))))
        n (try (const-form scope (first forms))
               (catch arbace.lang.ExceptionInfo _ (bad "__type_pack_element's index is not an integral constant expression")))
        ts (trait-args scope (rest forms))]
    (cond
      (and (map? n) (or (contains? n :decl) (contains? n :tmpl))) (bad "__type_pack_element's index is not an integral constant expression")
      (or (map? n) (some dependent? ts)) {:k :tdep :trait "__type_pack_element" :base (first ts) :types ts :names [] :n n}
      (not (integer? n)) (bad "__type_pack_element's index is not an integral constant expression")
      (neg? (long n)) (bad "__type_pack_element's index " n " is negative")
      (< (long n) (count ts)) (nth ts (long n))
      :else (bad "__type_pack_element's index " n " is out of range for " (count ts) " types"))))

(declare template-id)

(defn- make-integer-seq
  "clang's builtin template __make_integer_seq<Seq, T, N> (BTK__make_integer_seq): Seq<T, 0, 1, ..., N-1>, which
  <bits/utility.h> uses for std::make_integer_sequence and _Build_index_tuple when __has_builtin answers 1; dependent
  in a signature."
  [scope [sf tf nf]]
  (let [st (template-arg-of scope sf)
        t (sema/resolve-type-form scope tf)
        n (const-form scope nf)]
    (cond
      (or (map? n) (dependent? t) (= :ttp (:k st))) {:k :tdep :trait "__make_integer_seq" :base t :types [t] :names [] :n n}
      (and (integer? n) (>= (long n) 0))
      (let [tt (tmpl (:tmpl st))
            args (or (complete-args tt (resolve-args scope tt (cons tf (range (long n))) true))
                     (fail :template "__make_integer_seq's sequence"))]
        (if (= :alias (:tk tt))
          ;; (CP338 (a): an alias template's sequence, <bits/utility.h>'s _Build_index_tuple<_Num>'s
          ;; __make_integer_seq<_IdxTuple, size_t, _Num> with _IdxTuple<_Tp, _Idx...> = _Index_tuple<_Idx...>: its pattern's
          ;; type with the arguments substituted, [temp.alias]/2)
          (sema/resolve-type (bind-scope (:scope tt) (:params tt) args nil) (get-in (:pattern tt) [:type :qualType]))
          (instantiate-class (:tmpl st) args)))
      :else (fail :template "__make_integer_seq of a negative length " n))))

(defn template-id
  "The type a template-id form (<> name args...) names in `scope`: the class template's specialization for the
  resolved arguments (instantiated), or a dependent {:k :tspec} in a template's signature."
  [scope f]
  (cond
    (and (= '__type_pack_element (second f)) (empty? (sema/lookup scope "__type_pack_element")))
    (type-pack-element scope (nnext f))
    (and (= '__make_integer_seq (second f)) (empty? (sema/lookup scope "__make_integer_seq")))
    (make-integer-seq scope (nnext f))
    :else
  (let [[_ nm & forms] f
        [in nm] (if (map? nm) [(:in nm) (:name nm)] [nil nm])
        ;; (the qualified name's parts from its whole spelling: a symbol n/C/t may hold "C/t" as its name)
        parts (if (namespace nm) (str/split (str nm) #"/") [(name nm)])
        es (cond in (map second (sema/class-lookup (:cls in) (name nm)))
                 (= 1 (count parts)) (sema/lookup scope (first parts))
                 :else (sema/lookup-qualified scope (vec parts)))
        ttp (first (filter #(= :ttp (:e %)) es))]
    (if (and ttp (not (tmpl-of-entity (take-while #(not= :ttp (:e %)) es))))
      ;; TT<args> in a signature: a dependent template-id whose template is a parameter
      {:k :tspec :ttp {:k :ttp :i (:i ttp) :tid (:tid ttp)} :name (name nm) :path []
       ;; (CP338 (a): a pack expansion among them, Op<A...> of a partial specialization's __void_t<_Op<_Args...>>, pr77550:
       ;; the pack's elements, or the dependent {:k :pack-exp})
       :args (vec (mapcat #(cond (number? %) [{:val (long %) :ty abi/int*}]
                                 (and (seq? %) (= 'cpp/text (first %))) [(sema/resolve-type scope (second %))]
                                 (and (seq? %) (= 'pack-expand (first %))) (expand-type-pack scope (second %))
                                 :else [(sema/resolve-type-form scope %)])
                          forms))}
    (let [tid (or (tmpl-of-entity es) (fail :template "not a template: " nm))
        t (tmpl tid)]
    (when-not (#{:class :alias} (:tk t)) (fail :template "not a class or alias template: " nm))
    (let [args (resolve-args scope t forms true)]
      (if (= :alias (:tk t))
        ;; an alias template's specialization is its pattern's type with the arguments substituted ([temp.alias]/2)
        (let [args (or (complete-args t args) (fail :template "missing template arguments for " nm))]
          (binding [*alias-node* (when (:range (:pattern t)) (:pattern t))]
            (sema/resolve-type (bind-scope (:scope t) (:params t) args nil) (get-in (:pattern t) [:type :qualType]))))
      (if (dependent? args)
        ;; the defaults completed in a scope binding the dependent arguments before them (G4: enable_if<C>, the
        ;; headers' defaulted parameters); one that cannot be (a dependent value) is refused
        (let [written (count args)
              args (if (< (count args) (count (:params t)))
                     (or (try (complete-args t args) (catch arbace.lang.ExceptionInfo e (when (System/getenv "CPP_TMPL_TRACE") (binding [*out* *err*] (println "defaults of" (:name t) (pr-str args) (.getMessage e)))) nil))
                         (fail :template "a dependent template-id with default arguments"))
                     args)]
          ;; (as written, for an unresolved name's mangling: its arguments' count, the namespaces of its qualifier)
          ;; (:written and :qual no part of the type's identity: canonical drops them)
          (cond-> {:k :tspec :tmpl tid :name (:name t) :path (:path t) :args args :written written}
            (and (> (count parts) 1) (not in)) (assoc :qual (vec (butlast parts)))))
        (instantiate-class tid (or (complete-args t args) (fail :template "missing template arguments for " nm)))))))))))

;; ---------------------------------------------------------------------------------------------
;; Members defined outside their class template (template <class T> T Box<T>::get() {...})

(defn- header-params
  "The parameter names of the text's leading `template <...>`."
  [^String text]
  (let [ts (vec (ct/tokens text))]
    (when (and (= "template" (nth (get ts 0) 1 nil)) (= "<" (nth (get ts 1) 1 nil)))
      (loop [i 2 d 0 seg [] out []]
        (let [[_ t] (get ts i)]
          (cond
            (nil? t) out
            (and (zero? d) (#{"," ">"} t))
            (let [nm (last (filter #(and (= :id (first %)) (not (#{"class" "typename" "int" "unsigned" "long" "short" "char" "bool" "signed" "const"} (second %))))
                                   (take-while #(not= "=" (second %)) seg)))
                  out (conj out (second nm))]
              (if (= t ">") out (recur (inc i) d [] out)))
            (#{"<" "(" "["} t) (recur (inc i) (inc d) (conj seg (get ts i)) out)
            (#{">" ")" "]"} t) (recur (inc i) (dec d) (conj seg (get ts i)) out)
            :else (recur (inc i) d (conj seg (get ts i)) out)))))))

(declare ool-qualifier)

(defn- ool-class-name
  "The class template a member's qualifier names (`Box<T>::` before the declaration's name), or nil."
  [n]
  (first (ool-qualifier n)))

(defn- ool-qualifier
  "[name template-id-text] of the template-id a member's qualifier ends with (`Box<int>::`), or nil."
  [n]
  (let [t0 (sema/text-before-name n)]
    (when t0
      (let [t (str/trim (str/replace t0 #"~\s*$" ""))]
        ;; Name<...>:: at the end: the brackets matched backward from the last >; plain names after it (Out<T>::In::,
        ;; a member of a member class: their names third, G5)
        (when (str/ends-with? t "::")
          (let [t (str/trim (subs t 0 (- (count t) 2)))
                [t nested] (loop [t t nested ()]
                             (if-let [m (and (not (str/ends-with? t ">")) (re-find #"::\s*([A-Za-z_][A-Za-z_0-9]*)\s*$" t))]
                               (recur (str/trim (subs t 0 (- (count t) (count (first m))))) (cons (second m) nested))
                               [t (vec nested)]))]
            (when (str/ends-with? t ">")
              (let [i (loop [i (dec (count t)) d 0]
                        (when (>= i 0)
                          (let [c (.charAt ^String t i)]
                            (cond (= c \>) (recur (dec i) (inc d))
                                  (= c \<) (if (= d 1) i (recur (dec i) (dec d)))
                                  :else (recur (dec i) d)))))]
                (when i (when-let [m (re-find #"([A-Za-z_][A-Za-z_0-9]*)\s*$" (subs t 0 i))]
                          ;; the whole nested-name-specifier (S::Y<char>), outer parts plain names
                          (let [pre (re-find #"((?:[A-Za-z_][A-Za-z_0-9]*\s*::\s*)*)$" (subs t 0 (- i (count (first m)))))]
                            [(second m) (str (str/replace (or (second pre) "") #"\s" "") (second m) (subs t i)) nested])))))))))))

(defn- class-key-scope
  "The scope a class template's (or its partial or explicit specialization's) declaration names with a
  nested-name-specifier of plain names after its class-key (`template<...> class __format::_Arg_store {...}`, a member of
  a namespace defined outside it, [class.pre]/3, [temp.spec.partial.general]/7; cpp-s5: <format>), else `scope`."
  [scope n]
  (let [t (sema/text-before-name n)
        m (when t (re-find #"\b(?:class|struct|union)\s+((?:[A-Za-z_][A-Za-z_0-9]*\s*::\s*)+)$" t))]
    (if-not m
      scope
      (let [q (vec (map str/trim (remove str/blank? (str/split (second m) #"::"))))
            e (first (filter #(#{:ns :type} (:e %)) (sema/lookup-qualified scope q)))]
        (cond (= :ns (:e e)) (:scope e)
              (and e (abi/class? (:ty e))) (:scope (abi/cls-of (:ty e)))
              :else scope)))))

(defn- ool-class-template
  "The class template an out-of-line member's qualifier `qt` (`any::_Manager_internal<_Tp>`, as ool-qualifier gives it)
  names by `cn`: looked up unqualified, else through the qualifier's plain names before it (a member template of a class,
  cpp-s5: <any>'s any::_Manager_internal<_Tp>::_S_manage)."
  [scope cn qt]
  (or (some #(when (and (= :tmpl (:e %)) (= :class (:tk %))) (:id %)) (sema/lookup scope cn))
      (let [pre (when (string? qt) (second (re-find #"^((?:[A-Za-z_][A-Za-z_0-9]*::)+)[A-Za-z_][A-Za-z_0-9]*<" qt)))
            parts (when pre (conj (vec (remove str/blank? (str/split pre #"::"))) cn))]
        (when parts
          (some #(when (and (= :tmpl (:e %)) (= :class (:tk %))) (:id %))
                (try (sema/lookup-qualified scope parts) (catch arbace.lang.ExceptionInfo _ nil)))))
      (fail :template "no class template " cn)))

(defn- attach-one!
  "An out-of-line member definition `o` given to the class `cid`, made from the primary (its arguments bound to the
  header's names) or from a partial specialization (its deduced arguments, `pb` [params args])."
  [tid cid o & [pb]]
  (let [t (tmpl tid)
        c0 (abi/cls cid)
        ;; (a member of a member class: the member class of the specialization, Out<int>::In)
        nested-id (fn [k nm] (some #(when (and (= :type (:e %)) (abi/class? (:ty %))) (:id (:ty %))) (.get ^java.util.HashMap (:names (:scope (abi/cls k))) nm)))
        icid (reduce (fn [k nm] (or (nested-id k nm) (fail :template "no member class " nm " of " (:name (abi/cls k))))) cid (:nested o))
        c (abi/cls icid)
        n (:node o)
        [params bargs] (or pb [(:params t) (:targs c0)])
        s (bind-scope (:scope c) (mapv (fn [nm p] {:name nm :kind (:kind p)}) (:pnames o) params) bargs nil)]
    (case (:k o)
      ;; a member class defined outside its class template (template <class T> class Out<T>::In {...}): the
      ;; specialization's member class defined from it, its members' definitions instantiated on use
      :class (let [ncid (or (nested-id icid (:name n)) (fail :template "no member class " (:name n) " of " (:name c) " to define"))
                   first-fn (inc (long @sema/*ids*))]
               (when-not (:complete (abi/cls ncid))
                 (binding [sema/*cutoff* Long/MAX_VALUE *instance* ncid]
                   (sema/declare-node! (:scope c) (assoc (strip-tparam-kids n) :kind "CXXRecordDecl")))
                 (doseq [[id f] @sema/*fns* :when (and (>= (long id) first-fn) (= ncid (:cls f)) (:body f) (not (:implicit f)))]
                   (upd-fn! id assoc :lazy true :inline true))))
      :fn (let [k (case (:kind n) "CXXConstructorDecl" :ctor "CXXDestructorDecl" :dtor :method)
                qt (get-in n [:type :qualType])
                ty (sema/resolve-type s qt)
                cq (boolean (re-find #"\)\s*const(\s|$|&)" qt))
                fid (some (fn [id] (let [f (sema/fnd id)]
                                     (when (and (= k (:kind f)) (or (#{:ctor :dtor} k) (= (:name f) (:name n))) (= cq (boolean (:cq f)))
                                                (= (mapv abi/unq (:ps (:ty f))) (mapv abi/unq (:ps ty))))
                                       id)))
                          (:methods c))
                pn (filter #(= "ParmVarDecl" (:kind %)) (kids n))]
            (when-not fid (fail :template "no member " (:name n) " of " (:name t) " to define"))
            (upd-fn! fid assoc :body (sema/body-of n) :node n :def-scope s :keep-def-scope true
                     :inits (filter #(= "CXXCtorInitializer" (:kind %)) (kids n)) :param-names (mapv :name pn) :lazy true :inline true))
      :var (let [vid (some #(when (= (:name (sema/var* %)) (:name n)) %) (:statics c))]
             (when-not vid (fail :template "no static member " (:name n) " of " (:name t) " to define"))
             ;; a definition without an initializer keeps the one the class gave (static const int x = 3; ... X<T>::x;)
             (upd-var! vid #(cond-> % (first (kids n)) (assoc :init (first (kids n)) :init-style (:init n) :def-scope s)))
             (upd-var! vid assoc :pending-def true :linkonce true :internal (boolean (:internal (:outer c))) :internal-l false :of-cls icid)))))

(declare attach-member-template!)

(defn- attach-ool!
  "The out-of-line member definitions of the template `tid` given to its specialization `cid`."
  [tid cid]
  (doseq [o (:ool (tmpl tid))] (attach-one! tid cid o))
  (doseq [o (:ool-tmpls (tmpl tid))] (attach-member-template! cid o (:params (tmpl tid)))))

;; ---------------------------------------------------------------------------------------------
;; Function templates: specializations

(defn- concept-of
  "The concept a type-constraint names (its template entry), looked up in the template's scope, or nil."
  [t p]
  (when-let [parts (:tc p)]
    (let [es (try (if (= 1 (count parts)) (sema/lookup (:scope t) (first parts)) (sema/lookup-qualified (:scope t) parts))
                  (catch arbace.lang.ExceptionInfo _ nil))
          e (first (filter #(and (= :tmpl (:e %)) (= :concept (:tk %))) es))]
      (when e (tmpl (:id e))))))

(defn- tn-types
  "For a function template (overloadable, so its arguments name their parameters when not natural:
  ItaniumMangle.cpp's needToMangleTemplateParam): each non-type parameter's declared type when it is dependent
  (template <class T, T v>: Tn T_), a constrained type parameter's concept (Tk <name>, clang 17's mangling of a
  type-constraint without arguments), else nil."
  [t]
  (let [ss (sym-scope t)]
    (mapv (fn [p] (case (:kind p)
                    :value (let [ty (param-type ss p)] (when (dependent? ty) {:ty ty :pack (:pack p)}))
                    :type (when-let [c (and (:tc p) (not (:tc-args p)) (concept-of t p))]
                            {:tk {:tid (:id c) :name (:name c) :path (:path c)} :pack (:pack p)})
                    nil))
          (:params t))))


(defn- concept-satisfied?
  "The satisfaction of the concept `c` (its template entry) for the arguments `args`, memoized (with whether it was
  doubtful, CP281 (a): sema/*constraint-doubt*)."
  [c args0]
  ;; (cpp-s8: fewer arguments than its parameters, a type-constraint's text short of them: completed by the concept's
  ;; defaults, else not checked, a doubt -- bound short, an IndexOutOfBounds had crashed the analysis)
  (if-let [args (if (< (count args0) (count (:params c)))
                  (try (complete-args c (vec args0)) (catch arbace.lang.ExceptionInfo _ nil))
                  args0)]
  (let [k [(:id c) (canonical args)]
        eval1 (fn [] (when (System/getenv "CPP_CONCEPT_TRACE") (binding [*out* *err*] (println "enter concept" (:name c) (pr-str (canonical args)))))
                     (let [d (atom false)
                           r (binding [sema/*constraint-doubt* d]
                               (sema/constraint-satisfied? (bind-scope (:scope c) (:params c) args nil) (:expr c)))]
                       [r @d]))
        [r d] (if-let [m *satisfaction*]
                (let [v (get @m k ::none)]
                  (if (= ::none v)
                    (let [u (atom false)
                          x (binding [*unstable* u] (eval1))]
                      (if @u (some-> *unstable* (reset! true)) (swap! m assoc k x))
                      x)
                    v))
                (eval1))]
    (when (System/getenv "CPP_CONCEPT_TRACE") (binding [*out* *err*] (println "concept" (:name c) (pr-str (canonical args)) "=>" r (if d "(doubt)" "") (pr-str (keep #(when (and (map? %) (= :class (:k %))) [(:id %) (select-keys (abi/cls (:id %)) [:defining :finished :complete])]) (tree-seq coll? seq args))))))
    (when d (sema/doubt!))
    r)
  (do (sema/doubt!) true)))

(defn- type-constraints-satisfied?
  "Each constrained type parameter's concept satisfied by its argument ([temp.param]/4: the immediately-declared
  constraint C<T>)."
  [t args scope]
  (every? (fn [[p a]]
            (cond
              (or (not (:tc p)) (:pack p)) true
              ;; (C<A...> T: C<T, A...>, the arguments resolved where the parameters are bound, cpp-s2: std::tuple's
              ;; `template<__eligible_tuple_like<tuple> _UTuple>`; arguments the text does not show: not checked, as before)
              (:tc-args p) (if-let [c (when (:tc-forms p) (concept-of t p))]
                             (let [rest-args (try (resolve-args scope (assoc c :params (vec (rest (:params c)))) (:tc-forms p) true)
                                                  (catch arbace.lang.ExceptionInfo _ (sema/doubt!) ::unresolved))]
                               (if (= ::unresolved rest-args) false (concept-satisfied? c (into [a] rest-args))))
                             true)
              ;; (cpp-s8: a concept of more parameters whose further arguments the parameter's text did not give: not
              ;; checked, as above, rather than bound short -- an IndexOutOfBounds, a crash of the analysis)
              :else (if-let [c (concept-of t p)]
                      (if (> (count (remove :pack (:params c))) 1) (do (sema/doubt!) true) (concept-satisfied? c [a]))
                      true)))
          (map vector (:params t) args)))

(defn- name-pack-params!
  "A specialization's parameters from a function parameter pack (Ts... ts): their names, the pack's name standing for
  them (:param-packs), the default arguments realigned."
  [fid pattern]
  (let [f (sema/fnd fid)
        pn (filter #(= "ParmVarDecl" (:kind %)) (kids pattern))
        packed (mapv #(boolean (re-find #"\.\.\.\s*$" (or (get-in % [:type :qualType]) ""))) pn)]
    (when (some true? packed)
      (let [n (- (count (:ps (:ty f))) (dec (count pn)))
            [names defaults packs] (reduce (fn [[ns ds pk] [p pack?]]
                                             (if pack?
                                               [(into ns (repeat n nil)) (into ds (repeat n nil)) (assoc pk (:name p) (vec (range (count ns) (+ (count ns) n))))]
                                               [(conj ns (:name p)) (conj ds (first (kids p))) pk]))
                                           [[] [] {}] (map vector pn packed))]
        (upd-fn! fid assoc :param-names names :defaults defaults :param-packs (dissoc packs nil))))))

(defn- template-depth
  "The template parameter depth of a template declared in `scope`: the number of enclosing class specializations of
  templates (a member template of pair<int, double> at depth 1)."
  [scope]
  (loop [s scope d 0]
    (cond (nil? s) d
          (= :class (:kind s)) (let [c (abi/cls (:cls s))] (recur (:outer c) (if (:tmpl c) (inc d) d)))
          :else (recur (:parent s) d))))

(defn- decltype-failed?
  "Whether the type `t` holds decltype-of's dependent stand-in for an operand that did not analyze."
  [t]
  (boolean (some #(and (map? %) (= :tdep (:k %)) (= "decltype" (get-in % [:base :name])))
                 (tree-seq coll? #(if (map? %) (vals %) (seq %)) t))))

(defn instantiate-fn
  "The specialization of the function template `tid` for the complete arguments `args`: its declaration (the pattern
  declared in a scope binding the parameters; its definition analyzed when used), memoized."
  [tid args]
  (sema/tick!)
  (or (get-in @*tmpls* [tid :insts args])
      (let [t (tmpl tid)
            ps (bind-scope (:scope t) (:params t) args nil)
            ;; the template's associated constraints ([temp.constr.decl]/3: its requires-clause, then the trailing one;
            ;; P14 (b)): not satisfied, no specialization ([temp.deduct]/5, [over.match.viable]/3)
            ;; (CX12, CP281 (a), the checker: a constraint that evaluated to false with no doubt is a sure failure)
            d (atom false)
            unsat (fn [what]
                    (when (System/getenv "CPP_CONSTRAINT_TRACE") (binding [*out* *err*] (println "unsatisfied" what (:name t) (pr-str args) (pr-str (some-> (:constraint t) (#'sema/node-text))))))
                    (throw (ex-info (str "codegen: " what " not satisfied for " (:name t))
                                    {:codegen/refused :template :cx/constraint-false (and (sema/checking?) (not @d))})))
            ;; (the type-constraints first: [temp.constr.decl]/3.1 puts them before the requires-clause in the conjunction,
            ;; which is checked in order and stops at the first not satisfied, [temp.constr.op]/2; libstdc++'s C++23 tuple's
            ;; `template<__eligible_tuple_like<tuple> _UTuple> requires (__constructible_from_tuple_like<_UTuple>())`, whose
            ;; requires-clause for a non-tuple _UTuple instantiates a generic lambda over an index sequence: std::thread's
            ;; constructor, cpp-s2)
            ;; (cpp-s4: a constraint's satisfaction is its own context, not the user-defined conversion that asks for the
            ;; converting constructor template: [over.best.ics]/4's standard-conversions-only does not reach into it --
            ;; std::format's basic_format_string(const _Tp&) requires convertible_to<const _Tp&, basic_string_view<_CharT>>,
            ;; whose static_cast needs string_view's converting constructor)
            _ (when-not (binding [sema/*constraint-doubt* d sema/*no-user* false] (type-constraints-satisfied? t args ps)) (unsat "type-constraints"))
            _ (when-let [rc (:constraint t)]
                (when-not (binding [sema/*constraint-doubt* d sema/*no-user* false] (sema/constraint-satisfied? ps rc))
                  (unsat "constraints")))
            fid (binding [sema/*cutoff* Long/MAX_VALUE sema/*constraint-doubt* d] (#'sema/declare-fn! ps (:pattern t)))
            _ (when-not fid (unsat "constraints"))
            ;; (CP332 (a): a decltype in the signature that does not analyze with every argument bound is a substitution
            ;; failure, [temp.deduct.general]/8 -- std::size(const _Container&) -> decltype(__cont.size()) for a pair,
            ;; which ranges::size's __adl_size had taken for viable; decltype-of keeps it a dependent type only for a
            ;; signature with parameters still unbound)
            _ (when (and (not (dependent? args)) (decltype-failed? (:ty (sema/fnd fid))))
                ;; (the declaration made is left unused: lazy, never a constructor candidate)
                (upd-fn! fid assoc :lazy true :inline true)
                (let [f (sema/fnd fid)]
                  (when (= :ctor (:kind f)) (abi/update-cls! (:cls f) update :ctors (fn [cs] (vec (remove #{fid} cs))))))
                (unsat "the signature's substitution"))
            ;; the specialization is found through its template, not by its name in the parameters' scope
            _ (.remove ^java.util.HashMap (:names ps) (:name (:pattern t)))]
        (when (and (sema/checking?) (:access t)) (upd-fn! fid assoc :access (:access t)))
        (upd-fn! fid assoc :lazy true :inline true :keep-def-scope true
                 :tinst (cond-> {:tid tid :args args :tsig (sym-sig t) :tn (tn-types t)}
                          (:constraint t) (assoc :q {:node (:constraint t) :pidx (into {} (map-indexed (fn [i p] [(:name p) i]) (:params t)))
                                                     :depth (template-depth (:scope t))})))
        ;; a constructor template's specialization is a candidate through its template (the :ctor-candidates hook),
        ;; not one of the class's constructors (never a copy constructor: [class.copy.ctor]/5)
        (let [f (sema/fnd fid)]
          (when (= :ctor (:kind f)) (abi/update-cls! (:cls f) update :ctors (fn [cs] (vec (remove #{fid} cs))))))
        (name-pack-params! fid (:pattern t))
        (when-let [decls (seq (:decls t))]
          (let [f (sema/fnd fid)
                alt (for [d decls] (mapv (fn [p] (first (remove (fn [k] (str/ends-with? (str (:kind k)) "Attr")) (kids p)))) (filter #(= "ParmVarDecl" (:kind %)) (kids d))))]
            (upd-fn! fid assoc :defaults (vec (map-indexed (fn [i x] (or x (some #(get % i) alt))) (:defaults f))))))
        (upd-tmpl! tid assoc-in [:insts args] fid)
        fid)))

(defn- adl-templates
  "The function templates named `nm` in the namespaces of the class arguments ([basic.lookup.argdep])."
  [args nm]
  (distinct
   (for [a args
         ;; (cpp-s4: a pointer's, [basic.lookup.argdep]/3.4, its pointee's: any's `any_cast<_Up>(&__any)` finds the
         ;; pointer overloads declared after it)
         :let [t (loop [t (abi/unq (abi/non-ref (:ty a)))] (if (abi/ptr? t) (recur (abi/unq (:to t))) t))] :when (abi/class? t)
         :let [acls (#'sema/adl-classes args)]
         ns (sema/adl-class-nss (:id t))
         e (binding [sema/*cutoff* Long/MAX_VALUE] (#'sema/own-names ns nm))
         :when (and (= :tmpl (:e e)) (= :fn (:tk e)) (#'sema/friend-visible? acls e))]
     (:id e))))

(defn- too-few-args?
  "CX12 (the checker): the call's arguments fewer than the function template's parameters that are no pack and have no
  default argument ([over.match.viable]/2, the deduction's TooFewArguments)."
  [t args]
  (let [pn (filter #(= "ParmVarDecl" (:kind %)) (:inner (:pattern t)))
        req (count (take-while (fn [p] (and (not (re-find #"\.\.\." (str (get-in p [:type :qualType]))))
                                            (not-any? #(re-find #"Expr$|Literal$" (str (:kind %))) (:inner p))))
                               pn))]
    (< (count args) req)))

(defn call-candidates
  "The specializations the function templates of a call's overload set deduce from its arguments (a template whose
  deduction or substitution fails is not a candidate: [temp.deduct]/8, SFINAE)."
  [ctx callee args]
  (let [acls (#'sema/adl-classes args)
        ;; (cpp-s8: a hidden friend template only by ADL, its class associated: sema's friend-visible?)
        tids (distinct (concat (filter #(#'sema/friend-visible? acls (tmpl %)) (:tmpls callee))
                               (when (and (not (:obj callee)) (not (:qualified callee)) (:name callee)) (adl-templates args (:name callee)))))]
    (let [sure (atom 0) doubt (atom 0)
          fids (vec (for [tid tids
                          :let [t (tmpl tid)
                                u (atom false)
                                sr (atom false)
                                ;; (the checker's position stays the call's: the template's signature and pattern are
                                ;; analyzed while deducing, CX12)
                                at sema/*at* at-saved (some-> at deref)
                                fid (do
                                     (binding [*unsure* u *sure* sr]
                                      (try (let [ex (explicit-args t (:targs-text callee) (or (:targs-scope callee) (:scope ctx)))]
                                             (if-let [a (deduce-call t ex args)]
                                               (instantiate-fn tid a)
                                               (when (System/getenv "CPP_TMPL_TRACE")
                                                 (binding [*out* *err*] (println "template" (:name t) "does not deduce from" (pr-str (map :ty args)) "explicit" (pr-str ex))))))
                                           (catch arbace.lang.ExceptionInfo e
                                             (when (System/getenv "CPP_TMPL_TRACE") (binding [*out* *err*] (println "template" (:name t) "drops out:" (.getMessage e))))
                                             ;; (CP281 (a): a constraint surely false is the program's, a sure drop)
                                             (if (or (:cx/constraint-false (ex-data e)) (:cx/sure-drop (ex-data e))) (reset! sr true) (reset! u true))
                                             (if (#{:template-pack :template-template} (:codegen/refused (ex-data e))) (throw e) nil))
                                           (finally (when at (reset! at at-saved))))))
                                ;; (CX12, the checker: a template whose deduction failed by the algorithm alone)
                                _ (when-not fid (swap! (if (and (not @u) (or @sr (too-few-args? t args))) sure doubt) inc))]
                          :when fid]
                      fid))]
      ;; the drops' counts for the checker's diagnostic (sema's resolve-overload*)
      (with-meta fids {:sure-drops @sure :unsure-drops @doubt}))))

(defn- explicit-fn-spec!
  "An explicit specialization of a function template (template <> R f<args>(...) {...}): its template found by name
  and its arguments from the TemplateArgument kids and deduction from its type ([temp.deduct.decl])."
  [scope n & [cid]]
  (let [ts (filter #(and (= :tmpl (:e %)) (= :fn (:tk %)))
                   (if cid (.get ^java.util.HashMap (:names scope) (:name n)) (sema/lookup scope (:name n))))
        targs (filter #(= "TemplateArgument" (:kind %)) (kids n))
        try1 (fn [e]
               (let [t (tmpl (:id e))]
                 (try
                   (let [ex (vec (map-indexed (fn [i a] (node-arg scope (nth (:params t) i) a)) targs))
                         ty (dissoc (sema/resolve-type scope (get-in n [:type :qualType])) :cq)
                         b (atom (into {} (map-indexed vector ex)))]
                     (when (deduce-type b (:id t) (sym-sig t) ty)
                       (when-let [args (finish-deduction t @b)] [t args])))
                   (catch arbace.lang.ExceptionInfo _ nil))))
        ;; of the templates it could specialize, the most specialized ([temp.deduct.decl]/1, [temp.func.order])
        found (keep try1 ts)
        np (count (:ps (dissoc (sema/resolve-type scope (get-in n [:type :qualType])) :cq)))
        best (filter (fn [[t _]] (every? (fn [[u _]] (or (= (:id t) (:id u)) (more-specialized-fn? (:id t) (:id u) np))) found)) found)
        [t args] (or (first best) (first found) (fail :template "no template for the explicit specialization " (:name n)))
        ps (if cid
             (new-scope :tparams scope :cls cid :path (:path scope) :internal (:internal scope))
             (new-scope :tparams scope :internal (:internal scope)))
        fid (#'sema/declare-fn! ps n)
        _ (.remove ^java.util.HashMap (:names ps) (:name n))
        _ (when cid (upd-fn! fid assoc :inline (boolean (:inline n))))]
    (upd-fn! fid assoc :tinst {:tid (:id t) :args args :tsig (sym-sig t) :tn (tn-types t)} :keep-def-scope true)
    (upd-tmpl! (:id t) assoc-in [:insts args] fid)
    :template))

;; ---------------------------------------------------------------------------------------------
;; Variable templates ([temp.pre]/1: template <class T> constexpr bool v = ...;)

(defn var-template
  "The :var-template hook: the variable a variable template's name with its explicit arguments names (`v<int>`), its
  specialization declared once; defined (linkonce_odr) only when odr-used."
  [ctx e n]
  (let [t (tmpl (:id e))
        args (or (complete-args t (or (explicit-args t (sema/written-targs n (:name t)) (:scope ctx)) [])) (fail :template "missing template arguments for " (:name t)))]
    (var-template-inst t args)))

(declare partial-match more-specialized-partial?)

(defn- var-template-inst
  "The variable template `t`'s specialization for the complete arguments `args`, declared once: the most specialized
  matching partial specialization's (CP338 (a), [temp.spec.partial.match] as for a class; libstdc++'s
  __detail::__variant::__accepted_index<_Tp, _Variant, void_t<_FUN_type<_Tp, _Variant>>>), else the primary's."
  [t args]
  (let [t (tmpl (:id t))
        ms (keep (fn [pt] (when-let [b (partial-match pt args)] [pt b])) (:partials t))
        best (filter (fn [[p _]] (every? (fn [[q _]] (or (identical? p q) (more-specialized-partial? p q))) ms)) ms)
        _ (when (and (seq ms) (not= 1 (count best))) (fail :template "ambiguous partial specializations of " (:name t)))
        [pattern params bound] (if-let [[pt b] (first best)]
                                 [(first (filter #(= "VarDecl" (:kind %)) (kids (:node pt)))) (:params pt) b]
                                 [(:pattern t) (:params t) args])]
    (or (get-in @*tmpls* [(:id t) :insts args])
        (let [ps (bind-scope (:scope t) params bound nil)
              vid (binding [sema/*cutoff* Long/MAX_VALUE] (#'sema/declare-var! ps pattern :global))]
          (.remove ^java.util.HashMap (:names ps) (:name pattern))
          (upd-var! vid assoc :tinst {:tid (:id t) :args args :name (:name t)} :linkonce true :defined false :pending-def true
                    :internal (boolean (:internal ps)) :internal-l false)
          (upd-tmpl! (:id t) assoc-in [:insts args] vid)
          vid))))

;; ---------------------------------------------------------------------------------------------
;; Declarations

(defn- template-text-args
  "A partial specialization's arguments as written after its name (struct Box<T*>), parsed from the main file's text."
  [n]
  (let [ts (vec (ct/tokens (node-text n)))
        ;; (the class-key before the name, or before its nested-name-specifier: <format>'s `class
        ;; __format::_Arg_store<_Context>`, a member of a namespace defined outside it, [class.pre]/3; cpp-s5)
        key-before? (fn [i] (loop [j (dec i)]
                              (let [t (nth (get ts j) 1 nil)]
                                (cond (#{"struct" "class" "union"} t) true
                                      (and (= "::" t) (>= j 1)) (if (= "::" (nth (get ts (dec j)) 1 nil)) false
                                                                  (if (#{"struct" "class" "union"} (nth (get ts (dec j)) 1 nil)) true (recur (- j 2))))
                                      :else false))))
        i (some (fn [i] (when (and (= (:name n) (nth (get ts i) 1 nil)) (= "<" (nth (get ts (inc i)) 1 nil)) (key-before? i))
                          i))
                (range 1 (dec (count ts))))]
    (cond
      i (first (ct/template-args ts (+ 2 i)))
      ;; (cpp-s5: one a macro writes, its arguments' tokens as the parser kept them)
      (:_targtext n) (first (ct/template-args (vec (ct/tokens (:_targtext n))) 1))
      :else (fail :template "partial specialization's arguments"))))

(defn- var-text-args
  "CP338 (a): a variable template's partial specialization's arguments as written after its name, parsed from its text."
  [n]
  (let [ts (vec (ct/tokens (node-text n)))
        i (some (fn [i] (when (and (= (:name n) (nth (get ts i) 1 nil)) (= "<" (nth (get ts (inc i)) 1 nil))) i))
                (range 0 (dec (count ts))))]
    (when-not i (fail :template "a variable template's partial specialization's arguments"))
    (first (ct/template-args ts (+ 2 i)))))

(defn- find-template [scope nm tk]
  (some #(when (and (= :tmpl (:e %)) (= tk (:tk %))) (:id %)) (.get ^java.util.HashMap (:names scope) nm)))

(declare declare-template user-guide!)


(defn- friend!
  "A friend declaration in a class: a function (or function template) defined there is a member of the innermost
  enclosing namespace ([class.friend]/6-7), inline, its body's names those of the class; a declaration alone or a
  friend class adds nothing here (access is not checked)."
  [scope n]
  (let [k (first (kids n))
        ns (loop [s scope] (if (or (nil? s) (= :ns (:kind s))) s (recur (:parent s))))
        ;; the class's names visible from the body, the namespace's path for mangling
        fs (new-scope :tparams scope :path (:path ns) :cls nil :internal (:internal ns))]
    (case (:kind k)
      "FunctionDecl"
      ;; (a defaulted comparison too, friend auto operator<=>(D, D) = default: G5)
      (when (or (sema/body-of k) (:explicitlyDefaulted k))
        ;; declared in the class's names (its type may name the class's parameters), entered in the namespace, or
        ;; defining the namespace's earlier declaration of it
        (let [fid (#'sema/declare-fn! fs k)
              f (sema/fnd fid)
              old (some (fn [e] (when (and (= :fn (:e e)) (#'sema/same-sig? (sema/fnd (:id e)) f)) (:id e))) (.get ^java.util.HashMap (:names ns) (:name k)))
              id (or old fid)]
          (when old
            (upd-fn! old assoc :body (:body f) :node k :def-scope fs :param-names (:param-names f) :inline true)
            (upd-fn! fid dissoc :body))
          ;; (cpp-s8: a hidden friend, found by ADL alone: sema's friend-visible?)
          (when-not old
            (enter! ns (:name k) (cond-> {:e :fn :id fid :pos (long (or (:_b k) 0))} (:cls scope) (assoc :friend-cls (:cls scope))))
            (when (:cls scope) (upd-fn! fid assoc :friend-cls (:cls scope))))
          (upd-fn! id assoc :def-scope fs :inline true)
          ;; a defaulted <=> declares a defaulted == alongside it ([class.compare.default]/5)
          (when (and (:explicitlyDefaulted k) (= "operator<=>" (:name k))
                     (not (some #(= :fn (:e %)) (.get ^java.util.HashMap (:names ns) "operator=="))))
            (friend! scope (assoc n :inner [(assoc k :name "operator==" :type {:qualType (str/replace (str (get-in k [:type :qualType])) #"^\s*auto\b" "bool")})])))
          (when *instance* (upd-fn! id assoc :lazy true))))
      "FunctionTemplateDecl"
      (let [pat (first (filter #(= "FunctionDecl" (:kind %)) (kids k)))]
        ;; each class specialization's friend template is a template of its own (its signature names the class)
        (when (sema/body-of pat)
          ;; or the definition of the namespace's earlier declaration of the template
          (if-let [old (some #(when (and (= :tmpl (:e %)) (= :fn (:tk %))
                                         (let [o (tmpl (:id %))]
                                           (and (not (sema/body-of (:pattern o)))
                                                (= (get-in pat [:type :qualType]) (get-in (:pattern o) [:type :qualType]))
                                                (= (count (tparams k)) (count (:params o))))))
                               (:id %))
                             (.get ^java.util.HashMap (:names ns) (:name k)))]
            (upd-tmpl! old assoc :pattern pat :params (tparams k) :scope fs :sig nil)
            (let [tid (next-id)]
              (swap! *tmpls* assoc tid (cond-> {:id tid :tk :fn :name (:name k) :scope fs :path (:path ns) :params (tparams k) :pattern pat
                                                :pos (:_b k) :insts {}}
                                         (:cls scope) (assoc :friend-cls (:cls scope))))
              (enter! ns (:name k) (cond-> {:e :tmpl :tk :fn :id tid :pos (long (or (:_b k) 0))} (:cls scope) (assoc :friend-cls (:cls scope))))))))
      nil)
    :template))

(defn- explicit-member-spec!
  "An explicit specialization of a member of an implicitly instantiated class template specialization
  ([temp.expl.spec]/14): the specialization's member given this definition, an ordinary (not inline) one."
  [scope n]
  (let [[_ qt] (or (ool-qualifier n) (fail :template "an explicit specialization's qualifier"))
        cls (sema/resolve-type scope qt)
        _ (when-not (abi/class? cls) (fail :template "an explicit specialization of a member of " qt))
        c (abi/cls (:id cls))]
    (if (= "VarDecl" (:kind n))
      (let [vid (or (some #(when (= (:name (sema/var* %)) (:name n)) %) (:statics c)) (fail :template "no static member " (:name n)))]
        (if (first (kids n))
          (upd-var! vid #(-> % (assoc :init (first (kids n)) :init-style (:init n) :def-scope scope :defined true :linkonce false
                                      :internal false :internal-l false)
                             (dissoc :pending-def)))
          ;; without an initializer a declaration, not a definition ([temp.expl.spec]/14): defined elsewhere (G5:
          ;; <locale_facets_nonio.h>'s template<> const char* __timepunct_cache<char>::_S_timezones[14];)
          (upd-var! vid #(-> % (assoc :extern true :defined false :linkonce false :internal false :internal-l false) (dissoc :pending-def)))))
      (let [k (case (:kind n) "CXXConstructorDecl" :ctor "CXXDestructorDecl" :dtor :method)
            q (get-in n [:type :qualType])
            ty (sema/resolve-type (:scope c) q)
            cq (boolean (re-find #"\)\s*const(\s|$|&)" q))
            fid (or (some (fn [id] (let [f (sema/fnd id)]
                                     (when (and (= k (:kind f)) (or (#{:ctor :dtor} k) (= (:name f) (:name n))) (= cq (boolean (:cq f)))
                                                (= (mapv abi/unq (:ps (:ty f))) (mapv abi/unq (:ps ty))))
                                       id)))
                          (:methods c))
                    (fail :template "no member " (:name n) " to specialize"))
            pn (filter #(= "ParmVarDecl" (:kind %)) (kids n))]
        (upd-fn! fid #(-> % (assoc :body (sema/body-of n) :node n :def-scope scope
                                   :inits (filter (fn [k] (= "CXXCtorInitializer" (:kind k))) (kids n)) :param-names (mapv :name pn)
                                   :inline (boolean (:inline n)) :spec-member true)
                          (dissoc :lazy :keep-def-scope :analyzed)
                          ;; a header's: analyzed when used (G4)
                          (cond-> (sema/header-node? n) (assoc :lazy true))))))
    :template))

(defn- attach-member-template!
  "A member template defined outside its class (o: {:node FunctionTemplateDecl :pnames outer names}) given to the
  class `cid`'s member template of its name: its pattern, parameters and a scope binding the outer names."
  [cid o outer-params]
  (let [n (:node o)
        c (abi/cls cid)
        params (tparams n)
        cands (filter #(and (= :tmpl (:e %)) (= :fn (:tk %)) (= (count params) (count (:params (tmpl (:id %))))))
                      (.get ^java.util.HashMap (:names (:scope c)) (:name n)))
        ;; of overloaded member templates, the one declared with the same spelling (G4: basic_string's _M_construct
        ;; for input and forward iterators)
        qt (get-in (first (filter #(#{"FunctionDecl" "CXXMethodDecl"} (:kind %)) (kids n))) [:type :qualType])
        ;; (the spellings with the parameters' names replaced by their positions: _InIterator and _FwdIterator alike)
        norm (fn [x ps] (reduce (fn [t [i p]] (if (:name p) (str/replace t (re-pattern (str "\\b" (java.util.regex.Pattern/quote (:name p)) "\\b")) (str "#P" i)) t))
                                (str/replace (str x) #"\s+" " ") (map-indexed vector ps)))
        mid (:id (or (first (filter #(= (norm qt params) (norm (get-in (:pattern (tmpl (:id %))) [:type :qualType]) (:params (tmpl (:id %))))) cands)) (first cands)))]
    (when-not (or mid (sema/header-node? n)) (fail :template "no member template " (:name n) " to define"))
    ;; (a header's whose declaration in the class was dropped: none to define, G4)
    (when mid
    (upd-tmpl! mid assoc :pattern (first (filter #(#{"FunctionDecl" "CXXMethodDecl"} (:kind %)) (kids n))) :params params :sig nil
               :scope (if (seq (:pnames o))
                        (bind-scope (:scope c) (mapv (fn [nm p] {:name nm :kind (:kind p)}) (:pnames o) outer-params) (:targs c) nil)
                        (:scope c))))))

(defn- ool-member-template!
  "template <class T> template <class U> R A<T>::f(U) {...}: the member template's definition for each specialization
  of the primary; template <> template <class U> R A<int>::f(U): for that specialization only."
  [scope n [cn qt]]
  ;; the pattern's range starts at the outer template header (the FunctionTemplateDecl's at the inner one)
  (let [text (or (node-text (first (filter #(#{"FunctionDecl" "CXXMethodDecl"} (:kind %)) (kids n)))) "")]
    (if (re-find #"^\s*template\s*<\s*>" text)
      (let [cls (sema/resolve-type scope qt)]
        (attach-member-template! (:id cls) {:node n :pnames []} []))
      (let [tid (ool-class-template scope cn qt)
            o {:node n :pnames (header-params text)}]
        (upd-tmpl! tid update :ool-tmpls (fnil conj []) o)
        (doseq [[_ cid] (:insts (tmpl tid))] (when (:from-primary (abi/cls cid)) (attach-member-template! cid o (:params (tmpl tid)))))))
    :template))

(defn- explicit-fn-instantiation!
  "CP305 (a), the checker: an explicit instantiation definition of a function template ([temp.explicit]/10: `template R
  f<args>(params);` instantiates the definition there), its specialization found as an explicit specialization's is
  ([temp.deduct.decl]: the written arguments, then deduction from its type) and its definition analyzed as a used one's
  (made eager, entered in the order), so its errors are judged. A declaration whose template or arguments the slice
  cannot resolve is left (the code generator's explicit instantiations stay as they were: emitted when used)."
  [scope n]
  (let [fname (:_fname n)
        text (str (:_text n))
        ;; the written template arguments after the name: `f<int, int, char>`
        targs (let [m (re-matcher (re-pattern (str "(?<![A-Za-z0-9_])" (java.util.regex.Pattern/quote fname) "\\s*<")) text)]
                (when (.find m)
                  (let [i (.start m) b (dec (.end m))]
                    (loop [j (inc b) d 1]
                      (when (< j (count text))
                        (let [c (.charAt text j)]
                          (cond (= c (char 60)) (recur (inc j) (inc d))
                                (= c (char 62)) (if (= d 1) (subs text i (inc j)) (recur (inc j) (dec d)))
                                (= c (char 40)) nil
                                :else (recur (inc j) d))))))))
        ft (try (dissoc (abi/unq (sema/resolve-type scope (:_ftype n))) :cq) (catch arbace.lang.ExceptionInfo _ nil))
        es (try (sema/lookup scope fname) (catch arbace.lang.ExceptionInfo _ nil))
        found (when (and ft (abi/fn? ft))
                (keep (fn [e]
                        (when (and (= :tmpl (:e e)) (= :fn (:tk e)))
                          (let [t (tmpl (:id e))]
                            (try (let [ex (if targs (explicit-args t targs scope) [])
                                       b (atom (into {} (map-indexed vector ex)))]
                                   (when (deduce-type b (:id t) (sym-sig t) ft)
                                     (when-let [args (finish-deduction t @b)] [t args])))
                                 (catch arbace.lang.ExceptionInfo x (when (System/getenv "CPP_EXPLICIT_TRACE") (binding [*out* *err*] (println "explicit instantiation" fname targs (.getMessage x)))) nil)))))
                      es))]
    (when (= 1 (count found))
      (let [[t args] (first found)
            fid (try (instantiate-fn (:id t) args) (catch arbace.lang.ExceptionInfo _ nil))
            f (when fid (sema/fnd fid))]
        (when (:lazy f)
          (upd-fn! fid dissoc :lazy)
          (swap! sema/*order* conj [:fn fid]))))))

(defn- constraint-spelling
  "CP300 (a), [temp.over.link]/7: a function template's constraints as written (its type-constraints, its requires-clause,
  its trailing requires-clause), the template parameters' names replaced by their positions: two declarations of the same
  template spell them alike (equivalent), else they declare two templates."
  [params rc trc]
  (let [txt (str (pr-str (map (juxt :tc :tc-args) params)) " | " (some-> rc node-text) " | " (some-> trc node-text))]
    (reduce (fn [^String s [i p]]
              (if (string? (:name p))
                (str/replace s (re-pattern (str "(?<![A-Za-z0-9_])" (java.util.regex.Pattern/quote (:name p)) "(?![A-Za-z0-9_])")) (str "\\$" i))
                s))
            (str/replace txt #"\s+" " ")
            (map-indexed vector params))))

(defn declare-template
  "The :declare hook: a template's declaration node entered (nil when the node is not one of a template's)."
  [scope n]
  (case (:kind n)
    "ClassTemplateDecl"
    (if-let [[cn qt nested] (when (:completeDefinition (first (filter #(= "CXXRecordDecl" (:kind %)) (kids n)))) (ool-qualifier n))]
      ;; a member class of a class template defined outside it (G5: basic_ostream<_CharT, _Traits>::sentry)
      (let [tid (ool-class-template scope cn qt)
            o {:k :class :node (first (filter #(= "CXXRecordDecl" (:kind %)) (kids n))) :pnames (mapv :name (tparams n)) :nested nested}]
        (upd-tmpl! tid update :ool (fnil conj []) o)
        (doseq [[_ cid] (:insts (tmpl tid))] (when (:from-primary (abi/cls cid)) (attach-one! tid cid o)))
        :template)
    (let [pattern (first (filter #(= "CXXRecordDecl" (:kind %)) (kids n)))
          scope (class-key-scope scope n)
          old (find-template scope (:name n) :class)
          tid (or old (next-id))]
      (if old
        ;; the definition's parameters, the earlier declarations' default arguments kept ([temp.param]/12; G4:
        ;; basic_string's defaults are on its declaration in <stringfwd.h>)
        (if (:completeDefinition pattern)
          (let [olds (:params (tmpl tid)) news (tparams n)]
            (upd-tmpl! tid assoc :pattern pattern
                       :params (vec (map-indexed (fn [i p] (if (and (nil? (:default p)) (:default (get olds i))) (inherit-default p olds news i) p))
                                                 news)))
            ;; (CP372 (a): its instances named before, completed in place)
            (template-defined! tid))
          ;; a later declaration's defaults merged (G5: <iosfwd>'s istreambuf_iterator declared again after its
          ;; definition, by the headers' retry)
          (let [news (tparams n)]
            (upd-tmpl! tid update :params (fn [ps] (vec (map-indexed (fn [i p] (if (and (nil? (:default p)) (:default (get news i))) (inherit-default p news ps i) p)) ps))))))
        (do (swap! *tmpls* assoc tid {:id tid :tk :class :name (:name n) :scope scope :path (:path scope) :params (tparams n)
                                      :class-constraint (:requiresClause n)
                                      :pattern (when (:completeDefinition pattern) pattern) :pos (:_b n) :insts {} :specs {} :partials [] :ool []})
            (enter! scope (:name n) {:e :tmpl :tk :class :id tid :pos (long (or (:_b n) 0))})))
      :template))
    "FunctionTemplateDecl"
    (if-let [gd (first (filter #(= "CXXDeductionGuideDecl" (:kind %)) (kids n)))]
      ;; CP311 (a): a deduction guide template, recorded on its class template
      (or (user-guide! scope n (tparams n) gd) :template)
    (if-let [q (ool-qualifier (first (filter #(#{"FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXConversionDecl"} (:kind %)) (kids n))))]
      (ool-member-template! scope n q)
    (let [pattern (first (filter #(#{"FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXConversionDecl"} (:kind %)) (kids n)))
          _ (when (= "CXXConversionDecl" (:kind pattern)) (fail :template "a conversion function template"))
          ctor? (= "CXXConstructorDecl" (:kind pattern))
          body? (sema/body-of pattern)
          qt (get-in pattern [:type :qualType])
          ;; a redeclaration (a declaration, then the definition) is the same template
          ;; (CP300 (a): the constraints too, [temp.over.link]/7: templates that differ only by them are two)
          cspell (constraint-spelling (tparams n) (:requiresClause n) (:trailingRequiresClause pattern))
          same-cons? (fn [tid] (let [t (tmpl tid)] (= cspell (constraint-spelling (:params t) (:constraint t) (:trailingRequiresClause (:pattern t))))))
          old (some #(when (and (= :tmpl (:e %)) (= :fn (:tk %)) (= qt (get-in (:pattern (tmpl (:id %))) [:type :qualType]))
                                (= (map (juxt :kind :qt :pack) (tparams n)) (map (juxt :kind :qt :pack) (:params (tmpl (:id %)))))
                                (same-cons? (:id %)))
                       (:id %))
                    (.get ^java.util.HashMap (:names scope) (:name n)))
          ;; a functionally equivalent redeclaration spelled otherwise ([temp.over.link]/5; G4: <type_traits>'s
          ;; `_Require<...> swap(_Tp&, _Tp&)` and <bits/move.h>'s `typename enable_if<...>::type swap(...)`): the same
          ;; signature with the template's own parameters
          ;; (the template parameter lists equivalent, [temp.over.link]/6: a non-type parameter's type too, spelled with
          ;; the parameters by position -- std::pair's two C++17 default constructors differ only there, enable_if<A, bool>
          ;; and enable_if<B, bool>, and the explicit one was taken for the implicit one's redeclaration; cpp-route)
          pspell (fn [ps] (let [nms (keep :name ps)
                                re (when (seq nms) (re-pattern (str "\\b(" (str/join "|" (map #(java.util.regex.Pattern/quote %) nms)) ")\\b")))
                                ix (into {} (map-indexed (fn [i p] [(:name p) i]) ps))]
                            (mapv (fn [p] [(:kind p) (boolean (:pack p))
                                           (when (= :value (:kind p))
                                             (let [q (str/replace (str (:qt p)) #"\s+" "")]
                                               (if re (str/replace q re #(str "#" (ix (first %)))) q)))])
                                  ps)))
          old (or old
                  (let [ps (tparams n)
                        cands (filter #(and (= :tmpl (:e %)) (= :fn (:tk %))
                                            (= (pspell ps) (pspell (:params (tmpl (:id %)))))
                                            (same-cons? (:id %)))
                                      (.get ^java.util.HashMap (:names scope) (:name n)))]
                    (when (seq cands)
                      (when-let [sig (try (dissoc (sema/resolve-type (bind-scope scope ps nil -1) qt) :cq) (catch arbace.lang.ExceptionInfo x (when (System/getenv "CPP_EQ_TRACE") (binding [*out* *err*] (println "equiv" (:name n) (.getMessage x)))) nil))]
                        (when (System/getenv "CPP_EQ_TRACE") (binding [*out* *err*] (println "equiv" (:name n) (pr-str (canonical sig)) (pr-str (map #(canonical (try (sym-sig (tmpl (:id %))) (catch arbace.lang.ExceptionInfo _ nil))) cands)))))
                        (some #(when (= (unspelled (canonical sig)) (unspelled (canonical (try (sym-sig (tmpl (:id %))) (catch arbace.lang.ExceptionInfo _ nil))))) (:id %)) cands)))))]
      (if old
        ;; the definition replaces the declaration; the declarations' default arguments are kept ([dcl.fct.default]/4)
        (when body? (upd-tmpl! old #(assoc % :pattern pattern :params (tparams n) :sig nil :decls (conj (vec (:decls %)) (:pattern %)))))
        (let [tid (next-id)]
          (swap! *tmpls* assoc tid {:id tid :tk :fn :name (:name n) :scope scope :path (:path scope) :params (tparams n) :pattern pattern
                                    :pos (:_b n) :insts {} :constraint (:requiresClause n)
                                    ;; (the rest of CP313 (a): a member template's access, its specializations')
                                    :access (when (:cls scope) sema/*member-access*)})
          ;; a constructor template is found through its class (class-init's candidates), not by name
          (if ctor?
            (abi/update-cls! (:cls scope) update :ctor-tmpls (fnil conj []) tid)
            (enter! scope (:name n) {:e :tmpl :tk :fn :id tid :pos (long (or (:_b n) 0))}))))
      :template)))
    "CXXDeductionGuideDecl" (or (user-guide! scope n [] n) :template)
    ;; a concept ([temp.concept]): its parameters and constraint expression; a concept-id is its satisfaction (G4)
    "ConceptDecl"
    (if-let [cx (:constraintExpr n)]
      (let [tid (next-id)]
        (swap! *tmpls* assoc tid {:id tid :tk :concept :name (:name n) :scope scope :path (:path scope) :params (tparams n) :expr cx :pos (:_b n)})
        (enter! scope (:name n) {:e :tmpl :tk :concept :id tid :pos (long (or (:_b n) 0))})
        :template)
      (fail :template "a concept without its constraint"))
    "FriendDecl" (friend! scope n)
    ;; an explicit instantiation (template struct A<int>; extern template ...): the definitions clang emits weak_odr are
    ;; emitted here only when used (the names check takes ours among clang's)
    ;; (G5: an explicit instantiation declaration of a class template's specialization, extern template class X<A>:
    ;; its members are the library's, clang emitting none of them at -O0 but the always-inline ones,
    ;; CodeGenModule::shouldEmitFunction with TSK_ExplicitInstantiationDeclaration)
    "ExplicitInstantiationDecl"
    (do (when (and (not (:_extern n)) (:_fname n) (:_ftype n) (sema/checking?))
          (explicit-fn-instantiation! scope n))
        (when-let [[_ t] (and (:_extern n) (re-matches #"(?s)\s*(?:class|struct)\s+(.*?)\s*" (str (:_text n))))]
          (when-let [ty (sema/resolve-type scope t)]
            (when (abi/class? ty) (abi/update-cls! (:id ty) assoc :extern-inst true))))
        ;; (CP321 (a), the checker: an explicit instantiation definition of a class, its static members' in-class
        ;; initializers then analyzed, [temp.explicit]/10)
        (when-let [[_ t] (and (not (:_extern n)) (sema/checking?) (re-matches #"(?s)\s*(?:class|struct|union)\s+(.*?)\s*" (str (:_text n))))]
          (when-let [ty (try (sema/resolve-type scope t) (catch arbace.lang.ExceptionInfo _ nil))]
            (when (abi/class? ty) (abi/update-cls! (:id ty) assoc :explicit-inst-def true))))
        ;; extern template R f(params): the function template's specialization of that type (deduced from it,
        ;; [temp.explicit]/7) the library's
        (when (and (:_extern n) (:_fname n) (:_ftype n))
          ;; (a type not declared yet refuses it: the headers' retry declares it again after them)
          (when-let [ft (abi/unq (sema/resolve-type scope (:_ftype n)))]
            (when (abi/fn? ft)
              (let [es (try (sema/lookup scope (:_fname n)) (catch arbace.lang.ExceptionInfo _ nil))
                    tids (keep #(when (and (= :tmpl (:e %)) (= :fn (:tk %))) (:id %)) es)]
                (when (System/getenv "CPP_EXTERN_TRACE") (binding [*out* *err*] (println "extern template" (:_fname n) (:_ftype n) (count tids) (count (fnaddr-specs {:tmpls tids} ft)))))
                (doseq [fid (fnaddr-specs {:tmpls tids} ft)]
                  (let [f (sema/fnd fid)]
                    (when (and (= (mapv abi/unq (:ps (:ty f))) (mapv abi/unq (:ps ft))) (= (abi/unq (:ret (:ty f))) (abi/unq (:ret ft))))
                      (upd-fn! fid assoc :extern-inst true))))))))
        :template)
    ("TypeAliasTemplateDecl" "VarTemplateDecl")
    (let [tk (if (= "VarTemplateDecl" (:kind n)) :var :alias)
          pattern (first (filter #(#{"TypeAliasDecl" "VarDecl"} (:kind %)) (kids n)))
          tid (next-id)]
      (swap! *tmpls* assoc tid {:id tid :tk tk :name (:name n) :scope scope :path (:path scope) :params (tparams n) :pattern pattern
                                :pos (:_b n) :insts {} :constraint (:requiresClause n)})
      (enter! scope (:name n) {:e :tmpl :tk tk :id tid :pos (long (or (:_b n) 0))})
      :template)
    ;; (CP338 (a): a variable template's partial specialization, kept as a class template's is: its arguments as written
    ;; after its name, matched when a specialization is named, var-template-inst)
    "VarTemplatePartialSpecializationDecl"
    (let [tid (or (some #(when (and (= :tmpl (:e %)) (= :var (:tk %))) (:id %)) (sema/lookup scope (:name n))) (fail :template "no primary variable template " (:name n)))
          t (tmpl tid)
          pid (next-id)
          params (tparams n)
          ss (bind-scope (:scope t) params nil pid)
          forms (var-text-args n)
          args (resolve-args ss t forms true)]
      (upd-tmpl! tid update :partials (fnil conj [])
                 {:id pid :params params :args args :node n :constraint (:requiresClause n) :scope (:scope t) :forms forms :tmpl t})
      :template)
    "ClassTemplatePartialSpecializationDecl"
    (let [tid (or (some #(when (and (= :tmpl (:e %)) (= :class (:tk %))) (:id %)) (sema/lookup (class-key-scope scope n) (:name n))) (fail :template "no primary template " (:name n)))
          t (tmpl tid)
          pid (next-id)
          params (tparams n)
          ss (bind-scope (:scope t) params nil pid)
          args (partial-args ss t (template-text-args n))]
      ;; a redeclaration of a partial specialization (its declaration, then its definition: <iterator_concepts.h>'s
      ;; iterator_traits<_Tp*>) is the same one, its definition kept (G4); its requires-clause its constraint (P14 (b))
      ;; (CP311 (a)'s measure: two partial specializations of the same arguments that differ in their constraints are two,
      ;; [temp.spec.partial.general]/1 with [temp.over.link]/7; concepts-class's S3<T> requires Class<T>, requires Union<T>)
      (let [cspell (fn [rc] (some-> rc node-text str/trim))
            ;; (cpp-s8: and in their parameters' type-constraints, [temp.param]/4: <iterator_concepts.h>'s
            ;; indirectly_readable_traits<__has_member_value_type _Tp> and <__has_member_element_type _Tp>, the second
            ;; had replaced the first, so a __normal_iterator had no value_type and iter_value_t none)
            tcs (fn [ps] (mapv (juxt :tc :tc-args) ps))
            same (first (filter #(and (= (canonical (:args %)) (canonical args)) (= (cspell (:constraint %)) (cspell (:requiresClause n)))
                                      (= (tcs (:params %)) (tcs params)))
                                (:partials t)))
            pt {:id pid :params params :args args :node n :constraint (:requiresClause n) :scope (:scope t)
                :forms (template-text-args n) :tmpl t}]
        (if same
          (when (:completeDefinition n)
            (upd-tmpl! tid update :partials (fn [ps] (mapv #(if (identical? % same) pt %) ps))))
          (upd-tmpl! tid update :partials conj pt)))
      :template)
    "ClassTemplateSpecializationDecl"
    (let [tid (or (some #(when (and (= :tmpl (:e %)) (= :class (:tk %))) (:id %)) (sema/lookup (class-key-scope scope n) (:name n))) (fail :template "no primary template " (:name n)))
          t (tmpl tid)
          args (complete-args t (vec (map-indexed (fn [i a] (node-arg scope (nth (:params t) i) a)) (filter #(= "TemplateArgument" (:kind %)) (kids n)))))]
      (if (:completeDefinition n)
        (do (upd-tmpl! tid assoc-in [:specs args] n)
            (let [ic (get-in @*tmpls* [tid :insts args])]
              (cond (nil? ic) (declare-instance! (tmpl tid) args n [] [] true)
                    ;; (CP372 (a): an incomplete instance named before its explicit specialization: completed by it)
                    (incomplete-waiting? tid ic) (complete-instance! (tmpl tid) ic #(declare-instance! (tmpl tid) args n [] [] true ic)))))
        nil)
      :template)
    ("FunctionDecl" "CXXMethodDecl" "CXXConstructorDecl" "CXXDestructorDecl" "VarDecl")
    (let [text (or (node-text n) "")]
      (cond
        ;; an explicit specialization of a function template
        (and (#{"FunctionDecl" "CXXMethodDecl"} (:kind n))
             (or (some #(= "TemplateArgument" (:kind %)) (kids n)) (re-find #"^\s*template\s*<\s*>" text))
             (not (ool-class-name n)))
        ;; a member template's of a class named by a plain qualifier (template <> void S1::f(int*))
        (if-let [q (seq (#'sema/qualifier-before n))]
          (let [e (first (filter #(= :type (:e %)) (sema/lookup-qualified scope (vec q))))]
            (if (and e (abi/class? (:ty e)))
              (explicit-fn-spec! (:scope (abi/cls (:id (:ty e)))) n (:id (:ty e)))
              (explicit-fn-spec! scope n)))
          (explicit-fn-spec! scope n))
        ;; a member of a class template defined outside it
        (and (re-find #"^\s*template\s*<\s*[^>\s]" text) (ool-class-name n))
        (let [[cn qt] (ool-qualifier n)
              tid (ool-class-template scope cn qt)
              t (tmpl tid)
              pnames (header-params text)
              o {:k (if (= "VarDecl" (:kind n)) :var :fn) :node n :pnames pnames :nested (nth (ool-qualifier n) 2 nil)}
              ;; a partial specialization's member: the qualifier's arguments, with the header's names standing for the
              ;; partial's parameters, are the partial's
              forms (let [f (ct/parse-type qt)] (when (and (seq? f) (= '<> (first f))) (nnext f)))
              pt (first (for [pt (:partials t)
                              :when (= (count pnames) (count (:params pt)))
                              :let [ss (bind-scope (:scope t) (mapv (fn [nm p] (assoc p :name nm)) pnames (:params pt)) nil (:id pt))
                                    qa (try (resolve-args ss t forms true) (catch arbace.lang.ExceptionInfo _ nil))]
                              :when (and qa (= (canonical qa) (canonical (:args pt))))]
                          pt))]
          (if pt
            (do (upd-tmpl! tid update :partials (fn [ps] (mapv #(if (= (:id %) (:id pt)) (update % :ool (fnil conj []) o) %) ps)))
                (doseq [[_ cid] (:insts (tmpl tid))]
                  (when-let [pb (:from-partial (abi/cls cid))] (when (= (:id pt) (first pb)) (attach-one! tid cid o (rest pb))))))
            (do (upd-tmpl! tid update :ool conj o)
                (doseq [[_ cid] (:insts (tmpl tid))] (when (:from-primary (abi/cls cid)) (attach-one! tid cid o)))))
          :template)
        ;; an explicit specialization of a member template of a class specialization (template <> template <> R A<int>::f<7>(...))
        (re-find #"^\s*template\s*<\s*>\s*template\s*<\s*>" text)
        (let [[_ qt] (or (ool-qualifier n) (fail :template "an explicit specialization's qualifier"))
              cls (sema/resolve-type scope qt)]
          (when-not (abi/class? cls) (fail :template "an explicit specialization of a member of " qt))
          (explicit-fn-spec! (:scope (abi/cls (:id cls))) n (:id cls)))
        (re-find #"^\s*template\s*<\s*>\s*template" text) (fail :template "an explicit specialization of a member template")
        ;; an explicit specialization of a member of a class template's specialization (template <> int Box<int>::get())
        (re-find #"^\s*template\s*<\s*>" text) (explicit-member-spec! scope n)
        :else nil))
    nil))

;; ---------------------------------------------------------------------------------------------
;; Definitions instantiated on use: each round of analysis, the lazy members and specializations its bodies reference

(defn- walk-refs
  "Collects into `acc` (atom {:fns #{} :vars #{} :classes #{}}) the functions, variables and classes a typed body
  references (not the native tree's nodes, not scopes)."
  [acc x]
  (cond
    (map? x) (when-not (:kind x)
               (when (integer? (:fn x)) (swap! acc update :fns conj (:fn x)))
               (when (and (= :var (:op x)) (integer? (:id x))) (swap! acc update :vars conj (:id x)))
               (when (and (= :class (:k x)) (integer? (:id x))) (swap! acc update :classes conj (:id x)))
               (when (integer? (:var x)) (swap! acc update :vars conj (:var x)))
               (doseq [[k v] x :when (not (#{:scope :node :def-scope :parent :names :usings} k))] (walk-refs acc v)))
    (sequential? x) (doseq [y x] (walk-refs acc y))
    :else nil))

(defn- class-closure
  "The class with its bases and the classes of its members, recursively."
  [cid]
  (loop [todo [cid] seen #{}]
    (if-let [c (first todo)]
      (if (seen c)
        (recur (rest todo) seen)
        (let [k (abi/cls c)]
          (recur (concat (rest todo) (map :cls (:bases k))
                         (keep (fn [f] (let [t (loop [t (:ty f)] (if (abi/arr? t) (recur (:of t)) t))] (when (abi/class? t) (:id t)))) (:fields k)))
                 (conj seen c))))
      seen)))

(defn- extern-class?
  "Whether the class (or a class enclosing it) is named by an explicit instantiation declaration."
  [cid]
  (loop [cid cid]
    (when cid
      (let [c (abi/cls cid)]
        (or (:extern-inst c)
            (recur (loop [s (:outer c)] (cond (nil? s) nil (:cls s) (:cls s) :else (recur (:parent s))))))))))

(defn pending
  "The :pending hook: the lazy definitions the analyzed bodies reference, made eager ([[:fn id] [:var id] ...])."
  []
  (let [acc (atom {:fns #{} :vars #{} :classes #{}})]
    (doseq [[id f] @sema/*fns* :when (and (or (:analyzed f) (:tbody f)) (not (contains? @*scanned* [:fn id])))]
      (swap! *scanned* conj [:fn id])
      (walk-refs acc [(:tbody f) (:tinits f) (:tassign f)])
      (doseq [v (:statics f)] (walk-refs acc (:sinit (sema/var* v)))))
    ;; (a destructor or constructor defaulted out of line, G5c's nested_exception::~nested_exception() = default: its class's
    ;; members' and bases' destructors used, as its definition destroys them)
    (doseq [[_ f] @sema/*fns* :when (and (:out-of-line-default f) (:cls f))] (swap! acc update :classes conj (:cls f)))
    (doseq [[id v] @sema/*vars*]
      (when (and (:ginit v) (not (contains? @*scanned* [:var id]))) (swap! *scanned* conj [:var id]) (walk-refs acc (:ginit v)))
      ;; (a variable not defined, a header's not used among them, uses no class's members: G4)
      (when-not (or (:pending-def v) (and (#{:global :member-static} (:storage v)) (not (:defined v))))
        (let [t (loop [t (abi/non-ref (:ty v))] (if (abi/arr? t) (recur (:of t)) t))] (when (abi/class? (abi/unq t)) (swap! acc update :classes conj (:id t))))))
    (let [classes (reduce into #{} (map class-closure (:classes @acc)))
          fns (into (:fns @acc)
                    (mapcat (fn [cid] (let [c (abi/cls cid)]
                                         (concat (when (:dtor c) [(:dtor c)]) (when (abi/dynamic? cid) (keep :fn (:vtable c)))
                                                 ;; a deleting destructor's operator delete (the class's own)
                                                 (when (and (:dtor c) (:virtual (sema/fnd (:dtor c)))) (keep :fn [(sema/dtor-dealloc cid)])))))
                            classes))
          out (atom [])]
      (doseq [id fns :let [f (sema/fnd id)] :when (:lazy f)]
        (upd-fn! id dissoc :lazy)
        ;; a specialization declared before its template was defined (a friend's definition in a class instantiated
        ;; later): its definition taken from the template now, as clang's end-of-unit instantiation sees it
        (when-let [ti (and (not (:body f)) (:tinst f))]
          (let [t (tmpl (:tid ti)) pat (:pattern t)]
            (when-let [body (sema/body-of pat)]
              (upd-fn! id assoc :body body :node pat :def-scope (bind-scope (:scope t) (:params t) (:args ti) nil)
                       :param-names (mapv :name (filter #(= "ParmVarDecl" (:kind %)) (kids pat)))))))
        (swap! out conj [:fn id]))
      (doseq [id (:vars @acc) :let [v (sema/var* id)] :when (:pending-def v)
              ;; (a static member of a class an explicit instantiation declaration names: the library's, G5)
              :when (if (extern-class? (:of-cls v)) (do (upd-var! id #(-> % (assoc :extern true :defined false) (dissoc :pending-def))) false) true)]
        (upd-var! id #(-> % (assoc :defined true) (dissoc :pending-def)))
        ;; a constant integral variable's initializer folded, as clang emits it (a constant, no guard)
        (let [t (:ty v)]
          (when (and (:c t) (abi/integral? (abi/unq t)) (:init v))
            (when-let [c (try (binding [sema/*cutoff* Long/MAX_VALUE] (sema/const-int (:def-scope v) (:init v))) (catch arbace.lang.ExceptionInfo _ nil))]
              (upd-var! id assoc :ginit {:i :expr :e {:op :int :v c :ty (abi/unq t) :cat :pr}}))))
        (swap! out conj [:var id]))
      @out)))

;; ---------------------------------------------------------------------------------------------
;; CP311 (a): class template argument deduction ([over.match.class.deduct], [dcl.type.class.deduct]), after clang's
;; SemaTemplateDeductionGuide.cpp (DeclareImplicitDeductionGuides, ConvertConstructorToDeductionGuideTransform's
;; transformConstructor and buildSimpleDeductionGuide, DeclareAggregateDeductionGuideFromInitList) and SemaInit.cpp's
;; DeduceTemplateSpecializationFromInitializer at llvmorg-23.1.5 (read as the model, the pinned tarball). The guides
;; are function templates of this namespace's own (:tk :guide): a constructor's, the class template's parameters then
;; the constructor's own, its parameter types in a scope binding them (the pattern's member typedefs entered as the
;; transform substitutes them); the hypothetical C() when the class declares no constructor; the copy deduction
;; candidate C(C<P...>); the user's deduction guides; C++20's aggregate deduction candidate. Each is deduced by
;; deduce-call, its specialization a function of the slice (name "<deduction guide for C>", removed after) among which
;; resolve-overload chooses, with [over.match.best]/2.9-2.11's tie-breaks in `tiebreak`; the chosen one's return type is
;; the deduced class. A deduction that fails by the algorithm (no *unsure*) is a sure drop; a guide the slice cannot
;; build or substitute, an unsure one: no viable guide is the program's error only when every drop was sure.

(defn- guide-class-name [n] (second (re-find #"^<deduction guide for (.*)>$" (str (:name n)))))

(defn- explicit-guide?
  "A deduction guide's or constructor's explicit-specifier, read from its text before the name's ( (`explicit(false)`
  not explicit; another explicit(...) explicit, as sema's explicit-spec counts it)."
  [n cname]
  (let [t (or (node-text n) "")
        m (re-matcher (re-pattern (str "(?<![A-Za-z0-9_$])" (java.util.regex.Pattern/quote cname) "\\s*\\(")) t)
        head (if (.find m) (subs t 0 (.start m)) t)]
    (boolean (and (re-find #"(?<![A-Za-z0-9_$])explicit(?![A-Za-z0-9_$])" head)
                  (not (re-find #"explicit\s*\(\s*false\s*\)" head))))))

(defn- user-guide!
  "A deduction guide declared (a CXXDeductionGuideDecl, `n` its FunctionTemplateDecl or itself): recorded on its class
  template, nil when none is found by its name."
  [scope n params gd]
  (when-let [cn (guide-class-name gd)]
    (when-let [tid (some #(when (and (= :tmpl (:e %)) (#{:class :alias} (:tk %))) (:id %)) (sema/lookup scope cn))]
      (upd-tmpl! tid update :guides (fnil conj [])
                 {:node gd :params params :scope scope :explicit (explicit-guide? gd cn) :constraint (:requiresClause n)})
      :template)))

(def ^:dynamic *ctad-unsure* nil) ; an atom: a guide the slice could not build, deduce or substitute

(defn- guide-scope
  "The scope of a guide's parameters over `parent`: symbolic (`gid`, no args) or bound to `args`; the pattern's member
  typedefs and alias declarations entered, resolved in it (a member typedef in a constructor's parameter stands for its
  type, TransformTypedefType of the transform)."
  [parent params args gid pattern]
  (let [s (bind-scope parent params args (when-not args gid))]
    (doseq [k (when pattern (kids pattern)) :when (#{"TypedefDecl" "TypeAliasDecl"} (:kind k))]
      (when-let [ty (try (binding [sema/*cutoff* Long/MAX_VALUE] (sema/resolve-type s (get-in k [:type :qualType])))
                         (catch arbace.lang.ExceptionInfo _ nil))]
        (enter! s (:name k) {:e :type :ty ty :pos -1})))
    s))

(defn- ctor-nodes
  "The pattern's declared constructors: [node ctor-template-node-or-nil] each."
  [pattern]
  (for [k (kids pattern)
        :let [ft (when (= "FunctionTemplateDecl" (:kind k)) k)
              c (if ft (first (filter #(= "CXXConstructorDecl" (:kind %)) (kids ft))) k)]
        :when (= "CXXConstructorDecl" (:kind c))]
    [c ft]))

(defn- param-defaults [n]
  (mapv (fn [p] (first (remove #(str/ends-with? (str (:kind %)) "Attr") (kids p)))) (filter #(= "ParmVarDecl" (:kind %)) (kids n))))

(defn- self-text
  "The class template's own template-id written with its parameters' names (C<T, Ts...>)."
  [t]
  (str (:name t) "<" (str/join ", " (map #(str (:name %) (when (:pack %) "...")) (:params t))) ">"))

(defn- aggregate-pattern?
  "[dcl.init.aggr]/1 for the primary template's pattern ([over.match.class.deduct]/1.4, a dependent base assumed to have
  no virtual functions or bases): no user-declared constructor, no private or protected direct non-static data member,
  no virtual function, no virtual, private or protected base."
  [pattern]
  (let [default (if (= "class" (:tagUsed pattern)) "private" "public")]
    (and (empty? (ctor-nodes pattern))
         (not (some #(and (= "CXXMethodDecl" (:kind %)) (:virtual %)) (kids pattern)))
         (every? #(and (not (:isVirtual %)) (= "public" (let [a (:writtenAccess %)] (if (or (nil? a) (= "none" a)) default a)))) (:bases pattern))
         (loop [ks (kids pattern) acc default]
           (if-let [k (first ks)]
             (cond (= "AccessSpecDecl" (:kind k)) (recur (rest ks) (:access k))
                   (and (= "FieldDecl" (:kind k)) (not= "public" acc)) false
                   :else (recur (rest ks) acc))
             true)))))

(defn- class-guides
  "The class template `tid`'s guides: its constructors' implicit ones, C() when it declares none, the copy deduction
  candidate, its user deduction guides (DeclareImplicitDeductionGuides), registered as templates and kept."
  [tid]
  (let [t (tmpl tid)
        n-user (count (:guides t))]
  (if-let [gs (when (= n-user (:ctad-n-user t)) (:ctad-guides t))]
    gs
      (let [;; (the implicit guides once; the user's guides those declared so far, [over.match.class.deduct]/1's
            ;; deduction-guides found by lookup at the point of the initialization)
            old (:ctad-guides t)
            pat (:pattern t)
            gname (str "<deduction guide for " (:name t) ">")
            reg! (fn [g] (let [gid (next-id)
                               g (assoc g :id gid :tk :guide :name gname :insts {} :ctid tid)
                               sig (try (let [s (guide-scope (:scope g) (:params g) nil gid (:pattern-of g))]
                                          (binding [sema/*cutoff* Long/MAX_VALUE] (dissoc ((:mk g) s) :cq)))
                                        (catch arbace.lang.ExceptionInfo e
                                          (when (System/getenv "CPP_TMPL_TRACE") (binding [*out* *err*] (println "guide" gname (:kind g) "not built:" (.getMessage e))))
                                          nil))
                               g (assoc g :sig sig)]
                           (swap! *tmpls* assoc gid g)
                           g))
            implicit (when pat
                       (let [cs (ctor-nodes pat)
                             ctor (for [[c ft] cs]
                                    (let [qt (get-in c [:type :qualType])]
                                      {:kind (if ft :ctor-tmpl :ctor) :scope (:scope t) :pattern-of pat
                                       :params (into (vec (:params t)) (when ft (tparams ft)))
                                       :mk (fn [s] (sema/resolve-type s qt))
                                       :defaults (param-defaults c) :explicit (explicit-guide? c (:name t))
                                       :constraint (:requiresClause ft) :trailing (:trailingRequiresClause c)}))
                             self (self-text t)]
                         (concat ctor
                                 (when (empty? cs)
                                   [{:kind :ctor :scope (:scope t) :pattern-of pat :params (vec (:params t)) :defaults []
                                     :mk (fn [_] {:k :fn :ps [] :ret abi/void})}])
                                 [{:kind :copy :scope (:scope t) :pattern-of pat :params (vec (:params t)) :defaults [nil]
                                   :mk (fn [s] {:k :fn :ps [(sema/resolve-type s self)] :ret abi/void})}])))
            user (for [u (:guides t)]
                   (let [qt (get-in (:node u) [:type :qualType])]
                     {:kind :user :scope (:scope u) :params (vec (:params u)) :defaults (param-defaults (:node u))
                      :mk (fn [s] (sema/resolve-type s qt)) :explicit (:explicit u) :constraint (:constraint u)
                      :user-node (:node u)}))
            gs (if old
                 (into old (map reg! (drop (count (filter #(= :user (:kind %)) old)) user)))
                 (mapv reg! (concat implicit user)))]
        (upd-tmpl! tid assoc :ctad-guides gs :ctad-n-user n-user)
        gs))))

(defn- aggregate-guide
  "C++20's aggregate deduction candidate for the braced or parenthesized initializer's `items` ([over.match.class.deduct]
  /1.4-1.10; DeclareAggregateDeductionGuideFromInitList with the InitListChecker's element types): the parameters T_i of
  the elements x_i initializes, bases first, an array's an rvalue reference to it for a braced item, a const lvalue one
  for a string literal; nil when the list has more items than elements (no guide), :unsure when brace elision might
  apply or an element is a pack."
  [tid items]
  (let [t (tmpl tid)
        pat (:pattern t)
        elems (concat (map (fn [b] [(get-in b [:type :qualType]) :base]) (:bases pat))
                      (keep (fn [k] (when (and (= "FieldDecl" (:kind k)) (not (and (:isBitfield k) (nil? (:name k))))) [(get-in k [:type :qualType]) (:name k)]))
                            (kids pat)))
        n (count items)]
    (cond
      (some (fn [[qt nm]] (or (nil? qt) (nil? nm) (re-find #"\.\.\.|\(anonymous|\(unnamed" qt))) (take n elems)) :unsure
      (> n (count elems)) nil
      :else
      (let [ss (guide-scope (:scope t) (vec (:params t)) nil -2 pat)
            kinds (for [[[qt _] it] (map vector elems items)]
                    (let [ty (try (binding [sema/*cutoff* Long/MAX_VALUE] (sema/resolve-type ss qt)) (catch arbace.lang.ExceptionInfo _ nil))
                          braced (= :init-list (:op it))
                          str? (= :str (:op it))]
                      (cond
                        (nil? ty) :unsure
                        (abi/arr? ty) (cond braced :rref
                                            str? :clref
                                            (or (dependent? (:n ty)) (map? (:n ty))) :plain
                                            :else :unsure)
                        braced :plain
                        (dependent? ty) :plain
                        ;; a non-dependent aggregate element: its braces may be elided
                        (and (abi/class? ty) (sema/aggregate? ty)) :unsure
                        :else :plain)))]
        (if (some #{:unsure} kinds)
          :unsure
          (let [qts (mapv first (take n elems)) ks (vec kinds)]
            {:kind :aggr :scope (:scope t) :pattern-of pat :params (vec (:params t)) :defaults []
             :mk (fn [s] {:k :fn :ret abi/void
                          :ps (mapv (fn [qt k] (let [ty (sema/resolve-type s qt)]
                                                 (case k :rref (abi/rref ty) :clref (abi/lref (assoc ty :of (assoc (:of ty) :c true))) ty)))
                                    qts ks)})}))))))

(defn- class-and-bases [c] (cons c (mapcat #(class-and-bases (:cls %)) (:bases (abi/cls c)))))

(defn- guide-min-args [g]
  (let [ps (:ps (:sig g)) np (count (remove #(= :pack-exp (:k %)) ps))]
    (- np (count (filter some? (take-last np (:defaults g)))))))

(defn- guide-candidate!
  "The guide `g` deduced from the arguments `args` (`il`: its first parameter an initializer_list<E> deduced from the
  list's elements, [temp.deduct.call]/1), its specialization registered as a function, or nil (a drop, counted in `drops`)."
  [g args il drops]
  (let [u (atom false) sr (atom false)
        cnt (fn [] (swap! drops update (if @u :unsure-drops :sure-drops) (fnil inc 0)) nil)]
    (if (nil? (:sig g))
      (do (reset! u true) (cnt))
      (let [dg (if il (assoc g :sig (assoc (:sig g) :ps (vec (concat (repeat (count (:items (first args))) il) (rest (:ps (:sig g))))))) g)
            dargs (if il (vec (concat (:items (first args)) (rest args))) args)
            at sema/*at* at-saved (some-> at deref)
            r (binding [*unsure* u *sure* sr]
                (try
                  (when-let [a (deduce-call dg [] dargs)]
                    (let [cs (guide-scope (:scope g) (:params g) a nil (:pattern-of g))
                          ;; (CP320 (a): an alias template's guide f' is its class template's guide f with f's parameters
                          ;; bound by the alias's deduction (:fscope); f's constraints judged there)
                          [fs fargs] (if-let [f (:fscope g)] (f cs) [cs a])
                          ok (fn [rc] (or (nil? rc)
                                          (let [d (atom false)
                                                v (binding [sema/*cutoff* Long/MAX_VALUE sema/*constraint-doubt* d] (sema/constraint-satisfied? fs rc))]
                                            (cond v true @d (do (reset! u true) false) :else false))))]
                      (when (and (ok (:class-constraint (tmpl (:ctid g)))) (ok (:constraint g)) (ok (:trailing g)))
                        (let [ft (binding [sema/*cutoff* Long/MAX_VALUE] ((:mk g) cs))
                              cls (if (= :user (:kind g))
                                    (abi/unq (:ret ft))
                                    (let [ct (tmpl (:ctid g))]
                                      (instantiate-class (:ctid g) (or (complete-args ct (subvec (vec fargs) 0 (count (:params ct)))) (fail :template "ctad: missing arguments")))))
                              ;; (CP320 (a), CP323 (a): the deducibility constraint and the alias's own constraints, the class the
                              ;; guide returns for the alias or the derived class; false a sure drop)
                              cls (if-let [res (:result g)] (res cls) cls)
                              _ (when (= :unsure cls) (reset! u true))
                              fid (when (map? cls) (next-id))]
                          (when fid
                            (swap! sema/*fns* assoc fid {:id fid :name (:name g) :kind :guide :ty {:k :fn :ps (vec (:ps ft)) :ret cls :va (:va ft)}
                                                         :defaults (:defaults g) :tinst {:tid (:id g) :args a} :guide (:kind g)
                                                         :inherited (:inherited g) :explicit (:explicit g) :deleted-sure false}))
                          fid))))
                  (catch arbace.lang.ExceptionInfo e
                    (when (System/getenv "CPP_TMPL_TRACE") (binding [*out* *err*] (println "guide" (:name g) (:kind g) "drops out:" (.getMessage e))))
                    (when-not (or (:cx/constraint-false (ex-data e)) (:cx/sure-drop (ex-data e))) (reset! u true))
                    nil)
                  (finally (when at (reset! at at-saved)))))]
      (or r (cnt))))))

(defn- init-list-guide-elem
  "E when the guide's first parameter is std::initializer_list<E> or a reference to one and the rest have default
  arguments (isInitListConstructor), else nil."
  [g]
  (let [ps (:ps (:sig g)) p (first ps)]
    (when (and p (<= (dec (count ps)) (count (filter some? (rest (:defaults g))))))
      (let [q (abi/unq (abi/non-ref (abi/unq p)))]
        (when (and (= :tspec (:k q)) (= "initializer_list" (:name q)) (= [[:ns "std"]] (:path q)))
          (first (:args q)))))))

;; CP320 (a): an alias template's guides ([over.match.class.deduct]/3, C++20; clang's C++17 extension), after clang's
;; SemaTemplateDeductionGuide.cpp at llvmorg-23.1.5 (getRHSTemplateDeclAndArgs, BuildDeductionGuideForTypeAlias,
;; DeclareImplicitDeductionGuidesForTypeAlias, DeclareAggregateDeductionGuideForTypeAlias, buildIsDeducibleConstraint).
;; For each guide f of the class template C its defining-type-id names (aliases desugared), the template arguments of
;; f's return type are deduced from the defining-type-id C<X...> ([temp.deduct.type], a parameter left undeduced
;; allowed); f' has the alias's parameters those deductions name, then f's parameters left undeduced; its function
;; parameters are f's with the deduced ones substituted; its constraints f's, conjoined with the alias's and with
;; is_deducible: f' is viable only when the alias's arguments can be deduced back from the class it returns and give that
;; class ([over.match.class.deduct]/3.3, [temp.deduct.type] as for a partial specialization). In the slice f' is built
;; lazily: its :mk resolves the alias's C<X...> in the scope binding f''s parameters, deduces f's from it again and
;; resolves f's signature there (:fscope gives that scope and f's arguments, where f's constraints are judged); :result
;; is the deducibility check on the class f returns. A guide whose deduction from C<X...> fails can never return a
;; specialization of the alias: no guide. A parameter with a default argument, or a deduction the slice cannot make,
;; makes the guide unsure (nil :sig: the parser's deduction kept when no other guide decides).

(defn- alias-rhs
  "The alias template `at`'s defining-type-id with the alias's own parameters (symbolic), aliases substituted:
  [class-template-id type] when it names a specialization of a class template, else nil."
  [at]
  (let [x (try (binding [sema/*cutoff* Long/MAX_VALUE] (sema/resolve-type (sym-scope at) (get-in (:pattern at) [:type :qualType])))
               (catch arbace.lang.ExceptionInfo _ nil))
        x (some-> x abi/unq)]
    (cond (nil? x) nil
          (and (= :tspec (:k x)) (:tmpl x)) [(:tmpl x) x]
          (abi/class? x) (when-let [ct (:tmpl (abi/cls (:id x)))] [ct x]))))

(defn- entity-arg
  "The template argument a scope's entity for a parameter stands for (arg-entity's inverse)."
  [e]
  (case (:e e)
    :type (:ty e)
    :pack {:pack (:elems e)}
    :nttp (cond-> {:k :tparam-v :i (:i e) :tid (:tid e)} (:pack e) (assoc :pack true))
    :enumerator {:val (:val e) :ty (:ty e)}
    :ttp {:k :ttp :i (:i e) :tid (:tid e)}
    :tmpl (let [t (tmpl (:id e))] {:tmpl (:id e) :name (:name t) :path (:path t)})
    :declconst {:decl (:decl e) :ty (:ty e) :null (:null e)}
    :texpr (:x e)
    (fail :template "ctad: an alias guide's parameter entity " (:e e))))

(defn- guide-ret-pattern
  "The template-id a class guide `g` returns, written with its own parameters (symbolic, its id): the user guide's
  return type, else the class template's own C<T...>."
  [g]
  (let [gid (:id g)]
    (if (= :user (:kind g))
      (some-> (:ret (:sig g)) abi/unq)
      (let [ct (tmpl (:ctid g))]
        (binding [sema/*cutoff* Long/MAX_VALUE]
          (abi/unq (sema/resolve-type (guide-scope (:scope g) (:params g) nil gid (:pattern-of g)) (self-text ct))))))))

(defn- alias-deducible
  "buildIsDeducibleConstraint's check (__is_deducible(A, R)) for the alias template `at` whose defining-type-id is `x`
  (symbolic): the alias's arguments deduced from the class `cls` and the alias's own constraints (its parameters'
  type-constraints, its requires-clause) satisfied by them: the arguments, false (a sure failure) or :unsure."
  [at x cls]
  (let [b (atom {}) u (atom false)
        ok (binding [*unsure* u] (deduce-type b (:id at) x cls))]
    (cond
      @u :unsure
      (not ok) false
      :else
      (let [args (try (finish-deduction at @b) (catch arbace.lang.ExceptionInfo _ ::unsure))]
        (cond
          (= ::unsure args) :unsure
          (nil? args) false
          :else
          (let [as (bind-scope (:scope at) (:params at) args nil)
                back (try (binding [sema/*cutoff* Long/MAX_VALUE] (abi/unq (sema/resolve-type as (get-in (:pattern at) [:type :qualType]))))
                          (catch arbace.lang.ExceptionInfo _ ::unsure))]
            (cond
              (= ::unsure back) :unsure
              (not= (canonical back) (canonical cls)) false
              (not (type-constraints-satisfied? at args as)) false
              (:constraint at)
              (let [d (atom false)
                    v (binding [sema/*cutoff* Long/MAX_VALUE sema/*constraint-doubt* d] (sema/constraint-satisfied? as (:constraint at)))]
                (cond v args @d :unsure :else false))
              :else args)))))))

(defn- deduce-from-rhs
  "[over.match.class.deduct]/3's deduction of the guide `gid`'s return type R's template arguments from the alias's
  defining-type-id X ([temp.deduct.type], deduction not failing when some stay undeduced): the same class template,
  argument by argument, an argument that does not deduce left (clang's DeduceTemplateArguments with
  NumberOfArgumentsMustMatch false); a pack expansion among them matched as a list. False when the templates differ."
  [b gid R X]
  (let [targs (fn [t] (cond (= :tspec (:k t)) [(:tmpl t) (:args t)]
                            (abi/class? t) (let [c (abi/cls (:id t))] [(:tmpl c) (:targs c)])))
        [rt ras] (targs R) [xt xas] (targs X)]
    (boolean
      (when (and rt (= rt xt))
        (if (some #(pack-pattern? % gid) ras)
          (match-args b gid ras xas)
          (do (doseq [[p a] (map vector ras xas)]
                (let [snap @b] (when-not (match-arg b gid p a) (reset! b snap))))
              true))))))

(defn- alias-result
  "The :result of the alias template `at`'s guides: the class itself when the alias's arguments deduce back to it."
  [at x]
  (fn [cls] (let [r (alias-deducible at x cls)] (cond (false? r) false (= :unsure r) :unsure :else cls))))

(defn- alias-guide
  "The guide f' of the alias template `at` (its defining-type-id `x`, symbolic) from its class template's guide `g`
  (registered), registered as a template; nil when f's return type cannot be deduced from `x` (never a specialization of
  the alias). `result` maps the class f' returns to the deduced class (the alias's specialization: that class itself;
  CP323's inherited guides: the derived class) or false or :unsure."
  [at x g result]
  (let [gid (:id g)
        u (atom false)
        R (when (:sig g) (try (guide-ret-pattern g) (catch arbace.lang.ExceptionInfo _ nil)))
        b (atom {})
        ok (when R (binding [*unsure* u] (try (deduce-from-rhs b gid R x) (catch arbace.lang.ExceptionInfo _ (reset! u true) false))))
        unsure? (or (nil? R) @u)]
    (when (or unsure? ok)
      (let [atid (:id at)
            deduced @b
            refd (sort (distinct (mapcat #(tparams-in % atid) (vals deduced))))
            undeduced (remove #(contains? deduced %) (range (count (:params g))))
            ;; (f''s parameters keep their names, so that their default arguments resolve as written; one of f's that
            ;; shares a name with the alias's is renamed, its default argument then unsure)
            anames (into {} (for [i refd] [i (:name (nth (:params at) i))]))
            taken (set (vals anames))
            fnames (into {} (for [j undeduced :let [nm (:name (nth (:params g) j))]] [j (if (taken nm) (str "__arbace_f" j) nm)]))
            params (vec (concat (for [i refd] (-> (nth (:params at) i) (dissoc :tc :tc-args)))
                                (for [j undeduced] (assoc (nth (:params g) j) :name (fnames j)))))
            unsure? (or unsure? (some :bound (vals deduced))
                        (some (fn [j] (and (not= (fnames j) (:name (nth (:params g) j))) (:default (nth (:params g) j)))) undeduced)
                        (not= (count params) (count (distinct (map :name params)))))
            rhs-qt (get-in (:pattern at) [:type :qualType])
            fscope (fn [s]
                     (let [ent (fn [nm] (or (first (#'sema/own-names s nm)) (fail :template "ctad: an alias guide's parameter " nm)))
                           aargs (vec (for [[i p] (map-indexed vector (:params at))]
                                        (if (contains? anames i)
                                          (entity-arg (ent (anames i)))
                                          (case (:kind p)
                                            :type (cond-> {:k :tparam :i i :tid atid :name (:name p)} (:pack p) (assoc :pack true))
                                            :template {:k :ttp :i i :tid atid}
                                            (cond-> {:k :tparam-v :i i :tid atid} (:pack p) (assoc :pack true))))))
                           xs (abi/unq (sema/resolve-type (bind-scope (:scope at) (:params at) aargs nil) rhs-qt))
                           b2 (atom {})
                           _ (when-not (deduce-from-rhs b2 gid R xs) (fail :template "ctad: an alias guide's substitution"))
                           fargs (vec (for [j (range (count (:params g)))]
                                        (if (contains? @b2 j) (get @b2 j) (entity-arg (ent (fnames j))))))]
                       [(guide-scope (:scope g) (:params g) fargs nil (:pattern-of g)) fargs]))
            g2id (next-id)
            g2 (cond-> (assoc (dissoc g :sig) :id g2id :params params :pattern-of nil :insts {}
                              :mk (fn [s] ((:mk g) (first (fscope s))))
                              :fscope fscope :result result :alias (:id at))
                 true (dissoc :user-node))
            sig (when-not unsure?
                  (try (binding [sema/*cutoff* Long/MAX_VALUE]
                         (dissoc ((:mk g2) (guide-scope (:scope g2) params nil g2id nil)) :cq))
                       (catch arbace.lang.ExceptionInfo e
                         (when (System/getenv "CPP_TMPL_TRACE") (binding [*out* *err*] (println "alias guide" (:name at) (:kind g) "not built:" (.getMessage e))))
                         nil)))
            g2 (assoc g2 :sig sig)]
        (swap! *tmpls* assoc g2id g2)
        g2))))

(defn- alias-guides
  "The alias template `at`'s guides from the class template's `gs` (DeclareImplicitDeductionGuidesForTypeAlias), with
  [ctid x] its defining-type-id's (alias-rhs); kept on the alias while the class template's guides are the same."
  [at [ctid x] gs]
  (if (and (:ctad-src at) (identical? gs (:ctad-src at)))
    (:ctad-guides at)
    (let [res (alias-result at x)
          ags (vec (keep #(alias-guide at x % res) gs))]
      (upd-tmpl! (:id at) assoc :ctad-guides ags :ctad-src gs)
      ags)))

(defn- inherited-guides
  "CP323 (a), C++23's [over.match.class.deduct]/1.10 (P2582R1), from the standard's text (clang 23 builds none; the
  standard is the reference where clang lags): for each direct base B of the class template `ctid`'s pattern whose
  constructors it inherits (`using B::B;`), A the alias template with C's template parameters whose defining-type-id is
  B: A's guides (alias-guide over B's class template's guides), each returning C with the arguments A's deduce from the
  class the guide returns (the partial specialization CC<A<P...>> of the text: no such deduction, no guide), marked
  :inherited for [over.match.best]/2.10's tie-break."
  [ctid]
  (let [ct (tmpl ctid)
        pat (:pattern ct)
        inh (set (keep #(when (#{"UsingDecl" "UnresolvedUsingValueDecl"} (:kind %))
                          (let [[_ a b] (re-find #"(\w+)\s*(?:<[^;]*>)?\s*::\s*(\w+)\s*;?\s*$" (or (node-text %) ""))] (when (and a (= a b)) a)))
                       (kids pat)))]
    (vec
      (for [bs (:bases pat)
            :let [qt (get-in bs [:type :qualType])
                  bname (second (re-find #"^\s*(?:::)?(?:\w+::)*(\w+)\s*(?:<|$)" (str qt)))]
            :when (and bname (inh bname))
            :let [aid (or (get (:ctad-inh-ids ct) qt)
                          (let [aid (next-id)]
                            (swap! *tmpls* assoc aid {:id aid :tk :alias :name (str (:name ct) "'s base " qt) :scope (:scope ct) :path (:path ct)
                                                      :params (:params ct) :pattern {:kind "TypeAliasDecl" :type {:qualType qt}} :insts {}
                                                      :constraint (:class-constraint ct)})
                            (upd-tmpl! ctid assoc-in [:ctad-inh-ids qt] aid)
                            aid))
                  at (tmpl aid)
                  rhs (alias-rhs at)]
            :when rhs
            :let [x (second rhs)
                  res (fn [cls] (let [r (alias-deducible at x cls)]
                                  (cond (false? r) false (= :unsure r) :unsure
                                        :else (instantiate-class ctid (or (complete-args ct r) (fail :template "ctad: missing arguments"))))))
                  gs (class-guides (first rhs))]
            g (if (and (:ctad-src at) (identical? gs (:ctad-src at)))
                (:ctad-guides at)
                (let [ags (vec (keep #(some-> (alias-guide at x % res) (assoc :inherited true)) gs))]
                  (doseq [g ags] (swap! *tmpls* assoc (:id g) g))
                  (upd-tmpl! aid assoc :ctad-guides ags :ctad-src gs)
                  ags))]
        g))))

(defn ctad
  "The :ctad hook: the class a placeholder for the class template or alias template `tid` deduces from an initializer
  of `kind` (:direct, :copy, :list-direct, :list-copy) with `init` (the arguments' vector, an expression, an
  init-list), as DeduceTemplateSpecializationFromInitializer does; a refusal :ctad when the program is ill-formed."
  [ctx tid kind init]
  (let [t (tmpl tid)
        cname (:name t)
        ;; (before C++17 a template-name is no placeholder: its template arguments are missing, [temp.names]/1)
        _ (when (< (long sema/*cxx-year*) 17)
            (fail :ctad "use of class template '" cname "' requires template arguments"))
        _ (when (= :alias (:tk t))
            (when (and (< (long sema/*cxx-year*) 20) sema/*pedantic-errors*)
              (fail :ctad "class template argument deduction for alias templates is a C++20 extension ('" cname "')")))
        ;; (CP320 (a): an alias template's guides are its defining-type-id's class template's, rewritten: alias-guides)
        alias? (= :alias (:tk t))
        rhs (when alias? (or (alias-rhs t) (fail :template "ctad: an alias template's defining-type-id (" cname ")")))
        ctid (if alias? (first rhs) tid)
        ct (tmpl ctid)
        list? (#{:list-direct :list-copy} kind)
        inits (cond list? (:items init) (vector? init) init :else [init])
        ;; (copy-initialization not from a list: the converting guides alone, [over.match.copy]/1, [over.match.ctor]/1)
        allow-explicit (not= :copy kind)
        gs (if alias? (alias-guides t rhs (class-guides ctid)) (class-guides tid))
        ;; (CP323 (a): C++23's guides from inherited constructors, a class template's own deduction alone)
        gs (if (and (not alias?) (>= (long sema/*cxx-year*) 23) (:pattern ct)) (into gs (inherited-guides ctid)) gs)
        has-user (some #(= :user (:kind %)) gs)
        _ (when (and (nil? (:pattern ct)) (not has-user))
            (fail :ctad "template '" cname "' has no definition and no deduction guides"))
        ;; (C++23's inherited constructors' guides, [over.match.class.deduct]/1.10 (P2582): CP323 (a)'s inherited-guides;
        ;; for an alias template of a class that inherits constructors not built, not judged)
        inherits (some #(and (#{"UsingDecl" "UnresolvedUsingValueDecl"} (:kind %))
                             (let [[_ a b] (re-find #"(\w+)\s*(?:<[^;]*>)?\s*::\s*(\w+)\s*;?\s*$" (or (node-text %) ""))] (and a (= a b))))
                       (kids (:pattern ct)))
        cands (fn [only-list args]
                (let [drops (atom {:sure-drops 0 :unsure-drops 0})
                      fids (vec (concat
                                 (for [g gs
                                       :when (or allow-explicit (not (:explicit g)))
                                       :when (or allow-explicit (nil? (:sig g))
                                                 (let [m (guide-min-args g) ps (:ps (:sig g))]
                                                   (not (or (> m 1) (and (empty? ps) (not (:va (:sig g))))))))
                                       :let [il (when only-list (init-list-guide-elem g))]
                                       :when (or (not only-list) il)
                                       :let [fid (guide-candidate! g args il drops)]
                                       :when fid]
                                   fid)
                                 ;; [over.match.class.deduct]/1.4: the aggregate deduction candidate
                                 (when (and (>= (long sema/*cxx-year*) 20) (not has-user) (not only-list) (seq inits)
                                            (:pattern ct) (aggregate-pattern? (:pattern ct))
                                            (or list? (= :direct kind)))
                                   (let [ag (aggregate-guide ctid inits)]
                                     (cond
                                       (= :unsure ag) (do (swap! drops update :unsure-drops inc) nil)
                                       (nil? ag) nil
                                       :else (let [g (let [gid (next-id)
                                                           g (assoc ag :id gid :tk :guide :name (str "<deduction guide for " (:name ct) ">") :insts {} :ctid ctid)
                                                           sig (try (dissoc ((:mk g) (guide-scope (:scope g) (:params g) nil gid (:pattern-of g))) :cq)
                                                                    (catch arbace.lang.ExceptionInfo _ nil))]
                                                       (swap! *tmpls* assoc gid (assoc g :sig sig))
                                                       (assoc g :sig sig))
                                                   ;; (CP320 (a): DeclareAggregateDeductionGuideForTypeAlias, the aggregate guide rewritten)
                                                   g (if alias? (alias-guide t (second rhs) g (alias-result t (second rhs))) g)]
                                               (when g
                                                 (when-let [fid (guide-candidate! g args nil drops)] [fid]))))))))]
                  [fids @drops]))
        unsure-fail (fn [why] (fail :template "ctad: " why " (" cname ")"))
        resolve (fn [[fids drops] args]
                  (cond
                    (empty? fids) (if (pos? (long (:unsure-drops drops))) ::unsure ::none)
                    :else (try (binding [sema/*drops* drops] (sema/resolve-overload fids args nil))
                               (catch arbace.lang.ExceptionInfo e
                                 (let [m (.getMessage e)]
                                   (cond
                                     (re-find #"^codegen: no viable function among" m) ::none
                                     (re-find #"^codegen: ambiguous call" m) ::ambiguous
                                     (re-find #"^codegen: no viable function" m) ::unsure
                                     :else (throw e)))))))
        fns-before (set (keys @sema/*fns*))
        cleanup! (fn [] (swap! sema/*fns* (fn [m] (into {} (remove (fn [[k f]] (and (= :guide (:kind f)) (not (fns-before k)))) m)))))]
    (try
      (let [;; [over.match.list]/1, DR1467: a braced list tries the initializer-list guides first, unless it is empty and a guide
            ;; takes no argument, or it holds one expression of a specialization of the template or a class derived from one
            try-list (and list?
                          (if (empty? inits)
                            (not (some #(and (:sig %) (zero? (long (guide-min-args %)))) gs))
                            (not (and (= 1 (count inits)) (not= :init-list (:op (first inits)))
                                      (when-let [c (let [u (abi/unq (:ty (first inits)))] (when (abi/class? u) (:id u)))]
                                        (some #(= ctid (:tmpl (abi/cls %))) (class-and-bases c)))))))
            r1 (when try-list (resolve (cands true [init]) [init]))
            r (if (or (nil? r1) (= ::none r1)) (resolve (cands false inits) inits) r1)]
        (cond
          (= ::unsure r) (unsure-fail "a guide not deduced by the slice")
          (and inherits alias? (>= (long sema/*cxx-year*) 23) (keyword? r)) (unsure-fail "inherited constructors' guides")
          (= ::none r) (fail :ctad "no viable constructor or deduction guide for deduction of template arguments of '" cname "'")
          (= ::ambiguous r) (fail :ctad "ambiguous deduction for template arguments of '" cname "'")
          :else
          (let [f (sema/fnd r)]
            (when (and (= :list-copy kind) (:explicit f))
              (fail :ctad "class template argument deduction for '" cname "' selected an explicit "
                    (if (= :user (:guide f)) "deduction guide" "constructor") " for copy-list-initialization"))
            (:ret (:ty f)))))
      (finally (cleanup!)))))

;; ---------------------------------------------------------------------------------------------
;; The hooks

(reset! sema/hooks
        {:declare declare-template
         :template-id template-id
         :const-bound (fn [scope f] (let [v (const-form scope f)] (if (map? v) v (long v))))
         :call-candidates (fn [ctx callee args] (when (or (seq (:tmpls callee)) (and (not (:obj callee)) (:name callee))) (call-candidates ctx callee args)))
         :tiebreak tiebreak
         :ctad ctad
         :ctor-candidates (fn [cid args]
                            (vec (for [tid (:ctor-tmpls (abi/cls cid))
                                       ;; (cpp-s8: a constructor template of more parameters without defaults than the
                                       ;; arguments is no candidate, [over.match.viable]/2, before its deduction and
                                       ;; constraints: span's `template<contiguous_iterator _It> span(_It, size_type)` for
                                       ;; is_constructible<span, span> had checked contiguous_iterator<span>, which asks
                                       ;; is_constructible<span, span> again, to the constraints' depth)
                                       ;; (too-few-args? reads the pattern's own default arguments: a constructor
                                       ;; template's are on its one declaration, in the class)
                                       :when (not (too-few-args? (tmpl tid) args))
                                       :let [fid (try (let [a (deduce-call (tmpl tid) [] args)]
                                                        (when (and (nil? a) (System/getenv "CPP_TMPL_TRACE"))
                                                          (binding [*out* *err*] (println "constructor template of" (:name (abi/cls cid)) "does not deduce")))
                                                        (when a (instantiate-fn tid a)))
                                                      (catch arbace.lang.ExceptionInfo e
                                                        (when (System/getenv "CPP_TMPL_TRACE")
                                                          (binding [*out* *err*] (println "constructor template of" (:name (abi/cls cid)) "drops out:" (.getMessage e))))
                                                        nil))]
                                       :when fid
                                       ;; [class.copy.ctor]/5: never instantiated to the signature X(X)
                                       :let [ps (:ps (:ty (sema/fnd fid)))]
                                       :when (not (and (= 1 (count ps)) (= {:k :class :id cid} (abi/unq (first ps)))))]
                                   fid)))
         :pack-expand expand-type-pack
         :expand-pack expand-expr-pack
         ;; (cpp-s4: a using-declaration's pack expansion, [namespace.udecl]/1's `using B<Ts>::f...;`: the scopes binding the
         ;; packs its names name to each element, nil when it names none)
         :pack-scopes (fn [scope nms] (let [packs (packs-named scope nms)] (when (seq packs) (elementwise scope packs))))
         :var-template var-template
         :dependent-name (fn [scope parts]
                           (let [es (sema/lookup scope (first parts)) e (first (filter #(= :type (:e %)) es))]
                             (when (and e (#{:tparam :tdep :tspec} (:k (:ty e))))
                               [{:e :type :ty {:k :tdep :base (:ty e) :names (vec (rest parts))} :pos -1}])))
         :trait-type (fn [scope nm forms] (if (contains? type-traits nm) (trait-type scope nm forms) (fail :type "unknown type " nm)))
         :trait-text (fn [scope t] (binding [sema/*cutoff* Long/MAX_VALUE] (eval-text scope t)))
         ;; (CX12, CP281 (a): a type-constraint `C<A...>` (or `C`) applied to the type `T`, C<T, A...>: true, false, or
         ;; nil when the slice cannot tell)
         :type-constraint (fn [scope ^String text T]
                            (try
                              (let [[_ nm rest] (re-matches #"(?s)\s*((?:[A-Za-z_][A-Za-z_0-9]*::)*[A-Za-z_][A-Za-z_0-9]*)\s*(?:<(.*)>)?\s*" text)
                                    parts (when nm (str/split nm #"::"))
                                    e (when parts (first (filter #(and (= :tmpl (:e %)) (= :concept (:tk %)))
                                                                 (if (next parts) (sema/lookup-qualified scope parts) (sema/lookup scope nm)))))]
                                (when e
                                  (let [t (tmpl (:id e))
                                        bs (new-scope :block scope)
                                        _ (enter! bs "__cx_ret_t" {:e :type :ty T :pos -1})
                                        args (complete-args t (explicit-args t (str (last parts) "<__cx_ret_t" (when (and rest (not (str/blank? rest))) (str ", " rest)) ">") bs))]
                                    (when (and args (not (dependent? args)))
                                      (concept-satisfied? t args)))))
                              (catch arbace.lang.ExceptionInfo x (when (System/getenv "CPP_TMPL_TRACE") (binding [*out* *err*] (println "type-constraint" text (.getMessage x)))) nil)))
         :concept-id (fn [ctx e n]
                       (let [t (tmpl (:id e))
                             args (or (complete-args t (or (explicit-args t (sema/written-targs n (:name t)) (:scope ctx)) []))
                                      (fail :template "missing template arguments for " (:name t)))]
                         (if (dependent? args)
                           (fail :template "a dependent concept-id")
                           (if (concept-satisfied? t args) 1 0))))
         :pending pending
         ;; CP301 (a): a captureless generic lambda's conversion function template ([expr.prim.lambda.closure]/9): the
         ;; call operator template's specialization whose parameter types the target pointer to function's are, deduced
         ;; from them ([temp.deduct.conv]/2-4 through the conversion's result type), or nil
         :glam-spec (fn [tid F]
                      (let [t (tmpl tid) sig (sym-sig t) b (atom {})]
                        (when (and (= (count (:ps sig)) (count (:ps F))) (not (:va F))
                                   (every? true? (map (fn [P A] (deduce-type b tid P A)) (:ps sig) (:ps F))))
                          (when-let [args (finish-deduction t @b)]
                            (try (instantiate-fn tid args) (catch arbace.lang.ExceptionInfo _ nil))))))
         :fnaddr-specs fnaddr-specs
         :instantiate-class (fn [tid args] (instantiate-class tid args))
         ;; (a transform trait's name, not a function type returning a type named __x: __c_locale ())
         :is-trait (fn [nm] (contains? type-traits nm))
         :wrap (fn [f] (binding [*tmpls* (atom {}) *scanned* (atom #{}) *satisfaction* (atom {}) *provisional* (atom {:waits {} :remake {}})] (f)))
         :class-completed (fn [id] (class-completed! id))})

(def op-codes
  {"new" "nw" "new[]" "na" "delete" "dl" "delete[]" "da" "+" "pl" "-" "mi" "*" "ml" "/" "dv" "%" "rm" "&" "an" "|" "or"
   "^" "eo" "=" "aS" "+=" "pL" "-=" "mI" "*=" "mL" "/=" "dV" "%=" "rM" "&=" "aN" "|=" "oR" "^=" "eO" "<<" "ls" ">>" "rs"
   "<<=" "lS" ">>=" "rS" "==" "eq" "!=" "ne" "<" "lt" ">" "gt" "<=" "le" ">=" "ge" "<=>" "ss" "!" "nt" "&&" "aa" "||" "oo"
   "++" "pp" "--" "mm" "," "cm" "->*" "pm" "->" "pt" "()" "cl" "[]" "ix" "~" "co"})
(def unary-op-codes {"+" "ps" "-" "ng" "&" "ad" "*" "de"})

(def ^:private builtin-codes
  {:void "v" :bool "b" :char "c" :schar "a" :uchar "h" :short "s" :ushort "t" :int "i" :uint "j" :long "l" :ulong "m"
   :llong "x" :ullong "y" :i128 "n" :u128 "o" :float "f" :double "d" :ldouble "e" :float16 "DF16_" :float128 "g" :nullptr "Dn" :wchar "w" :char8 "Du" :char16 "Ds" :char32 "Di"})

(defn- seq-id ^String [^long n]
  (if (zero? n) "S_"
      (str "S" (.toUpperCase (Long/toString (dec n) 36)) "_")))

(defn ucn-bytes
  "Queue 439: a name with each universal character name (`\\u00C0`, `\\U000000C0`) as its character's UTF-8 bytes, chars 0-255,
  as the native reader holds a UTF-8 source's characters and the LLVM forms hold strings ([lex.charset]/2: `\\u00C1`, `\\u00c1`,
  `\\U000000C1` and UTF-8's \\C3\\81 one identifier, as clang's IdentifierInfo); a name without a backslash itself."
  ^String [^String nm]
  (if (and nm (>= (.indexOf nm "\\") 0))
    (str/replace nm #"\\u([0-9A-Fa-f]{4})|\\U([0-9A-Fa-f]{8})"
                 (fn [[_ a b]] (String. (.getBytes (String. (Character/toChars (Integer/parseInt ^String (or a b) 16))) "UTF-8") "ISO-8859-1")))
    nm))

(defn source-name
  "Itanium's <source-name>, the identifier's length and the identifier, its universal character names as their UTF-8 bytes
  (queue 439, ucn-bytes: clang mangles IdentifierInfo's UTF-8, g++.dg's other/ucnid-1.C's _Z2\\C3\\80v)."
  ^String [^String s]
  (let [s (ucn-bytes s)] (str (count s) s)))

(def ^:dynamic ^:private *subs* nil) ; atom: vector of keys

(defn- sub! [k ^String s]
  (let [v @*subs* i (.indexOf ^java.util.List v k)]
    (if (neg? i) (do (swap! *subs* conj k) s) (seq-id i))))

(defn- sub-or [k f]
  (let [i (.indexOf ^java.util.List @*subs* k)]
    (if (neg? i) (let [s (f)] (swap! *subs* conj k) s) (seq-id i))))

(def ^:dynamic *dollars* nil) ; atom {:names {class-id name} :counts {key n}}: clang's $_N, numbered as first mangled

(defn- dollar-name!
  "A closure's name in a function that is not inline: $_N, N counted per enclosing function in the order the closures
  are first mangled (clang numbers them as its code generator first names them)."
  ^String [c]
  (let [a (or *dollars* (atom {}))]
    (or (get-in @a [:names (:id c)])
        (let [k (:dollar-key c) n (long (get-in @a [:counts k] 0))
              nm (source-name (str "$_" n))]
          (swap! a #(-> % (assoc-in [:names (:id c)] nm) (assoc-in [:counts k] (inc n))))
          nm))))

(defn- unnamed-type-name
  "queue 380: an unnamed class's or enumeration's <unnamed-type-name>, Itanium 5.1.8's Ut [ <number> ] _, numbered in
  declaration order (the ids') among the unnamed classes and enumerations of its scope that have no name for linkage
  purposes: ios_base's `enum { _S_local_word_size = 8 }` as a template argument, std::__exchange<int, ios_base::Ut_>;
  before, an empty source name, 0."
  ^String [path id]
  (let [unnamed (fn [m] (for [[i x] m :when (and (nil? (:name x)) (nil? (:mname x)) (not (:lambda x)) (not (:dollar-key x))
                                                 (= (vec (:path x)) (vec path)) (< (long i) (long id)))] i))
        k (+ (count (unnamed @*classes*)) (count (unnamed @*enums*)))]
    (str "Ut" (if (zero? k) "" (dec k)) "_")))

(declare bare-params)

(defn- part-name ^String [p]
  (case (first p)
    :ns (source-name (second p))
    :anon "12_GLOBAL__N_1"
    ;; (cpp-rt-own2: a closure's Ul <parameters> E [n] _ mangled in the enclosing name's substitutions, its parameters' types
    ;; candidates as any (clang's mangleLambda): text_encoding.cc's __charset_alias_match's `[](char, bool&)`,
    ;; ...ENKUlcRbE_clEcS4_, the call operator's bool& the closure name's S4_; a fresh table had written clEcRb)
    :cls (let [c (cls (second p))] (or (when-let [[ps k] (and *subs* (:ul c))] (str "Ul" (bare-params ps false) "E" (if (zero? (long k)) "" (dec (long k))) "_"))
                                       (:mname c) (when (:dollar-key c) (dollar-name! c))
                                       (if (and (nil? (:name c)) (not (:lambda c))) (unnamed-type-name (:path c) (second p)) (source-name (:name c)))))
    :enum (let [e (enm (second p))] (if (nil? (:name e)) (unnamed-type-name (:path e) (second p)) (source-name (:name e))))))

(declare mangle-type* template-args)

(defn- part-targs
  "A class part's template arguments when the class is a template's specialization (CODEGEN.md §G3), else nil."
  [p]
  (when (= :cls (first p)) (let [c (cls (second p))] (when (:tmpl c) c))))

(defn- template-prefix
  "<template-prefix> ::= <prefix> <template unqualified-name>: `out` (the prefix as written so far) and the template's
  name, or the template's substitution when it was seen (it stands for the prefix too); a new candidate otherwise."
  ^String [^String out tid ^String nm]
  (let [i (.indexOf ^java.util.List @*subs* [:tmpl tid])]
    (cond
      ;; the standard abbreviations (§5.1.8: Sa ::std::allocator, Sb ::std::basic_string), no candidates themselves
      (and (= out "St") (= nm "allocator")) "Sa"
      (and (= out "St") (= nm "basic_string")) "Sb"
      (neg? i)
      (let [s (str out (source-name nm))] (swap! *subs* conj [:tmpl tid]) s)
      :else (seq-id i))))

(defn- std-abbreviation
  "The Itanium ABI's abbreviation (§5.1.8) of a ::std class specialization `c`: Ss std::basic_string<char,
  std::char_traits<char>, std::allocator<char>>, Si basic_istream<char, char_traits<char>>, So basic_ostream<...>,
  Sd basic_iostream<...>; else nil."
  [c]
  (when c
    (let [ch {:k :b :n :char}
          traits? (fn [a] (and (= :class (:k a)) (let [k (cls (:id a))] (and (= "char_traits" (:name k)) (= [[:ns "std"]] (vec (:path k))) (= [ch] (mapv unq (:targs k)))))))
          alloc? (fn [a] (and (= :class (:k a)) (let [k (cls (:id a))] (and (= "allocator" (:name k)) (= [[:ns "std"]] (vec (:path k))) (= [ch] (mapv unq (:targs k)))))))
          as (vec (:targs c))]
      (case (:name c)
        "basic_istream" (when (and (= 2 (count as)) (= ch (unq (as 0))) (traits? (as 1))) "Si")
        "basic_ostream" (when (and (= 2 (count as)) (= ch (unq (as 0))) (traits? (as 1))) "So")
        "basic_iostream" (when (and (= 2 (count as)) (= ch (unq (as 0))) (traits? (as 1))) "Sd")
        "basic_string" (when (and (= 3 (count as)) (= ch (unq (as 0))) (traits? (as 1)) (alloc? (as 2))) "Ss")
        nil))))

(defn- mangle-prefix
  "The prefix of the parts as written inside N ... E: the longest prefix already substituted as its S_, then each
  further part, every prefix a new substitution candidate (a template specialization's part: its template-prefix a
  candidate, then its arguments)."
  ^String [parts]
  (let [parts (vec parts)
        n (count parts)
        idx (fn [m] (.indexOf ^java.util.List @*subs* [:prefix (subvec parts 0 m)]))
        best (loop [m n] (when (pos? m) (if (neg? (long (idx m))) (recur (dec m)) m)))
        start (or best 0)]
    (loop [i (inc start) out (if best (seq-id (idx best)) "")]
      (if (> i n)
        out
        (if (and (= i 1) (= [:ns "std"] (first parts)))
          (recur (inc i) "St") ; ::std:: is St, not a substitution candidate
          (let [p (nth parts (dec i))
                ab (when (= out "St") (std-abbreviation (part-targs p)))
                s (if-let [c (when-not ab (part-targs p))]
                    (str (template-prefix out (:tmpl c) (:name c)) (template-args (:targs c)))
                    (or ab (str out (part-name p))))]
            ;; (an abbreviation is no substitution candidate, §5.1.8)
            (when-not ab (swap! *subs* conj [:prefix (subvec parts 0 i)]))
            (recur (inc i) s)))))))

(def ^:dynamic *mangle-id*
  "cpp-rt-own: the id of the function or variable whose name is being mangled (mangle-fn, mangle-var), or nil."
  nil)

(def ^:dynamic *redef*
  "cpp-rt-own3 (DECISION cpp-rt-own2-3 (a)): {:mode :old|:new :hit atom} while a name is mangled for the code generator's hook: a
  class defined by a qualified name over its declaration in an inline namespace (sema's :mangle-path-after) named by the
  declaration's path (:old) or the definition's (:new), the class's id put in :hit when consulted."
  nil)

(def ^:dynamic *redef-hook*
  "cpp-rt-own3: the code generator's (fn [kind class-id old new] name), bound for a unit with such a class: clang fixes a name when
  its code generator first refers to it, the class's interesting declaration its definition from then on (RecordType::getDecl),
  so the code generator chooses by the place of the first reference (arbace.cpp.codegen's redef-name); nil: the entity-id rule."
  nil)

(defn- with-redef
  "A name `thunk` mangles, through *redef-hook* when bound and the name differs by a redefined class's two paths."
  [kind thunk]
  (if (or (nil? *redef-hook*) *redef*)
    (thunk)
    (let [hit (atom nil)
          nn (binding [*redef* {:mode :new :hit hit}] (thunk))]
      (if-not @hit
        nn
        (let [on (binding [*redef* {:mode :old :hit (atom nil)}] (thunk))]
          (if (= on nn) nn (*redef-hook* kind @hit on nn)))))))

(defn path-of-type
  "The scope path naming a class or enumeration type: its enclosing path and itself. (cpp-rt-own: a class defined by a qualified
  name through an inline namespace, sema's :mangle-path-after [PATH ID]: the definition's namespace PATH for an entity made after
  it, ids from ID on, the first declaration's before -- clang mangles a name when it first emits it, the class's interesting
  declaration the definition from then on: fs_dir.cc's __shared_ptr<std::filesystem::__cxx11::_Dir> explicitly instantiated before
  `struct fs::_Dir`, its deque<std::filesystem::_Dir> after)"
  [t]
  (case (:k t)
    :class (let [c (cls (:id t)) after (:mangle-path-after c)]
             (conj (vec (cond (nil? after) (:path c)
                              ;; (cpp-rt-own3: the code generator's choice by the first reference, *redef*)
                              *redef* (do (reset! (:hit *redef*) (:id t)) (if (= :old (:mode *redef*)) (:path c) (first after)))
                              (and *mangle-id* (>= (long *mangle-id*) (long (second after)))) (first after)
                              :else (:path c)))
                   [:cls (:id t)]))
    :enum (conj (vec (:path (enm (:id t)))) [:enum (:id t)])))

(declare local-encoding)
(defn- local-enc ^String [x] (if (string? x) x (local-encoding x)))

(defn- mangle-named
  "A class or enumeration type's name: a source name at the global scope, else N prefix E; a substitution candidate."
  ^String [t]
  (let [parts (path-of-type t)
        k [:prefix parts]
        i (.indexOf ^java.util.List @*subs* k)]
    (cond
      (not (neg? i)) (seq-id i)
      ;; a local class: Z encoding E name ([local-name], §5.1.6)
      (= :local (ffirst parts)) (let [r (vec (rest parts))
                                      s (str "Z" (local-enc (second (first parts))) "E" (if (= 1 (count r)) (part-name (first r)) (str "N" (mangle-prefix r) "E")))]
                                  (swap! *subs* conj k) s)
      ;; at the global scope or ::std (St, no N ... E): mangle-prefix writes a template specialization's arguments
      (= 1 (count parts)) (mangle-prefix parts)
      (and (= 2 (count parts)) (= [:ns "std"] (first parts))) (mangle-prefix parts)
      :else (str "N" (mangle-prefix parts) "E"))))

(defn- template-param
  "<template-param>: T_ for the first, T<n-2>_ after (a parameter of depth 0: CODEGEN.md §G3)."
  ^String [^long i]
  (if (zero? i) "T_" (str "T" (dec i) "_")))

(defn- tspec-unwrapped
  "A dependent template-id's <prefix> <template-name> <template-args>, without the N ... E around a nested one."
  ^String [t]
  (if-let [tt (:ttp t)]
    ;; a template template parameter's template-id: <template-param> (a substitution candidate) <template-args>
    (str (sub-or [:t tt] #(template-param (:i tt))) (template-args (:args t)))
    (str (template-prefix (if (empty? (:path t)) "" (mangle-prefix (:path t))) (:tmpl t) (:name t)) (template-args (:args t)))))

(def ^:private expr-op-codes
  {"neg" "ng" "!" "nt" "~" "co" "?" "qu" "+" "pl" "-" "mi" "*" "ml" "/" "dv" "%" "rm" "<<" "ls" ">>" "rs" "&" "an" "|" "or"
   "^" "eo" "<" "lt" ">" "gt" "<=" "le" ">=" "ge" "==" "eq" "!=" "ne" "&&" "aa" "||" "oo"})

(defn- mangle-expr
  "<expression> of a dependent template argument (5.1.6): an int literal L i n E, a non-type parameter T_, an
  operator's code and operands, sizeof's st <type>, a member of a dependent class sr <type> <name> (a template-id's
  levels then E, its names no substitution candidates, as clang writes them)."
  ^String [x]
  (cond
    (number? x) (str "Li" (if (neg? (long x)) (str "n" (- (long x))) x) "E")
    ;; (cpp-tzdb: an enumerator of a dependent conditional, template.ae's :elit, L <its enumeration> <value> E, clang's
    ;; mangleIntegerLiteral of an enumeral type)
    (= :elit (:k x)) (str "L" (mangle-type* (:ty x)) (if (neg? (long (:v x))) (str "n" (- (long (:v x)))) (:v x)) "E")
    (= :tparam-v (:k x)) (template-param (:i x))
    (= :texpr (:k x))
    (case (:o x)
      :sr (let [b (unq (:base x))]
            (case (:k b)
              :tparam (str "sr" (mangle-type* b) (source-name (:name x)))
              ;; an unresolved name as written (clang's mangleUnresolvedPrefix): the template's simple name, its
              ;; arguments as written (a pack's elements one by one, no J ... E), the qualifier not written in the
              ;; headers' unqualified uses (G4: sr6__and_I...E5valueE)
              :tspec (let [w (:written b) args (if w (vec (take w (:args b))) (:args b))
                           targs (template-args (vec (mapcat #(if (and (map? %) (contains? % :pack) (nil? (:k %))) (:pack %) [%]) args)))]
                       (if-let [q (seq (:qual b))]
                         ;; a qualifier written (std::X<T>::value): sr <its levels, the namespaces' names> E <name>
                         (str "sr" (apply str (map source-name q)) (source-name (:name b)) targs "E" (source-name (:name x)))
                         ;; (queue 392: an unqualified one is its simple name in any namespace, as clang 23 writes it:
                         ;; <bits/chrono.h>'s __is_duration<_Tp>::value in std::chrono, sr13__is_durationIT_EE5value, had
                         ;; been written with std::chrono's names, chrono.cc's duration_cast)
                         (str "sr" (source-name (:name b)) targs "E" (source-name (:name x)))))
              (fail :mangle "a member of " (pr-str b))))
      ;; a call of a static member function template's specialization (G5c: libstdc++'s C++17 pair constructors'
      ;; enable_if<_PCCP::template _ConstructiblePair<_U1, _U2>(), bool>, clang's mangleExpression CallExpr): cl, the callee
      ;; as an unresolved name, sr <the class's levels, its namespaces'> E <name> <template-args>, E
      ;; (a qualifier written as a typedef's or an alias template's name, :wbase: that name, an unresolved-qualifier-level
      ;; <simple-id>, with the alias template's arguments as written; clang's mangleUnresolvedTypeOrSimpleId, e.g. pair's
      ;; clsr5_PCCPE22_MoveConstructiblePairIT_T0_EE)
      :mcall (if-let [w (:wbase x)]
               (str "clsr" (source-name (:name w)) (when (seq (:args w)) (template-args (:args w)))
                    "E" (source-name (:name x)) (when (seq (:targs x)) (template-args (:targs x))) "E")
               (let [b (unq (:base x))
                     tail (str "E" (source-name (:name x)) (when (seq (:targs x)) (template-args (:targs x))) "E")]
                 (case (:k b)
                   :class (let [c (cls (:id b))]
                            (str "clsr" (apply str (map part-name (:path c))) (source-name (:name c)) (when (seq (:targs c)) (template-args (:targs c))) tail))
                   ;; (cpp-rt-own: a dependent template-id's member, an unresolved name as written as :sr's: <tuple>'s
                   ;; `_TCC<true>::template __is_implicitly_default_constructible<>()`, _TCC an alias of _TupleConstraints<_Cond,
                   ;; _Elements...> in tuple<_Elements...>, clang's clsr17_TupleConstraintsIXT_ES2_S4_EE37__is_implicitly_default_constructibleE
                   ;; in thread.cc's and future.cc's tuple constructors: the arguments as written, a pack's elements one by one)
                   :tspec (let [w (:written b) args (if w (vec (take w (:args b))) (:args b))
                                targs (template-args (vec (mapcat #(if (and (map? %) (contains? % :pack) (nil? (:k %))) (:pack %) [%]) args)))]
                            (str "clsr" (apply str (map source-name (:qual b))) (source-name (:name b)) targs tail))
                   (fail :mangle "a member call of " (pr-str b)))))
      ;; (cpp-s4: a variable template's specialization with dependent arguments, an unresolved name as written:
      ;; <source-name> <template-args>, clang's 23is_copy_constructible_vIT0_E in any's converting constructor)
      ;; (cpp-rt-own4: a pack's elements one by one, as :sr's and :mcall's, no J ... E: <optional>'s C++17 constraints
      ;; `enable_if_t<is_constructible_v<_Tp, _Args...>, bool>`, clang's X18is_constructible_vIS0_DpT_EE, and `__and_v<__not_<...>, ...>`,
      ;; X7__and_vISt6__not_...E, floating_to_chars.cc's optional<to_chars_result> and optional<int>)
      :vt (str (source-name (:name x)) (template-args (vec (mapcat #(if (and (map? %) (contains? % :pack) (nil? (:k %))) (:pack %) [%]) (:args x)))))
      ;; (cpp-s8: a concept-id with dependent arguments, likewise an unresolved name, clang's mangleExpression of a
      ;; ConceptSpecializationExpr as its written name and arguments)
      :concept (str (source-name (:name x)) (template-args (:args x)))
      "sizeof" (str "st" (mangle-type* (:type x)))
      ;; (cpp-s13: sizeof...(P) of a template parameter pack P, Itanium 5.1.6's sZ <template-param>; <bits/stl_iterator_base_funcs.h>'s
      ;; signatures under <format>)
      "sizeof..." (if-let [i (:i x)] (str "sZ" (template-param (long i))) (fail :mangle "sizeof... of " (:name x)))
      (str (or (expr-op-codes (:o x)) (fail :mangle "operator " (:o x))) (apply str (map mangle-expr (:args x)))))
    :else (fail :mangle "expression " (pr-str x))))

(declare template-arg)

(defn- dt-unresolved
  "<unresolved-name> of a dependent decltype's operand (clang's mangleUnresolvedName): [sr <namespace levels> E | sr
  <unresolved-type>] <simple-id>, the simple-id's template arguments as written."
  ^String [x]
  (str (cond (:qt x) (str "sr" (mangle-type* (:qt x)))
             (seq (:q x)) (str "sr" (apply str (map source-name (:q x))) "E"))
       (source-name (:n x))
       (when (:targs x) (str "I" (apply str (map template-arg (:targs x))) "E"))))

(defn- mangle-dt-expr
  "The <expression> of a dependent decltype (sema's dt-ir data; Itanium 5.1.6, as clang's mangleExpression writes it):
  calls cl ... E, function parameters fp_ (fpK_, fp0_ ...), this fpT, members dt/pt (an implicit this dtdefpT, as gcc
  and clang), unresolved names, operators, literals, sizeof and alignof, casts and constructions (cv <type> _ ... E)."
  ^String [x]
  (case (:x x)
    :fail (fail :mangle "a dependent decltype's " (:what x))
    :fp (str "fp" (when (:v x) "V") (when (:c x) "K") (when (pos? (long (:i x))) (dec (long (:i x)))) "_")
    :tpv (template-param (:i x))
    :sz (str "sZ" (template-param (:i x)))
    :raw (:s x)
    :name (dt-unresolved x)
    :call (str "cl" (mangle-dt-expr (:f x)) (apply str (map mangle-dt-expr (:args x))) "E")
    :mem (str (if (:implicit x) "dtdefpT" (str (if (:arrow x) "pt" "dt") (mangle-dt-expr (:base x)))) (dt-unresolved x))
    :op (str (:code x) (apply str (map mangle-dt-expr (:args x))))
    :lit (str "L" (mangle-type* (:t x)) (:v x) "E")
    :tyop (str (:code x) (mangle-type* (:t x)))
    :cast (str (:code x) (mangle-type* (:t x)) (mangle-dt-expr (first (:args x))))
    :construct (let [n (count (:args x))]
                 (if (:list x)
                   (str "tl" (mangle-type* (:t x)) (apply str (map mangle-dt-expr (:args x))) "E")
                   (str "cv" (mangle-type* (:t x)) (when (not= 1 n) "_") (apply str (map mangle-dt-expr (:args x))) (when (not= 1 n) "E"))))
    (fail :mangle "a dependent decltype's " (pr-str x))))

(defn- dt-standin? [t] (and (= :tdep (:k t)) (= "decltype" (get-in t [:base :name])) (= -1 (get-in t [:base :i])) (contains? t :dt)))

(defn- template-arg
  "<template-arg>: a type, or an integral value as <expr-primary> L <type> <number> E (n for a minus, bool 0/1)."
  ^String [a]
  (cond
    ;; a non-type parameter as an argument is an expression: X T_ E
    (= :tparam-v (:k a)) (str "X" (template-param (:i a)) "E")
    (= :texpr (:k a)) (str "X" (mangle-expr a) "E")
    (and (contains? a :pack) (not (:k a))) (str "J" (apply str (map template-arg (:pack a))) "E")
    ;; a function's or a variable's address (X ad L <mangled> E E), a reference's entity (L <mangled> E), a null pointer
    (contains? a :decl) (cond (:null a) (str "L" (mangle-type* (:ty a)) "0E")
                              (:ref a) (str "L" (:mangled a) "E")
                              :else (str "XadL" (:mangled a) "EE"))
    ;; a template template argument: the template's name, a substitution candidate
    (and (contains? a :tmpl) (nil? (:k a))) (if (empty? (:path a))
                          (template-prefix "" (:tmpl a) (:name a))
                          (str "N" (template-prefix (mangle-prefix (:path a)) (:tmpl a) (:name a)) "E"))
    (= :ttp (:k a)) (sub-or [:t a] #(template-param (:i a)))
    ;; (cpp-s15: a dependent member template's name as a template template argument, X<T>::template Y: not written)
    (= :ttdep (:k a)) (fail :mangle "a dependent template name " (:name a))
    (contains? a :val) (let [v (:val a) t (unq (:ty a))]
                         (str "L" (mangle-type* t)
                              (cond (= :bool (bn t)) (if (and v (not= 0 v) (not (false? v))) "1" "0")
                                    ;; (CP393 (a): an unsigned type's value as its unsigned number, clang's
                                    ;; Lm18446744073709551615E for span's dynamic_extent; a negative number only for a signed type)
                                    (and (neg? (long v)) (contains? unsigned-ns (bn (underlying t)))) (Long/toUnsignedString (long v))
                                    (neg? (long v)) (str "n" (- (long v)))
                                    :else v)
                              "E"))
    (contains? a :k) (mangle-type* a)
    :else (fail :mangle "template argument " (pr-str a))))

(defn template-args ^String [args] (str "I" (apply str (map template-arg args)) "E"))

(defn- cvq ^String [t] (str (when (:v t) "V") (when (:c t) "K")))

(defn- skey
  "A type as a substitution key: a template parameter by its index alone (the signature's T_ and a constraint's are
  one candidate)."
  [t]
  (cond
    ;; (cpp-rt-own3: and its depth beyond 0, a constraint's TL<d-1>_ parameter, another candidate than the signature's T_)
    (and (map? t) (= :tparam (:k t))) (cond-> {:k :tparam :i (:i t)} (:c t) (assoc :c true) (:v t) (assoc :v true)
                                        (pos? (long (or (:depth t) 0))) (assoc :depth (:depth t)))
    (map? t) (into {} (map (fn [[k v]] [k (skey v)]) (dissoc t :written :qual)))
    (vector? t) (mapv skey t)
    :else t))

(defn- flat-tdep
  "cpp-rt-own3: a dependent member type of a dependent member type, X::a of T::b (an alias template's typename __iter_traits<...>::value_type
  over __iter_traits = typename __iter_traits_impl<...>::type), as one: T::b::a, clang's canonical nested-name-specifier."
  [t]
  (let [b (when (= :tdep (:k t)) (:base t))]
    (if (and b (= :tdep (:k b)) (not (contains? b :dt)) (nil? (:c b)) (nil? (:v b)))
      (flat-tdep (assoc t :base (:base b) :names (vec (concat (:names b) (:names t)))))
      t)))

(defn- mangle-type* ^String [t]
  (let [t (if (= :tdep (:k t)) (flat-tdep t) t)
        q (cvq t)
        bare (unq t)
        sk (skey bare)
        inner (fn []
                (case (:k bare)
                  :b (builtin-codes (:n bare))
                  ;; a deduced return type in a function template's signature (auto: Da)
                  :auto (if (:decltype bare) "Dc" "Da")
                  ;; GNU's complex T: C <type> (§5.1.5)
                  :complex (sub-or [:t sk] #(str "C" (mangle-type* (:of bare))))
                  ;; GNU's vector type: Dv <lanes> _ <type> (§5.1.5, the vendor extension clang and GCC write)
                  :vec (sub-or [:t sk] #(str "Dv" (:n bare) "_" (mangle-type* (:of bare))))
                  :class (mangle-named bare)
                  :enum (mangle-named bare)
                  :ptr (sub-or [:t sk] #(str "P" (mangle-type* (:to bare))))
                  :ref (sub-or [:t sk] #(str "R" (mangle-type* (:to bare))))
                  :rref (sub-or [:t sk] #(str "O" (mangle-type* (:to bare))))
                  :arr (sub-or [:t sk] #(str "A" (let [n (:n bare)] (if (map? n) (template-param (:i n)) n)) "_" (mangle-type* (:of bare))))
                  :mptr (sub-or [:t sk] #(str "M" (mangle-type* (if (map? (:cls bare)) (:cls bare) {:k :class :id (:cls bare)}))
                                                (if (= :fn (:k (:to bare))) (str (when (:cq (:to bare)) "K") (mangle-type* (dissoc (:to bare) :cq))) (mangle-type* (:to bare)))))
                  ;; (cpp-rt-own4: a non-throwing function type's Do, <exception-spec> of Itanium 5.1.5.3: sema's mptr-fn-node of a
                  ;; noexcept member function since C++17, tzdb.cc's &ZoneInfo::until as ranges' projection, MS1_KDoFSD_vE)
                  :fn (sub-or [:t sk] #(str (when (:nx bare) "Do") "F" (mangle-type* (:ret bare))
                                              (if (and (empty? (:ps bare)) (not (:va bare))) "v" (apply str (map mangle-type* (:ps bare))))
                                              (when (:va bare) "z") "E"))
                  ;; a template's own parameter and a dependent template-id, in a function template's signature (§G3)
                  ;; (cpp-rt-own3: a constraint's parameter of a depth beyond 0, sema's constraint scope, TL<d-1>_<i-1>_ as q-param)
                  :tparam (let [d (long (or (:depth bare) 0)) i (long (:i bare))]
                            (sub-or [:qparam d i] #(if (pos? d) (str "TL" (dec d) "_" (when (pos? i) (dec i)) "_") (template-param i))))
                  :pack-exp (sub-or [:t sk] #(str "Dp" (mangle-type* (:of bare))))
                  ;; T::name, a dependent member type: N <prefix> <name> E
                  ;; (CP391 (a): a dependent decltype, DT <expression> E, a substitution candidate after its operand's)
                  :tdep (sub-or [:t sk] #(let [base (unq (:base bare))]
                                             (if (dt-standin? bare)
                                               (if-let [f (first (filter (fn [m] (and (map? m) (= :fail (:x m)))) (tree-seq coll? (fn [c] (if (map? c) (vals c) (seq c))) (:dt bare))))]
                                                 (fail :mangle "a dependent decltype's " (:what f))
                                                 (str "DT" (mangle-dt-expr (:dt bare)) "E"))
                                             ;; (cpp-rt-own3: each further name's prefix a candidate, T::a of T::a::b, as clang 15 and later
                                             ;; write a nested-name-specifier's identifier (ItaniumMangle.cpp's manglePrefix): <iterator_concepts.h>'s
                                             ;; iter_value_t<_It>, __iter_traits_impl<...>::type::value_type in string_view's constructor's
                                             ;; requires-clause, its ::type a candidate; one already a candidate is its substitution)
                                             (let [names (vec (:names bare)) knames (vec (:names sk)) n (count names)
                                                   pkey (fn [k] [:t (assoc sk :names (subvec knames 0 k))])
                                                   seen (first (filter (fn [k] (and (string? (nth names (dec (long k))))
                                                                                    (not (neg? (.indexOf ^java.util.List @*subs* (pkey k))))))
                                                                       (range (dec n) 0 -1)))
                                                   ;; (cpp-tzdb: a template-id's name, its <template-prefix> a candidate before its arguments, as
                                                   ;; clang's manglePrefix: std::__conditional_t's `typename __conditional<_Cond>::template type<_If,
                                                   ;; _Else>`, ranges::equal_range's NSt13__conditionalIX..EE4typeI..EE, the subrange_kind after it SY_)
                                                   nm (fn [k x] (if (map? x)
                                                                  (let [s (source-name (:name x))]
                                                                    (swap! *subs* conj [:tprefix (pkey k) (:name x)])
                                                                    (str s (template-args (:args x))))
                                                                  (source-name x)))]
                                               (str "N" (if seen
                                                          (seq-id (.indexOf ^java.util.List @*subs* (pkey seen)))
                                                          (if (= :tspec (:k base)) (sub-or [:t base] (fn [] (tspec-unwrapped base))) (mangle-type* base)))
                                                    (apply str (map (fn [k] (let [x (nth names k) s (nm k x)]
                                                                              (when (and (< (inc (long k)) n) (string? x)) (swap! *subs* conj (pkey (inc (long k)))))
                                                                              s))
                                                                    (range (or seen 0) n)))
                                                    "E")))))
                  ;; (::std::X<...> is St X I...E, no N ... E: <unscoped-template-name>)
                  :tspec (sub-or [:t sk] #(if (or (empty? (:path bare)) (= [[:ns "std"]] (vec (:path bare))))
                                              (tspec-unwrapped bare) (str "N" (tspec-unwrapped bare) "E")))))]
    (if (= "" q)
      (inner)
      (let [k [:t (skey t)] i (.indexOf ^java.util.List @*subs* k)]
        (if (neg? i)
          (let [s (str q (inner))] (swap! *subs* conj k) s)
          (seq-id i))))))

(defn- bare-params ^String [ps va]
  (if (and (empty? ps) (not va)) "v" (str (apply str (map mangle-type* ps)) (when va "z"))))

(defn mangle-params "A parameter list's mangling (v when empty), its own substitutions." ^String [ps]
  (binding [*subs* (atom [])] (bare-params ps false)))

(declare unqualified-name*)

(defn- type-abi-tags
  "cpp-rt-own2: the ABI tags a type's mangling uses (clang's AbiTagState's used tags): a class's own (GNU's abi_tag) and those of
  the namespaces and classes enclosing it (a namespace's abi_tag is used, never written: `inline namespace __cxx11
  __attribute__((__abi_tag__ (\"cxx11\")))`), its template arguments', through pointers, references, arrays, member pointers and
  function types; a set."
  [t]
  (let [seen (java.util.HashSet.) acc (java.util.TreeSet.)]
    (letfn [(path! [path]
              (let [path (vec path)]
                (dotimes [i (count path)]
                  (let [el (nth path i)]
                    (when (vector? el)
                      (case (first el)
                        :ns (doseq [x (get (some-> *ns-tags* deref) (subvec path 0 (inc i)))] (.add acc x))
                        :cls (ty! {:k :class :id (second el)})
                        nil))))))
            (ty! [t]
              (when (map? t)
                (cond
                  (and (contains? t :pack) (nil? (:k t))) (run! ty! (:pack t))
                  (= :class (:k t)) (when (.add seen (:id t))
                                      (let [c (cls (:id t))] (doseq [x (:abi-tags c)] (.add acc x)) (path! (:path c)) (run! ty! (:targs c))))
                  (= :enum (:k t)) (path! (:path (enm (:id t))))
                  (#{:ptr :ref :rref :arr} (:k t)) (ty! (or (:to t) (:of t)))
                  (= :mptr (:k t)) (do (ty! (:to t)) (ty! (if (map? (:cls t)) (:cls t) {:k :class :id (:cls t)})))
                  (= :fn (:k t)) (do (ty! (:ret t)) (run! ty! (:ps t)))
                  :else nil)))]
      (ty! t)
      (set acc))))

(defn- fn-abi-tags
  "cpp-rt-own2: a function's ABI tags, its own (GNU's abi_tag) and, for one whose return type is not mangled (no template's
  specialization, constructor, destructor or conversion function), the tags its return type uses that its name and parameters
  do not, Itanium 5.1.2's implicit tags (clang's makeFunctionReturnTypeTags): <fs_ops.cc>'s `path current_path()` returning
  std::filesystem::__cxx11::path, _ZNSt10filesystem12current_pathB5cxx11Ev; sorted."
  [f]
  (let [own (:abi-tags f)]
    (if (or (:tinst f) (#{:ctor :dtor :conv} (:kind f)) (nil? *ns-tags*) (not (map? (:ty f))))
      own
      (let [ret (type-abi-tags (:ret (:ty f)))]
        (if (empty? ret)
          own
          (let [used (into (set own) (concat (type-abi-tags {:k :fn :ret nil :ps (vec (:ps (:ty f)))})
                                             (let [pc (some (fn [el] (when (and (vector? el) (= :cls (first el))) el)) (reverse (:path f)))]
                                               (type-abi-tags (if pc {:k :class :id (second pc)} {:k :fn :ret nil :ps []})))
                                             (let [nss (vec (take-while (fn [el] (and (vector? el) (= :ns (first el)))) (:path f)))]
                                               (mapcat (fn [i] (get (some-> *ns-tags* deref) (subvec nss 0 (inc i)))) (range (count nss))))))
                extra (remove used ret)]
            (if (seq extra) (vec (sort (distinct (concat own extra)))) own)))))))

(defn- unqualified-name
  "A function's unqualified name: its source name, an operator's code, C1/C2/D0/D1/D2 for the special members; its ABI
  tags after it (Itanium 5.1.2: <abi-tags> ::= B <source-name>..., GNU's abi_tag; cpp-s3; cpp-rt-own2: the implicit ones of its
  return type, fn-abi-tags)."
  ^String [f variant]
  (str (unqualified-name* f variant) (apply str (map #(str "B" (count %) %) (fn-abi-tags f)))))

(defn- unqualified-name*
  ^String [f variant]
  (case (:kind f)
    ;; (CP330 (a): an inheriting constructor, CI1 <base>/CI2 <base>: Itanium §5.1.4.3's <ctor-dtor-name>, the base's
    ;; name a substitution candidate as any class name)
    :ctor (if-let [b (or (:inh-name f) (:inh-base f))]
            (str "CI" (or variant 2) (mangle-type* {:k :class :id b}))
            (str "C" (or variant 2)))
    :dtor (str "D" (or variant 2))
    ;; (CP301 (a): a conversion function template's specialization, its type as the template writes it, :mangle-ret)
    :conv (str "cv" (mangle-type* (or (:mangle-ret f) (:ret (:ty f)))))
    (if-let [op (:op f)]
      (or (when (and (#{"+" "-" "&" "*"} op) (= 1 (+ (count (:ps (:ty f))) (if (:cls f) 1 0))) (not (:static f)))
            (unary-op-codes op))
          (op-codes op)
          ;; a literal operator: li <source-name> (Itanium §5.1.3)
          (when-let [[_ sfx] (re-matches #"\"\"\s*([A-Za-z_][A-Za-z0-9_]*)" op)] (str "li" (source-name sfx)))
          (fail :mangle "operator " op))
      (source-name (:name f)))))

(defn- q-param
  "A template parameter of depth `depth` in a constraint ([temp.param]; ItaniumMangle.cpp's mangleTemplateParameter:
  T_, T<n-1>_, TL<d-1>__, TL<d-1>_<n-1>_), a substitution candidate."
  ^String [^long depth ^long i]
  (sub-or [:qparam depth i] #(str "T" (when (pos? depth) (str "L" (dec depth) "_")) (when (pos? i) (dec i)) "_")))

(defn split-template-id
  "cpp-rt-own3: a template-id's text `name<a, b<c>>` as [name [arg-text ...]] (the commas at its top level), or nil for one
  without arguments."
  [^String s]
  (let [s (str/trim s) i (.indexOf s "<")]
    (when (and (pos? i) (str/ends-with? s ">"))
      (let [inner (subs s (inc i) (dec (count s)))]
        (loop [k 0 depth 0 start 0 out []]
          (if (= k (count inner))
            [(str/trim (subs s 0 i)) (let [l (str/trim (subs inner start))] (if (and (empty? out) (empty? l)) [] (conj out l)))]
            (let [c (.charAt inner k)]
              (cond (#{\< \( \[ \{} c) (recur (inc k) (inc depth) start out)
                    (#{\> \) \] \}} c) (recur (inc k) (dec depth) start out)
                    (and (= c \,) (zero? depth)) (recur (inc k) depth (inc k) (conj out (str/trim (subs inner start k))))
                    :else (recur (inc k) depth start out)))))))))

(defn- mangle-constraint
  "A requires-clause's expression (the native parser's node) as clang 23 mangles it after a function template's
  arguments (Q <expression>; ItaniumMangle.cpp's mangleRequiresClause, mangleExpression): operators, calls, names as
  written (an unresolved simple name with its explicit arguments), the template's own parameters by depth and index;
  `pidx` {name index} of the template's parameters (G4). (cpp-rt-own3, DECISION cpp-rt-own2-2 (a): `q`'s :types, the texts
  it writes as types resolved by sema in the constraint scope, not instantiated -- a member template's class's parameters at
  depth 0, its own at depth 1 (TL0_), alias templates expanded, typedefs resolved, as clang's canonical types -- and :pnames
  {name [depth index kind]} of the parameters that scope binds; the old texts' rules for the rest.)"
  ^String [q]
  (let [n (:node q) pidx (:pidx q) depth (long (or (:depth q) 0)) types (:types q) pnames (:pnames q)]
  (letfn [(ty [^String a]
            ;; a type as written in a constraint: the template's parameters, builtins, pointers, references, cv
            (let [a (str/trim a)]
              (cond
                (get types a) (mangle-type* (get types a))
                (get pidx a) (if (zero? depth) (mangle-type* {:k :tparam :i (get pidx a)}) (q-param depth (get pidx a)))
                (str/ends-with? a "&&") (mangle-type* {:k :rref :to (tt (subs a 0 (- (count a) 2)))})
                (str/ends-with? a "&") (mangle-type* {:k :ref :to (tt (subs a 0 (dec (count a))))})
                :else (mangle-type* (tt a)))))
          (tt [^String a]
            (let [a (str/trim a)]
              (cond
                (str/ends-with? a "*") {:k :ptr :to (tt (subs a 0 (dec (count a))))}
                (str/starts-with? a "const ") (assoc (tt (subs a 6)) :c true)
                (str/ends-with? a " const") (assoc (tt (subs a 0 (- (count a) 6))) :c true)
                (get pidx a) (if (zero? depth) {:k :tparam :i (get pidx a)} (fail :mangle "a member template's parameter type"))
                (get {"void" :void "bool" :bool "char" :char "int" :int "unsigned int" :uint "long" :long "unsigned long" :ulong "double" :double "float" :float} a)
                {:k :b :n (get {"void" :void "bool" :bool "char" :char "int" :int "unsigned int" :uint "long" :long "unsigned long" :ulong "double" :double "float" :float} a)}
                :else (fail :mangle "a constraint's type " a))))
          (arg [^String a]
            (let [a (str/trim a)]
              (cond
                ;; (a non-type parameter as an argument an expression, X <template-param> E)
                (= :value (nth (get pnames a) 2 nil)) (let [[d i] (get pnames a)] (str "X" (q-param d i) "E"))
                (get types a) (mangle-type* (get types a))
                (get pidx a) (q-param depth (get pidx a))
                :else (ty a))))
          (req [r]
            (case (:kind r)
              ;; (clang's mangleRequirement: X <expression>, no end marker)
              "SimpleRequirement" (str "X" (ex (first (:inner r))))
              "NestedRequirement" (str "Q" (ex (first (:inner r))))
              "TypeRequirement" (str "T" (ty (get-in r [:type :qualType])))
              (fail :mangle "a requirement " (:kind r))))
          (ex [n]
            (case (:kind n)
              "ParenExpr" (ex (first (:inner n)))
              ;; requires { ... } (rq <requirement>+ E; with parameters rQ, not written yet)
              "RequiresExpr" (if (seq (:params n)) (fail :mangle "a requires-expression's parameters") (str "rq" (apply str (map req (:inner n))) "E"))
              ;; [gs] nw <placement>* _ <type> (pi <expression>* E | E)
              "CXXNewExpr" (let [ks (:inner n)
                                 [init place] (if (:initStyle n) [(first ks) (rest ks)] [nil ks])
                                 t (str/trim (get-in n [:type :qualType]))
                                 et (if (str/ends-with? t "*") (subs t 0 (dec (count t))) t)]
                             (when (:isArray n) (fail :mangle "an array new in a constraint"))
                             (str (when (:isGlobal n) "gs") "nw" (apply str (map ex place)) "_" (ty et)
                                  (if init (str "pi" (apply str (map ex (if (= "ParenListExpr" (:kind init)) (:inner init) [init]))) "E") "E")))
              "CStyleCastExpr" (str "cv" (ty (get-in n [:type :qualType])) (ex (first (:inner n))))
              "PackExpansionExpr" (str "sp" (ex (first (:inner n))))
              "BinaryOperator" (str (or (expr-op-codes (:opcode n)) (fail :mangle "operator " (:opcode n))) (ex (first (:inner n))) (ex (second (:inner n))))
              "UnaryOperator" (str (case (:opcode n) "!" "nt" "-" "ng" "~" "co" (fail :mangle "operator " (:opcode n))) (ex (first (:inner n))))
              "CallExpr" (str "cl" (apply str (map ex (:inner n))) "E")
              ;; (cpp-rt-own3: sizeof and alignof of a type, st <type> and at <type>; of an expression, sz and az)
              "UnaryExprOrTypeTraitExpr" (let [o (:name n)]
                                           (if-let [t (get-in n [:argType :qualType])]
                                             (str (case o "sizeof" "st" ("alignof" "__alignof" "_Alignof") "at" (fail :mangle "a constraint's " o)) (ty t))
                                             (str (case o "sizeof" "sz" ("alignof" "__alignof" "_Alignof") "az" (fail :mangle "a constraint's " o)) (ex (first (:inner n))))))
              "CXXBoolLiteralExpr" (if (:value n) "Lb1E" "Lb0E")
              "IntegerLiteral" (str "Li" (:value n) "E")
              ("DeclRefExpr" "UnresolvedLookupExpr")
              (let [nm (get-in n [:referencedDecl :name])
                    targs (when-let [as (:explicitTemplateArgs n)] (str "I" (apply str (map arg as)) "E"))]
                (when (:globalQualifier n) (fail :mangle "a ::-qualified name in a constraint"))
                (cond
                  ;; (cpp-rt-own3: T::x of a type parameter, sr <unresolved-type> <name>, no E)
                  (and (= 1 (count (:qualifier n))) (= :type (nth (get pnames (str (first (:qualifier n)))) 2 nil)))
                  (let [[d i] (get pnames (str (first (:qualifier n))))] (str "sr" (q-param d i) (source-name nm) targs))
                  ;; ns::f<...>: sr <the namespaces' names> E <name> (clang's mangleUnresolvedName, unresolved-qualifier-levels)
                  ;; (cpp-rt-own3: a level a template-id as written, its simple-id <source-name> <template-args>: span's
                  ;; `__is_compatible_ref<iter_reference_t<_It>>::value`, sr19__is_compatible_refIDT...EE5value)
                  (seq (:qualifier n)) (str "sr" (apply str (map (fn [q] (let [q (str q)]
                                                                         (if-let [[tn as] (when (str/includes? q "<") (split-template-id q))]
                                                                           (str (source-name tn) "I" (apply str (map arg as)) "E")
                                                                           (if (str/includes? q "<") (fail :mangle "a constraint's qualifier " q) (source-name q)))))
                                                                 (:qualifier n)))
                                            "E" (source-name nm) targs)
                  (and (get pnames nm) (nil? targs)) (let [[d i] (get pnames nm)] (q-param d i))
                  (get pidx nm) (q-param depth (get pidx nm))
                  ;; (cpp-tzdb: a static data member of the enclosing class template, template.ae's constraint-q :members:
                  ;; L _Z <its name in the pattern> E, clang's mangleDeclRefExpr of a resolved declaration)
                  (and (nil? targs) (get (:members q) nm))
                  (let [m (get (:members q) nm)] (str "L_ZN" (mangle-prefix (:path m)) (source-name (:cls m)) (source-name nm) "EE"))
                  :else (str (source-name nm) targs)))
              (fail :mangle "a constraint's " (:kind n))))]
    (ex n))))

(declare encoding*)

(defn mangle-fn
  "A function's mangled name (variant: 1 or 2 for a constructor's C1/C2, 0/1/2 for a destructor's D0/D1/D2). A
  function template's specialization (:tinst) writes its template arguments after its name, then its template's
  signature with the return type (§5.1.3: the parameters as the template declares them, T_ for its own)."
  (^String [f] (mangle-fn f nil))
  (^String [f variant]
   (cond
     (= :c (:linkage f)) (:name f)
     (and (= "main" (:name f)) (empty? (:path f)) (not (:cls f))) "main"
     :else (with-redef :name #(binding [*subs* (atom []) *mangle-id* (:id f)] (str "_Z" (encoding* f variant)))))))

(defn- encoding*
  "A function's <encoding> (its mangled name without _Z) in the current substitution table: a local entity's
  Z <encoding> E <entity> shares it with the enclosing function's encoding (ItaniumMangle.cpp's mangleLocalName)."
  ^String [f variant]
  (cond
     ;; a member of a local class (a closure's operator()): Z encoding E, then the name as if at namespace scope
     (= :local (ffirst (:path f))) (str "Z" (local-enc (second (first (:path f)))) "E" (encoding* (assoc f :path (vec (rest (:path f)))) variant))
     :else
       (let [path (vec (:path f))
             ;; (cpp-rt-own3: a member of a class defined by a qualified name over its declaration in an inline namespace, its
             ;; members the definition's, named in the namespace the definition names, as clang: fs_dir.cc's implicit
             ;; std::filesystem::_Dir::~_Dir(), _ZNSt10filesystem4_DirD2Ev; the declaration's path before for an implicit member)
             path (let [i (last (keep-indexed (fn [i el] (when (and (vector? el) (= :cls (first el)) (:mangle-path-after (cls (second el)))) i)) path))]
                    (if i (into (vec (first (:mangle-path-after (cls (second (nth path i)))))) (subvec path i)) path))
             ti (:tinst f)
             uname (fn [^String out]
                     (if ti
                       (str (if (#{:ctor :dtor :conv} (:kind f))
                              ;; (a constructor template a substitution candidate too: clang's mangleTemplatePrefix)
                              (let [s (str out (unqualified-name f variant))] (swap! *subs* conj [:tmpl (:tid ti)]) s)
                              (let [i (.indexOf ^java.util.List @*subs* [:tmpl (:tid ti)])]
                                (if (neg? i)
                                  (let [s (str out (unqualified-name f variant))] (swap! *subs* conj [:tmpl (:tid ti)]) s)
                                  (seq-id i))))
                            (str "I" (apply str (map-indexed (fn [i a] (str (when-let [t (get (:tn ti) i)]
                                                                      (str (when (:pack t) "Tp")
                                                                           (if-let [k (:tk t)]
                                                                             ;; Tk <type-constraint>: the concept's name (not a substitution candidate)
                                                                             ;; (cpp-rt-own3: with arguments, the concept's template-name a candidate and its
                                                                             ;; arguments as written, clang 23's mangleTypeConstraint: TkSt18sized_sentinel_forITL0__E)
                                                                             (str "Tk" (if-let [as (:args k)]
                                                                                         (cond (empty? (:path k)) (str (template-prefix "" (:tid k) (:name k)) (template-args as))
                                                                                               (= [[:ns "std"]] (:path k)) (str (template-prefix "St" (:tid k) (:name k)) (template-args as))
                                                                                               :else (str "N" (template-prefix (mangle-prefix (:path k)) (:tid k) (:name k)) (template-args as) "E"))
                                                                                         (cond (empty? (:path k)) (source-name (:name k))
                                                                                               (= [[:ns "std"]] (:path k)) (str "St" (source-name (:name k)))
                                                                                               :else (str "N" (mangle-prefix (:path k)) (source-name (:name k)) "E"))))
                                                                             (str "Tn" (mangle-type* (:ty t))))))
                                                                    (template-arg a))) (:args ti)))
                            ;; a constrained template's requires-clause (clang 23: Q <expression>, G4)
                            ;; (one this does not write yet, a requires-expression among it: left out, the names level differs)
                            (when-let [q (:q ti)]
                              (let [saved @*subs*]
                                (try (str "Q" (mangle-constraint q))
                                     (catch arbace.lang.ExceptionInfo _ (reset! *subs* saved) nil))))
                            "E"))
                       (str out (unqualified-name f variant))))
             enc (cond
                   (empty? path) (str (when (:internal-l f) "L") (uname ""))
                   (and (= [[:ns "std"]] path) (not (:cq f))) (uname "St")
                   :else (let [pre (mangle-prefix path)]
                           (str "N" (if (:xobj f) "H" (str (when (:cq f) "K") (case (:refq f) "&" "R" "&&" "O" nil))) (uname pre) "E")))
             sig (if ti (:tsig ti) (:ty f))]
         (str enc
              (when (and ti (not (#{:ctor :dtor :conv} (:kind f)))) (mangle-type* (:ret sig)))
              ;; (an explicit object parameter first among the parameters, cpp-s3)
              (bare-params (if (:xobj f) (into [(:xobj f)] (:ps sig)) (:ps sig)) (:va sig))
              ;; (cpp-rt-own3, DECISION cpp-rt-own2-2 (a): a trailing requires-clause after the parameters, clang 23's Q <expression>
              ;; of a template's (sema's :tq of its :tinst) or of a templated member function's (:tq): basic_string's
              ;; `basic_string() requires is_default_constructible_v<_Alloc>`, ...C2EvQ26is_default_constructible_vIT1_E; one this does
              ;; not write left out, as a template head's)
              (when-let [q (if ti (:tq ti) (:tq f))]
                (let [saved @*subs*]
                  (try (str "Q" (mangle-constraint q))
                       (catch arbace.lang.ExceptionInfo _ (reset! *subs* saved) nil))))))))

(declare mangle-var*)

(defn mangle-var
  "A variable's mangled name at namespace or class scope (a global in the global namespace keeps its name; static: L)."
  ^String [v]
  (with-redef :name #(mangle-var* v)))

(defn- mangle-var*
  ^String [v]
  (binding [*mangle-id* (:id v)]
  (let [path (vec (:path v))
        ti (:tinst v)]
    (cond
      ;; a variable template's specialization: its name with the template arguments
      ti (binding [*subs* (atom [])]
           (if (empty? path)
             (str "_Z" (template-prefix "" (:tid ti) (:name v)) (template-args (:args ti)))
             (str "_ZN" (template-prefix (mangle-prefix path) (:tid ti) (:name v)) (template-args (:args ti)) "E")))
      (= :c (:linkage v)) (:name v)
      (and (empty? path) (not (:internal-l v))) (:name v)
      :else (binding [*subs* (atom [])]
              (cond
                (empty? path) (str "_ZL" (source-name (:name v)))
                ;; ::std::x: an unscoped name, St x (§5.1.2)
                (= [[:ns "std"]] path) (str "_ZSt" (source-name (:name v)))
                :else (str "_ZN" (mangle-prefix path) (source-name (:name v)) "E")))))))

(defn local-encoding
  "A function's encoding as a local name's prefix: its mangled name without _Z (main's: 4main), in the current
  substitution table when one is bound."
  ^String [f]
  (cond
    (and (= "main" (:name f)) (empty? (:path f)) (not (:cls f))) "4main"
    (= :c (:linkage f)) (source-name (:name f))
    ;; a constructor's or destructor's locals: its C1's or D1's names
    :else (let [v (when (#{:ctor :dtor} (:kind f)) 1)]
            (if *subs* (encoding* f v) (binding [*subs* (atom [])] (encoding* f v))))))

(defn mangle-local-static
  "A static local's name in the function f (Itanium §5.1.6: Z encoding E name, the discriminator _N from the second)."
  ^String [f ^String nm ^long disc]
  (with-redef :name
    #(let [enc (binding [*subs* (atom [])] (local-encoding f))]
       (str "_ZZ" enc "E" (source-name nm) (cond (zero? disc) "" (< disc 11) (str "_" (dec disc)) :else (str "__" (dec disc) "_"))))))

(defn mangle-type-name
  "The mangling of a class type alone (for _ZTV, _ZTI, _ZTS)."
  ^String [t]
  (with-redef :type #(binding [*subs* (atom [])] (mangle-type* t))))

(defn mangle-ctor-vtable-name
  "A construction vtable's name, _ZTC <derived> <offset> _ <base>: one name, its substitutions shared by the two types
  (ECPublicKeyIS0_E after 12ECPrivateKeyI4EC2NE)."
  ^String [derived ^long off base]
  (with-redef :name #(binding [*subs* (atom [])] (str "_ZTC" (mangle-type* derived) off "_" (mangle-type* base)))))

;; ---------------------------------------------------------------------------------------------
;; The SysV x86-64 psABI's classification of a class passed or returned by value (§3.2.3; in the structure of clang's
;; X86_64ABIInfo::classify, its Lo/Hi eightbytes, merge and postMerge; written from the psABI's text, clang's output
;; the oracle: CODEGEN.md's P3)

(defn- merge-class [a b]
  (cond (= a b) a (= a :none) b (= b :none) a (or (= a :memory) (= b :memory)) :memory
        (or (= a :integer) (= b :integer)) :integer (or (= a :x87) (= b :x87)) :memory :else :sse))

(defn- scalar-class [t]
  (let [t (unq t)]
    (cond (floating? t) (if (= :ldouble (bn t)) :x87 :sse)
          (= :mptr (:k t)) :integer
          :else :integer)))

(defn- mark! [acc ^long e cls ^long end]
  (when (< e 2) (swap! acc #(-> % (update e merge-class cls) (update (+ 2 e) max end)))))

(defn- classify-into!
  "Merges the classes of the object of type `t` at byte `off` into the eightbytes (`acc`, an atom of [lo hi lo-end
  hi-end])."
  [acc t ^long off]
  (let [t (unq t)]
    (cond
      (= :arr (:k t))
      (let [et (:of t) es (size-of et)] (dotimes [i (long (or (:n t) 0))] (classify-into! acc et (+ off (* i es)))))
      (= :class (:k t))
      (let [id (:id t) c (cls id) l (layout id)]
        (when (:vptr l) (mark! acc (quot off 8) :integer (+ (rem off 8) 8)))
        (doseq [[i b] (map-indexed vector (:bases c))]
          (classify-into! acc {:k :class :id (:cls b)} (+ off (long (nth (:bases l) i)))))
        (doseq [[i f] (map-indexed vector (:fields c))]
          (let [bo (nth (:bitoffs l) i)]
            (cond
              (nil? bo) (classify-into! acc (:ty f) (+ off (long (nth (:fields l) i))))
              (pos? (long (:bits f)))
              (let [b0 (+ (* 8 off) (long bo)) b1 (+ b0 (long (:bits f)) -1)]
                (doseq [e (range (quot b0 64) (inc (quot b1 64)))]
                  (mark! acc e :integer (min 8 (- (quot (+ b1 8) 8) (* 8 e))))))
              :else nil))))
      (= :mptr (:k t))
      (doseq [e (range (quot off 8) (inc (quot (+ off (size-of t) -1) 8)))] (mark! acc e :integer 8))
      ;; (a GNU complex member: its two parts, cpp-s3)
      (= :complex (:k t))
      (let [et (:of t)] (classify-into! acc et off) (classify-into! acc et (+ off (size-of et))))
      ;; (a GNU vector member: the psABI's __m64/__m128 classes are not modelled, n-cpp-eval)
      (= :vec (:k t)) (fail :type "a GNU vector type passed by value in a class")
      :else
      (let [e (quot off 8)] (mark! acc e (scalar-class t) (- (+ off (size-of t)) (* 8 e)))))))

(defn classify-class
  "How a class of trivially copyable type passes by value: :ignore (an empty class), :memory, or the eightbytes'
  [[:integer|:sse bytes] ...]."
  [id]
  (let [sz (size-of {:k :class :id id})]
    (cond
      (and (empty-class? id) (= 1 sz)) :ignore
      (> sz 16) :memory
      :else
      (let [acc (atom [:none :none 0 0])]
        (classify-into! acc {:k :class :id id} 0)
        (let [[lo hi e0 e1] @acc
              n (if (> sz 8) 2 1)]
          (if (or (= lo :memory) (= hi :memory) (= lo :x87) (= hi :x87))
            :memory
            (vec (for [e (range n) :let [c (nth [lo hi] e) c (if (= c :none) :sse c)]]
                   [c (max 1 (long (nth [e0 e1] e)))]))))))))

(ns arbace.go.check.env
  "goi's checker: its state (doc/go/GOI-SPEC.md §3.3): objects, scopes, the universe, errors,
  and the per-declaration records of the annotations verified (§3.6).

  Objects are volatiles holding maps, so that they have identity (=, hash) and can be completed
  as the checker resolves them: {:kind :var|:const|:type|:func|:pkg|:label|:builtin|:nil,
  :name, :type, :pkg (the package path), :file, :line, ...}. A scope is {:parent :names
  (a HashMap from name to object) :kind}."
  (:require [arbace.string :as str]
            [arbace.go.check.types :as t]
            [arbace.go.check.const :as c]))

;;; Objects

(defn obj [m] (volatile! m))
(defn o [x k] (get @x k))
(defn oset! [x k v] (vswap! x assoc k v) x)
(defn obj? [x] (instance? arbace.lang.Volatile x))

;;; Scopes

(defn scope [parent kind] {:parent parent :names (java.util.HashMap.) :kind kind})

(defn scope-lookup
  "The object named n in scope s or its parents, or nil."
  [s ^String n]
  (loop [s s]
    (when s
      (if-let [x (.get ^java.util.HashMap (:names s) n)]
        x
        (recur (:parent s))))))

(defn scope-get [s ^String n] (.get ^java.util.HashMap (:names s) n))
(defn scope-put! [s ^String n x] (.put ^java.util.HashMap (:names s) n x))

;;; The checker's dynamic state

(def ^:dynamic *pkg*
  "The package being checked: a volatile {:path :name :scope :files :config :lang ...}."
  nil)

(def ^:dynamic *gofile*
  "The file being checked: {:name :scope :lang :imports}."
  nil)

(def ^:dynamic *decl*
  "The package-level declaration being checked: its decl info (a volatile)."
  nil)

(def ^:dynamic *session*
  "The checking session: {:packages (an atom: path -> package) ...}."
  nil)

;;; Errors

(def ^:dynamic *errors* "A volatile vector of the package's errors." nil)

(def ^:dynamic *errpos*
  "go/types' errpos: while a constant with an inherited initializer (an implicit repetition
  in a group) is checked, the line of its name, where its errors are reported (the
  expression's lines are its first spec's)."
  nil)

(defn error!
  "Records an error at line (the current file's), go/types' code kw and message msg."
  ([line code msg] (error! (:name *gofile*) line code msg))
  ([file line code msg]
   (when (and *errors*
              ;; go/types' cheap trick: after a first error, one that names an invalid operand
              ;; or an invalid type (not at its beginning) is a follow-on error, not reported
              (not (and (seq @*errors*)
                        (let [^String m msg]
                          (or (pos? (.indexOf m "invalid operand")) (pos? (.indexOf m "invalid type")))))))
     (let [line (or *errpos* line)
           e {:file file :line line :msg msg :code code
              :decl (when *decl* (o *decl* :id))}]
       (vswap! *errors* conj e)))
   nil))

(defn line-of
  "The :line of a form's metadata, or nil."
  [form]
  (when (instance? arbace.lang.IMeta form)
    (:line (meta form))))

(def ^:dynamic *line* "The line of the innermost form with one, for errors." nil)

(declare child-line)

(defn- end-line
  "The last Go line of child c, which begins on line l (doc/go/SPEC.md §10.1): a list's or a
  vector's last child's, a function's :go/end."
  [c l]
  (let [l (if (and (or (seq? c) (vector? c)) (seq c))
            (let [c (if (vector? c) c (with-meta (vec c) (meta c)))
                  k (dec (count c))]
              (end-line (nth c k) (child-line c k l)))
            l)]
    (max l (or (when (instance? arbace.lang.IMeta c) (:go/end (meta c))) 0))))

(defn child-line
  "The Go line of child i of list or vector f (doc/go/SPEC.md §10.1, mode :lines): its own
  :line, else by f's :go/breaks (a literal that begins a Go line: the line after the one its
  predecessor ends on, or the line recorded), else its predecessor's last line; nil when f has
  no line. With start, f begins on that line."
  ([f i] (child-line f i (line-of f)))
  ([f i start]
   (when (and start (or (seq? f) (vector? f)) (< i (count f)))
     (let [m (meta f)
           f (if (vector? f) f (vec f))]
       (or (line-of (nth f i))
           ;; from the nearest child before it with a line of its own (or the head)
           (let [bmap (into {} (for [b (:go/breaks m)] (if (vector? b) [(nth b 0) (nth b 1)] [b nil])))
                 j (loop [j i] (if (or (zero? j) (line-of (nth f j))) j (recur (dec j))))]
             (loop [k (inc j) line (or (line-of (nth f j)) start)]
               (if (> k i)
                 line
                 (let [pe (end-line (nth f (dec k)) line)]
                   (recur (inc k) (if (contains? bmap k) (or (get bmap k) (inc pe)) pe)))))))))))

(def ^:dynamic *child-at*
  "[parent i] while checking child i of form parent, a literal without a :line of its own: its
  line is computed when an error needs it (child-line); nil inside a form with a line."
  nil)

(defmacro with-child-line
  "Checks body as child i of form parent: when the child has no :line (a literal), errors take
  its line from parent's :go/breaks (child-line), computed only when one is reported."
  [parent i & body]
  `(let [p# ~parent i# ~i
         f# (fn [] ~@body)]
     (if (line-of (nth p# i# nil)) (f#) (binding [*child-at* [p# i#]] (f#)))))

(defn current-line
  "The line errors take now: the literal's being checked (*child-at*), else *line*."
  []
  (or (when-let [[p i] *child-at*] (child-line p i)) *line*))

(defn err!
  "An error at form f's line (or the current line)."
  [f code fmt & args]
  (error! (or (line-of f) (current-line)) code (if (seq args) (apply format fmt args) fmt)))

;;; Generics (GR6): what the checker does not check yet

(defn generic!
  "Marks the current declaration as using generics: it is counted apart and its errors are
  not counted (S53)."
  []
  (when *decl* (vswap! *decl* assoc :generic true)))

(defn unsupported!
  "Marks the current declaration as using what GR2's checker does not check (generic code):
  it is counted apart (S53), its errors not counted; checking goes on (its references, the
  imports it uses, its dependencies are recorded), the operand invalid. Returns nil."
  [what]
  (generic!)
  (when (and *decl* (nil? (:unsupported @*decl*)))
    (vswap! *decl* assoc :unsupported what :unsupported-line *line*))
  nil)

(defn unsupported? [e] (and (instance? arbace.lang.ExceptionInfo e) (::unsupported (ex-data e))))

;;; Annotations verified (§3.6)

(def ^:dynamic *seen*
  "The package's annotated forms verified (an IdentityHashMap): a form checked twice (an
  implicitly repeated constant init) counts once."
  nil)

(defn verified!
  "Counts an annotation of kind k (:val :tag :go/via :assign :conv :init-order) verified in the
  current declaration, once per form (f, when given: a form checked twice counts once)."
  ([k] (when *decl* (vswap! *decl* update-in [:verified k] (fnil inc 0))))
  ([k f]
   (when *decl*
     (let [^java.util.IdentityHashMap seen (or *seen* (:seen @*decl*)
                                               (let [m (java.util.IdentityHashMap.)] (vswap! *decl* assoc :seen m) m))
           ks (.get seen f)]
       (when-not (contains? ks k)
         (.put seen f (conj (or ks #{}) k))
         (verified! k))))))

(defn annotation-error!
  "An annotation that disagrees with the checker (S16)."
  [f a what forms-say checker-says]
  (err! f :AnnotationMismatch "annotation %s on %s disagrees with goi's checker: forms say %s, the checker says %s"
        a what forms-say checker-says))

;;; The universe

(def universe (scope nil :universe))

(defn- def-type! [n kw] (scope-put! universe n (obj {:kind :type :name n :type kw :universe true})))

(doseq [[n kw] [["bool" :bool] ["int8" :int8] ["int16" :int16] ["int32" :int32] ["int64" :int64]
                ["int" :int] ["uint8" :uint8] ["uint16" :uint16] ["uint32" :uint32] ["uint64" :uint64]
                ["uint" :uint] ["uintptr" :uintptr] ["float32" :float32] ["float64" :float64]
                ["complex64" :complex64] ["complex128" :complex128] ["string" :string]
                ["byte" :uint8] ["rune" :int32]]]
  (def-type! n kw))

(def error-type
  (let [nt (t/new-named {:name "error" :pkg nil})]
    (t/update-info! nt assoc :underlying
                    [:interface [{:name "Error" :pkg nil :type [:func [] [:string] false]}] nil])
    nt))

(scope-put! universe "error" (obj {:kind :type :name "error" :type error-type :universe true}))
(scope-put! universe "any" (obj {:kind :type :name "any" :type [:interface [] nil] :alias true :universe true}))

(def comparable-type
  (let [nt (t/new-named {:name "comparable" :pkg nil})]
    (t/update-info! nt assoc :underlying [:interface [] (t/make-tset :all true)])
    nt))

(scope-put! universe "comparable" (obj {:kind :type :name "comparable" :type comparable-type :universe true}))

(scope-put! universe "true" (obj {:kind :const :name "true" :type :untyped-bool :val true :universe true}))
(scope-put! universe "false" (obj {:kind :const :name "false" :type :untyped-bool :val false :universe true}))
(scope-put! universe "iota" (obj {:kind :const :name "iota" :type :untyped-int :val 0 :iota true :universe true}))
(scope-put! universe "nil" (obj {:kind :nil :name "nil" :type :untyped-nil :universe true}))

(def builtin-names
  ["append" "cap" "clear" "close" "complex" "copy" "delete" "imag" "len" "make" "max" "min"
   "new" "panic" "print" "println" "real" "recover"])

(doseq [n builtin-names]
  (scope-put! universe n (obj {:kind :builtin :name n :universe true})))

;;; The package unsafe

(def unsafe-scope
  (let [s (scope nil :package)]
    (scope-put! s "Pointer" (obj {:kind :type :name "Pointer" :type :unsafe-pointer :pkg "unsafe" :exported true}))
    (doseq [n ["Sizeof" "Alignof" "Offsetof" "Add" "Slice" "SliceData" "String" "StringData"]]
      (scope-put! s n (obj {:kind :builtin :name n :unsafe true :pkg "unsafe"})))
    s))

(def unsafe-package (volatile! {:path "unsafe" :name "unsafe" :scope unsafe-scope :fake true}))

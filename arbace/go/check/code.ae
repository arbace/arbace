(ns arbace.go.check.code
  "goi's checker: Go context (doc/go/GOI-SPEC.md §3.4): type expressions, expressions, calls
  and builtins, statements, as go/types checks them (typexpr.go, expr.go, call.go,
  builtins.go, stmt.go, assignments.go ...). The checked tree's nodes (§3.7) are maps with :op,
  :line, and for expressions :type and :mode (:value, :variable, :mapindex, :constant with :val,
  :commaok, :novalue, :typexpr, :builtin, :invalid).

  The parts: this file (helpers, names, type expressions), code_expr.ae (operands, untyped
  constants, operators, conversions), code_call.ae (selectors, calls, builtins, literals),
  code_stmt.ae (statements and function bodies)."
  (:require [arbace.string :as str]
            [arbace.go.check.types :as t]
            [arbace.go.check.const :as c]
            [arbace.go.check.env :as e :refer [o oset! err! error!]]))

(declare check-branches! inst-say record-inst! instantiate-fn slice-elem tparam-index generic-fn? func-inst-target call-sig rename-tparams infer instance-type mark-addressed! call-form? expr expr-or-type multi-expr typexpr typexpr-generic byte-string-value literal const-node invalid-conversion! finish-comparison composite-lit builtin-call val-equal? val-form-str key-val stmt terminating? missing-cause implements? invalid invalid? signature rhs-values init-var assignment func-body check-fn-lit const-expr
         convert-untyped update-type operand-str expr-str stmt-list expr-internal pkg-path)

;;; Hooks set by arbace.go.check.decl

(def ^:dynamic *obj-decl*
  "A function checking a package-level object's declaration (go/types' objDecl)."
  nil)

(def ^:dynamic *package-of-ns*
  "A function from a namespace name (go.x.y) to its package, for the qualified names of
  annotations (doc/go/SPEC.md §4.4)."
  nil)

(def ^:dynamic *instantiate*
  "A function [generic-named targs] -> the instance, bound by the checker."
  nil)

(def ^:dynamic *subst*
  "A function [type {tparam type}] -> the type substituted, bound by the checker."
  nil)

(def ^:dynamic *verify-later*
  "A function [form tparams targs] verifying (later) that the type arguments satisfy their
  constraints (go/types' verify), bound by the checker."
  nil)

;;; Cycles (GR7c: decl.go's cycleError, validtype.go)

(defn cycle-error!
  "go/types' cycleError (decl.go): the cycle of entries [{:name :line :file} ...] reported at
  entry start, a type's (type?) or a value's. A cycle of one is said concisely; a longer one
  adds a line per reference, as types2 does (\"\\n\\tFILE:LINE: a refers to b\", from start
  around), each at its entry's position (gc's columns are not in the forms: FILE:LINE)."
  [entries start type?]
  (let [n (count entries)
        x (nth entries start)
        msg (if (= 1 n)
              (str (if type? "invalid recursive type: " "invalid cycle in declaration: ") (:name x) " refers to itself")
              (apply str (if type? "invalid recursive type " "invalid cycle in declaration of ") (:name x)
                     (for [i (range n)
                           :let [y (nth entries (mod (+ start i) n))
                                 z (nth entries (mod (+ start i 1) n))]]
                       (str "\n\t" (:file y) ":" (:line y) ": " (:name y) " refers to " (:name z)))))]
    (e/error! (:file x) (:line x) :InvalidDeclCycle msg)))

(defn obj-entry
  "A cycle's entry of object x: its name and position."
  [x]
  {:name (o x :name) :line (o x :line) :file (or (o x :file) (:name e/*gofile*))})

(defn- named-entry
  "A cycle's entry of named type nt: a declared type's name and position, an instance's
  string (T[A]) and the position of its first instantiation."
  [nt]
  (let [i (t/info nt)
        x (:obj i)]
    (if (:origin i)
      {:name (t/type-str nt) :line (or (:line i) (some-> x (o :line))) :file (or (:file i) (some-> x (o :file)) (:name e/*gofile*))}
      {:name (:name i) :line (some-> x (o :line)) :file (or (some-> x (o :file)) (:name e/*gofile*))})))

(defn valid-type!
  "go/types' validType (validtype.go): reports named type nt when it contains itself without
  an indirection, through array elements, struct fields, union terms, embedded interfaces
  (an interface type's :embeddeds, its metadata) and the type arguments of instances (nest,
  the instances entered, and path, the named types: go/types' own). The cycle is reported by
  cycle-error! from its first type, which is made invalid (its RHS, go/types' fromRHS). The RHS
  of a named type is its :underlying as declared (a named type or a type literal); an
  instance's, its origin's."
  [nt]
  (letfn [(walk [ty nest path]
            (cond
              (keyword? ty) true
              (t/named? ty)
              (let [i (t/info ty)]
                (cond
                  (some #(= % ty) nest)
                  (let [start (.indexOf ^java.util.List path ty)]
                    (t/update-info! (or (:origin i) ty) assoc :underlying :invalid)
                    (cycle-error! (mapv named-entry (subvec path start)) 0 true)
                    false)
                  ;; another package's types are complete (an instance may have this package's
                  ;; type arguments: go.dev/issue/50788)
                  (and (nil? (:origin i)) (not= (:pkg i) (pkg-path))) true
                  :else
                  (let [rhs (if (:origin i) (:underlying (t/info (:origin i))) (:underlying i))]
                    (or (nil? rhs) (walk rhs (conj nest ty) (conj path ty))))))
              (t/tparam? ty)
              ;; a type parameter of the innermost instance entered: its type argument
              (let [inst (peek nest)
                    ii (some-> inst t/info)
                    tps (some-> ii :origin t/info :tparams)
                    k (if tps (.indexOf ^java.util.List tps ty) -1)]
                (if (and (>= k 0) (< k (count (:targs ii))))
                  (walk (nth (:targs ii) k) (pop nest) path)
                  true))
              :else
              (case (nth ty 0)
                :array (walk (nth ty 2) nest path)
                :struct (every? #(walk (:type %) nest path) (nth ty 1))
                :union (let [ts (nth ty 1)] (or (= :all ts) (every? #(walk (nth % 1) nest path) ts)))
                :interface (every? #(walk % nest path) (:embeddeds (meta ty)))
                true)))]
    (walk nt [] [])))

;; go/types' later of validType, in the order the type declarations began (at the start of
;; typeDecl), run after the bodies (before the declarations' other laters)
(def ^:dynamic *valid-types* "The package's queue of validType checks (a volatile vector of fns)." nil)

(defn valid-type-later!
  "Queues validType of named type nt (a declaration of the package or a local one)."
  [nt]
  (when-let [v *valid-types*]
    (let [d e/*decl* fi e/*gofile*]
      (vswap! v conj (fn [] (binding [e/*decl* d e/*gofile* fi] (valid-type! nt)))))))

;;; Forms

(defn head-name
  "The name of a list's head symbol, or nil: \"go/func\" for go/func, \"deref\" for
  arbace.core/deref."
  [f]
  (when (and (seq? f) (symbol? (first f)))
    (let [s (first f)]
      (if (and (namespace s) (= "deref" (name s)) (#{"arbace.core" "clojure.core"} (namespace s)))
        "deref"
        (if (= "go" (namespace s)) (str "go/" (name s)) (when-not (namespace s) (name s)))))))

(defn go-id?
  "Whether f is (go/id \"x\")."
  [f]
  (and (seq? f) (= 'go/id (first f))))

(defn ident-name
  "The Go name of a symbol or (go/id \"x\")."
  ^String [f]
  (if (go-id? f) (second f) (name f)))

(defn go-ident? [f] (or (and (symbol? f) (nil? (namespace f))) (go-id? f)))

(defn fline [f] (e/line-of f))

(defmacro with-line
  "Binds the current line to form f's line (when it has one) for errors."
  [f & body]
  `(let [l# (fline ~f)]
     (if l# (binding [e/*line* l# e/*child-at* nil] ~@body) (do ~@body))))

(defmacro with-elem
  "Checks body as child i of form parent (an element of a literal, a statement of a list, a
  value): errors at the child's line, its own or, for a literal, by parent's :go/breaks."
  [parent i & body]
  `(let [p# ~parent i# ~i
         c# (nth p# i# nil)
         ;; the body once (its code is not repeated per branch)
         f# (fn [] ~@body)
         l# (fline c#)]
     (cond
       l# (binding [e/*line* l# e/*child-at* nil] (f#))
       (e/line-of p#) (binding [e/*child-at* [p# i#]] (f#))
       :else (f#))))

(def reserved-expr-heads
  #{"+" "-" "*" "/" "%" "<<" ">>" "==" "!=" "<" "<=" ">" ">=" "and" "or" "not" "bit-and" "bit-or"
    "bit-xor" "bit-not" "bit-and-not" "addr" "<!" "lit" "conv" "assert" "aget" "subslice" "spread"
    "values" "inst" "method-expr" "fn" "zero" "rune" "imaginary" "byte-string" "deref"
    "append" "cap" "clear" "close" "complex" "copy" "delete" "imag" "len" "make" "max" "min" "new"
    "panic" "print" "println" "real" "recover" "go/call" "go/id"})

;;; Language versions

(defn lang-minor
  "The minor version of a language version \"go1.N\" (27 for go1.27)."
  ^long [v]
  (if-let [[_ m] (and v (re-matches #"go1\.(\d+)(\..*)?" (str v)))]
    (Long/parseLong m)
    27))

(defn allow-version? [cx minor] (>= (long (:lang cx 27)) (long minor)))

;;; Names

(defn pkg-path [] (o e/*pkg* :path))

(defn package-level? [x] (o x :pkg-level))

(defn note-ref!
  "Records a reference to package-level object x in the current declaration: :refs, and the
  dependencies of initialization order (vars, consts, funcs: go/types' addDeclDep)."
  [x]
  (when (and e/*decl* (package-level? x) (= (o x :pkg) (pkg-path)))
    (vswap! e/*decl* update :refs (fnil conj #{}) x)
    (when (#{:var :const :func} (o x :kind))
      (vswap! e/*decl* update :deps (fnil conj #{}) x))))

(defn use-var!
  "Marks a variable used, and captured when referenced from a function literal other than its
  own (the variables of other packages are left alone: they are complete)."
  [cx x]
  (when (and (= :var (o x :kind)) (or (o x :local?) (= (o x :pkg) (pkg-path))))
    (when-not (o x :used) (oset! x :used true))
    (when (and (o x :local?) (not= (o x :fn-id) (:fn-id cx)) (not (o x :captured?)))
      (oset! x :captured? true))))

(defn resolve-name
  "The object a name denotes in cx's scopes (locals, the package, the file's imports, the
  universe), declared; nil when undefined. A package name used alone is no use of its
  import (go/types: \"use of package fmt not in selector\", the import unused)."
  [cx ^String n]
  (when-let [x (or (e/scope-lookup (:scope cx) n)
                   (when-let [[x imp] (some-> (:file cx) :dots (.get n))]
                     (oset! imp :used true)
                     x)
                   (e/scope-get e/universe n))]
    (when (and (package-level? x) *obj-decl* (not (and (= :type (o x :kind)) (not (o x :alias)))))
      (*obj-decl* x))
    x))

(defn package-by-qualifier
  "The package a qualifier names: the file's import name, or a namespace (go.x.y) in the
  forms' annotations."
  [cx ^String q]
  (if (str/includes? q ".")
    (when *package-of-ns* (*package-of-ns* q))
    (let [x (e/scope-get (:file-scope cx) q)]
      (when (and x (= :pkg (o x :kind)))
        (oset! x :used true)
        (o x :imported)))))

(defn qualified-obj
  "The exported object pkg/Name names, with an error when there is none."
  [cx sym]
  (let [q (namespace sym) n (name sym)
        p (package-by-qualifier cx q)]
    (cond
      (nil? p) (do (err! sym :UndeclaredName "undefined: %s" q) nil)
      :else
      (let [x (e/scope-get (o p :scope) n)]
        (cond
          (and (nil? x) (not (o p :fake)) (not (t/exported? n)) (nil? (e/scope-get (o p :scope) n)))
          (do (err! sym :UndeclaredImportedName "undefined: %s.%s" (o p :name) n) nil)
          (nil? x) (do (err! sym :UndeclaredImportedName "undefined: %s.%s" (o p :name) n) nil)
          (and (not (t/exported? n)) (not (str/includes? q ".")) (not (o x :unsafe)) (not= "Pointer" n))
          (do (err! sym :UnexportedName "name %s not exported by package %s" n (o p :name)) nil)
          :else
          (do (when (and (package-level? x) *obj-decl* (not (and (= :type (o x :kind)) (not (o x :alias)))))
                (*obj-decl* x))
              x))))))

;;; Type expressions (typexpr.go)

(defn- type-params-generic! [] (e/generic!))

(defn type-of-obj
  "The type a type name object denotes; generic types without instantiation are an error."
  [f x]
  (let [ty (o x :type)]
    (cond
      (nil? ty) :invalid
      (or (and (t/named? ty) (seq (:tparams (t/info ty))) (not (:targs (t/info ty)))) (o x :tparams-count))
      (let [tps (or (when (t/named? ty) (:tparams (t/info ty))) (o x :tparams))
            bound-str (fn [b] (if (or (nil? b) (= b [:interface [] nil])) "any" (t/type-str b)))]
        ;; types2 names the type with its type parameters: List[T any]
        (err! f :WrongTypeArgCount "cannot use generic type %s without instantiation"
              (if (seq tps)
                (str (o x :name) "[" (str/join ", " (for [tp tps] (str (:name (t/info tp)) " " (bound-str (:bound (t/info tp)))))) "]")
                (o x :name)))
        :invalid)
      :else ty)))

(defn ident-type
  "The type a type name (a symbol, pkg/T, go.ns/T) denotes."
  [cx f]
  (let [x (if (and (symbol? f) (namespace f))
            (qualified-obj cx f)
            (let [n (ident-name f)]
              (if (= "_" n)
                (do (err! f :InvalidBlank "cannot use _ as value or type") nil)
                (or (resolve-name cx n) (do (err! f :UndeclaredName "undefined: %s" n) nil)))))]
    (cond
      (nil? x) :invalid
      (not= :type (o x :kind))
      ;; go/types' ident: a variable named is used, even where a type was expected
      (do (when (= :var (o x :kind)) (use-var! cx x))
          (err! f :NotAType "%s is not a type" (expr-str f)) :invalid)
      ;; a local alias named in its own declaration (go/types' objPath: a cycle of one alias)
      (o x :in-decl)
      (do (cycle-error! [(obj-entry x)] 0 true) :invalid)
      :else
      (do (note-ref! x)
          (when (o x :generic-invalid) (e/generic!))
          (when (and (o x :pkg-level) (o x :tparams-count)) (e/generic!))
          (type-of-obj f x)))))

(defn tag-type
  "The type of a declared name: its :tag (a symbol or a type form)."
  [cx sym]
  (when-let [tg (:tag (meta sym))]
    (typexpr cx tg)))

(defn- struct-field-type? [x] (not (and (or (symbol? x) (go-id? x)) (:tag (meta x)))))

(defn- embedded-name
  "The field name of an embedded type form: T, pkg/T, (* T), (G args)."
  [f]
  (cond
    (symbol? f) (name f)
    (go-id? f) (second f)
    (and (seq? f) (= '* (first f))) (embedded-name (second f))
    (and (seq? f) (= 'inst (first f))) (embedded-name (second f))
    (seq? f) (embedded-name (first f))
    :else "?"))

(defn struct-type
  "A struct type form (struct field*)."
  [cx f]
  (let [p (pkg-path)
        fields (vec
                (for [[i x] (map-indexed vector (rest f))]
                  (with-line x
                  (if (struct-field-type? x)
                    ;; an embedded field
                    (let [ty (typexpr cx x)
                          n (embedded-name x)]
                      ;; embedded: a type name or a pointer to a non-interface type name
                      ;; go/types: checked later (the embedded type may not be complete yet)
                      (let [line (or (fline x) (e/current-line))
                            chk (fn []
                                  (let [[base ptr] (t/deref-type ty)
                                        u (t/under base)]
                                    (when (t/valid? ty)
                                      (cond
                                        (= :unsafe-pointer u)
                                        (e/error! line :InvalidPtrEmbed "embedded field type cannot be unsafe.Pointer")
                                        (t/pointer? u)
                                        (e/error! line :InvalidPtrEmbed "embedded field type cannot be a pointer")
                                        (and ptr (t/interface? u))
                                        (e/error! line :InvalidPtrEmbed "embedded field type cannot be a pointer to an interface")))))]
                        (if e/*decl* (vswap! e/*decl* update :later (fnil conj []) chk) (chk)))
                      {:name n :type ty :tag (when-let [tg (:go/tag (meta x))] (when (seq tg) (c/utf8-value tg)))
                       :embedded true :pkg (when-not (t/exported? n) p) :line (fline x)})
                    (let [n (ident-name x)]
                      {:name n :type (tag-type cx x) :tag (when-let [tg (:go/tag (meta x))] (when (seq tg) (c/utf8-value tg)))
                       :embedded false :pkg (when-not (t/exported? n) p) :line (or (fline x) (e/child-line f (inc i)))})))))]
    ;; duplicate field names: an error, the field not added (go/types' declareInSet)
    (let [fields (second
                  (reduce (fn [[seen acc] fd]
                            (let [n (:name fd)]
                              (if (and (not= "_" n) (contains? seen n))
                                (do (error! (or (:line fd) (e/current-line)) :DuplicateDecl (format "%s redeclared" n)) [seen acc])
                                [(conj seen n) (conj acc fd)])))
                          [#{} []] fields))]
      [:struct (mapv #(dissoc % :line) fields)])))

(declare signature dup-params!)

(defn- method-elem? [x] (and (seq? x) (or (and (symbol? (first x)) (nil? (namespace (first x)))) (go-id? (first x))) (vector? (second x))))

(defn union-type
  "A union or a term of a constraint ((| A (tilde B) ...), (tilde B)): [:union terms], the terms
  normalized (go/types' parseUnion, computeUnionTypeSet): an interface term contributes its type
  set's terms."
  [cx f]
  (let [elems (if (= '| (first f)) (rest f) [f])
        terms (for [x elems]
                (with-line x
                  (if (and (seq? x) (= 'tilde (first x)))
                    (let [ty (typexpr cx (second x))]
                      (cond
                        (not (t/valid? ty)) nil
                        (t/interface? ty)
                        (do (err! x :InvalidUnion "invalid use of ~ (%s is an interface)" (t/type-str ty)) nil)
                        (not= ty (t/under ty))
                        (do (err! x :InvalidUnion "invalid use of ~ (underlying type of %s is %s)" (t/type-str ty) (t/type-str (t/under ty))) nil)
                        :else #{[true ty]}))
                    (let [ty (typexpr cx x)
                          u (t/under ty)]
                      (cond
                        (not (t/valid? ty)) nil
                        (t/tparam? ty) (do (err! x :MisplacedTypeParam "term cannot be a type parameter") nil)
                        (and (vector? u) (= :interface (nth u 0))) (:terms (t/iface-tset u))
                        (t/union? u) (nth u 1)
                        :else #{[false ty]})))))]
    [:union (reduce t/terms-union #{} (remove nil? terms))]))

(defn- intersect-term-lists
  "go/types' intersectTermLists: [terms comparable] of two type set elements."
  [xt xc yt yc]
  (let [terms (t/terms-intersect xt yt)
        comp (or xc yc)]
    (if (and comp (not= :all terms))
      [(set (filter (fn [[_ ty]] (t/strictly-comparable? ty)) terms)) false]
      [terms comp])))

(defn interface-type
  "An interface type form (interface element*): its methods, embedded interfaces flattened, and
  its type set (go/types' computeInterfaceTypeSet): the intersection of its elements' terms."
  [cx f]
  (let [p (pkg-path)
        own (doall
             (for [[i x] (map-indexed vector (rest f)) :when (method-elem? x)]
               (let [n (ident-name (first x))
                     line (or (fline x) (e/child-line f (inc i)))
                     [sig ps rs] (with-line x (signature cx (rest x) nil))]
                 (with-line x (dup-params! ps rs))
                 (if (= "_" n)
                   ;; go/types: an error, the method ignored
                   (do (e/error! (or line (e/current-line)) :BlankIfaceMethod "methods must have a unique non-blank name") nil)
                   {:name n :pkg (when-not (t/exported? n) p) :type sig :line line}))))
        own (remove nil? own)
        etys (vec (for [x (rest f) :when (not (method-elem? x))]
                    (with-line x
                      [x (if (and (seq? x) (#{'| 'tilde} (first x))) (union-type cx x) (typexpr cx x))])))
        elems (vec (for [[x ty] etys]
                     (with-line x
                       (let [u (t/under ty)]
                         (cond
                           (not (t/valid? ty)) nil
                           (t/tparam? ty) (do (err! x :MisplacedTypeParam "cannot embed a type parameter") nil)
                           ;; go/types' computeInterfaceTypeSet: an element of an invalid type (a
                           ;; type whose declaration is in progress: a cycle) is ignored
                           (not (t/valid? u)) nil
                           (t/union? u)
                           (if (allow-version? cx 18)
                             {:terms (nth u 1)}
                             (do (err! x :UnsupportedFeature "embedding interface element %s requires go1.18 or later" (t/type-str u)) nil))
                           (and (vector? u) (= :interface (nth u 0)))
                           (let [ts (t/iface-tset u)] {:methods (:methods ts) :terms (:terms ts) :comparable (:comparable ts)})
                           (not (allow-version? cx 18))
                           (do (err! x :UnsupportedFeature "embedding non-interface type %s requires go1.18 or later" (t/type-str ty)) nil)
                           :else {:terms #{[false ty]}})))))
        embedded (keep :methods elems)
        [terms comp] (reduce (fn [[xt xc] el] (if el (intersect-term-lists xt xc (:terms el) (:comparable el)) [xt xc]))
                             [:all false] elems)
        ms (reduce (fn [acc m]
                     (let [k [(:name m) (:pkg m)]]
                       (if-let [prev (get acc k)]
                         (do (when (or (and (:own prev) (:own m)) (not= (:type prev) (:type m)))
                               ;; an embedded interface's method: at the interface (its embedding)
                               (error! (or (:line m) (e/current-line)) :DuplicateDecl (format "duplicate method %s" (:name m))))
                             acc)
                         (assoc acc k m))))
                   {}
                   (concat (map #(assoc % :own true) own) (apply concat embedded)))]
    ;; the embedded types for validType (GR7c), as metadata: types are compared by value
    (with-meta [:interface (t/sort-methods (map #(dissoc % :own :line) (vals ms))) (t/make-tset terms comp)]
               (when (seq etys) {:embeddeds (mapv second etys)}))))

(defn array-length
  "The length of an array type: a constant expression of integer value, representable as int."
  [cx n]
  (let [x (const-expr cx n)
        ;; go/constant's ToInt: a complex constant with a zero imaginary part is its real part
        x (let [v (:val x)]
            (if (and (c/complex? v) (c/fzero? (c/float-val (c/im-part v)))) (assoc x :val (c/re-part v)) x))]
    (cond
      (= :invalid (:mode x)) -1
      (not= :constant (:mode x))
      (do (err! n :InvalidArrayLen "array length %s must be constant" (operand-str x)) -1)
      (and (t/untyped? (:type x)) (not (t/integer-type? (:type x))) (nil? (c/int-val (:val x))))
      (do (err! n :InvalidArrayLen "array length %s must be integer" (operand-str x)) -1)
      (and (t/typed? (:type x)) (not (t/integer-type? (:type x))))
      (do (err! n :InvalidArrayLen "array length %s must be integer" (operand-str x)) -1)
      :else
      (let [v (c/int-val (:val x))]
        (cond
          (nil? v) (do (err! n :InvalidArrayLen "array length %s must be integer" (operand-str x)) -1)
          (neg? (compare v 0)) (do (err! n :InvalidArrayLen "invalid array length %s" (operand-str x)) -1)
          (>= (c/bit-len v) 63) (do (err! n :InvalidArrayLen "invalid array length %s" (operand-str x)) -1)
          :else (long v))))))

(defn chan-type [cx f]
  (let [[_ a b] f]
    (case a
      :recv [:chan :recv (typexpr cx b)]
      :send [:chan :send (typexpr cx b)]
      [:chan :both (typexpr cx a)])))

(defn typexpr
  "The type a type form denotes (:invalid after an error)."
  [cx f]
  (with-line f
    (cond
      (or (symbol? f) (go-id? f)) (ident-type cx f)
      (seq? f)
      (let [h (first f)]
        (cond
          (= '* h) [:pointer (typexpr cx (second f))]
          (= 'slice h) [:slice (typexpr cx (second f))]
          (= 'array h) (let [[_ n el] f
                             el (typexpr cx el)]
                         (if (= '... n)
                           (do (err! f :BadDotDotDotSyntax "invalid use of [...] array (outside a composite literal)") :invalid)
                           (let [len (array-length cx n)]
                             (if (neg? len) :invalid [:array len el]))))
          (= 'map h) (let [k (typexpr cx (nth f 1)) v (typexpr cx (nth f 2))]
                       (when (and (t/valid? k) (not (t/tparam? k)))
                         ;; checked later: the key type may not be complete yet (go/types' later)
                         (vswap! e/*decl* update :later (fnil conj [])
                                 (fn []
                                   (when-not (t/comparable? k)
                                     (err! f :IncomparableMapKey "invalid map key type %s" (t/type-str k))))))
                       [:map k v])
          (= 'chan h) (chan-type cx f)
          (= 'func h) (let [[_ ps rs] f
                            [sig pss rss] (signature cx (if rs [ps :results rs] [ps]) nil)]
                        (dup-params! pss rss)
                        sig)
          (= 'struct h) (struct-type cx f)
          (= 'interface h) (interface-type cx f)
          (= 'inst h) (do (e/generic!) (instance-type cx f (second f) (nnext f)))
          (#{'| 'tilde} h) (union-type cx f)
          (symbol? h)
          ;; a generic type's instance (G T...)
          (do (e/generic!) (instance-type cx f h (rest f)))
          :else (do (err! f :NotAType "%s is not a type" (expr-str f)) :invalid)))
      :else (do (err! f :NotAType "%s is not a type" (expr-str f)) :invalid))))

(defn generic-type-obj
  "The type name object a generic type's name denotes (for an instantiation), or nil."
  [cx f]
  (let [x (if (and (symbol? f) (namespace f))
            (qualified-obj cx f)
            (resolve-name cx (ident-name f)))]
    (cond
      (nil? x) (do (err! f :UndeclaredName "undefined: %s" (expr-str f)) nil)
      (not= :type (o x :kind)) (do (err! f :NotAType "%s is not a type" (expr-str f)) nil)
      :else (do (note-ref! x) x))))

(defn typexpr-generic
  "The generic named type a name denotes (for an instantiation)."
  [cx f]
  (if-let [x (generic-type-obj cx f)] (o x :type) :invalid))

(defn instance-type
  "The instance gf[targ-forms...] of a generic type, or of a generic alias (go1.24: its type
  with the type arguments substituted)."
  [cx f gf targ-forms]
  (let [x (generic-type-obj cx gf)
        targs (mapv #(typexpr cx %) targ-forms)]
    (cond
      (nil? x) :invalid
      (some #(not (t/valid? %)) targs) :invalid
      (o x :alias)
      (let [_ (when (and (o x :pkg-level) *obj-decl*) (*obj-decl* x))
            tps (o x :tparams)]
        (cond
          (empty? tps) (do (err! f :NotAGenericType "%s is not a generic type" (o x :name)) :invalid)
          (not= (count tps) (count targs))
          (do (err! f :WrongTypeArgCount "%s type arguments for type %s: have %d, want %d"
                    (if (< (count targs) (count tps)) "not enough" "too many") (o x :name) (count targs) (count tps))
              :invalid)
          :else (do (*verify-later* f tps targs nil)
                    (*subst* (or (o x :type) :invalid) (zipmap tps targs)))))
      :else (*instantiate* f (o x :type) targs))))

(defn tparam-scope
  "A scope binding a generic declaration's type parameters to new type parameter types, their
  constraints (the forms' tags, any when untagged; bounds, when given, the receiver's: the
  generic type's constraints for a method's receiver type parameters) set once all are declared
  (go/types' collectTypeParams): [scope tparam-types]."
  ([cx tps] (tparam-scope cx tps nil nil))
  ([cx tps bounds] (tparam-scope cx tps bounds nil))
  ([cx tps bounds declared]
   (let [s (e/scope (:scope cx) :block)
         tys (vec (map-indexed
                   (fn [i p]
                     (let [nm (ident-name p)
                           tp (t/new-tparam {:name nm :index i})
                           x (e/obj {:kind :type :name nm :type tp :tparam true :line (fline p) :file (:name e/*gofile*)})]
                       (t/update-info! tp assoc :obj x)
                       (when (not= "_" nm)
                         (if (e/scope-get s nm)
                           (err! p :DuplicateDecl "%s redeclared in this block" nm)
                           (e/scope-put! s nm x)))
                       tp))
                   tps))
         bcx (assoc cx :scope s)]
     ;; the generic type itself knows its type parameters before their constraints, which may
     ;; refer to it
     (when declared (declared tys))
     (doseq [[i p tp] (map vector (range) tps tys)]
       (let [b (cond
                 bounds (nth bounds i [:interface [] nil])
                 (and (instance? arbace.lang.IMeta p) (:tag (meta p)))
                 (with-line p
                   (let [b (typexpr bcx (:tag (meta p)))]
                     (if (t/tparam? b)
                       (do (err! p :MisplacedTypeParam "cannot use a type parameter as constraint") :invalid)
                       b)))
                 :else [:interface [] nil])]
         (t/update-info! tp assoc :bound b)))
     [s tys])))

;;; Signatures (§5.3)

(defn- param-name? [x] (and (or (symbol? x) (go-id? x)) (:tag (meta x))))

(defn- params-of
  "[{:name :type :form} ...] and variadic? of a parameter vector."
  [cx v]
  (let [xs (vec v)
        amp (.indexOf ^java.util.List xs '&)
        variadic (>= amp 0)
        xs (if variadic (vec (concat (subvec xs 0 amp) (subvec xs (inc amp)))) xs)]
    [(vec (for [x xs]
            (if (param-name? x)
              {:name (ident-name x) :type (tag-type cx x) :form x}
              {:name nil :type (typexpr cx x) :form x})))
     variadic]))

(defn dup-params!
  "go/types' collectParams over a signature type's parameters and results (specs of
  signature): a name declared twice is an error."
  [ps rs]
  (reduce (fn [seen {:keys [name form]}]
            (if (and name (not= "_" name))
              (if (contains? seen name)
                (do (err! form :DuplicateDecl "%s redeclared in this block" name) seen)
                (conj seen name))
              seen))
          #{} (concat ps rs)))

(defn signature
  "The signature of the forms after a function's name or a fn head: [type-params?] ^R? [params]
  (:results [...])? ...: [[:func params results variadic?] param-specs result-specs rest-forms
  results-named?]. recv, when given, is the receiver's form (the first parameter of a method)."
  [cx forms recv]
  (let [forms (if (= :type-params (first forms)) (do (err! forms :InvalidSyntaxTree "a function type cannot have type parameters") (drop 2 forms)) forms)
        pv (first forms)
        more (rest forms)
        [results-v more] (if (= :results (first more)) [(second more) (nnext more)] [nil more])
        ;; a method's receiver is not a parameter (its type is the declaration's: func-sig!)
        [ps variadic] (params-of cx (if recv (vec (rest pv)) pv))
        rs (cond
             results-v (first (params-of cx results-v))
             (:tag (meta pv)) [{:name nil :type (typexpr cx (:tag (meta pv))) :form nil}]
             :else [])]
    (when variadic
      (let [lt (:type (peek ps))]
        (when-not (and (vector? lt) (= :slice (nth lt 0)))
          (err! pv :InvalidSyntaxTree "variadic parameter must be a slice"))))
    [[:func (mapv :type ps) (mapv :type rs) variadic] ps rs more (boolean (and results-v (some :name rs)))]))

(load "code_expr")
(load "infer")
(load "code_call")
(load "code_stmt")
(load "code_branch")

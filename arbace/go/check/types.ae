(ns arbace.go.check.types
  "goi's checker: Go types (doc/go/GOI-SPEC.md §3.3), their predicates, printing, sizes, and
  the lookup of fields and methods, after go/types (predicates.go, typestring.go, gcsizes.go,
  lookup.go, methodset.go).

  Basic types are keywords (:int, :untyped-float ...). Composite types are vectors compared by
  structure: [:pointer T], [:slice T], [:array n T], [:map K V], [:chan dir T] (dir :both,
  :send, :recv), [:func params results variadic?], [:struct fields] (each field {:name :type
  :tag :embedded :pkg}, :pkg the package path of an unexported name), [:interface methods
  terms] (methods the whole method set, embedded interfaces flattened, sorted by name and
  package: {:name :type :pkg}; terms nil but for constraints), [:tuple T...]. Named types and
  type parameters are [:named v] and [:tparam v], v a volatile holding their data, so that =
  is identity on them (a volatile is equal only to itself).

  A named type's volatile holds {:obj the type name's object, :name, :pkg path, :pkg-name,
  :underlying, :methods [method objects], :origin and :targs for an instance, :tparams}."
  (:require [arbace.string :as str]
            [arbace.go.check.const :as c]))

;;; Basic types

(def basic-info
  "{kind {:size :int? :unsigned? :float? :complex? :string? :bool? :untyped? :name}}"
  (let [m (fn [n size & flags] [n (into {:size size :name n} (map (fn [f] [f true]) flags))])]
    (into {}
          [(m :bool 1 :bool?)
           (m :int8 1 :int?) (m :int16 2 :int?) (m :int32 4 :int?) (m :int64 8 :int?) (m :int 8 :int?)
           (m :uint8 1 :int? :unsigned?) (m :uint16 2 :int? :unsigned?) (m :uint32 4 :int? :unsigned?)
           (m :uint64 8 :int? :unsigned?) (m :uint 8 :int? :unsigned?) (m :uintptr 8 :int? :unsigned?)
           (m :float32 4 :float?) (m :float64 8 :float?)
           (m :complex64 8 :complex?) (m :complex128 16 :complex?)
           (m :string 16 :string?)
           (m :unsafe-pointer 8)
           (m :untyped-bool 0 :bool? :untyped?) (m :untyped-int 0 :int? :untyped?)
           (m :untyped-rune 0 :int? :untyped?) (m :untyped-float 0 :float? :untyped?)
           (m :untyped-complex 0 :complex? :untyped?) (m :untyped-string 0 :string? :untyped?)
           (m :untyped-nil 0 :untyped?)
           ;; the resolve mode's spellings (*spelled*): byte and rune, uint8 and int32 by another name
           (m :byte 1 :int? :unsigned?) (m :rune 4 :int?)])))

(def basic-names
  {:bool "bool" :int8 "int8" :int16 "int16" :int32 "int32" :int64 "int64" :int "int"
   :uint8 "uint8" :uint16 "uint16" :uint32 "uint32" :uint64 "uint64" :uint "uint" :uintptr "uintptr"
   :float32 "float32" :float64 "float64" :complex64 "complex64" :complex128 "complex128"
   :string "string" :unsafe-pointer "unsafe.Pointer"
   :untyped-bool "untyped bool" :untyped-int "untyped int" :untyped-rune "untyped rune"
   :untyped-float "untyped float" :untyped-complex "untyped complex"
   :untyped-string "untyped string" :untyped-nil "untyped nil" :invalid "invalid type"
   :byte "byte" :rune "rune"})

;;; Spellings (GC157 (b), doc/go/GOI-SPEC.md "As built: GC157"; first the resolve mode's, GP4)
;;
;; go/types keeps the universe's byte and rune apart from uint8 and int32 (other *Basic objects of
;; the same kind, identical to them), and an alias as an Alias node every operation unaliases. The
;; checker's types do too while it checks (*spelled*, bound by check-package in every mode): byte
;; and rune are :byte and :rune, an alias of a basic type a keyword of its own (kw-alias), an
;; alias of any other type the type it denotes with its name in the metadata (::alias, which =
;; ignores). Types are identical when they are canonically equal (same?, canon); what is built
;; from them (goi's builder, the table) takes them canonical (canon: uint8, int32, no alias).

(def ^:dynamic *spelled*
  "Whether the checker makes types with go/types' spellings of byte, rune and aliases."
  false)

(def ^:private kw-aliases
  "The resolve mode's aliases of basic types (type A = int): their keywords
  (:arbace.go.check.types/aN) -> {:actual :name :pkg :obj}."
  (java.util.concurrent.ConcurrentHashMap.))

(defn kw-alias
  "The keyword spelling alias object x (named name, of package pkg named pkg-name; local: declared
  in a function) of basic type actual (made once per object)."
  [x name pkg pkg-name local actual]
  (let [k (keyword "arbace.go.check.types" (str "a" (System/identityHashCode x) "-" name))]
    (.putIfAbsent ^java.util.concurrent.ConcurrentHashMap kw-aliases k
                  {:actual actual :name name :pkg pkg :pkg-name pkg-name :local local :obj x})
    k))

(defn kw-alias-info [k] (when (namespace k) (.get ^java.util.concurrent.ConcurrentHashMap kw-aliases k)))

(defn canon-kw
  "The canonical basic type of a keyword: uint8 for byte, int32 for rune, an alias's actual."
  [t]
  (case t
    :byte :uint8
    :rune :int32
    (if (namespace t) (if-let [a (kw-alias-info t)] (canon-kw (:actual a)) t) t)))

(declare canon)

(defn- map-same
  "(mapv f v), or v itself when f changes no element (no allocation)."
  [f v]
  (let [n (count v)]
    (loop [i 0]
      (if (< i n)
        (let [x (nth v i) c (f x)]
          (if (identical? x c)
            (recur (inc i))
            (into (conj (subvec v 0 i) c) (map f) (subvec v (inc i)))))
        v))))

(defn- canon-member [m] (let [ty (:type m) c (canon ty)] (if (identical? ty c) m (assoc m :type c))))

(defn- canon-vec [t]
  (let [re (fn [c] (with-meta c (meta t)))]
    (case (nth t 0)
      (:named :tparam) t
      (:pointer :slice) (let [e (nth t 1) c (canon e)] (if (identical? e c) t (re [(nth t 0) c])))
      :array (let [e (nth t 2) c (canon e)] (if (identical? e c) t (re [:array (nth t 1) c])))
      :chan (let [e (nth t 2) c (canon e)] (if (identical? e c) t (re [:chan (nth t 1) c])))
      :map (let [k (nth t 1) v (nth t 2) ck (canon k) cv (canon v)]
             (if (and (identical? k ck) (identical? v cv)) t (re [:map ck cv])))
      :func (let [[_ ps rs v] t cps (map-same canon ps) crs (map-same canon rs)]
              (if (and (identical? ps cps) (identical? rs crs)) t (re [:func cps crs v])))
      :struct (let [fs (nth t 1) c (map-same canon-member fs)] (if (identical? fs c) t (re [:struct c])))
      :interface (let [ms (nth t 1) c (map-same canon-member ms)]
                   (if (identical? ms c) t (re [:interface c (nth t 2)])))
      :tuple (let [xs (subvec t 1) c (map-same canon xs)] (if (identical? xs c) t (re (into [:tuple] c))))
      t)))

(defn alias-of
  "The alias a type is spelled by ({:name :pkg :obj}), or nil."
  [t]
  (cond
    (keyword? t) (when (namespace t) (kw-alias-info t))
    (vector? t) (::alias (meta t))
    :else nil))

(defn unalias
  "t without its alias's name (go/types' Unalias): the type it denotes."
  [t]
  (if (and (vector? t) (::alias (meta t)))
    (vary-meta t dissoc ::alias)
    t))

(defn canon
  "t with its spellings made canonical, deeply: uint8 for byte, int32 for rune, an alias the
  type it denotes (named types and type parameters are their own: identity); t itself when it
  has none."
  [t]
  (cond
    (keyword? t) (canon-kw t)
    (vector? t) (canon-vec (unalias t))
    :else t))

(defn same?
  "Whether types x and y are identical: equal, or canonically equal."
  [x y]
  (or (= x y)
      (let [cx (canon x) cy (canon y)]
        (and (not (and (identical? cx x) (identical? cy y))) (= cx cy)))))

;;; Named types and type parameters

(def ^:private ids (java.util.concurrent.atomic.AtomicLong. 0))
(defn next-id ^long [] (.incrementAndGet ids))

(defn named? [t] (and (vector? t) (identical? :named (nth t 0))))
(defn tparam? [t] (and (vector? t) (identical? :tparam (nth t 0))))
(defn info [t] @(nth t 1))
(defn update-info! [t f & args] (vreset! (nth t 1) (apply f @(nth t 1) args)) t)

(defn new-named
  "A new named type: data {:obj :name :pkg :pkg-name ...}; its underlying is set later."
  [data]
  [:named (volatile! (assoc data :id (next-id) :methods []))])

(defn new-tparam
  "A new type parameter: data {:name :index :bound (its constraint, set when declared) :obj}."
  [data]
  [:tparam (volatile! (assoc data :id (next-id)))])

(def ^:dynamic *resolve-named*
  "A function called with a named type whose underlying type is not known yet (its declaration
  not checked), which checks its declaration; bound by the checker."
  nil)

(declare under tparam-iface)

(defn- named-under [t]
  (loop [t t seen #{}]
    (let [i (info t)]
      (if-let [u (:underlying i)]
        (if (named? u)
          ;; type A B: A's underlying is B's, resolved on demand (a cycle is invalid)
          (if (contains? seen u)
            :invalid
            (recur u (conj seen t)))
          u)
        (if (and *resolve-named* (not (:resolving i)) (:obj i))
          (do (*resolve-named* t)
              (if (:underlying (info t)) (recur t seen) :invalid))
          :invalid)))))

(defn under
  "The underlying type of t (a basic type's canonical: uint8 for byte)."
  [t]
  (cond
    (keyword? t) (canon-kw t)
    (identical? :named (nth t 0)) (let [u (named-under t)] (if (keyword? u) (canon-kw u) u))
    (identical? :tparam (nth t 0)) (tparam-iface t)
    :else (unalias t)))

;;; Predicates

(defn basic [t] (let [u (under t)] (when (keyword? u) u)))
(defn- flag [t f] (let [b (basic t)] (boolean (and b (get (basic-info b) f)))))
(defn integer-type? [t] (flag t :int?))
(defn unsigned? [t] (flag t :unsigned?))
(defn float-type? [t] (flag t :float?))
(defn complex-type? [t] (flag t :complex?))
(defn numeric? [t] (or (integer-type? t) (float-type? t) (complex-type? t)))
(defn string-type? [t] (flag t :string?))
(defn boolean-type? [t] (flag t :bool?))
(defn untyped? [t] (and (keyword? t) (boolean (get (basic-info t) :untyped?))))
(defn typed? [t] (not (untyped? t)))
(defn const-type?
  "Whether values of t can be constants: booleans, numbers and strings."
  [t]
  (let [b (basic t)] (and b (not (#{:unsafe-pointer :untyped-nil :invalid} b)))))
(defn ordered? [t] (or (integer-type? t) (float-type? t) (string-type? t)))
(defn interface? [t] (let [u (under t)] (and (vector? u) (= :interface (nth u 0)))))
(defn pointer? [t] (let [u (under t)] (and (vector? u) (= :pointer (nth u 0)))))
(defn unsafe-pointer? [t] (= :unsafe-pointer (basic t)))
(defn uintptr? [t] (= :uintptr (basic t)))
(defn valid? [t] (not= :invalid t))
(defn kind-of [t] (let [u (under t)] (if (keyword? u) u (nth u 0))))
(defn has-name? [t] (or (keyword? t) (named? t) (tparam? t)))
(defn integer-or-float? [t] (or (integer-type? t) (float-type? t)))

(declare under-is)

(defn has-nil?
  "Whether t's values include nil: pointers, slices, maps, channels, funcs, interfaces,
  unsafe.Pointer; a type parameter's when every type of its type set has."
  [t]
  (if (tparam? t)
    (under-is t (fn [u] (and (some? u) (has-nil? u))))
    (let [u (under t)]
      (or (= :unsafe-pointer u) (= :untyped-nil u)
          (and (vector? u) (contains? #{:pointer :slice :map :chan :func :interface} (nth u 0)))))))

(defn empty-interface? [t]
  (let [u (under t)] (and (vector? u) (= :interface (nth u 0)) (empty? (nth u 1)) (nil? (nth u 2)))))

(defn default-type
  "The default type of an untyped type (Go's Default: untyped rune's is rune, spelled)."
  [t]
  (case t
    :untyped-bool :bool :untyped-int :int :untyped-rune (if *spelled* :rune :int32) :untyped-float :float64
    :untyped-complex :complex128 :untyped-string :string
    t))

(defn ignore-tags
  "t with the tags of its struct types dropped, deeply (for IdenticalIgnoreTags)."
  [t]
  (if (and (vector? t) (not (named? t)) (not (tparam? t)))
    (case (nth t 0)
      :struct [:struct (mapv #(assoc % :tag nil :type (ignore-tags (:type %))) (nth t 1))]
      :pointer [:pointer (ignore-tags (nth t 1))]
      :slice [:slice (ignore-tags (nth t 1))]
      :array [:array (nth t 1) (ignore-tags (nth t 2))]
      :map [:map (ignore-tags (nth t 1)) (ignore-tags (nth t 2))]
      :chan [:chan (nth t 1) (ignore-tags (nth t 2))]
      :func [:func (mapv ignore-tags (nth t 1)) (mapv ignore-tags (nth t 2)) (nth t 3)]
      :tuple (into [:tuple] (map ignore-tags (rest t)))
      t)
    t))

(defn identical-ignore-tags? [x y] (= (canon (ignore-tags x)) (canon (ignore-tags y))))

(declare comparable? type-str)

(declare tparam-tset strictly-comparable? iface-tset)

(defn- tset-comparable?
  "go/types' _TypeSet.IsComparable: every type of a type set comparable (strictly)."
  [ts seen]
  (if (= :all (:terms ts))
    (:comparable ts)
    (and (seq (:terms ts)) (every? (fn [[_ ty]] (strictly-comparable? ty seen)) (:terms ts)))))

(defn comparable-type?
  "go/types' comparableType: whether values of t can be compared with ==; dynamic: the
  specification's comparability (ordinary interfaces are comparable), else strict (an
  interface only when its type set is)."
  [t dynamic seen]
  (if (contains? seen t)
    true
    (let [seen (conj seen t)]
      (if (tparam? t)
        (boolean (tset-comparable? (tparam-tset t) seen))
        (let [u (under t)]
          (cond
            (keyword? u) (not= u :untyped-nil)
            :else
            (case (nth u 0)
              (:pointer :chan) true
              :interface (or dynamic (boolean (tset-comparable? (iface-tset u) seen)))
              :struct (every? #(comparable-type? (:type %) dynamic seen) (nth u 1))
              :array (comparable-type? (nth u 2) dynamic seen)
              false)))))))

(defn strictly-comparable? ([t] (comparable-type? t false #{})) ([t seen] (comparable-type? t false seen)))

(defn incomparable-cause
  "Why values of t cannot be compared (go/types' comparableType's cause, dynamic): \"\" when
  it has none to give."
  [t]
  (letfn [(cause [t seen]
            (if (contains? seen t)
              nil
              (let [seen (conj seen t)]
                (if (tparam? t)
                  (when-not (tset-comparable? (tparam-tset t) seen) "")
                  (let [u (under t)]
                    (cond
                      (keyword? u) (when (= u :untyped-nil) "")
                      :else
                      (case (nth u 0)
                        (:pointer :chan :interface) nil
                        :struct (some (fn [fd] (when (cause (:type fd) seen)
                                                 (str "struct containing " (type-str (:type fd)) " cannot be compared")))
                                      (nth u 1))
                        :array (when (cause (nth u 2) seen) (str (type-str t) " cannot be compared"))
                        "")))))))]
    (or (cause t #{}) "")))

(defn comparable?
  "Go's Comparable: whether values of t can be compared with == (interfaces are; a type
  parameter when its type set is)."
  ([t] (comparable-type? t true #{}))
  ([t seen] (comparable-type? t true seen)))

;;; Type parameters and type sets (GR6: go/types' typeparam.go, typeset.go, termlist.go,
;;; typeterm.go, under.go, predicates.go)
;;
;; An interface type's third element is its type set beyond its methods: nil (every type: the
;; interface is its method set), or {:terms terms :comparable bool}, terms :all or a set of
;; terms [tilde? T] (normalized: no two of them overlap; #{} is the empty set), comparable only
;; with :all (go/types' invariant). A union (A | ~B, an element of a constraint) is
;; [:union terms], a type only constraints hold. A type parameter's info holds its :bound (the
;; constraint's type, set when it is declared) and, once known, its :iface (go/types' iface:
;; the bound's underlying interface, or the implicit interface of a non-interface bound).

(defn union? [t] (and (vector? t) (identical? :union (nth t 0))))

(defn- term-disjoint? [[xt x] [yt y]]
  (not (same? (if yt (under x) x) (if xt (under y) y))))

(defn- term-union [x y]
  (cond
    (term-disjoint? x y) [x y]
    (or (first x) (not (first y))) [x]
    :else [y]))

(defn- term-intersect [x y]
  (cond
    (term-disjoint? x y) nil
    (or (not (first x)) (first y)) x
    :else y))

(defn- term-includes? [[tilde ty] t] (same? ty (if tilde (under t) t)))

(defn- term-subset? [x y] (and (not (term-disjoint? x y)) (or (not (first x)) (first y))))

(defn terms-norm
  "go/types' termlist.norm: the terms with the overlapping ones merged, as a set."
  [ts]
  (let [ts (vec ts) n (count ts) used (boolean-array n)]
    (loop [i 0 rl []]
      (if (= i n)
        ;; a set (type sets compare as sets), its order kept for messages
        (with-meta (set rl) {:order rl})
        (if (aget used i)
          (recur (inc i) rl)
          (let [xi (loop [j (inc i) xi (nth ts i)]
                     (cond
                       (= j n) xi
                       (aget used j) (recur (inc j) xi)
                       :else (let [u (term-union xi (nth ts j))]
                               (if (= 1 (count u))
                                 (do (aset used j true) (recur (inc j) (first u)))
                                 (recur (inc j) xi)))))]
            (recur (inc i) (conj rl xi))))))))

(defn- ordered
  "A term set's terms in their written order (terms-norm's :order), GC144 (b)."
  [ts]
  (or (:order (meta ts)) (seq ts)))

(defn terms-union [x y] (if (or (= :all x) (= :all y)) :all (terms-norm (concat (ordered x) (ordered y)))))

(defn terms-intersect [x y]
  (cond
    (= :all x) y
    (= :all y) x
    (or (empty? x) (empty? y)) #{}
    :else (terms-norm (for [a (ordered x) b (ordered y) :let [r (term-intersect a b)] :when r] r))))

(defn terms-includes? [xl t] (or (= :all xl) (boolean (some #(term-includes? % t) xl))))

(defn- terms-superset-of? [xl y] (or (= :all xl) (boolean (some #(term-subset? y %) xl))))

(defn terms-subset?
  "Whether term set xl is a subset of yl."
  [xl yl]
  (cond
    (= :all yl) true
    (= :all xl) false
    (empty? yl) (empty? xl)
    :else (every? #(terms-superset-of? yl %) xl)))

(defn make-tset
  "An interface's type set element: nil for every type."
  [terms comparable]
  (if (and (= :all terms) (not comparable)) nil {:terms terms :comparable (boolean (and comparable (= :all terms)))}))

(defn iface-tset
  "The type set of interface type u (an underlying [:interface ms ts]): {:methods :terms
  :comparable}."
  [u]
  (let [ts (nth u 2)]
    {:methods (nth u 1)
     :terms (if (map? ts) (:terms ts) :all)
     :comparable (boolean (and (map? ts) (:comparable ts)))}))

(defn has-terms?
  "Whether a type set has specific terms (neither every type nor none)."
  [ts]
  (let [terms (:terms ts)] (and (not= :all terms) (seq terms))))

(defn tset-empty? [ts] (and (not= :all (:terms ts)) (empty? (:terms ts))))

(defn method-set-iface?
  "go/types' IsMethodSet: whether interface type u is described by its methods alone (it may be
  used as a value's type)."
  [u]
  (nil? (nth u 2)))

(defn bound-iface
  "The interface a constraint b denotes: its underlying interface, or the implicit interface of
  a union or a non-interface type (go/types' implicit interfaces); nil when invalid."
  [b]
  (when (and b (not= :invalid b))
    (let [u (under b)]
      (cond
        (= :invalid u) nil
        (and (vector? u) (= :interface (nth u 0))) u
        (union? u) [:interface [] (make-tset (nth u 1) false)]
        :else [:interface [] (make-tset #{[false b]} false)]))))

(defn tparam-iface
  "go/types' TypeParam.iface: the interface of type parameter tp's constraint."
  [tp]
  (let [i (info tp)]
    (or (:iface i)
        (if-let [r (bound-iface (:bound i))]
          (do (update-info! tp assoc :iface r) r)
          [:interface [] nil]))))

(defn tparam-tset [tp] (iface-tset (tparam-iface tp)))

(defn typeset-pairs
  "The (type, underlying type) pairs of t's type set (go/types' typeset): a type parameter's
  specific terms ([[nil nil]] when it has none), else [[t (under t)]]."
  [t]
  (if (tparam? t)
    (let [ts (tparam-tset t)]
      (if (has-terms? ts)
        (for [[tilde ty] (:terms ts)] [ty (if tilde ty (under ty))])
        [[nil nil]]))
    [[t (under t)]]))

(defn typeset-all
  "go/types' all: whether (f t u) holds for every type of t's type set."
  [t f]
  (every? (fn [[ty u]] (f ty u)) (typeset-pairs t)))

(defn under-is
  "go/types' underIs: whether (f u) holds for the underlying type u of every type of t's type
  set (u nil: a type parameter without specific types)."
  [t f]
  (typeset-all t (fn [_ u] (f u))))

(defn all-basic
  "go/types' allBasic: whether every type of t's type set satisfies pred (a type parameter
  without specific types: no)."
  [t pred]
  (if (tparam? t)
    (let [ts (tparam-tset t)]
      (boolean (and (has-terms? ts) (every? (fn [[_ ty]] (pred ty)) (:terms ts)))))
    (pred t)))

(defn all-integer? [t] (all-basic t integer-type?))
(defn all-unsigned? [t] (all-basic t unsigned?))
(defn all-numeric? [t] (all-basic t numeric?))
(defn all-string? [t] (all-basic t string-type?))
(defn all-boolean? [t] (all-basic t boolean-type?))
(defn all-ordered? [t] (all-basic t ordered?))
(defn all-numeric-or-string? [t] (all-basic t #(or (numeric? %) (string-type? %))))
(defn all-float? [t] (all-basic t float-type?))
(defn all-complex? [t] (all-basic t complex-type?))

(defn common-under
  "go/types' commonUnder: [u nil], u the underlying type every type of t's type set shares
  (channels: the most restricted direction), or [nil cause]; cnd, when given, a function of
  (t, u) returning a cause to fail with."
  ([t] (common-under t nil))
  ([t cnd]
   (loop [ps (typeset-pairs t) ct nil cu nil]
     (if (empty? ps)
       [cu nil]
       (let [[ty u] (first ps)
             e (when cnd (cnd ty u))]
         (cond
           e [nil e]
           (nil? u) [nil "no specific type"]
           (nil? cu) (recur (rest ps) ty u)
           (and (vector? cu) (= :chan (nth cu 0)) (vector? u) (= :chan (nth u 0)))
           (cond
             (not (same? (nth cu 2) (nth u 2))) [nil (str "channels " (pr-str ct) " and " (pr-str ty) " have different element types")]
             (= (nth cu 1) (nth u 1)) (recur (rest ps) ct cu)
             (= :both (nth cu 1)) (recur (rest ps) ty u)
             (not= :both (nth u 1)) [nil "conflicting channel directions"]
             :else (recur (rest ps) ct cu))
           (not (same? cu u)) [nil "different underlying types"]
           :else (recur (rest ps) ct cu)))))))

(defn core-type
  "The common underlying type of t's type set, or nil."
  [t]
  (first (common-under t)))

;;; Printing (go/types' TypeString)

(def ^:dynamic *qualify*
  "The current package's path: its named types print unqualified, the others by their
  package's name."
  nil)

(declare type-str)

(defn terms-str [terms]
  (if (empty? terms)
    "∅"
    (let [ts (or (:order (meta terms)) (sort-by pr-str terms))]
      (str/join " | " (for [[tilde ty] ts] (str (when tilde "~") (type-str ty)))))))

(defn- params-str [ps variadic]
  (str "("
       (str/join ", " (map-indexed (fn [i p]
                                     (if (and variadic (= i (dec (count ps))))
                                       (str "..." (type-str (nth p 1)))
                                       (type-str p)))
                                   ps))
       ")"))

(defn sig-str
  "A signature's text without the func keyword: (params) results."
  [[_ ps rs variadic]]
  (str (params-str ps variadic)
       (case (count rs)
         0 ""
         1 (let [r (first rs)] (str " " (type-str r)))
         (str " (" (str/join ", " (map type-str rs)) ")"))))

(defn- field-str [f]
  (str (if (:embedded f) "" (str (:name f) " ")) (type-str (:type f))
       (when (:tag f) (str " " (pr-str (c/value-text (:tag f)))))))

(defn named-str [t]
  (let [i (info t)
        base (if (and (:pkg i) (not= (:pkg i) *qualify*) (not (:local i)))
               (str (:pkg-name i) "." (:name i))
               (:name i))]
    (if (seq (:targs i))
      (str base "[" (str/join "," (map type-str (:targs i))) "]")
      base)))

(defn- alias-str
  "An alias's name, qualified as a named type's (types2's Alias)."
  [a]
  (if (and (:pkg a) (not= (:pkg a) *qualify*) (not (:local a)))
    (str (:pkg-name a) "." (:name a))
    (:name a)))

(defn type-str
  "Go's text of a type (an alias by its name, byte and rune as such)."
  [t]
  (cond
    (keyword? t) (or (get basic-names t) (some-> (kw-alias-info t) alias-str) (name t))
    (::alias (meta t)) (alias-str (::alias (meta t)))
    (named? t) (named-str t)
    (tparam? t) (:name (info t))
    :else
    (case (nth t 0)
      :pointer (str "*" (type-str (nth t 1)))
      :slice (str "[]" (type-str (nth t 1)))
      :array (str "[" (nth t 1) "]" (type-str (nth t 2)))
      :map (str "map[" (type-str (nth t 1)) "]" (type-str (nth t 2)))
      :chan (let [e (nth t 2)
                  es (type-str e)
                  es (if (and (= :both (nth t 1)) (vector? e) (= :chan (nth e 0)) (= :recv (nth e 1)))
                       (str "(" es ")") es)]
              (case (nth t 1) :both (str "chan " es) :send (str "chan<- " es) :recv (str "<-chan " es)))
      :func (str "func" (sig-str t))
      :struct (str "struct{" (str/join "; " (map field-str (nth t 1))) "}")
      :interface (let [ms (nth t 1) ts (nth t 2)]
                   (if (and (empty? ms) (nil? ts))
                     "interface {}"
                     (str "interface {"
                          (str/join "; " (concat (when (:comparable ts) ["comparable"])
                                                 (for [m ms] (str (:name m) (sig-str (:type m))))
                                                 (when (and (map? ts) (not= :all (:terms ts)))
                                                   [(terms-str (:terms ts))])))
                          "}")))
      :union (terms-str (nth t 1))
      :tuple (str "(" (str/join ", " (map type-str (rest t))) ")")
      (pr-str t))))

;;; Sizes (gc's, word 8, max alignment 8: amd64 and arm64)

(def word-size 8)
(def max-align 8)

(declare sizeof)

(defn- align-up
  "The smallest y >= x with y % a = 0 (a a power of 2): gcSizes' align, overflowing to < 0."
  ^long [^long x ^long a]
  (bit-and-not (unchecked-add x (dec a)) (dec a)))

(defn sync-atomic-align64?
  "Whether t is sync/atomic's align64 (or internal/runtime/atomic's), the empty struct gc
  aligns to 8."
  [t]
  (and (named? t)
       (let [i (info t)]
         (and (= "align64" (:name i))
              (contains? #{"sync/atomic" "internal/runtime/atomic"} (:pkg i))))))

(defn alignof ^long [t]
  (let [u (under t)]
    (cond
      (and (vector? u) (= :array (nth u 0))) (alignof (nth u 2))
      (and (vector? u) (= :struct (nth u 0)))
      (if (and (empty? (nth u 1)) (sync-atomic-align64? t))
        8
        (reduce (fn [m f] (max m (alignof (:type f)))) 1 (nth u 1)))
      (and (vector? u) (contains? #{:slice :interface} (nth u 0))) word-size
      (= :string u) word-size
      :else
      (let [a (sizeof t)
            a (if (< a 1) 1 a)
            a (if (complex-type? t) (quot a 2) a)]
        (min a max-align)))))

(defn offsetsof
  "gcSizes' Offsetsof: the fields' offsets, -1 from a field on whose offset or size is too
  large (int64 overflow, GR7c)."
  [fields]
  (loop [fs fields offs 0 acc []]
    (if (empty? fs)
      acc
      (let [f (first fs)]
        (if (neg? offs)
          (recur (rest fs) offs (conj acc -1))
          (let [o (align-up offs (alignof (:type f)))
                d (sizeof (:type f))]
            (recur (rest fs)
                   (if (and (>= d 0) (>= o 0)) (unchecked-add o d) -1)
                   (conj acc o))))))))

(defn sizeof
  "gcSizes' Sizeof: the size of t, -1 when it is too large (int64 overflow, GR7c)."
  ^long [t]
  (let [u (under t)]
    (cond
      (keyword? u) (case u :string (* 2 word-size) (:size (basic-info u) word-size))
      :else
      (case (nth u 0)
        :array (let [n (long (nth u 1))]
                 (if (<= n 0)
                   0
                   (let [es (sizeof (nth u 2))]
                     (cond
                       (neg? es) -1
                       (zero? es) 0
                       (> es (quot Long/MAX_VALUE n)) -1
                       :else (* es n)))))
        :slice (* 3 word-size)
        :struct (let [fs (nth u 1)]
                  (if (empty? fs)
                    0
                    (let [offs (offsetsof fs)
                          o (long (peek offs))
                          s (sizeof (:type (peek fs)))]
                      (if (or (neg? o) (neg? s))
                        -1
                        (let [s (if (and (pos? o) (zero? s)) 1 s)]
                          ;; may overflow to < 0, which is too large
                          (align-up (unchecked-add o s) (alignof t)))))))
        :interface (* 2 word-size)
        word-size))))

;;; Pointers and methods

(defn deref-type
  "[base true] for an unnamed pointer type [:pointer base], else [t false]."
  [t]
  (if (and (vector? t) (= :pointer (nth t 0))) [(nth t 1) true] [t false]))

(defn methods-of
  "The methods declared on named type t (objects): its declaration completed first."
  [t]
  (let [t (if (:origin (info t)) (:origin (info t)) t)]
    (under t)
    (:methods (info t))))

(def ^:dynamic *fold-case*
  "go/types' foldCase: names compared without case (and packages ignored), for messages."
  false)

(defn same-id?
  "Whether a field or method named n (in package p when unexported) is the one named name
  as seen from package pkg."
  [n p name pkg]
  (if (and *fold-case* (.equalsIgnoreCase ^String n ^String name))
    true
  (and (= n name)
       (or (Character/isUpperCase (.charAt ^String name 0))
           (= p pkg)
           ;; a non-letter start (_): the package matters as for unexported names
           false))))

(defn exported? [^String n]
  (let [cp (.codePointAt n 0)] (Character/isUpperCase cp)))

(def ^:dynamic *method-obj*
  "A function from a method object to its data {:name :pkg :type :ptr-recv}, which resolves its
  declaration; bound by the checker."
  nil)

(def ^:dynamic *subst-method*
  "A function [instance method-obj] -> method data of the instance (type arguments
  substituted); bound by the checker for generic types."
  nil)

(defn named-method
  "[index method-data] of named type t's method name (seen from pkg), or nil."
  [t name pkg]
  (let [ms (methods-of t)]
    (loop [i 0]
      (when (< i (count ms))
        (let [m (nth ms i)
              {mn :name mp :pkg} @m]
          (if (same-id? mn mp name pkg)
            [i m]
            (recur (inc i))))))))

(defn iface-method
  "[index method] of interface type u's method name (seen from pkg), or nil."
  [u name pkg]
  (let [ms (nth u 1)]
    (loop [i 0]
      (when (< i (count ms))
        (let [m (nth ms i)]
          (if (same-id? (:name m) (:pkg m) name pkg)
            [i m]
            (recur (inc i))))))))

(defn- consolidate
  "go/types' consolidateMultiples: entries of one type merged, marked multiple."
  [entries]
  (loop [es entries acc [] idx {}]
    (if (empty? es)
      acc
      (let [e (first es)
            k (canon (:type e))]
        (if-let [j (get idx k)]
          (recur (rest es) (assoc-in acc [j :multiples] true) idx)
          (recur (rest es) (conj acc e) (assoc idx k (count acc))))))))

(defn lookup-impl
  "go/types' lookupFieldOrMethodImpl: {:kind :field|:method|:iface-method, :obj (a field map,
  a method object or an interface method map), :index [i ...] (the path: field indexes, the
  last the field's or method's), :via [embedded field names], :indirect}, or {:ambiguous
  true}, {:ptr-recv true} (a pointer method on a non-addressable value), or nil."
  [T addressable name pkg]
  (let [[typ is-ptr] (deref-type T)]
    (if (and is-ptr (interface? typ))
      nil
      (loop [current [{:type typ :index [] :via [] :indirect is-ptr :multiples false}]
             seen #{}]
        (if (empty? current)
          nil
          (let [[found next seen]
                (reduce
                 (fn [[found next seen] e]
                   (let [typ (:type e)]
                     (if (and (named? typ) (contains? seen typ))
                       [found next seen]
                       (let [seen (if (named? typ) (conj seen typ) seen)
                             m (when (named? typ) (named-method typ name pkg))]
                         (if m
                           (if (or found (:multiples e))
                             [{:ambiguous true} next seen]
                             [{:kind :method :obj (second m) :recv-type typ :index (conj (:index e) (first m))
                               :via (:via e) :indirect (:indirect e)} next seen])
                           (let [u (under typ)]
                             (cond
                               (and (vector? u) (= :struct (nth u 0)))
                               (let [fs (nth u 1)]
                                 (loop [i 0 found found next next]
                                   (if (>= i (count fs))
                                     [found next seen]
                                     (let [f (nth fs i)]
                                       (cond
                                         (same-id? (:name f) (:pkg f) name pkg)
                                         (if (or found (:multiples e))
                                           (recur (inc i) {:ambiguous true} next)
                                           (recur (inc i) {:kind :field :obj f :index (conj (:index e) i)
                                                           :via (:via e) :indirect (:indirect e)}
                                                  next))
                                         (and (nil? found) (:embedded f))
                                         (let [[ft fp] (deref-type (:type f))]
                                           (recur (inc i) found
                                                  (conj next {:type ft :index (conj (:index e) i)
                                                              :via (conj (:via e) (:name f))
                                                              :indirect (or (:indirect e) fp)
                                                              :multiples (:multiples e)})))
                                         :else (recur (inc i) found next))))))
                               (and (vector? u) (= :interface (nth u 0)))
                               (if-let [m (iface-method u name pkg)]
                                 (if (or found (:multiples e))
                                   [{:ambiguous true} next seen]
                                   [{:kind :iface-method :obj (second m) :iface typ :index (conj (:index e) (first m))
                                     :via (:via e) :indirect (:indirect e)} next seen])
                                 [found next seen])
                               :else [found next seen])))))))
                 [nil [] seen]
                 current)]
            (cond
              (:ambiguous found) found
              found
              (if (and (= :method (:kind found)) (:ptr-recv (*method-obj* (:obj found)))
                       (not (:indirect found)) (not addressable))
                {:ptr-recv true :found found}
                found)
              :else (recur (consolidate next) seen))))))))

(defn lookup
  "go/types' LookupFieldOrMethod: lookup-impl, but a defined pointer type has fields only."
  [T addressable name pkg]
  (if (and (named? T) (pointer? T))
    (let [r (lookup-impl (under T) false name pkg)]
      (when-not (= :method (:kind r)) r))
    (lookup-impl T addressable name pkg)))

;;; Interfaces

(defn sort-methods
  "Interface methods in go/types' order: by name, unexported after package (Id order)."
  [ms]
  (vec (sort-by (fn [m] [(:name m) (or (:pkg m) "")]) ms)))

(defn method-data
  "The data of a method object or an interface method: {:name :pkg :type :ptr-recv}."
  [m]
  (if (map? m) m (*method-obj* m)))

(defn missing-method
  "go/types' missingMethod: nil when V implements interface type T (u its underlying), else
  {:method m :cause kw}: :missing, :ptr-recv (found with a pointer receiver), :wrong-type
  (with :have), :field (a field of that name), :unexported (other package's)."
  ([V T static] (missing-method V T static same?))
  ([V T static same?]
   (let [tu (under T)
         vu (under V)]
     ;; go/types' hasAllMethods: an interface whose method set is not known (it embeds a type
     ;; in progress: a cycle, reported) implements and is implemented (GR7c)
     (when-not (or (:incomplete (meta tu)) (:incomplete (meta vu)))
     (some
      (fn [m]
        (if (and (vector? vu) (= :interface (nth vu 0)))
          (let [f (iface-method vu (:name m) (:pkg m))]
            (cond
              (nil? f) (when static {:method m :cause :missing})
              (not (same? (:type (second f)) (:type m))) {:method m :cause :wrong-type :have (second f)}))
          (let [r (lookup-impl V false (:name m) (:pkg m))]
            (cond
              (:ptr-recv r) {:method m :cause :ptr-recv}
              ;; go/types: a method found with another case is the cause (wrongName, or
              ;; unexported when its name is the same: another package's)
              (nil? r) (let [fr (binding [*fold-case* true] (lookup-impl V false (:name m) (:pkg m)))]
                         (if (and (= :method (:kind fr)) (not (:ambiguous fr)))
                           (let [d (method-data (:obj fr))]
                             {:method m :cause (if (= (:name d) (:name m)) :unexported :wrong-name) :have d})
                           {:method m :cause :missing}))
              (:ambiguous r) {:method m :cause :missing}
              (= :field (:kind r)) {:method m :cause :field}
              :else
              (let [d (method-data (:obj r))
                    d (if (and *subst-method* (= :method (:kind r))) (*subst-method* (:recv-type r) d) d)]
                ;; a generic method never satisfies an interface method (go1.27)
                (when (or (seq (:tparams d)) (not (same? (:type d) (:type m))))
                  {:method m :cause :wrong-type :have d}))))))
      (nth tu 1))))))

;;; Constraint satisfaction (go/types' implements, constraint = true)

(defn satisfies-cause
  "nil when type V satisfies constraint b (go/types' implements with constraint set), else the
  cause, as go/types words it."
  [V b]
  (let [Ti (bound-iface b)
        Vu (under V)]
    (if (or (nil? Ti) (= :invalid Vu)
            (and (vector? Vu) (= :pointer (nth Vu 0)) (= :invalid (under (nth Vu 1)))))
      nil
      (let [Tts (iface-tset Ti)
            Vi (when (and (vector? Vu) (= :interface (nth Vu 0))) Vu)
            Vts (when Vi (iface-tset Vi))
            T-str (type-str b)]
        (cond
          (and (empty? (nth Ti 1)) (nil? (nth Ti 2))) nil
          (and Vts (tset-empty? Vts)) nil
          (tset-empty? Tts) (str "cannot satisfy " T-str " (empty type set)")
          :else
          (if-let [mm (missing-method V Ti true)]
            (str (type-str V) " does not satisfy " T-str " (missing method " (:name (:method mm)) ")")
            (let [comparability
                  (fn []
                    (cond
                      (not (if (= :all (:terms Tts))
                             (:comparable Tts)
                             (every? (fn [[_ ty]] (strictly-comparable? ty)) (:terms Tts))))
                      nil
                      (strictly-comparable? V) nil
                      (comparable? V) nil
                      :else (str (type-str V) " does not satisfy comparable")))]
              (cond
                (not (has-terms? Tts)) (comparability)
                Vts (if (terms-subset? (:terms Vts) (:terms Tts))
                      (comparability)
                      (str (type-str V) " does not satisfy " T-str))
                (terms-includes? (:terms Tts) V) (comparability)
                :else (str (type-str V) " does not satisfy " T-str " (" (type-str V) " missing in "
                           (terms-str (:terms Tts)) ")")))))))))

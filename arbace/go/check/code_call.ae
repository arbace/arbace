(in-ns 'arbace.go.check.code)

;;; Identifiers (typexpr.go ident)

(defn- obj-node
  "The node of an identifier resolved to object x."
  [cx f x]
  (case (o x :kind)
    :var (do (use-var! cx x)
             (note-ref! x)
             (when (o x :generic-invalid) (e/generic!))
             (let [ty (or (o x :type) :invalid)]
               {:op (if (o x :local?) :local :global) :obj x :mode (if (t/valid? ty) :variable :invalid)
                :type ty :form f :line (fline f)}))
    :const (do (note-ref! x)
               (when (o x :generic-invalid) (e/generic!))
               (if (o x :iota)
                 (if-let [i (:iota cx)]
                   (const-node f :untyped-int i)
                   (do (err! f :InvalidIota "cannot use iota outside constant declaration") (invalid f)))
                 (let [ty (or (o x :type) :invalid)]
                   (if (t/valid? ty)
                     (assoc (const-node f ty (o x :val)) :obj x)
                     (invalid f)))))
    :type (do (note-ref! x)
              (when (o x :generic-invalid) (e/generic!))
              (let [ty (type-of-obj f x)]
                (if (t/valid? ty) {:op :type :mode :typexpr :type ty :obj x :form f :line (fline f)} (invalid f))))
    :func (do (note-ref! x)
              (when (o x :generic) (e/generic!))
              (let [ty (or (o x :type) :invalid)
                    tps (o x :tparams)]
                (cond
                  (not (t/valid? ty)) (invalid f)
                  ;; a generic function: instantiated by its call, its assignment or (inst F T...)
                  (seq tps)
                  (do (e/generic!)
                      {:op :func :obj x :mode :value :type ty :gtype ty :tparams tps :generic-fn true
                       :inst-say (inst-say cx f) :inst-form f :form f :line (fline f)})
                  :else {:op :func :obj x :mode :value :type ty :form f :line (fline f)})))
    :builtin {:op :builtin :builtin (o x :name) :unsafe (o x :unsafe) :mode :builtin :type :invalid :form f :line (fline f)}
    :nil {:op :nil :mode :value :type :untyped-nil :form f :line (fline f)}
    :pkg (do (err! f :InvalidPkgUse "use of package %s not in selector" (o x :name)) (invalid f))
    (invalid f)))

(defn ident
  "A name in an expression."
  [cx f]
  (if (and (symbol? f) (namespace f))
    (if-let [x (qualified-obj cx f)] (obj-node cx f x) (invalid f))
    (let [n (ident-name f)]
      (cond
        (= "_" n) (do (err! f :InvalidBlank "cannot use _ as value or type") (invalid f))
        :else
        (if-let [x (resolve-name cx n)]
          (do (e/answer! f {:obj x}) (obj-node cx f x))
          (do (err! f :UndeclaredName "undefined: %s" n) (invalid f)))))))

;;; Literals

(defn literal
  "A literal form's constant node, or nil."
  [f]
  (cond
    (instance? Long f) (const-node f :untyped-int f)
    ;; go/types' basicLit checks an integer for overflow (go.dev/issue/54280: beyond 512 bits, the
    ;; value unknown; GPS30, in both modes since GP6, GPS36 (b))
    (and (or (instance? arbace.lang.BigInt f) (instance? BigInteger f)) (> (c/bit-len (bigint f)) 512))
    (do (err! f :InvalidConstVal "constant overflow") (const-node f :untyped-int :unknown))
    (instance? arbace.lang.BigInt f) (const-node f :untyped-int f)
    (instance? BigInteger f) (const-node f :untyped-int (bigint f))
    (instance? Double f) (const-node f :untyped-float (c/double-literal f))
    ;; go/constant's MakeFromLiteral: a float beyond big.Float's exponent (MaxInt32 bits) is
    ;; unknown, types2's basicLit a malformed constant
    (and (instance? java.math.BigDecimal f) (not (zero? (.signum ^java.math.BigDecimal f)))
         (> (* 3.321928094887362 (- (.precision ^java.math.BigDecimal f) (.scale ^java.math.BigDecimal f) 1)) 2147483647.0))
    (do (err! f :InvalidConstVal "malformed constant: %s" (str/lower-case (str f))) (invalid f))
    (instance? java.math.BigDecimal f) (const-node f :untyped-float (c/decimal-exact f))
    (ratio? f) (const-node f :untyped-float (c/make-rat f))
    (string? f) (const-node f :untyped-string (c/utf8-value f))
    (char? f) (const-node f :untyped-rune (long (int f)))
    (boolean? f) (const-node f :untyped-bool f)
    :else nil))

(defn byte-string-value
  "The value of (byte-string part ...)."
  [parts]
  (apply str (for [p parts] (if (string? p) (c/utf8-value p) (str (char (int p)))))))

(defn literal-form
  "A literal list form (rune n), (imaginary x), (byte-string ...): its node."
  [f h]
  (case h
    "rune" (const-node f :untyped-rune (second f))
    "imaginary" (let [x (literal (second f))]
                  (const-node f :untyped-complex (c/cplx 0 (c/float-val (:val x)))))
    "byte-string" (const-node f :untyped-string (byte-string-value (rest f)))))

;;; Selectors (selector in call.go)

(defn- tail-str [^String s] (if (empty? s) s (subs s (Character/charCount (.codePointAt s 0)))))

(defn lookup-error
  "types2's lookupError: why name is not a field or method of ty, given what a lookup ignoring
  case found (alt, or nil)."
  [ty ^String sel alt]
  (let [ob (:obj alt)
        an (when ob (if (e/obj? ob) (o ob :name) (:name ob)))
        ap (when ob (if (e/obj? ob) (o ob :pkg) (:pkg ob)))
        what (case (:kind alt) :field "field" (:method :iface-method) "method" "object")
        same-pkg (and ap (= ap (pkg-path)))
        k (cond
            (nil? ob) :missing
            same-pkg :misspelled
            (t/exported? sel) (cond (t/exported? an) :misspelled
                                    (= (tail-str sel) (tail-str an)) :unexported
                                    :else :missing)
            (t/exported? an) (if (= (tail-str sel) (tail-str an)) :misspelled :missing)
            (= sel an) :inaccessible
            :else :missing)]
    (case k
      :missing (format "type %s has no field or method %s" (t/type-str ty) sel)
      :misspelled (format "type %s has no field or method %s, but does have %s %s" (t/type-str ty) sel what an)
      :unexported (format "type %s has no field or method %s, but does have unexported %s %s" (t/type-str ty) sel what an)
      :inaccessible (format "cannot refer to unexported %s %s" what an))))


(defn- via-names [r] (mapv str (:via r)))

(defn path-derefs
  "The implicit dereferences of a field selection along its path: for each step, whether a
  pointer is dereferenced before the field is selected."
  [ty path]
  (loop [t ty path path acc []]
    (if (empty? path)
      acc
      (let [p (t/pointer? t)
            t (if p (nth (t/under t) 1) t)
            u (t/under t)
            fd (when (and (vector? u) (= :struct (nth u 0))) (get (nth u 1) (first path)))]
        (if fd
          (recur (:type fd) (rest path) (conj acc p))
          (conj acc p))))))

(defn verify-via!
  "Compares the selection's embedded path with the form's :go/via (§3.6)."
  [f r]
  (let [say (:go/via (meta f))
        have (via-names r)]
    (when (or say (and (:annotated cx-flags) (seq have)))
      (if (= (mapv ident-name (or say [])) have)
        (e/verified! :go/via f)
        (e/annotation-error! f ":go/via" (expr-str f) (pr-str (vec (or say []))) (pr-str (mapv symbol have)))))))


(defn- method-data-of
  "The data of a method (resolving its declaration): {:name :pkg :type :ptr-recv :recv-type}."
  [m]
  (t/method-data m))

(declare select-expr*)

(defn select-expr
  "x.name: a field, a method value (or a method for a call: call? true)."
  [cx f x-form nm call?]
  (select-expr* cx f x-form (expr-or-type cx x-form) nm nil))

(defn select-expr*
  "x.name of the checked operand x (of form x-form); sf, in the resolve mode, the name's form
  (raw forms' (go/select x f)), its answers recorded."
  [cx f x-form x nm sf]
  (do
    (cond
      (invalid? x) (invalid f)
      (= :typexpr (:mode x))
      (do (err! f :MissingFieldOrMethod "%s.%s undefined (use method-expr for a method expression)" (expr-str x-form) nm)
          (invalid f))
      :else
      (let [ty (:type x)
            _ (when (t/tparam? ty) (e/generic!))
            ;; go/types' lookup never finds a blank field or method
            r (when-not (= "_" nm) (t/lookup ty (= :variable (:mode x)) nm (pkg-path)))]
        (cond
          (nil? r)
          (do (let [[b p] (t/deref-type ty)]
                (if (and p (t/interface? b) (not (t/tparam? b)))
                  (err! f :InvalidMethodExpr "%s.%s undefined (type %s is pointer to interface, not interface)"
                        (expr-str x-form) nm (t/type-str ty))
                  (let [alt (binding [t/*fold-case* true] (t/lookup ty (= :variable (:mode x)) nm (pkg-path)))]
                    (err! f :MissingFieldOrMethod "%s.%s undefined (%s)" (expr-str x-form) nm
                          (lookup-error ty nm (when-not (:ambiguous alt) alt))))))
              (invalid f))
          (:ambiguous r)
          (do (err! f :AmbiguousSelector "ambiguous selector %s.%s" (expr-str x-form) nm) (invalid f))
          (:ptr-recv r)
          (do (err! f :InvalidMethodExpr "cannot call pointer method %s on %s" nm (t/type-str ty)) (invalid f))
          :else
          (do
            (if sf
              (e/answer! f {:sel {:kind (if (= :field (:kind r)) :field :method) :path (:index r) :via (via-names r)
                                  :indirect (boolean (:indirect r))}})
              (verify-via! f r))
            (case (:kind r)
              :field
              (let [fd (:obj r)]
                (when sf (e/answer! sf {:field-obj fd}))
                {:op :field :path (:index r) :derefs (path-derefs ty (:index r)) :via (via-names r) :field fd :x x
                 :mode (if (or (= :variable (:mode x)) (:indirect r)) :variable :value)
                 :type (:type fd) :form f :line (fline f)})
              :method
              (let [m (:obj r)
                    d (method-data-of m)
                    d (if (:origin (t/info (:recv-type r))) (do (e/generic!) (t/*subst-method* (:recv-type r) d)) d)
                    recv-ptr (:ptr-recv d)
                    ;; the receiver's adjustment: &x for a pointer method on an addressable value
                    ;; reached without a pointer, *x for a value method reached through one
                    adj (cond
                          (and recv-ptr (not (:indirect r))) :addr
                          (and (not recv-ptr) (:indirect r) (empty? (:via r)) (t/pointer? ty)) :deref
                          :else nil)]
                (note-ref! m)
                (when sf (e/answer! sf {:obj m}))
                (when (o m :generic) (e/generic!))
                ;; &x taken implicitly: x's variable is addressed (for the builder: a cell)
                (when (= :addr adj) (mark-addressed! x))
                (cond-> {:op :method :method m :recv x :recv-adjust adj :path (:index r) :via (via-names r)
                         :recv-type (:recv-type r)
                         :mode :value :type (:type d) :form f :line (fline f)}
                  ;; a generic method (go1.27): instantiated by its call or (inst x.M T...)
                  (seq (:tparams d))
                  (assoc :gtype (:type d) :tparams (:tparams d) :generic-fn true
                         :rmap (let [[rb] (t/deref-type (:recv-type r))]
                                 (when (t/named? rb)
                                   (zipmap (or (o m :rtparams) []) (or (:targs (t/info rb)) []))))
                         :inst-say (inst-say cx (if (seq? f) (first f) f)) :inst-form (or sf (if (seq? f) (first f) f)))))
              :iface-method
              (let [m (:obj r)]
                (when sf (e/answer! sf {:obj m}))
                {:op :iface-method :method m :iface (:iface r) :recv x :path (:index r) :via (via-names r)
                 :mode :value :type (:type m) :form f :line (fline f)}))))))))

(declare method-expr*)

(defn method-expr
  "(method-expr T M): the method as a function of its receiver."
  [cx f]
  (let [[_ tf mf] f]
    (method-expr* cx f tf (typexpr cx tf) mf false)))

(defn method-expr*
  "T.M of the type T (of form tf), M's form mf; raw: the resolve mode's (go/select T M), its
  answers recorded."
  [cx f tf T mf raw]
  (let [nm (ident-name mf)]
    (if-not (t/valid? T)
      (invalid f)
      (let [r (t/lookup T false nm (pkg-path))]
        (cond
          (or (nil? r) (= :field (:kind r)))
          (do (err! f :MissingFieldOrMethod "%s.%s undefined (type %s has no method %s)" (expr-str tf) nm (t/type-str T) nm)
              (invalid f))
          (:ambiguous r) (do (err! f :AmbiguousSelector "ambiguous selector %s.%s" (expr-str tf) nm) (invalid f))
          (:ptr-recv r)
          (do (err! f :InvalidMethodExpr "invalid method expression %s.%s (needs pointer receiver (*%s).%s)"
                    (expr-str tf) nm (expr-str tf) nm)
              (invalid f))
          :else
          (let [d (if (= :method (:kind r)) (method-data-of (:obj r)) (:obj r))
                ;; a generic type's instance: its method's signature with the type arguments
                d (if (= :method (:kind r)) (t/*subst-method* (:recv-type r) d) d)
                [_ ps rs v] (:type d)
                ty [:func (into [T] ps) rs v]]
            ;; the converter writes no :go/via on method expressions
            (when (:go/via (meta f)) (verify-via! f r))
            (when raw
              (e/answer! f {:sel {:kind :method-expr :path (:index r) :via (via-names r) :indirect (boolean (:indirect r))}})
              (e/answer! mf {:obj (:obj r)}))
            (when (= :method (:kind r)) (note-ref! (:obj r)) (when (o (:obj r) :generic) (e/generic!)))
            (cond-> {:op :method-expr :recv-type T :method (:obj r) :path (:index r)
                     :mode :value :type ty :form f :line (fline f)}
              ;; a generic method's expression (go1.27): instantiated by (inst ...) or its use
              (seq (:tparams d))
              (assoc :gtype ty :tparams (:tparams d) :generic-fn true
                     :rmap (let [[rb] (t/deref-type (:recv-type r))]
                             (when (t/named? rb) (zipmap (or (o (:obj r) :rtparams) []) (or (:targs (t/info rb)) []))))
                     :inst-say (inst-say cx mf) :inst-form mf))))))))

;;; Index and slice expressions (index.go)

(defn- has-call-or-recv?
  "Whether a node contains a function call or a channel receive (len and cap of arrays are
  then not constant)."
  [n]
  (cond
    (map? n) (or (and (= :call (:op n)) (not= :constant (:mode n)))
                 (= :recv (:op n))
                 (some has-call-or-recv? (vals (dissoc n :form :type :obj :method :field :val :to :recv-type :iface))))
    (vector? n) (some has-call-or-recv? n)
    :else false))

(defn index-value
  "An index operand: an integer, constant ones non-negative and below max when given
  (go/types' index): [node constant-value-or-nil]."
  [cx f max-len what & {:keys [allow-negative]}]
  (let [x (expr cx f)]
    (if (invalid? x)
      [x nil]
      (let [x (if (t/untyped? (:type x)) (convert-untyped x :int) x)]
        (cond
          (invalid? x) [x nil]
          (not (t/all-integer? (:type x)))
          (do (err! f :InvalidIndex "invalid argument: %s %s must be integer" what (operand-str x)) [(invalid f) nil])
          (= :constant (:mode x))
          (let [v (:val x)]
            (cond
              (and (neg? (compare v 0)) (not allow-negative))
              (do (err! f :InvalidIndex "invalid argument: %s %s must not be negative" what (operand-str x)) [(invalid f) nil])
              (and max-len (>= (compare v max-len) 0))
              (do (err! f :InvalidIndex "invalid argument: %s %s out of bounds [0:%d]" what (expr-str f) max-len) [(invalid f) nil])
              (> (c/bit-len v) 63)
              (do (err! f :InvalidIndex "invalid argument: %s %s overflows int" what (expr-str f)) [(invalid f) nil])
              :else [x v]))
          :else [x nil])))))

(defn- tparam-index
  "x[i] of a type parameter's value (go/types' indexExpr): every type of its type set indexable
  alike, the same element type (and maps' key types)."
  [cx f x if*]
  (let [ty (:type x)
        infos (for [[_ u] (t/typeset-pairs ty)]
                (let [pa (when (and (vector? u) (= :pointer (nth u 0)))
                           (let [b (t/under (nth u 1))] (when (and (vector? b) (= :array (nth b 0))) b)))]
                  (cond
                    (nil? u) nil
                    (t/string-type? u) {:e (if t/*spelled* :byte :uint8) :l -1 :mode :value}
                    (and (vector? u) (= :array (nth u 0))) {:e (nth u 2) :l (nth u 1) :mode (if (= :variable (:mode x)) :variable :value)}
                    pa {:e (nth pa 2) :l (nth pa 1) :mode :variable}
                    (and (vector? u) (= :slice (nth u 0))) {:e (nth u 1) :l -1 :mode :variable}
                    (and (vector? u) (= :map (nth u 0))) {:k (nth u 1) :e (nth u 2) :l -1}
                    :else nil)))]
    (if (or (empty? infos) (some nil? infos) (not (apply = (map (comp t/canon :k) infos))) (not (apply = (map (comp t/canon :e) infos))))
      (do (err! f :NonIndexableOperand "cannot index %s" (operand-str x)) (invalid f))
      (let [{:keys [k e]} (first infos)
            mode (if (some #(= :value (:mode %)) infos) :value :variable)
            ls (filter #(>= % 0) (map :l infos))]
        (if k
          (let [kn (assignment cx (expr cx if*) k "map index")]
            (if (invalid? kn) (invalid f)
                {:op :map-index :x x :key kn :mode :mapindex :type e :form f :line (fline f)}))
          (let [[i] (index-value cx if* (when (seq ls) (apply min ls)) "index")]
            (if (invalid? i) (invalid f)
                {:op :index :x x :index i :mode mode :type e :form f :line (fline f)})))))))

(declare index-expr*)

(defn index-expr
  "(aget x i)."
  [cx f]
  (let [[_ xf if*] f]
    (index-expr* cx f xf (expr-or-type cx xf) if*)))

(defn index-expr*
  "x[i] of the checked operand x (of form xf)."
  [cx f xf x if*]
  (do
    (cond
      (invalid? x) (invalid f)
      (= :typexpr (:mode x))
      (do (err! f :NotAnExpr "%s is not an expression (an instantiation is (inst %s ...))" (expr-str xf) (expr-str xf)) (invalid f))
      (= :func (:op x))
      (do (err! f :NonIndexableOperand "cannot index %s" (operand-str x)) (invalid f))
      :else
      (let [ty (:type x)
            u (t/under ty)
            [u ptr] (if (and (vector? u) (= :pointer (nth u 0)) (let [b (t/under (nth u 1))] (and (vector? b) (= :array (nth b 0)))))
                      [(t/under (nth u 1)) true] [u false])]
        ;; an invalid index leaves the element's type (go/types' indexExpr; GPS36 (b))
        (cond
          (t/tparam? ty) (tparam-index cx f x if*)
          (t/string-type? u)
          (let [len (when (= :constant (:mode x)) (count (:val x)))
                [i iv] (index-value cx if* len "index")]
            (do
              (if (and (= :constant (:mode x)) iv)
                ;; a constant string indexed by a constant: a byte value (not a constant)
                {:op :index :x x :index i :mode :value :type (if t/*spelled* :byte :uint8) :form f :line (fline f)}
                {:op :index :x (default-final x) :index i :mode :value :type (if t/*spelled* :byte :uint8) :form f :line (fline f)})))
          (and (vector? u) (= :array (nth u 0)))
          (let [[i] (index-value cx if* (nth u 1) "index")]
            (do
                {:op :index :x x :index i :mode (if (or ptr (= :variable (:mode x))) :variable :value)
                 :type (nth u 2) :form f :line (fline f)}))
          (and (vector? u) (= :slice (nth u 0)))
          (let [[i] (index-value cx if* nil "index")]
            (do
                {:op :index :x x :index i :mode :variable :type (nth u 1) :form f :line (fline f)}))
          (and (vector? u) (= :map (nth u 0)))
          (let [k (assignment cx (expr cx if*) (nth u 1) "map index")]
            (do
                {:op :map-index :x x :key k :mode :mapindex :type (nth u 2) :form f :line (fline f)}))
          :else
          (do (err! f :NonIndexableOperand "cannot index %s" (operand-str x)) (invalid f)))))))

(defn slice-expr
  "(subslice x lo? hi? max?)."
  [cx f]
  (let [[_ xf & idx] f
        x (expr cx xf)]
    (if (invalid? x)
      (invalid f)
      (let [ty (:type x)
            ;; a type parameter's: the common underlying type of its type set, strings as []byte
            u (if (t/tparam? ty)
                (let [us (map second (t/typeset-pairs ty))
                      str? (some #(and % (t/string-type? %)) us)
                      us (map #(if (and % (t/string-type? %)) [:slice :uint8] %) us)]
                  (cond
                    (some nil? us) nil
                    (not (apply = (map t/canon us))) nil
                    str? :string
                    :else (first us)))
                (t/under ty))
            three (= 3 (count idx))
            [res length]
            (cond
              (nil? u) (do (err! f :NonSliceableOperand "cannot slice %s" (operand-str x)) [nil nil])
              (t/string-type? u)
              (if three
                (do (err! f :InvalidSliceExpr "invalid operation: 3-index slice of string") [nil nil])
                [(if (t/untyped? ty) :string ty) (when (= :constant (:mode x)) (count (:val x)))])
              (and (vector? u) (= :array (nth u 0)))
              (if (not= :variable (:mode x))
                (do (err! f :NonSliceableOperand "cannot slice unaddressable value %s" (operand-str x)) [nil nil])
                [[:slice (nth u 2)] (nth u 1)])
              (and (vector? u) (= :pointer (nth u 0)) (let [b (t/under (nth u 1))] (and (vector? b) (= :array (nth b 0)))))
              (let [b (t/under (nth u 1))] [[:slice (nth b 2)] (nth b 1)])
              (and (vector? u) (= :slice (nth u 0))) [ty nil]
              :else (do (err! f :NonSliceableOperand "cannot slice %s" (operand-str x)) [nil nil]))
            [res length] (if (and (t/tparam? ty) (= :string u)) [ty nil] [res length])]
        (if (nil? res)
          (invalid f)
          (let [ixs (mapv (fn [i] (if (= '_ i) [nil nil] (index-value cx i (when length (inc length)) "index"))) idx)]
            (if (some #(and (first %) (invalid? (first %))) ixs)
              (invalid f)
              (let [vals (keep second ixs)]
                ;; constant indices must be non-decreasing
                (if (and (> (count vals) 1) (not (apply <= vals)))
                  (do (err! f :SwappedSliceIndices "invalid slice indices: %s" (str/join " < " (map str (reverse vals)))) (invalid f))
                  {:op :slice :x (if (= :constant (:mode x)) (default-final x) x) :indexes (mapv first ixs)
                   :mode :value :type res :form f :line (fline f)})))))))))

;;; Type assertions

(defn type-assert
  "(assert T x)."
  [cx f]
  (let [[_ tf xf] f
        x (expr cx xf)]
    (if (invalid? x)
      (invalid f)
      (if-not (t/interface? (:type x))
        (do (err! f :InvalidAssert "invalid operation: %s is not an interface" (operand-str x)) (invalid f))
        (let [T (typexpr cx tf)]
          (cond
            (not (t/valid? T)) (invalid f)
            (and (not (t/interface? T)) (t/missing-method T (:type x) false))
            (let [mm (t/missing-method T (:type x) false)]
              (err! f :ImpossibleAssert "impossible type assertion: %s\n\t%s does not implement %s %s"
                    (expr-str f) (t/type-str T) (t/type-str (:type x)) (missing-cause T (:type x) mm))
              (invalid f))
            :else {:op :assert :x x :to T :mode :commaok :type T :form f :line (fline f)}))))))

;;; Receive, address, indirection

(defn receive [cx f]
  (let [x (expr cx (second f))]
    (if (invalid? x)
      (invalid f)
      (let [u (if (t/tparam? (:type x)) (t/core-type (:type x)) (t/under (:type x)))]
        (cond
          (not (and (vector? u) (= :chan (nth u 0))))
          (do (err! f :InvalidReceive "invalid operation: cannot receive from non-channel %s" (operand-str x)) (invalid f))
          (= :send (nth u 1))
          (do (err! f :InvalidReceive "invalid operation: cannot receive from send-only channel %s" (operand-str x)) (invalid f))
          :else {:op :recv :x x :mode :commaok :type (nth u 2) :form f :line (fline f)})))))

(defn mark-addressed!
  "Marks the variable at the root of an addressable operand as addressed (for the builder)."
  [n]
  (case (:op n)
    (:local :global) (oset! (:obj n) :addressed? true)
    :field (when-not (t/pointer? (:type (:x n))) (mark-addressed! (:x n)))
    :index (when (let [u (t/under (:type (:x n)))] (and (vector? u) (= :array (nth u 0)))) (mark-addressed! (:x n)))
    nil))

(defn address-of [cx f]
  (let [xf (second f)
        is-lit (= "lit" (head-name xf))
        x (expr cx xf)]
    (cond
      (invalid? x) (invalid f)
      (and (not is-lit) (not= :variable (:mode x)))
      (do (err! f :UnaddressableOperand "invalid operation: cannot take address of %s" (operand-str x)) (invalid f))
      :else (do (mark-addressed! x)
                {:op :addr :x x :mode :value :type [:pointer (:type x)] :form f :line (fline f)}))))

(defn indirect [cx f]
  (let [x (expr-or-type cx (second f))]
    (cond
      (invalid? x) (invalid f)
      (= :typexpr (:mode x)) {:op :type :mode :typexpr :type [:pointer (:type x)] :form f :line (fline f)}
      (= :untyped-nil (:type x))
      (do (err! f :InvalidIndirection "invalid operation: cannot indirect nil") (invalid f))
      :else
      (let [u (if (t/tparam? (:type x)) (t/core-type (:type x)) (t/under (:type x)))]
        (if (and (vector? u) (= :pointer (nth u 0)))
          {:op :deref :x x :mode :variable :type (nth u 1) :form f :line (fline f)}
          (do (err! f :InvalidIndirection "invalid operation: cannot indirect %s" (operand-str x)) (invalid f)))))))

;;; Composite literals (literals.go)

(defn- elided? [tf] (= '_ tf))

(defn- element-value
  "An element of a composite literal: elided literal types take the element type (pointer
  element types make &T{}; a type parameter's by its core type)."
  [cx vf elem-type]
  (if (and (= "lit" (head-name vf)) (elided? (second vf)))
    (let [[base ptr] (t/deref-type (if (t/tparam? elem-type) (or (t/core-type elem-type) :invalid) (t/under elem-type)))
          base (if ptr base elem-type)]
      (let [n (composite-lit (assoc cx ::lit-hint elem-type) vf base)]
        (if ptr
          {:op :addr :x n :mode :value :type elem-type :form vf :line (fline vf) :implicit true}
          n)))
    (assignment cx (expr cx vf elem-type) elem-type "array or slice literal")))

(defn- key-val
  "go/types' keyVal: a comparable representation of a constant key."
  [n]
  (when (= :constant (:mode n))
    (let [v (:val n)]
      (cond
        (c/complex? v) (if (c/fzero? (nth v 2)) (c/re-part v) v)
        (c/bf? v) (c/bf->rat v)
        :else v))))

(defn- indexed-elements
  "The elements of an array or slice literal: [nodes max-index] (go/types' indexedElts)."
  [cx f elems elem-type length]
  (loop [es elems idx 0 mx 0 seen #{} acc [] pos 2]
    (if (empty? es)
      [acc mx]
      (let [[ki node]
            (with-elem f pos
              (let [el (first es)
                    [kf vf] (if (vector? el) el [nil el])
                    [k ki] (if kf
                             (let [[k kv] (index-value cx kf length "index")]
                               (if (and k (not (invalid? k)) (nil? kv))
                                 (do (err! kf :IndexMustBeConstant "index %s must be integer constant" (expr-str kf)) [k nil])
                                 [k kv]))
                             [nil idx])
                    ki (if (and kf (nil? ki)) idx ki)
                    ki (long ki)
                    dup (contains? seen ki)
                    _ (when (and dup (or (nil? kf) (not (invalid? k))))
                        (err! (or kf vf) :DuplicateLitKey "duplicate index %d in array or slice literal" ki))
                    _ (when (and length (>= ki length) (nil? kf))
                        (err! vf :OversizeArrayLit "index %d is out of bounds (>= %d)" ki length))
                    v (element-value cx vf elem-type)]
                [ki (cond-> {:index ki :value v} k (assoc :key k))]))]
        (recur (rest es) (inc ki) (max mx (inc ki)) (conj seen ki) (conj acc node) (inc pos))))))

(declare composite-lit)

(defn composite-lit
  "(lit T element*), T a type form or _ (elided: hint, the element type of the outer literal)."
  [cx f hint]
  (let [;; an elided literal's type as go/types records it: the element type (its hint)
        lit-hint (::lit-hint cx)
        cx (dissoc cx ::lit-hint)
        [_ tf & elems] f
        elems (vec elems)
        ;; the form as a vector (its metadata kept): its elements' lines in constant time
        fv (if (vector? f) f (with-meta (vec f) (meta f)))]
    (if (and (elided? tf) (nil? hint))
      (do (err! f :UntypedLit "missing type in composite literal")
          ;; go/types goes on: the elements are used (go.dev/issue/69092)
          (doseq [el (nnext f)] (if (vector? el) (expr-internal cx (peek el) nil) (when-not (keyword? el) (expr-internal cx el nil))))
          (invalid f))
      (let [T (cond
                (elided? tf) hint
                (and (seq? tf) (= 'array (first tf)) (= '... (second tf)))
                ;; [...]T: the length from the elements
                (let [el (typexpr cx (nth tf 2))]
                  [:array-open el])
                :else (typexpr cx tf))]
        (if-not (t/valid? T)
          (invalid f)
          (let [open (and (vector? T) (= :array-open (nth T 0)))
                u (cond open T (t/tparam? T) (or (t/core-type T) :none) :else (t/under T))]
            (cond
              (= :none u) (do (err! f :InvalidLit "invalid composite literal type %s: no common underlying type" (t/type-str T)) (invalid f))
              (and (vector? u) (= :struct (nth u 0)))
              (let [fields (nth u 1)
                    ;; keys written [name value] (a literal whose type the converter saw as a type
                    ;; parameter's) are field names
                    kv? #(and (vector? %) (= 2 (count %)) (go-ident? (first %)))
                    elems (cond
                            (and (seq elems) (every? kv? elems))
                            (vec (mapcat (fn [[k v]] [(keyword (ident-name k)) v]) elems))
                            ;; raw forms (an invalid program's): keys [k v] whose key is no name
                            ;; (types2: invalid field name, the value checked)
                            (and (seq elems) (every? #(and (vector? %) (= 2 (count %))) elems))
                            (vec (mapcat (fn [[k v :as kv]] [(if (go-ident? k) (keyword (ident-name k)) {::bad-key k ::kv kv}) v]) elems))
                            ;; keys :k v among which the converter wrote [k v] (a key it found no
                            ;; field for: an invalid program's)
                            (and (keyword? (first elems)) (some kv? elems))
                            (loop [es elems acc []]
                              (cond
                                (empty? es) acc
                                (keyword? (first es)) (recur (nnext es) (conj acc (first es) (second es)))
                                (kv? (first es)) (recur (next es) (conj acc (keyword (ident-name (first (first es)))) (second (first es))))
                                :else (recur (next es) (conj acc (first es)))))
                            :else elems)
                    keyed (and (seq elems) (or (keyword? (first elems)) (map? (first elems))))
                    ;; the resolve mode: the literal's elements as written (^:go/key [k v]), the
                    ;; keys' fields, answered as the helper finds them (its
                    ;; structOf of the literal's recorded type: through a pointer, a type
                    ;; parameter's common struct)
                    orig (when (and e/*answers*
                                    (let [R (if (elided? tf) (or lit-hint hint) T)
                                          R (if (t/tparam? R) R (let [u (t/under R)] (if (t/pointer? u) (nth u 1) R)))
                                          su (if (t/tparam? R) (t/core-type R) (t/under R))]
                                      (and (vector? su) (= :struct (nth su 0)))))
                           (vec (nnext f)))]
                (if keyed
                  (let [pairs (partition 2 elems)
                        via-map (:go/via (meta f))
                        nodes (vec
                               (for [[j [k vf]] (map-indexed vector pairs)]
                                 (with-elem fv (+ 3 (* 2 j))
                                 (if (map? k)
                                   (do (expr cx vf)
                                       (err! (::kv k) :InvalidLitField "invalid field name %s in struct literal" (expr-str (::bad-key k)))
                                       nil)
                                 (let [nm (name k)
                                       r (t/lookup (if (t/tparam? T) u T) false nm (pkg-path))
                                       ;; a blank field is never found (go/types' lookup)
                                       r (when (not= "_" nm) r)
                                       direct (when (not= "_" nm) (some (fn [[i fd]] (when (and (= nm (:name fd))) i)) (map-indexed vector fields)))]
                                   (cond
                                     (and (nil? direct) (or (nil? r) (not= :field (:kind r))))
                                     (do (err! vf :MissingLitField "unknown field %s in struct literal of type %s" nm (t/type-str T))
                                         (expr cx vf) nil)
                                     (and (nil? direct) (not (allow-version? cx 27)))
                                     (do (err! vf :MissingLitField "unknown field %s in struct literal of type %s" nm (t/type-str T))
                                         nil)
                                     ;; go/types' rule for a promoted field reached through an embedded
                                     ;; pointer (no field recorded; GPS30, both modes since GPS36 (b))
                                     (and (nil? direct) (:indirect r))
                                     (do (err! vf :InvalidLitField "invalid implicit pointer indirection to reach %s" nm)
                                         (expr cx vf) nil)
                                     :else
                                     (let [r (if direct {:kind :field :obj (nth fields direct) :index [direct] :via []} r)
                                           fd (:obj r)
                                           say (get via-map k)
                                           have (via-names r)]
                                       (when (or say (and (:annotated cx-flags) (seq have)))
                                         (if (= (mapv ident-name (or say [])) have)
                                           (e/verified! :go/via)
                                           (e/annotation-error! f ":go/via" (str (expr-str f) " key " nm)
                                                                (pr-str (vec (or say []))) (pr-str (mapv symbol have)))))
                                       (when (and (:pkg fd) (not= (:pkg fd) (pkg-path)))
                                         (err! vf :UnexportedLitField "cannot refer to unexported field %s in struct literal of type %s" nm (t/type-str T)))
                                       (when-let [el (get orig j)]
                                         (when (vector? el) (e/answer! el {:field {:path (:index r) :via have}})))
                                       {:field fd :path (:index r) :via have :pos (+ 3 (* 2 j))
                                        :value (assignment cx (expr cx vf) (:type fd) "struct literal")}))))))) ]
                    ;; duplicate keys (of fields found)
                    (reduce (fn [seen n]
                              (let [k (:field n)]
                                (if (contains? seen k)
                                  (do (with-elem fv (dec (:pos n))
                                        (err! nil :DuplicateLitField "duplicate field name %s in struct literal" (:name k)))
                                      seen)
                                  (conj seen k))))
                            #{} (remove nil? nodes))
                    {:op :lit :kind :struct :to T :fields (vec (map #(dissoc % :pos) (remove nil? nodes))) :mode :value :type T :form f :line (fline f)})
                  (do
                    (let [nodes (vec (map-indexed
                                      (fn [i vf]
                                        (with-elem fv (+ 2 i)
                                        (cond
                                          ;; a key: value among values (go/types: an error, skipped)
                                          (and (vector? vf) (= 2 (count vf)))
                                          (do (err! vf :MixedStructLit "mixture of field:value and value elements in struct literal") nil)
                                          :else
                                        (if-let [fd (get fields i)]
                                          (do (when (and (:pkg fd) (not= (:pkg fd) (pkg-path)))
                                                (err! vf :UnexportedLitField "implicit assignment to unexported field %s in struct literal of type %s"
                                                      (:name fd) (t/type-str T)))
                                              {:field fd :path [i] :value (assignment cx (expr cx vf) (:type fd) "struct literal")})
                                          ;; go/types: at the first value too many, after checking it
                                          (let [n (expr cx vf)]
                                            (when (= i (count fields))
                                              (err! vf :InvalidStructLit "too many values in struct literal of type %s" (t/type-str T)))
                                            nil)))))
                                      (take (inc (count fields)) elems)))]
                      ;; go/types: at the closing brace, whose line the forms do not keep
                      (when (and (seq elems) (< (count elems) (count fields)))
                        (err! f :InvalidStructLit "too few values in struct literal of type %s%s" (t/type-str T)
                              (if (some #(and (:pkg %) (not= (:pkg %) (pkg-path))) fields)
                                " (type has unexported fields - use key:value pairs)" "")))
                      {:op :lit :kind :struct :to T :fields (vec (remove nil? nodes)) :mode :value :type T :form f :line (fline f)}))))
              (and (vector? u) (#{:array :array-open} (nth u 0)))
              (let [el (if open (nth u 1) (nth u 2))
                    [nodes mx] (indexed-elements cx fv elems el (when-not open (nth u 1)))
                    T (if open [:array mx el] T)]
                {:op :lit :kind :array :to T :elems nodes :mode :value :type T :form f :line (fline f)})
              (and (vector? u) (= :slice (nth u 0)))
              (let [[nodes] (indexed-elements cx fv elems (nth u 1) nil)]
                {:op :lit :kind :slice :to T :elems nodes :mode :value :type T :form f :line (fline f)})
              (and (vector? u) (= :map (nth u 0)))
              (let [[_ K V] u
                    nodes (vec (map-indexed
                                (fn [i el]
                                  (with-elem fv (+ 2 i)
                                    (if-not (vector? el)
                                      (do (err! el :MissingLitKey "missing key in map literal") nil)
                                      (let [[kf vf] el
                                            k (if (and (= "lit" (head-name kf)) (elided? (second kf)))
                                                (element-value cx kf K)
                                                (assignment cx (expr cx kf K) K "map literal"))
                                            v (element-value cx vf V)]
                                        {:key k :value v :pos (+ 2 i)}))))
                                elems))
                    nodes (vec (remove nil? nodes))]
                ;; duplicate constant keys (go/types: of keys of a non-interface type ... or constants)
                (reduce (fn [seen {:keys [key pos]}]
                          ;; go/types: a constant key, of an interface key type by its own type too
                          (if-let [kv (let [key (if (= :convert-iface (:op key)) (:x key) key)]
                                        (when (and key (= :constant (:mode key))) (key-val key)))]
                            (let [kk [(t/type-str (t/canon (:type (if (= :convert-iface (:op key)) (:x key) key)))) kv]]
                              (if (contains? seen kk)
                                (do (with-elem fv pos
                                      (err! (:form key) :DuplicateLitKey "duplicate key %s in map literal" (expr-str (:form key))))
                                    seen)
                                (conj seen kk)))
                            seen))
                        #{} nodes)
                {:op :lit :kind :map :to T :entries (mapv #(dissoc % :pos) nodes) :mode :value :type T :form f :line (fline f)})
              ;; go/types: an invalid underlying type (an instance with a wrong count of type
              ;; arguments): its error reported, the elements used, a value of the type
              (= :invalid u)
              (do (doseq [el (nnext f)] (if (vector? el) (expr-internal cx (peek el) nil) (when-not (keyword? el) (expr-internal cx el nil))))
                  {:op :lit :kind :invalid :to T :mode :value :type T :form f :line (fline f)})
              :else
              (do (err! f :InvalidLit "invalid composite literal type %s" (t/type-str T)) (invalid f)))))))))

;;; Calls (call.go)

(defn- tuple-types [ty] (if (and (vector? ty) (= :tuple (nth ty 0))) (vec (rest ty)) [ty]))

(defn- results-type [rs]
  (case (count rs) 0 nil 1 (first rs) (into [:tuple] rs)))

(defn- spread? [a] (= "spread" (head-name a)))

(defn generic-fn?
  "Whether node n is a generic function's (or method's) value not instantiated yet."
  [n]
  (boolean (:generic-fn n)))

(defn- types-str [tys] (str "[" (str/join " " (map t/type-str tys)) "]"))

(defn inst-say
  "The type arguments the converter's :inst on form f says (§3.6, SPEC.md §5.5), checked, or nil."
  [cx f]
  (when-let [inst (and (instance? arbace.lang.IMeta f) (:inst (meta f)))]
    (mapv #(typexpr cx %) inst)))

(defn- record-inst!
  "Compares the converter's :inst of a generic function's instance with its type arguments the
  checker computed (inferred?: some of them inferred, which the converter always annotates)."
  [n targs inferred?]
  (let [say (:inst-say n) f (:inst-form n)]
    ;; the resolve mode: at the name (a qualified one's: its :name-pos)
    (when e/*answers*
      (if (:x-pos (second (e/at-of f))) (e/answer! f :name-pos {:inst targs}) (e/answer! f {:inst targs})))
    (cond
      say (if (= say targs)
            (e/verified! :inst f)
            (e/annotation-error! f ":inst" (expr-str f) (types-str say) (types-str targs)))
      (and inferred? (:annotated cx-flags))
      (e/annotation-error! f ":inst" (expr-str f) "none" (types-str targs)))))

(defn instantiate-fn
  "Generic function (or method) node n instantiated with targs (one per type parameter): its
  signature substituted, the instantiation verified after the declaration (go/types'
  instantiateSignature), the converter's :inst compared."
  [n targs inferred?]
  (let [tps (:tparams n)
        m (merge (:rmap n) (zipmap tps targs))]
    (*verify-later* (:form n) tps targs (:rmap n))
    (record-inst! n targs inferred?)
    (-> n (assoc :type (*subst* (:gtype n) m) :targs targs) (dissoc :generic-fn :ptargs :inst-say))))

(defn func-inst-target
  "go/types' funcInst with a target: generic function node n assigned to a variable of function
  type sig (reverse inference, go1.21), instantiated, or invalid after an error."
  [cx n sig context]
  (let [tps (:tparams n)
        [_ ps rs v] (:gtype n)
        [tps2 params] (rename-tparams tps (into [:tuple] (when sig [[:func ps rs v]])))
        targs (infer tps2 (vec (:ptargs n)) (vec (rest params))
                     (if sig [{:op :target :type sig :mode :value :form (symbol (str context))}] []) (some? sig)
                     (fn [ef msg] (err! (or ef (:form n)) :CannotInferTypeArgs "%s" msg)))]
    (if targs
      (instantiate-fn n targs true)
      (assoc n :mode :invalid :type :invalid))))

(defn- spread? [a] (= "spread" (head-name a)))

(defn call-args
  "The arguments of a call of callee node (its signature sig: [:func ps rs variadic]), checked
  and assigned to its parameters (go/types' genericExprList and arguments): {:args :callee},
  the callee and generic function arguments instantiated, their missing type arguments
  inferred; nil after an error."
  [cx f callee-str callee sig arg-forms]
  (let [[_ ps rs variadic] sig
        last-spread (and (seq arg-forms) (spread? (last arg-forms)))
        arg-forms (vec arg-forms)
        ;; the arguments' indexes in the call form (their lines: with-elem)
        fv (when (seq? f) (with-meta (vec f) (meta f)))
        off (when fv (let [o (- (count fv) (count arg-forms))]
                       (when (and (>= o 0) (seq arg-forms) (identical? (nth fv o) (first arg-forms))) o)))
        at (fn [i g] (if off (with-elem fv (+ off i) (g)) (g)))
        ;; f(g()) with g of several results
        [args spread]
        (if (and (= 1 (count arg-forms)) (not last-spread))
          (let [[ns] (at 0 #(multi-expr cx (first arg-forms) false))] [ns false])
          [(vec (map-indexed (fn [i a]
                               (at i #(if (and last-spread (= i (dec (count arg-forms))))
                                        (expr cx (second a))
                                        (expr cx a))))
                             arg-forms))
           last-spread])
        nargs (count args)
        nparams (count ps)
        fail (fn [few?]
               (err! f :WrongArgCount "%s arguments in call to %s\n\thave (%s)\n\twant %s"
                     (if few? "not enough" "too many") callee-str
                     (str/join ", " (map #(type-summary (:type %)) args))
                     ;; types2's typesSummary (an invalid type is "unknown type")
                     (str "(" (str/join ", " (map-indexed (fn [i p]
                                                            (if (and variadic (= i (dec (count ps))) (vector? p) (= :slice (nth p 0)))
                                                              (str "..." (type-summary (nth p 1)))
                                                              (type-summary p)))
                                                          ps)) ")"))
               nil)
        ok (cond
             (some invalid? args) :invalid
             spread (cond
                      (not variadic) (do (err! f :NonVariadicDotDotDot "cannot use ... in call to non-variadic %s" callee-str) nil)
                      (not= nargs nparams) (fail (< nargs nparams))
                      :else true)
             variadic (if (< nargs (dec nparams)) (fail true) true)
             :else (if (not= nargs nparams) (fail (< nargs nparams)) true))
        ;; the parameters, adjusted to the arguments of a variadic call
        params-of (fn [ps]
                    (if (and variadic (not spread))
                      (vec (concat (take (dec nparams) ps) (repeat (- nargs (dec nparams)) (nth (peek ps) 1))))
                      (vec ps)))
        assign (fn [args ps]
                 (vec (map-indexed (fn [i a]
                                     (let [n (at (if (= 1 (count arg-forms)) 0 i)
                                                 #(assignment cx a (nth ps i) (str "argument to " callee-str)))]
                                       (if (and spread (= i (dec nargs))) (assoc n :spread true) n)))
                                   args)))]
    (cond
      (= :invalid ok) {:args args :callee callee}
      (not ok) nil
      :else
      (let [ctps (when (generic-fn? callee) (:tparams callee))
            gen (vec (keep-indexed (fn [i a] (when (generic-fn? a) i)) args))]
        (if (and (empty? ctps) (empty? gen))
          {:args (assign args (params-of ps)) :callee callee}
          ;; inference: the callee's type parameters and the generic arguments', renamed
          (let [[tps0 sp] (rename-tparams (vec ctps) (into [:tuple] (params-of ps)))
                sparams (vec (rest sp))
                cpt (vec (:ptargs callee))
                ctargs (vec (take (count ctps) (concat cpt (repeat nil))))
                ginfo (vec (for [i gen]
                             (let [a (nth args i)
                                   [atps aty] (rename-tparams (vec (:tparams a)) (:gtype a))]
                               {:i i :tps atps :type aty
                                :targs (vec (take (count atps) (concat (:ptargs a) (repeat nil))))})))
                all-tps (vec (concat tps0 (mapcat :tps ginfo)))
                all-targs (vec (concat ctargs (mapcat :targs ginfo)))
                iargs (reduce (fn [v g] (assoc v (:i g) (assoc (nth v (:i g)) :type (:type g)))) args ginfo)
                targs (infer all-tps all-targs sparams iargs false
                             (fn [ef msg] (err! (or ef f) :CannotInferTypeArgs "in call to %s, %s" callee-str msg)))]
            (when targs
              (let [n (count ctps)
                    callee (if (seq ctps) (instantiate-fn callee (subvec targs 0 n) (< (count cpt) n)) callee)
                    [args _] (reduce (fn [[args j] g]
                                       (let [k (+ j (count (:tps g)))
                                             a (nth args (:i g))]
                                         [(assoc args (:i g) (instantiate-fn a (subvec targs j k) (< (count (:ptargs a)) (count (:tps g)))))
                                          k]))
                                     [args n] ginfo)]
                {:args (assign args (params-of (if (seq ctps) (nth (call-sig (:type callee)) 1) ps)))
                 :callee callee}))))))))

(defn call-kind
  "The kind of a call by its callee node (§3.7)."
  [callee]
  (case (:op callee)
    ;; a function of a package checked from its forms: interpreted, its cell (GR1's table
    ;; makes :compiled calls)
    :func (if (o (:obj callee) :pkg-level) :static :closure)
    :method :method
    :iface-method :iface
    :closure))

(declare builtin-call)

(defn call-sig
  "The signature a callee of type ty has: its underlying function type (a type parameter's
  common one), or nil."
  [ty]
  (let [u (if (t/tparam? ty) (t/core-type ty) (t/under ty))]
    (when (and (vector? u) (= :func (nth u 0))) u)))

(defn- finish-call
  "The call node of callee (instantiated) and args."
  [f callee args]
  (let [u (call-sig (:type callee))
        rt (results-type (nth u 2))]
    {:op :call :kind (call-kind callee) :callee callee :args args
     :mode (if rt :value :novalue) :type (or rt :invalid) :form f :line (fline f)}))

(defn call
  "A call form: callee form cf, arguments arg-forms."
  [cx f cf arg-forms]
  (let [callee (expr-or-type cx cf)]
    (cond
      (invalid? callee) (do (doseq [a arg-forms] (when-not (spread? a) (expr cx a))) (invalid f))
      (= :typexpr (:mode callee))
      (do (when-not (:resolve cx-flags) (e/annotation-error! f "conv" (expr-str f) "a call" "a conversion"))
          (case (count arg-forms)
            1 (conversion cx f (expr cx (first arg-forms)) (:type callee))
            ;; types2's callExpr: the arity of a conversion
            0 (do (err! f :WrongArgCount "missing argument in conversion to %s" (t/type-str (:type callee))) (invalid f))
            (do (doseq [a arg-forms] (when-not (spread? a) (expr cx a)))
                (err! (last arg-forms) :WrongArgCount "too many arguments in conversion to %s" (t/type-str (:type callee)))
                (invalid f))))
      (= :builtin (:mode callee)) (builtin-call cx f (:builtin callee) arg-forms (:unsafe callee))
      :else
      (let [u (call-sig (:type callee))]
        (if-not u
          (do (err! f :InvalidCall "invalid operation: cannot call %s: %s is not a function" (operand-str callee) (t/type-str (:type callee)))
              (doseq [a arg-forms] (when-not (spread? a) (expr cx a)))
              (invalid f))
          (let [r (call-args cx f (expr-str cf) callee u arg-forms)]
            (if (or (nil? r) (generic-fn? (:callee r)))
              (invalid f)
              (finish-call f (:callee r) (:args r)))))))))

(defn method-call
  "(.M x args...)."
  [cx f nm xf arg-forms]
  (let [callee (select-expr cx f xf nm true)]
    (if (invalid? callee)
      (do (doseq [a arg-forms] (when-not (spread? a) (expr cx a))) (invalid f))
      (let [u (call-sig (:type callee))]
        (if-not u
          (do (err! f :InvalidCall "invalid operation: cannot call non-function %s" (expr-str (list (symbol (str ".-" nm)) xf)))
              (invalid f))
          (let [r (call-args cx f (str (expr-str xf) "." nm) callee u arg-forms)]
            (if (or (nil? r) (generic-fn? (:callee r)))
              (invalid f)
              (finish-call f (:callee r) (:args r)))))))))

;;; Builtins (builtins.go)

(defn- arg-nodes [cx arg-forms] (mapv #(expr cx %) arg-forms))

(defn- array-ptr-deref [u]
  (if (and (vector? u) (= :pointer (nth u 0)))
    (let [b (t/under (nth u 1))] (if (and (vector? b) (= :array (nth b 0))) b u))
    u))

(defn- slice-elem
  "go/types' sliceElem: the element type every type of ty's type set shares as a slice, or nil."
  [ty]
  (let [us (map second (t/typeset-pairs ty))]
    (when (every? #(and (vector? %) (= :slice (nth % 0))) us)
      (let [es (map #(nth % 1) us)]
        (when (apply = (map t/canon es)) (first es))))))

(defn- string-or-bytes?
  "Whether every type of ty's type set is a string or []byte, one at least a string."
  [ty]
  (let [us (map second (t/typeset-pairs ty))]
    (and (every? #(or (and (some? %) (t/string-type? %)) (and (vector? %) (= :slice (nth % 0)) (= :uint8 (t/under (nth % 1))))) us)
         (some #(and (some? %) (t/string-type? %)) us))))

(defn has-var-size?
  "go/types' hasVarSize: whether the size of ty depends on type parameters."
  [ty]
  (cond
    (keyword? ty) false
    (t/tparam? ty) true
    (t/named? ty) (has-var-size? (t/under ty))
    :else (case (nth ty 0)
            :array (has-var-size? (nth ty 2))
            :struct (boolean (some #(has-var-size? (:type %)) (nth ty 1)))
            false)))

(defn offsetof-value
  "unsafe.Offsetof's value of the field at path (an embedded path, field indexes) of struct type
  base, or nil when the path crosses a pointer, -1 when the offset is too large (go/types'
  offsetof)."
  [base path]
  (loop [ty base path path off 0]
    (if (empty? path)
      off
      (let [u (t/under ty)
            fs (nth u 1)
            i (first path)
            fd (nth fs i)
            o (long (nth (t/offsetsof fs) i))
            off2 (unchecked-add (long off) o)]
        (cond
          (and (next path) (t/pointer? (:type fd))) nil
          (or (neg? o) (neg? off2)) -1
          :else (recur (:type fd) (rest path) off2))))))

(defn builtin-call
  "A call of builtin nm (unsafe: one of package unsafe's)."
  [cx f nm arg-forms unsafe]
  (let [;; f(g()) for builtins of several arguments: g's results are the arguments
        arg-forms (if (and (= 1 (count arg-forms)) (contains? #{"append" "copy" "delete" "complex" "min" "max" "print" "println" "Add" "Slice" "String"} nm)
                           (call-form? (first arg-forms)))
                    (let [[ns] (multi-expr cx (first arg-forms) false)]
                      (mapv (fn [n] {::node n}) ns))
                    arg-forms)
        bad (fn [fmt & args] (apply err! f :InvalidArgument fmt args) (invalid f))
        node (fn [m] (merge {:op :call :kind :builtin :builtin nm :form f :line (fline f)} m))
        nargs (count arg-forms)
        cname (if unsafe (str "unsafe." nm) nm)
        ;; go/types: the arguments checked first (but make's, new's, Offsetof's), an invalid one
        ;; ending the call without more errors; then their count
        need (fn [lo hi]
               (if (or (< nargs lo) (and hi (> nargs hi)))
                 (do (when-not (some (fn [a] (invalid? (expr-internal cx (if (spread? a) (second a) a) nil)))
                                     (when-not (#{"make" "new" "Offsetof"} nm) arg-forms))
                       (if (< nargs lo)
                         (err! f :WrongArgCount "invalid operation: not enough arguments for %s (expected %d, found %d)" (expr-str f) lo nargs)
                         (err! f :WrongArgCount "invalid operation: too many arguments for %s (expected %d, found %d)" (expr-str f) hi nargs)))
                     false)
                 true))
        spread-bad (fn [] (when (and (not= nm "append") (some spread? arg-forms))
                            (err! f :InvalidDotDotDot "invalid operation: invalid use of ... with built-in %s" nm)
                            ;; go/types' use: the arguments checked, their variables used
                            (doseq [a arg-forms] (expr-internal cx (if (spread? a) (second a) a) nil))
                            true))]
    (if (spread-bad)
      (invalid f)
      (case nm
        ("len" "cap")
        (if-not (need 1 1)
          (invalid f)
          (let [x (expr cx (first arg-forms))]
            (if (invalid? x)
              (invalid f)
              (let [u (array-ptr-deref (t/under (:type x)))]
                (cond
                  (t/tparam? (:type x))
                  (if (t/under-is (:type x) (fn [u] (let [u (array-ptr-deref u)]
                                                      (or (and (some? u) (t/string-type? u) (= nm "len"))
                                                          (and (vector? u) (#{:array :slice :chan} (nth u 0)))
                                                          (and (vector? u) (= :map (nth u 0)) (= nm "len"))))))
                    (node {:args [x] :mode :value :type :int})
                    (bad "invalid argument: %s for built-in %s" (operand-str x) nm))
                  (and (t/string-type? u) (= nm "len"))
                  (if (= :constant (:mode x))
                    (node {:args [x] :mode :constant :type :int :val (long (count (:val x)))})
                    (node {:args [x] :mode :value :type :int}))
                  (and (vector? u) (= :array (nth u 0)))
                  (if (has-call-or-recv? x)
                    (node {:args [x] :mode :value :type :int})
                    (node {:args [x] :mode :constant :type :int :val (nth u 1)}))
                  (and (vector? u) (#{:slice :chan} (nth u 0))) (node {:args [x] :mode :value :type :int})
                  (and (vector? u) (= :map (nth u 0)) (= nm "len")) (node {:args [x] :mode :value :type :int})
                  :else (bad "invalid argument: %s for built-in %s" (operand-str x) nm))))))
        "append"
        (if (zero? nargs)
          (bad "invalid operation: not enough arguments for %s (expected 1, found 0)" (expr-str f))
          (let [s0 (first arg-forms)
                s (expr cx (if (spread? s0) (second s0) s0))]
            (cond
              (invalid? s) (do (doseq [a (rest arg-forms)] (expr cx (if (spread? a) (second a) a))) (invalid f))
              ;; go/types' sliceElem
              (= :untyped-nil (:type s)) (bad "invalid append: argument must be a slice; have untyped nil")
              :else
              (let [S (:type s)
                    el (slice-elem S)]
                (cond
                  (nil? el)
                  (bad "invalid append: argument must be a slice; have %s" (operand-str s))
                  :else
                  (let [more (rest arg-forms)
                        last-spread (and (seq more) (spread? (last more)))]
                    (if (and last-spread (= 1 (count more)) (not (spread? s0)))
                      ;; append(s, t...): t assignable to S, or a string for []byte
                      (let [x (expr cx (second (first more)))]
                        (cond
                          (invalid? x) (invalid f)
                          (and (first (assignable? s [:slice :uint8])) (string-or-bytes? (:type x)))
                          (node {:args [s (assoc (default-final x) :spread true)] :mode :value :type S})
                          :else
                          (let [x (assignment cx x [:slice el] "argument to append")]
                            (if (invalid? x) (invalid f)
                                (node {:args [s (assoc x :spread true)] :mode :value :type S})))))
                      (if (or last-spread (spread? (first arg-forms)))
                        ;; go/types: the arguments of a signature func(S, ...E) S
                        (do (call-args cx f "append" nil [:func [S [:slice el]] [S] true] arg-forms)
                            (invalid f))
                        (let [xs (mapv (fn [a] (assignment cx (expr cx a el) el "argument to append")) more)]
                          (node {:args (into [s] xs) :mode :value :type S}))))))))))
        "copy"
        (if-not (need 2 2)
          (invalid f)
          (let [[d s] (arg-nodes cx arg-forms)]
            (if (or (invalid? d) (invalid? s))
              (invalid f)
              (let [de (slice-elem (:type d))
                    se (or (slice-elem (:type s)) (when (t/all-string? (:type s)) :uint8))
                    ;; go/types' sliceElem's error
                    not-slice (fn [x] (if (= :untyped-nil (:type x))
                                        "invalid copy: argument must be a slice; have untyped nil"
                                        (str "invalid copy: argument must be a slice; have " (operand-str x))))]
                (cond
                  (nil? de)
                  (do (err! (:form d) :InvalidCopy "%s" (not-slice d)) (invalid f))
                  (and (first (assignable? d [:slice :uint8])) (string-or-bytes? (:type s)))
                  (node {:args [d (default-final s)] :mode :value :type :int})
                  (nil? se)
                  (do (err! (:form s) :InvalidCopy "%s" (not-slice s)) (invalid f))
                  (not (t/same? de se))
                  (bad "invalid copy: arguments %s and %s have different element types %s and %s"
                       (operand-str d) (operand-str s) (t/type-str de) (t/type-str se))
                  :else (node {:args [d s] :mode :value :type :int}))))))
        "delete"
        (if-not (need 2 2)
          (invalid f)
          (let [m (expr cx (first arg-forms))]
            (if (invalid? m)
              (do (expr cx (second arg-forms)) (invalid f))
              (let [us (map second (t/typeset-pairs (:type m)))
                    u (when (and (every? #(and (vector? %) (= :map (nth % 0))) us) (apply = (map #(t/canon (nth % 1)) us))) (first us))]
                (if-not u
                  (do (expr cx (second arg-forms)) (bad "invalid argument: %s is not a map" (operand-str m)))
                  (let [k (assignment cx (expr cx (second arg-forms)) (nth u 1) "argument to delete")]
                    (if (invalid? k) (invalid f) (node {:args [m k] :mode :novalue :type :invalid}))))))))
        "clear"
        (if-not (need 1 1)
          (invalid f)
          (let [x (expr cx (first arg-forms))]
            (cond
              (invalid? x) (invalid f)
              (not (allow-version? cx 21)) (bad "clear requires go1.21 or later")
              (t/under-is (:type x) (fn [u] (and (vector? u) (#{:map :slice} (nth u 0)))))
              (node {:args [x] :mode :novalue :type :invalid})
              :else (bad "invalid argument: %s cannot be cleared: argument must be (or constrained by) map or slice" (operand-str x)))))
        "close"
        (if-not (need 1 1)
          (invalid f)
          (let [x (expr cx (first arg-forms))]
            (if (invalid? x)
              (invalid f)
              (let [us (map second (t/typeset-pairs (:type x)))]
                (cond
                  (not (every? #(and (vector? %) (= :chan (nth % 0))) us)) (bad "invalid operation: cannot close non-channel %s" (operand-str x))
                  (some #(= :recv (nth % 1)) us) (bad "invalid operation: cannot close receive-only channel %s" (operand-str x))
                  :else (node {:args [x] :mode :novalue :type :invalid}))))))
        "complex"
        (if-not (need 2 2)
          (invalid f)
          (let [[x y] (arg-nodes cx arg-forms)]
            (if (or (invalid? x) (invalid? y))
              (invalid f)
              (let [;; untyped operands: both convert to float kinds, or to the other's type
                    to-float (fn [n] (if (and (t/untyped? (:type n)) (= :constant (:mode n)))
                                       (let [v (float-of (:val n) (:type n))]
                                         (if (nil? v) n (assoc n :type :untyped-float :val v)))
                                       n))
                    ;; go/types: both untyped constants to floats; when one is not constant (an
                    ;; untyped shift), both to float64 (the shift's error then)
                    [x y] (if (and (t/untyped? (:type x)) (t/untyped? (:type y)))
                            (if (and (= :constant (:mode x)) (= :constant (:mode y)))
                              [(to-float x) (to-float y)]
                              [(convert-untyped x :float64) (convert-untyped y :float64)])
                            [x y])
                    [x y] (cond
                            (and (t/untyped? (:type x)) (t/typed? (:type y))) [(convert-untyped x (:type y)) y]
                            (and (t/untyped? (:type y)) (t/typed? (:type x))) [x (convert-untyped y (:type x))]
                            :else [x y])]
                (cond
                  (or (invalid? x) (invalid? y)) (invalid f)
                  (not (t/same? (:type x) (:type y)))
                  (bad "invalid operation: %s (mismatched types %s and %s)" (expr-str f) (t/type-str (:type x)) (t/type-str (:type y)))
                  (not (t/float-type? (:type x)))
                  (bad "invalid argument: arguments have type %s, expected floating-point" (t/type-str (:type x)))
                  :else
                  (let [rt (case (t/basic (:type x)) :float32 :complex64 :float64 :complex128 :untyped-float :untyped-complex)]
                    (if (and (= :constant (:mode x)) (= :constant (:mode y)))
                      (overflow (node {:args [x y] :mode :constant :type rt :val (c/cplx (:val x) (:val y))}) nil)
                      (node {:args [(default-final x) (default-final y)] :mode :value
                             :type (if (= rt :untyped-complex) :complex128 rt)}))))))))
        ("real" "imag")
        (if-not (need 1 1)
          (invalid f)
          (let [x (expr cx (first arg-forms))
                x (if (and (t/untyped? (:type x)) (= :constant (:mode x)) (not (invalid? x)))
                    (let [z (complex-of (:val x) (:type x))] (if z (assoc x :type :untyped-complex :val z) x))
                    x)]
            (cond
              (invalid? x) (invalid f)
              (not (t/complex-type? (:type x)))
              (bad "invalid argument: argument has type %s, expected complex type" (t/type-str (:type x)))
              :else
              (let [rt (case (t/basic (:type x)) :complex64 :float32 :complex128 :float64 :untyped-complex :untyped-float)]
                (if (= :constant (:mode x))
                  (node {:args [x] :mode :constant :type rt :val ((if (= nm "real") c/re-part c/im-part) (c/complex-val (:val x)))})
                  (node {:args [x] :mode :value :type rt}))))))
        "make"
        (if (zero? nargs)
          (bad "invalid operation: not enough arguments for %s (expected 1, found 0)" (expr-str f))
          (let [T (typexpr cx (first arg-forms))
                u (if (t/tparam? T)
                    (let [[cu] (t/common-under T (fn [_ u] (when-not (and (vector? u) (#{:slice :map :chan} (nth u 0))) "no")))] (or cu :none))
                    (t/under T))
                [lo hi] (cond
                          (not (vector? u)) [0 0]
                          (= :slice (nth u 0)) [2 3]
                          (#{:map :chan} (nth u 0)) [1 2]
                          :else [0 0])]
            (cond
              (not (t/valid? T)) (do (doseq [a (rest arg-forms)] (expr cx a)) (invalid f))
              (zero? hi) (bad "invalid argument: cannot make %s; type must be slice, map, or channel" (expr-str (first arg-forms)))
              (or (< nargs lo) (> nargs hi))
              (bad "invalid operation: %s expects %d or %d arguments; found %d" (expr-str f) lo hi nargs)
              :else
              (let [sizes (mapv (fn [a] (first (index-value cx a nil "index"))) (rest arg-forms))
                    vals (mapv #(when (and % (= :constant (:mode %))) (:val %)) sizes)]
                (cond
                  (some invalid? sizes) (invalid f)
                  (and (= 2 (count vals)) (every? some? vals) (> (compare (first vals) (second vals)) 0))
                  (bad "invalid argument: length and capacity swapped")
                  :else (node {:args (into [{:op :type :mode :typexpr :type T :form (first arg-forms)}] sizes)
                               :mode :value :type T}))))))
        "new"
        (if-not (need 1 1)
          (invalid f)
          (let [x (exclude (expr-or-type cx (first arg-forms)) #{:novalue :builtin})]
            (cond
              (invalid? x) (invalid f)
              (= :typexpr (:mode x)) (node {:args [x] :mode :value :type [:pointer (:type x)]})
              (not (allow-version? cx 26)) (bad "new(expr) requires go1.26 or later")
              :else
              (let [x (assignment cx x nil "argument to new")]
                (if (invalid? x) (invalid f) (node {:args [x] :mode :value :type [:pointer (:type x)] :new-value true}))))))
        "panic"
        (if-not (need 1 1)
          (invalid f)
          (let [x (expr cx (first arg-forms))
                x (assignment cx x [:interface [] nil] "argument to panic")]
            (if (invalid? x) (invalid f) (node {:args [x] :mode :novalue :type :invalid}))))
        ("print" "println")
        (let [xs (mapv (fn [a] (assignment cx (expr cx a) nil (str "argument to built-in " nm))) arg-forms)]
          (if (some invalid? xs) (invalid f) (node {:args xs :mode :novalue :type :invalid})))
        "recover"
        (if-not (need 0 0)
          (invalid f)
          (node {:args [] :mode :value :type [:interface [] nil]}))
        ("min" "max")
        (if-not (need 1 nil)
          (invalid f)
          (let [xs (arg-nodes cx arg-forms)]
            (cond
              (some invalid? xs) (invalid f)
              (not (allow-version? cx 21)) (bad "%s requires go1.21 or later" nm)
              :else
              (let [x (reduce (fn [x y]
                                (if (invalid? x)
                                  x
                                  (let [[x y] (match-types x y)]
                                    (cond
                                      (or (invalid? x) (invalid? y)) (invalid f)
                                      (not (t/same? (:type x) (:type y)))
                                      (do (err! f :MismatchedTypes "invalid argument: mismatched types %s (previous argument) and %s (type of %s)"
                                                (t/type-str (:type x)) (t/type-str (:type y)) (expr-str (:form y)))
                                          (invalid f))
                                      (not (t/all-ordered? (:type x)))
                                      (do (err! f :InvalidMinMaxOperand "invalid argument: %s cannot be ordered" (operand-str x)) (invalid f))
                                      (and (= :constant (:mode x)) (= :constant (:mode y)))
                                      (let [pick (if (const-compare (if (= nm "min") "<" ">") (:val y) (:val x) (:type x)) y x)]
                                        (assoc pick :form (:form pick)))
                                      :else (assoc x :mode :value)))))
                              (first xs) (rest xs))]
                (cond
                  (invalid? x) (invalid f)
                  (not (t/all-ordered? (:type x)))
                  (bad "invalid argument: %s cannot be ordered" (operand-str (first xs)))
                  (= :constant (:mode x))
                  (node {:args xs :mode :constant :type (:type x) :val (:val x)})
                  :else
                  (let [ty (:type x)
                        xs (mapv #(convert-untyped % ty) xs)]
                    (node {:args xs :mode :value :type ty})))))))
        ;; package unsafe
        ("Sizeof" "Alignof")
        (if-not (need 1 1)
          (invalid f)
          (let [x (assignment cx (expr cx (first arg-forms)) nil (str "argument to unsafe." nm))]
            (cond
              (invalid? x) (invalid f)
              (has-var-size? (:type x)) (node {:args [x] :mode :value :type :uintptr})
              ;; go/types: a size beyond int64 (GR7c)
              (and (= nm "Sizeof") (neg? (t/sizeof (:type x))))
              (do (err! (first arg-forms) :TypeTooLarge "%s is too large" (operand-str x)) (invalid f))
              :else (node {:args [x] :mode :constant :type :uintptr
                           :val (if (= nm "Sizeof") (t/sizeof (:type x)) (t/alignof (:type x)))}))))
        "Offsetof"
        (if-not (need 1 1)
          (invalid f)
          (let [af (first arg-forms)
                h (head-name af)
                ;; the resolve mode: raw forms' (go/select x f)
                raw (and (:resolve cx-flags) (= "go/select" h))]
            (if-not (and h (or raw (str/starts-with? h ".-")))
              (bad "invalid argument: %s is not a selector expression" (expr-str af))
              (let [x (if raw
                        (let [n (raw-select cx af)]
                          (e/answer! af {:mode (:mode n) :type (:type n)})
                          n)
                        (select-expr cx af (second af) (subs h 2) false))
                    h (if raw (str ".-" (ident-name (nth af 2))) h)]
                (cond
                  (invalid? x) (invalid f)
                  ;; (the resolve mode: go/types records the selection only of a valid argument)
                  (not= :field (:op x)) (do (when raw (e/unanswer! af [:sel])) (bad "invalid argument: %s is a method value" (expr-str af)))
                  :else
                  ;; the offset along the embedded path, without crossing a pointer
                  (let [base (first (t/deref-type (:type (:x x))))
                        off (offsetof-value base (:path x))]
                    (cond
                      (nil? off) (do (when raw (e/unanswer! af [:sel]))
                                     (bad "invalid argument: field %s is embedded via a pointer in %s" (subs h 2) (t/type-str base)))
                      ;; a size depending on type parameters: not constant (each instance's)
                      (has-var-size? base) (node {:args [x] :mode :value :type :uintptr})
                      (neg? (long off)) (do (err! (second af) :TypeTooLarge "%s is too large" (operand-str (:x x))) (invalid f))
                      :else (node {:args [x] :mode :constant :type :uintptr :val off}))))))))
        "Add"
        (if-not (do (when-not (allow-version? cx 17)
                      ;; types2: an error, the call checked on (verifyVersionf)
                      (err! f :UnsupportedFeature "unsafe.Add requires go1.17 or later"))
                    (need 2 2))
          (invalid f)
          (let [p (assignment cx (expr cx (first arg-forms)) :unsafe-pointer "argument to unsafe.Add")
                [n] (index-value cx (second arg-forms) nil "length" :allow-negative true)]
            (if (or (invalid? p) (invalid? n)) (invalid f) (node {:args [p n] :mode :value :type :unsafe-pointer}))))
        "Slice"
        (if-not (do (when-not (allow-version? cx 17)
                      ;; types2: an error, the call checked on (verifyVersionf)
                      (err! f :UnsupportedFeature "unsafe.Slice requires go1.17 or later"))
                    (need 2 2))
          (invalid f)
          (let [p (expr cx (first arg-forms))
                [n] (index-value cx (second arg-forms) nil "length")]
            (cond
              (or (invalid? p) (invalid? n)) (invalid f)
              (not (and (vector? (t/under (:type p))) (= :pointer (nth (t/under (:type p)) 0))))
              (bad "invalid argument: %s is not a pointer" (operand-str p))
              :else (node {:args [p n] :mode :value :type [:slice (nth (t/under (:type p)) 1)]}))))
        "SliceData"
        (if-not (do (when-not (allow-version? cx 20)
                      ;; types2: an error, the call checked on (verifyVersionf)
                      (err! f :UnsupportedFeature "unsafe.SliceData requires go1.20 or later"))
                    (need 1 1))
          (invalid f)
          (let [s (expr cx (first arg-forms))
                u (t/under (:type s))]
            (cond
              (invalid? s) (invalid f)
              (not (and (vector? u) (= :slice (nth u 0)))) (bad "invalid argument: %s is not a slice" (operand-str s))
              :else (node {:args [s] :mode :value :type [:pointer (nth u 1)]}))))
        "String"
        (if-not (do (when-not (allow-version? cx 20)
                      ;; types2: an error, the call checked on (verifyVersionf)
                      (err! f :UnsupportedFeature "unsafe.String requires go1.20 or later"))
                    (need 2 2))
          (invalid f)
          (let [p (assignment cx (expr cx (first arg-forms)) [:pointer (if t/*spelled* :byte :uint8)] "argument to unsafe.String")
                [n] (index-value cx (second arg-forms) nil "length")]
            (if (or (invalid? p) (invalid? n)) (invalid f) (node {:args [p n] :mode :value :type :string}))))
        "StringData"
        (if-not (do (when-not (allow-version? cx 20)
                      ;; types2: an error, the call checked on (verifyVersionf)
                      (err! f :UnsupportedFeature "unsafe.StringData requires go1.20 or later"))
                    (need 1 1))
          (invalid f)
          (let [s (assignment cx (expr cx (first arg-forms)) :string "argument to unsafe.StringData")]
            (if (invalid? s) (invalid f) (node {:args [s] :mode :value :type [:pointer (if t/*spelled* :byte :uint8)]}))))
        (bad "unknown builtin %s" nm)))))

;;; Explicit instantiation

(defn inst-expr
  "(inst F T...): a generic function's instance, partial when it lacks type arguments (inferred
  at its call or assignment), or a generic type's."
  [cx f]
  (let [[_ gf & tfs] f
        x (when (or (symbol? gf) (go-id? gf))
            (if (and (symbol? gf) (namespace gf)) (qualified-obj cx gf) (resolve-name cx (ident-name gf))))]
    (e/generic!)
    (if (and x (= :type (o x :kind)))
      (let [T (typexpr cx f)] (if (t/valid? T) {:op :type :mode :typexpr :type T :form f} (invalid f)))
      (let [g (expr-or-type cx gf)]
        (cond
          (invalid? g) (invalid f)
          (= :typexpr (:mode g)) {:op :type :mode :typexpr :type (typexpr cx f) :form f}
          (generic-fn? g)
          (let [tps (:tparams g)
                targs (mapv #(typexpr cx %) tfs)]
            (cond
              (some #(not (t/valid? %)) targs) (invalid f)
              (> (count targs) (count tps))
              (do (err! f :WrongTypeArgCount "got %d type arguments but want %d" (count targs) (count tps)) (invalid f))
              (= (count targs) (count tps)) (assoc (instantiate-fn g targs false) :form f :line (fline f))
              :else (assoc g :ptargs targs :form f :line (fline f))))
          :else (do (err! f :NotAGenericType "invalid operation: cannot index %s" (operand-str g)) (invalid f)))))))

;;; Function literals

(defn func-lit
  "(fn params results? body*)."
  [cx f]
  (let [[sig ps rs body named] (signature cx (rest f) nil)]
    (func-body cx f sig ps rs body named)))

;;; Raw forms (the resolve mode, doc/go/GO-PARSER-SURVEY.md GP4; doc/go/CONVERTER-NOTES.md "Raw forms")

(def raw-heads #{"go/select" "go/index" "go/star" "go/type-guard" "go/define" "go/literal"})

(def raw-builtin-names
  #{"append" "cap" "clear" "close" "complex" "copy" "delete" "imag" "len" "make" "max" "min" "new"
    "panic" "print" "println" "real" "recover"})

(defn- raw-qualified
  "The qualified name pkg/nm of a raw (go/select x f) whose operand names a package: a symbol
  with the selector's line and positions, the operand's and the name's (:x-pos, :name-pos)."
  [f xf sf]
  (let [[file pm] (e/at-of f)
        xp (get (second (e/at-of xf)) :name-pos)
        np (get (second (e/at-of sf)) :name-pos)]
    (with-meta (symbol (ident-name xf) (ident-name sf))
      (cond-> {:line (fline f)}
        file (assoc :arbace.go.check/at [file (cond-> pm xp (assoc :x-pos xp) np (assoc :name-pos np))])))))

(defn- pkg-name-obj
  "The package object a raw operand form names (a name resolving to an import), or nil."
  [cx xf]
  (when (and (go-ident? xf) (not (and (symbol? xf) (namespace xf))))
    (let [x (or (e/scope-lookup (:scope cx) (ident-name xf)) (e/scope-get e/universe (ident-name xf)))]
      (when (and x (= :pkg (o x :kind))) x))))

(defn raw-select
  "(go/select x f): a package's member, a field, a method value or a method expression."
  [cx f]
  (let [[_ xf sf] f
        nm (ident-name sf)]
    (if (pkg-name-obj cx xf)
      (let [q (raw-qualified f xf sf)
            n (ident cx q)]
        (assoc n :form f))
      (let [x (expr-or-type cx xf)]
        (if (= :typexpr (:mode x))
          (method-expr* cx f xf (:type x) sf true)
          (select-expr* cx f xf x nm sf))))))

(defn- raw-type-name
  "The generic type a raw index's operand names: [the type name's object, its form (a symbol,
  or pkg/T made of a (go/select pkg T))], or nil when it names no type."
  [cx xf]
  (cond
    (and (go-ident? xf) (not (and (symbol? xf) (namespace xf))))
    (let [x (or (e/scope-lookup (:scope cx) (ident-name xf))
                (when-let [[x _] (some-> (:file cx) :dots (.get (ident-name xf)))] x)
                (e/scope-get e/universe (ident-name xf)))]
      (when (and x (= :type (o x :kind))) [x xf]))
    (= "go/select" (head-name xf))
    (let [[_ pf sf] xf]
      (when-let [px (pkg-name-obj cx pf)]
        (let [p (o px :imported)
              x (when (and p (not (string? p))) (e/scope-get (o p :scope) (ident-name sf)))]
          (when (and x (= :type (o x :kind))) [x (raw-qualified xf pf sf)]))))
    :else nil))

(defn raw-index
  "(go/index x i ...): an index, a generic function's instantiation or a generic type's."
  [cx f]
  (let [[_ xf & ifs] f]
    (if-let [[_ g] (raw-type-name cx xf)]
      (let [T (typexpr cx (with-meta (list* 'inst g ifs) (meta f)))]
        (when (= "go/select" (head-name xf)) (e/answer! xf {:mode :typexpr}))
        (if (t/valid? T) {:op :type :mode :typexpr :type T :form f :line (fline f)} (invalid f)))
      (let [g (expr-or-type cx xf)]
        (cond
          (invalid? g) (invalid f)
          (generic-fn? g)
          (let [tps (:tparams g)
                targs (mapv #(typexpr cx %) ifs)]
            (e/generic!)
            (cond
              (some #(not (t/valid? %)) targs) (invalid f)
              (> (count targs) (count tps))
              (do (err! f :WrongTypeArgCount "got %d type arguments but want %d" (count targs) (count tps)) (invalid f))
              (= (count targs) (count tps)) (assoc (instantiate-fn g targs false) :form f :line (fline f))
              :else (assoc g :ptargs targs :form f :line (fline f))))
          (= :typexpr (:mode g))
          (do (err! f :NotAGenericType "%s is not a generic type" (expr-str xf)) (invalid f))
          (not= 1 (count ifs))
          (do (err! f :InvalidSyntaxTree "invalid operation: more than one index") (invalid f))
          :else (index-expr* cx f xf g (first ifs)))))))

(defn raw-expr
  "A raw form's open head h (the resolve mode)."
  [cx f h]
  (case h
    "go/select" (raw-select cx f)
    "go/index" (raw-index cx f)
    "go/star" (indirect cx f)
    "go/type-guard" (do (err! f :BadTypeKeyword "invalid syntax tree: use of .(type) outside type switch") (invalid f))
    "go/define" (do (err! f :InvalidSyntaxTree "invalid syntax tree: := outside a declaration") (invalid f))
    "go/literal" (do (err! f :InvalidConstVal "malformed constant: %s" (nth f 2)) (invalid f))))

;;; The expression dispatch

(defn expr-dispatch [cx f hint]
  (cond
    (nil? f) {:op :nil :mode :value :type :untyped-nil :form f}
    (or (symbol? f) (go-id? f)) (ident cx f)
    (seq? f)
    (let [h (head-name f)
          args (rest f)]
      (cond
        ;; the resolve mode: raw forms' open heads, and calls of a builtin's name (looked up)
        (and (:resolve cx-flags) h (raw-heads h)) (raw-expr cx f h)
        (and (:resolve cx-flags) h (raw-builtin-names h))
        (let [x (resolve-name cx h)]
          (if (and x (= :builtin (o x :kind)) (nil? (namespace (first f))))
            (do (e/answer! (first f) {:obj x :mode :builtin :type :invalid})
                (builtin-call cx f h args false))
            (call cx f (first f) args)))
        (nil? h)
        (if (and (symbol? (first f)) (namespace (first f)))
          ;; pkg/F args...: a call of a package member (or unsafe's builtins)
          (call cx f (first f) args)
          (call cx f (first f) args))
        (#{"+" "-"} h) (if (= 1 (count args)) (unary cx f h (first args)) (binary cx f h args))
        (#{"*" "/" "%" "bit-and" "bit-or" "bit-xor" "bit-and-not" "and" "or"} h)
        (if (and (= h "*") (= 1 (count args)))
          ;; a pointer type where an expression or a type may stand (new's operand)
          (let [T (typexpr cx f)] (if (t/valid? T) {:op :type :mode :typexpr :type T :form f} (invalid f)))
          (binary cx f h args))
        (#{"<<" ">>" "==" "!=" "<" "<=" ">" ">="} h)
        (if (not= 2 (count args))
          (do (err! f :InvalidSyntaxTree "%s takes two operands" h) (invalid f))
          (binary cx f h args))
        (#{"not" "bit-not"} h) (unary cx f h (first args))
        (= h "addr") (address-of cx f)
        (= h "deref") (indirect cx f)
        (= h "<!") (receive cx f)
        (= h "lit") (composite-lit cx f hint)
        (= h "conv") (let [T (typexpr cx (second f))
                           x (expr cx (nth f 2))]
                       (if (t/valid? T)
                         (do (e/verified! :conv f) (conversion cx f x T))
                         (invalid f)))
        (= h "assert") (type-assert cx f)
        (= h "aget") (index-expr cx f)
        (= h "subslice") (slice-expr cx f)
        (= h "fn") (func-lit cx f)
        (= h "method-expr") (method-expr cx f)
        (#{"rune" "imaginary" "byte-string"} h) (literal-form f h)
        (= h "go/call") (call cx f (second f) (nnext f))
        (= h "go/id") (ident cx f)
        (= h "inst") (inst-expr cx f)
        (= h "values") (do (err! f :InvalidSyntaxTree "unexpected list of expressions") (invalid f))
        (= h "spread") (do (err! f :InvalidDotDotDot "invalid use of ...") (invalid f))
        (= h "zero") (do (err! f :InvalidSyntaxTree "(zero T) outside a var declaration") (invalid f))
        (contains? #{"append" "cap" "clear" "close" "complex" "copy" "delete" "imag" "len" "make" "max" "min"
                     "new" "panic" "print" "println" "real" "recover"} h)
        (builtin-call cx f h args false)
        (str/starts-with? h ".-") (select-expr cx f (first args) (subs h 2) false)
        (and (str/starts-with? h ".") (> (count h) 1)) (method-call cx f (subs h 1) (first args) (rest args))
        (#{"slice" "array" "map" "chan" "func" "struct" "interface"} h)
        (let [T (typexpr cx f)] (if (t/valid? T) {:op :type :mode :typexpr :type T :form f} (invalid f)))
        :else (call cx f (first f) args)))
    (keyword? f) (do (err! f :InvalidSyntaxTree "a keyword in an expression: %s" f) (invalid f))
    (and (map? f) (contains? f ::node)) (::node f)
    (vector? f) (do (err! f :InvalidSyntaxTree "unexpected list of expressions") (invalid f))
    :else (or (literal f) (do (err! f :InvalidSyntaxTree "not an expression: %s" (pr-str f)) (invalid f)))))

(defn expr-internal
  "An expression, type or builtin of any mode; hint: the element type for an elided
  composite literal."
  [cx f hint]
  (with-line f
    (let [n (expr-dispatch cx f hint)
          n (if (and (map? n) (nil? (:form n))) (assoc n :form f) n)]
      ;; the resolve mode: what go/types records (not an invalid operand's)
      (when (and e/*answers* (not= :invalid (:mode n))) (e/answer! f {:mode (:mode n) :type (:type n) :val (:val n)}))
      (if (and (seq? f) (:tag (meta f)) (not= "lit" (head-name f)))
        (assoc n :tag-form f :tag-type (typexpr cx (:tag (meta f))))
        n))))

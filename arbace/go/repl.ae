(ns arbace.go.repl
  "goi's REPL state (doc/go/GOI-SPEC.md §2): interpreted Go packages as namespaces, their files
  and declarations, checking (arbace.go.check) against the table's digest and the other
  interpreted packages, defining their vars (functions, variables, constants, types and their
  generations), loading packages from ARBACE_PATH (the declarations queued, the package checked
  when its package file's load ends: S6), initialization, go/eval, and running a program in
  program mode (bin/goi run: arbace.go.run).

  A package's state is an atom {:path :name :ns :config :files [{:name :imports :decls}]
  :current (the REPL's file) :loading (the package file being loaded) :funcs {name *Func}
  :globals {name {:ptr :key}} :types {name {:gen :key :desc}} :checked (the last result)}."
  (:require [arbace.string :as str]
            [arbace.go.check :as ck]
            [arbace.go.check.env :as e]
            [arbace.go.check.types :as t]
            [arbace.go.check.const :as c]
            [arbace.go.check.code :as code]
            [arbace.go.check.load :as load]
            [arbace.go.build :as b]
            [arbace.repr.go.print :as rp])
  (:import (arbace.lang GoInterp GoFn GoVar GoType Namespace)
           (java.io File)))

;;; The table and the digest (§6)

(def ^:private listed (delay (set (GoInterp/paths))))

(defn listed?
  "Whether import path p is a package of the table of compiled packages (§6.6)."
  [p]
  (contains? @listed p))

(def ^:private digest-index
  (delay
    (when-let [^String s (GoInterp/digest)]
      (let [nl (.indexOf s "\n")]
        {:index (read-string (subs s 0 nl)) :text s :start (inc nl)}))))

(defn digest-forms
  "The digest's forms of listed package p (§6.5), read with line numbers, or nil."
  [p]
  (when-let [{:keys [index ^String text start]} @digest-index]
    (when-let [[a b] (get index p)]
      (ck/read-string-forms (subs text (+ start a) (+ start b))))))

(def config
  "The program's configuration (:goos, :goarch), as the digest's packages say it."
  (delay
    (let [fs (digest-forms "fmt")
          gp (first (filter #(and (seq? %) (= 'go/package (first %))) fs))
          cfg (:config (apply hash-map (nnext gp)))]
      (merge {:goos "linux" :goarch "amd64" :lang "go1.27"} cfg))))

(def ^:private digest-session
  "The checking session of the table's packages, read from the digest (one per process)."
  (delay
    (ck/session (fn [path importer]
                  (when (listed? path)
                    (when-let [fs (digest-forms path)]
                      (ck/forms-source fs @config)))))))

;;; Packages

(defonce ^{:doc "The interpreted packages by import path: atoms of their states."} packages (atom {}))

(defn path->ns
  "The namespace of import path p (SPEC.md §4.1)."
  [^String p]
  (symbol (load/path->ns p)))

(defn ns->path
  "The import path of a go.* namespace name (S2): the segments after go. joined by /."
  [ns-name]
  (str/join "/" (rest (str/split (str ns-name) #"\."))))

(defn- new-state [path nm ns-sym]
  (atom {:path path :name nm :ns ns-sym :config @config :files [] :current "repl.go"
         :funcs {} :globals {} :types {} :defined #{}}))

(defn package-state
  "The state of the package of namespace ns-sym, made implicitly (S2) for a go.* namespace."
  ([ns-sym] (package-state ns-sym true))
  ([ns-sym create?]
   (let [s (str ns-sym)]
     (when-not (str/starts-with? s "go.")
       (throw (ex-info (str "Go declarations belong in a go.* namespace (" s " is not one)") {:ns ns-sym})))
     (let [path (ns->path ns-sym)]
       (or (get @packages path)
           (when create?
             (when (listed? path)
               (throw (ex-info (str "the package " path " is a compiled package of the table: it cannot be interpreted (S1)") {:path path})))
             (let [st (new-state path (last (str/split path #"/")) ns-sym)]
               (swap! packages assoc path st)
               st)))))))

(defn package!
  "go/package: the namespace's package (its name, :path, :files ...); in a load, the load's start."
  [ns-sym nm opts]
  (let [opts (apply hash-map opts)
        path (or (:path opts) (ns->path ns-sym))
        st (or (get @packages path) (let [st (new-state path (str nm) ns-sym)] (swap! packages assoc path st) st))]
    (swap! st assoc :name (rp/name-text nm) :ns ns-sym :opts opts :package-path path
           :config (merge @config (:config opts) (when (:lang opts) {:lang (:lang opts)})))
    (when (:files opts)
      ;; a package file: the load of its files starts (§2.3), its declarations queued
      (swap! st assoc :loading true :files []))
    nil))

(defn- file-entry [st fname]
  (some #(when (= fname (:name %)) %) (:files @st)))

(defn- update-file [st fname f]
  (swap! st update :files
         (fn [fs]
           (if (some #(= fname (:name %)) fs)
             (mapv #(if (= fname (:name %)) (f %) %) fs)
             (conj fs (f {:name fname :opts {} :imports [] :decls []}))))))

(defn file!
  "go/file: the namespace's current file, its imports replaced (S5)."
  [ns-sym fname opts]
  (let [st (package-state ns-sym)]
    (update-file st fname #(assoc % :opts (dissoc opts :doc) :imports (vec (:imports opts))
                                  :decls (if (:loading @st) [] (:decls %))))
    (swap! st assoc :current fname)
    nil))

(defn import!
  "go/import at the REPL: import specs added to the current file (S5)."
  [ns-sym specs]
  (let [st (package-state ns-sym)]
    (when (:loading @st)
      (throw (ex-info "go/import in a package being loaded: a file's imports are its go/file's" {})))
    (update-file st (:current @st) (fn [fi] (update fi :imports #(vec (distinct (into (or % []) specs))))))
    nil))

;;; Declarations' names

(defn- decl-names
  "The package-level names a declaration form declares (methods: T.M)."
  [f]
  (let [h (code/head-name f)
        args (rest f)
        targets (fn [tf] (if (= "values" (code/head-name tf)) (rest tf) [tf]))
        group? (fn [args] (let [a (if (string? (first args)) (rest args) args)] (every? vector? a)))
        specs (fn [args] (vec (if (string? (first args)) (rest args) args)))]
    (case h
      "go/func" [(rp/name-text (second f))]
      "go/method" (let [more (drop 2 f)
                        more (if (string? (first more)) (rest more) more)
                        more (if (= :type-params (first more)) (drop 2 more) more)
                        rf (first (first more))
                        ty (if (and (symbol? rf) (:tag (meta rf))) (:tag (meta rf)) rf)
                        ty (if (and (seq? ty) (= '* (first ty))) (second ty) ty)
                        ty (if (seq? ty) (first ty) ty)]
                    [(str ty "." (rp/name-text (second f)))])
      ("go/var" "go/const") (if (group? args)
                              (vec (for [[tf] (specs args) x (targets tf)] (rp/name-text x)))
                              (vec (map rp/name-text (targets (first args)))))
      "go/type" (if (group? args)
                  (vec (for [[nf] (specs args)] (rp/name-text nf)))
                  [(rp/name-text (first args))])
      [])))

;;; Checking (§3)

(defn- error-text
  "Errors as go/types words them (§3.8): FILE:LINE: MESSAGE, at most ten; the REPL's implicit
  file is the forms' source (REPL for typed forms)."
  ([errs] (error-text errs nil))
  ([errs src]
   (str/join "\n" (for [er (take 10 errs)]
                    (str (if (and src (= "repl.go" (:file er))) src (:file er)) ":" (:line er) ": " (:msg er))))))

(defn- repl-source [] (let [f (str *file*)] (if (or (= f "NO_SOURCE_PATH") (= f "NO_SOURCE_FILE")) "REPL" f)))

(defn source-of
  "The checker's source of package state st (its files as they stand)."
  [st]
  (let [s @st]
    {:path (:path s) :name (:name s) :config (:config s) :opts (or (:opts s) {})
     :files (vec (for [fi (:files s)]
                   {:name (:name fi) :opts (assoc (:opts fi) :imports (:imports fi))
                    :imports (:imports fi) :decls (:decls fi)}))}))

(declare load-import)

(defn- session-for
  "A checking session for an interpreted package: listed imports from the digest, interpreted
  ones from their states (loaded from ARBACE_PATH when not yet: §2.3)."
  [extra-src]
  (assoc (ck/session (fn [path importer]
                       (or (when extra-src (extra-src path))
                           (when-let [st (load-import path)]
                             (source-of st)))))
         :delegate @digest-session
         :local (fn [path] (not (listed? path)))))

(defn check-source
  "Checks src: the package's result (with its trees), its errors included."
  [src extra-src]
  (let [s (session-for extra-src)
        pkg (ck/check-package src (#'ck/resolver s src []) :keep-trees true)]
    (e/o pkg :result)))

;;; Defining a checked package: cells, descriptors, vars

(defn- type-key
  "The structure of a type, its interpreted named types by name and generation (a named type's
  generation is new when this changes: §2.5)."
  [ty gen-of]
  (cond
    (keyword? ty) ty
    (t/named? ty) (let [i (t/info ty)] [:named (:pkg i) (:name i) (when (gen-of ty) (gen-of ty))])
    (t/tparam? ty) [:tparam (:name (t/info ty))]
    :else (case (nth ty 0)
            :struct [:struct (mapv #(-> % (update :type type-key gen-of) (dissoc :pkg)) (nth ty 1))]
            :interface [:interface (count (nth ty 1))]
            :func [:func (mapv #(type-key % gen-of) (nth ty 1)) (mapv #(type-key % gen-of) (nth ty 2)) (nth ty 3)]
            :tuple (into [:tuple] (map #(type-key % gen-of) (rest ty)))
            :array [:array (nth ty 1) (type-key (nth ty 2) gen-of)]
            :chan [:chan (nth ty 1) (type-key (nth ty 2) gen-of)]
            (into [(nth ty 0)] (map #(type-key % gen-of) (rest ty))))))

(defn- state-of-path [p] (get @packages p))

(defn method-name
  "Method object m's name as gc names it: T.M, or (*T).M for a pointer receiver."
  [m]
  (let [base (:name (t/info (e/o m :recv-named)))]
    (if (e/o m :ptr-recv) (str "(*" base ")." (e/o m :name)) (str base "." (e/o m :name)))))

(defn- display-file
  "The file a frame of a declaration of Go file fname shows in traces (§10.6): the Go file of
  converted forms, the forms' source for the REPL's implicit file (REPL at the REPL)."
  [fname]
  (if (or (nil? fname) (= "repl.go" fname)) (repl-source) fname))

(defn build-context
  "The builder's context for the package of state st."
  [st]
  {:path (:path @st) :name (:name @st)
   :source (let [ns (str (:ns @st))] (fn [fname] [ns (display-file fname)]))
   :compiled? listed?
   :types (java.util.HashMap.)
   :methods-done (java.util.IdentityHashMap.)
   :lit-count (atom 0)
   :gen (fn [nt]
          (let [i (t/info nt)]
            (or (when-let [ps (state-of-path (:pkg i))] (get-in @ps [:types (:name i) :gen])) 1)))
   :func-cell (fn [x]
                (let [ps (state-of-path (e/o x :pkg))]
                  (or (and ps (get-in @ps [:funcs (e/o x :name) :cell]))
                      (throw (ex-info (str "goi: no function " (e/o x :pkg) "." (e/o x :name)) {})))))
   :method-cell (fn [m]
                  (let [ps (state-of-path (e/o m :pkg))
                        k (method-name m)]
                    (or (and ps (get-in @ps [:methods k :cell]))
                        (throw (ex-info (str "goi: no method " (e/o m :pkg) "." k) {})))))
   :global (fn [x]
             (let [ps (state-of-path (e/o x :pkg))]
               (or (and ps (get-in @ps [:globals (e/o x :name)]))
                   (throw (ex-info (str "goi: no variable " (e/o x :pkg) "." (e/o x :name)) {})))))})

(defn- const-arbace
  "A constant's value as Arbace takes it (§5.6)."
  [ty v]
  (let [b (t/under ty)]
    (cond
      (boolean? v) v
      (string? v) (c/value-text v)
      (c/complex? v) (GoInterp/complex (c/to-double (nth v 1)) (c/to-double (nth v 2)))
      (and (keyword? b) (#{:float32 :untyped-float :float64} b)) (if (= :float32 b) (float (c/to-double v)) (c/to-double v))
      (integer? v) v
      :else (c/to-double v))))

(defn define!
  "Defines the checked package result r in state st: function cells (their code built on first
  call, S18, or now when eager), variables' cells, types' generations; with vars?, the
  namespace's vars (§2.1). Returns {:inits (the initializers' code in order, a *goi.Func) :init-funcs
  (init cells in order) :main (cell or nil) :new-vars (names of variables made anew)}."
  [st r {:keys [vars? eager only kept-names init-names]}]
  (let [ctx (assoc (build-context st) :eager eager)
        decls (:decl-infos r)
        old @st
        gen-of (fn [nt] (let [i (t/info nt)] (when (= (:pkg i) (:path old)) (get-in old [:types (:name i) :gen]))))
        unsupported (some #(when (or (:unsupported %) (:generic %)) %) decls)]
    ;; generic code is GR6's (§9): a declaration that uses generics is not run
    (when unsupported
      (let [what (str (or (:unsupported unsupported) "generics") " (GR6)")]
        (throw (ex-info (str "not supported by goi yet: " what) {:goi/unsupported what}))))
    (binding [b/*ctx* ctx t/*method-obj* b/method-data]
      ;; types: a new generation when the underlying type changed (§2.5)
      (let [type-decls (filter #(and (= :type (:kind %)) (not (e/o (:obj %) :alias))) decls)
            types (into {}
                        (for [d type-decls
                              :let [x (:obj d) nm (e/o x :name) nt (e/o x :type)
                                    k (type-key (t/under nt) gen-of)
                                    prev (get-in old [:types nm])]]
                          [nm {:key k :gen (cond (nil? prev) 1 (= k (:key prev)) (:gen prev) :else (inc (:gen prev)))}]))]
        (swap! st assoc :types types))
      ;; functions: a cell per name, kept while the signature is (G9)
      (let [funcs (filter #(and (= :func (:kind %)) (not (:method %)) (not= "init" (e/o (:obj %) :name))) decls)
            methods (filter #(and (= :func (:kind %)) (:method %)) decls)
            new-funcs (into {}
                            (for [d funcs
                                  :let [x (:obj d) nm (e/o x :name)
                                        k (type-key (e/o x :type) (:gen ctx))
                                        prev (get-in old [:funcs nm])
                                        cell (if (and prev (= k (:key prev))) (:cell prev) (b/op "FuncCell" nm (:name old) nil))]]
                              (if (and prev (contains? kept-names nm))
                                [nm (assoc prev :kept true)]
                                [nm {:cell cell :key k :tree (:tree d) :obj x}])))
            init-cells (vec (for [x (:inits r)]
                              (let [d (some #(when (identical? (:obj %) x) %) decls)]
                                {:cell (b/op "FuncCell" "init" (:name old) nil) :tree (:tree d) :obj x})))]
        (swap! st assoc :funcs new-funcs)
        ;; methods: a cell per T.M, kept while its signature is (G9)
        (let [new-methods (into {}
                                (for [d methods
                                      :let [m (:obj d)]
                                      :when (and (not= "_" (e/o m :name)) (e/o m :recv-named))
                                      :let [nm (method-name m)
                                            k (type-key (e/o m :type) (:gen ctx))
                                            prev (get-in old [:methods nm])
                                            cell (if (and prev (= k (:key prev))) (:cell prev) (b/op "FuncCell" nm (:name old) nil))]]
                                  [nm {:cell cell :key k :tree (:tree d) :obj m :generic (:generic d)}]))]
          (swap! st assoc :methods new-methods)
          ;; the functions' sources in traces (§10.6)
          (let [fsrc (fn [cell x] (let [[ns f] ((:source ctx) (when x (e/o x :file)))] (b/op "FuncSource" cell ns f)))]
            (doseq [[_ {:keys [cell obj kept]}] new-funcs :when (not kept)] (fsrc cell obj))
            (doseq [[_ {:keys [cell obj]}] new-methods] (fsrc cell obj))
            (doseq [{:keys [cell obj]} init-cells] (fsrc cell obj))))
        ;; variables: a cell per name, kept while its type is (S10)
        (let [var-objs (for [d decls :when (= :var (:kind d)) x (or (:lhs d) [(:obj d)]) :when (not= "_" (e/o x :name))] x)
              new-vars (volatile! [])
              globals (into {}
                            (for [x (distinct var-objs)
                                  :let [nm (e/o x :name)
                                        k (type-key (e/o x :type) (:gen ctx))
                                        prev (get-in old [:globals nm])]]
                              (if (and prev (= k (:key prev)))
                                [nm (assoc prev :obj x)]
                                (do (vswap! new-vars conj nm)
                                    [nm {:ptr (b/op "NewGlobal" (b/desc (e/o x :type))) :key k :obj x :type (e/o x :type)}]))))]
          (swap! st assoc :globals globals)
          ;; the functions' code: built on first call (S18), or now
          (doseq [[nm {:keys [cell tree kept]}] new-funcs
                  :when (not kept)
                  :when (or (nil? only) (contains? only nm))]
            (if eager
              (b/op "SetCode" cell (b/with-ctx ctx #(b/build-func tree)) nil)
              (b/op "SetCode" cell nil (fn [] (b/with-ctx ctx #(b/build-func tree))))))
          ;; the methods' code: as the functions'
          (doseq [[nm {:keys [cell tree generic]}] (:methods @st)
                  :when tree]
            (cond
              generic (b/op "SetCode" cell nil (fn [] (b/unsupported! "methods of generic types" "GR6")))
              eager (b/op "SetCode" cell (b/with-ctx ctx #(b/build-func tree)) nil)
              :else (b/op "SetCode" cell nil (fn [] (b/with-ctx ctx #(b/build-func tree))))))
          (doseq [{:keys [cell tree]} init-cells]
            (b/op "SetCode" cell (b/with-ctx ctx #(b/build-func tree)) nil))
          ;; the initializers (in initialization order)
          (let [var-trees (into {} (for [d decls :when (= :var (:kind d)) :when (= :var-init (:op (:tree d)))]
                                     [(first (:lhs (:tree d))) (:tree d)]))
                ordered (keep #(get var-trees (first %)) (:order r))
                inits (b/op "FuncCell" "init.vars" (:name old) nil)
                ordered (if-let [names (or init-names only)]
                          (filter #(some (fn [x] (contains? names (e/o x :name))) (:lhs %)) ordered)
                          ordered)]
            (b/op "SetCode" inits (b/build-inits ordered) nil)
            ;; the namespace's vars (§2.1)
            (when vars?
              (let [ns (create-ns (:ns old))]
                (doseq [[nm {:keys [cell obj]}] new-funcs
                        :let [spec (some #(when (identical? (:obj %) obj) (:spec %)) decls)
                              doc (when (and (seq? spec) (string? (nth spec 2 nil))) (nth spec 2))]]
                  (intern ns (with-meta (symbol nm) (cond-> {:go/kind :func :go/package (:path old) :line (e/o obj :line)
                                                             :file (e/o obj :file) :private (not (t/exported? nm))}
                                                      doc (assoc :doc doc)))
                          (GoFn. (b/op "InterpCallable" cell (b/desc (e/o obj :type)) (str (:path old) "." nm))
                                 (str (:path old) "." nm))))
                ;; methods: T.M, the receiver first (§2.1), (*T).M's var T.M too
                (doseq [[_ {:keys [cell obj generic]}] (:methods @st)
                        :when (not generic)
                        :let [vname (str (:name (t/info (e/o obj :recv-named))) "." (e/o obj :name))
                              full (str (:path old) "." vname)
                              c (try (b/method-callable obj cell full)
                                     (catch Exception ex (when-not (:goi/unsupported (ex-data ex)) (throw ex))))]
                        :when c]
                  (intern ns (with-meta (symbol vname) {:go/kind :method :go/package (:path old) :line (e/o obj :line)
                                                        :file (e/o obj :file)
                                                        :private (not (and (t/exported? (e/o obj :name))
                                                                           (t/exported? (:name (t/info (e/o obj :recv-named))))))})
                          (GoFn. c full)))
                (doseq [[nm {:keys [ptr obj]}] globals]
                  (intern ns (with-meta (symbol nm) {:go/kind :var :go/package (:path old) :private (not (t/exported? nm))})
                          (GoVar. (b/op "GlobalPtr" (b/desc (e/o obj :type)) ptr) (str (:path old) "." nm))))
                (doseq [d decls :when (= :const (:kind d))
                        :let [x (:obj d)] :when (not= "_" (e/o x :name))
                        :when (t/valid? (e/o x :type))]
                  (intern ns (with-meta (symbol (e/o x :name)) {:go/kind :const :go/package (:path old)
                                                                 :private (not (t/exported? (e/o x :name)))})
                          (const-arbace (e/o x :type) (e/o x :val))))
                (doseq [d decls :when (= :type (:kind d))
                        :let [x (:obj d)] :when (not (e/o x :tparams-count))]
                  (try
                    (intern ns (with-meta (symbol (e/o x :name)) {:go/kind :type :go/package (:path old)
                                                                   :private (not (t/exported? (e/o x :name)))})
                            (GoType. (b/desc (e/o x :type))))
                    (catch Exception _ nil)))))
            (swap! st assoc :checked r)
            {:inits inits
             :init-funcs (mapv :cell init-cells)
             :main (when (= "main" (:name old)) (get-in new-funcs ["main" :cell]))
             :new-vars @new-vars}))))))

;;; Loading packages (§2.3)

(defn call0
  "Calls function cell f of no parameters and no results from Arbace (a panic: a GoPanic)."
  [f ^String nm]
  (GoInterp/call (b/op "InterpCallable" f (b/op "TFunc" (object-array []) (object-array []) false) nm)
                 (object-array [])))

(defn- complete!
  "Completes package state st after its load: checked whole (a CompilerException-like error
  listing every error), defined, initialized (§2.6)."
  [st]
  (swap! st dissoc :loading)
  (let [r (check-source (source-of st) nil)]
    (when (seq (:errors r))
      (throw (ex-info (str "Go check errors in package " (:path @st) ":\n" (error-text (:errors r)))
                      {:go/errors (:errors r)})))
    (let [{:keys [inits init-funcs]} (define! st r {:vars? true})]
      (call0 inits "init")
      (doseq [f init-funcs]
        (call0 f "init"))
      st)))

(defn after-load
  "arbace.core/load's hook (§2.3, S6): the load of a resource (path, as load names it) ended
  (ok: normally); a package whose package file it was is completed (a failed load forgets it)."
  [^String path ok]
  (let [p (if (str/starts-with? path "/") (subs path 1) path)]
    (when (str/starts-with? p "go/")
      (let [ns-name (str/replace (str/replace p "/" ".") "_" "-")]
        (doseq [[path st] @packages]
          (when (and (:loading @st) (= (str (:ns @st)) ns-name))
            (if ok
              (complete! st)
              (swap! packages dissoc path))))))))

(defonce ^:private hook-registered
  (do (swap! arbace.lang.RT/AFTER_LOAD conj #'after-load) true))

(defn load-import
  "The state of interpreted package path, loaded from ARBACE_PATH (its namespace) when it is
  not yet (§2.3), or nil."
  [path]
  (or (when-let [st (get @packages path)] (when-not (:loading @st) st))
      (when-not (listed? path)
        (let [ns-sym (path->ns path)]
          (try
            (require ns-sym)
            (catch java.io.FileNotFoundException _ nil))
          (when-let [st (get @packages path)]
            (when-not (:loading @st) st))))))

;;; Declaring at the REPL (§2.5)

(defn declare!
  "A declaration macro's form (go/func, go/var ...): queued in a load, else checked against the
  package and defined at once (§2.5); returns the var of its first name."
  [form {:keys [ns line]}]
  (let [ns-sym (or ns (ns-name *ns*))
        st (package-state ns-sym)]
    (if (:loading @st)
      (do (update-file st (:current @st) #(update % :decls conj form)) nil)
      (let [names (set (decl-names form))
            old @st
            ;; the declaration replaces the package's declarations of its names
            files (vec (for [fi (:files old)]
                         (update fi :decls (fn [ds] (vec (remove #(some names (decl-names %)) ds))))))
            files (if (some #(= (:current old) (:name %)) files)
                    files
                    (conj files {:name (:current old) :opts {} :imports [] :decls []}))
            files (mapv #(if (= (:current old) (:name %)) (update % :decls conj form) %) files)
            _ (swap! st assoc :files files)
            r (try (check-source (source-of st) nil)
                   (catch Throwable ex (swap! st assoc :files (:files old)) (throw ex)))
            errs (remove #(= :UnusedImport (:code %)) (:errors r))
            ;; the new declaration's own errors reject it; a dependent's (§2.5 item 6) leave the
            ;; dependent its old definition, with a warning
            spec-of (into {} (map (juxt :id :spec) (:decl-infos r)))
            own? (fn [er] (or (nil? (:decl er)) (identical? form (spec-of (:decl er)))))
            own (filter own? errs)
            others (remove own? errs)
            broken (set (mapcat decl-names (distinct (keep #(spec-of (:decl %)) others))))]
        (when (seq own)
          (swap! st assoc :files (:files old))
          (throw (ex-info (str "Go check errors:\n" (error-text own (repl-source))) {:go/errors (vec own)})))
        (when (seq others)
          (binding [*out* *err*]
            (println (str "goi: warning: " (str/join ", " (sort broken))
                          " no longer check and keep their definitions:\n" (error-text others (repl-source))))))
        (let [var? (= "go/var" (code/head-name form))
              {:keys [inits new-vars init-funcs]} (try (define! st r {:vars? true :kept-names broken
                                                                      :init-names (when var? names)})
                                                       (catch Throwable ex (swap! st assoc :files (:files old)) (throw ex)))]
          ;; a variable defined anew is initialized now, an init runs now (S11)
          ;; a variable defined (again) runs its initializer now (S10, S11)
          (when var?
            (call0 inits "init"))
          (when (and (= "go/func" (code/head-name form)) (= "init" (rp/name-text (second form))))
            (call0 (last init-funcs) "init"))
          (when-let [nm (first (decl-names form))]
            (find-var (symbol (str (:ns old)) nm))))))))

;;; go/eval (§2.4)

(def ^:private eval-count (atom 0))

(defn eval!
  "go/eval: Go statements run as the body of a function of the namespace's package (go.user
  outside go.*: S3); the last statement's value as Arbace's (§5.6)."
  [stmts {:keys [ns]}]
  (let [ns-sym (or ns (ns-name *ns*))
        ns-sym (if (str/starts-with? (str ns-sym) "go.") ns-sym 'go.user)
        st (package-state ns-sym)
        nm (str "goi_eval" (swap! eval-count inc))
        ;; the last statement, looking through let bodies (the implicit return's rule: SPEC §6.4)
        last-f (loop [f (last stmts)]
                 (if (and (seq? f) (#{"let" "let-type"} (code/head-name f)) (> (count f) 2))
                   (recur (last f))
                   f))
        stmt? (and (seq? last-f) (contains? code/statement-heads (code/head-name last-f)))
        attempt (fn [results]
                  (let [form (apply list 'go/func (symbol nm) (concat (cond
                                                                       (nil? results) [[]]
                                                                       (= 1 results) [(with-meta [] {:tag 'any})]
                                                                       :else [[] :results (vec (repeat results 'any))])
                                                                     stmts))
                        old @st
                        files (mapv #(if (= (:current old) (:name %)) (update % :decls conj form) %)
                                    (if (some #(= (:current old) (:name %)) (:files old))
                                      (:files old)
                                      (conj (:files old) {:name (:current old) :opts {} :imports [] :decls []})))]
                    (swap! st assoc :files files)
                    (try
                      (let [r (check-source (source-of st) nil)]
                        [r form])
                      (finally (swap! st assoc :files (:files old))))))
        [r form] (if stmt? (attempt nil) (attempt 1))
        multi (some #(when (and (= :TooManyValues (:code %)) (str/includes? (:msg %) "multiple-value")) %) (:errors r))
        novalue (some #(when (str/includes? (:msg %) "(no value) used as value") %) (:errors r))
        [r form] (cond
                   multi (let [[_ ts] (re-find #"value of type \(([^)]*)\)" (:msg multi))]
                           (attempt (count (str/split ts #","))))
                   novalue (attempt nil)
                   :else [r form])
        errs (remove #(= :UnusedImport (:code %)) (:errors r))]
    (when (seq errs)
      (throw (ex-info (str "Go check errors:\n" (error-text errs (repl-source))) {:go/errors (vec errs)})))
    (let [old @st]
      (swap! st assoc :files (mapv #(if (= (:current old) (:name %)) (update % :decls conj form) %) (:files old)))
      (try
        (define! st r {:vars? false :only #{nm}})
        (let [{:keys [cell obj]} (get-in @st [:funcs nm])]
          (GoInterp/call (b/op "InterpCallable" cell (binding [b/*ctx* (build-context st)] (b/desc (e/o obj :type))) nm)
                         (object-array [])))
        (finally
          (swap! st assoc :files (:files old))
          (swap! st update :funcs dissoc nm))))))

(defn run-main!
  "go/run-main: package ns-sym's main (program mode's exit semantics in the REPL's process: §2.6)."
  [ns-sym]
  (let [st (package-state ns-sym false)
        cell (get-in @st [:funcs "main" :cell])]
    (when-not cell
      (throw (ex-info (str ns-sym " has no main") {})))
    (call0 cell "main")
    nil))

(defn check!
  "go/check: the package's errors, checked again (data), nothing defined."
  [ns-sym]
  (let [st (package-state ns-sym false)]
    (:errors (check-source (source-of st) nil))))

;;; go/run-compiled (G15)

(defn- form-text
  "Form f as readable text with its metadata (the forms root build/go reads)."
  [f]
  (binding [*print-meta* true *print-length* nil *print-level* nil *print-namespace-maps* false]
    (pr-str f)))

(defn- write-package!
  "Writes package state st as a forms root's package file and its files under dir (SPEC.md §4.1)."
  [^File dir st]
  (let [s @st
        path (:path s)
        ns-sym (symbol (load/path->ns path))
        segs (str/split path #"/")
        stems (vec (for [fi (:files s)] (str/replace (:name fi) #"\.go$" "")))
        pf (File. dir (str "go/" (str/join "/" segs) ".ae"))
        fdir (last segs)
        opts (dissoc (or (:opts s) {}) :files :path)]
    (.mkdirs (.getParentFile pf))
    (spit pf (str (form-text (list 'ns ns-sym '(:require [arbace.go :as go]))) "\n"
                  (form-text (apply list 'go/package (symbol (:name s)) :path path
                                    :files (vec (map :name (:files s)))
                                    (mapcat identity opts))) "\n"
                  (str/join "\n" (for [st stems] (form-text (list 'load (str fdir "/" st))))) "\n"))
    (doseq [[fi stem] (map vector (:files s) stems)]
      (let [f (File. (.getParentFile pf) (str fdir "/" stem ".ae"))]
        (.mkdirs (.getParentFile f))
        (spit f (str (form-text (list 'in-ns (list 'quote ns-sym))) "\n"
                     (form-text (apply list 'go/file (:name fi) (mapcat identity (assoc (or (:opts fi) {}) :imports (vec (:imports fi))))))
                     "\n\n"
                     (str/join "\n\n" (map form-text (:decls fi))) "\n"))))))

(defn- interpreted-closure
  "Package state st and the interpreted packages it imports, transitively."
  [st]
  (loop [todo [st] seen #{} out []]
    (if-let [s (first todo)]
      (if (contains? seen (:path @s))
        (recur (rest todo) seen out)
        (let [imps (for [fi (:files @s) [_ p] (:imports fi)
                         :when (and (string? p) (not (listed? p)))
                         :let [is (get @packages p)] :when is] is)]
          (recur (concat (rest todo) imps) (conj seen (:path @s)) (conj out s))))
      out)))

(defn run-compiled!
  "go/run-compiled: package ns-sym's program (it and the interpreted packages it imports) as
  Go forms, printed by repr/go and built by build/go (arbace.build.go) with the toolchain of
  ARBACE_GOROOT (default /root/tamago-go), run with args as a child process (G15):
  {:out :err :exit}; a build that fails throws its status."
  [ns-sym args]
  (let [st (package-state ns-sym false)]
    (when-not st
      (throw (ex-info (str ns-sym " is not an interpreted Go package") {:ns ns-sym})))
    (let [tmp (.toFile (java.nio.file.Files/createTempDirectory "goi-run-compiled" (make-array java.nio.file.attribute.FileAttribute 0)))
          src (File. tmp "src")
          out (File. tmp "prog")
          goroot (or (System/getenv "ARBACE_GOROOT") "/root/tamago-go")
          build (requiring-resolve 'arbace.build.go/build)
          sh (requiring-resolve 'arbace.java.shell/sh)]
      (try
        (doseq [s (interpreted-closure st)]
          (write-package! src s))
        (let [status (build src (:goarch @config "amd64") out {:goroot goroot :work (File. tmp "work")})]
          (when-not (= 0 status)
            (throw (ex-info (str "go/run-compiled: go build of " ns-sym " failed (status " status ")") {:go/status status})))
          (let [r (apply sh (.getPath out) (map str args))]
            {:out (:out r) :err (:err r) :exit (:exit r)}))
        (finally
          (doseq [^File f (reverse (file-seq tmp))] (.delete f)))))))

(ns arbace.go.run
  "bin/goi run ROOT NS [ARG...] (doc/go/GOI-SPEC.md §2.7, §11): an interpreted Go program in
  program mode. The package of namespace NS is read from the forms root ROOT (its package file
  ROOT/go/....ae), checked against the table's digest, built eagerly (so that the builder's
  errors show before anything runs), initialized and run: os.Exit exits, an uncaught panic is
  reported as gc reports it (status 2), os.Args is NS and the arguments.

  What goi cannot run (§11.3) ends the run before it starts, on standard error:
  goi: unsupported: REASON, status 125 (a form of a later milestone, an import neither listed in
  the table nor interpreted); goi: error: MESSAGE, status 126 (a check error or a builder's
  failure: goi's bug on a valid program)."
  (:require [arbace.string :as str]
            [arbace.go.repl :as repl]
            [arbace.go.check.load :as load]
            [arbace.go.check.env :as env]
            [arbace.go.check.code :as code]
            [arbace.go.build :as b])
  (:import (arbace.lang GoInterp)
           (java.io File)))

(defn- fail [status ^String kind ^String msg]
  (binding [*out* *err*]
    (println (str "goi: " kind ": " (first (str/split-lines (str msg)))))
    (flush))
  (System/exit status))

(defn- package-file? [^File f]
  (and (.isFile f) (str/ends-with? (.getName f) ".ae")
       (with-open [r (java.io.BufferedReader. (java.io.FileReader. f))]
         (let [l (first (remove #(or (str/blank? %) (str/starts-with? % ";")) (line-seq r)))]
           (boolean (and l (str/starts-with? l "(ns ")))))))

(defn- dir-test-root
  "The directory of a directory test's packages (GOI-SPEC.md §11.2) that package file pf belongs
  to: its nearest ancestor named *_dir, or its sibling STEM_dir for STEM_dir.ae; else nil."
  ^File [^File pf]
  (let [n (.getName pf)
        sib (File. (.getParentFile pf) (str/replace n #"\.ae$" ""))]
    (if (and (str/ends-with? n "_dir.ae") (.isDirectory sib))
      sib
      (loop [d (.getParentFile pf)]
        (cond
          (nil? d) nil
          (str/ends-with? (.getName d) "_dir") d
          :else (recur (.getParentFile d)))))))

(defn- dir-test-index
  "The packages of a directory test: import path -> package file (pf's own and those under its
  test's directory)."
  [^File pf]
  (if-let [d (dir-test-root pf)]
    (into {}
          (for [^File f (cons pf (file-seq d))
                :when (package-file? f)
                :let [p (load/package-path-of f)]
                :when p]
            [p f]))
    {}))

(defn- no-assembly! [src]
  (when-let [s (some #(when (str/ends-with? (str %) ".s") %) (get-in src [:opts :other-files]))]
    (fail 125 "unsupported" (str "assembly (" (:path src) ": " s "): out of scope (§1.1)"))))

(defn- no-linkname! [src]
  (doseq [fi (:files src) d (:decls fi)
          x (tree-seq coll? seq d)
          :when (and (instance? arbace.lang.IObj x) (:go/linkname (meta x)))]
    (fail 125 "unsupported" (str "go:linkname (" (:path src) ": " (:go/linkname (meta x)) "): out of scope (§1.1)"))))

(defn- check! [src extra]
  (no-assembly! src)
  (no-linkname! src)
  (let [r (repl/check-source src extra)
        errs (:errors r)]
    (when-let [bi (some #(when (= :BrokenImport (:code %)) %) errs)]
      (fail 125 "unsupported" (str "an import neither in the table nor interpreted: " (:msg bi))))
    (when (seq errs)
      (fail 126 "error" (str "check: " (:path src) ": " (:file (first errs)) ":" (:line (first errs)) ": " (:msg (first errs)))))
    r))

(defn- imports-of
  "The import paths package source src names (its local imports resolved)."
  [src]
  (let [li (get-in src [:opts :local-imports])]
    (distinct
      (for [fi (:files src)
            spec (get-in fi [:opts :imports])
            :let [p (if (vector? spec) (second spec) spec)]
            :when (string? p)]
        (get li p p)))))

(declare full-forms? full-lines)

(defn run
  "Runs the program of package file pf (forms root root) with args: its exit status. The
  interpreted packages it imports (a directory test's) are checked, defined and initialized
  first, in dependency order."
  [root ^File pf args]
  (reset! b/program-mode true)
  ;; os.Args, and goi's program mode from now on (its warnings at the REPL only)
  (b/op "SetOSArgs" (object-array (cons (str (.getName pf)) args)))
  (let [src (cond-> (load/package-source {:dir root} nil @repl/config pf)
              (full-forms? root pf) (full-lines true))
        _ (when (empty? (:files src)) (fail 125 "unsupported" "no Go files for the configuration"))
        index (delay (dir-test-index pf))
        srcs (atom {})
        inits (volatile! {})
        deps (volatile! {})
        extra (fn [path] (get @srcs path))
        define (fn [src r]
                 (let [st (atom {:path (:path src) :name (:name src) :ns (symbol (str "goi.run." (:name src))) :config (:config src)
                                 :opts (:opts src) :pf (:pf src) :files (vec (:files src)) :funcs {} :globals {} :types {}})]
                   (swap! repl/packages assoc (:path src) st)
                   (let [d (try (repl/define! st r {:vars? false :eager true})
                                ;; go:embed's errors (GS14): the program's, as a check's
                                (catch arbace.lang.ExceptionInfo ex
                                  (if-let [er (first (:go/errors (ex-data ex)))]
                                    (fail 126 "error" (str "check: " (:path src) ": " (:file er) ":" (:line er) ": " (:msg er)))
                                    (throw ex))))]
                     (vswap! inits assoc (:path src) (cons (:inits d) (:init-funcs d)))
                     (vswap! deps assoc (:path src) (set (filter #(contains? @srcs %) (imports-of src))))
                     d)))
        ;; Go's order (go1.21): the first package by import path whose imports are initialized
        init-order (fn []
                     (loop [done [] left (set (keys @inits))]
                       (if (empty? left)
                         done
                         (let [p (first (sort (filter #(every? (set done) (get @deps %)) left)))]
                           (recur (conj done (or p (first (sort left)))) (disj left (or p (first (sort left)))))))))]
    ;; the interpreted imports: each loaded once, its own imports first
    (letfn [(load! [path seen]
              (when-not (or (contains? @srcs path) (repl/listed? path) (contains? seen path))
                (when-let [^File f (get @index path)]
                  (let [s (cond-> (load/package-source {:dir root} path @repl/config f)
                            (full-forms? root f) (full-lines true))]
                    (doseq [p (imports-of s)] (load! p (conj seen path)))
                    (when-not (contains? @srcs path)
                      (let [r (check! s extra)]
                        (swap! srcs assoc path s)
                        (define s r)))))))]
      (doseq [p (imports-of src)] (load! p #{(:path src)})))
    (let [r (check! src extra)
          _ (swap! srcs assoc (:path src) src)
          {:keys [main]} (define src r)]
      (when-not main
        (fail 126 "error" "no main function"))
      (b/op "RunProgram" (object-array (mapcat @inits (init-order))) main))))

(def ^:private ^:dynamic *pos-key*
  "A function from a raw position [line col] to the :line value a form takes (key-lines'
  keys), or nil: the line."
  nil)

(defn- raw-lines
  "Form x of raw forms read from text, the lines mode :lines writes from the positions mode
  :full writes (doc/go/SPEC.md §10.2), as the converter's in-memory forms carry them: each
  form's :line its node's first line (its :go/pos' least; a vector's its children's), not the
  reader's (a vector's, a symbol's, a list's written after its line); a function's :go/end its
  closing brace's line; a literal child's line its :go/breaks entry, from :go/apos. Each form
  given a line also keeps its first position as :go/raw [line col]; with *pos-key*, the :line
  values are its keys of the positions."
  [x]
  (let [walk-meta (fn [m] (cond-> m (contains? m :tag) (update :tag raw-lines)))
        x' (cond
             (seq? x) (with-meta (apply list (map raw-lines x)) (some-> (meta x) walk-meta))
             (vector? x) (with-meta (mapv raw-lines x) (some-> (meta x) walk-meta))
             (map? x) (with-meta (into {} (map (fn [[k v]] [(raw-lines k) (raw-lines v)])) x) (some-> (meta x) walk-meta))
             (symbol? x) (with-meta x (some-> (meta x) walk-meta))
             :else x)
        m (when (instance? arbace.lang.IObj x') (meta x'))
        pos (:go/pos m)
        ;; (not a comment group's: a node's :doc and :comment); a vector's from its literals and
        ;; children first (a spec's :go/pos may hold its declaration's: an import group's
        ;; first spec, the group's import keyword and parentheses)
        least (fn [ps] (some->> ps (filter #(and (vector? %) (number? (first %)))) seq
                                (reduce (fn [a b] (if (neg? (compare (vec (take 2 b)) (vec (take 2 a)))) b a)))))
        p (or (when (vector? x')
                (least (concat (vals (:go/apos m))
                               (keep #(when (instance? arbace.lang.IMeta %) (:go/raw (meta %))) x'))))
              (when (map? pos) (least (vals (apply dissoc pos [:doc :comment])))))
        pk (or *pos-key* first)
        ;; a function's closing brace (mode :lines' :go/end), a literal child's line (its
        ;; :go/breaks, from :go/apos)
        end (when (map? pos) (when-let [r (:rbrace pos)] (when (vector? r) (pk r))))
        apos (:go/apos m)]
    (if (or p end (seq apos))
      (vary-meta x' (fn [m] (cond-> m
                              p (assoc :line (pk p) :go/raw p)
                              end (assoc :go/end end)
                              (seq apos) (assoc :go/breaks (vec (for [[i q] (sort apos) :when (vector? q)] [i (pk q)]))))))
      x')))

(defn- directives
  "gc's line directives of a Go file from its comments (mode :full's go/file :go/comments, [line
  col text] each; cmd/compile/internal/syntax's updateBase): [line col file base] each, from
  position [line col] on line base + (l - line) of file (nil: the Go file itself; \"\": ??), in
  order. A //line comment at a line's start begins at the next line; a /*line comment right
  after it; FILE:LINE:COL with an empty FILE keeps the file before."
  [comments]
  (loop [cs (sort-by #(vec (take 2 %)) comments) prev nil acc []]
    (if-let [[l c ^String t] (first cs)]
      (let [[body from] (cond
                          (and (= 1 (long c)) (str/starts-with? t "//line ")) [(subs t 7) [(inc (long l)) 1]]
                          (and (str/starts-with? t "/*line ") (str/ends-with? t "*/"))
                          [(subs t 7 (- (count t) 2)) [l (+ (long c) (count t))]]
                          :else nil)
            d (when body
                (or (when-let [[_ f n _c] (re-find #"^(.*):([0-9]+):([0-9]+)$" body)]
                      [(if (= "" f) prev f) (Long/parseLong n)])
                    (when-let [[_ f n] (re-find #"^(.*):([0-9]+)$" body)]
                      [f (Long/parseLong n)])))]
        (if (and d (pos? (long (second d))))
          (recur (rest cs) (first d) (conj acc [(first from) (second from) (first d) (second d)]))
          (recur (rest cs) prev acc)))
      acc)))

(defn- key-lines
  "File entry fi of mode :full's forms whose Go file has /*line directives (positions within a
  line, which a frame's line alone cannot follow): its forms' lines made keys of their raw
  positions (line × 1000 + column), and :line-keys, a //line directive for each key used (its
  line the key less one), which gives the key gc's file and line (the builder's line-dirs!,
  the back end's CodeLineDirs: GOI-SPEC.md, \"Since v1: frames\"); else fi as raw-lines makes it."
  [fi]
  (let [cs (:go/comments (meta (:file fi)))
        ds (when (some #(str/starts-with? (str (nth % 2)) "/*line ") cs) (directives cs))]
    (if (empty? ds)
      (cond-> (update fi :decls (fn [d] (mapv raw-lines d)))
        (:file fi) (update :file raw-lines)
        (get-in fi [:opts :imports]) (update-in [:opts :imports] raw-lines))
      (let [used (java.util.TreeMap.)
            pk (fn [[l c]]
                 (let [k (+ (* 1000 (long l)) (min 999 (long c)))]
                   (when-not (.containsKey used k)
                     (let [d (last (filter (fn [[dl dc]] (neg? (compare [(long dl) (long dc)] [(long l) (long (inc c))]))) ds))
                           [f n] (if d [(nth d 2) (+ (long (nth d 3)) (- (long l) (long (first d))))] [nil l])]
                       (.put used k [(if (nil? f) (:name fi) f) n])))
                   k))
            fi (binding [*pos-key* pk]
                 (cond-> (update fi :decls (fn [d] (mapv raw-lines d)))
                   (:file fi) (update :file raw-lines)
                   (get-in fi [:opts :imports]) (update-in [:opts :imports] raw-lines)))]
        (assoc fi :line-keys (vec (for [[k [f n]] used] {:line (dec (long k)) :text (str "//line " f ":" n)})))))))

(defn- full-forms?
  "Whether the package file pf (forms root root) is of mode :full (its go/package's :positions)."
  [root ^File pf]
  (boolean (re-find #":positions :full" (slurp pf))))

(defn full-lines
  "Package source src of mode :full's forms (or raw forms), each form given the lines mode
  :lines writes (raw-lines), its :go/ metadata kept for the checker's columns and spellings.
  keys: a program's run, whose files with /*line directives take key-lines' keys."
  ([src] (full-lines src false))
  ([src keys]
   (update src :files (fn [fs] (mapv #(if keys
                                        (key-lines %)
                                        (cond-> (update % :decls (fn [ds] (mapv raw-lines ds)))
                                          (:file %) (update :file raw-lines)
                                          (get-in % [:opts :imports]) (update-in [:opts :imports] raw-lines)))
                                     fs)))))

(defn- line-map
  "gc's line directives of the Go file at path (cmd/compile/internal/syntax's updateBase): a
  comment //line FILE:LINE or //line FILE:LINE:COL at a line's start makes the next line LINE of
  FILE; a comment /*line FILE:LINE[:COL]*/ anywhere makes the position right after it LINE of
  FILE (an empty FILE: \"\", or with COL the file before; a relative FILE joined to the source's
  directory as gc does, which the judge's base name matching takes alike, so written as given).
  A function of [file line col] (the checker's position; col nil when unknown: before any
  directive of its line) to gc's [file line]; nil when the file has no line directive."
  [^String path]
  (let [text (slurp path)]
    (when (or (str/includes? text "//line ") (str/includes? text "/*line "))
      (let [ls (vec (str/split-lines text))
            ;; [end-line end-col file base]: from position [end-line end-col] on, line base + (l - end-line) of file
            ds (loop [i 0 prev nil acc []]
                 (if (= i (count ls))
                   acc
                   (let [l (nth ls i)
                         parse (fn [text]
                                 (or (when-let [[_ f n _c] (re-find #"^(.*):([0-9]+):([0-9]+)$" text)]
                                       [(if (= "" f) prev f) (Long/parseLong n)])
                                     (when-let [[_ f n] (re-find #"^(.*):([0-9]+)$" text)]
                                       [f (Long/parseLong n)])))
                         ;; the line's directives in order: [end-line end-col file base]
                         found (concat
                                 (when (str/starts-with? l "//line ")
                                   (when-let [d (parse (subs l 7))] [[(+ i 2) 1 d]]))
                                 (when-not (str/starts-with? l "//")
                                   (for [m (re-seq #"/\*line ([^*]*)\*/" l)
                                         :let [d (parse (second m))]
                                         :when d]
                                     [(inc i) (+ 1 (.indexOf ^String l ^String (first m)) (count (first m))) d])))
                         [acc prev] (reduce (fn [[acc prev] [el ec [f n]]]
                                              (if (pos? (long n)) [(conj acc [el ec f n]) f] [acc prev]))
                                            [acc prev] found)]
                     (recur (inc i) prev acc))))]
        (when (seq ds)
          (fn [file ^long line col]
            (let [c (long (or col 0))]
              (if-let [[el _ f n] (last (filter (fn [[el ec]] (or (> line (long el)) (and (= line (long el)) (>= c (long ec))))) ds))]
                [(or f file) (+ (long n) (- line (long el)))]
                [file line]))))))))

(defn errorcheck
  "Checks the package of package file pf (forms root root) without running it (GR7b, the
  errorcheck programs of §11): its errors on standard output as gc prints them with -C, one
  FILE:LINE: MESSAGE each (a message's further lines indented by a tab), in the checker's
  order; the status 1 when there are errors, else 0. What goi cannot check ends it as a run's:
  goi: unsupported (125), goi: error (126). max-errors (gc without -e: 10, GR10): the first
  max-errors printed, then gc's FILE:LINE: too many errors at the last one's position. raw:
  the forms are repr/go's raw forms of an invalid program (doc/go/CONVERTER-NOTES.md, \"Raw
  forms\"; doc/go/GO-PARSER-SURVEY.md GP6, GPS9 (b)), checked in the checker's resolve mode
  (GOI-SPEC.md §3.10), its answers dropped. front: the Go file the forms are of, whose errors of
  gc's front end beside its type checker come from gc's syntax and noder's port
  (arbace.repr.go.syntax, doc/go/GO-PARSER-SURVEY.md GPS39 (b), GPS41 (c)): the parse's (its
  branch checks, noder's pragmas') in place of the checker's own branch errors (types2's
  IgnoreBranchErrors), merged by position; when there are none and the checker reports none,
  the declarations' checks of noder's writer (decl-errors), and when there are none of those,
  gc's checks of its types' sizes (arbace.go.check.code/size-errors)."
  [root ^File pf lang max-errors raw front]
  (let [src (cond-> (load/package-source {:dir root} nil @repl/config pf)
              lang (assoc-in [:config :lang] lang)
              (or raw (full-forms? root pf)) full-lines
              raw (assoc :answers (java.util.HashMap.)))
        _ (when (empty? (:files src)) (fail 125 "unsupported" "no Go files for the configuration"))
        _ (no-assembly! src)
        ;; the types written, for gc's size checks after the declarations' (front)
        sizes (when front (atom []))
        r (binding [env/*sizes* sizes] (repl/check-source src (fn [_] nil) false))
        errs (:errors r)]
    (when-let [bi (some #(when (= :BrokenImport (:code %)) %) errs)]
      (fail 125 "unsupported" (str "an import neither in the table nor interpreted: " (:msg bi))))
    (when-let [u (some #(when-let [u (:unsupported %)] [(:file %) u]) (:decl-infos r))]
      (fail 125 "unsupported" (str "a declaration goi's checker does not check (" (:name (first u)) "): " (second u))))
    ;; as gc prints them (base.FlushErrors): sorted by position (the checker's are, by file and
    ;; line), an error equal to the one before it printed once; the converter's annotations are
    ;; go/types' over an invalid program, their disagreements not the program's errors
    (let [errs (cond->> (remove #(= :AnnotationMismatch (:code %)) errs)
                 front (remove #(= :BranchError (:code %))))
          ;; gc's noder: a language version error names the version's origin
          file-lang (into {} (for [fi (:files src)] [(:name fi) (get-in fi [:opts :lang])]))
          vmsg (fn [e]
                 (let [m (:msg e)]
                   (if (re-find #"requires go[0-9]+\.[0-9]+ or later" m)
                     (if-let [fl (file-lang (:file e))]
                       (str m " (file declares //go:build " fl ")")
                       (str m " (-lang was set to " (or lang (get-in src [:config :lang])) "; check go.mod)"))
                     m)))
          ;; gc's positions follow the file's //line directives (front: the Go file; gc's syntax's
          ;; errors follow them already)
          lmap (when front (line-map front))
          relocate (fn [^String l]
                     (if-let [[_ f n m] (when lmap (re-find #"(?s)^(.*?):([0-9]+): (.*)$" l))]
                       (let [[f n] (lmap f (Long/parseLong n) nil)] (str f ":" n ": " m))
                       l))
          lines (for [e errs]
                  (let [[f n] (if (and lmap (:line e)) (lmap (:file e) (long (:line e)) (:col e)) [(:file e) (:line e)])]
                    (str f ":" n ": " (vmsg e))))
          lines (if front
                  (let [_ (require 'arbace.repr.go.syntax)
                        name (.getName (File. ^String front))
                        noder (:lines ((resolve 'arbace.repr.go.syntax/file-errors) front name))
                        ;; base.FlushErrors: sorted by position (file, line), stable
                        pos (fn [^String l] (let [[_ f n] (re-find #"^(.*?):([0-9]+): " l)]
                                              [(or f "") (if n (Long/parseLong n) 0)]))
                        merged (sort-by pos (concat lines noder))]
                    (if (seq merged)
                      merged
                      (let [d ((resolve 'arbace.repr.go.syntax/decl-errors) front name lang)]
                        ;; then the reader's: gc's types' sizes (types.CalcSize), as gc reports them
                        ;; when nothing before them did (GOI-SPEC.md, "Since v1: gc's size checks")
                        (if (seq d) d (map relocate (code/size-errors @sizes))))))
                  lines)
          lines (dedupe lines)
          ;; gc's base.ErrorfAt: at the max-errors-th error (after its repeats are dropped) the
          ;; errors are flushed and the compilation ends with too many errors at its position
          lines (if (and max-errors (>= (count lines) max-errors))
                  (let [ls (vec (take max-errors lines))
                        pos (re-find #"^[^:]*:[0-9]+" (peek ls))]
                    (conj ls (str pos ": too many errors")))
                  lines)]
      (doseq [l lines] (println l))
      (flush)
      (if (seq lines) 1 0))))

(defn -main
  "bin/goi run's Arbace side: ROOT NS [ARG...]; --errorcheck [--lang goV] [--max-errors N] [--raw]
  [--gc-front FILE] ROOT NS: the package's errors (errorcheck), checked at language version goV
  (gc's -lang) when given, at most N of them then gc's too many errors (gc without -e); --raw: ROOT
  holds repr/go's raw forms of the program (GP6), checked in the resolve mode; --gc-front: the
  errors of gc's front end beside its type checker from FILE, the program's Go file (GPS41 (c))."
  [& args]
  (when (= "--errorcheck" (first args))
    (let [[opts args] (loop [opts {} as (rest args)]
                        (case (first as)
                          "--lang" (recur (assoc opts :lang (second as)) (drop 2 as))
                          "--max-errors" (recur (assoc opts :max (Long/parseLong (second as))) (drop 2 as))
                          "--raw" (recur (assoc opts :raw true) (rest as))
                          "--gc-front" (recur (assoc opts :front (second as)) (drop 2 as))
                          [opts as]))
          lang (:lang opts)
          [root ns-name] args
          pf (File. (str root "/" (load/ns->file ns-name)))]
      (when-not (.isFile pf) (fail 126 "error" (str "no package file " pf)))
      (System/exit (int (try (errorcheck root pf lang (:max opts) (:raw opts) (:front opts))
                             (catch Throwable ex
                               (let [d (ex-data ex)
                                     u (or (:goi/unsupported d)
                                           (when-let [m (.getMessage ex)] (when (str/includes? m "not supported by goi yet") m)))]
                                 (if u
                                   (fail 125 "unsupported" u)
                                   (fail 126 "error" (str (.getName (class ex)) ": " (.getMessage ex)))))))))))
  (let [[root ns-name & pargs] args]
    (when-not (and root ns-name)
      (binding [*out* *err*] (println "usage: arbace -m arbace.go.run ROOT NS [ARG...]"))
      (System/exit 2))
    (let [pf (File. (str root "/" (load/ns->file ns-name)))]
      (when-not (.isFile pf)
        (fail 126 "error" (str "no package file " pf)))
      (let [status (try
                     (run root pf pargs)
                     (catch Throwable ex
                       (let [d (ex-data ex)
                             u (or (:goi/unsupported d)
                                   (when-let [m (.getMessage ex)] (when (str/includes? m "not supported by goi yet") m)))]
                         (if u
                           (fail 125 "unsupported" u)
                           (fail 126 "error" (str (.getName (class ex)) ": " (.getMessage ex)))))))]
        (System/exit (int status))))))

(ns arbace.rust.synthetic
  "rsi's synthetic corpus (doc/rust/EVAL.md §6, RES35): the programs of test/rust/synthetic/ generated from the table
  test/rust/synthetic.edn and the templates test/rust/synthetic-templates/*.tmpl (@NAME@ replaced by the row's params), one file
  per row, `generate` writing them, `check` requiring the committed files to be what the table and templates give, `ref` the
  expected statuses against the judge's runs (test/rust/ref-rustc-1.99.1.edn). bin/rsi synthetic."
  (:require [arbace.string :as str])
  (:import [java.io File]))

(def table-path "test/rust/synthetic.edn")
(def out-dir "test/rust/synthetic")

(defn- table [] (read-string (slurp table-path)))

(defn program
  "A row's source text: its template with the params, one header line."
  [{:keys [id template params]}]
  (let [t (slurp (str "test/rust/synthetic-templates/" template ".tmpl"))
        body (reduce (fn [s [k v]] (str/replace s (str "@" k "@") v)) t params)]
    (when-let [m (re-find #"@[A-Z]+@" body)] (throw (ex-info (str id ": parameter " m " not given") {})))
    (str "// rsi's synthetic program " id " (generated by bin/rsi synthetic from " template (when (seq params) (str " " (pr-str params))) "): do not edit\n" body)))

(defn generate []
  (.mkdirs (File. out-dir))
  (let [rows (table) want (set (map #(str (:id %) ".rs") rows))]
    (doseq [^File f (.listFiles (File. out-dir)) :when (and (.endsWith (.getName f) ".rs") (not (want (.getName f))))] (.delete f))
    (doseq [r rows] (spit (str out-dir "/" (:id r) ".rs") (program r)))
    (println "synthetic:" (count rows) "programs in" out-dir)))

(defn check []
  (let [rows (table) want (set (map #(str (:id %) ".rs") rows))
        have (set (for [^File f (.listFiles (File. out-dir)) :when (.endsWith (.getName f) ".rs")] (.getName f)))
        bad (concat (for [r rows :let [p (str out-dir "/" (:id r) ".rs")] :when (not= (program r) (when (.exists (File. p)) (slurp p)))] (str "differs: " p))
                    (for [f (remove want have)] (str "extra: " out-dir "/" f)))
        ids (map :id rows)]
    (doseq [b bad] (println b))
    (when (not= (count ids) (count (set ids))) (println "duplicate ids") (System/exit 1))
    (println "synthetic check:" (count rows) "programs," (count bad) "stale")
    (System/exit (if (seq bad) 1 0))))

(defn- read-all [^String f]
  (let [r (arbace.lang.LineNumberingPushbackReader. (java.io.StringReader. (slurp f))) eof (Object.)]
    (loop [out []] (let [x (read r false eof)] (if (identical? x eof) out (recur (conj out x)))))))

(defn ref-check
  "The rows' expected :status against the judge's recorded runs; a row with no run or another status is listed."
  []
  (let [refs (into {} (map (juxt :id identity) (read-all "test/rust/ref-rustc-1.99.1.edn")))
        rows (table)
        bad (for [{:keys [id status]} rows
                  :let [f (str out-dir "/" id ".rs") r (get refs f)]
                  :when (or (nil? r) (not= status (:status r)))]
              (str id ": expected " status ", the judge " (if r (str (:status r) (when (:error r) (str " " (:error r)))) "has no run")))
        nd (for [{:keys [id]} rows :let [r (get refs (str out-dir "/" id ".rs"))] :when (and r (false? (:det r)))] id)]
    (doseq [b bad] (println b))
    (doseq [n nd] (println "nondeterministic:" n))
    (println "synthetic ref:" (count rows) "programs," (count bad) "against the judge," (count nd) "nondeterministic")
    (System/exit (if (or (seq bad) (seq nd)) 1 0))))

(defn -main [verb & _]
  (case verb "generate" (generate) "check" (check) "ref" (ref-check)
    (do (println "arbace.rust.synthetic: generate, check or ref") (System/exit 2))))

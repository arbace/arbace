;; Ported from rustc 1.99.1 (https://github.com/rust-lang/rust at 58cf8f9c3, the sources of Alpine's rust-src-1.99.1-r0,
;; pinned by tools/rsdump/apks.sha256): RF10's first slice of
;; compiler/rustc_hir_analysis/src/check/region.rs (the region scope tree: resolve_block, resolve_cond, resolve_arm,
;;   resolve_stmt, resolve_expr, the terminating scopes) and compiler/rustc_middle/src/middle/region.rs (temporary_scope),
;; compiler/rustc_mir_build/src/thir/cx/{expr.rs (mirror_expr_inner, apply_adjustment, make_mirror_unadjusted's kinds the
;;   slice takes), block.rs (mirror_block, mirror_stmts)}, thir/pattern/mod.rs (lower_pattern: bindings, wildcards,
;;   constants, tuples, structs and variants, references, the implicit dereferences),
;; compiler/rustc_mir_build/src/builder/{mod.rs (construct_fn, args_and_body), cfg.rs, scope.rs (Scopes, DropTree,
;;   in_scope, in_breakable_scope, in_if_then_scope, break_scope, break_for_else, leave_top_scope, build_scope_drops,
;;   build_exit_tree, diverge_cleanup, diverge_from, build_unwind_tree, schedule_drop), block.rs (ast_block,
;;   ast_block_stmts), misc.rs, expr/{into.rs, stmt.rs, as_operand.rs, as_temp.rs, as_rvalue.rs (build_binary_op),
;;   as_place.rs (expr_as_place, lower_index_expression, bounds_check), as_constant.rs, category.rs},
;;   matches/{mod.rs, test.rs, util.rs, match_pair.rs}'s paths the slice takes (then_else_break, declare_bindings,
;;   storage_live_binding, expr_into_pattern, match_expr's candidates and tests over integers, booleans and enums)};
;; rustc is dual-licensed MIT OR Apache-2.0 (LICENSE.md, "Rust (rustc 1.99.1)").

(ns arbace.rust.front.build
  "RF10's first slice (doc/rust/FRONTEND-SURVEY.md, \"As built: RF10 (first slice)\"): THIR and MIR building from the native
  front end: a body's HIR (arbace.rust.front.lower) and its type-check results (arbace.rust.front.typeck/body-results)
  through the region scope tree, THIR's mirror and rustc_mir_build's builder, into MIR forms (doc/rust/MIR.md) at the
  `built` phase, printed by arbace.rust.front.mir as rustc's -Zdump-mir=built prints them.

    (build-body DEF OPTS)    within collect/with-crate: a body map of MIR forms (:name :kind :args :ret :locals :scopes
                             :debug :blocks); OPTS {:overflow-checks bool :edition N}"
  (:require [arbace.rust.front.collect :as c] [arbace.rust.front.typeck :as tc] [arbace.rust.front.mir :as mir] [arbace.string :as str]))

(set! *warn-on-reflection* true)

(def ^:dynamic *root-file* nil)

(declare span-text ctor-info)

(defn- unsupported [what & [x]] (throw (ex-info (str "build: unsupported " what) {:what what :x x})))

;; ---------------------------------------------------------------------------------------------
;; Types: the type checker's types as MIR's type forms (ty TEXT STRUCT)

(def ^:private unit-ty [:tuple []])
(def ^:private bool-ty [:bool])
(def ^:private usize-ty [:uint "usize"])

(defn ty-text [t] (binding [c/*in-value* false c/*erased-regions* true] (c/print-ty t)))

(defn ty-form
  "A type as MIR forms write it: (ty TEXT STRUCT)"
  [t]
  (list 'ty (ty-text t)
        (case (first t)
          :bool 'bool :char 'char :str 'str :never 'never
          :int (list 'int (second t)) :uint (list 'uint (second t)) :float (list 'float (second t))
          :tuple (apply list 'tuple (map ty-form (second t)))
          :array (list 'array (ty-form (second t)) (c/print-const (nth t 2)))
          :slice (list 'slice (ty-form (second t)))
          :ref (list 'ref (ty-form (nth t 3)) (boolean (nth t 2)))
          :ptr (list 'ptr (ty-form (nth t 2)) (boolean (second t)))
          :adt (list 'adt (binding [c/*in-value* false] (c/print-def-path (second t) [])) (str (second t))
                     (vec (for [a (nth t 2)] (if (c/region? a) '(lt) (ty-form a)))))
          :fndef (list 'fndef (binding [c/*in-value* true] (c/print-def-path (second t) (nth t 2)))
                       (vec (for [a (nth t 2)] (if (c/region? a) '(lt) (ty-form a)))))
          :fnptr '(fnptr)
          :param (list 'param (nth t 2))
          (list 'other (str (first t))))))

(def ^:private int-bits {"i8" 8 "i16" 16 "i32" 32 "i64" 64 "i128" 128 "isize" 64 "u8" 8 "u16" 16 "u32" 32 "u64" 64 "u128" 128 "usize" 64})

(defn- pow2 [n] (reduce * 1N (repeat n 2N)))

(defn- integral? [t] (#{:int :uint} (first t)))
(defn- signed? [t] (= :int (first t)))

;; the solver's questions, asked with the type checker's state bound (tc/with-solver)
(def ^:dynamic *closure-tys* {})
(def ^:dynamic *closure-kinds* {})   ; a closure type's text -> its kind   ; a closure type's text -> its upvars' types (the root's closure_analyze)

(defn- copy? [t]
  (case (first t)
    :closure (every? copy? (get *closure-tys* (second t)))
    (:tuple) (every? copy? (second t))
    :array (copy? (second t))
    (tc/copy-type? t)))

(defn- adt-def [t] (when (= :adt (first t)) (second t)))

(def ^:dynamic *needs-drop-stack* #{})

(defn needs-drop?
  "Ty::needs_drop, for the slice: Copy types never; a local ADT by its fields unless it implements Drop; std's ADTs
  that are not Copy: yes"
  [t]
  (cond (copy? t) false
        :else (case (first t)
                (:bool :char :int :uint :float :ptr :fndef :fnptr :never :str) false
                :closure (boolean (some needs-drop? (get *closure-tys* (second t))))
                :ref false
                :tuple (boolean (some needs-drop? (second t)))
                :array (needs-drop? (second t))
                :slice (needs-drop? (second t))
                :adt (let [d (second t)]
                       (cond (number? d)
                             (or (tc/implements-drop? t)
                                 (boolean (some (fn [[_ ft]] (needs-drop? ft)) (tc/all-fields d (nth t 2)))))
                             ;; std's ADTs by their interface: a Drop impl, else a field that needs drop (ManuallyDrop never)
                             (= "core::mem::manually_drop::ManuallyDrop" d) false
                             (and (tc/std-adt-known? d) (not (contains? *needs-drop-stack* d)))
                             (binding [*needs-drop-stack* (conj *needs-drop-stack* d)]
                               (or (tc/implements-drop? t)
                                   (boolean (some (fn [[_ ft]] (needs-drop? ft)) (tc/std-all-fields d (nth t 2))))))
                             :else true))
                true)))

;; ---------------------------------------------------------------------------------------------
;; The region scope tree (region.rs): scopes [HIR-ID DATA], DATA :node :destruction :call-site :arguments :if-then
;; :if-then-rescope :match-guard or [:remainder I]

(def ^:dynamic *rt* nil)   ; atom {:parent {scope parent} :var {binding-key scope} :cx {:parent :var-parent}}

(defn- record-parent! [child]
  (swap! *rt* assoc-in [:parent child] (get-in @*rt* [:cx :parent])))
(defn- enter-scope! [s] (record-parent! s) (swap! *rt* assoc-in [:cx :parent] s))
(defn- enter-node-scope-with-dtor! [id terminating]
  (when terminating (enter-scope! [id :destruction]))
  (enter-scope! [id :node]))
(defn- cx [] (:cx @*rt*))
(defn- set-cx! [x] (swap! *rt* assoc :cx x))
(defn- var-parent-here! [] (swap! *rt* assoc-in [:cx :var-parent] (get-in @*rt* [:cx :parent])))

(defn binding-key
  "A binding's identity: its pattern's span (a local path's resolution names it), else its HIR id"
  [p]
  (let [sp (:span p) n (count (str (:name p)))
        [l1 c1 l2 c2] (when (sequential? sp) sp)]
    (cond (not (sequential? sp)) (:hir-id p)
          (:sub p) [l1 c1 l1 (+ c1 n)]
          :else [l2 (- c2 n) l2 c2])))

(declare resolve-expr resolve-block)

(defn- resolve-pat [p]
  (when (map? p)
    (when (= :binding (:kind p))
      (when-let [vp (:var-parent (cx))] (swap! *rt* assoc-in [:var (binding-key p)] vp)))
    (doseq [k [:sub :pat] :let [x (get p k)] :when (map? x)] (resolve-pat x))
    (doseq [x (:pats p)] (resolve-pat x))
    (doseq [f (:fields p)] (resolve-pat (:pat f)))))

(defn- default-temporary-scope*
  "default_temporary_scope over the tree being built"
  [inner]
  (loop [s inner]
    (if-let [p (get (:parent @*rt*) s)]
      (case (second p)
        :destruction s
        (:if-then-rescope :match-guard) p
        (recur p))
      s)))

(defn- binding-pat?
  "is_binding_pat: a pattern with an explicit `ref` binding"
  [p]
  (case (:kind p)
    :binding (boolean (:by-ref p))
    :struct (boolean (some #(binding-pat? (:pat %)) (:fields p)))
    (:slice :or :tuple-struct :tuple) (boolean (some binding-pat? (:pats p)))
    (:box :deref :guard) (binding-pat? (:pat p))
    false))

(defn- record-subexpr-extended!
  "record_subexpr_extended_temp_scopes"
  [e lifetime]
  (when (map? e)
    (swap! *rt* assoc-in [:extended (:hir-id e)] lifetime)
    (when (or (= :addr-of (:kind e)) (and (= :unary (:kind e)) (= "*" (:op e))) (#{:field :index} (:kind e)))
      (record-subexpr-extended! (:expr e) lifetime))))

(defn- record-rvalue-scope-if-borrow!
  "record_rvalue_scope_if_borrow_expr"
  [e blk]
  (when (map? e)
    (case (:kind e)
      :addr-of (do (record-rvalue-scope-if-borrow! (:expr e) blk) (record-subexpr-extended! (:expr e) blk))
      :struct (doseq [f (:fields e)] (record-rvalue-scope-if-borrow! (:expr f) blk))
      (:array :tup) (doseq [x (:exprs e)] (record-rvalue-scope-if-borrow! x blk))
      :cast (record-rvalue-scope-if-borrow! (:expr e) blk)
      :block (let [b (:block e)]
               (when (:expr b) (record-rvalue-scope-if-borrow! (:expr b) blk))
               (doseq [st (:stmts b) :when (and (= :let (:kind st)) (:super st))]
                 (swap! *rt* assoc-in [:ext-super (:hir-id (:pat st))] blk)))
      :if (do (record-rvalue-scope-if-borrow! (:then e) blk) (when (:else e) (record-rvalue-scope-if-borrow! (:else e) blk)))
      :match (doseq [a (:arms e)] (record-rvalue-scope-if-borrow! (:body a) blk))
      :call (let [f (:func e)]
              (when (and (= :path (:kind f)) (= :fn (nth (ctor-info (:path f)) 3 nil)))
                (doseq [a (:args e)] (record-rvalue-scope-if-borrow! a blk))))
      nil)))

(defn- resolve-local
  "resolve_local: a `let`'s initializer's temporaries extended to its bindings' scope (a `super let` not itself extended:
  its bindings and temporaries in the enclosing expression's temporary scope)"
  [pat init & [super?]]
  (let [extend (if super?
                 (if (contains? (:ext-super @*rt*) (:hir-id pat))
                   (do (swap! *rt* assoc-in [:cx :var-parent] (get-in @*rt* [:ext-super (:hir-id pat)]))
                       (swap! *rt* update :ext-super dissoc (:hir-id pat))
                       true)
                   (do (when-let [inner (get-in @*rt* [:cx :var-parent])]
                         (swap! *rt* assoc-in [:cx :var-parent] (default-temporary-scope* inner)))
                       false))
                 true)
        vp (get-in @*rt* [:cx :var-parent])]
    (when (and init extend)
      (record-rvalue-scope-if-borrow! init vp)
      (when (and pat (binding-pat? pat)) (record-subexpr-extended! init vp))))
  (when init (resolve-expr init false))
  (when pat (resolve-pat pat)))

(defn- resolve-stmt [s]
  (if (and (= :let (:kind s)) (:super s))
    (resolve-local (:pat s) (:init s) true)
    (let [prev (:parent (cx))]
      (enter-node-scope-with-dtor! (:hir-id s) true)
      (case (:kind s)
        :let (do (resolve-local (:pat s) (:init s)) (when (:els s) (resolve-block (:els s) false)))
        (:semi :expr) (resolve-expr (:expr s) false)
        nil)
      (swap! *rt* assoc-in [:cx :parent] prev))))

(def ^:dynamic *edition* 2024)

(defn resolve-block [b terminating]
  (let [prev (cx)]
    (enter-node-scope-with-dtor! (:hir-id b) terminating)
    (var-parent-here!)
    (doseq [[i s] (map-indexed vector (:stmts b))]
      (case (:kind s)
        :let (if (:els s)
               (let [pc (cx)]
                 (enter-scope! [(:hir-id b) [:remainder i]]) (var-parent-here!)
                 (resolve-stmt (dissoc s :els))
                 (let [after (cx)] (set-cx! pc) (resolve-block (:els s) true) (set-cx! after)))
               (do (enter-scope! [(:hir-id b) [:remainder i]]) (var-parent-here!) (resolve-stmt s)))
        :item nil
        (resolve-stmt s)))
    (when-let [t (:expr b)] (resolve-expr t (>= *edition* 2024)))
    (set-cx! prev)))

(defn- logical? [e] (and (= :binary (:kind e)) (#{"&&" "||"} (:op e))))

(defn- resolve-cond [e] (resolve-expr e (not (or (= :let (:kind e)) (logical? e)))))

(defn- resolve-arm [a]
  (let [prev (cx)]
    (enter-node-scope-with-dtor! (:hir-id a) true)
    (var-parent-here!)
    (resolve-pat (:pat a))
    (when-let [g (:guard a)]
      (enter-scope! [(:hir-id a) :match-guard]) (var-parent-here!)
      (resolve-cond g))
    (resolve-expr (:body a) false)
    (set-cx! prev)))

(defn- walk-expr [e]
  (doseq [k [:func :receiver :lhs :rhs :expr :cond :index :init :base]
          :let [x (get e k)] :when (and (map? x) (= :expr (:node x)))]
    (resolve-expr x false))
  (when (= :let (:kind e)) (resolve-pat (:pat e)))
  (doseq [k [:args :exprs] x (get e k) :when (map? x)] (resolve-expr x false))
  (doseq [f (:fields e) :when (map? (:expr f))] (resolve-expr (:expr f) false))
  (when-let [b (:block e)] (resolve-block b false))
  (doseq [a (:arms e)] (resolve-arm a)))

(defn resolve-expr [e terminating]
  (let [prev (cx)]
    (enter-node-scope-with-dtor! (:hir-id e) terminating)
    (case (:kind e)
      :binary (if (logical? e)
                (do (resolve-expr (:lhs e) (not (or (= :let (:kind (:lhs e))) (logical? (:lhs e)))))
                    (resolve-expr (:rhs e) (not= :let (:kind (:rhs e)))))
                (walk-expr e))
      :assign-op (do (resolve-expr (:rhs e) false) (resolve-expr (:lhs e) false))
      :if (let [ecx (cx)]
            (enter-scope! [(:hir-id (:then e)) (if (>= *edition* 2024) :if-then-rescope :if-then)])
            (var-parent-here!)
            (resolve-cond (:cond e))
            (resolve-expr (:then e) true)
            (set-cx! ecx)
            (when (:else e) (resolve-expr (:else e) true)))
      :loop (resolve-block (:block e) true)
      :drop-temps (resolve-expr (:expr e) true)
      :closure nil
      (walk-expr e))
    (set-cx! prev)))

(defn- scope-tree
  "The body's region scope tree: its body block BODY (a function's) with the parameters' patterns"
  [params body-expr]
  (binding [*rt* (atom {:parent {} :var {} :cx {:parent nil :var-parent nil}})]
    (let [id (:hir-id body-expr)]
      (enter-scope! [id :call-site])
      (enter-scope! [id :arguments])
      (var-parent-here!)
      (doseq [p params] (resolve-pat p))
      (resolve-expr body-expr true))
    @*rt*))

(def ^:dynamic *tree* nil)

(defn temporary-scope
  "temporary_scope(expr): the innermost enclosing scope whose parent is a destruction scope (or an if-then rescope or a
  match guard, itself)"
  [id]
  (if (contains? (:extended *tree*) id)
    (get (:extended *tree*) id)
  (loop [s [id :node]]
    (when-let [p (get (:parent *tree*) s)]
      (case (second p)
        :destruction s
        (:if-then-rescope :match-guard) p
        (recur p))))))

(defn- var-scope [k] (get (:var *tree*) k))

;; ---------------------------------------------------------------------------------------------
;; THIR (thir/cx): expressions as maps {:k KIND :ty TYPE :span SPAN :tsi HIR-ID ...}

(def ^:dynamic *res* nil)   ; the body's type-check results by HIR id (tc/body-results)

(defn- r-of [e] (get *res* (:hir-id e)))
(defn- ty-of [e] (or (:ty (r-of e)) (unsupported "an expression without a type" (:kind e))))

(declare mirror-expr mirror-block mirror-block* lower-pattern)

(defn- local-res [path] (let [r (first (:res path))] (when (= 'local (first r)) (second r))))

(def ^:private bin-ops
  {"+" "Add" "-" "Sub" "*" "Mul" "/" "Div" "%" "Rem" "^" "BitXor" "&" "BitAnd" "|" "BitOr" "<<" "Shl" ">>" "Shr"
   "==" "Eq" "<" "Lt" "<=" "Le" "!=" "Ne" ">=" "Ge" ">" "Gt"})

(defn- ctor-info
  "A path's constructor: [adt-id variant-index variant-def-id ctor-kind] for a struct's or a variant's constructor
  (the crate's by their definitions, std's by their paths; a desugaring's lang item path, Some or None, by its lang item)"
  [path]
  (let [rd (if (:lang path)
             (when-let [lp (c/lang (:ident (first (:segs path))))] [:ext lp nil])
             (c/res-def path))]
    (case (first rd)
      :local
      (let [[_ id k] rd d (c/def-of id)]
        (cond
          (str/starts-with? (str k) "Ctor(")
          (if (= "Variant" (:kind d))
            [(:parent d) (tc/variant-index id) id (if (str/includes? (str k) "Fn") :fn :const)]
            [id 0 id (if (str/includes? (str k) "Fn") :fn :const)])
          (= "Variant" k) [(:parent d) (tc/variant-index id) id :struct]
          (= "Struct" k) [id 0 id :struct]
          :else nil))
      :ext
      (let [[_ p _] rd
            p (if (re-find #"\{constructor#\d+\}$" p) (c/path-parent p) p)
            kind (fn [vid] (keyword (tc/variant-ctor-kind vid)))]
        (cond (tc/std-variant p) [(c/path-parent p) (tc/variant-index p) p (kind p)]
              (get (:adts c/*si*) p) [p 0 p (kind p)]
              :else nil))
      nil)))

(def ^:dynamic *loops* nil)   ; the enclosing loops and labeled blocks, innermost first

(defn- loop-target
  "A break's or continue's target: the region scope of the loop (or labeled block) its label names, else the innermost loop"
  [e]
  (let [t (if-let [l (:label e)] (some #(when (= l (:label %)) %) *loops*) (some #(when-not (:block? %) %) *loops*))]
    (if t [(:id t) :node] (unsupported "a break target"))))

(defn- mk [e k ty & kvs] (merge {:k k :ty ty :span (:span e) :tsi (:hir-id e)} (apply hash-map kvs)))

(defn- field-index [vid nm]
  (let [fs (tc/all-fields-of-variant vid)]
    (or (first (keep-indexed (fn [i [n _]] (when (= (str n) (str nm)) i)) fs))
        (when (re-matches #"\d+" (str nm)) (parse-long (str nm)))
        (unsupported "a field" nm))))

(def ^:dynamic *self-var* nil)
(def ^:dynamic *upvars* #{})   ; the current body's upvars (a closure's upvars_mentioned)
(def ^:dynamic *closure-info* nil)   ; the typeck root's closures' captures by HIR id (closure-analyze)
(def ^:dynamic *names* {})   ; the bindings in scope by name: a derive's or a desugaring's paths carry no resolution (`other`, `iter`)

(defn- bind-names! [thir-pat]
  (let [acc (atom *names*)]
    (letfn [(w [p] (when p
                     (when (= :binding (:k p)) (swap! acc assoc (:name p) (:var p)))
                     (doseq [x (concat [(:sub p)] (map second (:subpatterns p)) (take 1 (:pats p)))] (w x))))]
      (w thir-pat))
    (set! *names* @acc)))   ; the `self` parameter's binding (a derive's `self` paths carry no resolution)

(defn- mirror-path [e ty]
  (let [path (:path e)
        nm (when (= 1 (count (:segs path))) (:ident (first (:segs path))))
        sp (or (local-res path)
               (when (and *self-var* (= "self" nm) (or (nil? (:res path)) (= [:unresolved "self"] (c/res-def path)))) *self-var*)
               (when (and nm (or (empty? (:res path)) (= :unresolved (first (c/res-def path))))) (get *names* nm)))]
    (if sp
      (mk e (if (contains? *upvars* sp) :upvar-ref :var-ref) ty :id sp)
      (let [rd (c/res-def path)]
        (cond
          (= :fndef (first ty)) (mk e :zst-literal ty :user-ty (:user-ty (r-of e)) :fspan (:fspan e))
          (and (= :adt (first ty)) (ctor-info path))
          (let [[adt vi vid _] (ctor-info path)] (mk e :adt ty :adt adt :variant vi :vid vid :fields []))
          :else (unsupported "a path" (pr-str [rd (mapv :ident (:segs path)) (boolean (:lang path)) (first ty)])))))))

(def ^:private op-methods
  {"+" ["core::ops::arith::Add" "add"] "-" ["core::ops::arith::Sub" "sub"] "*" ["core::ops::arith::Mul" "mul"]
   "/" ["core::ops::arith::Div" "div"] "%" ["core::ops::arith::Rem" "rem"] "&" ["core::ops::bit::BitAnd" "bitand"]
   "|" ["core::ops::bit::BitOr" "bitor"] "^" ["core::ops::bit::BitXor" "bitxor"] "<<" ["core::ops::bit::Shl" "shl"]
   ">>" ["core::ops::bit::Shr" "shr"] "==" ["core::cmp::PartialEq" "eq"] "!=" ["core::cmp::PartialEq" "ne"]
   "<" ["core::cmp::PartialOrd" "lt"] "<=" ["core::cmp::PartialOrd" "le"] ">" ["core::cmp::PartialOrd" "gt"]
   ">=" ["core::cmp::PartialOrd" "ge"]})

(defn- int-like? [t] (#{:int :uint} (first t)))
(defn- scalar-ty? [t] (#{:bool :char :int :uint :float :fndef :fnptr :ptr} (first t)))

(defn- builtin-binop?
  "is_builtin_binop over the operands' resolved types"
  [op lt rt]
  (cond (#{"&&" "||"} op) true
        (#{"<<" ">>"} op) (and (int-like? lt) (int-like? rt))
        (#{"+" "-" "*" "/" "%"} op) (or (and (int-like? lt) (int-like? rt)) (and (= :float (first lt)) (= :float (first rt))))
        (#{"&" "|" "^"} op) (or (and (int-like? lt) (int-like? rt)) (and (= :bool (first lt)) (= :bool (first rt))))
        :else (and (scalar-ty? lt) (scalar-ty? rt))))

(defn- adjusted-ty [e] (let [x (r-of e)] (reduce (fn [_ [_ t]] t) (:ty x) (:adj x))))

(defn- overloaded-operator
  "overloaded_operator: the operator's trait method called on the operands (as mirrored, their autorefs applied)"
  [e ty [tr m] targs args]
  (mk e :call ty :fun {:k :zst-literal :ty [:fndef (str tr "::" m) targs] :span (:span e) :tsi (:hir-id e)}
      :args args :from-hir false :fn-span (:span e)))

(defn- overloaded-place
  "overloaded_place: `*Deref::deref(arg)` (deref_mut when the receiver's borrow is mutable), its call's type a reference to
  the place's"
  [e place-ty arg-x callee-self span]
  (let [mutbl (boolean (nth (:ty arg-x) 2 false))
        [tr m] (if mutbl ["core::ops::deref::DerefMut" "deref_mut"] ["core::ops::deref::Deref" "deref"])
        call {:k :call :ty [:ref [:re-erased] mutbl place-ty] :span span :tsi (:hir-id e)
              :fun {:k :zst-literal :ty [:fndef (str tr "::" m) [callee-self]] :span span :tsi (:hir-id e)}
              :args [arg-x] :from-hir false :fn-span span}]
    {:k :deref :ty place-ty :arg call :span span :tsi (:hir-id e)}))

(defn- method-ident-span
  "A method call's segment's span (method_callee's span: the method's name after the receiver's `.`), from the root's text"
  [e]
  (let [rs (:span (:receiver e)) src c/*src* nm (str (:ident (:seg e)))]
    (when (and (vector? rs) src)
      (let [{:keys [^ints cps lines n]} src
            n (long n)
            off (+ (long (nth lines (dec (long (rs 2))))) (dec (long (rs 3))))
            at (fn [i] (when (< i n) (char (aget cps (int i)))))
            i (loop [i off] (cond (>= i n) nil (= \. (at i)) (inc i) :else (recur (inc i))))
            i (when i (loop [i i] (if (and (< i n) (Character/isWhitespace (char (at i)))) (recur (inc i)) i)))
            lc (fn [o] (let [li (loop [a 0 b (dec (count lines))] (if (>= a b) a (let [m (quot (+ a b 1) 2)] (if (<= (long (nth lines m)) o) (recur m b) (recur a (dec m))))))]
                         [(inc li) (inc (- o (long (nth lines li))))]))]
        (when i (let [[l1 c1] (lc i) [l2 c2] (lc (+ i (count nm)))] [l1 c1 l2 c2]))))))

(defn- capture-upvar
  "capture_upvar with convert_captured_hir_place: the captured place as THIR over the variable (an upvar of the current
  body or its own), by value or borrowed"
  [e cap]
  (let [base {:k (if (contains? *upvars* (:var cap)) :upvar-ref :var-ref) :id (:var cap) :ty (:base-ty cap) :span (:span e) :tsi (:hir-id e)}
        x (reduce (fn [x [k t]]
                    (case (first k)
                      :deref {:k :deref :arg x :ty t :span (:span e) :tsi (:hir-id e)}
                      :field {:k :field :lhs x :variant (nth k 2) :name (second k) :ty t :span (:span e) :tsi (:hir-id e)}))
                  base (:proj cap))]
    (if (= :by-value (:cap cap))
      x
      {:k :borrow :bk (case (second (:cap cap)) :imm :shared :mut :mut :unique :unique) :arg x :ty (:ty cap) :span (:span e) :tsi (:hir-id e)})))

(defn- mirror-unadjusted [e]
  (let [ty (ty-of e)]
    (case (:kind e)
      :lit (mk e :literal ty :lit (:lit e) :neg false)
      :path (mirror-path e ty)
      :type-relative (if (= :fndef (first ty)) (mk e :zst-literal ty :user-ty (:user-ty (r-of e))) (unsupported "a type-relative path" (first ty)))
      :unary (case (:op e)
               "-" (cond (not (#{:int :uint :float} (first (ty-of (:expr e)))))
                         (overloaded-operator e ty ["core::ops::arith::Neg" "neg"] [(ty-of (:expr e))] [(mirror-expr (:expr e))])
                         (= :lit (:kind (:expr e))) (mk e :literal ty :lit (:lit (:expr e)) :neg true)
                         :else (mk e :unary ty :op "Neg" :arg (mirror-expr (:expr e))))
               "!" (if (not (#{:int :uint :bool} (first (ty-of (:expr e)))))
                     (overloaded-operator e ty ["core::ops::bit::Not" "not"] [(ty-of (:expr e))] [(mirror-expr (:expr e))])
                     (mk e :unary ty :op "Not" :arg (mirror-expr (:expr e))))
               "*" (let [at (ty-of (:expr e))]
                     (if (or (#{:ref :ptr} (first at)) (= "alloc::boxed::Box" (adt-def at)))
                       (mk e :deref ty :arg (mirror-expr (:expr e)))
                       (let [ax (mirror-expr (:expr e))]
                         (when-not (= :ref (first (:ty ax))) (unsupported "an overloaded deref without its autoref"))
                         (assoc (overloaded-place e ty ax at (:span e)) :tsi (:hir-id e))))))
      :binary (cond (:callee (r-of e)) (unsupported "an overloaded operator")
                    (and (not (logical? e)) (not (builtin-binop? (:op e) (ty-of (:lhs e)) (ty-of (:rhs e)))))
                    (overloaded-operator e ty (get op-methods (:op e))
                                         [(ty-of (:lhs e)) (if (#{"==" "!=" "<" "<=" ">" ">="} (:op e)) (ty-of (:rhs e)) (adjusted-ty (:rhs e)))]
                                         [(mirror-expr (:lhs e)) (mirror-expr (:rhs e))])
                    (logical? e) (mk e :logical ty :op (if (= "&&" (:op e)) :and :or) :lhs (mirror-expr (:lhs e)) :rhs (mirror-expr (:rhs e)))
                    :else (mk e :binary ty :op (get bin-ops (:op e)) :lhs (mirror-expr (:lhs e)) :rhs (mirror-expr (:rhs e))))
      :assign (mk e :assign ty :lhs (mirror-expr (:lhs e)) :rhs (mirror-expr (:rhs e)))
      :assign-op (if (:callee (r-of e))
                   (unsupported "an overloaded compound assignment")
                   (mk e :assign-op ty :op (get bin-ops (str/replace (str (:op e)) "=" "")) :lhs (mirror-expr (:lhs e)) :rhs (mirror-expr (:rhs e))))
      :addr-of (if (:raw e)
                 (mk e :raw-borrow ty :mutbl (boolean (:mutbl e)) :arg (mirror-expr (:expr e)))
                 (mk e :borrow ty :bk (if (:mutbl e) :mut :shared) :arg (mirror-expr (:expr e))))
      :cast (let [src (:expr e)]
              (cond (:coercion-cast (r-of src)) (mk e :use ty :source (mirror-expr src))
                    :else (mk e :cast ty :source (mirror-expr src))))
      :drop-temps (mk e :use ty :source (mirror-expr (:expr e)))
      :field (let [bt (let [x (r-of (:expr e)) t (:ty x)] (reduce (fn [_ [_ tt]] tt) t (:adj x)))
                   [vid vi] (if (= :adt (first bt))
                              (let [d (second bt)] (if (number? d) [(tc/single-variant d) 0] (unsupported "a std field")))
                              [nil 0])
                   idx (if vid (field-index vid (:ident e)) (parse-long (str (:ident e))))]
               (mk e :field ty :lhs (mirror-expr (:expr e)) :variant vi :name idx))
      :index (if (#{:array :slice} (first (adjusted-ty (:expr e))))
               (mk e :index ty :lhs (mirror-expr (:expr e)) :index (mirror-expr (:index e)))
               ;; an overloaded index: `*Index::index(&base, idx)` (IndexMut::index_mut for a mutable autoref)
               (let [ax (mirror-expr (:expr e)) ix (mirror-expr (:index e))
                     _ (when-not (= :ref (first (:ty ax))) (unsupported "an overloaded index without its autoref"))
                     mutbl (boolean (nth (:ty ax) 2)) st (nth (:ty ax) 3)
                     [tr m] (if mutbl ["core::ops::index::IndexMut" "index_mut"] ["core::ops::index::Index" "index"])
                     call {:k :call :ty [:ref [:re-erased] mutbl ty] :span (:span e) :tsi (:hir-id e)
                           :fun {:k :zst-literal :ty [:fndef (str tr "::" m) [st (adjusted-ty (:index e))]] :span (:span e) :tsi (:hir-id e)}
                           :args [ax ix] :from-hir false :fn-span (:span e)}]
                 (mk e :deref ty :arg call)))
      :tup (mk e :tuple ty :fields (mapv mirror-expr (:exprs e)))
      :repeat (if (= :array (first ty)) (mk e :repeat ty :value (mirror-expr (:expr e)) :count (nth ty 2)) (unsupported "a repeat of" ty))
      :array (mk e :array ty :fields (mapv mirror-expr (:exprs e)))
      :call (let [f (:func e)]
              (if-let [[adt vi vid kind] (and (= :path (:kind f)) (= :fn (nth (ctor-info (:path f)) 3 nil)) (ctor-info (:path f)))]
                (mk e :adt ty :adt adt :variant vi :vid vid :fields (vec (map-indexed (fn [i a] [i (mirror-expr a)]) (:args e))))
                (if-let [[k self-ty targs] (:fn-call (r-of e))]
                  ;; an overloaded call: the Fn trait's method over the callee and the arguments' tuple
                  (let [k (if (= :closure k)
                            (case (get *closure-kinds* (second self-ty) :fn)
                              :fn "core::ops::function::Fn" :fn-mut "core::ops::function::FnMut" :fn-once "core::ops::function::FnOnce")
                            k)
                        m (case k "core::ops::function::Fn" "call" "core::ops::function::FnMut" "call_mut" "core::ops::function::FnOnce" "call_once")
                        adj-ty (fn [a] (let [x (r-of a)] (reduce (fn [_ [_ t]] t) (:ty x) (:adj x))))
                        tt [:tuple (mapv adj-ty (:args e))]
                        fty [:fndef (str k "::" m) [self-ty tt]]]
                    (mk e :call ty :fun {:k :zst-literal :ty fty :span (:span e) :tsi (:hir-id e)}
                        :args [(mirror-expr f) {:k :tuple :ty tt :fields (mapv mirror-expr (:args e)) :span (:span e) :tsi (:hir-id e)}]
                        :from-hir true :fn-span (:span e)))
                  (mk e :call ty :fun (mirror-expr f) :args (mapv mirror-expr (:args e)) :from-hir true :fn-span (:span e)))))
      :method (let [[def args] (or (:callee (r-of e)) (unsupported "a method call without its callee"))
                    fty [:fndef def args]]
                (mk e :call ty :fun {:k :zst-literal :ty fty :span (or (method-ident-span e) (:span e)) :tsi (:hir-id e) :user-ty (:user-ty (r-of e))}
                    :args (into [(mirror-expr (:receiver e))] (map mirror-expr (:args e))) :from-hir true :fn-span (:span e)))
      :struct (let [[adt vi vid] (or (ctor-info (:path e)) (unsupported "a struct expression" (:path e)))]
                (when (:base e) (unsupported "functional update"))
                (mk e :adt ty :adt adt :variant vi :vid vid
                    :fields (mapv (fn [f] [(field-index vid (:ident f)) (mirror-expr (:expr f))]) (:fields e))))
      :block (if (:label e)
               (binding [*loops* (cons {:label (:label e) :id (:hir-id e) :block? true} *loops*)]
                 (mk e :block ty :block (assoc (mirror-block (:block e)) :targeted-by-break true)))
               (mk e :block ty :block (mirror-block (:block e))))
      :if (binding [*names* *names*] (mk e :if ty :cond (mirror-expr (:cond e)) :then (mirror-expr (:then e)) :else (some-> (:else e) mirror-expr)
              :if-then-scope [(:hir-id (:then e)) (if (>= *edition* 2024) :if-then-rescope :if-then)]))
      :loop (let [b (:block e)]
              (binding [*loops* (cons {:label (:label e) :id (:hir-id e)} *loops*)]
                (mk e :loop ty :body {:k :block :ty unit-ty :span (:span b) :tsi (:hir-id b) :block (mirror-block b)})))
      :break (mk e :break ty :label (loop-target e) :value (some-> (:expr e) mirror-expr))
      :continue (mk e :continue ty :label (loop-target e))
      :ret (mk e :return ty :value (some-> (:expr e) mirror-expr))
      :let (let [x (mirror-expr (:init e)) pat (lower-pattern (:pat e))] (bind-names! pat) (mk e :let ty :expr x :pat pat))
      :match (mk e :match ty :scrutinee (mirror-expr (:expr e))
                 :arms (mapv (fn [a] (binding [*names* *names*]
                                       (let [pat (lower-pattern (:pat a))]
                                         (bind-names! pat)
                                         {:pat pat :guard (some-> (:guard a) mirror-expr) :body (mirror-expr (:body a))
                                      :scope [(:hir-id a) :node] :span (:span a) :hir-id (:hir-id a)})))
                             (:arms e)))
      :closure (let [info (or (get *closure-info* (:hir-id e)) (unsupported "a closure without its captures"))]
                 (when (seq (:fake-reads info)) (unsupported "a closure's fake reads"))
                 (mk e :closure ty :info info :upvars (mapv #(capture-upvar e %) (:captures info))))
      (unsupported "an expression" (:kind e)))))

(defn- pointer-cast-kind [k] (let [m (re-find #"\((\w+)" (str k))] (if m (second m) "Unsize")))

(defn- apply-adjustment [e x [k target]]
  (let [base {:ty target :span (:span x) :tsi (:tsi x)}]
    (cond
      (= k "NeverToAny") (if (= [:never] target) x (assoc base :k :never-to-any :source x))
      (= k "Deref") (let [st (:ty x)]
                      (if (or (#{:ref :ptr} (first st)) (= "alloc::boxed::Box" (adt-def st)))
                        (assoc base :k :deref :arg x)
                        ;; an overloaded deref: `*Deref::deref(&x)` (DerefMut's when a later autoref is mutable)
                        (let [mutbl (boolean (some (fn [[k2 t2]] (and (= "Borrow" k2) (= :ref (first t2)) (nth t2 2))) (drop-while #(not= % [k target]) (:adj (r-of e)))))
                              bx (assoc base :k :borrow :bk (if mutbl :mut :shared) :arg x :ty [:ref [:re-erased] mutbl st])]
                          (overloaded-place e target bx st (:span x)))))
      (= k "Borrow") (if (= :ptr (first target))
                       (assoc base :k :raw-borrow :mutbl (boolean (second target)) :arg x)
                       (assoc base :k :borrow :bk (if (nth target 2) :mut :shared) :arg x))
      (str/starts-with? (str k) "Pointer") (assoc base :k :pointer-coercion :cast (pointer-cast-kind k) :source x)
      :else (unsupported "an adjustment" k))))

(defn mirror-expr [e]
  (let [x (mirror-unadjusted e)
        x (reduce (partial apply-adjustment e) x (:adj (r-of e)))]
    {:k :scope :region [(:hir-id e) :node] :hir-id (:hir-id e) :value x :ty (:ty x) :span (:span e) :tsi (:hir-id e)}))

(defn mirror-block [b]
  (binding [*names* *names*] (mirror-block* b)))

(defn- mirror-block* [b]
  {:region [(:hir-id b) :node] :span (:span b) :hir-id (:hir-id b)
   :targeted-by-break (boolean (:targeted-by-break b))
   :stmts (vec (keep-indexed
                (fn [i s]
                  (case (:kind s)
                    (:semi :expr) {:k :expr :scope [(:hir-id s) :node] :expr (mirror-expr (:expr s))}
                    :let (let [init (some-> (:init s) mirror-expr)
                               pat (lower-pattern (:pat s))
                               els (some-> (:els s) mirror-block)]
                           (bind-names! pat)
                           {:k :let :remainder [(:hir-id b) [:remainder i]] :init-scope [(:hir-id s) :node]
                          :pattern pat :init init
                          :user-ty (when-let [tsp (and (:ty s)
                                                       (cond (sequential? (:span (:ty s))) (:span (:ty s))
                                                             ;; a derive's `let _: AssertParamIsClone<FieldTy>;`: the field type's span
                                                             (:fspan s) (or (some #(when (vector? (:span (:ty %))) (:span (:ty %)))
                                                                                  (:args (:args (peek (:segs (:path (:ty s)))))))
                                                                            (:fspan s))))]
                                     (if-let [u (:user-ty-text (r-of s))]
                                       {:text (str "user_ty: " u ", span: " (span-text tsp) ", inferred_ty: "
                                                   (binding [c/*in-value* false] (c/print-ty (:ty (r-of (:pat s))))))}
                                       {:span tsp :ty (:ty (r-of (:pat s)))}))
                          :else els :hir-id (:hir-id s) :span (:span s)})
                    nil))
                (:stmts b)))
   :expr (some-> (:expr b) mirror-expr)})

;; patterns (thir/pattern): {:k :wild|:binding|:constant|:leaf|:variant|:deref|:or :ty T ...}
(defn lower-pattern [p]
  (let [r (r-of p)
        ty (:ty r)
        inner
        (case (:kind p)
          :wild {:k :wild :ty ty}
          :binding (let [[by-ref m] (or (:mode r) [:no false])]
                     {:k :binding :ty (if (#{:not :mut} by-ref) (nth ty 3) ty) :var-ty ty :name (:name p) :var (binding-key p) :by-ref by-ref :mutbl m :span (:span p)
                      :sub (some-> (:sub p) lower-pattern) :primary true})
          :lit (let [x (:expr p)
                     [lit neg] (if (and (= :unary (:kind x)) (= "-" (:op x))) [(:lit (:expr x)) true] [(:lit x) false])]
                 {:k :constant :ty ty :lit lit :neg neg})
          :tuple {:k :leaf :ty ty :subpatterns (vec (map-indexed (fn [i sp] [i (lower-pattern sp)]) (:pats p)))}
          (:tuple-struct :struct :path)
          (let [[adt vi vid] (or (ctor-info (:path p)) (unsupported "a pattern path" (:path p)))
                subs (case (:kind p)
                       :tuple-struct (vec (map-indexed (fn [i sp] [i (lower-pattern sp)]) (:pats p)))
                       :struct (mapv (fn [f] [(field-index vid (:ident f)) (lower-pattern (:pat f))]) (:fields p))
                       [])]
            (if (tc/enum? adt)
              {:k :variant :ty ty :adt adt :variant vi :vid vid :subpatterns subs}
              {:k :leaf :ty ty :subpatterns subs}))
          :ref {:k :deref :ty ty :sub (lower-pattern (:pat p))}
          :or {:k :or :ty ty :pats (mapv lower-pattern (:pats p))}
          (unsupported "a pattern" (:kind p)))]
    ;; the implicit dereferences of match ergonomics, outermost first
    (reduce (fn [x rt] {:k :deref :ty rt :sub x}) inner (reverse (:pat-adj r)))))

;; ---------------------------------------------------------------------------------------------
;; The builder's state

(def ^:dynamic *b* nil)   ; atom: the builder (below)

(defn- st [] @*b*)
(defn- upd! [f & args] (apply swap! *b* f args))

;; CFG (cfg.rs)
(defn- start-new-block! [& [cleanup]]
  (let [n (count (:blocks (st)))] (upd! update :blocks conj {:stmts [] :term nil :cleanup (boolean cleanup)}) n))
(defn- push! [bb s] (upd! update-in [:blocks bb :stmts] conj s))
(defn- terminate! [bb t] (upd! assoc-in [:blocks bb :term] t))
(defn- term-of [bb] (get-in (st) [:blocks bb :term]))
(defn- goto! [from to] (terminate! from (list 'goto to)))

;; places {:local N :proj [elem...]}, elems [:deref] [:field i ty] [:index local] [:downcast name vi ty]
(defn- place [l & proj] {:local l :proj (vec proj)})
(defn- project [p e] (update p :proj conj e))

(defn- local-ty [l] (:ty (get (:locals (st)) l)))

(def ^:dynamic *captures* [])   ; the closure body's captures: {:var :hproj :use-place :mut :base-ty}

(defn- hir-kinds
  "convert_to_hir_projections_and_truncate_for_capture: [[kind count] ...], each HIR projection with the MIR elements it took"
  [proj]
  (loop [ps proj variant nil n 0 acc []]
    (if-let [e (first ps)]
      (case (first e)
        :downcast (recur (rest ps) (nth e 2) (inc n) acc)
        :deref (recur (rest ps) nil 0 (conj acc [[:deref] (inc n)]))
        :field (recur (rest ps) nil 0 (conj acc [[:field (second e) (or variant 0)] (inc n)]))
        acc)
      acc)))

(defn- resolve-upvar
  "to_upvars_resolved_place_builder: an upvar place resolved through the capture whose place is its prefix, else as it is"
  [p]
  (if-not (:upvar p)
    p
    (let [hk (hir-kinds (:proj p))]
      (if-let [c (first (filter (fn [c] (and (= (:upvar p) (:var c)) (<= (count (:hproj c)) (count hk))
                                             (= (:hproj c) (mapv first (take (count (:hproj c)) hk)))))
                                *captures*))]
        (let [k (count (:hproj c)) used (reduce + 0 (map second (take k hk)))]
          {:local (:local (:use-place c)) :proj (into (:proj (:use-place c)) (drop used (:proj p)))})
        p))))

(defn- place-ty [p]
  (reduce (fn [t e]
            (case (first e)
              :deref (case (first t) :ref (nth t 3) :ptr (nth t 2) :adt (first (nth t 2)) (unsupported "a deref of" t))
              :field (nth e 2)
              :index (second t)
              :downcast t))
          (if (:upvar p) (:base-ty (first (filter #(= (:upvar p) (:var %)) *captures*))) (local-ty (:local p))) (:proj p)))

(defn- place-form [p]
  (when (:upvar p) (unsupported "an unresolved upvar place" (:upvar p)))
  (apply list 'place (:local p)
         (for [e (:proj p)]
           (case (first e)
             :deref '(deref)
             :field (list 'field (second e) (ty-form (nth e 2)))
             :index (list 'index (second e))
             :downcast (list 'downcast (second e) (nth e 2))))))

(defn- new-local! [ty & {:keys [mut scope] :or {mut true scope 0}}]
  (let [n (count (:locals (st)))] (upd! update :locals conj {:ty ty :mut mut :scope scope}) n))

(defn- temp! [ty] (place (new-local! ty)))

;; operands [:copy P] [:move P] [:const TEXT TY VALUE]
(defn- op-form [o]
  (case (first o)
    :copy (list 'copy (place-form (second o)))
    :move (list 'move (place-form (second o)))
    :const (let [[_ text t v] o] (list 'const text (ty-form t) v))))

(defn- to-copy [o] (if (= :move (first o)) [:copy (second o)] o))

(defn- consume [p] (if (copy? (place-ty p)) [:copy p] [:move p]))

(defn- assign! [bb p rv] (push! bb (list 'assign (place-form p) rv)))
(defn- use-rv [o] (list 'use (op-form o)))

;; constants (as_constant.rs, lit_to_mir_constant) and their text (rustc_middle's pretty printer of scalars)
(defn- int-text [v t]
  (let [n (second t) bits (int-bits n)]
    (cond
      (and (signed? t) (= v (- (pow2 (dec bits))))) (str n "::MIN")
      (and (signed? t) (= v (dec (pow2 (dec bits))))) (str n "::MAX")
      (and (not (signed? t)) (= v (dec (pow2 bits))) (not= n "u8")) (str n "::MAX")
      :else (str v "_" n))))

(defn- scalar-bits [v t]
  (let [bits (int-bits (second t))]
    (if (neg? v) (+ v (pow2 bits)) v)))

(defn int-const [v t]
  [:const (str "const " (int-text (bigint v) t)) t (list 'scalar (scalar-bits (bigint v) t) (quot (int-bits (second t)) 8))])

(defn- bool-const [b] [:const (str "const " b) bool-ty (list 'scalar (if b 1 0) 1)])
(def ^:private unit-const [:const "const ()" unit-ty '(zst)])

(defn- parse-int-lit [lit]
  (let [s (str/replace (str (:symbol lit)) "_" "")]
    (cond (str/starts-with? s "0x") (BigInteger. (subs s 2) 16)
          (str/starts-with? s "0o") (BigInteger. (subs s 2) 8)
          (str/starts-with? s "0b") (BigInteger. (subs s 2) 2)
          :else (BigInteger. s))))

(defn- unesc-char
  "A char literal's escape (`\\n`, `\\u{..}`, `\\x41`)"
  [^String s]
  (case (subs s 1 2)
    "n" "\n" "r" "\r" "t" "\t" "0" "\u0000" "'" "'" "\"" "\"" "\\" "\\"
    "x" (str (char (Integer/parseInt (subs s 2 4) 16)))
    "u" (String. (Character/toChars (Integer/parseInt (subs s 3 (dec (count s))) 16)))
    s))

(defn- float-text
  "rustc_apfloat's Display as MIR prints a float constant: the exact value to 17 (f64) or 9 (f32) significant digits,
  trailing zeros dropped"
  [^double d bits]
  (cond (Double/isNaN d) "NaN"
        (Double/isInfinite d) (if (pos? d) "+Inf" "-Inf")
        (zero? d) (if (neg? (Math/copySign 1.0 d)) "-0" "0")
        :else (let [bd (.round (java.math.BigDecimal. d) (java.math.MathContext. (if (= bits 32) 9 17) java.math.RoundingMode/HALF_EVEN))
                    bd (.stripTrailingZeros bd)]
                (.toPlainString bd))))

(defn float-const [^String txt neg t]
  (let [n (second t)
        txt (str/replace txt "_" "")
        txt (str/replace txt #"f(32|64)$" "")]
    (if (= n "f32")
      (let [f (float (Double/parseDouble txt)) f (if neg (- f) f)]
        [:const (str "const " (float-text (double f) 32) "f32") t (list 'scalar (bit-and (long (Float/floatToRawIntBits f)) 0xffffffff) 4)])
      (let [d (Double/parseDouble txt) d (if neg (- d) d)]
        [:const (str "const " (float-text d 64) "f64") t (list 'scalar (let [b (Double/doubleToRawLongBits d)] (if (neg? b) (+ (bigint b) (pow2 64)) b)) 8)]))))

(defn- char-text [^long c]
  (case c
    10 "'\\n'" 13 "'\\r'" 9 "'\\t'" 0 "'\\0'" 39 "'\\''" 92 "'\\\\'"
    (str "'" (String. (Character/toChars (int c))) "'")))

(defn- escape-ascii
  "u8::escape_ascii: a byte as a byte string's Debug writes it"
  [b]
  (let [b (bit-and (long b) 0xff)]
    (case b
      9 "\\t" 13 "\\r" 10 "\\n" 39 "\\'" 34 "\\\"" 92 "\\\\"
      (if (<= 0x20 b 0x7e) (str (char b)) (format "\\x%02x" b)))))

(defn- byte-unesc
  "A byte string literal's bytes from its symbol (the escapes \\n \\r \\t \\\\ \\0 \\' \\\" \\xNN, a line continuation)"
  [^String sym raw?]
  (if raw?
    (vec (.getBytes sym "UTF-8"))
    (loop [i 0 acc []]
      (if (>= i (count sym))
        acc
        (let [c (.charAt sym i)]
          (if (= c \\)
            (let [d (.charAt sym (inc i))]
              (case d
                \n (recur (+ i 2) (conj acc 10)) \r (recur (+ i 2) (conj acc 13)) \t (recur (+ i 2) (conj acc 9))
                \0 (recur (+ i 2) (conj acc 0)) \\ (recur (+ i 2) (conj acc 92)) \' (recur (+ i 2) (conj acc 39))
                \" (recur (+ i 2) (conj acc 34))
                \x (recur (+ i 4) (conj acc (Integer/parseInt (subs sym (+ i 2) (+ i 4)) 16)))
                \newline (recur (loop [j (+ i 2)] (if (and (< j (count sym)) (Character/isWhitespace (.charAt sym j))) (recur (inc j)) j)) acc)
                (recur (+ i 2) (conj acc (int d)))))
            (recur (inc i) (into acc (map #(bit-and (long %) 0xff) (.getBytes (str c) "UTF-8"))))))))))

(defn- lit-const [lit neg t]
  (case (str (:lit-kind lit))
    "Integer" (let [v (bigint (parse-int-lit lit)) v (if neg (- v) v)]
                (cond (integral? t) (int-const v t)
                      (= :float (first t)) (float-const (str/replace (str (:symbol lit)) "_" "") neg t)
                      :else (unsupported "a literal of" t)))
    "Float" (if (= :float (first t)) (float-const (str (:symbol lit)) neg t) (unsupported "a float literal of" t))
    "Char" (let [sym (str (:symbol lit))
                 c (long (if (str/starts-with? sym "\\") (int (first (unesc-char sym))) (.codePointAt sym 0)))]
             [:const (str "const " (char-text c)) t (list 'scalar c 4)])
    "Bool" (bool-const (= "true" (str (:symbol lit))))
    ("Str" "StrRaw") [:const (str "const " (pr-str (str (:value lit (:symbol lit))))) t '(raw-str)]
    ("ByteStr" "ByteStrRaw")
    (let [bs (or (:bytes lit) (byte-unesc (str (:symbol lit)) (= "ByteStrRaw" (str (:lit-kind lit)))))]
      [:const (str "const b\"" (apply str (map escape-ascii bs)) "\"") t '(raw-bytes)])
    (unsupported "a literal" (:lit-kind lit))))

(defn- fn-const [t]
  [:const (binding [c/*in-value* true c/*erased-regions* true] (c/print-def-path (second t) (mapv #(if (c/region? %) [:re-erased] %) (nth t 2)))) t '(zst)])

(declare push-user-type!)

(defn- as-constant [x]
  (when-let [u (:user-ty x)] (push-user-type! u (or (:fspan x) (:span x)) (:ty x)))
  (case (:k x)
    :literal (lit-const (:lit x) (:neg x) (:ty x))
    :zst-literal (if (= :fndef (first (:ty x))) (fn-const (:ty x)) unit-const)
    (unsupported "a constant" (:k x))))

;; ---------------------------------------------------------------------------------------------
;; Scopes and drop trees (scope.rs)

(def ^:private max-local Long/MAX_VALUE)

(defn- drop-tree [] {:nodes [{:local max-local :kind :storage :next nil}] :map {} :entries []})

(defn- add-drop [tree data next]
  (let [k [next (:local data)]]
    (if-let [i (get (:map tree) k)]
      [tree i]
      (let [i (count (:nodes tree))]
        [(-> tree (update :nodes conj (assoc data :next next)) (assoc-in [:map k] i)) i]))))

(defn- add-entry [tree from to] (update tree :entries conj [to from]))

(defn- build-drop-tree-mir!
  "DropTree::build_mir: assign_blocks then link_blocks; BUILDER :exit or :unwind; returns the blocks by node"
  [tree builder root-block]
  (let [nodes (:nodes tree) n (count nodes)
        blocks (atom (assoc (vec (repeat n nil)) 0 root-block))
        needs (atom (assoc (vec (repeat n :none)) 0 (if root-block :own :none)))
        entries (atom (vec (sort (:entries tree))))
        make (fn [] (if (= builder :unwind) (start-new-block! true) (start-new-block!)))
        link (fn [from to]
               (if (= builder :exit)
                 (let [t (term-of from)]
                   (if (= 'resume (first t)) (goto! from to) (unsupported "an exit entry" t)))
                 (let [t (term-of from)]
                   (case (first t)
                     (call assert false-unwind)
                     (terminate! from (concat (butlast t) [(list 'cleanup to)]))
                     drop (if (= 'cleanup (first (nth t 3)))
                            (goto! (second (nth t 3)) to)
                            (terminate! from (apply list (assoc (vec t) 3 (list 'cleanup to)))))
                     (unsupported "an unwind entry" t)))))]
    (doseq [i (range (dec n) -1 -1)]
      (let [node (nth nodes i)]
        (when (and (seq @entries) (= i (first (peek @entries))))
          (let [b (or (nth @blocks i) (let [b (make)] (swap! blocks assoc i b) b))]
            (swap! needs assoc i :own)
            (while (and (seq @entries) (= i (first (peek @entries))))
              (let [[_ from] (peek @entries)] (swap! entries pop) (link from b)))))
        (let [nb (nth @needs i)]
          (when-not (= :none nb)
            (if (= :own nb)
              (when-not (nth @blocks i) (swap! blocks assoc i (make)))
              (swap! blocks assoc i (nth @blocks (second nb))))
            (if (= :value (:kind node))
              (swap! needs assoc (:next node) :own)
              (when (pos? i)
                (let [p (nth @needs (:next node))]
                  (swap! needs assoc (:next node) (case (if (vector? p) :shares p) :none [:shares i] :shares :own :own :own)))))))))
    ;; link_blocks
    (doseq [i (range (dec n) -1 -1)]
      (when-let [b (nth @blocks i)]
        (let [node (nth nodes i)]
          (case (:kind node)
            :value (terminate! b (list 'drop (place-form (place (:local node))) (nth @blocks (:next node)) '(terminate "cleanup") false nil))
            :storage (when (pos? i)
                       (push! b (list 'storage-dead (:local node)))
                       (let [tgt (nth @blocks (:next node))] (when (not= tgt b) (goto! b tgt))))))))
    @blocks))

(defn- push-scope! [region] (upd! update :scopes conj {:region region :source-scope (:source-scope (st)) :drops [] :moved [] :cached nil}))

(defn- scope-index [region]
  (let [ss (:scopes (st))] (or (last (keep-indexed (fn [i s] (when (= region (:region s)) i)) ss)) (unsupported "a scope not on the stack" region))))

(defn- needs-cleanup? [s] (some #(= :value (:kind %)) (:drops s)))

(defn- diverge-cleanup-target! [region]
  (let [target (scope-index region)
        ss (:scopes (st))
        [uncached cached] (or (some (fn [i] (when-let [c (:cached (nth ss i))] [(inc i) c])) (range target -1 -1)) [0 0])]
    (if (> uncached target)
      cached
      (loop [i uncached cd cached]
        (if (> i target)
          cd
          (let [cd (reduce (fn [cd d] (if (= :value (:kind d))
                                        (let [[t j] (add-drop (:unwind (st)) d cd)] (upd! assoc :unwind t) j)
                                        cd))
                           cd (:drops (nth (:scopes (st)) i)))]
            (upd! assoc-in [:scopes i :cached] cd)
            (recur (inc i) cd)))))))

(defn- diverge-cleanup! [] (diverge-cleanup-target! (:region (peek (:scopes (st))))))

(defn- diverge-from! [bb] (let [d (diverge-cleanup!)] (upd! update :unwind add-entry bb d)))

(defn- build-scope-drops! [s bb unwind-to]
  (loop [ds (rseq (:drops s)) bb bb unwind-to unwind-to]
    (if-let [d (first ds)]
      (case (:kind d)
        :value (let [unwind-to (:next (nth (:nodes (:unwind (st))) unwind-to))]
                 (if (some #{(:local d)} (:moved s))
                   (recur (rest ds) bb unwind-to)
                   (do (upd! update :unwind add-entry bb unwind-to)
                       (let [next (start-new-block!)]
                         (terminate! bb (list 'drop (place-form (place (:local d))) next '(continue) false nil))
                         (recur (rest ds) next unwind-to)))))
        :storage (do (push! bb (list 'storage-dead (:local d))) (recur (rest ds) bb unwind-to)))
      bb)))

(defn- leave-top-scope! [bb]
  (let [s (peek (:scopes (st)))
        unwind-to (if (needs-cleanup? s) (diverge-cleanup!) max-local)]
    (build-scope-drops! (peek (:scopes (st))) bb unwind-to)))

(defn- pop-scope! [region bb]
  (let [bb (leave-top-scope! bb)]
    (upd! update :scopes pop)
    bb))

(defmacro ^:private in-scope
  "in_scope: BODY (returning [block value] or a block) inside the region scope REGION"
  [region & body]
  `(let [ss# (:source-scope (st))
         _# (push-scope! ~region)
         r# (do ~@body)
         [bb# v#] (if (vector? r#) r# [r# nil])
         bb# (pop-scope! ~region bb#)]
     (upd! assoc :source-scope ss#)
     [bb# v#]))

(defn- blk [r] (if (vector? r) (first r) r))

(defn- schedule-drop! [region local kind]
  (let [ss (:scopes (st))
        i (or (last (keep-indexed (fn [i s] (when (= region (:region s)) i)) ss)) (unsupported "a drop's scope" region))]
    (when (= kind :value)
      (doseq [j (range i (count ss))] (upd! assoc-in [:scopes j :cached] nil)))
    (upd! update-in [:scopes i :drops] conj {:local local :kind kind})))

(defn- schedule-drop-storage! [region local] (schedule-drop! region local :storage))
(defn- schedule-drop-value! [region local] (when (needs-drop? (local-ty local)) (schedule-drop! region local :value)))

(defn- record-operands-moved! [ops]
  (let [i (dec (count (:scopes (st)))) s (nth (:scopes (st)) i)]
    (doseq [o ops :when (and (= :move (first o)) (empty? (:proj (second o))))]
      (let [l (:local (second o))]
        (when (some #(and (= l (:local %)) (= :value (:kind %))) (:drops s))
          (upd! update-in [:scopes i :moved] conj l))))))

(defn- local-scope [] (:region (peek (:scopes (st)))))

(defn- build-exit-tree!
  "build_exit_tree: the exits' drop tree into blocks; the root's block (or nil)"
  [tree else-region continue-block]
  (let [blocks (build-drop-tree-mir! tree :exit continue-block)]
    (when (some #(= :value (:kind %)) (:nodes tree))
      (let [ut (diverge-cleanup-target! else-region)
            idx (atom [ut])]
        (doseq [i (range 1 (count (:nodes tree)))]
          (let [node (nth (:nodes tree) i)]
            (if (= :value (:kind node))
              (let [[t j] (add-drop (:unwind (st)) node (nth @idx (:next node)))]
                (upd! assoc :unwind t)
                (upd! update :unwind add-entry (nth blocks i) (nth @idx (:next node)))
                (swap! idx conj j))
              (swap! idx conj (nth @idx (:next node))))))))
    (nth blocks 0)))

(defn- in-breakable-scope [loop-block dest f]
  (let [region (local-scope)]
    (upd! update :breakables conj {:region region :dest dest :break (drop-tree) :continue (when loop-block (drop-tree))})
    (let [normal (f)
          bs (peek (:breakables (st)))]
      (upd! update :breakables pop)
      (let [brk (build-exit-tree! (:break bs) region nil)]
        (when (:continue bs) (build-exit-tree! (:continue bs) region loop-block))
        (cond (and normal (nil? brk)) normal
              (and (nil? normal) brk) brk
              (and (nil? normal) (nil? brk)) (start-new-block!)
              :else (let [t (start-new-block!)] (goto! normal t) (goto! brk t) t))))))

(defn- in-if-then-scope [region f]
  (let [prev (:if-then (st))]
    (upd! assoc :if-then {:region region :else (drop-tree)})
    (let [then (blk (f))
          its (:if-then (st))]
      (upd! assoc :if-then prev)
      [then (or (build-exit-tree! (:else its) region nil) (start-new-block!))])))

(defn- drops-above [stack-index]
  (for [s (subvec (:scopes (st)) (inc stack-index)) d (:drops s)] d))

(declare expr-into-dest upvar-symbol-fields limit-capture-mutability! category)

(defn- break-scope! [bb value target]
  (let [bss (:breakables (st))
        [bi dest] (case (first target)
                    :return [0 (:dest (nth bss 0))]
                    :break (let [i (or (last (keep-indexed (fn [i b] (when (= (second target) (:region b)) i)) bss)) (unsupported "a break target"))]
                             [i (:dest (nth bss i))])
                    :continue [(or (last (keep-indexed (fn [i b] (when (= (second target) (:region b)) i)) bss)) (unsupported "a continue target")) nil])
        bb (cond (and dest value) (do (upd! update :block-context conj :sub-expr)
                                      (let [b (blk (expr-into-dest dest bb value))] (upd! update :block-context pop) b))
                 dest (do (assign! bb dest (use-rv unit-const)) bb)
                 :else bb)
        region (:region (nth (:breakables (st)) bi))
        si (scope-index region)
        k (if dest :break :continue)
        [tree idx] (reduce (fn [[t i] d] (add-drop t d i)) [(get-in (st) [:breakables bi k]) 0] (drops-above si))]
    (upd! assoc-in [:breakables bi k] (add-entry tree bb idx))
    (terminate! bb '(resume))
    (start-new-block!)))

(defn- break-for-else! [bb]
  (let [its (:if-then (st))
        si (scope-index (:region its))
        [tree idx] (reduce (fn [[t i] d] (add-drop t d i)) [(:else its) 0] (drops-above si))]
    (upd! assoc-in [:if-then :else] (add-entry tree bb idx))
    (terminate! bb '(resume))))

(defn- new-source-scope! []
  (let [n (count (:source-scopes (st)))] (upd! update :source-scopes conj [(:source-scope (st)) nil]) n))

(defn- assert! [bb cond expected msg]
  (let [ok (start-new-block!)]
    (terminate! bb (list 'assert (op-form cond) expected msg ok '(continue)))
    (diverge-from! bb)
    ok))

(defn- get-unit-temp! []
  (or (:unit-temp (st)) (let [p (temp! unit-ty)] (upd! assoc :unit-temp p) p)))

;; ---------------------------------------------------------------------------------------------
;; Expressions (expr/*.rs)

(defn- category [x]
  (case (:k x)
    :scope nil
    (:field :deref :index :var-ref :upvar-ref) :place
    (:logical :match :if :let :never-to-any :use :adt :borrow :raw-borrow :call :loop :block :break :continue :return) :into
    (:array :tuple :closure :unary :binary :cast :pointer-coercion :repeat :assign :assign-op) :rvalue
    (:literal :zst-literal :named-const) :constant))

(declare ast-block-stmts primary-bindings then-else-break-default as-operand as-temp as-place as-rvalue stmt-expr then-else-break match-expr expr-into-pattern declare-bindings
         storage-live-binding! schedule-drop-for-binding!)

(def ^:dynamic *fake-borrow-temps* nil)   ; the outermost index expression's fake borrows (lower_index_expression)

(defn- add-fake-borrows-of-base!
  "add_fake_borrows_of_base: an inner index of a slice keeps the pointers of its base place by shallow fake borrows"
  [bb base]
  (when (= :slice (first (place-ty base)))
    (loop [i (dec (count (:proj base)))]
      (when (>= i 0)
        (let [e (nth (:proj base) i) pre {:local (:local base) :proj (subvec (:proj base) 0 i)}]
          (case (first e)
            :deref (let [t (new-local! [:ref [:re-erased] false (place-ty pre)])]
                     (assign! bb (place t) (list 'ref :fake-shallow (place-form pre)))
                     (swap! *fake-borrow-temps* conj t)
                     (recur (dec i)))
            :index (when-not (= :slice (first (place-ty pre))) (recur (dec i)))
            (recur (dec i))))))))

(defn- var-local [id] (or (get (:var-indices (st)) id) (unsupported "a variable" id)))

(defn- expr-as-place [bb x mutability]
  (case (:k x)
    :scope (in-scope (:region x) (expr-as-place bb (:value x) mutability))
    :field (let [[bb pb] (expr-as-place bb (:lhs x) mutability)
                 lt (:ty (:lhs x))
                 pb (if (and (= :adt (first lt)) (tc/enum? (second lt))) (project pb [:downcast nil (:variant x) lt]) pb)]
             [bb (resolve-upvar (project pb [:field (:name x) (:ty x)]))])
    :deref (let [[bb pb] (expr-as-place bb (:arg x) mutability)] [bb (resolve-upvar (project pb [:deref]))])
    :upvar-ref [bb (resolve-upvar {:upvar (:id x) :proj []})]
    :index (let [outer? (nil? *fake-borrow-temps*)]
             (binding [*fake-borrow-temps* (or *fake-borrow-temps* (atom []))]
               (let [[bb base] (expr-as-place bb (:lhs x) mutability)
                     [bb idx] (as-temp bb (temporary-scope (:tsi (:index x))) (:index x) :not)
                     bt (place-ty base)
                     ;; len_of_slice_or_array
                     len (case (first bt)
                           :array (do (push! bb (list 'fake-read "ForIndex" (place-form base)))
                                      (let [n (c/print-const (nth bt 2))] [:const (str "const " n "_usize") usize-ty (list 'scalar (parse-long n) 8)]))
                           :slice (let [ptr (if (and (= [[:deref]] (:proj base)) (copy? (local-ty (:local base))))
                                              [:copy (place (:local base))]
                                              (let [t (temp! [:ptr false bt])]
                                                (assign! bb t (list 'rawptr "const (fake)" (place-form base)))
                                                [:move t]))
                                        l (temp! usize-ty)]
                                    (assign! bb l (list 'unop "PtrMetadata" (op-form ptr)))
                                    [:move l])
                           (unsupported "an index of" bt))
                     lt (temp! bool-ty)]
                 (assign! bb lt (list 'binop "Lt" (op-form [:copy (place idx)]) (op-form (to-copy len))))
                 (let [bb (assert! bb [:move lt] true (list 'bounds-check (op-form len) (op-form [:copy (place idx)])))]
                   (if outer?
                     (doseq [t @*fake-borrow-temps*] (push! bb (list 'fake-read "ForIndex" (place-form (place t)))))
                     (add-fake-borrows-of-base! bb base))
                   [bb (project base [:index idx])]))))
    :var-ref [bb (place (var-local (:id x)))]
    (let [[bb t] (as-temp bb (temporary-scope (:tsi x)) x mutability)] [bb (place t)])))

(defn as-place [bb x] (binding [*fake-borrow-temps* nil] (expr-as-place bb x :mut)))
(defn- as-read-only-place [bb x] (binding [*fake-borrow-temps* nil] (expr-as-place bb x :not)))

(defn- in-block-tail? [] (= :tail (peek (:block-context (st)))))

(defn as-temp [bb temp-lifetime x mutability]
  (if (= :scope (:k x))
    (let [[bb v] (in-scope (:region x) (as-temp bb temp-lifetime (:value x) mutability))] [bb v])
    (let [t (new-local! (:ty x) :mut (not= mutability :not))]
      (when-not (or (#{:break :continue :return} (:k x))
                    (and (= :block (:k x)) (nil? (:expr (:block x))) (not (:targeted-by-break (:block x))) (= [:never] (:ty x))))
        (push! bb (list 'storage-live t))
        (when temp-lifetime (schedule-drop-storage! temp-lifetime t)))
      (let [bb (blk (expr-into-dest (place t) bb x))]
        (when temp-lifetime (schedule-drop-value! temp-lifetime t))
        [bb t]))))

(defn as-operand [bb scope x & [needs-temp]]
  (if (= :scope (:k x))
    (in-scope (:region x) (as-operand bb scope (:value x) needs-temp))
    (case (category x)
      :constant (if (or (= needs-temp :no) (not (needs-drop? (:ty x))))
                  [bb (as-constant x)]
                  (let [[bb t] (as-temp bb scope x :mut)] [bb [:move (place t)]]))
      (let [[bb t] (as-temp bb scope x :mut)] [bb [:move (place t)]]))))

(defn- as-local-operand [bb x] (as-operand bb (local-scope) x :maybe))
(defn- as-local-call-operand [bb x] (as-operand bb (local-scope) x :maybe))

(defn- min-const [t] (int-const (- (pow2 (dec (int-bits (second t))))) t))

(defn- build-binary-op [bb op ty lhs rhs]
  (let [co (:check-overflow (st))]
    (cond
      (and (#{"Add" "Sub" "Mul"} op) co (integral? ty))
      (let [res (temp! [:tuple [ty bool-ty]])]
        (assign! bb res (list 'binop (str op "WithOverflow") (op-form (to-copy lhs)) (op-form (to-copy rhs))))
        (let [bb (assert! bb [:move (project res [:field 1 bool-ty])] false (list 'overflow op (op-form lhs) (op-form rhs)))]
          [bb (use-rv [:move (project res [:field 0 ty])])]))
      (and (#{"Shl" "Shr"} op) co (integral? ty))
      (let [rt (case (first rhs) :const (nth rhs 2) (place-ty (second rhs)))
            [bb urhs uty] (if (= :uint (first rt))
                            [bb (to-copy rhs) rt]
                            (let [ut [:uint (str "u" (subs (second rt) 1))] tmp (temp! ut)]
                              (assign! bb tmp (list 'cast "IntToInt" (op-form (to-copy rhs)) (ty-form ut)))
                              [bb [:move tmp] ut]))
            bits (int-const (int-bits (second ty)) uty)
            inb (temp! bool-ty)]
        (assign! bb inb (list 'binop "Lt" (op-form urhs) (op-form bits)))
        (let [bb (assert! bb [:move inb] true (list 'overflow op (op-form (to-copy lhs)) (op-form (to-copy rhs))))]
          [bb (list 'binop op (op-form lhs) (op-form rhs))]))
      (and (#{"Div" "Rem"} op) (integral? ty))
      (let [zero-err (if (= op "Div") (list 'div-zero (op-form (to-copy lhs))) (list 'rem-zero (op-form (to-copy lhs))))
            of-err (list 'overflow op (op-form (to-copy lhs)) (op-form (to-copy rhs)))
            isz (temp! bool-ty)]
        (assign! bb isz (list 'binop "Eq" (op-form (to-copy rhs)) (op-form (int-const 0 ty))))
        (let [bb (assert! bb [:move isz] false zero-err)
              bb (if (signed? ty)
                   (let [n1 (temp! bool-ty) mn (temp! bool-ty) of (temp! bool-ty)]
                     (assign! bb n1 (list 'binop "Eq" (op-form (to-copy rhs)) (op-form (int-const -1 ty))))
                     (assign! bb mn (list 'binop "Eq" (op-form (to-copy lhs)) (op-form (min-const ty))))
                     (assign! bb of (list 'binop "BitAnd" (op-form [:move n1]) (op-form [:move mn])))
                     (assert! bb [:move of] false of-err))
                   bb)]
          [bb (list 'binop op (op-form lhs) (op-form rhs))]))
      :else [bb (list 'binop op (op-form lhs) (op-form rhs))])))

(defn- cast-kind [from to]
  (cond (and (integral? from) (integral? to)) "IntToInt"
        (and (= :bool (first from)) (integral? to)) "IntToInt"
        (and (= :char (first from)) (integral? to)) "IntToInt"
        (and (integral? from) (= :float (first to))) "IntToFloat"
        (and (= :float (first from)) (integral? to)) "FloatToInt"
        (and (= :float (first from)) (= :float (first to))) "FloatToFloat"
        (and (= :ptr (first from)) (= :ptr (first to))) "PtrToPtr"
        :else (unsupported "a cast" [from to])))

(defn as-rvalue [bb scope x]
  (case (:k x)
    :scope (in-scope (:region x) (as-rvalue bb scope (:value x)))
    :binary (let [[bb l] (as-operand bb scope (:lhs x) :maybe)
                  [bb r] (as-operand bb scope (:rhs x) :no)]
              (build-binary-op bb (:op x) (:ty x) l r))
    :unary (let [[bb a] (as-operand bb scope (:arg x) :no)
                 bb (if (and (:check-overflow (st)) (= "Neg" (:op x)) (signed? (:ty x)))
                      (let [m (temp! bool-ty)]
                        (assign! bb m (list 'binop "Eq" (op-form (to-copy a)) (op-form (min-const (:ty x)))))
                        (assert! bb [:move m] false (list 'overflow-neg (op-form (to-copy a)))))
                      bb)]
             [bb (list 'unop (:op x) (op-form a))])
    :cast (let [src (:source x) st* (:ty src)]
            (if (and (= :adt (first st*)) (tc/enum? (second st*)))
              (let [[bb t] (as-temp bb scope src :not)
                    dt (tc/discr-ty (second st*))
                    d (temp! dt)]
                (assign! bb d (list 'discriminant (place-form (place t))))
                [bb (list 'cast (cast-kind dt (:ty x)) (op-form [:move d]) (ty-form (:ty x)))])
              (let [[bb s] (as-operand bb scope src :no)]
                [bb (list 'cast (cast-kind st* (:ty x)) (op-form s) (ty-form (:ty x)))])))
    :pointer-coercion (let [[bb s] (as-operand bb scope (:source x) :no)]
                        [bb (list 'cast (str "PointerCoercion(" (:cast x) ", Implicit)") (op-form s) (ty-form (:ty x)))])
    :repeat (let [n (c/print-const (:count x))]
              (if (= "0" (str n))
                (unsupported "a zero-length repeat")
                (let [[bb o] (as-operand bb scope (:value x) :no)]
                  [bb (list 'repeat (op-form o) (str n))])))
    :array (let [[bb os] (reduce (fn [[bb os] f] (let [[bb o] (as-operand bb scope f :maybe)] [bb (conj os o)])) [bb []] (:fields x))]
             [bb (list 'aggregate (list 'array (ty-form (second (:ty x)))) (mapv op-form os))])
    :tuple (let [[bb os] (reduce (fn [[bb os] f] (let [[bb o] (as-operand bb scope f :maybe)] [bb (conj os o)])) [bb []] (:fields x))]
             [bb (list 'aggregate '(tuple) (mapv op-form os))])
    :closure (let [info (:info x)
                   [bb os] (reduce (fn [[bb os] u]
                                     (cond (= :place (category u)) (let [[bb p] (as-place bb u)] [bb (conj os (consume p))])
                                           (and (= :borrow (:k u)) (= :mut (:bk u))) (let [[bb o] (limit-capture-mutability! bb u scope)] [bb (conj os o)])
                                           :else (let [[bb o] (as-operand bb scope u :maybe)] [bb (conj os o)])))
                                   [bb []] (:upvars x))
                   text (second (:ty x))
                   span (subs text (count "{closure@") (dec (count text)))
                   names (if (seq (:upvar-names info)) (mapv str (:upvar-names info)) (mapv str (range (count os))))]
               [bb (list 'aggregate (list 'closure text [] (vec (take (count os) names)) span) (mapv op-form os))])
    (:assign :assign-op) (let [bb (blk (stmt-expr bb x nil))] [bb (use-rv unit-const)])
    (:literal :zst-literal :named-const) [bb (use-rv (as-constant x))]
    ;; the rest: an operand (into a temporary)
    (let [[bb o] (as-operand bb scope x :no)] [bb (use-rv o)])))

(defn- place-root [x] (case (:k x) (:field :deref) (place-root (or (:lhs x) (:arg x))) :scope (place-root (:value x)) x))

(defn- limit-capture-mutability!
  "limit_capture_mutability: a mutable capture's borrow into a temporary, `&uniq` when the captured variable (the parent's
  local, or the enclosing closure's capture) is not mutable"
  [bb u temp-lifetime]
  (let [t (new-local! (:ty u))]
    (push! bb (list 'storage-live t))
    (let [[bb p] (as-place bb (:arg u))
          mutable (if (= :upvar-ref (:k (place-root (:arg u))))
                    (let [i (some (fn [e] (when (= :field (first e)) (second e))) (take 2 (:proj p)))]
                      (:mut (nth *captures* i)))
                    (:mut (get (:locals (st)) (:local p))))]
      (assign! bb (place t) (list 'ref (if mutable :mut :unique) (place-form p)))
      (when temp-lifetime (schedule-drop-storage! temp-lifetime t) (schedule-drop-value! temp-lifetime t))
      [bb [:move (place t)]])))

(defn- as-local-rvalue [bb x] (as-rvalue bb (local-scope) x))

(defn- adt-agg [x os]
  (let [vid (:vid x) adt (:adt x) enum (tc/enum? adt)
        args (nth (:ty x) 2)
        nm (binding [c/*in-value* true] (c/print-def-path vid args))
        kind (tc/variant-ctor-kind vid)]
    (list 'adt nm kind (mapv (comp str first) (tc/all-fields-of-variant vid))
          (binding [c/*in-value* false] (c/print-def-path adt [])) (:variant x) (vec (for [a args] (if (c/region? a) '(lt) (ty-form a)))))))

(defn expr-into-dest [dest bb x]
  (let [scope? (#{:block :scope} (:k x))]
    (when-not scope? (upd! update :block-context conj :sub-expr))
    (let [r
          (case (:k x)
            :scope (in-scope (:region x) (expr-into-dest dest bb (:value x)))
            :block (let [b (:block x)]
                     (in-scope (:region b)
                       (if (:targeted-by-break b)
                         (in-breakable-scope nil dest (fn [] (blk (ast-block-stmts dest bb b))))
                         (blk (ast-block-stmts dest bb b)))))
            :match (match-expr dest bb x)
            :if (let [then-x (:then x)
                      cond-scope (local-scope)
                      [[then-b else-b] _]
                      (let [ss (:source-scope (st))
                            _ (push-scope! (:if-then-scope x))
                            [tb eb] (do (when (= :let (:k (:value (:cond x)))) (upd! assoc :source-scope (new-source-scope!)))
                                        (in-if-then-scope cond-scope
                                          (fn [] (let [tb (blk (then-else-break bb (:cond x) cond-scope))]
                                                   (blk (expr-into-dest dest tb then-x))))))
                            tb (pop-scope! (:if-then-scope x) tb)]
                        (upd! assoc :source-scope ss)
                        [[tb eb] nil])
                      else-b (if (:else x)
                               (blk (expr-into-dest dest else-b (:else x)))
                               (do (assign! else-b dest (use-rv unit-const)) else-b))
                      join (start-new-block!)]
                  (goto! then-b join) (goto! else-b join) join)
            :never-to-any (let [src (:source x)
                                call? (= :call (:k (loop [s src] (if (= :scope (:k s)) (recur (:value s)) s))))
                                [bb _] (as-temp bb (local-scope) src :mut)]
                            (if call? bb (do (terminate! bb '(unreachable)) (start-new-block!))))
            :logical (let [cs (local-scope)
                           [then-b else-b] (in-if-then-scope cs (fn [] (then-else-break bb (:lhs x) cs)))
                           [short cont c] (if (= :and (:op x)) [else-b then-b false] [then-b else-b true])]
                       (assign! short dest (use-rv (bool-const c)))
                       (let [rb (blk (expr-into-dest dest cont (:rhs x)))
                             t (start-new-block!)]
                         (goto! rb t) (goto! short t) t))
            :loop (let [lb (start-new-block!)]
                    (goto! bb lb)
                    (in-breakable-scope lb dest
                      (fn []
                        (let [body (start-new-block!)]
                          (terminate! lb (list 'false-unwind body '(continue)))
                          (diverge-from! lb)
                          (let [tmp (get-unit-temp!)
                                end (blk (expr-into-dest tmp body (:body x)))]
                            (goto! end lb)
                            nil)))))
            :call (let [[bb f] (as-local-operand bb (:fun x))
                        [bb args] (reduce (fn [[bb as] a] (let [[bb o] (as-local-call-operand bb a)] [bb (conj as o)])) [bb []] (:args x))
                        ok (start-new-block!)]
                    (record-operands-moved! args)
                    (terminate! bb (list 'call (op-form f) (mapv op-form args) (place-form dest) ok '(continue)))
                    (diverge-from! bb)
                    ok)
            :use (expr-into-dest dest bb (:source x))
            :borrow (let [[bb p] (if (= :shared (:bk x)) (as-read-only-place bb (:arg x)) (as-place bb (:arg x)))]
                      (assign! bb dest (list 'ref (:bk x) (place-form p))) bb)
            :raw-borrow (let [[bb p] (if (:mutbl x) (as-place bb (:arg x)) (as-read-only-place bb (:arg x)))]
                          (assign! bb dest (list 'rawptr (if (:mutbl x) "mut" "const") (place-form p))) bb)
            :adt (let [scope (local-scope)
                       [bb m] (reduce (fn [[bb m] [i f]] (let [[bb o] (as-operand bb scope f :maybe)] [bb (assoc m i o)])) [bb {}] (:fields x))
                       n (count (tc/all-fields-of-variant (:vid x)))
                       os (keep #(get m %) (range n))]
                   (assign! bb dest (list 'aggregate (adt-agg x os) (mapv op-form os))) bb)
            (:assign :assign-op) (let [bb (blk (stmt-expr bb x nil))] (assign! bb dest (use-rv unit-const)) bb)
            (:continue :break :return) (blk (stmt-expr bb x nil))
            (:var-ref :upvar-ref :field :deref :index)
            (let [[bb p] (as-place bb x)] (assign! bb dest (use-rv (consume p))) bb)
            ;; rvalues and constants
            (let [[bb rv] (as-local-rvalue bb x)] (assign! bb dest rv) bb))]
      (when-not scope? (upd! update :block-context pop))
      r)))

(defn stmt-expr [bb x stmt-scope]
  (case (:k x)
    :scope (in-scope (:region x) (blk (stmt-expr bb (:value x) stmt-scope)))
    :assign (do (upd! update :block-context conj :sub-expr)
                (let [[bb rv] (as-local-rvalue bb (:rhs x))
                      [bb p] (as-place bb (:lhs x))
                      bb (if (needs-drop? (:ty (:lhs x)))
                           ;; build_drop_and_replace: the old value dropped (a replace), the assignment on both edges
                           (let [assign (start-new-block!) assign-unwind (start-new-block! true)]
                             (assign! assign p rv)
                             (assign! assign-unwind p rv)
                             (terminate! bb (list 'drop (place-form p) assign (list 'cleanup assign-unwind) true nil))
                             (diverge-from! bb)
                             assign)
                           (do (assign! bb p rv) bb))]
                  (upd! update :block-context pop)
                  bb))
    :assign-op (do (upd! update :block-context conj :sub-expr)
                   (let [[bb r] (as-local-operand bb (:rhs x))
                         [bb p] (as-place bb (:lhs x))
                         [bb rv] (build-binary-op bb (:op x) (:ty (:lhs x)) [:copy p] r)]
                     (assign! bb p rv)
                     (upd! update :block-context pop)
                     bb))
    :continue (break-scope! bb nil [:continue (:label x)])
    :break (break-scope! bb (:value x) [:break (:label x)])
    :return (break-scope! bb (:value x) [:return])
    (let [tail-adjust (when (= :block (:k x)) (:expr (:block x)))]
      (when tail-adjust (upd! update :block-context conj :tail-ignored))
      (let [[bb _] (as-temp bb stmt-scope x :not)]
        (when tail-adjust (upd! update :block-context pop))
        bb))))

;; ---------------------------------------------------------------------------------------------
;; Blocks (block.rs)

(defn- ast-block-stmts [dest bb b]
  (let [outer (:source-scope (st))
        lets (atom [])
        bb (reduce
            (fn [bb s]
              (case (:k s)
                :expr (do (upd! update :block-context conj :stmt)
                          (let [bb (blk (in-scope (:scope s) (stmt-expr bb (:expr s) (:scope s))))]
                            (upd! update :block-context pop) bb))
                :let (do
                       (when (:else s) (unsupported "let-else"))
                       (upd! update :block-context conj :stmt)
                       (push-scope! (:remainder s))
                       (swap! lets conj (:remainder s))
                       (let [vis (new-source-scope!)
                             ut (when-let [u (:user-ty s)] (let [i (count (:user-types (st)))] (upd! update :user-types (fnil conj []) u) i))
                             _ (upd! assoc :let-user-ty ut)
                             bb (if-let [init (:init s)]
                                  (blk (in-scope (:init-scope s)
                                         (declare-bindings vis (:pattern s) ut)
                                         (expr-into-pattern bb (:pattern s) init)))
                                  (do (in-scope (:init-scope s) (declare-bindings vis (:pattern s) ut) bb)
                                      (doseq [p (primary-bindings (:pattern s))]
                                        (storage-live-binding! bb (:var p))
                                        (schedule-drop-for-binding! (:var p)))
                                      bb))]
                         (upd! assoc :source-scope vis)
                         (upd! update :block-context pop)
                         bb))))
            bb (:stmts b))
        dty (place-ty dest)
        bb (if-let [x (:expr b)]
             (do (upd! update :block-context conj :tail)
                 (let [bb (blk (expr-into-dest dest bb x))] (upd! update :block-context pop) bb))
             (do (when (= unit-ty dty) (assign! bb dest (use-rv unit-const))) bb))
        bb (reduce (fn [bb r] (pop-scope! r bb)) bb (rseq @lets))]
    (upd! assoc :source-scope outer)
    bb))

;; ---------------------------------------------------------------------------------------------
;; Bindings and patterns (matches/mod.rs)

(defn- walk-pat [p f]
  (when p
    (f p)
    (case (:k p)
      :binding (walk-pat (:sub p) f)
      (:leaf :variant) (doseq [[_ sp] (:subpatterns p)] (walk-pat sp f))
      :deref (walk-pat (:sub p) f)
      :or (walk-pat (first (:pats p)) f)
      nil)))

(defn- primary-bindings [p] (let [acc (atom [])] (walk-pat p #(when (= :binding (:k %)) (swap! acc conj %))) @acc))

(defn- binding-local-ty [p] (case (:by-ref p) :not [:ref [:re-erased] false (:ty p)] :mut [:ref [:re-erased] true (:ty p)] (:ty p)))

(defn declare-bindings
  "declare_bindings: each primary binding a local in the current source scope, its debug info in VIS (made on the first
  binding when nil); the visibility scope"
  [vis pattern & [user-ty]]
  (reduce (fn [vis p]
            (let [vis (or vis (new-source-scope!))
                  l (new-local! (:var-ty p) :mut (:mutbl p) :scope (:source-scope (st)))]
              ;; declare_binding's user type projections: the let's annotation at the pattern itself
              (when (and user-ty (identical? p pattern))
                (upd! assoc-in [:locals l :user-ty] [(str "UserTypeProjection { base: UserType(" user-ty "), projs: [] }")]))
              (upd! update :debug conj {:name (:name p) :scope vis :value (place-form (place l))})
              (upd! assoc-in [:var-indices (:var p)] l)
              vis))
          vis (primary-bindings pattern)))

(defn storage-live-binding! [bb var]
  (let [l (var-local var)]
    (push! bb (list 'storage-live l))
    (when-let [r (var-scope var)] (schedule-drop-storage! r l))
    (place l)))

(defn schedule-drop-for-binding! [var]
  (when-let [r (var-scope var)] (schedule-drop-value! r (var-local var))))

(declare lower-match-tree bind-pattern lower-scrutinee place-into-pattern)

(defn expr-into-pattern [bb pat init]
  (if (and (= :binding (:k pat)) (= :no (:by-ref pat)) (nil? (:sub pat)))
    (let [i0 (:let-user-ty (st))
          p (storage-live-binding! bb (:var pat))
          bb (blk (expr-into-dest p bb init))]
      (push! bb (list 'fake-read "ForLet(None)" (place-form p)))
      ;; expr_into_pattern's ascription: the annotation pushed again (declare_bindings pushed it first), after the initializer
      (when i0
        (let [i (count (:user-types (st)))]
          (upd! update :user-types conj (nth (:user-types (st)) i0))
          (push! bb (list 'raw (str "AscribeUserType(" (mir/place (place-form p)) ", o, UserTypeProjection { base: UserType(" i "), projs: [] })")))))
      (schedule-drop-for-binding! (:var pat))
      bb)
    (let [[bb pb] (lower-scrutinee bb init)]
      (place-into-pattern bb pat pb))))

(defn then-else-break [bb x temp-scope]
  (case (:k x)
    :logical (if (= :and (:op x))
               (let [lb (blk (then-else-break bb (:lhs x) temp-scope))] (blk (then-else-break lb (:rhs x) temp-scope)))
               (let [ls (local-scope)
                     [lok fail] (in-if-then-scope ls (fn [] (then-else-break bb (:lhs x) temp-scope)))
                     rok (blk (then-else-break fail (:rhs x) temp-scope))
                     ok (start-new-block!)]
                 (goto! lok ok) (goto! rok ok) ok))
    :unary (if (= "Not" (:op x))
             (let [ls (local-scope)
                   [ok fail] (in-if-then-scope ls (fn [] (then-else-break bb (:arg x) temp-scope)))]
               (break-for-else! ok)
               fail)
             (then-else-break-default bb x temp-scope))
    :scope (blk (in-scope (:region x) (then-else-break bb (:value x) temp-scope)))
    :use (then-else-break bb (:source x) temp-scope)
    :let (unsupported "if let")
    (then-else-break-default bb x temp-scope)))

(defn- then-else-break-default [bb x temp-scope]
  (let [ts (or temp-scope (local-scope))
        [bb t] (as-temp bb ts x :mut)
        then-b (start-new-block!)
        else-b (start-new-block!)]
    (terminate! bb (list 'switch (op-form [:move (place t)]) [[0 else-b]] then-b))
    (break-for-else! else-b)
    then-b))

;; the match lowering (matches/mod.rs, match_pair.rs, buckets.rs, test.rs): candidates as atoms
;; {:pairs [pair] :subs [] :guard bool :bindings [binding] :pre :otherwise :fe-start}, a pair {:place P :case CASE
;; :subpairs [pair]}, CASE [:variant ADT VI] [:const VALUE :int|:bool]

(defn- inter-pat
  "InterPat::lower_thir_pat squashed (squash_inter_pat): [pairs bindings] of a pattern at a place"
  [pb pat]
  (let [pairs (atom []) bindings (atom [])]
    (letfn [(walk [pb pat out]
              (let [subs (atom [])
                    case
                    (case (:k pat)
                      :wild nil
                      :binding (do (when (:sub pat) (walk pb (:sub pat) subs))
                                   (swap! bindings conj {:span (:span pat) :source pb :var (:var pat) :by-ref (:by-ref pat)})
                                   nil)
                      :constant (let [c (lit-const (:lit pat) (:neg pat) (:ty pat))]
                                  [:const c (if (= :bool (first (:ty pat))) :bool :int)])
                      :leaf (do (doseq [[f sp] (:subpatterns pat)] (walk (project pb [:field f (:ty sp)]) sp subs)) nil)
                      :variant (let [dp (project pb [:downcast (tc/variant-name (:vid pat)) (:variant pat) (:ty pat)])]
                                 (doseq [[f sp] (:subpatterns pat)] (walk (project dp [:field f (:ty sp)]) sp subs))
                                 (when (> (count (tc/variants-any (:adt pat))) 1) [:variant (:adt pat) (:variant pat)]))
                      :deref (do (walk (project pb [:deref]) (:sub pat) subs) nil)
                      (unsupported "a pattern" (:k pat)))]
                (if case
                  (swap! out conj {:place pb :case case :subpairs @subs})
                  (swap! out into @subs))))]
      ;; (the binding's push follows its subpatterns': bindings are pushed post-order by walk itself)
      (walk pb pat pairs))
    [@pairs @bindings]))

(defn- new-candidate [pb pat guard]
  (let [[pairs bindings] (inter-pat pb pat)]
    (atom {:pairs pairs :bindings bindings :guard guard :span (:span pat)})))

(defn- pick-test [cands]
  (let [mp (first (:pairs @(first cands)))
        kind (case (first (:case mp)) :variant [:switch (second (:case mp))] :const (if (= :bool (nth (:case mp) 2)) [:if] [:switch-int]))]
    [(:place mp) kind]))

(defn- choose-bucket! [place test cand]
  (let [ps (:pairs @cand)
        i (first (keep-indexed (fn [i mp] (when (= place (:place mp)) i)) ps))]
    (when i
      (let [mp (nth ps i)
            [branch full]
            (case (first test)
              :switch (if (= :variant (first (:case mp))) [[:variant (nth (:case mp) 2)] true] [nil false])
              :switch-int (if (and (= :const (first (:case mp))) (= :int (nth (:case mp) 2))) [[:const (second (:case mp))] true] [nil false])
              :if (if (and (= :const (first (:case mp))) (= :bool (nth (:case mp) 2)))
                    [(if (= "const true" (second (second (:case mp)))) [:success] [:failure]) true]
                    [nil false]))]
        (when full
          (swap! cand (fn [c] (assoc c :pairs (into (vec (concat (subvec ps 0 i) (subvec ps (inc i)))) (:subpairs mp))))))
        branch))))

(defn- discriminants [adt]
  (tc/discriminant-values adt))

(declare match-candidates)

(defn- perform-test! [bb otherwise place test targets]
  (let [target (fn [br] (or (some (fn [[b blk]] (when (= b br) blk)) targets) otherwise))]
    (case (first test)
      :switch (let [adt (second test)
                    vals (keep (fn [[vi d]] (when-let [b (some (fn [[br blk]] (when (= br [:variant vi]) blk)) targets)] [d b])) (map-indexed vector (discriminants adt)))
                    dt (tc/discr-ty adt)
                    d (temp! dt)]
                (assign! bb d (list 'discriminant (place-form place)))
                (terminate! bb (list 'switch (op-form [:move d]) (vec vals) (target [:failure]))))
      :switch-int (let [vals (keep (fn [[br blk]] (when (= :const (first br)) [(second (nth (second br) 3)) blk])) targets)]
                    (terminate! bb (list 'switch (op-form [:copy place]) (vec vals) (target [:failure]))))
      :if (terminate! bb (list 'switch (op-form [:copy place]) [[0 (target [:failure])]] (target [:success]))))))

(defn- test-candidates! [cands start]
  (let [[place test] (pick-test cands)
        buckets (atom []) ; [[branch [cand...]]] in insertion order
        rest-cands (loop [cs cands]
                     (if-let [c (first cs)]
                       (if-let [br (choose-bucket! place test c)]
                         (do (swap! buckets (fn [bs] (if-let [i (first (keep-indexed (fn [i [b _]] (when (= b br) i)) bs))]
                                                       (update-in bs [i 1] conj c)
                                                       (conj bs [br [c]]))))
                             (recur (rest cs)))
                         (vec cs))
                       []))
        remainder (start-new-block!)
        targets (vec (for [[br cs] @buckets]
                       (let [bs (start-new-block!)
                             bo (match-candidates bs cs)]
                         (goto! bo remainder)
                         [br bs])))]
    (perform-test! start remainder place test targets)
    [remainder rest-cands]))

(defn match-candidates [start cands]
  (when-let [c (first cands)] (when-not (:fe-start @c) (swap! c assoc :fe-start start)))
  (cond
    (empty? cands) start
    (empty? (:pairs @(first cands)))
    (let [c (first cands) o (start-new-block!)]
      (swap! c assoc :pre start :otherwise o)
      (match-candidates o (vec (rest cands))))
    :else (let [[s r] (test-candidates! cands start)] (match-candidates s r))))

(defn- lower-match-tree [bb pb pats+guards]
  (let [cands (mapv (fn [[p g]] (new-candidate pb p g)) pats+guards)
        _ (when (some second pats+guards) (unsupported "a match guard"))
        otherwise (match-candidates bb cands)
        next (atom nil)]
    (doseq [c (rseq cands)]
      (when-let [n @next]
        (let [old (:pre @c) new (start-new-block!)]
          (terminate! old (list 'false-edge new n))
          (swap! c assoc :pre new)))
      (reset! next (:fe-start @c)))
    (push! otherwise (list 'fake-read "ForMatchedPlace(None)" (place-form pb)))
    (terminate! otherwise '(unreachable))
    (mapv deref cands)))

(defn- bind-for-arm-body! [bb bindings]
  (doseq [b bindings]
    (let [p (storage-live-binding! bb (:var b))]
      (schedule-drop-for-binding! (:var b))
      (assign! bb p (case (:by-ref b)
                      :no (use-rv (consume (:source b)))
                      :not (list 'ref :shared (place-form (:source b)))
                      :mut (list 'ref :mut (place-form (:source b))))))))

(defn- bind-pattern! [branch]
  (bind-for-arm-body! (:pre branch) (:bindings branch))
  (:pre branch))

(defn place-into-pattern [bb pat pb]
  (let [[branch] (lower-match-tree bb pb [[pat false]])]
    (bind-pattern! branch)))

(defn- lower-scrutinee [bb x]
  (let [[bb p] (as-place bb x)]
    (push! bb (list 'place-mention (place-form p)))
    [bb p]))

(defn match-expr [dest bb x]
  (let [[bb pb] (lower-scrutinee bb (:scrutinee x))
        branches (lower-match-tree bb pb (mapv (fn [a] [(:pat a) (boolean (:guard a))]) (:arms x)))
        ends (vec (for [[a br] (map vector (:arms x) branches)]
                    (blk (in-scope (:scope a)
                           (let [vis (declare-bindings nil (:pat a))
                                 ab (bind-pattern! br)]
                             (when vis (upd! assoc :source-scope vis))
                             (blk (expr-into-dest dest ab (:body a))))))))
        end (start-new-block!)]
    (doseq [e ends] (goto! e end))
    end))

;; ---------------------------------------------------------------------------------------------
;; Closures' captures (RFP20 (a)): rustc_hir_typeck/src/upvar.rs (closure_analyze, analyze_closure,
;; process_collected_capture_information, compute_min_captures, the restrictions and truncations, determine_capture_info,
;; determine_capture_mutability, init_capture_kind_for_place) over expr_use_visitor.rs (consume_body, walk_expr, walk_stmt,
;; walk_local, walk_block, walk_struct_expr, walk_adjustment, walk_autoref, walk_arm, walk_pat, walk_captures, cat_expr and
;; its kinds, cat_res, cat_projection, cat_deref, cat_pattern) with InferBorrowKind as the delegate, and rustc_passes'
;; upvars.rs (upvars_mentioned). Over the HIR and the typeck root's results (tc/body-results).
;;
;; A place {:base [:upvar KEY]|[:local KEY]|[:rvalue]|[:static] :base-ty T :proj [[KIND TY] ...]}, KIND [:deref]
;; [:field I VI] [:index] [:subslice]; a capture kind :by-value or [:by-ref :imm|:unique|:mut].

(defn- hir-children
  "The expressions, blocks, statements, patterns and arms directly below a HIR node (not into nested items)"
  [x]
  (let [acc (java.util.ArrayList.)]
    (doseq [[k v] x :when (not (#{:path :ty :output :lit :span :hir-id :attrs :res :seg} k))]
      (cond (and (map? v) (:node v)) (.add acc v)
            (and (map? v) (#{:block :els} k)) (.add acc (assoc v :node :block))
            (map? v) (doseq [y (vals v)] (when (and (map? y) (:node y)) (.add acc y)))
            (sequential? v) (doseq [y v] (cond (and (map? y) (:node y)) (.add acc y)
                                               (map? y) (doseq [z (vals y)] (when (and (map? z) (or (:node z) (:kind z))) (.add acc (if (:node z) z (assoc z :node :x)))))
                                               :else nil))
            :else nil))
    (vec acc)))

(defn- walk-hir
  "F over every HIR node below X (X included), not into a nested closure when SKIP-CLOSURES"
  [x f skip-closures]
  (when (map? x)
    (f x)
    (when-not (and skip-closures (= :closure (:kind x)) (= :expr (:node x)))
      (doseq [c (hir-children x)] (walk-hir c f skip-closures)))))

(defn- closure-locals
  "LocalCollector: the bindings of a closure's parameters and body, not its nested closures'"
  [cl]
  (let [acc (java.util.HashSet.)
        f (fn [y] (when (and (= :binding (:kind y)) (:name y) (not (= :expr (:node y)))) (.add acc (binding-key y))))]
    (doseq [p (:params cl)] (walk-hir (:pat p) f true))
    (walk-hir (:body cl) f true)
    acc))

(def ^:dynamic *upvars-mentioned* nil)   ; atom: closure hir-id -> [key ...] (in first-use order)

(defn upvars-mentioned
  "upvars_mentioned: the variables a closure's body (with its nested closures') uses that are not its own, in order"
  [cl]
  (or (get @*upvars-mentioned* (:hir-id cl))
      (let [locals (closure-locals cl)
            acc (java.util.LinkedHashSet.)
            use! (fn [k] (when-not (.contains locals k) (.add acc k)))]
        (letfn [(w [y]
                  (when (map? y)
                    (cond
                      (and (= :expr (:node y)) (= :closure (:kind y))) (doseq [k (upvars-mentioned y)] (use! k))
                      :else (do (when (and (= :expr (:node y)) (= :path (:kind y)))
                                  (when-let [k (local-res (:path y))] (use! k)))
                                (doseq [c (hir-children y)] (w c))))))]
          (doseq [p (:params cl)] (w (:pat p)))
          (w (:body cl)))
        (let [v (vec acc)] (swap! *upvars-mentioned* assoc (:hir-id cl) v) v))))

;; the analysis' state
(def ^:dynamic *cx* nil)   ; {:owner closure-node :upvars #{key} :var-tys {key T} :modes {key [by-ref mut]} :caps atom :fakes atom}
(def ^:dynamic *closure-info* nil)   ; atom: closure hir-id -> {:kind :captures :fake-reads}

(defn- deref-ty [t]
  (case (first t)
    :ref (nth t 3) :ptr (nth t 2)
    :adt (if (= "alloc::boxed::Box" (adt-def t)) (first (nth t 2)) (unsupported "a deref of" t))
    (unsupported "a deref of" t)))

(defn- p-ty [pl] (if-let [l (peek (:proj pl))] (second l) (:base-ty pl)))
(defn- ty-before [pl i] (if (zero? i) (:base-ty pl) (second (nth (:proj pl) (dec i)))))
(defn- rvalue-place [t] {:base [:rvalue] :base-ty t :proj []})
(defn- cat-projection [pl t kind] (update pl :proj conj [kind t]))
(defn- cat-deref [pl] (cat-projection pl (deref-ty (p-ty pl)) [:deref]))
(defn- ref? [t] (= :ref (first t)))
(defn- mut-ref? [t] (and (ref? t) (nth t 2)))
(defn- deref-tys [pl] (for [[i [k _]] (map-indexed vector (:proj pl)) :when (= [:deref] k)] (ty-before pl i)))

(defn- cat-res [e t]
  (let [k (local-res (:path e))]
    (cond
      (nil? k) (if (= "Static" (str (nth (c/res-def (:path e)) 2 nil))) {:base [:static] :base-ty t :proj []} (rvalue-place t))
      (contains? (:upvars *cx*) k) {:base [:upvar k] :base-ty (get (:var-tys *cx*) k) :proj []}
      :else {:base [:local k] :base-ty t :proj []})))

(declare cat-expr)

(defn- field-of [pl e]
  "the field index of a field expression on a place"
  (let [bt (p-ty pl)]
    (case (first bt)
      :tuple [(parse-long (str (:ident e))) 0]
      :adt (let [d (second bt)] (if (number? d) [(field-index (tc/single-variant d) (:ident e)) 0] (unsupported "a std field")))
      (unsupported "a field of" bt))))

(defn- cat-overloaded-place [e base]
  (let [bt (let [x (r-of base)] (reduce (fn [_ [_ tt]] tt) (:ty x) (:adj x)))]
    (when-not (ref? bt) (unsupported "an overloaded place's base" bt))
    (cat-deref (rvalue-place [:ref [:re-erased] (nth bt 2) (ty-of e)]))))

(defn- cat-unadjusted [e]
  (let [t (ty-of e)]
    (case (:kind e)
      :unary (if (= "*" (:op e))
               (if (:callee (r-of e)) (cat-overloaded-place e (:expr e)) (cat-deref (cat-expr (:expr e))))
               (rvalue-place t))
      :field (let [b (cat-expr (:expr e)) [i vi] (field-of b e)] (cat-projection b t [:field i vi]))
      :index (if (:callee (r-of e)) (cat-overloaded-place e (:expr e)) (cat-projection (cat-expr (:expr e)) t [:index]))
      :path (cat-res e t)
      :type (cat-expr (:expr e))
      (rvalue-place t))))

(defn- builtin-deref? [t] (or (#{:ref :ptr} (first t)) (= "alloc::boxed::Box" (adt-def t))))

(defn- cat-adjusted [pl [k target]]
  (cond (= k "Deref") (if (builtin-deref? (p-ty pl)) (cat-deref pl) (cat-deref (rvalue-place [:ref [:re-erased] false target])))
        :else (rvalue-place target)))

(defn cat-expr [e] (reduce cat-adjusted (cat-unadjusted e) (:adj (r-of e))))

;; InferBorrowKind (the delegate)
(defn- upvar? [pl] (= :upvar (first (:base pl))))

(defn- truncate! [pl kind len]
  "truncate_place_to_len_and_update_capture_kind: [place kind]"
  (let [kind (if (and (= kind [:by-ref :mut])
                      (some (fn [i] (and (= [:deref] (first (nth (:proj pl) i))) (mut-ref? (ty-before pl i)))) (range len (count (:proj pl)))))
               [:by-ref :unique] kind)]
    [(update pl :proj #(subvec % 0 (min len (count %)))) kind]))

(defn- raw-ptr? [t] (= :ptr (first t)))
(defn- union-ty? [t] (and (= :adt (first t)) (number? (second t)) (= "Union" (:kind (c/def-of (second t))))))

(defn- restrict-precision-for-unsafe [pl kind]
  (let [[pl kind] (if (or (raw-ptr? (:base-ty pl)) (union-ty? (:base-ty pl))) (truncate! pl kind 0) [pl kind])]
    (if-let [i (first (keep-indexed (fn [i [_ t]] (when (or (raw-ptr? t) (union-ty? t)) i)) (:proj pl)))]
      (truncate! pl kind (inc i))
      [pl kind])))

(defn- restrict-capture-precision [pl kind]
  (let [[pl kind] (restrict-precision-for-unsafe pl kind)]
    (if-let [i (first (keep-indexed (fn [i [k _]] (when (#{[:index] [:subslice]} k) i)) (:proj pl)))]
      (truncate! pl kind i)
      [pl kind])))

(defn- packed? [t] (and (= :adt (first t)) (number? (second t))
                        (some (fn [a] (some #(and (string? %) (= "packed" %)) (:toks a))) (:attrs (:node (c/def-of (second t)))))))

(defn- restrict-repr-packed [pl kind]
  (if-let [i (first (keep-indexed (fn [i [k _]] (when (and (= :field (first k)) (packed? (ty-before pl i))) i)) (:proj pl)))]
    (truncate! pl kind i)
    [pl kind]))

(defn- d-capture! [pl kind]
  (when (upvar? pl) (swap! (:caps *cx*) conj [pl kind])))

(defn- d-consume! [pl] (d-capture! pl :by-value))
(defn- d-borrow! [pl bk]
  (when (upvar? pl)
    (let [[pl kind] (restrict-repr-packed pl [:by-ref bk])
          kind (if (some raw-ptr? (deref-tys pl)) [:by-ref :imm] kind)]
      (d-capture! pl kind))))
(defn- d-mutate! [pl] (d-borrow! pl :mut))
(defn- d-fake-read! [pl cause]
  (when (upvar? pl)
    (let [[pl _] (restrict-capture-precision pl [:by-ref :imm])
          [pl _] (restrict-repr-packed pl [:by-ref :imm])]
      (swap! (:fakes *cx*) conj [pl cause]))))

;; ExprUseVisitor
(defn- consume-or-copy! [pl] (if (copy? (p-ty pl)) (d-borrow! pl :imm) (d-consume! pl)))

(declare euv-walk-expr euv-walk-block euv-walk-pat)

(defn- euv-consume [e] (when e (consume-or-copy! (cat-expr e)) (euv-walk-expr e)))
(defn- euv-mutate [e] (d-mutate! (cat-expr e)) (euv-walk-expr e))
(defn- euv-borrow [e bk] (d-borrow! (cat-expr e) bk) (euv-walk-expr e))

(defn- bk-of [mutbl] (if mutbl :mut :imm))

(defn- euv-walk-adjustment [e]
  (loop [pl (cat-unadjusted e) adjs (:adj (r-of e))]
    (when-let [[k target :as a] (first adjs)]
      (cond (or (= k "NeverToAny") (str/starts-with? (str k) "Pointer")) (consume-or-copy! pl)
            (= k "Deref") (when-not (builtin-deref? (p-ty pl)) (d-borrow! pl :imm))
            (= k "Borrow") (d-borrow! pl (bk-of (case (first target) :ref (nth target 2) :ptr (second target) false)))
            :else nil)
      (recur (cat-adjusted pl a) (rest adjs)))))

(defn- fake-read-scrutinee! [pl refutable]
  (d-fake-read! pl (if refutable "ForMatchedPlace" "ForLet")))

(defn- euv-walk-local [init pat els f]
  (euv-walk-expr init)
  (let [pl (cat-expr init)]
    (f)
    (fake-read-scrutinee! pl (some? els))
    (euv-walk-pat pl pat false)
    (when els (euv-walk-block els))))

(defn- euv-walk-stmt [s]
  (case (:kind s)
    :let (when (:init s) (euv-walk-local (:init s) (:pat s) (:els s) (fn [])))
    (:semi :expr) (euv-consume (:expr s))
    nil))

(defn euv-walk-block [b]
  (doseq [s (:stmts b)] (euv-walk-stmt s))
  (when (:expr b) (euv-consume (:expr b))))

(defn- euv-walk-struct [e]
  (doseq [f (:fields e)] (euv-consume (:expr f)))
  (when-let [w (:base e)]
    (let [wp (cat-expr w) wt (p-ty wp)]
      (when-not (= :adt (first wt)) (unsupported "functional update of" wt))
      (let [vid (tc/single-variant (second wt))
            mentioned (set (map #(field-index vid (:ident %)) (:fields e)))]
        (doseq [[i [_ ft]] (map-indexed vector (tc/all-fields (second wt) (nth wt 2))) :when (not (mentioned i))]
          (consume-or-copy! (cat-projection wp ft [:field i 0]))))
      (euv-walk-expr w))))

(defn- euv-walk-captures [cl]
  (let [info (get @*closure-info* (:hir-id cl))
        local? (fn [k] (not (contains? (:upvars *cx*) k)))]
    (doseq [[fr cause] (:fake-reads info) :let [k (second (:base fr))] :when (not (local? k))]
      (d-fake-read! fr cause))
    (doseq [cap (:captures info) :let [k (:var cap)] :when (not (local? k))]
      (let [pl {:base [:upvar k] :base-ty (:base-ty cap) :proj (:proj cap)}]
        (case (:cap cap)
          :by-value (consume-or-copy! pl)
          (d-borrow! pl (second (:cap cap))))))))

(defn euv-walk-expr [e]
  (when (map? e)
    (euv-walk-adjustment e)
    (case (:kind e)
      (:path :qpath :type-relative :lit :continue) nil
      :type (euv-walk-expr (:expr e))
      :unary (if (= "*" (:op e)) (euv-walk-expr (:expr e)) (euv-consume (:expr e)))
      :field (euv-walk-expr (:expr e))
      :index (do (euv-walk-expr (:expr e)) (euv-consume (:index e)))
      :call (do (euv-consume (:func e)) (doseq [a (:args e)] (euv-consume a)))
      :method (do (euv-consume (:receiver e)) (doseq [a (:args e)] (euv-consume a)))
      :struct (euv-walk-struct e)
      (:tup :array) (doseq [x (:exprs e)] (euv-consume x))
      :if (do (euv-consume (:cond e)) (euv-consume (:then e)) (euv-consume (:else e)))
      :let (euv-walk-local (:init e) (:pat e) nil #(euv-borrow (:init e) :imm))
      :match (let [dp (cat-expr (:expr e))]
               (fake-read-scrutinee! dp true)
               (euv-walk-expr (:expr e))
               (doseq [a (:arms e)]
                 (euv-walk-pat dp (:pat a) (some? (:guard a)))
                 (euv-consume (:guard a))
                 (euv-consume (:body a))))
      :addr-of (euv-borrow (:expr e) (bk-of (:mutbl e)))
      :loop (euv-walk-block (:block e))
      :binary (do (euv-consume (:lhs e)) (euv-consume (:rhs e)))
      :block (euv-walk-block (:block e))
      (:break :ret) (euv-consume (:expr e))
      :assign (do (euv-mutate (:lhs e)) (euv-consume (:rhs e)))
      :cast (euv-consume (:expr e))
      :drop-temps (euv-consume (:expr e))
      :assign-op (do (if (:callee (r-of e)) (euv-consume (:lhs e)) (euv-mutate (:lhs e))) (euv-consume (:rhs e)))
      :repeat (euv-consume (:expr e))
      :closure (euv-walk-captures e)
      (unsupported "an expression in a closure" (:kind e)))))

(defn- multivariant? [t]
  (and (= :adt (first t)) (> (count (tc/variants-any (second t))) 1)))

(defn- pat-ty-unadjusted [p]
  (let [r (r-of p) t (:ty r)]
    (if (and (= :binding (:kind p)) (#{:not :mut} (first (:mode r)))) (nth t 3) t)))

(defn- pat-ty-adjusted [p] (or (first (:pat-adj (r-of p))) (pat-ty-unadjusted p)))

(defn- enumerate-and-adjust
  "enumerate_and_adjust: the subpatterns with their field indices, a `..` (a :rest pattern) skipping the fields it stands for"
  [pats total]
  (let [i (first (keep-indexed (fn [i p] (when (= :rest (:kind p)) i)) pats))]
    (if (nil? i)
      (map-indexed vector pats)
      (let [before (subvec (vec pats) 0 i) after (subvec (vec pats) (inc i))]
        (concat (map-indexed vector before) (map-indexed (fn [j p] [(+ (- total (count after)) j) p]) after))))))

(defn- cat-pattern [pl p op]
  (let [pl (reduce (fn [pl _] (cat-deref pl)) pl (:pat-adj (r-of p)))]
    (op pl p)
    (case (:kind p)
      :tuple (let [t (p-ty pl)]
               (doseq [[i sp] (enumerate-and-adjust (:pats p) (count (second t)))]
                 (cat-pattern (cat-projection pl (pat-ty-adjusted sp) [:field i 0]) sp op)))
      :tuple-struct (let [[_ vi vid] (or (ctor-info (:path p)) (unsupported "a pattern path" (:path p)))
                          total (count (tc/all-fields-of-variant vid))]
                      (doseq [[i sp] (enumerate-and-adjust (:pats p) total)]
                        (cat-pattern (cat-projection pl (pat-ty-adjusted sp) [:field i vi]) sp op)))
      :struct (let [[_ vi vid] (or (ctor-info (:path p)) (unsupported "a pattern path" (:path p)))]
                (doseq [f (:fields p)]
                  (cat-pattern (cat-projection pl (pat-ty-adjusted (:pat f)) [:field (field-index vid (:ident f)) vi]) (:pat f) op)))
      :or (doseq [sp (:pats p)] (cat-pattern pl sp op))
      :binding (when (:sub p) (cat-pattern pl (:sub p) op))
      :guard (cat-pattern pl (:pat p) op)
      (:ref :box) (cat-pattern (cat-deref pl) (:pat p) op)
      :slice (unsupported "a slice pattern in a closure")
      nil)))

(defn euv-walk-pat [dp p has-guard]
  (cat-pattern dp p
    (fn [pl p]
      (let [read-discr #(d-borrow! pl :imm)]
        (case (:kind p)
          :binding (do (when has-guard (read-discr))
                       (let [[by-ref] (:mode (r-of p))]
                         (if (#{:not :mut} by-ref) (d-borrow! pl (if (= :mut by-ref) :mut :imm)) (consume-or-copy! pl))))
          :path (let [rd (c/res-def (:path p))]
                  (if (re-find #"Const" (str (nth rd 2 nil)))
                    (when-not (str/starts-with? (str (nth rd 2 nil)) "Ctor(") (read-discr))
                    nil)
                  (when (and (str/starts-with? (str (nth rd 2 nil "")) "Ctor(") (multivariant? (p-ty pl))) (read-discr))
                  (when (and (not (str/starts-with? (str (nth rd 2 nil "")) "Ctor(")) (not (re-find #"Const" (str (nth rd 2 nil)))) (multivariant? (p-ty pl))) (read-discr)))
          (:lit :range) (read-discr)
          (:struct :tuple-struct) (when (multivariant? (p-ty pl)) (read-discr))
          nil)))))

;; analyze_closure's processing
(defn- capture-rank [k] (case k :by-value 3 [:by-ref :mut] 2 [:by-ref :unique] 1 [:by-ref :imm] 0))

(defn- determine-capture-info [a b]
  (if (= a b) a (if (>= (capture-rank a) (capture-rank b)) a b)))

(defn- truncate-for-optimization [pl kind]
  (let [idx (last (keep-indexed (fn [i [k _]] (when (= [:deref] k) i)) (:proj pl)))]
    (if (and idx (= :ref (first (ty-before pl idx))) (not (nth (ty-before pl idx) 2)))
      (truncate! pl kind (inc idx))
      [pl kind])))

(defn- restrict-precision-for-drop-types [pl kind]
  (if (and (not (copy? (p-ty pl))) (= :by-value kind))
    (if-let [i (first (keep (fn [i] (let [t (ty-before pl i)] (when (and (= :adt (first t)) (number? (second t)) (tc/implements-drop? t)) i)))
                            (range (count (:proj pl)))))]
      (truncate! pl kind i)
      [pl kind])
    [pl kind]))

(defn- process-captures
  "process_collected_capture_information: [processed kind]"
  [move? infos]
  (let [kind (atom :fn)
        processed (vec (for [[pl k] infos]
                         (let [[pl k] (restrict-capture-precision pl k)
                               [pl k] (truncate-for-optimization pl k)]
                           (case k
                             :by-value (reset! kind :fn-once)
                             ([:by-ref :mut] [:by-ref :unique]) (when (= :fn @kind) (reset! kind :fn-mut))
                             nil)
                           (let [first-deref (first (keep-indexed (fn [i [x _]] (when (= [:deref] x) i)) (:proj pl)))
                                 [pl k] (if move?
                                          (let [[pl _] (if first-deref (truncate! pl k first-deref) [pl k])] [pl :by-value])
                                          (if (and (= :by-value k) first-deref) (truncate! pl k first-deref) [pl k]))]
                             (restrict-precision-for-drop-types pl k)))))]
    [processed @kind]))

(defn- ancestry [a b]
  "determine_place_ancestry_relation of A relative to B"
  (let [pa (mapv first (:proj a)) pb (mapv first (:proj b))]
    (cond (not= (:base a) (:base b)) :divergent
          (not (every? true? (map = pa pb))) :divergent
          (> (count pb) (count pa)) :ancestor
          (= (count pb) (count pa)) :same
          :else :descendant)))

(defn- capture-mutability [pl]
  (let [k (second (:base pl))
        m (boolean (second (get (:modes *cx*) k)))]
    (loop [m m ts (deref-tys pl)]
      (if-let [t (first ts)]
        (cond (mut-ref? t) (recur true (rest ts))
              (ref? t) false
              :else (recur m (rest ts)))
        m))))

(defn- compute-min-captures
  "compute_min_captures: the min capture lists by root variable (in insertion order), each sorted by its field projections"
  [root-map infos]
  (let [order (atom (vec (keys (:order root-map)))) m (atom (:lists root-map))]
    (doseq [[pl k] infos]
      (let [v (second (:base pl))]
        (if-not (contains? @m v)
          (do (swap! order conj v) (swap! m assoc v [{:place pl :kind k :mut (capture-mutability pl)}]))
          (let [lst (get @m v)
                desc-found (atom false)
                upd (atom k)
                lst (vec (remove (fn [d] (when (= :ancestor (ancestry pl (:place d)))
                                           (reset! desc-found true)
                                           (let [[_ dk] (truncate! (:place d) (:kind d) (count (:proj pl)))]
                                             (swap! upd determine-capture-info dk))
                                           true))
                                 lst))
                [lst found] (if @desc-found
                              [lst false]
                              (loop [i 0]
                                (if (>= i (count lst))
                                  [lst false]
                                  (let [a (nth lst i)]
                                    (case (ancestry pl (:place a))
                                      :same [(assoc-in lst [i :kind] (determine-capture-info (:kind a) @upd)) true]
                                      :descendant (let [[_ ck] (truncate! pl @upd (count (:proj (:place a))))]
                                                    [(assoc-in lst [i :kind] (determine-capture-info (:kind a) ck)) true])
                                      (recur (inc i)))))))
                lst (if found lst (conj lst {:place pl :kind @upd :mut (capture-mutability pl)}))]
            (swap! m assoc v lst)))))
    (let [fields (fn [c] (keep (fn [[k _]] (when (= :field (first k)) (second k))) (:proj (:place c))))]
      {:order (into (array-map) (map vector @order (repeat true)))
       :lists (into {} (for [[v lst] @m] [v (vec (sort-by fields (fn [a b] (or (first (keep (fn [[x y]] (when (not= x y) (compare x y))) (map vector a b))) 0)) lst))]))})))

(defn- init-capture-kind [pl move?]
  (if (and move? (not (some ref? (deref-tys pl)))) :by-value [:by-ref :imm]))

(defn- analyze-closure!
  "analyze_closure over a closure's HIR node (its nested closures analyzed first)"
  [cl var-tys modes]
  (let [ups (upvars-mentioned cl)
        caps (atom []) fakes (atom [])]
    (binding [*cx* {:owner cl :upvars (set ups) :var-tys var-tys :modes modes :caps caps :fakes fakes}]
      ;; consume_body: the parameters' patterns over rvalue places, then the body
      (doseq [p (:params cl)]
        (let [pl (rvalue-place (pat-ty-adjusted (:pat p)))]
          (fake-read-scrutinee! pl false)
          (euv-walk-pat pl (:pat p) false)))
      (euv-consume (:body cl))
      (let [move? (= :move (:capture cl))
            [processed kind] (process-captures move? @caps)
            mc (compute-min-captures {:order {} :lists {}} processed)
            mc (if (< *edition* 2021)
                 (compute-min-captures mc (for [k ups] (let [pl {:base [:upvar k] :base-ty (get var-tys k) :proj []}] [pl (init-capture-kind pl move?)])))
                 mc)
            captures (vec (for [v (keys (:order mc)) c (get (:lists mc) v)]
                            {:var v :name (get-in modes [v 2]) :var-span (get-in modes [v 3]) :base-ty (:base-ty (:place c)) :proj (:proj (:place c)) :cap (:kind c) :mut (:mut c)
                             :ty (let [t (p-ty (:place c))] (if (= :by-value (:kind c)) t [:ref [:re-erased] (not= [:by-ref :imm] (:kind c)) t]))}))
            kind (or (:closure-kind (r-of cl)) kind)]
        (swap! *closure-info* assoc (:hir-id cl)
               {:kind kind :captures captures :fake-reads @fakes :upvars ups :upvar-names (mapv #(get-in modes [% 2]) ups)
                :ty (:ty (r-of cl))})))))

(defn closure-analyze
  "closure_analyze over a typeck root's body (its HIR: the parameters and the body expression) with its results RES:
  {closure-hir-id {:kind :fn|:fn-mut|:fn-once :captures [{:var :name :base-ty :proj :cap :mut}] :fake-reads [[place cause]]}}"
  [params body res edition]
  (binding [*res* res *edition* edition *upvars-mentioned* (atom {}) *closure-info* (atom {})]
    (let [var-tys (java.util.HashMap.) modes (java.util.HashMap.)
          f (fn [y] (when (and (= :binding (:kind y)) (:name y) (not= :expr (:node y)))
                      (let [r (r-of y)] (.put var-tys (binding-key y) (:ty r)) (.put modes (binding-key y) [(first (:mode r)) (second (:mode r)) (str (:name y)) (:span y)]))))]
      (doseq [p params] (walk-hir p f false))
      (walk-hir body f false)
      (let [var-tys (into {} var-tys) modes (into {} modes)]
        (letfn [(visit [x]
                  (when (map? x)
                    (doseq [c (hir-children x)] (visit c))
                    (when (and (= :expr (:node x)) (= :closure (:kind x)))
                      (analyze-closure! x var-tys modes))))]
          (doseq [p params] (visit p))
          (visit body)))
      @*closure-info*)))

(defn place-capture-string
  "place_to_string_for_capture"
  [name base-ty proj]
  (loop [s name t base-ty ps proj]
    (if-let [[k pt] (first ps)]
      (recur (case (first k)
               :deref (str "*" s)
               :field (str s "." (if (= :tuple (first t)) (second k)
                                     (let [vid (if (tc/enum? (second t)) (:id (nth (tc/variants-any (second t)) (nth k 2))) (second t))]
                                       (first (nth (tc/all-fields-of-variant vid) (second k))))))
               s)
             pt (rest ps))
      s)))

;; A closure's typeck root (its outermost enclosing body owner) and the root's results with its closures' captures

(defn typeck-root [d]
  (loop [d d] (if (= "Closure" (:kind d)) (recur (c/def-of (:parent d))) d)))

(defn root-analysis
  "A typeck root's results and closure_analyze's captures, kept in CACHE (an atom, or nil): {:res RES :closures INFO}"
  [root edition & [cache]]
  (or (when cache (get @cache (:id root)))
      (let [res (tc/body-results root)
            n (:node root)
            fn? (#{"Fn" "AssocFn"} (:kind root))
            body-expr (if fn? {:node :expr :kind :block :block (:body n) :span (:span (:body n)) :hir-id [(first (:hir-id n)) :body]} (:expr n))
            info (tc/with-solver root (fn [] (closure-analyze (when fn? (map :pat (:params n))) body-expr res edition)))
            v {:res res :closures info}]
        (when cache (swap! cache assoc (:id root) v))
        v)))

;; ---------------------------------------------------------------------------------------------
;; Bodies (mod.rs: construct_fn, args_and_body)

(defn- span-text [sp]
  (cond (and (vector? sp) (= 5 (count sp))) (let [[f l1 c1 l2 c2] sp] (str f ":" l1 ":" c1 ": " l2 ":" c2))
        (vector? sp) (let [[l1 c1 l2 c2] sp] (str *root-file* ":" l1 ":" c1 ": " l2 ":" c2))
        :else "?"))

(defn- push-user-type!
  "as_constant's push_cuta: a constant's user type annotation (its canonical user type, its span, the inferred type)"
  [u sp ty]
  (upd! update :user-types (fnil conj [])
        {:text (str "user_ty: " u ", span: " (span-text sp) ", inferred_ty: " (binding [c/*in-value* false] (c/print-ty ty)))}))

(defn- finish
  "Builder::finish: the body map in MIR forms"
  [d name kind n-args ret]
  (let [s (st)]
    {:name name :kind kind :args n-args :ret (ty-form ret)
     :locals (mapv (fn [l] (cond-> {:mut (:mut l) :scope (:scope l) :ty (ty-form (:ty l))} (:user-ty l) (assoc :user-ty (:user-ty l)))) (:locals s))
     :scopes (:source-scopes s)
     :debug (:debug s)
     :blocks (mapv (fn [b] {:cleanup (:cleanup b) :stmts (:stmts b) :after-dbg [] :term (:term b)}) (:blocks s))
     :allocs ""
     :user-types (vec (for [{:keys [span ty text]} (:user-types s)]
                        (if text text
                        (let [[l1 c1 l2 c2] span t (ty-text ty)]
                          (str "user_ty: Canonical { value: Ty(" t "), max_universe: U0, var_kinds: [] }, span: " *root-file* ":" l1 ":" c1 ": " l2 ":" c2 ", inferred_ty: " t)))))}))

(defn print-built
  "A built body's text as -Zdump-mir prints it after the header line: the user type annotations, then the body"
  [b]
  (str (when (seq (:user-types b))
         (str "| User Type Annotations\n"
              (apply str (map-indexed (fn [i u] (str "| " i ": " u "\n")) (:user-types b)))
              "|\n"))
       (mir/print-body b)))


(defn mir-name
  "A body's name as write_mir_pretty prints it: its def path, an impl as `<impl at FILE:L:C: L:C>`"
  [d]
  (let [p (c/def-of (:parent d))]
    (if (and p (str/starts-with? (str (:kind p)) "Impl") (sequential? (:span (:node p))))
      (let [[l1 c1 l2 c2] (:span (:node p))
            ;; def_span: an impl's header, to its self type (its where clause) when the item's text is the root file's
            [l2 c2] (let [st (:span (:self-ty (:node p)))
                          wh (keep :span (:where (:generics (:node p))))]
                      (if (and (sequential? st) (= l1 (first st)) (not (some #{:derive} [(:derive (:node p))])))
                        (let [e (or (last (sort (map (fn [x] [(nth x 2) (nth x 3)]) wh))) [(nth st 2) (nth st 3)])]
                          (if (pos? (compare [l2 c2] e)) e [l2 c2]))
                        [l2 c2]))]
        (str "<impl at " *root-file* ":" l1 ":" c1 ": " l2 ":" c2 ">::" (second (:data d))))
      (binding [c/*in-value* true] (c/print-def-path (:id d) [])))))

(defn build-discriminant
  "construct_const for an explicit discriminant (`A = 1`): the anonymous constant `Variant::{constant#0}`"
  [d opts]
  (let [v (:node d)
        res (tc/body-results d)
        t (tc/discr-ty (:parent d))
        name (str (binding [c/*in-value* true] (c/print-def-path (:id d) [])) "::{constant#0}")]
    (tc/with-solver (c/def-of (:parent d))
      (fn []
        (binding [*edition* (or (:edition opts) 2024) *res* res *self-var* nil
                  *tree* (binding [*rt* (atom {:parent {} :var {} :cx {:parent nil :var-parent nil}})]
                           (enter-scope! [(:hir-id (:disr v)) :destruction])
                           (resolve-expr (:disr v) false) @*rt*)
                  *b* (atom {:blocks [] :locals [{:ty t :mut true :scope 0}] :source-scopes [[nil nil]] :source-scope 0 :debug []
                             :scopes [] :breakables [] :if-then nil :unwind (drop-tree) :var-indices {} :unit-temp nil
                             :block-context [] :check-overflow true})]
          (let [x (mirror-expr (:disr v))]
            (start-new-block!)
            (let [bb (blk (expr-into-dest (place 0) 0 x))]
              (terminate! bb '(return))
              (let [blocks (build-drop-tree-mir! (:unwind (st)) :unwind nil)]
                (when-let [r (nth blocks 0)] (terminate! r '(resume))))
              (finish d name :anon-const 0 t))))))))

(defn build-body
  "construct_fn over a function's or a closure's HIR and its typeck root's results (within collect/with-crate); OPTS
  {:overflow-checks :edition :root-cache}"
  [d opts]
  (let [ed (or (:edition opts) 2024)
        closure? (= "Closure" (:kind d))
        n (:node d)
        root (typeck-root d)
        {:keys [res closures]} (root-analysis root ed (:root-cache opts))
        info (when closure? (or (get closures (:hir-id n)) (unsupported "a closure without its analysis")))
        cty (when closure? (:ty (get res (:hir-id n))))
        sig (if closure?
              (let [{:keys [inputs output]} (nth cty 2)] {:inputs (vec inputs) :output output})
              (tc/erased-sig (:id d)))
        env-ty (when closure? (case (:kind info) :fn [:ref [:re-erased] false cty] :fn-mut [:ref [:re-erased] true cty] cty))
        ret (:output sig)
        name (mir-name d)
        body-expr (if closure?
                    (:body n)
                    {:node :expr :kind :block :block (:body n) :span (:span (:body n)) :hir-id [(first (:hir-id n)) :body]})
        res (if (or closure? (get res (:hir-id body-expr))) res (assoc res (:hir-id body-expr) {:ty ret}))
        pats (map :pat (:params n))
        env-proj (if (and closure? (not= :fn-once (:kind info))) [[:deref]] [])
        captures (when closure?
                   (vec (map-indexed (fn [i c] {:var (:var c) :hproj (mapv first (:proj c)) :mut (:mut c) :base-ty (:base-ty c) :name (:name c)
                                                :use-place {:local 1 :proj (cond-> (conj env-proj [:field i (:ty c)]) (not= :by-value (:cap c)) (conj [:deref]))}
                                                :cap c})
                                     (:captures info))))]
    (tc/with-solver root
      (fn []
        (binding [*edition* ed
                  *self-var* nil *names* {}
                  *res* res
                  *closure-info* closures
                  *closure-tys* (into {} (for [[_ ci] closures :when (= :closure (first (:ty ci)))] [(second (:ty ci)) (mapv :ty (:captures ci))]))
                  *closure-kinds* (into {} (for [[_ ci] closures :when (= :closure (first (:ty ci)))] [(second (:ty ci)) (:kind ci)]))
                  *upvars* (if closure? (set (:upvars info)) #{})
                  *captures* (or captures [])
                  *tree* (binding [*edition* ed] (scope-tree pats body-expr))
                  *b* (atom {:blocks [] :locals [{:ty ret :mut true :scope 0}] :source-scopes [] :source-scope 0 :debug []
                             :scopes [] :breakables [] :if-then nil :unwind (drop-tree) :var-indices {} :unit-temp nil
                             :block-context [] :check-overflow (boolean (:overflow-checks opts))})]
          (let [params (mapv (fn [p t] {:pat (lower-pattern (:pat p)) :ty t}) (:params n) (:inputs sig))
                params (if closure? (into [{:pat nil :ty env-ty}] params) params)
                _ (when-let [sp (first (filter #(= "self" (:name (:pat %))) params))] (set! *self-var* (:var (:pat sp))))
                _ (doseq [p params :when (:pat p)] (bind-names! (:pat p)))
                thir-body (if closure? (mirror-expr body-expr) (mirror-expr (assoc-in body-expr [:block :hir-id] (:hir-id (:body n)))))]
            (start-new-block!)
            (upd! update :source-scopes conj [nil nil])
            (let [call-site [(:hir-id body-expr) :call-site]
                  arg-scope [(:hir-id body-expr) :arguments]]
              (in-scope call-site
                (let [ret-block
                      (in-breakable-scope nil (place 0)
                        (fn []
                          (blk (in-scope arg-scope
                                 ;; args_and_body
                                 (doseq [[i p] (map-indexed vector params)]
                                   (let [l (new-local! (:ty p) :mut false)]
                                     (when (and (= :binding (:k (:pat p))) (nil? (:sub (:pat p))))
                                       (upd! update :debug conj {:name (:name (:pat p)) :scope 0 :value (place-form (place l))}))))
                                 ;; insert_upvar_arg: the captures' debug info
                                 (doseq [c captures]
                                   (upd! update :debug conj {:name (str/join "__" (cons (:name c) (upvar-symbol-fields (:cap c)))) :scope 0
                                                             :value (place-form (:use-place c))}))
                                 (let [scope (atom nil) bb (atom 0)]
                                   (doseq [[i p] (map-indexed vector params)]
                                     (let [l (inc i) pat (:pat p)]
                                       (schedule-drop-value! arg-scope l)
                                       (cond (nil? pat) nil
                                             (and (= :binding (:k pat)) (= :no (:by-ref pat)) (nil? (:sub pat)))
                                             (do (upd! assoc-in [:locals l :mut] (:mutbl pat))
                                                 (upd! assoc-in [:var-indices (:var pat)] l))
                                             :else (do (when-let [v (declare-bindings @scope pat)] (reset! scope v))
                                                       (reset! bb (place-into-pattern @bb pat (place l)))))))
                                   (when @scope (upd! assoc :source-scope @scope))
                                   (blk (expr-into-dest (place 0) @bb thir-body)))))))]
                  (terminate! ret-block '(return))
                  ;; build_drop_trees: the unwind tree, its root a resume block
                  (let [blocks (build-drop-tree-mir! (:unwind (st)) :unwind nil)]
                    (when-let [r (nth blocks 0)] (terminate! r '(resume))))
                  ret-block)))
            (finish d name :fn (count params) ret)))))))

(defn- upvar-symbol-fields
  "CapturedPlace::to_symbol's field names (`x__field`), derefs ignored"
  [cap]
  (loop [t (:base-ty cap) ps (:proj cap) acc []]
    (if-let [[k pt] (first ps)]
      (recur pt (rest ps)
             (if (= :field (first k))
               (conj acc (if (= :tuple (first t)) (str (second k))
                             (let [vid (if (tc/enum? (second t)) (:id (nth (tc/variants-any (second t)) (nth k 2))) (second t))]
                               (str (first (nth (tc/all-fields-of-variant vid) (second k)))))))
               acc))
      acc)))

(ns arbace.rust.front.mir-check
  "RF2's check (bin/rust-front mir-check): each file's `--mir-data` dump read and printed back by arbace.rust.front.mir,
  required equal to the helper's `--mir` text; the negative control prints one file's bodies against another's text."
  (:require [arbace.rust.front.mir :as mir] [arbace.string :as str]))

(defn- first-diff [a b]
  (let [la (str/split-lines a) lb (str/split-lines b)
        i (first (filter #(not= (nth la % nil) (nth lb % nil)) (range (max (count la) (count lb)))))]
    (when i (str "line " (inc i) ":\n  want " (pr-str (nth lb i nil)) "\n  got  " (pr-str (nth la i nil))))))

(defn -main [& dirs-and-names]
  (let [dir (first dirs-and-names)
        names (rest dirs-and-names)
        results (for [n names]
                  (let [edn (slurp (str dir "/" n ".mir.edn"))
                        want (slurp (str dir "/" n ".mir.txt"))
                        got (try (mir/print-dump (mir/read-dump edn)) (catch Throwable e (str "ERROR " (.getMessage e))))]
                    [n (if (= got want) :pass (or (first-diff got want) "differs"))]))
        pass (count (filter #(= :pass (second %)) results))]
    (doseq [[n r] results :when (not= :pass r)] (println "FAIL" n r))
    (println "mir-check:" pass "of" (count results) "equal to rustc's -Zunpretty=mir text")
    (when (second names)
      (let [a (first names) b (second names)
            got (mir/print-dump (mir/read-dump (slurp (str dir "/" a ".mir.edn"))))
            want (slurp (str dir "/" b ".mir.txt"))]
        (println "control (" a "against" b "):" (if (= got want) "PASSED (a bug)" "differs, as it must"))
        (when (= got want) (System/exit 1))))
    (System/exit (if (= pass (count results)) 0 1))))

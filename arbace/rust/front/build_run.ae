(ns arbace.rust.front.build-run
  "RF10's run (doc/rust/FRONTEND-SURVEY.md, \"As built: RF10 (first slice)\"): a program's own bodies from Arbace's MIR in
  place of rustc's. The pipeline (arbace.rust.front.build-check/build-program: no rustc) builds each body at the built phase;
  the passes rustc runs before codegen that change what the slice's bodies mean are applied (CleanupPostBorrowck: fake
  reads, place mentions and user type ascriptions removed, false edges and false unwinds made gotos; with panic=abort,
  every unwind action unreachable as AbortUnwindingCalls and the abort strategy leave it); then each body takes the
  place of the record's body of the same name in the helper's --mono-mir dump (the oracle tier's record: the program's
  symbols, std's resolved callees, the layouts), the facts codegen reads that are not the body's own carried over from
  the record (the symbol, a callee's instance and symbol, a function constant's symbol). arbace.rust.back.codegen then
  makes its LLVM forms as from rustc's MIR.

    -main FRONT-DIR RECORD OUT NAME [--panic-abort]   RECORD the helper's mono dump; OUT the dump with our bodies; prints
                                                       one line per body (ours, or the record's and why)"
  (:require [arbace.rust.front.build-check :as bc] [arbace.rust.front.mir :as mir] [arbace.rust.front.mono :as mono]
            [arbace.rust.front.mono-check :as mc]
            [arbace.rust.front.build :as build] [arbace.rust.front.collect :as c] [arbace.string :as str])
  (:import [java.io File]))

(defn- read-forms [s] (let [r (java.io.PushbackReader. (java.io.StringReader. s))]
                        (loop [acc []] (let [x (read {:eof ::eof} r)] (if (= x ::eof) acc (recur (conj acc x)))))))

(defn- write-forms
  "RF19: FORMS printed one a line into the file F as they are written (the module's text never whole in memory: collections'
  as one string was its run's peak)"
  [^String f forms]
  (with-open [w (java.io.BufferedWriter. (java.io.FileWriter. f))]
    (binding [*out* w] (doseq [x forms] (prn x)))))

(defn mem-mark
  "RF19: with RF_MEM_TRACE, the live heap after a collection (HeapInuse, MiB) at WHAT, on the standard error"
  [what]
  (when (System/getenv "RF_MEM_TRACE")
    (System/gc)
    (let [rt (Runtime/getRuntime)]
      (binding [*out* *err*] (println (str "debug mem " what " " (quot (- (.totalMemory rt) (.freeMemory rt)) 1048576) " MiB at "
                                                  (quot (System/currentTimeMillis) 1000)))))))

(def ^:dynamic *control*
  "The run's negative control (RF10_CONTROL=1, or bound by the batch): every Add of our bodies a Sub, so the run must differ"
  nil)
(defn- control? [] (or *control* (System/getenv "RF10_CONTROL")))

(defn- walk [f x]
  (let [x (f x)]
    (cond (seq? x) (apply list (map #(walk f %) x))
          (vector? x) (mapv #(walk f %) x)
          (map? x) (into {} (for [[k v] x] [k (walk f v)]))
          :else x)))

(defn- record-facts
  "From the record's bodies: each function constant's text -> its symbol; each callee's const text -> [callee loc]; each
  type's text -> its form (rustc's DefIds)"
  [bodies]
  (let [fsym (atom {}) callee (atom {}) tys (atom {})]
    (doseq [b bodies]
      (walk (fn [x]
              (when (and (seq? x) (= 'const (first x)) (some #{:fn-symbol} x))
                (swap! fsym assoc (second x) (second (drop-while #(not= :fn-symbol %) x))))
              (when (and (seq? x) (= 'call (first x)) (> (count x) 6))
                (swap! callee assoc (second (second x)) [(nth x 6) (nth x 7)]))
              (when (and (seq? x) (= 'ty (first x)) (string? (second x)))
                (swap! tys assoc (second x) x))
              x)
            (dissoc b :alloc-data)))
    {:fsym @fsym :callee @callee :tys @tys}))

(defn- static-name
  "The static our allocation ID names (its text `allocID (static: NAME, ..)`), else nil"
  [ours id]
  (when-let [t (get (:alloc-texts ours) id)]
    (second (re-find #"^\s*alloc\d+ \(static: ([^,]+)," t))))

(defn- alloc-bytes
  "Our allocation ID's bytes, read back from its text (write_allocation's hex columns), else nil"
  [ours id]
  (when-let [t (get (:alloc-texts ours) id)]
    (vec (for [l (rest (str/split-lines (str/trim t)))
               :when (str/includes? l "│")
               :let [l (str/trim l) l (if (str/starts-with? l "0x") (subs l (+ 2 (str/index-of l "│"))) l)
                     hex (subs l 0 (str/last-index-of l "│"))]
               b (remove str/blank? (str/split (str/trim hex) #"\s+"))]
           (if (re-matches #"[0-9a-f]{2}" b) (Integer/parseInt b 16) (throw (ex-info (str "allocation " id " holds a pointer") {})))))))

(defn std-const-value
  "RF11: a std constant our bodies name unevaluated, evaluated as rustc's codegen evaluates it (eval_mir_constant) when it is
  one of core's integer types' associated constants whose value follows from the type alone (library/core/src/num/
  int_macros.rs and uint_macros.rs: MIN = !MAX, MAX = (<uN>::MAX >> 1) as iN or !0, BITS = <uN>::BITS): (scalar BITS SIZE),
  else nil (the constant is the CTFE's, RF10's slice 5)"
  [text]
  (or
  ;; RF12-P6: core::mem::SizedTypeProperties' SIZE, ALIGN and IS_ZST of a scalar, unit or thin pointer type (intrinsics::size_of
  ;; and align_of, as CTFE evaluates them: the type's layout)
  (when-let [[_ t nm] (re-matches #"const <(.+) as core::mem::SizedTypeProperties>::(SIZE|ALIGN|IS_ZST)" text)]
    (let [[sz al] (cond (= t "()") [0 1] (#{"bool" "u8" "i8"} t) [1 1] (#{"u16" "i16"} t) [2 2] (#{"u32" "i32" "f32" "char"} t) [4 4]
                        (#{"u64" "i64" "f64" "usize" "isize"} t) [8 8] (#{"u128" "i128"} t) [16 16]
                        (and (re-matches #"(\*(const|mut) |&(mut )?)[A-Za-z0-9_:<>]+" t) (not (re-find #"\[|dyn |str" t))) [8 8]
                        :else nil)]
      (when sz (case nm "SIZE" (list 'scalar sz 8) "ALIGN" (list 'scalar al 8) "IS_ZST" (list 'scalar (if (zero? sz) 1 0) 1)))))
  ;; RF15: f32's and f64's associated constants (library/core/src/num/f32.rs and f64.rs: their bits as CTFE evaluates them,
  ;; NAN 0.0 / 0.0 rustc_apfloat's positive quiet NaN)
  (when-let [[_ t nm] (re-matches #"const core::f(32|64)::<impl f(?:32|64)>::([A-Z_0-9]+)" text)]
    (let [f32? (= t "32")
          bits (get (if f32?
                      {"MAX" 0x7f7fffff "MIN" 0xff7fffff "MIN_POSITIVE" 0x00800000 "EPSILON" 0x34000000 "NAN" 0x7fc00000
                       "INFINITY" 0x7f800000 "NEG_INFINITY" 0xff800000}
                      {"MAX" 0x7fefffffffffffffN "MIN" 0xffefffffffffffffN "MIN_POSITIVE" 0x0010000000000000N "EPSILON" 0x3cb0000000000000N
                       "NAN" 0x7ff8000000000000N "INFINITY" 0x7ff0000000000000N "NEG_INFINITY" 0xfff0000000000000N})
                    nm)
          ints (get (if f32?
                      {"RADIX" 2 "MANTISSA_DIGITS" 24 "DIGITS" 6 "MIN_EXP" -125 "MAX_EXP" 128 "MIN_10_EXP" -37 "MAX_10_EXP" 38}
                      {"RADIX" 2 "MANTISSA_DIGITS" 53 "DIGITS" 15 "MIN_EXP" -1021 "MAX_EXP" 1024 "MIN_10_EXP" -307 "MAX_10_EXP" 308})
                    nm)]
      (cond bits (list 'scalar (bigint bits) (if f32? 4 8))
            ints (list 'scalar (if (neg? ints) (+ ints 4294967296) ints) 4))))
  (when-let [[_ t nm] (re-matches #"const core::num::<impl ([iu](?:8|16|32|64|128|size))>::(MIN|MAX|BITS)" text)]
    (let [n (if (str/ends-with? t "size") 64 (parse-long (subs t 1)))
          signed? (str/starts-with? t "i")
          m (fn [k] (reduce * 1N (repeat k 2N)))]
      (case nm
        "BITS" (list 'scalar n 4)
        "MAX" (list 'scalar (bigint (dec (m (if signed? (dec n) n)))) (quot n 8))
        "MIN" (list 'scalar (if signed? (m (dec n)) 0) (quot n 8)))))))

(defn- le-bytes [v n] (let [v (biginteger (bigint v))] (vec (for [i (range n)] (.intValue (.and (.shiftRight v (int (* 8 i))) (biginteger 255)))))))

(defn- scalar-align [size] (cond (>= size 16) 16 (>= size 8) 8 :else size))

(defn- scalar-kind
  "A scalar type form's [kind bits] (kind :int, :uint, :float, :bool or :char), else nil"
  [tyf]
  (let [st (when (seq? tyf) (nth tyf 2 nil)) st (if (symbol? st) (list st) st)]
    (when (seq? st)
      (case (first st)
        bool [:bool 8] char [:char 32]
        (int uint) [(keyword (name (first st))) (let [n (second st)] (if (str/ends-with? n "size") 64 (parse-long (subs n 1))))]
        float [:float (parse-long (subs (second st) 1))]
        nil))))

(defn- bytes->int [bs] (reduce (fn [acc b] (+ (* acc 256) b)) 0N (reverse bs)))

(defn- scalar-val
  "A scalar's value (a bigint, or a double/float for a float) from its little-endian bytes"
  [[k bits] bs]
  (let [u (bytes->int bs)]
    (case k
      :float (if (= bits 32) (Float/intBitsToFloat (unchecked-int (long u))) (Double/longBitsToDouble (.longValue (biginteger u))))
      :int (if (>= u (reduce * 1N (repeat (dec bits) 2N))) (- u (reduce * 1N (repeat bits 2N))) u)
      u)))

(defn- val-bytes
  "A scalar value written back as [kind bits]'s little-endian bytes (an integer wrapped)"
  [[k bits] v]
  (let [n (quot bits 8)]
    (if (= k :float)
      (le-bytes (if (= bits 32) (bit-and (long (Float/floatToRawIntBits (float v))) 0xffffffff) (bigint (biginteger (Double/doubleToRawLongBits (double v))))) n)
      (le-bytes (mod (bigint v) (reduce * 1N (repeat bits 2N))) n))))

(defn- f->int
  "Rust's float-to-int `as`: saturating, NaN 0"
  [[k bits] x]
  (let [x (double x)
        lo (if (= k :int) (- (reduce * 1N (repeat (dec bits) 2N))) 0N)
        hi (dec (if (= k :int) (reduce * 1N (repeat (dec bits) 2N)) (reduce * 1N (repeat bits 2N))))]
    (cond (Double/isNaN x) 0N
          (<= x (double lo)) lo
          (>= x (double hi)) hi
          :else (bigint (.toBigInteger (java.math.BigDecimal. x))))))

(defn variant-bytes
  "RF15: the value of variant VIDX of an ADT whose layout is the layout form L (mono's or the record's mir/layouts entry),
  its fields' values FIELDS ([{:bytes :relocs}] in field order), as CTFE writes it into memory: each field at its offset in
  the variant's layout, the tag (a direct encoding's discriminant wrapped to the tag's width; a niche encoding's niche value
  when VIDX is not the untagged variant) at the tag's offset, zero elsewhere: {:bytes :align :relocs}"
  [l vidx fields]
  (let [vs (:variants l) size (long (:size l))
        buf (long-array size)
        relocs (atom [])
        put! (fn [off bs] (doseq [[i b] (map-indexed vector bs)] (aset buf (int (+ (long off) i)) (long b))))
        place! (fn [offs]
                 (when (not= (count offs) (count fields)) (throw (ex-info "a variant's fields and its layout's differ" {})))
                 (doseq [[o f] (map vector offs fields)]
                   (put! o (:bytes f))
                   (doseq [[ro a] (:relocs f)] (swap! relocs conj [(+ (long o) (long ro)) a]))))]
    (case (str (first vs))
      "single" (do (when-not (= vidx (second vs)) (throw (ex-info "another variant" {})))
                   (place! (if (vector? (:fields l)) (:fields l) [])))
      "multiple"
      (let [m (second vs) [_ bits _] (:tag m) off (long (first (:fields l)))
            e (:encoding m)
            tv (case (str (first e))
                 "direct" (nth (:discrs l) vidx vidx)
                 "niche" (let [[_ untagged nstart nend niche-start] e]
                           (when (and (not= vidx untagged) (<= nstart vidx nend))
                             (+ (bigint niche-start) (- vidx nstart)))))]
        (place! (:offsets (nth (:variants m) vidx)))
        (when tv
          (let [v (mod (bigint tv) (reduce * 1N (repeat bits 2N)))]
            (put! off (for [i (range (quot (long bits) 8))] (.intValue (.and (.shiftRight (biginteger v) (int (* 8 i))) (biginteger 255))))))))
      (throw (ex-info (str "a layout's variants " (pr-str vs)) {})))
    {:bytes (vec (map int buf)) :align (:align l) :relocs (vec (sort-by first @relocs))}))

(defn- alloc-bytes+relocs
  "RF17: our allocation ID's bytes and its pointers (write_allocation's `╾allocN<imm>╼`, a pointer's 8 bytes): {:bytes [B...]
  :relocs [[OFFSET N]]}, else nil"
  [ours id]
  (when-let [t (get (:alloc-texts ours) id)]
    (let [toks (for [l (rest (str/split-lines (str/trim t)))
                     :when (str/includes? l "│")
                     :let [l (str/trim l) l (if (str/starts-with? l "0x") (subs l (+ 2 (str/index-of l "│"))) l)
                           hex (subs l 0 (str/last-index-of l "│"))]
                     b (remove str/blank? (str/split (str/trim hex) #"\s+"))]
                 b)]
      (loop [ts toks bytes [] relocs []]
        (if-let [b (first ts)]
          (cond (re-matches #"[0-9a-f]{2}" b) (recur (rest ts) (conj bytes (Integer/parseInt b 16)) relocs)
                (re-matches #"╾─*alloc(\d+)<imm>─*╼" b)
                (recur (rest ts) (into bytes (repeat 8 0)) (conj relocs [(count bytes) (parse-long (second (re-matches #"╾─*alloc(\d+)<imm>─*╼" b)))]))
                :else (throw (ex-info (str "allocation " id ": " b) {})))
          {:bytes bytes :relocs relocs})))))

(defn eval-promoted
  "RF11 (RF10's slice 5's first part): a promoted constant's body evaluated as rustc's CTFE evaluates it into its allocation, for
  the promoted bodies of straight-line assignments of scalar constants (std's integer constants by std-const-value), copies of
  locals and arrays of them, whose _0 borrows a local: {:bytes [B...] :align A :relocs [[OFFSET ALLOC]]}; else an ex-info (the
  CTFE's: the rest of slice 5). RF15: arithmetic, unary operators and numeric casts on scalars (rustc_const_eval's
  binary_op, unary_op and cast: integers wrapped, floats IEEE as Rust's), and a string's or byte string's constant (a
  pointer to its bytes' allocation, RAW-ALLOC's [ALLOC LEN]: the fat pointer's relocation)"
  ([pb] (eval-promoted pb nil nil nil nil nil nil))
  ([pb raw-alloc nest-alloc unit-variant anon-discr vt-alloc layout-of]
   (eval-promoted pb raw-alloc nest-alloc unit-variant anon-discr vt-alloc layout-of nil false))
  ;; RF17: LOCAL-CONST, a local constant's value by its text ((scalar BITS SIZE), else nil); VALUE?: PB is a constant's own body
  ;; (construct_const's: _0 holds the value, not a borrow), its result _0's value
  ([pb raw-alloc nest-alloc unit-variant anon-discr vt-alloc layout-of local-const value?]
  (let [env (atom {}) result (atom nil)
        no (fn [what x] (throw (ex-info (str "promoted: " what (when (System/getenv "RF_PROMOTED_TRACE") (str " " (pr-str x)))) {:x x})))
        loc-of (fn [p] (if (and (seq? p) (= 'place (first p)) (= 2 (count p))) (second p) (no "a projected place" p)))
        local-ty (fn [l] (:ty (nth (:locals pb) l nil)))
        operand (fn [o]
                  (case (first o)
                    const (let [[_ text tyf v] o
                                ;; RF15: a variant's explicit discriminant (its anonymous constant, `Color::Green::{constant#0}`)
                                discr-v (fn [] (when-let [[_ vp] (and anon-discr (re-matches #"const (.+)::\{constant#\d+\}" text))]
                                                    (when-let [d (anon-discr vp)]
                                                      (when-let [[k bits] (scalar-kind tyf)]
                                                        (list 'scalar (mod (bigint d) (reduce * 1N (repeat bits 2N))) (quot bits 8))))))
                                v (if (and (seq? v) (= 'unevaluated (first v))) (or (std-const-value text) (discr-v) (when local-const (local-const text tyf v)) (no "an unevaluated constant" o)) v)]
                            (cond
                              (and (seq? v) (= 'scalar (first v)))
                              (let [[_ bits size] v] {:bytes (le-bytes bits size) :align (scalar-align size) :ty tyf})
                              ;; RF15: `&"two"` (a &str: its bytes' allocation and length) and `&b"ab"` (a pointer)
                              (and (seq? v) (#{'raw-str 'raw-bytes} (first v)) raw-alloc)
                              (let [[a n] (raw-alloc (first v) (second v))]
                                (if (= 'raw-str (first v))
                                  {:bytes (vec (concat (repeat 8 0) (le-bytes n 8))) :align 8 :relocs [[0 a]] :ty tyf}
                                  {:bytes (vec (repeat 8 0)) :align 8 :relocs [[0 a]] :ty tyf}))
                              :else (no "a constant's value" o)))
                    (copy move) (let [p (second o)]
                                  (if (and (seq? p) (= 3 (count p)) (seq? (nth p 2)) (= 'field (first (nth p 2))))
                                    ;; RF16: a field of a value whose fields are kept (a checked operator's (T, bool))
                                    (let [v (or (get @env (second p)) (no "a local not assigned" o))]
                                      (or (nth (:parts v) (second (nth p 2)) nil) (no "a field of a value without its fields" o)))
                                    (or (get @env (loc-of p)) (no "a local not assigned" o))))
                    (no "an operand" o)))
        sk (fn [x tyf] (or (scalar-kind tyf) (no "a non-scalar operand" x)))
        binop (fn [rv dst-ty]
                (let [[_ op a b] rv va (operand a) vb (operand b)
                      ka (sk rv (:ty va)) kb (sk rv (:ty vb))
                      x (scalar-val ka (:bytes va)) y (scalar-val kb (:bytes vb))
                      kd (sk rv dst-ty)
                      cmp (fn [f] (val-bytes [:bool 8] (if (f) 1 0)))
                      fl? (= :float (first ka))
                      arith (fn [f] (val-bytes kd (if fl? (if (= 32 (second ka)) (float (f (float x) (float y))) (f (double x) (double y))) (f x y))))]
                  (when (and (#{"Div" "Rem"} op) (not fl?) (zero? y)) (no "a division by zero" rv))
                  {:ty dst-ty :align (scalar-align (quot (second kd) 8))
                   :bytes (case op
                            "Add" (arith +) "Sub" (arith -) "Mul" (arith *)
                            "Div" (arith (if fl? / quot)) "Rem" (arith (if fl? (fn [p q] (if (= 32 (second ka)) (float (rem (float p) (float q))) (rem (double p) (double q)))) rem))
                            "BitAnd" (val-bytes kd (.and (biginteger x) (biginteger y)))
                            "BitOr" (val-bytes kd (.or (biginteger x) (biginteger y)))
                            "BitXor" (val-bytes kd (.xor (biginteger x) (biginteger y)))
                            "Shl" (val-bytes kd (.shiftLeft (biginteger x) (int (mod y (second ka)))))
                            "Shr" (val-bytes kd (.shiftRight (biginteger x) (int (mod y (second ka)))))
                            "Eq" (cmp #(== x y)) "Ne" (cmp #(not (== x y))) "Lt" (cmp #(< x y)) "Le" (cmp #(<= x y))
                            "Gt" (cmp #(> x y)) "Ge" (cmp #(>= x y))
                            (no (str "a binop " op) rv))}))
        layout-or-nil (fn [tyf] (try (layout-of tyf) (catch Throwable _ nil)))
        ;; RF16: a checked operator (AddWithOverflow, SubWithOverflow, MulWithOverflow: rustc_const_eval's
        ;; binary_op's overflowing_binary_op): (T, bool), the wrapped value at 0 and the overflow flag after it, the tuple's
        ;; size T's rounded to its alignment; its fields kept for a projection (`_2.0`, `_2.1`)
        checked (fn [rv dst-ty]
                  (let [[_ op a b] rv va (operand a) vb (operand b)
                        ka (sk rv (:ty va)) x (scalar-val ka (:bytes va)) y (scalar-val (sk rv (:ty vb)) (:bytes vb))
                        exact (case op "AddWithOverflow" (+ x y) "SubWithOverflow" (- x y) "MulWithOverflow" (* x y))
                        vb* (val-bytes ka exact)
                        ovf (if (== exact (scalar-val ka vb*)) 0 1)
                        al (scalar-align (quot (second ka) 8))
                        size (* al (quot (+ (count vb*) 1 (dec al)) al))]
                    {:ty dst-ty :align al
                     :bytes (vec (concat vb* [ovf] (repeat (- size (count vb*) 1) 0)))
                     :parts [{:bytes vb* :align al :ty (:ty va)} {:bytes [ovf] :align 1 :ty '(ty "bool" bool)}]}))
        unop (fn [rv dst-ty]
               (let [[_ op a] rv va (operand a) k (sk rv (:ty va)) x (scalar-val k (:bytes va))]
                 {:ty dst-ty :align (:align va)
                  :bytes (case op
                           "Neg" (val-bytes k (if (= :float (first k)) (if (= 32 (second k)) (float (- (float x))) (- (double x))) (- x)))
                           "Not" (if (= :bool (first k)) (val-bytes k (if (zero? x) 1 0)) (val-bytes k (.not (biginteger x))))
                           (no (str "a unop " op) rv))}))
        cast (fn [rv]
               (if (str/starts-with? (str (second rv)) "PointerCoercion(Unsize")
                 ;; RF16: a thin pointer to a trait object (`&Dog as &dyn Animal`): the pointer, then its vtable's allocation (mono's,
                 ;; as the runtime body's casts take theirs)
                 (let [[_ _ a tyf] rv va (operand a)
                       vt (or (when vt-alloc (vt-alloc (second tyf) (second (:ty va)))) (no "an unsizing cast without its vtable" rv))]
                   (when-not (= 8 (count (:bytes va))) (no "an unsizing cast of a fat pointer" rv))
                   {:ty tyf :align 8 :bytes (vec (concat (:bytes va) (repeat 8 0))) :relocs (conj (vec (:relocs va)) [8 vt])})
               (let [[_ kind a tyf] rv va (operand a) ks (sk rv (:ty va)) kd (sk rv tyf) x (scalar-val ks (:bytes va))]
                 {:ty tyf :align (scalar-align (quot (second kd) 8))
                  :bytes (case kind
                           "IntToInt" (val-bytes kd x)
                           "IntToFloat" (val-bytes kd (if (= 32 (second kd)) (float (.doubleValue (biginteger x))) (.doubleValue (biginteger x))))
                           "FloatToFloat" (val-bytes kd (if (= 32 (second kd)) (float x) (double x)))
                           "FloatToInt" (val-bytes kd (f->int kd x))
                           (no (str "a cast " kind) rv))})))]
    (loop [bi 0 seen #{}]
      (when (seen bi) (no "a loop" bi))
      (let [blk (nth (:blocks pb) bi)]
        (doseq [st (:stmts blk)]
          (case (first st)
            ;; (RF17: a constant's built body keeps its fake reads and user type ascriptions, which CTFE ignores)
            (storage-live storage-dead nop fake-read place-mention) nil
            raw (when-not (str/starts-with? (str (second st)) "AscribeUserType") (no "a statement" st))
            assign (let [[_ p rv] st l (loc-of p)]
                     (case (first rv)
                       use (swap! env assoc l (operand (second rv)))
                       binop (swap! env assoc l (if (str/ends-with? (str (second rv)) "WithOverflow") (checked rv (local-ty l)) (binop rv (local-ty l))))
                       unop (swap! env assoc l (unop rv (local-ty l)))
                       cast (swap! env assoc l (cast rv))
                       aggregate (let [[_ kind ops] rv]
                                   (cond
                                     (and (seq? kind) (= 'array (first kind)))
                                     (let [vs (map operand ops)
                                           offs (reductions + 0 (map (comp count :bytes) vs))]
                                       (swap! env assoc l {:bytes (vec (mapcat :bytes vs)) :align (if (seq vs) (apply max (map :align vs)) 1)
                                                           :relocs (vec (for [[v o] (map vector vs offs) [ro a] (:relocs v)] [(+ o ro) a]))}))
                                     ;; RF15: an enum's variant (`Enum::Variant`'s path), fieldless (`&Color::Blue`) or with fields
                                     ;; (`&Some(1.5)`): its layout's bytes, the tag as mono lays it out
                                     (and (seq? kind) (= 'adt (first kind)) unit-variant (integer? (nth kind 5 nil))
                                          (re-find #"(^|::)[A-Z][A-Za-z0-9_]*(::<[^>]*>)?::[A-Z][A-Za-z0-9_]*$" (str (second kind))))
                                     (swap! env assoc l (unit-variant (local-ty l) (nth kind 5) (mapv operand ops)))
                                     ;; RF15: a tuple or struct of several fields (`&(-3, true)`): each at its offset in the layout
                                     (and (seq? kind) (#{'adt 'tuple} (first kind)) unit-variant (> (count ops) 1)
                                          (or (= 'tuple (first kind)) (contains? #{nil 0} (nth kind 5 nil))))
                                     (swap! env assoc l (unit-variant (local-ty l) 0 (mapv operand ops)))
                                     ;; RF13: a struct, tuple or variant-less ADT of no field (a unit struct: `&Dog`) or of one scalar
                                     ;; field (a newtype: `&Bird(1)`), whose layout is its field's
                                     (and (seq? kind) (#{'adt 'tuple} (first kind)) (<= (count ops) 1)
                                          (or (= 'tuple (first kind))
                                              ;; a struct's constructor, not an enum's variant (`E::V`: the variant's tag is in the layout)
                                              (and (contains? #{nil 0} (nth kind 5 nil)) (#{"struct" "fn" "const"} (str (nth kind 2 nil)))
                                                   (not (re-find #"(^|::)[A-Z][A-Za-z0-9_]*::[A-Z][A-Za-z0-9_]*$" (str (nth kind 4 nil)))))))
                                     (swap! env assoc l (if (seq ops) (operand (first ops)) {:bytes [] :align 1}))
                                     :else (no (str "an aggregate " (when (seq? kind) (first kind))) kind)))
                       ;; RF13: [x; N] of a scalar constant (`&[0u8; 100]`)
                       repeat (let [[_ o n] rv v (operand o) n (Long/parseLong (str n)) w (count (:bytes v))]
                                (swap! env assoc l {:bytes (vec (apply concat (repeat n (:bytes v)))) :align (:align v)
                                                    :relocs (vec (for [i (range n) [ro a] (:relocs v)] [(+ (* i w) ro) a]))}))
                       ref (let [tp (nth rv 2)
                                 deref? (and (seq? tp) (= 3 (count tp)) (= '(deref) (nth tp 2)))]
                             (cond
                               (= l 0) (reset! result (or (get @env (loc-of tp)) (no "a borrow of a local not assigned" rv)))
                               ;; RF15: `&*p` of a pointer local: the same pointer (a reborrow)
                               deref? (swap! env assoc l (assoc (or (get @env (second tp)) (no "a reborrow of a local not assigned" rv)) :ty (local-ty l)))
                               ;; RF15: a borrow of another local: its value an allocation of its own (CTFE's intern, a nested allocation)
                               ;; (RF16: kept in the local, as the other borrows are)
                               nest-alloc (let [v (or (get @env (loc-of tp)) (no "a borrow of a local not assigned" rv))]
                                            (swap! env assoc l {:bytes (vec (repeat 8 0)) :align 8 :relocs [[0 (nest-alloc v)]] :ty (local-ty l)}))
                               :else (no "a borrow but _0's" rv)))
                       (no (str "an rvalue " (first rv)) rv)))
            (no "a statement" st)))
        (let [t (:term blk)]
          (case (first t)
            return (if value? (or (get @env 0) (no "no value in _0" pb)) (or @result (no "no borrow in _0" pb)))
            (goto false-edge false-unwind) (recur (second t) (conj seen bi))
            ;; RF16: an assertion (a checked operator's overflow flag): its target when the condition is the expected value,
            ;; else the CTFE's error (the promoted fails to evaluate)
            assert (let [[_ c expected _ target] t v (operand c)]
                     (if (= (boolean expected) (not (every? zero? (:bytes v))))
                       (recur target (conj seen bi))
                       (no "an assertion that fails" t)))
            ;; RF16: a call of core's `ptr::null::<T>()` or `ptr::null_mut::<T>()` (a thin T: library/core/src/ptr/mod.rs,
            ;; `without_provenance(0)`, the null pointer's 8 zero bytes), then its target; another call is the CTFE's
            call (let [[_ f _ dest target] t
                       txt (str (when (seq? f) (second f)))]
                   ;; (nested ifs: the tools' host refused this loop's recurs inside a cond as not in tail position)
                   (if (and target (re-matches #"(std|core)::ptr::null(_mut)?::<[^\[]*>" txt) (not (re-find #"dyn |\[|\bstr\b" txt)))
                     (do (swap! env assoc (loc-of dest) {:bytes (vec (repeat 8 0)) :align 8 :ty (local-ty (loc-of dest))})
                         (recur target (conj seen bi)))
                     ;; `mem::size_of::<T>()` and `mem::align_of::<T>()` (intrinsics::size_of and align_of, as CTFE evaluates them:
                     ;; T's layout, mono's), a usize
                     (if (and target layout-of (re-matches #"(std|core)::mem::(size_of|align_of)::<.+>" txt))
                       (let [ft (nth f 2 nil) st (when (seq? ft) (nth ft 2 nil)) ta (when (and (seq? st) (= 'fndef (first st))) (first (nth st 2 nil)))
                             l (or (when ta (layout-or-nil ta)) (no "a call of size_of without its type's layout" t))]
                         (swap! env assoc (loc-of dest) {:bytes (le-bytes (if (str/includes? txt "size_of") (:size l) (:align l)) 8) :align 8 :ty (local-ty (loc-of dest))})
                         (recur target (conj seen bi)))
                       (no "a call" t))))
            (no "a terminator" t))))))))

(defn- slice-len-fn? [d]
  (or (= d "core::slice::<impl [T]>::len")
      (= d (try (c/lang "slice_len_fn") (catch Throwable _ ::none)))))

(defn lower-slice-len-calls
  "RF15: rustc_mir_transform's LowerSliceLenCalls (lower_slice_len.rs, an optimization pass enabled at mir-opt-level 1, so at
  -O0): a call of `<[T]>::len` (the lang item slice_len_fn) becomes `DEST = PtrMetadata(ARG)` and a goto to its target, so
  the instance is never reached (rustc's optimized MIR, the record's, has no such call)"
  [blocks]
  (mapv (fn [b]
          (let [t (:term b)]
            (if-not (and (seq? t) (= 'call (first t)) (seq? (second t)) (= 'const (first (second t))))
              b
              (let [[_ f args dest target] t
                    ft (:tc (meta (nth f 2 nil)))]
                (if (and (vector? ft) (= :fndef (first ft)) (slice-len-fn? (second ft)) (= 1 (count args)) (some? target))
                  (-> b (update :stmts #(conj (vec %) (list 'assign dest (list 'unop "PtrMetadata" (first args)))))
                      (assoc :term (list 'goto target)))
                  b)))))
        blocks))

(defn- runtime-body
  "Our built body made the runtime body codegen takes, with the record's facts; a static's pointer (static-ptr ID) the record's
  static (its symbol, by the static's name) as rustc's optimized MIR gives it: (ptr allocS<ID> 0 8) with that allocation's data"
  [ours rec facts abort?]
  (let [static-data (atom [])
        vt-fn (atom (fn [_ _] nil))   ; RF16: a promoted constant's casts' vtables (set below)
        fix-static (fn [x]
                     (cond
                       ;; queue 448: a native instance's evaluated constant allocation (sized-const-eval's LAYOUT): an immutable
                       ;; memory allocation of its bytes, named by them
                       (and (seq? x) (= 'indirect-bytes (first x)))
                       (let [[_ hx al] x a (str "allocL" hx)]
                         (swap! static-data conj [a {:kind :memory :align al :mutable false :bytes hx :init (apply str (repeat (quot (count hx) 2) "1")) :relocs []}])
                         (list 'indirect (symbol a) 0))
                       :else
                     (if (and (seq? x) (= 'static-ptr (first x)))
                       (let [id (second x) nm (static-name ours id)
                             st (or (get (:statics facts) nm) (throw (ex-info (str "no static " nm " in the record") {})))
                             a (str "allocS" id)]
                         (swap! static-data conj [a (merge {:kind :static :symbol (:symbol st) :def (:def st)}
                                                           ;; its initializer from our own allocation (the static's evaluated bytes)
                                                           ;; (RF17: with its pointers, each to its own allocation's bytes: `&str`'s)
                                                           (when-let [{bs :bytes rs :relocs} (alloc-bytes+relocs ours id)]
                                                             {:bytes (apply str (map #(format "%02x" %) bs))
                                                              :align (parse-long (or (second (re-find #"align: (\d+)\)" (get (:alloc-texts ours) id))) "1"))
                                                              :relocs (vec (for [[off tid] rs]
                                                                             (let [tb (or (alloc-bytes ours tid) (throw (ex-info (str "no bytes for allocation " tid) {})))
                                                                                   ta (str "allocB" tid)]
                                                                               (swap! static-data conj [ta {:kind :memory :align 1 :mutable false :bytes (apply str (map #(format "%02x" %) tb))
                                                                                                            :init (apply str (repeat (count tb) "1")) :relocs []}])
                                                                               [off ta])))
                                                              :mutable true}))])   ; the record does not say `mut`; writable either way at -O0
                         (list 'ptr (symbol a) 0 8))
                       (if (and (seq? x) (#{'raw-str 'raw-bytes} (first x)))
                         ;; a string's or byte string's bytes (allocate_bytes_dedup): rustc's (slice allocN LEN) for &str, a
                         ;; pointer for &[u8; N], the bytes an immutable memory allocation of alignment 1
                         (let [id (second x) bs (or (alloc-bytes ours id) (throw (ex-info (str "no bytes for allocation " id) {})))
                               a (str "allocB" id)]
                           (swap! static-data conj [a {:kind :memory :align 1 :mutable false :bytes (apply str (map #(format "%02x" %) bs))
                                                       :init (apply str (repeat (count bs) "1")) :relocs []}])
                           (if (= 'raw-str (first x)) (list 'slice (symbol a) (count bs)) (list 'ptr (symbol a) 0 8)))
                         ;; RF11: our promoted constants (PromoteTemps' bodies) evaluated into their allocations (eval-promoted)
                         (if (and (seq? x) (= 'const (first x)) (seq? (nth x 3 nil)) (= 'unevaluated (first (nth x 3))) (some? (nth (nth x 3) 3 nil)))
                           (let [idx (nth (nth x 3) 3)
                                 pb (or (get (:promoted-bodies ours) idx) (throw (ex-info (str "no promoted body " idx) {})))
                                 raw-alloc (fn [kind id]
                                             (let [bs (or (alloc-bytes ours id) (throw (ex-info (str "no bytes for allocation " id) {})))
                                                   a (str "allocB" id)]
                                               (swap! static-data conj [a {:kind :memory :align 1 :mutable false :bytes (apply str (map #(format "%02x" %) bs))
                                                                           :init (apply str (repeat (count bs) "1")) :relocs []}])
                                               [a (count bs)]))
                                 nest-n (atom 0)
                                 nest-alloc (fn [{:keys [bytes align relocs]}]
                                              (let [a (str "allocP" idx "n" (swap! nest-n inc))]
                                                (swap! static-data conj [a {:kind :memory :align align :mutable false :bytes (apply str (map #(format "%02x" %) bytes))
                                                                            :init (apply str (repeat (count bytes) "1")) :relocs (vec (or relocs []))}])
                                                a))
                                 {:keys [bytes align relocs]} (try (eval-promoted pb raw-alloc nest-alloc (:unit-variant facts) (:anon-discr facts)
                                                                                  (fn [tgt src] (@vt-fn tgt src)) (:layout-of facts) (:local-const facts) false)
                                                                   (catch Throwable e (when-let [f (:const! facts)] (f false))
                                                                     (when (System/getenv "RF_PROMOTED_TRACE") (.printStackTrace e))
                                                                     (throw e)))
                                 a (str "allocP" idx)]
                             (when-let [f (:const! facts)] (f true))
                             (swap! static-data conj [a {:kind :memory :align align :mutable false :bytes (apply str (map #(format "%02x" %) bytes))
                                                         :init (apply str (repeat (count bytes) "1")) :relocs (vec (or relocs []))}])
                             (apply list (concat (take 3 x) [(list 'ptr (symbol a) 0 8)] (drop 4 x))))
                           x)))))
        ;; RFP44 (a): an unsizing cast to a trait object carries its vtable's allocation (codegen's pair's second half): mono's
        ;; (vtable-alloc: the entries laid out natively), else the record's cast of the same types in the same body (counted)
        rec-vts (atom (reduce (fn [m [k v]] (update m k (fnil conj []) v)) {}
                              (for [blk (:blocks rec) st (:stmts blk) :when (and (seq? st) (= 'assign (first st)))
                                    :let [rv (nth st 2 nil)] :when (and (seq? rv) (= 'cast (first rv)))
                                    :let [i (.indexOf ^java.util.List rv :vtable)] :when (pos? i)]
                                [(second (nth rv 3)) (nth rv (inc i))])))
        rec-allocs (into {} (:alloc-data rec))
        rec-closure (fn [id] (loop [todo [(str id)] seen #{}]
                               (if-let [a (first todo)]
                                 (if (contains? seen a) (recur (rest todo) seen)
                                     (recur (concat (rest todo) (map (comp str second) (:relocs (get rec-allocs a)))) (conj seen a)))
                                 seen)))
        vt-count (atom 0)
        ;; this body's dyn casts' vtables from mono, in the body's order (program-facts' :vtables): taken in turn by target type
        vt-queue (atom (get (:vtables facts) (:name ours)))
        ;; (RF16: by its source's type too when the cast's operand is a plain local, else the first of its target's)
        take-vt! (fn [tgt src] (let [q @vt-queue
                                     i (or (when src (first (keep-indexed (fn [i [t _ s]] (when (and (= t tgt) (= s src)) i)) q)))
                                           (first (keep-indexed (fn [i [t _]] (when (= t tgt) i)) q)))]
                             (if i (do (reset! vt-queue (vec (concat (subvec q 0 i) (subvec q (inc i))))) (second (nth q i))) ::none)))
        ;; a native vtable's allocations (its entries' function allocations, then the table): its name
        vt-alloc! (fn [nv]
                    (let [k (swap! vt-count inc) a (str "allocV" k)
                          es (:entries nv)
                          fns (keep-indexed (fn [i [kind v]] (when (= :fn kind) [i (str "allocV" k "f" i) v])) es)]
                      (when-let [f (:vtable! facts)] (f true))
                      (doseq [[_ fa sym] fns] (swap! static-data conj [fa {:kind :fn :symbol sym}]))
                      (swap! static-data conj [a {:kind :memory :align 8 :mutable false
                                                  :bytes (apply str (for [[kind v] es b (if (= :usize kind) (le-bytes v 8) (repeat 8 0))] (format "%02x" b)))
                                                  :init (apply str (repeat (* 8 (count es)) "1"))
                                                  :relocs (vec (for [[i fa _] fns] [(* 8 i) fa]))}])
                      a))
        ;; RF16: a promoted constant's cast (PromoteTemps moved it out of the body mono saw) takes the body's vtable of its
        ;; target and source types
        _ (reset! vt-fn (fn [tgt src]
                          (let [q @vt-queue
                                i (first (keep-indexed (fn [i [t _ s]] (when (and (= t tgt) (= s src)) i)) q))]
                            (when i
                              (reset! vt-queue (vec (concat (subvec q 0 i) (subvec q (inc i)))))
                              (let [nv (second (nth q i))]
                                (if (and (map? nv) (not (mono/error? nv)))
                                  (vt-alloc! nv)
                                  (do (when-let [f (:vtable! facts)] (f false)) nil)))))))
        fix-cast (fn [x]
                   (if (and (seq? x) (= 'cast (first x)) (str/starts-with? (str (second x)) "PointerCoercion(Unsize")
                            (not (some #{:vtable} x)) (seq? (nth x 3 nil)) (or (:vtables facts) (seq @rec-vts)))
                     (let [tgt (second (nth x 3))
                           op (nth x 2) pl (when (and (seq? op) (#{'copy 'move} (first op))) (second op))
                           src (when (and (seq? pl) (= 2 (count pl))) (second (:ty (nth (:locals ours) (second pl) nil))))
                           nv (take-vt! tgt src)]
                       (cond
                         ;; queue n-rust-dyn: a cast mono's facts do not name (a native library body's: mono collects none of
                         ;; their casts) takes the record's cast of the same target type in the record's body of its symbol
                         ;; (the instance the native body was judged equal to), its vtable's allocations copied; not from a trait object
                         ;; (a coercion between trait objects keeps its metadata: codegen's)
                         (and (= ::none nv) (seq (get @rec-vts tgt)) (not (str/includes? (str src) "dyn ")))
                         (let [id (first (get @rec-vts tgt))]
                           (swap! rec-vts update tgt (comp vec rest))
                           (when-let [f (:vtable! facts)] (f false))
                           (doseq [a (rec-closure id)] (when-let [v (get rec-allocs a)] (swap! static-data conj [a v])))
                           (concat x [:vtable id]))
                         (= ::none nv) x
                         (and (map? nv) (not (mono/error? nv)))
                         (concat x [:vtable (symbol (vt-alloc! nv))])
                         :else
                         (if-let [id (first (get @rec-vts tgt))]
                           (do (swap! rec-vts update tgt (comp vec rest))
                               (when-let [f (:vtable! facts)] (f false))
                               (doseq [a (rec-closure id)] (when-let [v (get rec-allocs a)] (swap! static-data conj [a v])))
                               (concat x [:vtable id]))
                           (throw (ex-info (str "no vtable for a cast to " tgt ": " (second nv)) {})))))
                     x))
        unwind (fn [u] (if abort? '(unreachable) u))
        loc (list 'loc "?" 0 0)
        fix-ty (fn [x] (if (and (seq? x) (= 'ty (first x)) (:tys facts)) (get (:tys facts) (second x) x) x))
        ;; RF11: std's integer constants (std-const-value); another unevaluated named constant is left (codegen refuses it)
        fix-uneval (fn [x] (if (and (seq? x) (= 'const (first x)) (seq? (nth x 3 nil)) (= 'unevaluated (first (nth x 3))) (nil? (nth (nth x 3) 3 nil)))
                             (if-let [v (or (std-const-value (second x)) (when-let [lc (:local-const facts)] (lc (second x) (nth x 2) (nth x 3))))]
                               (do (when-let [f (:const! facts)] (f true)) (apply list (concat (take 3 x) [v] (drop 4 x))))
                               (do (when-let [f (:const! facts)] (f false)) x))
                             x))
        ;; RF17 (RFP50 (a)'s first part): a closure reified as a function pointer (ClosureFnPointer) carries its ClosureOnceShim's
        ;; symbol (mono's), whose body is the record's (a shim of core's FnOnce::call_once)
        fix-closure-ptr (fn [x]
                          (if (and (seq? x) (= 'cast (first x)) (str/starts-with? (str (second x)) "PointerCoercion(ClosureFnPointer")
                                   (not (some #{:fn-symbol} x)) (:closure-fnptr facts))
                            (let [op (nth x 2)
                                  tyf (cond (and (seq? op) (= 'const (first op))) (nth op 2 nil)
                                            (and (seq? op) (#{'copy 'move} (first op)) (seq? (second op)) (= 2 (count (second op))))
                                            (:ty (nth (:locals ours) (second (second op)) nil)))
                                  sy (when tyf ((:closure-fnptr facts) tyf))]
                              (if sy (concat x [:fn-symbol sy]) x))
                            x))
        fix-const (fn [x] (if (and (seq? x) (= 'const (first x)) (get (:fsym facts) (second x)) (not (some #{:fn-symbol} x)))
                            (concat x [:fn-symbol (get (:fsym facts) (second x))])
                            x))
        term (fn [t]
               (case (first t)
                 false-edge (list 'goto (second t))
                 false-unwind (list 'goto (second t))
                 call (let [[_ f args dest target u] t
                            [cal l] (if-let [nat (:native-call facts)]
                                      (nat f)
                                      (or (get (:callee facts) (second f))
                                          (throw (ex-info (str "no callee in the record for " (second f)) {}))))]
                        (list 'call f args dest target (unwind u) cal l 0))
                 assert (let [[_ c e m target u] t
                              t (if-let [sp (get (:assert-spans ours) [c e m])] (vary-meta t assoc :assert-span sp) t)]
                          (list 'assert c e m target (unwind u) (if-let [al (:assert-loc facts)] (al t) loc) 0))
                 drop (let [[_ p target u r d] t] (list 'drop p target (unwind u) r d nil))
                 t))
        keep-stmt? (fn [s] (not (or (#{'fake-read 'place-mention} (first s))
                                    (and (= 'raw (first s)) (str/starts-with? (str (second s)) "AscribeUserType")))))]
    (-> (walk (comp fix-closure-ptr fix-cast fix-uneval fix-static fix-const fix-ty)
          (merge (if (:header facts) ((:header facts) rec) (select-keys rec [:def :def-id :phase :instance :symbol :name :kind :track-caller :spread-arg]))
                 {:args (:args ours) :ret (:ret ours)
                  :locals (:locals ours)
                  :scopes (mapv (fn [[p _]] [p nil nil nil false]) (:scopes ours))
                  :debug (:debug ours)
                  :blocks (mapv (fn [b] {:cleanup (:cleanup b) :stmts (vec (filter keep-stmt? (:stmts b))) :after-dbg [] :term (term (:term b))})
                                (lower-slice-len-calls (:blocks ours)))
                  :allocs "" :alloc-data []}))
        (assoc :alloc-data (vec (distinct @static-data))))))

;; layouts the record lacks (rustc's optimized MIR drops the unit temporaries and the overflow checks' tuples our built
;; MIR keeps): rustc_abi's layout of scalars, unit and pairs of scalars (univariant's scalar pair), the rest refused
(def ^:private max64 18446744073709551615N)
(defn- scalar-of [st]
  (let [k (first st)]
    (case k
      bool [1 1 (list 'int 8 false [0 1])]
      char [4 4 (list 'int 32 false [0 1114111])]
      (int uint) (let [n (second st) bits (case n ("isize" "usize") 64 (parse-long (subs n 1)))]
                   [(quot bits 8) (min 8 (quot bits 8)) (list 'int bits (= k 'int) [0 (dec (reduce * 1N (repeat bits 2N)))])])
      (ref ptr) [8 8 (list 'ptr [(if (= k 'ref) 1 0) max64])]
      nil)))

(defn- layout-of [[_ text st]]
  (let [st (if (symbol? st) (list st) st)]
    (cond
      (= text "()") {:size 0 :align 1 :abi '(memory true) :fields [] :variants '(single 0) :uninhabited false}
      (scalar-of st) (let [[sz al sc] (scalar-of st)] {:size sz :align al :abi (list 'scalar sc) :fields '(primitive) :variants '(single 0) :uninhabited false})
      (and (= 'tuple (first st)) (= 2 (count (rest st))) (every? #(scalar-of (let [x (nth % 2)] (if (symbol? x) (list x) x))) (rest st)))
      (let [[a b] (map #(scalar-of (let [x (nth % 2)] (if (symbol? x) (list x) x))) (rest st))
            off (* (:align {} (second b) (second b)) (quot (+ (first a) (dec (second b))) (second b)))
            al (max (second a) (second b))]
        {:size (* al (quot (+ off (first b) (dec al)) al)) :align al :abi (list 'pair (nth a 2) (nth b 2) off) :fields [0 off] :variants '(single 0) :uninhabited false})
      :else nil)))

(def ^:dynamic *loc-file*
  "RF11: the file name a caller location carries (rustc's: the path the program was given by, rsi's plan's relative to the
  checkout); nil, the root file's canonical path (run-built's samples, whose records name that path)"
  nil)

(declare native-main pack-main)

(declare batch-main)
(defn -main [front-dir record out n & flags]
  (if (= "batch" front-dir) (apply batch-main record out n flags)
  (if-let [crates (System/getenv "RF_MONO_CRATES")]
    (apply native-main crates front-dir record out n flags)
    (apply pack-main front-dir record out n flags))))

(defn pack-main [front-dir record out n & flags]
  (let [abort? (some #{"--panic-abort"} flags)
        forms (read-forms (slurp record))
        rec-bodies (for [f forms :when (= 'mir/body (first f))] (second f))
        facts (assoc (record-facts rec-bodies)
                     :statics (into {} (for [f forms :when (= 'mir/static (first f)) :let [m (second f)]]
                                         [(str/replace (last (str/split (str (:def m)) #"::")) #"\)$" "") m])))
        ours (into {} (for [[nm b err] (bc/build-program front-dir n)] [nm [b err]]))
        lines (atom [])
        new-forms (for [f forms]
                    (if (= 'mir/body (first f))
                      (let [rec (second f) [b err] (get ours (:name rec))]
                        (if b
                          (try (let [r (runtime-body b rec facts abort?)
                                     ;; the negative control (RF10_CONTROL=1): every Add of our bodies a Sub, so the run must differ
                                     r (if (control?) (walk #(if (= "Add" %) "Sub" (if (= "AddWithOverflow" %) "SubWithOverflow" %)) r) r)
                                     r (assoc r :phase "arbace-built+cleanup")]
                                 (swap! lines conj (str "ours   " (:name rec)))
                                 (list 'mir/body r))
                               (catch Throwable e (swap! lines conj (str "record " (:name rec) " (" (.getMessage e) ")")) f))
                          (do (swap! lines conj (str "record " (:name rec) " (" (if err err "not ours: std's or a shim") ")")) f)))
                      f))]
    (let [new-forms (doall new-forms)
          have (set (for [f forms :when (= 'mir/layouts (first f)) [t _] (second f)] t))
          used (atom {})
          _ (doseq [f new-forms :when (= 'mir/body (first f))]
              (walk (fn [x] (when (and (seq? x) (= 'ty (first x)) (string? (second x)) (not (have (second x)))) (swap! used assoc (second x) x)) x) (:locals (second f))))
          extra (keep (fn [[t x]] (when-let [l (layout-of x)] [t l])) @used)
          new-forms (for [f new-forms] (if (= 'mir/layouts (first f)) (list 'mir/layouts (vec (sort-by first (concat (second f) extra)))) f))]
      (spit out (with-out-str (doseq [f new-forms] (prn f)))))
    (doseq [l @lines] (println l))
    (println (format "build-run: %s: %d of %d bodies ours" n (count (filter #(str/starts-with? % "ours") @lines)) (count @lines)))
    (System/exit 0)))

;; ---------------------------------------------------------------------------------------------
;; ---------------------------------------------------------------------------------------------
;; RF12-P6: core's bodies built by Arbace (bin/rust-front core-check's export, CORE_EXPORT: each body's runtime MIR after the
;; 21 passes, its types in core's paths) taken in place of the record's core bodies: each printed again in the program's crate
;; (its types' texts, its function constants' and named constants' texts), instantiated by the mono item's arguments,
;; const_eval_select's calls remapped to the runtime function (rustc_mir_transform's remap_mir_for_const_eval_select, as
;; optimized MIR has it), and the functions it reaches that the record has no body of built natively too; a body is taken only
;; when its built MIR equals rustc's (the export's :equal, judged by core-check against the pack rust-core-built) and every
;; function its closure needs is, else the record's body stays (the fallback)

(def ^:private native-core-cache (atom {}))

(defn- native-core-map
  "The exported native core bodies: {def-path entry}, from RF_CORE_NATIVE (bin/rust-front core-export's file); {} without it
  (the record's core bodies, as before)"
  []
  (if-let [f (System/getenv "RF_CORE_NATIVE")]
    (or (get @native-core-cache f)
        ;; queue 443: several files, `:`-separated (core's, then alloc's and std's from bin/rust-front lib-export)
        (let [m (into {} (for [^String f1 (str/split f #":") :when (.exists (File. f1))
                               x (read-forms (slurp f1)) :when (and (seq? x) (= 'core/body (first x))) :let [e (second x)] :when (:body e)]
                           [(:def e) e]))]
          (swap! native-core-cache assoc f m)
          m))
    {}))

(defn- native-extra-fns
  "queue 443: the native facts of the library functions the exported bodies name that std's interface lacks (alloc's
  crate-private `box_new_uninit`), {path fact}, which the run's interface takes so that their items' types print"
  []
  (reduce (fn [acc e] (merge (:fns e) acc)) {} (vals (native-core-map))))

(defn- builtin-normalize
  "The builtin projections an instance's types name once their parameters are known: <T as Pointee>::Metadata (the
  ptr_metadata_ty rule: () for a sized type, usize for a slice or str, DynMetadata<dyn ..> for a trait object), and
  <T as DiscriminantKind>::Discriminant left to codegen"
  [t]
  (cond
    (not (vector? t)) t
    (and (= :proj (first t)) (= "core::ptr::metadata::Pointee::Metadata" (second t)))
    (let [self (builtin-normalize (first (nth t 2)))]
      (case (first self)
        (:slice :str) [:uint "usize"]
        :dyn [:adt "core::ptr::metadata::DynMetadata" [self]]
        (:param :proj :infer) (into [:proj (second t)] [(into [self] (rest (nth t 2)))])
        [:tuple []]))
    (keyword? (first t)) (into [(first t)] (map #(cond (vector? %) (builtin-normalize %) (map? %) (into {} (for [[k v] %] [k (builtin-normalize v)])) :else %) (rest t)))
    :else (mapv builtin-normalize t)))

(def ^:dynamic *resolve-call*
  "queue n-rust-dyn: within a run, a native body's trait-method call [DEF ARGS] resolved to the impl's method by mono
  (mono/resolve-call), else nil; nil outside a run"
  nil)

(def ^:dynamic *normalize-ty*
  "queue n-rust-dyn (448-4 (a) 4): within a run, a type's projections normalized by mono (mono/normalize-ty: the solver over
  std's interface and the program); nil outside a run"
  nil)

(defn- has-proj? [t] (boolean (some #(and (vector? %) (= :proj (first %))) (tree-seq coll? seq t))))

(defn- instance-normalize
  "An instance's type: the builtin projections (builtin-normalize), then the rest normalized by the run's solver
  (*normalize-ty*) when one is left (an associated type of a library impl: `<Chars<'_> as Iterator>::Item`)"
  [t]
  (let [t (builtin-normalize t)]
    (if (and *normalize-ty* (has-proj? t))
      (builtin-normalize (try (*normalize-ty* t) (catch Throwable _ t)))
      t)))

(defn- reprint
  "Native core forms printed in the program's crate at ARGS: each type form from its :tc, a function constant's text from its
  type, a named constant's from its :nc"
  [x args]
  (cond
    (seq? x)
    (let [m (meta x)
          y (apply list (map #(reprint % args) x))]
      (cond
        (and (= 'ty (first y)) (:tc m)) (build/ty-form (instance-normalize (c/subst (:tc m) args)))
        (and (= 'unevaluated (first y)) (:nc m)) (with-meta y (update m :nc (fn [[d as]] [d (mapv #(c/subst % args) as)])))
        (= 'const (first y))
        (let [tyf (nth y 2 nil) t (:tc (meta tyf)) v (nth y 3 nil) nc (:nc (meta v))
              text (cond (and t (= :fndef (first t))) (build/fn-const-text t)
                         nc (str "const " (binding [c/*in-value* true c/*erased-regions* true] (c/print-def-path (first nc) (second nc))))
                         :else (second y))]
          (with-meta (apply list 'const text (drop 2 y)) m))
        :else (if m (with-meta y m) y)))
    (vector? x) (let [y (mapv #(reprint % args) x)] (if (meta x) (with-meta y (meta x)) y))
    (map? x) (into {} (for [[k v] x] [k (if (= k :local-tys) (mapv #(instance-normalize (c/subst % args)) v) (reprint v args))]))
    :else x))

(defn- remap-const-eval-select
  "remap_mir_for_const_eval_select (lib.rs), at run time: `const_eval_select(ARGS, F, G)` a call of G with the tuple's fields"
  [body]
  (update body :blocks
          (fn [bs]
            (mapv (fn [b]
                    (let [t (:term b)]
                      (if-not (and (seq? t) (= 'call (first t)))
                        b
                        (let [[_ f args & more] t
                              ft (:tc (meta (nth f 2 nil)))]
                          (if-not (and ft (= :fndef (first ft)) (= "core::intrinsics::const_eval_select" (second ft)))
                            b
                            (let [[arg-ty _ rt _] (nth ft 2)
                                  g (list 'const (build/fn-const-text rt) (build/ty-form rt) '(zst))
                                  g (with-meta g (meta f))
                                  tupled (first args)
                                  fields (when (= :tuple (first arg-ty)) (second arg-ty))
                                  new-args (if (and (seq? tupled) (#{'move 'copy} (first tupled)))
                                             (let [[op pl] tupled]
                                               (vec (for [[i ft] (map-indexed vector fields)]
                                                      (list op (apply list (concat pl [(list 'field i (build/ty-form ft))]))))))
                                             (if (empty? fields) [] (throw (ex-info "const_eval_select with a constant tuple" {}))))]
                              (assoc b :term (apply list 'call g new-args more))))))))
                  bs))))

(def ^:dynamic *type-layout*
  "queue 448: within a run, a type's layout (mono's type-layout-form: {:size :align :fields ..}), for the SizedTypeProperties
  constants a native instance names; nil outside a run"
  nil)

(defn- walk-meta
  "F over X's forms bottom-up, each list's and vector's metadata kept (the native forms' :tc and :nc)"
  [f x]
  (f (cond (seq? x) (with-meta (apply list (map #(walk-meta f %) x)) (meta x))
           (vector? x) (with-meta (mapv #(walk-meta f %) x) (meta x))
           (map? x) (into {} (for [[k v] x] [k (walk-meta f v)]))
           :else x)))

(defn- sized-const-eval
  "queue 448: core::mem::SizedTypeProperties' constants at a native instance (`<String as SizedTypeProperties>::MAX_SLICE_LEN`,
  the instance's type known) evaluated as CTFE evaluates them for the record (library/core/src/mem/mod.rs: SIZE size_of, ALIGN
  align_of, ALIGNMENT the alignment, IS_ZST SIZE == 0, MAX_SLICE_LEN isize::MAX / SIZE (usize::MAX for a ZST), LAYOUT
  Layout::new: its bytes an immutable allocation of Layout's own field order, `(indirect-bytes HEX ALIGN)` until the run names
  it), from mono's layout of the type; a constant whose type's layout mono refuses stays unevaluated; and two of core's private
  integer constants (below)"
  [body]
  (if-not *type-layout*
    body
    (walk-meta
     (fn [x]
       (let [v (when (and (seq? x) (= 'const (first x))) (nth x 3 nil))]
         (if-not (and (seq? v) (= 'unevaluated (first v)) (nil? (nth v 3 nil)))
           x
           (let [[d args] (:nc (meta v))
                 nm (when (string? d) (second (re-matches #"core::mem::SizedTypeProperties::(SIZE|ALIGN|ALIGNMENT|IS_ZST|MAX_SLICE_LEN|LAYOUT)" d)))
                 l (when (and nm (= 1 (count args)) (vector? (first args)) (not (#{:param :proj :infer} (ffirst args))))
                     (try (*type-layout* (first args))
                          (catch Throwable e (when (System/getenv "RF_CONST_TRACE") (binding [*out* *err*] (println "sized-const-eval:" d (pr-str args) (.getMessage e)))) nil)))
                 _ (when (and nm (nil? l) (System/getenv "RF_CONST_TRACE")) (binding [*out* *err*] (println "sized-const-eval: no layout" d (pr-str args))))
                 sz (:size l) al (:align l)
                 hex (fn [n w] (apply str (for [i (range w)] (format "%02x" (.intValue (.and (.shiftRight (biginteger (bigint n)) (int (* 8 i))) (biginteger 255)))))))
                 val (when (and (integer? sz) (integer? al))
                       (case nm
                         "SIZE" (list 'scalar sz 8)
                         "ALIGN" (list 'scalar al 8)
                         ;; Alignment::new(Self::ALIGN).unwrap(): the enum's discriminant is the alignment (a usize scalar)
                         "ALIGNMENT" (list 'scalar al 8)
                         "IS_ZST" (list 'scalar (if (zero? sz) 1 0) 1)
                         "MAX_SLICE_LEN" (list 'scalar (if (zero? sz) 18446744073709551615N (quot 9223372036854775807N (bigint sz))) 8)
                         ;; Layout { size, align }: its fields at the offsets mono's layout of Layout gives (rustc puts the
                         ;; niche-holding Alignment first: align's bytes, then size's)
                         "LAYOUT" (let [ll (try (*type-layout* [:adt "core::alloc::layout::Layout" []]) (catch Throwable _ nil))
                                        [os oa] (when (vector? (:fields ll)) (:fields ll))]
                                    (when (and (= 16 (:size ll)) (#{[0 8] [8 0]} [os oa]))
                                      (list 'indirect-bytes (if (zero? os) (str (hex sz 8) (hex al 8)) (str (hex al 8) (hex sz 8))) 8)))
                         nil))
                 ;; core's private constants the exported bodies name by their local def id (the export's `(unevaluated "85")`,
                 ;; :nc its path), whose values follow from their definitions alone: library/core/src/cell.rs `const UNUSED:
                 ;; BorrowCounter = 0` (isize), ptr/mod.rs swap_nonoverlapping_bytes' `const CHUNK_SIZE: usize =
                 ;; size_of::<*const ()>()` (8 on the 64-bit target)
                 val (or val (when (empty? args) (get {"core::cell::UNUSED" '(scalar 0 8)
                                                       "core::ptr::swap_nonoverlapping_bytes::CHUNK_SIZE" '(scalar 8 8)}
                                                      d)))]
             (if val (with-meta (apply list (concat (take 3 x) [val])) (meta x)) x)))))
     body)))

(defn- core-instance
  "A native core body at the instance's ARGS, printed in the program's crate: {:def :args :body :promoted} or nil"
  [entry args]
  (let [b (sized-const-eval (reprint (:body entry) args))]
    ;; LowerIntrinsics again at the instance (its own port may have grown since the export)
    {:def (:def entry) :args args :body ((requiring-resolve 'arbace.rust.front.passes/lower-intrinsics)
                                         (remap-const-eval-select (assoc b :promoted-bodies (into {} (for [[i pb] (:promoted entry)] [i (reprint pb args)])))))}))

(defn- drop-shim-body
  "RF12-P6: drop_glue::<T>'s shim body (shim.rs' build_drop_shim, the drop elaborated: `_2 = copy _1; <T as Drop>::drop(move
  _2)`; rustc's optimized shim takes the reference, as the record's), for a type whose glue is its own Drop::drop alone"
  [t drop-fn]
  (let [rt [:ref [:re-erased] true t]
        unit (build/ty-form [:tuple []])
        f [:fndef drop-fn []]
        callee (with-meta (list 'const (str "<" (binding [c/*in-value* false] (c/print-ty t)) " as core::ops::Drop>::drop") (build/ty-form f) '(zst)) {})]
    {:args 1 :ret unit
     :locals [{:mut true :scope 0 :ty unit} {:mut false :scope 0 :ty (build/ty-form rt)} {:mut true :scope 0 :ty (build/ty-form rt)} {:mut true :scope 0 :ty unit}]
     :scopes [[nil nil nil nil false]] :debug []
     :blocks [{:cleanup false :stmts [(list 'assign '(place 2) '(use (copy (place 1))))]
               :term (list 'call callee '[(move (place 2))] '(place 3) 1 '(continue))}
              {:cleanup false :stmts [] :term '(return)}]}))

(defn- call-of [t] (when (and (seq? t) (= 'call (first t))) (:tc (meta (nth (second t) 2 nil)))))

;; RUST-90 S4 (C2): a native instance's body judged against the record's (rustc's optimized MIR of the instance at -O0, the body
;; the pack gives the run), so that a root taken natively is proven on the program's own instance, not only on core-check's
;; generic body against rustc's built MIR

(defn- strip-storage [stmts]
  (vec (remove #(and (seq? %) (#{'storage-live 'storage-dead 'nop} (first %))) stmts)))

(defn- rec-extras
  "The record's facts beside a form (a function constant's :fn-symbol, a call's, drop's or assert's callee, glue, location and
  trailing fields after its unwind action) dropped: what our instance's forms do not carry before the run"
  [x]
  (cond
    (seq? x) (let [y (loop [in (seq x) out []]
                       (cond (nil? in) out
                             (= :fn-symbol (first in)) (recur (nnext in) out)
                             ;; queue n-rust-dyn: an unsizing cast's vtable allocation (the record's, the run's)
                             (= :vtable (first in)) (recur (nnext in) out)
                             :else (recur (next in) (conj out (rec-extras (first in))))))
                   y (if (and (#{'call 'drop 'assert} (first y)) (> (count y) 6)) (subvec y 0 6) y)]
               (apply list y))
    (vector? x) (mapv rec-extras x)
    (map? x) (into {} (for [[k v] x] [k (rec-extras v)]))
    :else x))

(defn- place-locals
  "The locals a form names: each (place N ..) and each index projection's (index N)"
  [x]
  (let [acc (transient #{})]
    (doseq [f (tree-seq coll? seq x) :when (seq? f)]
      (case (first f)
        place (conj! acc (second f))
        index (when (number? (second f)) (conj! acc (second f)))
        nil))
    (persistent! acc)))

(defn- map-locals
  "FORM with each local renamed by F (places and index projections)"
  [x f]
  (cond
    (seq? x) (let [y (apply list (map #(map-locals % f) x))]
               (cond (and (= 'place (first y)) (number? (second y))) (apply list 'place (f (second y)) (drop 2 y))
                     (and (= 'index (first y)) (number? (second y)) (= 2 (count y))) (list 'index (f (second y)))
                     :else y))
    (vector? x) (mapv #(map-locals % f) x)
    :else x))

(defn- plain-place [p] (when (and (seq? p) (= 'place (first p)) (= 2 (count p))) (second p)))

(defn- o0-copy-prop
  "CopyProp's case at -O0 (copy_prop.rs): a temporary defined once by `_t = move|copy _s` (S a local, neither borrowed, S
  never assigned after its definition) is S: its uses renamed (a move of it a copy of S, as rustc's optimized MIR writes it)
  and its definition dropped; [body changed?]"
  [body]
  (let [blocks (:blocks body)
        stmts (for [b blocks s (:stmts b)] s)
        defs (frequencies (concat (keep #(when (and (seq? %) (= 'assign (first %))) (plain-place (second %))) stmts)
                                  (keep #(let [t (:term %)] (when (and (seq? t) (= 'call (first t))) (plain-place (nth t 3 nil)))) blocks)))
        borrowed (set (for [f (tree-seq coll? seq blocks) :when (and (seq? f) (#{'ref 'rawptr} (first f)))
                            :let [p (last f)] :when (and (seq? p) (= 'place (first p)))]
                        (second p)))
        nargs (long (or (:args body) 0))
        cand (first (for [s stmts
                          :when (and (seq? s) (= 'assign (first s)))
                          :let [t (plain-place (second s)) rv (nth s 2 nil)]
                          :when (and t (> (long t) nargs) (= 1 (get defs t)) (not (borrowed t))
                                     (seq? rv) (= 'use (first rv)) (seq? (second rv)) (#{'move 'copy} (first (second rv))))
                          :let [src (plain-place (second (second rv)))]
                          :when (and src (not= src t) (not (borrowed src)) (not= 0 src)
                                     (if (<= (long src) nargs) (zero? (get defs src 0)) (= 1 (get defs src))))]
                      [s t src]))]
    (if-not cand
      [body false]
      (let [[s t src] cand
            ren (fn ren [x] (cond (and (seq? x) (= 'move (first x)) (seq? (second x)) (= t (second (second x))))
                                  (list 'copy (map-locals (second x) #(if (= % t) src %)))
                                  (seq? x) (apply list (map ren x))
                                  (vector? x) (mapv ren x)
                                  :else x))
            fix (fn [f] (map-locals (ren f) #(if (= % t) src %)))]
        [(assoc body :blocks (mapv (fn [b] (-> b (update :stmts (fn [ss] (mapv fix (remove #(identical? % s) ss)))) (update :term fix))) blocks)
                     :debug (fix (:debug body)))
         true]))))

(defn- o0-simplify-locals
  "SimplifyLocals (simplify.rs) at -O0: the locals no statement or terminator reads or writes dropped (an assignment's only
  use of a local the statement too: remove_unused_definitions), the rest renumbered in order; [body changed?]"
  [body]
  (let [nargs (long (or (:args body) 0))]
    (loop [b body changed false]
      (let [blocks (:blocks b)
            ;; a local's uses but the plain assignments to it
            ;; (the debug info's places are uses: rustc keeps a local its var_debug_info names)
            used (place-locals [(:debug b)
                                (for [blk blocks]
                                  [(for [st (:stmts blk)] (if (and (seq? st) (= 'assign (first st)) (plain-place (second st))) (drop 2 st) st)) (:term blk)])])
            n (count (:locals b))
            dead (set (for [i (range (inc nargs) n) :when (not (used i))] i))]
        (if (empty? dead)
          [b changed]
          (let [keep (vec (remove dead (range n)))
                remap (into {} (map-indexed (fn [j i] [i j]) keep))
                blocks (mapv (fn [blk] (-> blk
                                           (update :stmts (fn [ss] (mapv #(map-locals % remap)
                                                                         (remove #(and (seq? %) (= 'assign (first %)) (dead (plain-place (second %)))) ss))))
                                           (update :term #(map-locals % remap))))
                             blocks)]
            (recur (assoc b :blocks blocks :locals (mapv #(nth (:locals b) %) keep) :debug (map-locals (:debug b) remap)) true)))))))

(defn- o0-inst-simplify
  "InstSimplify's simplify_ref_deref (instsimplify.rs, -O0's BeforeInline): `_d = &(*_b)` (or &mut, or a raw pointer of it)
  whose type is _b's is `_d = copy _b`; [body changed?]"
  [body]
  (let [lt (mapv :ty (:locals body)) changed (atom false)
        f (fn [st]
            (if-let [[d rv] (and (seq? st) (= 'assign (first st)) (plain-place (second st)) [(plain-place (second st)) (nth st 2 nil)])]
              (let [pl (when (and (seq? rv) (#{'ref 'rawptr} (first rv))) (last rv))]
                (if (and (seq? pl) (= 'place (first pl)) (= 3 (count pl)) (= '(deref) (nth pl 2)) (= (get lt d) (get lt (second pl))))
                  (do (reset! changed true) (list 'assign (second st) (list 'use (list 'copy (list 'place (second pl))))))
                  st))
              st))
        b (update body :blocks (fn [bs] (mapv (fn [x] (update x :stmts #(mapv f %))) bs)))]
    [b @changed]))

(defn- o0-remove-zsts
  "RemoveZsts (remove_zsts.rs, -O0): an assignment of a zero-sized constant (`_0 = const ()`) dropped; [body changed?]"
  [body]
  (let [zst-assign? #(and (seq? %) (= 'assign (first %)) (plain-place (second %))
                          (let [rv (nth % 2 nil)] (and (seq? rv) (= 'use (first rv)) (seq? (second rv)) (= 'const (first (second rv)))
                                                       (= '(zst) (last (second rv))))))
        b (update body :blocks (fn [bs] (mapv (fn [x] (update x :stmts #(vec (remove zst-assign? %)))) bs)))]
    [b (not= (:blocks b) (:blocks body))]))

(defn- o0-rename-return
  "RenameReturnPlace (nrvo.rs, -O0): the return place's one assignment `_0 = copy|move _l` (_l a local neither an argument nor
  borrowed, of _0's type) gone, _l renamed _0; [body changed?]"
  [body]
  (let [blocks (:blocks body) nargs (long (or (:args body) 0)) lt (mapv :ty (:locals body))
        defs0 (for [b blocks s (:stmts b) :when (and (seq? s) (= 'assign (first s)) (= 0 (plain-place (second s))))] s)
        calls0 (for [b blocks :let [t (:term b)] :when (and (seq? t) (= 'call (first t)) (= 0 (plain-place (nth t 3 nil))))] t)
        borrowed (set (for [f (tree-seq coll? seq blocks) :when (and (seq? f) (#{'ref 'rawptr} (first f)))
                            :let [p (last f)] :when (and (seq? p) (= 'place (first p)))]
                        (second p)))
        s (first defs0)
        rv (when s (nth s 2 nil))
        l (when (and (seq? rv) (= 'use (first rv)) (seq? (second rv)) (#{'copy 'move} (first (second rv)))) (plain-place (second (second rv))))]
    (if (and (= 1 (count defs0)) (empty? calls0) l (> (long l) nargs) (not (borrowed l)) (= (get lt l) (get lt 0)))
      [(assoc body :blocks (mapv (fn [b] (-> b (update :stmts (fn [ss] (mapv #(map-locals % (fn [x] (if (= x l) 0 x))) (remove #(identical? % s) ss))))
                                             (update :term #(map-locals % (fn [x] (if (= x l) 0 x))))))
                                 blocks)
              :debug (map-locals (:debug body) (fn [x] (if (= x l) 0 x))))
       true]
      [body false])))

(defn o0-normalize
  "BODY as rustc's -O0 optimizations would leave it for the passes our runtime MIR stops before (RemoveStorageMarkers,
  SimplifyCfg-final, InstSimplify's reborrow, CopyProp's copies of locals, RemoveZsts' unit assignments, RenameReturnPlace,
  SimplifyLocals), the kinds that changed it: [body #{kind}]"
  [body]
  (let [kinds (atom #{})
        b (update body :blocks (fn [bs] (mapv #(update % :stmts strip-storage) bs)))
        _ (when (not= (:blocks b) (:blocks body)) (swap! kinds conj :storage))
        b2 ((requiring-resolve 'arbace.rust.front.passes/simplify-cfg) b {:preserve-switch-reads false})
        _ (when (not= (count (:blocks b2)) (count (:blocks b))) (swap! kinds conj :cfg))
        [b2 c2] (o0-inst-simplify b2)
        _ (when c2 (swap! kinds conj :inst-simplify))
        b3 (loop [x b2] (let [[y c] (o0-copy-prop x)] (if c (do (swap! kinds conj :copy-prop) (recur y)) x)))
        [b3 cz] (o0-remove-zsts b3)
        _ (when cz (swap! kinds conj :zsts))
        [b3 cr] (o0-rename-return b3)
        _ (when cr (swap! kinds conj :nrvo))
        [b4 c4] (o0-simplify-locals b3)
        _ (when c4 (swap! kinds conj :locals))]
    [b4 @kinds]))

(defn- first-diff
  "The first differing subforms of A and B (descending while both are lists or vectors of one length)"
  [a b]
  (if (and (sequential? a) (sequential? b) (= (count a) (count b)) (= (seq? a) (seq? b)))
    (if-let [[x y] (first (remove (fn [[x y]] (= x y)) (map vector a b)))] (first-diff x y) [a b])
    [a b]))

(defn pack-compare
  "OURS (an instance's runtime MIR) against REC (the record's optimized body at -O0): [:equal], [:equal-but-storage] (equal once
  StorageLive, StorageDead and Nop are dropped: -O0's RemoveStorageMarkers), [:equal-o0 KINDS] (queue 443: equal once both are
  through o0-normalize: the -O0 passes our runtime MIR stops before, named), else [:differs WHERE] (after the normalization).
  The record's facts beside the forms (symbols, callees, locations) are not compared (rec-extras)"
  [ours rec]
  (let [;; an ADT's id is the record's DefId, ours its path in core: the text and the arguments compared
        norm (fn norm [x] (cond (and (seq? x) (= 'adt (first x))) (apply list 'adt (second x) (map norm (drop 3 x)))
                                ;; a function item's def text: ours instantiated (`black_box::<u8>`), the record's the def path
                                ;; (`black_box`); the function constant's text and the arguments are compared
                                (and (seq? x) (= 'fndef (first x)) (string? (second x))) (apply list 'fndef (map norm (drop 2 x)))
                                ;; a promoted constant's value: ours its unevaluated body (evaluated at the run, eval-promoted), the
                                ;; record's the evaluated pointer; the promoted is named by the constant's text, its type compared
                                (and (seq? x) (= 'const (first x)) (string? (second x)) (re-find #"::promoted\[\d+\]$" (second x)))
                                (list 'const (str/replace (second x) #"^const (std|core|alloc)::" "const ") (norm (nth x 2 nil)) 'promoted)
                                (seq? x) (apply list (map norm x))
                                (vector? x) (mapv norm x)
                                (map? x) (into {} (for [[k v] x] [k (norm v)]))
                                :else x))
        prep (fn [b] {:args (:args b) :debug (vec (for [d (:debug b)] (list 'debug (norm (:value d))))) :locals (mapv (fn [l] {:ty (norm (:ty l))}) (:locals b))
                      :blocks (mapv (fn [x] {:stmts (vec (rec-extras (norm (vec (:stmts x))))) :term (rec-extras (norm (:term x))) :cleanup (boolean (:cleanup x))})
                                    (:blocks b))})
        ;; queue 448: the record's evaluated constant allocations (`(indirect allocN 0)`, an immutable memory allocation
        ;; without pointers) by their bytes, as ours names them (sized-const-eval's `(indirect-bytes HEX ALIGN)`)
        rallocs (into {} (:alloc-data rec))
        by-bytes (fn by-bytes [x] (cond (and (seq? x) (= 'indirect (first x)) (= 0 (nth x 2 nil)))
                                        (let [a (get rallocs (str (second x)))]
                                          (if (and (= :memory (:kind a)) (empty? (:relocs a)) (string? (:bytes a)))
                                            (list 'indirect-bytes (:bytes a) (:align a))
                                            x))
                                        (seq? x) (apply list (map by-bytes x))
                                        (vector? x) (mapv by-bytes x)
                                        (map? x) (into {} (for [[k v] x] [k (by-bytes v)]))
                                        :else x))
        rec (if (seq rallocs) (update rec :blocks by-bytes) rec)
        po (prep ours) pr (prep rec)
        bl (fn [b f] (mapv (fn [x] (update x :stmts f)) (:blocks b)))
        lt (fn [b] (mapv :ty (:locals b)))
        cut (fn [x] (let [t (pr-str x)] (subs t 0 (min 160 (count t)))))]
    (cond
      (and (= (bl po identity) (bl pr identity)) (= (lt po) (lt pr))) [:equal]
      (and (= (bl po strip-storage) (bl pr strip-storage)) (= (lt po) (lt pr))) [:equal-but-storage]
      :else
      (let [[no ko] (o0-normalize po) [nr _] (o0-normalize pr)
            _ (when-let [d (System/getenv "RF_PACK_DUMP")]
                (.mkdirs (File. ^String d))
                (spit (str d "/" (Math/abs (hash [no nr])) ".edn") (with-out-str (prn :ours) (prn no) (prn :record) (prn nr))))]
        (cond
          (and (= (:blocks no) (:blocks nr)) (= (lt no) (lt nr))) [:equal-o0 (str/join "," (map name (sort ko)))]
          (not= (count (:blocks no)) (count (:blocks nr))) [:differs (str "blocks " (count (:blocks no)) " against " (count (:blocks nr)))]
          (not= (count (:locals no)) (count (:locals nr))) [:differs (str "locals " (count (:locals no)) " against " (count (:locals nr)))]
          (not= (lt no) (lt nr)) (let [i (first (keep-indexed (fn [i [a b]] (when (not= a b) i)) (map vector (lt no) (lt nr))))]
                                   [:differs (str "local " i ": " (cut (nth (lt no) i)) " against " (cut (nth (lt nr) i)))])
          :else (let [[a b] (first (remove (fn [[a b]] (= a b)) (map vector (:blocks no) (:blocks nr))))
                      sa (:stmts a) sb (:stmts b)
                      i (first (keep-indexed (fn [i [x y]] (when (not= x y) i)) (map vector (concat sa [(:term a)]) (concat sb [(:term b)]))))]
                  [:differs (cond i (let [[x y] (first-diff (nth (vec (concat sa [(:term a)])) i) (nth (vec (concat sb [(:term b)])) i))]
                                      (str "statement " i ": " (cut x) " against " (cut y)))
                                  (not= (:cleanup a) (:cleanup b)) "a block's cleanup flag"
                                  :else (str "statements " (count sa) " against " (count sb)))]))))))

(def ^:private pack-equal? #{:equal :equal-but-storage :equal-o0})

(defn native-core-plan
  "Within the run's bindings: for the record's core bodies ROOTS ([[record-body def args]]), each taken natively with the
  closure of the functions it reaches that the record has no body of: {:taken {record-symbol instance} :extra [instance]
  :lines [..]} (S4: keyed by the instance's symbol, not its name, so that two instances of one def are both taken; each taken
  root judged against the record's body, `pack-compare` lines, and a crossed control: the first root against another def's)"
  [roots rec-defs & [rec-by-path]]
  (let [nc (native-core-map) lines (atom []) pairs (atom [])
        rec-by-path (or rec-by-path {})
        close (fn close [def args seen]
                ;; [instances] of DEF at ARGS and what it reaches natively, or throws why it cannot be taken
                (let [e (get nc def)]
                  (cond
                    (nil? e) (throw (ex-info (str "no native body of " def) {}))
                    ;; queue 443: alloc's and std's bodies (:judge :instance, no built-MIR oracle) are judged against the record's
                    ;; instance (a root against its own; a callee below against the record's bodies of its def, the one whose
                    ;; locals agree); one the record has no body of has nothing to be judged by
                    (and (= :instance (:judge e)) (seq seen) (empty? (get rec-by-path def)))
                    (throw (ex-info (str def ": no record's instance to judge its body by") {}))
                    (and (not (:equal e)) (not= :instance (:judge e))) (throw (ex-info (str def "'s built MIR differs from rustc's") {}))
                    (contains? seen [def args]) []
                    :else
                    (let [inst (core-instance e args)
                          ;; S4: a type the instance's forms cannot write (ty-form's `(other ..)`: a closure type; a trait object
                          ;; is `(dyn)` since queue n-rust-dyn, its casts' vtables the record's, and a projection is normalized at
                          ;; the instance by the run's solver, one left unnormalized `(other ":proj")`) stops it, the record's body
                          ;; the fallback
                          _ (when-let [o (first (filter #(and (seq? %) (= 'other (first %))) (tree-seq coll? seq (:body inst))))]
                              (throw (ex-info (str "a type its forms do not write " (pr-str o)) {})))
                          ;; queue 443, 443-4 (b): a constant left unevaluated by a local definition's id (`(unevaluated "85" ..)`:
                          ;; core::cell::is_reading's BorrowFlag constant, which the export did not name by its path) is no
                          ;; constant codegen can write: the body is refused at plan time, the record's kept
                          _ (when-let [u (first (filter #(and (seq? %) (= 'unevaluated (first %)) (string? (second %)) (re-matches #"\d+" (second %)))
                                                        (tree-seq coll? seq (concat [(:body inst)] (vals (:promoted-bodies (:body inst)))))))]
                              (throw (ex-info (str "an unevaluated constant of a local def id " (pr-str (take 2 u))) {})))
                          ;; queue 448: a body calling drop glue (core::ptr::drop_in_place's `drop_glue::<T>()`, a shim rustc
                          ;; builds per type and leaves out when the type needs none) stays the record's: its callee is no item
                          ;; the module defines
                          _ (when (some (fn [blk] (= "core::ptr::drop_glue" (second (call-of (:term blk))))) (:blocks (:body inst)))
                              (throw (ex-info "a call of drop glue (a shim, the record's)" {})))
                          ;; queue 443: an instance-judged callee taken only when equal to one of the record's bodies of its def
                          _ (when (and (= :instance (:judge e)) (seq seen))
                              (let [rs (get rec-by-path def)
                                    ks (for [r rs] (try (pack-compare (:body inst) r) (catch Throwable x [:differs (str "the compare: " (.getMessage x))])))
                                    hit (first (filter (comp pack-equal? first) ks))
                                    crate (first (str/split (str def) #"::"))]
                                (swap! lines conj (str "pack-compare-" crate "-callee " (name (first (or hit (first ks)))) " " def
                                                       (when-let [w (second (or hit (first ks)))] (str " (" w ")"))))
                                (when-not hit (throw (ex-info (str def " differs from the record's instance: " (second (first ks))) {})))))
                          rec-has? (fn [cd] (or (contains? rec-defs (mono/print-path cd)) (contains? rec-by-path cd)))
                          seen (conj seen [def args])
                          more (for [blk (:blocks (:body inst)) :let [ft (call-of (:term blk))] :when ft
                                     :let [[_ cd0 cargs0] ft
                                           ;; queue n-rust-dyn: a trait method's call (its arguments concrete at the instance) by
                                           ;; the impl's method it resolves to, as the collector reaches it
                                           [cd cargs] (or (when (and *resolve-call* (string? cd0) (not (get nc cd0))) (*resolve-call* cd0 cargs0))
                                                          [cd0 cargs0])]
                                     ;; an intrinsic is codegen's; a function core's export has is built; one that is MIR-available
                                     ;; without a native body stops the root; any other is an external symbol (core's own object)
                                     :when (and (string? cd) (not (mono/intrinsic? cd))
                                                (or (get nc cd) (mono/mir-available? cd)))]
                                 [cd (vec cargs)])]
                      ;; a callee without an equal native body that the record has a body of: the record's (the pack's fallback)
                      (into [inst] (mapcat (fn [[cd cargs]]
                                             (if (and (rec-has? cd) (not (:equal (get nc cd))) (not= :instance (:judge (get nc cd)))) [] (try (close cd cargs seen)
                                                                                                         (catch Throwable e
                                                                                                           (if (rec-has? cd)
                                                                                                             (do (swap! lines conj (str "record-kept " cd " (" (.getMessage e) ")")) [])
                                                                                                             (throw e))))))
                                           (distinct more)))))))]
    (assoc
    (reduce (fn [acc [rec def args]]
              (let [crate (first (str/split (str def) #"::"))
                    inst? (= :instance (:judge (get nc def)))]
              (try (let [[root & extra] (close def (vec args) #{})
                         [k w] (try (pack-compare (:body root) rec) (catch Throwable e [:differs (str "the compare: " (.getMessage e))]))]
                     (swap! lines conj (str (if inst? (str "pack-compare-" crate) "pack-compare") " " (name k) " " (:name rec) (when w (str " (" w ")"))))
                     (swap! pairs conj [root rec inst?])
                     ;; queue 443: an instance-judged body is taken only when it equals the record's instance (up to -O0's passes)
                     (when (and inst? (not (pack-equal? k)))
                       (throw (ex-info (str "differs from the record's instance: " w) {})))
                     (swap! lines conj (str "native " (:name rec) (if inst?
                                                                    (str " (" crate "'s body built by Arbace, equal to the record's instance")
                                                                    " (core's body built by Arbace, equal to rustc's built MIR")
                                            (when (seq extra) (str "; with " (count extra) " more: " (str/join ", " (map :def extra)))) ")"))
                     (-> acc (assoc-in [:taken (:symbol rec)] root) (update :extra into extra)))
                   (catch Throwable e
                     (swap! lines conj (str "record " (:name rec) " (" (if (#{"alloc" "std" "hashbrown"} crate) crate "core") "'s body: " (.getMessage e) ")"))
                     acc))))
            {:taken {} :extra [] :lines []} roots)
    :lines (let [control (fn [tag ps]
                           (let [[[r0 c0] & more] ps
                                 [_ c1] (first (filter (fn [[r c]] (and (not= (:def r) (:def r0)) (not= (:blocks c) (:blocks c0)))) more))]
                             (when c1
                               (str "pack-compare " tag " (" (:name c0) " against " (:name c1) "'s record): "
                                    (if (pack-equal? (first (pack-compare (:body r0) c1))) "PASSED (a bug)" "differs, as it must")))))
                 ;; queue 443: the instance-judged roots' own control (alloc's and std's), the first of them against another def's record
                 c-all (control "control" @pairs)
                 c-inst (control "control-instance" (filter #(nth % 2) @pairs))]
             (cond-> @lines c-all (conj c-all) c-inst (conj c-inst))))))

;; RFP23 (c): the run's facts from arbace.rust.front.mono (no record but core's bodies and, per fact, what mono refuses)

(defn native-run
  "The run's module from Arbace's own facts: the mono items, symbols, callees and caller locations, the function constants',
  statics' and lang items' symbols, the layouts; a fact mono refuses taken from the record (counted); core's bodies the
  record's (RF12); our bodies' own type forms (no record's DefIds). {:forms :lines :tally :judged}: with JUDGE, a seq of
  [NAME RECORD-FORMS], RFP40 (c)'s mono-check of the same pipeline run, each [tally differences] of
  arbace.rust.front.mono-check/judge (the program's facts against each record) in :judged. RECORD the record's file, or
  its forms already read (RF19)"
  [crates front-dir record n abort? judge]
  (let [_ (mem-mark (str n " native-run"))
        ;; RF19: the record's forms as the batch read them for the judge (one copy: a second read of collections' 35 MB
        ;; record was 477 MiB of a 2.2 GiB peak), else read from the file
        forms (if (string? record) (read-forms (slurp record)) record)
        _ (mem-mark (str n " record read"))
        rec-bodies (for [f forms :when (= 'mir/body (first f))] (second f))
        rfacts (record-facts rec-bodies)
        rec-callees (atom {})
        _ (doseq [b rec-bodies] (walk (fn [x] (when (and (seq? x) (= 'call (first x)) (> (count x) 7)) (swap! rec-callees update (second (second x)) (fnil conj []) [(nth x 6) (nth x 7)])) x) (dissoc b :alloc-data)))
        rec-statics (into {} (for [f forms :when (= 'mir/static (first f)) :let [m (second f)]]
                               [(str/replace (last (str/split (str (:def m)) #"::")) #"\)$" "") m]))
        rec-layouts (into {} (second (some #(when (= 'mir/layouts (first %)) %) forms)))
        rec-langs (or (second (some #(when (= 'mir/langsyms (first %)) %) forms)) {})
        tally (atom {})
        refusals (atom {})
        fact! (fn [k native?] (swap! tally update k (fnil (fn [[a b]] [(if native? (inc a) a) (inc b)]) [0 0])))
        lines (atom [])
        judged (atom [])
        result
        (binding [mono/*crates* (mono/load-crates crates) mono/*lib-dir* (System/getenv "RF_MONO_LIB")
                  ;; RF18 (RFP63 (a)'s reader): std's exported generic instances (the helper's --std-exports, recorded at night)
                  mono/*upstream* (mono/load-upstream (System/getenv "RF_STD_EXPORTS"))
                  ;; RF19: core's macro-made functions' attributes (bin/rust-front core-attrs; rsi-build's RF_CORE_ATTRS)
                  mono/*macro-attrs* (mono/load-macro-attrs (System/getenv "RF_CORE_ATTRS"))
                  mono/*native-attrs* (if (System/getenv "RF_CORE_PACK") {} (into {} (for [[d e] (native-core-map) :when (:attrs e)] [d (:attrs e)])))]
          (bc/build-program front-dir n
            (fn [bodies]
              (mem-mark (str n " bodies built"))
              ;; queue 443: the exported library bodies' crate-private functions in the run's interface (a path it has kept)
              (when-let [x (not-empty (native-extra-fns))]
                (try (set! c/*si* (update c/*si* :fns #(merge x %)))
                     (catch IllegalStateException _ (swap! lines conj "native: the interface is not bound: no crate-private function added"))))
              (let [;; RFP49 (a): the function constants of the record's std instances' bodies, whose local instances mono's
                    ;; collector adds (rustc's std bodies are the pack's, RF12's part; what they reach of ours is mono's)
                    std-calls (let [acc (java.util.LinkedHashSet.)]
                                (doseq [b rec-bodies :when (not (str/starts-with? (str (:def-id b)) "DefId(0:"))]
                                  (walk (fn [x] (when (and (seq? x) (= 'fndef (first x)) (string? (second x)) (vector? (nth x 2 nil)))
                                                  (.add acc [(second x) (nth x 2)]))
                                          x)
                                        (dissoc b :alloc-data)))
                                (vec acc))
                    ;; RF15: the function allocations of those bodies (their vtables' entries), by symbol
                    std-fn-syms (set (for [b rec-bodies :when (not (str/starts-with? (str (:def-id b)) "DefId(0:"))
                                           [_ a] (:alloc-data b) :when (= :fn (:kind a))]
                                       (:symbol a)))
                    ;; queue 448, 433-1 (a): each call of the record's library bodies whose callee is a library body of the
                    ;; record's (an Item instance): its function constant's [PATH ARG-FORMS], that body's def (its DefId's path
                    ;; less the crate's hash: `core::fmt::{impl#4}::new`) and symbol, for mono to collect (RFP49's roots through
                    ;; the record's bodies)
                    rec-targets (when (and (seq (native-core-map)) (not (System/getenv "RF_CORE_PACK")))
                                  (let [lib? (fn [b] (not (str/starts-with? (str (:def-id b)) "DefId(0:")))
                                      by-sym (into {} (for [b rec-bodies :when (and (lib? b) (str/starts-with? (str (:instance b)) "Item("))
                                                            :let [[_ c p] (re-find #"~ ([a-z_]+)\[[0-9a-f]+\]::(.*)\)$" (str (:def-id b)))] :when c]
                                                        [(:symbol b) (str c "::" p)]))
                                      acc (java.util.LinkedHashSet.)]
                                  (doseq [b rec-bodies :when (lib? b) blk (:blocks b) :let [t (:term blk)]
                                          :when (and (seq? t) (= 'call (first t)) (> (count t) 6))]
                                    (let [f (second t) tyf (when (seq? f) (nth f 2 nil)) st (when (seq? tyf) (nth tyf 2 nil))
                                          ci (nth t 6) sym (when (and (seq? ci) (map? (second ci))) (:symbol (second ci)))
                                          d (get by-sym sym)]
                                      (when (and d (seq? st) (= 'fndef (first st)) (string? (second st)) (vector? (nth st 2 nil)))
                                        (.add acc [(second st) (nth st 2) d sym]))))
                                  (vec acc)))
                    facts (mono/program-facts n bodies std-calls std-fn-syms rec-targets)
                    _ (mem-mark (str n " facts"))
                    _ (when (seq rec-targets)
                        (swap! lines conj (str "rec-items: " (count (:rec-items facts)) " instances collected through the record's library bodies, of "
                                               (count (distinct (map #(take 2 %) rec-targets))) " calls' constants")))
                    ;; RF12-P6: the record's core bodies the program reaches, built natively where they and their closure can be
                    core-plan (when (and (seq (native-core-map)) (not (System/getenv "RF_CORE_PACK")))
                               (binding [*type-layout* (fn [t] (mono/type-layout-form n (with-meta (list 'ty "?") {:tc t})))
                                         *normalize-ty* (fn [t] (mono/normalize-ty n t))
                                         *resolve-call* (fn [d args] (mono/resolve-call n d args))]
                                ;; queue 448, 433-1 (a): the collector's items, then the instances mono collected through the record's
                                ;; library bodies (:rec-items), each record body a root once
                                (native-core-plan (let [rec-by-sym (into {} (for [r rec-bodies] [(:symbol r) r])) seen (java.util.HashSet.)]
                                                    (vec (for [x (concat (:ext-items facts) (:rec-items facts)) :let [rec (get rec-by-sym (:symbol x))]
                                                               :when (and rec (.add seen (:symbol x)))]
                                                           [rec (:def x) (:args x)])))
                                                  ;; a function the record has a body of stays the record's when no native one is equal
                                                  (set (for [b rec-bodies :when (not (str/starts-with? (str (:def-id b)) "DefId(0:"))] (:def b)))
                                                  ;; queue 443: the record's library bodies by their def's path (`alloc::raw_vec::{impl#0}::new`)
                                                  (update-vals (group-by :path (for [b rec-bodies :when (and (str/starts-with? (str (:instance b)) "Item(") (not (str/starts-with? (str (:def-id b)) "DefId(0:")))
                                                                        :let [[_ c p] (re-find #"~ ([a-z_]+)\[[0-9a-f]+\]::(.*)\)$" (str (:def-id b)))]
                                                                        :when (#{"core" "alloc" "std" "hashbrown"} c)]
                                                                    {:path (str c "::" p) :body b}))
                                                               #(mapv :body %)))))
                    core-insts (when core-plan
                                 (vals (into {} (for [i (concat (vals (:taken core-plan)) (:extra core-plan))] [[(:def i) (:args i)] i]))))
                    ;; RF12-P6: drop glue's shims the program's types need, built natively when the glue is the type's Drop::drop alone
                    glue-shims (when (and core-plan (not (System/getenv "RF_CORE_SHIM_PACK")))
                                 (for [x (:ext-items facts) :when (= :drop-glue (:shim x))
                                       :let [t (first (:args x))
                                             ;; the record's shim by its instance (`Shim(DropGlue(.., Some(D)))`)
                                             tt (binding [c/*in-value* false] (c/print-ty t))
                                             rec (some #(when (and (str/starts-with? (str (:instance %)) "Shim(DropGlue(")
                                                                   (str/ends-with? (str (:instance %)) (str "Some(" tt ")))")))
                                                          %)
                                                       rec-bodies)
                                             dfn (when rec (try (mono/drop-shim-plan n t) (catch Throwable _ nil)))]
                                       :when dfn]
                                   {:rec rec :def "core::ptr::drop_glue" :args [t] :body (drop-shim-body t dfn) :shim true}))
                    core-f (when (or (seq core-insts) (seq glue-shims))
                             (mono/core-facts n (for [i (concat core-insts glue-shims)] {:def (:def i) :args (:args i) :name (str "native " (:def i) (pr-str (:args i))) :body (:body i)})))
                    core-items (for [i core-insts :let [h (get (:items core-f) (str "native " (:def i) (pr-str (:args i))))] :when (and (map? h) (not (mono/error? h)))]
                                 [h i])
                    native-syms (into (set (map (comp :symbol first) core-items)) (map (comp :symbol :rec) glue-shims))
                    _ (when (System/getenv "RF_CORE_DEBUG")
                        (doseq [[h i] core-items] (swap! lines conj (str "debug native " (:def i) " " (:symbol h))))
                        (doseq [x (:ext-items facts)] (swap! lines conj (str "debug ext " (pr-str (dissoc x :args)) " " (pr-str (:args x)))))
                        (doseq [r rec-bodies] (swap! lines conj (str "debug record " (:name r) " " (:symbol r)))))
                    _ (doseq [l (:lines core-plan)] (swap! lines conj l))
                    facts (cond-> facts core-f (-> (update :callees merge (:callees core-f)) (update :fsyms merge (:fsyms core-f))
                                                   (assoc :native-core-syms native-syms)))
                    _ (reset! judged (vec (for [[rn rforms] judge] [rn (mc/judge n bodies facts (mc/record-entries rforms) rforms)])))
                    _ (mem-mark (str n " judged"))
                    root-file (or *loc-file* build/*root-file*)
                    ;; RF17: the program's own constants (a `const` item's body, construct_const's, by its text `const NAME`), each
                    ;; evaluated once as CTFE evaluates it (eval-promoted over its built body, _0's value): a scalar's (scalar BITS
                    ;; SIZE), else nil (left unevaluated: codegen refuses it)
                    const-bodies (into {} (for [[nm b _] bodies :when (and b (= :const (:kind b)))] [(str "const " nm) b]))
                    const-by-def (into {} (for [[_ b _] bodies :when (and b (= :const (:kind b)) (number? (:id (:def b))))] [(:id (:def b)) b]))
                    const-vals (atom {})
                    local-const (fn local-const [text tyf v]
                                  (if-let [[_ vp] (and (not (contains? const-bodies text)) (re-matches #"const (.+)::\{constant#\d+\}" text))]
                                    ;; a variant's explicit discriminant (`Color::Green as u8`: THIR's cast of a unit variant, its
                                    ;; anonymous constant), as eval-promoted's
                                    (when-let [d (try (mono/variant-discriminant n vp) (catch Throwable _ nil))]
                                      (when-let [[_ bits] (scalar-kind tyf)]
                                        (list 'scalar (mod (bigint d) (reduce * 1N (repeat bits 2N))) (quot bits 8))))
                                  (when-let [b (or (get const-bodies text)
                                                   ;; a local trait's associated constant (`<i32 as Zero>::ZERO`): the impl's
                                                   ;; constant, by resolve_associated_item (the constant's definition and arguments
                                                   ;; kept by the builder)
                                                   (when-let [[d args] (:nc (meta v))]
                                                     (when (number? d)
                                                       (when-let [[d' args'] (mono/resolve-const n d args)]
                                                         (when (empty? (remove c/region? args')) (get const-by-def d'))))))]
                                    (if (contains? @const-vals text)
                                      (get @const-vals text)
                                      (let [v (try (let [{:keys [bytes relocs ty]} (eval-promoted b nil nil nil nil nil nil local-const true)]
                                                     (when (and (empty? relocs) (scalar-kind (or ty (:ret b))) (seq bytes))
                                                       (list 'scalar (bytes->int bytes) (count bytes))))
                                                   (catch Throwable e
                                                     (when (System/getenv "RF_PROMOTED_TRACE") (.printStackTrace e))
                                                     nil))]
                                        (swap! const-vals assoc text v)
                                        v)))))
                    ;; RF11: with BUILD_PASS (the batch's SimplifyCfg-pre-optimizations), each body after the ported passes to
                    ;; runtime MIR (arbace.rust.front.passes: PromoteTemps, ElaborateDrops, ElaborateBoxDerefs, ...), as codegen
                    ;; reads rustc's; a pass's error is the body's
                    ;; RIND5: a refusal's data beside its words (`a path [..]`), cut to 300 characters
                    ours (into {} (for [[nm b err0 x] bodies
                                        :let [err (if (and err0 (string? x) (not= "nil" x)) (str err0 " " (subs x 0 (min 300 (count x)))) err0)]]
                                    [nm (if-let [st (:stages b)]
                                          (let [last-pass (last (filter #(contains? st %) (map first @(requiring-resolve 'arbace.rust.front.passes/pipeline))))
                                                r (get-in st [last-pass ((requiring-resolve 'arbace.rust.front.passes/body-key) b)])
                                                pre (str ((requiring-resolve 'arbace.rust.front.passes/body-key) b) "::promoted[")
                                                pbs (into {} (for [[k pb] (get st last-pass) :when (and (str/starts-with? k pre) (not (:error pb)))] [(:promoted pb) pb]))
                                                ;; the Assert terminators' spans (build's :assert-span metadata) by their condition, expected value
                                                ;; and message, which the passes keep (they renumber blocks, not these locals) but not the metadata
                                                aspans (into {} (for [blk (:blocks b) :let [t (:term blk)] :when (and (seq? t) (= 'assert (first t)) (:assert-span (meta t)))]
                                                                  [(vec (take 3 (rest t))) (:assert-span (meta t))]))]
                                            (if (or (nil? r) (:error r)) [nil (str "the passes: " (or (:error r) "no body"))] [(assoc r :name (:name b) :promoted-bodies pbs :assert-spans aspans) err]))
                                          [b err])]))
                    ;; RF15 (RFP49 (a)'s rest): the generic instances the collector reached, our runtime bodies instantiated
                    ours (into ours (for [[nm [base args]] (:instances facts) :let [[b err] (get ours base)]]
                                      [nm (if b
                                            (try [(assoc (mono/instantiate-runtime n b args) :name nm) err]
                                                 (catch Throwable e [nil (str "the instance: " (.getMessage e))]))
                                            [nil err])]))
                    native-call (fn [f]
                                  (let [txt (second f) c (get (:callees facts) txt)
                                        sp (:call-span (meta f))
                                        recs (get @rec-callees txt)
                                        cal (cond
                                              ;; RF13: a call through a function pointer (the operand a local): no instance to resolve,
                                              ;; codegen calls the operand's value
                                              (not= 'const (first f)) nil
                                              (and c (not (mono/error? c))) (do (fact! :callees true) (list 'callee c))
                                              :else (do (fact! :callees false)
                                                        (when (System/getenv "RF_CALLEE_TRACE") (swap! lines conj (str "debug no-callee " txt " " (pr-str c))))
                                                        ;; RF14: the refusals by their reason (mono's message, a run's `callee refusals` line)
                                                        (swap! refusals update (if (mono/error? c) (str/replace (str (second c)) #"\s+" " ") "no fact") (fnil inc 0))
                                                        (or (ffirst recs) (throw (ex-info (str "no callee for " txt) {})))))
                                        cl (:call-loc (meta f))
                                        l (cond (vector? sp) (do (fact! :locs true) (list 'loc root-file (first sp) (second sp)))
                                                ;; RF12-P6: a native core body's call: its place in core's sources
                                                cl (do (fact! :locs true) (list 'loc (first cl) (second cl) (nth cl 2)))
                                                :else (do (fact! :locs false) (or (second (first recs)) (list 'loc "?" 0 0))))]
                                    [cal l]))
                    fsym (into {} (for [[txt s] (:fsyms facts)]
                                    [txt (if (mono/error? s) (do (fact! :fn-symbols false) (get (:fsym rfacts) txt)) (do (fact! :fn-symbols true) s))]))
                    statics (into {} (for [[nm m] rec-statics]
                                       [nm (let [o (get (:statics facts) nm)] (if (map? o) (do (fact! :statics true) o) (do (fact! :statics false) m)))]))
                    header (fn [rec]
                             (let [o (or (get (:items facts) (:name rec)) (get (:items core-f) (:name rec)))]
                               (if (and (map? o) (not (mono/error? o)))
                                 (do (fact! :symbols true) (assoc (dissoc o :name) :phase "optimized" :name (:name rec)))
                                 (do (fact! :symbols false) (select-keys rec [:def :def-id :phase :instance :symbol :name :kind :track-caller :spread-arg])))))
                    ;; RF11: an Assert's location from its expression's span (build's :assert-span), as a call's
                    assert-loc (fn [t] (let [sp (:assert-span (meta t))]
                                         (if (vector? sp) (do (fact! :locs true) (list 'loc root-file (first sp) (second sp)))
                                             (do (fact! :locs false) (list 'loc "?" 0 0)))))
                    nf {:fsym fsym :statics statics :native-call native-call :header header :assert-loc assert-loc
                        :vtables (:vtables facts) :vtable! (fn [native?] (fact! :vtables native?))
                        :const! (fn [native?] (fact! :consts native?))
                        ;; RF15: a promoted ADT value's bytes (an enum's variant: `&Color::Blue`, `&Some(1.5)`) from mono's layout
                        :anon-discr (fn [vp] (try (mono/variant-discriminant n vp) (catch Throwable _ nil)))
                        ;; RF16: a type's layout, mono's (a promoted `size_of::<T>()`)
                        :layout-of (fn [tyf] (mono/type-layout-form n tyf))
                        ;; RF17: a local constant (`const LIMIT: usize = 4`) evaluated as codegen's eval_mir_constant evaluates it:
                        ;; its built body (construct_const's) interpreted by eval-promoted, a scalar's bytes its (scalar BITS SIZE)
                        :local-const local-const
                        ;; RF17: a closure's reified pointer's symbol (its ClosureOnceShim's), counted
                        :closure-fnptr (fn [tyf] (let [s (try (mono/closure-once-symbol n tyf) (catch Throwable _ nil))]
                                                   (fact! :closure-shims (some? s)) s))
                        :unit-variant (fn [tyf vidx fields]
                                        (let [l (try (mono/type-layout-form n tyf)
                                                     ;; a layout mono refuses: the record's, as the module's table takes it
                                                     (catch Throwable e (or (get rec-layouts (second tyf))
                                                                            (throw (ex-info (str "the variant " vidx " of " (second tyf) ": " (.getMessage e)) {})))))]
                                          (variant-bytes l vidx fields)))}
                    local? (fn [b] (str/starts-with? (str (:def-id b)) "DefId(0:"))
                    ext-syms (set (map :symbol (:ext-items facts)))
                    rec-by-name (into {} (for [r rec-bodies] [(:name r) r]))
                    body-form (fn [nm]
                                (let [[b err] (get ours nm) rec (or (get rec-by-name nm) {:name nm})]
                                  (if b
                                    (try (let [r (runtime-body b rec nf abort?)
                                               r (if (control?) (walk #(if (= "Add" %) "Sub" (if (= "AddWithOverflow" %) "SubWithOverflow" %)) r) r)
                                               r (assoc r :phase "arbace-built+cleanup")]
                                           (swap! lines conj (str "ours   " nm))
                                           (list 'mir/body r))
                                         (catch Throwable e
                                           (swap! lines conj (str "record " nm " (" (.getMessage e) ")"))
                                           (fact! :bodies false)
                                           (if-let [r (get rec-by-name nm)] (list 'mir/body r) (throw e))))
                                    (do (swap! lines conj (str "record " nm " (" err ")")) (fact! :bodies false)
                                        (list 'mir/body (or (get rec-by-name nm) (throw (ex-info (str "no body for " nm) {}))))))))
                    ;; RF12-P6: the native core bodies made runtime bodies; S4: one by one, a body that fails at run time keeps the
                    ;; record's body of its symbol (`record-kept`), all or none only when the record has no body of a failing one
                    rec-syms (set (map :symbol rec-bodies))
                    native-done (when (or (seq core-items) (seq glue-shims))
                                  (try (doall (concat
                                               (for [[h i] core-items
                                                     :let [r (try (runtime-body (assoc (:body i) :name (:name h)) h nf abort?)
                                                                  (catch Throwable e
                                                                    (if (rec-syms (:symbol h))
                                                                      (do (swap! lines conj (str "record-kept " (:name h) " (a native body failed at run time: " (.getMessage e) ")")) nil)
                                                                      (throw e))))]
                                                     :when r]
                                                 [(:symbol h) (list 'mir/body (assoc r :phase "arbace-native-core"))])
                                               (for [g glue-shims]
                                                 (let [r (runtime-body (assoc (:body g) :name (:name (:rec g))) (:rec g) nf abort?)]
                                                   (swap! lines conj (str "native " (:name (:rec g)) " (drop glue's shim, built natively)"))
                                                   (fact! :core-bodies true)
                                                   [(:symbol (:rec g)) (list 'mir/body (assoc r :phase "arbace-native-core"))]))))
                                       (catch Throwable e
                                         (swap! lines conj (str "record core's bodies (a native one failed at run time: " (.getMessage e) ")"))
                                         nil)))
                    native-forms (when native-done (map second native-done))
                    ;; RF17: a std ADT's tuple constructor used as a function value and instantiated in the program's crate (the
                    ;; record's `mir/external`: rustc's build_ctor shim, whose MIR the helper does not dump), built natively
                    ;; (mono/ctor-shim-body) from the function constant naming it in the record's bodies
                    ;; RIND5: the local crate's own root (a program named after a library crate: std.rs, crate `std`)
                    crate-tok (let [cn (str/replace (str n) "-" "_")]
                                (or (try (let [{:keys [id]} (mono/local-crate n) t (str "C" (mono/disambiguator (mono/u64 id)) (mono/ident cn))]
                                              (when (some #(and (local? %) (str/includes? (str (:symbol %)) t)) rec-bodies) t))
                                         (catch Throwable _ nil))
                                    (some (fn [b] (when (local? b) (re-find (re-pattern (str "Cs[0-9A-Za-z]+_" (count cn) cn)) (str (:symbol b))))) rec-bodies)))
                    fndef-of (let [acc (atom {})]
                               (doseq [b rec-bodies]
                                 (walk (fn [x] (when (and (seq? x) (= 'const (first x)) (some #{:fn-symbol} x))
                                                 (let [sy (second (drop-while #(not= :fn-symbol %) x)) tyf (nth x 2 nil) st (when (seq? tyf) (nth tyf 2 nil))]
                                                   (when (and (seq? st) (= 'fndef (first st))) (swap! acc assoc sy [(second st) (nth st 2)]))))
                                         x)
                                       (dissoc b :alloc-data)))
                               @acc)
                    ctor-forms (doall
                                (for [f forms :when (= 'mir/external (first f))
                                      :let [{:keys [symbol def]} (second f)]
                                      :when (and crate-tok (str/ends-with? (str symbol) crate-tok) (get fndef-of symbol))
                                      :let [[fp afs] (get fndef-of symbol)
                                            ;; the constructor's path from the item's def_path_str less its generic arguments
                                            ;; (`std::result::Result::<(), ..>::Err`), the constant's own a re-export's
                                            ;; (`std::prelude::v1::Err`)
                                            p (loop [cs (seq (str def)) depth 0 out (StringBuilder.)]
                                                (if-let [ch (first cs)]
                                                  (cond (and (zero? depth) (= [\: \: \<] (take 3 cs))) (recur (drop 3 cs) 1 out)
                                                        (pos? depth) (recur (rest cs) (case ch \< (inc depth) \> (dec depth) depth) out)
                                                        :else (recur (rest cs) depth (.append out ch)))
                                                  (str out)))
                                            b (try (or (mono/ctor-shim-body n p afs) (mono/ctor-shim-body n fp afs)) (catch Throwable e (swap! lines conj (str "record " def " (the constructor's shim: " (.getMessage e) ")")) nil))]
                                      :when b]
                                  (do (swap! lines conj (str "native " def " (a constructor's shim, built natively)"))
                                      (fact! :ctor-shims true)
                                      (list 'mir/body (assoc b :symbol symbol :name def :phase "arbace-native-ctor" :instance (str "Shim(Ctor(" def "))"))))))
                    native-taken (if native-done (set (map first native-done)) #{})
                    _ (doseq [[h _] core-items :when (native-taken (:symbol h))] (swap! lines conj (str "native " (:name h))) (fact! :core-bodies true))
                    ;; the module from the collector's items: our bodies, then core's bodies (the record's: RF12), the statics,
                    ;; the lang items' symbols, the layouts; the record's entry wrapper for a std program
                    new-forms
                    (doall
                     (concat
                      (for [nm (:order facts)] (body-form nm))
                      (for [rec rec-bodies :when (and (not (local? rec)) (not (native-taken (:symbol rec))))]
                        (do (swap! lines conj (str "record " (:name rec) " (" (if (ext-syms (:symbol rec)) "core's body, reached by the collector" "core's body, reached through core's bodies") ")"))
                            (fact! :core-bodies false)
                            (list 'mir/body rec)))
                      ;; RF12-P6: core's bodies built natively (each instance of the closure once)
                      (or native-forms [])
                      ctor-forms
                      (for [[nm m] (:statics facts) :when (map? m)] (list 'mir/static m))
                      [(list 'mir/layouts [])]
                      [(list 'mir/langsyms (into {} (for [ln (distinct (concat (keys (:langsyms facts)) (keys rec-langs)))]
                                                      [ln (let [o (get (:langsyms facts) ln)] (if (and o (not (mono/error? o))) (do (fact! :langsyms true) o) (do (fact! :langsyms false) (get rec-langs ln))))])))]
                      (for [f forms :when (= 'mir/entry (first f))] (do (fact! :entry false) f))))
                    _ (mem-mark (str n " module's forms"))
                    our-forms (mono/ty-forms (keep first (vals ours)))
                    core-forms (mono/ty-forms (concat (for [f new-forms :when (= 'mir/body (first f)) :let [b (second f)] :when (not= "arbace-built+cleanup" (:phase b))] (dissoc b :alloc-data))
                                                      ;; queue 448: the record's bodies of the native ones too, which codegen takes in place
                                                      ;; of a native body it refuses (check's emit-mono), so that their types have layouts
                                                      (for [r rec-bodies :when (native-taken (:symbol r))] (dissoc r :alloc-data))))
                    ;; a layout mono refuses: the record's, when it has that type
                    lt ((:layouts-of facts) (concat our-forms core-forms))
                    table (into (sorted-map)
                                (concat (for [[t l] lt :when (not (mono/error? l))] [t l])
                                        (for [[t o] lt :when (mono/error? o) :let [l (get rec-layouts t)] :when l] [t l])))]
                ;; a layout mono refuses is the record's when the record has its type (counted), else no body needs it
                (doseq [[t o] lt] (if (mono/error? o) (when (contains? rec-layouts t) (fact! :layouts false)) (fact! :layouts true)))
                ;; RFP44 (a): a virtual call's slot, where the callee (the record's) has none: from the call's method path and its
                ;; receiver's dyn type, the trait's vtable entries (mono's vtable-entries)
                (let [vkey (fn [t] (when (and (seq? t) (= 'call (first t)) (> (count t) 6))
                                     (let [ci (nth t 6)]
                                       (when (and (seq? ci) (map? (second ci)) (= "virtual" (:kind (second ci))) (nil? (:slot (second ci))))
                                         (let [fty (nth (second t) 2 nil) st (when (seq? fty) (nth fty 2 nil))]
                                           (when (and (seq? st) (= 'fndef (first st)))
                                             [(second st) (second (first (nth st 2)))]))))))
                      ks (distinct (for [f new-forms :when (= 'mir/body (first f)) blk (:blocks (second f)) :let [k (vkey (:term blk))] :when k] k))
                      slots (if (seq ks) (mono/record-slots n ks) {})
                      fix (fn [b] (update b :blocks (fn [bs] (mapv (fn [blk] (if-let [k (vkey (:term blk))]
                                                                                 (if-let [sl (get slots k)]
                                                                                   (do (fact! :vslots true)
                                                                                       (assoc blk :term (let [t (:term blk)] (apply list (concat (take 6 t) [(list 'callee (assoc (second (nth t 6)) :slot sl))] (drop 7 t))))))
                                                                                   (do (fact! :vslots false) blk))
                                                                                 blk))
                                                                             bs))))]
                  ;; RF16: a thread-local static a body names (`(tlsref MUT PATH)`, a nested static of the body's own item, std's
                  ;; RandomState::new's KEYS) given its symbol, mono's v0 of the static's def path (the body's DefId's, then its name)
                  (let [tls (fn [b]
                              (let [did (when-let [[_ k p] (re-find #"^DefId\((\d+):\d+ ~ (.*)\)$" (str (:def-id b)))]
                                          (when (not= "0" k) (str/replace p #"\[[0-9a-f]+\]" "")))]
                                (update b :blocks
                                        (fn [bs]
                                          (walk (fn [x]
                                                  (if (and (seq? x) (= 'tlsref (first x)) (= 3 (count x)) did
                                                           (str/starts-with? (str (nth x 2)) (str (:def b) "::")))
                                                    (let [p (str did (subs (str (nth x 2)) (count (str (:def b)))))
                                                          sym (try (mono/std-static-symbol n p) (catch Throwable _ nil))]
                                                      (fact! :tlsrefs (some? sym))
                                                      (if sym (concat x [sym]) x))
                                                    x))
                                                bs)))))]
                    (doall (for [f new-forms] (cond (= 'mir/layouts (first f)) (list 'mir/layouts (vec table))
                                                    (= 'mir/body (first f)) (list 'mir/body (tls (fix (second f))))
                                                    :else f)))))))))]
    {:forms result :lines @lines :tally @tally :judged @judged :refusals @refusals}))

(defn- run-lines
  "The run's lines of a module: each body's (ours, or the record's and why), the facts' tally, the bodies' count"
  [n {:keys [lines tally refusals]}]
  (concat lines
          ;; RF14: the callee facts mono refused, by reason (the record's taken)
          (for [[why k] (sort-by (comp - val) refusals)] (str "build-run: " n ": callee refused " k " " (subs why 0 (min 160 (count why)))))
          [(str "build-run: " n ": facts native " (str/join ", " (for [[k [a b]] (sort tally) :when (not (#{:core-bodies :bodies} k))] (str (name k) " " a "/" b)))
                (let [[a b] (get tally :core-bodies [0 0])] (str "; core's bodies from the pack " (- b a) (when (pos? a) (str ", built natively " a))))
                (when-let [[_ b] (get tally :bodies)] (str "; our bodies from the pack " b)))
           (format "build-run: %s: %d of %d bodies ours" n (count (filter #(str/starts-with? % "ours") lines)) (count lines))]))

(defn native-main [crates front-dir record out n & flags]
  (let [r (native-run crates front-dir record n (some #{"--panic-abort"} flags) nil)]
    (write-forms out (:forms r))
    (doseq [l (run-lines n r)] (println l))
    (System/exit 0)))

;; ---------------------------------------------------------------------------------------------
;; RFP36 (c), RFP40 (c): the essential step's runs as one session. Each program's pipeline runs once: its module (native-run),
;; RFP40 (c)'s mono-check of the same facts against the record, codegen (arbace.rust.back.check/emit-mono) and rsi's lowering to
;; C, in this one process; the lowered programs are then read and built by ci in one session (arbace.rust.front.ci-batch, musl's
;; forms read once) and run by cirun (bin/rust-front run-built).

(defn- lower-c
  "DIR/NAME.ours.ll lowered to DIR/NAME.ours.c as `bin/rsi lower` does: nil, or the refusal's text"
  [dir n]
  (let [ll (str dir "/" n ".ours.ll") out (str dir "/" n ".ours.c")
        read-ll (requiring-resolve 'arbace.repr.llvm/read-ll)
        lower-file (requiring-resolve 'arbace.cpp.lower/lower-file)
        spit-latin1 (requiring-resolve 'arbace.repr.llvm/spit-latin1)
        r (lower-file (read-ll ll) (.getName (File. out)))]
    (if (:refused r) (str "refused (" (name (:refused r)) "): " (:message r)) (do (spit-latin1 out (:c r)) nil))))

(def ^:dynamic *std-linked*
  "RF11: the module is linked with std's lowered library (rsi check's ci leg): the functions it calls but does not define are
  declared, as rustc's codegen unit declares them, not stubbed to abort (run-built's no_std programs)"
  false)

(defn- emit-and-lower
  "The module at DIR/NAME.mono.edn through codegen and rsi's lowering: nil, or why not (CRATES: std's crates' file, the local
  crate's identity for the check of instances not collected)"
  [dir n & [crates]]
  ;; RF13: a failure past codegen (the printer's) is the program's refusal, not the batch's end
  (let [;; queue 448: the program's crate's token for emit-mono's check of the native bodies' calls (an instance of the
        ;; program's crate they call that no body defines: those bodies the record's, codegen-fallback)
        tok0 (try (let [{:keys [id]} (binding [mono/*crates* (or mono/*crates* (mono/load-crates crates))] (mono/local-crate n))]
                    (str "C" (mono/disambiguator (mono/u64 id)) (mono/ident (str/replace n "-" "_"))))
                  (catch Throwable _ nil))
        [st what] (try ((requiring-resolve 'arbace.rust.back.check/emit-mono) dir n *std-linked* tok0)
                       (catch Throwable e [:unsupported (str "the module's printing: " (.getMessage e))]))
        _ (mem-mark (str n " codegen done"))]
    (if (not= st :ok)
      (str "codegen refused (" (name st) " " what ")")
      (or (when-let [why (lower-c dir n)] (str "rsi's lowering refused (" why ")"))
          ;; RF13: an instance of the program's crate the module declares but does not define (a generic local function, a
          ;; closure or a derived method reached only through std's bodies, which the collector does not walk): the link
          ;; would fail, so the module is not the program's
          (let [ll (slurp (str dir "/" n ".ours.ll"))
                cn (str/replace n "-" "_")
                ;; RIND5: the local crate's own root (its StableCrateId's disambiguator), not the first crate root of its
                ;; name: a program named after a library crate (rsi's sample std.rs, crate `std`) declares the real std's items
                tok (or (try (let [{:keys [id]} (binding [mono/*crates* (or mono/*crates* (mono/load-crates crates))] (mono/local-crate n))
                                   t (str "C" (mono/disambiguator (mono/u64 id)) (mono/ident cn))]
                               (when (str/includes? ll t) t))
                             (catch Throwable _ nil))
                        (re-find (re-pattern (str "Cs[0-9A-Za-z]+_" (count cn) cn)) ll))
                missing (when tok (for [[_ sym] (re-seq #"(?m)^declare [^@]*@([^ (]+)\(" ll) :when (str/includes? sym tok)] sym))]
            (when (seq missing)
              (str "a local instance not collected (" (count missing) ": " (first missing) ")")))))))

(defn- tally-line [tally sep]
  (str/join ", " (for [[k [e t]] (sort tally)] (str (name k) " " e sep t))))

(defn batch-main
  "batch CRATES FRONT-DIR WORK [--control NAME] [--mono-control A B] SPEC...: each SPEC NAME or NAME:abort (panic=abort), its
  record WORK/NAME/NAME.record.edn; writes WORK/NAME/NAME.{mono.edn,ours.ll,ours.c} and, for the run's control (--control:
  every Add a Sub), WORK/_control/NAME/; WORK/mono.log as `bin/rust-front mono-check` prints it, WORK/mono-control.log as
  `mono-check --control A B` prints it; on the standard output each program's run lines and `run-built: NAME: ready` or
  why not"
  [crates front-dir work & args]
  (let [[opts specs] (loop [as args o {}]
                       (case (first as)
                         "--control" (recur (nnext as) (assoc o :control (second as)))
                         "--mono-control" (recur (drop 3 as) (assoc o :mono-control [(second as) (nth as 2)]))
                         "--std" (recur (next as) (assoc o :std true))
                         [o as]))
        ;; RF11: NAME[:abort][=REL], REL the path caller locations name (rsi's plan's, relative to the checkout)
        progs (for [s specs] (let [[s rel] (str/split s #"=" 2) [n a] (str/split s #":")] [n (= a "abort") rel]))
        rec-file (fn [n] (str work "/" n "/" n ".record.edn"))
        [ca cb] (:mono-control opts)
        mono-lines (atom []) total (atom {}) ctl-lines (atom []) ctl-total (atom {}) all-ok (atom true)
        verbose (System/getenv "MONO_VERBOSE")]
    (doseq [[n abort? rel] progs]
      (binding [*loc-file* rel *std-linked* (boolean (:std opts)) bc/*file-name* rel mono/*unknown-refused* (boolean (:std opts))]
      (let [dir (str work "/" n)
            own (read-forms (slurp (rec-file n)))
            _ (mem-mark (str n " batch: record read"))
            other (cond (= n ca) cb (= n cb) ca)
            judge (cond-> [[n own]] other (conj [other (read-forms (slurp (rec-file other)))]))
            r (try (native-run crates front-dir own n abort? judge)
                   (catch Throwable e (when (System/getenv "RF11_TRACE") (.printStackTrace e)) {:error (str e)}))]
        (if (:error r)
          (println (str "run-built: " n ": the pipeline failed (" (:error r) ")"))
          (let [_ (mem-mark (str n " batch: native-run done"))
                _ (write-forms (str dir "/" n ".mono.edn") (:forms r))
                _ (mem-mark (str n " batch: module written"))
                rl (run-lines n r)
                _ (println (str/join "\n" (filter #(str/starts-with? % "build-run: ") rl)))
                _ (spit (str dir "/build-run.log") (str (str/join "\n" rl) "\n"))
                [[_ [tally diffs]] [_ [ctally cdiffs]]] (:judged r)]
            (swap! mono-lines conj (str "mono-check: " n ": " (tally-line tally "/")))
            (when verbose (doseq [d (take 400 diffs)] (swap! mono-lines conj (str "   " (pr-str d)))))
            (when (seq diffs) (reset! all-ok false))
            (doseq [[k [e t]] tally] (swap! total update k (fnil (fn [[a b]] [(+ a e) (+ b t)]) [0 0])))
            (when other
              (swap! ctl-lines conj [n (cons (str "mono-check: " n " against " other "'s record: " (tally-line ctally "/"))
                                             (for [d (take 3 cdiffs)] (str "   " (pr-str d))))])
              (doseq [[k [e t]] ctally] (swap! ctl-total update k (fnil (fn [[a b]] [(+ a e) (+ b t)]) [0 0]))))
            (println (str "run-built: " n ": " (if-let [why (emit-and-lower dir n crates)] why "ready")))
            (mem-mark (str n " batch: codegen and lowering done"))
            (when (= n (:control opts))
              (let [cdir (str work "/_control/" n)
                    _ (.mkdirs (File. cdir))
                    c (binding [*control* true] (native-run crates front-dir (rec-file n) n abort? nil))]
                (write-forms (str cdir "/" n ".mono.edn") (:forms c))
                (println (str "run-built: _control/" n ": " (if-let [why (emit-and-lower cdir n crates)] why "ready"))))))))))
    (spit (str work "/mono.log")
          (str (str/join "\n" (concat @mono-lines [(str "mono-check: " (count progs) " programs: " (tally-line @total " of "))])) "\n"))
    (when ca
      (spit (str work "/mono-control.log")
            (str (str/join "\n" (concat (mapcat second (sort-by #(if (= (first %) ca) 0 1) @ctl-lines))
                                        [(str "mono-check: 2 programs (control): " (tally-line @ctl-total " of "))])) "\n")))
    (System/exit 0)))

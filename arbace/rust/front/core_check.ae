;; RF12's first slice (doc/rust/FRONTEND-SURVEY.md, "As built: RF12 (first slice)"): the front end over core's own sources
;; (rust-src 1.99.1's library/core, pinned by tools/rsdump/apks.sha256), module by module. The module tree follows
;; rustc_expand/src/module.rs (mod_file_path, #[path], the directory ownership of mod.rs and lib.rs), cfg evaluated for
;; core's build (rustc 1.99.1's --print cfg for x86_64-alpine-linux-musl at -C opt-level=0 -C overflow-checks=off);
;; rustc is dual-licensed MIT OR Apache-2.0 (LICENSE.md, "Rust (rustc 1.99.1)").

(ns arbace.rust.front.core-check
  "RF12's measure: each module file of core read by the native reader, expanded (core's own macro_rules! from its sources,
  textual scope approximated crate-wide), resolved, lowered, collected, type checked and its bodies built, the rest of
  core (the items of the other files) from std's interface; each body's built MIR against rustc's own built MIR of core
  (the oracle: rustc -Zdump-mir=built over the same sources, by hand, `bin/rust-front core-oracle`), the failures by stage
  and cause.

    bin/rust-front core-check [--list] [MODULE-FILE...]    (CORE_VERBOSE=1: each body's verdict)"
  (:require [arbace.repr.rust.lex :as lx]
            [arbace.repr.rust.parse :as ps]
            [arbace.repr.rust.native :as nat]
            [arbace.rust.front.expand :as ex]
            [arbace.rust.front.resolve :as resolve]
            [arbace.rust.front.lower :as lower]
            [arbace.rust.front.collect :as collect]
            [arbace.rust.front.typeck :as tc]
            [arbace.rust.front.build :as build]
            [arbace.rust.front.passes :as passes]
            [arbace.string :as str])
  (:import [java.io File]))

(defn- fget [x k] (when (seq? x) (get (apply hash-map (rest x)) k)))

(def ^:dynamic *crate*
  "RIND9 (a): the crate whose sources are read (its module tree under LIB/CRATE/src, `crate::` its root): core, or alloc for
  arbace.rust.front.alloc-check's interface pass"
  "core")
(defn- head [x] (when (seq? x) (first x)))

;; ---------------------------------------------------------------------------------------------
;; core's cfg (rustc --print cfg, RUSTC_BOOTSTRAP=1, -C opt-level=0 -C overflow-checks=off: debug assertions on, ub_checks on)

(def core-cfg
  {"debug_assertions" true "fmt_debug" #{"full"} "panic" #{"unwind"} "relocation_model" #{"pic"} "target_abi" #{""}
   "target_arch" #{"x86_64"} "target_endian" #{"little"} "target_env" #{"musl"} "target_family" #{"unix"}
   "target_feature" #{"fxsr" "sse" "sse2" "x87"}
   "target_has_atomic" #{true "8" "16" "32" "64" "ptr"} "target_has_atomic_load_store" #{true "8" "16" "32" "64" "ptr"}
   "target_has_atomic_primitive_alignment" #{"8" "16" "32" "64" "ptr"}
   "target_has_reliable_f128" true "target_has_reliable_f16" true "target_has_reliable_f16_math" true
   "target_has_threads" true "target_object_format" #{"elf"} "target_os" #{"linux"} "target_pointer_width" #{"64"}
   "target_thread_local" true "target_vendor" #{"alpine"} "ub_checks" true "unix" true
   "libc_unstable_musl_v1_2" true "libc_unstable_musl_v1_2_3" true})

;; ---------------------------------------------------------------------------------------------
;; Reading a file

(defn- parse-text
  "A source text read by the native reader: the crate (its :items), edition 2024 (core's, alloc's and std's)"
  [^String text]
  (let [src (lx/source text)
        {:keys [tree toks mt]} (binding [ps/*errs* (java.util.ArrayList.)] (ps/parse-file src 2024))]
    (nat/out tree src toks mt 2024)))

(declare cfg-on?)

(defn- line-offsets "Each line's first offset in TEXT (line 1 at index 0)" [^String text]
  (loop [i 0 acc [0]] (let [j (.indexOf text "\n" (int i))] (if (neg? j) acc (recur (inc j) (conj acc (inc j)))))))

(defn- blank-outside
  "TEXT with every character outside [B, E) a space, its newlines kept: a part of a file read again at its own places"
  [^String text b e]
  (let [sb (StringBuilder. (count text))]
    (dotimes [i (count text)]
      (let [c (.charAt text i)] (.append sb (if (or (= c \newline) (and (>= i b) (< i e))) c \space))))
    (str sb)))

(defn- tree-span [t] (case (first t) Token (fget (second t) :span) Delimited (let [d (second t)] [(nth (fget d :open) 0) (nth (fget d :open) 1) (nth (fget d :close) 2) (nth (fget d :close) 3)]) nil))
(defn- fat-arrow? [t] (and (= 'Token (first t)) (= 'FatArrow (fget (second t) :kind))))
(defn- comma? [t] (and (= 'Token (first t)) (= 'Comma (fget (second t) :kind))))

(defn- select-arms
  "A cfg_select!'s arms from its token trees (rustc_parse's parse_cfg_select): [[PRED-SPAN-or-:wild BODY-B BODY-E]] as
  [line col] pairs, a brace arm's body its inside, another's its tokens to the comma"
  [trees]
  (loop [xs (vec trees) out []]
    (if (empty? xs) out
      (let [i (first (keep-indexed (fn [i t] (when (fat-arrow? t) i)) xs))]
        (if (nil? i) out
          (let [pred (subvec xs 0 i) r (subvec xs (inc i)) body (first r)
                wild? (and (= 1 (count pred)) (= 'Token (first (first pred))) (let [k (fget (second (first pred)) :kind)] (and (seq? k) (= "_" (second k)))))
                ps (let [a (tree-span (first pred)) z (tree-span (peek pred))] [[(nth a 0) (nth a 1)] [(nth z 2) (nth z 3)]])]
            (if (and (= 'Delimited (first body)) (= 'Brace (nth body 3)))
              (let [d (second body) o (fget d :open) c (fget d :close) more (subvec r 1)]
                (recur (if (and (seq more) (comma? (first more))) (subvec more 1) more)
                       (conj out [(if wild? :wild ps) [(nth o 2) (nth o 3)] [(nth c 0) (nth c 1)]])))
              (let [j (or (first (keep-indexed (fn [i t] (when (comma? t) i)) r)) (count r))
                    a (tree-span (first r)) z (tree-span (nth r (dec j)))]
                (recur (subvec r (min (count r) (inc j))) (conj out [(if wild? :wild ps) [(nth a 0) (nth a 1)] [(nth z 2) (nth z 3)]]))))))))))

(defn- ident-tree? [t nm] (and (= 'Token (first t)) (let [k (fget (second t) :kind)] (and (seq? k) (= 'Ident (first k)) (= nm (second k))))))

(defn- if-arms
  "A cfg_if!'s arms (the cfg-if crate's `if #[cfg(P)] { .. } else if #[cfg(Q)] { .. } else { .. }`, backtrace's):
  [[[:attr ATTR-B ATTR-E]-or-:wild BODY-B BODY-E]], the attribute's inside `cfg(P)`"
  [trees]
  (let [inside (fn [t] (let [d (second t) o (fget d :open) c (fget d :close)] [[(nth o 2) (nth o 3)] [(nth c 0) (nth c 1)]]))]
    (loop [xs (vec trees) out []]
      (cond
        (and (>= (count xs) 4) (ident-tree? (nth xs 0) "if") (= 'Delimited (first (nth xs 2))) (= 'Delimited (first (nth xs 3))))
        (let [[ab ae] (inside (nth xs 2)) [bb be] (inside (nth xs 3)) more (subvec xs 4)]
          (recur (if (and (seq more) (ident-tree? (first more) "else")) (subvec more 1) more) (conj out [[:attr ab ae] bb be])))
        (and (seq xs) (= 'Delimited (first (first xs))))
        (let [[bb be] (inside (first xs))] (conj out [:wild bb be]))
        :else out))))

(defn- macro-name [it]
  (let [k (fget it :kind)]
    (when (and (seq? k) (= 'MacCall (first k)))
      (let [segs (fget (fget (second k) :path) :segments)] (second (fget (last segs) :ident))))))

(defn- cfg-select?
  "An item `cfg_select! { .. }` (core's, std's: rustc_builtin_macros/src/cfg_select.rs), or `cfg_if::cfg_if! { .. }`
  (std's vendored backtrace)"
  [it]
  (#{"cfg_select" "cfg_if"} (macro-name it)))

(def ^:dynamic *item-macros*
  "queue 400: the crate's item macros without parameters, name -> {:text T :b [l c] :e [l c]} (the macro's file's text and its
  one arm's body inside): libc's `prelude!()`, whose `mod types;` and `mod prelude { .. }` the module tree and the index read
  where the call stands (rustc's expansion: a macro-expanded outline module's file relative to the invocation's directory)"
  {})

(declare splice-selects)

(defn- item-macro-items
  "The items of an item macro without parameters (*item-macros*), its body read again from its file's text at their own
  places, their cfg_select!s and item macros spliced in turn"
  [{:keys [^String text b e]}]
  (let [offs (line-offsets text)
        at (fn [[l c]] (+ (long (nth offs (dec l))) (dec c)))]
    (splice-selects (fget (parse-text (blank-outside text (at b) (at e))) :items) text)))

(defn- splice-selects
  "ITEMS with each item-level cfg_select! replaced by its first arm that holds for the build's cfg (core-cfg), the arm's
  items read again from the file's TEXT at their own places (round 54, RIND9 (a), std: sys/pal/mod.rs' `unix => { mod unix;
  pub use self::unix::*; }`, os/mod.rs' `pub mod linux;`), inline modules' items likewise: the module tree and the index see
  the modules and items a cfg_select! declares, as rustc's expansion does; queue 400: an item macro of the crate without
  parameters (*item-macros*: libc's `prelude!()`) replaced by its body's items"
  [items ^String text]
  (let [offs (delay (line-offsets text))
        at (fn [[l c]] (+ (long (nth @offs (dec l))) (dec c)))
        holds? (fn [ps] (or (= :wild ps)
                            (let [attr? (= :attr (first ps)) ps (if attr? (rest ps) ps)
                                  pt (subs text (at (first ps)) (at (second ps)))
                                  it (first (fget (parse-text (if attr? (str "#[" pt "] mod __arm {}") (str "#[cfg(" pt ")] mod __arm {}"))) :items))]
                              (cfg-on? it))))]
    (vec (mapcat (fn [it]
                   (cond
                     (and (seq *item-macros*) (get *item-macros* (macro-name it)))
                     (if-not (cfg-on? it) [] (item-macro-items (get *item-macros* (macro-name it))))
                     (cfg-select? it)
                     (if-not (cfg-on? it) [] ;; `#[cfg(doc)] cfg_select! {..}` (os/mod.rs)
                     (let [trees (second (fget (fget (second (fget it :kind)) :args) :tokens))]
                       (if-let [[_ b e] (first (filter #(holds? (first %)) ((if (= "cfg_if" (macro-name it)) if-arms select-arms) trees)))]
                         (splice-selects (fget (parse-text (blank-outside text (at b) (at e))) :items) text)
                         [])))
                     (let [k (fget it :kind)] (and (seq? k) (= 'Mod (first k)) (seq? (nth k 3)) (= 'Loaded (first (nth k 3)))))
                     (let [k (fget it :kind) mk (nth k 3)
                           mk (apply list (first mk) (splice-selects (second mk) text) (drop 2 mk))
                           k (apply list (concat (take 3 k) [mk] (drop 4 k)))]
                       [(apply list (first it) (mapcat (fn [[x v]] [x (if (= x :kind) k v)]) (partition 2 (rest it))))])
                     :else [it]))
                 items))))

(defn parse-file
  "A file of core read by the native reader: its items, edition 2024 (core's); round 54: its item-level cfg_select!s
  replaced by their arms that hold (splice-selects)"
  [^String f]
  (let [text (slurp f)
        c (parse-text text)
        items (fget c :items)]
    (if (or (str/includes? text "cfg_select!") (str/includes? text "cfg_if!") (seq *item-macros*))
      (apply list (first c) (mapcat (fn [[x v]] [x (if (= x :items) (splice-selects v text) v)]) (partition 2 (rest c))))
      c)))

(defn- attr-path-name [a]
  (let [k (fget a :kind)]
    (when (and (seq? k) (= 'Normal (first k)))
      (let [segs (fget (fget (fget (second k) :item) :path) :segments)]
        (when (= 1 (count segs)) (second (fget (first segs) :ident)))))))

(defn- path-attr [attrs]
  (some (fn [a] (when (= "path" (attr-path-name a))
                  (let [args (fget (fget (second (fget a :kind)) :item) :args)]
                    (when (= 'Eq (head args)) (str (fget (second (fget (fget args :expr) :kind)) :symbol))))))
        attrs))

(defn- item-macro-arm
  "A macro_rules! of one arm without parameters (`() => { ITEMS }`): its body's inside [B E] as [line col] pairs, or nil"
  [md]
  (let [trees (vec (second (fget (fget md :body) :tokens)))
        trees (if (and (seq trees) (= 'Token (first (peek trees))) (= 'Semi (fget (second (peek trees)) :kind))) (pop trees) trees)]
    (when (and (= 3 (count trees)) (= 'Delimited (first (nth trees 0))) (empty? (second (nth (nth trees 0) 4)))
               (fat-arrow? (nth trees 1)) (= 'Delimited (first (nth trees 2))))
      (let [d (second (nth trees 2)) o (fget d :open) c (fget d :close)]
        [[(nth o 2) (nth o 3)] [(nth c 0) (nth c 1)]]))))

(defn crate-item-macros
  "queue 400: the item macros without parameters of the crate whose root is LIB-FILE (*item-macros*' map): those of its
  root's `#[macro_use] mod NAME;` files (libc's macros.rs: `prelude!`)"
  [^String lib-file]
  (let [dir (.getParent (File. lib-file))]
    (into {} (for [it (fget (parse-text (slurp lib-file)) :items)
                   :let [k (fget it :kind)]
                   :when (and (= 'Mod (head k)) (not= 'Loaded (head (nth k 3)))
                              (some #(= "macro_use" (attr-path-name %)) (fget it :attrs)))
                   :let [nm (second (nth k 2))
                         f (some #(when (.exists (File. ^String %)) %) [(str dir "/" nm ".rs") (str dir "/" nm "/mod.rs")])]
                   :when f
                   :let [text (slurp f)]
                   m (fget (parse-text text) :items)
                   :let [mk (fget m :kind)]
                   :when (and (= 'MacroDef (head mk)) (fget (nth mk 2) :macro_rules))
                   :let [arm (item-macro-arm (nth mk 2))]
                   :when arm]
               [(second (nth mk 1)) {:text text :b (first arm) :e (second arm)}]))))

(def ^:dynamic *debug-assertions*
  "queue 462 (448-4 (a) 3): whether the crate is built with debug assertions (core-cfg's `debug_assertions` and `ub_checks`):
  true for core-check (rust-core-built's flags); false for the bodies judged against rsi's records, whose std build is
  test/rust/runtime/std.edn's :profile, DEBUG_ASSERTIONS false (alloc-check --export: `debug_assert!`'s blocks absent from the
  record's instances, wrap_index's 4 blocks against our 12)"
  true)

(declare crate-cfg*)

(defn crate-cfg
  "The cfg of the crate being built: core's (core-cfg), std's with the features the distributed std is built with
  (round 54: library/sysroot's default `std/backtrace` and `std/panic-unwind`; backtrace's `cfg(feature = \"std\")` is
  std's feature names, none of them `std`); without debug assertions (*debug-assertions*) neither `debug_assertions` nor
  `ub_checks` (rustc's ub_checks follows -C debug-assertions)"
  []
  (cond-> (crate-cfg*)
    (not *debug-assertions*) (dissoc "debug_assertions" "ub_checks")))

(defn- crate-cfg*
  []
  (case *crate*
    "std" (assoc core-cfg "feature" #{"backtrace" "panic-unwind"})
    ;; queue 400: std's dependencies vendored in library/vendor, as std's Cargo.toml builds them (`default-features = false,
    ;; features = ['rustc-dep-of-std']`) with their own features' closure (their Cargo.toml's [features]); libc also with
    ;; its build script's cfgs for the target (build.rs: `freebsd12` by default; `musl_v1_2_3` when the target's cfg
    ;; has `libc_unstable_musl_v1_2_3`, core-cfg's; nothing 32-bit)
    "libc" (assoc core-cfg "feature" #{"rustc-dep-of-std" "align" "rustc-std-workspace-core"} "freebsd12" true "musl_v1_2_3" true)
    "hashbrown" (assoc core-cfg "feature" #{"rustc-dep-of-std" "nightly" "core" "alloc" "rustc-internal-api"})
    ;; queue 561 (C6 L3, C6-1 (a)): the seven backtrace crates, at the features std's build gives them
    ;; (test/rust/front/std-build-units.edn's :features, Cargo's resolution of std's `backtrace` feature)
    "adler2" (assoc core-cfg "feature" #{"core" "rustc-dep-of-std"})
    "memchr" (assoc core-cfg "feature" #{"core" "rustc-dep-of-std"})
    "rustc_demangle" (assoc core-cfg "feature" #{"core" "rustc-dep-of-std"})
    "miniz_oxide" (assoc core-cfg "feature" #{"alloc" "core" "rustc-dep-of-std"})
    "object" (assoc core-cfg "feature" #{"alloc" "archive" "coff" "core" "elf" "macho" "pe" "read_core" "rustc-dep-of-std" "unaligned" "xcoff"})
    "gimli" (assoc core-cfg "feature" #{"read" "read-core" "rustc-dep-of-std"})
    "addr2line" (assoc core-cfg "feature" #{"alloc" "core" "rustc-dep-of-std"})
    core-cfg))

(def dep-crates
  "queue 400: std's dependency crates read natively from library/vendor (their names and interfaces, which the helper's
  std-names and std-iface do not hold): their `pub use m::*` re-exports and macro-declared modules taken as std's"
  ;; queue 542 (C6): and unwind (library/unwind: libunwind's foreign functions std's personality and backtrace call as `uw::`)
  ;; queue 561 (C6 L3): and the seven backtrace crates (backtrace-crates), each after the ones it depends on
  ["libc" "hashbrown" "unwind" "adler2" "memchr" "rustc_demangle" "miniz_oxide" "object" "gimli" "addr2line"])

(def backtrace-crates
  "queue 561 (C6 L3, C6-1 (a)): std's backtrace crates among dep-crates, in their dependencies' order (adler2 before miniz_oxide,
  memchr before object, gimli before addr2line); read by deps-setup only with DEPS_BACKTRACE=1, each pass over the names and
  facts of the dependencies read before it"
  ["adler2" "memchr" "rustc_demangle" "miniz_oxide" "object" "gimli" "addr2line"])

(def backtrace-editions
  "queue 561 (C6 L3): the backtrace crates' editions, their Cargo.toml's (rustc-demangle 0.1.28 names none: 2015); the others' 2024"
  {"adler2" 2021 "memchr" 2021 "rustc_demangle" 2015 "miniz_oxide" 2021 "object" 2018 "gimli" 2024 "addr2line" 2018})

(defn crate-edition
  "The edition the module run's collection and bodies take: a backtrace crate's own (closures capture whole variables before
  2021: rustc-demangle's Ident Display's closures), else 2024 (core's, alloc's, std's and their other dependencies', as before)"
  []
  (get backtrace-editions *crate* 2024))

(defn std-like?
  "std or one of its vendored dependencies (round 54's std-only readings: glob re-exports, #[path] from the declaring file)"
  [c]
  (or (= c "std") (some #{c} dep-crates)))

(defn crate-lib-file
  "The crate's root file: LIB/CRATE/src/lib.rs for the library's crates, LIB/vendor/CRATE-VERSION/src/lib.rs for a
  vendored dependency (queue 400; mono's lib-crate-root likewise)"
  [^String lib-dir ^String crate]
  (let [own (File. (str lib-dir "/" crate "/src/lib.rs"))]
    (if (.exists own)
      (.getCanonicalPath own)
      (let [ds (sort-by #(.getName ^File %) (seq (.listFiles (File. (str lib-dir "/vendor")))))
            ;; queue 561: a crate's directory by its package name (rustc_demangle's rustc-demangle-0.1.28)
            d (some (fn [^File d] (when (some #(re-matches (re-pattern (str "\\Q" % "\\E-[0-9][0-9.]*")) (.getName d)) [crate (str/replace crate "_" "-")]) d)) ds)]
        (when-not d (throw (ex-info (str "no crate " crate " under " lib-dir " (nor its vendor/)") {})))
        (.getCanonicalPath (File. (str (.getPath ^File d) "/src/lib.rs")))))))

(defn prelude-crate "The crate whose prelude a module of the crate being built reads: std's own for std, else core's" []
  (if (= *crate* "std") "std" "core"))

(defn- cfg-on?
  "Whether an item's cfg attributes hold for core's build (its cfg_attr ones are the expansion's)"
  [it]
  (let [attrs (vec (remove #(= "cfg_attr" (attr-path-name %)) (fget it :attrs)))
        it (apply list (first it) (mapcat (fn [[k v]] [k (if (= k :attrs) attrs v)]) (partition 2 (rest it))))]
    (binding [ex/*cfg-names* (crate-cfg)] (some? (ex/cfg-item it)))))

;; ---------------------------------------------------------------------------------------------
;; The module tree (rustc_expand/src/module.rs: mod_dir_path, default_submod_path)

(declare rel-path)
(defn module-files
  "core's out-of-line modules: [{:path \"core::num::wrapping\" :file F :dir D}] in the order the crate's expansion loads
  them (depth first); the arch modules of stdarch and portable-simd marked :vendored"
  [^String lib-dir]
  (let [out (atom [])]
    (letfn [(walk [path ^String file ^String dir items inline-dir]
              (doseq [it items
                      :let [k (fget it :kind)]
                      :when (and (= 'Mod (head k)) (cfg-on? it))]
                (let [[_ _ idf mk] k nm (second idf)
                      p (str path "::" nm)
                      pa (path-attr (fget it :attrs))
                      sub-dir (str (or inline-dir dir) "/" nm)]
                  (if (= 'Loaded (head mk))
                    (if (= 'Yes (nth mk 2))
                      ;; an inline module: its children's files under DIR/NAME (or #[path] relative to the parent's dir)
                      (walk p file dir (second mk) (if pa (str (or inline-dir dir) "/" pa) sub-dir))
                      (walk p file dir (second mk) sub-dir))
                    (let [base (or inline-dir dir)
                          ;; round 54: an outline module's #[path] is relative to the directory of the file that declares
                          ;; it (module.rs' mod_file_path_from_attr: the file's directory, not its module's): backtrace's
                          ;; gimli.rs `#[path = "gimli/mmap_unix.rs"] mod mmap;`, core's io_slice.rs `#[path =
                          ;; "io_slice/repr_iovec.rs"] mod repr;`: std's alone until core's check is rerun
                          base (if (and pa (nil? inline-dir) (std-like? *crate*)) (.getParent (File. ^String file)) base)
                          f (cond pa (str base "/" pa)
                                  (.exists (File. (str base "/" nm ".rs"))) (str base "/" nm ".rs")
                                  :else (str base "/" nm "/mod.rs"))
                          fd (if (or pa (re-find #"/mod\.rs$" f)) (.getParent (File. ^String f)) (str base "/" nm))
                          ;; a #[path] file not named mod.rs owns no directory but its own (module.rs: DirOwnership)
                          fd (if (and pa (not (re-find #"/mod\.rs$" f))) (.getParent (File. ^String f)) fd)
                          canon (.getCanonicalPath (File. ^String f))]
                      (when (.exists (File. ^String f))
                        ;; rust-c6c: the file as rustc names it (module.rs joins the #[path] to the declaring file's directory and
                        ;; never resolves `..`: std's backtrace_rs `std/src/../../backtrace/src/..`), its spans' file (run-module)
                        (swap! out conj (cond-> {:path p :file canon :vendored (boolean (re-find #"/(stdarch|portable-simd)/" canon))}
                                          (not= (rel-path f) (rel-path canon)) (assoc :src f)))
                        ;; rust-c6c: the declaring file as rustc names it (a #[path] below is joined to its directory: gimli.rs'
                        ;; `#[path = "gimli/mmap_unix.rs"] mod mmap;` under std/src/../../backtrace), its items parsed from the file
                        (walk p f fd (fget (parse-file canon) :items) nil)))))))]
      (let [lib (crate-lib-file lib-dir *crate*)]
        (binding [*item-macros* (if (some #{*crate*} dep-crates) (crate-item-macros lib) *item-macros*)]
          (swap! out conj {:path *crate* :file lib})
          (walk *crate* lib (.getParent (File. lib)) (fget (parse-file lib) :items) nil))))
    @out))

;; ---------------------------------------------------------------------------------------------
;; core's macro_rules! from its sources

(defn rel-path "A file of the copy of library/ as rustc's remapped path names it" [^String file]
  (if-let [m (re-find #"/(?:lib|library)/((core|alloc|std|std_detect|backtrace|stdarch|portable-simd|vendor)/.*)$" file)] (str "library/" (second m)) file))

(defn- foreign-spans
  "A macro definition's tokens with their spans written as places in FILE ((span FILE l1 c1 l2 c2 0)): the expansion
  takes them as foreign tokens with their definition's place"
  [x ^String file]
  (cond (vector? x) (if (and (= 4 (count x)) (every? number? x))
                      (list 'span file (nth x 0) (nth x 1) (nth x 2) (nth x 3) 0)
                      (mapv #(foreign-spans % file) x))
        (seq? x) (apply list (map #(foreign-spans % file) x))
        :else x))

(defn file-macros
  "The macro_rules! definitions of a file's items (inline modules' too, fn bodies' not): [[name def]], a macro 2.0's
  :def-site its module's path"
  [items ^String file & [path]]
  (let [acc (atom [])]
    (letfn [(walk [items mpath]
              (doseq [it items :let [k (fget it :kind)] :when (cfg-on? it)]
                (case (head k)
                  MacroDef (let [[_ idf md] k]
                             ;; macro_rules! and macros 2.0 (`pub(crate) macro const_eval_select { .. }`), not the builtins
                             (when (not (some #(= "rustc_builtin_macro" (attr-path-name %)) (fget it :attrs)))
                               (swap! acc conj [(second idf) (cond-> {:file file :body (foreign-spans (second (fget (fget md :body) :tokens)) (rel-path file))}
                                                               (not (fget md :macro_rules)) (assoc :def-site mpath))])))
                  Mod (let [mk (nth k 3)] (when (= 'Loaded (head mk)) (walk (second mk) (str mpath "::" (second (nth k 2))))))
                  nil)))]
      (walk items path))
    @acc))

(defn macro-table
  "name -> [{:file :body}] over the files"
  [files]
  (reduce (fn [m {:keys [file]}]
            (reduce (fn [m [nm d]] (update m nm (fnil conj []) d)) m (file-macros (fget (parse-file file) :items) file)))
          {} files))

(defn macros-for
  "The macro table as the expansion's std macros for a file: each name's definition from the nearest file (the same file
  excluded: the file's own are its user macros), by the longest common directory prefix"
  [table ^String file & [shadowed]]
  (into {} (for [[nm ds] table
                 :let [ds (remove #(= file (:file %)) ds)
                       ;; queue 561 (C6 L3): SHADOWED (a backtrace crate's run: std's macro names) drops a definition of such a
                       ;; name outside its textual scope (its module file's subtree): rustc-demangle's v0.rs `macro_rules! write`
                       ;; (a compile_error! guard) is not lib.rs' write!, core's is
                       ds (if (and shadowed (shadowed nm))
                            (remove (fn [{^String df :file}]
                                      (let [mdir (if (re-find #"/(lib|mod)\.rs$" df) (.getParent (File. df)) (subs df 0 (- (count df) 3)))]
                                        (not (str/starts-with? file (str mdir "/")))))
                                    ds)
                            ds)]
                 :when (seq ds)]
             (let [common (fn [^String a ^String b] (count (take-while true? (map = a b))))
                   ;; RF19: of the files equally near, the shallowest (num/mod.rs: `#[macro_use] mod uint_macros;`'s uint_impl!,
                   ;; not num/imp/int_bits.rs' private one, a module deeper that does not export it)
                   depth (fn [^String f] (count (filter #(= \/ %) f)))
                   best (apply max (map #(common file (:file %)) ds))
                   near (filter #(= best (common file (:file %))) ds)
                   shallow (apply min (map #(depth (:file %)) near))
                   d (last (filter #(= shallow (depth (:file %))) near))]
               [nm (cond-> {:name nm :arms (try (ex/macro-arms (ex/dump-tts->items (:body d) 0)) (catch Throwable _ []))}
                     (:def-site d) (assoc :def-site (:def-site d)))]))))


;; ---------------------------------------------------------------------------------------------
;; core's names from its sources (build_reduced_graph's definitions of each module, as the helper's --std-names writes
;; them: {MODULE {:kind K :children [{:ns :name :kind :path}]}}): the items written in the files, cfg evaluated, macros not
;; expanded (a macro's items stay std's interface's), imports not followed (re-exports stay the interface's)

(defn- item-name [k] (some #(when (and (seq? %) (= 'id (first %))) (second %)) (concat (rest k) (when (seq? (second k)) (rest (second k))))))

(defn- ctor-kind [data] (case (head data) Tuple "Fn" Unit "Const" nil))

(defn file-names
  "The definitions of a file's module PATH (and of its inline modules, enums and traits): {path {:kind :children}}"
  [items ^String path]
  (let [acc (atom {})
        add! (fn [m kind c] (swap! acc update m (fn [e] (-> (or e {:kind kind :children []}) (update :children conj c)))))]
    (letfn [(walk [items m]
              (swap! acc update m #(or % {:kind "Mod" :children []}))
              (doseq [it items :let [k (fget it :kind)] :when (and (seq? k) (cfg-on? it))]
                (let [nm (case (head k)
                           (Fn Const Static TyAlias Trait) (second (fget (second k) :ident))
                           (Struct Union Enum Mod) (second (nth k (if (= 'Mod (head k)) 2 1)))
                           nil)
                      p (when nm (str m "::" nm))]
                  (case (head k)
                    Fn (add! m "Mod" {:ns :value :name nm :kind "Fn" :path p})
                    Const (when (not= "_" nm) (add! m "Mod" {:ns :value :name nm :kind "Const { is_type_const: false }" :path p}))
                    Static (add! m "Mod" {:ns :value :name nm :path p
                                          :kind (str "Static { safety: Safe, mutability: " (if (= 'Mut (fget (second k) :mutability)) "Mut" "Not") ", nested: false }")})
                    TyAlias (add! m "Mod" {:ns :type :name nm :kind "TyAlias" :path p})
                    ;; queue 542 (C6): a foreign block's functions, statics and types in its module (libc's `read`, `syscall`)
                    ForeignMod (doseq [fi (fget (second k) :items) :let [fk (fget fi :kind)] :when (and (seq? fk) (cfg-on? fi))]
                                 (let [fnm (second (fget (second fk) :ident)) fp (str m "::" fnm)]
                                   (case (head fk)
                                     Fn (add! m "Mod" {:ns :value :name fnm :kind "Fn" :path fp})
                                     Static (add! m "Mod" {:ns :value :name fnm :path fp
                                                           :kind (str "Static { safety: Unsafe, mutability: " (if (= 'Mut (fget (second fk) :mutability)) "Mut" "Not") ", nested: false }")})
                                     TyAlias (add! m "Mod" {:ns :type :name fnm :kind "ForeignTy" :path fp})
                                     nil)))
                    (Struct Union) (do (add! m "Mod" {:ns :type :name nm :kind (str (head k)) :path p})
                                       (when-let [ck (and (= 'Struct (head k)) (ctor-kind (nth k 3)))]
                                         (add! m "Mod" {:ns :value :name nm :kind (str "Ctor(Struct, " ck ")") :path (str p "::{constructor#0}")})))
                    Enum (do (add! m "Mod" {:ns :type :name nm :kind "Enum" :path p})
                             (swap! acc update p #(or % {:kind "Enum" :children []}))
                             (doseq [v (fget (nth k 3) :variants) :when (cfg-on? v)]
                               (let [vn (second (fget v :ident)) vp (str p "::" vn)]
                                 (add! p "Enum" {:ns :type :name vn :kind "Variant" :path vp})
                                 (when-let [ck (ctor-kind (fget v :data))]
                                   (add! p "Enum" {:ns :value :name vn :kind (str "Ctor(Variant, " ck ")") :path (str vp "::{constructor#0}")})))))
                    Trait (do (add! m "Mod" {:ns :type :name nm :kind "Trait" :path p})
                              (swap! acc update p #(or % {:kind "Trait" :children []}))
                              (doseq [a (fget (second k) :items) :let [ak (fget a :kind)] :when (and (seq? ak) (cfg-on? a))]
                                (let [an (second (fget (second ak) :ident))]
                                  (case (head ak)
                                    Fn (add! p "Trait" {:ns :value :name an :kind "AssocFn" :path (str p "::" an)})
                                    Const (add! p "Trait" {:ns :value :name an :kind "AssocConst { is_type_const: false }" :path (str p "::" an)})
                                    Type (add! p "Trait" {:ns :type :name an :kind "AssocTy" :path (str p "::" an)})
                                    nil))))
                    Mod (do (add! m "Mod" {:ns :type :name nm :kind "Mod" :path p})
                            (let [mk (nth k 3)] (when (= 'Loaded (head mk)) (walk (second mk) p))))
                    ;; a re-export (`pub(crate) use self::index_range::IndexRange;`): its target by the written path, whose
                    ;; definitions with-core-names copies under the name (imports.rs' single imports, textually)
                    Use (letfn [(abs [segs]
                                  (let [[f & r] segs]
                                    (case f
                                      ("crate" "$crate") (into [*crate*] r)
                                      "self" (into (vec (str/split m #"::")) r)
                                      ;; round 54: each leading `super` one module up (`super::super::borrow` from btree::map::entry)
                                      "super" (let [ps (str/split m #"::") n (count (take-while #{"super"} segs))]
                                                (when (< n (count ps)) (into (vec (drop-last n ps)) (drop n segs))))
                                      ;; core's own path (core's `use core::..`), and alloc's (RIND9 (a): an extern crate's)
                                      ("core") (vec segs)
                                      ;; round 54: std's dependency alloc, by its name and its root's alias (`pub(crate) use
                                      ;; alloc_crate::io::{IoHandle, SpecReadByte, ..}`, io/mod.rs); queue 400: any dependency
                                      ;; of the crate (resolve's crate-deps: std's libc and hashbrown, hashbrown's alloc) and
                                      ;; its root's aliases (hashbrown's `extern crate alloc as stdalloc`)
                                      (cond (contains? (get resolve/crate-deps *crate*) f) (vec segs)
                                            (get (get resolve/root-extern-aliases *crate*) f) (into [(get (get resolve/root-extern-aliases *crate*) f)] r)
                                            ;; RFP52 (a): a uniform path's first name an item of the module (`use
                                            ;; unicode_data::alphabetic::lookup as Alphabetic`): core names no other crate
                                            (and f (re-matches #"[A-Za-z_][A-Za-z0-9_]*" f)) (into (vec (str/split m #"::")) segs)))))
                                (tree [t prefix]
                                  (let [segs (into prefix (map #(second (fget % :ident)) (fget (fget t :prefix) :segments)))
                                        kk (fget t :kind)]
                                    (case (head kk)
                                      Simple (let [rn (let [o (second kk)] (when (and (seq? o) (= 'Some (first o))) (second (second o))))
                                                   ;; round 54: `use super::map::{self, ..}` binds the module `map` (set/entry.rs' `use
                                                   ;; super::{SetValZST, map}` reads it from set)
                                                   self? (and (= "self" (last segs)) (> (count segs) 1))
                                                   segs (if self? (pop segs) segs)
                                                   target (abs segs) nm (or rn (last segs))]
                                               (when (and target (not= "self" (last segs)) (> (count target) 1))
                                                 (swap! acc update m (fn [e] (update (or e {:kind "Mod" :children []}) :reexports (fnil conj []) [nm (str/join "::" target)])))))
                                      Nested (doseq [x (fget kk :items)] (tree (if (= 'tuple (head x)) (second x) x) segs))
                                      ;; round 54 (RIND9 (a), std): a glob re-export (sys/pal/mod.rs' `pub use self::unix::*;`,
                                      ;; sys/fd's, sys/fs's), its module's names copied by with-core-names; std's alone (core's
                                      ;; and alloc's index as before, their private modules' globs left to std's names)
                                      Glob (when (std-like? *crate*)
                                             (when-let [target (abs segs)]
                                               (when (> (count target) 1)
                                                 (swap! acc update m (fn [e] (update (or e {:kind "Mod" :children []}) :globs (fnil conj []) (str/join "::" target)))))))
                                      nil)))]
                          (tree (second k) []))
                    nil))))]
      (walk items path))
    @acc))

(defn crate-index
  "core's macro table and names over its (non-vendored) module files"
  [files]
  ;; queue 400: a vendored dependency's item macros (libc's prelude!()) read where they are called
  (binding [*item-macros* (if-let [root (and (some #{*crate*} dep-crates) (:file (first (filter #(= *crate* (:path %)) files))))]
                            (crate-item-macros root) *item-macros*)]
  (reduce (fn [acc {:keys [file path]}]
            (let [items (fget (parse-file file) :items)]
              (-> acc
                  (update :macros (fn [m] (reduce (fn [m [nm d]] (update m nm (fnil conj []) d)) m (file-macros items file path))))
                  (update :names (fn [n] (merge-with (fn [a b] (cond-> (-> a (update :children into (:children b)) (update :reexports (fnil into []) (:reexports b)))
                                                                    ;; queue 400: a module's globs from each of its files (libc's cfg_if arms)
                                                                    (:globs b) (update :globs (fnil into []) (:globs b)))) n (file-names items path)))))))
          {:macros {} :names {}} files)))

(defn with-core-names
  "std's names with core's own definitions added where the interface lacks them (its private items), then its re-exports'
  targets under their names"
  [std-names names]
  (let [add (fn [m p kind children]
              (let [e (get m p {:kind kind :children []})
                    have (set (map (juxt :ns :name) (:children e)))]
                (assoc m p (update e :children into (remove #(have [(:ns %) (:name %)]) children)))))
        m (reduce (fn [m [p {:keys [kind children]}]] (add m p kind children)) std-names names)
        ;; queue 400: a module path through a module's renamed import (sys/fs/mod.rs' `use unix as imp; pub use imp::{File,
        ;; ..}`: std::sys::fs::imp is std::sys::fs::unix), each segment the type namespace's module child of the one before;
        ;; std's and its dependencies' alone (core's and alloc's index as before)
        module-of (fn [m ^String path]
                    (if (or (contains? m path) (not (std-like? *crate*)))
                      path
                      (let [[r & segs] (str/split path #"::")]
                        (or (reduce (fn [cur sg]
                                      (if-let [c (some #(when (and (= :type (:ns %)) (= sg (:name %)) (= "Mod" (:kind %))) %) (:children (get m cur)))]
                                        (:path c) (reduced nil)))
                                    r segs)
                            path))))
        reexport (fn [m]
                   (reduce (fn [m [p {:keys [reexports]}]]
                             (reduce (fn [m [nm target]]
                                       (let [i (.lastIndexOf ^String target "::")
                                             parent (module-of m (subs target 0 i)) tn (subs target (+ i 2))
                                             defs (filter #(= tn (:name %)) (:children (get m parent)))]
                                         (if (seq defs) (add m p "Mod" (mapv #(assoc % :name nm) defs)) m)))
                                     m reexports))
                           m names))
        ;; round 54: a glob re-export's module's names, under the module's own (add keeps the module's own first)
        glob (fn [m]
               (reduce (fn [m [p {:keys [globs]}]]
                         (reduce (fn [m target] (if-let [e (get m (module-of m target))] (add m p "Mod" (:children e)) m)) m globs))
                       m names))
        globs? (some :globs (vals names))
        ;; queue 542: the glob re-exports kept as the map's metadata (with-value-names adds a macro-made item to the modules
        ;; that glob its module)
        gm (merge (:globs (meta std-names)) (into {} (for [[p {:keys [globs]}] names :when (seq globs)] [p (vec globs)])))]
    (vary-meta
    ;; two rounds: a re-export of a re-export (with globs, three rounds of both: sys::fs's `pub use unix::*` of a re-export;
    ;; queue 400: then on to a fixpoint, at most 8: libc's chain of globs, libc -> unix -> linux_like -> linux -> musl -> b64
    ;; -> x86_64)
    (if globs?
      (loop [m (reduce (fn [m _] (glob (reexport m))) m [1 2 3]) n 3]
        (let [m2 (glob (reexport m))] (if (or (= m2 m) (>= n 8)) m2 (recur m2 (inc n)))))
      (reduce (fn [m _] (reexport m)) m [1 2]))
    assoc :globs gm)))

(defn- add-globbed
  "queue 542: CHILD (a {:ns :name :kind :path}) added to the module MP of the names M unless it has one of that namespace and
  name, then to the modules that glob MP (with-core-names' :globs metadata), to a fixpoint"
  ([m mp child] (add-globbed m mp child 0))
  ([m mp child depth]
   (let [e (get m mp)]
     (if (or (nil? e) (not= "Mod" (:kind e)) (> depth 8)
             (some #(and (= (:ns child) (:ns %)) (= (:name child) (:name %))) (:children e)))
       m
       (reduce (fn [m q] (add-globbed m q child (inc depth)))
               (assoc m mp (update e :children conj child))
               (for [[q gs] (:globs (meta m)) :when (some #{mp} gs)] q))))))

(defn with-adt-names
  "RF20: the names with core's structs as their modules' children where missing: the type and its constructor
  (`casemappingiter_impls!`'s `ToLowercase` in char/mod.rs: a macro made it, so core's index, read from the sources
  unexpanded, lacks its constructor, which std's names omit too, private to its module): from ADTS (std's interface's or
  the native interface's), each a struct of core with a constructor"
  [names adts]
  (reduce (fn [m [p a]]
            (let [i (.lastIndexOf ^String p "::") mp (when (pos? i) (subs p 0 i)) nm (when (pos? i) (subs p (+ i 2)))
                  e (when mp (get m mp)) ck (:ctor (first (:variants a)))
                  has? (fn [ns] (some #(and (= ns (:ns %)) (= nm (:name %))) (:children e)))]
              (if (or (nil? e) (not= "Struct" (:kind a)) (not (str/starts-with? p (str *crate* "::"))))
                m
                ;; (queue 542: and in the modules that glob its module, as with-core-names' globs took the index's names:
                ;; libc's `s! { pub struct sockaddr .. }` in linux_like, which unix's `pub use self::linux_like::*` re-exports)
                (cond-> (add-globbed m mp {:ns :type :name nm :kind "Struct" :path p})
                  ck (add-globbed mp {:ns :value :name nm :kind (str "Ctor(Struct, " ck ")") :path (str p "::{constructor#0}")})))))
          names adts))

(defn with-value-names
  "queue 542 (C6): the names with the crate's macro-made free functions and constants as their modules' children where missing
  (sys/path/unix.rs' `path_separator_bytes!(b'/')`: `is_sep_byte`, `SEPARATORS`, which the index, read unexpanded, lacks, so
  path.rs' `use crate::sys::path::is_sep_byte` through sys/path's `pub use unix::*` did not resolve): from the native
  interface's :fns and :consts, each a module's own item (an impl's or a function's nested items are not a module's children)"
  [names native]
  (let []
    (reduce (fn [m [p kind]]
              (let [i (.lastIndexOf ^String p "::") mp (when (pos? i) (subs p 0 i)) nm (when (pos? i) (subs p (+ i 2)))]
                (if (or (nil? mp) (not (str/starts-with? p (str *crate* "::"))) (str/includes? nm "{"))
                  m
                  (add-globbed m mp {:ns :value :name nm :kind kind :path p}))))
            names
            (concat (for [[p _] (:fns native)] [p "Fn"])
                    (for [[p _] (:consts native)] [p "Const { is_type_const: false }"])))))

(defn with-native-names [names native] (with-value-names (with-adt-names names (:adts native)) native))

(defn with-native-std
  "RF20: std's names with the native interface's type aliases (their types and generics) added, and its macro-made
  structs (with-native-names)"
  [std native]
  (cond-> (-> (update std :mods with-native-names native)
              ;; queue 542: the kinds of the native interface's ADTs and aliases where std's names lack them (a dependency's
              ;; macro-made `s! { pub struct iovec .. }`, named through another module: collect's ext-kind had none, and the
              ;; foreign functions naming it, libc's writev, had no fact)
              (update :kinds (fn [k] (merge (into {} (concat (for [[p a] (:adts native) :when (:kind a)] [p (:kind a)])
                                                             (for [[p _] (:aliases native)] [p "TyAlias"])))
                                            k))))
    (seq (:aliases native)) (-> (update :aliases #(merge (:aliases native) %))
                                (update :generics #(merge (:alias-generics native) %)))
    ;; queue 512 (503-1): and its crate-private traits' generics (cmp/bytewise.rs' BytewiseEq<Rhs = Self>), where std's names
    ;; have none: a bound naming one (`A: [const] BytewiseEq<B>`, slice::cmp's SlicePartialEq specialization) lowers its trait
    ;; ref with Self and its arguments (ext-generics; it was `(trait "..BytewiseEq" [])`), as the run's with-extra-iface does
    (seq (:traits native)) (update :generics #(merge (into {} (for [[p m] (:traits native) :when (seq (:generics m))] [p (vec (:generics m))])) %))))

(defn with-core-kinds
  "RF20: std's names' kinds (collect's ext-kind) with core's own definitions' added where std's lack them (a crate-private
  trait and its items: `clone::uninit::CopySpec::clone_one` an AssocFn of a Trait, so a qualified path to it prints as
  `<T as clone::uninit::CopySpec>::clone_one`)"
  [std names]
  (update std :kinds
          (fn [kinds]
            (reduce (fn [k [p {:keys [kind children]}]]
                      (reduce (fn [k c] (if (or (contains? k (:path c)) (nil? (:kind c))) k (assoc k (:path c) (:kind c))))
                              (if (or (contains? k p) (nil? kind)) k (assoc k p kind))
                              children))
                    kinds names))))

;; ---------------------------------------------------------------------------------------------
;; core's interface from its own sources: each module's functions and ADTs that std's interface lacks (its private items:
;; `pub(crate) fn check_language_ub`, `struct IndexRange`), written in the helper's --std-iface forms from our collection
;; (generics_of, fn_sig, predicates_of, the fields' types) as each module is processed, and read by the modules after it
;; (and by the next run: the cache native-iface.edn)

(def ^:dynamic *late-sig*
  "RF20: while a function's signature is written, an atom [NAMED-LATE-COUNT {ANON-ID INDEX}]: its late-bound regions as the
  helper writes them (`'^#N` an anonymous one, its bound variable's index after the named ones; `'^'a` a named one), not erased"
  nil)

(def ^:dynamic *clause-binder*
  "RIND9 (a): while a where clause is written, the count of its binder's named regions (`for<'a>`): its bound variables as
  the helper writes them (`'^'a` a named one, `'^#N` an anonymous one, Fn sugar's elided `&T`, its index after the named
  ones: `F: FnMut(&T, &T)`'s `'^#0`, `'^#1`), not erased"
  nil)

(def ^:dynamic *inner-depth*
  "RIND9 (a): inside a type's own binder (a trait object's, a fn pointer's) its depth, 2 for the first: the binder's bound
  variables as the helper writes them, one `^` a level (`Box<dyn Fn(&T)>`'s `'^^#0`); nil outside"
  nil)

(defn- region-name [r]
  (case (first r)
    :re-static "'static"
    :re-early (nth r 2)
    :re-bound (cond ;; C4 (2026-11-22): a fn pointer type's own anonymous variable (collect's :fn-binder, queue 493: [:re-bound nil
                    ;; :inner N]), bound by the fn pointer's binder: `'^^#N` in a struct field (ArgumentType's formatter, OsFunctions)
                    ;; (in a signature, sig-sty's *late-sig*, the helper writes such a region `'_`: alloc's convert_while_ascii)
                    (and (nil? (second r)) (= :inner (nth r 2 nil)) (number? (nth r 3 nil)) (nil? *late-sig*))
                    (str "'" (apply str (repeat (long (or *inner-depth* 2)) "^")) "#" (nth r 3))
                    (and *inner-depth* (nil? (second r)) (number? (nth r 2 nil)))
                    (str "'" (apply str (repeat *inner-depth* "^")) "#" (dec (long (nth r 2))))
                    (and *inner-depth* (= :for (nth r 2 nil)) (string? (second r))) (str "'" (apply str (repeat *inner-depth* "^")) (second r))
                    (and *clause-binder* (nil? (second r)) (number? (nth r 2 nil))) (str "'^#" (+ (long *clause-binder*) (dec (long (nth r 2)))))
                    (and *clause-binder* (= :for (nth r 2 nil)) (string? (second r))) (str "'^" (second r))
                    (nil? *late-sig*) "'_"
                    (= :anon (nth r 2 nil)) (let [[n m] @*late-sig* id (nth r 3)]
                                              (str "'^#" (or (get m id) (let [k (+ (long n) (count m))] (swap! *late-sig* assoc-in [1 id] k) k))))
                    (and (= 2 (count r)) (string? (second r)) (not= "'_" (second r))) (str "'^" (second r))
                    :else "'_")
    "'_"))

(declare ty->sty clause->sty*)

(defn- sig-sty
  "RF20: a function's inputs and output as the helper writes them, its late-bound regions bound ([INS OUT])"
  [id sig path-of]
  (binding [*late-sig* (atom [(count (:late (collect/generics-of id))) {}])]
    (let [ins (mapv #(ty->sty % path-of) (:inputs sig))]
      [ins (ty->sty (:output sig) path-of)])))

;; C4 (2026-11-22): a pattern type (`pattern_type!(u8 is 1..)`, collect's [:pat TY TEXT]) as the helper writes it, rustc's Display of
;; ty::Pat: (text "(u8) is 1..=core::::num::niche_types::NonZeroU8Inner::{constant#0}"). rustc_ast_lowering makes each written end
;; of a range an anonymous constant of the field (`STRUCT::FIELD::{constant#K}`, in order) and each missing end one of the struct
;; (`STRUCT::{constant#K}`: the type's MIN or MAX); an exclusive end is its constant's body `sub_one(END)`. Printed: a literal end
;; written inclusive by its value (an end at the type's MAX as an open `..`), any other end by its constant's path; an or-pattern in
;; parentheses; `!null` as written. *pat-owner* is [ADT-PATH FIELD] while a struct field's type is written.
(def ^:dynamic *pat-owner* nil)

(defn- pat-text [inner pat]
  (let [ty-name (collect/print-ty inner)
        alts (str/split (str/replace (str pat) #"\s+" "") #"\|")
        [adt field] *pat-owner*
        root (fn [p] (let [[c r] (str/split (str p) #"::" 2)] (str c "::::" r)))
        sk (atom -1) fk (atom -1)
        sconst (fn [] (str (root adt) "::{constant#" (swap! sk inc) "}"))
        fconst (fn [] (str (root adt) "::" field "::{constant#" (swap! fk inc) "}"))
        int-lit (fn [x] (when-let [[_ neg body] (re-matches #"(-?)((?:0x[0-9a-fA-F_]+)|(?:[0-9][0-9_]*))(?:[iu](?:8|16|32|64|128|size))?" x)]
                          (let [b (str/replace body "_" "")
                                v (if (str/starts-with? b "0x") (bigint (java.math.BigInteger. (subs b 2) 16)) (bigint b))]
                            (if (= "-" neg) (- v) v))))
        char-lit (fn [x] (when-let [[_ c] (re-matches #"'(.*)'" x)]
                           (if-let [[_ h] (re-matches #"\\u\{([0-9a-fA-F]+)\}" c)] (Long/parseLong h 16) (when (= 1 (count c)) (long (int (first c)))))))
        lit (fn [x] (or (int-lit x) (char-lit x)))
        show (fn [v] (if (= [:char] inner)
                       (let [c (long v)] (if (and (<= 0x20 c 0x7e) (not (#{0x27 0x5c} c))) (str "'" (char c) "'") (str "'\\u{" (Long/toHexString c) "}'")))
                       (str v)))
        tmax (case (first inner)
               :char 0x10FFFF
               (:int :uint) (let [t (second inner) n (if (str/ends-with? t "size") 64 (parse-long (subs t 1)))]
                              (dec (reduce * 1N (repeat (if (= :int (first inner)) (dec n) n) 2N))))
               nil)
        one (fn [a]
              (if (= a "!null")
                "!null"
                (let [i (str/index-of a "..")
                      incl (and i (= \= (get a (+ i 2))))
                      st (when i (subs a 0 i)) en (when i (subs a (+ i (if incl 3 2))))]
                  (when-not i (throw (ex-info "pattern" {})))
                  (let [s-txt (if (str/blank? st) (sconst) (let [v (lit st)] (do (fconst) (if v (show v) (throw (ex-info "pattern start" {}))))))
                        e-txt (cond (str/blank? en) (str "..=" (sconst))
                                    (and incl (lit en)) (do (fconst) (if (and tmax (= (bigint (lit en)) (bigint tmax))) ".." (str "..=" (show (lit en)))))
                                    :else (str "..=" (fconst)))]
                    (str s-txt e-txt)))))
        body (if (= 1 (count alts)) (one (first alts)) (str "(" (str/join " | " (map one alts)) ")"))]
    (when (and (some #(not= % "!null") alts) (nil? adt)) (throw (ex-info "pattern without its owner" {})))
    (str "(" ty-name ") is " body)))

(defn ty->sty
  "A type as the helper's structural form (sty->ty's inverse); PATH-OF gives a local definition's interface path; nil
  when the type has a part the interface does not write (a closure, an opaque type, an inference variable)"
  [t path-of]
  (letfn [(d [x] (if (number? x) (or (path-of x) (throw (ex-info "local" {}))) x))
          (s [t]
            (case (first t)
              :bool (list 'prim "bool") :char (list 'prim "char") :str (list 'prim "str") :never (list 'never)
              (:int :uint :float) (list 'prim (second t))
              :param (list 'param (nth t 1) (nth t 2))
              ;; round 52: a const parameter as a generic argument (`BoxedArrayIntoIter<T, N, A>`), as the helper writes it
              :cparam (list 'cparam (nth t 1) (nth t 2))
              ;; C4 (2026-11-22): a const generic argument's value (char's `EscapeIterInner<10, AlwaysEscaped>`), as the helper writes
              ;; it: (const "10")
              :cval (list 'const (str (second t)))
              ;; C4 (2026-11-22): an extern type (`extern "Rust" { type VTable; }`) as the helper prints it, by its visible path
              ;; through std (DynMetadata's `NonNull<VTable>`: (text "std::ptr::metadata::VTable"))
              :adt (if (and (number? (second t)) (= "ForeignTy" (:kind (collect/def-of (second t)))))
                     (list 'text (str/replace-first (d (second t)) #"^core::" "std::"))
                     (list 'adt (d (second t)) (mapv s (nth t 2))))
              :ref (list 'ref (region-name (nth t 1)) (boolean (nth t 2)) (s (nth t 3)))
              :ptr (list 'ptr (boolean (nth t 1)) (s (nth t 2)))
              :slice (list 'slice (s (second t)))
              :array (list 'array (s (nth t 1)) (let [c (nth t 2)] (case (first c) :cval (second c) :cparam (list 'cparam (nth c 1) (nth c 2)) (throw (ex-info "const" {})))))
              :tuple (list 'tuple (mapv s (second t)))
              ;; C4: a pattern type, its text (pat-text)
              :pat (list 'text (pat-text (nth t 1) (nth t 2)))
              :proj (list 'projection (d (nth t 1)) (mapv s (nth t 2)))
              :fnptr (binding [*inner-depth* (inc (long (or *inner-depth* 1)))] (list 'fnptr (mapv s (:inputs (second t))) (s (:output (second t)))))
              ;; RIND9 (a): a trait object as the helper writes it: (dyn (trait P ARGS) [(proj ITEM ARGS TERM)] [AUTOS] REGION),
              ;; Self out of the arguments, the auto traits in rustc's order (Sync before Send), an anonymous region `'_`
              :dyn (let [{:keys [principal projections autos]} (nth t 1) r (nth t 2)
                         inner (binding [*inner-depth* (inc (long (or *inner-depth* 1)))]
                                 [(when principal (list 'trait (d (first principal)) (mapv s (second principal))))
                                  (vec (for [[ad args term] projections] (list 'proj (d ad) (mapv s args) (s term))))])]
                     (list 'dyn (first inner) (second inner)
                           (vec (sort-by (fn [p] [(get {"core::marker::Sync" 0 "core::marker::Send" 1} p 2) p]) (map d autos)))
                           ;; C4 (2026-11-22): a named late-bound region by its name (the helper prints the object's region by
                           ;; Display: create_formatter's `&'a mut (dyn Write + 'a)`, (dyn .. "'a") in a `'^'a` reference)
                           (cond (and (= :re-bound (first r)) (= :anon (nth r 2 nil))) "'_"
                                 (and (= :re-bound (first r)) (string? (second r)) (not= "'_" (second r)) (not= :for (nth r 2 nil))) (second r)
                                 :else (region-name r))))
              ;; queue 417: std's return-position impl Trait (io/stdio.rs' `fn as_mut_buf(&mut self) -> &mut BufReader<impl
              ;; Read>`) as the helper writes it: (opaque "FN::{opaque#N}" ARGS), ARGS the function's generics at their
              ;; identity, then the lifetimes the opaque type captures (edition 2024: every one in scope), the early ones
              ;; in order, then the signature's late-bound ones (`'^#N`); a named late-bound one not written (nil); std's
              ;; alone (core's, alloc's and the dependencies' passes as before)
              :opaque (let [[_ _ id args] t]
                        (when-not (and id (= "std" *crate*) *late-sig* (zero? (long (first @*late-sig*))))
                          (throw (ex-info "opaque" {})))
                        (list 'opaque (d id)
                              (vec (concat (map s args)
                                           (for [a args :when (= :re-early (first a))] (list 'lt (region-name a)))
                                           (for [k (range (count (second @*late-sig*)))] (list 'lt (str "'^#" k)))))))
              ;; queue 417: std's type alias of an impl Trait (collect's [:free-alias ALIAS ARGS], *free-aliases*:
              ;; backtrace.rs' `LazyResolve`, sys/paths/unix.rs' `SplitPaths<'a>`) as the helper writes it, its text:
              ;; (text "PATH<ARGS>"), lifetimes its arguments
              :free-alias (let [[_ a args] t
                                as (for [x args] (if (collect/region? x) (region-name x) (throw (ex-info "free-alias arg" {}))))]
                            (list 'text (str (d a) (when (seq as) (str "<" (str/join ", " as) ">")))))
              (if (collect/region? t) (list 'lt (region-name t)) (throw (ex-info "kind" {})))))]
    (try (s t) (catch Throwable _ nil))))

(defn- for-names
  "RIND9 (a): the named regions a clause's `for<...>` binds ([:re-bound NAME :for]), distinct"
  [c]
  (let [acc (java.util.LinkedHashSet.)]
    (letfn [(walk [x] (cond (and (vector? x) (= :re-bound (first x)) (= :for (nth x 2 nil))) (.add acc (second x))
                            (or (vector? x) (seq? x)) (doseq [y x] (walk y))
                            (map? x) (doseq [y (vals x)] (walk y))
                            :else nil))]
      (walk c))
    (count acc)))

(defn- clause->sty [c path-of]
  (binding [*clause-binder* (for-names c)]
    (clause->sty* c path-of)))

(defn- clause->sty* [c path-of]
  (case (first c)
    :trait (let [[tr args] (second c) p (if (number? tr) (path-of tr) tr) as (mapv #(ty->sty % path-of) args)]
             (when (and p (every? some? as)) (list 'trait p as)))
    ;; RF20: a projection clause (`I: Iterator<Item: Try<Output = T>>`'s `<<I as Iterator>::Item as Try>::Output == T`), as
    ;; the helper writes it: (proj ITEM [ARGS] TERM)
    :proj (let [[_ ad args term] c p (if (number? ad) (path-of ad) ad) as (mapv #(ty->sty % path-of) args) tt (ty->sty term path-of)]
            (when (and p (every? some? as) tt) (list 'proj p as tt)))
    ;; RIND9 (a): `E: 'a` as the helper writes it; `'b: 'a` and a const parameter's type (ConstArgHasType) as its (other TEXT)
    :type-outlives (when-let [t (ty->sty (second c) path-of)] (list 'type-outlives t (region-name (nth c 2))))
    :region-outlives (list 'other (str (region-name (second c)) ": " (region-name (nth c 2))))
    ;; C4 (2026-11-22): core's own type there by its visible path through std, as the helper prints it ("the constant `ORD` has
    ;; type `std::intrinsics::AtomicOrdering`", the atomic intrinsics)
    :const-has-type (let [t (nth c 2)]
                      (list 'other (if (and (= "core" *crate*) (vector? t) (= :adt (first t)) (number? (second t)))
                                     (str "the constant `" (collect/print-const (second c)) "` has type `std::" (collect/print-ty t) "`")
                                     (#'collect/print-clause c))))
    nil))

(defn- generics-sty
  ([g] (generics-sty g nil nil))
  ;; round 52: with the definition, a type parameter's default as the helper writes it, (type "A" (adt "alloc::alloc::Global" []))
  ([g id path-of]
   (let [ds (if id (collect/param-defaults id) {})]
     (vec (for [p (:params g)]
            (case (:kind p)
              :lifetime (list 'lifetime (:name p))
              :const (list 'const (:name p))
              (if-let [t (some-> (get ds (:name p)) (ty->sty path-of))] (list 'type (:name p) t) (list 'type (:name p)))))))))

;; C4 (2026-11-22): `#[unstable_feature_bound(f128)]`'s predicate as the helper prints it (rustc 1.99's ClauseKind::UnstableFeature,
;; "feature(f128) is enabled"), after the written ones: convert::num's 17 f16/f128 From impls and their kin
(defn- feature-bound-preds [node]
  (vec (for [a (:attrs node) :let [u (:unparsed a)] :when (and u (str/starts-with? u "unstable_feature_bound"))
             f (some-> (re-find #"\((.*)\)" u) second (str/split #","))]
         (list 'other (str "feature(" (str/trim f) ") is enabled")))))

;; C4 (2026-11-22): a function's own attribute (`#[rustc_nounwind]`, `#[rustc_promotable]`), as lowered (:unparsed's text)
(defn- own-attr? [node nm]
  (boolean (some #(when-let [u (:unparsed %)] (= nm (first (str/split u #"[ (=]")))) (:attrs node))))

(defn- own-attr-value
  "queue 542: an attribute's string value (`#[link_name = \"realname\"]`), else nil"
  [node nm]
  (some #(when-let [u (:unparsed %)] (when (= nm (first (str/split u #"[ (=]"))) (:eq-str %))) (:attrs node)))

;; C4 (2026-11-22): an enum's discriminant type and its variants' discriminants, as the helper writes them (tools/rsdump/front.rs:
;; `a.repr().int`'s type, else nil; `a.discriminants(tcx)`'s Display): rustc_middle's AdtDef::discriminants, an explicit
;; discriminant's value (its anonymous constant evaluated: literals, `-`, `<<`, `|`, the crate's integer constants), else the
;; previous one's plus one, from 0; each wrapped to the discriminant type (`repr(int)`, else isize) and printed signed for a
;; signed type (Discr's Display). Before, every native enum was `:repr nil :discrs [0 1 ..]`: Ordering's `#[repr(i8)]` -1 0 1 and
;; AlignmentEnum's `#[repr(usize)]` 1 2 4 .. lost (Alignment a byte, the switch run's Transmute from usize refused)
(defn- disr-value [x]
  (case (:kind x)
    :unary (when (= "-" (:op x)) (some-> (disr-value (:expr x)) -))
    :binary (let [a (disr-value (:lhs x)) b (disr-value (:rhs x))]
              (when (and a b)
                (case (:op x) "+" (+ a b) "-" (- a b) "*" (* a b) "<<" (.shiftLeft (biginteger a) (int b)) ">>" (.shiftRight (biginteger a) (int b))
                      "|" (.or (biginteger a) (biginteger b)) "&" (.and (biginteger a) (biginteger b)) "^" (.xor (biginteger a) (biginteger b))
                      "/" (when-not (zero? b) (quot a b)) "%" (when-not (zero? b) (rem a b)) nil)))
    (:paren :group) (some-> (:expr x) disr-value)
    ;; queue 561 (C6 L3): a backtrace crate's cast discriminant (miniz_oxide's TINFLStatus `Done = TINFL_STATUS_DONE as i8`),
    ;; the operand's value, wrapped to the enum's repr by enum-repr-discrs
    :cast (when (some #{*crate*} backtrace-crates) (disr-value (:expr x)))
    ;; and a constant of the module by its name (`TINFL_STATUS_DONE`, `const TINFL_STATUS_DONE: i32 = 0;`), its expression's value
    :path (or (collect/const-int-value x)
              (when (and (some #{*crate*} backtrace-crates) (= 1 (count (:segs (:path x)))))
                (let [nm (str (:ident (first (:segs (:path x)))))
                      d (some #(when (and (str/starts-with? (str (:kind %)) "Const") (= nm (str (second (:data %))))) %) (collect/defs))]
                  (some-> d :node :expr disr-value))))
    (collect/const-int-value x)))

(defn- enum-repr-discrs
  "C4: {:repr INT-OR-NIL :discrs [D ...]} of an enum's node and its variants' nodes in order (the helper's front.rs facts)"
  [node variant-nodes]
  (let [ints #"[iu](?:8|16|32|64|128|size)"
        repr (some #(re-matches ints %) (mapcat (fn [a] (filter string? (:toks a))) (:attrs node)))
        t (or repr "isize")
        bits (if (str/ends-with? t "size") 64 (parse-long (subs t 1)))
        signed? (str/starts-with? t "i")
        m (.shiftLeft java.math.BigInteger/ONE (int bits))
        wrap (fn [v] (let [r (.mod (biginteger v) m)]
                       (bigint (if (and signed? (.testBit r (int (dec bits)))) (.subtract r m) r))))
        ds (loop [vs variant-nodes prev nil acc []]
             (if-let [v (first vs)]
               (let [x (:disr v)
                     d (if x
                         (or (try (disr-value x) (catch Throwable _ nil)) (reduced nil))
                         (if prev (inc prev) 0))]
                 (if (reduced? d) nil (recur (rest vs) (wrap d) (conj acc (wrap d)))))
               acc))]
    ;; an explicit discriminant not evaluated here: nil, and the enum is not written (a missing fact, not a wrong one)
    (when ds {:repr repr :discrs (mapv #(if (<= Long/MIN_VALUE % Long/MAX_VALUE) (long %) %) ds)})))

(defn native-iface
  "The module's functions and ADTs (not impls' items) as {:fns {path form} :adts {path form}}, those std's interface lacks"
  [path si]
  (let [lp @collect/*local-paths*
        rev (into {} (for [[p id] lp] [id p]))
        ;; RIND9 (a): a definition inside a body (local-paths names none) by its def path, as rustc's interface writes it:
        ;; a body's impl `{impl#N}` among its parent's impls, under the function's own path
        ;; (`alloc::slice::{impl#0}::to_vec_in::{impl#0}::to_vec::{impl#0}`, Drop for to_vec's `DropGuard`)
        body-path (fn body-path [id]
                    (or (get rev id)
                        (let [d (collect/def-of id)]
                          (case (first (:data d))
                            :crate resolve/*crate-path*
                            (:type :value) (some-> (body-path (:parent d)) (str "::" (second (:data d))))
                            :impl (when (some? (:disamb d)) (some-> (body-path (:parent d)) (str "::{impl#" (:disamb d) "}")))
                            nil))))
        ;; a body's ADT named by its def path (an impl's self type); its traits, functions and the ADT's own fact not
        path-of (fn [id] (or (get rev id)
                             ;; queue 498: and a body's trait (to_vec_in's `ConvertVec`, its impls' trait)
                             (when (and (number? id) (#{"Struct" "Enum" "Union" "Trait"} (str (:kind (collect/def-of id))))) (body-path id))
                             ;; queue 417: a return-position impl Trait by its def path, `FN::{opaque#N}`
                             (when (and (number? id) (= "OpaqueTy" (:kind (collect/def-of id))))
                               (let [od (collect/def-of id)] (some-> (body-path (:parent od)) (str "::{opaque#" (:disamb od) "}"))))))]
    (reduce
     (fn [acc d]
       ;; C6-4 (a): an ADT defined inside a function's body (btree::mem::replace's `PanicGuard`, flush_buf's `BufGuard`) by its
       ;; def path, as rustc's interface names it; local-paths names module items alone
       (let [p (or (get rev (:id d))
                   ;; queue 498: a function defined inside a body (raw_vec's `RawVecInner::reserve`'s `do_reserve_and_handle`) by
                   ;; its def path, as an impl inside a body is: its signature written, so that a call of it prints as rustc's
                   ;; (`for<'a> unsafe fn(..) {..::reserve::do_reserve_and_handle::<Global>}`, not `{no sig ..}`)
                   ;; and a trait defined inside a body (to_vec_in's `ConvertVec`), its items and signatures
                   (when (#{"Struct" "Enum" "Union" "Fn" "Trait"} (str (:kind d))) (body-path (:id d))))]
         (try
           (cond
             ;; RFP52 (a): an impl the interface lacks (an inherent impl of crate-private methods: `IndexRange`'s `start`,
             ;; a crate-private type's trait impl: `NeverShortCircuit`'s Try), its items and its functions' signatures, at
             ;; its `{impl#N}` path in its module
             (and (str/starts-with? (str (:kind d)) "Impl") (some? (:disamb d)))
             (let [mp (body-path (:parent d))
                   ip (str mp "::{impl#" (:disamb d) "}")]
               (if (or (nil? mp) (get (:impls si) ip))
                 acc
                 (let [g (collect/generics-of (:id d))
                       [self-ty tr] (collect/impl-header (:id d))
                       self (ty->sty self-ty path-of)
                       trs (when tr (let [tp (if (number? (first tr)) (path-of (first tr)) (first tr))
                                          as (mapv #(ty->sty % path-of) (second tr))]
                                      (when (and tp (every? some? as)) (list 'trait tp as))))
                       kids (filter #(= (:id d) (:parent %)) (collect/defs))
                       items (vec (for [k kids :let [n (second (:data k)) kp (str ip "::" n) kk (str (:kind k))]]
                                    (cond (= "AssocTy" kk) [n "AssocTy" kp (ty->sty (collect/type-of (:id k)) path-of)]
                                          (= "AssocFn" kk) [n "AssocFn" kp nil]
                                          :else [n kk kp (ty->sty (collect/type-of (:id k)) path-of)])))
                       fns (into {} (for [k kids :when (= "AssocFn" (:kind k))
                                          :let [kg (collect/generics-of (:id k)) sig (collect/fn-sig (:id k))
                                                [ins out] (sig-sty (:id k) sig path-of)]
                                          :when (and (every? some? ins) out (not (get (:fns si) (str ip "::" (second (:data k))))))]
                                      [(str ip "::" (second (:data k)))
                                       (cond-> {:generics (generics-sty kg) :parent-count (count (:params g)) :has-self false
                                        :predicates (vec (keep #(clause->sty % path-of) (collect/explicit-clauses (:id k))))
                                        :inputs ins :output out :variadic false :safety (if (= :unsafe (:safety sig)) "Unsafe" "Safe")
                                        :abi (str "\"" (or (:abi sig) "Rust") "\"") :const (or (= :const (get-in (:node k) [:header :constness])) (= :const (:constness (:node d)))
                                                                                   ;; C4: `#[rustc_comptime]` (TypeId's trait_info_of)
                                                                                   (own-attr? (:node k) "rustc_comptime"))
                                        ;; C4: rustc's is_promotable_const_fn (a const fn's #[rustc_promotable])
                                        :promotable (and (or (= :const (get-in (:node k) [:header :constness])) (= :const (:constness (:node d))))
                                                         (own-attr? (:node k) "rustc_promotable"))
                                        ;; queue 472: an associated function without a self parameter (fn_has_self_parameter
                                        ;; false: `Box::as_mut_ptr(b: &mut Self)`), which method lookup must not take
                                        ;; C4: NEVER_UNWIND, `#[rustc_nounwind]` (codegen_fn_attrs, the helper's :nounwind)
                                        :nounwind (own-attr? (:node k) "rustc_nounwind") :native true}
                                       (and (contains? (:node k) :params) (not (collect/fn-self-param? (:node k)))) (assoc :self-param false))]))]
                   (if (and self (or (nil? tr) trs))
                     (-> acc
                         (assoc-in [:impls ip] {:trait trs :negative (boolean (get-in (:node d) [:of-trait :negative])) :self self :generics (generics-sty g) :parent-count 0
                                                :has-self false :predicates (into (vec (keep #(clause->sty % path-of) (collect/explicit-clauses (:id d))))
                                                                                  (feature-bound-preds (:node d)))
                                                :items items :native true})
                         (update :fns merge fns))
                     ;; round 52: CORE_TRACE=1 names an impl left out and its parts (a part nil: what the writer refused)
                     (do (when (System/getenv "CORE_TRACE") (println "native-iface: impl" ip "not written: self" (pr-str self) "trait" (pr-str tr) (pr-str self-ty)
                                                                 (when (and (vector? self-ty) (number? (second self-ty))) (pr-str (select-keys (collect/def-of (second self-ty)) [:kind :data :parent :disamb])))))
                         acc)))))
             (nil? p) acc
             ;; RF20: a type alias std's names lack (`pub(crate) type ChangeOutputType<T, V> = <T::Residual as Residual<V>>::TryType`):
             ;; its type and generics as the helper's --std-names writes an alias, which collect expands at its arguments
             ;; queue 417: std's type alias of an impl Trait (collect/tait-alias?) as the alias itself, (free-alias), which
             ;; a path to it in a module after reads as [:free-alias ALIAS ARGS] (collect/*free-aliases*)
             ;; C4 (2026-11-22): every alias the pass computes is written, whether or not the names it reads hold it already: a
             ;; pass on names that carry the crate's own aliases (a chain's second run) wrote none, and the passes after it (alloc's,
             ;; std's) ran without `fmt::Result` and the rest; the names still win in with-native-std's merge
             (and (= "TyAlias" (:kind d)) collect/*free-aliases* (collect/tait-alias? (:id d)))
             (-> acc (assoc-in [:aliases p] (list 'free-alias)) (assoc-in [:alias-generics p] (generics-sty (collect/generics-of (:id d)))))
             (= "TyAlias" (:kind d))
             (let [t (ty->sty (collect/type-of (:id d)) path-of)]
               (if t
                 (-> acc (assoc-in [:aliases p] t) (assoc-in [:alias-generics p] (generics-sty (collect/generics-of (:id d)))))
                 acc))
             ;; RF20: a crate-private constant (`const MAX_ONE_B: u32 = 0x80` in char/mod.rs): its type, and an integer one's value
             ;; (its expression of literals) for a pattern that names it (`..MAX_ONE_B =>`)
             (and (= "Const { is_type_const: false }" (str (:kind d))) (not (get (:consts si) p)))
             (let [t (ty->sty (collect/type-of (:id d)) path-of)
                   v (try (some-> (:expr (:node d)) collect/const-int-value) (catch Throwable _ nil))]
               (if t (assoc-in acc [:consts p] (cond-> {:kind (str (:kind d)) :ty t :native true} v (assoc :value v))) acc))
             (and (= "Fn" (:kind d)) (not (get (:fns si) p)))
             (let [g (collect/generics-of (:id d)) sig (collect/fn-sig (:id d))
                   [ins out] (sig-sty (:id d) sig path-of)
                   preds (vec (keep #(clause->sty % path-of) (collect/explicit-clauses (:id d))))]
               (if (and (every? some? ins) out)
                 (assoc-in acc [:fns p] (cond-> {:generics (generics-sty g) :parent-count 0 :has-self false :predicates preds
                                         :inputs ins :output out :variadic (boolean (:variadic sig)) :safety (if (= :unsafe (:safety sig)) "Unsafe" "Safe")
                                         ;; C4: `#[rustc_comptime]` (the intrinsics align_of, field_offset ..) a const fn too (is_const_fn)
                                         :abi (str "\"" (or (:abi sig) "Rust") "\"") :const (or (= :const (get-in (:node d) [:header :constness])) (own-attr? (:node d) "rustc_comptime"))
                                         ;; C4: is_promotable_const_fn and NEVER_UNWIND from the function's own attributes
                                         :promotable (and (= :const (get-in (:node d) [:header :constness])) (own-attr? (:node d) "rustc_promotable"))
                                         :nounwind (own-attr? (:node d) "rustc_nounwind") :native true}
                                         ;; queue 542 (C6): a foreign function (no body; its symbol its link name), as std's interface
                                         ;; does not write it: :foreign its link name (`#[link_name = ".."]`, else its own)
                                         (:foreign (:node d)) (assoc :foreign (or (own-attr-value (:node d) "link_name") (second (:data d))))))
                 (do (when (System/getenv "CORE_TRACE")
                       (println "native-iface: fn" p "not written:" (pr-str (map-indexed (fn [i t] [i (when (nil? t) (pr-str (nth (:inputs sig) i nil)))]) ins))
                                (when (nil? out) (str "output " (pr-str (:output sig))))))
                     acc)))
             (and (#{"Struct" "Enum" "Union"} (:kind d)) (not (get (:adts si) p)))
             (let [g (collect/generics-of (:id d))
                   n (:node d)
                   field-tys (fn [owner data] (vec (map-indexed (fn [i f] [(or (:ident f) (str i))
                                                                           (binding [*pat-owner* [p (or (:ident f) (str i))]]
                                                                             (ty->sty (collect/type-of (some #(when (and (= owner (:parent %)) (= "Field" (:kind %)) (= (or (:ident f) (str i)) (second (:data %)))) (:id %)) (collect/defs))) path-of))])
                                                                (:fields data))))
                   variants (if (= "Enum" (:kind d))
                              (vec (for [v (collect/defs) :when (and (= (:id d) (:parent v)) (= "Variant" (:kind v)))]
                                     {:name (second (:data v)) :path (str p "::" (second (:data v)))
                                      :ctor (case (:kind (:data (:node v))) :tuple "Fn" :unit "Const" nil)
                                      :fields (field-tys (:id v) (:data (:node v)))}))
                              [{:name (:ident n) :path p :ctor (case (:kind (:data n)) :tuple "Fn" :unit "Const" nil) :fields (field-tys (:id d) (:data n))}])]
               (if (every? (fn [v] (every? (comp some? second) (:fields v))) variants)
                 (let [rd (when (= "Enum" (:kind d)) (enum-repr-discrs n (for [v (collect/defs) :when (and (= (:id d) (:parent v)) (= "Variant" (:kind v)))] (:node v))))]
                   (if (and (= "Enum" (:kind d)) (nil? rd))
                     acc
                     (assoc-in acc [:adts p] (cond-> {:kind (:kind d) :generics (generics-sty g (:id d) path-of) :parent-count 0 :has-self false :variants variants :native true}
                                               rd (merge rd)
                                               ;; queue 542 (C6): a dependency's `#[repr(C)]` struct or union (libc's `s! { .. }`, its
                                               ;; repr from the macro, which mono's source reading does not see), as mono's adt-repr
                                               ;; reads :repr "C"; std's own crates keep the helper's shape (no repr(C) in it)
                                               (and (some #{*crate*} dep-crates) (#{"Struct" "Union"} (:kind d))
                                                    (some #(and (string? %) (= "ReprC" %)) (mapcat :toks (:attrs n))))
                                               (assoc :repr "C")))))
                 (do (when (System/getenv "CORE_TRACE")
                       (println "native-iface: ADT" p "not written:"
                                (pr-str (for [f (:fields (:data n))] [(:ident f) (collect/type-of (some #(when (and (= (:id d) (:parent %)) (= "Field" (:kind %)) (= (:ident f) (second (:data %)))) (:id %)) (collect/defs)))]))
                                (pr-str (for [f (:fields (:data n)) :when (= :array (:kind (:ty f)))] (select-keys (:len (:ty f)) [:kind :path])))))
                     acc)))
             ;; a trait's associated constants' types (std's interface writes none: `SizedTypeProperties::ALIGN`)
             (and (= "Trait" (:kind d)) (get (:traits si) p))
             (update acc :consts merge
                     (into {} (for [k (collect/defs) :when (and (= (:id d) (:parent k)) (str/starts-with? (str (:kind k)) "AssocConst"))
                                    :let [cp (str p "::" (second (:data k))) t (ty->sty (collect/type-of (:id k)) path-of)]
                                    :when (and t (not (get (:consts si) cp)))]
                                [cp {:kind (:kind k) :ty t :native true}])))
             ;; a trait the interface lacks (`clone::uninit::CopySpec`): its items, and its functions' signatures
             (and (= "Trait" (:kind d)) (not (get (:traits si) p)))
             (let [g (collect/generics-of (:id d))
                   ;; C4 (2026-11-22): the associated items in their definition order, constants among them (the helper's
                   ;; associated_items: NumBufferTrait's DEFAULT before Buf), not the constants after the rest
                   kids (filter #(and (= (:id d) (:parent %)) (or (#{"AssocFn" "AssocTy"} (:kind %)) (str/starts-with? (str (:kind %)) "AssocConst"))) (collect/defs))
                   items (vec (for [k kids] (let [n (second (:data k)) kp (str p "::" n)]
                                              ;; RIND9 (a): an associated type's bounds as the helper writes them (explicit_item_bounds:
                                              ;; the implicit Sized or ?Sized's MetaSized, the written bounds, the trait's where clauses
                                              ;; on it; `ToOwned::Owned`'s Sized and Borrow<Self>), self the item's projection
                                              (if (= "AssocTy" (:kind k))
                                                [n "AssocTy" kp (vec (keep #(clause->sty % path-of) (collect/item-bounds (:id k))))]
                                                [n (:kind k) kp]))))
                   fns (into {} (for [k kids :when (= "AssocFn" (:kind k))
                                      :let [kg (collect/generics-of (:id k)) sig (collect/fn-sig (:id k))
                                            [ins out] (sig-sty (:id k) sig path-of)]
                                      :when (and (every? some? ins) out)]
                                  [(str p "::" (second (:data k)))
                                   {:generics (generics-sty kg) :parent-count (count (:params g)) :has-self true
                                    :predicates (vec (keep #(clause->sty % path-of) (collect/explicit-clauses (:id k))))
                                    :inputs ins :output out :variadic false :safety (if (= :unsafe (:safety sig)) "Unsafe" "Safe")
                                    :abi (str "\"" (or (:abi sig) "Rust") "\"") :const (and (= :const (:constness (:node d)))
                                                                          ;; C4: a const trait's method marked #[rustc_non_const_trait_method]
                                                                          (not (own-attr? (:node k) "rustc_non_const_trait_method")))
                                    :promotable false
                                    :nounwind (own-attr? (:node k) "rustc_nounwind") :native true}]))]
               (-> acc
                   (assoc-in [:traits p] {:generics (generics-sty g (:id d) path-of) :parent-count 0 :has-self true
                                          :predicates (vec (keep #(clause->sty % path-of) (collect/explicit-clauses (:id d))))
                                          :items items :native true})
                   (update :fns merge fns)
                   (update :consts merge
                           (into {} (for [k kids :when (str/starts-with? (str (:kind k)) "AssocConst")
                                          :let [t (ty->sty (collect/type-of (:id k)) path-of)] :when t]
                                      [(str p "::" (second (:data k))) {:kind (:kind k) :ty t :native true}])))))
             :else acc)
           (catch Throwable e
             (when (System/getenv "CORE_TRACE") (println "native-iface: def" (:id d) (:kind d) (:data d) (:disamb d) "failed:" (str e)))
             acc))))
     {:fns {} :adts {} :traits {} :consts {} :impls {}} (collect/defs))))

(defn with-native-iface
  "std's interface with core's native additions (a path the interface has keeps the interface's)"
  [si native]
  (-> si
      (update :fns #(merge (:fns native) %))
      (update :adts #(merge (:adts native) %))
      (update :traits #(merge (:traits native) %))
      (update :consts #(merge (:consts native) %))
      ;; RFP52 (a): the impls the interface lacks, indexed as load-std-iface indexes its own
      (as-> si* (reduce (fn [acc [p m]]
                          (if (get-in si [:impls p])
                            acc
                            (let [self (:self m)
                                  k (case (first self) adt (nth self 1) prim (str "prim:" (second self)) slice "prim:slice" array "prim:array"
                                          ref "prim:ref" ptr "prim:ptr" param "param" tuple "prim:tuple"
                                          dyn (str "dyn:" (let [pr (nth self 1)] (when (seq? pr) (nth pr 1))))
                                          (str "other:" (first self)))
                                  acc (assoc-in acc [:impls p] m)]
                              (if (:trait m)
                                (-> acc
                                    (update-in [:trait-impls (nth (:trait m) 1)] (fnil conj []) p)
                                    (update-in [:trait-impls-by (nth (:trait m) 1) (if (= k "param") :blanket k)] (fnil conj []) p))
                                (update-in acc [:inherent k] (fnil conj []) p)))))
                        si* (:impls native)))))

;; ---------------------------------------------------------------------------------------------
;; One module file through the pipeline

(declare body-key)

(defn- rel-module [^String p] (if (= p *crate*) "" (str (subs p (+ 2 (count *crate*))) "::")))

(defn- stage [stages k f]
  (try (let [t0 (System/nanoTime) v (f)]
         (swap! stages assoc k :ok)
         (when (System/getenv "CORE_TIME") (println "  time" k (quot (- (System/nanoTime) t0) 1000000) "ms"))
         v)
       (catch Throwable e
         (swap! stages assoc k (str (or (:what (ex-data e)) (.getMessage e) e)))
         (when (System/getenv "CORE_TRACE") (.printStackTrace e))
         (throw (ex-info "stage" {::stage k ::cause e})))))

(def ^:private const-kind? (fn [d] (let [k (str (:kind d))] (and (or (str/starts-with? k "Const") (str/starts-with? k "Static") (str/starts-with? k "AssocConst"))
                                                                  (:expr (:node d))))))

(def ^:dynamic *collect-only* false)   ; RF12-P2: the interface pass: each module collected, no body built
(def ^:dynamic *attrs-out* nil)   ; RF19: atom {def-path [attribute names]}: every function's codegen attributes, macro-made ones too
(def ^:dynamic *only-key?* nil)   ; queue 443 (S4, alloc's and std's bodies): a predicate of a body's key (body-key) choosing the bodies built, each through the 21 passes

(declare def-path-string)

(defn run-module
  "A module file's bodies, each [[name key] body-or-nil error-or-nil detail] handed to ON-BODY as it is built (its value
  kept): {:stages {stage :ok|message} :bodies [value ...]}"
  [{:keys [path file] :as m} table names std-file std si ^String lib-dir on-body]
  (let [stages (atom {})
        native (atom nil)
        only (some-> (System/getenv "CORE_ONLY") re-pattern)
        rel-file (rel-path (or (:src m) file))
        out (atom [])]
    (try
      ;; round 54 (RIND9 (a), std): std's modules take std's own prelude (lib.rs' `#[prelude_import] use
      ;; prelude::rust_2024::*;`, std-names' std::prelude), core's and alloc's core's; std's features its cfg's (crate-cfg)
      (binding [ex/*cfg-names* (crate-cfg) ex/*virtual* (atom nil) ex/*prelude-crate* (prelude-crate) ex/*def-order* (atom 0)
                ex/*raw-block-frags* (boolean (some #{*crate*} dep-crates))
                lower/*try-expn-mark* (boolean (some #{*crate*} backtrace-crates))
                tc/*steps-inherent* (boolean (some #{*crate*} backtrace-crates))
                collect/*int-bitops* (boolean (some #{*crate*} backtrace-crates))
                resolve/*crate-path* path collect/*root-crate-override* (prelude-crate)
                ;; queue 417: std's interface pass keeps its type aliases of an impl Trait as aliases (*free-aliases*)
                collect/*free-aliases* (boolean (and *collect-only* (= "std" *crate*)))]
        (let [mc (atom {}) sites (atom {})
              crate (stage stages :expand
                           #(binding [ex/*mark-crates* mc ex/*sites* sites]
                              (ex/expand-file file 2024 (let [sm (ex/load-std-macros std-file)]
                                                         (merge sm (macros-for table file (when (some #{*crate*} backtrace-crates) (set (keys sm)))))))))
              vtext (ex/virtual-text)
              res (stage stages :resolve #(binding [resolve/*def-sites* (into {} (for [[k v] @mc :when (and (vector? k) (= :def-site (first k)))] [(second k) v]))
                                                    ;; RIND9 (a): a macro's `$crate` by its crate (alloc's: core's macros name core)
                                                    resolve/*mark-crates* @mc]
                                            (resolve/resolve-crate crate names {:source vtext})))
              res-map (into {} (for [[_ s rs] res] [s rs]))
              _ (when-let [d (System/getenv "CORE_DUMP")]
                  (.mkdirs (File. ^String d))
                  (spit (str d "/" (str/replace path "::" "-") ".vtext.rs") vtext)
                  (spit (str d "/" (str/replace path "::" "-") ".res.edn") (with-out-str (doseq [r res] (prn r)))))
              hir (stage stages :lower #(lower/lower-crate crate res-map {:file rel-file :mark-crates @mc :std-generics (lower/load-std-generics std-file)}))]
          (binding [tc/*root-file* rel-file build/*root-file* rel-file build/*expn-sites* @sites build/*span-origin* ex/virtual-origin]
            (stage stages :collect
                   #(collect/with-crate hir res-map std {:source vtext :edition (crate-edition) :si si}
                      (fn []
                        (swap! stages assoc :collect :ok)
                        (reset! native (try (native-iface path si) (catch Throwable e (when (System/getenv "CORE_TRACE") (.printStackTrace e)) nil)))
                        ;; RF19: the functions' attributes after expansion (a macro-made item's: int_impl!'s methods, the
                        ;; operator impls' add_impl!, cmp's ord_impl!), as mono reads core's sources' for the others
                        (when *attrs-out*
                          (let [la (requiring-resolve 'arbace.rust.front.mono/local-attrs)]
                            (doseq [d (collect/defs) :when (#{"Fn" "AssocFn"} (str (:kind d)))]
                              (try (swap! *attrs-out* assoc (def-path-string (:id d)) (la (:id d)))
                                   (catch Throwable _ nil)))))
                        (binding [build/*allocs* (atom {:next 1 :ids {}}) passes/*opaque-cache* (atom {}) passes/*panic-abort* false
                                  ;; RF12-P6: the exported bodies through the 21 passes to runtime MIR
                                  build/*after-finish* (if-let [re (some-> (System/getenv "CORE_EXPORT_NAMES") re-pattern)]
                                                         (fn [b] (if (re-find re (str (:name b)))
                                                                   (assoc b :stages (into {} (passes/stages b "SimplifyCfg-pre-optimizations")))
                                                                   b))
                                                         (when *only-key?*
                                                           (fn [b] (assoc b :stages (into {} (passes/stages b "SimplifyCfg-pre-optimizations"))))))]
                          (doseq [d (if *collect-only* [] (collect/defs))
                                  :when (or (and (#{"Fn" "AssocFn"} (:kind d)) (:body (:node d)))
                                            (= "Closure" (:kind d)) (const-kind? d))]
                            (let [nm (try (build/mir-name d) (catch Throwable e (when (System/getenv "CORE_TRACE") (.printStackTrace e)) (str "?" (:id d))))]
                              (when (and (or (nil? only) (re-find only nm)) (or (nil? *only-key?*) (*only-key?* (body-key path d))))
                              (swap! out conj
                                     (on-body
                                     (try [[nm (body-key path d)] (if (const-kind? d)
                                                (build/build-const d {:overflow-checks false :edition (crate-edition)})
                                                (build/build-body d {:overflow-checks false :edition (crate-edition) :root-cache (atom {})})) nil]
                                          (catch Throwable e
                                            (when (System/getenv "BUILD_TRACE") (.printStackTrace e))
                                            [[nm (body-key path d)] nil (str (or (:what (ex-data e)) (.getMessage e) e)) (pr-str (:x (ex-data e)))])))))
                              ;; RF13d: the fn's inline consts, each a body of its own (`f::{constant#N}`)
                              (when (#{"Fn" "AssocFn"} (:kind d))
                                (doseq [ic (try (build/inline-consts d) (catch Throwable _ nil))
                                        :let [sfx (build/inline-const-suffix ic) inm (str nm sfx) ik (str (body-key path d) (str/replace sfx "::" "-"))]
                                        :when (and (or (nil? only) (re-find only inm)) (or (nil? *only-key?*) (*only-key?* ik)))]
                                  (swap! out conj
                                         (on-body
                                          (try [[inm ik] (build/build-inline-const d ic {:overflow-checks false :edition (crate-edition) :root-cache (atom {})}) nil]
                                               (catch Throwable e
                                                 (when (System/getenv "BUILD_TRACE") (.printStackTrace e))
                                                 [[inm ik] nil (str (or (:what (ex-data e)) (.getMessage e) e)) (pr-str (:x (ex-data e)))])))))))))))))))
      (catch Throwable e (when-not (::stage (ex-data e)) (swap! stages assoc :driver (str e)))))
    {:stages @stages :bodies @out :native @native}))

(defn body-key
  "A body's def path with its disambiguators as -Zdump-mir names its file (`hint-{impl#0}-to_llvm`)"
  [path d]
  (let [segs (loop [d d acc ()]
               (let [[k n] (:data d)]
                 (case k
                   :crate acc
                   ;; RF13b: a second item of the same name under one parent (const_panic!'s `do_panic`s): `do_panic#1`
                   (:type :value) (recur (collect/def-of (:parent d)) (cons (if (pos? (long (or (:disamb d) 0))) (str n "#" (:disamb d)) n) acc))
                   :impl (recur (collect/def-of (:parent d)) (cons (str "{impl#" (:disamb d) "}") acc))
                   :closure (recur (collect/def-of (:parent d)) (cons (str "{closure#" (:disamb d) "}") acc))
                   (recur (collect/def-of (:parent d)) acc))))]
    (str/join "-" (concat (when (not= path *crate*) (rest (str/split path #"::"))) segs))))

;; ---------------------------------------------------------------------------------------------
;; RF12-P6: a native core body for a program's run (CORE_EXPORT): its runtime MIR (the 21 passes) with every local definition
;; by its path in core (`core::ptr::write_volatile::precondition_check`, an impl `core::ptr::const_ptr::{impl#0}`), the forms'
;; texts left to the program's context (bin/rust-front run-built prints them again from their types), a call's place in core's
;; sources as rustc's paths write it (`/rustc/HASH/library/...`)

(def rustc-src-prefix "/rustc/58cf8f9c35b355199727627d07ae34a4e2846d67/")

(defn def-path-string
  "A local definition's path in core, with rustc's disambiguators"
  [id]
  (let [segs (loop [d (collect/def-of id) acc ()]
               (let [[k n] (:data d)]
                 (case k
                   :crate acc
                   (:type :value) (recur (collect/def-of (:parent d)) (cons n acc))
                   :impl (recur (collect/def-of (:parent d)) (cons (str "{impl#" (:disamb d) "}") acc))
                   :closure (recur (collect/def-of (:parent d)) (cons (str "{closure#" (:disamb d) "}") acc))
                   :ctor (recur (collect/def-of (:parent d)) (cons "{constructor#0}" acc))
                   (recur (collect/def-of (:parent d)) acc))))]
    (str/join "::" (concat (str/split resolve/*crate-path* #"::") segs))))

(def ^:dynamic *export-closures*
  "queue 464 (462-3 (a) 1): within export-entry, the typeck root's closures by their type's text: {TEXT {:id DEF :kind K
  :upvars [TYPE] :args IDENTITY}} (build-body's :root-closures, each closure's definition found by its HIR id)"
  nil)

(defn- root-closures-of
  "queue 464: a built body's :root-closures with each closure's definition and its typeck root's identity arguments, for
  *export-closures*"
  [b]
  (when-let [rc (not-empty (:root-closures b))]
    (let [by-hid (into {} (for [d (collect/defs) :when (= "Closure" (:kind d))] [(:hir-id (:node d)) (:id d)]))]
      (into {} (for [[text ci] rc :let [id (get by-hid (:hir-id ci))] :when id]
                 [text (assoc ci :id id
                              :args (collect/identity-args (collect/generics-of (loop [x id] (let [d (collect/def-of x)] (if (= "Closure" (:kind d)) (recur (:parent d)) x))))))])))))

(declare ext-ty)
(defn- ext-closure
  "queue 464 (462-3 (a) 1): a closure type of the crate's own as data, `[:closure DEF-PATH [:fnsig INPUTS OUTPUT] ARGS [:upvars
  TYPE..] KIND]`: its definition's path, its signature, its parent's arguments (the typeck root's identity, substituted at the
  instance with the body's), its upvars' types (closure_analyze's captures) and its kind (:fn :fn-mut :fn-once), each type in
  the crate's paths; a closure not among the root's (another body's) is not carried"
  [t]
  (let [[_ text sig args] t
        ci (get *export-closures* text)]
    (when-not (and ci (map? sig)) (throw (ex-info "a closure or opaque type" {:carry false})))
    [:closure (def-path-string (:id ci))
     [:fnsig (mapv ext-ty (:inputs sig)) (ext-ty (:output sig))]
     (mapv ext-ty (or args (:args ci)))
     (into [:upvars] (map ext-ty (:upvars ci)))
     (:kind ci)]))

(defn- ext-ty
  "A type with each local definition its path in core; nil for a closure's or an opaque type's (not carried); queue 464: a
  closure of the exported body's typeck root as data (ext-closure)"
  [t]
  (cond
    ;; queue 474: a fn pointer's signature map ([:fnptr {:inputs .. :output ..}]) in core's paths too (catch_unwind's
    ;; `unsafe fn(*mut Data<F, R>)` kept the fn-local struct's id, `[:adt 50 ..]`: def-of 50 at the run)
    (map? t) (into {} (for [[k v] t] [k (ext-ty v)]))
    (not (vector? t)) t
    (and (= :closure (first t)) *export-closures*) (ext-closure t)
    (and (keyword? (first t)) (#{:closure :opaque :coroutine} (first t))) (throw (ex-info "a closure or opaque type" {:carry false}))
    (and (keyword? (first t)) (#{:adt :fndef :proj} (first t)) (number? (second t)))
    (into [(first t) (def-path-string (second t))] (map ext-ty (drop 2 t)))
    (= :dyn (first t))
    (let [[_ m r] t]
      [:dyn (cond-> m
              (:principal m) (update :principal (fn [[d as]] [(if (number? d) (def-path-string d) d) (mapv ext-ty as)]))
              (:projections m) (update :projections (fn [ps] (vec (for [[d as tm] ps] [(if (number? d) (def-path-string d) d) (mapv ext-ty as) (ext-ty tm)]))))
              (:autos m) (update :autos (fn [as] (mapv #(if (number? %) (def-path-string %) %) as))))
       r])
    :else (mapv ext-ty t)))

(defn externalize
  "A body's forms with their types (the :tc metadata) in core's paths and a call's :call-span its place (:call-loc)"
  [x]
  (cond
    (seq? x) (let [y (apply list (map externalize x))
                   m (meta x)
                   y (if (and (= 'unevaluated (first y)) (number? (second y))) (apply list 'unevaluated (def-path-string (second y)) (drop 2 y)) y)
                   m (cond-> m
                       (:tc m) (update :tc ext-ty)
                       (:nc m) (update :nc (fn [[d as]] [(if (number? d) (def-path-string d) d) (mapv ext-ty as)]))
                       ;; C6-4 (a): a call made by an expansion takes its place at the expansion's root call site, the body's own
                       ;; file (span_as_caller_location's topmost: ExpnId::expansion_cause), not the macro definition's; a path
                       ;; already remapped (a macro's file, /rustc/COMMIT/library/..) is not prefixed again
                       (:call-span m) (#(let [cs (:call-span %)
                                              site (ex/virtual-cause cs)
                                              o (ex/virtual-origin cs)
                                              ;; queue 561 (C6 L3): a vendored crate's file as std's build writes its caller locations,
                                              ;; Cargo's path of a vendored package (`./vendor/adler2-2.0.1/src/algo.rs`); every vendored
                                              ;; crate's (hashbrown's and libc's too: std's IR's `./vendor/hashbrown-0.17.1/..`), the
                                              ;; user's vendored-locs (a), 2026-11-24
                                              src (fn [^String f] (cond (str/starts-with? f "/") f
                                                                        (str/starts-with? f "library/vendor/")
                                                                        (str rustc-src-prefix "library/./" (subs f 8))
                                                                        :else (str rustc-src-prefix f)))]
                                          (cond-> (dissoc % :call-span)
                                            (and site tc/*root-file*) (assoc :call-loc [(src tc/*root-file*) (site 0) (site 1)])
                                            ;; a call written in the body's own file: its own place there
                                            (and (not site) tc/*root-file* (ex/root-span? cs)) (assoc :call-loc [(src tc/*root-file*) (cs 0) (cs 1)])
                                            (and (not site) (= 5 (count o))) (assoc :call-loc [(src (o 0)) (o 1) (o 2)])
                                            ;; queue 524 (C3): a call made of the body file's own tokens a macro was given
                                            ;; (assert_unsafe_precondition!'s check expression in its nested precondition_check:
                                            ;; `Layout::is_size_align_valid(size, align)`), its own place there, as rustc's span
                                            ;; of a metavariable's tokens keeps the root context
                                            (and (not site) tc/*root-file* (not (ex/root-span? cs)) (= 4 (count o)) (every? number? o))
                                            (assoc :call-loc [(src tc/*root-file*) (o 0) (o 1)])))))]
               (if m (with-meta y m) y))
    (vector? x) (let [y (mapv externalize x)] (if (meta x) (with-meta y (cond-> (meta x) (:tc (meta x)) (update :tc ext-ty))) y))
    (map? x) (into {} (for [[k v] x :when (not (#{:def :stages :alloc-data} k))]
                        [k (if (#{:local-tys} k) (mapv ext-ty v) (externalize v))]))
    :else x))

(defn- local-const-ids
  "queue 462 (448-4 (a) 5): the crate's own constants FORMS name by their local def id, with no arguments (`(unevaluated \"14\"
  ..)`, :nc [14 []]: core::str::validations::CONT_MASK)"
  [forms]
  (set (for [x (tree-seq coll? seq forms)
             :when (and (seq? x) (= 'unevaluated (first x)))
             :let [[d as] (:nc (meta x))]
             :when (and (number? d) (empty? as))]
         d)))

(defn- deferred-static-ids
  "queue 542 (C6): the crate's statics FORMS point at with their value deferred (build's `static: PATH, deferred` allocations),
  by their local def ids, so that export-consts exports their initializers' bodies (the run evaluates them: build-run's
  eval-static-body)"
  [forms]
  (let [ps (set (for [x (tree-seq coll? seq forms)
                      :when (string? x)
                      :let [p (second (re-find #"^\s*alloc\d+ \(static: ([^,]+), deferred\)" x))]
                      :when p]
                  p))]
    (if (empty? ps)
      #{}
      (set (for [d (collect/defs)
                 :when (str/starts-with? (str (:kind d)) "Static")
                 :when (ps (binding [collect/*in-value* true] (collect/print-def-path (:id d) [])))]
             (:id d))))))

(defn- export-consts
  "queue 462 (448-4 (a) 5, DECISION 448-3 (a)): the bodies of the crate's constants a built body R names by a local def id,
  each built (construct_const) and exported as a body is, with the constants they name in turn (three levels), {def-path
  body}; the run evaluates them as CTFE does (build-run's eval-promoted on a constant's body), so that a native instance names
  their values (CONT_MASK, count_chars' UNROLL_INNER and USIZE_SIZE, an integer's MAX) and is not refused at plan time. A
  constant that does not build is left out (the body stays refused, as before)"
  [r]
  (try
  (loop [todo (into (local-const-ids [r]) (deferred-static-ids [r])) seen #{} acc {} depth 0]
    (if (or (empty? todo) (> depth 2))
      acc
      (let [built (for [id todo
                        :let [d (try (collect/def-of id) (catch Throwable _ nil))]
                        :when (and d (const-kind? d))
                        :let [b (try (build/build-const d {:overflow-checks false :edition (crate-edition)}) (catch Throwable _ nil))
                              r (when b (try (let [st (:stages b) lp (last (filter #(contains? st %) passes/pass-names))]
                                               (get-in st [lp (passes/body-key b)]))
                                             (catch Throwable _ nil)))
                              body (when (and r (not (:error r))) (try (externalize (dissoc r :stages)) (catch Throwable _ nil)))]
                        :when body]
                    [id (def-path-string id) body r])
            seen (into seen todo)]
        (recur (remove seen (into (local-const-ids (keep #(nth % 3) built)) (deferred-static-ids (keep #(nth % 3) built))))
               seen
               (into acc (for [[_ p body] built] [p body]))
               (inc depth)))))
  (catch Throwable _ nil)))

(defn- body-types
  "The types (the :tc metadata) of a body's forms (alloc-check's fndef-types)"
  [body]
  (let [acc (transient [])]
    (letfn [(w [x] (when-let [t (:tc (meta x))] (conj! acc t))
                   (cond (map? x) (doseq [v (vals x)] (w v)) (coll? x) (doseq [y x] (w y))))]
      (w body))
    (persistent! acc)))

(defn with-private-facts
  "An export's entry E with the native facts (NATIVE, the crate's interface pass) of the crate-private items its body names that
  std's interface SI-FULL lacks, which the run's interface takes (build-run's with-extra-iface): queue 443's functions it calls
  (`box_new_uninit`), 462's impls and traits of those (`RawVec`'s inherent impl, `SpecToString`), so that the run prints the
  function constants as rustc does (`RawVec::<u8>::ptr`, not `<impl {}>::ptr`); C6-4 (a)'s ADTs its types name (`btree::node::
  LeftOrRight`), its own impl (a fn-local struct's inherent impl) and the functions enclosing its definition and those ADTs (a
  fn-local item's parent, in the value namespace of its v0 path)"
  [e native si-full]
  (let [ts0 (tree-seq coll? seq (body-types [(:body e) (:promoted e)]))
        fps (set (for [x ts0 :when (and (vector? x) (= :fndef (first x)) (string? (second x)))] (second x)))
        adt-ps (set (for [x ts0 :when (and (vector? x) (= :adt (first x)) (string? (second x)))] (second x)))
        ancestors (fn [^String p] (let [segs (str/split p #"::")] (for [i (range 2 (count segs))] (str/join "::" (take i segs)))))
        pick (fn [k ps] (into {} (for [p ps :let [f (get-in native [k p])] :when (and f (not (get-in si-full [k p])))] [p (dissoc f :native)])))
        ;; rust-c6c: and the functions nested in its body (:nested-attrs' paths: custom_owner_from_box's generic
        ;; `drop_box_raw<T: ?Sized>`, reified at `dyn Error + Send + Sync`, whose symbol carries its argument as std's IR's)
        fs (pick :fns (concat fps (ancestors (str (:def e))) (mapcat ancestors adt-ps) (keys (:nested-attrs e))))
        parents (set (keep #(let [i (.lastIndexOf ^String % "::")] (when (pos? i) (subs % 0 i))) (conj fps (str (:def e)))))
        is (pick :impls parents)
        ts (pick :traits parents)
        as (pick :adts adt-ps)]
    (cond-> e (seq fs) (assoc :fns fs) (seq is) (assoc :impls is) (seq ts) (assoc :traits ts) (seq as) (assoc :adts as))))

(defn export-entry
  "The exported body of a built body B (its last stage after the passes, its promoted bodies); queue 462: with K, the bodies
  of the crate's constants it names by a local def id (:consts, export-consts)"
  [b k equal?]
  (let [st (:stages b)
        last-pass (last (filter #(contains? st %) passes/pass-names))
        key (passes/body-key b)
        r (get-in st [last-pass key])
        pre (str key "::promoted[")
        pbs (into {} (for [[kk pb] (get st last-pass) :when (and (str/starts-with? kk pre) (not (:error pb)))] [(:promoted pb) pb]))]
    (if (or (nil? r) (:error r))
      {:key k :refused (str "the passes: " (or (:error r) (str "no body after " last-pass)))}
      (try (binding [*export-closures* (root-closures-of b)]
            (let [;; C6-4: each Assert's span (build's :assert-span, which the passes keep the terminator but not its metadata
                  ;; of: build-run's aspans), by its condition, expected value and message, put back on the passes' terminator as
                  ;; a call's span, which externalize makes its caller location (:call-loc), the panic's Location
                  built (vec (for [blk (:blocks b) :let [t (:term blk)] :when (and (seq? t) (= 'assert (first t)) (:assert-span (meta t)))]
                               [(vec (take 3 (rest t))) (:assert-span (meta t))]))
                  aspans (into {} built)
                  ;; rust-c6c: a key two built asserts share, or one the passes changed (their locals renumbered: digits_to_dec_str's
                  ;; `parts[0]`), takes the next unused built assert of its message's kind, in block order
                  kind-of (fn [k] (let [m (nth k 2 nil)] (if (seq? m) (first m) m)))
                  uniq (set (for [[k n] (frequencies (map first built)) :when (= 1 n)] k))
                  used (volatile! #{})
                  r (if (empty? aspans) r
                        (let [exact (set (for [blk (:blocks r) :let [t (:term blk)] :when (and (seq? t) (= 'assert (first t)))
                                               :let [k (vec (take 3 (rest t)))] :when (uniq k)] k))]
                          (update r :blocks (fn [bs] (mapv (fn [blk] (let [t (:term blk)
                                                                           k (when (and (seq? t) (= 'assert (first t))) (vec (take 3 (rest t))))
                                                                           sp (cond (nil? k) nil
                                                                                    (uniq k) (get aspans k)
                                                                                    :else (when-let [i (first (keep-indexed (fn [i [bk _]] (when (and (= (kind-of bk) (kind-of k)) (not (exact bk)) (not (@used i))) i)) built))]
                                                                                            (vswap! used conj i) (second (nth built i))))]
                                                                       (if sp (assoc blk :term (vary-meta t assoc :call-span sp)) blk)))
                                                           bs)))))]
            (cond-> {:key k :def (def-path-string (:id (:def b))) :equal equal? :pass last-pass
            :attrs ((requiring-resolve 'arbace.rust.front.mono/local-attrs) (:id (:def b)))
            ;; C6: the attributes of the functions nested in it (handle_alloc_error's `#[inline] fn rt_error`), which its body
            ;; calls and no entry of their own carries (build-run's lib-unit takes them)
            ;; C6-4: the attributes of the crate's own functions the body calls (a copy's #[inline] decides its symbol's
            ;; instantiating crate: std's `Components::len_before_body`, `Path::has_root`), which no entry of their own carries
            ;; queue 561 (C6 L3): a backtrace crate's body also carries the attributes of every function of its module file (beneath
            ;; the callees' own), the impls' methods its operators and trait calls reach (adler2's `#[inline] fn add_assign` of
            ;; `impl AddAssign for U32X4` under `+=`: a copy, the instantiating crate in its symbol), which a trait method call's :tc
            ;; does not name
            :callee-attrs (let [la (requiring-resolve 'arbace.rust.front.mono/local-attrs)]
                            (merge
                             (when (some #{*crate*} backtrace-crates)
                               (into {} (for [d (collect/defs) :when (#{"Fn" "AssocFn"} (str (:kind d)))
                                              :let [p (try (def-path-string (:id d)) (catch Throwable _ nil))
                                                    a (when p (try (la (:id d)) (catch Throwable _ nil)))]
                                              :when (seq a)]
                                          [p a])))
                             (into {} (for [x (tree-seq coll? seq [(:blocks r) (vals pbs)])
                                           :let [t (when (seq? x) (:tc (meta x)))]
                                           :when (and (vector? t) (= :fndef (first t)) (number? (second t)))
                                           :let [p (try (def-path-string (second t)) (catch Throwable _ nil))]
                                           :when p]
                                       [p (try (la (second t)) (catch Throwable _ []))]))))
            :nested-attrs (let [la (requiring-resolve 'arbace.rust.front.mono/local-attrs) pre (str (def-path-string (:id (:def b))) "::")]
                            (into {} (for [d (collect/defs) :when (#{"Fn" "AssocFn"} (str (:kind d)))
                                           :let [p (try (def-path-string (:id d)) (catch Throwable _ nil))]
                                           :when (and p (str/starts-with? p pre))]
                                       [p (la (:id d))])))
            :body (externalize (dissoc r :stages :root-closures :upvar-tys)) :promoted (into {} (for [[i pb] pbs] [i (externalize (dissoc pb :root-closures :upvar-tys))]))
            :generics (count (:params (collect/generics-of (:id (:def b)))))}
             ;; queue 464 (462-3 (a) 2): a closure's own body, with its upvars' types and kind (the run lays its type out
             ;; from the type's data; these are the body's own, for a check)
             (:upvar-tys b) (assoc :upvar-tys (mapv ext-ty (:upvar-tys b)))
             k (as-> e (if-let [cs (not-empty (export-consts [r (vals pbs)]))] (assoc e :consts cs) e)))))
           (catch Throwable e {:key k :refused (str (or (.getMessage e) e))})))))

;; ---------------------------------------------------------------------------------------------
;; rustc's built MIR of core (core-oracle's index: FILE TAB NAME)

(defn load-oracle
  "rustc's bodies by their file's key (`hint-{impl#0}-to_llvm`): the dump's file (core-oracle's mir/), or its text (the pack's
  bodies/, one file a module: each dump after a line `//// FILE`)"
  [^String dir]
  (let [key (fn [^String f] (when (str/ends-with? f ".1-1-000.built.after.mir") (subs f 5 (- (count f) (count ".1-1-000.built.after.mir")))))
        bodies (File. (str dir "/bodies"))]
    (if (.isDirectory bodies)
      (into {} (for [^File m (.listFiles bodies)
                     part (rest (str/split (slurp m) #"(?m)^//// "))
                     :let [i (str/index-of part "\n") k (key (subs part 0 i))]
                     :when k]
                 [k {:text (subs part (inc i))}]))
      (let [lines (str/split-lines (slurp (str dir "/index.tsv")))]
        (into {} (for [l lines :let [[f _] (str/split l #"\t") k (key f)] :when k]
                   [k (str dir "/mir/" f)]))))))

(defn- oracle-text [f]
  (let [t (if (map? f) (:text f) (slurp f)) body (subs t (inc (str/index-of t "\n")))]
    (if (str/starts-with? body "\n") (subs body 1) body)))

(defn -main [lib-dir & args]
  ;; queue 462: core-export --rsi-outside's bodies (CORE_EXPORT_KEYS: no oracle, each judged against rsi's record at the
  ;; instance) are built as rsi's std build builds core, without debug assertions; 479-2 (a): core-export --rsi's too
  ;; (CORE_DEBUG_ASSERTIONS=0, bin/lib/repr-rust/core-build.bash's core_export)
  (binding [*debug-assertions* (and (nil? (System/getenv "CORE_EXPORT_KEYS")) (not= "0" (System/getenv "CORE_DEBUG_ASSERTIONS")))]
  (binding [ex/*cfg-names* (crate-cfg)]
    (case (first args)
      ;; RF19: --attrs FRONT-DIR CACHE-DIR MODULES-FILE OUT FILE...: the interface pass over FILEs (core's index from CACHE-DIR,
      ;; made by a core-check run), each function's attributes after expansion into OUT, {def-path [names]} (mono's
      ;; RF_CORE_ATTRS: the macro-made items core's sources do not show)
      "--attrs"
      (let [[_ front-dir cache-dir modules-file out & files] args
            mods (into {} (for [l (str/split-lines (slurp modules-file)) :let [[p f v src] (str/split l #" ")]] [f (cond-> {:path p :file f :vendored (= v "vendored")} (seq src) (assoc :src src))]))
            std-file (str front-dir "/std-names.edn")
            std (collect/load-std std-file)
            si (collect/load-std-iface (str front-dir "/std-iface.edn"))
            index (let [cache (File. (str cache-dir "/index.edn"))]
                    (if (.exists cache)
                      (read-string (slurp cache))
                      (let [t (crate-index (remove :vendored (vals mods)))] (spit cache (pr-str t)) t)))
            table (:macros index)
            names (with-core-names (resolve/load-std-names std-file) (:names index))
            native-file (File. (str cache-dir "/native-iface.edn"))
            si (if (.exists native-file) (with-native-iface si (read-string (slurp native-file))) si)
            acc (atom {})]
        (doseq [f files]
          (if-let [m (get mods (.getCanonicalPath (File. ^String f)))]
            (let [t0 (System/nanoTime) n0 (count @acc)
                  {:keys [stages]} (binding [*collect-only* true *attrs-out* acc] (run-module m table names std-file std si lib-dir identity))]
              (println (format "core-attrs: %s stages %s: %d functions (%d s)" (:path m) (pr-str stages) (- (count @acc) n0)
                               (quot (- (System/nanoTime) t0) 1000000000))))
            (println "core-attrs: not a module file:" f)))
        (spit out (pr-str (into (sorted-map) @acc)))
        (println "core-attrs:" (count @acc) "functions' attributes to" out))
      "--list" (doseq [m (module-files lib-dir)] (println (str/trimr (str (:path m) " " (:file m) " " (if (:vendored m) "vendored" "") (when (:src m) (str " " (:src m)))))))
      "--check"
      (let [[_ front-dir oracle-dir cache-dir modules-file & files] args
            mods (into {} (for [l (str/split-lines (slurp modules-file)) :let [[p f v src] (str/split l #" ")]] [f (cond-> {:path p :file f :vendored (= v "vendored")} (seq src) (assoc :src src))]))
            std-file (str front-dir "/std-names.edn")
            std (collect/load-std std-file)
            si (collect/load-std-iface (str front-dir "/std-iface.edn"))
            si-full si   ; C6-4 (a): the helper's interface, before core's native facts are layered over it
            oracle (load-oracle oracle-dir)
            judge @(requiring-resolve 'arbace.rust.front.build-check/judge-row)
            print-text (fn [b] (try (build/print-built b) (catch Throwable e (str "print failed: " e))))
            index (let [cache (File. (str cache-dir "/index.edn"))]
                    (if (.exists cache)
                      (read-string (slurp cache))
                      (let [t (crate-index (remove :vendored (vals mods)))]
                        (println "core-check: core's index over" (count (remove :vendored (vals mods))) "files:" (count (:macros t)) "macros," (count (:names t)) "modules")
                        (spit cache (pr-str t)) t)))
            table (:macros index)
            names (with-core-names (resolve/load-std-names std-file) (:names index))
            ;; RF20: collect's names too: core's own modules and re-exports where std's lack them (`ascii::Char`, a re-export of
            ;; `ascii_char::AsciiChar`, as the resolver's names have them)
            names (with-adt-names names (:adts si))
            std (assoc (with-core-kinds std (:names index)) :mods names)
            verbose (System/getenv "CORE_VERBOSE")
            totals (atom {})
            control (atom nil)
            export-re (some-> (System/getenv "CORE_EXPORT_NAMES") re-pattern)
            ;; queue 448: CORE_EXPORT_KEYS, a file of body keys (`fmt-{impl#4}-new`, one a line): those bodies alone built and
            ;; exported (core's defs outside rust-core-built's modules: no oracle, each entry :judge :instance, judged against
            ;; the record's instance at the run as alloc's and std's are)
            export-keys (when-let [f (System/getenv "CORE_EXPORT_KEYS")]
                          (set (for [l (str/split-lines (slurp f)) :let [l (str/trim l)] :when (seq l)] l)))
            exported (atom [])
            ;; core's native interface so far (this run's modules, and the last run's: native-iface.edn)
            native-file (File. (str cache-dir (if *debug-assertions* "/native-iface.edn" "/native-iface-nodebug.edn")))
            ;; RF12-P2 (b): core's interface in one collection pass over the files (CORE_IFACE_FILES: a file listing others,
            ;; one a line, as core-modules.txt names them) before any body; CORE_IFACE=cache: the last run's native-iface.edn instead
            native-all (atom (if (and (= "cache" (System/getenv "CORE_IFACE")) (.exists native-file)) (read-string (slurp native-file)) {:fns {} :adts {}}))
            iface-files (if-let [l (System/getenv "CORE_IFACE_FILES")]
                          (if (= l "all")
                            ;; every non-vendored module file of core (RF12-P7: the night's pass)
                            (sort (map :file (remove :vendored (vals mods))))
                          (for [x (str/split-lines (slurp l)) :when (seq (str/trim x))] (str lib-dir "/core/src/" (str/trim x))))
                          files)
            _ (when-not (= "cache" (System/getenv "CORE_IFACE"))
                (let [t0 (System/nanoTime)]
                  (doseq [f iface-files :let [m (get mods (.getCanonicalPath (File. ^String f)))] :when m]
                    (let [{:keys [native]} (binding [*collect-only* true] (run-module m table (with-native-names names @native-all) std-file (with-native-std std @native-all) (with-native-iface si @native-all) lib-dir identity))]
                      (when native (swap! native-all #(merge-with merge % native)))))
                  (println (format "core-check: the interface pass over %d files: %d functions, %d ADTs, %d traits (%d s)" (count iface-files)
                                   (count (:fns @native-all)) (count (:adts @native-all)) (count (:traits @native-all)) (quot (- (System/nanoTime) t0) 1000000000)))))
            ;; RFP52 (a): the files of test/rust/front/core-iface-extra.txt (CORE_IFACE_EXTRA: another list, empty for none)
            ;; collected in every run, before any body: the crate-private items the 37 modules name (IndexRange's methods,
            ;; try_process, NeverShortCircuit, the unicode tables, ...)
            extra-list (or (System/getenv "CORE_IFACE_EXTRA") "test/rust/front/core-iface-extra.txt")
            _ (when (and (seq extra-list) (.exists (File. ^String extra-list)))
                (let [t0 (System/nanoTime)
                      fs (for [x (str/split-lines (slurp extra-list)) :let [x (str/trim x)] :when (and (seq x) (not (str/starts-with? x "#")))]
                           (str lib-dir "/core/src/" x))]
                  (doseq [f fs :let [m (get mods (.getCanonicalPath (File. ^String f)))]]
                    (if m
                      (let [{:keys [native]} (binding [*collect-only* true] (run-module m table (with-native-names names @native-all) std-file (with-native-std std @native-all) (with-native-iface si @native-all) lib-dir identity))]
                        (when native (swap! native-all #(merge-with merge % native))))
                      (println "core-check: core-iface-extra: not a module file:" f)))
                  (println (format "core-check: the extra interface files (%d): %d functions, %d ADTs, %d traits, %d impls (%d s)" (count fs)
                                   (count (:fns @native-all)) (count (:adts @native-all)) (count (:traits @native-all)) (count (:impls @native-all))
                                   (quot (- (System/nanoTime) t0) 1000000000)))))]
        ;; CORE_IFACE_ONLY=1: the interface pass alone (its native-iface.edn for a later CORE_IFACE=cache run)
        (doseq [f (if (System/getenv "CORE_IFACE_ONLY") [] files) :let [m (get mods (.getCanonicalPath (File. ^String f)))
                              si (with-native-iface si @native-all)]]
          (let [dump (System/getenv "CORE_DUMP")
                on-body (fn [[[nm k] b err detail]]
                          (let [w (get oracle k) t (when b (print-text b))
                                _ (when (and t w (nil? @control) (= t (oracle-text w))) (reset! control [k t]))]
                            (when (and dump t) (.mkdirs (File. ^String dump)) (spit (str dump "/" k ".mir") t))
                            (when-let [rd (System/getenv "CORE_RAW")] (when b (.mkdirs (File. ^String rd)) (spit (str rd "/" k ".edn") (binding [*print-meta* true] (pr-str b)))))
                            (let [row (if (nil? w) [:no-oracle nm k] (judge nm (oracle-text w) t err detail))]
                              (when (and b (or (and export-re (re-find export-re (str nm))) (and export-keys (export-keys k))))
                                (when-let [e (cond-> (export-entry b k (contains? #{:equal :equal-alloc-ids :equal-allocs} (first row)))
                                               ;; C6-4 (a): core's crate-private facts the body names, as alloc's export carries them
                                               export-keys (with-private-facts @native-all si-full))]
                                  ;; 479-2 (a): a body built without debug assertions that differs from rust-core-built's (whose
                                  ;; flags keep them: -C opt-level=0) is judged at the instance as an outside body is, against
                                  ;; rsi's record, whose std is built without them
                                  (swap! exported conj (if (or (= :no-oracle (first row)) (and (not *debug-assertions*) (not (:equal e))))
                                                         (assoc e :judge :instance) e))))
                              row)))
                {:keys [stages bodies native]} (binding [*only-key?* (or *only-key?* export-keys)]
                                                 (run-module m table (with-native-names names @native-all) std-file (with-native-std std @native-all) si lib-dir on-body))
                _ (when native (swap! native-all #(merge-with merge % native)))
                rows bodies
                fr (frequencies (map first rows))]
            (swap! totals #(merge-with + % fr))
            (println (format "core-check: %s stages %s bodies %d %s" (:path m) (pr-str stages) (count bodies) (pr-str fr)))
            (flush)
            (when verbose (doseq [r rows :when (not= :equal (first r))] (println "  " (pr-str r))))
            (println "  refusals:" (pr-str (frequencies (for [r rows :when (= :refused (first r))] (nth r 2)))))))
        ;; the negative control (GTS81 (a)): an equal body's text judged against another body's rustc text, which must differ
        (when-let [[k t] @control]
          (let [other (first (filter #(not= k %) (sort (keys oracle))))
                r (judge "control" (oracle-text (get oracle other)) t nil nil)]
            (println "core-check: control (" k "against" other "):" (if (#{:equal :equal-alloc-ids :equal-allocs :equal-crate-hash} (first r)) "PASSED (a bug)" "differs, as it must"))))
        (when-let [ef (System/getenv "CORE_EXPORT")]
          ;; the file's earlier entries kept but where this run exported the same body (by its key)
          (let [old (when (.exists (File. ^String ef))
                      (let [r (java.io.PushbackReader. (java.io.StringReader. (slurp ef)))]
                        (loop [acc []] (let [x (read {:eof ::eof} r)] (if (= x ::eof) acc (recur (conj acc (second x))))))))
                new-keys (set (map :key @exported))
                ;; queue 474: core's crate-private functions an exported body names (ub_checks' check_language_ub, a macro-made
                ;; precondition_check), and the crate-private impls and traits they belong to (core_simd's PrivateMethods), their
                ;; native facts, as lib-export's entries carry alloc's: the run prints their function constants' types and paths
                ;; from them (`fn() -> bool {core::ub_checks::check_language_ub}`, not `{no sig ..}`)
                nat @native-all
                ;; (rust-rec-1120: with-private-facts, C6-4 (a)'s, which carries these and the ADTs and enclosing functions too)
                with-facts (fn [e]
                             (if-not (:body e)
                               e
                               (let [e (with-private-facts e nat si-full)
                                     si si-full
                                     ts (or (:traits e) {})
                                     ;; queue 503: such a trait's impls (slice::cmp's SlicePartialEq: the PartialEq one and its
                                     ;; BytewiseEq specialization) with their methods' facts, so that the run selects the impl a
                                     ;; call resolves to (as lib-export's entries, alloc-check)
                                     impls-of (fn [trs] (into {} (for [[p m] (:impls nat)
                                                                       :when (and (sequential? (:trait m)) (contains? trs (nth (:trait m) 1)) (not (get-in si [:impls p])))]
                                                                   [p (dissoc m :native)])))
                                     tis (impls-of ts)
                                     ;; and the crate-private traits their where clauses name (the specialization's
                                     ;; `A: BytewiseEq<B>`), with those traits' impls, so that selection proves them
                                     pts (into {} (for [[_ m] tis pr (:predicates m)
                                                        :when (and (seq? pr) (= 'trait (first pr)))
                                                        :let [tp (second pr) tm (get-in nat [:traits tp])]
                                                        :when (and tm (not (get-in si [:traits tp])) (not (contains? ts tp)))]
                                                    [tp (dissoc tm :native)]))
                                     tis (merge (impls-of pts) tis)
                                     ts (merge pts ts)
                                     is (merge tis (:impls e))
                                     fs (merge (into {} (for [[_ m] tis [_ k fp] (:items m)
                                                              :let [f (when (= "AssocFn" k) (get-in nat [:fns fp]))]
                                                              :when (and f (not (get-in si [:fns fp])))]
                                                          [fp (dissoc f :native)]))
                                               (:fns e))]
                                 (cond-> e (seq fs) (assoc :fns fs) (seq is) (assoc :impls is) (seq ts) (assoc :traits ts)))))
                all (concat (remove #(new-keys (:key %)) old) (map with-facts @exported))]
            (spit ef (binding [*print-meta* true] (with-out-str (doseq [e all] (prn (list 'core/body e)))))))
          (println "core-check: exported" (count @exported) "bodies," (count (filter :equal @exported)) "equal to rustc's built MIR, to" ef))
        (spit native-file (pr-str @native-all))
        (println "core-check: native interface" (count (:fns @native-all)) "functions," (count (:adts @native-all)) "ADTs")
        (println "core-check: total" (pr-str @totals))))
    (System/exit 0))))

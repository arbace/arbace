;; RIND9 (a) (doc/rust/FRONTEND-SURVEY.md, "RIND stage 4 (C3, C4)", "As built: RIND9 (a), alloc's pass"): alloc's interface
;; built natively from its own sources (rust-src 1.99.1's library/alloc, pinned by tools/rsdump/apks.sha256), on the model of
;; core-check's interface pass, and compared fact by fact with the helper's std-iface; rustc is dual-licensed MIT OR
;; Apache-2.0 (LICENSE.md, "Rust (rustc 1.99.1)").

(ns arbace.rust.front.alloc-check
  "RIND9 (a): alloc's interface pass. Each module file of alloc read by the native reader, expanded (alloc's own
  macro_rules! from its sources, core's and std's from std-names), resolved, lowered and collected (no body built), its
  functions, ADTs, traits, impls and constants written by core-check's native-iface in the helper's --std-iface forms. The
  pass reads std's interface with every alloc fact taken out (without-crate): what it writes of alloc is its own, read
  back by the modules after it (and, ALLOC_IFACE_ROUNDS=2, by a second round over every module, each module's own facts
  of the first round left out). The compare holds every alloc fact of the helper's std-iface to the native one: equal,
  differing (the keys that differ), missing (the helper's, not written natively), and the native's extras (crate-private
  items the helper does not write) counted apart; a negative control judges an equal fact against another path's.

    bin/rust-front alloc-iface [FILE...]       the pass (every module file, or FILEs) then the compare (the day's proof)
    bin/rust-front alloc-iface --list          alloc's module files
    bin/rust-front alloc-iface --units         the unit cases (light: under 1 GiB)"
  (:require [arbace.rust.front.core-check :as cc]
            [arbace.rust.front.collect :as collect]
            [arbace.rust.front.resolve :as resolve]
            [arbace.string :as str])
  (:import [java.io File]))

(def ^:dynamic *tag*
  "The output lines' prefix (round 54: std-iface for std's pass)"
  "alloc-iface")

(def kinds
  "The helper's std-iface kinds: the form's head and the load-std-iface key"
  [['si/fn :fns] ['si/adt :adts] ['si/trait :traits] ['si/impl :impls] ['si/const :consts]])

;; ---------------------------------------------------------------------------------------------
;; A crate's facts

(defn crate-path? [^String crate ^String p] (or (= p crate) (str/starts-with? p (str crate "::"))))

(defn crate-facts
  "The facts of std's interface (load-std-iface's map) whose path is CRATE's: {:fns {p m} :adts .. :traits .. :impls ..
  :consts ..}"
  [si crate]
  (into {} (for [[_ k] kinds] [k (into {} (filter #(crate-path? crate (key %)) (get si k)))])))

(defn without-crate
  "std's interface with CRATE's facts taken out (its impls out of the selection indexes too): what the pass may read"
  [si crate]
  (let [gone? #(crate-path? crate %)
        drop-ps (fn [ps] (vec (remove gone? ps)))]
    (-> (reduce (fn [si [_ k]] (update si k #(into {} (remove (comp gone? key) %)))) si kinds)
        (update :inherent #(into {} (for [[t ps] %] [t (drop-ps ps)])))
        (update :trait-impls #(into {} (for [[t ps] %] [t (drop-ps ps)])))
        (update :trait-impls-by #(into {} (for [[t by] %] [t (into {} (for [[x ps] by] [x (drop-ps ps)]))]))))))

(defn owner
  "The module file a path belongs to: the longest of MOD-PATHS that is the path or prefixes it at a `::`"
  [mod-paths ^String p]
  (reduce (fn [best ^String m]
            (if (and (or (= p m) (str/starts-with? p (str m "::"))) (> (count m) (count (or best ""))))
              m best))
          nil mod-paths))

(defn facts-of-modules
  "FACTS (crate-facts' shape) restricted to the paths whose owner (among MOD-PATHS) is in MODS"
  [facts mod-paths mods]
  (let [ms (set mods)]
    (into {} (for [[k m] facts] [k (into {} (filter #(ms (owner mod-paths (key %))) m))]))))

(defn without-modules
  "FACTS with the paths owned by MODS taken out (a second round's module rewrites its own)"
  [facts mod-paths mods]
  (let [ms (set mods)]
    (into {} (for [[k m] facts] [k (if (map? m) (into {} (remove #(ms (owner mod-paths (key %))) m)) m)]))))

;; ---------------------------------------------------------------------------------------------
;; The helper's shape: one form a fact, its keys in the helper's order

(def key-order
  {:fns [:generics :parent-count :has-self :predicates :inputs :output :variadic :safety :abi :const :promotable :nounwind]
   :adts [:kind :generics :parent-count :has-self :variants :repr :discrs]
   :traits [:generics :parent-count :has-self :predicates :items]
   :impls [:trait :negative :self :generics :parent-count :has-self :predicates :items]
   :consts [:kind :ty :value]})

(defn strip "A native fact as the helper's (the pass's own mark dropped)" [m] (dissoc m :native))

(defn fact-form
  "A fact as the helper's line: (si/fn \"PATH\" {..}), the map's keys in the helper's order"
  [head k p m]
  (let [m (strip m)
        ks (concat (filter #(contains? m %) (key-order k)) (sort (remove (set (key-order k)) (keys m))))]
    (str "(" head " " (pr-str p) " {" (str/join " " (for [x ks] (str (pr-str x) " " (pr-str (get m x))))) "})")))

(defn facts-text "FACTS as the helper's std-iface lines, by kind then path" [facts]
  (str/join "" (for [[head k] kinds [p m] (sort-by key (get facts k))] (str (fact-form head k p m) "\n"))))

(defn read-facts "The facts of a file in the helper's shape (an std-iface, or the pass's output)" [^String f]
  (let [si (collect/load-std-iface f)] (into {} (for [[_ k] kinds] [k (get si k {})]))))

;; ---------------------------------------------------------------------------------------------
;; The compare, fact by fact

(defn diff-keys
  "The keys whose values differ between the helper's fact H and the native N (round 52: a constant's :value, which std's
  interface never writes and the pass keeps for its own readers, compared only when the helper's fact has one)"
  [h n]
  ;; C4: likewise a function's :self-param (472's method lookup), which the native pass writes and the helper's interface does not
  (let [n (cond-> (strip n) (not (contains? h :value)) (dissoc :value) (not (contains? h :self-param)) (dissoc :self-param))]
    (vec (sort (filter #(not= (get h %) (get n %)) (distinct (concat (keys h) (keys n))))))))

(defn compare-facts
  "Every helper fact against the native one: {kind {:equal N :differs [[path keys]] :missing [path] :extra [path]}}"
  [helper native]
  (into (sorted-map)
        (for [[_ k] kinds
              :let [h (get helper k {}) n (get native k {})]]
          [k (reduce (fn [acc [p hm]]
                       (if-let [nm (get n p)]
                         (let [d (diff-keys hm nm)]
                           (if (empty? d) (update acc :equal inc) (update acc :differs conj [p d])))
                         (update acc :missing conj p)))
                     {:equal 0 :differs [] :missing [] :extra (vec (sort (remove #(contains? h %) (keys n))))}
                     (sort-by key h))])))

(defn control
  "The negative control (GTS81 (a)): an equal fact judged against another path's helper fact of its kind, which must
  differ; [path other differs?] or nil when no fact is equal. Round 52 (n-rust-alloc5): POOL (the crate's helper facts) gives
  the other fact when HELPER has none of the kind beside it (a module of one fact, fmt.rs' format)"
  ([helper native] (control helper native nil))
  ([helper native pool]
   (first (for [[_ k] kinds
                :let [h (get helper k {}) n (get native k {})]
                [p hm] (sort-by key h)
                :let [nm (get n p)]
                :when (and nm (empty? (diff-keys hm nm)))
                :let [pick (fn [fs] (first (filter #(and (not= p (key %)) (not= hm (val %))) (sort-by key fs))))
                      other (or (pick h) (pick (get pool k {})))]
                :when other]
            [p (key other) (boolean (seq (diff-keys (val other) nm)))]))))

(defn summary-lines
  "The compare's lines: one a kind (helper facts, equal, differing, missing, native extras), then the total"
  [cmp]
  (let [line (fn [nm {:keys [equal differs missing extra]}]
               (format (str *tag* ": %s %d facts: %d equal, %d differ, %d missing (native extras %d)")
                       nm (+ equal (count differs) (count missing)) equal (count differs) (count missing) (count extra)))
        tot (reduce (fn [a [_ v]] (merge-with (fn [x y] (if (number? x) (+ x y) (into x y))) a v)) {:equal 0 :differs [] :missing [] :extra []} cmp)]
    (concat (for [[k v] cmp] (line (name k) v)) [(line "total" tot)])))

(defn report-text
  "The compare in full: the differing facts with their keys, by the keys' set (the causes first; with HELPER and NATIVE the
  first fact's two values of those keys), then the missing ones"
  [cmp & [helper native]]
  (with-out-str
    (doseq [l (summary-lines cmp)] (println l))
    (doseq [[k {:keys [differs missing extra]}] cmp]
      (println)
      (println (str ";; " (name k) ": differing facts by the keys that differ"))
      (doseq [[ks ps] (sort-by (comp - count val) (group-by second differs))]
        (println (pr-str ks) (count ps) (pr-str (vec (take 5 (map first ps)))))
        (when (and helper native)
          (let [p (ffirst ps)]
            (doseq [x ks]
              (println "   helper" (pr-str x) (pr-str (get-in helper [k p x])))
              (println "   native" (pr-str x) (pr-str (get (strip (get-in native [k p])) x)))))))
      (println (str ";; " (name k) ": missing (" (count missing) ")"))
      (doseq [p missing] (println " " p))
      (println (str ";; " (name k) ": native extras (" (count extra) ")"))
      (doseq [p extra] (println " " p)))))

;; ---------------------------------------------------------------------------------------------
;; The pass

(declare pass)

(defn- cached
  "The value of FILE (read back) when it exists, else MAKE's, written there (CACHE-DIR's files: remove them after a change
  to the reader, the expansion or the collection, as index.edn)"
  [^String file make]
  (let [c (File. file)]
    (if (.exists c)
      (read-string (slurp c))
      (let [v (make)] (.mkdirs (.getParentFile c)) (spit c (pr-str v)) v))))

(defn deps-setup
  "queue 400: std's vendored dependencies (cc/dep-crates: libc, hashbrown; library/vendor/NAME-VERSION, their cfg
  cc/crate-cfg's) read natively before std, as the helper's std-names and std-iface hold none of their names or facts: each
  one's module files, its index (macros and names from the sources) and its interface pass (DEPS_IFACE_ROUNDS rounds, default 2:
  libc's aliases name each other across its files) over std's names and interface; {:names {MODULE {:kind :children ..}}
  (each crate's index with its macro-made ADTs, libc's `s! { .. }` structs, as with-core-names takes it) :native FACTS
  (their ADTs, aliases with their generics, functions, traits, impls, constants)}; each piece cached in CACHE-DIR/deps/"
  [^String lib-dir ^String std-file si-full ^String cache-dir]
  (let [rounds (Long/parseLong (or (System/getenv "DEPS_IFACE_ROUNDS") "2"))]
    (reduce
     (fn [acc dep]
       (binding [cc/*crate* dep *tag* (str dep "-iface")]
         (let [d (str cache-dir "/deps/" dep)
               mods (cached (str d "-modules.edn") #(cc/module-files lib-dir))
               index (cached (str d "-index.edn")
                             #(let [t (cc/crate-index (remove :vendored mods))]
                                (println (str *tag* ":") dep "'s index over" (count mods) "files:" (count (:macros t)) "macros," (count (:names t)) "modules")
                                t))
               names (cc/with-core-names (resolve/load-std-names std-file) (:names index))
               std (assoc (cc/with-core-kinds (collect/load-std std-file) (:names index)) :mods names)
               native (cached (str d "-iface.edn")
                              #(pass dep lib-dir {:std-file std-file :std std :si si-full :table (:macros index) :names names}
                                     mods (map :path mods) rounds))]
           (println (format (str *tag* ": %s: %d module files, %d functions, %d ADTs, %d aliases, %d traits, %d impls")
                            dep (count mods) (count (:fns native)) (count (:adts native)) (count (:aliases native))
                            (count (:traits native)) (count (:impls native))))
           (-> acc
               (update :names merge (cc/with-adt-names (:names index) (:adts native)))
               (update :native #(merge-with merge % native))))))
     {:names {} :native {}} cc/dep-crates)))

(defn crate-setup
  "The pass's inputs over front-dir's std-names and std-iface, the crate's index (cached in CACHE-DIR/index.edn): {:std-file
  :std :si (std's interface less the crate's facts) :helper (the crate's facts) :table :names}; queue 400: for std with
  LIB-DIR, its vendored dependencies' names and facts (deps-setup) read before std's own (STD_DEPS=0: not)"
  [crate front-dir cache-dir mods & [lib-dir]]
  (let [std-file (str front-dir "/std-names.edn")
        si-full (collect/load-std-iface (str front-dir "/std-iface.edn"))
        index (let [cache (File. (str cache-dir "/index.edn"))]
                (if (.exists cache)
                  (read-string (slurp cache))
                  (let [t (binding [cc/*crate* crate] (cc/crate-index (remove :vendored mods)))]
                    (println (str *tag* ":") crate "'s index over" (count mods) "files:" (count (:macros t)) "macros," (count (:names t)) "modules")
                    (.mkdirs (File. ^String cache-dir))
                    (spit cache (pr-str t)) t)))
        deps (when (and lib-dir (= crate "std") (not= "0" (System/getenv "STD_DEPS")))
               (deps-setup lib-dir std-file si-full cache-dir))
        base (cond-> (resolve/load-std-names std-file) deps (cc/with-core-names (:names deps)))
        names (cc/with-core-names base (:names index))
        std (assoc (cc/with-core-kinds (cond-> (collect/load-std std-file) deps (cc/with-core-kinds (:names deps))) (:names index)) :mods names)
        std (cond-> std deps (cc/with-native-std (:native deps)))
        si (cond-> (without-crate si-full crate) deps (cc/with-native-iface (:native deps)))]
    {:std-file std-file :std std :si si :helper (crate-facts si-full crate)
     ;; C4 (2026-11-22): core's vendored portable-simd modules' own macro_rules! beside the index's (non-vendored) ones, nearest
     ;; first as macros-for picks them (vendor.rs' from_transmute! for vendor/x86.rs: core_simd::vendor::x86 unexpanded before,
     ;; its 60 From impls missing); stdarch's not (its files are std_names' scans')
     :table (if (= "core" crate)
              (merge-with into (:macros index)
                          (binding [cc/*crate* crate] (cc/macro-table (filter #(and (:vendored %) (re-find #"/portable-simd/" (str (:file %)))) mods))))
              (:macros index))
     :names names :index (:names index)}))

(defn pass
  "The interface pass over MODS (in order) for ROUNDS rounds: the native facts {:fns :adts :traits :impls :consts :aliases
  :alias-generics}; each module's stages printed"
  [crate lib-dir {:keys [std-file std si table names index]} mods all-mod-paths rounds]
  (let [native (atom {}) names0 names]
    (binding [cc/*crate* crate]
      (dotimes [r rounds]
        (let [t0 (System/nanoTime) prev @native
              ;; queue 417: a later round of std's pass: the macro-made structs of the round before (sys/fs/unix.rs'
              ;; `cfg_has_statx! {{ pub struct FileAttr .. } else { .. }}`, which the index, read unexpanded, lacks) taken
              ;; through the index's re-exports and globs again (sys/fs/mod.rs' `pub use imp::{.., FileAttr, ..}`), as
              ;; with-core-names takes the index's own definitions: fs.rs' `Metadata(fs_imp::FileAttr)`
              names (if (and (pos? r) index (= "std" crate)) (cc/with-core-names (cc/with-native-names names0 prev) index) names0)]
          (reset! native (if (zero? r) {} (without-modules prev all-mod-paths (map :path mods))))
          (doseq [m mods]
            (let [t1 (System/nanoTime)
                  ;; a later round: the other modules' facts of the round before, this module's own written again
                  seen (if (zero? r) @native (merge-with merge (without-modules prev all-mod-paths [(:path m)]) @native))
                  {stages :stages nat :native}
                  (binding [cc/*collect-only* true]
                    (cc/run-module m table (cc/with-native-names names seen) std-file (cc/with-native-std std seen)
                                   (cc/with-native-iface si seen) lib-dir identity))]
              (when nat (swap! native #(merge-with merge % nat)))
              (println (format (str *tag* ": round %d %s stages %s: %d fns, %d ADTs, %d traits, %d impls (%d s)") (inc r) (:path m) (pr-str stages)
                               (count (:fns nat)) (count (:adts nat)) (count (:traits nat)) (count (:impls nat)) (quot (- (System/nanoTime) t1) 1000000000)))
              (flush)))
          (println (format (str *tag* ": round %d over %d files: %d functions, %d ADTs, %d traits, %d impls, %d consts (%d s)") (inc r) (count mods)
                           (count (:fns @native)) (count (:adts @native)) (count (:traits @native)) (count (:impls @native)) (count (:consts @native))
                           (quot (- (System/nanoTime) t0) 1000000000))))))
    @native))

(defn read-modules "core-check --list's lines as module maps" [^String f]
  (vec (for [l (str/split-lines (slurp f)) :when (seq (str/trim l)) :let [[p fl v src] (str/split l #" ")]]
         (cond-> {:path p :file fl :vendored (= v "vendored")} (seq src) (assoc :src src)))))

(defn fndef-types
  "The types (the :tc metadata) of a body's forms, a vector of them"
  [body]
  (let [acc (transient [])]
    (letfn [(w [x] (when-let [t (:tc (meta x))] (conj! acc t))
                   (cond (map? x) (doseq [v (vals x)] (w v)) (coll? x) (doseq [y x] (w y))))]
      (w body))
    (persistent! acc)))

(defn core-consts
  "queue 443: the associated constants of core's traits in core's FILES (relative to core/src: `mem/mod.rs`'s
  SizedTypeProperties::IS_ZST, LAYOUT, MAX_SLICE_LEN), which std's interface does not write and alloc's and std's bodies name:
  core's interface pass (core-check's, over CORE-LIB, core's patched copy, with core-check's index and modules in CORE-CACHE)
  over FILES, its :consts kept; {path fact}"
  [^String core-lib ^String core-cache ^String std-file si-full files]
  (binding [cc/*crate* "core"]
    (let [mods (read-modules (str core-cache "/modules.txt"))
          by-file (into {} (for [m mods] [(:file m) m]))
          index (read-string (slurp (str core-cache "/index.edn")))
          names (cc/with-adt-names (cc/with-core-names (resolve/load-std-names std-file) (:names index)) (:adts si-full))
          std (assoc (cc/with-core-kinds (collect/load-std std-file) (:names index)) :mods names)
          acc (atom {})]
      (doseq [f files :let [m (get by-file (.getCanonicalPath (File. (str core-lib "/core/src/" f))))]]
        (if-not m
          (println (str *tag* ": core-consts: not a module file of core: " f))
          (let [{:keys [native stages]} (binding [cc/*collect-only* true] (cc/run-module m (:macros index) names std-file std si-full core-lib identity))]
            (swap! acc merge (into {} (filter #(str/starts-with? (key %) (str (:path m) "::")) (:consts native))))
            (println (str *tag* ": core-consts: " (:path m) " stages " (pr-str stages) ": " (count (:consts native)) " constants")))))
      @acc)))

(defn -main [& argv]
  ;; round 54 (RIND9 (a), std): `--crate C` first names the crate (alloc by default; std over the linux `sys`)
  (let [[crate cmd & args] (if (= "--crate" (first argv)) (rest argv) (cons "alloc" argv))]
  (binding [cc/*crate* crate *tag* (str crate "-iface")
            ;; queue 462: --export's bodies are judged against rsi's records, whose std is built without debug assertions
            cc/*debug-assertions* (not= "--export" cmd)]
    (case cmd
      ;; --list LIB: alloc's module files (core-check --list's lines)
      "--list" (doseq [m (cc/module-files (first args))] (println (str/trimr (str (:path m) " " (:file m) " " (if (:vendored m) "vendored" "") (when (:src m) (str " " (:src m)))))))
      ;; --pass LIB FRONT CACHE MODULES OUT [FILE...]: the pass (ALLOC_IFACE_ROUNDS, default 2 since round 54, RIND9a-15 (a)) into OUT (the helper's
      ;; shape), then the compare with the helper's facts of the modules passed into OUT.report, its summary printed
      "--pass"
      (let [[lib front cache modules-file out & files] args
            mods (read-modules modules-file)
            by-file (into {} (for [m mods] [(:file m) m]))
            sel (if (seq files)
                  (vec (for [f files :let [m (get by-file (.getCanonicalPath (File. ^String f)))]] (or m (throw (ex-info (str "not a module file of " crate ": " f) {})))))
                  mods)
            setup (crate-setup crate front cache mods lib)
            rounds (Long/parseLong (or (System/getenv "ALLOC_IFACE_ROUNDS") "2"))
            mod-paths (map :path mods)
            native (pass crate lib setup sel mod-paths rounds)
            facts (crate-facts native crate)
            helper (facts-of-modules (:helper setup) mod-paths (map :path sel))
            cmp (compare-facts helper facts)]
        (spit out (facts-text facts))
        ;; C4-1 (a): the pass's whole native map too (its aliases and their generics beside the facts), std's names' input
        (spit (str out ".native.edn") (pr-str (select-keys native [:fns :adts :traits :impls :consts :aliases :alias-generics])))
        (spit (str out ".report") (report-text cmp helper facts))
        (doseq [l (summary-lines cmp)] (println l))
        (when-let [[p o d] (control helper facts)]
          (println (str *tag* ": control (") p "against" o "):" (if d "differs, as it must" "PASSED (a bug)")))
        (println (str *tag* ": wrote") out "and" (str out ".report")))
;; queue 443 (RUST-90 S4, C2): --export LIB FRONT CACHE MODULES OUT KEYS-FILE: the crate's bodies whose keys
      ;; (body-key's, `boxed-{impl#0}-new`, one a line: the defs rsi's samples instantiate) KEYS-FILE lists, with their
      ;; closures, built through the 21 passes on the crate's native interface (the pass over every module file, cached in
      ;; CACHE/native-iface.edn: remove it after a change to the front end) and written as core-export's entries into OUT
      ;; (`(core/body {..})`, :judge :instance: no built-MIR oracle of the crate, each instance judged against the record's
      ;; body at the run, build-run's pack-compare); a line a module (wanted, built, refused, and why)
      "--export"
      (let [[lib front cache modules-file out keys-file] args
            mods (read-modules modules-file)
            setup (crate-setup crate front cache mods lib)
            mod-paths (map :path mods)
            by-path (into {} (for [m mods] [(:path m) m]))
            si-full (collect/load-std-iface (str front "/std-iface.edn"))
            nf (File. (str cache "/native-iface-nodebug.edn"))   ; queue 462: the pass without debug assertions
            native (if (.exists nf)
                     (read-string (slurp nf))
                     (let [n (pass crate lib setup mods mod-paths (Long/parseLong (or (System/getenv "ALLOC_IFACE_ROUNDS") "2")))]
                       (spit nf (pr-str n)) n))
            ;; queue 443: core's traits' associated constants (LIB_CORE_CONSTS, core/src files; LIB_CORE_DIR, LIB_CORE_CACHE
            ;; core-check's copy and caches), which std's interface lacks and the bodies name (`T::IS_ZST`)
            native (if-let [cf (System/getenv "LIB_CORE_CONSTS")]
                     (update native :consts merge
                             (core-consts (System/getenv "LIB_CORE_DIR") (System/getenv "LIB_CORE_CACHE") (:std-file setup)
                                          si-full (str/split cf #" ")))
                     native)
            want (set (for [l (str/split-lines (slurp keys-file)) :let [l (str/trim l)] :when (seq l)] l))
            key-path (fn [k] (str crate "::" (str/replace k "-" "::")))
            ;; each wanted key's module: the longest module path owning its def path (a module's own key is its path less the crate)
            by-mod (group-by #(owner mod-paths (key-path %)) want)
            pred (fn [k] (or (contains? want k) (boolean (some #(str/starts-with? k (str % "-{closure#")) want))))
            entries (atom [])]
        (println (format (str *tag* ": export: %d keys in %d modules (%d without a module)") (count want) (count (dissoc by-mod nil)) (count (get by-mod nil))))
        (doseq [[mp ks] (sort-by key (dissoc by-mod nil)) :let [m (get by-path mp)]]
          (let [t0 (System/nanoTime)
                {:keys [stages bodies]}
                (binding [cc/*only-key?* pred]
                  (cc/run-module m (:table setup) (cc/with-native-names (:names setup) native) (:std-file setup)
                                 (cc/with-native-std (:std setup) native) (cc/with-native-iface (:si setup) native) lib
                                 (fn [[[nm k] b err detail]]
                                   (let [e (if b
                                             ;; the crate-private facts the body names (cc/with-private-facts: queue 443's
                                             ;; functions, 462's impls and traits, C6-4's ADTs and enclosing functions)
                                             (let [e (cc/with-private-facts (assoc (cc/export-entry b k nil) :judge :instance) native si-full)
                                                   ts (or (:traits e) {})
                                                   ;; queue 503: such a trait's impls (to_vec_in's ConvertVec, defined inside the
                                                   ;; body: `impl<T: Clone>` and its specialization `impl<T: Copy>`), with their
                                                   ;; methods' facts, so that the run selects the impl a call resolves to
                                                   tis (into {} (for [[p m] (:impls native)
                                                                      :when (and (sequential? (:trait m)) (contains? ts (nth (:trait m) 1))
                                                                                 (not (get-in si-full [:impls p])))]
                                                                  [p (dissoc m :native)]))
                                                   is (merge tis (:impls e))
                                                   fs (merge (into {} (for [[_ m] tis [_ k fp] (:items m)
                                                                            :let [f (when (= "AssocFn" k) (get-in native [:fns fp]))]
                                                                            :when (and f (not (get-in si-full [:fns fp])))]
                                                                        [fp (dissoc f :native)]))
                                                             (:fns e))]
                                               (cond-> e (seq fs) (assoc :fns fs) (seq is) (assoc :impls is) (seq ts) (assoc :traits ts)))
                                             {:key k :refused (str "the build: " err (when (and detail (not= "nil" detail)) (str " " detail)))})]
                                     (swap! entries conj (assoc e :module mp :name nm))
                                     e))))
                got (set (map :key bodies))
                ok (count (filter :body bodies))]
            (println (format (str *tag* ": export %s stages %s: wanted %d, built %d of %d bodies (%d s)%s") mp (pr-str stages) (count ks) ok (count bodies)
                             (quot (- (System/nanoTime) t0) 1000000000)
                             (let [miss (remove got ks)] (if (seq miss) (str "; not built: " (str/join " " (take 8 (sort miss)))) ""))))
            (doseq [e bodies :when (:refused e)] (println "  refused" (:key e) (subs (str (:refused e)) 0 (min 240 (count (str (:refused e)))))))
            (flush)))
        (spit out (binding [*print-meta* true] (with-out-str (doseq [e @entries :when (:body e)] (prn (list 'core/body (dissoc e :module)))))))
        (spit (str out ".tsv") (str/join "" (for [e @entries] (str (:module e) "\t" (:key e) "\t" (if (:body e) "built" (str "refused\t" (:refused e))) "\n"))))
        (println (str *tag* ": exported") (count (filter :body @entries)) "bodies," (count (remove :body @entries)) "refused, to" out))
      ;; queue 400: --deps LIB FRONT CACHE: std's vendored dependencies' names and facts (deps-setup) made into CACHE/deps/
      "--deps"
      (let [[lib front cache] args]
        (deps-setup lib (str front "/std-names.edn") (collect/load-std-iface (str front "/std-iface.edn")) cache))
      ;; C4 (doc/rust/FRONTEND-SURVEY.md, "As built: C4's switch"): --assemble OUT CRATE=FILE...: std's interface made of the
      ;; crates' native passes alone, each FILE a pass's output (the helper's shape, `(si/..` lines) or its native map (a cache,
      ;; native-iface.edn), CRATE's facts taken from it; OUT in the helper's std-iface shape, what a run's front directory reads
      "--assemble"
      (let [[out & specs] args
            facts (reduce (fn [acc spec]
                            (let [[c f] (str/split spec #"=" 2)
                                  t (slurp f)
                                  fs (if (str/starts-with? (str/triml t) "(") (read-facts f) (crate-facts (read-string t) c))]
                              (println (str "alloc-iface: --assemble: " c " from " f ": "
                                            (str/join ", " (for [[_ k] kinds] (str (count (get fs k)) " " (name k))))))
                              (merge-with merge acc (crate-facts fs c))))
                          {} specs)]
        (spit out (facts-text facts))
        (println "alloc-iface: --assemble: wrote" out (str "(" (reduce + (map count (vals facts))) " facts)")))
      ;; --compare FRONT NATIVE [MODULES]: the compare of a pass's output alone
      "--compare"
      (let [[front nat modules-file] args
            helper (crate-facts (collect/load-std-iface (str front "/std-iface.edn")) crate)
            facts (read-facts nat)
            cmp (compare-facts helper facts)]
        (spit (str nat ".report") (report-text cmp helper facts))
        (doseq [l (summary-lines cmp)] (println l))))
    (System/exit 0))))

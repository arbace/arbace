;; C6-2 (b) (the user, 2026-11-20; doc/rust/FRONTEND-SURVEY.md, "As built: C6-2, Cargo's metadata hash"): Cargo's `-C metadata` of
;; a unit, ported from Cargo 0.100.0 (cargo 1.99.1, git 5f94df478, the pinned rustc-1.99.1-src.tar.xz's src/tools/cargo):
;; src/compiler/build_runner/compilation_files.rs (compute_metadata, hash_rustc_version), src/workspace/{package_id,source_id}.rs
;; (stable_hash), src/workspace/profiles.rs (Profile's comparable hash, Lto, PanicStrategy, Strip), src/compiler/{build_config,lto,
;; compile_kind,crate_type}.rs, src/workspace/manifest.rs (TargetKind), crates/cargo-util-schemas (SourceKind, TomlDebugInfo,
;; TomlTrimPaths); semver 1.0.28's Version hash; rustc-stable-hash 0.1.2's StableSipHasher128 (its writes; mono/sip128 the
;; SipHasher128). Cargo and those crates are dual-licensed MIT OR Apache-2.0 (LICENSE.md, "Rust (rustc 1.99.1)"). Read with the
;; Clojure reader.

(ns arbace.rust.front.cargo-meta
  "Cargo's metadata hash and std's StableCrateIds computed natively (C6-2 (b), C4's identities). A unit of the library build
  (`test/rust/front/std-build-units.edn`: the package, its features, profile, mode, LTO, kind, target and dependencies) hashes
  as Cargo's compute_metadata hashes it, the dependencies' `-C metadata` sorted and mixed in; a crate's StableCrateId is then
  rustc's StableCrateId::new over its `-C metadata` (mono/stable-crate-id). The bytes are those Rust's Hash writes into
  rustc-stable-hash's StableSipHasher128 (integers little-endian, usize as u64, a small isize one byte, a str its bytes and
  0xFF, a sequence its length first); Hasher::finish is the SipHasher128's halves a * 3 + b.

    units UNIT-GRAPH.json RUSTC-VV OUT.edn   Cargo's `--unit-graph` of the library build (the oracle tier, by hand) written as
                                             the units' description (the source paths relative to the workspace)
    ids UNITS.edn [CHECK]                    each unit's -C metadata and core's, alloc's and std's StableCrateIds; CHECK (lines
                                             `CRATE HEX`, cargo -v's) compared unit by unit"
  (:require [arbace.rust.front.mono :as mono]
            [arbace.string :as str])
  (:import [java.io File]))

;; ---------------------------------------------------------------------------------------------
;; Rust's Hash over StableSipHasher128, as bytes

(defn- le [x ^long n] (let [x (long x)] (for [i (range n)] (bit-and (unsigned-bit-shift-right x (* 8 i)) 0xff))))
(defn- utf8 [^String s] (map #(bit-and (long %) 0xff) (.getBytes s "UTF-8")))
(defn h-u8 [x] [(bit-and (long x) 0xff)])
(defn h-bool [b] [(if b 1 0)])
(defn h-u32 [x] (le x 4))
(defn h-u64 "u64, and usize (write_usize: always 8 bytes)" [x] (le x 8))
(defn h-isize "write_isize: a value under 0xFF one byte, else 0xFF and 8 bytes (an enum's discriminant)" [x]
  (let [x (long x)] (if (and (>= x 0) (< x 0xff)) [x] (cons 0xff (le x 8)))))
(defn h-str "str's Hash: its bytes, then 0xFF" [s] (concat (utf8 (str s)) [0xff]))
(defn h-opt "Option's derived Hash" [f x] (if (nil? x) (h-isize 0) (concat (h-isize 1) (f x))))
(defn h-vec "a slice's Hash: its length (usize), then each" [f xs] (concat (h-u64 (count xs)) (mapcat f xs)))

(defn finish "Hasher::finish of StableSipHasher128 over BYTES: SipHasher128's halves a * 3 + b, wrapping (a long's bits)" [bytes]
  (let [[a b] (mono/sip128 bytes)] (unchecked-add (unchecked-multiply (long a) 3) (long b))))

(defn hex16 [x] (mono/hex16 (long x)))

;; ---------------------------------------------------------------------------------------------
;; Cargo's types

(def ^:private source-kinds {:git 0 :path 1 :registry 2 :sparse-registry 3 :local-registry 4 :directory 5})
(def ^:private modes {:test 0 :build 1 :check 2 :doc 3 :doctest 4 :docscrape 5 :run-custom-build 6})
(def ^:private ltos {:run 0 :off 1 :only-bitcode 2 :object-and-bitcode 3 :only-object 4})
(def ^:private crate-types {:bin 0 :lib 1 :rlib 2 :dylib 3 :cdylib 4 :staticlib 5 :proc-macro 6})
(def ^:private target-kinds {:lib 0 :bin 1 :test 2 :bench 3 :example-lib 4 :example-bin 5 :custom-build 6})
(def ^:private debuginfos {:none 0 :line-directives-only 1 :line-tables-only 2 :limited 3 :full 4})
(def ^:private panics {:unwind 0 :abort 1 :immediate-abort 2})
(def ^:private trim-values {:diagnostics 0 :macro 1 :object 2})

(defn h-version "semver's Version: major, minor, patch, pre, build" [^String v]
  (let [[core build] (str/split v #"\+" 2) [core pre] (str/split core #"-" 2) [a b c] (map #(Long/parseLong %) (str/split core #"\."))]
    (concat (h-u64 a) (h-u64 b) (h-u64 c) (h-str (or pre "")) (h-str (or build "")))))

(defn h-source "SourceId::stable_hash: its kind's discriminant, then a path source's path relative to the workspace, else its URL"
  [[kind x]] (concat (h-isize (source-kinds kind)) (h-str x)))

(defn h-profile
  "Profile's hash, its comparable tuple: opt_level, lto, codegen_backend, codegen_units, debuginfo, split_debuginfo,
  debug_assertions, overflow_checks, rpath, (incremental, panic, strip), rustflags, trim_paths"
  [p]
  (let [[lk lv] (:lto p)]
    (concat (h-str (:opt-level p))
            (case lk :off (h-isize 0) :bool (concat (h-isize 1) (h-bool lv)) :named (concat (h-isize 2) (h-str lv)))
            (h-opt h-str (:codegen-backend p))
            (h-opt h-u32 (:codegen-units p))
            (h-isize (debuginfos (:debuginfo p)))
            (h-opt h-str (:split-debuginfo p))
            (h-bool (:debug-assertions p)) (h-bool (:overflow-checks p)) (h-bool (:rpath p))
            (h-bool (:incremental p)) (h-isize (panics (:panic p)))
            (let [[sk sv] (:strip p)] (if (= :none sk) (h-isize 0) (concat (h-isize 1) (h-str sv))))
            (h-vec h-str (:rustflags p))
            (h-opt (fn [t] (if (= :all t) (h-isize 1) (concat (h-isize 0) (h-vec #(h-isize (trim-values %)) t)))) (:trim-paths p)))))

(defn kind-fingerprint "CompileKind::fingerprint_hash: the host 0, a target tuple its name's StableHasher" [kind]
  (if (= :host kind) 0 (finish (h-str (second kind)))))

(defn h-target-kind [[k cts]]
  (concat (h-isize (target-kinds k))
          (when (#{:lib :example-lib} k) (h-vec #(h-isize (crate-types %)) cts))))

(defn shared-bytes
  "compute_metadata's shared hasher's bytes for unit U (rustc's -vV lines RUSTC-LINES)"
  [u rustc-lines]
  (concat (h-u8 2)                                   ; METADATA_VERSION
          (h-str (:name u)) (h-version (:version u)) (h-source (:source u))
          (h-vec h-str (:features u))
          (h-profile (:profile u))
          (h-isize (modes (:mode u)))
          (let [[l x] (if (vector? (:lto u)) (:lto u) [(:lto u)])] (concat (h-isize (ltos l)) (when (= :run l) (h-opt h-str x))))
          (h-u64 (kind-fingerprint (:kind u)))
          (h-str (:target-name u)) (h-target-kind (:target-kind u))
          ;; hash_rustc_version, a stable rustc: each line of `rustc -vV` but a target unit's `host: ` line
          (mapcat h-str (remove #(and (not= :host (:kind u)) (str/starts-with? % "host: ")) rustc-lines))
          (h-bool (:is-std u))))

(defn- ucmp [a b] (Long/compareUnsigned (long a) (long b)))

(defn c-metadata
  "Each unit's -C metadata (a long's bits): {index value}, over the description D ({:rustc-vv TEXT :units [..]})"
  [d]
  (let [units (:units d) lines (str/split-lines (:rustc-vv d)) memo (atom {})]
    (letfn [(meta-of [i]
              (or (get @memo i)
                  (let [u (nth units i)
                        deps (sort ucmp (map meta-of (:deps u)))
                        m (finish (concat (shared-bytes u lines) (h-vec h-u64 deps)))]
                    (swap! memo assoc i m)
                    m)))]
      (into (sorted-map) (for [i (range (count units))] [i (meta-of i)])))))

(defn crate-ids
  "The library build's crates' {name {:metadata HEX :stable-crate-id HEX}}: StableCrateId::new(name, a library, [its -C metadata],
  the compiler's version); queue 542 (C6): every target unit's crate (libc, hashbrown, unwind, the backtrace crates: the
  foreign functions' and the dependencies' items name them), not core's, alloc's and std's alone; the build scripts' units left out"
  [d]
  (let [ms (c-metadata d)]
    (into (sorted-map)
          (for [[i u] (map-indexed vector (:units d))
                :when (and (= :build (:mode u)) (vector? (:kind u)) (not= "build-script-build" (:target-name u)))]
            (let [m (hex16 (get ms i))]
              [(:target-name u) {:metadata m :stable-crate-id (mono/hex16 (mono/stable-crate-id (:target-name u) false [m] (:cfg-version d)))}])))))

;; ---------------------------------------------------------------------------------------------
;; Cargo's unit graph (JSON) as the units' description

(defn- read-json
  "A JSON text's value: objects as maps of keyword keys, arrays as vectors"
  [^String s]
  (let [i (volatile! 0) n (count s)
        ws! (fn [] (while (and (< @i n) (Character/isWhitespace (.charAt s (int @i)))) (vswap! i inc)))]
    (letfn [(value []
              (ws!)
              (let [c (.charAt s (int @i))]
                (case c
                  \{ (do (vswap! i inc) (ws!)
                         (if (= \} (.charAt s (int @i))) (do (vswap! i inc) {})
                             (loop [m (transient {})]
                               (ws!) (let [k (string) _ (ws!) _ (vswap! i inc) v (value) m (assoc! m (keyword k) v)]
                                       (ws!) (let [c (.charAt s (int @i))] (vswap! i inc) (if (= c \,) (recur m) (persistent! m)))))))
                  \[ (do (vswap! i inc) (ws!)
                         (if (= \] (.charAt s (int @i))) (do (vswap! i inc) [])
                             (loop [v (transient [])]
                               (let [v (conj! v (value))] (ws!) (let [c (.charAt s (int @i))] (vswap! i inc) (if (= c \,) (recur v) (persistent! v)))))))
                  \" (string)
                  \t (do (vswap! i + 4) true)
                  \f (do (vswap! i + 5) false)
                  \n (do (vswap! i + 4) nil)
                  (let [st @i] (while (and (< @i n) (re-matches #"[-+0-9.eE]" (str (.charAt s (int @i))))) (vswap! i inc))
                    (let [t (subs s st @i)] (if (re-find #"[.eE]" t) (Double/parseDouble t) (Long/parseLong t)))))))
            (string []
              (ws!) (vswap! i inc)
              (let [sb (StringBuilder.)]
                (loop []
                  (let [c (.charAt s (int @i))]
                    (vswap! i inc)
                    (cond (= c \") (str sb)
                          (= c \\) (let [e (.charAt s (int @i))]
                                     (vswap! i inc)
                                     (case e \n (.append sb \newline) \t (.append sb \tab) \u (do (.append sb (char (Integer/parseInt (subs s @i (+ @i 4)) 16))) (vswap! i + 4)) (.append sb e))
                                     (recur))
                          :else (do (.append sb c) (recur)))))))]
      (value))))

(defn- kw [s] (keyword (str/replace (str s) "_" "-")))

(defn units-of-graph
  "Cargo's unit graph G (read-json's) as the units' description, the workspace's root path ROOT (a path package's source
  relative to it, as SourceId::stable_hash hashes it); each unit's LTO compiler::lto's (no LTO asked: only-object); what the
  unit graph does not write of a profile given: its trim-paths TRIM (every unit's: -Ztrim-paths with the profile's
  TRIM_PATHS, build scripts' too) and a package's profile rustflags RUSTFLAGS ({package [flag ..]}: the workspace manifest's
  [profile.release.package.NAME] rustflags, panic_abort's -Cpanic=abort)"
  [g ^String root trim rustflags]
  (vec (for [u (:units g)]
         (let [[_ src nm ver] (re-matches #"(path\+file://[^#]*|registry\+[^#]*)#(?:([^@]+)@)?(.*)" (:pkg_id u))
               path? (str/starts-with? src "path+")
               p (:profile u) t (:target u)
               dir (when path? (subs src (count "path+file://")))
               rel (when path? (let [r (subs dir (min (count dir) (inc (count root))))] r))
               nm (or nm (last (str/split dir #"/")))]
           {:name nm :version ver
            :source (if path? [:path rel] [:registry (subs src (count "registry+"))])
            :features (vec (:features u))
            :profile {:opt-level (str (:opt_level p))
                      :lto (case (str (:lto p)) "false" [:bool false] "true" [:bool true] "off" [:off] [:named (str (:lto p))])
                      :codegen-backend (:codegen_backend p) :codegen-units (:codegen_units p)
                      :debuginfo (case (:debuginfo p) 0 :none 1 :limited 2 :full (kw (:debuginfo p)))
                      :split-debuginfo (:split_debuginfo p)
                      :debug-assertions (:debug_assertions p) :overflow-checks (:overflow_checks p) :rpath (:rpath p)
                      :incremental (:incremental p) :panic (kw (:panic p))
                      :strip (let [s (:strip p) inner (or (:resolved s) (:deferred s))]
                               (if (map? inner) [:named (:Named inner)] [:none]))
                      :rustflags (vec (get rustflags nm [])) :trim-paths trim}
            :mode (kw (:mode u)) :lto :only-object
            :kind (if (:platform u) [:target (:platform u)] :host)
            :target-name (:name t)
            ;; the target's source relative to the workspace (not hashed: the oracle's lines are matched by it)
            :src (let [sp (str (:src_path t))] (if (str/starts-with? sp (str root "/")) (subs sp (inc (count root))) sp))
            ;; TargetKind::Lib(crate types) for a library (the unit graph's kind list: ["dylib" "rlib"]), else its kind
            :target-kind (let [ks (mapv kw (:kind t))]
                           (if (some #{:lib :rlib :dylib :cdylib :staticlib :proc-macro} ks) [:lib ks] [(first ks) []]))
            :is-std false
            :deps (mapv :index (:dependencies u))}))))

(defn crates-file
  "The crates' identities as mono reads them (load-crates: :cfg-version, :triple, :crates {name {:stable-crate-id HEX}}),
  computed from the description D, its text"
  [d]
  (str ";; std's crates' identities computed by Arbace (C6-2 (b): arbace.rust.front.cargo-meta, Cargo's metadata hash over\n"
       ";; test/rust/front/std-build-units.edn, then StableCrateId::new), as mono reads them. Read with the Clojure reader.\n"
       "{:cfg-version " (pr-str (:cfg-version d)) "\n :triple " (pr-str (:triple d)) "\n :crates {"
       (str/join "\n          " (for [n (let [ids (crate-ids d)] (concat ["core" "alloc" "std"] (remove #{"core" "alloc" "std"} (keys ids))))
                                       :let [{:keys [stable-crate-id metadata]} (get (crate-ids d) n)]]
                                   (str (pr-str n) " {:stable-crate-id " (pr-str stable-crate-id) " :metadata " (pr-str metadata) "}")))
       "}}\n"))

(defn -main [cmd & args]
  (case cmd
    "crates" (let [[uf out] args d (read-string (slurp uf))] (spit out (crates-file d)) (println "cargo-meta: wrote" out))
    ;; check-crates UNITS FILE: the computed StableCrateIds against FILE's (std-crates-rsi.edn, read from the rlibs' rmeta)
    "check-crates" (let [[uf f] args d (read-string (slurp uf)) ids (crate-ids d) rec (:crates (read-string (slurp f)))
                         bad (for [n ["core" "alloc" "std"] :let [a (:stable-crate-id (get ids n)) b (:stable-crate-id (get rec n))] :when (not= a b)] [n a b])]
                     (doseq [n ["core" "alloc" "std"]] (println "cargo-meta:" n "computed" (:stable-crate-id (get ids n)) "recorded" (:stable-crate-id (get rec n))))
                     (println (if (empty? bad) (str "cargo-meta: " f "'s identities are the computed ones") (str "cargo-meta: FAIL: " f " differs from the computed identities")))
                     (System/exit (if (empty? bad) 0 1)))
    "units" (let [[gf vvf out root trim & rfs] args
                  vv (slurp vvf)
                  g (read-json (slurp gf))
                  units (units-of-graph g root (case trim "all" :all nil)
                                        (into {} (for [x rfs :let [[pk fl] (str/split x #"=" 2)]] [pk (str/split fl #",")])))]
              (spit out (str ";; The library build's units (C6-2 (b), doc/rust/FRONTEND-SURVEY.md, \"As built: C6-2\"): Cargo's --unit-graph of\n"
                             ";; bin/rsi std-build's build (test/rust/runtime/std.edn), read by arbace.rust.front.cargo-meta units; the input of\n"
                             ";; Cargo's metadata hash ported (cargo-meta ids). Read with the Clojure reader.\n"
                             ";; Its profile's trim-paths and panic_abort's profile rustflags are not in the unit graph: given by\n"
                             ";; bin/rust-front std-crates --units (the profile's TRIM_PATHS, library/Cargo.toml's [profile.release.package.*]).\n"
                             (pr-str {:cfg-version (second (re-find #"(?m)^rustc (.*)$" vv))
                                      :triple (second (re-find #"(?m)^host: (.*)$" vv))
                                      :rustc-vv vv
                                      :units units})
                             "\n"))
              (println "cargo-meta: wrote" (count units) "units to" out))
    "ids" (let [[uf check] args
                d (read-string (slurp uf))
                ms (c-metadata d)
                ;; the oracle's lines `NAME HEX SOURCE` (bin/rsi std-build --units' metadata.txt), by the unit's source
                want (when check (into {} (for [l (str/split-lines (slurp check)) :let [[_ h p] (str/split l #" ")] :when p] [p h])))
                res (for [[i m] ms :let [u (nth (:units d) i)] :when (= :build (:mode u))]
                      [i u (hex16 m) (get want (:src u))])]
            (doseq [[i u h w] res]
              (println (format "cargo-meta: %2d %-26s %-6s %s%s" i (:target-name u) (if (= :host (:kind u)) "host" "target") h
                               (cond (nil? w) "" (= w h) "  = cargo -v" :else (str "  DIFFERS (cargo -v " w ")")))))
            (doseq [[n {:keys [metadata stable-crate-id]}] (crate-ids d)]
              (println "cargo-meta:" n "-C metadata" metadata "StableCrateId" stable-crate-id))
            (when check
              (let [eq (count (filter (fn [[_ _ h w]] (= h w)) res)) n (count (filter #(nth % 3) res))]
                (println (format "cargo-meta: %d of %d units' -C metadata equal to cargo -v's" eq n))
                (System/exit (if (= eq n) 0 1))))))
  (System/exit 0))

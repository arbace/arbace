;; RUST-90 S5, C6 (doc/rust/FRONTEND-SURVEY.md, "C6: the library lowered by Arbace, the plan (write-ahead)" and "As built: C6's
;; first slice"): the library's non-generic items a program links, lowered by Arbace and compared item by item with std's IR.
;; The v0 grammar decoded here is rustc 1.99.1's compiler/rustc_symbol_mangling/src/v0.rs (rustc is dual-licensed MIT OR
;; Apache-2.0, LICENSE.md, "Rust (rustc 1.99.1)").

(ns arbace.rust.front.lib-unit
  "C6's census and its first slice's judge. std's IR (bin/rsi std-build's 110 units at test/rust/runtime/ir.sha256, Cargo's,
  rustc's and clang's: what a case links today) is read as text: each unit's defines and globals with the symbols they name,
  a private or internal one the unit's own. From the programs' own IR (each one's undefined symbols: its declares and the
  globals it names) the closure through std's units is what the program's run takes from std's IR. Each reached define is
  classed by its v0 symbol: an item (no instantiating crate: a non-generic item its crate emits once), a copy (an instantiating
  crate and no generic arguments in its path or impl: a non-generic #[inline] item copied into the crate that uses it), an
  instance (generic arguments: a generic def's instance made in that crate), or no_mangle. Read with the Clojure reader.

    census STD-IR NAME=PROG.ll[,MORE.ll] ...   the closure of each program and of all of them, by crate and kind (items,
                                               copies, instances, no_mangle; defines, distinct definitions, IR lines)
    keys STD-IR CRATE OUT NAME=PROG.ll ...      the export keys (alloc-check's body-key: the def path less the crate, `-` for
                                               `::`) of CRATE's items in the programs' closure, a line each; OUT.syms the
                                               symbols beside their keys
    compare STD-IR CRATE UNIT-FORMS             the native LLVM defines of UNIT-FORMS (build-run's lib-unit: each exported
                                               item at its identity, codegen's) against CRATE's defines in std's IR of the
                                               same symbol, after RF3's normalizer (arbace.rust.back.check), item by item;
                                               a crossed control (one item's forms against another's IR) must differ"
  (:require [arbace.repr.llvm :as llvm]
            [arbace.rust.back.check :as chk]
            [arbace.rust.back.codegen :as cg]
            [arbace.string :as str])
  (:import [java.io File BufferedReader FileReader]))

;; ---------------------------------------------------------------------------------------------
;; v0 symbols (v0.rs; the grammar of rustc's symbol-mangling documentation): the def path of a symbol, its generic arguments
;; and its instantiating crate. Types and constants are skipped, never printed.

(def ^:private b62 "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ")

(defn- pk [{:keys [^String s i]}] (when (< (long @i) (count s)) (.charAt s (int @i))))
(defn- nx [{:keys [i] :as p}] (let [c (pk p)] (when (nil? c) (throw (ex-info "v0: the symbol ends early" {}))) (vswap! i inc) c))
(defn- eat [p c] (when (= c (pk p)) (nx p) true))

(defn- base62-num
  "<base-62-number>: `_` is 0, else the digits then `_`, the value plus one"
  [p]
  (if (eat p \_)
    0
    (loop [x 0]
      (let [c (nx p)]
        (if (= c \_) (inc' x) (recur (+' (*' x 62) (.indexOf ^String b62 (str c)))))))))

(defn- disamb "[<disambiguator>]: `s` and a base-62 number, plus one; absent 0" [p] (if (eat p \s) (inc' (base62-num p)) 0))

(defn- ident
  "<undisambiguated-identifier>: [u] <decimal> [_] <bytes> (the `_` before bytes that begin with a digit or `_`)"
  [p]
  (eat p \u)
  (let [n (loop [x 0] (let [c (pk p)] (if (and c (Character/isDigit ^char c)) (do (nx p) (recur (+ (* 10 x) (- (int c) 48)))) x)))
        _ (when (pos? n) (eat p \_))
        {:keys [^String s i]} p
        st (long @i)]
    (vswap! i + n)
    (subs s st (+ st n))))

(declare v0-type v0-path)

(defn- v0-const [p]
  (cond (eat p \p) nil
        (eat p \B) (base62-num p)
        :else (do (v0-type p) (eat p \n) (loop [] (when-not (= \_ (nx p)) (recur))))))

(defn- v0-generic-arg [p]
  (cond (eat p \L) (base62-num p)
        (eat p \K) (v0-const p)
        :else (v0-type p)))

(def ^:private basic-types (set "abcdefhijlmnostuvxyzp"))

(defn- v0-type
  "Skips one <type>; true when it holds generic arguments or a placeholder"
  [p]
  (let [c (pk p)]
    (cond
      (contains? basic-types c) (do (nx p) (= c \p))
      (= c \A) (do (nx p) (let [g (v0-type p)] (v0-const p) g))
      (= c \S) (do (nx p) (v0-type p))
      (= c \T) (do (nx p) (loop [g false] (if (eat p \E) g (recur (or (v0-type p) g)))))
      (#{\R \Q} c) (do (nx p) (when (eat p \L) (base62-num p)) (v0-type p))
      (#{\P \O} c) (do (nx p) (v0-type p))
      (= c \F) (do (nx p) (when (eat p \G) (base62-num p)) (eat p \U) (when (eat p \K) (when-not (eat p \C) (ident p)))
                   (let [g (loop [g false] (if (eat p \E) g (recur (or (v0-type p) g))))] (or (v0-type p) g)))
      (= c \D) (do (nx p) (when (eat p \G) (base62-num p))
                   (let [g (loop [g false]
                             (if (eat p \E) g
                                 (let [g2 (:generic (v0-path p))]
                                   (loop [] (when (eat p \p) (ident p) (v0-type p) (recur)))
                                   (recur (or g g2)))))]
                     (when (eat p \L) (base62-num p))
                     g))
      (= c \B) (do (nx p) (base62-num p) true)   ; a back-reference (not followed: counted generic, conservatively)
      :else (boolean (:generic (v0-path p))))))

(defn- v0-path
  "One <path>: {:segs [crate seg ..] :generic BOOL} (an impl's segment `{impl#N}`, a closure's `{closure#N}`, a shim's
  `{shim}`; a back-reference followed from the position it names)"
  [p]
  (let [c (nx p)]
    (case c
      \C (do (disamb p) {:segs [(ident p)] :generic false})
      \N (let [ns (nx p) inner (v0-path p) d (disamb p) n (ident p)]
           (update inner :segs conj (case ns \C (str "{closure#" d "}") \S "{shim}" n)))
      \M (let [d (disamb p) inner (v0-path p) g (v0-type p)]
           (-> inner (update :segs conj (str "{impl#" d "}")) (update :generic #(or % g))))
      \X (let [d (disamb p) inner (v0-path p) g (v0-type p) g2 (:generic (v0-path p))]
           (-> inner (update :segs conj (str "{impl#" d "}")) (update :generic #(or % g g2))))
      \Y (let [g (v0-type p) tr (v0-path p)] (update tr :generic #(or % g)))
      \I (let [inner (v0-path p)] (loop [] (when-not (eat p \E) (v0-generic-arg p) (recur))) (assoc inner :generic true))
      \B (let [n (long (base62-num p))] (v0-path {:s (:s p) :i (volatile! (+ 2 n))}))
      (throw (ex-info (str "v0: no path at `" c "`") {})))))

(defn decode
  "A symbol's {:crate :path :generic :inst-crate KIND}: KIND :item (a v0 symbol without an instantiating crate), :copy (one
  with it, no generic argument in its path, impl or trait: a non-generic #[inline] item's copy), :instance (generic
  arguments), :no-mangle (not v0); nil when the symbol does not decode"
  [^String sym]
  (let [sym (if (str/starts-with? sym "\"") (subs sym 1 (dec (count sym))) sym)]
    (if-not (str/starts-with? sym "_R")
      {:kind :no-mangle :path sym}
      (try
        (let [p {:s sym :i (volatile! 2)}
              _ (when (Character/isDigit ^char (pk p)) (loop [] (when (Character/isDigit ^char (pk p)) (nx p) (recur))))   ; an encoding version
              {:keys [segs generic]} (v0-path p)
              inst (when (and (pk p) (not (#{\. \$} (pk p)))) (first (:segs (v0-path p))))]
          {:crate (first segs) :path (str/join "::" segs) :generic generic :inst-crate inst
           :kind (cond (nil? inst) :item generic :instance :else :copy)})
        (catch Throwable _ nil)))))

;; ---------------------------------------------------------------------------------------------
;; std's IR as text: each unit's defines and globals with the symbols they name

(def ^:private name-re "(?:\"(?:[^\"\\\\]|\\\\.)*\"|[-a-zA-Z$._][-a-zA-Z$._0-9]*|[0-9]+)")
(def ^:private ref-re (re-pattern (str "@(" name-re ")")))
(def ^:private def-re (re-pattern (str "^define\\s+(.*?)@(" name-re ")\\(")))
(def ^:private glb-re (re-pattern (str "^@(" name-re ")\\s*=\\s*(.*)$")))
(def ^:private decl-re (re-pattern (str "^declare\\s+.*?@(" name-re ")\\(")))

(defn- local-linkage? [^String pre] (boolean (some #{"private" "internal"} (str/split (str/trim pre) #"\s+"))))

(defn scan-unit
  "FILE's defines and globals {name {:fn? :local? :refs #{..} :lines N}} and its declares #{name}"
  [^String file]
  (with-open [r (BufferedReader. (FileReader. file))]
    (loop [defs (transient {}) decls (transient #{}) cur nil refs nil n 0]
      (let [^String line (.readLine r)]
        (cond
          (nil? line) [(persistent! defs) (persistent! decls)]
          cur (if (str/starts-with? line "}")
                (recur (assoc! defs cur (assoc (get defs cur) :refs (persistent! refs) :lines n)) decls nil nil 0)
                (recur defs decls cur (reduce conj! refs (map second (re-seq ref-re line))) (inc n)))
          :else
          (if-let [[_ pre nm] (re-find def-re line)]
            (let [rs (reduce conj! (transient #{}) (map second (re-seq ref-re (subs line (count (re-find def-re line))))))]
              (if (str/ends-with? (str/trimr line) "}")
                (recur (assoc! defs nm {:fn? true :local? (local-linkage? pre) :refs (persistent! rs) :lines 0}) decls nil nil 0)
                (recur (assoc! defs nm {:fn? true :local? (local-linkage? pre)}) decls nm rs 0)))
            (if-let [[_ nm rest] (re-find glb-re line)]
              (recur (assoc! defs nm {:fn? false :local? (local-linkage? rest) :refs (set (map second (re-seq ref-re rest))) :lines 1}) decls nil nil 0)
              (if-let [[_ nm] (re-find decl-re line)]
                (recur defs (conj! decls nm) nil nil 0)
                (recur defs decls nil nil 0)))))))))

(defn std-units
  "STD-IR's units (DIR/CRATE/UNIT.ll), {[crate unit] defs}"
  [^String dir]
  (into (sorted-map)
        (for [^File cd (sort-by #(.getName ^File %) (.listFiles (File. dir))) :when (.isDirectory cd)
              ^File f (sort-by #(.getName ^File %) (.listFiles cd)) :when (str/ends-with? (.getName f) ".ll")]
          [[(.getName cd) (.getName f)] (first (scan-unit (.getPath f)))])))

(defn- global-index [units]
  (persistent! (reduce (fn [m [u defs]] (reduce (fn [m [nm d]] (if (or (:local? d) (contains? m nm)) m (assoc! m nm u))) m defs))
                       (transient {}) units)))

(defn program-roots
  "The symbols the program's IR FILES name but do not define (their declares and the globals they name)"
  [files]
  (let [parsed (map scan-unit files)
        defined (set (mapcat (comp keys first) parsed))]
    (set (remove defined (concat (mapcat second parsed) (mapcat #(mapcat :refs (vals (first %))) parsed))))))

(defn closure
  "The defines and globals of UNITS (std-units) reached from ROOTS: {:reached #{[unit name]} :unresolved #{name}}"
  [units gidx roots]
  (let [resolve (fn [u nm] (cond (and u (contains? (get units u) nm)) [u nm] (contains? gidx nm) [(get gidx nm) nm]))]
    (loop [todo (vec (keep #(resolve nil %) roots)) seen (transient #{}) unres (set (remove #(resolve nil %) roots))]
      (if (empty? todo)
        {:reached (persistent! seen) :unresolved unres}
        (let [[u nm :as x] (peek todo) todo (pop todo)]
          (if (contains? seen x)
            (recur todo seen unres)
            (let [rs (:refs (get-in units [u nm]))
                  ys (map #(vector % (resolve u %)) rs)]
              (recur (into todo (keep #(when-let [y (second %)] (when-not (contains? seen y) y)) ys))
                     (conj! seen x)
                     (into unres (keep #(when-not (second %) (first %)) ys))))))))))

(defn- parse-specs [specs]
  (for [s specs :let [[nm fs] (str/split s #"=" 2)]] [nm (str/split fs #",")]))

(defn- fn-rows
  "The reached defines as rows {:crate :unit :name :lines :kind :path}"
  [units reached]
  (for [[u nm] reached :let [d (get-in units [u nm])] :when (:fn? d)
        :let [dec (decode nm)]]
    {:crate (first u) :unit (second u) :name nm :lines (:lines d) :kind (or (:kind dec) :undecoded) :path (:path dec)}))

(defn- def-of "A row's definition: its def path, a closure's its parent's" [{:keys [path]}]
  (when path (str/replace path #"(::\{closure#\d+\})+$" "")))

(defn census-lines [rows]
  (let [by (group-by :crate rows)
        cnt (fn [rs k] (count (filter #(= k (:kind %)) rs)))]
    (concat
     [(format "  %-22s %7s %7s %7s %8s %8s %9s %9s" "crate" "defines" "items" "copies" "instances" "no_mangle" "item defs" "IR lines")]
     (for [[c rs] (sort-by (comp - count val) by)]
       (format "  %-22s %7d %7d %7d %8d %8d %9d %9d" c (count rs) (cnt rs :item) (cnt rs :copy) (cnt rs :instance) (cnt rs :no-mangle)
               (count (distinct (keep #(when (= :item (:kind %)) (def-of %)) rs))) (reduce + (map :lines rs))))
     [(format "  %-22s %7d %7d %7d %8d %8d %9d %9d" "total" (count rows) (cnt rows :item) (cnt rows :copy) (cnt rows :instance)
              (cnt rows :no-mangle) (count (distinct (keep #(when (= :item (:kind %)) (def-of %)) rows))) (reduce + (map :lines rows)))])))

(defn census [std-dir specs]
  (let [t0 (System/nanoTime)
        units (std-units std-dir)
        gidx (global-index units)
        progs (for [[nm fs] (parse-specs specs)]
                (let [{:keys [reached unresolved]} (closure units gidx (program-roots fs))]
                  [nm reached unresolved]))
        all (reduce into #{} (map second progs))]
    (println (format "lib-unit census: std's IR %d units, %d defines (%d s)" (count units)
                     (reduce + (map (fn [[_ d]] (count (filter :fn? (vals d)))) units)) (quot (- (System/nanoTime) t0) 1000000000)))
    (doseq [[nm reached unres] progs :let [rows (fn-rows units reached)]]
      (println (format "lib-unit census: %s: %d defines, %d globals reached; %d symbols outside std's IR (libc, the unwinder, LLVM's intrinsics, the shim)"
                       nm (count rows) (- (count reached) (count rows)) (count unres)))
      (doseq [l (census-lines rows)] (println l)))
    (let [rows (fn-rows units all)
          ;; the definitions the native front end builds (an instance's or copy's body is its definition's at arguments), by
          ;; the definition's own crate, not the crate whose unit holds the instance
          defs (group-by #(first (str/split (str (def-of %)) #"::")) (filter :path (remove #(= :no-mangle (:kind %)) rows)))]
      (println (format "lib-unit census: the %d programs' union: %d defines, %d globals" (count progs) (count rows) (- (count all) (count rows))))
      (doseq [l (census-lines rows)] (println l))
      (println "lib-unit census: the union's definitions by their own crate (items; the generic and #[inline] definitions of the copies and instances)")
      (doseq [[c rs] (sort-by (comp - count val) defs)]
        (println (format "  %-22s %7d items, %7d other definitions (%d defines)" c
                         (count (distinct (keep #(when (= :item (:kind %)) (def-of %)) rs)))
                         (count (distinct (keep #(when (not= :item (:kind %)) (def-of %)) rs))) (count rs))))
      ;; LIB_UNIT_TSV=FILE: the union's defines, a line each (crate, unit, kind, definition, IR lines, symbol)
      (when-let [f (System/getenv "LIB_UNIT_TSV")]
        (spit f (str/join "" (for [r (sort-by (juxt :crate :name) rows)]
                               (str (:crate r) "\t" (:unit r) "\t" (name (:kind r)) "\t" (def-of r) "\t" (:lines r) "\t" (:name r) "\n")))))
      rows)))

(defn body-key "alloc-check's key of a def path (its crate's segment dropped, `-` for `::`)" [^String path]
  (str/join "-" (rest (str/split path #"::"))))

;; ---------------------------------------------------------------------------------------------
;; The compare: our defines (codegen's forms of the exported items) against std's IR, after RF3's normalizer

(defn- ir-forms
  "CRATE's units of STD-DIR read by repr/llvm: {symbol [define-form unit-global-map]}"
  [std-dir crate]
  (into {} (for [^File f (sort-by #(.getName ^File %) (.listFiles (File. (str std-dir "/" crate)))) :when (str/ends-with? (.getName f) ".ll")
                 :let [forms (llvm/read-ll (.getPath f)) gm (chk/global-map forms)]
                 x forms :when (= 'llvm/define (first x))]
             [(name (second x)) [x gm]])))

(defn entry-unlabeled
  "A define form F with its entry block's label taken away: std's IR is printed from bitcode without value names (rustc's
  fewer names), so its entry block is implicit and unlabeled, where codegen names it `start` as rustc's own text does (no
  branch can name an entry block)"
  [f]
  (let [v (vec f) i (.indexOf ^java.util.List v :body)
        bs (when (pos? i) (nth v (inc i)))]
    (if (and (seq bs) (seq? (first bs)))
      (apply list (assoc v (inc i) (assoc (vec bs) 0 (apply list (ffirst bs) nil (drop 2 (first bs))))))
      f)))

(defn judge
  "Each of OURS ([[def symbol define-form-or-nil why]]) against THEIRS ({symbol [form gm]}) with OUR-GM (our module's
  global-map): [[def symbol kind why]], kind :equal, :differs, :refused (no form of ours), :no-symbol (std's IR defines no
  function of our symbol)"
  [ours our-gm theirs]
  (vec (for [[d sym f why] ours]
         (cond
           (nil? f) [d sym :refused why]
           (nil? (get theirs sym)) [d sym :no-symbol "std's IR defines no function of this symbol"]
           :else (let [[tf tgm] (get theirs sym)
                       o (chk/normalize (entry-unlabeled f) our-gm) t (chk/normalize tf tgm)]
                   (if (= o t) [d sym :equal nil] [d sym :differs (chk/diff-text o t)]))))))

(defn control
  "The crossed control: the first two items ours has forms of whose IR differs from each other, the first's forms against the
  second's IR: :differs as it must, else :passed (the judge cannot tell two items apart); nil without two such items"
  [ours our-gm theirs]
  (let [cands (for [[_ sym f] ours :when (and f (get theirs sym))] [sym f])
        norm-t (fn [sym] (let [[tf tgm] (get theirs sym)] (chk/normalize tf tgm)))]
    (when-let [[[s1 f1] [s2 _]] (seq (take 2 (filter (fn [[s]] true) (let [[a & more] cands]
                                                                         (when a (cons a (filter #(not= (norm-t (first %)) (norm-t (first a))) more)))))))]
      (when s2 [s1 s2 (if (= (chk/normalize (entry-unlabeled f1) our-gm) (norm-t s2)) :passed :differs)]))))

(defn -main [cmd & args]
  (case cmd
    "census" (let [[std & specs] args] (census std specs))
    "keys" (let [[std crate out & specs] args
                 rows (census std specs)
                 its (filter #(and (= crate (:crate %)) (= :item (:kind %))) rows)
                 ks (sort (distinct (map (comp body-key def-of) its)))]
             (spit out (str (str/join "\n" ks) "\n"))
             (spit (str out ".syms") (str/join "" (for [r (sort-by :path its)] (str (body-key (def-of r)) "\t" (:path r) "\t" (:name r) "\t" (:unit r) "\n"))))
             (println (format "lib-unit keys: %s: %d items of the closure, %d keys, into %s" crate (count its) (count ks) out)))
    "compare" (let [[std crate uf] args
                    m (read-string (slurp uf))
                    theirs (ir-forms std crate)
                    gl (cg/new-globals (:langsyms m))
                    lt (into {} (:layouts m))
                    _ (cg/set-def-symbols! gl (for [[_ b] (:bodies m) :when b] (assoc b :form :body)))
                    ours (vec (for [[d b why] (:bodies m)]
                                (if b
                                  (try [d (:symbol b) (cg/codegen-fn (assoc b :form :body) lt gl) nil]
                                       (catch Throwable e [d (:symbol b) nil (str "codegen: " (or (:codegen/unsupported (ex-data e)) (.getMessage e)))]))
                                  [d nil nil why])))
                    our-gm (chk/global-map (cg/module-extras gl))
                    rows (judge ours our-gm theirs)
                    ctl (control ours our-gm theirs)]
                (doseq [[d sym k why] rows]
                  ;; a difference's text may hold a constant's bytes: control characters printed as `?`, so the log stays text
                  (println (str "lib-unit " (name k) " " d (when sym (str " " sym))
                                (when why (str " (" (str/replace (subs (str why) 0 (min 400 (count (str why)))) #"[\x00-\x08\x0b-\x1f\x7f]" "?") ")")))))
                (println (str "lib-unit compare: " crate ": " (count rows) " items: "
                              (str/join ", " (for [k [:equal :differs :refused :no-symbol]] (str (count (filter #(= k (nth % 2)) rows)) " " (name k))))))
                (if ctl
                  (println (str "lib-unit control (" (first ctl) "'s forms against " (second ctl) "'s IR): "
                                (if (= :differs (nth ctl 2)) "differs, as it must" "PASSED (a bug)")))
                  (println "lib-unit control: fewer than two items to cross"))
                (System/exit (if (and ctl (= :passed (nth ctl 2))) 1 0))))
  (System/exit 0))

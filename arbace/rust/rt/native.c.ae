(in-ns 'c.rust.rt.native) (c/file "native.c" :std :gnu23)
;; The pending-flag layer's stand-in for RE2 (doc/rust/EVAL.md §4, "The native-std leg"; doc/rust/RUST-EVAL-SURVEY.md, "As built:
;; RE1-RE2"): the lowered program linked with the host's native std (P4's method), whose panics unwind natively. The lowered
;; frames carry gcc's unwind tables (gcc -O0 on x86-64 writes .eh_frame) and no personality, so the native unwinder passes
;; through them without running their landing pads: the pending flag is never raised, the lowering's calls to the layer are
;; answered as if no exception were in flight, and the renamed entry points (main's wrapper aside, arbace.cpp.lower's
;; runtime-renames) go to musl's own. catch_unwind's frame (rustc's internal __rust_try) is native too: cx$rust_try, a
;; native function of the host's rustc (test/rust/runtime/native/try.rs), which arbace.rust.lower calls in its place. RE3
;; replaces this layer by the pending-flag layer proper (RES4 (a): eh.c.ae's unwinder entry points, std's personality lowered).

(c/declare abort ^void [void])
(c/declare pthread_create ^int [(* void) (* void) (* (fn [(* void)] (* void))) (* void)])
(c/declare __cxa_atexit ^int [(* (fn [(* void)] void)) (* void) (* void)])
(c/declare atexit ^int [(* (fn [void] void))])
(c/declare at_quick_exit ^int [(* (fn [void] void))])

(c/var ^:thread_local ^int cx$pending 0)

(c/defn cx$exception ^{:tag (* void)} [void] (return 0))
(c/defn cx$catches ^int [^{:tag (* void)} ti] (return 0))
;; a resume or an uncaught exception cannot happen while the flag is never raised
(c/defn cx$resume ^void [^{:tag (* void)} o] (abort))
(c/defn cx$uncaught ^void [void] (abort))

(c/defn cx$pthread_create ^int [^{:tag (* void)} th ^{:tag (* void)} attr ^{:tag (* (fn [(* void)] (* void)))} f ^{:tag (* void)} a]
  (return (pthread_create th attr f a)))
(c/defn cx$cxa_atexit ^int [^{:tag (* (fn [(* void)] void))} f ^{:tag (* void)} a ^{:tag (* void)} dso]
  (return (__cxa_atexit f a dso)))
(c/defn cx$atexit ^int [^{:tag (* (fn [void] void))} f] (return (atexit f)))
(c/defn cx$at_quick_exit ^int [^{:tag (* (fn [void] void))} f] (return (at_quick_exit f)))

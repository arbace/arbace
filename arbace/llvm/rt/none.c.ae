(in-ns 'c.llvm.rt.none) (c/file "none.c" :std :gnu23)
;; The personality-free layer of llvmi (doc/llvm/LLVM-CROP-SURVEY.md §5.3, LL2; "As built: llvmi"): the names the lowering
;; (arbace.cpp.lower, doc/llvm/LOWER.md §7-§8) writes into every unit, for a module with no personality function (no
;; invoke, no landingpad, no resume: C's IR, any IR that does not unwind). The pending flag is never raised, so the tests
;; after calls are never taken; the exit-time and thread entry points the lowering renames are musl's own, passed through.
;; C forms written by hand, printed by repr/c; linked by ci (bin/llvmi run) or gcc with musl alone.

(c/declare abort ^void [void])
(c/declare atexit ^int [(* (fn [void] void))])
(c/declare at_quick_exit ^int [(* (fn [void] void))])
(c/declare __cxa_atexit ^int [(* (fn [(* void)] void)) (* void) (* void)])
(c/declare pthread_create ^int [(* void) (* void) (* (fn [(* void)] (* void))) (* void)])

(c/var ^:thread_local ^int cx$pending 0)

(c/defn cx$exception ^{:tag (* void)} [void] (return 0))
(c/defn cx$catches ^int [^{:tag (* void)} ti] (return 0))
;; a resume or an uncaught exception cannot happen without a personality: abort, as a module whose unwinder finds no frame
(c/defn cx$resume ^void [^{:tag (* void)} o] (abort))
(c/defn cx$uncaught ^void [void] (abort))

(c/defn cx$atexit ^int [^{:tag (* (fn [void] void))} f] (return (atexit f)))
(c/defn cx$at_quick_exit ^int [^{:tag (* (fn [void] void))} f] (return (at_quick_exit f)))
(c/defn cx$cxa_atexit ^int [^{:tag (* (fn [(* void)] void))} f ^{:tag (* void)} a ^{:tag (* void)} dso] (return (__cxa_atexit f a dso)))
(c/defn cx$pthread_create ^int [^{:tag (* void)} th ^{:tag (* void)} attr ^{:tag (* (fn [(* void)] (* void)))} f ^{:tag (* void)} a]
  (return (pthread_create th attr f a)))

(ns arbace.llvm.check
  "llvmi's judge (doc/llvm/LLVM-CROP-SURVEY.md, \"As built: llvmi (LL2's run, LL6, LL7)\"; bin/llvmi check): each module's run by ci
  (eval) or by its cf2g build (AOT) against lli's recorded run of the same module (test/llvm/ref-lli23.edn: status, stdout and
  stderr by digest), as rows [ID RESULT REASON] (goi's format, test/goi/check-linux-amd64.edn); every row that does not pass in
  a class of test/llvm/divergences-eval.edn (AOT: divergences-aot.edn, then eval's), GR10's format: a row is in the first class
  one of whose :match regexps finds \"RESULT REASON\"; a recorded pass that does not pass fails; the negative controls
  (test/llvm/controls.edn, GTS81 (a)): a subject's run judged against another module's reference, by this judge, must not pass."
  (:require [arbace.string :as str]))

(set! *warn-on-reflection* true)

(defn- tsv [^String f]
  (let [x (java.io.File. f)]
    (if (.exists x) (mapv #(str/split % #"\t" -1) (remove str/blank? (str/split-lines (slurp x)))) [])))

(defn- read-file [^String f] (when (.exists (java.io.File. f)) (read-string (slurp f))))

(defn- q [s] (pr-str (str s)))

(defn- clean [s] (str/replace (str s) #"\s+" " "))

;; ---------------------------------------------------------------------------------------------
;; the reference

(defn record-ref
  "record-ref WORK REF [--only]: WORK/lli.tsv's runs (bin/llvmi's run1 lines) of WORK/modules.tsv's modules written into REF as
  one map a module, sorted by id; --only keeps REF's other entries."
  [work ref only?]
  (let [mods (into {} (map (fn [[id p sha]] [id {:path p :ir sha}]) (tsv (str work "/modules.tsv"))))
        runs (tsv (str work "/lli.tsv"))
        version (str/trim (slurp (str work "/lli.version")))
        clang (into {} (map (juxt first identity) (tsv (str work "/clang.tsv"))))
        new (into {} (for [[id st osha ob esha eb ef] runs :when (mods id)]
                       [id {:id id :ir (:ir (mods id)) :status (if (= st "timeout") :timeout (Long/parseLong st))
                            :stdout osha :stdout-bytes (Long/parseLong ob) :stderr esha :stderr-bytes (Long/parseLong eb)
                            :stderr-first ef
                            ;; clang 23 -O0's build of the module, run: :same (status and stdout as lli's), :differs, :no-build
                            :clang (let [[_ cst co] (clang id)]
                                     (cond (nil? cst) :none (= cst "no-build") :no-build
                                           (and (= cst st) (= co osha)) :same :else :differs))}]))
        old (if only? (into {} (map (juxt :id identity) (or (read-file ref) []))) {})
        all (vals (merge old new))]
    (spit ref (str ";; lli's runs of llvmi's modules (bin/llvmi record-ref; doc/llvm/LLVM-CROP-SURVEY.md, \"As built: llvmi\"): each module run\n"
                   ";; by " version " (" (System/getenv "LLVM_BIN") "/lli, the host's llvm23) with an empty stdin, no arguments, 10 s;\n"
                   ";; :ir the module's SHA-256 (a C or C++ module's IR made by clang 23 from the checkout's source), :stdout and :stderr\n"
                   ";; SHA-256s; :clang whether clang 23 -O0's build of the module, run, gives lli's status and stdout (the survey's LLS8 (a)
;; reference, recorded beside lli's as a second opinion). Read with the Clojure reader.\n[\n"
                   (str/join (for [e (sort-by :id all)] (str (pr-str e) "\n")))
                   "]\n"))
    (println "llvmi record-ref:" (count new) "runs recorded," (count all) "in" ref)))

;; ---------------------------------------------------------------------------------------------
;; the own verdicts (doc/llvm/LLVM-CROP-SURVEY.md, "As built: LL9a"; the user's decision of 2026-11-07): a module whose test says
;; what passes is judged by that, no toolchain's record; the others against lli's recorded run. LLVMI_JUDGE=lli judges every module
;; against lli's record (the oracle tier, by hand at a tag).

(defn- run-lines
  "The RUN lines of an IR file, each continuation joined."
  [^String text]
  (loop [ls (str/split-lines text) cur nil out []]
    (if-let [l (first ls)]
      (if-let [[_ r] (re-find #"^;\s*RUN:\s?(.*)$" l)]
        (let [c (re-find #"\\\s*$" r) r (str/replace r #"\\\s*$" "") cur (str cur " " r)]
          (if c (recur (rest ls) cur out) (recur (rest ls) nil (conj out (str/trim cur)))))
        (recur (rest ls) nil (if cur (conj out (str/trim cur)) out)))
      (if cur (conj out (str/trim cur)) out))))

(defn- sha256-bytes ^String [^bytes b]
  (let [md (java.security.MessageDigest/getInstance "SHA-256")]
    (apply str (map #(format "%02x" (bit-and (long %) 0xff)) (.digest md b)))))
(defn- sha256-file ^String [^java.io.File f] (sha256-bytes (java.nio.file.Files/readAllBytes (.toPath f))))

(def ^:private derived-file "test/llvm/selfref-derived.edn")

;; llvm-judge-1120 (the coordinator's item, from c-cpp-golden-1120 3dbf9f3a6): the C++ programs' outcomes are C++'s reviewed golden files,
;; one source for both crops: beside test/cpp/samples/N.cpp and test/cpp/runtime/samples/N.cpp, N.expect (stdout), N.cpp.expectrc (the
;; status when not 0), N.expect-stderr (stderr when it writes one: no file, no stderr check, as the entries of selfref-derived.edn were),
;; each a verdict only with its review in test/cpp/selfref-golden.edn (cpp.selfref's rule); the modules cpp.samples.N, cpp.runtime.N
(def ^:private golden-review-file "test/cpp/selfref-golden.edn")
(defn- golden-entries []
  (let [rf (java.io.File. ^String golden-review-file)
        reviewed (if (.exists rf) (set (map :id (read-string (slurp rf)))) #{})]
    (into {} (for [[kind dir rdir] [["samples" "test/cpp/samples/" "samples/"] ["runtime" "test/cpp/runtime/samples/" "runtime/"]]
                   :let [d (java.io.File. ^String dir)]
                   n (sort (or (seq (.list d)) []))
                   :let [n (str n)]
                   :when (str/ends-with? n ".expect")
                   :let [b (subs n 0 (- (count n) (count ".expect"))) rc (java.io.File. (str dir b ".cpp.expectrc"))
                         er (java.io.File. (str dir b ".expect-stderr")) id (str "cpp." kind "." b)]
                   :when (reviewed (str rdir b ".cpp"))]
               [id {:id id :from :golden :golden (str dir b ".expect")
                    :status (if (.exists rc) (Long/parseLong (str/trim (slurp rc))) 0)
                    :stdout (slurp (str dir n)) :stderr (when (.exists er) (slurp er))}]))))

(def ^:private derived*
  (delay (let [f (java.io.File. ^String derived-file)]
           (merge (golden-entries)
                  (if (.exists f) (into {} (map (juxt :id identity) (read-string (slurp f)))) {})))))
(defn- derived [] @derived*)

(defn- entry-verdict
  "The own verdict an entry of test/llvm/selfref-derived.edn (or C++'s golden files) states: its status, stdout's and stderr's digests."
  [e]
  {:status (:status e) :stdout-sha (sha256-bytes (.getBytes ^String (:stdout e) "UTF-8"))
   :stderr-sha (when (:stderr e) (sha256-bytes (.getBytes ^String (:stderr e) "UTF-8")))
   :by (case (:from e)
         :ir "the outcome worked out from the module's IR (test/llvm/selfref-derived.edn)"
         :golden (str "C++'s reviewed golden files (" (:golden e) ", its review test/cpp/selfref-golden.edn)")
         "the outcome worked out from its source (test/llvm/selfref-derived.edn)")})

(defn- derived-verdict
  "Module id's reviewed outcome from test/llvm/selfref-derived.edn, or nil: the status, stdout and (an abort's) stderr worked out by
  hand, from the program's source (:from :source, the C++ programs, LLS49 (c)) or from the module's IR itself (:from :ir, llvm-judge-1120:
  a module whose IR fixes another outcome than its source's own expectation). An entry with :ir is the review of that IR alone: a module
  of another digest (the pack made again) has no outcome from it. IR-SHA the module's SHA-256."
  [^String id ^String ir-sha]
  (when-let [e (get (derived) id)]
    (when (or (nil? (:ir e)) (= (:ir e) ir-sha))
      (entry-verdict e))))

(defn own-verdict
  "The module's own verdict, or nil (no verdict of its own: judged against lli's record):
  - llvm/test's ExecutionEngine modules (ee.*): lit's, the RUN lines run lli on the file with no argument and exit 0 (lit fails a
    test whose command fails), and when the output is piped to FileCheck the file's `CHECK:` lines are found in stdout in order
    (FileCheck's rule: each after the last match, runs of blanks as one); the program's arguments those the RUN lines write after
    the file (plain words, the same on every line: `%lli %s test`, :args, which the run passes; queue 358); any other directive
    (CHECK-NEXT, -NOT, -DAG, a prefix, a {{regex}} or [[variable]]), arguments that differ between the lines or are not plain
    words, or a `not`: no own verdict;
  - gcc's torture execute programs (tx-O0.*, tx-O2.*): gcc's harness's, the program exits 0 (abort() or exit(1) is a failure;
    gcc.c-torture/execute's dg-do run, the programs' convention);
  - synth-c23's programs (c-O0.synth.*, c-O2.synth.*): exit 0 and the stdout test/c/synth/NAME.expect, the table's :expect worked
    out by hand (n-llvm-indep); test/c/run's (c-O*.run.*): the status their first line's `ci-run verdict: exit N` names, the
    program checking itself; the C++ modules (cpp.*): test/llvm/selfref-derived.edn's status and stdout;
  - any module with an entry in test/llvm/selfref-derived.edn (derived-verdict) by that entry first: the C++ modules', and the
    two synth modules whose IR answers otherwise than the C source's .expect (c-O0/c-O2.synth.pp-has-attribute, :from :ir).
  {:status 0 :checks [PATTERN ...]}."
  [^String id ^String path]
  (cond
    (str/starts-with? id "tx-") {:status 0 :checks [] :by "gcc's torture harness: the program exits 0"}
    (str/starts-with? id "ee.")
    (let [text (slurp path)
          runs (run-lines text)
          lli-runs (filter #(re-find #"%lli|(^|\s)lli\s" %) runs)
          bare (fn [r] (-> r (str/replace #"\s*\|\s*FileCheck\s+%s\s*$" "") (str/replace #"\s*>\s*/dev/null\s*$" "") str/trim))
          ;; the words after the file: the program's arguments (plain words alone)
          args-of (fn [r] (when-let [[_ a] (re-find #"%s((?:\s+[A-Za-z0-9_.,=+-]+)*)$" (bare r))] (vec (remove str/blank? (str/split a #"\s+")))))
          plain? (fn [r] (and (not (re-find #"(^|\s)not\s" (bare r))) (some? (args-of r))))
          fc? (some #(re-find #"FileCheck" %) runs)
          directives (re-seq #"(?m)^;\s*([A-Z][A-Z0-9_-]*):" text)
          checks (vec (for [[_ p] (re-seq #"(?m)^;\s*CHECK:\s?(.*)$" text)] (str/trim p)))]
      (when (and (seq lli-runs) (= (count lli-runs) (count runs)) (every? plain? runs)
                 (every? #(#{"RUN" "CHECK" "REQUIRES" "XFAIL" "UNSUPPORTED"} (second %)) directives)
                 (not-any? #(re-find #"\{\{|\[\[" %) checks)
                 (or fc? (empty? checks))
                 (apply = (map args-of runs))
                 ;; an XFAIL for another target only (lit on x86_64 Linux expects a pass); REQUIRES and UNSUPPORTED are lit's to skip
                 (every? #(and (re-find #"target=" %) (not (re-find #"x86_64|x86-64|linux|\{\{\.\*\}\}$" %)))
                         (map second (re-seq #"(?m)^;\s*XFAIL:(.*)$" text))))
        (cond-> {:status 0 :checks (if fc? checks []) :by (if fc? "lit's: exit 0 and FileCheck's CHECK lines" "lit's: exit 0")}
          (seq (args-of (first runs))) (assoc :args (args-of (first runs))))))
    ;; n-llvm-indep (LLS49 (c), the user 2026-11-18): Arbace's own programs with an outcome of their own; a reviewed entry of
    ;; test/llvm/selfref-derived.edn first (the C++ programs; llvm-judge-1120: the outcome a module's IR fixes; an entry reviewed
    ;; on another IR gives none: lli's record)
    (contains? (derived) id) (derived-verdict id (sha256-file (java.io.File. path)))
    ;; n-hasattr: pp-has-attribute's IR is clang's, whose __has_c_attribute answers C2x's draft dates (201904, ...), not
    ;; C23's 202311 (ISO/IEC 9899:2024 §6.10.2's table), so its .expect is not that module's outcome (llvm-judge-1120: its IR's own
    ;; outcome, reviewed, is selfref-derived.edn's entry above; a pack of another IR has none and lli's record judges it)
    (and (re-find #"^c-O[02]\.synth\." id) (not (str/ends-with? id ".pp-has-attribute")))
    (let [f (java.io.File. (str "test/c/synth/" (subs id (count "c-O0.synth.")) ".expect"))]
      (when (.exists f) {:status 0 :stdout-sha (sha256-file f) :by (str "synth-c23's :expect (" f ")")}))
    (re-find #"^c-O[02]\.run\." id)
    (let [f (java.io.File. (str "test/c/run/" (subs id (count "c-O0.run.")) ".c"))]
      (when-let [[_ n] (and (.exists f) (re-find #"^/\* ci-run verdict: exit (\d+)\." (slurp f)))]
        {:status (Long/parseLong n) :by "the program's own check (its first line: ci-run verdict)"}))
    :else nil))

(defn- blanks [s] (str/replace (str s) #"[ \t]+" " "))

(defn- own-result
  "A run line's result against the module's own verdict: [RESULT REASON]. OUT is the run's stdout (WORK/out/ID.out)."
  [[_ st osha ob esha eb ef] v ^String out]
  (cond
    (= st "timeout") [:timeout (str "ci's run timed out (the test's own verdict: exit " (:status v 0) ")")]
    (not= st (str (:status v 0))) [:status (str "status " st ", the test's own verdict: exit " (:status v 0) " (" (:by v) "): " (clean ef))]
    (and (:stdout-sha v) (not= osha (:stdout-sha v))) [:stdout (str "stdout " ob " bytes, not the test's own expected output (" (:by v) ")")]
    (and (:stderr-sha v) (not= esha (:stderr-sha v))) [:stderr (str "stderr " eb " bytes, not the test's own expected stderr (" (:by v) "): " (clean ef))]
    (seq (:checks v))
    (if (nil? out) [:stdout "the run's stdout was not kept (LLVMI_RUN_OUT)"]
        (let [o (blanks out)
              miss (loop [ps (:checks v) pos 0]
                     (when-let [p (first ps)]
                       (let [i (.indexOf ^String o ^String (blanks p) (int pos))]
                         (if (neg? i) p (recur (rest ps) (+ i (count (blanks p))))))))]
          (if miss [:stdout (str "stdout " ob " bytes lacks the test's CHECK: " miss)] [:pass ""])))
    :else [:pass ""]))

(defn- judge-mode [] (or (System/getenv "LLVMI_JUDGE") "own"))

;; ---------------------------------------------------------------------------------------------
;; one module's row

(defn- run-result
  "A run line's result against a reference entry: [RESULT REASON]. The reference is lli's record, or g++'s (:who, gxx-reference)."
  [[_ st osha ob esha eb ef] r]
  (let [rs (str (:status r)) who (or (:who r) "lli")]
    (cond
      (= st "timeout") (if (= :timeout (:status r)) [:pass ""] [:timeout (str "ci's run timed out; " who "'s status " rs)])
      (not= st rs) [:status (str "status " st ", " who "'s " rs ": " (clean ef) (when (seq (:stderr-first r)) (str " | " who ": " (:stderr-first r))))]
      (not= osha (:stdout r)) [:stdout (str "stdout " ob " bytes, " who "'s " (:stdout-bytes r))]
      (not= esha (:stderr r)) [:stderr (str "stderr " eb " bytes, " who "'s " (:stderr-bytes r) ": " (clean ef) (when (seq (:stderr-first r)) (str " | " who ": " (:stderr-first r))))]
      :else [:pass ""])))

;; D358-5 (a) (the user, 2026-11-18): a C++ program that aborts (std::terminate: status 134) runs under lli with lli's own signal
;; handler, which adds its stack dump ("Stack dump:", "PLEASE submit a bug report") to the program's stderr: lli's stderr is not the
;; module's meaning there. Such a module of the cpp corpus (cpp.runtime.N: runtime/N.cpp, cpp.samples.N: samples/N.cpp) is judged
;; against g++ 15's recorded run of the same program (test/cpp/ref-gxx15.edn, the C++ crop's reference: status, stdout and stderr by
;; their digests) when lli's record and g++'s agree on the status (134) and the stdout: only lli's addition to stderr is left out.

(def ^:private gxx-ref-file "test/cpp/ref-gxx15.edn")

(defn- gxx-records
  "g++'s record by its id (the file is one map a line, not a vector)."
  []
  (let [f (java.io.File. ^String gxx-ref-file)]
    (if (.exists f)
      (into {} (map (juxt :id identity) (read-string (str "[" (slurp f) "\n]"))))
      {})))

(defn- gxx-reference
  "The reference of module id: g++'s record (gxx: by its source id) in lli's record r's place when r is an abort of a cpp module whose
  status and stdout g++'s record shares; else r."
  [id r gxx]
  (let [src (when-let [[_ k n] (re-find #"^cpp\.(runtime|samples)\.(.+)$" (str id))] (str k "/" n ".cpp"))
        g (when src (gxx src))]
    (if (and r g (= 134 (:status r)) (= 134 (:status g)) (= (:stdout r) (:stdout g)) (string? (:stderr g)))
      {:who "g++" :status 134 :stdout (:stdout g) :stdout-bytes (:bytes g) :stderr (:stderr g) :stderr-bytes "?"
       :stderr-first (:first g) :ir (:ir r)}
      r)))

(defn- out-of [work id] (let [f (java.io.File. (str work "/out/" id ".out"))] (when (.exists f) (slurp f))))

(defn- verdicts
  "Each module's own verdict (nil: lli's record), by id; none under LLVMI_JUDGE=lli."
  [work]
  (into {} (for [[id p] (tsv (str work "/modules.tsv"))]
             [id (when (= "own" (judge-mode)) (try (own-verdict id p) (catch Throwable _ nil)))])))

(defn- rows
  "Every module's row: [ID RESULT REASON]."
  [work refs owns]
  (let [gxx (gxx-records)
        refs (fn [id] (gxx-reference id (refs id) gxx))
        lower (into {} (map (juxt first identity) (tsv (str work "/c/lower.tsv"))))
        build (into {} (map (juxt first identity) (tsv (str work "/build.tsv"))))
        goerr (into {} (map (juxt first identity) (tsv (str work "/go-errors.tsv"))))
        runs (into {} (map (juxt first identity) (tsv (str work "/run.tsv"))))]
    (vec (for [[id _ sha] (tsv (str work "/modules.tsv"))
               :let [r (refs id) v (owns id) [_ ls lc lm] (lower id) [_ bs bc bm] (build id)]]
           (into [id]
                 (cond
                   (and (nil? v) (nil? r)) [:no-ref "no lli run recorded (bin/llvmi record-ref)"]
                   (and (nil? v) (not= sha (:ir r))) [:stale-ref "the module's IR is not the one lli's run was recorded from"]
                   (nil? ls) [:no-lowering "the lowering wrote no line"]
                   (= ls "refused") [:refused (str lc ": " (clean lm))]
                   (nil? bs) [:build "no build line"]
                   (not= bs "ok") [:build (str bs (when (seq bc) (str " " bc)) ": " (clean bm))]
                   (goerr id) [:go-error (clean (second (goerr id)))]
                   (nil? (runs id)) [:no-run "built, not run"]
                   v (own-result (runs id) v (out-of work id))
                   :else (run-result (runs id) r)))))))

;; ---------------------------------------------------------------------------------------------
;; classes

(defn- classes-of [level]
  (vec (concat (when (= level "aot") (read-file "test/llvm/divergences-aot.edn"))
               (read-file "test/llvm/divergences-eval.edn"))))

(defn- classify [classes [id result reason]]
  (let [s (str (name result) " " reason)]
    (some (fn [c] (when (or (some #{id} (:tests c)) (some #(re-find % s) (:match c))) c)) classes)))

(defn- summary [classes rs]
  (let [non (remove #(= :pass (second %)) rs)
        by (group-by #(:id (classify classes %)) non)]
    (println "llvmi:" (count rs) "modules," (count (filter #(= :pass (second %)) rs)) "pass," (count non) "do not")
    (doseq [[k v] (sort-by (comp str key) by) :when k]
      (println (format "  %-24s %4d  %s" (name k) (count v) (str/join ", " (take 3 (map first v))))))
    (vec (get by nil))))

(defn- write-rec [^String f level rs]
  (spit f (str ";; llvmi's " (if (= level "aot") "AOT level (bin/llvmi check --aot: the lowered C translated by cf2g, built by TamaGo's go)"
                                 "eval level (bin/llvmi check: the lowered C run by ci)")
               " by the modules' own verdicts (llvm/test's lit\n;; RUN and CHECK lines, gcc's torture harness: exit 0), else against lli's recorded runs (test/llvm/ref-lli23.edn),\n"
               ";; one row [ID RESULT REASON] a module (goi's format); written by bin/llvmi check" (when (= level "aot") " --aot") " --record, read by\n"
               ";; bin/reap (test/reap/cells.edn, the :llvm row) and judged against test/llvm/divergences-" level ".edn. Read with the Clojure reader.\n[\n"
               (str/join (for [[id r why] rs] (str "[" (q id) " " r " " (q why) "]\n")))
               "]\n")))

(defn judge
  "judge WORK LEVEL REF REC CONTROLS [--record]"
  [[work level ref rec controls flag]]
  (let [refs (into {} (map (juxt :id identity) (or (read-file ref) [])))
        owns (verdicts work)
        rs (rows work refs owns)
        classes (classes-of level)
        subset? (.exists (java.io.File. (str work "/subset")))
        recorded (into {} (map (juxt first second) (or (read-file rec) [])))
        ;; AOT's heavy modules not built in a light run (bin/llvmi's WORK/kept.txt): their recorded rows kept
        kept (set (remove str/blank? (map str/trim (when (.exists (java.io.File. (str work "/kept.txt"))) (str/split-lines (slurp (str work "/kept.txt")))))))
        old-rows (into {} (map (juxt first identity) (or (read-file rec) [])))
        rs (vec (for [r rs] (if (and (kept (first r)) (old-rows (first r))) (old-rows (first r)) r)))
        _ (when (seq kept) (println "llvmi:" (count kept) "heavy modules not built (LLVMI_AOT_HEAVY=1 builds them): their recorded rows kept"))
        unclassed (summary classes rs)
        regress (for [[id r] rs :when (and (= :pass (recorded id)) (not= :pass r))] id)
        lacking (when-not subset? (remove (set (map first rs)) (keys recorded)))
        runs (into {} (map (juxt first identity) (tsv (str work "/run.tsv"))))
        ;; a control: the subject's run judged as the reference module is, by its own verdict when it has one, else against
        ;; lli's recorded run of it
        gxx (gxx-records)
        ctl (for [{:keys [subject reference]} (or (read-file controls) [])
                  :let [run (runs subject) r (gxx-reference reference (refs reference) gxx) v (owns reference)]
                  :when (and run (or v r))]
              [subject reference (first (if v (own-result run v (out-of work subject)) (run-result run r)))])
        ctl-pass (filter #(= :pass (nth % 2)) ctl)
        problems (concat (for [[id r why] unclassed] (str "in no class: " id " " (name r) " " why))
                         (for [id regress] (str "recorded as a pass, does not pass: " id))
                         (for [id lacking] (str "recorded, not in the run: " id))
                         (for [[s r] ctl-pass] (str "the negative control passes: " s "'s run against " r "'s reference")))]
    (spit (str work "/results.edn") (str "[\n" (str/join (for [[id r why] rs] (str "[" (q id) " " r " " (q why) "]\n"))) "]\n"))
    (println "llvmi:" (count (filter val owns)) "modules judged by their own verdicts," (count (remove val owns)) "against lli's recorded runs"
             (let [n (count (for [[id v] owns :when (and (nil? v) (:who (gxx-reference id (refs id) gxx)))] id))]
               (str "(of which " n " against g++'s, " gxx-ref-file ", for lli's own abort report)"))
             (str "(LLVMI_JUDGE " (judge-mode) ")"))
    (println "llvmi: negative controls:" (count ctl) "judged," (count ctl-pass) "pass (each must not)")
    (doseq [p problems] (println "FAIL" p))
    (when (= flag "--record")
      (if subset?
        ;; a subset's run (--only or --corpus) rewrites only its own rows: the record's other rows kept in their order, a module new
        ;; to the record appended (h-haskell-deferred, 2026-11-17: as bin/hsi check --record --only does)
        (let [old (or (read-file rec) [])
              new (into {} (map (juxt first identity) rs))
              merged (vec (concat (for [r old] (get new (first r) r))
                                  (remove #(contains? old-rows (first %)) rs)))]
          (write-rec rec level merged)
          (println "llvmi: recorded" (count rs) "rows of a subset into" rec "(its other" (- (count merged) (count rs)) "rows kept)"))
        (do (write-rec rec level rs) (println "llvmi: recorded" (count rs) "rows into" rec))))
    (System/exit (if (seq problems) 1 0))))

(defn divergences
  "divergences LEVEL REC: the recorded rows judged against the level's classes."
  [[level rec]]
  (let [rs (or (read-file rec) [])
        un (summary (classes-of level) rs)]
    (doseq [[id r why] un] (println "FAIL in no class:" id (name r) why))
    (System/exit (if (seq un) 1 0))))

;; ---------------------------------------------------------------------------------------------
;; the reviewed outcomes against the recorded runs (llvm-judge-1120): no module run

(defn- pack-ir
  "The IR digest of module id in the packs' manifests (test/llvm/ir/{c,tx}.tsv: ID SOURCE SOURCE-SHA256 IR-SHA256), or nil."
  [id]
  (some (fn [pk] (some (fn [[i _ _ sha]] (when (= i id) sha)) (tsv (str "test/llvm/ir/" pk ".tsv")))) ["c" "tx"]))

(defn derived-check
  "derived-check REF: each reviewed outcome of test/llvm/selfref-derived.edn judged by the check's own judge (own-result) against
  the module's recorded run, REF (lli's, test/llvm/ref-lli23.edn; an abort's stderr g++'s record, gxx-reference, D358-5 (a)), as the
  golden files of Java's JCS361 (a) are held to the JDK's recorded digests: nothing is run. An entry reviewed on an IR (:ir) must be
  the IR the run was recorded from and the pack's. Controls, each must not pass: every entry's outcome with its stdout's middle byte
  changed (an empty stdout: its status) against its own record, every entry's record against the next entry of another outcome, and
  CONTROLS' pairs (test/llvm/controls.edn) whose reference has a reviewed outcome: the subject's recorded run against it.
  Exit 1 on an entry its record does not meet or a control that passes."
  [[ref controls]]
  (let [refs (into {} (map (juxt :id identity) (or (read-file ref) [])))
        gxx (gxx-records)
        ;; a golden file of a program llvmi has no module of (not in the packs' manifests) is C++'s alone
        [es mine] ((juxt remove filter) #(and (= :golden (:from %)) (nil? (pack-ir (:id %)))) (sort-by :id (vals (derived))))
        _ (doseq [e mine] (println (format "  %-44s -      no module of llvmi's (not in test/llvm/ir's manifests): C++'s alone" (:id e))))
        rec (fn [id] (gxx-reference id (refs id) gxx))
        line (fn [id r] [id (if (= :timeout (:status r)) "timeout" (str (:status r))) (:stdout r) (str (:stdout-bytes r))
                         (:stderr r) (str (:stderr-bytes r)) (str (:stderr-first r))])
        verdict entry-verdict
        rows (vec (for [e es :let [id (:id e) r (rec id)]]
                    [id (cond (and (= :ir (:from e)) (not (:ir e))) [:review "an outcome from the IR names no :ir"]
                              ;; a review row a printed line, in order: the rows are the stdout
                              (and (:review e) (not= (:stdout e) (str/join (map #(str (first %) "\n") (:review e)))))
                              [:review "the :review rows are not the :stdout's lines"]
                              (and (:review e) (some #(str/blank? (second %)) (:review e))) [:review "a :review row without its basis"]
                              (nil? r) [:no-ref (str "no recorded run in " ref)]
                              (and (:ir e) (not= (:ir e) (:ir r))) [:ir (str "reviewed on IR " (:ir e) ", the run recorded from " (:ir r))]
                              (and (:ir e) (not= (:ir e) (pack-ir id))) [:ir (str "reviewed on IR " (:ir e) ", the pack's " (pack-ir id))]
                              :else (own-result (line id r) (verdict e) nil))
                     (:who r)]))
        mutate (fn [e]
                 (let [s ^String (:stdout e)]
                   (if (pos? (count s))
                     (let [i (quot (count s) 2) c (.charAt s i)]
                       (assoc e :stdout (str (subs s 0 i) (if (= c \#) \% \#) (subs s (inc i)))))
                     (assoc e :status (inc (long (:status e)))))))
        outcome (juxt :status :stdout :stderr)
        mutated (for [e es :let [r (rec (:id e))] :when r]
                  [(:id e) "its own outcome changed" (first (own-result (line (:id e) r) (verdict (mutate e)) nil))])
        crossed (for [[a b] (map vector es (concat (rest es) [(first es)]))
                      :let [b (first (filter #(not= (outcome a) (outcome %)) (cons b es))) r (rec (:id a))]
                      :when (and b r)]
                  [(:id a) (str (:id b) "'s outcome") (first (own-result (line (:id a) r) (verdict b) nil))])
        paired (for [{:keys [subject reference]} (or (when controls (read-file controls)) [])
                     :let [e (get (derived) reference) r (rec subject)]
                     :when (and e r)]
                 [subject (str reference "'s outcome (" controls ")") (first (own-result (line subject r) (verdict e) nil))])
        ctl (concat mutated crossed paired)
        bad (remove #(= :pass (first (second %))) rows)
        ctl-pass (filter #(= :pass (nth % 2)) ctl)]
    (doseq [[id [r why] who] rows]
      (println (format "  %-44s %-6s %s" id (name r) (if (= r :pass) (str "the recorded run's (" (or who "lli") ")") why))))
    (println "llvmi derived-check:" (count rows) "reviewed outcomes," (- (count rows) (count bad))
             (str "met by the recorded runs (" (count (filter #(= "g++" (nth % 2)) rows)) " aborts' stderr g++'s); controls:")
             (count mutated) "changed," (count crossed) "crossed," (count paired) "of the check's controls,"
             (count ctl-pass) "pass (each must not)")
    (doseq [[id [r why]] bad] (println "FAIL" id (name r) why))
    (doseq [[s what] ctl-pass] (println "FAIL the control passes:" s "against" what))
    (System/exit (if (or (seq bad) (seq ctl-pass)) 1 0))))

(defn main-envp?
  "small-tails (2026-11-21): whether the module's main takes main's third argument, the environment (`define ... @main(i32,
  ptr, ptr)`): lit runs lli, which passes it lit's environment, never an empty one (ExecutionEngine/MCJIT/2003-08-21-
  EnvironmentTest reads envp[0]); ci starts a program with none unless told (go/arbace/ci/prog.ae's RunMain, RES29 (a)'s
  --env), so bin/llvmi runs such a module with --env under a fixed environment of its own (bin/llvmi's llvmi_env)."
  [^String path]
  (boolean
    (when-let [[_ ps] (re-find #"(?m)^define\b[^\n]*?@main\(([^)]*)\)" (slurp path))]
      (= 3 (count (remove str/blank? (str/split ps #",")))))))

(defn run-args
  "run-args MODULES: each module's arguments its own verdict's RUN lines give (ID<TAB>ARG ...<TAB>ENV a line, the modules with
  arguments or an environment alone), which bin/llvmi's runs pass to the program; no arguments under LLVMI_JUDGE=lli (lli's
  record ran with none). ENV is `env` for a module whose main takes the environment (main-envp?: run with --env under bin/llvmi's
  fixed environment), else empty; in either judge mode (lli's record ran under the runner's environment)."
  [[modules]]
  (doseq [[id p] (tsv modules)
          :let [a (when (= "own" (judge-mode)) (:args (try (own-verdict id p) (catch Throwable _ nil))))
                e (try (main-envp? p) (catch Throwable _ false))]
          :when (or (seq a) e)]
    (println (str id "\t" (str/join " " a) "\t" (if e "env" ""))))
  (flush)
  (System/exit 0))

(defn -main [verb & args]
  (case verb
    "run-args" (run-args args)
    "record-ref" (let [[work ref only] args] (record-ref work ref (= only "--only")))
    "judge" (judge args)
    "divergences" (divergences args)
    "derived-check" (derived-check args)
    (do (println "arbace.llvm.check: record-ref WORK REF [--only] | judge WORK LEVEL REF REC CONTROLS [--record] | divergences LEVEL REC | derived-check REF")
        (System/exit 2))))

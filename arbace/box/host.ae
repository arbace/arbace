;; arbace.box's host layer (doc/go/BOX-NOTES.md, S3; the Go build's variant until S4, when the
;; JVM's java.nio one left with the JVM, BX37: doc/STANDALONE-NOTES.md): over jrt's own Java
;; jdk.internal.jrt.HostStore, whose natives answer from the monitor's calls in the box and from
;; the directory ARBACE_BOX_STORE names natively (go/arbace/jrt/store.ae).
(ns arbace.box.host
  "arbace.box's host layer: jdk.internal.jrt.HostStore's answers (0, or -1 none
  or refused, -2 a failed compare-and-set, -3 no store, -4 too large, -5 a bad name)."
  (:refer-clojure :exclude [read ref])
  (:import (jdk.internal.jrt HostStore)))

(defn status
  "0 when there is a store, else -3."
  []
  (HostStore/status))

(defn put
  "Stores the bytes of b, writing their hash to h (32 bytes): 0, or a negative answer."
  [^bytes b ^bytes h]
  (HostStore/put b 0 (alength b) h))

(defn size
  "The size of blob h (32 bytes), or a negative answer (-1: none)."
  [^bytes h]
  (HostStore/size h))

(defn read
  "Blob h whole, nil when there is none."
  [^bytes h]
  (HostStore/read h))

(defn ref
  "Writes the hash ref name points at to h: 0, or a negative answer (-1: no such ref)."
  [^String name ^bytes h]
  (HostStore/ref name h))

(defn set-ref
  "Points ref name at blob h, only if it points at old when old is not nil (all zero: if there is
  no such ref): 0, or a negative answer (-2: the comparison failed)."
  [^String name ^bytes h ^bytes old]
  (HostStore/setRef name h old))

(defn tar
  "The snapshot of directory dir as a tar, or nil with the reason in err[0]."
  [^String dir err]
  (HostStore/tar dir err))

(defn untar
  "Writes tar's directories and regular files under dir: nil, or the reason."
  [^bytes tar ^String dir]
  (HostStore/untar tar dir))

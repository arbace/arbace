;; arbace.box's host layer on the JVM (doc/go/BOX-NOTES.md, S3, BX37). The Go build replaces this
;; namespace with its variant arbace/lang/go/ns/box/host.ae, over jrt's jdk.internal.jrt.HostStore
;; (overlay/jdk), whose natives are go/arbace/jrt/store.ae and store_linux.ae: this file does on
;; the JVM what those do natively, with the same answers, in the same directory format, so that
;; one store directory serves the JVM, the native executable and boxes, in turn or at once.
(ns arbace.box.host
  "arbace.box's host layer on the JVM: the store in the directory ARBACE_BOX_STORE names, in the
  format of the box's monitor (go-whim's vmm.DirStore): blobs/HASH (the bytes, named by their
  SHA-256 in lowercase hex), refs/NAME (the hash in hex and a newline), refs/.lock (the refs'
  lock). Refs are read under a shared and written under an exclusive POSIX record lock of
  refs/.lock (FileChannel.lock: fcntl F_SETLKW over the whole file, the lock the monitor and the
  native executable take), so that a compare-and-set is one at a time across processes; a blob
  or a ref is written to a temporary name and renamed (0644), and a blob is held to its hash when
  read. ARBACE_BOX_STORE_MAX is the largest blob put takes (bytes, or with B, KiB, MiB, GiB, TiB;
  off; by default 256 MiB).

  The answers are jdk.internal.jrt.HostStore's (the box's ABI's): 0, or -1 (no such blob or ref,
  or the host's error), -2 (a compare-and-set that failed), -3 (no store), -4 (too large), -5 (a
  name the store does not take). Snapshots (tar, untar) are the native executable's byte for
  byte: Go's archive/tar as jrt's SnapshotTar writes it."
  (:refer-clojure :exclude [read ref])
  (:import (java.io ByteArrayInputStream ByteArrayOutputStream InputStream InputStreamReader
                    IOException)
           (java.nio ByteBuffer)
           (java.nio.channels FileChannel FileLock)
           (java.nio.charset StandardCharsets)
           (java.nio.file AccessDeniedException CopyOption DirectoryNotEmptyException
                          FileAlreadyExistsException Files LinkOption NoSuchFileException
                          NotDirectoryException OpenOption Path Paths StandardCopyOption
                          StandardOpenOption)
           (java.nio.file.attribute FileAttribute PosixFileAttributes PosixFilePermission
                                    PosixFilePermissions)
           (java.security MessageDigest)
           (java.util Arrays HashSet Set)
           (java.util.concurrent.locks ReentrantLock)))

(set! *warn-on-reflection* true)

;; ---------------------------------------------------------------------------------------
;; The answers (HostStore's, the box's ABI's Store*)

(def ^:private ok 0)
(def ^:private refused -1)
(def ^:private conflict -2)
(def ^:private none -3)
(def ^:private too-large -4)
(def ^:private bad-name -5)

(def ^:private ^:const max-array
  "The longest blob read whole: the largest array (HostStore.MAX_ARRAY)."
  (- Integer/MAX_VALUE 8))

;; ---------------------------------------------------------------------------------------
;; Names, sizes, hashes

(defn store-name?
  "Is name one the store takes: 1 to 64 of [A-Za-z0-9._-], not beginning with a dot (jrt's
  StoreName, the monitor's RefName)?"
  [^String name]
  (boolean (and (re-matches #"[A-Za-z0-9._-]{1,64}" name) (not (.startsWith name ".")))))

(def ^:private default-max
  "The largest blob a store takes when ARBACE_BOX_STORE_MAX does not say: 256 MiB."
  (bit-shift-left 256 20))

(defn- parse-byte-count
  "A GOMEMLIMIT as Go's runtime reads it (jrt's parseByteCount): off, or a count of bytes with an
  optional unit B, KiB, MiB, GiB or TiB; nil when it is none."
  [^String s]
  (if (= s "off")
    Long/MAX_VALUE
    (let [[unit ^String s] (reduce (fn [[unit ^String s] [i ^String u]]
                                     (if (.endsWith s u)
                                       [(bit-shift-left 1 (* 10 (inc i))) (subs s 0 (- (count s) (count u)))]
                                       [unit s]))
                                   [1 s] (map-indexed vector ["KiB" "MiB" "GiB" "TiB"]))
          s (if (and (= unit 1) (.endsWith s "B")) (subs s 0 (dec (count s))) s)]
      (when (re-matches #"[+-]?[0-9]+" s)
        (when-let [n (try (Long/parseLong s) (catch NumberFormatException _ nil))]
          (when (and (>= n 0) (<= n (quot Long/MAX_VALUE unit)))
            (* n unit)))))))

(defn store-max
  "ARBACE_BOX_STORE_MAX's value as the store reads it (jrt's StoreMax): the largest blob, 0 for no
  limit (off), 256 MiB when empty; nil when it is not a size."
  [^String s]
  (case s
    "" default-max
    "off" 0
    (let [n (parse-byte-count s)]
      (when (and n (pos? n)) n))))

(defn- sha256 ^bytes [^bytes b]
  (.digest (MessageDigest/getInstance "SHA-256") b))

(defn- hex ^String [^bytes b]
  (let [sb (StringBuilder. 64)]
    (dotimes [i (alength b)]
      (let [x (bit-and (aget b i) 0xff)]
        (.append sb (Character/forDigit (bit-shift-right x 4) 16))
        (.append sb (Character/forDigit (bit-and x 15) 16))))
    (str sb)))

(defn- unhex
  "The 32 bytes the 64 hexadecimal digits of s say (either case, as Go's hex.Decode), or nil."
  ^bytes [^String s]
  (when (and (= 64 (.length s)) (re-matches #"[0-9a-fA-F]{64}" s))
    (let [b (byte-array 32)]
      (dotimes [i 32]
        (aset b i (unchecked-byte (Integer/parseInt (subs s (* 2 i) (+ 2 (* 2 i))) 16))))
      b)))

(defn- zero-hash? [^bytes h]
  (every? zero? h))

;; ---------------------------------------------------------------------------------------
;; Errors as Go says them (the reasons save-fs! and load-fs! give, as the native executable's)

(defn- reason
  "Exception e as Go's os package would word the error of op on its file."
  ^String [op ^Throwable e]
  (let [file (when (instance? java.nio.file.FileSystemException e)
               (.getFile ^java.nio.file.FileSystemException e))
        why (cond
              (instance? NoSuchFileException e) "no such file or directory"
              (instance? AccessDeniedException e) "permission denied"
              (instance? FileAlreadyExistsException e) "file exists"
              (instance? NotDirectoryException e) "not a directory"
              (instance? DirectoryNotEmptyException e) "directory not empty"
              (instance? java.nio.file.FileSystemException e)
                (or (.getReason ^java.nio.file.FileSystemException e) (.getMessage e))
              :else (or (.getMessage e) (str (class e))))]
    (if file (str op " " file ": " why) why)))

;; ---------------------------------------------------------------------------------------
;; The directory store

(def ^:private no-links (make-array LinkOption 0))
(def ^:private no-options (make-array OpenOption 0))

(defn- perms ^Set [^String s]
  (PosixFilePermissions/fromString s))

(defn- attrs [^String s]
  (into-array FileAttribute [(PosixFilePermissions/asFileAttribute (perms s))]))

(defn- open-lock
  "refs/.lock, opened to read and write (made 0644 when missing): the channel the refs' locks are
  taken on."
  ^FileChannel [^Path dir]
  (let [opts (doto (HashSet.)
               (.add StandardOpenOption/READ) (.add StandardOpenOption/WRITE)
               (.add StandardOpenOption/CREATE))]
    (FileChannel/open (.resolve dir "refs/.lock") ^Set opts ^"[Ljava.nio.file.attribute.FileAttribute;" (attrs "rw-r--r--"))))

(defn open-store
  "The store in directory dir (its blobs and refs directories and refs/.lock made when missing),
  taking blobs up to limit bytes (0: any): a map of the store's state. Throws an IOException when
  it cannot be opened."
  [dir limit]
  (let [d (Paths/get (str dir) (make-array String 0))]
    (doseq [s ["blobs" "refs"]]
      (Files/createDirectories (.resolve d ^String s) (attrs "rwxr-xr-x")))
    {:dir d
     :max (long limit)
     :mu (ReentrantLock.)
     ;; the channel of the refs' lock: one per store, kept open (closing any descriptor of the
     ;; file would release the process's locks on it), opened again if an interrupt closed it
     :lock (atom (open-lock d))}))

(def ^:private the-store
  (delay
    (let [dir (or (System/getenv "ARBACE_BOX_STORE") "")]
      (when-not (= dir "")
        (if-let [limit (store-max (or (System/getenv "ARBACE_BOX_STORE_MAX") ""))]
          (try
            (open-store dir limit)
            (catch Exception e
              (.println System/err (str "arbace: ARBACE_BOX_STORE: " (reason "mkdir" e)))
              nil))
          (do (.println System/err "arbace: ARBACE_BOX_STORE_MAX: not a size (bytes, KiB, MiB, GiB, TiB) or off")
              nil))))))

(defn current
  "The store ARBACE_BOX_STORE names, opened once; nil without one (or when it cannot be opened, as
  standard error says once)."
  []
  @the-store)

(defn- blob-path ^Path [st ^bytes h]
  (.resolve ^Path (:dir st) (str "blobs/" (hex h))))

(defn- ref-path ^Path [st ^String name]
  (.resolve ^Path (:dir st) (str "refs/" name)))

(defn- verified-size
  "The size of blob h when its file holds bytes of that hash (one a write left short, or changed,
  is none), else nil."
  [st ^bytes h]
  (try
    (with-open [^InputStream in (Files/newInputStream (blob-path st h) no-options)]
      (let [md (MessageDigest/getInstance "SHA-256")
            buf (byte-array 65536)]
        (loop [n 0]
          (let [k (.read in buf)]
            (if (neg? k)
              (when (Arrays/equals (.digest md) h) n)
              (do (.update md buf 0 k)
                  (recur (+ n k))))))))
    (catch IOException _ nil)))

(defn- load-blob
  "Blob h whole, held to its hash; nil when there is none. A blob longer than an array can be is
  an IllegalStateException (HostStore.read)."
  [st ^bytes h]
  (when-let [n (verified-size st h)]
    (when (> n max-array)
      (throw (IllegalStateException. (str "blob of " n " bytes: longer than an array can be"))))
    (try
      (let [b (Files/readAllBytes (blob-path st h))]
        (when (Arrays/equals (sha256 b) h) b))
      (catch IOException _ nil))))

(defn- write-renamed!
  "Writes data to a temporary file in dir (prefix, then digits), 0644, and renames it to target."
  [^Path dir ^String prefix ^bytes data ^Path target]
  (let [tmp (Files/createTempFile dir prefix "" (make-array FileAttribute 0))]
    (try
      (Files/setPosixFilePermissions tmp (perms "rw-r--r--"))
      (Files/write tmp data ^"[Ljava.nio.file.OpenOption;" no-options)
      (Files/move tmp target (into-array CopyOption [StandardCopyOption/ATOMIC_MOVE]))
      (catch Throwable e
        (Files/deleteIfExists tmp)
        (throw e)))))

(defn- with-refs-lock
  "Calls f holding the process's lock and the refs' lock between processes (shared to read,
  exclusive to write); refused when the lock cannot be taken."
  [st shared f]
  (let [^ReentrantLock mu (:mu st)]
    (.lock mu)
    (try
      (let [a (:lock st)
            ^FileChannel ch (let [^FileChannel ch @a]
                              (if (.isOpen ch) ch (reset! a (open-lock (:dir st)))))
            l (try (.lock ch 0 Long/MAX_VALUE (boolean shared)) (catch IOException _ nil))]
        (if (nil? l)
          refused
          (try (f) (finally (try (.release ^FileLock l) (catch IOException _ nil))))))
      (finally (.unlock mu)))))

(defn- read-ref
  "The hash in refs/NAME, or nil (under the refs' locks)."
  ^bytes [st ^String name]
  (try
    (unhex (.strip (String. (Files/readAllBytes (ref-path st name)) StandardCharsets/ISO_8859_1)))
    (catch IOException _ nil)))

;; ---------------------------------------------------------------------------------------
;; The host layer (arbace.box's; the Go build's is jdk.internal.jrt.HostStore)

(defn status
  "0 when there is a store, else -3."
  []
  (if (current) ok none))

(defn put
  "Stores the bytes of b, writing their hash to h (32 bytes): 0, or a negative answer."
  [^bytes b ^bytes h]
  (if-let [st (current)]
    (let [limit (long (:max st))]
      (if (and (pos? limit) (> (alength b) limit))
        too-large
        (let [hb (sha256 b)]
          (if (or (some? (verified-size st hb))
                  (try
                    (write-renamed! (.resolve ^Path (:dir st) "blobs") ".put-" b (blob-path st hb))
                    true
                    (catch IOException _ false)))
            (do (System/arraycopy hb 0 h 0 32) ok)
            refused))))
    none))

(defn size
  "The size of blob h (32 bytes), or a negative answer (-1: none)."
  [^bytes h]
  (if-let [st (current)]
    (or (verified-size st h) refused)
    none))

(defn read
  "Blob h whole, nil when there is none (or no store)."
  [^bytes h]
  (when-let [st (current)]
    (load-blob st h)))

(defn ref
  "Writes the hash ref name points at to h: 0, or a negative answer (-1: no such ref)."
  [^String name ^bytes h]
  (if-let [st (current)]
    (if-not (store-name? name)
      bad-name
      (with-refs-lock st true
        (fn []
          (if-let [cur (read-ref st name)]
            (do (System/arraycopy cur 0 h 0 32) ok)
            refused))))
    none))

(defn set-ref
  "Points ref name at blob h, only if it points at old when old is not nil (all zero: if there is
  no such ref): 0, or a negative answer (-2: the comparison failed; -1: no such blob)."
  [^String name ^bytes h ^bytes old]
  (if-let [st (current)]
    (cond
      (not (store-name? name)) bad-name
      (nil? (verified-size st h)) refused
      :else
      (with-refs-lock st false
        (fn []
          (let [cur (when old (read-ref st name))]
            (if (and old (or (not= (some? cur) (not (zero-hash? old)))
                             (and cur (not (Arrays/equals cur old)))))
              conflict
              (try
                (write-renamed! (.resolve ^Path (:dir st) "refs") ".set-"
                                (.getBytes (str (hex h) "\n") StandardCharsets/US_ASCII)
                                (ref-path st name))
                ok
                (catch IOException _ refused)))))))
    none))

;; ---------------------------------------------------------------------------------------
;; Go's path package (names in tars are its)

(defn- clean
  "Go's path.Clean."
  ^String [^String p]
  (if (= p "")
    "."
    (let [rooted (.startsWith p "/")
          out (reduce (fn [out ^String e]
                        (cond
                          (or (= e "") (= e ".")) out
                          (= e "..") (cond
                                       (and (seq out) (not= ".." (peek out))) (pop out)
                                       rooted out
                                       :else (conj out ".."))
                          :else (conj out e)))
                      [] (.split p "/"))
          s (str (when rooted "/") (apply str (interpose "/" out)))]
      (if (= s "") "." s))))

(defn- join
  "Go's path.Join."
  ^String [& elems]
  (let [es (remove #(= "" %) elems)]
    (if (empty? es) "" (clean (apply str (interpose "/" es))))))

(defn- split
  "Go's path.Split: [dir file]."
  [^String p]
  (let [i (.lastIndexOf p "/")]
    [(subs p 0 (inc i)) (subs p (inc i))]))

(defn- dir-of
  "Go's path.Dir."
  ^String [^String p]
  (clean (first (split p))))

;; ---------------------------------------------------------------------------------------
;; Snapshots: a directory as a tar, byte for byte as jrt's SnapshotTar writes it with Go's
;; archive/tar (each header Format PAX, ModTime the epoch: USTAR when it can say the entry, PAX
;; records for a name it cannot or a size beyond its field)

(defn- utf8 ^bytes [^String s] (.getBytes s StandardCharsets/UTF_8))

(defn- ascii? [^String s]
  (every? #(let [c (int %)] (and (< c 0x80) (not= c 0))) s))

(defn- to-ascii
  "Go's tar toASCII: s without its characters outside ASCII and its NULs."
  ^String [^String s]
  (apply str (filter #(let [c (int %)] (and (< c 0x80) (not= c 0))) s)))

(defn- put-string!
  "Go's tar formatter.formatString: s (ASCII) at off, len bytes, NUL-terminated if it fits."
  [^bytes blk off len ^String s]
  (let [b (.getBytes s StandardCharsets/ISO_8859_1)
        n (min (alength b) len)]
    (System/arraycopy b 0 blk off n)
    (when (< (alength b) len)
      (aset blk (+ off (alength b)) (byte 0)))
    ;; a trailing slash cut off at the field's end is no NUL terminator (buggy readers)
    (when (and (> (alength b) len) (= (aget blk (+ off len -1)) (byte (int \/))))
      (let [t (.replaceAll (subs s 0 (dec len)) "/+$" "")]
        (aset blk (+ off (count t)) (byte 0))))))

(defn- fits-octal? [len ^long x]
  (and (>= x 0) (or (>= len 22) (< x (bit-shift-left 1 (* 3 (dec len)))))))

(defn- put-octal!
  "Go's tar formatter.formatOctal: x in octal, zero-padded, leaving room for a NUL (0 when it does
  not fit)."
  [^bytes blk off len x]
  (let [x (if (fits-octal? len x) x 0)
        s (Long/toOctalString x)
        pad (- len (count s) 1)
        s (if (pos? pad) (str (apply str (repeat pad \0)) s) s)]
    (put-string! blk off len s)))

(defn- checksum!
  "Go's block.setFormat for USTAR and PAX: the magic, the version, the checksum."
  [^bytes blk]
  (System/arraycopy (.getBytes "ustar\u000000" StandardCharsets/ISO_8859_1) 0 blk 257 8)
  (let [sum (loop [i 0 sum 0]
              (if (< i 512)
                (recur (inc i) (+ sum (if (<= 148 i 155) 32 (bit-and (aget blk i) 0xff))))
                sum))]
    (put-octal! blk 148 7 sum)
    (aset blk 155 (byte 32))))

(defn- header-block
  "A header block (Go's templateV7Plus, then the format's fields): type flag, name (ASCII), mode,
  size; uid, gid, the times and the device numbers 0, no owner names, the prefix (USTAR)."
  ^bytes [typeflag ^String name mode size ^String prefix]
  (let [blk (byte-array 512)]
    (aset blk 156 (byte (int typeflag)))
    (put-string! blk 0 100 name)
    (put-string! blk 157 100 "")
    (put-octal! blk 100 8 mode)
    (put-octal! blk 108 8 0)
    (put-octal! blk 116 8 0)
    (put-octal! blk 124 12 size)
    (put-octal! blk 136 12 0)
    (put-string! blk 265 32 "")
    (put-string! blk 297 32 "")
    (put-octal! blk 329 8 0)
    (put-octal! blk 337 8 0)
    (when prefix (put-string! blk 345 155 prefix))
    (checksum! blk)
    blk))

(defn- split-ustar
  "Go's splitUSTARPath: [prefix name] when name (ASCII, over 100 bytes) splits at a slash into a
  prefix of at most 155 bytes and a name of at most 100, else nil."
  [^String name]
  (let [n (count name)]
    (when (and (> n 100) (ascii? name))
      (let [length (cond (> n 156) 156
                         (= \/ (.charAt name (dec n))) (dec n)
                         :else n)
            i (.lastIndexOf (subs name 0 length) "/")
            nlen (- n i 1)]
        (when-not (or (<= i 0) (> nlen 100) (zero? nlen) (> i 155))
          [(subs name 0 i) (subs name (inc i))])))))

(defn- pad! [^ByteArrayOutputStream out n]
  (.write out (byte-array (bit-and (- n) 511)) 0 (bit-and (- n) 511)))

(defn- pax-record
  "Go's formatPAXRecord."
  ^String [^String k ^String v]
  (let [base (+ (count (utf8 k)) (count (utf8 v)) 3)
        size (+ base (count (str base)))
        size (if (not= size (+ base (count (str size)))) (+ base (count (str size))) size)]
    (str size " " k "=" v "\n")))

(defn- write-header!
  "Writes the header of an entry (Go's Writer.WriteHeader with Format PAX): USTAR when its fields
  say it, else a PAX extended header (its records sorted) and the PAX header."
  [^ByteArrayOutputStream out typeflag ^String name mode size]
  (let [nb (count (utf8 name))
        name-ok (and (ascii? name) (<= nb 100))
        ustar-split (when-not name-ok (split-ustar name))
        size-ok (fits-octal? 12 size)
        recs (cond-> (sorted-map)
               (and (not name-ok) (nil? ustar-split)) (assoc "path" name)
               (not size-ok) (assoc "size" (str size)))]
    (cond
      (empty? recs)
      (let [[prefix n] (or ustar-split [nil name])]
        (.write out (header-block typeflag n mode size prefix) 0 512))
      :else
      (let [data (utf8 (apply str (map (fn [[k v]] (pax-record k v)) recs)))
            [d f] (split name)
            xname (let [s (to-ascii (join d "PaxHeaders.0" f))
                        s (if (> (count s) 100) (subs s 0 100) s)]
                    (.replaceAll s "/+$" ""))
            xblk (byte-array 512)]
        (aset xblk 156 (byte (int \x)))
        (put-string! xblk 0 100 xname)
        (put-octal! xblk 100 8 0)
        (put-octal! xblk 108 8 0)
        (put-octal! xblk 116 8 0)
        (put-octal! xblk 124 12 (alength data))
        (put-octal! xblk 136 12 0)
        (checksum! xblk)
        (.write out xblk 0 512)
        (.write out data 0 (alength data))
        (pad! out (alength data))
        (.write out (header-block typeflag (to-ascii name) mode size nil) 0 512)))))

(defn- go-path ^Path [^String p]
  (Paths/get p (make-array String 0)))

(defn- stat
  "The file's attributes, following links (Go's os.Stat)."
  ^PosixFileAttributes [^String p]
  (Files/readAttributes (go-path p) PosixFileAttributes ^"[Ljava.nio.file.LinkOption;" no-links))

(defn- perm-bits
  "A set of PosixFilePermission as its nine bits."
  [^Set ps]
  (reduce (fn [m ^PosixFilePermission p]
            (bit-or m (bit-shift-left 1 (- 8 (.ordinal p)))))
          0 ps))

(defn- bits->perms
  "Nine permission bits as a string rwxrwxrwx."
  ^String [m]
  (apply str (map (fn [i c] (if (bit-test m (- 8 i)) c \-)) (range 9) "rwxrwxrwx")))

(defn- read-dir
  "The names in directory p in byte order (Go's os.ReadDir)."
  [^String p]
  (let [names (with-open [ds (Files/newDirectoryStream (go-path p))]
                (mapv #(str (.getFileName ^Path %)) ds))]
    (sort-by identity (fn [a b] (Arrays/compareUnsigned (utf8 a) (utf8 b))) names)))

(defn- tar-dir!
  "Writes the entries of directory rel under dir, and theirs (jrt's tarDir)."
  [^ByteArrayOutputStream out ^String dir ^String rel]
  (doseq [^String n (try (read-dir (join dir rel))
                         (catch IOException e (throw (ex-info (reason "open" e) {}))))]
    (let [r (join rel n)
          full (join dir r)
          ^PosixFileAttributes a (try (stat full) (catch IOException e (throw (ex-info (reason "stat" e) {}))))
          mode (perm-bits (.permissions a))]
      (cond
        (.isDirectory a)
        (do (write-header! out \5 (str r "/") mode 0)
            (tar-dir! out dir r))
        (.isRegularFile a)
        (let [^bytes data (try (Files/readAllBytes (go-path full))
                        (catch IOException e (throw (ex-info (reason "open" e) {}))))]
          (write-header! out \0 r mode (alength data))
          (.write out data 0 (alength data))
          (pad! out (alength data)))))))

(defn tar
  "The snapshot of directory dir as a tar (its directories and regular files, each directory's
  entries in order, names relative to dir, permissions kept, the times the epoch, no owner), or
  nil with the reason in err[0]."
  [^String dir ^objects err]
  (try
    (let [^PosixFileAttributes a (try (stat dir) (catch IOException e (throw (ex-info (reason "stat" e) {}))))]
      (when-not (.isDirectory a)
        (throw (ex-info (str dir ": not a directory") {})))
      (let [out (ByteArrayOutputStream.)]
        (tar-dir! out dir "")
        (.write out (byte-array 1024) 0 1024)
        (.toByteArray out)))
    (catch Exception e
      (aset err 0 (or (ex-message e) (str e)))
      nil)))

;; ---------------------------------------------------------------------------------------
;; Restoring a tar (jrt's RestoreTar over Go's archive/tar Reader: USTAR, PAX, GNU long names)

(defn- bad-tar [] (throw (ex-info "archive/tar: invalid tar header" {})))

(defn- field-string
  "A NUL-terminated string field (Go's parser.parseString), its bytes as UTF-8."
  ^String [^bytes blk off len]
  (let [end (loop [i off] (if (and (< i (+ off len)) (not= 0 (aget blk i))) (recur (inc i)) i))]
    (String. blk (int off) (int (- end off)) StandardCharsets/UTF_8)))

(defn- field-number
  "A numeric field (Go's parser.parseNumeric): base-256 when its first byte's top bit is set, else
  octal (NULs and spaces around)."
  [^bytes blk off len]
  (if (not= 0 (bit-and (aget blk off) 0x80))
    (let [neg (not= 0 (bit-and (aget blk off) 0x40))
          x (loop [i off x 0]
              (if (< i (+ off len))
                (let [c (bit-and (aget blk i) 0xff)
                      c (if neg (bit-xor c 0xff) c)
                      c (if (= i off) (bit-and c 0x7f) c)]
                  (when-not (zero? (unsigned-bit-shift-right x 56))
                    (bad-tar))
                  (recur (inc i) (bit-or (bit-shift-left x 8) c)))
                x))]
      (when (neg? x) (bad-tar))
      (if neg (bit-not x) x))
    (let [s (.replaceAll (String. blk (int off) (int len) StandardCharsets/ISO_8859_1) "^[ \u0000]+|[ \u0000]+$" "")
          s (let [i (.indexOf s "\u0000")] (if (neg? i) s (subs s 0 i)))]
      (cond
        (= s "") 0
        (re-matches #"[0-7]+" s) (try (Long/parseLong s 8) (catch NumberFormatException _ (bad-tar)))
        :else (bad-tar)))))

(defn- read-fully
  "n bytes of in, or nil at the end (none read); a short read is an error."
  ^bytes [^InputStream in n]
  (let [b (.readNBytes in (int n))]
    (cond
      (= (alength b) n) b
      (zero? (alength b)) nil
      :else (throw (ex-info "unexpected EOF" {})))))

(defn- skip-fully! [^InputStream in n]
  (when (pos? n)
    (let [b (.readNBytes in (int n))]
      (when (< (alength b) n) (throw (ex-info "unexpected EOF" {}))))))

(defn- pax-records
  "The records of a PAX extended header (Go's parsePAX): {key value}."
  [^bytes data]
  (loop [s (String. data StandardCharsets/UTF_8) m {}]
    (if (= s "")
      m
      (let [sp (.indexOf s " ")
            _ (when (neg? sp) (bad-tar))
            n (try (Long/parseLong (subs s 0 sp)) (catch NumberFormatException _ (bad-tar)))
            ;; the record's length is in bytes
            sb (utf8 s)
            _ (when (or (< n 5) (> n (alength sb))) (bad-tar))
            rec (String. sb (int 0) (int n) StandardCharsets/UTF_8)
            _ (when-not (.endsWith rec "\n") (bad-tar))
            kv (subs rec (inc sp) (dec (count rec)))
            eq (.indexOf kv "=")
            _ (when (neg? eq) (bad-tar))]
        (recur (String. sb (int n) (int (- (alength sb) n)) StandardCharsets/UTF_8)
               (assoc m (subs kv 0 eq) (subs kv (inc eq))))))))

(defn- next-entry
  "The next file's header {:type :name :mode :size} (Go's Reader.next: its PAX and GNU long-name
  headers applied, a legacy NUL type made a file or a directory), or nil at the end."
  [^InputStream in]
  (loop [pax {} long-name nil]
    (let [blk (read-fully in 512)]
      (cond
        (nil? blk) nil
        (every? zero? blk)
        (let [b2 (read-fully in 512)]
          (cond (nil? b2) nil
                (every? zero? b2) nil
                :else (bad-tar)))
        :else
        (let [sum (field-number blk 148 8)
              [u s] (loop [i 0 u 0 s 0]
                      (if (< i 512)
                        (let [c (long (if (<= 148 i 155) 32 (aget blk i)))]
                          (recur (inc i) (+ u (bit-and c 0xff)) (+ s c)))
                        [u s]))
              _ (when-not (or (= sum u) (= sum s)) (bad-tar))
              magic (String. blk 257 6 StandardCharsets/ISO_8859_1)
              ustar (= magic "ustar\u0000")
              star (and ustar (= "tar\u0000" (String. blk 508 4 StandardCharsets/ISO_8859_1)))
              typeflag (char (bit-and (aget blk 156) 0xff))
              name (field-string blk 0 100)
              prefix (cond star (field-string blk 345 131)
                           ustar (field-string blk 345 155)
                           :else "")
              name (if (seq prefix) (str prefix "/" name) name)
              size (field-number blk 124 12)
              mode (field-number blk 100 8)
              header-only (#{\1 \2 \3 \4 \5 \6} typeflag)
              nb (if header-only 0 size)
              _ (when (neg? nb) (bad-tar))
              data-of (fn [] (let [d (or (read-fully in nb) (if (zero? nb) (byte-array 0) (throw (ex-info "unexpected EOF" {}))))]
                               (skip-fully! in (bit-and (- nb) 511))
                               d))]
          (case typeflag
            (\x \g) (let [recs (pax-records (data-of))]
                      (if (= typeflag \g)
                        {:type \g :name name :mode 0 :size 0}
                        (recur recs long-name)))
            \L (recur pax (field-string (data-of) 0 nb))
            \K (do (data-of) (recur pax long-name))
            (let [name (if-let [p (not-empty (get pax "path"))] p name)
                  name (if (seq long-name) long-name name)
                  size (if-let [v (not-empty (get pax "size"))]
                         (try (Long/parseLong v) (catch NumberFormatException _ (bad-tar)))
                         size)
                  typeflag (if (= typeflag \u0000) (if (.endsWith ^String name "/") \5 \0) typeflag)
                  nb (if (#{\1 \2 \3 \4 \5 \6} typeflag) 0 size)]
              (when (neg? nb) (bad-tar))
              {:type typeflag :name name :mode mode :size nb})))))))

(defn- mkdir-all!
  "Makes directory name and those missing above it (jrt's mkdirAll)."
  [^String name perm]
  (let [^PosixFileAttributes a (try (stat name) (catch IOException _ nil))]
    (cond
      (and a (.isDirectory a)) nil
      a (throw (ex-info (str name ": not a directory") {}))
      :else
      (do (let [parent (dir-of name)]
            (when (and (not= parent name) (not= parent "."))
              (mkdir-all! parent 2r111101101)))
          (try (Files/createDirectory (go-path name) (attrs (bits->perms perm)))
               (catch IOException e (throw (ex-info (reason "mkdir" e) {}))))))))

(defn untar
  "Writes tar's directories and regular files under dir (jrt's RestoreTar: the directories missing
  on the way made, a file there already replaced, other kinds left out; a name that is absolute
  or leaves dir refused): nil, or the reason."
  [^bytes tar ^String dir]
  (try
    (let [in (ByteArrayInputStream. tar)]
      (loop []
        (when-let [{:keys [type ^String name mode size]} (next-entry in)]
          (let [clean-name (clean name)]
            (when (or (.startsWith name "/") (= clean-name "..") (.startsWith clean-name "../"))
              (throw (ex-info (str "tar: " name ": a name outside the directory") {})))
            (let [full (join dir clean-name)
                  perm (bit-and mode 2r111111111)
                  data (when (pos? size)
                         (let [d (or (read-fully in size) (throw (ex-info "unexpected EOF" {})))]
                           (skip-fully! in (bit-and (- size) 511))
                           d))]
              (case type
                \5 (when (not= clean-name ".")
                     (mkdir-all! full perm))
                \0 (do (mkdir-all! (dir-of full) 2r111101101)
                       (try
                         (let [opts (doto (HashSet.)
                                      (.add StandardOpenOption/WRITE) (.add StandardOpenOption/CREATE)
                                      (.add StandardOpenOption/TRUNCATE_EXISTING))]
                           (with-open [ch (Files/newByteChannel (go-path full) ^Set opts
                                                               ^"[Ljava.nio.file.attribute.FileAttribute;" (attrs (bits->perms perm)))]
                             (when data
                               (let [bb (ByteBuffer/wrap data)]
                                 (while (.hasRemaining bb) (.write ch bb))))))
                         (catch IOException e (throw (ex-info (reason "open" e) {})))))
                nil)
              (recur))))))
    nil
    (catch Exception e
      (or (ex-message e) (str e)))))

;; ---------------------------------------------------------------------------------------
;; ARBACE_PATH's store entries, for RT.load on the JVM (the Go build's RT finds them itself)

(defn path-entries
  "The entries of a path such as ARBACE_PATH, in order: directories separated by ':', and the
  store's entries, \"store:PREFIX\", each from \"store:\" to the next ':'; empty entries left out
  (HostStore.pathEntries)."
  [^String path]
  (loop [i 0 out []]
    (if (> i (count path))
      out
      (let [from (if (.startsWith path "store:" i) (+ i 6) i)
            colon (.indexOf path ":" (int from))
            end (if (neg? colon) (count path) colon)]
        (recur (inc end) (if (> end i) (conj out (subs path i end)) out))))))

(defn resource
  "Resource name (\"a/b_c.ae\") as the path entry store:PREFIX finds it: the blob ref PREFIX +
  name, its '/'s made '.'s, points at; nil when there is none, the name is not one the store
  takes, or there is no store (HostStore.resource)."
  [^String prefix ^String name]
  (let [h (byte-array 32)]
    (when (zero? (ref (str prefix (.replace name \/ \.)) h))
      (read h))))

(defn load-from-path
  "RT.load's last resort on the JVM (doc/VENDOR-NOTES.md, hand change 22): namespace scriptbase
  (\"a/b_c\") from the store's entries of ARBACE_PATH, its .ae, else .clj, else .cljc, each looked
  for in the entries in order: true when found and loaded (its source path, as a file's on the
  class path, a/b_c.ae), false when none has it."
  [^String scriptbase]
  (let [path (System/getenv "ARBACE_PATH")
        prefixes (when path
                   (for [^String e (path-entries path) :when (.startsWith e "store:")]
                     (subs e 6)))]
    (boolean
      (some (fn [ext]
              (let [file (str scriptbase ext)]
                (some (fn [prefix]
                        (when-let [b (resource prefix file)]
                          (let [slash (.lastIndexOf file "/")]
                            (arbace.lang.Compiler/load
                              (InputStreamReader. (ByteArrayInputStream. b) StandardCharsets/UTF_8)
                              file (subs file (inc slash))))
                          true))
                      prefixes)))
            [".ae" ".clj" ".cljc"]))))

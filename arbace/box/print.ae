;; The printing for the rebuild in the box (doc/go/BOX-NOTES.md, S8), repr/go's and
;; arbace.build.go's: run in a spawned guest of Arbace's image (arbace.box.rebuild's print
;; actions), their namespaces from ARBACE_PATH (the sources at /s). Apart from the driver, so that
;; an action needs nothing of it.
(ns arbace.box.print
  "The printing steps of arbace.box.rebuild, each in its own guest:

    arbace -m arbace.box.print print-goroot    tamago/ and overlay/go printed
    arbace -m arbace.box.print print-program   a2g's program printed"
  (:import (java.io File)))


(defn- tool [sym]
  (or (requiring-resolve sym) (throw (ex-info (str "arbace.box.print: no " sym) {}))))

(defn print-goroot
  "In a guest (cwd /s, the sources): tamago/'s forms (/f the standard library's, /g the goos
  module's: each its go/ with arch/amd64/go laid over it) printed as bin/tamago-vendor print
  prints them into /o/std (GOROOT/src's layout) and /o/goos; overlay/go's runtime and syscall
  printed as bin/jrt overlay and bin/lib/box-overlay.bash print them into /o/runtime and
  /o/syscall."
  []
  (let [program (tool 'arbace.build.go/program)
        print-module (tool 'arbace.build.go/print-module)
        print-package (tool 'arbace.repr.go.print/print-package)
        goroot "/nonexistent"]
    (let [p (program (File. "/f") goroot {:library? true :module "std"})]
      (print-module p (File. "/f") (File. "/o/std") {:layout :lines}))
    (let [p (program (File. "/g") goroot {:library? true :module "github.com/usbarmory/tamago" :go "1.27"})]
      (print-module p (File. "/g") (File. "/o/goos") {:layout :lines}))
    (print-package "overlay/go/runtime.ae" "/o/runtime" {:layout :gofmt})
    (print-package "overlay/go/syscall.ae" "/o/syscall" {:layout :gofmt})))

(defn print-program
  "In a guest (cwd /s, the sources): a2g's program (/p) printed as bin/arbace-go --build --box
  prints it (bin/build-go --goos tamago --line-file, the roots box/ and x509roots/), into
  /o/mod, the goos module's directory named /goos; the main package's configuration
  (:tags, :goexperiment) into /o/config.edn."
  []
  (let [program (tool 'arbace.build.go/program)
        print-module (tool 'arbace.build.go/print-module)
        opts {:goos "tamago" :line-file true :goos-dir "/goos" :roots ["/s/box" "/s/x509roots"]}
        p (program (File. "/p") "/nonexistent" opts)]
    (print-module p (File. "/p") (File. "/o/mod") opts)
    (spit "/o/config.edn" (pr-str (or (:config (:package (:main p))) {})))))

(defn -main [& [cmd]]
  (case cmd
    "print-goroot" (print-goroot)
    "print-program" (print-program)
    (do (binding [*out* *err*] (println "usage: arbace -m arbace.box.print print-goroot|print-program"))
        (System/exit 2)))
  (shutdown-agents)
  (System/exit 0))


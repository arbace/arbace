(ns arbace.c.cinterp
  "ci's in-process back end (doc/C23-SURVEY.md, CS103 (c), \"As built: C9 (preparation)\"): the node program's text run by
  arbace.lang.CInterp, whose Go side is go/arbace/cinterp over ci and crt, in the executable's own process. The namespace needs
  the class, which only an executable built with ci has: on stage 0 (and on any executable of the runtime before C9) loading
  it fails, and arbace.c.repl keeps the light path's back end, tools/cirun as a process. arbace.c.repl requires it at load, in a try."
  (:import [arbace.lang CInterp]))

(set! *warn-on-reflection* true)

(defn run-nodes
  "The node program `text` run with `argv` (argv[0] the program's name) on the process's standard streams: its status
  (128 + a signal's number); a fault is reported on the standard error as \"cirun: fault: ...\", as tools/cirun reports it."
  [^String text argv]
  (CInterp/runNodes text (into-array String (map str argv))))

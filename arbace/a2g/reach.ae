(ns arbace.a2g.reach
  "Reachability (JRT-SOURCES.md, the user's decision of 2026-10-08: translate the reached
  methods, stub the rest): rapid type analysis over the analyzed class forms from root methods.
  It decides the translated classes T (classes reached code uses: a class jrt provides stays
  jrt's, except stand-ins, which translated classes replace), the reached methods (translated;
  every other method of T is a stub throwing UnsupportedOperationException), and the methods
  whose code needs something the closed world lacks (stubbed too, and reported)."
  (:require [arbace.string :as str]
            [arbace.classes.types :as t]
            [arbace.classes.env :as env]
            [arbace.classes.analyze :as a]
            [arbace.a2g.model :as m]
            [arbace.a2g.names :as nm]
            [arbace.a2g.access :as acc]
            [arbace.a2g.jrt :as jrt]
            [arbace.classes.opcodes :as Opcodes]))

;; ---------------------------------------------------------------------------------------
;; walking analyzed code

(defn node? [x] (and (map? x) (contains? x :op)))

(defn walk-nodes
  "Calls (f node) on node and every node in it (operands, branches, bindings, cases, catches,
  lambda bodies, patterns), each once, parents first."
  [f node]
  (letfn [(walk [n]
            (f n)
            (doseq [[k v] n :when (not (#{:b :field :method :ctor :boundary :sam :hidden :temp
                                          :sel-binding :restart :var :frame :scope} k))]
              (walk-val v)))
          (walk-val [v]
            (cond (node? v) (walk v)
                  (sequential? v) (doseq [x v]
                                    (cond (node? x) (walk x)
                                          (map? x) (walk-plain x)
                                          (sequential? x) (walk-val x)))
                  :else nil))
          (walk-plain [mp]
            (doseq [[k v] mp :when (not (#{:b :frame :scope :accessor :ctor} k))]
              (cond (node? v) (walk v)
                    (sequential? v) (walk-val v)
                    (and (map? v) (#{:pattern} k)) (walk-plain v))))]
    (when (node? node) (walk node))))

;; ---------------------------------------------------------------------------------------
;; Java's method resolution, independent of the world

(def ^:dynamic *cx*
  "The run's caches of answers that depend only on the class environment and the world, which
  do not change once the world is loaded (the supertypes, the superclass bodies of a method, the
  classes a descriptor names, ...): {name java.util.HashMap}, kept with the state (run), or nil."
  nil)

(def ^:private none
  "A cached nil."
  (Object.))

(defmacro ^:private cached
  "The value of expr for key k in the run's cache named c (*cx*), computed once; expr itself
  without the caches."
  [c k expr]
  `(if-let [^java.util.Map h# (get *cx* ~c)]
     (let [k# ~k
           v# (.get h# k#)]
       (cond (identical? v# none) nil
             (some? v#) v#
             :else (let [v# ~expr] (.put h# k# (if (nil? v#) none v#)) v#)))
     ~expr))

(defn- new-caches []
  (into {} (for [c [:supers :supers-of :interface? :subclass? :super-impl :ext-keys :desc-classes :hw-yes]]
             [c (java.util.HashMap.)])))

(defn- all-supers
  "env/all-supertypes, cached."
  [n]
  (cached :supers n (env/all-supertypes n)))

(defn- interface? [n] (cached :interface? n (env/interface? n)))

(defn- subclass?
  "env/subclass?, cached."
  [a b]
  (if-let [^java.util.HashMap h (get *cx* :subclass?)]
    (let [^java.util.HashMap ha (or (.get h a) (let [x (java.util.HashMap.)] (.put h a x) x))
          v (.get ha b)]
      (if (nil? v)
        (let [v (boolean (env/subclass? a b))] (.put ha b v) v)
        v))
    (env/subclass? a b)))

(def ^:dynamic ^java.util.HashMap *methods-by-key*
  "Class -> {[name desc] method} of its methods in env/info's order (the first of a key), for
  java-impl-of's lookups in a run (instead of a scan of the class's methods each; the class
  environment does not change once the world is loaded), or nil."
  nil)

(defn- find-method-of
  "The first method [name desc] of class c (k, when given, is [name desc])."
  ([c name desc] (find-method-of c name desc nil))
  ([c name desc k]
   (if-let [^java.util.HashMap cache *methods-by-key*]
     (let [^java.util.HashMap ix (or (.get cache c)
                                     (let [ix (java.util.HashMap.)]
                                       (doseq [mm (:methods (env/info c))]
                                         (let [k [(:name mm) (:desc mm)]]
                                           (when-not (.containsKey ix k) (.put ix k mm))))
                                       (.put cache c ix)
                                       ix))]
       (.get ix (or k [name desc])))
     (some #(when (and (= name (:name %)) (= desc (:desc %))) %) (:methods (env/info c))))))

(defn- body? [mm] (and mm (not (m/static? mm)) (not (m/abstract-m? mm))))

(defn- super-impl
  "The first class of the superclass chain from c with a body of method k ([name desc]) that is
  not private (cached per class and key: the chains of many classes share their superclasses)."
  [c k]
  (when c
    (let [f (fn [] (let [mm (find-method-of c (nth k 0) (nth k 1) k)]
                     (if (and (body? mm) (not (m/private? mm)))
                       c
                       (super-impl (:super (env/info c)) k))))]
      (if-let [^java.util.HashMap h (get *cx* :super-impl)]
        (let [^java.util.HashMap hc (or (.get h c) (let [x (java.util.HashMap.)] (.put h c x) x))
              v (.get hc k)]
          (cond (identical? v none) nil
                (some? v) v
                :else (let [v (f)] (.put hc k (if (nil? v) none v)) v)))
        (f)))))

(defn java-impl-of
  "The [class name desc] implementing virtual method [name desc] for class n (a body in n or a
  superclass, else an interface's default), by Java's rules on the class environment: the first
  class of n's superclass chain with a body of it (private only in n itself), else the first,
  in env/all-supertypes' order, of the most specific interfaces of n with a default."
  [n [name desc :as k]]
  (or (when (body? (find-method-of n name desc k)) [n name desc])
      (when-let [c (super-impl (:super (env/info n)) k)] [c name desc])
      (let [cands (into [] (filter (fn [c]
                                     (and (not= c n) (interface? c)
                                          (let [mm (find-method-of c name desc k)]
                                            (and (body? mm) (not (m/private? mm)))))))
                        (all-supers n))]
        (when-let [c (some (fn [x] (when-not (some #(and (not= % x) (subclass? % x)) cands) x)) cands)]
          [c name desc]))))

;; ---------------------------------------------------------------------------------------
;; the analysis

(def ^:dynamic *st* nil)
(def ^:dynamic *slice?*
  "Whether a class's code may be translated in this run (classes outside the slice exist as
  declarations with stub bodies)."
  (constantly true))
(def ^:dynamic *current* nil)

(defn- note-unavailable! [why]
  (when *current*
    (swap! (:unavailable *st*) update *current* (fnil conj #{}) why)))

(declare use! init! reach! vcall! instantiate!)

(defn- hw-has-static? [cls name desc]
  (let [g (m/go-name cls)
        base (nm/method-base name desc)
        scan (:jrt m/*w*)]
    (or (contains? (:funcs scan) (str g "_" base))
        (m/a2g-static? cls base))))

(defn- hw-has-field? [cls fname static?]
  (let [g (m/go-name cls)
        scan (:jrt m/*w*)]
    (if static?
      (or (contains? (:vars scan) (nm/static-field-name g fname))
          (contains? (:consts scan) (nm/static-field-name g fname)))
      true)))

(defn use!
  "Makes class n exist in Go (translating it when it can and jrt does not provide it, or jrt
  provides only a stand-in). Returns false, noting why, when it cannot."
  [n]
  (cond
    (nil? n) true
    (= n "java/lang/Object") true
    (contains? @(:T *st*) n) true
    (contains? @(:failed-classes *st*) n) (do (note-unavailable! (str "class " n ": " (get @(:failed-classes *st*) n))) false)
    (and (m/jrt-class n) (not (:standin (m/jrt-class n)))) true
    ;; a stand-in is replaced only by a translation of the slice (jrt's code needs its members)
    (and (m/jrt-class n) (not (*slice?* n))) true
    (m/translatable? n)
    (let [d (a/decl n)]
      (if-let [why (:analysis-failed @(:state d))]
        (do (swap! (:failed-classes *st*) assoc n (str "analysis failed: " why))
            (note-unavailable! (str "class " n " failed analysis"))
            false)
        (do
          (swap! (:T *st*) conj n)
          (let [sup (:super d)
                ok (binding [*current* [n "<class>" ""]] (use! sup))]
            (if-not ok
              (do (swap! (:T *st*) disj n)
                  (swap! (:failed-classes *st*) assoc n (str "superclass " sup " unavailable"))
                  (note-unavailable! (str "class " n ": superclass " sup " unavailable"))
                  false)
              (do
                (doseq [i (:interfaces d)] (binding [*current* [n "<class>" ""]] (use! i)))
                ;; nested classes need their outer class (outer instance fields, statics)
                (when-let [o (:outer d)] (binding [*current* [n "<class>" ""]] (use! o)))
                ;; virtual calls already seen reach into the new class's subtypes when instantiated
                true))))))
    (m/jrt-class n) true
    ;; a JDK interface known only by reflection: declared, without code
    (m/reflectable-interface? n)
    (do (swap! (:T *st*) conj n)
        (doseq [i (:interfaces (env/info n))] (binding [*current* [n "<class>" ""]] (use! i)))
        true)
    :else (do (swap! (:missing *st*) update n (fnil conj #{}) *current*)
              (note-unavailable! (str "class " (str/replace n "/" ".") " is not in the closed world"))
              false)))

(defn- use*
  "use! in the run whose state is st: at once for a class already translated or jrt's own (not a
  stand-in) that has not failed, else use!."
  [st n]
  (cond
    (nil? n) true
    (= n "java/lang/Object") true
    (contains? @(:T st) n) true
    :else (let [j (get (:jc st) n)]
            (if (and j (not (:standin j)) (not (contains? @(:failed-classes st) n)))
              true
              (use! n)))))

(defn- uses!
  "use* of each class of cs, in order."
  [st cs]
  (reduce (fn [_ c] (use* st c) nil) nil cs))

(defn- desc-classes
  "m/desc-classes, cached for a string."
  [d]
  (if (string? d) (cached :desc-classes d (m/desc-classes d)) (m/desc-classes d)))

(defn- use-desc! [d]
  (doseq [c (desc-classes d)] (use! c)))

(defn- reach*
  "reach! in the run whose state is st."
  [st k]
  (let [c (nth k 0)]
    (when (and c (not (contains? @(:reached st) k)) (contains? @(:T st) c) (a/decl c) (*slice?* c))
      (swap! (:reached st) conj k)
      (swap! (:queue st) conj k))))

(defn reach!
  "Marks method [c name desc] reached (its body will be translated)."
  [k]
  (reach* *st* k))

(defn- init*
  "init! in the run whose state is st."
  [st c]
  (when (and c (not (contains? @(:inited st) c)) (contains? @(:T st) c) (a/decl c))
    (swap! (:inited st) conj c)
    (when-let [s (:super (a/decl c))] (init* st s))
    (reach* st [c "<clinit>" "()V"])))

(defn init!
  "Class c is initialized: its static initializer is reached (and its superclass's)."
  [c]
  (init* *st* c))

(defn- own-external-keys
  "The virtual methods of type s that jrt's own code may call when s is Object, a hand-written
  class or interface of jrt or a class jrt has a stand-in for, else none (cached)."
  [s]
  (cached :ext-keys s
          (if (or (= s "java/lang/Object") (m/jrt-class s))
            (vec (for [mm (:methods (env/info s))
                       :when (and (not (m/static? mm)) (not (m/private? mm)) (not= "<init>" (:name mm)))]
                   [(:name mm) (:desc mm)]))
            [])))

(defn- external-keys
  "The virtual methods of class d's supertypes that jrt's own code may call: those of Object,
  of jrt's hand-written classes and interfaces and of the classes jrt has stand-ins for; each
  once, in the order of its first occurrence."
  [d]
  (let [seen (java.util.HashSet.)
        out (java.util.ArrayList.)]
    (doseq [s (all-supers d) k (own-external-keys s)]
      (when (.add seen k) (.add out k)))
    out))

(defn- supertypes-of
  "The types class d is a subtype of (env/subclass?): d, its supertypes and Object (cached)."
  [d]
  (cached :supers-of d
          (let [s (all-supers d)]
            (if (some #(= "java/lang/Object" %) s) s (conj (vec s) "java/lang/Object")))))

(defn- reach-impls!
  "Reaches the implementations for class d of the virtual calls whose receiver's static type is
  a supertype of d (indexed by receiver type: the roots of --program are each a virtual call,
  about 20,000), then of the methods jrt's own code may call (external-keys)."
  [st d]
  (let [by @(:vcalls-by st)]
    (doseq [s (supertypes-of d) nd (get by s)]
      (when-let [k (java-impl-of d nd)] (reach* st k))))
  (doseq [k (external-keys d)]
    (when-let [impl (java-impl-of d k)] (reach* st impl))))

(defn- instantiate*
  "instantiate! in the run whose state is st."
  [st d]
  (when (and (not (contains? @(:inst st) d)) (contains? @(:T st) d))
    (swap! (:inst st) conj d)
    (doseq [s (supertypes-of d)]
      (swap! (:inst-by st) update s (fnil conj []) d))
    (reach-impls! st d)))

(defn instantiate!
  [d]
  (instantiate* *st* d))

(defn- vcall*
  "vcall! in the run whose state is st, of k [o name desc], nd [name desc]."
  [st k nd]
  (when-not (contains? @(:vcalls st) k)
    (swap! (:vcalls st) conj k)
    (let [o (nth k 0)
          fis @(:lambda-fis st)]
      (swap! (:vcalls-by st) update o (fnil conj []) nd)
      (doseq [d (get @(:inst-by st) o)]
        (when-let [impl (java-impl-of d nd)] (reach* st impl)))
      (doseq [d fis :when (subclass? d o)]
        (when-let [impl (java-impl-of d nd)] (reach* st impl))))))

(defn vcall!
  "A virtual call of [name desc] on a receiver of static type o."
  [o name desc]
  (vcall* *st* [o name desc] [name desc]))

(defn lambda!
  "A lambda or method reference of functional interface fi: its adapter is an instance of fi,
  whose default methods virtual calls reach."
  [fi]
  (let [st *st*]
    (when-not (contains? @(:lambda-fis st) fi)
      (swap! (:lambda-fis st) conj fi)
      (reach-impls! st fi))))

(defn- hw-method-exists?
  "m/hw-method-exists? of class n and method mm; its yes for a class not translated kept (jrt's
  Go name of the class and its scan do not change, and what a2g adds only grows with T)."
  [n mm]
  (let [^java.util.HashMap h (get *cx* :hw-yes)]
    (if (or (nil? h) (contains? @(:T *st*) n))
      (m/hw-method-exists? n mm)
      (let [k [n (:name mm) (:desc mm)]]
        (or (.containsKey h k)
            (let [yes (m/hw-method-exists? n mm)]
              (when yes (.put h k true))
              yes))))))

(defn- check-hw-call!
  "A call of a method of jrt's hand-written class: jrt must have it."
  [owner name desc kind]
  (when (and (m/hand-written? owner) (not= owner "java/lang/Object"))
    (let [mm {:name name :desc desc}]
      (when-not (if (= kind :static)
                  (hw-has-static? owner name desc)
                  (or (hw-method-exists? owner mm)
                      ;; inherited from a superclass jrt has
                      (some #(and (m/in-world? %) (or (= % "java/lang/Object") (hw-method-exists? % mm)))
                            (rest (all-supers owner)))))
        (note-unavailable! (str "jrt lacks " (str/replace owner "/" ".") "." name desc))))))


(defn- vh-const?
  "Is field f a constant VarHandle of the world (A2G-SPEC §8.5)?"
  [f]
  (contains? (:handles (:vh m/*w*)) [(or (:declarer f) (:owner f)) (:name f)]))

(defn- vh-call?
  "A VarHandle call a2g compiles statically (A2G-SPEC §8.5): a fence, MethodHandles.lookup(),
  or an access mode on a constant handle; it names no class of java.lang.invoke in Go."
  [node]
  (let [{:keys [owner kind name]} node]
    (or (and (= :static kind) (= "java/lang/invoke/VarHandle" owner)
             (#{"fullFence" "acquireFence" "releaseFence" "loadLoadFence" "storeStoreFence"} name))
        (and (= :static kind) (= "java/lang/invoke/MethodHandles" owner) (= "lookup" name))
        (and (not= :static kind) (= "java/lang/invoke/VarHandle" owner)
             (let [tg (acc/unaccess (:target node))]
               (and (= :get-static (:op tg)) (vh-const? (:field tg))))))))

(defn- scan-node! [node]
  (let [node (acc/unaccess node)]
    (case (:op node)
      :invoke
      (let [mm (:method node)
            mowner (or (:owner mm) (:owner node))
            {:keys [name desc]} node]
        (cond
          (:array-clone node) (use-desc! (:owner node))
          (vh-call? node) (doseq [c (m/method-desc-classes desc)] (use! c))
          :else
          (do
            (use! (:owner node))
            (use! mowner)
            (use-desc! (str "L" (:owner node) ";"))
            (doseq [c (m/method-desc-classes desc)] (use! c))
            (case (:kind node)
              :static (do (init! mowner) (reach! [mowner name desc])
                          (check-hw-call! mowner name desc :static))
              :special (do (reach! [mowner name desc]) (check-hw-call! mowner name desc :special))
              (:virtual :interface)
              (if (and mm (m/private? mm))
                (reach! [mowner name desc])
                (do (vcall! (:owner node) name desc)
                    (check-hw-call! (:owner node) name desc :virtual)))))))
      :new (let [c (:class node)
                 ok (use! c)]
             (when ok
               (init! c)
               (reach! [c "<init>" (:desc (:ctor node))])
               (instantiate! c)
               (when (m/hand-written? c)
                 (let [g (m/go-name c)]
                   (when-not (contains? (:funcs (:jrt m/*w*)) (nm/new-name g (:desc (:ctor node))))
                     (note-unavailable! (str "jrt lacks constructor " c (:desc (:ctor node)))))))))
      :ctor-call (do (use! (:class node))
                     (reach! [(:class node) "<init>" (:desc (:ctor node))]))
      (:get-static :set-static)
      (let [f (:field node)
            o (or (:declarer f) (:owner f))]
        (when (and (not (vh-const? f)) (use! o))
          (init! o)
          (use-desc! (:desc f))
          (when (and (m/hand-written? o) (not (hw-has-field? o (:name f) true)))
            (note-unavailable! (str "jrt lacks static field " o "." (:name f))))))
      (:get-field :set-field)
      (let [f (:field node)] (use! (or (:declarer f) (:owner f))) (use-desc! (:desc f)))
      (:cast :instance?) (use-desc! (:class node))
      :class-lit (use-desc! (:class node))
      (:new-array :array-init) (use-desc! (:type node))
      :try (doseq [c (:catches node) cls (:classes c)] (use! cls))
      :lambda (do (when (use! (:fi node)) (lambda! (:fi node))) (doseq [mk (:markers node)] (use! mk)))
      :method-ref
      (do (when (use! (:fi node)) (lambda! (:fi node))) (use! (:owner node))
          (case (:kind node)
            :static (do (init! (:owner node)) (reach! [(:owner node) (:name node) (:desc node)]))
            :new (do (init! (:owner node)) (reach! [(:owner node) "<init>" (:desc node)])
                     (instantiate! (:owner node)))
            (:bound :unbound) (vcall! (:owner node) (:name node) (:desc node))))
      :java-str (doseq [p (:parts node) :when (:node p)
                        :let [ty (a/value-type (:type (:node p)))]
                        :when (and (t/ref? ty) (not= ty :null) (not= ty "Ljava/lang/String;"))]
                  (vcall! (if (t/array? ty) "java/lang/Object" (t/desc->internal ty))
                          "toString" "()Ljava/lang/String;"))
      :for-each (when-not (:array node)
                  (use! "java/util/Iterator")
                  (vcall! "java/util/Iterator" "hasNext" "()Z")
                  (vcall! "java/util/Iterator" "next" "()Ljava/lang/Object;"))
      :assert (do (use! "java/lang/AssertionError")
                  (let [d (str "(" (or (:msg-desc node) "") ")V")]
                    (reach! ["java/lang/AssertionError" "<init>" d])
                    (instantiate! "java/lang/AssertionError")))
      :if-instance (walk-nodes (fn [_]) nil)
      (:var-deref :var-invoke)
      (do (use! (t/lang-class "Var"))
          (vcall! (t/lang-class "Var") (if (= :var-deref (:op node)) "deref" "getRawRoot")
                  (if (= :var-deref (:op node)) "()Ljava/lang/Object;" "()Ljava/lang/Object;"))
          (when (= :var-invoke (:op node))
            (use! (t/lang-class "IFn"))
            (vcall! (t/lang-class "IFn") "invoke"
                    (t/method-desc (repeat (count (:args node)) "Ljava/lang/Object;") "Ljava/lang/Object;"))))
      ;; Clojure's adapter of an IFn to a functional interface (Compiler's FISupport): the
      ;; interface's adapter (as for a lambda) calling FnInvokers' invoker
      :fi-adapter
      (let [fi (t/desc->internal (:type node))
            fni (t/lang-class "FnInvokers")]
        (use! (t/lang-class "IFn"))
        (when (use! fi) (lambda! fi))
        (when (use! fni)
          (init! fni)
          (reach! [fni (:invoker node) (:invoker-desc node)])))
      nil)
    ;; patterns name classes too
    (when (= :if-instance (:op node))
      (letfn [(pat [p] (use-desc! (:class p))
                (doseq [c (:comps p)]
                  (vcall! (:owner (:accessor c)) (:name (:accessor c)) (:desc (:accessor c)))
                  (pat (:pattern c))))]
        (pat (:pattern node))))
    (when (= :switch (:op node))
      (doseq [c (:cases node) l (:labels c) :when (:pattern l)]
        (letfn [(pat [p] (use-desc! (:class p))
                  (doseq [cc (:comps p)]
                    (vcall! (:owner (:accessor cc)) (:name (:accessor cc)) (:desc (:accessor cc)))
                    (pat (:pattern cc))))]
          (pat (:pattern l)))))))

(def ^:dynamic ^java.util.IdentityHashMap *flat*
  "Node -> the plans of the nodes in it scan-node! acts on, in walk-nodes' order (plan-code: the
  run's batches of methods planned in parallel ahead of their sequential scan), or nil."
  nil)

(def ^:private scanned-ops
  "The ops scan-node! acts on (an accessor's call, an :invoke, may stand for a field access)."
  #{:invoke :new :ctor-call :get-static :set-static :get-field :set-field :cast :instance? :class-lit
    :new-array :array-init :try :lambda :method-ref :java-str :for-each :assert :if-instance
    :var-deref :var-invoke :fi-adapter :switch})

(defn- hw-owner?
  "Can a call of a method of class c need check-hw-call! (does jrt define c)?"
  [c]
  (and (m/jrt-class c) (not= c "java/lang/Object")))

(defn- plan-node
  "scan-node! of node as a function of the run's state st, its answers that depend only on the
  class environment and the world (which do not change during the run) computed ahead: the
  descriptors' classes, the keys, the accessor's node, whether jrt defines a member. Pure: the
  plans of a batch are made in parallel (no cache of the run: *cx* is one thread's), then run
  one after another, each doing what scan-node! does, in the same order. The common ops; the
  others run scan-node! itself."
  [node]
  (let [n (acc/unaccess node)]
    (case (:op n)
      :invoke
      (let [mm (:method n)
            owner (:owner n)
            mowner (or (:owner mm) owner)
            name (:name n)
            desc (:desc n)]
        (cond
          (:array-clone n) (let [cs (m/desc-classes owner)] (fn [st] (uses! st cs)))
          (vh-call? n) (let [cs (m/method-desc-classes desc)] (fn [st] (uses! st cs)))
          :else
          (let [ocs (m/desc-classes (str "L" owner ";"))
                mdc (m/method-desc-classes desc)
                pre (fn [st] (use* st owner) (use* st mowner) (uses! st ocs) (uses! st mdc))]
            (case (:kind n)
              :static (let [k [mowner name desc]
                            hw (hw-owner? mowner)]
                        (fn [st]
                          (pre st) (init* st mowner) (reach* st k)
                          (when hw (check-hw-call! mowner name desc :static))))
              :special (let [k [mowner name desc]
                             hw (hw-owner? mowner)]
                         (fn [st]
                           (pre st) (reach* st k)
                           (when hw (check-hw-call! mowner name desc :special))))
              (:virtual :interface)
              (if (and mm (m/private? mm))
                (let [k [mowner name desc]] (fn [st] (pre st) (reach* st k)))
                (let [k [owner name desc]
                      nd [name desc]
                      hw (hw-owner? owner)]
                  (fn [st]
                    (pre st) (vcall* st k nd)
                    (when hw (check-hw-call! owner name desc :virtual)))))))))
      :new
      (let [c (:class n)
            d (:desc (:ctor n))
            k [c "<init>" d]
            jc (m/jrt-class c)
            ;; as hand-written: jrt's Go name (m/go-name of a class not translated)
            lacks? (and jc (not (contains? (:funcs (:jrt m/*w*)) (nm/new-name (or (:go jc) (nm/go-class-name c)) d))))]
        (fn [st]
          (when (use* st c)
            (init* st c)
            (reach* st k)
            (instantiate* st c)
            (when (and lacks? (not (contains? @(:T st) c)))
              (note-unavailable! (str "jrt lacks constructor " c d))))))
      :ctor-call
      (let [c (:class n)
            k [c "<init>" (:desc (:ctor n))]]
        (fn [st] (use* st c) (reach* st k)))
      (:get-static :set-static)
      (let [f (:field n)
            o (or (:declarer f) (:owner f))]
        (if (vh-const? f)
          (fn [st] nil)
          (let [cs (m/desc-classes (:desc f))
                jc (m/jrt-class o)
                lacks? (and jc (let [g (or (:go jc) (nm/go-class-name o))
                                     scan (:jrt m/*w*)]
                                 (not (or (contains? (:vars scan) (nm/static-field-name g (:name f)))
                                          (contains? (:consts scan) (nm/static-field-name g (:name f)))))))]
            (fn [st]
              (when (use* st o)
                (init* st o)
                (uses! st cs)
                (when (and lacks? (not (contains? @(:T st) o)))
                  (note-unavailable! (str "jrt lacks static field " o "." (:name f)))))))))
      (:get-field :set-field)
      (let [f (:field n)
            o (or (:declarer f) (:owner f))
            cs (m/desc-classes (:desc f))]
        (fn [st] (use* st o) (uses! st cs)))
      (:cast :instance? :class-lit)
      (let [cs (m/desc-classes (:class n))] (fn [st] (uses! st cs)))
      (:new-array :array-init)
      (let [cs (m/desc-classes (:type n))] (fn [st] (uses! st cs)))
      (fn [st] (scan-node! node)))))

(def ^:private skipped-keys
  "The keys of a node walk-nodes does not walk into."
  #{:b :field :method :ctor :boundary :sam :hidden :temp :sel-binding :restart :var :frame :scope})

(def ^:private skipped-plain-keys
  "The keys of a plain map in a node (a catch, a case, a pattern) walk-nodes does not walk into."
  #{:b :frame :scope :accessor :ctor})

(defn- scanned-nodes
  "The nodes of node scan-node! acts on, in walk-nodes' order (its walk, with reduce-kv and
  reduce rather than seqs of the maps' entries: a map's kv-reduce visits its entries in the
  order of its seq)."
  [node]
  (let [acc (java.util.ArrayList.)]
    (letfn [(walk [n]
              (when (contains? scanned-ops (:op n)) (.add acc n))
              (reduce-kv walk-entry nil n))
            (walk-entry [_ k v]
              (when-not (contains? skipped-keys k) (walk-val v))
              nil)
            (walk-val [v]
              (cond (node? v) (walk v)
                    (sequential? v) (reduce walk-elem nil v)
                    :else nil))
            (walk-elem [_ x]
              (cond (node? x) (walk x)
                    (map? x) (walk-plain x)
                    (sequential? x) (walk-val x))
              nil)
            (walk-plain [mp] (reduce-kv walk-plain-entry nil mp))
            (walk-plain-entry [_ k v]
              (when-not (contains? skipped-plain-keys k)
                (cond (node? v) (walk v)
                      (sequential? v) (walk-val v)
                      (and (map? v) (= :pattern k)) (walk-plain v)))
              nil)]
      (when (node? node) (walk node)))
    acc))

(defn- plan-code
  "The plans of the nodes of node scan-node! acts on, in walk-nodes' order."
  [node]
  (mapv plan-node (scanned-nodes node)))

(defn scan-code! [node]
  (let [^java.util.IdentityHashMap flat *flat*]
    (if-let [ps (and flat (.get flat node))]
      (let [st *st*] (run! (fn [p] (p st)) ps))
      (walk-nodes scan-node! node))))

(defn method-code
  "The analyzed code of method [c name desc] of a translated class: a vector of nodes."
  [[c name desc]]
  (let [d (a/decl c)
        st @(:state d)]
    (if (= name "<clinit>")
      (vec (:clinit st))
      (let [ab (get (:bodies st) [name desc])]
        (if (= name "<init>")
          (vec (concat (:prologue ab) [(:call ab)] (when (:calls-super ab) (:init st)) [(:body ab)]))
          (if ab [(:body ab)] []))))))

(defn- scan-method! [[c name desc :as k]]
  (binding [*current* k]
    (let [d (a/decl c)
          st @(:state d)
          mm (when-not (= name "<clinit>") (find-method-of c name desc))]
      (when-let [why (:analysis-failed st)] (note-unavailable! (str "analysis failed: " why)))
      (when mm
        (doseq [cl (m/method-desc-classes desc)] (use! cl)))
      (case name
        "<clinit>"
        (do (doseq [nd (:clinit st)] (scan-code! nd))
            (when (seq (:clj-consts st))
              (use! (t/lang-class "RT"))
              (doseq [[_ {:keys [init]}] (:clj-consts st)]
                (case (:kind init)
                  :var (do (init! (t/lang-class "RT"))
                           (reach! [(t/lang-class "RT") "var" (str "(Ljava/lang/String;Ljava/lang/String;)" (t/lang-desc "Var"))]))
                  :read (do (init! (t/lang-class "RT"))
                            (reach! [(t/lang-class "RT") "readString" "(Ljava/lang/String;)Ljava/lang/Object;"])))))
            (when (or (:uses-assert st) (:interface-assert st)) nil))
        (cond
          (:derived mm)
          (case (:derived mm)
            :bridge (let [tg (:bridge-of mm)]
                      (if (:special mm)
                        (reach! [(:owner tg) (:name tg) (:desc tg)])
                        (vcall! c (:name tg) (:desc tg))))
            :record-object-method (doseq [cm (:components d)]
                                    (when (t/ref? (:desc cm))
                                      (vcall! "java/lang/Object" "hashCode" "()I")
                                      (vcall! "java/lang/Object" "equals" "(Ljava/lang/Object;)Z")
                                      (vcall! "java/lang/Object" "toString" "()Ljava/lang/String;")))
            (:default-ctor :anon-ctor :record-canonical)
            (let [ab (get (:bodies st) ["<init>" desc])]
              (when-let [call (:call ab)] (scan-code! call))
              (doseq [i (:init st)] (scan-code! i)))
            nil)
          :else (doseq [nd (method-code k)] (scan-code! nd)))))))

(defn run
  "Reachability from roots (method keys [class name desc]; classes to instantiate
  :instantiate; functional interfaces with adapters :fis). Returns {:T #{} :reached #{} :inst #{} :unavailable {k #{why}} :missing {}
  :state st}. With :state, a previous run's st, the run goes on from where that one ended:
  reachability is monotone, so a run from more roots is the previous one continued from the
  new ones (standalone S6: main's stand-in loop runs the closure once, not twice)."
  [{:keys [roots instantiate classes slice? fis state]}]
  (let [st0 (or state
               {:T (atom #{}) :reached (atom #{}) :queue (atom []) :inst (atom #{}) :vcalls (atom #{})
                :vcalls-by (atom {}) :inst-by (atom {})
                :inited (atom #{}) :unavailable (atom {}) :missing (atom {}) :failed-classes (atom {})
                :lambda-fis (atom #{})})
        ;; the caches, kept with the state; jrt's classes (use*)
        st (assoc st0 :cx (or (:cx st0) (new-caches)) :jc (:jrt-classes m/*w*))]
    (binding [*st* st
              *slice?* (or slice? (constantly true))
              m/*w* (assoc m/*w* :T (:T st))
              *flat* (java.util.IdentityHashMap.)
              *cx* (:cx st)
              *methods-by-key* (java.util.HashMap.)]
      (doseq [c classes] (use! c))
      (doseq [[c name desc :as k] roots]
        (when (use! c)
          (reach! k)
          ;; a root constructor: its class is instantiated (by the caller of the roots)
          (when (and (= "<init>" name) (*slice?* c)) (instantiate! c))
          ;; a root instance method is a virtual call too: its callers (the REPL's reflection,
          ;; the evaluator) call it on instances of any subclass, whose overrides must be
          ;; translated, those of classes that are not roots themselves included (JRT-NOTES.md,
          ;; "Time": ZoneInfo's, in a package java.base does not export)
          (when-not (#{"<init>" "<clinit>"} name)
            (when-let [mm (m/find-method c name desc)]
              (when-not (or (m/static? mm) (m/private? mm))
                (vcall! c name desc))))))
      (doseq [c instantiate] (when (use! c) (instantiate! c)))
      ;; functional interfaces whose adapters exist without a lambda (FromFn, A2G-SPEC §7.11)
      (doseq [fi fis] (when (use! fi) (lambda! fi)))
      ;; the queue in batches: the methods queued so far, their code planned in parallel
      ;; (plan-code: pure), then scanned one after another in the queue's order, the methods
      ;; they reach queued for the next batch (the order of a scan one method at a time)
      (loop []
        (let [batch @(:queue st)]
          (when (seq batch)
            (reset! (:queue st) [])
            (let [seen (java.util.IdentityHashMap.)
                  roots (vec (for [k batch
                                   nd (if (= "<clinit>" (second k))
                                        (:clinit @(:state (a/decl (first k))))
                                        (method-code k))
                                   :when (not (or (.containsKey *flat* nd) (.containsKey seen nd)))]
                               (do (.put seen nd true) nd)))
                  flats (m/par-mapv (m/jobs) plan-code roots)]
              (dotimes [i (count roots)]
                (.put *flat* (nth roots i) (nth flats i))))
            (run! scan-method! batch)
            (recur)))))
    {:T @(:T st) :reached @(:reached st) :inst @(:inst st) :unavailable @(:unavailable st)
     :missing @(:missing st) :failed-classes @(:failed-classes st) :vcalls @(:vcalls st)
     :state st}))

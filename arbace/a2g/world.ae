(ns arbace.a2g.world
  "a2g's input (A2G-SPEC §4.1): class forms files (Arbace's arbace/lang/*.ae, j2a's conversion
  of the JDK closure under .tmp/jrt/conv) entered into one class environment and analyzed with
  the class forms compiler's front end exactly as arbace.classes.compiler does before emitting
  (resolve-header!, resolve-members!, add-bridges!, analyze-class!). Classes taken from source
  are never resolved by reflection on the running JDK (env/*from-source*)."
  (:require [arbace.string :as str]
            [arbace.java.io :as io]
            [arbace.classes.types :as t]
            [arbace.classes.env :as env]
            [arbace.classes.parse :as p]
            [arbace.classes.analyze :as a]
            [arbace.a2g.model :as m]
            [arbace.a2g.names :as nm])
  (:import (arbace.lang LineNumberingPushbackReader)))

(defn read-forms [f]
  (with-open [r (LineNumberingPushbackReader. (io/reader f))]
    (binding [*read-eval* false]
      (doall (take-while #(not= % ::eof) (repeatedly #(read {:eof ::eof :read-cond :allow} r)))))))

(defn- first-form
  "The first form of file f, or nil."
  [f]
  (with-open [r (LineNumberingPushbackReader. (io/reader f))]
    (binding [*read-eval* false]
      (let [x (read {:eof ::eof :read-cond :allow} r)]
        (when-not (= x ::eof) x)))))

(defn- class-form? [f] (and (seq? f) (symbol? (first f)) (= "defclass" (name (first f)))))

(defn- class-forms [forms]
  (for [f forms
        f (if (and (seq? f) (= 'do (first f))) (rest f) [f])
        :when (class-form? f)]
    f))

(defn- continued? [f] (and (seq? f) (= 'aot/continue (first f))))

(defn- join-continued
  "The read files ps ([{:forms ...}...]) with each class form continued in other files joined:
  arbace.aot writes a large top-level class form across several files (SA220: one large file
  bounded the parallel read), the class form with :aot/parts n in its metadata and the rest of
  its elements in n continuations (aot/continue NAME k element...), k from 1 to n; the
  continuations' elements appended in that order, the class form as printed whole (but the
  reader's columns), :aot/parts dropped, the continuations removed. A missing or unclaimed
  continuation fails."
  [ps]
  (let [conts (into {} (for [{:keys [forms]} ps, f forms :when (continued? f)]
                         [[(str (nth f 1)) (nth f 2)] (drop 3 f)]))]
    (if (empty? conts)
      ps
      (let [claimed (atom #{})
            ps (mapv (fn [p]
                       (update p :forms
                               (fn [forms]
                                 (vec (for [f forms :when (not (continued? f))]
                                        (if-let [n (and (class-form? f) (:aot/parts (meta f)))]
                                          (let [c (str (second f))
                                                ks (map #(vector c %) (range 1 (inc n)))]
                                            (doseq [k ks :when (not (contains? conts k))]
                                              (throw (ex-info (str "a2g: " c ": part " (second k) " of " n " missing (aot/continue)")
                                                              {:class c})))
                                            (swap! claimed into ks)
                                            (with-meta (apply list (concat f (mapcat conts ks)))
                                              (not-empty (dissoc (meta f) :aot/parts))))
                                          f))))))
                     ps)]
        (when-let [u (seq (remove @claimed (keys conts)))]
          (throw (ex-info (str "a2g: continuations of no class form: " (pr-str (sort u))) {})))
        ps))))

(defn- ns-of-forms [forms]
  (let [f (first (filter #(and (seq? %) (symbol? (first %)) (= "in-ns" (name (first %)))) forms))]
    (when f (let [n (second f)] (if (seq? n) (second n) n)))))

(defn- top-names
  "The internal names of the top-level classes of a file's class forms."
  [nsname forms]
  (for [cf (class-forms forms)
        :let [[nm & more] (rest cf)
              more (if (vector? (first more)) (rest more) more)
              pkg (:package (first (p/split-options more)))
              s (str nm)]]
    (cond (some? pkg) (str (when (seq (str pkg)) (str (str/replace (str pkg) "." "/") "/")) s)
          (str/includes? s ".") (str/replace s "." "/")
          :else (str (str/replace (munge (name nsname)) "." "/") "/" s))))

(defn source-files
  "The class forms files of an input: {:root dir :dirs [subdir...]} or {:root dir :tree true}
  (every .ae under root but package files, whose first form is their ns form)."
  [{:keys [root dirs tree files]}]
  (cond
    files (map io/file files)
    tree (->> (file-seq (io/file root))
              (filter #(and (.isFile ^java.io.File %) (str/ends-with? (.getName ^java.io.File %) ".ae")))
              ;; the first form only: reading every file whole here, one after another, took
              ;; 16 s of the compiled namespaces' 28 MB
              (remove #(let [f (first-form %)] (and (seq? f) (= 'ns (first f)))))
              (sort-by str))
    :else (->> (for [d dirs ^java.io.File f (.listFiles (io/file root d))
                     :when (and (.isFile f) (str/ends-with? (.getName f) ".ae"))]
                 f)
               (sort-by str))))

;; ---------------------------------------------------------------------------------------
;; Go-build variants (A2G-SPEC §4.6): (a2g/variant Class member... (a2g/cut head) (a2g/add
;; member)) in files read by a2g only (arbace/lang/go/*.ae)

(defn- head-name [f] (when (and (seq? f) (symbol? (first f))) (name (first f))))

(defn- param-key
  "A method's or constructor's identity in a variant: kind, name, static, parameter tags."
  [f]
  (let [h (head-name f)]
    (case h
      ("method" "a2g-cut-method")
      (let [[_ nm & more] f
            ;; the parameters: the first vector that is not the :throws list
            more (loop [xs more acc []]
                   (cond (empty? xs) acc
                         (= :throws (first xs)) (recur (drop 2 xs) acc)
                         :else (recur (rest xs) (conj acc (first xs)))))
            params (first (filter vector? more))
            static (boolean (:static (meta nm)))
            ps (if static params (rest params))]
        [:method (name nm) static (mapv #(some-> (:tag (meta %)) str) ps)])
      "constructor"
      (let [params (first (filter vector? (loop [xs (rest f) acc []]
                                            (cond (empty? xs) acc
                                                  (= :throws (first xs)) (recur (drop 2 xs) acc)
                                                  :else (recur (rest xs) (conj acc (first xs)))))))]
        [:ctor (mapv #(some-> (:tag (meta %)) str) (rest params))])
      "field" (let [nm (first (filter symbol? (rest f)))] [:field (name nm)])
      "static-initializer" [:static-initializer (or (:a2g/nth (meta f)) 0)]
      "defclass" [:class (name (second f))]
      nil)))

(defn- cut-key [x]
  (cond
    (and (seq? x) (= "field" (head-name x))) (param-key x)
    ;; (a2g/cut (static-initializer n)): the class's n-th static initializer
    (and (seq? x) (= "static-initializer" (head-name x))) [:static-initializer (or (second x) 0)]
    (symbol? (first x)) (param-key (cons 'a2g-cut-method x))
    :else (throw (ex-info (str "a2g: bad a2g/cut " (pr-str x)) {}))))

(defn- class-parts
  "[head members] of a defclass form: head is defclass, name, components, options."
  [cf]
  (let [[dc nm & more] cf
        [comps more] (if (vector? (first more)) [[(first more)] (rest more)] [[] more])
        [opts members] (p/split-options more)]
    [(concat [dc nm] comps (mapcat identity opts)) (vec members)]))

(defn apply-variant
  "Class form cf with the variant's members applied: replaced, cut, added. Returns [cf'
  counts]. With variants-of (a function of a nested class's simple name, giving its variant
  members or nil) and applied (an atom of {name counts}), the variants of nested classes
  (a2g/variant Outer$Inner ...) are applied to the nested class forms too, recursively, and
  recorded in applied under their names (proposed amendment B1)."
  ([cf vforms] (apply-variant cf vforms nil nil nil))
  ([cf vforms prefix variants-of applied]
  (let [[head members] (class-parts cf)
        ;; static initializers are told apart by their position in the class form
        members (let [n (atom -1)]
                  (mapv (fn [m] (if (= "static-initializer" (head-name m))
                                  (vary-meta m assoc :a2g/nth (swap! n inc))
                                  m))
                        members))
        counts (atom {:replaced 0 :cut 0 :added 0})
        members (reduce
                  (fn [ms vf]
                    (case (head-name vf)
                      ;; (a2g/cut (field ...)), (a2g/cut (static-initializer n)), or a
                      ;; method's head spliced: (a2g/cut ^:static name ^Ret [params])
                      "cut" (let [k (cut-key (if (symbol? (second vf)) (rest vf) (second vf)))
                                  hit (some #(= k (param-key %)) ms)]
                              (when-not hit (throw (ex-info (str "a2g: variant cuts no member: " (pr-str (second vf))) {})))
                              (swap! counts update :cut inc)
                              (vec (remove #(= k (param-key %)) ms)))
                      "add" (do (swap! counts update :added inc) (conj ms (second vf)))
                      (let [k (param-key vf)
                            i (first (keep-indexed (fn [i m] (when (= k (param-key m)) i)) ms))]
                        (when-not i (throw (ex-info (str "a2g: variant replaces no member: " (pr-str k)) {})))
                        (swap! counts update :replaced inc)
                        (assoc ms i vf))))
                  members vforms)
        ;; nested classes with variants of their own
        members (if variants-of
                  (mapv (fn [m]
                          (if (= "defclass" (head-name m))
                            (let [nn (str prefix "$" (name (second m)))
                                  vfs (variants-of nn)
                                  [m2 c] (apply-variant m (or vfs []) nn variants-of applied)]
                              (when vfs (swap! applied assoc nn c))
                              m2)
                            m))
                        members)
                  members)]
    [(with-meta (apply list (concat head members)) (meta cf)) @counts])))

(defn read-variants
  "{internal-name [member-form ...]} of the variant files; a nested class's variant is named
  by its binary name, (a2g/variant Compiler$ObjExpr ...). The prefixes of the packages a
  variant file erases, (a2g/erase \"p/\"), are under the key ::erase (amendment E2; the Go
  build erased ASM, arbace/asm/, until it left main on 2026-10-12)."
  [files]
  (reduce (fn [acc f]
            (let [forms (read-forms f)
                  nsname (ns-of-forms forms)]
              (reduce (fn [acc fm]
                        (cond
                          (and (seq? fm) (= "variant" (head-name fm)))
                          (let [[_ cls & members] fm
                                n (str (str/replace (munge (name nsname)) "." "/") "/" (name cls))]
                            (update acc n (fnil into []) members))
                          (and (seq? fm) (= "erase" (head-name fm)))
                          (update acc ::erase (fnil into #{}) (map str (rest fm)))
                          :else acc))
                      acc forms)))
          {} files))

(defn- new-unit []
  {:order (atom []) :counters (atom {}) :switch-maps (atom {}) :switch-holders (atom {})
   :source-tried (atom #{}) :assert-holders (atom {}) :holder-first (atom {})})

(def analysis-id-base
  "Where each task of the analysis starts its id space (RT.ID_SPACE, SA143): a round value well
  above what loading a2g takes, as main's id-floor (SA13)."
  100000)

(defn- id-space
  "The runtime's per-thread id space (RT.ID_SPACE, SA143), or nil on a host without it."
  []
  (try (.get (.getField arbace.lang.RT "ID_SPACE") nil) (catch Throwable _ nil)))

;; ---------------------------------------------------------------------------------------
;; the sequential part's steps in parallel (the build's speed, third round, part B)

(defn- parse-member-classes
  "The member classes of parsed class pc, parsed as arbace.classes.analyze/declare-class! parses
  them (a member class's parse takes only the kind of its outer class), recursively:
  [{:parsed member-class :members [...]}...] in their order, which declare-class! takes as its
  ctx's :parsed-members (a host whose declare-class! does not take it parses them again)."
  [pc]
  (vec (for [m (:members pc) :when (= :class (:kind m))]
         (let [mpc (p/parse-class {:ns (:ns pc) :nesting :member :outer pc} (rest (:form m)))]
           {:parsed mpc :members (parse-member-classes mpc)}))))

(defn- levels
  "names in levels, a name in a level after those of the names it depends on (deps: a name's
  names to process first; others ignored), each level in names' order. A cycle (an error the
  steps report) is cut where it closes."
  [names deps]
  (let [in (set names)
        memo (java.util.HashMap.)
        lvl (fn lvl [n]
              (or (.get memo n)
                  (do (.put memo n 0)
                      (let [l (inc (reduce max -1 (map lvl (filter in (deps n)))))]
                        (.put memo n l)
                        l))))]
    (->> names (group-by lvl) (into (sorted-map)) vals)))

(defn- supers-of
  "The direct supertypes of class n in the compilation."
  [n]
  (let [d (a/decl n)] (cons (:super d) (:interfaces d))))

(defn- par-levels
  "(f n) for each of names, a level (levels) at a time, a level's names in parallel."
  [names deps f]
  (doseq [l (levels names deps)]
    (m/par-mapv (m/jobs) f l)))

(defn load-world
  "Reads, enters and analyzes the class forms of the inputs, each {:root :dirs|:tree|:files},
  with the Go-build variants of the variant files applied. Returns the world:
  {:compile-set atom :unit unit :from-source pred :files [...] :tops #{} :failed [[class
  msg]...] :variants {class counts}}. Run translation inside (with-world w ...).

  In two rounds: the inputs, then the late ones (the compiled namespaces' tree, standalone
  S6), each entered and resolved (headers, members, bridges) in order; the first round's classes
  are analyzed on a thread of their own from the end of the first round, the late ones in
  parallel after the second. Before the second round wait is called (a2g --await: the late
  input is being written meanwhile; bin/arbace-go starts a2g as the host compiles the
  namespaces). The rounds are the same with or without the wait: the output does not depend on
  it."
  [inputs & {:keys [variant-files late-inputs wait]}]
  (let [variants (read-variants variant-files)
        erased (get variants ::erase #{})
        variants (dissoc variants ::erase)
        applied (atom {})
        ;; read in parallel (reading class forms takes no ids: no #() or syntax-quote in them),
        ;; the largest files first (the compiled namespaces' up to 256 KB, a larger class form
        ;; continued in more files: join-continued)
        parse (fn [ins]
                (let [fs (vec (mapcat source-files ins))]
                  (join-continued
                    (m/par-mapv (m/jobs) (fn [f] (let [forms (read-forms f)] {:file f :forms forms :ns (ns-of-forms forms)}))
                                fs
                                (sort-by #(- (.length (io/file (nth fs %)))) (range (count fs)))))))
        parsed (atom (parse inputs))
        top-set (fn [ps] (set (mapcat (fn [{:keys [ns forms]}] (when ns (top-names ns forms))) ps)))
        tops (atom (top-set @parsed))
        top-of (fn [^String n] (let [i (.indexOf n "$")] (if (neg? i) n (subs n 0 i))))
        from-source (fn [n] (contains? @tops (top-of n)))
        cs (atom {})
        unit (new-unit)
        failed (atom [])]
    (binding [env/*compile-set* cs
              a/*unit* unit
              env/*from-source* from-source]
      ;; the sequential part (entering, headers, members, bridges) in an id space of its own
      ;; too: its temporaries' names then do not depend on what the running program evaluated
      ;; before (a tool loaded from source compiles its fns as they are first called, taking
      ;; ids; SA143)
      (when-let [^ThreadLocal space (id-space)]
        (.set space (java.util.concurrent.atomic.AtomicInteger. (int analysis-id-base))))
      (let [t (atom (System/nanoTime))
            laps (atom [])
            lap (fn [k] (let [x (System/nanoTime)] (swap! laps conj [k (/ (Math/round (/ (- x @t) 1e7)) 100.0)]) (reset! t x)))
            ;; the namespace forms (in-ns, import) file by file; the class forms with their
            ;; variants applied and parsed, their member classes too, in parallel (pure: the
            ;; parse resolves nothing but member macros, by the namespace's vars); then
            ;; declared one after another, in the files' order (a failed parse of member classes
            ;; is parsed again as it declares them, failing where it failed before)
            enter! (fn [ps]
                     (let [units (reduce (fn [acc {:keys [file forms ns]}]
                                           (if-not ns
                                             acc
                                             (binding [*ns* *ns*]
                                               (doseq [fm forms
                                                       :when (and (seq? fm) (symbol? (first fm)) (#{"in-ns" "import"} (name (first fm))))]
                                                 (a/eval-ns-form! fm))
                                               (let [nsobj *ns*]
                                                 (into acc (for [cf (class-forms forms)] [file ns nsobj cf]))))))
                                         [] ps)
                           parsed (m/par-mapv (m/jobs)
                                              (fn [[file ns nsobj cf]]
                                                (try
                                                  (let [n (first (top-names ns [cf]))
                                                        vfs (get variants n)
                                                        [cf counts] (apply-variant cf (or vfs []) n #(get variants %) applied)
                                                        _ (when vfs (swap! applied assoc n counts))
                                                        pc (p/parse-class {:ns nsobj :nesting :top} (rest cf))]
                                                    {:pc pc :nsobj nsobj
                                                     :members (try (parse-member-classes pc) (catch Throwable _ nil))})
                                                  (catch Throwable e
                                                    {:error [(str file) (str "parse: " (.getMessage e))]})))
                                              units)]
                       (doseq [[[file] {:keys [pc nsobj members error]}] (map vector units parsed)]
                         (if error
                           (swap! failed conj error)
                           (try
                             (when-not (a/decl (a/top-name nsobj pc))
                               (a/declare-class! {:nesting :top :parsed-members members} pc))
                             (catch Throwable e
                               (swap! failed conj [(str file) (str "parse: " (.getMessage e))])))))))
            ;; process-classes! 0 for names, with failures per class recorded rather than fatal;
            ;; each step in parallel, level by level (levels): a class's header after its outer
            ;; class's (its type variables' bounds), its members and bridges after its
            ;; supertypes' (deftype's signature inference, the bridges' inherited methods); a
            ;; class's step writes only its own declaration and takes no ids
            resolve! (fn [names]
                       (lap :declare)
                       (par-levels names #(some-> (a/decl %) :outer vector)
                                   (fn [n]
                                     (when-not (:headers-done (a/decl n))
                                       (try (a/resolve-header! n) (catch Throwable e (swap! failed conj [n (str "header: " (.getMessage e))]))))))
                       (lap :headers)
                       (par-levels names supers-of
                                   (fn [n]
                                     (try (a/resolve-members! n) (catch Throwable e (swap! failed conj [n (str "members: " (.getMessage e))])))))
                       (lap :members)
                       (par-levels names supers-of
                                   (fn [n]
                                     (try (a/add-bridges! n) (catch Throwable e (swap! failed conj [n (str "bridges: " (.getMessage e))])))))
                       (lap :bridges)
                       (doseq [n names]
                         (try (#'a/mark-enum-abstract! n) (catch Throwable e (swap! failed conj [n (str "enum: " (.getMessage e))])))))
            analyze! (fn [n]
                       (try (a/analyze-class! n)
                            (catch Throwable e
                              (swap! (:state (a/decl n)) assoc :analysis-failed (.getMessage e))
                              (swap! failed conj [n (str "analysis: " (.getMessage e)
                                                         (some->> (.getCause e) .getMessage (str " / ")))]))))
            _ (enter! @parsed)
            names1 @(:order unit)
            _ (resolve! names1)
            ;; the first round's classes (the runtime's) one after another, as before: javac's
            ;; rules make the analysis of a class depend on others' (a local class's captured
            ;; variables); on a thread of their own, from here, in an id space of their own that
            ;; starts where the sequential part stands now (the same with or without the wait),
            ;; and with an order of their own: the local and anonymous classes their analysis
            ;; declares are processed from it (process-classes!), while the second round enters
            ;; its classes in the unit's; the compiled namespaces' classes (S6) depend on none of
            ;; theirs
            rt-start (some-> ^ThreadLocal (id-space) ^java.util.concurrent.atomic.AtomicInteger (.get) .get)
            rt-order (atom names1)
            runtime (if rt-start
                      (future
                        (.set ^ThreadLocal (id-space) (java.util.concurrent.atomic.AtomicInteger. (int rt-start)))
                        (try (binding [a/*unit* (assoc unit :order rt-order)]
                               (run! analyze! names1))
                             (finally (.remove ^ThreadLocal (id-space)))))
                      ;; (a host without id spaces: first, as before)
                      (do (binding [a/*unit* (assoc unit :order rt-order)] (run! analyze! names1)) nil))
            _ (lap :analysis-started)
            _ (when wait (wait))
            _ (lap :wait)
            parsed2 (parse late-inputs)
            _ (lap :read)
            _ (swap! tops into (top-set parsed2))
            _ (swap! parsed into parsed2)
            _ (enter! parsed2)
            names2 (vec (drop (count names1) @(:order unit)))
            _ (resolve! names2)
            ;; a group's member classes before the class enclosing them (a holder's analysis
            ;; would analyze its members, and one member's failure would fail the holder)
            ;; each member class a task of its own (a compiled namespace's classes have no
            ;; local or anonymous classes, whose numbering is the nest's), the top-level ones
            ;; (holders, deftypes, loaders) after them; each task in an id space of its own
            ;; starting at the same value (RT.ID_SPACE: the gensyms that name temporaries depend
            ;; on the class alone; standalone S6, SA143)
            tops? (fn [^String n] (not (str/includes? n "$")))
            groups (vec (for [n names2 :when (not (tops? n))] [n]))
            top-groups (vec (for [n names2 :when (tops? n)] [n]))]
        (if-let [^ThreadLocal space (id-space)]
          (doseq [gs [groups top-groups]]
            (m/par-mapv (m/jobs)
                        (fn [g]
                          (.set space (java.util.concurrent.atomic.AtomicInteger. (int analysis-id-base)))
                          (try (run! analyze! g) (finally (.remove space))))
                        gs))
          ;; a host without id spaces (older than SA143): one after another, as before
          (run! analyze! names2))
        (lap :analysis-compiled)
        (some-> runtime deref)
        ;; the unit's order as one round made it: the first round's classes, the second's, the
        ;; classes the first round's analysis declared, then any the second's did
        (let [main @(:order unit)]
          (reset! (:order unit) (vec (concat names1 names2 (drop (count names1) @rt-order)
                                             (drop (+ (count names1) (count names2)) main)))))
        (when-let [^ThreadLocal space (id-space)] (.remove space))
        (lap :analysis-runtime)
        (println (str "a2g: load (s): " (str/join ", " (for [[k v] @laps] (str (name k) " " v)))))))
    (doseq [n (keys variants) :when (not (contains? @applied n))]
      (swap! failed conj [n "a variant for a class not in the inputs"]))
    {:compile-set cs :unit unit :from-source from-source :files (mapv :file @parsed) :tops @tops
     ;; the class forms file of each top-level class (the Go file named after it, §4.3)
     :source-of (into {} (for [{:keys [file ns forms]} @parsed :when ns
                               n (top-names ns forms)]
                           [n (str file)]))
     :failed (vec (sort-by (juxt first second) @failed)) :variants @applied :erased erased}))

(defmacro with-world
  "Runs body with the world's class environment bound (analyzer and env functions see it)."
  [w & body]
  `(let [w# ~w]
     (binding [env/*compile-set* (:compile-set w#)
               a/*unit* (:unit w#)
               env/*from-source* (:from-source w#)]
       ~@body)))

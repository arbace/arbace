(ns arbace.scheme.interp
  "si in the executable's own process (doc/scheme/SCHEME-SURVEY.md, SC61 (a), SC240; \"As built: the embedding's gaps\"): a Scheme
  program run by arbace.lang.SchemeInterp, whose Go side is go/arbace/scminterp over arbace/scm, psyntax booted from the program's
  embedded resource (arbace.scheme.resource/text). The namespace needs the class, which only an executable built with si has: on
  stage 0 (and any executable before the re-seed that carries it) loading it fails, as arbace.c.cinterp's does without
  arbace.lang.CInterp; bin/lib/crops/c2j-check does not load it (the build's second pass has the class).

  Usage: arbace -m arbace.scheme.interp [--lib DIR]... [--r7rs] [--case|--core] FILE [ARG]...   (bin/si run --exe EXE)"
  (:require [arbace.scheme.resource :as res])
  (:import [arbace.lang SchemeInterp]))

(set! *warn-on-reflection* true)

(defn run
  "The Scheme program in file run on si with args, psyntax booted from the embedded resource: its status (the program's exit,
  255 for an uncaught raise). opts: :libs (psyntax's library path), :case (the light driver's --case), :r7rs, :core."
  [^String file args {:keys [libs case r7rs core]}]
  (SchemeInterp/runProgram (if core "" (res/text)) (into-array String (map str libs)) file (into-array String (map str args))
                           (int (bit-or (if case 1 0) (if r7rs 2 0) (if core 4 0)))))

(defn -main [& args]
  (loop [[a & more :as args] args opts {:libs []}]
    (case a
      "--lib" (recur (rest more) (update opts :libs conj (first more)))
      "--r7rs" (recur more (assoc opts :r7rs true))
      "--case" (recur more (assoc opts :case true))
      "--core" (recur more (assoc opts :core true))
      (if (nil? a)
        (do (println "usage: arbace -m arbace.scheme.interp [--lib DIR]... [--r7rs] [--case|--core] FILE [ARG]...") (System/exit 2))
        (let [status (run a more opts)]
          (flush)
          (shutdown-agents)
          (System/exit status))))))

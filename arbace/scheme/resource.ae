(ns arbace.scheme.resource
  "si's embedded resource (doc/scheme/SCHEME-SURVEY.md, SC61 (a), SC240; \"As built: the embedding's gaps\"): psyntax's
  expanded system as Scheme text, scheme/psyntax/psyntax.pp.ss, which si (arbace.lang.SchemeInterp over go/arbace/scm, and the
  light driver test/scheme/si-driver) boots from.

  Made: generated from the checkout's scheme/psyntax/psyntax.pp.ae (the committed forms, its only source) by `generate`: a
  header comment naming the .ae's SHA-256, then each form printed by repr/scheme on a line (bin/si light's psyntax.pp.ss, which
  bin/repr-scheme print made before, is this text too). j2g --program embeds it with the namespaces' sources
  (arbace.j2g.embed/generated), at the same path; gate_key hashes the .ae (bin/lib/version.bash's arbace_embedded_resources) and
  the generator (arbace/, the embedded sources).

  Loaded: `text`, by RT.load's rule for a tool's source (RT.toolSource): the copy the checkout would give, generated afresh from
  the first scheme/psyntax/psyntax.pp.ae on ARBACE_PATH, when the embedded copy's header names another SHA-256 (or there is no
  embedded copy: stage 0 before the re-seed); else the embedded copy (an executable without the checkout). A host that embeds
  none finds the .ss itself on ARBACE_PATH as RT.resourceAsStream does (bin/si interp-check's resource tree).

  Usage (bin/si interp-check): arbace -m arbace.scheme.resource write DIR    the generated resources under DIR
                                                       text OUT     `text` written to OUT, and where it came from"
  (:require [arbace.repr.scheme.print :as pr])
  (:import [java.io File]))

(set! *warn-on-reflection* true)

(def path "The resource's path, in the program's embedded resources and under ARBACE_PATH." "scheme/psyntax/psyntax.pp.ss")

(def source "The checkout's file it is generated from." "scheme/psyntax/psyntax.pp.ae")

(defn- sha256-hex ^String [^bytes bs]
  (let [md (java.security.MessageDigest/getInstance "SHA-256")]
    (apply str (map #(format "%02x" (bit-and (long %) 0xff)) (.digest md bs)))))

(defn- header ^String [^String digest]
  (str ";; " path ": generated by arbace.scheme.resource from " source ", sha256 " digest "\n"))

(defn generate
  "The resource's text from the bytes of psyntax.pp.ae: the header, then each form printed by repr/scheme, a line a form."
  ^String [^bytes ae]
  (let [rdr (java.io.PushbackReader. (java.io.StringReader. (String. ae "UTF-8")))
        sb (StringBuilder. (header (sha256-hex ae)))]
    (loop []
      (let [x (read {:eof ::eof} rdr)]
        (when-not (= x ::eof)
          (.append sb ^String (pr/write-form x))
          (.append sb "\n")
          (recur))))
    (str sb)))

(defn generated
  "The generated resources of the checkout at root: {resource-path bytes} (arbace.j2g.embed/generated's)."
  [root]
  (let [f (File. (str root "/" source))]
    (if (.isFile f)
      {path (.getBytes (generate (java.nio.file.Files/readAllBytes (.toPath f))) "UTF-8")}
      {})))

(defn- path-file
  "The first file named rel in ARBACE_PATH's directories, or nil."
  ^File [^String rel]
  (when-let [p (System/getenv "ARBACE_PATH")]
    (some (fn [^String e] (let [f (File. (str e "/" rel))] (when (.isFile f) f)))
          (.split p ":"))))

(defn- embedded-bytes ^bytes []
  (when-let [ins (arbace.lang.RT/resourceAsStream nil path)]
    (try (.readAllBytes ins) (finally (.close ins)))))

(defn- digest-of
  "The SHA-256 the header of a generated text names, or nil."
  [^String text]
  (second (re-find #"^;; \S+: generated by arbace.scheme.resource from \S+, sha256 ([0-9a-f]{64})\n" text)))

(defn load-text
  "[text how]: psyntax.pp as Scheme text, how :embedded or :checkout (`text`'s rule), or nil when neither exists."
  []
  (let [emb (some-> (embedded-bytes) (String. "UTF-8"))
        src (path-file source)
        src-bytes (when src (java.nio.file.Files/readAllBytes (.toPath src)))]
    (cond
      (and src-bytes (or (nil? emb) (not= (digest-of emb) (sha256-hex src-bytes)))) [(generate src-bytes) :checkout]
      emb [emb :embedded]
      :else nil)))

(defn text
  "psyntax.pp as Scheme text, si's boot: the checkout's (generated from its .ae) when it differs from the embedded copy, else
  the embedded copy. Throws when there is neither."
  ^String []
  (or (first (load-text))
      (throw (ex-info (str "si: no " path " embedded and no " source " on ARBACE_PATH") {}))))

(defn -main [& [verb arg]]
  (let [rc (case verb
             "write" (do (doseq [[p ^bytes b] (generated (or (System/getenv "ARBACE_ROOT") "."))]
                           (let [f (File. (str arg "/" p))]
                             (.mkdirs (.getParentFile f))
                             (with-open [o (java.io.FileOutputStream. f)] (.write o b))
                             (println "wrote" p (alength b) "bytes")))
                         0)
             "text" (let [[t how] (load-text)]
                      (if t
                        (do (spit arg t) (println "psyntax.pp.ss:" (name how) (count t) "characters") 0)
                        (do (println "si: no" path "embedded and no" source "on ARBACE_PATH") 1)))
             (do (println "usage: arbace -m arbace.scheme.resource write DIR | text OUT") 2))]
    (flush)
    (shutdown-agents)
    (System/exit rc)))

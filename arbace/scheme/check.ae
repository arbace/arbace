(ns arbace.scheme.check
  "si's check (doc/scheme/SCHEME-SURVEY.md, \"As built: SM5 (write-ahead)\", \"As built: SCS3\"): the run programs of
  test/scheme/si/programs.edn run on si, each judged by one judge (SCS3, judge-of): the R6RS suites' programs by their own
  test report alone, its count of tests the program's :tests; si's own programs by their golden output (:golden, status 0 and
  stdout byte for byte); Larceny's by Chez Scheme 10.3.0's runs recorded in test/scheme/si/ref-chez.edn (status and stdout
  byte for byte; a reference that is an error, the same kind of error, error-of: review 009, finding 1). Every non-pass is an item \"KIND PROGRAM DETAIL\" and must fall in a class of
  test/scheme/divergences.edn (goi's format: the first class whose :match finds the item). The negative controls
  (test/scheme/si/controls.edn, GTS81 (a)): a program's run judged against another's Chez run must give an item; one that
  passes, or is not judged, fails the judgment (and the record is still written). bin/si runs
  the programs (si and Chez) into a directory of ID.out, ID.err, ID.rc; this namespace records and judges.

    record-ref DIR             Chez's runs in DIR merged into test/scheme/si/ref-chez.edn (the entries not run stay; the
                               record types' gensyms written `gensym`); ref-test: its pure parts checked
    judge DIR [--record] [--aot] [--only ID]...
                               si's runs in DIR judged; --record writes test/scheme/check-linux-amd64.edn (with
                               --only: the programs run, the record's other entries kept);
                               --aot: the compiled runs (bin/si check --aot, SM7), a program the AOT refuses
                               an item \"refused ID: WHY\", the classes of test/scheme/divergences-aot.edn
                               first, the results test/scheme/check-aot-linux-amd64.edn
    compare SI-DIR AOT-DIR     the interpreted and the compiled runs of each program compared (status and
                               stdout): the same, differing, or refused
    own DIR [--list]           SCS1, SCS3: the runs judged by the check's judges and by Chez's runs, compared (by hand)
    divergences [RESULTS]      the recorded results' items by class (none unclassified)"
  (:require [arbace.string :as str] [arbace.scheme.regress :as rg]))

(defn- root [] (or (System/getenv "ARBACE_ROOT") "."))
(defn- path [& xs] (apply str (root) "/" xs))

(defn programs [] (:programs (read-string (slurp (path "test/scheme/si/programs.edn")))))

(defn- fid [id] (str/replace (str id) "/" "__"))

(defn- run-of [dir id]
  (let [f (fn [ext] (let [x (java.io.File. (str dir "/" (fid id) "." ext))] (when (.exists x) (slurp x))))]
    (if-let [why (f "refused")]
      {:refused (str/trim why)}
      (when-let [rc (f "rc")]
        {:status (Long/parseLong (str/trim rc)) :out (or (f "out") "") :err (or (f "err") "")}))))

(defn- first-line [s] (first (str/split-lines (or s ""))))

(defn normalise-gensym
  "Chez's output with a record type's gensym, #{err kixdzb...-2}, written #{err gensym}: Chez names it afresh on every run,
  so the reference is byte-stable (SC221 (b)); the known difference below rewrites both sides alike."
  [s]
  (str/replace s #"#\{(\S+) [^}\s]+\}" "#{$1 gensym}"))

(defn merge-runs
  "The reference's entries old with the runs new in the order of the programs ids: a run replaces its entry (SC220 (b)), an entry
  not run stays."
  [ids old new]
  (let [by (merge (into {} (map (juxt :id identity) old)) (into {} (map (juxt :id identity) new)))]
    (vec (for [id ids :when (by id)] (by id)))))

(defn missing-ids
  "The ids of programs ids that have no entry in the reference all (a program added or renamed and not run yet)."
  [ids all]
  (let [have (set (map :id all))] (vec (remove have ids))))

(defn duplicate-ids
  "The ids that occur more than once in ids, each once, in the order of their first occurrence (re-review 058, Q5)."
  [ids]
  (let [f (frequencies ids)] (vec (distinct (filter #(> (f %) 1) ids)))))

(defn record-plan
  "record-ref's decision, pure: from the programs' ids, the reference's entries old and Chez's runs, {:refuse [LINE ...]} (nothing
  written) or {:all ENTRIES :notes [LINE ...]}. A program id named twice in programs.edn is refused (the merge would write its
  entry twice); a reference entry named twice (a hand edit) is said, one kept: the run's, else the last (re-review 058, Q5)."
  [ids old runs]
  (if-let [d (seq (duplicate-ids ids))]
    {:refuse [(str "test/scheme/si/programs.edn names more than once: " (str/join ", " d) " (nothing recorded)")]}
    (let [all (merge-runs ids old runs)]
      {:all all
       :notes (vec (concat
                     (when-let [d (seq (duplicate-ids (map :id old)))]
                       [(str "the reference had more than one entry for: " (str/join ", " d) " (one kept: the run's, else the last)")])
                     (when-let [m (seq (missing-ids ids all))]
                       [(str "no reference entry for: " (str/join ", " m) " (run them: bin/si check --record-ref --only ID)")])))})))

(defn- ref-file [] (path "test/scheme/si/ref-chez.edn"))

(defn header-version
  "The Chez version a reference's text names in its header line, nil when it names none."
  [text]
  (second (re-find #"^;; Chez Scheme (\S+)'s runs" (or text ""))))

(defn version-plan
  "Re-review 058, Q5's mixed versions: the version old-v the reference's header names, the version new-v of the Chez that made the
  runs (DIR/chez.version, bin/si writes it), partial? when a program was not run: {:version V}, the header's, or {:refuse LINE}
  (nothing written): a partial record by another Chez would keep the other version's entries under one header."
  [old-v new-v partial?]
  (cond
    (nil? new-v) {:refuse "no chez.version beside the runs: the Chez that made them is not known (bin/si check --record-ref writes it)"}
    (or (nil? old-v) (= old-v new-v) (not partial?)) {:version new-v}
    :else {:refuse (str "the reference holds Chez " old-v "'s runs and these are Chez " new-v "'s: a partial record would mix them; "
                        "record every program (bin/si check --record-ref, no --only), nothing recorded")}))

(defn- cmd-record-ref [[dir]]
  (let [runs (vec (for [{:keys [id]} (programs) :let [r (run-of dir id)] :when r]
                    {:id id :status (:status r) :out (normalise-gensym (:out r)) :err (first-line (:err r))}))
        old-text (when (.exists (java.io.File. ^String (ref-file))) (slurp (ref-file)))
        old (when old-text (read-string old-text))
        vf (java.io.File. (str dir "/chez.version"))
        vp (version-plan (header-version old-text) (when (.exists vf) (not-empty (str/trim (slurp vf))))
                         (< (count runs) (count (programs))))
        {:keys [refuse all notes]} (if (:refuse vp) {:refuse [(:refuse vp)]} (record-plan (map :id (programs)) old runs))]
    (if refuse
      (do (doseq [l refuse] (println l)) 1)
      (do (spit (ref-file)
                (str ";; Chez Scheme " (:version vp) "'s runs of si's check programs (bin/si check --record-ref); generated.\n"
                     "[\n" (str/join "" (map #(str (pr-str %) "\n") all)) "]\n"))
          (println "recorded" (count runs) "runs of Chez into test/scheme/si/ref-chez.edn," (count all) "entries")
          (doseq [l notes] (println l))
          0))))

(defn- duplicates-code
  "Re-review 058, Q5: an id twice in programs.edn or in the reference (where the judge's last entry would win silently) said; 1 when one is."
  []
  (let [ls (concat (for [d (duplicate-ids (map :id (programs)))] (str "test/scheme/si/programs.edn names more than once: " d))
                   (for [d (duplicate-ids (map :id (read-string (slurp (ref-file)))))] (str "test/scheme/si/ref-chez.edn has more than one entry for: " d)))]
    (doseq [l ls] (println "  FAILING" l))
    (if (seq ls) 1 0)))

(defn- cmd-ref-test
  "The pure parts of record-ref: the merge keeps entries not run and replaces the ones run, the gensym is normalised, duplicate ids,
  the header's Chez version."
  []
  (let [e (fn [id o] {:id id :status 0 :out o :err ""})
        m (merge-runs ["a" "b" "c"] [(e "a" "1") (e "b" "2") (e "c" "3")] [(e "b" "X")])
        g (normalise-gensym "R #[#{err kixdzb-2} #<c>] #{err jpjtb3-2}")
        p (record-plan ["a" "b"] [(e "a" "1") (e "b" "2") (e "a" "3")] [(e "b" "X")])
        ok (and (= ["1" "X" "3"] (map :out m)) (= ["d"] (missing-ids ["a" "d"] m)) (empty? (missing-ids ["a"] m))
                (= ["a" "c"] (duplicate-ids ["a" "b" "a" "c" "c" "a"])) (empty? (duplicate-ids ["a" "b"]))
                (:refuse (record-plan ["a" "b" "a"] [] [])) (= ["3" "X"] (map :out (:all p))) (= 1 (count (:notes p)))
                (= "10.3.0" (header-version ";; Chez Scheme 10.3.0's runs of si's check programs\n[]")) (nil? (header-version nil))
                (= {:version "10.3.0"} (version-plan "10.3.0" "10.3.0" true)) (= {:version "10.4.0"} (version-plan "10.3.0" "10.4.0" false))
                (:refuse (version-plan "10.3.0" "10.4.0" true)) (:refuse (version-plan "10.3.0" nil false))
                (= "R #[#{err gensym} #<c>] #{err gensym}" g)
                (= g (normalise-gensym g)))]
    (println (if ok "ref-test: ok" (str "ref-test: FAILED " (pr-str m) (pr-str g))))
    (if ok 0 1)))

;; SC172 (b): byte equality of stdout is the rule for a suite program too; the known differences between Chez's output and si's
;; are named here, each one a rewrite of Chez's output, and a program whose output differs in any other way is an item
(def known-differences
  [{:name :chez-record-gensym
    :why "Chez writes a record type's name as its gensym, #{err kixdzb...-2}; si writes the name"
    :rewrite (fn [s] (str/replace s #"#\{(\S+) [^}\s]+\}" "$1"))}])

(defn applied-differences
  "The names of the known differences Chez's output out shows (a rewrite that changes it)."
  [out]
  (vec (for [{:keys [name rewrite]} known-differences :when (not= out (rewrite out))] name)))

(defn expected-out
  "Chez's output with the known differences rewritten: what si's must equal byte for byte."
  [out]
  (reduce (fn [s {:keys [rewrite]}] (rewrite s)) out known-differences))

(defn- differs-item [id ours theirs]
  (let [ol (str/split-lines ours) tl (str/split-lines theirs)
        i (count (take-while true? (map = ol tl)))]
    (str "differs " id " line " (inc i) ": " (pr-str (nth ol i nil)) " for " (pr-str (nth tl i nil)))))

;;; The suites' output: a header, then "N tests passed" or the failures, each "Expression:\n EXPR\nResult:...".

(defn suite-report
  "A Racket R6RS suite run's report: {:tests N :failures [[EXPR RESULT] ...]} (every failing test in order, duplicates
  kept), nil when the output has no test report. N is the total its last report line gives (\"N tests passed\" or
  \"M of N tests failed.\")."
  [^String out]
  (when-let [ls (seq (re-seq #"(?m)^(?:(\d+) tests passed|\d+ of (\d+) tests failed\.)$" out))]
    {:tests (reduce + (map (fn [[_ a b]] (Long/parseLong (or a b))) ls))
     :failures (vec (for [[_ e res] (re-seq #"(?s)Expression:\n (.*?)\nResult:(.*?)\nExpected:" out)]
                      ;; Chez writes a record type's name as its gensym, #{err kixdzb...-2}; si writes the name
                      [e (expected-out (str/trim res))]))}))

;; Review 009, finding 1: a run whose reference is an error is judged on the error's kind, not on the status alone (si exits
;; 255 on every uncaught error). The kinds both sides spell differently are named; any other error is its first line.
(def error-kinds
  [[:library-not-found #"library (\(.*\)) not found"]                                  ; Chez
   [:library-not-found #"cannot locate library in library-path with irritants \((\(.*\))\)"] ; si's psyntax
   [:unbound-identifier #"unbound identifier (\S+?)(?: at line .*)?$"]                   ; Chez
   [:unbound-identifier #"^Exception in (\S+): unbound identifier$"]                     ; si
   [:program-without-import #"invalid top-level program import subform()"]               ; Chez: a form before the import
   [:program-without-import #"top-level program is missing an \(import ---\) clause()"]])  ; si

(defn error-of
  "The kind of error a run's first stderr line says: [KIND SUBJECT], or [:text LINE] when no kind is named; nil for no line."
  [line]
  (when (seq line)
    (or (some (fn [[k re]] (when-let [m (re-find re line)] [k (when (vector? m) (not-empty (second m)))])) error-kinds)
        [:text (str/trim line)])))

(defn- items-of
  "The non-pass items of program id: ours r against the reference ref."
  [{:keys [id suite]} r ref]
  (cond
    (nil? ref) [(str "no-reference " id)]
    (nil? r) [(str "not-run " id)]
    (:refused r) [(str "refused " id ": " (:refused r))]
    :else
    (let [same-status (= (:status r) (:status ref))
          ;; an error on both sides: the same kind of error (finding 1)
          err-items (when (and same-status (not= 0 (:status ref)))
                      (let [a (error-of (first-line (:err r))) b (error-of (:err ref))]
                        (when (not= a b)
                          [(str "error-differs " id ": " (pr-str a) " for Chez's " (pr-str b))])))]
      (if (and same-status (= (:out r) (:out ref)))
        (vec err-items)
        (let [ours (suite-report (:out r)) theirs (suite-report (:out ref))
              crash (fn [] (str "crash " id " status " (:status r) ": " (first-line (:err r))))]
          (if (and suite ours theirs same-status)
            ;; the failures as multisets of [expression result]: a test both fail with other results is an item, and the
            ;; totals must agree (a run that stops early prints a smaller "N tests passed")
            (let [fo (frequencies (:failures ours)) ft (frequencies (:failures theirs))
                  exprs-o (set (map first (:failures ours)))
                  extra (fn [a b] (mapcat (fn [[k n]] (repeat (- n (get b k 0)) k)) (sort-by str a)))]
              (let [report (concat
                             (when (not= (:tests ours) (:tests theirs))
                               [(str "count " id ": " (:tests ours) " tests for Chez's " (:tests theirs))])
                             (for [[e b] (extra fo ft)]
                               (str "fails " id " " e " => " (str/replace b "\n" " ")))
                             (for [[e _] (extra ft fo) :when (not (contains? exprs-o e))]
                               (str "passes " id " " e)))]
                ;; the report agrees: the rest of stdout must too (SC172 (b)), but for the known differences
                (concat report
                        (when (and (empty? report) (not= (:out r) (expected-out (:out ref))))
                          [(differs-item id (:out r) (expected-out (:out ref)))])
                        err-items)))
            (if (not same-status)
              [(crash)]
              (let [ol (str/split-lines (:out r)) tl (str/split-lines (:out ref))
                    i (count (take-while true? (map = ol tl)))]
                (concat
                  [(str "differs " id " line " (inc i) ": " (pr-str (nth ol i nil)) " for " (pr-str (nth tl i nil)))]
                  err-items)))))))))

;; SCS1 (the user's decision of 2026-11-07, doc/scheme/SCHEME-SURVEY.md "Decided (the user, 2026-11-07)"): a test's own verdict counts
;; as a judge no toolchain made. A program of the R6RS suites (:suite) reports its own pass or fail, test by test; si's own
;; programs and Larceny's print values, which only a reference (Chez's recorded run) can judge. own-verdict is the first kind's
;; judge alone, no reference; agreement measures it against the recorded-output judge (items-of) program by program.

(defn own-verdict
  "The own verdict of a run r of program p, no reference consulted: [:pass DETAIL] or [:fail DETAIL] for a program with a test
  report (:suite), nil for a program that has none. It passes when the run ended with status 0, reported at least one test and
  no test failed; a run with no report is a failure. A run that stops early with status 0 reports fewer tests, which this
  verdict alone cannot know: the check's judge, suite-items (SCS3), compares the report's count with the program's :tests."
  [{:keys [suite]} r]
  (when suite
    (cond (nil? r) [:fail "not run"]
          (:refused r) [:fail (str "refused: " (:refused r))]
          :else (let [rep (suite-report (:out r))]
                  (cond (nil? rep) [:fail (str "no test report, status " (:status r))]
                        (seq (:failures rep)) [:fail (str (count (:failures rep)) " of " (:tests rep) " tests failed")]
                        (not= 0 (:status r)) [:fail (str "status " (:status r) " after " (:tests rep) " tests")]
                        (zero? (:tests rep)) [:fail "no test"]
                        :else [:pass (str (:tests rep) " tests passed")])))))

(defn agreement-kind
  "How the own verdict own ([V DETAIL] or nil) and the recorded-output judge's items (empty: pass) relate for one program:
  :no-own (the program has no own verdict), :agree-pass, :agree-fail, :own-pass-ref-fail (the recorded-output judge finds an item
  beside the report), or, when the recorded-output judge passes what fails its own tests (it compares with Chez's run and Chez
  fails them too), :chez-fails-too (Chez's run reports the same failing tests) or :chez-errors-too (neither run reaches a report:
  Chez ends with the same error, e.g. a library of the suite it does not find). ref: Chez's recorded run."
  [own items ref]
  (cond (nil? own) :no-own
        (and (= :pass (first own)) (empty? items)) :agree-pass
        (and (= :fail (first own)) (seq items)) :agree-fail
        (= :fail (first own)) (if (suite-report (:out ref)) :chez-fails-too :chez-errors-too)
        :else :own-pass-ref-fail))

;; SCS3 (doc/scheme/SCHEME-SURVEY.md, "As built: SCS3"; the user's decision of 2026-11-07): each program is judged by one judge,
;; the first that applies: a suite's program (:suite) by its own report alone, against the count of tests it must report (:tests);
;; si's own program by its golden output (:golden, Arbace's own expected stdout, reviewed); any other (Larceny's) by Chez's recorded
;; run (items-of). Chez's runs of the first two kinds are not read at check time (bin/si own compares them, by hand).

(defn judge-of
  "The judge of program p: :own (its test report), :golden (its expected output) or :chez (Chez's recorded run)."
  [p]
  (cond (:suite p) :own (:golden p) :golden :else :chez))

(defn golden-text
  "The golden output of program p (its :golden file's text), nil when it has none or the file is missing."
  [p]
  (when-let [g (:golden p)]
    (let [f (java.io.File. ^String (path g))] (when (.exists f) (slurp f)))))

(defn suite-items
  "The own-verdict judge's items for a suite's program p from its run r alone, no reference (SCS3): each test its report says
  failed (\"fails ID EXPR => RESULT\"), a report whose count of tests is not p's :tests (\"count\": a run that stops early with
  status 0 reports fewer; a program without :tests is an item too), a report followed by a non-zero status (\"status\"), a run with
  no report (\"no-report ID status S: ERROR\", the error's kind, error-of)."
  [{:keys [id tests]} r]
  (cond
    (nil? r) [(str "not-run " id)]
    (:refused r) [(str "refused " id ": " (:refused r))]
    :else
    (let [rep (suite-report (:out r))]
      (if (nil? rep)
        [(str "no-report " id " status " (:status r) ": " (or (some-> (error-of (first-line (:err r))) pr-str) "no error line"))]
        (vec (concat
               (for [[e res] (:failures rep)] (str "fails " id " " e " => " (str/replace res "\n" " ")))
               (cond (nil? tests) [(str "count " id ": " (:tests rep) " tests, and no expected count (test/scheme/si/programs.edn's :tests)")]
                     (not= tests (:tests rep)) [(str "count " id ": " (:tests rep) " tests for the expected " tests)])
               (when (not= 0 (:status r)) [(str "status " id " " (:status r) " after " (:tests rep) " tests: " (first-line (:err r)))])))))))

(defn golden-items
  "The golden judge's items for program p's run r against its expected output gold (SCS3): the status (p's :status, default 0)
  and stdout byte for byte; nil gold (no golden file) an item."
  [{:keys [id status golden]} r gold]
  (cond
    (nil? gold) [(str "no-golden " id ": " golden)]
    (nil? r) [(str "not-run " id)]
    (:refused r) [(str "refused " id ": " (:refused r))]
    :else (vec (concat (when (not= (or status 0) (:status r)) [(str "crash " id " status " (:status r) ": " (first-line (:err r)))])
                       (when (not= (:out r) gold) [(differs-item id (:out r) gold)])))))

;; SCS3: the blind spot scheme-90 noted (a run that stops early with status 0 reports fewer tests) and the judges' other cases, checked
;; on made-up runs at every judgment (no program run): each must give its item, and the passing runs none
(defn judge-test-failures
  "The made-up cases the judges get wrong, as lines (empty: all right)."
  []
  (let [p {:id "t/p" :suite true :tests 3}
        run (fn [st out err] {:status st :out out :err err})
        rep-ok "Running tests for (t)\n3 tests passed\n"
        cases [["a full report passes" (suite-items p (run 0 rep-ok "")) empty?]
               ["a run that stops early with status 0 is a count item"
                (suite-items p (run 0 "Running tests for (t)\n2 tests passed\n" "")) #(some (fn [i] (str/starts-with? i "count t/p: 2 tests for the expected 3")) %)]
               ["a report and then a non-zero status is a status item"
                (suite-items p (run 1 rep-ok "Exception: x")) #(some (fn [i] (str/starts-with? i "status t/p 1")) %)]
               ["a failing test is a fails item"
                (suite-items p (run 0 "1 tests failed:\n\nExpression:\n (car 1)\nResult:\n 2\nExpected:\n 1\n\n1 of 3 tests failed.\n" ""))
                #(= ["fails t/p (car 1) => 2"] %)]
               ["no report is a no-report item with the error's kind"
                (suite-items p (run 255 "" "Exception: library (x y) not found")) #(= ["no-report t/p status 255: [:library-not-found \"(x y)\"]"] %)]
               ["a suite program with no :tests is an item" (suite-items (dissoc p :tests) (run 0 rep-ok "")) seq]
               ["the golden output passes its own run" (golden-items {:id "t/g"} (run 0 "a\n" "") "a\n") empty?]
               ["another stdout differs from the golden" (golden-items {:id "t/g"} (run 0 "a\nb\n" "") "a\nc\n") #(= ["differs t/g line 2: \"b\" for \"c\""] %)]
               ["another status is a crash" (golden-items {:id "t/g"} (run 255 "a\n" "Exception: x") "a\n") #(some (fn [i] (str/starts-with? i "crash t/g status 255")) %)]
               ["a missing golden file is an item" (golden-items {:id "t/g" :golden "x.out"} (run 0 "" "") nil) seq]]]
    (vec (for [[what items ok?] cases :when (not (ok? items))] (str what ": " (pr-str items))))))

(defn- judge-test-code []
  (let [f (judge-test-failures)]
    (if (empty? f)
      (do (println "judge-test: ok (an early stop with status 0, a failing test, a status, no report, a golden difference: each found)") 0)
      (do (doseq [l f] (println "  FAILING judge-test" l)) 1))))

(defn program-items
  "The non-pass items of program p's run r by its judge (judge-of): its own report, its golden output gold, or Chez's run ref."
  [p r ref gold]
  (case (judge-of p)
    :own (suite-items p r)
    :golden (golden-items p r gold)
    :chez (vec (items-of p r ref))))

(defn- cmd-own
  "own DIR: the runs of DIR (bin/si check's .tmp/si/runs, or --aot's) judged by the check's judges (SCS3: the suites' own reports
  with their counts, si's programs' golden outputs) and by Chez's recorded runs (items-of), program by program: the share judged
  without Chez, and the disagreements by kind (with --list, each program). An oracle-tier comparison, by hand: the check itself
  reads no Chez run for these programs."
  [[dir & opts]]
  (let [refs (into {} (map (juxt :id identity) (read-string (slurp (path "test/scheme/si/ref-chez.edn")))))
        rows (vec (for [p (programs) :let [r (run-of dir (:id p))] :when r
                        :let [ref (refs (:id p)) chez (vec (items-of p r ref)) j (judge-of p)
                              items (program-items p r ref (golden-text p))
                              own (when (not= :chez j) [(if (empty? items) :pass :fail) (or (first items) (second (own-verdict p r)) "golden output")])
                              kind (if (= :golden j)
                                     (cond (= (empty? items) (empty? chez)) (if (empty? items) :agree-pass :agree-fail)
                                           (empty? items) :own-pass-ref-fail :else :own-fail-ref-pass)
                                     (agreement-kind own chez ref))]]
                    {:id (:id p) :judge j :own own :items chez :kind kind}))
        by (group-by :kind rows)
        n (count rows) k (count (remove #(= :no-own (:kind %)) rows))]
    (println (str n " programs run, " k " judged without Chez (" (format "%.1f" (* 100.0 (/ k (max n 1)))) "%: "
                  (count (filter #(= :own (:judge %)) rows)) " by their own report, " (count (filter #(= :golden (:judge %)) rows))
                  " by their golden output), " (- n k) " by Chez's recorded run"))
    (doseq [kind [:agree-pass :agree-fail :chez-fails-too :chez-errors-too :own-pass-ref-fail :own-fail-ref-pass :no-own]]
      (println (str "  " (name kind) ": " (count (by kind))))
      (when (or (some #{"--list"} opts) (#{:chez-fails-too :chez-errors-too :own-pass-ref-fail :own-fail-ref-pass} kind))
        (doseq [{:keys [id own items]} (by kind)]
          (println (str "    " id (when own (str " [" (name (first own)) " " (second own) "]")) (when (seq items) (str " Chez's run: " (first items))))))))
    0))

(def ^:dynamic *aot* false)

(defn load-classes []
  (vec (concat (when *aot* (read-string (slurp (path "test/scheme/divergences-aot.edn"))))
               (read-string (slurp (path "test/scheme/divergences.edn"))))))

(defn- results-file [] (path (if *aot* "test/scheme/check-aot-linux-amd64.edn" "test/scheme/check-linux-amd64.edn")))

(defn class-of [classes item]
  (:id (first (filter (fn [c] (some #(re-find % item) (:match c))) classes))))

(defn- judge [dir only]
  (let [refs (into {} (map (juxt :id identity) (read-string (slurp (path "test/scheme/si/ref-chez.edn")))))
        classes (load-classes)]
    (vec (for [p (programs)
               :when (or (empty? only) (contains? only (:id p)))
               :let [r (run-of dir (:id p))
                     items (program-items p r (refs (:id p)) (golden-text p))]]
           {:id (:id p) :verdict (if (empty? items) :pass :non-pass) :judge (judge-of p)
            :items (mapv (fn [i] {:item i :class (class-of classes i)}) items)}))))

;; GTS81 (a): the negative controls (test/scheme/si/controls.edn): [{:id :subject PROGRAM :reference PROGRAM :why}...], the
;; subject's run judged by the subject's own judge (SCS3, judge-of) against the reference program's expectation: a suite's
;; program against the reference's count of tests (:tests), si's own against the reference's golden output, any other against
;; the reference's Chez run; it must give an item

(defn controls [] (read-string (slurp (path "test/scheme/si/controls.edn"))))

(defn control-items
  "The items of subject program p's run r judged by p's judge against reference program q's expectation (q's :tests, golden
  output gold-q or Chez run ref-q); nil when q has none of the kind p's judge needs (the control cannot be judged)."
  [p r q ref-q gold-q]
  (case (judge-of p)
    :own (when (:tests q) (suite-items (assoc p :tests (:tests q)) r))
    :golden (when gold-q (golden-items p r gold-q))
    :chez (when ref-q (vec (items-of p r ref-q)))))

(defn control-result
  "A control judged: :differs (the judge gives an item: a control must), :passes (none: the judge passes what differs),
  :not-judged (the subject or the reference is no program of the check, or the reference has no expectation of the kind the
  subject's judge needs), :left (the subject not selected by only, not run, or refused by the AOT: its own verdict says so)."
  [progs refs golds run only {:keys [subject reference]}]
  (let [p (progs subject) q (progs reference) r (run subject)
        items (when (and p q) (control-items p r q (refs reference) (golds reference)))]
    (cond
      (and (seq only) (not (contains? only subject))) :left
      (or (nil? p) (nil? q) (nil? items)) :not-judged
      (or (nil? r) (:refused r)) :left
      (seq items) :differs
      :else :passes)))

(defn- controls-code
  "Each control's result printed; 1 when one passes or is not judged, else 0."
  [dir only]
  (let [progs (into {} (map (juxt :id identity) (programs)))
        refs (into {} (map (juxt :id identity) (read-string (slurp (path "test/scheme/si/ref-chez.edn")))))
        golds (fn [id] (some-> (progs id) golden-text))
        rs (for [c (controls)] [c (control-result progs refs golds #(run-of dir %) only c)])
        expect (fn [subject] (case (some-> (progs subject) judge-of) :own "count of tests" :golden "golden output" "Chez run"))]
    (doseq [[{:keys [id subject reference]} v] rs]
      (let [against (str subject " against " reference "'s " (expect subject))]
        (println (case v
                   :differs (str "control " id " (" against "): differs, as a control must (GTS81 (a))")
                   :passes (str "control passed: " id " (" against "): the judge passes what differs")
                   :not-judged (str "control not judged: " id ": " subject " or " reference " is no program of the check, or " reference " has no " (expect subject))
                   :left (str "control " id ": left (" subject " not selected, not run or refused)")))))
    (if (some #(#{:passes :not-judged} (second %)) rs) 1 0)))

(defn- summary [results]
  (let [items (mapcat :items results)
        bad (remove :class items)]
    (println (count (filter #(= :pass (:verdict %)) results)) "of" (count results) "programs pass;"
             (count items) "non-pass items," (count bad) "failing (in no class)")
    (doseq [[c n] (sort-by str (frequencies (keep :class items)))] (println " " n (name c)))
    (doseq [i bad] (println "  FAILING" (:item i)))
    (if (seq bad) 1 0)))

;; the records hold no :judge (judge-of derives it from test/scheme/si/programs.edn), so that a partial record's kept entries and its
;; new ones are alike
(defn- write-results [results]
  (spit (results-file)
        (str (if *aot*
               ";; si's AOT check (bin/si check --aot --record): each compiled program's verdict and non-pass items with their\n;; classes (test/scheme/divergences-aot.edn, then test/scheme/divergences.edn); generated.\n[\n"
               ";; si's check (bin/si check --record): each program's verdict and non-pass items with their classes\n;; (test/scheme/divergences.edn); generated.\n[\n")
             (str/join "" (map #(str (pr-str (dissoc % :judge)) "\n") results)) "]\n")))

(defn- recorded-results []
  (let [f (java.io.File. ^String (results-file))] (when (.exists f) (vec (read-string (slurp f))))))

(defn- judges-line
  "SCS3: one line a judgment: the programs judged by each judge (judge-of) and how many of them pass."
  [results]
  (let [by (group-by :judge results)
        part (fn [k what] (let [rs (by k)] (str (count rs) " by " what " (" (count (filter #(= :pass (:verdict %)) rs)) " pass)")))]
    (println (str "judges: " (part :own "their own test report") ", " (part :golden "their golden output") ", "
                  (part :chez "Chez's recorded run") "; bin/si own compares the first two with Chez's runs"))))

(defn- cmd-judge [[dir & opts]]
  (let [only (set (map second (filter #(= "--only" (first %)) (partition 2 1 opts))))
        results (judge dir only)
        ;; SC181 (b): the regression step (arbace.scheme.regress) before anything is written; a partial run (--only) against the
        ;; recorded results of the programs it ran
        rec0 (recorded-results)
        rec (if (and rec0 (seq only)) (filterv #(contains? only (:id %)) rec0) rec0)
        recording? (boolean (some #{"--record"} opts))]
    (doseq [{:keys [id verdict items]} results]
      (println (name verdict) id (if (seq items) (str "(" (count items) " items)") "")))
    (when recording?
      ;; SCS3: a partial run (--only) records the programs it ran, the record's other entries kept (as SC182 (b)'s mats)
      (let [all (if (seq only) (merge-runs (map :id (programs)) rec0 results) results)]
        (write-results all)
        (println "wrote" (results-file) (if (seq only) (str "(" (count results) " results run, " (- (count all) (count results)) " kept from the record)") ""))))
    (judges-line results)
    (max (summary results) (rg/regress-code rec results recording? (load-classes)) (controls-code dir only) (judge-test-code))))

(defn- cmd-compare
  "The interpreted runs in si-dir and the compiled runs in aot-dir, program by program."
  [[si-dir aot-dir & opts]]
  (let [only (set (map second (filter #(= "--only" (first %)) (partition 2 1 opts))))
        rows (for [{:keys [id]} (programs)
                   :when (or (empty? only) (contains? only id))
                   :let [a (run-of si-dir id) b (run-of aot-dir id)]]
               [id (cond
                     (or (nil? a) (nil? b)) :not-run
                     (:refused b) :refused
                     (and (= (:status a) (:status b)) (= (:out a) (:out b))
                          (or (= 0 (:status a)) (= (error-of (first-line (:err a))) (error-of (first-line (:err b)))))) :same
                     :else :differs)
                b])]
    (doseq [[id v b] rows :when (not= v :same)]
      (println (name v) id (if (:refused b) (str ": " (:refused b)) "")))
    (let [fr (frequencies (map second rows))]
      (println (get fr :same 0) "of" (count rows) "programs: the compiled run the same as the interpreted one (status, stdout and an error's kind);"
               (get fr :refused 0) "refused," (get fr :differs 0) "differing," (get fr :not-run 0) "not run")
      (if (pos? (+ (get fr :differs 0) (get fr :not-run 0))) 1 0))))

(defn- cmd-divergences [[file]]
  (let [results (read-string (slurp (or file (results-file))))
        classes (load-classes)
        items (for [r results i (:items r)] (assoc i :class (class-of classes (:item i))))]
    (doseq [c classes :let [is (filter #(= (:id c) (:class %)) items)] :when (seq is)]
      (println (str (name (:id c)) " (" (name (:kind c)) ", " (count is) "): " (:title c)))
      (doseq [i is] (println "   " (:item i))))
    (summary (map (fn [r] (assoc r :items (filter #(= (:item %) (:item %)) (map (fn [i] (assoc i :class (class-of classes (:item i)))) (:items r))))) results))))

(defn -main [& [cmd & args]]
  (let [rc (case cmd
             "record-ref" (cmd-record-ref args)
             "judge" (binding [*aot* (boolean (some #{"--aot"} args))] (max (cmd-judge (remove #{"--aot"} args)) (duplicates-code)))
             "compare" (cmd-compare args)
             "own" (cmd-own args)
             "ref-test" (cmd-ref-test)
             "divergences" (binding [*aot* (boolean (some #{"--aot"} args))] (cmd-divergences (remove #{"--aot"} args)))
             (do (println "usage: arbace.scheme.check record-ref DIR | judge DIR [--record] [--aot] | compare SI-DIR AOT-DIR | divergences [--aot] [RESULTS] | ref-test") 2))]
    (shutdown-agents)
    (System/exit rc)))

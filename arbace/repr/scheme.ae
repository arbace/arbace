(ns arbace.repr.scheme
  "Command line of repr/scheme (doc/scheme/SPEC.md), run by bin/repr-scheme as -m arbace.repr.scheme VERB ...:

    read [--full] [-o DIR] FILE...
        each Scheme file (R6RS lexical syntax) to its Scheme forms: one datum a line, SPEC 3's spellings,
        to DIR/FILE.ae (default: standard output); an error is reported with its class and offset. --full (SPEC 11):
        the forms and the layer that prints the text back, a last line `#_(scm/layer {...})`.
    print [--full|--layout] FILE.ae...
        each forms file (data the Clojure reader reads) to Scheme text, Chez's `write` of each datum, one
        a line (:lines, SPEC 7); --layout: laid out as a person writes it (80 columns, SPEC 11); --full: the
        original text, from the forms and the layer `read --full` wrote.
    roundtrip [--record] DIR
        the corpora's files (DIR/files-ID.txt, made by prepare) and the probes (DIR/probes/*.ss): text to forms
        and layer to text byte for byte (:full), forms to the layout printer's text to forms equal and the
        layout idempotent (:lines). --record (SM9, a whole run): test/scheme/roundtrip-results.edn, a row
        [KEY RESULT REASON] a file (KEY as check-dumps': CORPUS/PATH, probe/ID), the print level's record (bin/reap).
    prepare DIR
        the check's inputs: the corpora's file lists and the probes' files under DIR.
    check-dumps [--record] [--partial] DIR
        Arbace's reading and writing of every file against Chez's dumps in DIR; judged by
        test/scheme/check-known.edn. --record also writes test/scheme/check-read-results.edn, a row [KEY RESULT
        REASON] a file, probe and scan, the read level's record (SM9, bin/reap); --partial (bin/repr-scheme check
        --corpus): the dumps of some corpora, a known entry judged only when its key was read, --record refused."
  (:require [arbace.string :as str]
            [arbace.repr.scheme.forms :as fm]
            [arbace.repr.scheme.read :as rd]
            [arbace.repr.scheme.print :as pr]
            [arbace.repr.scheme.full :as fu]
            [arbace.repr.scheme.layout :as lo]
            [arbace.repr.scheme.check :as ck]
            [arbace.scheme.controls :as ctl]))

(defn- root [] (or (System/getenv "ARBACE_ROOT") "."))

(defn- read-file [f]
  (let [{:keys [data error]} (rd/read-all (slurp f) {})]
    {:forms (mapv :form data) :error error}))

(defn- cmd-read [args0]
  (let [full (some #{"--full"} args0)
        args (remove #{"--full"} args0)
        out (when (= (first args) "-o") (second args))
        files (if out (drop 2 args) args)
        status (atom 0)]
    (doseq [f files]
      (let [{:keys [forms error layer]} (if full
                                          (let [{:keys [data error layer]} (fu/read-full (slurp f))]
                                            {:forms (mapv :form data) :error error :layer layer})
                                          (read-file f))
            text (if full
                   (fu/ae-text forms layer)
                   (str ";; " f "\n" (str/join "\n" (map pr-str forms)) "\n"))]
        (if out
          (let [o (java.io.File. (str out "/" f ".ae"))]
            (.mkdirs (.getParentFile o))
            (spit o text))
          (print text))
        (when error
          (reset! status 1)
          (binding [*out* *err*]
            (println (str f ": " (name (:class error)) " at " (:at error) ": " (:message error)))))))
    @status))

(defn- read-forms [^String text]
  (let [rdr (java.io.PushbackReader. (java.io.StringReader. text))]
    (loop [acc []]
      (let [x (read {:eof ::eof} rdr)] (if (= x ::eof) acc (recur (conj acc x)))))))

(defn- cmd-print [args0]
  (let [mode (cond (some #{"--full"} args0) :full (some #{"--layout"} args0) :layout :else :lines)
        args (remove #{"--full" "--layout"} args0)]
    (doseq [f args]
      (let [text (slurp f)]
        (case mode
          :full (let [[forms layer] (fu/parse-ae text)] (print (fu/print-full forms layer)))
          :layout (print (lo/layout-file (read-forms text)))
          (doseq [x (read-forms text)] (println (pr/write-form x)))))))
  0)

(defn- roundtrip-file
  "Both roundtrips of a text: nil when they hold, else a map of what failed. AGAINST (the negative controls, GTS81 (a)): the
  text the printed-back text is compared with, another case's, in place of the text itself."
  ([^String text] (roundtrip-file text text))
  ([^String text ^String against]
  (let [{:keys [data layer]} (fu/read-full text)
        forms (mapv :form data)
        ae (fu/ae-text forms layer)
        [forms2 layer2] (fu/parse-ae ae)
        back (fu/print-full forms2 layer2)
        full-ok (= back against)
        forms-ok (and (== (count forms) (count forms2)) (every? true? (map fm/tree= forms forms2)))
        lay (lo/layout-file forms)
        again (:data (rd/read-all lay {}))
        lines-ok (and (== (count forms) (count again)) (every? true? (map fm/tree= forms (map :form again))))
        idem (= lay (lo/layout-file (mapv :form again)))]
    (when-not (and full-ok forms-ok lines-ok idem)
      (cond-> {}
        (not full-ok) (assoc :full (let [k (count (take-while true? (map = back against)))] {:at k :want (subs against k (min (count against) (+ k 30))) :got (subs back k (min (count back) (+ k 30)))}))
        (not forms-ok) (assoc :forms true)
        (not lines-ok) (assoc :lines (some (fn [[i a b]] (when-not (fm/tree= a b) [i (pr-str a) (pr-str b)])) (map vector (range) forms (map :form again))))
        (not idem) (assoc :idempotent true))))))

;; GTS81 (a): the negative controls (test/scheme/controls.edn, arbace.scheme.controls). The read check's judge is
;; ck/compare-file, a text against the dump Chez made of it: a control judges the text of its :subject against the dump of its
;; :reference text (another case's), made here by Arbace's reader and writer as dump.ss's shape (:data [{:form :off :write}],
;; :error {:message :at}) since no Chez runs in a control, with the :edit-ed dump: {:write S} another `write` of the first
;; datum, {:chez-error MESSAGE} an error of Chez's at the end. The round trip's judge is roundtrip-file, the printed-back
;; text of :subject against :reference's text.
(defn- stand-in-dump [^String text edit]
  (let [{:keys [data]} (rd/read-all text {})
        d {:data (mapv (fn [x] {:form (:form x) :off (:off x) :write (pr/write-form (:form x))}) data)}
        d (if (:write edit) (assoc-in d [:data 0 :write] (:write edit)) d)]
    (cond-> d (:chez-error edit) (assoc :error {:message (:chez-error edit) :at (count text)}))))

(defn read-found [{:keys [subject reference edit]}]
  (if-let [d (ck/compare-file subject (stand-in-dump (or reference subject) edit))] [(pr-str d)] []))

(defn roundtrip-found [{:keys [subject reference]}]
  (if-let [r (roundtrip-file subject (or reference subject))] [(pr-str r)] []))

(defn- cmd-controls [fams]
  (apply max 0 (for [f (if (seq fams) (map keyword fams) [:read :roundtrip])]
                 (ctl/run f (case f :read read-found :roundtrip roundtrip-found)))))

(defn- write-results
  "SM9: a check's record for bin/reap (test/reap/cells.edn's :results reader): one row [KEY RESULT REASON] a line,
  sorted by KEY, under a header naming the command that wrote it."
  [^String file ^String what rows]
  (spit file
        (str ";; " what "; generated.\n"
             ";; A row [KEY RESULT REASON] a file (CORPUS/PATH; probe/ID; scan/KIND), RESULT :pass or another keyword, read by\n"
             ";; bin/reap (test/reap/cells.edn's Scheme row). Read with the Clojure reader.\n[\n"
             (str/join "" (for [[k r why] (sort-by first rows)] (str (pr-str [k r (str why)]) "\n")))
             "]\n"))
  (println (str "wrote " file " (" (count rows) " rows)")))

(defn- cmd-roundtrip
  "roundtrip [--record] [--only-list FILE] DIR. GT9: --only-list names the files to run, one key a line as test/scheme/roundtrip-results.edn
  writes them (CORPUS/PATH, probe/ID); no other file is read, and a failing file's key is printed as `FAILED KEY` for the gate's rotation."
  [args0]
  (let [oi (.indexOf ^java.util.List (vec args0) "--only-list")
        only (when (>= oi 0) (nth (vec args0) (inc oi)))
        args (if only (concat (take oi args0) (drop (+ oi 2) args0)) args0)
        record (some #{"--record"} args)
        _ (when (and only record) (println "roundtrip: --only-list is a partial run: no --record") (System/exit 2))
        dir (first (remove #{"--record"} args))
        files (concat (mapcat (fn [f] (str/split (slurp (str dir "/" f)) #"\n"))
                              (sort (filter #(.startsWith ^String % "files-") (.list (java.io.File. ^String dir)))))
                      (sort (map #(str dir "/probes/" %) (.list (java.io.File. (str dir "/probes"))))))
        files (remove empty? files)
        key-of (when (or record only)
                 (let [m (into {} (for [c (remove #(false? (:check %)) (:corpora (read-string (slurp (str (root) "/test/scheme/corpora.edn")))))
                                        [k p] (ck/corpus-files (root) c)] [p k]))
                       pd (str dir "/probes/")]
                   (fn [^String p] (or (m p) (when (.startsWith p pd) (str "probe/" (subs p (count pd) (- (count p) 3)))) p))))
        files (if only
                (let [want (set (remove empty? (str/split-lines (slurp only))))]
                  (when (empty? want) (println "roundtrip: --only-list names no file") (System/exit 2))
                  (filter #(contains? want (key-of %)) files))
                files)
        t0 (System/currentTimeMillis)
        bad (atom 0) bytes (atom 0) rows (atom [])]
    (doseq [f files]
      (let [text (slurp f)
            t (System/currentTimeMillis)
            r (roundtrip-file text)
            ms (- (System/currentTimeMillis) t)]
        (swap! bytes + (count (.getBytes ^String text "UTF-8")))
        (when (> ms 5000) (println (str "slow " f " " ms " ms")))
        (when r (swap! bad inc) (println "FAIL" f (pr-str r)) (when only (println (str "FAILED " (key-of f)))))
        (when record (swap! rows conj [(key-of f) (if r :fail :pass) (if r (pr-str r) "")]))))
    (when record
      (write-results (str (root) "/test/scheme/roundtrip-results.edn")
                     "repr/scheme's round trip (bin/repr-scheme roundtrip --record): :full byte for byte, the forms again,\n;; the layout read back and idempotent"
                     @rows))
    (println (str "roundtrip: " (count files) " files, " @bytes " bytes, failing " @bad ", " (quot (- (System/currentTimeMillis) t0) 1000) " s"))
    (max (if (zero? @bad) 0 1) (ctl/run :roundtrip roundtrip-found))))

(defn- cmd-prepare [[dir]]
  (let [r (ck/prepare (root) dir)]
    (println (pr-str r))
    0))

(def ^:private rule-bad (atom false))

(defn- cmd-check-dumps [args]
  (let [record (some #{"--record"} args)
        partial (some #{"--partial"} args)
        dir (first (remove #{"--record" "--partial"} args))
        {:keys [results scans]} (ck/check-dumps (root) dir)
        known-file (str (root) "/test/scheme/check-known.edn")
        known (if (.exists (java.io.File. known-file)) (read-string (slurp known-file)) {})
        n (count results)
        diffs (filter (comp some? val) results)
        ;; a partial run (--partial): a known entry is judged only when its key was read
        {:keys [unlisted gone]} (ck/judge results (if partial (select-keys known (keys results)) known))
        scan-bad (filter #(or (pos? (:n-only-mine %)) (pos? (:n-only-chez %))) scans)]
    (println (str "files and probes: " n ", equal to Chez: " (- n (count diffs))
                  ", differing: " (count diffs) " (listed " (- (count diffs) (count unlisted)) ")"))
    (let [r (ck/symbol-rule)]
      (println (str "symbol rule: " (:names r) " names, " (:bare r) " bare, bad " (pr-str (:bad r))))
      (when (seq (:bad r)) (reset! rule-bad true)))
    (doseq [s scans] (println (str "scan " (name (:scan s)) ": " (:ranges s) " ranges, only mine " (:n-only-mine s) ", only Chez " (:n-only-chez s))))
    (doseq [[k d] unlisted] (println (str "UNLISTED " (ck/diff-line k d))))
    (doseq [[k kn] gone] (println (str "GONE " k " " (pr-str kn))))
    (doseq [s scan-bad] (println (str "SCAN " (pr-str s))))
    (when (and record partial)
      (println "check-dumps: --record refused on a partial run (bin/repr-scheme check --corpus): the records are of every corpus")
      (reset! rule-bad true))
    (when (and record (not partial))
      (write-results (str (root) "/test/scheme/check-read-results.edn")
                     "repr/scheme's check against Chez 10.3.0 (bin/repr-scheme check --record): each corpus file and probe\n;; read and written as Chez reads and writes it, each scan's ranges"
                     (concat (for [[k d] results] (if d [k :known (ck/diff-line k d)] [k :pass ""]))
                             (for [s scans] [(str "scan/" (name (:scan s)))
                                             (if (or (pos? (:n-only-mine s)) (pos? (:n-only-chez s))) :fail :pass)
                                             (if (or (pos? (:n-only-mine s)) (pos? (:n-only-chez s))) (pr-str (dissoc s :scan)) "")])))
      (spit (str (root) "/test/scheme/check-known.edn")
            (str ";; Known differences between repr/scheme and Chez (bin/repr-scheme check --record): key -> {:kind ...}\n"
                 (pr-str (into (sorted-map) (map (fn [[k d]] [k (select-keys d [:kind :chez :mine])]) diffs)))
                 "\n")))
    (max (if (or (and (not record) (or (seq unlisted) (seq gone))) (seq scan-bad) @rule-bad) 1 0) (ctl/run :read read-found))))

(defn- spec-blocks
  "The fenced blocks of a markdown file: [[lang text] ...]."
  [text]
  (let [lines (str/split text #"\n")]
    (loop [ls lines in nil lang nil buf [] acc []]
      (if (empty? ls)
        acc
        (let [l (first ls)]
          (cond
            (and (nil? in) (.startsWith ^String l "```") (> (count l) 3)) (recur (rest ls) true (subs l 3) [] acc)
            (and in (= l "```")) (recur (rest ls) nil nil [] (conj acc [lang (str/join "\n" buf)]))
            in (recur (rest ls) in lang (conj buf l) acc)
            :else (recur (rest ls) nil nil [] acc)))))))

(defn- cmd-spec-check [[file]]
  (let [blocks (spec-blocks (slurp (or file "doc/scheme/SPEC.md")))
        pairs (loop [bs blocks acc []]
                (cond (empty? bs) acc
                      (and (= (ffirst bs) "scheme") (seq (rest bs)) (= (first (second bs)) "forms")) (recur (drop 2 bs) (conj acc [(second (first bs)) (second (second bs))]))
                      :else (recur (rest bs) acc)))
        forms-blocks (filter #(= (first %) "forms") blocks)
        bad (atom 0)]
    (doseq [[text forms] pairs]
      (let [{:keys [data error]} (rd/read-all text {})
            mine (mapv :form data)
            rdr (java.io.PushbackReader. (java.io.StringReader. forms))
            theirs (loop [acc []] (let [x (read {:eof ::eof} rdr)] (if (= x ::eof) acc (recur (conj acc x)))))
            ok (and (nil? error) (fm/tree= (apply list mine) (apply list theirs)))]
        (when-not ok
          (swap! bad inc)
          (println "SPEC MISMATCH" (pr-str text) "\n  reader:" (pr-str mine) (pr-str error) "\n  forms: " (pr-str theirs)))))
    (println (str "spec examples: " (count pairs) " scheme/forms pairs, " (count forms-blocks) " forms blocks all read, mismatches " @bad))
    (if (and (zero? @bad) (== (count pairs) (count forms-blocks))) 0 1)))

(defn -main [& args]
  (let [[verb & more] args
        status (case verb
                 "read" (cmd-read more)
                 "print" (cmd-print more)
                 "roundtrip" (cmd-roundtrip more)
                 "prepare" (cmd-prepare more)
                 "controls" (cmd-controls more)
                 "check-dumps" (cmd-check-dumps more)
                 "spec-check" (cmd-spec-check more)
                 (do (println "usage: -m arbace.repr.scheme read|print|prepare|check-dumps ...") 2))]
    (flush)
    (System/exit status)))

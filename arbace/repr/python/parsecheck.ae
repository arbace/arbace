(ns arbace.repr.python.parsecheck
  "repr/python's tree check (bin/repr-python parse-check; doc/python/PYTHON-SURVEY.md, \"As built: PY9b\"): every file of a
  corpus read by the native reader (arbace.repr.python.native/read-dump: the generated parser's tree written as the
  helper's dump) and compared with the helper's dump (tools/pydump/pydump.py tree, mode :lines: ast.parse's tree as
  Python forms), line for line; a file the helper's ast.parse rejects is judged by its (python/error ...) line, the
  class, message, position and text CPython gives (PY9's errors: the second pass, pegen_errors.c). The rest as the token check, after which this namespace is modelled:

  repr/python's token check (bin/repr-python lex-check; doc/python/PYTHON-SURVEY.md, \"As built: PY9a\"): every file of
  a corpus lexed by the native lexer (arbace.repr.python.lex/dump: the encoding, then tokenize's stream and the parser's,
  each token's type, positions and string, the error that ends a stream with CPython's class, message, position and
  text) and compared line for line with the helper's dump of the same file (tools/pydump/tokdump.py, CPython's C
  tokenizer through _tokenize.TokenizerIter). A file whose dumps differ passes when test/python/lex-check-known.edn
  lists it with its class; mutants (files of the corpora with tokens deleted, duplicated, swapped, inserted, and
  characters inserted: the error paths) are a corpus of their own, drawn by a seeded shuffle.

    check --corpus ID --base DIR --list FILE --ref DIR --out DIR --known FILE [--record] [--jobs N] [--controls FILE]
          [--expect FILE [--agreement]]
    mutants --out DIR --seed N --files N --per N --edits N --pool FILE...   (each pool file: BASE then RELs)

  --expect FILE (queue 240; the syntax-errors corpus, tools/pydump/syntax_cases.py --expect): each case's own verdict,
  the error its test in CPython's Lib/test expects (a doctest's exception line, _check_error's pattern, subclass and
  positions, test_exceptions' check's positions, assertAllRaise's pattern). A case the native reader rejects is judged
  by them alone (:own-pass or :own-fail, the record not read: the user's rule of 2026-11-07, a test's own verdict is a
  judge no toolchain made); a case it accepts, or one with none, by the record as before (the tree the helper's
  ast.parse gives: a compiler's error, which ast.parse accepts too). --agreement: the own-judged cases also judged by
  the record, the disagreements printed (the oracle tier's, and the measure of the expectations)

  --controls FILE (test/python/controls-read.edn; GTS81 (a), queue 212): the corpus's crossed pairs, the subject's
  source read natively and judged by judge-dump, this check's own comparison, against the reference's dump (named as
  the reference, so that only the content differs), which it must fail (arbace.repr.python.results/judge-controls); a
  control that passes or is not judged fails the check, with --record too (before anything is written)"
  (:require [arbace.repr.python.lex :as lex]
            [arbace.repr.python.native :as nv]
            [arbace.repr.python.results :as results]
            [arbace.string :as str])
  (:import [java.io File]))

(set! *warn-on-reflection* true)

(defn- parse-args [args with-value]
  (loop [as args opts {} pos []]
    (if (empty? as)
      {:opts opts :args pos}
      (let [[a & more] as]
        (cond
          (contains? with-value a) (recur (rest more) (assoc opts a (first more)) pos)
          (str/starts-with? a "--") (recur more (assoc opts a true) pos)
          :else (recur more opts (conj pos a)))))))

(defn- read-bytes ^bytes [^String path] (java.nio.file.Files/readAllBytes (.toPath (File. path))))

(defn- spit-mk [^String path text]
  (let [f (File. path)] (.mkdirs (.getParentFile f)) (spit f text)))

(defn- lines-of [^String s] (vec (.split s "\n" -1)))

(defn- first-diff
  "The first line where the two dumps differ: [line-number ref mine], or nil"
  [^String ref ^String mine]
  (when (not= ref mine)
    (let [a (lines-of ref) b (lines-of mine) n (max (count a) (count b))]
      (loop [i 0]
        (when (< i n)
          (let [x (get a i) y (get b i)]
            (if (= x y) (recur (inc i)) [(inc i) (or x "<none>") (or y "<none>")])))))))

(def ^:dynamic *full* false)

;; ---- the own verdict (queue 240) ----

(def ^:dynamic *expects* {})

(defn- read-expects [f]
  (if (and f (.exists (File. ^String f)))
    (group-by :case (map read-string (remove str/blank? (str/split-lines (slurp f)))))
    {}))

(defn- ellipsis-match
  "doctest's _ellipsis_match: WANT's pieces between \"...\" found in GOT in order, the first at its start, the last at its end"
  [^String want ^String got]
  (let [ws (vec (.split want "\\.\\.\\." -1))]
    (if (= 1 (count ws))
      (= want got)
      (let [head (first ws) tail (peek ws)]
        (and (str/starts-with? got head) (str/ends-with? got tail) (>= (count got) (+ (count head) (count tail)))
             (loop [i (count head) ps (subvec ws 1 (dec (count ws)))]
               (if (empty? ps)
                 (<= i (- (count got) (count tail)))
                 (let [j (.indexOf got ^String (first ps) (int i))]
                   (and (>= j 0) (recur (+ j (count (first ps))) (rest ps)))))))))))

(def ^:private kinds {"SyntaxError" #{"SyntaxError" "IndentationError" "TabError"}
                      "IndentationError" #{"IndentationError" "TabError"} "TabError" #{"TabError"}})

(defn- basename [^String f] (let [i (.lastIndexOf f "/")] (if (neg? i) f (subs f (inc i)))))

(defn- error-form
  "The native dump's error, {:kind :msg :pos [lineno offset end-lineno end-offset]}, or nil when it is a tree"
  [^String mine]
  (when (and (string? mine) (str/starts-with? mine "(python/error "))
    (let [[_ kind msg & opts] (read-string mine) o (apply hash-map opts)]
      {:kind (str kind) :msg msg :pos (:pos o)})))

(defn- expect-fails
  "Why the error ERR does not meet the expectation E, nil when it does; :undecided when E cannot be judged here (a
  pattern Arbace's regexes do not take)"
  [{:keys [kind msg pos]} e]
  (let [[l o el eo] pos
        str-err (str msg (when l (str " (" (basename (:filename e "<string>")) ", line " l ")")))
        posf (fn [k v] (when (and (contains? e k) (not= (get e k) v)) (str (name k) " " v ", the test expects " (get e k))))]
    (or (when (and (:kind e) (not= (:kind e) kind)) (str kind ", the test expects " (:kind e)))
        (when-not (contains? kinds kind) (str kind " is not a SyntaxError"))
        (when (and (:subclass e) (not (contains? (get kinds (:subclass e) #{}) kind))) (str kind " is not a " (:subclass e)))
        (when (and (contains? e :exact) (not (:ignore-detail e))
                   (not (if (:ellipsis e) (ellipsis-match (:exact e) msg) (= (:exact e) msg))))
          (str "the message " (pr-str msg) ", the test expects " (pr-str (:exact e))))
        (when (contains? e :search)
          (let [re (try (re-pattern (:search e)) (catch Throwable _ nil))]
            (cond (nil? re) :undecided
                  (not (re-find re str-err)) (str (pr-str str-err) " does not contain " (pr-str (:search e))))))
        (posf :lineno l) (posf :offset o) (posf :end-lineno el) (posf :end-offset eo))))

;; ---- traceback's keyword typo (py-design-1122): Lib/traceback.py's TracebackException._find_keyword_typos of CPython
;; 3.14.10, which format_exception_only (a doctest's exception line) runs over a SyntaxError whose message is the
;; parser's "invalid syntax": a NAME token of the failing statement replaced by a keyword close to it (Python/
;; suggestions.c's _Py_CalculateSuggestions, then difflib.get_close_matches), the first replacement codeop.compile_command
;; accepts (mode exec, PyCF_ONLY_AST) giving "invalid syntax. Did you mean 'KW'?". Ported, no code vendored.

(def ^:private kwlist
  ;; keyword.kwlist: the grammar's keywords sorted (Tools/build/generate_keyword.py), from the reader's own grammar
  (delay (vec (sort (keys (:keywords (nv/grammar)))))))

(defn- utf8 ^bytes [^String s] (.getBytes s "UTF-8"))

(defn- subst-cost
  "suggestions.c's substitution_cost of two bytes"
  ^long [^long a ^long b]
  (let [lo (fn ^long [^long c] (if (and (<= 65 c) (<= c 90)) (+ c 32) c))]
    (cond (not= (bit-and a 31) (bit-and b 31)) 2
          (== a b) 0
          (== (lo a) (lo b)) 1
          :else 2)))

(defn- levenshtein
  "suggestions.c's levenshtein_distance over UTF-8 bytes (MOVE_COST 2, CASE_COST 1, MAX_STRING_SIZE 40)"
  ^long [^bytes a0 ^bytes b0 ^long max-cost]
  (let [a (vec (map #(bit-and (long %) 0xff) a0)) b (vec (map #(bit-and (long %) 0xff) b0))
        [a b] (loop [a a b b] (if (and (seq a) (seq b) (== (long (first a)) (long (first b)))) (recur (subvec a 1) (subvec b 1)) [a b]))
        [a b] (loop [a a b b] (if (and (seq a) (seq b) (== (long (peek a)) (long (peek b)))) (recur (pop a) (pop b)) [a b]))
        na (count a) nb (count b)]
    (cond
      (or (zero? na) (zero? nb)) (* (+ na nb) 2)
      (or (> na 40) (> nb 40)) (inc max-cost)
      :else
      (let [[a b] (if (< nb na) [b a] [a b]) na (count a) nb (count b)]
        (if (> (* (- nb na) 2) max-cost)
          (inc max-cost)
          (let [buf (long-array (for [i (range na)] (* 2 (inc i))))]
            (loop [bi 0 result 0]
              (if (>= bi nb)
                result
                (let [code (long (nth b bi))
                      [result minimum]
                      (loop [i 0 distance (* bi 2) result (* bi 2) minimum Long/MAX_VALUE]
                        (if (>= i na)
                          [result minimum]
                          (let [substitute (+ distance (subst-cost code (long (nth a i))))
                                distance (aget buf i)
                                r (min (+ (min result distance) 2) substitute)]
                            (aset buf i r)
                            (recur (inc i) distance r (min minimum r)))))]
                  (if (> (long minimum) max-cost)
                    (inc max-cost)
                    (recur (inc bi) (long result))))))))))))

(defn- calculate-suggestion
  "_suggestions._generate_suggestions(candidates, name): suggestions.c's _Py_CalculateSuggestions"
  [candidates ^String name]
  (let [nb (utf8 name)]
    (loop [cs candidates best nil best-d Long/MAX_VALUE]
      (if-let [item (first cs)]
        (if (= item name)
          (recur (rest cs) best best-d)
          (let [ib (utf8 item)
                maxd (min (quot (* (+ (alength nb) (alength ib) 3) 2) 6) (dec best-d))
                d (levenshtein nb ib maxd)]
            (if (or (> d maxd) (and best (>= d best-d)))
              (recur (rest cs) best best-d)
              (recur (rest cs) item d))))
        best))))

(defn- matching-total
  "The sizes of difflib.SequenceMatcher(None, a, b).get_matching_blocks() summed: find_longest_match's longest block
  (the earliest in a, then in b; no junk, and b shorter than 200 has no popular elements), then the same on each side"
  ^long [^String a ^String b]
  (let [b2j (reduce (fn [m [j c]] (update m c (fnil conj []) j)) {} (map-indexed vector b))
        longest (fn [alo ahi blo bhi]
                  (loop [i alo j2len {} bi alo bj blo bs 0]
                    (if (>= i ahi)
                      [bi bj bs]
                      (let [[nj2 bi bj bs]
                            (reduce (fn [[nj2 bi bj bs] j]
                                      (if (or (< j blo) (>= j bhi))
                                        [nj2 bi bj bs]
                                        (let [k (inc (long (get j2len (dec j) 0)))]
                                          (if (> k bs) [(assoc nj2 j k) (inc (- i k)) (inc (- j k)) k] [(assoc nj2 j k) bi bj bs]))))
                                    [{} bi bj bs] (get b2j (.charAt a (int i)) []))]
                        (recur (inc i) nj2 (long bi) (long bj) (long bs))))))
        total (fn total [alo ahi blo bhi]
                (let [[i j k] (longest alo ahi blo bhi)]
                  (if (zero? (long k))
                    0
                    (+ (long k)
                       (if (and (< alo i) (< blo j)) (long (total alo i blo j)) 0)
                       (if (and (< (+ i k) ahi) (< (+ j k) bhi)) (long (total (+ i k) ahi (+ j k) bhi)) 0)))))]
    (total 0 (count a) 0 (count b))))

(defn- close-matches
  "difflib.get_close_matches(word, possibilities, n, cutoff): the ratios 2M/T of SequenceMatcher(None, x, word) at least
  cutoff, the n largest (score, x) pairs, largest first"
  [^String word possibilities n cutoff]
  (->> (for [x possibilities
             :let [t (+ (count x) (count word)) r (if (pos? t) (/ (* 2.0 (matching-total x word)) t) 1.0)]
             :when (>= r (double cutoff))]
         [r x])
       (sort (fn [[r1 x1] [r2 x2]] (let [c (compare r2 r1)] (if (zero? c) (compare x2 x1) c))))
       (take n)
       (mapv second)))

(defn- py-splitlines
  "str.splitlines(): the lines without their ends (\\n, \\r, \\r\\n, \\v, \\f, \\x1c-\\x1e, \\x85, \\u2028, \\u2029)"
  [^String s]
  (let [n (.length s)]
    (loop [i 0 a 0 out []]
      (if (>= i n)
        (if (< a n) (conj out (subs s a n)) out)
        (let [c (.charAt s i)]
          (cond
            (and (= c \return) (< (inc i) n) (= (.charAt s (inc i)) \newline)) (recur (+ i 2) (+ i 2) (conj out (subs s a i)))
            (#{10 13 11 12 28 29 30 0x85 0x2028 0x2029} (int c)) (recur (inc i) (inc i) (conj out (subs s a i)))
            :else (recur (inc i) a out)))))))

(defn- py-space? [^String l] (and (seq l) (every? #(let [c (int %)] (or (Character/isWhitespace c) (== c 0x85) (== c 0xa0))) l)))

(defn- dedent
  "textwrap.dedent of 3.14.10: the margin the smallest and largest non-blank lines share in spaces and tabs, blank lines
  emptied"
  [^String text]
  (let [lines (vec (.split text "\n" -1))
        nb (filter #(and (seq %) (not (py-space? %))) lines)
        l1 (if (seq nb) (reduce #(if (neg? (compare %2 %1)) %2 %1) nb) "")
        l2 (if (seq nb) (reduce #(if (pos? (compare %2 %1)) %2 %1) nb) "")
        margin (loop [m 0]
                 (cond (>= m (count l1)) (max 0 (dec m))
                       (or (not= (.charAt ^String l1 m) (.charAt ^String l2 m)) (not (#{\space \tab} (.charAt ^String l1 m)))) m
                       :else (recur (inc m))))]
    (str/join "\n" (for [l lines] (if (py-space? l) "" (subs l (min margin (count l))))))))

(defn- full-compile-ok?
  "compile(CODE, '<input>', 'exec') (flags 0: the code object, symtable and code generation too, by pyi's own compiler,
  arbace.python.run's compile-uncached) raises no SyntaxError; another error ends the search"
  [^String code]
  (require 'arbace.python 'arbace.python.run)
  (let [r (str (@(ns-resolve 'arbace.python.run 'compile-uncached) "exec" code))
        r (if (str/starts-with? r "\u0001") (subs r (inc (.indexOf r "\u0003"))) r)]
    (cond (re-find #"^(SyntaxError|IndentationError|TabError): " r) false
          (re-find #"^[A-Z][A-Za-z]*(Error|Exception): " r) (throw (ex-info "not a syntax error" {:abort true}))
          :else true)))

(defn- compile-command-ok?
  "codeop.compile_command(code, symbol=\"exec\", flags=PyCF_ONLY_AST) returns (a tree, or None for incomplete input)
  rather than raising SyntaxError (Lib/codeop.py's _maybe_compile): when the code parses (ONLY_AST, the incomplete
  input flags), the final compile (flags 0, the whole compiler) decides; when it does not, code + newline parsing or
  being incomplete input returns None, else the final compile raises. A non-syntax error ends the search (traceback's
  suppress(Exception))"
  [^String code]
  (let [blank? (every? (fn [l] (let [l (str/trim l)] (or (empty? l) (= \# (first l))))) (.split code "\n" -1))
        code (if blank? "pass" code)
        attempt (fn [s] (try (nv/parse-source s :exec {:incomplete true}) :ok
                             (catch arbace.lang.ExceptionInfo e
                               (if-let [[cls] (:python-error (ex-data e))]
                                 (if (or (contains? kinds cls) (= cls "IncompleteInputError")) cls (throw (ex-info "not a syntax error" {:abort true})))
                                 (throw e)))))]
    (if (= :ok (attempt code))
      (full-compile-ok? code)
      (contains? #{:ok "IncompleteInputError"} (attempt (str code "\n"))))))

(defn- keyword-typo
  "_find_keyword_typos over the error ERR of SOURCE ({:kind :msg :pos :text :metadata}): ERR with the message
  \"invalid syntax. Did you mean 'KW'?\" when a keyword in place of a NAME token of the failing statement makes it
  compile, else ERR"
  [{:keys [msg pos text metadata] :as err} ^String source]
  (or (when (and (string? text) metadata
                 (or (= msg "invalid syntax") (str/includes? (str msg) "Perhaps you forgot a comma")))
        (try
          (let [line (long (first metadata))
                end-line (long (or (first pos) 0))
                lines (py-splitlines source)
                code (dedent (str/join "\n" (subvec lines (min (count lines) (if (pos? line) (dec line) 0))
                                                    (max (min (count lines) (if (pos? line) (dec line) 0)) (min end-line (count lines))))))]
            (when (<= (count code) 1024)
              (let [error-lines (py-splitlines code)
                    toks (:tokens (lex/stream code true))]
                (loop [ts toks left 10]
                  (when-let [[type s sl sc _ ec] (first ts)]
                    (if (or (not= (long type) (long lex/NAME)) (some #{s} @kwlist))
                      (recur (rest ts) left)
                      (let [left (dec left)]
                        (when-not (neg? left)
                          (let [sugg (calculate-suggestion @kwlist s)
                                ms (take 3 (concat (when sugg [sugg]) (close-matches s @kwlist 3 0.5)))
                                hit (some (fn [kw]
                                            (when (and (seq kw) (not= kw s) (<= (long sl) (count error-lines)))
                                              (let [l ^String (nth error-lines (dec (long sl)))
                                                    cps (vec (.toArray (.codePoints l)))
                                                    nl (str (String. (int-array (subvec cps 0 (min (count cps) (long sc)))) 0 (min (count cps) (long sc)))
                                                            kw
                                                            (let [r (subvec cps (min (count cps) (long ec)))] (String. (int-array r) 0 (count r))))
                                                    c (str/join "\n" (assoc error-lines (dec (long sl)) nl))]
                                                (when (compile-command-ok? c) kw))))
                                          ms)]
                            (if hit
                              (assoc err :msg (str "invalid syntax. Did you mean '" hit "'?"))
                              (recur (rest ts) left)))))))))))
          (catch arbace.lang.ExceptionInfo e (if (:abort (ex-data e)) nil (throw e)))))
      err))

(defn- source-error
  "The error compile(SOURCE, F, MODE) raises in the case's own mode (\"eval\": eval()'s str, its leading spaces and tabs
  stripped; \"single\": a doctest's example), as error-form gives it with :text and :metadata, or :accepted"
  [^String source mode]
  (let [m (case mode "eval" :eval "single" :single :exec)
        s (if (= m :eval) (str/replace source #"^[ \t]+" "") source)]
    (try (nv/parse-source s m {}) :accepted
         (catch arbace.lang.ExceptionInfo e
           (if-let [[cls msg l o el eo t] (:python-error (ex-data e))]
             {:kind (str cls) :msg msg :pos (when (some? l) [l o el eo]) :text t :metadata (:metadata (ex-data e))}
             (throw e))))))

(defn- case-error
  "The error the expectation E is judged on: the file's read (mode exec, read-dump's MINE) for exec and no mode, else
  the source parsed in E's mode; a doctest's line format_exception_only's (traceback's keyword typo); nil when accepted"
  [e mine-err ^String source]
  (let [err (if (and source (#{"eval" "single"} (:mode e)))
              (let [r (source-error source (:mode e))] (when (map? r) r))
              mine-err)]
    (when err
      (if (and source (= "doctest" (:helper e)))
        (keyword-typo (if (and (:metadata err) (contains? err :text)) err
                          (let [r (source-error source (or (:mode e) "exec"))] (if (map? r) r err)))
                      (-> source (str/replace "\r\n" "\n") (str/replace "\r" "\n")))
        err))))

(defn- own-verdict
  "[status detail] by the case's own verdict (:own-pass, :own-fail WHY), or nil when it is judged by the record: the
  native reader accepts the case, the case has no expectation, or one cannot be judged here. Each expectation is judged
  on the error of its own mode (py-design-1122: assertAllRaise's eval, a doctest's single; exec the file's read), a
  doctest's with traceback's keyword typo"
  [rel mine & [source]]
  (when-let [es (seq (get *expects* rel))]
    (when-let [err (error-form mine)]
      (let [why (map #(if-let [ce (case-error % err source)] (expect-fails ce %) (str "accepted in mode " (:mode %))) es)]
        (cond (some #{:undecided} why) nil
              (every? nil? why) [:own-pass nil]
              :else [:own-fail (first (remove nil? why))])))))

(defn- judge-dump
  "[rel status detail]: :equal, :differ [line ref mine], :crash message, :no-ref: the source SRC's native dump (named
  REL) against the reference dump REF; the differing dumps kept under OUT/diff/REL"
  [^String src ^String ref-path ^String out rel]
  (let [rf (File. ref-path)
        own (when (seq *expects*)
              (let [bs (read-bytes src)]
                (own-verdict rel (try (nv/read-dump bs rel *full*) (catch Throwable _ nil))
                             (try (let [d (java.nio.charset.StandardCharsets/UTF_8)
                                        dc (doto (.newDecoder d)
                                             (.onMalformedInput java.nio.charset.CodingErrorAction/REPORT)
                                             (.onUnmappableCharacter java.nio.charset.CodingErrorAction/REPORT))]
                                    (str (.decode dc (java.nio.ByteBuffer/wrap bs))))
                                  (catch Throwable _ nil)))))]
    (cond
      own (into [rel] own)
      (not (.exists rf))
      [rel :no-ref nil]
      :else
      (let [ref (slurp rf)
            mine (try (nv/read-dump (read-bytes src) rel *full*)
                      (catch Throwable e
                        (if-let [c (:class (ex-data e))] {:refused c :message (.getMessage e)} (str "!Crash\t" (.getMessage e)))))]
        (cond
          (map? mine) [rel :refused (:refused mine)]
          (= ref mine)
          [rel :equal nil]
          (str/starts-with? ref "(python/error HelperError")
          [rel :refused :helper-error]
          :else
          (let [d (first-diff ref mine)]
            (spit-mk (str out "/diff/" rel ".ref") ref)
            (spit-mk (str out "/diff/" rel ".mine") mine)
            (if (str/starts-with? mine "!Crash")
              [rel :crash (subs mine 7 (min (count mine) 300))]
              [rel :differ d])))))))

(defn- one-file [^String base ^String ref-dir ^String out rel]
  (judge-dump (str base "/" rel) (str ref-dir "/" rel ".ae") out rel))

(defn- run-files [base ref-dir out rels jobs]
  (let [parts (partition-all (max 1 (long (Math/ceil (/ (count rels) (double jobs))))) rels)
        full *full* ex *expects*
        fs (mapv (fn [part] (future (binding [*full* full *expects* ex] (mapv #(one-file base ref-dir out %) part)))) parts)]
    (vec (mapcat deref fs))))

(defn- read-known [^String f]
  (if (.exists (File. f)) (read-string (slurp f)) {:classes {} :lines {} :full {}}))

(defn- write-known [^String f known]
  (let [k (fn [m] (into (sorted-map) m))]
    (spit-mk f
             (str ";; The files of repr/python's tree check (bin/repr-python parse-check; doc/python/PYTHON-SURVEY.md, \"As built: PY9b\")\n"
                  ";; whose native dump differs from the helper's (tools/pydump/pydump.py tree), by corpus, each with its class (:classes:\n"
                  ";; what it is and the decision it rests on) and the first differing line. Written by --record, the classes kept: a\n"
                  ";; file of no class is printed and not written (the run exits 3). Read with the Clojure reader.\n"
                  "{:classes\n {"
                  (str/join "\n  " (for [[c v] (k (:classes known))] (str (pr-str c) "\n  " (pr-str (into (sorted-map) v)))))
                  "}"
                  (str/join (for [sec [:lines :full] :when (contains? known sec)]
                              (str "\n " sec "\n {"
                                   (str/join "\n  " (for [[c files] (k (get known sec))]
                                                      (str (pr-str c) "\n  {"
                                                           (str/join "\n   " (for [[f v] (k files)] (str (pr-str f) " " (pr-str (into (sorted-map) v)))))
                                                           "}")))
                                   "}")))
                  "}\n"))))

(def ^:private rule-classes
  {:helper-error
   {:what "the helper itself fails on the file (its tree --full: the token weave's Source splits lines at a lone CR, tokenize does not, so the text between two tokens is not white space): no reference to judge by"
    :decided "the helper's, classed by rule (a mutant with a lone CR inserted); the native reader is not judged on such a file"}
   :charset {:what "the file is in an encoding Arbace's runtime has no charset for (KOI8-R: Lib/test's module_koi8_r.py; the coding specs cp1251 and iso8859-7 of test_exceptions' cases), so the lexer has no text to read: the decoder's refusal"
             :decided "by design (queue 176's DECISION (a), the user, 2026-11-03): jrt's charsets are the root/English set the locales decision of 2026-10-11 chose; classed by rule, as roundtrip --text's :charset"}})

(declare do-check*)
(defn- do-check [{:keys [opts]}]
  (binding [*full* (boolean (get opts "--full")) *expects* (read-expects (get opts "--expect"))]
    (do-check* opts)))

(defn- do-check* [opts]
  (let [corpus (keyword (get opts "--corpus"))
        base (get opts "--base") ref-dir (get opts "--ref") out (get opts "--out")
        known-file (get opts "--known")
        jobs (Long/parseLong (get opts "--jobs" "3"))
        rels (vec (remove str/blank? (str/split-lines (slurp (get opts "--list")))))
        t0 (System/nanoTime)
        res (run-files base ref-dir out rels jobs)
        secs (/ (- (System/nanoTime) t0) 1e9)
        known (read-known known-file)
        section (if *full* :full :lines)
        mine (get-in known [section corpus] {})
        pass? #(contains? #{:equal :own-pass} (second %))
        bad (remove pass? res)
        freq (frequencies (map second res))
        _ (spit-mk (str out "/files.tsv")
               (str/join (for [[r s d] res] (str r "\t" (name s) "\t" (str/replace (pr-str d) #"[\t\n]" " ") "\n"))))
        _ (println (format "parse-check %s: %d files in %.1f s: equal %d, differ %d, refused %d, crash %d, no reference %d%s"
                       (name corpus) (count res) secs (get freq :equal 0) (get freq :differ 0) (get freq :refused 0)
                       (get freq :crash 0) (get freq :no-ref 0)
                       (if (seq *expects*)
                         (format "; by their own verdict %d (pass %d, fail %d), by the record %d"
                                 (+ (get freq :own-pass 0) (get freq :own-fail 0)) (get freq :own-pass 0) (get freq :own-fail 0)
                                 (- (count res) (get freq :own-pass 0) (get freq :own-fail 0)))
                         "")))
        _ (when (and (seq *expects*) (get opts "--agreement"))
            ;; the own-judged cases judged again by the record (not the pass rule: the measure of the expectations)
            (let [by-rec (binding [*expects* {}]
                           (into {} (for [[r st _] res :when (#{:own-pass :own-fail} st)]
                                      [r (second (judge-dump (str base "/" r) (str ref-dir "/" r ".ae") (str out "/agreement") r))])))
                  kinds (frequencies (for [[r st _] res :when (by-rec r)] [st (by-rec r)]))]
              (println (str "parse-check " (name corpus) ": agreement of the own verdict with the record: "
                            (str/join ", " (for [[[o r] n] (sort-by str kinds)] (str (name o) " / record " (name r) " " n)))))
              (doseq [[r st d] res :when (and (by-rec r) (not= (= st :own-pass) (= (by-rec r) :equal)))]
                (println (str "  DISAGREE " r ": " (name st) (when d (str " " d)) ", record " (name (by-rec r)))))))
        ctl-bad (long (results/judge-controls
                   (str "parse-check" (when *full* " --full")) corpus (results/read-controls (get opts "--controls") corpus) (set rels)
                   (set (keep (fn [[r st _]] (when (#{:equal :own-pass} st) r)) res))
                   (fn [subject reference]
                     ;; the check's own judge: the subject's native dump judged as the reference, by the reference's
                     ;; own verdict when it has one and the subject is an error, else by the reference's record
                     (let [[_ st d] (judge-dump (str base "/" subject) (str ref-dir "/" reference ".ae") (str out "/control") reference)]
                       (case st
                         :equal :pass
                         :own-pass :pass
                         :own-fail [:fail (str "by the reference's own verdict: " d)]
                         :differ [:fail (str "the dumps differ at line " (first d))]
                         [:not-judged (str (name st) (when d (str " " (pr-str d))))])))))]
    (when (pos? ctl-bad) (println (str "parse-check " (name corpus) ": " ctl-bad " negative control(s) failed")))
    (when (and (get opts "--record") (pos? ctl-bad)) (System/exit 1))
    (if (get opts "--record")
      (let [new (into {} (for [[r s d] bad
                               :let [c (if (= s :refused) d (:class (get mine r)))] :when c]
                           [r (cond-> {:class c} (= s :differ) (assoc :line (first d)) (= s :own-fail) (assoc :line :own))]))
            unclassed (remove #(contains? new (first %)) bad)]
        (doseq [[r s d] unclassed] (println "NO CLASS" r (name s) (pr-str d)))
        (when-let [rf (get opts "--results-file")]
          (results/write :parse rf corpus (for [[r s d] res]
                                         [r (cond (#{:equal :own-pass} s) :pass (contains? new r) :known :else :fail)
                                          (str (name s) (when d (str " " (pr-str d))))])
                         (if *full* :full :lines) (boolean (get opts "--partial"))))
        (write-known known-file (-> known
                                    ;; a partial run (--partial: an --only list's) keeps the entries of the files not run
                                    (assoc-in [section corpus] (if (get opts "--partial") (merge (apply dissoc mine rels) new) new))
                                    (update :classes #(merge (select-keys rule-classes (set (map :class (vals new)))) %))))
        (System/exit (if (seq unclassed) 3 0)))
      (let [problems (concat
                       (for [[r s d] bad
                             :let [k (get mine r)]
                             :when (or (nil? k) (not (contains? (:classes known) (:class k)))
                                       (and (= s :refused) (not= d (:class k)))
                                       (and (= s :differ) (not= (:line k) (first d)))
                                       (and (= s :own-fail) (not= :own (:line k))))]
                         [r (str "UNEXPECTED " r " " (name s) " " (pr-str d) (when k (str " (known: " (pr-str k) ")")))])
                       (let [badset (set (map first bad)) ran (set rels)]
                         ;; a case known by its own verdict (:line :own) is equal by the record, which is what judging by the
                         ;; record sees (the agreement's measure): not gone there; judged by their own verdicts it is
                         (for [[r k] mine :when (and (ran r) (not (badset r))
                                                     (not (and (empty? *expects*) (= :own (:line k)))))]
                           [r (str "GONE (known as " (:class k) ", equal now) " r)])))]
        (doseq [[_ p] (take 50 problems)] (println p))
        (doseq [[r p] problems] (results/print-fail corpus r p))
        (when (> (count problems) 50) (println "..." (- (count problems) 50) "more"))
        (System/exit (if (and (empty? problems) (zero? ctl-bad)) 0 1))))))

;; ---- mutants ----

(defn- cps ^ints [^String s]
  (let [n (.codePointCount s 0 (.length s)) a (int-array n)]
    (loop [i 0 j 0] (when (< i (.length s)) (let [c (.codePointAt s i)] (aset a j c) (recur (+ i (Character/charCount c)) (inc j)))))
    a))

(def ^:private inserts ["'" "\"" "\t" "(" ")" "[" "}" "{" "\\" "f\"" "t'" "\"\"\"" "\n" " " "é" "$" "0" "0x" "1e" "#" "\r" "!" ":" "　"])

(defn mutate
  "`text` with `edits` random edits (tokens deleted, duplicated, swapped with the next, a random token's text inserted,
  or one of a few characters inserted at a token's start), nil when it has too few tokens"
  [^String text ^java.util.Random rnd ^long edits]
  (let [a (cps text)
        line-starts (let [v (java.util.ArrayList.)]
                      (.add v (long 0))
                      (dotimes [i (alength a)] (when (== (aget a i) 10) (.add v (long (inc i)))))
                      v)
        toks (:tokens (lex/stream text true))
        abs (fn [l c] (when (<= 1 (long l) (.size line-starts)) (+ (long (.get line-starts (dec (long l)))) (long c))))
        cand (vec (for [[t s sl sc el ec] toks
                        :when (and (pos? (count s)) (not (#{lex/NEWLINE lex/NL lex/INDENT lex/DEDENT lex/ENDMARKER} t)) (= sl el))
                        :let [o (abs sl sc)] :when o]
                    [o (abs el ec) s]))
        n (count cand)]
    (when (> n 8)
      (let [picks (sort (distinct (repeatedly edits #(.nextInt rnd (dec n)))))
            eds (for [i picks]
                  (let [[o e s] (nth cand i) [o2 e2 s2] (nth cand (inc i))]
                    (case (.nextInt rnd 5)
                      0 [o e ""]
                      1 [o e (str s " " s)]
                      2 (if (<= e o2) [o e2 (str s2 (String. a (int e) (int (- o2 e))) s)] [o e s])
                      3 [o o (str (nth (nth cand (.nextInt rnd n)) 2) " ")]
                      [o o (nth inserts (.nextInt rnd (count inserts)))])))
            eds (loop [eds (sort-by first eds) out [] end -1]
                  (if-let [[o e :as x] (first eds)]
                    (if (>= (long o) end) (recur (rest eds) (conj out x) (long e)) (recur (rest eds) out end))
                    out))]
        (let [sb (StringBuilder.)]
          (loop [i 0 eds eds]
            (if-let [[o e r] (first eds)]
              (do (.append sb (String. a (int i) (int (- (long o) i)))) (.append sb ^String r) (recur (long e) (rest eds)))
              (.append sb (String. a (int i) (int (- (alength a) i))))))
          (str sb))))))

(defn- do-mutants [{:keys [opts args]}]
  (let [out (get opts "--out")
        seed (Long/parseLong (get opts "--seed" "26"))
        nfiles (Long/parseLong (get opts "--files" "2000"))
        per (Long/parseLong (get opts "--per" "2"))
        edits (Long/parseLong (get opts "--edits" "3"))
        pool (vec (for [pf args
                        :let [[base & rels] (remove str/blank? (str/split-lines (slurp pf)))]
                        r rels
                        :let [p (str base "/" r)]
                        :when (< (.length (File. ^String p)) 65536)]
                    p))
        rnd (java.util.Random. seed)
        shuffled (let [l (java.util.ArrayList. ^java.util.Collection pool)] (java.util.Collections/shuffle l rnd) (vec l))
        picked (take nfiles shuffled)
        made (atom [])]
    (doseq [[i p] (map-indexed vector picked)
            j (range per)]
      (let [{:keys [text error encoding]} (try (lex/decode-source (read-bytes p)) (catch Throwable _ nil))]
        (when (and text (= "utf-8" encoding))
          (when-let [m (mutate text rnd edits)]
            (let [nm (format "m%05d-%d.py" i j)]
              (spit-mk (str out "/src/" nm) m)
              (swap! made conj [nm p]))))))
    (spit-mk (str out "/list") (str/join (for [[nm _] @made] (str nm "\n"))))
    (spit-mk (str out "/from.tsv") (str/join (for [[nm p] @made] (str nm "\t" p "\n"))))
    (println (str "mutants: " (count @made) " mutants of " (count picked) " files (seed " seed ", " per " mutants of " edits " edits each)"))))

(defn- do-dump
  "dump --base DIR --list FILE --out DIR [--full]: each file's native dump as OUT/REL.ae (bin/repr-python read --reader
  native), and a TSV REL STATUS on stdout"
  [{:keys [opts]}]
  (let [base (get opts "--base") out (get opts "--out") full (boolean (get opts "--full"))]
    (doseq [rel (remove str/blank? (str/split-lines (slurp (get opts "--list"))))]
      (let [text (try (nv/read-dump (read-bytes (str base "/" rel)) rel full)
                      (catch arbace.lang.ExceptionInfo e (if (:class (ex-data e)) e (throw e))))]
        (if (string? text)
          (do (spit-mk (str out "/" rel ".ae") text)
              (println (str rel "\t" (if (str/starts-with? text "(python/error") "error" "ok"))))
          ;; a refusal (the runtime's charsets): no dump
          (println (str rel "\trefused " (name (:class (ex-data text))) ": " (.getMessage ^Throwable text))))))))

(defn -main [& args]
  (let [[verb & more] args pa (fn [wv] (parse-args more wv))]
    (case verb
      "check" (do-check (pa #{"--corpus" "--base" "--list" "--ref" "--out" "--known" "--jobs" "--results-file" "--controls" "--expect"}))
      "mutants" (do-mutants (pa #{"--out" "--seed" "--files" "--per" "--edits"}))
      "dump" (do-dump (pa #{"--base" "--list" "--out"}))
      (do (println "usage: -m arbace.repr.python.parsecheck check|mutants ...") (System/exit 2)))))

   "cp00858 cp01140 cp037 cp1006 cp1026 cp1051 cp1125 cp1140 cp1250 cp1251 cp1252 cp1253 cp1254 cp1255 cp1256"
   "cp1257 cp1258 cp1361 cp154 cp273 cp367 cp424 cp437 cp500 cp65001 cp720 cp737 cp775 cp819 cp850 cp852 cp855"
   "cp856 cp857 cp858 cp860 cp861 cp862 cp863 cp864 cp865 cp866 cp866u cp869 cp874 cp875 cp932 cp936 cp949 cp950"
   "cp_gr cp_is csHPRoman8 csascii csbig5 cseuckr csibm00858 csibm01140 csibm037 csibm1026 csibm273 csibm424"
   "csibm500 csibm855 csibm857 csibm858 csibm860 csibm861 csibm863 csibm864 csibm865 csibm866 csibm869 csiso2022jp"
   "csiso2022kr csiso58gb231280 csisolatin1 csisolatin2 csisolatin3 csisolatin4 csisolatin5 csisolatin6"
   "csisolatinarabic csisolatincyrillic csisolatingreek csisolatinhebrew cskoi8r cspc775baltic cspc850multilingual"
   "cspc862latinhebrew cspc8codepage437 cspcp852 csptcp154 csshiftjis cyrillic cyrillic_asian ebcdic_cp_be"
   "ebcdic_cp_ca ebcdic_cp_ch ebcdic_cp_he ebcdic_cp_nl ebcdic_cp_us ebcdic_cp_wt ebcdic_us_37_euro ecma_114"
   "ecma_118 elot_928 euc_cn euc_jis2004 euc_jis_2004 euc_jisx0213 euc_jp euc_kr euccn eucgb2312_cn eucjis2004"
   "eucjisx0213 eucjp euckr gb18030 gb18030_2000 gb2312 gb2312_1980 gb2312_80 gbk greek greek8 hebrew hex"
   "hex_codec hkscs hp_roman8 hz hz_gb hz_gb_2312 hzgb ibm00858 ibm01140 ibm037 ibm039 ibm1026 ibm1051 ibm1125"
   "ibm1140 ibm273 ibm367 ibm424 ibm437 ibm500 ibm775 ibm819 ibm850 ibm852 ibm855 ibm857 ibm858 ibm860 ibm861"
   "ibm862 ibm863 ibm864 ibm865 ibm866 ibm869 idna iso2022_jp iso2022_jp_1 iso2022_jp_2 iso2022_jp_2004"
   "iso2022_jp_3 iso2022_jp_ext iso2022_kr iso2022jp iso2022jp_1 iso2022jp_2 iso2022jp_2004 iso2022jp_3"
   "iso2022jp_ext iso2022kr iso646_us iso8859 iso8859_1 iso8859_10 iso8859_11 iso8859_13 iso8859_14 iso8859_15"
   "iso8859_16 iso8859_2 iso8859_3 iso8859_4 iso8859_5 iso8859_6 iso8859_7 iso8859_8 iso8859_9 iso_2022_jp"
   "iso_2022_jp_1 iso_2022_jp_2 iso_2022_jp_2004 iso_2022_jp_3 iso_2022_jp_ext iso_2022_kr iso_646.irv_1991"
   "iso_8859_1 iso_8859_10 iso_8859_10_1992 iso_8859_11 iso_8859_11_2001 iso_8859_13 iso_8859_14 iso_8859_14_1998"
   "iso_8859_15 iso_8859_16 iso_8859_16_2001 iso_8859_1_1987 iso_8859_2 iso_8859_2_1987 iso_8859_3 iso_8859_3_1988"
   "iso_8859_4 iso_8859_4_1988 iso_8859_5 iso_8859_5_1988 iso_8859_6 iso_8859_6_1987 iso_8859_7 iso_8859_7_1987"
   "iso_8859_8 iso_8859_8_1988 iso_8859_8_e iso_8859_8_i iso_8859_9 iso_8859_9_1989 iso_celtic iso_ir_100"
   "iso_ir_101 iso_ir_109 iso_ir_110 iso_ir_126 iso_ir_127 iso_ir_138 iso_ir_144 iso_ir_148 iso_ir_157 iso_ir_166"
   "iso_ir_199 iso_ir_226 iso_ir_58 iso_ir_6 jisx0213 johab koi8_r koi8_t koi8_u korean ks_c_5601 ks_c_5601_1987"
   "ks_x_1001 ksc5601 ksx1001 kz1048 kz_1048 l1 l10 l2 l3 l4 l5 l6 l7 l8 l9 latin latin1 latin10 latin2 latin3"
   "latin4 latin5 latin6 latin7 latin8 latin9 latin_1 mac_arabic mac_centeuro mac_croatian mac_cyrillic mac_farsi"
   "mac_greek mac_iceland mac_latin2 mac_roman mac_romanian mac_turkish maccentraleurope maccyrillic macgreek"
   "maciceland macintosh maclatin2 macroman macturkish ms1361 ms874 ms932 ms936 ms949 ms950 ms_kanji mskanji"
   "palmos pc_multilingual_850_euro pt154 ptcp154 punycode quopri quopri_codec quoted_printable quotedprintable r8"
   "raw_unicode_escape rk1048 roman8 rot13 rot_13 ruscii s_jis s_jis_2004 s_jisx0213 shift_jis shift_jis_2004"
   "shift_jisx0213 shiftjis shiftjis2004 shiftjisx0213 sjis sjis_2004 sjisx0213 strk1048_2002 thai tis620 tis_620"
   "tis_620_0 tis_620_2529_0 tis_620_2529_1 u16 u32 u7 u8 u_jis uhc ujis undefined unicode_1_1_utf_7"
   "unicode_escape unicodebigunmarked unicodelittleunmarked us us_ascii utf utf16 utf32 utf7 utf8 utf8_ucs2"
   "utf8_ucs4 utf_16 utf_16_be utf_16_le utf_16be utf_16le utf_32 utf_32_be utf_32_le utf_32be utf_32le utf_7"
   "utf_8 utf_8_sig uu uu_codec windows_1250 windows_1251 windows_1252 windows_1253 windows_1254 windows_1255"
   "windows_1256 windows_1257 windows_1258 windows_31j windows_874 x_mac_japanese x_mac_korean x_mac_simp_chinese"
   "x_mac_trad_chinese zip zlib zlib_codec"])
                  #" ")))

(defn- python-codec? [^String cs]
  (let [n (-> (str/lower-case cs) (str/replace #"[^a-z0-9.]+" "_") (str/replace #"^_|_$" ""))]
    (or (contains? python-codecs n) (contains? python-codecs (str/replace n "." "_")))))

(defn source-text
  "compile()'s reading of a source's bytes, ast.parse's (Python/pythonrun.c's _Py_SourceAsString, then
  string_tokenizer.c's decode_str: new-lines translated, the BOM, the coding spec of the first two lines, the text
  decoded, or UTF-8 checked when none is declared): {:text TEXT} (ending in a new-line) or {:error [CLASS MSG L O EL EO
  TEXT]}"
  [^bytes bs]
  (if (some #(zero? (long %)) bs)
    {:error ["SyntaxError" "source code string cannot contain null bytes" nil nil nil nil nil]}
    (let [tr (translate-newlines bs 0)
          n (alength tr)
          bom (and (>= n 3) (== (aget tr 0) (unchecked-byte 0xEF)) (== (aget tr 1) (unchecked-byte 0xBB)) (== (aget tr 2) (unchecked-byte 0xBF)))
          a (if bom 3 0)
          nl (fn [i] (loop [i i] (cond (>= i n) nil (== (aget tr i) 10) i :else (recur (inc i)))))
          n1 (nl a)
          n2 (when n1 (nl (inc n1)))
          init-error (fn [msg] {:error ["SyntaxError" msg 0 -1 nil nil nil]})
          spec (fn [lineno la size]
                 (let [cs (coding-spec tr la size)]
                   (cond
                     (= cs :code) :code
                     (nil? cs) (if (code-line? tr la size) :code nil)
                     (and bom (not= cs "utf-8"))
                     (let [line (String. tr (int la) (int (- (long (nl la)) la)) "UTF-8")]
                       {:error ["SyntaxError" (str "encoding problem: " cs " with BOM") lineno 0 lineno
                                (byte-offset->char line size) line]})
                     :else {:cs cs})))
          r1 (when n1 (spec 1 a (- (long n1) a)))
          r (cond
              (:error r1) r1
              (:cs r1) r1
              (and (nil? r1) n2) (spec 2 (inc (long n1)) (- (long n2) (long n1)))
              :else nil)]
      (cond
        (:error r) r
        (and (:cs r) (not= (:cs r) "utf-8"))
        (let [cs (:cs r) charset (lex/codec cs) body (java.util.Arrays/copyOfRange tr (int a) (int n))]
          (cond
            (and (nil? charset) (python-codec? cs))
            (throw (ex-info (str "the runtime has no charset for Python's codec " cs) {:class :charset}))
            (nil? charset) (init-error (str "unknown encoding: " cs))
            :else (if-let [m (decode-error-text cs body)]
                    (init-error m)
                    {:text (str/replace (try (String. body ^String charset)
                                               (catch Throwable e
                                                 (throw (ex-info (str "the runtime has no charset " charset " (" (.getMessage e) ")") {:class :charset}))))
                                             #"\r\n?" "\n")})))
        :else
        (if-let [e (utf8-error tr a)]
          {:error e}
          {:text (String. tr (int a) (int (- n a)) "UTF-8")})))))

(defn read-dump
  "A file's bytes as the helper's tree mode writes them (mode :lines, or :full when `full`): (python/module ...) or
  (python/error ...), and a newline; with `meta` a parser's SyntaxError has its :metadata (pyi's compiler, queue 202c)"
  ^String [^bytes bs ^String rel & [full meta]]
  (let [{:keys [error] stext :text} (source-text bs)]
    (if error
      (str (error-text error) "\n")
      (let [{:keys [text encoding]} (let [d (try (lex/decode-source bs) (catch Throwable _ nil))]
                                      (if (and d (:text d)) d {:text stext :encoding "utf-8"}))]
        (try
          (let [tree (parse-text stext false)
                tc-tree (if (re-find #"#[ \t]*type[ \t]*:" stext)
                          (try (parse-text stext true) (catch arbace.lang.ExceptionInfo e (if (:python-error (ex-data e)) :rejected (throw e))))
                          tree)
                extra (cond-> []
                        (= tc-tree :rejected) (conj [":type-comments" ":rejected"])
                        (and (map? tc-tree) (seq (:type_ignores tc-tree)))
                        (conj [":type-ignores" (vecs (for [t (:type_ignores tc-tree)] (form "type-ignore" [(str (:lineno t)) (qstr (:tag t))] [] nil)))])
                        (and full (not= encoding "utf-8")) (conj [":encoding" (qstr encoding)])
                        (and full (>= (alength bs) 3) (== (aget bs 0) (unchecked-byte 0xEF)) (== (aget bs 1) (unchecked-byte 0xBB))
                             (== (aget bs 2) (unchecked-byte 0xBF))) (conj [":bom" "true"])
                        full (conj [":tokens" (tokens-text text)]))]
            (str (module-text text tree (when (map? tc-tree) tc-tree) rel (boolean full) extra) "\n"))
          (catch arbace.lang.ExceptionInfo e
            (if-let [pe (:python-error (ex-data e))]
              (str (error-text pe (when meta (:metadata (ex-data e)))) "\n")
              (throw e))))))))

;; Ported from CPython 3.14.10 (https://www.python.org/ftp/python/3.14.10/Python-3.14.10.tar.xz, SHA-256
;; de414a57119abef52784d8993e341d53aed635fc2b05c2607d9f98a2c5b72032): Parser/pegen.c (the token buffer, keywords, the memo,
;; the token functions, lookahead helpers), Parser/action_helpers.c (the grammar's helpers) and the parts of
;; Parser/string_parser.c the parser's nodes need, Copyright (c) 2001 Python Software Foundation, All Rights Reserved,
;; under the PSF License Agreement for Python 3.14 (LICENSE.md, "CPython: the PSF License Agreement for Python 3.14").

(ns arbace.repr.python.peg
  "The runtime of Python's generated parser (arbace.repr.python.parser; doc/python/PYTHON-SURVEY.md, \"As built: PY9b\"):
  the parser's state over the native lexer, its token buffer (keywords given their types, TYPE_IGNORE comments
  recorded), the memo (pegen.c), and the grammar's action helpers (action_helpers.c). A node is a map: :t its ast class
  (:Name, :BinOp, ...), its fields by Parser/Python.asdl's names, and :lineno :col_offset :end_lineno :end_col_offset
  (UTF-8 columns) when the class has positions. A Constant's :value is :None, :True, :False, :Ellipsis, [:int TEXT],
  [:float TEXT], [:complex TEXT], [:str] or [:bytes]: the kind of value (the forms keep the spelling, not the value).
  A token is a map {:type :string :lineno :col_offset :end_lineno :end_col_offset :metadata :level}."
  (:require [arbace.repr.python.lex :as lex]
            [arbace.string :as str]))

(set! *warn-on-reflection* true)

(def FAIL (Object.))
(def CUT (Object.))
(def MISS (Object.))

(deftype Parser [lx ^java.util.ArrayList toks ^longs st ^java.util.HashMap memo ^java.util.Map keywords
                 ^java.util.Set soft ^java.util.ArrayList type-ignores ^objects types])
;; st: [mark fill call-invalid barry feature-version]; types: [an int array of the tokens' types]

(defn parser
  "A parser over `text` (the string tokenizer's input: new-lines translated, ending in one), with type comments
  when `type-comments`"
  ^Parser [^String text keywords soft type-comments]
  (let [p (Parser. (lex/lexer text false type-comments true) (java.util.ArrayList.) (long-array 5) (java.util.HashMap.)
                   keywords (set soft) (java.util.ArrayList.) (object-array [(int-array 1024)]))]
    (aset ^longs (.-st p) 4 14)
    p))

(defn set-feature-version
  "compile()'s _feature_version (PyCF_ONLY_AST): the minor version the grammar's CHECK_VERSIONs hold the source to (a
  negative one is the current, 14)"
  [^Parser p ^long v]
  (aset ^longs (.-st p) 4 (if (neg? v) 14 v))
  p)

(defn mark ^long [^Parser p] (aget ^longs (.-st p) 0))
(defn reset [^Parser p ^long m] (aset ^longs (.-st p) 0 m))
(defn fill ^long [^Parser p] (aget ^longs (.-st p) 1))
(defn call-invalid? [^Parser p] (not (zero? (aget ^longs (.-st p) 2))))
(defn set-call-invalid [^Parser p v] (aset ^longs (.-st p) 2 (long (if v 1 0))))
(defmacro without-invalid [p & body]
  `(let [p# ~p prev# (call-invalid? p#)]
     (set-call-invalid p# false)
     (try ~@body (finally (set-call-invalid p# prev#)))))
(defn tokens [^Parser p] (vec (.-toks p)))

;; ---- errors (Parser/pegen_errors.c): an error is an ex-info whose :python-error is [CLASS MSG L O EL EO TEXT], the
;; SyntaxError's fields as CPython gives them (O and EO in characters, 1-based); the first one raised ends the parse, as
;; p->error_indicator does

(def ^:const CURRENT-POS -5)

(defn- cfmt
  "PyUnicode_FromFormat's %s %U %d %i %c %R (a str's repr, quoted) and %%"
  ^String [^String msg args]
  (let [sb (StringBuilder.) n (count msg)]
    (loop [i 0 args (seq args)]
      (if (>= i n)
        (str sb)
        (let [c (.charAt msg i)]
          (if (and (= c \%) (< (inc i) n))
            (let [d (.charAt msg (inc i))]
              (case d
                \% (do (.append sb \%) (recur (+ i 2) args))
                (\s \U \d \i) (do (.append sb (str (first args))) (recur (+ i 2) (next args)))
                \c (do (.append sb (let [x (first args)] (if (number? x) (String. (Character/toChars (int x))) (str x)))) (recur (+ i 2) (next args)))
                \R (do (.append sb (str "'" (first args) "'")) (recur (+ i 2) (next args)))
                (do (.append sb c) (recur (inc i) args))))
            (do (.append sb c) (recur (inc i) args))))))))

(defn byte-offset->char
  "_PyPegen_byte_offset_to_character_offset: the characters of the first `col` UTF-8 bytes of `line` (a truncated
  sequence counts one, as decoding with \"replace\" does; `col` past the end reads the terminating NUL)"
  ^long [^String line ^long col]
  (let [^bytes bs (.getBytes line "UTF-8") len (alength bs) col (min col (inc len))]
    (loop [i 0 k 0]
      (if (>= i col)
        k
        (if (>= i len)
          (recur (inc i) (inc k))
          (let [b (bit-and (aget bs i) 0xFF)
                w (cond (< b 0x80) 1 (== (bit-and b 0xE0) 0xC0) 2 (== (bit-and b 0xF0) 0xE0) 3 (== (bit-and b 0xF8) 0xF0) 4 :else 1)]
            (recur (+ i (long w)) (inc k))))))))

(defn- lx ^arbace.repr.python.lex.Lx [^Parser p] (.-lx p))

(defn- tok-byte-col
  "tok->cur - tok->line_start, in UTF-8 bytes"
  ^long [^Parser p]
  (let [l (lx p)] (- (lex/byte-index l (lex/state l :cur)) (lex/byte-index l (lex/state l :line-start)))))

(defn- line-from-buffers
  "get_error_line_from_tokenizer_buffers: the `lineno`th line of the source (the string tokenizer's tok->str), without
  its new-line, not past what the tokenizer read"
  ^String [^Parser p ^long lineno]
  (let [l (lx p) n (lex/text-length l) inp (lex/state l :inp)
        nl (fn ^long [^long i] (loop [i i] (cond (>= i n) -1 (== 10 (lex/char-at l i)) i :else (recur (inc i)))))
        start (loop [cur 0 k 0]
                (if (>= k (dec lineno))
                  cur
                  (let [x (nl cur)]
                    (if (or (neg? x) (> (inc (long x)) (max inp cur))) cur (recur (inc (long x)) (inc k))))))
        e (nl start)]
    (lex/text-range l start (if (neg? e) n e))))

(defn- error-line
  "The error's text: the tokenizer's current line when it has not passed `lineno`, else the line from the source"
  ^String [^Parser p ^long lineno]
  (let [l (lx p) inp (lex/state l :inp) buf (lex/state l :buf)]
    (if (and (<= (lex/state l :lineno) lineno) (> inp buf))
      (lex/text-range l (lex/state l :line-start) inp)
      (line-from-buffers p lineno))))

(defn raise-known
  "_PyPegen_raise_error_known_location: COL and END-COL are 1-based UTF-8 offsets (CURRENT-POS: the tokenizer's
  position), made characters on the error's line"
  [^Parser p cls lineno col end-lineno end-col msg & args]
  (let [l (lx p)
        end-lineno (if (== (long end-lineno) CURRENT-POS) (lex/state l :lineno) end-lineno)
        end-col (if (== (long end-col) CURRENT-POS) (tok-byte-col p) end-col)
        text (error-line p lineno)
        c (byte-offset->char text col)
        ec (if (pos? (long end-col)) (byte-offset->char text end-col) end-col)
        msg (cfmt msg args)]
    (throw (ex-info (str cls ": " msg) {:python-error [cls msg lineno c end-lineno ec text]}))))

(defn RAISE-ERROR-KNOWN-LOCATION
  "RAISE_ERROR_KNOWN_LOCATION (pegen.h): 0-based UTF-8 columns"
  [^Parser p cls lineno col end-lineno end-col msg & args]
  (apply raise-known p (name cls) lineno (if (== (long col) CURRENT-POS) col (inc (long col))) end-lineno
         (if (== (long end-col) CURRENT-POS) end-col (inc (long end-col))) msg args))

(declare fill-token RAISE-SYNTAX-ERROR-KNOWN-RANGE* RAISE-SYNTAX-ERROR)

(defn raise-error
  "_PyPegen_raise_error: at the token under the mark (`use-mark`) or the last token read"
  [^Parser p cls use-mark msg & args]
  (let [fill (aget ^longs (.-st p) 1)]
    (if (zero? fill)
      (apply raise-known p cls 0 0 0 -1 msg args)
      (do
        (when (and use-mark (== (aget ^longs (.-st p) 0) fill)) (fill-token p))
        (let [^java.util.ArrayList toks (.-toks p)
              t (.get toks (int (if use-mark (aget ^longs (.-st p) 0) (dec (.size toks)))))
              l (lx p)
              col (if (== -1 (long (:col_offset t)))
                    (if (== (lex/state l :cur) (lex/state l :buf)) 0 (tok-byte-col p))
                    (inc (long (:col_offset t))))
              end (if (== -1 (long (:end_col_offset t))) -1 (inc (long (:end_col_offset t))))]
          (apply raise-known p cls (:lineno t) col (:end_lineno t) end msg args))))))

(defn syntax-error-at
  "RAISE_SYNTAX_ERROR_KNOWN_LOCATION's shape: a node's or token's range"
  [p a msg & args]
  (apply RAISE-ERROR-KNOWN-LOCATION p :SyntaxError (:lineno a) (:col_offset a) (:end_lineno a) (:end_col_offset a) msg args))

(defn unclosed-paren-error
  "raise_unclosed_parentheses_error"
  [^Parser p]
  (let [[c line col] (lex/paren-top (lx p))]
    (RAISE-ERROR-KNOWN-LOCATION p :SyntaxError line col line -1 "'%c' was never closed" c)))

(defn tokenizer-error
  "_Pypegen_tokenizer_error: the error of a done code the tokenizer set without raising"
  [^Parser p]
  (let [l (lx p) done (lex/state l :done)]
    (condp == done
      lex/E_EOF (if (pos? (lex/state l :level))
                  (unclosed-paren-error p)
                  (raise-error p "SyntaxError" false "unexpected EOF while parsing"))
      lex/E_DEDENT (raise-error p "IndentationError" false "unindent does not match any outer indentation level")
      (let [[cls msg col] (condp == done
                            lex/E_TOKEN ["SyntaxError" "invalid token" -1]
                            lex/E_TABSPACE ["TabError" "inconsistent use of tabs and spaces in indentation" -1]
                            lex/E_TOODEEP ["IndentationError" "too many levels of indentation" -1]
                            lex/E_LINECONT ["SyntaxError" "unexpected character after line continuation character"
                                            (- (lex/byte-index l (lex/state l :cur)) (lex/byte-index l (lex/state l :buf)) 1)]
                            ["SyntaxError" "unknown parsing error" -1])
            lineno (lex/state l :lineno)]
        (RAISE-ERROR-KNOWN-LOCATION p (keyword cls) lineno (if (>= (long col) 0) col 0) lineno -1 msg)))))

(defn- fill-token
  "_PyPegen_fill_token: the next token of the lexer, TYPE_IGNORE comments recorded and skipped, NAME's keywords typed"
  [^Parser p]
  (let [lx (.-lx p)]
    (loop []
      (let [type (lex/next-token lx)
            [_ a b line end-line col end-col level meta] (lex/token-fields lx)
            ^ints cs (.-cs ^arbace.repr.python.lex.Lx lx)
            s (if (or (neg? a) (neg? b)) "" (String. cs (int a) (int (- b a))))]
        (cond
          (== type lex/TYPE_IGNORE)
          (do (.add ^java.util.ArrayList (.-type-ignores p) [line s]) (recur))
          :else
          (let [type (if (== type lex/NAME) (long (or (.get ^java.util.Map (.-keywords p) s) lex/NAME)) type)
                t {:type type :string s :lineno line :col_offset col :end_lineno end-line :end_col_offset end-col
                   :metadata meta :level level}
                n (.size ^java.util.ArrayList (.-toks p))
                ^ints ty (aget ^objects (.-types p) 0)
                ^ints ty (if (< n (alength ty))
                           ty
                           (let [t2 (java.util.Arrays/copyOf ty (* 2 (alength ty)))] (aset ^objects (.-types p) 0 t2) t2))]
            (aset ty n (int type))
            (.add ^java.util.ArrayList (.-toks p) t)
            (aset ^longs (.-st p) 1 (long (inc n)))
            ;; initialize_token: the error token is the last read, then its error (raised by the tokenizer, or of
            ;; its done code)
            (when (== type lex/ERRORTOKEN)
              (if-let [e (lex/error-of lx)]
                (throw (ex-info "the tokenizer's error" {:python-error (vec e) :tokenizer true}))
                (tokenizer-error p)))))))))

(defn- ensure-token [^Parser p ^long m]
  (when (== m (aget ^longs (.-st p) 1)) (fill-token p)))

(defn token-at [^Parser p ^long i] (.get ^java.util.ArrayList (.-toks p) (int i)))

(defn expect
  "_PyPegen_expect_token"
  [^Parser p ^long type]
  (let [m (mark p)]
    (ensure-token p m)
    (when (== type (aget ^ints (aget ^objects (.-types p) 0) m))
      (reset p (inc m))
      (.get ^java.util.ArrayList (.-toks p) (int m)))))

(defn start-token [^Parser p] (let [m (mark p)] (ensure-token p m) (.get ^java.util.ArrayList (.-toks p) (int m))))

(defn last-nonws-token
  "_PyPegen_get_last_nonnwhitespace_token"
  [^Parser p]
  (loop [m (dec (mark p)) tok nil]
    (if (< m 0)
      tok
      (let [t (.get ^java.util.ArrayList (.-toks p) (int m)) ty (long (:type t))]
        (if (and (not= ty lex/ENDMARKER) (or (< ty lex/NEWLINE) (> ty lex/DEDENT)))
          t
          (recur (dec m) t))))))

(defn extra
  "EXTRA: the start token's start, the last non-white-space token's end"
  [^Parser p start]
  (let [e (last-nonws-token p)]
    {:lineno (:lineno start) :col_offset (:col_offset start) :end_lineno (:end_lineno e) :end_col_offset (:end_col_offset e)}))

(defn extra-expr [a b] {:lineno (:lineno a) :col_offset (:col_offset a) :end_lineno (:end_lineno b) :end_col_offset (:end_col_offset b)})
(defn pos [l c el ec] {:lineno l :col_offset c :end_lineno el :end_col_offset ec})
(defn mk [pos m] (into m pos))

(defn kind [x] (or (:kind x) (:t x)))
(defn truthy? [x] (not (or (nil? x) (false? x) (and (number? x) (zero? (long x))))))
(defn not? [x] (not (truthy? x)))
(defn c= [a b] (if (and (number? a) (number? b)) (== (long a) (long b)) (= a b)))

;; ---- the memo (pegen.c)

(defn- memo-key ^long [^long m ^long id] (+ (* m 4096) id))

(defn memoized
  "_PyPegen_is_memoized: the memoized result (the mark moved to its end), or MISS"
  [^Parser p ^long id]
  (let [m (mark p)]
    (ensure-token p m)
    (let [^objects e (.get ^java.util.HashMap (.-memo p) (memo-key m id))]
      (if e
        (do (reset p (long (aget e 1))) (aget e 0))
        MISS))))

(defn insert-memo [^Parser p ^long m ^long id res]
  (.put ^java.util.HashMap (.-memo p) (memo-key m id) (object-array [res (mark p)])))

(defn update-memo [^Parser p ^long m ^long id res] (insert-memo p m id res))

;; ---- tokens as nodes

(defn- nfkc ^String [^String s]
  (if (every? #(< (int %) 128) s) s (java.text.Normalizer/normalize s java.text.Normalizer$Form/NFKC)))

(defn name-from-token [^Parser p t]
  (when t
    (let [id (nfkc (:string t))]
      (when (#{"None" "True" "False"} id)
        (throw (ex-info (str "identifier field can't represent '" id "' constant") {:python-error ["ValueError" (str "identifier field can't represent '" id "' constant") nil nil nil nil]})))
      {:t :Name :id id :ctx :Load :lineno (:lineno t) :col_offset (:col_offset t) :end_lineno (:end_lineno t)
       :end_col_offset (:end_col_offset t)})))

(defn name-token [^Parser p] (name-from-token p (expect p lex/NAME)))
(defn string-token [^Parser p] (expect p lex/STRING))

(defn soft-keyword-token [^Parser p]
  (let [m (mark p) t (expect p lex/NAME)]
    (when t
      (if (contains? (.-soft p) (:string t)) (name-from-token p t) nil))))

(defn expect-soft [^Parser p ^String kw]
  (let [m (mark p)]
    (ensure-token p m)
    (let [t (.get ^java.util.ArrayList (.-toks p) (int m))]
      (when (and (== (long (:type t)) lex/NAME) (= (:string t) kw))
        (name-token p)))))

(defn number-kind
  "parsenumber's kind of value: :int, :float or :complex"
  [^String s]
  (let [s (str/replace s "_" "")]
    (cond
      (or (str/ends-with? s "j") (str/ends-with? s "J")) :complex
      (re-matches #"0[xX][0-9a-fA-F]+|0[oO][0-7]+|0[bB][01]+|[0-9]+" s) :int
      :else :float)))

(declare RAISE-SYNTAX-ERROR)

(defn check-version
  "INVALID_VERSION_CHECK"
  [^Parser p ^long version msg node]
  (when (and (some? node) (< (aget ^longs (.-st p) 4) version))
    (RAISE-SYNTAX-ERROR p "%s only supported in Python 3.%i and greater" msg version))
  node)

(defn number-token [^Parser p]
  (when-let [t (expect p lex/NUMBER)]
    (when (and (< (aget ^longs (.-st p) 4) 6) (str/includes? (:string t) "_"))
      (RAISE-SYNTAX-ERROR p "Underscores in numeric literals are only supported in Python 3.6 and greater"))
    {:t :Constant :value [(number-kind (:string t)) (:string t)] :kind nil :lineno (:lineno t) :col_offset (:col_offset t)
     :end_lineno (:end_lineno t) :end_col_offset (:end_col_offset t)}))

(defn expect-forced
  "_PyPegen_expect_forced_token"
  [^Parser p ^long type ^String expected]
  (or (expect p type)
      ;; the generator passes the grammar's literal, quoted
      (syntax-error-at p (start-token p) "expected '%s'"
                       (if (and (> (count expected) 1) (str/starts-with? expected "'") (str/ends-with? expected "'"))
                         (subs expected 1 (dec (count expected))) expected))))

(defn expect-forced-result
  "_PyPegen_expect_forced_result"
  [^Parser p result ^String expected]
  (or result (raise-error p "SyntaxError" false "expected (%s)" expected)))

(def ^:private the-dummy {:t :Name :id "" :ctx :Load :lineno 1 :col_offset 0 :end_lineno 1 :end_col_offset 0 :dummy true})
(defn dummy-name [& _] the-dummy)

;; ---- sequences (action_helpers.c)

(defn singleton-seq [p a] [a])
(defn seq-insert-in-front [p a s] (if s (into [a] s) [a]))
(defn seq-append-to-end [p s a] (if s (conj (vec s) a) [a]))
(defn seq-flatten [p seqs] (vec (mapcat identity seqs)))
(defn join-sequences [p a b] (into (vec a) b))

(defn join-names-with-dot [p a b]
  (into {:t :Name :id (str (:id a) "." (:id b)) :ctx :Load} (extra-expr a b)))

(defn seq-count-dots [s] (reduce + (map #(if (== (long (:type %)) lex/ELLIPSIS) 3 1) s)))

(defn alias-for-star [p ex] (into {:t :alias :name "*" :asname nil} ex))

(defn map-names-to-ids [p s] (mapv :id s))
(defn cmpop-expr-pair [p op e] {:cmpop op :expr e})
(defn get-cmpops [p s] (mapv :cmpop s))
(defn get-exprs [p s] (mapv :expr s))

(declare set-expr-context)
(defn- set-seq-context [p s ctx] (when (seq s) (mapv #(set-expr-context p % ctx) s)))

(defn set-expr-context
  "_PyPegen_set_expr_context: a copy of `e` (a Name, Tuple, List, Subscript, Attribute or Starred) with `ctx`"
  [p e ctx]
  (case (:t e)
    :Name (assoc e :ctx ctx)
    (:Tuple :List) (assoc e :elts (set-seq-context p (:elts e) ctx) :ctx ctx)
    (:Subscript :Attribute) (assoc e :ctx ctx)
    :Starred (assoc e :value (set-expr-context p (:value e) ctx) :ctx ctx)
    e))

(defn key-value-pair [p k v] {:key k :value v})
(defn get-keys [p s] (mapv :key s))
(defn get-values [p s] (mapv :value s))
(defn key-pattern-pair [p k pat] {:key k :pattern pat})
(defn get-pattern-keys [p s] (mapv :key s))
(defn get-patterns [p s] (mapv :pattern s))

(defn new-type-comment [p t] (when t (:string t)))

(defn add-type-comment-to-arg [p a tc]
  (if (nil? tc) a (assoc a :type_comment (:string tc))))

(defn name-default-pair [p arg value tc] {:arg (add-type-comment-to-arg p arg tc) :value value})
(defn slash-with-default [p plain with-defaults] {:plain_names plain :names_with_defaults with-defaults})
(defn star-etc [p vararg kwonly kwarg] {:vararg vararg :kwonlyargs kwonly :kwarg kwarg})

(defn make-arguments
  "_PyPegen_make_arguments"
  [p slash-without slash-with plain-names names-with-default star-etc]
  (let [names (fn [s] (mapv :arg s))
        defaults (fn [s] (mapv :value s))
        posonly (cond slash-without slash-without
                      slash-with (into (vec (:plain_names slash-with)) (names (:names_with_defaults slash-with)))
                      :else [])
        posargs (cond (and names-with-default plain-names) (into (vec plain-names) (names names-with-default))
                      names-with-default (names names-with-default)
                      plain-names plain-names
                      :else [])
        posdefaults (cond (and slash-with names-with-default) (into (defaults (:names_with_defaults slash-with)) (defaults names-with-default))
                          names-with-default (defaults names-with-default)
                          slash-with (defaults (:names_with_defaults slash-with))
                          :else [])
        kwonly (if (and star-etc (:kwonlyargs star-etc)) (names (:kwonlyargs star-etc)) [])
        kwdefaults (if (and star-etc (:kwonlyargs star-etc)) (defaults (:kwonlyargs star-etc)) [])]
    {:t :arguments :posonlyargs posonly :args posargs :vararg (:vararg star-etc) :kwonlyargs kwonly
     :kw_defaults kwdefaults :kwarg (:kwarg star-etc) :defaults posdefaults}))

(defn empty-arguments [p]
  {:t :arguments :posonlyargs [] :args [] :vararg nil :kwonlyargs [] :kw_defaults [] :kwarg nil :defaults []})

(defn augoperator [p op] {:kind op})

(defn function-def-decorators [p decorators f] (assoc f :decorator_list decorators))
(defn class-def-decorators [p decorators c] (assoc c :decorator_list decorators))

(defn keyword-or-starred [p element is-keyword] {:element element :is_keyword is-keyword})

(defn seq-extract-starred-exprs [p kwargs]
  (let [s (vec (for [k kwargs :when (not (truthy? (:is_keyword k)))] (:element k)))] (when (seq s) s)))
(defn seq-delete-starred-exprs [p kwargs]
  (let [s (vec (for [k kwargs :when (truthy? (:is_keyword k))] (:element k)))] (when (seq s) s)))

(defn collect-call-seqs [p a b ex]
  (if (nil? b)
    (into {:t :Call :func (dummy-name p) :args a :keywords nil} ex)
    (into {:t :Call :func (dummy-name p) :args (into (vec a) (seq-extract-starred-exprs p b))
           :keywords (seq-delete-starred-exprs p b)} ex)))

(defn ensure-imaginary [p e]
  (if (and (= :Constant (:t e)) (vector? (:value e)) (= :complex (first (:value e))))
    e
    (syntax-error-at p e "imaginary number required in complex literal")))

(defn ensure-real [p e]
  (if (and (= :Constant (:t e)) (not (and (vector? (:value e)) (= :complex (first (:value e))))))
    e
    (syntax-error-at p e "real number required in complex literal")))

(defn make-module [^Parser p a]
  {:t :Module :body (or a []) :type_ignores (vec (for [[l tag] (.-type-ignores p)] {:t :TypeIgnore :lineno l :tag tag}))})

(defn register-stmts [p s] s)
(defn interactive-exit [p] nil)

(defn checked-future-import
  "_PyPegen_checked_future_import: from __future__ import barry_as_FLUFL sets PyPARSE_BARRY_AS_BDFL"
  [^Parser p module names level ex]
  (when (and (c= level 0) (= module "__future__") (some #(= "barry_as_FLUFL" (:name %)) names))
    (aset ^longs (.-st p) 3 1)
    (lex/set-barry! (.-lx p)))
  (into {:t :ImportFrom :module module :names names :level level} ex))

(defn check-barry-as-flufl
  "_PyPegen_check_barry_as_flufl: 0 when the token is the flags' spelling of not-equal"
  [^Parser p t]
  (if (== 1 (aget ^longs (.-st p) 3))
    (if (not= (:string t) "<>") (RAISE-SYNTAX-ERROR p "with Barry as BDFL, use '<>' instead of '!='") 0)
    (if (= (:string t) "!=") 0 1)))
(defn tokens-are-adjacent [a b] (and (c= (:end_lineno a) (:lineno b)) (c= (:end_col_offset a) (:col_offset b))))
(defn check-legacy-stmt [p name] (and (= :Name (:t name)) (contains? #{"print" "exec"} (:id name))))

;; ---- strings (action_helpers.c's f-string and concatenation helpers; the values' kinds only)

(defn- string-prefix ^String [^String s] (let [m (re-find #"^[A-Za-z]*" s)] m))

;; string_parser.c's decoding, for its errors only (the forms keep the spelling): unicode-escape and bytes-escape
;; errors as UnicodeDecodeError's and ValueError's str, which the parser raises as "(unicode error) ..." and
;; "(value error) ..."

(defn- escape-transform
  "decode_unicode_with_escapes' buffer: the body's non-ASCII characters as \\UXXXXXXXX, a backslash before one or at
  the end as \\u005c"
  ^String [^String s]
  (let [sb (StringBuilder.) n (.length s)]
    (loop [i 0]
      (when (< i n)
        (let [c (.codePointAt s i)]
          (cond
            (== c 92)
            (let [j (inc i)]
              (.append sb \\)
              (if (or (>= j n) (>= (.codePointAt s j) 128))
                (do (.append sb "u005c") (recur j))
                (do (.appendCodePoint sb (.codePointAt s j)) (recur (+ j (Character/charCount (.codePointAt s j)))))))
            (>= c 128) (do (.append sb (format "\\U%08x" c)) (recur (+ i (Character/charCount c))))
            :else (do (.append sb (char c)) (recur (inc i)))))))
    (str sb)))

(defn- hexv ^long [^long c]
  (cond (and (>= c 48) (<= c 57)) (- c 48) (and (>= c 97) (<= c 102)) (- c 87) (and (>= c 65) (<= c 70)) (- c 55) :else -1))

(defn unicode-escape-error
  "_PyUnicode_DecodeUnicodeEscapeInternal2's first error over the buffer `b` (ASCII), as UnicodeDecodeError's str, or
  nil"
  [^String b]
  (let [n (.length b)
        err (fn [^long start ^long end msg]
              (if (== end (inc start))
                (format "'unicodeescape' codec can't decode byte 0x%02x in position %d: %s" (int (.charAt b start)) start msg)
                (format "'unicodeescape' codec can't decode bytes in position %d-%d: %s" start (dec end) msg)))]
    (loop [s 0]
      (when (< s n)
        (if (not= (.charAt b s) \\)
          (recur (inc s))
          (let [start s s (inc s)]
            (if (>= s n)
              (err start s "\\ at end of string")
              (let [c (.charAt b s) s (inc s)]
                (case c
                  (\x \u \U)
                  (let [[cnt msg] (case c \x [2 "truncated \\xXX escape"] \u [4 "truncated \\uXXXX escape"] [8 "truncated \\UXXXXXXXX escape"])
                        r (loop [k 0 s s ch 0]
                            (cond
                              (== k (long cnt)) (if (> ch 0x10FFFF) [:err s "illegal Unicode character"] [:ok s])
                              (>= s n) [:err n msg]
                              (neg? (hexv (int (.charAt b s)))) [:err s msg]
                              :else (recur (inc k) (inc s) (+ (* ch 16) (hexv (int (.charAt b s)))))))]
                    (if (= :ok (first r)) (recur (long (second r))) (err start (second r) (nth r 2))))
                  \N
                  (cond
                    (>= s n) (err start s "malformed \\N character escape")
                    (= (.charAt b s) \{)
                    (let [st (inc s) e (loop [k st] (if (and (< k n) (not= (.charAt b k) \})) (recur (inc k)) k))]
                      (cond
                        (>= e n) (err start n "malformed \\N character escape")
                        (== e st) (err start e "malformed \\N character escape")
                        :else (if (try (Character/codePointOf (subs b st e)) true (catch Throwable _ false))
                                (recur (inc (long e)))
                                (err start (inc e) "unknown Unicode character name"))))
                    :else (err start s "malformed \\N character escape"))
                  (recur s))))))))))

(defn- bytes-escape-error
  "_PyBytes_DecodeEscape2's error (a ValueError's message), or nil"
  [^String b]
  (let [n (.length b)]
    (loop [s 0]
      (when (< s n)
        (if (not= (.charAt b s) \\)
          (recur (inc s))
          (let [s1 (inc s)]
            (cond
              (>= s1 n) "Trailing \\ in string"
              (= (.charAt b s1) \x)
              (if (and (< (+ s1 2) n) (>= (hexv (int (.charAt b (inc s1)))) 0) (>= (hexv (int (.charAt b (+ s1 2)))) 0))
                (recur (+ s1 3))
                (format "invalid \\x escape at position %d" s))
              :else (recur (inc s1)))))))))

(defn- string-body
  "parse_string's view of a string token: [bytes? raw? BODY]"
  [^String tok]
  (let [pre (str/lower-case (string-prefix tok))
        q (subs tok (count pre))
        q3 (and (>= (count q) 6) (= (subs q 0 3) (subs q (- (count q) 3))) (#{"'''" "\"\"\""} (subs q 0 3)))
        body (if q3 (subs q 3 (- (count q) 3)) (subs q 1 (dec (count q))))]
    [(str/includes? pre "b") (str/includes? pre "r") body]))

(defn- decode-check
  "The decode error of a string's body (raw: none), as [WORD MSG] (\"unicode error\" or \"value error\"), or nil"
  [bytes? raw? ^String body]
  (when (and (not raw?) (str/includes? body "\\"))
    (if bytes?
      (when-let [m (bytes-escape-error body)] ["value error" m])
      (when-let [m (unicode-escape-error (escape-transform body))] ["unicode error" m]))))

;; the literals' values (for _ast's trees, arbace.repr.python.astjson; the forms keep the spelling): a string's decoded
;; value as :sv (a String, lone surrogates kept), a bytes literal's as :bv (a vector of bytes 0-255)

(defn decode-value
  "The value of a literal's body (decode_unicode_with_escapes, _PyBytes_DecodeEscape2; the body already checked by
  decode-check): a String, or for bytes a vector of byte values"
  [^String body bytes? raw?]
  (let [chars (fn [^String s] (if bytes? (mapv #(bit-and (int %) 0xFF) s) s))]
    (if (or raw? (not (str/includes? body "\\")))
      (chars body)
      (let [sb (StringBuilder.) n (.length body)
            hex (fn [a b] (Integer/parseInt (subs body a b) 16))]
        (loop [i 0]
          (when (< i n)
            (let [c (.charAt body i)]
              (if (or (not= c \\) (>= (inc i) n))
                (do (.append sb c) (recur (inc i)))
                (let [d (.charAt body (inc i))]
                  (case d
                    \newline (recur (+ i 2))
                    \\ (do (.append sb \\) (recur (+ i 2)))
                    \' (do (.append sb \') (recur (+ i 2)))
                    \" (do (.append sb \") (recur (+ i 2)))
                    \b (do (.append sb (char 8)) (recur (+ i 2)))
                    \f (do (.append sb (char 12)) (recur (+ i 2)))
                    \t (do (.append sb (char 9)) (recur (+ i 2)))
                    \n (do (.append sb (char 10)) (recur (+ i 2)))
                    \r (do (.append sb (char 13)) (recur (+ i 2)))
                    \v (do (.append sb (char 11)) (recur (+ i 2)))
                    \a (do (.append sb (char 7)) (recur (+ i 2)))
                    (\0 \1 \2 \3 \4 \5 \6 \7)
                    (let [e (loop [k (inc i) m 0] (if (and (< k n) (< m 3) (<= (int \0) (int (.charAt body k)) (int \7))) (recur (inc k) (inc m)) k))
                          v (Integer/parseInt (subs body (inc i) e) 8)]
                      (if bytes? (.append sb (char (bit-and v 0xFF))) (.appendCodePoint sb v))
                      (recur (long e)))
                    \x (do (if bytes? (.append sb (char (hex (+ i 2) (+ i 4)))) (.appendCodePoint sb (hex (+ i 2) (+ i 4)))) (recur (+ i 4)))
                    \u (if bytes?
                         (do (.append sb \\) (.append sb d) (recur (+ i 2)))
                         (do (.append sb (char (hex (+ i 2) (+ i 6)))) (recur (+ i 6))))
                    \U (if bytes?
                         (do (.append sb \\) (.append sb d) (recur (+ i 2)))
                         (let [v (hex (+ i 2) (+ i 10))]
                           (if (< v 0x10000) (.append sb (char v)) (.appendCodePoint sb v)) (recur (+ i 10))))
                    \N (if bytes?
                         (do (.append sb \\) (.append sb d) (recur (+ i 2)))
                         (let [e (.indexOf body "}" (int (+ i 3)))]
                           (.appendCodePoint sb (int (Character/codePointOf (subs body (+ i 3) e))))
                           (recur (inc (long e)))))
                    (do (.append sb \\) (.append sb d) (recur (+ i 2)))))))))
        (chars (str sb))))))

(defn constant-from-string
  "_PyPegen_constant_from_string: a bytes literal's non-ASCII characters and the escapes' errors raised"
  [p t]
  (let [[bytes? raw? body] (string-body (:string t))]
    (when (and bytes? (some #(>= (int %) 128) body))
      (syntax-error-at p t "bytes can only contain ASCII literal characters"))
    (when-let [[w m] (decode-check bytes? raw? body)]
      (raise-error p "SyntaxError" false "(%s) %U" w m))
    (let [v (decode-value body bytes? raw?)]
      (cond-> {:t :Constant :value (if bytes? [:bytes] [:str]) :kind (when (str/starts-with? (:string t) "u") "u")
               :lineno (:lineno t) :col_offset (:col_offset t) :end_lineno (:end_lineno t) :end_col_offset (:end_col_offset t)}
        bytes? (assoc :bv v)
        (not bytes?) (assoc :sv v)))))

(defn constant-from-token [p t]
  {:t :Constant :value [:str] :kind nil :lineno (:lineno t) :col_offset (:col_offset t) :end_lineno (:end_lineno t)
   :end_col_offset (:end_col_offset t) :middle (:string t)})

(defn decoded-constant-from-token
  "_PyPegen_decoded_constant_from_token: a format spec's text, decoded (raw in a raw f-string); a decoding error is
  the codec's own exception"
  [^Parser p t]
  (when-let [[w m] (decode-check false (lex/raw-fstring? (.-lx p)) (:string t))]
    (throw (ex-info m {:python-error [(if (= w "unicode error") "UnicodeDecodeError" "ValueError") m nil nil nil nil nil]})))
  (-> (constant-from-token p t) (dissoc :middle) (assoc :sv (decode-value (:string t) false (lex/raw-fstring? (.-lx p))))))

(defn- decode-fstring-parts
  "_get_resized_exprs' _PyPegen_decode_fstring_part: each literal part decoded (its value :sv), its error at the part"
  [p a raw]
  (let [is-raw (boolean (re-find #"[rR]" (:string a)))]
    (mapv (fn [x]
            (if (and (= :Constant (:t x)) (:middle x))
              (let [^String m (:middle x) m (if (#{"{{" "}}"} m) (subs m 0 1) m)]
                (when-let [[w msg] (decode-check false is-raw m)]
                  (syntax-error-at p x "(%s) %U" w msg))
                (assoc x :sv (decode-value m false is-raw)))
              x))
          raw)))

(defn- flat-values
  "_get_resized_exprs: a debug field's [Constant, FormattedValue] pair spliced in"
  [raw]
  (vec (mapcat (fn [x] (if (and (= :JoinedStr (:t x)) (:debug-pair x)) (:values x) [x])) raw)))

(defn joined-str [p a raw b]
  {:t :JoinedStr :values (flat-values (decode-fstring-parts p a raw)) :lineno (:lineno a) :col_offset (:col_offset a) :end_lineno (:end_lineno b)
   :end_col_offset (:end_col_offset b)})

(defn template-str [p a raw b]
  {:t :TemplateStr :values (flat-values (decode-fstring-parts p a raw)) :lineno (:lineno a) :col_offset (:col_offset a) :end_lineno (:end_lineno b)
   :end_col_offset (:end_col_offset b)})

(defn concatenate-strings [p strings ex]
  (let [kinds (map (fn [e] (case (:t e) :Constant (if (= :bytes (first (:value e))) :bytes :str) :f)) strings)
        bytes (some #{:bytes} kinds)]
    (when (and bytes (some #{:str :f} kinds))
      (raise-error p "SyntaxError" false "cannot mix bytes and nonbytes literals"))
    (cond
      (not (some #{:f} kinds)) (if (= 1 (count strings))
                                 (first strings)
                                 (into (if bytes
                                         {:t :Constant :value [:bytes] :kind (:kind (first strings)) :bv (vec (mapcat :bv strings))}
                                         {:t :Constant :value [:str] :kind (:kind (first strings)) :sv (apply str (map :sv strings))})
                                       ex))
      ;; :concat: _build_concatenated_str's folding of adjacent constants and dropping of empty ones (astjson's)
      :else (into {:t :JoinedStr :values (vec (mapcat #(if (= :JoinedStr (:t %)) (:values %) [%]) strings)) :concat true} ex))))

(defn concatenate-tstrings [p strings ex]
  (into {:t :TemplateStr :values (vec (mapcat #(if (#{:JoinedStr :TemplateStr} (:t %)) (:values %) [%]) strings)) :concat true} ex))

(defn check-fstring-conversion
  "_PyPegen_check_fstring_conversion"
  [^Parser p conv-token conv]
  (when (or (not (c= (:lineno conv-token) (:lineno conv))) (not (c= (:end_col_offset conv-token) (:col_offset conv))))
    (RAISE-SYNTAX-ERROR-KNOWN-RANGE* p conv-token conv "%c-string: conversion type must come right after the exclamation mark"
                                     (lex/string-prefix-char (.-lx ^Parser p))))
  (let [^String id (:id conv)]
    (when (or (> (.codePointCount id 0 (.length id)) 1) (not (#{"s" "r" "a"} id)))
      (syntax-error-at p conv "%c-string: invalid conversion character %R: expected 's', 'r', or 'a'"
                       (lex/string-prefix-char (.-lx ^Parser p)) id)))
  {:result conv :metadata (:metadata conv-token)})

(defn setup-full-format-spec [p colon spec ex]
  (let [spec (vec (remove #(and (= :Constant (:t %)) (= [:str] (:value %)) (= "" (:sv %))) spec))
        res (if (or (empty? spec) (and (= 1 (count spec)) (= :Constant (:t (first spec)))))
              (into {:t :JoinedStr :values spec} ex)
              (concatenate-strings p spec ex))]
    {:result res :metadata (:metadata colon)}))

(defn- conversion-val [debug conversion format]
  (cond
    conversion (long (int (.charAt ^String (:id (:result conversion)) 0)))
    (and debug (not format)) 114
    :else -1))

(defn- debug-end [conversion format ex closing]
  (cond
    conversion [(:lineno (:result conversion)) (:col_offset (:result conversion)) (:metadata conversion)]
    format [(:lineno (:result format)) (inc (long (:col_offset (:result format)))) (:metadata format)]
    :else [(:end_lineno ex) (:end_col_offset ex) (:metadata closing)]))

(defn- strip-debug-expr
  "_strip_interpolation_debug_expr"
  [^String s]
  (let [len (long (loop [len (count s)]
              (let [[len nl] (loop [len len nl false]
                               (if (and (pos? len) (Character/isWhitespace (.charAt s (dec len))))
                                 (recur (dec len) (or nl (#{\return \newline} (.charAt s (dec len)))))
                                 [len nl]))]
                (if (or (not nl) (zero? len) (not= (.charAt s (dec len)) \\))
                  len
                  (recur (dec (long len)))))))]
    (if (or (zero? len) (not= (.charAt s (dec len)) \=)) s (subs s 0 (dec len)))))

(defn- with-debug [p node debug conversion format closing ex]
  (if-not debug
    node
    (let [[del deo meta] (debug-end conversion format ex closing)
          text {:t :Constant :value [:str] :kind nil :lineno (:lineno ex) :col_offset (inc (long (:col_offset ex)))
                :end_lineno del :end_col_offset (dec (long deo)) :debug-text meta :sv meta}]
      {:t :JoinedStr :values [text node] :debug-pair true :lineno (:lineno ex) :col_offset (:col_offset ex)
       :end_lineno del :end_col_offset deo})))

(defn formatted-value [p expression debug conversion format closing ex]
  (with-debug p (into {:t :FormattedValue :value expression :conversion (conversion-val debug conversion format)
                       :format_spec (:result format)} ex)
    debug conversion format closing ex))

(defn interpolation [p expression debug conversion format closing ex]
  (let [exprstr (cond conversion (:metadata conversion) format (:metadata format) :else (:metadata closing))
        s (if debug (strip-debug-expr exprstr) exprstr)]
    (with-debug p (into {:t :Interpolation :value expression :str s :conversion (conversion-val debug conversion format)
                         :format_spec (:result format)} ex)
      debug conversion format closing ex)))

;; ---- the error helpers of the grammar's actions (the invalid_ rules of the second pass; pegen.h's RAISE_* macros,
;; action_helpers.c's error helpers)

(defn PyErr-Occurred [& _] false)

(defn RAISE-SYNTAX-ERROR [p msg & args] (apply raise-error p "SyntaxError" false msg args))
(defn RAISE-INDENTATION-ERROR [p msg & args] (apply raise-error p "IndentationError" false msg args))
(defn RAISE-SYNTAX-ERROR-ON-NEXT-TOKEN [p msg & args] (apply raise-error p "SyntaxError" true msg args))
(defn RAISE-SYNTAX-ERROR-KNOWN-LOCATION [p a msg & args] (apply syntax-error-at p a msg args))
(defn RAISE-SYNTAX-ERROR-KNOWN-RANGE* [p a b msg & args]
  (apply RAISE-ERROR-KNOWN-LOCATION p :SyntaxError (:lineno a) (:col_offset a) (:end_lineno b) (:end_col_offset b) msg args))
(def RAISE-SYNTAX-ERROR-KNOWN-RANGE RAISE-SYNTAX-ERROR-KNOWN-RANGE*)
(defn RAISE-SYNTAX-ERROR-STARTING-FROM [p a msg & args]
  (apply RAISE-ERROR-KNOWN-LOCATION p :SyntaxError (:lineno a) (:col_offset a) CURRENT-POS CURRENT-POS msg args))

(defn get-expr-name
  "_PyPegen_get_expr_name"
  [e]
  (case (:t e)
    :Attribute "attribute" :Subscript "subscript" :Starred "starred" :Name "name" :List "list" :Tuple "tuple"
    :Lambda "lambda" :Call "function call" (:BoolOp :BinOp :UnaryOp) "expression" :GeneratorExp "generator expression"
    (:Yield :YieldFrom) "yield expression" :Await "await expression" :ListComp "list comprehension"
    :SetComp "set comprehension" :DictComp "dict comprehension" :Dict "dict literal" :Set "set display"
    (:JoinedStr :FormattedValue) "f-string expression" (:TemplateStr :Interpolation) "t-string expression"
    :Constant (case (:value e) :None "None" :False "False" :True "True" :Ellipsis "ellipsis" "literal")
    :Compare "comparison" :IfExp "conditional expression" :NamedExpr "named expression"
    (throw (ex-info (str "unexpected expression in assignment " (:t e) " (line " (:lineno e) ")")
                    {:python-error ["SystemError" (str "unexpected expression in assignment " (:t e) " (line " (:lineno e) ")") nil nil nil nil nil]}))))

(defn get-invalid-target
  "_PyPegen_get_invalid_target"
  [e targets-type]
  (when e
    (case (:t e)
      (:List :Tuple) (some #(get-invalid-target % targets-type) (:elts e))
      :Starred (if (= targets-type :DEL_TARGETS) e (get-invalid-target (:value e) targets-type))
      :Compare (if (= targets-type :FOR_TARGETS)
                 (when (= :In (first (:ops e))) (get-invalid-target (:left e) targets-type))
                 e)
      (:Name :Subscript :Attribute) nil
      e)))

(defn RAISE-SYNTAX-ERROR-INVALID-TARGET
  "_RAISE_SYNTAX_ERROR_INVALID_TARGET: nil when the target has no invalid part"
  [p targets-type e]
  (when-let [t (get-invalid-target e targets-type)]
    (syntax-error-at p t (if (#{:STAR_TARGETS :FOR_TARGETS} targets-type) "cannot assign to %s" "cannot delete %s")
                     (get-expr-name t))))

(defn get-last-comprehension-item
  "_PyPegen_get_last_comprehension_item"
  [c]
  (if (empty? (:ifs c)) (:iter c) (last (:ifs c))))

(defn arguments-parsing-error
  "_PyPegen_arguments_parsing_error"
  [p e]
  (RAISE-SYNTAX-ERROR p (if (some #(nil? (:arg %)) (:keywords e))
                          "positional argument follows keyword argument unpacking"
                          "positional argument follows keyword argument")))

(defn nonparen-genexp-in-call
  "_PyPegen_nonparen_genexp_in_call"
  [p args comprehensions]
  (let [as (:args args)]
    (when (> (count as) 1)
      (RAISE-SYNTAX-ERROR-KNOWN-RANGE* p (last as) (get-last-comprehension-item (last comprehensions))
                                       "Generator expression must be parenthesized"))))

(defn token-string [t] (:string t))

;; ---- the run (pegen.c's _PyPegen_run_parser, pegen_errors.c's _Pypegen_set_syntax_error)

(def ^:const ^:private E_DONE 16)

(defn- error-of-ex [x] (when (instance? arbace.lang.ExceptionInfo x) (:python-error (ex-data x))))
(defn- syntax-class? [cls] (contains? #{"SyntaxError" "IndentationError" "TabError"} cls))
(defn- caught [f] (try (f) nil (catch arbace.lang.ExceptionInfo e (if (error-of-ex e) e (throw e)))))

(defn- full-source-check
  "_PyPegen_tokenize_full_source_to_check_for_errors: the rest of the source tokenized; a tokenizer error, or a bracket
  left open on a line before the error's, replaces the error `e` (outside an f-string); the error to raise"
  [^Parser p e]
  (let [l (lx p)
        ^java.util.ArrayList toks (.-toks p)
        err-line (long (:lineno (.get toks (dec (.size toks)))))
        r (loop []
            (let [type (lex/next-token l)]
              (cond
                (== type lex/ERRORTOKEN)
                (if-let [x (lex/error-of l)]
                  (ex-info "the tokenizer's error" {:python-error (vec x) :tokenizer true})
                  (when-let [[_ line _] (lex/paren-top l)]
                    (when (> err-line (long line)) (caught #(unclosed-paren-error p)))))
                (== type lex/ENDMARKER) nil
                :else (recur))))]
    (if (and r (<= (lex/state l :midx) 0)) r e)))

(defn- set-syntax-error
  "_Pypegen_set_syntax_error: the error to raise after the second pass, `e` the error raised in either pass or nil"
  [^Parser p last-token e]
  (let [l (lx p) done (lex/state l :done)]
    (if e
      (if (and (or (== done E_DONE) (== done lex/E_OK)) (syntax-class? (first (error-of-ex e))))
        (full-source-check p e)
        e)
      (or (caught
            #(cond
               (zero? (fill p)) (raise-error p "SyntaxError" false "error at start before reading any input")
               (and (== lex/ERRORTOKEN (long (:type last-token))) (== done lex/E_EOF))
               (if (pos? (lex/state l :level))
                 (unclosed-paren-error p)
                 (raise-error p "SyntaxError" false "unexpected EOF while parsing"))
               (#{lex/INDENT lex/DEDENT} (long (:type last-token)))
               (raise-error p "IndentationError" false (if (== lex/INDENT (long (:type last-token))) "unexpected indent" "unexpected unindent"))))
          (full-source-check p (caught #(syntax-error-at p last-token "invalid syntax")))))))

(defn- bad-single-statement?
  "bad_single_statement: something but white space and comments after the statement"
  [^Parser p]
  (let [l (lx p) n (lex/text-length l)]
    (loop [i (lex/state l :cur)]
      (let [i (loop [i i] (if (and (< i n) (#{32 9 10 12} (lex/char-at l i))) (recur (inc i)) i))]
        (cond
          (>= i n) false
          (not= 35 (lex/char-at l i)) true
          :else (recur (loop [i i] (if (and (< i n) (not= 10 (lex/char-at l i))) (recur (inc i)) i))))))))

(defn run-parser
  "_PyPegen_run_parser: the tree of start rule `rule`, or throws the error ast.parse raises (ex-data :python-error):
  on a failure the second pass, with the invalid_ rules, then the error by the parser's and tokenizer's state.
  Options: :incomplete (PyPARSE_ALLOW_INCOMPLETE_INPUT: a failure at the end of the source is \"incomplete input\"),
  :single (Py_single_input: one statement)"
  [^Parser p rule & [opts]]
  (let [res (try (rule p) (catch arbace.lang.ExceptionInfo e (if (error-of-ex e) e (throw e))))]
    (if (and (some? res) (not (instance? arbace.lang.ExceptionInfo res)))
      (if (and (:single opts) (bad-single-statement? p))
        (raise-error p "SyntaxError" false "multiple statements found while compiling a single statement")
        res)
      (let [e1 (when (instance? arbace.lang.ExceptionInfo res) res)
            done (lex/state (lx p) :done)]
        (when (and (:incomplete opts) (#{lex/E_EOF lex/E_EOFS lex/E_EOLS} done))
          (raise-error p "IncompleteInputError" false "incomplete input"))
        (when (and e1 (not (syntax-class? (first (error-of-ex e1))))) (throw e1))
        (let [^java.util.ArrayList toks (.-toks p)
              last-token (when (pos? (.size toks)) (.get toks (dec (.size toks))))
              ;; reset_parser_state_for_error_pass; an error already raised ends the second pass at once
              e2 (or e1
                     (do (.clear ^java.util.HashMap (.-memo p))
                         (reset p 0)
                         (set-call-invalid p true)
                         (caught #(rule p))))]
          (throw (set-syntax-error p last-token e2)))))))

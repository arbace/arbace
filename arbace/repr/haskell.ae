(ns arbace.repr.haskell
  "Command line of repr/haskell (doc/haskell/SPEC.md, doc/haskell/HASKELL-NOTES.md), run by
  bin/repr-haskell as -m arbace.repr.haskell VERB ...:

    read [--jobs N] [-o DIR] [--report FILE] [--only REGEX] (--root DIR | DUMP...)
        each helper dump (tools/hsdump) to Haskell forms: DIR/[PKG/]hs/M.ae (SPEC §2.1), read back
        and compared with the forms in memory (every bare name, literal and form checked, H3); a
        dump of mode :full (hsdump dump --full) to forms of mode :full (SPEC §7.2,
        arbace.repr.haskell.full), the full layout's tokens checked against the source's.
        With --root, the dumps are ROOT/PKG/FILE.edn (bin/repr-haskell's corpus layout).
    print [--jobs N] [-o DIR] [--layout braces|full] (--root DIR | FORMS.ae...)
        the printer (SPEC §7.4): each forms file to DIR/[PKG/]FILE, FILE its hs/module's :file;
        forms of mode :full in the full layout (the original text, byte for byte), others (and
        with --layout braces any) in the braces layout.
    compare --corpus FILE --orig DIR --cand DIR --known FILE --report FILE [--forms-report FILE]
            [--only REGEX] [--times TEXT]
        the round trip's tree level (SPEC §9.2): for each module of the corpus, the helper's tree
        and lines of the original (ORIG/PKG/FILE.tree, .lines) against the printed module's
        (CAND/PKG.trees/FILE.tree, .lines); the known differences FILE (a map from PKG/FILE to its
        reason) excuse a module, and a listed module that no longer differs is a failure.
    compare-text --corpus FILE --src DIR --views DIR --cand DIR --trees DIR --known FILE
            --report FILE [--forms-report FILE] [--only REGEX] [--times TEXT]
        the round trip's text level (SPEC §9.1, mode :full): for each module of the corpus, the
        printed file (CAND/PKG/FILE) against its original (SRC/DIR/FILE), or a CPP module's
        module view (VIEWS/PKG/FILE.view), byte for byte; then the helper's trees in mode :full
        and lines of both (TREES/orig/PKG/FILE.tree, .lines; TREES/cand/...).
    compare-iface --corpus FILE --orig DIR --cand DIR --printed DIR --builds DIR --known FILE
            --report FILE [--mode lines|full] [--only REGEX] [--times TEXT] [--prune]
        the round trip's interface level (SPEC §9.3): for each converted module, ghc --show-iface
        of its original's interface (ORIG/PKG/M.iface) against its printed module's (CAND/PKG/M.iface),
        compared after normalize-iface (mode :lines by default); PRINTED holds the printed modules,
        BUILDS the build logs (BUILDS/cand/PKG.build.log), for a module that did not compile;
        --prune removes the texts of the modules found equal."
  (:require [arbace.repr.haskell.convert :as cv]
            [arbace.repr.haskell.full :as fl]
            [arbace.repr.haskell.write :as wr]
            [arbace.repr.haskell.print :as pr]
            [arbace.string :as str])
  (:import [java.io File]))

(defn- parse-args
  "{:opts {...} :args [...]}; flags with a value: those in with-value"
  [args with-value]
  (loop [as args opts {} pos []]
    (if (empty? as)
      {:opts opts :args pos}
      (let [[a & more] as]
        (cond
          (contains? with-value a) (recur (rest more) (assoc opts a (first more)) pos)
          (str/starts-with? a "--") (recur more (assoc opts a true) pos)
          :else (recur more opts (conj pos a)))))))

(defn- files-under [^String dir ext]
  (->> (file-seq (File. dir))
       (filter #(and (.isFile ^File %) (str/ends-with? (.getName ^File %) ext)))
       (map #(.getPath ^File %))
       sort))

(defn- rel [^String root ^String path]
  (let [r (str (.getCanonicalPath (File. root)) "/")
        p (.getCanonicalPath (File. path))]
    (if (str/starts-with? p r) (subs p (count r)) path)))

(defn- pmap-jobs
  "f over xs on n threads, in order"
  [n f xs]
  (let [xs (vec xs)
        pool (java.util.concurrent.Executors/newFixedThreadPool (max 1 n))
        futs (mapv (fn [x] (.submit pool ^java.util.concurrent.Callable (fn [] (f x)))) xs)
        res (mapv #(.get ^java.util.concurrent.Future %) futs)]
    (.shutdown pool)
    res))

(defn ns-path
  "The forms file of a namespace (SPEC §2.1): its segments munged, hs/Data/Map/Strict.ae"
  [ns-sym]
  (str (str/join "/" (map #(str (munge %)) (str/split (str ns-sym) #"\."))) ".ae"))

(defn- dumped
  "The dump's form (sym ...)'s value, or nil"
  [dump sym]
  (some #(when (and (seq? %) (= sym (first %))) (second %)) dump))

(defn convert-dump
  "A dump's forms to Haskell forms: {:ns :forms :warnings}; a dump of mode :full (hsdump dump
  --full) to forms of mode :full (arbace.repr.haskell.full), checked against the full layout's
  tokens"
  [dump module-file]
  (if (= :full (:positions (dumped dump 'hsdump/config)))
    (let [text (or (dumped dump 'hsdump/text) (throw (ex-info "a dump of mode :full without its text" {})))
          toks (or (dumped dump 'hsdump/tokens)
                   (throw (ex-info (str "a dump of mode :full without its tokens: " (pr-str (dumped dump 'hsdump/tokens-error))) {})))
          source (fl/tokens-of text toks)
          {:keys [ns forms warnings]} (binding [cv/*full* true cv/*tokens* (:toks source)]
                                        (cv/convert-module dump module-file))
          text0 (wr/forms-text forms)
          read0 (wr/read-all text0)
          _ (when-let [d (wr/check-read forms read0)] (throw (ex-info (str "the forms text misreads: " (pr-str d)) {})))]
      {:ns ns :warnings warnings :forms (fl/full-forms forms read0 text source)})
    (cv/convert-module dump module-file)))

(defn read-dump
  "Converts one dump: {:dump :ns :out :status :error :warnings :forms}"
  [dump-path module-file out-file-fn]
  (try
    (let [text (slurp dump-path)
          forms (read-string (str "[" text "]"))
          {:keys [ns forms warnings]} (convert-dump forms module-file)
          out (out-file-fn ns)
          ftext (wr/forms-text forms)
          d (wr/check forms ftext)]
      (.mkdirs (.getParentFile (File. ^String out)))
      (spit out ftext)
      (if d
        {:dump dump-path :ns ns :out out :status :misread :error (pr-str d) :warnings warnings}
        {:dump dump-path :ns ns :out out :status :ok :warnings warnings :forms (count forms)}))
    (catch Throwable e
      {:dump dump-path :status :error :error (or (.getMessage e) (str e))})))

(defn- cmd-read [args]
  (let [{:keys [opts args]} (parse-args args #{"--jobs" "-o" "--report" "--root" "--only"})
        jobs (Long/parseLong (get opts "--jobs" "8"))
        out (get opts "-o" ".tmp/repr-haskell/forms/files")
        root (get opts "--root")
        only (some-> (get opts "--only") re-pattern)
        dumps (if root (files-under root ".edn") args)
        dumps (if only (filter #(re-find only (str %)) dumps) dumps)
        work (for [d dumps]
               (let [r (if root (rel root d) (.getName (File. ^String d)))
                     [pkg file] (if root
                                  (let [i (.indexOf ^String r "/")] [(subs r 0 i) (subs r (inc i))])
                                  [nil r])
                     file (str/replace file #"\.edn$" "")]
                 [d pkg file]))
        t0 (System/currentTimeMillis)
        results (pmap-jobs jobs (fn [[d pkg file]]
                                  (assoc (read-dump d file (fn [ns] (str out "/" (when pkg (str pkg "/")) (ns-path ns))))
                                         :pkg pkg :file file))
                           work)
        t1 (System/currentTimeMillis)
        by (group-by :status results)
        warnings (apply merge-with + (map :warnings results))]
    (doseq [r results :when (not= :ok (:status r))]
      (println (name (:status r)) (:dump r) (:error r)))
    (println (format "repr-haskell read: %d dumps, %d converted, %d misread, %d failed, %d forms, in %.1f s"
                     (count results) (count (:ok by)) (count (:misread by)) (count (:error by))
                     (reduce + (keep :forms results)) (/ (- t1 t0) 1000.0)))
    (doseq [[k n] (sort-by (comp - val) warnings)] (println "warning" (pr-str k) n))
    (when-let [rep (get opts "--report")]
      (spit rep (with-out-str
                  (prn {:dumps (count results) :ok (count (:ok by)) :misread (count (:misread by))
                        :errors (count (:error by)) :seconds (/ (- t1 t0) 1000.0)
                        :warnings warnings
                        :modules (into (sorted-map) (for [r results] [(str (:pkg r) "/" (:file r))
                                                                      (cond-> {:status (:status r)}
                                                                        (:ns r) (assoc :ns (str (:ns r)) :out (:out r))
                                                                        (:error r) (assoc :error (:error r)))]))}))))
    (if (= (count results) (count (:ok by))) 0 1)))

(defn- cmd-print [args]
  (let [{:keys [opts args]} (parse-args args #{"--jobs" "-o" "--root" "--only" "--layout"})
        jobs (Long/parseLong (get opts "--jobs" "8"))
        layout (some-> (get opts "--layout") keyword)
        _ (when-not (contains? #{nil :braces :full} layout)
            (throw (ex-info (str "repr-haskell print: --layout braces|full, not " (name layout)) {})))
        out (get opts "-o" ".tmp/repr-haskell/printed")
        root (get opts "--root")
        only (some-> (get opts "--only") re-pattern)
        files (if root (files-under root ".ae") args)
        files (if only (filter #(re-find only (str %)) files) files)
        t0 (System/currentTimeMillis)
        results (pmap-jobs jobs
                           (fn [f]
                             (try
                               (let [pkg (when root (let [r (rel root f)] (subs r 0 (.indexOf ^String r "/"))))
                                     forms (wr/read-all (slurp f))
                                     {:keys [file text]} (pr/print-module forms layout)
                                     o (str out "/" (when pkg (str pkg "/")) file)]
                                 (.mkdirs (.getParentFile (File. ^String o)))
                                 (spit o text)
                                 {:file f :status :ok :out o})
                               (catch Throwable e
                                 {:file f :status :error :error (or (.getMessage e) (str e))})))
                           files)
        t1 (System/currentTimeMillis)
        bad (remove #(= :ok (:status %)) results)]
    (doseq [r bad] (println "error" (:file r) (:error r)))
    (println (format "repr-haskell print: %d forms files, %d printed, %d failed, in %.1f s"
                     (count results) (- (count results) (count bad)) (count bad) (/ (- t1 t0) 1000.0)))
    (if (empty? bad) 0 1)))

;;; The round trip's comparison

(defn- read-lines-file [^String f]
  (when (.exists (File. f)) (str/split-lines (slurp f))))

(defn- first-line-diff
  "The first difference between two line vectors: [index a b]"
  [a b]
  (let [n (max (count a) (count b))]
    (loop [i 0]
      (when (< i n)
        (let [x (get a i) y (get b i)]
          (if (= x y) (recur (inc i)) [i x y]))))))

(defn- context-of [lines i]
  (str/join "\n" (subvec lines (max 0 (- i 6)) (min (count lines) (+ i 3)))))

(defn compare-module
  "The tree level of one module: {:tree :ok|:differs|:missing :lines :ok|:differs ...}"
  [orig-tree cand-tree orig-lines cand-lines]
  (let [ot (read-lines-file orig-tree)
        ct (read-lines-file cand-tree)
        ol (read-lines-file orig-lines)
        cl (read-lines-file cand-lines)]
    (cond
      (nil? ot) {:level :tree :status :no-original}
      (nil? ct) {:level :tree :status :not-printed}
      (str/starts-with? (first ct) "hsdump/error") {:level :tree :status :printed-fails-to-parse :detail (first ct)}
      (not= ot ct) (let [[i a b] (first-line-diff ot ct)]
                     {:level :tree :status :differs :at i :detail (context-of ot i) :cand (context-of ct i)})
      (not= ol cl) (let [[i a b] (first-line-diff ol cl)
                         n (count (filter (fn [[x y]] (not= x y)) (map vector ol cl)))]
                     {:level :lines :status :differs :at i :orig a :cand b :count n})
      :else {:status :ok})))

(defn- cmd-compare [args]
  (let [{:keys [opts]} (parse-args args #{"--corpus" "--orig" "--cand" "--known" "--report" "--forms-report" "--only" "--times"})
        corpus (read-string (slurp (get opts "--corpus")))
        orig (get opts "--orig")
        cand (get opts "--cand")
        known-file (get opts "--known")
        known (if (and known-file (.exists (File. ^String known-file))) (read-string (slurp known-file)) {})
        only (some-> (get opts "--only") re-pattern)
        forms-report (when-let [f (get opts "--forms-report")] (when (.exists (File. ^String f)) (read-string (slurp f))))
        mods (for [p (:packages corpus) [m f] (:modules p)
                   :let [k (str (:name p) "/" f)]
                   :when (or (nil? only) (re-find only k))]
               [k (:name p) f])
        results (pmap-jobs 16
                           (fn [[k pkg f]]
                             (let [conv (get-in forms-report [:modules k])]
                               [k (if (and conv (not= :ok (:status conv)))
                                    {:level :convert :status (:status conv) :detail (:error conv)}
                                    (compare-module (str orig "/" pkg "/" f ".tree") (str cand "/" pkg ".trees/" f ".tree")
                                                    (str orig "/" pkg "/" f ".lines") (str cand "/" pkg ".trees/" f ".lines")))]))
                           mods)
        ok (filter #(= :ok (:status (second %))) results)
        failing (remove #(= :ok (:status (second %))) results)
        unexpected (remove #(contains? known (first %)) failing)
        fixed (filter #(and (contains? known (first %)) (= :ok (:status (second %)))) results)
        by-level (frequencies (map (comp :level second) failing))]
    (doseq [[k r] unexpected]
      (println "DIFFERS" k (pr-str (dissoc r :detail :cand)))
      (when (:detail r) (println "  original:\n" (:detail r)))
      (when (:cand r) (println "  printed:\n" (:cand r))))
    (doseq [[k _] fixed] (println "FIXED (listed as known, no longer differs)" k))
    (doseq [[k r] failing :when (contains? known k)] (println "known" k (pr-str (select-keys r [:level :status])) "--" (get known k)))
    (println (format "repr-haskell roundtrip (tree level): %d modules, %d equal (trees and lines), %d differ (%s), %d known, %d unexpected, %d fixed%s"
                     (count results) (count ok) (count failing) (pr-str by-level)
                     (count (filter #(contains? known (first %)) failing)) (count unexpected) (count fixed)
                     (if-let [t (get opts "--times")] (str "; seconds: " t) "")))
    (when-let [rep (get opts "--report")]
      (spit rep (with-out-str
                  (prn {:modules (count results) :equal (count ok) :differ (count failing)
                        :by-level by-level :unexpected (mapv first unexpected) :fixed (mapv first fixed)
                        :times (get opts "--times")
                        :results (into (sorted-map) (for [[k r] results] [k (dissoc r :detail :cand)]))}))))
    (if (and (empty? unexpected) (empty? fixed)) 0 1)))

;;; The round trip's text level (SPEC §9.1, mode :full; R3)

(defn- file-bytes [^String f]
  (let [x (File. f)] (when (.isFile x) (java.nio.file.Files/readAllBytes (.toPath x)))))

(defn- first-byte-diff
  "The first offset at which byte arrays a and b differ"
  [^bytes a ^bytes b]
  (let [n (min (alength a) (alength b))]
    (loop [i 0] (if (and (< i n) (= (aget a i) (aget b i))) (recur (inc i)) i))))

(defn- line-col-at
  "[line col] (1-based, bytes) of offset i in bytes a"
  [^bytes a i]
  (loop [j 0 l 1 c 1]
    (if (< j i) (if (= 10 (aget a j)) (recur (inc j) (inc l) 1) (recur (inc j) l (inc c))) [l c])))

(defn compare-text
  "The text level of one module: the printed file against its reference (the original, or a CPP
  module's module view), byte for byte; then GHC's trees of mode :full (hsdump tree --full) and
  lines of both: {:status :ok} or {:level :text|:tree|:lines :status ...}"
  [printed reference orig-tree cand-tree orig-lines cand-lines]
  (let [a (file-bytes reference) b (file-bytes printed)]
    (cond
      (nil? a) {:level :text :status :no-reference}
      (nil? b) {:level :text :status :not-printed}
      (not (java.util.Arrays/equals ^bytes a ^bytes b))
      (let [i (first-byte-diff a b)
            ctx (fn [^bytes x] (let [s (max 0 (- i 40)) e (min (alength x) (+ i 40))]
                                 (String. x (int s) (int (- e s)) "UTF-8")))]
        {:level :text :status :differs :at (line-col-at a i) :bytes [(alength a) (alength b)]
         :detail (ctx a) :cand (ctx b)})
      :else (assoc (compare-module orig-tree cand-tree orig-lines cand-lines) :size (alength a)))))

(defn- cmd-compare-text [args]
  (let [{:keys [opts]} (parse-args args #{"--corpus" "--src" "--views" "--cand" "--trees" "--known" "--report"
                                          "--forms-report" "--only" "--times"})
        corpus (read-string (slurp (get opts "--corpus")))
        src (get opts "--src") views (get opts "--views") cand (get opts "--cand") trees (get opts "--trees")
        known-file (get opts "--known")
        known (if (and known-file (.exists (File. ^String known-file))) (read-string (slurp known-file)) {})
        only (some-> (get opts "--only") re-pattern)
        forms-report (when-let [f (get opts "--forms-report")] (when (.exists (File. ^String f)) (read-string (slurp f))))
        mods (for [p (:packages corpus) [m f] (:modules p)
                   :let [k (str (:name p) "/" f)]
                   :when (or (nil? only) (re-find only k))]
               [k p f])
        results (pmap-jobs 16
                           (fn [[k p f]]
                             (let [conv (get-in forms-report [:modules k])
                                   view (str views "/" (:name p) "/" f ".view")
                                   cpp? (.isFile (File. view))]
                               [k (assoc (if (and conv (not= :ok (:status conv)))
                                           {:level :convert :status (:status conv) :detail (:error conv)}
                                           (compare-text (str cand "/" (:name p) "/" f)
                                                         (if cpp? view (str src "/" (:dir p) "/" f))
                                                         (str trees "/orig/" (:name p) "/" f ".tree") (str trees "/cand/" (:name p) "/" f ".tree")
                                                         (str trees "/orig/" (:name p) "/" f ".lines") (str trees "/cand/" (:name p) "/" f ".lines")))
                                         :cpp cpp?)]))
                           mods)
        ok (filter #(= :ok (:status (second %))) results)
        failing (remove #(= :ok (:status (second %))) results)
        unexpected (remove #(contains? known (first %)) failing)
        fixed (filter #(and (contains? known (first %)) (= :ok (:status (second %)))) results)
        by-level (frequencies (map (comp :level second) failing))
        same-text (filter #(:size (second %)) results)
        bytes (reduce + 0 (keep #(:size (second %)) same-text))]
    (doseq [[k r] unexpected]
      (println "DIFFERS" k (pr-str (dissoc r :detail :cand)))
      (when (:detail r) (println "  original:\n" (:detail r)))
      (when (:cand r) (println "  printed:\n" (:cand r))))
    (doseq [[k _] fixed] (println "FIXED (listed as known, no longer differs)" k))
    (doseq [[k r] failing :when (contains? known k)] (println "known" k (pr-str (select-keys r [:level :status])) "--" (get known k)))
    (println (format "repr-haskell roundtrip (text level): %d modules (%d with CPP: their module views), %d byte-identical (%d bytes), %d also with equal trees and lines of mode :full; %d differ (%s), %d known, %d unexpected, %d fixed%s"
                     (count results) (count (filter #(:cpp (second %)) results)) (count same-text) bytes (count ok) (count failing) (pr-str by-level)
                     (count (filter #(contains? known (first %)) failing)) (count unexpected) (count fixed)
                     (if-let [t (get opts "--times")] (str "; seconds: " t) "")))
    (when-let [rep (get opts "--report")]
      (spit rep (with-out-str
                  (prn {:modules (count results) :byte-identical (count same-text) :bytes bytes :equal (count ok) :differ (count failing)
                        :by-level by-level :unexpected (mapv first unexpected) :fixed (mapv first fixed)
                        :times (get opts "--times")
                        :results (into (sorted-map) (for [[k r] results] [k (dissoc r :detail :cand)]))}))))
    (if (and (empty? unexpected) (empty? fixed)) 0 1)))

;;; The round trip's interface level (SPEC §9.3)

(def ^:private self-recomp-lines
  "The lines of ghc --show-iface dropped in both modes: the source's hash, the hash over the rest,
  and the hash of the flags (which include the output directory)"
  #"^\s*(src hash|interface hash|flags: fingerprint):")

(defn- core-arg-end
  "The end of the Core argument that starts at i in an unfolding's text: a parenthesized group, a
  string literal or an atom; nil at a closing bracket (no argument there)"
  [^String s i]
  (let [n (count s)]
    (loop [j i depth 0 in-str false]
      (if (>= j n)
        j
        (let [c (.charAt s j)]
          (cond
            in-str (cond (= c \\) (recur (+ j 2) depth true)
                         (= c \") (recur (inc j) depth false)
                         :else (recur (inc j) depth true))
            (= c \") (recur (inc j) depth true)
            (= c \() (recur (inc j) (inc depth) false)
            (contains? #{\) \] \}} c) (cond (pos? depth) (if (= depth 1) (inc j) (recur (inc j) (dec depth) false))
                                            (= j i) nil
                                            :else j)
            (and (zero? depth) (or (Character/isWhitespace c) (= c \,))) (if (= j i) nil j)
            :else (recur (inc j) depth false)))))))

(defn- skip-ws [^String s i]
  (loop [i i] (if (and (< i (count s)) (Character/isWhitespace (.charAt s i))) (recur (inc i)) i)))

(defn- core-args
  "The [start end] of the n Core arguments after position i, or nil when there are fewer"
  [^String s i n]
  (loop [i i acc []]
    (if (= (count acc) n)
      acc
      (let [b (skip-ws s i) e (when (< b (count s)) (core-arg-end s b))]
        (when (and e (> e b)) (recur e (conj acc [b e])))))))

(def ^:private srcloc-con
  "A construction of GHC.Internal.Stack.Types.SrcLoc in an unfolding: its constructor or its
  wrapper ($WSrcLoc), applied to package, module, file, start line, start column, end line, end
  column; not in a type (after ::, -> or =>) nor a declaration's head"
  #"(?<![\w.$'])(?:GHC\.Internal\.Stack\.Types\.)?\$?W?SrcLoc(?=\s)")

(defn blank-srcloc-columns
  "Every SrcLoc construction's two columns written _ (SPEC §9.3, mode :lines): the arguments
  themselves, and when an argument is a local variable (a stable unfolding of an INLINE function
  let-binds the call stack's parts: let { $dIP5 :: Int ... = I# 47# } in ... $WSrcLoc ... $dIP5 ...),
  the literal its let binds"
  [^String s]
  (let [m (re-matcher srcloc-con s)
        sb (StringBuilder.)
        vars (volatile! #{})]
    (loop [from 0]
      (if (.find m)
        (let [st (.start m) e (.end m)
              before (str/trimr (subs s (max 0 (- st 12)) st))
              args (when-not (or (< st from) (re-find #"(::|->|=>|data|type|newtype)$" before)) (core-args s e 7))]
          (if args
            (let [[[c1 c2] _ [c3 c4]] (subvec args 4 7)]
              (doseq [[b e] [[c1 c2] [c3 c4]]
                      :let [a (subs s b e)]
                      :when (re-matches #"[\p{L}_$][\w$'.]*" a)]
                (vswap! vars conj a))
              (.append sb (subs s from c1)) (.append sb "_")
              (.append sb (subs s c2 c3)) (.append sb "_")
              (recur c4))
            (recur from)))
        (.append sb (subs s from))))
    (reduce (fn [t v]
              (str/replace t (re-pattern (str "(let \\{\\s*" (java.util.regex.Pattern/quote v)
                                              " :: [^=]*=\\s*(?:GHC\\.Internal\\.Types\\.I#\\s+)?)-?\\d+#"))
                           "$1_"))
            (str sb) (sort @vars))))

(defn- indent-of [^String l] (count (re-find #"^ *" l)))

(defn sort-warnings
  "The entries of the Deprecated names: and Deprecated exports: lists of ghc --show-iface's
  text sorted: GHC prints them in an order that varies from build to build (a parallel build's
  uniques; R3, HASKELL-NOTES \"R2\": base's Data.Enum)"
  [^String t]
  (let [ls (vec (str/split-lines t))
        n (count ls)]
    (loop [i 0 out (transient [])]
      (if (< i n)
        (if-let [[_ pre label e1] (re-matches #"( *)(Deprecated (?:names|exports): )(.*)" (nth ls i))]
          (let [ind (count pre)
                col (+ ind (count label))
                j (loop [j (inc i)] (if (and (< j n) (> (indent-of (nth ls j)) ind)) (recur (inc j)) j))
                ;; an entry: a line at the list's column, the deeper lines after it its own
                entries (reduce (fn [acc l]
                                  (if (and (seq acc) (> (indent-of l) col))
                                    (conj (pop acc) (str (peek acc) "\n" l))
                                    (conj acc (subs l (min (count l) col)))))
                                [e1] (subvec ls (inc i) j))
                sorted (sort entries)
                lines (cons (str pre label (first sorted)) (map #(str (apply str (repeat col " ")) %) (rest sorted)))]
            (recur j (reduce conj! out (mapcat str/split-lines lines))))
          (recur (inc i) (conj! out (nth ls i))))
        (str/join "\n" (persistent! out))))))

(defn normalize-iface
  "ghc --show-iface's text as the interface level compares it (SPEC §9.3). Both modes drop the
  self-recompilation lines and sort the deprecation warnings' entries (sort-warnings); mode
  :lines also writes the spans of unfoldings' strings as lines
  (N.hs:3:1-14 -> N.hs:3, N.hs:(3,1)-(5,20) -> N.hs:3-5), blanks the two columns of SrcLoc
  constructions (SrcLoc pkg mod file 3# 1# 5# 20# -> 3# _ 5# _, also through $WSrcLoc and boxed
  arguments), every fingerprint (the ABI, export, orphan, usage and declaration hashes, which
  cover the columns), and the usages of the files CPP included (addDependentFile: the printed
  module is the preprocessed text, which includes none, SPEC §2.8)."
  [^String text mode]
  (let [t (sort-warnings (str/join "\n" (remove #(re-find self-recomp-lines %) (str/split-lines text))))]
    (if (= mode :full)
      t
      (-> t
          (str/replace #"([\w./'-]+\.(?:hs|hsc|lhs|hs-boot)):\((\d+),\d+\)-\((\d+),\d+\)" "$1:$2-$3")
          (str/replace #"([\w./'-]+\.(?:hs|hsc|lhs|hs-boot)):(\d+):\d+(?:-\d+)?" "$1:$2")
          blank-srcloc-columns
          (str/replace #"\b[0-9a-f]{32}\b" "<fingerprint>")
          (str/replace #"\s*addDependentFile \"[^\"]*\" <fingerprint>," "")
          (str/replace #",\s*addDependentFile \"[^\"]*\" <fingerprint>(?=\])" "")
          (str/replace #"\[\s*addDependentFile \"[^\"]*\" <fingerprint>\]" "[]")))))

(defn iface-units
  "What is compared of a normalized text: its lines in mode :full; in mode :lines its tokens
  (split at white space: the pretty printer's line breaks follow the widths of the columns)"
  [^String t mode]
  (if (= mode :full) (str/split-lines t) (str/split (str/trim t) #"\s+")))

(defn- build-error
  "The first error ghc --make reported for a module in a build log, or nil"
  [^String log ^String file]
  (when log
    (let [ls (str/split-lines log)
          i (first (keep-indexed (fn [i l] (when (and (str/starts-with? l file) (re-find #": error:" l)) i)) ls))]
      (when i (str/join "\n" (subvec ls i (min (count ls) (+ i 6))))))))

(defn compare-iface-module
  "The interface level of one module: {:status :ok|:differs|...}; a difference at the index of
  the first unit (line or token, iface-units) that differs, with the units around it"
  [orig-iface cand-iface printed log file mode]
  (let [o (when (.exists (File. ^String orig-iface)) (slurp orig-iface))
        c (when (.exists (File. ^String cand-iface)) (slurp cand-iface))]
    (cond
      (nil? o) {:level :iface :status :no-original}
      (not (.exists (File. ^String printed))) {:level :iface :status :not-printed}
      (nil? c) {:level :iface :status :printed-fails-to-compile :detail (build-error log file)}
      :else (let [a (iface-units (normalize-iface o mode) mode)
                  b (iface-units (normalize-iface c mode) mode)]
              (if (= a b)
                {:status :ok :lines (count (str/split-lines o))}
                (let [[i x y] (first-line-diff a b)
                      sep (if (= mode :full) "\n" " ")
                      around (fn [v] (str/join sep (subvec v (max 0 (- i 30)) (min (count v) (+ i 12)))))]
                  {:level :iface :status :differs :at i :orig x :cand y
                   :detail (around a) :cand-detail (around b)}))))))

(defn- cmd-compare-iface [args]
  (let [{:keys [opts]} (parse-args args #{"--corpus" "--orig" "--cand" "--printed" "--builds" "--known" "--report" "--only" "--times" "--mode"})
        corpus (read-string (slurp (get opts "--corpus")))
        mode (keyword (get opts "--mode" "lines"))
        known-file (get opts "--known")
        known (if (and known-file (.exists (File. ^String known-file))) (read-string (slurp known-file)) {})
        only (some-> (get opts "--only") re-pattern)
        logs (into {} (for [p (:packages corpus)
                            :let [f (File. (str (get opts "--builds") "/cand/" (:name p) ".build.log"))]
                            :when (.exists f)]
                        [(:name p) (slurp f)]))
        mods (for [p (:packages corpus) [m f] (:modules p)
                   :let [k (str (:name p) "/" f)]
                   :when (or (nil? only) (re-find only k))]
               [k (:name p) (str m) f])
        results (pmap-jobs 16
                           (fn [[k pkg m f]]
                             [k (compare-iface-module (str (get opts "--orig") "/" pkg "/" m ".iface")
                                                      (str (get opts "--cand") "/" pkg "/" m ".iface")
                                                      (str (get opts "--printed") "/" pkg "/" f)
                                                      (get logs pkg) f mode)])
                           mods)
        ok (filter #(= :ok (:status (second %))) results)
        failing (remove #(= :ok (:status (second %))) results)
        unexpected (remove #(contains? known (first %)) failing)
        fixed (filter #(and (contains? known (first %)) (= :ok (:status (second %)))) results)
        by-status (frequencies (map (comp :status second) failing))]
    (when (get opts "--prune")
      ;; the texts of the equal modules removed (the scratch stays small; SPEC §9.3)
      (doseq [[k r] ok :let [[_ pkg m] (first (filter #(= k (first %)) mods))]]
        (.delete (File. (str (get opts "--orig") "/" pkg "/" m ".iface")))
        (.delete (File. (str (get opts "--cand") "/" pkg "/" m ".iface")))))
    (doseq [[i [k r]] (map-indexed vector unexpected)]
      (println "DIFFERS" k (pr-str (dissoc r :detail :cand-detail)))
      (when (< i 20)
        (when (:detail r) (println "  original:\n" (:detail r)))
        (when (:cand-detail r) (println "  printed:\n" (:cand-detail r)))))
    (doseq [[k _] fixed] (println "FIXED (listed as known, no longer differs)" k))
    (doseq [[k r] failing :when (contains? known k)] (println "known" k (pr-str (select-keys r [:status :at])) "--" (get known k)))
    (println (format "repr-haskell roundtrip (interface level, %s): %d modules, %d equal, %d differ (%s), %d known, %d unexpected, %d fixed; %d lines of interfaces compared%s"
                     (name mode) (count results) (count ok) (count failing) (pr-str by-status)
                     (count (filter #(contains? known (first %)) failing)) (count unexpected) (count fixed)
                     (reduce + (keep (comp :lines second) results))
                     (if-let [t (get opts "--times")] (str "; seconds: " t) "")))
    (when-let [rep (get opts "--report")]
      (spit rep (with-out-str
                  (prn {:modules (count results) :equal (count ok) :differ (count failing) :mode mode
                        :by-status by-status :unexpected (mapv first unexpected) :fixed (mapv first fixed)
                        :times (get opts "--times")
                        :results (into (sorted-map) (for [[k r] results] [k (dissoc r :detail :cand-detail)]))}))))
    (if (and (empty? unexpected) (empty? fixed)) 0 1)))

(defn -main [& args]
  (let [[verb & more] args
        status (try
                 (case verb
                   "read" (cmd-read more)
                   "print" (cmd-print more)
                   "compare" (cmd-compare more)
                   "compare-iface" (cmd-compare-iface more)
                   "compare-text" (cmd-compare-text more)
                   (do (println "usage: -m arbace.repr.haskell read|print|compare|compare-iface|compare-text ...") 2))
                 (catch Throwable e
                   (.printStackTrace e)
                   1))]
    (shutdown-agents)
    (flush)
    (System/exit status)))

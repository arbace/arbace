;; Ported from modernc.org/cc/v4 v4.29.7 as go-whim carries it (https://github.com/arbace/go-whim at
;; 80c49bf53cd6340487ac623f3d6d135b77ac1db6, crefactor/cc/parser.go and c23.go, with the parts of
;; ast.go, ast2.go, cc.go and etc.go the parser uses: Scope, the declarators' names, the keywords,
;; Builtin, canonicalizeStrlitTail, errors.err), whose notice follows (LICENSE.md, "cc
;; (modernc.org/cc/v4) and go-whim's C23 delta"):
;;
;; Copyright 2021 The CC Authors. All rights reserved.
;; Use of this source code is governed by a BSD-style
;; license that can be found in the LICENSE file.
;;
;; go-whim's C23 delta (c23.go's productions and the hooks marked "go-whim" in parser.go, followed line
;; for line here and marked so) is licensed to Arbace under the EPL-1.0 (doc/C23-SURVEY.md, CS37 (a));
;; so are Arbace's own changes, each marked "Arbace:" below.

(ns arbace.repr.c.parse
  "C's parser, after cc's (modernc.org/cc/v4 parser.go with go-whim's C23 productions, c23.go;
  doc/C23-SURVEY.md, \"As built: C3\"): the recursive descent over arbace.repr.c.pp's stream, pulled as
  cc's parser pulls it (its lookahead, its sequence numbers, the typedef names told from identifiers by
  the scopes it builds as it goes), giving cc's tree (arbace.repr.c.tree: each node a map of its type,
  its case and its fields under cc's names) and cc's errors, in cc's order. `parse` reads a file;
  `-main` is bin/repr-c parse."
  (:require [arbace.repr.c.lex :as lex]
            [arbace.repr.c.pp :as pp]
            [arbace.repr.c.host :as host]
            [arbace.repr.c.tree :as tree :refer [node]]
            [arbace.string :as str])
  (:import [arbace.repr.c.lex Tok]
           [arbace.repr.c.tree PTok]
           [java.util ArrayList HashMap]))

(set! *warn-on-reflection* true)

;; ---------------------------------------------------------------------------------------------
;; Keywords (parser.go's defaultKeywords, cc.go's c23Keywords)

(def default-keywords
  {"_Bool" :BOOL "_Complex" :COMPLEX "_Imaginary" :IMAGINARY "auto" :AUTO "break" :BREAK "case" :CASE
   "char" :CHAR "const" :CONST "continue" :CONTINUE "default" :DEFAULT "do" :DO "double" :DOUBLE
   "else" :ELSE "enum" :ENUM "extern" :EXTERN "float" :FLOAT "for" :FOR "goto" :GOTO "if" :IF
   "inline" :INLINE "int" :INT "long" :LONG "register" :REGISTER "restrict" :RESTRICT "return" :RETURN
   "short" :SHORT "signed" :SIGNED "sizeof" :SIZEOF "static" :STATIC "struct" :STRUCT "switch" :SWITCH
   "typedef" :TYPEDEF "union" :UNION "unsigned" :UNSIGNED "void" :VOID "volatile" :VOLATILE "while" :WHILE
   ;; C11
   "_Alignas" :ALIGNAS "_Alignof" :ALIGNOF "_Atomic" :ATOMIC "_Generic" :GENERIC "_Noreturn" :NORETURN
   "_Static_assert" :STATICASSERT "_Thread_local" :THREADLOCAL
   ;; GCC/clang/other extensions
   "_Decimal128" :DECIMAL128 "_Decimal32" :DECIMAL32 "_Decimal64" :DECIMAL64 "_Float128" :FLOAT128
   "_Float128x" :FLOAT128X "_Float16" :FLOAT16 "__fp16" :FLOAT16 "_Float32" :FLOAT32 "_Float32x" :FLOAT32X
   "_Float64" :FLOAT64 "_Float64x" :FLOAT64X "_Nonnull" :NONNULL "__alignof" :ALIGNOF "__alignof__" :ALIGNOF
   "__asm" :ASM "__asm__" :ASM "__attribute" :ATTRIBUTE "__attribute__" :ATTRIBUTE "__auto_type" :AUTOTYPE
   "__bf16" :BF16 "__complex" :COMPLEX "__complex__" :COMPLEX "__const" :CONST "__declspec" :DECLSPEC
   "__float128" :FLOAT128 "__imag" :IMAG "__imag__" :IMAG "__inline" :INLINE "__inline__" :INLINE
   "__int128" :INT128 "__int128_t" :INT128 "__label__" :LABEL "__real" :REAL "__real__" :REAL
   "__restrict" :RESTRICT "__restrict__" :RESTRICT "__signed" :SIGNED "__signed__" :SIGNED
   "__thread" :THREADLOCAL "__typeof" :TYPEOF "__typeof__" :TYPEOF "__uint128_t" :UINT128
   "__volatile" :VOLATILE "__volatile__" :VOLATILE "asm" :ASM "typeof" :TYPEOF
   "_BitInt" :BITINT}) ; go-whim: C23

(def c23-keywords
  {"alignas" :ALIGNAS "alignof" :ALIGNOF "bool" :BOOL "static_assert" :STATICASSERT
   "thread_local" :THREADLOCAL
   "constexpr" :CONSTEXPR "typeof_unqual" :TYPEOF}) ; go-whim

(defn stdc-version
  "cc.go's stdcVersion: __STDC_VERSION__'s value in the predefined text, 0 for none."
  ^long [^String predefined]
  (let [prefix "#define __STDC_VERSION__ "]
    (or (some (fn [^String l]
                (when (.startsWith l prefix)
                  (let [s (str/trim (subs l (count prefix)))
                        s (if (.endsWith s "L") (subs s 0 (dec (count s))) s)]
                    (try (Long/parseLong s) (catch Exception _ 0)))))
              (str/split-lines predefined))
        0)))

(defn keywords
  "The keyword set cc's configuration gives for `predefined` (go-whim's presetConfig)."
  [^String predefined]
  (if (>= (stdc-version predefined) 202000) (merge default-keywords c23-keywords) default-keywords))

;; cc.go's Builtin, the second source of every parse (go-whim's users and tools/ccdump pass it).
(def builtin
  "
#define __extension__
#define __restrict_arr restrict

#if __STDC_VERSION__ >= 202000L
/* C23 keywords, no longer defined as macros by <stdbool.h> and <stddef.h>. */
#ifndef true
#define true 1
#endif
#ifndef false
#define false 0
#endif
#ifndef nullptr
#define nullptr ((void*)0)
#endif
#endif

#ifndef __builtin_va_list
#define __builtin_va_list __builtin_va_list
typedef void *__builtin_va_list;
#endif

#ifndef __builtin_va_arg
#define __builtin_va_arg __builtin_va_arg
#define __builtin_va_arg(va, type) (*(type*)__builtin_va_arg_impl(va))
#endif

#define __builtin_va_copy(dst, src) dst = src

#define __builtin_offsetof(type, member) ((__SIZE_TYPE__)&(((type*)0)->member))
#define __builtin_types_compatible_p(t1, t2) __ccgo__types_compatible_p((t1){}, (t2){})
#define __builtin_bit_cast(type, expr) (((union { __typeof__(expr) __ccgo_from; type __ccgo_to; }){ .__ccgo_from = (expr) }).__ccgo_to)

int __predefined_declarator;

#ifdef __SIZE_TYPE__
typedef __SIZE_TYPE__ __predefined_size_t;
#endif

#ifdef __WCHAR_TYPE__
typedef __WCHAR_TYPE__ __predefined_wchar_t;
#endif

#ifdef __PTRDIFF_TYPE__
typedef __PTRDIFF_TYPE__ __predefined_ptrdiff_t;
#endif

#define __FUNCTION__ __func__
#define __PRETTY_FUNCTION__ __func__

#ifdef __clang__
#define __builtin_convertvector(src, type) ((type)(src))

(ns arbace.repr.c.host
  "The reference's configuration as repr/c's preprocessor reads with it (doc/c/SPEC.md §9.1;
  doc/C23-SURVEY.md, \"As built: C2\"): gcc 15.2's answers recorded by `bin/repr-c host record` under
  test/c/host/ (its predefined macros per standard with the date macros of the fixed epoch, CS43 (a);
  its search list, gcc's include directory before musl's, CS32 (a); its answers to __has_attribute,
  __has_c_attribute, __has_builtin, __has_feature), never asked at read time, and a file's own options
  (a corpus file's dg-options: -std, -D, -U, -I, --embed-dir, -O) as the reference applies them."
  (:require [arbace.string :as str]))

(set! *warn-on-reflection* true)

(def stds
  "The standards whose predefined macros are recorded."
  ["c89" "c94" "c99" "c11" "c17" "c23" "c2y" "gnu89" "gnu99" "gnu11" "gnu17" "gnu23" "gnu2y"])

(def std-aliases
  {"c90" "c89" "iso9899:1990" "c89" "iso9899:199409" "c94" "c9x" "c99" "iso9899:1999" "c99"
   "iso9899:199x" "c99" "c1x" "c11" "iso9899:2011" "c11" "c18" "c17" "iso9899:2017" "c17"
   "iso9899:2018" "c17" "c2x" "c23" "iso9899:2024" "c23" "gnu90" "gnu89" "gnu9x" "gnu99"
   "gnu1x" "gnu11" "gnu18" "gnu17" "gnu2x" "gnu23"})

(defn canonical-std
  "A -std= value as one of `stds`, nil when gcc's C has no such standard."
  [^String s]
  (let [s (get std-aliases s s)] (when (some #{s} stds) s)))

(defn- slurp-lines [^String f] (remove str/blank? (str/split-lines (slurp f))))

(defn load-host
  "The recorded host under `dir` (test/c/host): {:search [...] :predefined {std text} :has {[op
  name] value} :epoch n}."
  [^String dir]
  (let [edn (read-string (slurp (str dir "/host.edn")))]
    {:search (vec (slurp-lines (str dir "/search.txt")))
     :predefined (into {} (for [s stds :let [f (java.io.File. (str dir "/predefined/" s ".h"))] :when (.exists f)]
                            [s (slurp f)]))
     :has (into {} (for [l (slurp-lines (str dir "/has.tsv"))
                         :let [[op nm v] (str/split l #"\t")]]
                     [[op nm] (Long/parseLong v)]))
     :epoch (:epoch edn)
     :edn edn}))

;; ---------------------------------------------------------------------------------------------
;; A file's options

(defn- shell-words
  "The words of a dg-options string (its quotes and braces as DejaGnu's Tcl reads the simple ones)."
  [^String s]
  (->> (str/split (str/trim s) #"\s+") (remove str/blank?) (map #(str/replace % "\\\"" "\""))))

(defn- kleene-not [v] (if (= :unknown v) :unknown (not v)))
(defn- kleene-and [a b] (cond (or (false? a) (false? b)) false (or (= :unknown a) (= :unknown b)) :unknown :else true))
(defn- kleene-or [a b] (cond (or (true? a) (true? b)) true (or (= :unknown a) (= :unknown b)) :unknown :else false))

(defn eval-selector
  "A selector expression of DejaGnu's target lists (`! dfp`, `bitint && int128`, `{ x86_64-*-* i?86-*-* }`, `c || c++11`),
  each atom's value `(atom-value word)`: `!`, `&&`, `||`, parentheses and braces, words side by side taken as alternatives.
  An atom's value is true, false or :unknown (review 027, finding 5), the operators Kleene's: `! :unknown` is :unknown,
  `false && :unknown` false, `true || :unknown` true."
  [^String body atom-value]
  (let [toks (vec (re-seq #"\|\||&&|!|\(|\)|\{|\}|[^\s(){}!&|]+" body))
        pos (atom 0)
        peek* #(get toks @pos)
        next* #(let [t (get toks @pos)] (swap! pos inc) t)
        open? #(contains? #{"(" "{"} %)
        close? #(contains? #{")" "}"} %)
        atom-start? #(let [t (peek*)] (and t (or (= t "!") (open? t) (not (or (close? t) (= t "&&") (= t "||"))))))]
    (letfn [(un []
              (let [t (next*)]
                (cond (nil? t) true
                      (= t "!") (kleene-not (un))
                      (open? t) (let [v (alt)] (when (close? (peek*)) (next*)) v)
                      :else (let [v (atom-value t)] (if (= :unknown v) :unknown (boolean v))))))
            (conj* []
              (loop [v (un)]
                (if (= (peek*) "&&") (do (next*) (let [w (un)] (recur (kleene-and v w)))) v)))
            (alt []
              (loop [v (conj*)]
                (cond (= (peek*) "||") (do (next*) (let [w (conj*)] (recur (kleene-or v w))))
                      (atom-start?) (let [w (conj*)] (recur (kleene-or v w)))
                      :else v)))]
      (if (empty? toks) true (alt)))))

(def ^:private host-targets
  (delay (let [f (java.io.File. "test/c/dg-targets.edn")]
           (if (.exists f) (read-string (slurp f)) {:triple "x86_64-linux-gnu" :effective {}}))))

(defn- glob-match? [^String pat ^String s]
  (boolean (re-matches (re-pattern (-> pat (str/replace "." "\\.") (str/replace "*" ".*") (str/replace "?" "."))) s)))

(defn target-atom
  "A selector's atom on the reference host (test/c/dg-targets.edn): every C++ name false for C (review 006, finding 8), a
  target triple's pattern (`x86_64-*-*`, `i?86-*-*`) matched against the host's triple, an effective-target name the table's
  value, a name the table does not list :unknown (review 027, finding 5)."
  [^String w]
  (cond
    (.startsWith w "c++") false
    (re-find #"[-*?]" w) (glob-match? w (:triple @host-targets))
    :else (let [m (:effective @host-targets)] (if (contains? m w) (boolean (get m w)) :unknown))))

(defn- braced-after
  "The braced text starting at the first non-space character from index i of s when it is `{`, its braces matched: the
  text inside, else nil."
  [^String s i]
  (let [n (count s)
        i (loop [i (long i)] (if (and (< i n) (Character/isWhitespace (.charAt s i))) (recur (inc i)) i))]
    (when (and (< i n) (= (.charAt s i) \{))
      (loop [j (inc i) depth 1]
        (when (< j n)
          (let [c (.charAt s j)]
            (cond (= c \{) (recur (inc j) (inc depth))
                  (= c \}) (if (= depth 1) (subs s (inc i) j) (recur (inc j) (dec depth)))
                  :else (recur (inc j) depth))))))))

(defn for-c?
  "Whether a dg selector (`target c++`, `target { ! c++ }`, `target { ! ia32 }`) holds for C on the reference host: true,
  false or :unknown (target-atom's values; review 027, finding 5: an unlisted name is no longer true)."
  [^String sel]
  (let [t (str/trim (or sel ""))
        body (cond (.startsWith t "target") (subs t 6) (.startsWith t "xfail") (subs t 5) :else t)]
    (eval-selector body target-atom)))

(defn dg-options-info
  "The options of a gcc testsuite file's dg-options and dg-additional-options lines, in order: {:opts [...] :uncertain
  [selector...]}. A line whose selector does not hold for C on the reference host is skipped (`for-c?`; the selector's
  braces matched); one whose selector cannot be evaluated (a name test/c/dg-targets.edn does not list) is kept and its
  selector listed in :uncertain (review 027, finding 5). ${srcdir} is the testsuite's root `srcdir` (CS192 (a): the
  group's base; \".\" when not given)."
  [^String text ^String srcdir]
  (let [m (re-matcher #"\{\s*dg-(additional-)?options\s+\"((?:[^\"\\]|\\.)*)\"" text)]
    (loop [out [] unc []]
      (if (.find m)
        (let [opts (.group m 2)
              sel (braced-after text (.end m))
              v (if sel (for-c? sel) true)]
          (if (false? v)
            (recur out unc)
            (recur (into out (shell-words (str/replace opts "${srcdir}" srcdir)))
                   (if (= :unknown v) (conj unc (str/trim sel)) unc))))
        {:opts out :uncertain unc}))))

(defn dg-options
  "dg-options-info's options alone."
  ([^String text] (dg-options text "."))
  ([^String text ^String srcdir] (:opts (dg-options-info text srcdir))))

(defn- dir-opts
  "The directories `flag` (-isystem, -iquote, -idirafter) names in `opts`, in order: `flag DIR` or `flagDIR` (`flag=DIR` is a
  sysroot's, which gcc without one ignores)."
  [opts ^String flag]
  (vec (keep-indexed (fn [i ^String o] (cond (= o flag) (nth opts (inc i) nil)
                                             (and (.startsWith o flag) (not (.startsWith o (str flag "=")))) (subs o (count flag))))
                     opts)))

(defn file-config
  "A file's configuration from `opts` (a compiler's options) and `default-std`: {:std :pre :inc
  :embed-dirs :args}, :pre the lines its -D, -U and -O add to the predefined macros, :args the
  options the reference is given to agree (the modelled ones)."
  [opts ^String default-std]
  (loop [os (seq opts) std default-std pre [] incs [] embed [] args []]
    (if-let [^String o (first os)]
      (let [more (next os)
            arg (fn [^String flag] (if (= o flag) [(first more) (next more)] [(subs o (count flag)) more]))]
        (cond
          (.startsWith o "-std=")
          (if-let [s (canonical-std (subs o 5))] (recur more s pre incs embed (conj args o)) (recur more std pre incs embed args))
          (= o "-ansi") (recur more "c89" pre incs embed (conj args o))
          ;; Arbace (CS50 (a)): phase 1's trigraphs on whatever the standard
          (= o "-trigraphs") (recur more std (conj pre ::trigraphs) incs embed (conj args o))
          (.startsWith o "-D")
          (let [[v more] (arg "-D")
                [n d] (let [i (.indexOf ^String v "=")] (if (neg? i) [v "1"] [(subs v 0 i) (subs v (inc i))]))]
            (recur more std (conj pre (str "#define " n " " d)) incs embed (conj args (str "-D" v))))
          (.startsWith o "-U")
          (let [[v more] (arg "-U")] (recur more std (conj pre (str "#undef " v)) incs embed (conj args (str "-U" v))))
          (.startsWith o "-I")
          (let [[v more] (arg "-I")] (recur more std pre (if (= v "-") incs (conj incs v)) embed (conj args (str "-I" v))))
          (re-matches #"--?embed-dir(ectory)?(=.*)?" o)
          (let [[v more] (if-let [[_ _ eq] (re-matches #"--?embed-dir(ectory)?(=.*)" o)]
                           [(subs eq 1) more]
                           [(first more) (next more)])]
            (if v
              (recur more std pre incs (conj embed v) (conj args (str "--embed-dir=" v)))
              (recur more std pre incs embed args)))
          (re-matches #"-O([1-3sgz]|fast)?" o)
          (recur more std (conj pre "#undef __NO_INLINE__" "#define __OPTIMIZE__ 1") incs embed (conj args o))
          (= o "-O0") (recur more std pre incs embed (conj args o))
          ;; Arbace (CS133): the signedness of plain char, for the preprocessor's macro and the checker
          (= o "-funsigned-char") (recur more std (conj pre "#define __CHAR_UNSIGNED__ 1") incs embed (conj args o))
          (= o "-fsigned-char") (recur more std (conj pre "#undef __CHAR_UNSIGNED__") incs embed (conj args o))
          :else (recur more std pre incs embed args)))
      {:std std :pre (str/join (map #(str % "\n") (remove #{::trigraphs} pre))) :inc incs :embed-dirs embed :args args
       ;; CS231: -isystem DIR (or -isystemDIR): searched after -I, and a system directory (gcc ignores -isystem=DIR, a sysroot's)
       :isystem (dir-opts opts "-isystem")
       ;; review 079's finding 2: -iquote DIR (quoted includes only, after the including file's directory) and -idirafter DIR
       ;; (a system directory searched after the others)
       ;; CS239 (a): -I- (the quote/bracket split of the include search) is not modelled: the read refuses a file that gives it
       :unsupported (vec (filter #{"-I-"} opts))
       :iquote (dir-opts opts "-iquote")
       :idirafter (dir-opts opts "-idirafter")
       :trigraphs (boolean (some #{::trigraphs} pre))
       ;; Arbace (CS132): the checker's pedantic mode, only what the file's options ask (-pedantic-errors: errors)
       :pedantic (cond (some #{"-pedantic-errors"} opts) :errors (some #{"-pedantic"} opts) :warn)
       ;; -Wno-c23-c2y-compat: the pedwarns of C2y features used in C23 mode are off
       :no-c2y-compat (boolean (some #{"-Wno-c23-c2y-compat"} opts))
       :permissive (boolean (some #{"-fpermissive"} opts))
       :no-c23-compat (boolean (some #{"-Wno-c11-c23-compat"} opts))
       ;; the execution character set is not modelled: constants of characters are not judged
       :exec-charset (boolean (some #(.startsWith ^String % "-fexec-charset=") opts))})))

(def trigraph-stds
  "The standards at which gcc reads trigraphs in phase 1 (the ISO ones before C23)."
  #{"c89" "c94" "c99" "c11" "c17"})

(defn- norm-dir
  "A directory name cleaned for comparison (./sys, sys/ and sys are one)."
  [^String d]
  (let [n (str (.normalize (java.nio.file.Paths/get d (make-array String 0))))] (if (= n "") "." n)))

(defn sys-dirs
  "The system directories of a file read with `fc`, in gcc's order: -isystem, the host's list, -idirafter."
  [host fc]
  (vec (concat (:isystem fc) (:search host) (:idirafter fc))))

(defn config
  "The preprocessor's configuration (arbace.repr.c.pp) for a file of configuration `fc` (file-config's)
  read from `base`."
  [host fc ^String base]
  {:predefined (str (get (:predefined host) (:std fc)) (:pre fc))
   ;; gcc's chains (review 079's finding 2): a -I directory that names a system directory (the -isystem ones, the host's list,
   ;; -idirafter) is dropped, a duplicate keeps its first place; -iquote's directories come after the including file's own
   :include (let [sys (set (map norm-dir (sys-dirs host fc)))]
              (vec (distinct (remove #(contains? sys (norm-dir %)) (:inc fc)))))
   :iquote (let [sys (set (map norm-dir (sys-dirs host fc)))]
             (vec (distinct (remove #(contains? sys (norm-dir %)) (:iquote fc)))))
   :sys (vec (distinct (sys-dirs host fc)))
   :std (keyword (:std fc))
   :has (:has host)
   :embed-dirs (:embed-dirs fc)
   :pedantic (:pedantic fc)
   :trigraphs (boolean (or (:trigraphs fc) (trigraph-stds (:std fc))))
   :base base})

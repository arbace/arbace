(ns arbace.repr.c.rtcheck
  "repr/c's round trip (doc/c/SPEC.md §3.1; doc/C23-SURVEY.md, \"As built: C3b\"; bin/repr-c roundtrip,
  its driver bin/lib/repr-c/roundtrip): each file of the corpora read into C forms, printed in mode
  :lines and read again, the forms equal (level 1, `forms`); read in mode :full and printed, the
  original byte for byte (level 2); the :lines print compiled by the reference, its object file the
  original's byte for byte (level 3, the driver's gcc runs) and, for the run corpora, its program run as
  the original's (level 4, E2's measure); a file that does not pass is known with its class
  (test/repr/c/roundtrip-known.edn), or fails. Also the reference's acceptance of every file (CS61 (a),
  test/repr/c/parse-gcc.tsv) against the reader's."
  (:require [arbace.repr.c :as rc]
            [arbace.c.dg :as dg]
            [arbace.repr.c.host :as host]
            [arbace.repr.c.layout :as layout]
            [arbace.repr.c.lex :as lex]
            [arbace.repr.c.parse :as parse]
            [arbace.repr.c.results :as results]
            [arbace.string :as str])
  (:import [java.util.concurrent Executors Callable]))

(set! *warn-on-reflection* true)

(def known-file "test/repr/c/roundtrip-known.edn")
(def gcc-file "test/repr/c/parse-gcc.tsv")

(defn- spit-bytes [^String path ^bytes bs]
  (when-let [p (.getParentFile (java.io.File. path))] (.mkdirs p))
  (java.nio.file.Files/write (.toPath (java.io.File. path)) bs ^"[Ljava.nio.file.OpenOption;" (make-array java.nio.file.OpenOption 0)))

(defn- dir-of ^String [^String p] (let [i (.lastIndexOf p "/")] (if (neg? i) "." (subs p 0 i))))

(defn- abs-incs
  "A file configuration whose relative -I paths are made absolute against `base`, with `extra` first."
  [fc ^String base extra]
  (let [abs (fn [^String p] (if (.startsWith p "/") p (str base "/" p)))]
    (-> fc
        (update :inc #(vec (concat extra (map abs %))))
        (update :args #(vec (map (fn [^String a] (if (and (.startsWith a "-I") (not (.startsWith a "-I/"))) (str "-I" (abs (subs a 2))) a)) %))))))

(defn link-resources!
  "The print's directory given the original's resources its text names (gcc-embed: `#embed \"x\"`, `__has_embed (E1 ...)`
  with `#define E1 \"embed-1.c\"`): each string literal of the print naming a file or directory beside the original (a
  relative name, inside the print's directory), symbolically linked beside the print when the print's directory lacks it. A quoted #embed
  searches the current file's directory first (6.10.4), as the original found them; the original's directory as an
  --embed-dir would answer an angle-bracketed name too (embed-1.c's `__has_embed (<embed-1.c>)`, which must not be found)."
  [^String pdir ^String nm ^String odir ^String text]
  (let [pd (dir-of (str pdir "/" nm))
        ;; a file the print #includes is found by -iquote in the original's directory, where its own relative names hold
        ;; (embed-1.c's \"../empty.h\", included by embed-2.c): not linked
        incs (set (map second (re-seq #"(?m)^\s*#\s*include(?:_next)?\s*\"([^\"]+)\"" text)))]
    ;; c-tails: the string literals as one unrolled loop (a run of plain characters, then escapes each with its run): the
    ;; alternation repeated a character at a time recursed once a character in the regex engine, past Go's 1 GB stack on
    ;; pr46534.c's literal of a million characters (a fatal error that ended the corpus's run)
    (doseq [[_ s] (re-seq #"\"([^\"\\\n]*(?:\\.[^\"\\\n]*)*)\"" text)
            :when (seq s)
            :when (and (not (incs s)) (not (.startsWith ^String s "/")) (re-matches #"[A-Za-z0-9_./+-]+" s))
            :let [src (java.io.File. (str odir "/" s))
                  dst (.toFile (.normalize (.toPath (java.io.File. (str pd "/" s)))))]
            ;; a name with .. stays inside the print's directory (embed-1.c's "../empty.h": print/NAME.d/c-c++-common/empty.h)
            :when (and (.startsWith (.getPath dst) (str (.getPath (.toFile (.normalize (.toPath (java.io.File. pdir))))) "/"))
                       (.exists src) (not (.exists dst)))]
      (try
        (.mkdirs (.getParentFile dst))
        (java.nio.file.Files/createSymbolicLink (.toPath dst) (.toPath (.getAbsoluteFile src))
                                                (make-array java.nio.file.attribute.FileAttribute 0))
        (catch Exception _ nil)))))

(def ^:private strip-keys #{:line :column :c/grouped})

(defn strip
  "A form without the metadata the :lines print does not keep (:line, N3's :c/grouped)."
  [x]
  (let [x (cond
            (seq? x) (with-meta (apply list (map strip x)) (meta x))
            (vector? x) (with-meta (mapv strip x) (meta x))
            (map? x) (into {} (map (fn [[k v]] [k (strip v)]) x))
            :else x)]
    (if (and (instance? arbace.lang.IObj x) (meta x))
      (with-meta x (into {} (map (fn [[k v]] [k (strip v)]) (apply dissoc (meta x) strip-keys))))
      x)))

(defn- forms-text [rd]
  (str/join "\n" (map #(layout/form-str (strip %)) (:forms rd))))

(defn- first-diff [^String a ^String b]
  (let [as (str/split-lines a) bs (str/split-lines b)]
    (first (for [i (range (max (count as) (count bs)))
                 :when (not= (get as i) (get bs i))]
             (let [^String x (str (get as i)) ^String y (str (get bs i))
                   k (loop [k 0] (if (and (< k (count x)) (< k (count y)) (= (.charAt x k) (.charAt y k))) (recur (inc k)) k))
                   from (max 0 (- k 60))]
               (str "form " (inc i) " at " k ": " (subs x from (min (count x) (+ k 120))) " | " (subs y from (min (count y) (+ k 120)))))))))

(defn- one-line ^String [x] (str/replace (str x) #"[\t\n]" " "))

(defn level1
  "Level 1's comparison: the read's forms text and header units (a, ua) against the reread's (b, ub): [\"equal\" nil] or
  [\"differ\" DETAIL]."
  [^String a ua ^String b ub]
  (if (and (= a b) (= (set ua) (set ub)))
    ["equal" nil]
    ["differ" (or (first-diff a b) "header units")]))

(defn level2
  "Level 2's comparison: the original's bytes against the :full print's (ISO-8859-1), byte for byte: \"equal\" or \"differ\"."
  [^bytes orig ^bytes printed]
  (if (java.util.Arrays/equals orig printed) "equal" "differ"))

(def ^:private keep-levels #{:roundtrip-forms :roundtrip-full})

(defn control-names
  "The names of the corpus `id` that a :roundtrip-forms or :roundtrip-full control (test/c/controls.edn) names, as subject or
  reference: the files whose texts check-file keeps under control/ (queue 159)."
  [^String id]
  (set (for [c (read-string (slurp "test/c/controls.edn")) :when (keep-levels (:level c))
             f [(:subject c) (:reference c)]
             :let [i (.indexOf ^String f "/")] :when (= (subs f 0 i) id)]
         (subs f (inc i)))))

(defn- keep-text
  "GTS81 (a), queue 159: a control's file keeps what levels 1 and 2 compared, under WORK/ID/control/NAME.KIND."
  [^String d ^String nm ^String kind ^bytes bs]
  (spit-bytes (str d "/control/" nm "." kind) bs))

(defn check-file
  "One file: [name read l1 l2 detail], the print written under WORK/ID/print/. A control's file (keep, control-names)
  keeps what levels 1 and 2 compared under WORK/ID/control/: NAME.read and NAME.reread (the forms texts, with their header
  units in NAME.read-units and NAME.reread-units), NAME.orig and NAME.full (the original's bytes, the :full print's)."
  ([^String work ^String id h ^String base e] (check-file work id h base e false))
  ([^String work ^String id h ^String base e keep]
  ;; c-tails: an assembler source read as an assembler unit (SPEC §9.6), its print and reread likewise
  (binding [arbace.repr.c/*asm-units* true]
  (let [nm (:name e)
        d (str work "/" id)
        fc (:fc e)
        cfg (host/config h fc base)
        orig (lex/read-bytes (str base "/" nm))
        budget (* 1000000000 (Long/parseLong (or (System/getenv "REPR_C_READ_BUDGET") "120")))
        ;; the original read as its corpus names it (gcc's testsuite: absolute, as DejaGnu does), the print
        ;; under its relative name
        rn (or (:read e) nm)
        rd (binding [parse/*deadline* (+ (System/nanoTime) budget)]
             (try (rc/read-c cfg fc rn false)
                  (catch Throwable x (if (:deadline (ex-data x)) {:timeout true} {:crash (str x)}))))]
    (cond
      (:timeout rd) [nm "timeout" "-" "-" "the evaluated read's budget (REPR_C_READ_BUDGET s) spent"]
      (:crash rd) [nm "crash" "-" "-" (one-line (:crash rd))]
      (:error rd) [nm "error" "-" "-" (one-line (first (:error rd)))]
      (:refused rd) [nm (str "refused:" (name (:refused rd))) "-" "-" (one-line (:message rd))]
      :else
      (binding [parse/*deadline* (+ (System/nanoTime) (* 2 budget))]
      (let [pr (try (rc/print-c (:file-form rd) (:forms rd)) (catch Throwable x (str "\u0000print-crash " x)))]
        (if (.startsWith ^String pr "\u0000")
          [nm "ok" "print-crash" "-" (one-line (subs pr 1))]
          (let [pdir (str d "/print/" nm ".d") ; a directory a file: another print is not the original
                _ (spit-bytes (str pdir "/" nm) (.getBytes ^String pr "UTF-8"))
                _ (link-resources! pdir nm (dir-of (str base "/" nm)) pr)
                fc2 (abs-incs fc base [(dir-of (str base "/" nm))])
                ;; the print reread by the kind of name the original was read by (the own target's triage, night 7): an
                ;; original read by its absolute name (gcc's testsuite, as DejaGnu names it) is reread by the print's absolute
                ;; name, so that a directive about the file itself (gcc-embed's `#if __has_embed (__FILE__ ...)`, which the
                ;; print writes back since CDF.8) finds the print as the original found itself
                rd2 (try (rc/read-c (host/config h fc2 pdir) fc2 (if (.startsWith ^String rn "/") (str pdir "/" nm) nm) false)
                         (catch Throwable x {:crash (str x)}))
                a (forms-text rd)
                _ (when keep
                    (keep-text d nm "read" (.getBytes ^String a "UTF-8"))
                    (keep-text d nm "read-units" (.getBytes (pr-str (vec (sort (map str (keys (:units rd)))))) "UTF-8")))
                [l1 detail] (cond
                              (:crash rd2) ["reread-crash" (:crash rd2)]
                              (:error rd2) ["reread-error" (first (:error rd2))]
                              (:refused rd2) ["reread-refused" (:message rd2)]
                              :else (let [b (forms-text rd2)]
                                      (when keep
                                        (keep-text d nm "reread" (.getBytes ^String b "UTF-8"))
                                        (keep-text d nm "reread-units" (.getBytes (pr-str (vec (sort (map str (keys (:units rd2)))))) "UTF-8")))
                                      (level1 a (map str (keys (:units rd))) b (map str (keys (:units rd2))))))
                ;; the :full read under a budget of its own, as the first read's (night 13: limits-blockid.c's read in the
                ;; loaded concurrent gate spent what the print and the reread had left of twice the budget, and the deadline's
                ;; exception was taken for a crash)
                full (binding [parse/*deadline* (+ (System/nanoTime) budget)]
                       (try (rc/read-c cfg fc rn true)
                            (catch Throwable x (if (:deadline (ex-data x)) {:timeout true} {:crash (str x)}))))
                l2 (cond
                     (:timeout full) "timeout"
                     (:crash full) "crash"
                     (:refused full) (str "refused:" (name (:refused full)))
                     (:error full) "error"
                     :else (let [t (.getBytes ^String (rc/print-c (:file-form full) (:forms full)) "ISO-8859-1")]
                             (when keep (keep-text d nm "orig" orig) (keep-text d nm "full" t))
                             (level2 orig t)))
                fix (if (or (:crash rd2) (:error rd2) (:refused rd2))
                      "-"
                      (if (= pr (try (rc/print-c (:file-form rd2) (:forms rd2)) (catch Throwable _ nil))) "equal" "differ"))]
            [nm "ok" l1 l2 (if detail (one-line detail) "") fix])))))))))

(defn forms
  "Levels 1 and 2 of the corpus `id` under WORK (its lists made by arbace.repr.c.ppcheck/lists):
  WORK/ID/forms.tsv, the prints under print/, gcc3.list (name, standard, options, the original's
  directory) for the driver's level 3."
  [^String work ^String id]
  (let [d (str work "/" id)
        base (str/trim (slurp (str d "/base.txt")))
        entries (read-string (slurp (str d "/files.edn")))
        h (host/load-host "test/c/host")
        keep (control-names id)
        threads (Integer/parseInt (or (System/getenv "REPR_C_THREADS") "8"))
        pool (Executors/newFixedThreadPool threads)
        t0 (System/nanoTime)
        futs (mapv (fn [e] (.submit pool ^Callable (fn [] (try (check-file work id h base e (contains? keep (:name e)))
                                                               (catch Throwable x [(:name e) "crash" "-" "-" (one-line x)])))))
                   entries)
        rs (mapv #(.get ^java.util.concurrent.Future %) futs)
        _ (.shutdown pool)
        secs (/ (- (System/nanoTime) t0) 1e9)
        ok (filter #(= "ok" (nth % 1)) rs)
        by (fn [i] (frequencies (map #(nth % i) rs)))]
    (spit (str d "/forms.tsv") (str/join (map #(str (str/join "\t" %) "\n") rs)))
    (spit (str d "/gcc3.list")
          (str/join (for [r ok
                          :let [e (first (filter #(= (:name %) (first r)) entries))
                                fc (abs-incs (:fc e) base [])]]
                      (str (first r) "\t" (:std fc) "\t" (str/join " " (:args fc)) "\t" base "\t" (or (:read e) (first r)) "\n"))))
    (println (str id ": " (count rs) " files, read " (pr-str (by 1)) ", level 1 " (pr-str (by 2)) ", level 2 " (pr-str (by 3))
                  ", " (Math/round (double secs)) " s"))))

;; ---------------------------------------------------------------------------------------------
;; The judgment

(defn- read-tsv [^String p]
  (let [f (java.io.File. p)]
    (if (.exists f)
      (into {} (map (fn [l] (let [xs (str/split l #"\t" -1)] [(first xs) (vec (rest xs))])) (remove str/blank? (str/split-lines (slurp p)))))
      {})))

(defn load-gcc
  "The reference's acceptance of every file (CS61 (a)): {[corpus name] status}."
  []
  (let [f (java.io.File. ^String gcc-file)]
    (if (.exists f)
      (into {} (for [l (str/split-lines (slurp gcc-file)) :when (not (str/blank? l)) :when (not (.startsWith ^String l "#"))
                     :let [[st cn] (str/split l #"\t")
                           i (.indexOf ^String cn "/")]]
                 [[(subs cn 0 i) (subs cn (inc i))] st]))
      {})))

(defn load-cc
  "The reference port's acceptance (the user's decision of 2026-11-07: no toolchain's record in the judge): cc's, as the tree
  check recorded it equal to the port's (test/repr/c/parse-check-results.edn, rows \"equal, N nodes, E errors\"): {[corpus
  name] \"0\" (cc reads it without an error) or \"1\"}; a file whose trees differ from cc's has no entry."
  []
  (let [f (java.io.File. "test/repr/c/parse-check-results.edn")]
    (if (.exists f)
      (into {} (for [[id r why] (read-string (slurp f))
                     :let [m (re-find #"^equal, \d+ nodes, (\d+) errors" (str why))
                           i (.indexOf ^String id " ")]
                     :when (and m (#{:pass :known} r))]
                 [[(subs id 0 i) (subs id (inc i))] (if (= "0" (second m)) "0" "1")]))
      {})))

(defn load-acceptance
  "The acceptance the round trip holds the reader to: cc's (load-cc) by default, gcc 15.2's recorded one for a file cc's
  tree does not give (only a file the reader rejects asks it: an accepted file passes either way), and gcc's alone under
  ARBACE_C_JUDGE=gcc (the oracle tier's)."
  []
  (if (host/gcc-judge?) (load-gcc) (merge (load-gcc) (load-cc))))

(def ^:dynamic *base*
  "The directory of the corpus judge-row judges (WORK/ID/base.txt; bound by judge), for own-rejects?; nil elsewhere (the
  controls)."
  nil)

(def ^:private wording (delay (dg/load-wording)))

(defn- dg-message-finds?
  "Whether the dg-error regexp `re` finds the message `msg` at column `col` (a number or nil): gcc-dg.exp's process-message
  reads a leading \"N:\" as the column the diagnostic must be at and a leading \"-:\" as no column (queue 495)."
  [^String re ^String msg col]
  (let [[_ c rest] (re-matches #"(?s)^(\d+|-):(.*)$" re)
        [re ok] (cond (nil? c) [re true]
                      (= c "-") [rest true]
                      :else [rest (= (str col) c)])]
    (boolean (and ok (try (re-find (re-pattern re) msg) (catch Exception _ nil))))))

(defn own-rejects?
  "The test's own verdict on a file the reader rejects (the user's decision of 2026-11-07: each test judged by its own
  verdict): the read's first error, `detail` (FILE:LINE:COL: MESSAGE, or LINE:COL: MESSAGE), is on a line of the main file
  `path` whose dg-error directives (arbace.c.dg/analyze: the selectors evaluated on the reference host) expect an error there,
  and one of their regexps finds the message (a leading column \"N:\" held to the error's column, queue 495), or, for the file
  `fid` (CORPUS/NAME), a family of the dg check's reviewed wordings (test/c/dg-wording.edn, arbace.c.dg/family-explains?: the
  same error in the parser's words, cc's, against gcc's) explains it: the file is an error test and the reader rejects it for
  the reason it states. A rejection on another line or in other words (a parser's gap: c23-attr-syntax-5.c's balanced tokens)
  is not."
  ([^String path ^String detail] (own-rejects? path detail nil))
  ([^String path ^String detail fid]
  (boolean
    (when (and path detail (.exists (java.io.File. path)))
      (let [[f l] (if-let [[_ l] (re-find #"^(\d+):\d+: " detail)] [nil (Long/parseLong l)] (dg/error-line detail))
            col (some-> (re-find #"^(?:.*?:)?\d+:(\d+): " detail) second Long/parseLong)
            msg (second (re-find #"^(?:.*?:)?\d+:(?:\d+:)? (.*)$" detail))
            res (get (:msgs (dg/analyze (String. ^bytes (lex/read-bytes path) "ISO-8859-1"))) l)]
        (and l msg (seq res)
             (or (nil? f) (= f path) (.endsWith path (str "/" f)))
             (or (some (fn [^String re] (dg-message-finds? re msg col)) res)
                 (and fid (some #(dg/family-explains? % fid res [detail msg]) (:families @wording))))))))))

;; queue 495: the print level's files the reader rejects whose dg-error line and words do not decide them (a dg-do preprocess
;; file, whose directives say nothing of the translation unit it preprocesses to, or a file the reader rejects on its first
;; syntax error in other words than gcc's): each judged by hand from C23 and the file's own directives, its verdict and the
;; reader's first error recorded in test/repr/c/print-own.edn, :invalid {FID {:at "LINE:COL: MESSAGE" :basis K :why TEXT}}.

(def own-file "test/repr/c/print-own.edn")

(defn load-own
  "test/repr/c/print-own.edn (or `path`): {:invalid {FID entry} :counted-out {FID reason}}; empty when absent."
  ([] (load-own own-file))
  ([^String path]
   (let [f (java.io.File. path)] (if (.exists f) (read-string (slurp f)) {:invalid {} :counted-out {}}))))

(def ^:private own-table (delay (load-own)))

(defn own-invalid?
  "The file `fid` (CORPUS/NAME, main file `path`) is invalid by its own recorded verdict (load-own's :invalid) and the reader's
  first error, `detail`, is in the main file at the entry's :at (LINE:COL: MESSAGE) exactly: the reader rejects it where the
  verdict's reasoning places the error. Another error (the reader changed) is not: the entry is stale (judge fails on it)."
  ([path fid detail] (own-invalid? @own-table path fid detail))
  ([table ^String path fid ^String detail]
   (boolean
     (when-let [e (and fid detail (get (:invalid table) fid))]
       (let [f (when-not (re-find #"^\d+:\d+: " detail) (first (dg/error-line detail)))
             lcm (second (re-find #"^(?:.*?:)?(\d+:\d+: .*)$" detail))]
         (and (= lcm (:at e))
              (or (nil? f) (nil? path) (= f path) (.endsWith ^String path (str "/" f)))))))))

(defn own-verdict
  "The test's own verdict on a file the reader rejects: \"own-rejects\" (own-rejects?: its dg-error line and words),
  \"own-invalid\" (own-invalid?: its recorded verdict, test/repr/c/print-own.edn), or nil."
  [^String path fid ^String detail]
  (cond (own-rejects? path detail fid) "own-rejects"
        (own-invalid? path fid detail) "own-invalid"))

(def ^:dynamic *corpus*
  "The corpus judge-row judges (bound by judge with *base*), for own-verdict's file id; nil elsewhere."
  nil)

(defn- judge-row
  "A file's status at each level and overall: {:status pass|known|fail :levels {...} :class k}."
  [[nm read l1 l2 detail] obj run gcc known run?]
  (let [[os ps cmp] obj
        [ro rp same] run
        l3 (cond (not= read "ok") "-"
                 (nil? cmp) "-"
                 (not= os "0") "orig-fails"
                 (not= ps "0") "print-rejected"
                 :else cmp)
        l4 (cond (not run?) "-" (not= read "ok") "-" (nil? same) "-" :else same)
        ;; queue 409: the test's own verdict first (its dg-error line and words, own-rejects?), then the reference's rejection
        ;; (cc's, else gcc's recorded one for a file cc's tree does not give); under the oracle tier's judge gcc's first, as before
        ;; queue 495: own-verdict, the dg-error line and words or the file's recorded verdict (test/repr/c/print-own.edn)
        own (fn [] (own-verdict (when *base* (str *base* "/" nm)) (when *corpus* (str *corpus* "/" nm)) detail))
        accept (cond (= read "error") (or (when-not (host/gcc-judge?) (own))
                                          (when (not= gcc "0") "both-reject")
                                          (own)
                                          "port-only-rejects")
                     (nil? gcc) "unrecorded"
                     (= gcc "0") "agree"
                     :else "gcc-only-rejects")
        bad (cond-> []
              (not (#{"ok" "error"} read)) (conj :read)
              (and (= read "ok") (not= l1 "equal")) (conj :l1)
              (and (= read "ok") (not= l2 "equal")) (conj :l2)
              (#{"differ" "print-rejected"} l3) (conj :l3)
              ;; c-rows (2026-11-21): the objects equal byte for byte (level 3) make the print's program the original's, so
              ;; their runs differing is the program's own nondeterminism (return-addr.c prints a return address, under
              ;; ASLR; reverse-complement-5.c reads before its buffer), not the print's: level 4 judges the print only where
              ;; level 3 does not hold it already (the class :run-address before)
              (and (= l4 "differ") (not= l3 "equal")) (conj :l4)
              (= accept "port-only-rejects") (conj :accept))]
    {:name nm :read read :l1 l1 :l2 l2 :l3 l3 :l4 l4 :accept accept :detail detail
     :status (cond (empty? bad) "pass" known "known" :else "fail") :bad bad :class (:class known)}))

;; CS282 (a) (the user, 2026-11-08): the round trip's --record under each test's own verdict (no gcc). Levels 3 and 4 and gcc's
;; acceptance are the oracle tier's, recorded by hand under ARBACE_C_JUDGE=gcc; the default mode's record reruns levels 1 and 2
;; and takes the rest from the results file's recorded rows, as the token check's record keeps its :gcc level (T.5).

(defn load-recorded
  "The oracle tier's levels of corpus `id` in a results file (test/repr/c/roundtrip-results.edn's rows [\"CORPUS NAME\" RESULT
  \"STATUS: read R, l1 X, l2 Y, l3 Z, l4 W, gcc A[, class C]...\"]): {name {:read R :l3 Z :l4 W :accept A :class C}}; {} without
  the file."
  [^String f ^String id]
  (if-not (.exists (java.io.File. f))
    {}
    (into {} (for [[cid _ why] (read-string (slurp f))
                   :let [i (.indexOf ^String cid " ")]
                   :when (and (pos? i) (= id (subs cid 0 i)))
                   :let [m (re-find #"^\w+: read ([^,]*), l1 [^,]*, l2 [^,]*, l3 ([^,]*), l4 ([^,]*), gcc ([a-z-]+)" (str why))
                         c (second (re-find #", gcc [a-z-]+, class ([a-z0-9-]+)" (str why)))]
                   :when m]
               [(subs cid (inc i)) (cond-> {:read (nth m 1) :l3 (nth m 2) :l4 (nth m 3) :accept (nth m 4)}
                                     c (assoc :class (keyword c)))]))))

(def oracle-classes
  "The known classes only levels 3 and 4 give (the driver's no-gcc deferral names the same)."
  #{:objects :objects-layout :objects-macro-body :run-address :print-grammar})

(defn recorded-levels
  "A file's levels 3 and 4 from its recorded row `r` (load-recorded) as the driver's obj.tsv and run.tsv rows judge-row reads,
  [obj run]: both nil when the file is not read now or was not read then (no object compiled), or has no row."
  [r ^String read]
  (if-not (and r (= read "ok") (= "ok" (:read r)))
    [nil nil]
    [(case (:l3 r)
       ("equal" "differ") ["0" "0" (:l3 r)]
       "orig-fails" ["1" "-" "-"]
       "print-rejected" ["0" "1" "-"]
       nil)
     (when (#{"same" "differ"} (:l4 r)) ["-" "-" (:l4 r)])]))

(defn judge
  "The corpus `id`'s levels judged (WORK/ID/forms.tsv, obj.tsv and run.tsv, the driver's): WORK/ID/
  files.tsv and report.edn, the summary printed; 1 when a file fails or a known entry is stale. With `recorded` (a results
  file; CS282 (a), the default mode's --record) levels 3 and 4 are the file's recorded rows' (recorded-levels) and the
  acceptance gcc's recorded one (test/repr/c/parse-gcc.tsv): the oracle tier's, kept."
  ([^String work ^String id] (judge work id nil))
  ([^String work ^String id ^String recorded]
  (let [d (str work "/" id)
        man (read-string (slurp "test/c/corpora.edn"))
        corpus (first (filter #(= (:id %) (keyword id)) (:corpora man)))
        run? (= :run (:action corpus))
        rows (map (fn [l] (str/split l #"\t" -1)) (remove str/blank? (str/split-lines (slurp (str d "/forms.tsv")))))
        known-all (read-string (slurp known-file))
        ;; a row known by a class only levels 3-4 give whose entry the known file no longer holds: the entry was removed after
        ;; the row (the oracle tier found it passing, 808d08d60's reverse-complement-5.c), so the row's levels 3-4 are dropped
        rec (when recorded
              (let [ks (get-in known-all [:roundtrip (keyword id)] {})]
                (into {} (for [[nm r] (load-recorded recorded id)]
                           [nm (if (and (oracle-classes (:class r)) (not (contains? ks nm))) (dissoc r :l3 :l4) r)]))))
        lv (fn [r] (recorded-levels (get rec (first r)) (second r)))
        obj (if rec (into {} (for [r rows :let [o (first (lv r))] :when o] [(first r) o])) (read-tsv (str d "/obj.tsv")))
        run (if rec (into {} (for [r rows :let [o (second (lv r))] :when o] [(first r) o])) (read-tsv (str d "/run.tsv")))
        gcc (if rec (load-gcc) (load-acceptance))
        ;; GT8: a partial run (--only) holds the known entries of its files alone to account for them
        names (results/partial-names work id)
        known (results/in-run (get-in known-all [:roundtrip (keyword id)] {}) names)
        base (let [f (java.io.File. (str d "/base.txt"))] (when (.exists f) (str/trim (slurp f))))
        js (binding [*base* base *corpus* id]
             (mapv (fn [r] (judge-row r (get obj (first r)) (get run (first r)) (get gcc [id (first r)]) (get known (first r)) run?)) rows))
        ;; CS282 (a): a file of no recorded level 3 (not read when the oracle tier recorded it) whose entry's class only levels 3
        ;; and 4 give stays known by it, as the driver's no-gcc judgment defers it: the oracle tier's to judge again
        js (if-not rec js
             (mapv (fn [j] (let [k (get known (:name j))]
                             (if (and (= "pass" (:status j)) k (oracle-classes (:class k)) (not (contains? obj (:name j))))
                               (assoc j :status "known" :class (:class k) :detail "levels 3-4 not recorded: the oracle tier's")
                               j)))
                   js))
        failing (filter #(= "fail" (:status %)) js)
        ;; GTS-B (doc/C23-SURVEY.md, "As built: GTS-B"): an entry marked :time-dependent (a file near the read's budget,
        ;; REPR_C_READ_BUDGET, whose outcome the host's load decides) is accepted either way: known when the file fails,
        ;; never stale when it passes (a file of the run it names; a file the run does not hold stays stale)
        ran (set (map :name js))
        stale (for [[nm e] known :when (not (some #(and (= (:name %) nm) (= (:status %) "known")) js))
                    :when (not (and (:time-dependent e) (ran nm)))] nm)
        timed (for [[nm e] known :when (and (:time-dependent e) (some #(and (= (:name %) nm) (= (:status %) "pass")) js))] nm)
        unclassed (for [[nm k] known :when (not (contains? (:classes known-all) (:class k)))] nm)
        ;; queue 495: an entry of test/repr/c/print-own.edn whose file the run judged and whose row is not own-invalid (the
        ;; reader's first error moved, or own-rejects? now decides it) is stale: its verdict's reasoning no longer holds the row
        own-stale (when-not (host/gcc-judge?)
                    (for [[fid _] (:invalid @own-table)
                          :let [i (.indexOf ^String fid "/")]
                          :when (= id (subs fid 0 i))
                          :let [j (first (filter #(= (subs fid (inc i)) (:name %)) js))]
                          :when (and j (not= "own-invalid" (:accept j)))]
                      (:name j)))
        fr (fn [k] (into (sorted-map) (frequencies (map k js))))
        report {:corpus id :files (count js) :status (fr :status) :read (fr :read) :level1 (fr :l1) :level2 (fr :l2)
                :level3 (fr :l3) :level4 (fr :l4) :accept (fr :accept) :failing (count failing) :stale-known (vec stale)
                :time-dependent-passed (vec timed) :known-classes (fr :class)}]
    (spit (str d "/files.tsv") (str/join (map #(str (str/join "\t" [(:name %) (:status %) (:read %) (:l1 %) (:l2 %) (:l3 %) (:l4 %) (:accept %)
                                                                    (some-> (:class %) name) (:detail %)]) "\n") js)))
    (spit (str d "/report.edn") (pr-str report))
    (println (str id ": " (count js) " files " (pr-str (:status report)) "; read " (pr-str (:read report))
                  "; l1 " (pr-str (:level1 report)) "; l2 " (pr-str (:level2 report)) "; l3 " (pr-str (:level3 report))
                  (when run? (str "; l4 " (pr-str (:level4 report)))) "; gcc " (pr-str (:accept report))
                  (when (seq failing) (str "; " (count failing) " failing"))
                  (when (seq stale) (str "; " (count stale) " known entries stale"))
                  (when (seq timed) (str "; " (count timed) " time-dependent entries passing (accepted)"))
                  (when (seq unclassed) (str "; " (count unclassed) " of no class"))
                  (when (seq own-stale) (str "; " (count own-stale) " print-own.edn entries stale"))
                  (when names (str " (a partial run: " (count names) " listed files)"))))
    ;; GT8: each failing file as FAIL CORPUS/NAME WHY (the rotation's :failed-re)
    (results/print-failing id (concat (for [j failing] [(:name j) (str "levels " (str/join "," (map name (:bad j))) ": read " (:read j)
                                                                         ", l1 " (:l1 j) ", l2 " (:l2 j) ", l3 " (:l3 j) ", l4 " (:l4 j) " " (:detail j))])
                                      (for [nm own-stale] [nm "test/repr/c/print-own.edn's entry stale: the reader's first error is not its :at"]))
                              (for [nm stale] [nm "known entry stale"]))
    (when rec (println (str id ": levels 3-4 and gcc's acceptance from " recorded " (the oracle tier's rows, CS282 (a)): "
                            (count (filter #(contains? obj (first %)) rows)) " files with a recorded level 3")))
    (if (or (seq failing) (seq stale) (seq unclassed) (seq own-stale)) 1 0))))

;; GTS81 (a): the negative controls of the round trip (test/c/controls.edn, :level :roundtrip): the subject's own row (read,
;; levels 1 and 2, its acceptance) with its levels 3 and 4 crossed, its print's object file and run against the reference's
;; original's (the driver's obj/orig/R.o and run/R/o/, kept), compared as the driver compares (cmp -s: byte for byte; the
;; status and the standard output), the row judged by judge-row, which must not pass. Levels 1 and 2 crossed are the
;; :roundtrip-forms and :roundtrip-full controls below (queue 159), from the texts check-file keeps for the controls' files.

(defn- bytes-or-nil ^bytes [^String p] (let [f (java.io.File. p)] (when (.exists f) (lex/read-bytes p))))

(defn crossed
  "The crossed level-3 and level-4 rows of a subject (its corpus directory sd, name sn) against a reference (rd, rn), as the
  driver writes obj.tsv's and run.tsv's: [[os ps cmp] [ro rp same]], the original's status the reference's and the print's
  the subject's; the run row nil when either has none (not a run corpus, --no-run)."
  [^String sd ^String sn sobj srun ^String rd ^String rn robj rrun]
  (let [os (first robj) ps (second sobj)
        eq (fn [a b] (let [x (bytes-or-nil a) y (bytes-or-nil b)] (boolean (and x y (java.util.Arrays/equals x y)))))
        cmp (if (and (= os "0") (= ps "0")) (if (eq (str rd "/obj/orig/" rn ".o") (str sd "/obj/print/" sn ".o")) "equal" "differ") "-")
        run (when (and rrun srun (not= "link" (first rrun)) (not= "link" (second srun)))
              (let [ro (first rrun) rp (second srun)]
                [ro rp (if (and (= ro rp) (eq (str rd "/run/" rn "/o/stdout") (str sd "/run/" sn "/p/stdout"))) "same" "differ")]))]
    [[os ps cmp] run]))

(defn roundtrip-control-result
  "A :roundtrip control judged after the corpora (ids): :left when a corpus was not judged or the subject's own row does
  not reach level 3 passing levels 1 and 2 (read ok, both equal, its print compiled: its own row says so), :not-judged when
  the reference's original has no object file (no row or not compiled), else judge-row on the crossed row: :passes or
  :differs."
  [^String work ids gcc {:keys [subject reference]}]
  (let [split (fn [^String fid] (let [i (.indexOf fid "/")] [(subs fid 0 i) (subs fid (inc i))]))
        [sc sn] (split subject) [rc rn] (split reference)
        sd (str work "/" sc) rd (str work "/" rc)]
    (if-not (and (some #{sc} ids) (some #{rc} ids))
      :left
      (let [srow (get (read-tsv (str sd "/forms.tsv")) sn)
            sobj (get (read-tsv (str sd "/obj.tsv")) sn)
            robj (get (read-tsv (str rd "/obj.tsv")) rn)
            [read l1 l2] srow]
        (cond
          (not (and (= read "ok") (= l1 "equal") (= l2 "equal") (= "0" (second sobj)))) :left
          ;; GT8: a partial run (--only) that does not hold the reference leaves the control
          (and (results/partial-names work rc) (not (contains? (read-tsv (str rd "/forms.tsv")) rn))) :left
          (not= "0" (first robj)) :not-judged
          :else
          (let [man (read-string (slurp "test/c/corpora.edn"))
                run? (= :run (:action (first (filter #(= (:id %) (keyword sc)) (:corpora man)))))
                [obj run] (crossed sd sn sobj (get (read-tsv (str sd "/run.tsv")) sn) rd rn robj (get (read-tsv (str rd "/run.tsv")) rn))
                j (judge-row (into [sn] srow) obj run (get gcc [sc sn]) nil run?)]
            (if (= "pass" (:status j)) :passes :differs)))))))

(defn roundtrip-controls
  "The controls of the corpora judged (ids), each printed; the failing ones as rows [ID :fail WHY]."
  [^String work ids]
  (let [gcc (load-gcc)]
    (vec (for [{:keys [id subject reference] :as c} (filter #(= :roundtrip (:level %)) (read-string (slurp "test/c/controls.edn")))
               :let [v (roundtrip-control-result work ids gcc c)
                     pair (str subject "'s print (object, run) against " reference "'s original's")
                     _ (println (case v
                                  :differs (str "repr-c roundtrip: control " id " (" pair "): differs, as a control must (GTS81 (a))")
                                  :passes (str "repr-c roundtrip: control passed: " id " (" pair "): the judge passes what differs")
                                  :not-judged (str "repr-c roundtrip: control not judged: " id ": " reference "'s original has no object file in the run")
                                  :left (str "repr-c roundtrip: control " id ": left (" subject " or " reference " not in the run, or " subject " not through levels 1-2)")))]
               :when (#{:passes :not-judged} v)]
           [id :fail (str "control " (name v) " (test/c/controls.edn)")]))))

;; GTS81 (a), queue 159: levels 1 and 2 crossed, one control each (test/c/controls.edn, :level :roundtrip-forms and
;; :roundtrip-full): the subject's own row with one level replaced, by the level's own comparison (level1, level2) on the
;; texts check-file kept for the controls' files (control/), the subject's reread forms against the reference's read
;; (:roundtrip-forms), the subject's :full print against the reference's original (:roundtrip-full); the row judged by
;; judge-row, which must not pass. The subject's own row must pass whole (else it would fail the crossed row by itself).

(defn- slurp-or-nil [^String p] (when (.exists (java.io.File. p)) (slurp p)))

(defn text-control-result
  "A :roundtrip-forms or :roundtrip-full control judged after the corpora (ids): :left when a corpus was not judged or the
  subject's own row does not pass (judge-row, no known entry); :not-judged when a text the level compares was not kept
  (the subject's reread or :full print, the reference's read or original); else judge-row on the subject's row with the
  level crossed: :passes or :differs."
  [^String work ids gcc {:keys [level subject reference]}]
  (let [split (fn [^String fid] (let [i (.indexOf fid "/")] [(subs fid 0 i) (subs fid (inc i))]))
        [sc sn] (split subject) [rc rn] (split reference)
        sd (str work "/" sc) rd (str work "/" rc)]
    (if-not (and (some #{sc} ids) (some #{rc} ids))
      :left
      (let [srow (get (read-tsv (str sd "/forms.tsv")) sn)
            sobj (get (read-tsv (str sd "/obj.tsv")) sn)
            srun (get (read-tsv (str sd "/run.tsv")) sn)
            man (read-string (slurp "test/c/corpora.edn"))
            run? (= :run (:action (first (filter #(= (:id %) (keyword sc)) (:corpora man)))))
            g (get gcc [sc sn])
            own (when srow (judge-row (into [sn] srow) sobj srun g nil run?))
            [read l1 l2 _ & more] srow
            crossed-l (case level
                        :roundtrip-forms
                        (let [a (slurp-or-nil (str rd "/control/" rn ".read")) ua (slurp-or-nil (str rd "/control/" rn ".read-units"))
                              b (slurp-or-nil (str sd "/control/" sn ".reread")) ub (slurp-or-nil (str sd "/control/" sn ".reread-units"))]
                          (when (and a ua b ub) (first (level1 a (read-string ua) b (read-string ub)))))
                        :roundtrip-full
                        (let [o (bytes-or-nil (str rd "/control/" rn ".orig")) t (bytes-or-nil (str sd "/control/" sn ".full"))]
                          (when (and o t) (level2 o t))))]
        (cond
          (not= "pass" (:status own)) :left
          ;; GT8: a partial run (--only) that does not hold the reference leaves the control
          (and (results/partial-names work rc) (not (contains? (read-tsv (str rd "/forms.tsv")) rn))) :left
          (nil? crossed-l) :not-judged
          :else
          (let [row (case level
                      :roundtrip-forms (into [sn read crossed-l l2 ""] more)
                      :roundtrip-full (into [sn read l1 crossed-l ""] more))
                j (judge-row row sobj srun g nil run?)]
            (if (= "pass" (:status j)) :passes :differs)))))))

(defn text-controls
  "The :roundtrip-forms and :roundtrip-full controls of the corpora judged (ids), each printed; the failing ones as rows
  [ID :fail WHY]."
  [^String work ids]
  (let [gcc (load-gcc)
        what {:roundtrip-forms ["reread forms (level 1)" "read forms"] :roundtrip-full [":full print (level 2)" "original"]}]
    (vec (for [{:keys [id level subject reference] :as c} (filter #(what (:level %)) (read-string (slurp "test/c/controls.edn")))
               :let [v (text-control-result work ids gcc c)
                     [w r] (what level)
                     pair (str subject "'s " w " against " reference "'s " r)
                     _ (println (case v
                                  :differs (str "repr-c roundtrip: control " id " (" pair "): differs, as a control must (GTS81 (a))")
                                  :passes (str "repr-c roundtrip: control passed: " id " (" pair "): the judge passes what differs")
                                  :not-judged (str "repr-c roundtrip: control not judged: " id ": the " r " of " reference " or the " w " of " subject " not kept in the run")
                                  :left (str "repr-c roundtrip: control " id ": left (" subject " or " reference " not in the run, or " subject "'s own row not passing)")))]
               :when (#{:passes :not-judged} v)]
           [id :fail (str "control " (name v) " (test/c/controls.edn)")]))))

;; queue 409: the own verdict's control (test/c/controls.edn, :level :roundtrip-own): the subject, a file the reader rejects for
;; the reason its own dg-error directives state (own-rejects?), its read error's line and message judged by own-rejects? against
;; the reference's directives, which must not accept them (the line judge and the words judge alike).

(defn own-control-result
  "A :roundtrip-own control judged after the corpora (ids): :left when a corpus was not judged, the reference is not in the run
  or the subject's own read is not rejected for its own directives' reason, else own-rejects? on the subject's error (its line,
  column and message, the file's name dropped) against the reference's file: :passes or :differs. Since queue 495 own-verdict:
  also the reference's recorded verdict (test/repr/c/print-own.edn's :at) must not accept the subject's error."
  [^String work ids {:keys [subject reference]}]
  (let [split (fn [^String fid] (let [i (.indexOf fid "/")] [(subs fid 0 i) (subs fid (inc i))]))
        [sc sn] (split subject) [rc rn] (split reference)
        sd (str work "/" sc) rd (str work "/" rc)
        base (fn [^String d] (let [f (java.io.File. (str d "/base.txt"))] (when (.exists f) (str/trim (slurp f)))))]
    (if-not (and (some #{sc} ids) (some #{rc} ids))
      :left
      (let [[read _ _ detail] (get (read-tsv (str sd "/forms.tsv")) sn)
            sb (base sd) rb (base rd)
            lcm (second (re-find #"^(?:.*?:)?(\d+:\d+: .*)$" (str detail)))]
        (cond
          (not (and (= read "error") sb rb lcm (contains? (read-tsv (str rd "/forms.tsv")) rn))) :left
          ;; queue 495: own-verdict, the dg-error words or the recorded verdict (print-own.edn), with each file's own id
          (not (own-verdict (str sb "/" sn) subject detail)) :left
          (own-verdict (str rb "/" rn) reference lcm) :passes
          :else :differs)))))

(defn own-controls
  "The :roundtrip-own controls of the corpora judged (ids), each printed; the failing ones as rows [ID :fail WHY]."
  [^String work ids]
  (vec (for [{:keys [id subject reference] :as c} (filter #(= :roundtrip-own (:level %)) (read-string (slurp "test/c/controls.edn")))
             :let [v (own-control-result work ids c)
                   pair (str subject "'s read error against " reference "'s dg-error directives")
                   _ (println (case v
                                :differs (str "repr-c roundtrip: control " id " (" pair "): differs, as a control must (GTS81 (a))")
                                :passes (str "repr-c roundtrip: control passed: " id " (" pair "): the judge passes what differs")
                                :left (str "repr-c roundtrip: control " id ": left (" subject " or " reference " not in the run, or " subject " not rejected for its own reason)")))]
             :when (= :passes v)]
         [id :fail (str "control " (name v) " (test/c/controls.edn)")])))

(defn record
  "Rewrites test/repr/c/roundtrip-known.edn's entries of the corpora `ids` from WORK: every file that
  does not pass, its class kept. A failing file of no class is not written (no placeholder class: queue 122, F1): it is
  printed and the result is the number of such files (the caller fails)."
  ([^String work ids] (record work ids known-file))
  ([^String work ids ^String known-file]
  (let [known (read-string (slurp known-file))
        left (atom [])
        known (reduce (fn [known id]
                        (let [old (get-in known [:roundtrip (keyword id)] {})
                              rows (map #(str/split % #"\t" -1) (remove str/blank? (str/split-lines (slurp (str work "/" id "/files.tsv")))))
                              es (into (sorted-map) (for [[nm st & more] rows
                                                          :let [e (get old nm)]
                                                          ;; GTS-B: a :time-dependent entry kept whatever its file's outcome
                                                          :when (or (#{"fail" "known"} st) (:time-dependent e))
                                                          :let [_ (when-not e (swap! left conj (str id " " nm ": " st " " (last more))))]
                                                          :when e]
                                                      [nm e]))]
                          (if (seq es) (assoc-in known [:roundtrip (keyword id)] es) (update known :roundtrip dissoc (keyword id)))))
                      known ids)]
    (spit known-file
          (str ";; The files of the round trip (bin/repr-c roundtrip; doc/C23-SURVEY.md, \"As built: C3b\") that do not pass\n"
               ";; every level, by corpus, each with its class (the classes below). Written by bin/repr-c roundtrip --record,\n"
               ";; the classes kept. Read with the Clojure reader.\n"
               "{:classes\n {" (str/join "\n  " (for [[k v] (sort-by key (:classes known))] (str k " " (pr-str v)))) "}\n"
               " :roundtrip\n {"
               (str/join "\n  " (for [[c es] (sort (:roundtrip known))]
                                  (str c "\n  {" (str/join "\n   " (for [[f e] (sort-by key es)] (str (pr-str f) " " (pr-str e)))) "}")))
               "}}\n"))
    (println "recorded" known-file)
    (doseq [l @left] (println (str "repr-c roundtrip --record: no class: " l)))
    (when (seq @left)
      (println (str "repr-c roundtrip --record: " (count @left) " failing files of no class left out of " known-file
                    ": give each a class of :classes (or a new one) by hand, then judge again")))
    (count @left))))

(defn -main [cmd & args]
  (case cmd
    "forms" (let [[work & ids] args] (doseq [id ids] (forms work id)) (shutdown-agents))
    ("judge" "judge-recorded")
    (let [[work & ids] (if (= cmd "judge") args (cons (first args) (drop 2 args)))
          recorded (when (= cmd "judge-recorded") (second args))
          st (reduce max 0 (map #(judge work % recorded) ids))
          ;; GTS81 (a): the negative controls (test/c/controls.edn, :roundtrip), no row of files.tsv or the counts; under
          ;; judge-recorded the :roundtrip ones are left (no object in the run: obj.tsv absent)
          cs (-> (roundtrip-controls work ids) (into (text-controls work ids)) (into (own-controls work ids)))]
      (doseq [r cs] (println (str "FAIL " (first r) "\t" (nth r 2))))
      (shutdown-agents)
      (System/exit (if (seq cs) 1 st)))
    "record" (let [[work & ids] args
                   n (record work ids)]
               (shutdown-agents)
               ;; 3: the known file written, failing files of no class left out of it (the caller judges and fails)
               (System/exit (if (pos? n) 3 0)))
    (do (println "rtcheck: forms, judge, judge-recorded WORK RESULTS ID... or record") (System/exit 2))))

(ns arbace.repr.c.rtcheck
  "repr/c's round trip (doc/c/SPEC.md §3.1; doc/C23-SURVEY.md, \"As built: C3b\"; bin/repr-c roundtrip,
  its driver bin/lib/repr-c/roundtrip): each file of the corpora read into C forms, printed in mode
  :lines and read again, the forms equal (level 1, `forms`); read in mode :full and printed, the
  original byte for byte (level 2); the :lines print compiled by the reference, its object file the
  original's byte for byte (level 3, the driver's gcc runs) and, for the run corpora, its program run as
  the original's (level 4, E2's measure); a file that does not pass is known with its class
  (test/repr/c/roundtrip-known.edn), or fails. Also the reference's acceptance of every file (CS61 (a),
  test/repr/c/parse-gcc.tsv) against the reader's."
  (:require [arbace.repr.c :as rc]
            [arbace.repr.c.host :as host]
            [arbace.repr.c.layout :as layout]
            [arbace.repr.c.lex :as lex]
            [arbace.repr.c.parse :as parse]
            [arbace.repr.c.results :as results]
            [arbace.string :as str])
  (:import [java.util.concurrent Executors Callable]))

(set! *warn-on-reflection* true)

(def known-file "test/repr/c/roundtrip-known.edn")
(def gcc-file "test/repr/c/parse-gcc.tsv")

(defn- spit-bytes [^String path ^bytes bs]
  (when-let [p (.getParentFile (java.io.File. path))] (.mkdirs p))
  (java.nio.file.Files/write (.toPath (java.io.File. path)) bs ^"[Ljava.nio.file.OpenOption;" (make-array java.nio.file.OpenOption 0)))

(defn- dir-of ^String [^String p] (let [i (.lastIndexOf p "/")] (if (neg? i) "." (subs p 0 i))))

(defn- abs-incs
  "A file configuration whose relative -I paths are made absolute against `base`, with `extra` first."
  [fc ^String base extra]
  (let [abs (fn [^String p] (if (.startsWith p "/") p (str base "/" p)))]
    (-> fc
        (update :inc #(vec (concat extra (map abs %))))
        (update :args #(vec (map (fn [^String a] (if (and (.startsWith a "-I") (not (.startsWith a "-I/"))) (str "-I" (abs (subs a 2))) a)) %))))))

(def ^:private strip-keys #{:line :column :c/grouped})

(defn strip
  "A form without the metadata the :lines print does not keep (:line, N3's :c/grouped)."
  [x]
  (let [x (cond
            (seq? x) (with-meta (apply list (map strip x)) (meta x))
            (vector? x) (with-meta (mapv strip x) (meta x))
            (map? x) (into {} (map (fn [[k v]] [k (strip v)]) x))
            :else x)]
    (if (and (instance? arbace.lang.IObj x) (meta x))
      (with-meta x (into {} (map (fn [[k v]] [k (strip v)]) (apply dissoc (meta x) strip-keys))))
      x)))

(defn- forms-text [rd]
  (str/join "\n" (map #(layout/form-str (strip %)) (:forms rd))))

(defn- first-diff [^String a ^String b]
  (let [as (str/split-lines a) bs (str/split-lines b)]
    (first (for [i (range (max (count as) (count bs)))
                 :when (not= (get as i) (get bs i))]
             (let [^String x (str (get as i)) ^String y (str (get bs i))
                   k (loop [k 0] (if (and (< k (count x)) (< k (count y)) (= (.charAt x k) (.charAt y k))) (recur (inc k)) k))
                   from (max 0 (- k 60))]
               (str "form " (inc i) " at " k ": " (subs x from (min (count x) (+ k 120))) " | " (subs y from (min (count y) (+ k 120)))))))))

(defn- one-line ^String [x] (str/replace (str x) #"[\t\n]" " "))

(defn level1
  "Level 1's comparison: the read's forms text and header units (a, ua) against the reread's (b, ub): [\"equal\" nil] or
  [\"differ\" DETAIL]."
  [^String a ua ^String b ub]
  (if (and (= a b) (= (set ua) (set ub)))
    ["equal" nil]
    ["differ" (or (first-diff a b) "header units")]))

(defn level2
  "Level 2's comparison: the original's bytes against the :full print's (ISO-8859-1), byte for byte: \"equal\" or \"differ\"."
  [^bytes orig ^bytes printed]
  (if (java.util.Arrays/equals orig printed) "equal" "differ"))

(def ^:private keep-levels #{:roundtrip-forms :roundtrip-full})

(defn control-names
  "The names of the corpus `id` that a :roundtrip-forms or :roundtrip-full control (test/c/controls.edn) names, as subject or
  reference: the files whose texts check-file keeps under control/ (queue 159)."
  [^String id]
  (set (for [c (read-string (slurp "test/c/controls.edn")) :when (keep-levels (:level c))
             f [(:subject c) (:reference c)]
             :let [i (.indexOf ^String f "/")] :when (= (subs f 0 i) id)]
         (subs f (inc i)))))

(defn- keep-text
  "GTS81 (a), queue 159: a control's file keeps what levels 1 and 2 compared, under WORK/ID/control/NAME.KIND."
  [^String d ^String nm ^String kind ^bytes bs]
  (spit-bytes (str d "/control/" nm "." kind) bs))

(defn check-file
  "One file: [name read l1 l2 detail], the print written under WORK/ID/print/. A control's file (keep, control-names)
  keeps what levels 1 and 2 compared under WORK/ID/control/: NAME.read and NAME.reread (the forms texts, with their header
  units in NAME.read-units and NAME.reread-units), NAME.orig and NAME.full (the original's bytes, the :full print's)."
  ([^String work ^String id h ^String base e] (check-file work id h base e false))
  ([^String work ^String id h ^String base e keep]
  (let [nm (:name e)
        d (str work "/" id)
        fc (:fc e)
        cfg (host/config h fc base)
        orig (lex/read-bytes (str base "/" nm))
        budget (* 1000000000 (Long/parseLong (or (System/getenv "REPR_C_READ_BUDGET") "120")))
        ;; the original read as its corpus names it (gcc's testsuite: absolute, as DejaGnu does), the print
        ;; under its relative name
        rn (or (:read e) nm)
        rd (binding [parse/*deadline* (+ (System/nanoTime) budget)]
             (try (rc/read-c cfg fc rn false)
                  (catch Throwable x (if (:deadline (ex-data x)) {:timeout true} {:crash (str x)}))))]
    (cond
      (:timeout rd) [nm "timeout" "-" "-" "the evaluated read's budget (REPR_C_READ_BUDGET s) spent"]
      (:crash rd) [nm "crash" "-" "-" (one-line (:crash rd))]
      (:error rd) [nm "error" "-" "-" (one-line (first (:error rd)))]
      (:refused rd) [nm (str "refused:" (name (:refused rd))) "-" "-" (one-line (:message rd))]
      :else
      (binding [parse/*deadline* (+ (System/nanoTime) (* 2 budget))]
      (let [pr (try (rc/print-c (:file-form rd) (:forms rd)) (catch Throwable x (str "\u0000print-crash " x)))]
        (if (.startsWith ^String pr "\u0000")
          [nm "ok" "print-crash" "-" (one-line (subs pr 1))]
          (let [pdir (str d "/print/" nm ".d") ; a directory a file: another print is not the original
                _ (spit-bytes (str pdir "/" nm) (.getBytes ^String pr "UTF-8"))
                fc2 (update (abs-incs fc base [(dir-of (str base "/" nm))]) :embed-dirs #(vec (concat % [(dir-of (str base "/" nm))])))
                rd2 (try (rc/read-c (host/config h fc2 pdir) fc2 nm false) (catch Throwable x {:crash (str x)}))
                a (forms-text rd)
                _ (when keep
                    (keep-text d nm "read" (.getBytes ^String a "UTF-8"))
                    (keep-text d nm "read-units" (.getBytes (pr-str (vec (sort (map str (keys (:units rd)))))) "UTF-8")))
                [l1 detail] (cond
                              (:crash rd2) ["reread-crash" (:crash rd2)]
                              (:error rd2) ["reread-error" (first (:error rd2))]
                              (:refused rd2) ["reread-refused" (:message rd2)]
                              :else (let [b (forms-text rd2)]
                                      (when keep
                                        (keep-text d nm "reread" (.getBytes ^String b "UTF-8"))
                                        (keep-text d nm "reread-units" (.getBytes (pr-str (vec (sort (map str (keys (:units rd2)))))) "UTF-8")))
                                      (level1 a (map str (keys (:units rd))) b (map str (keys (:units rd2))))))
                full (try (rc/read-c cfg fc rn true) (catch Throwable x {:crash (str x)}))
                l2 (cond
                     (:crash full) "crash"
                     (:refused full) (str "refused:" (name (:refused full)))
                     (:error full) "error"
                     :else (let [t (.getBytes ^String (rc/print-c (:file-form full) (:forms full)) "ISO-8859-1")]
                             (when keep (keep-text d nm "orig" orig) (keep-text d nm "full" t))
                             (level2 orig t)))
                fix (if (or (:crash rd2) (:error rd2) (:refused rd2))
                      "-"
                      (if (= pr (try (rc/print-c (:file-form rd2) (:forms rd2)) (catch Throwable _ nil))) "equal" "differ"))]
            [nm "ok" l1 l2 (if detail (one-line detail) "") fix]))))))))

(defn forms
  "Levels 1 and 2 of the corpus `id` under WORK (its lists made by arbace.repr.c.ppcheck/lists):
  WORK/ID/forms.tsv, the prints under print/, gcc3.list (name, standard, options, the original's
  directory) for the driver's level 3."
  [^String work ^String id]
  (let [d (str work "/" id)
        base (str/trim (slurp (str d "/base.txt")))
        entries (read-string (slurp (str d "/files.edn")))
        h (host/load-host "test/c/host")
        keep (control-names id)
        threads (Integer/parseInt (or (System/getenv "REPR_C_THREADS") "8"))
        pool (Executors/newFixedThreadPool threads)
        t0 (System/nanoTime)
        futs (mapv (fn [e] (.submit pool ^Callable (fn [] (try (check-file work id h base e (contains? keep (:name e)))
                                                               (catch Throwable x [(:name e) "crash" "-" "-" (one-line x)])))))
                   entries)
        rs (mapv #(.get ^java.util.concurrent.Future %) futs)
        _ (.shutdown pool)
        secs (/ (- (System/nanoTime) t0) 1e9)
        ok (filter #(= "ok" (nth % 1)) rs)
        by (fn [i] (frequencies (map #(nth % i) rs)))]
    (spit (str d "/forms.tsv") (str/join (map #(str (str/join "\t" %) "\n") rs)))
    (spit (str d "/gcc3.list")
          (str/join (for [r ok
                          :let [e (first (filter #(= (:name %) (first r)) entries))
                                fc (abs-incs (:fc e) base [])]]
                      (str (first r) "\t" (:std fc) "\t" (str/join " " (:args fc)) "\t" base "\t" (or (:read e) (first r)) "\n"))))
    (println (str id ": " (count rs) " files, read " (pr-str (by 1)) ", level 1 " (pr-str (by 2)) ", level 2 " (pr-str (by 3))
                  ", " (Math/round (double secs)) " s"))))

;; ---------------------------------------------------------------------------------------------
;; The judgment

(defn- read-tsv [^String p]
  (let [f (java.io.File. p)]
    (if (.exists f)
      (into {} (map (fn [l] (let [xs (str/split l #"\t" -1)] [(first xs) (vec (rest xs))])) (remove str/blank? (str/split-lines (slurp p)))))
      {})))

(defn load-gcc
  "The reference's acceptance of every file (CS61 (a)): {[corpus name] status}."
  []
  (let [f (java.io.File. ^String gcc-file)]
    (if (.exists f)
      (into {} (for [l (str/split-lines (slurp gcc-file)) :when (not (str/blank? l)) :when (not (.startsWith ^String l "#"))
                     :let [[st cn] (str/split l #"\t")
                           i (.indexOf ^String cn "/")]]
                 [[(subs cn 0 i) (subs cn (inc i))] st]))
      {})))

(defn- judge-row
  "A file's status at each level and overall: {:status pass|known|fail :levels {...} :class k}."
  [[nm read l1 l2 detail] obj run gcc known run?]
  (let [[os ps cmp] obj
        [ro rp same] run
        l3 (cond (not= read "ok") "-"
                 (nil? cmp) "-"
                 (not= os "0") "orig-fails"
                 (not= ps "0") "print-rejected"
                 :else cmp)
        l4 (cond (not run?) "-" (not= read "ok") "-" (nil? same) "-" :else same)
        accept (cond (= read "error") (if (= gcc "0") "port-only-rejects" "both-reject")
                     (nil? gcc) "unrecorded"
                     (= gcc "0") "agree"
                     :else "gcc-only-rejects")
        bad (cond-> []
              (not (#{"ok" "error"} read)) (conj :read)
              (and (= read "ok") (not= l1 "equal")) (conj :l1)
              (and (= read "ok") (not= l2 "equal")) (conj :l2)
              (#{"differ" "print-rejected"} l3) (conj :l3)
              (= l4 "differ") (conj :l4)
              (= accept "port-only-rejects") (conj :accept))]
    {:name nm :read read :l1 l1 :l2 l2 :l3 l3 :l4 l4 :accept accept :detail detail
     :status (cond (empty? bad) "pass" known "known" :else "fail") :bad bad :class (:class known)}))

(defn judge
  "The corpus `id`'s levels judged (WORK/ID/forms.tsv, obj.tsv and run.tsv, the driver's): WORK/ID/
  files.tsv and report.edn, the summary printed; 1 when a file fails or a known entry is stale."
  [^String work ^String id]
  (let [d (str work "/" id)
        man (read-string (slurp "test/c/corpora.edn"))
        corpus (first (filter #(= (:id %) (keyword id)) (:corpora man)))
        run? (= :run (:action corpus))
        rows (map (fn [l] (str/split l #"\t" -1)) (remove str/blank? (str/split-lines (slurp (str d "/forms.tsv")))))
        obj (read-tsv (str d "/obj.tsv"))
        run (read-tsv (str d "/run.tsv"))
        gcc (load-gcc)
        known-all (read-string (slurp known-file))
        ;; GT8: a partial run (--only) holds the known entries of its files alone to account for them
        names (results/partial-names work id)
        known (results/in-run (get-in known-all [:roundtrip (keyword id)] {}) names)
        js (mapv (fn [r] (judge-row r (get obj (first r)) (get run (first r)) (get gcc [id (first r)]) (get known (first r)) run?)) rows)
        failing (filter #(= "fail" (:status %)) js)
        stale (for [[nm _] known :when (not (some #(and (= (:name %) nm) (= (:status %) "known")) js))] nm)
        unclassed (for [[nm k] known :when (not (contains? (:classes known-all) (:class k)))] nm)
        fr (fn [k] (into (sorted-map) (frequencies (map k js))))
        report {:corpus id :files (count js) :status (fr :status) :read (fr :read) :level1 (fr :l1) :level2 (fr :l2)
                :level3 (fr :l3) :level4 (fr :l4) :accept (fr :accept) :failing (count failing) :stale-known (vec stale)
                :known-classes (fr :class)}]
    (spit (str d "/files.tsv") (str/join (map #(str (str/join "\t" [(:name %) (:status %) (:read %) (:l1 %) (:l2 %) (:l3 %) (:l4 %) (:accept %)
                                                                    (some-> (:class %) name) (:detail %)]) "\n") js)))
    (spit (str d "/report.edn") (pr-str report))
    (println (str id ": " (count js) " files " (pr-str (:status report)) "; read " (pr-str (:read report))
                  "; l1 " (pr-str (:level1 report)) "; l2 " (pr-str (:level2 report)) "; l3 " (pr-str (:level3 report))
                  (when run? (str "; l4 " (pr-str (:level4 report)))) "; gcc " (pr-str (:accept report))
                  (when (seq failing) (str "; " (count failing) " failing"))
                  (when (seq stale) (str "; " (count stale) " known entries stale"))
                  (when (seq unclassed) (str "; " (count unclassed) " of no class"))
                  (when names (str " (a partial run: " (count names) " listed files)"))))
    ;; GT8: each failing file as FAIL CORPUS/NAME WHY (the rotation's :failed-re)
    (results/print-failing id (concat (for [j failing] [(:name j) (str "levels " (str/join "," (map name (:bad j))) ": read " (:read j)
                                                                         ", l1 " (:l1 j) ", l2 " (:l2 j) ", l3 " (:l3 j) ", l4 " (:l4 j) " " (:detail j))])
                                      (for [nm stale] [nm "known entry stale"])))
    (if (or (seq failing) (seq stale) (seq unclassed)) 1 0)))

;; GTS81 (a): the negative controls of the round trip (test/c/controls.edn, :level :roundtrip): the subject's own row (read,
;; levels 1 and 2, its acceptance) with its levels 3 and 4 crossed, its print's object file and run against the reference's
;; original's (the driver's obj/orig/R.o and run/R/o/, kept), compared as the driver compares (cmp -s: byte for byte; the
;; status and the standard output), the row judged by judge-row, which must not pass. Levels 1 and 2 crossed are the
;; :roundtrip-forms and :roundtrip-full controls below (queue 159), from the texts check-file keeps for the controls' files.

(defn- bytes-or-nil ^bytes [^String p] (let [f (java.io.File. p)] (when (.exists f) (lex/read-bytes p))))

(defn crossed
  "The crossed level-3 and level-4 rows of a subject (its corpus directory sd, name sn) against a reference (rd, rn), as the
  driver writes obj.tsv's and run.tsv's: [[os ps cmp] [ro rp same]], the original's status the reference's and the print's
  the subject's; the run row nil when either has none (not a run corpus, --no-run)."
  [^String sd ^String sn sobj srun ^String rd ^String rn robj rrun]
  (let [os (first robj) ps (second sobj)
        eq (fn [a b] (let [x (bytes-or-nil a) y (bytes-or-nil b)] (boolean (and x y (java.util.Arrays/equals x y)))))
        cmp (if (and (= os "0") (= ps "0")) (if (eq (str rd "/obj/orig/" rn ".o") (str sd "/obj/print/" sn ".o")) "equal" "differ") "-")
        run (when (and rrun srun (not= "link" (first rrun)) (not= "link" (second srun)))
              (let [ro (first rrun) rp (second srun)]
                [ro rp (if (and (= ro rp) (eq (str rd "/run/" rn "/o/stdout") (str sd "/run/" sn "/p/stdout"))) "same" "differ")]))]
    [[os ps cmp] run]))

(defn roundtrip-control-result
  "A :roundtrip control judged after the corpora (ids): :left when a corpus was not judged or the subject's own row does
  not reach level 3 passing levels 1 and 2 (read ok, both equal, its print compiled: its own row says so), :not-judged when
  the reference's original has no object file (no row or not compiled), else judge-row on the crossed row: :passes or
  :differs."
  [^String work ids gcc {:keys [subject reference]}]
  (let [split (fn [^String fid] (let [i (.indexOf fid "/")] [(subs fid 0 i) (subs fid (inc i))]))
        [sc sn] (split subject) [rc rn] (split reference)
        sd (str work "/" sc) rd (str work "/" rc)]
    (if-not (and (some #{sc} ids) (some #{rc} ids))
      :left
      (let [srow (get (read-tsv (str sd "/forms.tsv")) sn)
            sobj (get (read-tsv (str sd "/obj.tsv")) sn)
            robj (get (read-tsv (str rd "/obj.tsv")) rn)
            [read l1 l2] srow]
        (cond
          (not (and (= read "ok") (= l1 "equal") (= l2 "equal") (= "0" (second sobj)))) :left
          ;; GT8: a partial run (--only) that does not hold the reference leaves the control
          (and (results/partial-names work rc) (not (contains? (read-tsv (str rd "/forms.tsv")) rn))) :left
          (not= "0" (first robj)) :not-judged
          :else
          (let [man (read-string (slurp "test/c/corpora.edn"))
                run? (= :run (:action (first (filter #(= (:id %) (keyword sc)) (:corpora man)))))
                [obj run] (crossed sd sn sobj (get (read-tsv (str sd "/run.tsv")) sn) rd rn robj (get (read-tsv (str rd "/run.tsv")) rn))
                j (judge-row (into [sn] srow) obj run (get gcc [sc sn]) nil run?)]
            (if (= "pass" (:status j)) :passes :differs)))))))

(defn roundtrip-controls
  "The controls of the corpora judged (ids), each printed; the failing ones as rows [ID :fail WHY]."
  [^String work ids]
  (let [gcc (load-gcc)]
    (vec (for [{:keys [id subject reference] :as c} (filter #(= :roundtrip (:level %)) (read-string (slurp "test/c/controls.edn")))
               :let [v (roundtrip-control-result work ids gcc c)
                     pair (str subject "'s print (object, run) against " reference "'s original's")
                     _ (println (case v
                                  :differs (str "repr-c roundtrip: control " id " (" pair "): differs, as a control must (GTS81 (a))")
                                  :passes (str "repr-c roundtrip: control passed: " id " (" pair "): the judge passes what differs")
                                  :not-judged (str "repr-c roundtrip: control not judged: " id ": " reference "'s original has no object file in the run")
                                  :left (str "repr-c roundtrip: control " id ": left (" subject " or " reference " not in the run, or " subject " not through levels 1-2)")))]
               :when (#{:passes :not-judged} v)]
           [id :fail (str "control " (name v) " (test/c/controls.edn)")]))))

;; GTS81 (a), queue 159: levels 1 and 2 crossed, one control each (test/c/controls.edn, :level :roundtrip-forms and
;; :roundtrip-full): the subject's own row with one level replaced, by the level's own comparison (level1, level2) on the
;; texts check-file kept for the controls' files (control/), the subject's reread forms against the reference's read
;; (:roundtrip-forms), the subject's :full print against the reference's original (:roundtrip-full); the row judged by
;; judge-row, which must not pass. The subject's own row must pass whole (else it would fail the crossed row by itself).

(defn- slurp-or-nil [^String p] (when (.exists (java.io.File. p)) (slurp p)))

(defn text-control-result
  "A :roundtrip-forms or :roundtrip-full control judged after the corpora (ids): :left when a corpus was not judged or the
  subject's own row does not pass (judge-row, no known entry); :not-judged when a text the level compares was not kept
  (the subject's reread or :full print, the reference's read or original); else judge-row on the subject's row with the
  level crossed: :passes or :differs."
  [^String work ids gcc {:keys [level subject reference]}]
  (let [split (fn [^String fid] (let [i (.indexOf fid "/")] [(subs fid 0 i) (subs fid (inc i))]))
        [sc sn] (split subject) [rc rn] (split reference)
        sd (str work "/" sc) rd (str work "/" rc)]
    (if-not (and (some #{sc} ids) (some #{rc} ids))
      :left
      (let [srow (get (read-tsv (str sd "/forms.tsv")) sn)
            sobj (get (read-tsv (str sd "/obj.tsv")) sn)
            srun (get (read-tsv (str sd "/run.tsv")) sn)
            man (read-string (slurp "test/c/corpora.edn"))
            run? (= :run (:action (first (filter #(= (:id %) (keyword sc)) (:corpora man)))))
            g (get gcc [sc sn])
            own (when srow (judge-row (into [sn] srow) sobj srun g nil run?))
            [read l1 l2 _ & more] srow
            crossed-l (case level
                        :roundtrip-forms
                        (let [a (slurp-or-nil (str rd "/control/" rn ".read")) ua (slurp-or-nil (str rd "/control/" rn ".read-units"))
                              b (slurp-or-nil (str sd "/control/" sn ".reread")) ub (slurp-or-nil (str sd "/control/" sn ".reread-units"))]
                          (when (and a ua b ub) (first (level1 a (read-string ua) b (read-string ub)))))
                        :roundtrip-full
                        (let [o (bytes-or-nil (str rd "/control/" rn ".orig")) t (bytes-or-nil (str sd "/control/" sn ".full"))]
                          (when (and o t) (level2 o t))))]
        (cond
          (not= "pass" (:status own)) :left
          ;; GT8: a partial run (--only) that does not hold the reference leaves the control
          (and (results/partial-names work rc) (not (contains? (read-tsv (str rd "/forms.tsv")) rn))) :left
          (nil? crossed-l) :not-judged
          :else
          (let [row (case level
                      :roundtrip-forms (into [sn read crossed-l l2 ""] more)
                      :roundtrip-full (into [sn read l1 crossed-l ""] more))
                j (judge-row row sobj srun g nil run?)]
            (if (= "pass" (:status j)) :passes :differs)))))))

(defn text-controls
  "The :roundtrip-forms and :roundtrip-full controls of the corpora judged (ids), each printed; the failing ones as rows
  [ID :fail WHY]."
  [^String work ids]
  (let [gcc (load-gcc)
        what {:roundtrip-forms ["reread forms (level 1)" "read forms"] :roundtrip-full [":full print (level 2)" "original"]}]
    (vec (for [{:keys [id level subject reference] :as c} (filter #(what (:level %)) (read-string (slurp "test/c/controls.edn")))
               :let [v (text-control-result work ids gcc c)
                     [w r] (what level)
                     pair (str subject "'s " w " against " reference "'s " r)
                     _ (println (case v
                                  :differs (str "repr-c roundtrip: control " id " (" pair "): differs, as a control must (GTS81 (a))")
                                  :passes (str "repr-c roundtrip: control passed: " id " (" pair "): the judge passes what differs")
                                  :not-judged (str "repr-c roundtrip: control not judged: " id ": the " r " of " reference " or the " w " of " subject " not kept in the run")
                                  :left (str "repr-c roundtrip: control " id ": left (" subject " or " reference " not in the run, or " subject "'s own row not passing)")))]
               :when (#{:passes :not-judged} v)]
           [id :fail (str "control " (name v) " (test/c/controls.edn)")]))))

(defn record
  "Rewrites test/repr/c/roundtrip-known.edn's entries of the corpora `ids` from WORK: every file that
  does not pass, its class kept. A failing file of no class is not written (no placeholder class: queue 122, F1): it is
  printed and the result is the number of such files (the caller fails)."
  ([^String work ids] (record work ids known-file))
  ([^String work ids ^String known-file]
  (let [known (read-string (slurp known-file))
        left (atom [])
        known (reduce (fn [known id]
                        (let [old (get-in known [:roundtrip (keyword id)] {})
                              rows (map #(str/split % #"\t" -1) (remove str/blank? (str/split-lines (slurp (str work "/" id "/files.tsv")))))
                              es (into (sorted-map) (for [[nm st & more] rows :when (#{"fail" "known"} st)
                                                          :let [e (get old nm)
                                                                _ (when-not e (swap! left conj (str id " " nm ": " st " " (last more))))]
                                                          :when e]
                                                      [nm e]))]
                          (if (seq es) (assoc-in known [:roundtrip (keyword id)] es) (update known :roundtrip dissoc (keyword id)))))
                      known ids)]
    (spit known-file
          (str ";; The files of the round trip (bin/repr-c roundtrip; doc/C23-SURVEY.md, \"As built: C3b\") that do not pass\n"
               ";; every level, by corpus, each with its class (the classes below). Written by bin/repr-c roundtrip --record,\n"
               ";; the classes kept. Read with the Clojure reader.\n"
               "{:classes\n {" (str/join "\n  " (for [[k v] (sort-by key (:classes known))] (str k " " (pr-str v)))) "}\n"
               " :roundtrip\n {"
               (str/join "\n  " (for [[c es] (sort (:roundtrip known))]
                                  (str c "\n  {" (str/join "\n   " (for [[f e] es] (str (pr-str f) " " (pr-str e)))) "}")))
               "}}\n"))
    (println "recorded" known-file)
    (doseq [l @left] (println (str "repr-c roundtrip --record: no class: " l)))
    (when (seq @left)
      (println (str "repr-c roundtrip --record: " (count @left) " failing files of no class left out of " known-file
                    ": give each a class of :classes (or a new one) by hand, then judge again")))
    (count @left))))

(defn -main [cmd & args]
  (case cmd
    "forms" (let [[work & ids] args] (doseq [id ids] (forms work id)) (shutdown-agents))
    "judge" (let [[work & ids] args
                  st (reduce max 0 (map #(judge work %) ids))
                  ;; GTS81 (a): the negative controls (test/c/controls.edn, :roundtrip), no row of files.tsv or the counts
                  cs (into (roundtrip-controls work ids) (text-controls work ids))]
              (doseq [r cs] (println (str "FAIL " (first r) "\t" (nth r 2))))
              (shutdown-agents)
              (System/exit (if (seq cs) 1 st)))
    "record" (let [[work & ids] args
                   n (record work ids)]
               (shutdown-agents)
               ;; 3: the known file written, failing files of no class left out of it (the caller judges and fails)
               (System/exit (if (pos? n) 3 0)))
    (do (println "rtcheck: forms, judge or record") (System/exit 2))))

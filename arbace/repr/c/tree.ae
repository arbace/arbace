;; The node types' table is derived from modernc.org/cc/v4 v4.29.7 as go-whim carries it
;; (https://github.com/arbace/go-whim at 80c49bf53cd6340487ac623f3d6d135b77ac1db6, crefactor/cc/ast.go,
;; generated by yy, and c23.go's BalancedTokenSequence; the kinds' names from stringer.go), whose notice
;; follows (LICENSE.md, "cc (modernc.org/cc/v4) and go-whim's C23 delta"):
;;
;; Copyright 2022 The CC Authors. All rights reserved.
;; Use of this source code is governed by a BSD-style
;; license that can be found in the LICENSE file.
;;
;; go-whim's C23 delta (the fields it adds: AttributeValue's Prefix, Colon, Colon2 and
;; BalancedTokenSequence, PostfixExpression's StorageClassSpecifiers, the AttributeSpecifierList of
;; DirectDeclarator, EnumSpecifier, Enumerator, ExpressionStatement, FunctionDefinition, Statement;
;; the cases StorageClassSpecifierConstexpr, TypeSpecifierBitInt) is licensed to Arbace under the
;; EPL-1.0 (doc/C23-SURVEY.md, CS37 (a)), and so is the rest of this file, Arbace's own.

(ns arbace.repr.c.tree
  "C's syntax trees as data, cc's (doc/C23-SURVEY.md, \"As built: C3\"): `types`, cc's 85 node types and
  go-whim's BalancedTokenSequence, each with its first case (the zero Case a node made without one has)
  and its exported fields in the struct's order; a node is a java.util.HashMap of :node (its type's
  name), :Case (its case's name, a keyword) and its fields by name (a child node, a token, a vector of
  them), with the parser's own facts under lower-case keys (:isTypename, :visible, :params ...), which
  are not part of the tree; a token is a `PTok`. `dump` writes a tree in tools/ccdump's tree format,
  line for line the helper's."
  (:require [arbace.repr.c.lex :as lex])
  (:import [arbace.repr.c.lex CFile]
           [java.util HashMap]))

(set! *warn-on-reflection* true)

;; A parser's token (cc's Token as the parser holds it): the kind after the parser's conversion
;; (keywords, INTCONST, FLOATCONST, TYPENAME), the texts, the position's file and offset, the
;; object-like macro that made it, the sequence number that decides the scopes.
(deftype PTok [ch ^String src ^String sep pf ^long po m ^long seq])

(defn ptok ^PTok [ch src sep pf po m seq] (PTok. ch src sep pf (long po) m (long seq)))
(defn with-ch ^PTok [^PTok t ch] (PTok. ch (.-src t) (.-sep t) (.-pf t) (.-po t) (.-m t) (.-seq t)))
(defn with-texts ^PTok [^PTok t ^String sep ^String src] (PTok. (.-ch t) src sep (.-pf t) (.-po t) (.-m t) (.-seq t)))
(defn with-seq ^PTok [^PTok t seq] (PTok. (.-ch t) (.-src t) (.-sep t) (.-pf t) (.-po t) (.-m t) (long seq)))

(defn pos-string
  "A token's position as token.Position's String gives it (\"-\" for none)."
  ^String [^PTok t]
  (if-let [f (.-pf t)] (lex/position-string (lex/position f (.-po t))) "-"))

(def types
  "Each node type: [its first case, nil when it has no Case; its exported fields but Case, in order]."
  {
   "AbstractDeclarator" [:AbstractDeclaratorPtr [:DirectAbstractDeclarator :Pointer]]
   "AdditiveExpression" [:AdditiveExpressionMul [:AdditiveExpression :MultiplicativeExpression :Token]]
   "AlignmentSpecifier" [:AlignmentSpecifierType [:ConstantExpression :Token :Token2 :Token3 :TypeName]]
   "AndExpression" [:AndExpressionEq [:AndExpression :EqualityExpression :Token]]
   "ArgumentExpressionList" [nil [:ArgumentExpressionList :AssignmentExpression :Token]]
   "Asm" [nil [:AsmArgList :AsmQualifierList :Token :Token2 :Token3 :Token4]]
   "AsmArgList" [nil [:AsmArgList :AsmExpressionList :Token]]
   "AsmExpressionList" [nil [:AsmExpressionList :AsmIndex :AssignmentExpression :Token]]
   "AsmIndex" [nil [:ExpressionList :Token :Token2]]
   "AsmQualifier" [:AsmQualifierVolatile [:Token]]
   "AsmQualifierList" [nil [:AsmQualifier :AsmQualifierList]]
   "AsmStatement" [nil [:Asm :Token]]
   "AssignmentExpression" [:AssignmentExpressionCond [:AssignmentExpression :ConditionalExpression :Token :UnaryExpression]]
   "AtomicTypeSpecifier" [nil [:Token :Token2 :Token3 :TypeName]]
   "AttributeSpecifier" [nil [:AttributeValueList :Token :Token2 :Token3 :Token4 :Token5]]
   "AttributeSpecifierList" [nil [:AttributeSpecifier :AttributeSpecifierList]]
   "AttributeValue" [:AttributeValueIdent [:ArgumentExpressionList :Token :Token2 :Token3 :Prefix :Colon :Colon2 :BalancedTokenSequence]]
   "AttributeValueList" [nil [:AttributeValue :AttributeValueList :Token]]
   "BlockItem" [:BlockItemDecl [:CompoundStatement :Declaration :DeclarationSpecifiers :Declarator :LabelDeclaration :Statement]]
   "BlockItemList" [nil [:BlockItem :BlockItemList]]
   "CastExpression" [:CastExpressionUnary [:CastExpression :Token :Token2 :TypeName :UnaryExpression]]
   "CompoundStatement" [nil [:BlockItemList :Token :Token2]]
   "ConditionalExpression" [:ConditionalExpressionLOr [:ConditionalExpression :ExpressionList :LogicalOrExpression :Token :Token2]]
   "ConstantExpression" [nil [:ConditionalExpression]]
   "Declaration" [:DeclarationDecl [:AttributeSpecifierList :DeclarationSpecifiers :Declarator :InitDeclaratorList :Initializer :StaticAssertDeclaration :Token :Token2 :Token3]]
   "DeclarationList" [nil [:Declaration :DeclarationList]]
   "DeclarationSpecifiers" [:DeclarationSpecifiersStorage [:AttributeSpecifierList :AlignmentSpecifier :DeclarationSpecifiers :FunctionSpecifier :StorageClassSpecifier :Token :TypeQualifier :TypeSpecifier]]
   "Declarator" [nil [:DirectDeclarator :Pointer]]
   "Designation" [nil [:DesignatorList :Token]]
   "Designator" [:DesignatorIndex [:ConstantExpression :ConstantExpression2 :Token :Token2 :Token3]]
   "DesignatorList" [nil [:Designator :DesignatorList]]
   "DirectAbstractDeclarator" [:DirectAbstractDeclaratorDecl [:AbstractDeclarator :AssignmentExpression :DirectAbstractDeclarator :ParameterTypeList :Token :Token2 :Token3 :TypeQualifiers]]
   "DirectDeclarator" [:DirectDeclaratorIdent [:AssignmentExpression :Declarator :DirectDeclarator :IdentifierList :ParameterTypeList :Token :Token2 :Token3 :TypeQualifiers :AttributeSpecifierList]]
   "EnumSpecifier" [:EnumSpecifierDef [:EnumTypeSpecifier :EnumeratorList :Token :Token2 :Token3 :Token4 :Token5 :AttributeSpecifierList]]
   "EnumTypeSpecifier" [nil [:SpecifierQualifierList :Token]]
   "Enumerator" [:EnumeratorIdent [:ConstantExpression :Token :Token2 :AttributeSpecifierList]]
   "EnumeratorList" [nil [:Enumerator :EnumeratorList :Token]]
   "EqualityExpression" [:EqualityExpressionRel [:EqualityExpression :RelationalExpression :Token]]
   "ExclusiveOrExpression" [:ExclusiveOrExpressionAnd [:AndExpression :ExclusiveOrExpression :Token]]
   "ExpressionList" [nil [:AssignmentExpression :ExpressionList :Token]]
   "ExpressionStatement" [nil [:AttributeSpecifierList :ExpressionList :Token]]
   "ExternalDeclaration" [:ExternalDeclarationFuncDef [:AsmStatement :Declaration :FunctionDefinition :Token]]
   "FunctionDefinition" [nil [:CompoundStatement :DeclarationList :DeclarationSpecifiers :Declarator :AttributeSpecifierList]]
   "FunctionSpecifier" [:FunctionSpecifierInline [:Token]]
   "GenericAssociation" [:GenericAssociationType [:AssignmentExpression :Token :Token2 :TypeName]]
   "GenericAssociationList" [nil [:GenericAssociation :GenericAssociationList :Token]]
   "GenericSelection" [nil [:AssignmentExpression :GenericAssociationList :Token :Token2 :Token3 :Token4]]
   "IdentifierList" [nil [:IdentifierList :Token :Token2]]
   "InclusiveOrExpression" [:InclusiveOrExpressionXor [:ExclusiveOrExpression :InclusiveOrExpression :Token]]
   "InitDeclarator" [:InitDeclaratorDecl [:AttributeSpecifierList :Asm :Declarator :Initializer :Token]]
   "InitDeclaratorList" [nil [:AttributeSpecifierList :InitDeclarator :InitDeclaratorList :Token]]
   "Initializer" [:InitializerExpr [:AssignmentExpression :InitializerList :Token :Token2 :Token3]]
   "InitializerList" [nil [:Designation :Initializer :InitializerList :Token]]
   "IterationStatement" [:IterationStatementWhile [:Declaration :ExpressionList :ExpressionList2 :ExpressionList3 :Statement :Token :Token2 :Token3 :Token4 :Token5]]
   "JumpStatement" [:JumpStatementGoto [:ExpressionList :Token :Token2 :Token3]]
   "LabelDeclaration" [nil [:IdentifierList :Token :Token2]]
   "LabeledStatement" [:LabeledStatementLabel [:ConstantExpression :ConstantExpression2 :Statement :Token :Token2 :Token3]]
   "LogicalAndExpression" [:LogicalAndExpressionOr [:InclusiveOrExpression :LogicalAndExpression :Token]]
   "LogicalOrExpression" [:LogicalOrExpressionLAnd [:LogicalAndExpression :LogicalOrExpression :Token]]
   "MultiplicativeExpression" [:MultiplicativeExpressionCast [:CastExpression :MultiplicativeExpression :Token]]
   "ParameterDeclaration" [:ParameterDeclarationDecl [:AttributeSpecifierList :AbstractDeclarator :DeclarationSpecifiers :Declarator]]
   "ParameterList" [nil [:ParameterDeclaration :ParameterList :Token]]
   "ParameterTypeList" [:ParameterTypeListList [:ParameterList :Token :Token2]]
   "Pointer" [:PointerTypeQual [:Pointer :Token :TypeQualifiers]]
   "PostfixExpression" [:PostfixExpressionPrimary [:ArgumentExpressionList :ExpressionList :InitializerList :PostfixExpression :PrimaryExpression :Token :Token2 :Token3 :Token4 :Token5 :TypeName :StorageClassSpecifiers]]
   "PrimaryExpression" [:PrimaryExpressionIdent [:CompoundStatement :ExpressionList :GenericSelection :Token :Token2]]
   "RelationalExpression" [:RelationalExpressionShift [:RelationalExpression :ShiftExpression :Token]]
   "SelectionStatement" [:SelectionStatementIf [:ExpressionList :Statement :Statement2 :Token :Token2 :Token3 :Token4]]
   "ShiftExpression" [:ShiftExpressionAdd [:AdditiveExpression :ShiftExpression :Token]]
   "SpecifierQualifierList" [:SpecifierQualifierListTypeSpec [:AttributeSpecifierList :AlignmentSpecifier :SpecifierQualifierList :TypeQualifier :TypeSpecifier]]
   "Statement" [:StatementLabeled [:AsmStatement :CompoundStatement :ExpressionStatement :IterationStatement :JumpStatement :LabeledStatement :SelectionStatement :AttributeSpecifierList]]
   "StaticAssertDeclaration" [nil [:ConstantExpression :Token :Token2 :Token3 :Token4 :Token5]]
   "StorageClassSpecifier" [:StorageClassSpecifierTypedef [:Declspecs :Token :Token2 :Token3]]
   "StructDeclaration" [:StructDeclarationDecl [:AttributeSpecifierList :SpecifierQualifierList :StaticAssertDeclaration :StructDeclaratorList :Token]]
   "StructDeclarationList" [nil [:StructDeclaration :StructDeclarationList]]
   "StructDeclarator" [:StructDeclaratorDecl [:ConstantExpression :Declarator :Token]]
   "StructDeclaratorList" [nil [:StructDeclarator :StructDeclaratorList :Token]]
   "StructOrUnion" [:StructOrUnionStruct [:Token]]
   "StructOrUnionSpecifier" [:StructOrUnionSpecifierDef [:AttributeSpecifierList :AttributeSpecifierList2 :StructDeclarationList :StructOrUnion :Token :Token2 :Token3]]
   "TranslationUnit" [nil [:ExternalDeclaration :TranslationUnit]]
   "TypeName" [nil [:AbstractDeclarator :SpecifierQualifierList]]
   "TypeQualifier" [:TypeQualifierConst [:AttributeSpecifierList :Token]]
   "TypeQualifiers" [:TypeQualifiersTypeQual [:TypeQualifier :TypeQualifiers]]
   "TypeSpecifier" [:TypeSpecifierVoid [:AtomicTypeSpecifier :EnumSpecifier :ExpressionList :StructOrUnionSpecifier :Token :Token2 :Token3 :TypeName]]
   "UnaryExpression" [:UnaryExpressionPostfix [:CastExpression :PostfixExpression :Token :Token2 :Token3 :TypeName :UnaryExpression]]
   "BalancedTokenSequence" [nil [:Token :BalancedTokenSequence]]
   })

(def kind-names
  "cc's names of the token kinds (runeName: stringer.go's line comments)."
  {:ADDASSIGN "'+='" :ALIGNAS "'_Alignas'" :ALIGNOF "'_Alignof'" :ANDAND "'&&'" :ANDASSIGN "'&='"
   :ARROW "'->'" :ASM "'__asm__'" :ATOMIC "'_Atomic'" :ATTRIBUTE "'__attribute__'" :AUTO "'auto'"
   :AUTOTYPE "'__auto_type'" :BF16 "'__bf16'" :BOOL "'_Bool'" :BREAK "'break'" :CASE "'case'"
   :CHAR "'char'" :CHARCONST "character constant" :COMPLEX "'_Complex'" :CONST "'const'"
   :CONTINUE "'continue'" :DDD "'...'" :DEC "'--'" :DECIMAL128 "'_Decimal128'" :DECIMAL32 "'_Decimal32'"
   :DECIMAL64 "'_Decimal64'" :DECLSPEC "'__declspec'" :DEFAULT "'default'" :DIVASSIGN "'/='" :DO "'do'"
   :DOUBLE "'double'" :ELSE "'else'" :ENUM "'enum'" :EQ "'=='" :EXTERN "'extern'" :FLOAT "'float'"
   :FLOAT128 "'_Float128'" :FLOAT128X "'_Float128x'" :FLOAT16 "'_Float16'" :FLOAT32 "'_Float32'"
   :FLOAT32X "'_Float32x'" :FLOAT64 "'_Float64'" :FLOAT64X "'_Float64x'"
   :FLOATCONST "floating point constant" :FOR "'for'" :GENERIC "'_Generic'" :GEQ "'>='" :GOTO "'goto'"
   :HEADER_NAME "<header-name>" :IDENTIFIER "identifier" :IF "'if'" :IMAG "'__imag__'"
   :IMAGINARY "'_Imaginary'" :INC "'++'" :INLINE "'inline'" :INT "'int'" :INT128 "'__int128'"
   :INTCONST "integer constant" :LABEL "'__label__'" :LEQ "'<='" :LONG "'long'"
   :LONGCHARCONST "long character constant" :LONGSTRINGLITERAL "long string literal" :LSH "'<<'"
   :LSHASSIGN "'<<='" :MODASSIGN "'%='" :MULASSIGN "'*='" :NEQ "'!='" :NONNULL "'_Nonnull'"
   :NORETURN "'_Noreturn'" :ORASSIGN "'|='" :OROR "'||'" :PPNUMBER "preprocessing number"
   :PPPASTE "'##'" :REAL "'__real__'" :REGISTER "'register'" :RESTRICT "'restrict'" :RETURN "'return'"
   :RSH "'>>'" :RSHASSIGN "'>>='" :SHORT "'short'" :SIGNED "'signed'" :SIZEOF "'sizeof'"
   :STATIC "'static'" :STATICASSERT "_Static_assert" :STRINGLITERAL "string literal" :STRUCT "'struct'"
   :SUBASSIGN "'-='" :SWITCH "'switch'" :THREADLOCAL "'_Thread_local'" :TYPEDEF "'typedef'"
   :TYPENAME "type name" :TYPEOF "'typeof'" :UINT128 "'__uint128_t'" :UNION "'union'"
   :UNSIGNED "'unsigned'" :VOID "'void'" :VOLATILE "'volatile'" :WHILE "'while'" :XORASSIGN "'^='"
   :BITINT "'_BitInt'" :CONSTEXPR "'constexpr'"
   :eof "<EOF>"})

(defn kind-name
  "cc's runeName of a kind: its name, the character quoted (%+q), <EOF>."
  ^String [ch]
  (cond
    (keyword? ch) (or (kind-names ch) (name ch))
    (char? ch) (lex/quote-rune-ascii (long (int ch)))
    :else (str ch)))

;; ---------------------------------------------------------------------------------------------
;; Nodes

(defn node
  "A new node of `type` (a key of `types`) with the fields `kvs` (nil values left out), its Case the
  type's first unless given."
  ^HashMap [^String type & kvs]
  (let [m (HashMap.)
        [c _] (or (get types type) (when-not (#{"Parameter"} type) (throw (ex-info (str "no node type " type) {}))))]
    (.put m :node type)
    (when c (.put m :Case c))
    (loop [kvs kvs]
      (when kvs
        (let [v (second kvs)] (when-not (nil? v) (.put m (first kvs) v)))
        (recur (nnext kvs))))
    m))

(defn node? [x] (instance? HashMap x))

;; ---------------------------------------------------------------------------------------------
;; The dump (tools/ccdump's tree mode, tools/ccdump/tree.go's header)

(defn- tok-line [^StringBuilder b ^long depth ^String field ^PTok t]
  (.append b depth) (.append b "\t") (.append b field) (.append b "\t@") (.append b (pos-string t))
  (.append b "\t") (.append b (kind-name (.-ch t))) (.append b "\t") (.append b (lex/esc (.-src t)))
  (.append b "\t") (.append b (lex/esc (.-sep t))) (.append b "\n"))

(defn- walk
  "The tree's lines, pre-order, with an explicit stack (cc's lists nest as deep as they are long: a file
  of 100,000 declarations is a chain of 100,000 TranslationUnits, deeper than the evaluator's calls)."
  [^StringBuilder b ^long depth ^String field x]
  (let [stack (java.util.ArrayDeque.)]
    (.push stack [depth field x])
    (loop []
      (when-not (.isEmpty stack)
        (let [[depth field x] (.pop stack)
              depth (long depth)]
          (cond
            (or (nil? x) (= x :tnil)) nil ; :tnil, a Go interface holding a nil pointer (the parser's typed nils)
            (instance? PTok x) (tok-line b depth field x)
            :else
            (let [^HashMap n x
                  ^String type (.get n :node)
                  [_ fields] (get types type)
                  d (inc depth)]
              (.append b depth) (.append b "\t") (.append b field) (.append b "\t") (.append b type)
              (when-let [c (.get n :Case)] (.append b "\t") (.append b (name c)))
              (.append b "\n")
              (doseq [[f v] (reverse (mapcat (fn [f]
                                                (let [v (.get n f)]
                                                  (if (vector? v)
                                                    (map-indexed (fn [i x] [(str (name f) "[" i "]") x]) v)
                                                    [[(name f) v]])))
                                              fields))]
                (.push stack [d f v]))))
          (recur))))))

(defn dump
  "A parse's result ({:tree :errors :notree :panic}) in tools/ccdump's tree format."
  ^String [r]
  (let [b (StringBuilder.)]
    (walk b 0 "TranslationUnit" (:tree r))
    (doseq [e (:errors r)] (.append b "#error\t") (.append b (lex/esc e)) (.append b "\n"))
    (when (:notree r) (.append b "#notree\n"))
    (when (:panic r) (.append b "#panic\t") (.append b (lex/esc (str (:panic r)))) (.append b "\n"))
    (.toString b)))

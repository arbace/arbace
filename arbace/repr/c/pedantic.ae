(ns arbace.repr.c.pedantic
  "The checker's pedantic mode, its lexical part (doc/C23-SURVEY.md, \"As built: C7's follow-up (CS131, CS132,
  CS133)\"; CS132 (a), restricted to what the C23 corpus's files test): the pedwarns of gcc that
  -pedantic-errors turns into errors and that are about the spelling of tokens, found on the main file's own
  preprocessing tokens (before macro expansion, which the corpus's lines do not need): '0o' constants before
  C2y, `wb` suffixes before C23, adjacent string literals of two different prefixes, `#embed` before C23.
  `notes` gives [[line message] ...]; arbace.repr.c reads them into a read when the file's options ask for
  -pedantic-errors."
  (:require [arbace.repr.c.lex :as lex]
            [arbace.string :as str]))

(set! *warn-on-reflection* true)

(defn- std-year
  "The standard's year as the checker has it (arbace.c.check/std-num)."
  ^long [std]
  (case std (:c89 :c94 :gnu89) 89 (:c99 :gnu99) 99 (:c11 :gnu11) 111 (:c17 :gnu17) 117 (:c2y :gnu2y) 124 123))

(defn- prefix-of
  "A string literal's encoding prefix: \"\" for none, else L, u8, u or U."
  ^String [^String s]
  (cond (.startsWith s "u8") "u8" (.startsWith s "L") "L" (.startsWith s "u") "u" (.startsWith s "U") "U" :else ""))

(defn- ucn-decode
  "An identifier's text with its universal character names and its UTF-8 bytes (read as ISO-8859-1) as characters."
  ^String [^String src]
  (let [u (String. (.getBytes src "ISO-8859-1") "UTF-8")
        m (re-matcher #"\\u([0-9a-fA-F]{4})|\\U([0-9a-fA-F]{8})" u)
        sb (StringBuilder.)]
    (loop [from 0]
      (if (.find m (int from))
        (let [cp (Long/parseLong (or (.group m 1) (.group m 2)) 16)]
          (.append sb (subs u from (.start m)))
          (.append sb (if (<= cp 0x10FFFF) (String. (Character/toChars (int cp))) "?"))
          (recur (.end m)))
        (.append sb (subs u from))))
    (.toString sb)))

(defn- identifier-ascii? [cp] (or (= cp 95) (and (>= cp 48) (<= cp 57)) (and (>= cp 65) (<= cp 90)) (and (>= cp 97) (<= cp 122))))

(defn notes
  "The pedantic notes of the file `name` (bytes `bs`) at the standard `std`: [[line message] ...]."
  [^String name ^bytes bs std no-c2y no-c23]
  (let [yr (std-year std)
        [toks _] (lex/tokens (lex/new-file name bs))
        line-of (fn [t] (second (lex/tok-position t)))
        out (java.util.ArrayList.)]
    (loop [ts (seq toks) bol true def? false]
      (if-let [t (first ts)]
        (let [ch (.-ch ^arbace.repr.c.lex.Tok t)
              src (.-src ^arbace.repr.c.lex.Tok t)
              nl (= ch \newline)
              ]
          (when (and (= ch :PPNUMBER) (< yr 124) (not no-c2y) (re-find #"^0[oO]" src))
            (.add out [(line-of t) "'0o' prefixed constants are a C2Y feature"]))
          ;; review 057's finding 4: gcc's -pedantic: the bf16 suffix is not standard
          (when (and (= ch :PPNUMBER) (re-find #"(?i)^(0x[0-9a-f.']*p[+-]?[0-9']+|[0-9][0-9.']*(e[+-]?[0-9']+)?)bf16$" src))
            (.add out [(line-of t) "non-standard suffix on floating constant"]))
          (when (and (= ch :PPNUMBER) (< yr 123) (not no-c23) (re-find #"(?i)^(0[xb])?[0-9a-f']*[uU]?wb[uU]?$" src))
            (.add out [(line-of t) "ISO C does not support literal 'wb' suffixes before C23"]))
          (when (and bol (= ch \#) (< yr 123))
            (let [n (second ts)]
              (when (and n (= (.-src ^arbace.repr.c.lex.Tok n) "embed"))
                (.add out [(line-of t) "'#embed' before C23 is a GCC extension"]))))
          ;; CS143: C23 (Unicode) rules for the characters of an identifier: XID_Start first, XID_Continue after, no ASCII
          ;; character by a UCN, and normalization form C
          (when (and (= ch :IDENTIFIER) (>= yr 123) (or (re-find #"\\[uU][0-9a-fA-F]" src) (re-find #"[\u0080-\u00ff]" src)))
            (let [txt (ucn-decode src)
                  cps (vec (.toArray (.codePoints ^String txt)))
                  bad (first (keep-indexed (fn [i cp]
                                             (when (or (and (< cp 128) (not (identifier-ascii? cp)))
                                                       (and (>= cp 128) (not (if (zero? i) (Character/isUnicodeIdentifierStart (int cp))
                                                                                 (Character/isUnicodeIdentifierPart (int cp))))))
                                               cp))
                                           cps))]
              (cond
                (some? bad) (.add out [(line-of t) (str "character U+" (format "%04X" bad) " is not valid in an identifier")])
                (not (java.text.Normalizer/isNormalized ^CharSequence txt java.text.Normalizer$Form/NFC))
                (.add out [(line-of t) "universal character names in the identifier are not in NFC"]))))
          ;; CS143: N3353's delimited escape sequences before C2y
          (when (and (contains? #{:CHARCONST :LONGCHARCONST :STRINGLITERAL :LONGSTRINGLITERAL} ch) (< yr 124) (not no-c2y)
                     (re-find #"(?<!\\)(?:\\\\)*\\[uxo]\{" src))
            (.add out [(line-of t) "delimited escape sequences are only valid in C2Y"]))
          ;; CS143: a universal character name beyond the code space in a character constant or string literal
          (when (and (contains? #{:CHARCONST :LONGCHARCONST :STRINGLITERAL :LONGSTRINGLITERAL} ch)
                     (some (fn [m] (let [v (Long/parseLong (second m) 16)] (and (> v 0x10FFFF) (<= v 0x7FFFFFFF)))) (re-seq #"(?<!\\)(?:\\\\)*\\U([0-9a-fA-F]{8})" src)))
            (.add out [(line-of t) "universal character name is outside the UCS codespace"]))
          ;; CS143: __VA_OPT__ in a #define of strict C before C2y
          (when (and def? (= ch :IDENTIFIER) (= src "__VA_OPT__") (contains? #{:c89 :c94 :c99 :c11 :c17} std))
            (.add out [(line-of t) "'__VA_OPT__' is not available until C2Y"]))
          (recur (next ts) (or nl false)
                 (cond nl false
                       (and bol (= ch \#) (second ts) (= (.-src ^arbace.repr.c.lex.Tok (second ts)) "define")) true
                       :else def?)))
        nil))
    ;; string literal runs: adjacent (no new-line between) literals
    (loop [ts (seq toks) run []]
      (let [t (first ts)
            str? (and t (#{:STRINGLITERAL :LONGSTRINGLITERAL} (.-ch ^arbace.repr.c.lex.Tok t)))]
        (cond
          str? (recur (next ts) (conj run t))
          :else
          (do (when (> (count (set (remove #{""} (map #(prefix-of (.-src ^arbace.repr.c.lex.Tok %)) run)))) 1)
                (.add out [(line-of (first run)) "non-standard concatenation of string literals"]))
              (when ts (recur (next ts) []))))))
    (vec out)))

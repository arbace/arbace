;; repr/c's converter: cc's trees (arbace.repr.c.parse's port) into C forms (doc/c/SPEC.md §4-§11).
;; Its rules are cemit's and clisp's (go-whim https://github.com/arbace/go-whim at
;; 80c49bf53cd6340487ac623f3d6d135b77ac1db6, crefactor/cemit and crefactor/clisp: the case for case
;; reading of cc's tree, the declarators read from the name outward, labels as items, the source's
;; parentheses kept, macro invocations recovered from the source's text where a whole node came from
;; one), licensed to Arbace under the EPL-1.0 (doc/C23-SURVEY.md, CS37 (a)); the rest is Arbace's own.

(ns arbace.repr.c.convert
  "C forms from a parse (doc/c/SPEC.md; doc/C23-SURVEY.md, \"As built: C3b\"): `convert` turns a
  translation unit's tree (arbace.repr.c.parse) with its preprocessing layer into the main file's forms
  and its header units (§4.3), the directives of the main file as forms between the items they stand
  between (§9.2), the macro invocations that made a whole node recovered from the source (§9.4), and in
  mode :full each item's text (§10.2). It writes what reading needs, never what checking derives (§11)."
  (:require [arbace.repr.c.lex :as lex]
            [arbace.repr.c.parse :as parse]
            [arbace.repr.c.tree :as tree]
            [arbace.string :as str])
  (:import [arbace.repr.c.lex CFile Tok]
           [arbace.repr.c.tree PTok]
           [java.util ArrayList HashMap HashSet IdentityHashMap TreeMap]))

(set! *warn-on-reflection* true)

;; ---------------------------------------------------------------------------------------------
;; Refusals

(defn refuse
  "A construct the converter does not write: an error of class `cls` (a keyword the round trip's known
  file classes), with the position of `at` when known."
  [cls ^String msg & [at]]
  (throw (ex-info (str "convert: " msg) {:c/refuse cls :at at})))

;; ---------------------------------------------------------------------------------------------
;; The tree

(defn- g [n k] (when (instance? HashMap n) (.get ^HashMap n k)))
(defn- cs [n] (g n :Case))
(defn- nt [n] (g n :node))
(defn- tsrc ^String [t] (when (instance? PTok t) (.-src ^PTok t)))
(defn- tch [t] (when (instance? PTok t) (.-ch ^PTok t)))

(defn- chain
  "The elements of a cc list: `n` and the nodes its field `k` links, in order."
  [n k]
  (loop [n n out (transient [])]
    (if (instance? HashMap n) (recur (g n k) (conj! out n)) (persistent! out))))

;; The conversion's state
(def ^:dynamic *cx* nil)
(defn- cx [k] (get *cx* k))

(def ^:dynamic *soft-errors*
  "c-tails: under a recovering read (parse/*recover*, the dg check's), an ArrayList that takes the converter's errors gcc gives
  and goes on from (a function definition whose declarator is no function's, `auto g { }`: gcc's c_parser_declaration_or_fndef
  reports it and skips the block), the item dropped and the read going on, so that the checker still runs; nil: such an error
  ends the read (the text levels, ci)."
  nil)

(def ^:dynamic *include-inside*
  "Queue 178: when true, a declaration whose other files' tokens all come from headers its own extent includes is the main
  file's (included-inside?), not refused as :split-declaration. ci's libc read binds it (arbace.c.musl/read-one: five of
  musl 1.2.6's sources include a table inside a declaration); the corpora's reads keep the refusal, since such a form
  prints the table inline and the text levels need its #include."
  false)

(defn- main-tok? [t] (and (instance? PTok t) (some? (.-pf ^PTok t)) (identical? (.-pf ^PTok t) (cx :main-file))))

;; Each node's extent: [minSeq maxSeq minMainPo maxMainEnd main? other?] over its tokens (a token from a
;; file other than the main one makes other? true), computed once, bottom up, with an explicit stack (cc's
;; lists nest as deep as they are long).
(def ^:private ^"[J" no-range (long-array [Long/MAX_VALUE Long/MIN_VALUE Long/MAX_VALUE Long/MIN_VALUE 0 0]))

(defn- children [^HashMap n]
  (let [[_ fields] (get tree/types (.get n :node))
        out (ArrayList.)]
    (doseq [f fields]
      (let [v (.get n f)]
        (if (vector? v) (doseq [x v] (.add out x)) (when v (.add out v)))))
    (when-let [ds (.get n :declarationSpecifiers)] (.add out ds))
    out))

(defn- tok-range ^longs [^PTok t]
  (let [s (.-seq t)
        main (and (some? (.-pf t)) (identical? (.-pf t) (cx :main-file)))
        po (.-po t)]
    (let [r (long-array [s s (if main po Long/MAX_VALUE) (if main (inc po) Long/MIN_VALUE)
                         (if main 1 0) (if (or main (nil? (.-pf t))) 0 1)])]
      ;; CS82 (b): a concatenated string literal's extent runs to its last piece's sequence number (the macro groups of its
      ;; pieces are matched against it; its offsets stay its first piece's, where the directives are placed)
      (when-let [ps (.get ^java.util.Map (cx :piece-toks) t)]
        (doseq [^PTok p ps] (aset r 1 (max (aget r 1) (.-seq p)))))
      r)))

(defn- merge-range! ^longs [^longs a ^longs b]
  (aset a 0 (min (aget a 0) (aget b 0))) (aset a 1 (max (aget a 1) (aget b 1)))
  (aset a 2 (min (aget a 2) (aget b 2))) (aset a 3 (max (aget a 3) (aget b 3)))
  (aset a 4 (max (aget a 4) (aget b 4))) (aset a 5 (max (aget a 5) (aget b 5)))
  a)

(defn- compute-ranges!
  "Every node's extent under `root` into the identity map `m`."
  [^IdentityHashMap m root]
  (let [stack (java.util.ArrayDeque.)]
    (.push stack [root false])
    (loop []
      (when-not (.isEmpty stack)
        (let [[n done] (.pop stack)]
          (cond
            (not (instance? HashMap n)) nil
            (.containsKey m n) nil
            done (let [r (aclone no-range)]
                   (doseq [c (children n)]
                     (cond
                       (instance? PTok c) (merge-range! r (tok-range c))
                       (instance? HashMap c) (when-let [cr (.get m c)] (merge-range! r cr))))
                   (.put m n r))
            :else (do (.push stack [n true])
                      (doseq [c (children n)] (when (instance? HashMap c) (.push stack [c false]))))))
        (recur)))))

(defn- rng ^longs [n] (or (.get ^IdentityHashMap (cx :ranges) n) no-range))
(defn- has-main? [n] (pos? (aget (rng n) 4)))
(defn- has-other? [n] (pos? (aget (rng n) 5)))
(defn- min-po ^long [n] (aget (rng n) 2))
(defn- max-end ^long [n] (aget (rng n) 3))

(defn- first-main-tok
  "The first token of `n` in the main file (pre-order), or nil."
  [n]
  (let [stack (java.util.ArrayDeque.)]
    (.push stack n)
    (loop []
      (when-not (.isEmpty stack)
        (let [x (.pop stack)]
          (cond
            (instance? PTok x) (if (main-tok? x) x (recur))
            (instance? HashMap x) (let [cs (children x)
                                        cs (sort-by (fn [c] (if (instance? PTok c) (.-seq ^PTok c) (aget (rng c) 0))) cs)]
                                    (doseq [c (reverse cs)] (.push stack c))
                                    (recur))
            :else (recur)))))))

(defn- line-starts
  "The offsets of the main file's lines (raw lines: a #line does not change the forms' lines, §10.3)."
  ^"[J" [^bytes bs]
  (let [a (java.util.ArrayList.)]
    (.add a (long 0))
    (dotimes [i (alength bs)] (when (= (aget bs i) (byte 10)) (.add a (long (inc i)))))
    (long-array a)))

(defn- line-of ^long [^long po]
  (let [i (java.util.Arrays/binarySearch ^"[J" (cx :line-starts) po)]
    (if (neg? i) (- (- i) 1) (inc i))))

(defn- pos-of [n]
  (when (has-main? n) [(line-of (min-po n)) 0]))

;; ---------------------------------------------------------------------------------------------
;; Forms with metadata; literals (which cannot carry it) give theirs to their parent

(deftype Lit [v m]) ; a literal with the metadata its parent holds for it (:c/macro, :c/paren)

(defn- iobj? [x] (instance? arbace.lang.IObj x))

(defn addm
  "`x` with the metadata `m` merged into its own (a literal wrapped in a Lit)."
  [x m]
  (cond
    (empty? m) x
    (instance? Lit x) (Lit. (.-v ^Lit x) (merge (.-m ^Lit x) m))
    (iobj? x) (vary-meta x merge m)
    :else (Lit. x m)))

(defn- value [x] (if (instance? Lit x) (.-v ^Lit x) x))

(defn- fold
  "The values of `xs` and the parent's metadata for the literals among them: :c/amacro {index text},
  :c/aparen #{index}, :c/aparen-outer #{index}."
  [xs]
  (loop [i 0 xs (seq xs) out (transient []) am {} ap #{} ao #{}]
    (if xs
      (let [x (first xs)]
        (if (instance? Lit x)
          (let [m (.-m ^Lit x)]
            (recur (inc i) (next xs) (conj! out (.-v ^Lit x))
                   (if-let [t (:c/macro m)] (assoc am i t) am)
                   (if (:c/paren m) (conj ap i) ap)
                   (if (:c/paren-outer m) (conj ao i) ao)))
          (recur (inc i) (next xs) (conj! out x) am ap ao)))
      [(persistent! out) (cond-> {} (seq am) (assoc :c/amacro am) (seq ap) (assoc :c/aparen ap) (seq ao) (assoc :c/aparen-outer ao))])))

(defn L
  "A list form of `xs` (literals' metadata on it)."
  [& xs]
  (let [[vs m] (fold xs)] (addm (apply list vs) m)))

(defn- Lv [xs] (apply L xs))

(defn V
  "A vector form of `xs` (literals' metadata on it)."
  [xs]
  (let [[vs m] (fold xs)] (addm vs m)))

(defn- at
  "`form` with the line of `n`'s first main-file token (and in :full its :c/pos)."
  [n form]
  (if (and (iobj? form) (has-main? n))
    (vary-meta form assoc :line (line-of (min-po n)))
    form))

(defn- sym ^arbace.lang.Symbol [^String s] (symbol s))

(defn- utf8-decode
  "A latin1 string (one char a byte) decoded as UTF-8 when it is valid UTF-8, else as it is."
  ^String [^String s]
  (if (every? #(< (int %) 0x80) s)
    s
    (let [bs (.getBytes s "ISO-8859-1")
          u (String. bs "UTF-8")]
      (if (java.util.Arrays/equals bs (.getBytes u "UTF-8")) u s))))

(defn- ucn-decode
  "An identifier's universal character names (\\uXXXX, \\UXXXXXXXX) as the characters they name."
  ^String [^String s]
  (if (neg? (.indexOf s "\\"))
    s
    (str/replace s #"\\u([0-9a-fA-F]{4})|\\U([0-9a-fA-F]{8})"
                 (fn [[_ a b]] (String. (Character/toChars (Integer/parseInt (or a b) 16)))))))

(def ^:private reader-words #{"nil" "true" "false" "_"})

(defn ident
  "A C identifier's form: its symbol, or (c/id \"...\") for one the reader reads otherwise (§4.4)."
  [^String s]
  (let [s (ucn-decode (utf8-decode s))]
    (if (reader-words s) (list 'c/id s) (sym s))))

(defn- ident-tok [t] (ident (tsrc t)))

;; ---------------------------------------------------------------------------------------------
;; Literals (§8)

(defn- digits-clean ^String [^String s] (.replace s "'" ""))

(defn- int-suffix
  "The suffix of an integer constant's text: [digits suffix-lowercased]."
  [^String s]
  (let [s (digits-clean s)
        s (if (re-find #"^0[oO]" s) (str "0" (subs s 2)) s) ; C2y's 0o prefix, read as octal
        hex (or (.startsWith s "0x") (.startsWith s "0X"))
        bin (or (.startsWith s "0b") (.startsWith s "0B"))
        body-start (if (or hex bin) 2 0)
        i (loop [i body-start]
            (if (and (< i (count s))
                     (let [c (.charAt s i)]
                       (if hex (>= (Character/digit c 16) 0) (Character/isDigit c))))
              (recur (inc i)) i))]
    [(subs s 0 i) (str/lower-case (subs s i)) hex bin]))

(def ^:private int-max 2147483647)
(def ^:private uint-max 4294967295)
(def ^:private long-max 9223372036854775807N)
(def ^:private ulong-max 18446744073709551615N)
(def ^:private max-of {'int int-max 'unsigned uint-max 'long long-max 'unsigned-long ulong-max
                       'long-long long-max 'unsigned-long-long ulong-max
                       '__int128 (dec (.shiftLeft (biginteger 1) 127)) 'unsigned-__int128 (dec (.shiftLeft (biginteger 1) 128))})

(defn- c90? [] (#{:c89 :c94 :gnu89} (cx :std)))

(defn- decimal-candidates []
  (if (c90?) '[int long unsigned-long __int128 unsigned-__int128] '[int long __int128 unsigned-__int128]))

(defn- candidates [suffix other-radix]
  (case suffix
    "" (if other-radix '[int unsigned long unsigned-long __int128 unsigned-__int128] (decimal-candidates))
    ("u") '[unsigned unsigned-long unsigned-__int128]
    ("l") (if (or other-radix (c90?)) '[long unsigned-long __int128 unsigned-__int128] '[long __int128 unsigned-__int128])
    ("ul" "lu") '[unsigned-long unsigned-__int128]
    ("ll") (if other-radix '[long-long unsigned-long-long] '[long-long __int128])
    ("ull" "llu") '[unsigned-long-long]
    nil))

(defn- fits [t v] (<= (compare v (max-of t)) 0))

(defn- num-form [v] (let [v (bigint v)] (if (<= (compare v long-max) 0) (long v) v)))

(defn decimal-type
  "The type of an unsuffixed decimal constant of value `v` at the file's standard."
  [v]
  (or (first (filter #(fits % v) (decimal-candidates))) 'unsigned-__int128))

(defn- bits-for ^long [v signed]
  (let [b (.bitLength (biginteger v))] (if signed (inc (max b 1)) (max b 1))))

(def ^:private int-suffixes
  "The integer suffixes cpp_interpret_int_suffix takes (gcc 15.2 libcpp/expr.cc), lower-cased, with GNU's i/j."
  #{"" "u" "l" "ul" "lu" "ll" "ull" "llu" "wb" "uwb" "wbu"})

(defn bad-binary-constant
  "CS291 (a): gcc's diagnostic for a constant spelt with a binary prefix (`0b`, `0B`) that libcpp's cpp_classify_number
  (gcc 15.2 libcpp/expr.cc) rejects, else nil: the radix is 2 only when a binary digit follows the prefix (else the `0` is
  octal and the rest its suffix); a decimal point or an exponent makes it floating (\"invalid prefix \"0b\" for floating
  constant\"); a digit beyond 1, \"invalid digit \"D\" in binary constant\"; then the integer suffix."
  [^String text]
  (when (re-find #"^0[bB]" text)
    (let [n (count text)
          radix2 (and (> n 2) (#{\0 \1} (.charAt text 2)))
          start (if radix2 2 1)
          [i maxd float?] (loop [i start maxd 0 fl false]
                            (if (< i n)
                              (let [c (.charAt text i)]
                                (cond (Character/isDigit c) (recur (inc i) (max maxd (- (int c) (int \0))) fl)
                                      (= c \') (recur (inc i) maxd fl)
                                      (= c \.) (recur (inc i) maxd true)
                                      (and (not radix2) (#{\e \E} c)) [i maxd true]
                                      :else [i maxd fl]))
                              [i maxd fl]))
          suffix (subs text i)]
      (cond
        ;; c-rows: libcpp's cpp_classify_number reports a separator right after the prefix before it reads the rest
        ;; (c23-digit-separators-2's 0b'0, 0B'1)
        (and (not radix2) (> n 2) (= \' (.charAt text 2))) "digit separator after base indicator"
        (and radix2 float?) "invalid prefix \"0b\" for floating constant"
        (and radix2 (>= (long maxd) 2)) (str "invalid digit \"" maxd "\" in binary constant")
        float? nil
        (not (contains? int-suffixes (str/replace (str/lower-case suffix) #"[ij]" ""))) (str "invalid suffix \"" suffix "\" on integer constant")
        :else nil))))

(defn bad-digit-separators
  "gcc's error for a pp-number's digit separators (C23 6.4.4.1, libcpp's cpp_classify_number), or nil: one right after 0x or
  0b (\"digit separator after base indicator\"), two together (\"adjacent digit separators\"), one not between two digits of
  its part, before a suffix, a point or an exponent (\"digit separator outside digit sequence\")."
  [^String text]
  (when (<= 0 (.indexOf text "'"))
    (let [n (count text)
          pre (if (re-find #"^0[xXbB]" text) 2 0)
          hex (and (= pre 2) (#{\x \X} (.charAt text 1)))
          ;; the exponent's start: p for hex, e for decimal (never inside a hex mantissa)
          ex (or (first (keep-indexed (fn [i c] (when (and (>= i pre) (if hex (#{\p \P} c) (and (zero? pre) (#{\e \E} c)))) i)) text)) n)
          digit? (fn [i] (and (< -1 i n)
                              (let [c (.charAt text (int i))]
                                (if (and hex (< i ex)) (or (Character/isDigit c) (<= (int \a) (int (Character/toLowerCase c)) (int \f)))
                                    (Character/isDigit c)))))]
      (cond
        (and (pos? pre) (< pre n) (= \' (.charAt text pre))) "digit separator after base indicator"
        (str/includes? text "''") "adjacent digit separators"
        (some (fn [i] (and (= \' (.charAt text (int i))) (not (and (digit? (dec i)) (digit? (inc i)))))) (range n))
        "digit separator outside digit sequence"
        :else nil))))

(defn- bad-lit
  "CS291 (a): a constant gcc's lexer rejects, as a form: its type, its spelling (printed back as written) and gcc's message,
  which the checker reports at its line (arbace.c.check's c/bad-lit)."
  [t ^String text ^String msg]
  (list 'c/bad-lit t text msg))

(defn int-literal
  "An integer constant's form (§8.1): the value, or (lit T v) when its type is not the decimal default."
  [^String text]
  (if-let [msg (or (bad-binary-constant text) (bad-digit-separators text))] (bad-lit 'int text msg)
  (let [[digits suffix hex bin] (int-suffix text)
        _ (when (and (or hex bin) (<= (count digits) 2)) (refuse :literal (str "invalid suffix on integer constant " text)))
        imag (when (re-find #"[ij]" suffix) true)
        suffix (str/replace suffix #"[ij]" "")
        oct (and (not hex) (not bin) (> (count digits) 1) (.startsWith ^String digits "0"))
        v (cond
            hex (BigInteger. ^String (subs digits 2) 16)
            bin (BigInteger. ^String (subs digits 2) 2)
            oct (BigInteger. ^String (subs digits 1) 8)
            :else (BigInteger. ^String digits))
        form (cond
               (#{"wb" "uwb" "wbu"} suffix)
               (let [u (not= suffix "wb")]
                 (list 'lit (list (if u 'unsigned-bit-int 'bit-int) (bits-for v (not u))) (num-form v)))
               :else
               (let [cands (or (candidates suffix (or hex bin oct)) (refuse :literal (str "integer suffix " suffix)))
                     t (or (first (filter #(fits % v) cands)) (last cands))]
                 (if (= t (decimal-type v)) (num-form v) (list 'lit t (num-form v)))))]
    (if imag (list 'imaginary form) form))))

(defn- shortest-double [^double d] (Double/parseDouble (Double/toString d)))

(defn- exact-decimal
  "The exact value of a floating constant's text (decimal or hexadecimal, no suffix) as a BigDecimal."
  ^java.math.BigDecimal [^String s]
  (if (or (.startsWith s "0x") (.startsWith s "0X"))
    (let [[_ mant exp] (re-matches #"(?i)0x([0-9a-f]*\.?[0-9a-f]*)p([+-]?[0-9]+)" s)
          [ip fp] (let [i (.indexOf ^String mant ".")] (if (neg? i) [mant ""] [(subs mant 0 i) (subs mant (inc i))]))
          m (BigInteger. (let [x (str ip fp)] (if (empty? x) "0" x)) 16)
          e (- (Long/parseLong exp) (* 4 (count fp)))]
      (if (neg? e)
        (.divide (java.math.BigDecimal. m) (java.math.BigDecimal. (.shiftLeft (biginteger 1) (int (- e)))))
        (java.math.BigDecimal. (.shiftLeft m (int e)))))
    (java.math.BigDecimal. s)))

(def ^:private float-types
  {"f" 'float "l" 'long-double "df" '_Decimal32 "dd" '_Decimal64 "dl" '_Decimal128
   ;; C23's (and TS 18661-3's) spellings, gcc 15's libcpp cpp_classify_number: d32, d64, d128, d64x (CS290)
   "d32" '_Decimal32 "d64" '_Decimal64 "d128" '_Decimal128 "d64x" '_Decimal64x
   "f16" '_Float16 "f32" '_Float32 "f64" '_Float64 "f128" '_Float128 "f32x" '_Float32x "f64x" '_Float64x
   "bf16" '__bf16 "q" '__float128 "w" '__float80})

(defn float-literal
  "A floating constant's form (§8.3)."
  [^String text]
  (if-let [msg (bad-binary-constant text)] (bad-lit 'int text msg)
  (if-let [msg (bad-digit-separators text)] (bad-lit 'double text msg)
  ;; an integer imaginary constant (GNU's 2i: _Complex int), which cc's parser takes as a floating one: the integer's form
  (if (re-matches #"(0[xXbB][0-9a-fA-F']+|[0-9']+)[uUlL]*[ijIJ][uUlL]*" text)
    (int-literal text)
  (let [s (digits-clean text)
        hex (or (.startsWith s "0x") (.startsWith s "0X"))
        [_ body suffix] (if hex
                          (re-matches #"(?i)(0x[0-9a-f]*\.?[0-9a-f]*p[+-]?[0-9]+)([a-z0-9]*)" s)
                          (re-matches #"(?i)([0-9]*\.?[0-9]*(?:e[+-]?[0-9]+)?)([a-z0-9]*)" s))
        _ (when-not body (refuse :literal (str "floating constant " text)))
        suffix (str/lower-case suffix)
        imag (re-find #"[ij]" suffix)
        suffix (str/replace suffix #"[ij]" "")
        t (when (seq suffix) (or (float-types suffix) (refuse :literal (str "floating suffix " suffix))))
        exact (exact-decimal body)
        dec? (#{'_Decimal32 '_Decimal64 '_Decimal128 '_Decimal64x} t)
        v (cond
            dec? (java.math.BigDecimal. ^String body)
            (= t 'float) (let [f (Float/parseFloat (if hex (str body "") body))]
                           (if (Float/isInfinite f) exact (Double/parseDouble (Float/toString f))))
            :else (let [d (if hex (.doubleValue exact) (Double/parseDouble body))]
                    (cond
                      (Double/isInfinite d) exact
                      (or (nil? t) ('#{_Float32 _Float64 _Float32x} t)) (shortest-double d)
                      ;; long double and wider: the double when its shortest decimal is the constant's exact value
                      (zero? (.compareTo (java.math.BigDecimal. (Double/toString d)) exact)) (shortest-double d)
                      (and (not hex) (zero? (.compareTo (java.math.BigDecimal. (Double/toString d)) (java.math.BigDecimal. ^String body)))) (shortest-double d)
                      :else exact)))
        form (if t (list 'lit t v) v)]
    (if imag (list 'imaginary form) form))))))

;; Character constants and string literals: their code units

(defn- escape-units
  "The values of the characters and escapes of a literal's body `s` (one char a byte): each source
  character as `char-fn` decodes it, each escape its value. Returns a vector of longs; a UCN as
  [:ucn cp] for the caller to encode."
  [^String s utf8-chars]
  (let [n (count s) out (ArrayList.)]
    (loop [i 0]
      (when (< i n)
        (let [c (.charAt s i)]
          (if (= c \\)
            (let [d (.charAt s (inc i))]
              (case d
                \n (do (.add out 10) (recur (+ i 2)))
                \t (do (.add out 9) (recur (+ i 2)))
                \r (do (.add out 13) (recur (+ i 2)))
                \a (do (.add out 7) (recur (+ i 2)))
                \b (do (.add out 8) (recur (+ i 2)))
                \f (do (.add out 12) (recur (+ i 2)))
                \v (do (.add out 11) (recur (+ i 2)))
                \e (do (.add out 27) (recur (+ i 2)))
                \E (do (.add out 27) (recur (+ i 2)))
                (\' \" \? \\) (do (.add out (long (int d))) (recur (+ i 2)))
                \x (if (and (< (+ i 2) n) (= (.charAt s (+ i 2)) \{)) ; CS143: N3353's \x{...}
                     (let [close (.indexOf s "}" (+ i 3))]
                       (.add out (.longValue (BigInteger. (subs s (+ i 3) close) 16))) (recur (inc close)))
                     (let [j (loop [j (+ i 2)] (if (and (< j n) (>= (Character/digit (.charAt s j) 16) 0)) (recur (inc j)) j))]
                       (.add out (.longValue (BigInteger. (subs s (+ i 2) j) 16))) (recur j)))
                \o (if (and (< (+ i 2) n) (= (.charAt s (+ i 2)) \{)) ; CS143: N3353's \o{...}
                     (let [close (.indexOf s "}" (+ i 3))]
                       (.add out (.longValue (BigInteger. (subs s (+ i 3) close) 8))) (recur (inc close)))
                     (do (.add out (long (int d))) (recur (+ i 2))))
                (\u \U) (if (and (= d \u) (< (+ i 2) n) (= (.charAt s (+ i 2)) \{)) ; CS143: N3353's \u{...}
                          (let [close (.indexOf s "}" (+ i 3))]
                            (.add out [:ucn (.longValue (BigInteger. (subs s (+ i 3) close) 16))]) (recur (inc close)))
                          (let [k (if (= d \u) 4 8)
                                cp (Long/parseLong (subs s (+ i 2) (+ i 2 k)) 16)]
                            (.add out [:ucn cp]) (recur (+ i 2 k))))
                (\{) (recur (+ i 2))
                (if (and (>= (int d) (int \0)) (<= (int d) (int \7)))
                  (let [j (loop [j (inc i)] (if (and (< j n) (< (- j i) 4) (<= (int \0) (int (.charAt s j)) (int \7))) (recur (inc j)) j))]
                    (.add out (Long/parseLong (subs s (inc i) j) 8)) (recur j))
                  (do (.add out (long (int d))) (recur (+ i 2))))))
            (if utf8-chars
              ;; a UTF-8 sequence as one code point
              (let [b (int c)
                    k (cond (< b 0x80) 1 (= (bit-and b 0xE0) 0xC0) 2 (= (bit-and b 0xF0) 0xE0) 3 (= (bit-and b 0xF8) 0xF0) 4 :else 1)
                    k (min k (- n i))
                    cp (if (= k 1)
                         b
                         (let [bs (.getBytes (subs s i (+ i k)) "ISO-8859-1")]
                           (try (.codePointAt (String. bs "UTF-8") 0) (catch Exception _ b))))]
                (.add out [:ucn cp]) (recur (+ i k)))
              (do (.add out (long (int c))) (recur (inc i))))))))
    (vec out)))

(defn- utf8-bytes [^long cp] (vec (map #(bit-and (long %) 0xff) (.getBytes (String. (Character/toChars (int cp))) "UTF-8"))))

(defn- unraw
  "CS325 (a): a raw string literal's quoted part (R\"d(...)d\", the GNU modes' from gnu99) as the ordinary literal of its
  characters (its backslashes escaped); any other text itself."
  [^String q]
  (if (.startsWith q "R\"")
    (let [o (.indexOf q "(")
          dl (- o 2)
          body (subs q (inc o) (- (count q) dl 2))]
      (str "\"" (.replace body "\\" "\\\\") "\""))
    q))

(defn- prefix-of [^String s]
  (let [[p q] (cond (.startsWith s "u8") ["u8" (subs s 2)]
                    (.startsWith s "L") ["L" (subs s 1)]
                    (.startsWith s "u") ["u" (subs s 1)]
                    (.startsWith s "U") ["U" (subs s 1)]
                    :else ["" s])]
    [p (unraw q)]))

(defn- char-form [^long v] (if (and (>= v 0) (< v 0xD800)) (char v) v))

(defn- bad-u8-char
  "CS291 (a): gcc's diagnostic for a u8 character constant (C23 6.4.4.5) that libcpp's lexer and cpp_interpret_charconst
  (gcc 15.2 libcpp/charset.cc) reject, else nil: empty, an escape beyond a byte (hex or octal \"escape sequence out of range\",
  convert_hex, convert_oct), more than one character (\"multi-character literal cannot have an encoding prefix\"), a character
  whose UTF-8 takes more than one code unit (\"character not encodable in a single code unit\"), in that order."
  [^String body us]
  (cond
    (empty? us) "empty character constant"
    (some #(and (not (vector? %)) (> (long %) 0xff)) us) (if (str/includes? body "\\x") "hex escape sequence out of range" "octal escape sequence out of range")
    (> (count us) 1) "multi-character literal cannot have an encoding prefix"
    (and (vector? (first us)) (>= (long (second (first us))) 0x80)) "character not encodable in a single code unit"
    :else nil))

(defn char-literal
  "A character constant's form (§8.2)."
  [^String text]
  (let [[pfx q] (prefix-of text)
        body (subs q 1 (dec (count q)))
        bad (when (= pfx "u8") (bad-u8-char body (escape-units body true)))]
    (if bad (bad-lit 'unsigned-char text bad)
    (case pfx
      ""  (let [us (escape-units body false)
                bytes (mapcat #(if (vector? %) (utf8-bytes (second %)) [(bit-and (long %) 0xff)]) us)
                bytes (vec bytes)]
            (if (= 1 (count bytes))
              (let [b (long (first bytes))] (if (< b 0x80) (char b) (- b 256)))
              (let [v (reduce (fn [acc b] (bit-and (bit-or (bit-shift-left (long acc) 8) (long b)) 0xffffffff)) 0 bytes)]
                (if (>= v 0x80000000) (- v 0x100000000) v))))
      ("L" "u" "U" "u8")
      (let [us (escape-units body true)
            _ (when (empty? us) (refuse :literal "empty character constant"))
            v (let [x (last us)] (if (vector? x) (second x) x))
            v (long v)]
        (case pfx
          "L" (char-form v)
          "u8" (list 'lit 'unsigned-char (if (< v 0x80) (char v) v))
          "u" (list 'lit 'unsigned-short (char-form v))
          "U" (list 'lit 'unsigned (char-form v))))))))

(defn- valid-utf8-runs
  "Bytes as Go forms' byte-string parts: maximal valid UTF-8 runs as strings, other bytes as integers."
  [bytes]
  (let [bs (byte-array (map unchecked-byte bytes))
        n (alength bs)
        out (ArrayList.)
        run (java.io.ByteArrayOutputStream.)
        flush! (fn [] (when (pos? (.size run)) (.add out (String. (.toByteArray run) "UTF-8")) (.reset run)))]
    (loop [i 0]
      (when (< i n)
        (let [b (bit-and (aget bs i) 0xff)
              k (cond (< b 0x80) 1 (= (bit-and b 0xE0) 0xC0) 2 (= (bit-and b 0xF0) 0xE0) 3 (= (bit-and b 0xF8) 0xF0) 4 :else 0)
              ok (and (pos? k) (<= (+ i k) n)
                      (every? #(= (bit-and (aget bs (int %)) 0xC0) 0x80) (range (inc i) (+ i k)))
                      (let [s (String. bs (int i) (int k) "UTF-8")]
                        (and (= 1 (.codePointCount s 0 (.length s)))
                             (not= (.codePointAt s 0) 0xFFFD)
                             (= (count (.getBytes s "UTF-8")) k))))]
          (if ok
            (do (.write run bs (int i) (int k)) (recur (+ i k)))
            (do (flush!) (.add out b) (recur (inc i)))))))
    (flush!)
    (vec out)))

(defn string-literal
  "A string literal's form (§8.4), from the texts of the literals concatenated into it."
  [pieces]
  (let [parsed (map prefix-of pieces)
        pfx (or (first (remove empty? (map first parsed))) "")
        wide (#{"L" "u" "U"} pfx)
        units (vec (mapcat (fn [[_ q]] (escape-units (subs q 1 (dec (count q))) wide)) parsed))]
    (if wide
      (let [cps (map #(if (vector? %) (second %) %) units)
            bad (some #(or (> (long %) 0x10FFFF) (<= 0xD800 (long %) 0xDFFF)) cps)
            s (when-not bad (let [b (StringBuilder.)] (doseq [cp cps] (.appendCodePoint b (int cp))) (str b)))]
        (list 'lit ({"L" 'int "u" 'unsigned-short "U" 'unsigned} pfx)
              (or s (cons 'code-units (vec cps)))))
      (let [bytes (vec (mapcat #(if (vector? %) (utf8-bytes (second %)) [(bit-and (long %) 0xff)]) units))
            parts (valid-utf8-runs bytes)
            v (if (and (= 1 (count parts)) (string? (first parts))) (first parts)
                  (if (empty? parts) "" (cons 'byte-string parts)))]
        (if (and (= pfx "u8") (#{:c23 :gnu23 :c2y :gnu2y} (cx :std))) ; Arbace (CS83 (a)): gnu23 too
          (list 'lit 'unsigned-char v)
          v)))))

;; ---------------------------------------------------------------------------------------------
;; Macro invocations recovered from the source (cemit's recovery; §9.4)

(defn- concatenated? [n]
  (and (= (nt n) "PrimaryExpression") (#{:PrimaryExpressionString :PrimaryExpressionLString} (cs n))
       (some? (.get ^java.util.Map (cx :piece-toks) (g n :Token)))))

(defn- group-match
  "[text starts]: the invocation whose tokens are exactly `n`'s, when one is unclaimed; for a concatenated string literal
  (CS82 (b)) also the invocations whose groups run one after another exactly over its pieces (stringify.c's `STR(a) STR(b)`,
  921227-1.c's `k(#) k(#undef k) k(x)`, shell.c's `BOX_24 BOX_24 ...`), their texts joined by a space; a piece that no
  invocation made (`STR(a) \"b\"`) leaves the literal printed expanded."
  [n]
  (when-let [^HashMap groups (cx :groups)]
    (when (and (instance? HashMap n) (has-main? n) (not (has-other? n)))
      (let [r (rng n)
            hi (aget r 1)
            ^HashSet claimed (cx :claimed)
            gr (.get groups (aget r 0))]
        (when (and gr (not (.contains claimed (aget r 0))))
          (cond
            (= (long (:max gr)) hi) [(:text gr) [(aget r 0)]]
            (and (< (long (:max gr)) hi) (concatenated? n))
            (loop [gr gr texts [(:text gr)] starts [(aget r 0)]]
              (let [nx (:next gr) g2 (when nx (.get groups nx))]
                (when (and g2 (not (.contains claimed nx)) (<= (long (:max g2)) hi))
                  (let [texts (conj texts (:text g2)) starts (conj starts nx)]
                    (if (= (long (:max g2)) hi)
                      [(str/join " " texts) starts]
                      (recur g2 texts starts))))))))))))

(defn- group-at
  "The text of the invocation whose tokens are exactly `n`'s, when one is unclaimed (group-match's)."
  [n]
  (first (group-match n)))

(defn- group-of
  "group-at, the group claimed (by the outermost node of its extent: nodes are claimed pre-order)."
  [n]
  (when-let [[t starts] (group-match n)]
    (doseq [s starts] (.add ^HashSet (cx :claimed) s))
    t))

(defn- macro-table
  "CS82 (b): the main file's executed #define and #undef lines (the layer's), a name -> TreeMap offset -> function-like?
  (an #undef or an object-like #define false)."
  [layer main-name]
  (let [m (HashMap.)]
    (doseq [e layer
            :when (and (= (:file e) main-name) (#{"define" "undef"} (:directive e)) (:off e))
            :let [[_ nm paren] (re-find #"^#\s*(?:define|undef)\s+([A-Za-z_$][A-Za-z0-9_$]*)(\()?" (str (:text e)))]
            :when nm]
      (let [^java.util.TreeMap t (or (.get m nm) (let [t (java.util.TreeMap.)] (.put m nm t) t))]
        (.put t (Long/valueOf (long (:off e))) (boolean (and paren (= "define" (:directive e)))))))
    m))

(defn- fn-macro-at?
  "CS82 (b): `nm` names a function-like macro of the main file defined at offset `po` (its last #define or #undef before)."
  [^String nm ^long po]
  (when-let [^java.util.TreeMap t (some-> ^HashMap (cx :fn-macros) (.get nm))]
    (when-let [e (.lowerEntry t (Long/valueOf po))] (true? (.getValue e)))))

(def ^:private c23-constants {"nullptr" nil "true" true "false" false})

(defn- recovered [n f]
  (let [t (group-of n) form (f)]
    (cond
      (nil? t) form
      ;; cc's Builtin's own macros the printer writes as gcc's builtins (va-arg, offsetof, ...)
      (re-find #"^__builtin_(va_arg|offsetof|types_compatible_p)\b" t) form
      ;; C23's constants, which cc's Builtin defines as macros (§8.5)
      (and (contains? c23-constants t) (#{:c23 :gnu23 :c2y :gnu2y} (cx :std))) (get c23-constants t)
      :else (addm form {:c/macro t}))))

;; ---------------------------------------------------------------------------------------------
;; Attributes (§5.6): a vector of C23 attributes and GNU specifiers (__attribute__ attr...)

(declare expr type-name-form)

(defn- attr-value [av gnu]
  (let [nm (let [p (g av :Prefix) t (g av :Token)]
             (if p (sym (str (tsrc p) "/" (tsrc t))) (sym (tsrc t))))]
    (case (cs av)
      :AttributeValueIdent nm
      :AttributeValueExpr
      (if-let [bts (g av :BalancedTokenSequence)]
        (let [v [nm (utf8-decode (str/join " " (map #(tsrc (g % :Token)) (chain bts :BalancedTokenSequence))))]]
          ;; n-c-last (round 54): an unprefixed or gnu:: attribute's balanced tokens (arguments no expression list reads,
          ;; `[[unknown_attribute(!)]]`) marked :c/tokens, so that the print writes them as tokens, not as a string literal
          (if (or (nil? (namespace nm)) (#{"gnu" "__gnu__"} (namespace nm))) (with-meta v {:c/tokens true}) v))
        (V (into [nm] (map #(expr (g % :AssignmentExpression)) (chain (g av :ArgumentExpressionList) :ArgumentExpressionList))))))))

(defn attrs
  "An AttributeSpecifierList's attributes, or nil."
  [asl]
  (when asl
    (vec (mapcat (fn [l]
                   (let [as (g l :AttributeSpecifier)
                         gnu (= (tch (g as :Token)) :ATTRIBUTE)
                         vals (vec (keep #(when-let [av (g % :AttributeValue)] (attr-value av gnu))
                                         (chain (g as :AttributeValueList) :AttributeValueList)))]
                     (if gnu [(apply list '__attribute__ vals)] vals)))
                 (chain asl :AttributeSpecifierList)))))

(defn- with-attrs [x k asl] (if-let [a (attrs asl)] (addm x {k (into (or (get (meta x) k) []) a)}) x))

;; ---------------------------------------------------------------------------------------------
;; Types (§5): specifiers, declarators read from the name outward

(def ^:private storage-keys
  {:StorageClassSpecifierExtern :extern :StorageClassSpecifierStatic :static :StorageClassSpecifierAuto :auto
   :StorageClassSpecifierRegister :register :StorageClassSpecifierThreadLocal :thread_local
   :StorageClassSpecifierConstexpr :constexpr :StorageClassSpecifierTypedef :typedef})

(def ^:private qual-syms {:CONST 'const :VOLATILE 'volatile :RESTRICT 'restrict :ATOMIC 'atomic :NONNULL '_Nonnull :SEGGS '__seg_gs :SEGFS '__seg_fs})

(defn- wrap-quals [t quals] (reduce (fn [t q] (list q t)) t (reverse quals)))

(declare struct-form enum-form type-of-name defines-type?)

(defn- gnu-typeof?
  "Whether a typeof keyword is GNU's spelling (__typeof__, __typeof, __typeof_unqual__) at C23 or later, where typeof is C's."
  [^String w]
  (and (.startsWith w "__") (#{:c23 :gnu23 :c2y :gnu2y} (cx :std))))

(defn- base-type
  "The base type of a specifier list's type specifiers (N2: their order and words normalized)."
  [specs at]
  (let [k (frequencies (keep #(when (#{:TypeSpecifierVoid :TypeSpecifierChar :TypeSpecifierShort :TypeSpecifierInt
                                        :TypeSpecifierLong :TypeSpecifierFloat :TypeSpecifierDouble :TypeSpecifierSigned
                                        :TypeSpecifierUnsigned :TypeSpecifierBool :TypeSpecifierComplex :TypeSpecifierImaginary
                                        :TypeSpecifierInt128 :TypeSpecifierUint128} (cs %)) (cs %)) specs))
        other (first (remove #(contains? k (cs %)) specs))
        has #(pos? (get k % 0))
        uns (has :TypeSpecifierUnsigned)
        sig (has :TypeSpecifierSigned)
        longs (get k :TypeSpecifierLong 0)
        scalar (cond
                 other
                 (case (cs other)
                   :TypeSpecifierStructOrUnion (struct-form (g other :StructOrUnionSpecifier))
                   :TypeSpecifierEnum (enum-form (g other :EnumSpecifier))
                   :TypeSpecifierTypeName (ident-tok (g other :Token))
                   ;; C23's typeof (6.7.3.6) drops what is not the type (a function's _Noreturn); GNU's __typeof__ keeps it in
                   ;; gcc: at C23 and later a GNU spelling is marked :c/gnu, which the print writes back (c23-typeof-1.c)
                   :TypeSpecifierTypeofExpr (let [w (tsrc (g other :Token))]
                                              (cond-> (L (if (re-find #"unqual" w) 'typeof-unqual 'typeof) (expr (g other :ExpressionList)))
                                                (gnu-typeof? w) (addm {:c/gnu true})))
                   :TypeSpecifierTypeofType (let [w (tsrc (g other :Token))]
                                              (cond-> (list (if (re-find #"unqual" w) 'typeof-unqual-type 'typeof-type) (type-name-form (g other :TypeName)))
                                                (gnu-typeof? w) (addm {:c/gnu true})))
                   :TypeSpecifierAtomic (list 'atomic (type-name-form (g (g other :AtomicTypeSpecifier) :TypeName)))
                   :TypeSpecifierBitInt (L (if uns 'unsigned-bit-int 'bit-int) (expr (g other :ExpressionList)))
                   (sym (tsrc (g other :Token)))) ; _Float16 ... _Decimal128, __bf16
                 (has :TypeSpecifierVoid) 'void
                 (has :TypeSpecifierBool) '_Bool
                 (has :TypeSpecifierImaginary) (refuse :imaginary "_Imaginary")
                 (has :TypeSpecifierChar) (cond uns 'unsigned-char sig 'signed-char :else 'char)
                 (has :TypeSpecifierShort) (if uns 'unsigned-short 'short)
                 (has :TypeSpecifierUint128) 'unsigned-__int128
                 (has :TypeSpecifierInt128) (if uns 'unsigned-__int128 '__int128)
                 (has :TypeSpecifierFloat) 'float
                 (has :TypeSpecifierDouble) (if (pos? longs) 'long-double 'double)
                 (>= longs 2) (if uns 'unsigned-long-long 'long-long)
                 (= longs 1) (if uns 'unsigned-long 'long)
                 uns 'unsigned
                 (or sig (has :TypeSpecifierInt)) 'int
                 (has :TypeSpecifierComplex) nil
                 :else nil)]
    (if (has :TypeSpecifierComplex)
      (list 'complex (or scalar 'double))
      scalar)))

(declare tokens-text node-tokens)

(defn- soft!
  "c-tails: a recovered error at token `t` (*soft-errors*), once."
  [t ^String msg]
  (when-let [^ArrayList se *soft-errors*]
    (let [m (str (if t (tree/pos-string t) "-") ": " msg)]
      (when-not (.contains se m) (.add se m)))))

(defn- scspec-errors!
  "c-tails (*soft-errors*, the dg check's read): gcc's declspecs_add_scspec (c-decl.cc) over a declaration's specifiers in
  order, `els` a sequence of [:sc StorageClassSpecifier-node] and [:type] (a type specifier): its errors for duplicate,
  conflicting and misplaced storage class specifiers (C23's auto that may infer the type, constexpr, thread_local) as
  recovered errors."
  [els]
  (when *soft-errors*
    (loop [els (seq els) sc nil thread? false constexpr? false auto23? false typed? false]
      (when-let [[k n] (first els)]
        (if (= k :type)
          ;; c-decl.cc's declspecs_add_type: a type specifier makes a C23 auto the storage class
          (if auto23?
            (let [t (when n (first (filter #(instance? PTok %) (node-tokens n))))]
              (cond sc (do (soft! t "multiple storage classes in declaration specifiers") (recur (next els) sc thread? constexpr? false true))
                    thread? (do (soft! t "'_Thread_local' used with 'auto'") (recur (next els) sc thread? constexpr? false true))
                    constexpr? (do (soft! t "'auto' used with 'constexpr'") (recur (next els) sc thread? constexpr? false true))
                    :else (recur (next els) :auto thread? constexpr? false true)))
            (recur (next els) sc thread? constexpr? auto23? true))
          (let [t (g n :Token) w (tsrc t) q (str "'" w "'") c (cs n)
                c23 (#{:c23 :gnu23 :c2y :gnu2y} (cx :std))]
            (case c
              :StorageClassSpecifierThreadLocal
              (do (when thread? (soft! t "duplicate '_Thread_local' or '__thread'"))
                  (cond (= sc :auto) (do (soft! t (str q " used with 'auto'")) (recur (next els) sc thread? constexpr? auto23? typed?))
                        (= sc :register) (do (soft! t (str q " used with 'register'")) (recur (next els) sc thread? constexpr? auto23? typed?))
                        (= sc :typedef) (do (soft! t (str q " used with 'typedef'")) (recur (next els) sc thread? constexpr? auto23? typed?))
                        constexpr? (do (soft! t (str q " used with 'constexpr'")) (recur (next els) sc thread? constexpr? auto23? typed?))
                        :else (recur (next els) sc true constexpr? auto23? typed?)))
              :StorageClassSpecifierConstexpr
              (do (when constexpr? (soft! t (str "duplicate " q)))
                  (cond (= sc :extern) (soft! t (str q " used with 'extern'"))
                        (= sc :typedef) (soft! t (str q " used with 'typedef'"))
                        (= sc :auto) (soft! t (str q " used with 'auto'"))
                        thread? (soft! t (str q " used with '_Thread_local'")))
                  (recur (next els) sc thread? (or constexpr? (not (or (#{:extern :typedef :auto} sc) thread?))) auto23? typed?))
              (:StorageClassSpecifierAuto :StorageClassSpecifierExtern :StorageClassSpecifierRegister
               :StorageClassSpecifierStatic :StorageClassSpecifierTypedef)
              (if (and (= c :StorageClassSpecifierAuto) c23 (not typed?) (not= sc :typedef))
                ;; "auto" potentially used for type deduction
                (do (when auto23? (soft! t (str "duplicate " q)))
                    (recur (next els) sc thread? constexpr? true typed?))
                (let [nsc ({:StorageClassSpecifierAuto :auto :StorageClassSpecifierExtern :extern :StorageClassSpecifierRegister :register
                            :StorageClassSpecifierStatic :static :StorageClassSpecifierTypedef :typedef} c)
                      _ (when (and (= nsc :auto) constexpr?) (soft! t (str q " used with 'constexpr'")))
                      auto23? (if (and (= nsc :typedef) auto23?) (do (soft! t "'typedef' used with 'auto'") false) auto23?)
                      _ (when (= nsc sc) (soft! t (str "duplicate " q)))]
                  (cond
                    (and sc (not= nsc sc)) (do (soft! t "multiple storage classes in declaration specifiers")
                                               (recur (next els) sc thread? constexpr? auto23? typed?))
                    :else
                    (let [thread? (if (and thread? (not (#{:extern :static} nsc)))
                                    (do (soft! t (str "'_Thread_local' used with " q)) false)
                                    thread?)
                          constexpr? (if (and constexpr? (not (#{:auto :register :static} nsc)))
                                       (do (soft! t (str "'constexpr' used with " q)) false)
                                       constexpr?)]
                      (recur (next els) nsc thread? constexpr? auto23? typed?)))))
              (recur (next els) sc thread? constexpr? auto23? typed?))))))))

(defn specifiers
  "A declaration's specifiers (DeclarationSpecifiers or SpecifierQualifierList, or a vector of their
  nodes): {:type T :meta {...} :implicit-int bool :typedef bool}."
  [ds]
  (let [els (cond (vector? ds) ds
                  (= (nt ds) "DeclarationSpecifiers") (chain ds :DeclarationSpecifiers)
                  :else (chain ds :SpecifierQualifierList))
        tspecs (ArrayList.) quals (ArrayList.) m (HashMap.) at (ArrayList.) tat (ArrayList.)
        ;; an attribute declaration of empty specifiers, `[[]];` (C23 6.7): its :c/decl-attrs [] (the print's [[]]), which a
        ;; declaration with type specifiers does not keep (an empty [[]] before them is printed as none)
        had-attr (volatile! false)]
    (when *soft-errors*
      (scspec-errors! (keep (fn [e] (case (cs e)
                                      :DeclarationSpecifiersStorage [:sc (g e :StorageClassSpecifier)]
                                      (:DeclarationSpecifiersTypeSpec :SpecifierQualifierListTypeSpec) [:type (g e :TypeSpecifier)]
                                      nil))
                            els)))
    (doseq [e els]
      ;; CS140: an attribute after a type specifier stood after the type (it appertains to it, not to the declaration)
      (let [add-attrs (fn [as] (when as (vreset! had-attr true)) (.addAll at as) (when (pos? (.size tspecs)) (.addAll tat as)))]
      (case (cs e)
        :DeclarationSpecifiersStorage
        (let [sc (g e :StorageClassSpecifier)]
          (if (= (cs sc) :StorageClassSpecifierDeclspec)
            ;; Microsoft's __declspec(...), which cc reads as a storage class: a declaration's attribute (__declspec "TEXT"),
            ;; its balanced tokens as written, printed back where the declaration's attributes stand (gcc takes it on
            ;; Windows targets alone: torture-compile's dll.c, dg-require-dll)
            (add-attrs [(list '__declspec (tokens-text (g sc :Declspecs)))])
            (.put m (storage-keys (cs sc)) true)))
        (:DeclarationSpecifiersTypeSpec :SpecifierQualifierListTypeSpec) (.add tspecs (g e :TypeSpecifier))
        (:DeclarationSpecifiersTypeQual :SpecifierQualifierListTypeQual)
        (let [q (g e :TypeQualifier)]
          (if (= (cs q) :TypeQualifierAttr)
            (add-attrs (attrs (g q :AttributeSpecifierList)))
            (.add quals (qual-syms (tch (g q :Token))))))
        :DeclarationSpecifiersFunc (.put m (if (= (cs (g e :FunctionSpecifier)) :FunctionSpecifierNoreturn) :noreturn :inline) true)
        (:DeclarationSpecifiersAlignSpec :SpecifierQualifierListAlignSpec)
        (let [a (g e :AlignmentSpecifier)]
          (if (= (cs a) :AlignmentSpecifierType)
            (.put m :c/alignas-type (type-name-form (g a :TypeName)))
            (.put m :c/alignas (value (expr (g a :ConstantExpression))))))
        :DeclarationSpecifiersAttr (add-attrs (attrs (g e :AttributeSpecifierList)))
        nil)))
    (let [b (base-type (vec tspecs) ds)
          typedef (.remove m :typedef)
          ;; gcc's "two or more data types in declaration specifiers" (a data type word beside _Bool or _BitInt)
          kinds (frequencies (map cs tspecs))
          has? #(pos? (get kinds % 0))
          _ (when (or (and (has? :TypeSpecifierBool)
                           (some has? [:TypeSpecifierInt :TypeSpecifierChar :TypeSpecifierShort :TypeSpecifierLong :TypeSpecifierFloat
                                       :TypeSpecifierDouble :TypeSpecifierVoid :TypeSpecifierSigned :TypeSpecifierUnsigned]))
                      (and (has? :TypeSpecifierBitInt)
                           (some has? [:TypeSpecifierInt :TypeSpecifierChar :TypeSpecifierShort :TypeSpecifierLong :TypeSpecifierFloat
                                       :TypeSpecifierDouble :TypeSpecifierVoid :TypeSpecifierComplex :TypeSpecifierBool])))
              ;; CS203 (a): the specifier words as written when all are plain words (the print writes them back); else true
              (.put m :c/bad-specs (let [ws (mapv #(some-> (g % :Token) tsrc) tspecs)] (if (every? some? ws) ws true)))
              ;; CS237 (a): a written _Atomic qualifier, which (atomic T) alone cannot tell from the _Atomic(T) specifier
              (when (some #{'atomic} quals) (.put m :c/atomic-qual true)))]
      (when (or (seq at) (and @had-attr (zero? (.size tspecs)) (zero? (.size quals)))) (.put m :c/decl-attrs (vec at)))
      (when (seq tat) (.put m :c/type-attrs (vec tat)))
      {:type (wrap-quals (or b 'int) (vec quals))
       :implicit-int (nil? b)
       :typedef (boolean typedef)
       :meta (into {} m)})))

(defn- type-quals
  "A TypeQualifiers list in written order: [qualifier symbols, attributes]."
  [tq]
  (let [qs (reverse (chain tq :TypeQualifiers))]
    [(vec (keep #(let [q (g % :TypeQualifier)] (when-not (= (cs q) :TypeQualifierAttr) (qual-syms (tch (g q :Token))))) qs))
     (vec (mapcat #(let [q (g % :TypeQualifier)] (when (= (cs q) :TypeQualifierAttr) (attrs (g q :AttributeSpecifierList)))) qs))]))

(defn- pointer-type [t p]
  (loop [t t p p]
    (if (nil? p)
      t
      (do (when (= (cs p) :PointerBlock) (refuse :block-pointer "a block pointer (^)" p))
          (let [[qs as] (type-quals (g p :TypeQualifiers))
                pt (list '* t)
                pt (if (seq as) (addm pt {:c/attrs as}) pt)]
            (recur (wrap-quals pt qs) (g p :Pointer)))))))

(declare params-vector)

(defn- array-type [t dd size-field]
  (let [[qs as] (type-quals (g dd :TypeQualifiers))
        size (when-let [e (g dd size-field)] (expr e))
        st (#{:DirectDeclaratorStaticArr :DirectDeclaratorArrStatic :DirectAbstractDeclaratorStaticArr} (cs dd))
        st (or st (and (= (cs dd) :DirectAbstractDeclaratorArr) (= (tsrc (g dd :Token2)) "static")))
        star (#{:DirectDeclaratorStar :DirectAbstractDeclaratorArrStar} (cs dd))
        a (cond star (list 'array '* t)
                size (L 'array size t)
                :else (list 'array t))]
    (addm a (cond-> {} (seq qs) (assoc :c/quals qs) st (assoc :c/static true)
                    (g dd :AttributeSpecifierList) (assoc :c/attrs (attrs (g dd :AttributeSpecifierList)))))))

(defn- fn-type [params t dd]
  (let [f (list 'fn params t)]
    (if-let [a (g dd :AttributeSpecifierList)] (addm f {:c/attrs (attrs a)}) f)))

(defn- trailing-pos
  "Where attributes after the declarator `d` stood (CS140): after an array or a function declarator, else nil (the name's)."
  [d]
  (when d
    (case (cs (g d :DirectDeclarator))
      (:DirectDeclaratorArr :DirectDeclaratorStaticArr :DirectDeclaratorArrStatic :DirectDeclaratorStar) :array
      (:DirectDeclaratorFuncParam :DirectDeclaratorFuncIdent) :function
      nil)))

(defn declarator
  "A declarator applied to the type `t`: [name-token type kr-names]; the name's attributes in :attrs."
  [t d]
  (loop [t (pointer-type t (g d :Pointer)) dd (g d :DirectDeclarator) out-attrs nil]
    (case (cs dd)
      :DirectDeclaratorIdent [(g dd :Token) t (attrs (g dd :AttributeSpecifierList))]
      :DirectDeclaratorDecl (let [d2 (g dd :Declarator)]
                              (recur (pointer-type t (g d2 :Pointer)) (g d2 :DirectDeclarator) out-attrs))
      (:DirectDeclaratorArr :DirectDeclaratorStaticArr :DirectDeclaratorArrStatic :DirectDeclaratorStar)
      (recur (array-type t dd :AssignmentExpression) (g dd :DirectDeclarator) out-attrs)
      :DirectDeclaratorFuncParam (recur (fn-type (params-vector (g dd :ParameterTypeList)) t dd) (g dd :DirectDeclarator) out-attrs)
      :DirectDeclaratorFuncIdent
      (recur (fn-type (with-meta (mapv #(ident-tok (g % :Token2)) (chain (g dd :IdentifierList) :IdentifierList)) {:c/kr true}) t dd)
             (g dd :DirectDeclarator) out-attrs)
      (refuse :declarator (str "direct declarator " (cs dd)) dd))))

(defn abstract
  "An abstract declarator applied to the type `t`."
  [t ad]
  (if (nil? ad)
    t
    (loop [t (pointer-type t (g ad :Pointer)) dad (g ad :DirectAbstractDeclarator)]
      (if (nil? dad)
        t
        (case (cs dad)
          :DirectAbstractDeclaratorDecl (let [a2 (g dad :AbstractDeclarator)]
                                          (if a2
                                            (recur (pointer-type t (g a2 :Pointer)) (g a2 :DirectAbstractDeclarator))
                                            t))
          (:DirectAbstractDeclaratorArr :DirectAbstractDeclaratorStaticArr :DirectAbstractDeclaratorArrStar)
          (recur (array-type t dad :AssignmentExpression) (g dad :DirectAbstractDeclarator))
          :DirectAbstractDeclaratorFunc (recur (fn-type (params-vector (g dad :ParameterTypeList)) t dad) (g dad :DirectAbstractDeclarator))
          (refuse :declarator (str "direct abstract declarator " (cs dad)) dad))))))

(defn type-name-form
  "A TypeName's type form."
  [tn]
  (let [{type :type sm :meta} (specifiers (g tn :SpecifierQualifierList))
        t (abstract type (g tn :AbstractDeclarator))]
    (if (seq sm) (addm t {:c/spec sm}) t)))

(defn- name-with
  "The declared name's symbol with its type as the tag and `m` merged."
  [name-tok t m]
  (let [s (ident-tok name-tok)]
    (if (seq? s) ; (c/id "...")
      (addm s (assoc m :tag t))
      (with-meta s (assoc m :tag t)))))

(defn params-vector
  "A ParameterTypeList as a parameter vector (§5.3)."
  [ptl]
  (if (nil? ptl)
    []
    (let [ps (mapv (fn [pl]
                     (let [pd (g pl :ParameterDeclaration)
                           {type :type sm :meta implicit-int :implicit-int} (specifiers (g pd :DeclarationSpecifiers))
                           sm (cond-> sm implicit-int (assoc :c/implicit-int true))]
                       (case (cs pd)
                         :ParameterDeclarationDecl
                         (let [[nt t as] (declarator type (g pd :Declarator))
                               m (cond-> sm as (assoc :c/attrs as))
                               x (at (g pd :Declarator) (name-with nt t m))]
                           (cond-> (with-attrs x :c/after-attrs (g pd :AttributeSpecifierList))
                             (and (g pd :AttributeSpecifierList) (trailing-pos (g pd :Declarator))) (addm {:c/after-at (trailing-pos (g pd :Declarator))})))
                         :ParameterDeclarationAbstract
                         (let [t (abstract type (g pd :AbstractDeclarator))]
                           (if (seq sm) (addm t {:c/spec sm}) t)))))
                   (chain (g ptl :ParameterList) :ParameterList))]
      (if (= (cs ptl) :ParameterTypeListVar) (conj ps '&) ps))))

(defn- members [sdl]
  (vec (mapcat
         (fn [l]
           (let [sd (g l :StructDeclaration)]
             (case (cs sd)
               :StructDeclarationAssert [((resolve 'arbace.repr.c.convert/static-assert-form) (g sd :StaticAssertDeclaration))]
               :StructDeclarationDecl
               (let [{type :type sm :meta} (specifiers (g sd :SpecifierQualifierList))
                     decls (chain (g sd :StructDeclaratorList) :StructDeclaratorList)
                     after (attrs (g sd :AttributeSpecifierList))
                     group (and (> (count decls) 1) (defines-type? type))
                     base (if group 'c/base type)
                     forms (mapv (fn [sdl]
                                   (let [sdr (g sdl :StructDeclarator)
                                         bits (when (= (cs sdr) :StructDeclaratorBitField) (expr (g sdr :ConstantExpression)))]
                                     (if-let [d (g sdr :Declarator)]
                                       (let [[nt t as] (declarator base d)
                                             m (cond-> sm as (assoc :c/attrs as))
                                             nm (at d (name-with nt t m))]
                                         (if (some? bits)
                                           (if (instance? Lit bits)
                                             (addm nm {:c/bits (value bits) :c/bits-meta (.-m ^Lit bits)})
                                             (addm nm {:c/bits bits}))
                                           nm))
                                       (at sdr (L 'c/bits base bits)))))
                                 decls)
                     forms (if (and (seq after) (seq forms))
                             (conj (pop forms) (addm (peek forms)
                                                     (cond-> {:c/after-attrs after}
                                                       (trailing-pos (g (g (last decls) :StructDeclarator) :Declarator))
                                                       (assoc :c/after-at (trailing-pos (g (g (last decls) :StructDeclarator) :Declarator))))))
                             forms)]
                 (cond
                   (empty? decls) [(addm type (cond-> {} (seq sm) (assoc :c/spec sm) (seq after) (assoc :c/after-attrs after)))]
                   group [(apply list 'c/group type forms)]
                   :else forms)))))
         (chain sdl :StructDeclarationList))))

(defn struct-form
  "A StructOrUnionSpecifier's type form (§5.4)."
  [s]
  (let [kw (if (= (cs (g s :StructOrUnion)) :StructOrUnionUnion) 'union 'struct)
        tag (when-let [t (g s :Token)] (ident-tok t))
        f (if (= (cs s) :StructOrUnionSpecifierDef)
            (Lv (concat [kw] (when tag [tag]) [(members (g s :StructDeclarationList))]))
            (list kw tag))]
    (-> f (with-attrs :c/attrs (g s :AttributeSpecifierList)) (with-attrs :c/end-attrs (g s :AttributeSpecifierList2)))))

(declare list-with-dirs)

(defn enum-form
  "An EnumSpecifier's type form (§5.5)."
  [e]
  (let [tag (when-let [t (g e :Token2)] (ident-tok t))
        us (when-let [ets (g e :EnumTypeSpecifier)] (specifiers (g ets :SpecifierQualifierList)))
        under (:type us)
        f (if (= (cs e) :EnumSpecifierDef)
            (Lv (concat ['enum] (when tag [tag])
                        [(list-with-dirs (g e :EnumeratorList) (chain (g e :EnumeratorList) :EnumeratorList) :EnumeratorList (g e :Token4)
                                         (fn [l]
                                           (let [en (g l :Enumerator)
                                                 nm (ident-tok (g en :Token))
                                                 x (if (= (cs en) :EnumeratorExpr) (V [nm (expr (g en :ConstantExpression))]) nm)]
                                             [(at en (with-attrs x :c/attrs (g en :AttributeSpecifierList)))])))]))
            (list 'enum tag))
        f (if under (addm f {:c/underlying under}) f)
        ;; `enum e : const;`: no type specifier in the underlying type (gcc's error, the checker's)
        f (if (:implicit-int us) (addm f {:c/underlying-implicit true}) f)]
    (with-attrs f :c/attrs (g e :AttributeSpecifierList))))

(defn- defines-type?
  "Whether a type form defines a struct, union or enum (its member list given)."
  [t]
  (let [t (loop [t t] (if (and (seq? t) ('#{const volatile restrict atomic _Nonnull __seg_gs __seg_fs} (first t))) (recur (second t)) t))]
    (and (seq? t) ('#{struct union enum} (first t)) (vector? (last t)))))

;; ---------------------------------------------------------------------------------------------
;; Expressions (§7.4-§7.9)

(def ^:private binary-fields
  {"MultiplicativeExpression" [:MultiplicativeExpression :CastExpression]
   "AdditiveExpression" [:AdditiveExpression :MultiplicativeExpression]
   "ShiftExpression" [:ShiftExpression :AdditiveExpression]
   "RelationalExpression" [:RelationalExpression :ShiftExpression]
   "EqualityExpression" [:EqualityExpression :RelationalExpression]
   "AndExpression" [:AndExpression :EqualityExpression]
   "ExclusiveOrExpression" [:ExclusiveOrExpression :AndExpression]
   "InclusiveOrExpression" [:InclusiveOrExpression :ExclusiveOrExpression]
   "LogicalAndExpression" [:LogicalAndExpression :InclusiveOrExpression]
   "LogicalOrExpression" [:LogicalOrExpression :LogicalAndExpression]})

(def ^:private op-syms
  {"*" '* "/" '/ "%" '% "+" '+ "-" '- "<<" '<< ">>" '>> "<" '< ">" '> "<=" '<= ">=" '>= "==" '== "!=" '!=
   "&" 'bit-and "^" 'bit-xor "|" 'bit-or "&&" 'and "||" 'or})

(def ^:private nary '#{+ - * / bit-and bit-or bit-xor and or comma})

(defn- plain-list? [x head]
  (and (seq? x) (= (first x) head) (> (count x) 2)
       (empty? (dissoc (meta x) :line))))

(defn- chain-op [op l r]
  (if (and (nary op) (plain-list? (value l) op) (not (instance? Lit l)))
    (Lv (concat (seq l) [r]))
    (L op l r)))

(def reserved-heads
  "Heads of C context a callee named so would be read as (§15.4): its call is (c/call f args)."
  '#{let do when if cond switch case default while do-while for label goto goto* break continue return
     + - * / % << >> == != < <= > >= and or not bit-and bit-or bit-xor bit-not addr set! inc! dec! pre-inc!
     pre-dec! aget aset -> conv sizeof sizeof-type alignof alignof-type generic ? comma compound-lit init at
     stmt-expr label-addr real imag va-arg offsetof types-compatible? classify-type has-attribute?
     convertvector bit-cast deref lit byte-string code-units imaginary quote var fn fn* def loop recur throw
     try catch finally new monitor-enter monitor-exit letfn case* reify* deftype* import* . & _})

(declare init-form compound-items)

(defn- num-lit? [x] (or (instance? Long x) (instance? arbace.lang.BigInt x) (instance? Double x) (instance? java.math.BigDecimal x)
                        (instance? BigInteger x) (char? x)))

(defn- negate [x]
  (cond
    (char? x) (- (long (int x)))
    (instance? Double x) (- (double x))
    (instance? java.math.BigDecimal x) (.negate ^java.math.BigDecimal x)
    :else (num-form (- (bigint x)))))

(defn- id-name [x] (when (symbol? x) (name x)))

(defn- va-arg-pattern
  "cc's Builtin's __builtin_va_arg(va, type), (*(type*)__builtin_va_arg_impl(va)): (va-arg va T)."
  [inner]
  (when (and (= (cs inner) :UnaryExpressionDeref) (= (cs (g inner :CastExpression)) :CastExpressionCast))
    (let [c (g inner :CastExpression)
          call (g c :CastExpression)]
      (when (and (= (cs call) :PostfixExpressionCall)
                 (= "__builtin_va_arg_impl" (tsrc (g (g call :PostfixExpression) :Token))))
        (let [t (type-name-form (g c :TypeName))]
          (when (and (seq? t) (= (first t) '*))
            (L 'va-arg (expr (g (g call :ArgumentExpressionList) :AssignmentExpression)) (second t))))))))

(defn- offsetof-pattern
  "cc's Builtin's __builtin_offsetof(type, member), ((__SIZE_TYPE__)&(((type*)0)->member)): (offsetof T path...)."
  [inner]
  (when (and (= (cs inner) :CastExpressionCast) (= (cs (g inner :CastExpression)) :UnaryExpressionAddrof))
    (let [p0 (g (g inner :CastExpression) :CastExpression)
          p (when (= (cs p0) :PrimaryExpressionExpr) (g p0 :ExpressionList))]
      (loop [x p path ()]
        (case (cs x)
          :PostfixExpressionSelect (recur (g x :PostfixExpression) (conj path (keyword (tsrc (g x :Token2)))))
          :PostfixExpressionIndex (recur (g x :PostfixExpression) (conj path (expr (g x :ExpressionList))))
          :PostfixExpressionPSelect
          (let [root (g x :PostfixExpression)
                cast (when (= (cs root) :PrimaryExpressionExpr) (g root :ExpressionList))]
            (when (and (= (cs cast) :CastExpressionCast) (= "0" (tsrc (g (g cast :CastExpression) :Token))))
              (let [t (type-name-form (g cast :TypeName))]
                (when (and (seq? t) (= (first t) '*))
                  (Lv (concat ['offsetof (second t) (keyword (tsrc (g x :Token2)))] path))))))
          nil)))))

(defn- types-compatible-pattern [callee args]
  (when (and (= "__ccgo__types_compatible_p" (tsrc (g callee :Token))) (= 2 (count args))
             (every? #(and (= (cs %) :PostfixExpressionComplit) (nil? (g % :InitializerList))) args))
    (L 'types-compatible? (type-name-form (g (first args) :TypeName)) (type-name-form (g (second args) :TypeName)))))

(defn expr
  "An expression node's form."
  [n]
  (if (or (nil? n) (= n :tnil))
    nil
    (recovered n
      (fn []
        (at n
          (let [ty (nt n) c (cs n)]
            (if-let [[lf rf] (binary-fields ty)]
              (if (#{:MultiplicativeExpressionCast :AdditiveExpressionMul :ShiftExpressionAdd :RelationalExpressionShift
                     :EqualityExpressionRel :AndExpressionEq :ExclusiveOrExpressionAnd :InclusiveOrExpressionXor
                     :LogicalAndExpressionOr :LogicalOrExpressionLAnd} c)
                (expr (g n rf))
                (let [op (op-syms (tsrc (g n :Token)))
                      l (expr (g n lf)) r (expr (g n rf))]
                  (chain-op op l r)))
              (case ty
                "ExpressionList" (let [es (chain n :ExpressionList)]
                                   (if (= 1 (count es)) (expr (g n :AssignmentExpression))
                                       (Lv (cons 'comma (map #(expr (g % :AssignmentExpression)) es)))))
                "ConstantExpression" (expr (g n :ConditionalExpression))
                "AssignmentExpression"
                (if (= c :AssignmentExpressionCond)
                  (expr (g n :ConditionalExpression))
                  (let [op (tsrc (g n :Token)) l (expr (g n :UnaryExpression)) r (expr (g n :AssignmentExpression))]
                    (if (= op "=") (L 'set! l r) (L 'set! l (op-syms (subs op 0 (dec (count op)))) r))))
                "ConditionalExpression"
                (if (= c :ConditionalExpressionLOr)
                  (expr (g n :LogicalOrExpression))
                  (if-let [m (g n :ExpressionList)]
                    (L '? (expr (g n :LogicalOrExpression)) (expr m) (expr (g n :ConditionalExpression)))
                    (L '? (expr (g n :LogicalOrExpression)) (expr (g n :ConditionalExpression)))))
                "CastExpression"
                (if (= c :CastExpressionUnary)
                  (expr (g n :UnaryExpression))
                  (L 'conv (type-name-form (g n :TypeName)) (expr (g n :CastExpression))))
                "UnaryExpression"
                (case c
                  :UnaryExpressionPostfix (expr (g n :PostfixExpression))
                  :UnaryExpressionInc (L 'pre-inc! (expr (g n :UnaryExpression)))
                  :UnaryExpressionDec (L 'pre-dec! (expr (g n :UnaryExpression)))
                  :UnaryExpressionAddrof (L 'addr (expr (g n :CastExpression)))
                  :UnaryExpressionDeref (L 'arbace.core/deref (expr (g n :CastExpression)))
                  :UnaryExpressionPlus (L '+ (expr (g n :CastExpression)))
                  :UnaryExpressionMinus (let [x (expr (g n :CastExpression))]
                                          (if (num-lit? x) (negate x) (L '- x)))
                  :UnaryExpressionCpl (L 'bit-not (expr (g n :CastExpression)))
                  :UnaryExpressionNot (L 'not (expr (g n :CastExpression)))
                  :UnaryExpressionSizeofExpr (L 'sizeof (expr (g n :UnaryExpression)))
                  :UnaryExpressionSizeofType (L 'sizeof-type (type-name-form (g n :TypeName)))
                  :UnaryExpressionAlignofExpr (L 'alignof (expr (g n :UnaryExpression)))
                  :UnaryExpressionAlignofType (L 'alignof-type (type-name-form (g n :TypeName)))
                  :UnaryExpressionLabelAddr (list 'label-addr (keyword (tsrc (g n :Token2))))
                  :UnaryExpressionReal (L 'real (expr (g n :UnaryExpression)))
                  :UnaryExpressionImag (L 'imag (expr (g n :UnaryExpression)))
                  (refuse :expression (str "unary " c) n))
                "PostfixExpression"
                (case c
                  :PostfixExpressionPrimary (expr (g n :PrimaryExpression))
                  :PostfixExpressionIndex (L 'aget (expr (g n :PostfixExpression)) (expr (g n :ExpressionList)))
                  :PostfixExpressionCall
                  (let [callee (g n :PostfixExpression)
                        args (mapv #(g % :AssignmentExpression) (chain (g n :ArgumentExpressionList) :ArgumentExpressionList))
                        ;; c-rows: C23's va_start (ap, last) read as cc's two arguments (arbace.repr.c.parse's c23-va-start-args):
                        ;; the forms keep the va_list alone, as for the skipped extra tokens (7.16.1.4: never evaluated)
                        args (if (and (= (cs callee) :PrimaryExpressionIdent) (= "__builtin_c23_va_start" (tsrc (g callee :Token))))
                               (vec (take 1 args))
                               args)]
                    (or (types-compatible-pattern callee args)
                        (let [f (expr callee) as (map expr args)
                              ;; CS82 (b): a callee named as a function-like macro defined where it stands came from an expansion
                              ;; that hid it from the macro (macro-skip-expand.c's `square(square)(2)`, the name painted): printed
                              ;; parenthesized, `(square)(2)`, which no macro takes, the reread's (:c/paren) the same
                              f (if (and (symbol? f) (not (:c/macro (meta f))) (not (:c/paren (meta f))) (has-main? callee)
                                         (fn-macro-at? (name f) (min-po callee)))
                                  (addm f {:c/paren true})
                                  f)]
                          (if (and (symbol? (value f)) (reserved-heads (value f)) (not (instance? Lit f)))
                            (Lv (list* 'c/call f as))
                            (Lv (cons f as))))))
                  :PostfixExpressionSelect (L (sym (str ".-" (tsrc (g n :Token2)))) (expr (g n :PostfixExpression)))
                  :PostfixExpressionPSelect
                  (let [inner (expr (g n :PostfixExpression))
                        m (sym (tsrc (g n :Token2)))]
                    (if (and (seq? inner) (= (first inner) '->) (empty? (dissoc (meta inner) :line)))
                      (Lv (concat inner [m]))
                      (L '-> inner m)))
                  :PostfixExpressionInc (L 'inc! (expr (g n :PostfixExpression)))
                  :PostfixExpressionDec (L 'dec! (expr (g n :PostfixExpression)))
                  :PostfixExpressionComplit
                  (let [f (Lv (list* 'compound-lit (type-name-form (g n :TypeName)) (init-form (g n :InitializerList) (g n :Token4))))
                        _ (scspec-errors! (map (fn [sc] [:sc sc]) (g n :StorageClassSpecifiers)))
                        scs (keep #(storage-keys (cs %)) (g n :StorageClassSpecifiers))]
                    (if (seq scs) (addm f (zipmap scs (repeat true))) f))
                  (refuse :expression (str "postfix " c) n))
                "PrimaryExpression"
                (case c
                  :PrimaryExpressionIdent (ident-tok (g n :Token))
                  :PrimaryExpressionInt (int-literal (tsrc (g n :Token)))
                  :PrimaryExpressionFloat (float-literal (tsrc (g n :Token)))
                  (:PrimaryExpressionChar :PrimaryExpressionLChar) (char-literal (tsrc (g n :Token)))
                  (:PrimaryExpressionString :PrimaryExpressionLString)
                  (let [t (g n :Token)] (string-literal (or (.get ^java.util.Map (cx :pieces) t) [(tsrc t)])))
                  :PrimaryExpressionExpr
                  (let [inner (g n :ExpressionList)]
                    (or (va-arg-pattern inner)
                        (offsetof-pattern inner)
                        (let [x (expr inner)
                              m (if (instance? Lit x) (.-m ^Lit x) (meta x))]
                          (if (:c/macro m) (addm x {:c/paren-outer true}) (addm x {:c/paren true})))))
                  :PrimaryExpressionStmt (Lv (cons 'stmt-expr (compound-items (g n :CompoundStatement))))
                  :PrimaryExpressionGeneric
                  (let [gs (g n :GenericSelection) tn (g gs :TypeName)]
                    (addm (Lv (list* 'generic (if tn (type-name-form tn) (expr (g gs :AssignmentExpression)))
                               (map (fn [l]
                                      (let [a (g l :GenericAssociation)]
                                        (if (= (cs a) :GenericAssociationDefault)
                                          (V [:default (expr (g a :AssignmentExpression))])
                                          (V [(type-name-form (g a :TypeName)) (expr (g a :AssignmentExpression))]))))
                                    (chain (g gs :GenericAssociationList) :GenericAssociationList))))
                          (if tn {:c/type true} {})))
                  (refuse :expression (str "primary " c) n))
                (refuse :expression (str "node " ty) n)))))))))

;; ---------------------------------------------------------------------------------------------
;; Initializers (§6.9)

(defn- designators [dl]
  (mapv (fn [l]
          (let [d (g l :Designator)]
            (case (cs d)
              :DesignatorIndex (expr (g d :ConstantExpression))
              :DesignatorIndex2 (V [(expr (g d :ConstantExpression)) (expr (g d :ConstantExpression2))])
              :DesignatorField (keyword (tsrc (g d :Token2)))
              :DesignatorField2 (keyword (tsrc (g d :Token))))))
        (chain dl :DesignatorList)))

(declare initializer placed-at directive-lines straddles?)

;; CS329 (a): the directives inside an initializer list or an enumerator list (quickjs's `#define DEF(id, size) { #id, size },`
;; `#include "libregexp-opcode.h"` `#undef DEF` inside a table), elements of the list's forms (SPEC §9.2)

(defn elem-node
  "CS329 (a): a list element's node, a link `l` of an InitializerList or an EnumeratorList without its link to the next
  (`next-key`) and its preceding comma, its extent registered (one node a link, cached): the item place-directives! places a
  directive before, whose extent the converter tests (a link's own extent runs to the list's end, the comma's offset begins it)."
  [^HashMap l next-key]
  (let [^IdentityHashMap em (cx :elems)]
    (or (.get em l)
        (let [w (doto (HashMap. l) (.remove next-key) (.remove :Token) (.put :c/elem true))
              r (aclone no-range)]
          (doseq [c (children w)]
            (cond (instance? PTok c) (merge-range! r (tok-range c))
                  (instance? HashMap c) (merge-range! r (rng c))))
          (.put ^IdentityHashMap (cx :ranges) w r)
          (.put em l w)
          w))))

(defn- list-with-dirs
  "CS329 (a): the element forms of a list (the links `ls` of `owner`, an InitializerList's or an EnumeratorList's head; `fs-of`
  a link's forms, a vector), the directives place-directives! placed before an element (or after the last) among them. An
  element whose tokens all come from a file an #include of the list brought in is the directive's (the print writes the
  #include, as a body's, CS275 (a)); ci's read (*include-inside*) places none and keeps them. A directive form records the
  main file's commas around it, which the print writes (a header's elements may bring their own): :c/comma-before, a comma
  between the element before it and it; :c/comma-after, a comma between it and what follows (an element, another directive,
  the list's end). `trail` is the list's trailing comma token, when written."
  [owner ls next-key trail fs-of]
  (let [^HashMap m (when-let [^IdentityHashMap pl (cx :placed)] (when owner (.get pl owner)))]
    (if (empty? m)
      (vec (mapcat fs-of ls))
      (let [;; the commas the main file's text holds: an #embed's (its elements' separators, its prefix's and suffix's, made
            ;; on the directive's line) are its elements', printed with them
            ^java.util.TreeMap dl (or @(cx :dir-lines)
                                      (reset! (cx :dir-lines)
                                              (let [m (java.util.TreeMap.)]
                                                (doseq [d (directive-lines)] (.put m (Long/valueOf (long (:off d))) (Long/valueOf (long (or (:end d) Long/MAX_VALUE)))))
                                                m)))
            on-dir? (fn [^long po] (when-let [e (.floorEntry dl (Long/valueOf po))] (< po (long (.getValue e)))))
            commas (vec (sort (keep (fn [t] (when (main-tok? t) (let [po (.-po ^PTok t)] (when-not (on-dir? po) po))))
                                    (concat (map #(g % :Token) ls) [trail]))))
            comma-in? (fn [^long lo ^long hi] (boolean (some #(and (<= lo (long %)) (< (long %) hi)) commas)))
            out (ArrayList.)
            n (count ls)]
        (loop [i 0 prev nil prev-end -1 last-dir -1]
          (let [ds (placed-at owner i)
                [prev prev-end last-dir]
                (reduce (fn [[prev prev-end last-dir] [off df]]
                          (let [off (long off)]
                            (when (>= (long last-dir) 0)
                              (when (comma-in? prev-end off) (.set out (int last-dir) (vary-meta (.get out (int last-dir)) assoc :c/comma-after true))))
                            (.add out (if (and (= prev :el) (comma-in? prev-end off)) (vary-meta df assoc :c/comma-before true) df))
                            [:dir off (dec (.size out))]))
                        [prev prev-end last-dir] ds)]
            (if (< i n)
              (let [l (nth ls i) w (elem-node l next-key)]
                (if (and (not *include-inside*) (has-other? w) (not (has-main? w)))
                  (recur (inc i) prev prev-end last-dir)
                  (do (when (straddles? w)
                        (refuse :split-declaration "a declaration that begins in one file and ends in another" w))
                      (when (and (>= (long last-dir) 0) (comma-in? prev-end (min-po w)))
                        (.set out (int last-dir) (vary-meta (.get out (int last-dir)) assoc :c/comma-after true)))
                      (.addAll out ^java.util.Collection (fs-of l))
                      (recur (inc i) :el (max-end w) -1))))
              (do (when (and (>= (long last-dir) 0) (comma-in? prev-end Long/MAX_VALUE))
                    (.set out (int last-dir) (vary-meta (.get out (int last-dir)) assoc :c/comma-after true)))
                  (vec out)))))))))

(defn init-form
  "An InitializerList's elements (designations before their values), the directives placed among them (CS329 (a)); `trail`
  the list's trailing comma token."
  [il trail]
  (list-with-dirs il (chain il :InitializerList) :InitializerList trail
                  (fn [l]
                    (let [v (initializer (g l :Initializer))]
                      (if-let [dn (g l :Designation)]
                        (let [ds (designators (g dn :DesignatorList))]
                          (if (and (= 1 (count ds)) (keyword? (first ds)))
                            [(first ds) v]
                            [(Lv (cons 'at ds)) v]))
                        [v])))))

(defn initializer [n]
  (recovered n
    (fn []
      (case (cs n)
        :InitializerExpr (expr (g n :AssignmentExpression))
        :InitializerInitList (at n (Lv (cons 'init (init-form (g n :InitializerList) (g n :Token2)))))))))

;; ---------------------------------------------------------------------------------------------
;; Declarations (§6)

(defn static-assert-form [sa]
  (let [e (expr (g sa :ConstantExpression))]
    (if-let [m (g sa :Token4)]
      (L 'c/static-assert e (string-literal (or (.get ^java.util.Map (cx :pieces) m) [(tsrc m)])))
      (L 'c/static-assert e))))

(defn- fn-type? [t] (and (seq? t) (= (first t) 'fn)))

(defn- typedef-fn? [t] (and (symbol? t) (fn-type? (get @(cx :typedefs) t))))

(defn- decl-form
  "One declarator's form: c/typedef, c/declare, c/var."
  [spec nt t m init asm]
  (let [{:keys [typedef]} spec
        nm (ident-tok nt)]
    (cond
      typedef (do (when (symbol? nm) (swap! (cx :typedefs) assoc nm t))
                  (addm (L 'c/typedef (addm nm (dissoc m :tag)) t) {}))
      ;; a function's asm label (GNU's `void *memcpy (...) __asm ("my_memcpy")`, the name its calls link to) as a variable's:
      ;; :c/asm-label on the declared name, printed after the declarator (decl-tail); it was dropped (torture-execute's
      ;; builtins/memops-asm.c and strstr-asm.c: the print's object called memcpy, the class :objects)
      (fn-type? t)
      (let [[_ ps r] t
            m (if asm (assoc m :c/asm-label asm) m)]
        (L 'c/declare (if (seq? nm) (addm nm m) (with-meta nm m)) (addm ps {:tag r})))
      (typedef-fn? t)
      (L 'c/declare (let [x (name-with nt t m)] (if asm (addm x {:c/asm-label asm}) x)))
      :else
      (let [x (name-with nt t m)
            x (if asm (addm x {:c/asm-label asm}) x)]
        (if (= init ::none) (L 'c/var x) (L 'c/var x init))))))

(defn- asm-text [n] (when n (str/join " " (map tsrc (filter #(instance? PTok %) (tree-seq #(instance? HashMap %) children n))))))

(defn- node-tokens
  "The tokens of `n` in order."
  [n]
  (let [out (ArrayList.) stack (java.util.ArrayDeque.)]
    (.push stack n)
    (loop []
      (when-not (.isEmpty stack)
        (let [x (.pop stack)]
          (cond
            (instance? PTok x) (.add out x)
            (instance? HashMap x) (doseq [c (children x)] (.push stack c))))
        (recur)))
    (vec (sort-by #(.-seq ^PTok %) out))))

(defn- tokens-text ^String [ts]
  (let [b (StringBuilder.)]
    (doseq [[i ^PTok t] (map-indexed vector ts)]
      (when (and (pos? i) (pos? (.length ^String (.-sep t)))) (.append b " "))
      (.append b (.-src t)))
    (utf8-decode (str b))))

(defn- asm-recovered
  "CS82 (b): an asm statement's text as tokens-text gives it from `ts`, with each macro invocation that made a run of its
  tokens after the first written as the invocation (pr27528.c's `\"i\" (__FUNCTION__)`, whose expansion `__func__` names
  another object), or nil when none did. The forms keep the expanded text (ci parses the operands from it); the :lines
  print writes this one (:c/asm-text)."
  [ts]
  (when-let [^HashMap groups (cx :groups)]
    (let [v (vec ts) n (count v) b (StringBuilder.) ^HashSet claimed (cx :claimed)]
      (loop [i 0 any false]
        (if (>= i n)
          (when any (str b))
          (let [^PTok t (v i)
                gr (when (pos? i) (.get groups (.-seq t)))
                j (when (and gr (not (.contains claimed (.-seq t))))
                    (loop [j i] (cond (>= j n) nil
                                      (= (.-seq ^PTok (v j)) (long (:max gr))) j
                                      (< (.-seq ^PTok (v j)) (long (:max gr))) (recur (inc j))
                                      :else nil)))]
            (when (and (pos? i) (pos? (.length ^String (.-sep t)))) (.append b " "))
            (if j
              (do (.append b ^String (:text gr)) (recur (inc (long j)) true))
              (do (.append b (utf8-decode (.-src t))) (recur (inc i) any)))))))))

(defn- asm-form
  "(c/asm TEXT) of an Asm node, its print's text (asm-recovered) as :c/asm-text when an invocation made a part of it."
  [n]
  (let [ts (node-tokens n) f (list 'c/asm (tokens-text ts)) r (asm-recovered ts)]
    (if (and r (not= r (second f))) (with-meta f {:c/asm-text r}) f)))

(defn- underspec-idls
  "c-tails (*soft-errors*, the dg check's read): the init declarators of the declaration `d` (specifiers' meta `sm`) that gcc keeps
  when the declaration is underspecified (C23's auto with no type specifier, inferring the type; constexpr), its errors recovered
  (c-parser.cc's c_parser_declaration_or_fndef): an empty declaration, a declarator that is not a plain identifier, a second
  declarator (the first kept) or one without an initializer (none kept)."
  [d sm idls]
  (let [ds (g d :DeclarationSpecifiers)
        typed? (some #(#{:DeclarationSpecifiersTypeSpec} (cs %)) (chain ds :DeclarationSpecifiers))
        auto? (and (:auto sm) (not typed?) (#{:c23 :gnu23 :c2y :gnu2y} (cx :std)))
        kw (cond auto? "auto" (:constexpr sm) "constexpr")
        here (first (filter #(instance? PTok %) (node-tokens d)))]
    (cond
      (nil? kw) idls
      (empty? idls) (do (when auto? (soft! here "'auto' in empty declaration")) idls)
      :else
      (let [id (g (first idls) :InitDeclarator)
            dd (g id :Declarator)
            ;; a declarator in parentheses is the declarator (`auto ((i2)) = 3;`, c23-auto-1.c): gcc's tree has no node for them
            plain? (loop [dd dd]
                     (and dd (nil? (g dd :Pointer))
                          (let [x (g dd :DirectDeclarator)]
                            (case (cs x)
                              :DirectDeclaratorIdent true
                              :DirectDeclaratorDecl (recur (g x :Declarator))
                              false))))]
        (cond
          (and auto? (not plain?)) (do (soft! here "'auto' requires a plain identifier, possibly with attributes, as declarator") [])
          (not= (cs id) :InitDeclaratorInit) (do (soft! here (str "'" kw "' requires an initialized data declaration")) [])
          (next idls) (do (soft! here (str "'" kw "' may only be used with a single declarator")) [(first idls)])
          :else idls)))))

(defn declaration
  "A Declaration's forms (§6.2-§6.8)."
  [d]
  (let [ff (case (cs d)
             :DeclarationAssert [(static-assert-form (g d :StaticAssertDeclaration))]
             :DeclarationAuto (let [[nt t] (declarator 'int (g d :Declarator))]
                                [(L 'c/var (with-meta (ident-tok nt) {:c/auto-type true}) (initializer (g d :Initializer)))])
             :DeclarationDecl
             (let [spec (specifiers (g d :DeclarationSpecifiers))
                   {type :type sm :meta implicit-int :implicit-int typedef :typedef} spec
                   sm (cond-> sm implicit-int (assoc :c/implicit-int true))
                   idls (chain (g d :InitDeclaratorList) :InitDeclaratorList)
                   ;; c-tails (*soft-errors*): c-parser.cc's c_parser_declaration_or_fndef on an underspecified declaration
                   ;; (C23's auto inferring the type, constexpr): its errors recovered, the declaration dropped or cut to its first
                   ;; declarator as gcc skips the rest
                   idls (if *soft-errors* (underspec-idls d sm idls) idls)
                   end (attrs (g d :AttributeSpecifierList))
                   one (fn [idl i shared]
                         (let [id (g idl :InitDeclarator)
                               [nt t as] (declarator (if shared 'c/base type) (g id :Declarator))
                               m (cond-> sm
                                   as (assoc :c/attrs as)
                                   (and (pos? i) (not shared)) (assoc :c/grouped true))
                               m (if-let [a (attrs (g id :AttributeSpecifierList))]
                                   (cond-> (assoc m :c/after-attrs a) (trailing-pos (g id :Declarator)) (assoc :c/after-at (trailing-pos (g id :Declarator))))
                                   m)
                               ;; GNU's attributes before a declarator after a comma appertain to it alone: the declaration of
                               ;; it alone (its form, printed alone) has them as its leading attributes, after the shared ones
                               ;; (CS83's class: :c/list-attrs, printed at the head, read again as such, differed)
                               m (if-let [a (attrs (g idl :AttributeSpecifierList))] (update m :c/decl-attrs (fnil into []) a) m)
                               init (if (= (cs id) :InitDeclaratorInit) (initializer (g id :Initializer)) ::none)
                               f (decl-form spec nt t m init (when-let [a (g id :Asm)] (tokens-text (node-tokens a))))]
                           ;; c-tails: under the dg check's recovering read (*soft-errors*), an initializer that holds no line of
                           ;; its own (a constant) on another line than its declarator: its line, the checker's for the conversion's
                           ;; error (c-c++-common/cpp/embed-10.c's #embed line); not in the text levels' forms
                           (if (and *soft-errors* (not= init ::none) (not (iobj? init)) (seq? f) (has-main? (g id :Initializer)))
                             (vary-meta f assoc :c/init-line (line-of (min-po (g id :Initializer))))
                             f)))]
               (cond
                 ;; cc follows a file-scope static_assert with an empty declaration of its own
                 (and (empty? idls) (nil? (g d :DeclarationSpecifiers))) []
                 (empty? idls)
                 (let [t (loop [t type] (if (and (seq? t) ('#{const volatile restrict atomic _Nonnull __seg_gs __seg_fs} (first t))) (recur (second t)) t))
                       head (when (seq? t) (first t))]
                   (if (and ('#{struct union enum} head) (= t type) (not typedef) (not implicit-int))
                     [(addm (Lv (cons (sym (str "c/" head)) (rest t)))
                            (cond-> (merge (meta t) (dissoc sm :c/implicit-int)) end (assoc :c/decl-end-attrs end)))]
                     [(addm (L 'c/declare-specs type) (cond-> (assoc sm :c/typedef typedef) end (assoc :c/decl-end-attrs end)))]))
                 (and (> (count idls) 1) (defines-type? type))
                 (let [base (if typedef type type)]
                   [(addm (Lv (list* 'c/group base (map-indexed (fn [i l] (one l i true)) idls)))
                          (cond-> {} end (assoc :c/decl-end-attrs end)))])
                 :else
                 (let [fs (vec (map-indexed (fn [i l] (one l i false)) idls))]
                   (if end (conj (pop fs) (addm (peek fs) {:c/decl-end-attrs end})) fs)))))]
    ff))

;; ---------------------------------------------------------------------------------------------
;; Statements (§7.2, §7.3)

(declare stmt-items function-definition)

(defn- func-injected?
  "Whether a block item is cc's __func__ declaration, injected at a function body's brace (parse.ae's
  inject-func-tokens)."
  [^HashMap bi lbrace]
  (and lbrace (= (cs bi) :BlockItemDecl)
       (let [d (g bi :Declaration)
             toks (node-tokens d)]
         (and (= 9 (count toks))
              (= "__func__" (tsrc (nth toks 3)))
              (every? #(and (identical? (.-pf ^PTok %) (.-pf ^PTok lbrace)) (= (.-po ^PTok %) (.-po ^PTok lbrace))) toks)))))

(defn- item-kind [x] (cond (and (seq? x) (#{'c/var 'c/declare 'c/typedef 'c/struct 'c/union 'c/enum 'c/group 'c/static-assert
                                             'c/defn 'c/local-labels 'c/declare-specs} (first x))) :decl
                           :else :stmt))

(defn- binding-elems
  "A declaration form as a let's binding elements (§7.2): a name and its initializer, or the form."
  [f]
  (let [f (value f)]
    (if (and (seq? f) (= (first f) 'c/var) (= 3 (count f))
             (not (instance? Lit (nth f 2)))
             (empty? (dissoc (meta f) :line))
             (let [m (meta (second f))] (not (or (:static m) (:extern m) (:thread_local m)))))
      ;; the declaration's line stays with the bound name (the checker's errors are located by it)
      [(let [x (second f) ln (:line (meta f))] (if (and ln (iobj? x)) (vary-meta x assoc :line ln) x)) (nth f 2)]
      [f])))

(defn lets
  "Block items ([:decl form] [:stmt form]) as a statement list, each run of declarations a let whose body
  is the rest of the block."
  [items]
  (loop [items (seq items) out []]
    (if-not items
      out
      (let [[k f] (first items)]
        (if (= k :decl)
          (let [[ds rest] (split-with #(= :decl (first %)) items)]
            (conj out (let [l (Lv (list* 'let (V (mapcat #(binding-elems (second %)) ds)) (lets rest)))
                            ln (some #(:line (meta (value (second %)))) ds)]
                        (if ln (vary-meta l assoc :line ln) l))))
          (recur (next items) (conj out f)))))))

(defn- straddles?
  "D342-1 (a): whether the list element or body item `n` holds both the main file's tokens and another file's, the #include
  that brought the other file's not inside it (no placed #include within its main-file extent): an element or a statement
  that begins in the main file and ends in a header placed beside it, or the reverse (`{ 0,` `#include \"h\"` `3 }` with h
  holding `1, 2 -`), which the print would write with the header's tokens twice. Not ci's read (*include-inside*)."
  [n]
  (and (not *include-inside*) (has-main? n) (has-other? n)
       (let [^java.util.TreeSet t (cx :placed-incs)
             lo (min-po n) hi (max-end n)
             x (when t (.ceiling t (Long/valueOf lo)))]
         (not (and x (< (long x) hi))))))

(defn- placed-at
  "The directives placed before the item `i` of the statement list `owner`: [[offset form] ...]."
  [owner i]
  (when-let [^IdentityHashMap pl (cx :placed)]
    (get (.get pl owner) (long i))))

(defn- dirs-at [owner i] (map second (placed-at owner i)))

(defn- take-pragmas!
  "CS290 (a), CS299 (a): the queued pragmas (the converter's :pragmas, a TreeMap seq -> [[text entry] ...]) before the tokens of
  seq in (lo, hi], removed from the queue, in order: [[seq text entry] ...]."
  [^long lo ^long hi]
  (when-let [^java.util.TreeMap pq (cx :pragmas)]
    (when (< lo hi)
      (let [sub (.subMap pq (Long/valueOf lo) false (Long/valueOf hi) true)
            out (vec (for [[sq ps] sub [t e] ps] [sq t e]))]
        (.clear sub)
        out))))

(defn block-items
  "A BlockItemList's items, with the directives placed among them."
  [bil owner]
  (let [lbrace (g owner :Token)
        bis (vec (remove #(func-injected? % lbrace) (map #(g % :BlockItem) (chain bil :BlockItemList))))
        own (when lbrace (.-pf ^PTok lbrace))
        out (ArrayList.)
        ;; CS274 (a): consecutive statements one invocation made whole (no directive between them): the first printed as the
        ;; invocation, the others not (C3b.1's one statement extended)
        ^HashMap groups (cx :groups)
        multi (HashMap.)
        _ (when groups
            (loop [i 0]
              (when (< i (count bis))
                (let [bi (bis i)
                      r (rng bi)
                      gr (when (and (= (cs bi) :BlockItemStmt) (has-main? bi) (not (has-other? bi))) (.get groups (aget r 0)))
                      j (when (and gr (< (aget r 1) (long (:max gr))) (not (.contains ^HashSet (cx :claimed) (aget r 0))))
                          (loop [j (inc i)]
                            (when (< j (count bis))
                              (let [b2 (bis j) r2 (rng b2)]
                                (cond
                                  (or (not= (cs b2) :BlockItemStmt) (not (has-main? b2)) (has-other? b2) (seq (dirs-at owner j))) nil
                                  (= (aget r2 1) (long (:max gr))) j
                                  (< (aget r2 1) (long (:max gr))) (recur (inc j))
                                  :else nil)))))]
                  (if j
                    (do (.put multi i [(:text gr) j]) (.add ^HashSet (cx :claimed) (aget r 0)) (recur (inc j)))
                    (recur (inc i)))))))
        mark! (fn [from t]
                (doseq [k (range from (.size out))]
                  (let [[kind f] (.get out k)]
                    (.set out k [kind (addm f (if (= k from) {:c/macro-stmt t} {:c/macro-part true}))]))))
        pending (atom nil)]
    (doseq [[i bi] (map-indexed vector bis)]
      (doseq [df (dirs-at owner i)] (.add out [:stmt df]))
      ;; CS290 (a): ci's read (*include-inside*): the re-entered copy's pragmas before this item's first token, as statement-level
      ;; c/pragma forms in the stream's order (gcc's deferred pragmas are tokens: a #pragma pack inside a body takes effect there)
      ;; CS299 (a): an included file's pragmas too (the Mac VM's report 261: a body of a header's function, a file included inside
      ;; the body), those after the block's opening brace alone (a file-scope pragma is its unit's, convert's)
      (when (and *include-inside* lbrace (not= Long/MAX_VALUE (aget (rng bi) 0)))
        (doseq [[_ t] (take-pragmas! (.-seq ^PTok lbrace) (aget (rng bi) 0))]
          (.add out [:stmt (list 'c/pragma t)])))
      (when-let [[t j] (.get multi i)] (reset! pending [(.size out) t j]))
      ;; an item an #include inside the body brought in is the directive's; under *include-inside* (ci's read, CS275 (b)) the
      ;; body's own item, as the libc's tables are the declaration's
      (when (or *include-inside* (nil? own) (some #(identical? (.-pf ^PTok %) own) (take 64 (node-tokens bi))))
        ;; D342-1 (a): an item that straddles the body's file and a header an #include beside it brought in is refused
        (when (and (some? own) (identical? own (cx :main-file)) (straddles? bi))
          (refuse :split-declaration "a declaration that begins in one file and ends in another" bi))
        (case (cs bi)
          :BlockItemDecl (let [d (g bi :Declaration)
                               t (group-of d)
                               fs (declaration d)]
                           (doseq [f (if (and t (= 1 (count fs))) [(addm (first fs) {:c/macro-stmt t})] fs)]
                             (.add out [:decl (at d f)])))
          :BlockItemStmt (doseq [s (stmt-items (g bi :Statement))] (.add out [(if (and (seq? s) (= (first s) 'c/attr-decl)) :stmt :stmt) s]))
          :BlockItemLabel (.add out [:decl (Lv (cons 'c/local-labels (map #(keyword (tsrc (g % :Token2))) (chain (g (g bi :LabelDeclaration) :IdentifierList) :IdentifierList))))])
          :BlockItemFuncDef (.add out [:decl (function-definition (g bi :DeclarationSpecifiers) (g bi :Declarator) nil (g bi :CompoundStatement) nil bi)])))
      (when-let [[from t j] @pending]
        (when (= i j) (mark! from t) (reset! pending nil))))
    ;; CS299 (a): the pragmas after the block's last item, before its closing brace (a pop at a block's end)
    (when-let [^PTok rb (and *include-inside* lbrace (g owner :Token2))]
      (doseq [[_ t] (take-pragmas! (.-seq ^PTok lbrace) (.-seq rb))]
        (.add out [:stmt (list 'c/pragma t)])))
    (doseq [df (dirs-at owner (count bis))] (.add out [:stmt df]))
    (vec out)))

(defn compound-items [cs]
  (lets (block-items (g cs :BlockItemList) cs)))

(defn- braced? [st] (and (= (cs st) :StatementCompound) (nil? (g st :AttributeSpecifierList)) (nil? (group-at st))))

(defn- body
  "A substatement's statement list (a compound statement's items, or the statement's)."
  [st]
  (if (braced? st)
    (compound-items (g st :CompoundStatement))
    (stmt-items st)))

(defn- bare
  "A form whose substatement was not a compound statement marked :c/bare (gcc -O0's code tells a body's
  braces: a block's end is a nop)."
  [form st]
  (if (braced? st) form (addm form {:c/bare true})))

(defn- branch
  "An if's branch as one statement form: its one statement (not a label, a directive, a let or a do),
  else (do items...) (N4: the print braces every branch)."
  [st]
  (let [items (body st)
        x (first items)]
    (if (and (= 1 (count items))
             (not (and (seq? x) ('#{label case default c/directive c/define c/undef c/include c/pragma let do} (first x)))))
      x
      (Lv (cons 'do items)))))

(defn- else-if [st]
  (when (and st (= (cs st) :StatementSelection) (nil? (g st :AttributeSpecifierList)) (nil? (group-at st)))
    (let [s (g st :SelectionStatement)]
      (when (and (#{:SelectionStatementIf :SelectionStatementIfElse} (cs s)) (nil? (g s :Declaration)) (nil? (g s :Declaration2))) s))))

;; Arbace (CS194 (a)): C2y's selection statements with a declaration. `if (D; E) S` is `{ D; if (E) S }` (the declaration's
;; scope is the whole statement, the else branch's too); a condition declaration `if (int i = 42)` declares i and tests it.
;; The block is marked :c/sel-decl, for the checker's pedwarn before C2y.
(defn- sel-expr
  "A selection statement's controlling expression: its expression, or the variable its condition declaration declares."
  [s]
  (if-let [d (g s :Declaration2)]
    (let [x (second (value (last (declaration d))))] (if (iobj? x) (with-meta x nil) x))
    (expr (g s :ExpressionList))))

(defn- sel-wrap
  "The block that declares a selection statement's declarations around its form `f`."
  [s f]
  (if (or (g s :Declaration) (g s :Declaration2))
    (let [ds (concat (when-let [d (g s :Declaration)] (map #(at d %) (declaration d)))
                     (when-let [d (g s :Declaration2)] (map #(at d %) (declaration d))))]
      (addm (first (lets (concat (map (fn [f] [:decl f]) ds) [[:stmt f]]))) {:c/sel-decl true}))
    f))

(defn- opt-expr [e] (if (nil? e) '_ (expr e)))

(defn- expr-stmt [e]
  (let [x (expr e)]
    (cond
      (and (seq? x) (= (first x) 'set!) (= 3 (count x)) (seq? (second x)) (= 'aget (first (second x)))
           (empty? (dissoc (meta (second x)) :line)) (empty? (dissoc (meta x) :line)))
      (with-meta (Lv (list* 'aset (concat (rest (second x)) [(nth x 2)]))) (meta x))
      (instance? Lit x) (L 'c/expr x)
      (not (iobj? x)) (list 'c/expr x)
      :else x)))

(declare stmt-items*)

(defn stmt-items
  "A Statement's items (labels are items before what they label), the directives placed before it (place-directives!: one
  between its labels and it) first."
  [st]
  (let [ds (dirs-at st 0)] (if (seq ds) (into (vec ds) (stmt-items* st)) (stmt-items* st))))

(defn- group-semi
  "CS82 (b): the text of the invocation that made all of statement `st` but the `;` the source wrote after it (zlib's
  `NEEDBITS(16);`, a do-while macro's statement), that `;` with it, when unclaimed (then claimed): gcc -O0 gives the
  expansion's tokens the invocation's location, so the print writes the invocation where it stood."
  [st]
  (when-let [^HashMap groups (cx :groups)]
    (when (and (has-main? st) (not (has-other? st)))
      (let [r (rng st) hi (aget r 1) ^HashSet claimed (cx :claimed) gr (.get groups (aget r 0))]
        (when (and gr (< (long (:max gr)) hi) (= (:next gr) hi) (nil? (.get groups hi))
                   (not (.contains claimed (aget r 0))))
          (let [^PTok semi (peek (node-tokens st))]
            (when (and semi (= (.-seq semi) hi) (= (.-ch semi) \;) (main-tok? semi))
              (.add claimed (aget r 0))
              (str (:text gr) ";"))))))))

(defn stmt-items*
  [st]
  (let [t (or (group-of st) (group-semi st))
        items
        (case (cs st)
          :StatementLabeled
          (let [ls (g st :LabeledStatement)
                lbl (at ls (case (cs ls)
                             :LabeledStatementLabel (list 'label (keyword (tsrc (g ls :Token))))
                             :LabeledStatementCaseLabel (L 'case (expr (g ls :ConstantExpression)))
                             :LabeledStatementRange (L 'case (expr (g ls :ConstantExpression)) (expr (g ls :ConstantExpression2)))
                             :LabeledStatementDefault (list 'default)))
                lbl (with-attrs lbl :c/attrs (g st :AttributeSpecifierList))
                inner (g ls :Statement)
                lbl (if (and inner (= (cs inner) :StatementExpr)) ; GNU attributes after the label before `}` (CS144)
                      (with-attrs lbl :c/attrs (g (g inner :ExpressionStatement) :LabelAttributeSpecifierList))
                      lbl)]
            (into [lbl] (when-let [s (g ls :Statement)] (stmt-items s))))
          :StatementCompound [(at st (Lv (cons 'do (compound-items (g st :CompoundStatement)))))]
          :StatementExpr
          (let [es (g st :ExpressionStatement)
                as (concat (attrs (g st :AttributeSpecifierList)) (attrs (g es :AttributeSpecifierList))
                           (when-let [ds (g es :declarationSpecifiers)] (get-in (specifiers ds) [:meta :c/decl-attrs])))]
            (cond
              (g es :ExpressionList) (let [it (at st (expr-stmt (g es :ExpressionList)))] ; CS140: the attributes the statement stood with
                                       [(if (seq as) (addm it {:c/attrs (vec as)}) it)])
              (seq as) [(at st (Lv (cons 'c/attr-decl as)))]
              :else []))
          :StatementSelection
          (let [s (g st :SelectionStatement)]
            [(at st
               (sel-wrap s
               (case (cs s)
                 :SelectionStatementIf (bare (Lv (list* 'when (sel-expr s) (body (g s :Statement)))) (g s :Statement))
                 :SelectionStatementIfElse
                 (if (else-if (g s :Statement2))
                   (let [bares (java.util.TreeSet.)
                         clauses (loop [s s out []]
                                   (when-not (braced? (g s :Statement)) (.add bares (long (+ 2 (count out)))))
                                   (let [out (conj out (sel-expr s) (branch (g s :Statement)))]
                                     (if (= (cs s) :SelectionStatementIfElse)
                                       (if-let [s2 (else-if (g s :Statement2))]
                                         (recur s2 out)
                                         (do (when-not (braced? (g s :Statement2)) (.add bares (long (+ 2 (count out)))))
                                             (conj out :else (branch (g s :Statement2)))))
                                       out)))]
                     (addm (Lv (cons 'cond clauses)) (if (seq bares) {:c/bare (set bares)} {})))
                   (addm (L 'if (sel-expr s) (branch (g s :Statement)) (branch (g s :Statement2)))
                         (let [b (cond-> #{} (not (braced? (g s :Statement))) (conj 2) (not (braced? (g s :Statement2))) (conj 3))]
                           (if (seq b) {:c/bare b} {}))))
                 :SelectionStatementSwitch (bare (Lv (list* 'switch (sel-expr s) (body (g s :Statement)))) (g s :Statement)))))])
          :StatementIteration
          (let [s (g st :IterationStatement)]
            [(at st
               (case (cs s)
                 :IterationStatementWhile (bare (Lv (list* 'while (expr (g s :ExpressionList)) (body (g s :Statement)))) (g s :Statement))
                 :IterationStatementDo (bare (Lv (list* 'do-while (expr (g s :ExpressionList)) (body (g s :Statement)))) (g s :Statement))
                 :IterationStatementFor
                 (bare (Lv (list* 'for (V (if-let [e (g s :ExpressionList)] [(expr e)] [])) (opt-expr (g s :ExpressionList2))
                                  (opt-expr (g s :ExpressionList3)) (body (g s :Statement))))
                       (g s :Statement))
                 :IterationStatementForDecl
                 (bare (Lv (list* 'for (V (mapcat binding-elems (declaration (g s :Declaration)))) (opt-expr (g s :ExpressionList))
                                  (opt-expr (g s :ExpressionList2)) (body (g s :Statement))))
                       (g s :Statement))))])
          :StatementJump
          (let [j (g st :JumpStatement)]
            [(at st
               (case (cs j)
                 :JumpStatementGoto (list 'goto (keyword (tsrc (g j :Token2))))
                 :JumpStatementGotoExpr (L 'goto* (expr (g j :ExpressionList)))
                 :JumpStatementContinue (list 'continue)
                 :JumpStatementContinueLabel (list 'continue (keyword (tsrc (g j :Token2))))
                 :JumpStatementBreakLabel (list 'break (keyword (tsrc (g j :Token2))))
                 :JumpStatementBreak (list 'break)
                 :JumpStatementReturn (if-let [e (g j :ExpressionList)] (L 'return (expr e)) (list 'return))))])
          :StatementAsm [(at st (asm-form (g (g st :AsmStatement) :Asm)))]
          (refuse :statement (str "statement " (cs st)) st))
        items (if-let [as (and (not= (cs st) :StatementLabeled) (not= (cs st) :StatementExpr) (attrs (g st :AttributeSpecifierList)))]
                (if (seq items) (assoc items 0 (addm (items 0) {:c/attrs as})) items)
                items)]
    (if (and t (= 1 (count items))) [(addm (items 0) {:c/macro-stmt t})] items)))

;; ---------------------------------------------------------------------------------------------
;; Function definitions (§6.4)

(defn function-definition
  "A function definition's c/defn form."
  [ds d dl cst def-attrs node]
  (let [spec (specifiers ds)
        {type :type sm :meta implicit-int :implicit-int} spec
        [nt t as] (declarator type d)
        ;; 6.9.1p2: a function definition's declarator declares a function in its own form; `auto g { }`, `constexpr int v { }`,
        ;; a function defined through a typedef: gcc's error before the body (an error test's line, its read an error, not a refusal)
        _ (when-not (fn-type? t)
            (let [b (first (filter #(instance? PTok %) (node-tokens cst)))
                  ;; gcc's words for C23's underspecified declarations: the specifier's position
                  sp (some (fn [w] (first (filter #(and (instance? PTok %) (= w (tsrc %))) (node-tokens ds)))) ["constexpr" "auto"])]
              (throw (ex-info (if sp
                                (str (tree/pos-string sp) ": '" (tsrc sp) "' requires an initialized data declaration")
                                (str (if b (tree/pos-string b) "-") ": expected '=', ',', ';', 'asm' or '__attribute__' before '{' token"))
                              {:c/error true :c/soft true}))))
        [_ ps r] t
        kr (:c/kr (meta ps))
        ps (if kr
             (let [decls (into {} (for [l (chain dl :DeclarationList)
                                        f (declaration (g l :Declaration))
                                        :let [f (value f)]
                                        :when (and (seq? f) (#{'c/var 'c/declare} (first f)))]
                                    (let [x (second f)
                                          x (if (= (first f) 'c/declare) (with-meta x (assoc (meta x) :tag (list 'fn (nth f 2) (:tag (meta (nth f 2)))))) x)]
                                      [(name x) x])))]
               (with-meta (mapv (fn [p] (or (when-let [x (get decls (name p))] (vary-meta x dissoc :c/grouped))
                                            (with-meta p {:tag 'int :c/implicit-int true})))
                                ps)
                 {:c/kr true}))
             ps)
        m (cond-> sm as (assoc :c/attrs as) def-attrs (assoc :c/def-attrs def-attrs)
            ;; CS160, CS172 (a): a definition's diagnostics are at the declarator's line, not the definition's first (`void` on a line of its own)
            (and (instance? PTok nt) (has-main? node)) (assoc :line (line-of (.-po ^PTok nt))))
        nm (ident-tok nt)
        nm (if (seq? nm) (addm nm m) (with-meta nm m))
        vm (cond-> (assoc (meta ps) :tag r) implicit-int (assoc :c/implicit-int true)
             ;; an old-style definition's declarator line, where the checker's diagnostic is
             (and kr (instance? PTok nt) (has-main? node)) (assoc :line (line-of (.-po ^PTok nt))))]
    (at node (Lv (list* 'c/defn nm (with-meta ps (if implicit-int (dissoc vm :tag) vm)) (compound-items cst))))))

;; ---------------------------------------------------------------------------------------------
;; The main file's directives (§9.2)

(defn- directive-lines
  "The main file's directive lines, active or not: [{:off :end :tokens}], each line's tokens (the port's
  lexer, comments in the separators) from its # to its new-line."
  []
  (let [^CFile f (cx :main-file)
        [ts _] (lex/tokens (lex/new-file "m" (cx :main-bytes)))
        out (ArrayList.)]
    (loop [ts (seq ts) start true cur nil]
      (if-not ts
        (when cur (.add out cur))
        (let [^Tok t (first ts) c (.-ch t)]
          (cond
            (= c \newline) (do (when cur (.add out (assoc cur :end (inc (.-po t))))) (recur (next ts) true nil))
            (and start (= c \#)) (recur (next ts) false {:off (.-po t) :tokens [t]})
            cur (recur (next ts) false (update cur :tokens conj t))
            :else (recur (next ts) false nil)))))
    (vec out)))

(defn- line-text ^String [toks]
  (let [b (StringBuilder.)]
    (doseq [[i ^Tok t] (map-indexed vector toks)]
      (when (and (pos? i) (pos? (.length ^String (.-sep t)))) (.append b " "))
      (.append b (.-src t)))
    (utf8-decode (str b))))

;; queue 540: the print's `#line N /*arbace*/` before an invocation whose expansion holds __LINE__ (compute-groups!): the print's,
;; not a directive of the program's
(defn- line-mark? [d]
  (let [^bytes src (cx :main-bytes)
        a (long (:off d)) e (min (alength src) (long (or (:end d) (alength src))))]
    (boolean (re-matches #"#line [0-9]+ /\*arbace\*/\r?\n?" (String. src (int a) (int (- e a)) "ISO-8859-1")))))

(defn- verb-of [d] (when-let [^Tok t (second (:tokens d))] (.-src t)))

(defn- define-form [toks]
  (let [[_ _ nm & body] toks
        ^Tok nm nm
        fnlike (and (seq body) (= (.-ch ^Tok (first body)) \() (zero? (.length ^String (.-sep ^Tok (first body)))))
        [params body] (if fnlike
                        (let [[ps more] (split-with #(not= (.-ch ^Tok %) \)) (rest body))]
                          ;; GNU's named variadic parameter, x..., is & x
                          [(loop [ps (seq ps) out []]
                             (if-let [^Tok t (first ps)]
                               (cond
                                 (= (.-ch t) \,) (recur (next ps) out)
                                 (and (= (.-ch t) :IDENTIFIER) (some-> ^Tok (second ps) .-ch (= :DDD)))
                                 (recur (nnext ps) (conj out '& (sym (.-src t))))
                                 (= (.-ch t) :DDD) (recur (next ps) (conj out '&))
                                 :else (recur (next ps) (conj out (sym (.-src t)))))
                               out))
                           (rest more)])
                        [nil body])
        text (line-text body)]
    (if params
      (list 'c/define (sym (.-src nm)) params text)
      (list 'c/define (sym (.-src nm)) text))))

(defn- directive-form
  "A directive line's form (§9.2)."
  [d]
  (let [toks (:tokens d)
        verb (verb-of d)
        text (str "#" (line-text (rest toks)))]
    (case verb
      "define" (if (> (count toks) 2) (define-form toks) (list 'c/directive text))
      "undef" (if (> (count toks) 2) (list 'c/undef (sym (.-src ^Tok (nth toks 2)))) (list 'c/directive text))
      ("include" "include_next")
      (let [arg (line-text (drop 2 toks))
            u (get (cx :unit-of-off) (:off d))]
        (cond-> (list 'c/include arg)
          (= verb "include_next") (concat [:next true])
          u (concat [:unit (sym u)])
          true (->> (apply list))))
      "pragma" (list 'c/pragma (line-text (drop 2 toks)))
      (list 'c/directive text))))

(def ^:private cond-verbs #{"if" "ifdef" "ifndef" "elif" "elifdef" "elifndef" "else" "endif"})

(defn- place-directives!
  "Places the main file's active directives (those the preprocessor executed: the layer's offsets, and
  every directive of an executed conditional family) between the items of the statement lists of `tu`
  (the translation unit's top level and the function bodies): (cx :placed) maps a list's owner to
  {item-index [forms]}; since CS329 (a) the initializer lists and the enumerator lists too, between their elements (an owner
  the list's head, list-with-dirs; not ci's read). A conditional family that does not fall between the items of one list is
  left out (:full keeps it); so is any directive inside an item."
  [tu-items layer]
  (let [dls (remove line-mark? (directive-lines))
        executed (set (keep #(when (and (= (:file %) (cx :main-name)) (not= (:directive %) "enter")) (:off %)) layer))
        ;; conditional families: the offsets of each family's lines, by nesting
        fam (HashMap.) ; off -> family id
        fam-lines (HashMap.)
        _ (loop [ds (seq dls) stack () nid 0]
            (when ds
              (let [d (first ds) v (verb-of d)]
                (cond
                  (#{"if" "ifdef" "ifndef"} v) (do (.put fam (:off d) nid) (.put fam-lines nid [(:off d)]) (recur (next ds) (conj stack nid) (inc nid)))
                  (and (#{"elif" "elifdef" "elifndef" "else" "endif"} v) (seq stack))
                  (let [id (first stack)]
                    (.put fam (:off d) id) (.put fam-lines id (conj (.get fam-lines id) (:off d)))
                    (recur (next ds) (if (= v "endif") (rest stack) stack) nid))
                  :else (recur (next ds) stack nid)))))
        active (filter (fn [d]
                         (if-let [id (.get fam (:off d))]
                           (contains? executed (first (.get fam-lines id)))
                           (contains? executed (:off d))))
                       dls)
        ;; inside an inactive group: a line between a family's line not taken and its next
        inactive-ranges (let [taken (into {} (keep (fn [e] (when (contains? e :taken) [(:off e) (:taken e)])) layer))]
                          (for [[id offs] fam-lines
                                :when (contains? executed (first offs))
                                [a b] (partition 2 1 offs)
                                :when (not (get taken a))]
                            [a b]))
        active (remove (fn [d] (and (not (.get fam (:off d)))
                                    (some (fn [[a b]] (< a (:off d) b)) inactive-ranges)))
                       active)
        ;; queue 371: a directive among an invocation's arguments is the invocation's (compute-groups!'s spans): printed in its
        ;; text, or with it left out when the invocation is printed expanded; its family's other lines go with it (below)
        ^java.util.TreeMap spans (cx :macro-spans)
        in-span? (fn [^long off] (some (fn [[a v]] (and (<= (long a) off) (< off (long (:to v))))) spans))
        ;; CS275 (a): an executed family's group the main pass skipped, kept as its text (a c/directive of the lines between
        ;; the family's two lines), for a file that includes itself, whose second pass takes it: placed with its family
        active (sort-by :off (concat active
                       (for [[a b] inactive-ranges
                             :let [la (first (filter #(= (:off %) a) dls))
                                   start (long (or (:end la) b))
                                   ^bytes src (cx :main-bytes)]
                             :when (< start (long b))
                             :let [t (utf8-decode (String. src (int start) (int (- (long b) start)) "ISO-8859-1"))
                                   t (if (.endsWith ^String t "\n") (subs t 0 (dec (count t))) t)]
                             :when (not (str/blank? t))]
                         (do (.put fam start (.get fam a))
                             (.put fam-lines (.get fam a) (conj (.get fam-lines (.get fam a)) start))
                             {:off start :inactive t}))))
        placed (IdentityHashMap.)
        where (HashMap.)
        place! (fn [owner items d]
                 ;; items: the list's nodes; d placed before the first item starting after it
                 (let [off (:off d)
                       idx (loop [i 0]
                             (cond
                               (>= i (count items)) i
                               (not (has-main? (nth items i))) (recur (inc i))
                               (> (min-po (nth items i)) off) i
                               :else (recur (inc i))))
                       ok (or (zero? idx)
                              (let [prev (last (filter has-main? (take idx items)))]
                                (or (nil? prev) (< (max-end prev) off))))
                       ;; an #embed whose output begins the next item (its prefix's or if_empty's tokens on the directive's
                       ;; line: embed-17.c's `if_empty (int a = 42;)`) is that item's text: the item is printed, not the
                       ;; directive too, which the print's read would expand again
                       ok (and ok (not (and (= "embed" (verb-of d)) (:end d) (< idx (count items))
                                            (has-main? (nth items idx)) (< (min-po (nth items idx)) (long (:end d))))))]
                   (when ok
                     (.put where (:off d) [owner idx])
                     true)))]
    (letfn [(lists-of [owner items]
              ;; directives inside an item go to its nested lists
              (for [it items :when (has-main? it)
                    sub (nested it)]
                sub))
            (nested [it]
              ;; [owner items] of the statement lists inside a node
              (let [out (ArrayList.)
                    stack (java.util.ArrayDeque.)]
                (.push stack it)
                (loop []
                  (when-not (.isEmpty stack)
                    (let [x (.pop stack)]
                      (when (instance? HashMap x)
                        (let [;; CS329 (a): an initializer list's or an enumerator list's head, its elements and the node of its
                              ;; braces (the extent a directive inside it falls in: the elements may all be a header's); not ci's
                              ;; read (*include-inside*), whose lists keep their included elements
                              [lk head] (when-not *include-inside*
                                          (case (nt x)
                                            "Initializer" (when (= (cs x) :InitializerInitList) [:InitializerList (g x :InitializerList)])
                                            "PostfixExpression" (when (= (cs x) :PostfixExpressionComplit) [:InitializerList (g x :InitializerList)])
                                            "EnumSpecifier" (when (= (cs x) :EnumSpecifierDef) [:EnumeratorList (g x :EnumeratorList)])
                                            nil))]
                          (cond
                            (= (nt x) "CompoundStatement")
                            (.add out [x (vec (remove #(func-injected? % (g x :Token)) (map #(g % :BlockItem) (chain (g x :BlockItemList) :BlockItemList))))])
                            head
                            (do (.add out [head (let [^IdentityHashMap li (cx :list-items)]
                                                  (or (.get li head)
                                                      (let [v (mapv #(elem-node % lk) (chain head lk))] (.put li head v) v)))
                                           x])
                                (doseq [c (children x)] (when (and (instance? HashMap c) (not (identical? c head))) (.push stack c))))
                            :else (doseq [c (children x)] (when (instance? HashMap c) (.push stack c)))))))
                    (recur)))
                (vec out)))
            (place-in [owner items ds]
              (doseq [d ds]
                (let [off (:off d)
                      inside (first (filter #(and (has-main? %) (<= (min-po %) off) (< off (max-end %))) items))]
                  (if inside
                    (let [subs (nested inside)
                          sub (first (filter (fn [[o _ ext]] (let [e (or ext o)] (and (has-main? e) (<= (min-po e) off) (< off (max-end e))))) subs))]
                      (if sub
                        (place-in (first sub) (second sub) [d])
                        ;; between a statement's labels and what they label (c23-named-loops-1.c's `g: h: #pragma GCC unroll 2
                        ;; while ...`): before the labeled statement's form (stmt-items), the labels' forms before it
                        (when-let [s (label-inner inside off)] (place! s [s] d))))
                    (place! owner items d)))))
            (label-inner [it off]
              (loop [x (if (= (nt it) "BlockItem") (g it :Statement) it)]
                (when (and (instance? HashMap x) (= (cs x) :StatementLabeled))
                  (let [inner (g (g x :LabeledStatement) :Statement)]
                    (cond (nil? inner) nil
                          (and (has-main? inner) (< off (min-po inner)) (<= (min-po x) off)) inner
                          :else (recur inner))))))]
      (place-in :top tu-items (remove #(in-span? (:off %)) active))
      ;; 378 item 2: an executed directive of a span that is not a conditional family's line (#define, #undef, #pragma, ...):
      ;; kept only when an invocation holding it is printed as its text (judged after the conversion: macro-directives!)
      (doseq [d active
              :when (and (not (:inactive d)) (not (.get fam (:off d))) (contains? executed (:off d)) (in-span? (:off d)))]
        (.add ^ArrayList (cx :span-dirs) (:off d))))
    ;; a conditional family's lines all in one list, else none of them
    (let [drop (HashSet.)]
      (doseq [[id offs] fam-lines]
        (let [ws (map #(.get where %) offs)]
          (when (or (some nil? ws) (not (apply = (map first ws))))
            (doseq [o offs] (.add drop o)))))
      (doseq [d active
              :let [w (.get where (:off d))]
              :when (and w (not (.contains drop (:off d))))]
        (let [[owner idx] w
              ^HashMap m (or (.get placed owner) (let [m (HashMap.)] (.put placed owner m) m))]
          (.put m idx (conj (or (.get m idx) []) [(:off d) (vary-meta (if-let [t (:inactive d)] (list 'c/directive t) (directive-form d))
                                                                         assoc :line (line-of (:off d)))])))))
    placed))

;; ---------------------------------------------------------------------------------------------
;; The groups of tokens a macro invocation made (§9.4)

(defn- group-text
  "An invocation's text: its tokens as line-text joins them, but a directive line among its arguments
  (#if, #else, #endif inside the parentheses) on a line of its own, as the source has it, so the print
  reads back: the tokens of one directive line, dline's key of a token's offset, kept apart from the
  others by new-lines."
  ^String [toks dline]
  (let [b (StringBuilder.)]
    (loop [ts (seq toks) first? true prev nil]
      (when-let [^Tok t (first ts)]
        (let [k (dline (.-po t))]
          (cond
            first? nil
            (and (not= k prev) (or k prev)) (.append b "\n")
            (pos? (.length ^String (.-sep t))) (.append b " "))
          (.append b (.-src t))
          (recur (next ts) false k))))
    (utf8-decode (str b))))

(defn- conditionals-closed?
  "Queue 371: the directive lines among an invocation's tokens (`toks`, dline's keys) make whole conditional families: each
  #if, #ifdef or #ifndef closed by its #endif inside them, no #elif, #else or #endif of a family begun outside."
  [toks dline]
  (loop [ts (seq toks) prev nil depth 0]
    (if-let [^Tok t (first ts)]
      (let [k (dline (.-po t))]
        (if (and k (not= k prev) (= (.-ch t) \#))
          (let [v (some-> ^Tok (second ts) .-src)
                depth (case v
                        ("if" "ifdef" "ifndef") (inc depth)
                        ("elif" "elifdef" "elifndef" "else") (if (pos? depth) depth -1)
                        "endif" (dec depth)
                        depth)]
            (if (neg? depth) false (recur (next ts) k depth)))
          (recur (next ts) k depth)))
      (zero? depth))))

(defn- macro-directives!
  "378 item 2: refuses the file (:macro-directive) when an executed directive among an invocation's arguments that is not a
  conditional family's line (place-directives!'s (cx :span-dirs): `#define N 3` inside `f(1` / ... / `)`) lies in no invocation
  printed as its text (claimed): the expansion printed in its place would leave it out, and moving it before the expansion
  is not exact (an invocation before it in the same item, printed as its text, would read it). Not ci's read, which prints
  nothing."
  []
  (when-not *include-inside*
    (let [^java.util.TreeMap spans (cx :macro-spans) ^HashSet claimed (cx :claimed)]
      (doseq [off (cx :span-dirs)]
        (when-not (some (fn [[a v]] (and (<= (long a) (long off)) (< (long off) (long (:to v))) (.contains claimed (:seq v)))) spans)
          (refuse :macro-directive "a directive among a macro invocation's arguments, the invocation printed expanded"))))))

(defn- struct-bodies
  "Queue 540c: the main file's struct and union member lists, a TreeMap from each list's first offset to its end: a directive
  there is inside an item, which the print does not keep (place-directives!)."
  [root]
  (let [m (java.util.TreeMap.) stack (java.util.ArrayDeque.)]
    (when root (.push stack root))
    (loop []
      (when-not (.isEmpty stack)
        (let [x (.pop stack)]
          (when (instance? HashMap x)
            (when (= (nt x) "StructOrUnionSpecifier")
              (when-let [l (g x :StructDeclarationList)]
                (let [a (min-po l) e (max-end l)]
                  (when (< a e)
                    (let [prev (.get m (Long/valueOf a))]
                      (.put m (Long/valueOf a) (Long/valueOf (max e (long (or prev 0))))))))))
            (doseq [c (children x)] (when (instance? HashMap c) (.push stack c)))))
        (recur)))
    m))

(defn- dropped-define?
  "Queue 540c: the main file's last #define of `nm` before offset `po` stands inside a struct or union member list (`bodies`,
  struct-bodies), so the print does not keep it: sqlite3.c's `#define BTCURSOR_FIRST_UNINIT pBt` inside struct BtCursor."
  [^java.util.TreeMap bodies ^String nm ^long po]
  (when-let [^java.util.TreeMap t (some-> ^HashMap (cx :fn-macros) (.get nm))]
    (when-let [e (.lowerEntry t (Long/valueOf po))]
      (let [d (long (.getKey e))]
        (when-let [b (.floorEntry bodies (Long/valueOf d))]
          (< d (long (.getValue b))))))))

(defn- compute-groups!
  "The invocations' token groups of the main file: (cx :groups) maps a group's first sequence number to
  {:max last-seq :text invocation-text}. Queue 371: an invocation whose arguments hold a directive line (#if ... #endif inside
  the parentheses) has its extent in (cx :macro-spans), from its name's offset to its end, the directives inside it the
  invocation's (place-directives! leaves them to its text); its text keeps each such line on a line of its own (group-text),
  and an invocation whose directives do not make whole conditional families (mac-dir-1.c's `f (` / `#if f(1)` / `0))` /
  `#else` / `1))` / `#endif`, the family ending after the invocation) makes no group: it is printed expanded."
  [all-toks bodies]
  (let [^bytes src (cx :main-bytes)
        n (alength src)
        src-at (fn [^long po ^String s]
                 (and (<= (+ po (count s)) n)
                      (loop [i 0] (or (= i (count s)) (and (= (bit-and (aget src (int (+ po i))) 0xff) (int (.charAt s i))) (recur (inc i)))))))
        [sts _] (lex/tokens (lex/new-file "m" src))
        sts (vec (remove #(= (.-ch ^Tok %) \newline) sts))
        starts (long-array (map #(.-po ^Tok %) sts))
        ;; an invocation on a directive's line (an #embed's if_empty, prefix or suffix: embed-1.c's XIFEMPTY3, defined inside the
        ;; initializer, whose #define the print does not keep) is printed expanded
        dls (let [m (java.util.TreeMap.)] (doseq [d (directive-lines)] (.put m (Long/valueOf (long (:off d))) (Long/valueOf (long (or (:end d) n))))) m)
        on-directive? (fn [^long po] (when-let [e (.floorEntry ^java.util.TreeMap dls (Long/valueOf po))] (< po (long (.getValue e)))))
        ;; the directive line a token is on (its offset), nil off one
        dline (fn [^long po] (when-let [e (.floorEntry ^java.util.TreeMap dls (Long/valueOf po))] (when (< po (long (.getValue e))) (.getKey e))))
        groups (HashMap.)
        ts (vec all-toks)
        cnt (count ts)]
    (loop [i 0]
      (when (< i cnt)
        (let [^PTok t (ts i)
              po (.-po t)
              j (loop [j (inc i)] (if (and (< j cnt) (= (.-po ^PTok (ts j)) po)) (recur (inc j)) j))
              k (- j i)]
          (when (and (or (> k 1) (not (src-at po (.-src t))))
                     ;; an expansion holding __COUNTER__'s value is printed expanded: the invocation would count again
                     (not (some (fn [x] (when-let [m (.-m ^PTok x)] (= "__COUNTER__" (.-src ^Tok (:name m)))))
                                (subvec ts i j))))
            (let [q (if (< j cnt) (.-po ^PTok (ts j)) n)
                  si (java.util.Arrays/binarySearch starts po)]
              (when (and (>= si 0) (= (.-ch ^Tok (sts si)) :IDENTIFIER) (not (on-directive? po)))
                (let [nxt (inc si)
                      end (if (and (< nxt (count sts)) (= (.-ch ^Tok (sts nxt)) \() (< (.-po ^Tok (sts nxt)) q))
                            (loop [m nxt depth 0]
                              (cond
                                (>= m (count sts)) nil
                                (= (.-ch ^Tok (sts m)) \() (recur (inc m) (inc depth))
                                (= (.-ch ^Tok (sts m)) \)) (if (= depth 1) m (recur (inc m) (dec depth)))
                                :else (recur (inc m) depth)))
                            si)]
                  (when (and end (or (= end si) (< (.-po ^Tok (sts end)) q)))
                    ;; the source's tokens after the invocation and before the next token of the tree were taken by an
                    ;; invocation its expansion began (c23-digit-separators-1.c: `bcat (0'\u00c0'))`, bcat's `c0 (` closed by the
                    ;; second `)`): the text runs to them when they are closing parentheses alone (an #embed's if_empty around an
                    ;; invocation, embed-1.c's `XIFEMPTY3) prefix (...)`, is not one)
                    (let [end2 (loop [m (inc end)] (if (and (< m (count sts)) (< (.-po ^Tok (sts m)) q)) (recur (inc m)) (dec m)))
                          ;; closing parentheses alone, or one balanced parenthesized list (64_macro_nesting.c's `CAT(A,B)(x)`,
                          ;; AB's arguments)
                          between (map #(.-ch ^Tok (sts %)) (range (inc end) (inc end2)))
                          balanced? (and (= \( (first between))
                                         (= 0 (reduce (fn [d c] (cond (neg? d) (reduced -1) (= c \() (inc d) (= c \)) (dec d) :else d))
                                                      0 between))
                                         (not-any? #{\#} between))
                          end (if (and (> end2 end) (or (every? #{\)} between) balanced?)) end2 end)]
                      (let [toks (subvec sts si (inc end))
                            ^Tok lt (sts end)
                            dirs? (some #(dline (.-po ^Tok %)) toks)
                            ;; queue 540: an expansion holding __LINE__'s value is printed as its invocation after `#line N
                            ;; /*arbace*/`, N the invocation's line (its presumed line: the reread of the print gives the same N),
                            ;; so that __LINE__ gives the original's line again (gcc -O0 gives every token of the expansion the
                            ;; invocation's place, as the original's: unicode_gen.c's last `assert(0);`), when the invocation
                            ;; stands on one line (gcc's __LINE__ of an invocation over several lines is not the port's); else it
                            ;; is printed expanded, as before. The reread drops the directive (place-directives!)
                            line? (some (fn [x] (when-let [m (.-m ^PTok x)] (= "__LINE__" (.-src ^Tok (:name m))))) (subvec ts i j))
                            ^CFile mf (cx :main-file)
                            ln (when line? (nth (lex/position mf (.-po ^Tok (sts si))) 1))]
                        (when dirs?
                          (.put ^java.util.TreeMap (cx :macro-spans) (Long/valueOf po) {:to (+ (.-po lt) (count (.-src lt))) :seq (.-seq t)}))
                        (when (and (or (not dirs?) (conditionals-closed? toks dline))
                                   (or (not line?) (and (not dirs?) (= ln (nth (lex/position mf (.-po lt)) 1))))
                                   ;; queue 540c: a name of the invocation whose #define the print drops (one inside a struct's
                                   ;; member list) would not expand in the print: the invocation is printed expanded
                                   (not (some (fn [^Tok x] (and (= (.-ch x) :IDENTIFIER) (dropped-define? bodies (.-src x) po))) toks)))
                          (.put groups (.-seq t) {:max (.-seq ^PTok (ts (dec j)))
                                                  ;; the next token's (CS82 (b): a run of groups over a concatenated literal)
                                                  :next (when (< j cnt) (.-seq ^PTok (ts j)))
                                                  :text (str (when line? (str "\n#line " ln " /*arbace*/\n")) (group-text toks dline))})))))))))
          (recur j))))
    groups))

;; ---------------------------------------------------------------------------------------------
;; The translation unit

(defn- tu-tokens
  "The main file's tokens of the tree, in order, each once (cc's __func__ tokens and a label's
  synthesized ; left out)."
  [root]
  (let [seen (HashSet.) out (ArrayList.) stack (java.util.ArrayDeque.)]
    (.push stack root)
    (loop []
      (when-not (.isEmpty stack)
        (let [x (.pop stack)]
          (cond
            (instance? PTok x) (when (and (main-tok? x) (.add seen (.-seq ^PTok x)))
                                 (.add out x)
                                 ;; CS82 (b): a concatenated string literal's other pieces, the macro groups' tokens too
                                 (doseq [^PTok p (.get ^java.util.Map (cx :piece-toks) x)]
                                   (when (and (main-tok? p) (.add seen (.-seq p))) (.add out p))))
            (instance? HashMap x)
            (if (and (= (nt x) "CompoundStatement") (g x :Token))
              (let [lb (g x :Token)]
                (.push stack (g x :Token2))
                (doseq [bi (map #(g % :BlockItem) (chain (g x :BlockItemList) :BlockItemList))
                        :when (not (func-injected? bi lb))]
                  (.push stack bi))
                (.push stack lb))
              (doseq [c (children x)] (.push stack c)))))
        (recur)))
    (vec (sort-by #(.-seq ^PTok %) out))))

(defn entry-at
  "queue 157 (review 130's finding 4): the entry a token of seq `sq` came from, by the parser's `entries` ([[seq entry] ...] in seq
  order, each the first token of a run in one entry): the index in the layer of its file's enter record, nil for the main file's."
  [entries sq]
  (let [v entries]
    (loop [lo 0 hi (dec (count v)) r nil]
      (if (> lo hi)
        r
        (let [mid (quot (+ lo hi) 2) [s e] (nth v mid)]
          (if (<= (long s) (long sq)) (recur (inc mid) hi e) (recur lo (dec mid) r)))))))

(defn entry-root
  "queue 157: the main file's #include an entry (an index in `layer`) descends from, by its enter records' :in, its offset, or nil."
  [layer idx]
  (loop [i idx n 0]
    (when (and i (< n 64))
      (let [e (nth layer i)]
        (if (nil? (:in e)) (:off e) (recur (:in e) (inc n)))))))

(defn- item-file [n] (when-let [t (first (node-tokens n))] (when-let [^CFile f (.-pf ^PTok t)] (.-name f))))
(defn- item-off [n] (when-let [t (first (node-tokens n))] (.-po ^PTok t)))
(defn- item-seq [n] (when-let [t (first (node-tokens n))] (.-seq ^PTok t)))

(defn sys-changes
  "queue 136 (review 130's findings 2, 3): the preprocessor's system status changes (its layer's {:directive \"system\"}
  records: a `#pragma GCC system_header`, a linemarker) by entry (queue 157: the index of the file's enter record, as each entry
  of a file entered twice executes its own), {entry [[off system?] ...]} in offset order, the first record at an offset kept."
  [layer]
  (into {} (for [[p m] (reduce (fn [m e]
                                 (if (= (:directive e) "system")
                                   (update m (:entry e) (fn [o] (let [o (or o (sorted-map))]
                                                                 (if (contains? o (:off e)) o (assoc o (:off e) (boolean (:system e)))))))
                                   m))
                               {} layer)]
             [p (vec m)])))

(defn sys-at
  "queue 136 (review 130's findings 2, 3): a header form's system status: `base` (its entry's) as the preprocessor's changes `cs`
  of its entry ([[off system?] ...] in offset order: a `#pragma GCC system_header`, a linemarker) before the form's offset `off`
  leave it (libcpp: a pragma or a linemarker changes the status from the next line on)."
  [base cs off]
  (if (and off (seq cs))
    (reduce (fn [s [co cv]] (if (< (long co) (long off)) cv s)) base cs)
    base))

(defn sha16 ^String [^String s]
  (let [d (.digest (java.security.MessageDigest/getInstance "SHA-256") (.getBytes s "UTF-8"))]
    (apply str (map #(format "%02x" (bit-and (long %) 0xff)) (take 8 d)))))


(defn external
  "An ExternalDeclaration's forms."
  [ed]
  (case (cs ed)
    :ExternalDeclarationFuncDef
    (let [fd (g ed :FunctionDefinition)
          t (group-of fd)
          f (try (function-definition (g fd :DeclarationSpecifiers) (g fd :Declarator) (g fd :DeclarationList) (g fd :CompoundStatement)
                                      (attrs (g fd :AttributeSpecifierList)) fd)
                 (catch arbace.lang.ExceptionInfo e
                   (if (and *soft-errors* (:c/soft (ex-data e)))
                     (do (.add ^ArrayList *soft-errors* (ex-message e)) nil)
                     (throw e))))]
      ;; a definition one invocation made whole is printed as the invocation (gcc -O0 places a nop at a body's
      ;; end whose brace is on another line than its last statement: the expansion's tokens share one place)
      (cond (nil? f) [] t [(addm f {:c/macro-stmt t})] :else [f]))
    :ExternalDeclarationDecl
    (let [d (g ed :Declaration)
          t (group-of d)
          fs (mapv #(at d %) (declaration d))]
      (if (and t (= 1 (count fs))) [(addm (first fs) {:c/macro-stmt t})] fs))
    :ExternalDeclarationAsmStmt [(at ed (asm-form (g (g ed :AsmStatement) :Asm)))]
    :ExternalDeclarationEmpty []
    (refuse :declaration (str "external declaration " (cs ed)) ed)))


(defn- included-inside?
  "Queue 178: whether every token of the declaration `n` from another file than the main one comes from a file the main
  file includes inside the declaration's extent (or one such a file includes): a table an initializer or a member list
  includes, musl's src/errno/strerror.c including __strerror.h three times, ctype's punct.h, locale's codepages.h. The
  declaration is the main file's then, its header tokens' nodes with no line of their own (pos-of); a declaration a
  header begins or ends stays refused (:split-declaration)."
  [layer ^String main-name n]
  (let [lo (min-po n) hi (max-end n)
        enters (filter #(= "enter" (:directive %)) layer)
        direct (set (keep #(when (and (= main-name (:from %)) (<= lo (long (:off %)) hi)) (:path %)) enters))
        inside (loop [s direct]
                 (let [s2 (into s (keep #(when (contains? s (:from %)) (:path %)) enters))]
                   (if (= s2 s) s (recur s2))))]
    (and (seq inside)
         (every? (fn [t] (let [^CFile f (.-pf ^PTok t)]
                           (or (nil? f) (identical? f (cx :main-file)) (contains? inside (.-name f))
                               ;; the main file entered again (pp's *reentry*: MAIN#again), included inside the declaration
                               (and (= (.-name f) (str main-name "#again")) (contains? inside main-name)))))
                 (filter #(instance? PTok %) (node-tokens n))))))

(defn convert
  "The forms of a parse `r` ({:tree :layer}, arbace.repr.c.parse) of the main file `main-name` (its bytes
  `main-bytes`) read at the standard `std` (a keyword): {:forms [the main unit's forms], :units {ns
  {:header raw :path p :forms [...]}}, :items [...]} (the main file's items with their extents, for
  :full), or {:refused class :message m}."
  [r ^String main-name ^bytes main-bytes std opts]
  (try
    (let [tree (:tree r)
          eds (map #(g % :ExternalDeclaration) (chain tree :TranslationUnit))
          ranges (IdentityHashMap.)
          main-file (some (fn [ed] (some (fn [t] (when (and (instance? PTok t) (.-pf ^PTok t) (= (.-name ^CFile (.-pf ^PTok t)) main-name)) (.-pf ^PTok t)))
                                         (node-tokens ed)))
                          eds)
          unit-of-off (HashMap.)]
      ;; CS275 (b): ci's read (*include-inside*) takes the re-entered main file as a file of its own (the preprocessor gives it
      ;; a CFile of its own); the text levels keep the refusal
      (when (and (not *include-inside*) (not arbace.repr.c.pp/*reentry*)
                 (some #(and (= (:directive %) "enter") (= (:path %) main-name)) (:layer r)))
        (refuse :self-include "the main file includes itself: its tokens are the main file's twice"))
      (binding [*cx* {:ranges ranges :main-file main-file :main-name main-name :main-bytes main-bytes :std std
                      :pieces parse/strlit-pieces :piece-toks parse/strlit-toks
                      :fn-macros (macro-table (:layer r) main-name) :typedefs (atom {}) :claimed (HashSet.)
                      ;; queue 371: the main file's extents of the invocations whose arguments hold a directive line (compute-groups!)
                      :macro-spans (java.util.TreeMap.) :span-dirs (ArrayList.)
                      :unit-of-off unit-of-off :line-starts (line-starts main-bytes) :elems (IdentityHashMap.) :list-items (IdentityHashMap.) :dir-lines (atom nil)
                      ;; CS290 (a): the re-entered copy's pragmas, [seq [text ...]] in seq order (the parser's :pragmas), placed by
                      ;; block-items before the item of the first token after them (ci's read)
                      ;; CS299 (a): a TreeMap seq -> [[text entry] ...], every included file's pragmas (pp's PRAGMAS), taken by range
                      :pragmas (let [m (java.util.TreeMap.)]
                                 (doseq [[sq ps] (:pragmas r)]
                                   (.put m (Long/valueOf (long sq)) (into (or (.get m (Long/valueOf (long sq))) []) ps)))
                                 m)}]
        (compute-ranges! ranges tree)
        (let [groups (when main-file (compute-groups! (tu-tokens tree) (struct-bodies tree)))
              eds (vec (remove #(contains? #{"<builtin>" "<predefined>"} (item-file %)) eds))
              ;; CS275 (a): a declaration whose other files' tokens all come from files it includes inside it is the main file's
              ;; when each such #include stands between the items of a statement list (the print writes it there, the
              ;; included items left to it: block-items), or since CS329 (a) between the elements of an initializer or an
              ;; enumerator list (list-with-dirs); judged once the directives are placed (split-later)
              split-later (ArrayList.)
              _ (doseq [ed eds]
                  (when (and (has-other? ed) (has-main? ed))
                    (cond
                      (not (included-inside? (:layer r) main-name ed))
                      (refuse :split-declaration "a declaration that begins in one file and ends in another" ed)
                      *include-inside* nil
                      :else (.add split-later ed))))
              main-eds (vec (filter has-main? eds))
              ;; header units first (their typedefs are the main file's too): each main-file include's
              ;; items, by the include that brought their file in
              hforms (java.util.LinkedHashMap.)
              ;; queue 157 (review 130's finding 4): each of a unit's forms' system status, as the checker judges it: its entry's (the
              ;; enter record of the entry its first token came from, the parser's :entries; a nested header's its own, review 110's
              ;; finding 1), as the pp's changes in that entry before the form's offset leave it (a pragma, a linemarker: queue 136,
              ;; review 130's findings 2, 3). Each entry of a header entered twice is judged by its own status, its forms in the unit of
              ;; the main file's #include it descends from
              hsys (java.util.HashMap.)
              layer (vec (:layer r))
              entries (vec (:entries r))
              chg (sys-changes layer)
              ;; each header's first enter record (a form whose first token is not its entry's file's, a macro's from another file:
              ;; judged by its file's first entry, as before)
              first-entry (reduce (fn [m [i e]] (if (or (not= (:directive e) "enter") (contains? m (:path e))) m (assoc m (:path e) i)))
                                  {} (map-indexed vector layer))
              units (java.util.LinkedHashMap.)
              ;; CS299 (a): the included files' pragmas at file scope (between the items, before the first, after the last; ci's read):
              ;; each a c/pragma form of the unit of its own entry, in the stream's order among the unit's forms (the checker runs a
              ;; unit at its #include, so a header's #pragma pack lays out its records and the main file's after it, as gcc's)
              fpq (java.util.ArrayDeque.
                    ^java.util.Collection
                    (if *include-inside*
                      (let [out (ArrayList.)]
                        (loop [prev Long/MIN_VALUE es (seq eds)]
                          (if es
                            (let [r (rng (first es))]
                              (if (= Long/MAX_VALUE (aget r 0))
                                (recur prev (next es))
                                (do (.addAll out (take-pragmas! prev (aget r 0))) (recur (max prev (aget r 1)) (next es)))))
                            (.addAll out (take-pragmas! prev Long/MAX_VALUE))))
                        (vec out))
                      []))
              flush-fpq! (fn [^long upto]
                           (loop []
                             (when-let [[sq t e] (.peekFirst fpq)]
                               (when (<= (long sq) upto)
                                 (.pollFirst fpq)
                                 (when-let [off (when e (entry-root layer e))]
                                   (let [^ArrayList a (or (.get hforms off) (let [a (ArrayList.)] (.put hforms off a) a))
                                         ^ArrayList asys (or (.get hsys off) (let [a (ArrayList.)] (.put hsys off a) a))]
                                     (.add a (list 'c/pragma t))
                                     (.add asys (boolean (:system (nth layer e))))))
                                 (recur)))))]
          (doseq [ed eds :when (not (has-main? ed))]
            (when-not (= Long/MAX_VALUE (aget (rng ed) 0)) (flush-fpq! (aget (rng ed) 0)))
            (let [file (item-file ed)
                  ;; the main file entered again (pp's *reentry*) is entered by the path it was included by
                  file (if (and file (= file (str main-name "#again"))) main-name file)
                  e (when-let [sq (item-seq ed)] (entry-at entries sq))
                  e (if (and e (= (:path (nth layer e)) file)) e (get first-entry file))]
              (when-let [off (when e (entry-root layer e))]
                (let [^ArrayList a (or (.get hforms off) (let [a (ArrayList.)] (.put hforms off a) a))
                      ^ArrayList asys (or (.get hsys off) (let [a (ArrayList.)] (.put hsys off a) a))
                      sys (sys-at (boolean (:system (nth layer e))) (get chg e) (item-off ed))
                      fs (external ed)]
                  (.addAll a fs)
                  (doseq [_ fs] (.add asys sys))))))
          (flush-fpq! Long/MAX_VALUE)
          (doseq [e (:layer r) :when (and (= (:directive e) "enter") (= (:from e) main-name))]
            (let [fs (vec (or (.get hforms (:off e)) []))
                  fsys (vec (or (.get hsys (:off e)) []))
                  text (str/join "\n" (map #(binding [*print-meta* true] (pr-str %)) fs))
                  ns (str "c.h." (sha16 text))
                  ;; queue 157: an include whose forms an earlier include's unit already has (an unguarded header entered twice) is a
                  ;; unit of its own, checked at its own #include with its own statuses (gcc judges each entry); its name hashed with
                  ;; its rank among them (the first keeps the name of its forms alone, as every unit whose forms no other unit has)
                  ns (if (seq fs)
                       (loop [k 1 n ns] (if (.containsKey units n) (recur (inc k) (str "c.h." (sha16 (str text "\n#" k)))) n))
                       ns)]
              (.put unit-of-off (:off e) ns)
              (.put units ns {:header (:raw e) :path (:path e) :system (boolean (:system e)) :forms fs :form-sys fsys})))
          (binding [*cx* (assoc *cx* :groups groups)]
            (let [placed (place-directives! main-eds (:layer r))
                  placed-offs (set (for [^HashMap m (vals placed) [_ ds] m [off _] ds] off))
                  _ (doseq [ed split-later
                            :let [lo (min-po ed) hi (max-end ed)]
                            e (:layer r)
                            :when (and (= "enter" (:directive e)) (= main-name (:from e)) (<= lo (long (:off e)) hi))]
                      (when-not (contains? placed-offs (:off e))
                        (refuse :split-declaration "a declaration that begins in one file and ends in another" ed)))]
              (binding [*cx* (assoc *cx* :placed placed
                                    ;; D342-1 (a): the offsets of the main file's #include lines placed between a list's elements
                                    ;; or a body's items (straddles?)
                                    :placed-incs (let [t (java.util.TreeSet.)]
                                                   (doseq [e (:layer r)
                                                           :when (and (= "enter" (:directive e)) (= main-name (:from e)) (:off e)
                                                                      (contains? placed-offs (:off e)))]
                                                     (.add t (Long/valueOf (long (:off e)))))
                                                   t))]
                (let [out (ArrayList.)
                      items (ArrayList.)
                      ;; CS274 (a): consecutive items one invocation made whole (their tokens exactly the invocation's, no
                      ;; directive between them): the first form printed as the invocation (:c/macro-stmt), the others not
                      ;; printed (:c/macro-part); one item alone is external's (C3b.1)
                      multi (HashMap.) ; index of the first item -> [text index of the last]
                      _ (when groups
                          (loop [i 0]
                            (when (< i (count main-eds))
                              (let [ed (nth main-eds i)
                                    r (rng ed)
                                    gr (when (and (has-main? ed) (not (has-other? ed))) (.get ^HashMap groups (aget r 0)))
                                    j (when (and gr (< (aget r 1) (long (:max gr))))
                                        (loop [j (inc i)]
                                          (when (< j (count main-eds))
                                            (let [e2 (nth main-eds j) r2 (rng e2)]
                                              (cond
                                                (or (not (has-main? e2)) (has-other? e2) (seq (placed-at :top j))) nil
                                                (= (aget r2 1) (long (:max gr))) j
                                                (< (aget r2 1) (long (:max gr))) (recur (inc j))
                                                :else nil)))))]
                                (if j
                                  (do (.put multi i [(:text gr) j]) (.add ^HashSet (cx :claimed) (aget r 0)) (recur (inc j)))
                                  (recur (inc i)))))))
                      part-until (atom -1)]
                  (doseq [[i ed] (map-indexed vector main-eds)]
                    (doseq [[off df] (placed-at :top i)] (.add out df) (.add items [off df]))
                    (let [fs (external ed)
                          fs (cond
                               (.containsKey multi i)
                               (let [[t j] (.get multi i)]
                                 (reset! part-until j)
                                 (vec (cons (addm (first fs) {:c/macro-stmt t}) (map #(addm % {:c/macro-part true}) (rest fs)))))
                               (<= i (long @part-until)) (mapv #(addm % {:c/macro-part true}) fs)
                               :else fs)]
                      (doseq [f fs] (.add out f))
                      (when (seq fs) (.add items [(min-po ed) (first fs)]))))
                  (doseq [[off df] (placed-at :top (count main-eds))] (.add out df) (.add items [off df]))
                  (macro-directives!)
                  {:forms (vec out) :units (into {} units) :items (vec items)})))))))
    (catch arbace.lang.ExceptionInfo e
      (cond
        (:c/refuse (ex-data e)) {:refused (:c/refuse (ex-data e)) :message (ex-message e)}
        ;; a constraint the parse does not check, the read's error as the parser's (an error test's)
        (:c/error (ex-data e)) {:error [(ex-message e)]}
        :else (throw e)))))

(ns arbace.repr.java
  "Command line of repr/java, Java's bridge: the Java -> Java forms converter (its read). See
  doc/classes/CONVERTER-NOTES.md.

  bin/repr-java read [options] OUT ROOT [PATH...]
    Converts the .java files under ROOT (or only those under the PATHs, relative to ROOT or
    absolute) into class-form files under OUT, one namespace per package. ROOT is also
    javac's source path.
    Options:
      --rename FROM=TO   rename the package prefix FROM to TO (e.g. clojure=arbace)
      --javac OPT        pass an option to javac (repeatable)
      --check            also check that every output reads with arbace.core/read and
                         arbace.edn/read, and write a coverage report to OUT/repr-java-report.edn
      --full             mode :full: the forms also record the Java text, for print to give
                         every file back byte for byte (arbace.repr.java.full)
      --origins FILE     the names the files' headers give their sources ({path name}, the
                         paths relative to ROOT), not the files' own paths
      --front F          the tree the converter reads (arbace.repr.java.tree): javac (the
                         default), javac's attributed trees; native, the native parser's trees
                         (arbace.repr.java.parse) of the same text, javac's attribution answered
                         by position (arbace.repr.java.attr); both, javac's into OUT and the
                         native ones into --native-out DIR (default OUT.native), attributed once
      --native-out DIR   with --front both, where the native trees' forms go
      --split            measure the split (doc/classes/JAVA-FRONTEND-SURVEY.md, \"As built:
                         JFS66 (b)\"): the attribution facts the converter asks and what each
                         output list needed, into OUT/repr-java-split.edn (of the native
                         conversion when there is one)

  bin/repr-java read-jdk [options] OUT MODULE SRC [PATH...]
    The same for a module of the JDK itself (java.base: jdk/, bin/jrt-convert), attributed with
    --patch-module against the platform; --origins FILE names the files' origins (the paths
    relative to SRC)."
  (:require [arbace.repr.java.javac :as javac]
            [arbace.repr.java.convert :as cv]
            [arbace.repr.java.jtypes :as jt]
            [arbace.repr.java.names :as names]
            [arbace.repr.java.layout :as pr]
            [arbace.repr.java.full :as full]
            [arbace.repr.java.parse :as parse]
            [arbace.repr.java.attr :as attr]
            [arbace.edn :as edn]
            [arbace.java.io :as io]
            [arbace.pprint :as pp]
            [arbace.string :as str])
  (:import [java.io File PushbackReader StringReader]))

(defn java-files [paths]
  (sort (for [p paths
              ^File f (file-seq (io/file p))
              :when (and (.isFile f) (str/ends-with? (.getName f) ".java"))]
          (.getPath f))))

(defn rename-fn
  "A function renaming binary/package names by the prefix map {from to}."
  [m]
  (if (empty? m)
    identity
    (fn [^String s]
      (or (some (fn [[from to]]
                  (cond
                    (= s from) to
                    (str/starts-with? s (str from ".")) (str to (subs s (count from)))))
                m)
          s))))

(defn read-all [read-fn text]
  (let [r (PushbackReader. (StringReader. text))
        eof (Object.)]
    (loop [n 0]
      (let [f (read-fn r eof)]
        (if (identical? f eof) n (recur (inc n)))))))

(defn read-forms
  "The forms of `text`, read with arbace.core/read."
  [text]
  (let [r (PushbackReader. (StringReader. text))
        eof (Object.)]
    (loop [acc []]
      (let [f (read r false eof)]
        (if (identical? f eof) acc (recur (conj acc f)))))))

(defn- read-error [f text]
  (try (f text) nil
       (catch Throwable e (str (.getMessage e) (some->> (.getCause e) .getMessage (str ": "))))))

(defn readable
  "{:core err :edn err}: nil errors when arbace.core/read and arbace.edn/read read `text`."
  [text]
  {:core (read-error (fn [t] (binding [*read-eval* false] (read-all #(read %1 false %2) t))) text)
   :edn (read-error (fn [t] (read-all #(edn/read {:eof %2 :default (fn [t v] v)} %1) t)) text)})

(def ^:dynamic *full* "Mode :full (--full)." false)

(defn- convert-one
  "Convert javac's attributed unit `cu`, its own tree or (native?) the native parser's tree of its
  text with attribution by position; measured with `split?`. A unit, or a failure."
  [^com.sun.tools.javac.tree.JCTree$JCCompilationUnit cu full native? split? stats]
  (let [src (.getName (.getSourceFile cu))]
    (try
      (let [t0 (System/nanoTime)
            opts (if native?
                   (let [n (parse/parse (javac/source-text cu) src)
                         idx (attr/index n cu)]
                     (swap! stats #(-> % (update :index/nodes (fnil + 0) (:nodes idx))
                                       (update :index/misses (fnil + 0) (count (:misses idx)))
                                       (update :index/synthetic (fnil + 0) (:synthetic idx))
                                       (update :index/flags-completed (fnil + 0) (:flags idx))
                                       (update :index/dropped (fnil + 0) (count (:dropped idx)))))
                     (when (seq (:misses idx))
                       (throw (ex-info (str "native tree: " (count (:misses idx)) " nodes without a javac node, the first "
                                            (first (:misses idx)))
                                       {})))
                     {:full full :tree n :index idx})
                   {:full full})
            u (binding [attr/*measure* split?
                        attr/*counts* (when split? stats)]
                (cv/convert-unit cu opts))]
        (assoc u :source src :ms (quot (- (System/nanoTime) t0) 1000000)))
      (catch Throwable e
        {:failure true :source src
         :error (str (.getName (class e)) ": " (.getMessage e))
         :trace (vec (take 12 (filter #(re-find #"arbace" %) (map str (.getStackTrace e)))))}))))

(defn convert-units
  "Analyze the Java `files` with javac options `opts` and convert every compilation unit (in mode
  :full with `full`; `front` :javac, :native or :both, the trees the converter reads; measured with
  `split`). Returns {:units [...] :failures [...] :errors [...] :stats {...}}, with :both also
  :native, the same of the native trees."
  [files opts rename & [full front split]]
  (let [front (or front :javac)
        {:keys [units context errors]} (javac/analyze files opts)
        stats (atom {})
        nstats (atom {})]
    (binding [jt/*types* (javac/types context)
              jt/*syms* (javac/symtab context)
              jt/*check* (com.sun.tools.javac.comp.Check/instance context)
              jt/*names* (com.sun.tools.javac.util.Names/instance context)
              jt/*rename* (rename-fn rename)]
      (let [run (fn [native? split? st]
                  (binding [cv/*stats* st]
                    (let [results (doall (for [cu units] (convert-one cu full native? split? st)))]
                      {:units (vec (remove :failure results))
                       :failures (vec (filter :failure results))
                       :errors errors
                       :stats @st})))]
        (case front
          :javac (run false split stats)
          :native (run true split stats)
          :both (assoc (run false false stats) :native (run true split nstats)))))))

(defn- out-file-name
  "The output file name for unit `u`: the Java file's base name, with _class appended when the
  source directory has a .clj or .ae file of that name (clojure/main.java and clojure/main.clj)."
  [{:keys [source file]}]
  (let [base (str/replace file #"\.java$" "")
        dir (.getParentFile (io/file source))]
    (if (some #(.exists (io/file dir (str base %))) [".clj" ".ae"]) (str base "_class") base)))

(defn write-output
  "Write the converted `units` under directory `out`. Returns [{:path p :text t}]."
  [out units]
  (vec
   (for [[pkg us] (group-by :package units)
         :let [table (names/naming pkg us)
               ordered (names/topo-order us)
               pkg-path (str/replace pkg "." "/")
               last-seg (last (str/split pkg #"\."))
               files (for [u ordered]
                       (let [nm (out-file-name u)
                             text (names/unit-text table pkg u)
                             text (if *full*
                                    (full/record-hashes text #(binding [*read-eval* false] (read-forms %)))
                                    text)
                             path (str (if (seq pkg) (str pkg-path "/") "") nm ".ae")]
                         {:path path :text text :load (str last-seg "/" nm)}))]
         f (concat files
                   (when (seq pkg)
                     [{:path (str pkg-path ".ae")
                       :text (names/package-text pkg (map :load files))}]))]
     (let [o (io/file out (:path f))]
       (io/make-parents o)
       (spit o (:text f))
       f))))

(defn head-symbols
  "Counts of the heads of lists and the metadata keywords used in the forms of `units`."
  [units]
  (let [counts (volatile! {})]
    (letfn [(bump [k] (vswap! counts update k (fnil inc 0)))
            (walk [x]
              (when (instance? arbace.lang.IObj x)
                (doseq [it (arbace.repr.java.forms/items x)]
                  (if (keyword? it) (bump (str "^:" (name it))) (bump (str "^" (name (first it)))))))
              (cond
                (and (seq? x) (= 'switch (first x)))
                (let [[_ sel & arms] x]
                  (bump "switch")
                  (walk sel)
                  ;; labels are constants or patterns, not calls
                  (doseq [[l r :as p] (partition-all 2 arms)]
                    (if (= 1 (count p)) (walk l) (do (when (vector? l) (run! walk l)) (walk r)))))
                (seq? x) (do (when-let [hd (first x)]
                               (bump (cond
                                       (instance? arbace.repr.java.forms.CRef hd)
                                       (case (:member hd) "." "(Class. ...)" "new" "(Class/new ...)"
                                             (if (str/starts-with? (str (:member hd)) ".") "(Class/.method ...)" "(Class/static ...)"))
                                       (not (symbol? hd)) "(non-symbol head)"
                                       (str/starts-with? (name hd) ".-") "(.-field ...)"
                                       (and (str/starts-with? (name hd) ".") (not (#{"." ".." ".new" ".super"} (name hd)))) "(.method ...)"
                                       (and (namespace hd) (not (#{"clojure.core" "arbace.core"} (namespace hd)))) "(Class/static ...)"
                                       (str/ends-with? (name hd) ".") (if (#{"this." "super."} (name hd)) (name hd) "(Class. ...)")
                                       :else (name hd))))
                             (run! walk x))
                (map? x) (doseq [[k v] x] (walk k) (walk v))
                (coll? x) (run! walk x)))]
      (run! #(run! walk (:forms %)) units))
    @counts))

(defn- split-report
  "The split of the measured units (attr/split-of's, summed) with the facts' counts."
  [units stats]
  (let [sum (fn [k] (apply merge-with + (map #(get-in % [:split k]) units)))]
    {:units (count units)
     :facts (into (sorted-map) (for [[k v] stats :when (and (keyword? k) (some-> (namespace k) (str/starts-with? "attr.")))]
                                 [(keyword (subs (namespace k) 5) (name k)) v]))
     :index (into (sorted-map) (for [[k v] stats :when (and (keyword? k) (= "index" (namespace k)))] [k v]))
     :lists (into (sorted-map-by #(compare (str %1) (str %2))) (sum :lists))
     :frames (into (sorted-map-by #(compare (str %1) (str %2))) (sum :frames))}))

(defn finish
  "Write the converted units, check them, print and write the report (and with `split` the split)."
  [out files units failures errors stats check t0 & [split]]
  (when split
    (io/make-parents (io/file out "repr-java-split.edn"))
    (spit (io/file out "repr-java-split.edn") (with-out-str (pp/pprint (split-report units stats)))))
  (let [written (write-output out units)
        reads (when check (vec (pmap (fn [{:keys [path text]}] (assoc (readable text) :path path)) written)))
        unreadable (vec (filter :core reads))
        edn-errors (frequencies (keep :edn reads))
        secs (/ (- (System/nanoTime) t0) 1e9)]
    (doseq [e (take 20 errors)] (println "javac:" e))
    (doseq [u (take 5 (sort-by :ms > units))] (println "slowest:" (:ms u) "ms" (:source u)))
    (doseq [f failures] (println "FAILED" (:source f) (:error f)) (run! #(println "   " %) (:trace f)))
    (doseq [u unreadable] (println "UNREADABLE" (:path u) (:core u)))
    (when (seq edn-errors)
      (println "arbace.edn/read errors by kind:"
               (frequencies (map #(cond (re-find #"Invalid token: .*/[0-9]+$" %) "array class symbol"
                                        (re-find #"Metadata must be" %) "param-tags metadata"
                                        :else %)
                                 (keep :edn reads)))))
    (println (format "%d Java files, %d converted, %d failed, %d javac errors, %d files written to %s%s in %.1fs"
                     (count files) (count units) (count failures) (count errors) (count written) out
                     (if check (format ", %d unreadable" (count unreadable)) "")
                     secs))
    (when check
      (let [report {:files (count files) :converted (count units)
                    :failures (mapv #(select-keys % [:source :error]) failures)
                    :javac-errors (count errors) :unreadable unreadable
                    :edn-errors edn-errors
                    :stats (into (sorted-map) stats)
                    :heads (into (sorted-map) (head-symbols units))}]
        ;; OUT made when nothing was written (a module of module-info.java alone: java.se)
        (io/make-parents (io/file out "repr-java-report.edn"))
        (spit (io/file out "repr-java-report.edn") (with-out-str (pp/pprint report)))))
    {:failures failures :unreadable unreadable :errors errors}))

(defn convert
  [out root paths {:keys [rename javac-opts check origins front native-out split]}]
  (let [root (.getCanonicalPath (io/file root))
        paths (if (seq paths)
                (map #(if (.isAbsolute (io/file %)) % (str root "/" %)) paths)
                [root])
        files (java-files paths)
        ;; --origins F: the name each converted file's header gives its source, F's for the
        ;; file's path below ROOT ({path name}, read), as read-jdk's
        origin-names (when origins (with-open [r (PushbackReader. (io/reader origins))] (binding [*read-eval* false] (read r))))
        t0 (System/nanoTime)
        front (keyword (or front "javac"))
        r (convert-units files (into ["-sourcepath" root] javac-opts) rename *full* front split)
        origin (fn [units]
                 (if origin-names
                   (vec (for [u units
                              :let [p (.getCanonicalPath (io/file (:source u)))
                                    rel (when (str/starts-with? p (str root "/")) (subs p (inc (count root))))]]
                          (if-let [o (get origin-names rel)] (assoc u :origin o) u)))
                   units))
        {:keys [units failures errors stats]} r
        res (finish out files (origin units) failures errors stats check t0 (and split (not= front :both)))]
    (if-let [n (:native r)]
      (let [nout (or native-out (str out ".native"))]
        (println "native trees:")
        (finish nout files (origin (:units n)) (:failures n) (:errors n) (:stats n) check t0 split)
        res)
      res)))

(defn- chunks
  "The files grouped by directory (package), the groups packed into chunks of about n files."
  [files n]
  (let [groups (vals (group-by #(.getParent (io/file %)) files))]
    (loop [[g & more :as gs] (sort-by count > groups) out [] cur []]
      (cond
        (empty? gs) (if (seq cur) (conj out cur) out)
        (and (seq cur) (> (+ (count cur) (count g)) n)) (recur gs (conj out cur) [])
        :else (recur more out (into cur g))))))

(defn jdk
  "Convert a sample of the JDK's sources: for module directory `module-src` (e.g.
  /root/jdk26u/src/java.base/share/classes) and `paths` below it, attribute the files as
  part of module `module` against the running JDK's compiled classes. The files are copied
  into patch directories under .tmp, one per chunk of packages, so javac takes everything else
  from the system image; the chunks are converted in parallel."
  [out module module-src paths {:keys [javac-opts check origins front native-out split] :as opts}]
  (let [src (.getCanonicalPath (io/file module-src))
        ;; the name each converted file's header gives its source: the original file, not the
        ;; copy in the numbered patch directory (which depends on the chunking); with
        ;; --origins F, F's name for the file's path below module-src ({path name}, read)
        origin-names (when origins (with-open [r (PushbackReader. (io/reader origins))] (binding [*read-eval* false] (read r))))
        origin-of (fn [rel] (or (get origin-names rel) (str src "/" rel)))
        files (remove #(re-find #"/snippet-files/" %)
                      (java-files (map #(str src "/" %) (or (seq paths) ["."]))))
        t0 (System/nanoTime)
        [mi others] ((juxt filter remove) #(str/ends-with? % "/module-info.java") files)
        _ (when (seq mi) (println "skipped (a module-info cannot be patched):" (str/join " " mi)))
        files others
        work (map-indexed vector (chunks others 150))
        pool (java.util.concurrent.Executors/newFixedThreadPool
              (Integer/parseInt (or (System/getenv "REPR_JAVA_THREADS") "12")))
        patch-of (fn [i] (io/file ".tmp/repr-java-patch" (str module "-" i)))
        ;; the chunks' copies, made before any chunk is attributed
        copies-of (into {} (for [[i fs] work]
                             (let [patch (patch-of i)]
                               (when (.exists patch)
                                 (doseq [^File f (reverse (file-seq patch))] (.delete f)))
                               [i (vec (for [f fs]
                                         (let [rel (subs f (inc (count src)))
                                               c (io/file patch rel)]
                                           (io/make-parents c)
                                           (io/copy (io/file f) c)
                                           (.getPath c))))])))
        origin-by-copy (into {} (for [[i fs] work f fs
                                      :let [rel (subs f (inc (count src)))
                                            rel (if (str/starts-with? rel "./") (subs rel 2) rel)]]
                                  [(.getCanonicalPath (io/file (patch-of i) rel)) (origin-of rel)]))
        ;; REPR_JAVA_PATCH_ALL: each chunk sees the other chunks' sources too (its own first), for
        ;; sources whose packages the running JDK lacks (bin/jrt-convert's jrt Java, used
        ;; across packages)
        all? (some? (System/getenv "REPR_JAVA_PATCH_ALL"))
        full? *full*
        front (keyword (or front "javac"))
        task (fn [[i fs]]
               (let [patch (patch-of i)
                     ppath (str/join File/pathSeparator
                                     (cons (.getCanonicalPath patch)
                                           (when all?
                                             (for [[j _] work :when (not= j i)] (.getCanonicalPath (patch-of j))))))
                     copies (get copies-of i)]
                 (try
                   (convert-units copies
                                  (into ["--patch-module" (str module "=" ppath)
                                         "-implicit:none" "--enable-preview" "-source" "26"]
                                        javac-opts)
                                  (:rename opts) full? front split)
                   (catch Throwable e
                     {:failures (mapv (fn [f] {:failure true :source f :error (str "javac: " e)}) copies)}))))
        futures (mapv (fn [w] (.submit pool ^java.util.concurrent.Callable (fn [] (task w)))) work)
        results (mapv deref futures)
        _ (.shutdown pool)
        gather (fn [results]
                 {:units (vec (for [u (mapcat :units results)]
                                (assoc u :origin (get origin-by-copy (.getCanonicalPath (io/file (:source u))) (:source u)))))
                  :failures (vec (mapcat :failures results))
                  :errors (vec (mapcat :errors results))
                  :stats (apply merge-with + (map :stats results))})
        {:keys [units failures errors stats]} (gather results)
        res (finish out files units failures errors stats check t0 (and split (not= front :both)))]
    (when (= front :both)
      (let [n (gather (map #(or (:native %) (select-keys % [:failures])) results))]
        (println "native trees:")
        (finish (or native-out (str out ".native")) files (:units n) (:failures n) (:errors n) (:stats n) check t0 split)))
    res))

(defn- parse-opts [args]
  (loop [args args opts {:rename {} :javac-opts []} pos []]
    (if (empty? args)
      [opts pos]
      (let [[a b & more] args]
        (case a
          "--rename" (let [[from to] (str/split b #"=")] (recur more (assoc-in opts [:rename from] to) pos))
          "--javac" (recur more (update opts :javac-opts conj b) pos)
          "--check" (recur (rest args) (assoc opts :check true) pos)
          "--full" (recur (rest args) (assoc opts :full true) pos)
          "--origins" (recur more (assoc opts :origins b) pos)
          "--front" (recur more (assoc opts :front b) pos)
          "--native-out" (recur more (assoc opts :native-out b) pos)
          "--split" (recur (rest args) (assoc opts :split true) pos)
          (recur (rest args) opts (conj pos a)))))))

(defn -main [cmd & args]
  (case cmd
    "read" (let [[opts [out root & paths]] (parse-opts args)]
             (binding [*full* (boolean (:full opts))] (convert out root paths opts)))
    "read-jdk" (let [[opts [out module src & paths]] (parse-opts args)]
                 (binding [*full* (boolean (:full opts))] (jdk out module src paths opts))))
  (shutdown-agents))

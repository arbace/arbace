(ns arbace.repr.go
  "Command line of repr/go's reader, Go into Go forms (doc/go/CONVERTER-NOTES.md).

  bin/repr-go read ... runs
    -m arbace.repr.go read [--out DIR] [--full] [--jobs N] [--goroot DIR] [--no-check]
       [--report FILE] DUMP|DIR...
  Converts each helper dump (DIRs: every .edn below them) to Go forms under OUT (default
  .tmp/repr-go/forms): go/<path>.ae and go/<path>/<file>.ae per package (doc/go/SPEC.md §4.1).
  A single-file program (path command-line-arguments) gets the namespace go.test. plus its
  dump's path relative to the DIR given, and so does a package of a directory test (a dump with
  :dir-test, key DIR.dir/STEM: go.test.<DIR>_dir.<STEM>). Unless --no-check, every file written is read back
  with Arbace's reader and compared with the forms in memory, metadata and the lines of lists
  included. Prints per dump a line, then totals and the coverage per node kind; --report
  writes them as data."
  (:require [arbace.repr.go.convert :as cv]
            [arbace.repr.go.layout :as layout]
            [arbace.repr.go.lit :as lit]
            [arbace.repr.go.read :as rd]
            [arbace.repr.go.types :as ty]
            [arbace.string :as str])
  (:import [java.io File StringReader]
           [java.util.concurrent Executors TimeUnit]))

;;; Read-back check

(defn data-of
  "The data an in-memory form reads back as (without metadata)."
  [x]
  (cond
    (lit/lit? x) (:value x)
    (and (seq? x) (:arbace.repr.go.convert/raw (meta x))) (list 'in-ns (list 'quote (second (second x))))
    (and (seq? x) (:arbace.repr.go.convert/deref (meta x))) (list 'arbace.core/deref (data-of (second x)))
    (seq? x) (apply list (map data-of x))
    (vector? x) (mapv data-of x)
    (map? x) (into {} (map (fn [[k v]] [(data-of k) (data-of v)])) x)
    :else x))

(defn- expected-meta
  "The metadata x reads back with, as data, without :line/:column (checked apart)."
  [x]
  (let [m (layout/public-meta x)]
    (into {} (map (fn [[k v]] [k (data-of v)])) (dissoc m :line :column))))

(defn- read-meta [x]
  (when (instance? arbace.lang.IObj x)
    (dissoc (meta x) :line :column)))

(declare diff-meta)

(defn diff
  "The first difference between the in-memory form x (prepared) and the form r read back, or
  nil: [path what expected actual]."
  [x r path]
  (let [dx (data-of x)]
    (if (not= dx r)
      [path :data dx r]
      ;; the data equal, so are every child's: the children are compared by their metadata and
      ;; lines alone (each child's data compared again cost the depth of the tree, GPS49 (c))
      (diff-meta x r path))))

(defn- diff-meta
  "diff of x and r whose data are equal: their metadata and lines, then their children's."
  [x r path]
  (or (let [em (expected-meta x)
            rm (or (read-meta r) {})]
        (when (and (or (seq em) (seq rm)) (not= (data-of em) (data-of rm)))
          [path :meta em rm]))
      (when (and (seq? x) (= layout/*mode* :lines) (not (:arbace.repr.go.convert/raw (meta x))))
        (let [want (or (:line (meta x)) (:arbace.repr.go.convert/l (meta x)))
              got (:line (meta r))]
          (when (and want got (not= want got))
            [path :line want got])))
      (when (and (seq? x) (:arbace.repr.go.convert/deref (meta x)))
        (diff-meta (second x) (second r) (conj path 1)))
      (when (and (or (seq? x) (vector? x)) (not (:arbace.repr.go.convert/deref (meta x))))
        (first (keep identity (map-indexed (fn [i [a b]] (diff-meta a b (conj path i)))
                                           (map vector x r)))))))

(defn read-all [^String text]
  (binding [*read-eval* false]
    (let [r (arbace.lang.LineNumberingPushbackReader. (StringReader. text))
          eof (Object.)]
      (loop [acc []]
        (let [f (read r false eof)]
          (if (identical? f eof) acc (recur (conj acc f))))))))

(defn check-text
  "nil when text reads back as the prepared forms, else a message."
  [text prepared]
  (try
    (let [rs (read-all text)]
      (if (not= (count rs) (count prepared))
        (str "read " (count rs) " forms, wrote " (count prepared))
        (some (fn [[i x r]] (when-let [d (diff x r [i])] (pr-str d)))
              (map vector (range) prepared rs))))
    (catch Throwable e (str "read error: " (.getMessage e)))))

;;; Conversion of dumps

(defn- munge-seg [^String s] (.replaceAll s "[.-]" "_"))

(defn program-ns
  "The namespace of a single-file program from its dump's relative path (x/y.go.edn)."
  [^String rel]
  (let [p (str/replace rel #"\.edn$" "")
        p (str/replace p #"\.go$" "")]
    (symbol (str "go.test." (str/join "." (map munge-seg (str/split p #"/")))))))

(defn ns-dir [ns-sym]
  (str/join "/" (str/split (str ns-sym) #"\.")))

(defn- spit-file [^File f ^String text]
  (.mkdirs (.getParentFile f))
  (spit f text))

(defn candidate-dir
  "Where the printed Go files of a dump go in a candidate laid out like GOROOT."
  [cand dump]
  (let [dir (:dir dump)]
    (if (str/starts-with? dir "$GOROOT/")
      (str cand "/" (subs dir (count "$GOROOT/")))
      (str cand "/test/" dir))))

(defn print-candidate
  "Prints the forms of the package file pkg-file (arbace.repr.go.print, loaded on first use) into
  the candidate; nil or an error message."
  [pkg-file dir]
  (try
    ((requiring-resolve 'arbace.repr.go.print/print-package) pkg-file dir {})
    nil
    (catch Throwable e (str (.getName (class e)) ": " (.getMessage e)))))

(defn- first-difference
  "The first line (from 1) where the bytes a and b differ, or nil when they are equal."
  [^bytes a ^bytes b]
  (when-not (java.util.Arrays/equals a b)
    (let [n (min (alength a) (alength b))]
      (loop [i 0 line 1]
        (cond
          (or (>= i n) (not= (aget a i) (aget b i))) line
          (== 10 (aget a i)) (recur (inc i) (inc line))
          :else (recur (inc i) line))))))

(defn text-key
  "The name of a Go file in the text level's results: its path under GOROOT (src/... or
  test/...)."
  [dump name]
  (let [dir (:dir dump)]
    (if (str/starts-with? dir "$GOROOT/")
      (str (subs dir (count "$GOROOT/")) "/" name)
      (let [dir (str/replace dir #"/+$" "")]
        (str "test/" (if (or (= "." dir) (= "" dir)) "" (str dir "/")) name)))))

(defn text-level
  "The text level of the round trip (mode :full): each printed file of the dump compared
  byte for byte with its original. {:files n :differ [[key line] ...]}."
  [dump files text-dir cand-dir]
  (let [rs (for [fl files
                 :let [nm (:name fl)
                       orig (File. ^String text-dir ^String nm)
                       printed (File. ^String cand-dir ^String nm)]]
             [(text-key dump nm)
              (cond
                (not (.isFile printed)) :missing
                :else (first-difference (java.nio.file.Files/readAllBytes (.toPath orig))
                                        (java.nio.file.Files/readAllBytes (.toPath printed))))])]
    {:files (count rs)
     :keys (mapv first rs)
     :differ (vec (filter second rs))}))

(defn dump-context
  "How dump d, at rel (its path relative to the directory given), converts: {:ns :namespaces
  :src-dir :text-dir}; goroot the Go tree of its sources (nil: no source directory or text)."
  [d rel goroot]
  (let [dir-test (:dir-test d)
        program? (or (= "command-line-arguments" (:package d)) (some? dir-test))]
    {:ns (if program? (program-ns rel) (ty/ns-name-of (:package d)))
     ;; a directory test's packages: go.test.<its .dir>[.<key>] (doc/go/SPEC.md §4.1)
     :namespaces (when dir-test
                   (let [base (str (program-ns (str/replace (:test dir-test) #"\.go$" ".dir")))]
                     (into {} (for [[path k] (:packages dir-test)]
                                [path (symbol (apply str base (for [seg (str/split k #"/")
                                                                    :when (seq seg)]
                                                                (str "." (munge-seg seg)))))]))))
     :src-dir (when goroot
                (cond
                  dir-test (str goroot "/test/" (:dir d))
                  (not program?) (str/replace (:dir d) "$GOROOT" goroot)))
     :text-dir (when goroot
                 (if program?
                   (str goroot "/test/" (:dir d))
                   (str/replace (:dir d) "$GOROOT" goroot)))}))

(defn package-texts
  "The .ae texts of conversion r (convert-package's, of namespace ns-sym) in mode positions, as
  convert-data writes them: [[\"package\" text] [stem text] ...]."
  [r ns-sym positions]
  (binding [layout/*mode* positions]
    (let [last-seg (last (str/split (ns-dir ns-sym) #"/"))]
      (into [["package" (layout/write-package ns-sym (:package r) (map #(str last-seg "/" (:stem %)) (:files r)))]]
            (for [fl (:files r)] [(:stem fl) (layout/write-file (:forms fl) (:comments fl))])))))

(declare convert-data)

(defn convert-dump
  "Converts the dump at path into out; returns a result map."
  [path rel opts]
  (let [t0 (System/nanoTime)]
    (try
      (let [d (rd/read-dump path)]
        (convert-data d path rel t0 (System/nanoTime) opts))
      (catch Throwable e
        {:path path :fail (str (.getName (class e)) ": " (.getMessage e))
         :trace (vec (take 12 (map str (.getStackTrace e))))}))))

(defn convert-data
  "Converts dump d (read from path at t0, by t1; or made in memory) into out; returns a result
  map. opts :raw: raw forms (arbace.repr.go.convert's raw mode, with :positions :full), their
  open decisions counted (:open)."
  [d path rel t0 t1 {:keys [out positions goroot check print text raw]}]
  (let [{ns-sym :ns :keys [namespaces src-dir text-dir]} (dump-context d rel goroot)
        tc (System/nanoTime)
        r (cv/convert-package d {:positions positions :ns ns-sym :src-dir src-dir
                                 :namespaces namespaces
                                 :text-dir text-dir :raw raw})
        convert-ms (/ (- (System/nanoTime) tc) 1e6)
        dir (ns-dir ns-sym)
        last-seg (last (str/split dir #"/"))
        layout-stats (atom {})
        files (binding [layout/*mode* positions
                        layout/*stats* layout-stats]
                (vec (for [fl (:files r)]
                       ;; prepared once, for the text and its check (GPS49 (c)); its layout
                       ;; notes counted as often as before, once more for the check
                       (let [st (atom {})
                             prepared (binding [layout/*stats* st] (layout/prepare (:forms fl)))
                             _ (dotimes [_ (if check 2 1)] (swap! layout-stats #(merge-with + % @st)))
                             text (layout/write-prepared prepared (:comments fl))
                             bad (when check
                                   (check-text text prepared))]
                         (assoc fl :text text :bad bad)))))
        pkg-text (layout/write-package ns-sym (:package r)
                                       (map #(str last-seg "/" (:stem %)) files))
        pkg-bad (when check
                  (try (read-all pkg-text) nil
                       (catch Throwable e (str "read error: " (.getMessage e)))))
        bytes (atom (count (.getBytes pkg-text "UTF-8")))]
    (spit-file (File. (str out "/" dir ".ae")) pkg-text)
    (doseq [fl files]
      (swap! bytes + (count (.getBytes ^String (:text fl) "UTF-8")))
      (spit-file (File. (str out "/" dir "/" (:stem fl) ".ae")) (:text fl)))
    (let [print-fail (when print
                       (print-candidate (str out "/" dir ".ae") (candidate-dir print d)))
          text-r (when (and text print text-dir (not print-fail))
                   (text-level d files text-dir (candidate-dir print d)))
          dump-nodes (frequencies (map first (mapcat (comp rd/nodes :ast) (:files d))))]
      (cond->
       {:path path :package (:package d) :ns ns-sym :files (count files)
        :bytes @bytes :ms (/ (- (System/nanoTime) t0) 1e6) :read-ms (/ (- t1 t0) 1e6) :convert-ms convert-ms
        :stats (:stats r) :layout @layout-stats :dump-nodes dump-nodes :text text-r
        :unplaced (vec (for [fl files u (:unplaced fl)] [(:name fl) u]))
        :bad (vec (concat (keep (fn [fl] (when (:bad fl) [(:name fl) (:bad fl)])) files)
                          (when pkg-bad [["package" pkg-bad]])
                          (when print-fail [["print" print-fail]])))}
        raw (assoc :open (cv/open-counts (mapcat :forms (:files r))))))))

(defn dump-files
  "[path rel] of the .edn files of the paths, sorted; rel relative to the path given."
  [paths]
  (sort-by first
           (for [p paths
                 :let [root (File. ^String p)]
                 ^File f (file-seq root)
                 :when (and (.isFile f) (str/ends-with? (.getName f) ".edn"))]
             [(.getPath f)
              (if (.isDirectory root)
                (subs (.getPath f) (inc (count (.getPath root))))
                (.getName f))])))

(defn- merge-counts [ms] (apply merge-with + {} ms))

(defn report
  "Prints the results rs of a conversion (convert-dump's or convert-data's, one per dump; wall
  its seconds) as bin/repr-go read prints them: a line per dump (unless :quiet), FAIL and BAD
  lines, the coverage per node kind, the totals, the text level (:text, against :text-known);
  writes them as data to :report. Returns the exit status: 1 when a conversion failed, a file did
  not read back or (:text) a file differs that the known differences do not list."
  [rs wall opts]
  (let [fails (filter :fail rs)
        bad (filter #(seq (:bad %)) rs)
        ok (remove :fail rs)
        nodes (merge-counts (map #(get-in % [:stats :nodes]) ok))
        dump-nodes (merge-counts (map :dump-nodes ok))
        notes (merge-counts (map #(get-in % [:stats :notes]) ok))
        lay (merge-counts (map :layout ok))
        unplaced (mapcat (fn [r] (map #(vector (:package r) %) (:unplaced r))) ok)]
    (doseq [r rs]
      (cond
        (:fail r) (do (println "FAIL" (:path r) (:fail r))
                      (doseq [t (:trace r)] (println "    " t)))
        (seq (:bad r)) (doseq [[f m] (:bad r)] (println "BAD" (:path r) f m))
        (not (:quiet opts))
        (println (format "%s: %s, %d files, %.1f KB, %.0f ms (read %.0f ms)"
                         (:path r) (:ns r) (:files r) (/ (:bytes r) 1e3) (:ms r) (:read-ms r)))))
    (doseq [[pkg u] unplaced] (println "UNPLACED directive" pkg u))
    (println "node kinds (converted / in the dumps):")
    (doseq [k (sort (set (concat (keys nodes) (keys dump-nodes))))]
      (println (format "  %-20s %9d / %9d%s" (name k) (get nodes k 0) (get dump-nodes k 0)
                       (if (= (get nodes k 0) (get dump-nodes k 0)) "" "  *"))))
    (println "notes:" (pr-str (into (sorted-map) notes)))
    (println "layout:" (pr-str (into (sorted-map) lay)))
    (println (format "converted %d of %d dumps (%d files, %.1f MB of forms) in %.1f s with %d threads; %d failed, %d did not read back"
                     (count ok) (count rs) (reduce + (map :files ok))
                     (/ (reduce + (map :bytes ok)) 1e6) wall (:jobs opts) (count fails) (count bad)))
    (let [text? (:text opts)
          known (when-let [k (:text-known opts)]
                  (when (.isFile (File. ^String k))
                    (binding [*read-eval* false] (read-string (slurp k)))))
          trs (keep :text ok)
          differ (mapcat :differ trs)
          unknown (remove (fn [[k _]] (contains? known k)) differ)
          checked (set (mapcat :keys trs))
          differing (set (map first differ))
          ;; known differences of files checked that are now equal
          fixed (sort (filter #(and (checked %) (not (differing %))) (keys known)))]
      (when text?
        (doseq [[k line] (sort differ)]
          (println (if (contains? known k) "TEXT known" "TEXT") k "line" line
                   (if (contains? known k) (str "(" (get known k) ")") "")))
        (doseq [k fixed] (println "TEXT fixed" k "(known as differing: remove it from the known differences)"))
        (println (format "text: %d files, %d byte-identical, %d differ (%d known, %d not known)"
                         (reduce + (map :files trs)) (- (reduce + (map :files trs)) (count differ))
                         (count differ) (- (count differ) (count unknown)) (count unknown))))
      (when-let [rf (:report opts)]
        (spit rf (pr-str (merge (:report-extra opts)
                                {:dumps (count rs) :failed (count fails) :bad (count bad)
                                 :files (reduce + (map :files ok)) :bytes (reduce + (map :bytes ok))
                                 :seconds wall :nodes (into (sorted-map) nodes)
                                 :dump-nodes (into (sorted-map) dump-nodes)
                                 :notes (into (sorted-map) notes) :layout (into (sorted-map) lay)
                                 :unplaced (vec unplaced)
                                 :text (when text? {:files (reduce + (map :files trs))
                                                    :differ (vec (sort differ))})}))))
      (if (or (seq fails) (seq bad) (and text? (seq unknown))) 1 0))))

(defn -main [& args]
  (let [[cmd & args] args
        _ (when (not= cmd "read")
            (println "usage: read [--out DIR] [--full] [--jobs N] [--goroot DIR] [--no-check] [--report FILE] DUMP|DIR...")
            (System/exit 2))
        [opts paths] (loop [opts {:out ".tmp/repr-go/forms" :positions :lines :jobs 1 :check true}
                            [a & more :as args] args]
                       (case a
                         "--out" (recur (assoc opts :out (first more)) (rest more))
                         "--full" (recur (assoc opts :positions :full) more)
                         "--jobs" (recur (assoc opts :jobs (parse-long (first more))) (rest more))
                         "--goroot" (recur (assoc opts :goroot (first more)) (rest more))
                         "--no-check" (recur (assoc opts :check false) more)
                         "--print" (recur (assoc opts :print (first more)) (rest more))
                         "--report" (recur (assoc opts :report (first more)) (rest more))
                         "--quiet" (recur (assoc opts :quiet true) more)
                         "--text" (recur (assoc opts :text true) more)
                         "--text-known" (recur (assoc opts :text-known (first more)) (rest more))
                         [opts args]))
        files (dump-files paths)
        _ (when (:print opts) (require 'arbace.repr.go.print))
        t0 (System/nanoTime)
        pool (Executors/newFixedThreadPool (:jobs opts))
        futs (mapv (fn [[p rel]] (.submit pool ^Callable (fn [] (convert-dump p rel opts)))) files)
        rs (mapv #(.get ^java.util.concurrent.Future %) futs)
        wall (/ (- (System/nanoTime) t0) 1e9)]
    (.shutdown pool)
    (.awaitTermination pool 1 TimeUnit/MINUTES)
    (let [status (report rs wall opts)]
      (shutdown-agents)
      (System/exit status))))

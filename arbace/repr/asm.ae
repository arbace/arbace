(ns arbace.repr.asm
  "repr/asm, assembly's bridge (doc/asm/SPEC.md; doc/asm/AMD64-SURVEY.md §4-§5, AX1): GNU as's text, AT&T syntax for
  amd64, as assembly forms and back. `read-text` reads a text into its items (arbace.repr.asm.gnu with
  arbace.repr.asm.amd64.att's instructions), `ae-text` writes them as `.ae` text (a header form, then an item a line),
  `print-text` prints them canonically; mode :full (arbace.repr.asm.full) keeps the layer that prints the original back
  byte for byte. `-main` is bin/repr-asm's read, print and the Arbace half of its round trip."
  (:require [arbace.repr.asm.gnu :as gnu]
            [arbace.repr.asm.amd64.att :as att]
            [arbace.repr.asm.amd64.intel :as intel]
            [arbace.repr.asm.arm64.gnu :as a64]
            [arbace.repr.asm.plan9 :as p9]
            [arbace.repr.asm.lex :as lex]
            [arbace.repr.asm.full :as full]
            [arbace.repr.c.layout :as layout]
            [arbace.string :as str])
  (:import [java.util.concurrent Executors Callable Future]))

(set! *warn-on-reflection* true)

(def header '(asm/unit {:arch :amd64 :syntax :att}))

;; A dialect: the header's map {:arch :amd64|:arm64 :syntax :att|:gnu|:apple|:plan9 :cpp true?} (doc/asm/SPEC.md §1, §10, §11):
;; AX1's amd64 AT&T, AR1's arm64 GNU (ELF), Apple's (Darwin: `;` comments) and Plan 9's; :cpp a text of the C preprocessor
;; (a `.S`; Plan 9's always).
(def amd64 {:arch :amd64 :syntax :att})

(defn dialect
  "The dialect of `arch` and `syntax` (nil: the arch's GNU spelling) for a file at `path` (a `.S` the C preprocessor's)."
  [arch syntax ^String path]
  (let [arch (keyword (or arch "amd64"))
        syntax (keyword (or syntax (if (= arch :amd64) "att" "gnu")))
        cpp? (or (= syntax :plan9) (and path (.endsWith path ".S")))]
    (cond-> {:arch arch :syntax syntax} cpp? (assoc :cpp true))))

(defn header-of [d] (list 'asm/unit d))

(defn- lex-dialect
  "The lexer's dialect (arbace.repr.asm.lex/*dialect*) of the header's map: its syntax's rules, with llvm-mc's lexer options
  the map names (:masm-integers, :motorola-integers: a RUN line's -masm-integers, -motorola-integers)."
  [d]
  (let [base (case (:syntax d)
               (:att :intel) nil
               :gnu {:hash :start}
               :apple {:hash :start :semi :comment :sep "%%"}
               :plan9 {:hash :start :high true :p9 true})
        opts (cond-> {} (:masm-integers d) (assoc :masm-int true) (:motorola-integers d) (assoc :motorola true))]
    (if (seq opts) (merge base opts) base)))

;; amd64's two syntaxes: an instruction printed in the syntax in force where it stands (gnu/*syntax*, moved by `.intel_syntax` and
;; `.att_syntax` as the items are printed in order)
(defn- amd64-insn-text ^String [f]
  (if (= :intel (some-> gnu/*syntax* deref)) (intel/insn-text f) (att/insn-text f)))

(defn- insn-text-of [d] (case (:syntax d) (:att :intel) amd64-insn-text (:gnu :apple) a64/insn-text :plan9 p9/insn-text))

(defmacro ^:private in-dialect [d & body]
  `(let [d# ~d]
     (binding [lex/*dialect* (lex-dialect d#)
               gnu/*syntax* (volatile! (if (= :intel (:syntax d#)) :intel :att))
               gnu/*raw* (if (#{:gnu :apple} (:syntax d#)) (into gnu/raw-directives gnu/raw-text-directives) gnu/raw-directives)]
       ~@body)))

(defn latin1 ^String [^String path]
  (String. (java.nio.file.Files/readAllBytes (.toPath (java.io.File. path))) "ISO-8859-1"))

(defn spit-latin1 [^String path ^String s]
  (when-let [p (.getParentFile (java.io.File. path))] (.mkdirs p))
  (java.nio.file.Files/write (.toPath (java.io.File. path)) (.getBytes s "ISO-8859-1")
                             ^"[Ljava.nio.file.OpenOption;" (make-array java.nio.file.OpenOption 0)))

(defn read-items
  ([^String src] (read-items src amd64))
  ([^String src d]
   (in-dialect d
     (case (:syntax d)
       (:att :intel) (gnu/read-items src (fn [ts i] (att/read-insn src ts i))
                                     {:syntax (:syntax d) :intel (fn [ts i] (intel/read-insn src ts i)) :unread true})
       (:gnu :apple) (gnu/read-items src (fn [ts i] (a64/read-insn src ts i (:cpp d)))
                                     {:cpp (:cpp d) :raw gnu/raw-text-directives :req true :unread true})
       :plan9 (gnu/read-items src (fn [ts i] (p9/read-insn ts i)) {:cpp true})))))
(defn read-text
  ([^String src] (read-text src amd64))
  ([^String src d] (mapv first (read-items src d))))
(defn print-text
  (^String [forms] (print-text forms amd64))
  (^String [forms d] (in-dialect d (gnu/print-items forms (insn-text-of d)))))
(defn read-full
  ([^String src] (read-full src amd64))
  ([^String src d] (in-dialect d (full/read-full src (read-items src d) (insn-text-of d)))))
(defn print-full
  (^String [forms layer] (print-full forms layer amd64))
  (^String [forms layer d] (in-dialect d (full/print-full forms layer (insn-text-of d)))))

(defn ae-text
  "The `.ae` text of `forms`: the header, then an item a line; with `layer`, its line last."
  (^String [forms layer] (ae-text forms layer amd64))
  (^String [forms layer d]
  (str (layout/form-str (header-of d)) "\n"
       (apply str (map #(str (layout/form-str %) "\n") forms))
       (when layer (full/layer-text layer)))))

(defn- strip-line [x]
  (cond (seq? x) (apply list (map strip-line x)) (vector? x) (mapv strip-line x) (map? x) (into {} (map (fn [[k v]] [k (strip-line v)]) x)) :else x))

(defn read-ae-dialect
  "The dialect of an `.ae` text, its header's map."
  [^String text]
  (let [h (read-string text)]
    (when-not (and (seq? h) (= 'asm/unit (first h)) (map? (second h)))
      (throw (ex-info "not an assembly .ae text: no (asm/unit ...) header" {})))
    (second h)))

(defn read-ae
  "The items of an `.ae` text (its header checked and left out)."
  [^String text]
  (let [r (arbace.lang.LineNumberingPushbackReader. (java.io.StringReader. text))
        eof (Object.)
        xs (loop [out []] (let [x (read r false eof)] (if (identical? x eof) out (recur (conj out (strip-line x))))))]
    (when-not (and (seq? (first xs)) (= 'asm/unit (ffirst xs))) (throw (ex-info "not an assembly .ae text: no (asm/unit ...) header" {})))
    (vec (rest xs))))

(defn- reason ^String [^Throwable e]
  (str (if-let [c (:asm/refused (ex-data e))] (str (name c) ": ") "crash: ")
       (-> (str (.getMessage e)) (str/replace #"[\t\n\r]" " ") (str/replace "\"" "'") (str/replace "\\" "(backslash)") (str/replace #"[^ -~]" "?"))))

(defn- check-prefix
  "The FileCheck prefix of a CHECK line (`CHECK-ERROR` of `# CHECK-ERROR: ...`, its -NEXT, -SAME, -DAG or -LABEL dropped), else nil."
  [^String l]
  (when-not (re-find #"RUN:" l)
    (second (re-find #"(?:^|[^A-Za-z0-9_-])([A-Z][A-Za-z0-9_]*(?:-[A-Z0-9_]+)*?)(?:-NEXT|-SAME|-DAG|-LABEL|-NOT|-EMPTY)?:" l))))

(defn- check-line? [^String l] (boolean (check-prefix l)))

(defn- norm-text ^String [^String s] (str/trim (str/replace s #"\s+" " ")))

(defn error-checks
  "AXS96 (a): the test's error CHECK lines (a split-file part when `part`, its name) with the lines of the file where each
  states an error, from the test's text `main`: {:checks [{:at LINE :kind :plain|:next :stated #{LINE...} :echo LINE?} ...]
  :not? BOOL :texts {LINE TEXT}}, the lines counted from the part's start. A CHECK line states an error at a `[[#@LINE+N]]`
  place, a `NAME.s:N:C:` place, else at the statements just before and just after it (a CHECK written beside its
  statement); and (small-tails, 2026-11-22) a CHECK line whose text is a statement's own text, llvm-mc's echo of the
  refused line after its `error:` line, at that statement (the nearest before it, else after it): the place of a block of
  errors stated after a block of statements. :kind :next for a -NEXT, -SAME or -EMPTY line (FileCheck holds it to the line
  after the previous match); :not? when a -NOT line of an error prefix is in the part."
  [^String main part]
  (let [ls (vec (str/split-lines main))
        hdr (if part
              (or (first (keep-indexed (fn [i l] (when (re-matches (re-pattern (str "^(?:#|//)--- " (java.util.regex.Pattern/quote (str part)) "\\s*")) l) (inc i))) ls)) 0)
              0)
        part-end (if part
                   (or (first (keep-indexed (fn [i l] (when (and (> (inc i) hdr) (re-find #"^(?:#|//)--- " l)) (inc i))) ls)) (inc (count ls)))
                   (inc (count ls)))
        runs (filter #(and (re-find #"RUN:" %) (re-find #"llvm-mc\b" %)) ls)
        all-err? (and (seq runs) (every? #(re-find #"not\s+llvm-mc" %) runs))
        ;; a statement's line: not blank, no comment, no CHECK line; a label alone (:label) does not end the walk
        stmt (fn [^long i] (let [t (str/trim (nth ls (dec i)))]
                             (when (and (seq t) (not (re-find #"^(#|//|;)" t)) (not (check-line? t)))
                               (if (re-matches #"[\w.$\"]+:" t) :label :stmt))))
        ;; the lines from the CHECK line in the direction `step` up to the first statement's, the labels before it
        near (fn [^long i ^long step]
               (loop [j (+ i step) out []]
                 (if (<= 1 j (count ls))
                   (case (stmt j) :stmt (conj out j) :label (recur (+ j step) (conj out j)) (recur (+ j step) out))
                   out)))
        ;; the statements' texts in the part (a trailing `//` comment left out), for the echo rule
        texts (into {} (for [j (range (inc hdr) (min part-end (inc (count ls))))
                             :when (= :stmt (stmt j))
                             :let [t (norm-text (str/replace (nth ls (dec j)) #"\s*//.*$" ""))]
                             :when (seq t)]
                         [j t]))
        by-text (group-by val texts)
        echo (fn [^long i ^String t]
               (when-let [js (seq (sort (map key (by-text (norm-text t)))))]
                 (or (last (filter #(< (long %) i) js)) (first js))))
        err? (fn [^String l pre] (and pre (or (re-find #"error:" l) (re-find #"ERR" pre) all-err?)))
        in-part? (fn [^long x] (and (pos? x) (< (+ x hdr) part-end)))
        checks (vec (for [[i l] (map-indexed (fn [i l] [(inc i) l]) ls)
                          :let [pre (check-prefix l)]
                          ;; an error's line: `error:` in it, a prefix of the errors' (ERR...), or any CHECK line of a test whose every
                          ;; llvm-mc run is rejected (`not llvm-mc`); never a -NOT
                          :when (and (err? l pre) (not (re-find #"-NOT:" l)))
                          :let [at (re-find #"\[\[#?@LINE([+-]\d+)?\]\]" l)
                                abs (re-find #"(?:\.[sS]|<stdin>)?:(\d+):\d+: error" l)
                                body (second (re-find #"^.*?[A-Z][A-Za-z0-9_-]*:\s?(.*)$" l))
                                e (when (and body (not (re-find #"error:" body)) (not (re-matches #"\s*\^?\s*" body)))
                                    (echo i body))
                                xs (cond at [(+ (long i) (long (if (second at) (Long/parseLong (str/replace (second at) "+" "")) 0)) (- hdr))]
                                         abs [(Long/parseLong (second abs))]
                                         :else (concat (map #(- (long %) hdr) (concat (near i -1) (near i 1)))
                                                       (when e [(- (long e) hdr)])))]]
                      {:at (- i hdr)
                       :kind (if (re-find #"-(NEXT|SAME|EMPTY):" l) :next :plain)
                       :error? (boolean (re-find #"error:" l))
                       :echo (when e (- (long e) hdr))
                       :stated (set (filter in-part? (map long xs)))}))]
    {:checks checks
     :not? (boolean (some (fn [[i l]] (and (< hdr (inc i) part-end) (re-find #"-NOT:" l) (err? l (check-prefix l))))
                          (map-indexed vector ls)))
     :texts (into {} (map (fn [[j t]] [(- (long j) hdr) t]) texts))}))

(defn error-lines
  "AXS96 (a): the lines of the file (a split-file part when `part`, its name) where the test's CHECK lines state an error
  (error-checks' places)."
  [^String main part]
  (set (mapcat :stated (:checks (error-checks main part)))))

(defn- chains
  "The error CHECK lines' FileCheck chains: a plain line and the -NEXT, -SAME and -EMPTY lines after it, each chain the
  statements its errors are (the echoed statements when every `error:` line of the chain has its echo, else every line
  the chain states)."
  [checks]
  (let [cs (reduce (fn [acc c] (if (and (= :next (:kind c)) (seq acc)) (conj (pop acc) (conj (peek acc) c)) (conj acc [c]))) [] checks)]
    (for [ch cs
          :let [errs (count (filter :error? ch))
                echoes (keep :echo ch)
                ss (if (and (pos? errs) (>= (count echoes) errs)) echoes (mapcat :stated ch))]
          :when (seq ss)]
      [(apply min ss) (apply max ss)])))

(defn- words-statement?
  "arm64 (small-tails, 2026-11-22): a statement of three or more bare words, the second and third apart by white space alone
  and the second neither a register's name nor `mul`: AArch64AsmParser::parseInstruction (llvm-project 23.1.5,
  AArch64AsmParser.cpp) parses the second as an operand (an expression: no operand parser takes two bare words but
  parseOptionalMulOperand's `mul vl`) and refuses the third ('unexpected token in argument list'), as AArch64's ELF syntax
  reads `;; Exponent too large` (`;` its separator, `//` its comment)."
  [^String t]
  (when-let [[_ _ w2] (re-matches #"([A-Za-z_][A-Za-z0-9_]*)\s+([A-Za-z_][A-Za-z0-9_]*)\s+[A-Za-z_][A-Za-z0-9_]*(?:\s+.*)?" (str/trim t))]
    (and (not= "mul" (str/lower-case w2)) (nil? (a64/register w2)))))

(defn- statement-text
  "The text of the statement at `line` of `src` that a refusal names: the last `;`-separated part of the line (the reader
  goes on after the separators)."
  ^String [^String src ^long line]
  (let [l (nth (str/split-lines src) (dec line) "")]
    (last (str/split (str/replace l #"\s*//.*$" "") #";"))))

(defn tolerated?
  "arm64 (small-tails, 2026-11-22): a refusal at `line`, where the test states no error, that the test's own verdict holds
  anyway: the statement is one llvm-mc refuses by its parser's own rule (words-statement?), and FileCheck's matching of
  the test's error lines lets its error through: no -NOT line of an error prefix, and no chain (a plain CHECK line with
  its -NEXT lines) whose statements lie on both sides of it (its error printed inside the chain)."
  [d ^String src ^long line ec]
  (and (= :arm64 (:arch d))
       (boolean (words-statement? (statement-text src line)))
       (not (:not? ec))
       (not-any? (fn [[lo hi]] (< (long lo) line (long hi))) (chains (:checks ec)))))

(defn- refusals
  "The (asm/unread ...) items outside a conditional block of the items [FORM START END]: [[LINE MESSAGE] ...]."
  [^String src items]
  (loop [items items depth 0 out []]
    (if (empty? items)
      out
      (let [[f st] (first items)
            h (when (seq? f) (first f))
            n (when (and (symbol? h) (= "asm" (namespace h))) (name h))]
        (cond
          (and n (.startsWith ^String n "if")) (recur (rest items) (inc depth) out)
          (= n "endif") (recur (rest items) (max 0 (dec depth)) out)
          (and (= n "unread") (zero? depth))
          (recur (rest items) depth (conj out [(inc (count (filter #(= \newline %) (subs src 0 (int st))))) (nth f 2 nil)]))
          :else (recur (rest items) depth out))))))

(defn check-one
  "One file's round trip: read in :full; the `.ae` text read back (forms and layer equal); printed back with the layer
  (the original byte for byte); the canonical print read again (the same forms, no layer). Writes the `.ae` text at
  `ae-path`; [status detail items gaps texts], status ok, refused, crash, ae-differs, layer-differs, text-differs,
  forms-differ or canon-layer."
  ([^String path ^String ae-path] (check-one path ae-path amd64))
  ([^String path ^String ae-path d] (check-one path ae-path d nil))
  ([^String path ^String ae-path d opts]
  (try
   (binding [gnu/*recover* (boolean (or (:error-test opts) (:error-input opts) (:not-input opts)))]
    (let [src (latin1 path)
          {:keys [forms layer]} (read-full src d)
          ae (ae-text forms layer d)
          _ (spit-latin1 ae-path ae)
          back (read-ae ae)
          canon (print-text forms d)
          again (read-full canon d)
          st (full/layer-stats layer)
          status (cond
                   (not= back forms) "ae-differs"
                   (not= (read-ae-dialect ae) d) "ae-differs"
                   (not= (full/layer-of-ae ae) layer) "layer-differs"
                   (not= (print-full forms layer d) src) "text-differs"
                   (not= (:forms again) forms) "forms-differ"
                   (or (seq (:at (:layer again))) (:end (:layer again))) "canon-layer"
                   :else "ok")
          ;; AXS96 (a): an error test's refusals, each held to a line the test states an error at
          rs (when (and (:error-test opts) (= status "ok")) (refusals src (read-items src d)))
          ec (when (seq rs) (error-checks (latin1 (or (:main opts) path)) (:part opts)))
          stated (set (mapcat :stated (:checks ec)))
          off (first (remove (fn [[l]] (or (contains? stated l) (tolerated? d src l ec))) rs))
          ;; x86-print: an error test's input (Inputs/, given to `not llvm-mc` by a test beside): llvm-mc refuses it, so a
          ;; statement must be refused (the message the test's FileCheck reads is LLVM's words, not judged); a file no RUN
          ;; line gives to llvm-mc (not-input): read with its statements kept, its refusals judged by nothing
          kept (when (and (or (:error-input opts) (:not-input opts)) (= status "ok")) (refusals src (read-items src d)))]
      (cond
        (and (:error-input opts) (= status "ok") (empty? kept))
        ["accepted" "an error test's input read with no refusal: llvm-mc refuses it" (count forms) (:gaps st) (:texts st)]
        (seq kept)
        [status (str (count kept) (if (:error-input opts) " refusals (an error test's input, `not llvm-mc`)" " statements kept unread (no RUN line gives the file to llvm-mc)"))
         (count forms) (:gaps st) (:texts st)]
        off
        ["misplaced" (str "a refusal where the test states no error (line " (first off) "): "
                           (-> (str (second off)) (str/replace #"[\t\n\r]" " ") (str/replace "\"" "'") (str/replace "\\" "(backslash)") (str/replace #"[^ -~]" "?"))) (count forms) (:gaps st) (:texts st)]
        :else
        (let [tol (count (remove (fn [[l]] (contains? stated l)) rs))]
          [status (if (seq rs) (str (count rs) " refusals at the test's errors"
                                    (when (pos? tol) (str " (" tol " of statements llvm-mc's parser refuses, unstated)")))
                      "")
           (count forms) (:gaps st) (:texts st)]))))
    (catch Throwable e
      [(if (:asm/refused (ex-data e)) "refused" "crash") (reason e) 0 0 0]))))

(defn control
  "A negative control: the subject's `.ae` (written in :full) printed back with its layer, against the reference's
  original text: `differs` (as it must) or `same`."
  [^String subject-ae ^String ref-path]
  (let [ae (latin1 subject-ae)]
    (if (= (print-full (read-ae ae) (full/layer-of-ae ae) (read-ae-dialect ae)) (latin1 ref-path)) "same" "differs")))

(defn error-control
  "A negative control of AXS96 (a)'s judge: the SUBJECT error test's refusals (read as an error test is) held to the
  REFERENCE test's error lines: `differs` when one is at a line the reference states no error at (as it must), else `same`."
  [^String subject ^String reference d]
  (let [src (latin1 subject)
        rs (binding [gnu/*recover* true] (refusals src (read-items src d)))
        ec (error-checks (latin1 reference) nil)
        stated (set (mapcat :stated (:checks ec)))]
    (if (and (seq rs) (every? #(or (contains? stated (first %)) (tolerated? d src (first %) ec)) rs)) "same" "differs")))

(defn- pool-map [f rows]
  (let [threads (Integer/parseInt (or (System/getenv "REPR_ASM_THREADS") "4"))
        pool (Executors/newFixedThreadPool threads)
        futs (mapv (fn [r] (.submit pool ^Callable (fn [] (f r)))) rows)
        res (mapv #(.get ^Future %) futs)]
    (.shutdown pool)
    res))

(defn- opt [r k] (second (drop-while #(not= k %) r)))
(defn- drop-opts [r ks] (loop [r r out []] (cond (empty? r) out (ks (first r)) (recur (drop 2 r) out) :else (recur (rest r) (conj out (first r))))))

(defn -main
  "bin/repr-asm read [--arch A] [--syntax S] [--full] FILE [-o OUT.ae]; print [--full] FILE.ae [-o OUT] (the dialect the
  header's); check [--arch A] LIST WORK (each NAME<tab>PATH<tab>FLAGS, FLAGS naming `apple` or `plan9` for that syntax:
  WORK/check.tsv, NAME STATUS ITEMS GAPS TEXTS DETAIL, the .ae texts in WORK/ae/); control SUBJECT.ae REFERENCE."
  [& args]
  (let [[verb & r] args
        full? (some #{"--full"} r)
        r (remove #{"--full"} r)
        arch (opt r "--arch")
        syntax (opt r "--syntax")
        r (drop-opts r #{"--arch" "--syntax"})
        out (opt r "-o")
        r (take-while #(not= "-o" %) r)
        emit (fn [^String s] (if out (spit-latin1 out s) (do (print s) (flush))))]
    (case verb
      "read" (let [src (latin1 (first r))
                   d (dialect arch syntax (first r))]
               (emit (if full?
                       (let [{:keys [forms layer]} (read-full src d)] (ae-text forms layer d))
                       (ae-text (read-text src d) nil d))))
      "print" (let [ae (latin1 (first r))
                    d (read-ae-dialect ae)
                    forms (read-ae ae)
                    layer (when full? (full/layer-of-ae ae))]
                (emit (if layer (print-full forms layer d) (print-text forms d))))
      "check" (let [[lst work] r
                    rows (for [l (str/split-lines (slurp lst)) :when (seq l)] (str/split l #"\t"))
                    res (pool-map (fn [[n p fl]]
                                    (let [fl (set (str/split (or fl "") #" "))
                                          d (cond-> (dialect arch (cond (fl "plan9") "plan9" (fl "apple") "apple" (fl "intel") "intel") p)
                                              (fl "masm-integers") (assoc :masm-integers true)
                                              (fl "motorola-integers") (assoc :motorola-integers true))]
                                      (into [n] (check-one p (str work "/ae/" n ".ae") d
                                                           {:error-test (contains? fl "reject")
                                                            :error-input (contains? fl "error-input")
                                                            :not-input (contains? fl "not-input")
                                                            :main (some #(when (.startsWith ^String % "split=") (subs % 6)) fl)
                                                            :part (some #(when (.startsWith ^String % "part=") (subs % 5)) fl)}))))
                                  rows)]
                (spit-latin1 (str work "/check.tsv")
                             (apply str (map (fn [[n s d i g t]] (str n "\t" s "\t" i "\t" g "\t" t "\t" d "\n")) res)))
                (let [ok (count (filter #(= "ok" (second %)) res))]
                  (println (str "repr-asm check: " ok " of " (count res) " ok"))))
      "control" (println (control (first r) (second r)))
      "error-control" (println (error-control (first r) (second r) (dialect arch (nth r 2 nil) (first r))))
      (do (binding [*out* *err*] (println "repr-asm: read|print|check|control")) (System/exit 2)))
    (shutdown-agents)))

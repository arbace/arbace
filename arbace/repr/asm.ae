(ns arbace.repr.asm
  "repr/asm, assembly's bridge (doc/asm/SPEC.md; doc/asm/AMD64-SURVEY.md §4-§5, AX1): GNU as's text, AT&T syntax for
  amd64, as assembly forms and back. `read-text` reads a text into its items (arbace.repr.asm.gnu with
  arbace.repr.asm.amd64.att's instructions), `ae-text` writes them as `.ae` text (a header form, then an item a line),
  `print-text` prints them canonically; mode :full (arbace.repr.asm.full) keeps the layer that prints the original back
  byte for byte. `-main` is bin/repr-asm's read, print and the Arbace half of its round trip."
  (:require [arbace.repr.asm.gnu :as gnu]
            [arbace.repr.asm.amd64.att :as att]
            [arbace.repr.asm.amd64.intel :as intel]
            [arbace.repr.asm.arm64.gnu :as a64]
            [arbace.repr.asm.plan9 :as p9]
            [arbace.repr.asm.lex :as lex]
            [arbace.repr.asm.full :as full]
            [arbace.repr.c.layout :as layout]
            [arbace.string :as str])
  (:import [java.util.concurrent Executors Callable Future]))

(set! *warn-on-reflection* true)

(def header '(asm/unit {:arch :amd64 :syntax :att}))

;; A dialect: the header's map {:arch :amd64|:arm64 :syntax :att|:gnu|:apple|:plan9 :cpp true?} (doc/asm/SPEC.md §1, §10, §11):
;; AX1's amd64 AT&T, AR1's arm64 GNU (ELF), Apple's (Darwin: `;` comments) and Plan 9's; :cpp a text of the C preprocessor
;; (a `.S`; Plan 9's always).
(def amd64 {:arch :amd64 :syntax :att})

(defn dialect
  "The dialect of `arch` and `syntax` (nil: the arch's GNU spelling) for a file at `path` (a `.S` the C preprocessor's)."
  [arch syntax ^String path]
  (let [arch (keyword (or arch "amd64"))
        syntax (keyword (or syntax (if (= arch :amd64) "att" "gnu")))
        cpp? (or (= syntax :plan9) (and path (.endsWith path ".S")))]
    (cond-> {:arch arch :syntax syntax} cpp? (assoc :cpp true))))

(defn header-of [d] (list 'asm/unit d))

(defn- lex-dialect [d]
  (case (:syntax d)
    (:att :intel) nil
    :gnu {:hash :start}
    :apple {:hash :start :semi :comment :sep "%%"}
    :plan9 {:hash :start :high true :p9 true}))

;; amd64's two syntaxes: an instruction printed in the syntax in force where it stands (gnu/*syntax*, moved by `.intel_syntax` and
;; `.att_syntax` as the items are printed in order)
(defn- amd64-insn-text ^String [f]
  (if (= :intel (some-> gnu/*syntax* deref)) (intel/insn-text f) (att/insn-text f)))

(defn- insn-text-of [d] (case (:syntax d) (:att :intel) amd64-insn-text (:gnu :apple) a64/insn-text :plan9 p9/insn-text))

(defmacro ^:private in-dialect [d & body]
  `(let [d# ~d]
     (binding [lex/*dialect* (lex-dialect d#)
               gnu/*syntax* (volatile! (if (= :intel (:syntax d#)) :intel :att))
               gnu/*raw* (if (#{:gnu :apple} (:syntax d#)) (into gnu/raw-directives gnu/raw-text-directives) gnu/raw-directives)]
       ~@body)))

(defn latin1 ^String [^String path]
  (String. (java.nio.file.Files/readAllBytes (.toPath (java.io.File. path))) "ISO-8859-1"))

(defn spit-latin1 [^String path ^String s]
  (when-let [p (.getParentFile (java.io.File. path))] (.mkdirs p))
  (java.nio.file.Files/write (.toPath (java.io.File. path)) (.getBytes s "ISO-8859-1")
                             ^"[Ljava.nio.file.OpenOption;" (make-array java.nio.file.OpenOption 0)))

(defn read-items
  ([^String src] (read-items src amd64))
  ([^String src d]
   (in-dialect d
     (case (:syntax d)
       (:att :intel) (gnu/read-items src (fn [ts i] (att/read-insn src ts i))
                                     {:syntax (:syntax d) :intel (fn [ts i] (intel/read-insn src ts i))})
       (:gnu :apple) (gnu/read-items src (fn [ts i] (a64/read-insn src ts i (:cpp d)))
                                     {:cpp (:cpp d) :raw gnu/raw-text-directives :req true :unread true})
       :plan9 (gnu/read-items src (fn [ts i] (p9/read-insn ts i)) {:cpp true})))))
(defn read-text
  ([^String src] (read-text src amd64))
  ([^String src d] (mapv first (read-items src d))))
(defn print-text
  (^String [forms] (print-text forms amd64))
  (^String [forms d] (in-dialect d (gnu/print-items forms (insn-text-of d)))))
(defn read-full
  ([^String src] (read-full src amd64))
  ([^String src d] (in-dialect d (full/read-full src (read-items src d) (insn-text-of d)))))
(defn print-full
  (^String [forms layer] (print-full forms layer amd64))
  (^String [forms layer d] (in-dialect d (full/print-full forms layer (insn-text-of d)))))

(defn ae-text
  "The `.ae` text of `forms`: the header, then an item a line; with `layer`, its line last."
  (^String [forms layer] (ae-text forms layer amd64))
  (^String [forms layer d]
  (str (layout/form-str (header-of d)) "\n"
       (apply str (map #(str (layout/form-str %) "\n") forms))
       (when layer (full/layer-text layer)))))

(defn- strip-line [x]
  (cond (seq? x) (apply list (map strip-line x)) (vector? x) (mapv strip-line x) (map? x) (into {} (map (fn [[k v]] [k (strip-line v)]) x)) :else x))

(defn read-ae-dialect
  "The dialect of an `.ae` text, its header's map."
  [^String text]
  (let [h (read-string text)]
    (when-not (and (seq? h) (= 'asm/unit (first h)) (map? (second h)))
      (throw (ex-info "not an assembly .ae text: no (asm/unit ...) header" {})))
    (second h)))

(defn read-ae
  "The items of an `.ae` text (its header checked and left out)."
  [^String text]
  (let [r (arbace.lang.LineNumberingPushbackReader. (java.io.StringReader. text))
        eof (Object.)
        xs (loop [out []] (let [x (read r false eof)] (if (identical? x eof) out (recur (conj out (strip-line x))))))]
    (when-not (and (seq? (first xs)) (= 'asm/unit (ffirst xs))) (throw (ex-info "not an assembly .ae text: no (asm/unit ...) header" {})))
    (vec (rest xs))))

(defn- reason ^String [^Throwable e]
  (str (if-let [c (:asm/refused (ex-data e))] (str (name c) ": ") "crash: ")
       (-> (str (.getMessage e)) (str/replace #"[\t\n\r]" " ") (str/replace "\"" "'") (str/replace "\\" "(backslash)") (str/replace #"[^ -~]" "?"))))

(defn check-one
  "One file's round trip: read in :full; the `.ae` text read back (forms and layer equal); printed back with the layer
  (the original byte for byte); the canonical print read again (the same forms, no layer). Writes the `.ae` text at
  `ae-path`; [status detail items gaps texts], status ok, refused, crash, ae-differs, layer-differs, text-differs,
  forms-differ or canon-layer."
  ([^String path ^String ae-path] (check-one path ae-path amd64))
  ([^String path ^String ae-path d]
  (try
    (let [src (latin1 path)
          {:keys [forms layer]} (read-full src d)
          ae (ae-text forms layer d)
          _ (spit-latin1 ae-path ae)
          back (read-ae ae)
          canon (print-text forms d)
          again (read-full canon d)
          st (full/layer-stats layer)
          status (cond
                   (not= back forms) "ae-differs"
                   (not= (read-ae-dialect ae) d) "ae-differs"
                   (not= (full/layer-of-ae ae) layer) "layer-differs"
                   (not= (print-full forms layer d) src) "text-differs"
                   (not= (:forms again) forms) "forms-differ"
                   (or (seq (:at (:layer again))) (:end (:layer again))) "canon-layer"
                   :else "ok")]
      [status "" (count forms) (:gaps st) (:texts st)])
    (catch Throwable e
      [(if (:asm/refused (ex-data e)) "refused" "crash") (reason e) 0 0 0]))))

(defn control
  "A negative control: the subject's `.ae` (written in :full) printed back with its layer, against the reference's
  original text: `differs` (as it must) or `same`."
  [^String subject-ae ^String ref-path]
  (let [ae (latin1 subject-ae)]
    (if (= (print-full (read-ae ae) (full/layer-of-ae ae) (read-ae-dialect ae)) (latin1 ref-path)) "same" "differs")))

(defn- pool-map [f rows]
  (let [threads (Integer/parseInt (or (System/getenv "REPR_ASM_THREADS") "4"))
        pool (Executors/newFixedThreadPool threads)
        futs (mapv (fn [r] (.submit pool ^Callable (fn [] (f r)))) rows)
        res (mapv #(.get ^Future %) futs)]
    (.shutdown pool)
    res))

(defn- opt [r k] (second (drop-while #(not= k %) r)))
(defn- drop-opts [r ks] (loop [r r out []] (cond (empty? r) out (ks (first r)) (recur (drop 2 r) out) :else (recur (rest r) (conj out (first r))))))

(defn -main
  "bin/repr-asm read [--arch A] [--syntax S] [--full] FILE [-o OUT.ae]; print [--full] FILE.ae [-o OUT] (the dialect the
  header's); check [--arch A] LIST WORK (each NAME<tab>PATH<tab>FLAGS, FLAGS naming `apple` or `plan9` for that syntax:
  WORK/check.tsv, NAME STATUS ITEMS GAPS TEXTS DETAIL, the .ae texts in WORK/ae/); control SUBJECT.ae REFERENCE."
  [& args]
  (let [[verb & r] args
        full? (some #{"--full"} r)
        r (remove #{"--full"} r)
        arch (opt r "--arch")
        syntax (opt r "--syntax")
        r (drop-opts r #{"--arch" "--syntax"})
        out (opt r "-o")
        r (take-while #(not= "-o" %) r)
        emit (fn [^String s] (if out (spit-latin1 out s) (do (print s) (flush))))]
    (case verb
      "read" (let [src (latin1 (first r))
                   d (dialect arch syntax (first r))]
               (emit (if full?
                       (let [{:keys [forms layer]} (read-full src d)] (ae-text forms layer d))
                       (ae-text (read-text src d) nil d))))
      "print" (let [ae (latin1 (first r))
                    d (read-ae-dialect ae)
                    forms (read-ae ae)
                    layer (when full? (full/layer-of-ae ae))]
                (emit (if layer (print-full forms layer d) (print-text forms d))))
      "check" (let [[lst work] r
                    rows (for [l (str/split-lines (slurp lst)) :when (seq l)] (str/split l #"\t"))
                    res (pool-map (fn [[n p fl]]
                                    (let [fl (set (str/split (or fl "") #" "))
                                          d (dialect arch (cond (fl "plan9") "plan9" (fl "apple") "apple" (fl "intel") "intel") p)]
                                      (into [n] (check-one p (str work "/ae/" n ".ae") d))))
                                  rows)]
                (spit-latin1 (str work "/check.tsv")
                             (apply str (map (fn [[n s d i g t]] (str n "\t" s "\t" i "\t" g "\t" t "\t" d "\n")) res)))
                (let [ok (count (filter #(= "ok" (second %)) res))]
                  (println (str "repr-asm check: " ok " of " (count res) " ok"))))
      "control" (println (control (first r) (second r)))
      (do (binding [*out* *err*] (println "repr-asm: read|print|check|control")) (System/exit 2)))
    (shutdown-agents)))

(ns arbace.repr.haskell.errors
  "The parser's messages as ghc -fno-code prints them (doc/haskell/NATIVE.md, \"Messages\").

  A message is {:con :span :args}: :con GHC's PsMessage constructor as a keyword (:PsErrParse,
  :PsErrLexer, :PsWarnTab...), :span the native reader's span, :args the constructor's fields as the
  native reader has them (names, located nodes, keywords for GHC's enumerations, strings).
  (text msgs opts) is what GHC's driver writes to standard error for them: each message sorted by
  its span (sortMsgBag's leftmost_smallest), then `FILE:LINE:COL: error: [GHC-NNNNN]` (or `warning:
  [GHC-NNNNN] [-Wflag]`) hung over the message's text and hints (printMessages, formatBulleted),
  the caret lines of the span's first line (getCaretDiagnostic: the line read from the file the
  span names, through opts' :source-line), a blank line."
  (:require [arbace.repr.haskell.ast :as a]
            [arbace.repr.haskell.doc :as d :refer [text <> <+> $$ $+$ nest hang vcat sep quotes]]
            [arbace.repr.haskell.pprhs :as ph]
            [arbace.string :as str]))

(set! *warn-on-reflection* true)

(defn msg "A message: constructor con at span, its fields args" [con span & args]
  {:con con :span span :args (vec args)})


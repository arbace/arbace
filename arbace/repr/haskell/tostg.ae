(ns arbace.repr.haskell.tostg
  "Core to STG for Arbace's Haskell front end (doc/haskell/FRONTEND-SURVEY.md, HF6, Tier S): the desugared program
  (arbace.repr.haskell.desugar, the tc vocabulary) prepared and translated into STG forms in hsi's format
  (doc/haskell/STG-SPEC.md, the format tools/hsdump's stg mode writes), one MODULE.stg.ae per module.

  It follows GHC 9.14.1's passes (compiler/GHC/CoreToStg/Prep.hs, CoreToStg.hs, Stg/Unarise.hs, Stg/FVs.hs;
  BSD-3-Clause, LICENSE.md) on the untyped Core it gets: CorePrep's A-normal form (every non-trivial argument
  let-bound to a `sat` binder, the last argument's binding outermost as cpeArgs makes them; a string literal's
  Addr# bound by a case; data constructors saturated: a saturated application is a constructor application, an
  unsaturated one calls the constructor's worker, whose binding the module carries as Prep's mkDataConWorkers
  writes it; a strict field's argument evaluated first, the $WCon wrapper's work), CoreToStg's right-hand sides (a
  lambda a re-entrant closure, a saturated constructor of atoms an StgRhsCon, anything else an updatable thunk), the
  closures' free variables (Stg/FVs: the local variables a closure mentions and does not bind, top-level binders
  excluded), and Unarise, which on Haskell 2010's programs (no unboxed tuples or sums, State# never in user code
  at the source level) leaves the program as it is. Representations come from the constructors: a primitive
  field's binder takes the field's PrimRep from its constructor's stg/data form (the libraries' dumps for the
  libraries' constructors), every other binder is lifted (:L).

  Dictionaries: a class with exactly one method and no superclass, or one superclass and no method, is a newtype
  (GHC's mkClass): its constructor is the identity and its selector returns the dictionary; the module's other
  classes get their data type (C:Cls) and their selectors (the methods' and the superclasses' $pNCls) as GHC's
  MkId.mkDictSelId writes them. A newtype's constructor is the identity likewise."
  (:require [arbace.string :as str]
            [arbace.repr.haskell.desugar :as ds]
            [arbace.repr.haskell.simplify :as simpl]
            [arbace.repr.haskell.typecheck :as tc])
  (:import [java.io File]))

(def ^:dynamic *r* nil)       ; the elaborator's result
(def ^:dynamic *units* nil)   ; {MODULE {:unit U :file PATH}}
(def ^:dynamic *names* nil)   ; atom {lv "occ_N"}
(def ^:dynamic *n* nil)       ; atom counter
(def ^:dynamic *reps* nil)    ; atom {"name" rep}
(def ^:dynamic *tops* nil)    ; #{top-level names}
(def lib-data (atom {}))      ; {MODULE {CON {:reps [...] :marks [...] :tycon T}}}
(def ^:dynamic *unit* "main") ; the unit the module is compiled in (HF10: a boot library's, ghc-internal)
(def ^:dynamic *o0-layout* nil) ; HF10-P20: the unit's constructors laid out at -O0, from their types (lib-check --ifaces own and
                                ; lib-stg --ifaces own: the own set; lib-stg on GHC's interfaces merges over the -O2 pack's layout)

(defn- head? [x h] (and (seq? x) (= h (first x))))
(defn- lv? [x] (head? x 'lv))
(defn- module [] (:module *r*))

;;; ------------------------------------------------------------------------------------------
;;; Names

(defn units-of
  "The library dumps' directories (stg/PKG/M.stg.ae): {MODULE {:unit U :file PATH}}"
  [dirs]
  (into {} (for [d dirs :let [pk (.listFiles (File. ^String d))] :when pk
                 ^File p pk :let [fs (.listFiles p)] :when fs
                 ^File f fs :let [nm (.getName f)] :when (str/ends-with? nm ".stg.ae")]
             (let [line (with-open [r (java.io.BufferedReader. (java.io.FileReader. f))] (.readLine r))
                   u (second (re-find #":unit \"([^\"]*)\"" (or line "")))]
               [(subs nm 0 (- (count nm) 7)) {:unit u :file (.getPath f)}]))))

(defn- ext-str [m o]
  (if (= m (module))
    (str *unit* ":" m "/" o)
    ;; GHC.Internal.Prim has no STG of its own (the wired-in interface, primops.txt.pp's): ghc-internal's, whether or not the
    ;; libraries hold GHC's stub module of it (HF10-P19 (a): the own libraries do not)
    (str (or (:unit (get *units* m)) (when (= m "GHC.Internal.Prim") "ghc-internal") "main") ":" m "/" o)))

(defn- clean-occ [o] (str/replace (str o) #"[:/]" "_"))

(defn- simpl-eta-tag [x] (arbace.repr.haskell.core/eta-tag x))

(defn- local-name [x]
  (or (get @*names* x)
      ;; CorePrep's eta binders: one name a position (their builtin uniques)
      (let [n (if-let [t (simpl-eta-tag x)] (str "eta_E" t) (str (clean-occ (second x)) "_" (swap! *n* inc)))]
        (swap! *names* assoc x n) n)))

(defn- fresh [o] (str o "_" (swap! *n* inc)))

(declare newtype-class?)

(defn- class-con-info
  "A class's dictionary constructor C:Cls as a constructor: its superclasses' and methods' fields"
  [c]
  (when (and (vector? c) (str/starts-with? (nth c 3) "C:"))
    (let [cls ["ext" "tc" (nth c 2) (subs (nth c 3) 2)] i (get (:all-classes *r*) cls)]
      (when (and i (not (newtype-class? cls)))
        {:arity (+ (or (:nsupers i) (count (:supers i))) (count (:methods i))) :tycon cls :tag 1}))))

(defn- iface-con-dicts
  "HF10-P20: an imported constructor's context dictionaries (its interface's arity is the source arity, the fields
  alone; the worker takes the dictionaries first: Exception.Context's SomeExceptionAnnotation applied to its
  ExceptionAnnotation dictionary alone was taken as saturated and built)"
  [c i]
  (if (or (contains? i :dicts) (nil? (:arity i)))
    0
    (let [t (or (get (:genv *r*) c) (get (:types *r*) c))]
      (if (and (vector? t) (= :forall (first t))) (count (nth t 2)) 0))))

(def ^:private con-info-cache (atom [nil {}]))
(defn- con-info [c]
  (if-let [i (get (:all-cons *r*) c)]
    (let [[r0 m] @con-info-cache m (if (identical? r0 *r*) m {})]
      (or (get m c)
          (let [k (iface-con-dicts c i) i2 (if (pos? k) (assoc i :arity (+ k (:arity i)) :dicts k) i)]
            (reset! con-info-cache [*r* (assoc m c i2)])
            i2)))
    (class-con-info c)))
(defn- con-name? [g] (and (vector? g) (some? (con-info (assoc g 1 "data")))))
(defn- as-data [g] (assoc g 1 "data"))

(defn- tycon-of [c] (:tycon (con-info c)))
(defn- newtype-con? [c] (= 'newtype (:flavour (get (:tycons *r*) (tycon-of c)))))

(defn- newtype-class? [cls]
  (let [i (get (:all-classes *r*) cls)] (and i (= 1 (+ (count (:methods i)) (or (:nsupers i) (count (:supers i))))))))

(defn- class-of-dcon
  "C:Cls's class"
  [g]
  (when (and (vector? g) (str/starts-with? (nth g 3) "C:"))
    (let [cls ["ext" "tc" (nth g 2) (subs (nth g 3) 2)]] (when (get (:all-classes *r*) cls) cls))))

(defn- newtype-selector?
  "The one method or superclass selector of a newtype class"
  [g]
  (and (vector? g)
       (some (fn [[cls i]] (and (newtype-class? cls)
                                (or (= g (first (:methods i)))
                                    (and (seq (:supers i)) (= (nth g 3) (str "$p1" (nth cls 3))) (= (nth g 2) (nth cls 2))))))
             (:all-classes *r*))))

(defn- lib-cons
  "The stg/data forms of a library module's dump: {CON {:reps :marks :tycon}}"
  [m]
  (or (get @lib-data m)
      (let [f (:file (get *units* m))
            res (if-not f {}
                  (with-open [rd (java.io.BufferedReader. (java.io.FileReader. ^String f))]
                    (loop [out {}]
                      (let [l (.readLine rd)]
                        (cond (nil? l) out
                              (str/starts-with? l "(stg/data ")
                              (let [[_ t dcs] (read-string l)]
                                (recur (into out (for [[_ c _ reps marks] dcs] [c {:reps reps :marks marks :tycon t}]))))
                              :else (recur out))))))]
        (swap! lib-data assoc m res) res)))

(declare global-type arg-types type-reps reps->rep)

(defn- con-reps [c]
  (if (= (nth c 2) (module))
    ;; the module's own constructor: its fields' representations from its type
    (let [ar (or (:arity (con-info c)) 0)
          ts (when-let [t (global-type c)] (arg-types t))]
      (if (= ar (count ts)) (mapv (comp reps->rep type-reps) ts) (vec (repeat ar :L))))
    (or ;; HF10-P20: a boot library compiled at -O0 (not a program, unit main) sees its own and its dependencies'
        ;; constructors as -O0 lays them out, from their types: the -O2 libraries' dumps hold an UNPACKed strict field
        ;; unboxed (SrcLoc's lines and columns: $WSrcLoc unboxed I# 315# into a field the own SrcLoc keeps boxed)
        ;; (the unit's own constructors only: GHC's -O0 reference compiles each package against the installed packages'
        ;; -O2 interfaces, so base's -O0 STG holds ghc-internal's SrcLoc unpacked; a coherent own base, P19's, wants the
        ;; -O0 layout of every package; a module *units* does not know is another unit's, as `ext-str` takes it: review
        ;; 1111, finding 8)
        (when (and *o0-layout* (not= "main" *unit*)
                   (= *unit* (:unit (get *units* (nth c 2)))))
          (let [ci (con-info c) ar (:arity ci) d (or (:dicts ci) 0) ts (when-let [t (global-type c)] (arg-types t))]
            (when (and ar (= ar (+ d (count ts)))) (into (vec (repeat d :L)) (map (comp reps->rep type-reps) ts)))))
        (:reps (get (lib-cons (nth c 2)) (ext-str (nth c 2) (nth c 3))))
        (vec (repeat (or (:arity (con-info c)) 0) :L)))))

(defn- con-strict [c]
  (if (= (nth c 2) (module))
    (vec (:strict (con-info c)))
    (mapv #(= :strict %) (:marks (get (lib-cons (nth c 2)) (ext-str (nth c 2) (nth c 3)))))))

(defn- tycon-str [c]
  (let [t (tycon-of c)] (when t (ext-str (nth t 2) (nth t 3)))))

;;; ------------------------------------------------------------------------------------------
;;; Literals

(defn- utf8-bytes
  "A string's modified UTF-8 (NUL as C0 80, GHC's utf8EncodeByteString of a string literal), one char a byte"
  [^String s]
  (apply str (mapcat (fn [b] (let [b (bit-and (int b) 255)] (if (zero? b) [(char 0xC0) (char 0x80)] [(char b)])))
                     (.getBytes s "UTF-8"))))

(defn lit-form
  "A Core literal's text as an STG literal and its PrimRep"
  [t]
  (cond
    (re-matches #"-?[0-9]+#w64" t) [(list 'word64 (bigint (read-string (subs t 0 (- (count t) 4))))) :word64]
    (re-matches #"-?[0-9]+##" t) [(list 'word (read-string (subs t 0 (- (count t) 2)))) :word]
    (re-matches #"-?[0-9]+#" t) [(list 'int (read-string (subs t 0 (dec (count t))))) :int]
    (re-matches #"'\(char [0-9]+\)'#" t) [(list 'char (read-string (second (re-find #"char ([0-9]+)" t)))) :word]
    (re-matches #"(?s)'.*'#" t) [(list 'char (int (.charAt ^String t 1))) :word]
    (re-matches #"(?s)\".*\"#" t) [(list 'str (utf8-bytes (read-string (subs t 0 (dec (count t)))))) :addr]
    ;; a primitive string literal of bytes (HsStringPrim's ByteString, the elaborator's (bytes "...")#): its bytes as
    ;; they are, one char a byte (HF10-P20: the Unicode tables' bitmaps were the literal 0, lookupIntN read address 0)
    (re-matches #"(?s)\(bytes (\".*\")\)#" t)
    [(list 'str (apply str (map (fn [c] (char (bit-and (int c) 255))) (read-string (second (re-matches #"(?s)\(bytes (\".*\")\)#" t)))))) :addr]
    (re-matches #"-?Infinity##" t) [(list 'double (str "0x" (Long/toHexString (Double/doubleToRawLongBits (Double/parseDouble (subs t 0 (- (count t) 2))))))) :double]
    (re-matches #"-?Infinity#" t) [(list 'float (str "0x" (Integer/toHexString (Float/floatToRawIntBits (Float/parseFloat (subs t 0 (dec (count t)))))))) :float]
    (re-matches #"-?[0-9.eE+-]+##" t) [(list 'double (str "0x" (Long/toHexString (Double/doubleToRawLongBits (Double/parseDouble (subs t 0 (- (count t) 2))))))) :double]
    (re-matches #"-?[0-9.eE+-]+#" t) [(list 'float (str "0x" (Integer/toHexString (Float/floatToRawIntBits (Float/parseFloat (subs t 0 (dec (count t)))))))) :float]
    (re-matches #"(?s)\".*\"" t) [(list 'str (utf8-bytes (read-string t))) :addr]
    ;; HF10-P5 (a): a foreign import's label (dsFLabel's MachLabel), "&label:SYMBOL:fun|data"
    (str/starts-with? t "&label:") (let [[_ sym k] (re-matches #"(?s)&label:(.*):(fun|data)" t)] [(list 'label sym (keyword k)) :addr])
    :else (do (binding [*out* *err*] (println "tostg: literal not handled:" t)) [(list 'int 0) :int])))

(defn- hexify
  "The float literals' bits as 0x numbers (the reader takes 0x integers)"
  [s]
  (-> s
      (str/replace #"\((double|float) \"(0x[0-9a-f]+)\"\)" "($1 $2)")
      (str/replace #"\((word64|int64) ([0-9-]+)N\)" "($1 $2)")))

;;; ------------------------------------------------------------------------------------------
;;; Representations (GHC.Types.RepType's typePrimRep, Unarise's view: void components dropped)

(def ^:private prim-tycon-reps
  {"Int#" [:int] "Int8#" [:int8] "Int16#" [:int16] "Int32#" [:int32] "Int64#" [:int64]
   "Word#" [:word] "Word8#" [:word8] "Word16#" [:word16] "Word32#" [:word32] "Word64#" [:word64]
   "Char#" [:word] "Double#" [:double] "Float#" [:float] "Addr#" [:addr] "StablePtr#" [:addr]
   "State#" [] "Proxy#" [] "RealWorld" [:L]})

(defn- strip-forall [t] (if (= :forall (first t)) (recur (nth t 3)) t))
(defn- fun-ty? [t] (and (= :tc (first t)) (= tc/fun-tc (second t))))

(defn- expand-syn
  "A type synonym at the head expanded (the module's and its interfaces' synonyms, the elaborator's :syns): HF10's
  library types name their representations through synonyms (BigNat# = WordArray# = ByteArray#), typePrimRep looks
  through them"
  [t]
  (loop [t t k 0]
    (if-let [[tvs rhs] (and (< k 20) (= :tc (first t)) (get (:syns *r*) (second t)))]
      (let [as (nth t 2)]
        (if (and (>= (count as) (count tvs)) (or (= (count as) (count tvs)) (= :tc (first rhs))))
          (let [r (@#'tc/subst (zipmap tvs as) rhs)]
            (recur (if (> (count as) (count tvs)) [:tc (second r) (into (vec (nth r 2)) (drop (count tvs) as))] r) (inc k)))
          t))
      t)))

;;; HF10-P8 (a): unboxed sums (GHC 9.14.1's GHC.Types.RepType: SlotTy, primRepSlot, slotPrimRep, fitsIn, ubxSumRepType,
;;; layoutUbxSum; GHC.Stg.Unarise: mkUbxSum, ubxSumRubbishArg, unariseSumAlts, mapSumIdBinders), ported rule for rule (BSD-3,
;;; The University of Glasgow; LICENSE.md). A sum is unarised into an unboxed tuple: its tag (WordSlot, an Int# literal) and its
;;; slots, each alternative's fields laid out in the slots that fit them, the others the slot's rubbish.

(def ^:private slot-order {:lifted 0 :unlifted 1 :word 2 :word64 3 :float 4 :double 5}) ; SlotTy's constructors' order
(defn- prim-rep-slot [r]
  (case r :L :lifted :U :unlifted (:int64 :word64) :word64 (:int :int8 :int16 :int32 :word :word8 :word16 :word32 :addr) :word
        :float :float :double :double nil))
(defn- slot-prim-rep [sl] (case sl :lifted :L :unlifted :U :word :word :word64 :word64 :float :float :double :double))
(defn- fits-in [a b]
  (cond (= a b) a
        (and (#{:word :word64} a) (#{:word :word64} b)) (max-key slot-order a b)
        (and (#{:float :double} a) (#{:float :double} b)) (max-key slot-order a b)
        :else nil))
(defn- merge-slots [es ss]
  (cond (empty? ss) (vec es) (empty? es) (vec ss)
        :else (let [[e & ess] es [x & xs] ss]
                (if-let [f (fits-in x e)] (into [f] (merge-slots ess xs))
                    (if (< (slot-order x) (slot-order e)) (into [x] (merge-slots es xs)) (into [e] (merge-slots ess ss)))))))
(defn sum-slots
  "ubxSumRepType's slots after the tag: the alternatives' representations (each a vector of PrimReps) combined"
  [alt-reps]
  (when (every? (fn [rs] (every? prim-rep-slot rs)) alt-reps)
    (reduce merge-slots [] (map (fn [rs] (vec (sort-by slot-order (map prim-rep-slot rs)))) alt-reps))))
(defn- layout-sum
  "layoutUbxSum: each field's slot index in the sum's slots"
  [slots fields]
  (loop [fs fields used #{} out []]
    (if (empty? fs) out
        (let [f (first fs)
              i (first (keep-indexed (fn [i sl] (when (and (not (used i)) (= sl (fits-in f sl))) i)) slots))]
          (when i (recur (rest fs) (conj used i) (conj out i)))))))
(defn- sum-tc? [n] (and (vector? n) (= "GHC.Internal.Types" (nth n 2)) (re-matches #"Sum[0-9]+#" (nth n 3))))
(defn- usum-con
  "An unboxed sum's data constructor (#_|#), (#|_#)...: [alternative arity], 1-based, or nil"
  [g]
  (when (and (vector? g) (= "GHC.Internal.Types" (nth g 2)))
    (when-let [[_ o] (re-matches #"\(#([_|]+)#\)" (nth g 3))]
      (when (and (re-find #"\|" o) (= 1 (count (filter #{\_} o))))
        [(inc (.indexOf ^String o "_")) (count o)]))))

(def ^:dynamic *bkinds* nil) ; HF10-P20: the top-level binding's type variables' kept kinds ({TV kind-type}), its binders' reps
(declare kind-type)

(defn type-reps
  "A type's PrimReps after unarisation: a vector, empty for a void type"
  [t]
  (let [t (expand-syn (strip-forall t))]
    (if (= :tc (first t))
      (let [[_ n args] t]
        (cond
          ;; an unboxed sum: its tag and its slots (ubxSumRepType)
          (sum-tc? n) (if-let [sl (sum-slots (map type-reps args))] (into [:word] (map slot-prim-rep sl)) [:L])
          (and (= "GHC.Internal.Types" (nth n 2)) (re-matches #"Tuple[0-9]+#|Solo#|Unit#" (nth n 3))) (vec (mapcat type-reps args))
          (and (= "GHC.Internal.Prim" (nth n 2)) (contains? prim-tycon-reps (nth n 3))) (get prim-tycon-reps (nth n 3))
          (and (= "GHC.Internal.Prim" (nth n 2)) (str/ends-with? (nth n 3) "#")) [:U]
          :else [:L]))
      ;; HF10-P20: a type variable of the binding whose kind is kept (unsafeCoerceAddr's x :: a, a :: TYPE 'AddrRep)
      (if-let [kt (and (= :tv (first t)) (some-> (get *bkinds* (second t)) kind-type))]
        (type-reps kt)
        [:L]))))

(defn- newtype-unwrap
  "A newtype's application as its representation type (instNewTyCon_maybe; STG sees through newtypes), else nil"
  [t]
  (when (= :tc (first t))
    (let [[_ n args] t i (get (:tycons *r*) n)]
      (when (= 'newtype (:flavour i))
        (when-let [ct (let [c (first (:cons i))] (or (get (:genv *r*) c) (get (:types *r*) c)))]
          (let [[tvs body] (if (= :forall (first ct)) [(nth ct 1) (nth ct 3)] [[] ct])]
            (when (fun-ty? body)
              (@#'tc/subst (if args (zipmap tvs args) {}) (first (nth body 2))))))))))

(defn- result-type
  "A type after n arguments (dictionary arguments first), or nil"
  [t n]
  (let [t0 (if (= :forall (first t)) t [:forall [] [] t])
        preds (count (nth t0 2)) body (nth t0 3)]
    (if (< n preds) nil
        (loop [t body k (- n preds)]
          (cond (zero? k) t
                (= :forall (first t)) (recur (nth t 3) k)
                (fun-ty? t) (recur (second (nth t 2)) (dec k))
                ;; a synonym of a function type (HF10-P20: Latin1's DecodeBuffer# = ... -> DecodingBuffer#, itself
                ;; State# RealWorld -> (# ... #))
                (not= t (expand-syn t)) (recur (expand-syn t) k)
                ;; a newtype of one (ST s a = ST (STRep s a))
                (newtype-unwrap t) (recur (newtype-unwrap t) k)
                :else nil)))))

(defn- arg-types
  "A function type's argument types (after its dictionaries)"
  [t]
  (loop [t (strip-forall t) out []]
    (cond (fun-ty? t) (recur (strip-forall (second (nth t 2))) (conj out (first (nth t 2))))
          (not= t (expand-syn t)) (recur (strip-forall (expand-syn t)) out)
          :else out)))

(def ^:private rep-prim
  "A RuntimeRep's constructor -> a primitive type of that representation (kind-type's)"
  {"AddrRep" "Addr#" "IntRep" "Int#" "WordRep" "Word#" "Int8Rep" "Int8#" "Int16Rep" "Int16#" "Int32Rep" "Int32#"
   "Int64Rep" "Int64#" "Word8Rep" "Word8#" "Word16Rep" "Word16#" "Word32Rep" "Word32#" "Word64Rep" "Word64#"
   "FloatRep" "Float#" "DoubleRep" "Double#" "UnliftedRep" "ByteArray#"})

(defn- kind-type
  "HF10-P20: a type variable's kept kind (the elaborator's :tv-kinds) as a type of that representation: TYPE 'AddrRep an
  Addr#, UnliftedType or TYPE ('BoxedRep 'Unlifted) an unlifted pointer (ByteArray#'s); nil for another kind"
  [k]
  (let [p (fn [o] [:tc ["ext" "tc" "GHC.Internal.Prim" o] []])]
    (when (and (vector? k) (= :tc (first k)) (vector? (second k)))
      (case (nth (second k) 3)
        "UnliftedType" (p "ByteArray#")
        "TYPE" (let [r (first (nth k 2))]
                 (when (and (vector? r) (= :tc (first r)) (vector? (second r)))
                   (let [o (nth (second r) 3)]
                     (cond (contains? rep-prim o) (p (get rep-prim o))
                           (and (= "BoxedRep" o) (= "Unlifted" (some-> (first (nth r 2)) second (nth 3)))) (p "ByteArray#")))))
        nil))))


(defn- app-type
  "The type of f applied to args (dictionary arguments first), or nil: the declared result after the arguments; when the
  result is a type variable before they run out, the variable instantiated by an earlier argument whose declared type
  ends in it after n arrows: that argument's own type after n arguments (GHC's instantiation; HF10-P20: GHC.Magic's
  inline, lazy, oneShot, a -> a, bigNatCompare's `inline bignat_compare a b`, an Int#, was taken for a lifted value and
  bound by a thunk; runRW#'s (State# RealWorld -> o) -> o at runST's STRep s a, an unboxed pair)"
  [f args]
  (let [t (cond (and (seq? f) (= 'v (first f))) (or (get (:genv *r*) (second f)) (get (:types *r*) (second f)))
                (lv? f) (get (:ltypes *r*) f)
                ;; a cast function (a newtype's field matched: ST's m |> co :: STRep s a): the coercion's target
                (and (seq? f) (= 'cast (first f)) (map? (nth f 2 nil))) (:r (nth f 2)))]
    (when t
      (or (when (and (seq? f) (= 'v (first f)) (vector? (second f)) (seq args))
            ;; HF10-P20: a result whose type variable's kind is a representation's (unsafeCoerceAddr's b :: TYPE 'AddrRep)
            (when-let [ks (get (:tv-kinds *r*) (second f))]
              (let [r0 (some-> (result-type t (count args)) strip-forall)]
                (when (= :tv (first r0)) (some-> (get ks (second r0)) kind-type)))))
          (let [r0 (result-type t (count args))] (when (and r0 (not= :tv (first (strip-forall r0)))) r0))
          (let [t0 (if (= :forall (first t)) t [:forall [] [] t])
                p (count (nth t0 2))
                ats (arg-types t)
                ;; the arrows from an argument's declared type to the variable v: n, or nil
                ends-in (fn [at v] (loop [x (strip-forall at) n 0]
                                     (cond (= x v) n
                                           (fun-ty? x) (recur (strip-forall (second (nth x 2))) (inc n))
                                           (not= x (expand-syn x)) (recur (strip-forall (expand-syn x)) n)
                                           :else nil)))
                ;; an argument's own type (a variable's, a global's, an application's)
                type-of (fn [a] (cond (and (seq? a) (= 'app (first a))) (app-type (second a) (nth a 2))
                                      (and (seq? a) (= 'v (first a))) (or (get (:genv *r*) (second a)) (get (:types *r*) (second a)))
                                      (lv? a) (get (:ltypes *r*) a)
                                      (and (seq? a) (= 'cast (first a)) (map? (nth a 2 nil))) (:r (nth a 2))))]
            (some (fn [k]
                    (let [r (result-type t k)]
                      (when (and r (= :tv (first (strip-forall r))))
                        (let [v (strip-forall r)]
                          (some (fn [[i at]]
                                  (when-let [n (ends-in at v)]
                                    (let [a (nth args (+ p i))]
                                      (if (zero? n)
                                        ;; the argument is the result itself, applied to the rest
                                        (if (and (seq? a) (= 'app (first a)))
                                          (app-type (second a) (into (vec (nth a 2)) (drop k args)))
                                          (app-type a (vec (drop k args))))
                                        (when-let [ta (type-of a)]
                                          (when-let [o (result-type ta n)]
                                            (if (= k (count args)) o (result-type o (- (count args) k)))))))))
                                (map-indexed vector (take (- k p) ats)))))))
                  (range (inc p) (inc (count args)))))
          (result-type t (count args))))))

(def ^:dynamic *lreps* nil)   ; atom {(lv ...) reps}: the desugarer's binders' representations, from their right-hand sides

(defn- global-type [g] (or (get (:genv *r*) g) (get (:types *r*) g)))

(defn local-reps [x]
  (or (get @*lreps* x)
      (when-let [t (get (:ltypes *r*) x)] (type-reps t))
      [:L]))

(declare unboxed-con?)

(def ^:dynamic *body-type* nil)  ; HF10-P8: the top-level binding's result type after its lambdas (an unboxed sum's construction in it)

(defn expr-reps
  "A Core expression's representations"
  [e]
  (case (first e)
    lit (if (re-matches #"(?s)\".*\"" (second e)) [:L] [(second (lit-form (second e)))])
    lv (local-reps e)
    v (if-let [t (global-type (second e))] (if (seq (nth (if (= :forall (first t)) t [:forall [] [] t]) 2)) [:L] (type-reps t)) [:L])
    app (let [[_ f args] e]
          (cond (and (head? f 'v) (unboxed-con? (second f))) (vec (mapcat expr-reps args))
                ;; HF10-P8: an unboxed sum's construction, at the binding's result type (sum-rewrite's)
                (and (head? f 'v) (usum-con (second f)) *body-type*
                     (let [t (expand-syn (strip-forall *body-type*))] (and (= :tc (first t)) (sum-tc? (second t)))))
                (type-reps *body-type*)
                (or (head? f 'v) (lv? f) (head? f 'cast))
                (if-let [t (app-type f args)]
                  (type-reps t)
                  ;; HF10-P20: a polymorphic result over-applied (listArray's `foldr go (\_ s# -> s#) es 0# s2#`, b :=
                  ;; Int# -> State# s -> State# s): a lambda argument of as many binders as the arguments beyond the
                  ;; declared ones gives the result its body's representations
                  (let [gt (cond (head? f 'v) (global-type (second f)) (lv? f) (get (:ltypes *r*) f))
                        t0 (when gt (if (= :forall (first gt)) gt [:forall [] [] gt]))
                        k (when t0 (- (count args) (count (nth t0 2)) (count (arg-types gt))))]
                    (or (when (and k (pos? k))
                          (some (fn [a] (when (and (head? a 'lam) (= k (count (second a)))) (let [r (expr-reps (nth a 2))] (when (not= [:L] r) r))))
                                args))
                        [:L])))
                :else [:L]))
    ;; every alternative has the case's type: the first whose representations are known ([:L] is also the answer when
    ;; they are not; HF10-P20: listArray's `if n == 0 then s2# else foldr go k es 0# s2#`, a State#, was bound by a
    ;; thunk from the foldr branch, its writes never run: Array.! read arrEleBottom)
    case (let [alts (nth e 3) rs (map #(expr-reps (nth % 3)) alts)] (or (first (remove #{[:L]} rs)) [:L]))
    (let letrec) (expr-reps (nth e 2))
    [:L]))

(def ^:dynamic *multi* nil)   ; atom {(lv ...) [[name rep]...]}: an unboxed tuple's binder unarised into its components
(def ^:dynamic *njoins* nil)  ; atom #{name}: the nullary join points' names (a jump is an application, not their value)
(def ^:dynamic *mcomps* nil)  ; atom {(lv ...) [reps...]}: its components' representations, the void ones too

(defn- tuple-ty? [t] (let [t (strip-forall t)] (and (= :tc (first t)) (= "GHC.Internal.Types" (nth (second t) 2)) (re-matches #"Tuple[0-9]+#|Solo#|Unit#" (nth (second t) 3)))))

(defn expr-comps
  "An expression of an unboxed tuple type: each component's representations; nil for another type"
  [e]
  (case (first e)
    lv (get @*mcomps* e)
    app (let [[_ f args] e
              t (cond (and (head? f 'v) (unboxed-con? (second f))) :con
                      (or (head? f 'v) (lv? f) (head? f 'cast)) (app-type f args))]
          (cond (= :con t) (mapv expr-reps args)
                (and t (tuple-ty? t)) (mapv type-reps (nth (strip-forall t) 2))
                (and t (let [t (strip-forall t)] (and (= :tc (first t)) (sum-tc? (second t)))))
                (let [rs (type-reps t)] (when (not= [:L] rs) (mapv vector rs)))))
    case (let [alts (nth e 3)] (when (seq alts) (expr-comps (nth (first alts) 3))))
    (let letrec) (expr-comps (nth e 2))
    nil))

(defn- reps->rep [rs] (case (count rs) 0 :v 1 (first rs) (vec rs)))

(defn unboxed-con? [g] (and (vector? g) (= "GHC.Internal.Types" (nth g 2)) (re-matches #"\(#,*#\)|MkSolo#" (nth g 3))))

(defn- unboxed-name
  "The unboxed tuple constructor of k non-void components (Unarise's renaming)"
  [k]
  (ext-str "GHC.Internal.Types" (if (= 1 k) "MkSolo#" (str "(#" (apply str (repeat (dec k) ",")) "#)"))))

(defn- primop?
  "A primop of GHC.Internal.Prim (not one of the Ids with a compulsory unfolding or the void tokens)"
  [g]
  (and (vector? g) (= "GHC.Internal.Prim" (nth g 2))
       (not (contains? #{"seq" "coerce" "realWorld#" "void#" "nullAddr#" "proxy#"} (nth g 3)))
       (some? (global-type g))))

(declare arg-types)

(defn- primop-value?
  "A primop of a function type as a value (no arguments): CorePrep's maybeSaturate eta-expands it (HF10-P20:
  GHC.Internal.Bignum.WordArray's mwaWrite# = writeWordArray#)"
  [e]
  (and (seq? e) (= 'v (first e)) (primop? (second e)) (pos? (count (arg-types (global-type (second e)))))))

(defn- primop-eta
  "A primop value eta-expanded to its arity: \\xs -> op xs (maybeSaturate)"
  [e]
  (let [tys (arg-types (global-type (second e)))
        xs (mapv (fn [i] (list 'lv "eta" (str "E" (inc i) ".pv" (swap! *n* inc)))) (range (count tys)))]
    (doseq [[x t] (map vector xs tys)] (swap! *lreps* assoc x (type-reps t)))
    (list 'lam xs (list 'app e xs))))

(defn- void-global? [g] (and (vector? g) (= "GHC.Internal.Prim" (nth g 2)) (contains? #{"realWorld#" "void#"} (nth g 3))))

;;; ------------------------------------------------------------------------------------------
;;; A-normal form and STG (CorePrep and CoreToStg together)

(declare expr rhs)

(def ^:dynamic *internal-tops* {}) ; the module's top-level binders it does not export: their internal names (Tidy's
                                   ; tidyTopName: external only when exported, -O0 exposing no unfolding)

(defn- gname [g] (or (get *internal-tops* g) (ext-str (nth g 2) (nth g 3))))

(defn- flatten-app [e]
  (if (and (head? e 'app) (head? (second e) 'app))
    (flatten-app (list 'app (second (second e)) (into (nth (second e) 2) (nth e 2))))
    e))

(defn- string-lit? [a] (and (head? a 'lit) (or (re-matches #"(?s)\".*\"#?" (second a)) (re-matches #"(?s)\(bytes \".*\"\)#" (second a)))))

(def ^:dynamic *joins* nil)   ; atom #{name}: the failure join points (their calls pass the void (##))

(defn- void-atom [] (ext-str "GHC.Internal.Prim" "void#"))

(declare floatable-con atomic-args? fail-var?)

(def ^:dynamic *rec-ids* #{}) ; the enclosing recursive group's top-level names (CorePrep's cpe_rec_ids)
(def ^:dynamic *body-tycon* nil) ; the top-level binding's result type constructor after its lambdas, when a data type
(def ^:dynamic *arities* {})  ; the module's top-level binders (Core's lv or name vector) -> their lambdas' count

(defn- pap-eta
  "CorePrep's cpeArg at -O0 (cpeArgArity's exprArity, cpeEtaExpand): an argument that is a partial application of one
  of the module's top-level functions, whose arity is known, is eta-expanded to that arity: a function closure, not a
  thunk (the imported functions' arities are not in -O0 interfaces: GHC's -fomit-interface-pragmas). The lambda, or
  nil"
  [a]
  (let [a (flatten-app a)]
    (when (and (head? a 'app) (or (lv? (second a)) (head? (second a) 'v)))
      (let [f (second a) k (if (lv? f) f (second f)) ar (get *arities* k) args (nth a 2)]
        (when (and ar (> ar (count args)) (pos? (count args)))
          (let [xs (mapv (fn [i] (list 'lv "eta" (str "E" (inc i) ".pe" (swap! *n* inc)))) (range (- ar (count args))))
                t (if (lv? f) (get (:ltypes *r*) f) (global-type k))
                tys (when t (drop (count args) (arg-types t)))]
            (doseq [[x t2] (map vector xs (concat tys (repeat nil)))] (swap! *lreps* assoc x (if t2 (type-reps t2) [:L])))
            (list 'lam xs (list 'app f (into (vec args) xs)))))))))

(defn- spec-eval
  "CorePrep's speculative evaluation (Note [Speculative evaluation], mkNonRecFloat's exprOkForSpecEval with
  -fspec-eval and -fspec-eval-dictfun on, their defaults): a binding of a superclass selection from a dictionary (a
  ClassOpId whose result is a dictionary, is_terminating_result) or of a saturated dictionary function's application
  (a DFunId of a class that is not unary) is case-bound, not a thunk; never a call of the enclosing recursive group.
  The alternatives' type, (alg CLASS) or (poly), or nil when the expression is not ok for speculation"
  [e]
  (let [e (flatten-app e)]
    (when (and (head? e 'app) (head? (second e) 'v) (vector? (second (second e))))
      (let [g (second (second e)) args (nth e 2) o (nth g 3)
            t (global-type g)
            npreds (if (and t (= :forall (first t))) (count (nth t 2)) 0)
            res (when t (strip-forall (result-type t (count args))))
            ;; the dictionary's class: a selector's superclass (the class's :supers), a DFun's result (a type or a
            ;; predicate [CLASS TYPES])
            sel (when-let [[_ k c] (re-find #"^\$p([0-9]+)(.*)$" o)]
                  (let [info (get (:all-classes *r*) ["ext" "tc" (nth g 2) c])]
                    (first (nth (vec (:supers info)) (dec (Long/parseLong k)) nil))))
            cls (or sel
                    (when (vector? res) (cond (= :tc (first res)) (second res) (vector? (first res)) (first res))))
            alg (fn [] (if (vector? cls) (list 'alg (ext-str (nth cls 2) (nth cls 3))) '(poly)))]
        (cond
          (contains? *rec-ids* (gname g)) nil
          (and (re-find #"^\$p[0-9]+" o) (= 1 (count args)) (atomic-args? args)) (alg)
          (and (str/starts-with? o "$f") (pos? npreds) (= npreds (count args)) cls
               (every? #(or (atomic-args? [%]) (spec-eval %)) args)
               (contains? (:all-classes *r*) cls) (not (newtype-class? cls)))
          (alg)
          :else nil)))))

(defn- atom-of
  "An argument as an atom: [atom [[name stg-rhs]...]], the bindings outermost first; a saturated constructor
  application's own arguments' bindings floated out before it (CorePrep floats out of a value's right-hand side)"
  [a]
  (cond
    (and (lv? a) (contains? @*joins* (local-name a))) (let [n (fresh "sat")] [n [[n (list 'closure :u :fvs [] (list 'app (local-name a) [(void-atom)]))]]])
    ;; an equality constraint's evidence: the boxed (~)'s Eq# (its coercion field void)
    (head? a 'co) (let [n (fresh "$d~")] [n [[n (list 'rcon (ext-str "GHC.Internal.Types" "Eq#") [])]]])
    (and (lv? a) (empty? (local-reps a))) [(void-atom) []]
    (lv? a) [(local-name a) []]
    ;; Unarise's unariseFunArg: a global is no binder of rho, kept (realWorld#: dsFCall's and runRW#'s token); void# itself
    (and (head? a 'v) (void-global? (second a))) [(if (= "realWorld#" (nth (second a) 3)) (gname (second a)) (void-atom)) []]
    ;; HF10-P37: (##) as an argument is a void argument (unariseFunArg's MultiVal [] -> voidArg)
    (and (head? a 'v) (unboxed-con? (second a)) (= "(##)" (nth (second a) 3))) [(void-atom) []]
    (and (head? a 'v) (con-name? (second a)) (newtype-con? (as-data (second a)))) (let [n (fresh "sat")] [n [[n (rhs a)]]])
    ;; a data constructor of fields as an argument: CorePrep saturates it (maybeSaturate), a function closure
    (and (head? a 'v) (con-name? (second a)) (not (unboxed-con? (second a))) (not (class-of-dcon (second a)))
         (pos? (or (:arity (con-info (as-data (second a)))) 0)))
    (let [c (as-data (second a)) ar (:arity (con-info c)) rs (concat (con-reps c) (repeat :L))
          xs (mapv (fn [i] (list 'lv "eta" (str "E" (inc i) ".pc" (swap! *n* inc)))) (range ar))
          n (fresh "sat")]
      (doseq [[x r] (map vector xs rs)] (swap! *lreps* assoc x (if (= :v r) [] [r])))
      [n [[n (rhs (list 'lam xs (list 'app a xs)))]]])
    ;; a newtype class's selector on an atom (ip d): d |> co, trivial (CorePrep: the selector has no binding, its
    ;; unfolding \d -> d |> co)
    (let [a (flatten-app a)]
      (and (head? a 'app) (head? (second a) 'v) (newtype-selector? (second (second a))) (= 1 (count (nth a 2)))
           (atomic-args? (nth a 2))))
    (atom-of (first (nth (flatten-app a) 2)))
    ;; a newtype class's dictionary constructor on an expression (C:IP e): its unfolding \x -> x |> co applied, a
    ;; thunk of let x = e in x
    (let [a (flatten-app a)]
      (and (head? a 'app) (head? (second a) 'v) (class-of-dcon (second (second a))) (newtype-class? (class-of-dcon (second (second a))))
           (= 1 (count (nth a 2))) (not (atomic-args? (nth a 2)))))
    (let [e (first (nth (flatten-app a) 2)) n (fresh "sat") x (fresh "x")]
      [n [[n (list 'closure :u :fvs [] (list 'let (list 'bind [x :L] (rhs e)) (list 'app x [])))]]])
    (primop-value? a) (let [n (fresh "sat")] [n [[n (rhs a)]]])
    (head? a 'v) [(gname (second a)) []]
    (and (head? a 'lit) (not (string-lit? a))) [(first (lit-form (second a))) []]
    (floatable-con a) (let [[c args] (floatable-con a) rs (mapv atom-of args) n (fresh "sat")]
                        [n (conj (vec (mapcat second (reverse rs))) [n (list 'rcon (gname c) (mapv first rs))])])
    ;; a speculatable dictionary: case-bound (Note [Speculative evaluation])
    (spec-eval a)
    (let [at (spec-eval a) n (fresh "sat")]
      (swap! *reps* assoc n :L)
      [n [[:case n :L (expr a) at]]])
    ;; an argument of an unlifted type: evaluated first, case-bound (CorePrep's cpeArg: a case float)
    (not= [:L] (expr-reps a))
    (let [rs (expr-reps a) r (reps->rep rs) n (fresh "sat")]
      (swap! *reps* assoc n r)
      ;; a void argument (a State# token's computation): evaluated by a case on (##), the argument void# (Unarise
      ;; erases the void binder; HF10-P20: bignat_quotrem's mwaTrimZeroes# result passed on was an unbound sat)
      (if (empty? rs)
        [(void-atom) [[:case n :v (expr a) '(multi 0)]]]
        [n [[:case n r (expr a)]]]))
    ;; an argument of lifted lets around a value: the lets float out of it (CorePrep's cpeArg, wantFloatNested: lazy
    ;; floats and a value)
    (and (head? a 'let) (let [inner (loop [x a] (if (and (head? x 'let) (= 1 (count (second x)))) (recur (nth x 2)) x))]
                          (or (head? inner 'lam) (floatable-con inner))))
    (let [[binds inner] (loop [x a out []]
                          (if (and (head? x 'let) (= 1 (count (second x))))
                            (let [[_ b r] (first (second x))] (recur (nth x 2) (conj out [b r])))
                            [out x]))]
      (if (every? (fn [[b _]] (and (lv? b) (= [:L] (local-reps b)) (not (fail-var? b)) (not (:join (meta b))))) binds)
        (let [[at bs] (atom-of inner)]
          [at (into (vec (for [[b r] binds] [(local-name b) (rhs r)])) bs)])
        (let [n (fresh "sat")] [n [[n (rhs a)]]])))
    :else (let [n (fresh "sat")] [n [[n (rhs (or (pap-eta a) a))]]])))

(declare float-scrut)

(defn- prim-alt
  "CoreToStg's mkStgAltType for a case on one non-tuple value: PrimAlt of its PrimRep, but a pointer's (an unlifted
  boxed type like ByteArray#, not an algebraic one) PolyAlt"
  [r]
  (if (#{:U :L} r) '(poly) (list 'prim r)))

(defn- wrap-binds [bnds body]
  (reduce (fn [b [n r :as bd]]
            (if (= :case n)
              (let [[_ x rep ex at] bd]
                ;; a case float (CorePrep's CaseBound Float): marked, so that a case on it floats it out of its scrutinee;
                ;; the floats of its own right-hand side float out with it (cpeArg's floats join the enclosing ones)
                (float-scrut ex
                  (fn [ex] (with-meta (list 'case ex [x rep] (or at (if (vector? rep) (list 'multi (count rep)) (prim-alt rep)))
                                            [(list 'alt (if (= '(multi 0) at) (unboxed-name 0) :default) [] b)])
                             {:float true}))))
              (list 'let (list 'bind [n :L] r) b)))
          body (reverse bnds)))

(declare expr)

(declare sum-comps)

(defn- tuple-comps-of
  "An application of an unboxed tuple type (a function's or a primop's result): its components' representations; of an
  unboxed sum type its tag's and slots' (HF10-P37: ubxSumRepType's)"
  [a]
  (when (head? a 'app)
    (let [[_ f args] a
          t (when (or (head? f 'v) (lv? f) (head? f 'cast)) (app-type f args))]
      (cond (and t (tuple-ty? t)) (mapv type-reps (nth (strip-forall t) 2))
            t (sum-comps t)))))

(declare sum-args)

(defn- void-atomic?
  "HF10-P37: an argument of a void representation that evaluates nothing: (##), void#, realWorld#, a void local, an unboxed
  tuple of such"
  [a]
  (or (and (head? a 'v) (or (void-global? (second a)) (and (unboxed-con? (second a)) (= "(##)" (nth (second a) 3)))))
      (and (lv? a) (not (contains? @*joins* (local-name a))) (empty? (local-reps a)) (empty? (get @*multi* a)))
      (and (head? a 'app) (head? (second a) 'v) (unboxed-con? (second (second a))) (every? void-atomic? (nth a 2)))))

(defn- with-atoms
  "Atoms for the arguments, their bindings let around k's expression, the last argument's outermost; an argument of an
  unboxed tuple type unarised into its components (Unarise's unariseFunArg, HF10-P20): an unarised local's, a tuple's
  construction's arguments, else the expression's value taken apart by a case"
  [args k]
  (if (some (fn [a] (or (and (lv? a) (seq (get @*multi* a)))
                        (and (head? a 'app) (head? (second a) 'v) (unboxed-con? (second (second a))) (seq (nth a 2)))
                        (and (not (lv? a)) (some seq (tuple-comps-of a)))))
            args)
    (let [step (fn step [as acc]
                 (if-let [a (first as)]
                   (cond
                     (and (lv? a) (seq (get @*multi* a))) (step (rest as) (into acc (map first (get @*multi* a))))
                     (and (head? a 'app) (head? (second a) 'v) (unboxed-con? (second (second a))) (seq (nth a 2)))
                     ;; HF10-P37: its void components (atoms) vanish (Unarise's MultiVal has none), a tuple of nothing
                     ;; else is one void argument (unariseFunArg's MultiVal [] -> voidArg)
                     (let [cs (remove void-atomic? (nth a 2))]
                       (if (empty? cs) (step (rest as) (conj acc (void-atom))) (step (concat cs (rest as)) acc)))
                     (and (not (lv? a)) (some seq (tuple-comps-of a)))
                     (let [comps (tuple-comps-of a)
                           cs (vec (for [rs comps :when (seq rs)] (let [n (fresh "ubx") r (reps->rep rs)] (swap! *reps* assoc n r) [n r])))
                           b (fresh "ubx")]
                       (swap! *reps* assoc b (reps->rep (vec (mapcat identity comps))))
                       (list 'case (expr a) [b (reps->rep (mapv second cs))] (list 'multi (count cs))
                             [(list 'alt (unboxed-name (count cs)) cs (step (rest as) (into acc (map first cs))))]))
                     :else (let [[n bs] (atom-of a)] (wrap-binds (vec bs) (step (rest as) (conj acc n)))))
                   (k acc)))]
      (step args []))
    (let [rs (mapv atom-of args)]
      (wrap-binds (vec (mapcat second (reverse rs))) (k (mapv first rs))))))

(defn- rep-of [n] (get @*reps* n :L))

(declare global-type arg-types)

(defn- field-alt-types
  "The alternative types of a constructor's fields' cases: (alg TYCON) for a data type, else (poly)"
  [c]
  (let [ts (some-> (global-type c) arg-types)]
    (mapv (fn [t] (let [t (strip-forall t)]
                    (if (and (vector? t) (= :tc (first t)) (not= "GHC.Internal.Prim" (nth (second t) 2)) (not (fun-ty? t)))
                      (list 'alg (ext-str (nth (second t) 2) (nth (second t) 3)))
                      '(poly))))
          (or ts []))))

(defn- strict-con
  "A saturated constructor application, its strict fields' arguments evaluated first ($WCon's work)"
  ([c atoms] (strict-con c atoms #{}))
  ([c atoms done]
  (let [rs0 (con-reps c)
        ;; HF10-P37: a field of several representations takes as many atoms, none evaluated
        flat (fn [xs d] (if (some vector? rs0) (mapcat (fn [r x] (if (vector? r) (repeat (count r) d) [x])) rs0 (concat xs (repeat d))) xs))
        st (flat (con-strict c) false)
        ats (concat (flat (field-alt-types c) '(poly)) (repeat '(poly)))
        reps (concat (if (some vector? rs0) (mapcat #(if (vector? %) % [%]) rs0) rs0) (repeat :L))
        evald (mapv (fn [a s r] (if (and s (= :L r) (string? a) (not (contains? done a))) [a (fresh "sat")] [a nil])) atoms (concat st (repeat false)) reps)
        body (list 'con (gname c) (mapv (fn [[a a2]] (or a2 a)) evald))]
    (reduce (fn [b [[a a2] at]] (if a2 (list 'case (list 'app a []) [a2 :L] at [(list 'alt :default [] b)]) b))
            body (reverse (map vector evald ats))))))

(defn- lifted-strict?
  "A constructor with a strict field of a lifted type (its argument must be evaluated first: $WCon's work); a strict
  unlifted field needs nothing"
  [c]
  (some true? (map (fn [s r] (and s (= :L r))) (con-strict c) (concat (con-reps c) (repeat :L)))))

(defn- floatable-con
  "A saturated application of a constructor without strict fields: [CON ARGS]"
  [e]
  (let [e (flatten-app e)]
    (when (and (head? e 'app) (head? (second e) 'v) (con-name? (second (second e))))
      (let [g (second (second e)) c (as-data g) args (nth e 2)]
        (when (and (not (newtype-con? c)) (not (and (class-of-dcon g) (newtype-class? (class-of-dcon g))))
                   (= (:arity (con-info c)) (count args)) (not (lifted-strict? c))
                   ;; HF10-P37: a field of several representations takes several atoms (with-atoms')
                   (not (some vector? (con-reps c))))
          [c args])))))

(defn- app-expr [f args]
  (cond
    ;; a string literal: its Addr# bound by a case (CorePrep: a LitString is not trivial)
    (and (head? f 'v) (#{"unpackCString#" "unpackCStringUtf8#"} (nth (second f) 3)) (= 1 (count args)) (string-lit? (first args)))
    (let [s (fresh "sat")]
      (list 'case (first (lit-form (second (first args)))) [s :addr] '(prim :addr)
            [(list 'alt :default [] (list 'app (gname (second f)) [s]))]))
    ;; a newtype class's dictionary constructor (C:IP, kept to CorePrep): the identity (its unfolding x |> co)
    (and (head? f 'v) (class-of-dcon (second f)) (newtype-class? (class-of-dcon (second f))) (seq args))
    (if (= 1 (count args)) (expr (first args)) (expr (list 'app (first args) (vec (rest args)))))
    (and (head? f 'v) (unboxed-con? (second f)))
    ;; an unboxed tuple: its non-void components (Unarise)
    (let [keep (filterv #(seq (expr-reps %)) args)]
      (with-atoms keep (fn [as] (list 'con (unboxed-name (count as)) as))))
    ;; HF10-P5 (a): a foreign call (the elaborator's dsFCall, an FCallId): StgOpApp's (ffi TARGET CONV SAFETY ATOMS REPS), a
    ;; foreign import prim's (primcall LABEL UNIT ATOMS REPS); REPS the unboxed result tuple's but the State# token's
    (and (head? f 'v) (vector? (second f)) (= "ffi" (nth (second f) 1)) (get (:fcalls *r*) (second f)))
    (let [g (second f) sp (get (:fcalls *r*) g) t (global-type g) ar (count (arg-types t))
          reps (type-reps (result-type t ar))
          rep (case (count reps) 0 :v 1 (first reps) (vec reps))
          mk (fn [as] (if (= :prim (:conv sp))
                        (list 'primcall (:target sp) (:unit sp) as rep)
                        (list 'ffi (list 'static (:target sp) (cond-> {:unit (:unit sp)} (false? (:fun sp)) (assoc :fun false)))
                              (:conv sp) (:safety sp) as rep)))]
      (if (>= (count args) ar)
        (with-atoms (take ar args)
          (fn [as] (if (= ar (count args)) (mk as)
                       (let [n (fresh "sat")]
                         (list 'case (mk as) [n :L] '(poly) [(list 'alt :default [] (with-atoms (drop ar args) (fn [bs] (list 'app n bs))))])))))
        (let [xs (mapv (fn [i] (list 'lv "eta" (str "E" (inc i) ".pe" (swap! *n* inc)))) (range (- ar (count args))))
              tys (drop (count args) (arg-types t))]
          (doseq [[x ty] (map vector xs tys)] (swap! *lreps* assoc x (type-reps ty)))
          (expr (list 'lam xs (list 'app f (into (vec args) xs)))))))
    (and (head? f 'v) (primop? (second f)))
    (let [g (second f) ar (count (arg-types (global-type g)))]
      (if (>= (count args) ar)
        (with-atoms (take ar args)
          (fn [as] (let [call (if (= "tagToEnum#" (nth g 3))
                                ;; tagToEnum#'s result type (StgOpApp's tycon): the binding's result type when the call is its
                                ;; body (isTrue#), else Bool, the type of every tagToEnum# the elaborator itself writes
                                (list 'primop (nth g 3) as {:tycon (or *body-tycon* (ext-str "GHC.Internal.Types" "Bool"))})
                                (list 'primop (nth g 3) as))]
                     (if (= ar (count args)) call
                         (let [n (fresh "sat")]
                           (list 'case call [n :L] '(poly) [(list 'alt :default [] (with-atoms (drop ar args) (fn [bs] (list 'app n bs))))]))))))
        ;; unsaturated: eta-expanded (CorePrep's maybeSaturate)
        (let [xs (mapv (fn [i] (list 'lv "eta" (str "E" (inc i) ".pe" (swap! *n* inc)))) (range (- ar (count args))))
              tys (drop (count args) (arg-types (global-type g)))]
          (doseq [[x t] (map vector xs tys)] (swap! *lreps* assoc x (type-reps t)))
          (expr (list 'lam xs (list 'app f (into (vec args) xs)))))))
    (and (head? f 'v) (con-name? (second f)))
    (let [c (as-data (second f)) ar (or (:arity (con-info c)) (count args))
          ;; HF10-P37: a sum built as a field, as its tuple at the field's type
          args (if (some vector? (con-reps c)) (sum-args f args) args)]
      (cond
        (or (newtype-con? c) (and (class-of-dcon (second f)) (newtype-class? (class-of-dcon (second f)))))
        (if (= 1 (count args)) (expr (first args)) (expr (list 'app (first args) (vec (rest args)))))
        (and (= ar (count args)) (some true? (con-strict c)))
        ;; a strict field's argument that is not an atom: case-bound (CorePrep's strict argument), the last
        ;; argument's binding outermost
        (let [st (concat (con-strict c) (repeat false))
              ats (concat (field-alt-types c) (repeat '(poly)))
              rs (mapv (fn [a s at r] (if (and s (= :L r) (not (atomic-args? [a])))
                                        (let [n (fresh "sat")] (swap! *reps* assoc n :L) [n [[:case n :L (expr a) at]]])
                                        (atom-of a)))
                       args st ats (concat (con-reps c) (repeat :L)))]
          (wrap-binds (vec (mapcat second (reverse rs)))
                      (strict-con c (mapv first rs) (set (for [[n bs] rs :when (some #(= :case (first %)) bs)] n)))))
        (= ar (count args)) (with-atoms args (fn [as] (strict-con c as)))
        :else (with-atoms args (fn [as] (list 'app (gname (second f)) as)))))
    (and (head? f 'v) (newtype-selector? (second f)))
    (if (= 1 (count args)) (expr (first args)) (expr (list 'app (first args) (vec (rest args)))))
    (lv? f) (with-atoms (sum-args f args) (fn [as] (list 'app (local-name f) as)))
    (head? f 'v) (with-atoms (sum-args f args) (fn [as] (list 'app (gname (second f)) as)))
    :else (let [n (fresh "sat")]
            (list 'let (list 'bind [n :L] (rhs f)) (with-atoms args (fn [as] (list 'app n as)))))))

(defn- alt-type [alts]
  (let [cs (keep (fn [[_ c]] (when (vector? c) c)) alts)
        ls (keep (fn [[_ c]] (when (head? c 'lit) c)) alts)]
    (cond (seq cs) (if-let [t (tycon-str (first cs))] (list 'alg t) '(poly))
          (seq ls) (list 'prim (second (lit-form (second (first ls)))))
          :else '(poly))))

(defn- tuple-comps
  "A local of an unboxed tuple type (its type the desugarer's): each component's representations, else nil"
  [x]
  (when-let [t (and (lv? x) (get (:ltypes *r*) x))]
    (let [t (expand-syn (strip-forall t))]
      (when (and (= :tc (first t)) (= "GHC.Internal.Types" (nth (second t) 2)) (re-matches #"Tuple[0-9]+#|Solo#|Unit#" (nth (second t) 3)))
        (mapv type-reps (nth t 2))))))

(defn- binders
  "A lambda's binders; one of an unboxed tuple type unarised into its components (Unarise's unariseFunArgBinder: the
  tuple's binder stands for them, a case on it binds them, HF10-P20), one of an unboxed sum type into its tag and slots
  (HF10-P37: unariseFunArgBinder's ubxSumRepType)"
  [bs]
  (vec (mapcat (fn [b]
                 ;; (# #)'s binder stays one void binder (GHC's: a void argument)
                 (if-let [comps (let [c (or (tuple-comps b) (when (lv? b) (some-> (get (:ltypes *r*) b) sum-comps)))] (when (some seq c) c))]
                   (let [cs (vec (for [rs comps :when (seq rs)] (let [n (fresh "ubx") r (reps->rep rs)] (swap! *reps* assoc n r) [n r])))]
                     (swap! *mcomps* assoc b comps)
                     (swap! *multi* assoc b cs)
                     cs)
                   (let [n (local-name b) r (reps->rep (local-reps b))] (swap! *reps* assoc n r) [[n r]])))
               bs)))

(defn- bind-pair [[_ b e]]
  (let [n (if (lv? b) (local-name b) (gname b))] [[n :L] (rhs e)]))


(defn- fail-var? [x] (and (lv? x) (= "fail" (second x))))

(defn- under-closure?
  "n occurs inside a closure of the STG expression (not a tail call of a join point)"
  [n x]
  (letfn [(occ? [y] (cond (= y n) true (coll? y) (some occ? y) :else false))
          (w [y inside]
            (cond (and (seq? y) (= 'closure (first y))) (w (nth y 4) true)
                  (and inside (= y n)) true
                  (coll? y) (some #(w % inside) y)
                  :else false))]
    (w x false)))

(defn- float-past-join
  "A join point's let-no-escape around its body, the body's leading let bindings floated out past it (CorePrep's
  cpeRhsE of a Let: the body's floats float out of the let, a join point's binding stays)"
  [jbind body]
  (loop [b body binds []]
    (if (and (head? b 'let) (not (head? (second b) 'rec)))
      (recur (nth b 2) (conj binds (second b)))
      (reduce (fn [acc bd] (list 'let bd acc)) (list 'letne jbind b) (reverse binds)))))

(defn- expr-type
  "A Core expression's type when the elaborator's tables give it, else nil"
  [e]
  (case (first e)
    lv (get (:ltypes *r*) e)
    v (global-type (second e))
    app (let [[_ f args] e]
          (cond (head? f 'v) (some-> (global-type (second f)) (result-type (count args)))
                (lv? f) (some-> (get (:ltypes *r*) f) (result-type (count args)))))
    (let letrec) (expr-type (nth e 2))
    nil))

(defn- scrut-alg
  "CoreToStg's mkStgAltType for a case without constructor alternatives: (alg T) when the scrutinee's type is an
  algebraic data type (a class's dictionary too), else nil (poly)"
  [s b]
  (let [t (or (get (:ltypes *r*) b) (expr-type s))
        t (when t (expand-syn (strip-forall t)))]
    (when (and (vector? t) (= :tc (first t)))
      (let [n (second t)]
        (cond (= 'data (:flavour (get (:tycons *r*) n))) (list 'alg (ext-str (nth n 2) (nth n 3)))
              (and (contains? (:all-classes *r*) n) (not (newtype-class? n))) (list 'alg (ext-str (nth n 2) (nth n 3)))
              :else nil)))))

(defn- float-scrut
  "A case's scrutinee's floats taken out of it (CorePrep: a case's scrutinee is a strict context, its lets and its
  case-bound floats float out, StrictContextFloatable): (mk SCRUTINEE) inside them"
  [se mk]
  (loop [se se wraps []]
    (cond
      (head? se 'let) (recur (nth se 2) (conj wraps [:let (second se)]))
      (and (head? se 'case) (:float (meta se)))
      (let [[_ ex b at [[_ _ _ inner]]] se] (recur inner (conj wraps [:case ex b at])))
      :else
      (reduce (fn [body [k & w]]
                (if (= k :let)
                  (list 'let (first w) body)
                  (let [[ex b at] w] (with-meta (list 'case ex b at [(list 'alt :default [] body)]) {:float true}))))
              (mk se) (reverse wraps)))))

(defn- sum-type [t]
  (let [t (when t (expand-syn (strip-forall t)))]
    (when (and (vector? t) (= :tc (first t)) (sum-tc? (second t))) t)))

(defn- sum-comps
  "HF10-P37: a type of an unboxed sum whose slots are known: its tag's and slots' representations, one component each
  (ubxSumRepType), else nil"
  [t]
  (when (sum-type t)
    (let [rs (type-reps t)] (when (not= [:L] rs) (mapv vector rs)))))

(defn- utuple-core [k] ["ext" "var" "GHC.Internal.Types" (if (= 1 k) "MkSolo#" (str "(#" (apply str (repeat (dec k) ",")) "#)"))])

(defn- sum-rubbish
  "ubxSumRubbishArg: an unused slot's argument (a pointer's absentSumFieldError, a number's 0), nil for an unlifted pointer's"
  [sl]
  (case sl :lifted (list 'v ["ext" "var" "GHC.Internal.Prim.Panic" "absentSumFieldError"]) :word (list 'lit "0##")
        :word64 (list 'lit "0#w64") :float (list 'lit "0.0#") :double (list 'lit "0.0##") nil))

;;; HF10-P37 (a): GHC.Builtin.PrimOps.Casts' getCasts (BSD-3, The University of Glasgow; LICENSE.md), the primops that take a
;;; field's representation to its slot's and back (Note [Casting slot arguments]: an Int# in a WordSlot, a Float# in a
;;; DoubleSlot)
(def ^:private int-reps #{:int :int8 :int16 :int32 :int64})
(def ^:private word-reps #{:word :word8 :word16 :word32 :word64})
(defn- rep-sfx [r] (case r :int8 "8" :int16 "16" :int32 "32" :int64 "64" :word8 "8" :word16 "16" :word32 "32" :word64 "64" ""))
(defn- int->word [r] (case r :int [:word "int2Word#"] [(keyword (str "word" (rep-sfx r))) (str "int" (rep-sfx r) "ToWord" (rep-sfx r) "#")]))
(defn- word->int [r] (case r :word [:int "word2Int#"] [(keyword (str "int" (rep-sfx r))) (str "word" (rep-sfx r) "ToInt" (rep-sfx r) "#")]))
(defn- sized-int [a b]
  (cond (= a b) [] (= b :int) [[(str "int" (rep-sfx a) "ToInt#") :int]] (= a :int) [[(str "intToInt" (rep-sfx b) "#") b]]
        :else [[(str "int" (rep-sfx a) "ToInt#") :int] [(str "intToInt" (rep-sfx b) "#") b]]))
(defn- sized-word [a b]
  (cond (= a b) [] (= b :word) [[(str "word" (rep-sfx a) "ToWord#") :word]] (= a :word) [[(str "wordToWord" (rep-sfx b) "#") b]]
        :else [[(str "word" (rep-sfx a) "ToWord#") :word] [(str "wordToWord" (rep-sfx b) "#") b]]))
(defn sum-casts
  "getCasts: [[primop result-rep]...] from rep a to rep b, [] when they are equal, nil when no cast applies"
  [a b]
  (cond (= a b) []
        (= b :float) (when (= a :double) [["double2Float#" :float]])
        (= b :double) (when (= a :float) [["float2Double#" :double]])
        (= b :addr) (cond (= a :int) [["int2Addr#" :addr]]
                          (int-reps a) (conj (sized-int a :int) ["int2Addr#" :addr])
                          (word-reps a) (let [[r op] (word->int a)] (into [[op r]] (conj (sized-int r :int) ["int2Addr#" :addr]))))
        (= a :addr) (cond (int-reps b) (into [["addr2Int#" :int]] (sized-int :int b))
                          (word-reps b) (into [["addr2Int#" :int] ["int2Word#" :word]] (sized-word :word b)))
        (and (int-reps a) (int-reps b)) (sized-int a b)
        (and (word-reps a) (word-reps b)) (sized-word a b)
        (and (word-reps a) (int-reps b)) (let [[r op] (word->int a)] (into [[op r]] (sized-int r b)))
        (and (int-reps a) (word-reps b)) (let [[r op] (int->word a)] (into [[op r]] (sized-word r b)))
        :else nil))

(defn- prim-app [op x] (list 'app (list 'v ["ext" "var" "GHC.Internal.Prim" op]) [x]))

(declare sum-at)

(defn- sum-construct
  "mkUbxSum: alternative k (of n) applied to its field as the unboxed tuple of the tag (an Int# literal) and the slots, the
  field in the slot layoutUbxSum gives it (cast to the slot's representation, castArg: HF10-P37), the others rubbish; nil
  when the sum's type is not known here"
  [k n args st]
  (let [targs (nth st 2) alt-reps (vec (map type-reps targs)) slots (sum-slots alt-reps)]
    (when (and slots (= n (count targs)) (<= (count args) 1))
      (let [frs (nth alt-reps (dec k)) lay (layout-sum slots (map prim-rep-slot frs))
            ;; the field's values, one a representation: the field itself, or an unboxed tuple's built in place (its
            ;; non-void components; HF10-P37: unboxedsums6's (# (# a, b #) | #))
            fvals (cond (empty? frs) []
                        (= 1 (count frs)) [(first args)]
                        :else (let [a (sum-at (first args) (nth targs (dec k)))]
                                (when (and (head? a 'app) (head? (second a) 'v) (unboxed-con? (second (second a))))
                                  (let [cs (vec (remove void-atomic? (nth a 2)))]
                                    (when (every? #(= 1 (count (expr-reps %))) cs) cs)))))
            casts (when (and lay (= (count fvals) (count frs)))
                    (mapv (fn [r i] (sum-casts r (slot-prim-rep (nth slots i)))) frs lay))]
        (when (and lay fvals (= (count fvals) (count frs)) (every? some? casts))
          (let [fields (zipmap lay (map (fn [x cs] (reduce (fn [x [op _]] (prim-app op x)) x cs)) fvals casts))
                vals (map-indexed (fn [i sl] (if (contains? fields i) (get fields i) (sum-rubbish sl))) slots)]
            (when (every? some? vals)
              (list 'app (list 'v (utuple-core (inc (count slots)))) (into [(list 'lit (str k "#"))] vals)))))))))

(defn- replace-var
  "The occurrences of the local x in e replaced by r (x a unique binder: no capture), every form's metadata kept"
  [x r e]
  (cond (= e x) r
        (seq? e) (with-meta (apply list (map #(replace-var x r %) e)) (meta e))
        (vector? e) (with-meta (mapv #(replace-var x r %) e) (meta e))
        :else e))

(defn- sum-case
  "unariseSumAlts: a case on an unboxed sum as a case on its unboxed tuple (the tag and the slots), then on the tag (a
  literal alternative an alternative of the sum, its binder the slot layoutUbxSum gives it: mapSumIdBinders; the DEFAULT
  first, mkDefaultLitAlt; a field of another representation than its slot's cast back, mapSumIdBinders' castArgRename:
  HF10-P37); a case of DEFAULT alternatives alone binds the tuple's components, its binder standing for them (HF10-P37:
  the desugarer's case binding a sum, mkDefaultCase); a scrutinee building the sum (its constructor applied) built as its
  tuple (mkUbxSum); nil when the sum's type is not known"
  [s b alts st]
  (let [targs (nth st 2) alt-reps (vec (map type-reps targs)) slots (sum-slots alt-reps)]
    (when slots
      (let [vars (vec (for [_ (range (inc (count slots)))] (list 'lv "us" (str "sum" (swap! *n* inc)))))
            _ (doseq [[v r] (map vector vars (cons :word (map slot-prim-rep slots)))] (swap! *lreps* assoc v [r]))
            s (or (when (and (head? s 'app) (head? (second s) 'v) (usum-con (second (second s))))
                    (let [[k n] (usum-con (second (second s)))] (sum-construct k n (nth s 2) st)))
                  s)
            ialts (for [[_ c xs rhs :as a] alts]
                    (if (= :default c) a
                        (when-let [[k n] (usum-con c)]
                          (let [frs (nth alt-reps (dec k) nil) lay (when frs (layout-sum slots (map prim-rep-slot frs)))
                                x (first xs)
                                ;; each field's casts from its slot's representation (mapSumIdBinders' castArgRename)
                                casts (when (and lay (= (count lay) (count frs)))
                                        (mapv (fn [i r] (sum-casts (slot-prim-rep (nth slots i)) r)) lay frs))]
                            (when (and lay (= n (count targs)) (every? some? casts))
                              (list 'alt (list 'lit (str k "#")) []
                                    (if (nil? x) rhs
                                        ;; case op slot of cst_sum { DEFAULT -> ... }, the last cast's binder the field; a
                                        ;; field of several representations (an unboxed tuple, HF10-P37) the tuple of them
                                        (let [chains (mapv (fn [i cs]
                                                             (let [cvs (vec (for [[_ r] cs] (let [v (list 'lv "cst_sum" (str "sum" (swap! *n* inc)))] (swap! *lreps* assoc v [r]) v)))]
                                                               [(if (seq cvs) (peek cvs) (nth vars (inc i)))
                                                                (map vector cs (cons (nth vars (inc i)) cvs) cvs)]))
                                                           lay casts)
                                              val (case (count frs)
                                                    0 (list 'v (utuple-core 0))
                                                    1 (first (first chains))
                                                    (list 'app (list 'v (utuple-core (count frs))) (mapv first chains)))]
                                          (reduce (fn [body [[op _] in out]] (list 'case (prim-app op in) out [(list 'alt :default [] body)]))
                                                  (replace-var x val rhs)
                                                  (reverse (mapcat second chains)))))))))))]
        (when (every? some? ialts)
          (list 'case s b [(list 'alt (assoc (utuple-core (count vars)) 1 "data") vars
                                 (if (every? (fn [[_ c]] (= :default c)) ialts)
                                   (nth (first ialts) 3)
                                   (list 'case (first vars) (list 'lv "tag" (str "sum" (swap! *n* inc)))
                                         (vec (sort-by (fn [[_ c]] (if (= :default c) 0 1)) ialts)))))]))))))

(defn- sum-rewrite
  "HF10-P8 (a): an unboxed sum's construction or case rewritten into its unboxed tuple's, or nil"
  [e]
  (cond
    (and (head? e 'app) (head? (second e) 'v) (usum-con (second (second e))))
    (let [[k n] (usum-con (second (second e)))] (when-let [st (sum-type *body-type*)] (sum-construct k n (nth e 2) st)))
    (and (head? e 'case) (some (fn [[_ c]] (usum-con c)) (nth e 3)))
    (when-let [st (sum-type (or (get (:ltypes *r*) (nth e 2)) (expr-type (second e))))] (sum-case (second e) (nth e 2) (nth e 3) st))
    ;; HF10-P37: a case binding a sum (DEFAULT alternatives alone), its binder's type the sum's
    (and (head? e 'case) (seq (nth e 3)) (every? (fn [[_ c]] (= :default c)) (nth e 3)) (lv? (nth e 2))
         (not (get @*multi* (second e))))
    (when-let [st (sum-type (get (:ltypes *r*) (nth e 2)))] (sum-case (second e) (nth e 2) (nth e 3) st))
    :else nil))

(defn- sum-at
  "HF10-P37: e, a sum's constructor applied, as its unboxed tuple at the type t (mkUbxSum), else e"
  [e t]
  (or (when (and t (head? e 'app) (head? (second e) 'v) (usum-con (second (second e))))
        (when-let [st (sum-type t)] (let [[k n] (usum-con (second (second e)))] (sum-construct k n (nth e 2) st))))
      e))

(defn- sum-args
  "HF10-P37: an unboxed sum built as a function's argument (its alternative's constructor applied: T14228's foo (Just' x)
  after the builder's inlining, (# x | #) itself): its unboxed tuple (mkUbxSum), at the parameter's type the function's type
  gives (its dictionaries first), which with-atoms unarises as the callee's binders are (binders); the other arguments as
  they are"
  [f args]
  (if (some #(and (head? % 'app) (head? (second %) 'v) (usum-con (second (second %)))) args)
    (let [t (cond (head? f 'v) (global-type (second f)) (lv? f) (get (:ltypes *r*) f))
          p (if (and (vector? t) (= :forall (first t))) (count (nth t 2)) 0)
          ats (when t (vec (arg-types t)))]
      (mapv (fn [a i]
              (or (when (and (head? a 'app) (head? (second a) 'v) (usum-con (second (second a))) (>= i p))
                    (when-let [st (sum-type (get ats (- i p)))]
                      (let [[k n] (usum-con (second (second a)))] (sum-construct k n (nth a 2) st))))
                  a))
            args (range)))
    args))

(defn expr
  "A Core expression as an STG expression"
  [e]
  ;; a case without alternatives is its scrutinee (CorePrep's Note [Empty case alternatives]: e |> unsafe co)
  (let [e (loop [e (flatten-app e)] (if (and (head? e 'case) (empty? (nth e 3 nil))) (recur (flatten-app (second e))) e))
        e (or (sum-rewrite e) e)]
    (case (first e)
      lv (cond (contains? @*joins* (local-name e)) (list 'app (local-name e) [(void-atom)])
               ;; a nullary join point's jump, whatever its body's representation (HF10-P20: bignat_gcd's void $j was
               ;; returned as (##), its body never run)
               (contains? @*njoins* (local-name e)) (list 'app (local-name e) [])
               ;; an unarised unboxed tuple's binder returned: the tuple of its components (Unarise)
               (seq (get @*multi* e)) (let [cs (get @*multi* e)] (list 'con (unboxed-name (count cs)) (mapv first cs)))
               ;; a variable of a void type returned: Unarise's (##)
               (empty? (local-reps e)) (list 'con (unboxed-name 0) [])
               :else (list 'app (local-name e) []))
      v (let [g (second e)]
          (cond
            (primop-value? e) (app-expr e [])
            (con-name? g)
            (let [c (as-data g)]
              (if (zero? (or (:arity (con-info c)) 0)) (list 'con (gname c) []) (list 'app (gname g) [])))
            :else (list 'app (gname g) [])))
      lit (first (lit-form (second e)))
      co (list 'con (ext-str "GHC.Internal.Types" "Eq#") [])
      app (app-expr (second e) (nth e 2))
      lam (let [n (fresh "sat")] (list 'let (list 'bind [n :L] (rhs e)) (list 'app n [])))
      let (if (and (= 1 (count (second e))) (:join (meta (second (first (second e))))) (not (fail-var? (second (first (second e))))))
            ;; a join point of the Simplifier (its case-of-case's $j): let-no-escape, its lambda's binders the arguments
            (let [[_ f fe] (first (second e)) fname (local-name f)
                  [bs body] (if (head? fe 'lam) [(second fe) (nth fe 2)] [[] fe])]
              ;; a nullary join point's binder has its body's type (typePrimRep of the join's result)
              (when (empty? bs) (swap! *njoins* conj fname))
              (float-past-join (list 'bind [fname (if (empty? bs) (reps->rep (expr-reps body)) :L)] (list 'closure :j :fvs (binders bs) (expr body))) (expr (nth e 2))))
          (if (and (= 1 (count (second e))) (fail-var? (second (first (second e)))))
            ;; a failure handler shared by several alternatives: a join point over the void argument (GHC's
            ;; mkFailurePair, CoreToStg's let-no-escape), an ordinary closure when a call is under a closure
            (let [[_ f fe] (first (second e)) fname (local-name f)
                  [v fe] (if (and (head? fe 'lam) (= 1 (count (second fe))))
                           (let [x (first (second fe))] (swap! *lreps* assoc x []) [(local-name x) (nth fe 2)])
                           [(fresh "void") fe])
                  _ (swap! *joins* conj fname)
                  body (expr (nth e 2))
                  join? (not (under-closure? fname body))]
              (if join?
                (float-past-join (list 'bind [fname :L] (list 'closure :j :fvs [[v :v]] (expr fe))) body)
                (list 'let (list 'bind [fname :L] (list 'closure :r :fvs [[v :v]] (expr fe))) body)))
          (let [e (list 'let (mapv (fn [[h x e2 :as bd]] (if (lv? x) (with-meta (list h x (sum-at e2 (get (:ltypes *r*) x))) (meta bd)) bd)) (second e)) (nth e 2))]
           (doseq [[_ x e2] (second e)]
             (when (and (lv? x) (not (get (:ltypes *r*) x))) (swap! *lreps* assoc x (expr-reps e2)))
             ;; a binder of an unboxed tuple: its components (Unarise)
             (when-let [cs (and (lv? x) (expr-comps e2))]
               (swap! *mcomps* assoc x cs)
               (swap! *multi* assoc x (vec (for [rs cs :when (seq rs)] (let [n (fresh "ubx") r (reps->rep rs)] (swap! *reps* assoc n r) [n r]))))))
           (reduce (fn [b [_ x e2 :as bd]]
                    (cond
                    ;; a binder of an unlifted type is bound by a case (Core's let-can-float invariant; the desugarer's
                    ;; bindNonRec, mkDefaultCase)
                    (and (lv? x) (get @*multi* x))
                    (let [cs (get @*multi* x) n (local-name x)]
                      (list 'case (expr e2) [n (reps->rep (mapv second cs))] (list 'multi (count cs))
                            [(list 'alt (unboxed-name (count cs)) cs b)]))
                    (and (lv? x) (not= [:L] (local-reps x)))
                    (let [rs (local-reps x) r (reps->rep rs) n (local-name x)]
                      (swap! *reps* assoc n r)
                      (if (= b (list 'app n []))
                        (expr e2)
                        (float-scrut (expr e2) (fn [se] (if (empty? rs)
                                                          ;; a void binder: a case on (##) (Unarise; HF10-P20)
                                                          (list 'case se [n :v] '(multi 0) [(list 'alt (unboxed-name 0) [] b)])
                                                          (list 'case se [n r] (if (> (count rs) 1) (list 'multi (count rs)) (prim-alt r)) [(list 'alt :default [] b)]))))))
                    (and (lv? x) (spec-eval e2))
                    (let [n (local-name x)]
                      (swap! *reps* assoc n :L)
                      (list 'case (expr e2) [n :L] (spec-eval e2) [(list 'alt :default [] b)]))
                    :else
                    (if-let [[c args] (floatable-con e2)]
                      (let [rs (mapv atom-of args)]
                        (wrap-binds (vec (mapcat second (reverse rs)))
                                    (list 'let (list 'bind [(local-name x) :L] (list 'rcon (gname c) (mapv first rs))) b)))
                      (let [[bn r] (bind-pair bd)] (list 'let (list 'bind bn r) b)))))
                  (expr (nth e 2)) (reverse (second e))))))
      letrec (if (every? (fn [[_ b r]] (and (lv? b) (:join (meta b)) (head? r 'lam))) (second e))
               ;; a recursive join point group (OccurAnal's tagRecBinders): let-no-escape, each a join closure
               (list 'letne (apply list 'rec (map (fn [bd] (let [[bn r] (bind-pair bd)]
                                                           (list 'bind bn (if (head? r 'closure) (apply list 'closure :j (drop 2 r)) r))))
                                                  (second e)))
                     (expr (nth e 2)))
               (list 'let (apply list 'rec (map (fn [bd] (let [[bn r] (bind-pair bd)] (list 'bind bn r))) (second e)))
                     (expr (nth e 2))))
      case (if (and (= 1 (count (nth e 3))) (vector? (second (first (nth e 3)))) (newtype-con? (second (first (nth e 3)))))
             ;; a newtype's constructor matched: its field is the scrutinee
             (let [[_ s b [[_ _ [x] body]]] e]
               (expr (list 'let [(list 'bind b s)] (list 'let [(list 'bind x b)] body))))
           (if (and (lv? (second e)) (get @*multi* (second e)))
             ;; a case on an unarised unboxed tuple: its alternative's binders are the components
             (let [[_ s b alts] e
                   cs (get @*multi* s)
                   alt (or (some (fn [a] (when (and (vector? (second a)) (unboxed-con? (second a))) a)) alts) (first alts))
                   [_ c xs body] alt]
               (swap! *multi* assoc b cs)
               (swap! *mcomps* assoc b (get @*mcomps* s))
               (when (vector? c)
                 (let [comps (expr-comps s)
                       pairs (map vector xs (concat (or comps []) (repeat [:L])))
                       _ (doseq [[x rs] pairs] (swap! *lreps* assoc x rs))
                       nonvoid (keep (fn [[x rs]] (when (seq rs) x)) pairs)]
                   (doseq [[x [n _]] (map vector nonvoid cs)]
                     (swap! *names* assoc x n))))
               (expr body))
           (let [[_ s b alts] e
                 at (let [a0 (alt-type alts)] (if (= '(poly) a0) (or (scrut-alg s b) a0) a0))
                 ubx (some (fn [[_ c]] (and (vector? c) (unboxed-con? c))) alts)
                 ;; an unboxed tuple's scrutinee of an unknown type (a local function's call, runRW# of one): its
                 ;; representations its alternative's binders' (HF10-P20: withNewWordArray2#'s runRW# io bound two
                 ;; values in a case of one)
                 srs (or (when (and ubx (not (expr-comps s)))
                           (some (fn [[_ c xs]] (when (and (vector? c) (unboxed-con? c)) (vec (mapcat local-reps xs)))) alts))
                         (expr-reps s))
                 void? (and (empty? srs) (not ubx))
                 [at brep] (cond void? ['(multi 0) :v]
                                 ubx [(list 'multi (count srs)) (reps->rep srs)]
                                 (= 'prim (first at)) [at (second at)]
                                 (and (= '(poly) at) (not= [:L] srs)) [(if (> (count srs) 1) (list 'multi (count srs)) (prim-alt (reps->rep srs))) (reps->rep srs)]
                                 :else [at :L])
                 _ (when (lv? b) (swap! *lreps* assoc b srs))
                 bn (local-name b)
                 _ (swap! *reps* assoc bn brep)
                 salts (vec (for [[_ c xs body] (sort-by (fn [[_ c]] (if (= :default c) 0 1)) alts)]
                              (cond
                                ;; a void scrutinee (State#, an effect's result): Unarise's (##) alternative
                                (and (= :default c) void?) (list 'alt (unboxed-name 0) [] (expr body))
                                (= :default c) (list 'alt :default [] (expr body))
                                (head? c 'lit) (list 'alt (first (lit-form (second c))) [] (expr body))
                                (not (vector? c)) (do (binding [*out* *err*] (println "tostg: alternative not handled:" (pr-str c)))
                                                      (list 'alt :default [] (expr body)))
                                (unboxed-con? c)
                                (let [comps (or (expr-comps s) (mapv local-reps xs))
                                      bs (vec (mapcat (fn [[x rs]]
                                                        (swap! *lreps* assoc x rs)
                                                        (cond
                                                          (empty? rs) []
                                                          ;; a component of several representations (a nested unboxed
                                                          ;; tuple, (# (# q1, q0 #), r #)): one binder each, the
                                                          ;; component's binder standing for them (Unarise; HF10-P20:
                                                          ;; Native's case on quotRemWord3# bound 2 of its 3 values)
                                                          (and (> (count rs) 1) (lv? x))
                                                          (let [cs (vec (for [r rs] (let [n (fresh "ubx")] (swap! *reps* assoc n r) [n r])))]
                                                            (swap! *mcomps* assoc x (mapv vector rs))
                                                            (swap! *multi* assoc x cs)
                                                            cs)
                                                          :else (let [n (local-name x) r (reps->rep rs)] (swap! *reps* assoc n r) [[n r]])))
                                                      (map vector xs (concat comps (repeat [:L])))))]
                                  (do
                                    ;; the case binder of an unboxed tuple stands for its components (Unarise's
                                    ;; unariseAlts: its occurrences the tuple again; HF10-P20: Integer's
                                    ;; quotRem's wild_941 was unbound)
                                    (when (lv? b) (swap! *multi* assoc b bs) (swap! *mcomps* assoc b comps))
                                    (list 'alt (unboxed-name (count bs)) bs (expr body))))
                                :else (let [reps (con-reps c)
                                            ;; HF10-P37: a field of several representations (an unboxed sum's or
                                            ;; tuple's) binds one binder each, the field's binder standing for them
                                            ;; (unariseConArgBinder)
                                            bs (vec (mapcat (fn [x r]
                                                              (if (vector? r)
                                                                (let [cs (vec (for [r1 r] (let [n (fresh "ubx")] (swap! *reps* assoc n r1) [n r1])))]
                                                                  (when (lv? x) (swap! *multi* assoc x cs) (swap! *mcomps* assoc x (mapv vector r)))
                                                                  cs)
                                                                (let [n (local-name x)] (swap! *reps* assoc n r) [[n r]])))
                                                            xs (concat reps (repeat :L))))]
                                        (list 'alt (gname c) bs (expr body))))))]
             ;; the scrutinee's lets floated out of the case (CorePrep's cpeBody floats)
             ;; and its case floats (a strict context: StrictContextFloatable, Note [BindInfo and FloatInfo])
             (float-scrut (expr s) (fn [se] (list 'case se [bn brep] at salts))))))
      (do (binding [*out* *err*] (println "tostg: expression not handled:" (pr-str (first e)))) (list 'int 0)))))

(defn- sat-con?
  "A data constructor of fields as an argument (atom-of saturates it into a closure)"
  [a]
  (and (head? a 'v) (con-name? (second a)) (not (unboxed-con? (second a))) (not (class-of-dcon (second a)))
       (not (newtype-con? (as-data (second a)))) (pos? (or (:arity (con-info (as-data (second a)))) 0))))

(defn- atomic-args? [args]
  (every? (fn [a] (or (lv? a) (and (head? a 'v) (not (and (con-name? (second a)) (newtype-con? (as-data (second a))))) (not (sat-con? a)))
                      (and (head? a 'lit) (not (string-lit? a))))) args))

(defn rhs
  "A right-hand side: a closure (fvs filled in later) or a constructor"
  [e]
  (let [e (flatten-app e)]
    (cond
      (head? e 'lam) (list 'closure :r :fvs (binders (second e)) (expr (nth e 2)))
      (primop-value? e) (rhs (primop-eta e))
      (and (head? e 'app) (head? (second e) 'v) (con-name? (second (second e)))
           (let [c (as-data (second (second e)))]
             (and (not (newtype-con? c)) (not (and (class-of-dcon (second (second e))) (newtype-class? (class-of-dcon (second (second e))))))
                  (= (:arity (con-info c)) (count (nth e 2))) (atomic-args? (nth e 2)) (not (lifted-strict? c)))))
      (list 'rcon (gname (as-data (second (second e)))) (mapv (comp first atom-of) (nth e 2)))
      (and (head? e 'v) (con-name? (second e)) (zero? (or (:arity (con-info (as-data (second e)))) 1)))
      (list 'rcon (gname (as-data (second e))) [])
      :else (list 'closure :u :fvs [] (expr e)))))

(def ^:dynamic *floats* nil)  ; atom [[name rhs]...]: CorePrep's floats to the top level

(defn- top-rhs
  "A top-level right-hand side: a CAF's arguments floated to the top level (CorePrep's wantFloatTop: a top-level
  binding that is not a lambda has its argument bindings floated out as top-level bindings of their own), the last
  argument's first"
  [occ e]
  (let [e (flatten-app e)
        f (when (head? e 'app) (second e))
        args (when f (nth e 2))
        float! (fn [rs] (doseq [b (mapcat second (reverse rs))] (swap! *floats* conj [b (first b)])))
        rename (fn [rs] (mapv first rs))]
    (cond
      (or (nil? f) (head? e 'lam) (string-lit? (first args)) (some #(not= [:L] (expr-reps %)) args)) (rhs e)
      (and (head? f 'v) (con-name? (second f)))
      (let [c (as-data (second f))]
        (if (and (not (newtype-con? c)) (not (and (class-of-dcon (second f)) (newtype-class? (class-of-dcon (second f)))))
                 (= (:arity (con-info c)) (count args))
                 (not (lifted-strict? c)))
          (let [rs (mapv atom-of args)]
            (if (some (fn [[_ bs]] (some #(= :case (first %)) bs)) rs)
              (rhs e)
              (do (float! rs) (list 'rcon (gname c) (rename rs)))))
          (rhs e)))
      (and (head? f 'v) (newtype-selector? (second f))) (rhs e)
      ;; a primop's or a foreign call's application is no function call (HF10-P20: Real's divZeroError = raise# e was
      ;; an application of raise#, which has no binding)
      (and (head? f 'v) (or (primop? (second f)) (= "ffi" (nth (second f) 1)) (unboxed-con? (second f)))) (rhs e)
      (or (lv? f) (head? f 'v))
      (let [rs (mapv atom-of args)]
        (if (some (fn [[_ bs]] (some #(= :case (first %)) bs)) rs)
          (rhs e)
          (do (float! rs)
              (list 'closure :u :fvs [] (list 'app (if (lv? f) (local-name f) (gname (second f))) (rename rs))))))
      :else (rhs e))))

;;; ------------------------------------------------------------------------------------------
;;; Free variables (Stg/FVs)

(defn- local? [n] (and (string? n) (not (contains? *tops* n)) (not (re-find #"^[^/]*:" n))))

(declare fv-expr)

(defn- fv-rhs
  "[rhs' fvs]"
  [r]
  (case (first r)
    closure (let [[_ u _ bs body] r
                  [b2 fs] (fv-expr body)
                  fs (vec (remove (set (map first bs)) fs))]
              [(list 'closure u fs bs b2) fs])
    rcon [r (vec (distinct (filter local? (nth r 2))))]))

(defn- fv-atoms [as] (filter local? as))

(defn fv-expr
  "[expr' fvs] in first-occurrence order"
  [e]
  (if-not (seq? e) [e []]
    (case (first e)
      app [e (vec (distinct (fv-atoms (cons (second e) (nth e 2)))))]
      primop [e (vec (distinct (fv-atoms (nth e 2))))]
      ;; a foreign call's arguments (StgOpApp's: (ffi TARGET CONV SAFETY ATOMS REPS), (primcall LABEL UNIT ATOMS REPS)) are
      ;; occurrences too (HF10-P20: runMainIO's Weak# w_188, passed to rts_setMainThread, left out of its closure's free
      ;; variables, was unbound when the closure ran)
      ffi [e (vec (distinct (fv-atoms (nth e 4))))]
      primcall [e (vec (distinct (fv-atoms (nth e 3))))]
      con [e (vec (distinct (fv-atoms (nth e 2))))]
      case (let [[_ s b at alts] e
                 [s2 fs] (fv-expr s)
                 alts2 (mapv (fn [[_ c bs body]] (let [[b2 f2] (fv-expr body)] [(list 'alt c bs b2) (remove (set (map first bs)) f2)])) alts)
                 afs (remove #{(first b)} (mapcat second alts2))]
             [(list 'case s2 b at (mapv first alts2)) (vec (distinct (concat fs afs)))])
      (let letne) (let [[_ bd body] e]
            (if (= 'rec (first bd))
              (let [bs (rest bd) names (set (map (comp first second) bs))
                    rs (map (fn [[_ bn r]] (let [[r2 f] (fv-rhs r)] [(list 'bind bn r2) f])) bs)
                    [b2 f2] (fv-expr body)]
                ;; a recursive group's closures capture each other: the group's own names stay free in them
                [(list (first e) (apply list 'rec (map first rs)) b2)
                 (vec (distinct (remove names (concat (mapcat second rs) f2))))])
              (let [[_ bn r] bd [r2 f] (fv-rhs r) [b2 f2] (fv-expr body)]
                [(list (first e) (list 'bind bn r2) b2) (vec (distinct (concat f (remove #{(first bn)} f2))))])))
      [e []])))

;;; ------------------------------------------------------------------------------------------
;;; The module

(defn- selectors
  "The module's classes that are not newtypes: their data and their selectors (MkId.mkDictSelId)"
  []
  (for [[cls info] (:all-classes *r*) :when (and (= (module) (nth cls 2)) (not (newtype-class? cls)))]
    (let [fields (concat (map-indexed (fn [i _] (str "$p" (inc i) (nth cls 3))) (:supers info)) (map #(nth % 3) (:methods info)))
          dc (ext-str (module) (str "C:" (nth cls 3)))
          k (count fields)]
      {:data (list 'stg/data (ext-str (module) (nth cls 3)) [(list 'dc dc 1 (vec (repeat k :L)) (vec (repeat k :lazy)))])
       :binds (cons (list 'bind [dc :L] (let [xs (mapv (fn [_] (fresh "eta")) fields)]
                                         (list 'closure :r [] (mapv (fn [x] [x :L]) xs) (list 'con dc xs))))
                    (for [[i f] (map-indexed vector fields)]
                      (let [d (fresh "v") w (fresh "v") xs (mapv (fn [_] (fresh "v")) fields)]
                        (list 'bind [(ext-str (module) f) :L]
                              (list 'closure :r [] [[d :L]]
                                    (list 'case (list 'app d []) [w :L] (list 'alg (ext-str (module) (nth cls 3)))
                                          [(list 'alt dc (mapv (fn [x] [x :L]) xs) (list 'app (nth xs i) []))]))))))})))

(defn- data-forms
  "The module's data types (not newtypes): stg/data and the constructors' workers (Prep's mkDataConWorkers)"
  []
  (for [[t info] (:tycons *r*) :when (= (module) (nth t 2))]
    {:data (list 'stg/data (ext-str (module) (nth t 3))
                 (vec (for [c (:cons info) :let [ci (con-info c)]]
                        (let [rs (con-reps c) ms (mapv #(if % :strict :lazy) (or (:strict ci) (repeat (:arity ci) false)))]
                          ;; HF10-P37: a field of several representations as its components (Unarise's constructor arguments)
                          (if (some vector? rs)
                            (list 'dc (gname c) (:tag ci) (vec (mapcat #(if (vector? %) % [%]) rs))
                                  (vec (mapcat (fn [r m] (if (vector? r) (repeat (count r) :lazy) [m])) rs (concat ms (repeat :lazy)))))
                            (list 'dc (gname c) (:tag ci) rs ms))))))
     :binds (for [c (:cons info) :let [ci (con-info c)] :when (= 'data (:flavour info))]
              (if (zero? (:arity ci))
                (list 'bind [(gname c) :L] (list 'rcon (gname c) []))
                (let [xs (mapv (fn [_] (fresh "eta")) (range (:arity ci)))]
                  (list 'bind [(gname c) :L] (list 'closure :r [] (mapv (fn [x r] [x r]) xs (concat (con-reps c) (repeat :L))) (strict-con c xs))))))}))

(defn- void-binders
  "Unarise's unariseFunArgBinder: every function argument binder of a void type is the one voidArgId (GHC's dumps name
  it void_N throughout a module; a case binder of a void type keeps its own name); the binders' occurrences, which no
  atom has (a void argument is void#), follow"
  [forms]
  (let [vs (atom #{}) nv (atom #{})
        arg? (fn [y] (and (vector? y) (= 2 (count y)) (string? (first y)) (= :v (second y))))
        coll (fn coll [y] (cond (and (seq? y) (= 'closure (first y)) (vector? (nth y 3 nil)))
                                (do (doseq [a (nth y 3)] (when (arg? a) (swap! vs conj (first a))))
                                    (doseq [z y] (coll z)))
                                (and (vector? y) (= 2 (count y)) (string? (first y)) (keyword? (second y)))
                                (when-not (= :v (second y)) (swap! nv conj (first y)))
                                (and (seq? y) (= 'str (first y))) nil
                                (coll? y) (doseq [z y] (coll z))
                                :else nil))
        _ (coll forms)
        ;; a name bound at another representation too (CorePrep's eta binders share one a position): only its void
        ;; argument binders renamed
        occ (apply disj @vs @nv)
        w (fn w [y] (cond (and (seq? y) (= 'closure (first y)) (vector? (nth y 3 nil)))
                          (with-meta (apply list (concat (take 3 (map w y)) [(mapv (fn [a] (if (arg? a) ["void_0" :v] (w a))) (nth y 3))]
                                                         (map w (drop 4 y))))
                            (meta y))
                          (and (string? y) (contains? occ y)) "void_0"
                          (and (seq? y) (= 'str (first y))) y
                          (seq? y) (with-meta (apply list (map w y)) (meta y))
                          (vector? y) (mapv w y)
                          :else y))]
    (if (empty? @vs) forms (mapv w forms))))

(def last-prog (atom nil)) ; the last module's Core as module-stg translated it (the Simplifier's output when it runs)

(defn- unsafe-coerce-name? [g occ]
  (and (vector? g) (= "GHC.Internal.Unsafe.Coerce" (nth g 2)) (= occ (nth g 3))))

(defn- unsafe-proof? [e]
  (or (and (seq? e) (= 'v (first e)) (unsafe-coerce-name? (second e) "unsafeEqualityProof"))
      (and (seq? e) (= 'app (first e)) (empty? (nth e 2)) (unsafe-proof? (second e)))))

(defn- drop-unsafe-coerce
  "Unsafe.Coerce's magic (GHC.HsToCore's patchMagicDefns, CorePrep's cpeExpr; HF10-P20): unsafeCoerce# applied is its
  argument (its compulsory unfolding \\x -> case unsafeEqualityProof of UnsafeRefl -> x: Exts' atomicModifyMutVar#'s
  unboxed triple was unarised into unsafeCoerce#'s arguments); a case on unsafeEqualityProof is its alternative's body
  (unsafeCoerce, unsafeCoerceAddr, unsafeCoerceUnlifted returned the proof)"
  [x]
  (cond
    (seq? x) (let [y (apply list (map drop-unsafe-coerce x))]
               (cond
                 (and (= 'app (first y)) (seq? (second y)) (= 'v (first (second y)))
                      (unsafe-coerce-name? (second (second y)) "unsafeCoerce#") (seq (nth y 2)))
                 (let [[a & more] (nth y 2)] (if more (list 'app a (vec more)) a))
                 (and (= 'case (first y)) (unsafe-proof? (second y)) (= 1 (count (nth y 3)))
                      (vector? (second (first (nth y 3)))) (unsafe-coerce-name? (second (first (nth y 3))) "UnsafeRefl"))
                 (nth (first (nth y 3)) 3)
                 :else (with-meta y (meta x))))
    (vector? x) (with-meta (mapv drop-unsafe-coerce x) (meta x))
    :else x))

(defn- drop-proof-matches
  "CorePrep's case on unsafeEqualityProof dropped, at the elaborator's match (match [unsafeEqualityProof] [(clause
  [(pcon UnsafeRefl ...)] body)]): the body (HF10-P20: unsafeCoerce returned the proof)"
  [x]
  (cond
    (seq? x) (let [y (apply list (map drop-proof-matches x))]
               (if (and (= 'match (first y)) (vector? (second y)) (= 1 (count (second y))) (unsafe-proof? (first (second y)))
                        (= 1 (count (nth y 2)))
                        (let [[_ ps _] (first (nth y 2))]
                          (and (= 1 (count ps)) (seq? (first ps)) (= 'pcon (first (first ps)))
                               (unsafe-coerce-name? (second (first ps)) "UnsafeRefl"))))
                 (nth (first (nth y 2)) 2)
                 (with-meta y (meta x))))
    (vector? x) (with-meta (mapv drop-proof-matches x) (meta x))
    :else x))

(defn- patch-magic-defns
  "patchMagicDefns: unsafeEqualityProof's right-hand side UnsafeRefl (its source is the loop `case
  unsafeEqualityProof of UnsafeRefl -> UnsafeRefl`, HF10-P20: a run looped allocating)"
  [prog]
  (mapv (fn [[_ b e :as bd]]
          (if (unsafe-coerce-name? b "unsafeEqualityProof")
            (list 'bind b (list 'v ["ext" "data" "GHC.Internal.Unsafe.Coerce" "UnsafeRefl"]))
            bd))
        prog))

(defn module-stg
  "The desugared program as STG forms (a vector of top-level forms, the header first)"
  [r units file]
  (binding [*r* r *units* units *names* (atom {}) *n* (atom 0) *reps* (atom {}) *joins* (atom #{}) *lreps* (atom {}) *multi* (atom {}) *mcomps* (atom {}) *njoins* (atom #{})]
    (let [simpl? (not= "0" (System/getenv "REPR_HASKELL_SIMPL"))
          r (update r :core drop-proof-matches)
          prog0 (binding [arbace.repr.haskell.simpleopt/*unlifted?* (fn [e] (not= [:L] (expr-reps e)))
                          ds/*casts* simpl?
                          ds/*unboxed-tuple?* (fn [e] (some? (expr-comps e)))]
                  (ds/desugar-program r))
          ;; the match variables' types (HF10-P20: desugar's fresh-types)
          r (update r :ltypes merge @ds/fresh-types)
          _ (set! *r* r)
          ;; HF10-P20: a NOINLINE binding a RULE's right-hand side mentions is external too, as GHC's -O0 output has it
          ;; (Enum's eftInt, efdtInt: eftIntList's right-hand side, which the programs' interfaces name; List's lenAcc,
          ;; lengthList's, has no pragma and stays internal)
          exported (into (ds/program-exported r prog0) (filter (set (:noinline r)) (:rule-rhs-names r)))
          [prog new-types raw] (if simpl?
                             (simpl/simplify-module r prog0 (into exported (:rule-names r))
                                                    {:unlifted-type? (fn [t] (boolean (and t (not= [:L] (type-reps t)))))
                                                     :unlifted-expr? (fn [e] (not= [:L] (expr-reps e)))
                                                     :con-strict con-strict
                                                     :con-reps con-reps})
                             [prog0 {} prog0])
          prog (drop-unsafe-coerce (patch-magic-defns prog))
          _ (reset! last-prog raw)
          _ (set! *r* (update r :ltypes merge new-types))
          r *r*
          internal (into {} (for [[_ b _] prog :when (and (vector? b) (= "var" (nth b 1)) (= (module) (nth b 2))
                                                          (not (contains? exported b)) (not= "main" (nth b 3)))]
                              [b (str (clean-occ (nth b 3)) "_" (swap! *n* inc))]))
          top-names (set (concat (for [[_ b _] prog] (if (lv? b) (local-name b) (or (get internal b) (gname b))))))
          arities (into {} (for [[_ b e] prog]
                             [b (loop [e e n 0] (if (head? e 'lam) (recur (nth e 2) (+ n (count (second e)))) n))]))
          has-main? (some (fn [[_ b _]] (= b ["ext" "var" (module) "main"])) prog)]
      (binding [*tops* (into top-names [(str "main::" (module) "/main")]) *arities* arities
                *internal-tops* internal]
        (let [binds (vec (mapcat (fn [[_ b e]]
                                   (binding [*floats* (atom [])]
                                     (let [n (if (lv? b) (local-name b) (gname b))]
                                      (binding [*rec-ids* #{n} *bkinds* (when (vector? b) (get (:tv-kinds *r*) b))]
                                      (cond
                                       (and (lv? b) (string-lit? e) (str/ends-with? (second e) "#"))
                                       ;; a top-level string literal (the Simplifier's floats: StgTopStringLit)
                                       (do (swap! *reps* assoc n :addr)
                                           [(list 'string [n :addr] (second (first (lit-form (second e)))))])
                                       ;; a CAF unpacking a string literal: CorePrep floats the literal to the top level
                                       ;; (a top-level binding's floats are top-level, a LitString one StgTopStringLit)
                                       (let [e2 (flatten-app e)]
                                         (and (head? e2 'app) (head? (second e2) 'v)
                                              (#{"unpackCString#" "unpackCStringUtf8#"} (nth (second (second e2)) 3))
                                              (= 1 (count (nth e2 2))) (string-lit? (first (nth e2 2)))
                                              (str/ends-with? (second (first (nth e2 2))) "#")))
                                       (let [e2 (flatten-app e) sn (fresh "lvl")]
                                         (swap! *reps* assoc sn :addr)
                                         (set! *tops* (conj *tops* sn))
                                         [(list 'string [sn :addr] (second (first (lit-form (second (first (nth e2 2)))))))
                                          (list 'bind [n :L] (list 'closure :u [] [] (list 'app (gname (second (second e2))) [sn])))])
                                       :else
                                     (let [r (binding [*body-type* (some-> (if (lv? b) (get (:ltypes *r*) b) (global-type b)) (result-type (get arities b 0)))
                                                       *body-tycon*
                                                       (let [t (some-> (if (lv? b) (get (:ltypes *r*) b) (global-type b)) (result-type (get arities b 0)))
                                                             t (when t (expand-syn (strip-forall t)))]
                                                         ;; only a binding whose body is the call itself (isTrue# x = tagToEnum# x)
                                                         (when (and (vector? t) (= :tc (first t)) (= 'data (:flavour (get (:tycons *r*) (second t))))
                                                                    (let [body (loop [x e] (if (head? x 'lam) (recur (nth x 2)) x))]
                                                                      (and (head? body 'app) (head? (second body) 'v)
                                                                           (= "tagToEnum#" (nth (second (second body)) 3)))))
                                                           (ext-str (nth (second t) 2) (nth (second t) 3))))]
                                               (top-rhs (if (lv? b) (second b) (nth b 3)) e))]
                                       ;; the floats' names, internal top-level binders
                                       (set! *tops* (into *tops* (map second @*floats*)))
                                       (concat (for [[[_ fr] fname] @*floats*] (list 'bind [fname :L] (first (fv-rhs fr))))
                                               [(list 'bind [n :L] (first (fv-rhs r)))])))))))
                                 (remove (fn [[_ _ e]] (and (head? e 'lit) (str/starts-with? (second e) "foreign import"))) prog)))
              dfs (data-forms) sels (selectors)
              fix (fn [f] (if (head? f 'bind) (list 'bind (second f) (first (fv-rhs (nth f 2)))) f))]
          (void-binders (vec (concat [(list 'stg/module {:unit *unit* :module (module) :file file :ghc "9.14.1" :helper 4 :flags ["-O0"] :compiler "arbace.repr.haskell.tostg"})]
                       (map :data dfs) (map :data sels)
                       binds
                       (map fix (mapcat :binds dfs)) (map fix (mapcat :binds sels))
                       (when has-main?
                         [(list 'bind [(str "main::" (module) "/main") :L]
                                (list 'closure :u [] [] (list 'app (ext-str "GHC.Internal.TopHandler" "runMainIO") [(ext-str (module) "main")])))])))))))))

(defn write-stg
  "The forms into DIR/MODULE.stg.ae"
  [forms dir m]
  (.mkdirs (File. ^String dir))
  (spit (str dir "/" m ".stg.ae")
        (binding [*print-length* nil *print-level* nil]
          (str (str/join "\n" (map (fn [f] (hexify (pr-str f))) forms)) "\n"))))

;;; ------------------------------------------------------------------------------------------
;;; Command line

(defn- parse-args [args]
  (loop [as args opts {} pos []]
    (if (empty? as)
      [opts pos]
      (let [[x & more] as]
        (if (and (str/starts-with? x "-") (seq more))
          (recur (rest more) (assoc opts x (first more)) pos)
          (recur more opts (conj pos x)))))))

(defn -main
  "compile --ifaces DIR,... [--local DIR] --libs DIR,... [--ghc DIR] -o DIR TREE.rn-tree.edn...: each renamed tree
  elaborated, desugared (HF5) and translated to STG (HF6) into DIR/NAME/MODULE.stg.ae; with --ghc the desugared
  Core judged against the tc verb's (arbace.repr.haskell.typecheck's judge, Core in full)"
  [& args]
  (let [[verb & more] args
        [opts pos] (parse-args more)]
    (let [ifdirs (vec (concat (remove empty? (str/split (or (get opts "--ifaces") "") #","))
                              (when (get opts "--local") [(get opts "--local")])))
          units (units-of (remove empty? (str/split (or (get opts "--libs") "") #",")))
          tcm tc/typecheck-module cmp tc/compare-with-ghc iface-text tc/iface-text]
      (case verb
        "compile"
        (let [res (for [f pos]
                    (let [b (.getName (File. ^String f))
                          nm (subs b 0 (- (count b) (count ".rn-tree.edn")))
                          base (str/replace nm #"\.hs$" "")
                          r (binding [tc/*ifdirs* ifdirs tc/*srcfile* nm] (tcm (read-string (slurp f))))
                          _ (when-let [l (get opts "--local")]
                              (.mkdirs (File. ^String l))
                              (spit (str l "/" (:module r) ".iface.edn") (iface-text r)))
                          dsd (ds/desugar-program r)
                          forms (module-stg r units nm)
                          _ (write-stg forms (str (get opts "-o") "/" base) (:module r))
                          _ (spit (str (get opts "-o") "/" base "/" (:module r) ".simpl.edn")
                                  (binding [*print-length* nil *print-level* nil *print-meta* false] (str/join "\n" (map pr-str @last-prog))))
                          _ (spit (str (get opts "-o") "/" base "/" (:module r) ".ds.edn")
                                  (binding [*print-length* nil *print-level* nil] (str/join "\n" (map pr-str dsd))))
                          c (when-let [g (get opts "--ghc")]
                              (let [gf (str g "/" nm ".tc.edn")]
                                (when (.exists (File. ^String gf)) (cmp (assoc r :core dsd) gf))))]
                      (println "stg" base (:module r) (str "errors " (count (:errors r)))
                               (if c (str "core " (:equal (:core c)) "/" (:compared (:core c))) ""))
                      (doseq [e (take 5 (:errors r))] (println "    error:" e))
                      c))]
          (dorun res)
          (System/exit 0))
        (do (println "usage: -m arbace.repr.haskell.tostg compile --ifaces DIR,... --libs DIR,... -o DIR TREE.rn-tree.edn...")
            (System/exit 2))))))

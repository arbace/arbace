(ns arbace.repr.haskell.print
  "repr/haskell's printer (doc/haskell/SPEC.md §7.4, doc/haskell/HASKELL-NOTES.md): Haskell forms
  as Haskell source in the braces layout (S14), from the forms alone: every block in explicit
  braces and semicolons, each form that carries a line (a list's :line, a symbol's or a vector's
  ^{:line}, a literal's :hs/breaks entry, an equation's :hs/eq) printed on that line, a form
  whose line was passed preceded by a {-# LINE #-} pragma. Parentheses are those of the forms
  ((:paren ...)) and the implicit ones (arbace.repr.haskell.syntax). Documentation is printed as
  Haddock comments where GHC's Haddock pass attaches them again.

  The layout layout (SPEC §7.4, 2; doc/haskell/HASKELL-NOTES.md, \"R4\"): the same printing
  code, every block (do, let, where, of, \\case, an instance's or a class's body, a GADT's
  constructors, a closed family's equations, a multi-way if) laid out by Haskell's layout rule
  instead of braces: its items aligned at one column, greater than the enclosing item's lines,
  each item on a line of its own (a ; between two on one line), the lines inside an item
  indented further. A block whose source wrote its { on another line than its first item
  (:hs/brace) keeps its braces; a block that a token on the line of its end would continue
  (anything but ) ] , then else of in and the like, which GHC's parse-error(t) rule closes it
  on) is braced after the fact (layout-close!)."
  (:require [arbace.repr.haskell.syntax :as sx]
            [arbace.string :as str])
  (:import [java.lang StringBuilder]))

;;; Output

(def ^:dynamic *o*
  "{:sb :line :glue :nl :bol :file :exts}: the module being printed"
  nil)

(defn- line-now [] @(:line *o*))

(defn- cp-count
  "The code points of s from index i: GHC's columns (the printer writes no tab)"
  [^String s i]
  (.codePointCount s (int i) (.length s)))

(defn- raw! [^String s]
  ;; a CPP module is preprocessed again when GHC reads it: a line that ends in \ (an operator,
  ;; containers' infixl 9 \\) would be joined with the next, so it ends in an empty comment (R5)
  (when (and (str/starts-with? s "\n") (contains? (:exts *o*) "CPP"))
    (let [^StringBuilder sb (:sb *o*) n (.length sb)]
      (when (and (pos? n) (= \\ (.charAt sb (dec n))))
        (.append sb " --"))))
  (.append ^StringBuilder (:sb *o*) s)
  (let [nl (sx/count-newlines s)]
    (if (pos? nl)
      (do (vswap! (:line *o*) + nl)
          (vreset! (:col *o*) (cp-count s (inc (.lastIndexOf s "\n")))))
      (vswap! (:col *o*) + (cp-count s 0)))
    (vreset! (:bol *o*) (str/ends-with? s "\n"))))

(def ^:dynamic *indent*
  "The column of the lines a newline begins (0: none), inside a layout block"
  0)

(defn- layout?
  "Whether the module is printed in the layout layout (SPEC §7.4, 2)"
  []
  (:layout *o*))

(declare layout-newline!)

(defn- indent! []
  (vreset! (:lind *o*) (inc *indent*))
  (when (pos? *indent*)
    (raw! (apply str (repeat *indent* " ")))
    (vreset! (:bol *o*) true)))

(defn- newline! []
  (when (layout?) (layout-newline! (inc *indent*)))
  (raw! "\n")
  (indent!)
  (vreset! (:nl *o*) false))

(defn- full?
  "Whether the module is printed in the full layout (SPEC §7.4, 3): tokens collected, not laid out"
  []
  (:full *o*))

(def ^:private punct
  "The tokens the full layout takes from the forms' data (:hs/punct), never from the printer"
  #{"," ";" "{" "}"})

(declare layout-token!)

(defn- tight?
  "In the layout layout, whether the token s follows the token prev without a space: after ( and
  [ (not before # or |: (# (| [| are tokens of their own), before ) ] , (not after # or a token
  ending in |: #) |) |]), and after a lambda's \\ before a name, a literal or a bracket"
  [prev ^String s]
  (and prev (pos? (count s))
       (let [c (.charAt s 0)]
         (or (and (contains? #{"(" "["} prev) (not (contains? #{\# \|} c)))
             (and (contains? #{")" "]" "," ";"} s) (not= prev "#") (not= prev "\\") (not (str/ends-with? prev "|")))
             (and (= prev "{") (= s "}"))
             (and (= prev "\\") (or (Character/isLetterOrDigit c) (contains? #{\_ \( \[ \" \'} c)))))))

(defn- emit!
  "Emits a token (or a comment), a space before it unless glued or at the beginning of a line;
  in the full layout, collects it (punctuation is the forms' data)"
  [^String s comment?]
  (if (full?)
    (when-not (contains? punct s) (vswap! (:toks *o*) conj s))
    (do
      (when @(:nl *o*) (newline!))
      (if (layout?)
        (do
          (when-not comment? (layout-token! s))
          ;; a comment always after a space ({-- would open a block comment)
          (when-not (or @(:bol *o*) (and (not comment?) (or @(:glue *o*) (tight? @(:prev *o*) s)))) (raw! " "))
          (when-not comment? (vreset! (:prev *o*) s)))
        (when-not (or @(:glue *o*) @(:bol *o*)) (raw! " ")))
      (vreset! (:glue *o*) false)
      (raw! s))))

(defn- t! [^String s] (emit! s false))

(defn- ct!
  "A comment: in the layout layout, no token for the layout rule"
  [^String s]
  (emit! s true))

(defn- toks!
  "Several tokens printed as one text in the braces layout (joined), one by one in the full layout"
  [pieces ^String joined]
  (if (full?) (doseq [p pieces] (t! p)) (t! joined)))

(defn- split-name
  "The tokens of a name's text as value-name, op-name and builtin-text spell it: (+) is ( + ),
  `div` is ` div `, [] is [ ], (,,) is ( , , ) (the commas are punctuation)"
  [^String s]
  (cond
    (= s "()") ["(" ")"]
    (= s "[]") ["[" "]"]
    (= s "(# #)") ["(#" "#)"]
    (re-matches #"\(#[,|_]+#\)" s) (vec (concat ["(#"] (map str (subs s 2 (- (count s) 2))) ["#)"]))
    (re-matches #"\(,+\)" s) (vec (concat ["("] (map str (subs s 1 (dec (count s)))) [")"]))
    (and (str/starts-with? s "(") (str/ends-with? s ")") (> (count s) 2)) ["(" (subs s 1 (dec (count s))) ")"]
    (and (str/starts-with? s "`") (str/ends-with? s "`") (> (count s) 2)) ["`" (subs s 1 (dec (count s))) "`"]
    (and (str/starts-with? s "'") (> (count s) 1)) (vec (cons "'" (split-name (subs s 1))))
    :else [s]))

(defn- nt!
  "A name's text as one token, or its tokens in the full layout"
  [^String s]
  (if (full?) (doseq [p (split-name s)] (t! p)) (t! s)))

(defn- glue! [] (vreset! (:glue *o*) true))

(defn- goto!
  "To line l: newlines; a {-# LINE #-} pragma when l was passed, or when file, a form's :hs/file,
  is not the one the output is in (R5: another file's nodes, a CPP inclusion's)"
  [l & [file]]
  (when l
    (let [now (line-now)
          cur (or @(:cur-file *o*) (:file *o*))]
      (cond
        (and file (not= file cur) (not (full?)))
        (do (when (layout?) (layout-newline! (inc *indent*)))
            (when-not @(:bol *o*) (raw! "\n"))
            (when (= cur (:file *o*)) (vreset! (:main-line *o*) (line-now)))
            (raw! (str "{-# LINE " l " \"" file "\" #-}\n"))
            (indent!)
            (vreset! (:cur-file *o*) file)
            (vreset! (:line *o*) l)
            (vreset! (:nl *o*) false))
        (> l now) (do (when (layout?) (layout-newline! (inc *indent*)))
                      (raw! (apply str (repeat (- l now) "\n")))
                      (indent!)
                      (vreset! (:nl *o*) false))
        (< l now) (do (when (layout?) (layout-newline! (inc *indent*)))
                      (raw! "\n")
                      (raw! (str "{-# LINE " l " \"" cur "\" #-}\n"))
                      (indent!)
                      (vreset! (:line *o*) l)
                      (vreset! (:nl *o*) false))
        :else nil))))

(defn- line-of [x]
  (cond
    (sx/lit? x) (:line x)
    (instance? arbace.lang.IObj x) (or (:line (meta x))
                                       ;; 'x and @x: the line of x
                                       (when (and (seq? x) (= 2 (count x)) (contains? #{'quote 'arbace.core/deref} (first x)))
                                         (line-of (second x))))
    :else nil))

(defn- at! [x] (goto! (line-of x) (when (instance? arbace.lang.IObj x) (:hs/file (meta x)))))

;;; The layout layout's blocks (SPEC §7.4, 2)

(def ^:private closers
  "The tokens that cannot continue the last item of a block: GHC's parse-error(t) rule closes the
  implicit blocks before them (the Haskell report's algorithm L)"
  #{")" "]" "," "then" "else" "of" "in" "#)" "|]" "||]"})

(defn- sb ^StringBuilder [] (:sb *o*))

(defn- replace-at!
  "Replaces the text want at offset o by s, as long"
  [o ^String want ^String s]
  (let [^StringBuilder b (sb) n (count want)]
    (when-not (and (>= o 0) (<= (+ o n) (.length b)) (= want (.substring b (int o) (int (+ o n)))))
      (throw (ex-info (str "repr-haskell: the layout layout cannot brace a block at line " (line-now)) {})))
    (.replace b (int o) (int (+ o n)) s)))

(defn- brace-pending!
  "Braces the blocks closed since the last line began, which the next token would continue: a {
  before the first item (in place of the two spaces before it when it began a line, of the space
  before it when the lines after it are aligned to the columns of its line, else inserted), a ;
  likewise before each item that began a line, a } after the last"
  []
  (let [ps @(:pending *o*) ^StringBuilder b (sb)]
    (vreset! (:pending *o*) [])
    ;; the blocks are nested, the innermost first: their offsets in decreasing order, so that an
    ;; insertion moves only what is done
    (doseq [{:keys [open seps]} ps]
      (doseq [o (reverse seps)] (replace-at! (- o 2) "  " "; "))
      (let [[kind o] open]
        (cond
          (= kind :line) (replace-at! (- o 2) "  " "{ ")
          ;; on the current line: nothing after it is aligned yet
          (neg? (.indexOf (.substring b (int o)) "\n")) (do (replace-at! o " " " ") (.insert b (int (inc o)) "{ "))
          (and (< (inc o) (.length b)) (= \- (.charAt b (inc o))))
          (throw (ex-info (str "repr-haskell: the layout layout cannot brace a block before - at line " (line-now)) {}))
          :else (replace-at! o " " "{"))))
    (let [s (.toString b)]
      (vreset! (:col *o*) (cp-count s (inc (.lastIndexOf s "\n")))))
    (doseq [_ ps] (raw! " }"))))

(defn- layout-token!
  "Before a token on the line where blocks closed: a closer ends them (parse-error(t)), any other
  token would continue the last one's last item, so they are braced"
  [s]
  (when (seq @(:pending *o*))
    (if (contains? closers s) (vreset! (:pending *o*) []) (brace-pending!))))

(defn- layout-newline!
  "Before a line that begins at column c: the blocks closed since the last line began end there
  when c is less than their columns (as the printer's columns are), else they are braced"
  [c]
  (let [ps @(:pending *o*)]
    (when (seq ps)
      (if (some #(<= (:n %) c) ps) (brace-pending!) (vreset! (:pending *o*) [])))))

(defn- next-col
  "The column the next token begins at"
  []
  (cond @(:nl *o*) (inc *indent*)
        (or @(:bol *o*) @(:glue *o*)) (inc @(:col *o*))
        :else (+ 2 @(:col *o*))))

(declare doc-form? lead! sep! lbrace! rbrace!)

(defn- layout-block!
  "Items as a layout block: the first on the keyword's line, or on a line of its own when its line
  is later (or a comment ended the line), the block's column then the enclosing item's lines' + 2;
  each later item at that column on its line, after a ; on the line before; the lines inside an
  item at the column + 2. sep: items separated by ; (not a multi-way if's guards); explicit: in
  braces, the { at the line brace (the source wrote it on another line than the first item)"
  [items item! & {:keys [sep explicit brace] :or {sep true}}]
  (when explicit (goto! brace) (t! "{"))
  (let [l0 (line-of (first items))
        nl0 (or @(:nl *o*) (and l0 (> l0 (line-now))))
        ;; on a line of its own: 2 further than the line the block's keyword is on, and than the
        ;; enclosing item's lines (which then close it)
        n (if nl0 (max (+ *indent* 3) (+ 2 @(:lind *o*))) (next-col))
        seps (volatile! []) open (volatile! nil)]
    (loop [xs (seq items) i 0 prev? false]
      (when xs
        (let [x (first xs) l (line-of x) doc (doc-form? x)
              new? (or (and l (> l (line-now))) @(:nl *o*) (and (zero? i) nl0))]
          (if new?
            (binding [*indent* (dec n)]
              (when (and explicit prev? (not doc)) (t! ";"))
              (if (and l (> l (line-now))) (goto! l) (newline!))
              (let [o (.length (sb))]
                (if (zero? i)
                  (vreset! open [:line o])
                  (when (and sep prev? (not doc)) (vswap! seps conj o)))))
            (do (when (and sep prev? (not doc)) (t! ";"))
                (when (zero? i) (vreset! open [:same (.length (sb))]))))
          (binding [*indent* (inc n)] (item! x))
          (recur (next xs) (inc i) (or prev? (not doc))))))
    (if explicit
      (t! "}")
      (when (seq items)
        (vswap! (:pending *o*) conj {:n n :open @open :seps @seps})))))

(def ^:private lv sx/lv)

(defn- breaks-lifted
  "x with its children that begin a line (:hs/breaks [[i l]...]) wrapped as Lits carrying the line"
  [x]
  (let [b (when (instance? arbace.lang.IObj x) (:hs/breaks (meta x)))]
    (if (seq b)
      (let [m (into {} (map (fn [e] (if (vector? e) [(first e) (second e)] [e nil])) b))
            wrap (fn [i c] (if-let [l (get m i)] (sx/->Lit (lv c) nil l) c))]
        (if (vector? x)
          (with-meta (vec (map-indexed wrap x)) (meta x))
          (with-meta (apply list (map-indexed wrap x)) (meta x))))
      x)))

(defn- lift-all
  "Every :hs/breaks of the forms lifted into Lits"
  [x]
  (cond
    (sx/lit? x) x
    (seq? x) (let [y (breaks-lifted x)]
               (with-meta (apply list (map lift-all y)) (meta y)))
    (vector? x) (let [y (breaks-lifted x)]
                  (with-meta (mapv lift-all y) (meta y)))
    :else x))

(defn- exts [] (:exts *o*))
(defn- ext? [e] (contains? (exts) e))

;;; Literals

(defn- hs-char-escape
  "A character inside a Haskell literal; quote the delimiter q"
  [n q]
  (cond
    (= n (int q)) (str "\\" q)
    (= n 92) "\\\\"
    (= n 10) "\\n"
    (= n 9) "\\t"
    (or (< n 0x20) (= n 0x7f) (and (> n 0x7f) (not (Character/isLetterOrDigit (int n)))))
    (str "\\" n)
    :else (String. (Character/toChars (int n)))))

(defn- code-points
  "The code points of a string (a surrogate pair is one)"
  [^String s]
  (loop [i 0 acc []]
    (if (< i (count s))
      (let [cp (.codePointAt s i)]
        (recur (+ i (Character/charCount cp)) (conj acc cp)))
      acc)))

(defn- hs-string-of-cps
  "A Haskell string literal of code points, a numeric escape followed by a digit separated by \\&"
  [cps]
  (let [sb (StringBuilder. "\"")]
    (loop [cs (seq cps) prev-num false]
      (when cs
        (let [n (first cs)
              e (hs-char-escape n \")
              numeric (and (str/starts-with? e "\\") (> (count e) 1) (Character/isDigit (.charAt ^String e 1)))]
          (when (and prev-num (<= 48 n 57)) (.append sb "\\&"))
          (.append sb e)
          (recur (next cs) numeric))))
    (.append sb "\"")
    (str sb)))

(defn hs-string [s] (hs-string-of-cps (code-points s)))

(defn hs-char [c]
  (str "'" (hs-char-escape (if (char? c) (int c) c) \') "'"))

(defn- num-text [v]
  (cond
    (instance? java.math.BigDecimal v)
    (let [^java.math.BigDecimal bd v] (str (.unscaledValue bd) "e" (- (.scale bd))))
    (double? v) (let [s (pr-str v)] s)
    :else (str v)))

(defn- prim-lit [h v]
  (let [v (lv v)]
    (case h
      :int# (str (num-text v) "#")
      :word# (str (num-text v) "##")
      :float# (str (num-text v) "#")
      :double# (str (num-text v) "##")
      :char# (str (if (char? v) (hs-char v) (hs-char (second v))) "#")
      :string# (str (hs-string v) "#")
      :int8# (str (num-text v) "#Int8") :int16# (str (num-text v) "#Int16")
      :int32# (str (num-text v) "#Int32") :int64# (str (num-text v) "#Int64")
      :word8# (str (num-text v) "#Word8") :word16# (str (num-text v) "#Word16")
      :word32# (str (num-text v) "#Word32") :word64# (str (num-text v) "#Word64"))))

(def ^:private prim-heads #{:int# :word# :float# :double# :char# :string# :int8# :int16# :int32# :int64#
                            :word8# :word16# :word32# :word64#})

(defn- literal-text
  "The Haskell text of a literal form, or nil"
  [x]
  (let [x (lv x)]
    (cond
      (string? x) (hs-string x)
      (char? x) (hs-char x)
      (number? x) (num-text x)
      (and (seq? x) (contains? prim-heads (first x))) (prim-lit (first x) (second x))
      (and (seq? x) (= :char (first x))) (hs-char (second x))
      (and (seq? x) (= :string (first x))) (hs-string-of-cps (mapcat (fn [p] (if (string? p) (code-points p) [p])) (rest x)))
      (and (seq? x) (= :neg-literal (first x))) (str "-" (num-text (second x)))
      (and (seq? x) (= :hex-float (first x))) (let [s (lv (second x)) e (nth x 2)]
                                                (str (if (neg? s) "-" "") "0x" (.toString (biginteger (if (neg? s) (- s) s)) 16) "p" e))
      (and (seq? x) (= :multiline (first x))) (str "\"\"\"" (subs (hs-string (second x)) 1 (dec (count (hs-string (second x))))) "\"\"\"")
      :else nil)))

;;; Names

(defn- builtin-text [x]
  (let [x (lv x)]
    (cond
      (and (vector? x) (empty? x)) "[]"
      (and (seq? x) (empty? x)) "()"
      (= x :cons) "(:)"
      (and (seq? x) (= :tuple-con (first x))) (str "(" (apply str (repeat (dec (second x)) ",")) ")")
      (and (seq? x) (= :utuple-con (first x))) (if (zero? (second x)) "(# #)" (str "(#" (apply str (repeat (dec (second x)) ",")) "#)"))
      (and (seq? x) (= :usum-con (first x)))
      (if (= 2 (count x))
        (str "(#" (apply str (repeat (dec (second x)) "|")) "#)")
        (let [[_ alt n] x] (str "(#" (apply str (repeat (dec alt) "_|")) "_" (apply str (repeat (- n alt) "|_")) "#)")))
      :else nil)))

(defn- ip-text?
  "Whether t is an implicit parameter's name, ?x (not an operator beginning with ?: ?~, R5)"
  [^String t]
  (and (str/starts-with? t "?") (> (count t) 1)
       (let [c (.charAt t 1)] (or (Character/isLetter c) (= c \_)))))

(defn- value-name
  "A name as a value or a prefix head: x, (+), (:|)"
  [x]
  (or (builtin-text x)
      (let [t (sx/name-text x)]
        (cond
          (nil? t) (throw (ex-info (str "not a name: " (pr-str (lv x))) {}))
          (ip-text? t) t
          (sx/op-text? t) (str "(" t ")")
          :else t))))

(defn- op-name
  "A name in an operator slot: +, `div`; promoted ':+:"
  [x]
  (let [x (lv x)]
    (cond
      (sx/quote-form? x) (str "'" (op-name (second x)))
      (= x :cons) ":"
      :else
      (let [t (sx/name-text x)]
        (cond
          (nil? t) (throw (ex-info (str "not an operator: " (pr-str x)) {}))
          (sx/op-text? t) t
          :else (str "`" t "`"))))))

(defn- name! [x] (at! x) (nt! (value-name x)))
(defn- op! [x] (at! x) (nt! (op-name x)))

;;; Documentation

(defn doc-form? [x] (let [x (lv x)] (and (seq? x) (contains? #{:doc 'hs/doc} (first x)))))

(defn- doc!
  "A documentation form (:doc dec... :nested? text) as a Haddock comment"
  [d]
  (when-not (full?)
  (at! d)
  (let [items (vec (rest (lv d)))
        [dec items] (case (first items)
                      :next [["|"] (subvec items 1)]
                      :prev [["^"] (subvec items 1)]
                      :named [[(str "$" (second items))] (subvec items 2)]
                      :group [[(apply str (repeat (second items) "*"))] (subvec items 2)])
        nested (= :nested (first items))
        items (if nested (subvec items 1) items)
        text (first items)]
    (cond
      (nil? text) (do (ct! (str "-- " (first dec))) (vreset! (:nl *o*) true))
      nested (ct! (str "{-" (first dec) text "-}"))
      :else (let [ls (str/split text #"\n" -1)]
              (ct! (str "-- " (first dec) (first ls)))
              (doseq [l (rest ls)]
                (newline!)
                (raw! (str "--" l)))
              (vreset! (:nl *o*) true))))))

;;; Types

(declare type! expr! pat! decl! decls-block! stmt! inline-pragma-act! fam-lhs! fam-lhs-or-ctx! spec-pragma-items!)

(defn- comma-sep
  "Prints xs with f, commas between the non-doc elements, docs as comments"
  [xs f]
  (loop [xs (seq xs) first? true]
    (when xs
      (let [x (first xs)]
        (if (doc-form? x)
          (do (doc! x) (recur (next xs) first?))
          (do (when-not first? (sep! "," x))
              (f x)
              (recur (next xs) false)))))))

(defn- tvb!
  "A type variable binder"
  [b]
  (at! b)
  (let [x (lv b)]
    (cond
      (and (seq? x) (= :sig (first x))) (do (t! "(") (name! (second x)) (sep! "::" (nth x 2)) (type! (nth x 2) :top) (t! ")"))
      (and (seq? x) (= :inferred (first x)))
      (let [v (lv (second x))]
        (lbrace!)
        (if (and (seq? v) (= :sig (first v)))
          (do (name! (second v)) (sep! "::" (nth v 2)) (type! (nth v 2) :top))
          (name! v))
        (rbrace!))
      (sx/deref-form? x) (do (t! "@") (glue!) (tvb! (second x)))
      (= x '_) (t! "_")
      :else (name! b))))

(defn- ctx!
  "A context: (C1, C2) =>; body, the form after it"
  [cs & [body]]
  (if (= 1 (count (remove doc-form? cs)))
    (comma-sep cs #(type! % :ctx))
    (do (t! "(")
        (comma-sep cs #(type! % :ctx))
        (t! ")")))
  (sep! "=>" body))

(defn- type-args! [args]
  (doseq [a args]
    (if (sx/deref-form? a)
      (do (at! a) (t! "@") (glue!) (type! (second (lv a)) :arg))
      (type! a :arg))))

(defn- chain-items!
  "operand op operand op ...: f prints an operand at :op (or :op-last when last); an operator
  repeated (one form for every slot of (op a b c)) goes to its line the first time only"
  [items f]
  (let [n (count items)]
    (doseq [[i x] (map-indexed vector items)]
      (if (odd? i)
        (if (and (> i 1) (identical? x (nth items 1)))
          (nt! (op-name x))
          (op! x))
        (f x (if (= i (dec n)) :op-last :op))))))

(defn- interleave-op [op operands]
  (vec (butlast (interleave operands (repeat op)))))

(defn- field-wrapper!
  "!T ~T {-# UNPACK #-} T %1 T, else the type at pos"
  [x pos]
  (let [v (lv x)]
    (if (seq? v)
      (case (lv (first v))
        ! (do (at! x) (at! (second v)) (t! "!") (glue!) (type! (second v) :arg))
        :lazy (do (at! x) (at! (second v)) (t! "~") (glue!) (type! (second v) :arg))
        :unpack (do (at! x) (toks! ["{-# UNPACK" "#-}"] "{-# UNPACK #-}") (field-wrapper! (second v) :arg))
        :nounpack (do (at! x) (toks! ["{-# NOUNPACK" "#-}"] "{-# NOUNPACK #-}") (field-wrapper! (second v) :arg))
        (type! x pos))
      (type! x pos))))

(defn- arrow!
  "(-> a b ... r): arguments at :arrow-arg, documentation between; (:mod m a) an argument whose
  arrow is %m ->; linear: every arrow %1 ->"
  [items linear]
  (let [n (count (remove doc-form? items))]
    (loop [xs (seq items) k 0 prev nil]
      (when xs
        (let [x (first xs)]
          (if (doc-form? x)
            (do (doc! x) (recur (next xs) k prev))
            (let [v (lv x)
                  modded (and (seq? v) (= :mod (first v)) (< k (dec n)))]
              (when (pos? k)
                (lead! (if modded (nth v 2) x))
                (if (and (seq? (lv prev)) (= :mod (first (lv prev))))
                  (do (t! "%") (glue!) (type! (second (lv prev)) :arg) (t! "->"))
                  (if linear (toks! ["%" "1" "->"] "%1 ->") (t! "->"))))
              (if modded
                (field-wrapper! (nth v 2) :arrow-arg)
                (field-wrapper! x (if (< k (dec n)) :arrow-arg :top)))
              (recur (next xs) (inc k) (if modded x nil)))))))))

(defn- type*! [x pos]
  (let [v (lv x)]
    (cond
      (literal-text v) (t! (literal-text v))
      (builtin-text v) (nt! (builtin-text v))
      (symbol? v) (cond
                    (= v '_) (t! "_")
                    (and (= v '*) (:star-type *o*)) (t! "*")
                    :else (nt! (value-name v)))
      (keyword? v) (nt! (value-name v))
      (vector? v) (do (t! "[") (comma-sep v #(type! % :elem)) (t! "]"))
      (sx/quote-form? v)
      (let [q (lv (second v))]
        (t! "'") (glue!)
        (cond
          (vector? q) (do (t! "[") (comma-sep q #(type! % :elem)) (t! "]"))
          (and (seq? q) (= :tuple (first q))) (do (t! "(") (comma-sep (rest q) #(type! % :elem)) (t! ")"))
          :else (nt! (value-name q))))
      (seq? v)
      (let [h (lv (first v)) args (rest v)]
        (cond
          (= h :name) (nt! (value-name v))
          (= h :paren) (do (t! "(") (type! (second v) :elem) (t! ")"))
          (= h :tuple) (do (t! "(") (comma-sep args #(type! % :elem)) (t! ")"))
          (= h :utuple) (if (empty? args) (toks! ["(#" "#)"] "(# #)") (do (t! "(#") (comma-sep args #(type! % :elem)) (t! "#)")))
          (= h :usum) (do (t! "(#") (doseq [[i a] (map-indexed vector args)] (when (pos? i) (t! "|")) (type! a :elem)) (t! "#)"))
          (= h '->) (arrow! args false)
          (= h '->.) (arrow! args true)
          (= h 'forall) (let [[bs body] (split-with #(not= '-> (lv %)) (butlast args))]
                          (t! "forall")
                          (doseq [b bs] (tvb! b))
                          (if (seq body) (t! "->") (do (glue!) (t! ".")))
                          (type! (last args) :top))
          (= h '=>) (do (ctx! (butlast args) (last args)) (type! (last args) :top))
          (= h :sig) (let [s (lv (first args))]
                       (if (and (symbol? s) (ip-text? (name s)))
                         (do (at! (first args)) (t! (name s)) (sep! "::" (second args)) (type! (second args) :top))
                         (do (type! (first args) :sig-subj) (sep! "::" (second args)) (type! (second args) :top))))
          (= h :infix) (chain-items! (vec args) type!)
          (= h :op) (if (= 2 (count v))
                      (nt! (value-name (list :name (second v))))
                      (chain-items! (interleave-op (list :name (second v)) (drop 2 v)) type!))
          (= h :splice) (do (t! "$") (glue!) (expr! (second v) :atom))
          (= h :record) (do (lbrace!) (comma-sep args (fn [f] (decl! f false :body))) (rbrace!))
          (contains? #{'! :lazy :unpack :nounpack} h) (field-wrapper! x pos)
          (= h :doc-type) (do (type! (second v) pos) (doc! (nth v 2)))
          (and (seq? h) (sx/quote-form? h) (sx/chain-head? (second h)))
          (if (= 2 (count v))
            (do (t! "'") (glue!) (nt! (value-name (second h))) (type-args! args))
            (let [o (op-name (second h))]
              (doseq [[i a] (map-indexed vector args)]
                (when (pos? i) (nt! (str "'" o)))
                (type! a (if (= i (dec (count args))) :op-last :op)))))
          (sx/chain-head? h)
          (if (= 2 (count v))
            (do (nt! (value-name h)) (type-args! args))
            (chain-items! (interleave-op (first v) args) type!))
          :else (do (type! (first v) :fun) (type-args! args))))
      :else (throw (ex-info (str "not a type: " (pr-str v)) {})))))

(defn- paren-line [x] (when (instance? arbace.lang.IObj x) (:hs/paren (meta x))))

(defn- lead!
  "In the layout layout, a separator without a position of its own (, = | -> :: =>) on the line
  of the form x after it when x begins a later line (its implicit parentheses' line, :hs/paren,
  or its own): separators lead their lines"
  [x]
  (when (layout?)
    (let [l (or (paren-line (lv x)) (line-of x))]
      (when (and l (> l (line-now))) (goto! l)))))

(defn- lbrace!
  "A record's {: in the layout layout, glued to what follows ({w = x}); first, the first field
  (the { leads its line)"
  [& [first]]
  (when first (lead! first))
  (t! "{")
  (when (layout?) (glue!)))

(defn- rbrace! []
  (when (layout?) (glue!))
  (t! "}"))

(defn- sep!
  "A separator token s before the form x (lead!)"
  [s x]
  (lead! x)
  (t! s))

(defn type! [x pos]
  (let [v (lv x)]
    (if (sx/type-needs-parens? (if (= pos :op-last) :op pos) v)
      (do (goto! (or (paren-line v) (line-of x))) (t! "(") (at! x) (type*! x :elem) (t! ")"))
      (do (at! x) (type*! x pos)))))

;;; Expressions

(defn binding-form?
  "A binding or signature inside let, where, a class or instance body"
  [x]
  (let [v (lv x)]
    (and (seq? v)
         (let [h (lv (first v))]
           (or (contains? #{'= :sig 'infixl 'infixr 'infix 'pattern 'default :doc} h)
               (and (keyword? h) (contains? #{:inline :noinline :inlinable :opaque :specialise :scc :minimal :complete} h)))))))

(defn- rhs-split
  "The items after an equation's left-hand side: [body-or-guards where]"
  [items]
  (let [items (vec items)
        w (when (and (seq items) (let [l (lv (peek items))] (and (seq? l) (= 'where (lv (first l)))))) (peek items))
        items (if w (pop items) items)]
    [items w]))

(defn- guard? [x] (let [v (lv x)] (and (seq? v) (= '| (lv (first v))))))

(defn- guards!
  "(| q* e) guards; sep = or ->"
  [gs sep]
  (doseq [g gs]
    (at! g)
    (let [v (vec (rest (lv g)))]
      (t! "|")
      (comma-sep (butlast v) #(stmt! % :guard))
      (t! sep)
      (expr! (peek v) :top))))

(defn- where! [w]
  (at! w)
  ;; the layout layout: where on a line of its own before the bindings' when there is one, else
  ;; on the first binding's line
  (when (layout?)
    (let [l0 (line-of (second (lv w)))]
      (when (and l0 (> l0 (line-now)))
        (goto! (if (> l0 (inc (line-now))) (dec l0) l0)))))
  (t! "where")
  (decls-block! (rest (lv w)) false :body))

(defn- rhs!
  "The rhs items (a body, or guards) and the where; sep = or ->; eq-line: :hs/eq"
  [items sep eq-line]
  (let [[body w] (rhs-split items)]
    (if (and (= 1 (count body)) (not (guard? (first body))))
      (do (goto! eq-line) (t! sep) (expr! (first body) :top))
      (guards! body sep))
    (when w (where! w))))

(defn- alt-split
  "A case or \\cases alternative's items: [patterns rhs-items]"
  [items]
  (let [[body w] (rhs-split items)
        gs (reverse (take-while guard? (reverse body)))]
    (if (seq gs)
      [(drop-last (count gs) body) (concat gs (when w [w]))]
      [(butlast body) (concat [(last body)] (when w [w]))])))

(defn- alt!
  "A case alternative (-> pat... rhs); pos of the patterns"
  [a pos]
  (at! a)
  (let [v (lv a)
        [pats rhs] (alt-split (rest v))]
    (doseq [p pats] (pat! p pos))
    (rhs! rhs "->" (:hs/eq (meta v)))))

(defn- alts!
  "Case alternatives (-> pat... rhs) in braces (in the layout layout, a layout block); pos of the
  patterns"
  [alts pos & [brace braces]]
  ;; no alternatives (EmptyCase): {} when the source wrote them (^:hs/braces), else none, as a
  ;; layout block that closes at once (its empty list has no position)
  (when (and (empty? alts) braces) (t! "{") (t! "}"))
  (when (seq alts)
    (if (layout?)
      (layout-block! alts #(alt! % pos) :explicit (some? brace) :brace brace)
      (do
        (goto! (or brace (line-of (first alts))))
        (t! "{")
        (doseq [a alts]
          (alt! a pos)
          (t! ";"))
        (t! "}")))))

(defn- stmts!
  "Statements in braces (in the layout layout, a layout block)"
  [ss & [brace]]
  (if (layout?)
    (layout-block! ss #(stmt! % :do) :explicit (some? brace) :brace brace)
    (do
      (goto! (or brace (line-of (first ss))))
      (t! "{")
      (doseq [s ss] (stmt! s :do) (t! ";"))
      (t! "}"))))

(defn- let-stmt? [x]
  (let [v (lv x)]
    (and (seq? v) (= 'let (lv (first v))) (> (count v) 1) (every? binding-form? (rest v)))))

(defn stmt!
  "A statement: (<- p e), (let b+), (rec s+), an expression"
  [s ctx]
  (at! s)
  (let [v (lv s)]
    (cond
      (and (seq? v) (= '<- (lv (first v)))) (do (pat! (second v) :top) (t! "<-") (expr! (nth v 2) :top))
      (let-stmt? s) (do (t! "let") (decls-block! (rest v) false :body))
      (and (seq? v) (= 'rec (lv (first v))) (ext? "RecursiveDo")) (do (t! "rec") (stmts! (rest v)))
      :else (expr! s :top))))

(defn- quals!
  "Comprehension qualifiers, | groups"
  [qs]
  (loop [qs (seq qs) first? true]
    (when qs
      (let [q (first qs)]
        (if (= '| (lv q))
          (do (at! q) (t! "|") (recur (next qs) true))
          (do (when-not first? (t! ","))
              (stmt! q :qual)
              (recur (next qs) false)))))))

(defn- keyword-at!
  "In the layout layout, a keyword without a position before the form x (then, else, in) to x's
  line when it is later, at the column after spaces, but before the columns of the blocks
  that closed since the line began (which the line then closes) and not before the enclosing
  item's lines' column"
  [x spaces]
  (when (layout?)
    (let [l (line-of x)
          ns (seq (map :n @(:pending *o*)))
          spaces (if ns (min spaces (- (apply min ns) 2)) spaces)]
      (when (and l (> l (line-now)))
        (binding [*indent* (max *indent* spaces)] (goto! l))))))

(defn- app-args! [args]
  (let [n (count args)]
    (doseq [[i a] (map-indexed vector args)]
      (if (sx/deref-form? a)
        (do (at! a) (at! (second (lv a))) (t! "@") (glue!) (type! (second (lv a)) :arg))
        (expr! a (if (= i (dec n)) :arg-last :arg))))))

(defn- fields!
  "Record fields: (= f e), f, .."
  [fs f]
  (lbrace! (first fs))
  (comma-sep fs (fn [x]
                  (at! x)
                  (let [v (lv x)]
                    (cond
                      (= '.. v) (t! "..")
                      (and (seq? v) (= '= (lv (first v))))
                      (do (let [k (lv (second v))]
                            (if (and (seq? k) (= :get (first k)))
                              (do (nt! (value-name (second k))) (doseq [p (drop 2 k)] (glue!) (t! ".") (glue!) (nt! (value-name p))))
                              (name! (second v))))
                          (t! "=") (f (nth v 2)))
                      :else (name! x)))))
  (rbrace!))

(defn- expr*! [x pos]
  (let [v (lv x)]
    (cond
      (literal-text v) (t! (literal-text v))
      (builtin-text v) (nt! (builtin-text v))
      (symbol? v) (cond
                    (= v '_) (t! "_")
                    (ip-text? (name v)) (t! (name v))
                    :else (nt! (value-name v)))
      (keyword? v) (nt! (value-name v))
      (vector? v)
      (let [items (vec v)]
        (cond
          (and (> (count items) 1) (= '| (lv (second items))))
          (do (t! "[") (expr! (first items) :top) (quals! (rest items)) (t! "]"))
          (some #(= '.. (lv %)) items)
          (do (t! "[")
              (let [[a b] (split-with #(not= '.. (lv %)) items)]
                (comma-sep a #(expr! % :top))
                (t! "..")
                (doseq [c (rest b)] (expr! c :top)))
              (t! "]"))
          :else (do (t! "[") (comma-sep items #(expr! % :top)) (t! "]"))))
      (sx/quote-form? v)
      (let [q (lv (second v))]
        (if (sx/quote-form? q)
          (do (t! "''") (glue!) (nt! (value-name (second q))))
          (do (t! "'") (glue!) (nt! (value-name q)))))
      (seq? v)
      (let [h (lv (first v)) args (rest v)]
        (cond
          (= h :name) (nt! (value-name v))
          (= h :paren) (do (t! "(") (expr! (second v) :top) (t! ")"))
          (= h :tuple) (do (t! "(")
                           (doseq [[i a] (map-indexed vector args)]
                             (when (pos? i) (t! ","))
                             (when-not (= :_ (lv a)) (expr! a :top)))
                           (t! ")"))
          (= h :utuple) (if (empty? args)
                          (toks! ["(#" "#)"] "(# #)")
                          (do (t! "(#")
                              (doseq [[i a] (map-indexed vector args)]
                                (when (pos? i) (t! ","))
                                (when-not (= :_ (lv a)) (expr! a :top)))
                              (t! "#)")))
          (= h :usum) (do (t! "(#") (doseq [[i a] (map-indexed vector args)]
                                        (when (pos? i) (t! "|"))
                                        (when-not (= :_ (lv a)) (expr! a :top)))
                          (t! "#)"))
          (= h :infix) (chain-items! (vec args) expr!)
          (= h :op) (if (= 2 (count v))
                      (nt! (value-name v))
                      (chain-items! (interleave-op (list :name (second v)) (drop 2 v)) expr!))
          (= h :section-l) (do (t! "(") (expr! (first args) :section-l) (op! (second args)) (t! ")"))
          (= h :section-r) (do (t! "(") (op! (first args)) (expr! (second args) :section-r) (t! ")"))
          (= h :lambda) (do (t! "\\")
                            (doseq [p (butlast args)] (pat! p :arg))
                            (goto! (:hs/eq (meta v)))
                            (t! "->") (expr! (last args) :top))
          (= h :lambda-case) (do (toks! ["\\" "case"] "\\case") (alts! args :alt (:hs/brace (meta v)) (:hs/braces (meta v))))
          (= h :lambda-cases) (do (toks! ["\\" "cases"] "\\cases") (alts! args :arg (:hs/brace (meta v))))
          (= h 'case) (do (t! "case") (expr! (first args) :top) (t! "of") (alts! (rest args) :alt (:hs/brace (meta v)) (:hs/braces (meta v))))
          (= h 'if) (cond
                      (and (seq args) (every? guard? args) (layout?))
                      ;; MultiWayIf's guards: a layout block without semicolons (GHC's layout_if)
                      (do (t! "if") (layout-block! args #(guards! [%] "->") :sep false))
                      (and (seq args) (every? guard? args))
                      (do (t! "if") (t! "{") (guards! args "->") (t! "}"))
                      :else
                      (let [c (next-col)]
                        (t! "if") (expr! (first args) :top)
                        (keyword-at! (second args) (inc c)) (t! "then") (expr! (second args) :top)
                        (keyword-at! (nth args 2) (inc c)) (t! "else") (expr! (nth args 2) :top)))
          (= h 'let) (let [c (next-col)]
                       (t! "let") (decls-block! (butlast args) false :body)
                       ;; in: at the let's column (before the block's)
                       (keyword-at! (last args) (dec c))
                       (t! "in") (expr! (last args) :top))
          (or (= h 'do) (= h 'mdo) (sx/qualified-do? h)) (do (t! (str h)) (stmts! args (:hs/brace (meta v))))
          (= h :rec) (do (name! (first args)) (fields! (rest args) #(expr! % :top)))
          (= h :update) (do (expr! (first args) :atom) (fields! (rest args) #(expr! % :top)))
          (= h :get) (do (expr! (first args) :atom)
                         (doseq [f (rest args)] (glue!) (t! ".") (glue!) (nt! (value-name f))))
          (= h :proj) (do (t! "(") (doseq [f args] (glue!) (t! ".") (glue!) (nt! (value-name f))) (t! ")"))
          (= h :sig) (do (expr! (first args) :sig-subj) (sep! "::" (second args)) (type! (second args) :top))
          (= h :quote) (do (t! "[|") (expr! (first args) :top) (t! "|]"))
          (= h :typed-quote) (do (t! "[||") (expr! (first args) :top) (t! "||]"))
          (= h :quote-pat) (do (t! "[p|") (pat! (first args) :top) (t! "|]"))
          (= h :quote-type) (do (t! "[t|") (type! (first args) :top) (t! "|]"))
          (= h :splice) (do (at! (first args)) (t! "$") (glue!) (expr! (first args) :atom))
          (= h :typed-splice) (do (at! (first args)) (t! "$$") (glue!) (expr! (first args) :atom))
          (= h :qq) (do (t! (str "[" (sx/name-text (first args)) "|" (second args) "|]")))
          (= h :label) (t! (str "#" (first args)))
          (= h :scc) (do (let [l (if (string? (first args)) (hs-string (first args)) (str (first args)))]
                           (toks! ["{-# SCC" l "#-}"] (str "{-# SCC " l " #-}")))
                         (expr! (second args) :top))
          (= h 'static) (do (t! "static") (expr! (first args) :arg-last))
          (= h 'type) (do (t! "type") (type! (first args) :arg))
          (contains? #{'forall '=> '-> '->.} h) (type*! x :top)
          (and (= h '-) (= 1 (count args))) (do (at! (first args)) (t! "-") (glue!) (expr! (first args) :neg))
          (sx/chain-head? h)
          (if (= 1 (count args))
            (do (nt! (value-name h)) (app-args! args))
            (chain-items! (interleave-op (first v) args) expr!))
          :else (do (expr! (first v) :fun) (app-args! args))))
      :else (throw (ex-info (str "not an expression: " (pr-str v)) {})))))

(defn expr! [x pos]
  (let [v (lv x)]
    (if (or (sx/exp-needs-parens? (exts) pos v)
            ;; a negative literal after a negation
            (and (= pos :neg) (number? v) (neg? v)))
      (do (goto! (or (paren-line v) (line-of x))) (t! "(") (at! x) (expr*! x :top) (t! ")"))
      (do (at! x) (expr*! x pos)))))

;;; Patterns

(defn- pat*! [x pos]
  (let [v (lv x)]
    (cond
      (literal-text v) (t! (literal-text v))
      (builtin-text v) (nt! (builtin-text v))
      (symbol? v) (if (= v '_) (t! "_") (nt! (value-name v)))
      (keyword? v) (nt! (value-name v))
      (vector? v) (do (t! "[") (comma-sep v #(pat! % :elem)) (t! "]"))
      (seq? v)
      (let [h (lv (first v)) args (rest v)]
        (cond
          (= h :name) (nt! (value-name v))
          (= h :paren) (do (t! "(") (pat! (second v) :elem) (t! ")"))
          (= h :tuple) (do (t! "(") (comma-sep args #(pat! % :elem)) (t! ")"))
          (= h :utuple) (if (empty? args) (toks! ["(#" "#)"] "(# #)") (do (t! "(#") (comma-sep args #(pat! % :elem)) (t! "#)")))
          (= h :usum) (do (t! "(#") (doseq [[i a] (map-indexed vector args)]
                                        (when (pos? i) (t! "|"))
                                        (when-not (= :_ (lv a)) (pat! a :elem)))
                          (t! "#)"))
          (= h :or) (do (t! "(") (doseq [[i a] (map-indexed vector args)] (when (pos? i) (t! ";")) (pat! a :elem)) (t! ")"))
          (= h '!) (do (at! (first args)) (t! "!") (glue!) (pat! (first args) :prefixed))
          (= h :lazy) (do (at! (first args)) (t! "~") (glue!) (pat! (first args) :prefixed))
          (= h :as) (do (name! (first args)) (at! (second args)) (glue!) (t! "@") (glue!) (pat! (second args) :prefixed))
          (= h :rec) (do (name! (first args)) (fields! (rest args) #(pat! % :elem)))
          (= h '->) (do (expr! (first args) :top) (t! "->") (pat! (second args) :top))
          (= h :sig) (do (pat! (first args) :sig-subj) (sep! "::" (second args)) (type! (second args) :top))
          (and (= h '-) (= 1 (count args))) (do (t! "-") (glue!) (pat! (first args) :atom))
          (and (= h '+) (= 2 (count args))) (do (pat! (first args) :atom) (t! "+") (pat! (second args) :atom))
          (= h 'type) (do (t! "type") (type! (first args) :arg))
          (= h :splice) (do (t! "$") (glue!) (expr! (first args) :atom))
          (= h :infix) (chain-items! (vec args) pat!)
          (= h :op) (if (= 2 (count v))
                      (nt! (value-name v))
                      (chain-items! (interleave-op (list :name (second v)) (drop 2 v)) pat!))
          (= h :mod) (do (toks! ["%" (str (lv (first args)))] (str "%" (lv (first args)))) (pat! (second args) pos))
          (sx/chain-head? h)
          (if (= 1 (count args))
            (do (nt! (value-name h)) (pat! (first args) :arg))
            (chain-items! (interleave-op (first v) args) pat!))
          :else (do (let [hv (lv (first v))]
                      (if (and (seq? hv) (= :infix (first hv)))
                        (do (at! (first v)) (t! "(") (pat*! (first v) :top) (t! ")"))
                        (name! (first v))))
                    (doseq [a args]
                      (if (sx/deref-form? a)
                        (do (at! a) (at! (second (lv a))) (t! "@") (glue!) (type! (second (lv a)) :arg))
                        (pat! a :arg))))))
      :else (throw (ex-info (str "not a pattern: " (pr-str v)) {})))))

(defn pat! [x pos]
  (let [v (lv x)]
    (if (sx/pat-needs-parens? (exts) (if (= pos :op-last) :op pos) v)
      (do (goto! (or (paren-line v) (line-of x))) (t! "(") (at! x) (pat*! x :top) (t! ")"))
      (do (at! x) (pat*! x pos)))))

;;; Declarations

(defn- decl-head!
  "T, T a b, a `op` b, (a `op` b) c, T :: K"
  [h]
  (at! h)
  (let [v (lv h)]
    (cond
      (and (seq? v) (= :sig (first v))) (do (decl-head! (second v)) (sep! "::" (nth v 2)) (type! (nth v 2) :top))
      (and (seq? v) (= :infix (first v))) (do (tvb! (second v)) (op! (nth v 2)) (tvb! (nth v 3)))
      (and (seq? v) (seq? (lv (first v))) (= :infix (first (lv (first v)))))
      (do (t! "(") (decl-head! (first v)) (t! ")") (doseq [b (rest v)] (tvb! b)))
      (and (seq? v) (not (contains? #{:name :tuple-con} (first v))))
      (do (name! (first v)) (doseq [b (rest v)] (tvb! b)))
      :else (name! h))))

(defn- head-or-ctx! [x]
  (let [v (lv x)]
    (if (and (seq? v) (= '=> (lv (first v))))
      (do (at! x) (ctx! (butlast (rest v)) (last v)) (decl-head! (last v)))
      (decl-head! x))))

(defn- deriving! [d]
  (at! d)
  (let [v (vec (rest (lv d)))]
    (t! "deriving")
    (loop [xs (seq v)]
      (when xs
        (let [x (first xs) xv (lv x)]
          (cond
            (contains? #{'stock 'anyclass 'newtype} xv) (do (at! x) (t! (str xv)) (recur (next xs)))
            (= 'via xv) (do (at! x) (t! "via") (type! (second xs) :top) (recur (nnext xs)))
            (vector? xv) (do (at! x) (t! "(") (comma-sep xv #(type! % :elem)) (t! ")") (recur (next xs)))
            (doc-form? x) (do (doc! x) (recur (next xs)))
            :else (do (type! x :arg) (recur (next xs)))))))))

(defn- con-fields! [fs]
  (doseq [f fs]
    (if (doc-form? f) (doc! f) (field-wrapper! f :arg))))

(defn- con!
  "A constructor declaration (H98)"
  [c]
  (at! c)
  (let [v (lv c)]
    (cond
      (or (builtin-text v) (sx/name-text v)) (name! c)
      (and (seq? v) (contains? #{:tuple :utuple :usum} (first v)))
      (let [[o sep c2] (case (first v) :tuple ["(" "," ")"] :utuple ["(#" "," "#)"] :usum ["(#" "|" "#)"])]
        (t! o)
        (doseq [[i f] (map-indexed vector (rest v))]
          (when (pos? i) (t! sep))
          (when-not (= :_ (lv f)) (field-wrapper! f :elem)))
        (t! c2))
      (and (seq? v) (= 'forall (lv (first v))))
      (do (t! "forall") (doseq [b (butlast (rest v))] (tvb! b)) (glue!) (t! ".") (con! (last v)))
      (and (seq? v) (= '=> (lv (first v)))) (do (ctx! (butlast (rest v)) (last v)) (con! (last v)))
      (and (seq? v) (= :infix (first v)))
      (loop [xs (seq (rest v)) k 0]
        (when xs
          (let [x (first xs)]
            (cond
              (doc-form? x) (do (doc! x) (recur (next xs) k))
              (= k 1) (do (op! x) (recur (next xs) 2))
              :else (do (field-wrapper! x :op) (recur (next xs) (inc k)))))))
      (and (seq? v) (= :rec (first v))) (do (name! (second v)) (goto! (:hs/brace (meta v))) (lbrace!) (rbrace!))
      (seq? v)
      (let [fs (rest v)]
        (name! (first v))
        (if (and (seq fs) (every? #(or (doc-form? %) (let [fv (lv %)] (and (seq? fv) (= :sig (first fv))))) fs))
          (do (goto! (:hs/brace (meta v))) (lbrace!) (comma-sep fs (fn [f] (decl! f false :body))) (rbrace!))
          (con-fields! fs)))
      :else (name! c))))

(defn- cons! [cs]
  (if (and (= 1 (count (remove doc-form? cs))) (let [w (lv (first (remove doc-form? cs)))] (and (seq? w) (= 'where (lv (first w))))))
    (let [w (first (remove doc-form? cs))]
      (doseq [d (filter doc-form? cs)] (doc! d))
      (at! w) (t! "where") (decls-block! (rest (lv w)) false :body))
    (loop [xs (seq cs) first? true sep? false]
      (when xs
        (let [x (first xs)]
          (if (doc-form? x)
            ;; a later constructor's documentation after its |, as GHC's Haddock pass reads it:
            ;; before it, after a -- ^ comment, it would continue that comment (R5: Cabal's
            ;; | -- | When ...)
            (let [s (and (not first?) (not sep?) (= :next (lv (second (lv x))))
                         (some #(not (doc-form? %)) (next xs)))]
              (when s (sep! "|" x))
              (doc! x) (recur (next xs) first? (or sep? s)))
            (do (when-not sep? (sep! (if first? "=" "|") x)) (con! x) (recur (next xs) false false))))))))

(defn- activation!
  "An activation: [] [2] [~2] [~] [~0]"
  [v]
  (let [pieces (cond (empty? v) ["[" "]"]
                     (= [:never] v) ["[" "~" "]"]
                     (= :before (first v)) ["[" "~" (num-text (lv (second v))) "]"]
                     (= :final (first v)) ["[" "~" "0" "]"]
                     :else ["[" (num-text (lv (first v))) "]"])]
    (toks! pieces (apply str pieces))))

(defn- inline-pragma! [h items]
  (let [h (str/upper-case (name h))
        ;; {-# INLINE CONLIKE and {-# NOINLINE CONLIKE are one token (GHC's lexer's twoWordPrags)
        conlike (and (full?) (some #(= :conlike (lv %)) items))
        items (if conlike (remove #(= :conlike (lv %)) items) items)]
    (t! (str "{-# " h (when conlike " CONLIKE")))
    (doseq [i items]
      (let [v (lv i)]
        (cond
          (vector? v) (do (at! i) (activation! v))
          (= :conlike v) (t! "CONLIKE")
          (= :inline v) (t! "INLINE")
          (= :noinline v) (t! "NOINLINE")
          (= :inlinable v) (t! "INLINABLE")
          :else (name! i))))))

(defn- spec-pragma! [items]
  ;; {-# SPECIALISE INLINE and {-# SPECIALISE NOINLINE are one token (twoWordPrags)
  (let [two (and (full?) (contains? #{:inline :noinline} (lv (first items))))]
    (t! (str "{-# SPECIALISE" (when two (str " " (str/upper-case (name (lv (first items))))))))
    (spec-pragma-items! (if two (rest items) items))))

(defn- spec-pragma-items! [items]
  (loop [xs (seq items)]
    (when xs
      (let [i (first xs) v (lv i)]
        (cond
          (contains? #{:inline :noinline :inlinable} v) (do (t! (str/upper-case (name v))) (recur (next xs)))
          (vector? v) (do (inline-pragma-act! i) (recur (next xs)))
          (and (seq? v) (= 'forall (lv (first v))) (next xs))
          (do (t! "forall") (doseq [b (rest v)]
                              (let [bv (lv b)]
                                (if (and (seq? bv) (= :sig (first bv)))
                                  (do (t! "(") (name! (second bv)) (sep! "::" (nth bv 2)) (type! (nth bv 2) :top) (t! ")"))
                                  (tvb! b))))
              (glue!) (t! ".") (recur (next xs)))
          :else (do (if (next xs)
                      (do (name! i) (t! "::") (comma-sep (rest xs) #(type! % :top)))
                      (expr! i :top))
                    nil)))))
  (t! "#-}"))

(defn- inline-pragma-act! [i]
  (at! i)
  (activation! (lv i)))

(defn- msg! [m]
  (at! m)
  (let [v (lv m)]
    (if (vector? v)
      (do (t! "[") (comma-sep v #(do (at! %) (t! (hs-string (lv %))))) (t! "]"))
      (t! (hs-string v)))))

(defn- warning-decl! [k items]
  (t! (str "{-# " (if (= k "deprecated") "DEPRECATED" "WARNING")))
  (let [[items cat] (if (= 'in (lv (first items))) [(drop 2 items) (lv (second items))] [items nil])]
    (when cat (t! "in") (t! (hs-string cat)))
    (let [[ns items] (if (contains? #{'type 'data} (lv (first items))) [(lv (first items)) (rest items)] [nil items])]
      (when ns (t! (str ns)))
      (comma-sep (butlast items) name!)
      (msg! (last items))))
  (t! "#-}"))

(defn- bf! [b]
  (at! b)
  (let [v (lv b)]
    (cond
      (and (seq? v) (= :or (first v))) (doseq [[i x] (map-indexed vector (rest v))] (when (pos? i) (t! "|")) (bf! x))
      (and (seq? v) (= :and (first v))) (comma-sep (rest v) bf!)
      (and (seq? v) (= :paren (first v))) (do (t! "(") (bf! (second v)) (t! ")"))
      :else (name! b))))

(defn- fam-eqn! [e]
  (at! e)
  (let [v (lv e)]
    (if (= 'forall (lv (first v)))
      (do (t! "forall") (doseq [b (butlast (rest v))] (tvb! b)) (glue!) (t! ".") (fam-eqn! (last v)))
      ;; mode :full's :hs/parens: the parentheses around the left-hand side (GHC keeps them in
      ;; the equation's annotation, not in its tree)
      (let [n (or (:hs/parens (meta v)) 0)]
        (dotimes [_ n] (t! "("))
        (fam-lhs! (second v))
        (dotimes [_ n] (t! ")"))
        (t! "=") (type! (nth v 2) :top)))))

(defn- fam-lhs! [l]
  (at! l)
  (let [v (lv l)]
    (cond
      (and (seq? v) (= :infix (first v))) (do (type! (second v) :op) (op! (nth v 2)) (type! (nth v 3) :op))
      (and (seq? v) (seq? (lv (first v))) (= :infix (first (lv (first v)))))
      (do (t! "(") (fam-lhs! (first v)) (t! ")") (type-args! (rest v)))
      (and (seq? v) (= 'forall (lv (first v))))
      (do (t! "forall") (doseq [b (butlast (rest v))] (tvb! b)) (glue!) (t! ".") (fam-lhs! (last v)))
      (and (seq? v) (= :sig (first v))) (do (fam-lhs! (second v)) (sep! "::" (nth v 2)) (type! (nth v 2) :top))
      (and (seq? v) (not (contains? #{:name :tuple-con} (first v))))
      (do (name! (first v)) (type-args! (rest v)))
      :else (name! l))))

(defn- family! [items]
  ;; items after type/data [family]: head result? inj? (where ...)?
  (let [[hd & more] items]
    (decl-head! hd)
    (doseq [m more]
      (at! m)
      (let [v (lv m)]
        (cond
          (= '= (lv (first v))) (do (t! "=") (tvb! (second v)))
          (= '| (lv (first v))) (do (t! "|") (name! (second v)) (t! "->") (doseq [n (drop 3 v)] (name! n)))
          (= 'where (lv (first v)))
          (do (t! "where")
              (if (= '.. (lv (second v)))
                (do (t! "{") (t! "..") (t! "}"))
                (if (and (layout?) (seq (rest v)))
                  (layout-block! (rest v) fam-eqn!)
                  (do (t! "{") (doseq [e (rest v)] (fam-eqn! e) (t! ";")) (t! "}"))))))))))

(defn- data-like!
  "data, newtype: items after the keyword (and instance): :ctype?, head-or-ctx, cons, derivings;
  where? (:hs/where) a GADT-style declaration without constructors"
  [items inst? & [where?]]
  (let [[ct items] (if (let [v (lv (first items))] (and (seq? v) (= :ctype (first v)))) [(lv (first items)) (rest items)] [nil items])]
    (when ct (toks! (concat ["{-# CTYPE"] (map hs-string (rest ct)) ["#-}"]) (str "{-# CTYPE " (str/join " " (map hs-string (rest ct))) " #-}")))
    (if inst? (fam-lhs-or-ctx! (first items)) (head-or-ctx! (first items)))
    (let [rest-items (rest items)
          [cs ds] (split-with #(not (let [v (lv %)] (and (seq? v) (= 'deriving (lv (first v)))))) rest-items)]
      (cons! cs)
      (when (and where? (empty? (remove doc-form? cs))) (t! "where"))
      (doseq [d ds] (if (doc-form? d) (doc! d) (deriving! d))))))

(defn- fam-lhs-or-ctx! [x]
  (let [v (lv x)]
    (if (and (seq? v) (= '=> (lv (first v))))
      (do (at! x) (ctx! (butlast (rest v)) (last v)) (fam-lhs! (last v)))
      (fam-lhs! x))))

(defn- class-head! [items]
  (let [[hd & body] items
        [fds body] (if (and (seq body) (let [v (lv (first body))] (and (seq? v) (= '| (lv (first v))))))
                     [(first body) (rest body)] [nil body])]
    (head-or-ctx! hd)
    (when fds
      (at! fds)
      (t! "|")
      (comma-sep (rest (lv fds))
                 (fn [fd] (at! fd)
                   (let [[l r] (split-with #(not= '-> (lv %)) (lv fd))]
                     (doseq [n l] (name! n)) (t! "->") (doseq [n (rest r)] (name! n))))))
    body))

(defn- instance-head!
  "overlap? T"
  [items]
  (let [[ov items] (if (keyword? (lv (first items))) [(lv (first items)) (rest items)] [nil items])]
    (when ov
      (let [o (str "{-# " (case ov :overlapping "OVERLAPPING" :overlappable "OVERLAPPABLE" :overlaps "OVERLAPS"
                            :incoherent "INCOHERENT" :no-overlap "NO_OVERLAP" :noncanonical "NONCANONICAL"))]
        (toks! [o "#-}"] (str o " #-}"))))
    (type! (first items) :top)
    (rest items)))

(defn- class-body!
  "A class body in virtual layout (GHC's Haddock pass takes the documentation comments after an
  explicitly braced class body into it): its items at one column n, each on a line of its own
  (a ; between two on one line), the lines inside an item at n + 2"
  [body where?]
  (when (and (layout?) (or (seq body) where?))
    (t! "where")
    (when (seq body) (layout-block! body #(decl! % false :body))))
  (when (and (not (layout?)) (or (seq body) where?))
    (t! "where")
    (let [nl? (and (line-of (first body)) (> (line-of (first body)) (line-now)))
          n (if nl? 3 (+ 2 @(:col *o*)))]
      (doseq [[i d] (map-indexed vector body)]
        (let [l (line-of d)]
          (cond
            (and l (> l (line-now))) (binding [*indent* (dec n)] (goto! l))
            (pos? i) (t! ";"))
          (binding [*indent* (inc n)]
            (decl! d false :body))))
      (vreset! (:nl *o*) true))))

(defn- body-block!
  "where { decls } when the body has items; where alone when where? (mode :full's :hs/where:
  the source wrote where before an empty body)"
  [body where?]
  (if (seq body)
    (do (t! "where")
        (decls-block! body false :body))
    (when where? (t! "where"))))

(defn decl!
  "A declaration: top? with hs/ heads; ctx :top, :body"
  [d top? ctx]
  (at! d)
  (let [v (lv d)
        h0 (lv (first v))
        h (if (and (symbol? h0) (= "hs" (namespace h0))) (symbol (name h0)) h0)
        args (rest v)]
    (cond
      (doc-form? d) (doc! d)
      (= h '=) (let [[lhs & rhs] args]
                 (pat! lhs :alt)
                 (rhs! rhs "=" (:hs/eq (meta v))))
      (contains? #{'sig :sig} h) (do (comma-sep (butlast args) name!) (sep! "::" (last args)) (type! (last args) :top))
      (and (= h 'default) (let [a (lv (first args))] (and (seq? a) (= :sig (first a)))))
      (do (t! "default") (decl! (first args) false :body))
      (= h 'pattern) (let [[lhs & more] args
                           lv1 (lv lhs)]
                       (t! "pattern")
                       (if (and (seq? lv1) (= :sig (first lv1)))
                         (do (comma-sep (butlast (rest lv1)) name!) (sep! "::" (last lv1)) (type! (last lv1) :top))
                         (do (at! lhs)
                             (cond
                               (and (seq? lv1) (= :infix (first lv1))) (do (name! (second lv1)) (op! (nth lv1 2)) (name! (nth lv1 3)))
                               (and (seq? lv1) (= :rec (first lv1))) (do (name! (second lv1)) (lbrace!) (comma-sep (drop 2 lv1) name!) (rbrace!))
                               (seq? lv1) (do (name! (first lv1)) (doseq [a (rest lv1)] (name! a)))
                               :else (name! lhs))
                             (t! (str (lv (first more))))
                             (pat! (second more) :top)
                             (when-let [w (nth more 2 nil)]
                               (at! w) (goto! (or (:hs/brace (meta (lv w))) (line-of (second (lv w))))) (t! "where")
                               (decls-block! (rest (lv w)) false :body)))))
      (contains? #{'infixl 'infixr 'infix} h)
      (let [[prec names] (if (number? (lv (first args))) [(lv (first args)) (rest args)] [nil args])
            [ns names] (if (contains? #{'type 'data} (lv (first names))) [(lv (first names)) (rest names)] [nil names])]
        (t! (str h))
        (when prec (t! (str prec)))
        (when ns (t! (str ns)))
        (comma-sep names op!))
      (= h 'data) (do (t! "data")
                      (if (= 'instance (lv (first args)))
                        (do (t! "instance") (data-like! (rest args) true))
                        (if (= 'family (lv (first args)))
                          (do (t! "family") (family! (rest args)))
                          (if (and (= ctx :body) (= 1 (count args)))
                            (family! args)
                            (data-like! args false (:hs/where (meta v)))))))
      (= h 'newtype) (do (t! "newtype")
                         (if (= 'instance (lv (first args)))
                           (do (t! "instance") (data-like! (rest args) true))
                           (data-like! args false (:hs/where (meta v)))))
      (= h 'type)
      (let [a0 (lv (first args))]
        (cond
          (= 'family a0) (do (t! "type") (t! "family") (family! (rest args)))
          (= 'instance a0) (do (t! "type") (t! "instance") (fam-eqn! (second args)))
          (= 'role a0) (do (t! "type") (t! "role") (name! (second args)) (doseq [r (drop 2 args)] (at! r) (t! (str (lv r)))))
          (= 'data a0) (do (t! "type") (t! "data") (data-like! (rest args) false))
          (and (seq? a0) (= '= (lv (first a0)))) (do (t! "type") (when (= ctx :top) (t! "instance")) (fam-eqn! (first args)))
          (and (seq? a0) (= 'forall (lv (first a0)))) (do (t! "type") (when (= ctx :top) (t! "instance")) (fam-eqn! (first args)))
          (and (= ctx :top) (= 1 (count args)) (seq? a0) (= :sig (first a0)))
          (do (t! "type") (name! (second a0)) (sep! "::" (nth a0 2)) (type! (nth a0 2) :top))
          (and (= ctx :body) (= 1 (count args))) (do (t! "type") (family! args))
          (and (= ctx :body) (= 2 (count args))) (do (t! "type") (t! "instance") (fam-lhs! (first args)) (t! "=") (type! (second args) :top))
          :else (do (t! "type") (decl-head! (first args)) (t! "=")
                    (doseq [x (rest args)] (if (doc-form? x) (doc! x) (type! x :top))))))
      (= h 'class) (do (t! "class") (class-body! (class-head! args) (:hs/where (meta v))))
      (= h 'instance) (do (t! "instance") (body-block! (instance-head! args) (:hs/where (meta v))))
      (= h 'deriving) (let [[st more] (cond
                                        (contains? #{'stock 'anyclass 'newtype} (lv (first args))) [[(lv (first args))] (rest args)]
                                        (= 'via (lv (first args))) [[:via (second args)] (drop 2 args)]
                                        :else [nil args])]
                        (t! "deriving")
                        (when st (if (= :via (first st)) (do (t! "via") (type! (second st) :arg)) (t! (str (first st)))))
                        (t! "instance")
                        (instance-head! (rest more)))
      (= h 'default) (if (and (seq args) (vector? (lv (last args))) (= 2 (count args)))
                       (do (t! "default") (name! (first args)) (t! "(") (comma-sep (lv (second args)) #(type! % :elem)) (t! ")"))
                       (do (t! "default") (t! "(") (comma-sep args #(type! % :elem)) (t! ")")))
      (= h 'foreign) (let [[dir cc & more] args]
                       (t! "foreign") (t! (str (lv dir))) (t! (str (lv cc)))
                       (doseq [m more]
                         (let [mv (lv m)]
                           (cond
                             (string? mv) (t! (hs-string mv))
                             (symbol? mv) (t! (str mv))
                             :else (do (at! m) (name! (second mv)) (sep! "::" (nth mv 2)) (type! (nth mv 2) :top))))))
      (contains? #{'inline 'noinline 'inlinable 'opaque :inline :noinline :inlinable :opaque} h)
      (do (inline-pragma! h args) (t! "#-}"))
      (contains? #{'specialise :specialise} h)
      (if (= 'instance (lv (first args)))
        (do (toks! ["{-# SPECIALISE" "instance"] "{-# SPECIALISE instance") (type! (second args) :top) (t! "#-}"))
        (spec-pragma! args))
      (contains? #{'deprecated 'warning} h) (warning-decl! (name h) args)
      (contains? #{'minimal :minimal} h) (do (t! "{-# MINIMAL") (bf! (first args)) (t! "#-}"))
      (contains? #{'complete :complete} h)
      (let [[ns ty] (split-with #(not= :sig (lv %)) args)]
        (t! "{-# COMPLETE") (comma-sep ns name!)
        (when (seq ty) (t! "::") (name! (second ty)))
        (t! "#-}"))
      (contains? #{'scc :scc} h) (do (t! "{-# SCC") (name! (first args)) (when (second args) (t! (hs-string (lv (second args))))) (t! "#-}"))
      (= h 'rules) (do (t! "{-# RULES")
                       (doseq [r args]
                         (at! r)
                         (let [rv (lv r)]
                           (t! (hs-string (lv (first rv))))
                           (doseq [x (rest rv)]
                             (let [xv (lv x)]
                               (cond
                                 (vector? xv) (inline-pragma-act! x)
                                 (= 'forall (lv (first xv)))
                                 (do (at! x) (t! "forall")
                                     (doseq [b (rest xv)]
                                       (let [bv (lv b)]
                                         (if (and (seq? bv) (= :sig (first bv)))
                                           (do (at! b) (t! "(") (name! (second bv)) (sep! "::" (nth bv 2)) (type! (nth bv 2) :top) (t! ")"))
                                           (tvb! b))))
                                     (glue!) (t! "."))
                                 :else (do (at! x) (expr! (second xv) :top) (t! "=") (expr! (nth xv 2) :top))))))
                         (t! ";"))
                       (t! "#-}"))
      (= h 'ann) (do (t! "{-# ANN")
                     (cond
                       (= 'type (lv (first args))) (do (t! "type") (name! (second args)) (expr! (nth args 2) :arg-last))
                       (= 'module (lv (first args))) (do (t! "module") (expr! (second args) :arg-last))
                       :else (do (name! (first args)) (expr! (second args) :arg-last)))
                     (t! "#-}"))
      (= h 'splice) (do (t! "$") (glue!) (expr! (first args) :atom))
      (= h 'naked-splice) (expr! (first args) :top)
      :else (throw (ex-info (str "not a declaration: " (pr-str v)) {})))))

(defn decls-block!
  "Declarations in braces, ; between them (not after the last: an empty case ends a block
  before })"
  [ds top? ctx]
  (if (and (layout?) (seq ds))
    (layout-block! ds #(decl! % top? ctx))
    (do
      (goto! (line-of (first ds)))
      (t! "{")
      (loop [ds (seq ds) first? true]
        (when ds
          (let [d (first ds)]
            (if (doc-form? d)
              (do (decl! d top? ctx) (recur (next ds) first?))
              (do (when-not first? (t! ";"))
                  (decl! d top? ctx)
                  (recur (next ds) false))))))
      (t! "}"))))

;;; Exports and imports

(defn- ie!
  "An export or import item"
  [x]
  (at! x)
  (let [v (lv x)]
    (cond
      (doc-form? x) (doc! x)
      (and (seq? v) (= 'module (lv (first v)))) (do (t! "module") (t! (str (lv (second v)))))
      (and (seq? v) (contains? #{'pattern 'type 'data 'default} (lv (first v))))
      (do (t! (str (lv (first v)))) (ie! (second v)))
      (and (seq? v) (contains? #{:deprecated :warning} (first v)))
      (do (t! (str "{-# " (if (= :deprecated (first v)) "DEPRECATED" "WARNING"))) (msg! (second v)) (t! "#-}") (ie! (nth v 2)))
      (and (seq? v) (not (contains? #{:name :tuple-con :utuple-con} (first v))))
      (do (name! (first v))
          (when-not (layout?) (glue!)) (t! "(")
          (let [subs (rest v)]
            (when-not (= [:_] (map lv subs))
              (comma-sep subs (fn [s] (if (= '.. (lv s)) (t! "..") (ie! s))))))
          (t! ")"))
      :else (name! x))))

(defn- items! [xs]
  (at! xs)
  (t! "(")
  (comma-sep (lv xs) ie!)
  (t! ")"))

(defn- import! [f]
  (at! f)
  (t! "import")
  (loop [xs (seq (rest (lv f)))]
    (when xs
      (let [x (first xs) v (lv x)]
        (recur
          (cond
            (= :source v) (do (toks! ["{-# SOURCE" "#-}"] "{-# SOURCE #-}") (next xs))
            (contains? #{'safe 'qualified 'splice 'quote} v) (do (t! (str v)) (next xs))
            (string? v) (do (t! (hs-string v)) (next xs))
            (= 'as v) (do (t! "as") (at! (second xs)) (t! (str (lv (second xs)))) (nnext xs))
            (= 'hiding v) (do (at! (second xs)) (t! "hiding") (items! (second xs)) (nnext xs))
            (vector? v) (do (items! x) (next xs))
            (symbol? v) (do (at! x) (t! (str v)) (next xs))
            :else (throw (ex-info (str "not an import part: " (pr-str v)) {}))))))))

;;; The module

(defn- pragma! [f]
  (when-not (full?)
  (at! f)
  (let [v (lv f)
        h (name (lv (first v)))
        args (map lv (rest v))]
    (goto! (line-of f))
    (when-not @(:bol *o*) (newline!))
    (case h
      "language" (t! (str "{-# LANGUAGE " (str/join ", " (map str args)) " #-}"))
      "options-ghc" (t! (str "{-# OPTIONS_GHC " (str/join " " (map #(if (re-find #"\s" %) (pr-str %) %) args)) " #-}"))
      "options" (t! (str "{-# OPTIONS " (str/join " " (map #(if (re-find #"\s" %) (pr-str %) %) args)) " #-}"))
      "options-haddock" (t! (str "{-# OPTIONS_HADDOCK " (first args) " #-}"))
      "include" (t! (str "{-# INCLUDE " (first args) " #-}")))
    (vreset! (:nl *o*) true))))

(defn- module-exts
  "The extensions on: the configuration's and the language pragmas'"
  [forms]
  (let [m (first (filter #(= 'hs/module (lv (first (lv %)))) forms))
        opts (apply hash-map (drop-while #(not (keyword? (lv %))) (drop 2 (lv m))))
        cfg (lv (get opts :config))
        base (map str (:extensions cfg))
        prags (mapcat #(map str (rest (lv %))) (filter #(= 'hs/language (lv (first (lv %)))) forms))]
    {:exts (reduce (fn [s e] (if (str/starts-with? e "No") (disj s (subs e 2)) (conj s e)))
                   #{} (concat base prags))
     :file (get opts :file)
     :language (str (:language cfg))}))

(defn- print-body!
  "Prints the module's forms: the header pragmas, the module header, the body"
  [forms]
  (let [body (remove #(= 'ns (lv (first (lv %)))) forms)
        [pre more] (split-with #(not= 'hs/module (lv (first (lv %)))) body)
        m (first more)
        decls (rest more)]
    ;; the header pragmas and the module's documentation, in their source order
    (doseq [p (sort-by #(or (line-of %) 0) pre)]
      (if (doc-form? p) (doc! p) (pragma! p)))
    (when m
      (let [mv (lv m)
            [_ mname & mrest] mv
            exports (first (filter #(vector? (lv %)) (take-while #(not (keyword? (lv %))) mrest)))
            warn (first (filter #(seq? (lv %)) (take-while #(not (keyword? (lv %))) mrest)))]
        (at! m)
        (when mname
          (binding [*indent* (if (layout?) 2 0)]
          (t! "module") (at! mname) (t! (str (lv mname)))
          (when warn
            (let [w (lv warn)]
              (at! warn)
              (t! (str "{-# " (if (= :deprecated (first w)) "DEPRECATED" "WARNING")))
              (when (= 3 (count w)) (t! "in") (t! (hs-string (second w))))
              (msg! (last w))
              (t! "#-}")))
          (when exports (items! exports))
          (t! "where")))))
    ;; the body in virtual layout at column 1, as the original's (GHC's Haddock pass takes
    ;; a documentation comment at column 1 into no declaration only then): each item on a
    ;; line of its own (a ; between two on one line), the lines inside an item at column 2
    (doseq [[i d] (map-indexed vector decls)]
      (let [l (line-of d)
            h (lv (first (lv d)))
            ;; the file of a top-level form: its :hs/file, else the one before it's (R5)
            fl (or (when (instance? arbace.lang.IObj d) (:hs/file (meta d))) @(:top-file *o*))
            _ (when fl (vreset! (:top-file *o*) fl))]
        (cond
          (and l (or (> l (line-now)) (and fl (not= fl (or @(:cur-file *o*) (:file *o*))))))
          (binding [*indent* 0] (goto! l fl))
          (zero? i) (when-not @(:bol *o*) (binding [*indent* 0] (newline!)))
          :else (t! ";"))
        (binding [*indent* (if (layout?) 2 1)]
          (cond
            (doc-form? d) (binding [*indent* 0] (doc! d))
            (= h 'hs/import) (import! d)
            :else (decl! d true :top)))))))

(defn- out-of
  "The printer's state for forms; layout: the layout layout's"
  [forms full & [layout]]
  (let [{:keys [exts file]} (module-exts forms)]
    {:sb (StringBuilder.) :line (volatile! 1) :col (volatile! 0) :glue (volatile! false) :nl (volatile! false)
     :bol (volatile! true) :file file :cur-file (volatile! nil) :top-file (volatile! nil) :main-line (volatile! 1) :exts exts :full full :toks (volatile! [])
     :layout layout :pending (volatile! []) :prev (volatile! nil) :lind (volatile! 1)
     :star-type (not (contains? (set (map str (map lv (mapcat rest (filter #(= 'hs/language (lv (first (lv %)))) forms)))))
                                "NoStarIsType"))}))

;;; The full layout (SPEC §7.2, §7.4, 3; doc/haskell/HASKELL-NOTES.md, "R3")

(defn module-options
  "The options of a module's hs/module form, a map"
  [forms]
  (let [m (first (filter #(= 'hs/module (lv (first (lv %)))) forms))]
    (apply hash-map (drop-while #(not (keyword? (lv %))) (drop 2 (lv m))))))

(defn full-forms?
  "Whether forms were converted in mode :full"
  [forms]
  (= :full (lv (get (module-options forms) :positions))))

(defn print-tokens
  "The texts of the tokens the full layout prints, in their order, without the punctuation the
  forms hold as data (, ; { }), the comments and the header pragmas"
  [forms]
  (let [forms (mapv lift-all forms)]
    (binding [*o* (out-of forms true)]
      (print-body! forms)
      @(:toks *o*))))

(defn full-data
  "The positions mode :full keeps on the forms: {:toks [[l c]...] (sorted) :punct [[l c text]...]
  :texts {[l c] text} :comments :space :tail}"
  [forms]
  (let [toks (volatile! []) punct (volatile! []) texts (volatile! {})]
    (letfn [(walk [x]
              (when (instance? arbace.lang.IObj x)
                (let [m (meta x)]
                  (when-let [p (:hs/pos m)] (vswap! toks into (:toks p)))
                  (when-let [p (:hs/punct m)] (vswap! punct into p))
                  (when-let [t (:hs/text m)] (vswap! texts merge t))))
              (when (or (seq? x) (vector? x)) (doseq [c x] (walk c))))]
      (doseq [f forms] (walk f)))
    (let [mod (first (filter #(= 'hs/module (lv (first (lv %)))) forms))
          mm (meta mod)]
      {:toks (vec (sort @toks)) :punct @punct :texts @texts
       :comments (:hs/comments mm) :space (:hs/space mm) :tail (:hs/tail mm)})))

(defn- plain-text?
  "Whether s has no newline, tab or character beyond the BMP: each char one column"
  [^String s]
  (and (neg? (.indexOf s "\n")) (neg? (.indexOf s "\t"))
       (= (.length s) (.codePointCount s 0 (.length s)))))

(defn advance
  "The position after text s at [l c], in GHC's columns (code points, tab stops of 8)"
  [[l c] ^String s]
  (if (plain-text? s)
    [l (+ c (count s))]
    (let [n (count s)]
      (loop [i 0 l l c c]
        (if (< i n)
          (let [ch (.charAt s i)]
            (cond
              (= ch \newline) (recur (inc i) (inc l) 1)
              (= ch \tab) (recur (inc i) l (+ 1 (* 8 (quot (+ c 7) 8))))
              (and (Character/isHighSurrogate ch) (< (inc i) n)) (recur (+ i 2) l (inc c))
              :else (recur (inc i) l (inc c))))
          [l c])))))

(defn- spaces [n] (.repeat " " (int n)))

(defn gap-text
  "The white space the full layout puts between position p and position q when the forms
  record none: spaces on one line, else newlines and the column's spaces"
  [[pl pc] [ql qc]]
  (cond
    (= pl ql) (when (>= qc pc) (spaces (- qc pc)))
    (> ql pl) (str (.repeat "\n" (int (- ql pl))) (spaces (dec qc)))
    :else nil))

(defn gap-text?
  "Whether ws is (gap-text p q)"
  [^String ws [pl pc] [ql qc]]
  (cond
    (= pl ql) (and (= (count ws) (- qc pc)) (boolean (re-matches #" *" ws)))
    (> ql pl) (and (= (count ws) (+ (- ql pl) (dec qc))) (boolean (re-matches #"\n* *" ws))
                   (= (- ql pl) (sx/count-newlines ws)))
    :else false))

(defn layout
  "The text of elements [[l c] text] (sorted by position): each at its position, the white
  space between from space ({[l c] ws}, at the position after an element) or gap-text; tail
  after the last (nil: one newline)"
  [elems space tail]
  (let [sb (StringBuilder.)]
    (loop [es (seq elems) cur [1 1]]
      (if es
        (let [[p text] (first es)
              cur (if-let [ws (get space cur)] (do (.append sb ^String ws) (advance cur ws)) cur)
              g (gap-text cur p)]
          (when (nil? g)
            (throw (ex-info (str "repr-haskell: the full layout cannot reach " (pr-str p) " from " (pr-str cur)
                                 " (before " (pr-str text) ")") {})))
          (.append sb ^String g)
          (.append sb ^String text)
          (recur (next es) (advance p text)))
        (.append sb ^String (or tail "\n"))))
    (str sb)))

(defn full-elements
  "The elements of the full layout: the printer's tokens at the forms' positions (a recorded
  spelling in place of the printer's), the punctuation and the comments, sorted"
  [tokens {:keys [toks punct texts comments]}]
  (when (not= (count tokens) (count toks))
    (throw (ex-info (str "repr-haskell: the full layout prints " (count tokens) " tokens, the forms hold "
                         (count toks) " positions") {})))
  (sort-by first
           (concat (map (fn [t p] [p (get texts p t)]) tokens toks)
                   (map (fn [[l c t]] [[l c] t]) punct)
                   (map (fn [[l c _ _ t]] [[l c] t]) comments))))

(defn print-module-full
  "Forms of mode :full to the original text (SPEC §7.4, 3)"
  [forms]
  (let [d (full-data forms)
        space (into {} (map (fn [[l c ws]] [[l c] ws]) (:space d)))]
    {:file (lv (get (module-options forms) :file))
     :text (layout (full-elements (print-tokens forms) d) space (:tail d))}))

(defn print-module
  "Haskell forms (as read from a forms file) to Haskell source: {:file :text}; forms of mode
  :full in the full layout, the original text, unless layout is :braces or :layout; layout
  :layout: the layout layout (SPEC §7.4, 2)"
  [forms & [layout]]
  (when (and (= layout :full) (not (full-forms? forms)))
    (throw (ex-info "repr-haskell: the full layout needs forms of mode :full (bin/repr-haskell read of a dump --full)" {})))
  (if (and (full-forms? forms) (not (contains? #{:braces :layout} layout)))
    (print-module-full forms)
    (let [forms (mapv lift-all forms)]
      (binding [*o* (out-of forms false (= layout :layout))]
        (print-body! forms)
        ;; the text ends in the module's file, as the original's (GHC's span of the module is in
        ;; the file it ends in; R5: a module whose text is another file's)
        (when-let [cur @(:cur-file *o*)]
          (when (not= cur (:file *o*))
            (when-not @(:bol *o*) (raw! "\n"))
            (raw! (str "{-# LINE " (inc @(:main-line *o*)) " \"" (:file *o*) "\" #-}"))))
        (raw! "\n")
        {:file (:file *o*) :text (str (:sb *o*))}))))

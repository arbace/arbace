(ns arbace.repr.haskell.haddocklex
  "The identifiers of a documentation string, a port of GHC 9.14.1's
  compiler/GHC/Parser/HaddockLex.x (lexHsDoc, lexStringLiteral; doc/haskell/NATIVE.md): each chunk
  of the string scanned by the Alex rules of HaddockLex (an identifier candidate is 'qualid',
  `qualid`, '`qualid`', '(qualid)' or `(qualid)`, the longest match at each position, any other
  character skipped), each candidate checked as GHC.Parser's parseIdentifier checks it: its text
  lexed alone by arbace.repr.haskell.lex with only MagicHash on (validateIdentWith's ParserOpts),
  from the candidate's location in the source, and accepted when it is one token of Parser.y's
  `identifier : qvar | qcon | qvarop | qconop | '->'` (the alternatives with parentheses or
  backquotes cannot occur: a candidate's text has none). A name keeps the span its token has,
  the buffer positions those of the candidate's own buffer (from 0), as GHC's parser gives them.

  A documentation string is (MultiLineDocString decorator [(L span (chunk \"text\"))...]),
  (NestedDocString decorator (L span (chunk \"text\"))) or (GeneratedDocString (chunk \"text\"))
  (arbace.repr.haskell.ast); a name (unqual ns \"occ\"), (qual ns \"M\" \"occ\"), (exact ns \"occ\")."
  (:require [arbace.repr.haskell.lex :as lx]))

(set! *warn-on-reflection* true)

;;; ------------------------------------------------------------------------------------------
;;; The candidates (HaddockLex's rules and alexScanTokens)

(defn- alpha? [^long c] (or (lx/small? c) (lx/large? c)))

(defn- run-end
  "The end of the run of code points satisfying p from i"
  ^long [^ints cs ^long n ^long i p]
  (loop [j i] (if (and (< j n) (p (aget cs j))) (recur (inc j)) j)))

(defn- hash? [^long c] (= c 35))

(defn- qualid-ends
  "The end positions of the matches of @qualid = (@modname \\.)* @id at p, @id = $alpha $idchar*
  \\#* | $symbol+, as ranges [a b] (every position from a to b ends one)"
  [^ints cs ^long n ^long p]
  (loop [p p acc []]
    (if (>= p n)
      acc
      (let [c (aget cs p)
            acc (if (lx/sym-char? c) (conj acc [(inc p) (run-end cs n p lx/sym-char?)]) acc)
            acc (if (alpha? c)
                  (let [r (run-end cs n (inc p) lx/idchar?)]
                    (conj acc [(inc p) (run-end cs n r hash?)]))
                  acc)]
        ;; @modname \. : the whole run of $idchar after a $large, then a dot
        (if (lx/large? c)
          (let [r (run-end cs n (inc p) lx/idchar?)]
            (if (and (< r n) (= 46 (aget cs r))) (recur (long (inc r)) acc) acc))
          acc)))))

(defn- last-close
  "The largest end j among the ranges at which the closing c1 (then c2, unless c2 is -1)
  follows, or -1"
  ^long [^ints cs ^long n ranges ^long c1 ^long c2]
  (reduce (fn [^long best [a b]]
            (let [a (long a)]
              (loop [j (min (long b) (dec n))]
                (cond
                  (or (< j a) (<= j best)) best
                  (and (= c1 (aget cs j))
                       (or (neg? c2) (and (< (inc j) n) (= c2 (aget cs (inc j))))))
                  j
                  :else (recur (dec j))))))
          -1 ranges))

(defn- match-at
  "The longest match of the identifier rules at i: [end adornment], or nil.
  \\' @qualid \\' | \\` @qualid \\` (adornment 1);
  \\'\\` @qualid \\`\\' | \\'\\( @qualid \\)\\' | \\`\\( @qualid \\)\\` (adornment 2)"
  [^ints cs ^long n ^long i]
  (let [c (aget cs i)
        c1 (if (< (inc i) n) (aget cs (inc i)) -1)
        r1 (when (or (= c 39) (= c 96))
             (let [j (last-close cs n (qualid-ends cs n (inc i)) c -1)]
               (when (>= j 0) (inc j))))
        close (cond (and (= c 39) (= c1 96)) [96 39]
                    (and (= c 39) (= c1 40)) [41 39]
                    (and (= c 96) (= c1 40)) [41 96])
        r2 (when close
             (let [j (last-close cs n (qualid-ends cs n (+ i 2)) (close 0) (close 1))]
               (when (>= j 0) (+ j 2))))]
    (cond
      (and r1 r2) (if (>= (long r1) (long r2)) [r1 1] [r2 2])
      r1 [r1 1]
      r2 [r2 2])))

(defn plausible-idents
  "alexScanTokens: the identifier candidates of a text whose first code point is at (line col):
  [[line col text]...], the location of each candidate's identifier (after its adornment), its
  text (advanceSrcLoc's columns: tab stops of 8, a newline starts a line at column 1)"
  [^String s ^long line ^long col]
  (let [cs (lx/code-points s) n (alength cs)]
    (loop [i 0 l line c col out []]
      (if (>= i n)
        out
        (if-let [m (match-at cs n i)]
          (let [e (long (m 0)) a (long (m 1))
                ;; the adornment: no tab, no newline
                c1 (+ c a)
                id-end (- e a)
                cl (loop [k (+ i a) cc c1] (if (< k id-end) (recur (inc k) (inc cc)) cc))]
            (recur e l (long (+ (long cl) a))
                   (conj out [l c1 (String. cs (int (+ i a)) (int (- id-end (+ i a))))])))
          (let [ch (aget cs i)]
            (cond
              (= ch 10) (recur (inc i) (inc l) 1 out)
              (= ch 9) (recur (inc i) l (inc (bit-shift-left (inc (bit-shift-right (dec c) 3)) 3)) out)
              :else (recur (inc i) l (inc c) out))))))))

;;; ------------------------------------------------------------------------------------------
;;; parseIdentifier (validateIdentWith)

(def ^:private ident-bits
  "mkParserOpts (EnumSet.fromList [MagicHash]) dopts False False False False"
  (lx/parser-bits ["MagicHash"] {:use-pos-prags false}))

(def ^:private special-ids
  "varid's keywords: special_id, 'unsafe', 'safe', 'interruptible', 'family', 'role'"
  #{:ITas :ITqualified :IThiding :ITexport :ITlabel :ITdynamic :ITstdcallconv :ITccallconv
    :ITcapiconv :ITprimcallconv :ITjavascriptcallconv :ITgroup :ITstock :ITanyclass :ITvia
    :ITunit :ITdependency :ITsignature :ITquote :ITsplice :ITunsafe :ITsafe :ITinterruptible
    :ITfamily :ITrole})

(defn- token-name
  "The name of an identifier's one token (Parser.y's qvarid, qconid, varsym, qvarsym1, consym,
  qconsym, special_sym and '->'), or nil"
  [t ^String s]
  (let [k (nth t 0) v (nth t 1)]
    (cond
      (= k :ITvarid) (list 'unqual 'var v)
      (= k :ITconid) (list 'unqual 'data v)
      (= k :ITqvarid) (list 'qual 'var (nth v 0) (nth v 1))
      (= k :ITqconid) (list 'qual 'data (nth v 0) (nth v 1))
      (= k :ITvarsym) (list 'unqual 'var v)
      (= k :ITconsym) (list 'unqual 'data v)
      (= k :ITqvarsym) (list 'qual 'var (nth v 0) (nth v 1))
      (= k :ITqconsym) (list 'qual 'data (nth v 0) (nth v 1))
      (contains? special-ids k) (list 'unqual 'var s)
      (= k :ITdot) (list 'unqual 'var ".")
      (= k :ITstar) (list 'unqual 'var (if (= v :unicode) "★" "*"))
      (= k :ITminus) (list 'unqual 'var "-")
      (= k :ITcolon) (list 'exact 'data ":")              ; consDataCon_RDR
      (= k :ITrarrow) (list 'exact 'tc "->")              ; getRdrName unrestrictedFunTyCon
      :else nil)))

(defn identifier
  "validateIdentWith parseIdentifier: the located name (L span name) an identifier's text means
  when it is one, lexed from (line col) of file, else nil"
  [^String s file line col]
  (try
    (let [ps (lx/make-state s file ident-bits)
          _ (lx/set-loc! ps [file line col 0])
          t (lx/lex-token ps)
          nm (token-name t s)]
      (when (and nm (= :ITeof (first (lx/lex-token ps))))
        (list 'L (nth t 2) nm)))
    (catch Exception _ nil)))

;;; ------------------------------------------------------------------------------------------
;;; lexHsDoc, lexStringLiteral

(defn doc-chunks
  "docStringChunks: the located chunks of a documentation string (a generated one's at noSrcSpan)"
  [ds]
  (case (first ds)
    MultiLineDocString (nth ds 2)
    NestedDocString [(nth ds 2)]
    GeneratedDocString [(list 'L nil (nth ds 1))]))

(defn- text-identifiers
  "The names of a text's candidates: at their locations from the start of span, or at span
  itself when it is noSrcSpan (an UnhelpfulSpan keeps its reason)"
  [span ^String text]
  (if span
    (let [file (nth span 0)]
      (into [] (keep (fn [[l c s]] (identifier s file l c)))
            (plausible-idents text (nth span 1) (nth span 2))))
    (into [] (keep (fn [[_ _ s]] (when-let [x (identifier s nil 0 0)] (list 'L nil (nth x 2)))))
          (plausible-idents text 0 0))))

(defn doc-identifiers
  "The identifiers lexHsDoc finds in a documentation string, chunk by chunk"
  [ds]
  (into [] (mapcat (fn [ch] (text-identifiers (nth ch 1) (second (nth ch 2))))) (doc-chunks ds)))

(defn lex-hs-doc
  "lexHsDoc parseIdentifier: (WithHsDocIdentifiers ds identifiers)"
  [ds]
  (list 'WithHsDocIdentifiers ds (doc-identifiers ds)))

(defn lex-l-hs-doc
  "lexLHsDocString: a located documentation string's (L span (WithHsDocIdentifiers ...))"
  [ld]
  (list 'L (nth ld 1) (lex-hs-doc (nth ld 2))))

(defn lex-string-literal
  "lexStringLiteral parseIdentifier: a located (StringLiteral src text tail) as (L span
  (WithHsDocIdentifiers literal identifiers)), the candidates in its text (the literal's value)
  located from the start of span (its opening quote), as GHC locates them"
  [lsl]
  (let [sp (nth lsl 1) sl (nth lsl 2)]
    (list 'L sp (list 'WithHsDocIdentifiers sl (text-identifiers sp (nth sl 2))))))

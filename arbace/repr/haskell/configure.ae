(ns arbace.repr.haskell.configure
  "The configure products of GHC 9.14.1's packages, without a C compiler (HFS-I2 (a); doc/haskell/NATIVE.md, \"The native reads'
  inputs: derived\"): autoconf's config.status over each AC_CONFIG_HEADERS template of the tarball (its `#undef NAME` lines
  become `#define NAME VALUE` or `/* #undef NAME */`, the first line names the output), with the answers of
  test/haskell/target/answers.edn, which `probe` computes on Arbace's C target: a header's presence in musl's tree and Arbace's
  c/include, a function's definition among musl's sources' external symbols, the values (sizes, alignments, constants, the
  Haskell types FPTOOLS_CHECK_HTYPE picks, declarations, members) from one C program per product built and run by ci; the
  rest as the configure scripts define them, a rule a macro (configure-rules below, each citing its configure.ac).
  Also rts/gen_event_types.py's two outputs, its rules in Arbace."
  (:require [arbace.string :as str])
  (:import [java.io File]))

(set! *warn-on-reflection* true)

;;; The products: [output (in the tarball's root) template header-name]; header-name is the
;;; AC_CONFIG_HEADERS argument config.status writes in the first line

(def products-spec
  [["rts/ghcautoconf.h.autoconf" "rts/ghcautoconf.h.autoconf.in" "ghcautoconf.h.autoconf"]
   ["libraries/ghc-internal/include/HsBaseConfig.h" "libraries/ghc-internal/include/HsBaseConfig.h.in" "include/HsBaseConfig.h"]
   ["libraries/ghc-internal/include/EventConfig.h" "libraries/ghc-internal/include/EventConfig.h.in" "include/EventConfig.h"]
   ["libraries/time/lib/include/HsTimeConfig.h" "libraries/time/lib/include/HsTimeConfig.h.in" "lib/include/HsTimeConfig.h"]
   ["libraries/unix/include/HsUnixConfig.h" "libraries/unix/include/HsUnixConfig.h.in" "include/HsUnixConfig.h"]
   ["libraries/directory/HsDirectoryConfig.h" "libraries/directory/HsDirectoryConfig.h.in" "HsDirectoryConfig.h"]
   ["libraries/process/include/HsProcessConfig.h" "libraries/process/include/HsProcessConfig.h.in" "include/HsProcessConfig.h"]])

(defn load-answers
  "test/haskell/target/answers.edn: {output {NAME value-or-nil}} (nil: undefined), or {} before the first probe"
  [^String repo]
  (let [f (File. (str repo "/test/haskell/target/answers.edn"))]
    (if (.isFile f) (:products (read-string (slurp f))) {})))

(defn config-status
  "config.status's header rewrite of a template: the first line, then every `#undef NAME` line"
  ^String [^String template ^String header-name ^String in-name defines]
  (str "/* " header-name ".  Generated from " in-name " by configure.  */\n"
       (apply str
              (for [^String l (str/split template #"\n" -1)]
                (if-let [[_ ws1 ws2 ws3 n] (re-matches #"^([\t ]*)#([\t ]*)undef([\t ]+)([a-zA-Z_][a-zA-Z_0-9]*)\b.*" l)]
                  (if (contains? defines n)
                    (if-some [v (get defines n)]
                      (str ws1 "#" ws2 "define" ws3 n " " v "\n")
                      (str "/* " ws1 "#" ws2 "undef" ws3 n " */\n"))
                    (throw (ex-info (str "configure: no answer for " n " in " header-name) {})))
                  (str l "\n"))))))

(defn products
  "Every product's text {output text}, those the answers cover"
  [^String src answers]
  (into {}
        (for [[out tmpl hname] products-spec
              :let [ds (get answers out)]
              :when ds]
          (let [t (slurp (str src "/" tmpl))
                t (if (str/ends-with? t "\n") (subs t 0 (dec (count t))) t)]
            [out (config-status t hname (.getName (File. ^String tmpl)) ds)]))))

;;; rts/gen_event_types.py's outputs (generate_event_types_defines, generate_event_types_array: no final newline)

(defn py-event-defines [_py ets]
  (str/join "\n" (concat ["/*" " * Do not edit: This file is generated by gen_event_types.py" " */" "" "#pragma once" ""]
                         (for [{:keys [name n]} ets] (str "#define EVENT_" name " " n)))))

(defn py-event-array [_py ets]
  (str/join "\n" (concat ["/*" " * Do not edit: This file is generated by gen_event_types.py" " */" "" "EventType eventTypes[] = {"]
                         (mapcat (fn [{:keys [name n fields desc]}]
                                   [(str "    [EVENT_" name "] = {")
                                    (str "      .etNum = " n ",")
                                    (str "      .size = " (cond (nil? fields) "0xffff" (empty? fields) "0"
                                                               :else (str/join " + " (map #(str "sizeof(" % ")") fields))) ",")
                                    (str "      .desc = \"" desc "\"")
                                    "    },"])
                                 ets)
                         ["};"])))

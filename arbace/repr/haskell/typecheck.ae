(ns arbace.repr.haskell.typecheck
  "The trusting elaborator of Arbace's Haskell front end, its first slice (doc/haskell/FRONTEND-SURVEY.md, HF3, Tier S):
  Haskell 2010's core with type classes by dictionary passing, over the renamer's renamed tree
  (arbace.repr.haskell.rename, (rn/module {...})) and the libraries' interfaces (the helper's iface verb).

  Written anew (clean, HFS1 (b)): Hindley-Milner inference by levels (Rémy's generalisation) with let-generalisation
  per binding group (the renamer's SCCs) and the monomorphism restriction as GHC applies it (Haskell 2010 §4.5.5: a
  group with a pattern or argument-less binding and no signature quantifies no constraint; its constrained variables
  stay for the enclosing scope and the top level's defaulting), class and instance declarations as dictionaries
  (GHC's names: C:Cls, $fClsT, $p1Cls, $dmop, $cop), superclasses by selection, instance contexts by application,
  defaulting (§4.3.4: (Integer, Double), a numeric class among standard ones). It trusts its input: a type error is
  recorded, not reported in GHC's words.

  The elaborated program is GHC's desugared Core with the types erased, the helper's tc verb's vocabulary: (v NAME)
  (lv \"occ\" ID) (lit \"text\") (app F [ARG...]) (lam [B...] E) (let [(bind B E)] E) (letrec [...] E) (case E B [(alt
  CON [B...] E)...]); the pattern matches stay as (match [SCRUTINEE...] [(clause [PAT...] [GUARD...] RHS)...]) (HF5's
  match compiler builds GHC's cases from them). Judged against GHC (tools/hsdump's tc verb): the types of the
  module's binders, alpha-equivalent with the constraints sorted and synonyms expanded, and the evidence: every
  application of a name to dictionaries, the dictionaries normalised (let-bound ones inlined, parameters by place).

  No GHC code is ported here; THIH (Jones, \"Typing Haskell in Haskell\", 1999) and GHC's Tc/ were read as the
  specification of the behaviour. HF9's first slice (doc/haskell/FRONTEND-SURVEY.md, \"As built: HF9 (first slice)\")
  adds, likewise after GHC's functions named at each: kinds erased from the interfaces' types (conv-type, kind-arities),
  type families through arbace.repr.haskell.famenv (a port of GHC.Core.FamInstEnv's reduction), stuck applications'
  equalities deferred, GADT constructors (rejigConRes) and their given equalities in an alternative (tcDataConPat,
  canEqNC), data family instances, unboxed tuples' and sums' types, Coercible erased, implicit parameters, type
  applications, rank-n foralls, ScopedTypeVariables and pattern-bound type variables, view patterns, the literal
  classes (KnownNat, KnownSymbol, KnownChar) and Typeable of applications. Its second slice (\"As built: HF9 (second
  slice)\"): checking mode (tcExpr's Check, tcApp's result before the arguments, tcSkolemise of an expected polytype),
  the implications (equality givens of contexts and patterns scoped over their alternatives and statements, pending
  givens settled later, wanteds and deferred equalities kept with their givens), pattern synonyms (tcPatSynSig,
  tcCheckPatSynDecl, tcPatSynPat, the builders), naughty record selectors, matchDataToTag, matchWithDict, simplifyTop's
  ?callStack and ?exceptionContext defaulting, implicit-parameter bindings, variable constraints, data families
  generative, standalone deriving of imported types, and the instance table indexed by class."
  (:require [arbace.string :as str]
            [arbace.set :as set]
            [arbace.walk :as walk]
            [arbace.repr.haskell.deriv :as deriv]
            [arbace.repr.haskell.famenv :as fam]
            [arbace.repr.haskell.doc :as doc]
            [arbace.repr.haskell.pprhs :as pprhs]
            [arbace.repr.haskell.rename :as rename])
  (:import [java.io File]))

;;; ------------------------------------------------------------------------------------------
;;; The trees

(defn- L? [x] (and (seq? x) (= 'L (first x))))
(defn- lsp [x] (nth x 1))
(defn- lval [x] (if (L? x) (nth x 2) x))
(defn- node? [x] (and (seq? x) (symbol? (first x))))
(defn- con [x] (when (node? x) (first x)))
(defn- arg [x i] (nth x i nil))

(defn- nm
  "The Name of a renamed located name (L sp (rn/name N)), nil otherwise"
  [x]
  (let [v (lval x)]
    (when (and (seq? v) (= 'rn/name (first v))) (second v))))

(defn- ext? [n] (and (vector? n) (= "ext" (nth n 0))))
(defn- occ [n] (cond (keyword? n) (name n) (ext? n) (nth n 3) :else (nth n 2)))
(defn- nmod [n] (when (ext? n) (nth n 2)))
(defn- ext-name [ns m o] ["ext" ns m o])

(defn name-str [n]
  (if (ext? n)
    (str "(ext " (nth n 1) " " (pr-str (nth n 2)) " " (pr-str (nth n 3)) ")")
    (str "(loc " (nth n 1) " " (pr-str (nth n 2)) (apply str (map #(str " " %) (drop 3 n))) ")")))

(def fun-tc (ext-name "tc" "GHC.Internal.Types" "FUN"))
(def list-tc (ext-name "tc" "GHC.Internal.Types" "List"))
(defn tuple-tc [n] (if (zero? n) (ext-name "tc" "GHC.Internal.Tuple" "Unit") (ext-name "tc" "GHC.Internal.Tuple" (str "Tuple" n))))
(defn unboxed-con [n]
  ;; GHC.Builtin.Types' mkTupleStr (Unboxed): (##), MkSolo#, (#,...,#)
  (ext-name "data" "GHC.Internal.Types" (case n 0 "(##)" 1 "MkSolo#" (str "(#" (apply str (repeat (dec n) ",")) "#)"))))
(defn utuple-tc
  "The unboxed tuple type constructor of arity n (mkTupleStr: Unit#, Solo#, TupleN#)"
  [n]
  (ext-name "tc" "GHC.Internal.Types" (case n 0 "Unit#" 1 "Solo#" (str "Tuple" n "#"))))
(defn usum-tc "The unboxed sum type constructor of arity n (GHC.Builtin.Types' sumTyCon: SumN#)" [n]
  (ext-name "tc" "GHC.Internal.Types" (str "Sum" n "#")))
(defn usum-con
  "Alternative alt (1-based) of the unboxed sum of arity n (GHC.Builtin.Types' mkSumDataConOcc: (#_|#), (#|_#)...)"
  [alt n]
  (ext-name "data" "GHC.Internal.Types"
            (str "(#" (apply str (repeat (dec alt) "|")) "_" (apply str (repeat (- n alt) "|")) "#)")))
(defn tuple-con [n] (ext-name "var" "GHC.Internal.Tuple" (if (zero? n) "()" (str "(" (apply str (repeat (dec n) ",")) ")"))))
(def tc-int (ext-name "tc" "GHC.Internal.Types" "Int"))
(def tc-integer (ext-name "tc" "GHC.Internal.Bignum.Integer" "Integer"))
(def tc-double (ext-name "tc" "GHC.Internal.Types" "Double"))
(def tc-float (ext-name "tc" "GHC.Internal.Types" "Float"))
(def tc-char (ext-name "tc" "GHC.Internal.Types" "Char"))
(def tc-bool (ext-name "tc" "GHC.Internal.Types" "Bool"))
(def cls-num (ext-name "tc" "GHC.Internal.Num" "Num"))
(def cls-fractional (ext-name "tc" "GHC.Internal.Real" "Fractional"))
(def cls-eq (ext-name "tc" "GHC.Internal.Classes" "Eq"))
(def cls-enum (ext-name "tc" "GHC.Internal.Enum" "Enum"))

;;; ------------------------------------------------------------------------------------------
;;; Types: [:tc NAME [ARG...]] [:tv \"name\"] [:mv ID] [:app F X] [:forall [TV...] [PRED...] BODY]; a predicate
;;; [CLASS [TYPE...]]; a function type [:tc FUN [A R]]

(defn fn-ty [a r] [:tc fun-tc [a r]])
(defn list-ty [a] [:tc list-tc [a]])
(defn con-ty [n] [:tc n []])

(defn- mk-app [f x]
  (if (= :tc (first f)) [:tc (second f) (conj (nth f 2) x)] [:app f x]))

(def ^:dynamic *metas* nil)   ; atom {id {:ref type :level n}}
(def ^:dynamic *level* 0)
(def ^:dynamic *counter* nil) ; atom
(def ^:dynamic *errors* nil)  ; atom []
(def ^:dynamic *inline-prags* {}) ; {NAME true}: the module's top-level INLINE pragmas active at -O0 (AlwaysActive, ActiveAfter n)
(def ^:dynamic *inline-arities* nil) ; atom {NAME arity}: their bindings' dictionaries and the LHS's patterns (makeCorePair's real_arity)
(def ^:dynamic *strict-binds* nil) ; {:atom (atom [[pn pattern]...]) :level n}: a let's banged pattern bindings, which its body forces (HsLet)
(def ^:dynamic *control* false) ; the negative control: defaulting's order reversed, superclass-implied constraints kept

(defn- fresh-id [] (swap! *counter* inc))
(defn fresh-meta []
  (let [i (fresh-id)] (swap! *metas* assoc i {:level *level*}) [:mv i]))
(defn- error! [& msg] (when *errors* (swap! *errors* conj (apply str msg))))

;; Queue 369 (346's item 7): -fdefer-type-errors, a type error raised where its evidence is used, in GHC's words
;; (GHC.Tc.Errors' mkErrorTerm: the message, then "(deferred type error)", the argument of Control.Exception.Base's
;; typeError). *defer-log* holds each failed unification with what GHC's message is made of: the two types that did not
;; unify, the check's [actual expected] (TypeEqOrigin's uo_actual, uo_expected), the error contexts in force (innermost
;; first, GHC's ErrCtxt stack: an expression's ExprCtxt, an argument's FunAppCtxt, an equation's MatchInCtxt) and the span
;; of the innermost located expression (the CtLoc's)
(def ^:dynamic *defer* false)     ; the module is compiled with -fdefer-type-errors
(def ^:dynamic *defer-log* nil)   ; atom [{:errs ATOM :idx n :ty1 :ty2 :ea [act exp] :fun HEAD :ctxt (...) :span SP}...]
(def ^:dynamic *ectx* ())         ; the contexts, innermost first: [:expr L-expr] [:arg head L-arg n] [:match L-match] [:main]
(def ^:dynamic *espan* nil)       ; the innermost located expression's span
(def ^:dynamic *ea* nil)          ; {:act :exp :fun}: the check whose unification is running (tcWrapResult, tcApp's result)
(def ^:dynamic *ectx-nc* false)   ; the next expression adds no context of its own (tcPolyExprNC: an argument, a parenthesis's body)

(defn prune [t]
  (if (= :mv (first t))
    (if-let [r (:ref (get @*metas* (second t)))]
      (let [r' (prune r)] r')
      t)
    t))

(defn zonk [t]
  (let [t (prune t)]
    (case (first t)
      :tc [:tc (second t) (mapv zonk (nth t 2))]
      :app (mk-app (zonk (nth t 1)) (zonk (nth t 2)))
      :forall [:forall (nth t 1) (mapv (fn [[c ts]] [c (mapv zonk ts)]) (nth t 2)) (zonk (nth t 3))]
      t)))

(defn- metas-of [t]
  (let [t (zonk t) out (atom [])]
    (letfn [(w [t] (case (first t)
                     :mv (when-not (some #{(second t)} @out) (swap! out conj (second t)))
                     :tc (doseq [a (nth t 2)] (w a))
                     :app (do (w (nth t 1)) (w (nth t 2)))
                     :forall (do (doseq [[_ ts] (nth t 2) x ts] (w x)) (w (nth t 3)))
                     nil))]
      (w t))
    @out))

;; synonyms: {NAME [[tv...] rhs]}
(def ^:dynamic *syns* nil)

(defn- subst [m t]
  (case (first t)
    :tv (get m (second t) t)
    :tc [:tc (second t) (mapv #(subst m %) (nth t 2))]
    :app (mk-app (subst m (nth t 1)) (subst m (nth t 2)))
    :forall (let [m' (apply dissoc m (nth t 1))]
              [:forall (nth t 1) (mapv (fn [[c ts]] [c (mapv #(subst m' %) ts)]) (nth t 2)) (subst m' (nth t 3))])
    t))

;; type families (HF9): {NAME family} in arbace.repr.haskell.famenv's form, the interfaces' (tycon ... family ...) and
;; (hsiface/fam-instances ...), the module's own declarations
(def ^:dynamic *families* nil)
(declare zonk deep-expand builtin-fam)

(defn- reduce-family
  "One step of a family application at the head (GHC.Core.FamInstEnv's reduceTyFamApp_maybe), its arguments zonked
  and expanded first (the rewriter's: GHC.Tc.Solver.Rewrite rewrites the arguments before the head); nil when stuck"
  [t]
  (when-let [f (some-> *families* deref (get (second t)))]
    (binding [fam/*family?* (fn [n] (contains? @*families* n))]
      (fam/reduce-fam-app f (mapv (comp deep-expand zonk) (nth t 2)) (fn [args] (builtin-fam (second t) args))))))

(defn expand
  "Expand a type synonym or reduce a type family application at the head (repeatedly)"
  [t]
  (let [t (prune t)]
    (if (= :tc (first t))
      (if-let [[tvs rhs] (get @*syns* (second t))]
        (let [as (nth t 2)]
          (if (>= (count as) (count tvs))
            (expand (reduce mk-app (subst (zipmap tvs as) rhs) (drop (count tvs) as)))
            t))
        (if-let [r (reduce-family t)] (expand r) t))
      t)))

;; HF10-P66 (a): a saturated synonym whose right-hand side is a polytype (RankNTypes' type GenericQ ctx r = forall a. Data
;; ctx a => a -> r; LiberalTypeSynonyms') is expanded where the type is written or read, as GHC's tcSplitSigmaTy and
;; matchExpectedFunTys look through it (coreView): a signature's GenericQ ctx [r] is then a polytype checked by skolemising
;; (check-poly) and an argument f :: GenericQ ctx r a variable of a polytype, instantiated at each use. Kept as the synonym,
;; the elaborator met a :tc where it looks for :forall (check-expr, instantiate) and the quantified variable's dictionary
;; went unsolved (T1735_Help.Basics' gmapQ: "unsolved: Data ctx a")
(defn- poly-syn
  "t, or its expansion when t is a saturated synonym application whose expansion is a polytype"
  [t]
  (if (and (= :tc (first t)) (some-> *syns* deref (get (second t))))
    (let [e (expand t)]
      (if (and (= :forall (first e)) (or (seq (nth e 1)) (seq (nth e 2)))) e t))
    t))

(defn stuck-family?
  "A type family application that does not reduce (yet): GHC keeps it as a wanted equality, the elaborator defers
  the unification"
  [t]
  ;; a data family is generative and injective (its instances are their own tycons): never stuck, unified as a tycon
  (let [t (prune t)] (and (= :tc (first t)) (when-let [f (some-> *families* deref (get (second t)))] (not= :data (:flavour f))))))

(defn deep-expand
  "A type with every synonym expanded"
  [t]
  (let [t (expand (prune t))]
    (case (first t)
      :tc [:tc (second t) (mapv deep-expand (nth t 2))]
      :app (mk-app (deep-expand (nth t 1)) (deep-expand (nth t 2)))
      t)))

(defn- adjust-levels! [t lvl]
  (doseq [i (metas-of t)]
    (swap! *metas* update i (fn [m] (assoc m :level (min (:level m) lvl))))))

(declare want! instantiate)
(declare ^:dynamic *patsyns* tvs-of register-patsyn! matcher-name builder-name builder-dummy? unit#-core unit#-ty)

;; GADTs' local equalities (HF9): a pattern on a GADT constructor whose result refines a skolem of the scrutinee's
;; type (f :: T a -> a; f IntC = ...: a ~ Int) adds the given a ~ Int for its alternative (GHC.Tc.Gen.Pat's
;; tcDataConPat: the implication's given equalities); unification inside reads a skolem through its given, as GHC's
;; solver rewrites a wanted by the inert givens (GHC.Tc.Solver.Rewrite), and the alternative's wanteds are rewritten
;; by them when it ends (infer-matches)
;; REPR_HASKELL_TC_TRACE=1 (or stack): the failed unifications with the givens in scope, the givens as they are added
(def ^:private trace? (System/getenv "REPR_HASKELL_TC_TRACE"))
(def ^:dynamic *given-eqs* nil) ; atom {SKOLEM type, :pending [[a b]...]}
(def ^:dynamic *deferred-eqs* nil) ; atom [[a b]...]: the equalities on stuck family applications, retried at the end
;; HF9 (second slice): the implications' wanted equalities. A given equality whose sides are not known yet (a GADT
;; pattern on a lambda's argument whose type a later argument fixes: fmap (\Refl -> x) (eqT :: Maybe (t :~: t'))) is
;; pending in its scope (GHC keeps the given as it is and canonicalises it when the implication is solved, after the
;; whole binding is typed); an equality that fails under pending givens is deferred with them, as GHC's implication
;; keeps its wanteds, and retried when its binding ends and at the module's end
(def ^:dynamic *implic-eqs* nil) ; atom [[a b GIVENS-ATOM]...]

(declare stuck-family?)
(defn- given-of [t]
  (when *given-eqs*
    (case (first t)
      :tv (get @*given-eqs* (second t))
      ;; HF10-P50 (a): a given equality on a stuck family application (T21973b's Share a ~ a, ClassDecode a's
      ;; superclass): the application rewritten to its other side (GHC.Tc.Solver.Equality's given family equalities)
      :tc (when (and (::fams @*given-eqs*) (stuck-family? t)) (get @*given-eqs* [:fam (zonk t)]))
      nil)))

(defn unify [a b]
  (let [a (prune a) b (prune b)]
    (cond
      (= a b) true
      (given-of a) (unify (given-of a) b)
      (given-of b) (unify a (given-of b))
      (= :mv (first a)) (do (adjust-levels! b (:level (get @*metas* (second a))))
                            (swap! *metas* assoc-in [(second a) :ref] b) true)
      (= :mv (first b)) (unify b a)
      ;; two polytypes of the same shape (withDict's (cls => r) against withKnownNat's (KnownNat n => r)): equal when
      ;; their bodies and contexts are, the quantifiers the same skolems on both sides (GHC's eqType up to alpha)
      (and (= :forall (first a)) (= :forall (first b)) (= (count (nth a 1)) (count (nth b 1))) (= (count (nth a 2)) (count (nth b 2)))
           (every? true? (map (fn [[c1 _] [c2 _]] (or (= c1 c2) (= :cvar c1) (= :cvar c2))) (nth a 2) (nth b 2))))
      (let [sks (mapv (fn [x] [:tv (str x "_sk" (fresh-id))]) (nth a 1))
            ma (zipmap (nth a 1) sks) mb (zipmap (nth b 1) sks)
            ;; a constraint as a type: a class's application, a variable constraint's type
            pt (fn [m [c ts]] (let [ts (mapv #(subst m %) ts)] (if (= :cvar c) (first ts) [:tc c ts])))]
        (and (every? true? (doall (map (fn [x y] (unify (pt ma x) (pt mb y))) (nth a 2) (nth b 2))))
             (unify (subst ma (nth a 3)) (subst mb (nth b 3)))))
      ;; a higher-rank argument (runST's forall s. ST s a): trusted, its variables instantiated (no escape check)
      (= :forall (first a)) (let [[t ps] (instantiate a)] (doseq [p ps] (want! p)) (unify t b))
      (= :forall (first b)) (unify b a)
      (and (= :tc (first a)) (or (get @*syns* (second a)) (stuck-family? a)) (not= a (expand a))) (unify (expand a) b)
      (and (= :tc (first b)) (or (get @*syns* (second b)) (stuck-family? b)) (not= b (expand b))) (unify a (expand b))
      ;; a family applied beyond its arity (Rep a x, Rep :: Type -> Type -> Type of arity 1): the saturated
      ;; applications equal, the further arguments decomposed (an AppTy's, GHC's canEqAppTy)
      (and (stuck-family? a) (stuck-family? b) (= (second a) (second b)) (= (count (nth a 2)) (count (nth b 2)))
           (< (or (:arity (get @*families* (second a))) 99) (count (nth a 2))))
      (let [k (:arity (get @*families* (second a)))]
        (and (unify [:tc (second a) (subvec (nth a 2) 0 k)] [:tc (second b) (subvec (nth b 2) 0 k)])
             (every? true? (doall (map unify (subvec (nth a 2) k) (subvec (nth b 2) k))))))
      ;; an over-applied family against an application (fmap's g a against Rep1 f a): its last argument split off
      (and (= :app (first b)) (stuck-family? a) (< (or (:arity (get @*families* (second a))) 99) (count (nth a 2))))
      (and (unify [:tc (second a) (vec (butlast (nth a 2)))] (nth b 1)) (unify (last (nth a 2)) (nth b 2)))
      (and (= :app (first a)) (stuck-family? b) (< (or (:arity (get @*families* (second b))) 99) (count (nth b 2))))
      (unify b a)
      ;; a stuck family application: the equality deferred (GHC's wanted F ts ~ t, solved once the arguments are known)
      (or (stuck-family? a) (stuck-family? b)) (do (when *deferred-eqs* (swap! *deferred-eqs* conj [a b])) true)
      (and (= :tc (first a)) (= :tc (first b)) (= (second a) (second b)) (= (count (nth a 2)) (count (nth b 2))))
      (every? true? (doall (map unify (nth a 2) (nth b 2))))
      (and (= :app (first a)) (= :tc (first b)) (seq (nth b 2)))
      (and (unify (nth a 1) [:tc (second b) (vec (butlast (nth b 2)))]) (unify (nth a 2) (last (nth b 2))))
      (and (= :app (first b)) (= :tc (first a)) (seq (nth a 2))) (unify b a)
      (and (= :app (first a)) (= :app (first b))) (and (unify (nth a 1) (nth b 1)) (unify (nth a 2) (nth b 2)))
      (and *implic-eqs* *given-eqs* (seq (:pending @*given-eqs*)))
      (do (swap! *implic-eqs* conj [a b *given-eqs*]) true)
      :else (do (when (and *defer-log* *errors*)
                  (swap! *defer-log* conj {:errs *errors* :idx (count @*errors*) :ty1 (zonk a) :ty2 (zonk b) :span *espan*
                                           :ea (when *ea* (assoc *ea* :act (zonk (:act *ea*)) :exp (zonk (:exp *ea*))))
                                           :ctxt *ectx*}))
                (error! "cannot unify " (pr-str (zonk a)) " with " (pr-str (zonk b)))
                (when trace?
                  (binding [*out* *err*]
                    (println "tc-trace: cannot unify" (pr-str (zonk a)) (pr-str (zonk b)) "givens" (pr-str (some-> *given-eqs* deref)))
                    (when (= "stack" trace?) (.printStackTrace (Exception. "tc-trace")))))
                false))))

(defn instantiate
  "A type's foralls instantiated with fresh metas (deeply: a forall under the constraints too): [type [pred...]]"
  [t]
  (loop [t t preds []]
    (if (= :forall (first t))
      (let [m (into {} (map (fn [v] [v (fresh-meta)]) (nth t 1)))]
        (recur (subst m (nth t 3)) (into preds (map (fn [[c ts]] [c (mapv #(subst m %) ts)]) (nth t 2)))))
      [t preds])))

;;; ------------------------------------------------------------------------------------------
;;; Interfaces: the helper's typeF forms

;; HF9 (first slice): kinds erased. GHC's types apply a poly-kinded type constructor to its invisible kind arguments
;; first (Proxy's kind forall {k}. k -> Type: (Proxy k a)); the elaborator trusts kinds (FRONTEND-SURVEY §3.4), so a
;; type read from an interface drops them, as a type the elaborator writes never has them. The count of a type
;; constructor's invisible binders (GHC.Core.TyCon's tyConBinders not visible) is its kind's leading foralls; a class's
;; the class variables that occur in another's kind (classTyVars put them first); a promoted data constructor's its
;; type's leading foralls (its universal variables).
(def ^:dynamic *kind-arity* nil) ; atom {NAME n}

(defn- strs* [n] (vec (map #(if (symbol? %) (name %) %) n)))

(defn- forall-binders
  "The leading forall binders of a typeF form: [[name kind-form]...]"
  [f]
  (loop [f f out []] (if (and (seq? f) (= 'forall (first f))) (recur (nth f 4) (conj out [(nth f 1) (nth f 3)])) out)))

(defn- invisible-positions
  "The argument positions of a kind form's invisible binders (specified or inferred foralls), counting its visible
  arguments (a function's argument, a required forall) and its invisible ones in order"
  [f]
  (loop [f f p 0 out #{}]
    (cond (and (seq? f) (= 'forall (first f)))
          (if (= 'required (nth f 2)) (recur (nth f 4) (inc p) out) (recur (nth f 4) (inc p) (conj out p)))
          (and (seq? f) (= 'fun (first f))) (recur (nth f 4) (inc p) out)
          :else out)))

(defn- tvs-in-form [f]
  (set (keep (fn [x] (when (and (seq? x) (= 'tv (first x))) (second x))) (tree-seq coll? seq f))))

(def wired-kind-arities
  "The primitive equalities no interface lists (GHC.Builtin.Types.Prim's eqPrimTyCon and eqReprPrimTyCon: forall k0
  k1. k0 -> k1 -> ...), and GHC.Builtin.Types' wired-in things of GHC.Internal.Types whose kinds have invisible binders
  the source does not write (HF10-P3: an own interface of GHC.Internal.Types, made from the source, carries no kind;
  GHC's wired-in interface GHC.Internal.Prim names them with their kind arguments): unboxedSoloTyCon (forall (k ::
  RuntimeRep). TYPE k -> ...), its constructor, coercibleTyCon (forall k. k -> k -> Constraint), eqTyCon (the same),
  heqTyCon (forall k0 k1. k0 -> k1 -> Constraint), anyTyCon (forall k. k)"
  {(ext-name "tc" "GHC.Internal.Prim" "~#") 2 (ext-name "tc" "GHC.Internal.Prim" "~R#") 2
   (ext-name "tc" "GHC.Internal.Types" "Solo#") 1 (ext-name "data" "GHC.Internal.Types" "MkSolo#") 2
   (ext-name "tc" "GHC.Internal.Types" "Coercible") 1 (ext-name "tc" "GHC.Internal.Types" "~") 1
   (ext-name "tc" "GHC.Internal.Types" "~~") 2 (ext-name "tc" "GHC.Internal.Types" "Any") 1})

(defn- kind-position-tvs
  "The type variables of a typeF form that occur in kinds: a forall binder's kind, a type constructor's invisible
  arguments (table: the arities known so far)"
  [table f]
  (let [out (volatile! #{})]
    (letfn [(w [f in-kind?]
              (when (seq? f)
                (case (first f)
                  tv (when in-kind? (vswap! out conj (second f)))
                  forall (do (w (nth f 3) true) (w (nth f 4) in-kind?))
                  tycon-app (let [n (get table (strs* (second f)) 0)]
                              (doseq [[i a] (map-indexed vector (nth f 2))] (w a (or in-kind? (< i n)))))
                  (doseq [x (rest f)] (cond (seq? x) (w x in-kind?) (vector? x) (doseq [y x] (w y in-kind?)) :else nil)))))]
      (w f false))
    @out))

(defn kind-arities
  "{NAME n} of interfaces' things (hsiface/things): a type constructor's and a promoted data constructor's from its
  kind's (type's) leading foralls; then a class's, its leading variables that occur in kinds in its methods' types
  or its superclasses (a class without methods, (~) and Coercible: their superclasses' kind arguments), to a fixed
  point (a superclass may be a class: (~)'s is (~~))"
  [things & [known]]
  (let [base (into (merge wired-kind-arities known)
                   (keep (fn [t]
                           (when (seq? t)
                             (case (first t)
                               ;; FUN's first binder is required (forall (n :: Multiplicity) ->): visible, as its kind's
                               ;; text says (the forms write every binder specified); its two representations are
                               ;; the function form's (fun ...) business, not a tycon-app's
                               (tycon datacon) (let [n (count (forall-binders (nth t 5)))]
                                                 (when (and (pos? n) (not (re-find #"^forall \([^)]*\) ->" (str (nth t 2)))))
                                                   [(strs* (nth t 1)) n]))
                               nil))))
                   things)
        ;; a type constructor with an invisible binder after a visible one (TH's Code :: (Type -> Type) -> forall r.
        ;; TYPE r -> Type, applied as Code m r a): its invisible positions, [NAME :pos]
        base (into base (keep (fn [t]
                                (when (and (seq? t) (= 'tycon (first t)))
                                  (let [ps (invisible-positions (nth t 5)) n (count (forall-binders (nth t 5)))]
                                    (when (some #(>= % n) ps) [[(strs* (nth t 1)) :pos] ps]))))
                              things))
        classes (filter #(and (seq? %) (= 'class (first %))) things)]
    (loop [table base i 0]
      (let [table' (into table
                         (keep (fn [t]
                                 (let [tvs (vec (:tvs (nth t 5 {})))
                                       forms (concat (map #(nth % 2) (nth t 3)) (nth t 4))
                                       inkinds (apply set/union #{} (map #(kind-position-tvs table %) forms))
                                       n (count (take-while #(contains? inkinds %) tvs))]
                                   (when (pos? n) [(strs* (nth t 1)) n]))))
                         classes)]
        (if (or (= table' table) (> i 4)) table' (recur table' (inc i)))))))

(defn conv-type
  "A typeF form as a type"
  [f]
  (case (first f)
    tv [:tv (second f)]
    tycon-app (let [n (strs* (second f)) as (mapv conv-type (nth f 2))
                    ;; an unboxed tuple's or sum's representation arguments dropped: the elaborator works with
                    ;; its N component types alone (representations are tostg's, from the components)
                    k (if (and (= "GHC.Internal.Types" (nth n 2)) (re-matches #"(Tuple|Sum)[0-9]+#" (nth n 3)))
                        (quot (count as) 2)
                        (min (count as) (or (some-> *kind-arity* deref (get n)) 0)))]
                (cond
                  (some-> *kind-arity* deref (get [n :pos]))
                  (let [ps (get @*kind-arity* [n :pos])] [:tc n (vec (keep-indexed (fn [i a] (when-not (contains? ps i) a)) as))])
                  (= ["ext" "tc" "GHC.Internal.Prim" "FUN"] n)
                  ;; FUN as a type constructor: its multiplicity and two representations dropped, the elaborator's
                  ;; function type constructor
                  [:tc fun-tc (vec (drop 3 as))]
                  ;; (->), GHC.Internal.Types' synonym of FUN 'Many (instance Category (->)): its two representations
                  ;; dropped
                  (= ["ext" "tc" "GHC.Internal.Types" "->"] n)
                  [:tc fun-tc (vec (drop 2 as))]
                  :else
                  [:tc n (if (pos? k) (subvec as k) as)]))
    app (mk-app (conv-type (nth f 1)) (conv-type (nth f 2)))
    fun (if (= 'c (nth f 1))
          (let [p (conv-type (nth f 3)) body (conv-type (nth f 4))
                ;; a constraint whose head is a variable (withDict's cls => r): [:cvar [type]], solved once the variable
                ;; is a class's application
                pred (case (first p) :tc [(second p) (nth p 2)] (:tv :app) [:cvar [p]]
                       ;; round 54: a quantified constraint (QuantifiedConstraints), [:qc [polytype]]
                       :forall (when (= :tc (first (nth p 3))) [:qc [p]])
                       nil)]
            (if (= :forall (first body))
              (if (empty? (nth body 1)) [:forall [] (into (if pred [pred] []) (nth body 2)) (nth body 3)]
                  [:forall [] (if pred [pred] []) body])
              [:forall [] (if pred [pred] []) body]))
          (fn-ty (conv-type (nth f 3)) (conv-type (nth f 4))))
    forall (let [body (conv-type (nth f 4))]
             (if (and (= :forall (first body)) )
               [:forall (into [(nth f 1)] (nth body 1)) (nth body 2) (nth body 3)]
               [:forall [(nth f 1)] [] body]))
    [:lit (second f)]))

(def ^:dynamic *ifdirs* [])
(def ^:dynamic *genv* nil)      ; atom {NAME type}: the values' types (ids, methods, constructors)
(def ^:dynamic *classes* nil)   ; atom {NAME {:tvs [...] :supers [pred...] :methods [NAME...]}}
(def ^:dynamic *insts* nil)     ; atom [{:dfun NAME :tvs :ctx :head pred}]
(def ^:dynamic *cons* nil)      ; atom {NAME {:arity n :tycon NAME :fields [...] :tag n}}
(def ^:dynamic *tycons* nil)    ; atom {TYCON {:flavour data|newtype :cons [NAME...]}} (HF5-HF6: the match compiler's and STG's)
(def iface-cache (atom {}))
(def ^:dynamic *iface-files* nil) ; {MODULE path}: interfaces named one by one beside the directories' (HF10-P3's closures)
(def ^:dynamic *unfoldings* nil) ; atom {NAME core}: the INLINE default methods' unfoldings (hsiface/unfoldings)
;; HF10-P20: the kinds the elaborator keeps of a value's type variables, where they are a representation's (TYPE AddrRep,
;; UnliftedType, TYPE ('BoxedRep 'Unlifted)): the rest of the elaborator trusts kinds (FRONTEND-SURVEY §3.4), but STG's
;; PrimReps follow from them (Unsafe.Coerce's unsafeCoerceAddr's a and b are Addr# values)
(def ^:dynamic *tv-kinds* nil)  ; atom {NAME {TV kind-type}}
(def ^:dynamic *tc-kinds* nil)  ; atom {TYCON kind-form}: the interfaces' type constructors' kinds (typeF forms; HF10-P41 (a))

(defn rep-kind?
  "A kind that fixes a representation other than a lifted value's: TYPE of a closed RuntimeRep but LiftedRep, or the
  synonym UnliftedType (a closed kind: no type variable in it)"
  [k]
  (and (vector? k) (= :tc (first k)) (vector? (second k))
       (not (some #(and (vector? %) (#{:tv :mv} (first %))) (tree-seq coll? seq k)))
       (case (nth (second k) 3)
         "UnliftedType" true
         "TYPE" (let [r (first (nth k 2))]
                  (and (vector? r) (= :tc (first r)) (not (#{"LiftedRep"} (nth (second r) 3)))
                       (not (and (= "BoxedRep" (nth (second r) 3)) (= "Lifted" (some-> (first (nth r 2)) second (nth 3)))))))
         false)))

(defn- iface-tv-kinds
  "A typeF form's leading forall binders whose kind fixes a representation: {TV kind-type}"
  [f conv]
  (loop [f f out {}]
    (if (and (seq? f) (= 'forall (first f)))
      (let [k (try (conv (nth f 3)) (catch Throwable _ nil))]
        (recur (nth f 4) (if (rep-kind? k) (assoc out (nth f 1) k) out)))
      out)))

(defn- strs [n] (vec (map #(if (symbol? %) (name %) %) n)))

(defn- read-forms [text] (read-string (str "[" text "]")))

(defn- add-things! [things]
  ;; a thing without a type (the renamer's own interface of a module, written before its types are known) is skipped
  (doseq [t things :when (and (seq? t) (case (first t) id (some? (nth t 3 nil)) datacon (some? (nth t 5 nil))
                                         class (some? (nth t 4 nil)) true))]
    (case (first t)
      id (do (swap! *genv* assoc (strs (nth t 1)) (conv-type (nth t 3)))
             (when *tv-kinds*
               (let [ks (iface-tv-kinds (nth t 3) conv-type)] (when (seq ks) (swap! *tv-kinds* assoc (strs (nth t 1)) ks)))))
      datacon (let [n (strs (nth t 1)) ty (conv-type (nth t 5))]
                (swap! *genv* assoc n ty)
                (swap! *cons* update n merge {:arity (nth t 3) :fields (mapv #(ext-name "fld" (nmod n) %) (nth t 4))
                                              :strict (mapv #(= "HsStrict" %) (:impl-bangs (nth t 6 {})))}))
      class (let [n (strs (nth t 1)) info (nth t 5 {})
                  ;; the class's kind variables erased as its predicates' kind arguments are (HF9)
                  tvs (vec (drop (or (some-> *kind-arity* deref (get n)) 0) (:tvs info)))
                  ;; (a quantified superclass too, [:qc [polytype]]: a field of the dictionary, its selector $pN; base's
                  ;; Eq1's forall a. Eq a => Eq (f a), Bifunctor's forall a. Functor (p a))
                  supers (vec (keep (fn [f] (let [p (conv-type f)]
                                              (cond (= :tc (first p)) [(second p) (nth p 2)]
                                                    (and (= :forall (first p)) (= :tc (first (nth p 3)))) [:qc [p]])))
                                    (nth t 4)))]
              (doseq [[mn _ mty] (nth t 3)] (swap! *genv* assoc (strs mn) (conv-type mty)))
              (swap! *classes* assoc n {:tvs tvs :supers supers :methods (mapv (comp strs first) (nth t 3))
                                        ;; every superclass, a quantified one too (MonadTrans's): the dictionary's fields
                                        :nsupers (count (nth t 4))
                                        ;; functional dependencies by parameter position (the iface writes occ names)
                                        :fundeps (let [occs (mapv #(first (str/split (str %) #"#")) tvs)
                                                       pos (fn [o] (.indexOf ^java.util.List occs (str o)))]
                                                   (vec (for [[l r] (:fundeps info)] [(mapv pos l) (mapv pos r)])))
                                        :defaults (into {} (keep (fn [[m d]] (when d [(strs m) (strs d)])) (:defaults info)))
                                        ;; HF10-P33 (a): the own interfaces' default signatures (P17's :dsigs)
                                        :dsigs (into {} (for [[m ty] (:dsigs info)] [(strs m) (conv-type ty)]))}))
      tycon (let [info (nth t 6 {}) tn (strs (nth t 1))]
              ;; HF10-P41 (a): its kind, for Typeable's kind arguments
              (when (and *tc-kinds* (some? (nth t 5 nil))) (swap! *tc-kinds* assoc tn (nth t 5)))
              (when (and *tycons* (contains? '#{data newtype} (nth t 3)))
                (swap! *tycons* assoc tn {:flavour (nth t 3) :cons (mapv strs (nth t 4))})
                (doseq [[i c] (map-indexed vector (nth t 4))]
                  (swap! *cons* update (strs c) assoc :tycon tn :tag (inc i))))
              (when-let [[tvs rhs] (:synonym info)]
                (swap! *syns* assoc (strs (nth t 1)) [(vec tvs) (conv-type rhs)]))
              (when (and *families* (= 'family (nth t 3)))
                (let [ka (or (some-> *kind-arity* deref (get tn)) 0)
                      fl (keyword (name (or (:family info) 'open)))
                      eqns (vec (for [e (:equations info)]
                                  {:tvs (vec (nth e 1)) :lhs (vec (drop ka (map conv-type (nth e 2)))) :rhs (conv-type (nth e 3))}))]
                  (swap! *families* update tn (fn [old] (merge {:eqns []} old
                                                               {:flavour (if (= fl :closed) :closed fl) :arity (- (:arity info 0) ka)}
                                                               (when (= fl :closed) {:eqns (binding [fam/*family?* (fn [n] (contains? @*families* n))]
                                                                                             (fam/compute-incomps eqns))})))))))
      ;; an imported pattern synonym with its signature (the helper's iface2 verb, HF9-P2 (b): patSynSig's parts): its
      ;; pattern type for tcPatSynPat and, when it has a builder, the builder's type (forall univ ex. (req, prov) =>
      ;; args -> res) for its uses as an expression; the iface verb's (patsyn NAME) alone gives neither
      patsyn (let [info (first (filter map? (drop 2 t)))]
               (when (and (map? info) *patsyns*)
                 (let [n (strs (nth t 1))
                       pred (fn [f] (let [p (conv-type f)] (case (first p) :tc [(second p) (nth p 2)] [:cvar [p]])))
                       ps {:univ (vec (:univ info)) :req (mapv pred (:req info)) :ex (vec (:ex info)) :prov (mapv pred (:prov info))
                           :args (mapv conv-type (:args info)) :res (conv-type (:res info))
                           :fields (mapv #(ext-name "fld" (nmod n) %) (:fields info))}]
                   (swap! *patsyns* assoc n (assoc ps :builder (boolean (:builder info))))
                   ;; HF10-P36 (a): its matcher's and builder's types ($mP, $bP: the defining module's bindings)
                   (register-patsyn! n ps (:builder info)))))
      nil)))

(defn- add-fam-instances!
  "An interface's open family instances (fam-instance AXIOM FAMILY [lhs...] rhs): the family's equations"
  [fis]
  (when *families*
    (doseq [fi fis :when (seq? fi)]
      (let [fname (strs (nth fi 2)) ka (or (some-> *kind-arity* deref (get fname)) 0)
            lhs (vec (drop ka (map conv-type (nth fi 3)))) rhs (conv-type (nth fi 4))
            tvs (vec (distinct (keep (fn [x] (when (and (vector? x) (= :tv (first x))) (second x))) (tree-seq coll? seq lhs))))]
        (swap! *families* update fname (fn [old] (update (merge {:flavour :open} old) :eqns (fnil conj []) {:tvs tvs :lhs lhs :rhs rhs})))))))

(defn- add-instances! [insts]
  (doseq [i insts :when (seq? i)]
    (let [ty (conv-type (nth i 2))
          [tvs ctx head] (if (= :forall (first ty))
                           (let [[t1 c1 b] [(nth ty 1) (nth ty 2) (nth ty 3)]]
                             (if (= :forall (first b)) [(into t1 (nth b 1)) (into c1 (nth b 2)) (nth b 3)] [t1 c1 b]))
                           [[] [] ty])]
      (when (= :tc (first head))
        (swap! *insts* conj {:dfun (strs (nth i 1)) :tvs tvs :ctx ctx :head [(second head) (nth head 2)]})))))

(defn- wired!
  "The wired-in constructors the interfaces do not list: [] and (:), (), the tuples"
  []
  (let [a [:tv "a"]]
    (when *tycons*
      (swap! *tycons* assoc list-tc {:flavour 'data :cons [(ext-name "data" "GHC.Internal.Types" "[]") (ext-name "data" "GHC.Internal.Types" ":")]})
      (swap! *cons* assoc (ext-name "data" "GHC.Internal.Types" "[]") {:arity 0 :tycon list-tc :tag 1 :fields []})
      (swap! *cons* assoc (ext-name "data" "GHC.Internal.Types" ":") {:arity 2 :tycon list-tc :tag 2 :fields []})
      (doseq [n (cons 0 (range 2 8))]
        (let [c (ext-name "data" "GHC.Internal.Tuple" (occ (tuple-con n)))]
          (swap! *tycons* assoc (tuple-tc n) {:flavour 'data :cons [c]})
          (swap! *cons* assoc c {:arity n :tycon (tuple-tc n) :tag 1 :fields []}))))
    (swap! *genv* assoc (ext-name "data" "GHC.Internal.Types" "[]") [:forall ["a"] [] (list-ty a)])
    (swap! *genv* assoc (ext-name "data" "GHC.Internal.Types" ":") [:forall ["a"] [] (fn-ty a (fn-ty (list-ty a) (list-ty a)))])
    (swap! *genv* assoc (ext-name "data" "GHC.Internal.Tuple" "()") [:tc (tuple-tc 0) []])
    (doseq [n (range 2 8)]
      (let [vs (mapv #(str "t" %) (range n)) ts (mapv (fn [v] [:tv v]) vs)]
        (swap! *genv* assoc (ext-name "data" "GHC.Internal.Tuple" (occ (tuple-con n)))
               [:forall vs [] (reduce (fn [acc t] (fn-ty t acc)) [:tc (tuple-tc n) ts] (reverse ts))])))
    ;; the unboxed tuples' constructors (wired in: no interface carries them), their representation arguments left out
    (doseq [n (range 0 16)]
      (let [vs (mapv #(str "t" %) (range n)) ts (mapv (fn [v] [:tv v]) vs)]
        (swap! *genv* assoc (unboxed-con n)
               [:forall vs [] (reduce (fn [acc t] (fn-ty t acc)) [:tc (utuple-tc n) ts] (reverse ts))])))
    ;; the unboxed sums' constructors (UnboxedSums; wired in as the tuples'), alternative k of n: t_k -> Sum n# ts
    (doseq [n (range 2 8) k (range 1 (inc n))]
      (let [vs (mapv #(str "t" %) (range n)) ts (mapv (fn [v] [:tv v]) vs)]
        (swap! *genv* assoc (usum-con k n) [:forall vs [] (fn-ty (nth ts (dec k)) [:tc (usum-tc n) ts])])))))

(def ^:dynamic *iface-meta* nil) ; atom {:fix {NAME [prec assoc]} :units {MODULE unit}}: the interfaces' (HF10-P34)
(def iface-forms (atom {}))  ; {[path mtime] forms}: an interface read once per process (front's build of many programs)

(defn load-ifaces!
  "Every interface of the directories: things and instances"
  []
  (wired!)
  (let [bys (vec (for [^File f (concat (for [d *ifdirs* :let [fs (.listFiles (File. ^String d))] :when fs
                                             ^File f (sort-by #(.getName ^File %) fs) :when (str/ends-with? (.getName f) ".iface.edn")]
                                         f)
                                       (for [[_ p] (sort-by key *iface-files*) :let [f (File. ^String p)] :when (.isFile f)] f))]
                   ;; keyed by the canonical path: a closure directory of links into one pool (lib-check) reads each
                   ;; file once
                   (let [k [(.getCanonicalPath f) (.lastModified f)]
                         forms (or (get @iface-forms k) (let [x (read-forms (slurp f))] (swap! iface-forms assoc k x) x))]
                     (into {} (map (fn [x] [(first x) x]) forms)))))]
    ;; the invisible kind arities first: every interface's types are read with them (conv-type)
    (when *kind-arity*
      (swap! *kind-arity* merge (kind-arities (vec (mapcat #(second (get % 'hsiface/things)) bys)) @*kind-arity*)))
    (doseq [by bys]
      ;; HF10-P34: the interfaces' fixities and units (Generic's MetaCons of an imported constructor, MetaData's package)
      (when *iface-meta*
        (let [hm (get by 'hsiface/module) mn (second hm) unit (:unit (nth hm 2 nil))]
          (when (and mn unit) (swap! *iface-meta* assoc-in [:units mn] unit))
          (doseq [f (second (get by 'hsiface/fixities)) :when (and (seq? f) mn (= 5 (count f)))]
            (swap! *iface-meta* assoc-in [:fix ["ext" (name (nth f 1)) mn (str (nth f 2))]]
                   [(nth f 3) (case (name (nth f 4)) "l" 'InfixL "r" 'InfixR 'InfixN)]))))
      (add-things! (second (get by 'hsiface/things)))
      (add-fam-instances! (second (get by 'hsiface/fam-instances)))
      (add-instances! (second (get by 'hsiface/instances)))
      (when *unfoldings*
        (doseq [u (second (get by 'hsiface/unfoldings))]
          (swap! *unfoldings* assoc (strs (second u)) (nth u 2)))))))

(defn builtin-fam
  "GHC.Builtin.Types.Literals' families on literal arguments (their sfMatchFam): Nat arithmetic and comparison,
  Symbol and Char comparison and append; nil when an argument is not a literal"
  [n args]
  (let [o (nth n 3) lits (mapv (fn [t] (let [t (prune t)] (when (= :lit (first t)) (second t)))) args)
        nums (when (every? integer? lits) lits) strs* (when (every? string? lits) lits)
        ord (fn [c] [:tc ["ext" "data" "GHC.Internal.Types" (cond (neg? c) "LT" (zero? c) "EQ" :else "GT")] []])]
    (case o
      "+" (when nums [:lit (+ (nums 0) (nums 1))])
      "*" (when nums [:lit (* (nums 0) (nums 1))])
      "^" (when nums [:lit (reduce * 1 (repeat (nums 1) (nums 0)))])
      "-" (when (and nums (>= (nums 0) (nums 1))) [:lit (- (nums 0) (nums 1))])
      "Div" (when (and nums (pos? (nums 1))) [:lit (quot (nums 0) (nums 1))])
      "Mod" (when (and nums (pos? (nums 1))) [:lit (mod (nums 0) (nums 1))])
      "CmpNat" (when nums (ord (compare (nums 0) (nums 1))))
      "CmpSymbol" (when strs* (ord (compare (strs* 0) (strs* 1))))
      "AppendSymbol" (when strs* [:lit (str (strs* 0) (strs* 1))])
      nil)))

;;; ------------------------------------------------------------------------------------------
;;; Evidence

(def ^:dynamic *wanteds* nil)   ; atom [{:ev ID :pred pred}]
(def ^:dynamic *evidence* nil)  ; atom {ID term}

(defn- eq-pred?
  "An equality constraint (a ~ b, its kind first): solved by unification, its evidence a coercion, erased"
  [[c _]]
  (and (vector? c) (contains? #{"~" "~~"} (nth c 3 nil))))

(def cls-coercible (ext-name "tc" "GHC.Internal.Types" "Coercible"))
(def cls-ip (ext-name "tc" "GHC.Internal.Classes" "IP"))
(def tc-callstack (ext-name "tc" "GHC.Internal.Stack.Types" "CallStack"))
(defn- coercible-pred?
  "Coercible a b (HF9): trusted, its evidence a coercion erased as the boxed equality's (GHC's MCoercible of a
  representational coercion, void at run time): GHC.Tc.Solver's canonicalisation of representational equalities
  decides acceptance, not elaboration, and the program is trusted to be GHC's"
  [[c _]]
  (= c cls-coercible))

(def ^:dynamic *roles* nil) ; atom {TYCON ["nominal"|"representational"|"phantom"...]}: the module's role annotations (round 54)

(defn- newtype-rep
  "round 54: a newtype's application T ts unwrapped to its field's type at ts (GHC.Tc.Solver.Equality's unwrapNewTypeStepper),
  or nil"
  [t]
  (when (= :tc (first t))
    (when-let [ti (some-> *tycons* deref (get (second t)))]
      (when (and (= 'newtype (:flavour ti)) (= 1 (count (:cons ti))))
        (let [c (first (:cons ti)) ct (get @*genv* c)
              [tvs body] (if (= :forall (first ct)) [(nth ct 1) (nth ct 3)] [[] ct])]
          (when (and (= :tc (first body)) (= fun-tc (second body)) (= (count tvs) (count (nth t 2))))
            (let [res (second (nth body 2))]
              (when (and (= :tc (first res)) (= (mapv (fn [x] [:tv x]) tvs) (nth res 2)))
                (subst (zipmap tvs (nth t 2)) (first (nth body 2)))))))))))

(defn- coercible-improve!
  "round 54: the improvement a wanted Coercible a b gives (GHC.Tc.Solver.Equality's canonicalisation of a representational
  equality): the newtypes unwrapped, the same type constructor's arguments decomposed, and an argument at a nominal role (the
  module's role annotations: Data.Set.Internal's type role Set nominal) unified. Its evidence stays erased. Data.Set.Internal's
  sconcat = coerce intersections at NonEmpty (Intersection a) -> Intersection a fixes intersections' element type so"
  [a b depth]
  (when (< depth 20)
    (let [a (expand (zonk a)) b (expand (zonk b))]
      (cond
        (= a b) nil
        (and (= :tc (first a)) (= :tc (first b)) (= (second a) (second b)) (= (count (nth a 2)) (count (nth b 2))))
        (let [rs (some-> *roles* deref (get (second a)))]
          (doseq [[i x y] (map vector (range) (nth a 2) (nth b 2))]
            (if (= "nominal" (nth rs i nil)) (unify x y) (coercible-improve! x y (inc depth)))))
        (newtype-rep a) (coercible-improve! (newtype-rep a) b (inc depth))
        (newtype-rep b) (coercible-improve! a (newtype-rep b) (inc depth))
        :else nil))))

(def ^:dynamic *coercibles* nil) ; atom [[a b]...]: the module's wanted Coercible a b (round 54)

(defn- improve-coercibles!
  "round 54: coercible-improve! over the wanted Coercible pairs, before a group's or a binding's wanteds are solved (GHC
  canonicalises the representational equality once its sides are known: coerce's metas meet the argument and the expected
  type only after its instantiation)"
  []
  (when (and *coercibles* (seq @*coercibles*))
    (doseq [[a b] @*coercibles*] (coercible-improve! a b 0))
    ;; (a pair without metas left improves nothing more)
    (swap! *coercibles* (fn [ps] (vec (filter (fn [[a b]] (or (seq (metas-of a)) (seq (metas-of b)))) ps))))))

(def ^:dynamic *ip-givens* []) ; [[NAME type dict]...]: the implicit parameters a let ?x = e gives its body, innermost last

(defmacro ^:private with-ips
  "body under the implicit parameters env binds (tc-local-binds' ::ip)"
  [env & body]
  `(binding [*ip-givens* (into *ip-givens* (::ip ~env))] ~@body))

(defn- ip-synonym-name
  "The implicit parameter a constraint synonym stands for (HasCallStack, HasExceptionContext), else nil"
  [c]
  (when (vector? c)
    (case [(nth c 2 nil) (nth c 3 nil)]
      ["GHC.Internal.Stack.Types" "HasCallStack"] "callStack"
      ["GHC.Internal.Exception.Type" "HasExceptionContext"] "exceptionContext"
      nil)))

(declare solve-pred)

(defn- ip-shadowed
  "HF10-P48 (a): a class's wanted whose arguments mention an implicit parameter a let ?x = e binds (T23761b's IdCt
  (?ipInt :: Int) under let ?ipInt = 7) solved there, from the bindings and the instances: the binding shadows the
  enclosing givens that mention ?ipInt (GHC.Tc.Solver.InertSet's updInertDicts, Note [Shadowing of implicit
  parameters]); nil leaves it a wanted, as before"
  [pred]
  (when (and (seq *ip-givens*) (vector? (first pred)) (not= cls-ip (first pred))
             (let [ns (set (map first *ip-givens*))]
               (some (fn [x] (and (vector? x) (= :tc (first x)) (= cls-ip (second x))
                                  (let [l (prune (first (nth x 2)))] (and (vector? l) (= :lit (first l)) (contains? ns (second l))))))
                     (tree-seq coll? seq (mapv zonk (second pred))))))
    (solve-pred pred (vec (for [[n t d] (reverse *ip-givens*)] [[cls-ip [[:lit n] t]] d])) 0)))

(defn- want! [pred]
  (cond
    (eq-pred? pred)
    (do (unify (last (butlast (second pred))) (last (second pred))) (list 'co))
    ;; (round 54: its pair kept for the improvement once the arguments' types are known, improve-coercibles!)
    ;; (its evidence the class Coercible's MkCoercible, not (~)'s Eq#: (co :coercible), tostg's)
    (coercible-pred? pred) (let [ts (second pred)] (when (and *coercibles* (>= (count ts) 2)) (swap! *coercibles* conj [(last (butlast ts)) (last ts)])) (list 'co :coercible))
    ;; an implicit parameter a let ?x = e binds (the innermost): its type unified, its dictionary the evidence
    (and (= cls-ip (first pred)) (seq *ip-givens*) (= :lit (first (prune (first (second pred)))))
         (some #(= (second (prune (first (second pred)))) (first %)) *ip-givens*))
    (let [[_ t d] (last (filter #(= (second (prune (first (second pred)))) (first %)) *ip-givens*))]
      (unify (second (second pred)) t) d)
    ;; HF10-P20: the synonyms of an implicit parameter, HasExceptionContext (?exceptionContext :: ExceptionContext) and
    ;; HasCallStack (?callStack :: CallStack), wanted under a let ?x = e of their name: that binding (Exception.Type's
    ;; default toException e = SomeException e where ?exceptionContext = emptyExceptionContext; its context was left
    ;; free in every instance's inlined copy)
    (and (seq *ip-givens*) (vector? (first pred))
         (some #(= (ip-synonym-name (first pred)) (first %)) *ip-givens*))
    (let [[_ _ d] (last (filter #(= (ip-synonym-name (first pred)) (first %)) *ip-givens*))] d)
    :else
  (or (ip-shadowed pred)
  (let [i (fresh-id)]
    ;; a wanted made under given equalities keeps them (its implication's givens, GHC.Tc.Types.Constraint's
    ;; Implication ic_given): it is solved later, after the alternative or the binding that gave them, rewritten by them
    (swap! *wanteds* conj (cond-> {:ev i :pred pred} (and *given-eqs* (seq @*given-eqs*)) (assoc :geqs *given-eqs*)
                            ;; HF10-P54 (a): the let ?x = e bindings in scope, for a constraint family's reduction later
                            (and (seq *ip-givens*) (vector? (first pred)) (some-> *families* deref (get (first pred))))
                            (assoc :ipg *ip-givens*)))
    (list 'ev i)))))

(def ^:private inst-index (atom [nil {}])) ; [the *insts* vector it was made of, {CLASS [inst...]}]

(defn- insts-of
  "The instances of class c, in the table's order (an index of *insts* by class, made again when the table changes:
  HF9's second slice, the derived instances of TH.Syntax looked up over the whole table)"
  [c]
  (let [v @*insts* [v0 m] @inst-index]
    (if (identical? v v0)
      (get m c)
      (let [m (group-by (comp first :head) v)] (reset! inst-index [v m]) (get m c)))))

(def ^:private var-head-index (atom [nil #{}])) ; [the *insts* vector, #{CLASS...}]

(defn- var-head-class?
  "HF10-P54 (a): class c has an instance whose head's first argument is one of its variables (instance TypeCast' () a b
  => TypeCast a b), so a wanted whose first argument is a meta may be solved by it (inst-candidate decides)"
  [c]
  (let [v @*insts* [v0 cs] @var-head-index]
    (if (identical? v v0)
      (contains? cs c)
      (let [cs (set (keep (fn [i] (let [h (first (second (:head i)))]
                                    (when (and (vector? h) (= :tv (first h)) (some #{(second h)} (:tvs i))) (first (:head i)))))
                          v))]
        (reset! var-head-index [v cs])
        (contains? cs c)))))

(defn- zonk-pred [[c ts]]
  (let [ts (mapv (comp deep-expand zonk) ts)]
    ;; a variable constraint now a class's application is that class's predicate
    (if (and (= :cvar c) (= :tc (first (first ts)))) [(second (first ts)) (nth (first ts) 2)] [c ts])))

(defn- match-ty
  "One-way match of a pattern type (its variables in vs) against t: the extended map or nil"
  [vs m p t]
  (let [t (expand (prune t))]
    (cond
      (nil? m) nil
      (and (= :tv (first p)) (contains? vs (second p)))
      (if-let [old (get m (second p))] (when (= (zonk old) (zonk t)) m) (assoc m (second p) t))
      (= :mv (first t)) nil
      (and (= :tc (first p)) (= :tc (first t)) (= (second p) (second t)) (= (count (nth p 2)) (count (nth t 2))))
      (reduce (fn [m [a b]] (match-ty vs m a b)) m (map vector (nth p 2) (nth t 2)))
      (and (= :app (first p)) (= :tc (first t)) (seq (nth t 2)))
      (match-ty vs (match-ty vs m (nth p 1) [:tc (second t) (vec (butlast (nth t 2)))]) (nth p 2) (last (nth t 2)))
      (and (= :tc (first p)) (= :tc (first t))) nil
      (= p t) m
      :else nil)))

(defn- match-ty*
  "round 54: match-ty, an application against an application too (a quantified constraint's head Monad (t m') against
  Monad (t m); an instance signature's body against the method's type)"
  [vs m p t]
  (let [t (expand (prune t))]
    (cond (nil? m) nil
          (and (= :app (first p)) (= :app (first t))) (match-ty* vs (match-ty* vs m (nth p 1) (nth t 1)) (nth p 2) (nth t 2))
          (and (= :tc (first p)) (= :tc (first t)) (= (second p) (second t)) (= (count (nth p 2)) (count (nth t 2))))
          (reduce (fn [m [a b]] (match-ty* vs m a b)) m (map vector (nth p 2) (nth t 2)))
          :else (match-ty vs m p t))))

(declare ^:dynamic *ltypes*)
(declare unlifted-ty?)
(defn- wrap-ev-binds [binds c] (reduce (fn [acc [x t]] (list 'let [(list 'bind x t)] acc)) c (reverse binds)))
(def ^:dynamic *ev-binds* nil) ; atom [[lv term]...]: a binding's superclass evidence, bound once after its dictionary
                               ; lambdas (GHC's evidence bindings, dsEvBinds: $dApplicative = $p1Alternative $dAlternative)
(def ev-binders (atom #{}))    ; the evidence binders made, for the unused ones' removal (resolve-ev-lets)

;; HF10-P48 (a): the constraint tuples' superclass selectors count from 0 ($p0CTuple2, $p1CTuple2: GHC.Builtin.Types'
;; wired-in CTupleN and CSolo, mkConstraintTupleTyCon), every other class's from 1 ($p1Eq)
(defn- sc-base [cls] (if (and (vector? cls) (= "GHC.Internal.Classes" (nth cls 2 nil)) (re-matches #"CTuple[0-9]+|CSolo" (str (nth cls 3 nil)))) 0 1))

;; HF10-P48 (a): a constraint tuple's dictionary constructor is named as its class (GHC.Builtin.Types' CTupleN, CSolo),
;; every other class's C:Cls
(defn- dcon-occ [cls] (if (zero? (sc-base cls)) (nth cls 3) (str "C:" (nth cls 3))))
(defn- dcon-class
  "The class whose dictionary constructor g names, or nil"
  [g]
  (when (vector? g)
    (let [o (str (nth g 3 nil))]
      (cond (str/starts-with? o "C:") ["ext" "tc" (nth g 2) (subs o 2)]
            (zero? (sc-base ["ext" "tc" (nth g 2 nil) o])) ["ext" "tc" (nth g 2) o]))))

(declare dict-param)
(defn- super-closure
  "Givens [[pred term]...] closed under superclasses: (app (v $pNCls) [d]); with *ev-binds* each selection let-bound
  once to an evidence variable, the variable the term"
  [givens]
  (loop [todo givens out []]
    (if (empty? todo)
      out
      (let [g (first todo)
            ;; HF10-P54 (a): a variable constraint given at a class's application is that class's given (tcrun046's MkT
            ;; :: a => T a matched at T (Ord x): Ord x, GHC's given after its rewriting)
            g (let [[[c ts] term] g t (when (= :cvar c) (zonk (first ts)))]
                (if (and t (= :tc (first t)) (some-> *classes* deref (get (second t)))) [[(second t) (nth t 2)] term] g))
            [[c ts] term] g
            info (get @*classes* c)
            ;; round 54: a quantified given's superclasses are quantified givens too (GHC.Tc.Solver.Dict's
            ;; mk_superclasses of a ForAllPred: forall m'. Monad m' => Applicative (t m')), each the selector applied to
            ;; the dictionary function's result
            qsubs (when (= :qc c)
                    (let [[_ vs ctx h] (first ts)
                          hc (when (= :tc (first h)) (second h))
                          hi (when hc (get @*classes* hc))]
                      (keep-indexed (fn [i [sc sts]]
                                     (when-not (#{:cvar :qc} sc)
                                     (let [sh [:tc sc (mapv #(subst (zipmap (:tvs hi) (nth h 2)) %) sts)]
                                           sel (fn [d] (list 'app (list 'v (ext-name "var" (nmod hc) (str "$p" (+ i (sc-base hc)) (occ hc)))) [d]))
                                           ps (mapv dict-param ctx)]
                                       [[:qc [[:forall vs ctx sh]]]
                                        (if (empty? ps) (sel term) (list 'lam ps (sel (list 'app term ps))))])))
                                   (:supers hi))))
            subs (if qsubs qsubs (map-indexed (fn [i [sc sts]]
                                (let [p [sc (mapv #(subst (zipmap (:tvs info) ts) %) sts)]
                                      ;; HF10-P48 (a): a variable superclass at a class's application is that predicate
                                      ;; (IdCt (?ipInt :: Int)'s superclass ?ipInt :: Int)
                                      p (if (= :cvar sc)
                                          (let [t (zonk (first (second p)))] (if (= :tc (first t)) [(second t) (nth t 2)] [:cvar [t]]))
                                          p)
                                      sc (first p)
                                      sel (list 'app (list 'v (ext-name "var" (nmod c) (str "$p" (+ i (sc-base c)) (occ c)))) [term])]
                                  (if (and *ev-binds* term)
                                    (let [x (list 'lv (str "$d" (occ sc)) (str "ev" (swap! *counter* inc)))]
                                      (swap! *ev-binds* conj [x sel])
                                      (swap! ev-binders conj x)
                                      (when *ltypes* (swap! *ltypes* assoc x (if (#{:cvar :qc} sc) (first (second p)) [:tc sc (second p)])))
                                      [p x])
                                    [p sel])))
                              (:supers info)))]
        (recur (concat (rest todo) (remove (fn [[p _]] (some #(= p (first %)) out)) subs)) (conj out g))))))

(def ^:dynamic *srcfile* nil)  ; the source file's path as the compiler was given it (HasCallStack's SrcLoc)
(def ^:dynamic *unit* "main")  ; the unit the module is compiled in (SrcLoc's package, Typeable's $trModule; HF10: ghc-internal)
(def ^:dynamic *skolem-givens* nil) ; atom [[pred term]...]: the dictionaries existential patterns bind
(def ^:dynamic *pat-dicts* nil)     ; atom [[pred dvar]...]: the dictionaries a pattern binds itself, no superclass
                                    ; (HF10-P36: an inferred pattern synonym's provided context, tcCollectEx)

(def cls-typeable (ext-name "tc" "GHC.Internal.Data.Typeable.Internal" "Typeable"))

;;; HF10-P41 (a): kinds where Typeable needs them. The elaborator erases kind arguments (HF9); Typeable's evidence of a
;;; poly-kinded type constructor's application names them (GHC.Tc.Instance.Class's doTyConApp: mkTrCon of the tycon at
;;; its kind arguments, onlyNamedBndrsApplied's), so they are recovered at the use site: the tycon's kind instantiated,
;;; its visible arguments' kinds unified with its parameters' (the arguments' kinds from their own heads), the invisible
;;; binders' metas then its kind arguments, a meta nothing fixes defaulted to Type (GHC's defaulting of a kind variable).
;;; The module's own data types' and newtypes' kinds are inferred (infer-tycon-kinds!) as GHC.Tc.TyCl's kcTyClGroup does
;;; for a declaration without a kind signature, and written into the own interface (ownface) and the $tc binding's KindRep.

(def ^:dynamic *kind-env* nil)   ; atom {TV kind}: the kinds of a type's variables while its kind is computed

(def kind-type-tc (ext-name "tc" "GHC.Internal.Types" "Type"))
(def ^:private star-kind [:tc kind-type-tc []])
(def ^:private constraint-kind [:tc (ext-name "tc" "GHC.Internal.Types" "Constraint") []])
(def ^:private type-tc (ext-name "tc" "GHC.Internal.Prim" "TYPE"))

(defn- soft-unify
  "unify without an error, a deferred or an implication's equality: a kind the inference cannot fit is left as it is"
  [a b]
  (binding [*errors* nil *deferred-eqs* nil *implic-eqs* nil *given-eqs* nil]
    (try (unify a b) (catch Throwable _ false))))

(defn- arrow-kind
  "A kind's head as a function kind [arg res], expanded (a synonym of one); nil for another"
  [k]
  (let [k (expand (prune k))]
    (when (and (= :tc (first k)) (= fun-tc (second k)) (= 2 (count (nth k 2)))) (nth k 2))))

(defn- apply-kind
  "The kind of an application of a thing of kind k to arguments of kinds aks: each argument's kind unified with the
  parameter's (a kind not yet known an arrow of fresh metas)"
  [k aks]
  (reduce (fn [k ak]
            (if-let [[p r] (arrow-kind k)]
              (do (soft-unify p ak) r)
              (let [r (fresh-meta)] (soft-unify k (fn-ty ak r)) r)))
          k aks))

(declare kind-of)

(defn- tycon-kind
  "A type constructor's kind instantiated: [kind-args kind], kind-args the fresh metas of its invisible binders in order,
  kind its kind after them; nil when it is not known. The module's own type constructors' from the inference (:kind,
  a meta-kinded arrow while it runs), the interfaces' from their kind forms (the leading invisible binders, the tycon's
  kind arity), a promoted data constructor's from its type (its universal variables), a class's of its arity with
  fresh parameter kinds, the tuples' and lists' Type's"
  [n]
  (let [info (some-> *tycons* deref (get n))
        own-k (:kind info)
        form (some-> *tc-kinds* deref (get n))]
    (cond
      own-k (let [[vs body] (if (= :forall (first own-k)) [(nth own-k 1) (nth own-k 3)] [[] own-k])
                  ms (mapv (fn [_] (fresh-meta)) vs)]
              [ms (subst (zipmap vs ms) body)])
      form (let [ka (or (some-> *kind-arity* deref (get n)) 0)
                 k (try (conv-type form) (catch Throwable _ nil))]
             (when (and k (not (some-> *kind-arity* deref (get [n :pos]))))
               (let [[vs body] (if (= :forall (first k)) [(nth k 1) (nth k 3)] [[] k])]
                 (when (and (<= ka (count vs)) (empty? (if (= :forall (first k)) (nth k 2) [])))
                   (let [ms (mapv (fn [_] (fresh-meta)) vs)]
                     [(subvec ms 0 ka) (subst (zipmap vs ms) body)])))))
      (and (vector? n) (= "data" (nth n 1)) (get (some-> *genv* deref) n))
      (let [t (get @*genv* n)
            [vs ctx body] (if (= :forall (first t)) [(nth t 1) (nth t 2) (nth t 3)] [[] [] t])]
        (when (empty? ctx)
          (let [ms (mapv (fn [_] (fresh-meta)) vs)] [ms (subst (zipmap vs ms) body)])))
      (some-> *classes* deref (get n) :kind)
      (let [k (:kind (get @*classes* n))
            [vs body] (if (= :forall (first k)) [(nth k 1) (nth k 3)] [[] k])
            ms (mapv (fn [_] (fresh-meta)) vs)]
        [ms (subst (zipmap vs ms) body)])
      (some-> *classes* deref (get n))
      (let [ka (or (some-> *kind-arity* deref (get n)) 0)]
        [(mapv (fn [_] (fresh-meta)) (range ka))
         (reduce (fn [acc _] (fn-ty (fresh-meta) acc)) constraint-kind (:tvs (get @*classes* n)))])
      (= list-tc n) [[] (fn-ty star-kind star-kind)]
      (and (vector? n) (= "GHC.Internal.Tuple" (nmod n)) (re-matches #"Tuple[0-9]+|Unit|Solo" (occ n)))
      (let [k (case (occ n) "Unit" 0 "Solo" 1 (parse-long (subs (occ n) 5)))]
        [[] (reduce (fn [acc _] (fn-ty star-kind acc)) star-kind (range k))])
      :else nil)))

(defn kind-of
  "A type's kind (fresh metas where it is not known)"
  [t]
  (let [t (expand (prune t))]
    (case (first t)
      :tc (let [[_ n as] t]
            (cond
              ;; a function's argument and result: of kinds TYPE r (Type once the representation is defaulted)
              (and (= fun-tc n) (= 2 (count as))) (do (doseq [a as] (soft-unify (kind-of a) [:tc type-tc [(fresh-meta)]])) star-kind)
              ;; an unboxed tuple's or sum's components: each of a kind TYPE r (its representation, defaulted to
              ;; LiftedRep by the inference when nothing fixes it), the whole of TYPE of their TupleRep (left open)
              (and (vector? n) (= "GHC.Internal.Types" (nmod n)) (re-matches #"(Tuple|Sum)[0-9]+#" (str (occ n))))
              (do (doseq [a as] (soft-unify (kind-of a) [:tc type-tc [(fresh-meta)]])) [:tc type-tc [(fresh-meta)]])
              :else
              (if-let [[_ k] (tycon-kind n)] (apply-kind k (mapv kind-of as)) (do (doseq [a as] (kind-of a)) (fresh-meta)))))
      :app (apply-kind (kind-of (nth t 1)) [(kind-of (nth t 2))])
      :lit (if (string? (second t)) [:tc (ext-name "tc" "GHC.Internal.Types" "Symbol") []]
               [:tc (ext-name "tc" "GHC.Internal.Bignum.Natural" "Natural") []])
      :lit-char [:tc tc-char []]
      ;; a quantified type (a field forall m. Quasi m => m a): its body's kind Type, its context's Constraint
      :forall (do (doseq [[c ts] (nth t 2)] (soft-unify (kind-of (if (= :cvar c) (first ts) [:tc c ts])) constraint-kind))
                  (soft-unify (kind-of (nth t 3)) [:tc type-tc [(fresh-meta)]])
                  star-kind)
      :tv (if *kind-env*
            (or (get @*kind-env* (second t)) (let [m (fresh-meta)] (swap! *kind-env* assoc (second t) m) m))
            (fresh-meta))
      (fresh-meta))))

(defn- default-kind
  "A kind zonked, its metas defaulted to Type (GHC.Tc.Solver's defaulting of the kind variables left)"
  [k]
  (doseq [i (metas-of k)] (soft-unify [:mv i] star-kind))
  (zonk k))

(defn tycon-kind-info
  "HF10-P41 (a): a type constructor n applied to as at the expected kind ek (or nil): [kind-args param-kinds], its kind
  arguments (doTyConApp's kind_args) and each argument's expected kind (nil where not closed), closed kinds; [[] nil]
  when its kind is not known"
  [n as & [ek]]
  (binding [*kind-env* (atom {})]
    (if (and (vector? n) (= "GHC.Internal.Types" (nmod n)) (re-matches #"(Tuple|Sum)[0-9]+#" (str (occ n))))
      ;; an unboxed tuple's or sum's kind arguments are its components' representations (TupleN# :: forall r1 .. rn.
      ;; TYPE r1 -> .. -> TYPE (TupleRep [r1 .. rn]), the elaborator's types leave them out)
      (let [rep-of (fn [k] (let [k (deep-expand (zonk k))]
                             (when (and (= :tc (first k)) (= "TYPE" (str (occ (second k)))) (= 1 (count (nth k 2))))
                               (first (nth k 2)))))
            reps (mapv (fn [a] (or (rep-of (kind-of a)) (rep-of star-kind))) as)]
        [(if (every? some? reps) (mapv default-kind reps) []) nil])
    (if-let [[ms k] (tycon-kind n)]
      (let [aks (mapv kind-of as)
            [pks r] (reduce (fn [[pks k] ak]
                              (if-let [[p r] (arrow-kind k)]
                                (do (soft-unify p ak) [(conj pks p) r])
                                (let [r (fresh-meta)] (soft-unify k (fn-ty ak r)) [(conj pks ak) r])))
                            [[] k] aks)]
        (when ek (soft-unify r ek))
        (let [kargs (mapv default-kind ms)]
          [kargs (mapv (fn [p] (let [p (zonk p)] (when (empty? (metas-of p)) p))) pks)]))
      [[] nil]))))

(defn tycon-kind-args
  "HF10-P41 (a): the kind arguments of a type constructor n applied to as (doTyConApp's kind_args), closed kinds; [] when
  it has none or its kind is not known"
  [n as & [ek]]
  (first (tycon-kind-info n as ek)))

(defn- typeable-tycon-ref
  "HF10-P39 (a): the TyCon binding of a type constructor's Typeable evidence (GHC.Tc.Instance.Typeable's names, which
  tc-rep-ref writes too): a promoted data constructor's $tc'O in its module ('Many: GHC.Internal.Types' $tc'Many, which
  promoted-typeable-binds binds), GHC.Internal.Prim's in GHC.Internal.Types (mkPrimTypeableTodos), another's $tcO"
  [n]
  (cond (and (vector? n) (= "data" (nth n 1))) (ext-name "var" (nmod n) (str "$tc'" (occ n)))
        (= "GHC.Internal.Prim" (nmod n)) (ext-name "var" "GHC.Internal.Types" (str "$tc" (occ n)))
        :else (ext-name "var" (nmod n) (str "$tc" (occ n)))))

(def ^:private many-typeable
  (list 'app (list 'v (ext-name "var" "GHC.Internal.Data.Typeable.Internal" "mkTrCon"))
        [(list 'v (ext-name "var" "GHC.Internal.Types" "$tc'Many")) (list 'v (ext-name "var" "GHC.Internal.Types" "[]"))]))
(def ^:private lifted-rep-typeable
  (let [con (fn [o] (list 'app (list 'v (ext-name "var" "GHC.Internal.Data.Typeable.Internal" "mkTrCon"))
                          [(list 'v (ext-name "var" "GHC.Internal.Types" (str "$tc'" o))) (list 'v (ext-name "var" "GHC.Internal.Types" "[]"))]))]
    (list 'app (list 'v (ext-name "var" "GHC.Internal.Data.Typeable.Internal" "SomeTypeRep"))
          [(list 'app (list 'v (ext-name "var" "GHC.Internal.Data.Typeable.Internal" "mkTrAppChecked")) [(con "BoxedRep") (con "Lifted")])])))
(defn- typeable-fun [m a b] (list 'app (list 'v (ext-name "var" "GHC.Internal.Data.Typeable.Internal" "mkTrFun")) [m a b]))

(declare promote-kind-names)

(defn- known-lit-dict
  "The dictionary of KnownNat, KnownSymbol or KnownChar (cls, the class's occurrence) at a type-level literal t ([:lit x],
  [:lit-char c]): the literal (GHC.Tc.Instance.Class's matchKnownNat, matchKnownSymbol, matchKnownChar; HF10-P34: the
  evidence as GHC's EvLit makes it, GHC.HsToCore.Binds' dsEvTerm of EvNum/EvStr: a Natural, SNat's newtype of it, NS of
  the word when it fits, a String by mkStringExprFS, SSymbol's); nil for another type"
  [cls t]
  (case (first t)
    :lit (let [x (second t)]
           (cond (and (string? x) (not= "KnownChar" cls) (empty? x)) (list 'v (ext-name "var" "GHC.Internal.Types" "[]"))
                 (and (string? x) (not= "KnownChar" cls))
                 (list 'app (list 'v (ext-name "var" "GHC.Internal.CString" (if (every? #(< 0 (int %) 128) x) "unpackCString#" "unpackCStringUtf8#")))
                       [(list 'lit (str (pr-str x) "#"))])
                 (and (integer? x) (<= 0 x) (< x 18446744073709551616N))
                 (list 'app (list 'v (ext-name "var" "GHC.Internal.Bignum.Natural" "NS")) [(list 'lit (str x "##"))])
                 :else (list 'lit (pr-str x))))
    :lit-char (list 'lit (str "'" (char (second t)) "'"))
    nil))

(defn- typeable-lit
  "HF10-P42 (a): Typeable of a type-level literal (GHC.Tc.Instance.Class's doTyLit, the desugarer's EvTypeableTyLit:
  typeNatTypeRep, typeSymbolTypeRep or typeCharTypeRep at the literal's KnownNat, KnownSymbol or KnownChar dictionary);
  nil for another type"
  [t]
  (let [[f cls] (case (first t)
                  :lit (if (string? (second t)) ["typeSymbolTypeRep" "KnownSymbol"] ["typeNatTypeRep" "KnownNat"])
                  :lit-char ["typeCharTypeRep" "KnownChar"]
                  nil)]
    (when f
      (list 'app (list 'v (ext-name "var" "GHC.Internal.Data.Typeable.Internal" f)) [(known-lit-dict cls t)]))))

(defn- typeable-term
  "Typeable's evidence for a type without variables (GHC.Tc.Instance.Class's Typeable solver: a type constructor
  mkTrCon of its $tc binding, an application mkTrApp of its parts, a type-level literal's doTyLit); nil for another type"
  [t & [ek]]
  (let [t (promote-kind-names (deep-expand (zonk t)))
        ;; HF10-P41 (a): a tuple of constraints is a constraint tuple ((Eq Int, Eq String) :: Constraint, GHC's CTuple2)
        t (if (and (= :tc (first t)) (re-matches #"Tuple[0-9]+" (str (occ (second t)))) (= "GHC.Internal.Tuple" (nmod (second t)))
                   (seq (nth t 2)) (every? #(and (= :tc (first %)) (contains? @*classes* (second %))) (nth t 2)))
            [:tc (ext-name "tc" "GHC.Internal.Classes" (str "C" (occ (second t)))) (nth t 2)]
            t)]
    (if (#{:lit :lit-char} (first t))
      (typeable-lit t)
    (when (= :tc (first t))
      (if (and (= fun-tc (second t)) (= 2 (count (nth t 2))))
        ;; HF10-P39 (a): a function type's evidence (doFunTy, the desugarer's EvTypeableTrFun): mkTrFun of the
        ;; multiplicity's ('Many, its promoted constructor's $tc'Many) and the argument's and result's
        (let [[a b] (map typeable-term (nth t 2))]
          (when (and a b) (typeable-fun many-typeable a b)))
      (let [[_ n args] t
            [kargs pks] (tycon-kind-info n args ek)
            con (list 'app (list 'v (ext-name "var" "GHC.Internal.Data.Typeable.Internal" "mkTrCon"))
                      [(list 'v (typeable-tycon-ref n))
                       (if (= fun-tc n)
                         ;; HF10-P39 (a): the arrow unapplied ((->) = FUN 'Many, funTyCon's typeRep @(->)): $tcFUN's three
                         ;; kind arguments (splitForAllForAllTyBinders: m, q, r), 'Many and the defaulted LiftedRep twice
                         (reduce (fn [acc x] (list 'app (list 'v (ext-name "var" "GHC.Internal.Types" ":")) [x acc]))
                                 (list 'v (ext-name "var" "GHC.Internal.Types" "[]"))
                                 [lifted-rep-typeable lifted-rep-typeable (list 'app (list 'v (ext-name "var" "GHC.Internal.Data.Typeable.Internal" "SomeTypeRep")) [many-typeable])])
                         ;; HF10-P41 (a): its kind arguments (doTyConApp's kind_args), each a SomeTypeRep of its own
                         ;; evidence
                         (let [ks (mapv (fn [k] (when-let [e (typeable-term k)]
                                                  (list 'app (list 'v (ext-name "var" "GHC.Internal.Data.Typeable.Internal" "SomeTypeRep")) [e])))
                                        kargs)]
                           (reduce (fn [acc x] (list 'app (list 'v (ext-name "var" "GHC.Internal.Types" ":")) [x acc]))
                                   (list 'v (ext-name "var" "GHC.Internal.Types" "[]"))
                                   (reverse (if (every? some? ks) ks [])))))])
            subs (mapv (fn [a i] (typeable-term a (get pks i))) args (range))]
        (when (every? some? subs)
          (reduce (fn [f x] (list 'app (list 'v (ext-name "var" "GHC.Internal.Data.Typeable.Internal" "mkTrAppChecked")) [f x])) con subs))))))))

(declare cls-callstack fresh-lv solve-pred ctx-preds rewrite-by-givens dict-param)

;; HF10-P54 (a): functional dependencies and overlapping instances in the solver (GHC.Core.InstEnv's lookupInstEnv,
;; GHC.Tc.Instance.FunDeps' improveFromInstEnv), read from GHC 9.14.1's source

(defn- improve-one!
  "A wanted [c ts]'s improvement by the functional dependencies of its class from the instances (GHC.Tc.Instance.FunDeps'
  improveFromInstEnv: an instance whose head matches the wanted at a dependency's left positions gives its right
  positions, the instance's other variables fresh); only metas are fixed (HF10-P42 (a)); true when something was unified"
  [[c ts]]
  (let [changed (atom false) fds (some-> *classes* deref (get c) :fundeps)]
    (doseq [[ls rs] fds :when (and (every? #(< -1 % (count ts)) ls) (every? #(< -1 % (count ts)) rs))
            :let [ts (mapv zonk ts)
                  inst (some (fn [{:keys [tvs head] :as i}]
                               (when (= (first head) c)
                                 (when-let [m (reduce (fn [m p] (match-ty (set tvs) m (nth (second head) p) (nth ts p))) {} ls)]
                                   [i m])))
                             (insts-of c))]
            :when inst]
      (let [[{:keys [tvs head]} m] inst
            m (into (into {} (map (fn [v] [v (fresh-meta)]) tvs)) m)]
        (doseq [p rs]
          (let [want (zonk (nth ts p)) got (subst m (nth (second head) p))]
            (when (and (not= want (zonk got)) (seq (metas-of want))) (unify (nth ts p) got) (reset! changed true))))))
    @changed))

(defn- inst-unify
  "GHC.Core.Unify's tcUnifyTys as instEnvMatchesAndUnifiers' check_unifiers uses it: the substitution s ({[:tv v] or
  [:mv i] type}) extended so that p (an instance head's type, its variables vs) and t (a wanted's, its metas variables)
  are equal, or nil when they are apart; a stuck family application may become anything (MaybeApart)"
  [vs s p t]
  (when s
    (let [walk (fn walk [x] (let [x (expand (prune x))] (if-let [r (and (#{:tv :mv} (first x)) (get s x))] (walk r) x)))
          a (walk p) b (walk t)
          var? (fn [x] (or (= :mv (first x)) (and (= :tv (first x)) (contains? vs (second x)))))
          args (fn [s xs ys] (reduce (fn [s [x y]] (inst-unify vs s x y)) s (map vector xs ys)))]
      (cond (= a b) s
            (var? a) (assoc s a b)
            (var? b) (assoc s b a)
            (or (stuck-family? a) (stuck-family? b)) s
            (and (= :tc (first a)) (= :tc (first b)))
            (when (and (= (second a) (second b)) (= (count (nth a 2)) (count (nth b 2)))) (args s (nth a 2) (nth b 2)))
            (and (= :app (first a)) (= :tc (first b)) (seq (nth b 2)))
            (args s [(nth a 1) (nth a 2)] [[:tc (second b) (vec (butlast (nth b 2)))] (last (nth b 2))])
            (and (= :tc (first a)) (= :app (first b)) (seq (nth a 2)))
            (args s [[:tc (second a) (vec (butlast (nth a 2)))] (last (nth a 2))] [(nth b 1) (nth b 2)])
            (and (= :app (first a)) (= :app (first b))) (args s [(nth a 1) (nth a 2)] [(nth b 1) (nth b 2)])
            :else nil))))

(defn- head-match [i ts]
  (reduce (fn [m [p t]] (match-ty (set (:tvs i)) m p t)) {} (map vector (second (:head i)) ts)))

(defn- inst-candidate
  "The instance [inst match] that solves [c ts] (GHC.Core.InstEnv's lookupInstEnv): of the instances whose heads match,
  those another more specific one overlaps are pruned (pruneOverlappedMatches: the program was accepted, so the overlap
  is allowed), the first left; none when ts has metas and an instance that does not match unifies with it (its choice
  waits for them: Note [Overlapping instances])"
  ([c ts] (inst-candidate c ts true))
  ([c ts wait?]
  (let [is (insts-of c)
        ms (vec (keep (fn [i] (when-let [m (head-match i ts)] [i m])) is))]
    (when (seq ms)
      (let [spec? (fn [a b] (some? (head-match b (second (:head a))))) ; a's head an instance of b's
            pruned (if (= 1 (count ms)) ms
                       (filterv (fn [[a _]] (not-any? (fn [[b _]] (and (not (identical? a b)) (spec? b a) (not (spec? a b)))) ms)) ms))
            metas? (and wait? (some #(seq (metas-of %)) ts))]
        (when-not (and metas?
                       (let [mset (set (map first ms))]
                         (some (fn [i] (and (not (contains? mset i))
                                            (inst-unify (set (:tvs i)) {} [:tc :h (second (:head i))] [:tc :h (vec ts)])))
                               is)))
          (first pruned)))))))

(defn- solve-ctx
  "An instance's context [pred...] solved together (GHC's solver works on the wanteds as a set): each round every
  unsolved one improved by its class's dependencies and tried again, until all are solved or a round changes nothing;
  the terms, or nil"
  [preds givens depth]
  (if (not-any? (fn [[_ ts]] (some #(seq (metas-of %)) ts)) preds)
    ;; no metas: nothing to improve, one pass that stops at the first failure (an instance's context solved before)
    (let [subs (reduce (fn [acc p] (if-let [t (solve-pred p givens depth)] (conj acc t) (reduced nil))) [] preds)] subs)
    (loop [k 0 terms (vec (repeat (count preds) nil))]
      (let [before (mapv zonk-pred preds)
            terms' (mapv (fn [t p] (or t (do (when (seq (some-> *classes* deref (get (first (zonk-pred p))) :fundeps)) (improve-one! (zonk-pred p)))
                                             (solve-pred p givens depth))))
                         terms preds)]
        ;; another round only when this one unified a meta (a failed predicate is tried again only when it changed:
        ;; trying every one again each round was exponential in the instances' depth, AtomicPrimops' 9 s became minutes)
        (cond (every? some? terms') terms'
              (or (> k 8) (= before (mapv zonk-pred preds))) nil
              :else (recur (inc k) terms'))))))

(def ^:dynamic *solving* {}) ; {pred (atom lv)}: the predicates whose instance is being solved (recursive dictionaries)

(defn solve-pred
  "A dictionary term for pred from the givens or the instances, nil when none applies yet"
  [pred givens depth]
  (let [[c ts] (zonk-pred pred)]
    (cond
      ;; round 54: a wanted quantified constraint (forall m'. Monad m' => Monad (t m')): its variables skolems, its context
      ;; given as the dictionary function's parameters, its head solved under them (GHC.Tc.Solver.Solve's solveForAll)
      (= :qc c)
      (let [[_ vs ctx h] (first ts)
            sk (into {} (map (fn [v] [v [:tv (str v "_sk" (fresh-id))]]) vs))
            preds (mapv (fn [[pc pts]] [pc (mapv #(subst sk %) pts)]) ctx)
            params (mapv dict-param preds)
            hd (subst sk h)
            term (when (and (= :tc (first hd)) (< depth 30))
                   ;; (a coercion's or an equality's head: erased, as a wanted Coercible's evidence; GHC.Internal.TypeNats'
                   ;; unsafeWithSNatCo's forall n. Coercible (SNat n) Natural)
                   (if (or (coercible-pred? [(second hd) (nth hd 2)]) (eq-pred? [(second hd) (nth hd 2)]))
                     (if (coercible-pred? [(second hd) (nth hd 2)]) (list 'co :coercible) (list 'co))
                   (solve-pred [(second hd) (nth hd 2)] (into (vec givens) (super-closure (mapv vector preds params))) (inc depth))))]
        ;; (eta-reduced when its head is a dictionary function applied to the parameters alone: Eq1 Complex's superclass
        ;; \d -> $fEqComplex d is $fEqComplex, as the -O0 Simplifier's eta reduction leaves GHC's evidence)
        (when term
          (cond (empty? params) term
                (and (seq? term) (= 'app (first term)) (= params (vec (nth term 2)))
                     (not-any? (set params) (tree-seq coll? seq (second term))))
                (second term)
                :else (list 'lam params term))))
      :else
    (if (= :cvar c)
      ;; a variable constraint known by now (cls := KnownNat n): its class's
      (let [t (first ts)]
        (if (= :tc (first t))
          (solve-pred [(second t) (nth t 2)] givens depth)
          ;; HF10-P48 (a): a variable constraint a given of its own gives (instance c => IdCt c's superclass c)
          (some (fn [[[gc gts] term]] (when (and (= :cvar gc) (= (zonk (first gts)) t)) term)) givens)))
    (if (eq-pred? [c ts])
      (do (unify (last (butlast ts)) (last ts)) (list 'co))
    (or (some (fn [[[gc gts] term]] (when (and (= gc c) (= (mapv zonk gts) ts)) term)) givens)
        ;; HF10-P54 (a): a given rewritten by the given equalities (tcrun039's Read b with b ~ [a] from MkG :: GADT [a]:
        ;; the wanted Read [a]; GHC's inert givens are rewritten by the given equalities, GHC.Tc.Solver.Rewrite)
        ;; and a given whose arguments reduce (T3500b's Show (Id (f (Mu f))), a family application: Show (f (Mu f)))
        (let [eqs? (and *given-eqs* (seq @*given-eqs*))
              rw (fn [t] (deep-expand (if eqs? (rewrite-by-givens t) (zonk t))))
              rts (delay (mapv rw ts))]
          (or (some (fn [[[gc gts] term]] (when (and (= gc c) (= (count gts) (count ts)) (= (mapv rw gts) @rts)) term)) givens)
              ;; HF10-P54 (a): a given type family of constraints reduced (tcrun043's Indexed a b with a ~ T: Show b), the
              ;; wanted one of its predicates: the given's evidence, a constraint tuple's component selected
              (some (fn [[[gc gts] term]]
                      (when (and (vector? gc) (some-> *families* deref (get gc)) (not (some-> *classes* deref (get gc))))
                        (let [t [:tc gc (mapv rw gts)] r (expand t)]
                          (when (not= r t)
                            (let [ps (ctx-preds r)]
                              (some (fn [[i [pc pts]]]
                                      (when (and (= pc c) (= (mapv rw pts) @rts))
                                        (if (= 1 (count ps))
                                          term
                                          (list 'app (list 'v (ext-name "var" "GHC.Internal.Classes" (str "$p" i "CTuple" (count ps)))) [term]))))
                                    (map-indexed vector ps)))))))
                    givens)))
        ;; HF10-P54 (a): a type family of constraints applied (ConstraintKinds' type family F x :: Constraint; T17104's F
        ;; Int = (?x :: String)) is its reduction's predicates, solved with the let ?x = e bindings in scope (the
        ;; innermost first); the evidence theirs (GHC's cast by the family's coercion, erased), a tuple's the constraint
        ;; tuple's constructor applied
        (when (and (vector? c) (some-> *families* deref (get c)) (not (some-> *classes* deref (get c))) (< depth 30))
          (let [t [:tc c ts] r (expand t)]
            (when (not= r t)
              (let [ipg (vec (for [[n it d] (reverse *ip-givens*)] [[cls-ip [[:lit n] it]] d]))
                    subs (mapv #(solve-pred % (into ipg givens) (inc depth)) (ctx-preds r))]
                (when (every? some? subs)
                  (case (count subs)
                    0 (list 'v (ext-name "var" "GHC.Internal.Classes" "CUnit"))
                    1 (first subs)
                    (list 'app (list 'v (ext-name "var" "GHC.Internal.Classes" (str "CTuple" (count subs)))) subs)))))))
        ;; round 54: a given quantified constraint whose head matches the wanted (GHC.Tc.Solver.Dict's matchLocalInst:
        ;; liftCallCC's forall m'. Monad m' => Monad (t m') for Monad (t m)): its dictionary function applied to its
        ;; context's dictionaries, solved at the match
        (when (< depth 30)
          (some (fn [[[gc gts] term]]
                  (when (= :qc gc)
                    (let [[_ vs ctx h] (zonk (first gts))]
                      (when (and (= :tc (first h)) (= c (second h)) (= (count (nth h 2)) (count ts)))
                        (when-let [m (reduce (fn [m [a b]] (match-ty* (set vs) m a b)) {} (map vector (nth h 2) ts))]
                          (when (every? #(contains? m %) vs)
                            (let [subs (mapv (fn [[pc pts]] (solve-pred [pc (mapv #(subst m %) pts)] givens (inc depth))) ctx)]
                              (when (every? some? subs)
                                (if (seq subs) (list 'app term subs) term)))))))))
                givens))
        ;; HF10-P44 (a): a functional dependency's improvement from a given (GHC.Tc.Solver.Dict's improvement by the
        ;; inert givens: reify's Reifies s a given, reflect p's Reifies s ?b wanted, ?b := a), then the given itself
        (when-let [fds (seq (some-> *classes* deref (get c) :fundeps))]
          (some (fn [[[gc gts] term]]
                  (when (and (= gc c) (= (count gts) (count ts)))
                    (let [gts (mapv zonk gts)]
                      (when (some (fn [[ls rs]] (and (seq ls) (every? #(and (<= 0 %) (= (nth gts % nil) (nth ts % nil))) ls)
                                                     (every? #(<= 0 % (dec (count ts))) rs)
                                                     (do (doseq [r rs] (soft-unify (nth ts r) (nth gts r))) true)))
                                  fds)
                        (when (= (mapv zonk gts) (mapv zonk ts)) term)))))
                givens))
        ;; an implicit parameter (GHC.Tc.Solver.Dict's IP: its name determines its type, as a functional
        ;; dependency): a given of the same name, HasCallStack being ?callStack :: CallStack
        ;; HF10-P21: HasExceptionContext too, ?exceptionContext :: ExceptionContext (SomeException's constructor gives it:
        ;; someExceptionContext (SomeException _) = ?exceptionContext read the default, the empty context)
        (when (or (= c cls-ip) (ip-synonym-name c))
          (let [syn (fn [x] (case (ip-synonym-name x)
                              "callStack" ["callStack" (con-ty tc-callstack)]
                              "exceptionContext" ["exceptionContext" (con-ty (ext-name "tc" "GHC.Internal.Exception.Context" "ExceptionContext"))]
                              nil))
                [pn pt] (if (= c cls-ip) [(second (first ts)) (second ts)] (syn c))]
            (some (fn [[[gc gts] term]]
                    (let [[gn gt] (cond (= gc cls-ip) [(second (zonk (first gts))) (second gts)]
                                        :else (syn gc))]
                      (when (and gn (= gn pn)) (unify pt gt) term)))
                  ;; (the module's existential patterns' givens, unscoped, for ?callStack alone, as before: a pattern's
                  ;; ?exceptionContext is given to its alternative by ip-pat-env)
                  (concat givens (when (= pn "callStack") (some-> *skolem-givens* deref))))))
        (some (fn [[[gc gts] term]] (when (and (= gc c) (= (mapv zonk gts) ts)) term)) (some-> *skolem-givens* deref))
        (when (and (= c cls-typeable) (seq ts))
          (or (typeable-term (last ts))
              ;; GHC.Tc.Instance.Class's doTyApp / doTyConApp on a type with variables: an application's evidence
              ;; mkTrAppChecked of its parts' (ds_ev_typeable's EvTypeableTyApp, as every Typeable application's evidence in
              ;; this file; mkTrApp before), a variable's from the givens
              (let [t (deep-expand (zonk (last ts)))
                    part (fn [x] (solve-pred [c [x]] givens (inc depth)))]
                (when (< depth 30)
                  (case (first t)
                    :app (let [f (part (nth t 1)) x (part (nth t 2))]
                           (when (and f x) (list 'app (list 'v (ext-name "var" "GHC.Internal.Data.Typeable.Internal" "mkTrAppChecked")) [f x])))
                    :tc (when (seq (nth t 2))
                          (if (and (= fun-tc (second t)) (= 2 (count (nth t 2))))
                            ;; HF10-P39 (a): doFunTy with variables
                            (let [a (part (first (nth t 2))) b (part (second (nth t 2)))]
                              (when (and a b) (typeable-fun many-typeable a b)))
                          (let [f (part [:tc (second t) (vec (butlast (nth t 2)))]) x (part (last (nth t 2)))]
                            (when (and f x) (list 'app (list 'v (ext-name "var" "GHC.Internal.Data.Typeable.Internal" "mkTrAppChecked")) [f x])))))
                    nil)))))
;; GHC.Tc.Instance.Class's matchDataToTag (HF9's second slice): DataToTag T for an algebraic data type T
        ;; (not a newtype), its dictionary the primop dataToTagSmall# (a family of fewer constructors than the pointer tag
        ;; can hold: 7 on a 64-bit target) or dataToTagLarge#
        (when (and (vector? c) (= "DataToTag" (nth c 3)) (= 1 (count ts)) (= :tc (first (first ts))))
          (when-let [ti (some-> *tycons* deref (get (second (first ts))))]
            (when (= 'data (:flavour ti))
              (list 'app (list 'v (ext-name "var" (nmod c) "C:DataToTag"))
                    [(list 'v (ext-name "var" "GHC.Internal.Prim" (if (<= (count (:cons ti)) 7) "dataToTagSmall#" "dataToTagLarge#")))]))))
        ;; GHC.Tc.Instance.Class's matchWithDict (HF9's second slice): WithDict cls meth, cls a class of one method and
        ;; no superclass, meth unified with the method's type at cls's arguments; the evidence withDict's, \sv k -> k sv
        ;; (the dictionary of such a class is its method: GHC's sv |> co, a newtype coercion, erased)
        (when (and (vector? c) (= "WithDict" (nth c 3)) (= 2 (count ts)))
          (let [ct (first ts) info (when (= :tc (first ct)) (get @*classes* (second ct)))]
            (when (and info (= 1 (count (:methods info))) (empty? (:supers info)))
              (let [mt (get @*genv* (first (:methods info)))]
                (when (= :forall (first mt))
                  (unify (second ts) (subst (zipmap (:tvs info) (nth ct 2)) (nth mt 3)))
                  (let [sv (fresh-lv "sv") k (fresh-lv "k")] (list 'lam [sv k] (list 'app k [sv]))))))))
        ;; GHC.Tc.Instance.Class's matchKnownNat, matchKnownSymbol, matchKnownChar: a literal's dictionary is the literal
        (when (and (vector? c) (= 1 (count ts)) (#{"KnownNat" "KnownSymbol" "KnownChar"} (nth c 3)))
          (known-lit-dict (nth c 3) (zonk (first ts))))
        ;; (a nullary class's instance too: MultiParamTypeClasses' class Trivial; instance Trivial, HF10-P43)
        ;; HF10-P50 (a): a skolem as the first argument too (T21973b's ClassLedger c by instance Eq c => ClassLedger c,
        ;; tcrun033's ClassA a String): only an instance whose head is a variable there matches it, after the givens
        ;; HF10-P54 (a): a meta as the first argument too, when an instance's head is a variable there (testeq2's
        ;; TypeCast ?b HTrue by instance TypeCast' () a b => TypeCast a b): committed when it is the only match and no
        ;; other instance unifies (inst-candidates, GHC.Core.InstEnv's lookupInstEnv)
        (when (and (< depth 30) (or (and (empty? ts) (some-> *classes* deref (get c)))
                                    (and (seq ts) (not= :mv (first (first ts))))
                                    (and (seq ts) (var-head-class? c))))
          (let [inst-term (fn []
                            ;; HF10-P54 (a): a class with functional dependencies improves the wanted from the instances
                            ;; first (GHC.Tc.Solver.Dict's improvement: Container (Cont Integer) ?b by Container (Cont a) a)
                            (when (seq (some-> *classes* deref (get c) :fundeps)) (improve-one! [c ts]))
                            (let [ts (second (zonk-pred [c ts]))]
                              (when-let [[{:keys [dfun tvs ctx]} m] (inst-candidate c ts)]
                                ;; an instance's variables its head does not bind (its context's, a functional
                                ;; dependency determines them: T5759's b of Container a b) fresh metas, its context
                                ;; solved together, each improved by the others' solutions (solve-ctx)
                                (let [m (into (into {} (map (fn [v] [v (fresh-meta)]) tvs)) m)
                                      subs (solve-ctx (mapv (fn [[pc pts]] [pc (mapv #(subst m %) pts)]) ctx) givens (inc depth))]
                                  (when subs
                                    (if (empty? ctx) (list 'v dfun) (list 'app (list 'v dfun) (vec subs))))))))
                key [c ts]]
            ;; HF10-P50 (a): recursive dictionaries (T3731-short's Data Expression needing Data [Expression] needing Data
            ;; Expression): a predicate met again while its instance is being solved is the dictionary being made, bound by
            ;; a letrec around it (GHC.Tc.Solver's solved dictionaries, Note [Recursive instances and superclasses])
            (if-let [cell (get *solving* key)]
              (or @cell (reset! cell (fresh-lv (str "$d" (occ c)))))
              (if (some #(and (vector? %) (= :mv (first %))) (tree-seq coll? seq ts))
                (inst-term)
                (let [cell (atom nil)
                      r (binding [*solving* (assoc *solving* key cell)] (inst-term))]
                  (if (and r @cell) (list 'letrec [(list 'bind @cell r)] @cell) r))))))))))))

;;; ------------------------------------------------------------------------------------------
;;; Converting written types (the renamed tree's HsType)

;; ScopedTypeVariables (HF9): a signature's type variables scope over its binding's body (GHC.Tc.Gen.Bind's
;; tcPolyCheck brings the skolems into scope; an instance's head variables over its methods, tcInstDecl2): the
;; renamer gave an inner occurrence the outer binder's Name, so the key of a type variable is its Name's
;; (occurrence and binding position), as sig-type names them
(def ^:dynamic *scoped-tvs* {}) ; {"a_L_C_L_C" type}
;; a pattern signature's free type variables are bound by the pattern (GHC.Tc.Gen.Pat's tcPatSig: fresh metas, in scope
;; for the rest of the match): per clause
(def ^:dynamic *pat-tvs* nil)   ; atom {"a_L_C_L_C" type}
(defn- tv-key [n] (str (occ n) "_" (apply str (interpose "_" (drop 3 n)))))

(declare cls-callstack)

(defn- qc-head
  "round 54: a quantified constraint's head [CLASS args] (a polytype [:forall vs ctx [:tc CLASS args]]), or nil"
  [t]
  (when (= :forall (first t))
    (let [h (nth t 3)]
      (when (and (= :tc (first h)) (vector? (second h))) [(second h) (nth h 2)]))))

(defn- ctx-preds
  "HF10-P43 (a): a context's constraint as predicates: a class's application one, a variable's [:cvar [t]], a constraint
  synonym (ConstraintKinds' type C2 = (?x :: Int, ?y :: Int)) expanded and a constraint tuple's components each (the
  empty one none: () :: Constraint); HasCallStack and HasExceptionContext kept as they are (the solver knows them)"
  [p]
  (letfn [(go [p d]
            (case (first p)
              :tc (let [[_ c ts] p]
                    (cond
                      (and (< d 8) (vector? c) (= "GHC.Internal.Tuple" (nmod c))
                           (or (re-matches #"Tuple[0-9]+|Unit|Solo" (occ c)) (re-matches #"CTuple[0-9]+|CUnit|CSolo" (occ c))))
                      (mapcat #(go % (inc d)) ts)
                      (and (< d 8) (some-> *syns* deref (get c)) (not= c cls-callstack) (not (ip-synonym-name c))
                           (not= p (expand p)))
                      (go (expand p) (inc d))
                      :else [[c ts]]))
              (:tv :app) [[:cvar [p]]]
              ;; round 54: QuantifiedConstraints' forall m'. Monad m' => Monad (t m') is the predicate [:qc [polytype]]
              ;; (GHC's ForAllPred), given as a dictionary function, solved by matching its head (GHC.Tc.Solver.Dict's
              ;; matchLocalInst)
              :forall (if (qc-head p) [[:qc [p]]] [])
              []))]
    (go p 0)))

(defn hs-type
  "An HsType of the renamed tree as a type; tvs maps a type variable's Name to its type"
  [tvs t]
  (let [v (lval t)]
    (case (con v)
      HsTyVar (let [n (nm (arg v 3))]
                (cond (= "tv" (nth n 1)) (or (get tvs n) (get *scoped-tvs* (tv-key n)) (some-> *pat-tvs* deref (get (tv-key n)))
                                             [:tv (occ n)])
                      ;; (->) as a type constructor: FUN at the many multiplicity (GHC.Internal.Types' type (->) =
                      ;; FUN 'Many), the function type's constructor
                      (and (= "GHC.Internal.Types" (nmod n)) (= "->" (occ n))) [:tc fun-tc []]
                      :else (poly-syn [:tc n []])))
      HsAppTy (poly-syn (mk-app (hs-type tvs (arg v 2)) (hs-type tvs (arg v 3))))
      HsFunTy (fn-ty (hs-type tvs (arg v 3)) (hs-type tvs (arg v 4)))
      HsListTy (list-ty (hs-type tvs (arg v 2)))
      HsTupleTy (let [ts (mapv #(hs-type tvs %) (arg v 3))]
                  [:tc (if (= 'HsUnboxedTuple (arg v 2)) (utuple-tc (count ts)) (tuple-tc (count ts))) ts])
      ;; UnboxedSums: (# a | b #), its representation arguments left out as the tuples'
      HsSumTy (let [ts (mapv #(hs-type tvs %) (arg v 2))] [:tc (usum-tc (count ts)) ts])
      ;; a documented type, a kind signature, a kind application: the type alone (kinds are trusted, HF9's first slice)
      HsDocTy (hs-type tvs (arg v 2))
      ;; ImplicitParams: ?x :: t is the constraint IP "x" t (GHC.Classes' IP, GHC.Tc.Gen.HsType's HsIParamTy)
      HsIParamTy [:tc cls-ip [[:lit (second (lval (arg v 2)))] (hs-type tvs (arg v 3))]]
      ;; a partial signature's wildcard (PartialTypeSignatures): inferred
      HsWildCardTy (fresh-meta)
      HsKindSig (hs-type tvs (arg v 2))
      HsAppKindTy (hs-type tvs (arg v 2))
      ;; type-level literals, as the interfaces write them (tools/hsdump: (lit N), (lit "s"), (lit-char C))
      ;; DataKinds' promoted list '[t1, t2]: (':) t1 ((':) t2 '[]), the kind arguments erased as an interface's are
      HsExplicitListTy (reduce (fn [acc x] [:tc (ext-name "data" "GHC.Internal.Types" ":") [(hs-type tvs x) acc]])
                               [:tc (ext-name "data" "GHC.Internal.Types" "[]") []]
                               (reverse (arg v 3)))
      ;; HF10-P42 (a): DataKinds' promoted tuple '(t1, t2): the tuple's promoted data constructor applied, its kind
      ;; arguments erased as the list's
      HsExplicitTupleTy [:tc (ext-name "data" "GHC.Internal.Tuple" (occ (tuple-con (count (arg v 3))))) (mapv #(hs-type tvs %) (arg v 3))]
      ;; HF10-P42 (a): StarIsType's * (and its Unicode ★) is Data.Kind's Type (GHC.Tc.Gen.HsType's HsStarTy: liftedTypeKind)
      HsStarTy [:tc (ext-name "tc" "GHC.Internal.Types" "Type") []]
      HsTyLit (let [l (arg v 2)]
                (case (con l) HsNumTy [:lit (nth l 2)] HsStrTy [:lit (nth l 2)] HsCharTy [:lit-char (int (nth l 2))]
                      (do (error! "type literal not handled: " (con l)) (fresh-meta))))
      HsParTy (hs-type tvs (arg v 2))
      HsBangTy (hs-type tvs (arg v 3))
      HsOpTy (let [op (nm (arg v 4))]
               (if (= "tv" (nth op 1))
                 ;; HF10-P54 (a): a type variable used infix (tcrun034's a `m` b): its application, as HsTyVar's
                 (let [f (or (get tvs op) (get *scoped-tvs* (tv-key op)) (some-> *pat-tvs* deref (get (tv-key op))) [:tv (occ op)])]
                   (mk-app (mk-app f (hs-type tvs (arg v 3))) (hs-type tvs (arg v 5))))
                 (poly-syn [:tc op [(hs-type tvs (arg v 3)) (hs-type tvs (arg v 5))]])))
      HsQualTy (let [ctx (lval (arg v 2)) body (hs-type tvs (arg v 3))]
                 [:forall [] (vec (mapcat (fn [c] (ctx-preds (hs-type tvs c))) ctx)) body])
      ;; RankNTypes: an inner forall a quantified type of its own (runST's (forall s. ST s a)); the elaborator
      ;; instantiates it where it is used (trusted: no skolem escape check), its binders' kinds trusted
      HsForAllTy (let [bs (let [tele (arg v 2)] (when (seq? tele) (arg tele 2)))
                       ns (vec (keep (fn [b] (let [bv (lval b) bb (arg bv 3)] (when (= 'HsBndrVar (con bb)) (nm (arg bb 2))))) bs))
                       names (mapv tv-key ns)
                       body (hs-type (merge tvs (zipmap ns (map (fn [x] [:tv x]) names))) (arg v 3))]
                   (cond (empty? names) body
                         (= :forall (first body)) [:forall (into names (nth body 1)) (nth body 2) (nth body 3)]
                         :else [:forall names [] body]))
      (do (error! "type not handled: " (con v)) (fresh-meta)))))

(defn- tv-names-of [t]
  (let [out (atom [])]
    (letfn [(w [x] (cond (and (L? x) (seq? (lval x)) (= 'rn/name (first (lval x))) (= "tv" (nth (second (lval x)) 1)))
                         (let [n (second (lval x))] (when-not (some #{n} @out) (swap! out conj n)))
                         (coll? x) (doseq [y x] (w y))
                         :else nil))]
      (w t))
    @out))

(defn- sig-tv-kinds
  "HF10-P20: a signature's kinded binders whose kind fixes a representation, (a :: TYPE 'AddrRep): {TV-KEY kind-type}"
  [sig]
  (into {} (for [x (tree-seq coll? seq sig)
                 :when (and (seq? x) (= 'HsTvb (first x)))
                 :let [bb (arg x 3) kb (arg x 4)]
                 :when (and (seq? bb) (= 'HsBndrVar (con bb)) (seq? kb) (= 'HsBndrKind (con kb)))
                 :let [k (try (hs-type {} (arg kb 2)) (catch Throwable _ nil))]
                 :when (rep-kind? k)]
             [(tv-key (nm (arg bb 2))) k])))

(defn sig-type
  "A signature (HsSig ext outer body) as a closed type: [:forall [tv...] [pred...] body]"
  [sig]
  (let [s (lval sig) body (arg s 3)
        ;; the variables of an enclosing signature in scope are not quantified again (ScopedTypeVariables), nor those an
        ;; inner forall binds (its own quantifier, hs-type's HsForAllTy)
        inner (set (for [x (tree-seq coll? seq body)
                         :when (and (seq? x) (= 'HsForAllTy (first x)))
                         b (let [tele (arg x 2)] (when (seq? tele) (arg tele 2)))
                         :let [bb (arg (lval b) 3)] :when (= 'HsBndrVar (con bb))]
                     (nm (arg bb 2))))
        ;; HF10-P41 (a): an explicit forall's binders in their written order first (forall k (a :: k). Typeable a =>
        ;; SomeKindedTypeRep k: k, then a, as a type application instantiates them; their first occurrences gave a, k)
        outer (lval (arg s 2))
        explicit (when (and (seq? outer) (= 'HsOuterExplicit (con outer)))
                   (vec (keep (fn [b] (let [bb (arg (lval b) 3)] (when (and (seq? bb) (= 'HsBndrVar (con bb))) (nm (arg bb 2)))))
                              (arg outer 2))))
        ns (remove #(or (contains? *scoped-tvs* (tv-key %)) (some-> *pat-tvs* deref (contains? (tv-key %))) (contains? inner %))
                   (distinct (concat explicit (tv-names-of body))))
        names (mapv tv-key ns)
        tvs (zipmap ns (map (fn [x] [:tv x]) names))
        t (hs-type tvs body)]
    ;; a body that is itself quantified (errorWithoutStackTrace's `forall (r :: RuntimeRep). forall (a :: TYPE r).`,
    ;; or a context's [:forall [] ctx t]) is one quantifier with the outer's, its variables after them
    (if (= :forall (first t))
      [:forall (into names (nth t 1)) (nth t 2) (nth t 3)]
      [:forall names [] t])))

;;; ------------------------------------------------------------------------------------------
;;; Core

(defn- lv [n] (list 'lv (occ n) (str/join ":" (map str (drop 3 n)))))
(def ^:dynamic *abs-binds* (not= "0" (System/getenv "REPR_HASKELL_SIMPL"))) ; dsAbsBinds' letrec for one unsigned binder
(def ^:dynamic *ltypes* nil)   ; atom {(lv ...) type}: the local binders' types, zonked into :ltypes (tostg's PrimReps)
(defn- note-type! [x t] (when *ltypes* (swap! *ltypes* assoc x t)))

(defn- force-strict-binds
  "A let's banged bindings (*strict-binds*' [pn pattern]...) forced around its body c, innermost last (dsStrictBind's
  seq). A banged variable of an unlifted type is not forced: GHC's ds_val_bind takes an unlifted binding to
  dsUnliftedBind (a case at the binding, or an ok-for-speculation let) with no seq, so the bindings are evaluated in
  the groups' order (bigNatTestBit#'s `!sz = wordArraySize# a` after `!nw`, as GHC's -O0 STG has it; gate B1: BigNat's
  bindings equal 81 -> 80 since HF10-P32 noted the local binders' types, the extra forces putting sz first)"
  [c sb]
  (let [sb (remove (fn [[pn pc]] (and (= pc '(pbang (pwild))) (some-> *ltypes* deref (get (lv pn)) unlifted-ty?))) sb)]
    (reduce (fn [c [pn pc]] (list 'match [(lv pn)] [(list 'clause [pc] c)])) c (reverse sb))))
(defn- strict-rhs
  "Queue 369: a right-hand side's where bindings forced around it (*strict-binds*' [pn pattern]..., the unlifted banged
  variables left as force-strict-binds leaves them): (strict-rhs [[x pattern]...] c), c itself when none is left"
  [c sb]
  (let [sb (remove (fn [[pn pc]] (and (= pc '(pbang (pwild))) (some-> *ltypes* deref (get (lv pn)) unlifted-ty?))) sb)]
    (if (empty? sb) c (list 'strict-rhs (mapv (fn [[pn pc]] [(lv pn) pc]) sb) c))))
(def ^:dynamic *uniq* nil)
(defn- fresh-lv [o] (list 'lv o (str "u" (fresh-id))))

(defn- app* [f args]
  (cond (empty? args) f
        (and (seq? f) (= 'app (first f))) (list 'app (second f) (into (nth f 2) args))
        :else (list 'app f (vec args))))

;;; ------------------------------------------------------------------------------------------
;;; Foreign imports (HF10-P5 (a)): GHC 9.14.1's GHC.HsToCore.Foreign.Decl (dsFImport, dsCImport, dsFCall, dsPrimCall,
;;; dsFLabel) and GHC.HsToCore.Foreign.Call (unboxArg, boxResult, resultWrapper, mk_alt), ported rule for rule into the
;;; elaborator's Core (BSD-3, The University of Glasgow; LICENSE.md). The call itself is a global of kind "ffi" (GHC's
;;; FCallId, mkFCall), its spec in *fcalls*, its type the worker's (the unboxed arguments, the State# token, the unboxed
;;; result tuple); tostg makes it StgOpApp's (ffi ...) or (primcall ...). The worker ($wccall) is not bound apart: its body is
;;; the call, which GHC's -O0 Simplifier inlines into the wrapper, the wrapper an INLINE unfolding of its arity
;;; (mkInlineUnfoldingWithArity) the Simplifier inlines at its call sites

(declare ^:dynamic *module*)
(def ^:dynamic *fcalls* nil) ; atom {FFI-NAME {:conv :ccall :safety :unsafe :target "sym" :unit U}}

(def ^:private io-tc (ext-name "tc" "GHC.Internal.Types" "IO"))
(def ^:private state-tc (ext-name "tc" "GHC.Internal.Prim" "State#"))
(def ^:private rw-tc (ext-name "tc" "GHC.Internal.Prim" "RealWorld"))
(def ^:private state-rw [:tc state-tc [[:tc rw-tc []]]])

(defn- ffi-prim-type?
  "isPrimitiveType: an unlifted primitive type constructor's application (GHC.Internal.Prim's), not an unboxed tuple"
  [t]
  (and (= :tc (first t)) (= "GHC.Internal.Prim" (nmod (second t)))))

(defn- ffi-con-field
  "The single data constructor of a product tycon with one field (tyConSingleAlgDataCon_maybe, dataConInstOrigArgTys):
  [CON FIELD-TYPE], or nil; a newtype's: its representation (instNewTyCon_maybe)"
  [t flavour]
  (when (= :tc (first t))
    (let [i (get @*tycons* (second t))]
      (when (and (= flavour (:flavour i)) (= 1 (count (:cons i))))
        (let [c (first (:cons i)) ct (get @*genv* c)
              [tvs body] (if (and (vector? ct) (= :forall (first ct))) [(nth ct 1) (nth ct 3)] [[] ct])]
          (when (and (vector? body) (= :tc (first body)) (= fun-tc (second body))
                     (let [r (second (nth body 2))] (not (and (vector? r) (= :tc (first r)) (= fun-tc (second r))))))
            [c (deep-expand (subst (zipmap tvs (nth t 2)) (first (nth body 2))))]))))))

(defn- ffi-lv [o t] (let [x (fresh-lv o)] (note-type! x t) x))

(defn- ffi-unbox-arg
  "unboxArg: [the argument's unboxed atom, a function wrapping the body in its unboxing], or nil (an argument type the
  foreign call cannot take)"
  [x t]
  (let [t (deep-expand t)]
    (cond
      (ffi-prim-type? t) [x identity]
      ;; (queue 422: unboxArg's "Same for (# #)": an unboxed tuple whose representation is void, passed as it is (T24818's
      ;; c_number :: (# #) -> Int64#); it was refused and the import left the placeholder, the literal 0)
      (and (= :tc (first t)) (= (utuple-tc 0) (second t))) [x identity]
      ;; topNormaliseNewType_maybe: through the newtype (a match of its constructor, the cast the simple optimiser makes)
      (ffi-con-field t 'newtype)
      (let [[c rt] (ffi-con-field t 'newtype) y (ffi-lv "ds" rt)
            [v w] (or (ffi-unbox-arg y rt) [nil nil])]
        (when v [v (fn [body] (list 'case x (ffi-lv "ds" t) [(list 'alt c [y] (w body))]))]))
      (= tc-bool (second t))
      (let [p (ffi-lv "ds" [:tc (ext-name "tc" "GHC.Internal.Prim" "Int#") []])]
        [p (fn [body] (list 'case (list 'case x (ffi-lv "ds" t)
                                       [(list 'alt (ext-name "data" "GHC.Internal.Types" "False") [] (list 'lit "0#"))
                                        (list 'alt (ext-name "data" "GHC.Internal.Types" "True") [] (list 'lit "1#"))])
                            p [(list 'alt :default [] body)]))])
      (ffi-con-field t 'data)
      (let [[c ft] (ffi-con-field t 'data)]
        (when (ffi-prim-type? ft)
          (let [p (ffi-lv "ds" ft)]
            [p (fn [body] (list 'case x (ffi-lv "ds" t) [(list 'alt c [p] body)]))])))
      :else nil)))

(defn- ffi-result-wrapper
  "resultWrapper: [the call's unboxed result type or nil (()), a function boxing the result], or nil"
  [t]
  (let [t (deep-expand t)]
    (cond
      (and (= :tc (first t)) (= (tuple-tc 0) (second t))) [nil (fn [_] (list 'v (tuple-con 0)))]
      (ffi-prim-type? t) [t identity]
      (= tc-bool (second t))
      [[:tc (ext-name "tc" "GHC.Internal.Prim" "Int#") []]
       (fn [e] (list 'case e (ffi-lv "ds" [:tc (ext-name "tc" "GHC.Internal.Prim" "Int#") []])
                     [(list 'alt :default [] (list 'v (ext-name "var" "GHC.Internal.Types" "True")))
                      (list 'alt (list 'lit "0#") [] (list 'v (ext-name "var" "GHC.Internal.Types" "False")))]))]
      (ffi-con-field t 'newtype)
      (let [[c rt] (ffi-con-field t 'newtype)]
        (when-let [[pt w] (ffi-result-wrapper rt)]
          [pt (fn [e] (list 'app (list 'v (assoc c 1 "var")) [(w e)]))]))
      (ffi-con-field t 'data)
      (let [[c ft] (ffi-con-field t 'data)]
        (when-let [[pt w] (ffi-result-wrapper ft)]
          [pt (fn [e] (list 'app (list 'v (assoc c 1 "var")) [(w e)]))]))
      :else nil)))

(defn- ffi-split
  "The type's quantified variables dropped, its argument types and result (tcSplitForAllTyVarBinders, tcSplitFunTys)"
  [t]
  (loop [t (deep-expand (if (= :forall (first t)) (nth t 3) t)) args []]
    (let [t (deep-expand (if (= :forall (first t)) (nth t 3) t))]
      (if (and (= :tc (first t)) (= fun-tc (second t)))
        (recur (second (nth t 2)) (conj args (first (nth t 2))))
        [args t]))))

(defn- ffi-spec
  "The CImport's calling convention, safety and target: {:conv :safety :target|:label|:dynamic|:wrapper}"
  [ci]
  (let [conv (lval (arg ci 2)) safety (lval (arg ci 3)) sp (arg ci 5)
        conv ({'CCallConv :ccall 'CApiConv :capi 'StdCallConv :stdcall 'PrimCallConv :prim 'JavaScriptCallConv :javascript} conv)
        safety ({'PlayRisky :unsafe 'PlaySafe :safe 'PlayInterruptible :interruptible} safety :safe)]
    (merge {:conv conv :safety safety}
           ;; (CWrapper is a bare symbol, the others nodes)
           (case (if (symbol? sp) sp (con sp))
             CFunction (let [tg (arg sp 1)]
                         (if (= 'StaticTarget (con tg)) {:target (arg tg 2) :fun (not (false? (arg tg 4)))} {:dynamic true}))
             CLabel {:label (arg sp 1)}
             CWrapper {:wrapper true}
             {:unknown true}))))

(def ^:private zenc-chars
  {\( "ZL" \) "ZR" \[ "ZM" \] "ZN" \: "ZC" \Z "ZZ" \z "zz" \& "za" \| "zb" \^ "zc" \$ "zd" \= "ze" \> "zg" \# "zh"
   \. "zi" \< "zl" \- "zm" \! "zn" \+ "zp" \' "zq" \\ "zr" \/ "zs" \* "zt" \_ "zu" \% "zv"})

(defn- zenc
  "GHC.Utils.Encoding's zEncodeString (but its tuples' names): an ASCII letter or digit as it is (a leading digit
  encoded), the table's characters, any other as z, its hexadecimal code (with a leading 0 when it starts with a
  letter) and U (queue 364: the whole table, $ among them, for the stubs' names)"
  [^String s]
  (let [uni (fn [ch] (let [h (Integer/toHexString (int ch))] (str "z" (if (Character/isDigit (.charAt h 0)) h (str "0" h)) "U")))]
    (apply str (map-indexed (fn [i ch]
                              (cond (and (zero? i) (<= (int \0) (int ch) (int \9))) (uni ch)
                                    (or (<= (int \a) (int ch) (int \z)) (<= (int \A) (int ch) (int \Z)) (<= (int \0) (int ch) (int \9)))
                                    (if-let [e (zenc-chars ch)] e (str ch))
                                    :else (or (zenc-chars ch) (uni ch))))
                            s))))

;; queue 364 (report 346's item 5): the module's wrapper counter, GHC's tcg_next_wrapper_num (mkWrapperName's): the
;; foreign exports' stable names take its first numbers (the typechecker's, in source order), then the capi imports' C
;; wrappers (the desugarer's, in dsForeigns' order: the imports last to first)
(def ^:dynamic *wrapper-num* nil) ; atom n

(defn- next-wrapper-num []
  (if *wrapper-num* (let [n @*wrapper-num*] (swap! *wrapper-num* inc) n)
      (count (filter #(= :capi (:conv %)) (vals @*fcalls*)))))

(defn- capi-target
  "dsFCall's CApiConv: the call goes through the C wrapper GHC writes, named by mkWrapperName \"ghc_wrapper\" (the
  module's wrapper counter, the unit, the module, the C name), z-encoded"
  [sym]
  (zenc (str "ghc_wrapper:" (next-wrapper-num) ":" *unit* ":" *module* ":" sym)))

;;; ------------------------------------------------------------------------------------------
;;; The foreign stubs (queue 364, report 346's item 5): the C GHC 9.14.1 writes for a module's foreign declarations,
;;; ported from GHC.HsToCore.Foreign.C (dsCFExport, dsCFExportDynamic, dsFCall's CApiConv, toCType, mkFExportCBits,
;;; insertRetAddr), GHC.HsToCore.Foreign.Decl (dsForeigns', foreignExportsInitialiser), GHC.HsToCore.Foreign.Utils
;;; (getPrimTyOf, primTyDescChar, ppPrimTyConStgType) and GHC.Types.ForeignStubs (initializerCStub) (BSD-3, The
;;; University of Glasgow; LICENSE.md), each declaration's header and C as lines (an SDoc's $$, the empty doc none), for the
;;; reference's platform: x86-64 Linux, whose wrapper stubs use no libffi and take the adjustor's return address after
;;; their sixth integer argument (hsi's createAdjustor reads that parameter, NODES.adjust). Written as GHC's C compiler
;;; gets them (tools/hsdump/probe/StubProbe.hs --stubs, the records' haskell-stg-progs ID/stubs/): BASE_stub.h and
;;; BASE_stub.c, arbace.repr.haskell.front

(def ^:dynamic *fstubs* nil) ; atom [{:h [LINE...] :c [LINE...]}...]: the module's foreign declarations' stubs, dsForeigns' order

(def ^:private ptr-tc (ext-name "tc" "GHC.Internal.Ptr" "Ptr"))
(def ^:private funptr-tc (ext-name "tc" "GHC.Internal.Ptr" "FunPtr"))

(def ^:private ffi-ctypes
  ;; the boot libraries' CTYPE pragmas, by type constructor (no interface carries them: read from ghc-internal 9.14.1's
  ;; GHC/Internal/{Types,Int,Word,Stable}.hs, Foreign/C/Types.hs's and System/Posix/Types.hs's CTypes.h macros and
  ;; System/Posix/Internals.hs; a newtype's matters under a Ptr, which normaliseFfiType does not look into)
  (merge
   (into {} (for [[m ts] {"GHC.Internal.Types" [["Char" "HsChar"] ["Int" "HsInt"] ["Word" "HsWord"] ["Float" "HsFloat"]
                                                ["Double" "HsDouble"] ["Bool" "HsBool"]]
                          "GHC.Internal.Int" [["Int8" "HsInt8"] ["Int16" "HsInt16"] ["Int32" "HsInt32"] ["Int64" "HsInt64"]]
                          "GHC.Internal.Word" [["Word8" "HsWord8"] ["Word16" "HsWord16"] ["Word32" "HsWord32"] ["Word64" "HsWord64"]]
                          "GHC.Internal.Stable" [["StablePtr" "HsStablePtr"]]}
                  [o c] ts]
              [(ext-name "tc" m o) c]))
   (into {} (for [[o c] (partition 2 ["CChar" "char" "CSChar" "signed char" "CUChar" "unsigned char" "CShort" "short"
                                      "CUShort" "unsigned short" "CInt" "int" "CUInt" "unsigned int" "CLong" "long"
                                      "CULong" "unsigned long" "CLLong" "long long" "CULLong" "unsigned long long"
                                      "CBool" "bool" "CFloat" "float" "CDouble" "double" "CPtrdiff" "ptrdiff_t"
                                      "CSize" "size_t" "CWchar" "wchar_t" "CSigAtomic" "sig_atomic_t" "CClock" "clock_t"
                                      "CTime" "time_t" "CUSeconds" "useconds_t" "CSUSeconds" "suseconds_t"
                                      "CIntPtr" "intptr_t" "CUIntPtr" "uintptr_t" "CIntMax" "intmax_t" "CUIntMax" "uintmax_t"])]
              [(ext-name "tc" "GHC.Internal.Foreign.C.Types" o) c]))
   (into {} (for [[o c] (partition 2 ["CDev" "dev_t" "CIno" "ino_t" "CMode" "mode_t" "COff" "off_t" "CPid" "pid_t"
                                      "CSsize" "ssize_t" "CGid" "gid_t" "CNlink" "nlink_t" "CUid" "uid_t" "CCc" "cc_t"
                                      "CSpeed" "speed_t" "CTcflag" "tcflag_t" "CRLim" "rlim_t" "CBlkSize" "blksize_t"
                                      "CBlkCnt" "blkcnt_t" "CClockId" "clockid_t" "CFsBlkCnt" "fsblkcnt_t"
                                      "CFsFilCnt" "fsfilcnt_t" "CId" "id_t" "CKey" "key_t" "CTimer" "timer_t"
                                      "CSocklen" "socklen_t" "CNfds" "nfds_t" "Fd" "int"])]
              [(ext-name "tc" "GHC.Internal.System.Posix.Types" o) c]))
   (into {} (for [o ["flock" "group" "lconv" "passwd" "sigaction" "stat" "termios" "tm" "tms" "utimbuf" "utsname"]]
              [(ext-name "tc" "GHC.Internal.System.Posix.Internals" (str "C" (str/upper-case (subs o 0 1)) (subs o 1)))
               (str "struct " o)]))
   {(ext-name "tc" "GHC.Internal.System.Posix.Internals" "CFLock") "struct flock"
    (ext-name "tc" "GHC.Internal.System.Posix.Internals" "CSigset") "sigset_t"}))

(defn- prim-stg-type
  "ppPrimTyConStgType: the C type of an unlifted FFI type's constructor (UnliftedFFITypes), or nil"
  [tc]
  (when (= "GHC.Internal.Prim" (nmod tc))
    ({"Char#" "StgChar" "Int#" "StgInt" "Int8#" "StgInt8" "Int16#" "StgInt16" "Int32#" "StgInt32" "Int64#" "StgInt64"
      "Word#" "StgWord" "Word8#" "StgWord8" "Word16#" "StgWord16" "Word32#" "StgWord32" "Word64#" "StgWord64"
      "Float#" "StgFloat" "Double#" "StgDouble" "Addr#" "StgAddr" "StablePtr#" "StgStablePtr" "Array#" "const StgAddr"
      "MutableArray#" "StgAddr" "ByteArray#" "const StgAddr" "MutableByteArray#" "StgAddr" "SmallArray#" "const StgAddr"
      "SmallMutableArray#" "StgAddr"} (occ tc))))

(defn- ffi-normalise
  "normaliseFfiType: synonyms expanded, a newtype unwrapped (its constructor taken as in scope), IO's, FunPtr's and the
  arrows' arguments normalised, any other type left as it is"
  [t]
  (let [t (deep-expand t)]
    (cond
      (= :forall (first t)) (assoc t 3 (ffi-normalise (nth t 3)))
      (not= :tc (first t)) t
      (contains? #{io-tc funptr-tc fun-tc} (second t)) [:tc (second t) (mapv ffi-normalise (nth t 2))]
      (ffi-con-field t 'newtype) (ffi-normalise (second (ffi-con-field t 'newtype)))
      :else t)))

(defn- unit-ty? [t] (let [t (deep-expand t)] (and (= :tc (first t)) (= (tuple-tc 0) (second t)))))

(defn- c-type
  "toCType: [HEADER C-TYPE] of a capi call's argument or result (Ptr t and FunPtr t: t's, void when it has none, and *)"
  ([t] (c-type t false))
  ([t void-ok]
   (let [t (deep-expand t)]
     (cond
       (and (= :tc (first t)) (contains? #{ptr-tc funptr-tc} (second t)) (= 1 (count (nth t 2))))
       (let [[h c] (c-type (first (nth t 2)) true)] [h (str c "*")])
       (and (= :tc (first t)) (get ffi-ctypes (second t))) [nil (get ffi-ctypes (second t))]
       (and (= :tc (first t)) (prim-stg-type (second t))) [nil (prim-stg-type (second t))]
       void-ok [nil "void"]
       :else (throw (ex-info (str "toCType: " (pr-str t)) {}))))))

(defn- ffi-prim-of
  "getPrimTyOf: the primitive type constructor's occurrence of an exported function's argument or result (Int#: Bool's)"
  [t]
  (let [t (deep-expand t)]
    (cond
      (= tc-bool (second t)) "Int#"
      (ffi-prim-type? t) (occ (second t))
      (ffi-con-field t 'newtype) (ffi-prim-of (second (ffi-con-field t 'newtype)))
      (ffi-con-field t 'data) (ffi-prim-of (second (ffi-con-field t 'data)))
      :else (throw (ex-info (str "getPrimTyOf: " (pr-str t)) {})))))

(defn- ffi-desc-char
  "primTyDescChar (a 64-bit word): the argument's letter in the type string createAdjustor gets"
  [t]
  (if (unit-ty? t)
    \v
    (or ({"Int#" \L "Word#" \l "Char#" \l "Int8#" \B "Word8#" \b "Int16#" \S "Word16#" \s "Int32#" \W "Word32#" \w
          "Int64#" \L "Word64#" \l "Addr#" \p "StablePtr#" \p "Float#" \f "Double#" \d} (ffi-prim-of t))
        (throw (ex-info (str "primTyDescChar: " (pr-str t)) {})))))

(defn- ffi-stg-type
  "showFFIType of a type: its type constructor's occurrence after the newtypes unwrapped (unwrapType): HsInt's Int"
  [t]
  (let [t (deep-expand t)]
    (if-let [[_ ft] (and (= :tc (first t)) (ffi-con-field t 'newtype))]
      (ffi-stg-type ft)
      (if (= :tc (first t)) (occ (second t)) (throw (ex-info (str "typeTyCon: " (pr-str t)) {}))))))

(defn- fexport-cbits
  "mkFExportCBits (the CCallConv's, no libffi): {:h [LINE] :c [LINE] :ts TYPE-STRING} of the C function c-nm calling the
  exported closure target (its label's name), or, target nil, a wrapper's stub calling the closure its stable pointer
  names; arg-tys and res-ty the Haskell types (an IO result's io? true: runIO, else runNonIO)"
  [c-nm target arg-tys res-ty io?]
  (let [args (vec (map-indexed (fn [i t] {:n (str "a" (inc i)) :ty (str "Hs" (ffi-stg-type t)) :t t
                                          :float (contains? #{"Float#" "Double#"} (ffi-prim-of t))})
                               arg-tys))
        ts (apply str (map #(ffi-desc-char (:t %)) args))
        ;; insertRetAddr (x86-64, not Windows): the return address's slot after the sixth integer argument
        ret-addr (fn [as] (loop [n 0 as as acc []]
                            (cond (= n 6) (into (conj acc {:n "original_return_addr" :ty "void*"}) as)
                                  (empty? as) acc
                                  (:float (first as)) (recur n (rest as) (conj acc (first as)))
                                  :else (recur (inc n) (rest as) (conj acc (first as))))))
        aug (if target args (into [{:n "the_stableptr" :ty "StgStablePtr"}] (ret-addr args)))
        unit? (unit-ty? res-ty)
        cres (if unit? "void" (str "Hs" (ffi-stg-type res-ty)))
        proto (str cres " " c-nm "(" (if (empty? aug) "void" (str/join ", " (map #(str (:ty %) " " (:n %)) aug))) ")")
        expr (reduce (fn [acc a] (str "rts_apply(cap," acc ",rts_mk" (subs (:ty a) 2) "(cap," (:n a) "))"))
                     (if target (str "&" target "_closure") "(StgClosure*)deRefStablePtr(the_stableptr)")
                     args)]
    {:h [(str "extern " proto ";")]
     :ts ts
     :c (vec (concat [" "] (when target [(str "extern StgClosure " target "_closure;")])
                     [proto "{" "Capability *cap;" "HaskellObj ret;"]
                     (when-not unit? [(str cres " cret;")])
                     ["cap = rts_lock();"
                      (str "rts_inCall(&cap,rts_apply(cap," (if io? "ghc_hs_iface->runIO_closure" "ghc_hs_iface->runNonIO_closure")
                           "," expr ") ,&ret);")
                      (str "rts_checkSchedStatus(\"" c-nm "\",cap);")]
                     (when-not unit? [(str "cret=rts_get" (subs cres 2) "(ret);")])
                     ["rts_unlock(cap);"]
                     (when-not unit? ["return cret;"])
                     ["}"]))}))

(defn- io-split
  "tcSplitIOType_maybe: [t true] of IO t, else [t false]"
  [t]
  (let [t (deep-expand t)]
    (if (and (= :tc (first t)) (= io-tc (second t))) [(first (nth t 2)) true] [t false])))

(defn- capi-stub
  "dsFCall's CApiConv's C: the wrapper wname calling (or, a value import, reading) the C name sym, its arguments and result
  as toCType gives them from the normalised type nt (the original type t's ConstPtr result const), after the
  declaration's header, the result's and the arguments' (each once, in that order)"
  [wname sym fun? decl-header t]
  (let [[arg-tys res] (ffi-split (ffi-normalise t))
        [raw _] (io-split res)
        [_ ores] (ffi-split t)
        const? (let [r (deep-expand (first (io-split ores)))]
                 (and (= :tc (first r)) (= (ext-name "tc" "GHC.Internal.Foreign.C.ConstPtr" "ConstPtr") (second r))))
        void? (unit-ty? raw)
        [rh rc] (if void? [nil "void"] (c-type raw))
        cargs (mapv c-type arg-tys)
        hdrs (distinct (remove nil? (concat [decl-header rh] (map first cargs))))
        call (cond fun? (str sym "(" (str/join ", " (map #(str "a" (inc %)) (range (count arg-tys)))) ")")
                   (empty? arg-tys) sym
                   :else (throw (ex-info "dsFCall: Unexpected arguments to FFI value import" {})))
        argtypes (if (empty? cargs) "void" (str/join ", " (map-indexed (fn [i [_ c]] (str c " a" (inc i))) cargs)))]
    {:h []
     :c (vec (concat (for [h hdrs] (str "#include \"" h "\""))
                     [(str (when const? "const ") rc " " wname "(" argtypes ") {" (if void? call (str "return " call)) ";}")]))}))

(defn- fexports-init
  "foreignExportsInitialiser: the module's exports' closures registered (registerForeignExports) by its initializer"
  [closures]
  (when (seq closures)
    (let [mstr *module*]
      [(str "static struct ForeignExportsList stg_exports_" mstr " = {.exports =  {"
            (str/join ", " (map #(str "(StgPtr) &" % "_closure") closures)) "}, .n_entries =  " (count closures) "};")
       (str "void " (zenc mstr) "_init__fexports (void)")
       (str "{registerForeignExports(&stg_exports_" mstr ");}")])))

(defn- ffi-call-body
  "dsFCall's worker and wrapper body (inlined, as GHC's -O0 Simplifier does): the call f of spec sp on the unboxed
  atoms vals (their types val-tys) and the State# token, its unboxed result matched and boxed by resultWrapper
  (mk_alt), in IO (\\s -> ...) for an IO result, else applied to realWorld#; nil when resultWrapper refuses the result"
  [f sp vals val-tys res-ty]
  (let [io? (and (= :tc (first res-ty)) (= io-tc (second res-ty)))
        inner (if io? (first (nth res-ty 2)) res-ty)
        rw (ffi-result-wrapper inner)]
    (when rw
      (let [[pt wrap] rw
            ccall-res (if pt [:tc (utuple-tc 2) [state-rw pt]] [:tc (utuple-tc 1) [state-rw]])
            _ (swap! *genv* assoc f (reduce (fn [r a] (fn-ty a r)) (fn-ty state-rw ccall-res) (reverse val-tys)))
            _ (swap! *fcalls* assoc f (cond-> (dissoc sp :no-unit) (not (:no-unit sp)) (assoc :unit *unit*)))
            ;; mk_alt: the call's unboxed result matched, the result boxed; return_result: (# s, r #) for IO, r else
            s2 (ffi-lv "ds" state-rw)
            r (when pt (ffi-lv "ds" pt))
            ans (wrap r)
            rhs (if io? (list 'app (list 'v (assoc (unboxed-con 2) 1 "var")) [s2 ans]) ans)
            alt (list 'alt (unboxed-con (if pt 2 1)) (if pt [s2 r] [s2]) rhs)
            call (fn [st] (list 'case (list 'app (list 'v f) (conj (vec vals) st)) (ffi-lv "wild" ccall-res) [alt]))]
        (if io?
          (let [s (ffi-lv "s" state-rw)]
            (list 'app (list 'v (ext-name "var" "GHC.Internal.Types" "IO")) [(list 'lam [s] (call s))]))
          (call (list 'v (ext-name "var" "GHC.Internal.Prim" "realWorld#"))))))))

(def ^:private addr-ty [:tc (ext-name "tc" "GHC.Internal.Prim" "Addr#") []])

(defn ds-fimport
  "dsFImport: the binding of foreign import n :: t with the CImport ci, as Core, or nil when it is not desugared (an
  argument or result type unboxArg or resultWrapper refuses); a dynamic import (dsFCall's DynamicTarget, queue 364) is a
  call whose first argument, the FunPtr unboxed to its Addr#, is the function called; a capi import's call is its C
  wrapper's, wname (capi-target's, the caller's); a \"wrapper\" import (dsCFExportDynamic, queue 364) makes a stable
  pointer of its function and calls createAdjustor with it, the stub's label and its type string (adj, [LABEL TS])"
  [n t ci & [{:keys [wname adj]}]]
  (let [sp (ffi-spec ci) [arg-tys res-ty] (ffi-split t)]
    (cond
      (or (:unknown sp) (nil? (:conv sp))) nil
      ;; dsCFExportDynamic: \cback -> bindIO (newStablePtr cback) (\stbl -> createAdjustor's call), the call dsCCall's
      ;; (unsafe, no unit): the stable pointer unboxed, the stub's label (IsFunction) and the type string its arguments,
      ;; the result (IO (FunPtr ...)) boxed
      (:wrapper sp)
      (let [[arg-tys res-ty] (ffi-split (ffi-normalise t))]
      (when (and adj (= 1 (count arg-tys)))
        ;; (the type normalised, as dsCFExportDynamic's coercionLKind: T493's MyIO (MyFunPtr ...) is IO (FunPtr ...))
        (let [[label ts] adj
              at (first arg-tys)
              [inner _] (io-split res-ty)
              sp-ty [:tc (ext-name "tc" "GHC.Internal.Stable" "StablePtr") [at]]
              sp#-ty [:tc (ext-name "tc" "GHC.Internal.Prim" "StablePtr#") [at]]
              cback (ffi-lv "ds" at)
              stbl (ffi-lv "ds" sp-ty)
              a (ffi-lv "ds" sp#-ty)
              f (ext-name "ffi" *module* (str "ccall:createAdjustor:" (occ n)))
              body (ffi-call-body f {:conv :ccall :safety :unsafe :target "createAdjustor" :fun true :no-unit true}
                                  [a (list 'lit (str "&label:" label ":fun")) (list 'lit (str (pr-str ts) "#"))]
                                  [sp#-ty addr-ty addr-ty] [:tc io-tc [inner]])]
          (when body
            (list 'lam [cback]
                  (list 'app (list 'v (ext-name "var" "GHC.Internal.Base" "bindIO"))
                        [(list 'app (list 'v (ext-name "var" "GHC.Internal.Stable" "newStablePtr")) [cback])
                         (list 'lam [stbl]
                               (list 'case stbl (ffi-lv "ds" sp-ty)
                                     [(list 'alt (ext-name "data" "GHC.Internal.Stable" "StablePtr") [a] body)]))]))))))
      ;; dsFLabel: the label's address in the result's constructor (FunPtr or Ptr), IsFunction when it is a FunPtr
      (:label sp)
      (let [[c ft] (ffi-con-field res-ty 'data)]
        (when (and c (ffi-prim-type? ft))
          (list 'app (list 'v (assoc c 1 "var"))
                [(list 'lit (str "&label:" (:label sp) ":" (if (= "FunPtr" (occ (second res-ty))) "fun" "data")))])))
      ;; dsPrimCall: the arguments and the result as they are, the call applied
      (= :prim (:conv sp))
      (let [xs (mapv #(ffi-lv "ds" %) arg-tys)
            f (ext-name "ffi" *module* (str "prim:" (:target sp) ":" (occ n)))]
        (swap! *genv* assoc f (reduce (fn [r a] (fn-ty a r)) res-ty (reverse arg-tys)))
        (swap! *fcalls* assoc f (assoc sp :unit *unit*))
        (if (empty? xs) (list 'app (list 'v f) []) (list 'lam xs (list 'app (list 'v f) xs))))
      :else
      (let [xs (mapv #(ffi-lv "ds" %) arg-tys)
            unb (map ffi-unbox-arg xs arg-tys)]
        (when (every? some? unb)
          (let [vals (mapv first unb)
                sp (if (= :capi (:conv sp)) (assoc sp :target (or wname (capi-target (:target sp))) :fun true) sp)
                f (ext-name "ffi" *module* (str (name (:conv sp)) ":" (if (:dynamic sp) "dynamic" (:target sp)) ":" (occ n)))
                body (ffi-call-body f sp vals (map (fn [v] (get @*ltypes* v)) vals) res-ty)]
            (when body
              (let [body (reduce (fn [b [_ w]] (w b)) body (reverse unb))]
                (if (empty? xs) body (list 'lam xs body))))))))))

(defn- fimport-stub
  "A foreign import's stub and what its desugaring needs ({:stub {:h :c} :wname :adj}): a capi function's C wrapper
  (its number the module's next), a \"wrapper\" import's adjustor stub, any other's none"
  [n t ci]
  (let [sp (ffi-spec ci)
        hdr (let [h (arg ci 4)] (when (= 'Just (con h)) (arg (arg h 1) 2)))]
    (cond
      (and (= :capi (:conv sp)) (:target sp))
      (let [w (capi-target (:target sp))]
        {:wname w :stub (try (capi-stub w (:target sp) (:fun sp) hdr t) (catch Throwable _ {:h [] :c []}))})
      (:wrapper sp)
      (try (let [[[at] res] (ffi-split (ffi-normalise t))
                 label (zenc (str "$" *unit* "$" *module* "$" (zenc *module*) "_" (zenc (occ n))))
                 [fargs fres] (ffi-split at)
                 [r io?] (io-split fres)
                 bits (fexport-cbits label nil fargs r io?)]
             {:adj [label (:ts bits)] :stub (dissoc bits :ts)})
           (catch Throwable e (when (System/getenv "REPR_HASKELL_FFI_TRACE") (binding [*out* *err*] (println "ffi-trace: wrapper stub:" (occ n) (.getMessage e)))) {:stub {:h [] :c []}}))
      :else {:stub {:h [] :c []}})))

;;; ------------------------------------------------------------------------------------------
;;; Expressions

(declare occurrences wrap-lets want! infer check-expr scope-givens assume-eqs! dict-param solve-with-givens! retry-implications! tc-local-binds infer-matches tc-pat infer-grhss rename-mono reduce-by-instance substitute)

;; env: {NAME {:mono type} | {:poly type :core term}}

(def ^:dynamic *module* nil)
(def ^:dynamic *deriv-aux* nil) ; atom [[NAME :datatype|:constr binding]...]: derived Data's auxiliary bindings ($tT, $cC)
(def ^:dynamic *derivs* nil)     ; atom [{:cls :tn :names :res :desc}]: the stock deriving requests of the module
(def ^:dynamic *ddescs* nil)     ; atom {TYCON {:desc :names}}: the module's data types as deriving sees them
(def ^:dynamic *exts* #{})
(def ^:dynamic *fixities* nil)   ; atom {CON [PREC ASSOC]}
(def cls-callstack (ext-name "tc" "GHC.Internal.Stack.Types" "HasCallStack"))

(defn- callstack-ip
  "HF10-P43 (a): the name of an implicit parameter of type CallStack (GHC.Tc.Utils.TcType's isCallStackPred: any name,
  ?loc :: CallStack as ?callStack), else nil"
  [pred]
  (when (= cls-ip (first pred))
    (let [[nt t] (second pred) nt (prune nt)]
      (when (and (vector? nt) (= :lit (first nt)) t (= [:tc tc-callstack []] (expand (zonk t))))
        (second nt)))))

(defn- callstack-term
  "HasCallStack's evidence at an occurrence of n at span sp, as GHC's solver builds it (an implicit parameter: the
  call site pushed onto the empty stack); ipn, the implicit parameter's name when another than HasCallStack's
  (EvCsPushCall onto the same name's stack, a new wanted of it)"
  [n sp & [label ipn]]
  (let [cs (fn [x] (list 'app (list 'v (ext-name "var" "GHC.Internal.CString" "unpackCString#")) [(list 'lit (str (pr-str x) "#"))]))
        i (fn [x] (list 'app (list 'v (ext-name "var" "GHC.Internal.Types" "I#")) [(list 'lit (str x "#"))]))
        cip (fn [x] (list 'app (list 'v (ext-name "var" "GHC.Internal.Classes" "C:IP")) [x]))
        [l1 c1 l2 c2] (take-last 4 sp)]
    (cip (list 'app (list 'v (ext-name "var" "GHC.Internal.Stack.Types" "pushCallStack"))
               [(list 'app (list 'v (ext-name "var" "GHC.Internal.Tuple" "(,)"))
                      [(cs (or label (occ n)))
                       (list 'app (list 'v (ext-name "var" "GHC.Internal.Stack.Types" "$WSrcLoc"))
                             [(cs *unit*) (cs *module*) (cs (or *srcfile* (str (str/replace *module* "." "/") ".hs"))) (i l1) (i c1) (i l2) (i c2)])])
                ;; the stack it pushes onto: ?callStack itself, a new wanted (EvCsPushCall's), solved from the enclosing
                ;; HasCallStack given, else defaulted to the empty stack
                (list 'app (list 'v (ext-name "var" "GHC.Internal.Classes" "ip"))
                      [(want! (if ipn [cls-ip [[:lit ipn] (con-ty tc-callstack)]] [cls-callstack []]))])]))))

(defn- push-given-callstack
  "Queue 385: a HasCallStack given q with a call site pushed, the label at span sp (GHC's EvCsPushCall onto a given's
  stack: an instance signature's \"a type signature in an instance\")"
  [label sp q]
  (let [cs (fn [x] (list 'app (list 'v (ext-name "var" "GHC.Internal.CString" "unpackCString#")) [(list 'lit (str (pr-str x) "#"))]))
        i (fn [x] (list 'app (list 'v (ext-name "var" "GHC.Internal.Types" "I#")) [(list 'lit (str x "#"))]))
        [l1 c1 l2 c2] (take-last 4 sp)]
    (list 'app (list 'v (ext-name "var" "GHC.Internal.Classes" "C:IP"))
          [(list 'app (list 'v (ext-name "var" "GHC.Internal.Stack.Types" "pushCallStack"))
                 [(list 'app (list 'v (ext-name "var" "GHC.Internal.Tuple" "(,)"))
                        [(cs label)
                         (list 'app (list 'v (ext-name "var" "GHC.Internal.Stack.Types" "$WSrcLoc"))
                               [(cs *unit*) (cs *module*) (cs (or *srcfile* (str (str/replace *module* "." "/") ".hs"))) (i l1) (i c1) (i l2) (i c2)])])
                  (list 'app (list 'v (ext-name "var" "GHC.Internal.Classes" "ip")) [q])])])))

(defn- want-at!
  "The evidence of a predicate of an occurrence: HasCallStack solved at once, the others wanted"
  [pred n sp & [label]]
  (cond (and (= cls-callstack (first pred)) sp) (callstack-term n sp label)
        (and sp (callstack-ip pred)) (callstack-term n sp label (callstack-ip pred))
        :else (want! pred)))

(defn- var-occ
  "An occurrence of a variable or constructor: [type core]"
  [env n & [sp label]]
  (if-let [e (get env n)]
    (if (:mono e)
      (let [mt (prune (:mono e))]
        (when-not (:core e) (note-type! (lv n) (:mono e)))
        (if (and (vector? mt) (= :forall (first mt)) (seq (nth mt 2)))
          ;; HF10-P20: a binder of a qualified type (withFrozenCallStack's do_this :: HasCallStack => a): its occurrence
          ;; takes its constraints' evidence (GHC's instantiation of a lambda-bound Id; the ?callStack the let gives),
          ;; else do_this was returned unapplied and throwIO's continuation cased on a function. HF10-P66 (a): a
          ;; binder of a polytype with quantifiers too (fromConstrM's f :: forall b. Data ctx b => m b, used bare in
          ;; `b <- f`): instantiated, its context's evidence applied; before, f went unapplied and the next bind took
          ;; the dictionary's function for the action (T1735's "no alternative for (ReadState :{..})")
          (let [[t ps] (instantiate mt)]
            [t (app* (or (:core e) (lv n)) (mapv #(want-at! % n sp label) ps))])
          [(:mono e) (or (:core e) (lv n))]))
      (let [[t preds] (instantiate (:poly e))]
        ;; a binding of the module itself (or a local one) with HasCallStack pushes its call site too (EvCsPushCall)
        [t (app* (:core e) (mapv #(want-at! % n sp label) preds))]))
    (if-let [t (get @*genv* (if (= "data" (nth n 1)) n n))]
      (let [[t preds] (instantiate t)
            ps (when (= "data" (nth n 1)) (some-> *patsyns* deref (get n)))
            ;; HF10-P36 (a): a pattern synonym as an expression is its builder $bP (applied to (# #) when it takes the
            ;; dummy argument)
            core (list 'v (cond ps (builder-name n) (= "data" (nth n 1)) (ext-name "var" (nmod n) (occ n)) :else n))
            c (app* core (mapv #(want-at! % n sp label) preds))]
        [t (if (and ps (builder-dummy? ps)) (app* c [unit#-core]) c)])
      (do (error! "no type for " (name-str n)) [(fresh-meta) (list 'v n)]))))

(defn- implicit-name
  "The name of the implicit slot (rn/implicit [NAME...] [SPAN...]) of node v whose occurrence is o"
  [v o default]
  (or (some (fn [x] (when (and (seq? x) (= 'rn/implicit (first x)))
                      (some #(when (= o (occ %)) %) (second x))))
            v)
      default))

(def ^:private is-list-m "GHC.Internal.IsList")

(defn- ovl-lists?
  "HF10-P54 (a): OverloadedLists on, and IsList's interface loaded (a module that never imports it keeps its lists)"
  []
  (and (contains? *exts* "OverloadedLists") (not (contains? *exts* "RebindableSyntax"))
       (contains? @*genv* (ext-name "var" is-list-m "fromListN"))))

(declare var-occ)

(defn- ovl-list
  "HF10-P54 (a): an explicit list [type core] of n elements under OverloadedLists (GHC.Rename.Expr's rnExpr of
  ExplicitList): fromListN n of it, IsList's (the literal n at Int)"
  [env [tl cl :as plain] n]
  (if-not (ovl-lists?)
    plain
    (let [[tf cf] (var-occ env (ext-name "var" is-list-m "fromListN")) r (fresh-meta)]
      (unify tf (fn-ty (con-ty tc-int) (fn-ty tl r)))
      [r (app* cf [(list 'app (list 'v (ext-name "var" "GHC.Internal.Types" "I#")) [(list 'lit (str n "#"))]) cl])])))

(defn- overlit
  "An overloaded literal: its type a fresh meta constrained by Num (Fractional), the core resolved at the end"
  [v]
  (let [ol (arg v 2) val (arg ol 2) a (fresh-meta)
        ;; NumDecimals: an integral fractional literal is an integral one (rnOverLit's generalizeOverLitVal)
        ival (when (and (= 'HsFractional (con val)) (contains? *exts* "NumDecimals")) (rename/integral-fl (arg val 1)))]
    (case (if ival 'HsIntegralFL (con val))
      HsIntegralFL (let [fi (implicit-name ol "fromInteger" (ext-name "var" "GHC.Internal.Num" "fromInteger"))
                         ev (want! [cls-num [a]])]
                     [a (list 'olit :int (str ival) a ev fi)])
      HsIntegral (let [n (nth (arg val 1) 3)
                       fi (implicit-name ol "fromInteger" (ext-name "var" "GHC.Internal.Num" "fromInteger"))
                       ev (want! [cls-num [a]])]
                   [a (list 'olit :int n a ev fi)])
      HsFractional (let [fl (arg val 1)
                         fr (implicit-name ol "fromRational" (ext-name "var" "GHC.Internal.Real" "fromRational"))
                         ev (want! [cls-fractional [a]])]
                     [a (list 'olit :frac fl a ev fr)])
      [(fresh-meta) (list 'lit "?")])))

(defn- prim-ty [o] [:tc (ext-name "tc" "GHC.Internal.Prim" o) []])

(defn- fl-text
  "A FractionalLit (FL (src S) NEG (:% N D) EXP BASE) as decimal text, exactly: N/D * 10^EXP"
  [fl]
  (let [[_ _ neg [_ n d] e] fl
        x (with-precision 40 (/ (.scaleByPowerOfTen ^java.math.BigDecimal (bigdec n) (int e)) (bigdec d)))
        t (.toPlainString ^java.math.BigDecimal x)
        t (if (str/includes? t ".") t (str t ".0"))]
    ;; a literal is a Rational (GHC's LitDouble, LitFloat): -0.0## is 0.0
    t))

(declare hslit)

(defn- ovl-string?
  "HF10-P54 (a): a string literal under OverloadedStrings (GHC.Rename.Expr's rnExpr and GHC.Rename.Pat's rnPatAndThen
  make it an HsOverLit's HsIsString, a pattern's an NPat)"
  [v]
  (and (contains? *exts* "OverloadedStrings") (seq? (arg v 2)) (= 'HsString (con (arg v 2)))
       (not (contains? *exts* "RebindableSyntax"))))

(defn- ovl-string
  "HF10-P54 (a): an overloaded string literal (GHC.Tc.Utils.Instantiate's newOverloadedLit of HsIsString): its type a
  fresh meta constrained by IsString, the core fromString of the String literal, resolved at the end (lit-core :str)"
  [v]
  (let [a (fresh-meta)
        fs (implicit-name v "fromString" (ext-name "var" "GHC.Internal.Data.String" "fromString"))
        ev (want! [(ext-name "tc" "GHC.Internal.Data.String" "IsString") [a]])]
    [a (list 'olit :str (arg (arg v 2) 2) a ev fs)]))

(defn- hslit [v]
  (let [l (arg v 2)]
    (case (con l)
      ;; GHC.Core.Make.mkStringExprFS: ASCII without NUL unpackCString#, else the modified UTF-8 of unpackCStringUtf8#; the
      ;; empty string the list's [] (nullFS: mkNilExpr; show's default method's "" among them)
      HsString [(list-ty (con-ty tc-char))
                (if (empty? (arg l 2))
                  (list 'v (ext-name "var" "GHC.Internal.Types" "[]"))
                  (list 'app (list 'v (ext-name "var" "GHC.Internal.CString"
                                                (if (every? #(< 0 (int %) 128) (arg l 2)) "unpackCString#" "unpackCStringUtf8#")))
                        [(list 'lit (str (pr-str (arg l 2)) "#"))]))]
      HsChar [(con-ty tc-char) (list 'app (list 'v (ext-name "var" "GHC.Internal.Types" "C#")) [(list 'lit (str "'" (arg l 2) "'#"))])]
      HsInt [(con-ty tc-int) (list 'app (list 'v (ext-name "var" "GHC.Internal.Types" "I#")) [(list 'lit (str (arg l 2) "#"))])]
      ;; MagicHash's primitive literals: their types of GHC.Internal.Prim, the literal's text as tostg reads it
      HsIntPrim [(prim-ty "Int#") (list 'lit (str (arg l 2) "#"))]
      HsWordPrim [(prim-ty "Word#") (list 'lit (str (arg l 2) "##"))]
      HsInt64Prim [(prim-ty "Int64#") (list 'lit (str (arg l 2) "#"))]
      ;; HF10-P54 (a): ExtendedLiterals' sized literals (GHC.Hs.Lit's HsInt8Prim .. HsWord32Prim; Core's LitNumInt8 ..)
      HsInt8Prim [(prim-ty "Int8#") (list 'lit (str (arg l 2) "#i8"))]
      HsInt16Prim [(prim-ty "Int16#") (list 'lit (str (arg l 2) "#i16"))]
      HsInt32Prim [(prim-ty "Int32#") (list 'lit (str (arg l 2) "#i32"))]
      HsWord8Prim [(prim-ty "Word8#") (list 'lit (str (arg l 2) "#w8"))]
      HsWord16Prim [(prim-ty "Word16#") (list 'lit (str (arg l 2) "#w16"))]
      HsWord32Prim [(prim-ty "Word32#") (list 'lit (str (arg l 2) "#w32"))]
      HsWord64Prim [(prim-ty "Word64#") (list 'lit (str (arg l 2) "##"))]
      HsCharPrim [(prim-ty "Char#") (list 'lit (str "'" (arg l 2) "'#"))]
      HsStringPrim [(prim-ty "Addr#") (list 'lit (str (pr-str (arg l 2)) "#"))]
      HsDoublePrim [(prim-ty "Double#") (list 'lit (str (fl-text (arg l 2)) "##"))]
      HsFloatPrim [(prim-ty "Float#") (list 'lit (str (fl-text (arg l 2)) "#"))]
      [(fresh-meta) (list 'lit "?")])))

(defn- global-occ [env o m]
  (var-occ env (ext-name "var" m o)))

(defn- fail-msg
  "The desugarer's message of a failed pattern (GHC.HsToCore.Utils' mk_fail_msg): the context and the pattern's span as
  GHC prints a SrcSpan, a String"
  [ctx [l1 c1 l2 c2]]
  (let [loc (if (= l1 l2) (str l1 ":" c1 "-" (dec c2)) (str "(" l1 "," c1 ")-(" l2 "," (dec c2) ")"))
        msg (str "Pattern match failure in " ctx " at " (or *srcfile* (str *module* ".hs")) ":" loc)]
    (list 'app (list 'v (ext-name "var" "GHC.Internal.CString" (if (every? #(< 0 (int %) 128) msg) "unpackCString#" "unpackCStringUtf8#")))
          [(list 'lit (str (pr-str msg) "#"))])))

;; Queue 352, 346-1 (a): the pattern-match failure's text, as GHC.HsToCore.Utils' mkErrorAppDs writes it for patError and
;; nonExhaustiveGuardsError ("SPAN|CONTEXT": the desugarer's current location, GHC.Types.SrcLoc's pprUserRealSpan, and
;; GHC.Hs.Expr's matchContextErrString), the runtime's untangle making "SPAN: Non-exhaustive patterns in CONTEXT"

(def ^:dynamic *match-span* nil) ; the span of the expression whose match group is checked (HsCase, HsLam: dsLExpr's location)

(defn- span-text
  "A span [l1 c1 l2 c2] (end column exclusive) as GHC prints a SrcSpan, with the source file"
  [[l1 c1 l2 c2]]
  (str (or *srcfile* (str (str/replace *module* "." "/") ".hs")) ":"
       (if (= l1 l2)
         (str l1 ":" c1 (when (> (- c2 c1) 1) (str "-" (dec c2))))
         (str "(" l1 "," c1 ")-(" l2 "," (if (zero? c2) c2 (dec c2)) ")"))))

(defn- match-ctx-text
  "A match's context (Match's m_ctxt) as GHC's matchContextErrString, or nil for one not ported"
  [ctx]
  (case (if (seq? ctx) (first ctx) ctx)
    FunRhs (when-let [n (nm (second ctx))] (str "function " (occ n)))
    CaseAlt "case"
    LamAlt (case (second ctx) LamSingle "lambda" LamCase "\\case" LamCases "\\cases" nil)
    IfAlt "multi-way if"
    nil))

;;; ------------------------------------------------------------------------------------------
;;; Queue 369 (346's item 7): the deferred type errors' messages, as GHC.Tc.Errors' mkErrorTerm writes them: the error's
;;; envelope (pprLocMsgEnvelope: FILE:LINE:COL: error: [GHC-CODE], its bullets nested 4), "(deferred type error)" below,
;;; rendered at 100 columns. The mismatch is GHC.Tc.Errors.Ppr's pprMismatchMsg (TypeEqMismatch: the check's expected and
;;; actual types when the failing pair looks the same, else the pair and "Expected:", "  Actual:"), the contexts its
;;; pprErrCtxtMsg (ExprCtxt, FunAppCtxt, MatchInCtxt, MainCtxt; at most mAX_CONTEXTS = 3 that are not landmarks, the
;;; landmark FunResCtxt's "Probable cause" first). GHC's words where the message is made of what is ported (closed types:
;;; no variable to tidy, no "Relevant bindings"; the contexts above); else the same shape, the types and contexts as
;;; near as the elaborator has them

(def ^:dynamic ^:private *ppr-exact* nil) ; atom true: the message is GHC's (no part guessed)
(defn- inexact! [] (when *ppr-exact* (reset! *ppr-exact* false)))

(defn- unrn
  "A renamed node as the parsed tree arbace.repr.haskell.pprhs prints: each (rn/name N) its occurrence, unqualified"
  [x]
  (walk/postwalk (fn [y] (if (and (seq? y) (= 'rn/name (first y)) (vector? (second y)))
                           (let [n (second y)] (list 'unqual (symbol (nth n 1)) (occ n)))
                           y))
                 x))

(defn- doc-text
  "A document rendered, inexact when pprhs met a node it does not print (its constructor in angle brackets)"
  [d]
  (let [t (doc/render d 100)] (when (re-find #"<[A-Z][A-Za-z]*" t) (inexact!)) d))

(defn- ppr-lexpr* [e] (doc-text (pprhs/ppr-lexpr (unrn e))))

(defn- strip-parens [e] (if (= 'HsPar (con (lval e))) (recur (arg (lval e) 2)) e))

(defn- ppr-ty*
  "GHC's pprType of an elaborator's type at precedence p (0 the top, 1 an arrow's argument, 2 an application's)"
  [t p]
  (let [t (prune t)
        par (fn [b x] (if b (str "(" x ")") x))
        app (fn [h as] (if (empty? as) h (par (>= p 2) (str/join " " (cons h (map #(ppr-ty* % 2) as))))))]
    (case (first t)
      :tc (let [n (second t) as (nth t 2) o (occ n)]
            (cond
              (and (= n fun-tc) (= 2 (count as))) (par (>= p 1) (str (ppr-ty* (first as) 1) " -> " (ppr-ty* (second as) 0)))
              (and (= n list-tc) (= 1 (count as))) (str "[" (ppr-ty* (first as) 0) "]")
              (and (= "GHC.Internal.Tuple" (nmod n)) (re-matches #"Tuple[0-9]+" o) (= (count as) (Long/parseLong (subs o 5))))
              (str "(" (str/join ", " (map #(ppr-ty* % 0) as)) ")")
              (and (= "GHC.Internal.Tuple" (nmod n)) (= "Unit" o) (empty? as)) "()"
              :else (app o as)))
      :app (let [[h as] (loop [x t as ()] (if (= :app (first x)) (recur (prune (nth x 1)) (cons (nth x 2) as)) [x as]))]
             (app (ppr-ty* h 2) as))
      :tv (do (inexact!) (let [x (str (second t))] (or (second (re-matches #"(.*?)_sk[0-9]+" x)) (second (re-matches #"sk_([^_]+)_.*" x)) x)))
      :mv (if-let [n (:name (get @*metas* (second t)))] (str n "0") (do (inexact!) "t0"))
      (do (inexact!) (pr-str t)))))

(defn- ppr-ty [t] (doc/text (ppr-ty* t 0)))

(defn- atomic-ty? [t]
  (let [t (prune t)] (or (contains? #{:tv :mv} (first t)) (and (= :tc (first t)) (empty? (nth t 2))))))

(defn- arrows [t] (loop [t (expand (prune t)) n 0] (if (and (= :tc (first t)) (= fun-tc (second t))) (recur (expand (prune (second (nth t 2)))) (inc n)) n)))

(defn- speak-nth [n]
  (case (long n) 1 "first" 2 "second" 3 "third" 4 "fourth" 5 "fifth" 6 "sixth"
    (str n (let [d (rem n 10)] (cond (<= n 20) "th" (= d 1) "st" (= d 2) "nd" (= d 3) "rd" :else "th")))))

(defn- ctxt-doc
  "An error context as pprErrCtxtMsg prints it; nil for none (a lambda's match: tcMatch adds no context), ::none when not
  ported (inexact)"
  [[k a b c]]
  (case k
    :expr (doc/hang (doc/text "In the expression:") 2 (ppr-lexpr* (strip-parens a)))
    :arg (doc/hang (doc/hsep [(doc/text "In the") (doc/text (speak-nth c)) (doc/text "argument of")
                              (doc/<> (doc/quotes (ppr-lexpr* a)) (doc/text ", namely"))])
                   2 (doc/quotes (ppr-lexpr* b)))
    :match (let [ctx (arg (lval a) 2) h (if (seq? ctx) (first ctx) ctx)
                 pm (fn [what] (doc/hang (doc/<> (doc/text (str "In " what)) doc/colon) 4
                                         (doc-text (@#'pprhs/ppr-match (unrn a)))))]
             (case h
               FunRhs (if-let [n (nm (second ctx))] (pm (str "an equation for ‘" (occ n) "’")) ::none)
               CaseAlt (pm "a case alternative")
               LamAlt (if (= 'LamSingle (second ctx)) nil ::none)
               ::none))
    :main (doc/text "When checking the type of the IO action ‘main’")
    ::none))

(defn- envelope
  "pprLocMsgEnvelope's error at span sp with GHC's code and the bullets (formatBulleted), then the deferred error's line"
  [sp code bullets]
  (let [[l1 c1] sp
        file (or *srcfile* (str (str/replace *module* "." "/") ".hs"))
        header (doc/<+> (doc/<> (doc/text (if sp (str file ":" l1 ":" c1) (do (inexact!) (str file ":1:1")))) doc/colon)
                        (doc/<> (doc/text "error") doc/colon) (doc/brackets (doc/text (str "GHC-" code))))
        ds (remove doc/is-empty? bullets)
        body (if (= 1 (count ds)) (first ds) (doc/vcat (map #(doc/<+> doc/bullet %) ds)))]
    (doc/render (doc/$$ (doc/hang header 4 body) (doc/text "(deferred type error)")) 100)))

(defn- mismatch-text
  "A failed unification's deferred message (a *defer-log* entry): [text exact?]"
  [{:keys [ty1 ty2 ea ctxt span]}]
  (binding [*ppr-exact* (atom true)]
    (let [herald (fn [h1 t1 h2 t2 atomic?]
                   (let [pad (- (count h1) (count h2))]
                     (if atomic?
                       (doc/sep [(doc/<+> (doc/text h1) (doc/quotes (ppr-ty t1))) (doc/nest pad (doc/<+> (doc/text h2) (doc/quotes (ppr-ty t2))))])
                       (doc/vcat [(doc/<+> (doc/<> (doc/text h1) doc/colon) (ppr-ty t1))
                                  (doc/nest pad (doc/<+> (doc/<> (doc/text h2) doc/colon) (ppr-ty t2)))]))))
          {:keys [act exp fun]} ea
          same? (and ea (or (and (= act ty1) (= exp ty2)) (and (= exp ty1) (= act ty2))))
          mm (cond
               same? (herald "Couldn't match expected type" exp "with actual type" act (or (atomic-ty? exp) (atomic-ty? act)))
               ea (doc/vcat [(herald "Couldn't match type" ty1 "with" ty2 (or (atomic-ty? ty1) (atomic-ty? ty2)))
                             (doc/<+> (doc/text "Expected:") (ppr-ty exp))
                             (doc/<+> (doc/text "  Actual:") (ppr-ty act))])
               :else (do (inexact!) (herald "Couldn't match type" ty1 "with" ty2 (or (atomic-ty? ty1) (atomic-ty? ty2)))))
          ;; FunResCtxt (a landmark: not counted): the check of an application's result, its function's type with more
          ;; arguments than the expected type has, which is a data type's (not_fun)
          fr (when (and fun ea)
               (let [x (expand (prune exp))]
                 (cond (and (> (arrows act) (arrows exp)) (= :tc (first x)) (not= fun-tc (second x)) (not (stuck-family? x)))
                       (doc/<+> (doc/text "Probable cause:") (doc/quotes (ppr-lexpr* fun)) (doc/text "is applied to too few arguments"))
                       (< (arrows act) (arrows exp)) (do (inexact!) nil)
                       :else nil)))
          cs (loop [cs ctxt out [] n 0]
               (if (or (empty? cs) (>= n 3))
                 out
                 (let [d (ctxt-doc (first cs))]
                   (cond (nil? d) (recur (rest cs) out n)
                         (= ::none d) (do (inexact!) (recur (rest cs) out n))
                         :else (recur (rest cs) (conj out d) (inc n))))))
          t (envelope span "83865" [mm (doc/vcat (concat (when fr [fr]) cs))])]
      [t @*ppr-exact*])))

(defn- type-error-core
  "Control.Exception.Base's typeError of the message (evDelayedError's term)"
  [msg]
  (list 'app (list 'v (ext-name "var" "GHC.Internal.Control.Exception.Base" "typeError")) [(list 'lit (str (pr-str msg) "#"))]))

(defn- dict-defer-text
  "An unsolved wanted's deferred message (GHC's \"No instance for\", without its origin: not GHC's words)"
  [w]
  (let [[c ts] (zonk-pred (:pred w))]
    (binding [*ppr-exact* (atom true)]
      (envelope (:sp w) "39999"
                [(doc/<+> (doc/text "No instance for")
                          (doc/quotes (doc/text (str/join " " (cons (occ c) (map #(ppr-ty* % 2) ts))))))]))))

(defn- defer-errors!
  "Queue 369: under -fdefer-type-errors, a top-level binding group whose elaboration failed a unification (errors from n0 on,
  the first a failed unification) has each binding's right-hand side raise its first error's message (GHC binds the
  error's evidence at the binding: at -O0 the binding is typeError of it); its errors are no longer the module's. bs
  unchanged otherwise"
  [bs n0 l0]
  (let [errs @*errors* new (subvec errs n0)]
    (if (and *defer* (seq new) (str/starts-with? (first new) "cannot unify "))
      (let [e (first (filter #(and (identical? (:errs %) *errors*) (>= (:idx %) n0)) (subvec @*defer-log* l0)))
            [msg exact?] (if e (mismatch-text e) [(envelope nil "83865" [(doc/text (subs (first new) 0 (min 200 (count (first new)))))]) false])]
        (when trace? (binding [*out* *err*] (println "tc-trace: deferred" (if exact? "(GHC's words)" "(approximate)") (pr-str msg))))
        (reset! *errors* (subvec errs 0 n0))
        (mapv (fn [b] (if (and (seq? b) (= 'bind (first b))) (list 'bind (second b) (type-error-core msg)) b)) bs))
      bs)))

(defn- with-ectx
  "Queue 369: f under the expression's error context (GHC's addExprCtxt in tcPolyLExpr, tcMonoLExpr, tcInferRho: ExprCtxt and
  the expression's span), none when the expression is an argument's or a parenthesis's body (the NC variants) or the
  context is the same expression's already; only when type errors are deferred"
  [e f]
  (cond
    (not *defer-log*) (f)
    *ectx-nc* (binding [*ectx-nc* false *espan* (if (and (L? e) (lsp e)) (lsp e) *espan*)] (f))
    (not (and (L? e) (lsp e))) (f)
    (let [c (first *ectx*)] (and (= :expr (first c)) (identical? (second c) e))) (f)
    :else (binding [*ectx* (cons [:expr e] *ectx*) *espan* (lsp e)] (f))))

(defn- unify-ea
  "Queue 369: unify the actual type act with the expected exp, a failure logged with them (TypeEqOrigin); fun the head of an
  application or a variable whose result is checked (FunResCtxt)"
  [act exp & [fun]]
  (if *defer-log* (binding [*ea* {:act act :exp exp :fun fun}] (unify act exp)) (unify act exp)))

(defn- with-ef
  "A match (match SCRUTS CLAUSES) with its failure's text EF [TEXT GUARDS?] after its clauses"
  [m ef]
  (if ef (apply list (concat m [ef])) m))

(defn- tag-guards
  "Right-hand-side guards' (guards ALTS) failure text EF [TEXT GUARDS?] appended, through the lets around them"
  [c ef]
  (cond (not (and ef (seq? c))) c
        (and (= 'guards (first c)) (= 2 (count c))) (list 'guards (second c) ef)
        (= 'strict-rhs (first c)) (list 'strict-rhs (second c) (tag-guards (nth c 2) ef))
        (contains? #{'let 'letrec} (first c)) (list (first c) (second c) (tag-guards (nth c 2) ef))
        :else c))

(defn- strict-pat
  "Queue 352, 346-1 (a): a match's outermost pattern under the Strict extension, GHC.HsToCore.Utils' decideBangHood
  (matchWrapper's equations, matchSinglePat's statements): ~p is p, !p stays, any other p is !p; unchanged without Strict"
  [p]
  (cond (not (contains? *exts* "Strict")) p
        (and (seq? p) (= 'plazy (first p))) (second p)
        (and (seq? p) (= 'pbang (first p))) p
        :else (list 'pbang p)))

(def ^:dynamic *static-binds* nil) ; atom [BIND-or-nil...]: the module's static forms' top-level StaticPtr bindings, by number

(declare fp-words fp-string)

(defn- static-ptr!
  "HF10-P43 (a): a static form's StaticPtr, as GHC's -O0 pipeline makes it (makeStatic floated to the top level by the
  static forms' FloatOut, then sptCreateStaticBinds): StaticPtr (the key's two Word64#s: mkStaticPtrFingerprint, MD5 of
  \"UNIT:MODULE:N\", N the module's static forms counted) (StaticPtrInfo unit module (line, col) of the body) e. A body
  whose free variables are top-level is bound at the top level (the static pointer table's entry, the occurrence its
  name); one that mentions a local (a closed where-binding GHC floats with it) is built in place, outside the table"
  [env e c]
  (let [n (count @*static-binds*)
        [hi lo] (fp-words (fp-string (str *unit* ":" *module* ":" n)))
        [l1 c1] (lsp e)
        v* (fn [m o] (list 'v (ext-name "var" m o)))
        str* (fn [x] (list 'app (v* "GHC.Internal.CString" "unpackCString#") [(list 'lit (str (pr-str x) "#"))]))
        int* (fn [x] (list 'app (v* "GHC.Internal.Types" "I#") [(list 'lit (str x "#"))]))
        info (list 'app (v* "GHC.Internal.StaticPtr" "StaticPtrInfo")
                   [(str* *unit*) (str* *module*) (list 'app (list 'v (tuple-con 2)) [(int* l1) (int* c1)])])
        ptr (list 'app (v* "GHC.Internal.StaticPtr" "StaticPtr") [(list 'lit (str hi "#w64")) (list 'lit (str lo "#w64")) info c])
        local? (fn [x] (when-let [b (get env x)] (let [cc (:core b)] (not (and (seq? cc) (= 'v (first cc)))))))
        names (keep (fn [x] (when (and (seq? x) (= 'HsVar (first x))) (nm (arg x 2)))) (tree-seq coll? seq e))]
    (if (some local? names)
      (do (swap! *static-binds* conj nil) ptr)
      (let [b (ext-name "var" *module* (str "$spt" n))]
        (swap! *static-binds* conj (list 'bind b ptr))
        (list 'v b)))))

(declare stmts-binders big-tup-ty big-tup-core big-tup-pat)

(defn- mc-inner
  "HF10-P49 (a): dsInnerMonadComp: the statements then return of their binders' tuple, in the monad: [type core info]"
  [env stmts by rec]
  (let [out (atom nil)
        [t c] (rec env (conj (vec stmts) (list 'tc/ret-binders {:ns (stmts-binders stmts) :out out :by by})))]
    [t c @out]))

(defn- mc-bind
  "rhs >>= \\d -> case d of pat -> body (the pattern a variable or a tuple of the new binders)"
  [env [trhs crhs] elt pat-or-scrut body-t body-c]
  (let [[tb cb] (global-occ env ">>=" "GHC.Internal.Base")
        r (fresh-meta) d (fresh-lv "ds")]
    (note-type! d elt)
    (unify tb (fn-ty trhs (fn-ty (fn-ty elt body-t) r)))
    [r (app* cb [crhs (list 'lam [d] (pat-or-scrut d body-c))])]))

(defn- mc-trans-stmt
  "HF10-P49 (a): a monad comprehension's transform (GHC.HsToCore.ListComp's dsMcStmt TransStmt, mkMcUnzipM): using
  ((\\tuple -> by) and) the inner comprehension, at ((a -> t) ->) m a -> m a (m (m a), a group), bound to the new
  binders, a group's each fmap of its selector"
  [env v more rec]
  (let [mm (fresh-meta)
        byx (arg v 6) by (when (and (seq? byx) (= 'Just (first byx))) (second byx))
        [tin cin {:keys [ns ts tt vs] :as info}] (mc-inner env (arg v 3) by rec)
        _ (unify tin (mk-app mm tt))
        group? (= 'GroupForm (arg v 2))
        elt (if group? (mk-app mm tt) tt)
        res (mk-app mm elt)
        [tu cu] (infer env (arg v 5))
        bres (:by info)
        _ (unify tu (cond->> (fn-ty tin res) bres (fn-ty (fn-ty tt (first bres)))))
        by-lam (when bres
                 (let [d (fresh-lv "tup")]
                   (note-type! d tt)
                   (list 'lam [d] (list 'match [d] [(list 'clause [(if (empty? ns) (list 'pwild) (big-tup-pat vs))] (second bres))]))))
        rhs (app* cu (if bres [by-lam cin] [cin]))
        new (mapv (fn [n t] [n (fresh-lv (occ n)) (if group? (mk-app mm t) t)]) ns ts)
        env2 (reduce (fn [e [n c t]] (note-type! c t) (assoc e n {:mono t :core c})) env new)
        [tr cr] (rec env2 more)
        pat (if (empty? ns) (list 'pwild) (big-tup-pat (mapv second new)))]
    (if (and group? (> (count ns) 1))
      ;; mkMcUnzipM: (fmap (\\tup -> x1) d, ..., fmap (\\tup -> xn) d)
      (mc-bind env [res rhs] elt
               (fn [d body]
                 (let [sels (mapv (fn [i t]
                                    (let [[tf cf] (global-occ env "fmap" "GHC.Internal.Base")
                                          tp (fresh-lv "tup")]
                                      (note-type! tp tt)
                                      (unify tf (fn-ty (fn-ty tt t) (fn-ty elt (mk-app mm t))))
                                      (app* cf [(list 'lam [tp] (list 'match [tp] [(list 'clause [(big-tup-pat vs)] (nth vs i))])) d])))
                                  (range (count ns)) ts)
                       e (fresh-lv "unzip")]
                   (note-type! e (big-tup-ty (mapv #(nth % 2) new)))
                   (list 'app (list 'lam [e] (list 'match [e] [(list 'clause [pat] body)])) [(big-tup-core sels)])))
               tr cr)
      (mc-bind env [res rhs] elt (fn [d body] (list 'match [d] [(list 'clause [pat] body)])) tr cr))))

(defn- mc-par-stmt
  "HF10-P49 (a): a monad comprehension's parallel blocks (dsMcStmt ParStmt): each block's inner comprehension, mzip'ed to
  the right, bound to the nested pairs of their tuples"
  [env v more rec]
  (let [blocks (mapv (fn [b] (arg (lval b) 2)) (arg v 2))
        inners (mapv #(mc-inner env % nil rec) blocks)
        mm (fresh-meta)
        _ (doseq [[t _ info] inners] (unify t (mk-app mm (:tt info))))
        parts (mapv (fn [[t c info]]
                      (let [new (mapv (fn [n ty] [n (fresh-lv (occ n)) ty]) (:ns info) (:ts info))]
                        {:t t :c c :tt (:tt info) :new new
                         :pat (if (empty? new) (list 'pwild) (big-tup-pat (mapv second new)))}))
                    inners)
        zip* (fn zip* [ps]
               (if (= 1 (count ps))
                 (first ps)
                 (let [a (first ps) b (zip* (rest ps))
                       [tz cz] (global-occ env "mzip" "GHC.Internal.Control.Monad.Zip")
                       tt [:tc (tuple-tc 2) [(:tt a) (:tt b)]]]
                   (unify tz (fn-ty (:t a) (fn-ty (:t b) (mk-app mm tt))))
                   {:t (mk-app mm tt) :tt tt :c (app* cz [(:c a) (:c b)])
                    :pat (list 'pcon (ext-name "data" "GHC.Internal.Tuple" (occ (tuple-con 2))) [(:pat a) (:pat b)])})))
        z (zip* parts)
        env2 (reduce (fn [e [n c t]] (note-type! c t) (assoc e n {:mono t :core c})) env (mapcat :new parts))
        [tr cr] (rec env2 more)]
    (mc-bind env [(:t z) (:c z)] (:tt z) (fn [d body] (list 'match [d] [(list 'clause [(:pat z)] body)])) tr cr)))

(defn- rec-stmt
  "HF10-P50 (a): a do block's rec (RecursiveDo's RecStmt; mdo's segments, mdo-segments): GHC.HsToCore.Expr's dsDo of a
  RecStmt, tuple <- mfix (\\ ~tuple -> do { stmts; return tuple }), the tuple of the rec's binders (GHC's rec_ids and
  later_ids: here every binder), the binders rebound by the tuple for the statements after it"
  [env stmts more rec]
  (let [ns (stmts-binders stmts)
        ins (mapv (fn [n] [n (fresh-lv (occ n)) (fresh-meta)]) ns)
        env-in (reduce (fn [e [n c t]] (note-type! c t) (assoc e n {:mono t :core c})) env ins)
        [tin cin info] (mc-inner env-in stmts nil rec)
        tt (big-tup-ty (mapv #(nth % 2) ins))
        _ (unify (:tt info) tt)
        mm (fresh-meta)
        _ (unify tin (mk-app mm tt))
        [tf cf] (global-occ env "mfix" "GHC.Internal.Control.Monad.Fix")
        d (fresh-lv "rec")
        _ (note-type! d tt)
        _ (unify tf (fn-ty (fn-ty tt tin) tin))
        lam (list 'lam [d] (list 'match [d] [(list 'clause [(list 'plazy (if (empty? ns) (list 'pwild) (big-tup-pat (mapv second ins))))] cin)]))
        outs (mapv (fn [[n _ t]] [n (fresh-lv (occ n)) t]) ins)
        env2 (reduce (fn [e [n c t]] (note-type! c t) (assoc e n {:mono t :core c})) env outs)
        [tr cr] (rec env2 more)
        pat (if (empty? ns) (list 'pwild) (big-tup-pat (mapv second outs)))]
    (mc-bind env [tin (app* cf [lam])] tt (fn [x body] (list 'match [x] [(list 'clause [pat] body)])) tr cr)))

(defn- stmt-uses
  "The names a statement uses (its binding sites left out)"
  [v]
  (let [names (fn [x] (set (for [y (tree-seq coll? seq x) :when (and (seq? y) (= 'rn/name (first y)))] (second y))))]
    (case (con v)
      BindStmt (names (arg v 3))
      BodyStmt (names (arg v 2))
      LastStmt (names (arg v 2))
      (names v))))

(defn- mdo-segments
  "HF10-P50 (a): mdo's statements with each recursive segment a rec (GHC.Rename.Expr's segments and glomSegments, the
  minimal intervals): a statement that uses a binder of itself or of a later statement opens a rec reaching that
  binder's statement, overlapping intervals merged; the last statement never in one"
  [stmts]
  (let [stmts (vec stmts) n (count stmts)
        defs (mapv (fn [s] (set (stmts-binders [s]))) stmts)
        ivs (for [i (range (dec n))
                  :let [u (stmt-uses (lval (nth stmts i)))
                        js (for [j (range i (dec n)) :when (some u (nth defs j))] j)]
                  :when (seq js)]
              [i (apply max js)])
        merged (reduce (fn [acc [a b]] (if (and (seq acc) (<= a (second (peek acc))))
                                         (conj (pop acc) [(first (peek acc)) (max b (second (peek acc)))])
                                         (conj acc [a b])))
                       [] (sort ivs))]
    (loop [i 0 ms merged out []]
      (cond (>= i n) out
            (and (seq ms) (= i (first (first ms))))
            (let [[a b] (first ms)] (recur (inc b) (rest ms) (conj out (list 'tc/rec (subvec stmts a (inc b))))))
            :else (recur (inc i) ms (conj out (nth stmts i)))))))

(defn- infer-stmts
  "A do block's statements in a monad: [type core]; mc a monad comprehension's (HF10-P43 (a): GHC.HsToCore.ListComp's
  dsMonadComp, as its statements desugar: the result return e, a guard qualifier guard b >> rest)"
  [env stmts & [mc]]
  (let [s (first stmts) v (lval s) more (rest stmts)
        infer-stmts (fn [env stmts] (infer-stmts env stmts mc))]
    (case (con v)
      ;; HF10-P49 (a): a transform's or a parallel block's end (mc-inner): return of its binders' tuple, the binders and
      ;; the by expression typed here, where the inner statements bound them
      tc/ret-binders (let [{:keys [ns out by]} (second v)
                           ns (filterv #(get env %) ns)
                           occs (mapv #(var-occ env %) ns)
                           ts (mapv first occs)
                           tt (if (empty? ns) (con-ty (tuple-tc 0)) (big-tup-ty ts))
                           tc (if (empty? ns) (list 'v (tuple-con 0)) (big-tup-core (mapv second occs)))
                           [tr cr] (global-occ env "return" "GHC.Internal.Base")
                           r (fresh-meta)]
                       (reset! out {:ns ns :ts ts :tt tt :vs (mapv #(or (:core (get env %)) (lv %)) ns)
                                    :by (when by (infer env by))})
                       (unify tr (fn-ty tt r))
                       [r (app* cr [tc])])
      TransStmt (if mc (mc-trans-stmt env v more infer-stmts) (do (error! "statement not handled: TransStmt") [(fresh-meta) (list 'lit "?")]))
      ParStmt (if mc (mc-par-stmt env v more infer-stmts) (do (error! "statement not handled: ParStmt") [(fresh-meta) (list 'lit "?")]))
      RecStmt (rec-stmt env (vec (lval (arg v 2))) more infer-stmts)
      tc/rec (rec-stmt env (vec (second v)) more infer-stmts)
      LastStmt (let [[te ce] (infer env (arg v 2))
                     [tr cr] (global-occ env "return" "GHC.Internal.Base")
                     r (fresh-meta)]
                 (unify tr (fn-ty te r))
                 [r (app* cr [ce])])
      BodyStmt (if (and mc (seq more))
                 (let [[te ce] (infer env (arg v 2))
                       _ (unify te (con-ty tc-bool))
                       [tg cg] (global-occ env "guard" "GHC.Internal.Control.Monad")
                       g (fresh-meta)
                       _ (unify tg (fn-ty (con-ty tc-bool) g))
                       [tr cr] (infer-stmts env more)
                       [tb cb] (global-occ env ">>" "GHC.Internal.Base")
                       r (fresh-meta)]
                   (unify tb (fn-ty g (fn-ty tr r)))
                   [r (app* cb [(app* cg [ce]) cr])])
               (if (empty? more)
                 (infer env (arg v 2))
                 (let [[te ce] (infer env (arg v 2))
                       [tr cr] (infer-stmts env more)
                       [tb cb] (global-occ env ">>" "GHC.Internal.Base")
                       r (fresh-meta)]
                   (unify tb (fn-ty te (fn-ty tr r)))
                   [r (app* cb [ce cr])])))
      BindStmt (let [[te ce] (infer env (arg v 3))
                     a (fresh-meta)
                     ;; the pattern's equalities given to the statements after it (tcDoStmt's implication)
                     [env1 pc tr cr] (binding [*given-eqs* (scope-givens)]
                                       (let [[env1 pc] (tc-pat env (arg v 2) a) [tr cr] (infer-stmts env1 more)] [env1 (strict-pat pc) tr cr]))
                     [tb cb] (global-occ env ">>=" "GHC.Internal.Base")
                     r (fresh-meta)]
                 (unify tb (fn-ty te (fn-ty (fn-ty a tr) r)))
                 ;; a pattern that can fail (the renamer attached MonadFail's fail to the statement): fail in the monad
                 ;; (queue 385: in a monad comprehension, GHC's MCompPatOrigin and matchDoContextErrString's "monad comprehension")
                 (if-let [fl (implicit-name v "fail" nil)]
                   (let [[tf cf] (var-occ env fl (lsp (arg v 2)) (if mc "a monad comprehension pattern" "a do statement")) ds (fresh-lv "ds")]
                     (note-type! ds a)
                     (unify tf (fn-ty (list-ty (con-ty tc-char)) tr))
                     [r (app* cb [ce (list 'lam [ds] (list 'match [ds] [(list 'clause [pc] cr)
                                                                        (list 'clause [(list 'pwild)] (app* cf [(fail-msg (if mc "monad comprehension" "'do' block") (lsp (arg v 2)))]))]))])])
                   [r (app* cb [ce (list 'lam [pc] cr)])]))
      LetStmt (let [[env1 binds] (tc-local-binds env (arg v 2))
                    [tr cr] (infer-stmts env1 more)]
                [tr (wrap-lets binds cr)])
      (do (error! "statement not handled: " (con v)) [(fresh-meta) (list 'lit "?")]))))

(declare infer-listcomp pat-binders tc-local-binds var-occ)

(defn- stmts-binders
  "The variables a comprehension's statements bind, in order (collectLStmtsBinders): generators' patterns, lets'
  bindings, an inner transform's binders (rebound by it)"
  [stmts]
  (vec (distinct (mapcat (fn [s] (let [v (lval s)]
                                   (case (con v)
                                     BindStmt (pat-binders (arg v 2))
                                     LetStmt (let [lb (arg v 2)]
                                               (when (= 'HsValBinds (con lb))
                                                 (mapcat (fn [b] (let [bv (lval b)]
                                                                   (case (con bv)
                                                                     FunBind [(nm (arg bv 2))]
                                                                     PatBind (pat-binders (arg bv 2))
                                                                     nil)))
                                                         (arg (arg lb 2) 2))))
                                     TransStmt (stmts-binders (arg v 3))
                                     RecStmt (stmts-binders (lval (arg v 2)))
                                     tc/rec (stmts-binders (second v))
                                     nil)))
                         stmts))))

(defn- chunkified
  "GHC.Core.Make's mkChunkified: more than mAX_TUPLE_SIZE (64) things tupled in chunks of 64, again until one tuple holds them"
  [mk xs]
  (loop [xs (vec xs)]
    (if (<= (count xs) 64)
      (if (= 1 (count xs)) (first xs) (mk xs))
      (recur (mapv #(if (= 1 (count %)) (first %) (mk (vec %))) (partition-all 64 xs))))))
(defn- big-tup-ty [ts] (chunkified (fn [xs] [:tc (tuple-tc (count xs)) xs]) ts))
(defn- big-tup-core [cs] (chunkified (fn [xs] (app* (list 'v (tuple-con (count xs))) xs)) cs))
(defn- big-tup-pat [vs] (chunkified (fn [xs] (list 'pcon (ext-name "data" "GHC.Internal.Tuple" (occ (tuple-con (count xs)))) xs)) vs))

(defn- unzip-core
  "HF10-P43 (a): GHC.HsToCore.ListComp's mkUnzipBind for a group of n > 1 binders of types ts: the function
  \\ys -> foldr (\\ax axs -> case ax of (x1..xn) -> case axs of (xs1..xsn) -> (x1:xs1, ..., xn:xsn)) ([], ..., []) ys"
  [ts]
  (let [lts (mapv list-ty ts) tt (big-tup-ty ts) ltt (big-tup-ty lts)
        ax (fresh-lv "ax") axs (fresh-lv "axs") ys (fresh-lv "ys")
        xs (mapv (fn [_] (fresh-lv "x")) ts) xss (mapv (fn [_] (fresh-lv "xs")) ts)
        cons (list 'v (ext-name "var" "GHC.Internal.Types" ":")) nil-c (list 'v (ext-name "var" "GHC.Internal.Types" "[]"))
        body (big-tup-core (mapv (fn [x xs1] (list 'app cons [x xs1])) xs xss))]
    (note-type! ax tt) (note-type! axs ltt) (note-type! ys (list-ty tt))
    (doseq [[x t] (map vector xs ts)] (note-type! x t))
    (doseq [[x t] (map vector xss lts)] (note-type! x t))
    (list 'lam [ys]
          (list 'app (list 'v (ext-name "var" "GHC.Internal.Base" "foldr"))
                [(list 'lam [ax axs]
                       (list 'match [ax] [(list 'clause [(big-tup-pat xs)]
                                                (list 'match [axs] [(list 'clause [(big-tup-pat xss)] body)]))]))
                 (big-tup-core (mapv (fn [_] nil-c) ts))
                 ys]))))

(defn- trans-stmt
  "HF10-P43 (a): a TransformListComp qualifier (then f, then f by e, then group using f, then group by e using f) as
  GHC.Tc.Gen.Match's tcLcStmt and GHC.HsToCore.ListComp's dsTransStmt make it: the inner qualifiers a comprehension
  of their binders' tuple, f (typed in the outer scope at ((a -> t) ->) [a] -> [a] (or [[a]], the group form) with a
  the tuple) applied to (\\tuple -> e and) it, a group's lists of tuples unzipped by mkUnzipBind's foldr, the result
  a generator rebinding the binders (a group's at list types) for the qualifiers after it; k is called with
  [env qualifier]"
  [env v k]
  (infer-listcomp
   env (arg v 3) nil []
   (fn [env1 iq]
     (let [ns (filterv #(get env1 %) (stmts-binders (arg v 3)))
           occs (mapv #(var-occ env1 %) ns)
           ts (mapv first occs)
           group? (= 'GroupForm (arg v 2))
           tt (if (empty? ns) (con-ty (tuple-tc 0)) (big-tup-ty ts))
           inner (list 'listcomp iq (if (empty? ns) (list 'v (tuple-con 0)) (big-tup-core (mapv second occs))))
           byx (arg v 6)
           by (when (and (seq? byx) (= 'Just (first byx))) (infer env1 (second byx)))
           [tu cu] (infer env (arg v 5))
           _ (unify tu (cond->> (fn-ty (list-ty tt) (list-ty (if group? (list-ty tt) tt)))
                         by (fn-ty (fn-ty tt (first by)))))
           by-lam (when by
                    (let [d (fresh-lv "tup")
                          vs (mapv #(or (:core (get env1 %)) (lv %)) ns)]
                      (note-type! d tt)
                      (list 'lam [d] (list 'match [d] [(list 'clause [(if (empty? ns) (list 'pwild) (big-tup-pat vs))] (second by))]))))
           applied (app* cu (if by [by-lam inner] [inner]))
           new (mapv (fn [n t] [n (fresh-lv (occ n)) (if group? (list-ty t) t)]) ns ts)
           gen-e (if (and group? (> (count ns) 1))
                   (list 'app (list 'v (ext-name "var" "GHC.Internal.Base" "map")) [(unzip-core ts) applied])
                   applied)
           pat (if (empty? ns) (list 'pwild) (big-tup-pat (mapv second new)))
           env2 (reduce (fn [e [n c t]] (note-type! c t) (assoc e n {:mono t :core c})) env new)]
       (k env2 (list 'gen pat gen-e))))))

(defn- par-stmt
  "HF10-P46 (a): a ParallelListComp qualifier (| quals1 | quals2 ...) as GHC.HsToCore.ListComp's deListComp makes it: each
  block a comprehension of its binders' tuple, typed in the scope before the qualifier (a block does not see another's
  binders), the blocks zipped (mkZipBind's zip, here GHC.Internal.List's zip nested to the right: (t1, (t2, t3))), the
  result a generator binding every block's binders for the qualifiers after it; k is called with [env qualifier]"
  [env v k]
  (let [blocks (mapv (fn [b] (let [b (lval b)] (arg b 2))) (arg v 2))
        go (fn go [i acc]
             (if (= i (count blocks))
               (let [parts (map (fn [[ns ts tt inner]]
                                  (let [new (mapv (fn [n t] [n (fresh-lv (occ n)) t]) ns ts)]
                                    {:new new :tt tt :inner inner
                                     :pat (if (empty? ns) (list 'pwild) (big-tup-pat (mapv second new)))}))
                                acc)
                     zip* (fn zip* [ps]
                            (if (= 1 (count ps))
                              (first ps)
                              (let [a (first ps) b (zip* (rest ps))]
                                {:tt [:tc (tuple-tc 2) [(:tt a) (:tt b)]]
                                 :inner (list 'app (list 'v (ext-name "var" "GHC.Internal.List" "zip")) [(:inner a) (:inner b)])
                                 :pat (list 'pcon (ext-name "data" "GHC.Internal.Tuple" (occ (tuple-con 2))) [(:pat a) (:pat b)])})))
                     z (zip* parts)
                     env2 (reduce (fn [e [n c t]] (note-type! c t) (assoc e n {:mono t :core c})) env (mapcat :new parts))]
                 (k env2 (list 'gen (:pat z) (:inner z))))
               (infer-listcomp
                env (nth blocks i) nil []
                (fn [env1 iq]
                  (let [ns (filterv #(get env1 %) (stmts-binders (nth blocks i)))
                        occs (mapv #(var-occ env1 %) ns)
                        ts (mapv first occs)]
                    (go (inc i) (conj acc [ns ts (if (empty? ns) (con-ty (tuple-tc 0)) (big-tup-ty ts))
                                           (list 'listcomp iq (if (empty? ns) (list 'v (tuple-con 0)) (big-tup-core (mapv second occs))))])))))))]
    (go 0 [])))

(defn- infer-listcomp
  "A list comprehension's qualifiers then its result: [type core], the core (listcomp [QUAL...] RESULT); et, the
  element type expected (checking mode). A generator's pattern gives its equalities to the qualifiers after it and
  the result (GHC.Tc.Gen.Match's tcLcStmt: the pattern's implication scopes over the rest). k: the qualifiers of a
  transform (no LastStmt), called with [env quals] after the last"
  [env stmts & [et quals k]]
  (let [ss stmts quals (or quals []) v (when (seq ss) (lval (first ss)))]
    (case (if (empty? ss) ::end (con v))
      ::end (k env quals)
      TransStmt (trans-stmt env v (fn [env2 q] (infer-listcomp env2 (rest ss) et (conj quals q) k)))
      ParStmt (par-stmt env v (fn [env2 q] (infer-listcomp env2 (rest ss) et (conj quals q) k)))
      LastStmt (if et
                 [(list-ty et) (list 'listcomp quals (check-expr env (arg v 2) et))]
                 (let [[t c] (infer env (arg v 2))] [(list-ty t) (list 'listcomp quals c)]))
      BindStmt (let [[te ce] (infer env (arg v 3)) a (fresh-meta)
                     _ (unify te (list-ty a))
]
                 (binding [*given-eqs* (scope-givens)]
                   (let [[env1 pc] (tc-pat env (arg v 2) a)]
                     (infer-listcomp env1 (rest ss) et (conj quals (list 'gen pc ce)) k))))
      BodyStmt (let [[t c] (infer env (arg v 2))] (unify t (con-ty tc-bool)) (infer-listcomp env (rest ss) et (conj quals c) k))
      LetStmt (let [[env1 bs] (tc-local-binds env (arg v 2))] (infer-listcomp env1 (rest ss) et (conj quals (list 'qlet bs)) k))
      (do (error! "qualifier not handled: " (con v)) [(fresh-meta) (list 'lit "?")]))))

(declare con-arg-types)

(defn- ev-args
  "HF10-P66 (a): f applied to its arguments, each argument's evidence (a polytype instantiated before it) first"
  [f evs cs]
  (reduce (fn [c [e a]] (app* (app* c e) [a])) f (map vector evs cs)))

(defn- split-fun
  "A function type's argument and result (matchExpectedFunTys: a meta split into fresh ones, a forall instantiated)"
  [t]
  (let [t (expand (prune t))]
    (cond (and (= :tc (first t)) (= fun-tc (second t))) [(first (nth t 2)) (second (nth t 2))]
          (= :forall (first t)) (let [[t2 ps] (instantiate t)] (doseq [p ps] (want! p)) (split-fun t2))
          :else (let [a (fresh-meta) r (fresh-meta)] (unify t (fn-ty a r)) [a r]))))

;; HF9 (second slice): an application as GHC.Tc.Gen.App's tcApp makes it: the spine's head inferred and instantiated,
;; its argument types split off, the result unified with the expected type first (Note [Unify with expected type
;; before typechecking arguments]), then each argument checked against its type, so a lambda argument's GADT pattern
;; (decSymbol's `Left (\Refl -> ...)`) meets the type its function gives it
(defn- tc-app
  "An application spine f a1 .. an (HsApp, or OpApp: the operator applied to its two operands): [type core]; expected
  the type to check against or nil"
  [env head args expected]
  (let [[tf cf] (binding [*ectx-nc* (boolean *defer-log*)] (infer env head)) ; (queue 369: tcInferAppHead adds no context)
        ;; HF10-P50 (a): a head of a rank-n binder's polytype (higherRank's f :: forall a. (Num a, Bounded a) => a -> a,
        ;; T17594e) instantiated with its constraints' evidence applied (tcInstFun); split-fun's instantiation dropped
        ;; the evidence
        [tf cf] (let [x (prune tf)]
                  (if (and (vector? x) (= :forall (first x)) (seq (nth x 1)) (seq (nth x 2)) (seq args))
                    (let [[t2 ps] (instantiate x)] [t2 (app* cf (mapv want! ps))])
                    [tf cf]))
        ;; HF10-P66 (a): a polytype met after some arguments (gmapQ xmlProxy (toXmlD dict) x, gmapQ's type after two
        ;; arguments forall a. Data ctx a => a -> [r]) instantiated there with its constraints' evidence applied before the
        ;; next argument (tcInstFun instantiates at each forall of the spine); split-fun's instantiation wanted them and
        ;; dropped the evidence, the arguments after it one dictionary short
        [ats r evs] (reduce (fn [[ats t evs] _]
                              (let [x (expand (prune t))]
                                (if (and (= :forall (first x)) (seq (nth x 2)))
                                  (let [[t2 ps] (instantiate x) e (mapv want! ps) [a r] (split-fun t2)] [(conj ats a) r (conj evs e)])
                                  (let [[a r] (split-fun t)] [(conj ats a) r (conj evs [])]))))
                            [[] tf []] args)
        cf0 cf
        ;; HF10-P21: a result of a qualified type, a field's (CollectExceptionAnnotationMechanism's ceaCollect... :: HasCallStack =>
        ;; IO SomeExceptionAnnotation): instantiated after the arguments, its constraints' evidence applied (tcInstFun's final
        ;; instantiation); HasCallStack's call site the occurrence's, GHC's OccurrenceOfRecSel origin "a use of `f'" for a field
        rq (let [x (expand (prune r))] (when (and (vector? x) (= :forall (first x)) (seq (nth x 2))) x))
        ;; (HF10-P66 (a): a result polytype with quantifiers too, gmapT ctx f's forall a. Data ctx a => a -> a,
        ;; instantiated, its context's evidence applied as a qualified type's)
        [r rq] (cond (nil? rq) [r nil]
                     (empty? (nth rq 1)) [(nth rq 3) rq]
                     :else (let [[t2 ps] (instantiate rq)] [t2 [:forall [] ps t2]]))
        _ (when expected (unify-ea r expected (list 'L nil head)))
        ;; HF10-P44 (a): an argument checked against a qualified type ((cls => r), withDict's, a rank-n context) after the
        ;; others, so its givens' metas are the other arguments' types first (GHC solves the implication at the end:
        ;; withGift (\_ -> foo False) (23 :: Int) Proxy's Given ?a against foo's Given Int)
        qual? (fn [at] (let [x (prune at)] (and (vector? x) (= :forall (first x)) (seq (nth x 2)))))
        later (set (keep-indexed (fn [i at] (when (qual? at) i)) ats))
        ;; (queue 369: each argument under its FunAppCtxt, at its span, checked as tcPolyExpr: no context of its own)
        chk (fn [i a at] (if *defer-log*
                           (binding [*ectx* (cons [:arg head a (inc i)] *ectx*) *espan* (or (when (L? a) (lsp a)) *espan*) *ectx-nc* true]
                             (check-expr env a at))
                           (check-expr env a at)))
        cs1 (into {} (keep-indexed (fn [i [a at]] (when-not (later i) [i (chk i a at)])) (map vector args ats)))
        cs (vec (map-indexed (fn [i [a at]] (if (later i) (chk i a at) (get cs1 i))) (map vector args ats)))]
    (if rq
      (let [n (when (= 'HsVar (con head)) (nm (arg head 2)))
            sp (when n (lsp (arg head 2)))
            label (when (and n (= "fld" (nth n 1))) (str "a use of `" (occ n) "'"))]
        [r (app* (ev-args cf0 evs cs) (mapv #(if n (want-at! % n sp label) (want! %)) (nth rq 2)))])
      [r (ev-args cf0 evs cs)])))

(declare infer check-expr super-closure assume-eqs! dict-param)

(defn- tc-patsyn-upd
  "A record update of a pattern synonym's fields (Note [Record Updates]: case e of P x1 .. xn -> $bP x1' .. xn', GHC.Tc.Gen.Expr's
  desugaring through the synonym's matcher and builder): the scrutinee at one instance of the synonym's universals, the result
  at another (a type-changing update), a field not updated the same type at both, the existentials shared"
  [env v pn {:keys [univ req ex prov args res fields]}]
  (let [[te ce] (infer env (arg v 2))
        sk (into {} (map (fn [x] [x [:tv (str x "_sk" (fresh-id))]]) ex))
        m1 (merge (zipmap univ (repeatedly fresh-meta)) sk)
        m2 (merge (zipmap univ (repeatedly fresh-meta)) sk)
        sp (fn [m [c ts]] [c (mapv #(subst m %) ts)])
        _ (unify (subst m1 res) te)
        evs (mapv #(want! (sp m1 %)) req)
        dpreds (mapv #(sp m1 %) prov)
        dvars (mapv dict-param dpreds)
        _ (when *skolem-givens*
            (swap! *skolem-givens* into (super-closure (filterv (fn [[p _]] (seq (tvs-of (zonk-pred p)))) (mapv vector dpreds dvars)))))
        _ (assume-eqs! dpreds)
        xs (mapv (fn [f a] (let [x (fresh-lv (occ f))] (note-type! x (subst m1 a)) x)) fields args)
        upd (into {} (for [fb (arg (arg v 3) 2) :let [fbv (lval fb)]] [(nm (arg (lval (arg fbv 2)) 2)) (arg fbv 3)]))
        vals (mapv (fn [f a x]
                     (if-let [e (get upd f)]
                       (check-expr env e (subst m2 a))
                       (do (unify (subst m1 a) (subst m2 a)) x)))
                   fields args xs)
        bevs (mapv #(want! (sp m2 %)) (into (vec req) prov))]
    [(subst m2 res)
     (list 'match [ce] [(list 'clause [(list 'psyn (matcher-name pn) evs dvars xs)] (app* (list 'v (builder-name pn)) (into bevs vals)))])]))

(declare infer pat-args)
(defn- th-string
  "A string literal's core as GHC.HsToCore.Quote's coreStringLit gives it (mkStringExprFS): unpackCString# of the literal,
  unpackCStringUtf8# when it is not ASCII"
  [^String x]
  (if (empty? x)
    (list 'v (ext-name "var" "GHC.Internal.Types" "[]"))
    (list 'app (list 'v (ext-name "var" "GHC.Internal.CString" (if (every? #(< 0 (int %) 128) x) "unpackCString#" "unpackCStringUtf8#")))
          [(list 'lit (str (pr-str x) "#"))])))

(defn- th-name-core
  "round 54: GHC.HsToCore.Quote's globalVar: an external Name as TH's mkNameG_d, mkNameG_v or mkNameG_tc of its unit, module
  and occurrence (string literals), or nil"
  [n]
  (when-let [f (when (ext? n) (case (nth n 1) "data" "mkNameG_d" "var" "mkNameG_v" "tc" "mkNameG_tc" nil))]
    (let [tm (nmod n)
          unit (cond (= tm *module*) *unit*
                     (get-in (some-> *iface-meta* deref) [:units tm]) (get-in @*iface-meta* [:units tm])
                     (str/starts-with? tm "GHC.Internal.") "ghc-internal" :else *unit*)
          s th-string]
      (list 'app (list 'v (ext-name "var" "GHC.Internal.TH.Syntax" f)) [(s unit) (s tm) (s (occ n))]))))

(defn- th-quote
  "round 54: an expression quote, as GHC.HsToCore.Quote's repE gives it over the Quote m dictionary: a global variable varE
  (a constructor conE) of its Name, an application appE of the parts', a parenthesis its expression's, a variable bound outside
  the quote lifted (GHC.Rename.Splice's checkCrossStageLifting: lift x, in a typed quote unTypeCode (liftTyped x)); a typed quote
  [|| e ||] :: Code m t, e :: t, is unsafeCodeCoerce of the expression's quote. The types are TH.Lift's lift's and liftTyped's
  (the Lift class in scope); queue 381 (n-all4's merge, one implementation): a pattern quote [p| p |] (pat?) of type m Pat,
  as repP gives it: a parenthesis its pattern's, a view pattern viewP of the expression's and the pattern's quotes, a
  constructor pattern of no argument conP NAME [] [] (os-string's and filepath's QuasiQuoters); anything else in the quote is
  not handled: [type core]"
  [env e typed? & [pat?]]
  (let [lib (fn [o] (list 'v (ext-name "var" "GHC.Internal.TH.Lib" o)))
        syn (fn [o] (list 'v (ext-name "var" "GHC.Internal.TH.Syntax" o)))
        lift-n (ext-name "var" "GHC.Internal.TH.Lift" "lift") lt-n (ext-name "var" "GHC.Internal.TH.Lift" "liftTyped")
        lf (get @*genv* lift-n) lt (get @*genv* lt-n)]
    (if-not (and lf lt)
      (do (error! "expression not handled: " (if typed? "HsTypedBracket" "HsUntypedBracket") " (no TH.Lift in scope)") [(fresh-meta) (list 'lit "?")])
      (let [m (fresh-meta)
            ;; lift :: forall t. Lift t => forall m. Quote m => t -> m Exp: the Quote class, m Exp
            [lft lps] (instantiate lf)
            qp (some (fn [[c ts]] (when (= "Quote" (occ c)) [c ts])) lps)
            lift-cls (some (fn [[c _]] (when (= "Lift" (occ c)) c)) lps)
            _ (unify (first (second qp)) m)
            mexp (second (nth (expand lft) 2))
            qd (fn [] (want! [(first qp) [m]]))
            bad (atom nil)
            rep (fn rep [x]
                  (let [xv (lval x)]
                    (case (con xv)
                      HsPar (rep (arg xv 2))
                      HsApp (list 'app (lib "appE") [(qd) (rep (arg xv 2)) (rep (arg xv 3))])
                      HsVar (let [n (nm (arg xv 2)) nc (th-name-core n) u (when-not n (lval (arg xv 2)))]
                              (cond
                                nc
                                (list 'app (lib (if (= "data" (nth n 1)) "conE" "varE")) [(qd) nc])
                                ;; (queue 388: a variable out of scope in an untyped quote is a hole, the renamer's HoleVar:
                                ;; repE's repUnboundVar, unboundVarE of mkNameS OCC (repRdrName's Unqual); os-string's
                                ;; Common.hs, whose Prelude import leaves out (==), [p|((==) osp' -> True)|])
                                (and (not typed?) (seq? u) (= 'unqual (first u)) (= 'var (second u)) (string? (nth u 2)))
                                (list 'app (lib "unboundVarE") [(qd) (list 'app (syn "mkNameS") [(th-string (nth u 2))])])
                                :else
                                (let [[tx cx] (infer env x) dl (want! [lift-cls [tx]])]
                                  (if typed?
                                    (list 'app (syn "unTypeCode") [(qd) (list 'app (list 'v lt-n) [dl (qd) cx])])
                                    (list 'app (list 'v lift-n) [dl (qd) cx])))))
                      (do (reset! bad (con xv)) (list 'lit "?")))))
            nil-c (list 'v (ext-name "data" "GHC.Internal.Types" "[]"))
            rep-p (fn rep-p [x]
                    (let [xv (lval x)]
                      (case (con xv)
                        ParPat (rep-p (arg xv 2))
                        ViewPat (list 'app (lib "viewP") [(qd) (rep (arg xv 2)) (rep-p (arg xv 3))])
                        ConPat (let [n (nm (arg xv 2)) d (arg xv 3)
                                     nc (when (and n (= 'PrefixCon (con d)) (empty? (pat-args d))) (th-name-core n))]
                                 (if nc
                                   (list 'app (lib "conP") [(qd) nc nil-c nil-c])
                                   (do (reset! bad (con xv)) (list 'lit "?"))))
                        (do (reset! bad (con xv)) (list 'lit "?")))))
            core (if pat? (rep-p e) (rep e))]
        (when @bad (error! "expression not handled: " (if typed? "HsTypedBracket" "HsUntypedBracket") " of " @bad))
        (if-not typed?
          [(if pat? (mk-app m (con-ty (ext-name "tc" "GHC.Internal.TH.Syntax" "Pat"))) mexp) core]
          ;; the quoted expression's type (its own constraints not wanted: the quote is not run here)
          (let [[t _] (binding [*wanteds* (atom [])] (infer env e))
                [ltt ltps] (instantiate lt)
                [lta ltr] (let [x (expand ltt)] [(first (nth x 2)) (second (nth x 2))])
                qp2 (some (fn [[c ts]] (when (= "Quote" (occ c)) ts)) ltps)]
            (unify lta t) (unify (first qp2) m)
            [ltr (list 'app (syn "unsafeCodeCoerce") [(qd) core])]))))))

(defn- app-spine [v]
  (loop [x v args ()] (if (= 'HsApp (con x)) (recur (lval (arg x 2)) (cons (arg x 3) args)) [x (vec args)])))

(declare infer*)

(defn infer
  "An expression's type and core"
  [env e]
  (with-ectx e #(infer* env e)))

(defn- infer*
  [env e]
  (let [v (lval e)]
    (case (con v)
      HsVar (if-let [n (nm (arg v 2))]
              ;; HF10-P54 (a): [] is an ExplicitList (GHC.Rename.Expr's rnExpr of nilDataConName, Note [Empty lists])
              (if (and (= n (ext-name "data" "GHC.Internal.Types" "[]")) (ovl-lists?))
                (ovl-list env [(list-ty (fresh-meta)) (list 'v n)] 0)
                (var-occ env n (lsp (arg v 2))))
              (do (error! "unrenamed variable: " (pr-str (lval (arg v 2)))) [(fresh-meta) (list 'lit "?")]))
      HsApp (let [[h args] (app-spine v)] (tc-app env h args nil))
      OpApp (tc-app env (arg v 3) [(arg v 2) (arg v 4)] nil)
      NegApp (let [[t c] (infer env (arg v 2))
                   [tn cn] (var-occ env (ext-name "var" "GHC.Internal.Num" "negate"))
                   r (fresh-meta)]
               (unify tn (fn-ty t r))
               [r (app* cn [c])])
      HsPar (infer env (arg v 2))
      HsPragE (infer env (arg v 3))
      HsOverLit (overlit v)
      HsLit (if (ovl-string? v) (ovl-string v) (hslit v))
      ;; HF10-P54 (a): PostfixOperators' left section (e op) is op e (GHC.Tc.Gen.Expr's SectionL, its postfix_ops)
      SectionL (if (contains? *exts* "PostfixOperators")
                 (tc-app env (arg v 3) [(arg v 2)] nil)
                 (let [[te ce] (infer env (arg v 2)) [to co] (infer env (arg v 3)) b (fresh-meta) r (fresh-meta) y (fresh-lv "y")]
                   (unify to (fn-ty te (fn-ty b r)))
                   ;; queue 352: GHC's renamer makes a left section leftSection (op e), eta-expanded (Note [Left and right
                   ;; sections]: (True `undefined`) `seq` () is ()), as the right section's rightSection
                   [(fn-ty b r) (if *abs-binds*
                                  (app* (list 'v (ext-name "var" "GHC.Internal.Types" "leftSection")) [(app* co [ce])])
                                  (list 'lam [y] (app* co [ce y])))]))
      SectionR (let [[to co] (infer env (arg v 2)) [te ce] (infer env (arg v 3)) a (fresh-meta) r (fresh-meta)
                     x (fresh-lv "x")]
                 (unify to (fn-ty a (fn-ty te r)))
                 ;; GHC's renamer makes a right section rightSection op e (the simple optimiser inlines its
                 ;; compulsory unfolding, op and e let-bound outside the lambda): so for the -O0 Simplifier's input
                 [(fn-ty a r) (if *abs-binds*
                                (app* (list 'v (ext-name "var" "GHC.Internal.Types" "rightSection")) [co ce])
                                (list 'lam [x] (app* co [x ce])))])
      HsLam (binding [*match-span* (lsp e)] (infer-matches env (arg v 3) nil))
      HsCase (let [[ts cs] (infer env (arg v 2))
                   r (fresh-meta)
                   [t c] (binding [*match-span* (lsp e)] (infer-matches env (arg v 3) {:scrut [ts cs] :res r}))]
               [t c])
      HsIf (let [[tc cc] (infer env (arg v 2)) [tt ct] (infer env (arg v 3)) [te ce] (infer env (arg v 4))]
             (unify tc (con-ty tc-bool)) (unify tt te)
             [tt (list 'case cc (fresh-lv "wild") [(list 'alt (ext-name "data" "GHC.Internal.Types" "False") [] ce)
                                                   (list 'alt (ext-name "data" "GHC.Internal.Types" "True") [] ct)])])
      HsLet (let [sb (atom [])
                  [env1 binds] (binding [*strict-binds* {:atom sb :level (inc *level*)}] (tc-local-binds env (arg v 2)))
                  [t c] (with-ips env1 (infer env1 (arg v 3)))
                  ;; the banged pattern bindings' matches around the body, innermost last
                  c (force-strict-binds c @sb)]
              [t (wrap-lets binds c)])
      HsDo (let [fl (arg v 2)]
             (case (if (seq? fl) (first fl) fl)
               DoExpr (infer-stmts env (lval (arg v 3)))
               ;; HF10-P50 (a): mdo, its recursive segments recs
               MDoExpr (infer-stmts env (mdo-segments (lval (arg v 3))))
               ListComp (infer-listcomp env (lval (arg v 3)))
               MonadComp (infer-stmts env (lval (arg v 3)) true)
               (do (error! "do flavour not handled: " (pr-str fl)) [(fresh-meta) (list 'lit "?")])))
      ExplicitList (let [a (fresh-meta)
                         cs (mapv (fn [x] (let [[t c] (infer env x)] (unify t a) c)) (arg v 2))
                         l [(list-ty a) (reduce (fn [tl x] (list 'app (list 'v (ext-name "var" "GHC.Internal.Types" ":")) [x tl]))
                                                (list 'v (ext-name "var" "GHC.Internal.Types" "[]")) (reverse cs))]]
                     (ovl-list env l (count cs)))
      ;; HF10-P54 (a): TupleSections' missing components (GHC.Tc.Gen.Expr's ExplicitTuple, GHC.HsToCore.Expr's
      ;; dsExplicitTuple): a lambda of a fresh variable each, the tuple inside
      ExplicitTuple (let [rs (mapv (fn [p] (let [pv (lval p)]
                                             (if (= 'Missing (con pv))
                                               (let [t (fresh-meta) x (fresh-lv "ds")] (note-type! x t) [t x :missing])
                                               (infer env (arg pv 2)))))
                                   (arg v 2))
                          lams (vec (keep (fn [[t x m]] (when m [t x])) rs))
                          [tt tc] (if (= 'Unboxed (arg v 3))
                                    [[:tc (utuple-tc (count rs)) (mapv first rs)]
                                     (app* (list 'v (unboxed-con (count rs))) (mapv second rs))]
                                    [[:tc (tuple-tc (count rs)) (mapv first rs)] (app* (list 'v (tuple-con (count rs))) (mapv second rs))])]
                      (if (seq lams)
                        [(reduce (fn [r [t _]] (fn-ty t r)) tt (reverse lams)) (list 'lam (mapv second lams) tc)]
                        [tt tc]))
      ;; HF10-P43 (a): StaticPointers (GHC.Tc.Gen.Expr's HsStatic, GHC.HsToCore.Expr's makeStatic, GHC.Iface.Tidy.StaticPtrTable's
      ;; sptCreateStaticBinds): static e is fromStaticPtr (IsStatic p, Typeable t) of a StaticPtr of e's type t, its key
      ;; mkStaticPtrFingerprint's, its info the body's position (static-ptr!)
      HsStatic (let [[t c] (infer env (arg v 2))
                     [tf cf] (global-occ env "fromStaticPtr" "GHC.Internal.StaticPtr")
                     r (fresh-meta)]
                 (unify tf (fn-ty [:tc (ext-name "tc" "GHC.Internal.StaticPtr" "StaticPtr") [t]] r))
                 [r (app* cf [(static-ptr! env (arg v 2) c)])])
      ;; ImplicitParams (GHC.Tc.Gen.Expr's HsIPVar): ?x wants IP "x" t, its value the dictionary's ip
      HsIPVar (let [t (fresh-meta) ev (want! [cls-ip [[:lit (second (arg v 2))] t]])]
                [t (list 'app (list 'v (ext-name "var" "GHC.Internal.Classes" "ip")) [ev])])
      ;; MultiWayIf (GHC.Tc.Gen.Expr's HsMultiIf): its alternatives as a right-hand side's guards
      ;; (queue 352: its failure nonExhaustiveGuardsError "SPAN|multi-way if", dsExpr's HsMultiIf)
      HsMultiIf (let [r (fresh-meta)]
                  [r (tag-guards (infer-grhss env (list 'GRHSs nil (arg v 2) (list 'EmptyLocalBinds 'NoExtField)) r)
                                 (when (lsp e) [(str (span-text (lsp e)) "|multi-way if") true]))])
      ;; TypeApplications (GHC.Tc.Gen.App's tcApp: a type argument instantiates the next specified quantifier): the
      ;; head's type with its quantifiers taken by the type arguments in order, an erased kind's quantifier (not in
      ;; the body) skipped as GHC's inferred ones are; a local or unknown head ignores them
      HsAppType (let [[h tas] (loop [x v tas []]
                                (if (= 'HsAppType (con x)) (recur (lval (arg x 2)) (cons (arg (arg x 3) 2) tas)) [x (vec tas)]))
                      n (when (= 'HsVar (con h)) (nm (arg h 2)))
                      ;; a binder of this module with a signature has specified quantifiers too (unsafeEqualityProof's
                      ;; own recursive @a @b); an inferred binder's are not (GHC's InferredSpec)
                      le (when n (get env n))
                      sigma (cond (nil? n) nil
                                  (nil? le) (get @*genv* n)
                                  (:sig le) (:poly le)
                                  ;; HF10-P44 (a): a lambda-bound binder of a rank-n type (reify's k :: forall s. Reifies s a
                                  ;; => Proxy s -> r): its specified quantifiers taken by the type arguments (k @Any)
                                  (:mono le) (let [mt (prune (:mono le))] (when (and (vector? mt) (= :forall (first mt)) (seq (nth mt 1))) mt)))
                      le (if (and le (:mono le) (not (:core le))) (do (note-type! (lv n) (:mono le)) (assoc le :core (lv n))) le)]
                  (if (and sigma (= :forall (first sigma)))
                    (let [occurs (fn [x t] (contains? (set (keep (fn [y] (when (and (vector? y) (= :tv (first y))) (second y))) (tree-seq coll? seq t))) x))
                          [t preds] (loop [t sigma tas tas m {} preds []]
                                      (if (and (seq tas) (= :forall (first t)))
                                        (let [vs (nth t 1) body [:forall [] (nth t 2) (nth t 3)]
                                              [m vs-left tas] (loop [vs vs m m tas tas left []]
                                                                (cond (empty? vs) [m left tas]
                                                                      (empty? tas) [m (into left vs) tas]
                                                                      (not (occurs (first vs) body)) (recur (rest vs) (assoc m (first vs) (fresh-meta)) tas left)
                                                                      :else (recur (rest vs) (assoc m (first vs) (hs-type {} (first tas))) (rest tas) left)))
                                              ms (into m (map (fn [x] [x (fresh-meta)]) vs-left))
                                              ps (mapv (fn [[c ts]] [c (mapv #(subst ms %) ts)]) (nth t 2))]
                                          (recur (subst ms (nth t 3)) tas ms (into preds ps)))
                                        (let [[t2 p2] (instantiate t)] [t2 (into preds p2)])))
                          core (or (:core le) (list 'v (if (= "data" (nth n 1)) (ext-name "var" (nmod n) (occ n)) n)))]
                      [t (app* core (mapv #(if le (want! %) (want-at! % n (lsp (arg h 2)))) preds))])
                    (infer env (arg v 2))))
      ;; UnboxedSums (GHC.Tc.Gen.Expr's ExplicitSum): alternative alt of arity n, the other components fresh
      ExplicitSum (let [alt (arg v 2) n (arg v 3) [t c] (infer env (arg v 4))
                        ts (assoc (mapv (fn [_] (fresh-meta)) (range n)) (dec alt) t)]
                    [[:tc (usum-tc n) ts] (app* (list 'v (usum-con alt n)) [c])])
      ArithSeq (let [info (arg v 3)
                     [fname xs] (case (con info)
                                  From ["enumFrom" [(arg info 1)]]
                                  FromThen ["enumFromThen" [(arg info 1) (arg info 2)]]
                                  FromTo ["enumFromTo" [(arg info 1) (arg info 2)]]
                                  FromThenTo ["enumFromThenTo" [(arg info 1) (arg info 2) (arg info 3)]])
                     [tf cf] (var-occ env (ext-name "var" "GHC.Internal.Enum" fname))
                     rs (mapv #(infer env %) xs)
                     r (fresh-meta)]
                 (unify tf (reduce (fn [acc [t _]] (fn-ty t acc)) r (reverse rs)))
                 [r (app* cf (mapv second rs))])
      RecordCon (let [cn (nm (arg v 2))
                      ;; the constructor's context (an existential's class constraints: Handle__'s RawIO, IODevice,
                      ;; BufferedIO, Typeable) wanted, its evidence the first arguments (HF10-P20: the record
                      ;; construction built Handle__ without its four dictionaries)
                      [ct cpreds] (instantiate (get @*genv* cn))
                      ;; HF10-P36 (a): a record pattern synonym's construction is its builder applied to the fields in order
                      ps (some-> *patsyns* deref (get cn))
                      flds (if ps (:fields ps) (:fields (get @*cons* cn)))
                      [argts res] (loop [t ct as []] (let [t (prune t)] (if (and (= :tc (first t)) (= fun-tc (second t))) (recur (second (nth t 2)) (conj as (first (nth t 2)))) [as t])))
                      ;; HF10-P21: each field checked against its type (tcRecordBinds' tcCheckPolyExprNC): a field of a
                      ;; qualified type (ceaCollectExceptionAnnotationMechanism :: HasCallStack => IO ...) abstracts its
                      ;; evidence, as the constructor applied positionally does
                      given (into {} (map (fn [fb] (let [fbv (lval fb) f (nm (arg (lval (arg fbv 2)) 2))
                                                         i (.indexOf ^java.util.List flds f)
                                                         c (if (>= i 0)
                                                             (check-expr env (arg fbv 3) (nth argts i))
                                                             (second (infer env (arg fbv 3))))]
                                                     [f c]))
                                      (arg (arg v 3) 2)))
                      ;; RecordWildCards (C {..}): each field the renamer filled from the variable of its name in scope
                      dd (arg (arg v 3) 3)
                      given (if (and (seq? dd) (= 'Just (first dd)) (seq? (lval (second dd))) (= 'rn/dotdot (first (lval (second dd)))))
                              (reduce (fn [g [f x]]
                                        (if (contains? g f)
                                          g
                                          (let [[t c] (var-occ env x) i (.indexOf ^java.util.List flds f)]
                                            (when (>= i 0) (unify t (nth argts i)))
                                            (assoc g f c))))
                                      given (partition 2 (nth (lval (second dd)) 2)))
                              given)]
                  [res (app* (list 'v (if ps (builder-name cn) (ext-name "var" (nmod cn) (occ cn))))
                             (into (mapv want! cpreds)
                                   (mapv (fn [f] (or (get given f) (list 'app (list 'v (ext-name "var" "GHC.Internal.Control.Exception.Base" "recConError")) [(list 'lit (occ f))]))) flds)))])
      RecordUpd (if-let [[pn ps] (let [fs (mapv (fn [fb] (nm (arg (lval (arg (lval fb) 2)) 2))) (arg (arg v 3) 2))]
                                   (when (seq fs)
                                     (some (fn [[pn ps]] (when (and (seq (:fields ps)) (every? (set (:fields ps)) fs)) [pn ps]))
                                           (some-> *patsyns* deref))))]
                  (tc-patsyn-upd env v pn ps)
                (let [[te ce] (infer env (arg v 2))
                      fbs (arg (arg v 3) 2)
                      upd (mapv (fn [fb] (let [fbv (lval fb) f (nm (arg (lval (arg fbv 2)) 2))
                                               [t c] (infer env (arg fbv 3))
                                               [st _] (instantiate (get @*genv* f))]
                                           (unify st (fn-ty te t))
                                           [f c]))
                                fbs)
                      cons* (filter (fn [[_ info]] (every? (set (:fields info)) (map first upd))) @*cons*)]
                  [te (list 'case ce (fresh-lv "wild")
                            (mapv (fn [[cn info]]
                                    (let [xs (mapv (fn [f] (fresh-lv (occ f))) (:fields info))
                                          ;; the constructor's context's evidence bound by the alternative and given back
                                          ;; to the new value (HF10-P20: an existential's dictionaries, Handle__'s)
                                          ds (mapv (fn [[c _]] (fresh-lv (str "$d" (occ c)))) (second (instantiate (get @*genv* cn))))
                                          m (into {} upd)]
                                      (list 'alt cn (into ds xs) (app* (list 'v (ext-name "var" (nmod cn) (occ cn)))
                                                                       (into ds (mapv (fn [f x] (get m f x)) (:fields info) xs))))))
                                  cons*))]))
      ;; deriving's nodes (arbace.repr.haskell.deriv): a constructor's tag as an Int, the constructor of a tag, a primop on Ints
      ;; the tag: GHC's dataToTag# (the primop dataToTagLarge#, which evaluates its argument), boxed as the Int the
      ;; generated code compares; the constructor of a tag: a case on the tag's literals (GHC's tagToEnum#)
      ;; untag_Expr's dataToTag# x, an Int#: the DataToTag dictionary at x's type (matchDataToTag: dataToTagSmall# for a
      ;; family of at most 7 constructors, else dataToTagLarge#)
      DerivTag (let [[t c] (infer env (arg v 1))
                     t (expand (zonk t))
                     ti (when (= :tc (first t)) (some-> *tycons* deref (get (second t))))
                     op (if (and ti (<= (count (:cons ti)) 7)) "dataToTagSmall#" "dataToTagLarge#")]
                 [(prim-ty "Int#") (list 'app (list 'v (ext-name "var" "GHC.Internal.Prim" op)) [c])])
      DerivTag2Con (let [[t c] (infer env (arg v 2))
                         cs (arg v 1)
                         [_ res] (con-arg-types (first cs))
                         i (fresh-lv "tag") w (fresh-lv "wild")]
                     (unify t (con-ty tc-int))
                     [res (list 'case c (fresh-lv "wild")
                                [(list 'alt (ext-name "data" "GHC.Internal.Types" "I#") [i]
                                       (list 'case i w (vec (concat [(list 'alt :default [] (list 'v (ext-name "var" (nmod (last cs)) (occ (last cs)))))]
                                                                    (map-indexed (fn [k cn] (list 'alt (list 'lit (str k "#")) [] (list 'v (ext-name "var" (nmod cn) (occ cn)))))
                                                                                 (butlast cs))))))])])
      ;; a primop comparison of unlifted fields (deriving's genPrimOpApp): tagToEnum# (x op y) at Bool
      DerivPrimCmp (let [[tx cx] (infer env (arg v 2)) [ty cy] (infer env (arg v 3))]
                     (unify tx ty)
                     [(con-ty tc-bool) (list 'app (list 'v (ext-name "var" "GHC.Internal.Prim" "tagToEnum#"))
                                             [(list 'app (list 'v (ext-name "var" "GHC.Internal.Prim" (arg v 1))) [cx cy])])])
      ;; a primop on the untagged Int#s (eq_expr_with_tag_check's /=#, enum_index's -#)
      DerivPrim (let [rs (mapv #(infer env %) (arg v 2))]
                  (doseq [[t _] rs] (unify t (prim-ty "Int#")))
                  [(prim-ty "Int#") (list 'app (list 'v (ext-name "var" "GHC.Internal.Prim" (arg v 1))) (mapv second rs))])
      ;; e :: sig (GHC.Tc.Gen.Expr's tcExprSig): e checked against the signature (its quantifiers skolems, its
      ;; context given), then the signature instantiated at the use
      ExprWithTySig (let [sig (arg (arg v 3) 2)
                          sigt (sig-type sig)
                          c (check-expr env (arg v 2) (if (or (seq (nth sigt 1)) (seq (nth sigt 2))) sigt (nth sigt 3)))
                          [st preds] (instantiate sigt)]
                      [st (app* c (mapv want! preds))])
      ;; round 54: TemplateHaskellQuotes' name quotes 'f and ''T (VarBr) of an external name: GHC.HsToCore.Quote's
      ;; globalVar, mkNameG_d, mkNameG_v or mkNameG_tc applied to the name's unit, module and occurrence as strings, of
      ;; type Name (TH.Syntax's trueName = 'True). The other brackets ([| e |], [d| ... |], ...) are not handled
      ;; round 54: an expression quote (TemplateHaskellQuotes' [| e |], typed [|| e ||]) of variables, constructors and
      ;; applications (th-quote)
      HsTypedBracket (th-quote env (arg v 2) true)
      HsUntypedBracket (let [q (lval (arg v 2)) n (when (= 'VarBr (con q)) (nm (arg q 3)))
                             nc (when n (th-name-core n))]
                         (cond
                           (= 'ExpBr (con q)) (th-quote env (arg q 2) false)
                           (= 'PatBr (con q)) (th-quote env (arg q 2) false true)
                           nc [(con-ty (ext-name "tc" "GHC.Internal.TH.Syntax" "Name")) nc]
                           :else
                           (do (error! "expression not handled: " (con v) (if n (str " " (pr-str n)) (str " " (con q))))
                               [(fresh-meta) (list 'lit "?")])))
      (do (error! "expression not handled: " (con v)) [(fresh-meta) (list 'lit "?")]))))

;; HF9 (second slice): checking mode, GHC.Tc.Gen.Expr's tcExpr against a Check ExpType. The expected type is pushed
;; into a case's alternatives, an if's branches, a let's body, a multi-way if's and a lambda's right-hand sides, as
;; GHC does before it infers: inside a GADT alternative the result is then compared under the alternative's given
;; equalities (cmpSymbol's `case unsafeCoerce Refl :: (a :~: b) of Refl -> EQI` against OrderingI a b), where the
;; inferred type, unified only after the alternative, would meet the outer type without them. Every other expression
;; is inferred and its type unified with the expected one (tcWrapResult)
(declare check-poly lit-core)

(declare check-expr*)

(defn check-expr
  "An expression checked against type t: core"
  [env e t]
  (with-ectx e #(check-expr* env e t)))

(defn- check-expr*
  [env e t]
  (let [v (lval e) tp (prune t)]
    (if (and (= :forall (first tp)) (or (seq (nth tp 1)) (seq (nth tp 2))))
      (check-poly env e tp)
    (case (con v)
      HsPar (binding [*ectx-nc* true] (check-expr env (arg v 2) t))
      HsPragE (check-expr env (arg v 3) t)
      ;; GHC.Tc.Utils.TcMType's tcShortCutLit (Note [Short cut for overloaded literals]): checked against Int, Word or
      ;; Integer (an integral literal), Float or Double (either), not under RebindableSyntax, the literal is built at its
      ;; type with no Num or Fractional wanted (GHC.Internal.Bignum.Integer's literals need no Num Integer, which
      ;; GHC.Internal.Num defines above it)
      HsOverLit (let [ol (arg v 2) val (arg ol 2)
                      tn (let [x (expand (zonk tp))] (when (= :tc (first x)) (second x)))
                      rebindable? (some (fn [x] (and (seq? x) (= 'rn/implicit (first x)))) ol)
                      int? (= 'HsIntegral (con val))
                      tc-word (ext-name "tc" "GHC.Internal.Types" "Word")]
                  (cond
                    (or rebindable? (nil? tn)) (let [[t1 c] (overlit v)] (unify t1 t) c)
                    (and int? (= tn tc-word))
                    (list 'app (list 'v (ext-name "var" "GHC.Internal.Types" "W#")) [(list 'lit (str (nth (arg val 1) 3) "##"))])
                    (and int? (contains? #{tc-int tc-integer tc-float tc-double} tn))
                    (lit-core :int (nth (arg val 1) 3) tp nil nil)
                    (and (not int?) (contains? #{tc-float tc-double} tn) (= 'HsFractional (con val))
                         (let [e (nth (arg val 1) 4 0)] (and (number? e) (<= -100 e 100))))
                    (lit-core :frac (arg val 1) tp nil nil)
                    :else (let [[t1 c] (overlit v)] (unify t1 t) c)))
      HsApp (let [[h args] (app-spine v)] (second (tc-app env h args t)))
      OpApp (second (tc-app env (arg v 3) [(arg v 2) (arg v 4)] t))
      HsCase (let [[ts cs] (infer env (arg v 2))]
               (second (binding [*match-span* (lsp e)] (infer-matches env (arg v 3) {:scrut [ts cs] :res t}))))
      HsIf (let [[tc cc] (infer env (arg v 2))
                 _ (unify tc (con-ty tc-bool))
                 ct (check-expr env (arg v 3) t)
                 ce (check-expr env (arg v 4) t)]
             (list 'case cc (fresh-lv "wild") [(list 'alt (ext-name "data" "GHC.Internal.Types" "False") [] ce)
                                                (list 'alt (ext-name "data" "GHC.Internal.Types" "True") [] ct)]))
      HsLet (let [sb (atom [])
                  [env1 binds] (binding [*strict-binds* {:atom sb :level (inc *level*)}] (tc-local-binds env (arg v 2)))
                  c (with-ips env1 (check-expr env1 (arg v 3) t))
                  c (force-strict-binds c @sb)]
              (wrap-lets binds c))
      HsMultiIf (tag-guards (infer-grhss env (list 'GRHSs nil (arg v 2) (list 'EmptyLocalBinds 'NoExtField)) t)
                            (when (lsp e) [(str (span-text (lsp e)) "|multi-way if") true]))
      HsLam (let [[t1 c] (binding [*match-span* (lsp e)] (infer-matches env (arg v 3) nil t))] (unify t1 t) c)
      HsDo (let [fl (arg v 2)]
             (if (= 'ListComp (if (seq? fl) (first fl) fl))
               (let [et (fresh-meta)]
                 (unify (list-ty et) t)
                 (second (infer-listcomp env (lval (arg v 3)) et)))
               (let [[t1 c] (infer env e)] (unify t1 t) c)))
      (let [[t1 c] (infer env e)] (unify-ea t1 t (when (= 'HsVar (con v)) e)) c)))))

;; a polytype expected (an argument of type KnownNat n => r, forall s. ST s a): GHC.Tc.Utils.Unify's tcSkolemise, the
;; quantifiers skolems, the context given (its dictionaries the core's parameters), the expression checked at the
;; body, its wanteds solved by the givens
(declare ip-pat-env)

(defn- strip-invis
  "HF10-P50 (a): a lambda checked against a polytype whose leading patterns are TypeAbstractions' @a (GHC.Tc.Gen.Match's
  tcMatchPats of InvisPat: each binds the next specified quantifier's skolem): [the lambda without them, {tv-key skolem}]"
  [e qs sk]
  (let [rebuild (fn [x i y] (apply list (assoc (vec x) i y)))
        v (lval e)]
    (case (con v)
      HsPar (let [[e2 m] (strip-invis (arg v 2) qs sk)] [(if (L? e) (rebuild e 2 (rebuild v 2 e2)) (rebuild v 2 e2)) m])
      HsLam (let [mg (arg v 3) ml (arg mg 2) ms (lval ml)]
              (if (not= 1 (count ms))
                [e {}]
                (let [m (first ms) mv (lval m) pl (arg mv 3) ps (vec (lval pl))
                      inv (vec (take-while #(= 'InvisPat (con (lval %))) ps))
                      names (mapv (fn [p] (let [ty (lval (arg (arg (lval p) 2) 2))]
                                            (when (= 'HsTyVar (con ty)) (nm (arg ty 3)))))
                                  inv)]
                  (if (or (empty? inv) (some nil? names) (> (count inv) (count qs)))
                    [e {}]
                    (let [pl2 (if (L? pl) (rebuild pl 2 (vec (drop (count inv) ps))) (vec (drop (count inv) ps)))
                          mv2 (rebuild mv 3 pl2) m2 (if (L? m) (rebuild m 2 mv2) mv2)
                          ml2 (if (L? ml) (rebuild ml 2 [m2]) [m2])
                          v2 (rebuild v 3 (rebuild mg 2 ml2))]
                      [(if (L? e) (rebuild e 2 v2) v2)
                       (into {} (map (fn [n q] [(tv-key n) (get sk q)]) names qs))])))))
      [e {}])))

(defn- check-poly [env e t]
  (let [sk (into {} (map (fn [x] [x [:tv (str x "_sk" (fresh-id))]]) (nth t 1)))
        [e invis] (strip-invis e (nth t 1) sk)
        preds (mapv (fn [[c ts]] (zonk-pred [c (mapv #(subst sk %) ts)])) (nth t 2))
        params (mapv dict-param preds)
        givens (super-closure (mapv vector preds params))
        ws (atom [])
        ;; HF10-P21: the implicit parameters it gives (HasCallStack, HasExceptionContext, ?x) are the innermost, ahead of an
        ;; enclosing let ?x (errorCallWithCallStackException's `withFrozenCallStack $ toExceptionWithBacktrace ...` under
        ;; `where ?callStack = stk`: the argument's frozen stack, not stk, else error's backtrace showed the internal frames)
        ;; (HF10-P48 (a): the implicit parameters its givens' superclasses give too, IdCt (?ipInt :: Int)'s, innermost:
        ;; GHC's given IP shadows an enclosing let ?ipInt, Note [Shadowing of implicit parameters])
        env (ip-pat-env env (map first givens) (map second givens))
        c (binding [*wanteds* ws *given-eqs* (scope-givens)]
            (assume-eqs! preds)
            (let [c (binding [*scoped-tvs* (merge *scoped-tvs* invis)] (with-ips env (check-expr env e (subst sk (nth t 3)))))]
              (retry-implications! false) c))]
    (solve-with-givens! @ws givens)
    (if (empty? params) c (list 'lam params c))))

;;; ------------------------------------------------------------------------------------------
;;; Patterns: [env' core-pattern]

(defn- pat-args [details]
  (case (con details)
    PrefixCon (let [x (last (rest details))] (if (vector? x) x []))
    InfixCon [(arg details 1) (arg details 2)]
    RecCon []
    []))

(defn- con-arg-types
  "A constructor's argument types and result, instantiated"
  [cn]
  (let [[ity _] (instantiate (or (get @*genv* cn) (fresh-meta)))]
    (loop [t ity as []]
      (let [t (expand (prune t))]
        (if (and (= :tc (first t)) (= fun-tc (second t)))
          (recur (second (nth t 2)) (conj as (first (nth t 2))))
          [as t])))))

(declare tc-con-pat)

(defn- tc-rec-pat
  "A record pattern C {f = p, f, ..}: the fields matched by name, a pun's variable and a wildcard's at the field's type;
  as the positional pattern of its fields in order (GHC.Tc.Gen.Pat's tcConArgs on RecCon), so an existential's or a
  GADT's record (IO's Handle__ with its IODevice dev context) binds its skolems and dictionaries as a prefix one does"
  [env v t]
  (let [cn (nm (arg v 2)) rf (arg (arg v 3) 1)
        flds (:fields (get @*cons* cn))
        vp (fn [x] (list 'L nil (list 'VarPat nil (list 'L nil (list 'rn/name x)))))
        given (reduce (fn [m fb]
                        (let [fbv (lval fb) lbl (lval (arg (lval (arg fbv 2)) 2))
                              [f x] (if (= 'rn/names (first lbl)) (second lbl) [(second lbl) nil])]
                          (assoc m f (if (true? (arg fbv 4)) (vp x) (arg fbv 3)))))
                      {} (arg rf 2))
        dd (arg rf 3)
        given (if (and (seq? dd) (= 'Just (first dd)) (seq? (lval (second dd))) (= 'rn/dotdot (first (lval (second dd)))))
                (reduce (fn [m [f x]] (if (contains? m f) m (assoc m f (vp x)))) given (partition 2 (nth (lval (second dd)) 2)))
                given)
        wild (list 'L nil (list 'WildPat nil))
        ;; C {} on a constructor without fields (DuplexHandle{}): every argument a wildcard
        pats (if (seq flds)
               (mapv (fn [f] (get given f wild)) flds)
               (vec (repeat (count (first (con-arg-types cn))) wild)))]
    (tc-con-pat env (list 'ConPat (arg v 1) (arg v 2) (list 'PrefixCon [] pats)) t)))

(declare tc-con-pat* rewrite-by-givens assume-eqs! scope-givens dict-param solve-with-givens! retry-implications!)

(defn- add-given!
  "A given equality a ~ b canonicalised as GHC.Tc.Solver.Equality's canEqNC does for givens: both sides rewritten by
  the givens so far, a type constructor application decomposed (its injectivity), an application decomposed
  (AppTy's), a skolem oriented to the left and bound (canEqTyVar, the occurs check kept), a meta unified (the
  elaborator trusts the program: GHC would leave it untouchable); a family application or apart types left (an
  inaccessible alternative)"
  [a b]
  (let [a (rewrite-by-givens a) b (rewrite-by-givens b)]
    (when trace? (binding [*out* *err*] (println "tc-trace: given" (pr-str a) (pr-str b))))
    (cond
      (= a b) nil
      ;; a side not known yet: pending, canonicalised when the scope's implication is solved (settle-givens!); unified
      ;; there if still unknown (the elaborator trusts the program: GHC would leave it untouchable)
      (or (= :mv (first a)) (= :mv (first b)))
      (if (and *implic-eqs* *given-eqs*) (swap! *given-eqs* update :pending (fnil conj []) [a b]) (unify a b))
      (and (= :tv (first a)) *given-eqs* (not (some #{a} (tree-seq coll? seq b)))) (swap! *given-eqs* assoc (second a) b)
      (and (= :tv (first b)) *given-eqs* (not (some #{b} (tree-seq coll? seq a)))) (swap! *given-eqs* assoc (second b) a)
      ;; HF10-P50 (a): a family application on one side bound to the other (given-of)
      (and (stuck-family? a) (not (stuck-family? b)) *given-eqs* (not (some #{a} (tree-seq coll? seq b))))
      (swap! *given-eqs* assoc [:fam a] b ::fams true)
      (and (stuck-family? b) (not (stuck-family? a)) *given-eqs* (not (some #{b} (tree-seq coll? seq a))))
      (swap! *given-eqs* assoc [:fam b] a ::fams true)
      (or (stuck-family? a) (stuck-family? b)) nil
      (and (= :tc (first a)) (= :tc (first b)) (= (second a) (second b)) (= (count (nth a 2)) (count (nth b 2))))
      (doseq [[x y] (map vector (nth a 2) (nth b 2))] (add-given! x y))
      (and (#{:tc :app} (first a)) (#{:tc :app} (first b)) (or (= :app (first a)) (= :app (first b))))
      (let [sp (fn [t] (if (= :app (first t)) [(nth t 1) (nth t 2)]
                           (when (seq (nth t 2)) [[:tc (second t) (vec (butlast (nth t 2)))] (last (nth t 2))])))
            [f1 x1] (sp a) [f2 x2] (sp b)]
        (when (and f1 f2) (add-given! f1 f2) (add-given! x1 x2)))
      :else nil)))

(defn- ip-pat-env
  "HF10-P21: the implicit parameters a constructor pattern's context gives (SomeException's HasExceptionContext, a
  HasCallStack, a ?x :: t) in env's ::ip, so its alternative's wanteds of them are its dictionaries (with-ips;
  GHC's given IP constraints of the pattern's implication)"
  [env dpreds dvars]
  (reduce (fn [env [[c ts] d]]
            (let [[n t] (cond (= c cls-ip) [(second (prune (first ts))) (second ts)]
                              (= (ip-synonym-name c) "callStack") ["callStack" (con-ty tc-callstack)]
                              (= (ip-synonym-name c) "exceptionContext")
                              ["exceptionContext" (con-ty (ext-name "tc" "GHC.Internal.Exception.Context" "ExceptionContext"))]
                              :else nil)]
              (if (string? n) (update env ::ip (fnil conj []) [n t d]) env)))
          env (map vector dpreds dvars)))

(defn- tc-gadt-pat
  "A pattern on a GADT constructor (GHC.Tc.Gen.Pat's tcDataConPat): the scrutinee T us, the universals the us, the
  existentials skolems, each equality spec a given (a skolem u) or a unification (else), the context's dictionaries
  bound"
  [env v t cn info]
  (let [{:keys [univ eqs tvs ctx args nres]} (:gadt info)
        us (vec (repeatedly nres fresh-meta))
        _ (unify t [:tc (or (:tycon (:gadt info)) (:tycon info)) us])
        m (into {} (for [x tvs] [x (if-let [i (some (fn [[i u]] (when (= u x) i)) univ)]
                                     (nth us i)
                                     [:tv (str x "_sk" (fresh-id))])]))
        _ (doseq [[i tau] (sort-by key eqs)]
            (add-given! (nth us i) (subst m tau)))
        dpreds (mapv (fn [[c ts]] [c (mapv #(subst m %) ts)]) ctx)
        dvars (mapv (fn [[c _]] (fresh-lv (str "$d" (occ c)))) dpreds)
        _ (when *skolem-givens* (swap! *skolem-givens* into (super-closure (mapv vector dpreds dvars))))
        _ (when *pat-dicts* (swap! *pat-dicts* into (map vector dpreds dvars)))
        _ (assume-eqs! dpreds)
        ps (pat-args (arg v 3))
        [env' pcs] (reduce (fn [[env pcs] [p at]] (let [[e c] (tc-pat env p (subst m at))] [e (conj pcs c)]))
                           [(ip-pat-env env dpreds dvars) []] (map vector ps args))]
    [env' (list 'pcon cn (into dvars pcs))]))

(defn- gadt-split
  "rejigConRes's split of a constructor's type (an interface's dataConWrapperType: forall tvs. ctx => args -> T
  res): {:univ :eqs :tvs :ctx :args :nres}, nil for a vanilla constructor (its result's arguments distinct variables,
  every variable among them)"
  [ct]
  (let [[vs ctx body] (loop [t ct vs [] ctx []]
                        (if (= :forall (first t)) (recur (nth t 3) (into vs (nth t 1)) (into ctx (nth t 2))) [vs ctx t]))
        [argtys res] (loop [t body as []]
                       (let [t (expand t)] (if (and (= :tc (first t)) (= fun-tc (second t))) (recur (second (nth t 2)) (conj as (first (nth t 2)))) [as t])))
        rargs (if (= :tc (first res)) (nth res 2) [])
        [univ eqs] (reduce (fn [[u e] [i t]]
                             (if (and (= :tv (first t)) (not (contains? (set (vals u)) (second t))))
                               [(assoc u i (second t)) e]
                               [u (assoc e i t)]))
                           [{} {}] (map-indexed vector rargs))
        occurs (set (keep (fn [x] (when (and (vector? x) (= :tv (first x))) (second x))) (tree-seq coll? seq body)))
        ex (remove (set (vals univ)) (filter occurs vs))]
    (when (and (= :tc (first res)) (or (seq eqs) (seq ex)))
      {:univ univ :eqs eqs :tvs vs :ctx ctx :args argtys :nres (count rargs) :tycon (second res)})))

(defn- tc-con-pat [env v t]
  (let [cn (nm (arg v 2)) i (get @*cons* cn)
        ;; an imported constructor (no declaration seen): a GADT's or an existential's split from its type
        g (or (:gadt i) (when (and cn (not (contains? i :ex)) (not (contains? i :dicts)))
                          (some-> (get @*genv* cn) gadt-split)))]
    (if g
      (tc-gadt-pat env v t cn (assoc i :gadt g :tycon (or (:tycon i) (:tycon g))))
      (tc-con-pat* env v t))))

(defn- tc-con-pat* [env v t]
  (let [cn (nm (arg v 2))
                   ct (get @*genv* cn)
                   nex (or (:ex (get @*cons* cn)) 0)
                   ;; an existential constructor's own variables are skolems in its pattern, its context's
                   ;; dictionaries bound by the pattern and given to its alternative
                   [ity dpreds] (if (and ct (= :forall (first ct)) (or (pos? nex) (seq (nth ct 2))))
                                  (let [vs (nth ct 1) k (- (count vs) nex)
                                        m (into {} (concat (map (fn [x] [x (fresh-meta)]) (take k vs))
                                                           (map (fn [x] [x [:tv (str x "_sk" (fresh-id))]]) (drop k vs))))]
                                    [(subst m (nth ct 3)) (mapv (fn [[c ts]] [c (mapv #(subst m %) ts)]) (nth ct 2))])
                                  [(first (instantiate (or ct (fresh-meta)))) []])
                   dvars (mapv (fn [[c _]] (fresh-lv (str "$d" (occ c)))) dpreds)
                   _ (when *skolem-givens* (swap! *skolem-givens* into (super-closure (mapv vector dpreds dvars))))
                   _ (when *pat-dicts* (swap! *pat-dicts* into (map vector dpreds dvars)))
                   _ (assume-eqs! dpreds)
                   args (pat-args (arg v 3))
                   ;; the constructor's result unified with the scrutinee's type before its arguments' patterns
                   ;; (tcDataConPat's matchExpectedConTy: the expected type pushed in, a nested GADT pattern's
                   ;; scrutinee known)
                   [ats res] (reduce (fn [[ats ty] _]
                                       (let [ty (expand (prune ty))]
                                         (if (and (= :tc (first ty)) (= fun-tc (second ty)))
                                           [(conj ats (first (nth ty 2))) (second (nth ty 2))]
                                           (let [a1 (fresh-meta) r (fresh-meta)]
                                             (unify ty (fn-ty a1 r))
                                             [(conj ats a1) r]))))
                                     [[] ity] args)
                   _ (when-not ct (error! "no constructor type for " (pr-str cn)))
                   _ (unify res t)
                   [env' pcs] (reduce (fn [[env pcs] [a at]] (let [[env1 pc] (tc-pat env a at)] [env1 (conj pcs pc)]))
                                      [(ip-pat-env env dpreds dvars) []] (map vector args ats))]
               [env' (list 'pcon cn (into dvars pcs))]))

;; HF9 (second slice): pattern synonyms (GHC.Tc.TyCl.PatSyn, GHC.Tc.Gen.Pat's tcPatSynPat). A synonym's type is
;; GHC's pattern type, forall univ. req => forall ex. prov => args -> res: matching on it instantiates the universals
;; (the result unified with the scrutinee's type first), wants the required context, makes the existentials skolems and
;; gives the provided context to the alternative (its dictionaries bound, its equalities given), as a GADT constructor
;; does; its builder is the expression forall univ ex. (req, prov) => args -> res. The desugaring (the matcher $mP
;; applied to the scrutinee and the success and failure continuations) is the desugarer's (HF9's slice 7): the core
;; pattern is (psyn NAME [req-evidence...] [prov-dictionary...] [pattern...]).
(def ^:dynamic *patsyns* nil) ; atom {NAME {:univ :req :ex :prov :args :res :fields}}

(defn- tvs-of [t] (set (keep (fn [x] (when (and (vector? x) (= :tv (first x))) (second x))) (tree-seq coll? seq t))))

(defn- patsyn-info
  "A pattern synonym's signature (PatSynSig's HsSig) as its pattern type's parts (tcPatSynSig): univ and req from the
  outer quantifier and the first context, ex and prov from what follows; implicitly quantified, a variable the result
  does not mention is existential"
  [sig]
  (let [st (sig-type sig)
        outer (arg (lval sig) 2)
        explicit? (= 'HsOuterExplicit (con (if (L? outer) (lval outer) outer)))
        [ex prov rest] (loop [t (nth st 3) ex [] prov []]
                         (if (= :forall (first t)) (recur (nth t 3) (into ex (nth t 1)) (into prov (nth t 2))) [ex prov t]))
        [args res] (loop [t rest as []]
                     (let [t (prune t)]
                       (if (and (= :tc (first t)) (= fun-tc (second t))) (recur (second (nth t 2)) (conj as (first (nth t 2)))) [as t])))
        ;; Note [The pattern-synonym signature splitting rule]: the implicitly bound variables the required context or
        ;; the result mentions are universal, the rest existential (HF10-P36: T11224's `Read a => () => a -> String`)
        in-res (into (tvs-of res) (tvs-of (nth st 2)))
        [univ ex0] (if explicit? [(nth st 1) []] [(filterv in-res (nth st 1)) (filterv (complement in-res) (nth st 1))])]
    {:univ univ :req (nth st 2) :ex (into ex0 ex) :prov prov :args args :res res}))

(defn- builder-type [{:keys [univ req ex prov args res]}]
  [:forall (into univ ex) (into req prov) (reduce (fn [acc a] (fn-ty a acc)) res (reverse args))])

;; HF10-P36 (a): the matcher and the builder as GHC.Tc.TyCl.PatSyn makes them (tcPatSynMatcher, mkPatSynBuilder), named as
;; GHC.Types.Name.Occurrence's mkMatcherOcc and mkBuilderOcc: $mP and $bP of the synonym's module
(defn matcher-name [n] (ext-name "var" (nmod n) (str "$m" (occ n))))
(defn builder-name [n] (ext-name "var" (nmod n) (str "$b" (occ n))))

(def ^:private unit#-ty [:tc (utuple-tc 0) []])
(def ^:private unit#-core (list 'v (ext-name "var" "GHC.Internal.Types" "(##)")))

(defn- unlifted-ty?
  "isUnliftedType for the builder's dummy argument: a primitive type of GHC.Internal.Prim (Int#, ...), an unboxed tuple or sum"
  [t]
  (let [t (expand (prune t))]
    (and (= :tc (first t)) (vector? (second t))
         (or (and (= "GHC.Internal.Prim" (nmod (second t))) (str/ends-with? (occ (second t)) "#"))
             (and (= "GHC.Internal.Types" (nmod (second t))) (boolean (re-matches #"Tuple[0-9]+#|Solo#|Unit#|Sum[0-9]+#" (occ (second t)))))))))

(defn- builder-dummy?
  "mkPatSynBuilder's need_dummy_arg: an unlifted result, no arguments and no context (the builder a function of (# #))"
  [{:keys [req prov args res]}]
  (and (empty? args) (empty? req) (empty? prov) (unlifted-ty? res)))

(defn- matcher-type
  "tcPatSynMatcher's type: forall r univ. req => res -> (forall ex. prov => args -> r) -> ((# #) -> r) -> r, the
  continuation a function of (# #) when the synonym has neither arguments nor provided dictionaries"
  [{:keys [univ req ex prov args res]}]
  (let [r [:tv "r_rep"]
        cont (if (and (empty? args) (empty? prov))
               (fn-ty unit#-ty r)
               (let [body (reduce (fn [acc a] (fn-ty a acc)) r (reverse args))]
                 (if (or (seq ex) (seq prov)) [:forall (vec ex) (vec prov) body] body)))]
    [:forall (into ["r_rep"] univ) (vec req) (fn-ty res (fn-ty cont (fn-ty (fn-ty unit#-ty r) r)))]))

(defn- register-patsyn!
  "A synonym's matcher's and builder's types in the global environment (the builder's also under the synonym's own name,
  the type of its occurrences as an expression)"
  [n info builder?]
  (swap! *genv* assoc (matcher-name n) (matcher-type info))
  ;; a record synonym's selectors: forall univ. req => res -> the field's type (mkPatSynRecSelBinds), before any use
  (doseq [[f a] (map vector (:fields info) (:args info)) :when (and f (not-any? (set (:ex info)) (tvs-of a)))]
    (when-not (get @*genv* f) (swap! *genv* assoc f [:forall (vec (:univ info)) (vec (:req info)) (fn-ty (:res info) a)])))
  (if builder?
    (let [bt (builder-type info)]
      (swap! *genv* assoc n bt)
      (swap! *genv* assoc (builder-name n) (if (builder-dummy? info) [:forall (nth bt 1) [] (fn-ty unit#-ty (nth bt 3))] bt)))
    (swap! *genv* dissoc n)))

(declare tc-pat)

(defn- tc-patsyn-pat
  "A pattern on a pattern synonym (tcPatSynPat): [env' core]"
  [env v t {:keys [univ req ex prov args res fields]}]
  (let [cn (nm (arg v 2))
        m (merge (zipmap univ (repeatedly fresh-meta)) (into {} (map (fn [x] [x [:tv (str x "_sk" (fresh-id))]]) ex)))
        sp (fn [[c ts]] [c (mapv #(subst m %) ts)])
        _ (unify (subst m res) t)
        evs (mapv #(want! (sp %)) req)
        dpreds (mapv sp prov)
        dvars (mapv (fn [[c _]] (fresh-lv (str "$d" (occ c)))) dpreds)
        ;; HF10-P36: a provided constraint without a type variable is not given beyond the alternative (*skolem-givens* is the
        ;; module's: SNat's KnownNat n at n := 7 solved the scrutinee's own KnownNat 7 by the alternative's dictionary); the
        ;; instances solve it
        _ (when *skolem-givens*
            (swap! *skolem-givens* into (super-closure (filterv (fn [[p _]] (seq (tvs-of (zonk-pred p)))) (mapv vector dpreds dvars)))))
        _ (assume-eqs! dpreds)
        ats (mapv #(subst m %) args)
        details (arg v 3)
        ps (if (= 'RecCon (con details))
             (let [given (into {} (for [fb (arg (arg details 1) 2) :let [fbv (lval fb) lbl (lval (arg (lval (arg fbv 2)) 2))
                                                                         [f x] (if (= 'rn/names (first lbl)) (second lbl) [(second lbl) nil])]]
                                    [(occ f) (if (true? (arg fbv 4)) (list 'L nil (list 'VarPat nil (list 'L nil (list 'rn/name x)))) (arg fbv 3))]))]
               (mapv (fn [f] (get given (occ f) (list 'L nil (list 'WildPat nil)))) fields))
             (pat-args details))
        _ (when *pat-dicts* (swap! *pat-dicts* into (map vector dpreds dvars)))
        [env' pcs] (reduce (fn [[env pcs] [p at]] (let [[e c] (tc-pat env p at)] [e (conj pcs c)])) [(ip-pat-env env dpreds dvars) []] (map vector ps ats))]
    ;; HF10-P36 (a): matched by its matcher (the desugarer's matchPatSyn: $mP req-evidence scrutinee (\prov-dictionaries
    ;; args -> ...) (\(# #) -> fail)); hs-p34's shortcut (a synonym of the module matched as its pattern) is gone
    [env' (list 'psyn (matcher-name cn) evs dvars pcs)]))

(defn tc-pat [env p t]
  (let [v (lval p)]
    (case (con v)
      VarPat (let [n (nm (arg v 2))] (note-type! (lv n) t) [(assoc env n {:mono t}) (lv n)])
      WildPat [env (list 'pwild)]
      ParPat (tc-pat env (arg v 2) t)
      ;; a bang pattern: kept for the match compiler (HF10; GHC.HsToCore.Match's tidy1 and matchBangs)
      BangPat (let [[env1 pc] (tc-pat env (arg v 2) t)] [env1 (list 'pbang pc)])
      ;; a lazy pattern: kept for the match compiler (HF5), its variables bound by selectors
      ;; (queue 369, 352's leftover: its failure's text "SPAN|PAT" as mkSelectorBinds writes it, tidy1's LazyPat: the span of
      ;; the pattern under ~, the pattern printed with its outer bangs and parentheses stripped, strip_bangs; dsrun008)
      LazyPat (let [p (arg v 2)
                    [env1 pc] (tc-pat env p t)
                    sp (when (L? p) (lsp p))
                    q (loop [q p] (if (contains? '#{ParPat BangPat} (con (lval q))) (recur (arg (lval q) 2)) q))]
                [env1 (if sp
                        (list 'plazy pc (str (span-text sp) "|" (doc/render (pprhs/ppr-lpat (unrn q)) 100)))
                        (list 'plazy pc))])
      AsPat (let [n (nm (arg v 2)) _ (note-type! (lv n) t) [env1 pc] (tc-pat (assoc env n {:mono t}) (arg v 3) t)] [env1 (list 'pas (lv n) pc)])
      ConPat (cond
               (some-> *patsyns* deref (get (nm (arg v 2)))) (tc-patsyn-pat env v t (get @*patsyns* (nm (arg v 2))))
               ;; HF10-P54 (a): [] under OverloadedLists is the list pattern [] (GHC.Rename.Pat's ConPat of nilDataCon)
               (and (= (nm (arg v 2)) (ext-name "data" "GHC.Internal.Types" "[]")) (ovl-lists?))
               (tc-pat env (list 'ListPat nil []) t)
               (= 'RecCon (con (arg v 3))) (tc-rec-pat env v t)
               :else (tc-con-pat env v t))
      TuplePat (if (= 'Unboxed (arg v 3))
                 ;; an unboxed tuple: its constructor (#,...,#) of GHC.Internal.Types
                 (let [ps (arg v 2) cn (unboxed-con (count ps))
                       [ct _] (instantiate (get @*genv* cn))
                       [ats rt] (loop [ty ct ats []] (if (and (= :tc (first ty)) (= fun-tc (second ty)))
                                                         (recur (second (nth ty 2)) (conj ats (first (nth ty 2)))) [ats ty]))
                       _ (unify t rt)
                       [env' pcs] (reduce (fn [[env pcs] [p1 t1]] (let [[e c] (tc-pat env p1 t1)] [e (conj pcs c)])) [env []] (map vector ps ats))]
                   [env' (list 'pcon cn pcs)])
               ;; tcTuplePat: the expected type split first (matchExpectedTyConApp), the components checked at its parts
               (let [ps (arg v 2) ts (mapv (fn [_] (fresh-meta)) ps)
                     _ (unify t [:tc (tuple-tc (count ps)) ts])
                     [env' pcs] (reduce (fn [[env pcs] [p1 t1]] (let [[e c] (tc-pat env p1 t1)] [e (conj pcs c)])) [env []] (map vector ps ts))]
                 [env' (list 'pcon (ext-name "data" "GHC.Internal.Tuple" (occ (tuple-con (count ps)))) pcs)]))
      ;; ViewPatterns (GHC.Tc.Gen.Pat's ViewPat): the expression a function from the scrutinee's type, the pattern
      ;; at its result (the desugarer's (pview F P), HsToCore/Match's ViewPat group)
      ViewPat (let [[tf cf] (infer env (arg v 2)) r (fresh-meta)]
                (unify tf (fn-ty t r))
                (let [[env' pc] (tc-pat env (arg v 3) r)] [env' (list 'pview cf pc)]))
      ;; HF10-P50 (a): OrPatterns (GHC.Tc.Gen.Pat's OrPat: every alternative at the scrutinee's type, none binding a
      ;; variable): matched as the view pattern ((\x -> case x of p1 -> True; ...; _ -> False) -> True), the alternatives
      ;; tried left to right as GHC.HsToCore.Match's matchOrPat (each a failure continuation of the one before)
      OrPat (let [ps (vec (arg v 2)) x (fresh-lv "or")
                  pcs (mapv (fn [p1] (second (tc-pat env p1 t))) ps)
                  tc (ext-name "data" "GHC.Internal.Types" "True") fc (ext-name "data" "GHC.Internal.Types" "False")
                  [_ ct] (var-occ env tc) [_ cf] (var-occ env fc)]
              (note-type! x t)
              [env (list 'pview (list 'lam [x] (list 'match [x] (conj (mapv (fn [pc] (list 'clause [pc] ct)) pcs)
                                                                      (list 'clause [(list 'pwild)] cf))))
                         (list 'pcon tc []))])
      ;; UnboxedSums (GHC.Tc.Gen.Pat's SumPat): the alternative's constructor, the other components fresh
      SumPat (let [alt (arg v 3) n (arg v 4) ts (mapv (fn [_] (fresh-meta)) (range n))
                   _ (unify t [:tc (usum-tc n) ts])
                   [env' pc] (tc-pat env (arg v 2) (nth ts (dec alt)))]
               [env' (list 'pcon (usum-con alt n) [pc])])
      ;; HF10-P54 (a): under OverloadedLists a view pattern (toList -> [p1, ...]) (GHC.Rename.Pat's rnPatAndThen of
      ;; ListPat, Note [Desugaring overloaded list patterns])
      ListPat (let [a (fresh-meta)
                    ovl (and (ovl-lists?) (contains? @*genv* (ext-name "var" is-list-m "toList")))
                    [tl cl] (when ovl (var-occ env (ext-name "var" is-list-m "toList")))
                    _ (if ovl (unify tl (fn-ty t (list-ty a))) (unify t (list-ty a)))
                    [env' pcs] (reduce (fn [[env pcs] p1] (let [[e c] (tc-pat env p1 a)] [e (conj pcs c)])) [env []] (arg v 2))]
                [env' (if ovl (list 'pview cl (list 'plist pcs)) (list 'plist pcs))])
      ;; GHC's tcNPat: the equality first, then the literal; a negative literal pattern (-1, the NPat's mb_neg) the literal
      ;; negated (queue 352): (nolit NEGATE LIT), folded into the literal by tidyNPat at a type with built-in literals, else
      ;; negate applied to it (tcNPat's neg_lit) for the equality
      NPat (let [eqn (implicit-name v "==" (ext-name "var" "GHC.Internal.Classes" "=="))
                 [te ce] (var-occ env eqn)
                 [lt lc] (overlit (list 'HsOverLit nil (lval (arg v 2))))
                 neg? (and (seq? (arg v 3)) (= 'Just (first (arg v 3))))
                 lc (if neg?
                      (let [[tn cn] (var-occ env (implicit-name v "negate" (ext-name "var" "GHC.Internal.Num" "negate")))]
                        (unify tn (fn-ty lt lt))
                        (list 'nolit cn lc))
                      lc)]
             (unify lt t)
             (unify te (fn-ty t (fn-ty t (con-ty tc-bool))))
             [env (list 'plit ce lc t)])
      ;; HF10-P54 (a): an overloaded string pattern is an NPat (rnPatAndThen's LitPat under OverloadedStrings): tcNPat's
      ;; (==) at the scrutinee's type and the literal fromString's
      LitPat (if (ovl-string? v)
               (let [[te ce] (var-occ env (implicit-name v "==" (ext-name "var" "GHC.Internal.Classes" "==")))
                     [lt lc] (ovl-string v)]
                 (unify lt t)
                 (unify te (fn-ty t (fn-ty t (con-ty tc-bool))))
                 [env (list 'plit ce lc t)])
               (let [[lt lc] (hslit v)] (unify lt t) [env (list 'plit lc)]))
      ;; HF10-P50 (a): n+k (GHC.Tc.Gen.Pat's NPlusKPat: the literal, (>=) and (-) at the scrutinee's type, Integral of it
      ;; as instStupidTheta, its evidence unused; GHC.HsToCore.Match's matchNPlusK: x >= k, then n = x - k) as the view
      ;; pattern ((\x -> (x >= k, x - k)) -> (True, n))
      NPlusKPat (let [n (nm (arg v 2))
                      [lt lc] (overlit (list 'HsOverLit nil (lval (arg v 3))))
                      [tg cg] (var-occ env (implicit-name v ">=" (ext-name "var" "GHC.Internal.Classes" ">=")))
                      [tm cm] (var-occ env (implicit-name v "-" (ext-name "var" "GHC.Internal.Num" "-")))
                      x (fresh-lv "nk")]
                  (unify lt t)
                  (unify tg (fn-ty t (fn-ty t (con-ty tc-bool))))
                  (unify tm (fn-ty t (fn-ty t t)))
                  (want! [(ext-name "tc" "GHC.Internal.Real" "Integral") [t]])
                  (note-type! x t)
                  (note-type! (lv n) t)
                  [(assoc env n {:mono t})
                   (list 'pview (list 'lam [x] (app* (list 'v (tuple-con 2)) [(app* cg [x lc]) (app* cm [x lc])]))
                         (list 'pcon (ext-name "data" "GHC.Internal.Tuple" (occ (tuple-con 2)))
                               [(list 'pcon (ext-name "data" "GHC.Internal.Types" "True") []) (lv n)]))])
      SigPat (let [sig (arg (arg v 3) 2)
                   _ (when *pat-tvs*
                       (doseq [n (tv-names-of sig) :let [k (tv-key n)]
                               :when (not (or (contains? *scoped-tvs* k) (contains? @*pat-tvs* k)))]
                         (swap! *pat-tvs* assoc k (fresh-meta))))
                   st (hs-type {} sig)]
               (unify st t)
               (tc-pat env (arg v 2) t))
      (do (error! "pattern not handled: " (con v)) [env (list 'pwild)]))))

;;; ------------------------------------------------------------------------------------------
;;; Matches, guards, bindings

;; atom [[WI GIVENS-BEFORE]...]: at each pattern guard that gives equalities, the wanteds' index and the givens in force
;; before it (review 1111b, finding 1: each stretch of wanteds rewritten by the givens it was made under)
(def ^:dynamic *guard-w* nil)

(defn- infer-guards
  "Guard statements, then the body: [env core-guards]"
  [env stmts]
  (reduce (fn [[env gs] s]
            (let [v (lval s)]
              (case (con v)
                BodyStmt (let [[t c] (infer env (arg v 2))] (unify t (con-ty tc-bool)) [env (conj gs c)])
                BindStmt (let [[te ce] (infer env (arg v 3))
                               wi (count @*wanteds*) before (some-> *given-eqs* deref)
                               [env1 pc] (tc-pat env (arg v 2) te)
                               pc (strict-pat pc)]
                           ;; HF10-P20: a pattern that gives equalities: the wanteds made before it (its scrutinee's,
                           ;; eqT's heqT @a @b) are outside its implication; review 1111b (finding 1): every such pattern
                           ;; recorded with the givens before it, so a second guard's scrutinee is not rewritten by its own
                           ;; pattern's equalities (infer-grhss rewrites stretch by stretch)
                           (when (and *guard-w* (not= before (some-> *given-eqs* deref))) (swap! *guard-w* conj [wi (or before {})]))
                           ;; review 1111 (2): the wanteds made before the pattern under the same scope (the clause had
                           ;; givens, so they hold *given-eqs*' atom itself) keep the givens they were made under, a
                           ;; snapshot, not the atom the pattern just added its equalities to (under-givens rewrites by :geqs)
                           (when (and *given-eqs* (not= before @*given-eqs*))
                             (let [g *given-eqs* g0 (atom before)]
                               (swap! *wanteds* (fn [ws] (into [] (map-indexed (fn [i w] (if (and (< i wi) (identical? g (:geqs w)))
                                                                                            (assoc w :geqs g0) w)))
                                                               ws)))))
                           [env1 (conj gs (list 'pguard pc ce))])
                LetStmt (let [[env1 bs] (tc-local-binds env (arg v 2))] [env1 (conj gs (list 'plet bs))])
                (do (error! "guard not handled: " (con v)) [env gs]))))
          [env []] stmts))

(declare rewrite-wanteds! rewrite-wanteds-by-stretch!)

(defn infer-grhss
  "(GRHSs ext [GRHS...] localbinds) against result type r: core"
  [env grhss r]
  (let [;; (queue 369, 352's leftover: the where bindings are strict as a let's are, dsGRHSs' dsLocalBinds: a banged one, and
        ;; under the Strict extension a variable binding, recursive or not, and a pattern binding but ~ ones, forced before
        ;; the guards; 369-1 (a), the user 2026-11-18: a banged where binding without Strict too, `where !y = e`)
        sb (atom [])
        [env1 binds] (if sb
                       (binding [*strict-binds* {:atom sb :level (inc *level*) :where true}] (tc-local-binds env (arg grhss 3)))
                       (tc-local-binds env (arg grhss 3)))
        ;; HF10-P20: each guarded right-hand side its own implication (GHC.Tc.Gen.Match's tcGRHS: a pattern guard's
        ;; givens scope over the guards after it and the body, not over the where bindings: Data.Typeable's cast,
        ;; `Just HRefl <- ta `eqTypeRep` tb`, rewrote tb's Typeable b wanted, made in the where clause, to Typeable a)
        alts (with-ips env1 (mapv (fn [g]
                     (let [outer (some-> *given-eqs* deref) w0 (count @*wanteds*)]
                       (binding [*given-eqs* (atom (or outer {})) *guard-w* (atom [])]
                         (let [gv (lval g)
                               [env2 gs] (infer-guards env1 (arg gv 2))
                               c (check-expr env2 (arg gv 3) r)]
                           (when (not= (or outer {}) @*given-eqs*)
                             (if-let [segs (seq @*guard-w*)]
                               (rewrite-wanteds-by-stretch! (vec segs) @*given-eqs*)
                               (rewrite-wanteds! w0)))
                           (if (empty? gs) c (list 'guarded gs c))))))
                   (arg grhss 2)))
        body (if (and (= 1 (count alts)) (not (and (seq? (first alts)) (= 'guarded (first (first alts)))))) (first alts) (list 'guards alts))]
    ;; (the forces around the guards as (strict-rhs [[x PAT]...] BODY): the desugarer's dsGRHSs, whose guards' failure falls
    ;; through to the next equation, not a failure of the forcing match's own)
    (wrap-lets binds (if (and sb (seq @sb)) (strict-rhs body @sb) body))))

(defn- rewrite-by-givens [t]
  (let [t (zonk t)]
    (case (first t)
      :tv (if-let [g (given-of t)] (rewrite-by-givens g) t)
      :tc (let [t2 [:tc (second t) (mapv rewrite-by-givens (nth t 2))]]
            (if-let [g (given-of t2)] (rewrite-by-givens g) t2))
      :app (mk-app (rewrite-by-givens (nth t 1)) (rewrite-by-givens (nth t 2)))
      t)))

(defn- rewrite-wanteds!
  "The wanteds made since index w0 rewritten by the alternative's given equalities"
  [w0]
  (swap! *wanteds* (fn [ws] (into (subvec ws 0 (min w0 (count ws)))
                                  (map (fn [w] (update w :pred (fn [[c ts]] [c (mapv rewrite-by-givens ts)])))
                                       (subvec ws (min w0 (count ws))))))))

(defn- rewrite-wanteds-by-stretch!
  "Review 1111b (finding 1): segs [[WI GIVENS-BEFORE]...], one per equality-giving pattern guard of a GRHS in order. The
  wanteds from WI_k to WI_k+1 were made after pattern k and before pattern k+1 (pattern k's own, the next scrutinee's):
  rewritten by the givens before pattern k+1; the last stretch by the GRHS's final givens (GHC's nested implications,
  one per pattern guard: a scrutinee's wanteds sit outside its own pattern's implication)"
  [segs final]
  (let [n (count @*wanteds*)]
    (dotimes [k (count segs)]
      (let [from (min n (first (nth segs k)))
            to (if (< (inc k) (count segs)) (min n (first (nth segs (inc k)))) n)
            gm (if (< (inc k) (count segs)) (second (nth segs (inc k))) final)]
        (when (< from to)
          (binding [*given-eqs* (atom gm)]
            (swap! *wanteds* (fn [ws] (reduce (fn [ws i] (update-in ws [i :pred] (fn [[c ts]] [c (mapv rewrite-by-givens ts)])))
                                              ws (range from to))))))))))

(defn- settle-givens!
  "The pending givens of the scope g canonicalised again (those whose sides became known), still unknown ones left
  pending, or unified when final?"
  [g final?]
  (when-let [ps (seq (:pending @g))]
    (swap! g dissoc :pending)
    (binding [*given-eqs* g]
      (doseq [[a b] ps]
        (if final?
          (binding [*implic-eqs* nil] (add-given! a b))
          (add-given! a b))))))

(defn- retry-implications!
  "The deferred equalities retried under their givens settled; one that still fails stays deferred, or is reported
  when final?"
  [final?]
  (when *implic-eqs*
    (loop [k 0]
      (let [ds @*implic-eqs*]
        (reset! *implic-eqs* [])
        (doseq [[a b g] ds]
          (settle-givens! g final?)
          (binding [*given-eqs* g]
            (if final?
              (binding [*implic-eqs* nil] (unify a b))
              (let [errs (atom [])]
                (binding [*errors* errs] (unify a b))
                (when (seq @errs) (swap! *implic-eqs* conj [a b g]))))))
        (when (and (< k 4) (seq @*implic-eqs*) (not= (count ds) (count @*implic-eqs*))) (recur (inc k)))))))

(defn- under-givens
  "f of the wanted w with its pred rewritten by the given equalities it was made under (GHC.Tc.Solver's solving of an
  implication's wanteds by its inert givens), inside their scope"
  [w f]
  (if-let [g (:geqs w)]
    (do (settle-givens! g false)
        (binding [*given-eqs* g] (f (update w :pred (fn [[c ts]] [c (mapv rewrite-by-givens ts)])))))
    (f w)))

(defn- assume-eqs!
  "The equalities among a context's predicates (a ~ b, a ~~ b) given: a signature's, an instance's, a method's, a
  constructor's (GHC's givens of the implication tcPolyCheck, tcInstDecl2 and tcDataConPat make)"
  [preds]
  (doseq [[_ ts :as p] preds :when (eq-pred? p)]
    (add-given! (last (butlast ts)) (last ts))))

(defn- scope-givens [] (atom (or (some-> *given-eqs* deref) {})))

(defn infer-matches
  "A match group (MG origin (L sp [Match...])): [type core]; ctx {:scrut [t c] :res r} for a case; expected a type
  to check against (its arrows the arguments' types, GHC's matchExpectedFunTys)"
  [env mg ctx & [expected]]
  (let [ms (lval (arg mg 2))
        n (count (lval (arg (lval (first ms)) 3)))
        ;; queue 352: the failure's text [TEXT false] (patError's "SPAN|CONTEXT"): the case's or lambda's span, else the
        ;; matches' (a function binding's), and the first match's context
        ef (when-let [t (and (seq ms) (match-ctx-text (arg (lval (first ms)) 2)))]
             (when-let [sp (or *match-span* (lsp (arg mg 2)))] [(str (span-text sp) "|" t) false]))
        ;; HF10-P66 (a): a polytype met among the arguments (gmapT :: Proxy ctx -> GenericT ctx -> GenericT ctx, defined by
        ;; gmapT ctx f x: after two arguments forall a. Data ctx a => a -> a) is skolemised there, as GHC.Tc.Utils.Unify's
        ;; matchExpectedFunTys does (tcSkolemise at each forall it meets in checking mode): its quantifiers skolems, its
        ;; context given to the clauses, its dictionaries the core's parameters after the arguments before it. Before,
        ;; the expected type ran out there and the clauses' type was unified with the polytype afterwards, its context
        ;; instantiated as wanteds no given solved
        splits (atom [])
        [args r0] (loop [t expected as []]
                    (let [t (when t (expand (prune t)))]
                      (cond (= n (count as)) [as t]
                            (and t (= :tc (first t)) (= fun-tc (second t))) (recur (second (nth t 2)) (conj as (first (nth t 2))))
                            (and t (not ctx) (= :forall (first t)) (or (seq (nth t 1)) (seq (nth t 2))))
                            (let [sk (into {} (map (fn [x] [x [:tv (str x "_sk" (fresh-id))]]) (nth t 1)))
                                  preds (mapv (fn [[c ts]] (zonk-pred [c (mapv #(subst sk %) ts)])) (nth t 2))]
                              (swap! splits conj {:at (count as) :preds preds :params (mapv dict-param preds)})
                              (recur (subst sk (nth t 3)) as))
                            :else [(into as (repeatedly (- n (count as)) fresh-meta)) nil])))
        args (vec args)
        r (or (:res ctx) (when (and expected r0 (= n (count args))) r0) (fresh-meta))
        splits @splits
        sgivens (when (seq splits) (super-closure (vec (mapcat (fn [sp] (map vector (:preds sp) (:params sp))) splits))))
        sws (atom [])
        clauses (binding [*match-span* nil
                          *wanteds* (if (seq splits) sws *wanteds*)
                          *given-eqs* (if (seq splits) (scope-givens) *given-eqs*)]
                  (when (seq splits) (assume-eqs! (mapcat :preds splits)))
                  (mapv (fn [m]
                        (let [outer (some-> *given-eqs* deref)]
                          (binding [*given-eqs* (atom (or outer {})) *pat-tvs* (atom (or (some-> *pat-tvs* deref) {}))
                                    ;; (queue 369: tcMatch's MatchInCtxt)
                                    *ectx* (if *defer-log* (cons [:match m] *ectx*) *ectx*)]
                            (let [w0 (count @*wanteds*)
                                  mv (lval m) pats (lval (arg mv 3))
                                  [env1 pcs] (reduce (fn [[env pcs] [p t]] (let [[e c] (tc-pat env p t)] [e (conj pcs c)]))
                                                     [env []] (map vector pats (if ctx [(first (:scrut ctx))] args)))
                                  body (infer-grhss env1 (arg mv 4) r)]
                              (when (not= outer @*given-eqs*)
                                (rewrite-wanteds! w0))
                              [(mapv strict-pat pcs) body]))))
                      ms))
        _ (when (seq splits) (retry-implications! false) (solve-with-givens! @sws sgivens))
        ;; the split arguments' lambdas: the dictionaries of a polytype met after k arguments bound after them
        split-lam (fn [ps body]
                    (reduce (fn [b sp] (let [[before after] (split-at (:at sp) (second b))
                                             inner (list 'lam (:params sp) (if (seq after) (list 'lam (vec after) (nth b 2)) (nth b 2)))]
                                         (cond (empty? (:params sp)) b
                                               (seq before) (list 'lam (vec before) inner)
                                               :else inner)))
                            (list 'lam ps body) (reverse splits)))]
    (if ctx
      [r (with-ef (list 'match [(second (:scrut ctx))] (mapv (fn [[pcs b]] (list 'clause pcs b)) clauses)) ef)]
      (let [ty (if (seq splits) expected (reduce (fn [acc a] (fn-ty a acc)) r (reverse args)))
            simple? (and (= 1 (count clauses)) (every? #(= 'lv (first %)) (first (first clauses))))
            ;; (queue 369, 352's leftover: a \cases of no patterns and several matches, each line of guards its own match
            ;; (T20768's \cases | 1 < 1 -> "foo" | otherwise -> "bar"): matched in order, a match whose guards all fail
            ;; falling to the next, matchWrapper's equations of no column; the first alone was taken, its failure patError)
            core (cond (and (zero? n) (> (count clauses) 1)) (with-ef (list 'match [] (mapv (fn [[pcs b]] (list 'clause pcs b)) clauses)) ef)
                       (zero? n) (tag-guards (second (first clauses)) ef)
                       simple? (split-lam (first (first clauses)) (second (first clauses)))
                       :else (let [ds (vec (repeatedly n #(fresh-lv "ds")))]
                               ;; the match's binders typed as the arguments (HF10-P20: a State# or Int# argument matched
                               ;; by equations was taken for a lifted one by tostg, ascii_decode's state token)
                               (doseq [[d t] (map vector ds args)] (note-type! d t))
                               (split-lam ds (with-ef (list 'match ds (mapv (fn [[pcs b]] (list 'clause pcs b)) clauses)) ef))))]
        [ty core]))))

(defn- pat-binders
  "The variables a pattern binds, in order"
  [p]
  (let [out (atom [])]
    (letfn [(w [x] (cond
                     (and (seq? x) (contains? '#{VarPat AsPat NPlusKPat} (first x)))
                     (do (when-let [n (nm (arg x 2))] (swap! out conj n)) (doseq [y (drop 3 x)] (w y)))
                     ;; HF10-P54 (a): a record wildcard's variables (RecordWildCards' C {..} in a pattern binding:
                     ;; dsrun015's let (C {..}, d) = v; GHC.Hs.Utils' collectPatBinders over the rec_dotdot fields)
                     (and (seq? x) (= 'rn/dotdot (first x)) (vector? (nth x 2 nil)))
                     (doseq [[_ n] (partition 2 (nth x 2))] (swap! out conj n))
                     ;; a view pattern's expression binds nothing
                     (and (seq? x) (= 'ViewPat (first x))) (w (arg x 3))
                     (coll? x) (doseq [y x] (w y))
                     :else nil))]
      (w p))
    @out))

(defn- lhs-arity
  "GHC.Tc.Gen.Bind's addInlinePragArity: a function binding's patterns (its first match's: matchGroupArity), else 0"
  [b]
  (let [v (lval b)
        ms (when (= 'FunBind (con v)) (lval (arg (arg v 3) 2)))
        m (when (seq ms) (lval (first ms)))
        ps (when m (lval (arg m 3)))]
    (if (sequential? ps) (count ps) 0)))

(defn- note-inline-arity!
  "An INLINE pragma's binder: its real arity, the dictionaries' and its LHS's (makeCorePair's inline_pair)"
  [n b ndicts]
  (when (and *inline-arities* (get *inline-prags* n))
    (swap! *inline-arities* assoc n (+ ndicts (lhs-arity b)))))

(defn- bind-name [b]
  (let [v (lval b)]
    (case (con v)
      FunBind (nm (arg v 2))
      nil)))

(defn- bind-rhs
  "A binding's [type core] (FunBind or PatBind); expected, a signature's skolemised type, checked against as GHC's
  tcPolyCheck does (its argument types pushed into the patterns before the right-hand sides: a GADT's refinement
  needs the scrutinee's type known)"
  [env b & [expected]]
  (let [v (lval b)]
    (case (con v)
      FunBind (infer-matches env (arg v 3) nil expected)
      ;; (queue 352: its guards' failure nonExhaustiveGuardsError "SPAN|pattern binding", dsGuarded's)
      PatBind (let [t (or expected (fresh-meta))]
                [t (tag-guards (infer-grhss env (arg v 4) t) (when (lsp b) [(str (span-text (lsp b)) "|pattern binding") true]))])
      (do (error! "binding not handled: " (con v)) [(fresh-meta) (list 'lit "?")]))))

(defn- restricted?
  "The monomorphism restriction's rule 1 applies to a group without signatures: a pattern binding, or a
  function binding without arguments"
  [binds]
  (some (fn [b] (let [v (lval b)]
                  (case (con v)
                    PatBind true
                    FunBind (zero? (count (lval (arg (lval (first (lval (arg (arg v 3) 2)))) 3))))
                    false)))
        binds))

(defn- dict-param [[c _]] (fresh-lv (str "$d" (occ c))))

(declare interact-deferred!)

(defn- generalize
  "Close the types of a group inferred at the level above: [tvs preds params] with the metas bound to rigid
  variables; the deferred wanteds go to the outer collection"
  [tys wanteds restricted]
  (improve-coercibles!)
  (loop [k 0] (when (and (< k 4) (interact-deferred!)) (recur (inc k))))
  (let [inner? (fn [i] (> (:level (get @*metas* i)) *level*))
        ty-metas (vec (filter inner? (distinct (mapcat metas-of tys))))
        ;; simplify: solve by instances what has a known head, keep the rest
        ;; the constraints a local binding deferred come after the group's own (GHC solves them later)
        wanteds (concat (remove :late wanteds) (filter :late wanteds))
        _ (retry-implications! false)
        wanteds (map #(under-givens % identity) wanteds)
        simplified (loop [ws wanteds out []]
                     (if (empty? ws)
                       out
                       (let [w (first ws) [c ts] (zonk-pred (:pred w))
                             inst (when (and (seq ts) (= :tc (first (first ts))) (not (eq-pred? [c ts]))) (reduce-by-instance [c ts]))
                             ;; HF10-P67 (a): a closed predicate (no meta, no type variable) solved whole by solve-pred, whose
                             ;; recursive dictionaries are a letrec (GHC's solved dictionaries): reduced here instance by instance,
                             ;; a cycle of instance contexts (T5913's L2 W => L1 W, L1 W => L2 W; tcrun030's Eq (D []) by
                             ;; Eq [D []]) pushed its own predicate again without end, the front end's memory growing until it stopped
                             closed (when (and inst (empty? (mapcat metas-of ts)) (empty? (mapcat tvs-of ts)))
                                      (solve-pred [c ts] [] 0))]
                         (cond
                           (eq-pred? [c ts])
                           (do (unify (last (butlast ts)) (last ts)) (swap! *evidence* assoc (:ev w) (list 'co)) (recur (rest ws) out))
                           closed
                           (do (swap! *evidence* assoc (:ev w) closed) (recur (rest ws) out))
                           inst
                           (let [[dfun subs] inst
                                 sws (mapv (fn [p] {:ev (fresh-id) :pred p}) subs)]
                             (swap! *evidence* assoc (:ev w)
                                    (if (empty? sws) (list 'v dfun) (list 'app (list 'v dfun) (mapv #(list 'ev (:ev %)) sws))))
                             (recur (concat (rest ws) sws) out))
                           :else (recur (rest ws) (conj out (assoc w :pred [c ts])))))))
        local (fn [w] (some inner? (mapcat metas-of (second (:pred w)))))
        [cands outer] [(vec (filter local simplified)) (vec (remove local simplified))]
        quant? (fn [w] (and (not restricted) (every? (set ty-metas) (filter inner? (mapcat metas-of (second (:pred w)))))))
        q (vec (filter quant? cands))
        deferred (vec (concat outer (remove quant? cands)))
        ;; the metas of deferred wanteds are not generalised
        _ (doseq [w deferred t (second (:pred w))] (adjust-levels! t *level*))
        _ (doseq [w deferred] (swap! *wanteds* conj (assoc w :late true)))
        gen (vec (filter inner? (distinct (mapcat metas-of tys))))
        names (mapv (fn [i] (str "t" i)) gen)
        _ (doseq [[i n] (map vector gen names)] (swap! *metas* assoc-in [i :ref] [:tv n]))
        ;; the quantified constraints, each once; the duplicates' evidence is the first's parameter
        preds (reduce (fn [acc w] (if (some #(= (zonk-pred (:pred w)) (zonk-pred (:pred %))) acc) acc (conj acc w))) [] q)
        ;; grouped by class, the classes in the order of their first constraint (GHC's inert dictionaries, a map by class)
        corder (vec (distinct (map (comp first :pred) preds)))
        preds (vec (sort-by #(.indexOf ^java.util.List corder (first (:pred %))) preds))
        ;; a constraint a superclass of another implies is not quantified (GHC's mkMinimalBySCs)
        implied? (fn [w] (some (fn [o] (and (not= o w)
                                            (some #(= (zonk-pred (:pred w)) (zonk-pred (first %)))
                                                  (rest (super-closure [[(zonk-pred (:pred o)) nil]])))))
                               preds))
        minimal (if *control* preds (vec (remove implied? preds)))
        params (mapv (fn [w] (dict-param (:pred w))) minimal)
        givens (super-closure (mapv (fn [w p] [(zonk-pred (:pred w)) p]) minimal params))]
    (doseq [w q]
      (swap! *evidence* assoc (:ev w) (solve-pred (zonk-pred (:pred w)) givens 0)))
    [names (mapv (comp zonk-pred :pred) minimal) params]))

(defn- reduce-by-instance
  "The instance whose head matches pred: [dfun [sub-pred...]], nil when none"
  [[c ts]]
  ;; HF10-P54 (a): as the solver chooses (inst-candidate): a class with functional dependencies improved from the
  ;; instances first, an overlapped instance pruned (T5759's Num (Cont Integer) by instance (Container a b, ...) => Num
  ;; a), and the instance's variables its head does not bind fresh metas (its context's b, which Container's
  ;; dependency then fixes), not left rigid; the choice not deferred for the metas (the generalization's simplification)
  (when (seq (some-> *classes* deref (get c) :fundeps)) (improve-one! [c ts]))
  (let [ts (second (zonk-pred [c ts]))]
    (when-let [[{:keys [dfun tvs ctx]} m] (inst-candidate c ts false)]
      (let [m (into (into {} (map (fn [v] [v (fresh-meta)]) (remove #(contains? m %) tvs))) m)]
        [dfun (mapv (fn [[pc pts]] [pc (mapv #(subst m %) pts)]) ctx)]))))

(def ^:dynamic *self-givens* nil) ; an instance's own dictionary and its superclasses, for its methods

(declare invert-families! interact-deferred!)

(defn- dfun-app?
  "An evidence term that applies an instance's dictionary function to dictionaries ($fShowList $fShowInt)"
  [t]
  (and (seq? t) (= 'app (first t)) (seq? (second t)) (= 'v (first (second t))) (vector? (second (second t)))
       (str/starts-with? (str (nth (second (second t)) 3)) "$f") (seq (nth t 2))))

(defn- bind-wanted!
  "GHC's evidence bindings of an implication (the binding's abs_ev_binds, dsEvBinds): a wanted solved by an instance's
  dictionary function applied to dictionaries is bound once, at the binding's level after its dictionary lambdas, to an
  evidence variable ($dFractional = $fFractionalRatio $fIntegralInteger), a wanted of the same predicate solved by the
  same variable (the inert solved dictionaries); wb the binding's atom [[lv term pred]...]. The variable, or term"
  [wb pred term & [givens]]
  (if (and wb (dfun-app? term)
           ;; (its dictionaries the binding's own: no dictionary a pattern or an inner implication binds, which the
           ;; binding's level does not have in scope)
           (let [lvs (fn [x] (filter #(and (seq? %) (= 'lv (first %))) (tree-seq coll? seq x)))
                 ok (into (set (lvs (map second givens))) (map first @wb))]
             (and (every? ok (lvs term)) (not-any? #(and (seq? %) (= 'ev (first %))) (tree-seq coll? seq term)))))
    (let [zp (zonk-pred pred)]
      (or (some (fn [[x _ p]] (when (= p zp) x)) @wb)
          (let [x (list 'lv (str "$d" (occ (first zp))) (str "ev" (swap! *counter* inc)))]
            (swap! wb conj [x term zp])
            (swap! ev-binders conj x)
            (when *ltypes* (swap! *ltypes* assoc x [:tc (first zp) (second zp)]))
            x)))
    term))

(defn- solve-with-givens!
  "Solve the wanteds of a checked binding with its givens; the unsolved are deferred. In an instance's method a
  constraint the instances solve to a dictionary variable is solved so, else by the instance's own dictionary's
  superclasses when they give it (as GHC's solver chose on the corpora). wb: bind-wanted!'s atom, the binding's evidence
  bindings (nil: each term in place)"
  [wanteds givens & [wb]]
  (improve-coercibles!)
  ;; HF10-P54 (a): in rounds, until one solves nothing: a wanted solved later in the list may improve an earlier one
  ;; (P54fd's Integral ?e before Coll c ?e, whose given's functional dependency gives ?e := e); the left deferred in
  ;; their order
  (loop [ws wanteds]
  (let [before (mapv (comp zonk-pred :pred) ws)
        left (filterv (fn [w0]
    (if-let [term (let [solve (fn [] (under-givens w0 (fn [w]
                                        (let [t (solve-pred (:pred w) givens 0)]
                                          (if (and *self-givens* (not (and (seq? t) (contains? '#{v lv} (first t)))))
                                            (or (solve-pred (:pred w) *self-givens* 0) t)
                                            t)))))]
                    ;; HF10-P34: a wanted on a kind GHC knows (SingKind ?k) recovered from the deferred family
                    ;; equalities while the givens are in scope (invert-families!)
                    (or (solve)
                        (when (and *deferred-eqs* (some #(= :mv (first (prune %))) (second (zonk-pred (:pred w0))))
                                   (loop [k 0 any false] (if (and (< k 4) (invert-families! [(:pred w0)])) (recur (inc k) true) any)))
                          (solve))))]
      (do (swap! *evidence* assoc (:ev w0) (bind-wanted! wb (:pred w0) term givens)) false)
      true))
                      ws)]
    ;; (again only when the round unified a meta: solving one cannot help another otherwise)
    (if (and (seq left) (< (count left) (count ws)) (not= before (mapv (comp zonk-pred :pred) ws)))
      (recur left)
      (doseq [w0 left] (swap! *wanteds* conj w0))))))

(defn- core-name [top? n] (if top? n (lv n)))
(defn- bind-core [top? n] (if (and top? (ext? n)) n (lv n)))

(defn- patsyn-bind?
  [b]
  (= 'PatSynBind (con (lval b))))

(defn- pat->expr
  "tcPatToExpr (GHC.Tc.TyCl.PatSyn): an implicitly bidirectional synonym's pattern as its builder's expression (a
  variable, a constructor applied, a literal, a tuple, a list, an unboxed sum, parentheses, a signature's pattern); nil
  when the pattern has none (a wildcard, a view, a bang, a lazy or an as-pattern: GHC rejects the synonym)"
  [p]
  (let [sp (when (L? p) (lsp p)) v (lval p) L* (fn [x] (list 'L sp x))
        all (fn [ps] (let [es (mapv pat->expr ps)] (when (every? some? es) es)))]
    (case (con v)
      VarPat (L* (list 'HsVar nil (arg v 2)))
      ParPat (when-let [e (pat->expr (arg v 2))] (L* (list 'HsPar nil e)))
      SigPat (pat->expr (arg v 2))
      ConPat (let [d (arg v 3)]
               (when-not (= 'RecCon (con d))
                 (when-let [es (all (pat-args d))]
                   (reduce (fn [f a] (L* (list 'HsApp nil f a))) (L* (list 'HsVar nil (arg v 2))) es))))
      TuplePat (when-let [es (all (arg v 2))] (L* (list 'ExplicitTuple nil (mapv #(list 'Present nil %) es) (arg v 3))))
      ListPat (when-let [es (all (arg v 2))] (L* (list 'ExplicitList nil es)))
      SumPat (when-let [e (pat->expr (arg v 2))] (L* (list 'ExplicitSum nil (arg v 3) (arg v 4) e)))
      LitPat (L* (list 'HsLit nil (arg v 2)))
      NPat (let [e (L* (list 'HsOverLit nil (lval (arg v 2))))]
             (if (and (seq? (arg v 3)) (= 'Just (first (arg v 3)))) (L* (list 'NegApp nil e)) e))
      nil)))

(def ^:dynamic *patsyn-builders* nil) ; atom [(fn [env] binding)...]: the builders to check after the module's bindings

(defn- void-lv [] (let [x (fresh-lv "void")] (note-type! x unit#-ty) x))

(defn- patsyn-matcher
  "tcPatSynMatcher's binding: $mP = \\req-dictionaries scrut cont fail -> case scrut of PAT -> cont prov-evidence args;
  _ -> fail (# #), the continuation applied to (# #) when the synonym has neither arguments nor provided dictionaries"
  [n params ev-binds pc prov-evs argns res-ty]
  (let [scrut (fresh-lv "scrut") cont (fresh-lv "cont") fl (fresh-lv "fail")
        args (mapv lv argns)
        k (if (and (empty? prov-evs) (empty? args)) [unit#-core] (into (vec prov-evs) args))]
    (note-type! scrut res-ty)
    (list 'bind (matcher-name n)
          (list 'lam (into (vec params) [scrut cont fl])
                (wrap-ev-binds ev-binds
                               (list 'match [scrut] [(list 'clause [pc] (list 'app cont k))
                                                     (list 'clause [(list 'pwild)] (list 'app fl [unit#-core]))]))))))

(defn- patsyn-builder
  "mkPatSynBuilder's binding $bP, checked at the builder type forall univ ex. (req, prov) => args -> res: an explicitly
  bidirectional synonym's where clause, an implicitly bidirectional one's pattern as an expression (tcPatToExpr); a
  function of (# #) first when the result is unlifted and there are no arguments and no context (need_dummy_arg); nil for
  a unidirectional synonym"
  [env psb n info argns]
  (let [dir (arg psb 5)
        explicit? (and (seq? dir) (= 'ExplicitBidirectional (first dir)))]
    (when (or explicit? (= 'ImplicitBidirectional dir))
      (let [bt (builder-type info)
            bsk (zipmap (nth bt 1) (map (fn [x] [:tv (str "sk_" x)]) (nth bt 1)))
            bpreds (mapv (fn [[c ts]] [c (mapv #(subst bsk %) ts)]) (nth bt 2))
            bparams (mapv dict-param bpreds)
            evb (atom [])
            givens (binding [*ev-binds* evb] (super-closure (mapv vector bpreds bparams)))
            bws (atom [])
            body (subst bsk (nth bt 3))
            c (binding [*level* (inc *level*) *wanteds* bws *given-eqs* (scope-givens) *scoped-tvs* (merge *scoped-tvs* bsk)]
                (assume-eqs! bpreds)
                (let [c (if explicit?
                          (let [[t c] (infer-matches env (second dir) nil body)] (unify t body) c)
                          (let [ats (mapv #(subst bsk %) (:args info))
                                env1 (reduce (fn [e [x at]] (note-type! (lv x) at) (assoc e x {:mono at})) env (map vector argns ats))]
                            (if-let [e (pat->expr (arg psb 4))]
                              (let [c (check-expr env1 e (subst bsk (:res info)))]
                                (if (seq argns) (list 'lam (mapv lv argns) c) c))
                              (do (error! "a pattern synonym's pattern without an expression: " (name-str n)) (list 'lit "?")))))]
                  (retry-implications! false)
                  c))
            _ (solve-with-givens! @bws givens)
            c (if (builder-dummy? info) (list 'lam [(void-lv)] c) c)]
        (list 'bind (builder-name n) (if (empty? bparams) c (list 'lam bparams (wrap-ev-binds @evb c))))))))

(defn- minimal-by-scs
  "mkMinimalBySCs over [[pred term]...]: a predicate a superclass of another one implies left out"
  [pds]
  (vec (remove (fn [[p _ :as x]]
                 (some (fn [[o _ :as y]] (and (not= x y) (some #(= p (first %)) (rest (super-closure [[o nil]]))))) pds))
               (reduce (fn [acc [p _ :as x]] (if (some #(= p (first %)) acc) acc (conj acc x))) [] pds))))

(defn- tc-patsyn-bind!
  "A pattern synonym's declaration (tcCheckPatSynDecl against its signature, else tcInferPatSynDecl): its pattern
  checked at the result type, the universals skolems and the required context given, the existentials metas the
  pattern's own existentials fill (Note [Checking against a pattern signature]), each argument variable at its
  argument type, the provided context wanted from what the pattern binds. Without a signature the pattern's type is
  inferred and closed over its metas, the required context the wanteds quantified over them (simplifyInfer), the
  existentials and the provided context the dictionaries the pattern binds (tcCollectEx, mkProvEvidence with Note
  [Remove redundant provided dicts]). Registers the synonym (*patsyns*) and its matcher's and builder's types;
  returns the bindings of the matcher $mP and the builder $bP (HF10-P36 (a))"
  [env b]
  (let [psb (arg (lval b) 2) n (nm (arg psb 2)) details (arg psb 3)
        [argns fields] (case (con details)
                         PrefixCon [(mapv nm (arg details 1)) nil]
                         InfixCon [[(nm (arg details 1)) (nm (arg details 2))] nil]
                         RecCon [(mapv #(nm (arg % 2)) (arg details 1)) (mapv #(nm (arg (arg % 1) 2)) (arg details 1))]
                         [[] nil])
        sig (get @*patsyns* n)
        dir (arg psb 5)
        builder? (or (= 'ImplicitBidirectional dir) (and (seq? dir) (= 'ExplicitBidirectional (first dir))))
        ws (atom [])
        matcher
        (if (:sig sig)
          (let [{:keys [univ req ex prov args res]} sig
                skol (zipmap univ (map (fn [x] [:tv (str "sk_" x)]) univ))
                m (merge skol (zipmap ex (repeatedly fresh-meta)))
                sp (fn [[c ts]] [c (mapv #(subst m %) ts)])
                req' (mapv sp req)
                params (mapv dict-param req')
                evb (atom [])
                givens (binding [*ev-binds* evb] (super-closure (mapv vector req' params)))
                [pc prov-evs]
                (binding [*level* (inc *level*) *wanteds* ws *given-eqs* (scope-givens) *scoped-tvs* (merge *scoped-tvs* skol)]
                  (assume-eqs! req')
                  (let [[env1 pc] (tc-pat env (arg psb 4) (subst m res))]
                    (doseq [[x at] (map vector argns args) :let [e (get env1 x)] :when (:mono e)] (unify (:mono e) (subst m at)))
                    (let [evs (mapv #(want! (sp %)) prov)]
                      (retry-implications! false)
                      [pc evs])))]
            (solve-with-givens! @ws givens)
            (swap! *patsyns* assoc-in [n :fields] fields)
            (register-patsyn! n (get @*patsyns* n) builder?)
            (patsyn-matcher n params @evb pc prov-evs argns (subst m res)))
          ;; tcInferPatSynDecl: the pattern inferred, its type closed over its metas
          (let [pd (atom [])
                t (binding [*level* (inc *level*)] (fresh-meta))
                [env1 pc] (binding [*level* (inc *level*) *wanteds* ws *pat-dicts* pd] (tc-pat env (arg psb 4) t))
                args (binding [*level* (inc *level*)] (mapv #(or (:mono (get env1 %)) (fresh-meta)) argns))
                [names req params] (generalize (cons t args) @ws false)
                ;; the provided context: the pattern's own dictionaries, minimal by superclasses; the existentials the
                ;; skolems they and the arguments mention
                prov (minimal-by-scs (mapv (fn [[p d]] [(zonk-pred p) d]) @pd))
                sk? (fn [x] (and (re-find #"_sk[0-9]+$" x) (not (some #{x} names))))
                ex (vec (distinct (filter sk? (mapcat (fn [x] (tvs-of (zonk x))) (concat args (mapcat second (map first prov)))))))
                info {:univ names :req req :ex ex :prov (mapv first prov) :args (mapv zonk args) :res (zonk t) :fields fields}]
            (swap! *patsyns* assoc n info)
            (register-patsyn! n info builder?)
            (patsyn-matcher n params [] pc (mapv second prov) argns (zonk t))))
        info (get @*patsyns* n)]
    ;; the builder checked after the module's bindings (tcPatSynBuilderBind), in the final environment
    (if *patsyn-builders*
      (do (swap! *patsyn-builders* conj (fn [env2] (patsyn-builder env2 psb n info argns))) [matcher])
      (vec (keep identity [matcher (patsyn-builder env psb n info argns)])))))

(defn- field-strict?
  "A constructor field's source bang (CDF ... UNPACKEDNESS STRICTNESS) strict: !, or since queue 352 any field but a ~ one
  under StrictData (GHC.Tc.TyCl's srcStrictnessFor, the Strict extension implying it)"
  [x]
  (boolean (and (seq? x) (or (some #{'SrcStrict} x)
                             (and (contains? *exts* "StrictData") (not (some #{'SrcLazy} x)))))))

(defn- strict-var-bind?
  "A strict variable binding `!x = e` (FunRhs's SrcStrict: GHC's strict binding, dsStrictBind)"
  [b]
  (boolean (some (fn [x] (and (seq? x) (= 'FunRhs (first x)) (some #{'SrcStrict} x))) (take 400 (tree-seq coll? seq b)))))

(defn- strict-ext-var-bind?
  "Queue 352: a variable binding (a FunBind of no argument) made strict by the Strict extension: not ~x (FunRhs's SrcLazy)"
  [b]
  (let [v (lval b) ms (when (= 'FunBind (con v)) (lval (arg (arg v 3) 2))) m (when (= 1 (count ms)) (lval (first ms)))]
    (boolean (and (contains? *exts* "Strict") m (empty? (lval (arg m 3)))
                  (let [ctx (arg m 2)] (not (and (seq? ctx) (some #{'SrcLazy} ctx))))))))

(defn tc-group
  "A binding group: [env' [(bind B core)...]]; sigs {NAME type}"
  [env [rec binds] sigs top?]
  (let [psbs (vec (mapcat #(tc-patsyn-bind! env %) (filter patsyn-bind? binds)))
        ;; a let's strict variable bindings: the body forces each (dsStrictBind: let x = e in x `seq` body)
        _ (when (and *strict-binds* (= (inc *level*) (:level *strict-binds*)))
            ;; (queue 352: under Strict a variable binding `x = e` too, recursive or not, unless ~x: dsLocalBinds' strict binds,
            ;; Binds.hs's force_var)
            (doseq [b binds :when (and (bind-name b) (or (strict-var-bind? b) (strict-ext-var-bind? b)))]
              (swap! (:atom *strict-binds*) conj [(bind-name b) (list 'pbang (list 'pwild))])))
        binds (vec (remove patsyn-bind? binds))
        names (mapv bind-name binds)
        signed (filter #(get sigs (bind-name %)) binds)
        unsigned (remove #(get sigs (bind-name %)) binds)
        ;; the signed binders are polymorphic everywhere
        env (reduce (fn [e b] (let [n (bind-name b)] (assoc e n {:poly (get sigs n) :sig true :core (if top? (list 'v n) (lv n))}))) env signed)
        ;; the unsigned ones: inferred together; a pattern binding binds every variable of its pattern
        [env out1]
        (if (empty? unsigned)
          [env []]
          (let [ws (atom [])
                entries (mapv (fn [b] (mapv (fn [n] [n (binding [*level* (inc *level*)] (fresh-meta))])
                                            (if-let [n (bind-name b)] [n] (pat-binders (arg (lval b) 2)))))
                              unsigned)
                all (vec (apply concat entries))
                results (binding [*level* (inc *level*) *wanteds* ws]
                          (let [env1 (reduce (fn [e [n t]] (assoc e n {:mono t :core (lv n)})) env all)]
                            (mapv (fn [b es]
                                    (if (bind-name b)
                                      (let [[t1 c] (bind-rhs env1 b)] (unify (second (first es)) t1) [[(ffirst es) c]])
                                      (let [t (fresh-meta)
                                            ;; (queue 352: its guards' failure "SPAN|pattern binding", as bind-rhs's)
                                            c (tag-guards (infer-grhss env1 (arg (lval b) 4) t)
                                                          (when (lsp b) [(str (span-text (lsp b)) "|pattern binding") true]))
                                            [env2 pc] (tc-pat env1 (arg (lval b) 2) t)]
                                        (doseq [[n m] es] (unify m (:mono (get env2 n))))
                                        ;; the right-hand side bound once, each variable selected from it
                                        (let [pn ["loc" "var" "pat" (str "u" (fresh-id))]]
                                          ;; a banged pattern binding (`let !(Just (Just y)) = e in b`, GHC's strict pattern
                                          ;; binding, dsStrictBind): the whole match forced before the let's body (T11601)
                                          (let [pv (lval (arg (lval b) 2))]
                                            ;; (queue 352: under Strict any pattern binding but ~p, decideBangHood in dsHsBind: DsStrictLet's
                                            ;; `False = e` forced)
                                            ;; (369-1 (a): not a where clause's pattern binding of an unlifted variable, `where
                                            ;; !(I# maxInt#) = maxInt`: its selection is a case at the binding already
                                            ;; (dsUnliftedBind); the force made a second case of the same scrutinee, Enum's
                                            ;; $dmenumFrom. A let's is forced as before: `let !(# s1, x #) = ...` needs it)
                                            (when (and *strict-binds* (= *level* (:level *strict-binds*))
                                                       (or (and (= 'BangPat (con pv)) (not= 'VarPat (con (lval (arg pv 2)))))
                                                           (and (contains? *exts* "Strict") (not= 'LazyPat (con pv))))
                                                       (not (and (:where *strict-binds*) (some (fn [[_ m]] (unlifted-ty? (zonk m))) es))))
                                              (let [sm (into {} (map (fn [[x _]] [(lv x) (list 'lv (occ x) (str "sel" (fresh-id)))]) es))]
                                                (swap! (:atom *strict-binds*) conj [pn (substitute sm (strict-pat pc))]))))
                                          ;; each selector's pattern variables locals of its own (the top level's
                                          ;; rename-mono turns the binders' names into the globals)
                                          (into [[pn c]] (mapv (fn [[n _]]
                                                                 (let [sm (into {} (map (fn [[x _]] [(lv x) (list 'lv (occ x) (str "sel" (fresh-id)))]) es))]
                                                                   [n (list 'match [(lv pn)] [(list 'clause [(substitute sm pc)] (get sm (lv n)))])]))
                                                               es))))))
                                  unsigned entries)))
                results (vec (apply concat results))
                ;; HF10-P43 (a): the main module's main without a signature is an IO action (GHC.Tc.Module's checkMain:
                ;; main :: IO t, the type unified before its group is generalized; `main = return undefined`)
                _ (when top?
                    (doseq [[n t] all :when (and (vector? n) (= "main" (occ n)) (= "Main" *module*))]
                      (unify t [:tc io-tc [(fresh-meta)]])))
                [tvs preds params] (generalize (mapv second all) @ws (restricted? unsigned))
                _ (when top? (doseq [b unsigned :let [n (bind-name b)] :when n] (note-inline-arity! n b (count params))))
                env' (reduce (fn [e [n t]] (assoc e n {:poly [:forall tvs preds (zonk t)] :core (if top? (list 'v n) (lv n))}))
                             env all)
                self-rec? (fn [[n c]] (let [me (lv n)] ((fn occ? [x] (cond (= x me) true (coll? x) (boolean (some occ? x)) :else false)) c)))
                out (cond
                      ;; GHC's dsAbsBinds for one exported binder without a signature: the global bound to a letrec
                      ;; of the monomorphic binding (a self-recursive one keeps it; the -O0 Simplifier's input)
                      (and (empty? params) *abs-binds* (= 1 (count all)) (= 1 (count results)) (self-rec? (first results)))
                      (let [[n c] (first results)
                            mono (list 'lv (occ n) (str "mono" (fresh-id)))]
                        (swap! *ltypes* assoc mono (second (first all)))
                        [(list 'bind (bind-core top? n) (list 'letrec [(list 'bind mono (substitute {(lv n) mono} c))] mono))])
                      (empty? params)
                      ;; no dictionaries: the monomorphic references are the binders themselves
                      (mapv (fn [[n c]] (list 'bind (bind-core top? n) (if top? (reduce (fn [c [m _]] (rename-mono c m)) c all) c)))
                            results)
                      :else
                      ;; GHC's AbsBinds: each binder abstracted over the dictionaries, the group's monomorphic
                      ;; bindings inside (a letrec when recursive)
                      (let [monos (into {} (map (fn [[n _]] [(lv n) (list 'lv (occ n) (str "mono" (fresh-id)))]) all))
                            _ (doseq [[n t] all] (note-type! (get monos (lv n)) t))
                            inner (mapv (fn [[n c]] [n (substitute monos c)]) results)]
                        (mapv (fn [[n c]]
                                (list 'bind (bind-core top? n)
                                      (list 'lam params
                                            (if (and (= rec 'nonrec) (= 1 (count inner)))
                                              c
                                              (list 'letrec (mapv (fn [[m c2]] (list 'bind (get monos (lv m)) c2)) inner)
                                                    (get monos (lv n)))))))
                              inner)))]
            ;; HF10-P32: a local binder's type for tostg's representations (an unsigned local function's result, a State#
            ;; loop's: thawSTArray's `case copy 0# s2# of s3# -> ...` was bound by a lazy let, its writes never run), the
            ;; abstracted ones' monomorphic binders too
            (when-not top?
              (doseq [[n t] all]
                (note-type! (lv n) (if (or (seq tvs) (seq preds)) [:forall tvs preds t] t))))
            [env' out]))
        ;; the signed ones: checked against their signatures
        out2 (vec (for [b signed]
                    (let [n (bind-name b)
                          s (get sigs n)
                          skol (zipmap (nth s 1) (map (fn [x] [:tv (str "sk_" x)]) (nth s 1)))
                          body (subst skol (nth s 3))
                          [body inner-preds] (if (= :forall (first body)) [(nth body 3) (nth body 2)] [body []])
                          preds (into (mapv (fn [[c ts]] [c (mapv #(subst skol %) ts)]) (nth s 2)) inner-preds)
                          params (mapv dict-param preds)
                          evb (atom [])
                          wb (atom [])
                          givens (binding [*ev-binds* evb] (super-closure (mapv vector preds params)))
                          ws (atom [])
                          c (binding [*level* (inc *level*) *wanteds* ws *scoped-tvs* (merge *scoped-tvs* skol)
                                      *given-eqs* (scope-givens)]
                              ;; (HF10-P50 (a): the superclasses' equalities too, ClassDecode a's Share a ~ a)
                              (assume-eqs! (map first givens))
                              (let [[t c] (bind-rhs env b body)] (unify t body) (retry-implications! false) c))]
                      (solve-with-givens! @ws givens wb)
                      (when top? (note-inline-arity! n b (count params)))
                      ;; HF10-P32: a signed local binder's type, as an unsigned one's
                      (when-not top? (note-type! (lv n) s))
                      (list 'bind (bind-core top? n) (if (empty? params)
                                                       (wrap-ev-binds (mapv (fn [[x t]] [x t]) @wb) c)
                                                       (list 'lam params (wrap-ev-binds (into @evb (map (fn [[x t]] [x t])) @wb) c)))))))]
    [env (-> psbs (into out1) (into out2))]))

(defn- rename-mono
  "A top-level binding's monomorphic references (lv of its own name) as the binder itself"
  [c n]
  (let [me (lv n)]
    (letfn [(w [x] (cond (= x me) (list 'v n)
                         (seq? x) (apply list (map w x))
                         (vector? x) (mapv w x)
                         :else x))]
      (w c))))

(defn- sigs-of
  "Type signatures {NAME type}"
  [sigs]
  (into {} (for [s sigs :let [v (lval s)] :when (= 'TypeSig (con v))
                 nl (arg v 2)]
             (do (when *tv-kinds*
                   (let [ks (sig-tv-kinds (arg (arg v 3) 2))] (when (seq ks) (swap! *tv-kinds* assoc (nm nl) ks))))
                 [(nm nl) (sig-type (arg (arg v 3) 2))]))))

(defn tc-local-binds
  "(HsValBinds ext (ValBindsRn [groups] sigs)) or empty: [env' [(bind ...)...]]"
  [env lb]
  (if (= 'HsValBinds (con lb))
    (let [vb (arg lb 2) groups (arg vb 1) sigs (sigs-of (arg vb 2))]
      (reduce (fn [[env out] g] (let [[env1 bs] (tc-group env [(arg g 1) (arg g 2)] sigs false)]
                                  ;; a recursive group stays one letrec (nested lets would hide its inner uses)
                                  [env1 (if (and (= 'rec (arg g 1))
                                                 (some (fn [b] (some (fn [b2] (pos? (occurrences (second b2) (nth b 2)))) bs)) bs))
                                          (conj out (list 'rec-group bs))
                                          (into out bs))]))
              [env []] groups))
    (if (= 'HsIPBinds (con lb))
      ;; ImplicitParams' let ?x = e (GHC.Tc.Gen.Bind's tcLocalBinds of HsIPBinds): each value bound to a dictionary
      ;; variable (IP's dictionary C:IP e), given to the body: the body's wanted ?x is that variable (*ip-givens*)
      (reduce (fn [[env out] b]
                (let [bv (lval b) n (second (lval (arg bv 2))) [t c] (infer env (arg bv 3)) d (fresh-lv (str "$dIP" n))]
                  [(update env ::ip (fnil conj []) [n t d])
                   (conj out (list 'bind d (list 'app (list 'v (ext-name "var" "GHC.Internal.Classes" "C:IP")) [c])))]))
              [env []] (arg (arg lb 2) 2))
      [env []])))

(defn- wrap-lets
  "Local bindings around a body: a let per binding, a letrec per recursive group"
  [binds body]
  (reduce (fn [body b] (if (= 'rec-group (first b)) (list 'letrec (second b) body) (list 'let [b] body)))
          body (reverse binds)))

;;; ------------------------------------------------------------------------------------------
;;; Declarations: data types, classes, instances

(defn- qtvs-names [qtvs]
  (vec (keep (fn [t] (let [b (arg (lval t) 3)] (when (= 'HsBndrVar (con b)) (nm (arg b 2))))) (arg qtvs 2))))

(def constructor-classes
  #{"Functor" "Applicative" "Monad" "Foldable" "Traversable" "MonadFail" "Alternative" "MonadPlus" "MonadFix" "MonadZip"
    ;; Generic1's head drops the last parameter too (a class of type constructors), its context empty
    "Generic1"})

;; a deriving strategy written in a clause or a standalone declaration (a Maybe of an LDerivStrategy): [:stock],
;; [:newtype], [:anyclass] or [:via SIG]; nil when none is written
(defn- strategy-of [mb]
  (when (and (seq? mb) (= 'Just (first mb)))
    (let [s (lval (second mb))]
      (case (con s)
        StockStrategy [:stock]
        NewtypeStrategy [:newtype]
        AnyclassStrategy [:anyclass]
        ViaStrategy [:via (arg (arg s 1) 2)]
        nil))))

(defn- fam-eqn
  "A FamEqn (ext name outer [arg...] fixity rhs) as a family branch {:tvs :lhs :rhs}: its type arguments (@k:
  kinds) left out as every kind"
  [e]
  (let [tvn (tv-names-of [(arg e 3) (arg e 4) (arg e 6)])
        names (mapv #(str (occ %) "_" (str/join "_" (drop 3 %))) tvn)
        tvs (zipmap tvn (map (fn [x] [:tv x]) names))]
    {:tvs names
     :lhs (vec (for [a (arg e 4) :when (and (seq? a) (= 'HsValArg (first a)))] (hs-type tvs (arg a 2))))
     :rhs (hs-type tvs (arg e 6))}))

(defn- fam-decl!
  "A type family's declaration (FamilyDecl ext info top name tyvars fixity result injectivity): an open family
  registered, a closed one with its branches and their incompatibilities (computeAxiomIncomps), a data family as
  one (never reduced)"
  [fd]
  (when *families*
    (let [info (arg fd 2) n (nm (arg fd 4))
          eqns (when (and (seq? info) (= 'ClosedTypeFamily (first info)) (seq? (second info)) (= 'Just (first (second info))))
                 (mapv (comp fam-eqn lval) (second (second info))))]
      (swap! *families* update n
             (fn [old] (merge {:eqns []} old
                              {:flavour (cond (= 'DataFamily info) :data eqns :closed :else :open)
                               :arity (count (arg (arg fd 5) 2))}
                              (when eqns {:eqns (binding [fam/*family?* (fn [x] (contains? @*families* x))]
                                                  (fam/compute-incomps eqns))})))))))

(def ^:dynamic *own-fam-insts* nil) ; atom [[FAMILY eqn]...]: the module's own open family instances (HF10-P3: its interface's)

(defn- tyfam-inst!
  "A type family instance (TyFamInstDecl ext eqn): an equation of its open family"
  [tfi]
  (when *families*
    (let [e (arg tfi 2) eqn (fam-eqn e)]
      (when *own-fam-insts* (swap! *own-fam-insts* conj [(nm (arg e 2)) eqn]))
      (swap! *families* update (nm (arg e 2)) (fn [old] (update (merge {:flavour :open} old) :eqns (fnil conj []) eqn))))))

(defn- free-tvs
  "The type variables of t not bound by a forall inside it"
  [t]
  (case (first t)
    :tv #{(second t)}
    :tc (reduce into #{} (map free-tvs (nth t 2)))
    :app (into (free-tvs (nth t 1)) (free-tvs (nth t 2)))
    :forall (apply disj (reduce into (free-tvs (nth t 3)) (map (fn [[_ ts]] (reduce into #{} (map free-tvs ts))) (nth t 2)))
                   (nth t 1))
    #{}))

(defn- selector-type [names res t]
  (if (every? (free-tvs res) (free-tvs t)) [:forall names [] (fn-ty res t)] [:forall [] [] [:tc (tuple-tc 0) []]]))

(defn- con-names
  "The constructors a ConDecl declares: a GADT declaration may name several (A, B :: T)"
  [cv]
  (if (= 'ConDeclGADT (con cv)) (mapv nm (arg cv 2)) [(nm (arg cv 2))]))

(defn- gadt-con!
  "A GADT constructor (ConDeclGADT ext names outer inner ctx args res doc) of type constructor tn with ntvs
  parameters, its tag tag: its type the signature's (GHC's dataConWrapperType: forall tvs. ctx => args -> T res),
  and GHC.Tc.TyCl's rejigConRes's split of its result: a result argument that is a type variable not seen before
  is universal at its position, any other an equality spec (the universal at that position ~ the argument), the
  rest of the variables existential. Returns the deriving description."
  [tn cv cn tag]
  (let [tvn (tv-names-of [(arg cv 3) (arg cv 4) (arg cv 5) (arg cv 6) (arg cv 7)])
        names (mapv #(str (occ %) "_" (str/join "_" (drop 3 %))) tvn)
        tvs (zipmap tvn (map (fn [x] [:tv x]) names))
        ctx (when (and (seq? (arg cv 5)) (= 'Just (first (arg cv 5))))
              (vec (keep (fn [ct] (let [p (hs-type tvs ct)] (case (first p) :tc [(second p) (nth p 2)] (:tv :app) [:cvar [p]] nil))) (lval (second (arg cv 5))))))
        cdf-type (fn [f] (hs-type tvs (last (butlast f))))
        det (arg cv 6)
        fields (when (= 'RecConGADT (con det))
                 (vec (mapcat (fn [f] (let [fv (lval f) t (cdf-type (arg fv 3))]
                                        (map (fn [fo] [(nm (arg (lval fo) 2)) t]) (arg fv 2))))
                              (lval (arg det 2)))))
        cdfs (case (con det) PrefixConGADT (arg det 2) RecConGADT (mapcat (fn [f] (let [fv (lval f)] (repeat (count (arg fv 2)) (arg fv 3)))) (lval (arg det 2))) [])
        argtys (case (con det) PrefixConGADT (mapv cdf-type (arg det 2)) RecConGADT (mapv second fields) [])
        res (expand (hs-type tvs (arg cv 7)))
        rargs (if (= :tc (first res)) (nth res 2) [])
        [univ eqs] (reduce (fn [[u e] [i t]]
                             (if (and (= :tv (first t)) (not (contains? (set (vals u)) (second t))))
                               [(assoc u i (second t)) e]
                               [u (assoc e i t)]))
                           [{} {}] (map-indexed vector rargs))
        ty (reduce (fn [acc a] (fn-ty a acc)) res (reverse argtys))]
    (swap! *genv* assoc cn [:forall names (vec ctx) ty])
    (doseq [[f t] fields] (swap! *genv* assoc f (selector-type names res t)))
    (swap! *cons* assoc cn {:arity (+ (count ctx) (count argtys)) :tycon tn :fields (mapv first fields)
                            :dicts (count ctx) :tag tag
                            :gadt {:univ univ :eqs eqs :tvs names :ctx (vec ctx) :args argtys :nres (count rargs)
                                   ;; HF10-P45 (a): the explicit binders' kind annotations, for the kind inference
                                   :tv-anns (let [o (arg cv 3) o (if (L? o) (lval o) o)]
                                              (when (and (seq? o) (= 'HsOuterExplicit (con o)))
                                                (into {} (for [b (arg o 2) :let [x (lval b) bb (arg x 3) kb (arg x 4)]
                                                               :when (and (seq? bb) (= 'HsBndrVar (con bb)) (seq? kb) (= 'HsBndrKind (con kb)))
                                                               :let [n (nm (arg bb 2))
                                                                     k (binding [*errors* nil] (try (hs-type tvs (arg kb 2)) (catch Throwable _ nil)))]
                                                               :when (and n k (get tvs n))]
                                                           [(second (get tvs n)) k]))))
                                   ;; the result's tycon: a data instance's family (its constructors build the family's
                                   ;; application, as dataConOrigResTy), else the type's own
                                   :tycon (when (= :tc (first res)) (second res))}
                            :strict (into (vec (repeat (count ctx) false))
                                          (for [x cdfs] (let [x (if (and (seq? x) (= 'L (first x))) (nth x 2) x)]
                                                          (field-strict? x))))})
    {:name cn :arity (count argtys) :labels (mapv first fields) :infix? false :tys argtys}))

(defn- tv-kind-anns
  "HF10-P41 (a): a declaration's binders' kind signatures, (t :: k): {TV kind} (the kind's variables by occurrence)"
  [qtvs]
  (into {} (for [t (arg qtvs 2)
                 :let [x (lval t) bb (arg x 3) kb (arg x 4)]
                 :when (and (seq? bb) (= 'HsBndrVar (con bb)) (seq? kb) (= 'HsBndrKind (con kb)))
                 :let [n (nm (arg bb 2)) k (binding [*errors* nil] (try (hs-type {} (arg kb 2)) (catch Throwable _ nil)))]
                 :when k]
             [(str (occ n) "_" (str/join "_" (drop 3 n))) k])))

(defn- replace-metas [m t]
  (case (first t)
    :mv (get m (second t) t)
    :tc [:tc (second t) (mapv #(replace-metas m %) (nth t 2))]
    :app (mk-app (replace-metas m (nth t 1)) (replace-metas m (nth t 2)))
    t))

(defn- promote-kind-names
  "A kind's promoted constructors written without their quote in a kind signature ((a :: TYPE DoubleRep)): the renamer's
  type-level name, made the data constructor's when no type constructor, synonym or class has it"
  [k]
  (let [k (prune k)]
    (if (= :tc (first k))
      (let [n (second k)
            n (if (and (vector? n) (= "tc" (nth n 1))
                       (not (or (contains? @*tycons* n) (some-> *tc-kinds* deref (contains? n))
                                (contains? @*syns* n) (contains? @*classes* n)))
                       (contains? @*genv* (assoc n 1 "data")))
                (assoc n 1 "data") n)]
        [:tc n (mapv promote-kind-names (nth k 2))])
      k)))

(defn- infer-tycon-kinds!
  "HF10-P41 (a): the module's own data types' and newtypes' kinds (GHC.Tc.TyCl's kcTyClGroup for declarations without a
  standalone kind signature, the module one group): each parameter's kind a meta (its signature's when written), unified
  with its uses in the constructors (a field's kind Type, a GADT result's arguments the parameters' kinds, an
  application's argument the function's parameter kind); the metas left are generalized under PolyKinds (the tycon's
  kind variables, in order of first occurrence: its invisible binders) and defaulted to Type without it. :kind of each
  tycon's *tycons* entry. HF10-P45 (a): the module's own classes too (:kind of each *classes* entry: their parameters'
  kinds from the superclasses and the methods' types, Quasi :: (Type -> Type) -> Constraint), a GADT constructor's
  binders' kind annotations (forall k (a :: k): a's kind k, k a Type), and a standalone kind signature whose foralls
  lead (saks: {TYCON kind}) the tycon's kind as written, not inferred"
  [m poly? & [saks]]
  (doseq [[n k] saks]
    (cond (get @*tycons* n) (swap! *tycons* assoc-in [n :kind] k)
          (get @*classes* n) (swap! *classes* assoc-in [n :kind] k)))
  (let [own (vec (for [[n info] @*tycons* :when (and (= m (nmod n)) (:tvs info) (#{'data 'newtype} (:flavour info))
                                                     (not (contains? saks n))
                                                     (not (str/starts-with? (occ n) "R:"))
                                                     ;; the unboxed tuples and sums: representation-polymorphic (TupleN# ::
                                                     ;; forall r1 .. rn. TYPE r1 -> ..), beyond a kind of metas
                                                     (not (re-matches #"(Tuple|Sum)[0-9]+#" (str (occ n)))))]
                   [n info]))
        classes (vec (for [[cn ci] @*classes* :when (and (= m (nmod cn)) (seq (:tvs ci)) (not (contains? saks cn)))] [cn ci]))
        ckinds (into {} (for [[cn ci] classes] [cn (mapv (fn [_] (fresh-meta)) (:tvs ci))]))
        ;; each declaration's kind variables (its signatures' k): metas of its own
        kvars (into {} (for [[n _] own] [n (atom {})]))
        tv-meta (fn [env t] (letfn [(w [t] (case (first t)
                                              :tv (or (get @env (second t)) (let [x (fresh-meta)] (swap! env assoc (second t) x) x))
                                              :tc [:tc (second t) (mapv w (nth t 2))]
                                              :app (mk-app (w (nth t 1)) (w (nth t 2)))
                                              t))]
                              (w t)))
        pkinds (into {} (for [[n info] own]
                          [n (mapv (fn [tv] (if-let [a (get (:tv-anns info) tv)] (tv-meta (get kvars n) a) (fresh-meta)))
                                   (:tvs info))]))]
    (doseq [[n _] own]
      (swap! *tycons* assoc-in [n :kind] (reduce (fn [acc k] (fn-ty k acc)) star-kind (reverse (get pkinds n)))))
    ;; HF10-P45 (a): the own classes' parameters, metas of their own, their kinds Constraint's arrows while it runs
    (doseq [[cn ci] classes]
      (swap! *classes* assoc-in [cn :kind] (reduce (fn [acc k] (fn-ty k acc)) constraint-kind (reverse (get ckinds cn)))))
    (doseq [[cn ci] classes]
      (binding [*kind-env* (atom (zipmap (:tvs ci) (get ckinds cn)))]
        (doseq [[c ts] (:supers ci) :when (not= :qc c)] (soft-unify (kind-of (if (= :cvar c) (first ts) [:tc c ts])) constraint-kind))
        (doseq [mn (:methods ci) :let [t (get @*genv* mn)] :when (and (vector? t) (= :forall (first t)))]
          (soft-unify (kind-of (nth t 3)) [:tc type-tc [(fresh-meta)]]))))
    (doseq [[n info] own c (:cons info) :let [t (get @*genv* c)] :when t]
      (binding [*kind-env* (atom (merge @(get kvars n) (zipmap (:tvs info) (get pkinds n))))]
        ;; HF10-P45 (a): a GADT constructor's binders' kind annotations (SomeKindedTypeRep :: forall k (a :: k). ...): the
        ;; binder's kind the annotation, each variable of it a kind of its own value (a meta of the constructor's) and Type
        (when-let [anns (get-in @*cons* [c :gadt :tv-anns])]
          (let [kvs (distinct (for [[_ k] anns x (tree-seq coll? seq k) :when (and (vector? x) (= :tv (first x)))] (second x)))
                vals (zipmap kvs (map (fn [_] (fresh-meta)) kvs))]
            (doseq [x kvs] (soft-unify (kind-of [:tv x]) star-kind))
            (doseq [[tv k] anns] (soft-unify (kind-of [:tv tv]) (subst vals k)))))
        (let [[vs ctx body] (if (= :forall (first t)) [(nth t 1) (nth t 2) (nth t 3)] [[] [] t])
              args (loop [b body out []] (if (and (= :tc (first b)) (= fun-tc (second b)) (= 2 (count (nth b 2))))
                                           (recur (second (nth b 2)) (conj out (first (nth b 2)))) [out b]))
              [fields res] args]
          ;; the result's arguments: the parameters' kinds (a variable's kind is its parameter's)
          (when (= :tc (first res))
            (doseq [[i a] (map-indexed vector (nth res 2)) :let [pk (get-in pkinds [n i])] :when pk]
              (soft-unify (kind-of a) pk)))
          ;; the constructor's context: each a Constraint (DictBox's c)
          (doseq [[c ts] ctx] (soft-unify (kind-of (if (= :cvar c) (first ts) [:tc c ts])) constraint-kind))
          (doseq [f fields] (soft-unify (kind-of f) star-kind)))))
    ;; a representation variable is not generalized (GHC defaults a kind's RuntimeRep variables to LiftedRep): TYPE ?r
    ;; is Type
    (let [lifted (first (nth (deep-expand star-kind) 2 [nil]))]
      (doseq [[cn _] classes x (tree-seq coll? seq (zonk (get-in @*classes* [cn :kind])))
              :when (and (vector? x) (= :tc (first x)) (= type-tc (second x)) (= 1 (count (nth x 2))) (= :mv (first (prune (first (nth x 2))))))]
        (when lifted (soft-unify (first (nth x 2)) lifted)))
      (doseq [[n _] own x (tree-seq coll? seq (zonk (get-in @*tycons* [n :kind])))
              :when (and (vector? x) (= :tc (first x)) (= type-tc (second x)) (= 1 (count (nth x 2))) (= :mv (first (prune (first (nth x 2))))))]
        (when lifted (soft-unify (first (nth x 2)) lifted))))
    (doseq [[n _] own]
      (let [k (zonk (get-in @*tycons* [n :kind]))
            ;; TYPE LiftedRep written as Type
            k (letfn [(w [t] (cond (= t (deep-expand star-kind)) star-kind
                                   (= :tc (first t)) [:tc (second t) (mapv w (nth t 2))]
                                   :else t))]
                (w k))
            ms (metas-of k)]
        (if (and poly? (seq ms))
          (let [names (mapv #(str "k" %) (range (count ms)))]
            (swap! *tycons* assoc-in [n :kind] [:forall names [] (replace-metas (zipmap ms (map (fn [x] [:tv x]) names)) k)]))
          (swap! *tycons* assoc-in [n :kind] (default-kind k)))
        (swap! *tycons* update-in [n :kind] (fn [k] (if (= :forall (first k)) (assoc k 3 (promote-kind-names (nth k 3))) (promote-kind-names k))))))
    ;; HF10-P45 (a): the classes' kinds closed as the data types' (TYPE LiftedRep as Type, the metas left generalized
    ;; under PolyKinds, else Type)
    (doseq [[cn _] classes]
      (let [k (zonk (get-in @*classes* [cn :kind]))
            k (letfn [(w [t] (cond (= t (deep-expand star-kind)) star-kind
                                   (= :tc (first t)) [:tc (second t) (mapv w (nth t 2))]
                                   :else t))]
                (w k))
            ms (metas-of k)]
        (swap! *classes* assoc-in [cn :kind]
               (if (and poly? (seq ms))
                 (let [names (mapv #(str "k" %) (range (count ms)))]
                   [:forall names [] (replace-metas (zipmap ms (map (fn [x] [:tv x]) names)) k)])
                 (default-kind k)))))))

(defn- data-decl!
  "A data or newtype declaration (DataDecl ext name tyvars fixity defn); with opts a data family instance's: :tn its
  representation tycon (GHC's R:FamTys), :tvn its variables, :res-of its head (the family applied to its patterns)
  from the variables' map, :defn its HsDataDefn"
  [m d & [opts]]
  (let [tn (or (:tn opts) (nm (arg d 2))) tvn (or (:tvn opts) (qtvs-names (arg d 3)))
        names (mapv #(str (occ %) "_" (str/join "_" (drop 3 %))) tvn)
        tvs (zipmap tvn (map (fn [x] [:tv x]) names))
        res (if-let [f (:res-of opts)] (f tvs) [:tc tn (mapv (fn [x] [:tv x]) names)])
        defn* (or (:defn opts) (arg d 5)) cs (arg defn* 5)
        conlist (case (con cs) DataTypeCons (arg cs 2) NewTypeCon [(arg cs 1)] [])
        descs (atom [])]
    (when *tycons*
      (swap! *tycons* assoc tn (cond-> {:flavour (if (= 'NewTypeCon (con cs)) 'newtype 'data) :tvs names
                                        :cons (vec (mapcat (fn [c] (con-names (lval c))) conlist))}
                                 ;; HF10-P41 (a): its parameters' kind signatures ((t :: k)), for the kind inference
                                 (not opts) (assoc :tv-anns (tv-kind-anns (arg d 3))))))
    (doseq [c conlist :when (= 'ConDeclGADT (con (lval c)))
            :let [allc (vec (mapcat (fn [c] (con-names (lval c))) conlist))]
            cn (con-names (lval c))]
      (swap! descs conj (gadt-con! tn (lval c) cn (inc (.indexOf ^java.util.List allc cn)))))
    (doseq [c conlist :when (not= 'ConDeclGADT (con (lval c)))]
      (let [cv (lval c) cn (nm (arg cv 2)) det (arg cv 6)
            ;; an existential constructor (ExistentialQuantification): its own type variables and context; the
            ;; context's dictionaries are the worker's first fields (GHC.Core.DataCon's dcOtherTheta)
            exn (when (= 'ConDeclH98 (con cv))
                  (vec (keep (fn [b] (let [bv (lval b) bb (arg bv 3)] (when (= 'HsBndrVar (con bb)) (nm (arg bb 2))))) (arg cv 4))))
            exnames (mapv #(str (occ %) "_" (str/join "_" (drop 3 %))) exn)
            tvs (merge tvs (zipmap exn (map (fn [x] [:tv x]) exnames)))
            ctx (when (and (= 'ConDeclH98 (con cv)) (seq? (arg cv 5)) (= 'Just (first (arg cv 5))))
                  (vec (keep (fn [ct] (let [p (hs-type tvs ct)] (case (first p) :tc [(second p) (nth p 2)] (:tv :app) [:cvar [p]] nil))) (lval (second (arg cv 5))))))
            cdf-type (fn [f] (hs-type tvs (last (butlast f))))
            fields (when (= 'RecCon (con det))
                     (vec (mapcat (fn [f] (let [fv (lval f) t (cdf-type (arg fv 3))]
                                            (map (fn [fo] [(nm (arg (lval fo) 2)) t]) (arg fv 2))))
                                  (lval (arg det 1)))))
            argtys (case (con det)
                     PrefixCon (mapv cdf-type (last (rest det)))
                     InfixCon [(cdf-type (arg det 1)) (cdf-type (arg det 2))]
                     RecCon (mapv second fields)
                     [])
            ty (reduce (fn [acc a] (fn-ty a acc)) res (reverse argtys))]
        (swap! *genv* assoc cn [:forall (into names exnames) (vec ctx) ty])
        ;; a field's selector: forall tvs. T tvs -> field type; a naughty one (its type mentions an existential) has
        ;; type () (GHC.Tc.TyCl.Utils' mkOneRecordSelector: is_naughty, sel_ty = unitTy)
        (doseq [[f t] fields] (swap! *genv* assoc f (selector-type names res t)))
        (swap! descs conj {:name cn :arity (count argtys) :labels (mapv first fields) :infix? (= 'InfixCon (con det)) :tys argtys
                           ;; HF10-P34: each field's source bang [unpackedness strictness] (HsSrcBang's), Generic's MetaSel
                           :bangs (vec (for [x (case (con det)
                                                 PrefixCon (last (rest det))
                                                 InfixCon [(arg det 1) (arg det 2)]
                                                 RecCon (mapcat (fn [f] (let [fv (lval f)] (repeat (count (arg fv 2)) (arg fv 3)))) (lval (arg det 1)))
                                                 [])]
                                         (let [x (if (and (seq? x) (= 'L (first x))) (nth x 2) x)]
                                           (if (and (seq? x) (= 'CDF (first x))) [(nth x 2 nil) (nth x 3 nil)] [nil nil]))))})
        (swap! *cons* assoc cn {:arity (+ (count ctx) (count argtys)) :tycon tn :fields (mapv first fields)
                                :ex (count exnames) :dicts (count ctx)
                                :tag (inc (.indexOf ^java.util.List (vec (mapcat (fn [c] (con-names (lval c))) conlist)) cn))
                                :strict (into (vec (repeat (count ctx) false)) (for [x (case (con det)
                                                       PrefixCon (last (rest det))
                                                       InfixCon [(arg det 1) (arg det 2)]
                                                       RecCon (mapcat (fn [f] (let [fv (lval f)] (repeat (count (arg fv 2)) (arg fv 3)))) (lval (arg det 1)))
                                                       [])]
                                                   (let [x (if (and (seq? x) (= 'L (first x))) (nth x 2) x)] (field-strict? x))))})))
    ;; the derived instances: the stock classes' requests are kept for derive-all! (HF4), the others enter the table
    ;; with the context approximated as before
    (let [used (set (for [c conlist x (tree-seq coll? seq (lval c))
                          :when (and (seq? x) (= 'rn/name (first x)) (= "tv" (nth (second x) 1)))] (second x)))
          desc {:tn tn :cons @descs :fix @*fixities* :newtype? (= 'NewTypeCon (con cs))}]
      (doseq [cl (arg defn* 6) :let [cv (lval cl)] :when (= 'HsDerivingClause (con cv))
              :let [dct (lval (arg cv 3))
                    sigs (case (con dct) DctMulti (arg dct 2) DctSingle [(arg dct 2)] [])]
              sg sigs]
        (let [body (loop [b (lval (arg (lval sg) 3))]
                     ;; a class documented in the clause (-- ^ @since ...): HsDocTy around it
                     (if (#{'HsDocTy 'HsParTy} (con b)) (recur (lval (arg b 2))) b))
              ;; HF10-P54 (a): a multi-parameter class applied to its other arguments (tcrun031's deriving (C [a]) on a
              ;; newtype, GeneralizedNewtypeDeriving: GHC.Tc.Deriv's deriveTyData, the newtype its last argument)
              [hd cargs] (loop [b body as []]
                           (if (= 'HsAppTy (con b))
                             (recur (let [f (lval (arg b 2))] (if (#{'HsParTy} (con f)) (lval (arg f 2)) f)) (cons (arg b 3) as))
                             [b (vec as)]))
              cls (when (= 'HsTyVar (con hd)) (nm (arg hd 3)))
              cls (when (or (empty? cargs)
                            (and (:newtype? desc) (contains? *exts* "GeneralizedNewtypeDeriving") (not (contains? *exts* "DeriveAnyClass"))))
                    cls)
              ctvn (when (seq cargs) (vec (distinct (mapcat tv-names-of cargs))))
              cnames (mapv #(str (occ %) "_" (str/join "_" (drop 3 %))) ctvn)
              cts (mapv #(hs-type (zipmap ctvn (map (fn [x] [:tv x]) cnames)) %) cargs)]
          (if (seq cargs)
            (when cls
              (swap! *derivs* conj {:cls cls :tn tn :tvs (into (vec names) cnames) :ts (conj cts res)
                                    :ctor? false :desc (assoc desc :var (last names)) :stock? false :strat :newtype}))
          (when cls
            (cond
              ;; a strategy written in the clause (DerivingStrategies, DerivingVia): the request carries it
              (strategy-of (arg cv 2))
              (let [[kw via] (strategy-of (arg cv 2))
                    ctor? (and (contains? constructor-classes (occ cls)) (seq names))]
                (if (= kw :anyclass)
                  (swap! *derivs* conj {:cls cls :tn tn :tvs names :ts [res] :ctor? false :anyclass? true :strat :anyclass
                                        :desc (assoc desc :var (last names))})
                  (swap! *derivs* conj {:cls cls :tn tn :tvs (if ctor? (vec (butlast names)) names)
                                        :ts [(if ctor? [:tc (second res) (vec (butlast (nth res 2)))] res)]
                                        :ctor? ctor? :desc (assoc desc :var (last names)) :stock? (= kw :stock)
                                        :strat kw :via (when via (nth (sig-type via) 3))})))
              (or (contains? deriv/generators (occ cls))
                  (and (:newtype? desc) (contains? *exts* "GeneralizedNewtypeDeriving") (not (contains? *exts* "DeriveAnyClass"))
                       (not (contains? #{"Show" "Read"} (occ cls)))))
              (let [ctor? (and (contains? constructor-classes (occ cls)) (seq names))]
                (swap! *derivs* conj {:cls cls :tn tn :tvs (if ctor? (vec (butlast names)) names)
                                      :ts [(if ctor? [:tc (second res) (vec (butlast (nth res 2)))] res)]
                                      :ctor? ctor? :desc (assoc desc :var (last names)) :stock? (contains? deriv/generators (occ cls))}))
              ;; DeriveAnyClass: an empty instance, every method its default, the context empty
              (contains? *exts* "DeriveAnyClass")
              (swap! *derivs* conj {:cls cls :tn tn :tvs names :ts [res] :ctor? false :anyclass? true
                                    :desc (assoc desc :var (last names))})
              (and (contains? constructor-classes (occ cls)) (seq names))
              ;; a class of type constructors (Functor, Monad...): the head drops the last parameter
              (swap! *insts* conj {:dfun (ext-name "var" m (str "$f" (occ cls) (occ tn)))
                                   :tvs (vec (butlast names)) :ctx []
                                   :head [cls [[:tc (second res) (vec (butlast (nth res 2)))]]]})
              :else
              (swap! *insts* conj {:dfun (ext-name "var" m (str "$f" (occ cls) (occ tn)))
                                   :tvs names
                                   ;; Generic's derived instance has no context (GHC.Tc.Deriv.Infer's inferConstraints
                                   ;; for Generic: the representation type needs none); the others one on each variable
                                   :ctx (if (= "Generic" (occ cls))
                                          []
                                          (vec (for [[n x] (map vector tvn names) :when (contains? used n)] [cls [[:tv x]]])))
                                   :head [cls [res]]})))))))
    (swap! *ddescs* assoc tn {:desc {:tn tn :cons @descs :fix @*fixities* :newtype? (= 'NewTypeCon (con cs))} :names names})))

(defn- simplify-pred
  "GHC's context simplification of a derived instance's constraint: reduced by the instances to constraints on type
  variables"
  [[c ts :as p]]
  (let [t (expand (zonk (first ts)))]
    (case (first t)
      :tv [p]
      :tc (if-let [[i m] (some (fn [i] (when (= (first (:head i)) c)
                                         (when-let [m (match-ty (set (:tvs i)) {} (first (second (:head i))) t)] [i m])))
                               (insts-of c))]
            (vec (mapcat (fn [[pc pts]] (simplify-pred [pc (mapv #(subst m %) pts)])) (:ctx i)))
            (if (some #(and (vector? %) (= :tv (first %))) (tree-seq vector? seq t)) [p] []))
      [p])))

(defn- simplify-pred*
  "HF10-P34: simplify-pred for a constraint of any arity, every argument matched (DeriveAnyClass' inferred context:
  GHC.Tc.Deriv.Infer's inferConstraintsAnyclass simplifies the default signatures' contexts at the instance's head to
  constraints on type variables); one that no instance matches and that mentions no type variable is dropped"
  [[c ts] depth]
  (let [ts (mapv #(deep-expand (zonk %)) ts) p [c ts]
        tv? (fn [t] (some #(and (vector? %) (= :tv (first %))) (tree-seq vector? seq t)))]
    (if (<= depth 0)
      [p]
      (if-let [[i m] (some (fn [i] (when (and (= (first (:head i)) c) (= (count (second (:head i))) (count ts)))
                                     (when-let [m (reduce (fn [m [pt t]] (when m (match-ty (set (:tvs i)) m pt t))) {}
                                                          (map vector (second (:head i)) ts))]
                                       [i m])))
                           (insts-of c))]
        (vec (mapcat (fn [[pc pts]] (simplify-pred* [pc (mapv #(subst m %) pts)] (dec depth))) (:ctx i)))
        (if (some tv? ts) [p] [])))))

(defn- distinct-last
  "Duplicates dropped keeping the last occurrence: the order GHC's solver leaves an inferred derived context in"
  [xs]
  (vec (reverse (distinct (reverse xs)))))

(defn- derive-all!
  "The derived instances of the module: their heads entered, the contexts inferred by fixpoint, their bindings generated"
  [m]
  (let [reqs @*derivs*
        dfun (fn [r] (ext-name "var" m (str "$f" (occ (:cls r)) (occ (:tn r)))))
        ctx-of (fn [r]
                 (if (contains? #{"Enum"} (occ (:cls r)))
                   []
                   (vec (distinct (mapcat (fn [c] (mapcat (fn [t] (simplify-pred [(:cls r) [t]])) (:tys c)))
                                          (:cons (:desc r)))))))]
    (doseq [r reqs] (swap! *insts* conj {:dfun (dfun r) :tvs (:names r) :ctx [] :head [(:cls r) [(:res r)]]}))
    (dotimes [_ 5]
      (doseq [r reqs]
        (let [ctx (ctx-of r)]
          (swap! *insts* (fn [is] (mapv (fn [i] (if (= (:dfun i) (dfun r)) (assoc i :ctx ctx) i)) is))))))
    (vec (for [r reqs]
           {:dfun (dfun r) :tvs (:names r) :ctx (:ctx (some #(when (= (:dfun %) (dfun r)) %) @*insts*))
            :cls (:cls r) :ts [(:res r)]
            ;; a newtype's Eq, Ord, Ix and Bounded by the newtype strategy as GHC chooses it (the methods of the
            ;; representation type's instance, coerced); the others stock
            :gnd (when (and (:newtype? (:desc r)) (contains? #{"Eq" "Ord" "Ix" "Bounded"} (occ (:cls r))))
                   (first (:tys (first (:cons (:desc r))))))
            :binds (deriv/derive-binds (occ (:cls r)) (:desc r))}))))

(defn- iface-desc
  "An imported data type as deriving sees it ({:desc :names}, as data-decl! makes a local one), from its interface's
  constructors (GHC derives a standalone instance for any type whose constructors are in scope: deriving instance
  Bounded Bool in GHC.Internal.Enum); nil for one whose constructors are not all vanilla. A constructor with an
  operator's name and two arguments is taken as declared infix (the interface does not say: dataConIsInfix)"
  [tn]
  (when-let [ti (some-> *tycons* deref (get tn))]
    (let [split (fn [ct] (let [[vs body] (if (= :forall (first ct)) [(nth ct 1) (if (empty? (nth ct 2)) (nth ct 3) ::ctx)] [[] ct])]
                           (when (not= ::ctx body)
                             (loop [t body as []]
                               (let [t (prune t)]
                                 (if (and (= :tc (first t)) (= fun-tc (second t)))
                                   (recur (second (nth t 2)) (conj as (first (nth t 2))))
                                   [vs as t]))))))
          parts (mapv (fn [cn] [cn (some-> (get @*genv* cn) split)]) (:cons ti))
          vanilla? (fn [[_ [vs _ res]]] (and res (= :tc (first res)) (= tn (second res))
                                            (every? #(= :tv (first %)) (nth res 2))
                                            (= (set vs) (set (map second (nth res 2))))))]
      ;; an empty data type (data Void: deriving instance Show Void in GHC.Internal.Show) derives too, with its
      ;; parameters (none when the interface does not say)
      (when (and (or (seq parts) (= 'data (:flavour ti))) (every? vanilla? parts))
        (let [names (if (seq parts) (mapv second (nth (nth (second (first parts)) 2) 2)) (vec (:tvs ti [])))
              descs (vec (for [[cn [_ as res]] parts
                               :let [m (zipmap (map second (nth res 2)) (map (fn [x] [:tv x]) names))]]
                           {:name cn :arity (count as) :labels (vec (:fields (get @*cons* cn)))
                            :infix? (and (= 2 (count as)) (str/starts-with? (occ cn) ":"))
                            :tys (mapv #(subst m %) as)}))]
          {:desc {:tn tn :cons descs :fix (or (some-> *fixities* deref) {}) :newtype? (= 'newtype (:flavour ti))} :names names})))))

(defn- standalone-requests
  "The standalone deriving declarations (deriving instance ctx => C (T a)) of the module as requests"
  [decls]
  (vec (for [d decls :let [v (lval d)] :when (and (= 'DerivD (con v)) (= 'DerivDecl (con (arg v 2))))
             :let [dd (arg v 2) st (sig-type (arg (arg dd 2) 2)) head (nth st 3)
                   [kw via] (strategy-of (arg dd 3))
                   cls (second head) ts (nth head 2) t0 (first ts)
                   tn (when (= :tc (first t0)) (second t0))
                   info (or (get @*ddescs* tn) (iface-desc tn))]
             :when (and info (= :tc (first head)))]
         {:cls cls :tn tn :tvs (nth st 1) :ts ts :ctx (nth st 2) :ctor? (contains? constructor-classes (occ cls))
          :desc (assoc (:desc info) :var (last (:names info))) :stock? (if kw (= kw :stock) (contains? deriv/generators (occ cls))) :standalone? true
          :strat kw :anyclass? (= kw :anyclass) :via (when via (nth (sig-type via) 3)) :dnames (:names info)})))

(declare head-occs)

(defn- derive-all!
  "The derived instances of the module (deriving clauses and standalone declarations): their heads entered, the
  contexts inferred by fixpoint, their bindings generated; the newtype strategy for a newtype's Eq, Ord, Ix, Bounded
  (GHC's std_class_via_coercible) and, with GeneralizedNewtypeDeriving, every class but Show and Read"
  [m decls]
  (let [;; HF10-P50 (a): a deriving clause of an own class of type constructors (T5751's MonadIO m, m :: Type -> Type: its
        ;; kind HF10-P45's inference gives) drops the type's last parameter as the standard ones do (GHC.Tc.Deriv's
        ;; deriveTyData: the class's last parameter's kind decides how many of the type's arguments are dropped)
        ctor-kind? (fn [cls] (let [k (some-> *classes* deref (get cls) :kind zonk)
                                   k (if (= :forall (first k)) (nth k 3) k)]
                               (and (= :tc (first k)) (= fun-tc (second k))
                                    (let [p (zonk (first (nth k 2)))] (and (= :tc (first p)) (= fun-tc (second p)))))))
        reqs (mapv (fn [r] (if (and (not (:ctor? r)) (not (:standalone? r)) (not (:anyclass? r)) (seq (:tvs r))
                                    (= 1 (count (:ts r))) (= :tc (first (first (:ts r)))) (ctor-kind? (:cls r)))
                             (let [res (first (:ts r))]
                               (assoc r :ctor? true :tvs (vec (butlast (:tvs r))) :ts [[:tc (second res) (vec (butlast (nth res 2)))]]))
                             r))
                   @*derivs*)
        reqs (into reqs (standalone-requests decls))
        ;; HF10-P54 (a): a multi-parameter class's derived instance named by every argument of its head (newDFunName's
        ;; getDFunTyKey of each: P54gnd's Conv Bool Age and Conv [y] Age, $fConvBoolAge and $fConvListAge, not one
        ;; $fConvAge for both)
        dfun (fn [r] (ext-name "var" m (if (next (:ts r))
                                         (str "$f" (occ (:cls r))
                                              (head-occs (:ts r) (into {} (map (fn [n] [n (first (str/split n #"_"))]) (:tvs r)))))
                                         (str "$f" (occ (:cls r)) (occ (:tn r))))))
        rep-of (fn [r]
                 (let [t (first (:tys (first (:cons (:desc r)))))
                       t (if (:ctor? r)
                           (case (first t) :tc [:tc (second t) (vec (butlast (nth t 2)))] :app (nth t 1) t)
                           t)
                       t0 (first (:ts r))]
                   ;; a standalone declaration names the type's parameters as it likes
                   (if (:standalone? r) (subst (zipmap (:dnames r) (nth t0 2)) t) t)))
        gnd-of (fn [r]
                 (case (:strat r)
                   (:stock :anyclass) nil
                   :via (:via r)
                   :newtype (rep-of r)
                   ;; (HF10-P34: a standalone declaration of a class no stock deriving knows on a newtype, with
                   ;; GeneralizedNewtypeDeriving, by the newtype too: deriving instance Monoid c => Monoid (K1 i c p) took
                   ;; the class's defaults, mempty = mconcat [] and mconcat's foldr over mempty, a loop; a class of types
                   ;; only: Data.Foldable1's Foldable1 (Alt f) stays as before)
                   (when (and (:newtype? (:desc r))
                              (or (not (:standalone? r))
                                  (and (not (contains? deriv/generators (occ (:cls r)))) (not (:ctor? r))
                                       ;; the head the newtype at all its parameters (a class of types)
                                       (>= (count (nth (first (:ts r)) 2 [])) (count (:dnames r)))
                                       (contains? *exts* "GeneralizedNewtypeDeriving")))
                              (or (contains? #{"Eq" "Ord" "Ix" "Bounded"} (occ (:cls r)))
                                  (and (contains? *exts* "GeneralizedNewtypeDeriving") (not (contains? *exts* "DeriveAnyClass"))
                                       ;; GHC's non_coercible_class: Read, Show, Generic, Generic1 (and Data, Lift) stock
                                       (not (contains? #{"Show" "Read" "Generic" "Generic1" "Data" "Lift"} (occ (:cls r))))
                                       ;; a class of type constructors by the newtype only when the representation
                                       ;; eta-reduces (GHC.Tc.Deriv's eta_ok: newtype T a = MkT (f a)); Par1 p = Par1 p
                                       ;; does not, and is derived stock
                                       (or (not (:ctor? r))
                                           (let [t (first (:tys (first (:cons (:desc r))))) x [:tv (:var (:desc r))]
                                                 [f a] (case (first t)
                                                         :tc (when (seq (nth t 2)) [[:tc (second t) (vec (butlast (nth t 2)))] (last (nth t 2))])
                                                         :app [(nth t 1) (nth t 2)]
                                                         nil)]
                                             (and (= a x) (not (contains? (tvs-of f) (second x)))))))))
                     (rep-of r))))
        generic? (fn [r] (and (= "GHC.Internal.Generics" (nmod (:cls r))) (contains? #{"Generic" "Generic1"} (occ (:cls r)))
                              (not (gnd-of r)) (not (:anyclass? r))))
        ctx-of (fn [r]
                 (cond
                   (:standalone? r) (:ctx r)
                   ;; HF10-P34: DeriveAnyClass' context, the default signatures' contexts at the head simplified
                   ;; (inferConstraintsAnyclass): deriving (Generic, NFData) on T a wants NFData a
                   (:anyclass? r) (let [info (get @*classes* (:cls r))
                                        sm (zipmap (:tvs info) (:ts r))]
                                    (distinct-last
                                     (for [[_ dt] (sort-by (comp str key) (:dsigs info))
                                           :when (= :forall (first dt))
                                           :let [own (set (nth dt 1))]
                                           [pc pts] (nth dt 2)
                                           :when (not-any? (fn [x] (and (vector? x) (= :tv (first x)) (contains? own (second x))))
                                                           (tree-seq coll? seq pts))
                                           q (simplify-pred* [pc (mapv #(subst sm %) pts)] 30)]
                                       q)))
                   ;; (HF10-P54 (a): a multi-parameter class's other arguments before the representation)
                   (gnd-of r) (if (next (:ts r))
                                (vec (simplify-pred* [(:cls r) (conj (vec (butlast (:ts r))) (gnd-of r))] 30))
                                (vec (simplify-pred [(:cls r) [(gnd-of r)]])))
                   ;; HF10-P34: GHC.Tc.Deriv.Infer's inferConstraints for Generic: none (the representation needs no
                   ;; instance); for Generic1 Functor of each composition's outer type
                   (generic? r) (if (= "Generic1" (occ (:cls r)))
                                  (vec (distinct (mapcat (fn [f] (simplify-pred [(ext-name "tc" "GHC.Internal.Base" "Functor") [f]]))
                                                         (deriv/gen1-functors (:desc r)))))
                                  [])
                   (= "Enum" (occ (:cls r))) []
                   (:ctor? r) (vec (distinct (mapcat (fn [c] (mapcat (fn [t] (mapcat (fn [f] (simplify-pred [(:cls r) [f]]))
                                                                                    (deriv/fun-subtypes (:var (:desc r)) t)))
                                                                    (:tys c)))
                                                     (:cons (:desc r)))))
                   ;; Data: GHC.Tc.Deriv.Infer's sc_constraints too, the superclass Typeable at the head decomposed by the
                   ;; Typeable solver (doTyApp, doTyConApp) to its type variables' (Data.Functor.Compose's Typeable f,
                   ;; Typeable g, Typeable a: before, Typeable (Compose f g a) was a superclass no given solved), a Typeable
                   ;; x a Data x of the context implies left out (mkMinimalBySCs)
                   (and (= "Data" (occ (:cls r))) (= "GHC.Internal.Data.Data" (nmod (:cls r))))
                   (let [fields (distinct-last (mapcat (fn [c] (mapcat (fn [t] (simplify-pred [(:cls r) [t]])) (:tys c)))
                                                       (:cons (:desc r))))
                         tvs-in (fn tvs-in [t] (let [t (expand (zonk t))]
                                                 (case (first t)
                                                   :tv [t]
                                                   :tc (mapcat tvs-in (nth t 2))
                                                   :app (concat (tvs-in (nth t 1)) (tvs-in (nth t 2)))
                                                   [])))
                         sc (for [x (distinct (tvs-in (first (:ts r))))
                                  :when (not-any? (fn [[pc pts]] (and (= pc (:cls r)) (= [x] (mapv #(expand (zonk %)) pts)))) fields)]
                              [cls-typeable [x]])]
                     (distinct-last (concat sc fields)))
                   :else (distinct-last (mapcat (fn [c] (mapcat (fn [t] (simplify-pred [(:cls r) [t]])) (:tys c)))
                                                (:cons (:desc r))))))]
    ;; HF10-P34: a derived Generic's (Generic1's) representation, the family instance Rep (T a) = Rep_T a
    ;; (GHC.Tc.Deriv.Generics' gen_Generic_fam_inst, its axiom Rep_T), in the family table before any binding is typed
    (doseq [r reqs :when (and (generic? r) (or (= "Generic" (occ (:cls r))) (deriv/gen1-ok? (:desc r))))]
      (let [gk (if (= "Generic1" (occ (:cls r))) :gen1 :gen0)
            fam (ext-name "tc" "GHC.Internal.Generics" (if (= gk :gen1) "Rep1" "Rep"))
            t0 (first (:ts r))
            sm (if (:standalone? r) (zipmap (:dnames r) (nth t0 2)) {})
            tn (:tn r) tm (nmod tn)
            ;; an imported constructor's fixity from its interface (the wired-in (:) is infixr 5, GHC.Internal.Types')
            fix (merge {(ext-name "data" "GHC.Internal.Types" ":") [5 'InfixR]} (:fix @*iface-meta*) (:fix (:desc r)))
            rhs (deriv/rep-type gk (assoc (:desc r) :fix fix)
                                {:module tm :name tn :tys-of (fn [c] (mapv #(subst sm %) (:tys c)))
                                 :unit (cond (= tm m) *unit*
                                             (get-in @*iface-meta* [:units tm]) (get-in @*iface-meta* [:units tm])
                                             (str/starts-with? tm "GHC.Internal.") "ghc-internal" :else *unit*)})
            ;; the equation's variables renamed apart from the head's (famenv's matching substitutes to a fixed point:
            ;; Rep (W a) at the very variable a of the equation looped)
            rn (into {} (map (fn [v] [v [:tv (str "rep$" v)]]) (:tvs r)))
            eqn {:tvs (mapv #(str "rep$" %) (:tvs r)) :lhs [(subst rn t0)] :rhs (subst rn rhs)
                 :ax (str (if (= gk :gen1) "Rep1_" "Rep_") (occ tn))}]
        (when *own-fam-insts* (swap! *own-fam-insts* conj [fam eqn]))
        (swap! *families* update fam (fn [old] (update (merge {:flavour :open} old) :eqns (fnil conj []) (dissoc eqn :ax))))))
    (doseq [r reqs] (swap! *insts* conj {:dfun (dfun r) :tvs (:tvs r) :ctx (if (:standalone? r) (:ctx r) []) :head [(:cls r) (:ts r)]}))
    ;; the contexts by fixpoint, every inferred one at once from the previous round's (GHC.Tc.Deriv.Infer's
    ;; simplifyDeriv iterated by GHC.Tc.Deriv's inferInstanceContexts), until none changes
    (loop [k 0]
      (let [cur (into {} (map (fn [i] [(:dfun i) (:ctx i)]) @*insts*))
            ctxs (into {} (for [r reqs :when (not (:standalone? r))] [(dfun r) (ctx-of r)]))]
        (when (some (fn [[d c]] (not= c (get cur d))) ctxs)
          (swap! *insts* (fn [is] (mapv (fn [i] (if-let [c (get ctxs (:dfun i))] (assoc i :ctx c) i)) is)))
          (when (< k 20) (recur (inc k))))))
    (let [ctx-by (into {} (map (fn [i] [(:dfun i) (:ctx i)]) @*insts*))
          ;; a stock Data instance's auxiliary bindings, $tT and $cC (gen_Data_binds' DerivDataDataType, DerivDataConstr),
          ;; top-level bindings of the module (*deriv-aux*), and dataCast1/2 by the type constructor's kind (* -> *, * -> * -> *)
          data-desc (fn [r]
                      (if (and (= "Data" (occ (:cls r))) (= "GHC.Internal.Data.Data" (nmod (:cls r))) (not (gnd-of r)) (not (:anyclass? r)))
                        (let [desc (:desc r) names (deriv/data-aux-names m desc)
                              k (some-> (get-in @*tycons* [(:tn r) :kind]) zonk deep-expand)
                              cast (cond (= k (deep-expand (fn-ty star-kind star-kind))) 1
                                         (= k (deep-expand (fn-ty star-kind (fn-ty star-kind star-kind)))) 2)
                              desc (assoc desc :data (assoc names :cast cast))]
                          (when *deriv-aux* (swap! *deriv-aux* into (deriv/data-aux desc)))
                          desc)
                        (:desc r)))]
      (vec (for [r reqs]
             {:dfun (dfun r) :tvs (:tvs r) :ctx (get ctx-by (dfun r))
              :cls (:cls r) :ts (:ts r)
              :gnd (gnd-of r)
              :binds (when-not (or (gnd-of r) (:anyclass? r)
                                   (and (generic? r) (= "Generic1" (occ (:cls r))) (not (deriv/gen1-ok? (:desc r)))))
                       (deriv/derive-binds (occ (:cls r)) (data-desc r)))})))))

(defn- syn-decl! [d]
  (let [tn (nm (arg d 2)) tvn (qtvs-names (arg d 3))
        names (mapv #(str (occ %) "_" (str/join "_" (drop 3 %))) tvn)]
    (swap! *syns* assoc tn [names (hs-type (zipmap tvn (map (fn [x] [:tv x]) names)) (arg d 5))])))

(defn- class-decl!
  "A class: its methods' types (forall tvs. Cls tvs => method type), superclasses"
  [m d]
  (let [cn (nm (arg d 3)) tvn (qtvs-names (arg d 4))
        names (mapv #(str (occ %) "_" (str/join "_" (drop 3 %))) tvn)
        tvs (zipmap tvn (map (fn [x] [:tv x]) names))
        ;; HF10-P48 (a): a variable superclass (UndecidableSuperClasses' class c => IdCt c; the constraint tuples'
        ;; class (c1, c2) => CTuple2 c1 c2) is [:cvar [t]], a field of the dictionary as GHC's (its selector $p1IdCt)
        ;; (GHC's quantified superclass, QuantifiedConstraints' class (forall a. Eq a => Eq (f a)) => Eq1 f: [:qc [polytype]],
        ;; a field of the dictionary as any superclass, $p1Eq1 its selector)
        supers (vec (keep (fn [c] (let [p (hs-type tvs c)]
                                    (case (first p) :tc [(second p) (nth p 2)] :tv [:cvar [p]]
                                      :forall (when (qc-head p) [:qc [p]])
                                      nil)))
                          (let [c (arg d 2)] (when (and (seq? c) (= 'Just (first c))) (lval (second c))))))
        methods (atom []) dsigs (atom {})
        ;; the functional dependencies by parameter position, as an interface's are read (add-things!)
        fundeps (vec (for [fd (arg d 6) :let [fv (lval fd)] :when (= 'FunDep (con fv))]
                       [(mapv #(.indexOf ^java.util.List tvn (nm %)) (arg fv 2)) (mapv #(.indexOf ^java.util.List tvn (nm %)) (arg fv 3))]))]
    ;; a method's own signature, not its default's (DefaultSignatures' `default lift :: (r ~ ..., Quote m) => ...` types
    ;; the default method alone: GHC.Tc.TyCl.Class's tcClassSigs keeps the two apart)
    (doseq [s (arg d 7) :let [sv (lval s)] :when (and (= 'ClassOpSig (con sv)) (not (true? (arg sv 2))))
            nl (arg sv 3)]
      (let [sig (lval (arg sv 4)) body (arg sig 3)
            own (remove (set tvn) (tv-names-of body))
            onames (mapv #(str (occ %) "_" (str/join "_" (drop 3 %))) own)
            mt (hs-type (merge tvs (zipmap own (map (fn [x] [:tv x]) onames))) body)
            mt (if (seq onames) (if (= :forall (first mt)) [:forall onames (nth mt 2) (nth mt 3)] [:forall onames [] mt]) mt)
            n (nm nl)]
        (swap! methods conj n)
        (swap! *genv* assoc n [:forall names [[cn (mapv (fn [x] [:tv x]) names)]] mt])))
    ;; P17 (deepseq's NFData): DefaultSignatures' `default rnf :: (Generic a, GNFData Zero (Rep a)) => a -> ()`, the type its
    ;; default method is checked at (GHC.Tc.TyCl.Class's tcClassSigs: the default's own signature; $dmrnf :: forall a. NFData a
    ;; => (Generic a, GNFData Zero (Rep a)) => a -> ()), and an instance that omits the method applies $dm to the context's
    ;; dictionaries solved at its head (GHC.Tc.TyCl.Instance's tc_default, GenericDM)
    (doseq [s (arg d 7) :let [sv (lval s)] :when (and (= 'ClassOpSig (con sv)) (true? (arg sv 2)))
            nl (arg sv 3)]
      (let [sig (lval (arg sv 4)) body (arg sig 3)
            own (remove (set tvn) (tv-names-of body))
            onames (mapv #(str (occ %) "_" (str/join "_" (drop 3 %))) own)
            mt (hs-type (merge tvs (zipmap own (map (fn [x] [:tv x]) onames))) body)
            mt (if (seq onames) (if (= :forall (first mt)) [:forall onames (nth mt 2) (nth mt 3)] [:forall onames [] mt]) mt)]
        (swap! dsigs assoc (nm nl) mt)))
    (swap! *classes* assoc cn {:tvs names :supers supers :methods @methods :fundeps fundeps :dsigs @dsigs
                               :defaults (into {} (for [b (arg d 8) :let [n (bind-name b)] :when n]
                                                    [n (ext-name "var" m (str "$dm" (occ n)))]))
                               :binds (arg d 8)})))

(defn- head-occs
  "The type constructors' occurrence names of an instance head, as GHC's dictionary functions spell them
  (GHC.Tc.Utils.Instantiate's getDFunTyKey: a type constructor's name, a type variable's own, an application's head's)"
  ([ts] (head-occs ts {}))
  ([ts tv-occ]
  ;; each argument's outermost type constructor, synonyms expanded (State Env: StateT)
  (apply str (map (fn [t] (loop [t (deep-expand (zonk t))]
                            (case (first t)
                              :tc (occ (second t))
                              :tv (get tv-occ (second t) "")
                              :app (recur (second t))
                              :forall (recur (nth t 3))
                              ""))) ts))))

(defn- inst-decl!
  "An instance: its dictionary function's entry in the instance table; the declaration kept for the methods"
  [m d]
  (let [sig (arg d 2) body (arg (lval sig) 3)
        tvn (tv-names-of body)
        names (mapv #(str (occ %) "_" (str/join "_" (drop 3 %))) tvn)
        t (hs-type (zipmap tvn (map (fn [x] [:tv x]) names)) body)
        [ctx head] (if (= :forall (first t)) [(nth t 2) (nth t 3)] [[] t])
        cls (second head) ts (nth head 2)
        base (str "$f" (occ cls) (head-occs ts (zipmap names (map occ tvn))))
        ;; HF10-P32: GHC.Tc.Utils.Monad's chooseUniqueOccTc (newDFunName): a name the module's instances already took gets
        ;; 0, 1, ... appended (Data.Array.Base's MArray (STArray s) e (ST s) and ... (Lazy.ST s): $fMArraySTArrayeST and
        ;; $fMArraySTArrayeST0; one name for both bound the lazy one's dictionary for the strict one)
        taken (set (keep (fn [i] (let [d (:dfun i)] (when (= m (nmod d)) (occ d)))) @*insts*))
        dfun (ext-name "var" m (if (contains? taken base)
                                 (some (fn [n] (let [o (str base n)] (when-not (contains? taken o) o))) (range))
                                 base))]
    (swap! *insts* conj {:dfun dfun :tvs names :ctx ctx :head [cls (mapv deep-expand ts)]})
    {:dfun dfun :tvs names :ctx ctx :cls cls :ts ts :binds (arg d 3) :sp (lsp sig)
     ;; round 54: the instance signatures (InstanceSigs), by the method's occ name: their HsSig
     :isigs (into {} (for [s (arg d 4) :let [sv (lval s)] :when (and (= 'ClassOpSig (con sv)) (not (true? (arg sv 2)))) nl (arg sv 3)]
                       [(occ (or (nm nl) (lval nl))) (arg sv 4)]))}))

(defn- method-type
  "A class method's type at an instance head: the rest of its type after the class's own forall and constraint"
  [mn cls ts]
  (let [t (get @*genv* mn) info (get @*classes* cls)
        body (subst (zipmap (:tvs info) ts) (nth t 3))]
    body))

(defn- check-method
  "A method body checked at type ty (a type closed by the instance's variables, with its own forall) with the
  givens: core. Queue 385: an instance signature (isig, InstanceSigs') whose context has HasCallStack (`fail :: HasCallStack
  => String -> IO a`): the method's HasCallStack given is the class method's stack with the call site \"a type signature
  in an instance\" pushed at the signature's span, as GHC's subsumption of the instance signature by the class method's type
  solves it (InstanceSigOrigin, a call stack's push)"
  [env b ty givens params & [isig]]
  (let [skol-body (fn [t] (if (= :forall (first t))
                            (let [skol (zipmap (nth t 1) (map (fn [x] [:tv (str "sk_" x)]) (nth t 1)))]
                              [(subst skol (nth t 3)) (mapv (fn [[c ts]] [c (mapv #(subst skol %) ts)]) (nth t 2))])
                            [t []]))
        [body inner] (skol-body ty)
        iparams (mapv dict-param inner)
        ;; the method's superclass evidence bound once after its dictionaries (GHC's evidence bindings of the method's
        ;; implication): the givens' superclasses again from the dictionary parameters, each selection a variable
        evb (atom [])
        wb (atom [])
        givens (if (seq params)
                 (binding [*ev-binds* evb] (super-closure (vec (filter (fn [[_ t]] (some #(= t %) params)) givens))))
                 givens)
        givens (into givens (binding [*ev-binds* evb] (super-closure (mapv vector inner iparams))))
        ws (atom [])
        own (when (= :forall (first ty)) (into {} (map (fn [x] [x [:tv (str "sk_" x)]]) (nth ty 1))))
        ;; round 54: an instance signature's variables (InstanceSigs; GHC.Tc.TyCl.Instance's tcMethodBodyHelp checks the
        ;; method at the signature and the signature against the method's type): the signature's body matched against the
        ;; method type's skolemised body, each of its quantified variables the skolem it meets, in scope over the method
        ;; (ScopedTypeVariables: Data.Sequence.Internal's foldMap :: forall m a. Monoid m => ..., its body's annotation's m)
        own (if-let [st (when isig (try (sig-type isig) (catch Throwable _ nil)))]
              (let [[svs sbody] (if (= :forall (first st)) [(nth st 1) (nth st 3)] [[] st])
                    mm (match-ty* (set svs) {} sbody body)]
                (merge own (when mm (into {} (filter (fn [[k _]] (some #{k} svs)) mm)))))
              own)
        c (binding [*level* (inc *level*) *wanteds* ws *scoped-tvs* (merge *scoped-tvs* own) *given-eqs* (scope-givens)]
            ;; the instance's context's equalities and the method's own (instance (a ~ Char) => IsString [a])
            (assume-eqs! (concat (map first givens) inner))
            (let [[t c] (bind-rhs env b (when-not (= :forall (first body)) body))] (unify t body) (retry-implications! false) c))]
    (solve-with-givens! @ws givens wb)
    ;; (queue 385: an instance signature with HasCallStack: its given is the class method's stack, pushed)
    (let [push-sp (when (and isig (some #(= cls-callstack %) (tree-seq coll? seq isig))) (lsp isig))
          k (when push-sp (first (keep-indexed (fn [i p] (when (or (= cls-callstack (first p)) (callstack-ip p)) i)) inner)))
          [iparams c] (if k
                        (let [p (nth iparams k) q (dict-param (nth inner k))]
                          [(assoc iparams k q)
                           (list 'let [(list 'bind p (push-given-callstack "a type signature in an instance" push-sp q))] c)])
                        [iparams c])
          ps (into params iparams)
          wbs (mapv (fn [[x t]] [x t]) @wb)]
      (if (empty? ps) (wrap-ev-binds wbs c) (list 'lam ps (wrap-ev-binds (into @evb wbs) c))))))

(defn- default-methods
  "A class's default methods: (bind $dmop (lam [$dCls] core))"
  [env cn]
  (let [info (get @*classes* cn) tvs (:tvs info)
        self [cn (mapv (fn [x] [:tv (str "sk_" x)]) tvs)]
        p (dict-param self)
        givens (super-closure [[self p]])]
    ;; the class's variables scope over its default methods (ScopedTypeVariables)
    (binding [*scoped-tvs* (merge *scoped-tvs* (into {} (map (fn [x] [x [:tv (str "sk_" x)]]) tvs)))]
      (vec (for [b (:binds info) :let [n (bind-name b)] :when n]
             (let [ty (subst (zipmap tvs (map (fn [x] [:tv (str "sk_" x)]) tvs)) (or (get (:dsigs info) n) (nth (get @*genv* n) 3)))]
               (list 'bind (get (:defaults info) n) (check-method env b ty givens [p]))))))))

;; a superclass dictionary that applies a dictionary function to the instance's own parameters alone: GHC's simple
;; optimiser inlines it into the dictionary (a $cpN binding used once)
(defn- trivial-sc? [term params]
  (and (seq? term) (= 'app (first term)) (seq? (second term)) (= 'v (first (second term)))
       (seq (nth term 2)) (every? (fn [a] (some #(= a %) params)) (nth term 2))))

(declare instance-binds*)

(defn- instance-binds
  "An instance's dictionary function and its methods, as GHC's desugarer gives them; the head's variables scope over
  the methods"
  [env inst]
  (binding [*scoped-tvs* (merge *scoped-tvs* (into {} (map (fn [x] [x [:tv (str "sk_" x)]]) (:tvs inst))))]
    (instance-binds* env inst)))

(defn- instance-binds*
  [env {:keys [dfun tvs ctx cls ts binds gnd isigs sp]}]
  (let [skol (zipmap tvs (map (fn [x] [:tv (str "sk_" x)]) tvs))
        ts (mapv #(subst skol %) ts)
        ctx (mapv (fn [[c xs]] [c (mapv #(subst skol %) xs)]) ctx)
        params (mapv dict-param ctx)
        self-term (if (empty? params) (list 'v dfun) (list 'app (list 'v dfun) params))
        ;; the instance's own dictionary is a given too, its superclasses with it (GHC selects a superclass of the
        ;; instance being defined rather than solving it again from the instances)
        givens (super-closure (mapv vector ctx params))
        self-givens (super-closure (conj (mapv vector ctx params) [[cls ts] self-term]))
        info (get @*classes* cls)
        defined (into {} (keep (fn [b] (when-let [n (bind-name b)] [(occ n) b])) binds))
        methods (for [mn (:methods info)]
                  (let [cm (fresh-lv (str "$c" (occ mn)))
                        b (get defined (occ mn))
                        ;; a coerced method whose representation dictionary is one of the instance's own parameters is
                        ;; trivial: GHC's simple optimiser inlines it into the dictionary function
                        gd (when gnd (solve-pred [cls (conj (vec (butlast ts)) (subst skol gnd))] givens 0))
                        gnd-inline? (and gd (or (and (seq params) (= 'lv (first gd)))
                                                 ;; a class of one method and no superclass has a newtype dictionary: the
                                                 ;; coerced method is the dictionary
                                                 (and (= 1 (count (:methods info))) (empty? (:supers info)))))]
                    [(if gnd-inline? nil cm)
                     (if gnd
                          ;; the newtype strategy: the representation type's method, coerced
                          (let [d (or gd
                                      (do (error! "no representation dictionary " (occ cls)) (list 'lit "?")))
                                mty (method-type mn cls ts)
                                ;; the method's own constraints stay parameters of the coerced method
                                iparams (if (= :forall (first mty)) (mapv dict-param (nth mty 2)) [])
                                c (list 'app (list 'v mn) (into [d] iparams))
                                ps (into params iparams)]
                            ;; an instance with a context has its coerced methods in the dictionary itself, as GHC's
                            ;; dictionary function; without one they are bindings of their own
                            (if gnd-inline?
                              (if (empty? iparams) c (list 'lam iparams c))
                              (if (empty? ps) c (list 'lam ps c))))
                          (if b
                          (binding [*self-givens* self-givens] (check-method env b (method-type mn cls ts) givens params (get isigs (occ mn))))
                          (if-let [dm (get (:defaults info) mn)]
                            ;; a default method with an INLINE pragma is inlined, as GHC does even at -O0
                            (let [d (if (empty? params) (list 'v dfun) (list 'app (list 'v dfun) params))
                                  f (or (get @*unfoldings* dm) (list 'v dm))
                                  ;; a default signature's context at the instance's head (P17): its dictionaries after the
                                  ;; class's, solved from the instance's context and the instances
                                  dsig (get (:dsigs info) mn)
                                  ;; (HF10-P33: a default signature with variables of its own, NFData1's liftRnf's forall a,
                                  ;; whose context does not mention them: the same dictionaries)
                                  dctx (when (and dsig (= :forall (first dsig))
                                                  (let [own (set (nth dsig 1))]
                                                    (not-any? (fn [x] (and (vector? x) (= :tv (first x)) (contains? own (second x))))
                                                              (tree-seq coll? seq (nth dsig 2)))))
                                         (nth dsig 2))
                                  extra (vec (for [[c xs] dctx]
                                               (let [pr [c (mapv #(subst (zipmap (:tvs info) ts) %) xs)]]
                                                 (or (solve-pred pr self-givens 0)
                                                     (do (error! "unsolved: " (pr-str (zonk-pred pr))) (list 'lit "?"))))))
                                  a (list 'app f (into [d] extra))]
                              (if (empty? params) a (list 'lam params a)))
                            ;; (queue 422: GHC.Tc.TyCl.Instance's tcMethods' error_rhs, noMethodBindingError of
                            ;; "INST-SPAN|‘METHOD’" (the dictionary function's span, the instance's type; showSDoc's
                            ;; quotes), its Chars cut to bytes by unsafeMkByteString as HsStringPrim's: ‘ and ’ are \x18
                            ;; and \x19; it was the method's bare name, a literal tostg could not make)
                            (list 'app (list 'v (ext-name "var" "GHC.Internal.Control.Exception.Base" "noMethodBindingError"))
                                  [(list 'lit (str (pr-str (str (if sp (span-text sp) "?") "|" (char 0x18) (occ mn) (char 0x19))) "#"))]))))]))
        ;; HF10-P50 (a): a superclass wanted of the instance not solved through the instance's own head met again among its
        ;; context's superclasses (GHC.Tc.Solver.Dict's prohibitedSuperClassSolve, Note [Solving superclass constraints]):
        ;; T21973b's Def (D c) not by ClassLedger c's superclass ClassDecode (D c)'s, the dictionary being defined (a
        ;; loop), but by Def (D a)'s instance
        ;; (the head met with its families reduced: T21973a's ClassLedger (MyLedger c)'s superclass ClassDecode
        ;; (Tx (MyLedger c)) is ClassDecode (MyTx c), the instance's own head; compared unreduced it was missed and
        ;; Monoid [c] solved through it, $cp1ClassDecode calling itself: <<loop>> on the own libraries, gate B1)
        sc-givens (let [cl (super-closure (mapv vector ctx params))
                        nf (fn [[c xs]] [c (mapv (comp deep-expand zonk) xs)])
                        own-head (nf [cls ts])
                        heads (set (keep (fn [[p t]] (when (= (nf p) own-head) t)) cl))]
                    (if (empty? heads)
                      cl
                      (filterv (fn [[_ t]] (not-any? #(contains? heads %) (tree-seq coll? seq t))) cl)))
        ;; (queue 381: under the instance context's given equalities, as its methods are: exceptions' `instance e ~
        ;; SomeException => MonadCatch (Either e)`, whose superclass MonadThrow (Either e) is solved by `instance e ~
        ;; SomeException => MonadThrow (Either e)`, its context e ~ SomeException given here; before, the superclass's
        ;; solving unified the skolem e with SomeException outside the givens and failed)
        supers (binding [*given-eqs* (scope-givens)]
                 (assume-eqs! ctx)
                 (doall
                 (for [[sc sts] (:supers info)]
                 (or (solve-pred [sc (mapv #(subst (zipmap (:tvs info) ts) %) sts)] sc-givens 0)
                     (do (error! "no superclass dictionary " (occ sc) " " (pr-str [sc (mapv #(subst (zipmap (:tvs info) ts) %) sts)]))
                         (when trace? (binding [*out* *err*] (println "tc-trace: instances of" (pr-str sc) (pr-str (filter #(= sc (first (:head %))) @*insts*)))))
                         (list 'lit "?"))))))
        dcon (list 'v (ext-name "var" (nmod cls) (dcon-occ cls)))
        ;; an instance with a context: each superclass dictionary a binding of its own over the context's
        ;; dictionaries ($cp1Cls), as GHC's tcSuperClasses makes it; without one the dictionary inline
        ;; (also without a context when the dictionary is not a variable: GHC binds it apart, $cpNCls)
        sc-entries (vec (map-indexed (fn [i term]
                                       (if (and (or (seq params) (not (and (seq? term) (= 'v (first term)))))
                                                (not (trivial-sc? term params)))
                                         [(fresh-lv (str "$cp" (inc i) (occ cls))) (if (seq params) (list 'lam params term) term)]
                                         [nil term]))
                                     supers))
        sc-binds (vec (filter first sc-entries))
        sc-fields (map (fn [[x term]] (cond (nil? x) term (seq params) (list 'app x params) :else x)) sc-entries)
        fields (concat sc-fields (map (fn [[cm c]] (cond (nil? cm) c (empty? params) cm :else (list 'app cm params))) methods))
        dict (list 'app dcon (vec fields))]
    (into [(list 'bind dfun (if (empty? params) dict (list 'lam params dict)))]
          (concat (map (fn [[x c]] (list 'bind x c)) sc-binds)
                  (map (fn [[cm c]] (list 'bind cm c)) (filter first methods))))))

;;; ------------------------------------------------------------------------------------------
;;; Defaulting and the end of the module

(def standard-classes
  #{"Eq" "Ord" "Show" "Read" "Enum" "Bounded" "Ix" "Num" "Real" "Integral" "Fractional" "Floating" "RealFrac"
    "RealFloat" "Functor" "Monad" "MonadFail" "Foldable" "Traversable" "Semigroup" "Monoid" "Applicative"})
(def numeric-classes #{"Num" "Real" "Integral" "Fractional" "Floating" "RealFrac" "RealFloat"})

(def ^:dynamic *defaults* nil) ; the module's default declaration's types (Haskell 2010 §4.3.4), nil: (Integer, Double)

(defn- improve!
  "Functional dependencies' improvement (GHC.Tc.Solver.Dict's improvement from instances) of each wanted (improve-one!);
  true when something was unified"
  [wanteds]
  (let [changed (atom false)]
    (doseq [w wanteds :let [p (zonk-pred (:pred w))] :when (seq (:fundeps (get @*classes* (first p))))]
      (when (improve-one! p) (reset! changed true)))
    @changed))

(defn- may-match?
  "A family equation's right-hand side p (its variables tvs) could equal t: a variable or a family application in p
  matches anything, a meta in t too; else the same constructor and arguments"
  [tvs p t]
  (let [p (expand (prune p)) t (expand (zonk t))]
    (cond (and (= :tv (first p)) (contains? tvs (second p))) true
          (= :mv (first t)) true
          (and (= :tc (first p)) (some-> *families* deref (get (second p)))) true
          (and (= :tc (first p)) (= :tc (first t))) (and (= (second p) (second t)) (= (count (nth p 2)) (count (nth t 2)))
                                                         (every? true? (map #(may-match? tvs %1 %2) (nth p 2) (nth t 2))))
          (and (= :app (first p)) (= :app (first t))) (and (may-match? tvs (nth p 1) (nth t 1)) (may-match? tvs (nth p 2) (nth t 2)))
          :else (= p t))))

(defn- interact-top
  "HF10-P50 (a): GHC.Builtin.Types.Literals' top-level interactions of a builtin family's application with a literal
  (interactTopAdd, interactTopSub, interactTopMul, interactTopExp, interactTopAppendSymbol): x + y ~ 5 with y ~ 3 gives
  x ~ 2, x + y ~ 0 gives x ~ 0 and y ~ 0, x * y ~ 1 gives both 1, x ^ y ~ z by an exact root or logarithm, AppendSymbol x y
  ~ z by a prefix or a suffix of z; the pairs [meta literal] it implies, nil when none"
  [f z]
  (let [n (when (and (vector? (second f)) (= 2 (count (nth f 2)))) (second f))
        o (when (and n (contains? #{"GHC.Internal.TypeNats" "GHC.Internal.TypeLits"} (nth n 2))) (nth n 3))
        [x y] (mapv prune (nth f 2))
        lit (fn [t] (when (= :lit (first t)) (second t)))
        mx (lit x) my (lit y) z (lit (prune z))
        num? (fn [v] (integer? v))
        ok (fn [ps] (seq (filter (fn [[t _]] (= :mv (first t))) ps)))
        exact-log (fn [b v] (loop [k 0 p 1] (cond (= p v) k (> p v) nil :else (recur (inc k) (*' p b)))))
        exact-root (fn [e v] (loop [r 0] (let [p (reduce *' 1 (repeat e r))] (cond (= p v) r (> p v) nil :else (recur (inc r))))))]
    (when (some? z)
      (ok
       (case o
         "+" (when (num? z)
               (cond (zero? z) [[x 0] [y 0]]
                     (num? mx) (when (>= z mx) [[y (- z mx)]])
                     (num? my) (when (>= z my) [[x (- z my)]])))
         "-" (when (num? z)
               (cond (num? mx) (when (>= mx z) [[y (- mx z)]])
                     (num? my) [[x (+' z my)]]))
         "*" (when (num? z)
               (cond (= 1 z) [[x 1] [y 1]]
                     (and (num? mx) (pos? mx) (zero? (mod z mx))) [[y (quot z mx)]]
                     (and (num? my) (pos? my) (zero? (mod z my))) [[x (quot z my)]]))
         "^" (when (num? z)
               (cond (zero? z) [[x 0]]
                     (and (num? mx) (> mx 1)) (when-let [k (exact-log mx z)] [[y k]])
                     (and (num? my) (pos? my) (< z 100000000)) (when-let [r (exact-root my z)] [[x r]])))
         "AppendSymbol" (when (string? z)
                          (cond (= "" z) [[x ""] [y ""]]
                                (string? mx) (when (str/starts-with? z mx) [[y (subs z (count mx))]])
                                (string? my) (when (str/ends-with? z my) [[x (subs z 0 (- (count z) (count my)))]])))
         nil)))))

(defn- interact-deferred!
  "HF10-P50 (a): interact-top over the deferred family equalities (GHC applies the builtin families' interactions
  eagerly, before a binding is generalized); true when something was unified"
  []
  (let [changed (atom false)]
    (when *deferred-eqs*
      (doseq [[a b] @*deferred-eqs*
              :let [a (zonk a) b (zonk b)
                    [f t] (cond (stuck-family? a) [a b] (stuck-family? b) [b a])]
              :when f
              :let [ps (interact-top f t)]
              :when ps]
        (doseq [[m v] ps] (unify m [:lit v]))
        (reset! changed true)))
    @changed))

(defn- invert-families!
  "HF10-P34: a deferred equality F ?k ~ t (F a type family stuck on a meta, t known) whose family has exactly one
  equation whose right-hand side could be t: ?k is that equation's left-hand side. The elaborator erases kinds, so the
  kind GHC knows (SingKind k at fromSing (sing :: Sing nt), nt :: Bool from the instance head 'MetaData n m p nt) is
  recovered from the result the program wants (DemoteRep k ~ Bool); a program GHC accepted has that k. True when
  something was unified. preds: the wanteds still unsolved (default: the module's)"
  [& [preds]]
  (let [changed (atom false)]
    ;; HF10-P50 (a): the builtin families' top-level interactions first
    (when (interact-deferred!) (reset! changed true))
    (doseq [[a b] @*deferred-eqs*
            :let [a (zonk a) b (zonk b)
                  [f t] (cond (stuck-family? a) [a b] (stuck-family? b) [b a])]
            :when (and f (not (stuck-family? t)) (not= :mv (first (prune t)))
                       (some #(= :mv (first (prune %))) (nth f 2)))
            :let [fam (get @*families* (second f))
                  k (count (nth f 2))
                  cands (filter (fn [e] (and (= (count (:lhs e)) k) (may-match? (set (:tvs e)) (:rhs e) t))) (:eqns fam))]
            :when (= 1 (count cands))]
      (let [e (first cands) m (zipmap (:tvs e) (repeatedly fresh-meta))]
        (doseq [[x p] (map vector (nth f 2) (:lhs e))] (unify x (subst m p)))
        (unify a b)
        (reset! changed true)))
    ;; then F ?k ~ F x (both stuck, the same family): ?k := x when ?k is an argument of a wanted still unsolved (the
    ;; kind GHC knows: SingKind (Maybe a)'s fromSing (SJust a) = Just (fromSing a), DemoteRep k' ~ DemoteRep a, k' = a)
    (when-not @changed
      (let [wanted-metas (set (for [p (or preds (map :pred (some-> *wanteds* deref))) t (second (zonk-pred p))
                                    :let [t (prune t)] :when (= :mv (first t))] (second t)))]
        (doseq [[a b] @*deferred-eqs*
                :let [a (zonk a) b (zonk b)]
                :when (and (stuck-family? a) (stuck-family? b) (= (second a) (second b)) (= (count (nth a 2)) (count (nth b 2))))
                [x y] (map vector (nth a 2) (nth b 2))
                :let [x (prune x) y (prune y)]
                :when (and (not= x y) (or (and (= :mv (first x)) (contains? wanted-metas (second x)))
                                          (and (= :mv (first y)) (contains? wanted-metas (second y)))))]
          (unify x y)
          (reset! changed true))))
    @changed))

(defn- default-ip
  "GHC.Tc.Solver's simplifyTop defaulting of the implicit parameters it knows (defaultCallStacks, and
  defaultExceptionContext since 9.10): an unsolved ?callStack :: CallStack (HasCallStack) is the empty stack, an
  unsolved ?exceptionContext :: ExceptionContext (HasExceptionContext) the empty context; nil for another"
  [pred]
  (let [[c ts] (zonk-pred pred)
        cip (fn [x] (list 'app (list 'v (ext-name "var" "GHC.Internal.Classes" "C:IP")) [x]))
        nm (cond (= c cls-callstack) "callStack"
                 (and (vector? c) (= "HasExceptionContext" (nth c 3))) "exceptionContext"
                 ;; HF10-P43 (a): any implicit parameter of type CallStack (defaultCallStacks' isCallStackPred)
                 (and (= c cls-ip) (= :lit (first (first ts))))
                 (if (= [:tc tc-callstack []] (expand (zonk (second ts)))) "callStack" (second (first ts))))]
    (case nm
      "callStack" (do (when (= c cls-ip) (unify (second ts) (con-ty tc-callstack)))
                      (cip (list 'v (ext-name "var" "GHC.Internal.Stack.Types" "emptyCallStack"))))
      "exceptionContext" (do (when (= c cls-ip) (unify (second ts) (con-ty (ext-name "tc" "GHC.Internal.Exception.Context" "ExceptionContext"))))
                             (cip (list 'v (ext-name "var" "GHC.Internal.Exception.Context" "emptyExceptionContext"))))
      nil)))

(defn default!
  "Haskell 2010 §4.3.4: each ambiguous meta of the wanteds whose classes are standard, one numeric, defaulted to the
  first of (Integer, Double) that satisfies them all; then every wanted solved"
  [wanteds]
  (loop [k 0] (when (and (< k 6) *deferred-eqs* (invert-families!)) (recur (inc k))))
  (loop [k 0] (when (and (< k 4) (improve! wanteds)) (recur (inc k))))
  (let [wanteds (map #(under-givens % identity) wanteds)]
  (let [ws (mapv #(assoc % :pred (zonk-pred (:pred %))) wanteds)
        by-meta (group-by (fn [w] (let [ts (second (:pred w))] (when (and (= 1 (count ts)) (= :mv (first (first ts)))) (second (first ts))))) ws)]
    (doseq [[i group] by-meta :when i]
      (let [classes (map (comp occ first :pred) group)]
        (when (and (every? standard-classes classes) (some numeric-classes classes))
          (when-let [t (first (filter (fn [t] (every? (fn [w] (solve-pred [(first (:pred w)) [t]] [] 0)) group))
                                      (cond-> (or *defaults* [(con-ty tc-integer) (con-ty tc-double)]) *control* reverse)))]
            (unify [:mv i] t)))))
    ;; HF10-P54 (a): in rounds, until one solves nothing (a wanted a later one's instance improves: testeq2's Show ?b
    ;; after TypeEq [Char] [Char] ?b gave ?b := HTrue); a wanted made under a let ?x = e's bindings solved with them
    ;; (:ipg, T17104's F Int, a family reducing to ?x :: String)
    (loop [ws ws]
      (let [before (mapv (comp zonk-pred :pred) ws)
            left (filterv (fn [w]
                            (if-let [term (binding [*ip-givens* (or (:ipg w) *ip-givens*)]
                                            (or (if-let [g (:geqs w)] (binding [*given-eqs* g] (solve-pred (:pred w) [] 0)) (solve-pred (:pred w) [] 0))
                                                (default-ip (:pred w))))]
                              (do (swap! *evidence* assoc (:ev w) term) false)
                              true))
                          ws)]
        (if (and (seq left) (< (count left) (count ws)) (not= before (mapv (comp zonk-pred :pred) ws)))
          (recur left)
          ;; (queue 369: under -fdefer-type-errors an unsolved wanted's evidence raises its message, a dictionary of its own
          ;; as GHC's deferred error is: Defer01's $dEq = typeError "... No instance for Eq B ...")
          (doseq [w left]
            (if *defer*
              (swap! *evidence* assoc (:ev w) (type-error-core (dict-defer-text w)))
              (error! "unsolved: " (pr-str (zonk-pred (:pred w))))))))))))

;; queue 325: an Integer literal outside Int#'s range (GHC.Core.Make's mkIntegerExpr: IS of an Int# literal only when
;; platformInIntRange, else IP / IN of a LitNumBigNat, which CorePrep's cvtLitBigNat builds from the literal's bytes). An IS
;; of a wider literal read back as a machine Int (cgrun034's fromRational of 1.82...e-300, its 10^300 denominator, gave a zero
;; denominator). Here the value is built from 60-bit chunks by ghc-internal's integerShiftL# and integerAdd (integerNegate for a
;; negative one): the same Integer at run time, the STG not GHC's bytes (CorePrep's ByteArray# construction not ported)
(defn integer-lit-core
  "The Core of the Integer literal X (an integer or its decimal text): IS x# in Int#'s range, else built from 60-bit chunks"
  [x]
  (let [n (bigint (if (string? x) (java.math.BigInteger. ^String x) x))
        is (fn [v] (list 'app (list 'v (ext-name "var" "GHC.Internal.Bignum.Integer" "IS")) [(list 'lit (str v "#"))]))
        mn (bigint Long/MIN_VALUE) mx (bigint Long/MAX_VALUE)]
    (if (and (<= mn n) (<= n mx))
      (is n)
      (let [neg (neg? n)
            a (biginteger (if neg (- n) n))
            m (.subtract (.shiftLeft java.math.BigInteger/ONE 60) java.math.BigInteger/ONE)
            chunks (loop [a a acc ()] (if (zero? (.signum a)) acc (recur (.shiftRight a 60) (conj acc (.and a m)))))
            iv (fn [nm] (list 'v (ext-name "var" "GHC.Internal.Bignum.Integer" nm)))
            pos (reduce (fn [acc c]
                          (list 'app (iv "integerAdd") [(list 'app (iv "integerShiftL#") [acc (list 'lit "60##")]) (is c)]))
                        (is (first chunks)) (rest chunks))]
        (if neg (list 'app (iv "integerNegate") [pos]) pos)))))

(defn- fl-ratio
  "A FractionalLit (FL (src S) NEG (:% N D) EXP BASE) as the Core of its Rational: (:%) of two Integers, reduced"
  [fl]
  (let [[_ _ _ [_ n d] e] fl
        n (bigint n) d (bigint d) e (long e)
        p (.pow (java.math.BigInteger/TEN) (int (Math/abs e)))
        [n d] (if (neg? e) [n (* d (bigint p))] [(* n (bigint p)) d])
        g (.gcd (biginteger n) (biginteger d))
        n (/ n (bigint g)) d (/ d (bigint g))
        int-core integer-lit-core]
    (list 'app (list 'v (ext-name "var" "GHC.Internal.Real" ":%")) [(int-core n) (int-core d)])))

(defn- lit-core
  "An overloaded literal at its final type: GHC's desugarer's folded forms at Int, Integer, Double, else the
  conversion applied to the dictionary"
  [kind val ty ev f]
  (let [t (expand (zonk ty)) tn (when (= :tc (first t)) (second t))]
    (case kind
      ;; HF10-P54 (a): an overloaded string at String is the String literal (tcShortCutLit's go_string, isStringTy),
      ;; else fromString of it
      :str (let [l (second (hslit (list 'HsLit nil (list 'HsString nil val))))]
             (if (= (deep-expand t) (list-ty (con-ty tc-char))) l (list 'app (list 'v f) [ev l])))
      ;; (queue 352: at Int only within Int#'s range, as GHC's tcShortCutLit (platformInIntRange); a literal outside it is
      ;; fromInteger of the Integer, which wraps: T9533b's 0x10000000000000001 :: Int is 1)
      :int (cond (and (= tn tc-int) (let [n (bigint (if (string? val) (java.math.BigInteger. ^String val) val))]
                                     (and (<= (bigint Long/MIN_VALUE) n) (<= n (bigint Long/MAX_VALUE)))))
                 (list 'app (list 'v (ext-name "var" "GHC.Internal.Types" "I#")) [(list 'lit (str val "#"))])
                 (= tn tc-double) (list 'app (list 'v (ext-name "var" "GHC.Internal.Types" "D#")) [(list 'lit (str val ".0##"))])
                 (= tn tc-float) (list 'app (list 'v (ext-name "var" "GHC.Internal.Types" "F#")) [(list 'lit (str val ".0#"))])
                 (= tn tc-integer) (integer-lit-core val)
                 :else (list 'app (list 'v f) [ev (integer-lit-core val)]))
      :frac (let [txt (let [s (nth val 1)] (if (seq? s) (second s) (str s)))]
              (case (when tn (occ tn))
                "Double" (list 'app (list 'v (ext-name "var" "GHC.Internal.Types" "D#")) [(list 'lit (str txt "##"))])
                "Float" (list 'app (list 'v (ext-name "var" "GHC.Internal.Types" "F#")) [(list 'lit (str txt "#"))])
                ;; another type: fromRational of the literal as a Rational, n :% d reduced (dsFractionalLitToRational)
                (list 'app (list 'v f) [ev (fl-ratio val)]))))))

(defn- drop-unused-ev
  "The evidence bindings nothing uses removed (the desugarer binds only the evidence the solver needed), after the
  placeholders' resolution"
  [c]
  (cond
    (and (seq? c) (= 'let (first c)) (= 1 (count (second c))) (contains? @ev-binders (second (first (second c)))))
    (let [[_ [[_ x t]] body] c body2 (drop-unused-ev body)
          occ? (fn occ? [y] (cond (= y x) true (coll? y) (boolean (some occ? y)) :else false))]
      (if (occ? body2) (list 'let [(list 'bind x (drop-unused-ev t))] body2) body2))
    (seq? c) (with-meta (apply list (map drop-unused-ev c)) (meta c))
    (vector? c) (mapv drop-unused-ev c)
    :else c))

(defn- negate-lit-core
  "Queue 352: a built-in literal's core (K (lit S)) with its value negated (tidyNPat's negated mb_int_lit and mb_rat_lit at
  Double, Float); a zero keeps no sign (the literal is a rational: -0.0 is 0.0)"
  [r]
  (let [a (when (and (seq? r) (= 'app (first r)) (vector? (nth r 2)) (= 1 (count (nth r 2)))) (first (nth r 2)))]
    (if (and (seq? a) (= 'lit (first a)) (string? (second a)))
      (let [s (second a)
            s2 (cond (str/starts-with? s "-") (subs s 1) (re-matches #"[0.]+#+" s) s :else (str "-" s))]
        (list 'app (second r) [(list 'lit s2)]))
      (do (error! "negative literal pattern not handled: " (pr-str r)) r))))

(defn resolve-core
  "The core with every evidence placeholder replaced by its term and the literals resolved"
  [c]
  (cond
    (and (seq? c) (= 'ev (first c))) (let [t (get @*evidence* (second c))]
                                       (if t (resolve-core t) (list 'unsolved (second c))))
    (and (seq? c) (= 'olit (first c))) (let [[_ kind val ty ev f] c] (resolve-core (lit-core kind val ty ev f)))
    ;; queue 352: a negative literal pattern's literal at a type without built-in literals, negate applied to it (tcNPat's
    ;; neg_lit, the equality's argument)
    (and (seq? c) (= 'nolit (first c))) (resolve-core (list 'app (nth c 1) [(nth c 2)]))
    ;; GHC's tidyNPat: a numeric literal pattern at a type with built-in literals is matched directly, no (==)
    (and (seq? c) (= 'plit (first c)) (= 4 (count c)))
    (let [t (expand (zonk (nth c 3)))]
      (cond
        ;; HF10-P54 (a): an overloaded string pattern at String is the string's pattern (tidyNPat's isStringTy)
        (and (seq? (nth c 2)) (= 'olit (first (nth c 2))) (= :str (second (nth c 2))) (= (deep-expand t) (list-ty (con-ty tc-char))))
        (list 'plit (resolve-core (nth c 2)))
        :else
      ;; (an overloaded string at another type keeps its (==): T3382's "hello" at Int, its IsString Int's fromString)
      (if (and (= :tc (first t)) (contains? #{"Int" "Word" "Char" "Double" "Float"} (occ (second t)))
               (contains? #{"GHC.Internal.Types"} (nmod (second t)))
               (not (and (seq? (nth c 2)) (= 'olit (first (nth c 2))) (= :str (second (nth c 2))))))
        (let [l (nth c 2)
              ;; queue 352: a negative literal pattern's literal (nolit NEGATE LIT) negated here, as tidyNPat's mb_int_lit
              ;; and mb_rat_lit negate the value
              neg (and (seq? l) (= 'nolit (first l)))
              l (if neg (nth l 2) l)
              tn (occ (second t))]
          ;; HF10-P20: at Word the literal W# n## (tidyNPat's mb_int_lit at wordTy; lit-core folds no Word literal,
          ;; GHC's expressions keep fromInteger there: Num Word's `signum 0 = 0` matched nothing). Queue 352: at Int and
          ;; Word the value wrapped to the type's 64 bits, as the desugarer's HsIntPrim and HsWordPrim literals are
          ;; (mkLitIntWrap, mkLitWordWrap: T9533's -1 at Word, T9533b's 0x10000000000000001 at Int)
          (if (and (contains? #{"Int" "Word"} tn) (seq? l) (= 'olit (first l)) (= :int (second l)))
            (let [x (nth l 2) n (bigint (if (string? x) (java.math.BigInteger. ^String x) x)) n (if neg (- n) n)
                  m (bigint (.shiftLeft java.math.BigInteger/ONE 64)) w (mod n m)
                  v (if (and (= "Int" tn) (>= w (quot m 2))) (- w m) w)]
              (list 'plit (list 'app (list 'v (ext-name "var" "GHC.Internal.Types" (if (= "Int" tn) "I#" "W#")))
                                [(list 'lit (str v (if (= "Int" tn) "#" "##")))])))
            (let [r (resolve-core l)]
              (list 'plit (if neg (negate-lit-core r) r)))))
        (list 'plit (resolve-core (nth c 1)) (resolve-core (nth c 2))))))
    (seq? c) (let [c' (apply list (map resolve-core c))]
               ;; flatten (app (app f a) b)
               (if (and (= 'app (first c')) (seq? (second c')) (= 'app (first (second c'))))
                 (list 'app (second (second c')) (into (nth (second c') 2) (nth c' 2)))
                 c'))
    (vector? c) (mapv resolve-core c)
    :else c))

;;; ------------------------------------------------------------------------------------------
;;; The module

;;; ------------------------------------------------------------------------------------------
;;; Typeable's bindings (GHC.Tc.Instance.Typeable: mkTypeableBinds): the module's $trModule and a $tc binding
;;; per type constructor, with GHC's fingerprints (GHC.Internal.Fingerprint: MD5 over each string's characters
;;; as four big-endian bytes, then over the three fingerprints' sixteen big-endian bytes)

(defn- md5 [^bytes bs] (.digest (java.security.MessageDigest/getInstance "MD5") bs))
(defn- fp-words [^bytes d]
  [(reduce (fn [acc i] (+' (*' acc 256) (bit-and (aget d i) 255))) 0 (range 0 8))
   (reduce (fn [acc i] (+' (*' acc 256) (bit-and (aget d i) 255))) 0 (range 8 16))])
(defn- fp-string ^bytes [s]
  (md5 (byte-array (mapcat (fn [c] (let [w (int c)] [(unchecked-byte (bit-shift-right w 24)) (unchecked-byte (bit-shift-right w 16))
                                                      (unchecked-byte (bit-shift-right w 8)) (unchecked-byte w)])) s))))
(defn tycon-fingerprint
  "GHC's fingerprint of a type constructor: [high low]"
  [unit m occ]
  (fp-words (md5 (byte-array (mapcat seq [(fp-string unit) (fp-string m) (fp-string occ)])))))

(declare prim-typeable-binds promoted-typeable-binds own-kind-rep)

(defn- typeable-binds [m]
  (let [v (fn [mm o] (list 'v (ext-name "var" mm o)))
        trname (fn [s] (list 'app (v "GHC.Internal.Types" "TrNameS") [(list 'lit (str (pr-str s) "#"))]))
        modv (ext-name "var" m "$trModule")]
    (when (seq @*tycons*)
      (concat
        [(list 'bind modv (list 'app (v "GHC.Internal.Types" "Module") [(trname *unit*) (trname m)]))]
        (when (= m "GHC.Internal.Types") (prim-typeable-binds *unit* trname))
        ;; HF10-P41 (a): every module's promoted constructors' (todoForTyCons), not GHC.Internal.Types' alone
        (promoted-typeable-binds m *unit* trname modv)
        (for [[tn info] @*tycons* :when (= m (nmod tn))]
          (let [[hi lo] (tycon-fingerprint *unit* m (occ tn))
                arity (count (:tvs info []))
                star (v "GHC.Internal.Types" "krep$*")
                krep (reduce (fn [acc _] (list 'app (v "GHC.Internal.Types" "KindRepFun") [star acc])) star (range arity))
                ;; HF10-P41 (a): an inferred kind's KindRep, its kind variables the TyCon's (trTyConKindArgs' count)
                k (:kind info)
                [kvs kbody] (if (= :forall (first k)) [(nth k 1) (nth k 3)] [[] k])
                krep' (when k (own-kind-rep (zipmap kvs (range)) kbody))]
            (list 'bind (ext-name "var" m (str "$tc" (occ tn)))
                  (list 'app (v "GHC.Internal.Types" "TyCon")
                        [(list 'lit (str hi "#w64")) (list 'lit (str lo "#w64")) (list 'v modv) (trname (occ tn))
                         (list 'lit (str (if krep' (count kvs) 0) "#")) (or krep' krep)]))))
        ;; HF10-P42 (a): a class's TyCon too (mkTypeableBinds' tycons include the classes' tycons: Typeable of a
        ;; constraint, typeRep @(Eq Int)), its kind its parameters' Type -> Constraint (the class's kind variables,
        ;; Typeable's k, not counted)
        (for [[cn info] @*classes* :when (and (= m (nmod cn)) (not (contains? @*tycons* cn)))]
          (let [[hi lo] (tycon-fingerprint *unit* m (occ cn))
                krep (reduce (fn [acc _] (list 'app (v "GHC.Internal.Types" "KindRepFun") [(v "GHC.Internal.Types" "krep$*") acc]))
                             (v "GHC.Internal.Types" "krep$Constraint") (range (count (:tvs info []))))]
            (list 'bind (ext-name "var" m (str "$tc" (occ cn)))
                  (list 'app (v "GHC.Internal.Types" "TyCon")
                        [(list 'lit (str hi "#w64")) (list 'lit (str lo "#w64")) (list 'v modv) (trname (occ cn)) (list 'lit "0#") krep]))))))))

;;; HF10-P20 (a): GHC.Internal.Types' Typeable bindings of the wired-in things (GHC.Tc.Instance.Typeable's mkPrimTypeableTodos,
;;; run when the module is GHC.Types): tr$ModuleGHCPrim, the built-in kind representations (builtInKindReps: krep$*,
;;; krep$Constraint, krep$*Arr*, krep$*->*->*), a $tc binding for each of GHC.Internal.Prim's type constructors with its
;;; KindRep (mkKindRepRhs over the kind its interface writes, GHC.Internal.Prim's own since HF10-P18 (a)) and a $tc' binding
;;; for each promoted data constructor of the module whose type is a KindRep (todoForTyCons' promoted constructors)

(defn- trv [o] (list 'v (ext-name "var" "GHC.Internal.Types" o)))
(defn- kr-list [xs] (reduce (fn [acc x] (list 'app (trv ":") [x acc])) (trv "[]") (reverse xs)))
(defn- kr-tycon-app [ref args] (list 'app (trv "KindRepTyConApp") [ref (kr-list args)]))
(defn- kr-fun [a b] (list 'app (trv "KindRepFun") [a b]))
(defn- kr-var [i] (list 'app (trv "KindRepVar") [(list 'app (trv "I#") [(list 'lit (str i "#"))])]))

(defn- form-tc [ns m o args] (list 'tycon-app (list 'ext (symbol ns) m o) (vec args)))
(def ^:private lifted-rep-form (form-tc "data" "GHC.Internal.Types" "BoxedRep" [(form-tc "data" "GHC.Internal.Types" "Lifted" [])]))
(defn- type-of-rep [r] (form-tc "tc" "GHC.Internal.Prim" "TYPE" [r]))

(defn- expand-kind
  "coreView over a kind form's head: the synonyms of GHC.Internal.Types the interfaces name (Type, UnliftedType, ZeroBitType,
  Constraint and the representations LiftedRep, UnliftedRep, ZeroBitRep)"
  [f]
  (if (and (seq? f) (= 'tycon-app (first f)) (= "GHC.Internal.Types" (nth (second f) 2)) (= 'tc (nth (second f) 1)))
    (case (nth (second f) 3)
      "Type" (type-of-rep lifted-rep-form)
      "Constraint" (form-tc "tc" "GHC.Internal.Prim" "CONSTRAINT" [lifted-rep-form])
      "UnliftedType" (type-of-rep (form-tc "tc" "GHC.Internal.Types" "UnliftedRep" []))
      "ZeroBitType" (type-of-rep (form-tc "tc" "GHC.Internal.Types" "ZeroBitRep" []))
      "LiftedRep" lifted-rep-form
      "UnliftedRep" (form-tc "data" "GHC.Internal.Types" "BoxedRep" [(form-tc "data" "GHC.Internal.Types" "Unlifted" [])])
      "ZeroBitRep" (form-tc "data" "GHC.Internal.Types" "TupleRep"
                            [(form-tc "data" "GHC.Internal.Types" "[]" [(form-tc "tc" "GHC.Internal.Types" "RuntimeRep" [])])])
      f)
    f))

(defn- norm-kind [f]
  (let [f (expand-kind f)]
    (cond (and (seq? f) (= 'tycon-app (first f))) (list 'tycon-app (second f) (mapv norm-kind (nth f 2)))
          (and (seq? f) (= 'fun (first f))) (list 'fun 't 'many (norm-kind (nth f 3)) (norm-kind (nth f 4)))
          :else f)))

(def ^:private built-in-kind-reps
  (let [star (norm-kind (form-tc "tc" "GHC.Internal.Types" "Type" []))
        arr (fn [a b] (list 'fun 't 'many a b))]
    [[star "krep$*"] [(norm-kind (form-tc "tc" "GHC.Internal.Types" "Constraint" [])) "krep$Constraint"]
     [(arr star star) "krep$*Arr*"] [(arr star (arr star star)) "krep$*->*->*"]]))

(defn- tc-rep-ref
  "The TyCon representation's binding of a type constructor (ext NS M O): a promoted constructor's $tc'O, GHC.Internal.Prim's
  in GHC.Internal.Types"
  [[_ ns m o]]
  ;; (a form's namespace is a symbol, the elaborator's names' a string: HF10-P41 (a)'s kinds name promoted constructors as data)
  (if (= "data" (str ns))
    (list 'v (ext-name "var" m (str "$tc'" o)))
    (list 'v (ext-name "var" (if (= m "GHC.Internal.Prim") "GHC.Internal.Types" m) (str "$tc" o)))))

(defn- form-kind-rep
  "mkKindRepRhs over a kind form (the binders' de Bruijn indices env), the built-in KindReps found by the kind's
  normal form except the one being defined"
  [env f & [defining]]
  (let [f (norm-kind f)
        builtin (some (fn [[k n]] (when (and (= k f) (not= n defining)) n)) built-in-kind-reps)]
    (cond
      builtin (trv builtin)
      (= 'tv (first f)) (kr-var (or (get env (second f)) (throw (ex-info (str "typeable: unbound kind variable " (second f)) {}))))
      (= 'fun (first f)) (kr-fun (form-kind-rep env (nth f 3)) (form-kind-rep env (nth f 4)))
      (= 'tycon-app (first f))
      (let [[_ [_ _ m o] args] f
            con0 (fn [a] (when (and (seq? a) (= 'tycon-app (first a)) (= 'data (nth (second a) 1))) a))]
        (or (when (and (= m "GHC.Internal.Prim") (= o "TYPE"))
              (let [r (first args)]
                (when-let [r (con0 r)]
                  (let [[_ [_ _ rm ro] rargs] r]
                    (cond (empty? rargs) (list 'app (trv "KindRepTYPE") [(list 'v (ext-name "var" rm ro))])
                          (and (= 1 (count rargs)) (con0 (first rargs)) (empty? (nth (first rargs) 2)))
                          (let [[_ [_ _ lm lo]] (first rargs)]
                            (list 'app (trv "KindRepTYPE") [(list 'app (list 'v (ext-name "var" rm ro)) [(list 'v (ext-name "var" lm lo))])]))
                          :else nil)))))
            (kr-tycon-app (tc-rep-ref (second f)) (map #(form-kind-rep env %) args))))
      :else (throw (ex-info (str "typeable: kind not handled " (pr-str f)) {})))))

(defn- split-foralls [f]
  (loop [f f vs []]
    (if (and (seq? f) (= 'forall (first f))) (recur (nth f 4) (conj vs (nth f 1))) [vs f])))

(defn- prim-things
  "GHC.Internal.Prim's interface's things (the closure's wired-in interface)"
  []
  (let [p (or (get *iface-files* "GHC.Internal.Prim")
              (some (fn [d] (let [f (File. (str d "/GHC.Internal.Prim.iface.edn"))] (when (.isFile f) (.getPath f)))) *ifdirs*))]
    (when p
      (let [f (File. ^String p) k [(.getCanonicalPath f) (.lastModified f)]
            forms (or (get @iface-forms k) (let [x (read-forms (slurp f))] (swap! iface-forms assoc k x) x))]
        (second (some #(when (= 'hsiface/things (first %)) %) forms))))))

(defn- elab-kind-rep
  "A promoted constructor's type (the elaborator's) as a KindRep: nil when it is not one (a context, a type the forms
  cannot name, a type family's application). HF10-P41 (a): Type the built-in krep$*, Constraint krep$Constraint, a
  synonym expanded, a promoted constructor written without its quote the data constructor's (promote-kind-names)"
  [env t]
  (let [t (promote-kind-names (prune t))]
    (case (first t)
      :tv (when-let [i (get env (second t))] (kr-var i))
      :tc (let [[_ n as] t]
            (cond (= t star-kind) (trv "krep$*")
                  (= t constraint-kind) (trv "krep$Constraint")
                  (and (= fun-tc n) (= 2 (count as)))
                  (let [a (elab-kind-rep env (first as)) b (elab-kind-rep env (second as))] (when (and a b) (kr-fun a b)))
                  (get @*syns* n) (let [x (expand t)] (when (not= x t) (elab-kind-rep env x)))
                  (some-> *families* deref (contains? n)) nil
                  ;; a promoted constructor of a poly-kinded type ('[], ':): its kind arguments are not the elaborator's
                  ;; (instantiateKindRep would find them missing)
                  (and (vector? n) (= "data" (nth n 1)) (= :forall (first (get @*genv* n))) (seq (nth (get @*genv* n) 1))) nil
                  (and (vector? n) (ext? n))
                  (let [rs (map #(elab-kind-rep env %) as)] (when (every? some? rs) (kr-tycon-app (tc-rep-ref n) rs)))
                  :else nil))
      nil)))

(defn- own-kind-rep
  "HF10-P41 (a): an own type constructor's inferred kind as a KindRep (its kind variables' indices env); nil for a kind
  the forms cannot name"
  [env k]
  (elab-kind-rep env k))

(defn- prim-typeable-binds
  "mkPrimTypeableTodos' bindings, when the module is GHC.Internal.Types"
  [unit trname]
  (let [modp (ext-name "var" "GHC.Internal.Types" "tr$ModuleGHCPrim")
        tycon (fn [m modv o nk krep]
                (let [[hi lo] (tycon-fingerprint unit m o)]
                  (list 'app (trv "TyCon") [(list 'lit (str hi "#w64")) (list 'lit (str lo "#w64")) (list 'v modv) (trname o)
                                            (list 'lit (str nk "#")) krep])))]
    (concat
      [(list 'bind modp (list 'app (trv "Module") [(trname unit) (trname "GHC.Internal.Prim")]))]
      (for [[k n] built-in-kind-reps] (list 'bind (ext-name "var" "GHC.Internal.Types" n) (form-kind-rep {} k n)))
      (for [t (prim-things) :when (and (seq? t) (= 'tycon (first t)))]
        (let [o (nth (second t) 3) [vs body] (split-foralls (nth t 5))]
          (list 'bind (ext-name "var" "GHC.Internal.Types" (str "$tc" o))
                (tycon "GHC.Internal.Prim" modp o (count vs) (form-kind-rep (zipmap vs (range)) body))))))))

(defn- promoted-typeable-binds
  "The module's promoted constructors' $tc' bindings (todoForTyCons: tyConIsTypeable of the promoted constructor, its kind
  the constructor's type without a context); the unboxed tuples' and sums' left out (GHC writes the tuples' $tc'(#,#)...: their
  KindRepFun nests, up to 64 deep, as one nested term each, take the -O0 pipeline past the module's time limit; GHC binds
  each $krep apart)"
  [m unit trname modv]
  (for [[tn info] @*tycons* :when (and (= m (nmod tn)) (not (re-matches #"(Tuple|Sum)[0-9]+#" (occ tn)))) c (:cons info)
        :let [t (get @*genv* c)
              [vs ctx body] (if (= :forall (first t)) [(nth t 1) (nth t 2) (nth t 3)] [[] [] t])
              ;; synonyms expanded (coreView: KindRepVar's KindBndr is Int)
              krep (when (and t (empty? ctx)) (elab-kind-rep (zipmap vs (range)) (try (deep-expand body) (catch Throwable _ body))))]
        :when krep]
    (let [o (str "'" (occ c)) [hi lo] (tycon-fingerprint unit m o)]
      (list 'bind (ext-name "var" m (str "$tc" o))
            (list 'app (trv "TyCon") [(list 'lit (str hi "#w64")) (list 'lit (str lo "#w64")) (list 'v modv) (trname o)
                                      (list 'lit (str (count vs) "#")) krep])))))

(def ^:private phase-times? (some? (System/getenv "REPR_HASKELL_TC_TIMES")))
(defmacro ^:private phase
  "e's value; with REPR_HASKELL_TC_TIMES set its milliseconds on stderr, named k (the elaborator's phases, HF9's
  second slice's measure of where a module's time goes)"
  [k e]
  `(if phase-times?
     (let [t0# (System/currentTimeMillis) v# ~e]
       (binding [*out* *err*] (println "tc-phase" ~k (- (System/currentTimeMillis) t0#)))
       v#)
     ~e))

(defn- defer-main!
  "Queue 369: checkMain's tcCheckMonoExpr of main against IO t (t a fresh meta, printed t0) under MainCtxt at main's binding,
  under -fdefer-type-errors: nil when it unifies, else [NAME (bind NAME typeError-of-the-message)]"
  [env binds]
  (let [mn (ext-name "var" "Main" "main")
        b (some (fn [g] (some #(when (= mn (bind-name %)) %) (arg g 2))) binds)
        e (get env mn)]
    (when (and b e (:poly e))
      (let [nl (arg (lval b) 2) sp (lsp nl)
            [t _] (instantiate (:poly e))
            tv (fresh-meta) _ (swap! *metas* assoc-in [(second tv) :name] "t")
            io [:tc (ext-name "tc" "GHC.Internal.Types" "IO") [tv]]
            errs (atom []) log (atom [])
            ex (list 'L sp (list 'HsVar 'NoExtField (list 'L sp (list 'rn/name mn))))]
        (binding [*errors* errs *defer-log* log *ectx* (list [:expr ex] [:main]) *espan* sp]
          (unify-ea t io ex))
        (when (seq @errs)
          (let [n (ext-name "var" "Main" "main$deferred")
                msg (if (seq @log) (first (mismatch-text (first @log))) (envelope sp "83865" [(doc/text (first @errs))]))]
            [n (list 'bind n (type-error-core msg))]))))))

(defn typecheck-module
  "A renamed module (rn/module {...}) elaborated: {:types {NAME type} :core [(bind ...)...] :errors [...]}"
  [tree]
  (let [{:keys [module decls binds sigs]} (second tree)
        m module
        ;; queue 364: the foreign exports (tcFExport): each a top-level binding of a stable name, $fstable:N:UNIT:MOD:NAME
        ;; (mkStableIdFromName, mkForeignExportOcc; N the module's wrapper counter, in source order) whose right-hand side is
        ;; the exported name at the declared type (tcCheckPolyExpr: its dictionaries applied), signed by that type; the C
        ;; stub calls it (fexport-cbits)
        fexps (vec (map-indexed
                    (fn [i [d fe]]
                      (let [n (nm (arg fe 2)) es (lval (arg (arg fe 4) 2))
                            sname (str "$f" (zenc (str "stable:" i ":" *unit* ":" module ":" (occ n))))
                            sp (or (lsp d) (lsp (arg fe 2)))]
                        {:n n :sig (arg fe 3) :cname (arg es 2) :sname sname :name (ext-name "var" module sname) :span sp}))
                    (for [d decls :let [v (lval d)] :when (and (= 'ForD (con v)) (= 'ForeignExport (con (arg v 2))))]
                      [d (arg v 2)])))
        sigs (into (vec sigs) (for [{:keys [name sig span]} fexps]
                                (list 'L span (list 'TypeSig nil [(list 'L span (list 'rn/name name))] (list 'HsWC 'NoExtField sig)))))
        binds (into (vec binds)
                    (for [{:keys [name n span]} fexps
                          :let [l (fn [x] (list 'L span x)) rn (fn [x] (l (list 'rn/name x)))]]
                      (list 'rn/group 'nonrec
                            [(l (list 'FunBind 'NoExtField (rn name)
                                      (list 'MG 'FromSource
                                            (l [(l (list 'Match 'NoExtField (list 'FunRhs (rn name) 'Prefix 'NoSrcStrict nil) (list 'L nil [])
                                                         (list 'GRHSs nil [(l (list 'GRHS nil [] (l (list 'HsVar 'NoExtField (rn n)))))]
                                                               (list 'EmptyLocalBinds 'NoExtField))))]))))])))
        ;; queue 369: -fdefer-type-errors (the last of it and -fno-defer-type-errors), the command line's or an OPTIONS_GHC's
        defer? (= "-fdefer-type-errors" (last (filter #{"-fdefer-type-errors" "-fno-defer-type-errors"} (:fflags (second tree)))))]
    (binding [*metas* (atom {}) *counter* (atom 0) *errors* (atom []) *level* 0 *module* module
              *wrapper-num* (atom (count fexps)) *fstubs* (atom [])
              *genv* (atom {}) *fcalls* (atom {}) *classes* (atom {}) *insts* (atom []) *cons* (atom {}) *syns* (atom {})
              *tv-kinds* (atom {}) *tc-kinds* (atom {})
              *wanteds* (atom []) *evidence* (atom {}) *unfoldings* (atom {}) *tycons* (atom {})
              *derivs* (atom []) *deriv-aux* (atom []) *fixities* (atom {}) *ddescs* (atom {}) *exts* (set (:exts (second tree)))
              *ltypes* (atom {}) *skolem-givens* (atom []) *kind-arity* (atom {}) *families* (atom {}) *deferred-eqs* (atom [])
              *implic-eqs* (atom []) *patsyns* (atom {}) *own-fam-insts* (atom []) *iface-meta* (atom {})
              *static-binds* (atom [])
              *defer* defer? *defer-log* (when defer? (atom []))
              ;; round 54: the module's role annotations (type role T nominal ...), for Coercible's improvement
              *coercibles* (atom [])
              ;; the top-level INLINE pragmas active in the -O0 Simplifier's phase (FinalPhase: AlwaysActive, ActiveAfter n)
              *inline-prags* (into {} (for [s sigs :let [sv (lval s)] :when (= 'InlineSig (con sv))
                                            :let [ip (arg sv 3) n (nm (arg sv 2))]
                                            :when (and n (seq? ip) (= 'InlinePragma (first ip)) (seq? (nth ip 2 nil)) (= 'Inline (first (nth ip 2)))
                                                       (let [act (nth ip 4 nil)] (or (= 'AlwaysActive act) (and (seq? act) (= 'ActiveAfter (first act))))))]
                                        [n true]))
              *inline-arities* (atom {})
              *roles* (atom (into {} (for [d decls :let [v (lval d)] :when (= 'RoleAnnotD (con v))
                                           :let [ra (arg v 2) n (nm (arg ra 2))] :when n]
                                       [n (mapv (fn [r] (let [r (lval r)] (if (and (seq? r) (= 'Just (first r))) (str/lower-case (name (second r))) "infer"))) (arg ra 3))])))
              *defaults* (some (fn [d] (let [v (lval d)]
                                         (when (and (= 'DefD (con v)) (= 'DefaultDecl (con (arg v 2))))
                                           (mapv #(hs-type {} %) (last (arg v 2))))))
                               decls)]
      (phase :load-ifaces (load-ifaces!))
      (doseq [s sigs :let [sv (lval s)] :when (= 'FixSig (con sv))
              :let [fs (arg sv 2) fx (arg fs 3)] n (arg fs 2)]
        (swap! *fixities* assoc (nm n) [(nth fx 1) (nth fx 2)]))
      (let [tycl (for [d decls :let [v (lval d)] :when (= 'TyClD (con v))] (arg v 2))
            _ (doseq [t tycl] (case (con t) SynDecl (syn-decl! t) nil))
            ;; the module's type families, top-level and associated (a class's), and their instances, top-level and
            ;; in instance declarations (an associated type's default, a class's at-defs, not an instance)
            _ (let [fds (atom []) tfis (atom [])]
                (letfn [(walk [x]
                          (cond (and (seq? x) (= 'FamilyDecl (first x))) (swap! fds conj x)
                                (and (seq? x) (= 'TyFamInstDecl (first x))) (swap! tfis conj x)
                                (and (seq? x) (= 'ClassDecl (first x))) (doseq [[i y] (map-indexed vector x) :when (not= i 10)] (walk y))
                                (coll? x) (doseq [y x] (walk y))
                                :else nil))]
                  (walk decls))
                (doseq [fd @fds] (fam-decl! fd))
                (doseq [tfi @tfis] (tyfam-inst! tfi)))
            _ (phase :data-class (doseq [t tycl] (case (con t) DataDecl (data-decl! m t) ClassDecl (class-decl! m t) nil)))
            ;; data family instances (TypeFamilies' data instance, top-level or associated): a data declaration of a
            ;; representation tycon whose constructors build the family applied to the instance's patterns
            _ (let [dfis (atom [])]
                (letfn [(walk [x] (cond (and (seq? x) (= 'DataFamInstDecl (first x))) (swap! dfis conj x)
                                        (coll? x) (doseq [y x] (walk y))
                                        :else nil))]
                  (walk decls))
                (doseq [dfi @dfis]
                  (let [e (arg dfi 1) fname (nm (arg e 2))
                        pats (vec (for [a (arg e 4) :when (and (seq? a) (= 'HsValArg (first a)))] (arg a 2)))
                        tvn (tv-names-of [(arg e 3) pats])
                        pts (fn [tvs] (mapv #(hs-type tvs %) pats))
                        ;; HF10-P34: a pattern with a kind signature spelled as GHC's newFamInstTyConName does, the
                        ;; kind's constructor and the variable (data instance Sing (a :: Bool): R:SingBoola); every
                        ;; instance of Sing was R:Sing before, the last one's constructors replacing the others'
                        ksig (fn [p] (loop [p p]
                                       (let [v (lval p)]
                                         (case (con v)
                                           HsParTy (recur (arg v 2))
                                           HsKindSig (let [tv (lval (arg v 2))]
                                                       (str (head-occs [(hs-type {} (arg v 3))])
                                                            (if (= 'HsTyVar (con tv)) (occ (nm (arg tv 3))) "")))
                                           nil))))
                        base-occ (if (some ksig pats)
                                   (apply str (map (fn [p] (or (ksig p) (head-occs [(hs-type {} p)]))) pats))
                                   (head-occs (pts {})))
                        rep0 (str "R:" (occ fname) base-occ)
                        rep (ext-name "tc" m (if (contains? @*tycons* (ext-name "tc" m rep0))
                                               (some #(let [c (str rep0 %)] (when-not (contains? @*tycons* (ext-name "tc" m c)) c)) (range))
                                               rep0))
                        names (mapv #(str (occ %) "_" (str/join "_" (drop 3 %))) tvn)]
                    ;; its family instance for the interface (FamInst's fi_rhs: the representation tycon at its variables)
                    (swap! *own-fam-insts* conj [fname {:tvs names :lhs (pts (zipmap tvn (map (fn [x] [:tv x]) names)))
                                                        :rhs [:tc rep (mapv (fn [x] [:tv x]) names)] :data true}])
                    (data-decl! m e {:tn rep :tvn tvn :res-of (fn [tvs] [:tc fname (pts tvs)]) :defn (arg e 6)}))))
            ;; HF10-P41 (a): the own data types' kinds
            ;; HF10-P45 (a): the standalone kind signatures whose quantifiers all lead (TExp :: TYPE r -> Type; Code's
            ;; forall to the right is left to the inference, HF10-P46)
            saks (into {} (for [d decls :let [v (lval d)] :when (= 'KindSigD (con v))
                                :let [ks (lval (arg v 2)) n (when (seq? ks) (nm (arg ks 2)))
                                      k (when n (binding [*errors* nil] (try (sig-type (arg ks 3)) (catch Throwable _ nil))))]
                                :when (and k (not-any? #(and (vector? %) (= :forall (first %)))
                                                       (tree-seq coll? seq (if (= :forall (first k)) (nth k 3) k)))
                                           (or (not= :forall (first k)) (empty? (nth k 2))))]
                            [n (if (and (= :forall (first k)) (empty? (nth k 1))) (nth k 3) k)]))
            _ (try (infer-tycon-kinds! m (let [exts *exts*
                                          lang (or (some #{"Haskell98" "Haskell2010" "GHC2021" "GHC2024"} (reverse (sort exts)))
                                                   (:language (second tree)) "GHC2021")]
                                      (and (not (contains? exts "NoPolyKinds"))
                                           (or (contains? exts "PolyKinds") (contains? #{"GHC2021" "GHC2024"} lang))))
                                    saks)
                   ;; (a kind the inference cannot take leaves the module's kinds of their arity, as before)
                   (catch Throwable e (when trace? (binding [*out* *err*] (println "tc-trace: kinds:" (.getMessage e))))))
            ;; foreign imports: their signature is their type
            ;; HF10-P5 (a): desugared as GHC's dsFImport does (ds-fimport); one it does not take stays the placeholder tostg drops
            ;; (queue 364: desugared as dsForeigns' does, the imports last to first (tcg_fords' order), each with its stub:
            ;; a capi import's wrapper number is the module's next; the bindings in source order)
            fis (vec (for [d decls :let [v (lval d)] :when (and (= 'ForD (con v)) (= 'ForeignImport (con (arg v 2))))
                           :let [fi (arg v 2) n (nm (arg fi 2))]]
                       [n (sig-type (arg fi 3)) (arg fi 4)]))
            _ (doseq [[n t] fis] (swap! *genv* assoc n t))
            fis-core (into {} (for [[i [n t ci]] (reverse (map-indexed vector fis))]
                                (let [st (try (fimport-stub n t ci) (catch Throwable _ {:stub {:h [] :c []}}))]
                                  (swap! *fstubs* conj (:stub st))
                                  [i (or (when-not (= "0" (System/getenv "REPR_HASKELL_FFI"))
                                           (try (ds-fimport n t ci st)
                                                (catch Throwable e
                                                  (when (System/getenv "REPR_HASKELL_FFI_TRACE")
                                                    (binding [*out* *err*] (println "ffi-trace: dsFImport:" (occ n) (.getMessage e))))
                                                  nil)))
                                         (list 'lit (str "foreign import " (occ n))))])))
            fimports (vec (for [[i [n]] (map-indexed vector fis)] (list 'bind n (get fis-core i))))
            ;; the exports' stubs after the imports', last to first, then their initialiser
            _ (doseq [{:keys [cname sname sig]} (reverse fexps)]
                (swap! *fstubs* conj (try (let [[as res] (ffi-split (ffi-normalise (sig-type sig))) [r io?] (io-split res)]
                                            (dissoc (fexport-cbits cname sname as r io?) :ts))
                                          (catch Throwable _ {:h [] :c []}))))
            _ (when-let [l (fexports-init (map :sname (reverse fexps)))] (swap! *fstubs* conj {:h [] :c l}))
            insts (vec (for [d decls :let [v (lval d)] :when (and (= 'InstD (con v)) (= 'ClsInstD (con (arg v 2))))]
                         (inst-decl! m (arg (arg v 2) 2))))
            insts (into insts (phase :derive (derive-all! m decls)))
            ;; derived Data's auxiliary bindings, one recursive group with their signatures ($tT :: DataType, $cC :: Constr)
            top-sigs (into (sigs-of sigs)
                           (for [[n kind _] @*deriv-aux*]
                             [n [:forall [] [] [:tc (ext-name "tc" "GHC.Internal.Data.Data" (if (= kind :datatype) "DataType" "Constr")) []]]]))
            binds (if (seq @*deriv-aux*) (conj (vec binds) (list 'rn/group 'rec (mapv #(nth % 2) @*deriv-aux*))) binds)
            ;; the pattern synonyms' signatures: their pattern types, their builders' types
            _ (doseq [s sigs :let [sv (lval s)] :when (= 'PatSynSig (con sv)) nl (arg sv 2)]
                (let [info (assoc (patsyn-info (arg sv 3)) :sig true)]
                  (swap! *patsyns* assoc (nm nl) info)
                  ;; (the builder's direction is its declaration's: tc-patsyn-bind! registers it again)
                  (register-patsyn! (nm nl) info true)))
            ;; HF10-P36 (a): a pattern synonym's group first when its pattern mentions no value of the module (the
            ;; renamer's dependency order does not see a record synonym's fields as its uses: records-run's main before
            ;; pattern Bi{a, b}); the builders after every binding (GHC.Tc.TyCl.PatSyn's tcPatSynBuilderBind, a later pass:
            ;; an explicit builder may use a binding that matches on the synonym, bidir-explicit-scope's foo)
            mine-var? (fn [x] (and (vector? x) (= 4 (count x)) (= "ext" (nth x 0)) (= "var" (nth x 1)) (= m (nth x 2))))
            hoist? (fn [g] (and (seq (arg g 2)) (every? patsyn-bind? (arg g 2))
                                (not-any? (fn [b] (some mine-var? (tree-seq coll? seq (arg (arg (lval b) 2) 4)))) (arg g 2))))
            binds (into (vec (filter hoist? binds)) (remove hoist? binds))
            [env core] (binding [*patsyn-builders* (atom [])]
                         (let [[env core] (phase :binds (reduce (fn [[env out] g]
                                                                  (let [n0 (count @*errors*) l0 (if *defer-log* (count @*defer-log*) 0)
                                                                        [env1 bs] (tc-group env [(arg g 1) (arg g 2)] top-sigs true)]
                                                                    [env1 (into out (defer-errors! bs n0 l0))]))
                                                                [{} []] binds))]
                           [env (into core (keep (fn [f] (f env)) @*patsyn-builders*))]))
            ;; queue 369: GHC.Tc.Module's checkMain under -fdefer-type-errors: main's type against IO t (MainCtxt, main's
            ;; span); a failure makes :Main.main run a binding of its own that raises the message (runMainIO (typeError ...),
            ;; GHC's main_sat), main itself left as it is
            main-def (when (and *defer* (= m "Main")) (defer-main! env binds))
            dms (phase :default-methods (vec (mapcat (fn [t] (when (= 'ClassDecl (con t)) (default-methods env (nm (arg t 3))))) tycl)))
            ibs (phase :instances (vec (mapcat #(instance-binds env %) insts)))
            ;; GHC's record selectors (GHC.Tc.TyCl.Utils.mkOneRecordSelector): one a field, an alternative for each
            ;; constructor that has it, the others recSelError's (the DEFAULT, first as Core keeps it)
            sels (vec (for [[tn ti] (sort-by (comp str key) @*tycons*) :when (= m (nmod tn))
                            :let [cs (:cons ti) infos (mapv #(get @*cons* %) cs)]
                            f (distinct (mapcat :fields infos))]
                        (if (= [:forall [] [] [:tc (tuple-tc 0) []]] (get @*genv* f))
                          ;; a naughty selector is bound to () (mkOneRecordSelector's unit_rhs)
                          (list 'bind f (list 'v (tuple-con 0)))
                        (let [ds (fresh-lv "ds")
                              alts (vec (for [[cn info] (map vector cs infos) :when (some #(= f %) (:fields info))]
                                          (let [xs (mapv (fn [g] (fresh-lv (occ g))) (:fields info))
                                                ;; the constructor's context's evidence first (an existential's
                                                ;; dictionaries; HF10-P20: Handle__'s selectors took its four
                                                ;; dictionaries for fields)
                                                ds (mapv (fn [[c _]] (fresh-lv (str "$d" (occ c)))) (second (instantiate (get @*genv* cn))))]
                                            (list 'alt cn (into ds xs) (nth xs (.indexOf ^java.util.List (:fields info) f))))))
                              alts (if (< (count alts) (count cs))
                                     (into [(list 'alt :default []
                                                  (list 'app (list 'v (ext-name "var" "GHC.Internal.Control.Exception.Base" "recSelError"))
                                                        [(list 'lit (str (pr-str (occ f)) "#"))]))]
                                           alts)
                                     alts)]
                          (list 'bind f (list 'lam [ds] (list 'case ds (fresh-lv "wild") alts)))))))
            ;; the pattern synonyms' record selectors (GHC.Tc.TyCl.PatSyn's mkPatSynRecSelBinds: \req-dictionaries ds -> case ds
            ;; of P{field = x} -> x; _ -> recSelError, the match through the synonym's matcher since HF10-P36 (a), a synonym
            ;; with a context too; a field whose type mentions an existential has no selector)
            sels (into sels
                       (for [[pn info] (sort-by (comp str key) @*patsyns*)
                             :when (and (= m (nmod pn)) (seq (:fields info)))
                             [i f] (map-indexed vector (:fields info))
                             :when (not-any? (set (:ex info)) (tvs-of (nth (:args info) i)))]
                         (let [ds (fresh-lv "ds")
                               params (mapv dict-param (:req info))
                               dvars (mapv dict-param (:prov info))
                               xs (mapv (fn [g] (fresh-lv (occ g))) (:fields info))]
                           (when-not (get @*genv* f)
                             (swap! *genv* assoc f [:forall (vec (:univ info)) (vec (:req info)) (fn-ty (:res info) (nth (:args info) i))]))
                           (note-type! ds (:res info))
                           (doseq [[x a] (map vector xs (:args info))] (note-type! x a))
                           (list 'bind f (list 'lam (conj params ds)
                                               (list 'match [ds]
                                                     [(list 'clause [(list 'psyn (matcher-name pn) params dvars xs)] (nth xs i))
                                                      (list 'clause [(list 'pwild)]
                                                            (list 'app (list 'v (ext-name "var" "GHC.Internal.Control.Exception.Base" "recSelError"))
                                                                  [(list 'lit (str (pr-str (occ f)) "#"))]))]))))))
            ;; the deferred family equalities retried, as GHC's solver iterates to a fixed point; one still stuck is
            ;; left (trusted)
            _ (retry-implications! true)
            _ (loop [i 0]
                (let [ds @*deferred-eqs*]
                  (reset! *deferred-eqs* [])
                  (doseq [[a b] ds] (unify a b))
                  (when (and (< i 4) (seq @*deferred-eqs*) (not= (count ds) (count @*deferred-eqs*))) (recur (inc i)))))
            _ (phase :default (default! @*wanteds*))
            types (into {} (for [[n e] env :when (and (vector? n) (ext? n) (= m (nmod n)))]
                             [n (zonk (:poly e))]))
            ;; an hs-boot file's values are its signatures (GHC.Tc.Module's tcHsBootSigs: each signature's type the
            ;; value's, no binding); elsewhere a signature without a binding is GHC's error, never written
            types (merge (into {} (for [[n t] top-sigs :when (and (vector? n) (ext? n) (= m (nmod n)) (not (contains? types n)))] [n t]))
                         types)
            ;; the module's constructors (and their workers, the same names in the value namespace) and methods
            cons-types (into {} (for [[n t] @*genv* :when (= m (nmod n))
                                      k (if (= "data" (nth n 1)) [n (ext-name "var" m (occ n))] [n])]
                                  [k t]))]
        {:module m
         :types (merge types cons-types)
         :syns @*syns*
         :exported (cond-> (set (mapcat (fn [[n kids]] (cons n kids)) (:exports (second tree)))) main-def (conj (first main-def)))
         :cons (into {} (filter (fn [[n _]] (= m (nmod n))) @*cons*))
         :classes (into {} (for [[n info] @*classes* :when (= m (nmod n))] [n (dissoc info :binds)]))
         :insts (vec (filter (fn [i] (= m (nmod (:dfun i)))) @*insts*))
         :core (phase :resolve-core (mapv (comp drop-unused-ev resolve-core) (concat fimports core (remove nil? @*static-binds*) dms ibs sels (typeable-binds m)
                                                                                      (when main-def [(second main-def)]))))
         :main-deferred (first main-def)
         ;; the tables HF5-HF6 need (the match compiler's constructor families, STG's data and dictionaries)
         :all-cons @*cons* :tycons @*tycons*
         :all-classes (into {} (for [[n info] @*classes*] [n (dissoc info :binds)]))
         :ltypes (into {} (for [[x t] @*ltypes*] [x (deep-expand (zonk t))]))
         :tv-kinds @*tv-kinds*
         ;; the module's own values its RULES mention: the occurrence analyser keeps them alive (a rule's free
         ;; variables are occurrences: never inlined unconditionally, never dropped)
         :rule-names (let [acc (atom #{})
                           w (fn w [x in?] (cond (and in? (vector? x) (= 4 (count x)) (= "ext" (nth x 0)) (= "var" (nth x 1)) (= m (nth x 2)))
                                                 (swap! acc conj x)
                                                 (coll? x) (let [in2 (or in? (and (seq? x) (= 'HsRule (first x))))] (doseq [y x] (w y in2)))
                                                 :else nil))]
                       (w decls false) @acc)
         ;; HF10-P20: the module's own values its RULES' right-hand sides mention: Tidy makes them external
         ;; (GHC.Iface.Tidy's ruleRhsFreeIds: a rule that fires elsewhere needs them; Enum's eftInt, eftIntList's)
         :rule-rhs-names (let [acc (atom #{})
                               w (fn w [x in?] (cond (and in? (vector? x) (= 4 (count x)) (= "ext" (nth x 0)) (= "var" (nth x 1)) (= m (nth x 2)))
                                                     (swap! acc conj x)
                                                     (and (seq? x) (= 'HsRule (first x))) (w (nth x 6 nil) true)
                                                     (coll? x) (doseq [y x] (w y in?))
                                                     :else nil))]
                           (w decls false) @acc)
         ;; the module's NOINLINE (and OPAQUE) pragmas' binders: never inlined, never inlined unconditionally (their
         ;; inline activation never active)
         ;; the INLINE pragmas' binders and their real arities (makeCorePair: an INLINE unfolding of that arity, the binding
         ;; eta-expanded to it)
         :inline-arities @*inline-arities*
         ;; derived Data's auxiliary binders ($tT, $cC), not exported
         :deriv-aux (set (map first @*deriv-aux*))
         :noinline (let [acc (atom #{})
                         w (fn w [x] (cond (and (seq? x) (= 'InlineSig (first x)))
                                           (let [n (nm (arg x 2))
                                                 txt (let [t (atom nil)] ((fn f [y] (cond (and (string? y) (re-find #"^\{-# *(NOINLINE|NOTINLINE|OPAQUE)" y)) (reset! t y)
                                                                                          (coll? y) (doseq [z y] (f z)) :else nil)) (arg x 3)) @t)]
                                             (when (and n txt) (swap! acc conj n)))
                                           (coll? x) (doseq [y x] (w y))
                                           :else nil))]
                     (w [decls sigs binds]) @acc)
         :genv @*genv*
         :fcalls @*fcalls*
         ;; queue 364: the module's foreign stubs, BASE_stub.h's and BASE_stub.c's lines after their includes (a module
         ;; without foreign declarations has empty ones: deSugar's appendStubC of HPC's initialiser, mempty, makes
         ;; ForeignStubs of NoStubs)
         :fstubs {:h (vec (mapcat :h @*fstubs*)) :c (vec (mapcat :c @*fstubs*))}
         ;; the foreign imports desugared (an INLINE unfolding of their arity, mkInlineUnfoldingWithArity)
         :fimports (set (for [[_ b e] fimports :when (not (and (seq? e) (= 'lit (first e))))] b))
         :kind-arity @*kind-arity*
         ;; HF10-P3: what the module's own interface writes beyond the above (arbace.repr.haskell.ownface): its families,
         ;; its open family instances, its pattern synonyms, its values' types (constructors, methods, foreign imports,
         ;; selectors) and its instances, zonked while the metas are bound
         :families (into {} (filter (fn [[n _]] (= m (nmod n))) @*families*))
         :fam-insts @*own-fam-insts*
         :patsyns (into {} (filter (fn [[n _]] (= m (nmod n))) @*patsyns*))
         :own-genv (into {} (for [[n t] @*genv* :when (= m (nmod n))] [n (zonk t)]))
         :own-insts (vec (for [i @*insts* :when (= m (nmod (:dfun i)))]
                           (assoc i :ctx (mapv (fn [[c ts]] [c (mapv zonk ts)]) (:ctx i))
                                    :head [(first (:head i)) (mapv zonk (second (:head i)))])))
         :errors @*errors*}))))

;;; ------------------------------------------------------------------------------------------
;;; The module's interface (HF1-HF2's proposal 2): the iface verb's forms, so a module that imports it is checked
;;; as against a library's

(def ^:private many "(tycon-app (ext data \"GHC.Internal.Types\" \"Many\") [])")
(def ^:private kind-type "(tycon-app (ext tc \"GHC.Internal.Types\" \"Type\") [])")

(defn type-form
  "A type as the helper's typeF text"
  [t]
  (let [t (zonk t)]
    (case (first t)
      :tv (str "(tv " (pr-str (second t)) ")")
      :mv (str "(tv " (pr-str (str "m" (second t))) ")")
      :tc (if (= fun-tc (second t))
            (str "(fun t " many " " (type-form (first (nth t 2))) " " (type-form (second (nth t 2))) ")")
            (str "(tycon-app " (name-str (second t)) " [" (str/join " " (map type-form (nth t 2))) "])"))
      :app (str "(app " (type-form (nth t 1)) " " (type-form (nth t 2)) ")")
      :forall (let [body (reduce (fn [acc [c ts]] (if (= :qc c)
                                                    (str "(fun c " many " " (type-form (first ts)) " " acc ")")
                                                    (str "(fun c " many " (tycon-app " (name-str c) " [" (str/join " " (map type-form ts)) "]) " acc ")")))
                                 (type-form (nth t 3)) (reverse (nth t 2)))]
                (reduce (fn [acc v] (str "(forall " (pr-str v) " specified " kind-type " " acc ")")) body (reverse (nth t 1))))
      (str "(lit " (pr-str (second t)) ")"))))

(defn iface-text
  "The elaborated module's interface: its things with their types and its instances (hsiface/things,
  hsiface/instances); the exports and fixities are the renamer's (its own interface of the module)"
  [r]
  (let [m (:module r) cl (:classes r)]
    (str "(hsiface/module " (pr-str m) " {:unit \"main\"})\n"
         "(hsiface/things ["
         (str/join "\n  "
                   (sort (concat
                          (for [[n t] (:types r) :when (contains? #{"var" "fld"} (nth n 1))
                                :when (not (and (= "var" (nth n 1)) (contains? (:types r) (ext-name "data" m (occ n)))))]
                            (str "(id " (name-str n) " \"\" " (type-form t) " {})"))
                          (for [[n t] (:types r) :when (= "data" (nth n 1))]
                            (let [info (get (:cons r) n)]
                              (str "(datacon " (name-str n) " \"\" " (:arity info) " [" (str/join " " (map (comp pr-str occ) (:fields info))) "] "
                                   (type-form t) " {})")))
                          (for [[n info] cl]
                            (str "(class " (name-str n) " [] ["
                                 (str/join " " (for [mn (:methods info)] (str "(" (name-str mn) " \"\" " (type-form (get (:types r) mn)) ")")))
                                 "] [" (str/join " " (for [[c ts] (:supers info)] (if (= :qc c) (type-form (first ts)) (str "(tycon-app " (name-str c) " [" (str/join " " (map type-form ts)) "])"))))
                                 "] {:tvs " (pr-str (:tvs info)) " :defaults ["
                                 (str/join " " (for [[mn d] (:defaults info)] (str "[" (name-str mn) " " (name-str d) "]"))) "]"
                                 ;; HF10-P33 (a): the default signatures, as the own interfaces carry them
                                 (when (seq (:dsigs info))
                                   (str " :dsigs [" (str/join " " (for [[mn t] (:dsigs info)] (str "[" (name-str mn) " " (type-form t) "]"))) "]"))
                                 "})"))
                          (for [[n [tvs rhs]] (:syns r) :when (= m (nmod n))]
                            (str "(tycon " (name-str n) " \"\" synonym [] " kind-type " {:synonym [" (pr-str tvs) " " (type-form rhs) "]})")))))
         "])\n"
         "(hsiface/instances ["
         (str/join "\n  " (for [{:keys [dfun tvs ctx head]} (:insts r)]
                            (str "(instance " (name-str dfun) " " (type-form [:forall tvs ctx [:tc (first head) (second head)]]) ")")))
         "])\n")))

;;; ------------------------------------------------------------------------------------------
;;; The judge: types alpha-equivalent; evidence

(defn- alpha-inner
  "An inner forall's binders renamed by their place (a rank-n argument's: GHC's names and ours differ)"
  [t]
  (let [n (volatile! 0)]
    (letfn [(go [t]
              (case (first t)
                :forall (let [m (into {} (map (fn [v] [v [:tv (str "q" (vswap! n inc))]]) (nth t 1)))]
                          [:forall (mapv (comp second m) (nth t 1))
                           (mapv (fn [[c ts]] [c (mapv #(go (subst m %)) ts)]) (nth t 2))
                           (go (subst m (nth t 3)))])
                :tc [:tc (second t) (mapv go (nth t 2))]
                :app (mk-app (go (nth t 1)) (go (nth t 2)))
                t))]
      (go t))))

(defn- canon-type
  "A closed type in a canonical form: synonyms expanded, the foralls dropped, variables renamed by first occurrence
  in the body, the constraints renamed alike and sorted, multiplicities ignored"
  [syns t]
  (binding [*syns* (atom syns) *metas* (atom {})]
    (let [[tvs ctx body] (loop [t t tvs [] ctx []]
                           (if (= :forall (first t)) (recur (nth t 3) (into tvs (nth t 1)) (into ctx (nth t 2))) [tvs ctx t]))
          ex (fn ex [t] (let [t (expand t)]
                          (case (first t)
                            :tc [:tc (second t) (mapv ex (nth t 2))]
                            :app (mk-app (ex (nth t 1)) (ex (nth t 2)))
                            t)))
          body (ex body)
          order (atom [])
          _ (letfn [(w [t] (case (first t)
                             :tv (when-not (some #{(second t)} @order) (swap! order conj (second t)))
                             :tc (doseq [a (nth t 2)] (w a))
                             :app (do (w (nth t 1)) (w (nth t 2)))
                             nil))]
              (w body)
              (doseq [[_ ts] ctx x ts] (w (ex x))))
          ren (into {} (map-indexed (fn [i v] [v [:tv (str "a" i)]]) @order))]
      [(vec (sort-by pr-str (map (fn [[c ts]] [c (mapv #(alpha-inner (subst ren (ex %))) ts)]) ctx))) (alpha-inner (subst ren body))])))

(defn- ghc-types
  "GHC's types of the module's things (tc verb; an interface's with key hsiface/things): {NAME type}, the synonyms
  {NAME [tvs rhs]}; with ka (the elaborator's invisible kind arities) GHC's kind arguments erased as ours"
  [forms & [k ka]]
  (let [by (into {} (map (fn [x] [(first x) x]) forms))
        things (second (get by (or k 'hstc/things)))]
    (binding [*genv* (atom {}) *classes* (atom {}) *cons* (atom {}) *syns* (atom {})
              *kind-arity* (when ka (atom (kind-arities things ka)))]
      (add-things! things)
      [@*genv* @*syns*])))

;; HF10-P3: an interface's facts as the elaborator reads them (load-ifaces!' readers over one interface's forms), for the
;; judge of the front end's own interfaces against GHC's (arbace.repr.haskell.ownface)
(defn iface-facts
  "One interface's facts as the elaborator reads them: {:genv :cons :classes :tycons :syns :families :patsyns :insts},
  its types read with the invisible kind arities ka (merged with those its own things give)"
  [forms ka]
  (let [by (into {} (map (fn [x] [(first x) x]) forms))
        things (second (get by 'hsiface/things))]
    (binding [*genv* (atom {}) *classes* (atom {}) *cons* (atom {}) *syns* (atom {}) *tycons* (atom {})
              *families* (atom {}) *patsyns* (atom {}) *insts* (atom [])
              *kind-arity* (atom (kind-arities things ka))]
      (add-things! things)
      (add-fam-instances! (second (get by 'hsiface/fam-instances)))
      (add-instances! (second (get by 'hsiface/instances)))
      ;; (HF10-P36: the matchers' and builders' types the reader derives from a synonym are no facts of their own)
      {:genv (into {} (remove (fn [[k _]] (and (vector? k) (= "var" (nth k 1)) (re-find #"^\$[mb]." (occ k))
                                               (contains? @*patsyns* (ext-name "data" (nmod k) (subs (occ k) 2)))))
                              @*genv*))
       :cons @*cons* :classes @*classes* :tycons @*tycons* :syns @*syns* :families @*families*
       :patsyns @*patsyns* :insts @*insts* :kind-arity @*kind-arity*})))

(declare canon-type)
(defn canon
  "A closed type in the judge's canonical form (canon-type: synonyms of syns expanded, variables by first occurrence)"
  [syns t]
  (canon-type syns t))

;; dictionary terms of erased Core: what the evidence projection keeps

(defn- dict-name? [s] (or (str/starts-with? s "$f") (str/starts-with? s "$d") (str/starts-with? s "$p")))

(defn- dict-term? [x]
  (and (seq? x)
       (case (first x)
         ;; a name as a vector, or as the judge's normalised text (ext ns "M" "occ")
         v (let [n (second x)]
             (dict-name? (if (string? n) (or (second (re-find #"\"([^\"]*)\"\)$" n)) "") (str (nth (vec n) 3 "")))))
         lv (str/starts-with? (str (second x)) "$d")
         app (and (dict-term? (second x)) (every? dict-term? (nth x 2)))
         false)))

(defn normalise
  "Erased Core in the judge's normal form: dictionary let-bindings inlined, local binders renamed by their place
  (occ#k, k counting the binders of that name in order), names as strings"
  [c]
  (let [counts (atom {})]
    (letfn [(nmx [n] (let [n (vec (map #(if (symbol? %) (name %) %) n))] (name-str n)))
            (bind-lv [env x] (let [o (str (second x)) k (get (swap! counts update o (fnil inc 0)) o)]
                               [(assoc env [o (str (nth x 2))] (str o "#" k)) (str o "#" k)]))
            (w [env x]
              (cond
                (and (seq? x) (= 'v (first x))) (list 'v (nmx (second x)))
                (and (seq? x) (= 'lv (first x))) (let [k [(str (second x)) (str (nth x 2))]]
                                                   (if-let [d (get (:dicts env) k)] d (list 'lv (get env k (str (second x) "?")))))
                (and (seq? x) (= 'let (first x)) (let [[_ [b] _] x] (and (seq? b) (= 'lv (first (second b))) (str/starts-with? (str (second (second b))) "$d")
                                                                        (dict-term? (nth b 2)))))
                (let [[_ [b] body] x]
                  (w (assoc-in env [:dicts [(str (second (second b))) (str (nth (second b) 2))]] (w env (nth b 2))) body))
                (and (seq? x) (= 'lam (first x)))
                (let [[env' bs] (reduce (fn [[e bs] b] (if (and (seq? b) (= 'lv (first b))) (let [[e2 nb] (bind-lv e b)] [e2 (conj bs (list 'lv nb))]) [e (conj bs b)])) [env []] (second x))]
                  (list 'lam bs (w env' (nth x 2))))
                (and (seq? x) (contains? '#{let letrec} (first x)))
                (let [bs (second x)
                      [env' nbs] (reduce (fn [[e out] b] (if (and (seq? (second b)) (= 'lv (first (second b)))) (let [[e2 nb] (bind-lv e (second b))] [e2 (conj out (list 'lv nb))]) [e (conj out (second b))])) [env []] bs)
                      env-rhs (if (= 'letrec (first x)) env' env)]
                  (list (first x) (mapv (fn [b nb] (list 'bind nb (w env-rhs (nth b 2)))) bs nbs) (w env' (nth x 2))))
                (and (seq? x) (= 'case (first x)))
                (let [[env' nb] (bind-lv env (nth x 2))]
                  (list 'case (w env (second x)) (list 'lv nb)
                        (mapv (fn [a] (let [[env2 bs] (reduce (fn [[e bs] b] (let [[e2 nb] (bind-lv e b)] [e2 (conj bs (list 'lv nb))])) [env' []] (nth a 2))]
                                        (list 'alt (if (sequential? (second a)) (if (= 'lit (first (second a))) (second a) (nmx (second a))) (second a)) bs (w env2 (nth a 3)))))
                              (nth x 3))))
                (seq? x) (apply list (map #(w env %) x))
                (vector? x) (mapv #(w env %) x)
                :else x))]
      (w {} c))))

(defn- occurrences [x c]
  (cond (= x c) 1
        (coll? c) (reduce + 0 (map #(occurrences x %) c))
        :else 0))

(defn- substitute [m c]
  (cond (and (seq? c) (contains? '#{lv v} (first c)) (contains? m c)) (get m c)
        (seq? c) (apply list (map #(substitute m %) c))
        (vector? c) (mapv #(substitute m %) c)
        :else c))

(defn- trivial? [a]
  (or (and (seq? a) (contains? '#{v lv lit} (first a))) (dict-term? a)))

(defn simple-opt
  "A little of GHC's simple optimiser (Core/SimpleOpt), applied to both sides before the judge: a non-recursive
  let whose binder occurs once is inlined, an application of a lambda to trivial arguments beta-reduced; a
  dictionary abstraction's letrec of one binder returning it is kept as GHC keeps it"
  [c]
  (cond
    (and (seq? c) (= 'let (first c)) (= 1 (count (second c))))
    (let [[_ [b] body] c x (second b) rhs (simple-opt (nth b 2)) body (simple-opt body)]
      (cond
        (and (seq? x) (= 'lv (first x)) (zero? (occurrences x body))) body
        (and (seq? x) (= 'lv (first x)) (= 1 (occurrences x body)) (zero? (occurrences x rhs)))
        (simple-opt (substitute {x rhs} body))
        :else
        (list 'let [(list 'bind x rhs)] body)))
    (and (seq? c) (= 'app (first c)))
    (let [f (simple-opt (second c)) as (mapv simple-opt (nth c 2))]
      (cond
        (and (seq? f) (= 'app (first f))) (simple-opt (list 'app (second f) (into (nth f 2) as)))
        (and (seq? f) (= 'lam (first f)) (trivial? (first as)))
        (let [ps (second f) k (min (count ps) (count (take-while trivial? as)))
              body (substitute (zipmap (take k ps) (take k as)) (nth f 2))
              body (if (> (count ps) k) (list 'lam (vec (drop k ps)) body) body)]
          (simple-opt (if (> (count as) k) (list 'app body (vec (drop k as))) body)))
        :else (list 'app f as)))
    (seq? c) (apply list (map simple-opt c))
    (vector? c) (mapv simple-opt c)
    :else c))


(defn evidence-of
  "The evidence of a normalised binding: the sorted applications of a name to dictionaries, [HEAD [DICT...]]"
  [c]
  (let [out (atom [])]
    (letfn [(w [x]
              (when (coll? x)
                (when (and (seq? x) (= 'app (first x)))
                  (let [ds (vec (take-while dict-term? (nth x 2)))]
                    (when (seq ds) (swap! out conj [(second x) ds]))))
                (doseq [y x] (w y))))]
      (w c))
    (vec (sort-by pr-str @out))))

(def typeable-prefixes ["$tc" "$krep" "$trModule" "$tr"])

(defn- core-binds-raw
  "Top-level bindings [[binder rhs]...], rec groups flattened"
  [binds]
  (vec (for [b (mapcat (fn [x] (if (= 'rec (first x)) (second x) [x])) binds)] [(second b) (nth b 2)])))

(defn- method-owners
  "The instance methods' binders ($cop, local) mapped to their dictionary function's occurrence: two instances'
  methods of the same name are told apart by it"
  [binds]
  (into {} (for [b binds
                 :let [n (second b) rhs (nth b 2)
                       rhs (if (and (seq? rhs) (= 'lam (first rhs))) (nth rhs 2) rhs)]
                 :when (and (not= 'lv (first n)) (str/starts-with? (nth (vec (map #(if (symbol? %) (name %) %) n)) 3) "$f")
                            (seq? rhs) (= 'app (first rhs)))
                 a (nth rhs 2)
                 :let [x (if (and (seq? a) (= 'app (first a))) (second a) a)]
                 :when (and (seq? x) (= 'lv (first x)))]
             [x (nth (vec (map #(if (symbol? %) (name %) %) n)) 3)])))

(defn- core-binds
  "Top-level bindings by key (the binder's name text, or the local occ, an instance method's with its dictionary
  function's): [[key core]...], rec groups flattened, the Typeable bindings dropped"
  [binds]
  (let [flat (mapcat (fn [x] (if (= 'rec (first x)) (second x) [x])) binds)
        owners (method-owners flat)]
  (vec (for [b flat
             :let [n (second b) o (if (= 'lv (first n))
                                    (str (second n) (when-let [d (get owners n)] (str "@" d)))
                                    (nth (vec (map #(if (symbol? %) (name %) %) n)) 3))]
             :when (not-any? #(str/starts-with? o %) typeable-prefixes)
             :when (not (and (= 'lv (first n)) (str/starts-with? o "$d")))]
         ;; GHC's :Main.main (runMainIO main) apart from the program's main
         [(cond (= 'lv (first n)) (str "local " o)
                (str/starts-with? (str (nth (vec (map #(if (symbol? %) (name %) %) n)) 2)) ":") (str ":" o)
                :else o)
          (nth b 2)]))))

(defn- occurrences-outside-lam
  "[count under-lambda?] of the occurrences of x in c"
  [x c]
  (let [n (atom 0) lam (atom false)]
    (letfn [(w [c in-lam]
              (cond (= x c) (do (swap! n inc) (when in-lam (reset! lam true)))
                    (and (seq? c) (= 'lam (first c))) (doseq [y (rest c)] (w y true))
                    (coll? c) (doseq [y c] (w y in-lam))
                    :else nil))]
      (w c false))
    [@n @lam]))

(defn inline-once
  "GHC's simpleOptPgm on our top-level bindings: a binding of the module not exported, not recursive, occurring
  once in all the others and not under a lambda, inlined there (the desugarer's output of a headerless Main has its
  helpers inlined so); repeated to the fixpoint"
  [binds exported m]
  (loop [bs (vec binds) i 0]
    (let [cand (first (for [[j b] (map-indexed vector bs)
                            :let [n (second b)]
                            :when (and (vector? n) (= m (nth n 2)) (= "var" (nth n 1)) (not (contains? exported n))
                                       (not (str/starts-with? (nth n 3) "$")))
                            :let [x (list 'v n)]
                            :when (zero? (occurrences x (nth b 2)))
                            :let [uses (keep-indexed (fn [k b2] (when (not= k j) (let [[c l] (occurrences-outside-lam x (nth b2 2))] (when (pos? c) [k c l])))) bs)]
                            :when (and (= 1 (count uses)) (= 1 (second (first uses))) (not (nth (first uses) 2)))]
                        [j (first (first uses))]))]
      (if (and cand (< i 500))
        (let [[j k] cand b (nth bs j) x (list 'v (second b))
              bs2 (assoc bs k (let [b2 (nth bs k)] (list 'bind (second b2) (substitute {x (nth b 2)} (nth b2 2)))))]
          (recur (vec (concat (subvec bs2 0 j) (subvec bs2 (inc j)))) (inc i)))
        bs))))

(defn compare-with-ghc
  "Our elaboration against the tc verb's dump: {:types {:equal n :diff [...]} :evidence {:equal n :diff [...]} :core-equal n}"
  [r ghc-file]
  (let [forms (read-forms (slurp ghc-file))
        [gtypes gsyns] (ghc-types forms nil (or (:kind-arity r) {}))
        syns (merge (:syns r) gsyns)
        ours (:types r)
        keys* (sort-by name-str (filter (fn [n] (and (= (:module r) (nmod n)) (not (str/starts-with? (occ n) "$"))
                                                     (contains? #{"var" "data" "fld"} (nth n 1))
                                                     (contains? ours n)))
                                         (keys gtypes)))
        tdiffs (vec (for [n keys* :let [g (canon-type syns (get gtypes n)) o (canon-type syns (get ours n))] :when (not= g o)]
                      {:name (name-str n) :ghc g :ours o}))
        missing (vec (sort (for [n (keys gtypes) :when (and (= (:module r) (nmod n)) (contains? #{"var" "data"} (nth n 1))
                                                           (not (str/starts-with? (occ n) "$")) (not (contains? ours n))
                                                           (not (re-matches #"C:.*" (occ n))))]
                             (name-str n))))
        gbinds (core-binds-raw (second (first (filter #(= 'hstc/core (first %)) forms))))
        ;; GHC floats a module's constant dictionaries to the top level (local $dNum = $fNumInt ...): inlined
        gdicts (into {} (for [[x rhs] gbinds :when (and (= 'lv (first x)) (str/starts-with? (str (second x)) "$d"))] [x rhs]))
        gcore (into {} (for [[k c] (core-binds (map (fn [[x rhs]] (list 'bind x rhs)) gbinds))]
                         [k (loop [c c i 0] (let [c2 (substitute gdicts c)] (if (or (= c2 c) (> i 5)) c (recur c2 (inc i)))))]))
        ocore (into {} (core-binds (inline-once (:core r) (:exported r) (:module r))))
        ;; a local ($c...) binding's key is its occurrence: instance methods of the same name in two instances collide,
        ;; compared as multisets of their evidence
        ckeys (sort (set/intersection (set (keys gcore)) (set (keys ocore))))
        gcore (into {} (map (fn [[k c]] [k (simple-opt c)]) gcore))
        ocore (into {} (map (fn [[k c]] [k (simple-opt c)]) ocore))
        ev (for [k ckeys :let [g (evidence-of (normalise (get gcore k))) o (evidence-of (normalise (get ocore k)))]]
             [k (= g o) g o])
        core-eq (count (filter (fn [k] (= (normalise (get gcore k)) (normalise (get ocore k)))) ckeys))]
    {:types {:compared (count keys*) :diff tdiffs :missing missing}
     :evidence {:compared (count ckeys) :diff (vec (keep (fn [[k ok g o]] (when-not ok {:binding k :ghc g :ours o})) ev))
                :ghc-only (vec (sort (remove (set (keys ocore)) (keys gcore))))}
     :core {:compared (count ckeys) :equal core-eq}
     :status (if (and (empty? tdiffs) (empty? missing) (every? second ev)) :ok :diff)}))

(defn compare-with-iface
  "Our types against GHC's interface of the module (the helper's iface verb: the types GHC recorded compiling the
  library; HF9's lib-check): the module's binders, constructors, selectors and methods both have, canonical forms
  compared as compare-with-ghc's; {:compared n :diff [...] :missing [NAME...]}, missing the binders GHC has and we lack"
  [r iface-file]
  (let [forms (read-forms (slurp iface-file))
        [gtypes gsyns] (ghc-types forms 'hsiface/things (or (:kind-arity r) {}))
        syns (merge (:syns r) gsyns)
        ours (:types r)
        own? (fn [n] (and (= (:module r) (nmod n)) (not (str/starts-with? (occ n) "$"))
                          (contains? #{"var" "data" "fld"} (nth n 1))))
        keys* (sort-by name-str (filter (fn [n] (and (own? n) (contains? ours n))) (keys gtypes)))
        tdiffs (vec (for [n keys* :let [g (canon-type syns (get gtypes n)) o (canon-type syns (get ours n))] :when (not= g o)]
                      {:name (name-str n) :ghc g :ours o}))
        missing (vec (sort (for [n (keys gtypes) :when (and (own? n) (not= "fld" (nth n 1)) (not (contains? ours n))
                                                           (not (re-matches #"C:.*" (occ n))))]
                             (name-str n))))]
    {:compared (count keys*) :diff tdiffs :missing missing}))

;;; ------------------------------------------------------------------------------------------
;;; Command line

(defn- parse-args [args]
  (loop [as args opts {} pos []]
    (if (empty? as)
      [opts pos]
      (let [[x & more] as]
        (if (and (str/starts-with? x "-") (seq more))
          (recur (rest more) (assoc opts x (first more)) pos)
          (recur more opts (conj pos x)))))))

(defn- base-name [^String f] (.getName (File. f)))

(defn -main
  "check --ifaces DIR[,DIR] --ghc DIR [-o DIR] TREE.rn-tree.edn...: each renamed tree elaborated and judged against
  the tc verb's DIR/NAME.tc.edn"
  [& args]
  (let [[verb & more] args
        [opts pos] (parse-args more)]
    (binding [*ifdirs* (vec (concat (remove empty? (str/split (or (get opts "--ifaces") "") #","))
                                    (when (get opts "--local") [(get opts "--local")])))
              *control* (= "true" (get opts "--control"))]
      (case verb
        "check"
        (let [res (vec (for [f pos]
                         (let [tree (read-string (slurp f))
                               nm* (let [b (base-name f)] (subs b 0 (- (count b) (count ".rn-tree.edn"))))
                               r (typecheck-module tree)
                               _ (when-let [l (get opts "--local")]
                                   (.mkdirs (File. ^String l))
                                   (spit (str l "/" (:module r) ".iface.edn") (iface-text r)))
                               _ (when-let [o (get opts "-o")]
                                   (.mkdirs (File. ^String o))
                                   (spit (str o "/" nm* ".core.edn")
                                         (binding [*print-length* nil *print-level* nil]
                                           (str/join "\n" (map pr-str (:core r))))))
                               c (compare-with-ghc r (str (get opts "--ghc") "/" nm* ".tc.edn"))]
                           (println (name (:status c)) nm*
                                    (str "types " (- (:compared (:types c)) (count (:diff (:types c)))) "/" (:compared (:types c)))
                                    (str "evidence " (- (:compared (:evidence c)) (count (:diff (:evidence c)))) "/" (:compared (:evidence c)))
                                    (str "core " (:equal (:core c)) "/" (:compared (:core c)))
                                    (if (seq (:errors r)) (str "errors " (count (:errors r))) ""))
                           (doseq [d (take 10 (:diff (:types c)))] (println "    type" (:name d) "\n      ghc: " (pr-str (:ghc d)) "\n      ours:" (pr-str (:ours d))))
                           (doseq [d (take 10 (:diff (:evidence c)))] (println "    evidence" (:binding d) "\n      ghc: " (pr-str (:ghc d)) "\n      ours:" (pr-str (:ours d))))
                           (when (seq (:missing (:types c))) (println "    binders GHC only:" (pr-str (:missing (:types c)))))
                           (when (seq (:ghc-only (:evidence c))) (println "    bindings GHC only:" (pr-str (:ghc-only (:evidence c)))))
                           (doseq [e (take 5 (:errors r))] (println "    error:" e))
                           c)))
              ok (count (filter #(= :ok (:status %)) res))]
          (println (str "typecheck-check: " ok " of " (count res) " modules equal"))
          (System/exit (if (= ok (count res)) 0 1)))
        (do (println "usage: -m arbace.repr.haskell.typecheck check --ifaces DIR --ghc DIR [-o DIR] TREE.rn-tree.edn...")
            (System/exit 2))))))

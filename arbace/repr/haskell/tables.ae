;; Generated by arbace.repr.haskell.happy (-m arbace.repr.haskell.happy gen --parser-y FILE --out
;; arbace/repr/haskell/tables.ae) from GHC 9.14.1's compiler/GHC/Parser.y.source, the one of the
;; pinned ghc-9.14.1-src.tar.xz (test/haskell/corpus-ghc-9.14.1.edn), whose SHA-256 is
;; cfe199f2b961c39e0bd4b0a56af06bd8160ee5455b40a84c6ec9572d5b6f05a3.
;; Do not edit: generate it again; happy's check compares it with a fresh generation.

(ns arbace.repr.haskell.tables
  "The LALR(1) tables of GHC 9.14.1's grammar as Happy makes them, for repr/haskell's native
  parser: generated by arbace.repr.haskell.happy, which proves them equal, state for state, to
  the ones of GHC's own Parser.hs. (tables) decodes them once."
  (:import (java.util Arrays)))

(set! *warn-on-reflection* true)

(def ^:private n-states 1537)
(def ^:private n-terms 162)
(def ^:private n-nonterms 337)
(def ^:private action-offset 1000)


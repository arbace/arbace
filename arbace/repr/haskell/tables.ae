  "The %name and %partial parsers, [name start-symbol partial]: start state i the i-th"
  [["parseModuleNoHaddock" "module" false]
   ["parseSignatureNoHaddock" "signature" false]
   ["parseImport" "importdecl" false]
   ["parseStatement" "e_stmt" false]
   ["parseDeclaration" "topdecl" false]

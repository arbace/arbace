   ["parseTypeSignature" "sigdecl" false]
   ["parseStmt" "maybe_stmt" false]
   ["parseIdentifier" "identifier" false]
   ["parseType" "ktype" false]
   ["parseBackpack" "backpack" false]
   ["parseHeader" "header" true]])


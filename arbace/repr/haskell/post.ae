(ns arbace.repr.haskell.post
  "The parser's post-processing of expressions, patterns and commands, a port of
  GHC.Parser.PostProcess's DisambECP part (doc/haskell/NATIVE.md).

  GHC parses an expression, a pattern and an arrow command with one grammar: a production's value
  is an ECP, `forall b. DisambECP b => PV (LocatedA b)`, built once the context says which. Here an
  ECP is a fn of the mode, :expr (HsExpr), :pat (a PatBuilder) or :cmd (HsCmd), returning the
  located node; the DisambECP methods are fns of the mode (their Haskell instances a case each).
  A PV computation is run where GHC runs it (PV is pure state threading over the parser's
  messages, which are not kept: a fatal error throws, ex-info with :error and :span).

  The API the grammar's actions use: (run-expr ecp) is runPV (unECP ecp) as an expression, (run-pat
  ecp) as a PatBuilder, (run-cmd ecp) as a command; (check-pattern lpb) is checkPattern, a
  PatBuilder to an LPat; (ecp-from-exp e), (ecp-from-cmd c), (ecp-from-pat p) the ECPs of a
  known node."
  (:require [arbace.repr.haskell.ast :as a :refer [L unLoc getLoc gl comb2 combine nx con just maybe]]
            [arbace.repr.haskell.lex :as lx]
            [arbace.string :as str]))

(defn fatal!
  "addFatalError: the parse fails with the message m (arbace.repr.haskell.errors), or with a
  message not yet ported, msg at span"
  ([m] (lx/fatal! m))
  ([msg span] (lx/fatal! (lx/msg :Unported span msg))))

(declare ^:dynamic *ps*)

(defn add-error!
  "addError: the message m recorded, the parse going on"
  [m]
  (lx/add-error! *ps* m))

(defn run-expr "runPV (unECP ecp) at type HsExpr" [ecp] (ecp :expr))
(defn run-pat "runPV (unECP ecp) at type PatBuilder" [ecp] (ecp :pat))
(defn run-cmd "runPV (unECP ecp) at type HsCmd" [ecp] (ecp :cmd))

(defn run-mode "An ECP run at a mode" [ecp mode] (ecp mode))

(defn infix-op-mode
  "InfixOp b's mode: an expression's or a command's operator is an HsExpr (:expr), a pattern's a
  RdrName (:name)"
  [mode]
  (if (identical? mode :pat) :name :expr))

(defn fun-arg-mode
  "FunArg b's mode: a command's arguments are expressions"
  [mode]
  (if (identical? mode :cmd) :expr mode))

(defn- ph [f & args] (apply (requiring-resolve (symbol "arbace.repr.haskell.pprhs" (name f))) args))
(defn- dc [f & args] (apply (requiring-resolve (symbol "arbace.repr.haskell.doc" (name f))) args))

(defn- cmd-fail
  "cmdFail: PsErrParseErrorInCmd at span, doc a fn giving the command's document"
  [doc span]
  (fatal! (lx/msg :PsErrParseErrorInCmd span (doc))))

(defn- pat-fail "patFail: the message m" [m] (fatal! m))

(def ^:dynamic *parse-context*
  "The PV's ParseContext (runPV_details): [operator incomplete-do], the operator of an infix
  function binding (or nil), whether a do block may be missing (bindpat's incompleteDoBlock)"
  [nil false])

(defn- pat-details "fromParseContext: PEIP_OtherPatDetails of the parse context" []
  [:Other (first *parse-context*) (second *parse-context*)])



(defn- block-arguments-bit? [] (lx/get-bit *ps* :BlockArgumentsBit))

(defn check-exp-block-arguments
  "checkExpBlockArguments: an error (not fatal) for a do, case, lambda, let, if or proc applied
  to without BlockArguments"
  [e]
  (let [n (unLoc e)
        err (case (first n)
              HsDo (case (let [f (nth n 2)] (when (seq? f) (first f)))
                     DoExpr (lx/msg :PsErrDoInFunAppExpr (getLoc e) (a/from-just (second (nth n 2))) e)
                     MDoExpr (lx/msg :PsErrMDoInFunAppExpr (getLoc e) (a/from-just (second (nth n 2))) e)
                     nil)
              HsCase (lx/msg :PsErrCaseInFunAppExpr (getLoc e) e)
              HsLam (lx/msg :PsErrLambdaInFunAppExpr (getLoc e) (nth n 2) e)
              HsLet (lx/msg :PsErrLetInFunAppExpr (getLoc e) e)
              HsIf (lx/msg :PsErrIfInFunAppExpr (getLoc e) e)
              HsProc (lx/msg :PsErrProcInFunAppExpr (getLoc e) e)
              nil)]
    (when (and err (not (block-arguments-bit?))) (add-error! err))))

(defn check-cmd-block-arguments "checkCmdBlockArguments" [c]
  (let [n (unLoc c)
        err (case (first n)
              HsCmdLam (lx/msg :PsErrLambdaCmdInFunAppCmd (getLoc c) (nth n 2) c)
              HsCmdCase (lx/msg :PsErrCaseCmdInFunAppCmd (getLoc c) c)
              HsCmdIf (lx/msg :PsErrIfCmdInFunAppCmd (getLoc c) c)
              HsCmdLet (lx/msg :PsErrLetCmdInFunAppCmd (getLoc c) c)
              HsCmdDo (lx/msg :PsErrDoCmdInFunAppCmd (getLoc c) c)
              nil)]
    (when (and err (not (block-arguments-bit?))) (add-error! err))))

(defn- unless-bit
  "The error m (not fatal) unless the extension bit is on"
  [bit m]
  (when-not (lx/get-bit *ps* bit) (add-error! m)))

(defn check-do-and-if-then-else
  "checkDoAndIfThenElse: semicolons before then or else without DoAndIfThenElse (an error, not
  fatal, over the condition to the else branch)"
  [mode c semi-then t semi-else e]
  (when (or semi-then semi-else)
    (unless-bit :DoAndIfThenElseBit
                (lx/msg (if (= mode :cmd) :PsErrSemiColonsInCondCmd :PsErrSemiColonsInCondExpr)
                        (combine (getLoc c) (getLoc e)) (unLoc c) semi-then (unLoc t) semi-else (unLoc e)))))

(defn hint-explicit-forall "hintExplicitForall" [tok]
  (when-not (or (lx/get-bit *ps* :ExplicitForallBit) (lx/get-bit *ps* :InRulePragBit))
    (add-error! (lx/msg :PsErrExplicitForall (gl tok) (= :unicode (nth tok 1))))))
(defn hint-multi-way-if "hintMultiWayIf" [tok] (unless-bit :MultiWayIfBit (lx/msg :PsErrMultiWayIf (gl tok))))
(defn hint-linear "hintLinear" [span] (unless-bit :LinearTypesBit (lx/msg :PsErrLinearFunction span)))
(defn hint-or-pats "hintOrPats" [pat] (unless-bit :OrPatternsBit (lx/msg :PsErrIllegalOrPat (getLoc pat) pat)) pat)
(defn hint-qualified-do "hintQualifiedDo: a qualified do's token" [tok kw]
  (when-let [m (nth tok 1)]
    (unless-bit :QualifiedDoBit
                (lx/msg :PsErrIllegalQualifiedDo (gl tok)
                        ((requiring-resolve 'arbace.repr.haskell.doc/text) (str (if (string? m) m (a/mod-name m)) "." kw))))))
(defn require-lt-puns
  "requireLTPuns: without ListTuplePuns, the construct from the token or node s to e is an error"
  [kind s e]
  (when-not (lx/get-bit *ps* :ListTuplePunsBit)
    (add-error! (lx/msg :PsErrInvalidPun (a/comb2 s e) kind))))

(defn warn-star-is-type "warnStarIsType" [tok] (lx/add-warning! *ps* (lx/msg :PsWarnStarIsType (gl tok))))

(def parse-error "parseError: the placeholder of an expression in error" (con HsHole 'HoleError))

;;; ------------------------------------------------------------------------------------------
;;; DisambInfixOp: the operators of qop and qopm, fns of the operator's mode (:expr or :name)

(defn mk-hs-var-op-pv [v]
  (fn [omode] (if (identical? omode :name) v (L (getLoc v) (con HsVar nx v)))))
(defn mk-hs-con-op-pv [v]
  (fn [omode] (if (identical? omode :name) v (L (getLoc v) (con HsVar nx v)))))
(defn mk-hs-infix-hole-pv [v]
  (fn [omode]
    (if (identical? omode :name)
      (fatal! (lx/msg :PsErrInvalidInfixHole (getLoc v)))
      (L (getLoc v) (con HsHole (con HoleVar v))))))

;;; ------------------------------------------------------------------------------------------
;;; The ECPs of known nodes

(defn ecp-from-exp "ecpFromExp" [e]
  (fn [mode]
    (case mode
      :expr e
      :pat (fatal! (lx/msg :PsErrArrowExprInPat (getLoc e) (unLoc e)))
      :cmd (cmd-fail #(ph :ppr-expr (unLoc e)) (getLoc e)))))

(defn ecp-from-cmd "ecpFromCmd" [c]
  (fn [mode]
    (case mode
      :cmd c
      :expr (do (add-error! (lx/msg :PsErrArrowCmdInExpr (getLoc c) (unLoc c))) (L (getLoc c) parse-error))
      :pat (fatal! (lx/msg :PsErrArrowCmdInPat (getLoc c) (unLoc c))))))

(defn ecp-from-pat "ecpFromPat" [p]
  (fn [mode]
    (case mode
      :pat (L (getLoc p) (con PatBuilderPat (unLoc p)))
      :expr (do (add-error! (lx/msg :PsErrOrPatInExpr (getLoc p) p)) (L (getLoc p) parse-error))
      :cmd (cmd-fail #(ph :ppr-pat (unLoc p)) (getLoc p)))))

;;; ------------------------------------------------------------------------------------------
;;; Patterns: PatBuilder to Pat (checkLPat, checkPat, checkAPat)

(defn- rdr-data-con?
  "isRdrDataCon: a name in the data constructor namespace"
  [r] (= 'data (a/rdr-ns r)))
(defn- rdr-tc?
  "isRdrTc: a name in the type constructor namespace"
  [r] (= 'tc (a/rdr-ns r)))

(defn mk-npat "mkNPat lit neg" [llit neg] (con NPat nil llit neg nx))

(defn- mk-hs-ty-pat [t] ((requiring-resolve 'arbace.repr.haskell.post-decl/mk-hs-ty-pat) t))
(defn hs-type-to-hs-sig-wc-type [t] ((requiring-resolve 'arbace.repr.haskell.post-decl/hs-type-to-hs-sig-wc-type) t))
(defn mk-hs-wild-card-bndrs [t] (con HsWC nx t))

(declare check-lpat)

(defn- mk-invis-lpat
  "mkInvisLPat: @ty as an InvisPat, located over the @ and the type"
  [at ty-pat]
  ;; HsTP _ (L anc _): the type's location widened by the @ token's
  (let [t (nth ty-pat 2)]
    (L (combine (gl at) (getLoc t)) (con InvisPat (a/tuple nil 'SpecifiedSpec) ty-pat))))

(defn- check-apat
  "checkAPat: the pattern of a PatBuilder node (no arguments left)"
  [ps loc e0]
  (case (first e0)
    PatBuilderPat (second e0)
    PatBuilderVar (con VarPat nx (second e0))
    PatBuilderOverLit (mk-npat (L loc (second e0)) 'Nothing)
    PatBuilderOpApp
    (let [[_ l op r] e0
          ul (unLoc l) ur (unLoc r) opn (unLoc op)]
      (cond
        ;; n+k patterns
        (and (= 'PatBuilderVar (first ul))
             (= 'PatBuilderOverLit (first ur))
             (let [ol (second ur)] (and (seq? ol) (= 'OverLit (first ol)) (= 'HsIntegral (first (nth ol 2)))))
             (lx/get-bit ps :NPlusKPatternsBit)
             (= opn (a/unqual 'var "+")))
        (let [lit (second ur)]
          (con NPlusKPat nil (second ul) (L (getLoc r) lit) lit nx nx))
        (= opn (a/unqual 'var "@"))
        (do (add-error! (lx/msg :PsErrAtInPatPos (getLoc op))) (con WildPat nx))
        (or (rdr-data-con? opn) (rdr-tc? opn))
        (con ConPat (a/tuple 'Nothing 'Nothing) op (con InfixCon (check-lpat ps l) (check-lpat ps r)))
        :else (pat-fail (lx/msg :PsErrInPat loc e0 (pat-details)))))
    PatBuilderPar (con ParPat (a/tuple nil nil) (check-lpat ps (nth e0 2)))
    (pat-fail (lx/msg :PsErrInPat loc e0 (pat-details)))))

(defn- check-pat
  "checkPat: the pattern of (L l e) applied to args, at the outer location loc"
  [ps loc lpb args]
  (let [e (unLoc lpb)]
    (case (first e)
      PatBuilderVar
      (let [ln (second e) c (unLoc ln)]
        (cond
          (or (rdr-data-con? c) (rdr-tc? c))
          (L loc (con ConPat (a/tuple 'Nothing 'Nothing) ln (con PrefixCon (vec args))))
          (and (seq args) (= c (a/unqual 'var "rec")))
          (pat-fail (lx/msg :PsErrInPat (getLoc lpb) e [:RecPattern (count args) (second *parse-context*)]))
          (empty? args) (L (getLoc lpb) (check-apat ps (getLoc lpb) e))
          :else (pat-fail (lx/msg :PsErrInPat loc e (pat-details)))))
      PatBuilderAppType
      (let [[_ f at t] e] (check-pat ps loc f (cons (mk-invis-lpat at t) args)))
      PatBuilderApp
      (let [[_ f x] e] (check-pat ps loc f (cons (check-lpat ps x) args)))
      (if (empty? args)
        (L (getLoc lpb) (check-apat ps (getLoc lpb) e))
        (pat-fail (lx/msg :PsErrInPat loc e (pat-details)))))))

(defn check-lpat
  "checkLPat: a PatBuilder (L l pb) to an LPat"
  [ps lpb]
  (check-pat ps (getLoc lpb) lpb ()))

(def ^:dynamic *ps* "The lexer state of the parse (for checkPattern's extension bits)" nil)

(defn check-pattern
  "checkPattern: a PatBuilder (L l pb) to an LPat"
  ([lpb] (check-lpat *ps* lpb))
  ([ps lpb] (check-lpat ps lpb)))

(defn- check-pat-field "checkPatField" [ps lf]
  (let [[_ l fld] lf]
    ;; (HsFieldBind ann lhs rhs pun)
    (L l (list 'HsFieldBind (nth fld 1) (nth fld 2) (check-lpat ps (nth fld 3)) (nth fld 4)))))

(def pun-rdr (a/unqual 'var "pun-right-hand-side"))

;;; ------------------------------------------------------------------------------------------
;;; Records

(defn mk-rec-fields
  "mk_rec_fields: HsRecFields of the field binds, the dot-dot's span"
  [fs dd]
  (con HsRecFields nx (vec fs)
       (if dd (just (L dd (con RecFieldsDotDot (count fs)))) 'Nothing)))

(defn- mk-rec-upd-field "mk_rec_upd_field" [lf]
  (let [[_ l fld] lf
        [_ ann lhs rhs pun] fld
        [_ ll focc] lhs]
    (L l (list 'HsFieldBind ann (L ll (con FieldOcc nx (nth focc 2))) rhs pun))))

(defn mk-rdr-proj-update
  "mkRdrProjUpdate: a field projection update"
  [loc lflds arg pun anns]
  (L loc (list 'HsFieldBind anns (L (getLoc lflds) (con FieldLabelStrings (vec (unLoc lflds)))) arg pun)))

(defn- mk-rec-constr-or-update
  "mkRecConstrOrUpdate"
  [overloaded exp lrec [fbinds dd]]
  (let [fs (keep #(when (= :left (first %)) (second %)) fbinds)
        projs (keep #(when (= :right (first %)) (second %)) fbinds)
        e (unLoc exp)]
    (if (and (= 'HsVar (first e)) (rdr-data-con? (unLoc (nth e 2))))
      (if (seq projs)
        (fatal! (lx/msg :PsErrOverloadedRecordDotInvalid (getLoc (first projs))))
        (con RecordCon (a/tuple (just nil) (just nil)) (nth e 2) (mk-rec-fields fs dd)))
      (cond
        dd (fatal! (lx/msg :PsErrDotsInRecordUpdate dd))
        (and (not overloaded) (seq projs)) (fatal! (lx/msg :PsErrOverloadedRecordUpdateNotEnabled (getLoc (first projs))))
        (not overloaded)
        (con RecordUpd (a/tuple (just nil) (just nil)) exp (con RegularRecUpdFields nx (mapv mk-rec-upd-field fs)))
        :else
        (do
          ;; the fields are not qualified (a fatal error at the first that is)
          (doseq [[k v] fbinds]
            (when (= k :left)
              (let [lhs (nth (nth v 2) 2)
                    [_ _ focc] lhs
                    [_ _ rdr] (nth focc 2)]
                (when (a/rdr-qual? rdr)
                  (fatal! (lx/msg :PsErrOverloadedRecordUpdateNoQualifiedFields (getLoc lhs)))))))
          (con RecordUpd (a/tuple (just nil) (just nil)) exp
             (con OverloadedRecUpdFields nx
                  (mapv (fn [[k v]]
                          (if (= k :right)
                            v
                            ;; recFieldToProjUpdate
                            (let [[_ l fld] v
                                  [_ anns lhs arg pun] fld
                                  [_ _ focc] lhs
                                  [_ loc rdr] (nth focc 2)
                                  f (a/rdr-occ rdr)
                                  fl (con DotFieldOcc nil (L loc (con FieldLabelString f)))
                                  arg' (if pun (L nil (con HsVar nx (L nil (a/unqual 'var f)))) arg)]
                              (mk-rdr-proj-update l (L loc [(L loc fl)]) arg' pun anns))))
                        fbinds))))))))

(defn- mk-pat-rec "mkPatRec" [ps p fields]
  (let [pb (unLoc p)]
    (if (and (= 'PatBuilderVar (first pb)) (rdr-data-con? (unLoc (second pb))))
      (let [[_ x fs dd] fields]
        (con PatBuilderPat (con ConPat (a/tuple (just nil) (just nil)) (second pb)
                                (con RecCon (con HsRecFields x (mapv #(check-pat-field ps %) fs) dd)))))
      (fatal! (lx/msg :PsErrInvalidRecordCon (getLoc p) pb)))))

;;; ------------------------------------------------------------------------------------------
;;; Match groups and right-hand sides

(defn mk-match-group "mkMatchGroup FromSource" [lms] (con MG 'FromSource lms))

(defn mk-lam-case-match-group
  "mkLamCaseMatchGroup: each match's context LamAlt variant"
  [variant lms]
  (let [[_ l ms] lms]
    (mk-match-group
     (L l (mapv (fn [[_ ml m]] (L ml (list 'Match (nth m 1) (con LamAlt variant) (nth m 3) (nth m 4)))) ms)))))

(defn unguarded-rhs "unguardedRHS: one GRHS without guards at loc" [loc rhs]
  [(L loc (con GRHS nil [] rhs))])

(defn unguarded-grhss "unguardedGRHSs" [loc rhs]
  (con GRHSs nil (unguarded-rhs loc rhs) (con EmptyLocalBinds nx)))

(defn list-location
  "listLocation: the span over the located items' spans"
  [xs]
  (reduce (fn [acc x] (combine acc (getLoc x))) nil xs))

(defn adapt-where-binds
  "adaptWhereBinds: the where bindings (Nothing, or (Just (L l [binds comments]))) as (L l binds)"
  [w]
  (if (a/just? w)
    (let [[_ l [b]] (second w)] (L l b))
    (L nil (con EmptyLocalBinds nx))))

;;; ------------------------------------------------------------------------------------------
;;; Tuples and sums (SumOrTuple: [:tuple [[:missing] [:present e]...]] or [:sum alt arity e])

(defn- mk-sum-or-tuple-expr [l boxity sot]
  (case (first sot)
    :tuple (L l (con ExplicitTuple (a/tuple nil nil)
                     (mapv (fn [[k e]] (if (= k :missing) (con Missing nil) (con Present nx e))) (second sot))
                     boxity))
    :sum (if (= boxity 'Unboxed)
           (let [[_ alt arity e] sot] (L l (con ExplicitSum nil alt arity e)))
           (fatal! (lx/msg :PsErrUnsupportedBoxedSumExpr l [boxity sot])))))

(defn- mk-sum-or-tuple-pat [ps l boxity sot]
  (case (first sot)
    :tuple (L l (con PatBuilderPat
                     (con TuplePat (a/tuple nil nil)
                          (mapv (fn [[k p]] (if (= k :missing) (fatal! (lx/msg :PsErrTupleSectionInPat l)) (check-lpat ps p)))
                                (second sot))
                          boxity)))
    :sum (if (= boxity 'Unboxed)
           (let [[_ alt arity p] sot] (L l (con PatBuilderPat (con SumPat nil (check-lpat ps p) alt arity))))
           (fatal! (lx/msg :PsErrUnsupportedBoxedSumPat l [boxity sot])))))

;;; ------------------------------------------------------------------------------------------
;;; DisambECP's methods, by mode

(defn mk-hs-var-pv "mkHsVarPV" [mode v]
  (case mode
    :expr (L (getLoc v) (con HsVar nx v))
    :pat (L (getLoc v) (con PatBuilderVar v))
    :cmd (cmd-fail #(ph :ppr-name (unLoc v)) (getLoc v))))

(defn- check-unboxed-lit-pat
  "checkUnboxedLitPat: a pattern is not a primitive string, Float# or Double# literal"
  [llit]
  (let [lit (unLoc llit)]
    (case (first lit)
      HsStringPrim (add-error! (lx/msg :PsErrIllegalUnboxedStringInPat (getLoc llit) lit))
      (HsFloatPrim HsDoublePrim) (add-error! (lx/msg :PsErrIllegalUnboxedFloatingLitInPat (getLoc llit) lit))
      nil)))

(defn mk-hs-lit-pv "mkHsLitPV" [mode llit]
  (case mode
    :expr (L (getLoc llit) (con HsLit nx (unLoc llit)))
    :pat (do (check-unboxed-lit-pat llit)
             (L (getLoc llit) (con PatBuilderPat (con LitPat nx (unLoc llit)))))
    :cmd (cmd-fail #(ph :ppr-lit (unLoc llit)) (getLoc llit))))

(defn mk-hs-over-lit-pv "mkHsOverLitPV" [mode llit]
  (case mode
    :expr (L (getLoc llit) (con HsOverLit nx (unLoc llit)))
    :pat (L (getLoc llit) (con PatBuilderOverLit (unLoc llit)))
    :cmd (cmd-fail #(ph :ppr-lit (unLoc llit)) (getLoc llit))))

(defn mk-hs-wild-card-pv "mkHsWildCardPV" [mode l]
  (case mode
    :expr (L l (con HsHole (con HoleVar (L l (a/unqual 'var "_")))))
    :pat (L l (con PatBuilderPat (con WildPat nx)))
    :cmd (cmd-fail #(dc :text "_") l)))

(defn- add-sig-pat-p
  "addSigPatP: a pattern signature, pushed under a view pattern (the legacy parse)"
  [l p sig]
  (if (= 'ViewPat (first (unLoc p)))
    (let [sig-loc (getLoc (nth sig 2))
          go (fn go [p]
               (if (= 'ViewPat (first (unLoc p)))
                 (let [[_ vl vp] p
                       [_ ann e p'] vp]
                   (L (combine vl sig-loc) (con ViewPat ann e (go p'))))
                 (L (combine (getLoc p) sig-loc) (con SigPat nil p sig))))]
      (go p))
    (L l (con SigPat nil p sig))))

(defn reject-pragma-pv
  "rejectPragmaPV (expressions): a pragma at the left of an infix expression or before a type
  signature, or of an operator section, is not allowed"
  [e]
  (let [n (unLoc e)]
    (case (first n)
      OpApp (reject-pragma-pv (nth n 4))
      HsPragE (add-error! (lx/msg :PsErrUnallowedPragma (getLoc e) (nth n 2)))
      nil)))

(defn mk-hs-ty-sig-pv "mkHsTySigPV" [ps mode l a sig]
  (case mode
    :expr (do (reject-pragma-pv a) (L l (con ExprWithTySig nil a (hs-type-to-hs-sig-wc-type sig))))
    :pat (let [p (check-lpat ps a)
               sig (con HsPS nil sig)
               sp (add-sig-pat-p l p sig)]
           (L (getLoc sp) (con PatBuilderPat (unLoc sp))))
    :cmd (cmd-fail #(dc :<+> (ph :ppr-cmd a) (dc :text "::") (ph :ppr-ltype sig)) l)))

(defn mk-hs-explicit-list-pv "mkHsExplicitListPV" [ps mode l xs]
  (case mode
    :expr (L l (con ExplicitList nil (vec xs)))
    :pat (L l (con PatBuilderPat (con ListPat nil (mapv #(check-lpat ps %) xs))))
    :cmd (cmd-fail #(dc :brackets (dc :ppr-with-commas (fn [x] (ph :ppr-cmd x)) xs)) l)))

(defn mk-hs-splice-pv "mkHsSplicePV" [mode lsp]
  (let [[_ l sp] lsp]
    (case mode
      :expr (L l (con HsUntypedSplice nx sp))
      :pat (L l (con PatBuilderPat (con SplicePat nx sp)))
      :cmd (cmd-fail #(dc :text "<splice>") l))))

(defn mk-hs-record-pv "mkHsRecordPV" [ps mode overloaded l lrec a [fbinds dd]]
  (case mode
    :expr (L l (mk-rec-constr-or-update overloaded a lrec [fbinds dd]))
    :pat (if (some #(= :right (first %)) fbinds)
           (fatal! (lx/msg :PsErrOverloadedRecordDotInvalid l))
           (L l (mk-pat-rec ps a (mk-rec-fields (map second fbinds) dd))))
    :cmd (if (some #(= :right (first %)) fbinds)
           (fatal! (lx/msg :PsErrOverloadedRecordDotInvalid l))
           (cmd-fail #(dc :text "<record>") l))))

(defn mk-hs-neg-app-pv "mkHsNegAppPV" [mode l a]
  (case mode
    :expr (L l (con NegApp nil a nx))
    :pat (let [[_ lp p] a]
           (if (= 'PatBuilderOverLit (first p))
             (L l (con PatBuilderPat (mk-npat (L lp (second p)) (just nx))))
             (pat-fail (lx/msg :PsErrInPat l p [:NegApp]))))
    :cmd (cmd-fail #(dc :<> (dc :text "-") (ph :ppr-cmd a)) l)))

(defn mk-hs-section-r-pv "mkHsSectionR_PV" [mode l op e]
  (case mode
    :expr (L l (con SectionR nx op e))
    :pat (pat-fail (lx/msg :PsErrParseRightOpSectionInPat l (unLoc op) (unLoc e)))
    :cmd (cmd-fail #(dc :<> (ph :ppr-infix-occ (unLoc (nth (unLoc op) 2))) (ph :ppr-cmd e)) l)))

(defn mk-hs-as-pat-pv "mkHsAsPatPV" [ps mode l v e]
  (case mode
    :pat (L l (con PatBuilderPat (con AsPat nil v (check-lpat ps e))))
    :expr (do (add-error! (lx/msg :PsErrTypeAppWithoutSpace l (unLoc v) e)) (L l parse-error))
    :cmd (cmd-fail #(dc :<> (ph :ppr-prefix-occ (unLoc v)) (dc :text "@") (ph :ppr-cmd e)) l)))

(defn mk-hs-lazy-pat-pv "mkHsLazyPatPV" [ps mode l e]
  (case mode
    :pat (L l (con PatBuilderPat (con LazyPat nil (check-lpat ps e))))
    :expr (do (add-error! (lx/msg :PsErrLazyPatWithoutSpace l e)) (L l parse-error))
    :cmd (cmd-fail #(dc :<> (dc :text "~") (ph :ppr-cmd e)) l)))

(defn mk-hs-bang-pat-pv "mkHsBangPatPV" [ps mode l e]
  (case mode
    :pat (let [pb (con BangPat nil (check-lpat ps e))]
           ;; hintBangPat
           (unless-bit :BangPatBit (lx/msg :PsErrIllegalBangPattern l pb))
           (L l (con PatBuilderPat pb)))
    :expr (do (add-error! (lx/msg :PsErrBangPatWithoutSpace l e)) (L l parse-error))
    :cmd (cmd-fail #(dc :<> (dc :text "!") (ph :ppr-cmd e)) l)))

(defn mk-sum-or-tuple-pv "mkSumOrTuplePV" [ps mode l boxity sot]
  (case mode
    :expr (mk-sum-or-tuple-expr l boxity sot)
    :pat (mk-sum-or-tuple-pat ps l boxity sot)
    :cmd (cmd-fail #(ph :ppr-sum-or-tuple [boxity sot]) l)))

(defn mk-hs-emb-ty-pv "mkHsEmbTyPV" [mode l ty]
  (case mode
    :expr (L l (con HsEmbTy nil (mk-hs-wild-card-bndrs ty)))
    :pat (L l (con PatBuilderPat (con EmbTyPat nil (mk-hs-ty-pat ty))))
    :cmd (cmd-fail #(dc :<+> (dc :text "type") (ph :ppr-ltype ty)) l)))

(defn mk-hs-let-pv "mkHsLetPV" [mode l bs e]
  (case mode
    :expr (L l (con HsLet (a/tuple nil nil) bs e))
    :cmd (L l (con HsCmdLet (a/tuple nil nil) bs e))
    :pat (fatal! (lx/msg :PsErrLetInPat l))))

(defn mk-hs-op-app-pv "mkHsOpAppPV" [mode l e1 op e2]
  (case mode
    :expr (do (reject-pragma-pv e1) (L l (con OpApp nx e1 op e2)))
    :cmd (let [cmd-arg (fn [c] (L (getLoc c) (con HsCmdTop nx c)))]
           (L l (con HsCmdArrForm nil op 'Infix [(cmd-arg e1) (cmd-arg e2)])))
    :pat (L l (con PatBuilderOpApp e1 op e2 nil))))

(defn mk-hs-case-pv "mkHsCasePV" [mode l e lms]
  (case mode
    :expr (L l (con HsCase nil e (mk-match-group lms)))
    :cmd (L l (con HsCmdCase nil e (mk-match-group lms)))
    :pat (fatal! (lx/msg :PsErrCaseInPat l))))

(defn mk-hs-lam-pv "mkHsLamPV" [mode l variant lms]
  (case mode
    :expr (let [mg (mk-lam-case-match-group variant lms)]
            ;; checkLamMatchGroup: a lambda without parameters
            (when (and (= variant 'LamSingle) (empty? (unLoc (nth (unLoc (first (unLoc (nth mg 2)))) 3))))
              (add-error! (lx/msg :PsErrEmptyLambda l)))
            (L l (con HsLam nil variant mg)))
    :cmd (L l (con HsCmdLam nil variant (mk-lam-case-match-group variant lms)))
    :pat (fatal! (lx/msg :PsErrLambdaInPat l variant))))

(defn mk-hs-app-pv "mkHsAppPV" [mode l e1 e2]
  (case mode
    :expr (do (check-exp-block-arguments e1) (check-exp-block-arguments e2) (L l (con HsApp nx e1 e2)))
    :cmd (do (check-cmd-block-arguments e1) (check-exp-block-arguments e2) (L l (con HsCmdApp nx e1 e2)))
    :pat (L l (con PatBuilderApp e1 e2))))

(defn mk-hs-app-type-pv "mkHsAppTypePV" [mode l e at t]
  (case mode
    :expr (do (check-exp-block-arguments e) (L l (con HsAppType nil e (mk-hs-wild-card-bndrs t))))
    :pat (L l (con PatBuilderAppType e at (mk-hs-ty-pat t)))
    :cmd (cmd-fail #(dc :<+> (ph :ppr-cmd e) (dc :<> (dc :text "@") (ph :ppr-ltype t))) l)))

(defn mk-hs-if-pv "mkHsIfPV" [mode l c a b]
  (case mode
    :expr (L l (con HsIf nil c a b))
    :cmd (L l (con HsCmdIf nil nx c a b))
    :pat (fatal! (lx/msg :PsErrIfThenElseInPat l))))

(defn mk-hs-do-pv "mkHsDoPV" [mode l mod stmts]
  (case mode
    :expr (L l (con HsDo nil (con DoExpr mod) stmts))
    :cmd (if (a/just? mod)
           (fatal! (lx/msg :PsErrQualifiedDoInCmd l (second (a/from-just mod))))
           (L l (con HsCmdDo nil stmts)))
    :pat (fatal! (lx/msg :PsErrDoNotationInPat l))))

(defn mk-hs-par-pv "mkHsParPV" [mode l lpar e rpar]
  (case mode
    :expr (L l (con HsPar (a/tuple nil nil) e))
    :cmd (L l (con HsCmdPar (a/tuple nil nil) e))
    :pat (L l (con PatBuilderPar lpar e rpar))))

(defn mk-hs-proj-update-pv "mkHsProjUpdatePV" [mode l fields arg pun anns]
  (case mode
    :expr (mk-rdr-proj-update l fields arg pun anns)
    (fatal! (lx/msg :PsErrOverloadedRecordDotInvalid l))))

(defn arrow-parsing-mode
  "withArrowParsingMode: :view-pat (ViewPatterns, or neither extension) or :fun-type
  (RequiredTypeArguments)"
  [ps]
  (cond (lx/get-bit ps :ViewPatternsBit) :view-pat
        (lx/get-bit ps :RequiredTypeArgumentsBit) :fun-type
        :else :view-pat))

(defn lhs-mode
  "The mode the left-hand side of an arrow is parsed in (Note [Arrow parsing mode]): an
  expression for a view pattern, else the right-hand side's"
  [amode mode]
  (if (identical? amode :view-pat) :expr mode))

(defn mk-hs-arrow-pv "mkHsArrowPV" [ps mode l amode arg arr res]
  (case mode
    :expr (L l (con HsFunArr nx arr arg res))
    :pat (if (identical? amode :view-pat)
           (L l (con PatBuilderPat (con ViewPat nil arg (check-lpat ps res))))
           (pat-fail (lx/msg :PsErrTypeSyntaxInPat l "function arrow"
                             ((requiring-resolve 'arbace.repr.haskell.doc/<+>)
                              (ph :ppr-patbuilder arg) (ph :ppr-arrow arr) (ph :ppr-patbuilder res)))))
    :cmd (cmd-fail #(dc :<+> (ph :ppr-cmd arg) (ph :ppr-arrow arr) (ph :ppr-cmd res)) l)))

(defn mk-hs-mult-pv
  "mkHsMultPV: a fn of the arrow token giving the multiplicity annotation (mkMultExpr)"
  [ps mode pct t]
  (case mode
    :expr (fn [arr]
            (let [e (unLoc t)]
              (if (and (= 'HsOverLit (first e))
                       (let [ol (nth e 2)]
                         (and (= 'HsIntegral (first (nth ol 2)))
                              (let [il (second (nth ol 2))]
                                (and (= (list 'src "1") (nth il 1)) (= 1 (nth il 3)))))))
                (con HsLinearAnn nil)
                (con HsExplicitMult (a/tuple nil nil) t))))
    :pat (pat-fail (lx/msg :PsErrTypeSyntaxInPat (combine (gl pct) (getLoc t)) "multiplicity annotation"
                           (dc :<> (dc :text "%") (ph :ppr-ltype t))))
    :cmd (cmd-fail #(dc :<> (dc :text "%") (ph :ppr-ltype t)) (combine (gl pct) (getLoc t)))))

(defn set-telescope-bndrs-name-space
  "setTelescopeBndrsNameSpace: the binders' names in namespace ns"
  [ns tele]
  (let [set-bndr (fn [[_ l tvb]]
                   ;; (HsTvb ann flag var kind)
                   (let [var (nth tvb 3)]
                     (L l (list 'HsTvb (nth tvb 1) (nth tvb 2)
                                (if (= 'HsBndrVar (first var))
                                  (let [[_ x [_ ll r]] var] (con HsBndrVar x (L ll (a/set-rdr-ns r ns))))
                                  var)
                                (nth tvb 4)))))]
    (case (first tele)
      HsForAllInvis (con HsForAllInvis (nth tele 1) (mapv set-bndr (nth tele 2)))
      HsForAllVis (con HsForAllVis (nth tele 1) (mapv set-bndr (nth tele 2))))))

(defn mk-hs-forall-pv "mkHsForallPV" [mode l tele ty]
  (case mode
    :expr (L l (con HsForAll nx (set-telescope-bndrs-name-space 'var tele) ty))
    (pat-fail (lx/msg :PsErrTypeSyntaxInPat l "forall telescope" (dc :text "<forall>")))))

(defn- check-context-expr
  "checkContextExpr: the constraint expressions of a context (a tuple, parenthesized, or ())"
  [orig]
  (let [l (getLoc orig)]
    (loop [e orig]
      (let [n (unLoc e)]
        (cond
          (and (= 'ExplicitTuple (first n)) (= 'Boxed (nth n 3))
               (every? #(= 'Present (first %)) (nth n 2)))
          (L l (mapv #(nth % 2) (nth n 2)))
          (= 'HsPar (first n)) (recur (nth n 2))
          (and (= 'HsVar (first n)) (= (unLoc (nth n 2)) (a/exact 'data "()"))
               ;; only when written ( ): a NameParens annotation (the source's () )
               true)
          (L l [])
          :else (L l [orig]))))))

(defn check-context-pv "checkContextPV" [ps mode e]
  (case mode
    :expr (check-context-expr e)
    (pat-fail (lx/msg :PsErrTypeSyntaxInPat (getLoc e) "constraint context" (dc :text "<context>")))))

(defn mk-qual-pv "mkQualPV" [mode l ctx ty]
  (case mode
    :expr (L l (con HsQual nx ctx ty))
    (pat-fail (lx/msg :PsErrTypeSyntaxInPat l "constraint context" (dc :text "<context>")))))

;;; ------------------------------------------------------------------------------------------
;;; Value bindings (checkValDef, checkFunBind, checkPatBind, isFunLhs, checkValSigLhs)

(defn- is-fun-lhs
  "isFunLhs: [fun fixity pats] when e is a function's left-hand side, else nil"
  [e]
  (letfn [(go [lpb es]
            (let [[_ l pb] lpb]
              (case (first pb)
                PatBuilderVar (let [ln (second pb)]
                                (when-not (rdr-data-con? (unLoc ln)) [ln 'Prefix es]))
                PatBuilderApp (let [[_ f x] pb] (go f (cons x es)))
                PatBuilderPar (when (seq es) (go (nth pb 2) es))
                PatBuilderOpApp
                (let [[_ ll op r] pb]
                  (if (not (rdr-data-con? (unLoc op)))
                    [op 'Infix (list* ll r es)]
                    (when-let [[op' fx [j k & es']] (go ll es)]
                      (when (= fx 'Infix)
                        [op' 'Infix (list* j (L l (con PatBuilderOpApp k op r nil)) es')]))))
                PatBuilderAppType
                (let [[_ lp at ty-pat] pb
                      t (nth ty-pat 2)
                      invis (L (combine (gl at) (getLoc t)) (con PatBuilderPat (con InvisPat (a/tuple nil 'SpecifiedSpec) ty-pat)))]
                  (go lp (cons invis es)))
                nil)))]
    (go e ())))

(defn- make-fun-bind "makeFunBind" [fn-name lms] (con FunBind nx fn-name (mk-match-group lms)))

(defn- check-fun-bind
  "checkFunBind: a FunBind of one equation spanning locF (an infix one's patterns checked with
  the operator as the parse context)"
  [ps locF fun fixity pats grhss]
  (let [ps' (binding [*parse-context* [(when (= fixity 'Infix) (unLoc fun)) false]] (mapv #(check-lpat ps %) pats))
        lp (list-location pats)]
    (make-fun-bind fun (L locF [(L locF (con Match nx (con FunRhs fun fixity 'NoSrcStrict nil) (L lp ps') (unLoc grhss)))]))))

(defn- check-pat-bind
  "checkPatBind: !x = e is a strict FunBind, any other a PatBind"
  [loc lhs grhss mult]
  (let [p (unLoc lhs)]
    (if (and (= 'BangPat (first p)) (= 'VarPat (first (unLoc (nth p 2))))
             (= 'HsUnannotated (first mult)))
      (let [v (nth (unLoc (nth p 2)) 2)]
        (make-fun-bind v (L loc [(L loc (con Match nx (con FunRhs v 'Prefix 'SrcStrict nil) (L nil []) (unLoc grhss)))])))
      (con PatBind nx lhs mult (unLoc grhss)))))

(defn check-val-def
  "checkValDef: a value binding of the left-hand side lhs (a PatBuilder), its multiplicity
  annotation and optional signature [mult [_ sig]], and its right-hand side"
  [ps loc lhs [mult sig] grhss]
  (cond
    (some? sig)
    ;; x :: ty = rhs is a pattern binding
    (let [lpb (mk-hs-ty-sig-pv ps :pat (combine (getLoc lhs) (getLoc sig)) lhs sig)]
      (check-pat-bind loc (check-lpat ps lpb) grhss mult))
    (= 'HsUnannotated (first mult))
    (if-let [[fun fixity pats] (is-fun-lhs lhs)]
      (check-fun-bind ps loc fun fixity pats grhss)
      (check-pat-bind loc (check-lpat ps lhs) grhss mult))
    :else (check-pat-bind loc (check-lpat ps lhs) grhss mult)))

(defn check-val-sig-lhs
  "checkValSigLhs: the name of a signature's left-hand side (an unqualified variable)"
  [lhs]
  (let [e (unLoc lhs)]
    (cond
      (not= 'HsVar (first e)) (fatal! (lx/msg :PsErrInvalidTypeSignature (getLoc lhs) :Other lhs))
      (not (a/rdr-unqual? (unLoc (nth e 2)))) (fatal! (lx/msg :PsErrInvalidTypeSignature (getLoc lhs) :Qualified lhs))
      (rdr-data-con? (unLoc (nth e 2))) (fatal! (lx/msg :PsErrInvalidTypeSignature (getLoc lhs) :DataCon lhs))
      :else (nth e 2))))

;;; ------------------------------------------------------------------------------------------
;;; Statements and comprehensions

(def no-expr "noExpr" (con HsLit nx (con HsString (a/src "noExpr") "noExpr")))

(defn mk-hs-comp
  "mkHsCompAnns: a comprehension's HsDo, the expression as its LastStmt"
  [ctxt stmts expr]
  (let [[_ l e] expr
        last-stmt (L l (con LastStmt nx (L l e) 'Nothing nx))
        all (conj (vec stmts) last-stmt)
        loc (reduce combine nil (map getLoc (cons last-stmt stmts)))]
    (con HsDo nil ctxt (L loc all))))

(defn mk-rec-stmt "mkRecStmt" [stmts] (con RecStmt nil stmts [] [] nx nx nx))

(defn mk-trans-stmt
  "mkTransformStmt, mkTransformByStmt, mkGroupUsingStmt, mkGroupByUsingStmt"
  [form ss using by]
  (con TransStmt nil form (vec ss) [] using (if by (just by) 'Nothing) nx nx no-expr))

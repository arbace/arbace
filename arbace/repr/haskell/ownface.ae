(ns arbace.repr.haskell.ownface
  "HF10-P3 (doc/haskell/FRONTEND-SURVEY.md, \"As built: HF10-P3 (first slice)\"): the front end's own interfaces. A
  module renamed (arbace.repr.haskell.rename) and elaborated (arbace.repr.haskell.typecheck) writes what its importers
  read of it, as GHC's GHC.Iface.Make's mkIface_ writes a ModIface's mi_exports, mi_fixities, mi_decls and mi_insts
  (and GHC.Iface.Tidy decides what is exposed), in the forms the renamer's and the elaborator's interface readers take
  (the helper's iface2 verb's: hsiface/exports, fixities, things, instances, unfoldings, fam-instances), so a library
  compiled bottom-up imports its own interfaces where it imported GHC's.

  What is written, GHC 9.14.1's rule for each (the spec: GHC's compiler/GHC/Iface/{Make,Tidy}.hs, GHC/Types/Id/Make.hs,
  BSD-3, LICENSE.md \"GHC\"):
  - exports: the renamer's AvailInfos (mi_exports), the module's own fixities (mi_fixities: its fixity declarations);
  - things (mi_decls: every exported thing the module defines, and every type constructor and class it defines that it
    does not export, as GHC.Iface.Tidy keeps every TyCon; the iface2 verb leaves the classes out): ids with their types (a class's methods too: their ClassOpIds),
    data constructors with their source arity (dataConSourceArity: the fields, not the dictionaries), their field labels,
    their wrapper types (forall univ ex. ctx => fields -> T), their source bangs and their implementation bangs as -O0
    decides them (dataConSrcToImplBang with bang_opt_unbox_disable: an UNPACK pragma is not honoured, HsStrict True),
    their tags; type constructors (data, newtype, synonym with its right-hand side, family with its flavour and a closed
    family's equations), each with a kind of its arity (the elaborator trusts kinds: FRONTEND-SURVEY §3.4, HF9-P4 (a)),
    classes with their methods, superclasses, variables, functional dependencies and default methods, pattern synonyms
    with patSynSig's parts and their builders' types;
  - instances (mi_insts): each dictionary function with its type; family instances (mi_fam_insts) with their
    equations, a data instance's with its representation tycon;
  - unfoldings: the compulsory ones alone. At -O0 GHC.Iface.Tidy's addExternal exposes no unfolding but a compulsory one
    (opt_expose_unfoldings = ExposeNone with -fomit-interface-pragmas, which -O0 implies), and an importer at -O0 reads
    none but a compulsory one (tcIdInfo with -fignore-interface-pragmas); every default method has one
    (GHC.HsToCore.Binds' makeCorePair, IsDefaultMethod: Note [INLINE and default methods]), written as the
    elaborator's Core of the $dm (dm-unfolding, the helper's form).

  A type is written so that the elaborator's reader (typecheck/conv-type) gives back the type the writer held: the
  invisible kind arguments the reader drops (a type constructor's kind arity, the unboxed tuples' and sums'
  representations, FUN's multiplicity and representations) are written as placeholders; the module's own type
  constructors have none (their kinds are written without invisible binders, so their kind arity is 0 when read).

  The judge (compare-ifaces): an own interface against GHC's of the same module, both read by the elaborator's readers
  (typecheck/iface-facts) and compared fact by fact: the avails, the fixities, each value's type, each constructor's
  arity, fields, tag and tycon, each class's variables, superclasses, methods, functional dependencies and defaults, each
  type constructor's flavour and constructors, each synonym's and family's definition, each instance's type, each family
  instance; types in the judge's canonical form (typecheck/canon)."
  (:require [arbace.string :as str]
            [arbace.set :as set]
            [arbace.repr.haskell.typecheck :as tc])
  (:import [java.io File]))

(defn- ext? [n] (and (vector? n) (= "ext" (nth n 0))))
(defn- nmod [n] (when (ext? n) (nth n 2)))
(defn- occ [n] (if (ext? n) (nth n 3) (str n)))
(def ^:private ns-str tc/name-str)
(defn- vec* [xs] (str "[" (str/join " " xs) "]"))

;;; ------------------------------------------------------------------------------------------
;;; Types as the reader takes them

(def ^:private many "(tycon-app (ext data \"GHC.Internal.Types\" \"Many\") [])")
(def ^:private kind-type "(tycon-app (ext tc \"GHC.Internal.Types\" \"Type\") [])")
(def ^:private ph "(tycon-app (ext tc \"GHC.Internal.Types\" \"Type\") [])") ; an erased kind or representation argument
(def ^:private prim-fun "(ext tc \"GHC.Internal.Prim\" \"FUN\")")

(declare type-form)

(defn- pred-form
  "A predicate [CLASS [TYPE...]] (a variable constraint [:cvar [t]]) as a constraint type"
  [ka [c ts]]
  (if (= :cvar c) (type-form ka (first ts)) (type-form ka [:tc c ts])))

(defn- tc-args
  "A type constructor's arguments as the reader expects them: its invisible arguments (kind arity ka, or the positions
  [n :pos]) as placeholders, an unboxed tuple's or sum's representations"
  [ka n as]
  (let [o (nth n 3)]
    (cond
      (and (= "GHC.Internal.Types" (nth n 2)) (re-matches #"(Tuple|Sum)[0-9]+#" o)) (concat (repeat (count as) ph) as)
      (get ka [n :pos]) (let [ps (get ka [n :pos])]
                          (loop [i 0 as (seq as) out []]
                            (cond (contains? ps i) (recur (inc i) as (conj out ph))
                                  (seq as) (recur (inc i) (rest as) (conj out (first as)))
                                  :else out)))
      (pos? (get ka n 0)) (concat (repeat (get ka n) ph) as)
      :else as)))

(def ^:dynamic *kinds* nil) ; HF10-P20: the thing's type variables' kinds the elaborator kept ({TV kind-type}), else Type

(defn type-form
  "A type of the elaborator's as the iface2 verb's typeF form, kind arities ka"
  [ka t]
  (case (first t)
    :tv (str "(tv " (pr-str (second t)) ")")
    :mv (str "(tv " (pr-str (str "m" (second t))) ")")
    :tc (let [n (second t) as (nth t 2)]
          (cond
            (and (= tc/fun-tc n) (= 2 (count as)))
            (str "(fun t " many " " (type-form ka (first as)) " " (type-form ka (second as)) ")")
            (= tc/fun-tc n) (str "(tycon-app " prim-fun " " (vec* (concat [many ph ph] (map #(type-form ka %) as))) ")")
            (keyword? n) (str "(tv " (pr-str (str n)) ")")
            :else (str "(tycon-app " (ns-str n) " " (vec* (map #(if (string? %) % (type-form ka %)) (tc-args ka n as))) ")")))
    :app (str "(app " (type-form ka (nth t 1)) " " (type-form ka (nth t 2)) ")")
    :forall (let [body (reduce (fn [acc p] (str "(fun c " many " " (pred-form ka p) " " acc ")"))
                               (type-form ka (nth t 3)) (reverse (nth t 2)))]
              (reduce (fn [acc v] (str "(forall " (pr-str v) " specified " (if-let [k (get *kinds* v)] (type-form ka k) kind-type) " " acc ")"))
                      body (reverse (nth t 1))))
    :lit (str "(lit " (pr-str (second t)) ")")
    (str "(lit " (pr-str (str t)) ")")))

(defn- kind-of-arity
  "A kind of n visible arguments, Type -> ... -> Type (the elaborator trusts kinds: an own type constructor has no
  invisible binder)"
  [n]
  (reduce (fn [acc _] (str "(fun t " many " " kind-type " " acc ")")) kind-type (range n)))

;;; ------------------------------------------------------------------------------------------
;;; The wired-in things (GHC.Builtin.Types): GHC knows them without an interface, and where its definition and the source's
;;; declaration differ the compiler's wins (Note [Drop wired-in things] in GHC.Iface.Tidy: never written, never read). The
;;; source of GHC.Internal.Types declares `data Multiplicity = Many | One`, GHC's multiplicityTyCon is [oneDataCon,
;;; manyDataCon]; `class a ~~ b`, `class a ~ b` and `class Coercible a b` have no superclass in the source, heqClass's and
;;; eqClass's is the primitive equality (~#), coercibleClass's the representational one (~R#)

(def ^:private wired-cons
  {["ext" "tc" "GHC.Internal.Types" "Multiplicity"] [["ext" "data" "GHC.Internal.Types" "One"] ["ext" "data" "GHC.Internal.Types" "Many"]]})

(def ^:private wired-supers
  {["ext" "tc" "GHC.Internal.Types" "~~"] ["ext" "tc" "GHC.Internal.Prim" "~#"]
   ["ext" "tc" "GHC.Internal.Types" "~"] ["ext" "tc" "GHC.Internal.Prim" "~#"]
   ["ext" "tc" "GHC.Internal.Types" "Coercible"] ["ext" "tc" "GHC.Internal.Prim" "~R#"]})

(def ^:private builtin-families
  "GHC.Builtin.Types.Literals' type families (typeNatTyCons, typeSymbolTyCons...): declared open in the source, built in
  (BuiltInSynFamTyCon: reduced by the compiler's own rules, typecheck/builtin-fam)"
  (set (concat (for [o ["AppendSymbol" "CharToNat" "ConsSymbol" "NatToChar" "UnconsSymbol"]] ["ext" "tc" "GHC.Internal.TypeLits" o])
               (for [o ["CmpChar" "CmpSymbol"]] ["ext" "tc" "GHC.Internal.TypeLits.Internal" o])
               (for [o ["*" "+" "-" "Div" "Log2" "Mod" "^"]] ["ext" "tc" "GHC.Internal.TypeNats" o])
               [["ext" "tc" "GHC.Internal.TypeNats.Internal" "CmpNat"]])))

(defn- wired
  "The elaborator's result with GHC.Builtin.Types' definitions in place of the source's"
  [r]
  (let [r (update r :families (fn [fs] (into {} (for [[n f] fs] [n (if (contains? builtin-families n) (assoc f :flavour :builtin) f)]))))
        r (reduce (fn [r [tn cs]]
                    (if (get-in r [:tycons tn])
                      (-> (assoc-in r [:tycons tn :cons] cs)
                          (update :cons (fn [m] (reduce (fn [m [i c]] (if (get m c) (assoc-in m [c :tag] (inc i)) m)) m (map-indexed vector cs)))))
                      r))
                  r wired-cons)]
    (reduce (fn [r [cn sc]]
              (if-let [info (get-in r [:classes cn])]
                (assoc-in r [:classes cn :supers] [[sc (mapv (fn [v] [:tv v]) (:tvs info))]])
                r))
            r wired-supers)))

;;; ------------------------------------------------------------------------------------------
;;; The writer

(defn- impl-bang
  "dataConSrcToImplBang at -O0 (bang_opt_unbox_disable): a strict field HsStrict, True when an UNPACK pragma asked
  (shouldUnpackArgTy's answer not taken: the pragma alone), else lazy"
  [strict? src]
  (cond (not strict?) "Lazy"
        (str/includes? (str src) "UNPACK") "StrictNotUnpacked(True)"
        :else "StrictNotUnpacked(False)"))

(defn- parse-things [texts] (keep (fn [t] (try (read-string t) (catch Throwable _ nil))) texts))

(defn- strs [n] (mapv #(if (symbol? %) (name %) %) n))

(defn helper-core
  "HF10-P12 (a): a Core expression of the -O0 Simplifier's (arbace.repr.haskell.core) in the helper's spelling, the one
  an interface's unfoldings are written in (desugar/norm-iface's inverse): a name vector as (ext NS M OCC), an
  alternative's :default as default, a cast dropped (the helper writes Core with its coercions erased, as the
  elaborator's Core is)"
  [x]
  (cond
    (and (vector? x) (= 4 (count x)) (= "ext" (nth x 0))) (list 'ext (symbol (nth x 1)) (nth x 2) (nth x 3))
    (and (seq? x) (= 'cast (first x))) (helper-core (second x))
    (and (seq? x) (= 'alt (first x)) (= :default (second x))) (apply list 'alt 'default (map helper-core (drop 2 x)))
    (seq? x) (apply list (map helper-core x))
    (vector? x) (mapv helper-core x)
    :else x))

(defn own-iface-text
  "The module's own interface: rr the renamer's result, r the elaborator's; unit the package's unit id; dm-over the
  default methods' unfoldings after the module's -O0 Simplifier ({$dm Core}, HF10-P12 (a)), written in place of the
  elaborator's Core of each"
  [rr r unit & [dm-over]]
  (let [r (wired r)
        m (:module r)
        own? (fn [n] (and (ext? n) (= m (nmod n))))
        ;; HF10-P41 (a): the own type constructors' inferred kind variables are their invisible arguments, written as
        ;; placeholders as an imported tycon's are (the reader takes them off again by the kind written below)
        ka (into (or (:kind-arity r) {})
                 (for [[n ti] (:tycons r) :when (and (own? n) (= :forall (first (:kind ti))))] [n (count (nth (:kind ti) 1))]))
        tf (fn [t] (type-form ka t))
        exported (set (filter own? (:exported r)))
        genv (:own-genv r)
        types (:types r)
        cons (into {} (filter (fn [[n _]] (own? n)) (:cons r)))
        tycons (into {} (filter (fn [[n _]] (own? n)) (:tycons r)))
        rn-things (parse-things (:things rr))
        src-bangs (into {} (for [t rn-things :when (and (seq? t) (= 'datacon (first t)))] [(strs (second t)) (:src-bangs (nth t 6 {}))]))
        classes (:classes r)
        patsyns (:patsyns r)
        ;; a record pattern synonym's field selectors (GHC.Tc.TyCl.PatSyn's mkPatSynRecSelBinds: forall univ. req => res ->
        ;; the field's argument type)
        psels (into {} (for [[_ ps] patsyns [f a] (map vector (:fields ps) (:args ps)) :when f]
                         [f [:forall (vec (:univ ps)) (vec (:req ps)) (tc/fn-ty (:res ps) a)]]))
        ids (for [n (sort-by ns-str exported)
                  :when (contains? #{"var" "fld"} (nth n 1))
                  :when (not (contains? patsyns n))
                  :let [t (or (get types n) (get genv n) (get psels n))] :when t]
              (str "(id " (ns-str n) " \"\" " (binding [*kinds* (get (:tv-kinds r) n)] (tf t)) " {})"))
        datacons (for [n (sort-by ns-str exported) :when (= "data" (nth n 1))
                       :let [info (get cons n) t (get genv n)] :when (and info t (not (contains? patsyns n)))]
                   (let [d (:dicts info 0) bangs (get src-bangs n [])
                         strict (drop d (:strict info))]
                     (str "(datacon " (ns-str n) " \"\" " (- (:arity info) d) " " (vec* (map (comp pr-str occ) (:fields info))) " " (tf t)
                          " {:src-bangs " (vec* (map pr-str bangs))
                          " :impl-bangs " (vec* (map-indexed (fn [i s] (pr-str (impl-bang s (nth bangs i nil)))) strict))
                          " :tag " (:tag info 1) "})")))
        tycon-forms (for [[n ti] (sort-by (comp ns-str key) tycons) :when (not (str/starts-with? (occ n) "R:"))]
                      (let [ar (count (:tvs ti))]
                        (str "(tycon " (ns-str n) " \"\" " (:flavour ti) " " (vec* (map ns-str (:cons ti))) " "
                             ;; HF10-P41 (a): its inferred kind (typecheck/infer-tycon-kinds!), else one of its arity
                             (if (:kind ti) (type-form ka (:kind ti)) (kind-of-arity ar))
                             " {:roles " (vec* (repeat ar "representational")) " :arity " ar "})")))
        syn-forms (for [[n [tvs rhs]] (sort-by (comp ns-str key) (:syns r)) :when (own? n)]
                    (str "(tycon " (ns-str n) " \"\" synonym [] " (kind-of-arity (count tvs))
                         " {:roles " (vec* (repeat (count tvs) "representational")) " :arity " (count tvs)
                         " :synonym [" (vec* (map pr-str tvs)) " " (tf rhs) "]})"))
        ;; a family's arity and its equations' left-hand sides with its invisible kind arguments (the reader takes them
        ;; off again: a wired-in family's, Any's)
        kph (fn [n] (repeat (get ka n 0) ph))
        fam-forms (for [[n f] (sort-by (comp ns-str key) (:families r))]
                    (let [ar (+ (:arity f 0) (get ka n 0))]
                      (str "(tycon " (ns-str n) " \"\" family [] " (kind-of-arity ar)
                           " {:roles " (vec* (repeat ar "nominal")) " :arity " ar
                           " :family " (name (:flavour f :open))
                           (when (= :closed (:flavour f))
                             (str " :equations " (vec* (for [e (:eqns f)]
                                                         (str "(eqn " (vec* (map pr-str (:tvs e))) " " (vec* (concat (kph n) (map tf (:lhs e)))) " " (tf (:rhs e)) ")")))))
                           "})")))
        ;; every class the module defines, exported or not (GHC.Iface.Tidy keeps every TyCon in mi_decls: an exported
        ;; class's superclass may be one the module does not export, Real of Integral in GHC.Internal.Real's hs-boot file)
        class-forms (for [[n info] (sort-by (comp ns-str key) classes) :when (own? n)]
                      (str "(class " (ns-str n) " [] "
                           (vec* (for [mn (:methods info) :let [t (get genv mn)] :when t] (str "(" (ns-str mn) " \"\" " (tf t) ")")))
                           " " (vec* (map #(pred-form ka %) (:supers info)))
                           ;; a class whose kind has invisible binders (the wired-in ones: typecheck/wired-kind-arities) has
                           ;; its kind variables first, as classTyVars puts them; the reader drops them again
                           " {:tvs " (vec* (map pr-str (concat (map #(str "k" %) (range (get ka n 0))) (:tvs info))))
                           " :fundeps " (vec* (for [[l rr*] (:fundeps info)]
                                                (vec* [(vec* (map #(pr-str (nth (:tvs info) % "?")) l)) (vec* (map #(pr-str (nth (:tvs info) % "?")) rr*))])))
                           " :defaults " (vec* (for [[mn d] (sort-by (comp ns-str key) (:defaults info))] (str "[" (ns-str mn) " " (ns-str d) "]")))
                           ;; HF10-P33 (a): DefaultSignatures' default signatures (GHC's IfaceClassOp's GenericDM), the method's
                           ;; default type over the class's variables, so an importing module's instance that omits the method
                           ;; applies $dm to the context's dictionaries (the judge's class fact leaves them out: GHC's dump lacks them)
                           (when (seq (:dsigs info))
                             (str " :dsigs " (vec* (for [[mn t] (sort-by (comp ns-str key) (:dsigs info))] (str "[" (ns-str mn) " " (tf t) "]")))))
                           " :ats []})"))
        patsyn-forms (for [[n ps] (sort-by (comp ns-str key) patsyns) :when (contains? exported n)]
                       (str "(patsyn " (ns-str n)
                            " {:univ " (vec* (map pr-str (:univ ps))) " :req " (vec* (map #(pred-form ka %) (:req ps)))
                            " :ex " (vec* (map pr-str (:ex ps))) " :prov " (vec* (map #(pred-form ka %) (:prov ps)))
                            " :args " (vec* (map tf (:args ps))) " :res " (tf (:res ps))
                            " :fields " (vec* (map (comp pr-str occ) (:fields ps)))
                            " :builder " (if-let [b (get genv n)] (tf b) "nil") "})"))
        insts (for [{:keys [dfun tvs ctx head]} (:own-insts r)]
                (str "(instance " (ns-str dfun) " " (tf [:forall tvs ctx [:tc (first head) (second head)]]) ")"))
        ;; the default methods' compulsory unfoldings (GHC.HsToCore.Binds' makeCorePair with is_default_method: every
        ;; $dm, IsDefaultMethod's export, Note [INLINE and default methods]), the only unfoldings an -O0 interface carries
        ;; (addExternal's Note [Always expose compulsory unfoldings]); since HF10-P12 (a) the $dm's stable unfolding after
        ;; the module's own -O0 Simplifier (simplStableUnfolding in updModeForStableUnfoldings' mode: what GHC's
        ;; -O0 interface carries), else the elaborator's Core of the $dm; its local binders made unique to the module
        ;; (an importer's own binders are numbered alike)
        dms (set (for [[_ info] classes [_ d] (:defaults info)] d))
        uniq (fn uniq [x] (cond (and (seq? x) (= 'lv (first x)) (= 3 (count x))) (list 'lv (second x) (str (nth x 2) "@" m))
                                (seq? x) (apply list (map uniq x))
                                (vector? x) (mapv uniq x)
                                :else x))
        dm-unfs (binding [*print-length* nil *print-level* nil *print-meta* false]
                  (vec (sort (for [b (:core r) :when (and (seq? b) (= 'bind (first b)) (contains? dms (second b)))]
                               (str "(dm-unfolding " (ns-str (second b)) " " (pr-str (uniq (get dm-over (second b) (nth b 2)))) ")")))))
        head-occ (fn [t] (case (first t) :tc (occ (second t)) :tv (first (str/split (second t) #"_")) :app (recur (second t)) ""))
        fis (for [[fam e] (:fam-insts r)]
              (let [ax (cond (:ax e) (:ax e) (:data e) (str "D:" (occ (second (:rhs e))) "0") :else (str "D:R:" (occ fam) (apply str (map head-occ (:lhs e)))))]
                (str "(fam-instance (ext tc " (pr-str m) " " (pr-str ax) ") " (ns-str fam) " " (vec* (concat (kph fam) (map tf (:lhs e)))) " " (tf (:rhs e)) ")")))]
    (str "(hsiface/module " (pr-str m) " {:unit " (pr-str unit) " :verb \"own\" :own 1})\n"
         "(hsiface/exports [" (str/join "\n  " (:exports rr)) "])\n"
         "(hsiface/fixities [" (str/join "\n  " (for [[n [p d]] (sort-by (comp ns-str key) (:fixities rr))]
                                                  (str "(fixity " (nth n 1) " " (pr-str (nth n 3)) " " p " " d ")"))) "])\n"
         "(hsiface/things [" (str/join "\n  " (sort (concat ids datacons tycon-forms syn-forms fam-forms class-forms patsyn-forms))) "])\n"
         "(hsiface/instances [" (str/join "\n  " (sort insts)) "])\n"
         "(hsiface/unfoldings [" (str/join "\n  " dm-unfs) "])\n"
         "(hsiface/fam-instances [" (str/join "\n  " (sort fis)) "])\n")))

;;; ------------------------------------------------------------------------------------------
;;; The judge

(defn- read-forms [text] (read-string (str "[" text "]")))

(defn- section [forms k] (some (fn [f] (when (and (seq? f) (= k (first f))) (second f))) forms))

(defn ka-of-pool
  "The invisible kind arities of every interface of a directory of GHC's interfaces (each name's arity is global: one
  table for the run)"
  [dir]
  (let [things (vec (for [^File f (sort-by #(.getName ^File %) (.listFiles (File. ^String dir)))
                          :when (str/ends-with? (.getName f) ".iface.edn")
                          t (section (read-forms (slurp f)) 'hsiface/things)] t))]
    (tc/kind-arities things {})))

(defn compare-ifaces
  "An own interface's text against GHC's of the module: {:facts n :equal n :missing n :extra n :diff [...]
  :by {SECTION [equal facts]}}; syns the elaborator's synonyms (for the canonical forms), own-ka and ghc-ka the kind
  arities each is read with"
  [own-text ghc-text syns own-ka ghc-ka]
  (let [of (read-forms own-text) gf (read-forms ghc-text)
        m (second (first gf))
        mine? (fn [n] (= m (nth n 2 nil)))
        avail (fn [a] [(strs (nth a 1)) (sort (map strs (nth a 2)))])
        fix (fn [f] [(name (nth f 1)) (nth f 2) (nth f 3) (name (nth f 4))])
        ofa (tc/iface-facts of own-ka) gfa (tc/iface-facts gf ghc-ka)
        syns (merge syns (:syns gfa) (:syns ofa))
        cn (fn [t] (try (tc/canon syns t) (catch Throwable e [:canon-error (ex-message e)])))
        pred-t (fn [[c ts]] (if (= :cvar c) (first ts) [:tc c ts]))
        acc (atom {:facts 0 :equal 0 :missing 0 :extra 0 :diff [] :by {}})
        fact! (fn [sec k g o]
                (swap! acc (fn [a]
                             (let [eq (= g o)]
                               (-> a (update :facts inc) (update :equal + (if eq 1 0))
                                   (update-in [:by sec] (fn [[e n]] [(+ (or e 0) (if eq 1 0)) (inc (or n 0))]))
                                   (cond-> (not eq) (update :diff (fn [d] (if (< (count d) 12) (conj d {:section sec :name k :ghc g :ours o}) d)))))))))
        cmp-map (fn [sec gm om f]
                  (doseq [[k g] gm]
                    (if (contains? om k) (fact! sec k (f g) (f (get om k)))
                        (do (swap! acc update :missing inc) (fact! sec k :present :absent))))
                  (doseq [k (keys om) :when (not (contains? gm k))] (swap! acc update :extra inc)))
        sets (fn [sec g o]
               (doseq [x g] (fact! sec x true (contains? o x)))
               (swap! acc update :extra + (count (remove g o))))]
    (sets :exports (set (map avail (section gf 'hsiface/exports))) (set (map avail (section of 'hsiface/exports))))
    (sets :fixities (set (map fix (section gf 'hsiface/fixities))) (set (map fix (section of 'hsiface/fixities))))
    (cmp-map :types (into {} (filter (comp mine? key) (:genv gfa))) (:genv ofa) cn)
    (cmp-map :datacons (into {} (filter (comp mine? key) (:cons gfa))) (:cons ofa)
             (fn [c] (select-keys c [:arity :fields :tag :tycon])))
    (cmp-map :classes (into {} (filter (comp mine? key) (:classes gfa))) (:classes ofa)
             (fn [c] {:ntvs (count (:tvs c)) :supers (mapv (comp cn pred-t) (:supers c)) :methods (set (:methods c))
                      :fundeps (:fundeps c) :defaults (:defaults c)}))
    (cmp-map :tycons (into {} (filter (comp mine? key) (:tycons gfa))) (:tycons ofa) (fn [t] (select-keys t [:flavour :cons])))
    (cmp-map :synonyms (into {} (filter (comp mine? key) (:syns gfa))) (into {} (filter (comp mine? key) (:syns ofa)))
             (fn [[tvs rhs]] (cn [:forall (vec tvs) [] rhs])))
    (cmp-map :families (into {} (filter (comp mine? key) (:families gfa))) (into {} (filter (comp mine? key) (:families ofa)))
             (fn [f] {:flavour (:flavour f) :arity (:arity f)
                      :eqns (set (for [e (:eqns f)] (cn [:forall (vec (:tvs e)) [] [:tc ["eqn"] (conj (vec (:lhs e)) (:rhs e))]])))}))
    (cmp-map :patsyns (into {} (filter (comp mine? key) (:patsyns gfa))) (:patsyns ofa)
             (fn [p] (cn [:forall (into (vec (:univ p)) (:ex p)) (into (vec (:req p)) (:prov p))
                          (reduce (fn [acc a] (tc/fn-ty a acc)) (:res p) (reverse (:args p)))])))
    ;; instances by their heads (the class at its argument types), the context compared; the dictionary functions' names
    ;; apart (GHC's getDFunTyKey also spells the invisible kind arguments: $fCategoryTYPEFUN, $fLiftBoxedRepBang)
    (let [hk (fn [{:keys [tvs head]}] (cn [:forall (vec tvs) [] [:tc (first head) (second head)]]))
          full (fn [{:keys [tvs ctx head]}] (cn [:forall (vec tvs) (vec ctx) [:tc (first head) (second head)]]))
          gi (into {} (map (juxt hk identity) (:insts gfa))) oi (into {} (map (juxt hk identity) (:insts ofa)))]
      (cmp-map :instances gi oi full)
      (doseq [[k g] gi :let [o (get oi k)] :when o] (fact! :dfun-names (:dfun g) (:dfun g) (:dfun o))))
    ;; the totals without the names (a fact of the elaborator's naming, not of the interface's content)
    (let [a @acc [e n] (get-in a [:by :dfun-names] [0 0])]
      (-> a (update :facts - n) (update :equal - e)
          (update :diff (fn [d] (vec (remove #(= :dfun-names (:section %)) d))))))))

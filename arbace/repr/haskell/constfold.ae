(ns arbace.repr.haskell.constfold
  "GHC's built-in rules for the floating-point primops (GHC.Core.Opt.ConstantFold), which -O0's one simplifier run
  (GHC.Driver.Config.Core.Opt's \"Non-opt simplification\", rules on) applies to every program: the only ones whose
  result differs from evaluating the primop, because GHC computes on the literals' Rationals (so 0.0 * -2.5 is 0.0, a
  Rational has no negative zero) and drops identities (0.0 +## x is x, so 0.0 +## -0.0 is -0.0). The integral primops'
  rules compute what the machine computes and are left to hsi. A literal is Core's (lit \"TEXT##\") (Double#) or
  (lit \"TEXT#\") (Float#) with a decimal TEXT, read exactly as a Rational."
  (:require [arbace.string :as str]))

(defn- head? [x h] (and (seq? x) (= h (first x))))

(defn- prim [o] (list 'v ["ext" "var" "GHC.Internal.Prim" o]))

(defn- prim-name [f] (when (and (head? f 'v) (vector? (second f)) (= "GHC.Internal.Prim" (nth (second f) 2))) (nth (second f) 3)))

;;; Literals: [:double r], [:float r], [:int n]

(defn- rational-of [^String t] (rationalize (java.math.BigDecimal. t)))

(defn- lit-val [e]
  (when (head? e 'lit)
    (let [t (second e)]
      (cond (re-matches #"-?[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?##" t) [:double (rational-of (subs t 0 (- (count t) 2)))]
            (re-matches #"-?[0-9]+\.[0-9]+([eE][+-]?[0-9]+)?#" t) [:float (rational-of (subs t 0 (dec (count t))))]
            (re-matches #"-?[0-9]+#" t) [:int (bigint (read-string (subs t 0 (dec (count t)))))]
            :else nil))))

(defn- to-bigdec ^java.math.BigDecimal [r]
  (if (ratio? r)
    (.divide (java.math.BigDecimal. (biginteger (numerator r))) (java.math.BigDecimal. (biginteger (denominator r)))
             (java.math.MathContext. 60))
    (java.math.BigDecimal. (biginteger r))))

(defn- as-double [r] (.doubleValue (to-bigdec r)))
(defn- as-float [r] (.floatValue (to-bigdec r)))

(defn- conv
  "convFloating: the Rational cut to the precision of its type (toRational . fromRational), nil when not finite"
  [kind r]
  (let [x (if (= kind :double) (as-double r) (double (as-float r)))]
    (when-not (or (Double/isInfinite x) (Double/isNaN x)) (rationalize (java.math.BigDecimal. x)))))

(defn- mk-lit
  "mkDoubleVal / mkFloatVal: the literal of a Rational (its sign of zero lost, as a Rational's)"
  [kind r]
  (when-let [r (conv kind r)]
    (let [x (if (= kind :double) (as-double r) (double (as-float r)))
          x (if (zero? x) 0.0 x)
          t (if (= kind :double) (str x) (str (float x)))]
      (list 'lit (str t (if (= kind :double) "##" "#"))))))

(defn- lit-of-kind [kind r] (list 'lit (str (if (= kind :double) (str (as-double r)) (str (as-float r))) (if (= kind :double) "##" "#"))))

(defn- wrap64 [n] (let [m (mod (bigint n) 18446744073709551616N)] (if (>= m 9223372036854775808N) (- m 18446744073709551616N) m)))

;;; The rules

(def ^:private ops
  {"+##" [:double :add] "-##" [:double :sub] "*##" [:double :mul] "/##" [:double :div] "negateDouble#" [:double :neg]
   "fmaddDouble#" [:double :fmadd] "fmsubDouble#" [:double :fmsub] "fnmaddDouble#" [:double :fnmadd] "fnmsubDouble#" [:double :fnmsub]
   "plusFloat#" [:float :add] "minusFloat#" [:float :sub] "timesFloat#" [:float :mul] "divideFloat#" [:float :div] "negateFloat#" [:float :neg]
   "fmaddFloat#" [:float :fmadd] "fmsubFloat#" [:float :fmsub] "fnmaddFloat#" [:float :fnmadd] "fnmsubFloat#" [:float :fnmsub]
   "double2Int#" [:double :to-int] "float2Int#" [:float :to-int] "int2Double#" [:double :from-int] "int2Float#" [:float :from-int]
   "double2Float#" [:double :to-float] "float2Double#" [:float :to-double]})

(defn- op-name [kind op]
  (get {[:double :add] "+##" [:double :sub] "-##" [:double :mul] "*##" [:double :neg] "negateDouble#"
        [:float :add] "plusFloat#" [:float :sub] "minusFloat#" [:float :mul] "timesFloat#" [:float :neg] "negateFloat#"} [kind op]))

(defn- lits [kind args] (let [vs (map lit-val args)] (when (every? #(= kind (first %)) vs) (mapv #(conv kind (second %)) vs))))
(defn- is-lit? [kind e r] (let [v (lit-val e)] (and (= kind (first v)) (= r (second v)))))

(defn- rule
  "The rewritten application of primop o to args, or nil (mkPrimOpRule's rules in GHC's order)"
  [o args]
  (when-let [[kind op] (get ops o)]
    (let [ap (fn [op2 as] (list 'app (prim (op-name kind op2)) (vec as)))]
      (case op
        :add (or (when-let [[a b] (lits kind args)] (when (and a b) (mk-lit kind (+ a b))))
                 (when (= 2 (count args))
                   (cond (is-lit? kind (first args) 0) (second args)   ; identity zerod
                         (is-lit? kind (second args) 0) (first args))))
        :sub (or (when-let [[a b] (lits kind args)] (when (and a b) (mk-lit kind (- a b))))
                 (when (and (= 2 (count args)) (is-lit? kind (second args) 0)) (first args)))
        :mul (or (when-let [[a b] (lits kind args)] (when (and a b) (mk-lit kind (* a b))))
                 (when (= 2 (count args))
                   (cond (is-lit? kind (first args) 1) (second args)
                         (is-lit? kind (second args) 1) (first args)
                         ;; strength reduction: x * 2.0 = x + x
                         (is-lit? kind (second args) 2) (ap :add [(first args) (first args)])
                         (is-lit? kind (first args) 2) (ap :add [(second args) (second args)]))))
        :div (or (when-let [[a b] (lits kind args)]
                   (when (and a b (or (not (zero? a)) (pos? b)) (not (zero? b))) (mk-lit kind (/ a b))))
                 (when (and (= 2 (count args)) (is-lit? kind (second args) 1)) (first args)))
        :neg (or (when-let [[a] (lits kind args)] (when (and a (not (zero? a))) (mk-lit kind (- a))))
                 ;; negate (negate e) = e
                 (let [a (first args)] (when (and (head? a 'app) (= (prim-name (second a)) o) (= 1 (count (nth a 2)))) (first (nth a 2)))))
        (:fmadd :fmsub :fnmadd :fnmsub)
        (when (= 3 (count args))
          (let [[x y z] args]
            (or (when-let [[a b c] (lits kind args)]
                  (when (and a b c)
                    (mk-lit kind (case op :fmadd (+ (* a b) c) :fmsub (- (* a b) c) :fnmadd (+ (- (* a b)) c) :fnmsub (- (- (* a b)) c)))))
                ;; fmaZero_z: x * y + 0 = x * y
                (when (is-lit? kind z 0)
                  (case op (:fmadd :fmsub) (ap :mul [x y]) (ap :neg [(ap :mul [x y])])))
                ;; fmaOne: (+-1) * t + z
                (let [one (fn [e] (cond (is-lit? kind e 1) false (is-lit? kind e -1) true))
                      [sgn t] (cond (some? (one x)) [(one x) y] (some? (one y)) [(one y) x])]
                  (when (some? sgn)
                    (cond (or (and (= op :fmadd) (not sgn)) (and (= op :fnmadd) sgn)) (ap :add [t z])
                          (#{:fmadd :fnmadd} op) (ap :sub [z t])
                          (or (and (= op :fmsub) (not sgn)) (and (= op :fnmsub) sgn)) (ap :sub [t z])
                          :else (ap :neg [(ap :add [t z])])))))))
        ;; the conversions (liftLit: the literal as it is, no convFloating)
        :to-int (let [v (lit-val (first args))] (when (= kind (first v)) (list 'lit (str (wrap64 (bigint (second v))) "#"))))
        :from-int (let [v (lit-val (first args))] (when (= :int (first v)) (lit-of-kind kind (second v))))
        :to-float (let [v (lit-val (first args))] (when (= :double (first v)) (lit-of-kind :float (second v))))
        :to-double (let [v (lit-val (first args))] (when (= :float (first v)) (lit-of-kind :double (second v))))
        nil))))

(defn fold
  "An expression with the floating-point primops' rules applied bottom-up, to a fixpoint at each application"
  [e]
  (cond
    (head? e 'app)
    (let [f (fold (second e)) args (mapv fold (nth e 2)) o (prim-name f)
          e2 (list 'app f args)]
      (if-let [r (when o (rule o args))] (recur r) e2))
    (seq? e) (apply list (map fold e))
    (vector? e) (mapv fold e)
    :else e))

(defn fold-program [binds] (mapv (fn [[_ b e]] (list 'bind b (fold e))) binds))

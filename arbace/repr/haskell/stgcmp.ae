(ns arbace.repr.haskell.stgcmp
  "HF6's STG judge: Arbace's STG of a module against GHC's -O0 STG (the helper's stg mode), per top-level binding
  of an external name, after renaming: the module's Typeable bindings ($tr, $tc, $krep) dropped, internal names
  (locals and GHC's internal top-level binders) renamed by first occurrence within each binding, GHC's internal
  top-level bindings that a binding mentions (its floated dictionaries and string literals) inlined at their single
  use as atoms; the data declarations compared as sets."
  (:require [arbace.string :as str]))

(defn- ext? [n] (and (string? n) (re-find #"^[^/]*:" n)))
(defn- typeable? [n] (and (string? n) (re-find #"(^|/)\$(tr|tc|krep)" n)))

(defn- read-file [f] (read-string (str "[" (slurp f) "]")))

(defn- top-name [f]
  (case (first f) bind (first (second f)) string (first (second f)) nil))

(defn- rename
  "Internal names numbered by first occurrence"
  [x]
  (let [m (atom {})]
    (letfn [(w [y] (cond
                     (and (string? y) (not (ext? y))) (or (get @m y) (let [k (str "x" (count @m))] (swap! m assoc y k) k))
                     ;; a closure's free variables compared as a set (GHC's order is its uniques'): the arguments and
                     ;; the body renamed first, the free variables after, sorted
                     (and (seq? y) (= 'closure (first y)))
                     (let [[_ u fvs args body] y args2 (w args) body2 (w body)]
                       (list 'closure u (vec (sort (map w fvs))) args2 body2))
                     ;; a primop's, a foreign call's name is not a variable
                     (and (seq? y) (contains? '#{primop foreign primcall} (first y)))
                     (apply list (first y) (second y) (map w (drop 2 y)))
                     (seq? y) (if (= 'str (first y)) y (apply list (map w y)))
                     (vector? y) (mapv w y)
                     :else y))]
      (w x))))

(defn- tops-of
  "The module's top-level bindings, NAME -> its right-hand side (a string literal's text as (str TEXT))"
  [forms]
  (let [flat (mapcat (fn [f] (if (= 'rec (first f)) (rest f) [f])) forms)]
    (into {} (for [f flat :let [n (top-name f)] :when n]
               [n (if (= 'string (first f)) (list 'str (nth f 2)) (nth f 2))]))))

(defn- closure-of
  "HF10: an external binding with the internal top-level bindings it reaches (GHC's floated method bindings, $c...,
  lvl..., string literals), in the order of their first occurrence, renamed together: internal top-level names are
  compared as locals are, by place, so a binding is equal when it and everything internal it uses are"
  [tops n]
  (loop [todo [n] seen #{n} out []]
    (if (empty? todo)
      (rename out)
      (let [x (first todo)
            rhs (get tops x)
            refs (atom [])
            _ ((fn w [y] (cond (and (string? y) (not (ext? y)) (contains? tops y) (not (contains? seen y))) (swap! refs conj y)
                               (or (seq? y) (vector? y)) (doseq [z y] (w z))
                               :else nil)) rhs)
            new (distinct (remove seen @refs))]
        (recur (into (vec (rest todo)) new) (into seen new) (conj out rhs))))))

(defn- bindings-of [forms]
  (let [tops (tops-of forms)]
    (into {} (for [[n _] tops :when (and (ext? n) (not (typeable? n)))]
               [n (closure-of tops n)]))))

(defn first-diff
  "The first place two renamed closures differ: [GHC's subterm OURS'] (HF10's classes of differences)"
  [a b]
  (cond
    (= a b) nil
    (and (sequential? a) (sequential? b) (= (count a) (count b)) (= (seq? a) (seq? b))
         (or (vector? a) (= (first a) (first b))))
    (some (fn [[x y]] (first-diff x y)) (map vector a b))
    :else [a b]))

(defn compare-files [ghc ours]
  (let [g (read-file ghc) o (read-file ours)
        gb (bindings-of g) ob (bindings-of o)
        ks (sort (filter #(contains? ob %) (keys gb)))
        eq (filter #(= (get gb %) (get ob %)) ks)
        gd (set (filter #(= 'stg/data (first %)) g)) od (set (filter #(= 'stg/data (first %)) o))]
    {:compared (count ks) :equal (count eq) :ghc-only (vec (sort (remove (set (keys ob)) (keys gb))))
     :ours-only (vec (sort (remove (set (keys gb)) (keys ob))))
     :diff (vec (remove (set eq) ks)) :data-equal (= gd od)
     :why (into {} (for [k ks :when (not= (get gb k) (get ob k))]
                     [k (let [[x y] (first-diff (get gb k) (get ob k))
                              t (fn [z] (let [q (binding [*print-length* 6 *print-level* 3] (pr-str z))] (subs q 0 (min 160 (count q)))))]
                          [(t x) (t y)])]))}))

(defn control
  "The judge's negative control (GTS81 (a)): OURS against GHC's file with its exported bindings' closures rotated (each
  binding's name given the next one's closure): [equal compared], equal must be 0 where the true judgment finds some"
  [ghc ours]
  (let [gb (bindings-of (read-file ghc)) ob (bindings-of (read-file ours))
        ks (sort (filter #(contains? ob %) (keys gb)))
        rot (zipmap ks (map gb (concat (rest ks) (take 1 ks))))]
    [(count (filter #(= (get rot %) (get ob %)) ks)) (count ks)]))

(defn show
  "One binding's closure in both files, renamed, as compare-files compares them"
  [ghc ours n]
  (let [gb (bindings-of (read-file ghc)) ob (bindings-of (read-file ours))]
    (binding [*print-length* nil *print-level* nil]
      (println "== ghc") (doseq [x (get gb n)] (prn x))
      (println "== ours") (doseq [x (get ob n)] (prn x)))))

(defn- signatures
  "A module's exported top-level bindings' calling conventions: NAME -> its closure's arguments' representations (a
  constructor application or a thunk: [])"
  [forms]
  (into {} (for [[n r] (tops-of forms) :when (ext? n)]
             [n (if (and (seq? r) (= 'closure (first r))) (mapv second (nth r 3)) [])])))

(defn abi
  "HF10-P20: the calling conventions of every module of OURS (a directory of M.stg.ae) against GHC's (GHC's directory):
  an exported binding whose arguments' representations differ (a caller compiled against one side breaks on the other),
  one line each: NAME GHC's OURS"
  [ghc-dir ours-dir]
  (doseq [f (sort (map #(.getName %) (seq (.listFiles (java.io.File. ours-dir)))))
          :when (str/ends-with? f ".stg.ae")
          :let [gf (java.io.File. ghc-dir f)]
          :when (.exists gf)]
    (let [g (signatures (read-file (str gf))) o (signatures (read-file (str ours-dir "/" f)))]
      (doseq [[n sg] (sort g) :let [so (get o n)] :when (and so (not= sg so))]
        (println n (pr-str sg) (pr-str so))))))

(defn- returns
  "Every case on a call of an external function with an unboxed tuple's alternative: FUNCTION -> the set of value counts"
  [forms]
  (let [m (atom {})]
    ((fn w [y] (when (or (seq? y) (vector? y))
                 (when (and (seq? y) (= 'case (first y)) (seq? (second y)) (= 'app (first (second y)))
                            (ext? (second (second y))) (seq? (nth y 3 nil)) (= 'multi (first (nth y 3))))
                   (swap! m update (second (second y)) (fnil conj #{}) (second (nth y 3))))
                 (doseq [z y] (w z))))
     forms)
    @m))

(defn- tuple-cons
  "Each top-level binding's unboxed tuples built: NAME -> the set of their sizes (the values returned)"
  [forms]
  (into {} (for [[n r] (tops-of forms) :when (ext? n)
                 :let [m (atom #{})]]
             (do ((fn w [y] (when (or (seq? y) (vector? y))
                              (when (and (seq? y) (= 'con (first y)) (string? (second y)) (re-find #"/(\(#,*#\)|MkSolo#)$" (second y)))
                                (swap! m conj (count (nth y 2))))
                              (doseq [z y] (w z))))
                  r)
                 [n @m]))))

(defn builds
  "HF10-P20: the unboxed tuples' sizes each binding builds, OURS against GHC's, one line a binding that differs"
  [ghc-dir ours-dir]
  (doseq [f (sort (map #(.getName %) (seq (.listFiles (java.io.File. ours-dir)))))
          :when (str/ends-with? f ".stg.ae")
          :let [gf (java.io.File. ghc-dir f)]
          :when (.exists gf)]
    (let [g (tuple-cons (read-file (str gf))) o (tuple-cons (read-file (str ours-dir "/" f)))]
      (doseq [[n so] (sort o) :let [sg (get g n)] :when (and sg (not= sg so) (seq (remove sg so)))]
        (println n (pr-str (sort sg)) (pr-str (sort so)))))))

(defn rets
  "HF10-P20: the unboxed tuples' sizes the callers of each external function expect, OURS (a directory) against GHC's:
  a function whose callers expect another size on our side returns another size (the run's \"unboxed tuple of the wrong
  size\"), one line each: FUNCTION GHC's OURS"
  [ghc-dir ours-dir]
  (let [rd (fn [d] (apply merge-with into (for [f (sort (map #(.getName %) (seq (.listFiles (java.io.File. d)))))
                                                :when (str/ends-with? f ".stg.ae")]
                                            (returns (read-file (str d "/" f))))))
        g (rd ghc-dir) o (rd ours-dir)]
    (doseq [[f so] (sort o) :let [sg (get g f)] :when (and sg (not= sg so))]
      (println f (pr-str (sort sg)) (pr-str (sort so))))))

(defn -main [ghc ours & [n]]
  (cond
    (= ghc "--abi") (abi ours n)
    (= ghc "--rets") (rets ours n)
    (= ghc "--builds") (builds ours n)
    (= n "--why") (doseq [[k [x y]] (sort (:why (compare-files ghc ours)))] (println "==" k) (println "  ghc:" x) (println "  own:" y))
    (= n "--control") (let [[e c] (control ghc ours)] (println (str "control " e " of " c " bindings equal")))
    n (show ghc ours n)
    :else
  (let [c (compare-files ghc ours)]
    (println (str "stg " (:equal c) " of " (:compared c) " bindings equal, data " (if (:data-equal c) "equal" "differs")))
    (println "ghc only:" (pr-str (:ghc-only c)))
    (println "differ:" (pr-str (:diff c))))))

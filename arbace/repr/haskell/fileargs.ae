(ns arbace.repr.haskell.fileargs
  "The driver's phase before the parse, which reports the header's own errors (doc/haskell/NATIVE.md,
  \"Messages\"): the header pragmas as GHC.Parser.Header's getOptions reads them (an unsupported
  extension, a LANGUAGE or OPTIONS_GHC pragma that does not parse), their flags run through
  GHC.Driver.CmdLine's processArgs over the table of flagsDynamic (arbace.repr.haskell.flags,
  generated by the helper's `flags` verb): a flag with a malformed argument is a usage error,
  one no dynamic flag takes an unknown-flag error, an unrecognised -W flag a warning. The misplaced
  pragmas' warnings are the header's (getOptions's second result)."
  (:require [arbace.repr.haskell.errors :as er]
            [arbace.repr.haskell.flags :as fl]
            [arbace.repr.haskell.header :as hd]
            [arbace.repr.haskell.ast :as a]
            [arbace.repr.haskell.lex :as lx]
            [arbace.string :as str]))

(defn- msg [con span & args] (apply er/msg con span args))

;;; ------------------------------------------------------------------------------------------
;;; toArgs (Header.hs): an OPTIONS pragma's text as located arguments

(defn- adv "advanceSrcLoc over the character c: [line col]" [[l c] ch]
  (case (long ch)
    10 [(inc l) 1]
    9 [l (inc (bit-shift-left (inc (bit-shift-right (dec (long c)) 3)) 3))]
    [l (inc (long c))]))

(defn- advance-str [loc ^String s]
  (reduce adv loc (seq (lx/code-points s))))

(defn- hs-space? [c] (lx/hs-space? c))

(defn to-args-loc
  "toArgs starting-loc str: [:right [[arg span] ...]] (span [file l1 c1 l2 c2], the end exclusive) or [:left]"
  [^String file loc0 ^String s]
  (let [cs (vec (seq (lx/code-points s)))
        n (count cs)
        span (fn [[l1 c1] [l2 c2]] [file l1 c1 l2 c2 0 0])
        ->str (fn [from to] (let [sb (StringBuilder.)] (doseq [c (subvec cs from to)] (.appendCodePoint sb (int c))) (.toString sb)))
        consume-spaces (fn [i loc] (loop [i i loc loc] (if (and (< i n) (hs-space? (cs i))) (recur (inc i) (adv loc (cs i))) [i loc])))
        ;; readAsString: [arg i' loc'] or nil (the literal must be complete and read once)
        read-as-string (fn [i loc]
                         (when-let [[v rest] (hd/read-hs-string (->str i n))]
                           (let [rest-n (count (seq (lx/code-points rest)))
                                 i2 (- n rest-n)]
                             [v i2 (advance-str loc (->str i i2))])))
        check-for-space (fn [i] (or (>= i n) (hs-space? (cs i))))
        to-args' (fn to-args' [i loc]
                   (let [[i loc] (consume-spaces i loc)]
                     (cond
                       (>= i n) [:right []]
                       (= 34 (cs i))
                       (if-let [[arg i2 loc2] (read-as-string i loc)]
                         (if (check-for-space i2)
                           (let [r (to-args' i2 loc2)]
                             (if (= :left (first r)) r [:right (into [[arg (span loc loc2)]] (second r))]))
                           [:left])
                         [:left])
                       :else
                       (let [j (loop [j i] (if (and (< j n) (not (hs-space? (cs j))) (not= 34 (cs j))) (recur (inc j)) j))
                             part1 (->str i j)
                             loc2 (advance-str loc part1)]
                         (if (and (< j n) (= 34 (cs j)))
                           (if-let [[arg2 i3 loc3] (read-as-string j loc2)]
                             (if (check-for-space i3)
                               (let [r (to-args' i3 loc3)]
                                 (if (= :left (first r)) r
                                     [:right (into [[(str part1 (er/show-string arg2)) (span loc loc3)]] (second r))]))
                               [:left])
                             [:left])
                           (let [r (to-args' j loc2)]
                             (if (= :left (first r)) r [:right (into [[part1 (span loc loc2)]] (second r))])))))))
        read-as-list (fn read-as-list [i loc]
                       (let [[i loc] (consume-spaces i loc)]
                         (if-let [[arg i2 loc2] (when (and (< i n) (= 34 (cs i))) (read-as-string i loc))]
                           (let [[i3 loc3] (consume-spaces i2 loc2)
                                 here [arg (span loc loc2)]]
                             (cond
                               (and (< i3 n) (= 44 (cs i3)))
                               (let [r (read-as-list (inc i3) (adv loc3 44))]
                                 (if (= :left (first r)) r [:right (into [here] (second r))]))
                               (and (< i3 n) (= 93 (cs i3)) (every? hs-space? (subvec cs (inc i3))))
                               [:right [here]]
                               :else [:left]))
                           [:left])))
        [i loc] (consume-spaces 0 loc0)]
    (if (and (< i n) (= 91 (cs i)))
      (let [loc (adv loc 91)
            [j locj] (consume-spaces (inc i) loc)]
        (if (and (< j n) (= 93 (cs j)) (every? hs-space? (subvec cs (inc j))))
          [:right []]
          (read-as-list j locj)))
      (to-args' i loc))))

;;; ------------------------------------------------------------------------------------------
;;; getOptions'

(defn- tokens
  "getToks: the pragma-state lexer's tokens, lazily, to the end of the input (or a lexical error)"
  [ps]
  (lazy-seq
   (let [t (try (lx/lex-token ps) (catch Exception _ [:ITeof nil nil]))]
     (if (= :ITeof (first t)) (list t) (cons t (tokens ps))))))

(defn- comment? [t] (#{:ITlineComment :ITblockComment :ITdocComment} (first t)))

(defn- combine-spans [s1 s2] [(nth s1 0) (nth s1 1) (nth s1 2) (nth s2 3) (nth s2 4) 0 0])

(defn get-options
  "getOptions' over the module's tokens: {:args [[arg span]...] :unsupported {index ext}} or
  {:error msg} (a malformed pragma: the first in token order); :misplaced a delay of the warnings
  for the pragmas past the header. An argument of a LANGUAGE pragma is [\"-XExt\" span] (:unsupported
  marks those GHC does not support: the error GHC throws when it gets to them)"
  [toks supported]
  (let [supported (set supported)]
    (loop [ts toks args []]
      (let [[t1 t2 & more] ts
            k1 (first t1)]
        (cond
          (and (= :IToptions_prag k1) (= :ITclose_prag (first t2)))
          (let [open (nth t1 2) start [(nth open 1) (nth open 2)]
                r (to-args-loc (nth open 0) start (second t1))]
            (if (= :left (first r))
              {:error (msg :PsErrParseOptionsPragma (combine-spans open (nth t2 2)) (second t1))}
              (recur more (into args (second r)))))
          (and (= :ITinclude_prag k1) (= :ITclose_prag (first t2)))
          (recur more (conj args ["-#include" (nth t1 2)] [(str/trim (second t1)) (nth t1 2)]))
          (and (= :ITdocOptions k1) (= :ITclose_prag (first t2)))
          (recur more (conj args ["-haddock-opts" (nth t1 2)] [(str/trim (second t1)) (nth t1 2)]))
          (= :ITlanguage_prag k1)
          (let [r (loop [us (rest ts) args args]
                    (let [[u v & more2] us]
                      (if (= :ITconid (first u))
                        (let [args (conj args (if (supported (second u))
                                                [(str "-X" (second u)) (nth u 2)]
                                                [(str "-X" (second u)) (nth u 2) (second u)]))]
                          (case (first v)
                            :ITcomma (recur (rest (rest us)) args)
                            :ITclose_prag [:ok more2 args]
                            [:error (msg :PsErrParseLanguagePragma (nth v 2))]))
                        [:error (msg :PsErrParseLanguagePragma (nth u 2))])))]
            (if (= :error (first r))
              {:error (second r)}
              (recur (second r) (nth r 2))))
          (comment? t1) (recur (rest ts) args)
          :else
          {:args args
           :misplaced (delay
                        (vec (for [t ts
                                   :let [m (case (first t)
                                             :IToptions_prag :OptionsPrag
                                             :ITinclude_prag :IncludePrag
                                             :ITdocOptions :DocOptionsPrag
                                             :ITlanguage_prag :LanguagePrag
                                             nil)]
                                   :when m]
                               (msg :PsWarnMisplacedPragma (nth t 2) m))))})))))

;;; ------------------------------------------------------------------------------------------
;;; processArgs over flagsDynamic

(def ^:private flag-table
  (delay (vec (for [[nm kind] fl/dynamic-flags] [nm (count nm) kind]))))

(defn- find-arg
  "findArg: the flag with the shortest rest (the first of those), [rest kind name], or nil"
  [^String arg]
  (let [best (reduce
              (fn [best [^String nm ^long ln kind]]
                (if (and (str/starts-with? arg nm)
                         (let [rest (subs arg ln)]
                           (case kind
                             (:no-arg :sep-arg :pass-flag) (empty? rest)
                             true))
                         (or (nil? best) (< (- (count arg) ln) (count (first best)))))
                  [(subs arg ln) kind nm]
                  best))
              nil @flag-table)]
    (when best (update best 0 str/trim))))

(defn- drop-eq [^String s] (if (str/starts-with? s "=") (subs s 1) s))

(defn- parse-int [^String s] (when (re-matches #"-?[0-9]+|0[xX][0-9a-fA-F]+|0[oO][0-7]+" s) s))

(defn- step
  "One argument of processArgs: the state [more d leftover errs warns] after it"
  [[as d leftover errs warns]]
  (let [[arg span] (first as) more (rest as)
        found (when (str/starts-with? arg "-") (find-arg (subs arg 1)))
        warns (if (= "#include" (nth found 2 nil))
                (conj warns (msg :DriverDeprecatedFlag span "-#include"
                                 "-#include and INCLUDE pragmas are deprecated: They no longer have any effect"))
                warns)
        keep-on [more d leftover errs warns]
        unknown [more d (conj leftover [arg span]) errs warns]]
    (if-not found
      unknown
      (let [[rst kind nm] found]
        (let [rest-no-eq (drop-eq rst)
              err (fn [m] [more d leftover (conj errs [span m]) warns])
              missing (err (str "missing argument for flag: " arg))]
          (case kind
            :no-arg [more (hd/dyn-flags d [arg]) leftover errs warns]
            :has-arg (cond (seq rest-no-eq) keep-on
                           (empty? more) missing
                           :else (assoc keep-on 0 (rest more)))
            :sep-arg (if (empty? more) missing (assoc keep-on 0 (rest more)))
            :prefix (cond
                      (empty? rest-no-eq) missing
                      ;; the -W prefixes of an unrecognised warning (Session.hs's unrecognisedWarning)
                      (#{"Wno-" "Werror=" "Wwarn=" "Wno-error=" "W" "fwarn-" "fno-warn-"} nm)
                      [more d leftover errs (conj warns (msg :DriverUnrecognisedFlag span (str nm rest-no-eq)))]
                      :else keep-on)
            :pass-flag (if (seq rst) unknown [more (hd/dyn-flags d [arg]) leftover errs warns])
            :opt-int-suffix (if (or (empty? rst) (parse-int rest-no-eq)) keep-on
                                (err (str "malformed integer argument in " arg)))
            :int-suffix (if (parse-int rest-no-eq)
                          [more (hd/dyn-flags d [arg]) leftover errs warns]
                          (err (str "malformed integer argument in " arg)))
            :word64-suffix (if (re-matches #"[0-9]+" rest-no-eq) keep-on
                               (err (str "malformed natural argument in " arg)))
            :float-suffix (if (re-matches #"-?[0-9]+(\.[0-9]+)?([eE][-+]?[0-9]+)?" rest-no-eq) keep-on
                              (err (str "malformed float argument in " arg)))
            (:opt-prefix :any-suffix) keep-on))))))

(defn process-args
  "processArgs over the located arguments [[arg span ...]] from state d: {:d :leftover :errs
  [[span msg]] :warns [messages]}"
  [d args]
  (loop [st [args d [] [] []]]
    (if (empty? (first st))
      (let [[_ d leftover errs warns] st] {:d d :leftover leftover :errs errs :warns warns})
      (recur (step st)))))

;;; ------------------------------------------------------------------------------------------
;;; getFileArgs

(defn- span-ppr
  "ppr of a SrcSpan, as errorsToGhcException prints the flag's location"
  [[f l1 c1 l2 c2]]
  (cond
    (and (= l1 l2) (<= (- c2 c1) 1)) (str f ":" l1 ":" c1)
    (= l1 l2) (str f ":" l1 ":" c1 "-" (dec c2))
    :else (str f ":(" l1 "," c1 ")-(" l2 "," (if (zero? c2) c2 (dec c2)) ")")))

(def usage-line "Usage: For basic information, try the `--help' option.")

(defn file-args
  "The driver's phase for a module's text (code points cs) of file under the command line's flags
  state d0: {:error batches} (the messages ghc prints and stops at: vectors of messages or a raw
  string) or {:d the flags state after the header's flags :pre (delay of batches for the warnings
  ghc prints before the parse's messages)}"
  [cs file d0]
  (let [ps (lx/make-state cs file (hd/parser-bits d0) :prags true)
        r (get-options (tokens ps) fl/supported-pragmas)]
    (if (:error r)
      {:error [[(:error r)]]}
      (if-let [[arg span ext] (first (filter #(= 3 (count %)) (:args r)))]
        {:error [[(msg :PsErrUnsupportedExt span ext (a/fuzzy-lookup ext fl/supported-pragmas))]]}
        (let [{:keys [d leftover errs warns]} (process-args d0 (:args r))]
          (cond
            (seq errs)
            {:error [(str "ghc-9.14.1: " (str/join "\n" (map (fn [[sp m]] (str (span-ppr sp) ": " m)) errs))
                          "\n" usage-line "\n")]}
            (seq leftover)
            {:error [(mapv (fn [[arg span]] (msg :PsErrUnknownOptionsPragma span arg)) leftover)]}
            :else
            {:d d
             :pre (delay (let [on? (fn [m] (hd/warning-on? d0 (er/warning-flag m)))]
                           [(filterv on? @(:misplaced r))
                            (filterv #(hd/warning-on? d (er/warning-flag %)) warns)]))}))))))

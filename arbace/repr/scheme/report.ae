(ns arbace.repr.scheme.report
  "R6RS's lexical and datum syntax as the report states it (R6RS 4.1-4.3 and the formal grammar of 4.2.1), rule for rule,
  written apart from repr/scheme's reader (arbace.repr.scheme.read, which reads as Chez Scheme 10.3.0 does in R6RS mode,
  and arbace.repr.scheme.number): the read check's own verdict for the probes (SCS5 (b), the user 2026-11-08;
  doc/scheme/SCHEME-SURVEY.md, \"As built: SCS5\"). Nothing here calls the reader; only the forms' spellings
  (arbace.repr.scheme.forms, doc/scheme/SPEC.md 3) are shared, as the comparison needs them.

    (read-all \"(a . 1.5) #\\\\x41\")
      => {:data [{:off [0 9] :form (scm/dot (a) 1.5)} {:off [10 15] :form \\A}] :error nil}
    (read-all \"(a\")     => {:data [] :error {:class :unexpected-eof :token false :at 2}}
    (read-all \"1@2\")    => {:data [{:off [0 3] :form (scm/complex -0.4161468365471424 0.9092974268256817)}] :error nil :choices #{:polar}}
    (binding [*choices* false] (read-all \"1@2\"))  => {:undecided \"a polar number ...\"}   ; the report alone
    (read-all \"#!fold-case A\") => {:data [{:off [12 13] :form a}] :error nil :choices #{:fold-case}}   ; si's choice, SPEC 12

  :error is a syntax violation: a text no production of the grammar derives. Its :class is :unexpected-eof (the text ends
  inside a datum, a lexeme or a comment), :unexpected-close, :bad-dot, :bad-string-escape, :bad-bytevector, or :token (a run
  of characters that is no lexeme, or a lexeme not followed by a delimiter: R6RS 4.2.1, \"must be terminated by a
  <delimiter> or by the end of the input\"); :token is the report's whole word on such a run (which of Chez's messages names
  it is Chez's). R6RS 4.1: \"An implementation must not extend the lexical or datum syntax in any way, with one exception: it
  need not treat the syntax #!<identifier>, for any <identifier> that is not r6rs, as a syntax violation\": so every
  extension of Chez's is a violation here, and #!<identifier> is :undecided.

  Since SCS10 (b) si's stated choices (doc/scheme/SPEC.md 12, *choices* below) decide most of what the report leaves open
  (the exponents beyond the limits stay :undecided; since SCS14 (b) the polar numbers are a choice too, :polar, by the correctly
  rounded cosine and sine below); with *choices* bound false, the report alone.
  Since SCS9 (c) the character classes are over the Unicode Character Database 16.0.0 (arbace.repr.scheme.category).

  :undecided names what the report leaves to the implementation, where the check falls back to Chez's recorded dump:
  #!<identifier> other than #!r6rs; an exact ratio with a zero denominator (1/0, #i1/0); #e on an infinity or a NaN (R6RS
  11.7.4.1's exact: no exact equivalent, the implementation's restriction); a mantissa width below 53 or with #e; a complex
  number whose parts differ in exactness (1+2.5i: R6RS keeps each part's, si's tower makes both inexact) unless the
  imaginary part is an exact zero (then the real, R6RS 11.7.4.1: (real? -2.5+0i) => #t); a polar number but for an exact
  zero angle (m@0 is m: the others need the transcendental functions' last bit, the implementation's); an exponent beyond
  10^5 for an exact number (the implementation's limits).

  Numbers are computed with exact arithmetic: an exact number is the exact value of its digits (R6RS 4.2.8: #e1.2 is 6/5),
  an inexact one the IEEE-754 binary64 nearest that exact value, ties to even (si's flonums are binary64, §4.2; R6RS 4.2.8:
  \"the best binary floating-point approximation\"), by nearest-double below, the report's own conversion (not the reader's
  ratio->double nor Java's parseDouble); -0.0 for a negative zero."
  (:require [arbace.repr.scheme.forms :as fm]
            [arbace.repr.scheme.category :as uc]
            [arbace.repr.scheme.casefold :as cf])
  (:import [java.math BigInteger]))

(set! *warn-on-reflection* true)

;; ---- outcomes

(defn- undecided [^String why] (throw (ex-info (str "undecided: " why) {::undecided why})))

;; ---- si's stated choices (SCS10 (b), the user 2026-11-08; doc/scheme/SPEC.md 12): where R6RS leaves the reading to the
;; implementation, the choices si's reader makes, stated as rules and applied here instead of leaving the text :undecided. Each
;; choice has an id (SPEC 12's); read-all reports the ids it applied (:choices). Bound to false, the report alone (SCS5's
;; :undecided cases), as report-check measures it.

(def ^:dynamic *choices*
  "Apply si's stated choices (SPEC 12) where the report defers: true by default (the read check's judge)."
  true)

(def ^:dynamic ^:private *applied* nil)
(def ^:dynamic ^:private *fold* nil)

(defn- choose
  "Where the report leaves `why` to the implementation: si's choice `id` (f's value) when *choices*, else :undecided."
  [id ^String why f]
  (if *choices*
    (do (when *applied* (vswap! *applied* conj id)) (f))
    (undecided why)))

(defn- no-number
  "si's choice (SPEC 12): the token is no number, so no lexeme: the run is a syntax violation (:token)."
  []
  (throw (ex-info "no number by si's choice" {::no-number true})))

(defn- violation
  "A syntax violation of class cls at offset at; end: the violating run reaches the end of the text."
  ([cls ^long at ^String why] (violation cls at why false))
  ([cls ^long at ^String why end] (throw (ex-info why {::class cls ::at at ::end end}))))

;; ---- characters (R6RS 4.2.1)

(defn- gc
  "The general category of cp in the Unicode Character Database 16.0.0 (arbace.repr.scheme.category, generated from the pinned
  database; SCS9 (c): not the host's tables, whose Unicode version is the JDK's)."
  ^String [^long cp] (uc/category cp))

(def ^:private whitespace-cats #{"Zs" "Zl" "Zp"})

(def ^:private constituent-cats
  "<constituent>'s categories above U+007F: Lu, Ll, Lt, Lm, Lo, Mn, Nl, No, Pd, Pc, Po, Sc, Sm, Sk, So, Co."
  #{"Lu" "Ll" "Lt" "Lm" "Lo" "Mn" "Nl" "No" "Pd" "Pc" "Po" "Sc" "Sm" "Sk" "So" "Co"})

(def ^:private subsequent-cats
  "<subsequent>'s further categories: Nd, Mc, Me."
  #{"Nd" "Mc" "Me"})

(defn- cps-of [^String s] (set (map #(long (int %)) s)))

(def ^:private special-initial (cps-of "!$%&*/:<=>?^_~"))
(def ^:private special-subsequent (cps-of "+-.@"))
(def ^:private line-end-starts #{10 13 0x85 0x2028})

(defn whitespace?
  "<whitespace>: tab, linefeed, line tabulation, form feed, carriage return, next line, or a character of Zs, Zl, Zp."
  [^long cp]
  (or (contains? #{9 10 11 12 13 0x85} cp) (contains? whitespace-cats (gc cp))))

(defn delimiter?
  "<delimiter>: ( ) [ ] \" ; # or <whitespace>."
  [^long cp]
  (or (contains? #{40 41 91 93 34 59 35} cp) (whitespace? cp)))

(defn- intraline? [^long cp] (or (== cp 9) (= (gc cp) "Zs")))
(defn- letter? [^long cp] (or (<= 97 cp 122) (<= 65 cp 90)))
(defn- digit? [^long cp] (<= 48 cp 57))
(defn- hex-digit? [^long cp] (or (digit? cp) (<= 97 cp 102) (<= 65 cp 70)))
(defn- constituent? [^long cp] (or (letter? cp) (and (> cp 127) (contains? constituent-cats (gc cp)))))
(defn- initial-char? [^long cp] (or (constituent? cp) (contains? special-initial cp)))
(defn- subsequent-char? [^long cp]
  (or (initial-char? cp) (digit? cp) (contains? subsequent-cats (gc cp)) (contains? special-subsequent cp)))

(defn initial?
  "<initial> (R6RS 4.2.1): a <constituent> (a letter, or above U+007F a character of the categories of constituent-cats, UCD 16.0.0's,
  arbace.repr.scheme.category) or a <special initial>; public for the lexical scans' measurement (SCS7 (c))."
  [^long cp] (initial-char? cp))

(defn subsequent?
  "<subsequent> (R6RS 4.2.1): an <initial>, a <digit>, a character of Nd, Mc or Me, or a <special subsequent>."
  [^long cp] (subsequent-char? cp))

;; ---- SCS17 (c) (the user 2026-11-09; doc/scheme/SPEC.md 7, :print-string, :print-char, :print-symbol): si's printer's escaping
;; rules, stated here over the same categories as the reader's classes (the judge of the four printing scans, no dump read) and
;; apart in arbace.repr.scheme.ucd (the printers' generated tables): R6RS 4.2.7 gives `write` no rule of its own, so these are si's
;; choices, Chez Scheme 10.3.0's (measured over every scalar value: equal), read back the same by the report's grammar.

(def ^:private written-char-names
  "The characters `write` names (R6RS 4.2.6's <character name>, Chez's spellings): nul alarm backspace tab newline vtab page return
  esc space delete."
  #{0 7 8 9 10 11 12 13 27 32 127})

(defn- c0-or-delete?
  "A control of the ASCII range: a character of Cc below U+0080 (U+0000 to U+001F and U+007F)."
  [^long cp] (and (< cp 128) (= "Cc" (gc cp))))

(defn written-hex-in-string?
  ":print-string: does `write` give the character `cp` of a string as \\xHEX; ? A C0 control or delete, or a character that starts an R6RS
  4.2.1 <line ending> (next line U+0085, line separator U+2028), that has no mnemonic escape (\\a \\b \\t \\n \\v \\f \\r: U+0007 to
  U+000D): a string written so keeps no line ending and no control (U+2029, Zp, is no <line ending>: written as itself)."
  [^long cp] (and (or (c0-or-delete? cp) (contains? line-end-starts cp)) (not (<= 7 cp 13))))

(defn written-escaped-in-string?
  ":print-string, the string-escaped scan's predicate: is the one-character string of `cp` written longer than three characters, its
  character escaped (\\\" and \\\\, a mnemonic escape, or \\xHEX;)?"
  [^long cp] (or (== cp 34) (== cp 92) (<= 7 cp 13) (written-hex-in-string? cp)))

(defn written-hex-char?
  ":print-char, the char-hex scan's predicate: does `write` give the character `cp` as #\\xHEX ? A C0 control or delete, or a character
  that starts a <line ending>, that has no name (written-char-names); every other character as itself after #\\."
  [^long cp] (and (or (c0-or-delete? cp) (contains? line-end-starts cp)) (not (contains? written-char-names cp))))

(defn written-escaped-symbol-first?
  ":print-symbol, the symbol-escaped-first scan's predicate: is the one-character symbol of `cp` written otherwise than its name? Unless
  it is a <peculiar identifier> (+, -), when it is no <initial>: written \\xHEX;."
  [^long cp] (and (not (contains? #{43 45} cp)) (not (initial? cp))))

(defn written-escaped-symbol-rest?
  ":print-symbol, the symbol-escaped-rest scan's predicate: is the symbol a<cp> written otherwise than its name? When `cp` is no
  <subsequent>."
  [^long cp] (not (subsequent? cp)))

(defn- scalar?
  "Is v a Unicode scalar value, 0 to #x10FFFF but #xD800 to #xDFFF (R6RS 4.2.1's <hex scalar value>)?"
  [^BigInteger v]
  (and (<= (.bitLength v) 21) (let [x (.longValue v)] (and (<= x 0x10FFFF) (not (<= 0xD800 x 0xDFFF))))))

(defn- hex-value ^BigInteger [t ^long i ^long j]
  (BigInteger. (String. (int-array (subvec t i j)) 0 (int (- j i))) 16))

(defn- text-of ^String [cps] (let [a (int-array cps)] (String. a 0 (alength a))))

;; ---- runs: the characters from i to the next delimiter, an inline hex escape \x41; whole (its semicolon no comment)

(defn- run-end
  "The end of the run of non-delimiters from i; an inline hex escape's ; is part of it."
  ^long [t ^long i]
  (let [n (count t)]
    (loop [j i]
      (cond (>= j n) j
            (and (== (t j) 92) (< (inc j) n) (== (t (inc j)) 120))
            (let [k (loop [k (+ j 2)] (if (and (< k n) (hex-digit? (t k))) (recur (inc k)) k))]
              (if (and (> k (+ j 2)) (< k n) (== (t k) 59)) (recur (long (inc k))) (recur (long (inc j)))))
            (delimiter? (t j)) j
            :else (recur (inc j))))))

(defn- token-violation
  "The run t[i, e) is no lexeme: a :token violation (the report's whole word), at the end of the text one that more text could
  have completed too (the check takes Chez's end-of-file there)."
  [t ^long i ^long e]
  (violation :token i (str "no lexeme: " (text-of (subvec t i e))) (>= e (count t))))

;; ---- identifiers (R6RS 4.2.4)

(defn identifier-name
  "The name the run t (code points) spells as an <identifier>: <initial> <subsequent>* or a <peculiar identifier> (+, -, ...,
  -> <subsequent>*), an <inline hex escape> standing for its character anywhere an <initial> may; nil when it spells none."
  [t]
  (let [n (count t)
        esc (fn [^long j]
              (when (and (< (inc j) n) (== (t j) 92) (== (t (inc j)) 120))
                (let [k (loop [k (+ j 2)] (if (and (< k n) (hex-digit? (t k))) (recur (inc k)) k))]
                  (when (and (> k (+ j 2)) (< k n) (== (t k) 59))
                    (let [v (hex-value t (+ j 2) k)] (when (scalar? v) [(.longValue v) (inc k)]))))))
        subs* (fn [^long j acc]
                (loop [j j acc acc]
                  (if (== j n)
                    acc
                    (if-let [[v e] (esc j)]
                      (recur (long e) (conj acc v))
                      (when (subsequent-char? (t j)) (recur (inc j) (conj acc (t j))))))))]
    (cond (zero? n) nil
          (= t [43]) "+"
          (= t [45]) "-"
          (= t [46 46 46]) "..."
          (and (>= n 2) (== (t 0) 45) (== (t 1) 62)) (some-> (subs* 2 [45 62]) text-of)
          :else (if-let [[v e] (esc 0)]
                  (some-> (subs* e [v]) text-of)
                  (when (initial-char? (t 0)) (some-> (subs* 1 [(t 0)]) text-of))))))

;; ---- numbers (R6RS 4.2.1's <number>, 4.2.8)

(defn nearest-double
  "The binary64 nearest the exact rational q (ties to even); +-Infinity when q's magnitude rounds beyond the largest finite
  double. Integer arithmetic only: a 53-bit significand q' and a binary exponent e with q' * 2^e the nearest, subnormals at
  e = -1074."
  ^double [q]
  (let [n0 (if (instance? arbace.lang.Ratio q) (biginteger (numerator q)) (biginteger q))
        d (if (instance? arbace.lang.Ratio q) (biginteger (denominator q)) BigInteger/ONE)]
    (if (zero? (.signum n0))
      0.0
      (let [neg (neg? (.signum n0))
            n (.abs n0)
            div (fn [^long e]   ; [quotient remainder divisor] of n / (d 2^e)
                  (if (>= e 0)
                    (let [dd (.shiftLeft d (int e)) qr (.divideAndRemainder n dd)] [(aget qr 0) (aget qr 1) dd])
                    (let [qr (.divideAndRemainder (.shiftLeft n (int (- e))) d)] [(aget qr 0) (aget qr 1) d])))
            two52 (.shiftLeft BigInteger/ONE 52)
            two53 (.shiftLeft BigInteger/ONE 53)
            e0 (- (- (.bitLength n) (.bitLength d)) 53)
            e1 (let [[q] (div e0)] (if (>= (.compareTo ^BigInteger q two53) 0) (inc e0) e0))
            e1 (let [[q] (div e1)] (if (< (.compareTo ^BigInteger q two52) 0) (dec e1) e1))
            e (max e1 -1074)
            [^BigInteger q ^BigInteger r ^BigInteger dv] (div e)
            c (.compareTo (.shiftLeft r 1) dv)
            q (if (or (pos? c) (and (zero? c) (.testBit q 0))) (.add q BigInteger/ONE) q)
            [q e] (if (>= (.compareTo ^BigInteger q two53) 0) [(.shiftRight ^BigInteger q 1) (inc e)] [q e])
            x (if (> (long e) 971) Double/POSITIVE_INFINITY (Math/scalb (.doubleValue ^BigInteger q) (int e)))]
        (if neg (- x) x)))))

;; ---- the correctly rounded cosine and sine (SCS14 (b), the user 2026-11-08; doc/scheme/SPEC.md 12 :polar)
;;
;; cr-cos and cr-sin give the binary64 nearest the exact cosine and sine of a binary64 x (ties cannot occur: the cosine and
;; the sine of a nonzero rational are transcendental, Lindemann), by integer arithmetic alone, Ziv's way: at a precision of P
;; bits after the point the value is computed with a proven bound E on its error (in units of 2^-P); when both ends of
;; [value - E, value + E] round to the same binary64 (rounding is monotone, so every value between them does too), that is
;; the answer, else P is doubled. The steps and their bounds (u = 2^-P, the unit of the last place kept):
;;   pi       Machin's 16 atan(1/5) - 4 atan(1/239), each a series of truncated terms (each term within 3 u of its own value,
;;            fewer than 2^40 terms), at Q + 64 bits and cut to Q: within 2 u(Q) of pi.
;;   reduce   x = M 2^E exactly; at Q = P + max(0, E + 53) + 8 bits, k the integer nearest x / (pi/2), r = x - k pi/2, cut to P:
;;            within |k| 2 u(Q) + 1 u(P) of the exact r, |k| 2 u(Q) <= 1 u(P) by Q's choice, so within 2 u; |r| < 0.8.
;;   series   sin r = r - r^3/3! + ..., cos r = 1 - r^2/2! + ..., each term from the one before by r^2 / (n (n + 1)), every
;;            product and quotient truncated: a term within 3 u of its value given r (the error of the one before halved at
;;            least, |r^2| / 2 < 1/2, plus 2), the tail after the last term (once a term is 0) at most 4 u, alternating
;;            and decreasing; so within 3 N + 4 u for N terms, and within 3 N + 4 + 2 u of the exact value (sin and cos
;;            move by at most |dr|).
;; x = +-0.0: sin x = x, cos x = 1.0; an infinity or a NaN: NaN (IEEE 754's).

(defn- pi-fixed
  "pi 2^q, truncated, within 2 of the exact pi 2^q (q >= 1)."
  ^BigInteger [^long q]
  (let [g (+ q 64)
        atan-inv (fn [^long n]   ; atan(1/n) 2^g, every term truncated
                   (let [nn (BigInteger/valueOf (* n n))]
                     (loop [pw (.divide (.shiftLeft BigInteger/ONE (int g)) (BigInteger/valueOf n)) k 0 acc BigInteger/ZERO]
                       (if (zero? (.signum pw))
                         acc
                         (let [term (.divide pw (BigInteger/valueOf (inc (* 2 k))))]
                           (recur (.divide pw nn) (inc k) (if (even? k) (.add acc term) (.subtract acc term))))))))]
    (let [^BigInteger a5 (atan-inv 5) ^BigInteger a239 (atan-inv 239)]
      (.shiftRight (.subtract (.multiply a5 (BigInteger/valueOf 16)) (.multiply a239 (BigInteger/valueOf 4))) 64))))

(def ^:private pi-cache (atom {}))
(defn- pi-at ^BigInteger [^long q] (or (@pi-cache q) (let [v (pi-fixed q)] (swap! pi-cache assoc q v) v)))

(defn- trig-at
  "[value bound] of sin x (which :sin) or cos x at precision p: value 2^p truncated and bound in units of 2^-p, x = m 2^e
  (m a nonzero BigInteger)."
  [which ^BigInteger m ^long e ^long p]
  (let [q (+ p (max 0 (+ e 53)) 8)
        xq (if (>= (+ e q) 0) (.shiftLeft m (int (+ e q))) (.shiftRight m (int (- (+ e q)))))
        hp (.shiftRight (pi-at q) 1)                ; pi/2 2^q, within 2
        qr (.divideAndRemainder xq hp)
        ^BigInteger k0 (aget qr 0) ^BigInteger rem (aget qr 1)
        ;; k the integer nearest x / (pi/2): the quotient, or one more (less) when the remainder passes half pi/2
        ^BigInteger k (cond (>= (.compareTo (.shiftLeft rem 1) hp) 0) (.add k0 BigInteger/ONE)
                            (<= (.compareTo (.shiftLeft rem 1) (.negate hp)) 0) (.subtract k0 BigInteger/ONE)
                            :else k0)
        rq (.subtract xq (.multiply k hp))
        ^BigInteger r (.shiftRight rq (int (- q p)))           ; floor: within 1 u(p) more
        one (.shiftLeft BigInteger/ONE (int p))
        r2 (.shiftRight (.multiply r r) (int p))
        series (fn [^BigInteger t0 ^long n0]        ; sum of t0, -t0 r^2/((n0+1)(n0+2)), ...: [sum terms]
                 (loop [t t0 n n0 acc BigInteger/ZERO cnt 0 plus true]
                   (if (zero? (.signum t))
                     [acc cnt]
                     (recur (.divide (.shiftRight (.multiply t r2) (int p)) (BigInteger/valueOf (* (inc n) (+ n 2))))
                            (+ n 2) (if plus (.add acc t) (.subtract acc t)) (inc cnt) (not plus)))))
        [s ns] (series r 1)
        [c nc] (series one 0)
        km (long (.intValue (.mod k (BigInteger/valueOf 4))))
        v (case which
            :sin (case km 0 s 1 c 2 (.negate ^BigInteger s) 3 (.negate ^BigInteger c))
            :cos (case km 0 c 1 (.negate ^BigInteger s) 2 (.negate ^BigInteger c) 3 s))]
    [v (+ (* 3 (max (long ns) (long nc))) 4 2 1)]))

(defn- trig-cr ^double [which ^double x]
  (cond
    (or (Double/isNaN x) (Double/isInfinite x)) Double/NaN
    (== x 0.0) (if (= which :sin) x 1.0)
    :else
    (let [bits (Double/doubleToRawLongBits x)
          be (bit-and (bit-shift-right bits 52) 0x7FF)
          fr (bit-and bits 0xFFFFFFFFFFFFF)
          [mant e] (if (zero? be) [fr -1074] [(bit-or fr 0x10000000000000) (- be 1075)])
          m (cond-> (BigInteger/valueOf mant) (neg? bits) .negate)
          ;; enough bits after the point for a tiny x's sine to keep 64 significant bits
          p0 (+ 128 (max 0 (- (+ e 53))))]
      (loop [p p0]
        (when (> p 100000) (throw (ex-info "trig-cr: no rounding decided below 100,000 bits" {:x x})))
        (let [[^BigInteger v ^long b] (trig-at which m e p)
              d (fn [^BigInteger y] (nearest-double (/ (bigint y) (bigint (.shiftLeft BigInteger/ONE (int p))))))
              lo (d (.subtract v (BigInteger/valueOf b)))
              hi (d (.add v (BigInteger/valueOf b)))]
          (if (and (== lo hi) (not (zero? lo))) lo (recur (* 2 p))))))))

(defn cr-cos "The binary64 nearest cos x, x a binary64 (SPEC 12 :polar)." ^double [^double x] (trig-cr :cos x))
(defn cr-sin "The binary64 nearest sin x, x a binary64 (SPEC 12 :polar)." ^double [^double x] (trig-cr :sin x))

(defn- digits-value ^BigInteger [t ^long i ^long j ^long radix]
  (if (== i j) BigInteger/ZERO (BigInteger. (text-of (subvec t i j)) (int radix))))

(defn- radix-digit? [^long cp ^long radix]
  (case radix 2 (<= 48 cp 49) 8 (<= 48 cp 55) 10 (digit? cp) 16 (hex-digit? cp)))

(defn- digits-end ^long [t ^long i ^long radix]
  (let [n (count t)] (loop [j i] (if (and (< j n) (radix-digit? (t j) radix)) (recur (inc j)) j))))

(def ^:private exponent-markers (cps-of "eEsSfFdDlL"))

(defn- ureal
  "<ureal R> at i: [part end] or nil. A part: {:kind :int :n BigInteger}, {:kind :rat :n :d}, {:kind :dec :value EXACT
  :width P-or-nil :inexact-syntax true} (<decimal 10> <mantissa width>: a point, an exponent or a width, radix 10 alone)."
  [t ^long i ^long radix]
  (let [n (count t)
        j (digits-end t i radix)
        int? (> j i)]
    (cond
      ;; <uinteger R> / <uinteger R>
      (and int? (< j n) (== (t j) 47) (> (digits-end t (inc j) radix) (inc j)))
      (let [k (digits-end t (inc j) radix)]
        [{:kind :rat :n (digits-value t i j radix) :d (digits-value t (inc j) k radix)} k])
      (== radix 10)
      (let [;; <uinteger 10>, <digit 10>+ . <digit 10>*, . <digit 10>+
            [frac-start frac-end point]
            (cond (and (< j n) (== (t j) 46) (or int? (and (< (inc j) n) (digit? (t (inc j))))))
                  [(inc j) (digits-end t (inc j) 10) true]
                  :else [j j false])]
        (when (or int? point)
          (let [k frac-end
                ;; <suffix>: <exponent marker> <sign> <digit 10>+
                [ex k] (if (and (< k n) (contains? exponent-markers (t k)))
                         (let [s (inc k)
                               s2 (if (and (< s n) (or (== (t s) 43) (== (t s) 45))) (inc s) s)
                               de (digits-end t s2 10)]
                           (if (> de s2)
                             [(let [v (digits-value t s2 de 10)
                                    v (if (> (.bitLength v) 40) (undecided "an exponent beyond the implementation's limits") (.longValue v))]
                                (if (and (> s2 s) (== (t s) 45)) (- v) v))
                              de]
                             [nil k]))
                         [nil k])
                ;; <mantissa width>: | <digit 10>+
                [w k] (if (and (< k n) (== (t k) 124) (> (digits-end t (inc k) 10) (inc k)))
                        (let [de (digits-end t (inc k) 10) v (digits-value t (inc k) de 10)]
                          [(if (> (.bitLength v) 31) Long/MAX_VALUE (.longValue v)) de])
                        [nil k])]
            (if (or point ex w)
              (let [mant (digits-value (into (subvec t i j) (subvec t frac-start frac-end)) 0 (+ (- j i) (- frac-end frac-start)) 10)
                    scale (- (long (or ex 0)) (- frac-end frac-start))]
                [{:kind :dec :mant mant :scale scale :width w :inexact-syntax true} k])
              [{:kind :int :n (digits-value t i j 10)} j]))))
      int? [{:kind :int :n (digits-value t i j radix)} j]
      :else nil)))

(defn- naninf
  "<naninf> at i (nan.0 or inf.0, as the grammar spells them): [part end] or nil."
  [t ^long i]
  (let [n (count t) s (when (<= (+ i 5) n) (text-of (subvec t i (+ i 5))))]
    (case s "nan.0" [{:kind :nan} (+ i 5)] "inf.0" [{:kind :inf} (+ i 5)] nil)))

(defn- real*
  "<real R> at i: <sign> <ureal R> | + <naninf> | - <naninf>: [part end] or nil, the part with :neg."
  [t ^long i ^long radix]
  (let [n (count t)
        signed (and (< i n) (or (== (t i) 43) (== (t i) 45)))
        neg (and signed (== (t i) 45))
        j (if signed (inc i) i)]
    (or (when signed (when-let [[p e] (naninf t j)] [(assoc p :neg neg) e]))
        (when-let [[p e] (ureal t j radix)] [(assoc p :neg neg) e]))))

(defn- signed-ureal-i
  "+ <ureal R> i, - <ureal R> i, + <naninf> i, - <naninf> i, + i, - i at i, ending the token: the imaginary part or nil."
  [t ^long i ^long radix]
  (let [n (count t)]
    (when (and (< i n) (or (== (t i) 43) (== (t i) 45)) (== (t (dec n)) 105))
      (let [neg (== (t i) 45)]
        (if (== (inc i) (dec n))
          {:kind :int :n BigInteger/ONE :neg neg}
          (when-let [[p e] (or (naninf t (inc i)) (ureal t (inc i) radix))]
            (when (== (long e) (dec n)) (assoc p :neg neg))))))))

(defn- complex*
  "<complex R>: the whole token t as {:real P}, {:rect [RE IM]} (RE nil when the token has none) or {:polar [M A]}; nil
  when no production derives it."
  [t ^long radix]
  (let [n (count t)]
    (or (when-let [[p e] (real* t 0 radix)]
          (let [e (long e)]
            (cond (== e n) {:real p}
                  (== (t e) 64) (when-let [[a e2] (real* t (inc e) radix)] (when (== (long e2) n) {:polar [p a]}))
                  :else (when-let [im (signed-ureal-i t e radix)] {:rect [p im]}))))
        (when-let [im (signed-ureal-i t 0 radix)] {:rect [nil im]}))))

(defn- exact-value
  "The exact rational a part stands for."
  [{:keys [kind n d mant scale neg]}]
  (let [v (case kind
            :int (bigint n)
            :rat (if (zero? (.signum ^BigInteger d))
                   (choose :ratio-over-zero "an exact ratio with a zero denominator" no-number)
                   (/ (bigint n) (bigint d)))
            :dec (let [s (long scale)]
                   (when (> (Math/abs s) 100000) (undecided "an exponent beyond the implementation's limits"))
                   (if (>= s 0) (bigint (.multiply ^BigInteger mant (.pow BigInteger/TEN (int s))))
                       (/ (bigint mant) (bigint (.pow BigInteger/TEN (int (- s))))))))]
    (if neg (- v) v)))

(defn- inexact-value
  "The binary64 a part stands for: its exact value's nearest, or an infinity or a NaN; a negative zero for -0."
  ^double [{:keys [kind neg mant scale] :as p}]
  (case kind
    :nan Double/NaN
    :inf (if neg Double/NEGATIVE_INFINITY Double/POSITIVE_INFINITY)
    (if (and (= kind :rat) (zero? (.signum ^BigInteger (:d p))))
      ;; SPEC 12 :ratio-over-zero: an inexact n/0 is the binary64 quotient, +inf.0 or -inf.0 by the sign, 0/0 +nan.0
      (choose :ratio-over-zero "an exact ratio with a zero denominator"
              #(cond (zero? (.signum ^BigInteger (:n p))) Double/NaN neg Double/NEGATIVE_INFINITY :else Double/POSITIVE_INFINITY))
    (let [big? (and (= kind :dec) (pos? (.signum ^BigInteger mant))
                    (let [k (+ (long scale) (count (str mant)))]   ; 10^(k-1) <= |value| < 10^k
                      (cond (> k 310) :inf (< k -330) :zero :else nil)))]
      (case big?
        :inf (if neg Double/NEGATIVE_INFINITY Double/POSITIVE_INFINITY)
        :zero (if neg -0.0 0.0)
        (let [x (nearest-double (exact-value (dissoc p :neg)))] (if neg (- x) x)))))))

(defn- part-value
  "A part's value under the prefix's exactness ex (:e, :i or nil): [exact? value]."
  [{:keys [kind width inexact-syntax] :as p} ex]
  (let [inexact (case ex :e false :i true (boolean (or inexact-syntax (#{:nan :inf} kind))))]
    ;; SPEC 12 :mantissa-width: a mantissa width is read and ignored (si's flonums have 53 bits: R6RS 4.2.8 allows the greater
    ;; precision; with #e the exact value of the digits)
    (when (and width (= ex :e)) (choose :mantissa-width "a mantissa width with #e" (constantly nil)))
    (when (and width (< (long width) 53)) (choose :mantissa-width "a mantissa width below 53" (constantly nil)))
    (if inexact
      [false (inexact-value p)]
      (do (when (#{:nan :inf} kind) (choose :exact-naninf "#e on an infinity or a NaN: no exact equivalent (R6RS 11.7.4.1)" no-number))
          (let [v (exact-value p)] [true (if (and (integer? v) (< (.bitLength (biginteger v)) 64)) (long v) v)])))))

(declare number-value*)

(defn number-value
  "The value of the number token t (code points, prefixes included) as the forms' numbers (a long, a BigInt, a Ratio, a
  double, or [:complex re im]); nil when no production derives it, or (SPEC 12) when si's choice makes it no number. Throws
  :undecided where the report leaves it open and *choices* is false (or no choice is stated: an exponent beyond the limits)."
  [t]
  (try (number-value* t)
       (catch arbace.lang.ExceptionInfo ex (if (::no-number (ex-data ex)) nil (throw ex)))))

(defn- number-value* [t]
  (let [n (count t)]
    (loop [i 0 radix nil ex nil]
      (if (and (< (inc i) n) (== (t i) 35))
        (let [c (Character/toLowerCase (int (t (inc i))))]
          (case (long c)
            (120 98 111 100) (when-not radix (recur (+ i 2) ({120 16 98 2 111 8 100 10} (long c)) ex))
            (101 105) (when-not ex (recur (+ i 2) radix ({101 :e 105 :i} (long c))))
            nil))
        (let [body (subvec t i)]
          (when (and (seq body) (not= (first body) 35))
            (when-let [c (complex* body (or radix 10))]
              (cond
                (:real c) (second (part-value (:real c) ex))
                (:polar c) (let [[m a] (:polar c) [ae av] (part-value a ex) [me mv] (part-value m ex)]
                             (if (and ae (zero? av))
                               mv
                               ;; SPEC 12 :polar (SCS14 (b)): an exact zero magnitude the exact 0; #e otherwise no number (no exact
                               ;; equivalent); else m cos a + i m sin a in binary64, the parts' nearest binary64 taken, the cosine and
                               ;; the sine correctly rounded, each product rounded once
                               (choose :polar "a polar number with an angle other than an exact zero"
                                       #(cond (and me (zero? mv)) 0
                                              (= ex :e) (no-number)
                                              :else (let [d (fn [x] (if (instance? Double x) x (nearest-double x)))
                                                          md (double (d mv)) ad (double (d av))]
                                                      [:complex (* md (cr-cos ad)) (* md (cr-sin ad))])))))
                :else (let [[re im] (:rect c)
                            [ie iv] (part-value im ex)
                            [re' rv] (if re (part-value re ex) [(not= ex :i) (if (= ex :i) 0.0 0)])]
                        (cond (and ie (zero? iv)) rv
                              (and re' ie) [:complex rv iv]
                              (and (not re') (not ie)) [:complex rv iv]
                              ;; SPEC 12 :mixed-exactness: both parts inexact, an exact part its nearest binary64 (si's tower, SM5)
                              :else (choose :mixed-exactness "a complex number whose parts differ in exactness"
                                            #(let [d (fn [x] (if (instance? Double x) x (nearest-double x)))]
                                               [:complex (d rv) (d iv)]))))))))))))

;; ---- the datum reader (R6RS 4.2, 4.3)

(def ^:private char-names
  {"nul" 0 "alarm" 7 "backspace" 8 "tab" 9 "linefeed" 10 "newline" 10 "vtab" 11 "page" 12 "return" 13 "esc" 27 "space" 32 "delete" 127})

(declare datum)

(defn- eof [^long at what] (violation :unexpected-eof at (str "the text ends inside " what)))

(defn- skip-atmosphere
  "<interlexeme space> from i: whitespace, ; comments (to a line ending or paragraph separator), nested comments, #;
  <interlexeme space> <datum>, #!r6rs; the index after it."
  ^long [t ^long i]
  (let [n (count t)]
    (loop [i i]
      (if (>= i n)
        i
        (let [c (t i)]
          (cond
            (whitespace? c) (recur (inc i))
            (== c 59) (recur (long (loop [j (inc i)] (if (and (< j n) (not (contains? line-end-starts (t j))) (not= (t j) 0x2029)) (recur (inc j)) j))))
            (and (== c 35) (< (inc i) n) (== (t (inc i)) 124))
            (recur (long (loop [j (+ i 2) depth 1]
                     (cond (>= (inc j) n) (eof i "a nested comment")
                           (and (== (t j) 124) (== (t (inc j)) 35)) (if (== depth 1) (+ j 2) (recur (+ j 2) (dec depth)))
                           (and (== (t j) 35) (== (t (inc j)) 124)) (recur (+ j 2) (inc depth))
                           :else (recur (inc j) depth)))))
            (and (== c 35) (< (inc i) n) (== (t (inc i)) 59))
            (let [j (skip-atmosphere t (+ i 2))]
              (when (>= j n) (eof i "a datum comment"))
              (recur (long (second (datum t j)))))
            (and (== c 35) (< (inc i) n) (== (t (inc i)) 33))
            (let [e (run-end t (+ i 2)) tok (subvec t (+ i 2) e)]
              (cond (= tok [114 54 114 115]) (recur (long e))   ; #!r6rs
                    (and (empty? tok) (>= e n)) (eof i "#!")
                    (identifier-name tok)
                    (let [nm (text-of tok) why (str "#!" nm ": the implementation's (R6RS 4.1)")]
                      (case nm
                        ;; SPEC 12 :fold-case: #!fold-case folds the identifiers and the character names after it (full case
                        ;; folding, CaseFolding.txt's C and F: arbace.repr.scheme.casefold, SCS12 (c)), #!no-fold-case stops it
                        ("fold-case" "no-fold-case")
                        (do (choose :fold-case why #(when *fold* (vreset! *fold* (= nm "fold-case")))) (recur (long e)))
                        ;; SPEC 12 :hash-bang (SCS12 (c)): #!chezscheme is taken and has no effect on the reading
                        "chezscheme" (do (choose :hash-bang why (constantly nil)) (recur (long e)))
                        ;; SPEC 12 :hash-bang: any other #!<identifier> is a syntax violation
                        (choose :hash-bang why #(token-violation t i e))))
                    :else (token-violation t i e)))
            :else i))))))

(defn- string-datum
  "<string> at i (its \"): [string end]."
  [t ^long i]
  (let [n (count t) sb (StringBuilder.)
        app (fn [^long cp] (.appendCodePoint sb (int cp)))]
    (loop [j (inc i)]
      (when (>= j n) (eof i "a string"))
      (let [c (t j)]
        (cond
          (== c 34) [(.toString sb) (inc j)]
          (== c 92)
          (do (when (>= (inc j) n) (eof i "a string"))
              (let [d (t (inc j))]
                (if-let [v ({97 7 98 8 116 9 110 10 118 11 102 12 114 13 34 34 92 92} d)]
                  (do (app v) (recur (+ j 2)))
                  (if (== d 120)
                    (let [k (digits-end t (+ j 2) 16)]
                      (cond (>= k n) (eof i "a string")
                            (or (== k (+ j 2)) (not= (t k) 59)) (violation :bad-string-escape j "a \\x escape without its digits and ;")
                            :else (let [v (hex-value t (+ j 2) k)]
                                    (when-not (scalar? v) (violation :bad-string-escape j "a \\x escape of no scalar value"))
                                    (app (.longValue v)) (recur (long (inc k))))))
                    ;; \<intraline whitespace>*<line ending><intraline whitespace>*
                    (let [k (loop [k (inc j)] (if (and (< k n) (intraline? (t k))) (recur (inc k)) k))]
                      (cond (>= k n) (eof i "a string")
                            (contains? line-end-starts (t k))
                            (let [k (if (and (== (t k) 13) (< (inc k) n) (or (== (t (inc k)) 10) (== (t (inc k)) 0x85))) (+ k 2) (inc k))]
                              (recur (long (loop [k k] (if (and (< k n) (intraline? (t k))) (recur (inc k)) k)))))
                          :else (violation :bad-string-escape j "no escape of the report")))))))
          ;; a line ending stands for a linefeed (R6RS 4.2.7)
          (== c 13) (do (app 10) (recur (if (and (< (inc j) n) (or (== (t (inc j)) 10) (== (t (inc j)) 0x85))) (+ j 2) (inc j))))
          (or (== c 0x85) (== c 0x2028)) (do (app 10) (recur (inc j)))
          :else (do (app c) (recur (inc j))))))))

(defn- char-datum
  "<character> at i (its #\\): #\\<any char>, #\\<character name>, #\\x<hex scalar value>, ended by a delimiter: [form end]."
  [t ^long i]
  (let [n (count t) j (+ i 2)]
    (when (>= j n) (eof i "a character"))
    (let [e (run-end t (inc j))]
      (if (== e (inc j))
        [(fm/char-form (t j)) e]
        (let [nm (subvec t j e)]
          ;; SPEC 12 :fold-case: after #!fold-case a <character name> is folded (R7RS 2.1; Chez); the x of a hex scalar value is not
          (if-let [v (char-names (cond-> (text-of nm) (and *fold* @*fold*) cf/fold))]
            [(fm/char-form v) e]
            (if (and (== (t j) 120) (every? hex-digit? (subvec nm 1)))
              (let [v (hex-value nm 1 (count nm))]
                (if (scalar? v) [(fm/char-form (.longValue v)) e] (token-violation t i e)))
              (token-violation t i e))))))))

(defn- seq-datum
  "The data from i (after the opening) to the closing code point close: [items tail dot?]; dot-ok: a . <datum> may end it."
  [t ^long i ^long close dot-ok what]
  (let [n (count t)]
    (loop [j i items []]
      (let [j (skip-atmosphere t j)]
        (when (>= j n) (eof j what))
        (let [c (t j)]
          (cond
            (== c close) [items nil false (inc j)]
            (or (== c 41) (== c 93)) (violation :unexpected-close j "a closing that does not match the opening")
            (and (== c 46) (== (run-end t j) (inc j)))
            (do (when (or (not dot-ok) (empty? items)) (violation :bad-dot j "a . where the grammar has none"))
                (let [k (skip-atmosphere t (inc j))]
                  (when (>= k n) (eof k what))
                  (when (or (== (t k) 41) (== (t k) 93)) (violation :bad-dot k "a . with no datum after it"))
                  (let [[tail k2] (datum t k)
                        k3 (skip-atmosphere t k2)]
                    (when (>= k3 n) (eof k3 what))
                    (if (== (t k3) close)
                      [items tail true (inc k3)]
                      (violation :bad-dot k3 "more than one datum after a .")))))
            :else (let [[f e] (datum t j)] (recur (long e) (conj items f)))))))))

(defn- abbreviation [t ^long i ^long k sym]
  (let [j (skip-atmosphere t (+ i k))]
    (when (>= j (count t)) (eof i "an abbreviation"))
    (let [[f e] (datum t j)] [(list sym f) e])))

(defn- token-datum
  "An identifier, a number or a boolean run from i: [form end]."
  [t ^long i]
  (let [e (run-end t i) tok (subvec t i e)]
    (cond
      (= tok [46]) (violation :bad-dot i "a . where the grammar has none")
      :else
      (let [c (first tok)
            v (when (or (digit? c) (== c 43) (== c 45) (== c 46)) (number-value tok))]
        (if (some? v)
          [(fm/number-form v) e]
          (if-let [nm (identifier-name tok)]
            [(fm/sym (if (and *fold* @*fold*) (cf/fold nm) nm)) e]
            (if (and (>= e (count t)) (re-find #"\\x[0-9a-fA-F]*$" (text-of tok)))
              (eof i "an inline hex escape")
              (token-violation t i e))))))))

(defn- datum
  "<datum> at i (no atmosphere before it): [form end]."
  [t ^long i]
  (let [n (count t) c (t i) at (fn [^long k] (when (< k n) (t k)))]
    (cond
      (or (== c 40) (== c 91))
      (let [[items tail dot? e] (seq-datum t (inc i) (if (== c 40) 41 93) true "a list")]
        [(if dot? (fm/dotted items tail) (apply list items)) e])
      (or (== c 41) (== c 93)) (violation :unexpected-close i "a closing with no opening")
      (== c 34) (string-datum t i)
      (== c 39) (abbreviation t i 1 'quote)
      (== c 96) (abbreviation t i 1 'quasiquote)
      (== c 44) (if (= (at (inc i)) 64) (abbreviation t i 2 'unquote-splicing) (abbreviation t i 1 'unquote))
      (== c 35)
      (let [d (at (inc i))]
        (cond
          (nil? d) (eof i "a # lexeme")
          (== d 40) (let [[items _ _ e] (seq-datum t (+ i 2) 41 false "a vector")] [(vec items) e])
          (== d 92) (char-datum t i)
          (== d 39) (abbreviation t i 2 'syntax)
          (== d 96) (abbreviation t i 2 'quasisyntax)
          (== d 44) (if (= (at (+ i 2)) 64) (abbreviation t i 3 'unsyntax-splicing) (abbreviation t i 2 'unsyntax))
          (= (subvec t (inc i) (min n (+ i 5))) [118 117 56 40])   ; #vu8(
          (let [[items _ _ e] (seq-datum t (+ i 5) 41 false "a bytevector")]
            (doseq [x items]
              (when-not (and (or (instance? Long x) (instance? Integer x)) (<= 0 (long x) 255))
                (violation :bad-bytevector i "a bytevector element that is no exact integer from 0 to 255")))
            [(apply list fm/bytevector-tag items) e])
          (contains? #{116 102 84 70} d)   ; <boolean>: #t #T #f #F, then a delimiter
          (let [e (run-end t (inc i))]
            (if (== e (+ i 2)) [(contains? #{116 84} d) e] (token-violation t i e)))
          (contains? (cps-of "eEiIxXbBoOdD") d)
          (let [j (loop [j i] (if (and (< (inc j) n) (== (t j) 35) (contains? (cps-of "eEiIxXbBoOdD") (t (inc j)))) (recur (+ j 2)) j))
                e (run-end t j)
                v (number-value (subvec t i e))]
            (if (some? v) [(fm/number-form v) e] (token-violation t i e)))
          :else (token-violation t i (max (+ i 2) (run-end t (inc i))))))
      :else (token-datum t i))))

(declare read-all*)

(defn read-all
  "What the report says the text s reads as: {:data [{:off [start end] :form F}] :error nil}, {:data [...] :error {:class K
  :at OFFSET :end BOOL}} (the data before a syntax violation; :end, the violating run reaches the end of the text), or
  {:undecided REASON}. Offsets in characters (Unicode scalar values)."
  [^String s]
  (binding [*applied* (volatile! #{}) *fold* (volatile! false)]
    (let [r (read-all* s)] (if (and (seq @*applied*) (not (:undecided r))) (assoc r :choices @*applied*) r))))

(defn- read-all* [^String s]
  (let [t (vec (.toArray (.codePoints s)))
        n (count t)]
    (loop [i 0 acc []]
      (let [r (try
                (let [j (skip-atmosphere t i)]
                  (if (>= j n) :done (let [[f e] (datum t j)] {:off [j e] :form f})))
                (catch arbace.lang.ExceptionInfo ex
                  (let [m (ex-data ex)]
                    (cond (::undecided m) {:undecided (::undecided m)}
                          (::class m) {:error {:class (::class m) :at (::at m) :end (::end m) :message (ex-message ex)}}
                          :else (throw ex)))))]
        (cond (= r :done) {:data acc :error nil}
              (:undecided r) r
              (:error r) {:data acc :error (:error r)}
              :else (recur (long (second (:off r))) (conj acc r)))))))

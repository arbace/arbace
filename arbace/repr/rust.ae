(ns arbace.repr.rust
  "Command line of repr/rust (doc/rust/SPEC.md, doc/rust/RUST-NOTES.md), run by bin/repr-rust as
  -m arbace.repr.rust VERB ...:

    read [--jobs N] [-o DIR] [--report FILE] [--only REGEX] [--corpus FILE]
         [--crate NAME --crate-type T --ns-root NS] (--root DIR | DUMP...)
        each helper dump (tools/rsdump) to Rust forms: DIR/rs/CRATE/PATH.ae (SPEC §2.1), read back
        and compared with the forms in memory (every bare name, path, literal and form checked,
        principle 3). With --root, the dumps are ROOT/FILE.edn, FILE the path rustc was given
        (CRATE-DIR/src/...), each file's crate and configuration from the corpus file; without a
        corpus, the crate NAME (default main) and type, the namespace NS-ROOT + the file's path.
    print [--jobs N] [-o DIR] [--layout lines|pretty|full] (--root DIR | FORMS.ae...)
        the printer (SPEC §9.4): each forms file to DIR/PATH, PATH its rs/file's :path; mode
        :lines' layout, the pretty layout of the forms without their positions (RR4), or the full
        layout of mode :full's forms (RR3).
    compare --corpus FILE --orig DIR --cand DIR --known FILE --report FILE [--forms-report FILE]
            [--only REGEX] [--times TEXT] [--trees-only]
        the round trip's tree level (SPEC §11.2): for each file of the corpus, the helper's tree and
        lines of the original (ORIG/FILE.tree, .lines) against the printed file's
        (CAND.trees/FILE.tree, .lines); the known differences FILE (a map from FILE to its reason)
        excuse a file, and a listed file that no longer differs is a failure. --trees-only: the
        trees alone (the pretty layout's lines are its own).
    compare-iface (--corpus FILE | --crates C,...) --orig DIR --cand DIR [--known FILE]
                  [--report FILE] [--only REGEX] [--prune] [--times TEXT]
        the round trip's interface level (SPEC §11.1, §11.3; RR2): for each crate C of the corpus
        that has an :iface (each of --crates),
        rustdoc's JSON of the originals (ORIG/C/C.json) against the printed files' (CAND/C/C.json),
        compared as text once every span is removed (span fields, and the spans rustc's Debug writes
        in attributes' texts); the known differences FILE (a map from the crate's name to its
        reason) excuse a crate, and a listed crate found equal is a failure."
  (:require [arbace.repr.rust.convert :as cv]
            [arbace.repr.rust.write :as wr]
            [arbace.repr.rust.print :as pr]
            [arbace.repr.rust.syntax :as sx]
            [arbace.repr.rust.full :as fu]
            [arbace.string :as str])
  (:import [java.io File]))

(defn- parse-args
  "{:opts {...} :args [...]}; flags with a value: those in with-value"
  [args with-value]
  (loop [as args opts {} pos []]
    (if (empty? as)
      {:opts opts :args pos}
      (let [[a & more] as]
        (cond
          (contains? with-value a) (recur (rest more) (assoc opts a (first more)) pos)
          (str/starts-with? a "--") (recur more (assoc opts a true) pos)
          :else (recur more opts (conj pos a)))))))

(defn- files-under [^String dir ext]
  (->> (file-seq (File. dir))
       (filter #(and (.isFile ^File %) (str/ends-with? (.getName ^File %) ext)))
       (map #(.getPath ^File %))
       sort))

(defn- rel [^String root ^String path]
  (let [r (str (.getCanonicalPath (File. root)) "/")
        p (.getCanonicalPath (File. path))]
    (if (str/starts-with? p r) (subs p (count r)) path)))

(defn- pmap-jobs
  "f over xs on n threads, in order"
  [n f xs]
  (let [xs (vec xs)
        pool (java.util.concurrent.Executors/newFixedThreadPool (max 1 n))
        futs (mapv (fn [x] (.submit pool ^java.util.concurrent.Callable (fn [] (f x)))) xs)
        res (mapv #(.get ^java.util.concurrent.Future %) futs)]
    (.shutdown pool)
    res))

(defn ns-path
  "The forms file of a namespace (SPEC §2.1): its segments munged, rs/core/num/dec2flt.ae"
  [ns-sym]
  (str (str/join "/" (map #(str (munge %)) (str/split (str ns-sym) #"\."))) ".ae"))

(defn- dumped [dump sym]
  (some #(when (and (seq? %) (= sym (first %))) (second %)) dump))

(defn- read-pin
  "tools/rsdump/RUSTC_VERSION's pins: {:rustc :commit :driver}"
  [^String f]
  (when (and f (.exists (File. f)))
    (into {} (for [l (str/split-lines (slurp f))
                   :let [[k v] (str/split (str/trim l) #"\s+" 2)]
                   :when v]
               [(keyword (if (= k "version") "rustc" k)) v]))))

(def ^:private files-index
  "{file crate} of a corpus (its crates' :files), made once per corpus"
  (memoize (fn [corpus] (into {} (for [c (reverse (:crates corpus)) f (:files c)] [f c])))))

(defn crate-of
  "The corpus's crate of a file (its path as rustc was given it), with the file's kind: the crate
  that lists it among its files (the UI suite's crates, one per edition, share a directory: RR5),
  else whose directory is the longest that holds it (a package nested in another's directory)"
  [corpus ^String file]
  (when corpus
    (when-let [c (or (get (files-index corpus) file)
                     (last (sort-by #(count (:dir %)) (filter #(str/starts-with? file (str (:dir %) "/")) (:crates corpus)))))]
      (let [r (subs file (inc (count (:dir c))))]
        (assoc c :rel r
                 :kind (cond
                         (contains? (set (:roots c)) file) :root
                         (contains? (set (:path-files c)) file) :path
                         (contains? (set (:include-files c)) file) :include
                         :else nil))))))

(defn read-dump
  "Converts one dump: {:dump :ns :out :status :error :warnings :forms}"
  [dump-path out-file-fn corpus opts]
  (try
    (let [text (slurp dump-path)
          dump (read-string (str "[" text "]"))
          cfg (dumped dump 'rsdump/config)
          file (:file cfg)
          c (crate-of corpus file)
          full (get opts "--full")
          src (fu/source (slurp (:abs cfg)))
          src-lines (vec (str/split (:text src) #"\n" -1))
          conf (if c
                 {:crate (:name c) :crate-type (:crate-type c) :kind (:kind c) :rel (:rel c)
                  :corpus (:name corpus) :ns-crate (:ns-crate c)
                  :has-lib (contains? (set (:files c)) (str (:dir c) "/src/lib.rs"))}
                 {:crate (get opts "--crate" "main") :crate-type (get opts "--crate-type")
                  :rel file :ns-root (get opts "--ns-root")})
          {:keys [ns forms warnings comments]} (cv/convert-file dump (assoc conf :src-lines src-lines :pin (read-pin (get opts "--pin"))
                                                                 :full full :src src))
          ns (if-let [r (:ns-root conf)]
               (symbol (str r "." (str/replace (str/replace file #"\.rs$" "") #"[/]" ".")))
               ns)
          forms (if (:ns-root conf)
                  (assoc forms 0 (list 'ns ns (list :require ['arbace.rust :as 'rs])))
                  forms)
          out (out-file-fn ns)
          ftext (wr/with-comments (wr/forms-text forms) comments)
          d (wr/check forms ftext)]
      (.mkdirs (.getParentFile (File. ^String out)))
      (spit out ftext)
      (if d
        {:dump dump-path :ns ns :out out :status :misread :error (pr-str d) :warnings warnings}
        {:dump dump-path :ns ns :out out :status :ok :warnings warnings :forms (count forms)}))
    (catch Throwable e
      {:dump dump-path :status :error :error (or (.getMessage e) (str e))})))

(defn- cmd-read [args]
  (let [{:keys [opts args]} (parse-args args #{"--jobs" "-o" "--report" "--root" "--only" "--corpus"
                                               "--crate" "--crate-type" "--ns-root" "--pin"})
        jobs (Long/parseLong (get opts "--jobs" "8"))
        out (get opts "-o" ".tmp/repr-rust/forms/files")
        root (get opts "--root")
        corpus (when-let [f (get opts "--corpus")] (read-string (slurp f)))
        only (some-> (get opts "--only") re-pattern)
        dumps (if root (files-under root ".edn") args)
        dumps (if only (filter #(re-find only (str %)) dumps) dumps)
        t0 (System/currentTimeMillis)
        results (pmap-jobs jobs (fn [d]
                                  (let [r (read-dump d (fn [ns] (str out "/" (ns-path ns))) corpus opts)]
                                    (assoc r :file (if root (str/replace (rel root d) #"\.edn$" "") (.getName (File. ^String d))))))
                           dumps)
        t1 (System/currentTimeMillis)
        ;; two files of one conversion that map to one namespace (SPEC §2.1): an error each
        clash (set (for [[ns rs] (group-by :ns (filter :ns results)) :when (> (count rs) 1) r rs] (:dump r)))
        results (mapv #(if (contains? clash (:dump %))
                         (assoc % :status :error :error (str "another file of the conversion maps to the namespace " (:ns %)))
                         %)
                      results)
        by (group-by :status results)
        warnings (apply merge-with + (map :warnings results))]
    (doseq [r results :when (not= :ok (:status r))]
      (println (name (:status r)) (:dump r) (:error r)))
    (println (format "repr-rust read: %d dumps, %d converted, %d misread, %d failed, %d forms, in %.1f s"
                     (count results) (count (:ok by)) (count (:misread by)) (count (:error by))
                     (reduce + (keep :forms results)) (/ (- t1 t0) 1000.0)))
    (doseq [[k n] (sort-by (comp - val) warnings)] (println "warning" (pr-str k) n))
    (when-let [rep (get opts "--report")]
      (spit rep (with-out-str
                  (prn {:dumps (count results) :ok (count (:ok by)) :misread (count (:misread by))
                        :errors (count (:error by)) :seconds (/ (- t1 t0) 1000.0)
                        :forms (reduce + (keep :forms results))
                        :warnings warnings
                        :files (into (sorted-map) (for [r results] [(:file r)
                                                                    (cond-> {:status (:status r)}
                                                                      (:ns r) (assoc :ns (str (:ns r)) :out (:out r))
                                                                      (:error r) (assoc :error (:error r)))]))}))))
    (if (= (count results) (count (:ok by))) 0 1)))

(defn- cmd-print [args]
  (let [{:keys [opts args]} (parse-args args #{"--jobs" "-o" "--root" "--only" "--layout"})
        layout (get opts "--layout" "lines")
        _ (when-not (contains? #{"lines" "full" "pretty"} layout) (throw (ex-info (str "print: no layout " layout " (lines, pretty, full)") {})))
        print-fn (case layout "full" pr/print-full "pretty" pr/print-pretty pr/print-file)
        jobs (Long/parseLong (get opts "--jobs" "8"))
        out (get opts "-o" ".tmp/repr-rust/printed")
        root (get opts "--root")
        only (some-> (get opts "--only") re-pattern)
        files (if root (files-under root ".ae") args)
        files (if only (filter #(re-find only (str %)) files) files)
        t0 (System/currentTimeMillis)
        results (pmap-jobs jobs
                           (fn [f]
                             (try
                               (let [forms (wr/read-all (slurp f))
                                     {:keys [path text]} (binding [pr/*warnings* (atom {})] (print-fn forms))
                                     o (str out "/" path)]
                                 (.mkdirs (.getParentFile (File. ^String o)))
                                 (spit o text)
                                 {:file f :status :ok :out o})
                               (catch Throwable e
                                 {:file f :status :error :error (or (.getMessage e) (str e))})))
                           files)
        t1 (System/currentTimeMillis)
        bad (remove #(= :ok (:status %)) results)]
    (doseq [r bad] (println "error" (:file r) (:error r)))
    (println (format "repr-rust print: %d forms files, %d printed, %d failed, in %.1f s"
                     (count results) (- (count results) (count bad)) (count bad) (/ (- t1 t0) 1000.0)))
    (if (empty? bad) 0 1)))

;;; The round trip's comparison

(defn- read-lines-file [^String f]
  (when (.exists (File. f)) (str/split-lines (slurp f))))

(defn- first-line-diff
  "The first difference between two line vectors: [index a b]"
  [a b]
  (let [n (max (count a) (count b))]
    (loop [i 0]
      (when (< i n)
        (let [x (get a i) y (get b i)]
          (if (= x y) (recur (inc i)) [i x y]))))))

(defn- context-of [lines i]
  (str/join "\n" (subvec lines (max 0 (- i 8)) (min (count lines) (+ i 4)))))

(defn- line-eq?
  "Two lines of rsdump's .lines equal, or a dummy span (- NAME: no location) against a real one
  (N1, SPEC §11.2: an empty span at the file's first byte is rustc's dummy span, RR5)"
  [^String a ^String b]
  (or (= a b)
      (and a b (or (str/starts-with? a "- ") (str/starts-with? b "- "))
           (= (subs a (inc (.indexOf a " "))) (subs b (inc (.indexOf b " ")))))))

(defn- lines-eq? [ol cl]
  (and (= (count ol) (count cl)) (every? true? (map line-eq? ol cl))))

(defn compare-file
  "The tree level of one file: {:status :ok} or {:level :tree|:lines :status ...}; without
  lines (the pretty layout's, which has its own), the trees alone"
  [orig-tree cand-tree orig-lines cand-lines & [no-lines]]
  (let [ot (some-> (read-lines-file orig-tree) vec)
        ct (some-> (read-lines-file cand-tree) vec)
        ol (when-not no-lines (some-> (read-lines-file orig-lines) vec))
        cl (when-not no-lines (some-> (read-lines-file cand-lines) vec))]
    (cond
      (nil? ot) {:level :tree :status :no-original}
      (str/starts-with? (or (first ot) "") "rsdump/error") {:level :tree :status :original-fails-to-parse :detail (first ot)}
      (nil? ct) {:level :tree :status :not-printed}
      (str/starts-with? (or (first ct) "") "rsdump/error") {:level :tree :status :printed-fails-to-parse :detail (first ct)}
      (not= ot ct) (let [[i a b] (first-line-diff ot ct)]
                     {:level :tree :status :differs :at i :detail (context-of ot i) :cand (context-of ct i)})
      (not (lines-eq? ol cl)) (let [[i a b] (first-line-diff ol cl)
                         n (count (filter (fn [[x y]] (not (line-eq? x y))) (map vector ol cl)))]
                     {:level :lines :status :differs :at i :orig a :cand b :count n})
      :else {:status :ok :spans (count (or ol (read-lines-file orig-lines)))})))

(defn- cmd-compare [args]
  (let [{:keys [opts]} (parse-args args #{"--corpus" "--orig" "--cand" "--known" "--report" "--forms-report" "--only" "--times"})
        corpus (read-string (slurp (get opts "--corpus")))
        orig (get opts "--orig")
        cand (get opts "--cand")
        known-file (get opts "--known")
        known (if (and known-file (.exists (File. ^String known-file))) (read-string (slurp known-file)) {})
        only (some-> (get opts "--only") re-pattern)
        forms-report (when-let [f (get opts "--forms-report")] (when (.exists (File. ^String f)) (read-string (slurp f))))
        files (for [c (:crates corpus) f (:files c)
                    :when (or (nil? only) (re-find only f))]
                f)
        results (pmap-jobs 16
                           (fn [f]
                             (let [conv (get-in forms-report [:files f])]
                               [f (if (and conv (not= :ok (:status conv)))
                                    {:level :convert :status (:status conv) :detail (:error conv)}
                                    (compare-file (str orig "/" f ".tree") (str cand ".trees/" f ".tree")
                                                  (str orig "/" f ".lines") (str cand ".trees/" f ".lines")
                                                  (get opts "--trees-only")))]))
                           files)
        ok (filter #(= :ok (:status (second %))) results)
        failing (remove #(= :ok (:status (second %))) results)
        unexpected (remove #(contains? known (first %)) failing)
        fixed (filter #(and (contains? known (first %)) (= :ok (:status (second %)))) results)
        by-level (frequencies (map (comp :level second) failing))]
    (when (get opts "--prune")
      ;; the trees of the files found equal removed (the scratch stays small)
      (doseq [[f _] ok
              x [(str orig "/" f ".tree") (str orig "/" f ".lines") (str cand ".trees/" f ".tree") (str cand ".trees/" f ".lines")]]
        (.delete (File. ^String x))))
    (doseq [[i [k r]] (map-indexed vector unexpected)]
      (println "DIFFERS" k (pr-str (dissoc r :detail :cand)))
      (when (< i 10)
        (when (:detail r) (println "  original:\n" (:detail r)))
        (when (:cand r) (println "  printed:\n" (:cand r)))))
    (doseq [[k _] fixed] (println "FIXED (listed as known, no longer differs)" k))
    (doseq [[k r] failing :when (contains? known k)] (println "known" k (pr-str (select-keys r [:level :status])) "--" (get known k)))
    (println (format "repr-rust roundtrip (tree level): %d files, %d equal (%s; %d spans), %d differ (%s), %d known, %d unexpected, %d fixed%s"
                     (count results) (count ok) (if (get opts "--trees-only") "trees" "trees and lines")
                     (reduce + (keep (comp :spans second) ok)) (count failing) (pr-str by-level)
                     (count (filter #(contains? known (first %)) failing)) (count unexpected) (count fixed)
                     (if-let [t (get opts "--times")] (str "; seconds: " t) "")))
    (when-let [rep (get opts "--report")]
      (spit rep (with-out-str
                  (prn {:files (count results) :equal (count ok) :differ (count failing)
                        :spans (reduce + (keep (comp :spans second) ok))
                        :by-level by-level :unexpected (mapv first unexpected) :fixed (mapv first fixed)
                        :times (get opts "--times")
                        :results (into (sorted-map) (for [[k r] results] [k (dissoc r :detail :cand)]))}))))
    (if (and (empty? unexpected) (empty? fixed)) 0 1)))

;;; The text level (SPEC §11.1, §11.3; RR3)

(defn- first-byte-diff [^bytes a ^bytes b]
  (let [n (min (alength a) (alength b))]
    (loop [i 0] (cond (= i n) (when (not= (alength a) (alength b)) n)
                      (= (aget a i) (aget b i)) (recur (inc i))
                      :else i))))

(defn compare-text-file
  "The text level of one file: the printed file byte for byte the original"
  [^String orig ^String cand]
  (let [o (File. orig) k (File. cand)]
    (cond
      (not (.exists o)) {:status :no-original}
      (not (.exists k)) {:status :not-printed}
      :else
      (let [a (java.nio.file.Files/readAllBytes (.toPath o))
            b (java.nio.file.Files/readAllBytes (.toPath k))]
        (if (java.util.Arrays/equals a b)
          {:status :ok :bytes (alength a)}
          (let [i (first-byte-diff a b)
                ctx (fn [^bytes x] (let [s (String. x "UTF-8")
                                         j (min (count s) i)]
                                     (subs s (max 0 (- j 120)) (min (count s) (+ j 120)))))]
            {:status :differs :at i :bytes [(alength a) (alength b)] :orig (ctx a) :cand (ctx b)}))))))

(defn- cmd-compare-text [args]
  (let [{:keys [opts]} (parse-args args #{"--corpus" "--orig" "--cand" "--known" "--report" "--forms-report" "--only" "--times"})
        corpus (read-string (slurp (get opts "--corpus")))
        orig (get opts "--orig")
        cand (get opts "--cand")
        known-file (get opts "--known")
        known (if (and known-file (.exists (File. ^String known-file))) (read-string (slurp known-file)) {})
        only (some-> (get opts "--only") re-pattern)
        forms-report (when-let [f (get opts "--forms-report")] (when (.exists (File. ^String f)) (read-string (slurp f))))
        files (for [c (:crates corpus) f (:files c) :when (or (nil? only) (re-find only f))] f)
        results (pmap-jobs 16
                           (fn [f]
                             (let [conv (get-in forms-report [:files f])]
                               [f (if (and conv (not= :ok (:status conv)))
                                    {:status (:status conv) :detail (:error conv)}
                                    (compare-text-file (str orig "/" f) (str cand "/" f)))]))
                           files)
        ok (filter #(= :ok (:status (second %))) results)
        failing (remove #(= :ok (:status (second %))) results)
        unexpected (remove #(contains? known (first %)) failing)
        fixed (filter #(and (contains? known (first %)) (= :ok (:status (second %)))) results)]
    (doseq [[i [k r]] (map-indexed vector unexpected)]
      (println "DIFFERS" k (pr-str (dissoc r :orig :cand :detail)))
      (when (< i 10)
        (when (:detail r) (println " " (:detail r)))
        (when (:orig r) (println "  original:\n" (:orig r) "\n  printed:\n" (:cand r)))))
    (doseq [[k _] fixed] (println "FIXED (listed as known, no longer differs)" k))
    (doseq [[k r] failing :when (contains? known k)] (println "known" k (pr-str (select-keys r [:status])) "--" (get known k)))
    (println (format "repr-rust roundtrip (text level): %d files, %d byte-identical (%d bytes), %d differ, %d known, %d unexpected, %d fixed%s"
                     (count results) (count ok) (reduce + (keep (comp :bytes second) ok)) (count failing)
                     (count (filter #(contains? known (first %)) failing)) (count unexpected) (count fixed)
                     (if-let [t (get opts "--times")] (str "; seconds: " t) "")))
    (when-let [rep (get opts "--report")]
      (spit rep (with-out-str
                  (prn {:files (count results) :identical (count ok) :differ (count failing)
                        :bytes (reduce + (keep (comp :bytes second) ok))
                        :unexpected (mapv first unexpected) :fixed (mapv first fixed)
                        :times (get opts "--times")
                        :results (into (sorted-map) (for [[k r] results] [k (dissoc r :orig :cand)]))}))))
    (if (and (empty? unexpected) (empty? fixed)) 0 1)))

;;; The interface level (SPEC §11.1, §11.3; RR2)

(defn- string-end
  "The index of the quote that closes the JSON string whose text begins at p"
  [^String s p]
  (loop [k (.indexOf s "\"" (int p))]
    (if (neg? k)
      (count s)
      (let [bs (loop [b 0] (if (= \\ (.charAt s (int (- k b 1)))) (recur (inc b)) b))]
        (if (even? bs) k (recur (.indexOf s "\"" (int (inc k)))))))))

(defn- digits-back
  "The index of the first of the digits that end just before i (i when none)"
  [^String s i]
  (loop [j i] (if (and (pos? j) (Character/isDigit (.charAt s (int (dec j))))) (recur (dec j)) j)))

(defn- span-text-start
  "The start of the span rustc's Debug writes, PATH:L:C: L:C, that ends just before i, or nil"
  [^String s i]
  (let [at (fn [j c] (and (pos? j) (= c (.charAt s (int (dec j))))))
        num (fn [j] (let [k (digits-back s j)] (when (< k j) k)))]
    (when-let [a (num i)]
      (when (at a \:)
        (when-let [b (num (dec a))]
          (when (and (at b \space) (at (dec b) \:))
            (when-let [c (num (- b 2))]
              (when (at c \:)
                (when-let [d (num (dec c))]
                  (when (at d \:)
                    (let [p (loop [j (dec d)]
                              (if (and (pos? j) (not (contains? #{\space \" \( \[ \{ \, \\} (.charAt s (int (dec j))))))
                                (recur (dec j)) j))]
                      (when (< p (dec d)) p))))))))))))

(defn strip-debug-spans
  "The spans rustc's Debug writes inside the texts of attributes (\"other\":\"#[attr = CfgTrace(...
  span: core/src/os/mod.rs:18:5: 18:8 (#0) ...)]\"): each PATH:L:C: L:C (#N) written _. [text n]"
  [^String s]
  (let [sb (StringBuilder. (count s)) n (count s)]
    (loop [from 0 cnt 0 i (.indexOf s " (#" (int 0))]
      (if (neg? i)
        (do (.append sb s (int from) (int n)) [(str sb) cnt])
        (let [q (loop [q (+ i 3)] (if (and (< q n) (Character/isDigit (.charAt s (int q)))) (recur (inc q)) q))
              p (when (and (> q (+ i 3)) (< q n) (= \) (.charAt s (int q)))) (span-text-start s i))]
          (if (and p (>= p from))
            (do (.append sb s (int from) (int p)) (.append sb "_")
                (recur (inc q) (inc cnt) (.indexOf s " (#" (int (inc q)))))
            (recur from cnt (.indexOf s " (#" (int (inc i))))))))))

(defn strip-spans
  "rustdoc's JSON without its span fields (SPEC §11.3, E4): every member \"span\":null or
  \"span\":{\"filename\":\"...\",\"begin\":[l,c],\"end\":[l,c]} (a key: after { or ,) removed with
  the comma after it; then the spans inside attributes' texts (strip-debug-spans). {:text :spans
  :debug-spans :items}, :items the index's items ({\"id\":N,\"crate_id\":...)"
  [^String s]
  (let [sb (StringBuilder. (count s))
        k "\"span\":"
        n (count s)]
    (loop [from 0 spans 0]
      (let [i (.indexOf s k (int from))]
        (if (neg? i)
          (do (.append sb s (int from) (int n))
              (let [[t debug] (strip-debug-spans (str sb))
                    items (loop [p 0 c 0]
                            (let [j (.indexOf t "{\"id\":" (int p))]
                              (if (neg? j)
                                c
                                (let [q (loop [q (+ j 6)] (if (and (< q (count t)) (Character/isDigit (.charAt t (int q)))) (recur (inc q)) q))]
                                  (recur (inc j) (if (.startsWith t ",\"crate_id\":" (int q)) (inc c) c))))))]
                {:text t :spans spans :debug-spans debug :items items}))
          (let [j (+ i (count k))
                key? (and (pos? i) (contains? #{\{ \,} (.charAt s (int (dec i)))))
                end (when key?
                      (cond
                        (.startsWith s "null" (int j)) (+ j 4)
                        (.startsWith s "{\"filename\":\"" (int j))
                        (let [e (.indexOf s "}" (int (string-end s (+ j 13))))]
                          (when-not (neg? e) (inc e)))
                        :else nil))]
            (if end
              (let [end (if (and (< end n) (= \, (.charAt s (int end)))) (inc end) end)]
                (.append sb s (int from) (int i))
                (recur end (inc spans)))
              (do (.append sb s (int from) (int j))
                  (recur j spans)))))))))

(defn- first-diff-at [^String a ^String b]
  (let [n (min (count a) (count b))]
    (loop [i 0] (cond (= i n) (when (not= (count a) (count b)) n)
                      (= (.charAt a (int i)) (.charAt b (int i))) (recur (inc i))
                      :else i))))

(defn- item-at
  "The index's item a position of the normalized JSON falls in: its id, and the text around"
  [^String t i]
  (let [j (.lastIndexOf t "{\"id\":" (int i))]
    {:id (when-not (neg? j) (second (re-find #"^\{\"id\":(\d+)" (subs t j (min (count t) (+ j 24))))))
     :text (subs t (max 0 (- i 200)) (min (count t) (+ i 200)))}))

(defn compare-crate
  "The interface level of one crate: ORIG/C/C.json against CAND/C/C.json (rustdoc's logs
  C.log beside them), spans removed"
  [orig cand c]
  (let [jf (fn [d] (File. (str d "/" c "/" c ".json")))
        log (fn [d] (let [f (File. (str d "/" c "/" c ".log"))]
                      (when (.exists f) (let [ls (str/split-lines (slurp f))] (str/join "\n" (take 12 ls))))))
        o (jf orig) k (jf cand)]
    (cond
      (not (.exists o)) {:status :original-fails :detail (log orig)}
      (not (.exists k)) {:status :printed-fails :detail (log cand)}
      :else
      (let [a (strip-spans (slurp o))
            b (strip-spans (slurp k))]
        (if (= (:text a) (:text b))
          {:status :ok :items (:items a) :spans (:spans a) :debug-spans (:debug-spans a) :bytes (count (:text a))}
          (let [i (first-diff-at (:text a) (:text b))]
            {:status :differs :at i :items [(:items a) (:items b)] :spans [(:spans a) (:spans b)]
             :debug-spans [(:debug-spans a) (:debug-spans b)]
             :orig (item-at (:text a) i) :cand (item-at (:text b) i)}))))))

(defn- cmd-compare-iface [args]
  (let [{:keys [opts]} (parse-args args #{"--corpus" "--crates" "--orig" "--cand" "--known" "--report" "--only" "--times"})
        corpus (if-let [f (get opts "--corpus")]
                 (read-string (slurp f))
                 {:crates (for [n (str/split (get opts "--crates" "") #",")] {:name n})})
        orig (get opts "--orig")
        cand (get opts "--cand")
        known-file (get opts "--known")
        known (if (and known-file (.exists (File. ^String known-file))) (read-string (slurp known-file)) {})
        only (some-> (get opts "--only") re-pattern)
        ;; the crates the corpus documents (:iface; all of them with --crates)
        crates (for [c (:crates corpus) :let [n (str (:name c))]
                     :when (and (or (:iface c) (get opts "--crates")) (or (nil? only) (re-find only n)))]
                 n)
        results (pmap-jobs 5 (fn [c] [c (compare-crate orig cand c)]) crates)
        ok (filter #(= :ok (:status (second %))) results)
        failing (remove #(= :ok (:status (second %))) results)
        unexpected (remove #(contains? known (first %)) failing)
        fixed (filter #(and (contains? known (first %)) (= :ok (:status (second %)))) results)]
    (when (get opts "--prune")
      (doseq [[c _] ok d [orig cand]] (.delete (File. (str d "/" c "/" c ".json")))))
    (doseq [[c r] results :when (= :ok (:status r))]
      (println (format "ok %s: %d items, %d span fields and %d spans in attributes' texts removed, %d bytes equal"
                       c (:items r) (:spans r) (:debug-spans r) (:bytes r))))
    (doseq [[c r] unexpected]
      (println "DIFFERS" c (pr-str (dissoc r :detail :orig :cand)))
      (when (:detail r) (println " " (:detail r)))
      (when (:orig r) (println "  original, item" (:id (:orig r)) ":\n" (:text (:orig r))))
      (when (:cand r) (println "  printed, item" (:id (:cand r)) ":\n" (:text (:cand r)))))
    (doseq [[c _] fixed] (println "FIXED (listed as known, no longer differs)" c))
    (doseq [[c r] failing :when (contains? known c)] (println "known" c (pr-str (select-keys r [:status])) "--" (get known c)))
    (println (format "repr-rust roundtrip (interface level): %d crates, %d equal (%d items; rustdoc's JSON without spans), %d differ, %d known, %d unexpected, %d fixed%s"
                     (count results) (count ok) (reduce + (keep (comp :items second) ok)) (count failing)
                     (count (filter #(contains? known (first %)) failing)) (count unexpected) (count fixed)
                     (if-let [t (get opts "--times")] (str "; seconds: " t) "")))
    (when-let [rep (get opts "--report")]
      (spit rep (with-out-str
                  (prn {:crates (count results) :equal (count ok) :differ (count failing)
                        :items (reduce + (keep (comp :items second) ok))
                        :unexpected (mapv first unexpected) :fixed (mapv first fixed)
                        :times (get opts "--times")
                        :results (into (sorted-map) results)}))))
    (if (and (empty? unexpected) (empty? fixed)) 0 1)))

;;; The behaviour level (SPEC §11.1, 5; RR5)

(defn run-plan
  "The behaviour level's plan of a corpus's :programs (bin/lib/repr-rust/run-program's PLAN): one
  line per program, its fields separated by the character 0x1f (unit separator): id (FILE, FILE#REV for a revision), file, edition, compile
  flags, run flags, the run's environment, the compiler's environment (items space-separated, a
  space inside an item written as the escape \\x20)"
  [corpus only]
  (let [esc (fn [x] (str/replace (str x) " " "\\x20"))
        j (fn [xs] (str/join " " (map esc xs)))
        kv (fn [ps] (j (for [[k v] ps] (str k "=" v))))]
    (str/join (for [p (:programs corpus)
                    :let [id (str (:file p) (when (:rev p) (str "#" (:rev p))))]
                    :when (or (nil? only) (re-find only id))]
                (str (str/join "\u001f" [id (:file p) (:edition p) (j (:flags p)) (j (:run-flags p)) (kv (:exec-env p)) (kv (:rustc-env p))])
                     "\n")))))

(defn- cmd-run-plan [args]
  (let [{:keys [opts]} (parse-args args #{"--corpus" "--only" "-o"})
        corpus (read-string (slurp (get opts "--corpus")))]
    (spit (get opts "-o") (run-plan corpus (some-> (get opts "--only") re-pattern)))
    0))

(defn- cmd-compare-run
  "The behaviour level's results (run-program's lines: STATUS SIDE ID DETAIL) against the known
  differences of each side (KNOWN-SIDE-known.edn: a map from a program's id to its reason): a
  program that differs, fails to build or was not printed fails unless listed, and a listed one
  found the same is a failure; nondeterministic programs (their own runs differ) and those whose
  baseline does not build or times out are counted, not judged"
  [args]
  (let [{:keys [opts]} (parse-args args #{"--results" "--known" "--report" "--times" "--sides" "--level"})
        lines (remove str/blank? (str/split-lines (slurp (get opts "--results"))))
        rows (for [l lines :let [[st side id detail] (str/split l #"\t" -1)]] {:status st :side side :id id :detail detail})
        skips (filter #(= "skip" (:status %)) rows)
        sides (str/split (get opts "--sides") #",")
        level (get opts "--level" "behaviour level")
        reports
        (vec (for [side sides]
               (let [rs (filter #(= side (:side %)) rows)
                     kf (str (get opts "--known") "-" side "-known.edn")
                     known (if (.exists (File. ^String kf)) (read-string (slurp kf)) {})
                     failing (filter #(contains? #{"differs" "build-fail" "missing"} (:status %)) rs)
                     unexpected (remove #(contains? known (:id %)) failing)
                     fixed (filter #(and (contains? known (:id %)) (str/starts-with? (:status %) "same")) rs)
                     by (frequencies (map :status rs))]
                 (doseq [[i r] (map-indexed vector unexpected)]
                   (println "DIFFERS" side (:id r) (:status r) (:detail r)))
                 (doseq [r fixed] (println "FIXED (listed as known, now the same)" side (:id r)))
                 (doseq [r failing :when (contains? known (:id r))] (println "known" side (:id r) (:status r) "--" (get known (:id r))))
                 (println (format "repr-rust roundtrip (%s, %s): %d programs, %d the same (%d of them once the source locations' %s are normalized), %d nondeterministic, %d differ, %d fail to build, %d not printed, %d known, %d unexpected, %d fixed; %d not judged (their baseline does not build or times out)%s"
                                  level side (+ (count rs) (count skips))
                                  (+ (get by "same" 0) (get by "same-cols" 0) (get by "same-pos" 0)) (+ (get by "same-cols" 0) (get by "same-pos" 0))
                                  (if (pos? (get by "same-pos" 0)) "lines and columns" "columns")
                                  (get by "nondet" 0) (get by "differs" 0)
                                  (get by "build-fail" 0) (get by "missing" 0)
                                  (count (filter #(contains? known (:id %)) failing)) (count unexpected) (count fixed) (count skips)
                                  (if-let [t (get opts "--times")] (str "; seconds: " t) "")))
                 {:side side :by-status by :unexpected (mapv :id unexpected) :fixed (mapv :id fixed)
                  :results (into (sorted-map) (for [r rs] [(:id r) (cond-> {:status (keyword (:status r))} (not (str/blank? (:detail r))) (assoc :detail (:detail r)))]))})))]
    (when-let [rep (get opts "--report")]
      (spit rep (with-out-str
                  (prn {:times (get opts "--times")
                        :skipped (into (sorted-map) (for [r skips] [(:id r) (:detail r)]))
                        :sides reports}))))
    (if (every? #(and (empty? (:unexpected %)) (empty? (:fixed %))) reports) 0 1)))

(defn -main [& args]
  (let [[verb & more] args
        status (try
                 (case verb
                   "read" (cmd-read more)
                   "print" (cmd-print more)
                   "compare" (cmd-compare more)
                   "compare-iface" (cmd-compare-iface more)
                   "compare-text" (cmd-compare-text more)
                   "run-plan" (cmd-run-plan more)
                   "compare-run" (cmd-compare-run more)
                   (do (println "usage: -m arbace.repr.rust read|print|compare|compare-iface|compare-text|run-plan|compare-run ...") 2))
                 (catch Throwable e
                   (.printStackTrace e)
                   1))]
    (shutdown-agents)
    (flush)
    (System/exit status)))

(ns arbace.repr.asm.amd64.att
  "repr/asm's AT&T syntax for amd64 (doc/asm/SPEC.md §5): an instruction's text into its form and back, after LLVM's
  X86AsmParser (llvm-project 23.1.5, llvm/lib/Target/X86/AsmParser/X86AsmParser.cpp, Apache-2.0 WITH LLVM-exception)
  for the operands' grammar. AX1 reads the syntax: the mnemonic as written (lower case; the table of AX2 resolves it to
  the machine's opcode and width), the operands in the reverse of the text's order (the SDM's, destination first).

  (MNEMONIC {:pseudo [\"vex3\" ...] :prefix [lock ...]} OPERAND ...), the map only when not empty. An operand:
  (reg NAME) or (reg st N) for %st(N), with a map of its decorations {:k K :z true}; (imm E) for $E; (mem {:seg S :disp E
  :base B :index I :scale E :bcst N}) with only the parts written (a bare expression is (mem {:disp E})); (ind X) for *X;
  (rc \"TEXT\") a standalone {TEXT} (rounding: {rn-sae}, {sae})."
  (:require [arbace.repr.asm.lex :as lex]
            [arbace.repr.asm.gnu :as gnu]
            [arbace.string :as str]))

(set! *warn-on-reflection* true)

(def prefixes #{"lock" "rep" "repe" "repz" "repne" "repnz" "notrack" "data16" "data32" "addr16" "addr32" "addr64"
                "rex" "rex64" "xacquire" "xrelease" "bnd" "cs" "ds" "es" "fs" "gs" "ss"})

(defn- tok [ts ^long i] (when (< i (count ts)) (nth ts i)))

(defn- brace-text
  "[TEXT I] the text between `{` at `i` and its `}`."
  [^String src ts ^long i]
  (let [j (loop [j (inc i)] (cond (>= j (count ts)) (gnu/fail "expected }" {:at i})
                                  (lex/punct? (nth ts j) "}") j
                                  :else (recur (inc j))))]
    (when (= j (inc i)) (gnu/fail "empty {}" {:at i}))
    [(str/trim (subs src (int (lex/end (nth ts i))) (int (lex/start (nth ts j))))) (inc j)]))

(defn- reg-name [t]
  (when-not (and t (= :ident (lex/kind t))) (gnu/fail "expected a register" {}))
  (symbol (str/lower-case (lex/value t))))

(defn- parse-reg
  "[FORM I] the register whose % is at `i`."
  [ts ^long i]
  (let [r (reg-name (tok ts (inc i)))
        j (+ i 2)]
    (if (and (= r 'st) (lex/punct? (tok ts j) "(") (= :int (lex/kind (tok ts (inc j)))) (lex/punct? (tok ts (+ j 2)) ")"))
      [(list 'reg 'st (lex/value (tok ts (inc j)))) (+ j 3)]
      [(list 'reg r) j])))

(defn- base-index
  "[MAP I] the `(base,index,scale)` whose ( is at `i`."
  [ts ^long i]
  (let [reg-at (fn [j] (when (lex/punct? (tok ts j) "%") (let [[r k] (parse-reg ts j)] [(second r) k])))
        ;; an index named by an equated symbol (v_eax = %eax; (,v_eax,2)): (asm/eq NAME)
        idx-at (fn [j] (or (reg-at j)
                           (let [t (tok ts j)]
                             (when (and t (= :ident (lex/kind t)) (#{"," ")"} (some-> (tok ts (inc j)) lex/value)))
                               [(list 'asm/eq (gnu/sym-form (lex/value t))) (inc j)]))))
        [b j] (or (idx-at (inc i)) [nil (inc i)])
        m (if b {:base b} {})]
    (cond
      (lex/punct? (tok ts j) ")") [m (inc j)]
      (lex/punct? (tok ts j) ",")
      (let [[x k] (or (idx-at (inc j)) [nil (inc j)])
            m (if x (assoc m :index x) m)]
        (cond
          (lex/punct? (tok ts k) ")") [(if x m (assoc m :comma 1)) (inc k)]
          (lex/punct? (tok ts k) ",")
          (if (lex/punct? (tok ts (inc k)) ")")
            [(assoc m :comma 2) (+ k 2)]
            (let [[s l] (gnu/parse-expr ts (inc k) false)]
              (if (lex/punct? (tok ts l) ")") [(assoc m :scale s) (inc l)] (gnu/fail "expected ) after the scale" {:at l}))))
          (not x)
          ;; (%esi, 2): the scale without an index (LLVM takes it)
          (let [[s l] (gnu/parse-expr ts k false)]
            (if (lex/punct? (tok ts l) ")") [(assoc m :scale s) (inc l)] (gnu/fail "expected ) after the scale" {:at l})))
          :else (gnu/fail "expected , or )" {:at k})))
      :else (gnu/fail "expected , or ) in a memory operand" {:at j}))))

(defn- parse-mem
  "[FORM I] a memory operand at `i`, `m` its parts so far (a segment)."
  [ts ^long i m]
  (let [t (tok ts i)
        bi? (and (lex/punct? t "(") (let [n (tok ts (inc i))]
                                      (or (lex/punct? n "%") (lex/punct? n ",")
                                          (and n (= :ident (lex/kind n)) (lex/punct? (tok ts (+ i 2)) ",")))))
        [m j] (if (or bi? (nil? t) (lex/punct? t ","))
                [m i]
                (let [[e j] (gnu/parse-expr ts i false)] [(assoc m :disp e) j]))
        ;; v_gs:(,) with v_gs = %gs: a segment named by a symbol
        [m j] (if (and (symbol? (:disp m)) (not (:seg m)) (lex/punct? (tok ts j) ":"))
                (let [[x k] (parse-mem ts (inc j) {:segsym (:disp m)})] [(second x) k])
                [m j])
        [m j] (if (lex/punct? (tok ts j) "(")
                (let [[bm k] (base-index ts j)] [(merge m bm) k])
                [m j])]
    (when (= m {}) (gnu/fail "expected an operand" {:at i}))
    [(list 'mem m) j]))

(defn- decorate
  "[FORM I] the operand `x` with the decorations ({%k1} {z} {1to16}) that follow it at `i`."
  [^String src ts x ^long i]
  (loop [x x i i]
    (if (lex/punct? (tok ts i) "{")
      (let [[t j] (brace-text src ts i)
            [k v] (cond
                    (.startsWith ^String t "%") [:k (symbol (str/lower-case (subs t 1)))]
                    (re-matches #"[kK][0-7]" t) [:k (symbol (str/lower-case t))]
                    (= t "z") [:z true]
                    (re-matches #"1to[0-9]+" t) [:bcst (Long/parseLong (subs t 3))]
                    :else (gnu/fail (str "unknown decoration {" t "}") {:at i}))
            x (if (= 'mem (first x))
                (list 'mem (assoc (second x) k v))
                (let [m (if (map? (last x)) (last x) {})
                      base (if (map? (last x)) (butlast x) x)]
                  (concat base [(assoc m k v)])))]
        (recur (apply list x) (long j)))
      [x i])))

(defn parse-operand
  "[FORM I] the operand at `i`."
  [^String src ts ^long i]
  (let [t (tok ts i)
        [x j] (cond
                (lex/punct? t "*") (let [[x j] (parse-operand src ts (inc i))] [(list 'ind x) j])
                (lex/punct? t "$") (let [[e j] (gnu/parse-expr ts (inc i) false)] [(list 'imm e) j])
                (lex/punct? t "{") (let [[s j] (brace-text src ts i)] [(list 'rc s) j])
                (lex/punct? t "%")
                (let [[r j] (parse-reg ts i)]
                  (cond
                    (and (lex/punct? (tok ts j) ":") (lex/punct? (tok ts (inc j)) "*"))
                    ;; ljmp %cs:*ADDR: the indirect jump's memory with its segment
                    (let [[m k] (parse-mem ts (+ j 2) {:seg (second r)})] [(list 'ind m) k])
                    (lex/punct? (tok ts j) ":") (parse-mem ts (inc j) {:seg (second r)})
                    :else [r j]))
                :else (parse-mem ts i {}))]
    (if (= 'ind (first x)) [x j] (decorate src ts x j))))

(defn read-insn
  "An instruction's form from the statement's tokens `ts` at `i`."
  [^String src ts ^long i]
  (let [[pseudo i] (loop [ps [] i i]
                     (if (lex/punct? (tok ts i) "{")
                       (let [[t j] (brace-text src ts i)] (recur (conj ps t) (long j)))
                       [ps i]))
        [pfx i] (loop [ps [] i i]
                  (let [t (tok ts i) n (tok ts (inc i))]
                    (cond
                      (and t (= :ident (lex/kind t)) (prefixes (str/lower-case (lex/value t)))
                           n (= :ident (lex/kind n)))
                      (recur (conj ps (symbol (str/lower-case (lex/value t)))) (inc i))
                      ;; lock/incl: a prefix and its instruction joined by /
                      (and t (= :ident (lex/kind t)) (prefixes (str/lower-case (lex/value t)))
                           (lex/punct? n "/") (= :ident (some-> (tok ts (+ i 2)) lex/kind)))
                      (recur (conj ps (symbol (str/lower-case (lex/value t)))) (+ i 2))
                      :else [ps i])))
        t (tok ts i)
        _ (when-not (and t (= :ident (lex/kind t))) (gnu/fail "expected a mnemonic" {:at i}))
        mn (symbol (str/lower-case (lex/value t)))
        ops (loop [i (inc i) ops []]
              (if (>= i (count ts))
                ops
                (let [[x j] (parse-operand src ts i)
                      n (tok ts j)]
                  (cond
                    (nil? n) (conj ops x)
                    ;; APX's {dfv=of} $1, %bl: a standalone {..} needs no comma after it
                    (and (= 'rc (first x)) (not (lex/punct? n ","))) (recur j (conj ops x))
                    (lex/punct? n ",") (if (>= (inc j) (count ts)) (gnu/fail "an operand expected after ," {:at j}) (recur (inc j) (conj ops x)))
                    :else (gnu/fail (str "unexpected " (pr-str (lex/value n)) " after an operand") {:at j})))))
        attrs (cond-> {} (seq pseudo) (assoc :pseudo pseudo) (seq pfx) (assoc :prefix pfx))]
    (apply list mn (concat (when (seq attrs) [attrs]) (reverse ops)))))

;; ---------------------------------------------------------------------------------------------------------------------
;; canonical text

(defn- dec-text ^String [m]
  (str (when-let [k (:k m)] (str " {%" (name k) "}")) (when (:z m) " {z}")))

(defn operand-text ^String [x]
  (case (first x)
    reg (let [[_ r & more] x
              n (first (remove map? more))
              m (first (filter map? more))]
          (str "%" (name r) (when n (str "(" n ")")) (when m (dec-text m))))
    imm (str "$" (gnu/expr-text (second x)))
    ind (str "*" (operand-text (second x)))
    rc (str "{" (second x) "}")
    mem (let [{:keys [seg segsym disp base index scale comma bcst] :as m} (second x)]
          (str (when seg (str "%" (name seg) ":"))
               (when-let [s (:segsym m)] (str (name s) ":"))
               (when (contains? m :disp) (gnu/expr-text disp))
               (when (or base index scale comma (and (not (contains? m :disp)) (not seg) (not segsym)))
                 (str "(" (when base (if (seq? base) (gnu/name-text (second base)) (str "%" (name base))))
                      (when (or index scale comma) (str "," (when index (if (seq? index) (gnu/name-text (second index)) (str "%" (name index))))))
                      (when (or scale (= comma 2)) ",")
                      (when scale (gnu/expr-text scale))
                      ")"))
               (when bcst (str "{1to" bcst "}"))
               (dec-text m)))))

(defn insn-text ^String [f]
  (let [[mn & r] f
        attrs (when (map? (first r)) (first r))
        ops (if attrs (rest r) r)]
    (str (apply str (map #(str "{" % "} ") (:pseudo attrs)))
         (apply str (map #(str (name %) " ") (:prefix attrs)))
         (name mn)
         (when (seq ops) (str "\t" (str/join ", " (map operand-text (reverse ops))))))))

(ns arbace.repr.asm.arm64.bits
  "The helpers of arm64asm's alias conditions (golang.org/x/arch/arm64/arm64asm's condition_util.go in TamaGo's GOROOT,
  BSD-3-Clause, The Go Authors; ported by hand, AR2), which the generated arbace.repr.asm.arm64.table's conditions call.
  Every value is a non-negative long holding a uint32.")

(set! *warn-on-reflection* true)

(defn extract_bit ^long [^long v ^long bit] (bit-and (bit-shift-right v bit) 1))
(defn is_zero [^long x] (zero? x))
(defn is_ones_n16 [^long x] (= x 0xffff))
(defn bit_count ^long [^long x] (Long/bitCount x))

(defn bfxpreferred_4 [^long sf ^long opc1 ^long imms ^long immr]
  (cond
    (< imms immr) false
    (and (= (bit-shift-right imms 5) sf) (= (bit-and imms 0x1f) 0x1f)) false
    (and (zero? immr) (zero? sf) (or (= imms 7) (= imms 15))) false
    (and (zero? immr) (= sf 1) (zero? opc1) (or (= imms 7) (= imms 15) (= imms 31))) false
    :else true))

(defn move_wide_preferred_4 [^long sf ^long n ^long imms ^long immr]
  (cond
    (and (= sf 1) (not= n 1)) false
    (and (zero? sf) (not (and (zero? n) (zero? (bit-and (bit-shift-right imms 5) 1))))) false
    (< imms 16) (<= (mod (bit-and (- immr) 0xffffffff) 16) (- 15 imms))
    :else (let [width (if (= sf 1) 64 32)]
            (if (>= imms (- width 15))
              (<= (mod immr 16) (- imms (- width 15)))
              false))))

(def ^:dynamic *sysops*
  "{[op1 crn crm op2] kind}: bound by the encoder to the table's sysops."
  {})

(defn sys_op_4 [^long op1 ^long crn ^long crm ^long op2]
  (case (get *sysops* [op1 crn crm op2] :sys)
    :tlbi :sys_TLBI :dc :sys_DC :ic :sys_IC :at :sys_AT :sys_SYS))

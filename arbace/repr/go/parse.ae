(ns arbace.repr.go.parse
  "repr/go's native reader, its tree (doc/go/GO-PARSER-SURVEY.md, GP1, GP7): Go's own go/parser
  and a dumper that builds the tree of the helper's dump (doc/go/HELPER-NOTES.md, \"The tree\")
  directly as Arbace data (GPS6 (a): format :godump 2, positions \"L:C\"), without the dump's text.

  The dumper is a Go package of Go forms, arbace/repr/go/godump, committed in go/ (GPS13 (b):
  go/arbace/repr/go/godump.ae and godump/dump.ae, kept as generated by bin/generated-check) and
  generated here from go/ast's forms (tamago/goroot/go/go/ast/ast.ae, GPS5 (a)): one case of a
  type switch per node type of go/ast, its fields in go/ast's order and of the helper's kinds
  (positions, tokens, channel directions, strings, booleans, comment groups as their first
  position, nodes and lists of nodes; the parser's resolution, File.Imports and File.Comments not
  written), plus the parts that are not go/ast's: the selector's and type assertion's :dot, the
  comment groups with :text on doc groups, the directives and the :warnings, after
  tools/godump/dump.go. It imports go/parser, go/ast and go/token, strconv, strings,
  path/filepath, os, time and arbace.

  Since GP7 (GPS4 (b)) the dumper and go/parser, go/scanner, go/ast and go/token are listed in
  goi's table (go/arbace/gotable.edn): printed with the program and compiled, the dumper called
  through the table. On an executable whose table does not list them (the tools' host until the
  re-seed that carries GP7), goi loads the dumper from ARBACE_PATH and interprets it, and
  go/parser's packages from the digest, as GP1 built (GPS1 (c)).

  No annotations: they are GP4's. The files and each dump's header come from the loader
  (arbace.repr.go.load, GP2; go list's part in arbace.box.plan), not from the helper: native-dump
  takes a loader's job (its header, directory and files) and parses its files. E-tree compares
  the native dumps with the helper's: the headers, the trees and the sets of dumps.

  bin/repr-go read --reader native ... and bin/repr-go native-check run -main here."
  (:require [arbace.string :as str]
            [arbace.set :as set]
            [arbace.go.repl :as repl]
            [arbace.go.check :as ck]
            [arbace.repr.go.read :as rd]
            [arbace.repr.go.load :as ld])
  (:import [java.io File]
           [java.util.concurrent Executors TimeUnit]))

;;; go/ast's nodes, from its forms

(defn- ast-forms [^String ast-dir]
  (ck/read-string-forms (slurp (File. ast-dir "ast.ae"))))

(defn- type-specs
  "[name type-form] of every go/type form (single or grouped)."
  [forms]
  (for [f forms
        :when (and (seq? f) (= 'go/type (first f)))
        :let [body (remove string? (rest f))]
        spec (if (symbol? (first body))
               [[(first body) (second body)]]
               (for [v body :when (vector? v)] [(first (remove string? v)) (last v)]))]
    spec))

(defn- receiver-types
  "The names T of the methods named m with the receiver (* T)."
  [forms m]
  (set (for [f forms
             :when (and (seq? f) (= 'go/method (first f)) (= m (second f)))
             :let [params (first (filter vector? f))
                   tag (:tag (meta (first params)))]
             :when (and (seq? tag) (= '* (first tag)))]
         (second tag))))

(def ^:private skip-field
  "Fields the helper does not write: the parser's resolution, File.Imports (the import specs
  again) and File.Comments (written beside the tree)."
  '#{Obj Scope Unresolved Imports Comments})

(defn kebab
  "go/ast's name as the dump's keyword name: BinaryExpr is binary-expr."
  [^String s]
  (str/lower-case (str/replace s #"(?<=.)([A-Z])" "-$1")))

(defn ast-nodes
  "go/ast's node types (structs whose pointer has the method Pos and End), in source order:
  [{:name T :fields [{:name F :key k :kind K :tag tag} ...]} ...]; K is :pos, :token, :chan-dir,
  :string, :bool, :comment, :node or :nodes (tools/godump/dump.go's fieldKind)."
  [^String ast-dir]
  (let [forms (ast-forms ast-dir)
        specs (type-specs forms)
        nodes (set/intersection (receiver-types forms 'Pos) (receiver-types forms 'End))
        ifaces (set (for [[n t] specs :when (and (seq? t) (= 'interface (first t)))] n))
        node-type? (fn [t] (or (contains? ifaces t)
                               (and (seq? t) (= '* (first t)) (contains? nodes (second t)))))
        kind (fn [tname fname t]
               (cond
                 (= t 'token/Pos) :pos
                 (= t 'token/Token) :token
                 (= t 'ChanDir) :chan-dir
                 (= t '(* CommentGroup)) :comment
                 (= t 'string) :string
                 (= t 'bool) :bool
                 (and (seq? t) (= 'slice (first t)) (node-type? (second t))) :nodes
                 (node-type? t) :node
                 ;; as the helper's infoOf: a panic when such a node is met (none of go/parser's
                 ;; trees has one: ast.Package's Files)
                 :else [:unknown (str "godump: field " tname "." fname " of type " (pr-str t))]))]
    (vec (for [[n t] specs
               :when (and (contains? nodes n) (seq? t) (= 'struct (first t)))]
           {:name n
            :fields (vec (for [f (rest t)
                               :when (symbol? f)
                               :when (not (contains? skip-field f))
                               :when (Character/isUpperCase (.charAt (name f) 0))
                               :let [tag (:tag (meta f))]]
                           {:name f :key (kebab (name f)) :tag tag :kind (kind n f tag)}))}))))

;;; The dumper's Go forms

(defn- kw-var [k] (symbol (str "kw_" (str/replace k "-" "_"))))

(defn- field-stmts
  "The statements appending field f of node x (of type tname) to kv."
  [tname {:keys [name key kind]}]
  (let [fx (list (symbol (str ".-" name)) 'x)
        kv (kw-var key)
        add (fn [v] (list 'set! 'kv (list 'append 'kv kv v)))]
    (case kind
      :pos [(list 'when (list '.IsValid fx) (add (list '.pos 'd fx)))]
      :token [(list 'when (list '!= fx 'token/ILLEGAL) (add (list '.String fx)))]
      :chan-dir [(add (list 'chanDir fx))]
      :string [(list 'when (list '!= fx "") (add (list '.str 'd fx)))]
      :bool [(list 'when fx (add true))]
      :comment [(list* 'when (list '!= fx nil)
                       (add (list '.pos 'd (list '.Pos fx)))
                       (when (= key "doc") [(list 'aset '(.-docs d) fx true)]))]
      :node [(list* 'when (list '!= fx nil)
                    (add (list '.node 'd fx))
                    ;; the "." of a selector and of a type assertion, which go/ast does not record
                    (when (and (= key "x") ('#{SelectorExpr TypeAssertExpr} tname))
                      [(list 'let ['dot (list '.dotAfter 'd (list '.End fx))]
                             (list 'when '(.IsValid dot)
                                   '(set! kv (append kv kw_dot (.pos d dot)))))]))]
      :nodes [(list 'when (list '!= fx nil)
                    (list 'let ['xs (list 'make '(slice any) (list 'len fx))]
                          (list 'range ['i 'e fx] '(aset xs i (.node d e)))
                          (add '(arbace/Call vecFn (spread xs)))))])))

(defn- node-case [{:keys [name fields]}]
  (let [unknown (some #(when (vector? (:kind %)) (second (:kind %))) fields)]
    (concat
      (list 'case [(list '* (symbol "ast" (str name)))]
            '(when (== x nil) (return nil)))
      (if unknown
        [(list 'panic unknown)]
        [(list* 'let ['kv (list 'make '(slice any) 1 (inc (* 2 (count fields))))]
                (list 'aset 'kv 0 (kw-var (kebab (str name))))
                (concat (mapcat #(field-stmts name %) fields)
                        ['(return (arbace/Call mkFn (spread kv)))]))]))))

(def ^:private fixed-keys
  "Keywords of the dumper beside the nodes' heads and fields."
  ["dot" "send" "recv" "both" "list" "text" "bytes"])

(defn dumper-forms
  "The dumper's package as Go forms (one file), generated from go/ast's forms in ast-dir."
  [^String ast-dir]
  (let [nodes (ast-nodes ast-dir)
        keys (distinct (concat fixed-keys
                               (map (comp kebab str :name) nodes)
                               (map :key (mapcat :fields nodes))))]
    (concat
      ['(ns go.arbace.repr.go.godump (:require [arbace.go :as go]))
       '(go/package godump :path "arbace/repr/go/godump" :files ["dump.go"])
       '(in-ns 'go.arbace.repr.go.godump)
       '(go/file "dump.go"
          :doc "Package godump builds the tree of repr/go's dump (doc/go/HELPER-NOTES.md, \"The tree\") of a Go file as Arbace data: generated by arbace.repr.go.parse from go/ast's forms.\n"
          :imports [[arbace "arbace"] [ast "go/ast"] [parser "go/parser"] [token "go/token"]
                    [os "os"] [filepath "path/filepath"] [strconv "strconv"] [strings "strings"]
                    [time "time"] [utf8 "unicode/utf8"]])
       '(go/type dumper (struct
                          ^{:tag (* token/FileSet)} fset
                          ^{:tag (* token/File)} tf
                          ^{:tag (slice byte)} src
                          ^{:tag (map (* ast/CommentGroup) bool)} docs
                          ^{:tag (slice any)} dirs
                          ^{:tag (slice any)} warns))
       '(go/var ^{:tag any :doc "mkFn makes a node, (head {key value ...}) from head key value ...\n"} mkFn)
       '(go/var ^{:tag any :doc "vecFn is arbace.core/vector.\n"} vecFn)
       '(go/var ^{:tag any :doc "mapFn is arbace.core/array-map.\n"} mapFn)
       ;; the keywords made by Init, not at the package's initialization: compiled into the
       ;; program, the package is initialized before Arbace sets arbace's Hooks
       (list* 'go/func 'Init "Init sets the Arbace fns the dumper builds its data with, and makes its keywords.\n" '[^any mk ^any vec ^any m]
              '(set! mkFn mk)
              '(set! vecFn vec)
              '(set! mapFn m)
              (for [k keys] (list 'set! (kw-var k) (list 'arbace/Kw k))))]
      (for [k keys] (list 'go/var (with-meta (kw-var k) {:tag 'any})))
      ['(go/method pos "pos is p as \"L:C\": raw (not adjusted by //line), byte columns from 1; nil when not valid.\n"
          ^any [^{:tag (* dumper)} d ^token/Pos p]
          (when (not (.IsValid p)) (return nil))
          (let [pp (.PositionFor (.-fset d) p false)]
            (+ (strconv/Itoa (.-Line pp)) ":" (strconv/Itoa (.-Column pp)))))
       '(go/method posFile "posFile is p as \"FILE:L:C\", FILE a base name.\n"
          ^string [^{:tag (* dumper)} d ^token/Pos p]
          (let [pp (.PositionFor (.-fset d) p false)]
            (+ (filepath/Base (.-Filename pp)) ":" (strconv/Itoa (.-Line pp)) ":" (strconv/Itoa (.-Column pp)))))
       '(go/method str "str is s, or (:bytes [b ...]) when s is not valid UTF-8.\n"
          ^any [^{:tag (* dumper)} d ^string s]
          (when (not (utf8/ValidString s))
            (let [bs (make (slice any) (len s))]
              (for [i 0] (< i (len s)) (inc! i)
                (aset bs i (conv int64 (aget s i))))
              (return (arbace/Call "arbace.core/list" kw_bytes (arbace/Call vecFn (spread bs))))))
          s)
       '(go/func chanDir ^any [^ast/ChanDir dir]
          (switch dir
            (case [ast/SEND] (return kw_send))
            (case [ast/RECV] (return kw_recv)))
          kw_both)
       '(go/method dotAfter "dotAfter is the position of the first \".\" at or after from, skipping white space and comments; NoPos if another token comes first.\n"
          ^token/Pos [^{:tag (* dumper)} d ^token/Pos from]
          (let [src (.-src d) tf (.-tf d)]
            (when (or (== tf nil) (not (.IsValid from))) (return token/NoPos))
            (let [off (.Offset tf from)]
              (while (< off (len src))
                (let [c (aget src off)]
                  (cond
                    (or (== c \space) (== c \tab) (== c \newline) (== c \return)) (inc! off)
                    (and (== c \/) (< (+ off 1) (len src)) (== (aget src (+ off 1)) \/))
                    (while (and (< off (len src)) (!= (aget src off) \newline)) (inc! off))
                    (and (== c \/) (< (+ off 1) (len src)) (== (aget src (+ off 1)) \*))
                    (let [end (strings/Index (conv string (subslice src (+ off 2))) "*/")]
                      (when (< end 0) (return token/NoPos))
                      (set! off + (+ 2 end 2)))
                    (== c \.) (return (.Pos tf off))
                    :else (return token/NoPos))))
              token/NoPos)))
       '(go/func isDirective "isDirective: //go: directives, build constraints, line directives, cgo's //export, gccgo's //extern, and every other directive go/ast recognises.\n"
          ^bool [^string text]
          (when (or (strings/HasPrefix text "//go:") (strings/HasPrefix text "//line ")
                    (strings/HasPrefix text "/*line ") (strings/HasPrefix text "// +build")
                    (strings/HasPrefix text "//export ") (strings/HasPrefix text "//extern "))
            (return true))
          (let [(values _ ok) (ast/ParseDirective token/NoPos text)]
            ok))
       '(go/func inExpr "inExpr reports whether position p lies strictly inside an expression of f.\n"
          ^bool [^{:tag (* ast/File)} f ^token/Pos p]
          (let [found false]
            (ast/Inspect f (fn ^bool [^ast/Node n]
                             (when (or found (== n nil) (< p (.Pos n)) (>= p (.End n)))
                               (return false))
                             (let [(values _ ok) (assert ast/Expr n)]
                               (when (and ok (< (.Pos n) p))
                                 (set! found true)))
                             (not found)))
            found))
       '(go/method comments "comments is the file's comment groups, [{:list [[\"L:C\" text] ...] [:text ...]} ...], :text on doc groups; it collects the directives and the warnings.\n"
          ^any [^{:tag (* dumper)} d ^{:tag (* ast/File)} f]
          (let [gs (make (slice any) (len (.-Comments f)))]
            (range [i g (.-Comments f)]
              (let [cs (make (slice any) (len (.-List g)))]
                (range [k c (.-List g)]
                  (aset cs k (arbace/Call vecFn (.pos d (.-Slash c)) (.str d (.-Text c))))
                  (when (isDirective (.-Text c))
                    (set! (.-dirs d) (append (.-dirs d) (arbace/Call vecFn (.posFile d (.-Slash c)) (.str d (.-Text c)))))
                    (when (and (strings/HasPrefix (.-Text c) "/*line ") (inExpr f (.-Slash c)))
                      (set! (.-warns d) (append (.-warns d) (+ (.posFile d (.-Slash c)) ": /*line*/ directive inside an expression"))))))
                (if (aget (.-docs d) g)
                  (aset gs i (arbace/Call mapFn kw_list (arbace/Call vecFn (spread cs)) kw_text (.str d (.Text g))))
                  (aset gs i (arbace/Call mapFn kw_list (arbace/Call vecFn (spread cs)))))))
            (arbace/Call vecFn (spread gs))))
       (list 'go/method 'node "node is n as the dump's tree: (:kebab-type {:kebab-field value ...}), fields in go/ast's order, those at their zero value left out.\n"
             '^any [^{:tag (* dumper)} d ^ast/Node n]
             (concat (list 'type-switch '[x n])
                     (map node-case nodes))
             '(panic "godump: a node of a type go/ast does not declare"))
       '(go/func DumpFile "DumpFile parses the Go file at path (ParseComments, SkipObjectResolution) and dumps it: [tree comments directives warnings parse-ns dump-ns], or the error's text.\n"
          ^any [^string path]
          (let [(values src err) (os/ReadFile path)]
            (when (!= err nil) (return (.Error err)))
            (let [t0 (time/Now)
                  fset (token/NewFileSet)
                  (values f ^:assign err) (parser/ParseFile fset path src (bit-or parser/ParseComments parser/SkipObjectResolution))]
              (when (!= err nil) (return (.Error err)))
              (let [t1 (time/Now)
                    d (addr (lit dumper :fset fset :src src :tf (.File fset (.-FileStart f))
                                 :docs (make (map (* ast/CommentGroup) bool))))
                    tree (.node d f)
                    cs (.comments d f)
                    ws (make (slice any) (len (.-warns d)))]
                (range [i w (.-warns d)] (aset ws i w))
                (arbace/Call vecFn tree cs (arbace/Call vecFn (spread (.-dirs d))) (arbace/Call vecFn (spread ws))
                             (.Nanoseconds (.Sub t1 t0)) (.Nanoseconds (time/Since t1)))))))])))

;;; The dumper's committed files (GPS13 (b), GP7)

(def ^:private reader-keys
  "The reader's position metadata: not written, the file's reader gives it back."
  #{:line :column :end-line :end-column :file})

(defn- clean-meta
  "x without the reader's position metadata, recursively."
  [x]
  (let [y (cond
            (seq? x) (with-meta (apply list (map clean-meta x)) (meta x))
            (vector? x) (with-meta (mapv clean-meta x) (meta x))
            (map? x) (with-meta (into {} (map (fn [[k v]] [(clean-meta k) (clean-meta v)])) x) (meta x))
            :else x)]
    (if (and (instance? arbace.lang.IObj y) (meta y))
      (with-meta y (not-empty (into {} (for [[k v] (meta y) :when (not (contains? reader-keys k))] [k (clean-meta v)]))))
      y)))

(defn layout-text
  "Form f as text (arbace.go.table/form-text's, metadata included), a list or vector whose text
  does not fit in 100 columns broken: its head (a list's first element, with its second when
  that fits and is no keyword) on its first line, each other element (a keyword with
  the value after it) on a line of its own, indented by two in a list, one in a vector."
  ([f] (layout-text f 0))
  ([f ^long indent]
   (let [form-text @(requiring-resolve 'arbace.go.table/form-text)
         one (form-text f)]
     (cond
       (and (seq? f) (= 'quote (first f)) (= 2 (count f)) (nil? (meta f)))
       (str "'" (layout-text (second f) (inc indent)))
       (or (<= (+ indent (count one)) 100) (not (or (seq? f) (vector? f))) (< (count f) 2))
       one
       :else
       (let [m (not-empty (meta f))
             mt (when m (form-text (with-meta [] m)))
             prefix (if mt (subs mt 0 (- (count mt) 2)) "")
             [open close] (if (seq? f) ["(" ")"] ["[" "]"])
             xs (vec f)
             nhead (cond
                     (vector? f) 1
                     (and (symbol? (first xs)) (> (count xs) 2) (not (keyword? (second xs)))
                          (<= (+ indent (count prefix) 2 (count (form-text (first xs))) (count (form-text (second xs)))) 100))
                     2
                     :else 1)
             in (+ indent (count prefix) (if (seq? f) 2 1))
             pad (apply str (repeat in \space))
             head (str/join " " (map #(layout-text % (+ indent (count prefix) 1)) (subvec xs 0 nhead)))
             lines (loop [xs (seq (subvec xs nhead)) acc []]
                     (if-let [[x & more] xs]
                       (if (and (keyword? x) more)
                         (recur (seq (rest more)) (conj acc (str (form-text x) " " (layout-text (first more) (+ in (count (form-text x)) 1)))))
                         (recur more (conj acc (layout-text x in))))
                       acc))]
         (str prefix open head
              (apply str (for [l lines] (str "\n" pad l)))
              close))))))

(def dumper-files
  "The dumper's committed files (go/, printed with the program and listed in goi's table)."
  {:package "go/arbace/repr/go/godump.ae" :file "go/arbace/repr/go/godump/dump.ae"})

(defn dumper-texts
  "The texts of the dumper's two files generated from the go/ast forms under goroot-forms
  (tamago/goroot): {relative-path text}."
  [^String goroot-forms]
  (let [fs (map clean-meta (dumper-forms (str goroot-forms "/go/go/ast")))
        [ns-f pkg-f in-ns-f & decls] fs
        note (str ";; Generated by arbace.repr.go.parse (bin/generated-check --update) from go/ast's forms,\n"
                  ";; tamago/goroot/go/go/ast/ast.ae (doc/go/GO-PARSER-SURVEY.md, GP1, GP7: GPS5 (a), GPS13 (b));\n"
                  ";; do not edit.\n")]
    {(:package dumper-files)
     (str note (layout-text ns-f) "\n\n" (layout-text pkg-f) "\n\n(load \"godump/dump\")\n")
     (:file dumper-files)
     (str note (str "(in-ns '" (second (second in-ns-f)) ")") "\n\n" (str/join "\n\n" (map layout-text decls)) "\n")}))

;;; Loading the dumper

(def ^:private dumper-path "arbace/repr/go/godump")

(def ^:private loaded (atom nil))

(defn load!
  "The dumper (go/'s package arbace/repr/go/godump), once per process: compiled when goi's table
  lists it (GP7), else loaded from ARBACE_PATH (go/arbace/repr/go/godump.ae, the checkout's)
  and interpreted by goi with go/parser, go/scanner, go/ast and go/token (interpreted from the
  digest too when the table does not list them). Returns {:dump-file fn :ms ms :compiled bool}:
  its load time. goroot-forms is kept for the callers' forms-check."
  [^String goroot-forms]
  (locking loaded
    (or @loaded
        (let [t0 (System/nanoTime)
              compiled (repl/listed? dumper-path)
              _ (require 'go.arbace.repr.go.godump)
              init (resolve 'go.arbace.repr.go.godump/Init)
              dump (resolve 'go.arbace.repr.go.godump/DumpFile)]
          (when-not (and init dump)
            (throw (ex-info (str "the dumper " dumper-path " has no Init or DumpFile") {})))
          (init (fn [h & kvs] (list h (apply array-map kvs))) vector array-map)
          (reset! loaded {:dump-file @dump :ms (/ (- (System/nanoTime) t0) 1e6) :compiled compiled})))))

(defn load-text
  "What load! did, for the commands' output."
  [{:keys [ms compiled]}]
  (if compiled
    (format "the dumper and go/parser compiled (goi's table), the dumper's namespace made in %.2f s" (/ ms 1e3))
    (format "the dumper (go/arbace/repr/go/godump) loaded with go/parser and interpreted by goi in %.2f s" (/ ms 1e3))))

(defn- go-lang
  "go/version.Lang of v (\"go1.21.3\" is \"go1.21\"), or nil when not a valid version."
  [v]
  (when-let [[_ minor] (and (string? v) (re-find #"^go1\.(0|[1-9][0-9]*)(?:$|[.a-z])" v))]
    [(str "go1." minor) (parse-long minor)]))

(defn file-go-version
  "The file's language version as go/types gives it (Info.FileVersions): max(its //go:build
  version, go1.21) when it has one, else the package's lang."
  [ast-go-version lang]
  (if-let [[v minor] (go-lang ast-go-version)]
    (if (< minor 21) "go1.21" v)
    lang))

(defn parse-file
  "The native tree of the Go file at path: {:ast :comments :directives :warnings :parse-ms
  :dump-ms}, or {:error message} when go/parser rejects it."
  [goroot-forms ^String path]
  (let [r ((:dump-file (load! goroot-forms)) path)]
    (if (string? r)
      {:error r}
      (let [[tree comments dirs warns parse-ns dump-ns] r]
        {:ast tree :comments comments :directives dirs :warnings warns
         :parse-ms (/ parse-ns 1e6) :dump-ms (/ dump-ns 1e6)}))))

;;; go/parser's forms: the digest's against tamago/goroot's

(def parser-packages
  "The packages of the parser that goi interprets: go/parser and what it is made of."
  ["go/parser" "go/scanner" "go/ast" "go/token"])

(defn- strip-meta [x]
  (cond (seq? x) (apply list (map strip-meta x))
        (vector? x) (mapv strip-meta x)
        (map? x) (into {} (map (fn [[k v]] [(strip-meta k) (strip-meta v)])) x)
        :else x))

(defn- decl-forms [forms]
  (vec (for [f forms
             :when (and (seq? f) (not (#{'ns 'in-ns 'go/package 'load 'go/file} (first f))))]
         (strip-meta f))))

(defn forms-check
  "What runs as go/parser, go/scanner, go/ast and go/token, and as the dumper, checked against
  the forms they come from. A parser package goi interprets from the executable's digest (its
  configuration's conversion, arbace.go.repl): its declarations there, in order and metadata
  aside, against tamago/goroot's forms under goroot-forms; one goi's table lists is compiled from
  the toolchain's GOROOT/src, which tamago/goroot's forms are the conversion of (bin/tamago-vendor
  verify), and is not compared. The dumper: its committed files (go/arbace/repr/go/godump) as
  dumper-texts generates them from goroot-forms' go/ast. [[path n-decls ok? how] ...]."
  [^String goroot-forms]
  (conj
    (vec (for [p parser-packages]
           (let [dir (str goroot-forms "/go/" p)
                 pkg (ck/read-string-forms (slurp (str dir ".ae")))
                 gp (first (filter #(and (seq? %) (= 'go/package (first %))) pkg))
                 files (:files (apply hash-map (nnext gp)))
                 ours (decl-forms (mapcat #(ck/read-string-forms (slurp (str dir "/" (str/replace % #"\.go$" ".ae")))) files))]
             (if (repl/listed? p)
               [p (count ours) true :compiled]
               [p (count ours) (= ours (decl-forms (repl/digest-forms p))) :digest]))))
    (let [texts (dumper-texts goroot-forms)]
      [dumper-path (count (decl-forms (ck/read-string-forms (get texts (:file dumper-files)))))
       (every? (fn [[path text]] (let [f (File. ^String path)] (and (.isFile f) (= text (slurp f))))) texts)
       :generated])))

(defn forms-check-text
  "A line of forms-check's result."
  [[p n ok how]]
  (case how
    :compiled (format "%s: %d declarations, compiled (goi's table)" p n)
    :digest (format "%s: %d declarations, the digest's %s tamago/goroot's" p n (if ok "equal to" "NOT equal to"))
    :generated (format "%s: %d declarations, the committed files %s generated from tamago/goroot's go/ast" p n
                       (if ok "as" "NOT as (bin/generated-check --update)"))))

;;; The native dump of a loader's job

(def header-keys
  "A dump's header (doc/go/GO-PARSER-SURVEY.md §5) as the loader (arbace.repr.go.load) gives it
  and E-tree compares it: the package, configuration, directory, file lists, embedded files,
  the directory test, local imports and :imports."
  [:godump :package :config :dir :for-test :go-files :cgo-files :c-files :cxx-files :m-files :h-files
   :f-files :s-files :swig-files :swig-cxx-files :syso-files :ignored-go-files
   :ignored-other-files :embed-patterns :embed-files :test-go-files :test-embed-patterns
   :test-embed-files :dir-test :local-imports :imports])

(defn native-dump
  "The native dump of loader job j ({:header :dir :files}): its header and its files parsed by
  go/parser under goi and dumped, without annotations: {:godump 2 ... :name :files [{:file
  :go-version :ast :comments}] :directives [:warnings]}, plus :times {:parse-ms :dump-ms
  :bytes}; or {:error message :file} when a file does not parse."
  [goroot-forms j]
  (let [dir (:dir j)
        lang (get-in j [:header :config :go-version])
        rs (for [f (:files j)]
             (let [path (str dir "/" f)]
               (assoc (parse-file goroot-forms path) :file f :path path)))]
    (if-let [e (some #(when (:error %) %) rs)]
      {:error (:error e) :file (:file e)}
      (let [warns (vec (mapcat :warnings rs))
            ;; go/types' package name (Checker.initFiles): the first file's clause that is not
            ;; _ (invalid), "" without one
            nm (or (some #(let [n (-> % :ast second :name second :name)] (when (not= "_" n) n)) rs) "")]
        (cond-> (merge {:godump 2} (:header j))
          true (assoc :name nm
                      :files (vec (for [r rs
                                        :let [v (file-go-version (-> r :ast second :go-version) lang)]]
                                    (cond-> {:file (:file r)}
                                      (not= v lang) (assoc :go-version v)
                                      true (assoc :ast (:ast r) :comments (:comments r)))))
                      :directives (vec (mapcat :directives rs)))
          (seq warns) (assoc :warnings warns)
          true (assoc :times {:parse-ms (reduce + (map :parse-ms rs))
                              :dump-ms (reduce + (map :dump-ms rs))
                              :bytes (reduce + (map #(.length (File. ^String (:path %))) rs))}))))))

;;; E-tree: the native dump against the helper's

(defn tree-of
  "What E-tree compares of a dump (doc/go/GO-PARSER-SURVEY.md §5, §6): the header (header-keys),
  the package's name, each file's name, language version, tree and comments, the directives and
  the warnings. The annotations are the trees' metadata, which the comparison ignores."
  [d]
  (merge (select-keys d header-keys)
         {:name (:name d)
          :files (mapv #(select-keys % [:file :go-version :ast :comments]) (:files d))
          :directives (:directives d)
          :warnings (:warnings d)}))

(defn- kind-of [x]
  (cond
    (nil? x) :nil
    (string? x) :string
    (keyword? x) :keyword
    (boolean? x) :boolean
    (integer? x) :integer
    (map? x) :map
    (vector? x) :vector
    (seq? x) :list
    :else (class x)))

(defn diff
  "The first difference between the data a (the helper's) and b (native), strictly: lists,
  vectors and maps are different kinds (Arbace's = takes a list for a vector); metadata
  ignored. nil, or [path a b]."
  [a b path]
  (let [ka (kind-of a) kb (kind-of b)]
    (cond
      (not= ka kb) [path a b]
      (= ka :map) (or (some (fn [k] (when-not (and (contains? a k) (contains? b k)) [(conj path k) (get a k ::missing) (get b k ::missing)]))
                            (distinct (concat (keys a) (keys b))))
                      (some (fn [[k v]] (diff v (get b k) (conj path k))) a))
      (#{:vector :list} ka) (or (when (not= (count a) (count b)) [(conj path :count) (count a) (count b)])
                                (first (keep identity (map-indexed (fn [i [x y]] (diff x y (conj path i))) (map vector a b)))))
      (= a b) nil
      :else [path a b])))

(defn- short-str [x] (let [s (pr-str x)] (if (> (count s) 300) (str (subs s 0 300) "...") s)))

(defn file-at
  "The file a difference's path is in, from the dump d."
  [d path]
  (when (= :files (first path))
    (get-in d [:files (second path) :file])))

(defn- job-keys [j] (vec (for [f (:files j)] (str (get-in j [:header :dir]) "/" f))))

(defn check-job
  "E-tree for loader job j against the helper's dump at path (nil: the helper made none):
  {:key :package :files :keys :nodes :diff [...] :times}; :fail when a file does not parse
  natively and the helper dumped it, :rejected when neither dumps it (a file go/parser
  rejects), :extra when only the native reader dumps it. write, when given, is called with the
  native dump."
  [goroot-forms j ^String path write]
  (try
    (let [t0 (System/nanoTime)
          d (when path (rd/read-dump path))
          t1 (System/nanoTime)
          n (native-dump goroot-forms j)
          t2 (System/nanoTime)
          base {:key (:key j) :path path :package (get-in j [:header :package]) :files (count (:files j)) :keys (job-keys j)}]
      (when (and write (not (:error n))) (write n))
      (cond
        (and (:error n) d) (assoc base :fail (str (:file n) ": " (:error n)))
        (:error n) (assoc base :rejected (str (:file n) ": " (:error n)))
        (nil? d) (assoc base :extra true :nodes (count (mapcat (comp rd/nodes :ast) (:files n))) :times (:times n))
        :else
        (let [df (diff (tree-of d) (tree-of n) [])]
          (cond-> (assoc base :nodes (count (mapcat (comp rd/nodes :ast) (:files n)))
                         :read-ms (/ (- t1 t0) 1e6) :native-ms (/ (- t2 t1) 1e6)
                         :times (:times n))
            df (assoc :diff [(file-at d (first df)) (first df) (short-str (second df)) (short-str (nth df 2))])))))
    (catch Throwable e
      {:key (:key j) :path path :keys (job-keys j) :fail (str (.getName (class e)) ": " (.getMessage e))})))

;;; The command

(defn- write-native!
  "Writes native dump n as text the reader reads back (the helper's format, without
  annotations), at out/<rel>."
  [n ^String out ^String rel]
  (let [f (File. out rel)]
    (.mkdirs (.getParentFile f))
    (spit f (str ";; repr/go's native dump (arbace.repr.go.parse): the tree of a Go package, no annotations\n"
                 (binding [*print-length* nil *print-level* nil *print-meta* false]
                   (pr-str (dissoc n :times)))
                 "\n"))))

(defn- read-spec [^String f]
  (binding [*read-eval* false] (read-string (slurp f))))

(defn- spec-jobs
  "A corpus spec's loads' jobs, each keyed under its load's :sub: [jobs results load-ms]."
  [spec]
  (let [t0 (System/nanoTime)
        all (vec (mapcat (fn [l]
                           (for [j (ld/jobs l)]
                             (cond-> j (:sub l) (assoc :key (str (:sub l) "/" (:key j)) :tsv-key (:key j)))))
                         (:loads spec)))]
    [(filterv :files all) (filterv :status all) (/ (- (System/nanoTime) t0) 1e6)]))

(defn- helper-results
  "The helper's summary (godump's TSV): {key [status msg]}."
  [^String tsv]
  (if (and tsv (.isFile (File. tsv)))
    (into {} (for [l (str/split-lines (slurp tsv))
                   :let [[st k _ _ _ _ msg] (str/split l #"\t")]
                   :when k]
               [k [st msg]]))
    {}))

(defn helper-header
  "The header of the helper's dump at path (its text before :files, read alone)."
  [^String path]
  (let [s (slurp path)
        i (.indexOf s "\n :files [")]
    (binding [*read-eval* false]
      (read-string (str (subs s (.indexOf s "{") (if (neg? i) (count s) i)) "}")))))

(defn- check-header
  "The headers' comparison alone (--headers): job j's against the helper's dump at path."
  [j ^String path]
  (let [base {:key (:key j) :path path :package (get-in j [:header :package]) :files (count (:files j)) :keys (job-keys j)}]
    (try
      (if (nil? path)
        (assoc base :extra true)
        (let [df (diff (select-keys (helper-header path) header-keys) (select-keys (:header j) header-keys) [])]
          (cond-> (assoc base :nodes 0)
            df (assoc :diff [nil (first df) (short-str (second df)) (short-str (nth df 2))]))))
      (catch Throwable e
        (assoc base :fail (str (.getName (class e)) ": " (.getMessage e)))))))

(defn- check-corpus
  "E-tree over corpus spec (its :dumps the helper's), in pool: the report's entry. headers:
  the headers and the sets of dumps alone, no parse."
  [goroot-forms spec pool out known headers]
  (let [t0 (System/nanoTime)
        nm (:name spec)
        dumps (str/replace (:dumps spec) #"/+$" "")
        [js results load-ms] (spec-jobs spec)
        helper (into {} (for [p (rd/dump-files [dumps])]
                          [(str/replace (subs p (inc (count dumps))) #"\.edn$" "") p]))
        hres (helper-results (:tsv spec))
        jkeys (set (map :key js))
        futs (mapv (fn [j]
                     (.submit ^java.util.concurrent.ExecutorService pool
                              ^Callable (fn [] (if headers
                                                 (check-header j (get helper (:key j)))
                                                 (check-job goroot-forms j (get helper (:key j))
                                                            (when out #(write-native! % (str out "/" nm) (str (:key j) ".edn"))))))))
                   js)
        rs (mapv #(.get ^java.util.concurrent.Future %) futs)
        missing (vec (for [[k p] (sort helper) :when (not (jkeys k))]
                       {:key k :path p :missing (if-let [r (some #(when (= k (:key %)) %) results)]
                                                  (str "the loader: " (:status r) " " (:msg r))
                                                  "no such dump from the loader")}))
        extra (filter :extra rs)
        helper-failed? (fn [r] (= "fail" (first (get hres (or (:tsv-key (some #(when (= (:key r) (:key %)) %) js)) (:key r))))))
        known? (fn [r] (or (contains? known (:package r)) (contains? known (:key r)) (some #(contains? known %) (:keys r))))
        fails (filter :fail rs)
        differ (filter :diff rs)
        bad-extra (remove helper-failed? extra)
        unknown (remove known? (concat fails differ missing bad-extra))
        ok (filter #(and (:nodes %) (not (:extra %))) rs)
        sum (fn [k] (reduce + (keep #(get-in % [:times k]) ok)))]
    (doseq [r fails] (println (if (known? r) "FAIL known" "FAIL") nm (:key r) (:fail r)))
    (doseq [r differ] (println (if (known? r) "DIFF known" "DIFF") nm (:key r) (pr-str (:diff r))))
    (doseq [r missing] (println (if (known? r) "MISSING known" "MISSING") nm (:key r) (:missing r)))
    (doseq [r bad-extra] (println (if (known? r) "EXTRA known" "EXTRA") nm (:key r) "dumped natively, not by the helper"))
    (println (format (str "%s: " (if headers "the headers: %d of %d dumps' equal" "E-tree %d of %d dumps equal, header and tree")
                          " (%d files, %d nodes, %.1f MB of Go); %d differ, %d failed, %d missing, %d extra (%d the helper's failures), %d rejected by both, %d excluded or failed by both, %d not known; load %.1f s, parse %.1f s, dump %.1f s (CPU), helper's dumps read %.1f s")
                     nm (- (count ok) (count differ)) (count helper) (reduce + (map :files ok)) (reduce + (keep :nodes ok))
                     (/ (sum :bytes) 1e6) (count differ) (count fails) (count missing) (count extra) (- (count extra) (count bad-extra))
                     (count (filter :rejected rs)) (count (remove #(contains? helper (:key %)) results)) (count unknown)
                     (/ load-ms 1e3) (/ (sum :parse-ms) 1e3) (/ (sum :dump-ms) 1e3) (/ (reduce + (keep :read-ms ok)) 1e3)))
    {:corpus nm :dumps (count helper) :jobs (count js) :results (count results)
     :equal (- (count ok) (count differ)) :files (reduce + (map :files ok))
     :nodes (reduce + (keep :nodes ok)) :bytes (sum :bytes) :load-s (/ load-ms 1e3)
     :parse-s (/ (sum :parse-ms) 1e3) :dump-s (/ (sum :dump-ms) 1e3)
     :read-s (/ (reduce + (keep :read-ms ok)) 1e3)
     :differ (vec (for [r differ] [(:key r) (:diff r)])) :fail (vec (for [r fails] [(:key r) (:fail r)]))
     :missing (vec (for [r missing] [(:key r) (:missing r)]))
     :extra (vec (for [r extra] [(:key r) (if (helper-failed? r) (second (get hres (:key r))) "not the helper's failure")]))
     :rejected (count (filter :rejected rs))
     :unknown (count unknown) :wall-s (/ (- (System/nanoTime) t0) 1e9)}))

(defn- read-corpus
  "The native reader over corpus spec, no comparison: native dumps under out/NAME."
  [goroot-forms spec pool out]
  (let [t0 (System/nanoTime)
        nm (:name spec)
        [js results load-ms] (spec-jobs spec)
        futs (mapv (fn [j]
                     (.submit ^java.util.concurrent.ExecutorService pool
                              ^Callable (fn [] (check-job goroot-forms j nil
                                                          (when out #(write-native! % (str out "/" nm) (str (:key j) ".edn")))))))
                   js)
        rs (mapv #(.get ^java.util.concurrent.Future %) futs)
        ok (filter :nodes rs)
        sum (fn [k] (reduce + (keep #(get-in % [:times k]) ok)))]
    (doseq [r (filter #(or (:rejected %) (:fail %)) rs)] (println "REJECTED" nm (:key r) (or (:rejected r) (:fail r))))
    (doseq [r results :when (= "fail" (:status r))] (println "FAIL" nm (:key r) (:msg r)))
    (println (format "%s: %d dumps natively (%d files, %d nodes, %.1f MB of Go), %d rejected by go/parser, %d excluded, %d failed to load; load %.1f s, parse %.1f s, dump %.1f s (CPU), %.1f s"
                     nm (count ok) (reduce + (map :files ok)) (reduce + (keep :nodes ok)) (/ (sum :bytes) 1e6)
                     (count (remove :nodes rs)) (count (filter #(= "excluded" (:status %)) results))
                     (count (filter #(= "fail" (:status %)) results))
                     (/ load-ms 1e3) (/ (sum :parse-ms) 1e3) (/ (sum :dump-ms) 1e3) (/ (- (System/nanoTime) t0) 1e9)))
    {:corpus nm :dumps (count ok) :rejected (count (remove :nodes rs)) :results (count results)
     :load-s (/ load-ms 1e3) :parse-s (/ (sum :parse-ms) 1e3) :dump-s (/ (sum :dump-ms) 1e3)
     :unknown (count (filter #(= "fail" (:status %)) results))}))

(defn generated-texts
  "repr/go's generated Go forms in go/ (GP7): the dumper's files, generated from goroot-forms'
  go/ast (dumper-texts), and gc's syntax renamed, from cmd-forms (arbace.repr.go.syntax's
  copy-texts): {relative-path text}."
  [^String goroot-forms ^String cmd-forms]
  (merge (dumper-texts goroot-forms)
         ((requiring-resolve 'arbace.repr.go.syntax/copy-texts) cmd-forms)))

(defn- generate-main
  "generate [--goroot DIR] [--cmd DIR] OUT: generated-texts written under OUT (bin/generated-check)."
  [& args]
  (let [[opts [out]] (loop [opts {:goroot "tamago/goroot" :cmd "tamago/cmd"} as args]
                       (case (first as)
                         "--goroot" (recur (assoc opts :goroot (second as)) (drop 2 as))
                         "--cmd" (recur (assoc opts :cmd (second as)) (drop 2 as))
                         [opts as]))]
    (when-not out
      (binding [*out* *err*] (println "usage: generate [--goroot DIR] [--cmd DIR] OUT"))
      (System/exit 2))
    (doseq [[path text] (sort (generated-texts (:goroot opts) (:cmd opts)))]
      (let [f (File. (str out "/" path))]
        (.mkdirs (.getParentFile f))
        (spit f text)))
    (shutdown-agents)
    (System/exit 0)))

(defn -main
  "generate [--goroot DIR] [--cmd DIR] OUT: repr/go's generated Go forms (generated-texts) under
  OUT.

  check|read [--headers] [--jobs N] [--forms DIR] [--known FILE] [--report FILE] [--out DIR] SPEC...

  check: E-tree (doc/go/GO-PARSER-SURVEY.md §5, §6) of each corpus SPEC (a file read by the
  Clojure reader: {:name :dumps DIR :tsv FILE :loads [LOAD ...]}, LOAD arbace.repr.go.load's):
  the loader's dumps, each package's files parsed by go/parser under goi and dumped natively,
  against the helper's dumps under :dumps (annotations ignored): the header and the tree, the
  sets of dumps. --out writes the native dumps under DIR/NAME. Exits 1 when a dump differs,
  fails or is missing and the known differences (a map of file key, \"$GOROOT/src/fmt/print.go\",
  dump key or package path to the reason) do not list it.

  --headers (check): the loader alone, the headers and the sets of dumps, no parse.

  read: the native reader alone (no helper): the dumps under --out DIR/NAME."
  [& args]
  (when (= "generate" (first args))
    (apply generate-main (rest args)))
  (let [[cmd & args] args
        _ (when-not (#{"check" "read"} cmd)
            (binding [*out* *err*] (println "usage: check|read [--jobs N] [--forms DIR] [--known FILE] [--report FILE] [--out DIR] SPEC..."))
            (System/exit 2))
        [opts specs] (loop [opts {:jobs 1 :forms "tamago/goroot"}
                            [a & more :as args] args]
                       (case a
                         "--headers" (recur (assoc opts :headers true) more)
                         "--jobs" (recur (assoc opts :jobs (parse-long (first more))) (rest more))
                         "--forms" (recur (assoc opts :forms (first more)) (rest more))
                         "--known" (recur (assoc opts :known (first more)) (rest more))
                         "--report" (recur (assoc opts :report (first more)) (rest more))
                         "--out" (recur (assoc opts :out (first more)) (rest more))
                         [opts args]))
        known (when-let [k (:known opts)]
                (when (.isFile (File. ^String k))
                  (binding [*read-eval* false] (read-string (slurp k)))))
        _ (when-not (:headers opts)
            (println (load-text (load! (:forms opts)))))
        fc (if (:headers opts) [] (forms-check (:forms opts)))
        _ (doseq [x fc] (println (forms-check-text x)))
        forms-bad (count (remove #(nth % 2) fc))
        pool (Executors/newFixedThreadPool (:jobs opts))
        results (vec (for [sf specs]
                       (let [spec (read-spec sf)]
                         (if (= cmd "check")
                           (check-corpus (:forms opts) spec pool (:out opts) (or known {}) (:headers opts))
                           (read-corpus (:forms opts) spec pool (:out opts))))))
        unknown (+ forms-bad (reduce + (map :unknown results)))]
    (.shutdown pool)
    (.awaitTermination pool 1 TimeUnit/MINUTES)
    (when (and (= cmd "check") (> (count results) 1))
      (println (format (if (:headers opts)
                         "the headers: %d corpora, %d of %d dumps' equal, %d files%s; %d not known"
                         "E-tree: %d corpora, %d of %d dumps equal (header and tree), %d files, %d nodes; %d not known")
                       (count results) (reduce + (map :equal results)) (reduce + (map :dumps results))
                       (reduce + (map :files results)) (if (:headers opts) "" (reduce + (map :nodes results))) unknown)))
    (when-let [rf (:report opts)]
      (spit rf (with-out-str (binding [*print-length* nil] (prn {:forms fc :corpora results})))))
    (shutdown-agents)
    (System/exit (if (pos? unknown) 1 0))))

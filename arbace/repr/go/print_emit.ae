(ns arbace.repr.go.print-emit
  "The emitter of repr/go's printer (doc/go/PRINTER-NOTES.md): writes Go tokens, tracks the
  line, indentation and Go's semicolon rule, and places tokens on the lines the forms record
  (doc/go/SPEC.md §10.1, §12.3).

  The state is one map of volatiles bound to *p* while a file is printed. Text is written
  with tabs for indentation and vertical tabs between aligned cells; print-text/align turns
  it into gofmt's spacing at the end."
  (:require [arbace.repr.go.print-text :as text]
            [arbace.string :as str]))

(def ^:dynamic *p* nil)

(def ^:dynamic *next*
  "The line of what follows the construct being printed, when known: the room a closing
  brace or a statement without a recorded line may take (mode :lines)."
  nil)

(defn new-state
  "opts: :lines? (place forms on their recorded lines), :line-directives? (write //line or
  /*line*/ directives where a recorded line cannot be reached by layout), :full (mode :full,
  SPEC §10.2, §12.3: tokens are collected with their positions and laid out at the end; a map
  {:comments [[line col text] ...] :space [[line col ws] ...] :tail ws} of the file's text
  beyond its tokens)."
  [opts]
  {:sb (StringBuilder.)
   :full (when-let [f (:full opts)]
           (assoc f :items (java.util.ArrayList.) :pend (volatile! nil)))
   :line (volatile! 1)        ; the line of the cursor, as gc will see it
   :bol (volatile! true)      ; nothing but indentation written on this line yet
   :indent (volatile! 0)      ; the indentation of the next line
   :cur-indent (volatile! 0)  ; the indentation of this line
   :last (volatile! "")       ; the last token
   :semi (volatile! false)    ; a newline after the last token would insert a semicolon
   :ws (volatile! nil)        ; pending whitespace: nil, \space or \u000B
   :opens (volatile! [])      ; indentation of the lines where open brackets were written
   :mark (volatile! 0)        ; the last line a form was recorded to begin on (mode :lines)
   :min-line (volatile! 1)    ; the lowest line set-line! set (start-at!'s chunks)
   :lines? (boolean (:lines? opts))
   :directives? (:line-directives? opts true)})

(definline lines? [] `(:lines? *p*))
(definline full? [] `(:full *p*))
(definline line [] `@(:line *p*))
(definline bol? [] `@(:bol *p*))

(definline target
  "The recorded line of a form (mode :lines): :line metadata on lists, and on symbols and
  vectors that begin a Go line."
  [f]
  `(when (lines?)
     (let [l# (:line (meta ~f))]
       (when (integer? l#) (long l#)))))

(defn room?
  "Whether n more lines fit before *next* (always, when it is unknown or out of mode
  :lines)."
  [n]
  (or (not (lines?)) (nil? *next*) (> (long *next*) (+ (line) (long n)))))

;; ---------------------------------------------------------------------------------------
;; Tokens

(def keywords
  #{"break" "case" "chan" "const" "continue" "default" "defer" "else" "fallthrough" "for"
    "func" "go" "goto" "if" "import" "interface" "map" "package" "range" "return" "select"
    "struct" "switch" "type" "var"})

(defn- semi-after?
  "Go's semicolon rule: a newline after this token ends the statement."
  [^String s]
  (cond
    (#{"break" "continue" "fallthrough" "return" "++" "--" ")" "]" "}"} s) true
    (keywords s) false
    (zero? (.length s)) false
    :else (let [c (.charAt s (dec (.length s)))]
            (or (Character/isLetterOrDigit c) (= c \_) (= c \") (= c \') (= c \`)
                (> (int c) 127)))))

(defn- may-combine?
  "go/printer's mayCombine, extended: the two tokens would scan as other tokens unless
  separated."
  [^String prev ^String next]
  (when (and (pos? (.length prev)) (pos? (.length next)))
    (let [p (.charAt prev (dec (.length prev)))
          n (.charAt next 0)]
      (or (and (= prev "+") (= n \+))
          (and (= prev "-") (= n \-))
          (and (= p \/) (or (= n \*) (= n \/)))
          (and (= prev "<") (or (= n \-) (= n \<)))
          (and (= prev "&") (or (= n \&) (= n \^)))
          (and (Character/isDigit p) (= n \.) (re-matches #"[0-9]+" prev))
          (and (or (Character/isLetterOrDigit p) (= p \_))
               (or (Character/isLetterOrDigit n) (= n \_)))))))

(defn- start-line! []
  (let [p *p*]
    (when @(:bol p)
      (let [n (max 0 (long @(:indent p)))
            ^StringBuilder sb (:sb p)]
        (dotimes [_ n] (.append sb \tab))
        (vreset! (:cur-indent p) n)
        (vreset! (:bol p) false)
        (vreset! (:ws p) nil)))))

(defn at!
  "Mode :full: the position [line col] of the next token (nil: none)."
  [pos]
  (when-let [fs (:full *p*)]
    (when pos (vreset! (:pend fs) pos))
    nil))

(defn- full-tok
  "Mode :full: collects a token, its position (at!) and whether gofmt's layout would put a
  blank before it."
  [^String s]
  (let [p *p* fs (:full p)
        pos @(:pend fs)]
    (vreset! (:pend fs) nil)
    (.add ^java.util.ArrayList (:items fs)
          {:s s :pos pos :sp (boolean (or @(:ws p) (may-combine? @(:last p) s)))})
    (vreset! (:ws p) nil)
    (vreset! (:last p) s)
    nil))

(defn soft
  "Mode :full: a separator the layout decides: kind :sep (\";\" or \",\" between elements, kept
  when the next token follows on the line) or :trail (a trailing comma, kept when the closing
  bracket is on a later line)."
  [kind ^String s]
  (when-let [fs (:full *p*)]
    (.add ^java.util.ArrayList (:items fs) {:soft kind :s s})
    nil))

(defn tok
  "Writes a token."
  [^String s]
  (if (:full *p*)
    (full-tok s)
  (let [p *p* ^StringBuilder sb (:sb p)
        at-bol @(:bol p)]
    (start-line!)
    (let [ws @(:ws p)]
      (cond
        at-bol nil
        ws (.append sb (char ws))
        (may-combine? @(:last p) s) (.append sb \space)))
    (vreset! (:ws p) nil)
    (.append sb s)
    (vreset! (:last p) s)
    (vreset! (:semi p) (semi-after? s))
    nil)))

(defn raw-tok
  "Writes a token that may span lines (a raw string): its line breaks count, and alignment
  leaves it whole."
  [^String s]
  (if (:full *p*)
    (full-tok s)
    (do (tok (text/escape s))
        (vswap! (:line *p*) + (count (filter #(= % \newline) s)))
        (vreset! (:semi *p*) true))))

(defn sp
  "A blank before the next token on this line."
  []
  (if (:full *p*)
    (vreset! (:ws *p*) \space)
    (when-not (bol?)
      (when-not (= \u000B @(:ws *p*)) (vreset! (:ws *p*) \space)))))

(defn vtab
  "An alignment separator before the next token (gofmt's vtab)."
  []
  (if (:full *p*)
    (vreset! (:ws *p*) \space)
  (when-not (bol?)
    ;; a second separator in a row is an empty cell
    (when (= \u000B @(:ws *p*)) (.append ^StringBuilder (:sb *p*) (char 11)))
    (vreset! (:ws *p*) (char 11)))))

(defn nl
  "Ends the line; the next line is indented by indent. form-feed? ends the alignment
  sections too."
  ([indent] (nl indent false))
  ([indent form-feed?]
   (if (:full *p*)
     (vreset! (:ws *p*) nil)
   (let [p *p* ^StringBuilder sb (:sb p)]
     (vreset! (:ws p) nil)
     (.append sb (if form-feed? (char 12) (char 10)))
     (vswap! (:line p) inc)
     (vreset! (:bol p) true)
     (vreset! (:indent p) indent)
     nil))))

(definline cur-indent [] `@(:cur-indent *p*))

(defn push-open!
  "Records an open bracket (or a statement) whose continuation lines indent one more than
  indent (default: this line's)."
  ([] (push-open! (if (bol?) @(:indent *p*) (cur-indent))))
  ([indent] (vswap! (:opens *p*) conj indent) nil))

(defn pop-open! []
  (let [o (peek @(:opens *p*))]
    (vswap! (:opens *p*) pop)
    o))

(defn cont-indent
  "The indentation of a continuation line."
  []
  (let [o (peek @(:opens *p*))]
    (inc (long (or o 0)))))

(defn comment-line
  "Writes a whole-line comment (doc comment line, directive) at indent and ends the line.
  //line directives start at column 1, as gc requires."
  [^String s indent]
  (when-not (:full *p*)
  (let [p *p* ^StringBuilder sb (:sb p)]
    (when-not (bol?) (nl indent))
    (vreset! (:indent p) (if (str/starts-with? s "//line ") 0 indent))
    (start-line!)
    (.append sb (text/escape s))
    (vreset! (:last p) "")
    (vreset! (:semi p) false)
    (nl indent))))

(defn set-line!
  "Sets the line of the cursor as gc will see it (after a //line directive)."
  [l]
  (vreset! (:line *p*) l)
  (vswap! (:min-line *p*) min (long l)))

;; ---------------------------------------------------------------------------------------
;; Chunks: declarations printed apart, in parallel, then joined (arbace.repr.go.print/print-file)
;;
;; A chunk of a file's declarations is printed in a state of its own, from the start of a line
;; at the line its first declaration is placed on (start-at!), as if all before it had been
;; printed; join! appends it to the file's state when the file reaches that line in the same
;; state, which the chunk's text then continues exactly as printing it there would have:
;; - at the start of a line at indentation 0 with no pending whitespace or open bracket, what
;;   was written before is not read (the last token and the semicolon rule only between
;;   tokens of a line, a line's indentation only after its first token);
;; - the mark (break-to!) is read only as (max (inc mark) line): when the file's mark is
;;   below the chunk's first line and the chunk's line never went below it (min-line: //line
;;   directives move the line back), the mark before the chunk changes nothing in it.

(defn start-at!
  "Starts a chunk's state at line l (start of a line, indentation 0)."
  [l]
  (vreset! (:line *p*) l)
  (vreset! (:min-line *p*) l))

(defn chunk-state
  "The state after a chunk was printed (in its own state, *p*): its text and its emitter
  state."
  []
  (let [p *p*]
    {:text (.toString ^StringBuilder (:sb p))
     :line @(:line p) :bol @(:bol p) :indent @(:indent p) :cur-indent @(:cur-indent p)
     :last @(:last p) :semi @(:semi p) :ws @(:ws p) :opens @(:opens p) :mark @(:mark p)
     :min-line @(:min-line p)}))

(defn join!
  "Appends the chunk c (chunk-state), printed from line l (start-at!), to *p* when *p*'s state
  is where c's printing assumed it: true when joined, false when the chunk must be printed
  again in *p*."
  [c l]
  (let [p *p* l (long l)]
    (if (and @(:bol p) (== (long @(:line p)) l) (zero? (long @(:indent p))) (nil? @(:ws p))
             (empty? @(:opens p)) (< (long @(:mark p)) l) (>= (long (:min-line c)) l))
      (do (.append ^StringBuilder (:sb p) ^String (:text c))
          (vreset! (:line p) (:line c))
          (vreset! (:bol p) (:bol c))
          (vreset! (:indent p) (:indent c))
          (vreset! (:cur-indent p) (:cur-indent c))
          (vreset! (:last p) (:last c))
          (vreset! (:semi p) (:semi c))
          (vreset! (:ws p) (:ws c))
          (vreset! (:opens p) (:opens c))
          (vswap! (:mark p) max (long (:mark c)))
          (vswap! (:min-line p) min (long (:min-line c)))
          true)
      false)))

(defn line-directive-inline
  "/*line :N:1*/ before the next token: gc puts it on line N (a column keeps the file name)."
  [n]
  (let [p *p* ^StringBuilder sb (:sb p)]
    (start-line!)
    (when-let [ws @(:ws p)] (.append sb (char ws)))
    (.append sb (str "/*line :" n ":1*/"))
    (vreset! (:ws p) nil)
    (set-line! n)))

(defn line-directive-own
  "//line :N:1 on a line of its own, at the start of a line: the line after it is N."
  [n]
  (let [ind @(:indent *p*)]
    (comment-line (str "//line :" n ":1") ind)
    (set-line! n)))

;; ---------------------------------------------------------------------------------------
;; Layout

(defn render
  "The text f (a function of no arguments that prints) writes on a fresh line, without
  positions: go/printer's nodeSize."
  [f]
  (binding [*p* (new-state {:lines? false :line-directives? false})
            *next* nil]
    (f)
    (.toString ^StringBuilder (:sb *p*))))

(defn break-to!
  "Inside an expression, before a form recorded at line t (or :break, a new line): line
  breaks where Go allows them, else a /*line*/ directive."
  [t]
  (when (and t (not (:full *p*)))
    (let [mark (:mark *p*)
          brk? (= t :break)
          ;; a break (:go/breaks) is the line after the last one a form began on, as the
          ;; converter counts (SPEC §10.1), not after the cursor's: a closing bracket the
          ;; layout put on a line of its own does not count (`},` then `nil` on its line)
          t (if brk? (if (bol?) (line) (max (inc (long @mark)) (line))) t)]
      (vswap! mark max t)
      (cond
        (> t (line))
        (if (and @(:semi *p*) (not (bol?)))
          (when (:directives? *p*) (line-directive-inline t))
          (let [ci (cont-indent)]
            (while (< (line) t) (nl ci))))
        (and (< t (line)) (:directives? *p*))
        (line-directive-inline t)))))

(defn stmt-break!
  "Before a statement, a declaration or another element of a list whose elements may be
  separated by a line break or by sep (\";\" or \",\"): moves to its line t (nil: unknown).
  first? when it follows the opening bracket. indent is the element's indentation. Returns
  true when a line break was made."
  [t first? sep indent]
  (let [newline! (fn [n] (dotimes [_ (max 1 n)] (nl indent)) (vswap! (:mark *p*) max (line)) true)
        same! (fn [] (if first? (sp) (do (when sep (tok sep)) (sp))) false)]
    (when (integer? t) (vswap! (:mark *p*) max (long t)))
    (cond
      (full?) (do (when (and sep (not first?)) (soft :sep sep)) (vreset! (:ws *p*) \space) false)
      (bol?) (do (vreset! (:indent *p*) indent) false)
      (not (lines?)) (newline! 1)
      (nil? t) (if (room? 1) (newline! 1) (same!))
      (= t :break) (newline! 1)
      (> (long t) (line)) (newline! (- (long t) (line)))
      (= (long t) (line)) (same!)
      :else (do (newline! 1)
                (when (:directives? *p*) (line-directive-own t))
                true))))

(defn close-break!
  "Before a closing bracket: end, its recorded line (or nil); multiline?, whether the
  construct already spans lines; always?, whether gofmt's layout puts it on a line of its
  own. Returns true when the bracket goes on a new line (indented as the line of its
  opening, indent)."
  [end multiline? always? indent]
  (cond
    (full?) false
    (and (lines?) (integer? end))
    (cond
      (> (long end) (line)) (do (while (< (line) (long end)) (nl indent)) true)
      (= (long end) (line)) false
      :else (do (when (:directives? *p*) (line-directive-inline end)) false))
    (lines?) (if (and (or multiline? always?) (room? 1)) (do (nl indent) true) false)
    always? (do (nl indent) true)
    :else false))

(declare full-result)

(defn result
  "The text written, aligned."
  []
  (if (:full *p*)
    (full-result)
  (let [s (.toString ^StringBuilder (:sb *p*))
        s (str/replace s #"[ \x0B]+\n" "\n")]
    (text/align (if (str/ends-with? s "\n") s (str s "\n"))))))

;; ---------------------------------------------------------------------------------------
;; Mode :full: the layout of the collected tokens (SPEC §10.2, §12.3)
;;
;; Every token the forms position goes at its line and column; the file's comments (data in
;; mode :full) go at theirs, merged in by position. A token without a position (a comma, the
;; `=` of a spec, `else`, a slice's colon, a separator the layout keeps) follows the token
;; before it as gofmt spaces it, or, when the next positioned token is on the same line, takes
;; the room between them: the blanks beyond gofmt's go before the first token gofmt separates
;; by a blank (an aligned `=`), the missing ones are dropped from the left. White space is
;; tabs at the start of a line and spaces elsewhere, unless the file's :space says otherwise
;; (the source's other runs: spaces as indentation, tabs between tokens, blanks at line ends);
;; the file ends with :tail.

(defn- utf8-len ^long [^String s]
  (alength (.getBytes s java.nio.charset.StandardCharsets/UTF_8)))

(defn- end-of
  "The position after text s written at [l c]."
  [[l c] ^String s]
  (let [i (.lastIndexOf s "\n")]
    (if (neg? i)
      [l (+ (long c) (utf8-len s))]
      [(+ (long l) (count (filter #(= % \newline) s))) (inc (utf8-len (subs s (inc i))))])))

(def ^:private glue-left #{"," ";" ")" "]" "}" "..." "++" "--" ":"})

(defn- line-comment? [it] (and (:comment it) (str/starts-with? (:s it) "//")))

(defn- place-run
  "Positions for the unpositioned tokens run (each {:s :sp}) after the cursor cur (the end of
  the token before them, prev-item), before the positioned item nxt (or nil)."
  [run cur prev-item nxt]
  (let [[cl cc] cur
        n (count run)
        lens (mapv #(utf8-len (:s %)) run)
        natural (fn []
                  (loop [i 0 c (long cc) acc []]
                    (if (< i n)
                      (let [c (+ c (if (:sp (nth run i)) 1 0))]
                        (recur (inc i) (+ c (long (nth lens i))) (conj acc [cl c])))
                      acc)))]
    (cond
      ;; after a line comment: on the next token's line, just before it
      (and (line-comment? prev-item) nxt)
      (let [[nl ncol] (:pos nxt)]
        (loop [i (dec n) c (- (long ncol) (if (:sp nxt) 1 0)) acc ()]
          (if (neg? i)
            (vec acc)
            (let [c (- c (long (nth lens i)))]
              (recur (dec i) (- c (if (:sp (nth run i)) 1 0)) (cons [nl (max 1 c)] acc))))))
      (or (nil? nxt) (> (long (first (:pos nxt))) (long cl)) (line-comment? prev-item))
      (natural)
      :else
      (let [ncol (long (second (:pos nxt)))
            need (- ncol (long cc) (reduce + lens))
            slots (conj (mapv :sp run) (:sp nxt))
            nat (keep-indexed (fn [i s] (when s i)) slots)
            nnat (count nat)
            spaces (cond
                     (neg? need) (mapv #(if % 1 0) slots)
                     (>= need nnat)
                     (let [extra (- need nnat)
                           base (mapv #(if % 1 0) slots)]
                       (cond
                         (zero? extra) base
                         (seq nat) (update base (first nat) + extra)
                         (and (= n 1) (even? extra) (= ":" (:s (first run))))
                         (-> base (assoc 0 (quot extra 2)) (assoc 1 (quot extra 2)))
                         :else (update base n + extra)))
                     :else
                     (let [keep (set (take-last need nat))]
                       (vec (map-indexed (fn [i _] (if (keep i) 1 0)) slots))))]
        (loop [i 0 c (long cc) acc []]
          (if (< i n)
            (let [c (+ c (long (nth spaces i)))]
              (recur (inc i) (+ c (long (nth lens i))) (conj acc [cl c])))
            acc))))))

(defn full-result
  "The text of the tokens collected in mode :full, laid out at their positions."
  []
  (let [fs (:full *p*)
        ;; the source's semicolons are at their positions: the printer's are dropped
        ;; so are its trailing commas: the printer's are dropped
        items (if (:semis fs)
                (into [] (remove #(and (#{";" ","} (:s %)) (nil? (:pos %))
                                       (or (= ";" (:s %)) (= :trail (:soft %)) (:trail %))))
                      (:items fs))
                (vec (:items fs)))
        extras (sort-by (fn [[l c]] [l c])
                        (concat (:comments fs) (map (fn [[l c]] [l c ";" :semi]) (:semis fs))
                                (map (fn [[l c]] [l c "," :semi]) (:trails fs))))
        ;; the comments and semicolons, each before the first positioned token after it
        merged (loop [i 0 cs (seq extras) acc (transient [])]
                 (if (< i (count items))
                   (let [it (nth items i)
                         pos (:pos it)]
                     (if (and pos (seq cs) (neg? (compare (let [[l c] (first cs)] [l c]) pos)))
                       (let [[l c t semi] (first cs)]
                         (recur i (next cs) (conj! acc (if semi {:s t :pos [l c]}
                                                           {:s (str t) :pos [l c] :comment true}))))
                       (recur (inc i) cs (conj! acc it))))
                   (persistent! (reduce (fn [a [l c t semi]]
                                          (conj! a (if semi {:s t :pos [l c]}
                                                       {:s (str t) :pos [l c] :comment true})))
                                        acc cs))))
        n (count merged)
        space (into {} (map (fn [[l c w]] [[l c] (str w)])) (:space fs))
        sb (StringBuilder.)
        cur (volatile! [1 1])
        last-s (volatile! "")
        prev-item (volatile! nil)
        write-at!
        (fn [it [l c]]
          (let [[cl cc] @cur
                l (long l) c (long c) cl (long cl) cc (long cc)]
            (cond
              (> l cl)
              (do (when-let [w (space [cl cc])] (.append sb ^String w))
                  (loop [k cl]
                    (when (< k l)
                      (.append sb \newline)
                      (when (< k (dec l))
                        (when-let [w (space [(inc k) 1])] (.append sb ^String w)))
                      (recur (inc k))))
                  (if-let [w (space [l 1])]
                    (.append sb ^String w)
                    (dotimes [_ (dec c)] (.append sb \tab))))
              (and (= l cl) (>= c cc))
              (if-let [w (space [l cc])]
                (.append sb ^String w)
                (dotimes [_ (- c cc)] (.append sb \space)))
              ;; a position that cannot be reached: the token follows as gofmt spaces it
              :else (when (or (:sp it) (may-combine? @last-s (:s it))) (.append sb \space)))
            (.append sb ^String (:s it))
            (vreset! cur (if (or (> l cl) (and (= l cl) (>= c cc)))
                           (end-of [l c] (:s it))
                           (end-of @cur (str " " (:s it)))))
            (vreset! last-s (:s it))
            (vreset! prev-item it)))]
    (loop [i 0]
      (when (< i n)
        (let [it (nth merged i)]
          (if (:pos it)
            (do (write-at! it (:pos it)) (recur (inc i)))
            ;; a run of unpositioned tokens and separators, then the comments before the next
            ;; token (tok), then tok
            (let [j (loop [j i] (if (and (< j n) (nil? (:pos (nth merged j)))) (recur (inc j)) j))
                  t (loop [t j] (if (and (< t n) (:comment (nth merged t))) (recur (inc t)) t))
                  tok* (when (< t n) (nth merged t))
                  [cl _] @cur
                  same-line? (and tok* (= (long (first (:pos tok*))) (long cl)))
                  run (loop [k i ls @last-s acc []]
                        (if (< k j)
                          (let [x (nth merged k)]
                            (if-let [kind (:soft x)]
                              (let [keep? (case kind
                                            :sep (and same-line? (semi-after? ls))
                                            :trail (and (not same-line?) tok* (not= ls ",") (semi-after? ls)))]
                                (if keep?
                                  (recur (inc k) (:s x) (conj acc {:s (:s x) :sp false}))
                                  (recur (inc k) ls acc)))
                              (recur (inc k) (:s x) (conj acc x))))
                          acc))
                  ;; the comments on the cursor's line between which the run may go: the first
                  ;; gap (before a comment, or before tok) with room for it and a blank
                  obstacles (vec (concat (take-while #(= (long (first (:pos %))) (long cl)) (subvec merged j t))
                                         (when same-line? [tok*])))
                  width (reduce + (map #(utf8-len (:s %)) run))
                  k (loop [k 0 c (long (second @cur))]
                      (if (< k (dec (count obstacles)))
                        (let [o (nth obstacles k)
                              oc (long (second (:pos o)))]
                          (if (>= (- oc c) (+ width 1))
                            k
                            (recur (inc k) (long (second (end-of (:pos o) (:s o)))))))
                        (max 0 (dec (count obstacles)))))
                  k (if (seq run) (min k (count (subvec merged j t))) 0)]
              (dotimes [q k] (let [o (nth merged (+ j q))] (write-at! o (:pos o))))
              (let [nxt (when (< (+ j k) n) (nth merged (+ j k)))
                    ps (place-run run @cur @prev-item nxt)]
                (doseq [[x p] (map vector run ps)] (write-at! x p)))
              (recur (+ j k)))))))
    (.append sb ^String (or (:tail fs) "\n"))
    (.toString sb)))

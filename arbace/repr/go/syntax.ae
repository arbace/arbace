(ns arbace.repr.go.syntax
  "repr/go's syntax errors in gc's words (doc/go/GO-PARSER-SURVEY.md GP6, GP7; GPS2 (b)): a Go file
  that go/parser rejects has no tree and no forms; gc's own parser, cmd/compile/internal/syntax,
  reports its errors as gc reports them.

  A driver package of Go forms, arbace/repr/go/gcsyntax (go/arbace/repr/go/gcsyntax.ae,
  hand-written), parses the file as gc's noder does (noder.LoadPackage: syntax.Parse with an
  error handler and CheckBranches, no pragma handler) and keeps the errors as base.ErrorfAt and
  base.FlushErrors print them: one error beginning with \"syntax error\" per line (the last one's
  line), one of equal other errors per line, sorted by position, an error equal to the one
  before it printed once; each as gc prints it with -C, FILE:LINE: MESSAGE, FILE the name given.
  gc stops after them when one of them is a syntax error (noder's checkFiles:
  base.SyntaxErrors); else types2 would check the tree, which go/parser did not give (syntax-only?
  false).

  The driver imports gc's syntax as a renamed copy, arbace/repr/go/internal/syntax
  (go/arbace/repr/go/internal/syntax.ae and syntax/, copy-texts: tamago/cmd's forms of
  cmd/compile/internal/syntax with their namespace and import path renamed, which cmd's internal
  rule would not let the program import; GP7). Since GP7 the driver is listed in goi's table and
  compiled with the copy into the program; on an executable whose table does not list it (the
  tools' host until the re-seed that carries GP7) goi loads both from ARBACE_PATH and interprets
  them (load!, about 3 s), as GP6 built."
  (:require [arbace.string :as str]
            [arbace.go.repl :as repl])
  (:import [java.io File]))

(def syntax-path "cmd/compile/internal/syntax")

(def copy-path "The renamed copy's import path." "arbace/repr/go/internal/syntax")

(def ^:private driver-path "arbace/repr/go/gcsyntax")

(defn copy-texts
  "The renamed copy of gc's syntax from the forms of cmd-forms (tamago/cmd): its package file and
  files under go/arbace/repr/go/internal/, the namespace go.cmd.compile.internal.syntax renamed
  go.arbace.repr.go.internal.syntax and the import path arbace/repr/go/internal/syntax, nothing
  else changed (each file's lines kept: the forms' positions are its lines); the package file
  says where it comes from. {relative-path text}."
  [^String cmd-forms]
  (let [src (str cmd-forms "/go/cmd/compile/internal/syntax")
        dst "go/arbace/repr/go/internal/syntax"
        rename (fn [^String t]
                 (-> t
                     (str/replace "go.cmd.compile.internal.syntax" "go.arbace.repr.go.internal.syntax")
                     (str/replace (str ":path \"" syntax-path "\"") (str ":path \"" copy-path "\""))))
        note (str ";; Generated by arbace.repr.go.syntax (bin/generated-check --update): gc's parser,\n"
                  ";; tamago/cmd/go/" syntax-path ", renamed " copy-path "\n"
                  ";; (doc/go/GO-PARSER-SURVEY.md, GP7); do not edit.\n")]
    (into {(str dst ".ae") (str note (rename (slurp (str src ".ae"))))}
          (for [^File f (sort-by #(.getName ^File %) (.listFiles (File. src)))
                :when (str/ends-with? (.getName f) ".ae")]
            [(str dst "/" (.getName f)) (rename (slurp f))]))))

(def ^:private loaded (atom nil))

(defn load!
  "The driver (arbace/repr/go/gcsyntax), once per process: compiled when goi's table lists it
  (GP7), else loaded with gc's syntax (the renamed copy) from ARBACE_PATH and interpreted by goi;
  returns {:errors fn :ms ms :compiled bool}."
  []
  (locking loaded
    (or @loaded
        (let [t0 (System/nanoTime)
              compiled (repl/listed? driver-path)
              _ (require 'go.arbace.repr.go.gcsyntax)
              f (resolve 'go.arbace.repr.go.gcsyntax/Errors)]
          (when-not f (throw (ex-info (str "the driver " driver-path " has no Errors") {})))
          (reset! loaded {:errors @f :ms (/ (- (System/nanoTime) t0) 1e6) :compiled compiled})))))

(defn file-errors
  "gc's syntax errors of the Go file at path, as gc prints them with -C (FILE:LINE: MESSAGE, FILE
  name): {:lines [line ...] :syntax? bool}, :syntax? whether one is a syntax error (gc stops
  after them; else types2 would go on)."
  [^String path ^String name]
  (let [^String r ((:errors (load!)) path name)]
    {:lines (vec (remove str/blank? (str/split-lines (subs r 1))))
     :syntax? (= \S (.charAt r 0))}))

(defn errors-text
  "The syntax errors of the files of a job (dir, file names) as gc prints them, one text."
  [^String dir files]
  (let [rs (for [f files] (file-errors (str dir "/" f) f))]
    {:text (apply str (for [r rs l (:lines r)] (str l "\n")))
     :syntax? (boolean (some :syntax? rs))}))

(defn -main
  "[--out DIR] FILE...: each Go file's syntax errors as gc prints them with -C (its base name),
  by gc's syntax (load!: compiled, or interpreted by goi); on standard output, or with --out into
  DIR/FILE.txt each (FILE as given, relative), a summary on standard error."
  [& args]
  (let [[opts files] (loop [opts {} as args]
                       (case (first as)
                         "--out" (recur (assoc opts :out (second as)) (drop 2 as))
                         [opts as]))
        {:keys [ms compiled]} (load!)
        t0 (System/nanoTime)
        rs (doall
             (for [^String f files]
               (let [{:keys [lines syntax?] :as r} (file-errors f (.getName (File. f)))]
                 (if-let [out (:out opts)]
                   (let [o (File. (str out "/" f ".txt"))]
                     (.mkdirs (.getParentFile o))
                     (spit o (apply str (for [l lines] (str l "\n")))))
                   (doseq [l lines] (println l)))
                 r)))]
    (flush)
    (binding [*out* *err*]
      (println (format "gc's syntax errors: %d files, %d with errors, %d with a syntax error (gc stops after them); gc's syntax %s in %.2f s, the files in %.2f s"
                       (count rs) (count (filter (comp seq :lines) rs)) (count (filter :syntax? rs))
                       (if compiled "compiled (goi's table), its namespace made" "loaded by goi")
                       (/ ms 1e3) (/ (- (System/nanoTime) t0) 1e9))))
    (shutdown-agents)
    (System/exit 0)))

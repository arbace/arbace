(ns arbace.repr.go.print-code
  "repr/go's printer, the forms level (doc/go/PRINTER-NOTES.md): Go forms (doc/go/SPEC.md) to Go
  tokens through arbace.repr.go.print-emit. Types (§5), declarations (§6), statements and
  expressions (§7), literals (§8), directives and doc comments (§9, §10.4), files (§4.3).

  Every form is classified by its head and position (§4.4); nothing is resolved. Spacing
  follows go/printer (go1.27.1 src/go/printer/nodes.go: binaryExpr, cutoff, walkBinary,
  the depth rules of exprList, controlClause, funcBody, fieldList, valueSpec, keepTypeColumn)
  so that gofmt leaves the output as it is."
  (:require [arbace.repr.go.print-emit :as e :refer [tok sp vtab]]
            [arbace.repr.go.print-text :as text]
            [arbace.string :as str]))

(declare expr1 expr0 type-expr stmt-list simple-stmt block-body print-stmt stmt-list-one-line)

(def ^:dynamic *go-ns*
  "The namespace qualifiers that name the Go forms' own heads (go/func, go/call, ...)."
  #{"go" "arbace.go"})

(def ^:dynamic *header*
  "True while printing the header of an if, for or switch outside brackets: a composite
  literal of a type name needs parentheses there (§12.2)."
  false)

(def ^:dynamic *explicit-groups*
  "True when the file's forms mark grouped names with :go/grouped: then only marked names are
  grouped (PRINTER-NOTES, amendment A1)."
  false)

(defn uses-grouped?
  "Whether :go/grouped occurs in the metadata of forms."
  [forms]
  (letfn [(walk [x]
            (or (contains? (meta x) :go/grouped)
                (some walk (vals (dissoc (meta x) :line :column)))
                (and (coll? x) (some walk (if (map? x) (vals x) x)))))]
    (boolean (some walk forms))))

(def ^:dynamic *generic*
  "True inside a generic declaration: field groups are kept (doc/go/ROUNDTRIP.md, known gaps)."
  false)

(def ^:dynamic *return-pos*
  "Mode :full: the position of the keyword of the implicit return of the function printed."
  nil)

(defn- fail [msg form]
  (throw (ex-info (str msg ": " (pr-str form)) {:form form :line (:line (meta form))})))

;; ---------------------------------------------------------------------------------------
;; Mode :full (SPEC §10.2, §12.3): positions of tokens

(defrecord PL [v pos text parens])

(defn pl?
  "A literal child of mode :full (wrap-full): its value, position, spelling and parentheses."
  [x]
  (instance? PL x))

(defn fp
  "Mode :full: the recorded position of f's token k (its :go/pos), else nil."
  [f k]
  (when (e/full?) (get (:go/pos (meta f)) k)))

(defn- ptok
  "A token at position pos (mode :full)."
  [s pos]
  (e/at! pos)
  (tok s))

(defn ptok*
  "A token at position pos (mode :full), for arbace.repr.go.print."
  [s pos]
  (ptok s pos))

(defn- child-pos
  "Mode :full: the position of the literal child i of f (its parent's :go/apos)."
  [f i]
  (when (e/full?) (get (:go/apos (meta f)) i)))

(defn wrap-full
  "Mode :full: the forms with each literal child that carries a position (its parent's
  :go/apos) replaced by a PL with its spelling (:go/atext) and parentheses (:go/aparens), in
  the forms and in the type forms of :tag and :type-params metadata."
  [x]
  (let [wrap-meta (fn [m] (cond-> m
                            (:tag m) (update :tag wrap-full)
                            (:type-params m) (update :type-params wrap-full)))]
    (cond
      (or (seq? x) (vector? x))
      (let [m (meta x)
            apos (:go/apos m) atext (:go/atext m) apar (:go/aparens m)
            kids (map-indexed (fn [i c]
                                (let [c (wrap-full c)]
                                  (if (and (contains? apos i) (not (keyword? c)) (not (symbol? c))
                                           (not (coll? c)))
                                    (->PL c (get apos i) (get atext i) (get apar i))
                                    c)))
                              x)]
        (with-meta (if (seq? x) (apply list kids) (vec kids)) (wrap-meta m)))
      (symbol? x) (let [m (meta x)]
                    (if (or (:tag m) (:type-params m)) (with-meta x (wrap-meta m)) x))
      :else x)))

(defn- with-parens
  "Prints (body) inside the parentheses ps, [[lparen rparen] ...] outermost first."
  [ps body]
  (doseq [[lp _] ps] (ptok "(" lp))
  (body)
  (doseq [[_ rp] (reverse ps)] (ptok ")" rp)))

;; ---------------------------------------------------------------------------------------
;; Classification (§4.4, §13.5)

(defn op
  "The name of a list's head as the forms read it: an unqualified symbol's name,
  \"go/name\" for the Go forms' qualified heads, \"deref\" for @; nil otherwise (a call of a
  package member, of a list)."
  [f]
  (when (seq? f)
    (let [h (first f)]
      (when (symbol? h)
        (let [n (namespace h)]
          (cond
            (nil? n) (name h)
            (*go-ns* n) (str "go/" (name h))
            (and (= (name h) "deref") (#{"arbace.core" "clojure.core"} n)) "deref"
            :else nil))))))

(def stmt-heads
  #{"let" "let-type" "set!" "aset" "inc!" "dec!" ">!" "go" "defer" "return" "break" "continue"
    "goto" "fallthrough" "label" "do" "if" "when" "cond" "switch" "type-switch" "select" "for"
    "while" "range" "go/directive"})

(def binary-ops
  {"*" ["*" 5] "/" ["/" 5] "%" ["%" 5] "<<" ["<<" 5] ">>" [">>" 5] "bit-and" ["&" 5]
   "bit-and-not" ["&^" 5] "+" ["+" 4] "-" ["-" 4] "bit-or" ["|" 4] "bit-xor" ["^" 4]
   "==" ["==" 3] "!=" ["!=" 3] "<" ["<" 3] "<=" ["<=" 3] ">" [">" 3] ">=" [">=" 3]
   "and" ["&&" 2] "or" ["||" 1]})

(def unary-ops {"-" "-" "+" "+" "bit-not" "^" "not" "!" "addr" "&" "deref" "*" "<!" "<-"})

(def assign-ops
  {"+" "+=" "-" "-=" "*" "*=" "/" "/=" "%" "%=" "<<" "<<=" ">>" ">>=" "bit-and" "&="
   "bit-or" "|=" "bit-xor" "^=" "bit-and-not" "&^="})

(def type-heads #{"*" "slice" "array" "map" "chan" "func" "struct" "interface" "|" "tilde" "inst"})

(defn- args [f] (rest f))

(defn binary?
  "A binary operator form: two or more operands (n-ary forms are left-nested chains)."
  [f]
  (and (seq? f) (contains? binary-ops (op f)) (>= (count f) 3)))

(defn- negative-literal? [f] (and (number? f) (text/negative-number? f)))

(defn unary?
  "A unary operator form (Go's UnaryExpr or StarExpr), or a negative literal."
  [f]
  (or (negative-literal? f)
      (and (seq? f) (contains? unary-ops (op f)) (= (count f) 2))))

(defn- unary-op [f] (if (negative-literal? f) "-" (unary-ops (op f))))

(defn- unary-operand [f]
  (if (negative-literal? f)
    (if (instance? Double f) (Math/abs (double f)) (-' f))
    (second f)))

(defn- bin-op [f] (first (binary-ops (op f))))
(defn- bin-prec [f] (second (binary-ops (op f))))

(defn prec-of
  "The precedence of the Go expression a form prints as: 1-5 binary, 6 unary, 7 primary."
  [f]
  (cond (binary? f) (bin-prec f) (unary? f) 6 :else 7))

(defn- go-sym? [f] (= (op f) "go/id"))

(defn- statement-form? [f]
  (and (seq? f) (contains? stmt-heads (op f))))

(defn expression-form?
  "An expression form other than a call of panic: the implicit return of §6.4."
  [f]
  (and (not (statement-form? f))
       (not (and (seq? f) (= (op f) "panic")))
       (not (keyword? f)) (not (vector? f))))

(defn- line-of [f] (e/target f))

(defn- breaks-of
  "The child indexes in f's :go/breaks, a set: an entry is an index, or [index line] for a
  literal whose Go line is not the line after the last one written before it (SPEC §10.1)."
  [f]
  (set (map #(if (vector? %) (first %) %) (:go/breaks (meta f)))))

(defn- break-line
  "The line :go/breaks records for child i of parent, when it records one."
  [parent i]
  (some #(when (and (vector? %) (= (first %) i)) (second %)) (:go/breaks (meta parent))))

(defn- child-target
  "The recorded line of child i of a list: its own, or the line of the list's :go/breaks (a
  new line, or the line it records; brk: the set of the indexes, when the caller has it)."
  ([parent i child] (child-target parent i child nil))
  ([parent i child brk]
   (or (line-of child)
       (when (and (e/lines?) parent (contains? (or brk (breaks-of parent)) i))
         (or (break-line parent i) :break)))))

(defn- next-targets
  "For targets ts (lines, :break or nil), the first line after each: a vector."
  [ts]
  (let [ts (vec ts)
        n (count ts)
        out (object-array n)]
    (loop [i (dec n) nxt nil]
      (when (>= i 0)
        (aset out i nxt)
        (recur (dec i) (let [t (nth ts i)] (if (integer? t) t nxt)))))
    (vec out)))

(defn- room? [n] (e/room? n))

(defn- body-offset
  "The index in f of the first of its trailing body forms."
  [f body] (- (count f) (count body)))

(defn- next-line
  "The first recorded line among forms, else *next*."
  [forms]
  (or (some line-of forms) e/*next*))

(defn- comma-list
  "x1, x2, ...: the children of parent from index offset on, each by (print-one x), each after
  the first on its recorded line (its own, or parent's :go/breaks: Go allows a break after the
  comma)."
  [parent offset xs print-one]
  (let [xs (vec xs)
        ts (mapv (fn [i x] (child-target parent (+ i offset) x)) (range (count xs)) xs)]
    (dotimes [i (count xs)]
      (when (pos? i) (tok ",") (sp) (e/break-to! (nth ts i)))
      (binding [e/*next* (let [t (get ts (inc i))] (if (integer? t) t e/*next*))]
        (print-one (nth xs i))))))

;; ---------------------------------------------------------------------------------------
;; Names and literals

(defn ident-string
  "The Go spelling of a name: a symbol, pkg/Name, (go/id \"x\")."
  [f]
  (cond
    (symbol? f) (if-let [n (namespace f)] (str n "." (name f)) (name f))
    (go-sym? f) (str (second f))
    :else (fail "not a name" f)))

(defn- name-tok
  "A name's tokens: in mode :full at their positions (pkg.Name is three tokens)."
  [f]
  (if (e/full?)
    (let [p (:go/pos (meta f))]
      (if (and (symbol? f) (namespace f))
        (do (ptok (namespace f) (:x-pos p)) (ptok "." (:dot p)) (ptok (name f) (:name-pos p)))
        (ptok (ident-string f) (:name-pos p))))
    (tok (ident-string f))))

(defn- name-list
  "Names separated by commas (a group of parameters, results, fields, type parameters, or a
  spec's names), each on its recorded line: a name list may span lines (Go allows a break
  after a comma), and gc declares each name at its own line (DWARF's decl_line)."
  [nms]
  (doseq [[i nm] (map-indexed vector nms)]
    (when (pos? i) (tok ",") (sp) (e/break-to! (line-of nm)))
    (name-tok nm)))

(defn- group-line
  "The recorded line of a group of entries: its first name's, else its type's."
  [g]
  (line-of (or (first (:names g)) (:src g))))

(defn- label-name [k]
  (if (keyword? k) (name k) (fail "not a label" k)))

(defn- literal [f & [spelling]]
  (cond
    spelling (tok spelling)
    (nil? f) (tok "nil")
    (true? f) (tok "true")
    (false? f) (tok "false")
    ;; a raw string spanning lines only in the gofmt layout: in the lines layout the forms do
    ;; not say whether the source spelled it raw, and an interpreted string never pushes what
    ;; follows to later lines
    (string? f) (let [nl? (str/includes? f "\n")]
                  (if (and nl? (not (e/lines?)) (not (e/full?)) (text/raw-string-ok? f))
                    (e/raw-tok (str "`" f "`"))
                    (tok (text/go-string f))))
    (char? f) (tok (text/go-rune (long (int f))))
    (number? f) (tok (text/go-number f))
    :else (fail "not a literal" f)))

;; ---------------------------------------------------------------------------------------
;; Lists of elements: arguments, literal elements, parameters

(defn- element-list
  "Prints xs between open and close, separated by commas, each by (print-one x i); keeps
  the recorded lines of the elements, and puts close on a line of its own after a trailing
  comma when the elements span lines and there is room. parent and offset give the
  elements' indexes in their parent list (for :go/breaks); end, the line of close (:here:
  the line of the last element); target, when given, the recorded line of an element (for
  elements that are not forms: groups of parameters)."
  [open close xs print-one {:keys [parent offset end target open-pos close-pos] :or {offset 1}}]
  (ptok open open-pos)
  (e/push-open!)
  (let [start (e/line)
        xs (vec xs)
        n (count xs)
        brk (breaks-of parent)
        ts (mapv (fn [i x] (cond parent (child-target parent (+ i offset) x brk)
                                 target (target x)
                                 :else (line-of x)))
                 (range n) xs)
        nxt (next-targets ts)]
    (dotimes [i n]
      (let [x (nth xs i)
            t (nth ts i)]
        (when (pos? i) (tok ",") (sp))
        (e/break-to! t)
        (binding [e/*next* (or (nth nxt i) e/*next*)]
          (print-one x i))))
    (let [indent (e/pop-open!)
          multi? (> (e/line) start)
          ;; a function literal's closing brace is followed by the bracket on its line, as
          ;; gofmt writes `})` (the forms do not record a trailing comma)
          end (if (or (= end :here) (and (pos? n) (= (op (peek xs)) "fn") (:go/end (meta (peek xs)))))
                (e/line)
                end)]
      (when (and (e/lines?) (pos? n)
                 (or (and (integer? end) (> (long end) (e/line)))
                     (and (nil? end) multi? (e/room? 1))))
        (tok ","))
      (when (pos? n) (e/soft :trail ","))
      (e/close-break! end multi? false indent)
      (ptok close close-pos))))

;; ---------------------------------------------------------------------------------------
;; Types (§5)

(defn- tagged?
  "A name with a type: a symbol or (go/id \"x\") carrying :tag (C5)."
  [x]
  (and (or (symbol? x) (go-sym? x)) (contains? (meta x) :tag)))

(defn- param-entries
  "The entries of a parameter, result or field vector: {:name sym-or-nil :type T
  :variadic? bool :meta m :src x}. A symbol with :tag is a name, anything else a type."
  [v]
  (loop [xs (seq v) acc [] variadic false]
    (if-not xs
      acc
      (let [x (first xs)]
        (if (= x '&)
          (recur (next xs) acc true)
          (recur (next xs)
                 (conj acc (if (tagged? x)
                             {:name x :type (:tag (meta x)) :variadic? variadic :meta (meta x) :src x}
                             {:name nil :type x :variadic? variadic :meta (meta x) :src x}))
                 variadic))))))

(defn- groupable?
  "Whether cur may join prev's group: names of one type, doc and struct tag (a field's doc and
  tag are its every name's, so equal ones are one field's), cur not beginning a line of its
  own (a name that does keeps its line: gc declares it there)."
  [prev cur]
  (and prev (:name prev) (:name cur)
       (not (:variadic? prev)) (not (:variadic? cur))
       (= (:type prev) (:type cur))
       (or (not (e/full?)) (= (:go/pos (meta (:type prev))) (:go/pos (meta (:type cur)))))
       (= (:doc (:meta prev)) (:doc (:meta cur)))
       (= (:go/tag (:meta prev)) (:go/tag (:meta cur)))
       (let [t (line-of (:src cur))] (or (nil? t) (= t (line-of (:src prev)))))))

(defn group-entries
  "Consecutive named entries of equal type, doc and tag (groupable?) as one group
  {:names [...] ...}: Go's `a, b T`. Inside generic declarations the grouping must be the
  source's: when a name of the list carries :go/grouped (the amendment proposed in
  PRINTER-NOTES: each name declared together with the one before it), exactly those names
  join the group before them (in a file that marks them, *explicit-groups*, a generic
  declaration's list without marks has no groups); otherwise the source is assumed to group
  what it can (outside generic declarations the converter marks nothing: grouping is N3's)."
  [entries]
  (let [explicit? (or (and *explicit-groups* *generic*)
                      (some #(contains? (:meta %) :go/grouped) entries))]
    (reduce (fn [groups cur]
              (let [prev (peek groups)]
                (if (and prev
                         (if explicit?
                           (and (:go/grouped (:meta cur)) (:name cur) (:name (peek (:entries prev))))
                           (groupable? (peek (:entries prev)) cur)))
                (conj (pop groups) (-> prev
                                       (update :names conj (:name cur))
                                       (update :entries conj cur)))
                (conj groups (assoc cur :names (if (:name cur) [(:name cur)] []) :entries [cur])))))
            [] entries)))

(defn- variadic-elem [t]
  (if (and (seq? t) (= (op t) "slice")) (second t) (fail "variadic parameter not a slice" t)))

(defn- param-list
  "(a, b int, c ...T): the parameters of a vector; end, the line of the closing bracket when
  known. The vector's recorded line is its opening bracket's (a parameter list after type
  parameters that span lines: SA200)."
  [v & [end open-pos close-pos]]
  (let [groups (group-entries (param-entries v))]
    (e/break-to! (line-of v))
    (element-list "(" ")" groups
                  (fn [g _]
                    (when (seq (:names g))
                      (name-list (:names g))
                      (sp))
                    (if (:variadic? g)
                      (do (ptok "..." (fp (:type g) :ellipsis)) (type-expr (variadic-elem (:type g))))
                      (type-expr (:type g))))
                  {:target group-line :end end
                   :open-pos (or open-pos (fp v :opening)) :close-pos (or close-pos (fp v :closing))})))

(defn- results-entries
  "The results of a signature: a vector's :tag (one unnamed result) or :results."
  [params results]
  (cond
    results (param-entries results)
    (contains? (meta params) :tag) [{:name nil :type (:tag (meta params))}]
    :else []))

(defn- print-results
  "The results of a signature: entries, of the vector rv (:results) or of the parameter
  vector params' tag."
  [entries rv params]
  (cond
    (empty? entries) nil
    (and (= 1 (count entries)) (nil? (:name (first entries))))
    (do (sp)
        (if-let [o (or (fp params :results-opening) (fp rv :opening))]
          (do (ptok "(" o) (type-expr (:type (first entries))) (ptok ")" (or (fp params :results-closing) (fp rv :closing))))
          (type-expr (:type (first entries)))))
    :else (do (sp) (param-list (vec (map (fn [en] (or (:src en) (:type en))) entries)) nil
                               (fp rv :opening) (fp rv :closing)))))

(defn- line-indent
  "The indentation of the line being written."
  []
  (if (e/bol?) @(:indent e/*p*) (e/cur-indent)))

(defn- signature
  "(params) results. The parameters' closing bracket goes on the line of the results (their
  first token follows it on its line: the line they record, else the last parameter's), and
  without results, when the parameters span lines, on a line of its own only if there is room
  before the body (its first recorded line)."
  [params res body & [rv]]
  (let [r (when (seq res) (let [en (first res)] (or (line-of (or (:src en) (:type en))) :here)))]
    (binding [e/*next* (next-line body)]
      (param-list params r)
      (print-results res rv params))))

(defn- func-type-sig
  "(params) results of (func [params] [results]): the results vector holds names or types."
  [params results]
  (signature params (if results (param-entries results) []) nil results))

(defn- struct-tag [s & [m]]
  (cond
    (and (e/full?) (:go/tag-text m)) (ptok (:go/tag-text m) (:go/tag-pos m))
    (and (string? s) (not (str/includes? s "\n")) (text/raw-string-ok? s))
    (ptok (str "`" s "`") (when (e/full?) (:go/tag-pos m)))
    :else (ptok (text/go-string s) (when (e/full?) (:go/tag-pos m)))))

(defn- doc-lines [doc]
  (let [ls (str/split (str doc) #"\n" -1)
        ls (if (= "" (peek ls)) (pop ls) ls)]
    ls))

(defn write-doc
  "A doc comment (CommentGroup.Text) as // lines."
  [doc indent]
  (when (and doc (not= doc ""))
    (doseq [l (doc-lines doc)]
      (e/comment-line (cond (= l "") "//" (str/starts-with? l "\t") (str "//" l) :else (str "// " l))
                      indent))))

(def ^:private non-directive-keys
  #{:go/tag :go/via :go/breaks :go/end :go/pos :go/apos :go/inst :go/grouped :go/implicit
    :go/paren :go/label :go/label-line
    ;; mode :full (SPEC §10.2)
    :go/atext :go/aparens :go/acolon :go/parens :go/ops :go/cond :go/text :go/tag-pos
    :go/tag-text :go/comments :go/space :go/tail :go/semis :go/trails})

(defn directives-of
  "The directive lines of a declared name's metadata (§9.1): :go/<name> true or text (a
  vector for several), sorted by name. Directives not spelled //go: are free-standing
  (go/directive \"...\") forms (A6, in the converter's spelling), never metadata."
  [m]
  (for [[k v] (sort-by (comp name key) (filter (fn [[k _]] (and (keyword? k) (= (namespace k) "go")
                                                                (not (non-directive-keys k))))
                                               m))
        v (if (vector? v) v [v])]
    (if (true? v) (str "//go:" (name k)) (str "//go:" (name k) " " v))))

(defn pre-lines
  "The number of comment lines before a declaration: doc, a // line between doc and
  directives (gofmt's doc comment format), directives."
  [doc dirs]
  (let [d (if (and doc (not= doc "")) (count (doc-lines doc)) 0)]
    (+ d (if (and (pos? d) (seq dirs)) 1 0) (count dirs))))

(defn write-pre [doc dirs indent]
  (write-doc doc indent)
  (when (and doc (not= doc "") (seq dirs)) (e/comment-line "//" indent))
  (doseq [d dirs] (e/comment-line d indent)))

(defn- interface-method? [x]
  (and (seq? x) (symbol? (first x)) (nil? (namespace (first x)))
       (vector? (second x)) (not= (op x) "func")))

(defn- iface-method-sig
  "(params) results of an interface method or declaration: [params] then :results or the
  vector's tag."
  [params more]
  (let [results (when (= (first more) :results) (second more))]
    (signature params (results-entries params results) nil results)))

(declare type-expr)

(defn- one-line-fields?
  "go/printer's isOneLineFieldList: one field (group) without tag or doc, whose type prints
  in at most 30 characters, 29 with names (a method's type is func(...)...)."
  [groups struct?]
  (and (= 1 (count groups))
       (let [g (first groups)
             m (:meta g)]
         (and (not (:go/tag m)) (not (:doc m))
              (let [x (:src g)
                    method? (and (not struct?) (interface-method? x))
                    names? (if struct? (seq (:names g)) method?)
                    text (e/render
                           (fn [] (if method?
                                    (do (tok "func") (iface-method-sig (second x) (nnext x)))
                                    (type-expr (:type g x)))))]
                (and (not (str/includes? text "\n"))
                     (<= (+ (if names? 1 0) (count text)) 30)))))))

(defn- struct-fields [fs]
  (group-entries (for [f fs]
                   (if (tagged? f)
                     {:name f :type (:tag (meta f)) :meta (meta f) :src f}
                     {:name nil :type f :meta (meta f) :src f}))))

(defn- field-body
  "One struct field (group) or interface element, with its separators."
  [g struct? sep]
  (if struct?
    (do
      (if (seq (:names g))
        (do (name-list (:names g))
            (sep)
            (type-expr (:type g)))
        (type-expr (:type g)))
      (when-let [t (:go/tag (:meta g))]
        (when (and (seq (:names g)) (= sep vtab)) (sep))
        (sep)
        (struct-tag t (:meta g))))
    (let [x (:src g)]
      (if (interface-method? x)
        (do (name-tok (first x)) (iface-method-sig (second x) (nnext x)))
        (type-expr x)))))

(defn- field-list
  "struct{...} or interface{...} (go/printer's fieldList)."
  [kw fs struct? & [f]]
  (let [groups (if struct?
                 (struct-fields fs)
                 (vec (for [x fs] {:src x :meta (meta (if (interface-method? x) (first x) x))})))
        start (e/line)
        ts (mapv (fn [g] (or (line-of (:src g)) (line-of (first (:names g))))) groups)
        breaks? (and (e/lines?) (some #(and % (> (long %) start)) ts))
        docs? (some (fn [g] (:doc (:meta g))) groups)]
    (cond
      (and (e/full?) (empty? groups))
      (do (ptok kw (fp f (keyword kw))) (ptok "{" (fp f :lbrace)) (ptok "}" (fp f :rbrace)))
      (empty? groups) (tok (str kw "{}"))
      (and (not breaks?) (not docs?) (not (e/full?)) (or (e/lines?) (one-line-fields? groups struct?)))
      (do (tok (str kw "{")) (sp)
          (doseq [[i g] (map-indexed vector groups)]
            (when (pos? i) (tok ";") (sp))
            (field-body g struct? sp))
          (sp) (tok "}"))
      :else
      (let [indent (if (e/bol?) @(:indent e/*p*) (e/cur-indent))
            sep (if (and struct? (= 1 (count groups))) sp vtab)
            last-start (volatile! (e/line))]
        (ptok kw (fp f (keyword kw))) (sp) (ptok "{" (fp f :lbrace))
        (e/push-open! indent)
        (dotimes [i (count groups)]
          (let [g (nth groups i)
                doc (:doc (:meta g))
                pre (pre-lines doc [])
                t (nth ts i)]
            (binding [e/*next* (next-line (map :src (subvec groups (inc i))))]
              (cond
                (not (e/lines?)) (e/nl (inc indent) (or (zero? i) (> (e/line) @last-start)))
                (and (integer? t) (pos? pre)) (e/stmt-break! (max (- (long t) pre) (inc (e/line))) false ";" (inc indent))
                (pos? pre) (e/stmt-break! :break false ";" (inc indent))
                :else (e/stmt-break! t (zero? i) ";" (inc indent)))
              (when (pos? pre)
                (write-doc doc (inc indent))
                (when (and (e/lines?) (integer? t)) (e/stmt-break! t true nil (inc indent))))
              (vreset! last-start (e/line))
              (field-body g struct? sep))))
        (e/pop-open!)
        (if (e/lines?)
          (when-not (e/close-break! nil true true indent) (sp))
          (e/nl indent true))
        (when (e/full?) (sp))
        (ptok "}" (fp f :rbrace))))))

(defn- chan-type [f]
  (let [[_ a b] f
        dir (when (keyword? a) a)
        elem (if dir b a)]
    (case dir
      :recv (do (ptok "<-" (fp f :begin)) (tok "chan"))
      :send (do (ptok "chan" (fp f :begin)) (ptok "<-" (fp f :arrow)))
      nil (ptok "chan" (fp f :begin))
      (fail "bad channel direction" f))
    (sp)
    (if (and (not= dir :recv) (seq? elem) (= (op elem) "chan") (= (second elem) :recv) (nil? dir)
             (not (e/full?)))
      (do (tok "(") (type-expr elem) (tok ")"))
      (type-expr elem))))

(defn- type-list
  "Type arguments [A, B] (of f, whose brackets' positions mode :full takes)."
  [ts & [f]]
  (element-list "[" "]" ts (fn [t _] (type-expr t)) {:open-pos (fp f :lbrack) :close-pos (fp f :rbrack)}))

(declare print-pl)

(defn- op-pos
  "Mode :full: the position of the i-th operator of an operator form f (a chain's :go/ops)."
  [f i]
  (when (e/full?)
    (if-let [ops (:go/ops (meta f))] (get ops i) (fp f :op-pos))))

(defn type-expr
  "Prints a type form (§5.1)."
  [f]
  (e/break-to! (line-of f))
  (cond
    (pl? f) (print-pl f)
    (and (e/full?) (:go/parens (meta f)))
    (with-parens (:go/parens (meta f)) #(type-expr (vary-meta f dissoc :go/parens)))
    (symbol? f) (name-tok f)
    (seq? f)
    (let [o (op f)]
      (case o
        "*" (do (ptok "*" (fp f :star)) (type-expr (second f)))
        "slice" (do (ptok "[" (fp f :lbrack)) (tok "]") (type-expr (second f)))
        "array" (let [[_ n t] f]
                  (ptok "[" (fp f :lbrack))
                  (if (= n '...) (ptok "..." (fp n :ellipsis)) (binding [*header* false] (expr0 n 1)))
                  (tok "]")
                  (type-expr t))
        "map" (let [[_ k v] f]
                (ptok "map" (fp f :map)) (tok "[") (type-expr k) (tok "]") (type-expr v))
        "chan" (chan-type f)
        "func" (let [[_ params results] f]
                 (ptok "func" (fp f :func)) (func-type-sig params results))
        "struct" (field-list "struct" (args f) true f)
        "interface" (field-list "interface" (args f) false f)
        "|" (doseq [[i t] (map-indexed vector (args f))]
              (when (pos? i) (sp) (ptok "|" (op-pos f (dec i))) (sp))
              (type-expr t))
        "tilde" (do (ptok "~" (fp f :op-pos)) (type-expr (second f)))
        "inst" (do (type-expr (second f)) (type-list (nnext f) f))
        "go/id" (name-tok f)
        ;; a generic type's instance (G T ...)
        (if (or (symbol? (first f)) (go-sym? (first f)))
          (do (name-tok (first f)) (type-list (rest f) f))
          (fail "not a type" f))))
    :else (fail "not a type" f)))

(defn- type-form?
  "A form that prints as a type in an operand position: reserved type heads (other than
  * with two or more operands)."
  [f]
  (and (seq? f)
       (let [o (op f)]
         (and (contains? type-heads o)
              (or (not= o "*") (= 2 (count f)))))))

(defn- begins-with-star-or-paren? [f]
  (or (and (seq? f) (= (op f) "*"))
      (and (seq? f) (= (op f) "|") (begins-with-star-or-paren? (second f)))))

(defn- type-params
  "[P C, Q D] after a name; a single parameter whose constraint begins with * gets a trailing
  comma (§12.2)."
  [tps]
  (let [entries (map (fn [p]
                       {:name p :type (if (contains? (meta p) :tag) (:tag (meta p)) 'any)
                        :meta (meta p) :src p})
                     tps)
        groups (group-entries entries)]
    (ptok "[" (fp tps :opening))
    (doseq [[i g] (map-indexed vector groups)]
      (when (pos? i) (tok ",") (sp) (e/break-to! (group-line g)))
      (name-list (:names g))
      (sp)
      (type-expr (:type g)))
    (when (and (= 1 (count groups)) (= 1 (count (:names (first groups))))
               (begins-with-star-or-paren? (:type (first groups))))
      (if (e/full?) (e/soft :trail ",") (tok ",")))
    (e/soft :trail ",")
    (ptok "]" (fp tps :closing))))

;; ---------------------------------------------------------------------------------------
;; Expressions (§7.5-7.7)

(declare walk-binary)

(defn- walk-right
  "go/printer's walkBinary, the part of a right operand r of the operator o (precedence
  prec): [has4 has5 max-problem]."
  [o prec r]
  (cond
    (binary? r) (if (> (long (bin-prec r)) (long prec)) (walk-binary r) [false false 0])
    (and (seq? r) (= (op r) "deref") (= 2 (count r)))
    [false false (if (= o "/") 5 0)]
    (unary? r)
    (let [s (str o (unary-op r))]
      [false false (cond (#{"/*" "&&" "&^"} s) 5 (#{"++" "--"} s) 4 :else 0)])
    :else [false false 0]))

(defn- walk-prefixes
  "go/printer's walkBinary of each left-nested prefix of f: (+ a b c d) is (+ (+ (+ a b) c) d),
  whose prefixes (+ a b), (+ a b c) and f are walked in one pass (each prefix's walk is its
  left prefix's and its right operand's): a vector, f's last."
  [f]
  (let [prec (bin-prec f)
        o (bin-op f)
        xs (vec (rest f))
        x1 (nth xs 0)
        [h4 h5 mp] (if (and (binary? x1) (>= (long (bin-prec x1)) (long prec))) (walk-binary x1) [false false 0])]
    (loop [i 1 acc [(or (= prec 4) h4) (or (= prec 5) h5) mp] out []]
      (if (< i (count xs))
        (let [[rh4 rh5 rmp] (walk-right o prec (nth xs i))
              [a4 a5 amp] acc
              w [(or a4 rh4) (or a5 rh5) (max (long amp) (long rmp))]]
          (recur (inc i) w (conj out w)))
        out))))

(defn- walk-binary
  "go/printer's walkBinary: [has4 has5 max-problem]."
  [f]
  (peek (walk-prefixes f)))

(defn- cutoff-of [[has4 has5 mp] depth]
  (cond
    (pos? mp) (inc mp)
    (and has4 has5) (if (= depth 1) 5 4)
    (= depth 1) 6
    :else 4))

(defn- cutoff [f depth] (cutoff-of (walk-binary f) depth))

(defn- diff-prec [x prec]
  (if (and (binary? x) (= prec (bin-prec x))) 0 1))

(defn- reduce-depth [d] (max 1 (dec d)))

(defn- paren-operand
  "An operand of && or || the source parenthesized (:go/paren, C3): gc removes dead branches
  by syntax and does not look through parentheses."
  [x]
  (if (e/full?)
    (expr0 x 1)
    (do (e/break-to! (line-of x))
        (tok "(")
        (binding [*header* false] (expr0 x 1))
        (tok ")"))))

(defn- binary-expr
  "go/printer's binaryExpr. An n-ary form is a left-nested chain, (+ a b c) printed as
  (+ (+ a b) c): its prefixes are printed in one pass, each with its own cutoff, as the
  recursion through them would (each prefix's expr1 first moving to f's line, then its left
  operand, then its operator and right operand), without making the prefixes."
  [f prec1 cut depth]
  (let [prec (bin-prec f)]
    (if (and (< prec prec1) (not (e/full?)))
      (do (tok "(")
          (binding [*header* false] (expr0 f (reduce-depth depth)))
          (tok ")"))
      (let [xs (vec (rest f))
            k (count xs)
            o (bin-op f)
            ;; the cutoff of each prefix (op x1 .. xj), j = 2 .. k (f's is cut)
            cuts (if (> k 2)
                   (conj (mapv #(cutoff-of % depth) (pop (walk-prefixes f))) cut)
                   [cut])
            t (line-of f)
            x1 (nth xs 0)]
        (dotimes [_ (- k 2)] (e/break-to! t))
        (if (:go/paren (meta x1))
          (paren-operand x1)
          (expr1 x1 prec (+ depth (diff-prec x1 prec))))
        (dotimes [i (dec k)]
          (let [blank? (< (long prec) (long (nth cuts i)))
                y (nth xs (inc i))]
            (when blank? (sp))
            (ptok o (op-pos f i))
            (let [yt (child-target f (+ i 2) y)]
              (if (and yt (or (= yt :break) (> (long yt) (e/line))))
                (e/break-to! yt)
                (when blank? (sp))))
            (if (:go/paren (meta y))
              (paren-operand y)
              (expr1 y (inc prec) (inc depth)))))))))

(defn- call-args
  "(args) of a call; a final (spread xs) is xs...."
  [f xs depth offset]
  (element-list "(" ")" xs
                (fn [x _]
                  (if (and (seq? x) (= (op x) "spread"))
                    (do (expr0 (second x) depth) (ptok "..." (fp f :ellipsis)))
                    (expr0 x depth)))
                {:parent f :offset offset :open-pos (fp f :lparen) :close-pos (fp f :rparen)}))

(defn- callee [h depth]
  (cond
    (and (seq? h) (= (op h) "func") (not (e/full?))) (do (tok "(") (type-expr h) (tok ")"))
    :else (expr1 h 7 depth)))

(defn- lit-type-needs-parens? [t]
  (or (symbol? t) (go-sym? t)
      (and (seq? t) (not (contains? type-heads (op t))))
      (and (seq? t) (= (op t) "inst"))))

(defn- lit-elements [f]
  "The elements of (lit T ...): [:pos x] [:key k v] [:field kw v]."
  (loop [xs (seq (nnext f)) i 2 acc []]
    (if-not xs
      acc
      (let [x (first xs)]
        (cond
          (keyword? x) (if (next xs)
                         (recur (nnext xs) (+ i 2) (conj acc {:kind :field :key x :value (second xs) :i i}))
                         (fail "a field key without a value" f))
          (vector? x) (if (= 2 (count x))
                        (recur (next xs) (inc i) (conj acc {:kind :key :key (first x) :value (second x) :i i :src x}))
                        (fail "a key-value element is [key value]" x))
          :else (recur (next xs) (inc i) (conj acc {:kind :pos :value x :i i :src x})))))))

(defn- key-size
  "The printed width of a key, for gofmt's alignment decision."
  [el]
  (if (= (:kind el) :field)
    (count (name (:key el)))
    (let [k (:key el)]
      (cond
        (symbol? k) (count (ident-string k))
        (string? k) (count (text/go-string k))
        (number? k) (count (str k))
        :else 10))))

(defn- composite-lit [f depth]
  (let [t (second f)
        wrap? (and *header* (not= t '_) (lit-type-needs-parens? t) (not (e/full?)))]
    (when wrap? (tok "("))
    (binding [*header* false]
      (when-not (= t '_) (type-expr t))
      (let [els (lit-elements f)
            start (e/line)
            brk (breaks-of f)
            ts (mapv (fn [el] (child-target f (:i el) (or (:src el) (:value el)) brk)) els)
            nxt (next-targets ts)
            multi? (some (fn [tl] (and tl (or (= tl :break) (> (long tl) start)))) ts)]
        (ptok "{" (fp f :lbrace))
        (e/push-open!)
        (let [n (count els)]
          (doseq [[i el] (map-indexed vector els)]
            (let [tl (nth ts i)]
              (when (pos? i) (tok ",") (sp))
              (e/break-to! tl)
              (binding [e/*next* (or (nth nxt i) e/*next*)]
                (case (:kind el)
                  :pos (expr0 (:value el) 1)
                  (do (if (= (:kind el) :field)
                        (ptok (name (:key el)) (child-pos f (:i el)))
                        (expr0 (:key el) 1))
                      (ptok ":" (if (= (:kind el) :field)
                                  (when (e/full?) (get (:go/acolon (meta f)) (:i el)))
                                  (fp (:src el) :colon)))
                      (if (and multi? (> n 1) (e/lines?)) (vtab) (sp))
                      (expr0 (:value el) 1))))))
          (let [indent (e/pop-open!)
                multi (> (e/line) start)]
            (when (and (e/lines?) (pos? n) multi (e/room? 1)) (tok ","))
            (when (pos? n) (e/soft :trail ","))
            (e/close-break! nil multi false indent)
            (ptok "}" (fp f :rbrace))))))
    (when wrap? (tok ")"))))

(defn- slice-expr [f depth]
  (let [[_ x & idx] f
        idx (vec idx)
        idx (if (< (count idx) 2) (into idx (repeat (- 2 (count idx)) '_)) idx)
        present (filter #(not= % '_) idx)
        blanks? (and (<= depth 1) (> (count present) 1) (some binary? present))]
    (expr1 x 7 1)
    (ptok "[" (fp f :lbrack))
    (binding [*header* false]
      (doseq [[i ix] (map-indexed vector idx)]
        (when (pos? i)
          (when (and blanks? (not= (nth idx (dec i)) '_)) (sp))
          (tok ":")
          (when (and blanks? (not= ix '_)) (sp)))
        (when (not= ix '_) (expr0 ix (inc depth)))))
    (ptok "]" (fp f :rbrack))))

(defn- func-lit
  "(fn params results? body*)."
  [f]
  (let [[_ params & more] f
        [results body] (if (= (first more) :results) [(second more) (nnext more)] [nil more])
        res (results-entries params results)]
    (when-not (vector? params) (fail "fn needs a parameter vector" f))
    (let [indent (line-indent)]
      (ptok "func" (fp f :func))
      (binding [*header* false
                *return-pos* (fp f :return)]
        (signature params res body results)
        (block-body body {:results? (seq res) :end (:go/end (meta f)) :func? true :sep sp
                          :parent f :offset (body-offset f body) :indent indent
                          :lbrace (fp f :lbrace) :rbrace (fp f :rbrace)})))))

(defn- new-arg [x]
  ;; new(T) or Go 1.26's new(value): a type unless the operand is clearly an expression
  ;; A5: a generic type's instance is (inst G T), which prints G[T] as a type or an
  ;; expression; any other list with a plain head is a call (Go 1.26's new(f(x)))
  (if (or (symbol? x) (go-sym? x) (type-form? x))
    (type-expr x)
    (expr0 x 1)))

(defn- print-pl
  "A literal of mode :full (wrap-full) at its position, in its spelling and parentheses."
  [f]
  (with-parens (:parens f)
    (fn []
      (let [v (:v f)]
        (e/at! (:pos f))
        (if (negative-literal? v)
          (do (tok "-") (literal (unary-operand v) (:text f)))
          (literal v (:text f)))))))

(defn- lit-list-tok
  "The token of a literal list ((rune n), (imaginary x), (byte-string ...)): its spelling in
  mode :full (:go/text), else s."
  [f s]
  (ptok (or (when (e/full?) (:go/text (meta f))) s) (fp f :value-pos)))

(defn expr1
  "go/printer's expr1: prints f as an operand of precedence at least prec1."
  [f prec1 depth]
  (e/break-to! (line-of f))
  (cond
    (pl? f) (print-pl f)
    (and (e/full?) (:go/parens (meta f)))
    (with-parens (:go/parens (meta f)) #(expr1 (vary-meta f dissoc :go/parens) 0 depth))
    (binary? f) (binary-expr f prec1 (cutoff f depth) depth)
    (unary? f)
    (if (and (< 6 prec1) (not (e/full?)))
      (do (tok "(") (binding [*header* false] (expr0 f 1)) (tok ")"))
      (let [o (unary-op f) x (unary-operand f)]
        (ptok o (if (= o "*") (fp f :star) (fp f :op-pos)))
        (if (= o "*")
          (if (and (< (prec-of x) 6) (not (e/full?)))
            (do (tok "(") (binding [*header* false] (expr0 x 1)) (tok ")"))
            (expr1 x 6 1))
          (expr1 x 6 depth))))
    (or (symbol? f) (go-sym? f)) (name-tok f)
    (or (nil? f) (true? f) (false? f) (string? f) (char? f) (number? f)) (literal f)
    (seq? f)
    (let [o (op f)]
      (case o
        "lit" (composite-lit f depth)
        "conv" (let [[_ t x] f]
                 (if (and (seq? t) (or (#{"*" "func" "chan"} (op t))) (not (e/full?)))
                   (do (tok "(") (type-expr t) (tok ")"))
                   (type-expr t))
                 (element-list "(" ")" [x] (fn [x _] (binding [*header* false] (expr0 x depth)))
                               {:parent f :offset 2 :open-pos (fp f :lparen) :close-pos (fp f :rparen)}))
        "assert" (let [[_ t x] f]
                   (expr1 x 7 1) (ptok "." (fp f :dot)) (ptok "(" (fp f :lparen)) (type-expr t)
                   (ptok ")" (fp f :rparen)))
        "aget" (let [[_ x i] f]
                 (expr1 x 7 1) (ptok "[" (fp f :lbrack)) (binding [*header* false] (expr0 i (inc depth)))
                 (ptok "]" (fp f :rbrack)))
        "subslice" (slice-expr f depth)
        "inst" (let [[_ g & ts] f]
                 (expr1 g 7 depth)
                 (binding [*header* false] (type-list ts f)))
        "method-expr" (let [[_ t m] f]
                        (if (and (seq? t) (#{"*" "func" "chan"} (op t)) (not (e/full?)))
                          (do (tok "(") (type-expr t) (tok ")"))
                          (type-expr t))
                        (ptok "." (fp f :dot)) (name-tok m))
        "fn" (func-lit f)
        "rune" (lit-list-tok f (text/go-rune (long (second f))))
        "imaginary" (let [x (second f)]
                      (lit-list-tok f (str (text/go-number x) "i")))
        "byte-string" (lit-list-tok f (text/go-byte-string (rest f)))
        "go/call" (let [[_ g & xs] f]
                    (name-tok g)
                    (binding [*header* false] (call-args f xs (if (> (count xs) 1) (inc depth) depth) 2)))
        "go/id" (name-tok f)
        "values" (fail "values outside a return, an assignment or a binding" f)
        "spread" (fail "spread outside the arguments of a call" f)
        "zero" (fail "zero outside a var binding" f)
        "make" (let [[_ t & xs] f
                     depth (if (> (count (rest f)) 1) (inc depth) depth)]
                 (with-parens (when (e/full?) (:go/parens (meta (first f)))) #(name-tok (first f)))
                 (binding [*header* false]
                   (element-list "(" ")" (cons t xs)
                                 (fn [x i] (if (zero? i) (type-expr x) (expr0 x depth)))
                                 {:parent f :offset 1 :open-pos (fp f :lparen) :close-pos (fp f :rparen)})))
        "new" (let [[_ x] f]
                (with-parens (when (e/full?) (:go/parens (meta (first f)))) #(name-tok (first f)))
                (binding [*header* false]
                  (element-list "(" ")" [x] (fn [x _] (new-arg x))
                                {:parent f :offset 1 :open-pos (fp f :lparen) :close-pos (fp f :rparen)})))
        (cond
          (contains? stmt-heads o) (fail "a statement in an expression position" f)
          (type-form? f) (type-expr f)
          (and o (str/starts-with? o ".-") (> (count o) 2))
          (do (expr1 (second f) 7 depth) (ptok "." (fp f :dot)) (ptok (subs o 2) (fp f :name-pos)))
          (and o (str/starts-with? o ".") (> (count o) 1) (not= o "..."))
          (let [[_ recv & xs] f]
            (expr1 recv 7 depth) (ptok "." (fp f :dot)) (ptok (subs o 1) (fp f :name-pos))
            (binding [*header* false] (call-args f xs (if (> (count xs) 1) (inc depth) depth) 2)))
          :else
          (let [[h & xs] f
                depth (if (> (count xs) 1) (inc depth) depth)]
            (callee h depth)
            (binding [*header* false] (call-args f xs depth 1))))))
    (keyword? f) (fail "a keyword in an expression position" f)
    (vector? f) (fail "a vector in an expression position" f)
    :else (fail "not an expression" f)))

(defn expr0 [f depth] (expr1 f 0 depth))

(defn- expr-list
  "e1, e2, ...: (values ...) or one expression; the values on the line of the values form,
  each after the first on its recorded line (its own, or the values' :go/breaks)."
  [f depth]
  (let [vs? (and (seq? f) (= (op f) "values"))
        xs (if vs? (rest f) [f])]
    (when vs? (e/break-to! (line-of f)))
    (comma-list f 1 xs #(expr0 % depth))))

(defn- n-values [f] (if (and (seq? f) (= (op f) "values")) (count (rest f)) 1))

;; ---------------------------------------------------------------------------------------
;; Statements (§7)

(defn- zero-form? [f] (and (seq? f) (= (op f) "zero")))

(def ^:dynamic *in-group*
  "Mode :full: true for a spec of a local var or type ( ... ) group (its keyword is the
  group's)."
  false)

(defn- targets [t] (if (and (seq? t) (= (op t) "values")) (vec (rest t)) [t]))

(defn binding-stmt
  "A let binding pair as a Go statement: :=, var, const (§7.3)."
  [target init]
  (let [ts (targets target)
        ms (map meta ts)
        tm (meta target)
        const? (or (:const tm) (some :const ms))
        var? (or (:var tm) (some :var ms))
        typ (some #(when (contains? % :tag) (:tag %)) ms)
        names (fn [] (name-list ts))
        kw-pos (fp target :tok-pos)]
    (cond
      const? (do (when-not *in-group* (ptok "const" kw-pos) (sp)) (names)
                 (when typ (sp) (type-expr typ))
                 (sp) (tok "=") (sp) (expr-list init 1))
      (or var? typ) (do (when-not *in-group* (ptok "var" kw-pos) (sp)) (names)
                        (when typ (sp) (type-expr typ))
                        (when-not (zero-form? init)
                          (sp) (tok "=") (sp) (expr-list init 1)))
      :else (let [depth (if (and (> (count ts) 1) (> (n-values init) 1)) 2 1)]
              (comma-list target 1 ts #(expr0 % depth))
              (sp) (ptok ":=" kw-pos) (sp) (expr-list init depth)))))

(defn- type-binding-stmt [nm t]
  (let [tps (:type-params (meta nm))]
    (binding [*generic* (boolean tps)]
      (when-not *in-group* (ptok "type" (fp nm :tok-pos)) (sp))
      (name-tok nm)
      (when tps (type-params tps))
      (sp)
      (when (:alias (meta nm)) (tok "=") (sp))
      (type-expr t))))

(defn- assign-stmt [f]
  (let [[_ place a b] f]
    (case (count f)
      3 (let [depth (if (and (> (n-values place) 1) (> (n-values a) 1)) 2 1)]
          (expr-list place depth) (sp) (ptok "=" (fp f :tok-pos)) (sp) (expr-list a depth))
      4 (let [aop (assign-ops (if (symbol? a) (name a) (str a)))]
          (when-not aop (fail "not an assignment operator" a))
          (expr0 place 1) (sp) (ptok aop (fp f :tok-pos)) (sp) (expr0 b 1))
      (fail "set! takes 2 or 3 arguments" f))))

(defn simple-stmt
  "A simple statement: an init or post statement, a select communication, an expression
  statement, an assignment, a := binding written as [target init]."
  [f]
  (cond
    (vector? f) (case (count f)
                  2 (binding-stmt (first f) (second f))
                  1 (simple-stmt (first f))
                  (fail "an init vector holds one statement or one binding" f))
    (seq? f)
    (case (op f)
      "set!" (assign-stmt f)
      "aset" (let [[_ a i v] f]
               (expr1 a 7 1) (ptok "[" (fp f :lbrack)) (expr0 i 2) (ptok "]" (fp f :rbrack))
               (sp) (ptok "=" (fp f :tok-pos)) (sp) (expr0 v 1))
      "inc!" (do (expr0 (second f) 2) (ptok "++" (fp f :tok-pos)))
      "dec!" (do (expr0 (second f) 2) (ptok "--" (fp f :tok-pos)))
      ">!" (let [[_ ch v] f] (expr0 ch 1) (sp) (ptok "<-" (fp f :arrow)) (sp) (expr0 v 1))
      (expr0 f 1))
    :else (expr0 f 1)))

(defn- clause? [f] (and (seq? f) (#{"case" "default"} (op f))))

(defn- control-clause
  "go/printer's controlClause: init; cond; post of if, switch and for."
  [for? init cond post]
  (binding [*header* true]
    (sp)
    (let [init (when (and init (not= init [])) init)
          post (when (and post (not= post '_)) post)
          cond (when (and (some? cond) (not= cond '_)) cond)]
      (if (and (nil? init) (nil? post))
        (when (some? cond) (expr0 cond 1) (sp))
        (do (when init (simple-stmt init))
            (tok ";") (sp)
            (when (some? cond) (expr0 cond 1))
            (if for?
              (do (tok ";") (sp)
                  (when post (simple-stmt post) (sp)))
              (when (some? cond) (sp))))))))

(defn- branch-forms
  "The statement list of a branch: (do ...) is its forms, anything else one statement."
  [b]
  (if (and (seq? b) (= (op b) "do")) (vec (rest b)) [b]))

(defn- branch-opts
  "block-body's :parent and :offset for branch b, child i of parent."
  [parent i b]
  (if (and (seq? b) (= (op b) "do")) {:parent b :offset 1} {:parent parent :offset i}))

(defn- if-like? [f] (and (seq? f) (#{"if" "when" "cond"} (op f))))

(declare if-stmt)

(defn- else-part [els opts]
  (sp) (tok "else") (sp)
  (if (if-like? els)
    (print-stmt els)
    (block-body (branch-forms els) opts)))

(defn- if-stmt [f]
  (let [o (op f)]
    (case o
      "if" (let [[_ & xs] f
                 [init xs] (if (vector? (first xs)) [(first xs) (rest xs)] [nil xs])
                 [c then & more] xs
                 braces {:lbrace (fp f :lbrace) :rbrace (fp f :rbrace)}]
             (when (> (count more) 1) (fail "if takes a condition, then and else" f))
             (ptok "if" (fp f :if)) (control-clause false init c nil)
             (let [ti (if init 3 2)]
               (if (seq more)
                 (let [els (first more)]
                   (block-body (branch-forms then) (merge (branch-opts f ti then)
                                                          {:next (or (line-of els)
                                                                     (when-not (if-like? els)
                                                                       (next-line (branch-forms els))))
                                                           :else-follows? (if-like? els)
                                                           :else-block? (not (if-like? els))}
                                                          braces))
                   (else-part els (merge (branch-opts f (inc ti) els)
                                         {:lbrace (fp f :else-lbrace) :rbrace (fp f :else-rbrace)})))
                 (block-body (branch-forms then) (merge (branch-opts f ti then) braces)))))
      "when" (let [[_ & xs] f
                   [init xs] (if (vector? (first xs)) [(first xs) (rest xs)] [nil xs])
                   [c & body] xs]
               (ptok "if" (fp f :if)) (control-clause false init c nil)
               (block-body (vec body) {:parent f :offset (body-offset f body)
                                       :lbrace (fp f :lbrace) :rbrace (fp f :rbrace)}))
      "cond" (let [pairs (partition 2 (rest f))
                   cps (when (e/full?) (:go/cond (meta f)))
                   braces (fn [k] (when-let [[_ lb rb] (get cps k)] {:lbrace lb :rbrace rb}))]
               (when (odd? (count (rest f))) (fail "cond takes test-branch pairs" f))
               (loop [[[t b] & more] pairs bi 2 k 0]
                 (if (= t :else)
                   (block-body (branch-forms b) (merge (branch-opts f bi b) (braces k)))
                   (do (ptok "if" (first (get cps k))) (control-clause false nil t nil)
                       (if (seq more)
                         (let [[nt nb] (first more)
                               nl (if (= nt :else) (next-line (branch-forms nb)) (line-of nt))]
                           (block-body (branch-forms b) (merge (branch-opts f bi b)
                                                               {:next nl :else-follows? (not= nt :else)
                                                                :else-block? (= nt :else)}
                                                               (braces k)))
                           (sp) (tok "else") (sp)
                           (recur more (+ bi 2) (inc k)))
                         (block-body (branch-forms b) (merge (branch-opts f bi b) (braces k)))))))))))

(defn- clause-list
  "The clauses of a switch, type switch or select (f), between braces."
  [clauses print-head & [f]]
  (let [indent (if (e/bol?) @(:indent e/*p*) (e/cur-indent))]
    (sp) (ptok "{" (fp f :lbrace))
    (e/push-open! indent)
    (let [clauses (vec clauses)]
      (dotimes [i (count clauses)]
        (let [c (nth clauses i)]
          (when-not (clause? c) (fail "not a case or default clause" c))
          (binding [e/*next* (next-line (subvec clauses (inc i)))]
            (e/stmt-break! (line-of c) (zero? i) ";" indent)
            (if (= (op c) "default")
              (do (ptok "default" (fp c :case)) (ptok ":" (fp c :colon))
                  (stmt-list (vec (rest c)) {:indent (inc indent) :parent c :offset 1}))
              (let [[_ head & body] c]
                (ptok "case" (fp c :case)) (sp) (print-head head) (ptok ":" (fp c :colon))
                (stmt-list (vec body) {:indent (inc indent) :parent c :offset 2})))))))
    (e/pop-open!)
    (e/close-break! nil true true indent)
    (when (e/full?) (sp))
    (ptok "}" (fp f :rbrace))))

(defn- case-exprs [v]
  (when-not (vector? v) (fail "case needs a vector" v))
  (e/break-to! (line-of v))
  (comma-list v 0 v #(expr0 % 1)))

(defn- case-types [v]
  (when-not (vector? v) (fail "case needs a vector" v))
  (e/break-to! (line-of v))
  (comma-list v 0 v #(if (nil? %) (tok "nil") (type-expr %))))

(defn- switch-stmt [f]
  (let [xs (rest f)
        [init xs] (if (vector? (first xs)) [(first xs) (rest xs)] [nil xs])
        [tag xs] (if (and (seq xs) (not (clause? (first xs)))) [(first xs) (rest xs)] [nil xs])]
    (ptok "switch" (fp f :switch))
    (binding [*header* true]
      (cond
        (and init (some? tag)) (do (sp) (simple-stmt init) (tok ";") (sp) (expr0 tag 1))
        init (do (sp) (simple-stmt init) (tok ";"))
        (some? tag) (do (sp) (expr0 tag 1))))
    (clause-list xs case-exprs f)))

(defn- type-switch-stmt [f]
  (let [[a b & more] (rest f)
        [init guard clauses] (cond
                               (and (vector? a) (some? b) (not (clause? b))) [a b more]
                               :else [nil a (cons b more)])
        clauses (remove nil? clauses)]
    (ptok "switch" (fp f :switch))
    (binding [*header* true]
      (when init (sp) (simple-stmt init) (tok ";"))
      (sp)
      (let [assert-type (fn [] (ptok "." (fp f :guard-dot)) (ptok "(" (fp f :guard-lparen)) (tok "type")
                          (ptok ")" (fp f :guard-rparen)))]
        (if (vector? guard)
          (let [[x g] guard]
            (name-tok x) (sp) (ptok ":=" (fp f :guard-tok)) (sp)
            (expr1 g 7 1) (assert-type))
          (do (expr1 guard 7 1) (assert-type)))))
    (clause-list clauses case-types f)))

(defn- comm [c]
  (cond
    (vector? c) (let [[t x] c] (binding-stmt t x))
    :else (simple-stmt c)))

(defn- select-stmt [f]
  (ptok "select" (fp f :select))
  (if (and (empty? (rest f)) (not (e/lines?)) (not (e/full?)))
    (do (sp) (tok "{") (tok "}"))
    (clause-list (rest f) comm f)))

(defn- braces-of [f] {:lbrace (fp f :lbrace) :rbrace (fp f :rbrace)})

(defn- for-stmt [f]
  (let [[_ init c post & body] f]
    (when-not (vector? init) (fail "for needs an init vector" f))
    (ptok "for" (fp f :for))
    (control-clause true init c post)
    (block-body (vec body) (merge {:parent f :offset 5} (braces-of f)))))

(defn- while-stmt [f]
  (let [[_ c & body] f]
    (ptok "for" (fp f :for))
    (when-not (true? c) (binding [*header* true] (sp) (expr0 c 1)))
    (block-body (vec body) (merge {:parent f :offset 2} (braces-of f)))))

(defn- range-stmt [f]
  (let [[_ v & body] f
        assign? (:assign (meta f))]
    (when-not (vector? v) (fail "range needs a vector" f))
    (ptok "for" (fp f :for)) (sp)
    (binding [*header* true]
      (let [x (peek v) vars (pop v)]
        (when (seq vars)
          (comma-list v 0 vars #(expr0 % 1))
          (sp) (ptok (if assign? "=" ":=") (fp f :tok-pos)) (sp))
        (ptok "range" (fp f :range)) (sp) (expr0 x 1)))
    (block-body (vec body) (merge {:parent f :offset 2} (braces-of f)))))

(declare label-stmt)

(defn print-stmt
  "Prints one statement form (not a let: stmt-list flattens those)."
  [f]
  (let [o (op f)]
    (case o
      ("set!" "aset" "inc!" "dec!" ">!") (simple-stmt f)
      "go" (do (ptok "go" (fp f :go)) (sp) (expr0 (second f) 1))
      "defer" (do (ptok "defer" (fp f :defer)) (sp) (expr0 (second f) 1))
      "return" (do (ptok "return" (fp f :return))
                   (when (seq (rest f))
                     (sp)
                     (comma-list f 1 (rest f) #(expr0 % 1))))
      "break" (do (ptok "break" (fp f :tok-pos)) (when-let [l (second f)] (sp) (ptok (label-name l) (fp f :label))))
      "continue" (do (ptok "continue" (fp f :tok-pos)) (when-let [l (second f)] (sp) (ptok (label-name l) (fp f :label))))
      "goto" (do (ptok "goto" (fp f :tok-pos)) (sp) (ptok (label-name (second f)) (fp f :label)))
      "fallthrough" (ptok "fallthrough" (fp f :tok-pos))
      "do" (block-body (vec (rest f)) (merge {:parent f :offset 1} (braces-of f)))
      ("if" "when" "cond") (if-stmt f)
      "switch" (switch-stmt f)
      "type-switch" (type-switch-stmt f)
      "select" (select-stmt f)
      "for" (for-stmt f)
      "while" (while-stmt f)
      "range" (range-stmt f)
      ("let" "let-type") (block-body [f] {})
      "label" (label-stmt f (e/cur-indent) false)
      (simple-stmt f))))

;; Statement lists: a let scopes over the rest of its list, so the list is flattened.

(defn- flatten-stmts
  "The items of a statement list: {:form f} or {:bind [target init] :t line} or
  {:type-bind [name type]}; a let (or let-type) last in a list continues the list with its
  body, one that is not last is a block of its own. parent and offset: the list holding the
  forms and the index of the first (for :go/breaks)."
  [forms parent offset]
  (let [forms (vec forms)
        n (count forms)
        brk (breaks-of parent)]
    (into []
          (mapcat
            (fn [i f]
              (cond
                (and (seq? f) (#{"let" "let-type"} (op f)) (= i (dec n)))
                (let [[_ bv & body] f
                      _ (when-not (vector? bv) (fail "let needs a binding vector" f))
                      pairs (partition 2 bv)
                      items (map-indexed
                              (fn [j [t x]]
                                (let [tl (or (line-of t)
                                             (when (zero? j) (line-of f))
                                             (when (seq? x) (line-of x)))]
                                  (if (= (op f) "let")
                                    {:bind [t x] :t tl}
                                    {:type-bind [t x] :t tl})))
                              pairs)]
                  (when (odd? (count bv)) (fail "let needs pairs" f))
                  (concat items (flatten-stmts body f 2)))
                :else [{:form f :t (if parent (child-target parent (+ offset i) f brk) (line-of f))}]))
            (range n) forms))))

(defn- item-t [it] (:t it))

(defn- label-stmt
  "(label :L s?): L: s. A label without a statement is followed by ; when more statements
  follow (more?). Nested labels print in a row (L1: L2: s)."
  [f indent more?]
  (let [[_ l s] f]
    (ptok (label-name l) (fp f :label)) (ptok ":" (fp f :colon))
    (cond
      (some? s) (do (e/stmt-break! (line-of s) false nil
                                   (if (and (seq? s) (= (op s) "label")) (max 0 (dec indent)) indent))
                    (e/push-open! indent)
                    (cond
                      (and (seq? s) (#{"let" "let-type"} (op s))) (block-body [s] {})
                      (and (seq? s) (= (op s) "label")) (label-stmt s indent more?)
                      :else (print-stmt s))
                    (e/pop-open!))
      more? (if (e/lines?) (tok ";") (do (e/nl indent) (tok ";"))))))

(defn- bind-target [it] (first (:bind it)))

(defn- const-bind? [it]
  (when-let [t (bind-target it)]
    (let [ts (targets t)]
      (or (:const (meta t)) (some #(:const (meta %)) ts)))))

(defn- group-consts
  "Joins the bindings of a local const ( ... ) group (C2): a const binding whose target
  carries :go/grouped continues the group of the binding before it."
  [items]
  (reduce (fn [acc it]
            (let [prev (peek acc)]
              (if (and prev (const-bind? it) (:go/grouped (meta (bind-target it)))
                       (or (:const-group prev) (const-bind? prev)))
                (conj (pop acc) (if (:const-group prev)
                                  (update prev :const-group conj it)
                                  {:const-group [prev it] :t (:t prev)}))
                (conj acc it))))
          [] items))

(defn- label-target
  "The first target of an item's declaration, which a labeled declaration's label is on (A9)."
  [it]
  (or (bind-target it) (first (:type-bind it)) (bind-target (first (:const-group it)))))

(defn- label-of
  "The label of a labeled declaration (:go/label on its first target, A9)."
  [it]
  (when-let [t (label-target it)]
    (:go/label (meta t))))

(defn- const-spec
  "One spec of a local const group: names, type and values, or the names alone (:go/implicit)."
  [[target init] keep-type]
  (let [ts (targets target)
        implicit? (:go/implicit (meta target))
        typ (some #(when (contains? (meta %) :tag) (:tag (meta %))) ts)]
    (name-list ts)
    (when-not implicit?
      (when (or typ keep-type) (vtab))
      (when typ (type-expr typ))
      (vtab) (tok "=") (sp) (expr-list init 1))))

(declare keep-type-column)

(defn- const-group
  "const ( specs ) in a function body, at indent: its specs on their recorded lines."
  [its indent]
  (let [specs (mapv :bind its)
        keep (keep-type-column (mapv (fn [[t x]] [t (if (:go/implicit (meta t)) ::none x)]) specs))
        nxts (next-targets (map :t its))]
    (let [t0 (first (first specs))]
      (ptok "const" (fp t0 :tok-pos)) (sp) (ptok "(" (fp t0 :lparen))
      (e/push-open! indent)
      (dotimes [j (count its)]
        (binding [e/*next* (or (nth nxts j) e/*next*)]
          (e/stmt-break! (or (:t (nth its j)) (when-not (e/lines?) :break)) (zero? j) ";" (inc indent))
          (const-spec (nth specs j) (nth keep j))))
      (e/pop-open!)
      (if (e/lines?)
        (e/close-break! nil true true indent)
        (e/nl indent true))
      (ptok ")" (fp t0 :rparen)))))

(defn- group-target
  "The line of a const group's keyword: the line before its first spec when free."
  [t]
  (if (and (integer? t) (> (dec (long t)) (e/line))) (dec (long t)) t))

(def ^:dynamic *group*
  "Mode :full: an atom holding the local var or type ( ... ) group being printed: {:end
  rparen}, or nil."
  nil)

(defn- item-group-pos
  "Mode :full: the :go/pos of the first target of a let item (its declaration's keyword and
  parentheses are there)."
  [it]
  (when (e/full?)
    (cond
      (:bind it) (:go/pos (meta (first (:bind it))))
      (:type-bind it) (:go/pos (meta (first (:type-bind it)))))))

(defn- item-start
  "Mode :full: the position of the first name of a let item."
  [it]
  (let [t (or (first (:bind it)) (first (:type-bind it)))
        t (if (and (seq? t) (= (op t) "values")) (second t) t)]
    (get (:go/pos (meta t)) :name-pos)))

(defn- full-in-group? [it]
  (boolean (and *group* @*group* (or (:bind it) (:type-bind it)))))

(defn- full-group-open!
  "Mode :full: a local var or type declaration with parentheses starts its group: its keyword
  and (."
  [it]
  (when (and *group* (or (:bind it) (:type-bind it)) (not (:const-group it)))
    (let [p (item-group-pos it)]
      (when (and (:lparen p) (not @*group*))
        (ptok (cond (:type-bind it) "type" (const-bind? it) "const" :else "var") (:tok-pos p))
        (sp) (ptok "(" (:lparen p))
        (reset! *group* {:end (:rparen p)})))))

(defn- full-group-close!
  "Mode :full: after items' i-th, the group's ) when the next item is not in it."
  [items i]
  (when (and *group* @*group*)
    (let [end (:end @*group*)
          nx (get items (inc i))
          st (when nx (item-start nx))]
      (when-not (and st end (neg? (compare st end)))
        (ptok ")" end)
        (reset! *group* nil)))))

(defn stmt-list
  "Prints a statement list at indent (opts :indent), each statement on its recorded line.
  :results? makes a final expression the function's return (§6.4). :parent and :offset
  locate the forms in their list (for :go/breaks)."
  [forms {:keys [indent results? parent offset] :as opts}]
  (binding [*group* (when (e/full?) (atom nil))]
  (let [items (group-consts (flatten-stmts forms parent (or offset 0)))
        n (count items)
        nxts (next-targets (map item-t items))]
    (dotimes [i n]
      (let [it (nth items i)
            nxt (or (nth nxts i) e/*next*)]
        (binding [e/*next* nxt]
          (let [f (:form it)
                label? (and (seq? f) (= (op f) "label"))
                directive? (and (seq? f) (= (op f) "go/directive"))
                decl-label (label-of it)]
            (cond
              directive?
              (do (e/stmt-break! (:t it) false ";" indent)
                  (e/comment-line (second f) indent))
              :else
              (do
                (e/stmt-break! (cond
                                 decl-label (or (:go/label-line (meta (label-target it)))
                                                (group-target (:t it)))
                                 (:const-group it) (group-target (:t it))
                                 :else (:t it))
                               (zero? i) ";" (if (or label? decl-label) (max 0 (dec indent)) indent))
                (e/push-open! indent)
                (when decl-label
                  ;; L: on the line before the declaration when free, as gofmt writes it
                  (ptok (label-name decl-label) (fp (label-target it) :label))
                  (ptok ":" (fp (label-target it) :label-colon))
                  (e/stmt-break! (if (:const-group it) (group-target (:t it)) (:t it)) false nil indent))
                (full-group-open! it)
                (binding [*in-group* (full-in-group? it)]
                  (cond
                    (:const-group it) (const-group (:const-group it) indent)
                    (:bind it) (apply binding-stmt (:bind it))
                    (:type-bind it) (apply type-binding-stmt (:type-bind it))
                    label? (label-stmt f indent (< i (dec n)))
                    (and results? (= i (dec n)) (expression-form? f))
                    (do (ptok "return" *return-pos*) (sp) (expr0 f 1))
                    :else (print-stmt f)))
                (full-group-close! items i)
                (e/pop-open!))))))))))

(defn block-body
  "{ statements } at one more indentation than the line of the brace. opts: :results?,
  :end (the recorded line of the closing brace), :func? (a function body: gofmt keeps it on
  one line when the source has it so), :sep (whitespace before the brace), :next (the line
  of what follows the brace), :else-follows?, :indent (the indentation of the line the
  construct began on, when its header may span lines: a function's parameters)."
  [forms {:keys [results? end func? sep next parent offset] :as opts}]
  (let [indent (or (:indent opts) (if (e/bol?) @(:indent e/*p*) (e/cur-indent)))
        start (e/line)
        forms (vec forms)
        one-line? (if (e/lines?)
                    (if (integer? end)
                      (= (long end) start)
                      (and func? (every? #(let [t (line-of %)] (or (nil? t) (= t start))) forms)
                           (not (some (breaks-of parent) (range (or offset 0) (+ (or offset 0) (count forms)))))
                           (or (seq forms) (nil? next) (room? 0))))
                    (and func? (empty? forms)))]
    (if one-line? ((or sep sp)) (sp))
    (ptok "{" (:lbrace opts))
    (e/push-open! indent)
    (binding [e/*next* (if (integer? end) end (or next e/*next*))]
      (when (seq forms)
        (if one-line?
          ;; nothing may break the line: no room before the next line
          (binding [e/*next* (when (e/lines?) (e/line))]
            (sp)
            (stmt-list-one-line forms results? (inc indent)))
          (stmt-list forms {:indent (inc indent) :results? results? :parent parent :offset offset})))
      (e/pop-open!)
      (if one-line?
        (do (when (seq forms) (sp)) (ptok "}" (:rbrace opts)))
        ;; before `else if`, the brace goes to the line of the else-if (its recorded line)
        ;; before a plain else block, the line before its first statement (when free)
        (let [close-end (or end
                            (when (and (:else-follows? opts) (integer? next) (> (long next) (e/line)))
                              next)
                            (when (and (:else-block? opts) (integer? next) (> (dec (long next)) (e/line)))
                              (dec (long next))))]
          (when-not (e/close-break! close-end (> (e/line) start) true indent) (sp))
          (ptok "}" (:rbrace opts)))))))

(defn- stmt-list-one-line
  "A function body on one line: statements separated by semicolons (go/printer's funcBody)."
  [forms results? indent]
  (let [items (group-consts (flatten-stmts forms nil 0))
        n (count items)]
    (dotimes [i n]
      (let [it (nth items i) f (:form it)]
        (when (pos? i) (tok ";") (sp))
        (e/push-open! (dec indent))
        (when-let [l (label-of it)] (tok (label-name l)) (tok ":") (sp))
        (cond
          (:const-group it) (const-group (:const-group it) (dec indent))
          (:bind it) (apply binding-stmt (:bind it))
          (:type-bind it) (apply type-binding-stmt (:type-bind it))
          (and results? (= i (dec n)) (expression-form? f)) (do (tok "return") (sp) (expr0 f 1))
          :else (print-stmt f))
        (e/pop-open!)))))

;; ---------------------------------------------------------------------------------------
;; Declarations (§6)

(defn parse-decl-head
  "[doc opts rest] of the arguments after a declaration's name: an optional doc string, then
  :type-params."
  [xs]
  (let [[doc xs] (if (string? (first xs)) [(first xs) (rest xs)] [nil xs])
        [tps xs] (if (= (first xs) :type-params) [(second xs) (nnext xs)] [nil xs])]
    [doc tps xs]))

(defn- generic-type? [t]
  ;; a receiver type naming type parameters: (* (Stack T)) or (Stack T)
  (let [t (if (and (seq? t) (= (op t) "*")) (second t) t)]
    (and (seq? t) (not (contains? type-heads (op t))))))

(defn func-decl
  "go/func and go/method (§6.4)."
  [f method?]
  (let [[_ nm & xs] f
        [doc tps xs] (parse-decl-head xs)
        [params & more] xs
        _ (when-not (vector? params) (fail "a function needs a parameter vector" f))
        [results body] (if (= (first more) :results) [(second more) (nnext more)] [nil more])
        m (meta nm)
        extern? (:extern m)
        [recv params] (if method? [(first params) (with-meta (vec (rest params)) (meta params))] [nil params])
        res (results-entries params results)]
    (binding [*generic* (boolean (or tps (and recv (generic-type? (if (tagged? recv) (:tag (meta recv)) recv)))))
              *return-pos* (fp f :return)]
      (let [indent (line-indent)]
        (ptok "func" (fp f :func)) (sp)
        (when method?
          (ptok "(" (fp params :recv-opening))
          (if (tagged? recv)
            (do (name-tok recv) (sp) (type-expr (:tag (meta recv))))
            (type-expr recv))
          (ptok ")" (fp params :recv-closing)) (sp))
        (name-tok nm)
        (when tps (type-params tps))
        (signature params res (when-not extern? body) results)
        (when-not extern?
          (block-body (vec body) {:results? (seq res) :end (:go/end (meta f)) :func? true
                                  :parent f :offset (body-offset f body) :indent indent
                                  :sep (if (e/lines?) vtab sp)
                                  :lbrace (fp f :lbrace) :rbrace (fp f :rbrace)}))))))

(defn- spec-name [t] (if (and (seq? t) (= (op t) "values")) (second t) t))

(defn- value-spec
  "Names, type and values of a const or var spec. keep-type: gofmt's type column."
  [target init group? keep-type]
  (let [ts (targets target)
        typ (some #(when (contains? (meta %) :tag) (:tag (meta %))) ts)
        sep (if group? vtab sp)]
    (name-list ts)
    (when (or typ (and group? keep-type)) (sep))
    (when typ (type-expr typ))
    (when (not= init ::none)
      (sep) (tok "=") (sp) (expr-list init 1))))

(defn- keep-type-column
  "go/printer's keepTypeColumn over the specs [target init]."
  [specs]
  (let [n (count specs)
        m (transient (vec (repeat n false)))]
    (loop [i 0 i0 -1 keep false]
      (if (< i n)
        (let [[t init] (nth specs i)
              has-values (not= init ::none)
              typed (some #(contains? (meta %) :tag) (targets t))
              [i0 keep] (if has-values
                          (if (neg? i0) [i false] [i0 keep])
                          (do (when (>= i0 0) (doseq [j (range i0 i)] (when keep (assoc! m j true))))
                              [-1 keep]))
              keep (or keep (boolean typed))]
          (recur (inc i) i0 keep))
        (do (when (>= i0 0) (doseq [j (range i0 n)] (when keep (assoc! m j true))))
            (persistent! m))))))

(defn- spec-t [v]
  (or (line-of v) (line-of (spec-name (first v))) (when (seq? (second v)) (line-of (second v)))))

(defn- group-decl
  "kw ( specs ): print-spec prints one spec vector given its index (f: the declaration)."
  [kw doc specs print-spec meta-of & [f]]
  (ptok kw (fp f :tok-pos)) (sp) (ptok "(" (fp f :lparen))
  (let [indent 0]
    (if (empty? specs)
      (ptok ")" (fp f :rparen))
      (let [specs (vec specs)
            last-start (volatile! (e/line))
            first-line (e/line)]
        (e/push-open! 0)
        (dotimes [i (count specs)]
          (let [s (nth specs i)
                m (meta-of s)
                dirs (directives-of m)
                pre (pre-lines (:doc m) dirs)
                t (spec-t s)]
            (binding [e/*next* (next-line (subvec specs (inc i)))]
              (cond
                (and (e/lines?) (integer? t))
                (do (if (pos? pre)
                      (e/stmt-break! (max (- (long t) pre) (inc (e/line))) false ";" 1)
                      (e/stmt-break! t (zero? i) ";" 1)))
                (e/lines?) (e/stmt-break! (if (pos? pre) :break nil) (zero? i) ";" 1)
                :else (e/nl 1 (or (zero? i) (> (e/line) @last-start)))))
            (when (pos? pre)
              (when-not (e/bol?) (e/nl 1))
              (write-pre (:doc m) dirs 1)
              (when (and (e/lines?) (integer? t)) (e/stmt-break! t true nil 1)))
            (vreset! last-start (e/line))
            (print-spec s i)))
        (e/pop-open!)
        (if (e/lines?)
          (e/close-break! nil true true indent)
          (e/nl 0 true))
        (ptok ")" (fp f :rparen))))))

(defn- const-var-decl [f kw]
  (let [[_ & xs] f
        [doc xs] (if (string? (first xs)) [(first xs) (rest xs)] [nil xs])]
    (if (every? vector? xs)
      ;; a group
      (let [specs (mapv (fn [v] [(first v) (if (> (count v) 1) (second v) ::none)]) xs)
            keep (keep-type-column specs)
            group? (> (count specs) 1)]
        (group-decl kw doc xs
                    (fn [v i] (let [[t init] (nth specs i)] (value-spec t init group? (nth keep i))))
                    (fn [v] (meta (spec-name (first v))))
                    f))
      (let [[t init] xs]
        (ptok kw (fp f :tok-pos)) (sp)
        (value-spec t (if (> (count xs) 1) init ::none) false false)))))

(defn- type-spec [nm tps t group?]
  (name-tok nm)
  (binding [*generic* (boolean tps)]
    (when tps (type-params tps))
    (if group? (vtab) (sp))
    (when (:alias (meta nm)) (tok "=") (sp))
    (type-expr t)))

(defn- parse-type-spec [xs]
  ;; Name doc? (:type-params [...])? type
  (let [[nm & xs] xs
        [doc tps xs] (parse-decl-head xs)]
    [nm doc tps (first xs)]))

(defn- type-decl [f]
  (let [[_ & xs] f
        [gdoc gxs] (if (string? (first xs)) [(first xs) (rest xs)] [nil xs])]
    (if (or (empty? gxs) (every? vector? gxs))
      (group-decl "type" gdoc gxs
                  (fn [v _] (let [[nm _ tps t] (parse-type-spec (seq v))]
                              (type-spec nm tps t (> (count gxs) 1))))
                  (fn [v] (meta (first v)))
                  f)
      (let [[nm _ tps t] (parse-type-spec xs)]
        (ptok "type" (fp f :tok-pos)) (sp)
        (type-spec nm tps t false)))))

(defn decl-doc-and-directives
  "[doc directives] of a top-level form."
  [f]
  (let [o (op f)
        xs (rest f)]
    (case o
      ("go/func" "go/method") (let [nm (first xs)
                                    [doc] (parse-decl-head (rest xs))]
                                [doc (directives-of (meta nm))])
      "go/type" (if (string? (first xs))
                  [(first xs) []]
                  (if (every? vector? xs)
                    [nil []]
                    (let [[nm doc] (parse-type-spec xs)] [doc (directives-of (meta nm))])))
      ("go/const" "go/var") (if (string? (first xs))
                              [(first xs) []]
                              (if (every? vector? xs)
                                [nil []]
                                (let [nm (spec-name (first xs))]
                                  [(:doc (meta nm)) (directives-of (meta nm))])))
      [nil []])))

(defn top-decl
  "Prints a top-level declaration form, after its doc comment and directives."
  [f]
  (case (op f)
    "go/func" (func-decl f false)
    "go/method" (func-decl f true)
    "go/type" (type-decl f)
    "go/const" (const-var-decl f "const")
    "go/var" (const-var-decl f "var")
    (fail "not a declaration" f)))

(ns arbace.repr.ocaml.prep
  "The read level's own verdicts for the files a package's build reads otherwise than as an implementation or an interface
  (doc/ocaml/OCAML-SURVEY.md, \"As built: the build's own reads\", 2026-11-22): OCaml's parser rejects them as they stand
  (the read level's Parse.implementation and Parse.interface), and each is judged as its package's own build reads it:

    a script        a file whose first line is `#!...ocaml` (topkg's pkg/pkg.ml, cmdliner's build.ml: `ocaml FILE`) or one a
                    unit of its package hands to Toploop.use_file (astring's astring_top_init.ml): the toplevel's read,
                    toploop.ml's use_lexbuf (Lexer.skip_hash_bang, then Parse.use_file);
    a cppo input    a file a rule of its directory's dune file runs the package's mucppo on (yojson's lib/*.cppo.ml(i):
                    `(run mucppo/mucppo.exe %{out} -o %{targets})`), and the files those inputs #include (type.ml,
                    util.ml, write.mli): mucppo's output (mucppo, below: a port of the package's own lib/mucppo/mucppo.ml,
                    held to its SHA-256), the .ml it includes that dune's ocamllex stanza makes generated by the native
                    ocamllex (arbace.repr.ocaml.ocamllex), read as the target's kind;
    a stdlib template  stdlib/templates/float.template.mli and moreLabels.template.mli: tools/sync_stdlib_docs's
                    expansion (sync-stdlib-docs, below: its perl chain ported) byte for byte the tarball's stdlib/float.mli
                    and stdlib/moreLabels.mli, which the expansion is, read as an interface.

  own-build PATH [TEST-PATH] gives [:pass how] or [:fail why]; with TEST-PATH (a negative control) PATH's bytes are judged
  by TEST-PATH's rule in TEST-PATH's place. mucppo is a port of mucppo (https://github.com/Leonidas-from-XIV/mucppo, as
  vendored in yojson 3.0.0's lib/mucppo/mucppo.ml, CC0 1.0); sync-stdlib-docs ports the perl substitutions of OCaml 5.5.0's
  tools/sync_stdlib_docs (LGPL 2.1 with the OCaml linking exception) that make stdlib/float.mli and stdlib/moreLabels.mli;
  the rest is Arbace's own (LICENSE.md)."
  (:require [arbace.repr.ocaml.parser :as p]
            [arbace.string :as str])
  (:import [java.io File]
           [java.util.regex Pattern Matcher]))

(set! *warn-on-reflection* false)

(defn- read-bytes ^bytes [^String path] (java.nio.file.Files/readAllBytes (.toPath (File. path))))
(defn- read-text ^String [^String path] (String. (read-bytes path) "ISO-8859-1"))
(defn- text-bytes ^bytes [^String s] (.getBytes s "ISO-8859-1"))

(defn- sha256 [^bytes b]
  (let [d (.digest (java.security.MessageDigest/getInstance "SHA-256") b)]
    (apply str (map #(format "%02x" (bit-and (long %) 0xff)) d))))

(defn- parse-ok? [^bytes b name kind]
  (= :ok (first (p/parse b name kind))))

;; ---------------------------------------------------------------------------------------------
;; The toplevel's read of a script: toploop.ml's use_lexbuf, Lexer.skip_hash_bang (lexer.mll) then Parse.use_file.
;; skip_hash_bang: "#!" [^ '\n']* '\n' [^ '\n']* "\n!#\n" (three lines) or "#!" [^ '\n']* '\n' (one line), else nothing;
;; the lines it skips are blanked here (their newlines kept), so every later position is the toplevel's.

(defn skip-hash-bang
  "B with the toplevel's hash-bang lines blanked (a copy), or B itself"
  ^bytes [^bytes b]
  (let [n (alength b)
        nl (fn [i] (loop [i i] (cond (>= i n) -1 (= 10 (aget b i)) i :else (recur (inc i)))))]
    (if (and (> n 1) (= 35 (aget b 0)) (= 33 (aget b 1)))
      (let [e1 (nl 0)]
        (if (neg? e1)
          b
          (let [e2 (nl (inc e1))
                three (and (>= e2 0) (<= (+ e2 4) n)
                           (= 33 (aget b (+ e2 1))) (= 35 (aget b (+ e2 2))) (= 10 (aget b (+ e2 3))))
                end (if three (+ e2 3) e1)
                c (aclone b)]
            (dotimes [i end] (when-not (= 10 (aget c i)) (aset-byte c i 32)))
            c)))
      b)))

(defn- script-read [^bytes b name]
  (parse-ok? (skip-hash-bang b) name :toplevel))

;; ---------------------------------------------------------------------------------------------
;; mucppo (yojson 3.0.0's lib/mucppo/mucppo.ml, CC0 1.0, Marek Kubica): its loop, statement for statement. A file's lines are
;; input_line's (the text split at '\n', a last line without one kept); a directive is recognized on String.trim's line, `#if`
;; on the line as read. The state: the printing stack (a list of {:state :was-true}, its top first) and the defined names.

(def mucppo-sha256
  "The SHA-256 of the mucppo.ml this port follows: a package's build judged by it only when its lib/mucppo/mucppo.ml is this one"
  "8a56c3b13d4b565a9e0a2f0bc084c0166add6532f397c59401a5595b15596a8a")

(def ^:private ocaml-version [5 5 0])

(defn- ocaml-trim [^String s]
  (let [ws? #(contains? #{\space \tab \newline \return \formfeed} %)
        n (count s)
        i (loop [i 0] (if (and (< i n) (ws? (.charAt s i))) (recur (inc i)) i))
        j (loop [j n] (if (and (> j i) (ws? (.charAt s (dec j)))) (recur (dec j)) j))]
    (subs s i j)))

(defn- lines-of [^String text]
  (let [ls (vec (.split text "\n" -1))]
    (if (= "" (peek ls)) (pop ls) ls)))

(defn- failwith [msg] (throw (ex-info msg {::failure msg})))

(defn- scan-word
  "Scanf's `PREFIX %s` on S: the word after PREFIX and any blanks"
  [^String s ^String prefix]
  (let [r (subs s (count prefix))
        r (str/triml r)]
    (first (str/split r #"[ \t\n\r\f]" 2))))

(defn- scan-string
  "Scanf's `#include %S`: the OCaml string literal after the blanks"
  [^String s]
  (let [r (str/triml (subs s (count "#include")))]
    (when-not (str/starts-with? r "\"") (failwith (str "scanf: bad input for %S: " (pr-str s))))
    (loop [i 1 sb (StringBuilder.)]
      (when (>= i (count r)) (failwith "scanf: end of input in %S"))
      (let [c (.charAt r i)]
        (cond
          (= c \") (.toString sb)
          (= c \\) (let [d (.charAt r (inc i))]
                     (case d
                       \n (recur (+ i 2) (.append sb \newline))
                       \t (recur (+ i 2) (.append sb \tab))
                       \r (recur (+ i 2) (.append sb \return))
                       \b (recur (+ i 2) (.append sb \backspace))
                       (\\ \" \' \space) (recur (+ i 2) (.append sb d))
                       (recur (+ i 4) (.append sb (char (Long/parseLong (subs r (inc i) (+ i 4)) 10))))))
          :else (recur (inc i) (.append sb c)))))))

(defn- ps-flip-top [ps]
  (if (empty? ps) (failwith "Output stack empty, invalid state") (cons {:state (not (:state (first ps))) :was-true true} (rest ps))))
(defn- ps-should-print [ps] (every? :state ps))
(def ^:private ps-empty (list {:state true :was-true false}))

(defn mucppo
  "mucppo FILENAME's output (mucppo -o OUT FILENAME): the text it writes, or an ex-info of its failure. OPEN gives a file's
  text by the name a line names (open_in, relative to the directory dune runs it in), nil when there is none"
  [open-text ^String filename]
  (let [out (StringBuilder.)
        run (fn run [^String fname text st]
              (loop [ls (lines-of text) lineno 1 st st]
                (if (empty? ls)
                  (when-not (= ps-empty (:ps st)) (failwith "Output stack messed up, missing #endif?"))
                  (let [line (first ls) t (ocaml-trim line) more (rest ls) ln (inc lineno)
                        {:keys [ps vars]} st]
                    (cond
                      (= t "#else") (recur more ln (assoc st :ps (if (:was-true (first ps))
                                                                   (if (ps-should-print ps) (ps-flip-top ps) ps)
                                                                   (ps-flip-top ps))))
                      (= t "#endif") (recur more ln (assoc st :ps (if (empty? ps) (failwith "tl") (rest ps))))
                      (str/starts-with? t "#define") (recur more ln (update st :vars conj (scan-word t "#define")))
                      (str/starts-with? t "#undef") (recur more ln (update st :vars disj (scan-word t "#undef")))
                      (str/starts-with? t "#include")
                      (let [inc-name (scan-string t)
                            itext (or (open-text inc-name) (failwith (str inc-name ": No such file or directory")))]
                        (run inc-name itext st)
                        (recur more ln st))
                      (str/starts-with? t "#ifdef") (let [v (scan-word t "#ifdef")]
                                                      (recur more ln (assoc st :ps (let [d (contains? vars v)] (cons {:state d :was-true d} ps)))))
                      (str/starts-with? t "#if")
                      (if-let [m (re-matches #"#if OCAML_VERSION >= \(\s*(\d+),\s*(\d+),\s*(\d+)\).*" line)]
                        (let [v (mapv #(Long/parseLong %) (rest m))
                              ge (>= (compare ocaml-version v) 0)]
                          (recur more ln (assoc st :ps (cons {:state ge :was-true ge} ps))))
                        (failwith (str "Parsing #if in file " fname " line " lineno " failed, exiting")))
                      (str/starts-with? t "#elif defined")
                      (if (:was-true (first ps))
                        (recur more ln (assoc st :ps (if (ps-should-print ps) (ps-flip-top ps) ps)))
                        (let [v (scan-word t "#elif defined")]
                          (recur more ln (if (contains? vars v) (assoc st :ps (ps-flip-top ps)) st))))
                      :else (do (when (ps-should-print ps) (.append out line) (.append out "\n"))
                                (recur more ln st)))))))]
    (run filename (or (open-text filename) (failwith (str filename ": No such file or directory"))) {:ps ps-empty :vars #{}})
    (.toString out)))

;; ---------------------------------------------------------------------------------------------
;; dune: the s-expressions of a directory's dune file, as far as its rules and ocamllex stanzas need

(defn- dune-sexps [^String text]
  (let [n (count text)]
    (letfn [(skip [i] (loop [i i]
                        (cond (>= i n) i
                              (Character/isWhitespace (.charAt text i)) (recur (inc i))
                              (= \; (.charAt text i)) (recur (loop [j i] (if (or (>= j n) (= \newline (.charAt text j))) j (recur (inc j)))))
                              :else i)))
            (item [i] (let [i (skip i) c (.charAt text i)]
                        (cond
                          (= c \() (loop [j (inc i) acc []]
                                     (let [j (skip j)]
                                       (if (= \) (.charAt text j)) [acc (inc j)]
                                           (let [[x k] (item j)] (recur k (conj acc x))))))
                          (= c \") (let [sb (StringBuilder.)]
                                     (loop [j (inc i)]
                                       (let [d (.charAt text j)]
                                         (cond (= d \") [(.toString sb) (inc j)]
                                               (= d \\) (do (.append sb (.charAt text (inc j))) (recur (+ j 2)))
                                               :else (do (.append sb d) (recur (inc j)))))))
                          :else (let [j (loop [j i] (if (or (>= j n) (Character/isWhitespace (.charAt text j))
                                                            (contains? #{\( \) \"} (.charAt text j))) j (recur (inc j))))]
                                  [(subs text i j) j]))))]
      (loop [i 0 acc []]
        (let [i (skip i)]
          (if (>= i n) acc (let [[x j] (item i)] (recur j (conj acc x)))))))))

(defn- field [sexp k] (some #(when (and (vector? %) (= k (first %))) %) sexp))

(defn- dune-of
  "DIR's dune file: {:rules [{:target T :input S :prep P}] :ocamllex #{MODULE}}, the rules those that run a preprocessor P on
  %{out} (`(run P %{out} -o %{targets})`); nil without a dune file"
  [^File dir]
  (let [f (File. dir "dune")]
    (when (.exists f)
      (let [xs (dune-sexps (slurp f))]
        {:rules (vec (for [x xs :when (and (vector? x) (= "rule" (first x)))
                           :let [t (second (field x "targets"))
                                 out (some #(when (and (vector? %) (= ":out" (first %))) (second %)) (rest (field x "deps")))
                                 run (second (field x "action"))]
                           :when (and t out (vector? run) (= "run" (first run)) (= 5 (count run))
                                       (= ["%{out}" "-o" "%{targets}"] (subvec run 2)))]
                       {:target t :input out :prep (nth run 1)}))
         :ocamllex (set (mapcat rest (filter #(and (vector? %) (= "ocamllex" (first %))) xs)))}))))

(def ^:private generated (atom {}))

(defn- generated-ml
  "NAME.ml as dune's ocamllex stanza makes it from NAME.mll in DIR (the native ocamllex, once a source's text), or nil"
  [^File dir dune ^String name]
  (let [m (second (re-matches #"(.+)\.ml" name))
        src (File. dir (str m ".mll"))]
    (when (and m (contains? (:ocamllex dune) m) (.exists src))
      (let [text (read-text (.getPath src))
            k [(.getCanonicalPath src) name text]]
        (if (contains? @generated k)
          (get @generated k)
          (let [gen (requiring-resolve 'arbace.repr.ocaml.ocamllex/generate)
                r (gen text (str m ".mll") name true)
                ml (when (= 0 (:status r)) (:ml r))]
            (swap! generated assoc k ml)
            ml))))))

(defn- cppo-run
  "The output of DIR's RULE (mucppo on its input), the file at INPUT-PATH read from SUBST's bytes when given (a control), every
  other file from DIR: [:ok text] or [:fail why]"
  [^File dir dune rule subst-path ^bytes subst]
  (let [prep (:prep rule)
        src (File. dir (str (second (re-matches #"(.*)\.exe" prep)) ".ml"))]
    (cond
      (not (re-find #"(^|/)mucppo\.exe$" prep)) [:fail (str "the rule runs " prep ", not mucppo")]
      (not (.exists src)) [:fail (str "no " (.getPath src) ": the package's mucppo is not its source")]
      (not= mucppo-sha256 (sha256 (read-bytes (.getPath src)))) [:fail (str (.getName src) " is not the mucppo the port follows")]
      :else
      (let [open (fn [^String nm]
                   (let [f (File. dir nm)]
                     (cond (and subst (= (.getCanonicalPath f) subst-path)) (String. subst "ISO-8859-1")
                           (.exists f) (read-text (.getPath f))
                           :else (generated-ml dir dune nm))))]
        (try [:ok (mucppo open (:input rule))]
             (catch arbace.lang.ExceptionInfo e
               (if-let [m (::failure (ex-data e))] [:fail (str "mucppo fails: " m)] (throw e))))))))

(defn- includes-of
  "The names mucppo's run of FILE in DIR #includes (and theirs), the directives read as mucppo reads them"
  [^File dir dune ^String file]
  (loop [todo [file] seen #{}]
    (if-let [[x & more] (seq todo)]
      (if (seen x)
        (recur more seen)
        (let [f (File. dir x)
              text (cond (.exists f) (read-text (.getPath f)) :else (generated-ml dir dune x))
              incs (when text (for [l (lines-of text) :let [t (ocaml-trim l)] :when (str/starts-with? t "#include")]
                                (try (scan-string t) (catch Throwable _ nil))))]
          (recur (concat more (remove nil? incs)) (conj seen x))))
      (disj seen file))))

(defn- kind-of-name [^String n] (if (str/ends-with? n ".mli") :intf :impl))

(defn- cppo-rules
  "DIR's rules of which BASE is the input or an included file: [[rule :input|:included] ...], the dune file's order"
  [^File dir dune ^String base]
  (vec (for [r (:rules dune)
             :let [how (cond (= base (:input r)) :input
                             (contains? (includes-of dir dune (:input r)) base) :included)]
             :when how]
         [r how])))

(defn- judge-cppo [^File dir dune pairs subst-path subst]
  (let [verdicts (for [[r how] pairs]
                   (let [[v x] (cppo-run dir dune r subst-path subst)]
                     (if (= :fail v)
                       [:fail x r how]
                       (if (parse-ok? (text-bytes x) (:target r) (kind-of-name (:target r)))
                         [:pass nil r how]
                         [:fail (str (:target r) ", mucppo's output of " (:input r) ", is rejected") r how]))))
        bad (first (filter #(= :fail (first %)) verdicts))
        [_ _ r how] (first verdicts)]
    (if bad
      [:fail (second bad)]
      [:pass (if (= how :input)
               (str "mucppo's output (" (:target r) ", its dune rule's) read as " (if (= :intf (kind-of-name (:target r))) "an interface" "an implementation"))
               (str "read as part of mucppo's outputs that #include it (" (str/join ", " (map #(:target (nth % 2)) verdicts)) ")"))])))

;; ---------------------------------------------------------------------------------------------
;; tools/sync_stdlib_docs (OCaml 5.5.0): the perl substitutions that make stdlib/float.mli and stdlib/moreLabels.mli from the
;; templates, each `perl -p -e` a line at a time (a line with its '\n'), a regex's `.` any byte but '\n' ((?d)), the /e
;; substitutions' `tail -n +K FILE` the text from FILE's K-th line on.

(defn- perl-lines [^String text] (re-seq #"(?s)[^\n]*\n|[^\n]+$" text))

(defn- perl-p
  "`perl -p -e 's/RE/REPL/[g]'` on TEXT: REPL a function of the matcher (its replacement text) or a string (literal)"
  [^String text ^String re repl global]
  (let [pat (Pattern/compile (str "(?d)" re))]
    (apply str (for [l (perl-lines text)]
                 (let [m (.matcher pat l) sb (StringBuffer.)]
                   (loop [found (.find m)]
                     (if found
                       (do (.appendReplacement m sb (Matcher/quoteReplacement (if (string? repl) repl (repl m))))
                           (if global (recur (.find m)) (.appendTail m sb)))
                       (.appendTail m sb)))
                   (.toString sb))))))

(defn- g [n] (fn [^Matcher m] (.group m (int n))))

(defn- lab [t] (perl-p t " [a-z_]+:([A-Za-z\\('])" #(str " " ((g 1) %)) true))
(defn- lablab [t] (perl-p t "\\([a-z_]+:([a-z\\('])" #(str "(" ((g 1) %)) true))
(defn- tilde [t] (perl-p t " ~([a-z_]+(?=[ \\]]))" #(str " " ((g 1) %)) true))
(defn- indent [t] (perl-p t "^(.+)$" #(str "  " ((g 1) %)) false))
(defn- labelsdotarg [t] (perl-p t "([A-Z][a-z_]*)Labels\\.(.*)~[a-z]+:" #(str ((g 1) %) "Labels." ((g 2) %)) true))
(defn- labelsdot [t] (perl-p t "([A-Z][a-z_]*)Labels\\." #(str ((g 1) %) ".") true))
(defn- tail-from [^String t k] (apply str (drop (dec k) (perl-lines t))))
(defn- chomp-all [^String s] (str/replace s #"\n+$" ""))

(defn sync-stdlib-docs
  "The text tools/sync_stdlib_docs writes into stdlib/OUT (\"float.mli\" or \"moreLabels.mli\") from the tarball at TOP, the
  template stdlib/templates/NAME read from SUBST (a control's bytes) when given: nil for another OUT"
  [^String top ^String out subst-name ^String subst]
  (let [tpl (fn [nm] (if (= nm subst-name) subst (read-text (str top "/stdlib/templates/" nm))))
        patch (fn [i] (chomp-all (read-text (str top "/tools/unlabel-patches/" i ".mli"))))]
    (case out
      "float.mli"
      (let [fal (tpl "floatarraylabeled.template.mli")
            fau (-> fal lab tilde labelsdotarg labelsdot)
            fal-i (indent fal) fau-i (indent fau)
            t1 (perl-p (tpl "float.template.mli") "FLOATARRAYLAB" (tail-from fal-i 17) false)]
        (perl-p t1 "FLOATARRAY" (tail-from fau-i 17) false))
      "moreLabels.mli"
      (let [m (-> (tpl "moreLabels.template.mli")
                  (perl-p "HASHTBL" (tail-from (indent (tpl "hashtbl.template.mli")) 19) false)
                  (perl-p "MAP" (tail-from (indent (tpl "map.template.mli")) 19) false)
                  (perl-p "SET" (tail-from (indent (tpl "set.template.mli")) 19) false)
                  (perl-p "type statistics =" "type statistics = Hashtbl.statistics =" false)
                  (perl-p "type \\(!'a, !'b\\) t" "type (!'a, !'b) t = ('a, 'b) Hashtbl.t" false)
                  (perl-p "module Make \\(H : HashedType\\) : S with type key = H.t" (patch 1) false)
                  (perl-p "module MakeSeeded \\(H : SeededHashedType\\) : SeededS with type key = H.t" (patch 2) false)
                  (perl-p "module Make \\(Ord : OrderedType\\) : S with type key = Ord.t" (patch 3) false)
                  (perl-p "module Make \\(Ord : OrderedType\\) : S with type elt = Ord.t" (patch 4) false))]
        m)
      nil)))

(def ^:private template-outputs {"float.template.mli" "float.mli" "moreLabels.template.mli" "moreLabels.mli"})

(defn- judge-template [^String top ^String tname ^bytes b]
  (let [out (template-outputs tname)
        got (sync-stdlib-docs top out tname (String. b "ISO-8859-1"))
        want (read-text (str top "/stdlib/" out))]
    (cond
      (not= got want) [:fail (str "tools/sync_stdlib_docs's expansion is not stdlib/" out)]
      (not (parse-ok? (text-bytes got) out :intf)) [:fail (str "stdlib/" out ", its expansion, is rejected")]
      :else [:pass (str "tools/sync_stdlib_docs expands it to stdlib/" out " byte for byte, read as an interface")])))

;; ---------------------------------------------------------------------------------------------
;; The units a package's dune build makes or preprocesses (queue 534, the user's 528-15 decision: yojson's and containers' library
;; rows), for the suite corpus's staging (bin/lib/oi/suite.bash's suite_stage, `build-into`): a unit is given the text dune's build
;; compiles, by one of these rules of its directory's dune file, each a port of the package's own program held to its SHA-256:
;;   mucppo         `(rule (targets T) (deps (:out S) ...) (action (run mucppo/mucppo.exe %{out} -o %{targets})))` (yojson's lib/):
;;                  cppo-run above;
;;   containers-cpp `(library ... (preprocess (action (run %{project_root}/src/core/cpp/cpp.exe %{input-file}))) (flags ...))`
;;                  (containers' src/core/ and src/monomorphic/): containers 3.18's src/core/cpp/cpp.ml, its `[@@@ifge X.Y]` blocks
;;                  against OCaml 5.5, and the stanza's `-open M` flags as their initial `open! M` (ocamlc's -open opens M before
;;                  the unit as Typemod.initial_env's open_implicit_module does, an open with override, which no program-wide flag
;;                  of the row can give one library's units alone), a line directive after it so that every position is the file's;
;;   containers-gen `(rule (targets containers_domain.ml) (action (run ./gen.exe)))` (containers' src/domain/): gen.ml's choice,
;;                  OCaml >= 5.0's text (the literal domain_5 of gen.ml itself);
;;   either-which   `(rule (with-stdout-to selected (run %{ocaml} %{dep:which.ml} %{ocaml_version})))` and
;;                  `(rule (copy# %{read:selected} either.ml))` (either's src/): which.ml's choice for 5.5, either-as-alias.ml,
;;                  copied as dune's copy# copies (a line directive `# 1 "FILE"` first).

(def build-sha256
  "The SHA-256 of the programs the build rules port: a rule applies only when its package's program is this one"
  {"cpp.ml" "a6f9464ae3afba39958f45740a6f84e08e4865d22e92625ebea37651b2af4d3f"
   "gen.ml" "7620b499124e3b335eaa63b05f64d8dd3b20baa8de50b3d63ab316519eb584d9"
   "which.ml" "4422dbdd8c4b3b4398a034649702aaf9090d4a1343db8beacc6a769744625187"})

(defn- held! [^File f]
  (let [want (get build-sha256 (.getName f))]
    (cond (not (.exists f)) (failwith (str "no " (.getPath f) ": the rule's program is not its source"))
          (not= want (sha256 (read-bytes (.getPath f)))) (failwith (str (.getPath f) " is not the program the port follows")))))

(defn- ocaml-quote
  "Printf's %S: String.escaped's text in double quotes"
  [^String s]
  (str "\"" (apply str (for [c s] (case c \" "\\\"" \\ "\\\\" \newline "\\n" \tab "\\t" \return "\\r" \backspace "\\b"
                                     (if (<= 32 (int c) 126) (str c) (format "\\%03d" (int c)))))) "\""))

(defn containers-cpp
  "containers 3.18's src/core/cpp/cpp.ml on TEXT, FILE its argument (Sys.argv.(1), the name its line directives give): the text it
  prints, or an ex-info of its failure. Its loop, case for case: a line is a directive when String.trim's line starts with `[`
  and with one of the prefixes it tests, in its order (its Scanf `[@@@ifle %d.%d]` and the others: the two integers after any
  blanks, the text after the `]` ignored, a failed scan a failure); the elapsed time it prints last is written 0.000"
  [^String text ^String file]
  (let [out (StringBuilder.)
        ver [(nth ocaml-version 0) (nth ocaml-version 1)]
        evalop (fn [op i j] (let [c (compare ver [i j])] (case op :le (<= c 0) :lt (< c 0) :ge (>= c 0) :gt (> c 0))))
        ls (vec (lines-of text))
        n (count ls)
        scan (fn [^String l ^String pre]
               (if-let [m (re-find (re-pattern (str "^" (Pattern/quote pre) "[ \\t\\n\\r]*([-+]?[0-9][0-9_]*)\\.[ \\t\\n\\r]*([-+]?[0-9][0-9_]*)\\]")) l)]
                 [(Long/parseLong (str/replace (nth m 1) "_" "")) (Long/parseLong (str/replace (nth m 2) "_" ""))]
                 (failwith (str "scanf: bad input at " (pr-str l)))))
        parse (fn [pos]
                (if (>= pos n)
                  [:eof]
                  (let [line (nth ls pos) t (ocaml-trim line)]
                    (if (and (not= t "") (= \[ (.charAt t 0)))
                      (let [pre (first (filter #(str/starts-with? t %)
                                               ["[@@@ifle" "[@@@iflt" "[@@@ifge" "[@@@ifgt" "[@@@elifle" "[@@@elifge" "[@@@eliflt"]))]
                        (cond pre (let [[i j] (scan t pre)
                                        op ({"le" :le "lt" :lt "ge" :ge "gt" :gt} (subs pre (- (count pre) 2)))]
                                    [(if (str/starts-with? pre "[@@@if") :if :elif) op i j])
                              (= t "[@@@else_]") [:else]
                              (= t "[@@@endif]") [:endif]
                              :else [:raw line]))
                      [:raw line]))))
        pp-pos (fn [pos] (.append out (str "#" pos " " (ocaml-quote file) "\n")))
        emit (fn [^String l] (.append out l) (.append out "\n"))
        fail (fn [pos msg] (failwith (format "at line %d in '%s': %s" pos file msg)))]
    ;; the states: :top, :cat (the current block is taken), :skip (with elseok); pos counts the lines read (cpp.ml's !pos)
    (loop [pos 0 state :top elseok true]
      (let [[k a b c] (parse pos) p (inc pos)]
        (case state
          :top (case k
                 :eof nil
                 :if (if (evalop a b c) (do (pp-pos p) (recur p :cat true)) (recur p :skip true))
                 :raw (do (emit a) (recur p :top true))
                 (fail p "unexpected elseif|else|endif"))
          :cat (case k
                 :eof (fail pos "unexpected EOF")
                 :if (fail p "nested if not supported")
                 :raw (do (emit a) (recur p :cat true))
                 :endif (do (pp-pos p) (recur p :top true))
                 (recur p :skip false))
          :skip (case k
                  :eof (fail pos "unexpected EOF")
                  :if (fail p "nested if not supported")
                  :raw (recur p :skip elseok)
                  :endif (do (pp-pos p) (recur p :top true))
                  :elif (if (and elseok (evalop a b c)) (do (pp-pos p) (recur p :cat true)) (recur p :skip elseok))
                  :else (if elseok (do (pp-pos p) (recur p :cat true)) (recur p :skip elseok))))))
    (.append out "(* file preprocessed in 0.000s *)\n")
    (.toString out)))

(defn- project-root
  "The directory above DIR (or DIR) that holds dune-project: dune's %{project_root}"
  ^File [^File dir]
  (loop [d dir] (cond (nil? d) dir (.exists (File. d "dune-project")) d :else (recur (.getParentFile d)))))

(defn- dune-build-of
  "DIR's dune file as the build rules need it: {:pp {:prog P :flags [..]} :rules [{:kind :gen|:copy-selected ...}]}"
  [^File dir]
  (let [f (File. dir "dune")]
    (when (.exists f)
      (let [xs (dune-sexps (slurp f))
            lib (first (filter #(and (vector? %) (= "library" (first %))) xs))
            ppa (when lib (second (field lib "preprocess")))
            run (when (and (vector? ppa) (= "action" (first ppa))) (second ppa))]
        {:pp (when (and (vector? run) (= "run" (first run)) (= "%{input-file}" (last run)) (= 3 (count run)))
               {:prog (nth run 1) :flags (vec (rest (field lib "flags")))})
         :rules (vec (for [x xs :when (and (vector? x) (= "rule" (first x)))
                           r [(let [t (second (field x "targets")) a (second (field x "action"))]
                                (when (and t (vector? a) (= ["run" "./gen.exe"] a)) {:kind :gen :target t}))
                              (let [c (field x "copy#")]
                                (when (and c (= "%{read:selected}" (nth c 1 nil))) {:kind :copy-selected :target (nth c 2 nil)}))]
                           :when r]
                       r))
         :selected (some #(let [w (field % "with-stdout-to")]
                            (when (and w (= "selected" (nth w 1 nil))) (nth w 2 nil)))
                         (filter #(and (vector? %) (= "rule" (first %))) xs))}))))

(defn- open-flags [flags]
  (loop [fs flags acc []]
    (if (empty? fs) acc
        (if (= "-open" (first fs)) (recur (drop 2 fs) (conj acc (second fs))) (recur (rest fs) acc)))))

(defn build-unit
  "The text dune's build compiles for PATH (a unit of a package's library, existing or made by a rule of its directory), as
  [:ok text] or [:fail why]; nil when no build rule of this namespace applies to it"
  [^String path]
  (let [f (.getCanonicalFile (File. path)) dir (.getParentFile f) base (.getName f)
        b (dune-build-of dir)
        root (project-root dir)
        rel (str/replace (subs (.getPath f) (inc (count (.getPath root)))) File/separator "/")]
    (try
      (cond
        (nil? b) nil
        (.exists f)
        (when-let [{:keys [prog flags]} (:pp b)]
          (when-not (re-find #"(^|/)cpp/cpp\.exe$" prog) (failwith (str "the library's preprocessor is " prog ", not containers' cpp")))
          (held! (File. root ^String (str/replace (str/replace prog "%{project_root}/" "") #"\.exe$" ".ml")))
          (let [body (containers-cpp (read-text (.getPath f)) rel)
                opens (open-flags flags)]
            [:ok (if (seq opens)
                   (str (apply str (for [m opens] (str "open! " m "\n"))) "# 1 " (ocaml-quote rel) "\n" body)
                   body)]))
        :else
        (when-let [r (first (filter #(= base (:target %)) (:rules b)))]
          (case (:kind r)
            :gen (let [g (File. dir "gen.ml")]
                   (held! g)
                   (let [t (read-text (.getPath g))
                         m (re-find #"(?s)let domain_5 =\s*\{\|(.*?)\|\}" t)]
                     (when-not m (failwith "gen.ml has no domain_5"))
                     ;; gen.ml: Sys.ocaml_version's (major, minor) >= (5, 0): domain_5, written as output_string writes it
                     [:ok (second m)]))
            :copy-selected (let [w (File. dir "which.ml")]
                             (held! w)
                             (when-not (= ["run" "%{ocaml}" "%{dep:which.ml}" "%{ocaml_version}"] (:selected b))
                               (failwith "the rule of `selected` is not which.ml's run"))
                             ;; which.ml: (major, minor) < (4, 12) ? either-as-newtype.ml : either-as-alias.ml
                             (let [sel (if (neg? (compare [(nth ocaml-version 0) (nth ocaml-version 1)] [4 12]))
                                         "either-as-newtype.ml" "either-as-alias.ml")]
                               (let [d (str/replace rel #"[^/]*$" "")]
                                 [:ok (str "# 1 " (ocaml-quote (str d sel)) "\n" (read-text (.getPath (File. dir sel))))]))))))
      (catch arbace.lang.ExceptionInfo e
        (if-let [m (::failure (ex-data e))] [:fail m] (throw e))))))

(defn build-into
  "Each FILE's build text (build-unit, else mucppo's rule of its directory) written into OUTDIR under its name: the lines
  `FILE<TAB>ok|fail<TAB>WHY`"
  [^String outdir files]
  (vec (for [^String path files]
         (let [f (.getCanonicalFile (File. path)) dir (.getParentFile f) base (.getName f)
               r (or (build-unit path)
                     (when-let [dune (dune-of dir)]
                       (when-let [rule (first (filter #(= base (:target %)) (:rules dune)))]
                         (let [[v x] (cppo-run dir dune rule nil nil)] (if (= :ok v) [:ok x] [:fail x]))))
                     [:fail "no build rule of its directory makes or preprocesses it"])]
           (when (= :ok (first r))
             (java.nio.file.Files/write (.toPath (File. outdir base)) (text-bytes (second r))
                                        ^"[Ljava.nio.file.OpenOption;" (into-array java.nio.file.OpenOption [])))
           [path (name (first r)) (if (= :ok (first r)) "" (second r))]))))

;; ---------------------------------------------------------------------------------------------
;; the rule of a file, and the verdict

(defn- top-of-template
  "The tarball's top when PATH is one of its stdlib templates sync_stdlib_docs expands, else nil"
  [^String path]
  (when-let [[_ top nm] (re-matches #"(.*)/stdlib/templates/([A-Za-z]+\.template\.mli)" path)]
    (when (and (contains? template-outputs nm) (.exists (File. (str top "/tools/sync_stdlib_docs")))) [top nm])))

(defn- ocaml-shebang? [^bytes b]
  (let [s (String. b 0 (int (min 200 (alength b))) "ISO-8859-1")
        l (first (str/split-lines s))]
    (boolean (and l (str/starts-with? l "#!") (re-find #"(^#!\s*\S*/env\s+ocaml\s*$)|(^#!\s*\S*/ocaml(\s.*)?$)" l)))))

(defn- use-file-caller
  "A unit of DIR (the file's directory) that hands BASE to Toploop.use_file, or nil"
  [^File dir ^String base]
  (first (for [^File f (sort-by #(.getName ^File %) (or (seq (.listFiles dir)) []))
               :let [n (.getName f)]
               :when (and (re-find #"\.ml$" n) (not= n base)
                          (let [t (read-text (.getPath f))]
                            (re-find (re-pattern (str "Toploop\\.use_file\\b[^\\n]*\"" (Pattern/quote base) "\"")) t)))]
           n)))

(defn rule-of
  "The rule its package's build reads PATH by: [:template top name], [:cppo dir dune pairs], [:script how] or nil"
  [^String path]
  (let [f (.getCanonicalFile (File. path)) dir (.getParentFile f) base (.getName f)]
    (or (when-let [[top nm] (top-of-template (.getPath f))] [:template top nm])
        (when-let [dune (dune-of dir)]
          (let [pairs (cppo-rules dir dune base)] (when (seq pairs) [:cppo dir dune pairs])))
        (when (ocaml-shebang? (read-bytes path)) [:script "the ocaml command's script (#! ... ocaml)"])
        (when-let [u (use-file-caller dir base)] [:script (str "Toploop.use_file's input (" u " names it)")]))))

(defn own-build
  "The read level's own verdict of PATH, a file OCaml's parser rejects as it stands: [:pass how] or [:fail why]. With
  TEST-PATH, PATH's bytes judged by TEST-PATH's rule in TEST-PATH's place (a negative control)"
  ([^String path] (own-build path path))
  ([^String path ^String test-path]
   (let [b (read-bytes path)
         r (rule-of test-path)
         tf (.getCanonicalFile (File. test-path))]
     (case (first r)
       :template (let [[_ top nm] r] (judge-template top nm b))
       :cppo (let [[_ dir dune pairs] r] (judge-cppo dir dune pairs (.getPath tf) b))
       :script (if (script-read b (.getName tf))
                 [:pass (str "read as the toplevel reads " (second r) ": Lexer.skip_hash_bang, then Parse.use_file")]
                 [:fail (str "the toplevel's read (" (second r) ") rejects it")])
       [:fail "its package's build reads it as OCaml (no script, preprocessor or template rule)"]))))

(defn own-build-controls
  "The negative controls: each line `SUBJECT REFERENCE` of CONTROLS-FILE (paths under ROOT; # comments) judges the subject by
  the reference's rule in the reference's place: it must fail. [[subject reference verdict how] ...]"
  [^String root ^String controls-file]
  (vec (for [l (str/split-lines (slurp controls-file))
             :let [[s r] (str/split (str/trim l) #"\s+")]
             :when (and s r (not (str/starts-with? s "#")))]
         (let [[v how] (try (own-build (str root "/" s) (str root "/" r)) (catch Throwable t [:fail (str "failure: " (.getMessage t))]))]
           [s r v how]))))

(defn- cppo-output
  "The text DIR's dune rule of TARGET makes (mucppo on its input), for the oracle's comparison by hand"
  [^String dir ^String target]
  (let [d (.getCanonicalFile (File. dir)) dune (dune-of d)
        r (first (filter #(= target (:target %)) (:rules dune)))]
    (when-not r (failwith (str "no rule of " target " in " dir "/dune")))
    (let [[v x] (cppo-run d dune r nil nil)]
      (if (= :ok v) x (failwith x)))))

(defn -main
  "own-build ROOT FILE...: each file's verdict (FILE relative to ROOT); cppo DIR TARGET: the dune rule's output on stdout;
  sync-stdlib-docs TOP OUT: the expansion of stdlib/OUT on stdout (the last two compared by hand with the host's mucppo,
  ocamllex and tools/sync_stdlib_docs, the oracle tier's); build-into OUTDIR FILE...: each unit's build text written into OUTDIR
  (queue 534: the suite corpus's staging), a line `FILE ok|fail WHY` each, exit 1 when one fails"
  [& args]
  (let [[verb & more] args]
    (case verb
      "own-build" (let [[root & files] more]
                    (doseq [f files]
                      (let [[v how] (try (own-build (str root "/" f)) (catch Throwable t [:fail (str "failure: " (.getMessage t))]))]
                        (println (str f "\t" (name v) "\t" how)))))
      "cppo" (do (print (cppo-output (first more) (second more))) (flush))
      "sync-stdlib-docs" (do (print (sync-stdlib-docs (first more) (second more) nil nil)) (flush))
      "build-into" (let [rows (build-into (first more) (rest more))]
                     (doseq [r rows] (println (str/join "\t" r)))
                     (when (some #(= "fail" (second %)) rows) (System/exit 1)))
      (do (println "usage: -m arbace.repr.ocaml.prep own-build ROOT FILE... | cppo DIR TARGET | sync-stdlib-docs TOP OUT | build-into OUTDIR FILE...") (System/exit 2)))))

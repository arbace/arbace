(ns arbace.repr.ocaml.typer.typeclass
  "Objects and classes (doc/ocaml/TYPER.md, T9): a class signature is an atom {:self t :row t :vars {label [mut virt
  t]} :meths {label [priv virt t]}} (priv :public or [:private kind]); an object or class structure {:self pat
  :fields [field] :sign sign :meths {label id}}, a field [:Tcf_val label mut id [:concrete e]|[:virtual] over]
  [:Tcf_method label priv [:concrete e]|[:virtual]] [:Tcf_initializer e] [:Tcf_inherit cl super vars super-meths]
  [:Tcf_constraint]; the values of a class body: [:self sign meths vars cl-num] (Val_self), [:ivar mut cl-num]
  (Val_ivar), [:anc meths cl-num] (Val_anc)."
  (:require [arbace.repr.ocaml.typer.types :as ty]
            [arbace.repr.ocaml.typer.env :as env]
            [arbace.repr.ocaml.typer.typecore :as tc]
            [arbace.repr.ocaml.typer.typemod :as tm]
            [arbace.string :as str]))

(set! *warn-on-reflection* false)

(def type-error env/type-error)

;; ---------------------------------------------------------------------------------------------
;; Class signatures (ctype.ml)

(def dummy-method "*dummy method*")
(declare signature-of-class-type)

(defn new-class-signature []
  (let [row (ty/newvar)]
    (atom {:self (ty/newty [:Tobject row nil]) :row row :vars {} :meths {}})))

(defn- object-fields [t] (let [d (ty/desc (ty/expand-head t))] (when (= :Tobject (d 0)) (d 1))))

(defn filter-method-row
  "Ctype.filter_method_row: [priv field-type row] of the method name in a row, the row extended when it is open"
  [name priv t]
  (let [t (ty/expand-head t) d (ty/desc t) lv (ty/level t)]
    (case (d 0)
      :Tvar (let [field (ty/newty2 lv [:Tvar nil]) row (ty/newty2 lv [:Tvar nil])
                  kind (if (= :Private priv) (ty/field-private) (ty/field-public))]
              (ty/link! t (ty/newty2 lv [:Tfield name kind field row]))
              [(if (= :Private priv) [:private kind] :public) field row])
      :Tfield (if (= (d 1) name)
                [(if (= :Public priv)
                   (do (when (= :private (ty/field-kind-repr (d 2))) (ty/link-kind! (d 2) (atom :public))) :public)
                   [:private (d 2)])
                 (d 3) (d 4)]
                (let [[p f r] (filter-method-row name priv (d 4))]
                  [p f (ty/newty2 lv [:Tfield (d 1) (d 2) (d 3) r])]))
      :Tnil (if (or (= name dummy-method) (= :Public priv))
              (type-error (str "The method " name " cannot be added to a closed object type"))
              [[:private (atom :absent)] (ty/newty2 lv [:Tvar nil]) t])
      (type-error "filter_method_row"))))

(defn add-method!
  "Ctype.add_method"
  [sign label priv virt t]
  (let [{:keys [meths row]} @sign]
    (if-let [[priv' virt' t'] (get meths label)]
      (let [priv (if (= :public priv')
                   :public
                   (if (= :Public priv)
                     (let [k (second priv')] (when (= :private (ty/field-kind-repr k)) (ty/link-kind! k (atom :public))) :public)
                     priv'))
            virt (if (= :Concrete virt') :Concrete virt)]
        (tc/unify! t t' "method")
        (swap! sign assoc-in [:meths label] [priv virt t]))
      (let [[p t' row'] (filter-method-row label priv row)]
        (tc/unify! t t' "method")
        (swap! sign assoc :row row')
        (swap! sign assoc-in [:meths label] [p virt t])))))

(defn add-instance-variable!
  "Ctype.add_instance_variable"
  [sign strict label mut virt t]
  (let [virt (if-let [[mut' virt' t'] (get-in @sign [:vars label])]
               (do (when strict
                     (when-not (= mut mut') (type-error (str "The instance variable " label " changes mutability")))
                     (tc/unify! t t' "instance variable"))
                   (if (= :Concrete virt') :Concrete virt))
               virt)]
    (swap! sign assoc-in [:vars label] [mut virt t])))

(defn update-class-signature!
  "Ctype.update_class_signature: the methods the self type gained made virtual ones, the private ones made public"
  [sign]
  (let [[fields row] (ty/flatten-fields (object-fields (:self @sign)))]
    (doseq [[lab k t] fields :when (not= lab dummy-method)]
      (if-let [[priv virt t'] (get-in @sign [:meths lab])]
        (when (and (vector? priv) (= :public (ty/field-kind-repr k)))
          (swap! sign assoc-in [:meths lab] [:public virt t']))
        (case (ty/field-kind-repr k)
          :public (swap! sign assoc-in [:meths lab] [:public :Virtual t])
          :private (swap! sign assoc-in [:meths lab] [[:private k] :Virtual t])
          nil)))
    (swap! sign assoc :row row)))

(defn hide-private-methods! [sign]
  (doseq [[_ k _] (first (ty/flatten-fields (object-fields (:self @sign))))]
    (when (= :private (ty/field-kind-repr k)) (ty/link-kind! k (atom :absent)))))

(defn close-class-signature!
  "Ctype.close_class_signature: false when the self type has the dummy method"
  [sign]
  (loop [t (object-fields (:self @sign))]
    (let [t (ty/expand-head t) d (ty/desc t)]
      (case (d 0)
        :Tvar (do (ty/link! t (ty/newty2 (ty/level t) [:Tnil])) true)
        :Tfield (if (= (d 1) dummy-method) false (recur (d 4)))
        :Tnil true))))

(defn public-methods
  "Btype.public_methods: the public methods' labels, sorted"
  [sign]
  (vec (sort (keep (fn [[l [p _ _]]] (when (= :public p) l)) (:meths @sign)))))

(defn method-type [label sign] (nth (get-in @sign [:meths label]) 2))

;; ---------------------------------------------------------------------------------------------
;; Method calls (Typecore.type_send, Ctype.filter_method)

(defn filter-method
  "Ctype.filter_method: the type of the public method name of an object type (its row extended when open)"
  [name t]
  (let [t (ty/expand-head t) d (ty/desc t)]
    (case (d 0)
      :Tvar (let [lv (ty/level t) m (ty/newty2 lv [:Tvar nil])]
              (ty/link! t (ty/newty2 lv [:Tobject (ty/newty2 lv [:Tfield name (ty/field-public) m (ty/newty2 lv [:Tvar nil])]) nil]))
              m)
      :Tobject (loop [f (d 1)]
                 (let [f (ty/repr f) fd (ty/desc f)]
                   (case (fd 0)
                     :Tvar (let [lv (ty/level f) m (ty/newty2 lv [:Tvar nil])]
                             (ty/link! f (ty/newty2 lv [:Tfield name (ty/field-public) m (ty/newty2 lv [:Tvar nil])]))
                             m)
                     :Tfield (if (= (fd 1) name)
                               (do (when (= :private (ty/field-kind-repr (fd 2))) (ty/link-kind! (fd 2) (atom :public)))
                                   (when (= :absent (ty/field-kind-repr (fd 2)))
                                     (type-error (str "This expression has no method " name)))
                                   (fd 3))
                               (recur (fd 4)))
                     (type-error (str "This expression has no method " name)))))
      (type-error (str "This expression is not an object; it has no method " name)))))

(defn type-send
  "Typecore.type_send: [obj meth type], meth [:Tmeth_val id] (self's method) [:Tmeth_ancestor id self-path] or
  [:Tmeth_name label]"
  [env sobj met]
  (let [obj (tc/type-exp env sobj)
        od (:desc obj)
        k (when (= :Texp_ident (od 0)) (:kind (od 2)))]
    (case (first k)
      :self (let [[_ sign meths _ _] k
                  id (or (get meths met) (type-error (str "This expression has no method " met)))]
              [obj [:Tmeth_val id] (method-type met sign)])
      :anc (let [[_ meths cl-num sign] k
                 id (or (get meths met) (type-error (str "This expression has no method " met)))]
             [obj [:Tmeth_ancestor id (:path (get-in env [:values (str "self-" cl-num)]))] (method-type met sign)])
      [obj [:Tmeth_name met] (filter-method met (:type obj))])))

;; ---------------------------------------------------------------------------------------------
;; Class structures (Typeclass.class_structure)

(defn- make-method
  "Typeclass.make_method: fun (self-* as self-N) -> expr"
  [cl-num sexpr]
  (let [loc (:pexp_loc sexpr)
        pat {:ppat_desc [:Ppat_alias {:ppat_desc [:Ppat_var {:txt "self-*"}] :ppat_loc loc} {:txt (str "self-" cl-num)}] :ppat_loc loc}]
    {:pexp_desc [:Pexp_function [{:pparam_desc [:Pparam_val [:Nolabel] nil pat]}] nil [:Pfunction_body sexpr]] :pexp_loc loc}))

(defn- add-value [env name vd] (assoc-in env [:values name] vd))

(def ^:dynamic *class-expr* "class_expr for an inherited class: (fn [cl-num val-env met-env scl] typed-class)" nil)
(declare inherit-class-signature!)

(defn class-structure
  "Typeclass.class_structure: final true for an immediate object (its self type closed)"
  [cl-num virt final val-env met-env scstr]
  (let [sign (new-class-signature)
        _ (when-not final
            (let [[_ t row] (filter-method-row dummy-method :Private (:row @sign))]
              (tc/unify! t (ty/newty [:Ttuple []]) "self")
              (swap! sign assoc :row row)))
        spat (:pcstr_self scstr)
        spat {:ppat_desc [:Ppat_alias spat {:txt "selfpat-*"}] :ppat_loc (:ppat_loc spat)}
        pvars (atom [])
        self-pat (tc/type-pat val-env spat (ty/newvar) pvars)
        _ (tc/unify! (:type self-pat) (:self @sign) "self pattern")
        ;; the first pass: instance variables typed, methods declared
        [fields vars]
        (reduce
         (fn [[acc vars] cf]
           (let [d (:pcf_desc cf)]
             (case (d 0)
               :Pcf_inherit
               (let [[_ over scl super] d
                     parent (*class-expr* cl-num val-env met-env scl)
                     psign (signature-of-class-type (:type parent))
                     _ (update-class-signature! psign)]
                 (inherit-class-signature! sign psign true)
                 (let [ivars (mapv (fn [[label _]] [label (ty/ident-create label)]) (reverse (sort-by first (:vars @psign))))
                       super-meths (mapv (fn [l] [l (ty/ident-create l)])
                                         (reverse (sort (keep (fn [[l [_ v _]]] (when (= :Concrete v) l)) (:meths @psign)))))]
                   [(conj acc [:inherit over parent (some-> super :txt) ivars super-meths psign])
                    (into vars ivars)]))
               :Pcf_val
               (let [[{label :txt} mut kind] (d 1)]
                 (if (= :Cfk_virtual (kind 0))
                   (let [t (env/transl-type val-env (atom {}) (kind 1))]
                     (add-instance-variable! sign true label mut :Virtual t)
                     (let [id (or (get vars label) (ty/ident-create label))]
                       [(conj acc [:virtual-val label mut id (contains? vars label)]) (assoc vars label id)]))
                   (let [e (tc/type-exp val-env (kind 2))]
                     (add-instance-variable! sign true label mut :Concrete (:type e))
                     (let [id (or (get vars label) (ty/ident-create label))]
                       [(conj acc [:concrete-val label mut id (kind 1) e (contains? vars label)]) (assoc vars label id)]))))
               :Pcf_method
               (let [[{label :txt} priv kind] (d 1)]
                 (if (= :Cfk_virtual (kind 0))
                   (let [t (env/transl-type val-env (atom {}) (kind 1))]
                     (add-method! sign label priv :Virtual t)
                     [(conj acc [:virtual-method label priv]) vars])
                   (let [sexpr (kind 2)
                         sexpr (if (= :Pexp_poly ((:pexp_desc sexpr) 0)) sexpr
                                   {:pexp_desc [:Pexp_poly sexpr nil] :pexp_loc (:pexp_loc sexpr)})
                         sty ((:pexp_desc sexpr) 2)
                         t (if sty (env/transl-type val-env (atom {}) sty) (ty/newvar))]
                     (add-method! sign label priv :Concrete t)
                     [(conj acc [:concrete-method label priv (kind 1) (make-method cl-num sexpr)]) vars])))
               :Pcf_constraint [(conj acc [:constraint]) vars]
               :Pcf_initializer [(conj acc [:initializer (make-method cl-num (d 1))]) vars]
               :Pcf_attribute [acc vars]
               (type-error (str "class field " (d 0) " outside the slice")))))
         [[] {}] (:pcstr_fields scstr))
        _ (update-class-signature! sign)
        meths (into (sorted-map) (map (fn [l] [l (ty/ident-create l)]) (sort (keys (:meths @sign)))))
        _ (when final (when-not (close-class-signature! sign) (type-error "This object has a virtual method")))
        meths-ref (atom meths)
        ;; the self pattern's variables as Val_self, the instance variables as Val_ivar
        met-env (reduce (fn [e [n id t]]
                          (add-value e n {:type t :kind [:self sign meths vars cl-num] :path [:Pident id] :id id}))
                        met-env @pvars)
        ivar-env (fn [e label id]
                   (let [[mut _ t] (get-in @sign [:vars label])]
                     (add-value e label {:type t :kind [:ivar mut cl-num] :path [:Pident id] :id id})))
        ;; the second pass: the methods' and initializers' bodies
        [tfields _]
        (reduce
         (fn [[acc menv] f]
           (case (f 0)
             :inherit (let [[_ over parent super ivars super-meths psign] f
                            menv (reduce (fn [e [l id]] (ivar-env e l id)) menv ivars)
                            menv (if super
                                   (add-value menv super {:type (:self @psign) :kind [:anc (into {} super-meths) cl-num sign]
                                                          :path [:Pident (ty/ident-create super)]})
                                   menv)]
                        [(conj acc [:Tcf_inherit over parent super ivars super-meths]) menv])
             :virtual-val (let [[_ label mut id already] f
                                menv (if already menv (ivar-env menv label id))]
                            [(conj acc [:Tcf_val label mut id [:virtual] already]) menv])
             :concrete-val (let [[_ label mut id over e already] f
                                 menv (if already menv (ivar-env menv label id))]
                             [(conj acc [:Tcf_val label mut id [:concrete e] already]) menv])
             :virtual-method [(conj acc [:Tcf_method (f 1) (f 2) [:virtual]]) menv]
             :concrete-method (let [[_ label priv over sdef] f
                                    t (method-type label sign)
                                    mt (ty/newty [:Tarrow [:Nolabel] (:self @sign) t])
                                    e (tc/type-expect menv sdef mt)]
                                [(conj acc [:Tcf_method label priv [:concrete e]]) menv])
             :constraint [(conj acc [:Tcf_constraint]) menv]
             :initializer (let [mt (ty/newty [:Tarrow [:Nolabel] (:self @sign) (ty/type-unit)])
                                e (tc/type-expect menv (f 1) mt)]
                            [(conj acc [:Tcf_initializer e]) menv])))
         [[] met-env] fields)]
    (update-class-signature! sign)
    {:self self-pat :fields tfields :sign sign :meths @meths-ref}))

(def class-num (atom 0))

(defn type-object
  "Typeclass.type_object: [structure public-methods]"
  [env sstr]
  (let [n (swap! class-num inc)
        cs (class-structure (str n) :Concrete true env env sstr)]
    ;; complete_class_signature
    (update-class-signature! (:sign cs))
    (hide-private-methods! (:sign cs))
    [cs (public-methods (:sign cs))]))

;; ---------------------------------------------------------------------------------------------
;; Class types (types.ml's class_type: [:Cty_signature sign] [:Cty_arrow label t cty] [:Cty_constr path args cty])

(defn signature-of-class-type [cty]
  (case (cty 0) :Cty_signature (cty 1) :Cty_arrow (recur (cty 3)) :Cty_constr (recur (cty 3))))

(defn self-type [cty] (:self @(signature-of-class-type cty)))

(defn- class-type-types
  "Every type of a class type, in a fixed order"
  [cty]
  (case (cty 0)
    :Cty_signature (let [s @(cty 1)]
                     (concat [(:self s) (:row s)] (map #(nth % 2) (vals (into (sorted-map) (:vars s))))
                             (map #(nth % 2) (vals (into (sorted-map) (:meths s))))))
    :Cty_arrow (cons (cty 2) (class-type-types (cty 3)))
    :Cty_constr (concat (cty 2) (class-type-types (cty 3)))))

(defn- rebuild-class-type
  "The class type with its types replaced, in class-type-types' order, by ts (a seq consumed)"
  [cty ts]
  (case (cty 0)
    :Cty_signature (let [s @(cty 1)
                         vs (into (sorted-map) (:vars s)) ms (into (sorted-map) (:meths s))
                         [self row & more] @ts
                         nv (count vs) nm (count ms)
                         vts (take nv more) mts (take nm (drop nv more))]
                     (reset! ts (drop (+ nv nm) more))
                     [:Cty_signature (atom {:self self :row row
                                            :vars (into {} (map (fn [[l [m v _]] t] [l [m v t]]) vs vts))
                                            :meths (into {} (map (fn [[l [p v _]] t] [l [p v t]]) ms mts))})])
    :Cty_arrow (let [t (first @ts)] (swap! ts rest) [:Cty_arrow (cty 1) t (rebuild-class-type (cty 3) ts)])
    :Cty_constr (let [n (count (cty 2)) args (vec (take n @ts))]
                  (swap! ts #(drop n %))
                  [:Cty_constr (cty 1) args (rebuild-class-type (cty 3) ts)])))

(defn instance-class
  "Ctype.instance_class: [params cty] copied together"
  [params cty]
  (let [ts (ty/instance-list (concat params (class-type-types cty)))
        np (count params)]
    [(vec (take np ts)) (rebuild-class-type cty (atom (drop np ts)))]))

(defn generalize-class-type! [params cty] (run! ty/generalize (concat params (class-type-types cty))))

(defn- constructor-type
  "Typeclass.constructor_type"
  [constr cty]
  (case (cty 0)
    :Cty_signature constr
    :Cty_arrow (ty/newty [:Tarrow (cty 1) (cty 2) (constructor-type constr (cty 3))])
    :Cty_constr (constructor-type constr (cty 3))))

(defn class-type-arity [cty] (case (cty 0) :Cty_arrow (inc (class-type-arity (cty 3))) :Cty_signature 0 :Cty_constr (class-type-arity (cty 3))))

(defn- set-object-name!
  "Ctype.set_object_name: the self type named by the class's abbreviation, its row first"
  [p params t]
  (let [t (ty/repr t) d (ty/desc t)]
    (when (= :Tobject (d 0))
      (swap! t assoc :desc [:Tobject (d 1) [p (vec (cons (ty/object-row t) params))]]))))

(defn extract-constraints
  "Typeclass.extract_constraints: [vals meths concrete-meths] of a class type (Map folds: labels descending)"
  [cty]
  (let [s @(signature-of-class-type cty)]
    [(vec (reverse (sort (keys (:vars s))))) (vec (reverse (sort (keys (:meths s)))))
     (set (keep (fn [[l [_ v _]]] (when (= :Concrete v) l)) (:meths s)))]))

(defn- add-dummy-method! [sign]
  (let [[_ t row] (filter-method-row dummy-method :Private (:row @sign))]
    (tc/unify! t (ty/newty [:Ttuple []]) "self")
    (swap! sign assoc :row row)))

(def ^:dynamic *class-vars* "The type variables of the class being typed (Typetexp.TyVarEnv)" nil)

(defn- cvars [] (or *class-vars* (atom {})))

(defn class-body [cty] (if (= :Cty_arrow (cty 0)) (recur (cty 3)) cty))

(defn- inherit-class-signature! [sign psign strict]
  (tc/unify! (:self @sign) (:self @psign) "inherited self")
  (doseq [[label [priv virt t]] (:meths @psign)]
    (add-method! sign label (if (= :public priv) :Public :Private) virt t))
  (doseq [[label [mut virt t]] (:vars @psign)]
    (add-instance-variable! sign strict label mut virt t)))

(defn class-type
  "Typeclass.class_type: a class type of its Parsetree"
  [env scty]
  (let [d (:pcty_desc scty)]
    (case (d 0)
      :Pcty_constr (let [e (or (env/lookup env :cltypes (:txt (d 1)))
                               (type-error (str "Unbound class type " (str/join "." (env/lid-parts (:txt (d 1)))))))
                         decl (:decl e)
                         [params clty] (instance-class (:params decl) (:type decl))]
                     (add-dummy-method! (signature-of-class-type clty))
                     (when-not (= (count params) (count (d 2))) (type-error "The class type expects another number of arguments"))
                     (dorun (map (fn [sty t] (tc/unify! (env/transl-type env (cvars) sty) t "class parameter")) (d 2) params))
                     [:Cty_constr (:path e) params clty])
      :Pcty_signature
      (let [{sty :pcsig_self fields :pcsig_fields} (d 1)
            sign (new-class-signature)]
        (add-dummy-method! sign)
        (tc/unify! (env/transl-type env (cvars) sty) (:self @sign) "self")
        (doseq [f fields]
          (let [fd (:pctf_desc f)]
            (case (fd 0)
              :Pctf_inherit (let [pt (class-type env (fd 1)) ps (signature-of-class-type pt)]
                              (update-class-signature! ps)
                              (inherit-class-signature! sign ps false))
              :Pctf_val (let [[{lab :txt} mut virt sty] (fd 1)]
                          (add-instance-variable! sign false lab mut virt (env/transl-type env (cvars) sty)))
              :Pctf_method (let [[{lab :txt} priv virt sty] (fd 1)]
                             (add-method! sign lab priv virt (env/transl-type env (cvars) sty)))
              :Pctf_constraint (tc/unify! (env/transl-type env (cvars) ((fd 1) 0)) (env/transl-type env (cvars) ((fd 1) 1)) "constraint")
              :Pctf_attribute nil
              (type-error (str "class type field " (fd 0) " outside the slice")))))
        [:Cty_signature sign])
      :Pcty_arrow (let [[_ l sty scty'] d
                        t (env/transl-type env (cvars) sty)
                        t (if (ty/is-optional l) (ty/type-option t) t)]
                    [:Cty_arrow l t (class-type env scty')])
      (type-error (str "class type " (d 0) " outside the slice")))))

(defn class-expr
  "Typeclass.class_expr: {:desc d :env env :type cty}"
  [cl-num val-env met-env virt scl]
  (let [d (:pcl_desc scl)
        mk (fn [desc cty] {:desc desc :env val-env :type cty :loc (:pcl_loc scl)})]
    (case (d 0)
      :Pcl_constr (let [e (or (env/lookup val-env :classes (:txt (d 1)))
                              (type-error (str "Unbound class " (str/join "." (env/lid-parts (:txt (d 1)))))))
                        decl (:decl e)
                        tyl (mapv #(env/transl-type val-env (or *class-vars* (atom {})) %) (d 2))
                        [params clty] (instance-class (:params decl) (:type decl))
                        clty' (if (= :Cty_signature (clty 0)) [:Cty_constr (:path e) params clty] clty)]
                    (add-dummy-method! (signature-of-class-type clty'))
                    (when (and (seq tyl) (not= (count tyl) (count params)))
                      (type-error "The class constructor expects another number of type arguments"))
                    (dorun (map #(tc/unify! %1 %2 "class parameter") tyl params))
                    (let [cl (mk [:Tcl_ident (:path e) e] clty')
                          [vals meths concrs] (extract-constraints clty)]
                      (mk [:Tcl_constraint cl vals meths concrs] clty')))
      :Pcl_structure (let [cs (class-structure cl-num virt false val-env met-env (d 1))]
                       (mk [:Tcl_structure cs] [:Cty_signature (:sign cs)]))
      :Pcl_fun (let [[_ l default spat scl'] d]
                 (when default (type-error "optional class parameters with defaults are outside the slice"))
                 (let [vars (atom [])
                       pat (tc/type-pat val-env spat (ty/newvar) vars)
                       _ (when (ty/is-optional l) (tc/unify! (:type pat) (ty/type-option (ty/newvar)) "pattern"))
                       pv (mapv (fn [[n id t]] [n id (ty/ident-rename id) t]) @vars)
                       val-env' (reduce (fn [e [n id _ t]] (tc/add-value e n id t)) val-env pv)
                       met-env' (reduce (fn [e [n _ id' t]]
                                          (assoc-in e [:values n] {:type t :kind [:ivar :Immutable cl-num] :path [:Pident id'] :id id'}))
                                        met-env pv)
                       vals (mapv (fn [[n id id' t]]
                                    [id' (tc/mkexp [:Texp_ident [:Pident id] {:type t :kind [:reg] :path [:Pident id] :id id}] (ty/instance t) nil)])
                                  pv)
                       partial (tc/partiality [{:lhs pat}])
                       cl (class-expr cl-num val-env' met-env' virt scl')]
                   (mk [:Tcl_fun pat vals cl partial] [:Cty_arrow l (ty/instance (:type pat)) (:type cl)])))
      :Pcl_apply (let [cl (class-expr cl-num val-env met-env virt (d 1))
                       ;; the arguments typed as a function application of the class's constructor type
                       ft (constructor-type (ty/newvar) (:type cl))
                       f (tc/mkexp [:Texp_ident [:Pident (ty/ident-create "*class*")] {}] ft nil)
                       [args _] (tc/type-application val-env f (vec (d 2)))
                       cty (loop [cty (:type cl) n (count args)]
                             (if (and (pos? n) (= :Cty_arrow (cty 0))) (recur (cty 3) (dec n)) cty))]
                   (mk [:Tcl_apply cl args] cty))
      :Pcl_let (let [[_ rec svbs scl'] d
                     [vbs val-env'] (tc/type-let val-env rec svbs)
                     ids (mapcat #(arbace.repr.ocaml.typer.parmatch/bound-idents-full (:pat %)) vbs)
                     [vals met-env']
                     (reduce (fn [[vals me] [id n t]]
                               (let [id' (ty/ident-rename id)
                                     e (tc/mkexp [:Texp_ident [:Pident id] {:type t :kind [:reg] :path [:Pident id] :id id}] (ty/instance t) nil)]
                                 [(conj vals [id' e])
                                  (assoc-in me [:values n] {:type t :kind [:ivar :Immutable cl-num] :path [:Pident id'] :id id'})]))
                             [[] met-env] ids)
                     cl (class-expr cl-num val-env' met-env' virt scl')]
                 (mk [:Tcl_let rec vbs vals cl] (:type cl)))
      :Pcl_constraint (let [cl (class-expr cl-num val-env met-env virt (d 1))
                            _ (update-class-signature! (signature-of-class-type (:type cl)))
                            clty (class-type val-env (d 2))
                            _ (update-class-signature! (signature-of-class-type clty))
                            [vals meths concrs] (extract-constraints clty)
                            [_ t] (instance-class [] clty)]
                        (add-dummy-method! (signature-of-class-type t))
                        (mk [:Tcl_constraint cl vals meths concrs] t))
      (type-error (str "class expression " (d 0) " outside the slice")))))

(alter-var-root #'*class-expr* (constantly (fn [cl-num val-env met-env scl] (class-expr cl-num val-env met-env :Virtual scl))))

(defn- approx-declaration [scl]
  (let [d (:pcl_desc scl)]
    (case (d 0)
      :Pcl_fun (ty/newty [:Tarrow (d 1) (if (ty/is-optional (d 1)) (ty/type-option (ty/newvar)) (ty/newvar)) (approx-declaration (d 4))])
      :Pcl_let (approx-declaration (d 3))
      :Pcl_constraint (approx-declaration (d 1))
      (ty/newvar))))

(defn- temp-abbrev [arity]
  (let [params (vec (repeatedly arity ty/newvar))]
    [params (ty/newty [:Tobject (ty/newvar) nil])]))

(defn- type-param [vars sty]
  (let [d (:ptyp_desc sty)]
    (case (d 0)
      :Ptyp_var (let [v (ty/newvar (d 1))] (swap! vars assoc (d 1) v) v)
      (ty/newvar))))

(defn class-declarations
  "Typeclass.class_declarations: [[class-info...] env'], a class-info {:id :name :decl :obj-id :obj-abbr :expr
  :pub-meths :virt}; the environment binds each class, its type and its #-type"
  [env scls]
  (let [cls (mapv (fn [scl] (let [n (:txt (:pci_name scl))] [scl n (ty/ident-create n) (ty/ident-create n) (ty/ident-create n)])) scls)
        [res env]
        (ty/with-local-level
          (let [;; initial_env: temporary abbreviations and the constructors' approximate types
                pre (mapv (fn [[scl n id ty-id obj-id]]
                            (let [arity (count (:pci_params scl))
                                  [obj-params obj-ty] (temp-abbrev arity)
                                  [cl-params cl-ty] (temp-abbrev arity)
                                  constr-type (ty/with-local-level (approx-declaration (:pci_expr scl)))]
                              (env/add-decl! [:Pident obj-id] {:path [:Pident obj-id] :params obj-params :kind [:abstract] :manifest obj-ty
                                                               :arity arity :variance (repeat :inv)})
                              {:scl scl :name n :id id :ty-id ty-id :obj-id obj-id :obj-params obj-params :obj-ty obj-ty
                               :cl-params cl-params :cl-ty cl-ty :constr-type constr-type}))
                          cls)
                env1 (reduce (fn [e c]
                               (-> e
                                   (assoc-in [:types (:name c)] [:Pident (:obj-id c)])
                                   (assoc-in [:classes (:name c)] {:path [:Pident (:id c)] :id (:id c)
                                                                   :decl {:params [] :type [:Cty_signature (new-class-signature)]
                                                                          :path [:Pident (:obj-id c)]
                                                                          :new (when (= :Concrete (:pci_virt (:scl c))) (:constr-type c))}})))
                             env pre)
                infos
                (mapv (fn [c]
                        (let [scl (:scl c) vars (atom {})
                              [params cl-expr]
                              (ty/with-local-level
                                (let [params (mapv (fn [[sty _]] (type-param vars sty)) (:pci_params scl))
                                      n (swap! class-num inc)
                                      e (binding [*class-vars* vars env/*shared-tyvars* vars] (class-expr (str n) env1 env1 (:pci_virt scl) (:pci_expr scl)))]
                                  (update-class-signature! (signature-of-class-type (:type e)))
                                  [params e]))
                              typ (:type cl-expr)
                              _ (generalize-class-type! params typ)
                              sign (signature-of-class-type typ)
                              obj-path [:Pident (:obj-id c)]
                              ;; the object type's abbreviation: a closed instance
                              [obj-params' obj-type] (instance-class params typ)
                              constr (ty/newty [:Tconstr obj-path (:obj-params c)])
                              _ (do (tc/unify! (ty/object-row (self-type obj-type)) (ty/newty [:Tnil]) "class")
                                    (dorun (map #(tc/unify! %1 %2 "class parameters") (:obj-params c) obj-params'))
                                    ;; Ctype.unify3: the instance's self linked to the abbreviation itself, then its fields
                                    ;; unified with the expansion's
                                    (let [si (ty/repr (self-type obj-type)) sd (ty/desc si)
                                          e (ty/expand-head constr) ed (ty/desc e)]
                                      (ty/link! si constr)
                                      (ty/unify-fields (sd 1) (ed 1))))
                              _ (set-object-name! obj-path params (:self @sign))
                              ;; the #-type
                              [cl-params' cl-type] (instance-class params typ)
                              _ (do (dorun (map #(tc/unify! %1 %2 "class parameters") (:cl-params c) cl-params'))
                                    (tc/unify! (self-type cl-type) (:cl-ty c) "class"))
                              _ (tc/unify! (constructor-type constr obj-type) (ty/instance (:constr-type c)) "class constructor")
                              [params' typ'] (instance-class params typ)
                              [hparams hty] (let [ts (ty/instance-list (concat params [(:self @sign)]))] [(vec (butlast ts)) (last ts)])
                              _ (set-object-name! obj-path hparams hty)
                              decl {:params params' :type typ' :path obj-path :virt (:pci_virt scl)
                                    :new (when (= :Concrete (:pci_virt scl)) (ty/instance (:constr-type c)))
                                    :hash {:params hparams :manifest hty}}]
                          (assoc c :decl decl :expr cl-expr :pub-meths (public-methods sign) :virt (:pci_virt scl))))
                      pre)]
            [infos env1]))]
    ;; generalized (with_local_level_generalize_for_class)
    (doseq [c res]
      (generalize-class-type! (:params (:decl c)) (:type (:decl c)))
      (some-> (:new (:decl c)) ty/generalize)
      (run! ty/generalize (:obj-params c)) (ty/generalize (:obj-ty c))
      (run! ty/generalize (:params (:hash (:decl c)))) (ty/generalize (:manifest (:hash (:decl c)))))
    (let [env (reduce (fn [e c]
                        (let [obj-path [:Pident (:obj-id c)]
                              d {:path obj-path :params (:obj-params c) :kind [:abstract] :manifest (:obj-ty c)
                                 :arity (count (:obj-params c)) :variance (repeat :inv) :class-ghost true}]
                          (env/add-decl! obj-path d)
                          (-> e
                              (assoc-in [:types (:name c)] obj-path)
                              (assoc-in [:classes (:name c)] {:path [:Pident (:id c)] :id (:id c) :decl (:decl c)})
                              (assoc-in [:cltypes (:name c)] {:path [:Pident (:ty-id c)] :decl (update (:decl c) :type class-body)}))))
                      env res)]
      [res env])))

(defn class-type-declarations
  "Typeclass.class_type_declarations: [[info...] env'], info {:name :ty-id :obj-id :decl}"
  [env scls]
  (let [res
        (mapv (fn [scl]
                (let [n (:txt (:pci_name scl)) ty-id (ty/ident-create n) obj-id (ty/ident-create n)
                      vars (atom {})
                      [params typ] (ty/with-local-level
                                     (let [params (mapv (fn [[sty _]] (type-param vars sty)) (:pci_params scl))
                                           t (binding [*class-vars* vars env/*shared-tyvars* vars] (class-type env (:pci_expr scl)))]
                                       (update-class-signature! (signature-of-class-type t))
                                       [params t]))
                      _ (generalize-class-type! params typ)
                      sign (signature-of-class-type typ)
                      obj-path [:Pident obj-id]
                      [obj-params obj-type] (instance-class params typ)
                      _ (tc/unify! (ty/object-row (self-type obj-type)) (ty/newty [:Tnil]) "class type")
                      obj-ty (self-type obj-type)
                      _ (set-object-name! obj-path params (:self @sign))
                      [hparams hty] (let [ts (ty/instance-list (concat params [(:self @sign)]))] [(vec (butlast ts)) (last ts)])
                      _ (set-object-name! obj-path hparams hty)
                      decl {:params params :type typ :path obj-path :virt (:pci_virt scl) :hash {:params hparams :manifest hty}}]
                  (run! ty/generalize (concat obj-params [obj-ty] hparams [hty]))
                  (env/add-decl! obj-path {:path obj-path :params obj-params :kind [:abstract] :manifest obj-ty
                                           :arity (count obj-params) :variance (repeat :inv) :class-ghost true})
                  {:name n :ty-id ty-id :obj-id obj-id :decl decl}))
              scls)]
    [res (reduce (fn [e c] (-> e (assoc-in [:types (:name c)] [:Pident (:obj-id c)])
                               (assoc-in [:cltypes (:name c)] {:path [:Pident (:ty-id c)] :decl (:decl c)})))
                 env res)]))

(defn hash-type
  "Typetexp's Ptyp_class: #c applied to args, an instance of the class type's #-abbreviation"
  [env lid args]
  (let [e (or (env/lookup env :cltypes lid) (type-error (str "Unbound class type " (str/join "." (env/lid-parts lid)))))
        {:keys [params manifest]} (:hash (:decl e))
        ts (ty/instance-list (concat params [manifest]))]
    (when-not (= (count args) (count params)) (type-error "The class type expects another number of arguments"))
    (dorun (map #(tc/unify! %1 %2 "class parameter") args (butlast ts)))
    (last ts)))

(defn type-new
  "Typecore's Pexp_new: [path decl type]"
  [env lid]
  (let [e (or (env/lookup env :classes lid) (type-error (str "Unbound class " (str/join "." (env/lid-parts lid)))))
        decl (:decl e)]
    (when-not (:new decl) (type-error (str "Cannot instantiate the virtual class " (str/join "." (env/lid-parts lid)))))
    [e decl (ty/instance (:new decl))]))

(alter-var-root #'tc/*type-object* (constantly type-object))
(alter-var-root #'tc/*type-send* (constantly type-send))
(alter-var-root #'tc/*type-new* (constantly type-new))
(alter-var-root #'tm/*class-declarations* (constantly class-declarations))
(alter-var-root #'tm/*class-type-declarations* (constantly class-type-declarations))
(alter-var-root #'env/*hash-type* (constantly hash-type))

(ns arbace.repr.ocaml.typer.env
  "The typing environment (doc/ocaml/TYPER.md, T1): an environment is a map {:values :types :constrs :labels
  :modules}, names to descriptions; the declarations of every type path are in one registry. The initial
  environment is Predef's with the stdlib's Stdlib opened, its interface (stdlib/stdlib.mli of the pinned tarball)
  read by the native reader and translated here, as the other units' (Stdlib__List...) on first use: their values
  with their runtime positions (the fields of the unit's block), externals with their primitives."
  (:require [arbace.repr.ocaml.typer.types :as ty]
            [arbace.repr.ocaml.parser :as parser]
            [arbace.string :as str])
  (:import [java.io File]))

(set! *warn-on-reflection* false)

(def decls (atom {}))
(def ext-positions "An exception of a unit's interface: its path to its field's position" (atom {}))
(def ext-addrs "An exception of a module: its path to its address" (atom {}))
(declare module-components-of-path normalize-module-path)
(defn find-decl
  "The declaration of a type path; a path into a module (M.t, F(X).t) registered when the module's components are
  first computed"
  [p]
  (or (get @decls p)
      (when (= :Pdot (p 0))
        (let [q (normalize-module-path (p 1))]
          (module-components-of-path q)
          (or (get @decls [:Pdot q (p 2)]) (get @decls p))))))
(defn add-decl!
  "A declaration registered under its path, and its inline records' under p.C (Datarepr's inline record types)"
  [p d]
  ;; a manifest the lenient reading of an interface could not translate: the type abstract (its parameters kept)
  (let [d (if (when-let [m (:manifest d)] (let [md (:desc @(ty/repr m))] (and (= :Tconstr (md 0)) (= -1 (:stamp ((md 1) 1))))))
            (assoc d :manifest nil :variance (repeat :inv))
            d)]
  (swap! decls assoc p d)
  (when (= :variant (first (:kind d)))
    (loop [cs ((:kind d) 1) ib 0]
      (when (seq cs)
        (let [c (first cs)]
          (when-let [ls (:inlined c)]
            (let [ip [:Pdot p (:name c)] rep [:inlined ib]]
              (swap! decls assoc ip {:path ip :params (:params d) :kind [:record ls rep] :manifest nil
                                     :arity (count (:params d)) :variance (repeat :inv)})
              (ty/labels-of ip (:params d) ls rep)))
          (recur (rest cs) (if (empty? (:args c)) ib (inc ib)))))))))

(def ^:dynamic *stdlib-dir* ".tmp/repr-ocaml/ocaml-5.5.0/stdlib")

(defn type-error [msg & [data]] (throw (ex-info msg (merge {:ocaml-type-error msg} data))))

;; ---------------------------------------------------------------------------------------------
;; Core types (typetexp.ml)

(defn lid-parts
  "A Longident as [module-names... name]"
  [lid]
  (case (lid 0)
    :Lident [(lid 1)]
    :Ldot (conj (lid-parts (:txt (lid 1))) (:txt (lid 2)))
    (type-error "functor applications in paths are outside the slice")))

(declare find-unit)

(declare entry-components)

(def alias-required
  "Env's required globals: a unit whose alias (an absent module of another unit) a lookup went through"
  (atom #{}))

(def ^:dynamic *transparent-modules* "-no-alias-deps (Clflags.transparent_modules): aliases require nothing" false)

(defn- note-alias!
  "Env.expand_module_path: going through an alias to another unit makes the alias's unit required"
  [m]
  (when (and (not *transparent-modules*) (map? m) (= :Mty_alias (first (:mty m))))
    (let [h (ty/path-head (:path m)) t ((:mty m) 1)
          th (case (t 0) (:Pident :Pdot) (ty/path-head t) nil)]
      (when (and (:global h) (not= h th)) (swap! alias-required conj (:name h))))))

(defn- lookup-in
  "The component kind (:values :types :constrs :labels :modules :modtypes) of name, after the modules of path; a C
  external reached through an alias requires the alias's unit (Translprim.add_used_primitive normalizes its path)"
  ([env kind parts] (lookup-in env kind parts []))
  ([env kind parts aliases]
   (if (= 1 (count parts))
     (let [v (get-in env [kind (first parts)])]
       (when (and (= kind :values) (= :prim (first (:kind v))) (not (str/starts-with? (:name (second (:kind v))) "%")))
         (run! note-alias! aliases))
       v)
     (let [m (get-in env [:modules (first parts)])
           u (entry-components (or m (first parts)))]
       (when-not u (type-error (str "Unbound module " (first parts))))
       (recur u kind (vec (rest parts)) (conj aliases m))))))

(defn lookup [env kind lid] (lookup-in env kind (lid-parts lid)))

(defn- param-variance [decl-kind manifest]
  nil)

(def ^:dynamic *lenient*
  "While a unit's interface is read: a type outside the slice is an opaque constructor, not an error" false)
(def opaque-path [:Pident {:name "<outside the typer's slice>" :stamp -1}])

(declare transl-type*)

(def ^:dynamic *shared-tyvars* "The type variables of a class being typed, shared by its annotations (TyVarEnv)" nil)

(defn transl-type [env vars sty]
  (if-let [sv (and *shared-tyvars* (not (identical? vars *shared-tyvars*)) *shared-tyvars*)]
    (transl-type env sv sty)
  (if *lenient*
    (try (transl-type* env vars sty)
         (catch arbace.lang.ExceptionInfo e
           (if (:ocaml-type-error (ex-data e)) (ty/tconstr opaque-path []) (throw e))))
    (transl-type* env vars sty))))

(defn- transl-variant
  "Typetexp.transl_type's Ptyp_variant: the tags and inherited static rows' fields (by hash, checked for conflicts), a
  tag not among the present ones undecided; the row named by an inherited type when it is the first field; its more
  [:Tnil] when static"
  [env vars [_ fields closed present]]
  (let [name (atom nil)
        hfields (atom (sorted-map))
        add-typed-field (fn [l f]
                          (let [h (ty/hash-variant l)]
                            (if-let [[l' f'] (get @hfields h)]
                              (do (when (not= l l') (type-error (str "Variant tags `" l " and `" l' " have the same hash value")))
                                  (let [mk (fn [f] (ty/newty [:Tvariant (ty/create-row [[l f]] (ty/newvar) true nil nil)]))]
                                    (ty/unify (mk f) (mk f'))))
                              (swap! hfields assoc h [l f]))))
        present (when present (set present))]
    (doseq [fld fields]
      (let [pd (:prf_desc fld)]
        (case (pd 0)
          :Rtag (let [l (:txt (pd 1)) c (pd 2) stl (pd 3)
                      _ (reset! name nil)
                      tl (mapv #(transl-type env vars %) stl)
                      f (if (and present (not (present l)))
                          (ty/rf-either tl c false)
                          (do (when (or (> (count stl) 1) (and c (seq stl)))
                                (type-error (str "The present constructor " l " has a conjunctive type")))
                              (ty/rf-present (first tl))))]
                  (add-typed-field l f))
          :Rinherit (let [t (transl-type env vars (pd 1))
                          td (ty/desc t)
                          nm (when (= :Tconstr (td 0)) [(td 1) (td 2)])
                          _ (reset! name (when (empty? @hfields) nm))
                          e (ty/desc (ty/expand-head t))]
                      (when-not (and (= :Tvariant (e 0)) (ty/static-row (e 1)))
                        (type-error (str "The type " (ty/type-scheme-text t) " is not a polymorphic variant type")))
                      (doseq [[l f] (ty/row-fields (e 1))]
                        (add-typed-field l (if (and present (not (present l)))
                                             (let [v (ty/field-view f)]
                                               (if (= :Rpresent (v 0)) (ty/rf-either-of (v 1)) (type-error "inherit")))
                                             f)))))))
    (let [fs (reduce (fn [l [_ p]] (cons p l)) () @hfields)
          _ (when present (doseq [l present] (when-not (some #(= l (first %)) fs) (type-error (str "The tag `" l " has no type")))))
          row (ty/create-row fs nil (= closed :Closed) nil @name)
          more (if (ty/static-row (assoc row :more (ty/newvar))) (ty/newty [:Tnil]) (ty/newvar))]
      (ty/newty [:Tvariant (assoc row :more more)]))))

(def ^:dynamic *hash-type* "Typetexp's Ptyp_class: (fn [env lid args] type)" nil)
(defn class-body [cty] (if (= :Cty_arrow (cty 0)) (recur (cty 3)) cty))

(defn transl-type*
  "Typetexp.transl_simple_type: the core type as a type, variables named in the map atom vars (created on first
  use when fresh is true)"
  [env vars sty]
  (let [d (:ptyp_desc sty)]
    (case (d 0)
      :Ptyp_any (ty/newvar)
      :Ptyp_var (or (get @vars (d 1))
                    (let [v (ty/newvar (d 1))] (swap! vars assoc (d 1) v) v))
      :Ptyp_arrow (let [l (d 1) a (transl-type env vars (d 2)) r (transl-type env vars (d 3))]
                    (ty/newty [:Tarrow l (if (ty/is-optional l) (ty/type-option a) a) r]))
      :Ptyp_tuple (ty/newty [:Ttuple (mapv (fn [[l t]] [l (transl-type env vars t)]) (d 1))])
      :Ptyp_constr (let [p (lookup env :types (:txt (d 1)))]
                     (when-not p (type-error (str "Unbound type constructor " (str/join "." (lid-parts (:txt (d 1)))))))
                     (let [args (d 2) decl (find-decl p)]
                       ;; `_ t` for a constructor of several parameters: a wildcard for each (Typetexp)
                       (if (and (= 1 (count args)) (= :Ptyp_any ((:ptyp_desc (first args)) 0)) decl (> (:arity decl 1) 1))
                         (ty/tconstr p (vec (repeatedly (:arity decl) ty/newvar)))
                         (let [targs (mapv #(transl-type env vars %) args)]
                           ;; a declaration's constraints (its parameters not variables): checked by unifying an
                           ;; instance of its parameters with the arguments (Typetexp, Ctype.instance_declaration)
                           (when (and decl (= (count targs) (count (:params decl))) (some #(not (ty/tvar? %)) (:params decl)))
                             (dorun (map ty/unify (ty/instance-list (:params decl)) targs)))
                           (ty/tconstr p targs)))))
      :Ptyp_poly (transl-type env vars (d 2))
      :Ptyp_alias (let [n (:txt (d 2))
                        t (transl-type env vars (d 1))]
                    (if-let [v (get @vars n)] (ty/unify v t) (swap! vars assoc n t))
                    (let [px (ty/type-proxy t)]
                      (when (and (ty/tvar? px) (nil? ((ty/desc px) 1))) (swap! px assoc :desc [:Tvar n])))
                    t)
      :Ptyp_variant (transl-variant env vars d)
      :Ptyp_class (*hash-type* env (:txt (d 1)) (mapv #(transl-type env vars %) (d 2)))
      ;; Typetexp.transl_fields: the fields folded left over the row (the last outermost), an inherited object's fields
      ;; added
      :Ptyp_object (let [fields (reduce (fn [acc pof]
                                          (let [od (:pof_desc pof)]
                                            (case (od 0)
                                              :Otag (conj acc [(:txt (od 1)) (transl-type env vars (od 2))])
                                              :Oinherit (let [t (ty/expand-head (transl-type env vars (od 1)))
                                                              td (ty/desc t)]
                                                          (when-not (= :Tobject (td 0)) (type-error "This type is not an object type"))
                                                          (into acc (map (fn [[n _ x]] [n x]) (first (ty/fields-in-order (td 1)))))))))
                                        [] (d 1))
                         init (if (= :Closed (d 2)) (ty/newty [:Tnil]) (ty/newvar))]
                     (ty/newty [:Tobject (reduce (fn [r [n t]] (ty/newty [:Tfield n (ty/field-public) t r])) init fields) nil]))
      :Ptyp_package (let [pk (d 1)
                          mt (lookup-in env :modtypes (lid-parts (:txt (:ppt_path pk))))]
                      (when-not mt (type-error (str "Unbound module type " (str/join "." (lid-parts (:txt (:ppt_path pk)))))))
                      (ty/newty [:Tpackage (:path mt)
                                 (vec (sort-by first (map (fn [[lid t]] [(lid-parts (:txt lid)) (transl-type env vars t)])
                                                          (:ppt_constraints pk))))]))
      (type-error (str "type expression " (d 0) " outside the slice")))))

(defn make-generic!
  "Every node of t at the generic level (a declaration's or an interface's types)"
  [t]
  (let [t (ty/repr t)]
    (when-not (= ty/generic-level (ty/level t))
      (ty/set-level! t ty/generic-level)
      (run! make-generic! (ty/children (ty/desc t))))
    t))

;; ---------------------------------------------------------------------------------------------
;; Type declarations (typedecl.ml, datarepr.ml)

(defn- immediate-kind? [kind]
  (and (= :variant (kind 0)) (seq (kind 1)) (every? #(empty? (:args %)) (kind 1))))

(defn transl-type-decls
  "Typedecl.transl_type_decl for a recursive group: returns [env' [[name path decl]...]]; mkpath makes a type's
  path from its name"
  [env sdecls mkpath & [rec-flag]]
  (let [names (map #(:txt (:ptype_name %)) sdecls)
        paths (mapv mkpath names)
        env1 (if (= rec-flag :Nonrecursive) env (reduce (fn [e [n p]] (assoc-in e [:types n] p)) env (map vector names paths)))
        out (mapv
             (fn [sd p]
               (let [vars (atom {})
                     params (mapv (fn [[t _]] (let [d (:ptyp_desc t)]
                                                (if (= :Ptyp_var (d 0))
                                                  (let [v (ty/newvar (d 1))] (swap! vars assoc (d 1) v) v)
                                                  (ty/newvar))))
                                  (:ptype_params sd))
                     ;; Typedecl's constraints: each pair unified (a parameter constrained to a type)
                     _ (doseq [[c1 c2] (:ptype_constraints sd)]
                         (ty/unify (transl-type env1 vars c1) (transl-type env1 vars c2)))
                     manifest (when-let [m (:ptype_manifest sd)] (transl-type env1 vars m))
                     k (let [k (:ptype_kind sd)] (if (keyword? k) [k] k))
                     kind (case (k 0)
                            :Ptype_abstract [:abstract]
                            :Ptype_open [:open]
                            :Ptype_variant
                            [:variant (mapv (fn [cd]
                                              (let [a (:pcd_args cd) cname (:txt (:pcd_name cd))]
                                                (cond
                                                  (:pcd_res cd)
                                                  ;; a GADT constructor: its type closed over its own variables
                                                  (let [cvars (atom {})
                                                        _ (when (= :Pcstr_record (a 0))
                                                            (type-error "GADT constructors with inline records are outside the slice"))
                                                        args (mapv #(make-generic! (transl-type env1 cvars %)) (a 1))
                                                        res (make-generic! (transl-type env1 cvars (:pcd_res cd)))]
                                                    {:name cname :args args :res res})
                                                  (= :Pcstr_record (a 0))
                                                  ;; an inline record: its type t.C, a record declaration of its own
                                                  {:name cname
                                                   :args [(make-generic! (ty/newty [:Tconstr [:Pdot p cname] (vec params)]))]
                                                   :inlined (mapv (fn [ld] {:name (:txt (:pld_name ld)) :mut (= :Mutable (:pld_mutable ld))
                                                                            :type (make-generic! (transl-type env1 vars (:pld_type ld)))})
                                                                  (a 1))}
                                                  :else
                                                  {:name cname
                                                   :args (mapv #(make-generic! (transl-type env1 vars %)) (a 1))})))
                                            (k 1))]
                            :Ptype_record
                            (let [ls (mapv (fn [ld] {:name (:txt (:pld_name ld)) :mut (= :Mutable (:pld_mutable ld))
                                                     :atomic (boolean (some #(#{"atomic" "ocaml.atomic"} (:txt (:attr_name %)))
                                                                            (concat (:pld_attributes ld) (:ptyp_attributes (:pld_type ld)))))
                                                     :type (make-generic! (transl-type env1 vars (:pld_type ld)))})
                                           (k 1))
                                  fl (every? #(let [t (ty/expand-head (:type %)) dd (ty/desc t)]
                                                (and (= :Tconstr (dd 0)) (= (dd 1) ty/path-float)))
                                             ls)]
                              [:record ls (if fl :float :regular)]))
                     ;; [@@unboxed]: a one-constructor variant of one argument is its argument (Variant_unboxed)
                     kind (if (and (= :variant (kind 0)) (= 1 (count (kind 1))) (= 1 (count (:args (first (kind 1)))))
                                   (not (:inlined (first (kind 1))))
                                   (some #(#{"unboxed" "ocaml.unboxed"} (:txt (:attr_name %))) (:ptype_attributes sd)))
                            [:variant [(assoc (first (kind 1)) :unboxed true)]]
                            kind)]
                 (run! make-generic! params)
                 (when manifest (make-generic! manifest))
                 ;; Btype.set_static_row_name: a static variant abbreviation named by its declaration
                 (when manifest
                   (let [md (ty/desc manifest)]
                     (when (and (= :Tvariant (md 0)) (ty/static-row (md 1)))
                       (swap! (ty/repr manifest) assoc :desc [:Tvariant (ty/set-row-name (md 1) [p (vec params)])]))))
                 [(:txt (:ptype_name sd)) p
                  {:path p :params params :kind kind :manifest manifest :arity (count params)
                   :private (= :Private (:ptype_private sd))
                   :param-annots (mapv (fn [[_ [v i]]] [v i]) (:ptype_params sd))
                   :immediate-attr (boolean (some #(#{"immediate" "immediate64"} (:txt (:attr_name %))) (:ptype_attributes sd)))
                   :variance (case (kind 0)
                               :record (if (some :mut (kind 1)) (repeat :inv) (repeat :co))
                               :variant (if (some :res (kind 1)) (repeat :inv) (repeat :co))
                               (if manifest nil (repeat :inv)))}]))
             sdecls paths)]
    (doseq [[_ p d] out] (add-decl! p d))
    ;; immediacy (typedecl_immediacy.ml): constant-only variants, abbreviations of immediate types
    (doseq [[_ p d] out]
      (add-decl! p (assoc d :immediate (or (:immediate-attr d) (immediate-kind? (:kind d))
                                           (boolean (and (:manifest d) (binding [ty/*find-type* find-decl]
                                                                          (ty/immediate? (:manifest d)))))))))
    [(reduce (fn [e [n p d]]
               (let [d (find-decl p)
                     e (assoc-in e [:types n] p)
                     e (case ((:kind d) 0)
                         :variant (reduce (fn [e c] (update-in e [:constrs (:name c)] #(cons c %)))
                                          e (ty/constructors-of p (:params d) ((:kind d) 1)))
                         :record (reduce (fn [e l] (update-in e [:labels (:name l)] #(cons l %)))
                                         e (ty/labels-of p (:params d) ((:kind d) 1) ((:kind d) 2)))
                         e)]
                 e))
             env out)
     (mapv (fn [[n p _]] [n p (find-decl p)]) out)]))

(defn exn-constructor
  "An exception's constructor description; path is the exception's (Pident of its identifier, or the unit's field)"
  [env name sargs path]
  (let [vars (atom {})
        args (mapv #(make-generic! (transl-type env vars %)) sargs)]
    {:name name :args args :arity (count args) :res-path ty/path-exn :params []
     :tag [:Cstr_extension path (empty? args)] :consts 0 :nonconsts 0}))

(defn type-extension-constructors
  "Typedecl.transl_type_extension: each constructor [name id cstr] of `type ps t += ...`, the extended type's path and
  parameters its result's (a GADT constructor's own), a rebinding's the original's arguments; mkid makes an
  identifier from a name"
  [env styext mkid]
  (let [tp (or (lookup env :types (:txt (:ptyext_path styext)))
               (type-error (str "Unbound type constructor " (str/join "." (lid-parts (:txt (:ptyext_path styext)))))))
        vars (atom {})
        params (mapv (fn [[t _]] (let [d (:ptyp_desc t)]
                                   (if (= :Ptyp_var (d 0)) (let [v (ty/newvar (d 1))] (swap! vars assoc (d 1) v) v) (ty/newvar))))
                     (:ptyext_params styext))]
    (mapv (fn [ec]
            (let [n (:txt (:pext_name ec)) k (:pext_kind ec) id (mkid n)]
              (if (= :Pext_rebind (k 0))
                (let [orig (or (first (lookup env :constrs (:txt (k 1)))) (type-error (str "Unbound constructor " n)))]
                  [n id (assoc orig :name n :tag [:Cstr_extension (ty/pident id) (empty? (:args orig))]) (second (:tag orig))])
                (let [[_ _ a res] k
                      cv (if res (atom {}) vars)
                      _ (when-not (= :Pcstr_tuple (a 0)) (type-error "inline records in type extensions are outside the slice"))
                      args (mapv #(make-generic! (transl-type env cv %)) (a 1))
                      res (some->> res (transl-type env cv) make-generic!)]
                  (run! make-generic! params)
                  [n id (cond-> {:name n :args args :arity (count args) :res-path tp :params params
                                 :tag [:Cstr_extension (ty/pident id) (empty? args)] :consts 0 :nonconsts 0
                                 :typext {:path tp :params params}}
                          res (assoc :res res))
                   nil]))))
          (:ptyext_constructors styext))))

;; ---------------------------------------------------------------------------------------------
;; Predef's environment (predef.ml)

(defn- predef-decl [n kind & {:keys [immediate variance]}]
  {:path (ty/predef-path n) :params [] :kind kind :manifest nil :arity 0 :immediate immediate :variance variance})

(defn initial-predef
  "Predef.build_initial_env: its types, constructors and exceptions"
  []
  (let [g (fn [] (ty/newgenvar))
        a (g)
        simple ["int" "char" "bytes" "float" "exn" "nativeint" "int32" "int64" "string" "extension_constructor"
                "floatarray"]
        env (reduce (fn [e n] (assoc-in e [:types n] (ty/predef-path n))) {:values {} :types {} :constrs {} :labels {}
                                                                           :modules {}}
                    (concat simple ["bool" "unit" "array" "list" "option" "lazy_t" "iarray" "eff" "continuation"
                                    "atomic_loc"]))]
    (doseq [n simple]
      (add-decl! (ty/predef-path n) (predef-decl n (if (= n "exn") [:open] [:abstract])
                                                 :immediate (contains? #{"int" "char"} n))))
    (let [mk (fn [n params kind & {:keys [immediate variance]}]
               (add-decl! (ty/predef-path n) {:path (ty/predef-path n) :params params :kind kind :arity (count params)
                                              :immediate immediate :variance variance}))
          b (g) c (g)]
      (mk "bool" [] [:variant [{:name "false" :args []} {:name "true" :args []}]] :immediate true)
      (mk "unit" [] [:variant [{:name "()" :args []}]] :immediate true)
      (mk "list" [a] [:variant [{:name "[]" :args []}
                                {:name "::" :args [a (ty/newgenty [:Tconstr ty/path-list [a]])]}]] :variance [:co])
      (mk "option" [b] [:variant [{:name "None" :args []} {:name "Some" :args [b]}]] :variance [:co])
      (mk "array" [c] [:abstract] :variance [:inv])
      (mk "iarray" [(g)] [:abstract] :variance [:co])
      (mk "lazy_t" [(g)] [:abstract] :variance [:co]))
    (let [env (reduce (fn [e n]
                        (let [d (find-decl (ty/predef-path n))]
                          (reduce (fn [e c] (update-in e [:constrs (:name c)] #(cons c %)))
                                  e (ty/constructors-of (:path d) (:params d) ((:kind d) 1)))))
                      env ["bool" "unit" "list" "option"])
          tint (ty/newgenty [:Tconstr ty/path-int []])
          tstr (ty/newgenty [:Tconstr ty/path-string []])
          loc3 [(ty/newgenty [:Ttuple [[nil tstr] [nil tint] [nil tint]]])]
          exns {"Match_failure" loc3 "Out_of_memory" [] "Invalid_argument" [tstr] "Failure" [tstr] "Not_found" []
                "Sys_error" [tstr] "End_of_file" [] "Division_by_zero" [] "Stack_overflow" [] "Sys_blocked_io" []
                "Assert_failure" loc3 "Undefined_recursive_module" loc3 "Continuation_already_taken" []}]
      (reduce (fn [e [n args]]
                (update-in e [:constrs n]
                           #(cons {:name n :args args :arity (count args) :res-path ty/path-exn :params []
                                   :tag [:Cstr_extension (ty/predef-path n) (empty? args)] :consts 0 :nonconsts 0} %)))
              env exns))))

;; ---------------------------------------------------------------------------------------------
;; Compilation units' interfaces (the stdlib's .mli, translated as Typemod translates a signature)

(def ^:private units (atom {}))

(defn- read-intf [^String path]
  (let [b (java.nio.file.Files/readAllBytes (.toPath (File. path)))
        r (parser/parse b (.getName (File. path)) :intf)]
    (when-not (= :ok (first r)) (type-error (str "cannot read " path ": " (nth r 2))))
    (second r)))

(defn prim-arity
  "Primitive.parse_declaration's arity: the arrows of the declared type"
  [sty]
  (loop [t sty n 0]
    (let [d (:ptyp_desc t)]
      (case (d 0)
        :Ptyp_arrow (recur (d 3) (inc n))
        :Ptyp_poly (recur (d 2) n)
        n))))

(defn- unit-file [uname]
  (let [s (if (str/starts-with? uname "Stdlib__") (subs uname 8) uname)
        base (str (str/lower-case (subs s 0 1)) (subs s 1))]
    (str *stdlib-dir* "/" base ".mli")))

(declare initial-env components)

(def unit-signature-fn
  "Typemod's translation of a unit's interface: (fn [env items uname] sig-items), set by typemod"
  (atom nil))

(defn find-unit
  "The components of a unit of the stdlib (by its unit name, \"Stdlib__List\"), read on first use"
  [uname]
  (or (get @units uname)
      (let [f (unit-file uname)]
        (when (.exists (File. ^String f))
          (let [items (read-intf f)
                base (if (or (= uname "Stdlib") (= uname "CamlinternalFormatBasics")) (initial-predef) (initial-env))
                base (if (= uname "Stdlib") (assoc base :alias-prefix "Stdlib__") base)
                sig (ty/with-unit-stamps (binding [*lenient* true ty/*find-type* find-decl] (@unit-signature-fn base items uname)))
                id (ty/ident-global uname)
                c (assoc (components [:Pident id] [:global id] [:Mty_signature sig]) :sig sig)]
            (swap! units assoc uname c)
            c)))))

(def ^:private initial (atom nil))

(defn initial-env
  "Env.initial with Stdlib opened (the default -open Stdlib): Predef's environment, then Stdlib's components"
  []
  (or @initial
      (let [pre (initial-predef)
            s (find-unit "Stdlib")
            env (reduce (fn [e k] (update e k merge (get s k))) pre [:values :types :modules])
            env (reduce (fn [e k] (update e k (fn [m] (merge-with (fn [old new] (concat new old)) m (get s k)))))
                        env [:constrs :labels])]
        (reset! initial env)
        env)))

(declare reset-modules!)
(defn reset-env! [] (reset! decls {}) (reset! units {}) (reset! initial nil) (reset-modules!))

(defn path-name
  "Printtyp's name of a type path: a predef or local type by its name, Stdlib's opened prefix left out, another
  stdlib unit by its alias (Stdlib__List.t: List.t)"
  [p]
  (case (p 0)
    :Pident (:name (p 1))
    :Pdot (let [h (p 1)]
            (if (= :Pident (h 0))
              (let [u (:name (h 1))]
                (cond (= u "Stdlib") (p 2)
                      (str/starts-with? u "Stdlib__") (str (subs u 8) "." (p 2))
                      :else (str u "." (p 2))))
              (str (path-name h) "." (p 2))))
    :Papply (str (path-name (p 1)) "(" (path-name (p 2)) ")")))

;; ---------------------------------------------------------------------------------------------
;; Modules (env.ml's module components, subst.ml's substitutions, mtype.ml's scrape and strengthen)
;;
;; A module type is [:Mty_ident path] [:Mty_signature items] [:Mty_functor param res] (param nil for (), else
;; [id-or-nil mty]) [:Mty_alias path]; a signature's items are [:val name id type kind] (kind nil or [:prim desc])
;; [:type [[name path decl]...]] [:exn name id cstr] [:module name id mty] [:modtype name id mty-or-nil]. An
;; environment's module is a stdlib unit's name or {:path :mty :addr}; an address is [:global id] [:var id] [:field
;; addr pos], what Translmod reads.

(def ^:private module-ids "A bound module's identifier to its {:path :mty :addr}" (atom {}))
(def ^:private modtype-paths "A module type's path to its definition (nil: abstract)" (atom {}))
(def ^:private comps-cache (atom {}))

(defn- unit-id? [id] (>= (:stamp id 0) ty/unit-stamp-base))
(defn- unit-path? [p] (case (p 0) :Pident (or (unit-id? (p 1)) (:global (p 1))) :Pdot (unit-path? (p 1)) false))

(defn reset-modules!
  "A program's modules forgotten (the stdlib's interfaces' kept)"
  []
  (swap! module-ids (fn [m] (into {} (filter (fn [[id _]] (unit-id? id)) m))))
  (swap! modtype-paths (fn [m] (into {} (filter (fn [[p _]] (unit-path? p)) m))))
  (reset! comps-cache {})
  (reset! alias-required #{})
  (swap! ext-addrs (fn [m] (into {} (filter (fn [[p _]] (unit-path? p)) m)))))

(defn add-module! [id entry] (swap! module-ids assoc id entry) entry)
(defn add-modtype! [p mty] (swap! modtype-paths assoc p mty))
(defn find-modtype [p]
  (if (contains? @modtype-paths p)
    (get @modtype-paths p)
    (when (= :Pdot (p 0))
      (module-components-of-path (p 1))
      (get @modtype-paths p))))

;; ---- substitutions (subst.ml): identifiers to paths, in paths, types, declarations and module types

(defn subst-path [s p]
  (case (p 0)
    :Pident (get s (p 1) p)
    :Pdot (let [q (subst-path s (p 1))] (if (identical? q (p 1)) p [:Pdot q (p 2)]))
    :Papply [:Papply (subst-path s (p 1)) (subst-path s (p 2))]))

(defn subst-type
  "The type with its paths substituted: constructors' nodes copied, variables shared (a declaration's parameters
  stay its manifest's), memo shared by the nodes of one item"
  [s memo t]
  (if (empty? s)
    t
    (letfn [(go [t]
              (let [t (ty/repr t)]
                (or (get @memo t)
                    (let [d (ty/desc t)]
                      (if (= :Tvar (d 0))
                        t
                        (let [n (ty/newty2 (ty/level t) [:Tvar nil])]
                          (swap! memo assoc t n)
                          (swap! n assoc :desc (let [d (ty/map-desc go d)]
                                                 (case (d 0)
                                                   :Tconstr [:Tconstr (subst-path s (d 1)) (d 2)]
                                                   :Tvariant (let [r (d 1)]
                                                               (if-let [[np args] (:name r)] [:Tvariant (assoc r :name [(subst-path s np) args])] d))
                                                   d)))
                          n))))))]
      (go t))))

(defn subst-decl [s path decl]
  (let [m (atom {}) st #(subst-type s m %) k (:kind decl)]
    (assoc decl :path path
           :params (mapv st (:params decl))
           :manifest (some-> (:manifest decl) st)
           :kind (case (k 0)
                   :variant [:variant (mapv (fn [c] (cond-> (update c :args (fn [as] (mapv st as)))
                                                      (:res c) (update :res st)
                                                      (:inlined c) (update :inlined (fn [ls] (mapv #(update % :type st) ls)))))
                                            (k 1))]
                   :record [:record (mapv #(update % :type st) (k 1)) (k 2)]
                   k))))

(declare subst-mty)

(defn subst-items [s items]
  (mapv (fn [item]
          (case (item 0)
            :val (assoc item 3 (subst-type s (atom {}) (item 3)))
            :type [:type (mapv (fn [[n p d]] [n p (subst-decl s p d)]) (item 1))]
            :exn (let [m (atom {})]
                   (assoc item 3 (cond-> (update (item 3) :args (fn [as] (mapv #(subst-type s m %) as)))
                                   (:res (item 3)) (update :res #(subst-type s m %))
                                   (:typext (item 3)) (update :typext (fn [x] (update x :path #(subst-path s %))))
                                   true (update :res-path #(subst-path s %)))))
            :module (assoc item 3 (subst-mty s (item 3)))
            :modtype (assoc item 3 (some->> (item 3) (subst-mty s)))
            item))
        items))

(defn subst-mty [s mty]
  (if (empty? s)
    mty
    (case (mty 0)
      :Mty_ident [:Mty_ident (subst-path s (mty 1))]
      :Mty_alias [:Mty_alias (subst-path s (mty 1))]
      :Mty_signature [:Mty_signature (subst-items s (mty 1))]
      :Mty_functor [:Mty_functor (when-let [[id m] (mty 1)] [id (subst-mty s m)]) (subst-mty s (mty 2))])))

(defn bound-type-ids
  "The identifiers a signature binds that paths name (types, modules, module types), with their names"
  [items]
  (mapcat (fn [item]
            (case (item 0)
              :type (map (fn [[n p _]] [(p 1) n]) (item 1))
              (:module :modtype) [[(item 2) (item 1)]]
              []))
          items))

(defn register-items!
  "The declarations of a signature's types registered under their paths (a signature made by substitution)"
  [items]
  (doseq [item items]
    (when (= :type (item 0))
      (doseq [[_ p d] (item 1)] (add-decl! p d)))))

(defn rename-items
  "Subst.rename_bound_idents: the signature with fresh identifiers for what it binds, the references renamed, the
  new types registered"
  [items]
  (let [fresh (into {} (map (fn [[id _]] [id (ty/ident-rename id)]) (bound-type-ids items)))
        s (into {} (map (fn [[id id']] [id [:Pident id']]) fresh))
        items (mapv (fn [item]
                      (case (item 0)
                        :type [:type (mapv (fn [[n p d]] [n [:Pident (fresh (p 1))] d]) (item 1))]
                        (:module :modtype) (assoc item 2 (fresh (item 2)))
                        (:val :class) (assoc item 2 (ty/ident-rename (item 2)))
                        ;; an exception's constructor names the new identifier
                        :exn (let [id' (ty/ident-rename (item 2)) tag (:tag (item 3))]
                               (cond-> (assoc item 2 id')
                                 (and (= :Cstr_extension (first tag)) (= [:Pident (item 2)] (second tag)))
                                 (assoc-in [3 :tag] [:Cstr_extension [:Pident id'] (nth tag 2)])))
                        item))
                    items)
        items (subst-items s items)]
    (register-items! items)
    items))

;; ---- scrape and strengthen (mtype.ml)

(declare find-module)

(defn scrape
  "Mtype.scrape: the module type with its head names expanded (a module type's definition, an alias's module)"
  [mty]
  (case (mty 0)
    :Mty_ident (if-let [m (find-modtype (mty 1))] (recur m) mty)
    :Mty_alias (recur (:mty (find-module (mty 1))))
    mty))

(defn strengthen
  "Mtype.strengthen: abstract types made equal to their path's, submodules aliases (aliasable) or strengthened; a
  functor's result strengthened by its application to its parameter (applicative paths)"
  [aliasable mty p]
  (let [mty (scrape mty)]
    (case (mty 0)
      :Mty_functor (if-let [[pid parg] (mty 1)]
                     (if pid [:Mty_functor [pid parg] (strengthen false (mty 2) [:Papply p [:Pident pid]])] mty)
                     mty)
      :Mty_signature
      [:Mty_signature
       (mapv (fn [item]
               (case (item 0)
                 :type [:type (mapv (fn [[n tp d]]
                                      (if (and (:manifest d) (not (:private d)))
                                        [n tp d]
                                        (let [d' (assoc d :manifest (ty/newgenty [:Tconstr [:Pdot p n] (vec (:params d))]))]
                                          (add-decl! tp d')
                                          [n tp d'])))
                                    (item 1))]
                 :module (assoc item 3 (if aliasable
                                         [:Mty_alias [:Pdot p (item 1)]]
                                         (strengthen false (item 3) [:Pdot p (item 1)])))
                 :modtype (if (item 3) item (assoc item 3 [:Mty_ident [:Pdot p (item 1)]]))
                 item))
             (rename-items (mty 1)))]
      mty)))

;; ---- components (env.ml's components_of_module, prefixed by the module's path)

(defn runtime-item?
  "An item with a field in its module's block: a value not a primitive, an exception, a present module, a hole (what
  the slice does not type in a unit's interface: an extension constructor, a class, a recursive module)"
  [item]
  (case (item 0) :val (not= :prim (first (item 4))) :exn true :module (not= :absent (get item 4)) :hole true :class true false))

(defn alias-addr
  "The address of an absent module, an alias: its target's"
  [mty]
  (when (= :Mty_alias (mty 0))
    (let [p (mty 1)] (if (and (= :Pident (p 0)) (:global (p 1))) [:global (p 1)] (:addr (find-module p))))))

(defn components
  "The components of a module of path p, address addr and type mty: each value with its path and address (the field
  of its position), types with their declarations registered under p, constructors, labels, submodules, module
  types"
  [p addr mty]
  (let [mty (scrape mty)]
    (when (= :Mty_signature (mty 0))
      (let [items (mty 1)
            s (into {} (map (fn [[id n]] [id [:Pdot p n]]) (bound-type-ids items)))
            items (subst-items s items)
            pos (atom 0)
            field! (fn [] (let [i @pos] (swap! pos inc) (when addr [:field addr i])))]
        (reduce
         (fn [c item]
           (case (item 0)
             :val (let [[_ n _ t k] item]
                    (assoc-in c [:values n] (if (= :prim (first k))
                                              {:type t :kind k :path [:Pdot p n]}
                                              {:type t :kind [:reg] :path [:Pdot p n] :addr (field!)})))
             :type (reduce (fn [c [n _ d]]
                             (let [np [:Pdot p n] d (assoc d :path np) k (:kind d)]
                               (add-decl! np d)
                               (let [c (assoc-in c [:types n] np)]
                                 (case (k 0)
                                   :variant (reduce (fn [c x] (update-in c [:constrs (:name x)] #(cons x %)))
                                                    c (ty/constructors-of np (:params d) (k 1)))
                                   :record (reduce (fn [c x] (update-in c [:labels (:name x)] #(cons x %)))
                                                   c (ty/labels-of np (:params d) (k 1) (k 2)))
                                   c))))
                           c (item 1))
             :exn (let [[_ n _ cs] item np [:Pdot p n] a (field!)
                        cs (assoc cs :tag [:Cstr_extension np (empty? (:args cs))])]
                    (when a (swap! ext-addrs assoc np a))
                    (update-in c [:constrs n] #(cons cs %)))
             :module (assoc-in c [:modules (item 1)]
                               {:path [:Pdot p (item 1)] :mty (item 3)
                                :addr (if (= :absent (get item 4)) (alias-addr (item 3)) (field!))})
             :hole (do (field!) c)
             :class (let [[_ n _ decl] item]
                      (-> c (assoc-in [:types n] (:path decl))
                          (assoc-in [:classes n] {:path [:Pdot p n] :decl decl :addr (field!)})
                          (assoc-in [:cltypes n] {:path [:Pdot p n] :decl (update decl :type class-body)})))
             :class-type (let [[_ n _ decl] item]
                           (-> c (assoc-in [:types n] (:path decl)) (assoc-in [:cltypes n] {:path [:Pdot p n] :decl decl})))
             :modtype (let [np [:Pdot p (item 1)]]
                        (add-modtype! np (item 3))
                        (assoc-in c [:modtypes (item 1)] {:path np :mty (item 3)}))))
         {:values {} :types {} :constrs {} :labels {} :modules {} :modtypes {} :size 0}
         items)))))

(defn unit-entry
  "A stdlib unit as a module entry"
  [uname]
  (let [id (ty/ident-global uname)] {:path [:Pident id] :addr [:global id] :unit uname}))

(defn find-module
  "The module entry {:path :mty :addr} of a path"
  [p]
  (case (p 0)
    :Pident (let [id (p 1)]
              (or (get @module-ids id)
                  (when (:global id)
                    (when-let [u (find-unit (:name id))]
                      (assoc (unit-entry (:name id)) :mty [:Mty_signature (:sig u)])))
                  (type-error (str "Unbound module " (:name id)))))
    :Pdot (let [e (find-module (p 1))
                c (entry-components e)
                m (get-in c [:modules (p 2)])]
            (cond (map? m) m
                  (string? m) (unit-entry m)
                  :else (type-error (str "Unbound module " (path-name p)))))
    :Papply (let [f (scrape (:mty (find-module (p 1))))]
              (when-not (= :Mty_functor (f 0)) (type-error "not a functor"))
              (let [[pid _] (f 1)]
                {:path p :addr nil :mty (if pid (subst-mty {pid (p 2)} (f 2)) (f 2))}))))

(defn entry-components
  "A module entry's components; an alias's its target's (Env.normalize_module_path)"
  [e]
  (cond
    (string? e) (find-unit e)
    (:unit e) (find-unit (:unit e))
    (= :Mty_alias (first (:mty e))) (module-components-of-path ((:mty e) 1))
    :else (let [k [(:path e) (:addr e)]]
            (or (get @comps-cache k)
                (let [c (components (:path e) (:addr e) (:mty e))]
                  (swap! comps-cache assoc k c)
                  c)))))

(defn module-components-of-path [p] (entry-components (find-module p)))

(defn normalize-module-path
  "Env.normalize_module_path: an alias's path replaced by its target's"
  [p]
  (let [p (case (p 0) :Pdot (let [q (normalize-module-path (p 1))] (if (= q (p 1)) p [:Pdot q (p 2)])) p)
        e (when-not (= :Papply (p 0)) (try (find-module p) (catch arbace.lang.ExceptionInfo _ nil)))]
    (if (and e (= :Mty_alias (first (:mty e))))
      (recur ((:mty e) 1))
      p)))

(defn normalize-entry [e]
  (if (= :Mty_alias (first (:mty e)))
    (let [p (normalize-module-path ((:mty e) 1))] (or (find-module p) e))
    e))

(defn- alias-entry? [e] (and (map? e) (= :Mty_alias (first (:mty e)))))

(defn lookup-module
  "The module entry a Longident names; a submodule reached through an alias is an alias itself (Env's components
  of an alias path), its path the one written"
  [env lid]
  (let [parts (lid-parts lid)
        unbound #(type-error (str "Unbound module " (str/join "." parts)))
        as-entry (fn [m] (cond (map? m) m (string? m) (unit-entry m) :else nil))
        _ (note-alias! (get-in env [:modules (first parts)]))
        e0 (or (as-entry (get-in env [:modules (first parts)]))
               (when (or (get @units (first parts)) (.exists (File. ^String (unit-file (first parts))))) (unit-entry (first parts)))
               (unbound))]
    (loop [e e0 more (rest parts) through (alias-entry? e0)]
      (if (empty? more)
        e
        (let [s (first more)
              m (or (as-entry (get-in (entry-components e) [:modules s])) (unbound))
              e' (if through
                   {:path [:Pdot (:path e) s] :mty [:Mty_alias (normalize-module-path (:path m))] :addr (:addr m)}
                   m)]
          (recur e' (rest more) (or through (alias-entry? m))))))))

(defn lookup-modtype [env lid]
  (or (lookup-in env :modtypes (lid-parts lid))
      (type-error (str "Unbound module type " (str/join "." (lid-parts lid))))))

(defn open-components
  "The environment with a module's components opened (Env.open_signature)"
  [env c]
  (let [env (reduce (fn [e k] (update e k merge (get c k))) env [:values :types :modules :modtypes])]
    (reduce (fn [e k] (update e k (fn [m] (merge-with (fn [old new] (concat new old)) m (get c k)))))
            env [:constrs :labels])))

(defn modtype-of-package
  "Typemod.modtype_of_package: the module type of a package type, its constraints made manifest"
  [t]
  (let [[_ p cs] (ty/desc t)]
    (if (empty? cs)
      [:Mty_ident p]
      (let [m (scrape [:Mty_ident p])
            _ (when-not (= :Mty_signature (m 0)) (type-error "a package type's module type is not a signature"))
            items (rename-items (m 1))
            cm (into {} cs)]
        [:Mty_signature
         (mapv (fn [item]
                 (if (= :type (item 0))
                   [:type (mapv (fn [[n tp dd]]
                                  (if-let [x (get cm [n])]
                                    (let [dd (assoc dd :manifest x)] (add-decl! tp dd) [n tp dd])
                                    [n tp dd]))
                                (item 1))]
                   item))
               items)]))))

(defn normalize-type-path
  "Env.normalize_type_path: the module part of a type path normalized (aliases followed)"
  [p]
  (if (= :Pdot (p 0))
    (let [q (try (normalize-module-path (p 1)) (catch arbace.lang.ExceptionInfo _ (p 1)))]
      (if (= q (p 1)) p [:Pdot q (p 2)]))
    p))

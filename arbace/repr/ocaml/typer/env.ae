(ns arbace.repr.ocaml.typer.env
  "The typing environment (doc/ocaml/TYPER.md, T1): an environment is a map {:values :types :constrs :labels
  :modules}, names to descriptions; the declarations of every type path are in one registry. The initial
  environment is Predef's with the stdlib's Stdlib opened, its interface (stdlib/stdlib.mli of the pinned tarball)
  read by the native reader and translated here, as the other units' (Stdlib__List...) on first use: their values
  with their runtime positions (the fields of the unit's block), externals with their primitives."
  (:require [arbace.repr.ocaml.typer.types :as ty]
            [arbace.repr.ocaml.parser :as parser]
            [arbace.string :as str])
  (:import [java.io File]))

(set! *warn-on-reflection* false)

(def decls (atom {}))
(def ext-positions "An exception of a unit's interface: its path to its field's position" (atom {}))
(defn find-decl [p] (get @decls p))
(defn add-decl! [p d] (swap! decls assoc p d))

(def ^:dynamic *stdlib-dir* ".tmp/repr-ocaml/ocaml-5.5.0/stdlib")

(defn type-error [msg & [data]] (throw (ex-info msg (merge {:ocaml-type-error msg} data))))

;; ---------------------------------------------------------------------------------------------
;; Core types (typetexp.ml)

(defn lid-parts
  "A Longident as [module-names... name]"
  [lid]
  (case (lid 0)
    :Lident [(lid 1)]
    :Ldot (conj (lid-parts (:txt (lid 1))) (:txt (lid 2)))
    (type-error "functor applications are outside the slice")))

(declare find-unit)

(defn- lookup-in
  "The component kind (:values :types :constrs :labels) of name, after the modules of path"
  [env kind parts]
  (if (= 1 (count parts))
    (get-in env [kind (first parts)])
    (let [m (get-in env [:modules (first parts)])
          u (find-unit (or m (first parts)))]
      (when-not u (type-error (str "Unbound module " (first parts))))
      (recur u kind (vec (rest parts))))))

(defn lookup [env kind lid] (lookup-in env kind (lid-parts lid)))

(defn- param-variance [decl-kind manifest]
  nil)

(def ^:dynamic *lenient*
  "While a unit's interface is read: a type outside the slice is an opaque constructor, not an error" false)
(def opaque-path [:Pident {:name "<outside the typer's slice>" :stamp -1}])

(declare transl-type*)

(defn transl-type [env vars sty]
  (if *lenient*
    (try (transl-type* env vars sty)
         (catch arbace.lang.ExceptionInfo e
           (if (:ocaml-type-error (ex-data e)) (ty/tconstr opaque-path []) (throw e))))
    (transl-type* env vars sty)))

(defn transl-type*
  "Typetexp.transl_simple_type: the core type as a type, variables named in the map atom vars (created on first
  use when fresh is true)"
  [env vars sty]
  (let [d (:ptyp_desc sty)]
    (case (d 0)
      :Ptyp_any (ty/newvar)
      :Ptyp_var (or (get @vars (d 1))
                    (let [v (ty/newvar (d 1))] (swap! vars assoc (d 1) v) v))
      :Ptyp_arrow (let [l (d 1) a (transl-type env vars (d 2)) r (transl-type env vars (d 3))]
                    (ty/newty [:Tarrow l (if (ty/is-optional l) (ty/type-option a) a) r]))
      :Ptyp_tuple (ty/newty [:Ttuple (mapv (fn [[l t]] [l (transl-type env vars t)]) (d 1))])
      :Ptyp_constr (let [p (lookup env :types (:txt (d 1)))]
                     (when-not p (type-error (str "Unbound type constructor " (str/join "." (lid-parts (:txt (d 1)))))))
                     (ty/tconstr p (mapv #(transl-type env vars %) (d 2))))
      :Ptyp_poly (transl-type env vars (d 2))
      (type-error (str "type expression " (d 0) " outside the slice")))))

(defn make-generic!
  "Every node of t at the generic level (a declaration's or an interface's types)"
  [t]
  (let [t (ty/repr t)]
    (when-not (= ty/generic-level (ty/level t))
      (ty/set-level! t ty/generic-level)
      (run! make-generic! (ty/children (ty/desc t))))
    t))

;; ---------------------------------------------------------------------------------------------
;; Type declarations (typedecl.ml, datarepr.ml)

(defn- immediate-kind? [kind]
  (and (= :variant (kind 0)) (seq (kind 1)) (every? #(empty? (:args %)) (kind 1))))

(defn transl-type-decls
  "Typedecl.transl_type_decl for a recursive group: returns [env' [[name path decl]...]]; mkpath makes a type's
  path from its name"
  [env sdecls mkpath]
  (let [names (map #(:txt (:ptype_name %)) sdecls)
        paths (mapv mkpath names)
        env1 (reduce (fn [e [n p]] (assoc-in e [:types n] p)) env (map vector names paths))
        out (mapv
             (fn [sd p]
               (let [vars (atom {})
                     params (mapv (fn [[t _]] (let [d (:ptyp_desc t)]
                                                (if (= :Ptyp_var (d 0))
                                                  (let [v (ty/newvar (d 1))] (swap! vars assoc (d 1) v) v)
                                                  (ty/newvar))))
                                  (:ptype_params sd))
                     manifest (when-let [m (:ptype_manifest sd)] (transl-type env1 vars m))
                     k (let [k (:ptype_kind sd)] (if (keyword? k) [k] k))
                     kind (case (k 0)
                            :Ptype_abstract [:abstract]
                            :Ptype_open [:open]
                            :Ptype_variant
                            [:variant (mapv (fn [cd]
                                              (let [a (:pcd_args cd)]
                                                (when-not (= :Pcstr_tuple (a 0))
                                                  (type-error "inline records are outside the slice"))
                                                (when (or (:pcd_res cd) (seq (:pcd_vars cd)))
                                                  (type-error "GADT constructors are outside the slice"))
                                                {:name (:txt (:pcd_name cd))
                                                 :args (mapv #(make-generic! (transl-type env1 vars %)) (a 1))}))
                                            (k 1))]
                            :Ptype_record
                            (let [ls (mapv (fn [ld] {:name (:txt (:pld_name ld)) :mut (= :Mutable (:pld_mutable ld))
                                                     :type (make-generic! (transl-type env1 vars (:pld_type ld)))})
                                           (k 1))
                                  fl (every? #(let [t (ty/expand-head (:type %)) dd (ty/desc t)]
                                                (and (= :Tconstr (dd 0)) (= (dd 1) ty/path-float)))
                                             ls)]
                              [:record ls (if fl :float :regular)]))]
                 (run! make-generic! params)
                 (when manifest (make-generic! manifest))
                 [(:txt (:ptype_name sd)) p
                  {:path p :params params :kind kind :manifest manifest :arity (count params)
                   :private (= :Private (:ptype_private sd))
                   :variance (case (kind 0)
                               :record (if (some :mut (kind 1)) (repeat :inv) (repeat :co))
                               :variant (repeat :co)
                               (if manifest nil (repeat :inv)))}]))
             sdecls paths)]
    (doseq [[_ p d] out] (add-decl! p d))
    ;; immediacy (typedecl_immediacy.ml): constant-only variants, abbreviations of immediate types
    (doseq [[_ p d] out]
      (add-decl! p (assoc d :immediate (or (immediate-kind? (:kind d))
                                           (boolean (and (:manifest d) (binding [ty/*find-type* find-decl]
                                                                          (ty/immediate? (:manifest d)))))))))
    [(reduce (fn [e [n p d]]
               (let [d (find-decl p)
                     e (assoc-in e [:types n] p)
                     e (case ((:kind d) 0)
                         :variant (reduce (fn [e c] (update-in e [:constrs (:name c)] #(cons c %)))
                                          e (ty/constructors-of p (:params d) ((:kind d) 1)))
                         :record (reduce (fn [e l] (update-in e [:labels (:name l)] #(cons l %)))
                                         e (ty/labels-of p (:params d) ((:kind d) 1) ((:kind d) 2)))
                         e)]
                 e))
             env out)
     out]))

(defn exn-constructor
  "An exception's constructor description; path is the exception's (Pident of its identifier, or the unit's field)"
  [env name sargs path]
  (let [vars (atom {})
        args (mapv #(make-generic! (transl-type env vars %)) sargs)]
    {:name name :args args :arity (count args) :res-path ty/path-exn :params []
     :tag [:Cstr_extension path (empty? args)] :consts 0 :nonconsts 0}))

;; ---------------------------------------------------------------------------------------------
;; Predef's environment (predef.ml)

(defn- predef-decl [n kind & {:keys [immediate variance]}]
  {:path (ty/predef-path n) :params [] :kind kind :manifest nil :arity 0 :immediate immediate :variance variance})

(defn initial-predef
  "Predef.build_initial_env: its types, constructors and exceptions"
  []
  (let [g (fn [] (ty/newgenvar))
        a (g)
        simple ["int" "char" "bytes" "float" "exn" "nativeint" "int32" "int64" "string" "extension_constructor"
                "floatarray"]
        env (reduce (fn [e n] (assoc-in e [:types n] (ty/predef-path n))) {:values {} :types {} :constrs {} :labels {}
                                                                           :modules {}}
                    (concat simple ["bool" "unit" "array" "list" "option" "lazy_t" "iarray" "eff" "continuation"
                                    "atomic_loc"]))]
    (doseq [n simple]
      (add-decl! (ty/predef-path n) (predef-decl n (if (= n "exn") [:open] [:abstract])
                                                 :immediate (contains? #{"int" "char"} n))))
    (let [mk (fn [n params kind & {:keys [immediate variance]}]
               (add-decl! (ty/predef-path n) {:path (ty/predef-path n) :params params :kind kind :arity (count params)
                                              :immediate immediate :variance variance}))
          b (g) c (g)]
      (mk "bool" [] [:variant [{:name "false" :args []} {:name "true" :args []}]] :immediate true)
      (mk "unit" [] [:variant [{:name "()" :args []}]] :immediate true)
      (mk "list" [a] [:variant [{:name "[]" :args []}
                                {:name "::" :args [a (ty/newgenty [:Tconstr ty/path-list [a]])]}]] :variance [:co])
      (mk "option" [b] [:variant [{:name "None" :args []} {:name "Some" :args [b]}]] :variance [:co])
      (mk "array" [c] [:abstract] :variance [:inv])
      (mk "iarray" [(g)] [:abstract] :variance [:co])
      (mk "lazy_t" [(g)] [:abstract] :variance [:co]))
    (let [env (reduce (fn [e n]
                        (let [d (find-decl (ty/predef-path n))]
                          (reduce (fn [e c] (update-in e [:constrs (:name c)] #(cons c %)))
                                  e (ty/constructors-of (:path d) (:params d) ((:kind d) 1)))))
                      env ["bool" "unit" "list" "option"])
          tint (ty/newgenty [:Tconstr ty/path-int []])
          tstr (ty/newgenty [:Tconstr ty/path-string []])
          loc3 [(ty/newgenty [:Ttuple [[nil tstr] [nil tint] [nil tint]]])]
          exns {"Match_failure" loc3 "Out_of_memory" [] "Invalid_argument" [tstr] "Failure" [tstr] "Not_found" []
                "Sys_error" [tstr] "End_of_file" [] "Division_by_zero" [] "Stack_overflow" [] "Sys_blocked_io" []
                "Assert_failure" loc3 "Undefined_recursive_module" loc3 "Continuation_already_taken" []}]
      (reduce (fn [e [n args]]
                (update-in e [:constrs n]
                           #(cons {:name n :args args :arity (count args) :res-path ty/path-exn :params []
                                   :tag [:Cstr_extension (ty/predef-path n) (empty? args)] :consts 0 :nonconsts 0} %)))
              env exns))))

;; ---------------------------------------------------------------------------------------------
;; Compilation units' interfaces (the stdlib's .mli, translated as Typemod translates a signature)

(def ^:private units (atom {}))

(defn- read-intf [^String path]
  (let [b (java.nio.file.Files/readAllBytes (.toPath (File. path)))
        r (parser/parse b (.getName (File. path)) :intf)]
    (when-not (= :ok (first r)) (type-error (str "cannot read " path ": " (nth r 2))))
    (second r)))

(defn prim-arity
  "Primitive.parse_declaration's arity: the arrows of the declared type"
  [sty]
  (loop [t sty n 0]
    (let [d (:ptyp_desc t)]
      (case (d 0)
        :Ptyp_arrow (recur (d 3) (inc n))
        :Ptyp_poly (recur (d 2) n)
        n))))

(defn- unit-file [uname]
  (let [s (if (str/starts-with? uname "Stdlib__") (subs uname 8) uname)
        base (str (str/lower-case (subs s 0 1)) (subs s 1))]
    (str *stdlib-dir* "/" base ".mli")))

(declare initial-env)

(defn- transl-signature
  "A unit's interface as its components: each value with its path (the unit's block field) or its primitive, types,
  constructors, labels, exceptions, the module aliases (to other units)"
  [uname items base-env]
  (let [upath (ty/pident (ty/ident-global uname))
        pos (atom 0)
        field! (fn [] (let [p @pos] (swap! pos inc) p))]
    (loop [items items env base-env comps {:values {} :types {} :constrs {} :labels {} :modules {}}]
      (if (empty? items)
        (assoc comps :size @pos :path upath)
        (let [d (:psig_desc (first items))
              add (fn [env comps kind name v]
                    [(assoc-in env [kind name] v) (assoc-in comps [kind name] v)])]
          (case (d 0)
            :Psig_value
            (let [v (d 1) name (:txt (:pval_name v))
                  t (make-generic! (binding [ty/*find-type* find-decl] (transl-type env (atom {}) (:pval_type v))))
                  prims (vec (:pval_prim v))
                  vd (if (seq prims)
                       {:type t :kind [:prim {:name (first prims) :arity (prim-arity (:pval_type v))}]}
                       {:type t :kind [:reg] :path (ty/pdot upath name) :pos (field!)})
                  [env comps] (add env comps :values name vd)]
              (recur (rest items) env comps))
            :Psig_type
            (let [[env2 out] (transl-type-decls env (d 2) #(ty/pdot upath %))
                  comps (reduce (fn [c [n p decl]]
                                  (let [c (assoc-in c [:types n] p)
                                        k (:kind decl)]
                                    (case (k 0)
                                      :variant (reduce (fn [c x] (update-in c [:constrs (:name x)] #(cons x %)))
                                                       c (ty/constructors-of p (:params decl) (k 1)))
                                      :record (reduce (fn [c x] (update-in c [:labels (:name x)] #(cons x %)))
                                                      c (ty/labels-of p (:params decl) (k 1) (k 2)))
                                      c)))
                                comps out)]
              (recur (rest items) env2 comps))
            :Psig_exception
            (let [ec (:ptyexn_constructor (d 1)) name (:txt (:pext_name ec)) k (:pext_kind ec)
                  path (ty/pdot upath name)
                  c (assoc (exn-constructor env name ((k 2) 1) path) :pos (field!))
                  _ (swap! ext-positions assoc path (:pos c))
                  env (update-in env [:constrs name] #(cons c %))
                  comps (update-in comps [:constrs name] #(cons c %))]
              (recur (rest items) env comps))
            :Psig_module
            (let [md (d 1) name (:txt (:pmd_name md)) mt (:pmty_desc (:pmd_type md))]
              (if (= :Pmty_alias (mt 0))
                (let [target (first (lid-parts (:txt (mt 1))))
                      u (if (= uname "Stdlib") (str "Stdlib__" target) (get-in env [:modules target] target))
                      [env comps] (add env comps :modules name u)]
                  (recur (rest items) env comps))
                (do (field!) (recur (rest items) env comps))))
            :Psig_typext
            (do (dotimes [_ (count (:ptyext_constructors (d 1)))] (field!)) (recur (rest items) env comps))
            :Psig_recmodule (do (dotimes [_ (count (d 1))] (field!)) (recur (rest items) env comps))
            :Psig_class (do (dotimes [_ (count (d 1))] (field!)) (recur (rest items) env comps))
            (recur (rest items) env comps)))))))

(defn find-unit
  "The components of a unit of the stdlib (by its unit name, \"Stdlib__List\"), read on first use"
  [uname]
  (or (get @units uname)
      (let [f (unit-file uname)]
        (when (.exists (File. ^String f))
          (let [items (read-intf f)
                base (if (or (= uname "Stdlib") (= uname "CamlinternalFormatBasics")) (initial-predef) (initial-env))
                c (binding [*lenient* true] (transl-signature uname items base))]
            (swap! units assoc uname c)
            c)))))

(def ^:private initial (atom nil))

(defn initial-env
  "Env.initial with Stdlib opened (the default -open Stdlib): Predef's environment, then Stdlib's components"
  []
  (or @initial
      (let [pre (initial-predef)
            s (find-unit "Stdlib")
            env (reduce (fn [e k] (update e k merge (get s k))) pre [:values :types :modules])
            env (reduce (fn [e k] (update e k (fn [m] (merge-with (fn [old new] (concat new old)) m (get s k)))))
                        env [:constrs :labels])]
        (reset! initial env)
        env)))

(defn reset-env! [] (reset! decls {}) (reset! units {}) (reset! initial nil))

(defn path-name
  "Printtyp's name of a type path: a predef or local type by its name, Stdlib's opened prefix left out, another
  stdlib unit by its alias (Stdlib__List.t: List.t)"
  [p]
  (case (p 0)
    :Pident (:name (p 1))
    :Pdot (let [h (p 1)]
            (if (= :Pident (h 0))
              (let [u (:name (h 1))]
                (cond (= u "Stdlib") (p 2)
                      (str/starts-with? u "Stdlib__") (str (subs u 8) "." (p 2))
                      :else (str u "." (p 2))))
              (str (path-name h) "." (p 2))))))

;; Ported from OCaml 5.5.0 (the release tarball, SHA-256 fcc6ae665d1ec51d52510eaac7834a86a9806bf5a258bb7cca78733fccf015ba):
;; the core language of typing/typecore.ml (expressions, patterns, functions with labelled and optional parameters,
;; applications as collect_apply_args and type_application order them, let with the relaxed value restriction,
;; constructors and records disambiguated by the expected type) and the structure items of typing/typemod.ml that
;; the slice needs (doc/ocaml/TYPER.md), whose notices follow (LICENSE.md, "The OCaml Core System"):
;;
;;                                 OCaml
;;
;;  Xavier Leroy and Jerome Vouillon, projet Cristal, INRIA Rocquencourt
;;
;;   Copyright 1996 Institut National de Recherche en Informatique et
;;     en Automatique.
;;
;;   All rights reserved.  This file is distributed under the terms of
;;   the GNU Lesser General Public License version 2.1, with the
;;   special exception on linking described in the file LICENSE.

(ns arbace.repr.ocaml.typer.typecore
  "The type checker of the core language (doc/ocaml/TYPER.md, T2): the native Parsetree in, a Typedtree out. An
  expression is {:desc :type :loc}, desc one of [:Texp_ident path vdesc] [:Texp_constant c] [:Texp_let rec [vb]
  body] [:Texp_function [param] body] [:Texp_apply f [[label arg-or-nil]]] [:Texp_match e [case] partial]
  [:Texp_try e [case]] [:Texp_tuple [[label e]]] [:Texp_construct cstr [e]] [:Texp_record [[lbl def]] repres
  init] [:Texp_field e lbl] [:Texp_setfield e lbl e] [:Texp_array [e]] [:Texp_ifthenelse c a b] [:Texp_sequence
  a b] [:Texp_while c b] [:Texp_for id lo hi dir body] [:Texp_assert e loc]; a constant [:int n] [:char n]
  [:string s] [:float s] [:int32 n] [:int64 n] [:nativeint n]; patterns as arbace.repr.ocaml.typer.parmatch's."
  (:require [arbace.repr.ocaml.typer.types :as ty]
            [arbace.repr.ocaml.typer.env :as env]
            [arbace.repr.ocaml.typer.parmatch :as pm]
            [arbace.repr.ocaml.typer.fmt :as fmt]
            [arbace.repr.ocaml.lex :as lex]
            [arbace.string :as str]))

(set! *warn-on-reflection* false)

(def type-error env/type-error)

(def ^:dynamic *type-package*
  "Typemod.type_package: (fn [env smod package-type] typed-module), the module coerced to the package's type"
  nil)

(def ^:dynamic *type-struct-item*
  "Typemod's typing of a structure item for an expression's local open, module or exception (Pexp_struct_item):
  (fn [env sitem] [titem env'])"
  nil)

(def ^:dynamic *type-object* "Typeclass.type_object: (fn [env sstr] [structure public-methods])" nil)
(def ^:dynamic *type-send* "Typecore.type_send: (fn [env sobj label] [obj meth type])" nil)
(def ^:dynamic *type-new* "Typecore's Pexp_new: (fn [env lid] [path class-decl type])" nil)

(defn unify! [t1 t2 what]
  (try (ty/unify t1 t2)
       (catch arbace.lang.ExceptionInfo e
         (if (:unify (ex-data e))
           (type-error (str "This " what " has type " (ty/type-scheme-text t1) " but an expression was expected of type "
                            (ty/type-scheme-text t2)))
           (throw e)))))

;; ---------------------------------------------------------------------------------------------
;; Constants

(defn- parse-int [^String s]
  (let [s (str/replace s "_" "")
        neg (str/starts-with? s "-") s (if neg (subs s 1) s)
        [radix digits] (cond (or (str/starts-with? s "0x") (str/starts-with? s "0X")) [16 (subs s 2)]
                             (or (str/starts-with? s "0o") (str/starts-with? s "0O")) [8 (subs s 2)]
                             (or (str/starts-with? s "0b") (str/starts-with? s "0B")) [2 (subs s 2)]
                             :else [10 s])
        n (.longValue (java.math.BigInteger. ^String digits (int radix)))]
    (if neg (- n) n)))

(defn constant
  "Typecore.constant: [const type-fn]"
  [c]
  (let [d (:pconst_desc c)]
    (case (d 0)
      :Pconst_integer (case (let [x (d 2)] (cond (nil? x) nil (number? x) (char x) (string? x) (first x) :else x))
                        nil [[:int (let [n (parse-int (d 1))] (bit-shift-right (bit-shift-left n 1) 1))] ty/type-int]
                        \l [[:int32 (long (unchecked-int (parse-int (d 1))))] ty/type-int32]
                        \L [[:int64 (parse-int (d 1))] ty/type-int64]
                        \n [[:nativeint (parse-int (d 1))] ty/type-nativeint]
                        [[:int (parse-int (d 1))] ty/type-int])
      :Pconst_char [[:char (int (d 1))] ty/type-char]
      :Pconst_string [[:string (d 1)] ty/type-string]
      :Pconst_float [[:float (d 1)] ty/type-float])))

;; ---------------------------------------------------------------------------------------------
;; Environment helpers

(defn add-value [env name id t] (assoc-in env [:values name] {:type t :kind [:reg] :path (ty/pident id) :id id}))

(defn- lid-name [lid] (last (env/lid-parts lid)))

(defn- expected-type-path
  "The path of the variant or record type the expected type expands to, or nil"
  [t]
  (loop [t (ty/repr t)]
    (let [d (ty/desc t)]
      (when (= :Tconstr (d 0))
        (let [decl (env/find-decl (d 1))]
          (if (and decl (:manifest decl) (not (#{:variant :record} ((:kind decl) 0))))
            (recur (ty/expand-head t))
            (d 1)))))))

(defn- choose
  "Disambiguation (Typecore's NameChoice): the description whose type is the expected one, else the latest"
  [cands expected what lid]
  (when (empty? cands) (type-error (str "Unbound " what " " (str/join "." (env/lid-parts lid)))))
  (let [p (when expected (expected-type-path expected))
        same (fn [c] (or (= (:res-path c) p)
                         (let [d (env/find-decl p)]
                           (and d (:manifest d) (= (expected-type-path (:manifest d)) (:res-path c))))))]
    (or (when p (first (filter same cands))) (first cands))))

(defn lookup-constr [env lid expected]
  (choose (env/lookup env :constrs lid) expected "constructor" lid))

(defn lookup-label
  "A label by its name, the expected record type's first (an inline record's labels are only reached so)"
  [env lid expected]
  (let [p (when expected (expected-type-path expected))
        n (lid-name lid)
        typed (when (and p (= 1 (count (env/lid-parts lid))))
                (first (filter #(= n (:name %)) (get @ty/record-labels p))))]
    (or typed (choose (env/lookup env :labels lid) expected "field" lid))))

(defn instance-constructor
  "Ctype.instance_constructor: [args res] as fresh instances (a GADT constructor's own result type)"
  [c]
  (let [res (or (:res c) (ty/newgenty [:Tconstr (:res-path c) (vec (:params c))]))
        ts (ty/instance-list (cons res (:args c)))]
    [(vec (rest ts)) (first ts)]))

;; ---------------------------------------------------------------------------------------------
;; Locally abstract types and GADT equations (Typecore.type_newtype, Ctype's pattern mode)

(defn new-local-type
  "Ctype.new_local_type: an abstract type of a fresh identifier, which a GADT pattern may equate"
  [n]
  (let [id (ty/ident-create n) p [:Pident id]]
    (env/add-decl! p {:path p :params [] :kind [:abstract] :manifest nil :arity 0 :local-abstract true
                      :variance [] :immediate false})
    p))

(def ^:dynamic *let-equations* "The GADT equations a let's patterns add, for its body (an atom), or nil" nil)

(def ^:dynamic *equations* "The GADT equations of the case being typed: an atom of [path previous-declaration]" nil)

(defn- add-equation [t1 t2]
  (let [local (fn [t] (let [d (ty/desc t)]
                        (when (and (= :Tconstr (d 0)) (empty? (d 2)))
                          (let [decl (env/find-decl (d 1))]
                            (when (and (:local-abstract decl) (nil? (:manifest decl))) [(d 1) decl])))))]
    (when *equations*
      (when-let [[p decl t] (or (when-let [[p d] (local t1)] [p d t2]) (when-let [[p d] (local t2)] [p d t1]))]
        (swap! *equations* conj [p decl])
        (env/add-decl! p (assoc decl :manifest t))
        true))))

(defn- undo-equations! [eqs] (doseq [[p decl] (reverse eqs)] (env/add-decl! p decl)))
(defn instance-constructor-pattern
  "Ctype.instance_constructor with existentials made abstract: a GADT or existential constructor in a pattern, the
  variables of its arguments that its result does not bind fresh locally abstract types"
  [c]
  (let [[args res] (instance-constructor c)]
    (if-not (:res c)
      [args res]
      (let [in-res (atom #{})
            _ (letfn [(go [t] (let [t (ty/repr t)] (if (ty/tvar? t) (swap! in-res conj t) (run! go (ty/children (ty/desc t))))))]
                (go res))
            seen (atom #{})]
        (letfn [(ex [t] (let [t (ty/repr t)]
                          (when-not (@seen t)
                            (swap! seen conj t)
                            (if (ty/tvar? t)
                              (when-not (@in-res t)
                                (ty/link! t (ty/tconstr (new-local-type (str "$" (:name c) "_'" (or ((ty/desc t) 1) "a"))) [])))
                              (run! ex (ty/children (ty/desc t)))))))]
          (run! ex args))
        [args res]))))

(defn instance-label
  "[res arg all-args] of a label: the record type, the field's type and every field's, sharing one instance"
  [l]
  (let [res (ty/newgenty [:Tconstr (:res-path l) (vec (:params l))])
        all (ty/label-all l)
        ts (ty/instance-list (concat [res] (map :arg all)))]
    [(first ts) (nth ts (inc (:pos l))) (vec (rest ts))]))

(defn mkexp [d t loc] {:desc d :type t :loc loc})

(defn annot-type
  "An annotation's type: an instance of its scheme, or in a class the class's own variables (TyVarEnv)"
  [env sty]
  (if env/*shared-tyvars*
    (env/transl-type env env/*shared-tyvars* sty)
    (ty/instance (env/make-generic! (env/transl-type env (atom {}) sty)))))

;; ---------------------------------------------------------------------------------------------
;; Patterns (Typecore.type_pat)

(defn- loc-of [x k] (get x k))

(declare type-pat)

(defn- char-or [c1 c2 loc]
  (let [mk (fn [c] {:ppat_desc [:Ppat_constant {:pconst_desc [:Pconst_char c]}] :ppat_loc loc})]
    (letfn [(lp [a b] (if (= a b) (mk a) {:ppat_desc [:Ppat_or (mk a) (lp (inc a) b)] :ppat_loc loc}))]
      (let [c1 (int c1) c2 (int c2)] (if (<= c1 c2) (lp c1 c2) (lp c2 c1))))))

(defn build-as-type
  "Typecore.build_as_type: the most general type of what a pattern matches, an alias's variable's type"
  [p]
  (let [d (:desc p)]
    (case (d 0)
      :Tpat_alias (build-as-type (d 1))
      :Tpat_tuple (ty/newty [:Ttuple (mapv (fn [[l q]] [l (build-as-type q)]) (d 1))])
      :Tpat_construct (let [c (d 1)
                            tyl (mapv build-as-type (d 2))
                            [targs tres] (instance-constructor c)]
                        (dorun (map (fn [a t] (ty/unify a t)) targs tyl))
                        tres)
      :Tpat_or (if-let [row (get d 3)]
                 ;; a #t pattern's row, open (its name lost as OCaml loses it: the scope check of update_level)
                 (let [r (ty/row-repr row)]
                   (ty/newty [:Tvariant (ty/create-row (:fields r) (ty/newvar) false (:fixed r) nil)]))
                 (let [t1 (build-as-type (d 1)) t2 (build-as-type (d 2))] (ty/unify t2 t1) t1))
      :Tpat_variant (ty/newty [:Tvariant (ty/create-row [[(d 1) (ty/rf-present (some-> (d 2) build-as-type))]] (ty/newvar) false nil nil)])
      :Tpat_record (let [ppl (into {} (map (fn [[l q]] [(:pos l) q]) (d 1)))
                         t (ty/newvar)]
                     (doseq [lbl (ty/label-all (first (first (d 1))))]
                       (let [[res arg _] (instance-label lbl)]
                         (ty/unify t res)
                         (if (and (not (:mut lbl)) (contains? ppl (:pos lbl)))
                           (ty/unify (build-as-type (ppl (:pos lbl))) arg)
                           (let [[res' arg' _] (instance-label lbl)]
                             (ty/unify arg arg')
                             (ty/unify (:type p) res')))))
                     t)
      (:type p))))

(defn build-or-pat
  "Typecore.build_or_pat: #t as the or-pattern of its static row's tags, [path pattern]"
  [env lid]
  (let [path (env/lookup env :types lid)
        _ (when-not path (type-error (str "Unbound type constructor " (str/join "." (env/lid-parts lid)))))
        decl (env/find-decl path)
        tyl (mapv (fn [_] (ty/newvar)) (:params decl))
        e (ty/desc (ty/expand-head (ty/tconstr path tyl)))
        _ (when-not (and (= :Tvariant (e 0)) (ty/static-row (e 1)))
            (type-error (str "The type " (str/join "." (env/lid-parts lid)) " is not a variant type")))
        [pats fields] (reduce (fn [[pats fields] [l f]]
                                (let [v (ty/field-view f)]
                                  (if (= :Rpresent (v 0))
                                    (if-let [t (v 1)]
                                      [(cons [l {:desc [:Tpat_any] :type t}] pats) (cons [l (ty/rf-either [t] false true)] fields)]
                                      [(cons [l nil] pats) (cons [l (ty/rf-either [] true true)] fields)])
                                    [pats fields])))
                              [() ()] (ty/row-fields (e 1)))
        fields (vec (reverse fields))
        t (ty/newty [:Tvariant (ty/create-row fields (ty/newvar) false nil [path tyl])])
        pats (map (fn [[l p]] {:desc [:Tpat_variant l p (atom nil)] :type t}) pats)]
    (when (empty? pats) (type-error (str "The type " (str/join "." (env/lid-parts lid)) " is not a variant type")))
    [path (reduce (fn [p p0] {:desc [:Tpat_or p0 p (e 1)] :type t}) (first pats) (rest pats))]))

(defn type-pat
  "The pattern sp at the expected type; its variables conj'ed onto the atom vars as [name id type]"
  [env sp expected vars]
  (let [d (:ppat_desc sp) loc (:ppat_loc sp)
        mk (fn [desc t] {:desc desc :type t :loc loc})]
    (case (d 0)
      :Ppat_any (mk [:Tpat_any] expected)
      :Ppat_unpack (let [n (or (:txt (d 1)) "_") id (ty/ident-create n)
                         _ (when-let [pt (get d 2)]
                             (unify! (annot-type env {:ptyp_desc [:Ptyp_package pt]})
                                     expected "pattern"))]
                     (when-not (= :Tpackage ((ty/desc (ty/expand-head expected)) 0))
                       (type-error "The type of this packed module cannot be inferred"))
                     (when (:txt (d 1)) (swap! vars conj [n id expected :module]))
                     (mk [:Tpat_var id n] expected))
      :Ppat_var (let [n (:txt (d 1)) id (ty/ident-create n)]
                  (swap! vars conj [n id expected])
                  (mk [:Tpat_var id n] expected))
      :Ppat_alias (let [p (type-pat env (d 1) expected vars) n (:txt (d 2)) id (ty/ident-create n)
                        tv (build-as-type p)]
                    (swap! vars conj [n id tv])
                    (mk [:Tpat_alias p id n tv] expected))
      :Ppat_constant (let [[c tf] (constant (d 1))] (unify! (tf) expected "pattern") (mk [:Tpat_constant c] expected))
      :Ppat_interval (type-pat env (char-or ((:pconst_desc (d 1)) 1) ((:pconst_desc (d 2)) 1) loc) expected vars)
      :Ppat_tuple (let [ps (d 1)
                        ts (mapv (fn [_] (ty/newvar)) ps)]
                    (unify! (ty/newty [:Ttuple (mapv (fn [[l _] t] [l t]) ps ts)]) expected "pattern")
                    (mk [:Tpat_tuple (mapv (fn [[l p] t] [l (type-pat env p t vars)]) ps ts)] expected))
      :Ppat_construct
      (let [c (lookup-constr env (:txt (d 1)) expected)
            [targs tres] (instance-constructor-pattern c)
            _ (binding [ty/*gadt-equation* add-equation] (unify! tres expected "pattern"))
            sarg (when-let [a (d 2)] (second a))
            sargs (cond
                    (nil? sarg) []
                    (and (> (:arity c) 1) (= :Ppat_tuple ((:ppat_desc sarg) 0))) (mapv second ((:ppat_desc sarg) 1))
                    (and (> (:arity c) 1) (= :Ppat_any ((:ppat_desc sarg) 0))) (vec (repeat (:arity c) sarg))
                    (and (zero? (:arity c)) (= :Ppat_any ((:ppat_desc sarg) 0))) []
                    :else [sarg])]
        (when-not (= (count sargs) (:arity c))
          (type-error (str "The constructor " (:name c) " expects " (:arity c) " argument(s)")))
        (mk [:Tpat_construct c (mapv (fn [p t] (type-pat env p t vars)) sargs targs)] expected))
      :Ppat_record
      (let [fields (d 1)
            l0 (lookup-label env (:txt (first (first fields))) expected)
            [res _ args] (instance-label l0)
            _ (unify! res expected "pattern")
            typed (mapv (fn [[lid p]]
                          (let [l (or (first (filter #(= (:name %) (lid-name (:txt lid))) (ty/label-all l0)))
                                      (type-error (str "Unbound record field " (lid-name (:txt lid)))))]
                            [l (type-pat env p (nth args (:pos l)) vars)]))
                        fields)]
        (mk [:Tpat_record (vec (sort-by (comp :pos first) typed)) (d 2)] expected))
      :Ppat_array (let [t (ty/newvar)]
                    (unify! (ty/type-array t) expected "pattern")
                    (mk [:Tpat_array (mapv #(type-pat env % t vars) (d 1))] expected))
      :Ppat_or (let [p1 (type-pat env (d 1) expected vars)
                     v2 (atom [])
                     p2 (type-pat env (d 2) expected v2)
                     m (into {} (map (fn [[n id t]] [n [id t]]) @vars))
                     ren (into {} (map (fn [[n id t]] (let [[id1 t1] (get m n)] (when t1 (unify! t t1 "pattern")) [id id1])) @v2))]
                 (mk [:Tpat_or p1 (pm/alpha-pat ren p2)] expected))
      :Ppat_constraint (if (and (= :Ptyp_poly ((:ptyp_desc (d 2)) 0)) (= :Ppat_var ((:ppat_desc (d 1)) 0)))
                         ;; an explicitly polymorphic variable: its type the scheme, each use an instance (polymorphic
                         ;; recursion); its definition typed against an instance
                         (let [scheme (env/make-generic! (env/transl-type env (atom {}) (d 2)))
                               n (:txt ((:ppat_desc (d 1)) 1)) id (ty/ident-create n)]
                           (unify! (ty/instance scheme) expected "pattern")
                           (swap! vars conj [n id scheme])
                           (mk [:Tpat_var id n] expected))
                         (let [t (annot-type env (d 2))]
                           (unify! t expected "pattern")
                           (type-pat env (d 1) expected vars)))
      :Ppat_variant (let [tag (d 1) sarg (d 2)
                          ;; Typecore.solve_Ppat_variant: an undecided tag, matched
                          arg-type (when sarg (ty/newvar))
                          row (ty/create-row [[tag (ty/rf-either (if arg-type [arg-type] []) (nil? sarg) true)]] (ty/newvar) false nil nil)]
                      (unify! (ty/newty [:Tvariant row]) expected "pattern")
                      ;; the pattern's row: the one unified with the expected type (finalize_variant's afterwards)
                      (mk [:Tpat_variant tag (when sarg (type-pat env sarg arg-type vars)) (atom row)] expected))
      :Ppat_type (let [[_ p] (build-or-pat env (:txt (d 1)))]
                   (unify! (:type p) expected "pattern")
                   p)
      :Ppat_exception (mk [:Tpat_exception (type-pat env (d 1) (ty/type-exn) vars)] expected)
      :Ppat_lazy (let [t (ty/newvar)]
                   (unify! (ty/tconstr ty/path-lazy-t [t]) expected "pattern")
                   (mk [:Tpat_lazy (type-pat env (d 1) t vars)] expected))
      (type-error (str "pattern " (d 0) " outside the slice")))))

(defn add-pattern-vars
  "The environment with a pattern's variables, a (module M) pattern's a module of its package's type, its address the
  variable"
  [env vars]
  (reduce (fn [e [n id t m]]
            (if m
              (assoc-in e [:modules n] (env/add-module! id {:path [:Pident id] :mty (env/modtype-of-package (ty/expand-head t))
                                                            :addr [:var id]}))
              (add-value e n id t)))
          env vars))

(defn name-pattern
  "Typecore.name_pattern: the first pattern that is a variable or an alias names the parameter"
  [default pats]
  (or (some (fn [p] (let [d (:desc p)] (case (d 0) :Tpat_var (d 1) :Tpat_alias (d 2) nil))) pats)
      (ty/ident-create default)))

(defn split-exn [p]
  ;; the value part of a computation pattern (nil when it is only an exception pattern)
  (let [d (:desc p)]
    (case (d 0)
      :Tpat_exception nil
      :Tpat_or (let [a (split-exn (d 1)) b (split-exn (d 2))]
                 (cond (and a b) (assoc p :desc [:Tpat_or a b]) a a :else b))
      p)))

(defn- subpatterns [p]
  (let [d (:desc p)]
    (case (d 0)
      (:Tpat_alias :Tpat_lazy :Tpat_exception) [(d 1)]
      (:Tpat_tuple :Tpat_record) (mapv second (d 1))
      :Tpat_construct (d 2)
      :Tpat_variant (if (d 2) [(d 2)] [])
      :Tpat_array (d 1)
      :Tpat_or [(d 1) (d 2)]
      [])))

(defn- has-variants? [p] (or (= :Tpat_variant ((:desc p) 0)) (boolean (some has-variants? (subpatterns p)))))

(defn- finalize-variant!
  "Typecore.finalize_variant: an undecided tag of an open row made present, a matched one unmatched; the pattern's row
  recorded for Matching"
  [p]
  (let [[_ tag opat r] (:desc p)
        e (ty/desc (ty/expand-head (:type p)))]
    (when (= :Tvariant (e 0))
      (let [row (e 1) f (ty/get-row-field tag row) v (ty/field-view f)]
        (reset! r row)
        (when (= :Reither (v 0))
          (let [[_ c tl m] v]
            (cond
              (and c (empty? tl) (not (ty/row-closed row))) (ty/link-row-field-ext! f (ty/rf-present nil))
              (and (not c) (seq tl) (not (ty/row-closed row)))
              (do (ty/link-row-field-ext! f (ty/rf-present (first tl)))
                  (run! #(unify! (:type opat) % "pattern") tl))
              (and m (not (ty/fixed-explanation row))) (ty/link-row-field-ext! f (ty/rf-either [] c false))
              :else nil)))))))

(defn- finalize-variants! [p]
  (when (= :Tpat_variant ((:desc p) 0)) (finalize-variant! p))
  (run! finalize-variants! (subpatterns p)))

(declare split-exn)

(defn pressure-variants!
  "Typecore's polymorphic variant processing of a match's patterns: Parmatch.pressure_variants (the computation
  patterns' value and exception parts apart), then finalize_variants"
  [pats]
  (when (some has-variants? pats)
    (let [vals (keep split-exn pats)
          exns (keep (fn [p] (letfn [(ex [p] (let [d (:desc p)]
                                               (case (d 0)
                                                 :Tpat_exception (d 1)
                                                 :Tpat_or (let [a (ex (d 1)) b (ex (d 2))] (cond (and a b) (assoc p :desc [:Tpat_or a b]) a a :else b))
                                                 nil)))]
                               (ex p)))
                     pats)]
      (pm/pressure-variants vals)
      (when (seq exns) (pm/pressure-variants exns)))
    (run! finalize-variants! pats)))

(defn partiality
  "Parmatch.check_partial: :total when the unguarded value patterns are exhaustive"
  [cases]
  (let [rows (keep (fn [c] (when-not (:guard c) (when-let [p (split-exn (:lhs c))] [p]))) cases)]
    (if (pm/satisfiable rows [pm/omega]) :partial :total)))

;; ---------------------------------------------------------------------------------------------
;; Expressions

(declare type-expect type-function type-let type-cases)

(defn type-exp [env sexp] (type-expect env sexp (ty/newvar)))

(defn- list-labels
  "Ctype.list_labels: the labels of the arrows of t, and whether it ends in a variable"
  [t]
  (loop [t (ty/expand-head t) ls []]
    (let [d (ty/desc t)]
      (case (d 0)
        :Tarrow (recur (ty/expand-head (d 3)) (conj ls (d 1)))
        :Tvar [ls true]
        [ls false]))))

(defn- extract-label [name sargs]
  (loop [hd [] ls sargs]
    (when (seq ls)
      (let [[l' _ :as p] (first ls)]
        (if (= (ty/label-name l') name)
          [l' (second p) (seq hd) (vec (concat hd (rest ls)))]
          (recur (conj hd p) (rest ls)))))))

(defn option-some [e t]
  (let [c (first (filter #(= (:res-path %) ty/path-option) (get-in (env/initial-env) [:constrs "Some"])))]
    (mkexp [:Texp_construct c [e]] (ty/type-option t) (:loc e))))

(defn option-none [t loc]
  (let [c (first (filter #(= (:res-path %) ty/path-option) (get-in (env/initial-env) [:constrs "None"])))]
    (mkexp [:Texp_construct c []] (ty/type-option t) loc)))

(defn- extract-option-type [t]
  (let [t (ty/expand-head t) d (ty/desc t)]
    (if (and (= :Tconstr (d 0)) (= (d 1) ty/path-option)) (first (d 2)) (type-error "not an option type"))))

(defn- inferred?
  "Typecore.is_inferred"
  [sexp]
  (let [d (:pexp_desc sexp)]
    (case (d 0)
      (:Pexp_ident :Pexp_apply :Pexp_field :Pexp_constraint :Pexp_coerce :Pexp_send :Pexp_new) true
      :Pexp_pack (some? (d 2))
      :Pexp_sequence (inferred? (d 2))
      :Pexp_ifthenelse (and (d 3) (inferred? (d 2)) (inferred? (d 3)))
      :Pexp_struct_item (and (= :Pstr_open ((:pstr_desc (d 1)) 0)) (inferred? (d 2)))
      false)))

(defn type-argument
  "Typecore.type_argument: an argument expected as a function without labels, its optional parameters eliminated
  (applied to None, eta-expanded after a let)"
  [env sarg texpected]
  (let [no-labels (fn [t] (let [[ls tvar] (list-labels t)] (and (not tvar) (every? #(= :Nolabel (% 0)) ls))))
        te (ty/expand-head texpected) td (ty/desc te)]
    (if-not (and (inferred? sarg) (= :Tarrow (td 0)) (= :Nolabel ((td 1) 0)))
      (type-expect env sarg texpected)
      (let [safe-expect (no-labels (td 3))
            texp (type-exp env sarg)
            [args tyfun simple-res]
            (loop [args [] tf (:type texp)]
              (let [e (ty/expand-head tf) d (ty/desc e)]
                (cond
                  (and (= :Tarrow (d 0)) (ty/is-optional (d 1)))
                  (recur (conj args [(d 1) (option-none (ty/instance (extract-option-type (d 2))) nil)]) (d 3))
                  (and (= :Tarrow (d 0)) (or (= :Nolabel ((d 1) 0)) ty/*classic*)) [args tf (no-labels (d 3))]
                  (= :Tvar (d 0)) [args tf false]
                  :else [[] (:type texp) false])))
            texp (assoc texp :type (ty/instance (:type texp)))]
        (if-not (or simple-res safe-expect)
          (do (unify! (:type texp) texpected "expression") texp)
          (let [ty-fun (ty/instance tyfun)
                [ty-arg ty-res] (let [d (ty/desc (ty/expand-head texpected))] [(d 2) (d 3)])]
            (unify! ty-fun texpected "expression")
            (if (empty? args)
              texp
              (let [var-pair (fn [n t] (let [id (ty/ident-create n)
                                             vd {:type t :kind [:reg] :path (ty/pident id) :id id}]
                                         [{:desc [:Tpat_var id n] :type t}
                                          (mkexp [:Texp_ident (ty/pident id) vd] t nil)]))
                    [eta-pat eta-var] (var-pair "eta" ty-arg)
                    [let-pat let-var] (var-pair "arg" (:type texp))
                    e (mkexp [:Texp_apply let-var (conj args [[:Nolabel] eta-var])] ty-res nil)
                    cases [{:lhs eta-pat :guard nil :rhs e}]
                    func (mkexp [:Texp_function [] [:cases cases :Total (name-pattern "param" [eta-pat]) nil]] ty-fun nil)]
                (mkexp [:Texp_let :Nonrecursive [{:pat let-pat :expr texp :attrs nil}] func] ty-fun (:loc texp))))))))))

(defn type-application
  "Typecore.type_application: the arguments in the order of the function's type, an omitted one nil (Omitted ()),
  an eliminated optional one None; returns [args result-type]"
  [env funct sargs]
  (let [fty (:type funct)
        prim (fn [n] (let [d (:desc funct)] (and (= :Texp_ident (d 0)) (= [:prim n] [(first (:kind (d 2))) (:name (second (:kind (d 2))))]))))]
    (if (and (= 1 (count sargs)) (= :Nolabel ((ffirst sargs) 0)) (prim "%ignore"))
      (let [targ (ty/newvar) tret (ty/newvar)]
        (unify! fty (ty/newty [:Tarrow [:Nolabel] targ tret]) "function")
        [[[[:Nolabel] (type-expect env (second (first sargs)) targ)]] tret])
      (let [[ls tvar] (list-labels fty)
            nonopt (remove ty/is-optional ls)
            ignore-labels (and (not tvar) (= (count nonopt) (count sargs)) (every? #(= :Nolabel ((first %) 0)) sargs)
                               (some #(not= :Nolabel (% 0)) nonopt))
            collected
            (loop [tyf fty sargs sargs rev []]
              (if (empty? sargs)
                [tyf (vec (reverse rev))]
                (let [tyf' (ty/expand-head tyf) d (ty/desc tyf')]
                  (if-not (= :Tarrow (d 0))
                    ;; collect_unknown_apply_args
                    (let [[l sarg] (first sargs)]
                      (if (= :Tvar (d 0))
                        (let [targ (ty/newvar) tres (ty/newvar)]
                          (unify! tyf' (ty/newty [:Tarrow l targ tres]) "function")
                          (recur tres (rest sargs) (cons [l [:unknown sarg targ]] rev)))
                        (type-error "This function is applied to too many arguments")))
                    (let [l (d 1) name (ty/label-name l) optional (ty/is-optional l)
                          found (if ignore-labels
                                  (let [[l' sarg] (first sargs)]
                                    (if (or (= name (ty/label-name l')) (and (not optional) (= :Nolabel (l' 0))))
                                      [l' sarg nil (vec (rest sargs))]
                                      (if (and optional (some #(= :Nolabel ((first %) 0)) sargs)) nil
                                          (type-error "labels"))))
                                  (extract-label name sargs))
                          arg (if found
                                (let [[l' sarg _ _] found]
                                  [:known sarg (d 2) (and optional (not (ty/is-optional l')))])
                                (if (and optional (some #(= :Nolabel ((first %) 0)) sargs))
                                  [:eliminated (d 2)]
                                  [:omitted (d 2)]))]
                      (recur (d 3) (if found (nth found 3) sargs) (cons [l arg] rev)))))))
            [tret args] collected
            targs (mapv (fn [[l a]]
                          (case (a 0)
                            :unknown [l (type-expect env (a 1) (a 2))]
                            :known (let [[_ sarg targ wrapped] a]
                                     [l (if wrapped
                                          (let [t (extract-option-type targ)]
                                            (option-some (type-expect env sarg t) t))
                                          (type-argument env sarg targ))])
                            :eliminated [l (option-none (ty/instance (extract-option-type (a 1))) nil)]
                            :omitted [l [:omitted (a 1)]]))
                        args)
            tret (reduce (fn [r [l a]] (if (and (vector? a) (= :omitted (a 0))) (ty/newty [:Tarrow l (a 1) r]) r))
                         tret (reverse targs))]
        [(mapv (fn [[l a]] [l (if (and (vector? a) (= :omitted (a 0))) nil a)]) targs) tret]))))

(defn type-statement [env sexp] (type-exp env sexp))

(defn- record-repres [l] (:repres l))

(declare type-newtype)

(def ^:private path-format6 [:Pdot [:Pident (ty/ident-global "CamlinternalFormatBasics")] "format6"])

(defn- format-type?
  "The expected type a format6 (CamlinternalFormatBasics'), its abbreviations expanded"
  [t]
  (let [d (ty/desc (ty/expand-head t))] (and (= :Tconstr (d 0)) (= (d 1) path-format6))))

(defn type-expect
  "Typecore.type_expect for the slice"
  [env sexp expected]
  (let [d (:pexp_desc sexp) loc (:pexp_loc sexp)
        ret (fn [desc t] (unify! t expected "expression") (mkexp desc t loc))]
    (case (d 0)
      :Pexp_ident (let [lid (:txt (d 1))
                        v (env/lookup env :values lid)]
                    (when-not v (type-error (str "Unbound value " (str/join "." (env/lid-parts lid)))))
                    (case (first (:kind v))
                      ;; an instance variable, self (Typecore's Val_ivar and Val_self): through the method's self-N
                      :ivar (let [self (get-in env [:values (str "self-" (nth (:kind v) 2))])]
                              (ret [:Texp_instvar (:path self) (:id v)] (ty/instance (:type v))))
                      :self (let [self (get-in env [:values (str "self-" (nth (:kind v) 4))])]
                              (ret [:Texp_ident (:path self) (assoc v :path (:path self) :id (:id self))] (ty/instance (:type v))))
                      (ret [:Texp_ident (or (:path v) [:prim]) v] (ty/instance (:type v)))))
      :Pexp_send (let [[obj meth t] (*type-send* env (d 1) (:txt (d 2)))]
                   (ret [:Texp_send obj meth] (let [t' (ty/repr t)]
                                                (if (= :Tpoly ((ty/desc t') 0)) (ty/instance-poly t') (ty/instance t')))))
      :Pexp_object (let [[cs meths] (*type-object* env (d 1))]
                     (ret [:Texp_object cs meths env] (:self @(:sign cs))))
      :Pexp_new (let [[path decl t] (*type-new* env (:txt (d 1)))]
                  (ret [:Texp_new path decl] t))
      :Pexp_setinstvar (let [label (:txt (d 1))
                             v (get-in env [:values label])
                             _ (when-not (= :ivar (first (:kind v))) (type-error (str "Unbound instance variable " label)))
                             _ (when-not (= :Mutable (nth (:kind v) 1)) (type-error (str "The instance variable " label " is not mutable")))
                             e (type-expect env (d 2) (ty/instance (:type v)))
                             self (get-in env [:values (str "self-" (nth (:kind v) 2))])]
                         (ret [:Texp_setinstvar (:path self) (:id v) e] (ty/type-unit)))
      :Pexp_override (let [sp (get-in env [:values "selfpat-*"]) sv (get-in env [:values "self-*"])
                           _ (when-not (and sp sv (= :self (first (:kind sp)))) (type-error "This object duplication occurs outside a method definition"))
                           [_ sign _ vars _] (:kind sp)
                           modifs (mapv (fn [[{lab :txt} se]]
                                          (let [id (or (get vars lab) (type-error (str "Unbound instance variable " lab)))
                                                t (nth (get-in @sign [:vars lab]) 2)]
                                            [id lab (type-expect env se (ty/instance t))]))
                                        (d 1))]
                       (ret [:Texp_override (:path sv) modifs] (:type sp)))
      :Pexp_poly (do (when-let [sty (d 2)]
                       (unify! (env/transl-poly-type env (or env/*shared-tyvars* (atom {})) sty) expected "method"))
                     ;; a polymorphic method's body typed against an instance of its polytype
                     (let [e (ty/expand-head expected)
                           t (if (= :Tpoly ((ty/desc e) 0)) (ty/instance-poly e) expected)]
                       (assoc (type-expect env (d 1) t) :poly true)))
      :Pexp_constant (if (and (= :Pconst_string ((:pconst_desc (d 1)) 0)) (format-type? expected))
                       ;; Typecore's "terrible hack for format strings": the literal typed as its format's constructors
                       (type-expect env (assoc (fmt/type-format ((:pconst_desc (d 1)) 1)) :pexp_loc loc) expected)
                       (let [[c tf] (constant (d 1))] (ret [:Texp_constant c] (tf))))
      :Pexp_let (let [eqs (atom [])
                      [vbs env'] (binding [*let-equations* eqs] (type-let env (d 1) (d 2)))
                      body (try (type-expect env' (d 3) expected) (finally (undo-equations! @eqs)))]
                  (mkexp [:Texp_let (d 1) vbs body] (:type body) loc))
      :Pexp_function (let [sbody (if-let [c (d 2)]
                                   (if (and (= :Pfunction_body ((d 3) 0)) (= :Pconstraint (c 0)))
                                     [:Pfunction_body {:pexp_desc [:Pexp_constraint ((d 3) 1) (c 1)] :pexp_loc (:pexp_loc ((d 3) 1))}]
                                     (if (and (= :Pfunction_cases ((d 3) 0)) (= :Pconstraint (c 0)))
                                       ;; fun p : t -> function ...: the cases' function type constrained
                                       (conj (d 3) [::constraint (c 1)])
                                       (type-error "this function's body constraint is outside the slice")))
                                   (d 3))
                           [params body t] (type-function env (d 1) sbody expected)]
                       (assoc (mkexp [:Texp_function params body] t loc) :env env))
      :Pexp_apply (let [f (type-exp env (d 1))
                        sargs (vec (d 2))
                        pname (let [fd (:desc f)] (when (and (= :Texp_ident (fd 0)) (= :prim (first (:kind (fd 2)))))
                                                    (:name (second (:kind (fd 2))))))
                        nolabels (and (= 2 (count sargs)) (every? #(= :Nolabel ((first %) 0)) sargs))
                        ;; Typecore's application operators: x |> f and f @@ x typed as f x
                        [f sargs] (cond
                                    (and nolabels (= pname "%revapply") (inferred? (second (second sargs))))
                                    [(type-exp env (second (second sargs))) [(first sargs)]]
                                    (and nolabels (= pname "%apply") (inferred? (second (first sargs))))
                                    [(type-exp env (second (first sargs))) [(second sargs)]]
                                    :else [f sargs])
                        [args t] (type-application env f sargs)]
                    (ret [:Texp_apply f args] t))
      :Pexp_match (let [arg (type-exp env (d 1))
                        cases (type-cases env (:type arg) expected (d 2) true)]
                    (mkexp [:Texp_match arg cases (partiality cases)] expected loc))
      :Pexp_try (let [body (type-expect env (d 1) expected)
                      cases (type-cases env (ty/type-exn) expected (d 2) false)]
                  (mkexp [:Texp_try body cases] expected loc))
      :Pexp_tuple (let [ts (mapv (fn [_] (ty/newvar)) (d 1))]
                    (unify! (ty/newty [:Ttuple (mapv (fn [[l _] t] [l t]) (d 1) ts)]) expected "expression")
                    (mkexp [:Texp_tuple (mapv (fn [[l e] t] [l (type-expect env e t)]) (d 1) ts)] expected loc))
      :Pexp_construct
      (let [c (lookup-constr env (:txt (d 1)) expected)
            [targs tres] (instance-constructor c)
            _ (unify! tres expected "expression")
            sarg (d 2)
            sargs (cond (nil? sarg) []
                        (and (> (:arity c) 1) (= :Pexp_tuple ((:pexp_desc sarg) 0))) (mapv second ((:pexp_desc sarg) 1))
                        :else [sarg])]
        (when-not (= (count sargs) (:arity c))
          (type-error (str "The constructor " (:name c) " expects " (:arity c) " argument(s)")))
        (mkexp [:Texp_construct c (mapv #(type-expect env %1 %2) sargs targs)] tres loc))
      :Pexp_variant
      (let [l (d 1) sarg (d 2)
            e (ty/desc (ty/expand-head expected))
            known (when (and sarg (= :Tvariant (e 0)))
                    (let [v (ty/field-view (ty/get-row-field l (e 1)))] (when (and (= :Rpresent (v 0)) (v 1)) (v 1))))]
        (if known
          ;; the expected type's argument propagated (Typecore's first case)
          (mkexp [:Texp_variant l (type-argument env sarg known)] expected loc)
          (let [arg (when sarg (type-exp env sarg))
                t (ty/newty [:Tvariant (ty/create-row [[l (ty/rf-present (:type arg))]] (ty/newvar) false nil nil)])]
            (ret [:Texp_variant l arg] t))))
      :Pexp_record
      (let [fields (d 1) init-s (d 2)
            init (when init-s (type-exp env init-s))
            l0 (lookup-label env (:txt (first (first fields))) (or (and init (:type init)) expected))
            [res _ args] (instance-label l0)
            _ (unify! res expected "expression")
            _ (when init (unify! (:type init) res "expression"))
            given (into {} (map (fn [[lid e]]
                                  (let [n (lid-name (:txt lid))
                                        l (or (first (filter #(= (:name %) n) (ty/label-all l0)))
                                              (type-error (str "Unbound record field " n)))]
                                    [(:pos l) [l lid e]]))
                                fields))
            ;; the fields typed in the source order
            typed (into {} (map (fn [[lid e]]
                                  (let [[l _ _] (get given (:pos (first (filter #(= (:name %) (lid-name (:txt lid))) (ty/label-all l0)))))]
                                    [(:pos l) (type-expect env e (nth args (:pos l)))]))
                                fields))
            defs (mapv (fn [l]
                         (if-let [e (get typed (:pos l))]
                           [l [:overridden e]]
                           (do (when-not init (type-error (str "Some record fields are undefined: " (:name l))))
                               [l [:kept (nth args (:pos l)) (:mut l)]])))
                       (ty/label-all l0))]
        (mkexp [:Texp_record defs (:repres l0) init] res loc))
      :Pexp_field (let [e (type-exp env (d 1))
                        l (lookup-label env (:txt (d 2)) (:type e))
                        [res arg _] (instance-label l)]
                    (unify! (:type e) res "expression")
                    (ret [:Texp_field e l] arg))
      :Pexp_setfield (let [e (type-exp env (d 1))
                           l (lookup-label env (:txt (d 2)) (:type e))
                           [res arg _] (instance-label l)
                           _ (unify! (:type e) res "expression")
                           v (type-expect env (d 3) arg)]
                       (when-not (:mut l) (type-error (str "The record field " (:name l) " is not mutable")))
                       (ret [:Texp_setfield e l v] (ty/type-unit)))
      :Pexp_array (let [ed (ty/desc (ty/expand-head expected))
                        ;; Typecore.disambiguate_array_literal: a floatarray, an immutable array, or an array
                        [t mut] (cond
                                  (and (= :Tconstr (ed 0)) (= (ed 1) ty/path-floatarray)) [(ty/type-float) true]
                                  (and (= :Tconstr (ed 0)) (= (ed 1) ty/path-iarray))
                                  (let [t (ty/newvar)] (unify! (ty/tconstr ty/path-iarray [t]) expected "expression") [t false])
                                  :else (let [t (ty/newvar)] (unify! (ty/type-array t) expected "expression") [t true]))]
                    (mkexp [:Texp_array (mapv #(type-expect env % t) (d 1)) mut] expected loc))
      :Pexp_ifthenelse (let [c (type-expect env (d 1) (ty/type-bool))]
                         (if (d 3)
                           (let [a (type-expect env (d 2) expected) b (type-expect env (d 3) expected)]
                             (mkexp [:Texp_ifthenelse c a b] expected loc))
                           (let [a (type-expect env (d 2) (ty/type-unit))]
                             (ret [:Texp_ifthenelse c a nil] (ty/type-unit)))))
      :Pexp_sequence (let [a (type-statement env (d 1)) b (type-expect env (d 2) expected)]
                       (mkexp [:Texp_sequence a b] (:type b) loc))
      :Pexp_while (let [c (type-expect env (d 1) (ty/type-bool)) b (type-statement env (d 2))]
                    (assoc (ret [:Texp_while c b] (ty/type-unit)) :env env))
      :Pexp_for (let [p (:ppat_desc (d 1))
                      lo (type-expect env (d 2) (ty/type-int))
                      hi (type-expect env (d 3) (ty/type-int))
                      [id env'] (case (p 0)
                                  :Ppat_var (let [id (ty/ident-create (:txt (p 1)))]
                                              [id (add-value env (:txt (p 1)) id (ty/type-int))])
                                  :Ppat_any [(ty/ident-create "_for") env]
                                  (type-error "for loop index"))
                      body (type-statement env' (d 5))]
                  (assoc (ret [:Texp_for id lo hi (d 4) body] (ty/type-unit)) :env env))
      :Pexp_constraint (let [t (annot-type env (d 2))
                             e (type-expect env (d 1) t)]
                         (unify! t expected "expression")
                         e)
      :Pexp_assert (let [e (type-expect env (d 1) (ty/type-bool))
                         false? (let [ed (:desc e)] (and (= :Texp_construct (ed 0)) (= "false" (:name (ed 1)))))]
                     (ret [:Texp_assert e (:pexp_loc sexp)] (if false? (ty/newvar) (ty/type-unit))))
      :Pexp_pack (let [t (if-let [pt (d 2)]
                           (env/transl-type env (atom {}) {:ptyp_desc [:Ptyp_package pt]})
                           (ty/expand-head expected))
                       td (ty/desc t)]
                   (when-not (= :Tpackage (td 0)) (type-error "This module packing's signature cannot be inferred"))
                   (let [tm (*type-package* env (d 1) t)]
                     (unify! t expected "expression")
                     (mkexp [:Texp_pack tm] t loc)))
      :Pexp_coerce (let [t2g (env/make-generic! (env/transl-type env (atom {}) (d 3)))
                         subtype! (fn [a b] (try ((ty/subtype a b))
                                                 (catch arbace.lang.ExceptionInfo x
                                                   (if (:subtype (ex-data x))
                                                     (type-error (str "Type " (ty/type-scheme-text a) " is not a subtype of " (ty/type-scheme-text b)))
                                                     (throw x)))))
                         e (if-let [t1s (d 2)]
                             ;; (e : t1 :> t2): Ctype.subtype on generic instances (a check), then e typed as a t1
                             (let [t1g (env/make-generic! (env/transl-type env (atom {}) t1s))]
                               (subtype! (ty/instance t1g) (ty/instance t2g))
                               (type-expect env (d 1) (ty/instance t1g)))
                             ;; Typecore.type_coerce: a ground coercion tried as one unification with the enlarged
                             ;; type, else by Ctype.subtype's constraints; else the argument unified with the enlarged type
                             (let [lv @ty/current-level
                                   [e gen] (ty/with-local-level (let [e (type-exp env (d 1))] [e (ty/generalizable? lv (:type e))]))
                                   _ (ty/update-level lv (:type e))
                                   at (:type e)]
                               (if (and (not (ty/free-vars? at)) (not (ty/free-vars? t2g)))
                                 (when-not (and (not gen) (ty/try-unify (ty/unify at (ty/enlarge-type (ty/instance t2g)))))
                                   (subtype! at (ty/instance t2g)))
                                 (unify! at (ty/enlarge-type (ty/instance t2g)) "expression"))
                               e))
                         t2 (ty/instance t2g)]
                     (unify! t2 expected "expression")
                     (assoc e :type t2))
      :Pexp_newtype (let [e (type-newtype env (:txt (d 1)) (fn [env'] (let [e (type-exp env' (d 2))] [e (:type e)])))]
                      (unify! (:type e) expected "expression")
                      e)
      :Pexp_extension
      (let [[{n :txt} payload] (d 1)
            item (when (and (= :PStr (payload 0)) (= 1 (count (payload 1)))) (:pstr_desc (first (payload 1))))
            e (when (= :Pstr_eval (first item)) (:pexp_desc (second item)))]
        (case n
          ("extension_constructor" "ocaml.extension_constructor")
          (let [c (when (= :Pexp_construct (first e)) (first (env/lookup env :constrs (:txt (e 1)))))]
            (when-not (and c (= :Cstr_extension ((:tag c) 0))) (type-error "This constructor is not an extension constructor"))
            (ret [:Texp_extension_constructor ((:tag c) 1)] (ty/tconstr (ty/predef-path "extension_constructor") [])))
          ("atomic.loc" "ocaml.atomic.loc")
          (let [_ (when-not (= :Pexp_field (first e)) (type-error "Invalid [%atomic.loc] payload"))
                r (type-exp env (e 1))
                l (lookup-label env (:txt (e 2)) (:type r))
                [res arg _] (instance-label l)]
            (unify! (:type r) res "expression")
            (when-not (:atomic l) (type-error "The record field is not atomic"))
            (ret [:Texp_atomic_loc r l] (ty/tconstr (ty/predef-path "atomic_loc") [arg])))
          (type-error (str "the extension [%" n "] is outside the slice"))))
      :Pexp_lazy (let [t (ty/newvar)]
                   (unify! (ty/tconstr ty/path-lazy-t [t]) expected "expression")
                   (mkexp [:Texp_lazy (type-expect env (d 1) t)] expected loc))
      :Pexp_struct_item (let [[ti env'] (*type-struct-item* env (d 1))
                              body (type-expect env' (d 2) expected)]
                          (mkexp [:Texp_struct_item ti body] (:type body) loc))
      (type-error (str "expression " (d 0) " outside the slice")))))

(defn type-cases
  "Typecore.type_cases: the patterns first, then guards and bodies; computation patterns (exceptions) when allowed"
  [env targ tres scases computation]
  (let [typed (mapv (fn [c] (let [vars (atom []) eqs (atom [])
                                  p (binding [*equations* eqs] (type-pat env (:pc_lhs c) targ vars))
                                  done @eqs
                                  ;; the equations' types, kept for the case's body, then taken back
                                  now (mapv (fn [[path _]] [path (env/find-decl path)]) done)]
                              (undo-equations! done)
                              [c p @vars [done now]]))
                    scases)
        _ (pressure-variants! (mapv second typed))]
    (mapv (fn [[c p vars [before now]]]
            (let [env' (add-pattern-vars env vars)]
              (doseq [[path decl] now] (env/add-decl! path decl))
              (try
                {:lhs p
                 :guard (when-let [g (:pc_guard c)] (type-expect env' g (ty/type-bool)))
                 :rhs (type-expect env' (:pc_rhs c) tres)}
                (finally (undo-equations! before)))))
          typed)))

(defn- split-arrow
  "The argument and result types of an arrow with label l the expected type is, or is unified with"
  [expected l]
  (let [t (ty/expand-head expected) d (ty/desc t)]
    (if (and (= :Tarrow (d 0)) (= (d 1) l))
      [(d 2) (d 3)]
      (let [a (ty/newvar) r (ty/newvar)]
        (unify! (ty/newty [:Tarrow l a r]) expected "function")
        [a r]))))

(declare type-newtype)

(defn type-function
  "Typecore.type_function: [params body type], a parameter {:kind [:pat p] | [:opt p default] :label :param :partial},
  the body [:body e] or [:cases cases partial param]"
  [env sparams sbody expected]
  (if (empty? sparams)
    (case (sbody 0)
      :Pfunction_body (let [e (type-expect env (sbody 1) expected)] [[] [:body e] (:type e)])
      :Pfunction_cases (let [_ (when-let [[_ c] (first (filter #(and (vector? %) (= ::constraint (first %))) sbody))]
                                 (unify! (annot-type env c) expected "function"))
                             [targ tres] (split-arrow expected [:Nolabel])
                             cases (type-cases env targ tres (sbody 1) false)]
                         [[] [:cases cases (partiality cases) (name-pattern "param" (map :lhs cases)) (get sbody 2)] expected]))
    (let [sp (first sparams) pd (:pparam_desc sp)]
      (if (= :Pparam_newtype (pd 0))
        (let [[params body t] (type-newtype env (:txt (pd 1)) (fn [env'] (let [r (type-function env' (rest sparams) sbody (ty/newvar))] [r (r 2)])))]
          (unify! t expected "function")
          [params body t])
      (let [[_ l default spat] pd
            [targ tret] (split-arrow expected l)
            [tint dflt] (if default
                          (let [td (ty/newvar)]
                            (unify! (ty/type-option td) targ "parameter")
                            [td (type-expect env default td)])
                          (do (when (ty/is-optional l) (unify! (ty/type-option (ty/newvar)) targ "parameter"))
                              [targ nil]))
            vars (atom []) eqs (atom [])
            p (binding [*equations* eqs] (type-pat env spat tint vars))
            _ (pressure-variants! [p])
            env' (add-pattern-vars env @vars)
            ;; a GADT parameter's equations hold over the rest of the function
            [params body _] (try (type-function env' (rest sparams) sbody tret) (finally (undo-equations! @eqs)))
            param {:kind (if dflt [:opt p dflt] [:pat p]) :label l
                   :param (if dflt (ty/ident-create "*opt*") (name-pattern "param" [p]))
                   :partial (partiality [{:lhs p}])}]
        [(vec (cons param params)) body expected])))))

(defn type-newtype
  "Typecore.type_newtype: body typed with name a locally abstract type; its result's type with that type a fresh
  variable (on a copy). (type-body env') gives [result type]; returns the result with the copied type"
  [env n type-body]
  (let [p (new-local-type n)
        [r t] (ty/with-local-level (type-body (assoc-in env [:types n] p)))
        v (ty/newvar n)
        memo (atom {})
        rw (fn rw [t]
             (let [t (ty/repr t)]
               (or (get @memo t)
                   (let [d (ty/desc t)]
                     (cond
                       (= :Tvar (d 0)) t
                       (and (= :Tconstr (d 0)) (= (d 1) p)) v
                       :else (let [x (ty/newty2 (ty/level t) [:Tvar nil])]
                               (swap! memo assoc t x)
                               (swap! x assoc :desc (ty/map-desc rw d))
                               x))))))
        t' (rw t)]
    (if (vector? r)
      (assoc r 2 t')
      (assoc r :type t'))))

;; ---------------------------------------------------------------------------------------------
;; let (Typecore.type_let) with the relaxed value restriction

(declare nonexpansive?)

(defn nonexpansive-mod?
  "Typecore.is_nonexpansive_mod"
  [m]
  (let [d (:desc m)]
    (case (d 0)
      :Tmod_ident true
      :Tmod_functor true
      :Tmod_constraint (nonexpansive-mod? (d 1))
      :Tmod_structure (every? (fn [it]
                                (case (it 0)
                                  :Tstr_value (every? #(nonexpansive? (:expr %)) (it 2))
                                  :Tstr_module (nonexpansive-mod? (it 2))
                                  :Tstr_include (nonexpansive-mod? (it 1))
                                  (:Tstr_type :Tstr_modtype :Tstr_open :Tstr_primitive) true
                                  false))
                              (d 1))
      false)))

(defn nonexpansive?
  "Typecore.is_nonexpansive for the slice"
  [e]
  (let [d (:desc e)]
    (case (d 0)
      (:Texp_ident :Texp_constant :Texp_function) true
      :Texp_let (and (every? #(nonexpansive? (:expr %)) (d 2)) (nonexpansive? (d 3)))
      :Texp_tuple (every? #(nonexpansive? (second %)) (d 1))
      :Texp_construct (every? nonexpansive? (d 2))
      :Texp_variant (or (nil? (d 2)) (nonexpansive? (d 2)))
      :Texp_record (and (every? (fn [[l df]] (and (not (:mut l)) (or (= :kept (df 0)) (nonexpansive? (df 1))))) (d 1))
                        (or (nil? (d 3)) (nonexpansive? (d 3))))
      :Texp_field (nonexpansive? (d 1))
      :Texp_lazy (nonexpansive? (d 1))
      :Texp_pack (nonexpansive-mod? (d 1))
      :Texp_struct_item (and (let [ti (d 1)]
                               (case (ti 0)
                                 :Tstr_open true
                                 :Tstr_module (nonexpansive-mod? (ti 2))
                                 :Tstr_exception true
                                 false))
                             (nonexpansive? (d 2)))
      :Texp_array (empty? (d 1))
      :Texp_ifthenelse (and (nonexpansive? (d 2)) (or (nil? (d 3)) (nonexpansive? (d 3))))
      :Texp_sequence (nonexpansive? (d 2))
      :Texp_apply (and (some nil? (map second (d 2))) (nonexpansive? (d 1))
                       (every? #(or (nil? %) (nonexpansive? %)) (map second (d 2)))
                       (= nil (second (first (d 2)))))
      false)))

(defn- varify-constructors
  "Ast_helper.Typ.varify_constructors: the names of the locally abstract types as type variables"
  [names t]
  (letfn [(go [x]
            (cond
              (and (map? x) (:ptyp_desc x)
                   (= :Ptyp_constr ((:ptyp_desc x) 0)) (= :Lident ((:txt ((:ptyp_desc x) 1)) 0))
                   (names ((:txt ((:ptyp_desc x) 1)) 1)) (empty? ((:ptyp_desc x) 2)))
              (assoc x :ptyp_desc [:Ptyp_var ((:txt ((:ptyp_desc x) 1)) 1)])
              (map? x) (into {} (map (fn [[k v]] [k (go v)]) x))
              (vector? x) (mapv go x)
              (seq? x) (map go x)
              :else x))]
    (go t)))

(defn- vb-constraint
  "Typecore's vb_pat_constraint and vb_exp_constraint: `let p : t = e` as `let (p : t) = (e : t)`; `let p : type a. t
  = e` as `let (p : 'a. t[a := 'a]) = fun (type a) -> (e : t)`"
  [vb]
  (let [c (:pvb_constraint vb)
        ploc (:ppat_loc (:pvb_pat vb)) eloc (:pexp_loc (:pvb_expr vb))]
    (cond
      (nil? c) vb
      (and (= :Pvc_constraint (c 0)) (empty? (c 1)) (not= :Ptyp_poly ((:ptyp_desc (c 2)) 0)))
      (assoc vb :pvb_constraint nil
             :pvb_pat {:ppat_desc [:Ppat_constraint (:pvb_pat vb) (c 2)] :ppat_loc ploc}
             :pvb_expr {:pexp_desc [:Pexp_constraint (:pvb_expr vb) (c 2)] :pexp_loc eloc})
      ;; let p : 'a. t = e: the pattern explicitly polymorphic, the expression typed against its instance
      (and (= :Pvc_constraint (c 0)) (empty? (c 1)) (= :Ptyp_poly ((:ptyp_desc (c 2)) 0)))
      (assoc vb :pvb_constraint nil
             :pvb_pat {:ppat_desc [:Ppat_constraint (:pvb_pat vb) (c 2)] :ppat_loc ploc})
      (and (= :Pvc_constraint (c 0)) (seq (c 1)))
      (let [names (set (map :txt (c 1)))
            poly {:ptyp_desc [:Ptyp_poly (vec (c 1)) (varify-constructors names (c 2))]}]
        (assoc vb :pvb_constraint nil
               :pvb_pat {:ppat_desc [:Ppat_constraint (:pvb_pat vb) poly] :ppat_loc ploc}
               :pvb_expr (reduce (fn [e n] {:pexp_desc [:Pexp_newtype n e] :pexp_loc eloc})
                                 {:pexp_desc [:Pexp_constraint (:pvb_expr vb) (c 2)] :pexp_loc eloc}
                                 (reverse (c 1)))))
      :else (type-error "this let's type constraint is outside the slice"))))

(defn- gadt-pattern?
  "A pattern with a GADT constructor (a let that refines types, typed as a match is)"
  [env sp]
  (letfn [(go [x]
            (cond
              (and (map? x) (:ppat_desc x) (= :Ppat_construct ((:ppat_desc x) 0)))
              (or (some :res (try (env/lookup env :constrs (:txt ((:ppat_desc x) 1))) (catch Exception _ nil)))
                  (go ((:ppat_desc x) 2)))
              (map? x) (some go (vals x))
              (sequential? x) (some go x)
              :else false))]
    (boolean (go sp))))

(declare type-let*)

(defn type-let
  "[value-bindings env'] for let [rec]: each {:pat :expr}"
  [env rec svbs]
  (let [svbs (mapv vb-constraint svbs)]
    (if (and (= rec :Nonrecursive) (= 1 (count svbs)) *let-equations* (gadt-pattern? env (:pvb_pat (first svbs))))
      ;; let K = e in body with K a GADT constructor: the expression first, then its pattern with equations that
      ;; hold over the body (as match e with K -> body)
      (let [vb (first svbs)
            e (type-exp env (:pvb_expr vb))
            vars (atom [])
            p (binding [*equations* *let-equations*] (type-pat env (:pvb_pat vb) (:type e) vars))]
        [[{:pat p :expr e :attrs nil}] (add-pattern-vars env @vars)])
    (type-let* env rec svbs))))

(defn- type-let*
  [env rec svbs]
  (let [res (ty/with-local-level
              (let [pats (mapv (fn [vb] (let [vars (atom [])
                                              p (type-pat env (:pvb_pat vb) (ty/newvar) vars)]
                                          [p @vars]))
                               svbs)
                    _ (doseq [[p _] pats] (pressure-variants! [p]))
                    env-rec (if (= rec :Recursive) (reduce (fn [e [_ vs]] (add-pattern-vars e vs)) env pats) env)
                    exprs (mapv (fn [vb [p _]]
                                  (let [e (if-let [c (:pvb_constraint vb)]
                                            (let [cd c] (type-expect env-rec (:pvb_expr vb) (:type p)))
                                            (type-expect env-rec (:pvb_expr vb) (:type p)))]
                                    e))
                                svbs pats)]
                [pats exprs]))
        [pats exprs] res]
    ;; before_generalize, at the outer level: the relaxed value restriction
    (doseq [e exprs] (when-not (nonexpansive? e) (ty/lower-contravariant (:type e))))
    (doseq [e exprs] (ty/generalize (:type e)))
    (doseq [[p _] pats] (ty/generalize (:type p)))
    [(mapv (fn [[p _] e vb] {:pat p :expr e :attrs (map #(:txt (:attr_name %)) (:pvb_attributes vb))}) pats exprs svbs)
     (reduce (fn [e [_ vs]] (add-pattern-vars e vs)) env pats)]))

(ns arbace.repr.ocaml.typer.printtyp
  "Printtyp's signature as Format prints it (doc/ocaml/TYPER.md, T8): the items of a signature, [:val name id
  type] [:type [[name path decl]...]] [:exn name id cstr] [:module name id mty] [:modtype name id mty-or-nil], as
  Oprint's documents (arbace.repr.ocaml.typer.format) rendered at Format's margin. A module type is [:Mty_ident
  path] [:Mty_signature items] [:Mty_functor param res] (param nil for (), else [id-or-nil mty]) [:Mty_alias path]."
  (:require [arbace.repr.ocaml.typer.types :as ty]
            [arbace.repr.ocaml.typer.format :as f]
            [arbace.string :as str]))

(set! *warn-on-reflection* false)

;; ---------------------------------------------------------------------------------------------
;; Types (oprint.ml's print_out_type and its levels)

(defn- label-text [l] (case (l 0) :Nolabel "" :Labelled (str (l 1) ":") :Optional (str "?" (l 1) ":")))

(declare out-type out-type-1 simple-out-type)

(defn- typlist [elem sep ts]
  (f/join (f/docs (f/text sep) f/sp) (map elem ts)))

(defn- typargs [names ts]
  (case (count ts)
    0 []
    1 (f/docs (simple-out-type names (first ts)) f/sp)
    (f/docs (f/box :b 1 (f/text "(") (typlist #(out-type names %) "," ts) (f/text ")")) f/sp)))

(defn- tuple? [t] (= :Ttuple ((ty/desc t) 0)))
(defn- arrow? [t] (= :Tarrow ((ty/desc t) 0)))

(defn- out-type-2 [names t arg]
  (let [d (ty/desc t)]
    (if (= :Ttuple (d 0))
      (let [els (d 1)
            parens (and arg (some? (first (first els))))]
        (f/docs (when parens (f/text "("))
               (f/box :b 0 (typlist (fn [[l x]] (f/box :b 0 (when l (f/text (str l ":"))) (simple-out-type names x)))
                                    " *" els))
               (when parens (f/text ")"))))
      (simple-out-type names t))))

(def ^:dynamic *unaliased* "The node whose alias is being printed (its body printed as itself)" nil)

(defn- alias-of
  "Out_type's aliases: [:alias name] for a row printed with `as 'a` (the first time), [:var name] after it, nil"
  [names t]
  (let [px (ty/type-proxy t)]
    (when (and (not (ty/tvar? t)) (contains? (::ty/aliased names) px))
      (if (contains? @(::ty/printed names) px)
        [:var (get names px "'_")]
        (do (swap! (::ty/printed names) conj px) [:alias (get names px "'_")])))))

(defn- dedupe-types
  "Ctype.normalize_type's conjunctions: the equal types of a tag's conjunction printed once"
  [ts]
  (if (< (count ts) 2)
    ts
    (let [k (fn [t] (ty/type-scheme-text t))
          r (reduce (fn [acc t] (if (some #(= (k t) (k %)) acc) acc (conj acc t))) [(first ts)] (rest ts))]
      (if (< (count r) (count ts)) r ts))))

(defn- variant-doc
  "Out_type.tree_of_typexp's Tvariant and Oprint's Otyp_variant"
  [names row]
  (let [row (ty/row-repr row)
        closed (:closed row)
        ;; Ctype.normalize_type: the fields sorted, the absent ones dropped
        fields (ty/sort-row-fields (remove (fn [[_ f]] (ty/absent? f)) (:fields row)))
        present (filter (fn [[_ f]] (= :Rpresent ((ty/field-view f) 0))) fields)
        all-present (= (count present) (count fields))
        tags (when-not all-present (map first present))
        nm (:name row)
        prefix (if closed (if (nil? tags) " " "< ") (if (nil? tags) "> " "? "))
        field-doc (fn [[l f]]
                    (let [v (ty/field-view f)
                          [amp ts] (case (v 0)
                                     :Rpresent [false (if (v 1) [(v 1)] [])]
                                     :Reither (if (and (v 1) (empty? (v 2))) [false []] [(boolean (v 1)) (dedupe-types (v 2))])
                                     [false []])]
                      (f/box :hv 2 (f/text (str "`" l))
                             (cond amp (f/docs (f/text " of") f/sp (f/text "&") f/sp)
                                   (seq ts) (f/docs (f/text " of") f/sp)
                                   :else [])
                             (typlist #(out-type names %) " &" ts))))
        body (if (and nm (ty/nameable-row row))
               (simple-out-type names (ty/newty [:Tconstr (first nm) (vec (second nm))]))
               (f/join (f/docs (f/brk 1 -2) (f/text "| ")) (map field-doc fields)))]
    (if (and nm (ty/nameable-row row) closed all-present)
      body
      (f/box :hov 0 (f/text (str "[" prefix))
             (f/box :hv 0 (f/box :hv 0 body)
                    (if (seq tags)
                      (f/docs (f/brk 1 -2) (f/text "> ") (f/box :hov 0 (f/join f/sp (map #(f/text (str "`" %)) tags))))
                      []))
             f/sp (f/text "]")))))

(defn- object-doc
  "Out_type.tree_of_typobject and Oprint's Otyp_object (the public fields sorted, `..` for an open row) or Otyp_class
  (an object named by its class's #-type)"
  [names t fi nm]
  (if nm
    (let [[p [_ & args]] nm]
      (f/box :b 0 (typargs names args) (f/text "#") (f/text (ty/*path-name* p))))
    (let [[fs r] (ty/flatten-fields fi)
          fs (filter (fn [[_ k _]] (= :public (ty/field-kind-repr k))) fs)
          open (not= :Tnil ((ty/desc r) 0))
          field (fn [[n _ x]] (f/docs (f/text (str n " : ")) (out-type names x)))
          items (concat (map field fs) (when open [(f/text "..")]))]
      (f/box :b 2 (f/text "< ") (f/join (f/docs (f/text ";") f/sp) items) (f/text " >")))))

(declare simple-out-type*)

(defn simple-out-type [names t]
  (let [t (ty/repr t)
        skip (identical? t *unaliased*)
        al (when-not skip (alias-of names t))]
    (binding [*unaliased* nil] (simple-out-type* names t al))))

(defn- simple-out-type* [names t al]
  (let [d (ty/desc t)]
    (case (if al (al 0) (d 0))
      :var (f/text (al 1))
      :alias (f/box :b 1 (f/text "(") (f/box :b 0 (binding [*unaliased* t] (out-type names t)) f/sp (f/text (str "as " (al 1)))) (f/text ")"))
      :Tvariant (variant-doc names (d 1))
      :Tobject (object-doc names t (d 1) (d 2))
      :Tvar (f/text (get names t "'_"))
      :Tconstr (f/box :b 0 (typargs names (d 2)) (f/text (ty/*path-name* (d 1))))
      (:Tarrow :Ttuple) (f/box :b 1 (f/text "(") (out-type names t) (f/text ")"))
      :Tpackage (f/box :b 1 (f/text (str "(module " (ty/*path-name* (d 1))))
                       (mapcat (fn [i [n x]] (f/docs (f/text (str (if (zero? i) " with" " and") " type " (str/join "." n) " = "))
                                                     (out-type names x)))
                               (range) (d 2))
                       (f/text ")"))
      (f/text "?"))))

(defn out-type-1 [names t]
  (let [t (ty/repr t) d (ty/desc t)]
    (if (= :Tarrow (d 0))
      (let [l (d 1)
            a (if (ty/is-optional l)
                (let [x (ty/expand-head (d 2)) xd (ty/desc x)]
                  (if (and (= :Tconstr (xd 0)) (= (xd 1) ty/path-option)) (first (xd 2)) (d 2)))
                (d 2))]
        (f/box :b 0 (f/text (label-text l)) (out-type-2 names a true) (f/text " ->") f/sp (out-type-1 names (d 3))))
      (out-type-2 names t false))))

(defn out-type [names t]
  (let [t (ty/repr t)
        al (when-not (identical? t *unaliased*) (alias-of names t))]
    (case (when al (al 0))
      :var (f/text (al 1))
      :alias (f/box :b 0 (binding [*unaliased* t] (out-type-1 names t)) f/sp (f/text (str "as " (al 1))))
      (out-type-1 names t))))

(defn type-scheme-doc [t] (out-type (ty/name-vars [t]) t))

;; ---------------------------------------------------------------------------------------------
;; Signature items (print_out_sig_item, print_out_type_decl, print_out_constr)

(def ^:private operator-chars (set "!$%&*+-./:<=>?@^|~#"))
(defn- value-ident [n]
  (if (or (operator-chars (first n)) (#{"mod" "land" "lor" "lxor" "lsl" "lsr" "asr" "or"} n))
    (str "( " n " )")
    n))

(defn- record-doc [names ls]
  (f/docs (f/text "{")
          (mapcat (fn [l] (f/docs f/sp (f/box :b 2 (f/text (str (when (:mut l) "mutable ") (:name l) " :")) f/sp
                                              (out-type names (:type l)))
                                  (f/text ";")))
                  ls)
          (f/brk 1 -2) (f/text "}")))

(defn- constr-doc [names c simple?]
  (let [n (if (= "::" (:name c)) "(::)" (:name c))]
    (cond
      (:res c) (let [names (ty/name-vars (concat (:args c) [(:res c)]))]
                 (if (empty? (:args c))
                   (f/box :b 2 (f/text (str n " :")) f/sp (simple-out-type names (:res c)))
                   (f/box :b 2 (f/text (str n " :")) f/sp (typlist #(simple-out-type names %) " *" (:args c))
                          (f/text " -> ") (simple-out-type names (:res c)))))
      (:inlined c) (f/box :b 2 (f/text (str n " of")) f/sp (record-doc names (:inlined c)))
      (empty? (:args c))
      (f/text n)
      :else (f/box :b 2 (f/text (str n " of")) f/sp (typlist #(simple-out-type names %) " *" (:args c))))))

(defn- decl-doc [kwd [name _ decl]]
  (let [params (:params decl)
        ;; a parameter constrained (unified with a type, as `[< ...] as 'a` makes it) named by its proxy, printed
        ;; as that name and in a `constraint` (Printtyp.tree_of_type_decl's constraints)
        cstrs (filter #(not (ty/tvar? %)) params)
        pname (fn [p] (let [px (ty/type-proxy p)]
                        (if (and (ty/tvar? px) ((ty/desc px) 1)) (str "'" ((ty/desc px) 1)) "'a")))
        names (into {} (map (fn [p] (if (ty/tvar? p)
                                      [(ty/repr p) (if-let [n ((ty/desc p) 1)] (str "'" n) "_")]
                                      [(ty/repr p) (pname p)]))
                            params))
        names (if (seq cstrs)
                (let [pxs (map ty/type-proxy cstrs)]
                  (merge names (zipmap pxs (map pname cstrs)) {::ty/aliased (set pxs) ::ty/printed (atom (set pxs))}))
                names)
        ;; Printtyp's variance and injectivity of an abstract type's parameters, as they were declared
        abstr (and (= :abstract ((:kind decl) 0)) (nil? (:manifest decl)))
        annot (fn [i p] (let [[v inj] (get (:param-annots decl) i)
                              nm (names (ty/repr p))]
                          (if abstr
                            (str (case v :Covariant "+" :Contravariant "-" :Bivariant "+-" "") (if (= inj :Injective) "!" "") nm)
                            nm)))
        type-defined (case (count params)
                       0 (f/text name)
                       1 (f/box :b 0 (f/text (annot 0 (first params))) f/sp (f/text name))
                       (f/box :b 0 (f/text "(")
                              (f/box :b 0 (f/join (f/docs (f/text ",") f/sp) (map-indexed (fn [i p] (f/text (annot i p))) params))
                                     (f/text ")"))
                              f/sp (f/text name)))
        manifest (:manifest decl)
        ;; Printtyp.tree_of_type_decl's hack: a variant's own name hidden in its declaration
        manifest (let [md (when manifest (ty/desc manifest))]
                   (if (and md (= :Tvariant (md 0)) (= (:path decl) (first (ty/row-name (md 1)))))
                     (ty/newgenty [:Tvariant (ty/set-row-name (md 1) nil)])
                     manifest))
        k (:kind decl)
        priv (if (:private decl) " private" "")
        name-params (f/docs (f/text (str kwd " ")) type-defined (when (and manifest (not= :abstract (k 0)))
                                                                (f/docs (f/text " =") f/sp (out-type names manifest))))
        tkind (case (k 0)
                :abstract (if manifest (f/docs (f/text (str " =" priv)) (f/brk 1 2) (out-type names manifest)) [])
                :open (f/text (str " =" priv " .."))
                :variant (f/docs (f/text (str " =" priv)) (f/brk 1 2)
                                (if (empty? (k 1)) (f/text "|")
                                    (f/join (f/docs f/sp (f/text "| ")) (map #(constr-doc names % true) (k 1)))))
                :record (f/docs (f/text (str " =" priv " "))
                               (f/text "{")
                               (mapcat (fn [l] (f/docs f/sp (f/box :b 2 (f/text (str (when (:mut l) "mutable ") (:name l) " :")) f/sp
                                                                  (out-type names (:type l)))
                                                      (f/text ";")))
                                       (k 1))
                               (f/brk 1 -2) (f/text "}")))]
    (f/box :b 2 (f/box :hv 2 name-params tkind)
           (mapcat (fn [p] (f/docs f/sp (f/box :b 2 (f/text (str "constraint " (pname p) " =")) f/sp
                                               (binding [*unaliased* (ty/repr p)] (out-type names p)))))
                   cstrs))))

(declare mty-doc)

(defn- item-doc [item]
  (case (item 0)
    :val (let [k (get item 4)]
           (if (= :prim (first k))
             (f/box :b 2 (f/text (str "external " (value-ident (item 1)) " :")) f/sp (type-scheme-doc (item 3))
                    (mapcat (fn [i n] (f/docs f/sp (f/text (str (if (zero? i) "= \"" "\"") n "\""))))
                            (range) (:names (second k)))
                    [])
             (f/box :b 2 (f/text (str "val " (value-ident (item 1)) " :")) f/sp (type-scheme-doc (item 3)))))
    :type (f/join f/sp (map-indexed (fn [i d] (decl-doc (if (zero? i) "type" "and") d)) (item 1)))
    :exn (let [c (item 3) names (ty/name-vars (:args c))]
           (f/box :b 2 (f/text "exception ") (constr-doc names c true)))
    :module (let [mty (item 3)]
              (if (= :Mty_alias (mty 0))
                (f/box :b 2 (f/text (str "module " (item 1) " =")) f/sp (f/text (ty/*path-name* (mty 1))))
                (f/box :b 2 (f/text (str (case (get item 5) :rec-first "module rec" :rec-next "and" "module") " " (item 1) " :"))
                       f/sp (mty-doc mty))))
    :modtype (if-let [mty (item 3)]
               (f/box :b 2 (f/text (str "module type " (item 1) " =")) f/sp (mty-doc mty))
               (f/box :b 2 (f/text (str "module type " (item 1)))))))

(defn- typext-doc
  "Oprint's print_out_type_extension: `type ps t += C1 | C2`"
  [cs]
  (let [{:keys [path params]} (:typext (first cs))
        pnames (into {} (map (fn [p] [(ty/repr p) (if-let [n ((ty/desc p) 1)] (str "'" n) "_")]) params))
        names (merge (ty/name-vars (mapcat :args cs)) pnames)
        tname (ty/*path-name* path)
        head (case (count params)
               0 (f/text tname)
               1 (f/box :b 0 (f/text (pnames (ty/repr (first params)))) f/sp (f/text tname))
               (f/box :b 0 (f/text "(") (f/box :b 0 (f/join (f/docs (f/text ",") f/sp) (map #(f/text (pnames (ty/repr %))) params))
                                                 (f/text ")"))
                      f/sp (f/text tname)))]
    (f/box :hv 2 (f/text "type ") head (f/text " +=") (f/brk 1 2)
           (f/join (f/docs f/sp (f/text "| ")) (map #(constr-doc names % true) cs)))))

(defn- signature-doc [items]
  (loop [its (seq items) acc []]
    (if-not its
      (f/join f/sp acc)
      (let [item (first its)]
        (if (and (= :exn (item 0)) (:typext (item 3)))
          (let [more (take-while #(and (= :exn (% 0)) (:typext (% 3)) (not (:ext-first (% 3)))) (rest its))]
            (recur (seq (drop (inc (count more)) its)) (conj acc (typext-doc (map #(% 3) (cons item more))))))
          (recur (next its) (conj acc (item-doc item))))))))

(defn- simple-mty-doc [mty]
  (case (mty 0)
    :Mty_ident (f/text (ty/*path-name* (mty 1)))
    :Mty_signature (if (empty? (mty 1))
                     (f/text "sig end")
                     (f/box :hv 2 (f/text "sig") f/sp (signature-doc (mty 1)) (f/brk 1 -2) (f/text "end")))
    :Mty_alias (f/text (str "(module " (ty/*path-name* (mty 1)) ")"))
    :Mty_functor (f/docs (f/text "(") (mty-doc mty) (f/text ")"))))

(defn- functor-args [mty]
  (loop [m mty acc []] (if (= :Mty_functor (m 0)) (recur (m 2) (conj acc (m 1))) [acc m])))

(defn- functor-params-doc [params]
  (let [anon? (fn [p] (and p (nil? (first p))))]
    (letfn [(args [ps]
              (cond
                (empty? ps) []
                (anon? (first ps)) (f/docs (simple-mty-doc (second (first ps))) (f/text " ->") f/sp (args (rest ps)))
                :else (let [rv (reverse ps)
                            suffix (reverse (take-while anon? rv))
                            named (vec (take (- (count ps) (count suffix)) ps))]
                        (f/docs (f/box :b 0 (f/join f/sp (map (fn [p] (if p
                                                                       (f/docs (f/text (str "(" (or (some-> (first p) :name) "_") " : "))
                                                                              (mty-doc (second p)) (f/text ")"))
                                                                       (f/text "()")))
                                                             named)))
                               f/sp (f/text "->") f/sp (args suffix)))))]
      (args params))))

(defn mty-doc [mty]
  (let [[params res] (functor-args mty)]
    (f/box :b 2 (functor-params-doc params) (simple-mty-doc res))))

(defn signature-text
  "Printtyp.signature: the items in a vertical box, rendered"
  [items]
  (f/render (f/box :v 0 (signature-doc items))))

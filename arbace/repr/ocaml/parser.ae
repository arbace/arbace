;; The engine follows MenhirLib's (Menhir 20250912, https://gitlab.inria.fr/fpottier/menhir, lib/Engine.ml and
;; TableInterpreter.ml, as boot/menhir/menhirLib.ml of the pinned OCaml 5.5.0 tarball carries it: LGPL-2.0 with the
;; OCaml linking exception, LICENSE.md "Menhir and MenhirLib"): a token read after each shift, default reductions,
;; the positions of a reduction (an empty production's start and end the previous cell's end, one object); and
;; parsing/parse.ml's wrap (the lexer's and docstrings' state per parse). Read and reimplemented by hand on 2026-11-04;
;; the rest is Arbace's own.

(ns arbace.repr.ocaml.parser
  "OCaml's parser in Arbace: arbace.repr.ocaml.tables' LALR(1) automaton (generated from parser.mly by
  arbace.repr.ocaml.menhir) driven as MenhirLib drives it, each reduction evaluating its production's plan (the
  composed source actions of arbace.repr.ocaml.actions, inlined items first, right to left, as Menhir's generated
  code binds them) with Menhir's positions ($startpos, $endpos, $symbolstartpos of each composed action, from the
  cells it covers). `parse` reads the bytes of a file into the Parsetree (arbace.repr.ocaml.ast); `dump` writes it
  as tools/ocdump writes its parse (the same forms, the same text)."
  (:require [arbace.repr.ocaml.tables :as t]
            [arbace.repr.ocaml.actions :as act]
            [arbace.repr.ocaml.lex :as lex]
            [arbace.repr.ocaml.docstrings :as ds]
            [arbace.repr.ocaml.ast :as ast]
            [arbace.repr.ocaml.report :as report])
  (:import [arbace.repr.ocaml.actions Env]))

(set! *warn-on-reflection* false)

;; ---------------------------------------------------------------------------------------------
;; The tables, loaded once into arrays (flat int arrays and plans as typed nodes: the evaluator's cost is the
;; number of calls and boxed operations, OC173)

(def ^:private nterms (count t/terminals))
(def ^:private term-index (into {} (map-indexed (fn [i n] [(keyword n) i]) t/terminals)))
(def ^:private n-states (count t/states))

(def ^:private plhs (int-array (map first t/productions)))
(def ^:private plen (int-array (map second t/productions)))
(def ^:private pstart (object-array (map #(nth % 3) t/productions)))
(def ^:private pnull (object-array (map #(boolean-array (nth % 4)) t/productions)))
(def ^:private nnt (inc (long (reduce max (map first t/productions)))))

(def ^:private action-fns
  (let [missing (remove #(contains? act/actions %) t/actions)]
    (when (seq missing)
      (throw (ex-info (str (count missing) " actions of the tables have no translation: " (pr-str (take 5 missing))) {:missing (vec missing)})))
    (object-array (map #(get act/actions %) t/actions))))

;; a plan: its action, the length of the production it covers (len), its items' names (a map to the item's index,
;; nil when none), and its n items: item k either the cell lo[k] (subs[k] nil) or the cells lo[k] to hi[k] reduced by
;; the plan subs[k]; simple: the items are the cells 0 to n-1 in order (the environment then reads the stack in place);
;; needs-pos: the action's text mentions a position ($startpos, $endpos, $symbolstartpos, $sloc, $loc), else the
;; environment has none; pass: the index of the one item the action returns as it is ("$1", or an item's name), when
;; no other item is reduced by a plan of its own (checked at load against the action itself), else -1
(deftype Plan [f ^long len names ^long n ^ints lo ^ints hi ^objects subs simple needs-pos ^long pass])

(def ^:private pos-actions
  (boolean-array (map #(boolean (re-find #"\$(startpos|endpos|symbolstartpos|sloc|loc)" %)) t/actions)))
(defn- needs-pos? [aid] (aget ^booleans pos-actions aid))

(defn- compile-plan
  "A plan with its action resolved"
  [plan]
  (when plan
    (let [[aid len names items] plan
          n (count items)
          lo (int-array n) hi (int-array n) subs (object-array n)]
      (dotimes [k n]
        (let [it (nth items k)]
          (if (vector? it)
            (do (aset lo k (int (nth it 0))) (aset hi k (int (nth it 1))) (aset subs k (compile-plan (nth it 2))))
            (do (aset lo k (int it)) (aset hi k (int it))))))
      (let [needs-pos (needs-pos? aid)
            ;; a sub-plan that only passes a cell on (and no position is asked of the item) is that cell
            _ (when-not needs-pos
                (dotimes [k n]
                  (let [^Plan sp (aget subs k)]
                    (when (and sp (>= (.-pass sp) 0) (nil? (aget ^objects (.-subs sp) (.-pass sp))))
                      (aset lo k (int (+ (aget lo k) (aget ^ints (.-lo sp) (.-pass sp)))))
                      (aset hi k (aget lo k))
                      (aset subs k nil)))))
            f (aget ^objects action-fns aid)
            text (nth t/actions aid)
            nm (when (some some? names)
                 (let [m (java.util.HashMap.)] (doseq [[i nm] (map-indexed vector names)] (when nm (.put m nm (int i)))) m))
            cand (cond (re-matches #"\$([0-9]+)" text) (dec (Long/parseLong (.substring ^String text 1)))
                       (and nm (.containsKey nm text)) (long (.get nm text))
                       :else -1)
            pass (if (and (>= cand 0) (< cand n)
                          (every? #(or (= % cand) (nil? (aget subs %))) (range n))
                          (let [vs (object-array n)]
                            (dotimes [k n] (aset vs k (Object.)))
                            (identical? (aget vs cand) (try (f (Env. vs nil nil nm nil nil nil 0)) (catch Throwable _ nil)))))
                   cand -1)]
        (Plan. f len nm n lo hi subs
               (every? true? (for [k (range n)] (and (nil? (aget subs k)) (= k (aget lo k)))))
               needs-pos
               pass)))))

(def ^:private pplan (object-array (map #(compile-plan (nth % 2)) t/productions)))
;; a production whose plan only passes a cell on: its index from the production's base, else -1
(def ^:private ppass
  (int-array (map (fn [^Plan pl] (if (and pl (>= (.-pass pl) 0) (nil? (aget ^objects (.-subs pl) (.-pass pl))))
                                   (aget ^ints (.-lo pl) (.-pass pl)) -1))
                  (seq pplan))))

(def ^:private defred (int-array (map first t/states)))

;; per state and terminal: 0 (error), s+1 (shift to s), -(p+1) (reduce p)
(def ^:private action-table
  (let [a (int-array (* n-states nterms))]
    (doseq [[s [_ acts _]] (map-indexed vector t/states)]
      (doseq [[tm code] (partition 2 acts)]
        (aset a (int (+ (* s nterms) (long tm))) (int (if (neg? code) code (inc code))))))
    a))

;; per state and nonterminal: the state after a reduction to it
(def ^:private goto-table
  (let [a (int-array (* n-states nnt))]
    (doseq [[s [_ _ gs]] (map-indexed vector t/states)]
      (doseq [[x g] (partition 2 gs)]
        (aset a (int (+ (* s nnt) (long x))) (int g))))
    a))

;; ---------------------------------------------------------------------------------------------
;; Plans: the composed actions of a production, with Menhir's positions

(defn- eval-plan
  "The value of a plan over the reduced cells from base: its items right to left (an inlined item's own plan
  evaluated in place), then its action on the environment of their values and positions"
  [^Plan plan ^objects vals ^objects sps ^objects eps ^booleans nullable pbase base endpos0]
  (let [pass (.-pass plan)]
    (if (>= pass 0)
      ;; the action returns one item as it is
      (let [sub (aget ^objects (.-subs plan) pass) c (+ base (aget ^ints (.-lo plan) pass))]
        (if sub
          (eval-plan sub vals sps eps nullable pbase c endpos0)
          (aget vals c)))
      (let [len (.-len plan)
            n (.-n plan)
            pos (.-needs-pos plan)
            start (when pos (if (> len 0) (aget sps base) (if (> base 0) (aget eps (dec base)) endpos0)))
            end (when pos (if (> len 0) (aget eps (+ base len -1)) start))
            symstart (when pos
                       (loop [c base]
                         (cond
                           (>= c (+ base len)) end
                           (or (not (aget nullable (- c pbase))) (not (identical? (aget sps c) (aget eps c)))) (aget sps c)
                           :else (recur (inc c)))))]
        (if (.-simple plan)
          ((.-f plan) (Env. vals sps eps (.-names plan) start end symstart base))
          (let [^ints lo (.-lo plan) ^ints hi (.-hi plan) ^objects subs (.-subs plan)
                iv (object-array n) is (when pos (object-array n)) ie (when pos (object-array n))]
            (loop [k (dec n)]
              (when (>= k 0)
                (let [sub (aget subs k)]
                  (if sub
                    (let [l (+ base (aget lo k)) h (+ base (aget hi k))]
                      (aset iv k (eval-plan sub vals sps eps nullable pbase l endpos0))
                      (when pos
                        (if (> h l)
                          (do (aset ^objects is k (aget sps l)) (aset ^objects ie k (aget eps (dec h))))
                          (let [b (if (> l 0) (aget eps (dec l)) endpos0)] (aset ^objects is k b) (aset ^objects ie k b)))))
                    (let [c (+ base (aget lo k))]
                      (aset iv k (aget vals c))
                      (when pos (aset ^objects is k (aget sps c)) (aset ^objects ie k (aget eps c))))))
                (recur (dec k))))
            ((.-f plan) (Env. iv is ie (.-names plan) start end symstart 0))))))))

;; ---------------------------------------------------------------------------------------------
;; The engine

(defn- syntax-error-data [msg loc] {:ocaml-error :syntax :message msg :loc loc})

(defn- grow
  "The four stack arrays doubled: [st vals sps eps]"
  [^ints st ^objects vals ^objects sps ^objects eps]
  (let [n (* 2 (alength st))]
    [(java.util.Arrays/copyOf st (int n)) (java.util.Arrays/copyOf vals (int n))
     (java.util.Arrays/copyOf sps (int n)) (java.util.Arrays/copyOf eps (int n))]))

(defn- run
  "The parse from a start state: the start production's value, or an ex-info {:ocaml-error ...}"
  [lb start-state]
  (let [cap 512
        p0 (lex/curr-p lb)
        st0 (int-array cap) vals0 (object-array cap) sps0 (object-array cap) eps0 (object-array cap)
        nt (long nterms) nn (long nnt)]
    ;; the bottom cell: the start state, its end the initial position
    (aset st0 0 (int start-state)) (aset vals0 0 nil) (aset sps0 0 p0) (aset eps0 0 p0)
    ;; err: Menhir's error-handling mode (the simplified strategy, parse.ml's --strategy simplified): the lookahead
    ;; replaced by the error terminal (column 0), no token read until the parse ends
    (let [tk0 (lex/token lb)]
      (loop [^ints st st0 ^objects vals vals0 ^objects sps sps0 ^objects eps eps0 top 1
             tk tk0 tsp (lex/start-p lb) tep (lex/curr-p lb) err false]
        (if (>= (+ top 2) (alength st))
          (let [[st2 vals2 sps2 eps2] (grow st vals sps eps)] (recur st2 vals2 sps2 eps2 top tk tsp tep err))
          (let [s (aget st (dec top))
                d (aget ^ints defred s)
                ti (cond (>= d 0) -1 err 0 :else (let [x (get term-index (nth tk 0))] (if x (long x) -1)))
                a (if (>= d 0) 0 (if (>= ti 0) (aget ^ints action-table (+ (* s nt) ti)) 0))
                p (cond (>= d 0) d (neg? a) (- (- a) 1) :else -1)]
            (cond
              (>= p 0)
              (let [n (aget ^ints plen p)
                    base (- top n)
                    endpos0 (aget eps (dec base))
                    plan (aget ^objects pplan p)
                    pp (aget ^ints ppass p)
                    v (cond (>= pp 0) (aget vals (+ base pp))
                            plan (eval-plan plan vals sps eps (aget ^objects pnull p) base base endpos0)
                            :else (aget vals (dec top)))
                    sp (if (> n 0) (aget sps base) endpos0)
                    ep (if (> n 0) (aget eps (dec top)) sp)]
                (if (aget ^objects pstart p)
                  v
                  (let [g (aget ^ints goto-table (+ (* (aget st (dec base)) nn) (aget ^ints plhs p)))]
                    (aset st base (int g)) (aset vals base v) (aset sps base sp) (aset eps base ep)
                    (recur st vals sps eps (inc base) tk tsp tep err))))
              (pos? a)
              (do (aset st top (int (dec a)))
                  (if err
                    ;; the error terminal shifted (its cell the lookahead's positions, Engine.shift's env.triple), error mode kept
                    (do (aset vals top :unit) (aset sps top tsp) (aset eps top tep)
                        (recur st vals sps eps (inc top) tk tsp tep true))
                    (do (aset vals top (if (> (count tk) 1) (nth tk 1) :unit))
                        (aset sps top tsp) (aset eps top tep)
                        (if (identical? (nth tk 0) :EOF)
                          (recur st vals sps eps (inc top) tk tsp tep false)
                          (let [tk2 (lex/token lb)]
                            (recur st vals sps eps (inc top) tk2 (lex/start-p lb) (lex/curr-p lb) false))))))
              ;; in error mode no action on the error terminal: Parser.Error (Parse.wrap's Other at the lookahead)
              err (throw (ex-info "Syntax error" (syntax-error-data "Syntax error" [tsp tep false])))
              ;; Engine.initiate: error-handling mode
              :else (recur st vals sps eps top tk tsp tep true))))))))

(defn parse
  "The bytes of a file parsed as kind (:impl, :intf, :toplevel): [:ok tree] or [:error kind message loc sub], the
  message with its break hints (arbace.repr.ocaml.report), sub the report's sub-messages [text loc]"
  [^bytes bytes fname kind]
  (binding [ds/*state* (ds/new-state)]
    (let [lb (lex/new-lexbuf bytes fname)
          start (get t/starts (case kind :impl "implementation" :intf "interface" :toplevel "use_file"))]
      (try
        (let [tree (run lb start)]
          ;; Parse.wrap: Docstrings.warn_bad_docstrings after a parse that succeeds
          (when lex/*warn*
            (doseq [[k loc] (ds/bad-docstrings)] (lex/warn! (case k :unattached :docstring-unattached :docstring-ambiguous) loc)))
          [:ok tree])
        (catch arbace.lang.ExceptionInfo ex
          (let [d (ex-data ex)]
            (case (:ocaml-error d)
              :lexer [:error :lexer (:message d) (:loc d) (vec (:sub d))]
              :syntax [:error :syntax (:message d) (:loc d) (vec (:sub d))]
              ;; Parse.wrap: an Escape_error is a syntax error at the current token
              :escape [:error :syntax "Syntax error" [(lex/start-p lb) (lex/curr-p lb) false] []]
              (throw ex))))))))

(defn dump-form
  "The helper's dump of a file (ocdump --mode parse [--loc] [--intf] [--use-file] --file FNAME) as its tree"
  [^bytes bytes fname kind with-loc]
  (binding [ast/*with-loc* with-loc]
    (let [r (parse bytes fname kind)]
      (if (= :ok (first r))
        (ast/top-form kind (second r) fname)
        (let [[_ k msg lc] r] (ast/error-form k (report/message msg) lc))))))

(defn dump
  "The helper's dump text of a file"
  [^bytes bytes fname kind with-loc]
  (binding [ast/*with-loc* with-loc]
    (ast/dump-text (dump-form bytes fname kind with-loc))))

(defn layout-form
  "The text of ocdump's layout dump of items (strings and (comment ..) (doc ..) lists)"
  [items fname]
  (ast/dump-text (ast/layout-form items fname)))

(defn error-text
  "The text of the helper's error form (msg with its break hints)"
  [kind msg lc]
  (ast/dump-text (ast/error-form kind (report/message msg) lc)))

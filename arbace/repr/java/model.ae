;; or visit www.oracle.com if you need additional information or have any
;; questions.

(ns arbace.repr.java.model
  "The converter's interface to the model behind attribution's answers (doc/classes/JAVA-FRONTEND-SURVEY.md,
  JFS75 (b), \"As built: JFS75 (b)\"): every read that arbace.repr.java.convert and arbace.repr.java.resolve
  make of a symbol, a type or an annotation value that arbace.repr.java.attr answered, over either of two
  models, as arbace.repr.java.tree is over either tree:

    javac's   Symbol, Type, Types, Attribute: javac on Arbace's answers (the attributed JCTrees')
    native    arbace.repr.java.decls's symbols (local entries, fields, methods, classes, type
              variables: maps by identity) and types (data), the native provider's answers
              (arbace.repr.java.nattr), without javac

  Each read dispatches on its argument's model. With the native provider (attr/*provider*), the
  symbols a unit declares are always the native ones (nattr/canon: javac's symbol of a declaration
  of the unit, met in a higher tier's answer, a member's owner or a type's class, is its native
  twin's), so that identity is one model's; a relation of a native type with a javac one (the same
  erasure, a subtype) is answered in the native model, the javac operand named in the native
  registry (`nativize`); a read the native tiers cannot answer (a `var`'s inferred type, the javac
  name of a local class, the members tier's inheritance and hiding of a method, a package's classes
  as javac's ClassFinder lists them) asks javac's symbol of the same declaration (`javac-of`: by its
  declaration's twin, or by name), a bridge. With the native provider each read is counted by its
  name and how it was answered (:native, :javac, :bridge; nattr/read!), for attr-check's share."
  (:require [arbace.repr.java.decls :as d]
            [arbace.repr.java.forms :as f]
            [arbace.repr.java.javac-hook :as hook]
            [arbace.repr.java.attr :as attr]
            [arbace.repr.java.nattr :as na]
            [arbace.repr.java.expr :as ex]
            [arbace.repr.java.overload :as ov]
            [arbace.string :as str])
  (:import [arbace.repr.java.sym Sym]))

;;; ------------------------------------------------------------------------------------------
;;; The models

(defn nsym? "A native symbol?" [x] (instance? Sym x))

(def ^:private prim-kws #{:int :long :short :byte :char :float :double :boolean :void})

(defn ntype?
  "A native type? (a primitive keyword, :null, or a type map; not the converter's markers :lit-int,
  :type)"
  [x]
  (or (contains? prim-kws x) (identical? x :null) (and (map? x) (some? (:k x)))))

(defn native? "Of the native model (a symbol, a type, an annotation's value or compound)?" [x]
  (or (nsym? x) (ntype? x) (and (map? x) (or (:c x) (:const x) (:class x) (:enum x) (:array x) (:compound x) (:error x)))))

(defn- p [] attr/*provider*)

(defmacro ^:private rd
  "Count read `k` answered as `o` (:native, :javac, :bridge) when the native provider is on."
  [k o]
  `(when-let [pr# attr/*provider*]
     ~@(cond (= o :native) nil
             (keyword? o) [`(when d/*no-javac* (d/javac-needed! ~(str "the model's read " k " (" (name o) ")")))]
             :else [`(when (and d/*no-javac* (not= ~o :native)) (d/javac-needed! (str ~(str "the model's read " k " (") (name ~o) ")")))])
     (na/read! pr# ~k ~o)))

(defn canon
  "`s` in the unit's model: the native symbol of a declaration of the unit for javac's symbol of it
  (with the native provider), else `s`."
  [s]
  (if-let [pr (p)] (na/canon pr s) s))

(defn reg [] (:reg (p)))

(defn javac-of
  "javac's symbol of the declaration of native symbol `s` (a bridge): by its declaration's twin, else
  (a class, a member of a class) by name in javac's Symtab."
  [s]
  (let [pr (p)]
    (case (:sk s)
      :local (na/rl-local pr s)
      :class (na/rl-class pr s)
      :field (na/rl-field pr s)
      :method (na/rl-method pr s)
      (throw (ex-info (str "repr/java model: no javac symbol for " s) {})))))

;;; ------------------------------------------------------------------------------------------
;;; Native types: javac's readings of them

(defn- nclass? [t] (and (map? t) (identical? :class (:k t))))
(defn- string-class? [c] (= "java.lang.String" (:flat c)))

(defn- nerasure*
  "Types.erasure's mapping of a native type (an array's own type annotations kept, its element's
  class type's dropped; a class type without arguments)."
  [t]
  (cond
    (keyword? t) t
    :else
    (case (:k t)
      :array (assoc t :e (nerasure* (:e t)))
      :class (d/ctype (:c t) [] (when (:outer t) (nerasure* (:outer t))))
      :tvar (nerasure* (first (d/tvar-bounds (:tv t))))
      :wild (nerasure* (case (:bk t) :extends (:t t) (d/object-type (reg))))
      :inter (nerasure* (first (:ts t)))
      t)))

(defn- nerasure
  "Types.erasure of native type `t`: a primitive and String are their own (their type annotations
  kept), else the mapping."
  [t]
  (if (or (keyword? t) (and (nclass? t) (string-class? (:c t)))) t (nerasure* t)))

(declare nativize)

(defn- nsame-erased?
  "Are erased native types `a` and `b` the same type (Types.isSameType of erasures)?"
  [a b]
  (cond
    (or (keyword? a) (keyword? b)) (identical? a b)
    :else (let [ka (:k a)]
            (and (identical? ka (:k b))
                 (case ka
                   :class (identical? (:c a) (:c b))
                   :array (nsame-erased? (:e a) (:e b))
                   :null true
                   false)))))

(def ^:private prim-supers
  "JLS 4.10.1: the direct supertypes of the primitive types."
  {:byte #{:short} :short #{:int} :char #{:int} :int #{:long} :long #{:float} :float #{:double}})

(defn- prim-sub? [a b]
  (or (identical? a b) (boolean (some #(prim-sub? % b) (prim-supers a)))))

(defn- nsubtype-erased?
  "Types.isSubtype of erased native types."
  [a b]
  (cond
    (keyword? a) (cond (identical? a :null) (not (keyword? b))
                       (keyword? b) (prim-sub? a b)
                       :else false)
    (keyword? b) false
    :else
    (case (:k a)
      :null (not (keyword? b))
      :class (and (nclass? b) (na/sub-class? (:c a) (:c b)))
      :array (cond
               (= :array (:k b)) (let [ea (:e a) eb (:e b)]
                                   (if (or (keyword? ea) (keyword? eb)) (identical? ea eb) (nsubtype-erased? ea eb)))
               (nclass? b) (contains? #{"java.lang.Object" "java.lang.Cloneable" "java.io.Serializable"} (:flat (:c b)))
               :else false)
      false)))

;;; ------------------------------------------------------------------------------------------
;;; Symbols

(defn sym? [x] (or (hook/jsym? x) (nsym? x)))

(defn kind
  "The symbol's kind as javac's Kinds.Kind names it: VAR, MTH, TYP, PCK, ..."
  [s]
  (if (nsym? s)
    (do (rd :model/kind :native)
        (case (:sk s) (:local :field) "VAR" :method "MTH" (:class :tvar) "TYP" :package "PCK" :module "MDL" "NIL"))
    (do (rd :model/kind :javac) (hook/call-fixed! :model/kind s))))

(defn sname "The symbol's name (a string)." [s]
  (if (nsym? s) (do (rd :model/name :native) (:name s)) (do (rd :model/name :javac) (hook/call-fixed! :model/sname s))))

(defn sstr "The symbol as javac's toString gives it (a package's full name)." [s]
  (if (nsym? s) (do (rd :model/name :native) (:name s)) (do (rd :model/name :javac) (str s))))

(declare local-flags)

(defn flags
  "The symbol's flags as javac's (a long)."
  ^long [s]
  (if (nsym? s)
    (do (rd :model/flags :native)
        (case (:sk s)
          :local (local-flags s)
          :field (d/field-flags s)
          :method (d/method-flags s)
          :class (d/class-flags s)
          0))
    (do (rd :model/flags :javac) (long (hook/call-fixed! :model/flags s)))))

(defn has-flag? [s flag] (not (zero? (bit-and (flags s) (long flag)))))

(defn- local-flags
  "A native local entry's flags as javac's (its modifiers' checked, PARAMETER, HASINIT, a resource's
  FINAL, a multi-catch parameter's FINAL | UNION; a pattern variable's its modifiers' with HASINIT)."
  ^long [e]
  (na/local-flags e))

(defn- nowner [s]
  (case (:sk s)
    (:field :method) (:owner s)
    :class (or (d/outer s) (when-not (:local? s) ::package))
    nil))

(defn static?
  "Symbol.isStatic: STATIC, or a member of an interface that is not a method (nor `this`)."
  [s]
  (if (nsym? s)
    (do (rd :model/static :native)
        (or (d/has? (flags s) d/STATIC)
            (let [o (nowner s)]
              (and (nsym? o) (= :class (:sk o)) (d/interface? o) (not= :method (:sk s)) (not= "this" (:name s))))))
    (do (rd :model/static :javac) (hook/call-fixed! :model/static? s))))

(defn owner
  "The symbol's owner (a field's or a method's class; a member class's outer class)."
  [s]
  (if (nsym? s)
    (let [o (nowner s)]
      (if (nsym? o)
        (do (rd :model/owner :native) o)
        (do (rd :model/owner :bridge) (canon (hook/call-fixed! :model/owner (javac-of s))))))
    (do (rd :model/owner :javac) (canon (hook/call-fixed! :model/owner s)))))

(defn class-sym? [s]
  (if (or (nil? s) (nsym? s)) (do (rd :model/class? :native) (= :class (:sk s))) (do (rd :model/class? :javac) (hook/call-fixed! :model/class-sym? s))))

(defn method-sym? [s]
  (if (or (nil? s) (nsym? s)) (do (rd :model/class? :native) (= :method (:sk s))) (do (rd :model/class? :javac) (hook/jmethod-sym? s))))

(defn local?
  "Is the symbol a local variable (or parameter, pattern variable): a variable owned by a method or
  a variable, not by a class or package?"
  [s]
  (if (nsym? s)
    (do (rd :model/local? :native) (= :local (:sk s)))
    (do (rd :model/local? :javac) (hook/call-fixed! :model/local? s))))

(defn anonymous? [c]
  (if (nsym? c) (do (rd :model/anonymous? :native) (boolean (:anon? c))) (do (rd :model/anonymous? :javac) (hook/call-fixed! :model/anonymous? c))))

(defn local-class? [c]
  (if (nsym? c) (do (rd :model/local-class? :native) (d/local-class? c)) (do (rd :model/local-class? :javac) (hook/call-fixed! :model/local-class? c))))

(defn interface? [c]
  (if (nsym? c) (do (rd :model/interface? :native) (d/interface? c)) (do (rd :model/interface? :javac) (hook/call-fixed! :model/interface? c))))

(defn simple-name "The symbol's simple name (getSimpleName; an anonymous class's \"\")." [s]
  (if (nsym? s) (do (rd :model/simple-name :native) (:name s)) (do (rd :model/simple-name :javac) (hook/call-fixed! :model/simple-name s))))

(defn- local-flat
  "A local class's flat name as javac numbers it (arbace.repr.java.expr/local-flat, JFS91 (b)),
  checked against javac's once per class (the fact :names/local-class): the native name when equal,
  else javac's (a bridge; a difference counted)."
  [c]
  (let [^java.util.Map m (:local-flats (p))
        hit (locking m (.get m c))]
    (or hit
        (when d/*no-javac*
          ;; a read without javac: the native numbering alone (JFS111 (b))
          (let [nn (or (ex/local-flat (p) c) (d/javac-needed! "a local class's flat name"))
                r [:native nn]]
            (na/record! (p) :names/local-class :native (:tree c) nn nil)
            (locking m (.put m c r) (.put ^java.util.Map (:flat-locals (p)) nn c))
            r))
        (let [jn (hook/call-fixed! :model/flat-name (javac-of c))
              nn (try (ex/local-flat (p) c) (catch Throwable e (if (:arbace.repr.java.decls/decline (ex-data e)) nil (throw e))))
              r (cond (nil? nn) [:bridge jn] (= nn jn) [:native nn] :else [:bridge jn])]
          (na/record! (p) :names/local-class (case (first r) :native :equal :bridge (if nn :differ :declined))
                      (:tree c) nn jn)
          (locking m (.put m c r) (.put ^java.util.Map (:flat-locals (p)) (second r) c))
          r))))

(defn binary-name
  "The binary name of class `c`, renamed for output (a local class's as javac numbers it, local-flat)."
  [c]
  (if (nsym? c)
    (if (d/local-class? c)
      (let [[k n] (local-flat c)] (rd :model/binary-name k) (f/*rename* n))
      (do (rd :model/binary-name :native) (f/*rename* (:flat c))))
    (do (rd :model/binary-name :javac) (hook/call-fixed! :model/binary-name c))))

(defn flat-name
  "The flat name of class `c`, not renamed (resolution's names; a local class's local-flat)."
  [c]
  (if (nsym? c)
    (if (d/local-class? c)
      (let [[k n] (local-flat c)] (rd :model/binary-name k) n)
      (do (rd :model/binary-name :native) (:flat c)))
    (do (rd :model/binary-name :javac) (hook/call-fixed! :model/flat-name c))))

(defn package-name
  "The renamed name of the package of class `c`, or of package `c`."
  [c]
  (if (nsym? c)
    (do (rd :model/package :native) (f/*rename* (if (= :package (:sk c)) (:name c) (:pkg (if (= :class (:sk c)) c (:owner c))))))
    (do (rd :model/package :javac) (hook/call-fixed! :model/package-name c))))

(defn package-of
  "The name of the package of symbol `s` (not renamed)."
  [s]
  (if (nsym? s)
    (do (rd :model/package :native) (:pkg (if (= :class (:sk s)) s (:owner s))))
    (do (rd :model/package :javac) (hook/call-fixed! :model/package-of s))))

(defn outermost
  "Symbol.outermostClass: the top-level class enclosing the symbol."
  [s]
  (if (nsym? s)
    (do (rd :model/outermost :native) (d/outermost (if (= :class (:sk s)) s (:owner s))))
    (do (rd :model/outermost :javac) (canon (hook/call-fixed! :model/outermost s)))))

;;; Variables

(defn stype
  "The symbol's type (`.type`): a variable's declared type (a `var`'s inferred one, a multi-catch
  parameter's union, javac's: a bridge), a class's own type."
  [s]
  (if (nsym? s)
    (case (:sk s)
      :local (let [t (d/vartype-of (:env s) (:decl s))
                   ;; a `var`'s type: its initializer's when it is the types tier's (JN9b)
                   t (if (or (nil? t) (= :union (:k t)))
                       ;; a multi-catch parameter's: the lub of its alternatives (JN9d)
                       (try (ex/local-type (p) s) (catch Throwable _ t))
                       t)]
               ;; an implicit lambda parameter's type is inferred, a multi-catch parameter's the least
               ;; upper bound of its alternatives, a var's of a poly initializer: javac's
               (if (and t (not= :union (:k t)))
                 (do (rd :model/type :native) t)
                 (do (rd :model/type :bridge) (hook/call-fixed! :model/stype (javac-of s)))))
      :field (do (rd :model/type :native) (d/field-type s))
      :class (do (rd :model/type :native) (d/this-type s))
      (throw (ex-info (str "repr/java model: no type of " s) {})))
    (do (rd :model/type :javac) (hook/call-fixed! :model/stype s))))

(defn verasure
  "The erasure of variable `s`'s type (`.erasure`)."
  [s]
  (if (nsym? s)
    (let [t (stype s)]
      (if (hook/jtype? t) (hook/call-fixed! :model/erasure t) (nerasure t)))
    (do (rd :model/erasure :javac) (hook/call-fixed! :model/verasure s))))

(defn- var-constant
  "The constant value of `var` local entry `e` (d/local-constant's at its inferred type), or nil."
  [e]
  (let [dl (:decl e)]
    (when (and (:init dl) (d/has? (long (get-in dl [:mods :flags])) d/FINAL))
      (let [t (ex/local-type (p) e)]
        (when (or (keyword? t) (and (map? t) (= :class (:k t)) (= "java.lang.String" (:flat (:c t)))))
          (when-let [[k v] (d/const-value (:env e) (:init dl))]
            (second (d/const-as k v t))))))))

(defn const-value
  "A final local's constant value (`.getConstValue`), nil when it has none."
  [s]
  (if (nsym? s)
    (if (and (= :local (:sk s)) (nil? (d/vartype-of (:env s) (:decl s))))
      ;; a `var` local's: Attr's lazy constant value at its inferred type (JFS112 (b)), checked
      ;; against javac's (:types/var-constant)
      (let [nv (try (var-constant s)
                    (catch Throwable e (if (:arbace.repr.java.decls/decline (ex-data e)) ::declined (throw e))))]
        (cond
          d/*no-javac* (if (identical? nv ::declined)
                         (d/javac-needed! "declined :types/var-constant")
                         (do (rd :model/const-value :native) (na/record! (p) :types/var-constant :native (:decl s) nil nil) nv))
          :else (let [jv (hook/call-fixed! :model/const-value (javac-of s))]
                  (cond
                    (identical? nv ::declined) (do (rd :model/const-value :bridge)
                                                   (na/record! (p) :types/var-constant :declined (:decl s) "a var's type" nil))
                    (= nv jv) (do (rd :model/const-value :native) (na/record! (p) :types/var-constant :equal (:decl s) nv jv))
                    :else (do (rd :model/const-value :bridge) (na/record! (p) :types/var-constant :differ (:decl s) (pr-str nv) (pr-str jv))))
                  jv)))
      (do (rd :model/const-value :native) (second (d/local-constant s))))
    (do (rd :model/const-value :javac) (hook/call-fixed! :model/const-value s))))

;;; Methods

(defn- nmtype [m] (d/method-type m))

(defn mparams "The declared parameter types of method `m` (`.type`'s)." [m]
  (if (nsym? m) (do (rd :model/method-type :native) (:params (nmtype m)))
      (do (rd :model/method-type :javac) (hook/call-fixed! :model/mparams m))))

(defn mret "The declared return type of method `m`." [m]
  (if (nsym? m) (do (rd :model/method-type :native) (:ret (nmtype m)))
      (do (rd :model/method-type :javac) (hook/call-fixed! :model/mret m))))

(defn mtparam-names "The names of method `m`'s type parameters." [m]
  (if (nsym? m) (do (rd :model/method-type :native) (mapv :name (:tparams (nmtype m))))
      (do (rd :model/method-type :javac) (hook/call-fixed! :model/tparam-names m))))

(defn erased-params "The erased parameter types of method `m` (`.erasure`'s)." [m]
  (if (nsym? m) (do (rd :model/erasure :native) (mapv nerasure (:params (nmtype m))))
      (do (rd :model/erasure :javac) (hook/call-fixed! :model/erased-params m))))

(defn erased-ret "The erased return type of method `m`." [m]
  (if (nsym? m) (do (rd :model/erasure :native) (nerasure (:ret (nmtype m))))
      (do (rd :model/erasure :javac) (hook/call-fixed! :model/erased-ret m))))

(defn param-syms "Method `m`'s parameters' symbols (`.params`; a compact constructor's too)." [m]
  (if (nsym? m)
    (do (rd :model/params :native)
        (vec (for [pd (:params (:tree m))] (:local (na/answer (p) pd)))))
    (do (rd :model/params :javac) (mapv canon (hook/call-fixed! :model/params m)))))

(defn default-value
  "An annotation element method's default value (an annotation value of its model), or nil."
  [m]
  (if (nsym? m)
    (do (rd :model/default-value :native)
        (when-let [dv (:defaultValue (:tree m))]
          (d/annotation-value (d/method-env m) (:ret (nmtype m)) dv)))
    (do (rd :model/default-value :javac) (hook/call-fixed! :model/default-value m))))

(defn sig-poly?
  "Types.isSignaturePolymorphic of the method's base symbol: a native method of MethodHandle or
  VarHandle taking one Object[]."
  [m]
  (if (nsym? m)
    (do (rd :model/sig-poly :native)
        (let [m (or (:sig-poly-of m) m)
              ps (:params (nmtype m))]
          (boolean (and (d/has? (d/method-flags m) d/NATIVE)
                        (#{"java.lang.invoke.MethodHandle" "java.lang.invoke.VarHandle"} (:flat (:owner m)))
                        (= 1 (count ps))
                        (= :array (:k (first ps)))
                        (let [e (:e (first ps))] (and (nclass? e) (= "java.lang.Object" (:flat (:c e)))))))))
    (do (rd :model/sig-poly :javac) (hook/call-fixed! :model/sig-poly? m))))

;;; Classes

(defn member-classes "Class `c`'s member classes (its members that are classes)." [c]
  (if (nsym? c)
    (do (rd :model/members :native) (vec (vals (:classes (d/members c)))))
    (do (rd :model/members :javac) (mapv canon (hook/call-fixed! :model/member-classes c)))))

(defn field-names "The names of class `c`'s fields." [c]
  (if (nsym? c)
    (do (rd :model/members :native) (mapv :name (:fields (d/members c))))
    (do (rd :model/members :javac) (hook/call-fixed! :model/field-names c))))

(defn has-field? "Does class `c` declare a field named `n`?" [c n]
  (if (nsym? c)
    (do (rd :model/members :native) (boolean (seq (d/fields-named c n))))
    (do (rd :model/members :javac) (hook/call-fixed! :model/has-field? c n))))

(defn tparam-names "The names of class `c`'s type parameters." [c]
  (if (nsym? c)
    (do (rd :model/tparams :native) (mapv :name (d/class-tparams c)))
    (do (rd :model/tparams :javac) (hook/call-fixed! :model/tparam-names c))))

(defn- anon-of-diamond?
  "A native anonymous class of a diamond (its supertype inferred)?"
  [c]
  (and (:anon? c) (= :TYPEAPPLY (get-in c [:newclass :clazz :tag]))
       (empty? (get-in c [:newclass :clazz :arguments]))))

(defn class-interfaces
  "Class `c`'s interfaces (getInterfaces; an anonymous class of a diamond's inferred, JN9d: javac's
  when the inference tier declines it, a bridge)."
  [c]
  (if (nsym? c)
    (if-let [x (try (d/class-interfaces c) (catch Throwable e (if (:arbace.repr.java.decls/decline (ex-data e)) nil (throw e))))]
      (do (rd :model/supertypes :native) x)
      (do (rd :model/supertypes :bridge) (hook/call-fixed! :model/class-interfaces (javac-of c))))
    (do (rd :model/supertypes :javac) (hook/call-fixed! :model/class-interfaces c))))

(defn class-superclass
  "Class `c`'s superclass type (getSuperclass; an anonymous class of a diamond's inferred, JN9d)."
  [c]
  (if (nsym? c)
    (let [x (try [(d/class-supertype c)] (catch Throwable e (if (:arbace.repr.java.decls/decline (ex-data e)) nil (throw e))))]
      (if x
        (do (rd :model/supertypes :native) (first x))
        (do (rd :model/supertypes :bridge) (hook/call-fixed! :model/class-superclass (javac-of c)))))
    (do (rd :model/supertypes :javac) (hook/call-fixed! :model/class-superclass c))))

(defn iterable-arg
  "The erasure of the type argument of type `t`'s Iterable supertype (Lower.visitIterableForeachLoop's
  iteratorTarget: asSuper of its upper bound, the argument erased), nil when it has none (raw): what
  javac casts a for-each's element to before a primitive binding's unboxing (JCS115 (a), JN9f)."
  [t]
  (if (hook/jtype? t)
    (do (rd :model/supertypes :javac) (hook/call-fixed! :model/iterable-arg t))
    (do (rd :model/supertypes :native)
        (when-let [a (some-> (d/as-super t (d/class-named (reg) "java.lang.Iterable")) :args first)]
          (d/erasure a)))))

(defn record-varargs?
  "Is record `c`'s last component of variable arity?"
  [c]
  (if (nsym? c)
    (do (rd :model/members :native)
        (let [comps (filter #(and (= :VARDEF (:tag %)) (d/has? (get-in % [:mods :flags]) d/RECORD)) (:defs (:tree c)))]
          (boolean (some-> (last comps) (get-in [:mods :flags]) (d/has? d/VARARGS)))))
    (do (rd :model/members :javac) (hook/call-fixed! :model/record-varargs? c))))

(declare javac-pkg-class-names)

(defn pkg-class-names
  "The simple names of the classes of package `pkg` as javac's ClassFinder lists them (its members:
  the classes of the package's files on every location, which only javac's world knows: a bridge
  for a native package)."
  [pkg]
  (if (nsym? pkg)
    ;; the native listing (JFS112 (b)), checked against javac's once per unit (:names/package-classes)
    (let [nn (d/package-class-names (reg) (:name pkg))]
      (rd :model/package-members :native)
      (if d/*no-javac*
        (do (na/record! (p) :names/package-classes :native {:tag :TOPLEVEL :pos 0} nil nil) nn)
        (let [jn (into #{} (remove #(str/includes? % "$")) (javac-pkg-class-names pkg))]
          (na/record! (p) :names/package-classes (if (= nn jn) :equal :differ) {:tag :TOPLEVEL :pos 0}
                      (vec (sort (remove jn nn))) (vec (sort (remove nn jn))))
          (if (= nn jn) nn jn))))
    (javac-pkg-class-names pkg)))

(defn- javac-pkg-class-names
  "pkg-class-names by javac's ClassFinder (its package symbol, or a native package's of the run's
  module)."
  [pkg]
  (when-not (nsym? pkg) (rd :model/package-members :javac))
  (hook/call-fixed! :model/pkg-class-names pkg (when (nsym? pkg) (:module (reg)))))

;;; ------------------------------------------------------------------------------------------
;;; Types

(defn type? "A type of either model (not the converter's markers :lit-int, :null, :type)." [t]
  (or (hook/jtype? t) (and (not (identical? t :null)) (ntype? t))))

(defn tag-name
  "The type's tag as javac's TypeTag names it (INT, CLASS, ARRAY, TYPEVAR, WILDCARD, BOT, VOID, ...)."
  [t]
  (cond
    (and (map? t) (identical? :ctype (:k t))) (tag-name (:t t))
    (hook/jtype? t)
    (do (rd :model/tag :javac) (hook/call-fixed! :model/tag-name t))
    :else
    (do (rd :model/tag :native)
        (if (keyword? t)
          (if (identical? t :null) "BOT" (str/upper-case (name t)))
          (case (:k t)
            (:class :inter :union) "CLASS" :array "ARRAY" :tvar "TYPEVAR" :wild "WILDCARD" :null "BOT" "NONE")))))

(defn prim? [t]
  (if (hook/jtype? t) (do (rd :model/tag :javac) (hook/call-fixed! :model/prim? t))
      (do (rd :model/tag :native) (and (contains? prim-kws t) (not (identical? t :void))))))

(defn void? [t]
  (if (hook/jtype? t) (do (rd :model/tag :javac) (hook/call-fixed! :model/void? t)) (do (rd :model/tag :native) (identical? t :void))))

(defn array? [t]
  (if (hook/jtype? t) (do (rd :model/tag :javac) (hook/call-fixed! :model/array? t)) (do (rd :model/tag :native) (and (map? t) (= :array (:k t))))))

(defn elemtype [t]
  (if (hook/jtype? t) (do (rd :model/elemtype :javac) (hook/call-fixed! :model/elemtype t)) (do (rd :model/elemtype :native) (:e t))))

(defn class-type?
  "A class type (javac's ClassType: intersections and unions too)?"
  [t]
  (if (hook/jtype? t) (do (rd :model/tag :javac) (hook/call-fixed! :model/class-type? t))
      (do (rd :model/tag :native) (and (map? t) (contains? #{:class :inter :union} (:k t))))))

(defn tvar? "A type variable (a captured one too)?" [t]
  (if (hook/jtype? t) (do (rd :model/tag :javac) (hook/call-fixed! :model/tvar? t)) (do (rd :model/tag :native) (and (map? t) (= :tvar (:k t))))))

(defn captured? [t]
  (if (hook/jtype? t) (do (rd :model/tag :javac) (hook/call-fixed! :model/captured? t))
      (do (rd :model/tag :native) (boolean (and (map? t) (= :tvar (:k t)) (:captured (:tv t)))))))

(defn wildcard? [t]
  (if (hook/jtype? t) (do (rd :model/tag :javac) (hook/call-fixed! :model/wildcard? t)) (do (rd :model/tag :native) (and (map? t) (= :wild (:k t))))))

(defn wild-kind "A wildcard's bound kind: :unbound, :extends, :super." [t]
  (if (hook/jtype? t)
    (do (rd :model/wildcard :javac) (hook/call-fixed! :model/wild-kind t))
    (do (rd :model/wildcard :native) (:bk t))))

(defn wild-bound "A wildcard's bound (`.type`)." [t]
  (if (hook/jtype? t) (do (rd :model/wildcard :javac) (hook/call-fixed! :model/wild-bound t)) (do (rd :model/wildcard :native) (:t t))))

(defn components "The components of an intersection type, else nil." [t]
  (if (hook/jtype? t) (do (rd :model/tag :javac) (hook/call-fixed! :model/components t))
      (do (rd :model/tag :native) (when (and (map? t) (= :inter (:k t))) (seq (:ts t))))))

(defn tsym
  "The type's symbol (`.tsym`): a class type's class, a type variable's symbol; nil for a native
  primitive or array type."
  [t]
  (if (hook/jtype? t)
    (do (rd :model/tsym :javac) (canon (hook/call-fixed! :model/tsym t)))
    (do (rd :model/tsym :native) (when (map? t) (case (:k t) :class (:c t) :tvar (:tv t) nil)))))

(defn type-args "A class type's type arguments." [t]
  (if (hook/jtype? t) (do (rd :model/type-args :javac) (hook/call-fixed! :model/type-args t))
      (do (rd :model/type-args :native) (seq (:args t)))))

(defn enclosing-type
  "A class type's enclosing type (an inner class's), nil (javac's noType) when none."
  [t]
  (if (hook/jtype? t)
    (do (rd :model/type-args :javac) (hook/call-fixed! :model/enclosing-type t))
    (do (rd :model/type-args :native) (when (nclass? t) (:outer t)))))

(defn allparams?
  "Has class type `t` type arguments, its own or its enclosing types' (`.allparams` not empty)?"
  [t]
  (if (hook/jtype? t)
    (do (rd :model/type-args :javac) (hook/call-fixed! :model/allparams? t))
    (do (rd :model/type-args :native) (loop [t t] (cond (not (nclass? t)) false (seq (:args t)) true :else (recur (:outer t)))))))

(defn type-anns "The type's type annotations (javac's TypeCompounds or native compounds)." [t]
  (if (hook/jtype? t)
    (do (rd :model/type-anns :javac) (hook/call-fixed! :model/type-anns t))
    (do (rd :model/type-anns :native) (when (map? t) (seq (:anns t))))))

(defn own-type?
  "Is class type `t` its class's own type, the class's type variables its arguments
  (Types.isSameType with `.type` of its symbol)?"
  [t]
  (if (hook/jtype? t)
    (do (rd :model/same-type :javac) (hook/call-fixed! :model/own-type? t))
    (do (rd :model/same-type :native)
        (= (na/ntype (na/strip-anns t)) (na/ntype (d/this-type (:c t)))))))

(defn erasure "The type's erasure (Types.erasure)." [t]
  (cond
    (hook/jtype? t) (do (rd :model/erasure :javac) (hook/call-fixed! :model/erasure t))
    (ntype? t) (do (rd :model/erasure :native) (nerasure t))
    :else (hook/call-fixed! :model/erasure t)))

(defn- mixed? [a b] (not= (hook/jtype? a) (hook/jtype? b)))

(defn nativize
  "Erased javac type `t` as an erased native type (its classes named in the native registry: the
  unit's by their declarations' twins, the others by flat name), nil when the registry has none."
  [t]
  (if-not (hook/jtype? t)
    t
    (do (rd :model/nativize :native) (hook/call-fixed! :model/nativize t))))

(defn same?
  "Are the erasures of types `a` and `b` the same (javac's types, or native: a javac operand named in
  the native model)?"
  [a b]
  (cond
    (not (and (type? a) (type? b))) false
    (not (or (ntype? a) (ntype? b))) (do (rd :model/same :javac) (hook/call-fixed! :model/same? a b))
    :else (let [na (nativize (if (hook/jtype? a) (hook/call-fixed! :model/erasure a) (nerasure a)))
                nb (nativize (if (hook/jtype? b) (hook/call-fixed! :model/erasure b) (nerasure b)))]
            (rd :model/same :native)
            (boolean (and na nb (nsame-erased? na nb))))))

(defn subtype?
  "Is the erasure of `a` a subtype of the erasure of `b`?"
  [a b]
  (cond
    (not (and (type? a) (type? b))) false
    (not (or (ntype? a) (ntype? b))) (do (rd :model/subtype :javac) (hook/call-fixed! :model/subtype? a b))
    :else (let [na (nativize (if (hook/jtype? a) (hook/call-fixed! :model/erasure a) (nerasure a)))
                nb (nativize (if (hook/jtype? b) (hook/call-fixed! :model/erasure b) (nerasure b)))]
            (rd :model/subtype :native)
            (boolean (and na nb (nsubtype-erased? na nb))))))

(def ^:private box-names
  {:boolean "Boolean" :byte "Byte" :short "Short" :int "Integer" :long "Long" :char "Character"
   :float "Float" :double "Double" :void "Void"})

(def ^:private unbox-names (into {} (for [[k v] box-names :when (not= k :void)] [(str "java.lang." v) k])))

(defn boxed "The class type primitive `t` boxes to." [t]
  (if (hook/jtype? t)
    (do (rd :model/box :javac) (hook/call-fixed! :model/boxed t))
    (do (rd :model/box :native) (d/ctype (d/lang (reg) (box-names t))))))

(defn unboxed "The primitive type wrapper type `t` unboxes to, or nil." [t]
  (cond
    (hook/jtype? t) (do (rd :model/box :javac) (hook/call-fixed! :model/unboxed t))
    (ntype? t) (do (rd :model/box :native)
                   (let [t (if (= :tvar (:k t)) (nerasure t) t)]
                     (when (nclass? t) (unbox-names (:flat (:c t))))))
    :else nil))

(defn object? "Is the erasure of `t` Object?" [t]
  (if (ntype? t)
    (do (rd :model/same :native) (let [e (nerasure t)] (and (nclass? e) (= "java.lang.Object" (:flat (:c e))))))
    (do (rd :model/same :javac) (hook/call-fixed! :model/object? t))))

(defn string-type? "Is the erasure of `t` String?" [t]
  (if (ntype? t)
    (do (rd :model/same :native) (let [e (nerasure t)] (and (nclass? e) (string-class? (:c e)))))
    (do (rd :model/same :javac) (hook/call-fixed! :model/string-type? t))))

(defn prim-sym [t]
  (if (hook/jtype? t) (do (rd :model/tag :javac) (hook/call-fixed! :model/prim-sym t)) (do (rd :model/tag :native) (symbol (name t)))))

(def ^:private prim-rank
  "The widening order of the primitive types' tags (arbace.repr.java.jtypes' prim-rank)."
  {"BYTE" 1 "SHORT" 2 "CHAR" 2 "INT" 3 "LONG" 4 "FLOAT" 5 "DOUBLE" 6})

(defn widens? "Java's widening primitive conversion from `a` to `b` (or identity)." [a b]
  (let [ta (tag-name a) tb (tag-name b)]
    (or (= ta tb)
        (and (prim-rank ta) (prim-rank tb)
             (< (prim-rank ta) (prim-rank tb))
             (not (and (= ta "CHAR") (#{"SHORT"} tb)))
             (not (and (#{"BYTE" "SHORT"} ta) (= tb "CHAR")))))))

(defn enum-type? "Is `t` a type whose class is an enum?" [t]
  (cond
    (hook/jtype? t) (do (rd :model/flags :javac) (hook/call-fixed! :model/enum-type? t))
    (nclass? t) (do (rd :model/flags :native) (d/has? (d/class-flags (:c t)) d/ENUM))
    :else false))

(defn closure-classes
  "The classes of the supertypes of type `t` (Types.closure: itself, its superclasses and their
  interfaces; an interface's Object)."
  [t]
  (if (hook/jtype? t)
    (do (rd :model/closure :javac) (mapv canon (hook/call-fixed! :model/closure-classes t)))
    (do (rd :model/closure :native)
        (let [seen (java.util.LinkedHashSet.)]
          (letfn [(walk [t] (when (and (nclass? t) (.add seen (:c t)))
                              (walk (d/supertype t))
                              (run! walk (d/interfaces t))))]
            (walk (d/this-type (:c t))))
          (vec seen)))))

(defn object-type-of
  "The type Object of the model of `t`."
  [t]
  (if (ntype? t) (d/object-type (reg)) (hook/call-fixed! :model/object-type)))

;;; Members by name

(defn methods-named
  "Class `c`'s own methods named `n`: [{:sym m :flags fl :erased [t ...] :ret t}] (getSymbolsByName)."
  [c n]
  (if (nsym? c)
    (do (rd :model/members :native)
        (vec (for [m (:methods (d/members c)) :when (= n (:name m))] m)))
    (do (rd :model/members :javac) (mapv canon (hook/call-fixed! :model/methods-named c n)))))

(defn type-str
  "The erased type `t` as javac's toString gives it (java.util.Map.Entry, int[])."
  [t]
  (if (hook/jtype? t)
    (do (rd :model/type-str :javac) (str t))
    (do (rd :model/type-str :native)
        (letfn [(qn [c] (if-let [o (d/outer c)] (str (qn o) "." (:name c)) (if (:local? c) (:name c) (:flat c))))
                (s [t] (cond (identical? t :null) "<nulltype>"
                             (keyword? t) (name t)
                             (= :array (:k t)) (str (s (:e t)) "[]")
                             (nclass? t) (qn (:c t))
                             :else (str t)))]
          (s t)))))

(defn member-of?
  "Symbol.isMemberOf: is field or method `s` a member of class `c` (its owner, or inherited by c and
  not hidden in it)? Natively for native symbols (a method's since JN9b, JFS90); a native one with a
  javac one a bridge."
  [s c]
  (cond
    (and (nsym? s) (= :field (:sk s)) (nsym? c))
    (do (rd :model/member-of :native) (na/field-member-of? s c))
    (and (nsym? s) (= :method (:sk s)) (nsym? c))
    (do (rd :model/member-of :native) (na/method-member-of? s c))
    ;; a javac method (the overload tier's answer) of a native class: the method in the native model
    (and (hook/jmethod-sym? s) (nsym? c) (ex/nmethod (p) canon s))
    (do (rd :model/member-of :native) (na/method-member-of? (ex/nmethod (p) canon s) c))
    (or (nsym? s) (nsym? c))
    (do (rd :model/member-of :bridge)
        (hook/call-fixed! :model/member-of? (if (nsym? s) (javac-of s) s) (if (nsym? c) (javac-of c) c)))
    :else (do (rd :model/member-of :javac) (hook/call-fixed! :model/member-of? s c))))

;;; ------------------------------------------------------------------------------------------
;;; Annotations: compounds and values

(defn compound-class "Annotation `c`'s class." [c]
  (if (hook/jattribute? c) (do (rd :model/annotation :javac) (canon (hook/call-fixed! :model/compound-class c)))
      (do (rd :model/annotation :native) (:c c))))

(defn compound-values "Annotation `c`'s values: [[name value] ...]." [c]
  (if (hook/jattribute? c)
    (do (rd :model/annotation :javac) (hook/call-fixed! :model/compound-values c))
    (do (rd :model/annotation :native) (:values c))))

(defn retention
  "The retention of annotation `c`'s class as Types.getRetention gives it: \"SOURCE\", \"CLASS\"
  (the default), \"RUNTIME\"."
  [c]
  (if (hook/jattribute? c)
    (do (rd :model/retention :javac) (hook/call-fixed! :model/retention c))
    (do (rd :model/retention :native) (na/retention (:c c)))))

(defn value-kind "An annotation value's kind: :const, :class, :enum, :array, :compound, :error." [v]
  (if (hook/jattribute? v)
    (do (rd :model/annotation :javac) (hook/call-fixed! :model/value-kind v))
    (do (rd :model/annotation :native)
        (cond (:const v) :const (:class v) :class (:enum v) :enum (:array v) :array (:compound v) :compound :else :error))))

(defn const-of
  "A constant annotation value: [tag-name value], value as javac's constValue (an int for a char, a
  boolean, a byte or a short)."
  [v]
  (if (hook/jattribute? v)
    (do (rd :model/annotation :javac) (hook/call-fixed! :model/const-of v))
    (do (rd :model/annotation :native)
        (let [[k x] (:const v)] [(if (= k :string) "CLASS" (str/upper-case (name k))) x]))))

(defn class-of "A class annotation value's type." [v]
  (if (hook/jattribute? v) (do (rd :model/annotation :javac) (hook/call-fixed! :model/class-of v))
      (do (rd :model/annotation :native) (:class v))))

(defn enum-of "An enum annotation value: [class constant-name]." [v]
  (if (hook/jattribute? v)
    (do (rd :model/annotation :javac) (let [[c n] (hook/call-fixed! :model/enum-of v)] [(canon c) n]))
    (do (rd :model/annotation :native) [(:enum v) (:name v)])))

(defn array-of "An array annotation value's values." [v]
  (if (hook/jattribute? v) (do (rd :model/annotation :javac) (hook/call-fixed! :model/array-of v))
      (do (rd :model/annotation :native) (:values v))))

(defn nested-of "A nested annotation value's compound." [v]
  (if (hook/jattribute? v) (do (rd :model/annotation :javac) v) (do (rd :model/annotation :native) (:compound v))))

;;; ------------------------------------------------------------------------------------------
;;; The higher tiers' types (javac's: instantiated method types, qualifiers' types, functional
;;; descriptors, constants of expressions), read here for the count

(defn- nmtype? [t] (and (map? t) (identical? :mtype (:k t))))

(defn method-type?
  "An instantiated method type (javac's MethodType, or the native {:k :mtype})?"
  [t]
  (if (nmtype? t)
    (do (rd :model/method-type :native) true)
    (do (rd :model/method-type :javac) (and (hook/jtype? t) (hook/call-fixed! :model/method-type? t)))))

(defn mt-params "An instantiated method type's parameter types." [t]
  (if (nmtype? t) (do (rd :model/method-type :native) (:params t))
      (do (rd :model/method-type :javac) (hook/call-fixed! :model/mt-params t))))

(defn mt-ret "An instantiated method type's return type." [t]
  (if (nmtype? t) (do (rd :model/method-type :native) (:ret t))
      (do (rd :model/method-type :javac) (hook/call-fixed! :model/mt-ret t))))

(defn without-first-param
  "Method type `t` without its first parameter (an inner class's creation's outer instance)."
  [t]
  (if (nmtype? t)
    (do (rd :model/method-type :native) (assoc t :params (vec (rest (:params t)))))
    (do (rd :model/method-type :javac) (hook/call-fixed! :model/without-first-param t))))

(defn skip-type-vars "Types.skipTypeVars (no capture)." [t]
  (if (hook/jtype? t)
    (do (rd :model/skip-type-vars :javac) (hook/call-fixed! :model/skip-type-vars t))
    (do (rd :model/skip-type-vars :native)
        (loop [t t]
          (if (and (map? t) (= :tvar (:k t)))
            (let [bs (d/tvar-bounds (:tv t))] (recur (if (= 1 (count bs)) (first bs) {:k :inter :ts (vec bs)})))
            t)))))

(defn compound? "An intersection type (Type.isCompound)?" [t]
  (if (hook/jtype? t) (do (rd :model/tag :javac) (hook/call-fixed! :model/compound? t))
      (do (rd :model/tag :native) (and (map? t) (= :inter (:k t))))))

(defn array-type "The array type of element type `t`." [t]
  (if (hook/jtype? t) (do (rd :model/array-type :javac) (hook/call-fixed! :model/array-type t))
      (do (rd :model/array-type :native) (d/array-of t))))

(defn unboxed-type
  "Types.unboxedType: the primitive type a wrapper unboxes to, else a type that is not primitive (nil
  for a native one)."
  [t]
  (if (hook/jtype? t) (do (rd :model/box :javac) (hook/call-fixed! :model/unboxed-type t)) (unboxed t)))

(defn type-const
  "An expression type's constant value (`.constValue`; a native constant expression's type
  {:k :ctype :t type :const [kind value]}, its value as javac's: an Integer for an int, short, byte,
  char or boolean)."
  [t]
  (cond
    (hook/jtype? t) (do (rd :model/type-const :javac) (hook/call-fixed! :model/type-const t))
    (nil? t) nil
    :else (do (rd :model/type-const :native)
              (when (and (map? t) (identical? :ctype (:k t)))
                (let [[k v] (:const t)]
                  (case k
                    (:int :short :byte :char :boolean) (Integer/valueOf (int v))
                    :long (Long/valueOf (long v))
                    :float (Float/valueOf (unchecked-float v))
                    :double (Double/valueOf (double v))
                    v))))))

(defn descriptor-type
  "The functional descriptor of functional interface type `t` (Types.findDescriptorType; a native
  type's the inference tier's, arbace.repr.java.overload's, JN9d)."
  [t]
  (if (hook/jtype? t)
    (do (rd :model/descriptor :javac) (hook/call-fixed! :model/descriptor-type t))
    (do (rd :model/descriptor :native)
        (let [mt (ov/descriptor-type (:reg attr/*provider*) t)]
          (assoc mt :k :mtype)))))

(defn descriptor-sym
  "The method of the functional descriptor of erased functional interface type `t`
  (Types.findDescriptorSymbol of its class)."
  [t]
  (if (hook/jtype? t)
    (do (rd :model/descriptor :javac) (hook/call-fixed! :model/descriptor-sym t))
    (do (rd :model/descriptor :native) (ov/find-descriptor (:reg attr/*provider*) (:c t)))))

(defn pkg-name "Package `pkg`'s name (not renamed)." [pkg]
  (if (nsym? pkg) (do (rd :model/package :native) (:name pkg))
      (do (rd :model/package :javac) (hook/call-fixed! :model/pkg-name pkg))))

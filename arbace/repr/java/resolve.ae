(ns arbace.repr.java.resolve
  "The Java forms compiler's overload resolution (doc/classes/SPEC.md §5.6, §7.3), asked by the
  converter to decide where a call needs param-tags. The compiler's front end (arbace.classes.analyze
  and what it requires; no back end) resolves over class infos made from javac's symbols, so the
  classes being converted need not be loadable, and arguments are stubs with the types the
  converted forms will have."
  (:require [arbace.classes.analyze :as a]
            [arbace.classes.env :as env]
            [arbace.repr.java.jtypes :as jt]
            [arbace.string :as str])
  (:import [com.sun.tools.javac.code Type Type$ArrayType Symbol Symbol$ClassSymbol
            Symbol$MethodSymbol Flags]))

;;; ------------------------------------------------------------------------------------------
;;; javac symbols as the compiler's class infos (arbace.classes.env)

(defn internal
  "The internal name of class symbol `c` (not renamed: resolution is on the source's names)."
  [^Symbol$ClassSymbol c]
  (str/replace (str (.flatName c)) "." "/"))

(defn desc
  "The descriptor of the erasure of javac type `t`."
  [^Type t]
  (let [t (jt/erasure t)]
    (case (jt/tag-name t)
      "BOOLEAN" "Z" "BYTE" "B" "SHORT" "S" "CHAR" "C" "INT" "I" "LONG" "J" "FLOAT" "F"
      "DOUBLE" "D" "VOID" "V"
      "ARRAY" (str "[" (desc (.elemtype ^Type$ArrayType t)))
      "CLASS" (str "L" (internal (.tsym t)) ";")
      "BOT" :null
      (throw (ex-info (str "No descriptor for type " t) {:type (str t)})))))

(defn- method-flags
  "Class file access flags of method symbol `m` (javac keeps varargs and bridge elsewhere)."
  [^Symbol m]
  (let [f (.flags m)]
    (bit-or (bit-and f 0x1D3F)
            (if (zero? (bit-and f Flags/VARARGS)) 0 0x80)
            (if (zero? (bit-and f Flags/BRIDGE)) 0 0x40))))

;; The symbols resolution works on are javac's own, whatever the run met before (doc/classes/
;; JAVA-FRONTEND-SURVEY.md, "As built: JFS70"). javac's Symtab keeps a class symbol per flat name and
;; module; besides a nested class's own symbol, under the module of its package, ClassReader enters
;; one under the key of each other module whose class file names it in its InnerClasses attribute
;; (ClassReader.readInnerClasses, enterClass(currentModule, name, outer)), with no class file:
;; completing one fails ("class file for ... not found"), and once failed it stays without members
;; and supertypes. Symtab/getClassesForName gives them all, in the
;; order of a HashMap keyed by the modules' identities: until JFS70 its first was taken, and the
;; class infos were kept by name per run, from whichever symbol was met first, so that a pin
;; (EnumSet.of(JavaFileObject.Kind.SOURCE), Stream.of(DocTree.Kind.values())) depended on the files
;; converted before and on the run. Now every symbol is taken as javac's own (`canonical`), a name
;; is resolved among javac's own symbols alone (`find-class`), and a class info is made only from a
;; symbol that completes (`class-info`): each answer is a function of the name and the platform.

(defn- module-of [^Symbol c] (.modle (.packge c)))

(defn- canonical
  "javac's own symbol for class symbol `c`: the one Symtab keeps for c's flat name under the module
  of c's package (c itself when it is that one), else, for a local or anonymous class (which Symtab
  does not hold), c when it is the class Check compiles under that name; nil when there is none."
  ^Symbol$ClassSymbol [^Symbol$ClassSymbol c]
  (when c
    (when-let [m (module-of c)]
      (let [n (.flatName c)]
        (or (.getClass jt/*syms* m n)
            (when (identical? c (.getCompiled jt/*check* m n)) c))))))

;; The module of the class whose call is resolved (choice's `from`): the one whose symbol a name
;; that several modules define resolves to first.
(def ^:dynamic ^:private *module* nil)

(defn- find-class
  "javac's own symbol of the class of internal name `n`: among those Symtab holds for the name, the
  ones that are their module's own; when several modules define it, *module*'s, else the first by
  module name; else the local or anonymous class Check compiles in *module* under the name. nil
  when javac knows no such class."
  ^Symbol$ClassSymbol [n]
  (let [fname (jt/jname (str/replace n "/" "."))
        cs (filter #(identical? % (canonical %)) (.getClassesForName jt/*syms* fname))]
    (if (seq cs)
      (or (first (filter #(identical? *module* (module-of %)) cs))
          (first (sort-by #(str (module-of %)) cs)))
      (when *module* (.getCompiled jt/*check* ^com.sun.tools.javac.code.Symbol$ModuleSymbol *module* fname)))))

;; Per javac run (Symtab): javac's own class symbol -> its class info (nil: it does not complete).
(def ^:private registries (java.util.WeakHashMap.))

(defn- registry []
  (locking registries
    (or (.get registries jt/*syms*)
        (let [r {:infos (atom {})}]
          (.put registries jt/*syms* r)
          r))))

(defn- class-of-type [^Type t]
  (when (and t (= "CLASS" (jt/tag-name t))) (canonical (.tsym (jt/erasure t)))))

(defn- outer-class [^Symbol$ClassSymbol c]
  (let [o (.owner c)]
    (when-not (instance? com.sun.tools.javac.code.Symbol$PackageSymbol o)
      (canonical (.enclClass o)))))

(defn- completed?
  "Did class symbol `c` complete (completing it now if it has not)? A symbol whose completion
  failed, now or before, is javac's erroneous class: no members, no supertypes."
  [^Symbol$ClassSymbol c]
  (try
    (.complete c)
    (not (or (= "ERR" (str (.kind c))) (.isErroneous (.type c))))
    (catch com.sun.tools.javac.code.Symbol$CompletionFailure _ false)))

(defn class-info
  "The compiler's class info of class symbol `c` (only what resolution and access need), made from
  javac's own symbol for it once it completed; nil when it does not."
  [^Symbol$ClassSymbol c]
  (when-let [c (canonical c)]
    (let [infos (:infos (registry))
          e (find @infos c)]
      (if e
        (val e)
        (let [n (internal c)
              info (when (completed? c)
                     (let [iface? (.isInterface c)
                           sup (when-not iface? (class-of-type (.getSuperclass c)))]
                       {:name n
                        :flags (bit-and (.flags c) 0x761F)
                        :interface? iface?
                        :super (some-> sup internal)
                        :interfaces (vec (keep #(some-> (class-of-type %) internal) (.getInterfaces c)))
                        :nest-host (internal (.outermostClass c))
                        :outer (some-> (outer-class c) internal)
                        :fields []
                        :methods (vec (for [^Symbol s (.getSymbols (.members c))
                                            :when (instance? Symbol$MethodSymbol s)
                                            :let [ps (.getParameterTypes (.erasure s jt/*types*))
                                                  r (.getReturnType (.erasure s jt/*types*))]]
                                        {:name (str (.name s))
                                         :desc (str "(" (apply str (map desc ps)) ")" (desc r))
                                         :flags (method-flags s) :owner n}))}))]
          (swap! infos assoc c info)
          info)))))

(def ^:private lookup
  (reify arbace.lang.ILookup
    (valAt [this k] (.valAt this k nil))
    (valAt [_ k nf]
      (or (when (string? k) (some-> (find-class k) class-info)) nf))))

(def ^:private compile-set (reify arbace.lang.IDeref (deref [_] lookup)))

;;; ------------------------------------------------------------------------------------------
;;; Arguments

(defn literal-node
  "The node of an integer literal, or of a conditional whose values are the integer literals
  `vals` (a long to Clojure, narrowed by the context, §5.4)."
  [vals]
  (let [c (fn [v] {:op :const :type "J" :val (long v) :literal true})]
    (if (= 1 (count vals))
      (c (first vals))
      (reduce (fn [e v] {:op :if :then (c v) :else e :type "J"})
              (c (last vals)) (rest (reverse vals))))))

(defn arg-node
  "A stub node for an argument whose converted form has type `t` (a javac type, :null, or
  :lit-int with its literal values `vals`). nil when it cannot be made."
  [t vals]
  (cond
    (= t :null) {:op :const :type :null :val nil}
    (= t :lit-int) (when (seq vals) (literal-node vals))
    (instance? Type t) {:op :local :type (desc t)}
    :else nil))

;;; ------------------------------------------------------------------------------------------
;;; Resolution

(defn choice
  "What the compiler chooses for a call written without param-tags: kind :instance (receiver
  of static type `site`), :static (class `site`) or :ctor (of class `site`), from class `from`
  (symbols), method name `mname`, argument stubs `args`. Returns [descriptor varargs?], or nil
  when the compiler finds no method or an ambiguous call."
  [kind ^Symbol$ClassSymbol from site mname args]
  (when (every? some? args)
    (binding [env/*compile-set* compile-set
              *module* (module-of from)]
      (let [fname (internal from)
            sname (if (instance? Type site)
                    (if (= "ARRAY" (jt/tag-name site)) "java/lang/Object" (internal (.tsym (jt/erasure site))))
                    (internal site))]
        (try
          (let [cands (case kind
                        :instance (a/instance-candidates fname sname mname)
                        :static (a/static-candidates fname sname mname)
                        :ctor (a/ctor-candidates fname sname))]
            (when (seq cands)
              (let [[m va] (a/select-method {} cands (vec args) mname nil)]
                [(:desc m) (boolean va)])))
          (catch arbace.lang.ExceptionInfo e
            (if (:arbace/compile-error (ex-data e)) nil (throw e))))))))

(defn- params-part [^String d] (subs d 0 (inc (.indexOf d ")"))))

(defn pin-needed?
  "True unless the compiler, given the call without param-tags, chooses javac's method `m` in
  the same arity mode (`varargs?`: the variable arguments are written unpacked)."
  [kind from site ^Symbol$MethodSymbol m args varargs?]
  (let [[d va] (choice kind from site (str (.name m)) args)
        ps (.getParameterTypes (.erasure m jt/*types*))
        want (str "(" (apply str (map desc ps)) ")")]
    (not (and d (= (params-part d) want) (= va (boolean varargs?))))))

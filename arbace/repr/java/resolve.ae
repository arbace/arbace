(ns arbace.repr.java.resolve
  "The Java forms compiler's overload resolution (doc/classes/SPEC.md §5.6, §7.3), asked by the
  converter to decide where a call needs param-tags. The compiler's front end (arbace.classes.analyze
  and what it requires; no back end) resolves over class infos made from javac's symbols, so the
  classes being converted need not be loadable, and arguments are stubs with the types the
  converted forms will have. Since JN10 (JFS130 (a)) javac's symbols' class infos are javac's half's
  (arbace.repr.java.javac-model), reached through arbace.repr.java.javac-hook; this namespace names no
  javac class."
  (:require [arbace.classes.analyze :as a]
            [arbace.classes.env :as env]
            [arbace.repr.java.model :as md]
            [arbace.repr.java.decls :as d]
            [arbace.repr.java.attr :as attr]
            [arbace.repr.java.nattr :as na]
            [arbace.repr.java.javac-hook :as hook]
            [arbace.string :as str]))

;;; ------------------------------------------------------------------------------------------
;;; javac symbols as the compiler's class infos (arbace.classes.env)

(defn internal
  "The internal name of class symbol `c` (not renamed: resolution is on the source's names), of
  either model (arbace.repr.java.model)."
  [c]
  (if (hook/jsym? c)
    (hook/call-fixed! :resolve/internal c)
    (str/replace (md/flat-name c) "." "/")))

(defn desc
  "The descriptor of the erasure of type `t` (of either model)."
  [t]
  (let [t (md/erasure t)]
    (case (md/tag-name t)
      "BOOLEAN" "Z" "BYTE" "B" "SHORT" "S" "CHAR" "C" "INT" "I" "LONG" "J" "FLOAT" "F"
      "DOUBLE" "D" "VOID" "V"
      "ARRAY" (str "[" (desc (md/elemtype t)))
      "CLASS" (str "L" (internal (if (hook/jtype? t) (hook/call-fixed! :resolve/tsym t) (md/tsym t))) ";")
      "BOT" :null
      (throw (ex-info (str "No descriptor for type " t) {:type (str t)})))))

;; The symbols resolution works on are javac's own, whatever the run met before (doc/classes/
;; JAVA-FRONTEND-SURVEY.md, "As built: JFS70"). javac's Symtab keeps a class symbol per flat name and
;; module; besides a nested class's own symbol, under the module of its package, ClassReader enters
;; one under the key of each other module whose class file names it in its InnerClasses attribute
;; (ClassReader.readInnerClasses, enterClass(currentModule, name, outer)), with no class file:
;; completing one fails ("class file for ... not found"), and once failed it stays without members
;; and supertypes. Symtab/getClassesForName gives them all, in the
;; order of a HashMap keyed by the modules' identities: until JFS70 its first was taken, and the
;; class infos were kept by name per run, from whichever symbol was met first, so that a pin
;; (EnumSet.of(JavaFileObject.Kind.SOURCE), Stream.of(DocTree.Kind.values())) depended on the files
;; converted before and on the run. Now every symbol is taken as javac's own (`canonical`), a name
;; is resolved among javac's own symbols alone (`find-class`), and a class info is made only from a
;; symbol that completes (`class-info`): each answer is a function of the name and the platform.
;;
;; Since JN10 (JFS130 (a)) that part is javac's half's (arbace.repr.java.javac-model, the section
;; arbace.repr.java.resolve's javac branches): `lookup` asks it for a class info by internal name
;; (:resolve/class-info: find-class, then class-info), and `choice` for the module of `from`
;; (:resolve/module-of) when javac answers the unit.

;; The module of the class whose call is resolved (choice's `from`): the one whose symbol a name
;; that several modules define resolves to first.
(def ^:dynamic *module* nil)

(def ^:private nregistries (java.util.WeakHashMap.))

(defn- nclass-info
  "class-info's of native class `c` (a read without javac, JFS111 (b), \"As built: JN9e\"): the class
  infos from the native model (arbace.repr.java.decls), as javac's symbols give them."
  [c]
  (let [p attr/*provider*
        reg (:reg p)
        ^java.util.Map infos (locking nregistries
                               (or (.get nregistries reg)
                                   (let [m (java.util.HashMap.)] (.put nregistries reg m) m)))
        hit (locking infos (.get infos c))]
    (if hit
      (if (identical? hit ::none) nil hit)
      (let [n (internal c)
            cls-of (fn [t] (when (and (map? t) (= :class (:k t))) (:c t)))
            iface? (d/interface? c)
            ms (binding [d/*anon-ctor* (when-let [h @na/anon-ctor-hook] #(h p %))] (d/members-all c))
            info {:name n
                  :flags (bit-and (d/class-flags c) 0x761F)
                  :interface? iface?
                  :super (when-not iface? (some-> (cls-of (d/supertype (d/this-type c))) internal))
                  :interfaces (vec (keep #(some-> (cls-of %) internal) (d/interfaces (d/this-type c))))
                  :nest-host (internal (d/outermost c))
                  :outer (some-> (d/encl-class c) internal)
                  :fields []
                  :methods (vec (for [m (:methods ms)
                                      :let [ps (md/erased-params m)
                                            r (md/erased-ret m)
                                            f (long (d/method-flags m))]]
                                  {:name (:name m)
                                   :desc (str "(" (apply str (map desc ps)) ")" (desc r))
                                   :flags (bit-or (bit-and f 0x1D3F)
                                                  (if (zero? (bit-and f (long d/VARARGS))) 0 0x80)
                                                  (if (zero? (bit-and f (long d/BRIDGE))) 0 0x40))
                                   :owner n}))}]
        (locking infos (.put infos c info))
        info))))

(defn- nfind-class
  "find-class's in the native model: the class of internal name `n` (a local class's by the flat
  name the provider gave it)."
  [n]
  (let [p attr/*provider*
        flat (str/replace n "/" ".")]
    (or (locking (:flat-locals p) (.get ^java.util.Map (:flat-locals p) flat))
        (d/class-named (:reg p) flat))))

(def ^:private lookup
  (reify arbace.lang.ILookup
    (valAt [this k] (.valAt this k nil))
    (valAt [_ k nf]
      (or (when (string? k)
            (if attr/*provider*
              (some-> (nfind-class k) nclass-info)
              (hook/call-fixed! :resolve/class-info k)))
          nf))))

(def ^:private compile-set (reify arbace.lang.IDeref (deref [_] lookup)))

;;; ------------------------------------------------------------------------------------------
;;; Arguments

(defn literal-node
  "The node of an integer literal, or of a conditional whose values are the integer literals
  `vals` (a long to Clojure, narrowed by the context, §5.4)."
  [vals]
  (let [c (fn [v] {:op :const :type "J" :val (long v) :literal true})]
    (if (= 1 (count vals))
      (c (first vals))
      (reduce (fn [e v] {:op :if :then (c v) :else e :type "J"})
              (c (last vals)) (rest (reverse vals))))))

(defn arg-node
  "A stub node for an argument whose converted form has type `t` (a javac type, :null, or
  :lit-int with its literal values `vals`). nil when it cannot be made."
  [t vals]
  (cond
    (= t :null) {:op :const :type :null :val nil}
    (= t :lit-int) (when (seq vals) (literal-node vals))
    (md/type? t) {:op :local :type (desc t)}
    :else nil))

;;; ------------------------------------------------------------------------------------------
;;; Resolution

(defn choice
  "What the compiler chooses for a call written without param-tags: kind :instance (receiver
  of static type `site`), :static (class `site`) or :ctor (of class `site`), from class `from`
  (symbols), method name `mname`, argument stubs `args`. Returns [descriptor varargs?], or nil
  when the compiler finds no method or an ambiguous call."
  [kind from site mname args]
  (when (every? some? args)
    (binding [env/*compile-set* compile-set
              *module* (when-not attr/*provider* (hook/call-fixed! :resolve/module-of from))]
      (let [fname (internal from)
            sname (cond
                    (hook/jtype? site)
                    (hook/call-fixed! :resolve/site-name site)
                    (md/type? site)
                    (if (md/array? site) "java/lang/Object" (internal (md/tsym (md/erasure site))))
                    :else (internal site))]
        (try
          (let [cands (case kind
                        :instance (a/instance-candidates fname sname mname)
                        :static (a/static-candidates fname sname mname)
                        :ctor (a/ctor-candidates fname sname))]
            (when (seq cands)
              (let [[m va] (a/select-method {} cands (vec args) mname nil)]
                [(:desc m) (boolean va)])))
          (catch arbace.lang.ExceptionInfo e
            (if (:arbace/compile-error (ex-data e)) nil (throw e))))))))

(defn- params-part [^String d] (subs d 0 (inc (.indexOf d ")"))))

(defn pin-needed?
  "True unless the compiler, given the call without param-tags, chooses javac's method `m` in
  the same arity mode (`varargs?`: the variable arguments are written unpacked)."
  [kind from site m args varargs?]
  (let [[d va] (choice kind from site (md/sname m) args)
        ps (md/erased-params m)
        want (str "(" (apply str (map desc ps)) ")")]
    (not (and d (= (params-part d) want) (= va (boolean varargs?))))))

(ns arbace.repr.java.tree
  "The converter's interface to the tree (doc/classes/JAVA-FRONTEND-SURVEY.md, JFS7 (b), \"As built:
  JFS66 (b)\"): the syntax of a compilation unit, over either of its two representations, javac's
  `JCTree` objects (javac on Arbace's parse, which attribution then completes) or the native
  parser's trees as data (arbace.repr.java.parse: a map per node, javac's tags and field names,
  positions included). Every read of the tree's shape by arbace.repr.java.convert goes through
  here; what javac's attribution adds to a tree (symbols, types, chosen members, jump targets, flow)
  goes through arbace.repr.java.attr, keyed by position for the native trees.

  (tag t) javac's JCTree.Tag as a keyword (:IDENT, :PLUS_ASG, ...); (is? t :IDENT); the classes of
  tags javac's class hierarchy groups (statement?, binary?, unary?, assignop?, pattern?); (f t :k)
  the field :k under javac's name (a tree, a list of trees, a name, flags); (start t), (end t)
  TreeInfo.getStartPos and getEndPos; TreeInfo's helpers (skip-parens, tree-name, full-name,
  diamond?); (children t) the child trees in javac's field order (the order the converter walked
  javac's fields in by reflection).

  Since JN10 (JFS130 (a); doc/classes/JAVA-FRONTEND-SURVEY.md, \"As built: JN10 (write-ahead)\") this
  namespace names no javac class: it is in the read closure the shipped program embeds. Each function
  answers a native tree (a map) or nil itself; any other value (javac's JCTree) goes to javac's half,
  arbace.repr.java.javac-tree, through arbace.repr.java.javac-hook (the entry :tree/NAME, the function as
  it was before the split, both branches, so that on javac's tool every answer is the one it was); on the
  shipped program there is no such value."
  (:require [arbace.repr.java.parse :as parse]
            [arbace.repr.java.javac-hook :as hook]))

;;; ------------------------------------------------------------------------------------------
;;; Tags

(defmacro ^:private native-or
  "javac's half's entry :tree/NAME applied to args when x is javac's tree (jc?), else `native` (as the function
  before the split tested `instance? JCTree` first: any other value, a native tree, nil or a key that is no
  tree, took the native branch)."
  [x native entry & args]
  `(if (jc? ~x) (hook/call-fixed! ~entry ~@args) ~native))

(defn jc? "Is `t` one of javac's trees (not the native parser's data)?" [t]
  (if (or (nil? t) (map? t)) false (if-let [h (hook/hook :tree/jc?)] (boolean (h t)) false)))

(defn tree? "Is `x` a tree of either representation?" [x]
  (or (and (map? x) (contains? x :tag)) (jc? x)))

(defn tag
  "The tag of tree `t`, a keyword (javac's JCTree.Tag)."
  [t]
  (native-or t (get t :tag) :tree/tag t))

(defn tag-name "The tag's name, as javac's (str (.getTag t))." ^String [t] (name (tag t)))

(defn is? "Has tree `t` (nil allowed) tag `k`?" [t k] (and (some? t) (identical? k (tag t))))

(def binary-tags
  #{:OR :AND :BITOR :BITXOR :BITAND :EQ :NE :LT :GT :LE :GE :SL :SR :USR :PLUS :MINUS :MUL :DIV :MOD})
(def assignop-tags
  #{:BITOR_ASG :BITXOR_ASG :BITAND_ASG :SL_ASG :SR_ASG :USR_ASG :PLUS_ASG :MINUS_ASG :MUL_ASG
    :DIV_ASG :MOD_ASG})
(def unary-tags #{:POS :NEG :NOT :COMPL :PREINC :PREDEC :POSTINC :POSTDEC})
(def statement-tags
  "The tags of javac's JCStatement subclasses."
  #{:CLASSDEF :VARDEF :SKIP :BLOCK :DOLOOP :WHILELOOP :FORLOOP :FOREACHLOOP :LABELLED :SWITCH :CASE
    :SYNCHRONIZED :TRY :IF :EXEC :BREAK :YIELD :CONTINUE :RETURN :THROW :ASSERT})
(def pattern-tags #{:ANYPATTERN :BINDINGPATTERN :RECORDPATTERN})
(def loop-tags #{:WHILELOOP :DOLOOP :FORLOOP :FOREACHLOOP})

(defn binary? [t] (and (some? t) (contains? binary-tags (tag t))))
(defn assignop? [t] (and (some? t) (contains? assignop-tags (tag t))))
(defn unary? [t] (and (some? t) (contains? unary-tags (tag t))))
(defn statement? [t] (and (some? t) (contains? statement-tags (tag t))))
(defn pattern? [t] (and (some? t) (contains? pattern-tags (tag t))))
(defn loop? [t] (and (some? t) (contains? loop-tags (tag t))))
(defn expression?
  "A JCExpression (for the converter's uses: a lambda's or a rule case's body that is not a
  statement)."
  [t]
  (and (some? t) (not (statement? t))))

;;; ------------------------------------------------------------------------------------------
;;; Fields

(def scalar-fields
  "The fields the converter reads that hold no tree (names, flags, booleans), by tag."
  {:name [:IDENT :SELECT :VARDEF :METHODDEF :CLASSDEF :TYPEPARAMETER :REFERENCE]
   :label [:LABELLED :BREAK :CONTINUE]
   :flags [:MODIFIERS :BLOCK]
   :isTransitive [:REQUIRES] :isStaticPhase [:REQUIRES] :staticImport [:IMPORT]})

(def tree-fields
  "Each tag's fields that hold trees (a tree, a list of trees; :dimAnnotations a list of lists), in
  javac's order: arbace.repr.java.parse's fields but the scalars."
  (let [scalar (fn [tg k]
                 (or (#{:name :staticImport :flags :bracePos :label :caseKind :declKind :typePos :typetag
                        :value :paramKind :mode :isTransitive :isStaticPhase} k)
                     (and (= k :kind) (not= tg :WILDCARD))))]
    (into {} (for [[tg fs] parse/fields]
               [tg (vec (remove #(and (scalar tg %) (not (and (= tg :YIELD) (= % :value)))) fs))]))))

(defn field
  "The field `k` (a keyword, javac's name) of tree `t`."
  [t k]
  (native-or t (get t k) :tree/field t k))

(defn f "The field `k` of tree `t` (field)." [t k] (field t k))

;;; ------------------------------------------------------------------------------------------
;;; What javac's tree classes give by methods: kinds, literal values

(defn var-decl?
  "Was the variable declaration `d` written with `var` (JCVariableDecl.declaredUsingVar)?"
  [d]
  (native-or d (identical? :VAR (get d :declKind)) :tree/var-decl? d))

(defn rule-case? "Is case `c` a rule (case L -> ...)?" [c]
  (native-or c (identical? :RULE (get c :caseKind)) :tree/rule-case? c))

(defn open-module? "Is module declaration `md` open (getModuleType)?" [md]
  (native-or md (identical? :OPEN (get md :kind)) :tree/open-module? md))

(def ^:private ANNOTATION 0x2000)
(def ^:private INTERFACE 0x200)
(def ^:private ENUM 0x4000)
(def ^:private RECORD (bit-shift-left 1 61))

(defn class-kind
  "JCClassDecl.getKind's name for class declaration `cd`, from its modifiers' flags as the parser
  wrote them (the kind bits are the parser's)."
  ^String [cd]
  (if (jc? cd)
    (hook/call-fixed! :tree/class-kind cd)
    (let [fl (long (get-in cd [:mods :flags]))]
      (cond
        (not (zero? (bit-and fl ANNOTATION))) "ANNOTATION_TYPE"
        (not (zero? (bit-and fl INTERFACE))) "INTERFACE"
        (not (zero? (bit-and fl ENUM))) "ENUM"
        (not (zero? (bit-and fl RECORD))) "RECORD"
        :else "CLASS"))))

(defn literal-value
  "The value of literal `t` as JCLiteral.getValue gives it: a Number for int and long, a Character
  for char, a Boolean, a Float, a Double, a String, nil."
  [t]
  (if (jc? t)
    (hook/call-fixed! :tree/literal-value t)
    (let [v (get t :value)]
      (case (get t :typetag)
        :INT (int v)
        :LONG (long v)
        :CHAR (char (int v))
        :BOOLEAN (not (zero? (long v)))
        :FLOAT (Float/intBitsToFloat (unchecked-int (Long/parseLong (subs v 1) 16)))
        :DOUBLE (Double/longBitsToDouble (Long/parseUnsignedLong (subs v 1) 16))
        :CLASS v
        :BOT nil))))

;;; ------------------------------------------------------------------------------------------
;;; Positions

(def ^:dynamic *end-positions*
  "The end positions of the javac compilation unit being converted (TreeInfo.getEndPos's table, an
  EndPosTable: javac's half reads it)."
  nil)

(defn start "TreeInfo.getStartPos." ^long [t]
  (if (jc? t) (long (hook/call-fixed! :tree/start t)) (long (get t :start))))

(defn end "TreeInfo.getEndPos, with the unit's end positions." ^long [t]
  (if (jc? t) (long (hook/call-fixed! :tree/end t)) (long (get t :end))))

(defn pos "The tree's pos." ^long [t]
  (if (jc? t) (long (hook/call-fixed! :tree/pos t)) (long (get t :pos))))

;;; ------------------------------------------------------------------------------------------
;;; TreeInfo's helpers

(defn skip-parens "TreeInfo.skipParens." [t]
  (if (jc? t)
    (hook/call-fixed! :tree/skip-parens t)
    (loop [t t] (if (is? t :PARENS) (recur (get t :expr)) t))))

(defn tree-name
  "TreeInfo.name: the name of an identifier, a selection or a type application's class, else nil
  (javac's Name, or the native trees' string; the converter takes its str)."
  [t]
  (if (jc? t)
    (hook/call-fixed! :tree/tree-name t)
    (case (tag t)
      (:IDENT :SELECT) (get t :name)
      :TYPEAPPLY (tree-name (get t :clazz))
      nil)))

(defn full-name "TreeInfo.fullName." [t]
  (if (jc? t)
    (hook/call-fixed! :tree/full-name t)
    (let [t (skip-parens t)]
      (case (tag t)
        :IDENT (get t :name)
        :SELECT (when-let [s (full-name (get t :selected))] (str s "." (get t :name)))
        nil))))

(defn diamond? "TreeInfo.isDiamond." [t]
  (if (jc? t)
    (hook/call-fixed! :tree/diamond? t)
    (case (tag t)
      :TYPEAPPLY (empty? (get t :arguments))
      :NEWCLASS (diamond? (get t :clazz))
      :ANNOTATED_TYPE (diamond? (get t :underlyingType))
      false)))

;;; ------------------------------------------------------------------------------------------
;;; Children

;; javac's reflection's order of each tag's class's public fields (jrt's Class.getFields: the class's own,
;; then its superclasses'), of the native tree's fields: generated from jdk26u's
;; src/jdk.compiler/share/classes/com/sun/tools/javac/tree/JCTree.java (JN10 write-ahead,
;; .tmp/jn10/fields.py and gen_order.ae), checked against the reflection by arbace.repr.java.javac-tree
;; when it loads on javac's tool (field-order-check).
(def field-order
  "For a tag, the native tree's fields in the order javac's reflection gives its class's fields (javac's
  half's children order), so that both representations are walked alike."
  {:AND [:lhs :rhs], :ANNOTATED_TYPE [:annotations :underlyingType], :ANNOTATION [:annotationType :args], :ANYPATTERN [], :APPLY [:typeargs :meth :args], :ASSERT [:cond :detail], :ASSIGN [:lhs :rhs], :BINDINGPATTERN [:var], :BITAND [:lhs :rhs], :BITAND_ASG [:lhs :rhs], :BITOR [:lhs :rhs], :BITOR_ASG [:lhs :rhs], :BITXOR [:lhs :rhs], :BITXOR_ASG [:lhs :rhs], :BLOCK [:stats], :BREAK [], :CASE [:labels :guard :stats :body], :CATCH [:param :body], :CLASSDEF [:mods :typarams :extending :implementing :permitting :defs], :COMPL [:arg], :CONDEXPR [:cond :truepart :falsepart], :CONSTANTCASELABEL [:expr], :CONTINUE [], :DEFAULTCASELABEL [], :DIV [:lhs :rhs], :DIV_ASG [:lhs :rhs], :DOLOOP [:body :cond], :EQ [:lhs :rhs], :ERRONEOUS [:errs], :EXEC [:expr], :EXPORTS [:qualid :moduleNames], :FOREACHLOOP [:var :expr :body], :FORLOOP [:init :cond :step :body], :GE [:lhs :rhs], :GT [:lhs :rhs], :IDENT [], :IF [:cond :thenpart :elsepart], :IMPORT [:qualid], :INDEXED [:indexed :index], :LABELLED [:body], :LAMBDA [:params :body], :LE [:lhs :rhs], :LITERAL [], :LT [:lhs :rhs], :METHODDEF [:mods :restype :typarams :recvparam :params :thrown :body :defaultValue], :MINUS [:lhs :rhs], :MINUS_ASG [:lhs :rhs], :MOD [:lhs :rhs], :MODIFIERS [:annotations], :MODULEDEF [:mods :qualId :directives], :MODULEIMPORT [:module], :MOD_ASG [:lhs :rhs], :MUL [:lhs :rhs], :MUL_ASG [:lhs :rhs], :NE [:lhs :rhs], :NEG [:arg], :NEWARRAY [:elemtype :dims :annotations :dimAnnotations :elems], :NEWCLASS [:encl :typeargs :clazz :args :def], :NOT [:arg], :OPENS [:qualid :moduleNames], :OR [:lhs :rhs], :PACKAGEDEF [:annotations :pid], :PARENS [:expr], :PATTERNCASELABEL [:pat], :PLUS [:lhs :rhs], :PLUS_ASG [:lhs :rhs], :POS [:arg], :POSTDEC [:arg], :POSTINC [:arg], :PREDEC [:arg], :PREINC [:arg], :PROVIDES [:serviceName :implNames], :RECORDPATTERN [:deconstructor :nested], :REFERENCE [:expr :typeargs], :REQUIRES [:moduleName], :RETURN [:expr], :SELECT [:selected], :SKIP [], :SL [:lhs :rhs], :SL_ASG [:lhs :rhs], :SR [:lhs :rhs], :SR_ASG [:lhs :rhs], :SWITCH [:selector :cases], :SWITCH_EXPRESSION [:selector :cases], :SYNCHRONIZED [:lock :body], :THROW [:expr], :TOPLEVEL [:defs], :TRY [:body :catchers :finalizer :resources], :TYPEAPPLY [:clazz :arguments], :TYPEARRAY [:elemtype], :TYPEBOUNDKIND [], :TYPECAST [:clazz :expr], :TYPEIDENT [], :TYPEINTERSECTION [:bounds], :TYPEPARAMETER [:bounds :annotations], :TYPETEST [:expr :pattern], :TYPEUNION [:alternatives], :TYPE_ANNOTATION [:annotationType :args], :USES [:qualid], :USR [:lhs :rhs], :USR_ASG [:lhs :rhs], :VARDEF [:mods :nameexpr :vartype :init], :WHILELOOP [:cond :body], :WILDCARD [:kind :inner], :YIELD [:value]})

(defn children
  "The child trees of tree `t` (either representation), in javac's field order; javac's include
  what attribution added (a constructor javac made, a `var`'s type)."
  [t]
  (if (jc? t)
    (hook/call-fixed! :tree/children t)
    (for [k (get field-order (get t :tag))
          :let [v (get t k)]
          c (cond (map? v) [v]
                  (vector? v) (filter map? v)
                  :else [])]
      c)))

(ns arbace.repr.java.javac-read
  "javac's half of arbace.repr.java (doc/classes/JAVA-FRONTEND-SURVEY.md, JN10 part 1, JFS130 (a); \"As
  built: JN10 (write-ahead)\", \"As built: JN10 part 1\"): the read with javac, javac on Arbace's analysis
  and the conversion of its attributed units (`convert-units`, `convert-one`, `native-units`), moved here
  verbatim from arbace.repr.java, which names no javac class (the read closure the shipped program
  embeds, JFS136 (a)) and reaches this through arbace.repr.java.javac-hook's entry :read/convert-units
  (arbace.repr.java/convert-units, and convert-units-nojavac's fallback). Loaded only where javac's
  classes are (javac's tool executable: arbace.repr.java's -main calls javac-hook's
  try-load-javac-half!); it loads the rest of javac's half (javac-tree, javac-attr, javac-model), so that
  every entry of the closure's javac branches is installed before a javac unit is converted."
  (:require [arbace.repr.java :as rj]
            [arbace.repr.java.javac :as javac]
            [arbace.repr.java.convert :as cv]
            [arbace.repr.java.jtypes :as jt]
            [arbace.repr.java.forms :as f]
            [arbace.repr.java.parse :as parse]
            [arbace.repr.java.attr :as attr]
            [arbace.repr.java.nattr :as nattr]
            [arbace.repr.java.javac-hook :as hook]
            [arbace.repr.java.javac-tree]
            [arbace.repr.java.javac-attr]
            [arbace.repr.java.javac-nattr]
            [arbace.repr.java.javac-model]))

(defn- convert-one
  "Convert javac's attributed unit `cu`, its own tree or (native?) the native parser's tree of its
  text with attribution by position (`nunit` its native unit, entered, when the native provider
  answers: `check` and `diffs` its outcomes' atoms); measured with `split?`. A unit, or a failure."
  [^com.sun.tools.javac.tree.JCTree$JCCompilationUnit cu full native? split? stats & [nunit check diffs]]
  (let [src (.getName (.getSourceFile cu))]
    (try
      (let [t0 (System/nanoTime)
            opts (if native?
                   (let [n (if nunit (:tree nunit) (parse/parse (javac/source-text cu) src))
                         idx (attr/index n cu)]
                     (swap! stats #(-> % (update :index/nodes (fnil + 0) (:nodes idx))
                                       (update :index/misses (fnil + 0) (count (:misses idx)))
                                       (update :index/synthetic (fnil + 0) (:synthetic idx))
                                       (update :index/flags-completed (fnil + 0) (:flags idx))
                                       (update :index/dropped (fnil + 0) (count (:dropped idx)))))
                     (when (seq (:misses idx))
                       (throw (ex-info (str "native tree: " (count (:misses idx)) " nodes without a javac node, the first "
                                            (first (:misses idx)))
                                       {})))
                     {:full full :tree n :index idx})
                   {:full full})
            prov (when nunit
                   (try (nattr/provider nunit (:index opts) check diffs)
                        (catch Throwable e
                          ;; the walk failed: javac answers this unit
                          (swap! check update-in [:nattr/walk :differ] (fnil inc 0))
                          (swap! diffs conj {:fact :nattr/walk :file src
                                             :native (str (.getName (class e)) ": " (.getMessage e))
                                             :trace (vec (take 8 (filter #(re-find #"arbace" %) (map str (.getStackTrace e)))))})
                          nil)))
            u (binding [attr/*measure* split?
                        attr/*counts* (when split? stats)
                        attr/*provider* prov]
                (let [u (cv/convert-unit cu opts)]
                  ;; the platform classes the unit's provider read, checked (JFS106 (b))
                  (when prov (nattr/check-platform-members! prov))
                  u))]
        ;; the model's reads (arbace.repr.java.model), by read and how answered
        (when prov (swap! check #(merge-with (partial merge-with +) % (nattr/reads prov))))
        (assoc u :source src :ms (quot (- (System/nanoTime) t0) 1000000)))
      (catch Throwable e
        {:failure true :source src
         :error (str (.getName (class e)) ": " (.getMessage e))
         :trace (vec (take 12 (filter #(re-find #"arbace" %) (map str (.getStackTrace e)))))}))))

(defn- native-units
  "The native units of javac's `units`, parsed and entered in a registry of the run (registry-units)."
  [units opts]
  (rj/registry-units (mapv (fn [^com.sun.tools.javac.tree.JCTree$JCCompilationUnit cu]
                          (let [src (.getName (.getSourceFile cu))]
                            [(parse/parse (javac/source-text cu) src) src]))
                        units)
                  opts))

(defn convert-units
  "Analyze the Java `files` with javac options `opts` and convert every compilation unit (in mode
  :full with `full`; `front` :javac, :native or :both, the trees the converter reads; measured with
  `split`; `attr-native`, the native provider answering the native trees' scope and declarations).
  Returns {:units [...] :failures [...] :errors [...] :stats {...}}, with :both also :native, the
  same of the native trees (and with `attr-native` its :attr-check and :attr-diffs)."
  [files opts rename & [full front split attr-native]]
  (let [front (or front :javac)
        {:keys [units context errors]} (javac/analyze files opts)
        stats (atom {})
        nstats (atom {})
        check (atom {})
        diffs (atom [])]
    (binding [jt/*types* (javac/types context)
              jt/*syms* (javac/symtab context)
              jt/*check* (com.sun.tools.javac.comp.Check/instance context)
              jt/*names* (com.sun.tools.javac.util.Names/instance context)
              f/*rename* (rj/rename-fn rename)]
      (let [nunits (when (and attr-native (not= front :javac)) (native-units units opts))
            run (fn [native? split? st]
                  (binding [cv/*stats* st]
                    (let [results (doall (map-indexed (fn [i cu]
                                                        (convert-one cu full native? split? st
                                                                     (when native? (get nunits i)) check diffs))
                                                      units))]
                      (cond-> {:units (vec (remove :failure results))
                               :failures (vec (filter :failure results))
                               :errors errors
                               :stats @st}
                        (and native? nunits) (assoc :attr-check @check :attr-diffs @diffs)))))]
        (case front
          :javac (run false split stats)
          :native (run true split stats)
          :both (assoc (run false false stats) :native (run true split nstats)))))))

(hook/install! {:read/convert-units convert-units})

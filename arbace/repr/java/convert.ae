(ns arbace.repr.java.convert
  "Java -> Java forms: converts javac's attributed compilation units into the forms of
  doc/classes/SPEC.md, making explicit what §7 lists. Since JFS66 (b) (doc/classes/JAVA-FRONTEND-SURVEY.md,
  \"As built: JFS66 (b)\") it reads the tree through arbace.repr.java.tree (javac's JCTrees or the native
  parser's trees as data) and asks attribution through arbace.repr.java.attr (javac's, by position for
  the native trees); the converted nodes are its frames (attr/framed), which the split measures."
  (:require [arbace.repr.java.forms :as f :refer [m+ tag member cref]]
            [arbace.repr.java.tree :as tr]
            [arbace.repr.java.attr :as attr]
            [arbace.repr.java.jtypes :as jt]
            [arbace.repr.java.model :as m :refer [erasure prim? same? subtype? tag-name]]
            [arbace.repr.java.resolve :as res]
            [arbace.repr.java.decls :as d]
            [arbace.string :as str])
  (:import [arbace.repr.java.forms CRef]
           [com.sun.tools.javac.tree JCTree JCTree$JCCompilationUnit JCTree$JCClassDecl
            JCTree$JCMethodDecl JCTree$JCVariableDecl JCTree$JCBlock JCTree$JCExpressionStatement
            JCTree$JCIf JCTree$JCWhileLoop JCTree$JCDoWhileLoop JCTree$JCForLoop
            JCTree$JCEnhancedForLoop JCTree$JCLabeledStatement JCTree$JCSwitch JCTree$JCCase
            JCTree$JCSwitchExpression JCTree$JCSynchronized JCTree$JCTry JCTree$JCCatch
            JCTree$JCConditional JCTree$JCBreak JCTree$JCYield JCTree$JCContinue JCTree$JCReturn
            JCTree$JCThrow JCTree$JCAssert JCTree$JCMethodInvocation JCTree$JCNewClass
            JCTree$JCNewArray JCTree$JCLambda JCTree$JCParens JCTree$JCAssign JCTree$JCAssignOp
            JCTree$JCUnary JCTree$JCBinary JCTree$JCTypeCast JCTree$JCInstanceOf
            JCTree$JCAnyPattern JCTree$JCBindingPattern JCTree$JCDefaultCaseLabel
            JCTree$JCConstantCaseLabel JCTree$JCPatternCaseLabel JCTree$JCRecordPattern
            JCTree$JCArrayAccess JCTree$JCFieldAccess JCTree$JCMemberReference JCTree$JCIdent
            JCTree$JCLiteral JCTree$JCAnnotation JCTree$JCModifiers JCTree$JCSkip
            JCTree$JCPackageDecl JCTree$JCImport JCTree$JCModuleDecl JCTree$JCRequires
            JCTree$JCExports JCTree$JCOpens JCTree$JCProvides JCTree$JCUses JCTree$JCStatement
            JCTree$JCExpression JCTree$Tag JCTree$JCTypeParameter JCTree$JCAnnotatedType
            JCTree$JCLambda$ParameterKind TreeInfo JCTree$JCMemberReference$ReferenceKind
            JCTree$JCPattern JCTree$JCCaseLabel]
           [com.sun.tools.javac.code Type Type$ArrayType Type$ClassType Type$WildcardType
            Type$TypeVar Type$MethodType Type$IntersectionClassType Types Symtab Symbol
            Symbol$ClassSymbol Symbol$MethodSymbol Symbol$VarSymbol Symbol$TypeSymbol
            Symbol$PackageSymbol Flags Attribute Attribute$Constant Attribute$Class
            Attribute$Enum Attribute$Array Attribute$Compound Attribute$Error BoundKind
            TypeTag Kinds$Kind Scope$LookupKind Type$CapturedType Directive$RequiresDirective
            Directive$ExportsDirective Directive$OpensDirective Directive$ProvidesDirective
            Directive$UsesDirective]
           [com.sun.source.tree CaseTree$CaseKind Tree$Kind]
           [java.lang.annotation RetentionPolicy]))

;;; ------------------------------------------------------------------------------------------
;;; Statistics (for the coverage report)

(def ^:dynamic *stats* nil)

(defn note! [k] (when *stats* (swap! *stats* update k (fnil inc 0))))

(defn- kind-of [t]
  (if (tr/jc? t)
    (try (str (.getKind ^JCTree t)) (catch AssertionError _ (.getSimpleName (class t))))
    (tr/tag-name t)))

;;; ------------------------------------------------------------------------------------------
;;; Environment

(def ^:dynamic *text* "")

;; Mode :full (repr/java read --full; full.ae, doc/classes/PRINTER-NOTES.md "Mode :full"): an atom
;; numbering the positioned forms of the unit being converted, else nil; and its end positions.
(def ^:dynamic *full* nil)

(defn at-span
  "Form `x` with its span [s e] recorded in mode :full (:java/at, numbered for its hash)."
  [x s e]
  (if *full* (m+ x [:java :at [s e (swap! *full* inc)]]) x))

(defn at
  "Form `x` with the span of tree `t` recorded in mode :full."
  [x t]
  (if *full* (at-span x (tr/start t) (tr/end t)) x))

(defn- gensym! [env base]
  (let [n (swap! (:counter env) inc)]
    (symbol (str base "-" n))))

(defn h
  "The head symbol `s`, qualified as arbace.core/s when a local or field of that name is in
  scope."
  [env s]
  (let [n (name s)]
    (if (or (contains? (:names env) n) (contains? (:fields env) n))
      (symbol "arbace.core" n)
      s)))

(defn- shadow-set [env]
  (into (set (keys (:scope env))) (concat (:names env) (:fields env))))

(defn class-ref
  "The form naming class symbol `c` with `dims` array dimensions at this site."
  ([env c] (class-ref env c 0))
  ([env c dims]
   (let [simple (m/simple-name c)
         in-scope (get (:scope env) simple)]
     (cond
       (and (identical? in-scope c) (not (str/blank? simple)))
       (if (pos? dims) (symbol simple (str dims)) (symbol simple))
       ;; a member of a local class out of its scope (Cltype7.Inclass7 after Cltype7's body):
       ;; Outer$Member, the outer named as it is here
       (and (m/local-class? c) (not (m/anonymous? c)) (some-> (m/owner c) m/class-sym?)
            (not (m/anonymous? (m/owner c))))
       (let [o (class-ref env (m/owner c))]
         (if (symbol? o)
           (if (pos? dims) (symbol (str o "$" simple) (str dims)) (symbol (str o "$" simple)))
           (f/->CRef (m/binary-name c) dims nil (shadow-set env))))
       (and (m/local-class? c) (not (m/anonymous? c))) ;; a local class not in scope by name: should not happen
       (do (note! :warn/local-class-out-of-scope)
           (if (pos? dims) (symbol simple (str dims)) (symbol simple)))
       :else (do (when (m/anonymous? c) (note! :warn/anonymous-class-named))
                 (f/->CRef (m/binary-name c) dims nil (shadow-set env)))))))

;;; ------------------------------------------------------------------------------------------
;;; Types as forms (§4.3)

(declare type-form annotation-items object-type)

(defn- array-dims [t]
  (loop [t t n 0]
    (if (m/array? t) (recur (m/elemtype t) (inc n)) [t n])))

(declare type-ann-items)

(def ^:dynamic *skip-anns*
  "Binary names of the TYPE_USE annotations in a declaration's modifiers: javac also puts them
  on the declared type's element type, which the compiler derives from the declaration (§4.4)."
  #{})

(defn- annotate [form items]
  (if (seq items) (apply m+ form items) form))

(defn- type-form*
  [env t elem?]
  (let [tg (tag-name t)
        anns (type-ann-items env t (and elem? (not (m/array? t))))]
    (annotate
     (cond
       (#{"BOOLEAN" "BYTE" "SHORT" "INT" "LONG" "CHAR" "FLOAT" "DOUBLE" "VOID"} tg) (m/prim-sym t)
       ;; more than nine dimensions: the reader's C/N takes 1-9; the JVM's name of the array
       ;; class as a string tag (Clojure's), which the analysis reads (JCS12 (b))
       (and (m/array? t)
            (> (count (take-while m/array? (iterate m/elemtype t))) 9)
            (not (some #(seq (type-ann-items env % true)) (take-while some? (iterate #(when (m/array? %) (m/elemtype %)) t)))))
       (let [ts (take-while m/array? (iterate m/elemtype t))
             e (erasure (m/elemtype (last ts)))]
         (str (apply str (repeat (count ts) "["))
              (if (prim? e)
                ({"BOOLEAN" "Z" "BYTE" "B" "SHORT" "S" "INT" "I" "LONG" "J" "CHAR" "C" "FLOAT" "F" "DOUBLE" "D"} (tag-name e))
                (str "L" (m/binary-name (m/tsym e)) ";"))))
       (m/array? t)
       (let [ef (type-form* env (m/elemtype t) elem?)]
         (cond
           (seq (f/items ef)) (list 'array ef)
           (instance? CRef ef) (update ef :dims inc)
           (and (symbol? ef) (namespace ef)) (symbol (namespace ef) (str (inc (parse-long (name ef)))))
           (symbol? ef) (symbol (name ef) "1")
           :else (list 'array ef)))
       (m/captured? t) (type-form* env (erasure t) elem?)
       (m/tvar? t) (symbol (m/simple-name (m/tsym t)))
       (m/wildcard? t)
       (case (m/wild-kind t)
         :unbound '?
         :extends (list '? 'extends (type-form* env (m/wild-bound t) false))
         :super (list '? 'super (type-form* env (m/wild-bound t) false)))
       (m/components t) (apply list '& (map #(type-form* env % false) (m/components t)))
       (m/class-type? t)
       (let [c (m/tsym t)
             args (m/type-args t)
             outer (m/enclosing-type t)
             base (class-ref env c)
             self (if args (apply list base (map #(type-form* env % false) args)) base)]
         (if (and (m/class-type? outer) (m/allparams? outer)
                  (not (m/static? c)) (not (m/local-class? c))
                  (not (and (identical? (get (:scope env) (m/simple-name c)) c)
                            (m/own-type? outer))))
           (list '.. (type-form* env outer false)
                 (annotate (if args
                             (apply list (symbol (m/simple-name c)) (map #(type-form* env % false) args))
                             (symbol (m/simple-name c)))
                           anns))
           self))
       :else (do (note! :warn/odd-type) (class-ref env (.tsym (object-type)))))
     ;; the annotations of an inner type of a generic outer go on its element of (.. ...)
     (when-not (and (m/class-type? t) (m/class-type? (m/enclosing-type t))
                    (m/allparams? (m/enclosing-type t))
                    (not (m/static? (m/tsym t))) (not (m/local-class? (m/tsym t)))
                    (not (and (identical? (get (:scope env) (m/simple-name (m/tsym t))) (m/tsym t))
                              (m/own-type? (m/enclosing-type t)))))
       anns))))

(defn type-form
  "The declaration form of type `t` (generic where it is), with its type annotations (§4.4)."
  [env t]
  (type-form* env t true))

(defn erased-form
  "The form of the erasure of `t`: a primitive symbol, a class or an array class."
  [env t]
  (type-form env (erasure t)))

(defn type-annotated?
  "Does type `t` carry type annotations anywhere?"
  [t]
  (boolean
   (and t
        (or (m/type-anns t)
            (and (m/array? t) (type-annotated? (m/elemtype t)))
            (and (m/wildcard? t) (type-annotated? (m/wild-bound t)))
            (and (m/class-type? t)
                 (or (some type-annotated? (m/type-args t))
                     (let [o (m/enclosing-type t)] (and (m/class-type? o) (type-annotated? o)))))))))

(defn code-type-form
  "The form of type `t` in code (cast, instance?, new, catch): erased, or with its type
  annotations where it has some (the compiler erases it)."
  [env t]
  (if (type-annotated? t) (type-form env t) (erased-form env t)))

(defn- generic? [t]
  (cond
    (m/array? t) (generic? (m/elemtype t))
    (m/tvar? t) true
    (m/class-type? t) (or (m/type-args t) (m/allparams? t))
    :else false))

(defn decl-tag
  "The tag item for a declaration of type `t`, or nil for Object when `omit-object?` (unless
  annotated)."
  [env t omit-object?]
  (let [f (type-form env t)]
    (when-not (and omit-object? (m/object? t) (not (m/tvar? t)) (empty? (f/items f)))
      [:tag f])))

(defn- mods-type-anns
  "*skip-anns* for a declaration with modifiers `mods`."
  [mods]
  (set (for [a (some-> mods (tr/f :annotations))
             :let [c (attr/attribute a)]
             :when c]
         (m/binary-name (m/compound-class c)))))

;;; ------------------------------------------------------------------------------------------
;;; Annotations (§4.4)

(defn- attr-value [env a elem-type]
  (case (m/value-kind a)
    :const
    (let [[tg v] (m/const-of a)]
      (case tg
        "CHAR" (char (int v))
        "BOOLEAN" (if (number? v) (not (zero? (long v))) v)
        "FLOAT" (float v)
        "BYTE" (list 'unchecked-byte (long v))
        "SHORT" (list 'unchecked-short (long v))
        v))
    :class (let [t (m/class-of a)]
             (if (prim? t)
               ;; int.class as Integer/TYPE, char.class as Character/TYPE (RPS84 (a)), as a class
               ;; literal's are
               (member (cref (str "java.lang." ({"int" "Integer" "char" "Character" "void" "Void"}
                                                (str (m/prim-sym t)) (str/capitalize (str (m/prim-sym t))))))
                       "TYPE")
               (erased-form env t)))
    :enum (let [[c n] (m/enum-of a)] (member (class-ref env c) n))
    :array (mapv #(attr-value env % nil) (m/array-of a))
    :compound
    (let [c (m/nested-of a)]
      (list (class-ref env (m/compound-class c))
            (into {} (for [[n v] (m/compound-values c)] [(keyword n) (attr-value env v nil)]))))
    (do (note! :warn/annotation-value) nil)))

(declare compound-item)

(defn annotation-items
  "Metadata items for the annotations `anns` (ANNOTATION trees), leaving out SOURCE ones."
  [env anns]
  (keep (fn [a] (some->> (attr/attribute a) (compound-item env))) anns))

(defn type-ann-items
  "Metadata items for the type annotations of type `t`; at a declaration's element type
  (`elem?`) without those of the declaration's modifiers (*skip-anns*)."
  [env t elem?]
  (when t
    (keep (fn [c]
            (when-not (and elem? (contains? *skip-anns* (m/binary-name (m/compound-class c))))
              (compound-item env c)))
          (m/type-anns t))))

(defn- compound-item
  "The metadata item for annotation `c`, nil for a SOURCE one."
  [env c]
  (when (not= "SOURCE" (m/retention c))
    (let [vals (seq (m/compound-values c))
          v (cond
              (empty? vals) true
              ;; @A(true) is not the marker ^{A true}
              (and (= 1 (count vals)) (= "value" (first (first vals)))
                   (not (true? (attr-value env (second (first vals)) nil))))
              (attr-value env (second (first vals)) nil)
              :else (into {} (for [[n x] vals]
                               [(keyword n) (attr-value env x nil)])))]
      (note! :form/annotation)
      [:ann (class-ref env (m/compound-class c)) v])))

;;; ------------------------------------------------------------------------------------------
;;; Modifiers (§4.2)

(def flag-keywords
  [[Flags/PUBLIC :public] [Flags/PROTECTED :protected] [Flags/PRIVATE :private]
   [Flags/ABSTRACT :abstract] [Flags/STATIC :static] [Flags/FINAL :final]
   [Flags/TRANSIENT :transient] [Flags/VOLATILE :volatile] [Flags/SYNCHRONIZED :synchronized]
   [Flags/NATIVE :native] [Flags/STRICTFP :strictfp] [Flags/DEFAULT :default]
   [Flags/SEALED :sealed] [Flags/NON_SEALED :non-sealed]])

(defn modifier-items
  "Metadata items for the modifiers of declaration `d` (as javac's Enter left them), then its
  annotations."
  [env d & {:keys [drop]}]
  (let [mods (tr/f d :mods)
        fl (attr/mods-flags d)
        drop (set drop)]
    (concat
     (for [[bit kw] flag-keywords
           :when (and (not (zero? (bit-and fl (long bit)))) (not (drop kw)))]
       (do (note! (keyword "mod" (name kw))) kw))
     (annotation-items env (tr/f mods :annotations)))))

(defn deprecated-item [sym mods]
  (when (and (m/has-flag? sym Flags/DEPRECATED)
             (not (m/has-flag? sym Flags/DEPRECATED_ANNOTATION)))
    (note! :mod/deprecated)
    :deprecated))

;;; ------------------------------------------------------------------------------------------
;;; Expression results
;;
;; An expression converts to {:f form, :t type}: :t is the static type Arbace gives the form,
;; an erased javac Type, or :lit-int for an int literal (a long to Clojure, narrowed by the
;; context), or :null.

(defn- r [f t] {:f f :t t})

(defn- int-type [] (if attr/*provider* :int (.intType jt/*syms*)))
(defn- bool-type [] (if attr/*provider* :boolean (.booleanType jt/*syms*)))
(defn- object-type [] (if attr/*provider* (d/object-type (:reg attr/*provider*)) (jt/object-type)))

(defn atype
  "The Arbace type of result `x` as a javac type (int for :lit-int, nil for :null)."
  [x]
  (attr/note-result! (:t x))
  (case (:t x) :lit-int (int-type) :null nil (:t x)))

(defn pure?
  "True when evaluating `form` twice is the same as once: a local, this, a literal."
  [form]
  (or (and (symbol? form) (not (namespace form)))
      (and (instance? CRef form) (#{"this" "super"} (:member form)))
      (string? form) (number? form) (char? form) (boolean? form) (nil? form) (keyword? form)))

(defn- strip-do [forms]
  (mapcat (fn [x] (if (and (seq? x) (= 'do (first x))) (rest x) [x])) forms))

(defn do-form
  "One form for the forms `xs`: nil, the form, or a do."
  [xs]
  (let [xs (strip-do xs)]
    (case (count xs)
      0 nil
      1 (first xs)
      (apply list 'do xs))))

(defn- hint
  "Form `f` with static type `t` without a cast: a tag on a symbol or list, else `f`."
  [env f t]
  (if (or (and (symbol? f) (not (namespace f))) (seq? f))
    (do (note! :conv/hint) (tag f (erased-form env t)))
    f))

(def unbox-method
  {"INT" ".intValue" "LONG" ".longValue" "SHORT" ".shortValue" "BYTE" ".byteValue"
   "CHAR" ".charValue" "FLOAT" ".floatValue" "DOUBLE" ".doubleValue" "BOOLEAN" ".booleanValue"})

(def narrow-op
  {"INT" 'unchecked-int "LONG" 'unchecked-long "SHORT" 'unchecked-short "BYTE" 'unchecked-byte
   "CHAR" 'unchecked-char "FLOAT" 'unchecked-float "DOUBLE" 'unchecked-double})

(def widen-op
  {"INT" 'int "LONG" 'long "FLOAT" 'float "DOUBLE" 'double "SHORT" 'short "CHAR" 'char})

(defn- box-call [env form p]
  (let [b (m/boxed p)]
    (note! :conv/box)
    (list (member (class-ref env (m/tsym b)) "valueOf") form)))

(defn- unbox-call [env form wrapper]
  (let [u (m/unboxed wrapper)]
    (note! :conv/unbox)
    (list (symbol (unbox-method (tag-name u))) form)))

(defn cast-form [env form t]
  (note! :conv/cast)
  (list (h env 'cast) (erased-form env t) form))

(defn- literal-branch?
  "Is `form` a conditional (if) one of whose branches is a number, or such a conditional?"
  [form]
  (and (seq? form) (symbol? (first form)) (= "if" (name (first form))) (= 4 (count form))
       (boolean (some #(or (number? %) (literal-branch? %)) (drop 2 form)))))

(defn coerce
  "Convert result `x` to the erased target type `target` as javac's TransTypes and Lower do
  in assignment contexts, writing out what Arbace does not do implicitly (§5.5, §7.4).
  With :explicit, primitive widening and boxing are written too (conditional branches)."
  ([env x target] (coerce env x target false))
  ([env x target explicit?]
   (let [form (:f x) t (:t x)]
     (cond
       (nil? target) form
       (m/void? target) form
       (do (attr/note-result! t) (= t :null)) form
       (prim? target)
       (cond
         (= t :lit-int)
         (cond
           (and (number? form) (= "DOUBLE" (tag-name target))) (double form)
           (and (number? form) (= "FLOAT" (tag-name target))) (list 'float (double form))
           (not explicit?) form
           (#{"INT" "SHORT" "BYTE" "CHAR"} (tag-name target)) form
           (= "LONG" (tag-name target)) form
           (= "DOUBLE" (tag-name target)) (if (number? form) (double form) (list 'double form))
           :else (if (number? form) (float form) (list (widen-op (tag-name target)) form)))
         (prim? t)
         (cond
           (same? t target) form
           ;; a long constant widened to float or double (f3 += -2061721519L; double d =
           ;; 3858573493713776640L): written widened, as an int constant is, so that the printed
           ;; Java's literal (an int's when it is in int's range) reads back to the same forms
           ;; (RPS151 (a), doc/FULL-SUPPORT-SURVEY.md): to float its double's value when the double
           ;; holds the long exactly (else the long's own conversion), to double the double itself
           ;; in int's range (an int literal's widening) and the long's conversion beyond it
           (and (not explicit?) (integer? form) (= "LONG" (tag-name t)) (#{"FLOAT" "DOUBLE"} (tag-name target)))
           (let [v (long form)]
             (if (= "FLOAT" (tag-name target))
               (if (== v (long (double v))) (list 'float (double v)) (list 'float form))
               (if (<= Integer/MIN_VALUE v Integer/MAX_VALUE) (double v) (list 'double form))))
           (m/widens? t target) (if explicit? (list (widen-op (tag-name target)) form) form)
           ;; constant narrowing
           :else (list (narrow-op (tag-name target)) form))
         :else ;; unboxing
         (let [u (m/unboxed t)]
           (if u
             (if (and (not explicit?) (or (same? u target) (m/widens? u target)))
               form
               (let [v (unbox-call env form t)]
                 (if (and explicit? (not (same? u target))) (list (widen-op (tag-name target)) v) v)))
             ;; from a non-wrapper type (a generic result): cast to javac's type when it is
             ;; a wrapper (TransTypes), else to the wrapper of the target
             (let [jw (some-> (:jtree x) (attr/type-of :types/expr) erasure)
                   w (if (and jw (m/unboxed jw)) jw (m/boxed target))
                   v (unbox-call env (cast-form env form w) w)
                   u (m/unboxed w)]
               (if (and explicit? (not (same? u target))) (list (widen-op (tag-name target)) v) v)))))
       :else ;; reference target
       (cond
         ;; a constant narrowed then boxed (JLS 5.2): Byte b = 1 is Byte.valueOf((byte) 1)
         (= t :lit-int) (let [u (m/unboxed target)]
                          (if (and u (#{"BYTE" "SHORT" "CHAR"} (tag-name u)))
                            (box-call env (list (narrow-op (tag-name u)) form) u)
                            (box-call env form (int-type))))
         (prim? t) (let [u (m/unboxed target)]
                     (cond
                       ;; a constant of another type narrowed then boxed (JLS 5.2): Byte b = 'a'
                       (and u (#{"BYTE" "SHORT" "CHAR"} (tag-name u)) (not (same? t u)))
                       ;; a byte constant into a Short is widened (JLS 5.1.2), as an explicit
                       ;; (short) cast is written (T6816548; "As built: JC6")
                       (box-call env (list (if (m/widens? t u) (widen-op (tag-name u)) (narrow-op (tag-name u))) form) u)
                       ;; a number written as a literal (+43) is a long to the analysis
                       (or explicit? (and (number? form) (not (#{"LONG" "DOUBLE"} (tag-name t)))))
                       (box-call env form t)
                       ;; a long constant into a reference other than Long (new R6(0L, 0) of
                       ;; R6(Object, Object)): boxed in the forms, since its printed literal is
                       ;; an int's (RPS151 (a))
                       (and (integer? form) (= "LONG" (tag-name t)) (not (same? target (m/boxed t))))
                       (box-call env form t)
                       ;; a conditional with a literal branch into a reference (return c ? 1 :
                       ;; x; of an Integer method): boxed whole, as javac's Lower boxes it, since
                       ;; the printer writes a tail conditional as an if whose branches' returns
                       ;; box the literal alone (RPS151 (a))
                       (and (literal-branch? form) (let [u (m/unboxed target)] (or (nil? u) (same? u t))))
                       (box-call env form t)
                       :else form))
         ;; a conditional or switch of javac's intersection type (the lub of classes sharing
         ;; interfaces): the compiler unifies its branches by their class chain, Object; the
         ;; target is written as a cast
         (and (not (m/object? target)) (seq? form)
              (some-> (:jtree x) tr/skip-parens (#(or (tr/is? % :CONDEXPR) (tr/is? % :SWITCH_EXPRESSION))))
              (some-> (:jtree x) (attr/type-of :types/expr) m/components))
         (cast-form env form target)
         ;; (a type variable of an intersection bound, H extends B & A, is erased to B: as A
         ;; it is cast, as javac's TransTypes does)
         (subtype? (if (m/tvar? t) (erasure t) t) target) form
         (and (not (m/tvar? t)) (or (m/tvar? target) (m/components target))
              (subtype? t (erasure target)))
         form
         :else (cast-form env form (if (or (m/tvar? target) (m/components target)) (erasure target) target)))))))

(defn coerce-r
  "Like coerce, returning a result with the target as type."
  [env x target]
  (if (nil? target)
    x
    (let [f (coerce env x target)]
      (if (identical? f (:f x))
        x
        (r f (erasure target))))))

(defn test-form
  "Result `x` as a condition: primitive boolean, unboxing a Boolean."
  [env x]
  (attr/note-result! (:t x))
  (let [t (:t x)]
    (if (and (m/type? t) (not (prim? t)))
      (coerce env x (bool-type) true)
      (:f x))))

;;; ------------------------------------------------------------------------------------------
;;; Literals

(defn- number-token
  "The source text of the numeric literal at `pos`, with a folded sign."
  [pos]
  (let [^String text *text*
        n (count text)
        neg? (= \- (.charAt text pos))
        i (if neg?
            (loop [i (inc pos)] (if (Character/isWhitespace (.charAt text i)) (recur (inc i)) i))
            pos)
        hex? (and (< (inc i) n) (= \0 (.charAt text i)) (#{\x \X} (.charAt text (inc i))))
        end (loop [j i]
              (if (>= j n)
                j
                (let [c (.charAt text j)
                      prev (.charAt text (dec j))]
                  (cond
                    (or (Character/isLetterOrDigit c) (= c \_) (= c \.)) (recur (inc j))
                    (and (#{\+ \-} c) (if hex? (#{\p \P} prev) (#{\e \E} prev))) (recur (inc j))
                    :else j))))]
    (str (when neg? "-") (subs text i end))))

(defn- radix-text
  "Clojure text for a hex, octal or binary Java integer token, or nil for decimal ones."
  [tok]
  (let [s (-> tok (str/replace "_" "") (str/replace #"[lL]$" ""))]
    (cond
      (re-matches #"-?0[xX][0-9a-fA-F]+" s) s
      (re-matches #"-?0[bB][01]+" s) (str/replace s #"0[bB]" "2r")
      (re-matches #"-?0[0-7]+" s) s
      :else nil)))

(defn- read-long [s] (let [v (read-string s)] (when (integer? v) v)))

(defn- literal [env t]
  (let [v (tr/literal-value t)
        tt (attr/type-of t :types/literal)]
    (note! :lit/any)
    (case (tag-name tt)
      "INT" (let [tok (try (number-token (tr/start t)) (catch Exception _ ""))
                  rt (radix-text tok)
                  v (long v)]
              (if-let [lv (and rt (read-long rt))]
                (if (= lv v)
                  (assoc (r (f/raw rt) :lit-int) :vals [v])
                  (r (list 'unchecked-int (f/raw rt)) (int-type)))
                (assoc (r v :lit-int) :vals [v])))
      "LONG" (let [tok (try (number-token (tr/start t)) (catch Exception _ ""))
                   rt (radix-text tok)
                   v (long v)]
               (if-let [lv (and rt (read-long rt))]
                 (if (= lv v)
                   (r (f/raw rt) tt)
                   (r (list 'unchecked-long (f/raw rt)) tt))
                 (r v tt)))
      "FLOAT" (let [fv (float v)
                    d (Double/parseDouble (Float/toString fv))]
                ;; the shortest decimal when it rounds back to the float, else the float's
                ;; exact value as a double
                (if (and (<= (Math/abs d) Float/MAX_VALUE) (= (unchecked-float d) fv))
                  (r (list 'float d) tt)
                  (r (list 'float (double fv)) tt)))
      "DOUBLE" (r (double v) tt)
      "CHAR" (let [c (char (int v))]
               (if (Character/isSurrogate c)
                 (r (list 'unchecked-char (f/raw (format "0x%04X" (int c)))) tt)
                 (r c tt)))
      "BOOLEAN" (r (if (number? v) (not (zero? (long v))) (boolean v)) tt)
      "CLASS" (r (str v) tt)
      "BOT" (r nil :null))))

;;; ------------------------------------------------------------------------------------------
;;; Names: locals, fields, enclosing instances

(declare with-type-args capture-values captured-mutables poly-call? assigned-syms local? simplify ex ex-stmt stmts stmt class-form anon-form lambda-form method-ref-form switch-form
         call-args)

(defn- enclosing-classes [env] (:classes env))

(defn- current-class [env] (first (:classes env)))

(defn- member-of? [sym c] (m/member-of? sym c))

(defn- this-of
  "The form for the instance of enclosing class `c` (`this` for the current class)."
  [env c]
  (if (identical? c (current-class env))
    (or (:this env) (do (note! :warn/no-this) 'this))
    (do (note! :form/outer-this)
        (if (m/anonymous? c)
          (if-let [s (get (:anon-this env) c)]
            (do (note! :form/anonymous-outer-receiver) s)
            (do (note! :warn/anonymous-outer-this) (member (class-ref env c) "this")))
          (member (class-ref env c) "this")))))

(defn- qualifying-class
  "For a member referenced by simple name: for an instance member the innermost enclosing
  class of which it is a member (whose instance is the receiver); for a static member the
  current class when it is a member of it, else its declaring class, as javac does."
  [env sym]
  (if (m/static? sym)
    (cond
      (not (member-of? sym (current-class env))) (m/owner sym)
      ;; javac's qualifier would be the anonymous class itself, which has no name to write
      (m/anonymous? (current-class env)) (do (note! :warn/static-via-anonymous) (m/owner sym))
      :else (current-class env))
    (or (first (filter #(member-of? sym %) (enclosing-classes env)))
        (m/owner sym))))

(defn- field-bare?
  "True when field `sym` can be written by its bare name here (§4.5, §5.2)."
  [env sym]
  (let [nm (m/sname sym)
        owner (m/owner sym)
        classes (enclosing-classes env)
        idx (first (keep-indexed (fn [i c] (when (identical? c owner) i)) classes))]
    (and idx
         ;; a field inherited by a closer class is that class's member (note 7)
         (identical? (qualifying-class env sym) owner)
         (not (#{"nil" "true" "false"} nm))
         (not (contains? (:names env) nm))
         ;; no closer class declares a field of that name
         (not-any? (fn [c] (m/has-field? c nm))
                   (take idx classes)))))

(defn- field-ref
  "The form reading field `sym` referenced by simple name."
  [env sym]
  (let [nm (m/sname sym)]
    (cond
      (field-bare? env sym) (symbol nm)
      (m/static? sym) (member (class-ref env (qualifying-class env sym)) nm)
      :else (list (symbol (str ".-" nm)) (this-of env (qualifying-class env sym))))))

(defn- var-type [sym] (m/verasure sym))

(defn- local? [sym] (m/local? sym))

(defn- ident [env t]
  (let [nm (str (tr/f t :name))
        sym (when-not (#{"this" "super"} nm) (attr/sym t :ident))]
    (cond
      (= nm "this") (r (or (:this env) 'this) (erasure (attr/type-of t :types/this)))
      (= nm "super") (r 'super (erasure (attr/type-of t :types/this)))
      (and (= "VAR" (m/kind sym)) (local? sym))
      (r (or (get (:locals env) sym)
             (do (note! :warn/unknown-local)
                 (when (System/getenv "REPR_JAVA_DEBUG") (println "unknown local" nm "in" (str (current-class env))))
                 (symbol nm)))
         (var-type sym))
      (= "VAR" (m/kind sym))
      (do (note! :form/field-read)
          (r (field-ref env sym) (var-type sym)))
      (= "TYP" (m/kind sym)) (r (class-ref env sym) :type)
      :else (do (note! :warn/odd-ident) (r (symbol nm) (erasure (attr/type-of t :types/ident)))))))

(defn- type-expr?
  "True when expression tree `t` names a type (or package), not a value (JLS 6.5; attr's, JFS71)."
  [t]
  (attr/type-expr? t))

(defn- qual-type
  "The erased type javac uses for qualifier expression `q`."
  [q]
  (erasure (m/skip-type-vars (attr/type-of q :types/qualifier))))

(defn- compound-qual?
  "Is qualifier `q`'s type (through type variables) an intersection?"
  [q]
  (m/compound? (m/skip-type-vars (attr/type-of q :types/qualifier))))

(defn- class-literal [env t]
  (note! :form/class-literal)
  (if (or (prim? t) (m/void? t))
    (member (cref (str "java.lang." ({"int" "Integer" "char" "Character" "void" "Void"}
                                     (str (m/prim-sym t)) (str/capitalize (str (m/prim-sym t))))))
            "TYPE")
    (erased-form env t)))

(defn- select [env t]
  (let [nm (str (tr/f t :name))
        sym (when-not (#{"class" "this" "super"} nm) (attr/sym t :select))
        q (tr/f t :selected)
        qtype #(attr/type-of q :names/type-tree)]
    (cond
      (= nm "class") (r (class-literal env (qtype)) (erasure (attr/type-of t :types/class-literal)))
      (= nm "this") (r (this-of env (m/tsym (qtype))) (erasure (attr/type-of t :types/this)))
      (= nm "super") (r (if (identical? (m/tsym (qtype)) (current-class env))
                          'super
                          (member (class-ref env (m/tsym (qtype))) "super"))
                        (erasure (attr/type-of t :types/this)))
      (#{"TYP" "PCK"} (m/kind sym)) (r (if (= "TYP" (m/kind sym)) (class-ref env sym) (symbol (m/sstr sym))) :type)
      (and (= nm "length") (m/array? (attr/type-of q :types/qualifier)))
      (do (note! :form/alength)
          (r (list (h env 'alength) (coerce env (ex env q) (qual-type q))) (int-type)))
      (m/static? sym)
      (let [c (if (type-expr? q) (m/tsym (qual-type q)) (m/tsym (qual-type q)))
            ref (member (class-ref env c) nm)]
        (note! :form/static-field)
        (r (if (type-expr? q)
             ref
             (let [qf (:f (ex env q))]
               (if (pure? qf) ref (list 'do qf ref))))
           (var-type sym)))
      :else
      (let [qr (ex env q)
            qf (if (compound-qual? q)
                 (coerce env (coerce-r env qr (qual-type q)) (erasure (m/stype (m/owner sym))))
                 (coerce env qr (qual-type q)))]
        (note! :form/instance-field)
        (r (list (symbol (str ".-" nm)) qf) (var-type sym))))))

;;; ------------------------------------------------------------------------------------------
;;; Overloads (§5.6, §7.3)

(defn- erased-params [m] (m/erased-params m))

(defn- sig-key [m] (mapv m/type-str (erased-params m)))

(defn- accessible? [env m]
  (let [fl (m/flags m)
        cur (current-class env)]
    (cond
      (not (zero? (bit-and fl (long Flags/PUBLIC)))) true
      (not (zero? (bit-and fl (long Flags/PRIVATE))))
      (identical? (m/outermost m) (m/outermost cur))
      :else true)))

(defn- methods-named
  "All methods named `nm` in type `site` and its supertypes, one per erased signature."
  [env site nm ctor?]
  (let [site (if (m/array? site) (object-type) site)
        classes (if ctor?
                  (when (m/class-type? site) [(m/tsym site)])
                  (cond-> (m/closure-classes site)
                    (let [c (m/tsym site)] (and (m/class-sym? c) (m/interface? c))) (conj (m/tsym (m/object-type-of site)))))]
    (->> (for [c classes
               s (m/methods-named c nm)
               :when (and (zero? (bit-and (m/flags s) (long (bit-or Flags/SYNTHETIC Flags/BRIDGE))))
                          (accessible? env s))]
           s)
         (reduce (fn [[seen out] m]
                   (let [k (sig-key m)]
                     (if (seen k) [seen out] [(conj seen k) (conj out m)])))
                 [#{} []])
         second)))

(defn- pin-needed?
  "Does a call of javac's method `m` need param-tags, that is, does the Java forms compiler's
  resolution (SPEC §5.6, §7.3) choose another method, another arity mode or none without them?
  `kind` is :instance (receiver of static type `site`), :static (class `site`) or :ctor (of
  class `site`); `from` the class whose code it is; `nodes` the arguments as the compiler will
  see them; `varargs?` whether the variable arguments are written unpacked."
  [kind from site m nodes varargs?]
  (note! :pin/decided)
  (let [need (res/pin-needed? kind from site m nodes varargs?)]
    (when need (note! (keyword "pin" (name kind))))
    need))

(defn- param-tags [env m]
  (note! :form/param-tags)
  [:param-tags (mapv #(erased-form env %) (erased-params m))])

;;; ------------------------------------------------------------------------------------------
;;; Calls

(defn- arg-targets
  "The erased types javac's TransTypes converts the arguments to."
  [m mtype n varargs-elem]
  (let [ps (vec (if (and mtype (m/method-type? mtype))
                  (m/mt-params mtype)
                  (erased-params m)))
        poly? (m/sig-poly? m)]
    (cond
      poly? (repeat n nil)
      varargs-elem (concat (map erasure (butlast ps)) (repeat (erasure varargs-elem)))
      :else (let [ds (erased-params m)]
              ;; an instantiated parameter whose erasure is not the declared one's subtype (a
              ;; method's <H extends A & B> taking a caller's H of another bound order): the
              ;; declared erasure, which TransTypes casts to
              (map (fn [p i]
                     (let [e (erasure p) d (when (< i (count ds)) (nth ds i))]
                       (if (and d (not (prim? e)) (not (prim? d)) (not (subtype? e d))) d e)))
                   ps (range))))))

(defn- arg-node [x] (res/arg-node (or (:stub-t x) (:t x)) (:vals x)))

(defn call-args
  "Convert argument trees to [forms types nodes] for method `m`: the nodes are the arguments
  as the Java forms compiler will see them (for its resolution, `arbace.repr.java.resolve`). Packs
  variable arguments into an array unless `loose?`."
  [env m mtype args varargs-elem loose?]
  (let [targets (arg-targets m mtype (count args) varargs-elem)
        rs (doall (map (fn [a t]
                         (let [x0 (ex env a)
                               x (coerce-r env x0 t)
                               ;; a parenthesized int conditional of literals passed for a long,
                               ;; float or double parameter: javac widens the int value (without
                               ;; parentheses the conditional is a poly expression of the
                               ;; parameter's type, and its constants are of that type)
                               x (if (and (= :lit-int (:t x0)) (seq? (:f x0)) t (prim? t)
                                          (tr/is? a :PARENS)
                                          (#{"LONG" "FLOAT" "DOUBLE"} (tag-name t)))
                                   (assoc x :f (list (widen-op (tag-name t)) (:f x0)) :t t)
                                   x)
                               a (tr/skip-parens a)
                               ;; an array's clone() is cast to the instantiated parameter type
                               ;; (TransTypes.retype): a hint tells the compiler
                               x (if (and t (m/array? t) (seq? (:f x))
                                          (tr/is? a :APPLY)
                                          (= "clone" (str (tr/tree-name (tr/f a :meth))))
                                          (empty? (tr/f a :args)))
                                   (assoc x :f (tag (:f x) (erased-form env t)))
                                   x)]
                           ;; the compiler unifies a conditional's branches by their class
                           ;; chain only: javac's type for it (the parameter's) as a hint
                           (if (and t (not (prim? t)) (not (m/object? t)) (seq? (:f x))
                                    (or (tr/is? a :CONDEXPR) (tr/is? a :SWITCH_EXPRESSION)))
                             (assoc x :f (hint env (:f x) t) :t (erasure t))
                             x)))
                       args targets))]
    (if (and varargs-elem (not loose?))
      (let [nfixed (dec (count (erased-params m)))
            [fixed rest] (split-at nfixed rs)
            arr-t (m/array-type (erasure varargs-elem))]
        (note! :form/varargs-packed)
        [(concat (map :f fixed) [(list 'new (erased-form env arr-t) (mapv :f rest))])
         (concat (map :t fixed) [arr-t])
         (concat (map arg-node fixed) [(res/arg-node arr-t nil)])])
      (do (when varargs-elem (note! :form/varargs-loose))
          [(map :f rs) (map :t rs) (map arg-node rs)]))))

(defn- only-method-named? [env m site ctor?]
  (= 1 (count (methods-named env site (m/sname m) ctor?))))

(defn- erased-varargs-elem?
  "Is the element type of javac's variable arguments array, `varargs-elem` (the inferred one),
  erased the element type of m's erased last parameter, as the compiler makes the array?"
  [m varargs-elem]
  (same? (erasure varargs-elem) (m/elemtype (last (erased-params m)))))

(defn- loose-varargs?
  "Are the variable arguments of a call of `m` (javac's array element `ve`, nil when the call
  is not of variable arity) written unpacked? When m is the only method of its name and the
  compiler makes javac's array (SPEC note 6 of COMPILER-NOTES)."
  [env m site ctor? ve]
  (and ve (only-method-named? env m site ctor?) (erased-varargs-elem? m ve)))

(defn- ret-type [m] (m/erased-ret m))

(defn- invocation [env t]
  (let [meth (tr/f t :meth)
        m (attr/symbol-of meth :method)
        nm (m/sname m)
        args (tr/f t :args)
        ve (attr/varargs-element t m)
        mtype #(attr/method-type meth m)]
    (cond
      ;; this(...) / super(...)
      (= nm "<init>")
      (let [callee (str (tr/tree-name meth))
            site (m/stype (m/owner m))
            loose? (loose-varargs? env m site true ve)
            qual (when (tr/is? meth :SELECT) (tr/f meth :selected))
            [afs _ nodes] (call-args env m (mtype) args ve loose?)
            qf (when qual (:f (ex env qual)))
            pin? (pin-needed? :ctor (current-class env) (m/owner m) m nodes (and ve loose?))
            head (fn [s] (if pin? (m+ s (param-tags env m)) s))]
        (note! (if (= callee "this") :form/this-call :form/super-call))
        (r (cond
             (= callee "this") (apply list (head 'this.) afs)
             qual (apply list (head '.super) qf afs)
             :else (apply list (head 'super.) afs))
           (object-type)))
      :else
      (let [static? (m/static? m)
            [recv site head-class]
            (cond
              (tr/is? meth :IDENT)
              (if static?
                (let [q (qualifying-class env m)] [nil (m/stype q) q])
                (let [q (qualifying-class env m)] [(this-of env q) (m/stype q) q]))
              :else
              (let [q (tr/f meth :selected)
                    qn (str (tr/tree-name q))
                    qt #(attr/type-of q :types/qualifier)]
                (cond
                  (and (tr/is? q :IDENT) (= qn "super"))
                  ['super (erasure (qt)) (m/tsym (qt))]
                  (and (tr/is? q :SELECT) (= qn "super"))
                  (let [x (select env q)] [(:f x) (erasure (qt)) (m/tsym (qt))])
                  (type-expr? q) [nil (qual-type q) (m/tsym (qual-type q))]
                  static? (let [qf (:f (ex env q))]
                            [(when-not (pure? qf) qf) (qual-type q) (m/tsym (qual-type q))])
                  (compound-qual? q)
                  ;; an intersection-typed qualifier is cast to the member's class (TransTypes)
                  (let [qt (erasure (m/stype (m/owner m)))
                        qr (coerce-r env (ex env q) (qual-type q))]
                    [(coerce env qr qt) qt (m/tsym qt)])
                  :else (let [qr (ex env q)
                              qt (qual-type q)]
                          [(coerce env qr qt) qt (m/tsym qt)]))))
            loose? (loose-varargs? env m site false ve)
            [afs _ nodes] (call-args env m (mtype) args ve loose?)
            poly? (m/sig-poly? m)
            pin? (or poly?
                     (if static?
                       (pin-needed? :static (current-class env) head-class m nodes (and ve loose?))
                       (pin-needed? :instance (current-class env) site m nodes (and ve loose?))))
            ;; an anonymous class cannot be named: pin with the declaring class, or not at all
            head-class (if (and (not static?) (m/class-sym? head-class) (m/anonymous? head-class))
                         (let [o (m/owner m)]
                           (when pin? (note! :warn/anonymous-qualifier))
                           (if (and (m/class-sym? o) (not (m/anonymous? o))) o nil))
                         head-class)
            pin? (and pin? head-class)
            rt (if (and (= nm "clone") (m/array? site)) site (ret-type m))
            rt (if poly? (erasure (attr/type-of t :infer/poly-result)) rt)]
        (when poly? (note! :form/signature-polymorphic))
        (note! (if static? :form/static-call :form/instance-call))
        (update (r (cond
             static?
             (let [head (cond-> (member (class-ref env head-class) nm)
                          pin? (m+ (param-tags env m)))
                   call (apply list head afs)]
               (if (and recv (not (identical? recv 'super))) (list 'do recv call) call))
             poly?
             ;; the call site descriptor: param-tags from javac's call site types, the
             ;; result type as a tag on the call
             (let [call (apply list (m+ (member (class-ref env head-class) (str "." nm))
                                        [:param-tags (mapv #(erased-form env %) (m/mt-params (mtype)))])
                               recv afs)]
               (if (or (m/object? rt) (m/void? rt)) call (tag call (erased-form env rt))))
             pin?
             (apply list (m+ (member (class-ref env head-class) (str "." nm)) (param-tags env m))
                    recv afs)
             :else (apply list (symbol (str "." nm)) recv afs))
           rt)
                :f #(with-type-args env % (tr/f t :typeargs)))))))

(defn- with-type-args
  "Call `form` with the type annotations of its explicit type arguments `targs` (trees) on the
  method symbol: ^{:type-args [...]} (§8.4)."
  [env form targs]
  (if (and (seq? form) (some #(type-annotated? (attr/type-of % :names/type-tree)) targs))
    (let [ta [:type-args (mapv #(type-form env (attr/type-of % :names/type-tree)) targs)]]
      (note! :form/type-args)
      (if (= 'do (first form))
        (apply list (concat (butlast form) [(with-type-args env (last form) targs)]))
        (apply list (m+ (first form) ta) (rest form))))
    form))

(defn- new-class [env t]
  (if (tr/f t :def)
    (let [x (anon-form env t)] (assoc x :f (capture-values env (tr/f t :def) (:f x))))
    (let [c (m/tsym (attr/type-of t :types/new))
          m (attr/constructor t)
          ve (attr/varargs-element t m)
          site (m/stype c)
          loose? (loose-varargs? env m site true ve)
          [afs _ nodes] (call-args env m (attr/constructor-type t m) (tr/f t :args) ve loose?)
          encl (when (tr/f t :encl) (coerce env (ex env (tr/f t :encl)) (erasure (attr/type-of (tr/f t :encl) :types/expr))))
          pin? (pin-needed? :ctor (current-class env) c m nodes (and ve loose?))
          cr (class-ref env c)]
      (note! :form/new)
      (r (cond
           (tr/f t :encl) (do (note! :form/qualified-new)
                         (apply list (cond-> '.new pin? (m+ (param-tags env m))) encl cr afs))
           ;; a class type with type annotations: (new ^{A true} (C ^{B true} T) args)
           (type-annotated? (attr/type-of (tr/f t :clazz) :names/type-tree))
           (apply list 'new (cond-> (type-form env (attr/type-of (tr/f t :clazz) :names/type-tree)) pin? (m+ (param-tags env m))) afs)
           pin? (apply list (m+ (member cr "new") (param-tags env m)) afs)
           :else (apply list (if (symbol? cr) (symbol (str cr ".")) (member cr ".")) afs))
         (erasure (attr/type-of t :types/new))))))

(defn- annotate-dims
  "Array type form `f` with the annotation items `dims` (one seq per dimension, outermost first)
  on its dimensions: `new String @B [3]`'s @B, which javac keeps on the tree, not on the type."
  [f dims]
  (if (every? empty? dims)
    f
    (let [[d & more] dims
          inner (cond
                  (and (seq? f) (= 'array (first f))) (second f)
                  (and (symbol? f) (namespace f) (re-matches #"\d+" (name f)))
                  (let [n (parse-long (name f))]
                    (if (= 1 n) (symbol (namespace f)) (symbol (namespace f) (str (dec n)))))
                  (instance? CRef f) (when (pos? (:dims f)) (update f :dims dec))
                  :else nil)]
      (if (nil? inner)
        f
        (let [old (f/items f)
              g (list 'array (annotate-dims inner more))
              g (if (seq old) (apply m+ g old) g)]
          (if (seq d) (apply m+ g d) g))))))

(defn- new-array [env t]
  (let [ty (erasure (attr/type-of t :types/new-array))
        elem (m/elemtype ty)]
    (note! :form/new-array)
    (letfn [(init [a ety]
              (mapv (fn [e]
                      (if (and (tr/is? e :NEWARRAY) (nil? (tr/f e :elemtype)))
                        (init e (m/elemtype (erasure (attr/type-of e :types/new-array))))
                        (coerce env (ex env e) ety)))
                    (tr/f a :elems)))]
      (let [tf (annotate-dims (code-type-form env (attr/type-of t :types/new-array))
                              (map #(annotation-items env %) (tr/f t :dimAnnotations)))]
        (r (if (tr/f t :elems)
             (list 'new tf (init t elem))
             (apply list 'new tf
                    (map #(coerce env (ex env %) (int-type)) (tr/f t :dims))))
           ty)))))

;;; ------------------------------------------------------------------------------------------
;;; Operators (§5.4)

(def int-ops
  {"PLUS" 'unchecked-add-int "MINUS" 'unchecked-subtract-int "MUL" 'unchecked-multiply-int
   "DIV" 'unchecked-divide-int "MOD" 'unchecked-remainder-int "BITAND" 'bit-and-int
   "BITOR" 'bit-or-int "BITXOR" 'bit-xor-int "SL" 'bit-shift-left-int "SR" 'bit-shift-right-int
   "USR" 'unsigned-bit-shift-right-int})

(def long-ops
  {"PLUS" 'unchecked-add "MINUS" 'unchecked-subtract "MUL" 'unchecked-multiply
   "DIV" 'unchecked-divide "MOD" 'unchecked-remainder "BITAND" 'bit-and "BITOR" 'bit-or
   "BITXOR" 'bit-xor "SL" 'bit-shift-left "SR" 'bit-shift-right "USR" 'unsigned-bit-shift-right})

(def float-ops
  {"PLUS" 'unchecked-add-float "MINUS" 'unchecked-subtract-float
   "MUL" 'unchecked-multiply-float "DIV" 'unchecked-divide-float
   "MOD" 'unchecked-remainder-float})

(def double-ops
  {"PLUS" 'unchecked-add "MINUS" 'unchecked-subtract "MUL" 'unchecked-multiply
   "DIV" 'unchecked-divide "MOD" 'unchecked-remainder})

(def cmp-ops {"LT" '< "GT" '> "LE" '<= "GE" '>=})

(defn- op-sym
  "The operator for binary tag `tg` on operands of (promoted) type `t`."
  [tg t]
  (let [table (case (tag-name t)
                ("INT" "SHORT" "BYTE" "CHAR") int-ops
                "LONG" long-ops
                "FLOAT" float-ops
                "DOUBLE" double-ops
                nil)]
    (get table tg)))

(defn- operator-params [t]
  (vec (m/mparams (attr/operator t))))

(defn- flatten-concat
  "Operands of a string concatenation chain. A constant operand that is itself a
  concatenation stays one operand (javac's StringConcat takes it as one constant)."
  ([t] (flatten-concat t true))
  ([t top?]
   (let [t (tr/skip-parens t)]
     (if (and (tr/is? t :PLUS)
              (m/string-type? (attr/type-of t :types/expr))
              (or top? (nil? (m/type-const (attr/type-of t :types/constant)))))
       (concat (flatten-concat (tr/f t :lhs) false) (flatten-concat (tr/f t :rhs) false))
       [t]))))

(defn- concat-operand
  "The form of string concatenation operand tree `o` converted to result `x`. Operands are
  converted by their own type (an int literal needs no conversion since its digits are the
  same); a generic one of type String is cast to String, since javac's operator for it takes a
  String (TransTypes)."
  [env o x]
  (let [t (attr/type-of o :types/expr)]
    (if (and (m/string-type? t) (m/type? (:t x)) (not (m/string-type? (:t x))))
      (coerce env x (erasure t))
      (:f x))))

(defn- float-compare-operand [env x]
  (if (and (#{"INT" "LONG" "SHORT" "BYTE" "CHAR"} (some-> (atype x) tag-name)))
    (do (note! :conv/float-promotion) (list 'unchecked-float (:f x)))
    (:f x)))

(defn- logic-form
  "Java's non-short-circuit boolean & | ^ over results `a` and `b`."
  [env tg a b]
  (let [both-pure (and (pure? (:f a)) (pure? (:f b)))
        build (fn [x y] (case tg
                          "BITAND" (list (h env 'and) x y)
                          "BITOR" (list (h env 'or) x y)
                          "BITXOR" (list (h env 'not) (list '= x y))))]
    (note! :form/boolean-logic)
    (if (or both-pure (= tg "BITXOR"))
      (build (:f a) (:f b))
      (let [ta (gensym! env "a") tb (gensym! env "b")]
        (list 'let [ta (:f a) tb (:f b)] (build ta tb))))))

(defn binary-op
  "Form for binary operator tag `tg` with operator parameter types `ps` on converted operands."
  [env tg ps result a b]
  (let [[pa pb] ps]
    (cond
      (and (= tg "PLUS") (m/string-type? result))
      (list (h env 'java-str) (:f a) (:f b))
      (#{"AND" "OR"} tg)
      (list (h env (if (= tg "AND") 'and 'or)) (test-form env a) (test-form env b))
      (and (#{"BITAND" "BITOR" "BITXOR"} tg) (= "BOOLEAN" (tag-name pa)))
      (logic-form env tg (assoc a :f (test-form env a)) (assoc b :f (test-form env b)))
      (#{"EQ" "NE"} tg)
      (let [refs? (not (prim? pa))
            af (if refs? (:f a) (coerce env a pa))
            bf (if refs? (:f b) (coerce env b pb))
            float? (= "FLOAT" (tag-name pa))
            af (if float? (float-compare-operand env a) af)
            bf (if float? (float-compare-operand env b) bf)
            eq (cond
                 (and refs? (nil? bf) (= :null (:t b))) (if (= tg "EQ") (list (h env 'nil?) af) (list (h env 'some?) af))
                 (and refs? (nil? af) (= :null (:t a))) (if (= tg "EQ") (list (h env 'nil?) bf) (list (h env 'some?) bf))
                 refs? (list (h env 'identical?) af bf)
                 (= "BOOLEAN" (tag-name pa)) (list '= af bf)
                 :else (list '== af bf))]
        (if (and (= tg "NE") (not (#{'nil? 'some?} (first eq))) (not (#{"nil?" "some?"} (name (first eq)))))
          (list (h env 'not) eq)
          eq))
      (cmp-ops tg)
      (let [float? (= "FLOAT" (tag-name pa))]
        (list (cmp-ops tg)
              (if float? (float-compare-operand env a) (coerce env a pa))
              (if float? (float-compare-operand env b) (coerce env b pb))))
      :else
      (let [shift? (#{"SL" "SR" "USR"} tg)
            sym (op-sym tg (if shift? pa result))]
        (when-not sym (throw (ex-info (str "no operator for " tg " " pa) {})))
        (list (h env sym) (coerce env a pa) (coerce env b (if shift? pb pb)))))))

(declare has-patterns? pattern-bool cond-form pattern-binds dup-sides)

(defn- binary [env t]
  (let [tg (tr/tag-name t)
        result (erasure (attr/type-of t :types/expr))]
    (note! (keyword "op" tg))
    (cond
      (and (#{"AND" "OR"} tg) (has-patterns? t)) (r (pattern-bool env t) result)
      :else
    (if (and (= tg "PLUS") (m/string-type? result))
      (do (note! :form/java-str)
          (r (apply list (h env 'java-str)
                    (map (fn [o] (concat-operand env o (ex env o)))
                         (flatten-concat t)))
             result))
      (r (binary-op env tg (operator-params t) result (ex env (tr/f t :lhs)) (ex env (tr/f t :rhs)))
         result)))))

(defn- unary-value [env t]
  (let [tg (tr/tag-name t)
        x (when-not (and (= tg "NOT") (has-patterns? (tr/f t :arg))) (ex env (tr/f t :arg)))
        [p] (operator-params t)
        result (erasure (attr/type-of t :types/expr))]
    (note! (keyword "op" tg))
    (case tg
      "NOT" (r (if (has-patterns? (tr/f t :arg)) (pattern-bool env t) (list (h env 'not) (test-form env x))) result)
      ;; unary numeric promotion written out (+b of a byte is an int: JLS 15.15.3)
      "POS" (if (= :lit-int (:t x))
              x ;; +1: the literal itself, an int constant
              (r (coerce env x p (and (prim? (:t x)) (not (same? (:t x) p)))) result))
      "NEG" (if (and (number? (:f x)) false)
              x
              (r (list (h env (case (tag-name p)
                                ("INT" "SHORT" "BYTE" "CHAR") 'unchecked-negate-int
                                "LONG" 'unchecked-negate
                                "FLOAT" 'unchecked-negate-float
                                "DOUBLE" 'unchecked-negate))
                       (coerce env x p))
                 result))
      "COMPL" (r (list (h env (if (= "LONG" (tag-name p)) 'bit-not 'bit-not-int)) (coerce env x p))
                 result))))

;;; ------------------------------------------------------------------------------------------
;;; Assignments, compound assignments, increments (§5.4, §7.6)

(def ^:dynamic *hoistable*
  "Postfix increments (JCUnary trees, by identity) whose update may move out of the
  expression: before it (binding the old value) or after the statement."
  #{})
(def ^:dynamic *hoisted* nil)

(defn- tree-children [x] (tr/children x))

(declare mutable?)

(defn- captured-mutables
  "The forms of the ^:mutable locals of env that class or lambda tree `t` refers to (captures)."
  [env t]
  (distinct
   (for [x (tree-seq tr/tree? tree-children t)
         :when (tr/is? x :IDENT)
         :let [sym (attr/local-of x :capture)]
         :when (and sym (mutable? sym))
         :let [f (get (:locals env) sym)]
         :when f]
     f)))

(defn- capture-values
  "Java captures only effectively final locals, so a captured local that the forms make
  ^:mutable (a blank final, assigned once before) is rebound immutably around the capturing
  `form`: (let [x x] form)."
  [env t form]
  (if-let [cs (seq (captured-mutables env t))]
    (do (note! :form/capture-rebind)
        (list (h env 'let) (vec (mapcat (fn [c] [(with-meta c nil) c]) cs)) form))
    form))

(defn- all-trees [t]
  (tree-seq #(and (tr/tree? %) (not (tr/is? % :CLASSDEF))) tree-children t))

(defn hoistable-increments
  "The postfix increments in expression `e` evaluated unconditionally, on a variable that `e`
  does not otherwise mention (a local, or a field when `e` calls nothing)."
  [e]
  (let [trees (all-trees e)
        effects? (some #(#{:APPLY :NEWCLASS :ASSIGN :LAMBDA :REFERENCE} (tr/tag %)) trees)
        effects? (or effects? (some tr/assignop? trees))
        ;; the uses of a candidate's variable: a local's by scope (JFS71), a field's, only without
        ;; effects, by the symbols of the names
        uses (delay (frequencies (keep #(when (#{:IDENT :SELECT} (tr/tag %)) (attr/sym % :hoist))
                                       trees)))
        local-uses (fn [loc] (count (filter #(and (tr/is? % :IDENT) (identical? loc (attr/local-of % :hoist))) trees)))
        cands (volatile! #{})]
    (letfn [(walk [x]
              (cond
                (tr/is? x :CONDEXPR) (walk (tr/f x :cond))
                (#{:AND :OR} (tr/tag x))
                (walk (tr/f x :lhs))
                (#{:LAMBDA :CLASSDEF :SWITCH_EXPRESSION :NEWCLASS} (tr/tag x)) nil
                :else
                (do (when (#{:POSTINC :POSTDEC} (tr/tag x))
                      (let [a (tr/skip-parens (tr/f x :arg))]
                        (when (tr/is? a :IDENT)
                          (if-let [loc (attr/local-of a :hoist)]
                            (when (= 1 (local-uses loc))
                              (vswap! cands conj x))
                            (when (and (not effects?) (= 1 (@uses (attr/sym a :hoist))))
                              (vswap! cands conj x))))))
                    (run! walk (tree-children x)))))]
      (walk e))
    (java.util.Collections/newSetFromMap (java.util.IdentityHashMap.))
    (let [s (java.util.Collections/newSetFromMap (java.util.IdentityHashMap.))]
      (doseq [c @cands] (.add s c))
      (set s))))

(defn with-hoisting
  "Convert expression `e` with `f` (env e -> form), moving postfix increments out: :after the
  statement (returns [form set!...]) or :before it (returns a let form)."
  [env e mode f]
  (let [h (hoistable-increments e)]
    (if (empty? h)
      [(f env e)]
      (binding [*hoistable* h
                *hoisted* (atom {:mode mode :incs []})]
        (let [form (f env e)
              incs (:incs @*hoisted*)]
          (cond
            (empty? incs) [form]
            (= mode :after) (into [form] (map #(nth % 2) incs))
            :else [(apply list 'let (vec (mapcat (fn [[v g _]] [v g]) incs))
                          (concat (map #(nth % 2) incs) [form]))]))))))

(defn- place
  "An assignable place for lhs tree `t`: {:get form :set (fn [v] form) :t type :binds [..]}."
  [env t want-pure?]
  (let [t (tr/skip-parens t)]
    (cond
      (tr/is? t :IDENT)
      (let [x (ident env t)
            f (:f x)
            ;; a field of a type variable (d = getD() of a D d), as for a select below
            vt (:t x)
            jt (erasure (attr/type-of t :types/expr))
            generic? (and jt vt (m/type? vt) (not (prim? vt)) (not (prim? jt)) (not (subtype? vt jt)))]
        {:get (if generic? (cast-form env f jt) f) :set (fn [v] (list 'set! f v))
         :t (if generic? jt vt) :binds [] :set-t (when generic? vt)})
      (tr/is? t :SELECT)
      (let [fa t
            sym (attr/sym fa :select)
            nm (str (tr/f fa :name))
            q (tr/f fa :selected)]
        (if (or (m/static? sym) (type-expr? q))
          (let [x (select env fa)
                f (:f x)]
            (if (and (seq? f) (= 'do (first f)))
              {:get (last f) :set (fn [v] (list 'set! (last f) v)) :t (:t x) :binds [(gensym! env "_") (second f)]}
              {:get f :set (fn [v] (list 'set! f v)) :t (:t x) :binds []}))
          (let [qf (coerce env (ex env q) (qual-type q))
                [qf binds] (if (and want-pure? (not (pure? qf)))
                             (let [s (gensym! env "o")] [s [s qf]])
                             [qf []])
                acc (list (symbol (str ".-" nm)) qf)
                ;; a field of a type variable read as its instantiation (val.n++ of a T n as
                ;; an Integer): javac's checkcast written out
                vt (var-type sym)
                jt (erasure (attr/type-of t :types/expr))
                generic? (and jt (not (prim? vt)) (not (prim? jt)) (not (subtype? vt jt)))]
            {:get (if generic? (cast-form env acc jt) acc) :set (fn [v] (list 'set! acc v))
             :t (if generic? jt vt) :binds binds
             ;; the type the compiler gives the set!'s value: the field's erased one
             :set-t (when generic? vt)})))
      (tr/is? t :INDEXED)
      (let [aa t
            af (coerce env (ex env (tr/f aa :indexed)) (erasure (attr/type-of (tr/f aa :indexed) :types/expr)))
            if (coerce env (ex env (tr/f aa :index)) (int-type))
            [af b1] (if (and want-pure? (not (pure? af))) (let [s (gensym! env "arr")] [s [s af]]) [af []])
            [if b2] (if (and want-pure? (not (pure? if))) (let [s (gensym! env "i")] [s [s if]]) [if []])]
        {:get (list (h env 'aget) af if) :set (fn [v] (list (h env 'aset) af if v))
         :t (erasure (attr/type-of aa :types/expr)) :binds (into b1 b2)})
      :else (throw (ex-info (str "unsupported assignment target " (kind-of t)) {})))))

(defn- with-binds [binds form]
  (if (seq binds) (list 'let (vec binds) form) form))

(defn- assign [env t]
  (let [p (place env (tr/f t :lhs) false)
        v (coerce env (ex env (tr/f t :rhs)) (erasure (attr/type-of (tr/f t :lhs) :types/expr)))]
    (note! :form/set!)
    (r (with-binds (:binds p) ((:set p) v))
       ;; the value of an assignment to a field of a generic type (y = d = getD(), d a D) is
       ;; the field's erased type to the compiler: javac's type is then written as a cast
       (or (:set-t p) (erasure (attr/type-of (tr/f t :lhs) :types/expr))))))

(defn- narrow-to
  "Form `f` of type `from` converted to the variable type `to` as Java's compound assignment
  does (implicit narrowing written out, boxing left implicit)."
  [env f from to]
  (let [to-prim (if (prim? to) to (m/unboxed to))]
    (cond
      (nil? to-prim) f
      (or (same? from to-prim) (m/widens? from to-prim)) f
      :else (list (narrow-op (tag-name to-prim)) f))))

(defn- literal-branches
  "A conditional form of integer literal branches with the branches as constants of primitive
  type `pt` (long, float or double): javac types the constants of a compound assignment's
  conditional operand by the operator (Gen.visitConditional)."
  [form pt]
  (cond
    (and (seq? form) (= 'if (first form)) (= 4 (count form)))
    (let [[_ c a b] form] (list 'if c (literal-branches a pt) (literal-branches b pt)))
    (integer? form) (case (tag-name pt)
                      "LONG" (list 'long form)
                      "DOUBLE" (double form)
                      "FLOAT" (list 'float (double form))
                      form)
    :else form))

(defn- assign-op [env t]
  (let [tg (tr/tag-name t)
        base (str/replace tg "_ASG" "")
        lt (erasure (attr/type-of (tr/f t :lhs) :types/expr))
        p (place env (tr/f t :lhs) true)
        [pa pb] (operator-params t)
        result (m/mret (attr/operator t))
        rhs (ex env (tr/f t :rhs))
        rhs (if (and (tr/is? (tr/skip-parens (tr/f t :rhs)) :CONDEXPR)
                     (#{"LONG" "FLOAT" "DOUBLE"} (tag-name pb))
                     (= :lit-int (:t rhs)))
              (assoc rhs :f (literal-branches (:f rhs) pb) :t pb)
              rhs)
        cur {:f (:get p) :t (:t p)}
        val (if (and (= base "PLUS") (m/string-type? lt))
              (list (h env 'java-str) (:get p) (concat-operand env (tr/f t :rhs) rhs))
              (narrow-to env (binary-op env base [pa pb] (erasure result) cur rhs) (erasure result) lt))]
    (note! (keyword "op" tg))
    (r (with-binds (:binds p) ((:set p) val)) (or (:set-t p) lt))))

(defn- inc-dec [env t value?]
  (let [tg (tr/tag-name t)
        inc? (#{"PREINC" "POSTINC"} tg)
        post? (#{"POSTINC" "POSTDEC"} tg)
        lt (erasure (attr/type-of (tr/f t :arg) :types/expr))
        pt (if (prim? lt) lt (m/unboxed lt))
        p (place env (tr/f t :arg) true)
        g (:get p)
        newv (case (tag-name pt)
               "INT" (list (h env (if inc? 'unchecked-inc-int 'unchecked-dec-int)) g)
               ("SHORT" "BYTE" "CHAR") (list (narrow-op (tag-name pt))
                                             (list (h env (if inc? 'unchecked-inc-int 'unchecked-dec-int)) g))
               "LONG" (list (h env (if inc? 'unchecked-inc 'unchecked-dec)) g)
               "DOUBLE" (list (h env (if inc? 'unchecked-inc 'unchecked-dec)) g)
               "FLOAT" (list (h env (if inc? 'unchecked-add-float 'unchecked-subtract-float)) g 1))
        setf ((:set p) newv)]
    (note! (keyword "op" tg))
    (r (if (and value? post? *hoisted* (contains? *hoistable* t))
         (let [mode (:mode @*hoisted*)
               v (if (= mode :after) g (gensym! env (str/replace (str g) #"[^A-Za-z0-9_$]" "")))]
           (note! :flow/hoisted-increment)
           (swap! *hoisted* update :incs conj [v g setf])
           v)
         (if (and value? post?)
         (let [old (gensym! env "old")]
           (list 'let (into (vec (:binds p)) [old g]) setf old))
         (with-binds (:binds p) setf)))
       (if (and value? (not post?) (:set-t p)) (:set-t p) lt))))

;;; ------------------------------------------------------------------------------------------
;;; Casts, instanceof, conditionals

(defn- poly-call? [e]
  (let [e (tr/skip-parens e)]
    (and (tr/is? e :APPLY)
         (let [m (attr/symbol-of (tr/f e :meth) :method)]
           (and (m/method-sym? m) (m/sig-poly? m))))))

(defn- type-cast [env t]
  (let [x (ex env (tr/f t :expr))
        target (or (attr/type-of (tr/f t :clazz) :names/type-tree) (attr/type-of t :types/expr))
        te (erasure target)
        from (:t x)]
    (note! :form/cast)
    (cond
      ;; a signature polymorphic call takes its result type from the cast (JLS 15.12.3)
      (poly-call? (tr/f t :expr)) (r (if (some #(and (vector? %) (= :tag (first %))) (f/items (:f x)))
                                  (:f x)
                                  (tag (:f x) (erased-form env te)))
                                te)
      (prim? te)
      (cond
        (= from :lit-int)
        (if (= "INT" (tag-name te)) (assoc (r (:f x) :lit-int) :vals (:vals x))
            (r (list (narrow-op (tag-name te)) (:f x)) te))
        (prim? from)
        (cond
          (same? from te) (r (:f x) te)
          (m/widens? from te) (r (list (widen-op (tag-name te)) (:f x)) te)
          :else (r (list (narrow-op (tag-name te)) (:f x)) te))
        :else ;; unboxing (with a cast from non-wrappers), then widening
        (let [u (m/unboxed from)
              [f u] (if u
                      [(unbox-call env (:f x) from) u]
                      (let [w (or (some-> (m/unboxed-type (attr/type-of (tr/f t :expr) :types/expr)) (#(when (prim? %) (m/boxed %))))
                                  (m/boxed te))]
                        [(unbox-call env (cast-form env (:f x) w) w) (m/unboxed w)]))]
          (r (if (same? u te) f (list (widen-op (tag-name te)) f)) te)))
      (m/components target)
      (let [needed (remove #(and (m/type? from) (subtype? from %)) (m/components target))]
        (note! :form/intersection-cast)
        (cond
          (empty? needed) (r (if (same? from te) (:f x) (hint env (:f x) te)) te)
          (= 1 (count needed)) (r (cast-form env (:f x) (first needed)) (erasure (first needed)))
          :else (r (list (h env 'cast) (apply list '& (map #(erased-form env %) needed)) (:f x))
                   (erasure (first needed)))))
      (= from :null) (r (cast-form env nil te) te)
      (prim? from) (let [b (if (= from :lit-int) (int-type) from)]
                     (r (box-call env (:f x) b) (erasure (m/boxed b))))
      (= from :lit-int) (r (box-call env (:f x) (int-type)) (erasure (m/boxed (int-type))))
      ;; javac emits no checkcast for an upcast, except to an array type (Gen.visitTypeCast
      ;; asks asSuper, which arrays answer only for Object and the array interfaces)
      (and (subtype? from te) (not (and (m/array? te) (not (same? from te)))))
      (if (same? from te)
        x
        (let [f (hint env (:f x) te)]
          ;; a literal takes no hint: its own type stays the compiler's ((Object) "s" chooses
          ;; v(Object) by a pin, call-args)
          (if (identical? f (:f x)) (assoc (r f te) :stub-t from) (r f te))))
      (type-annotated? target) (r (list (h env 'cast) (code-type-form env target) (:f x)) te)
      :else (r (cast-form env (:f x) te) te))))

(defn- unconditional-by-args?
  "Is nested type pattern `np` of a record pattern unconditional for its component (it matches null:
  TransPatterns' allowNull, the component's full type at the pattern's type a subtype of the
  pattern's type, boxed) where the component's declared type, which the Java forms' analysis knows
  erased, is not (Box<String>(String s) of a record Box<T>)? `comp` is attr/record-components' [full
  declared] for it. The form then says so, ^:unconditional, and the analysis does not test it (JCS114
  (a), doc/classes/JAVA-CONFORMANCE-SURVEY.md, \"As built: JC4b\"; JN9f)."
  [[full declared] np]
  (let [bt (erasure (m/stype (attr/sym (tr/f np :var) :binding)))
        bt (if (m/prim? bt) (m/boxed bt) bt)]
    (and (m/subtype? full bt) (not (m/subtype? declared bt)))))

(defn- pattern-form
  "The form of pattern tree `p`, adding its bindings to the env atom `penv`."
  [env penv p]
  (cond
    (tr/is? p :ANYPATTERN) (do (note! :form/any-pattern) '_)
    (tr/is? p :BINDINGPATTERN)
    (let [v (tr/f p :var)
          sym (attr/sym v :binding)
          nm (str (tr/f v :name))
          s (symbol (if (= nm "") "_" nm))
          implicit? (or (nil? (tr/f v :vartype)) (tr/var-decl? v))]
      (note! :form/binding-pattern)
      (swap! penv (fn [e] (-> e (assoc-in [:locals sym] s) (update :names conj nm))))
      (let [s (if (mutable? sym) (m+ s :mutable) s)]
        (cond
          (not implicit?) (tag s (type-form env (m/stype sym)))
          ;; var of a record component of a type variable (Box<String>(var s)): the
          ;; compiler sees the component's erasure, javac's inferred type is written
          (not (m/object? (erasure (m/stype sym)))) (tag s (erased-form env (erasure (m/stype sym))))
          :else s)))
    (tr/is? p :RECORDPATTERN)
    (let [rp p
          comps (delay (attr/record-components rp))]
      (note! :form/record-pattern)
      (apply list (class-ref env (m/tsym (attr/type-of rp :names/record-pattern)))
             (map-indexed (fn [i np]
                            (let [f (pattern-form env penv np)]
                              (if (and (tr/is? np :BINDINGPATTERN) (unconditional-by-args? (nth @comps i) np))
                                (m+ f :unconditional)
                                f)))
                          (tr/f rp :nested))))
    :else (throw (ex-info "unknown pattern" {}))))

(declare pattern-instanceof?)

(defn dup-sides
  "The branches of a condition that cond-form repeats: #{:then :else}."
  [c]
  (let [c (tr/skip-parens c)
        tg (tr/tag-name c)]
    (cond
      (pattern-instanceof? c) #{}
      (and (= tg "NOT") (has-patterns? (tr/f c :arg)))
      (set (map {:then :else :else :then} (dup-sides (tr/f c :arg))))
      (and (= tg "AND") (has-patterns? c))
      (conj (into (dup-sides (tr/f c :lhs)) (dup-sides (tr/f c :rhs))) :else)
      (and (= tg "OR") (has-patterns? c))
      (conj (into (dup-sides (tr/f c :lhs)) (dup-sides (tr/f c :rhs))) :then)
      :else #{})))

(defn- pattern-instanceof? [c]
  (and (tr/is? c :TYPETEST) (tr/pattern? (tr/f c :pattern))))

(defn has-patterns?
  "True when condition `c` contains a pattern instanceof outside lambdas and classes."
  [c]
  (letfn [(walk [x]
            (cond
              (pattern-instanceof? x) true
              (#{:LAMBDA :CLASSDEF :SWITCH_EXPRESSION} (tr/tag x)) false
              :else (some walk (tree-children x))))]
    (boolean (walk c))))

(defn- pattern-vars [p]
  (set (for [x (all-trees p) :when (tr/is? x :BINDINGPATTERN)]
         (attr/sym (tr/f x :var) :binding))))

(defn pattern-binds
  "{:t vars :f vars}: the pattern variables condition `c` introduces when true and when false
  (JLS 6.3.1)."
  [c]
  (let [c (tr/skip-parens c)
        none {:t #{} :f #{}}]
    (cond
      (pattern-instanceof? c) {:t (pattern-vars (tr/f c :pattern)) :f #{}}
      (tr/is? c :NOT)
      (let [{:keys [t f]} (pattern-binds (tr/f c :arg))] {:t f :f t})
      (tr/is? c :AND)
      {:t (into (:t (pattern-binds (tr/f c :lhs))) (:t (pattern-binds (tr/f c :rhs)))) :f #{}}
      (tr/is? c :OR)
      {:t #{} :f (into (:f (pattern-binds (tr/f c :lhs))) (:f (pattern-binds (tr/f c :rhs))))}
      :else none)))

(defn cond-form
  "The form testing condition `c` that runs (then-fn env') or (else-fn env') with the pattern
  variables in scope where Java has them (§5.8 if-instance). A branch may be repeated."
  [env c then-fn else-fn]
  (let [c (tr/skip-parens c)
        tg (tr/tag-name c)]
    (cond
      (pattern-instanceof? c)
      (let [io c
            x (ex env (tr/f io :expr))
            penv (atom env)
            pf (pattern-form env penv (tr/f io :pattern))]
        (note! :form/if-instance)
        (list (h env 'if-instance) [pf (:f x)] (then-fn @penv) (else-fn env)))
      (and (= tg "NOT") (has-patterns? (tr/f c :arg)))
      (cond-form env (tr/f c :arg) else-fn then-fn)
      (and (= tg "AND") (has-patterns? c))
      (do (note! :flow/pattern-and)
          (cond-form env (tr/f c :lhs)
                     (fn [e] (cond-form e (tr/f c :rhs) then-fn else-fn))
                     else-fn))
      (and (= tg "OR") (has-patterns? c))
      (do (note! :flow/pattern-or)
          (cond-form env (tr/f c :lhs) then-fn
                     (fn [e] (cond-form e (tr/f c :rhs) then-fn else-fn))))
      :else (list 'if (test-form env (ex env c)) (then-fn env) (else-fn env)))))

(defn- pattern-bool
  "A boolean expression with patterns, as a value."
  [env c]
  (let [c (tr/skip-parens c)
        tg (tr/tag-name c)]
    (cond
      (pattern-instanceof? c) (cond-form env c (fn [_] true) (fn [_] false))
      (= tg "NOT") (list (h env 'not) (test-form env (ex env (tr/f c :arg))))
      (= tg "AND")
      (let [a (tr/f c :lhs) b (tr/f c :rhs)]
        (if (has-patterns? a)
          (cond-form env a (fn [e] (test-form e (ex e b))) (fn [_] false))
          (list (h env 'and) (test-form env (ex env a)) (test-form env (ex env b)))))
      (= tg "OR")
      (let [a (tr/f c :lhs) b (tr/f c :rhs)]
        (if (has-patterns? a)
          (cond-form env a (fn [_] true) (fn [e] (test-form e (ex e b))))
          (list (h env 'or) (test-form env (ex env a)) (test-form env (ex env b))))))))

(defn- instance-of [env t]
  (if (tr/pattern? (tr/f t :pattern))
    (r (pattern-bool env t) (bool-type))
    (let [x (ex env (tr/f t :expr))]
      (note! :form/instance?)
      (r (list (h env 'instance?) (code-type-form env (attr/type-of (tr/f t :pattern) :names/type-tree)) (:f x)) (bool-type)))))

(defn- conditional [env t]
  (let [target (erasure (attr/type-of t :types/expr))
        c (when-not (has-patterns? (tr/f t :cond)) (test-form env (ex env (tr/f t :cond))))
        a (when c (ex env (tr/f t :truepart)))
        b (when c (ex env (tr/f t :falsepart)))
        branch (fn [x]
                 (if (and (prim? target) (= :lit-int (:t x)) (#{"INT"} (tag-name target)))
                   (:f x)
                   (let [f (coerce env x target true)]
                     ;; reference branches of other types than the whole: hint to it
                     (if (and (not (prim? target)) (identical? f (:f x)) (m/type? (:t x))
                              (not (same? (:t x) target)))
                       (hint env f target)
                       f))))]
    (note! :form/if)
    (cond-> (r (if c
                 (list 'if c (branch a) (branch b))
                 (cond-form env (tr/f t :cond) (fn [e] (branch (ex e (tr/f t :truepart)))) (fn [e] (branch (ex e (tr/f t :falsepart))))))
               (if (and a b (= :lit-int (:t a)) (= :lit-int (:t b))) :lit-int target))
      (and a b (= :lit-int (:t a)) (= :lit-int (:t b))) (assoc :vals (concat (:vals a) (:vals b))))))

;;; ------------------------------------------------------------------------------------------
;;; Expressions

(declare ex*)

(defn ex
  "Convert expression tree `t` to a result {:f form :t type}; :jtree is `t` (whose javac type
  coerce asks when it needs it)."
  [env t]
  (attr/framed (tr/tag t)
    (let [x (ex* env t)]
      (if (contains? x :jtree) x (assoc x :jtree t)))))

(defn- ex*
  [env t]
  (case (tr/tag t)
    :PARENS (ex env (tr/f t :expr))
    :LITERAL (literal env t)
    :IDENT (ident env t)
    :SELECT (select env t)
    :APPLY (invocation env t)
    :NEWCLASS (new-class env t)
    :NEWARRAY (new-array env t)
    :INDEXED (let [aa t
                   idx (fn idx [e acc]
                         (let [e (tr/skip-parens e)]
                           (if (tr/is? e :INDEXED)
                             (idx (tr/f e :indexed)
                                  (cons (tr/f e :index) acc))
                             [e acc])))
                   [base is] (idx aa nil)]
               (note! :form/aget)
               (r (apply list (h env 'aget) (coerce env (ex env base) (erasure (attr/type-of base :types/expr)))
                         (map #(coerce env (ex env %) (int-type)) is))
                  (erasure (attr/type-of t :types/expr))))
    :ASSIGN (assign env t)
    (:PREINC :PREDEC :POSTINC :POSTDEC) (inc-dec env t true)
    (:POS :NEG :NOT :COMPL) (unary-value env t)
    :TYPECAST (type-cast env t)
    :TYPETEST (instance-of env t)
    :CONDEXPR (conditional env t)
    :LAMBDA (let [x (lambda-form env t)] (assoc x :f (capture-values env t (:f x))))
    :REFERENCE (method-ref-form env t)
    :SWITCH_EXPRESSION (switch-form env t nil)
    (cond
      (tr/assignop? t) (assign-op env t)
      (tr/binary? t) (binary env t)
      :else (throw (ex-info (str "unsupported expression " (kind-of t)) {:kind (kind-of t)})))))

(defn ex-stmt
  "Convert an expression used as a statement."
  [env t]
  (let [t (tr/skip-parens t)]
    (if (#{:PREINC :PREDEC :POSTINC :POSTDEC} (tr/tag t))
      (:f (attr/framed (tr/tag t) (inc-dec env t false)))
      (if (poly-call? t)
        (tag (:f (ex env t)) 'void)
        (:f (ex env t))))))

;;; ------------------------------------------------------------------------------------------
;;; Control flow analysis

(defn- const-true? [c]
  (or (nil? c)
      (let [v (m/type-const (attr/type-of c :types/constant))]
        (and v (= 1 (if (number? v) (long v) (if v 1 0)))))))

(defn- norm-target [t]
  (if (tr/is? t :LABELLED)
    (norm-target (tr/f t :body))
    t))

(defn- jumps-to
  "The jump statements (break, continue, yield) in `t` whose target is `target`, not looking
  into classes and lambdas."
  [t target pred]
  (let [found (volatile! [])
        target (norm-target target)]
    (letfn [(walk [x]
              (cond
                (nil? x) nil
                (tr/is? x :CLASSDEF) nil
                (tr/is? x :LAMBDA) nil
                (tr/tree? x)
                (do (when (and (pred x)
                               (identical? target
                                           (norm-target
                                            (when (#{:BREAK :CONTINUE :YIELD} (tr/tag x)) (attr/jump-target x)))))
                      (vswap! found conj x))
                    (run! walk (tree-children x)))))]
      (walk t))
    @found))

(defn- has-break? [t target]
  (seq (jumps-to t target #(tr/is? % :BREAK))))

(defn- has-continue? [t target]
  (seq (jumps-to t target #(tr/is? % :CONTINUE))))

(declare cn?)

(defn- case-groups-complete? [cases]
  (some (fn [c]
          (if (tr/rule-case? c)
            (let [b (tr/f c :body)] (or (not (tr/statement? b)) (cn? b)))
            false))
        cases))

(defn cn?
  "Can statement `t` complete normally (JLS 14.22, conservatively)?"
  [t]
  (case (tr/tag t)
    :RETURN false
    :THROW false
    :BREAK false
    :CONTINUE false
    :YIELD false
    :BLOCK (let [ss (tr/f t :stats)] (or (empty? ss) (cn? (last ss))))
    :IF (let [i t]
          (or (nil? (tr/f i :elsepart)) (cn? (tr/f i :thenpart)) (cn? (tr/f i :elsepart))))
    (:WHILELOOP :DOLOOP :FORLOOP) (or (not (const-true? (tr/f t :cond))) (boolean (has-break? t t)))
    :LABELLED (or (cn? (tr/f t :body)) (boolean (has-break? t t)))
    :SWITCH (let [s t
                  cases (tr/f s :cases)
                  has-default (or (attr/unconditional-pattern? s)
                                  (some (fn [c] (some #(tr/is? % :DEFAULTCASELABEL) (tr/f c :labels))) cases)
                                  (attr/exhaustive? s))]
              (or (not has-default)
                  (boolean (has-break? t t))
                  (empty? cases)
                  (let [lc (last cases)]
                    (if (tr/rule-case? lc)
                      (boolean (case-groups-complete? cases))
                      (attr/completes-normally? lc)))))
    :TRY (let [ty t]
           (and (or (cn? (tr/f ty :body)) (some #(cn? (tr/f % :body)) (tr/f ty :catchers)))
                (or (nil? (tr/f ty :finalizer)) (cn? (tr/f ty :finalizer)))))
    :SYNCHRONIZED (cn? (tr/f t :body))
    true))

;;; ------------------------------------------------------------------------------------------
;;; Statements
;;
;; ctx = {:fall forms, :jumps {key forms}, :vpos key}: :fall is what follows when the
;; statement completes normally (e.g. [(recur ...)] at the end of a loop body); :jumps maps the
;; jump targets that are equivalent to completing normally here ([:return], [:break T],
;; [:continue T], [:yield T]) to the forms that replace such a jump; :vpos names the target
;; whose value this position delivers ([:return] in a method returning a value), so that
;; `return e` here is just e.

(def ctx0 {:fall [] :jumps {} :vpos nil})

(def ^:dynamic *predeclared*
  "Local variables declared in a switch case and used in another case: bound before the switch."
  #{})

(defn- seq-ctx [ctx] ctx0)

(defn- recur-free
  "ctx for the body of try/locking: forms that jump (recur) cannot be inside, so they go after."
  [ctx]
  (let [has-recur? (fn [forms] (and (sequential? forms) (some #(and (seq? %) (#{'recur} (first %))) forms)))]
    {:fall (if (has-recur? (:fall ctx)) [] (:fall ctx))
     :jumps (into {} (remove (fn [[k v]] (has-recur? v)) (:jumps ctx)))
     :vpos (:vpos ctx)
     :after (when (has-recur? (:fall ctx)) (:fall ctx))}))

(defn- label-kw! [env target default]
  (let [lbl (:lbl env)
        t (norm-target target)]
    (or (:kw (get @lbl t))
        (let [kw (keyword default)]
          (swap! lbl assoc t {:kw kw :used false})
          kw))))

(defn- use-label! [env target]
  (let [t (norm-target target)]
    (swap! (:lbl env) update t assoc :used true)
    (:kw (get @(:lbl env) t))))

(defn- label-used? [env target]
  (:used (get @(:lbl env) (norm-target target))))

(defn- wrap-label [env target form]
  (if (label-used? env target)
    (do (note! :form/label)
        (list (h env 'label) (label-kw! env target "L") form))
    form))

(defn- loop-info [env target]
  (first (filter #(identical? (:tree %) (norm-target target)) (:loops env))))

(defn- jump-key [t]
  (case (tr/tag t)
    :BREAK [:break (norm-target (attr/jump-target t))]
    :CONTINUE [:continue (norm-target (attr/jump-target t))]
    :YIELD [:yield (attr/jump-target t)]
    :RETURN [:return]
    nil))

(defn- jump-stmt [env ctx t]
  (let [k (jump-key t)]
    (if (and (contains? (:jumps ctx) k)
             (or (not (tr/is? t :RETURN)) (nil? (tr/f t :expr)) (= (:vpos ctx) k))
             (or (not (tr/is? t :YIELD)) (= (:vpos ctx) k)))
      (do (note! :flow/elided-jump)
          (cond
            (and (tr/is? t :RETURN) (tr/f t :expr))
            (with-hoisting env (tr/f t :expr) :before (fn [env e] (coerce env (ex env e) (:ret env))))
            (tr/is? t :YIELD) [(coerce env (ex env (tr/f t :value)) (:yield-type env))]
            :else (get (:jumps ctx) k)))
      (case (tr/tag t)
        :RETURN (do (note! :form/return)
                    (if (tr/f t :expr)
                      (with-hoisting env (tr/f t :expr) :before
                        (fn [env e] (list (h env 'return) (coerce env (ex env e) (:ret env)))))
                      [(list (h env 'return))]))
        :YIELD (let [y t]
                 (note! :form/yield-break)
                 [(list (h env 'break) (use-label! env (attr/jump-target y))
                        (coerce env (ex env (tr/f y :value)) (:yield-type env)))])
        :BREAK (let [target (norm-target (attr/jump-target t))
                             li (loop-info env target)]
                         (note! :form/break)
                         [(if (and li (identical? li (first (:loops env))))
                            (list (h env 'break))
                            (list (h env 'break) (use-label! env target)))])
        :CONTINUE (let [target (norm-target (attr/jump-target t))
                                li (loop-info env target)
                                innermost? (identical? li (first (:loops env)))
                                lbl (when-not innermost? (use-label! env target))]
                            (note! :form/continue)
                            (case (:kind li)
                              :recur [(apply list (h env 'continue) (concat (when lbl [lbl]) (:args li)))]
                              :do [(list (h env 'break) (use-label! env [:body target]))]
                              [(do-form (concat (:update li)
                                                [(apply list (h env 'continue) (when lbl [lbl]))]))]))))))

(defn- default-value [t]
  (case (tag-name t)
    ("INT" "LONG" "SHORT" "BYTE") 0
    "CHAR" (list 'unchecked-char 0)
    "FLOAT" (list 'float 0.0)
    "DOUBLE" 0.0
    "BOOLEAN" false
    nil))

(def reserved-names
  "Java names that would change the meaning of forms the converter writes if they were locals."
  #{})

(defn- local-sym [env sym]
  (let [n (m/sname sym)]
    (symbol (cond (= n "") "_"
                  (#{"nil" "true" "false"} n) (str n "_")
                  :else n))))

(defn- add-local [env sym s]
  (-> env
      (assoc-in [:locals sym] s)
      (update :names conj (name s))))

(def ^:dynamic *local-names*
  "The names of the local variables and parameters of the compilation unit being converted:
  heads that simplify writes are qualified when a local could shadow them."
  #{})

(def ^:dynamic *assigned*
  "The local variables assigned somewhere in the class being converted (set by class-form)."
  #{})

(defn- mutable? [sym]
  (contains? *assigned* sym))

(defn- local-tag
  "The tag for a local of declared type `decl` whose initializer has Arbace type `init-t`."
  [env d init-t]
  (binding [*skip-anns* (mods-type-anns (tr/f d :mods))]
   (let [decl (m/stype (attr/sym d :local-decl))
        var? (or (nil? (tr/f d :vartype)) (tr/var-decl? d))]
    (cond
      ;; a type with type annotations of its own
      (and (not var?) (seq (f/items (type-form env decl)))) (type-form env decl)
      (or (= init-t :null) (= init-t :lit-int) (nil? init-t)) (if (and (= init-t :lit-int) (= "LONG" (tag-name decl))) nil
                                                                  (type-form env (if var? (erasure decl) decl)))
      (not (same? init-t decl)) (type-form env (if var? (erasure decl) decl))
      (and (not var?) (generic? decl) (not (m/tvar? decl))) (type-form env decl)
      (and (not var?) (m/tvar? decl)) (type-form env decl)
      :else nil))))

(defn- binding-for
  "[sym-form init-form env'] for local declaration `d` (with `init` result or nil). In a
  loop binding (`loop?`) a primitive type other than long, double or boolean is always tagged,
  since loop widens untagged int and float locals."
  [env d init & [loop?]]
  (let [sym (attr/sym d :local-decl)
        s (local-sym env sym)
        decl (erasure (m/stype sym))
        const? (and (m/has-flag? sym Flags/FINAL) (m/const-value sym))
        mut? (or (nil? init) (mutable? sym))
        init-f (if init (coerce env init decl) (default-value decl))
        ;; a primitive boxed into a reference type other than its box (Object o = 1, Number n =
        ;; i): the boxed form's type is the box's, not the declaration's, so the local is tagged
        ;; with its declared type (local-tag) and the forms type it as Java does (RPS85 (a))
        init-t (if init
                 (cond (identical? init-f (:f init)) (:t init)
                       (and (not (prim? decl)) (or (= :lit-int (:t init)) (prim? (:t init))))
                       (let [u (m/unboxed decl)
                             p (if (= :lit-int (:t init)) (int-type) (:t init))]
                         (m/boxed (if (and u (#{"BYTE" "SHORT" "CHAR"} (tag-name u))) u p)))
                       :else decl)
                 nil)
        tg (or (local-tag env d init-t)
               (when (and loop? (prim? decl) (not (#{"LONG" "DOUBLE" "BOOLEAN"} (tag-name decl))))
                 (m/prim-sym decl))
               ;; the compiler unifies the branches of a conditional by their class chain
               ;; only: javac's type (a common interface) is written
               ;; (and an int switch of literals would be a long)
               (when (and init (not (m/object? decl))
                          (not (#{"LONG" "DOUBLE" "BOOLEAN"} (tag-name decl)))
                          (let [it (tr/skip-parens (tr/f d :init))]
                            (or (tr/is? it :CONDEXPR) (tr/is? it :SWITCH_EXPRESSION))))
                 (if (prim? decl) (m/prim-sym decl) (type-form env (erasure decl)))))
        sf (apply m+ s (concat (when (and mut? (not const?)) [:mutable])
                               (when const? [:const])
                               (when (m/has-flag? sym Flags/FINAL) (when-not const? nil))
                               (annotation-items env (tr/f (tr/f d :mods) :annotations))
                               (when tg [[:tag tg]])))]
    (note! (if mut? :form/mutable-local :form/local))
    (when const? (note! :form/const-local))
    [sf init-f (add-local env sym s)]))

(defn- assigns-only?
  "If statement `t` is an if/else chain whose every branch is the single statement `x = e`
  for variable `sym`, the list of [cond-tree e-tree] with a final [nil e]."
  [t sym]
  (letfn [(single [s]
            (let [s (if (and (tr/is? s :BLOCK) (= 1 (count (tr/f s :stats))))
                      (first (tr/f s :stats))
                      s)]
              (when (tr/is? s :EXEC)
                (let [e (tr/skip-parens (tr/f s :expr))]
                  (when (and (tr/is? e :ASSIGN)
                             (tr/is? (tr/f e :lhs) :IDENT)
                             (identical? sym (attr/local-of (tr/f e :lhs) :assigned)))
                    (tr/f e :rhs))))))
            (chain [s]
              (if (tr/is? s :IF)
                (let [i s
                      a (single (tr/f i :thenpart))]
                  (when (and a (tr/f i :elsepart))
                    (when-let [more (chain (tr/f i :elsepart))]
                      (cons [(tr/f i :cond) a] more))))
                (when-let [e (single s)] [[nil e]])))]
    (when (tr/is? t :IF) (chain t))))

(defn- refs-sym? [t sym]
  (let [found (volatile! false)]
    (letfn [(walk [x]
              (when (and (not @found) (tr/tree? x))
                (when (and (tr/is? x :IDENT) (identical? sym (attr/local-of x :refers)))
                  (vreset! found true))
                (run! walk (tree-children x))))]
      (walk t))
    @found))

(defn- cond-chain-form [env pairs decl]
  (let [[[c e] & more] pairs
        conv (fn [env e] (coerce env (ex env e) decl))]
    (if (nil? c)
      (conv env e)
      (cond-form env c (fn [env'] (conv env' e)) (fn [env'] (cond-chain-form env' more decl))))))

(declare local-class-binding foldable-if? cond-form dup-sides match-exception-default pattern-instanceof?)

(declare stmts-1)

(defn stmts
  "Convert the statement sequence `ss` in `ctx` to a vector of forms. Iterative over the
  statements that convert one by one and over a run of local declarations, so that a long
  method (UncommonTrapStackBang's ten thousand locals) does not exhaust the stack (JCS24 (a))."
  [env ctx ss]
  (loop [acc [] ss (vec (remove #(tr/is? % :SKIP) ss))]
    (if (empty? ss)
      (into acc (:fall ctx))
      (let [r (stmts-1 env ctx ss)]
        (if (map? r)
          (recur (into acc (:prefix r)) (:more r))
          (into acc r))))))

(defn- plain-vardef?
  "Is statement s a local declaration stmts-1 converts as one binding of a let (not
  predeclared, not assigned by the if after it, not assigning itself in its initializer)?"
  [s nxt]
  (and (tr/is? s :VARDEF)
       (let [sym (attr/sym s :local-decl)]
         (and (not (contains? *predeclared* sym))
              (not (and (nil? (tr/f s :init)) nxt (assigns-only? nxt sym)))
              (not (and (tr/f s :init) (refs-sym? (tr/f s :init) sym)))))))

(defn- stmts-1
  "One step of stmts over the nonempty `ss`: the whole sequence's forms (a vector), or {:prefix
  v :more ss'}, the first statement's forms and the statements after it."
  [env ctx ss]
  (let [s (first ss)
        more (subvec ss 1)]
        (attr/framed (tr/tag s)
        (cond
          ;; a local declared in one switch case and used in another: declared before the
          ;; switch, assigned here
          (and (tr/is? s :VARDEF) (contains? *predeclared* (attr/sym s :local-decl)))
          (let [d s
                sym (attr/sym d :local-decl)
                x (get-in env [:locals sym])]
            (into (if (tr/f d :init)
                    [(list 'set! x (coerce env (ex env (tr/f d :init)) (erasure (m/stype sym))))]
                    [])
                  (stmts env ctx more)))
          ;; a run of local declarations: one let over the rest of the block, its bindings in
          ;; order (as the nested lets below merge), without recursion per declaration
          (and (plain-vardef? s (first more)) (plain-vardef? (first more) (second more))
               (= 'let (h env 'let)))
          (loop [env env bv [] ss ss]
            (let [d (first ss)]
              (if (and d (plain-vardef? d (second ss)) (= 'let (h env 'let)))
                (let [[sf init-f env'] (attr/framed (tr/tag d)
                                         (binding-for env d (when (tr/f d :init) (ex env (tr/f d :init)))))]
                  (recur env' (conj bv sf init-f) (subvec ss 1)))
                (let [body (stmts env ctx ss)]
                  (if (and (= 1 (count body)) (seq? (first body)) (= 'let (first (first body))))
                    (let [[_ bv2 & bbody] (first body)]
                      [(apply list 'let (into bv bv2) bbody)])
                    [(apply list 'let bv (if (empty? body) [nil] body))])))))
          ;; local variables: a let over the rest of the block
          (tr/is? s :VARDEF)
          (let [d s
                sym (attr/sym d :local-decl)
                nxt (first more)
                chain (when (and (nil? (tr/f d :init)) nxt) (assigns-only? nxt sym))]
            (if chain
              (let [decl (erasure (m/stype sym))
                    init (cond-chain-form env chain decl)
                    s (local-sym env sym)
                    tg (type-form env (if (tr/var-decl? d) decl (m/stype sym)))
                    env' (add-local env sym s)]
                (note! :flow/assigned-by-if)
                [(apply list (h env 'let)
                        [(apply m+ s (concat (when (some #(contains? (assigned-syms %) sym) (subvec more 1)) [:mutable])
                                             (when-not (m/object? decl) [[:tag tg]])))
                         init]
                        (or (seq (stmts env' ctx (subvec more 1))) [nil]))])
              (let [self-ref? (and (tr/f d :init) (refs-sym? (tr/f d :init) sym))
                    ;; an initializer that assigns the local itself (int r = switch (i) { case
                    ;; ... -> { r = 1; yield r; } }, JLS 6.3: in scope in its own initializer):
                    ;; declared with its default value, then assigned
                    [sf init-f env'] (binding-for env d (when (and (tr/f d :init) (not self-ref?)) (ex env (tr/f d :init))))
                    body (cond->> (stmts env' ctx more)
                           self-ref? (into [(list 'set! (get-in env' [:locals sym])
                                                  (coerce env' (ex env' (tr/f d :init)) (erasure (m/stype sym))))]))]
                ;; merge directly nested lets
                (if (and (= 1 (count body)) (seq? (first body)) (= 'let (first (first body))))
                  (let [[_ bv & bbody] (first body)]
                    [(apply list (h env 'let) (into [sf init-f] bv) bbody)])
                  [(apply list (h env 'let) [sf init-f] (if (empty? body) [nil] body))]))))
          ;; local classes: letclass over the rest of the block
          (tr/is? s :CLASSDEF)
          (let [[bind env'] (local-class-binding env s)
                body (stmts env' ctx more)
                cs (captured-mutables env s)]
            (note! :form/letclass)
            (cond
              (seq cs)
              (let [f (apply list (h env 'letclass) [bind] (if (empty? body) [nil] body))]
                [(capture-values env s f)])
              (and (= 1 (count body)) (seq? (first body)) (= 'letclass (first (first body))))
              (let [[_ bv & bbody] (first body)]
                [(apply list (h env 'letclass) (into [bind] bv) bbody)])
              :else
              [(apply list (h env 'letclass) [bind] (if (empty? body) [nil] body))]))
          ;; a loop whose condition's pattern variables when false are in scope after it
          ;; (while (!(o instanceof String s)) ...; s.length(), JLS 6.3.2.3): the rest of the
          ;; block in their scope, the instanceof tested again (its expression pure)
          (let [lp (loop [x s] (if (tr/is? x :LABELLED) (recur (tr/f x :body)) x))]
            (and (seq more) (#{:WHILELOOP :DOLOOP :FORLOOP} (tr/tag lp)) (tr/f lp :cond)
                 (let [{:keys [f]} (pattern-binds (tr/f lp :cond))]
                   (some (fn [v] (some #(refs-sym? % v) more)) f))))
          (let [lp (loop [x s] (if (tr/is? x :LABELLED) (recur (tr/f x :body)) x))
                {:keys [f]} (pattern-binds (tr/f lp :cond))
                tests (->> (tree-seq tr/tree? tree-children (tr/f lp :cond))
                           (filter pattern-instanceof?)
                           (filter (fn [x] (some (fn [v] (and (contains? f v) (some #(refs-sym? % v) more)))
                                                 (pattern-vars (tr/f x :pattern))))))
                es (map #(:f (ex env (tr/f % :expr))) tests)]
            (if (every? pure? es)
              (do (note! :flow/loop-pattern-scope)
                  (into (stmt env ctx s)
                        [(reduce (fn [form [x e]]
                                   (list (h env 'if-instance) [(pattern-form env (atom env) (tr/f x :pattern)) e] form
                                         match-exception-default))
                                 (do-form (stmts env ctx more))
                                 (reverse (map vector tests es)))]))
              (into (stmt env ctx s) (stmts env ctx more))))
          (empty? more) (stmt env ctx s)
          ;; if whose pattern variables are in scope in the rest of the block
          (and (tr/is? s :IF) (has-patterns? (tr/f s :cond))
               (let [{:keys [t f]} (pattern-binds (tr/f s :cond))]
                 (some (fn [v] (some #(refs-sym? % v) more)) (concat t f))))
          (let [i s
                {:keys [t]} (pattern-binds (tr/f i :cond))
                into-then? (some (fn [v] (some #(refs-sym? % v) more)) t)
                a (tr/f i :thenpart) b (tr/f i :elsepart)]
            (note! :flow/pattern-scope)
            [(if into-then?
               (cond-form env (tr/f i :cond)
                          (fn [e] (do-form (stmts e ctx (into [a] more))))
                          (fn [e] (do-form (stmts e ctx (if b [b] [])))))
               (cond-form env (tr/f i :cond)
                          (fn [e] (do-form (stmts e ctx [a])))
                          (fn [e] (do-form (stmts e ctx (if b (into [b] more) more))))))])
          ;; if whose one branch ends in a jump that the rest makes implicit (unless the rest
          ;; would be repeated)
          (and (tr/is? s :IF) (foldable-if? ctx s)
               (let [ds (dup-sides (tr/f s :cond))]
                 (not (ds (if (cn? (tr/f s :thenpart)) :then :else)))))
          (let [i s
                a (tr/f i :thenpart) b (tr/f i :elsepart)]
            (note! :flow/folded-if)
            (if (not (cn? a))
              [(cond-form env (tr/f i :cond) (fn [e] (do-form (stmts e ctx [a])))
                          (fn [e] (do-form (stmts e ctx (if b (into [b] more) more)))))]
              [(cond-form env (tr/f i :cond) (fn [e] (do-form (stmts e ctx (into [a] more))))
                          (fn [e] (do-form (stmts e ctx [b]))))]))
          :else
          {:prefix (stmt env ctx0 s) :more more}))))

(defn- ends-in-jump?
  "True when statement `t` ends (on every path that ends) in a jump that `ctx` makes
  implicit."
  [ctx t]
  (case (tr/tag t)
    :BLOCK (let [ss (tr/f t :stats)] (and (seq ss) (ends-in-jump? ctx (last ss))))
    :IF (let [i t]
          (and (tr/f i :elsepart)
               (or (ends-in-jump? ctx (tr/f i :thenpart)) (tr/is? (tr/f i :thenpart) :THROW))
               (or (ends-in-jump? ctx (tr/f i :elsepart)) (tr/is? (tr/f i :elsepart) :THROW))
               (or (ends-in-jump? ctx (tr/f i :thenpart)) (ends-in-jump? ctx (tr/f i :elsepart)))))
    (if (#{:RETURN :BREAK :CONTINUE} (tr/tag t))
      (let [k (jump-key t)]
        (and (contains? (:jumps ctx) k)
             (or (not (tr/is? t :RETURN)) (nil? (tr/f t :expr)) (= (:vpos ctx) k))))
      false)))

(defn- foldable-if? [ctx i]
  (let [a (tr/f i :thenpart) b (tr/f i :elsepart)]
    (or (and (not (cn? a)) (ends-in-jump? ctx a) (or (nil? b) (cn? b)))
        (and b (not (cn? b)) (ends-in-jump? ctx b) (cn? a)))))

(defn- stmt-body
  "Statement `t` converted as a body in `ctx`, as one form."
  [env ctx t]
  (do-form (stmts env ctx [t])))

(declare loop-stmt switch-stmt try-stmt switch-stmt-1)

(defn stmt
  "Convert statement `t` in `ctx` to a vector of forms (including ctx's :fall where `t` can
  complete normally)."
  [env ctx t]
  (attr/framed (tr/tag t)
  (if (#{:RETURN :BREAK :CONTINUE :YIELD} (tr/tag t))
    (jump-stmt env ctx t)
   (case (tr/tag t)
    :BLOCK (stmts env ctx (tr/f t :stats))
    :SKIP (vec (:fall ctx))
    :EXEC (into (with-hoisting env (tr/f t :expr) :after ex-stmt)
                (:fall ctx))
    :IF (let [i t]
          (note! :form/if)
          (if (has-patterns? (tr/f i :cond))
            [(cond-form env (tr/f i :cond)
                        (fn [e] (stmt-body e ctx (tr/f i :thenpart)))
                        (fn [e] (if (tr/f i :elsepart) (stmt-body e ctx (tr/f i :elsepart)) (do-form (:fall ctx)))))]
            (let [c (test-form env (ex env (tr/f i :cond)))
                  a (stmt-body env ctx (tr/f i :thenpart))
                  b (if (tr/f i :elsepart) (stmt-body env ctx (tr/f i :elsepart)) (do-form (:fall ctx)))]
              [(if (nil? b) (list (h env 'when) c a) (list 'if c a b))])))
    :THROW (do (note! :form/throw)
               [(list 'throw (coerce env (ex env (tr/f t :expr)) (erasure (attr/type-of (tr/f t :expr) :types/expr))))])
    :ASSERT (let [a t]
              (note! :form/java-assert)
              (into [(apply list (h env 'java-assert) (test-form env (ex env (tr/f a :cond)))
                            (when (tr/f a :detail) [(:f (ex env (tr/f a :detail)))]))]
                    (:fall ctx)))
    (:WHILELOOP :DOLOOP :FORLOOP :FOREACHLOOP) (loop-stmt env ctx t nil)
    :LABELLED
    (let [l t
          body (tr/f l :body)
          kw (label-kw! env l (str (tr/f l :label)))]
      (if (tr/statement? (norm-target l))
        (let [target (norm-target l)]
          (if (tr/loop? target)
            (loop-stmt env ctx target kw)
            (let [ctx' (assoc-in ctx [:jumps [:break target]] (:fall ctx))
                  forms (stmts env ctx' [target])]
              (if (label-used? env target)
                (do (note! :form/label)
                    [(apply list (h env 'label) kw forms)])
                forms))))
        (stmt env ctx body)))
    :SWITCH (switch-stmt env ctx t)
    :TRY (try-stmt env ctx t)
    :SYNCHRONIZED (let [s t
                        ctx' (recur-free ctx)]
                    (note! :form/locking)
                    (into [(apply list (h env 'locking)
                                  (coerce env (ex env (tr/f s :lock)) (erasure (attr/type-of (tr/f s :lock) :types/expr)))
                                  (stmts env ctx' (tr/f (tr/f s :body) :stats)))]
                          (when (cn? t) (:after ctx'))))
    :CLASSDEF (stmts env ctx [t])
    :VARDEF (stmts env ctx [t])
    (throw (ex-info (str "unsupported statement " (kind-of t)) {:kind (kind-of t)}))))))

;;; ------------------------------------------------------------------------------------------
;;; Loops (§5.7)

(defn- assigned-syms
  "The local variable symbols assigned (=, op=, ++, --) anywhere in tree `t`."
  [t]
  (let [found (volatile! #{})]
    (letfn [(lhs-sym [e]
              (let [e (tr/skip-parens e)]
                (when (tr/is? e :IDENT) (attr/local-of e :assigned))))
            (walk [x]
              (when (tr/tree? x)
                (cond
                  (tr/is? x :ASSIGN) (some->> (lhs-sym (tr/f x :lhs)) (vswap! found conj))
                  (tr/assignop? x) (some->> (lhs-sym (tr/f x :lhs)) (vswap! found conj))
                  (#{:PREINC :PREDEC :POSTINC :POSTDEC} (tr/tag x))
                  (some->> (lhs-sym (tr/f x :arg)) (vswap! found conj)))
                (run! walk (tree-children x))))]
      (walk t))
    @found))

(defn- push-loop [env li] (update env :loops conj li))

(defn- loop-done
  "The forms of a converted loop: `form` (labeled if needed) and ctx's :fall when the loop
  can complete normally."
  [env ctx t form]
  (into [(wrap-label env t form)] (when (cn? t) (:fall ctx))))

(defn- while-loop [env ctx t]
  (if (has-patterns? (tr/f t :cond))
    (let [li {:tree t :kind :recur :args []}
          rec '(recur)
          bctx {:fall [rec] :jumps {[:continue t] [rec] [:break t] []} :vpos nil}]
      (note! :form/loop)
      (loop-done env ctx t (list (h env 'loop) []
                                 (cond-form env (tr/f t :cond)
                                            (fn [e] (do-form (stmts (push-loop e li) bctx [(tr/f t :body)])))
                                            (fn [_] nil)))))
  (let [li {:tree t :kind :while :update []}
        env' (push-loop env li)
        c (test-form env (ex env (tr/f t :cond)))
        body (stmts env' {:fall [] :jumps {[:continue t] []} :vpos nil} [(tr/f t :body)])]
    (note! :form/while)
    (loop-done env ctx t (apply list (h env 'while) c body)))))

(defn- do-loop [env ctx t]
  (let [li {:tree t :kind :do}
        _ (label-kw! env [:body t] "do-body")
        env' (push-loop env li)
        body (stmts env' {:fall [] :jumps {[:continue t] []} :vpos nil} [(tr/f t :body)])
        body (if (label-used? env [:body t])
               [(apply list (h env 'label) (label-kw! env [:body t] "do-body") body)]
               body)
        c (test-form env (ex env' (tr/f t :cond)))]
    (note! :form/do-while)
    (loop-done env ctx t (apply list (h env 'loop) [] (concat body [(list (h env 'when) c '(recur))])))))

(defn- step-update
  "For a for-loop update expression statement: [VarSymbol tree] when it assigns one local."
  [s]
  (when (tr/is? s :EXEC)
    (let [e (tr/skip-parens (tr/f s :expr))
          lhs (cond
                (tr/is? e :ASSIGN) (tr/f e :lhs)
                (tr/assignop? e) (tr/f e :lhs)
                (#{:PREINC :PREDEC :POSTINC :POSTDEC} (tr/tag e))
                (tr/f e :arg))
          lhs (some-> lhs tr/skip-parens)]
      (when (tr/is? lhs :IDENT)
        [(attr/local-of lhs :assigned) e]))))

(defn- recur-style? [t]
  (let [init (tr/f t :init)
        syms (map #(when (tr/is? % :VARDEF) (attr/sym % :local-decl)) init)
        steps (map step-update (tr/f t :step))]
    (and (seq init)
         (every? #(tr/is? % :VARDEF) init)
         (every? some? steps)
         (every? (set syms) (map first steps))
         (or (empty? steps) (apply distinct? (map first steps)))
         (let [assigned (into (assigned-syms (tr/f t :body)) (when (tr/f t :cond) (assigned-syms (tr/f t :cond))))]
           (not-any? assigned syms))
         ;; a later update does not read a variable an earlier one updated
         (every? true?
                 (for [[i [s1 _]] (map-indexed vector steps)
                       [_ e2] (drop (inc i) steps)]
                   (not (refs-sym? e2 s1)))))))

(defn- for-loop-patterns
  "A for loop whose condition binds pattern variables used in the body or the update: a
  `loop` testing the condition with if-instance."
  [env ctx t]
  (let [decls (filter #(tr/is? % :VARDEF) (tr/f t :init))
        exprs (remove #(tr/is? % :VARDEF) (tr/f t :init))
        [bv env'] (reduce (fn [[bv env] d]
                            (let [[sf init env'] (binding-for env d (when (tr/f d :init) (ex env (tr/f d :init))))]
                              [(conj bv sf init) env']))
                          [[] env] decls)
        pre (mapv #(ex-stmt env' (tr/f % :expr)) exprs)
        body-fn (fn [e]
                  (let [update (mapv #(ex-stmt e (tr/f % :expr)) (tr/f t :step))
                        next (conj update '(recur))
                        li {:tree t :kind :while :update update}]
                    (do-form (stmts (push-loop e li)
                                    {:fall next :jumps {[:continue t] next [:break t] []} :vpos nil}
                                    [(tr/f t :body)]))))
        l (wrap-label env t (list (h env 'loop) [] (cond-form env' (tr/f t :cond) body-fn (fn [_] nil))))]
    (note! :form/loop)
    (into (cond
            (seq bv) [(list (h env 'let) bv l)]
            (seq pre) (conj pre l)
            :else [l])
          (when (cn? t) (:fall ctx)))))

(defn- for-loop [env ctx t]
  (if (and (tr/f t :cond) (has-patterns? (tr/f t :cond)))
    (for-loop-patterns env ctx t)
  (if (recur-style? t)
    (let [[bv env'] (reduce (fn [[bv env] d]
                              (let [[sf init env'] (binding-for env d (ex env (tr/f d :init)) true)
                                    sf (vary-meta sf update ::f/m (fn [items] (vec (remove #{:mutable} items))))]
                                [(conj bv sf init) env']))
                            [[] env] (tr/f t :init))
          syms (map #(attr/sym % :local-decl) (tr/f t :init))
          updates (into {} (for [s (tr/f t :step)
                                 :let [[sym e] (step-update s)
                                       f (ex-stmt env' e)]]
                             [sym (nth f 2)]))
          args (vec (for [s syms] (get updates s (get-in env' [:locals s]))))
          rec (apply list 'recur args)
          li {:tree t :kind :recur :args args}
          env'' (push-loop env' li)
          body (stmts env'' {:fall [rec] :jumps {[:continue t] [rec] [:break t] []} :vpos nil} [(tr/f t :body)])
          c (when (tr/f t :cond) (test-form env' (ex env' (tr/f t :cond))))]
      (note! :form/loop)
      (loop-done env ctx t (list (h env 'loop) bv
                                 (if c
                                   (if (= 1 (count body))
                                     (list 'if c (first body) nil)
                                     (apply list (h env 'when) c body))
                                   (do-form body)))))
    (let [decls (filter #(tr/is? % :VARDEF) (tr/f t :init))
          exprs (remove #(tr/is? % :VARDEF) (tr/f t :init))
          [bv env'] (reduce (fn [[bv env] d]
                              (let [[sf init env'] (binding-for env d (when (tr/f d :init) (ex env (tr/f d :init))))]
                                [(conj bv sf init) env']))
                            [[] env] decls)
          pre (mapv #(ex-stmt env' (tr/f % :expr)) exprs)
          update (mapv #(ex-stmt env' (tr/f % :expr)) (tr/f t :step))
          li {:tree t :kind :while :update update}
          env'' (push-loop env' li)
          body (stmts env'' {:fall [] :jumps {[:continue t] []} :vpos nil} [(tr/f t :body)])
          body (if (or (cn? (tr/f t :body)) (has-continue? (tr/f t :body) t)) (into body update) body)
          c (if (tr/f t :cond) (test-form env' (ex env' (tr/f t :cond))) true)
          w (wrap-label env t (apply list (h env 'while) c body))]
      (note! :form/while)
      (into (cond
              (seq bv) [(list (h env 'let) bv w)]
              (seq pre) (conj pre w)
              :else [w])
            (when (cn? t) (:fall ctx)))))))

(defn- for-each-loop [env ctx t]
  (let [d (tr/f t :var)
        sym (attr/sym d :local-decl)
        s (local-sym env sym)
        vt (m/stype sym)
        sf (apply m+ s (concat (when (mutable? sym) [:mutable])
                               (annotation-items env (tr/f (tr/f d :mods) :annotations))
                               (let [tf (binding [*skip-anns* (mods-type-anns (tr/f d :mods))]
                                          (type-form env (if (tr/var-decl? d) (erasure vt) vt)))]
                                 (when-not (and (m/object? vt) (empty? (f/items tf)))
                                   [[:tag tf]]))))
        et (attr/type-of (tr/f t :expr) :types/expr)
        ;; a primitive binding over an Iterable of another primitive's box (for (float f :
        ;; Iterable<Integer>)): the element is cast to that box before its unboxing, as javac's
        ;; Lower casts it to the erased type argument; the analysis would cast to the binding's own
        ;; box (JCS115 (a)): ^{:box C}
        sf (or (when (and (prim? vt) (not (m/array? et)))
                 (when-let [b (m/iterable-arg et)]
                   (when (and (m/unboxed b) (not (same? b (m/boxed vt))))
                     (m+ sf [:box (type-form env b)]))))
               sf)
        coll (coerce env (ex env (tr/f t :expr)) (erasure et))
        ;; a type variable whose erasure (its first bound) is not Iterable, iterated by another
        ;; bound (<T extends A & B<String>>, B an Iterable): cast to that bound, as TransTypes
        ;; does (JCS66 (a))
        coll (let [it (if attr/*provider* (d/ctype (d/class-named (:reg attr/*provider*) "java.lang.Iterable")) (.iterableType jt/*syms*))]
               (if-let [b (when (and (m/tvar? et) (not (subtype? (erasure et) it)))
                            (some #(when (subtype? % it) (erasure %)) (m/components (m/skip-type-vars et))))]
                 (cast-form env coll b)
                 coll))
        env' (push-loop (add-local env sym s) {:tree t :kind :for-each})
        body (stmts env' {:fall [] :jumps {[:continue t] []} :vpos nil} [(tr/f t :body)])]
    (note! :form/for-each)
    (loop-done env ctx t (apply list (h env 'for-each) [sf coll] body))))

(defn loop-stmt [env ctx t kw]
  (when kw (swap! (:lbl env) assoc (norm-target t) {:kw kw :used false}))
  (case (tr/tag t)
    :WHILELOOP (while-loop env ctx t)
    :DOLOOP (do-loop env ctx t)
    :FORLOOP (for-loop env ctx t)
    :FOREACHLOOP (for-each-loop env ctx t)))

;;; ------------------------------------------------------------------------------------------
;;; switch (§5.8)

(defn- enum-type? [t] (m/enum-type? t))

(defn- legacy-selector? [t]
  (let [t (erasure t)
        u (or (when (prim? t) t) (m/unboxed t))]
    (or (and u (#{"INT" "SHORT" "BYTE" "CHAR"} (tag-name u)))
        (m/string-type? t)
        (enum-type? t))))

(defn- const-label [env sel-type e]
  (let [e (tr/skip-parens e)
        et #(attr/type-of e :types/constant)]
    (cond
      (= "BOT" (tag-name (et))) nil
      (enum-type? sel-type) (symbol (str (tr/tree-name e)))
      (tr/is? e :LITERAL)
      (let [x (literal env e)]
        (if (seq? (:f x)) (m/type-const (et)) (:f x)))
      ;; a constant label's name is a variable's (JFS71: no symbol asked)
      (or (tr/is? e :IDENT) (tr/is? e :SELECT))
      (let [x (ex env e)] (if (seq? (:f x)) (m/type-const (et)) (:f x)))
      :else (let [v (m/type-const (et))]
              (note! :switch/folded-label)
              (if (= "CHAR" (tag-name (et))) (char (int v)) v)))))

(defn- default-label? [l] (tr/is? l :DEFAULTCASELABEL))

(defn- null-label? [l]
  (and (tr/is? l :CONSTANTCASELABEL)
       (= "BOT" (tag-name (attr/type-of (tr/f l :expr) :types/constant)))))

(defn- case-groups
  "The arms of a switch: [{:labels [JCCaseLabel] :guard tree :stats [stmts] :rule body}]."
  [cases]
  (let [cases (vec cases)
        n (count cases)]
    (loop [i 0 pending [] out []]
      (if (>= i n)
        (if (seq pending) (conj out {:labels pending :stats []}) out)
        (let [c (cases i)]
          (if (tr/rule-case? c)
            (recur (inc i) [] (conj out {:labels (vec (tr/f c :labels)) :guard (tr/f c :guard) :rule (tr/f c :body)
                                         :case c}))
            (if (and (empty? (tr/f c :stats)) (< i (dec n)) (nil? (tr/f c :guard))
                     (not-any? #(tr/is? % :PATTERNCASELABEL) (tr/f c :labels)))
              (recur (inc i) (into pending (tr/f c :labels)) out)
              (let [stats (loop [j i acc []]
                            (let [cj (cases j)
                                  acc (into acc (tr/f cj :stats))]
                              (if (and (attr/completes-normally? cj) (< j (dec n)))
                                (recur (inc j) acc)
                                acc)))]
                (when (and (attr/completes-normally? c) (< i (dec n))) (note! :switch/fall-through))
                (recur (inc i) [] (conj out {:labels (into pending (tr/f c :labels)) :guard (tr/f c :guard)
                                             :stats stats :case c}))))))))))

(defn- arm-label
  "The label form of an arm and the env for its body (pattern bindings)."
  [env sel-type {:keys [labels guard]}]
  (let [penv (atom env)
        pats (filter #(tr/is? % :PATTERNCASELABEL) labels)
        consts (filter #(tr/is? % :CONSTANTCASELABEL) labels)
        default? (some default-label? labels)]
    (cond
      default? [(if (some null-label? labels) (list nil :default) :default) env]
      (seq pats)
      (let [pf (pattern-form env penv (tr/f (first pats) :pat))
            g (when guard (test-form @penv (ex @penv guard)))]
        (when (next pats) (note! :warn/multiple-patterns))
        (note! :switch/pattern)
        [(if g [pf :when g] [pf]) @penv])
      :else
      (let [ls (map #(const-label env sel-type (tr/f % :expr)) consts)]
        [(if (= 1 (count ls)) (first ls) (apply list ls)) env]))))

(defn- exhaustive-default? [t expr?]
  (let [cases (tr/f t :cases)
        sel (tr/f t :selector)
        uncond (attr/unconditional-pattern? t)
        has-default (some (fn [c] (some default-label? (tr/f c :labels))) cases)
        pattern? (attr/pattern-switch? t)
        has-null (some (fn [c] (some null-label? (tr/f c :labels))) cases)]
    (and (not has-default) (not uncond)
         (or expr? pattern? has-null (not (legacy-selector? (attr/type-of sel :types/expr)))))))

(defn- selector-form [env sel pattern?]
  (let [x (ex env sel)
        t (:t x)]
    (if (and (not pattern?) (m/type? t) (not (prim? t)) (m/unboxed t))
      (coerce env x (m/unboxed t) true)
      (coerce env x (erasure (attr/type-of sel :types/expr))))))

(def match-exception-default
  (list 'throw (list (f/member (f/cref "java.lang.MatchException") ".") nil nil)))

(defn- split-pattern-groups
  "A case with several patterns (case A _, B _ ->) becomes one arm per pattern."
  [groups]
  (mapcat (fn [g]
            (let [pats (filter #(tr/is? % :PATTERNCASELABEL) (:labels g))]
              (if (> (count pats) 1)
                (do (note! :switch/split-patterns)
                    (for [p pats] (assoc g :labels [p])))
                [g])))
          groups))

(declare match-exception-default)

(defn- guard-bindings
  "Body form `f` of arm `g`, in the scope of the pattern variables its guard introduces when true
  (case String s when o instanceof Integer i -> ... i ..., JLS 6.3.4): each instanceof of the
  guard whose variable the body reads tested again around the body (its expression a local or
  this: no second effect), as SPEC §5.8's if-instance scopes them."
  [env g f]
  (let [guard (:guard g)
        body (concat (when (:rule g) [(:rule g)]) (:stats g))
        tests (when guard
                (->> (tree-seq tr/tree? tree-children guard)
                     (filter pattern-instanceof?)
                     (filter (fn [x] (some (fn [v] (some #(refs-sym? % v) body))
                                           (pattern-vars (tr/f x :pattern)))))))]
    (reduce (fn [f x]
              (let [e (:f (ex env (tr/f x :expr)))]
                (if (pure? e)
                  (do (note! :flow/guard-binding)
                      (list (h env 'if-instance) [(pattern-form env (atom env) (tr/f x :pattern)) e] f
                            match-exception-default))
                  f)))
            f (reverse tests))))

(defn- switch-arms
  "Convert the arms; `body-fn` converts one arm's body given its env."
  [env sel-type groups body-fn]
  (let [arms (for [g (split-pattern-groups groups)]
               (let [[lbl env'] (arm-label env sel-type g)]
                 [lbl (guard-bindings env' g (body-fn env' g))]))
        defaults (filter #(or (= :default (first %)) (and (seq? (first %)) (= :default (second (first %))))) arms)
        others (remove (set defaults) arms)]
    [others (first defaults)]))

(defn- switch-stmt* [env ctx t]
  (let [sel-type (erasure (attr/type-of (tr/f t :selector) :types/expr))
        sel (selector-form env (tr/f t :selector) (attr/pattern-switch? t))
        groups (case-groups (tr/f t :cases))
        arm-ctx {:fall (:fall ctx) :jumps (assoc (:jumps ctx) [:break t] (:fall ctx)) :vpos (:vpos ctx)}
        body-fn (fn [env' g]
                  (if (:rule g)
                    (do-form (stmts env' arm-ctx [(:rule g)]))
                    (do-form (stmts env' arm-ctx (:stats g)))))
        [arms default] (switch-arms env sel-type groups body-fn)
        default (cond
                  default default
                  (exhaustive-default? t false) (do (note! :switch/match-exception) [:default match-exception-default])
                  (seq (:fall ctx)) [:default (do-form (:fall ctx))]
                  :else nil)
        form (apply list (h env 'switch) sel
                    (concat (mapcat (fn [[l b]] [l b]) arms)
                            (when default
                              (if (= :default (first default))
                                [(second default)]
                                [(first default) (second default)]))))]
    (note! :form/switch)
    form))

(defn- cross-case-locals
  "The local declarations at the top level of one case of switch `t` that another case uses."
  [t]
  (let [cases (vec (tr/f t :cases))]
    (for [[i c] (map-indexed vector cases)
          d (tr/f c :stats)
          :when (tr/is? d :VARDEF)
          :let [sym (attr/sym d :local-decl)]
          :when (some (fn [[j c2]]
                        (and (not= i j) (some #(refs-sym? % sym) (tr/f c2 :stats))))
                      (map-indexed vector cases))]
      d)))

(defn switch-stmt [env ctx t]
  (let [pre (cross-case-locals t)]
    (if (seq pre)
      (let [[bv env'] (reduce (fn [[bv env] d]
                                (let [[sf init env'] (binding-for env d nil)]
                                  [(conj bv sf init) env']))
                              [[] env] pre)]
        (note! :switch/predeclared-local)
        (binding [*predeclared* (into *predeclared* (map #(attr/sym % :local-decl) pre))]
          [(apply list (h env 'let) bv (switch-stmt-1 env' ctx t))]))
      (switch-stmt-1 env ctx t))))

(defn- switch-stmt-1 [env ctx t]
  (label-kw! env t "switch")
  (let [form (switch-stmt* env ctx t)]
    (if (and (label-used? env t) (seq (:fall ctx)))
      ;; an explicit break leaves the switch: the fall-through forms go after it
      (do (swap! (:lbl env) assoc-in [(norm-target t) :used] false)
          (let [form (switch-stmt* env ctx0 t)]
            (into [(wrap-label env t form)] (when (cn? t) (:fall ctx)))))
      [(wrap-label env t form)])))

(defn switch-form
  "A switch expression."
  [env t _]
  (label-kw! env t "switch")
  (let [ty (erasure (attr/type-of t :types/expr))
        sel-type (erasure (attr/type-of (tr/f t :selector) :types/expr))
        sel (selector-form env (tr/f t :selector) (attr/pattern-switch? t))
        groups (case-groups (tr/f t :cases))
        k [:yield t]
        arm-ctx {:fall [] :jumps {k :value} :vpos k}
        body-fn (fn [env' g]
                  (let [env' (assoc env' :yield-type ty)
                        b (:rule g)]
                    (cond
                      (and b (tr/expression? b))
                      (let [x (ex env' b)]
                        (coerce env' x ty true))
                      b (do-form (stmts env' arm-ctx [b]))
                      :else (do-form (stmts env' arm-ctx (:stats g))))))
        [arms default] (switch-arms env sel-type groups body-fn)
        default (or default
                    (when (exhaustive-default? t true)
                      (note! :switch/match-exception)
                      [:default match-exception-default]))
        form (apply list (h env 'switch) sel
                    (concat (mapcat (fn [[l b]] [l b]) arms)
                            (when default
                              (if (= :default (first default))
                                [(second default)]
                                [(first default) (second default)]))))]
    (note! :form/switch-expression)
    (r (wrap-label env t form) ty)))

;;; ------------------------------------------------------------------------------------------
;;; try, with-resources (§5.9)

(defn- catch-form [env ctx c]
  (let [p (tr/f c :param)
        sym (attr/sym p :local-decl)
        s (local-sym env sym)
        vt (tr/f p :vartype)
        types (if (tr/is? vt :TYPEUNION)
                (mapv #(code-type-form env (attr/type-of % :names/type-tree)) (tr/f vt :alternatives))
                (binding [*skip-anns* (mods-type-anns (tr/f p :mods))] (code-type-form env (m/stype sym))))
        sf (apply m+ s (concat (when (mutable? sym) [:mutable]) (annotation-items env (tr/f (tr/f p :mods) :annotations))))
        env' (add-local env sym s)]
    (note! (if (vector? types) :form/multi-catch :form/catch))
    (apply list 'catch types sf (stmts env' ctx (tr/f (tr/f c :body) :stats)))))

(defn try-stmt [env ctx t]
  (let [ctx' (recur-free ctx)
        ctx' (if (:after ctx') (assoc ctx' :jumps {} :vpos nil) ctx')
        resources (tr/f t :resources)
        [rbinds env'] (reduce (fn [[bv env] res]
                                (if (tr/is? res :VARDEF)
                                  (let [d res
                                        [sf init env'] (binding-for env d (ex env (tr/f d :init)))
                                        sf (vary-meta sf update ::f/m (fn [items] (vec (remove #{:mutable} items))))]
                                    [(conj bv sf init) env'])
                                  (let [x (ex env res)
                                        ;; the resource's variable's name (JFS71: its tree's)
                                        rn (tr/skip-parens res)
                                        nm (or (when (#{:IDENT :SELECT} (tr/tag rn)) (some-> (tr/tree-name rn) str)) "r")
                                        s (if (and (symbol? (:f x)) (not (namespace (:f x)))) (:f x) (gensym! env nm))]
                                    [(conj bv s (:f x)) env])))
                              [[] env] resources)
        body (stmts env' ctx' (tr/f (tr/f t :body) :stats))
        body (if (seq resources)
               (do (note! :form/with-resources)
                   [(apply list (h env 'with-resources) rbinds body)])
               body)
        catches (map #(catch-form env ctx' %) (tr/f t :catchers))
        fin (when (tr/f t :finalizer)
              (note! :form/finally)
              (apply list 'finally (stmts env ctx0 (tr/f (tr/f t :finalizer) :stats))))
        form (if (or (seq catches) fin)
               (do (note! :form/try)
                   (apply list 'try (concat body catches (when fin [fin]))))
               (do-form body))]
    (into [form] (when (and (:after ctx') (cn? t)) (:after ctx')))))

;;; ------------------------------------------------------------------------------------------
;;; Lambdas and method references (§5.12)

(defn- fi-form [env target]
  (if-let [cs (m/components target)]
    (apply list '& (map #(erased-form env %) cs))
    (erased-form env target)))

(defn- descriptor [target] (m/descriptor-type target))

(defn lambda-form [env t]
  (let [target (or (attr/fn-target t) (attr/type-of t :infer/target))
        desc (descriptor target)
        rt (erasure (m/mt-ret desc))
        void? (m/void? rt)
        [params env'] (reduce (fn [[ps env] d]
                                (let [sym (attr/sym d :lambda-param)
                                      s (local-sym env sym)
                                      pt (erasure (m/stype sym))
                                      sf (apply m+ s (concat (when (mutable? sym) [:mutable])
                                                             (annotation-items env (tr/f (tr/f d :mods) :annotations))
                                                             (when-not (m/object? pt) [[:tag (erased-form env pt)]])))]
                                  [(conj ps sf) (add-local env sym s)]))
                              [[] env] (tr/f t :params))
        params (cond-> params
                 (not (m/object? rt)) (m+ [:tag (erased-form env rt)]))
        env' (assoc env' :ret (when-not void? rt) :loops () :yield-type nil)
        body (tr/f t :body)
        forms (if (tr/expression? body)
                [(if void? (ex-stmt env' body) (coerce env' (ex env' body) rt))]
                (stmts env' {:fall [] :jumps {[:return] []} :vpos (when-not void? [:return])}
                       (tr/f body :stats)))]
    (note! :form/lambda)
    (r (apply list (h env 'lambda) (fi-form env target) params forms) (erasure target))))

(defn method-ref-form [env t]
  (let [target (or (attr/fn-target t) (attr/type-of t :infer/target))
        desc (descriptor target)
        sam (m/descriptor-sym (erasure (if-let [cs (m/components target)] (first cs) target)))
        sam-ps (erased-params sam)
        sam-r (ret-type sam)
        inst-ps (map erasure (m/mt-params desc))
        inst-r (erasure (m/mt-ret desc))
        sig (when-not (and (every? true? (map same? inst-ps sam-ps))
                           (= (count inst-ps) (count sam-ps))
                           (same? inst-r sam-r))
              (cond-> (mapv #(erased-form env %) inst-ps)
                (not (same? inst-r sam-r)) (m+ [:tag (erased-form env inst-r)])))
        kind (str (attr/ref-kind t))
        m (attr/sym t :method-ref)
        qt (erasure (attr/type-of (tr/f t :expr) :types/qualifier))
        ;; an intersection qualifier ((A & AB) o)::b) erases to its first bound, which need not
        ;; have the method: its declaring class is written (the receiver cast to it)
        qt (if (and m (#{"BOUND" "UNBOUND"} (str (attr/ref-kind t))) (not (m/array? qt))
                    (m/class-sym? (m/tsym qt)) (m/owner m)
                    (not (subtype? qt (erasure (m/stype (m/owner m))))))
             (erasure (m/stype (m/owner m)))
             qt)
        fi (fi-form env target)]
    (note! :form/method-ref)
    (if (= kind "ARRAY_CTOR")
      (let [n (gensym! env "n")]
        (note! :form/array-ctor-ref)
        (r (list (h env 'lambda) fi (m+ (tag [(tag n 'int)] (erased-form env qt)) :method-ref)
                 (list 'new (erased-form env qt) n))
           (erasure target)))
      (let [ctor? (#{"IMPLICIT_INNER" "TOPLEVEL"} kind)
            owner (if (m/array? qt) qt qt)
            overloaded? (> (count (methods-named env owner (m/sname m) (boolean ctor?))) 1)
            msym (cond
                   (and (not ctor?) (m/class-sym? (m/tsym qt)) (m/anonymous? (m/tsym qt)))
                   (do (note! :form/method-ref-anonymous) (symbol (str "." (m/sname m))))
                   ctor? (member (class-ref env (m/tsym qt)) "new")
                   (= kind "STATIC") (member (class-ref env (m/tsym qt)) (m/sname m))
                   (m/array? qt) (member (erased-form env qt) (str "." (m/sname m)))
                   :else (member (class-ref env (m/tsym qt)) (str "." (m/sname m))))
            ;; the compiler resolves the method with the instantiated parameter types (§5.12)
            pin? (cond
                   (not overloaded?) false
                   (or (= kind "SUPER") (m/array? qt) (not (m/class-sym? (m/tsym qt)))
                       (and (not ctor?) (m/anonymous? (m/tsym qt))))
                   true
                   :else
                   (let [stubs (map #(res/arg-node % nil) inst-ps)
                         va (some? (attr/varargs-element t m))]
                     (case kind
                       ("IMPLICIT_INNER" "TOPLEVEL") (pin-needed? :ctor (current-class env) (m/tsym qt) m stubs va)
                       "STATIC" (pin-needed? :static (current-class env) (m/tsym qt) m stubs va)
                       "BOUND" (pin-needed? :instance (current-class env) qt m stubs va)
                       "UNBOUND" (pin-needed? :instance (current-class env) qt m (rest stubs) va)
                       true)))
            msym (if pin? (m+ msym (param-tags env m)) msym)
            ;; type annotations of the qualifying type and of explicit type arguments (§4.4)
            qtype (when (#{"STATIC" "UNBOUND" "IMPLICIT_INNER" "TOPLEVEL"} kind) (attr/type-of (tr/f t :expr) :names/type-tree))
            msym (cond-> msym
                   (type-annotated? qtype) (m+ [:qualifier (type-form env qtype)])
                   (some #(type-annotated? (attr/type-of % :names/type-tree)) (tr/f t :typeargs))
                   (m+ [:type-args (mapv #(type-form env (attr/type-of % :names/type-tree)) (tr/f t :typeargs))]))
            recv (case kind
                   "BOUND" [(coerce env (ex env (tr/f t :expr)) qt)]
                   "SUPER" [(:f (ex env (tr/f t :expr)))]
                   nil)]
        (r (apply list (h env 'method-ref) fi (concat (when sig [sig]) recv [msym])) (erasure target))))))

;;; ------------------------------------------------------------------------------------------
;;; Classes (§4)

(declare class-body)

(defn- class-env
  "The env inside the body of class `c`."
  [env c]
  (let [members (m/member-classes c)
        fields (m/field-names c)
        tvars (m/tparam-names c)]
    (-> env
        (update :classes conj c)
        (update :scope (fn [sc] (merge sc
                                       (into {} (for [s members] [(m/simple-name s) s]))
                                       (into {} (for [tv tvars] [tv :tvar])))))
        (update :fields into fields))))

(defn- type-params [env tps]
  (when (seq tps)
    (note! :form/type-params)
    (vec (for [tp tps]
           (let [nm (symbol (str (tr/f tp :name)))
                 nm (apply m+ nm (annotation-items env (tr/f tp :annotations)))
                 bounds (tr/f tp :bounds)]
             (if (empty? bounds)
               nm
               (apply list nm 'extends (map #(type-form env (attr/type-of % :names/type-tree)) bounds))))))))

(defn- method-env [env m]
  (let [tvars (m/mtparam-names m)]
    (update env :scope merge (into {} (for [tv tvars] [tv :tvar])))))

(defn- inherited-candidates
  "Non-private methods of the supertypes of `c` named like `m` with its arity."
  [c m]
  (let [n (count (m/mparams m))
        ct (m/stype c)
        sups (rest (m/closure-classes ct))
        sups (if (m/interface? c) (concat sups [(m/tsym (m/object-type-of ct))]) sups)]
    (->> (for [sc sups
               s (m/methods-named sc (m/sname m))
               :when (and (not (m/static? s))
                          (zero? (bit-and (m/flags s) (long (bit-or Flags/PRIVATE Flags/SYNTHETIC))))
                          (= n (count (m/mparams s))))]
           s)
         (map (fn [s] [(sig-key s) (m/type-str (ret-type s))]))
         distinct)))

(defn- omit-object-tags?
  "Whether `Object` types of method `m` may be left out (§4.6: an untyped method takes the
  signature of a unique inherited method with its name and arity)."
  [c m]
  (let [ps (erased-params m)
        rt (ret-type m)
        all-object? (and (every? m/object? ps) (m/object? rt))]
    (if-not all-object?
      true
      (let [cands (inherited-candidates c m)]
        (or (empty? cands)
            (and (= 1 (count cands))
                 (let [[ks r] (first cands)]
                   (and (every? #(= "java.lang.Object" %) ks) (= "java.lang.Object" r)))))))))

(defn- implicit-super-call? [s]
  (when (tr/is? s :EXEC)
    (let [e (tr/f s :expr)]
      (and (tr/is? e :APPLY)
           ;; o.super() is never implicit
           (tr/is? (tr/f e :meth) :IDENT)
           (= "super" (str (tr/tree-name (tr/f e :meth))))
           (empty? (tr/f e :args))
           (let [p (tr/start s)]
             (or (neg? p) (>= p (count *text*)) (not= \s (.charAt ^String *text* p))))))))

(defn- param-forms
  "[params-vector env'] for method tree `md`."
  [env md omit-object?]
  (let [m (attr/sym md :method-decl)
        varargs? (m/has-flag? m Flags/VARARGS)
        ps (vec (tr/f md :params))
        n (count ps)]
    (reduce (fn [[pv env] [i d]]
              (let [sym (attr/sym d :param)
                    s (local-sym env sym)
                    pt (m/stype sym)
                    sf (apply m+ s (concat (when (m/has-flag? sym Flags/FINAL) [:final])
                                           (when (and (mutable? sym) (not (m/has-flag? sym Flags/FINAL))) [:mutable])
                                           (annotation-items env (tr/f (tr/f d :mods) :annotations))
                                           (when-let [tg (binding [*skip-anns* (mods-type-anns (tr/f d :mods))]
                                                           (decl-tag env pt omit-object?))]
                                             [tg])))
                    pv (if (and varargs? (= i (dec n))) (conj pv '& sf) (conj pv sf))]
                (when (and (mutable? sym) (not (m/has-flag? sym Flags/FINAL))) (note! :form/mutable-param))
                [pv (add-local env sym s)]))
            [[] env] (map-indexed vector ps))))

(def unreadable-names
  "Java identifiers that Clojure reads as literals, not symbols."
  #{"nil" "true" "false"})

(defn- member-name
  "The symbol naming a declared member: its Java name, or, for a name that reads as a Clojure
  literal (javac's List.nil()), qualified by the simple name of its class: List/nil."
  [c ^String n]
  (if (unreadable-names n)
    (do (note! :form/qualified-member-name) (symbol (m/simple-name c) n))
    (symbol n)))

(defn- method-form [env c md]
  (attr/framed :METHODDEF
  (let [m (attr/sym md :method-decl)
        ctor? (= "<init>" (str (tr/f md :name)))
        static? (m/static? m)
        compact? (m/has-flag? m Flags/COMPACT_RECORD_CONSTRUCTOR)
        env (method-env env m)
        omit? (or ctor? (omit-object-tags? c m))
        ;; the receiver of an anonymous class's method that a nested class refers to gets
        ;; its own name, since the class has none to write Outer/this with
        recv (if (and (not static?) (m/anonymous? c) (tr/f md :body)
                      (some #(tr/is? % :CLASSDEF) (all-trees (tr/f md :body))))
               (symbol (str "this" (count (filter m/anonymous? (:classes env)))))
               'this)
        env (if (= recv 'this) env (assoc-in env [:anon-this c] recv))
        [pv env'] (if compact? [[] env] (param-forms env md omit?))
        ;; a receiver parameter's annotations go on the receiver symbol (§4.6)
        recv-sym (if-let [rp (tr/f md :recvparam)]
                   (apply m+ recv (annotation-items env (tr/f (tr/f rp :mods) :annotations)))
                   recv)
        pv (if static? pv (into [recv-sym] pv))
        rt (m/mret m)
        mods (concat (modifier-items env md) [(deprecated-item m (tr/f md :mods))]
                     (when compact? [:compact]))
        pv (if ctor?
             (apply m+ pv mods)
             (if (or (m/void? rt) (not (and omit? (m/object? rt))) (m/tvar? rt))
               (m+ pv [:tag (binding [*skip-anns* (mods-type-anns (tr/f md :mods))] (type-form env rt))])
               pv))
        opts (concat (when-let [tp (type-params env (tr/f md :typarams))] [:type-params tp])
                     (when (seq (tr/f md :thrown))
                       (note! :form/throws)
                       [:throws (mapv #(type-form env (attr/type-of % :names/type-tree)) (tr/f md :thrown))])
                     (when-let [d (m/default-value m)]
                       (note! :form/annotation-default)
                       [:default (attr-value env d nil)]))
        void? (or ctor? (m/void? rt))
        env' (cond-> (assoc env' :this (when-not static? recv) :ret (when-not void? (erasure rt))
                            :loops () :yield-type nil)
               (not static?) (update :names conj (name recv)))
        compact-env (if compact?
                      (reduce (fn [e p] (add-local e p (symbol (m/sname p)))) env' (m/param-syms m))
                      env')
        body (when-let [b (tr/f md :body)]
               (let [ss (vec (tr/f b :stats))
                     ss (if (and ctor? (seq ss) (implicit-super-call? (first ss))) (subvec ss 1) ss)]
                 (stmts compact-env {:fall [] :jumps {[:return] []} :vpos (when-not void? [:return])} ss)))
        nm (apply m+ (member-name c (str (tr/f md :name))) (when-not ctor? mods))]
    (note! (if ctor? :form/constructor :form/method))
    (if ctor?
      (apply list 'constructor (concat opts [pv] body))
      (apply list 'method nm (concat opts [pv] body))))))

(defn- field-form [env d]
  (attr/framed :VARDEF
  (let [sym (attr/sym d :field-decl)
        static? (m/static? sym)
        env' (assoc env :this (when-not static? 'this) :ret nil :loops ())
        nm (apply m+ (member-name (m/owner sym) (str (tr/f d :name)))
                  (concat (modifier-items env d) [(deprecated-item sym (tr/f d :mods))]
                          [(binding [*skip-anns* (mods-type-anns (tr/f d :mods))] (decl-tag env (m/stype sym) true))]))]
    (note! :form/field)
    (if (tr/f d :init)
      (list 'field nm (coerce env' (ex env' (tr/f d :init)) (erasure (m/stype sym))))
      (list 'field nm)))))

(defn- anon-super-ctor
  "The superclass constructor that the constructor javac made for anonymous class `cd` calls,
  else `fallback` (arbace.repr.java.attr's)."
  [cd fallback]
  (attr/anon-super-ctor cd fallback))

(defn- enum-constant [env d]
  (attr/framed :VARDEF
  (let [sym (attr/sym d :field-decl)
        nm (apply m+ (member-name (m/owner sym) (str (tr/f d :name))) (concat (annotation-items env (tr/f (tr/f d :mods) :annotations))
                                                     [(deprecated-item sym (tr/f d :mods))]))
        nc (tr/f d :init)
        m (if (tr/f nc :def) (anon-super-ctor (tr/f nc :def) (attr/constructor nc)) (attr/constructor nc))
        ve (attr/varargs-element nc m)
        loose? (and ve (erased-varargs-elem? m ve))
        [afs _ nodes] (call-args env m (attr/constructor-type nc m) (tr/f nc :args) ve loose?)
        pin? (pin-needed? :ctor (m/owner sym) (m/owner sym) m nodes loose?)]
    (note! :form/enum-constant)
    (if (or (seq (tr/f nc :args)) (tr/f nc :def) pin?)
      (apply list nm (cond-> (vec afs) pin? (m+ (param-tags env m))) (when (tr/f nc :def)
                                 (note! :form/enum-constant-body)
                                 (class-body (class-env env (attr/sym (tr/f nc :def) :class-decl)) (tr/f nc :def))))
      nm))))

(defn- generated? [d]
  (cond
    (tr/is? d :METHODDEF)
    (let [m (attr/sym d :method-decl)]
      (or (m/has-flag? m Flags/GENERATEDCONSTR)
          (m/has-flag? m Flags/ANONCONSTR)
          (m/has-flag? m Flags/GENERATED_MEMBER)
          (and (m/has-flag? m Flags/RECORD) (m/has-flag? m Flags/GENERATED_MEMBER))))
    (tr/is? d :VARDEF)
    (m/has-flag? (attr/sym d :field-decl) Flags/GENERATED_MEMBER)
    :else false))

(declare class-form)

(defn class-body
  "The member forms of class tree `cd` (env already inside the class); with `pos?` (a top-level or
  member class) their spans recorded in mode :full."
  ([env cd] (class-body env cd false))
  ([env cd pos?]
  (let [c (attr/sym cd :class-decl)
        record? (m/has-flag? c Flags/RECORD)
        defs (remove generated? (tr/f cd :defs))
        consts (filter #(and (tr/is? % :VARDEF)
                             (m/has-flag? (attr/sym % :field-decl) Flags/ENUM)) defs)
        members (for [d defs
                      :when (not (some #(identical? d %) consts))
                      :when (not (and record? (tr/is? d :VARDEF)
                                      (m/has-flag? (attr/sym d :field-decl) Flags/RECORD)))]
                  (cond-> (case (tr/tag d)
                    :VARDEF (field-form env d)
                    :METHODDEF (method-form env c d)
                    :BLOCK (attr/framed :BLOCK
                             (let [b d
                                   static? (not (zero? (bit-and (long (tr/f b :flags)) (long Flags/STATIC))))
                                   env' (assoc env :this (when-not static? 'this) :ret nil :loops ())]
                               (note! (if static? :form/static-initializer :form/initializer))
                               (apply list (if static? 'static-initializer 'initializer)
                                      (stmts env' ctx0 (tr/f b :stats)))))
                    :CLASSDEF (class-form env d pos?)
                    (throw (ex-info (str "unsupported member " (kind-of d)) {})))
                    (and pos? (not (tr/is? d :CLASSDEF))) (at d)))]
    (concat (when (seq consts)
              [(cond-> (apply list 'constants (map #(enum-constant env %) consts))
                 pos? (at-span (apply min (map #(tr/start %) consts))
                               (apply max (map #(tr/end %) consts))))])
            members))))

(defn- class-header
  "[name-with-meta record-components? options] for class tree `cd`."
  [env cd]
  (let [c (attr/sym cd :class-decl)
        k (tr/class-kind cd)
        kind-kw ({"INTERFACE" :interface "ENUM" :enum "RECORD" :record "ANNOTATION_TYPE" :annotation} k)
        mods (concat (modifier-items env cd :drop (when (#{"INTERFACE" "ANNOTATION_TYPE"} k) [:abstract]))
                     [(deprecated-item c (tr/f cd :mods))] [kind-kw])
        nm (apply m+ (symbol (str (tr/f cd :name))) mods)
        ;; the supertypes are Java's names outside the class's body, the analysis resolves them
        ;; with its member classes in scope: a reference whose name a member class claims
        ;; (class Y extends AX.Z { class AX ... }) is written by its binary name (JCS65 (a))
        senv (let [ms (map m/simple-name (m/member-classes c))]
               (if (seq ms)
                 (-> env (update :scope #(apply dissoc % ms)) (update :names (fnil into #{}) ms))
                 env))
        ext (tr/f cd :extending)
        impl (seq (tr/f cd :implementing))
        perm (seq (tr/f cd :permitting))
        comps (when (= k "RECORD")
                (vec (for [d (tr/f cd :defs)
                           :when (and (tr/is? d :VARDEF)
                                      (m/has-flag? (attr/sym d :field-decl) Flags/RECORD))]
                       (apply m+ (symbol (str (tr/f d :name)))
                              (concat (annotation-items env (tr/f (tr/f d :mods) :annotations))
                                      [(binding [*skip-anns* (mods-type-anns (tr/f d :mods))]
                                         (decl-tag env (m/stype (attr/sym d :field-decl)) true))])))))
        ;; a variable arity record: & before the last component
        comps (if (and (seq comps)
                       (m/record-varargs? c))
                (conj (pop comps) '& (peek comps))
                comps)
        opts (concat
              (when (and ext (not (#{"INTERFACE" "ANNOTATION_TYPE"} k)))
                [:extends (type-form senv (attr/type-of ext :names/type-tree))])
              (when impl
                [(if (#{"INTERFACE" "ANNOTATION_TYPE"} k) :extends :implements)
                 (mapv #(type-form senv (attr/type-of % :names/type-tree)) impl)])
              (when perm [:permits (mapv #(type-form senv (attr/type-of % :names/type-tree)) perm)])
              (when-let [tp (type-params env (tr/f cd :typarams))] [:type-params tp]))]
    (note! (keyword "class" (or (some-> kind-kw name) "class")))
    [nm comps opts]))

(defn class-form
  "A defclass form for member or top-level class tree `cd`; with `pos?` (a top-level class, or a
  member of one with `pos?`) its span and its members' recorded in mode :full."
  ([env cd] (class-form env cd false))
  ([env cd pos?]
   (attr/framed :CLASSDEF
     (let [[nm comps opts] (class-header env cd)
           env' (class-env (assoc env :this nil) (attr/sym cd :class-decl))]
       (cond-> (apply list 'defclass nm (concat (when comps [comps]) opts (class-body env' cd pos?)))
         pos? (at cd))))))

(defn local-class-binding
  "[(Name ...) env'] for a local class declaration."
  [env cd]
  (let [c (attr/sym cd :class-decl)
        env' (update env :scope assoc (m/simple-name c) c)
        [nm comps opts] (class-header env' cd)
        inner (class-env (assoc env' :this nil) c)]
    [(with-meta (apply list nm (concat (when comps [comps]) opts (class-body inner cd)))
       {:class-body? true})
     env']))

(defn anon-form [env t]
  (let [cd (tr/f t :def)
        c (attr/sym cd :class-decl)
        ifaces (seq (m/class-interfaces c))
        super (if ifaces (first ifaces) (m/class-superclass c))
        m (anon-super-ctor cd (attr/constructor t))
        ;; Java's o.new Inner(args) {...} (§4.8): javac's constructor type has the outer
        ;; instance as first parameter
        ctype (let [ct (attr/constructor-type t m)]
                (if (and (tr/f t :encl) (m/method-type? ct))
                  (m/without-first-param ct)
                  ct))
        ve (attr/varargs-element t m)
        loose? (and ve (erased-varargs-elem? m ve))
        [afs _ nodes] (call-args env m ctype (tr/f t :args) ve loose?)
        encl (when (tr/f t :encl) (coerce env (ex env (tr/f t :encl)) (erasure (attr/type-of (tr/f t :encl) :types/expr))))
        pin? (and (not ifaces)
                  (pin-needed? :ctor c (m/tsym (erasure super)) m nodes loose?))
        inner (class-env (assoc env :this nil) c)]
    (note! :form/anon)
    (when encl (note! :form/anon-outer))
    (r (apply list (h env 'anon)
              ;; Java's diamond: javac gives the constructor of an anonymous class of an
              ;; interface no Signature then (§4.8)
              (cond-> (type-form env super)
                (and ifaces (tr/diamond? t)) (m+ (do (note! :form/anon-diamond) :diamond)))
              (cond-> (vec afs) pin? (m+ (param-tags env m)))
              (concat (when encl [:outer encl]) (class-body inner cd)))
       (erasure (attr/type-of t :types/new)))))

;;; ------------------------------------------------------------------------------------------
;;; Modules and packages (§4.14)

(defn- full-name
  "A class named by its binary name, as module declarations name them."
  [t]
  (symbol (m/binary-name (m/tsym t))))

(defn- module-form [env md]
  (note! :form/defmodule)
  (let [nm (apply m+ (symbol (str (tr/full-name (tr/f md :qualId))))
                  (concat (when (tr/open-module? md) [:open])
                          (annotation-items env (tr/f (tr/f md :mods) :annotations))))
        name-of (fn [e] (symbol (str (tr/full-name e))))
        dirs (for [d (tr/f md :directives)]
               (case (tr/tag d)
                 :REQUIRES (let [rq d]
                             (list 'requires (apply m+ (name-of (tr/f rq :moduleName))
                                                    (concat (when (tr/f rq :isTransitive) [:transitive])
                                                            (when (tr/f rq :isStaticPhase) [:static])))))
                 :EXPORTS (let [e d]
                            (apply list 'exports (name-of (tr/f e :qualid))
                                   (when (seq (tr/f e :moduleNames)) [:to (mapv name-of (tr/f e :moduleNames))])))
                 :OPENS (let [e d]
                          (apply list 'opens (name-of (tr/f e :qualid))
                                 (when (seq (tr/f e :moduleNames)) [:to (mapv name-of (tr/f e :moduleNames))])))
                 :USES (list 'uses (full-name (attr/type-of (tr/f d :qualid) :names/type-tree)))
                 :PROVIDES (let [p d]
                             (list 'provides (full-name (attr/type-of (tr/f p :serviceName) :names/type-tree))
                                   :with (mapv #(full-name (attr/type-of % :names/type-tree)) (tr/f p :implNames))))))]
    (apply list 'defmodule nm dirs)))

;;; ------------------------------------------------------------------------------------------
;;; Compilation units

(defn base-env [opts]
  {:classes () :scope {} :locals {} :names #{} :fields #{} :this nil :ret nil :loops ()
   :lbl (atom {}) :counter (atom 0)})

(defn- count-kinds!
  "Count the tree kinds of javac's tree `t` (for the coverage report)."
  [^JCTree t]
  (when *stats*
    (letfn [(walk [x]
              (when (instance? JCTree x)
                (when-not (instance? com.sun.tools.javac.tree.JCTree$TypeBoundKind x) (note! (keyword "kind" (kind-of x))))
                (run! walk (tree-children x))))]
      (walk t))))

(defn- type-decls
  "The unit's declarations after its package, imports and module (JCCompilationUnit.getTypeDecls)."
  [u]
  (if (tr/jc? u)
    (.getTypeDecls ^JCTree$JCCompilationUnit u)
    (drop-while #(#{:MODULEDEF :PACKAGEDEF :IMPORT :MODULEIMPORT} (tr/tag %)) (tr/f u :defs))))

(defn- module-decl "JCCompilationUnit.getModuleDecl." [u]
  (first (filter #(tr/is? % :MODULEDEF) (tr/f u :defs))))

(defn- package-decl "JCCompilationUnit.getPackage." [u]
  (let [d (first (tr/f u :defs))] (when (tr/is? d :PACKAGEDEF) d)))

(defn- defclasses-form
  "Top-level forms with two or more defclass forms gathered into one (defclasses ...) where the
  first stood."
  [forms]
  (let [cls? #(and (seq? %) (= 'defclass (first %)))]
    (if (< (count (filter cls? forms)) 2)
      forms
      (let [i (first (keep-indexed (fn [i f] (when (cls? f) i)) forms))]
        (vec (concat (take i (remove cls? forms))
                     [(apply list 'defclasses (filter cls? forms))]
                     (drop i (remove cls? forms))))))))

(defn convert-unit
  "Convert compilation unit `cu`, javac's attributed one; with (:tree opts) the native parser's tree
  of the same text instead, its attribution javac's by position ((:index opts), attr/index). Returns
  {:package p :forms [..] :file name :classes [names]} (with attr/*measure* also :split)."
  [^JCTree$JCCompilationUnit cu opts]
  (when cu (count-kinds! cu))
  (let [u (or (:tree opts) cu)
        idx (:index opts)]
    ;; without javac (cu nil, a read without javac, JFS111 (b)): the native tree, its text and source
    (binding [*text* (if cu (str (.getCharContent (.getSourceFile cu) true)) (:text opts))
              *full* (when (:full opts) (atom 0))
              tr/*end-positions* (when cu (.endPositions cu))
              attr/*twins* (:twins idx)
              attr/*natives* (:natives idx)
              attr/*dropped* (:dropped idx)
              attr/*owners* (when attr/*measure* (java.util.IdentityHashMap.))
              attr/*frames* (when attr/*measure* (volatile! []))]
      (binding [*assigned* (into #{} (mapcat assigned-syms) (type-decls u))
                *local-names* (into #{} (for [d (type-decls u)
                                              x (tree-seq tr/tree? tree-children d)
                                              :when (and (tr/is? x :VARDEF)
                                                         (attr/local-of x :local-names))]
                                          (str (tr/f x :name))))]
        (let [env (base-env opts)
              pkg (attr/packge u)
              pkg-name (if pkg (m/package-name pkg) "")
              file (.getName (java.io.File. (if cu (.getName (.getSourceFile cu)) ^String (:source opts))))
              forms (vec (for [d (type-decls u)
                               :when (not (tr/is? d :SKIP))]
                           (case (tr/tag d)
                             :CLASSDEF (class-form env d true)
                             :MODULEDEF (at (module-form env d) d))))
              forms (if-let [md (module-decl u)]
                      (into [(at (module-form env md) md)] forms)
                      forms)
              split (when attr/*measure* (attr/split-of forms))
              forms (mapv simplify forms)
              pd (package-decl u)
              pkg-anns (when pd (seq (annotation-items env (tr/f pd :annotations))))
              forms (if (and (= file "package-info.java") pkg-anns)
                      (into [(at (apply list 'defpackage (apply m+ (symbol pkg-name) pkg-anns) [])
                                 pd)]
                            forms)
                      forms)
              ;; mode :full: the file's text and its top-level forms' starts on the first form
              forms (if (and *full* (seq forms))
                      (update forms 0 m+ [:java :file {:text *text*
                                                       :at (mapv #(first (some (fn [it] (when (and (vector? it) (= [:java :at] (subvec it 0 2))) (nth it 2)))
                                                                               (f/items %)))
                                                                 forms)}])
                      forms)
              ;; a file's top-level classes are one compilation, as javac compiles them: two
              ;; or more written as one defclasses (JCS30 (b), doc/classes/JAVA-CONFORMANCE-SURVEY.md,
              ;; "As built: JC5")
              forms (defclasses-form forms)]
          (cond-> {:package pkg-name :file file :forms forms
                   :supers (set (for [d (type-decls u)
                                      :when (tr/is? d :CLASSDEF)
                                      :let [ds (attr/sym d :class-decl)]
                                      sc (m/closure-classes (m/stype ds))
                                      :let [c (m/outermost sc)]
                                      :when (and pkg (= (m/package-of c) (m/pkg-name pkg))
                                                 (not (identical? c ds)))]
                                  (m/simple-name c)))
                   :pkg-classes (when pkg (m/pkg-class-names pkg))
                   :classes (vec (for [d (type-decls u) :when (tr/is? d :CLASSDEF)]
                                   (str (tr/f d :name))))}
            split (assoc :split split)
            ;; mode :full of a file without declarations (its package line and comments): the
            ;; file's record on its in-ns (names/unit-text), as no form holds it (RPS83 (a))
            (and *full* (empty? forms)) (assoc :file-record {:text *text* :at []})))))))

;;; ------------------------------------------------------------------------------------------
;;; Simplification of the output: when, when-not, cond, spliced do

(defn- body-start
  "Index of the first body form in list `x` whose body forms may be spliced, or nil."
  [x]
  (let [hd (first x)]
    (case (when (symbol? hd) (name hd))
      ("do" "try" "finally" "initializer" "static-initializer") 1
      ("when" "when-not" "while" "locking" "let" "loop" "for-each" "with-resources" "label"
       "letclass" "when-instance") 2
      "catch" 3
      ("method" "constructor" "lambda")
      (let [v (vec x)]
        (loop [i 1]
          (cond
            (>= i (count v)) nil
            (keyword? (v i)) (recur (+ i 2))
            (vector? (v i)) (inc i)
            :else (recur (inc i)))))
      nil)))

(defn- keep-meta [old new] (if (meta old) (with-meta new (meta old)) new))

(defn- if-head? [x s] (and (seq? x) (= s (first x))))

(defn- sh [s]
  (if (contains? *local-names* (name s))
    (symbol "arbace.core" (name s))
    s))

(defn simplify [x]
  (cond
    (and (seq? x) (seq x))
    (let [y (keep-meta x (apply list (map simplify x)))
          y (if-let [i (body-start y)]
              (let [[pre body] (split-at i y)
                    ;; a try's catch and finally clauses follow its body
                    [body clauses] (if (if-head? y 'try)
                                     (split-with #(not (or (if-head? % 'catch) (if-head? % 'finally))) body)
                                     [body nil])
                    body (mapcat (fn [b] (if (and (if-head? b 'do) (not (meta b))) (rest b) [b])) body)
                    ;; nils that are not the value
                    body (concat (remove nil? (butlast body)) (when (seq body) [(last body)]))]
                (keep-meta y (apply list (concat pre body clauses))))
              y)
          splice (fn [b] (if (and (if-head? b 'do) (not (meta b))) (rest b) [b]))]
      (cond
        (and (if-head? y 'if) (= 4 (count y)))
        (let [[_ c a b] y]
          (cond
            (and (nil? b) (not (if-head? a 'if)))
            (keep-meta y (apply list (sh (if (and (seq? c) (= 'not (first c))) 'when-not 'when))
                                (if (and (seq? c) (= 'not (first c))) (second c) c) (splice a)))
            (nil? a)
            (if (and (seq? c) (= 'nil? (first c)) (= 2 (count c)))
              (keep-meta y (apply list (sh 'when) (list (sh 'some?) (second c)) (splice b)))
              (keep-meta y (apply list (sh 'when-not) c (splice b))))
            (or (and (if-head? b 'if) (= 4 (count b))) (if-head? b 'cond)
                (and (if-head? b 'when) (= 3 (count b))))
            (let [tail (cond
                         (if-head? b 'cond) (rest b)
                         (if-head? b 'when) [(nth b 1) (nth b 2)]
                         :else (let [[_ c2 a2 b2] b] (if (nil? b2) [c2 a2] [c2 a2 :else b2])))]
              (keep-meta y (apply list (sh 'cond) c a tail)))
            :else y))
        (and (if-head? y 'when) (seq? (second y)) (= 'not (first (second y))) (= 2 (count (second y))))
        (keep-meta y (apply list (sh 'when-not) (second (second y)) (drop 2 y)))
        (and (if-head? y 'if-instance) (= 4 (count y)) (nil? (nth y 3)))
        (keep-meta y (apply list (sh 'when-instance) (second y) (splice (nth y 2))))
        (and (if-head? y 'if) (= 3 (count y)))
        (let [[_ c a] y] (keep-meta y (apply list (sh 'when) c (splice a))))
        (and (if-head? y 'when-not) (seq? (second y)) (= 'nil? (first (second y))))
        (keep-meta y (apply list (sh 'when) (list (sh 'some?) (second (second y))) (drop 2 y)))
        (and (if-head? y 'when-not) (seq? (second y)) (= 'some? (first (second y))))
        (keep-meta y (apply list (sh 'when) (list (sh 'nil?) (second (second y))) (drop 2 y)))
        (and (if-head? y 'do) (= 2 (count y)) (not (meta y))) (second y)
        :else y))
    (vector? x) (keep-meta x (mapv simplify x))
    :else x))

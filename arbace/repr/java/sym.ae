(ns arbace.repr.java.sym
  "The native attribution's symbol type (doc/classes/JAVA-FRONTEND-SURVEY.md, \"As built: JN9d\",
  JFS107 (b)): a map compared by identity, with keyword lookups. In a namespace of its own, which
  rarely changes, so that `arbace.repr.java.decls` (which makes the symbols) can be loaded again
  from the checkout on a tool that compiled it: a `deftype` evaluated again is a new class, and the
  compiled namespaces' `instance?` checks and type hints name the class compiled into the tool.")

(set! *warn-on-reflection* true)

(deftype Sym [^arbace.lang.IPersistentMap m]
  arbace.lang.ILookup
  (valAt [_ k] (.valAt m k))
  (valAt [_ k nf] (.valAt m k nf))
  Object
  (toString [_] (str "#sym[" (name (or (.valAt m :sk) :?)) " " (or (.valAt m :flat) (.valAt m :name)) "]")))

(defn sym "A symbol of map `m` (keyword lookups; equal only to itself)." [m] (Sym. m))

(defn sym? "A native symbol?" [x] (instance? Sym x))

(defn sym-map "The map of symbol `s`." [s] (.-m ^Sym s))

(ns arbace.repr.java.split
  "How the converter splits between the tree's syntax and javac's attribution
  (doc/classes/JAVA-FRONTEND-SURVEY.md, \"As built: JFS66 (b)\"): the catalogue of the attribution facts
  arbace.repr.java.convert asks through arbace.repr.java.attr (each with the javac phase that
  computes it and what a native attribution, JN9, would have to provide), their tiers, the summary of
  the measured runs (`read --split`'s repr-java-split.edn files: the facts asked, the output lists
  classified by the facts their writing asked, the converted nodes) and the static split of the
  converter's code (its top-level forms that ask attribution, directly or through the functions they
  call).

  bin/repr-java front-check (bin/lib/repr-java/front-check) runs, on the tools' host:
    -m arbace.repr.java.split summary OUT DIR...   the split of the runs under the DIRs, by corpus
                                                   (a DIR's name), into OUT/split.edn and OUT/split.md
    -m arbace.repr.java.split static               the static split, printed
    -m arbace.repr.java.split attr OUT KNOWN DIR...  the native provider's outcomes (\"As built: JN9a\")
                                                   under the DIRs, by corpus, into OUT/attr.edn and
                                                   OUT/attr.md; the different facts beyond KNOWN's
                                                   ({:CORPUS {:facts {fact n}}}) printed"
  (:require [arbace.java.io :as io]
            [arbace.pprint :as pp]
            [arbace.string :as str])
  (:import [java.io File PushbackReader StringReader]))

;;; ------------------------------------------------------------------------------------------
;;; The tiers and the catalogue

(def tiers
  "The tiers of what a native front end must provide, cheapest first: what the tree gives with a
  local rule; local scopes (a syntactic pass); the declarations (javac's Enter, TypeEnter,
  MemberEnter: classes, members, flags, declared types, type names resolved, annotation values);
  flow (JLS 14.22, exhaustiveness); member lookup of names in code; expression types; overload
  resolution; inference (generic methods, poly expressions, lambda targets)."
  [:syntax :scope :declarations :flow :members :types :overload :inference])

(def tier-rank (zipmap tiers (range)))

(def catalogue
  "Fact id -> [tier javac's phase what the converter takes]; a sym fact's class (its namespace) is the
  symbol's (attr/sym): :scope a local, :enter a declaration's, :names a field, class or package,
  :overload a method."
  {:types/literal [:syntax "Attr.visitLiteral" "a literal's type (its typetag: int, long, String, ...)"]
   :scope/ident [:scope "Attr.visitIdent, Resolve.findVar" "a name's local variable or parameter"]
   :scope/local-decl [:scope "MemberEnter (local VarSymbol)" "a local declaration's symbol (identity, declared type, flags: final, effectively final)"]
   :scope/param [:scope "MemberEnter.visitMethodDef" "a parameter's symbol (identity, type, flags)"]
   :scope/lambda-param [:scope "Attr.visitLambda" "a lambda parameter's symbol (identity, type: inferred for implicit ones)"]
   :scope/binding [:scope "Attr.visitBindingPattern" "a pattern variable's symbol"]
   :scope/assigned [:scope "Attr.visitIdent" "an assigned local (the converter's ^:mutable)"]
   :scope/capture [:scope "Attr.visitIdent" "a local a class or lambda captures"]
   :scope/hoist [:scope "Attr.visitIdent" "the names in an expression with postfix increments (their uses)"]
   :scope/refers [:scope "Attr.visitIdent" "whether a tree mentions a local"]
   :scope/local-names [:scope "MemberEnter" "the unit's locals' names"]
   :scope/type-expr [:scope "Attr.visitIdent" "a qualifier that is a local, not a type"]
   :scope/label [:scope "Attr.visitIdent" "a case label naming a local constant"]
   :scope/resource [:scope "Attr.visitIdent" "a resource named by a local"]
   :scope/jump-target [:scope "Attr.findJumpTarget" "the statement a break, continue or yield leaves"]
   :scope/select [:scope "Attr.visitSelect" "a selection that is a local"]
   :enter/class-decl [:declarations "Enter.visitClassDef, TypeEnter" "a class's symbol: flags, members, supertypes, type parameters, record components"]
   :enter/method-decl [:declarations "MemberEnter.visitMethodDef" "a method's symbol: flags (varargs, generated, compact), type, default value"]
   :enter/field-decl [:declarations "MemberEnter.visitVarDef" "a field's symbol: flags (enum, record, generated), type, constant value"]
   :enter/flags [:declarations "Enter.visitClassDef" "the modifiers as Enter completes them (public static of an interface's member class)"]
   :enter/members [:declarations "TypeEnter, MemberEnter" "a class's members by name, flags and erased signature, TypeEnter's generated ones included (checked only, JFS79)"]
   :enter/platform-members [:declarations "ClassReader" "a platform class's members as its class file gives them, against javac's ClassSymbol (checked only, JFS106 (b))"]
   :enter/local-names [:declarations "MemberEnter" "a field among the unit's variable declarations"]
   :annotations/attribute [:declarations "Annotate" "an annotation's values (constants, classes, enums, nested), its retention"]
   :names/type-tree [:declarations "Attr.attribType, TypeEnter" "a type tree's type (names resolved, type arguments, annotations)"]
   :names/type-expr [:declarations "Attr.visitIdent, visitSelect (KindSelector)" "whether a qualifier names a type or package (JLS 6.5)"]
   :names/package [:declarations "Enter.visitTopLevel" "the unit's package symbol and its classes"]
   :names/package-classes [:members "ClassFinder.fillIn, includeClassFile" "the top-level class names of the unit's package, on every location (JFS112 (b), JN9e)"]
   :annotations/dropped [:declarations "Check.validateAnnotation" "a record component's annotation taken off its field's modifiers (JFS110 (b), JN9e)"]
   :names/record-pattern [:declarations "Attr.visitRecordPattern" "a record pattern's record type"]
   :names/local-class [:inference "Check.localClassName, Attr's order" "a local or anonymous class's flat name, numbered as Attr enters them (checked once per class, JFS91 (b))"]
   :types/this [:declarations "Attr.visitIdent, visitSelect" "the type of this, super, C.this"]
   :types/class-literal [:declarations "Attr.visitSelect" "a class literal's type"]
   :flow/case-completes [:flow "Flow.AliveAnalyzer" "whether a case's statements complete normally (fall-through)"]
   :flow/exhaustive [:flow "Flow, ExhaustivenessComputer" "whether a switch statement is exhaustive"]
   :flow/unconditional-pattern [:flow "Attr.handleSwitch" "whether a switch has an unconditional pattern"]
   :names/ident [:members "Attr.visitIdent, Resolve.findIdent" "a simple name's field or class (inherited, outer, static imports)"]
   :names/select [:members "Attr.visitSelect, Resolve.findIdentInType" "a selection's field, class or package"]
   :names/assigned [:members "Attr.visitIdent" "an assigned name's symbol (a field)"]
   :names/capture [:members "Attr.visitIdent" "a name's symbol in a capturing class or lambda (a field or class)"]
   :names/hoist [:members "Attr.visitIdent, visitSelect" "the names' symbols in an expression with postfix increments"]
   :names/refers [:members "Attr.visitIdent" "a name's symbol (a field or class), compared with a local's"]
   :names/label [:members "Attr.visitIdent, visitSelect" "a case label's constant field"]
   :names/resource [:members "Attr.visitIdent" "a resource named by a field"]
   :names/local-names [:members "MemberEnter" "the unit's variable declarations' symbols"]
   :names/method [:members "Attr.visitApply" "a call's method symbol where it is not a method"]
   :names/ident-sym [:members "Attr.visitIdent" "a name's symbol"]
   :types/expr [:types "Attr (attribExpr, check)" "an expression's type (erased by the converter)"]
   :types/qualifier [:types "Attr.visitSelect" "a qualifier's type (the site of a member)"]
   :types/constant [:types "Attr, ConstFold" "an expression's constant value (folded labels, while(true), concatenation operands)"]
   :types/var-constant [:types "Attr.visitVarDef, attribLazyConstantValue" "a final `var` local's constant value at its inferred type (JFS112 (b), JN9e)"]
   :types/operator [:types "Attr.visitBinary, Operators.resolveBinary" "the operator resolved by the operand types (its parameter types)"]
   :types/new [:types "Attr.visitNewClass" "a new instance's class type"]
   :types/new-array [:types "Attr.visitNewArray" "a new array's type"]
   :types/ident [:types "Attr.visitIdent" "an odd name's type"]
   :types/record-components [:types "TransTypes.visitRecordPattern, TransPatterns" "a record pattern's components' erased member types at its type, and declared (a nested type pattern unconditional by the type arguments, JCS114 (a), JN9f)"]
   :types/pattern-switch [:types "Attr.handleSwitch" "whether a switch is a pattern switch (labels and selector type)"]
   :types/result [:types "Attr (the operands' types)" "a conversion decided by a converted operand's type (coerce, test-form)"]
   :overload/method [:overload "Resolve.resolveQualifiedMethod, findFun" "a call's method symbol"]
   :overload/constructor [:overload "Resolve.resolveConstructor" "a new instance's constructor"]
   :overload/anon-super-ctor [:overload "TypeEnter (anonymous constructor), Resolve" "the superclass constructor of an anonymous class"]
   :overload/method-ref [:overload "Attr.visitReference, Resolve" "a method reference's method"]
   :overload/ref-kind [:overload "Attr.visitReference" "a method reference's kind (static, bound, unbound, constructor)"]
   :overload/hoist [:overload "Resolve" "a method named in an expression with postfix increments"]
   :overload/capture [:overload "Resolve" "a method named in a capturing class or lambda"]
   :overload/assigned [:overload "Resolve" "a method named where assignments are sought"]
   :overload/refers [:overload "Resolve" "a method named where a local is sought"]
   :overload/ident [:overload "Resolve" "a name that is a method"]
   :overload/select [:overload "Resolve" "a selection that is a method"]
   :overload/local-names [:overload "Resolve" "-"]
   :overload/declared-method-type [:overload "MemberEnter (the symbol's type)" "a call's method type, the symbol's own (not generic)"]
   :overload/declared-constructor-type [:overload "MemberEnter (the symbol's type)" "a constructor's type, the symbol's own"]
   :overload/arity [:overload "Resolve (phase 3)" "whether a call is of variable arity"]
   :overload/declared-varargs-element [:overload "Resolve (phase 3)" "a variable arity call's array element, the declared one"]
   :types/member-method-type [:types "Types.memberType" "a call's method type at the site's type arguments"]
   :types/member-constructor-type [:types "Types.memberType" "a constructor's type at the class's type arguments"]
   :types/member-varargs-element [:types "Types.memberType" "a variable arity call's array element at the site's type arguments"]
   :infer/method-type [:inference "Attr.checkMethod, Infer" "a generic method's instantiated type (argument targets, call site types)"]
   :infer/constructor-type [:inference "Attr.visitNewClass, Infer" "a generic or diamond constructor's instantiated type"]
   :infer/varargs-element [:inference "Attr.checkMethod, Infer" "a generic method's variable arity array element type, inferred"]
   :infer/target [:inference "Attr.visitLambda, visitReference, DeferredAttr" "a lambda's or method reference's functional interface type"]
   :infer/poly-result [:inference "Attr.visitApply" "a signature polymorphic call's result type"]})

(defn tier-of
  "The tier of fact `id`: the catalogue's, else by its class."
  [id]
  (or (first (get catalogue id))
      (case (namespace id)
        "scope" :scope "enter" :declarations "annotations" :declarations "flow" :flow "names" :members
        "types" :types "overload" :overload "infer" :inference :types)))

(defn- fact? "A fact id (not the native provider's mark :provider/javac)." [id] (not= "provider" (namespace id)))

(defn max-tier
  "The highest tier of the facts `ids` (:syntax for none); :unowned for a list no frame wrote."
  [ids]
  (if (= ids :unowned) :unowned (reduce #(if (> (tier-rank %2) (tier-rank %1)) %2 %1) :syntax (map tier-of (filter fact? ids)))))

(defn native-list?
  "With the native provider (\"As built: JN9a\"): did its writing ask no fact that javac answered?"
  [ids]
  (and (not= ids :unowned) (not (contains? (set ids) :provider/javac))))

;;; ------------------------------------------------------------------------------------------
;;; The summary of the measured runs

(defn- read-edn [f]
  (with-open [r (PushbackReader. (io/reader f))] (binding [*read-eval* false] (read r))))

(defn- split-files [dir]
  (for [^File f (file-seq (io/file dir))
        :when (and (.isFile f) (= "repr-java-split.edn" (.getName f)))]
    f))

(defn- add [a b] (merge-with + a b))

(defn summarize
  "The split of the runs whose repr-java-split.edn files are under `dir`."
  [dir]
  (let [rs (map read-edn (split-files dir))
        facts (reduce add {} (map :facts rs))
        lists (reduce add {} (map :lists rs))
        frames (reduce add {} (map :frames rs))
        index (reduce add {} (map :index rs))
        total (reduce + (vals lists))
        by-tier (reduce (fn [m [ids n]] (update m (max-tier ids) (fnil + 0) n)) {} lists)
        needs (reduce (fn [m [ids n]]
                        (if (= ids :unowned) m
                            (reduce #(update %1 %2 (fnil + 0) n) m (distinct (map tier-of (filter fact? ids))))))
                      {} lists)
        by-class (reduce (fn [m [ids n]]
                           (if (= ids :unowned) m
                               (reduce #(update %1 %2 (fnil + 0) n) m (distinct (map #(keyword (namespace %)) (filter fact? ids))))))
                         {} lists)
        native (reduce (fn [a [ids n]] (if (native-list? ids) (+ a n) a)) 0 lists)
        marked? (some (fn [[ids _]] (and (not= ids :unowned) (contains? (set ids) :provider/javac))) lists)
        nodes (reduce + (vals frames))
        node-tiers (reduce (fn [m [[tg ids] n]] (update-in m [tg (max-tier ids)] (fnil + 0) n)) {} frames)
        node-syntax (reduce + (for [[[_ ids] n] frames :when (empty? ids)] n))]
    {:units (reduce + (map :units rs))
     :facts (into (sorted-map) facts)
     :index index
     :lists total
     :lists-by-tier (into {} by-tier)
     :lists-needing (into {} needs)
     :lists-needing-class (into (sorted-map) by-class)
     :lists-native (when marked? native)
     :nodes nodes
     :nodes-asking-nothing node-syntax
     :nodes-by-tag (into (sorted-map) node-tiers)}))

(defn- pct [n d] (if (zero? d) "-" (format "%.1f%%" (* 100.0 (/ (double n) d)))))

(defn- fmt [n] (let [s (str n)] (str/replace s #"\B(?=(\d{3})+(?!\d))" ",")))

(defn markdown
  "The summaries by corpus ({corpus summary}) as Markdown tables."
  [sums]
  (let [cs (sort (keys sums))
        all-facts (sort (distinct (mapcat (comp keys :facts) (vals sums))))
        sb (StringBuilder.)
        line (fn [& xs] (.append sb (apply str xs)) (.append sb "\n"))]
    (line "| | " (str/join " | " cs) " |")
    (line "|---|" (str/join "" (repeat (count cs) "---:|")))
    (line "| units | " (str/join " | " (map #(fmt (:units (sums %))) cs)) " |")
    (line "| nodes converted (frames) | " (str/join " | " (map #(fmt (:nodes (sums %))) cs)) " |")
    (line "| of them asking no attribution | " (str/join " | " (map #(let [s (sums %)] (str (fmt (:nodes-asking-nothing s)) " (" (pct (:nodes-asking-nothing s) (:nodes s)) ")")) cs)) " |")
    (line "| lists written | " (str/join " | " (map #(fmt (:lists (sums %))) cs)) " |")
    (when (some #(:lists-native (sums %)) cs)
      (line "| lists the native provider wrote alone | "
            (str/join " | " (map #(let [s (sums %)] (if-let [n (:lists-native s)] (str (fmt n) " (" (pct n (:lists s)) ")") "-")) cs)) " |"))
    (line "")
    (line "Lists by the highest tier their writing asked (cumulative share in parentheses):")
    (line "")
    (line "| tier | " (str/join " | " cs) " |")
    (line "|---|" (str/join "" (repeat (count cs) "---:|")))
    (doseq [[i t] (map-indexed vector (conj tiers :unowned))]
      (line "| " (name t) " | "
            (str/join " | " (for [c cs :let [s (sums c) n (get (:lists-by-tier s) t 0)
                                             cum (reduce + (for [u (take (inc i) (conj tiers :unowned))] (get (:lists-by-tier s) u 0)))]]
                              (str (fmt n) " (" (pct cum (:lists s)) ")")))
            " |"))
    (line "")
    (line "Lists whose writing asked a fact of the tier (not exclusive):")
    (line "")
    (line "| tier | " (str/join " | " cs) " |")
    (line "|---|" (str/join "" (repeat (count cs) "---:|")))
    (doseq [t (rest tiers)]
      (line "| " (name t) " | " (str/join " | " (for [c cs :let [s (sums c) n (get (:lists-needing s) t 0)]] (str (fmt n) " (" (pct n (:lists s)) ")"))) " |"))
    (line "")
    (line "The facts asked (attr's sites), by id:")
    (line "")
    (line "| fact | tier | " (str/join " | " cs) " |")
    (line "|---|---|" (str/join "" (repeat (count cs) "---:|")))
    (doseq [f all-facts]
      (line "| `" (subs (str f) 1) "` | " (name (tier-of f)) " | " (str/join " | " (map #(fmt (get-in sums [% :facts f] 0)) cs)) " |"))
    (line "")
    (line "The index (native nodes paired with javac's by position):")
    (line "")
    (doseq [c cs] (line "- " c ": " (pr-str (:index (sums c)))))
    (str sb)))

;;; ------------------------------------------------------------------------------------------
;;; The static split

(def converter-files
  ["arbace/repr/java/convert.ae"])

(defn- code-lines
  "The lines of text `lines` (a seq) that hold code (not blank, not comments)."
  [lines]
  (count (remove #(re-matches #"\s*(;.*)?" %) lines)))

(defn- syms [x]
  (cond (symbol? x) [x]
        (or (seq? x) (vector? x) (set? x)) (mapcat syms x)
        (map? x) (mapcat syms (concat (keys x) (vals x)))
        :else []))

(def ^:private model-methods
  "The interop methods the converter calls on attribution's answers (javac's Symbol, Type, Types,
  Attribute), the tree's being behind arbace.repr.java.tree."
  #{".tsym" ".owner" ".flags" ".members" ".getSymbolsByName" ".getSymbols" ".erasure" ".closure"
    ".isMemberOf" ".outermostClass" ".packge" ".getParameterTypes" ".getReturnType" ".getTypeArguments"
    ".getEnclosingType" ".allparams" ".constValue" ".getConstValue" ".isInterface" ".getSimpleName"
    ".baseSymbol" ".isSignaturePolymorphic" ".isSameType" ".skipTypeVars" ".isCompound"
    ".getAnnotationMirrors" ".getRecordComponents" ".getInterfaces" ".getSuperclass" ".getRetention"
    ".findDescriptorType" ".findDescriptorSymbol" ".unboxedType" ".makeArrayType" ".asMethodType"
    ".getThrownTypes" ".defaultValue" ".values" ".fst" ".snd" ".elemtype" ".type" ".name" ".kind"
    ".getValue" ".isVarargs" ".getTag" ".tail" ".getUpperBound" ".intType" ".booleanType"})

(defn- model? [s]
  (or (#{"jt" "res" "m"} (namespace s))
      ;; jtypes' functions convert refers
      (and (nil? (namespace s)) (#{"erasure" "prim?" "ref-type?" "same?" "subtype?" "tag-name"} (name s)))
      (re-find #"^(Type|Symbol|Attribute|Flags|BoundKind|TypeTag)" (str s))
      (model-methods (name s))))

(defn static-split
  "For each file of `files`: its top-level forms, those asking attribution (calling attr/'s
  functions) directly and through the file's functions they call, and their code lines."
  [files]
  (vec
   (for [path files]
     (let [text (slurp path)
           lines (vec (str/split-lines text))
           ;; auto-resolved keywords (::f/m) read as plain ones: only the symbols matter here
           r (arbace.lang.LineNumberingPushbackReader. (StringReader. (str/replace text "::" ":")))
           eof (Object.)
           forms (binding [*read-eval* false]
                   (loop [acc []]
                     (let [f (read r false eof)]
                       (if (identical? f eof) acc (recur (conj acc f))))))
           starts (mapv #(or (:line (meta %)) 1) forms)
           ends (conj (mapv dec (rest starts)) (count lines))
           info (vec (for [[f s e] (map vector forms starts ends)]
                       (let [ss (syms f)]
                         {:name (when (seq? f) (second f))
                          :attr (into (sorted-set) (keep #(when (= "attr" (namespace %)) (name %)) ss))
                          :tree (some #(= "tr" (namespace %)) ss)
                          :model (some model? ss)
                          :refs (set (remove namespace ss))
                          :lines (code-lines (subvec lines (dec s) e))})))
           names (set (keep :name info))
           direct (set (keep #(when (seq (:attr %)) (:name %)) info))
           answers (into direct (keep #(when (:model %) (:name %)) info))
           trans (loop [s answers]
                   (let [s' (into s (keep #(when (some s (filter names (:refs %))) (:name %)) info))]
                     (if (= s s') s (recur s'))))
           sum (fn [p] (reduce + (map :lines (filter p info))))]
       {:file path
        :forms (count info) :lines (sum identity)
        :attr-direct (count direct) :attr-direct-lines (sum #(direct (:name %)))
        :answers-direct (count answers) :answers-direct-lines (sum #(answers (:name %)))
        :attr-transitive (count trans) :attr-transitive-lines (sum #(trans (:name %)))
        :tree-only (count (filter #(and (:tree %) (not (trans (:name %)))) info))
        :syntax-only-forms (vec (sort (map str (keep #(when (and (:name %) (not (trans (:name %)))) (:name %)) info))))
        :attr-calls (frequencies (mapcat (fn [i] (map #(str "attr/" %) (:attr i))) info))}))))

;;; ------------------------------------------------------------------------------------------
;;; The native provider's check ("As built: JN9a"): the outcomes of the facts it answered

(defn- attr-files [dir]
  (for [^File f (file-seq (io/file dir))
        :when (and (.isFile f) (= "repr-java-attr.edn" (.getName f)))]
    f))

(defn attr-summarize
  "The native provider's outcomes under `dir` (its runs' repr-java-attr.edn): {:facts {fact {outcome
  n}} :tiers {tier {outcome n}} :totals {outcome n} :diffs [...]}."
  [dir]
  (let [rs (map read-edn (attr-files dir))
        facts (apply merge-with (partial merge-with +) {} (map :facts rs))]
    {:facts (into (sorted-map) facts)
     :tiers (reduce (fn [m [f o]] (update m (tier-of f) #(merge-with + % o))) {} facts)
     :totals (apply merge-with + {} (vals facts))
     :model (into (sorted-map) (apply merge-with (partial merge-with +) {} (map :model rs)))
     :why (into (sorted-map) (apply merge-with (partial merge-with +) {} (map :why rs)))
     :diffs (vec (take 2000 (mapcat :diffs rs)))}))

(defn attr-markdown
  "The provider's outcomes by corpus ({corpus summary}) as Markdown tables: by tier and by fact."
  [sums]
  (let [cs (sort (keys sums))
        sb (StringBuilder.)
        line (fn [& xs] (.append sb (apply str xs)) (.append sb "\n"))
        cell (fn [o] (str (fmt (get o :equal 0)) " / " (fmt (get o :differ 0)) " / " (fmt (get o :declined 0))
                          (when (pos? (get o :leaned 0)) (str " (" (fmt (get o :leaned 0)) " on javac's overloads)"))))]
    (line "Facts answered natively, equal / different / declined (left to javac), by tier; in parentheses the")
    (line "answers that took javac's answer of a higher tier (a call's method where its choice needs inference):")
    (line "")
    (line "| tier | " (str/join " | " cs) " |")
    (line "|---|" (str/join "" (repeat (count cs) "---:|")))
    (doseq [t tiers :when (some #(get-in sums [% :tiers t]) cs)]
      (line "| " (name t) " | " (str/join " | " (map #(cell (get-in sums [% :tiers t])) cs)) " |"))
    (line "| total | " (str/join " | " (map #(cell (get-in sums [% :totals])) cs)) " |")
    (line "")
    (line "By fact:")
    (line "")
    (line "| fact | tier | " (str/join " | " cs) " |")
    (line "|---|---|" (str/join "" (repeat (count cs) "---:|")))
    (doseq [f (sort (distinct (mapcat #(keys (get-in sums [% :facts])) cs)))]
      (line "| `" (subs (str f) 1) "` | " (name (tier-of f)) " | " (str/join " | " (map #(cell (get-in sums [% :facts f])) cs)) " |"))
    ;; the model's reads of the answers (arbace.repr.java.model, JFS75 (b))
    (let [mcell (fn [o] (let [n (get o :native 0) j (get o :javac 0) b (get o :bridge 0)]
                          (str (fmt n) " / " (fmt j) " / " (fmt b) " (" (pct n (+ n j b)) ")")))
          tot (fn [c] (apply merge-with + {} (vals (get-in sums [c :model]))))]
      (when (some #(seq (get-in sums [% :model])) cs)
        (line "")
        (line "The model's reads of the answers (arbace.repr.java.model), native / javac / bridge (the native share):")
        (line "")
        (line "| read | " (str/join " | " cs) " |")
        (line "|---|" (str/join "" (repeat (count cs) "---:|")))
        (doseq [k (sort (distinct (mapcat #(keys (get-in sums [% :model])) cs)))]
          (line "| `" (name k) "` | " (str/join " | " (map #(mcell (get-in sums [% :model k])) cs)) " |"))
        (line "| total | " (str/join " | " (map #(mcell (tot %)) cs)) " |")))
    ;; the declines by fact and reason (JFS100 (b)): the next tiers' work list
    (let [rows (for [c cs [k rs] (get-in sums [c :why]) [r n] rs] [[(str/replace-first (name k) "." "/") r] c n])
          by (reduce (fn [m [k c n]] (update-in m [k c] (fnil + 0) n)) {} rows)]
      (when (seq by)
        (line "")
        (line "The declines by fact and reason (a decline's first reason met):")
        (line "")
        (line "| fact | reason | " (str/join " | " cs) " |")
        (line "|---|---|" (str/join "" (repeat (count cs) "---:|")))
        (doseq [[[f r] m] (sort-by (fn [[[f r] m]] [f (- (reduce + (vals m))) r]) by)]
          (line "| `" f "` | " (str/replace r "|" "\\|") " | " (str/join " | " (map #(fmt (get m % 0)) cs)) " |"))))
    (str sb)))

;;; ------------------------------------------------------------------------------------------
;;; The read without javac (JFS111 (b), "As built: JN9e"): its files, fallbacks, time and memory

(defn- nojavac-files [dir]
  (for [^File f (file-seq (io/file dir))
        :when (and (.isFile f) (= "repr-java-nojavac.edn" (.getName f)))]
    f))

(defn nojavac-summarize
  "The reads without javac under `dir` (their repr-java-nojavac.edn), summed: {:files :native
  :fallbacks n :by-reason {reason n} :sources [...]}; with the corpus's time file `time` (its reads'
  wall time) its :wall-s, and the reads' largest peak memory :peak-kb."
  [dir time]
  (let [rs (map read-edn (nojavac-files dir))
        w (when (.isFile (io/file time)) (str/trim (slurp time)))
        kb (some->> (seq (keep :peak-rss rs)) (apply max) (#(quot % 1024)))]
    (cond-> {:files (reduce + (map :files rs))
             :native (reduce + (map :native rs))
             :fallbacks (reduce + (map (comp count :fallbacks) rs))
             :by-reason (into (sorted-map) (apply merge-with + {} (map :by-reason rs)))
             :sources (vec (sort (for [r rs f (:fallbacks r)] (str (:source f) " " (:fallback f)))))}
      w (assoc :wall-s (Double/parseDouble w))
      kb (assoc :peak-kb kb))))

(defn nojavac-markdown [sums]
  (let [cs (sort (keys sums))
        sb (StringBuilder.)
        line (fn [& xs] (.append sb (apply str xs)) (.append sb "\n"))]
    (line "The read without javac (`read --no-javac`): files, read natively, fallbacks to javac, wall time, peak memory:")
    (line "")
    (line "| corpus | files | native | fallbacks | wall | peak |")
    (line "|---|---:|---:|---:|---:|---:|")
    (doseq [c cs :let [s (sums c)]]
      (line "| " c " | " (fmt (:files s)) " | " (fmt (:native s)) " (" (pct (:native s) (:files s)) ") | " (fmt (:fallbacks s))
            " | " (if (:wall-s s) (format "%.0f s" (:wall-s s)) "-") " | " (if (:peak-kb s) (format "%.1f GB" (/ (:peak-kb s) 1e6)) "-") " |"))
    (let [rows (for [c cs [r n] (:by-reason (sums c))] [r c n])
          by (reduce (fn [m [r c n]] (update-in m [r c] (fnil + 0) n)) {} rows)]
      (when (seq by)
        (line "")
        (line "The fallbacks by reason (the first thing met that only javac answers):")
        (line "")
        (line "| reason | " (str/join " | " cs) " |")
        (line "|---|" (str/join "" (repeat (count cs) "---:|")))
        (doseq [[r m] (sort-by (fn [[r m]] [(- (reduce + (vals m))) r]) by)]
          (line "| " (str/replace r "|" "\\|") " | " (str/join " | " (map #(fmt (get m % 0)) cs)) " |"))))
    (str sb)))

;;; ------------------------------------------------------------------------------------------

(defn -main [cmd & args]
  (case cmd
    "summary" (let [[out & dirs] args
                    sums (into (sorted-map) (for [d dirs] [(.getName (io/file d)) (summarize d)]))
                    md (markdown sums)]
                (io/make-parents (io/file out "split.edn"))
                (spit (io/file out "split.edn") (with-out-str (pp/pprint sums)))
                (spit (io/file out "split.md") md)
                (print md))
    "static" (pp/pprint (static-split converter-files))
    "nojavac" (let [[out & dirs] args
                    sums (into (sorted-map) (for [d dirs] [(.getName (io/file d)) (nojavac-summarize d (str d ".time"))]))
                    md (nojavac-markdown sums)]
                (io/make-parents (io/file out "nojavac.edn"))
                (spit (io/file out "nojavac.edn") (with-out-str (pp/pprint sums)))
                (spit (io/file out "nojavac.md") md)
                (print md)
                ;; JFS113 (c): an inference size limit that fired fails the check
                (doseq [[c s] sums [r n] (:by-reason s) :when (str/includes? r "beyond the port's limits")]
                  (println (str "nojavac: " c ": " r " " n " times (JFS113 (c)), beyond the known"))))
    "attr" (let [[out known & dirs] args
                 known (read-edn known)
                 sums (into (sorted-map) (for [d dirs] [(.getName (io/file d)) (attr-summarize d)]))
                 md (attr-markdown sums)]
             (io/make-parents (io/file out "attr.edn"))
             (spit (io/file out "attr.edn") (with-out-str (pp/pprint sums)))
             (spit (io/file out "attr.md") md)
             (print md)
             ;; the known bridges (JFS94 (b)): {:bridges #{read ...}}, a read bridged beyond them fails
             (doseq [[c s] sums
                     [k o] (:model s)
                     :let [n (get o :bridge 0)]
                     :when (and (pos? n) (not (contains? (:bridges known) k)))]
               (println (str "attr: " c ": the read " k " bridged " n " times, beyond the known bridges")))
             ;; the known differences: {:corpus {:facts {fact n}}}
             (doseq [[c s] sums
                     [f o] (:facts s)
                     :let [n (get o :differ 0)
                           k (get-in known [(keyword c) :facts f] 0)]
                     :when (pos? n)]
               (println (str "attr: " c ": " f " " n " different" (if (> n k) (str ", beyond the known " k) " (known)"))))
             ;; JFS113 (c): the inference's size limits stop a runaway; one that fired fails the check
             (doseq [[c s] sums [k rs] (:why s) [r n] rs :when (str/includes? r "beyond the port's limits")]
               (println (str "attr: " c ": " k " " r " " n " times (JFS113 (c)), beyond the known")))))
  (flush))

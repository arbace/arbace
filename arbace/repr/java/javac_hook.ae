(ns arbace.repr.java.javac-hook
  "The read closure's door to javac's half (doc/classes/JAVA-FRONTEND-SURVEY.md, JN10 part 1, JFS130 (a);
  \"As built: JN10 (write-ahead)\"). repr/java's read closure (the namespaces arbace.repr.java needs to
  read, which name no javac class: the shipped program embeds them, JFS136 (a)) reaches what only javac
  answers through here: a branch of the closure tests the native model first (a map, `nsym?`, `ntype?`) and
  otherwise calls `(call! :entry args...)`. javac's half (arbace.repr.java.javac-tree, javac-attr,
  javac-model, javac-read; loaded only on javac's tool executable) installs its functions with `install!` when it
  loads. Every entry not installed is `javac-needed!` (arbace.repr.java.decls's error, which a read
  without javac turns into a fallback and the shipped command into the error \"javac's tool needed:
  REASON\").

  The entries are keywords named after the closure's function whose javac branch they are (:tree/tag,
  :model/kind, :read/convert-units, ...); `entries` lists those installed. The entries :javac/NAME? are
  javac's predicates (`jsym?`, `jtype?`, ...: is a value one of javac's objects), which the closure
  tests where it tested `instance?` of a javac class, in the same order, so that on javac's tool every
  branch taken is the one it was; with nothing installed they are false.")

(def hooks "{entry fn}: javac's half's functions, installed when it loads." (atom {}))

(defn javac-needed!
  "Stop: `why` needs javac (arbace.repr.java.decls/javac-needed!'s ex-info, its key the same, so that
  decls/javac-needed-reason reads it; this namespace requires nothing, decls requires it)."
  [why]
  (throw (ex-info (str "repr/java: javac needed: " why) {:arbace.repr.java.decls/javac-needed why})))

(defn installed? "Is javac's half loaded (any entry installed)?" [] (boolean (seq @hooks)))

(defn hook "The installed function of `entry`, or nil." [entry] (get @hooks entry))

(defn call!
  "Entry `entry` applied to `args`: javac's function, or javac-needed! with the entry's name."
  [entry & args]
  (if-let [f (get @hooks entry)]
    (apply f args)
    (javac-needed! (str "javac's half: " (namespace entry) "/" (name entry)))))

(defmacro call-fixed!
  "call! for a fixed arity, without apply (the tree interface's hot accessors, JN10.9's risk 3): the
  installed function of `entry` called on args, or javac-needed!."
  [entry & args]
  `(if-let [f# (get @hooks ~entry)]
     (f# ~@args)
     (javac-needed! ~(str "javac's half: " (namespace entry) "/" (name entry)))))

(defn install!
  "Installs javac's half's functions, a map {entry fn}."
  [m]
  (swap! hooks merge m))

(defn entries "The installed entries, sorted." [] (vec (sort (keys @hooks))))

(defmacro ^:private defpred
  "(defpred name entry doc): a predicate over javac's half's entry `entry`, false when not installed."
  [n entry doc]
  `(defn ~n ~doc [x#] (if-let [f# (get @hooks ~entry)] (f# x#) false)))

(defpred jsym? :javac/symbol? "Is `x` one of javac's symbols (Symbol)?")
(defpred jmethod-sym? :javac/method-symbol? "Is `x` javac's method symbol (Symbol$MethodSymbol)?")
(defpred jclass-sym? :javac/class-symbol? "Is `x` javac's class symbol (Symbol$ClassSymbol)?")
(defpred jvar-sym? :javac/var-symbol? "Is `x` javac's variable symbol (Symbol$VarSymbol)?")
(defpred jtype? :javac/type? "Is `x` one of javac's types (Type)?")
(defpred jattribute? :javac/attribute? "Is `x` one of javac's annotation values (Attribute)?")

(defn javac-classes?
  "Are javac's classes in this program (javac's tool executable)? Asked by name, so that the closure names
  no javac class."
  []
  (try (Class/forName "com.sun.tools.javac.tree.JCTree") true (catch Throwable _ false)))

(defn try-load-javac-half!
  "Loads javac's half (arbace.repr.java.javac-read, which loads the rest) when javac's classes are there
  (javac's tool executable); true when it is loaded. On the shipped program (no javac) nothing is loaded
  or installed. Call it before any thread converts (a require is not for concurrent loads)."
  []
  (or (some? (get @hooks :read/convert-units))
      (when (javac-classes?)
        ;; javac is there: its half must load (an error is the tool's, not a fallback)
        (locking hooks (require 'arbace.repr.java.javac-read))
        (some? (get @hooks :read/convert-units)))
      false))

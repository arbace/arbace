;; Ported from rustc 1.99.1 (https://github.com/rust-lang/rust at 58cf8f9c3, the sources of Alpine's
;; rust-src-1.99.1-r0, pinned by tools/rsdump/apks.sha256): compiler/rustc_lexer/src/lib.rs (the raw
;; lexer), compiler/rustc_parse/src/lexer/mod.rs and lexer/tokentrees.rs (the cooking of tokens and the
;; token trees), compiler/rustc_ast/src/token.rs (Token::glue, Token::is_punct) and the checks of the
;; rustc_literal_escaper crate rustc calls; rustc is dual-licensed MIT OR Apache-2.0 (LICENSE.md,
;; "Rust (rustc 1.99.1)"). The non-ASCII character classes (XID_Start, XID_Continue, is_emoji_char) are
;; the tables of unicode-ident 1.0.24 and unicode-properties 0.1.4 that rustc_lexer links, generated into
;; unicode.ae (bin/rust-unicode, doc/rust/NATIVE-READER.md, "Unicode").

(ns arbace.repr.rust.lex
  "Rust's lexer in Arbace (doc/rust/NATIVE-READER.md): rustc 1.99.1's rustc_lexer and the token cooking
  and token trees of rustc_parse::lexer, ported function by function. Positions are code point
  indices into the text as rustc's source map holds it (a byte order mark removed, \\r\\n made \\n):
  rustc's spans count bytes, its columns characters, and every span the parser computes from a token's
  bytes moves over ASCII punctuation, so code points give rustc's lines and columns.

  (source raw) normalizes a file's text; (token-trees src edition strip) gives the cooked tokens of
  rustc_parse::lexer::lex_token_trees as one flat array (delimiters included, each token with its
  spacing; a delimiter's spacing is its DelimSpacing half) and the index of each delimiter's partner;
  (raw-tokens src edition comments-only expr) the helper's rsdump/tokens (or rsdump/comments)."
  (:require [arbace.string :as str]
            [arbace.repr.rust.unicode :as uc]))

(set! *warn-on-reflection* true)

;; ---------------------------------------------------------------------------------------------
;; The text

(deftype Src [^String text ^ints cps ^long n ^ints u16 ^ints lines ^long nlines])

(defn source
  "The text as rustc's source map holds it (SourceFile::new's normalize_src): a leading UTF-8 byte
  order mark removed, \\r\\n made \\n; its code points, their UTF-16 offsets and the lines' starts."
  ^Src [^String raw]
  (let [s (if (.startsWith raw "﻿") (subs raw 1) raw)
        s (if (>= (.indexOf s "\r\n") 0) (.replace s "\r\n" "\n") s)
        len (.length s)
        n (.codePointCount s 0 len)
        cps (int-array (inc n))
        u16 (int-array (inc n))
        ls (java.util.ArrayList.)]
    (.add ls (Long/valueOf 0))
    (loop [i 0 k 0]
      (when (< i len)
        (let [c (.codePointAt s i)]
          (aset cps k (int c))
          (aset u16 k (int i))
          (when (== c 10) (.add ls (Long/valueOf (inc k))))
          (recur (+ i (Character/charCount c)) (inc k)))))
    (aset u16 n (int len))
    (let [nl (.size ls) lines (int-array nl)]
      (dotimes [i nl] (aset lines i (int (long (.get ls i)))))
      (Src. s cps n u16 lines nl))))

(defn text-of
  "The text from code point a to b"
  ^String [^Src src ^long a ^long b]
  (.substring ^String (.-text src) (aget ^ints (.-u16 src) (int a)) (aget ^ints (.-u16 src) (int b))))

(defn line-of
  "The line (from 1) of a position"
  ^long [^Src src ^long pos]
  (let [^ints ls (.-lines src)]
    (loop [lo 0 hi (dec (.-nlines src))]
      (if (>= lo hi)
        (inc lo)
        (let [mid (long (quot (+ lo hi 1) 2))]
          (if (<= (aget ls (int mid)) pos) (recur mid hi) (recur lo (dec mid))))))))

(defn col-of
  "The column (characters from 1) of a position on its line"
  ^long [^Src src ^long pos ^long line]
  (inc (- pos (aget ^ints (.-lines src) (int (dec line))))))

(defn span-vec
  "A span as rsdump writes it: [l1 c1 l2 c2], nil for rustc's dummy span (0, 0)"
  [^Src src ^long lo ^long hi]
  (if (and (zero? lo) (zero? hi))
    nil
    (let [l1 (line-of src lo) l2 (if (== hi lo) l1 (line-of src hi))]
      [l1 (col-of src lo l1) l2 (col-of src hi l2)])))

;; ---------------------------------------------------------------------------------------------
;; Character classes (rustc_lexer)

(defn ws?
  "is_whitespace: Pattern_White_Space"
  [^long c]
  (or (== c 32) (== c 9) (== c 10) (== c 11) (== c 12) (== c 13) (== c 0x85) (== c 0x2028)
      (== c 0x2029) (== c 0x200E) (== c 0x200F)))

(defn- hws? [^long c] (or (== c 32) (== c 9)))

(defn id-start?
  "is_id_start: XID_Start or _ (unicode-ident 1.0.24's tables, arbace.repr.rust.unicode, generated by bin/rust-unicode)"
  [^long c]
  (if (< c 128)
    (or (and (>= c 97) (<= c 122)) (and (>= c 65) (<= c 90)) (== c 95))
    (uc/xid-start? c)))

(defn id-continue?
  "is_id_continue: XID_Continue (unicode-ident's tables)"
  [^long c]
  (if (< c 128)
    (or (and (>= c 97) (<= c 122)) (and (>= c 65) (<= c 90)) (and (>= c 48) (<= c 57)) (== c 95))
    (uc/xid-continue? c)))

(defn- emoji?
  "is_emoji_char for a non-ASCII character (unicode-properties 0.1.4's EMOJI_STATUS, arbace.repr.rust.unicode)"
  [^long c]
  (uc/emoji-char? c))

(defn- digit? [^long c] (and (>= c 48) (<= c 57)))
(defn- hex? [^long c] (or (digit? c) (and (>= c 97) (<= c 102)) (and (>= c 65) (<= c 70))))

;; ---------------------------------------------------------------------------------------------
;; The raw lexer (rustc_lexer::Cursor): each function takes the position after what it has eaten and
;; returns the position after what it eats

(defmacro ^:private at [cps n p] `(let [p# ~p] (if (< p# ~n) (long (aget ~cps (int p#))) 0)))

(defn- eat-while-idc ^long [^ints cps ^long n ^long p]
  (loop [p p] (if (and (< p n) (id-continue? (aget cps (int p)))) (recur (inc p)) p)))

(defn- eat-identifier ^long [^ints cps ^long n ^long p]
  (if (and (< p n) (id-start? (aget cps (int p)))) (eat-while-idc cps n (inc p)) p))

(defn- eat-until-nl ^long [^ints cps ^long n ^long p]
  (loop [p p] (if (and (< p n) (not= 10 (aget cps (int p)))) (recur (inc p)) p)))

(defn- find-str
  "The position of the code points of s in cps from p, or -1"
  ^long [^ints cps ^long n ^long p ^String s]
  (let [k (.length s)]
    (loop [i p]
      (cond (> (+ i k) n) -1
            (loop [j 0] (cond (== j k) true
                              (== (aget cps (int (+ i j))) (int (.charAt s j))) (recur (inc j))
                              :else false)) i
            :else (recur (inc i))))))

(defn- starts-with? [^ints cps ^long n ^long p ^String s]
  (let [k (.length s)]
    (and (<= (+ p k) n)
         (loop [j 0] (cond (== j k) true
                           (== (aget cps (int (+ p j))) (int (.charAt s j))) (recur (inc j))
                           :else false)))))

(defn- frontmatter
  "Given one - eaten (p after it), the rest of a front matter: [p invalid-infostring]"
  [^ints cps ^long n ^long p0 ^long start]
  (let [p (loop [p p0] (if (and (< p n) (== 45 (aget cps (int p)))) (recur (inc p)) p))
        len-opening (inc (- p p0))
        p (loop [p p] (if (and (< p n) (not= 10 (aget cps (int p))) (hws? (aget cps (int p)))) (recur (inc p)) p))
        p (if (and (< p n) (id-start? (aget cps (int p))))
            (loop [p (inc p)] (if (and (< p n) (let [c (aget cps (int p))] (or (id-continue? c) (== c 45) (== c 46)))) (recur (inc p)) p))
            p)
        p (loop [p p] (if (and (< p n) (not= 10 (aget cps (int p))) (hws? (aget cps (int p)))) (recur (inc p)) p))
        invalid-infostring (not= 10 (at cps n p))
        fence (str "\n" (apply str (repeat len-opening "-")))
        closing (find-str cps n p fence)]
    (if (>= closing 0)
      [(eat-until-nl cps n (+ closing (.length fence))) invalid-infostring]
      (let [pc (let [x (find-str cps n p "\n---")]
                 (cond (>= x 0) (inc x)
                       (>= (find-str cps n p "\nuse ") 0) (find-str cps n p "\nuse ")
                       (>= (find-str cps n p "\n//!") 0) (find-str cps n p "\n//!")
                       (>= (find-str cps n p "\n#![") 0) (find-str cps n p "\n#![")
                       :else
                       (loop [q p]
                         (let [c (find-str cps n q "---")]
                           (if (< c 0)
                             -1
                             (let [ls (loop [k (dec c)] (cond (< k q) q (== 10 (aget cps (int k))) (inc k) :else (recur (dec k))))]
                               (if (loop [k ls] (cond (>= k c) true (hws? (aget cps (int k))) (recur (inc k)) :else false))
                                 c
                                 (recur (+ c 3)))))))))]
        (if (>= pc 0)
          [(eat-until-nl cps n pc) invalid-infostring]
          [n invalid-infostring])))))

(defn- block-comment
  "Given /* eaten: [p doc-style terminated]"
  [^ints cps ^long n ^long p]
  (let [c1 (at cps n p) c2 (at cps n (inc p))
        doc (cond (== c1 33) :inner
                  (and (== c1 42) (not (or (== c2 42) (== c2 47)))) :outer
                  :else nil)]
    (loop [p p depth 1]
      (if (>= p n)
        [p doc false]
        (let [c (aget cps (int p))]
          (cond (and (== c 47) (== 42 (at cps n (inc p)))) (recur (+ p 2) (inc depth))
                (and (== c 42) (== 47 (at cps n (inc p))))
                (if (== depth 1) [(+ p 2) doc true] (recur (+ p 2) (dec depth)))
                :else (recur (inc p) depth)))))))

(defn- eat-decimal-digits
  "[p has-digits]"
  [^ints cps ^long n ^long p]
  (loop [p p has false]
    (let [c (at cps n p)]
      (cond (== c 95) (recur (inc p) has)
            (digit? c) (recur (inc p) true)
            :else [p has]))))

(defn- eat-hex-digits [^ints cps ^long n ^long p]
  (loop [p p has false]
    (let [c (at cps n p)]
      (cond (== c 95) (recur (inc p) has)
            (hex? c) (recur (inc p) true)
            :else [p has]))))

(defn- eat-float-exponent
  "Given e eaten: [p has-digits]"
  [^ints cps ^long n ^long p]
  (let [c (at cps n p)
        p (if (or (== c 45) (== c 43)) (inc p) p)]
    (eat-decimal-digits cps n p)))

(defn- number
  "Given the first digit eaten: [p kind base empty] kind :int or :float, empty: empty_int or
  empty_exponent"
  [^ints cps ^long n ^long p ^long d0]
  (let [[p base early]
        (if (== d0 48)
          (let [c (at cps n p)]
            (cond (== c 98) (let [[p h] (eat-decimal-digits cps n (inc p))] [p 2 (when-not h [p :int 2 true])])
                  (== c 111) (let [[p h] (eat-decimal-digits cps n (inc p))] [p 8 (when-not h [p :int 8 true])])
                  (== c 120) (let [[p h] (eat-hex-digits cps n (inc p))] [p 16 (when-not h [p :int 16 true])])
                  (or (digit? c) (== c 95)) [(first (eat-decimal-digits cps n p)) 10 nil]
                  (or (== c 46) (== c 101) (== c 69)) [p 10 nil]
                  :else [p 10 [p :int 10 false]]))
          [(first (eat-decimal-digits cps n p)) 10 nil])]
    (or early
        (let [c (at cps n p) c2 (at cps n (inc p))]
          (cond (and (== c 46) (not= c2 46) (not (id-start? c2)))
                (let [p (inc p)]
                  (if (digit? (at cps n p))
                    (let [[p _] (eat-decimal-digits cps n p)
                          c (at cps n p)]
                      (if (or (== c 101) (== c 69))
                        (let [[p h] (eat-float-exponent cps n (inc p))] [p :float base (not h)])
                        [p :float base false]))
                    [p :float base false]))
                (or (== c 101) (== c 69))
                (let [[p h] (eat-float-exponent cps n (inc p))] [p :float base (not h)])
                :else [p :int base false])))))

(defn- single-quoted-string
  "Given ' eaten: [p terminated]"
  [^ints cps ^long n ^long p]
  (if (and (== 39 (at cps n (inc p))) (not= 92 (at cps n p)))
    [(+ p 2) true]
    (loop [p p]
      (let [c (at cps n p)]
        (cond (and (== c 39) (< p n)) [(inc p) true]
              (== c 47) [p false]
              (and (== c 10) (not= 39 (at cps n (inc p)))) [p false]
              (>= p n) [p false]
              (== c 92) (recur (+ p 2))
              :else (recur (inc p)))))))

(defn- double-quoted-string
  "Given \" eaten: [p terminated]"
  [^ints cps ^long n ^long p]
  (loop [p p]
    (if (>= p n)
      [p false]
      (let [c (aget cps (int p))]
        (cond (== c 34) [(inc p) true]
              (and (== c 92) (let [d (at cps n (inc p))] (or (== d 92) (== d 34)))) (recur (+ p 2))
              :else (recur (inc p)))))))

(defn- raw-double-quoted-string
  "Given the prefix eaten (p at the first # or \"): [p n-hashes-or-nil]"
  [^ints cps ^long n ^long p]
  (let [p1 (loop [q p] (if (== 35 (at cps n q)) (recur (inc q)) q))
        nh (- p1 p)]
    (if (not= 34 (at cps n p1))
      [(if (< p1 n) (inc p1) p1) nil]
      (loop [q (inc p1)]
        (let [q (loop [q q] (if (and (< q n) (not= 34 (aget cps (int q)))) (recur (inc q)) q))]
          (if (>= q n)
            [q nil]
            (let [q (inc q)
                  e (loop [k 0] (if (and (< k nh) (== 35 (at cps n (+ q k)))) (recur (inc k)) k))]
              (if (== e nh)
                [(+ q e) (if (> nh 255) nil nh)]
                (recur (+ q e))))))))))

(defn- ident-or-unknown-prefix
  "Given an identifier's start eaten: [p kind]"
  [^ints cps ^long n ^long p]
  (let [p (eat-while-idc cps n p)
        c (at cps n p)]
    (cond (or (== c 35) (== c 34) (== c 39)) [p :unknown-prefix]
          (emoji? c) [(loop [q p] (if (and (< q n) (let [c (aget cps (int q))] (or (id-continue? c) (emoji? c) (== c 0x200D)))) (recur (inc q)) q))
                      :invalid-ident]
          :else [p :ident])))

(defn- literal-with-suffix [^ints cps ^long n ^long p kind detail terminated]
  (let [suffix-start p
        p (if terminated (eat-identifier cps n p) p)]
    [p :literal kind suffix-start detail]))

(defn- c-or-byte-string
  "Given b or c eaten (byte: single quotes allowed)"
  [^ints cps ^long n ^long p byte]
  (let [c1 (at cps n p) c2 (at cps n (inc p))]
    (cond (and byte (== c1 39))
          (let [[p t] (single-quoted-string cps n (inc p))] (literal-with-suffix cps n p :byte t t))
          (== c1 34)
          (let [[p t] (double-quoted-string cps n (inc p))] (literal-with-suffix cps n p (if byte :byte-str :c-str) t t))
          (and (== c1 114) (or (== c2 34) (== c2 35)))
          (let [[p h] (raw-double-quoted-string cps n (inc p))]
            (literal-with-suffix cps n p (if byte :raw-byte-str :raw-c-str) h (some? h)))
          :else (let [[p k] (ident-or-unknown-prefix cps n p)] [p k]))))

(defn- lifetime-or-char
  "Given ' eaten"
  [^ints cps ^long n ^long p]
  (let [c1 (at cps n p) c2 (at cps n (inc p))
        can-be-lt (if (== c2 39) false (or (id-start? c1) (digit? c1)))]
    (cond
      (not can-be-lt)
      (let [[p t] (single-quoted-string cps n p)] (literal-with-suffix cps n p :char t t))
      (and (== c1 114) (== c2 35) (id-start? (at cps n (+ p 2))))
      [(eat-while-idc cps n (+ p 3)) :raw-lifetime]
      :else
      (let [swn (digit? c1)
            p (eat-while-idc cps n (inc p))
            c (at cps n p)]
        (cond (== c 39) [(inc p) :literal :char (inc p) true]
              (and (== c 35) (not swn)) [p :unknown-prefix-lifetime]
              :else [p :lifetime swn])))))

(def ^:private punct1
  {59 :Semi 44 :Comma 46 :Dot 40 :OpenParen 41 :CloseParen 123 :OpenBrace 125 :CloseBrace
   91 :OpenBracket 93 :CloseBracket 64 :At 35 :Pound 126 :Tilde 63 :Question 58 :Colon 36 :Dollar
   61 :Eq 33 :Bang 60 :Lt 62 :Gt 45 :Minus 38 :And 124 :Or 43 :Plus 42 :Star 94 :Caret 37 :Percent})

(defn advance-token
  "Cursor::advance_token: the raw token at p, as [end kind a b c]: :line-comment a doc style;
  :block-comment a doc style, b terminated; :frontmatter a invalid preceding white space, b invalid
  infostring; :literal a kind (:int :float :char :byte :str :byte-str :c-str :raw-str :raw-byte-str
  :raw-c-str), b the suffix's start, c its detail (terminated, the hashes, or [base empty]);
  :lifetime a starts with a number; punctuation by rustc_lexer's names (:Semi ...); :eof at the end"
  [^ints cps ^long n ^long p0 fm]
  (if (>= p0 n)
    [p0 :eof]
    (let [c (aget cps (int p0))
          p (inc p0)]
      (cond
        (and fm (ws? c))
        (let [[p last] (loop [p p last c] (if (and (< p n) (ws? (aget cps (int p)))) (recur (inc p) (aget cps (int p))) [p last]))]
          (if (and (not= last 10) (starts-with? cps n p "---"))
            (let [[q inv] (frontmatter cps n (inc p) p0)] [q :frontmatter true inv])
            [p :whitespace]))
        (and fm (== c 45) (starts-with? cps n p "--"))
        (let [[q inv] (frontmatter cps n p p0)] [q :frontmatter false inv])
        (== c 47)
        (let [d (at cps n p)]
          (cond (== d 47)
                (let [p (inc p) e (at cps n p)
                      doc (cond (== e 33) :inner
                                (and (== e 47) (not= 47 (at cps n (inc p)))) :outer
                                :else nil)]
                  [(eat-until-nl cps n p) :line-comment doc])
                (== d 42) (let [[q doc t] (block-comment cps n (inc p))] [q :block-comment doc t])
                :else [p :Slash]))
        (ws? c) [(loop [p p] (if (and (< p n) (ws? (aget cps (int p)))) (recur (inc p)) p)) :whitespace]
        (== c 114)
        (let [d (at cps n p) e (at cps n (inc p))]
          (cond (and (== d 35) (id-start? e)) [(eat-identifier cps n (inc p)) :raw-ident]
                (or (== d 35) (== d 34))
                (let [[q h] (raw-double-quoted-string cps n p)] (literal-with-suffix cps n q :raw-str h (some? h)))
                :else (ident-or-unknown-prefix cps n p)))
        (== c 98) (c-or-byte-string cps n p true)
        (== c 99) (c-or-byte-string cps n p false)
        (id-start? c) (ident-or-unknown-prefix cps n p)
        (digit? c) (let [[q k base empty] (number cps n p c)] (literal-with-suffix cps n q k [base empty] true))
        (and (== c 35) (let [d (at cps n p)] (or (== d 34) (== d 35)))) [(inc p) :guarded-str-prefix]
        (== c 39) (lifetime-or-char cps n p)
        (== c 34) (let [[q t] (double-quoted-string cps n p)] (literal-with-suffix cps n q :str t t))
        (emoji? c) [(loop [q p] (if (and (< q n) (let [c (aget cps (int q))] (or (id-continue? c) (emoji? c) (== c 0x200D)))) (recur (inc q)) q))
                    :invalid-ident]
        :else (if-let [k (punct1 c)] [p k] [p :unknown])))))

(defn strip-shebang
  "rustc_lexer::strip_shebang: the length of a first #! line that is no inner attribute, or nil"
  [^ints cps ^long n]
  (when (and (> n 1) (== 35 (aget cps 0)) (== 33 (aget cps 1)))
    (let [nxt (loop [p 2]
                (let [r (advance-token cps n p false) k (nth r 1)]
                  (cond (= k :eof) nil
                        (or (= k :whitespace)
                            (and (contains? #{:line-comment :block-comment} k) (nil? (nth r 2))))
                        (recur (long (nth r 0)))
                        :else k)))]
      (when-not (= nxt :OpenBracket)
        (eat-until-nl cps n 2)))))

;; ---------------------------------------------------------------------------------------------
;; Escapes (rustc_literal_escaper): the checks rustc_parse's lexer makes, and the unescaping of
;; ast::LitKind::from_token_lit

(defn- unescape-error
  "An escape error: rustc's message for it and its span, code points [from, to) of the content"
  ([msg] (throw (ex-info msg {:rust-lex true})))
  ([msg from to] (throw (ex-info msg {:rust-lex true :from from :to to}))))

(defn- esc-char
  "escaped_char of a code point (printable ASCII as is, else Rust's escape_default)"
  ^String [^long c]
  (cond (and (>= c 0x20) (<= c 0x7e)) (String. (int-array [c]) 0 1)
        (== c 9) "\\t" (== c 13) "\\r" (== c 10) "\\n"
        :else (str "\\u{" (Long/toHexString c) "}")))

(defn unescape
  "The units of a literal's content in a mode (:char :byte :str :byte-str :c-str): a vector of code
  points (and for C strings, bytes above 0x7f as [:b n]); an invalid content throws rustc's error
  (rustc-literal-escaper's EscapeError, as rustc_parse's emit_unescape_error words it, with its
  span: code points of the content)"
  [^String s mode]
  (let [cps (.toArray (.codePoints s))
        len (alength cps)
        at (fn [^long i] (if (< i len) (aget cps (int i)) -1))
        units (java.util.ArrayList.)
        unicode? (contains? #{:char :str :c-str} mode)
        bytes? (contains? #{:byte :byte-str} mode)
        char? (contains? #{:char :byte} mode)
        last-char (fn [msg ^long from ^long to] (unescape-error msg (dec to) to))
        nul (fn [^long from ^long to] (unescape-error "null characters in C string literals are not supported" from to))
        ;; scan_escape: the escape at i (the backslash), [unit next]
        escape
        (fn [^long i]
          (let [e (at (inc i))]
            (case (long e)
              -1 (unescape-error "invalid trailing slash in literal" i (inc i))
              110 [10 (+ i 2)] 114 [13 (+ i 2)] 116 [9 (+ i 2)] 92 [92 (+ i 2)] 39 [39 (+ i 2)] 34 [34 (+ i 2)]
              48 (do (when (= mode :c-str) (nul i (+ i 2))) [0 (+ i 2)])
              120 (let [h (at (+ i 2)) l (at (+ i 3))]
                    (when (neg? h) (unescape-error "numeric character escape is too short" i (+ i 2)))
                    (when (neg? (Character/digit (int h) 16))
                      (last-char (str "invalid character in numeric character escape: `" (esc-char h) "`") i (+ i 3)))
                    (when (neg? l) (unescape-error "numeric character escape is too short" i (+ i 3)))
                    (when (neg? (Character/digit (int l) 16))
                      (last-char (str "invalid character in numeric character escape: `" (esc-char l) "`") i (+ i 4)))
                    (let [v (+ (* 16 (Character/digit (int h) 16)) (Character/digit (int l) 16))]
                      (when (and (> v 0x7f) (contains? #{:char :str} mode)) (unescape-error "out of range hex escape" i (+ i 4)))
                      (when (and (zero? v) (= mode :c-str)) (nul i (+ i 4)))
                      [(if (and (= mode :c-str) (> v 0x7f)) [:b v] v) (+ i 4)]))
              117 (let [j (+ i 2)]
                    (when-not (== 123 (at j)) (unescape-error "incorrect unicode escape sequence" i j))
                    (let [c0 (at (inc j))]
                      (cond (neg? c0) (unescape-error "unterminated unicode escape" i (inc j))
                            (== c0 95) (last-char "invalid start of unicode escape: `_`" i (+ j 2))
                            (== c0 125) (unescape-error "empty unicode escape" i (+ j 2))
                            (neg? (Character/digit (int c0) 16))
                            (last-char (str "invalid character in unicode escape: `" (esc-char c0) "`") i (+ j 2)))
                      (loop [k (+ j 2) nd 1 v (long (Character/digit (int c0) 16))]
                        (let [c (at k)]
                          (cond (neg? c) (unescape-error "unterminated unicode escape" i k)
                                (== c 95) (recur (inc k) nd v)
                                (== c 125)
                                (do (when (> nd 6) (unescape-error "overlong unicode escape" i (inc k)))
                                    (when-not unicode? (unescape-error "unicode escape in byte string" i (inc k)))
                                    (when (or (> v 0x10FFFF) (and (>= v 0xD800) (<= v 0xDFFF)))
                                      (unescape-error "invalid unicode character escape" i (inc k)))
                                    (when (and (zero? v) (= mode :c-str)) (nul i (inc k)))
                                    [v (inc k)])
                                (neg? (Character/digit (int c) 16))
                                (last-char (str "invalid character in unicode escape: `" (esc-char c) "`") i (inc k))
                                :else (let [nd (inc nd)]
                                        (recur (inc k) nd (if (> nd 6) v (+ (* 16 v) (Character/digit (int c) 16))))))))))
              (last-char (str (if bytes? "unknown byte escape" "unknown character escape") ": `" (esc-char e) "`")
                         i (+ i 2)))))
        plain-check
        (fn [^long i ^long c]
          (when (and bytes? (> c 127))
            (last-char (str "non-ASCII character in " (if (= mode :byte) "byte literal" "byte string literal")) i (inc i)))
          (when (and (zero? c) (= mode :c-str)) (nul i (inc i))))]
    (if char?
      (let [c (at 0)]
        (when (neg? c) (unescape-error "empty character literal" 0 0))
        (let [[u nxt] (cond (== c 92) (escape 0)
                            (or (== c 39) (== c 10) (== c 9))
                            (unescape-error (str (if (= mode :byte) "byte" "character") " constant must be escaped: `" (esc-char c) "`") 0 1)
                            (== c 13) (unescape-error "character constant must be escaped: `\\r`" 0 1)
                            :else (do (plain-check 0 c) [c 1]))]
          (when (< (long nxt) len) (unescape-error "character literal may only contain one codepoint"))
          [u]))
      (loop [i 0]
        (if (>= i len)
          (vec units)
          (let [c (aget cps (int i))]
            (cond (== c 92)
                  (if (== 10 (at (inc i)))
                    (recur (loop [k (+ i 2)] (let [d (at k)] (if (or (== d 32) (== d 9) (== d 10) (== d 13)) (recur (inc k)) k))))
                    (let [[u nxt] (escape i)] (.add units u) (recur (long nxt))))
                  (== c 13) (unescape-error "bare CR not allowed in string, use `\\r` instead" i (inc i))
                  :else (do (plain-check i c) (.add units c) (recur (inc i))))))))))

(defn- check-raw
  "The checks of a raw literal's content: no bare CR; ASCII only in raw byte strings; no NUL in raw C
  strings"
  [^String s mode]
  (when (>= (.indexOf s "\r") 0) (unescape-error "bare CR not allowed in raw string"))
  (when (and (= mode :raw-byte-str) (some #(> (long %) 127) (map long s))) (unescape-error "non-ASCII character in raw byte string literal"))
  (when (and (= mode :raw-c-str) (>= (.indexOf s "\u0000") 0)) (unescape-error "null characters in C string literals are not supported")))

;; ---------------------------------------------------------------------------------------------
;; Cooked tokens (rustc_ast::token::Token): kind is rustc's TokenKind's name (:Ident, :Lifetime,
;; :Literal, :DocComment, :Eof, the punctuation and delimiters: :Eq :Lt :Le :EqEq ... :OpenParen
;; :CloseBrace); sym an identifier's, lifetime's, literal's symbol or a doc comment's text; x the raw
;; flag of an identifier or lifetime, a literal's kind (:Integer :Float :Str :StrRaw :ByteStr
;; :ByteStrRaw :CStr :CStrRaw :Char :Byte :Err), a doc comment's kind (:Line :Block); y a literal's
;; suffix, a doc comment's style (:Outer :Inner); z a raw literal's hashes; sp the spacing (:Alone
;; :Joint :JointHidden; a delimiter's half of its DelimSpacing)

(deftype Tok [kind ^long lo ^long hi sym x y ^long z sp])

(defn tok [kind lo hi sym x y z sp] (Tok. kind lo hi sym x y z sp))

(defn- with-sp ^Tok [^Tok t sp] (Tok. (.-kind t) (.-lo t) (.-hi t) (.-sym t) (.-x t) (.-y t) (.-z t) sp))

(def punct-kinds
  "Token::is_punct's kinds"
  #{:Eq :Lt :Le :EqEq :Ne :Ge :Gt :AndAnd :OrOr :Bang :Tilde :Plus :Minus :Star :Slash :Percent :Caret
    :And :Or :Shl :Shr :PlusEq :MinusEq :StarEq :SlashEq :PercentEq :CaretEq :AndEq :OrEq :ShlEq :ShrEq
    :At :Dot :DotDot :DotDotDot :DotDotEq :Comma :Semi :Colon :PathSep :RArrow :LArrow :FatArrow
    :Pound :Dollar :Question :SingleQuote})

(def ^:private glue-table
  "Token::glue: [a b] to the glued kind"
  {[:Eq :Eq] :EqEq [:Eq :Gt] :FatArrow
   [:Lt :Eq] :Le [:Lt :Lt] :Shl [:Lt :Le] :ShlEq [:Lt :Minus] :LArrow
   [:Gt :Eq] :Ge [:Gt :Gt] :Shr [:Gt :Ge] :ShrEq
   [:Bang :Eq] :Ne
   [:Plus :Eq] :PlusEq
   [:Minus :Eq] :MinusEq [:Minus :Gt] :RArrow
   [:Star :Eq] :StarEq
   [:Slash :Eq] :SlashEq
   [:Percent :Eq] :PercentEq
   [:Caret :Eq] :CaretEq
   [:And :Eq] :AndEq [:And :And] :AndAnd
   [:Or :Eq] :OrEq [:Or :Or] :OrOr
   [:Shl :Eq] :ShlEq
   [:Shr :Eq] :ShrEq
   [:Dot :Dot] :DotDot [:Dot :DotDot] :DotDotDot
   [:DotDot :Dot] :DotDotDot [:DotDot :Eq] :DotDotEq
   [:Colon :Colon] :PathSep})

(def open-delims {:OpenParen :Parenthesis :OpenBrace :Brace :OpenBracket :Bracket})
(def close-delims {:CloseParen :Parenthesis :CloseBrace :Brace :CloseBracket :Bracket})

;; ---------------------------------------------------------------------------------------------
;; The cooking (rustc_parse::lexer::Lexer::next_token_from_cursor)

(defn- lex-error
  "A lexer's error (rustc's emitted or fatal diagnostic): throws ex-info with :rust-lex and :diag
  {:msg :lo :hi :code}, the span in code points"
  ([msg] (lex-error msg 0 0 nil))
  ([msg lo hi] (lex-error msg lo hi nil))
  ([msg lo hi code] (throw (ex-info msg {:rust-lex true :diag {:msg msg :lo (long lo) :hi (long hi) :code code}}))))

(def ^:dynamic ^java.util.ArrayList *late*
  "The lexer's stashed errors (\"lifetimes cannot start with a number\", StashKey::LifetimeIsChar):
  rustc emits them after every other error of the parse"
  nil)

(defn- nfc
  "nfc_normalize"
  ^String [^String s]
  (if (every? #(< (long %) 128) (map long s))
    s
    (java.text.Normalizer/normalize s java.text.Normalizer$Form/NFC)))

(def ^:private confusable-emoji
  "the characters of unicode_chars.rs's UNICODE_ARRAY (rustc_parse::lexer) that are emoji (is_emoji_char): ➕ and ➖"
  #{0x2795 0x2796})

(def ^:private reserved-always
  #{"$crate" "{{root}}" "_" "as" "break" "const" "continue" "crate" "else" "enum" "extern" "false" "fn"
    "for" "if" "impl" "in" "let" "loop" "match" "mod" "move" "mut" "pub" "ref" "return" "self" "Self"
    "static" "struct" "super" "trait" "true" "type" "unsafe" "use" "where" "while" "abstract" "become"
    "box" "do" "final" "macro" "override" "priv" "typeof" "unsized" "virtual" "yield"})

(defn reserved?
  "Symbol::is_reserved in an edition"
  [^String s ^long ed]
  (or (contains? reserved-always s)
      (and (>= ed 2018) (contains? #{"async" "await" "dyn" "try"} s))
      (and (>= ed 2024) (= s "gen"))))

(defn path-segment-keyword? [^String s] (contains? #{"super" "self" "Self" "crate" "{{root}}" "$crate"} s))

(defn can-be-raw? [^String s] (and (not= s "") (not= s "_") (not (path-segment-keyword? s))))

(defn- escaped-char
  "escaped_char: printable ASCII as is, else Rust's char::escape_default"
  ^String [^long c]
  (cond (and (>= c 0x20) (<= c 0x7e)) (String. (int-array [c]) 0 1)
        (== c 9) "\\t" (== c 13) "\\r" (== c 10) "\\n"
        :else (str "\\u{" (Long/toHexString c) "}")))

(defn- raw-str-error
  "report_raw_str_error after rustc_lexer's validate_raw_str: the raw string at start (prefix pre: r
  1, br and cr 2) is invalid; end the token's end"
  [^Src src ^long start ^long end ^long pre]
  (let [^ints cps (.-cps src) n (.-n src)
        p0 (+ start pre)
        p1 (loop [q p0] (if (== 35 (at cps n q)) (recur (inc q)) q))
        nh (- p1 p0)]
    (if (not= 34 (at cps n p1))
      (lex-error (str "found invalid character; only `#` is allowed in raw string delimitation: "
                      (escaped-char (at cps n p1)))
                 start end)
      (loop [q (inc p1)]
        (let [q (loop [q q] (if (and (< q n) (not= 34 (aget cps (int q)))) (recur (inc q)) q))]
          (if (>= q n)
            (lex-error "unterminated raw string" start start "E0748")
            (let [q (inc q)
                  e (loop [k 0] (if (and (< k nh) (== 35 (at cps n (+ q k)))) (recur (inc k)) k))]
              (if (== e nh)
                (lex-error (str "too many `#` symbols: raw strings may be delimited by up to 255 `#` symbols, but found " nh)
                           start end)
                (recur (+ q e))))))))))

(defn- escapes
  "The escape checks of a quoted literal's content (rustc_lexer's check_for_errors): an error throws
  the lexer's diagnostic over the literal's span (start, end), rustc's span_with_quotes"
  [^Src src mode ^long a ^long b ^long start ^long end]
  (try (if (contains? #{:raw-str :raw-byte-str :raw-c-str} mode)
         (check-raw (text-of src a b) mode)
         (unescape (text-of src a b) mode))
       (catch arbace.lang.ExceptionInfo e
         (if (and (:rust-lex (ex-data e)) (not (:diag (ex-data e))))
           (let [{:keys [from to]} (ex-data e)]
             (if from
               (lex-error (.getMessage e) (+ a (long from)) (+ a (long to)))
               (lex-error (.getMessage e) start end)))
           (throw e)))))

(def ^:private confusables
  "The characters of rustc_parse's lexer/unicode_chars.rs UNICODE_ARRAY (Unicode confusables of ASCII)"
  #{0x60 0xA0 0xB4 0xB7 0xB8 0x1C3 0x241 0x294 0x2B9 0x2BA 0x2BB 0x2BC 0x2BD 0x2BE 0x2C2 0x2C3 0x2C8
    0x2CA 0x2CB 0x2D0 0x2D7 0x2DD 0x2EE 0x2F4 0x2F5 0x2F6 0x2F8 0x374 0x37E 0x384 0x387 0x55A 0x55D
    0x589 0x5C3 0x5D9 0x5F2 0x5F3 0x5F4 0x60D 0x660 0x66B 0x66D 0x6D4 0x6F0 0x701 0x702 0x703 0x704
    0x7F4 0x7F5 0x7FA 0x903 0x97D 0xA83 0x1173 0x13AE 0x1400 0x1427 0x1433 0x1438 0x144A 0x1680
    0x16B2 0x16CC 0x16EB 0x16EC 0x16ED 0x1735 0x1803 0x1809 0x1CD3 0x1FBD 0x1FBF 0x1FEF 0x1FFD
    0x1FFE 0x2000 0x2001 0x2002 0x2003 0x2004 0x2005 0x2006 0x2007 0x2008 0x2009 0x200A 0x2010
    0x2011 0x2012 0x2013 0x2014 0x2015 0x2018 0x2019 0x201A 0x201B 0x201C 0x201D 0x201F 0x2022
    0x2024 0x2027 0x2028 0x2029 0x202F 0x2032 0x2033 0x2035 0x2036 0x2039 0x203A 0x2041 0x2043
    0x2044 0x204E 0x205A 0x205F 0x2212 0x2215 0x2216 0x2217 0x2219 0x2236 0x22C5 0x2329 0x232A
    0x2500 0x2501 0x2571 0x275D 0x275E 0x2768 0x2769 0x276C 0x276D 0x276E 0x276F 0x2772 0x2773
    0x2774 0x2775 0x2795 0x2796 0x27CB 0x27CD 0x27E8 0x27E9 0x29F5 0x29F8 0x29F9 0x2A75 0x2CBA
    0x2CC6 0x2D51 0x2E31 0x2E40 0x2F00 0x2F02 0x2F03 0x3000 0x3001 0x3002 0x3003 0x3008 0x3009
    0x300A 0x300B 0x300C 0x300D 0x300E 0x300F 0x3010 0x3011 0x3014 0x3015 0x3016 0x3017 0x3018
    0x3019 0x301A 0x301B 0x3033 0x304F 0x30A0 0x30CE 0x30FB 0x30FC 0x30FD 0x3161 0x31D0 0x31D3
    0x31D4 0x31DB 0x4E00 0x4E36 0x4E3F 0xA4F8 0xA4F9 0xA4FD 0xA4FF 0xA60E 0xA6EB 0xA778 0xA789
    0xA78C 0xA78F 0xA7F7 0xFB29 0xFD3E 0xFD3F 0xFE12 0xFE13 0xFE14 0xFE15 0xFE16 0xFE30 0xFE4D
    0xFE4E 0xFE4F 0xFE58 0xFE68 0xFF01 0xFF02 0xFF06 0xFF07 0xFF08 0xFF09 0xFF0A 0xFF0B 0xFF0C
    0xFF0D 0xFF0E 0xFF0F 0xFF1A 0xFF1B 0xFF1C 0xFF1D 0xFF1E 0xFF1F 0xFF3B 0xFF3C 0xFF3D 0xFF3F
    0xFF40 0xFF5B 0xFF5D 0xFF65 0x10101 0x1029B 0x1031F 0x10A50 0x16F3F 0x16F51 0x16F52 0x1D114
    0x1D16D 0x1D236 0x1D237 0x1D23A 0x21FE8})

(defn- unicode-confusable? [^long c] (contains? confusables c))

(defn- unknown-token
  "The error of an unknown token's start (UnknownTokenStart): the character escaped, the span over
  its repeats"
  [^Src src ^long start]
  (let [^ints cps (.-cps src) n (.-n src) c (aget cps (int start))
        e (loop [q (inc start)] (if (and (< q n) (== c (aget cps (int q)))) (recur (inc q)) q))]
    (lex-error (str "unknown start of token: " (escaped-char c)) start e)))

(defn- guarded-str-error
  "maybe_report_guarded_str in 2024: #\"...\"# (an unterminated one fatal) or ##"
  [^Src src ^long start]
  (let [^ints cps (.-cps src) n (.-n src)
        p1 (loop [q start] (if (== 35 (at cps n q)) (recur (inc q)) q))
        nh (- p1 start)]
    (if (not= 34 (at cps n p1))
      (lex-error "reserved multi-hash token is forbidden" start (+ start 2))
      (let [[q t] (double-quoted-string cps n (inc p1))]
        (if-not t
          (lex-error "unterminated double quote string" (+ start nh) q "E0765")
          (let [q (loop [q (long q) k 0] (if (and (< k nh) (== 35 (at cps n q))) (recur (inc q) (inc k)) q))
                q (eat-identifier cps n q)]
            (lex-error "invalid string literal" start q)))))))

(defn- check-literal
  "cook_lexer_literal's checks and kind: [kind symbol-start symbol-end z] (the symbol's range, z the
  hashes); an invalid literal throws (rustc's diagnostic and span: ss the suffix's start, rustc's
  `end`, end the token's end, rustc's self.pos)"
  [^Src src kind ^long start ^long ss ^long end detail ^long ed]
  (case kind
    :char (do (when-not detail (lex-error "unterminated character literal" start ss "E0762"))
              (escapes src :char (inc start) (dec ss) start ss) [:Char (inc start) (dec ss) 0])
    :byte (do (when-not detail (lex-error "unterminated byte constant" (inc start) ss "E0763"))
              (escapes src :byte (+ start 2) (dec ss) start ss) [:Byte (+ start 2) (dec ss) 0])
    :str (do (when-not detail (lex-error "unterminated double quote string" start ss "E0765"))
             (escapes src :str (inc start) (dec ss) start ss) [:Str (inc start) (dec ss) 0])
    :byte-str (do (when-not detail (lex-error "unterminated double quote byte string" (inc start) ss "E0766"))
                  (escapes src :byte-str (+ start 2) (dec ss) start ss) [:ByteStr (+ start 2) (dec ss) 0])
    :c-str (do (when-not detail (lex-error "unterminated C string" (inc start) ss "E0767"))
               (escapes src :c-str (+ start 2) (dec ss) start ss) [:CStr (+ start 2) (dec ss) 0])
    (:raw-str :raw-byte-str :raw-c-str)
    (let [pre (if (= kind :raw-str) 1 2)]
      (when-not detail (raw-str-error src start end pre))
      (let [h (long detail)
            a (+ start pre 1 h) b (- ss 1 h)]
        (escapes src kind a b start ss)
        [(case kind :raw-str :StrRaw :raw-byte-str :ByteStrRaw :CStrRaw) a b h]))
    :int (let [[base empty] detail]
           (when empty (lex-error "no valid digits found for number" start ss "E0768"))
           (when (contains? #{2 8} base)
             (loop [i (+ start 2)]
               (when (< i ss)
                 (let [c (aget ^ints (.-cps src) (int i))]
                   (when (and (not= c 95) (neg? (Character/digit (int c) (int base))))
                     (lex-error (str "invalid digit for a base " base " literal") i (inc i)))
                   (recur (inc i))))))
           [:Integer start ss 0])
    :float (let [[base empty] detail]
             (when empty (lex-error "expected at least one digit in exponent" start end))
             (when (not= base 10)
               (lex-error (str (case (long base) 16 "hexadecimal" 8 "octal" 2 "binary") " float literal is not supported") start ss))
             [:Float start ss 0])))

(defn- validate-frontmatter
  "validate_frontmatter: the errors of a front matter token [start, end) in rustc's order (each emitted, so
  the first decides): a preceding white space, an invalid infostring, a bare CR, an unclosed one, white
  space before the close, a close that does not match, characters after it"
  [^ints cps ^long start ^long end inv-ws inv-info]
  (let [ix (fn [^long from pred] (loop [i from] (cond (>= i end) -1 (pred (aget cps (int i))) i :else (recur (inc i)))))
        dash? (fn [c] (== c 45))
        real-start (loop [i start] (if (starts-with? cps end i "---") i (recur (inc i))))
        open-end (loop [i real-start] (if (and (< i end) (dash? (aget cps (int i)))) (recur (inc i)) i))
        len-opening (- open-end real-start)
        line-start (loop [i real-start] (cond (<= i start) start (== 10 (aget cps (int (dec i)))) i :else (recur (dec i))))
        nl (ix real-start #(== % 10))
        line-end (if (neg? nl) end nl)                       ; absolute position of the first newline
        last-nl (loop [i (dec end)] (cond (< i real-start) -1 (== 10 (aget cps (int i))) i :else (recur (dec i))))
        last-line-start (if (neg? last-nl) line-end (inc last-nl))]
    (when inv-ws
      (lex-error "invalid preceding whitespace for frontmatter opening" line-start open-end))
    (when inv-info
      (lex-error "invalid infostring for frontmatter" open-end line-end))
    (let [cr (loop [i line-end] (cond (>= i last-line-start) -1 (== 13 (aget cps (int i))) i :else (recur (inc i))))]
      (when (>= cr 0) (lex-error "bare CR not allowed in frontmatter" cr (inc cr))))
    (let [trim-start (loop [i last-line-start] (if (and (< i end) (hws? (aget cps (int i)))) (recur (inc i)) i))]
      (when-not (starts-with? cps end trim-start "---")
        (lex-error "unclosed frontmatter" real-start end))
      (when (not= trim-start last-line-start)
        (lex-error "invalid preceding whitespace for frontmatter close" last-line-start end))
      (let [rest-start (loop [i trim-start] (if (and (< i end) (dash? (aget cps (int i)))) (recur (inc i)) i))
            len-close (- rest-start trim-start)]
        (when (not= len-close len-opening)
          (lex-error "frontmatter close does not match the opening" real-start end))
        (when (loop [i rest-start] (cond (>= i end) false (hws? (aget cps (int i))) (recur (inc i)) :else true))
          (lex-error "extra characters after frontmatter close are not allowed" last-line-start end))))))

(deftype Lx [^Src src ^long ed ^longs st fm-allowed])
;; st: [pos]

(defn- next-token
  "next_token_from_cursor: [tok preceded-by-whitespace] (tok without spacing)"
  [^Lx lx]
  (let [^Src src (.-src lx) ^ints cps (.-cps src) n (.-n src) ^longs st (.-st lx) ed (.-ed lx)]
    (loop [ws false]
      (let [start (aget st 0)
            fm (and (.-fm-allowed lx) (== 1 (aget st 1)))
            r (advance-token cps n start fm)
            end (long (nth r 0))
            k (nth r 1)]
        (when (and fm (not= k :whitespace)) (aset st 1 0))
        (aset st 0 end)
        (case k
          :eof [(Tok. :Eof end end nil nil nil 0 nil) ws]
          :whitespace (recur true)
          :frontmatter (do (validate-frontmatter cps start end (nth r 2) (nth r 3)) (recur true))
          :line-comment
          (if-let [doc (nth r 2)]
            (let [s (text-of src (+ start 3) end)]
              (let [i (.indexOf s "\r")] (when (>= i 0) (let [c (+ start 3 (.codePointCount s 0 i))] (lex-error "bare CR not allowed in doc-comment" c (inc c)))))
              [(Tok. :DocComment start end s :Line (if (= doc :inner) :Inner :Outer) 0 nil) ws])
            (recur true))
          :block-comment
          (let [doc (nth r 2) term (nth r 3)]
            (when-not term (lex-error (if doc "unterminated block doc-comment" "unterminated block comment") start end "E0758"))
            (if doc
              (let [s (text-of src (+ start 3) (- end 2))]
                (let [i (.indexOf s "\r")] (when (>= i 0) (let [c (+ start 3 (.codePointCount s 0 i))] (lex-error "bare CR not allowed in block doc-comment" c (inc c)))))
                [(Tok. :DocComment start end s :Block (if (= doc :inner) :Inner :Outer) 0 nil) ws])
              (recur true)))
          :ident [(Tok. :Ident start end (nfc (text-of src start end)) false nil 0 nil) ws]
          :raw-ident (let [s (nfc (text-of src (+ start 2) end))]
                       (when-not (can-be-raw? s) (lex-error (str "`" s "` cannot be a raw identifier") start end))
                       [(Tok. :Ident start end s true nil 0 nil) ws])
          :unknown-prefix (do (when (>= ed 2021) (lex-error (str "prefix `" (text-of src start end) "` is unknown") start end))
                              [(Tok. :Ident start end (nfc (text-of src start end)) false nil 0 nil) ws])
          :unknown-prefix-lifetime (do (when (>= ed 2021) (lex-error (str "prefix `" (text-of src start end) "` is unknown") start end))
                                       [(Tok. :Lifetime start end (text-of src start end) false nil 0 nil) ws])
          ;; rustc recovers an identifier with emoji as an Ident (nfc'd) and reports it after the parse
          ;; (rustc_interface's passes: "identifiers cannot contain emoji", bad_unicode_identifiers, which reading does
          ;; not run), unless the single character is a confusable of unicode_chars.rs's UNICODE_ARRAY: then an
          ;; unknown start of token, as rustc-errors reports it (unknown-token)
          :invalid-ident (let [t (text-of src start end)]
                           (if (and (== 1 (.codePointCount ^String t 0 (.length ^String t))) (contains? confusable-emoji (.codePointAt ^String t 0)))
                             (unknown-token src start)
                             [(Tok. :Ident start end (nfc t) false nil 0 nil) ws]))
          :guarded-str-prefix
          (if (>= ed 2024)
            (guarded-str-error src start)
            (do (aset st 0 (inc start))
                [(Tok. :Pound start (inc start) nil nil nil 0 nil) ws]))
          :literal
          (let [lk (nth r 2) ss (long (nth r 3)) detail (nth r 4)]
            (if (and (contains? #{:c-str :raw-c-str} lk) (< ed 2021))
              ;; split into an identifier and a string before 2021
              (let [plen (if (= lk :c-str) 1 2)]
                (aset st 0 (+ start plen))
                [(Tok. :Ident start (+ start plen) (text-of src start (+ start plen)) false nil 0 nil) ws])
              (let [[lkind a b z] (check-literal src lk start ss end detail ed)
                    suffix (when (< ss end) (text-of src ss end))]
                (when (= suffix "_") (lex-error "underscore literal suffix is not allowed" ss end))
                [(Tok. :Literal start end (text-of src a b) lkind suffix z nil) ws])))
          :lifetime (let [swn (nth r 2)]
                      (when (and swn *late*) (.add *late* {:msg "lifetimes cannot start with a number" :lo start :hi end}))
                      [(Tok. :Lifetime start end (nfc (text-of src start end)) false nil 0 nil) ws])
          :raw-lifetime
          (if (>= ed 2021)
            (let [nm (text-of src (+ start 3) end)]
              (when (== 39 (long (at cps n end))) (lex-error "character literal may only contain one codepoint" start (inc end)))
              (when-not (can-be-raw? nm) (lex-error (str "`" nm "` cannot be a raw lifetime") start end))
              [(Tok. :Lifetime start end (nfc (str "'" nm)) true nil 0 nil) ws])
            (do (aset st 0 (+ start 2))
                [(Tok. :Lifetime start (+ start 2) (text-of src start (+ start 2)) false nil 0 nil) ws]))
          :unknown (unknown-token src start)
          ;; one-character punctuation
          [(Tok. k start end nil nil nil 0 nil) ws])))))

(defn- glue [^Tok a ^Tok b]
  (when-let [k (glue-table [(.-kind a) (.-kind b)])]
    (Tok. k (min (.-lo a) (.-lo b)) (max (.-hi a) (.-hi b)) nil nil nil 0 nil)))

(defn- spacing-for [^Tok next ws]
  (cond ws :Alone
        (contains? punct-kinds (.-kind next)) :Joint
        (= :Eof (.-kind next)) :Alone
        :else :JointHidden))

(defn- lexer-at
  "A lexer at the file's start (its shebang stripped, frontmatter allowed, unless strip is :nothing)"
  ^Lx [^Src src ^long ed strip]
  (let [^ints cps (.-cps src) n (.-n src)
        start (long (if (= strip :nothing) 0 (or (strip-shebang cps n) 0)))]
    (Lx. src ed (long-array [start (if (= strip :nothing) 0 1)]) (not= strip :nothing))))

(defn- tree-error
  "The token trees' errors as rustc reports them (lexer/tokentrees.rs, with its recovery: a mismatched
  closing delimiter closes the innermost open one, and is kept for an outer one it matches): the
  file lexed again from its start; a lexer's error on the way throws first (rustc emits it as it
  lexes), then the first of make_errors_for_mismatched_closing_delims' and the stream's own error
  (an unexpected closing delimiter at the top, or the file's end in an open delimiter)"
  [^Src src ^long ed strip]
  (let [^Lx lx (lexer-at src ed strip)
        cur (object-array 1)
        opens (java.util.ArrayList.)          ; [kind lo hi]
        unmatched (java.util.ArrayList.)      ; {:found kind :lo :hi :unclosed [lo hi]}
        ^longs last-found (long-array [-1])
        txt (fn [^Tok t] (text-of src (.-lo t) (.-hi t)))
        bump! (fn [] (aset cur 0 (first (next-token lx))))
        kind (fn [] (.-kind ^Tok (aget cur 0)))]
    (letfn [(trees [delimited]
              (bump!)
              (loop []
                (let [k (kind)]
                  (cond (contains? open-delims k) (or (open-delim k) (recur))
                        (contains? close-delims k)
                        (if delimited
                          nil
                          (let [^Tok t (aget cur 0)]
                            ;; report_missing_open_delim: the mismatches found at `)` or `]` become labels
                            (.removeIf unmatched (reify java.util.function.Predicate
                                                   (test [_ u] (contains? #{:CloseParen :CloseBracket} (:found u)))))
                            {:msg (str "unexpected closing delimiter: `" (txt t) "`") :lo (.-lo t) :hi (.-hi t)}))
                        (identical? k :Eof)
                        (when delimited
                          (let [^Tok t (aget cur 0)]
                            {:msg "this file contains an unclosed delimiter" :lo (.-lo t) :hi (.-hi t)}))
                        :else (do (bump!) (recur))))))
            (open-delim [k]
              (let [^Tok o (aget cur 0)]
                (.add opens [(open-delims k) (.-lo o) (.-hi o)])
                (or (trees true)
                    (let [^Tok t (aget cur 0) ck (.-kind t)]
                      (when-let [cd (close-delims ck)]
                        (if (= cd (open-delims k))
                          (do (.remove opens (dec (.size opens))) (bump!))
                          (do (if (not= (aget last-found 0) (.-lo t))
                                (let [[_ ulo uhi] (.get opens (dec (.size opens)))]
                                  (aset last-found 0 (long (.-lo t)))
                                  (.remove opens (dec (.size opens)))
                                  (.add unmatched {:found ck :lo (.-lo t) :hi (.-hi t) :text (txt t) :unclosed [ulo uhi]}))
                                (.remove opens (dec (.size opens))))
                              (when-not (some #(= cd (first %)) opens) (bump!)))))
                      nil))))]
      (let [err (trees false)
            errs (concat (for [u unmatched]
                           {:msg (str "mismatched closing delimiter: `" (:text u) "`") :lo (:lo u) :hi (:hi u)})
                         (when err [err]))]
        (if-let [d (first errs)]
          (lex-error (:msg d) (:lo d) (:hi d))
          (lex-error "native lexer: no token tree error found"))))))

(defn token-trees
  "lex_token_trees over the file (strip :shebang-and-frontmatter, as rustc parses a crate root, or
  :nothing, an expression file of include!): {:toks Tok[] (the delimiters included, a last :Eof)
  :mt int[] (each delimiter's partner's index)}; an error of the lexer or an unmatched delimiter
  throws (ex-info with :rust-lex)"
  [^Src src ^long ed strip]
  (let [^Lx lx (lexer-at src ed strip)
        start (aget ^longs (.-st lx) 0)
        out (java.util.ArrayList.)
        stack (java.util.ArrayList.)]
    ;; tokentrees.rs: self.token the current token; bump glues and computes its spacing
    (loop [[cur _] (next-token lx)]
      (let [k (.-kind ^Tok cur)]
        (cond
          (contains? open-delims k)
          (let [[nt ws] (next-token lx)]
            (.add stack (Long/valueOf (.size out)))
            (.add out (with-sp cur (spacing-for nt ws)))
            (recur [nt]))
          (contains? close-delims k)
          (do (when (zero? (.size stack)) (tree-error src ed strip))
              (let [oi (long (.remove stack (dec (.size stack))))
                    ^Tok o (.get out (int oi))]
                (when-not (= (open-delims (.-kind o)) (close-delims k))
                  (tree-error src ed strip))
                (let [[nt ws] (next-token lx)]
                  (.add out (with-sp cur (spacing-for nt ws)))
                  (recur [nt]))))
          (= k :Eof)
          (do (when (pos? (.size stack)) (tree-error src ed strip))
              (.add out cur))
          :else
          (let [[cur nt ws] (loop [cur cur]
                              (let [[nt ws] (next-token lx)]
                                (if ws
                                  [cur nt true]
                                  (if-let [g (glue cur nt)]
                                    (recur g)
                                    [cur nt false]))))]
            (.add out (with-sp cur (spacing-for nt ws)))
            (recur [nt])))))
    (let [toks (.toArray out)
          cnt (alength toks)
          mt (int-array cnt -1)
          stk (java.util.ArrayList.)]
      (dotimes [i cnt]
        (let [k (.-kind ^Tok (aget toks i))]
          (cond (contains? open-delims k) (.add stk (Long/valueOf i))
                (contains? close-delims k) (let [o (long (.remove stk (dec (.size stk))))]
                                             (aset mt (int o) (int i))
                                             (aset mt i (int o))))))
      {:toks toks :mt mt :start start})))

;; ---------------------------------------------------------------------------------------------
;; The helper's rsdump/tokens and rsdump/comments: rustc_lexer::tokenize over the file

(def ^:private punct1-kinds (conj (set (vals punct1)) :Slash))

(defn raw-tokens
  "The helper's lex (tools/rsdump/rsdump.rs): rustc_lexer's tokens of the file but white space, each
  [KIND L C L2 C2] (KIND :c a plain comment, :doc a doc comment, :id an identifier, :lt a lifetime,
  :lit a literal, :p one punctuation character, :shebang, :fm a front matter, :x anything else), or
  with comments-only the plain comments alone, [L C L2 C2]; before edition 2024 a guarded string's
  prefix #\" is a # and the rest lexed again; for an expression file (expr) nothing stripped"
  [^Src src ^long ed comments-only expr]
  (let [^ints cps (.-cps src) n (.-n src)
        out (java.util.ArrayList.)
        sb (when-not expr (strip-shebang cps n))
        lc (fn [p] (let [l (line-of src p)] [l (col-of src p l)]))]
    (when (and sb (not comments-only))
      (.add out [:shebang 1 1 1 (inc (long sb))]))
    (loop [p (long (or sb 0)) fm (not expr)]
      (let [[q k a] (advance-token cps n p fm)
            q (long q)
            guarded (and (= k :guarded-str-prefix) (< ed 2024))
            q (if guarded (inc p) q)
            fm (and fm (= k :whitespace))]
        (when-not (= k :eof)
          (let [kind (cond guarded :p
                           (= k :whitespace) nil
                           (and (contains? #{:line-comment :block-comment} k) (nil? a)) :c
                           comments-only nil
                           (contains? #{:line-comment :block-comment} k) :doc
                           (contains? #{:ident :raw-ident :invalid-ident} k) :id
                           (contains? #{:lifetime :raw-lifetime} k) :lt
                           (= k :literal) :lit
                           (= k :frontmatter) :fm
                           (contains? punct1-kinds k) :p
                           :else :x)]
            (when (and kind (not (and comments-only guarded)))
              (let [[l1 c1] (lc p) [l2 c2] (lc q)]
                (.add out (if comments-only [l1 c1 l2 c2] [kind l1 c1 l2 c2]))))
            ;; a guarded prefix: lexed again after the #, front matter no longer allowed
            (recur q (if guarded false fm))))))
    (vec out)))

